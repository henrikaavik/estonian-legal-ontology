# https://w3id.org/estleg/ — Estonian Legal Ontology namespace (estleg).
# Adopted in issue #516, replacing the non-resolvable, government-owned
# data.riik.ee/ontology/estleg# scheme.
#
# Maintainer / contact: Henrik Aavik
# email: henrik.aavik@gmail.com
# GitHub username: henrikaavik
# Project / source: https://github.com/henrikaavik/estonian-legal-ontology
#
# Registered via perma-id/w3id.org PR #6575, merged 2026-08-19. This file is the
# staging copy; edits take effect only once re-submitted to perma-id/w3id.org
# (exact PR text: w3id/estleg/README.md, "How to update the PURL").
#
# Content negotiation (#728). Term IRIs 303 to the per-node resolver
# (estleg-mcp's public /id/{local} and /vocabulary routes), which answers by the
# Accept header the client re-sends: JSON-LD, Turtle, N-Triples, RDF/XML or an
# HTML description page. Requests that ask for none of those keep the interim
# 302 to the project repository.
#
# Rule order (first match wins):
#   1. ""                       namespace root          -> 302 repository
#   2. <MAJOR.MINOR.PATCH>      version IRI             -> RDF: 303 T-Box at tag
#                                                          else: 302 GitHub Release
#   3. dataset/…, graph/…       VoID IRIs               -> 303 void.ttl
#   4. vocabulary               the T-Box               -> 303 RESOLVER/vocabulary
#   5. <local>                  any one-segment name    -> 303 RESOLVER/id/<local>
#                               (RDF or HTML Accept)
#   6. anything else                                    -> 302 repository

Options +FollowSymLinks -MultiViews
RewriteEngine on

# The resolver host, in one place. Change this line (and re-submit) to move
# the resolver; nothing else in this file names it.
SetEnvIf Request_URI ^.*$ RESOLVER=https://estleg.sixtyfour.ee
SetEnvIf Request_URI ^.*$ REPO=https://github.com/henrikaavik/estonian-legal-ontology
SetEnvIf Request_URI ^.*$ RAW=https://raw.githubusercontent.com/henrikaavik/estonian-legal-ontology

# The representation depends on Accept; tell caches.
Header always set Vary "Accept"

# 1. Namespace root (https://w3id.org/estleg is 301'd here by DirectorySlash).
RewriteRule ^$ %{ENV:REPO} [R=302,L]

# 2. Version IRI -> the T-Box as committed at tag v<version> for RDF clients
#    (raw blob at the tag: release assets are application/octet-stream, which
#    rdflib refuses), else the tagged GitHub Release. Generalised SemVer
#    capture (#690); a tag that does not exist yields GitHub's own 404.
RewriteCond %{HTTP_ACCEPT} (application/(ld\+json|n-triples|rdf\+xml)|text/turtle) [NC]
RewriteRule ^(\d+\.\d+\.\d+)/?$ %{ENV:RAW}/v$1/krr_outputs/controlled_vocabulary.jsonld [R=303,L]
RewriteRule ^(\d+\.\d+\.\d+)/?$ %{ENV:REPO}/releases/tag/v$1 [R=302,L]

# 3. VoID dataset and named-graph IRIs (dataset/estonian-legal-ontology,
#    graph/laws, …) -> the VoID description.
RewriteCond %{HTTP_ACCEPT} (application/(ld\+json|n-triples|rdf\+xml)|text/turtle) [NC]
RewriteRule ^(dataset|graph)(/.*)?$ %{ENV:RAW}/main/krr_outputs/void.ttl [R=303,L]
RewriteRule ^(dataset|graph)(/.*)?$ %{ENV:REPO}/blob/main/krr_outputs/void.ttl [R=303,L]

# 4. The vocabulary (T-Box): the resolver negotiates JSON-LD / Turtle / HTML.
RewriteRule ^vocabulary/?$ %{ENV:RESOLVER}/vocabulary [R=303,L]

# 5. Every other one-segment local name (KARIST_2_Osa2_Par_141, Reg_…_Map,
#    RK_…, Act, CaseType_Civil, …) -> its per-node description.
RewriteCond %{HTTP_ACCEPT} (application/(ld\+json|json|n-triples|rdf\+xml|xhtml\+xml)|text/(turtle|html)) [NC]
RewriteRule ^([^/]+)$ %{ENV:RESOLVER}/id/$1 [R=303,L]

# 6. Interim catch-all (no RDF/HTML Accept, or a multi-segment path).
RewriteRule ^(.*)$ %{ENV:REPO} [R=302,L]
