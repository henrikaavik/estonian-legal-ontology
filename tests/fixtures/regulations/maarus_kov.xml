	<sisu>
		<preambul>
			<tavatekst>Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 8 lõike 2 alusel.</tavatekst>
		</preambul>
		<peatykk id="ptk1">
			<peatykkNr>1</peatykkNr>
			<kuvatavNr><![CDATA[1. peatükk]]></kuvatavNr>
			<peatykkPealkiri>ÜLDSÄTTED</peatykkPealkiri>
			<paragrahv id="para1">
				<paragrahvNr>1</paragrahvNr>
				<kuvatavNr><![CDATA[§ 1.]]></kuvatavNr>
				<paragrahvPealkiri>
					<b>Reguleerimisala</b>
				</paragrahvPealkiri>
				<loige id="lg1">
					<sisuTekst>
						<tavatekst>Käesolev põhimäärus sätestab Tartu linna omavalitsuse korralduse, juhtimise ja töökorralduse alused.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
			<paragrahv id="para2">
				<paragrahvNr>2</paragrahvNr>
				<kuvatavNr><![CDATA[§ 2.]]></kuvatavNr>
				<paragrahvPealkiri>
					<b>Tartu linna sümboolika</b>
				</paragrahvPealkiri>
				<loige id="lg2">
					<sisuTekst>
						<tavatekst>Tartu linna sümbolid on vapp, lipp ja logo, mille kirjeldused ja kasutamise kord kehtestatakse linnavolikogu määrusega.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
