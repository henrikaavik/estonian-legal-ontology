	<sisu>
		<preambul>
			<tavatekst>Määrus kehtestatakse «</tavatekst>
			<viide>
				<kuvatavTekst><![CDATA[Euroopa Ühenduste Komisjoni ja Eesti Vabariigi vahel sõlmitud rahastuslepingu ratifitseerimise seaduse]]></kuvatavTekst>
			</viide>
			<tavatekst>» (RT II 2001,14,68) § 12 alusel.</tavatekst>
		</preambul>
		<peatykk id="ptk1">
			<peatykkNr>1</peatykkNr>
			<kuvatavNr><![CDATA[1. peatükk]]></kuvatavNr>
			<peatykkPealkiri>ÜLDSÄTE</peatykkPealkiri>
			<paragrahv id="para1">
				<paragrahvNr>1</paragrahvNr>
				<kuvatavNr><![CDATA[§ 1.]]></kuvatavNr>
				<paragrahvPealkiri>
					<b>Reguleerimisala</b>
				</paragrahvPealkiri>
				<loige id="lg1">
					<sisuTekst>
						<tavatekst>Käesoleva määrusega kehtestatakse Euroopa Ühendust esindava Euroopa Ühenduste Komisjoni ja Eesti Vabariigi vahel sõlmitud põllumajanduse ja maaelu arendamise liitumiseelse programmi mitmeaastasest rahastuslepingust tulenevate kohustuste täitmise eest vastutavad täidesaatva riigivõimu asutused.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
		</peatykk>
		<peatykk id="ptk2">
			<peatykkNr>2</peatykkNr>
			<kuvatavNr><![CDATA[2. peatükk]]></kuvatavNr>
			<peatykkPealkiri>VOLITATUD ASUTUSED</peatykkPealkiri>
			<paragrahv id="para2">
				<paragrahvNr>2</paragrahvNr>
				<kuvatavNr><![CDATA[§ 2.]]></kuvatavNr>
				<paragrahvPealkiri>
					<b>Volitatud asutused</b>
				</paragrahvPealkiri>
				<loige id="lg2">
					<loigeNr>1</loigeNr>
					<kuvatavNr><![CDATA[(1)]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>Lepingus Eesti Vabariigile võetud kohustuste täitmiseks volitatud asutused on Põllumajanduse Registrite ja Informatsiooni Amet ning Rahandusministeerium.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
		</peatykk>
