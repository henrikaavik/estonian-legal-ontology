@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix estleg: <https://w3id.org/estleg/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# --------------------------------------------------------------------
# Legal-text fidelity provenance shape (issue #703)
#
# Test fixture holding the canonical copy of the #703 shape merged into
# shacl/estonian_legal_shapes.ttl; test_fixture_matches_merged_copy keeps
# the two isomorphic.
#
# LawActProvenanceShape is sh:Warning and ships sh:deactivated true: it
# has current offenders (174 roots without dcterms:source, 175 without
# estleg:kehtiv), and both SHACL gates fail on Warning results. It stays
# deactivated until those data/text_fidelity_baseline.json lists reach
# zero; meanwhile scripts/check_text_fidelity.py --coverage enforces the
# shrink-only baseline. sh:severity also sits on each property shape,
# because pyshacl does not propagate a node shape's severity to them.
#
# There is deliberately NO legalText shape. "A provision of a
# structuredBody act needs estleg:legalText" joins each provision to its
# file head (the act root, or the estleg:Part of a multi-part law), which
# core SHACL cannot express without sh:sparql, and this file stays core
# SHACL so inference="rdfs" and inference="none" agree (shacl/README.md,
# tests/test_issue_681_sanctions.py). That rule (481 offenders) is
# enforced only by check_text_fidelity.py --coverage.
#
# Core SHACL only, no rdfs:range or rdfs:domain, and estleg:Law has no
# subclasses that RDFS inference could phantom-type.
# --------------------------------------------------------------------

estleg:LawActProvenanceShape
    a sh:NodeShape ;
    sh:targetClass estleg:Law ;
    sh:severity sh:Warning ;
    sh:deactivated true ;
    rdfs:comment "An enacted law's act root must name the Riigi Teataja redaction its text was parsed from (dcterms:source) and that redaction's snapshot date (estleg:kehtiv) (issue #703). Restricted to estleg:Law: state and KOV regulations carry no kehtiv by design." ;
    sh:property [
        sh:path dcterms:source ;
        sh:severity sh:Warning ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "source" ;
        sh:message "estleg:Law act root has no dcterms:source Riigi Teataja act IRI (issue #703)." ;
    ] ;
    sh:property [
        sh:path estleg:kehtiv ;
        sh:severity sh:Warning ;
        sh:minCount 1 ;
        sh:name "kehtiv" ;
        sh:message "estleg:Law act root has no estleg:kehtiv snapshot date (issue #703)." ;
    ] .
