<!-- #694 fixture: trimmed from data/riigiteataja/karistusseadustik.xml.
     § 49¹ lg 1 carries real <sup> child elements inside <tavatekst>;
     § 7 lg 1 has two alampunkt sub-points; § 7 lg 2 has none;
     § 209 lg 2 has a superscripted sub-point (1¹) via ylaIndeks. -->
<oigusakt xmlns="tyviseadus_1_10.02.2010">
	<sisu>
		<paragrahv id="para7">
			<paragrahvNr>7</paragrahvNr>
			<kuvatavNr><![CDATA[§ 7. ]]></kuvatavNr>
			<paragrahvPealkiri>Karistusseaduse isikuline kehtivus</paragrahvPealkiri>
			<loige id="para7lg1">
				<loigeNr>1</loigeNr>
				<kuvatavNr><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst>
					<tavatekst>Eesti karistusseadus kehtib väljaspool Eesti territooriumi toimepandud teo kohta, mis on Eestis karistusseaduse järgi kuritegu, kui teo toimepanemise kohas on selline tegu karistatav või seal ei kehti ükski karistusõigus ning:</tavatekst>
				</sisuTekst>
				<alampunkt id="para7lg1p1">
					<alampunktNr>1</alampunktNr>
					<kuvatavNr><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>tegu on toime pandud Eesti kodaniku või Eestis registreeritud juriidilise isiku vastu või</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para7lg1p2">
					<alampunktNr>2</alampunktNr>
					<kuvatavNr><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>teo toimepanija oli teo toimepanemise ajal Eesti kodanik või sai selleks pärast teo toimepanemist.</tavatekst>
					</sisuTekst>
					<muutmismarge>
						<avaldamismarge>
							<RTosa>RT I</RTosa>
							<RTaasta>2004</RTaasta>
						</avaldamismarge>
					</muutmismarge>
				</alampunkt>
			</loige>
			<loige id="para7lg2">
				<loigeNr>2</loigeNr>
				<kuvatavNr><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst>
					<tavatekst>Eesti karistusseadus kehtib väljaspool Eesti territooriumi toimepandud teo kohta, kui see on toime pandud Eesti kaitseväe koosseisu kuuluva isiku poolt.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para49b1">
			<paragrahvNr ylaIndeks="1">49</paragrahvNr>
			<kuvatavNr><![CDATA[§ 49<sup>1</sup>. ]]></kuvatavNr>
			<paragrahvPealkiri>Ettevõtluskeeld</paragrahvPealkiri>
			<loige id="para49b1lg1">
				<loigeNr>1</loigeNr>
				<kuvatavNr><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst>
					<tavatekst>Kohus võib kohaldada ettevõtluskeeldu, kui isik mõistetakse süüdi käesoleva seadustiku §-s 213, 217<sup>2</sup>, 298, 298<sup>1</sup> või 400 sätestatud kuriteo eest.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para209">
			<paragrahvNr>209</paragrahvNr>
			<kuvatavNr><![CDATA[§ 209. ]]></kuvatavNr>
			<paragrahvPealkiri>Kelmus</paragrahvPealkiri>
			<loige id="para209lg2">
				<loigeNr>2</loigeNr>
				<kuvatavNr><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst>
					<tavatekst>Sama teo eest, kui see on toime pandud:</tavatekst>
				</sisuTekst>
				<alampunkt id="para209lg2p1">
					<alampunktNr>1</alampunktNr>
					<kuvatavNr><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>isiku poolt, kes on varem toime pannud kelmuse;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para209lg2p1b1">
					<alampunktNr ylaIndeks="1">1</alampunktNr>
					<kuvatavNr><![CDATA[1<sup>1</sup>) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>ametiisiku poolt, –</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
		</paragrahv>
	</sisu>
</oigusakt>
