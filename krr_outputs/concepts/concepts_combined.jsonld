        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Liitumisavaldus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tarbimiskoha ühisveevärgi ja -kanalisatsiooni omaniku kirjaliku avalduse alusel tehakse liitumisettepanek, millega soovitakse ühisveevärgi ja -kanalisatsiooniga liituda.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058914_Par_2"
        }
      ],
