    {
      "@id": "estleg:Concept_taisealisele_isikule_hoolduse_seadmise_hooldaja_maaramise_ja_t1043261_Hooldatav",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Hooldatav",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "igapäevast kõrvalabi, juhendamist ja järelevalvet vajav vaimse või füüsilise puudega täisealine isik, kellele on puuetega inimeste sotsiaaltoetuste seaduse kohaselt määratud raske või sügav puue.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043261_Par_2"
        }
      ],
      "estleg:sourceAct": "Täisealisele isikule hoolduse seadmise, hooldaja määramise ja hooldajatoetuse maksmise kord Haapsalu linnas",
      "rdfs:label": "Hooldatav (taisealisele_isikule_hoolduse_seadmise_hooldaja_maaramise_ja_t1043261)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hooldatav"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_taisealisele_isikule_hoolduse_seadmise_hooldaja_maaramise_ja_t1043261_Hooldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Hooldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Haapsalu Linnavalitsuse (edaspidi linnavalitsus) poolt määratud teovõimeline isik, kes tagab hooldatavale igapäevase kõrvalabi, juhendamise ja järelvalve.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043261_Par_2"
        }
      ],
      "estleg:sourceAct": "Täisealisele isikule hoolduse seadmise, hooldaja määramise ja hooldajatoetuse maksmise kord Haapsalu linnas",
