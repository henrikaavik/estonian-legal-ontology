      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "omaosalus",
      "skos:definition": [
        {
          "@value": "toetuse saaja rahaline panus (toetuse saaja poolt tema arvelduskonto kaudu panustatud rahalised vahendid sõltumata nende algsest päritolust) toetatavasse tegevusse, mis kajastub tegevuse eelarves; 4",
          "@language": "et"
        },
        {
          "@value": "valla rahaline panus projektis ettenähtud tegevuste elluviimiseks, mille vald eraldab oma eelarve piires või mida käesoleva määrusega sätestatud korras taotletakse reservfondist või vastavast tegevusalast.",
          "@language": "et"
        },
        {
          "@value": "vanema poolt kaetav eralastehoiu või eralasteaia tasu; 6",
          "@language": "et"
        }
      ]
    },
