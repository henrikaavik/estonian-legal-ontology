    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaks_t1043694_reklaamimaks",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaamimaks",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Kambja valla avalik-õiguslike ülesannete täitmiseks vajaliku tulu saamise ja vallapildi kujundamise eesmärgil reklaamimaksu maksja poolt käesolevas määruses sätestatud korras, suuruses ja tähtaegadel ilma otsese vastutasuta tasumisele kuuluv kohalik maks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043694_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri ja reklaamimaks",
      "rdfs:label": "reklaamimaks (valireklaami_paigaldamise_eeskiri_ja_reklaamimaks_t1043694)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaamimaks"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
