      "skos:definition": [
        {
          "@value": "noortele suunatud info, mis on noorele abiks otsuste tegemisel või teguviisi valikul. Noorteinfo eesmärk on suurendada noore valikuvõimalusi, pakkudes teavet ja hõlbustades noore iseseisvaid valikuid elu korraldamisel",
          "@language": "et"
        }
      ],
