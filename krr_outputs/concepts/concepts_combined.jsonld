      }
    },
    {
      "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_toovoime_hindamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töövõime hindamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pikaajalise tervisekahjustusega isiku töövõime ulatuse tuvastamine, mille käigus võetakse arvesse isiku terviseseisundit, isiku hinnangut oma tegutsemisvõimele ning sellest tulenevaid tegutsemise ja osalemise piiranguid, nende prognoosi ja eeldatavat kestust ja tehakse otsus töövõime ulatuse kohta ning vajaduse korral antakse soovitusi töötingimuste ja abivahendite kasutamise ja töövõime toetamise kohta; 2) tegutsemise ja osalemise piirang (edaspidi piirang ) – takistus, mida isik kogeb tegevuse sooritamisel või igapäevaelu olukordades",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030642_Par_2"
        }
      ],
      "estleg:sourceAct": "Töövõime hindamise taotlusele kantavate andmete loetelu, töövõime hindamise tingimused ja töövõimet välistavate seisundite loetelu",
      "rdfs:label": "töövõime hindamine (toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_toovoime_hindamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_eksperdiarvamus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eksperdiarvamus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töövõime hindamisel tervishoiuteenuse osutaja või arstiõppe läbinud Eesti Töötukassa (edaspidi töötukassa ) töötaja antud arvamus isiku kehalise ja vaimse võimekuse valdkondades piirangute esinemise või puudumise kohta, töövõime ulatuse, seisundi muutumise prognoosi ja töövõimet välistava seisundi või erijuhtumi esinemise kohta koos asjakohaste põhjenduste ning töötingimusi, abivahendeid ja töövõime toetamist puudutavate soovitustega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030642_Par_2"
        }
      ],
      "estleg:sourceAct": "Töövõime hindamise taotlusele kantavate andmete loetelu, töövõime hindamise tingimused ja töövõimet välistavate seisundite loetelu",
      "rdfs:label": "eksperdiarvamus (toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eksperdiarvamus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_valdkond",
      "@type": [
        "owl:NamedIndividual",
