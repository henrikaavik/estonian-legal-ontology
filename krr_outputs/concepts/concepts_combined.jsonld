        },
        {
          "@id": "estleg:Concept_saaremaa_valla_infoturvapoliitika_t1059675_infoturbe_haldus_on_infoturbe_rajamise_labimoeldud_ja_toimiva_protsessi_loomisek"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
