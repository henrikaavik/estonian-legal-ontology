        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sademetevee kanalisatsioon",
      "skos:definition": [
        {
          "@value": "ehitiste, sealhulgas kraavituste ja seadmete süsteem sademetevee ärajuhtimiseks ja kanaliseerimiseks. Sademetevee kanalisatsiooni käsitletakse ühiskanalisatsioonina",
          "@language": "et"
        },
        {
          "@value": "ehitised ja seadmed sademete- ja drenaaživee ning muu pinnase- ja pinnavee ja puhta heitvee ära juhtimiseks; 20) sademete- ja drenaaživesi ning muu pinnase- ja pinnavesi - loodusliku päritoluga ühiskanalisatsiooni juhitav vesi, mis ei ole reovesi",
          "@language": "et"
        },
        {
          "@value": "rajatised ja seadmed sademete- ja drenaaživee ning muu pinnase- ja pinnavee ja puhta heitvee kanaliseerimiseks",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_sademevee_kanalisatsioon"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
