      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_t1058810_Sisendustoru",
      "@type": [
        "owl:NamedIndividual",
