      "rdfs:label": "sissetulekupiir",
      "skos:definition": [
        {
          "@value": "rahasumma, mis peab inimesele või perekonnale jääma elamiseks kätte vastavalt käesolevas määruses sätestatud tingimustele pärast rahvastikuregistrisse kantud eluasemega seotud kulude katmist. Sissetulekupiiri suurus kehtestatakse Tallinna Linnavalitsuse määrusega",
          "@language": "et"
        }
