      ],
      "skos:prefLabel": {
        "@value": "majandustehingute kirjendaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötaja, kes lähtudes heast raamatupidamistavast, kirjendab valla majandustehingud raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on majandustehingute kirjendajaks raamatupidaja",
        "@language": "et"
      },
      "estleg:definedIn": [
