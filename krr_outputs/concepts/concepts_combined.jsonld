    },
    {
      "@id": "estleg:Concept_kuusalu_valla_heakorra_eeskiri_t1012575_Puhastusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Puhastusala",
      "skos:definition": "on kinnistuga külgnev kõnnitee, haljasriba ning muu ala, mis asub kinnistu ja sõidutee vahel. 4 (",
