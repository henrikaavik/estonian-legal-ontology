      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kohtkäitlusrajatis",
      "skos:definition": [
        {
          "@value": "reovee kogumismahuti, omapuhasti või kuivkäimla kogumismahuti; 4",
          "@language": "et"
        },
        {
          "@value": "kogumismahuti, reovee eelpuhasti või omapuhasti; 3",
          "@language": "et"
        },
        {
          "@value": "reovee kogumismahuti ja sellega lahutamatult seotud lokaalne torustik; 3",
          "@language": "et"
        },
        {
          "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (sh kuivkäimla), puhastamiseks (sh septik) või maapinda immutamiseks; 6",
          "@language": "et"
        },
        {
          "@value": "äravooluta lekkekindel kogumismahuti, koos kõige selle juurde kuuluva torustikuga; 4",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      }
