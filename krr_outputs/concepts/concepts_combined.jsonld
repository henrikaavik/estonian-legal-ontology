        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaugkuttepiirkonna_kehtestamine_t1015382_vork",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "võrk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "torustike, seadmete, abiseadmete ja nendega seotud ehitiste kohtkindlalt ehitatud talituslik kogum või selle osa, mis on vajalik soojuse jaotamiseks, kusjuures võrguks ei loeta käesoleva seaduse tähenduses tarbijapaigaldisi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1015382_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaugküttepiirkonna kehtestamine",
      "rdfs:label": "võrk (kaugkuttepiirkonna_kehtestamine_t1015382)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vork"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaugkuttepiirkonna_kehtestamine_t1015382_tarbijapaigaldis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tarbijapaigaldis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistul, ehitises või ühtse majandusüksuse moodustavas funktsionaalselt seotud ehitiste kompleksis ja nende teenindamiseks vajalikul maal ehitatud omavahel ühendatud soojatorustike ja abiseadmete võrguga ühendatud või ühendatav talituslik kogum tarbija varustamiseks soojusega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1015382_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaugküttepiirkonna kehtestamine",
