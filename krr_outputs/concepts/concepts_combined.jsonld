          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "aine, mis võib põhjustada saastatust või mille esinemisega vees võib kaasneda keskkonnahäiring.",
          "@language": "et"
        },
        {
          "@value": "mis tahes aine, mis võib põhjustada reostust",
          "@language": "et"
        }
      ],
