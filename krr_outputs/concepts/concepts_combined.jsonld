    {
      "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooni_kasutamis_t1058898_Vee_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vee-ettevõtja on eraõiguslik juriidiline isik, kelle on kohaliku omavalitsuse üksus määranud ühisveevärgi ja -kanalisatsiooni teenuse osutajaks. 30) Ühisveevärgi ja -kanalisatsiooni avarii – ühisveevärgi ja -kanalisatsiooni ehitiste või seadmete ettenägematu purunemine või kahjustumine, mille tagajärjel oluliselt halveneb või katkeb tarbijatele teenuse osutamine. 31) Ühisveevärk ja -kanalisatsioon – on ehitiste ja seadmete süsteem, mille kaudu varustatakse tarbijaid joogiveega ja juhitakse ära ning puhastatakse reo- ja sademevett ning mille projekteeritud jõudlus on vähemalt kümme kuupmeetrit ööpäevas ja mis teenindab vähemalt 50 inimest. Ühisveevärgi ja -kanalisatsioonina käsitatakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos. Ühisveevärgi ja -kanalisatsioonina käsitatakse ka ehitiste ja seadmete süsteemi, mille projekteeritud jõudlus on alla kümne kuupmeetri ööpäevas või mis teenindab alla 50 inimese ja mille kohaliku omavalitsuse üksus on ühisveevärgi ja -kanalisatsiooni arendamise kavaga määranud ühisveevärgiks ja -kanalisatsiooniks.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058898_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "Vee-ettevõtja (laane_nigula_valla_uhisveevargi_ja_kanalisatsiooni_kasutamis_t1058898)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vee_ettevotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooniga_liitumi_t1058899_Arenduspiirkond",
