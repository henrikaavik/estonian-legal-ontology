        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "igasugune territoorium, rajatis, hoone või ruum, mis on antud üldiseks kasutamiseks või on üldkasutatav (tänav, tee, park, haljasala, kalmistu, estraadilava, turg, rand, suplemiskoht või muu puhkeala, vaateplatvorm, hoov, hoone, rajatis, toitlustusettevõte, baar, kauplus, võimla, käimla, ettevõte, elamu, trepikoda, ühissõiduk jms)",
        "@language": "et"
      },
      "estleg:definedIn": [
