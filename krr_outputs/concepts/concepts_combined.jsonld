        "@id": "estleg:Concept_parkla"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_teede_ja_tanavate_sulgemise_maks_t1028011_soodusaeg",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "soodusaeg",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "aeg, millal maksuobjektile kohaldatakse madalamat maksumäära. Soodusaeg kehtib esmaspäevast reedeni kella 22-st kuni 6-ni ning laupäeval, pühapäeval ja riigipühal",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028011_Par_3"
        }
      ],
