      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_krundi_hoonestusala"
        }
      ]
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_ehitusmaarus_t1027827_krundi_taisehitusprotsent",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "krundi täisehitusprotsent",
      "skos:definition": "hoonete ja rajatiste aluse pindala suhe krundi pindalasse. Krundi täisehitusprotsendi leidmisel ei võeta arvesse teede ja platside alust pindala; 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1027827_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla ehitusmäärus",
