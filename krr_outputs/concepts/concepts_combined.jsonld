      },
      "skos:definition": {
        "@value": "kinnistuga vahetult piirnev üldkasutatav territoorium, mis ulatub ristisuunast kinnistu piirist või ehitisest sõidutee (sh kvartalisisese tee), parkla, jalg- või jalgrattatee servani ja veekogul vee piirini, kuid mitte kaugemale kui 10 meetrit",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052685_Par_2"
        }
      ],
