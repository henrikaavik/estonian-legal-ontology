        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "abikõlblik kulu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_projektides_osalemise_kord_t1038063_abikolblik_kulu"
        },
        {
          "@id": "estleg:Concept_arengukoostoo_tegemise_ja_humanitaarabi_andmise_tingimused_j_t1061969_abikolblik_kulu"
        },
        {
          "@id": "estleg:Concept_avalike_biometaani_sisestuspunktide_toetuse_andmise_tingimus_t1062653_abikolblik_kulu"
        },
        {
          "@id": "estleg:Concept_elektriauto_laadimispunktide_rajamise_toetamise_tingimused_j_t1061561_abikolblik_kulu"
        },
        {
          "@id": "estleg:Concept_elektribusside_transpordisektoris_kasutuselevotu_toetamise_t_t1050819_abikolblik_kulu"
        },
        {
          "@id": "estleg:Concept_euroopa_uhenduse_algatuse_interreg_programmide_elluviimise_k_t158972_abikolblik_kulu"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_rohevesiniku_kasutuselevo_t1052247_abikolblik_kulu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "abikõlblik kulu",
      "skos:definition": [
        {
          "@value": "kulu, mis on põhjendatud, mõistlik ja vajalik ning tehtud kooskõlas käesoleva määrusega ning Majandusliku Koostöö ja Arengu Organisatsiooni (edaspidi OECD ) arenguabikomitee (DAC) reeglite kohaselt",
          "@language": "et"
        },
        {
          "@value": "kulu, mis vastab vastava Interreg programmi programmdokumendis, programmitäiendis, Euroopa Komisjoni määruses (EÜ) nr 448/2004, millega muudetakse Komisjoni määrust (EÜ) nr 1685/2000 (ELT L 193, 29.07.2000, lk 39–48), millega kehtestatakse Nõukogu määruse (EÜ) nr 1260/1999 (ELT L 161, 26.02.1999, lk 1–42) üksikasjalikud rakenduseeskirjad seoses struktuurifondide kaasfinantseeritavate meetmetega seotud kulutuste abikõlblikkusega (ELT L 72, 11.03.2004 lk 66–77), valdkonna eest vastutava ministri käskkirjas ning struktuuritoetuse lepingus ja toetuslepingus sätestatud nõuetele.",
          "@language": "et"
        },
        {
          "@value": "kulutus, mis on põhjendatud, mõistlik ja vajalik projekti elluviimiseks ning mis on tehtud kooskõlas õigusaktides ja toetuse rahuldamisega seotud dokumentides sätestatud nõuetega",
          "@language": "et"
        },
        {
          "@value": "projekti elluviimiseks vajalik ja mõistlik kulu, mis on tekkinud abikõlblikkuse perioodil",
          "@language": "et"
        },
        {
          "@value": "projekti elluviimiseks vajalik ja mõistlik kulu, mis on tekkinud abikõlblikkuse perioodil ning mille aluseks olevad tegevused on kooskõlas Eesti ja Euroopa Liidu õigusega",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
