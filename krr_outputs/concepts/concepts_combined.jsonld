      "skos:prefLabel": {
        "@value": "reovee bioloogiline puhastamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk sekundaarne puhastamine on reoveest reoainete kõrvaldamine bioloogiliste protsesside toimel; 12) inimekvivalent- ühe inimese põhjustatud keskmine ööpäevane tingliku veereostuskoormuse ühik (ie); 13) hoolduspäevik- vabas vormis päevik, mis kajastab omapuhasti hooldamisega seotud informatsiooni",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044913_Par_2"
