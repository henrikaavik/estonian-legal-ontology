      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "numbrisilt",
      "skos:definition": "silt, millel on ametlik aadressinumber; 14",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
