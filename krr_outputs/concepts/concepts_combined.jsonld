      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_partner",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "partner",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "toetuse saaja poolt toetuse taotluses nimetatud projektis osalev füüsiline või juriidiline isik või riigi- või kohaliku omavalitsuse asutus, kes panustab projekti rahaliselt või kelle panus on rahaliselt mõõdetav. Käesoleva määruse mõistes käsitletakse partnerina kohaliku omavalitsuse üksusi või muid avalik-õiguslikke isikuid, riigiasutusi, mittetulundusühinguid või sihtasutusi või avaliku sektori valitseva mõju all olevaid äriühinguid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "partner (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_partner"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
