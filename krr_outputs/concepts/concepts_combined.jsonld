      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "taotleja",
      "skos:definition": "inimene, kes esitab abivajaduse väljaselgitamise taotluse oma rahvastikuregistrisse kantud elukoha järgsele linnaosa valitsusele või õigusaktis sätestatud juhtudel sotsiaal- ja tervishoiuametile või muule volitatud üksusele. Taotluse võib esitada nii abi vajav inimene ise kui ka tema seaduslik esindaja; RT IV 2025-04-12 1 412042025001 2025-05-01 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052751_Par_3"
        }
