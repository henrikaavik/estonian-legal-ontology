    },
    {
      "@id": "estleg:Concept_haljastusnouded_projekteerimisel_ja_ehitamisel_rae_vallas_t1054999_rinnasdiameeter",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rinnasdiameeter",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puutüve läbimõõt, mõõdetuna 1,3 m kõrguselt juurekaelast; 21) tugevdatud struktuuriga kasvualus (tugipinnas) – kõvakattega või mõnele muule tugeva tallamiskoormusega alale istutava puu juurestiku kasvuks vajalik rajatis, mis ulatub vähemalt puu liigiomase võra laiuselt teekatte alla ning mille koormustaluvus ja külmakerkeomadused vastavad ümbritseva ala pinnakatete ja aluskihtide tugevusomadustele. Tugevdatud struktuuriga kasvualuse rajamiseks võib kasutada tugipinnast, spetsiaalseid mooduleid või muid projektikohaseid materjale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054999_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljastusnõuded projekteerimisel ja ehitamisel Rae vallas",
