      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_paastesundmusel_osalevate_riigi_ja_kohaliku_omavalitsuse_asu_t1000524_hoiatusala",
      "@type": [
        "owl:NamedIndividual",
