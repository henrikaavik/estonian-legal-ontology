          "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_e_t1058914_Liitumisprojekt"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "liitumisprojekt",
      "skos:altLabel": [
        {
          "@value": "Liitumisprojekt",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ehitusprojekt eelprojekti mahus, tarbimiskoha kommunikatsioonide (sh vee- ja kanalisatsioonitorustike) planeerimiseks ning kooskõlastatakse. 9",
          "@language": "et"
        },
        {
          "@value": "kinnistu liitumispunktist kuni hoonestuseni märgitud kinnistusiseste võrkude (välisvõrkude) projekt, mille alusel ehitatakse kinnistu veevärk ja kanalisatsioon; 15",
          "@language": "et"
        },
        {
          "@value": "tarbimiskoha liitumispunktist kuni hoonestuseni märgitud kinnistusiseste võrkude (välisvõrkude) projekt, mille alusel ehitatakse tarbimiskoha veevärk ja kanalisatsioon; 18",
          "@language": "et"
        },
        {
          "@value": "tarbimiskoha liitumispunktist kuni hoonestuseni märgitud kinnistusiseste võrkude (välisvõrkude) projekt, mille alusel ehitatakse tarbimiskoha veevärk ja kanalisatsioon; 6",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni omaniku või valdaja tehniliste tingimuste alusel koostatud dokument (skeem) alates kinnistu liitumispunktist kuni hoonestuseni, mille alusel ehitatakse välja kinnistu veevärk ja kanalisatsioon; 26",
          "@language": "et"
        }
      ]
    },
