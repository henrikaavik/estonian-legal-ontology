      }
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Viljandi linnaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi Linnavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (viljandi_linnavalitsuse_palgajuhend_t1057306)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Viljandi linnaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud linnavalitsuses ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi Linnavalitsuse palgajuhend",
      "rdfs:label": "ametnik (viljandi_linnavalitsuse_palgajuhend_t1057306)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on võetud linnavalitsuse töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi Linnavalitsuse palgajuhend",
      "rdfs:label": "töötaja (viljandi_linnavalitsuse_palgajuhend_t1057306)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametnikule tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
