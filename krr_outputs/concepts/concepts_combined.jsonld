      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_ida_virumaa_korterelamute_energiatohususe_toetuse_tingimused_t1059481_pohiprojekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhiprojekt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "korterelamu rekonstrueerimiseks vajalik ehitusprojekt, mis on koostatud ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuete, standardi EVS 932 või samaväärsete nõuete ja määruse nõuete kohaselt. Korteriühistu võib põhiprojekti koostamisse kaasata arhitektuurse osa koostaja, kellel peab olema vähemalt volitatud arhitekti kutse 7. tase. Arhitektuurse osa koostamine tähendab, et arhitekt peab olema kaasatud ja koostama vähemalt ühe osa ehitusprojektist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059481_Par_2"
        }
      ],
      "estleg:sourceAct": "Ida-Virumaa korterelamute energiatõhususe toetuse tingimused",
      "rdfs:label": "põhiprojekt (ida_virumaa_korterelamute_energiatohususe_toetuse_tingimused_t1059481)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pohiprojekt"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_ida_virumaa_korterelamute_energiatohususe_toetuse_tingimused_t1059481_rekonstrueerimine",
