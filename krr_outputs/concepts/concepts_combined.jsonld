      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_koerte_ja_kasside_pidamise_eeskiri_laane_harju_vallas_t1043452_loomapidaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "loomapidaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kellele loom kuulub (loomaomanik) või kes tegeleb loomapidamisega loomaomanikuga rendi- või muu selletaolise suhte alusel. Kuuluvuse kaudu identifitseerimisel loetakse loom kuuluvaks isikule, kelle valduses, sealhulgas kelle kinnisel territooriumil või kellele kuuluvas hoones või rajatises ta asub, kui looma kuuluvusest huvitatud isik ei tõenda vastupidist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043452_Par_2"
        }
      ],
      "estleg:sourceAct": "Koerte ja kasside pidamise eeskiri Lääne-Harju vallas",
      "rdfs:label": "loomapidaja (koerte_ja_kasside_pidamise_eeskiri_laane_harju_vallas_t1043452)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_loomapidaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_koerte_ja_kasside_pidamise_eeskiri_laane_harju_vallas_t1043452_hulkuv_loom",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hulkuv loom",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "märgistamata loom, kelle omanikku ei ole võimalik tuvastada või loomapidaja juurest lahti pääsenud loom, kes viibib omaniku või looma eest vastutava isiku juuresolekuta väljaspool loomapidajale kuuluvat või tema kasutuses olevat territooriumi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043452_Par_2"
        }
      ],
