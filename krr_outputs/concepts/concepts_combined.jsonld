    },
    {
      "@id": "estleg:Concept_saku_vallavalitsuse_palgajuhend_t1011634_Tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks. 4) Teenistuskoht– ametiasutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011634_Par_2"
        }
      ],
      "estleg:sourceAct": "Saku Vallavalitsuse palgajuhend",
      "rdfs:label": "Töötaja (saku_vallavalitsuse_palgajuhend_t1011634)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saku_vallavalitsuse_palgajuhend_t1011634_Palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011634_Par_2"
        }
      ],
      "estleg:sourceAct": "Saku Vallavalitsuse palgajuhend",
      "rdfs:label": "Palk (saku_vallavalitsuse_palgajuhend_t1011634)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_palk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saku_vallavalitsuse_palgajuhend_t1011634_Tootasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Töötasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasust, mida asutus maksab töötajale tehtud töö eest vastavalt töölepingule, õigusaktidele ja tööandja poolt kehtestatud korrale.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011634_Par_2"
        }
      ],
      "estleg:sourceAct": "Saku Vallavalitsuse palgajuhend",
      "rdfs:label": "Töötasu (saku_vallavalitsuse_palgajuhend_t1011634)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saku_vallavalitsuse_palgajuhend_t1011634_Pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Põhipalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011634_Par_2"
        }
      ],
      "estleg:sourceAct": "Saku Vallavalitsuse palgajuhend",
