      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_heakorraeeskiri_ja_koormise_kehtestamine_t1052685_koormis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "koormis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on kohustus, mis seaduse alusel kehtestatakse volikogu määrusega füüsilistele või juriidilistele isikutele kohustuslike tööde tegemiseks valla või linna territooriumil kehtestatud heakorraeeskirjade täitmiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052685_Par_2"
        }
      ],
