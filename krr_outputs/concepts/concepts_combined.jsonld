      "skos:definition": [
        {
          "@value": "toetatavate tegevuste elluviimise tulemusena saadav ülemäärane hüvitis „Ühenduse raamistik riigiabi jaoks, mida antakse avalike teenuste eest makstava hüvitisena” (ELT C 297, 29.11.2005, lk 4–7) punktide 2.4 ja 3 mõistes.",
          "@language": "et"
