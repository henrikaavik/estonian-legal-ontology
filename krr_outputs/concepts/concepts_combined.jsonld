    {
      "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809_Uhisveevark_ja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Ühisveevärk ja",
      "skos:definition": "kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu varustatakse tarbijaid joogiveega ja juhitakse ära ning puhastatakse reo- ja sademevett ning mille projekteeritud jõudlus on vähemalt kümme kuupmeetrit ööpäevas ja mis teenindab vähemalt 50 inimest. Ühisveevärgi ja -kanalisatsioonina käsitatakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos. Ühisveevärgi ja -kanalisatsioonina käsitatakse ka ehitiste ja seadmete süsteemi, mille projekteeritud jõudlus on alla kümne kuupmeetri ööpäevas või mis teenindab alla 50 inimese ja mille kohaliku omavalitsuse üksus on ühisveevärgi ja -kanalisatsiooni arendamise kavaga määranud ühisveevärgiks ja -kanalisatsiooniks. 25",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058809_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
      "rdfs:label": "Ühisveevärk ja (laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhisveevark_ja"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_uhisveevark_ja"
        }
      ]
    },
    {
