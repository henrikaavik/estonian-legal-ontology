        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reoveepuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kogum kindlate dimensioonidega rajatisi, milles ühiskanalisatsioonivõrgu kaudu või muul käesolevas eeskirjas reguleeritud viisil kogutud reovesi puhastatakse nõnda, et seda võib keskkonda ohustamata loodusesse edastada; 31) sademete- ja drenaaživesi ning muu pinnase- ja pinnavesi – loodusliku päritoluga ühiskanalisatsiooni juhitav vesi, mis ei ole reovesi",
        "@language": "et"
      },
      "estleg:definedIn": [
