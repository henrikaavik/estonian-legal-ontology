      ],
      "skos:prefLabel": "omapuhasti ehk kohtpuhasti",
      "skos:definition": "reoveepuhasti, mille suublaks on pinnas või veekogu ja projekteeritud reostuskoormus on kuni 50 inimekivalenti (ie). Omapuhastiks on nii septik koos filtersüsteemiga kui biopuhasti imbväljakuga; 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
