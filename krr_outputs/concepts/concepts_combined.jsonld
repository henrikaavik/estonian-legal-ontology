      "rdfs:label": "pakkuja",
      "skos:definition": [
        {
          "@value": "ehitise pinna kasutusse andmisel pakkumise esitanud isik; 13",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik või füüsilisest isikust ettevõtja, kes on esitanud linnarajatise kaubandustegevuseks kasutusse andmiseks pakkumise või taotluse; 6",
          "@language": "et"
        },
        {
          "@value": "isik, kes on vähempakkumisele pakkumise esitanud; 2",
          "@language": "et"
        },
        {
          "@value": "projektiga kavandatavas hankes pakkumuse esitav või esitanud ettevõtja; 8",
          "@language": "et"
        }
      ]
    },
