      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_euroopa_uhenduse_algatuse_interreg_programmide_elluviimise_k_t158972_abikolblik_kulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "abikõlblik kulu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kulu, mis vastab vastava Interreg programmi programmdokumendis, programmitäiendis, Euroopa Komisjoni määruses (EÜ) nr 448/2004, millega muudetakse Komisjoni määrust (EÜ) nr 1685/2000 (ELT L 193, 29.07.2000, lk 39–48), millega kehtestatakse Nõukogu määruse (EÜ) nr 1260/1999 (ELT L 161, 26.02.1999, lk 1–42) üksikasjalikud rakenduseeskirjad seoses struktuurifondide kaasfinantseeritavate meetmetega seotud kulutuste abikõlblikkusega (ELT L 72, 11.03.2004 lk 66–77), valdkonna eest vastutava ministri käskkirjas ning struktuuritoetuse lepingus ja toetuslepingus sätestatud nõuetele.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_158972_Par_2"
        }
      ],
      "estleg:sourceAct": "Euroopa Ühenduse algatuse Interreg programmide elluviimise kord",
      "rdfs:label": "abikõlblik kulu (euroopa_uhenduse_algatuse_interreg_programmide_elluviimise_k_t158972)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_abikolblik_kulu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_gumnaasiumivorgu_korrastamine_perioodil_2014_2020_t1029593_gumnaasiumivorgu_korrastamine",
      "@type": [
        "owl:NamedIndividual",
