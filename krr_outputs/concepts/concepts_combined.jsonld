        "@type": "xsd:integer"
      },
      "rdfs:label": "ühiskanalisatsiooniga kaetav ala",
      "skos:definition": [
        {
          "@value": "ühisveevärgi ja –kanalisatsiooni (edaspidi ÜVK) arengukavas määratud ala, kuhu on planeeritud rajada kanalisatsioonitrassid. Eeskirjas kasutatav reovee mõiste hõlmab ka fekaale ja reoveesetet.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
