        "@value": "omafinantseering",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "toetuse saaja rahaline või mitterahaline, kuid rahaliselt mõõdetav panus projekti-, ürituse- või tegevuskulude rahastamiseks, milleks toetust ei määrata",
