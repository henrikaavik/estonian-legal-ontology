      "rdfs:label": "ühiskanalisatsioon",
      "skos:altLabel": [
        {
          "@value": "Ühiskanalisatsioon",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ehitiste, rajatiste ja seadmete kompleks mitme kinnistu reovee ärajuhtimiseks ning mis on vee-ettevõtja hallatav või teenindab vähemalt 50 elanikku; 34",
          "@language": "et"
        },
        {
          "@value": "ühiskanalisatsioon võib olla rajatud sõltuvalt asukoha eripärast isevoolse-, survelise või vaakumsüsteemina; 37",
          "@language": "et"
        },
        {
          "@value": "ehitiste, rajatiste ja seadmete kompleks mitme kinnistu reovee ärajuhtimiseks ning mis on vee-ettevõtja hallatav või teenindab vähemalt 50 elanikku; 35",
          "@language": "et"
        },
        {
          "@value": "reovee ärajuhtimiseks ja puhastamiseks ning sademevee ärajuhtimiseks rajatud ehitiste, rajatiste ja seadmete süsteemid, ühisreoveekanalisatsiooni kaudu juhitakse ära ning puhastatakse reovesi ja ühissademeveekanalisatsiooni kaudu juhitakse ära sademevesi; 11",
          "@language": "et"
        },
        {
          "@value": "ehitiste ja seadmete kompleks kinnistute reo ja/või heitvee kanaliseerimiseks, ning mis on vee-ettevõtja hallatav või teenindab vähemalt 50 elanikku; 36",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "13",
        "@type": "xsd:integer"
      }
    },
