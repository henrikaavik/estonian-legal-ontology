      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_eelarvest_kultuuritegevuse_ja_kohaliku_omaalgatu_t1054761_muud_vabauhendused",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muud vabaühendused",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kogukonna arendamise eesmärgil tegutsevad mittetulundusühingud, mille tegevus soodustab elanike ühistegevusi, kodanikualgatuslikke ettevõtmisi ning kogukonna aktiivsuse kasvu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054761_Par_2"
        }
      ],
