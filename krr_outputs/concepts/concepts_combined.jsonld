    {
      "@id": "estleg:Concept_tootervishoiu_ja_tooohutuse_nouded_elektromagnetvaljadest_mo_t1034216_kehalist_toimet_avaldava_kokkupuute_piirnormid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kehalist toimet avaldava kokkupuute piirnormid",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "nende ületamine võib avaldada töötaja tervisele kahjulikku mõju, näiteks keha või kehaosade kuumenemine või närvi- ja lihaskoe stimulatsioon",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1034216_Par_2"
        }
      ],
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded elektromagnetväljadest mõjutatud töökeskkonnale, elektromagnetväljadega kokkupuute piirnormid ja rakendusväärtused ning elektromagnetväljade mõõtmise kord",
      "rdfs:label": "kehalist toimet avaldava kokkupuute piirnormid (tootervishoiu_ja_tooohutuse_nouded_elektromagnetvaljadest_mo_t1034216)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kehalist_toimet_avaldava_kokkupuute_piirnormid"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tootervishoiu_ja_tooohutuse_nouded_elektromagnetvaljadest_mo_t1034216_meelelist_toimet_avaldava_kokkupuute_piirnormid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "meelelist toimet avaldava kokkupuute piirnormid",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "nende ületamisel võib lühikest aega olla häiritud töötaja taju või mõjutatud ajufunktsioonid. Rakendusväärtused – tasemed, mis määratakse kindlaks, et lihtsustada kokkupuute piirnormide järgimise tõendamist ja rakendada käesolevas määruses sätestatud kaitse- ja ennetusmeetmeid. Määruses kasutatakse järgmisi rakendusväärtuse termineid:",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1034216_Par_2"
        }
      ],
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded elektromagnetväljadest mõjutatud töökeskkonnale, elektromagnetväljadega kokkupuute piirnormid ja rakendusväärtused ning elektromagnetväljade mõõtmise kord",
      "rdfs:label": "meelelist toimet avaldava kokkupuute piirnormid (tootervishoiu_ja_tooohutuse_nouded_elektromagnetvaljadest_mo_t1034216)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_meelelist_toimet_avaldava_kokkupuute_piirnormid"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tootervishoiu_ja_tooohutuse_nouded_elektromagnetvaljadest_mo_t1034216_madalad_ja_korged_rakendusvaartused_elektrivaljade_puhul",
