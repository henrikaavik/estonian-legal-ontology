          "@id": "estleg:Concept_taheva_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ees_t1013767_peatorustik"
        },
        {
          "@id": "estleg:Concept_tartu_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeski_t1005283_peatorustik"
        },
        {
          "@id": "estleg:Concept_tartu_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeski_t1062951_peatorustik"
        },
        {
          "@id": "estleg:Concept_tartu_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_eesk_t1063111_peatorustik"
        },
        {
          "@id": "estleg:Concept_vinni_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_eesk_t1058825_peatorustik"
        }
      ],
      "estleg:definitionCount": {
        "@value": "13",
        "@type": "xsd:integer"
      },
      "rdfs:label": "peatorustik",
      "skos:definition": [
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, väljaarvatud ühendustorustik, mille kaudu toimub tarbimiskoha veega varustamine või tarbimiskohalt reo- ning sademevee ärajuhtimine; 4",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub kinnistute veega varustamine ühisveevärgist või kinnistutelt reovee ärajuhtimine ühiskanalisatsiooni; 14",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, välja arvatud ühendustorustik, mille kaudu toimub tarbimiskoha veega varustamine või tarbimiskohalt reo- ja sademevee ärajuhtimine; 3",
          "@language": "et"
        },
        {
          "@value": "vee-ettevõtja omandis olev või tema valdusse antud ühisveevärgi- ja/või kanalisatsioonitorustik, läbi mille tarbijat varustatakse veega või millesse juhitakse tarbija reovesi; 8",
          "@language": "et"
        },
        {
          "@value": "vee-ettevõtja omandis olev või tema valdusse antud ühisveevärgi- ja/või kanalisatsioonitorustik, millest varustatakse klienti veega või millesse juhitakse kliendi reovesi; 15",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      }
    },
