    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_heitevaba_kutteviis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "heitevaba kütteviis",
      "skos:definition": "maapinnas või õhus sisalduvast energiast küttesoojust tootev soojuspumbasüsteem, millega toodetud soojust jaotatakse hoones vedeliksoojuskandjaga keskse küttesüsteemi kaudu; 2",
