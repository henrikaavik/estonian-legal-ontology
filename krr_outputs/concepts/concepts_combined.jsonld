      }
    },
    {
      "@id": "estleg:Concept_kanepi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044995_reovesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "üle kahjutuspiiri rikutud ja enne suublasse juhtimist puhastamist vajav vesi; 13) purgimissõiduk (edaspidi sõiduk) – mahutiga mootorsõiduk, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi/fekaal purgimiskohta. Käesolevas paragrahvis nimetamata mõistete kasutamisel lähtutakse veeseaduses esitatud mõistete tähendusest, vastava mõiste puudumisel aga sõna üldlevinud tähendusest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044995_Par_2"
        }
      ],
      "estleg:sourceAct": "Kanepi valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "reovesi (kanepi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044995)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovesi"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
