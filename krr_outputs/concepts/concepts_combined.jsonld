      },
      "rdfs:label": "varutoiteseade",
      "skos:definition": [
        {
          "@value": "mobiilne või statsionaarne seade (näiteks inverter, generaator, aku) või seadmete kogum, mille abil on võimalik tagada varutoide",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
