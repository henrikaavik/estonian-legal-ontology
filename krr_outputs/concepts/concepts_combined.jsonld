      "skos:definition": [
        {
          "@value": "seitsme kuni üheksateistkümne aastane füüsiline isik",
          "@language": "et"
        },
        {
          "@value": "7- kuni 26-aastane füüsiline isik",
          "@language": "et"
        },
        {
          "@value": "7-19 aastane füüsiline isik, kes tegutseb Peipsiääre vallas",
          "@language": "et"
        },
        {
          "@value": "Eesti Rahvastikuregistri andmetel Kehtna vallas toimetuleku raskusega leibkonnas elava 7-19 aastane nooruk.",
          "@language": "et"
        },
        {
          "@value": "isik vanuses 5-19 aastat, kelle elukoht rahvastikuregistris on Raasiku vald",
