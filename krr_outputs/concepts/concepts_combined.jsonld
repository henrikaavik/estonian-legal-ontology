    {
      "@id": "estleg:Concept_vaike_maarja_valla_koerte_ja_kasside_pidamise_eeskiri_t1048311_lemmikloomapidaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lemmikloomapidaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kellele lemmikloom kuulub (lemmikloomaomanik) või kes tegeleb lemmikloomapidamisega lemmikloomaomanikuga rendi- või muu selletaolise suhte alusel. Kuuluvuse kaudu identifitseerimisel loetakse lemmikoom kuuluvaks isikule, kelle valduses, sealhulgas kelle kinnisel territooriumil või kellele kuuluvas hoones või rajatises ta asub, kui lemmiklooma kuuluvusest huvitatud isik ei tõenda vastupidist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048311_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja valla koerte ja kasside pidamise eeskiri",
      "rdfs:label": "lemmikloomapidaja (vaike_maarja_valla_koerte_ja_kasside_pidamise_eeskiri_t1048311)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_lemmikloomapidaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
