      "skos:definition": "reovee kogumine, puhastamine, pinnasesse immutamine, suublasse juhtimine või taaskasutamine, sealhulgas kompostimine, üldjuhul reovee tekkekoha kinnistu piires; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054000_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla reovee kohtkäitluse ja äraveo eeskiri",
