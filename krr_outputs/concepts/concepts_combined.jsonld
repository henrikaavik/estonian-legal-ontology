      "skos:definition": [
        {
          "@value": "biolagunevate jäätmete töötlemine kindlate tingimuste alusel",
          "@language": "et"
        },
        {
          "@value": "biolagunevate jäätmete looduslik biokeemiline lagundamine mikroorganismide toimel maapinnal või kompostris",
          "@language": "et"
        },
        {
          "@value": "biolagunevate jäätmete segamine ja ladestamine ning käitlemine maapinnal või kompostris nende looduslikuks lagundamiseks mullaviljakuse parandamise eesmärgil",
          "@language": "et"
        }
      ],
