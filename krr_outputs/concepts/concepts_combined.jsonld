      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_heakorraeeskiri_t1050928_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringile kasutamiseks antud või määratlemata isikute kasutuses olev avalikkusele juurdepääsetav maa-ala, ehitis, ruum või selle osa, samuti ühissõiduk",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050928_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla heakorraeeskiri",
      "rdfs:label": "avalik koht (luganuse_valla_heakorraeeskiri_t1050928)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_koht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_heakorraeeskiri_t1050928_haljasala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "haljasala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teadlikult kujundatud maastik, maastikuosa või hoonetevaheline välisruum, mida iseloomustab ümberkujundatud reljeef, valitud taimestik või vastavafunktsioonilised rajatised",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050928_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla heakorraeeskiri",
      "rdfs:label": "haljasala (luganuse_valla_heakorraeeskiri_t1050928)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_haljasala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_heakorraeeskiri_t1050928_heakorratood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heakorratööd",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tolmu, liiva, prahi, lume ja jää koristamine, libedustõrje, muru ja rohu niitmine ning mahalangenud puulehtede, okste vms koristamine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050928_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla heakorraeeskiri",
      "rdfs:label": "heakorratööd (luganuse_valla_heakorraeeskiri_t1050928)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_heakorratoo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_heakorraeeskiri_t1050928_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maapinna piiritletud osa ehk maatükk) või hoonestusõigus. Kinnistu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: maa-ala, territoorium, krunt, maaüksus ja katastriüksus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050928_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla heakorraeeskiri",
      "rdfs:label": "kinnistu (luganuse_valla_heakorraeeskiri_t1050928)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_heakorraeeskiri_t1050928_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omanik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle omandis on kinnistu või vallasasi. Omanikuga on võrdsustatud isik, kes õiguslikul alusel asja valdab või kasutab või kes on omaniku poolt volitatud asja haldama",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050928_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla heakorraeeskiri",
      "rdfs:label": "omanik (luganuse_valla_heakorraeeskiri_t1050928)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_heakorraeeskiri_t1050928_romusoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "romusõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduk, millel puuduvad selle mehhaanilised osad või kereosad või autoklaasid või rattad ja mis oma välimusega riivab valla esteetilist väljanägemist või rikub valla puhtust ja heakorda",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050928_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla heakorraeeskiri",
      "rdfs:label": "romusõiduk (luganuse_valla_heakorraeeskiri_t1050928)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_romusoiduk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_heakorraeeskiri_t1050928_ehitis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ehitis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "inimtegevuse tulemusel loodud ja aluspinnasega ühendatud või sellele toetuv asi, mille kasutamise otstarve, eesmärk, kasutamise viis või kestvus võimaldab seda eristada teistest asjadest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050928_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla heakorraeeskiri",
      "rdfs:label": "ehitis (luganuse_valla_heakorraeeskiri_t1050928)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ehitis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_heakorraeeskiri_t1050928_uldkasutatav_territoorium",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "üldkasutatav territoorium",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "osa valla haldusterritooriumist, mis hõlmab tänavaid, teid, platse, parke, haljasalasid, mänguväljakuid jmt ning mis on avalikult kasutatav igaühe poolt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050928_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla heakorraeeskiri",
      "rdfs:label": "üldkasutatav territoorium (luganuse_valla_heakorraeeskiri_t1050928)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uldkasutatav_territoorium"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_heakorraeeskiri_t1050928_avalikkusele_ligipaasetav_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalikkusele ligipääsetav koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistu omaniku poolt avalikkusele suunatud funktsiooniga ala või ehitis, millele ligipääs ei ole mingil moel piiratud.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050928_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla heakorraeeskiri",
