      "rdfs:label": "töövõtja",
      "skos:definition": [
        {
          "@value": "lumetõrje teostaja, kes on välja valitud hanke või vähempakkumiste korras.",
          "@language": "et"
        },
        {
          "@value": "on lumetõrje teostaja, kes on välja valitud konkursi korras.",
          "@language": "et"
        },
        {
          "@value": "äriregistrisse kantud majandustegevuses osalev isik, kes on esitanud vähemalt ühe majandusaasta aruande, millest nähtub, et tema põhitegevusala on seotud asjaomase teenuse osutamisega. Kui töövõtja teeb õigusaktides määratletud eritöid, peab ta olema kantud majandustegevuse registrisse või peab tal olema asjaomane tegevusluba.",
          "@language": "et"
        },
        {
          "@value": "äriregistrisse kantud majandustegevuses tegutsev isik, kes on esitanud äriregistrile vähemalt ühe majandusaasta aruande, mille põhjal on ettevõtja tegevusala olnud asjaomase teenuse osutamine. Kui töövõtja teeb õigusaktide mõistes eritöid, siis peab ta olema registreeritud majandustegevuse registris või peab tal olema vastavas valdkonnas tegutsemiseks tegevusluba; 11",
          "@language": "et"
        }
      ]
    },
