      "rdfs:label": "raske puue",
      "skos:definition": [
        {
          "@value": "inimese anatoomilise, füsioloogilise või psüühilise struktuuri või funktsiooni kaotus või kõrvale kalle, millest tingituna isik vajab kõrvalabi, juhendamist või järelevalvet igal ööpäeval",
          "@language": "et"
        },
        {
          "@value": "inimese anatoomilise, füsioloogilise või psüühilise struktuuri või funktsiooni kaotus või kõrvale kalle, millest tingituna isik vajab kõrvalabi, juhendamist või järelvalvet igal ööpäeval; 5) kõrvalabi– abi osutamine isikule, kes ei tule iseseisvalt toime söömise, hügieenitoimingutega, riietumisega, suhtlemisega või asjaajamisel väljaspool kodu",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
