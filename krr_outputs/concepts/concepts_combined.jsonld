        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "vähekindlustatud leibkond",
      "skos:definition": [
        {
          "@value": "käesoleva määruse mõistes leibkond, kelle sissetulek ühes kuus on väiksem kui kahekordne Vabariigi Valitsuse poolt riigieelarvega kehtestatud toimetulekupiir",
          "@language": "et"
        },
        {
          "@value": "leibkond, kes jagab ühist eluruumi ja kasutab ühiselt üht või enamat tuluallikat ning kelle iga liikme netosissetulek kuus jääb alla 1,5-kordse toimetulekupiiri peale eluaseme alaliste kulude maha arvestamist",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
