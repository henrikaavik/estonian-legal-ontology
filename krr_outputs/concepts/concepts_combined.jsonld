      },
      "rdfs:label": "huviharidus on pikaajaline süsteemne juhendatud tegevus vaba tahte alusel üldhariduse",
      "skos:definition": [
        {
          "@value": "ja tasemeõppest vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal, mida omandatakse huvikoolis, mis on registreeritud Eesti Hariduse Infosüsteemis (EHIS) ja/või spordiregistris; 2",
          "@language": "et"
        }
      ]
    },
