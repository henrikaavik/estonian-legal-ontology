      },
      "rdfs:label": "avalik üritus",
      "skos:definition": [
        {
          "@value": "spordi-, kultuuri- või meelelahutusüritus, avalik koosolek või muu selline üritus, mille korraldamiseks on väljastatud avaliku ürituse luba",
          "@language": "et"
        },
        {
          "@value": "spordi-, kultuuri- või meelelahutusüritus, avalik koosolek või muu selline sündmus, mille korraldamiseks on väljastatud avaliku ürituse luba",
          "@language": "et"
        },
        {
          "@value": "avalik üritus korrakaitseseaduse § 58 lõike 3 tähenduses",
          "@language": "et"
        },
        {
          "@value": "avalikus kohas Rapla valla haldusterritooriumil korraldatav avalikkusele suunatud üritus.",
          "@language": "et"
        }
      ],
