      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Üürielamu",
      "skos:definition": "taotleja omandis olev taotlejale kuuluval kinnisasjal või hoonestusõigusega koormatud kinnistul asuv kaheksa või enama korteriga elamu, mille kõik korterid on mõeldud üürikorterina kasutamiseks; RT I 2019-04-30 3 130042019003 2019-05-03 8 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039590_Par_3"
        }
      ],
      "estleg:sourceAct": "Kohaliku omavalitsuse üksuse elamufondi arendamiseks juhtumipõhise investeeringutoetuse andmise tingimused ja kord",
