    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "omanik",
      "skos:definition": "füüsiline või juriidiline isik, kelle omandis on kinnistu või ehitis vallasasjana, või isik, kelle kasuks on seatud hoonestusõigus. Omanikuga heakorra nõuete täitmisel on võrdsustatud tema volitatud valdaja, haldaja või kasutaja. Juhul, kui omaniku sõlmitud leping ei kehtesta teise poole kohustusi heakorra tagamiseks, lasub nimetatud kohustus omanikul; 15",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
      "rdfs:label": "omanik (peipsiaare_valla_heakorra_eeskiri_t1044621)",
      "estleg:definesConcept": {
