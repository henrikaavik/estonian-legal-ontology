    },
    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "ametnik",
      "skos:definition": "isik, kes on Tõrva vallaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud vallavalitsuses ametikohale, millel teostatakse avalikku võimu; 3",
