      },
      "rdfs:label": "valimiskampaania reklaam",
      "skos:altLabel": [
        {
          "@value": "Valimiskampaania reklaam",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "erakondade, valimisliitude või üksikkandidaatidega seostuv reklaam valimiste väljakuulutamisest kuni valimispäevani",
          "@language": "et"
        },
        {
          "@value": "erakondade, valimisliitude või üksikkandidaatide reklaam, mille eesmärk on oma vaadete tutvustamine ja valijate mõjutamine reklaamija poolt häält andma valimiste väljakuulutamisest kuni valimispäevani",
          "@language": "et"
        },
        {
          "@value": "erakondade, valimisliitude või üksikkandidaatide reklaam, mille eesmärk on oma vaadete tutvustamine ja valijate mõjutamine reklaamija poolt häält andma valimiste väljakuulutamisest kuni valimispäevani",
          "@language": "et"
        },
        {
          "@value": "erakondade, valimisliitude või üksikkandidaatidega seostuv reklaam kaks kuud enne valimispäeva",
          "@language": "et"
        },
        {
          "@value": "erakondade, valimisliitude või üksikkandidaatidega seotud reklaam",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
