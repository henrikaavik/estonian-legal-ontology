    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "reklaam",
      "skos:definition": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edendamise või isiku käitumise avalikes huvides suunamise eesmärgil; 2",
