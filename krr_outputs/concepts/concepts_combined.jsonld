        }
      ]
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_partner",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "partner",
      "skos:definition": "juriidiline isik, riigiasutus, kohaliku omavalitsuse asutus või rahvusvaheline organisatsioon, kes osaleb toetatavas tegevuses ja kellel tekivad selle käigus abikõlblikud kulud. Partner ei ole toetuse saajale töövõtja ega teenuse osutaja; 13",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
