      "rdfs:label": "jäätmejaam",
      "skos:definition": [
        {
          "@value": "spetsiaalselt rajatud, tehniliselt varustatud jäätmekäitluskoht, kuhu on paigutatud taaskasutatavate jäätmete kogumiseks ja taaskasutustoiminguks kogumismahutid, sh ohtlike jäätmete kogumismahutid",
          "@language": "et"
        },
        {
          "@value": "spetsiaalselt rajatud ja tehniliselt varustatud jäätmekäitluskoht, kuhu on paigaldatud taaskasutatavate jäätmete kogumiseks ja esmatöötlemiseks jäätmemahutid",
          "@language": "et"
        },
        {
          "@value": "jäätmekäitluskoht, kuhu on paigutatud taaskasutatavate jäätmete kogumiseks ja esmaseks töötlemiseks kogumismahutid, sh ohtlike jäätmete kogumismahutid",
          "@language": "et"
        },
        {
          "@value": "spetsiaalselt rajatud, tehniliselt varustatud jäätmekäitluskoht, kuhu on paigaldatudtaaskasutatavate jäätmete kogumiseks ja esmatöötlemiseks kogumismahutid, sh ohtlike jäätmete kogumismahutid",
          "@language": "et"
        },
        {
          "@value": "üldjuhul detailplaneeringu ja projekti alusel rajatud ning tehniliselt varustatud jäätmekäitluskoht, kuhu on paigutatud taaskasutatavate jäätmete kogumiseks ja esmaseks töötlemiseks kogumismahutid, sh ohtlike jäätmete kogumismahutid",
          "@language": "et"
        }
      ],
