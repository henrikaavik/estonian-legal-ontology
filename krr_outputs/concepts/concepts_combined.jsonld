        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaamikandja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaami paigaldamiseks kasutatav teabekandja, alus või seadeldis, mis paigaldatakse hoonetele ja rajatistele ning konstruktsioon (reklaamipost, -tahvel, treiler jms), mis paigaldatakse maapinnale",
        "@language": "et"
      },
