      ],
      "skos:prefLabel": {
        "@value": "tänavakaubandus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avalikult kasutataval maa-alal kauba või teenuse müük kaupleja paigaldatud ajutiselt müügikohalt, müügiletilt või -kärult, autolt või selle haagiselt või kandekaubanduse korras. Tänavakaubanduseks ei loeta kaupleja müügikoha hooajalist laiendamist väljapoole ettevõtte siseruume nende vahetus läheduses",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052013_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
      "rdfs:label": "tänavakaubandus (avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1052013)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tanavakaubandus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
