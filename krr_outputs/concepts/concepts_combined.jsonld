    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rajatis, mis on ette nähtud inimeste, sõidukite, või loomade liikumiseks või liiklemiseks. Tee osadeks loetakse ka liiklemiseks kasutatavad ning tee toimimiseks vajalikud rajatised",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052284_Par_2"
        }
      ],
      "estleg:sourceAct": "Erateede avalikuks kasutamiseks määramise kord",
      "rdfs:label": "tee (erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tee"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284_eratee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eratee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tee, mis paikneb juriidilise või füüsilise isiku kinnisasjal ning mis pole kantud avalikult kasutatavate teede nimekirja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052284_Par_2"
        }
      ],
      "estleg:sourceAct": "Erateede avalikuks kasutamiseks määramise kord",
      "rdfs:label": "eratee (erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eratee"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284_avalikult_kasutatav_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalikult kasutatav tee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "riigitee, kohalik tee ja avalikuks kasutamiseks määratud eratee. Avalikult kasutatavat teed võib kasutada igaüks õigusaktides sätestatud piiranguid järgides",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052284_Par_2"
        }
      ],
      "estleg:sourceAct": "Erateede avalikuks kasutamiseks määramise kord",
      "rdfs:label": "avalikult kasutatav tee (erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalikult_kasutatav_tee"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284_kohalik_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kohalik tee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tee, mille osas omaniku ülesandeid täidab kohaliku omavalitsuse üksus. Kohalik tee võib olla avalikuks kasutamiseks määratud eratee, kohalikule omavalitsuse üksusele kuuluv tee või kohaliku omavalitsuse volikogu otsuse kohaselt kohaliku omavalitsuse hallatav kohaliku liikluse korraldamiseks vajalik muu tee",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052284_Par_2"
        }
      ],
      "estleg:sourceAct": "Erateede avalikuks kasutamiseks määramise kord",
      "rdfs:label": "kohalik tee (erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kohalik_tee"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284_pinnastee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pinnastee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "põllu-, metsa- või muu pealiskihita tee, mis on teeks rajatud või sõidukite liikumise tulemusena selliseks kujunenud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052284_Par_2"
        }
      ],
      "estleg:sourceAct": "Erateede avalikuks kasutamiseks määramise kord",
