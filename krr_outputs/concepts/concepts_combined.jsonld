      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_tugiisikuteenus_lapsele"
        }
      ]
    },
    {
      "@id": "estleg:Concept_lapsele_ja_lapsega_perele_tugiisikuteenuse_osutamise_kord_t1043518_joustamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jõustamine",
      "skos:definition": "lapse ja lapsega pere abistamine pere sisemiste jõuvarude avastamisel ja kasutusele võtmisel (motiveerimine, julgustamine, kliendi oskustele ja võimetele keskendumine), et paremini hoolitseda lapse eest ja tagada neile arengut toetav kasvukeskkond; 4",
      "estleg:definedIn": [
        {
