      "rdfs:label": "sademevee kanalisatsioon",
      "skos:altLabel": [
        {
          "@value": "Sademevee kanalisatsioon",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ehitised ja seadmed sademevee ärajuhtimiseks ja kanaliseerimiseks",
          "@language": "et"
        },
        {
          "@value": "rajatised ja seadmed sademe- ja drenaaživee ning muu pinnase- ja pinnavee ärajuhtimiseks",
          "@language": "et"
        },
        {
          "@value": "ehitised ja seadmed sademevee ärajuhtimiseks",
          "@language": "et"
        },
        {
          "@value": "rajatised ja seadmed sademe- ja drenaaživee ning muu pinnase- ja pinnavee kanaliseerimiseks",
          "@language": "et"
        },
        {
          "@value": "rajatised ja seadmed sademete- ja drenaaživee ning muu pinnase- ja pinnavee kanaliseerimiseks",
          "@language": "et"
        }
      ],
