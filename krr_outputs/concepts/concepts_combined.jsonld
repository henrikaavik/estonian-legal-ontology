      "rdfs:label": "raieluba",
      "skos:definition": [
        {
          "@value": "luba, mis annab õiguse puu raieks ja hoolduslõikuseks ning vajadusel määrab selle lisatingimused; 5",
          "@language": "et"
        },
        {
          "@value": "luba, mis annab õiguse puu raieks ning määrab raietööde tingimused; 5",
          "@language": "et"
        },
        {
          "@value": "luba, mis annab õiguse puu raieks ning milles vajadusel määratakse loa kõrvaltingimused; 5",
          "@language": "et"
        },
        {
          "@value": "kirjalik dokument, mis annab õiguse Paide linna haldusterritooriumil puu raiumiseks ning määrab raietööde tingimused; 3",
          "@language": "et"
        },
        {
          "@value": "luba, mis annab taotlejale õiguse puu raieks ning vajadusel määrab ka kõrvaltingimused (sh asendusistutus); 3",
          "@language": "et"
        }
      ],
