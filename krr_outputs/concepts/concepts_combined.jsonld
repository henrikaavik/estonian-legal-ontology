      "skos:definition": {
        "@value": "süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal.",
        "@language": "et"
      },
      "estleg:definedIn": [
