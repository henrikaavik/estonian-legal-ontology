        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "osaajaga lastehoiu teenus",
      "skos:definition": [
        {
          "@value": "eralastehoiu teenuse kasutamine mitte rohkem kui kolmel päeval nädalas või kaheteistkümnel päeval kalendrikuus",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_osaajaline_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "osaajaline koht",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
