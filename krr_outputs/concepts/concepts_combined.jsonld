      },
      "rdfs:label": "Üksus",
      "skos:altLabel": [
        {
          "@value": "üksus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "mitmel erineval kinnistul või erinevatel tegevusaladel tegutseva ettevõtja autonoomne osa, mille majandusnäitajaid on võimalik ettevõtja kui terviku näitajatest eristada. 6 (",
          "@language": "et"
        },
        {
          "@value": "nii valla ametiasutus kui ka ametiasutuse hallatav asutus; 9",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_uksuse_juht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
