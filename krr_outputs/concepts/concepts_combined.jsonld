      "estleg:definesConcept": {
        "@id": "estleg:Concept_loomad_ja_linnud"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kastre_valla_lemmikloomade_pidamise_eeskiri_t1059886_Avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringile kasutamiseks antud või määratlemata isikute ringi kasutuses olev maa-ala, ehitis, ruum või selle osa, samuti ühissõiduk; 5) Häirimine on igapäevaseid käitumisharjumusi takistav tegevus; 6) Varjupaik on hulkuvate loomade pidamiseks ettenähtud koht.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059886_Par_2"
        }
      ],
      "estleg:sourceAct": "Kastre valla lemmikloomade pidamise eeskiri",
      "rdfs:label": "Avalik koht (kastre_valla_lemmikloomade_pidamise_eeskiri_t1059886)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_koht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_huvitatud_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvitatud isik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on huvitatud detailplaneeringu algatamisest, vastuvõtmisest, kehtestamisest ja elluviimisest st kelle huvides menetletakse detailplaneeringut",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "huvitatud isik (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huvitatud_isik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_detailplaneering",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "detailplaneering",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on konkreetse maa-ala kohta koostatav terviklik ruumilahendus, millega määratakse seaduses sätestatud juhtudel maakasutus- ja ehitustingimused ning mis vastab PlanS § 3 sätestatule. Detailplaneeringus tuuakse välja detailplaneeringukohased avalikuks kasutamiseks ette nähtud teed ja sellega seonduvad rajatised, haljastus, välisvalgustus ning tehnorajatised",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "detailplaneering (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_detailplaneering"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_taristu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taristu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "detailplaneeringuga määratud kütte-, veevarustus-, sademevee- ja kanalisatsioonitorustikud (maaparandussüsteemide rajatised, sademevee kraavid ja –truubid), telekommunikatsiooni- nõrkvoolu- ja elektrivõrgud, küttegaasi- ja elektripaigaldised, tuletõrje veevõtukoht (hüdrant/mahutid), surveseadmestikud ja nende teenindamiseks vajalikud ehitised, välisvalgustus jms.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "taristu (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_taristu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_avalik_ruum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik ruum",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "detailplaneeringuga määratud avalikult kasutatavad teed (sh tee materjalist tõstetud künnised, ümberkeeramis koht - minimaalsuurusega 12x12 meetrit), valgustatud kergliiklusteed, liikluskorralduslik parkimislahendus, üldkasutatav haljasala, jäätmete liigiti kogumise plats (valgustatud ja liikluskorralduslikult lihtsa ligipääsuga ~ 30 m2 ala), mänguväljakud (sisaldades erivanuses kasutajate mänguvahendeid) ja heakorraelemendid jms.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "avalik ruum (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_ruum"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_hupoteek",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hüpoteek",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hüpoteek on kinnisasja pant, mis kantakse kinnistusraamatusse neljandasse jakku. Isikul, kelle kasuks on hüpoteek seatud (hüpoteegipidajal), on õigus hüpoteegiga tagatud nõude rahuldamisele panditud kinnisasja arvel. Teiste sõnadega – kui hüpoteegiga tagatud nõuet ei rahuldata, on hüpoteegipidajal õigus nõuda hüpoteegiga koormatud kinnisasja müüki läbi kohtutäituri",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "hüpoteek (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hupoteek"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_hoidumisservituut",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoidumisservituut",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hoidumisservituudi sisuks on detailplaneeringuga hõlmatud kinnistute igakordsete omanike, samuti nimetatud kinnistute jagamise tulemusena tekkivate kinnistute igakordsete omanike kohustus hoiduda kinnistule detailplaneeringuga ette nähtud hoonete ehitustegevuse alustamisest enne lepinguga võetud kohustuste täitmist.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "hoidumisservituut (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hoidumisservituut"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
