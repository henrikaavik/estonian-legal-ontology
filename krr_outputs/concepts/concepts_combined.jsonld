    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009_reovee_bioloogiline_puhastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee bioloogiline puhastamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk sekundaarne puhastamine on reoveest reoainete kõrvaldamine bioloogiliste protsesside toimel, mille tulemusena heitvesi vastab Vabariigi Valitsuse 29.11.2012. a määruses nr 99 “ Reovee puhastamise ning heit- ja sademevee suublasse juhtimise kohta esitatavad nõuded, heit- ja sademevee reostusnäitajate piirmäärad ning nende nõuete täitmise kontrollimise meetmed“ esitatud heitvee reostusnäitajate piirväärtustele biokeemilise hapnikutarbe, heljuvaine ja keemilise hapnikutarbe osas; 13) reoveekogumisala (erdaspidi rka ) - ala, kus on piisavalt elanikke või majandustegevust reovee kogumiseks kanalisatsiooni kaudu ja reovee reoveepuhastisse või heitvee keskkonda juhtimiseks. Reoveekogumisalad kinnitatakse keskkonnaministri käskkirjaga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039009_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskirja kehtestamine",
      "rdfs:label": "reovee bioloogiline puhastamine (reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_bioloogiline_puhastamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "septik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pealt kinnine setiti, millesse sadestunud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt. Septik on omapuhasti osa, mille ülesandeks on selitada reovees olev heljum. Veetiheda ja ventileeritava kinnise mahuti põhja settivad reovee tahked osad ja lagunevad seal anaeroobselt bioloogiliste protsesside tulemusena. Pärast septiku kambrite (1-3) läbimist voolab heitvesi edasi imb- või filtersüsteemi. Tahke fraktsioon tuleb perioodiliselt eraldada ja vedada käitlemiseks suurema reoveepuhasti juurde",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039009_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskirja kehtestamine",
      "rdfs:label": "septik (reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_septik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009_imbsusteem_reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009_2_15",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "imbsüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "septikule järgnev heitvee puhastussüsteem, kus killustikukihi sisse teatud kindlate vahedega paigaldatud imbtorud jaotavad vee ühtlaselt üle kogu filtreeriva ala (imbväljaku) ning tänu millele imendub sinna valguv vesi ühtlaselt pinnasesse, läbides seejuures pinnaseosakestele kasvanud biokile, mis lagundab vees sisalduvad tahked ainekübemed aeroobselt; 16) filtersüsteem, filterväljak - heitvee puhastussüsteem, mis rajatakse juhul, kui imbsüsteemi paigalduskoha pinnas ei ima või ei lase vett läbi. Killustikukihi alla ehitatakse liivast filtreerimiskiht ja selle alla paigaldatakse drenaažitorud, mis juhivad läbi liivakihi valgunud ja puhastatud vee kogumiskaevu ja sealt suublasse.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039009_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskirja kehtestamine",
      "rdfs:label": "imbsüsteem (reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_imbsusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
