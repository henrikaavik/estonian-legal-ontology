        "@value": "huviharidus on pikaajaline süsteemne juhendatud tegevus vaba tahte alusel üldhariduse",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamise_kord_t1060938_huviharidus_on_pikaajaline_susteemne_juhendatud_tegevus_vaba_tahte_alusel_uldhar"
        }
