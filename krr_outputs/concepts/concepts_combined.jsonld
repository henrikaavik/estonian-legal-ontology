      },
      "rdfs:label": "hoolduskoormusega inimene",
      "skos:altLabel": [
        {
          "@value": "Hoolduskoormusega inimene",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "tööealine hooldaja, kes hooldusvajadusega pereliikme hooldamise tõttu ei saa osaleda või jätkata osalemist tööturul täis- või osalise tööajaga või kellel on oht hoolduskoormuse tõttu tööturult välja langeda",
          "@language": "et"
        },
        {
          "@value": "15-aastane ja vanem inimene, kes üldjuhul tasuta abistab hooldusvajadusega inimest",
          "@language": "et"
        },
        {
          "@value": "tööealine isik, kes hooldusvajadusega pereliikme hooldamise tõttu ei saa osaleda või jätkata osalemist tööturul täis- või osalise tööajaga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
