      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vaike_maarja_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051019_reovee_kogumismahuti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee kogumismahuti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "plastmassist, klaasplastist, betoonist, terasest või mõnest muust materjalist mahuti, kuhu koguneb majapidamises tekkiv reovesi ja kust see veetakse edasiseks käitlemiseks reoveepuhastisse. Nõuetele vastav kogumismahuti on lekkekindel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051019_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja valla reovee kohtkäitluse ja äraveo eeskiri",
