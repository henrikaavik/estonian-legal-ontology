    {
      "@id": "estleg:Concept_nouded_suplusveele_ja_supelrannale_t1047813_reostus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "reostus",
      "skos:definition": "suplusvee mikrobioloogilise saaste või muude suplusvee kvaliteeti mõjutavate organismide, ainete või jäätmete esinemine, sealhulgas § 4 lõikes 3 ja § 8 lõigetes 4–6 ning lisa 1 punkti 6 veerus A nimetatud mikroorganismid, mis ohustavad suplejate tervist; 7",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047813_Par_2"
        }
      ],
      "estleg:sourceAct": "Nõuded suplusveele ja supelrannale",
