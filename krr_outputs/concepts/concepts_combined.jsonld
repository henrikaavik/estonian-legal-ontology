        "@value": "reovee kohtkäitlussüsteemist reovee, -sette või käimlajäätmete eemaldamine ja äravedamine ning selle väljutamine spetsiaalsesse purgimiskohta.",
        "@language": "et"
      },
      "estleg:definedIn": [
