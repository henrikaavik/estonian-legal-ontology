    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "iga territoorium, rajatis, ehitis või ruum, mis on antud üldiseks kasutamiseks või on tegelikult üldkasutatav (tänav, tee, park, mets, haljasala, kalmistu, laululava, suplemiskoht või muu puhkeala, hoov, hoone, rajatis, toitlustusettevõte, baar, kauplus, spordihoone, sadam, koolihoone, rahvamaja, seltsimaja, elamu trepikoda, ühissõiduk, bussipeatus, spordiväljak jms)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
