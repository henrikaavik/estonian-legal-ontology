      "estleg:definesConcept": {
        "@id": "estleg:Concept_heakord"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_heakorraeeskiri_t1052603_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omanik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnisasja või vallasasja omanik. Omanikuga on eeskirjas võrdsustatud ka kinnistamata maaüksuse valdaja, kasutaja ja valitseja, kui valdamine, kasutamine ja valitsemine toimub õiguslikul alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052603_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla heakorraeeskiri",
      "rdfs:label": "omanik (kiili_valla_heakorraeeskiri_t1052603)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_heakorraeeskiri_t1052603_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maatükk), hoonestusõigus, korteriomand ja korterihoonestusõigus. Kinnistuga on eeskirjas võrdsustatud ka kinnistamata maaüksus, mille suhtes isikul on kasutusõigus.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052603_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla heakorraeeskiri",
      "rdfs:label": "kinnistu (kiili_valla_heakorraeeskiri_t1052603)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_heakorraeeskiri_t1052603_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
