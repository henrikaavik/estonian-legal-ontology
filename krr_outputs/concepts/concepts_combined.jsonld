        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Üürielamu",
      "skos:definition": [
        {
          "@value": "taotleja omandis olev taotlejale kuuluval kinnisasjal või hoonestusõigusega koormatud kinnistul asuv kaheksa või enama korteriga elamu, mille kõik korterid on mõeldud üürikorterina kasutamiseks; RT I 2019-04-30 3 130042019003 2019-05-03 8 (",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_uurileandja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "üürileandja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tallinna_eluruumide_kasutusse_andmise_kord_t1058395_uurileandja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "üürileandja",
      "skos:definition": [
        {
          "@value": "Tallinna linn, mida esindab linnavara valitseja või temalt lepingu alusel volituse saanud isik; 14",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_uurileping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "üürileping",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tallinna_eluruumide_kasutusse_andmise_kord_t1058395_uurileping"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "üürileping",
      "skos:definition": [
        {
          "@value": "munitsipaal- või sotsiaaleluruumi kasutamise aluseks olev leping; 15",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_uuriturult_eluruumi_leidmise_toetamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
