      ],
      "skos:prefLabel": "kohtkäitlussüsteem",
      "skos:definition": "rajatis reovee kogumiseks, st reovee kogumismahuti (sh kuivkäimla) või puhastamiseks, st omapuhasti (biopuhasti või septik koos puhastatud reovee suublasse juhtimisega); 8",
      "estleg:definedIn": [
