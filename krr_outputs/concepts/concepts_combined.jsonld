    {
      "@id": "estleg:Concept_reklaamimaks_t1055745_reklaami_paigaldamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaami paigaldamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaami avalikustamise eesmärgil selle eksponeerimine avalikus kohas ning füüsilistele ja juriidilistele isikutele kuuluvatel kinnistutel, territooriumil, ehitisel või selle osal kui see on suunatud avalikkusele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055745_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks",
      "rdfs:label": "reklaami paigaldamine (reklaamimaks_t1055745)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaami_paigaldamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_t1055745_reklaamipind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaamipind",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Narva-Jõesuu linna haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaamipind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055745_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks",
      "rdfs:label": "reklaamipind (reklaamimaks_t1055745)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaamipind"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
