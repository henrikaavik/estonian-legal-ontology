      ],
      "skos:prefLabel": {
        "@value": "teenusleping",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vee-ettevõtja ja kliendi vaheline leping vee- ja kanalisatsiooniteenuse osutamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051204_Par_2"
        }
      ],
      "estleg:sourceAct": "Anija valla ühisveevärgi ja -kanalisatsiooniga liitumise ning kasutamise eeskiri",
