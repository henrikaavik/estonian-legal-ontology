      "rdfs:label": "riiklik registreerimismärk",
      "skos:definition": [
        {
          "@value": "majandus- ja kommunikatsiooniministri 21. juuni 2011. a määruse nr 49 „Riiklikele registreerimismärkidele ja nende valmistamisele esitatavad nõuded” kohane sõiduki tunnusmärk, millele on kantud sõidukile omistatud registreerimisnumber; RT I 2011-12-02 13 102122011013 2011-12-05 14",
          "@language": "et"
        },
        {
          "@value": "majandus- ja kommunikatsiooniministri poolt riiklikele registreerimismärkidele kehtestatud nõuete kohane sõiduki tunnusmärk, millele on kantud sõidukile omistatud registreerimisnumber; 13",
          "@language": "et"
        }
      ]
    },
    {
