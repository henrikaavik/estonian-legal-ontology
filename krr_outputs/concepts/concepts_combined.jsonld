        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muutuvpalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isiku palga või töötasu ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest",
        "@language": "et"
      },
