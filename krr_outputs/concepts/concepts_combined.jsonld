    {
      "@id": "estleg:Concept_kohila_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eesk_t1061205_uhendustoru",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühendustoru",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tarbimiskoha veevärki veega varustav või tarbimiskoha kanalisatsioonist reovett vastuvõttev toru peatorust liitumispunktini; 23) ühisveevärk ja -kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu varustatakse tarbijaid joogiveega ja juhitakse ära ning puhastatakse reovett ning mille projekteeritud jõudlus on vähemalt kümme kuupmeetrit ööpäevas ja mis teenindab vähemalt 50 inimest. Ühisveevärgi ja -kanalisatsioonina käsitatakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos. Sademeveekanalisatsioon Kohila vallas ei ole ühiskanalisatsiooni osa; 24) ühisveevärgi ja -kanalisatsiooni avarii – ühisveevärgi ja -kanalisatsiooni ehitiste või seadmete ettenägematu purunemine või rikkiminek, mille tagajärjel oluliselt halveneb või katkeb tarbijate veega varustamine või nende reovee kanaliseerimine või on ohustatud inimesed, ehitised või keskkond",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061205_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "ühendustoru (kohila_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eesk_t1061205)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhendustoru"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eesk_t1061205_sademeveekanalisatsiooni_avarii",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sademeveekanalisatsiooni avarii",
        "@language": "et"
