        "@id": "estleg:Concept_jaatmekaitleja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_linna_jaatmehoolduseeskiri_t1056868_jaatmejaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmejaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "spetsiaalselt rajatud, tehniliselt varustatud jäätmekäitluskoht, kuhu on paigutatud taaskasutatavate jäätmete kogumiseks ja taaskasutustoiminguks kogumismahutid, sh ohtlike jäätmete kogumismahutid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056868_Par_3"
        }
      ],
      "estleg:sourceAct": "Narva linna jäätmehoolduseeskiri",
      "rdfs:label": "jäätmejaam (narva_linna_jaatmehoolduseeskiri_t1056868)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmejaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_linna_jaatmehoolduseeskiri_t1056868_hankija",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hankija",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "linnavolikogu volitatud juriidiline isik, kes vastab jäätmeseaduse nõuetele; 10) jäätmeveopiirkond (edaspidi piirkond) – eeskirjaga kindlaksmääratud ala, kust kohaliku omavalitsuse üksuse korraldatud jäätmeveoga hõlmatud jäätmed kokku kogutakse",
        "@language": "et"
      },
