    {
      "@id": "estleg:Concept_saaremaa_vallas_avalikult_kasutataval_maa_alal_kaubanduse_ko_t1060624_muugiluba",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "müügiluba",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kaubandustegevust läbi viia sooviva isiku taotlusel antav luba kauba või teenuse müügiks. Vallarajatis on muuhulgas ka Saaremaa vallale kuuluv tänav, parkla, väljak, haljasala või muu avalikult kasutatav maa-ala. Kaubandustegevus hõlmab järgmisi tegevusi: 1) jaekaubandus, mille korral müüakse kaupa kliendile ning millega kaasneva tegevusena võib osutada kliendile teenust või valmistada või serveerida toitu; 2) toitlustamine, mille korral müüakse toitu koos valmistamise ja serveerimisega kohapeal tarbimiseks või serveerimisega kohapeal tarbimiseks ja millega koos võib müüa kaasnevat kaupa või osutada täiendavat teenust; 3) teenindus, mille korral osutatakse kliendile teenust ja millega koos võib osutada esmatasandi tervishoiuteenuseid, sh uuringute läbiviimist.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060624_Par_2"
        }
      ],
      "estleg:sourceAct": "Saaremaa vallas avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
      "rdfs:label": "müügiluba (saaremaa_vallas_avalikult_kasutataval_maa_alal_kaubanduse_ko_t1060624)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muugiluba"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
