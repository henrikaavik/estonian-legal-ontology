    {
      "@id": "estleg:Concept_johvi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054000_kohtkaitlussusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kohtkäitlussüsteem",
      "skos:definition": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (sh kuivkäimla), puhastamiseks (sh biopuhasti) või maapinda immutamiseks; 5",
      "estleg:definedIn": [
