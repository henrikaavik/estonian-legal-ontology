    {
      "@id": "estleg:Concept_linna_valitsev_moju",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Linna valitsev mõju",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_loksa_linna_raamatupidamise_sise_eeskiri_t1056998_Linna_valitsev_moju"
        },
        {
          "@id": "estleg:Concept_tallinna_linna_raamatupidamise_sise_eeskiri_t1013515_linna_valitsev_moju"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Linna valitsev mõju",
      "skos:altLabel": [
        {
          "@value": "linna valitsev mõju",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "Linna omanduses on otse või valitseva mõju all oleva juriidilise isiku kaudu rohkem kui 20% sidusüksuste hääleõigusest, välja arvatud erandjuhud, kui on võimalik selgelt tõlgendada, et sellise hääleõigusega ei kaasne kontrolli. Kontroll eksisteerib ka siis, kui Linnale kuulub 50% ja vähem hääleõigusest, kuid Linn: a) omab tegelikku kontrolli rohkem kui 50% häälõiguse üle kokkuleppe alusel teise investoriga; b) kontrollib juriidilise isiku finants- ja tegevuspoliitikat teatud lepingu või kokkuleppe alusel; c) suudab määrata või tagasi kutsuda enamust tegev- ja kõrgema juhtkonna liikmetest; d) suudab määrata tegevjuhtkonna ja kõrgema juhtorgani koosoleku otsuseid.",
          "@language": "et"
        },
        {
          "@value": "linna omanduses on otse või valitseva mõju all oleva juriidilise isiku kaudu rohkem kui 50% juriidilise isiku hääleõigusest, välja arvatud erandjuhud, kui on võimalik selgelt tõendada, et sellise hääleõigusega ei kaasne kontrolli. Kontroll eksisteerib ka siis, kui linnale kuulub 50% ja vähem hääleõigusest, kuid linn kas: a) omab tegelikku kontrolli rohkem kui 50% hääleõiguse üle kokkuleppe alusel teiste investoritega; b) kontrollib juriidilise isiku finants- ja tegevuspoliitikat teatud lepingu või kokkuleppe alusel; c) suudab määrata või tagasi kutsuda enamikku tegev- ja kõrgema juhtkonna liikmetest; d) suudab määrata tegevjuhtkonna ja kõrgema juhtorgani koosolekute otsuseid.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
