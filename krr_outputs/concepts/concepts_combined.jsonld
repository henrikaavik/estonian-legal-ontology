    {
      "@id": "estleg:Concept_riigieelarvest_muuseumide_tegevustoetuse_taotlemise_taotleja_t1057348_asutaja_ootused",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "asutaja ootused",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "riigi kui sihtasutuse asutaja ja olemasolu korral kaasasutaja sõnastatud strateegilised eesmärgid ja põhimõtted sihtasutuse nõukogule sihtasutuse tulemuslikuks juhtimiseks. Asutaja ootused lähtuvad valdkonnaga seotud arengukavadest ja on alus sihtasutuse arengukava koostamisel. Asutaja ootuste täitmise aruanne on sisend asutajaõiguste teostajale, et hinnata sihtasutuse edukust eesmärkide täitmisel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057348_Par_2"
        }
      ],
      "estleg:sourceAct": "Riigieelarvest muuseumide tegevustoetuse taotlemise, taotleja hindamise ja toetuse määramise tingimused ja kord",
      "rdfs:label": "asutaja ootused (riigieelarvest_muuseumide_tegevustoetuse_taotlemise_taotleja_t1057348)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_asutaja_ootused"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riigieelarvest_muuseumide_tegevustoetuse_taotlemise_taotleja_t1057348_tegevustoetus",
      "@type": [
