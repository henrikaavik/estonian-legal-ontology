      "skos:prefLabel": {
        "@value": "reovee kohtkäitlusrajatis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee tekkimise asukohas kasutatav lekkekindel tehnoloogiline rajatis sh reovee kogumismahuti, omapuhasti või kuivkäimla kogumismahuti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054491_Par_2"
        }
      ],
