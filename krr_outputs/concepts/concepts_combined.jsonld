    },
    {
      "@id": "estleg:Concept_puude_raiumiseks_loa_andmise_kord_harku_vallas_t1042779_vaartusklass_I",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "väärtusklass I",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eriti väärtuslik puu, mis on haruldane Eesti dendroflooras, omab ajaloolist või kultuuriloolist tähtsust, samuti loodus- ja/või muinsuskaitse all olev puu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042779_Par_2"
        }
      ],
      "estleg:sourceAct": "Puude raiumiseks loa andmise kord Harku vallas",
      "rdfs:label": "väärtusklass I (puude_raiumiseks_loa_andmise_kord_harku_vallas_t1042779)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vaartusklass_i"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_puude_raiumiseks_loa_andmise_kord_harku_vallas_t1042779_vaartusklass_II",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "väärtusklass II",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puu, mis on elujõuline ja ökoloogiliselt suurt tähtsust omav puu, olles seejuures taksoni kohta suurte või keskmiste dimensioonidega (mõõtmetetga) ja/või tähelepanuväärsete dekoratiivsete iseärasustega. Haljastusplaani (istutusskeemi) järgi istutatud haljastuspuu ning elujõuline okaspuu.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042779_Par_2"
        }
      ],
      "estleg:sourceAct": "Puude raiumiseks loa andmise kord Harku vallas",
      "rdfs:label": "väärtusklass II (puude_raiumiseks_loa_andmise_kord_harku_vallas_t1042779)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vaartusklass_ii"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaksu_kehtestamise_kord_t1055052_reklaamikandja",
      "@type": [
        "owl:NamedIndividual",
