    {
      "@id": "estleg:Concept_sporditegevuse_toetamise_kord_johvi_vallas_t1054762_spordiklubi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "spordiklubi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Jõhvi valla haldusterritooriumil registreeritud ja vähemalt ühe aasta tegutsenud eraõiguslik juriidiline isik, mille põhitegevuseks on spordi arendamine ning kus treeningtegevus toimub vähemalt 11 kuul aastas vähemalt 3 korda nädalas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054762_Par_2"
        }
      ],
      "estleg:sourceAct": "Sporditegevuse toetamise kord Jõhvi vallas",
      "rdfs:label": "spordiklubi (sporditegevuse_toetamise_kord_johvi_vallas_t1054762)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_spordiklubi"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sporditegevuse_toetamise_kord_johvi_vallas_t1054762_treener",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "treener",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sportlasi ja teisi spordis osalevaid isikuid juhendav spordispetsialist, kellel on treeneri kutsekvalifikatsioon kutseseaduse tähenduses või tunnustatud kutsekvalifikatsioon välisriigi kutsekvalifikatsiooni tunnustamise seaduse tähenduses. Treeneril, kes juhendab noori vanuses 6–21 aastat, peab olema vähemalt treeneri kutsekvalifikatsiooni 4. tase",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054762_Par_2"
        }
      ],
      "estleg:sourceAct": "Sporditegevuse toetamise kord Jõhvi vallas",
      "rdfs:label": "treener (sporditegevuse_toetamise_kord_johvi_vallas_t1054762)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_treener"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
