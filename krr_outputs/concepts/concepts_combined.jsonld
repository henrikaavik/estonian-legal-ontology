      },
      "rdfs:label": "peamasinate efektiivne koguvõimsus",
      "skos:definition": [
        {
          "@value": "laeva peamasinate nimiväljundvõimsus kilovattides, mis kantakse üle käiturile ja mis on kajastatud laeva registreerimistunnistusel või muus ametlikus dokumendis",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
