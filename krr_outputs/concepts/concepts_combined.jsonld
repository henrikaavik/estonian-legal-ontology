      "estleg:definesConcept": {
        "@id": "estleg:Concept_norgvesi"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_ohtlik_aine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
