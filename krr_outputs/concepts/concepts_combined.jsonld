      "skos:definition": {
        "@value": "digitaalne majandussüsteem, kus tehingud erinevate majandussubjektide vahel toimuvad reaalajas või peaaegu reaalajas struktureeritud, standarditud ja masinloetavate digitaalandmete võimalikult automaatse vahetamise teel",
        "@language": "et"
      },
