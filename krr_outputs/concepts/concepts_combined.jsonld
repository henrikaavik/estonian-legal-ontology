        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "peatorustik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühisveevärgi või -kanalisatsiooni torustik, välja arvatud ühendustorustik, mille kaudu toimub tarbimiskoha veega varustamine või tarbimiskohalt reo- ja sademevee ärajuhtimine",
        "@language": "et"
      },
      "estleg:definedIn": [
