        {
          "@value": "Reklaam",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edendamise või isiku käitumise avalikes huvides suunamise eesmärgil; 2",
          "@language": "et"
        },
        {
          "@value": "reklaam reklaamiseaduse tähenduses ning liiklusväline teabevahend teeseaduse mõttes; 2",
          "@language": "et"
        },
        {
          "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, sündmuse edendamise või isiku käitumise avalikes huvides suunamise eesmärgil; 2",
          "@language": "et"
        },
        {
          "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edendamise või üritusest teavitamise või isiku käitumise avalikes huvides suunamise eesmärgil; 2",
          "@language": "et"
        },
        {
          "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edenemise või isiku käitumise avalikes huvides suunamise eesmärgil; 2",
          "@language": "et"
        }
      ]
    },
