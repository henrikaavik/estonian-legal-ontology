      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "hanke eest vastutav isik",
      "skos:definition": "vastutab hanke korraldamise seaduslikkuse eest vastavalt riigihankeseaduses ja hankedokumentides sätestatud nõuetele, sh juhib hankega seotud komisjonide tööd ja korraldab riigihangete registrisse hankemenetlusega seotud informatsiooni edastamist; 2",
      "estleg:definedIn": [
