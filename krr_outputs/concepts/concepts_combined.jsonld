      },
      "rdfs:label": "hooldamine",
      "skos:definition": [
        {
          "@value": "abivajadus, mille sisu määratakse linnavalitsuse korralduses; 9",
          "@language": "et"
        },
        {
          "@value": "abivajadus, mille sisu määratakse vallavalitsuse korralduses.",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_hooldatav",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hooldatav",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_taisealisele_isikule_hoolduse_seadmise_hooldaja_maaramise_ja_t1043261_Hooldatav"
        },
        {
          "@id": "estleg:Concept_hoolduse_seadmise_hooldaja_maaramise_ja_hooldajatoetuse_maks_t1060976_hooldatav"
        },
        {
          "@id": "estleg:Concept_puudega_isikule_hoolduse_seadmise_hooldaja_maaramise_ja_hool_t1058897_hooldatav"
        },
        {
          "@id": "estleg:Concept_taisealisele_isikule_hoolduse_seadmine_hooldaja_maaramine_ja_t1041867_hooldatav"
        },
        {
          "@id": "estleg:Concept_hoolduse_seadmise_hooldaja_maaramise_ning_hooldajatoetuse_ma_t1049654_hooldatav"
        },
        {
          "@id": "estleg:Concept_saue_valla_sotsiaalhoolekandelise_abi_andmise_kord_t1058295_hooldatav"
        },
        {
          "@id": "estleg:Concept_hooldaja_maaramise_ja_hooldajatoetuse_maksmise_kord_t1054187_Hooldatav"
        },
        {
          "@id": "estleg:Concept_hoolduse_seadmise_hooldaja_maaramise_ja_hooldajatoetuse_maks_t1047383_hooldatav"
        },
        {
          "@id": "estleg:Concept_taisealise_isiku_hoolduse_seadmise_hooldaja_maaramise_ning_h_t1042005_hooldatav"
        }
      ],
      "estleg:definitionCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hooldatav",
      "skos:altLabel": [
        {
          "@value": "Hooldatav",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "igapäevast kõrvalabi, juhendamist ja järelevalvet vajav vaimse või füüsilise puudega täisealine isik, kellele on puuetega inimeste sotsiaaltoetuste seaduse kohaselt määratud raske või sügav puue. 2",
          "@language": "et"
        },
        {
          "@value": "isik, kelle hooldusvajadus on välja selgitatud hindamise abil ning tal on ajutiselt või püsivalt vajadus kasutada kõrvalabi; 3",
          "@language": "et"
        },
        {
          "@value": "isik, kelle hooldusvajadus on välja selgitatud ning kellel on ajutiselt või püsivalt vaja kasutada pidevat kõrvalabi; 2",
          "@language": "et"
        },
        {
          "@value": "kõrvalabi, juhendamist ja järelevalvet vajav vaimse või füüsilise puudega isik, kellele on puuetega inimeste sotsiaaltoetuste seaduse kohaselt määratud raske või sügav puue; 2",
          "@language": "et"
        },
        {
          "@value": "kõrvalabi, juhendamist ja järelevalvet vajav vaimse või füüsilise puudega ja/või kõrvalekaldega isik, kes vajab abi igapäevaelutoimingute sooritamisel. 2",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_hooldaja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_hooldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hooldus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_taisealisele_isikule_hoolduse_seadmise_hooldaja_maaramise_ja_t1043261_Hooldus"
        },
        {
          "@id": "estleg:Concept_puudega_isikule_hoolduse_seadmise_hooldaja_maaramise_ja_hool_t1058897_hooldus"
        },
        {
          "@id": "estleg:Concept_hoolduse_seadmise_hooldaja_maaramise_ning_hooldajatoetuse_ma_t1049654_hooldus"
        },
        {
          "@id": "estleg:Concept_saue_valla_sotsiaalhoolekandelise_abi_andmise_kord_t1058295_hooldus"
        },
        {
          "@id": "estleg:Concept_hooldaja_maaramise_ja_hooldajatoetuse_maksmise_kord_t1054187_Hooldus"
        },
        {
          "@id": "estleg:Concept_viimsi_valla_sademeveesusteemide_kasutamise_eeskiri_t1051954_Hooldus"
        },
        {
          "@id": "estleg:Concept_hoolduse_seadmise_hooldaja_maaramise_ja_hooldajatoetuse_maks_t1047383_hooldus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hooldus",
      "skos:altLabel": [
        {
          "@value": "Hooldus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "hooldaja igapäevane füüsiline tegevus hooldatavale kõrvalabi osutamiseks, hooldatava juhendamine söömisel, hügieenitoimingutes, riietumisel, liikumisel või suhtlemisel ning hooldatava ohutuse tagamine juhul, kui ta oma tegevuse või tegevusetusega võib tekitada kahju iseenda või teiste inimeste elule, tervisele või varale; 7",
          "@language": "et"
        },
        {
          "@value": "hooldaja igapäevane füüsiline tegevus hooldatavale kõrvalabi osutamisel ja juhendamisel söömisel, hügieenitoimingutes, riietumisel, liikumisel või suhtlemisel, abistamine hooldatava õiguste teostamisel ja kohustuste täitmisel toimingutes ja tehingutes, milles hooldatava teovõime ei ole piiratud. Hooldus sisaldab ka järelevalvet, st ohutuse tagamist inimese suhtes, kes oma tegevuse või tegevusetusega võib tekitada kahju iseenda või teiste inimeste elule, tervisele või varale; 7",
          "@language": "et"
        },
        {
          "@value": "hooldaja poolne kõrvalabi, juhendamine ja järelevalve hooldatava üle; 4",
          "@language": "et"
        },
        {
          "@value": "sademeveesüsteemi pideva toimimise tagamiseks tehtav korraline töö. 6",
          "@language": "et"
        },
        {
          "@value": "vajaliku kõrvalabi, juhendamise ja järelevalve tagamine isikule, kes ei tule iseseisvalt toime söömise, hügieenitoimingute, riietumise, liikumise ja/või suhtlemisega ning kes oma tegevuse või tegevusetusega võib tekitada kahju iseenda või teiste inimeste elule, tervisele või varale; 4",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_hooldusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hooldusala",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kolga_jaani_valla_heakorraeeskiri_t1002995_hooldusala"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hooldusala",
      "skos:definition": [
        {
          "@value": "kinnistuga või krundiga külgnev maa-ala kuni sõiduteeni. Vallavalitsus võib, võttes arvesse maa-ala asukohta, määrata ka teistsuguse hooldusala. Vaidlused hooldusala suuruse üle lahendab vallavalitsus; 5",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_hoolduskava"
        }
      ]
    },
    {
      "@id": "estleg:Concept_hooldusala_on_kinnistuga_voi_krundiga_kulgnev_maa_ala_kuni_konni",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hooldusala on kinnistuga või krundiga külgnev maa-ala kuni kõnni",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toila_valla_heakorraeeskiri_t1044107_hooldusala_on_kinnistuga_voi_krundiga_kulgnev_maa_ala_kuni_konni"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hooldusala on kinnistuga või krundiga külgnev maa-ala kuni kõnni",
      "skos:definition": [
        {
          "@value": "või sõiduteeni. Vallavalitsus võib, võttes arvesse maa-ala asukohta, määrata ka teistsuguse hooldusala; 16",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_hoolduse_seadmine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoolduse seadmine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_taisealisele_isikule_hoolduse_seadmine_hooldaja_maaramine_ja_t1041867_hoolduse_seadmine"
        },
        {
          "@id": "estleg:Concept_taisealise_isiku_hoolduse_seadmise_hooldaja_maaramise_ning_h_t1042005_hoolduse_seadmine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hoolduse seadmine",
      "skos:definition": [
        {
          "@value": "abivajavale isikule tema taotluse alusel kõrvalabi osutamise korraldamine tuvastades tema abivajaduse sisu, määrates hooldaja ja tema ülesanded; 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_hoolduskava",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoolduskava",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_koduteenuse_osutamise_tingimused_ja_kord_t1050439_hoolduskava"
        },
        {
          "@id": "estleg:Concept_koduteenuse_osutamise_kord_t1043350_hoolduskava"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hoolduskava",
      "skos:definition": [
        {
          "@value": "on teenuse vajaduse hindamise juures kohustuslik lisadokument, milles kajastatakse osutatavate teenuste loetelu, maht, teenuse osutamise aeg ja koht ning millele kirjutavad alla teenust vajav isik või tema seadusjärgne ülalpidaja.",
          "@language": "et"
        },
        {
          "@value": "teenusevajaduse hindamisel koostatav dokument, mis sisaldab kirjeldust kõrvalabi vajava isiku seisundi kohta ja temale osutatavate teenuste loetelu, kestvuse, ulatuse ja osutamise tingimused; 5",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_hooldusala"
        }
      ]
    },
    {
      "@id": "estleg:Concept_hoolduskoormusega_inimene",
