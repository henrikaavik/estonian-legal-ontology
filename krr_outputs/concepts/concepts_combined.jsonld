        {
          "@id": "estleg:Concept_vaikelaeva_alla_12_meetrise_kogupikkusega_laeva_ja_jeti_regi_t1022895_vastavusdeklaratsioon"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "vastavusdeklaratsioon",
      "skos:definition": [
        {
          "@value": "tootja kirjalik kinnitus, et jett või väikelaev vastab käesoleva paragrahvi punktis 16 nimetatud direktiiviga esitatud nõuetele ja järgitud on direktiivis sätestatud väikelaeva või jeti nõuetele vastavuse tõendamise korda",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vastutav_ametnik",
