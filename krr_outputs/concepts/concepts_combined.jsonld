          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni arendamise kavas sätestatud (otseselt liitumisega seostatav) piirkond, kus arendatakse ühisveevärki ja -kanalisatsiooni vastavalt ühisveevärgi ja -kanalisatsiooni arendamise kavale. 3",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni arengukavas sätestatud (otseselt liitumisega seostatav) piirkond, kus arendatakse ühisveevärki ja kanalisatsiooni vastavalt ühisveevärgi ja - kanalisatsiooni arengukavale; 4",
          "@language": "et"
        },
