      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_puka_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_eeski_t1028459_reostus",
      "@type": [
        "owl:NamedIndividual",
