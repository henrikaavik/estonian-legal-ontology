    {
      "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_reoveekogumisala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "reoveekogumisala",
      "skos:definition": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee suublasse juhtimiseks. Reoveekogumisalad jagunevad suurteks (koormusega üle 2000 inimekvivalendi) ja väikesteks (koormusega alla 2000 inimekvivalendi); 13",
      "estleg:definedIn": [
