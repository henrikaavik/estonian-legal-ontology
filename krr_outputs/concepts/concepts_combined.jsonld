    {
      "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetuse_andmise_tingimused_j_t1046780_energiamargis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiamärgis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav märgis, mis annab infot projekteeritava või olemasoleva hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta; energiasäästu maht – energiamärgise kohase energiaerikasutuse ja energiaarvutusel põhineva energiamärgise kohase planeeritava energiaerikasutuse vahe, kusjuures energiaerikasutuseks loetakse aastane tarnitud energiate summaarne kasutus kilovatt-tundides hoone köetava pinna ruutmeetri kohta [kWh/(m²·a)]",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046780_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute rekonstrueerimise toetuse andmise tingimused ja kord",
      "rdfs:label": "energiamärgis (korterelamute_rekonstrueerimise_toetuse_andmise_tingimused_j_t1046780)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_energiamargis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetuse_andmise_tingimused_j_t1046780_energiatohususarv",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiatõhususarv",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "arvutuslik summaarne tarnitud energiate kaalutud erikasutus hoone tüüpilisel kasutusel, millest arvatakse maha summaarne eksporditud energiate erikasutus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046780_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute rekonstrueerimise toetuse andmise tingimused ja kord",
