    {
      "@id": "estleg:Concept_koerte_ja_kasside_pidamise_eeskiri_luganuse_vallas_t1051444_lemmikloom",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lemmikloom",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "inimese isiklikuks meelelahutuseks või seltsiks peetav või sellel eesmärgil pidamiseks mõeldud loom.",
        "@language": "et"
      },
      "estleg:definedIn": [
