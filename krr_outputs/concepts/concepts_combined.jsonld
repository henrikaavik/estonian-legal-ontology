      "estleg:definitionCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "rdfs:label": "infovara",
      "skos:altLabel": [
        {
          "@value": "Infovara",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "mistahes kujul talletatud andmed ja informatsioon, mis on asutusele väärtuslik ja mida asutus kasutab oma põhimääruses ettenähtud ülesannete täitmiseks ning asutuse omandis olevad infotöötlusvahendid, rakendused ja taristu, mis tagavad asutusele informatsiooni nõuetekohase töötlemise",
          "@language": "et"
        },
        {
          "@value": "informatsioon, andmed ja nende töötlemiseks vajalikud infotehnoloogilised rakendused ning tehnilised vahendid",
          "@language": "et"
        },
        {
          "@value": "asutuse valduses või vastutusel olev teave ja andmed (sh isikuandmed, töö- ja menetlusdokumendid, registri- ja andmekogude andmed, logid), sõltumata vormist ja kandjast; vajadusel kasutatakse infovara kirjeldamisel eraldi mõistena „infosüsteem” ning „taristu”",
          "@language": "et"
        },
        {
          "@value": "mis tahes viisil kogutud, jäädvustatud ja töödeldud andmete kogum mistahes andmekandjal, sh paberkandjal",
          "@language": "et"
        },
        {
          "@value": "mistahes kujul talletatud informatsioon, mis on asutusele väärtuslik ja mida asutus kasutab oma põhimääruses ettenähtud ülesannete täitmiseks ning asutuse omandis olevad infotöötlusvahendid, rakendused ja taristu, mis tagavad asutusele informatsiooni nõuetekohase töötlemise",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
