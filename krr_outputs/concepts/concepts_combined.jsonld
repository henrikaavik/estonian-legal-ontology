    {
      "@id": "estleg:Concept_haademeeste_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049110_heitvesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heitvesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kasutusel olnud vesi, mis juhitakse suublasse. Heitveeks ei peeta sademevett, kaevandusvett, karjäärivett, jahutusvett, maaparandussüsteemis voolavat vett ega vesiviljeluses ja hüdroenergia tootmises kasutatavat vett",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049110_Par_2"
        }
      ],
      "estleg:sourceAct": "Häädemeeste valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "heitvesi (haademeeste_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049110)",
      "estleg:definesConcept": {
