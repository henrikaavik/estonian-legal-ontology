        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sulgeja",
      "skos:definition": [
        {
          "@value": "füüsiline või juriidiline isik, kellele on antud sulgemisluba ja kelle tegevusega kaasneb tee, teelõigu, parkla või väljaku täielik või osaline ajutine sulgemine",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kelle tegevusega kaasneb tee, teelõigu, parkla või väljaku täielik või osaline ajutine sulgemine olenemata sellest, kas talle on antud sulgemisluba või mitte; 2015-10-21",
          "@language": "et"
        }
      ],
