      "skos:definition": [
        {
          "@value": "koolieast noorematele lastele hoidu ja alushariduse omandamist võimaldav õppeasutus, mis juhindub oma tegevuses koolieelse lasteasutuse seadusest ja erakooliseadusest",
          "@language": "et"
        }
      ],
