      ],
      "skos:prefLabel": {
        "@value": "suverühm",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Keila linna lasteaia juures suveperioodil (juulikuus) vastavalt võimalusele ja vajadusele töötav lasteaiarühm, kuhu võetakse Keila lasteaedades juba kohta kasutavaid lapsi vanema või üksikvanema avalduse alusel.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061621_Par_1"
        }
      ],
      "estleg:sourceAct": "Osalustasu kehtestamine Keila linna lasteaedades",
