      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_teenistuskoht"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "palk",
      "skos:definition": "tasu, mida makstakse ametnikule teenistusülesannete täitmise eest ja tasu, mida makstakse töötajale töölepingu alusel tehtud töö eest; 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue Vallavalitsuse palgajuhend",
      "rdfs:label": "palk (saue_vallavalitsuse_palgajuhend_t1040965)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_palk"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_palk"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "põhipalk",
      "skos:definition": "fikseeritud ja regulaarne palga osa ametijuhendis ettenähtud teenistusülesannete ja ettenähtud teenistusalase hariduse, teadmiste, oskuste ja kogemuste eest; 7",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue Vallavalitsuse palgajuhend",
      "rdfs:label": "põhipalk (saue_vallavalitsuse_palgajuhend_t1040965)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pohipalk"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_pohipalk"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_muutuvpalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "muutuvpalk",
      "skos:definition": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue Vallavalitsuse palgajuhend",
      "rdfs:label": "muutuvpalk (saue_vallavalitsuse_palgajuhend_t1040965)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muutuvpalk"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_muutuvpalk"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_tulemuspalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "tulemuspalk",
      "skos:definition": "vallavanema või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu; 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue Vallavalitsuse palgajuhend",
      "rdfs:label": "tulemuspalk (saue_vallavalitsuse_palgajuhend_t1040965)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tulemuspalk"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_tulemuspalk"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_preemia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "preemia",
      "skos:definition": "ühekordne tasu teenistuja tunnustamiseks erakordsete teenistusalaste saavutuste eest; 10",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue Vallavalitsuse palgajuhend",
