    {
      "@id": "estleg:Concept_saue_valla_munitsipaallasteaeda_ja_hoidu_vastuvotmise_ja_sea_t1062616_laps",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "laps",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "laps, kelle rahvastikuregistrijärgne või tegelik elukoht on Saue vallas. Juhul, kui lapse elukoht ei ole rahvastikuregistri andmetel Saue vallas, esitab vanem või eestkostja Saue Vallavalitsusele selle tõendamiseks vajaliku dokumendi (dokument jagatud vanemluse kohta, asendushooldusteenuse leping vms) ja saab seejärel registris taotluse esitamise õiguse.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062616_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue valla munitsipaallasteaeda ja -hoidu vastuvõtmise ja sealt väljaarvamise kord",
      "rdfs:label": "laps (saue_valla_munitsipaallasteaeda_ja_hoidu_vastuvotmise_ja_sea_t1062616)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_laps"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
