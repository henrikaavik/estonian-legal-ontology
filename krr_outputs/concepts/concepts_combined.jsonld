    {
      "@id": "estleg:Concept_koerte_ja_kasside_pidamise_eeskiri_t1054552_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "avalik koht",
      "skos:definition": "territoorium, rajatis või ruum, mis on antud üldiseks kasutamiseks või mis on tegelikult üldkasutatav (pargid, teed, tänavad, hoovid, haljasalad, parklad, kalmistud, avalikud veekogud, staadionid, mänguväljakud, bussootepaviljonid, ettevõtete piirdeaiata territooriumid, väljakud või muu säärane koht), üldkasutatavad hooned (ametiasutused, koolid, klubid, raamatukogud, spordihooned, toitlustus- ja kaubandusettevõtted, saunad, lasteaiad, kirikud, palvemajad või muu säärane koht), korterelamude üldkasutatavad ruumid (trepikojad, pööningud, keldrid või muu säärane koht), ühistransport; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054552_Par_2"
        }
      ],
      "estleg:sourceAct": "Koerte ja kasside pidamise eeskiri",
