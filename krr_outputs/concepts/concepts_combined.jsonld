    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_meetmes_ettevotete_ressursitohusu_t1043913_umberpaigutamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "ümberpaigutamine",
      "skos:definition": "sama või sarnase tegevuse või selle osa üleviimine ühest EMP (Euroopa Majanduspiirkond) lepingu osalisriigi ettevõttest (algne ettevõte) teise EMP lepingu muus osalisriigis asuvasse ettevõttesse, kuhu toetatav investeering tehakse (toetatav ettevõte). Ümberpaigutamine toimub siis, kui toode või teenus täidab nii algses kui ka toetatavas ettevõttes vähemalt osaliselt sama otstarvet ja vastab sama liiki tarbija nõudmistele või vajadustele ja EMPs asuva abisaaja ühes ettevõttes lähevad samas või sarnases tegevusalas kaduma töökohad.",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043913_Par_2"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused meetmes „Ettevõtete ressursitõhusus” tegevuse „Investeeringud parimasse võimalikku ressursitõhusasse tehnikasse; ressursijuhtimissüsteemide ja toetavate IT-rakenduste toetamine” jaoks väikeprojektidele avatud taotlemise korral",
      "rdfs:label": "ümberpaigutamine (toetuse_andmise_tingimused_meetmes_ettevotete_ressursitohusu_t1043913)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_umberpaigutamine"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_umberpaigutamine"
        }
