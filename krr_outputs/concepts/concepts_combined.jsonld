      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduse_toetamise_kord_t1056792_oppekoha_tegevuskulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "õppekoha tegevuskulu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "huvikooli õppekoha tegevuskulu arvestuslik maksumus ühe õppuri huvihariduse omandamiseks ühe õppekava ulatuses, mis kaetakse kogu ulatuses huvitegevuse toetusest ja lapsevanema osalustasust; 4) tegevuskulu maksumuse ja lapsevanema poolt makstava tasu summa. Õppekoha maksumus sisaldab kõiki kulusid, mis kaasnevad huvikooli õppe läbiviimisega, sealhulgas personalikulud, hoonete haldamise kulud ja muud kaasnevad jooksvad kulud, välja arvatud investeeringukulud, mis on seotud huvitegevuse läbiviimisega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056792_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse toetamise kord",
      "rdfs:label": "õppekoha tegevuskulu (huvihariduse_toetamise_kord_t1056792)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_oppekoha_tegevuskulu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduse_toetamise_kord_t1056792_lapsevanema_osalustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lapsevanema osalustasu",
