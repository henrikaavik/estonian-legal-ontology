      "rdfs:label": "Korterelamu fassaadi välisviimistluse uuendamine",
      "skos:definition": [
        {
          "@value": "elamu fassaadi ringpiires osaline või terviklik soojustamine, krohvimine, värvimine, lõppviimistlusega materjalide paigaldamine, trepikodade akende vahetamine, trepikoja välisuste asendamine, keldriakende asendamine, trepimademe katuse paigaldamine, välistreppide, sokli ja panduse remont, rõdu/lod˛a asendamine või remont (ah piirded); 9",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_korterelamu_katusekatte_vahetamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Korterelamu katusekatte vahetamine",
