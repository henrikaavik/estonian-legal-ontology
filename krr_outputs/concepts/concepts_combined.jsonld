      "@id": "estleg:Concept_investeerimisuhingu_investeerimisuhingu_emaettevotja_ja_vali_t328957_Keskvalitsus_on_uldine_maaratlus_iga_valitsus",
      "@type": [
        "owl:NamedIndividual",
