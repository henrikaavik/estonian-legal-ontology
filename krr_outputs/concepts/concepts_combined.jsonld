    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_kompetentsikeskuse_konkurentsivoime",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kompetentsikeskuse konkurentsivõime",
      "skos:definition": "piirkonnas tegutseva kompetentsikeskuse võime saavutada tervikuna selline väljaarendatuse tase, mis annab perspektiivis eelduse koostöö- ja partnerlussidemete loomiseks või kujuneda konkurentsivõimeliseks nii Eestis kui välisriigis olevate samalaadsete, konkreetses kompetentsivaldkonnas tegutsevate organisatsioonidega; 8",
      "estleg:definedIn": [
