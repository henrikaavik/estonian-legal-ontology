    {
      "@id": "estleg:Concept_vanemliku_hoolitsuseta_laps",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vanemliku hoolitsuseta laps",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sotsiaaltoetuste_andmise_kord_loksa_linnas_t1051860_vanemliku_hoolitsuseta_laps"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "vanemliku hoolitsuseta laps",
      "skos:definition": [
        {
          "@value": "alaealine, kellel faktiliselt puuduvad mõlemad vanemad põhjusel, et vanemad on surnud, kohus on neilt võtnud ära lapse hooldusõiguse, vanemad on psüühilise erivajaduse tõttu paigutatud hoolekandeasutusse või vanemad viibivad kinnipidamisasutuses; 4) huviharidus käesoleva korra tähenduses on munitsipaal- või erahuvikoolides antav haridus; 5) huvitegevus käesoleva korra tähenduses on süsteemne juhendatud tegelemine vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal. Huvitegevusega tegeletakse huviringides, klubides, stuudiotes vms. Huvitegevuseks ei loeta lühiajalisi kursuseid ja tervisesporti. 6) toimetulekuraskustega pere käesoleva korra tähenduses on pere, mille leibkonna netosissetulek ühe pereliikme kohta on väiksem kui 50% töötasu alammäärast kuus.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
