    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_hankeleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "hankeleping",
      "skos:definition": "linna asutuse ja eduka pakkuja vahel sõlmitud rahaliste huvidega seotud leping, sealhulgas kontsessioonileping, mille esemeks on asjad, teenused või ehitustööd; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
