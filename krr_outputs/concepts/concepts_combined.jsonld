      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kose_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054491_reovee_kohtkaitlusrajatis",
