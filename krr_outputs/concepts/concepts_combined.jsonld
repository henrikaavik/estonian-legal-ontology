        "@id": "estleg:Concept_muutuvpalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
