          "@id": "estleg:Concept_kiirgustegevuse_ohuastme_maaramise_kord_t1061534_taristu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "taristu",
      "skos:definition": [
        {
          "@value": "detailplaneeringuga määratud kütte-, veevarustus-, sademevee- ja kanalisatsioonitorustikud (maaparandussüsteemide rajatised, sademevee kraavid ja –truubid), telekommunikatsiooni- nõrkvoolu- ja elektrivõrgud, küttegaasi- ja elektripaigaldised, tuletõrje veevõtukoht (hüdrant/mahutid), surveseadmestikud ja nende teenindamiseks vajalikud ehitised, välisvalgustus jms.",
          "@language": "et"
        },
        {
          "@value": "infosüsteemide toimimiseks vajalik tehniline keskkond (serverid, võrguseadmed, tööjaamad, andmesalvestus, varundus, sidekanalid, hooned ja ruumid jms)",
          "@language": "et"
        },
        {
          "@value": "kiirgustegevuse tegija füüsiline infrastruktuur, mis hõlmab püsivaid ehitisi, tehnosüsteeme ning varjestus- ja ohutussüsteeme, mis tagavad kiirgusallikate ohutu ja turvalise kasutamise.",
          "@language": "et"
        },
        {
          "@value": "planeerimisseaduse § 131 lõikes 1 nimetatud detailplaneeringukohane - avalikuks kasutamiseks ette nähtud tee ning sellega seotud rajatised; - haljastus- ja tehnorajatised (sh välisvalgustus); - planeeringulahenduse elluviimiseks otseselt vajalikud ja sellega funktsionaalselt seotud ehitised; - planeeringulahendusest sõltuvad maaparandussüsteemi ehitised ja -rajatised.",
          "@language": "et"
        },
        {
          "@value": "planeerimisseaduse § 131 lõikes 1 nimetatud detailplaneeringukohane avalikuks kasutamiseks ette nähtud tee ning sellega seotud rajatised, haljastus ja tehnorajatised (sh välisvalgustus) ning planeeringulahenduse elluviimiseks otseselt vajalikud ja sellega funktsionaalselt seotud ehitised.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
