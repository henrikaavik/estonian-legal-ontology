    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "teenistuja",
      "skos:definition": "vastavalt avaliku teenistuse seaduse § 5 alusel on avalik teenistuja asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja (s.o. töölepingu alusel töötav); 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (saue_vallavalitsuse_palgajuhend_t1040965)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_teenistuja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "ametnik",
      "skos:definition": "isik, kes on asutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (saue_vallavalitsuse_palgajuhend_t1040965)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_ametnik"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "töötaja",
      "skos:definition": "asutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (saue_vallavalitsuse_palgajuhend_t1040965)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_tootaja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_teenistuskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "teenistuskoht",
      "skos:definition": "ametiasutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht; 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuskoht (saue_vallavalitsuse_palgajuhend_t1040965)",
