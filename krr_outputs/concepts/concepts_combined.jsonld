        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "omanik",
      "skos:definition": "füüsiline või juriidiline isik, kelle omandis on maa või ehitised või kelle kasuks on seatud hoonestusõigus; heakorra nõuete täitmisel on omanikuga võrdsustatud tema poolt volitatud valdaja, haldaja või kasutaja. Juhul, kui omaniku poolt sõlmitud leping ei kehtesta teise poole kohustusi heakorra tagamiseks, lasub nimetatud kohustus omanikul; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055130_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla heakorraeeskiri",
      "rdfs:label": "omanik (johvi_valla_heakorraeeskiri_t1055130)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_omanik"
        }
      ]
    },
    {
      "@id": "estleg:Concept_johvi_valla_heakorraeeskiri_t1055130_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kinnistu",
      "skos:definition": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maatükk), hoonestusõigus, kasutusvaldus, korteriomand, korterihoonestusõigus või muud võimalik seadusjärgne kasutus, samuti katastriüksus ja reformimata riigimaa; heakorra nõuete täitmisel on võrdsustatud mõisteteks maa-ala, territoorium, krunt, maaüksus ja katastriüksus; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055130_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla heakorraeeskiri",
      "rdfs:label": "kinnistu (johvi_valla_heakorraeeskiri_t1055130)",
      "estleg:definesConcept": {
