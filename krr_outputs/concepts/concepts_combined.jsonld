      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "reovee kohtkäitlussüsteem",
      "skos:definition": [
        {
          "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee ja käimlajäätmete kogumiseks, puhastamiseks ja/või maapinda immutamiseks, sh reovee ajutiseks kogumiseks (nt kogumismahuti, kuivkäimla) või reovee puhastamiseks ja nõuetekohaselt puhastatult heitveena suublasse juhtimiseks (nt omapuhasti, sh isikliku majapidamise reoveepuhasti)",
          "@language": "et"
        },
        {
          "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (kogumismahuti, kuivkäimla) puhastamiseks või maapinda immutamiseks",
          "@language": "et"
        },
        {
          "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (sh kuivkäimla), puhastamiseks (sh septik) või maapinda immutamiseks",
          "@language": "et"
        },
        {
          "@value": "reovee tekkimise asukohas kasutatav rajatis, mida kasutatakse reovee kogumiseks, puhastamiseks või maapinda immutamiseks; 8) reovee kohtkäitlusrajatis ( edaspidi kohtkäitlusrajatis) – lekkekindel reovee kogumismahuti (sh kuivkäimla kogumismahuti, septik) ja biopuhasti",
          "@language": "et"
        }
      ],
