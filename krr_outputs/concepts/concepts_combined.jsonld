      "estleg:definesConcept": {
        "@id": "estleg:Concept_teaduse_tippkeskuse_teadusnoukoda"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326_nutika_spetsialiseerumise_kasvuvaldkonnad",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "nutika spetsialiseerumise kasvuvaldkonnad",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "TAIE-s väljatoodud fookusvaldkonnad; digilahendused igas eluvaldkonnas; tervisetehnoloogiad ja -teenused; kohalike ressursside väärindamine ning nutikad ja kestlikud energialahendused",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059326_Par_2"
        }
      ],
      "estleg:sourceAct": "Teadusuuringute mõju suurendamine ning teadusasutuste ja kõrgkoolide institutsionaalse teadmussiirde suutlikkuse toetamine (Astra+)",
      "rdfs:label": "nutika spetsialiseerumise kasvuvaldkonnad (teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_nutika_spetsialiseerumise_kasvuvaldkonnad"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326_teadustaristu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadustaristu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ruumid, vahendid ja teenused, sealhulgas teadusaparatuur ja uurimistarbed, seadmed, teaduskollektsioonid, arhiivid, struktureeritud teadusalane informatsioon või nende kompleks ning nendega seotud tingimused, ja teenused, mida teadlased kasutavad uute teadmiste loomiseks, teadmiste ülekandmiseks, vahetamiseks ja/või säilitamiseks oma teadusala uurimistöös",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059326_Par_2"
        }
      ],
      "estleg:sourceAct": "Teadusuuringute mõju suurendamine ning teadusasutuste ja kõrgkoolide institutsionaalse teadmussiirde suutlikkuse toetamine (Astra+)",
      "rdfs:label": "teadustaristu (teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teadustaristu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326_teadmussiire",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadmussiire",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "protsess, mille eesmärk on omandada, koguda ja jagada väljendatavaid ja vaiketeadmisi, sealhulgas oskusi ja pädevust, nii majandusliku kui ka mittemajandusliku tegevuse käigus, näiteks teaduskoostöö, konsulteerimise, litsentsimise, edasiarenduse, avaldamise ning teadlaste ja nimetatud tegevusaladega seotud muude töötajate liikuvuse kaudu; lisaks teaduslikele ja tehnoloogilistele teadmistele hõlmab see muud liiki teadmisi, näiteks teadmisi standardite ja standardeid sisaldavate õigusaktide kasutamise kohta ning tegelike töötingimuste ja organisatsiooniinnovatsiooni meetodite kohta ja immateriaalse vara kindlakstegemise, omandamise, kaitsmise ja kasutamisega seotud teadmiste haldamist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059326_Par_2"
        }
      ],
      "estleg:sourceAct": "Teadusuuringute mõju suurendamine ning teadusasutuste ja kõrgkoolide institutsionaalse teadmussiirde suutlikkuse toetamine (Astra+)",
      "rdfs:label": "teadmussiire (teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teadmussiire"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326_teadushaldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadushaldus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teadmiste kogumine, organiseerimine, levitamine ja tõhus kasutamine teadus- ja arendusasutuse teadusliku arengu soodustamine ja selle juhtimise kvaliteedi parandamine, millega tagatakse edu teaduses ning teadus- ja arendusasutuse aktiivsuse ja efektiivsuse tõstmine paremaks asutuste vaheliseks koostööks teadmussiirde teenuste vahendamisel ja pakkumisel.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059326_Par_2"
        }
      ],
      "estleg:sourceAct": "Teadusuuringute mõju suurendamine ning teadusasutuste ja kõrgkoolide institutsionaalse teadmussiirde suutlikkuse toetamine (Astra+)",
      "rdfs:label": "teadushaldus (teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teadushaldus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tee_seisundinouded_t1030329_rasked_ilmaolud",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rasked ilmaolud",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ilmastikutingimused, mille puhul esineb vähemalt üks järgmistest asjaoludest: katkematu lumesadu, mille jooksul sajab vähemalt 10 cm lund nelja tunni jooksul, lumesadu, mille jooksul sajab vähemalt 5 cm lund nelja tunni jooksul, kui samaaegselt on tugev tuul puhanguti üle 12 m/s ning lumi tekitab ohtlikud tuisuvaalud üle lumekihi kriitilise paksuse, või muu ilmastikutingimustest tingitud olukord, kus kehtestatud seisundinõuete tagamine võib olulisel määral olla raskendatud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030329_Par_17"
        }
      ],
      "estleg:sourceAct": "Tee seisundinõuded",
      "rdfs:label": "rasked ilmaolud (tee_seisundinouded_t1030329)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_rasked_ilmaolud"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tee_seisundinouded_t1030329_lumekihi_kriitiline_paksus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lumekihi kriitiline paksus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lumekihi, sealhulgas kohev lumi, sulalumi, lörts ning soola ja lume segu maksimaalne lubatud paksus sõiduteel sõidujälgede vahel või kergliiklustee pinnal lumesaju või tuisu ajal. Lumekihi kriitilise paksuse lubatavad väärtused on esitatud käesoleva määruse lisades 8 ja 10",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030329_Par_17"
        }
      ],
      "estleg:sourceAct": "Tee seisundinõuded",
      "rdfs:label": "lumekihi kriitiline paksus (tee_seisundinouded_t1030329)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_lumekihi_kriitiline_paksus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tee_seisundinouded_t1030329_jaide",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäide",
        "@language": "et"
      },
      "skos:definition": {
