      },
      "rdfs:label": "taotleja",
      "skos:altLabel": [
        {
          "@value": "Taotleja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "leibkonnaliige, kes on tühjenevas korterelamus asuva korteri omanik ja taotleb asenduskorteri omandamise kompensatsiooni; 9",
          "@language": "et"
        },
        {
          "@value": "12-19 aastane füüsiline isik, kes tegutseb Peipsiääre vallas.",
          "@language": "et"
        },
        {
          "@value": "erakool, mis pakub üldharidust Saue valla elanikuna rahvastikuregistrisse kantud 7-19-aastasele õpilasele; 4",
          "@language": "et"
        },
        {
          "@value": "eralasteasutus, mis pakub vastavat teenust Kastre valla elanikuna rahvastikuregistrisse kantud eelkooliealisele pooleteise kuni seitsmeaastasele lapsele (või kuni kooli õppima asumiseni); 4",
          "@language": "et"
        },
        {
          "@value": "eralastehoid või eralasteaed, kus käivad Keila linna lapsed; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "34",
        "@type": "xsd:integer"
      }
    },
    {
