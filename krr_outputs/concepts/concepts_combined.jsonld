      "skos:definition": "isik, kes on ametiasutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks; RT IV 2024-01-19 19 419012024019 2024-01-22 42 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040989_Par_2"
        }
      ],
      "estleg:sourceAct": "Võru Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (voru_vallavalitsuse_palgajuhend_t1040989)",
