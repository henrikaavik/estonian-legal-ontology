      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_tootaja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saku_vallavalitsuse_palgajuhend_t1011634_Teenistuskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Teenistuskoht",
