      },
      "skos:definition": {
        "@value": "palga igakuine fikseeritud osa teenistuskoha ülesannete ja vastutuse, teenistuskohale esitatavate nõuete ning teenistuja teadmiste, oskuste, kogemuste põhjal või volikogu poolt palgalisele vallavalitsuse liikmele määratud tasu",
        "@language": "et"
      },
