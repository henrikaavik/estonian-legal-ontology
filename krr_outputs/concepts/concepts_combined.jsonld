    {
      "@id": "estleg:Concept_kohtla_jarve_linnavalitsuse_palgajuhend_t1048458_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Kohtla-Järve linnaga ametiasutuse kaudu avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048458_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohtla-Järve Linnavalitsuse palgajuhend",
      "rdfs:label": "ametnik (kohtla_jarve_linnavalitsuse_palgajuhend_t1048458)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohtla_jarve_linnavalitsuse_palgajuhend_t1048458_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Kohtla-Järve linnaga ametiasutuse kaudu eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048458_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohtla-Järve Linnavalitsuse palgajuhend",
      "rdfs:label": "töötaja (kohtla_jarve_linnavalitsuse_palgajuhend_t1048458)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohtla_jarve_linnavalitsuse_palgajuhend_t1048458_ametiisik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametiisik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline isik, kellel on avaliku ülesande täitmiseks ametiseisund sõltumata sellest, kas ta täidab talle pandud ülesandeid alaliselt või ajutiselt, tasu eest või tasuta, teenistuses olles või vabakutselisena või lepingu, nimetamise või valimise alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048458_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohtla-Järve Linnavalitsuse palgajuhend",
      "rdfs:label": "ametiisik (kohtla_jarve_linnavalitsuse_palgajuhend_t1048458)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametiisik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohtla_jarve_linnavalitsuse_palgajuhend_t1048458_praktikant",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "praktikant",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kellega on sõlmitud vastava sisuline leping, et rakendada ametiasutuses kindlal perioodi jooksul õppekava raames rakendatuid teadmisi ja oskusi vastavalt õppeasutuse või muu asutuse poolsele praktikajuhendile",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048458_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohtla-Järve Linnavalitsuse palgajuhend",
      "rdfs:label": "praktikant (kohtla_jarve_linnavalitsuse_palgajuhend_t1048458)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_praktikant"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohtla_jarve_linnavalitsuse_palgajuhend_t1048458_teenistuskoht",
      "@type": [
        "owl:NamedIndividual",
