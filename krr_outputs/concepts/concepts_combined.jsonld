    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_andmevarundus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "andmevarundus",
      "skos:definition": "teatud ajahetkel varukoopia loomine varundamisele kuuluvatest andmetest, mis salvestatakse mõnele lisaandmekandjale. Andmevarunduse liigid on: a) täielik andmevarundus - varukoopia loomine kõigist varundamisele kuuluvatest andmetest; b) diferentseeritud andmevarundus – varukoopia tegemine ainult sellistest failidest, mis on võrreldes viimase täieliku andmevarundusega muutunud; c) inkrementaalne andmevarundus – vastupidiselt täielikule andmevarundusele varukoopia tegemine ainult sellistest failidest, mis on võrreldes viimase andmevarundusega muutunud. 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna infoturbepoliitika",
      "rdfs:label": "andmevarundus (maardu_linna_infoturbepoliitika_t1049639)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_andmevarundus"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_andmevarundus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_infosusteem",
