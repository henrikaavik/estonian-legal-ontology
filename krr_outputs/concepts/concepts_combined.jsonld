      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_kohtkaitlus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kuusalu_valla_reovee_kohtkaitlemise_ja_araveo_eeskiri_t1052145_reovee_kohtkaitlussusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee kohtkäitlussüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee ja käimlajäätmete kogumiseks, puhastamiseks ja/või maapinda immutamiseks, sh reovee ajutiseks kogumiseks (nt kogumismahuti, kuivkäimla) või reovee puhastamiseks ja nõuetekohaselt puhastatult heitveena suublasse juhtimiseks (nt omapuhasti, sh isikliku majapidamise reoveepuhasti)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052145_Par_2"
        }
      ],
      "estleg:sourceAct": "Kuusalu valla reovee kohtkäitlemise ja äraveo eeskiri",
