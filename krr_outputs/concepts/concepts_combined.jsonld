        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "erakool",
      "skos:definition": [
        {
          "@value": "eraõigusliku juriidilise isiku (edaspidi erakooli pidaja) asutus, mille omanike või asutajate hulka ei kuulu ükski kohalik omavalitsus ega selle asutus, mis tegutseb põhikooli- ja gümnaasiumiseaduse ning erakooliseaduse alusel, omab kehtivat tegevusluba ning võimaldab üldhariduse omandamist riiklikule õppekavale vastava õppekava alusel",
          "@language": "et"
        },
        {
          "@value": "juriidiliste isikute pidamisel olev põhikool, mis ei ole valla või linna valitseva või olulise mõju all",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
