      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "registreerimine",
      "skos:definition": [
        {
          "@value": "toiming, millega Transpordiamet kannab Eestis kasutusele võetava ja nõuetele vastava registrisse kandmata sõiduki ja sellega seotud isikute andmed registrisse; 7",
          "@language": "et"
        },
        {
          "@value": "Eestis esmakordselt kasutusele võetava, registrisse kandmata veesõiduki ja sellega seotud isikute andmete kandmine registrisse; 7",
          "@language": "et"
        },
        {
          "@value": "Häädemeeste valla haldusterritooriumil asuvate lemmikloomade registrisse kandmine; 5",
          "@language": "et"
        },
        {
          "@value": "Maardu linna haldusterritooriumil asuvate lemmikloomade registrisse kandmine; 11",
          "@language": "et"
        },
        {
          "@value": "Põltsamaa valla haldusterritooriumil asuvate lemmikloomade registrisse kandmine; 5",
          "@language": "et"
        }
      ]
    },
    {
