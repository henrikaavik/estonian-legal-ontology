      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil_t1059033_e_kaart_ehk_Uhiskaart",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "e-kaart ehk Ühiskaart",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "elektrooniline kontaktivaba kaart, mis on isikustatud või isikustamata tasuline andmekandja sõiduõiguse tõendamiseks. E pileti süsteemis võib kasutada ka e pileti süsteemiga ühildatud muud kontaktivaba kaarti (näiteks õpilaspilet), mis vastab raadiosageduslikku tuvastamist ehk RFID-tehnoloogiat toetavale standardile, või lähikontaktiga andmesidekiibiga ehk NFC-mobiiltelefoniga. Isikustatud e kaart kehtib ainult koos isikut tõendava dokumendiga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059033_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi valla bussiliinidel ja Leppneeme-Kelnase laevaliinil sõidu eest tasumise kord ja sõidupiletite hinnad",
      "rdfs:label": "e-kaart ehk Ühiskaart (viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil__t1059033)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_e_kaart_ehk_uhiskaart"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil_t1059033_e_pileti_susteem",
      "@type": [
        "owl:NamedIndividual",
