    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_rohetehnoloogia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "rohetehnoloogia",
      "skos:definition": "kestlik tehnoloogia, mis väldib või vähendab kogu elutsükli ulatuses inimtegevuse mõju keskkonnale ja kliimale. Rohetehnoloogia kasutab maksimaalselt ära taastuvaid energiaallikaid ja materjale, tagades minimaalse ressursside, sh energia kasutuse. Rohetehnoloogia määratluses ei piirduta vaid kasutusfaasiga, vaid arvestatakse toote või teenuse kogu elutsükli ulatust (toorme kavandamine ja tootmine, toote tootmine, levitamine ja pakendamine, korduskasutus, lõplik kasutusest kõrvaldamine, ümbertöötlus); 14",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
      "rdfs:label": "rohetehnoloogia (rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_rohetehnoloogia"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_rohetehnoloogia"
        }
      ]
    },
    {
