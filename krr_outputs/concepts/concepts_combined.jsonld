        }
      ],
      "estleg:definitionCount": {
        "@value": "22",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hoolduslõikus",
      "skos:definition": [
        {
          "@value": "puu okste lõikamine võra olulise kujundamise teel, mille käigus säilitatakse puu elujõulisus",
          "@language": "et"
        },
        {
          "@value": "puu võra hooldamiseks ja kujundamiseks ette võetav lõikus, mille käigus puud ei likvideerita",
          "@language": "et"
        },
        {
          "@value": "puu hooldamiseks ja võra kujundamiseks teostatav lõikus, mille käigus puud ei likvideerita, vaid vähendatakse puu oksi ja/või harusid rohkem kui 15 % võrra",
          "@language": "et"
        },
        {
          "@value": "puu okste lõikamine võra olulise kujundamise teel, mille käigus säilitatakse puu elujõulisus. Korraga ei tohi eemaldada enam kui 30% puu oksastikust",
          "@language": "et"
        },
        {
          "@value": "puu okste lõikamine võra olulise kujundamise teel, mille käigus säilitatakse puu liigi- (sordi-) omane võrakuju ning elujõulisus",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "13",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
