    {
      "@id": "estleg:Concept_vandeaudiitori_voi_tunnustatud_siseaudiitori_juhendamisel_pr_t1001209_praktikant",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "praktikant",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes käesolevas määruses sätestatud korras omandab vandeaudiitori või tunnustatud siseaudiitori juhendamisel praktiseerides kutsetegevuse valdkondades teadmisi, oskusi ja vilumusi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1001209_Par_2"
        }
      ],
      "estleg:sourceAct": "Vandeaudiitori või tunnustatud siseaudiitori juhendamisel praktiseerimise ning kutsealal tegutsemise tõendamise kord",
      "rdfs:label": "praktikant (vandeaudiitori_voi_tunnustatud_siseaudiitori_juhendamisel_pr_t1001209)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_praktikant"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vandeaudiitori_voi_tunnustatud_siseaudiitori_juhendamisel_pr_t1001209_juhendaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "juhendaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vandeaudiitor või tunnustatud siseaudiitor, kelle juhendamisel praktikant harjutab ning rakendab teadmisi praktikas, et omandada oskusi ja vilumusi tasemel, mis võimaldaks iseseisvalt kutsetegevusega tegeleda",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1001209_Par_2"
        }
      ],
      "estleg:sourceAct": "Vandeaudiitori või tunnustatud siseaudiitori juhendamisel praktiseerimise ning kutsealal tegutsemise tõendamise kord",
      "rdfs:label": "juhendaja (vandeaudiitori_voi_tunnustatud_siseaudiitori_juhendamisel_pr_t1001209)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_juhendaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vandeaudiitori_voi_tunnustatud_siseaudiitori_juhendamisel_pr_t1001209_tunnustatud_siseaudiitor",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tunnustatud siseaudiitor",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "atesteeritud siseaudiitor või avaliku sektori siseaudiitor „Audiitortegevuse seaduse“ §-de 5 ja 6 tähenduses või isik, kellel on Rahvusvahelise Siseaudiitorite Instituudi väljastatud CIA® või CGAP® sertifikaat",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1001209_Par_2"
        }
      ],
      "estleg:sourceAct": "Vandeaudiitori või tunnustatud siseaudiitori juhendamisel praktiseerimise ning kutsealal tegutsemise tõendamise kord",
      "rdfs:label": "tunnustatud siseaudiitor (vandeaudiitori_voi_tunnustatud_siseaudiitori_juhendamisel_pr_t1001209)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tunnustatud_siseaudiitor"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vandeaudiitori_voi_tunnustatud_siseaudiitori_juhendamisel_pr_t1001209_praktika_korraldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "praktika korraldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Euroopa Majanduspiirkonna lepinguriigi antud tegevusloaga audiitorettevõtja, kes tegeleb vandeaudiitori kutsetegevusalaste ülesannete täitmisega, äriühing või avaliku sektori üksus, kus tegeletakse siseaudiitori kutsetegevusalaste ülesannete täitmisega, või tunnustatud siseaudiitor, kes tegeleb siseaudiitori kutsetegevusalaste ülesannete täitmisega.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1001209_Par_2"
        }
      ],
      "estleg:sourceAct": "Vandeaudiitori või tunnustatud siseaudiitori juhendamisel praktiseerimise ning kutsealal tegutsemise tõendamise kord",
      "rdfs:label": "praktika korraldaja (vandeaudiitori_voi_tunnustatud_siseaudiitori_juhendamisel_pr_t1001209)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_praktika_korraldaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vedelkutuste_kohta_esitatavad_keskkonnanouded_biokutuste_ved_t1037161_laeva_diislikutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "laeva diislikütus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "laevakütus, mis vastab käesoleva määruse lisas 4 esitatud DMB kvaliteediklassi määratlusele, väävlisisalduse piirmäärad välja arvatud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1037161_Par_2"
        }
      ],
      "estleg:sourceAct": "Vedelkütuste kohta esitatavad keskkonnanõuded, biokütuste, vedelate biokütuste ja biomasskütuste säästlikkuse kriteeriumid, vedelkütuste keskkonnanõuetele vastavuse seire ja aruandmise kord ning biokütuste, vedelate biokütuste ja biomasskütuste kasutamisest tuleneva kasvuhoonegaaside heitkoguste vähenemise määramise metoodika",
      "rdfs:label": "laeva diislikütus (vedelkutuste_kohta_esitatavad_keskkonnanouded_biokutuste_ved_t1037161)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_laeva_diislikutus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vedelkutuste_kohta_esitatavad_keskkonnanouded_biokutuste_ved_t1037161_laeva_kerge_kutteoli",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "laeva kerge kütteõli",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "laevakütus, mis vastab käesoleva määruse lisas 4 esitatud DMX, DMA ja DMZ kvaliteediklassi määratlusele, väävlisisalduse piirmäärad välja arvatud. Tarbimisse lubamine on aktsiisikauba tarbimisse lubamine alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduse tähenduses. Turustamine käesoleva määruse tähenduses on laeva pardal põletamiseks ette nähtud laevakütuse kolmandatele isikutele tasu eest või tasuta tarnimine või kättesaadavaks tegemine Euroopa Liidu liikmesriikide jurisdiktsiooni alla kuuluval alal. Turustamiseks ei loeta laevakütuse tarnimist või kättesaadavaks tegemist laeva tankides kütuse väljaveo eesmärgil Euroopa Liidust. Käitlemine on vedelkütuse käitlemine vedelkütuse seaduse mõistes. Tegelik väärtus käesoleva määruse tähenduses on Euroopa Parlamendi ja nõukogu direktiivi (EL) 2018/2001 taastuvatest energiaallikatest toodetud energia kasutamise edendamise kohta (ELT L 328, 21.12.2018, lk 82–209) V lisa osas C või VI lisa osas B sätestatud metoodika kohaselt arvutatud kasvuhoonegaaside heitkoguste vähenemine konkreetse biokütuse, vedela biokütuse või biomasskütuse tootmisprotsessi mõnes etapis või kõikides etappides.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1037161_Par_2"
        }
      ],
      "estleg:sourceAct": "Vedelkütuste kohta esitatavad keskkonnanõuded, biokütuste, vedelate biokütuste ja biomasskütuste säästlikkuse kriteeriumid, vedelkütuste keskkonnanõuetele vastavuse seire ja aruandmise kord ning biokütuste, vedelate biokütuste ja biomasskütuste kasutamisest tuleneva kasvuhoonegaaside heitkoguste vähenemise määramise metoodika",
