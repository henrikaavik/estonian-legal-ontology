      "estleg:definesConcept": {
        "@id": "estleg:Concept_valireklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1051880_tegevuskoha_tahistus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tegevuskoha tähistus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidilise isiku ja asutuse tegevuskoha tähistus selle nime, liigi, toodete või teenuste ja nende müügi osutamise aja kohta antava teabe, isiku nime, kaubamärgi ja/või domeeninimega. Tegevuskoha tähistus paikneb ehitisel, kus tegevuskoht asub, või selle sissepääsu juures (tegevuskoha tähistus ei ole maksustatud) v.a harkjalg",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051880_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri ja reklaamimaksu kehtestamise kord",
      "rdfs:label": "tegevuskoha tähistus (valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1051880)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tegevuskoha_tahistus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
