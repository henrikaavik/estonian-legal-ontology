        }
      ]
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihangete_tugiteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "riigihangete tugiteenus",
      "skos:definition": "keskse hankija osutatav riigihangete korraldamise teenus, sealhulgas linna asutuste nõustamine riigihangetega seotud küsimustes, riigihanke ettevalmistamine ja toimingute tegemine linna asutuse nimel; 19",
