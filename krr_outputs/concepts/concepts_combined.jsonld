    },
    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_turvameetmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "turvameetmed",
      "skos:definition": "organisatoorsed toimingud ja vahendid, tehnilised protsessid ja tehniliste vahendite rakendamine andmete ja infosüsteemide turvalisuse saavutamiseks ja säilitamiseks; 19",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
