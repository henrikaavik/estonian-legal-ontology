      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Juurdepääsutee on majapidamist avaliku teega või avalikku kasutusse antud erateega ühendav kinnistusisene ja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_hajaasustuse_programm_t1042182_Juurdepaasutee_on_majapidamist_avaliku_teega_voi_avalikku_kasutusse_antud_eratee"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Juurdepääsutee on majapidamist avaliku teega või avalikku kasutusse antud erateega ühendav kinnistusisene ja",
      "skos:definition": [
        {
          "@value": "väline eratee või avalikkusele ligi pääsetav eratee. Kui majapidamist avaliku teega või avalikku kasutusse antud erateega ühendava tee osaks on metsatee ehitusseadustiku § 93 lõike 1 mõistes, katkeb juurdepääsutee metsatee alguspunktis ja jätkub metsatee lõpp-punktist kuni avaliku tee või avalikku kasutusse antud erateeni jõudmiseni. Metsateed ei loeta käesoleva määruse mõistes juurdepääsutee osaks. 7 (",
          "@language": "et"
        }
      ]
    },
