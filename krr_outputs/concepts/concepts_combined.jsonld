        {
          "@value": "ehitise sügavus on ehitise suurim vertikaalmõõde ehitist vahetult ümbritsevast maapinnast või katendist ehitise kõige alumise maa-aluse korruse viimistletud põranda kõrgusele, võtmata arvesse kohalikke väiksemaid süvendeid ja kõrgendusi; 7",
          "@language": "et"
        }
      ]
    },
    {
