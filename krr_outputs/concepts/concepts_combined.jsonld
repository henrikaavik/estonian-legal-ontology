    {
      "@id": "estleg:Concept_uksikvanem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "üksikvanem",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toimetulekut_soodustavate_sotsiaaltoetuste_maksmise_kord_t1051749_uksikvanem"
        },
        {
          "@id": "estleg:Concept_osalustasu_kehtestamine_keila_linna_lasteaedades_t1061621_uksikvanem"
        },
        {
          "@id": "estleg:Concept_rongisoidul_soodustuse_saamise_kord_t1036572_uksikvanem"
