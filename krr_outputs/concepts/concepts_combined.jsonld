        "@value": "tugiisikuteenus lapsega perele",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sotsiaalteenus, mis seisneb lapse või tema seadusliku esindaja jõustamises ja juhendamises tema kohustuste täitmisel, õiguste teostamisel või toimetulekul raske olukorraga igapäevases elukeskkonnas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043518_Par_3"
        }
      ],
