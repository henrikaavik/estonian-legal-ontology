      }
    },
    {
      "@id": "estleg:Concept_setomaa_valla_raamatupidamise_sise_eeskiri_t1052118_majandustehingute_kirjendaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "majandustehingute kirjendaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötaja, kes lähtudes finantsaruandluse standardist kirjendab valla majandustehingud raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on majandustehingute kirjendajaks finantsosakonna töötajad.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052118_Par_2"
        }
      ],
