        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tööline",
      "skos:definition": [
        {
          "@value": "ametiasutusega eraõiguslikus töösuhtes olev teenindustöötaja, oskustööline, lihttööline. Tööline töötab töölepingu alusel ning töölise teenistuskohta nimetatakse töökohaks",
          "@language": "et"
        },
        {
          "@value": "töötaja, kes täidab lihtsaid ja rutiinseid ülesandeid, mis võivad eeldada füüsilist pingutust ja/või käsitööriistade kasutamist (töökoha tööväärtuspunktid vahemikus 74–84)",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_tooealine"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
