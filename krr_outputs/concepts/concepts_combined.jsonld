        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_biomassist_elektrienergia_koostootmise_juhis_t345646_kadu_seadmetes",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kadu seadmetes",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "elektrienergia tootmisprotsessis tekkiv energiakadu, eelkõige generaatoris, torustikes, soojusvahetis ning seoses turbiini välisjahtumisega. Kadu seadmetes ei sisalda katla soojuskadu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_345646_Par_2"
        }
      ],
      "estleg:sourceAct": "Biomassist elektrienergia koostootmise juhis",
