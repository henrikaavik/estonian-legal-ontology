          "@id": "estleg:Concept_saaremaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1060956_Saaremaa_valla_uhisveevargi_ja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Saaremaa valla ühisveevärgi ja",
      "skos:definition": [
        {
          "@value": "kanalisatsiooni kasutamise eeskiri (edaspidi eeskiri ) sätestab veevarustuse ja reovee ning sademe- ja drenaaživee või muu pinnase- ja pinnavee ärajuhtimise teenuste osutamise nõuded ja tingimused ning teenuste osutamise ja kasutamise korra Saaremaa vallas. 2 (",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "saastamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_merestrateegia_sisu_ja_koostamise_nouded_t1050259_saastamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "saastamine",
      "skos:definition": [
        {
          "@value": "inimtegevuse tagajärjel ainete või energia, sealhulgas inimtekkelise veealuse müra otsene või kaudne merekeskkonda juhtimine, mille tagajärjeks on või võib olla kahjulik mõju elustikule ja mereökosüsteemidele, sealhulgas bioloogilise mitmekesisuse vähenemine, ohud inimeste tervisele, merendusalase tegevuse, sealhulgas kalapüügi, turismi ja huvitegevuse ning muude mere seaduslike kasutusviiside häiritus, merevee kvaliteedi halvenemine selle kasutamise seisukohast ja hüvede vähenemine, või merekaupade ja -teenuste jätkusuutliku kasutamise halvenemine üldiselt; 4",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_saasteaine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saasteaine",
