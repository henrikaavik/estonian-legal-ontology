    {
      "@id": "estleg:Concept_viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil_t1059033_soiduoigust_toendav_dokument",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sõiduõigust tõendav dokument",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõidupilet (paberpilet või e-pilet) või sõidusoodustuse õigust tõendav dokument. E-pileti olemasolu tõendatakse valideeritud Ühiskaardi või muu andmekandja abil. Sõidupileti tooted on: üksikpilet, perioodipilet (kuukaart)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059033_Par_2"
        }
      ],
