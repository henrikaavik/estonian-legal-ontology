          "@language": "et"
        },
        {
          "@value": "korraldab varjupaiga pidamist, hulkuvate loomade püüdmist, omaniku kindlaks tegemist, varjupaika toimetamist ja uue omaniku otsimist ning loomade hukkamist.",
          "@language": "et"
