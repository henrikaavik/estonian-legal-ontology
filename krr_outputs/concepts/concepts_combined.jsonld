        {
          "@id": "estleg:Concept_varjupaigateenuse_ja_turvakoduteenuse_maaramine_ja_korraldam_t1051482_valtimatu_sotsiaalabi"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "vältimatu sotsiaalabi",
      "skos:definition": [
        {
          "@value": "abi elatusvahendite kaotuse või puudumise tõttu sotsiaalselt abitusse olukorda sattunud isikule, mis tagab vähemalt toidu ja ajutise ööbimisvõimaluse",
          "@language": "et"
        },
        {
          "@value": "inimesele (sh ajutiselt Eestis viibivale välismaalasele) hädavajaliku toidu, riietuse, ajutise majutuse, sotsiaalnõustamise, transpordi ja muu põhjendatud abi tagamine, kui inimene on elatusvahendite kaotuse või puudumise või eluaseme ootamatult kasutuskõlbmatuks muutumise tõttu sotsiaalselt abitus olukorras; 2022-12-15",
          "@language": "et"
        },
        {
          "@value": "piisavate elatusvahenditeta isiku olukorrale vastavad hädavajalikud sotsiaalhoolekandelised abinõud, mis tagavad vähemalt toidu, riietuse, ravimid ja ajutise peavarju",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
