          "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_uhispublikatsioon"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ühispublikatsioon",
      "skos:definition": [
        {
          "@value": "eelretsenseeritud teaduspublikatsioon, mille autoriteks on vähemalt kahe erineva asutuse teadus- ja arendustöötajad; ühispublikatsioonid käesoleva määruse mõistes on ühispublikatsioonid teaduse tippkeskusesse kuuluvate asutuste vahel, ühispublikatsioonid Eesti era- või avaliku sektori asutustega ja ühispublikatsioonid välisriikide asutustega",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_uhissoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühissõiduk",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_reklaamimaksu_kehtestamine_t1037107_uhissoiduk"
        },
        {
          "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1051880_uhissoiduk"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
