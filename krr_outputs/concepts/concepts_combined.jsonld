      "skos:definition": [
        {
          "@value": "kasutusele võtmata, vabanevate ja muude meetmesse suunatud täiendavate vahendite jagamise voor, mis järgneb teisele taotlusvoorule ning mille käigus toimub reservnimekirja koostamine ja vahendite jagamine",
          "@language": "et"
        }
      ],
