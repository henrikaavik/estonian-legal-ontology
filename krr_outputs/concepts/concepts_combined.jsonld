      },
      "skos:definition": {
        "@value": "kaevetöö, mille tegemise vajadus tekib ootamatult ja on vajalik tehnovõrgu avarii likvideerimiseks juhul, kui kaevetöö alustamisega viivitamine põhjustab olulise materiaalse kahju, takistab vastava elutähtsa teenuse osutamist tarbijatele või ohustab inimesi, ehitisi, keskkonda. Avariikaevetööna on põhjendatud maagaasi-, ühisvee ja -kanalisatsiooni- ja soojatrasside lekete likvideerimine, elektri ja sideliinide avariide likvideerimine; 3) kaevetöö tegija (edaspidi kaevaja) - füüsiline või juriidiline isik, kes teostab kaevetööd kaevetöö loa alusel või kes teostab avariikaevetööd tehnovõrgu valdaja poolt kinnitatud avariikaevetöö akti alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1005804_Par_2"
        }
      ],
      "estleg:sourceAct": "Mikitamäe valla kaevetööde eeskiri",
      "rdfs:label": "avariikaevetöö (mikitamae_valla_kaevetoode_eeskiri_t1005804)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avariikaevetoo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
