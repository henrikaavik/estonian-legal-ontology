        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huviharidus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pikaajaline süsteemne juhendatud tegelemine huvikoolis vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal. Huviharidust omandatakse õppekava alusel huvikoolis.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056731_Par_2"
        }
      ],
