      ],
      "skos:prefLabel": {
        "@value": "arhivaal",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "dokument, millele avalik arhiiv on hindamise tulemusena andnud arhiiviväärtuse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060067_Par_2"
        }
      ],
