          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_rohevesiniku_kasutuselevo_t1052247_abikolblikkuse_periood"
        }
      ],
      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "abikõlblikkuse periood",
      "skos:definition": [
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning abikõlblik kulu tekib",
          "@language": "et"
        },
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning projekti tegevuste elluviimiseks abikõlblikud kulud tekivad",
          "@language": "et"
        },
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning projekti tegevuste elluviimiseks abikõlblikud kulud tekivad ja makse on toetuse saajale teostatud",
          "@language": "et"
        },
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning projekti tegevuste elluviimiseks vajalikud kulud tekivad ja tasutakse",
          "@language": "et"
        },
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning projekti tegevuste elluviimiseks vajalikud kulud tekivad ja tasutakse lõppsaaja poolt; 2) „ei kahjusta oluliselt” põhimõte – põhimõte, mille kohaselt ei tekitata Euroopa Parlamendi ja nõukogu määruse (EL) 2020/852, millega kehtestatakse kestlike investeeringute hõlbustamise raamistik ja muudetakse määrust (EL) 2019/2088 (ELT L 198, 22.06.2020, lk 13–43), artiklis 17 nimetatud olulist kahju ühelegi artiklis 9 sätestatud keskkonnaeesmärgile",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
