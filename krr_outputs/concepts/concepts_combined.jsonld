        "@value": "23",
        "@type": "xsd:integer"
      },
      "rdfs:label": "puhastusala",
      "skos:definition": [
        {
          "@value": "tiheasustusega alal kinnistuga külgnev haljasala või muu ala kuni kõnni- või sõiduteeni",
          "@language": "et"
        },
        {
          "@value": "füüsilise või juriidilise isiku omandis või valduses olev kinnistu või muu territoorium ning sellega vahetult piirnev üldkasutatav territoorium, millele laieneb käesolevast eeskirjast tulenev korrashoiu kohustus. Puhastusala ulatub risti suunas krundi piirist või ehitisest sõidutee katte servani (kõnnitee puudumisel talvisel ajal üks meeter sõiduteele). Ehitiste vahelise maa-ala puhastusala piiriks on nendevaheline mõtteline telgjoon",
          "@language": "et"
        },
        {
          "@value": "füüsilise või juriidilise isiku omandis või valduses olev kinnistu või muu territoorium ning sellega vahetult piirnev üldkasutatav territoorium, millele laieneb käesolevast eeskirjast tulenev korrashoiukohustus. Puhastusala ulatub ristisuunas krundi piirist või ehitisest sõidutee katte servani (kõnnitee puudumisel talvisel ajal üks meeter sõiduteele). Ehitistevahelise maa-ala puhastusala piiriks on nendevaheline mõtteline telgjoon",
          "@language": "et"
        },
        {
          "@value": "kinnisasja piiri ja sõidutee teekatte serva vahele jääv ala juhul, kui nimetatud ala laius ei ületa 10 meetrit",
          "@language": "et"
        },
        {
          "@value": "kinnistu ja sellega külgneva tee vahel olev ala",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "22",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
