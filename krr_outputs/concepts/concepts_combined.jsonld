    {
      "@id": "estleg:Concept_merestrateegia_sisu_ja_koostamise_nouded_t1050259_saastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "saastamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "inimtegevuse tagajärjel ainete või energia, sealhulgas inimtekkelise veealuse müra otsene või kaudne merekeskkonda juhtimine, mille tagajärjeks on või võib olla kahjulik mõju elustikule ja mereökosüsteemidele, sealhulgas bioloogilise mitmekesisuse vähenemine, ohud inimeste tervisele, merendusalase tegevuse, sealhulgas kalapüügi, turismi ja huvitegevuse ning muude mere seaduslike kasutusviiside häiritus, merevee kvaliteedi halvenemine selle kasutamise seisukohast ja hüvede vähenemine, või merekaupade ja -teenuste jätkusuutliku kasutamise halvenemine üldiselt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050259_Par_3"
        }
      ],
      "estleg:sourceAct": "Merestrateegia sisu ja koostamise nõuded",
      "rdfs:label": "saastamine (merestrateegia_sisu_ja_koostamise_nouded_t1050259)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_saastamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
