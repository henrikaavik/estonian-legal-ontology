        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "CE-märgistus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tootja või importija poolt antud garantii, et toode vastab kõikidele olulistele töötervishoiu, töö- ja keskkonnaohutuse nõuetele",
        "@language": "et"
      },
