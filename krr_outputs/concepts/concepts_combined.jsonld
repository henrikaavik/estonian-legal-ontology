          "@id": "estleg:Concept_noorte_omaalgatusprojektide_toetamise_kord_t1042680_noorteuhing"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "noorteühing",
      "skos:definition": [
        {
          "@value": "mittetulundusühing või seltsing, mis asub Rakvere linnas ja mille liikmetest vähemalt kaks kolmandikku on noored ja mille põhitegevuseks on noorsootöö korraldamine; 3) taotleja- noorteühing või 18-26aastane füüsiline isik, kelle elukohana rahvastikuregistris on märgitud Rakvere linn.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
