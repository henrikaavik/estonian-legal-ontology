    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048274_filter",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "filter",
      "skos:definition": "ja imbsüsteem – koredast pinnasest (kruus, kergkruus või killustik) ja reovee jaotussüsteemist ehitatud tehislooduslik süsteem reovee bioloogiliseks puhastamiseks bakterite abil ja keskkonda (suublasse) juhtimiseks. Filter- või imbsüsteemi ette paigaldatakse septik, kus toimub reovee mehhaaniline puhastus või omapuhasti, kus toimub reovee bioloogiline puhastamine; 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048274_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
