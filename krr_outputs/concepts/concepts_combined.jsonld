    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamine_t1059488_huviharidus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huviharidus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pikaajaline süsteemne juhendatud tegelemine vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal huvikoolis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059488_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamine",
      "rdfs:label": "huviharidus (huvihariduse_ja_huvitegevuse_toetamine_t1059488)",
