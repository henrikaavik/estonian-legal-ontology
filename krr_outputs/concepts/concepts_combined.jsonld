        "@type": "xsd:integer"
      },
      "rdfs:label": "purgimissõiduk",
      "skos:definition": [
        {
          "@value": "mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi/fekaal purgimiskohta.",
          "@language": "et"
        },
        {
          "@value": "mahutiga auto, mille abil tühjendatakse reoveekogumismahutit ning veetakse reovesi purgimiskohta; 7",
          "@language": "et"
        },
        {
          "@value": "(edaspidi sõiduk) – mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi/fekaal purgimiskohta; 11",
          "@language": "et"
        },
        {
          "@value": "lekkekindla mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi purgimissõlme. RT IV 2023-12-20 10 420122023010 2023-12-23 6",
          "@language": "et"
        },
        {
          "@value": "mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi/fekaal purgimiskohta; 11",
          "@language": "et"
        }
      ],
