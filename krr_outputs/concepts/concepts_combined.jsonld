    {
      "@id": "estleg:Concept_alutaguse_valla_raamatupidamise_sise_eeskiri_t1049736_valla_valitsev_moju",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "valla valitsev mõju",
      "skos:definition": "Raamatupidamise Toimkonna juhendi kohaselt võime valla osalusega tütarettevõtte üle otsustamine. Kontrolli olemasolu eeldatakse juhul, kui valla omanduses on otse või tütarettevõtete kaudu rohkem kui 50% tütarettevõtte hääleõigusest; 12",
