      "skos:definition": [
        {
          "@value": "hooldajale igakuiselt makstav rahaline toetus",
          "@language": "et"
        },
        {
          "@value": "linnaeelarvest makstav igakuine rahaline toetus täisealise isiku hooldajale.",
          "@language": "et"
        },
        {
          "@value": "Lääne-Nigula valla eelarvest hooldajale igakuiselt makstav rahaline toetus",
          "@language": "et"
        },
        {
          "@value": "puudega ja/või suure hooldusvajadusega isiku hooldajale igakuiselt makstav rahaline toetus",
          "@language": "et"
        },
        {
          "@value": "puudega või hooldusvajadusega isiku hooldajale, puudega lapse ühele vanemale, eestkostjale või perekonnas hooldamise lepingu alusel hooldajale antav rahaline toetus osaliseks hooldusega seotud kulude hüvitamiseks",
          "@language": "et"
        }
      ],
