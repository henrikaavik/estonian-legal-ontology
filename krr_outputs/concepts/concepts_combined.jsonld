    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_korterelamu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "korterelamu",
      "skos:definition": "enne 2000. aastat kasutusse võetud elamu, milles on kolm või enam korteriomandit, kui § 6 lõikest 3 ei tulene teisiti; 7",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
