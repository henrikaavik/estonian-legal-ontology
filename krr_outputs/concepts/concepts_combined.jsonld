    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "ametnik",
      "skos:definition": "isik, kes on asutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
