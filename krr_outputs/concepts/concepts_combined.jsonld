      "rdfs:label": "korraline ülevaatus",
      "skos:definition": [
        {
          "@value": "perioodiline sõiduki, masina või maastikusõiduki ülevaatus, mis toimub käesoleva määrusega ettenähtud mahus ja sagedusega",
          "@language": "et"
        },
        {
          "@value": "tähtajaline sõiduki ülevaatus majandus- ja kommunikatsiooniministri 18. juuli 2011. a määrusega nr 77 „Mootorsõiduki ja selle haagise tehnonõuetele vastavuse kontrollimise tingimused ja kord” ettenähtud mahus ja sagedusega.",
          "@language": "et"
        }
      ],
