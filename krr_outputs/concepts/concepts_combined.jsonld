      "skos:definition": [
        {
          "@value": "omapuhasti, mille kaudu majapidamise reovesi immutatakse pinnasesse; 2",
          "@language": "et"
        },
        {
          "@value": "omapuhasti osa, kus ehitatud pinnasefiltersüsteemis toimub reovee bioloogiline puhastamine pinnaseosakestele tekkivas biokiles elavate mikroorganismide poolt; 4",
          "@language": "et"
        },
        {
          "@value": "omapuhasti osa, mille kaudu heitvesi immutatakse hajutatult pinnasesse; 4",
          "@language": "et"
        },
