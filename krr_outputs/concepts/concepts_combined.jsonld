      ]
    },
    {
      "@id": "estleg:Concept_detailplaneeringukohaste_ja_planeeringulahenduse_elluviimise_t1055786_detailplaneering",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "detailplaneering",
      "skos:definition": "menetletav detailplaneering, kehtestatud detailplaneering, planeerimisseaduse (edaspidi PlanS) § 125 lg-s 5 nimetatud projekteerimistingimused ja ehitusseadustiku (edaspidi EhS) §-s 27 nimetatud projekteerimistingimused; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055786_Par_2"
        }
