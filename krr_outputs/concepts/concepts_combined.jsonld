        "@value": "üüriturult eluruumi leidmise toetamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_saue_valla_omandis_olevate_eluruumide_kasutusse_andmise_uuri_t1057044_uuriturult_eluruumi_leidmise_toetamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "üüriturult eluruumi leidmise toetamine",
      "skos:definition": [
        {
          "@value": "sotsiaalmajanduslikust olukorrast tulenevalt madala võimekusega inimeste nõustamine ja toetamine tema perekonna vajadustele vastava eluruumi leidmisel üüriturult ja üürilepinguni jõudmisel; 6",
          "@language": "et"
        }
      ]
    },
    {
