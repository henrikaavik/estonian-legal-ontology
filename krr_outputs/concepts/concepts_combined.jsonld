    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_meetmes_ettevotete_ressursitohusu_t1043913_vaike",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "väike",
      "skos:definition": "ja keskmise suurusega ettevõtja ( VKE ) on ettevõtja konkurentsiseaduse § 2 mõistes, kes vastab Euroopa Komisjoni määruse (EÜ) nr 651/2014 asutamislepingu artiklite 107 ja 108 kohaldamise kohta, millega teatavat liiki abi tunnistatakse ühisturuga kokkusobivaks (ELT L 187 26.06.2014, muudetud komisjoni määrusega (EL) 2017/1084 (ELT L 156, 20.06.2017, lk 1–",
