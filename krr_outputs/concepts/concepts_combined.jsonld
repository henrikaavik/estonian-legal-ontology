      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "liitumisleping",
      "skos:definition": [
        {
          "@value": "kinnistu omaniku või valdajaga sõlmitav leping liitumiseks ühisveevärgi ja –kanalisatsiooniga",
          "@language": "et"
        },
        {
          "@value": "kinnistu omaniku, hoonestusõiguse alusel maakasutaja või kinnistu valdajaga sõlmitav leping liitumiseks ühisveevärgi ja -kanalisatsiooniga",
          "@language": "et"
        },
        {
          "@value": "kirjalikku taasesitamist võimaldavas vormis sõlmitud leping tarbimiskoha veevärgi ja kanalisatsiooni ühendamiseks ühisveevärgi ja -kanalisatsiooniga",
          "@language": "et"
        },
        {
          "@value": "vee-ettevõtja ja liituja vahel kirjalikult sõlmitav ühisveevärgi ja -kanalisatsiooniga liitumise leping",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni vee-ettevõtja ja liituja vahel kirjalikult sõlmitav ühisveevärgi ja -kanalisatsiooniga liitumise leping",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
