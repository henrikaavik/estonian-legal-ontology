      },
      "rdfs:label": "hoolduslõikus",
      "skos:definition": [
        {
          "@value": "puu okste lõikamine võra olulise kujundamise teel, mille käigus säilitatakse puu elujõulisus; 4",
          "@language": "et"
        },
        {
          "@value": "puu võra hooldamiseks ja kujundamiseks ette võetav lõikus, mille käigus puud ei likvideerita; 5",
          "@language": "et"
        },
        {
          "@value": "puu hooldamiseks ja võra kujundamiseks teostatav lõikus, mille käigus puud ei likvideerita, vaid vähendatakse puu oksi ja/või harusid rohkem kui 15 % võrra; 3",
          "@language": "et"
        },
        {
          "@value": "puu okste lõikamine võra olulise kujundamise teel, mille käigus säilitatakse puu elujõulisus. Korraga ei tohi eemaldada enam kui 30% puu oksastikust; 4",
          "@language": "et"
        },
        {
          "@value": "puu okste lõikamine võra olulise kujundamise teel, mille käigus säilitatakse puu elujõulisus; 5",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "17",
        "@type": "xsd:integer"
      }
    },
