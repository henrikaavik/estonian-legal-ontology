      },
      "skos:definition": {
        "@value": "on puittaim, mille rinnasläbimõõt (puu tüve läbimõõt mõõdetuna 1,3 meetri kõrguselt juurekaelast) on vähemalt 8 cm ja puul on selgelt nähtav(ad) või määratav(ad) tüvi(ed) ja võra",
        "@language": "et"
