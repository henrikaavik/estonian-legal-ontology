      ],
      "skos:prefLabel": {
        "@value": "asenduskorter",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "leibkonna ümberkolimiseks sobiv korter, mis ei asu tühjenevas korterelamus ja vastab leibkonna põhjendatud vajadustele",
        "@language": "et"
      },
      "estleg:definedIn": [
