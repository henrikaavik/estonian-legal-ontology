    {
      "@id": "estleg:Concept_laane_nigula_valla_teehoiu_eeskiri_t1061479_Tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Tee",
      "skos:definition": "on rajatis, mis on ette nähtud inimeste, sõidukite või loomade liikumiseks või liiklemiseks. Tee osaks loetakse tunnel, sild, viadukt ja muud liiklemiseks kasutatavad ning tee toimimiseks vajalikud rajatised. 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061479_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla teehoiu eeskiri",
