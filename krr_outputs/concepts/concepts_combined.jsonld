      "rdfs:label": "tegevuspiirkond",
      "skos:altLabel": [
        {
          "@value": "Tegevuspiirkond",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "piiritletud maa-ala, kus vee-ettevõtja osutab veega varustamise või reo- ning sademevee ärajuhtimise teenuseid",
          "@language": "et"
        },
        {
          "@value": "piiritletud maa-ala, kus vee-ettevõtja osutab veega varustamise või reovee ärajuhtimise teenuseid",
          "@language": "et"
        },
        {
          "@value": "piiritletud maa-ala kus vee-ettevõtja osutab veega varustamise ja reo- ning sademevee ärajuhtimise teenuseid",
          "@language": "et"
        },
        {
          "@value": "piiritletud maa-ala, kus vee-ettevõtja osutab veega varustamise või reo-ning sademevee ärajuhtimise teenuseid.",
          "@language": "et"
        },
        {
          "@value": "tegevusloaga kindlaks määratud ala, kus soojusettevõtja tegutseb",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
