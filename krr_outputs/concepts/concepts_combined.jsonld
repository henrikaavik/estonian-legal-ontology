      "skos:definition": [
        {
          "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (sh kuivkäimla), puhastamiseks (sh septik) või maapinda immutamiseks",
          "@language": "et"
        },
        {
          "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee ja käimlajäätmete kogumiseks, puhastamiseks või maapinda immutamiseks",
          "@language": "et"
        },
        {
          "@value": "lekkekindel kogumismahuti (sh kuivkäimla lampkast) või omapuhasti; 3) inimekvivalent (edaspidi ie) – on ühe inimese tekitatud keskmine reostusmaht ööpäevas",
          "@language": "et"
        },
        {
          "@value": "rajatis reovee kogumiseks (kogumismahuti) või puhastamiseks (omapuhasti)",
          "@language": "et"
        },
        {
          "@value": "rajatis reovee kogumiseks, st reovee kogumismahuti (sh kuivkäimla) või puhastamiseks, st omapuhasti (biopuhasti või septik koos puhastatud reovee suublasse juhtimisega)",
          "@language": "et"
        }
