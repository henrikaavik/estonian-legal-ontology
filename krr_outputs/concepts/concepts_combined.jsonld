      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_teenistuja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_vormsi_vallavalitsuse_palgajuhend_t1055926_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "palk",
      "skos:definition": "ametnikule tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust; 5",
