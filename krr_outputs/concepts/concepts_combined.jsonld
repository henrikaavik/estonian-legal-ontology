      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "roomikmaastikusõiduk",
      "skos:definition": [
        {
          "@value": "roomikmaastikusõiduk – maastikusõiduk, mis toetub roomikveermikule ja liigub roomikuil ning on ette nähtud maastikul sõitmiseks. Roomikmaastikusõidukiks ei loeta mootorsõidukit, mis vastab ka teel liiklemiseks ettenähtud nõuetele; 45",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_roomiktraktor",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
