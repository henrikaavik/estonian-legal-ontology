    {
      "@id": "estleg:Concept_raasiku_valla_omandis_olevate_eluruumide_ja_mitteeluruumide_t1048679_Korvalkulud",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Kõrvalkulud",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu üürileandja (vallavalitsuse) või kolmanda isiku teenuste ja tegude eest, mis on seotud üüritud asja kasutamisega, näiteks kommunaalkulud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048679_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla omandis olevate eluruumide ja mitteeluruumide üürile andmise ja kasutamise kord",
