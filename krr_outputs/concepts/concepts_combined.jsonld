    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492_heitvesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heitvesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kasutusel olnud vesi, mis juhitakse suublasse. Heitveeks ei peeta sademevett, kaevandusvett, karjäärivett, jahutusvett, maaparandussüsteemis voolavat vett ega vesiviljeluses ja hüdroenergia tootmises kasutatavat vett",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048492_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "heitvesi (reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_heitvesi"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492_immutussusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "immutussüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "heitvee immutussüsteem järgneb tavaliselt septikule. Immutussüsteem koosneb aukudega heitvee immutustorustikust, mis on paigaldatud immutusväljakule teatud kindlate vahedega. Immutusväljak rajatakse tavapäraselt koredast pinnasest (kruus, killustik), et tagada pinnaseosakestel bioloogilistele organismidele elutingimused ja selle tulemusel parem heitvee puhastusvõime. Immutussüsteem ei ole keskkonnast eraldatud kilematerjaliga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048492_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "immutussüsteem (reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_immutussusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "septik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk settekaev on plastmassist, klaasplastist, betoonist, terasest või mõnest muust materjalist mahuti, millel on vähemalt 2 kambrit. Septikus settivad reovees sisalduvad tahked osad, mis lagunevad anaeroobselt (hapnikuvabas keskkonnas) bioloogiliste protsesside tulemusena. Reovee vedel fraktsioon voolab septikust edasi kas reovee immutussüsteemi või filtersüsteemi. Tahke fraktsioon tuleb perioodiliselt eraldada ja vedada nõuetekohaseks käitlemiseks suurema reoveepuhasti juurde",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048492_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "septik (reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_septik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492_ekspert",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ekspert",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandustegevuse seadustiku üldosa seaduse alusel ekspertiisi teostamise pädevust omav isik.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048492_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
