      "rdfs:label": "ohtlik puu või oks",
      "skos:definition": [
        {
          "@value": "puu või oks, mis on osaliselt või täielikult murdunud või mis murdub välise vaatluse järgi ilmselgelt lähiajal või ohustab liiklejaid ning mida on vaja kohe raiuda või eemaldada; 9",
          "@language": "et"
        },
        {
          "@value": "puu või oks, mis on osaliselt või täielikult murdunud või mis on välise vaatluse põhjal peatselt murdumas ning ohustab inimesi või vara; 12",
          "@language": "et"
        }
      ]
    },
