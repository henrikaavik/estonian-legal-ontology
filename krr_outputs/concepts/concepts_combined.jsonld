    {
      "@id": "estleg:Concept_johvi_valla_infoturvapoliitika_t1058728_andmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "andmed",
      "skos:definition": "mistahes viisil ja mistahes andmekandjale jäädvustatud ning kõikvõimalike (infotehnoloogiliste) vahendite abil edastatav või töödeldav teave; 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058728_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla infoturvapoliitika",
