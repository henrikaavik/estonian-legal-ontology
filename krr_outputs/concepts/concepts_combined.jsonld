    {
      "@id": "estleg:Concept_krundi_hoonestusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "krundi hoonestusala",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
