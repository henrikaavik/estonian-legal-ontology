        "@type": "xsd:integer"
      },
      "rdfs:label": "hooldajatoetus",
      "skos:altLabel": [
        {
          "@value": "Hooldajatoetus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "hooldajale igakuiselt makstav rahaline toetus hooldatava toimetuleku soodustamiseks; 3",
          "@language": "et"
        },
        {
          "@value": "hooldajale igakuiselt makstav rahaline toetus; 3",
          "@language": "et"
        },
        {
          "@value": "linnaeelarvest makstav igakuine rahaline toetus täisealise isiku hooldajale.",
          "@language": "et"
        },
        {
          "@value": "Lääne-Nigula valla eelarvest hooldajale igakuiselt makstav rahaline toetus; 6",
          "@language": "et"
        },
        {
          "@value": "puudega ja/või suure hooldusvajadusega isiku hooldajale igakuiselt makstav rahaline toetus; 4",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_hooldajatoetuse_maar",
