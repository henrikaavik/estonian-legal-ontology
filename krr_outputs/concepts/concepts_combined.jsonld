        "@value": "illegaalne grafiti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "omaniku loata hoone seinale, müürile, piirdeaiale, pingile, kõnniteele, ühissõiduki peatuse ootekojale kantud värviga kiri või joonised.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043988_Par_2"
        }
      ],
      "estleg:sourceAct": "Tõrva valla heakorraeeskiri",
