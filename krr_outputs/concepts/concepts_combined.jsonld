    {
      "@id": "estleg:Concept_arengukava_on_haademeeste_valla_pika",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Arengukava on Häädemeeste valla pika",
