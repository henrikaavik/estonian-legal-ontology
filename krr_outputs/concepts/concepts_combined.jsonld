      "rdfs:label": "välireklaam",
      "skos:definition": [
        {
          "@value": "avalikus kohas asuv või avalikust kohast jälgitav reklaam",
          "@language": "et"
        },
        {
          "@value": "avalikus kohas asuv või avalikust kohast jälgitav reklaam, mis asub ehitisel avalikkusele suunatult või eraomandis oleval kinnistul, või mobiilse konstruktsiooni vahendusel avalikkusele suunatult",
          "@language": "et"
        },
        {
          "@value": "avalikus kohas asuv või avalikust kohast jälgitav reklaam, mis asub ehitisel või ehitise siseruumides avalikkusele suunatult või eraomandis oleval kinnistul, ehitisel või selle siseruumides avalikkusele suunatult või mobiilse konstruktsiooni vahendusel avalikkusele suunatult",
          "@language": "et"
        },
        {
          "@value": "avalikus kohas asuv või jälgitav reklaam, mis on paigaldatud hoonele, rajatisele või maapinnale koos reklaamikandjaga või ilma; 3) välireklaamikandja (edaspidi reklaamikandja ) - välireklaami paigaldamiseks kasutatav alus, konstruktsioon, seadeldis",
          "@language": "et"
        },
        {
          "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, sündmuse edendamise või isiku käitumise avalikes huvides suunamise eesmärgil",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
