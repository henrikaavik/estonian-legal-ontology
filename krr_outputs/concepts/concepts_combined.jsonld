      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_kiili_vallas_t1048183_purgimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee suunamine selleks ettenähtud purgimiskohta. Lõikes 1 nimetamata mõiste kasutamisel lähtutakse veeseaduse, ehitusseadustiku, looduskaitseseaduses, keskkonnaseadustiku üldosa seaduses ja teistes reovee käitlemist reguleerivates õigusaktides ning nende rakendusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048183_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri Kiili vallas",
      "rdfs:label": "purgimine (reovee_kohtkaitluse_ja_araveo_eeskiri_kiili_vallas_t1048183)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_purgimine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
