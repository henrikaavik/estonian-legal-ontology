    {
      "@id": "estleg:Concept_viimsi_valla_teede_ja_tanavate_sulgemise_maks_t1028011_parkla",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "parkla",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõidukite parkimiseks ettenähtud ehituslikult või liikluskorralduslikult kujundatud ala, mille moodustavad parkimiskohad ja neid ühendavad teeosad. Parklaks ei loeta sõidutee laiendit või jalgteed, mis on tähistatud parkimist korraldava liikluskorraldusvahendiga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028011_Par_3"
        }
      ],
      "estleg:sourceAct": "Viimsi valla teede ja tänavate sulgemise maks",
