      "rdfs:label": "abonent",
      "skos:definition": [
        {
          "@value": "iga korter kortermajas ja/või iga mõõdusõlme omav ehitis/hoone kinnistul",
          "@language": "et"
        },
        {
          "@value": "kinnistu, mis on liitunud ühisveevarustuse või -kanalisatsiooniteenusega või muu teenuse tarbija, keda vee-ettevõtja on lubanud ühisveevärgiga või ühiskanalisatsiooniga liituda ja teenust kasutada",
          "@language": "et"
        },
        {
          "@value": "tarbimiskoht, mis on liitunud ühisveevärgi või -kanalisatsiooniteenusega või muu teenuse tarbija, keda vee-ettevõtja on lubanud ühisveevärgiga või ühiskanalisatsiooniga liituda ja teenust kasutada",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
