        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lisatasu täiendavate teenistusülesannete eest",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "täiendavate teenistusülesannete täitmise eest makstav lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
