      }
    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_pohiprojekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhiprojekt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "korterelamu rekonstrueerimiseks vajalik ehitusprojekt, mis on koostatud vastavalt ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuetele, standardi EVS 932 või samaväärsetele nõuetele ja määruse nõuetele ning mille arhitektuuri osa koostaja peab omama vähemalt volitatud arhitekti kutse 7. taset",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
