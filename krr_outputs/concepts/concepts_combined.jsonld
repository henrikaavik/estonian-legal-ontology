        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "varutoide",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "elektrivarustus, mis lülitatakse sisse elektrivarustuse katkestuse korral, et hoida käigus näiteks toimepidevuse seisukohalt kõige olulisemad hoone küttesüsteemi seadmed, avariivalgustus vms",
        "@language": "et"
      },
