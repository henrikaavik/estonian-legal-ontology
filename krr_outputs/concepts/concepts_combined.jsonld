      "rdfs:label": "purgimiskoht",
      "skos:definition": [
        {
          "@value": "koht, mis on määratud kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas tekkekohast äraveetud reovee ühiskanalisatsiooni juhtimiseks; 8",
          "@language": "et"
        },
        {
          "@value": "koht, mis on määratud kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas tekkekohast äraveetud reovee ühiskanalisatsiooni juhtimiseks; 9",
          "@language": "et"
        },
        {
          "@value": "tekkekohast äraveetud reovee ja/või fekaalide ühiskanalisatsiooni laskmise koht; 9",
          "@language": "et"
        },
        {
          "@value": "tekkekohast äraveetud reovee või fekaalide ühiskanalisatsiooni laskmise koht; 10",
          "@language": "et"
        },
        {
          "@value": "tekkekohast äraveetud reovee või fekaalide ühiskanalisatsiooni laskmise koht; 22",
          "@language": "et"
        }
