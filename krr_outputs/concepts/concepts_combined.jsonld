          "@value": "majandustehingud eelarvestatakse vastavalt nende toimumise perioodile, arvestamata raha laekumist või väljamaksmist",
          "@language": "et"
        },
        {
          "@value": "majandustehingud kajastatakse vastavalt nende toimumisele, sõltumata sellest, millal nende eest raha laekub või välja makstakse.",
          "@language": "et"
        }
      ],
