    {
      "@id": "estleg:Concept_rikastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rikastamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_rikastamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rikastamine",
      "skos:definition": [
        {
          "@value": "maavaradega tehtavad mehaanilised, füüsikalised, bioloogilised, termilised või keemilised protsessid või nende protsesside kombinatsioon (sealhulgas karjääride tegevus), mille käigus eraldatakse maavara vähemväärtuslik osa väärtuslikumast osast või muudetakse materjali tükisuurust või sorteeritakse materjali või toimub materjali leostumine või eraldumine ning eelnevalt kõrvale jäetud jäätmete ümbertöötamine, välja arvatud sulatamine, termilised tootmisprotsessid (välja arvatud lubjakivi põletamine) ja metallurgiatööd; 3",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_risustamine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_rikastamisjaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
