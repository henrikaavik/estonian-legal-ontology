        }
      ]
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_konsolideerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "konsolideerimine",
      "skos:definition": "raamatupidamisüksuste aruannete ühendamine nii, nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega kaasneb elimineerimine, milline tehing on konsolideerimisgruppi kuuluvate isikute omavaheliste vastandtehingute (tulud-kulud, nõuded-kohustised) liitmine nii, et grupi aruandes neid ei esine; 10",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "konsolideerimine (jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_konsolideerimine"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_konsolideerimine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_valla_konsolideerimisgrupp",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "valla konsolideerimisgrupp",
      "skos:definition": "ametiasutus koos struktuuriüksustega, hallatavad asutused ja valla valitseva või olulise mõju all olevad juriidilised isikud ning nende kaudu valitseva mõju all olevad juriidilised isikud; 11",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
