    },
    {
      "@id": "estleg:Concept_raasiku_valla_heakorraeeskiri_t1061011_risustamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "risustamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "materjalide, jäätmete või tehnika kinnistule ebakorrapäraselt laiali laotamine, mis erineb piirkonna üldisest heakorrastatusest; 18) romusõiduk on sõiduk, millel puuduvad mehaanilised osad või kereosad või klaasid või rattad või mille kere on roostetanud ning mis ei suuda liikuda omal jõul ja mis oma välimusega riivab avaliku ruumi väljanägemist; 19) tiheasustusala on valla üldplaneeringus määratud tiheasustusalad; 20) väikevormid on hoovi või avalikku ruumi kujundavad elemendid, näiteks skulptuurid, kuulutusetulbad, jäätmemahutid, varisein, jäätmemajad ja linnamööbel.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061011_Par_2"
        }
      ],
      "estleg:sourceAct": "Raasiku valla heakorraeeskiri",
      "rdfs:label": "risustamine (raasiku_valla_heakorraeeskiri_t1061011)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_risustamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
