        {
          "@value": "Asendustasu",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "puuduva teenistuja ülesannete täitmise eest makstav lisatasu, mida makstakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, juhul kui asendamine ei ole ettenähtud teenistuja ametijuhendis.",
          "@language": "et"
        },
        {
          "@value": "puuduva teenistuja ülesannete täitmise eest makstav lisatasu, mida makstakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, juhul kui asendamine ei ole ettenähtud teenistuja ametijuhendis; 13",
          "@language": "et"
        },
        {
          "@value": "tasu puuduva teenistuja ülesannete täitmise eest, kui asendamine ei ole ette nähtud teenistuja ametijuhendis või tingib võrreldes ametijuhendis määratuga töökoormuse olulise suurenemise; 9",
          "@language": "et"
        },
        {
          "@value": "käesoleva juhendi tähenduses on asendustasu lisatasu puuduva teenistuja ülesannete täitmise eest. 9 (",
          "@language": "et"
        },
        {
          "@value": "käesoleva juhendi tähenduses on asendustasu lisatasu puuduva töötaja ülesannete täitmise eest. 8 (",
          "@language": "et"
        }
      ],
