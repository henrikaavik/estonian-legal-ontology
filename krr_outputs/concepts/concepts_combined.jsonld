        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elektrienergia brutotoodang",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "koostootmisseadmega toodetud elektrienergia kogus, mis on mõõdetud generaatori väljundklemmidel",
        "@language": "et"
      },
      "estleg:definedIn": [
