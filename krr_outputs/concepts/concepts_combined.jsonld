    {
      "@id": "estleg:Concept_luganuse_valla_huvihariduse_ja_tegevuse_toetamise_kord_t1043095_Oppur",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Õppur",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Lüganuse vallas elav laps või noor vanuses kuni 19 eluaastat, kes õpib huvikoolis või osaleb huvitegevuses.",
        "@language": "et"
      },
      "estleg:definedIn": [
