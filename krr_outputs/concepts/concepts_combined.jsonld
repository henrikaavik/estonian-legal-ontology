      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_avalikult_kasutatava_taristu_tasu"
        }
      ]
    },
    {
      "@id": "estleg:Concept_loksa_linna_korraldatavate_elutahtsate_teenuste_kirjeldused__t1061405_elutahtis_teenus",
