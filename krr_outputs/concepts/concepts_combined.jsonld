      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik või riigi- või kohaliku omavalitsuse asutus (edaspidi isik), kes reklaami avalikult esitab, edastab, näitab või levitab",
        "@language": "et"
      },
