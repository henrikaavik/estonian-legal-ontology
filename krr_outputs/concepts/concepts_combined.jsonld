      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453_imbsusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "imbsüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "omapuhasti osa, kus ehitatud pinnasefiltersüsteemis toimub reovee bioloogiline puhastamine pinnaseosakestele tekkivas biokiles elavate mikroorganismide poolt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049453_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "imbsüsteem (joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_imbsusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453_inimekvivalent",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "inimekvivalent",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühe inimese põhjustatud keskmise ööpäevase tingliku reostuskoormuse ühik. Inimekvivalendi väärtuseks biokeemilise hapnikutarbe (BHT7) kaudu väljendatuna on 60 grammi hapnikku ööpäevas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049453_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "inimekvivalent (joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_inimekvivalent"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453_isikliku_majapidamise_reoveepuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "isikliku majapidamise reoveepuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühe ühepereelamu tarbeks kasutatav omapuhasti; 6) kogumismahuti –reovee ja käimlajäätmete ajutiseks hoiustamiseks ette nähtud lekkekindel ja äravooluta rajatis; 7) kuivkäimla –ehitis, mille osaks on kogumismahuti; 8) omapuhasti –rajatis, kus kõrvaldatakse mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega saasteained ja ebasoovitavad organismid ning mille projekteeritud reostuskoormus ei ületa 49 inimekvivalenti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049453_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "isikliku majapidamise reoveepuhasti (joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_isikliku_majapidamise_reoveepuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453_purgimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kohtkäitlusesüsteemist reovee, –sette ja/või käimlajäätmete eemaldamine ja äravedu asjakohase sõidukiga (purgimissõiduk) ning selle purgimiskohas väljutamine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049453_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "purgimine (joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_purgimine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453_reovee_kohtkaitlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee kohtkäitlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee tekkekohas, üldjuhul ühe kinnistu piires ja seal tekkiva reovee tarbeks kuni 50 inimese olmes tekkiva reovee kogumine, puhastamine, pinnasesse immutamine ja nõuetekohaselt puhastatult heitveena suublasse väljamine ja/või taaskasutamine, sh käimlajäätmete kogumine, kompostimine ja/või taaskasutamine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049453_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "reovee kohtkäitlus (joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_kohtkaitlus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453_reovee_kohtkaitlussusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee kohtkäitlussüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee ja käimlajäätmete kogumiseks, puhastamiseks ja/või maapinda immutamiseks, sh reovee ajutiseks kogumiseks (nt kogumismahuti, kuivkäimla) või reovee puhastamiseks ja nõuetekohaselt puhastatult heitveena suublasse juhtimiseks (nt omapuhasti, sh isikliku majapidamise reoveepuhasti); 12) septik –pealt kinnine väljavooluga reovee mehhaaniline puhasti, kus sadenenud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt. Septikus mehhaaniliselt puhastunud reovesi juhitakse imbsüsteemi, kus toimub selle lõplik puhastamine ja heitveena suublasse juhtimine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049453_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "reovee kohtkäitlussüsteem (joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_kohtkaitlussusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453_suubla",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "suubla",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "veekogu, veekogu osa või maapõue osa, kuhu reoveepuhastist väljutatakse heitvett.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049453_Par_2"
