      "estleg:definesConcept": {
        "@id": "estleg:Concept_ekspert"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_eeskiri_t1043752_tee_sulgemine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tee sulgemine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ajutise iseloomuga olukord, kui puudub võimalus tee avalikuks kasutamiseks. Tee sulgemiseks ei loeta lühiajalist osalist tee sulgemist teerajatiste hoolduseks või teehoiutööde teostamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043752_Par_3"
        }
      ],
      "estleg:sourceAct": "Teede ja tänavate sulgemise eeskiri",
      "rdfs:label": "tee sulgemine (teede_ja_tanavate_sulgemise_eeskiri_t1043752)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tee_sulgemine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_eeskiri_t1043752_tee_sulgeja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tee sulgeja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle tegevusest tuleneb tee sulgemise vajadus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043752_Par_3"
        }
      ],
      "estleg:sourceAct": "Teede ja tänavate sulgemise eeskiri",
      "rdfs:label": "tee sulgeja (teede_ja_tanavate_sulgemise_eeskiri_t1043752)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tee_sulgeja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_eeskiri_t1043752_avariitoo",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avariitöö",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vältimatu ja kiireloomuline töö ehitise, seadme või tehnosüsteemi ootamatu purunemise, rikke või eelpool nimetatud asjaolude tagajärjel tekkinud kahjustuse kõrvaldamiseks. Käesoleva paragrahvi lõikes 2 nimetamata mõiste kasutamisel lähtutakse liiklusseaduses ja teistes teede ja tänavate sulgemist reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel sõna üldlevinud tähendusest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043752_Par_3"
        }
      ],
      "estleg:sourceAct": "Teede ja tänavate sulgemise eeskiri",
      "rdfs:label": "avariitöö (teede_ja_tanavate_sulgemise_eeskiri_t1043752)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avariitoo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_maks_t1043195_avalik_uritus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik üritus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "spordi-, kultuuri- või meelelahutusüritus, avalik koosolek või muu selline sündmus, mille korraldamiseks on väljastatud avaliku ürituse luba",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043195_Par_2"
        }
      ],
      "estleg:sourceAct": "Teede ja tänavate sulgemise maks",
      "rdfs:label": "avalik üritus (teede_ja_tanavate_sulgemise_maks_t1043195)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_uritus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_maks_t1043195_avariitoo",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avariitöö",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043195_Par_2"
        }
      ],
      "estleg:sourceAct": "Teede ja tänavate sulgemise maks",
      "rdfs:label": "avariitöö (teede_ja_tanavate_sulgemise_maks_t1043195)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avariitoo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_maks_t1043195_jalgtee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jalgtee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "käesoleva määruse tähenduses tee, mida kasutatakse kas ainult jalakäijate, nii jalakäijate kui ka jalgratturite või ainult jalgratturite liiklemiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043195_Par_2"
        }
      ],
      "estleg:sourceAct": "Teede ja tänavate sulgemise maks",
      "rdfs:label": "jalgtee (teede_ja_tanavate_sulgemise_maks_t1043195)",
