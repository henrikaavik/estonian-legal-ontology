        "@type": "xsd:integer"
      },
      "rdfs:label": "kuja",
      "skos:definition": [
        {
          "@value": "kanalisatsiooniehitiste, torustik välja arvatud, lubatud kõige väiksem kaugus hoonest, joogivee salv- või puurkaevust ning muuks kui joogiveeotstarbeks kasutatavast puurkaevust",
          "@language": "et"
        },
        {
          "@value": "kanalisatsiooniehitiste, torustik välja arvatud, lubatud kõige väiksem kaugus hoonest, joogivee salv- või puurkaevust ning muuks kui joogivee otstarbeks kasutatavast puurkaevust",
          "@language": "et"
        },
        {
          "@value": "hoonete ja/või rajatiste väikseim lubatud vahekaugus",
          "@language": "et"
        },
        {
          "@value": "kanalisatsiooniehitise, torustik välja arvatud, lubatud kõige väiksem kaugus hoonest, joogivee salv- või puurkaevust ning muuks kui joogivee otstarbeks kasutatavast puurkaevust",
          "@language": "et"
        },
        {
          "@value": "kanalisatsiooniehitise, välja arvatud torustik, kõige väiksem lubatud kaugus elamust ning majutus-, ravi-, spordi-, haridus-, kaubandus- ja teenindushoonest, samuti transpordihoonest, mis teenindab regulaarselt inimesi, ning salv- ja puurkaevust",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "16",
        "@type": "xsd:integer"
      },
