    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825_kavandatav_kompetentsikeskus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kavandatav kompetentsikeskus",
      "skos:definition": "kompetentsikeskus, mille põhitegevusi ei ole toetatud regionaalministri 3. juuli 2009. a määruse nr 10 „Meetme „Kompetentsikeskuste arendamine” tingimused” alusel ning millele soovitakse taotleda toetust käesoleva määruse alusel. Kui kavandatavale kompetentsikeskusele antakse käesoleva määruse alusel toetust põhitegevuseks, loetakse teda kavandatavaks kompetentsikeskuseks kuni põhitegevuste lõpetamiseni; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1032825_Par_4"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused regionaalsete kompetentsikeskuste arendamiseks",
      "rdfs:label": "kavandatav kompetentsikeskus (toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kavandatav_kompetentsikeskus"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_kavandatav_kompetentsikeskus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825_kompetents",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kompetents",
      "skos:definition": "uuendusliku teabe, selle loomise, vahendamise ja rakendamisega seotud pädevus, mille valdkondlik suund on selgelt piiritletav ning mille abil saab luua lisandväärtust tekitavaid ressursi- või tulemuspõhiseid uuenduslikke arendusi ja saavutada kompetentsikeskuse suur konkurentsivõime; 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1032825_Par_4"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused regionaalsete kompetentsikeskuste arendamiseks",
      "rdfs:label": "kompetents (toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kompetents"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_kompetents"
        }
      ]
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825_kompetentsikeskus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kompetentsikeskus",
      "skos:definition": "era- või avalik-õiguslik juriidiline isik või nende isikute moodustatud mitteformaalne ühendus, mis põhineb haridus-, teadus- ja arendusasutuste, ettevõtjate ning avaliku sektori vahelisel uuenduslikul ja teadmusmahukal koostööl, eesmärgiga pakkuda tuge piirkondliku ettevõtluse ja tööturu arengule nii kvalifitseeritud spetsialistide, uuringute ja koolituste kui ka füüsilise keskkonna näol, ning mis on teadmisi levitav organisatsioon üldise grupierandi määruse artikli 2 punkti 83 tähenduses; 10",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1032825_Par_4"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused regionaalsete kompetentsikeskuste arendamiseks",
      "rdfs:label": "kompetentsikeskus (toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kompetentsikeskus"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_kompetentsikeskus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825_koostooleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "koostööleping",
      "skos:definition": "kompetentsikeskuse arendamisega seotud koostööpartnerite vahel sõlmitud kirjalik ühise tegutsemise leping, mis esitatakse koos ideekavandiga ja põhitegevuse toetuse taotlusega juhul, kui taotlejaks ei ole § 6 lõike 3 kohaselt asutatud sihtasutus või mittetulundusühing. Koostööleping reguleerib koostööpartneritevahelisi suhteid alates ideekavandi esitamisest kuni kompetentsikeskuse põhitegevuste elluviimisele suunatud projekti abikõlblikkuse perioodi lõppemisest arvates viie aasta möödumiseni ning kompetentsikeskuse alalise juhtorgani koosseisu määramist ja juhtorgani tööpõhimõtteid; 11",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1032825_Par_4"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused regionaalsete kompetentsikeskuste arendamiseks",
      "rdfs:label": "koostööleping (toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_koostooleping"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_koostooleping"
        }
      ]
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825_koostoopartner",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "koostööpartner",
      "skos:definition": "kompetentsikeskuse arendamisega seotud § 6 lõikes 5 nimetatud koostöölepingu allkirjastanud § 6 lõigetes 1 ja 2 nimetatud juriidiline isik, kes on kaasatud kompetentsikeskuse arendamiseks läbi viidava projekti finantseerimisse, juhtimisse või elluviimisse. Koostööpartneri panus projekti elluviimisse ei pea olema rahaliselt mõõdetav. Kui koostööpartner panustab projekti rahaliselt, loetakse teda partneriks punkti 12 tähenduses; 12",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1032825_Par_4"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused regionaalsete kompetentsikeskuste arendamiseks",
      "rdfs:label": "koostööpartner (toetuse_andmise_tingimused_regionaalsete_kompetentsikeskuste_t1032825)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_koostoopartner"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_koostoopartner"
        }
      ]
    },
    {
