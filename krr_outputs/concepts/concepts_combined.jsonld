      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "lemmikloomapidaja",
      "skos:definition": [
        {
          "@value": "isik, kellele lemmikloom kuulub (lemmikloomaomanik) või kes tegeleb lemmikloomapidamisega lemmikloomaomanikuga rendi- või muu selletaolise suhte alusel. Kuuluvuse kaudu identifitseerimisel loetakse lemmikoom kuuluvaks isikule, kelle valduses, sealhulgas kelle kinnisel territooriumil või kellele kuuluvas hoones või rajatises ta asub, kui lemmiklooma kuuluvusest huvitatud isik ei tõenda vastupidist",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
