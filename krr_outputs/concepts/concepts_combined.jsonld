    {
      "@id": "estleg:Concept_rahvusvaheline_buroo",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Rahvusvaheline Büroo",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rahvusvahelise_patenditaotluse_patendiametile_esitamise_kord_t1002215_Rahvusvaheline_Buroo"
        }
