    {
      "@id": "estleg:Concept_teadusuuringute_taristu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadusuuringute taristu",
        "@language": "et"
