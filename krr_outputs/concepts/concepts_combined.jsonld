      "skos:definition": [
        {
          "@value": "jäätmete kogumine, vedamine, taaskasutamine ja kõrvaldamine, sealhulgas vahendaja või edasimüüja tegevus; 10",
          "@language": "et"
        },
        {
          "@value": "jäätmete kogumine, vedamine, taaskasutamine ja kõrvaldamine, sealhulgas vahendaja või edasimüüja tegevus; 15",
