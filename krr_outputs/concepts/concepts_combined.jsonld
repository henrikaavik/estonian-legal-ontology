      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_Suurjaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Suurjäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmed, mida kaalu või mahu tõttu ei ole võimalik paigutada mahutisse, nagu mööbliesemed, vaibad, madratsid, kardinapuud jms. Suurjäätmetena ei käsitata ehitusjäätmeid ning suuremõõtmelisi probleemtooteid, nagu autoromud või nende osad (sealhulgas vanarehvid), ning elektri- ja elektroonikaseadmeid või nende jäätmeid (sealhulgas pesumasinad, telerid, külmkapid, elektripliidid) ja muid tootjavastutusega hõlmatud jäätmeid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054824_Par_3"
        }
      ],
      "estleg:sourceAct": "Viimsi valla jäätmehoolduseeskiri",
      "rdfs:label": "Suurjäätmed (viimsi_valla_jaatmehoolduseeskiri_t1054824)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_suurjaatmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_biolagunevad_jaatmed",
