    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_keskkonnahoidlik_riigihange",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "keskkonnahoidlik riigihange",
      "skos:definition": "riigihange, kus on lisaks muudele tingimustele kehtestatud keskkonnanõuded ja -kriteeriumid, mille rakendamise eesmärk on vähendada negatiivset keskkonnamõju keskkonnahoidlike toodete, teenuste ja ehitustööde hankimise kaudu; 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
