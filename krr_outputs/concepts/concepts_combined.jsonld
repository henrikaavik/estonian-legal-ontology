        "@type": "xsd:integer"
      },
      "rdfs:label": "ringmajandus on tootmis",
      "skos:definition": [
        {
          "@value": "ja tarbimismudel, mille puhul tooteid jagatakse, laenatakse, kasutatakse korduvalt, parandatakse, uuendatakse ja olemasolevaid materjale võetakse ringlusse võimalikult kaua; 5",
          "@language": "et"
