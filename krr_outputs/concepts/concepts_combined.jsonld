      "rdfs:label": "investeering",
      "skos:definition": [
        {
          "@value": "põhivara soetus ja sellega kaasnev käibemaksukulu seoses objekti ehitamise või renoveerimisega või vara soetamisega",
          "@language": "et"
        },
        {
          "@value": "põhivara soetus ja sellega kaasnev käibemaksukulu seoses objekti ehitamise või renoveerimisega või vara soetamisega. Korras täpsustamata mõisteid kasutatakse kohaliku omavalitsuse üksuse finantsjuhtimise seaduse ja raamatupidamise seaduse tähenduses.",
          "@language": "et"
        },
        {
          "@value": "põhivara soetus ja sellega kaasnev käibemaksukulu, mis on seotud objekti ehitamise või renoveerimisega või vara soetamisega. Korras täpsustamata mõisteid kasutatakse kohaliku omavalitsuse üksuse finantsjuhtimise seaduse ja raamatupidamise seaduse tähenduses.",
          "@language": "et"
        },
        {
          "@value": "põhivara soetus või renoveerimine ning sellega kaasnev käibemaksukulu",
          "@language": "et"
        }
      ],
