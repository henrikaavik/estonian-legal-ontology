      "skos:prefLabel": {
        "@value": "reovesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "üle kahjutuspiiri rikutud ja enne loodusesse tagasi (suublasse) juhtimist puhastamist vajav kasutatud vesi, mille keemilisi ja/või füüsikalisi omadusi on muudetud. Eeskirjas hõlmab mõiste \"reovesi\" ka fekaale ja reovee puhastamise käigus tekkivat setet",
        "@language": "et"
      },
      "estleg:definedIn": [
