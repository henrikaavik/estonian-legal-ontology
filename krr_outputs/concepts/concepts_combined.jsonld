    {
      "@id": "estleg:Concept_johvi_valla_heakorraeeskiri_t1055130_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omanik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle omandis on maa või ehitised või kelle kasuks on seatud hoonestusõigus; heakorra nõuete täitmisel on omanikuga võrdsustatud tema poolt volitatud valdaja, haldaja või kasutaja. Juhul, kui omaniku poolt sõlmitud leping ei kehtesta teise poole kohustusi heakorra tagamiseks, lasub nimetatud kohustus omanikul",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055130_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla heakorraeeskiri",
      "rdfs:label": "omanik (johvi_valla_heakorraeeskiri_t1055130)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_heakorraeeskiri_t1055130_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maatükk), hoonestusõigus, kasutusvaldus, korteriomand, korterihoonestusõigus või muud võimalik seadusjärgne kasutus, samuti katastriüksus ja reformimata riigimaa; heakorra nõuete täitmisel on võrdsustatud mõisteteks maa-ala, territoorium, krunt, maaüksus ja katastriüksus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055130_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla heakorraeeskiri",
      "rdfs:label": "kinnistu (johvi_valla_heakorraeeskiri_t1055130)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_heakorraeeskiri_t1055130_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringile üldiseks liikumiseks ja kasutamiseks antud igasugune territoorium, hoone, rajatis või ruum (näiteks teed, tänavad, hoovid, haljasalad, pargid, terviserajad, parklad, kalmistud, ametiasutused, haridus-, tervishoiu- ja kultuuriasutused, toitlustusettevõtted, kauplused, spordihooned, ühissõidukid jmt)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055130_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla heakorraeeskiri",
      "rdfs:label": "avalik koht (johvi_valla_heakorraeeskiri_t1055130)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_koht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_heakorraeeskiri_t1055130_puhastusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puhastusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsilise või juriidilise isiku omandis või valduses olev kinnistu või muu territoorium ning sellega vahetult piirnev üldkasutatav territoorium, millele laieneb käesolevast eeskirjast tulenev korrashoiu kohustus. Puhastusala ulatub risti suunas krundi piirist või ehitisest sõidutee katte servani (kõnnitee puudumisel talvisel ajal üks meeter sõiduteele). Ehitiste vahelise maa-ala puhastusala piiriks on nendevaheline mõtteline telgjoon",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055130_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla heakorraeeskiri",
      "rdfs:label": "puhastusala (johvi_valla_heakorraeeskiri_t1055130)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_puhastusala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_heakorraeeskiri_t1055130_heakorratood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heakorratööd",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tolmu, liiva, prahi, jäätmete, lume ja jää koristamine (sh jääpurikad katusel) ning libedusetõrje, muru ja heina niitmine, lehtede riisumine, heki pügamine ning kõnniteel liikumist takistavate puude ja põõsaste okste lõikamine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055130_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla heakorraeeskiri",
      "rdfs:label": "heakorratööd (johvi_valla_heakorraeeskiri_t1055130)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_heakorratoo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_heakorraeeskiri_t1055130_eriolukord",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
