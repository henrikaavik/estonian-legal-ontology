    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "palk",
      "skos:definition": "ametnikule tehtud töö eest makstav tasu, mis võib koosneda põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust. 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040857_Par_3"
        }
      ],
      "estleg:sourceAct": "Tõrva Vallavalitsuse palgajuhend",
