      "estleg:definesConcept": {
        "@id": "estleg:Concept_arenduspiirkond"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_e_t1058914_Kaitsevoond",
      "@type": [
        "owl:NamedIndividual",
