      },
      "rdfs:label": "korterelamu üldelekter",
      "skos:definition": [
        {
          "@value": "korterelamu üldises kasutuses oleva elektripaigaldise (näiteks trepikoja valgustusseade, lift, kütteseade) poolt tarvitatav elektrienergia",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
