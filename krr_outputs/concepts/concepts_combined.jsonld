        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rajatis, mis on ette nähtud inimeste, sõidukite, või loomade liikumiseks või liiklemiseks. Tee osadeks loetakse tunnel, sild, viadukt, ja muud liiklemiseks kasutatavad ning tee toimimiseks vajalikud rajatised",
        "@language": "et"
      },
      "estleg:definedIn": [
