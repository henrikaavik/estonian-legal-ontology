      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sotsiaaleluruum",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
