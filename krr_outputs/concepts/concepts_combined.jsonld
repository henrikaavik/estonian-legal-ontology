        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_ehitusmaarus_t1027827_krundi_hoonestustihedus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "krundi hoonestustihedus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "krundil asuvate või krundile kavandatud hoonete maapealse osa suletud brutopindala suhe krundi pindalasse. Krundi hoonestustiheduse leidmisel ei võeta üldjuhul arvesse alla 20 m 2 ehitusaluse pinnaga hooneid va juhul, kui väikehooned on arvestatud krundi ehitusõiguse hulka; 8) korterelamukrundi koormusindeks (KKKI) - korterelamu krundipinna suhe korterite arvu. Koormusindeksi kaudu antakse minimaalne lubatud krundipind korterelamu korteri kohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1027827_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla ehitusmäärus",
      "rdfs:label": "krundi hoonestustihedus (joelahtme_valla_ehitusmaarus_t1027827)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_krundi_hoonestustihedus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_ehitusmaarus_t1027827_ehitise_korgus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ehitise kõrgus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitist vahetult ümbritseva olemasoleva maapinna minimaalse ja maksimaalse kõrguse aritmeetilise keskmise ja ehitise katuseharja või parapeti kõrguste vahe. Ehitisel paiknevat tehnoseadet ja -süsteemi ning selle osa, sealhulgas korsten ja antenn ning välireklaami ja muud taolist ehitise kõrguse hulka üldjuhul ei arvestata",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1027827_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla ehitusmäärus",
      "rdfs:label": "ehitise kõrgus (joelahtme_valla_ehitusmaarus_t1027827)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ehitise_korgus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
