      "estleg:definesConcept": {
        "@id": "estleg:Concept_kompaktse_asustusega_ala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_alutaguse_valla_heakorraeeskiri_t1049887_puhastusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puhastusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsilise või juriidilise isiku omandis või valduses olev kinnistu või muu territoorium ning sellega vahetult piirnev üldkasutatav territoorium, millele laieneb käesolevast eeskirjast tulenev korrashoiukohustus. Puhastusala ulatub ristisuunas krundi piirist või ehitisest sõidutee katte servani (kõnnitee puudumisel talvisel ajal üks meeter sõiduteele). Ehitistevahelise maa-ala puhastusala piiriks on nendevaheline mõtteline telgjoon",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049887_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla heakorraeeskiri",
      "rdfs:label": "puhastusala (alutaguse_valla_heakorraeeskiri_t1049887)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_puhastusala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_alutaguse_valla_heakorraeeskiri_t1049887_risustamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "risustamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "igasugune materjalide, jäätmete või muu kinnistule ebakorrapäraselt laiali laotamine ehk olukord, mis erineb piirkonna üldisest heakorrastatusest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049887_Par_2"
        }
      ],
