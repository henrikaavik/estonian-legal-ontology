      },
      "rdfs:label": "maksevõimekuse hinnang",
      "skos:definition": [
        {
          "@value": "kalkulatsioon, mis sisaldab isiku sissetuleku ja varalise võimekuse analüüsi ning mille alusel selgub, millises ulatuses on teenust vajav isik ise või ülalpidamiskohustusega isik(ud) võimelised hoolekandeasutuse teenuskoha maksumuse tasuma; 14) sotsiaaltöö spetsialist (edaspidi spetsialist) - ametiasutuse sotsiaalosakonna ametnik.",
          "@language": "et"
        }
      ],
