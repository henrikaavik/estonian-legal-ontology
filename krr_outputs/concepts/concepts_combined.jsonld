    {
      "@id": "estleg:Concept_puudega_isiku_eluruumi_kohandamise_kulude_huvitamise_kord_t1043349_ehitustoode_kokkulepe",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ehitustööde kokkulepe",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "taotluse menetlemisel sõlmitud kirjalikud kokkulepped ehitustööde liigi, korraldamise, mahu, teostaja, maksmise tingimuste jms kohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043349_Par_2"
        }
      ],
      "estleg:sourceAct": "Puudega isiku eluruumi kohandamise kulude hüvitamise kord",
