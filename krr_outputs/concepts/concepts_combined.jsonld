      ],
      "skos:prefLabel": {
        "@value": "purgimisteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kohtkäitlusesüsteemist reovee või –sette eemaldamine ja äravedu purgimissõidukiga ning selle väljutamine purgimiskohta; 8) saunakaev on ette nähtud kanaliseerimata kohas tekkiva pesuvee maasse immutamiseks pärast mehaanilist puhastamist. Saunakaev püüab pesuvees leiduvad tahked osakesed kinni ja vesi juhitakse kaevus olevate avauste kaudu pinnasesse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054816_Par_2"
        }
