        "@value": "vaatluskaev",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avatava luugi ja põhjas asuva voolurenniga kaev kanalisatsioonitorustikul; vee- või reovee mõõtekaev - kaev, kus asub vee- või reoveemõõtesõlm; 27) vee- või reovee mõõtekaev - kaev, kus asub vee- või reoveemõõtesõlm; 28) vee- või reovee mõõtesõlm - vee- või reovee mõõtmiseks ettenähtud vee- või reoveearvesti ja arvesti juurde kuuluvast armatuurist koosnev tehniline sõlm",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1019386_Par_2"
        }
      ],
