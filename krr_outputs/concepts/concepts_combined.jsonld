      "rdfs:label": "ühissõiduk",
      "skos:altLabel": [
        {
          "@value": "Ühissõiduk",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "Jõhvi valla haldusterritooriumil tasulise sõitjateveo teostamiseks kasutatav buss, sõiduauto või muu mootori jõul liikuv transpordivahend; 5",
          "@language": "et"
        },
        {
          "@value": "ühistranspordiseaduse kohaselt ühistransporditeenust osutav buss, troll, tramm, samuti sõitjaid teenindav ühistransporditeenuse osutamiseks ettenähtud sõiduauto ja turiste teenindav buss. 5 (",
          "@language": "et"
        },
        {
          "@value": "ühistransporditeenuse osutamiseks ettenähtud transpordivahend; 15",
          "@language": "et"
        }
      ]
    },
