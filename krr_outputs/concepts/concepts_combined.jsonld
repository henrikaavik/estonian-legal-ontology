    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_piirkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "piirkond",
      "skos:definition": "ühe või mitme kohaliku omavalitsuse üksuse territoorium, samuti külade kogum, linnaosa või linnaosade kogum, mida iseloomustab ühtse keskuse olemasolu või sarnased sotsiaal-majanduslikud või kultuurilised tingimused; 2",
