      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_lasketiiru_ja_laskepaiga_ning_laskevoistluse_ja_treeninglask_t1051456_mitterikosettiv",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "mitterikošettiv",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kõva materjali või objekti omadus, tänu millele see kõva materjal või objekt ei põhjusta ohtlikku rikošetti ning kuulitabamuse korral deformeerub või puruneb",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051456_Par_2"
        }
      ],
      "estleg:sourceAct": "Lasketiiru ja laskepaiga ning laskevõistluse ja treeninglaskmise ohutusnõuded",
