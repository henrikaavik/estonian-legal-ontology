        "@type": "xsd:integer"
      },
      "rdfs:label": "ühiskasutuses jäätmemahuti",
      "skos:definition": [
        {
          "@value": "jäätmemahuti, mida omavahelise kokkuleppe alusel kasutab rohkem kui üks jäätmevaldaja ning mille tühjendamiseks on vähemalt ühel jäätmevaldajal sõlmitud jäätmevedajaga jäätmeleping. 3 (",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_uhiskasutuses_olev_katse",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
