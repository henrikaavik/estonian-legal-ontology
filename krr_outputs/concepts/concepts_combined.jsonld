        "@type": "xsd:integer"
      },
      "rdfs:label": "loomapidamine",
      "skos:definition": [
        {
          "@value": "loomapidaja poolt oma võimu teostamine (kasvatamine, hoidmine, jalutamine, toitmine jmt. tegevus) koera ja/või kassi üle; 3",
          "@language": "et"
        },
        {
          "@value": "loomapidaja poolt oma võimu teostamine (kasvatamine, hoidmine, jalutamine, toitmine või muu tegevus) looma üle; 4",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_loomataud",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "loomataud",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
