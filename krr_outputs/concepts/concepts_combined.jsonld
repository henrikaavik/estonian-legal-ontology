    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_energiasalvestuse_pilootp_t1055298_toetatav_kulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toetatav kulu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "projekti toetusest rahastatava tegevuse elluviimiseks vajalik ja mõistlik kulu, mis on tekkinud projekti abikõlblikkuse perioodil ning mille aluseks olevad tegevused on kooskõlas Eesti ja Euroopa Liidu õigusega; 14) väike- ja keskmise suurusega ettevõtja – ettevõtja, kes vastab üldise grupierandi määruse lisa I artiklis 2 sätestatud kriteeriumidele.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055298_Par_3"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused ja kord energiasalvestuse pilootprojektide arendamiseks",
