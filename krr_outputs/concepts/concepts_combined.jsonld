      "rdfs:label": "sademevesi",
      "skos:altLabel": [
        {
          "@value": "Sademevesi",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi, mis ei ole reovesi ning mis juhitakse ühiskanalisatsiooni või sademevee kanalisatsiooni",
          "@language": "et"
        },
        {
          "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi (edaspidi sademevesi ), mis ei ole reovesi ning mis juhitakse ühiskanalisatsiooni või sademevee kanalisatsiooni.",
          "@language": "et"
        },
        {
          "@value": "sademetena maapinnale langenud ning ehitiste, sh kraavide abil kogutud ja suublasse suunatud vesi",
          "@language": "et"
        },
        {
          "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi, mis ei ole reovesi ning mis juhitakse sademevee kanalisatsiooni",
          "@language": "et"
        },
        {
          "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi, mis ei ole reovesi ning mis juhitakse ühisvoolsesse kanalisatsiooni või sademevee kanalisatsiooni",
          "@language": "et"
        }
