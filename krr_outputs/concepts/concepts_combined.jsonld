    {
      "@id": "estleg:Concept_soojuse_muugi_ajutise_hinna_kehtestamise_kord_t1001155_ajutine_hind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ajutine hind",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "„Kaugkütteseaduse” § 9 lõigete 10 1 ja 10 2 ning käesoleva määruse alusel Konkurentsiameti poolt soojusettevõtjale kehtestatav soojuse müügi ajutine hind; 2) eraldiseisvate kulude jagamise meetod (edaspidi alternatiivkatlamaja meetod ) – elektri ja soojuse koostootmise protsessis soojuse tootmisel kulude jagamise meetod, mille puhul eeldatakse, et tarbijale müüdav soojus toodetakse soojuse tootmiseks ette nähtud katlamajas. Meetod põhineb printsiibil, et tarbija ei pea maksma soojuse eest enam, kui see on toodetud ainult soojuse tootmiseks ette nähtud katlaseadmetega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1001155_Par_2"
        }
      ],
      "estleg:sourceAct": "Soojuse müügi ajutise hinna kehtestamise kord",
      "rdfs:label": "ajutine hind (soojuse_muugi_ajutise_hinna_kehtestamise_kord_t1001155)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ajutine_hind"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
