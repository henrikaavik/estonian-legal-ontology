    {
      "@id": "estleg:Concept_konkursi_narva_ettevotja_labiviimise_korra_kinnitamine_t1061582_Turismiarendaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Turismiarendaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidiline isik (äriühing, FIE, sihtasutus või mittetulundusühing), kes tegeleb turismitoodete ja -teenuste arendamisega ning pakkumisega. 4) Startija on ettevõte, mis on alustanud äritegevust viimase kahe aasta jooksul ning on esitanud äriregistrile vähemalt ühe majandusaasta aruande või, FIE puhul, tulumaksu- ja sotsiaalmaksu deklaratsiooni Maksu- ja Tolliametile (MTA).",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061582_Par_2"
        }
      ],
      "estleg:sourceAct": "Konkursi “Narva Ettevõtja” läbiviimise korra kinnitamine",
      "rdfs:label": "Turismiarendaja (konkursi_narva_ettevotja_labiviimise_korra_kinnitamine_t1061582)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_turismiarendaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_konkursi_narva_ettevotja_labiviimise_korra_kinnitamine_t1061582_Noor_Ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Noor Ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ettevõte, mille vähemalt üks omanik või juhatuse liige on kuni 29-aastane (kaasa arvatud). 6) Vastutustundlik ettevõte on äriühing, kelle tegevus ei piirdu üksnes majandusliku kasumi taotlemisega, vaid hõlmab teadlikku ja süsteemset panust ühiskondlike ja keskkonnahoidlike eesmärkide saavutamisse. Ettevõte järgib eetilisi äritavasid, rakendab keskkonnasäästlikke lahendusi ning toetab kogukonna heaolu ja sotsiaalset sidusust.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061582_Par_2"
        }
      ],
      "estleg:sourceAct": "Konkursi “Narva Ettevõtja” läbiviimise korra kinnitamine",
