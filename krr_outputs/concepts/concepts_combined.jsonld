    {
      "@id": "estleg:Concept_proviisori_voi_farmatseudina_registreerimise_ja_eestis_provi_t158791_farmaatsia_valdkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "farmaatsia valdkond",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ravimite ja nende koostisainete uurimine, valmistamine, tootmine, kvaliteedi kontroll, apteegiteenuse osutamine nii elanikele kui tervishoiuteenuse osutajatele, ravimialase informatsiooni jagamine ja nõustamine, sealhulgas töötamine pädeva isikuna «Ravimiseaduses» sätestatud tingimustel",
        "@language": "et"
      },
