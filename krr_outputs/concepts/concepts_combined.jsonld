        }
      ]
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492_immutussusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "immutussüsteem",
      "skos:definition": "heitvee immutussüsteem järgneb tavaliselt septikule. Immutussüsteem koosneb aukudega heitvee immutustorustikust, mis on paigaldatud immutusväljakule teatud kindlate vahedega. Immutusväljak rajatakse tavapäraselt koredast pinnasest (kruus, killustik), et tagada pinnaseosakestel bioloogilistele organismidele elutingimused ja selle tulemusel parem heitvee puhastusvõime. Immutussüsteem ei ole keskkonnast eraldatud kilematerjaliga; 12",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048492_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "immutussüsteem (reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_immutussusteem"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_immutussusteem"
        }
      ]
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "septik",
      "skos:definition": "ehk settekaev on plastmassist, klaasplastist, betoonist, terasest või mõnest muust materjalist mahuti, millel on vähemalt 2 kambrit. Septikus settivad reovees sisalduvad tahked osad, mis lagunevad anaeroobselt (hapnikuvabas keskkonnas) bioloogiliste protsesside tulemusena. Reovee vedel fraktsioon voolab septikust edasi kas reovee immutussüsteemi või filtersüsteemi. Tahke fraktsioon tuleb perioodiliselt eraldada ja vedada nõuetekohaseks käitlemiseks suurema reoveepuhasti juurde; 13",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048492_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "septik (reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492)",
