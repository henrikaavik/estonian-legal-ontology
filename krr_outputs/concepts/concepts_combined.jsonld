      "rdfs:label": "andmed",
      "skos:definition": [
        {
          "@value": "mis tahes viisil ja mis tahes infokandjale jäädvustatud või dokumenteeritud informatsioon ja kõikvõimalike IT-vahendite abil edastatav või töödeldav teave",
          "@language": "et"
        },
        {
          "@value": "informatsiooni kirjapanek taasesitamist võimaldaval kujul",
          "@language": "et"
        },
        {
          "@value": "informatsiooni taastõlgendatav esitus formaliseeritud kujul, mis sobib edastuseks, tõlgenduseks või töötluseks",
          "@language": "et"
        },
        {
          "@value": "mistahes viisil ja mistahes andmekandjale jäädvustatud ning kõikvõimalike (infotehnoloogiliste) vahendite abil edastatav või töödeldav teave",
          "@language": "et"
        }
      ],
