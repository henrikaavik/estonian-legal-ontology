    {
      "@id": "estleg:Concept_laaneranna_vallavalitsuse_ametiasutuse_palgajuhend_t1040865_Tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Töötaja",
      "skos:definition": "vallavalitsusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks. 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040865_Par_3"
        }
      ],
      "estleg:sourceAct": "Lääneranna Vallavalitsuse ametiasutuse palgajuhend",
