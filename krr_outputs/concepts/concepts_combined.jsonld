    {
      "@id": "estleg:Concept_haljastusnouded_projekteerimisel_ja_ehitamisel_rae_vallas_t1054999_raie",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "raie",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puu likvideerimine juurekaelalt; puu tavapärase võra vähendamine rohkem kui 25% võrra; puu mõõtmete vähendamine selliselt, et puu kõrgus jääb kuni 6 m ja puuvõra laius jääb kuni 2 m",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054999_Par_2"
        }
      ],
