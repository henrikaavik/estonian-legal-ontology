      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rekonstrueerimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitusseadustiku § 4 lõike 3 punktide 1–3 kohane hoone põhikonstruktsioonide ja tehnosüsteemide ümberehitamine, mille tulemusena suureneb hoone energiatõhusus ja paraneb sisekliima",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049699_Par_3"
        }
      ],
      "estleg:sourceAct": "Väikeelamute energiatõhususe suurendamise toetuse kasutamise tingimused ja kord",
