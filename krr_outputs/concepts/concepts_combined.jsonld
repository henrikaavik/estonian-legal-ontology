    {
      "@id": "estleg:Concept_lennujaamatasude_arvestamise_metoodika_t1007831_lennujaamatasud",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lennujaamatasud",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasud teenuste eest, mida lennujaama kasutajatele pakub lennujaama haldaja ja mis on seotud õhusõiduki maandumise, õhku tõusmise ja parkimisega, lennujaama valgustamise, reisijate ja kauba käitlemise ning lennundusjulgestusega; 2) kaalutud keskmine kapitali hind ( WACC – Weighted Average Cost of Capital ) – kapitali struktuuri (oma- ja võõrvahendite vahekord kogukapitalis) ning võla- ja omakapitali hinna alusel leitav kogukapitali hind",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1007831_Par_2"
        }
      ],
      "estleg:sourceAct": "Lennujaamatasude arvestamise metoodika",
      "rdfs:label": "lennujaamatasud (lennujaamatasude_arvestamise_metoodika_t1007831)",
