        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "statsionaarne reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaam, mis on paigaldatud spetsiaalselt selleks ehitatud vundamendiga maa või ehituskonstruktsioonidega hoone või rajatise külge",
