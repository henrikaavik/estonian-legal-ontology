      "rdfs:label": "sõidutee täielik sulgemine",
      "skos:definition": [
        {
          "@value": "sõidutee sulgemine selliselt, kus enam kui 50% selle laiusest on suletud, sõltumata suletava teelõigu pikkusest. Sõidutee loetakse täielikult suletuks ka juhul, kui tee mittesuletava osa laius on alla kolme meetri",
          "@language": "et"
        },
        {
          "@value": "sõidutee sulgemine selliselt, et enam kui 90% selle laiusest on suletud, sõltumata suletava teelõigu pikkusest. Sõidutee loetakse täielikult suletuks ka juhul, kui tee mittesuletava osa laius on alla kolme meetri",
          "@language": "et"
        }
      ],
