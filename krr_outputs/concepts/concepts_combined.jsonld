      }
    },
    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1060663_eratee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eratee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tee, mis paikneb juriidilise või füüsilise isiku kinnisasjal ning mis pole avalikult kasutatavaks määratud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060663_Par_2"
        }
      ],
