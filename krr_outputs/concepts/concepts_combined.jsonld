    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_mobiilne_konstruktsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "mobiilne konstruktsioon",
      "skos:definition": "sõiduk või haagis, mis on välireklaami edastamiseks kohandatud ja mille vahendusel välireklaami edastatakse, samuti reklaami eesmärgil spetsiaalselt paigutatud või pargitud sõiduk reklaamkirjadega (soodushinnad, allahindlused, müügikuulutused, üritused, toodete kaubamärgid ja liigid jm). Mobiilne konstruktsioon ei pea olema kantud liiklusregistrisse; 7",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
