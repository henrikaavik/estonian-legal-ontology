    {
      "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooni_kasutamis_t1058898_Ehitis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Ehitis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on inimtegevuse tulemusel loodud ja aluspinnasega ühendatud või sellele toetuv asi, mille kasutamise otstarve, eesmärk, kasutamise viis või kestvus võimaldab seda eristada teistest asjadest. Ehitis on hoone või rajatis. Hoone on väliskeskkonnast katuse ja teiste välispiiretega eraldatud siseruumiga ehitis. Rajatis on ehitis, mis ei ole hoone.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058898_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "Ehitis (laane_nigula_valla_uhisveevargi_ja_kanalisatsiooni_kasutamis_t1058898)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ehitis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
