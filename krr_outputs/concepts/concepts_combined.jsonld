          "@value": "Õppur",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "6 kuni 19 aastane rahvastikuregistri alusel Pärnu linna elanik",
          "@language": "et"
        },
        {
          "@value": "7-19aastane noor, kelle rahvastikuregistrijärgne elukoht on Kambja vald",
          "@language": "et"
        },
        {
          "@value": "Antsla vallas elav noor vanuses 7-19 eluaastat, kes õpib huvikoolis või osaleb huvitegevuses.",
          "@language": "et"
        },
        {
          "@value": "Eesti rahvastikuregistri andmetel alalise elukohaga Setomaa vallas elav 7–19-aastane laps või noor, kes osaleb huvihariduses ja/või huvitegevuses",
          "@language": "et"
        },
        {
          "@value": "huvikoolis või huvitegevuse teenust pakkuva juriidilise isiku juures õppiv isik",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "12",
        "@type": "xsd:integer"
      },
