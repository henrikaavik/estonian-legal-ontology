    {
      "@id": "estleg:Concept_tartu_valla_heakorraeeskiri_t1004440_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omanik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kellele kuulub kinnistatud maatükk. Omanikuna heakorra nõuete täitmisel on võrdsustatud ka omaniku poolt volitatud valdaja, haldaja või kasutaja. Samuti on omanikuks hoonestusõiguse alusel kasutataval maal hoonestusõigust omav isik, ehitise kui vallasasja juurde kuuluval ehitise teenindamiseks vajalikul maal ehitise omanik",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1004440_Par_2"
        }
      ],
      "estleg:sourceAct": "Tartu valla heakorraeeskiri",
      "rdfs:label": "omanik (tartu_valla_heakorraeeskiri_t1004440)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tartu_valla_heakorraeeskiri_t1004440_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistatud maatükk koos selle oluliste osadega. Kinnistu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: maa-ala, territoorium, krunt, maaüksus, katastriüksus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1004440_Par_2"
        }
      ],
