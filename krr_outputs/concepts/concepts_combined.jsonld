      },
      "rdfs:label": "lisateave",
      "skos:definition": [
        {
          "@value": "toote toimimist ja omadusi käsitlev muu teave, mis on seotud seadme energia- või muude oluliste ressursside tarbimisega või aitab seda hinnata mõõdetavate andmete alusel",
          "@language": "et"
        }
      ],
