    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_saaremaa_vallas_t1047226_reovee_kohtkaitlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee kohtkäitlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kogumine, puhastamine või suublasse juhtimine, sealhulgas kuivkäimla sisu kompostimine, mis toimub üldjuhul reovee tekkekoha kinnistu piirides; reovee kohtkäitlusel on välistatud omapuhasti väljavoolu kasutamine tehnoloogilise veena (näiteks kastmiseks, sõidukite pesemiseks vms.)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047226_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri Saaremaa vallas",
      "rdfs:label": "reovee kohtkäitlus (reovee_kohtkaitluse_ja_araveo_eeskiri_saaremaa_vallas_t1047226)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_kohtkaitlus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_saaremaa_vallas_t1047226_reovee_kohtkaitlusrajatis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee kohtkäitlusrajatis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kogumismahuti, omapuhasti või kuivkäimla lampkast",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047226_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri Saaremaa vallas",
