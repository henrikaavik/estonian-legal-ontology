    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "teenistuja",
      "skos:definition": "Tõrva vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040857_Par_3"
        }
      ],
