      "rdfs:label": "teedegrupp",
      "skos:definition": [
        {
          "@value": "loetelu teedest, mis on kehtestatud Viimsi Vallavolikogu määruse „Viimsi valla teede ja tänavate sulgemise maks” lisaga 1.",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
