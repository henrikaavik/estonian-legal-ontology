        "@value": "heakorratööd",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tolmu, liiva, jäätmete, lume, jää ja lemmikloomade väljaheidete koristamine, libedusetõrje teostamine, rohu niitmine ning umbrohutõrje, maha langenud puulehtede, okste ja tuulemurru koristamine, ebaseadusliku grafiti eemaldamine, kuivenduskraavide puhastamine rohust, põõsastest, puudest, jäätmetest, setetest jms",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
