    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_omapuhasti_ehk_kohtpuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti ehk kohtpuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reoveepuhasti, mille suublaks on pinnas või veekogu ja projekteeritud reostuskoormus on kuni 50 inimekivalenti (ie). Omapuhastiks on nii septik koos filtersüsteemiga kui biopuhasti imbväljakuga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "omapuhasti ehk kohtpuhasti (kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835)",
