      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_nouded_tulekahjusignalisatsioonisusteemile_ja_ehitistele_kus_t1009642_adresseeritud_susteem"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "adresseeritud süsteem",
      "skos:definition": [
        {
          "@value": "automaatne tulekahjusignalisatsioonisüsteem, milles teated süsteemi võimalike seisundite kohta edastatakse ja kuvatakse keskseadme monitoril teate tekitanud adresseeritud seadme täpse füüsilise asukoha aadressina: hoone, korrus, ruum, seadme aadress; 3",
          "@language": "et"
        }
      ]
    },
