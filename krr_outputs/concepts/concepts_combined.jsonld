      },
      "rdfs:label": "kliiniline audit",
      "skos:definition": [
        {
          "@value": "tervishoiuteenuste kvaliteedi parandamise protsess organisatsioonis, mille eesmärk on parandada patsientide ravi ja ravitulemusi, hinnates neid süstemaatiliselt kindlate kriteeriumitega ning rakendades vajalikke muudatusi üksikisiku, struktuurüksuse või kogu organisatsiooni tasemel",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
