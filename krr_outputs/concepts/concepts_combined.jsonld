      },
      "skos:definition": {
        "@value": "pealt kinnine väljavooluga reovee mehhaaniline puhasti, kus sadenenud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt. Septikus mehhaaniliselt puhastunud reovesi juhitakse imbsüsteemi, kus toimub selle lõplik puhastamine ja heitveena suublasse juhtimine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052145_Par_2"
        }
      ],
