    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kinnistu",
      "skos:definition": "juriidilise või füüsilise isiku omandis või valduses olev kinnisasi. Kinnistuga on eeskirjas võrdsustatud ka kinnistamata maaüksus, mille suhtes isikul on kasutusõigus; 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
