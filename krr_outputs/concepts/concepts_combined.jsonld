      "rdfs:label": "peamasinate efektiivne koguvõimsus",
      "skos:definition": [
        {
          "@value": "laeva peamasinate nimiväljundvõimsus kilovattides, mis kantakse üle käiturile ja mis on kajastatud laeva registreerimistunnistusel või muus ametlikus dokumendis; 16",
          "@language": "et"
