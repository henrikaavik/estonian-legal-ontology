        "@value": "omapuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk kohtpuhasti on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille ettenähtud reostuskoormus on kuni 50 inimekvivalenti (edaspidi ie)",
        "@language": "et"
      },
