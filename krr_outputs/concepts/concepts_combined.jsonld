    {
      "@id": "estleg:Concept_viimsi_valla_kalmistute_kasutamise_eeskiri_t1058901_kalmistutootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kalmistutöötaja",
        "@language": "et"
      },
      "skos:definition": {
