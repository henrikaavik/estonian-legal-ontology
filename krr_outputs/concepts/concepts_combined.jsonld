    {
      "@id": "estleg:Concept_abja_valla_teede_kasutamise_ja_kaitse_eeskiri_t1003627_tee_kaitsevoond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tee kaitsevöönd",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kohaliku maantee kaitseks, teehoiu korraldamiseks, liiklusohutuse tagamiseks ja teelt lähtuvate ohtlike mõjude vähendamiseks teega külgnevatel maavaldustel väljaspool teemaad rajatud kaitsevöönd ulatusega kakskümmend (20) meetrit kummalegi poole sõiduraja teljest, mille piires kehtivad maaomanikele ja maakasutajatele erinõuded. Teed jagunevad olenevalt pealiskihist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1003627_Par_2"
        }
      ],
      "estleg:sourceAct": "Abja valla teede kasutamise ja kaitse eeskiri",
      "rdfs:label": "tee kaitsevöönd (abja_valla_teede_kasutamise_ja_kaitse_eeskiri_t1003627)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tee_kaitsevoond"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
