          "@id": "estleg:Concept_metsa_uuendamisel_kasutada_lubatud_kultiveerimismaterjali_al_t1035461_perekondade_vanemad"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "perekondade vanemad",
      "skos:definition": [
        {
          "@value": "metsapuu seemnete tootmiseks mõeldud puud, mida kasutatakse järglaskonna saamiseks kontrollitud või vaba tolmlemise teel selliselt, et ühte identifitseeritud vanemat on kasutatud emataimena, mida on tolmeldatud ühe või mitme identifitseeritud või identifitseerimata vanema õietolmuga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
