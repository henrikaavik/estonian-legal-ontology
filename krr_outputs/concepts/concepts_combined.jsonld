    {
      "@id": "estleg:Concept_kose_valla_ametiasutuse_palgajuhend_t1053626_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev isik, kes teostab avalikku võimu. Ametnik nimetatakse ametikohale ja vabastatakse teenistusest avaliku teenistuse seaduse alusel. Ametniku teenistuskohta nimetatakse ametikohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053626_Par_2"
        }
      ],
      "estleg:sourceAct": "Kose valla ametiasutuse palgajuhend",
