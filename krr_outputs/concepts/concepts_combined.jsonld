        {
          "@id": "estleg:Concept_viru_nigula_valla_eelarvest_mittetulundusuhingutele_ja_sihta_t1049670_eelarve"
        },
        {
          "@id": "estleg:Concept_voru_valla_finantsjuhtimise_kord_t1044235_eelarve"
