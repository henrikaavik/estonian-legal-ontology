      "skos:definition": [
        {
          "@value": "rohtkate, rohurinde moodustavad ühe- ja mitmeaastased rohttaimed; 6",
          "@language": "et"
        },
        {
          "@value": "rohu all mõistetakse käesolevas määruses hein- ja murutaimi, rohttaimedest taimkatet; 10",
          "@language": "et"
        },
        {
          "@value": "rohu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: muru, hein, heintaimed, rohttaimed, taimkate ja kulu jms; 17",
          "@language": "et"
        },
        {
          "@value": "rohu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: muru, hein, heintaimed, rohttaimed, taimkate ja kulu jms; 18",
          "@language": "et"
        }
      ]
    },
    {
