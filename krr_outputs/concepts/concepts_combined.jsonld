        },
        {
          "@id": "estleg:Concept_valjaspool_kodu_osutatava_uldhooldusteenuse_korraldamise_ja__t1056739_ulalpidamiskohustusega_isik"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ülalpidamiskohustusega isik",
      "skos:altLabel": [
        {
          "@value": "Ülalpidamiskohustusega isik",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "isik, kellel on tulenevalt perekonnaseadusest ülalpidamiskohustus.",
          "@language": "et"
        },
        {
          "@value": "on perekonnaseaduse mõistes abikaasa, täisealised lapsed, täisealised lapselapsed, vanemad ja vanavanemad; 2",
          "@language": "et"
        },
        {
          "@value": "perekonnaseaduse mõistes seadusjärgne ülalpidaja; 6",
          "@language": "et"
        },
        {
          "@value": "seadusjärgne ülalpidaja perekonnaseaduse § 96 lõike 1 mõistes: teenuse saaja täisealised esimese astme ülanejad ja alanejad sugulased; 12",
          "@language": "et"
        },
        {
          "@value": "teenuse saaja abikaasa, lahuselav abikaasa, lahutatud abikaasa ning teenuse saaja täisealised esimese ja teise astme ülenejad ja alanejad sugulased vastavalt perekonnaseaduse § 16 lg 1 ja lg 3, § 73, § 96 ja § 97. 10",
          "@language": "et"
        }
      ]
    },
    {
