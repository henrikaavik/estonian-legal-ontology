    {
      "@id": "estleg:Concept_vabauhenduste_toetamise_kord_kastre_vallas_t1057934_toetus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toetus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eelarveline eraldis valla arengukavaga kooskõlas oleva mittetulundusliku tegevuse toetamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057934_Par_2"
        }
      ],
      "estleg:sourceAct": "Vabaühenduste toetamise kord Kastre vallas",
