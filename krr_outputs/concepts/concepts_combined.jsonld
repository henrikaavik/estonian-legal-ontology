      ],
      "skos:prefLabel": {
        "@value": "uurimisteema on selgelt piiritletud ja teadusliku põhjendusega kirjeldatud osa uurimisrühma teadus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
