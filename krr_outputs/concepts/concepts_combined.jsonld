      "skos:definition": [
        {
          "@value": "rakendusmeetmes sätestatud nõuetele vastav tootega seotud teavet sisaldav standardtabel.",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tootenaidis",
