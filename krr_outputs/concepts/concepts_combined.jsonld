      },
      "skos:definition": {
        "@value": "sisestab riigihangete registrisse hankemenetlusega seotud informatsiooni ja viib elektroonilises riigihangete registris läbi vastavad menetlusetapid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058651_Par_3"
