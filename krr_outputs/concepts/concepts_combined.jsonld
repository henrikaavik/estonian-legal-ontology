      "skos:definition": {
        "@value": "piirkondade võime luua eeldusi jätkusuutlike töökohtade pakkumiseks, elujõuliste ettevõtete tekkeks ning erainvesteeringute kaasamiseks, samuti võime luua eeldusi piirkonna elanike arvu stabiliseerimiseks või kasvuks ja külastajate arvu suurendamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
