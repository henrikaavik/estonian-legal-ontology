      "skos:definition": [
        {
          "@value": "kanalisatsioonitorustik liitumispunktist kinnistul asuva kontrollkaevuni (hoone vundamendini) või kinnistu kanalisatsioonivõrguni; 12",
          "@language": "et"
        },
        {
          "@value": "kanalisatsioonitorustik liitumispunktist kinnistul asuva kontrollkaevuni (hoone vundamendini) või kinnistu kanalisatsioonivõrguni; 7",
