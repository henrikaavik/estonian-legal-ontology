        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimisteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kohtkäitlussüsteemist reovee äravedu purgimissõidukiga ning selle väljutamine purgimiskohta või vastavasse jäätmete käitlemise kohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054022_Par_2"
        }
      ],
