      ]
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_tehingupartner_voi_tehingupartnerid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "tehingupartner või tehingupartnerid",
      "skos:definition": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingu või -tehingute osapool või -pooled, kellele on omistatud tunnused (tehingupartneri koodid) eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud finantsaruandeid; 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
