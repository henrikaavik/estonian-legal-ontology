        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ühiskasutus",
      "skos:definition": [
        {
          "@value": "õppevara ühine kasutamine mitme haridusasutuse poolt juhul, kui õppevara soetamine igale haridusasutusele ei ole võimalik või mõistlik tulenevalt õppevara kasutussagedusest või maksumusest",
          "@language": "et"
        }
      ],
