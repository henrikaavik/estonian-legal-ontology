        }
      ],
      "skos:definition": [
        {
          "@value": "sotsiaalteenus, mille eesmärk on täisealise isiku iseseisva ja turvalise toimetuleku tagamine kodustes tingimustes, säilitades ja parandades tema elukvaliteeti; 2",
          "@language": "et"
        },
        {
          "@value": "täisealise isiku abistamine kodu ja isikliku eluga seotud igapäevaeluks vajalike toimingute sooritamisel ja asjaajamisel, et tagada isiku iseseisev ja turvaline toimetulek kodustes tingimustes ja väljaspool kodu ning aidata kaasa elukvaliteedi säilitamisele ja parandamisele. 1",
          "@language": "et"
        },
        {
          "@value": "täisealise isiku abistamine kodu ja isikliku eluga seotud igapäevaeluks vajalike toimingute sooritamisel ja asjaajamisel, et tagada isiku iseseisev ja turvaline toimetulek kodustes tingimustes ja väljaspool kodu ning aidata kaasa elukvaliteedi säilitamisele ja parandamisele. 2",
          "@language": "et"
        },
        {
          "@value": "täisealise isiku abistamine kodu ja isikliku eluga seotud igapäevaeluks vajalike toimingute sooritamisel ja asjaajamisel, et tagada isiku iseseisev ja turvaline toimetulek kodustes tingimustes ja väljaspool kodu ning aidata kaasa elukvaliteedi säilitamisele ja parandamisele. 2 (",
          "@language": "et"
        }
      ],
