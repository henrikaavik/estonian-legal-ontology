        {
          "@value": "ala, kuhu võib ulatuda lõhkematerjali hävitamisega kaasnev kahjulik mõju inimestele ja ehitistele nii maismaal kui ka veekogul; 4",
          "@language": "et"
        },
        {
          "@value": "eluohtlik ala, kus viibiv inimene päästetakse või evakueeritakse ning kuhu võib siseneda vaid asjakohast väljaõpet omav ja kaitsemeetmeid kasutav inimene päästetöö juhi antud ülesande täitmiseks; 3",
          "@language": "et"
        }
      ]
    },
