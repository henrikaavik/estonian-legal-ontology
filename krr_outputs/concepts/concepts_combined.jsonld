    {
      "@id": "estleg:Concept_saue_valla_munitsipaallasteaeda_ja_hoidu_vastuvotmise_ja_sea_t1062616_laps",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "laps",
      "skos:definition": "laps, kelle rahvastikuregistrijärgne või tegelik elukoht on Saue vallas. Juhul, kui lapse elukoht ei ole rahvastikuregistri andmetel Saue vallas, esitab vanem või eestkostja Saue Vallavalitsusele selle tõendamiseks vajaliku dokumendi (dokument jagatud vanemluse kohta, asendushooldusteenuse leping vms) ja saab seejärel registris taotluse esitamise õiguse. 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062616_Par_2"
        }
