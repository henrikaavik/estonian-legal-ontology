        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle omandis on kinnistu või vallasasi; omanikuga on võrdsustatud isik, kes õiguslikul alusel asja valdab või kasutab või kes on omaniku poolt volitatud asja haldama. Tegutseva korteriühistu kinnistul tagab eeskirjast tuleneva heakorra nõuete täitmise ühistu. Ühistu puudumisel korraldab heakorratöö elamu haldaja või omanikud omavahelisel kokkuleppel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044299_Par_2"
        }
      ],
      "estleg:sourceAct": "Hiiumaa valla heakorra eeskiri",
      "rdfs:label": "omanik (hiiumaa_valla_heakorra_eeskiri_t1044299)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_hiiumaa_valla_heakorra_eeskiri_t1044299_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maapinna piiritletud osa ehk maatükk) või hoonestusõigus; kinnistu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: maa-ala, territoorium, krunt, maaüksus ja katastriüksus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044299_Par_2"
        }
      ],
      "estleg:sourceAct": "Hiiumaa valla heakorra eeskiri",
