    {
      "@id": "estleg:Concept_tegevusteraapia_teenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Tegevusteraapia teenus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_koduteenuse_osutamise_kord_t1051939_Tegevusteraapia_teenus"
        },
        {
          "@id": "estleg:Concept_valjaspool_kodu_osutatava_uldhooldusteenuse_kord_t1049187_Tegevusteraapia_teenus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Tegevusteraapia teenus",
      "skos:definition": [
        {
          "@value": "häiritud või piiratud tegevusvõimega inimese füüsilise ja psüühilise arengu toetamine ning tegevusvõime säilitamine ja edendamine, et inimene tuleks võimalikult hästi ja iseseisvalt toime oma igapäevaelu toimingutega.",
          "@language": "et"
        },
        {
          "@value": "häiritud või piiratud tegevusvõimega inimese füüsilise ja psüühilise arengu toetamine ning tegevusvõime säilitamine ja edendamine, et toetada isiku võimalikult iseseisvat toimetulekut igapäevaelu toimingutega",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tegevustoetus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tegevustoetus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kogukonna_ja_elukeskkonna_arendamiseks_toetuste_andmise_kord_t1045107_tegevustoetus"
        },
        {
          "@id": "estleg:Concept_maardu_linna_sporditegevuse_toetamise_kord_t1058023_tegevustoetus"
        },
        {
          "@id": "estleg:Concept_kultuuri_spordi_ja_sotsiaalvaldkonnas_tegutsevatele_mittetul_t1051801_tegevustoetus"
        },
        {
          "@id": "estleg:Concept_sporditegevuse_toetamise_kord_t1056997_tegevustoetus"
        },
        {
          "@id": "estleg:Concept_riigieelarvest_muuseumide_tegevustoetuse_taotlemise_taotleja_t1057348_tegevustoetus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tegevustoetus",
      "skos:definition": [
        {
          "@value": "linnaeelarveline eraldis mittetulundusühingutele, seltsingutele või kogukondadele linna arengukavaga ning küla- või asumivanema statuudiga kooskõlas oleva mittetulundusliku tegevuse toetamiseks.",
          "@language": "et"
        },
        {
          "@value": "on taotlemise aastale järgnevaks kalendriaastaks või jooksval aastal Rakvere linnaeelarvest antav toetus toetuse saaja regulaarse tegevusega seotud kulude katmiseks.",
          "@language": "et"
        },
        {
          "@value": "toetus, mis on ette nähtud Maardu linna lastele ja noortele vanuses 7‑19 aastat (erandkorras alates 4. eluaastast) suunatud sporditegevuse korraldamiseks Maardu linnas",
          "@language": "et"
        },
        {
          "@value": "toetus, mis on ette nähtud sporditegevuse korraldamiseks",
          "@language": "et"
        },
        {
          "@value": "toetuseliik, millega toetatakse muuseumi põhitegevust ja arengut tervikuna, eesmärgiga säilitada või tõsta tema võimekust. Tegevustoetuse hulka ei loeta investeeringuid põhivarasse ega muid sihtotstarbelisi toetusi.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
