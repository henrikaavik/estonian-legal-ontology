      },
      "skos:definition": {
        "@value": "ühe või mitme kohaliku omavalitsusüksuse territoorium, samuti külade kogum, linnaosa või linnaosade kogum, mida iseloomustab ühtse keskuse olemasolu või sarnased sotsiaalmajanduslikud või kultuurilised tingimused",
        "@language": "et"
