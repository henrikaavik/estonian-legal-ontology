      "estleg:definesConcept": {
        "@id": "estleg:Concept_reoveekogumisala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_reovesi",
      "@type": [
        "owl:NamedIndividual",
