        "@value": "asendusistutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "raiutud puude asendamine uutega või kui kinnistule ei mahu detailplaneeringu või ehitusprojekti alusel ettenähtud puud objektiivsetel põhjustel samale kinnistule ära ja on vajadus osa puudest istutada teisele kinnistule",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054999_Par_2"
        }
      ],
