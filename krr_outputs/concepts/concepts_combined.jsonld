      ],
      "skos:prefLabel": {
        "@value": "jäätmekäitluskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tehniliselt varustatud ehitis jäätmete kogumiseks, taaskasutamiseks või kõrvaldamiseks, ka maa-ala keskkonnaseisundit või selle kasutusvõimalusi või maa-ala, kus tehakse jäätmete taaskasutamise või kõrvaldamise toiminguid, milleks ehitise olemasolu ei ole vajalik. Jäätmekäitluskohaks ei loeta jäätmekogumisnõu, -konteinerit või muud mahutit, mis on ette nähtud vaid ühte liiki tava-või ohtlike jäätmete esmakogumiseks jäätmetekitajatelt, samuti ehitisi või teisaldatavaid hoiukohti, kuhu eelnimetatud mahutid tavajäätmete kogumiseks on paigaldatud või ehitisi, mida kasutatakse olmes tekkinud pakendijäätmete esmakogumiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmekäitluskoht (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmekaitluskoht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmekaitluskoha_jarelhooldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmekäitluskoha järelhooldus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "suletud jäätmekäitluskoha keskkonnaseire ning võimaliku negatiivse keskkonnamõju, sealhulgas keskkonnahäiringu tõrje",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
