      ],
      "skos:definition": [
        {
          "@value": "elektrooniline kontaktivaba isikustatud andmekandja sõiduõiguse tõendamiseks Harju maakonna ja Tallinna linna avalikel liinidel",
          "@language": "et"
        },
        {
          "@value": "elektrooniline kontaktivaba isikustatud andmekandja sõiduõiguse tõendamiseks Harju maakonna, Tallinna linna ja Saku vallasisestel avalikel liinidel",
          "@language": "et"
        },
        {
          "@value": "kaart, mis annab õiguse sõita avaliku teenindamise lepingute alusel teostatavate maakonna- ja naabermaakonda ühendavatel bussiliinidel.",
          "@language": "et"
        }
      ],
