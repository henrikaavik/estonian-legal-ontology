      "rdfs:label": "huviharidus",
      "skos:altLabel": [
        {
          "@value": "Huviharidus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "pikaajaline süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal. Huviharidust omandatakse huvikooli seaduse alusel tegutsevas huvikoolis ja tugineb õppekavale. 2",
          "@language": "et"
        },
        {
          "@value": "pikaajaline süsteemne juhendatud tegelemine vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal, et omandada süvendatud teadmisi ja oskusi valitud huvialal. Huvihariduse õppekavad registreeritakse Eesti Hariduse Infosüsteemis; 2",
          "@language": "et"
        },
        {
          "@value": "pikaajaline ning õppekavale tuginev süsteemne ja juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest vabal ajal, et omandada teadmised ja oskused valitud valdkonnas; 4",
          "@language": "et"
        },
        {
          "@value": "haridus, mis omandatakse Eesti Hariduse Infosüsteemis (edaspidi EHIS) registreeritud huvikoolis õppekavapõhise õppena vastavalt huvikooli seadusele ja selle alusel kehtestatud huviharidusstandardile; 2",
          "@language": "et"
        },
        {
          "@value": "huvidele vastava õppetöövälise hariduse omandamine õppekava alusel. Teenuse pakkuja peab olema registreeritud Eesti Hariduse Infosüsteemis. 2",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "21",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_huviharidus_ja_huvitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huviharidus ja huvitegevus",
