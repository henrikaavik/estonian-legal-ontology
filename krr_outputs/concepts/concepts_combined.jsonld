      "rdfs:label": "registreerimistunnistus",
      "skos:definition": [
        {
          "@value": "käesoleva määruse lisas 1 toodud vormi kohane väikelaeva registrisse kandmist tõendav dokument, lisas 2 toodud vormi kohane alla 12-meetrise kogupikkusega laeva registrisse kandmist tõendav dokument ja lisas 3 toodud vormi kohane jeti registrisse kandmist tõendav dokument",
          "@language": "et"
        },
        {
          "@value": "lisas 1 toodud vormi kohane sõiduki registreerimist tõendav dokument",
          "@language": "et"
        },
        {
          "@value": "majandus- ja kommunikatsiooniministri 3. märtsi 2011. a määruse nr 19 „Mootorsõiduki ja selle haagise registreerimise tingimused ja kord” lisas 1 toodud vormi kohane sõiduki registreerimist tõendav dokument",
          "@language": "et"
        }
      ],
