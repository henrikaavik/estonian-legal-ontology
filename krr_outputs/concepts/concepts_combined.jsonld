      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elektrienergia netotoodang",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "koostootmisseadmega toodetud elektrienergia kogus, mis ei sisalda omatarvet ja milleks loetakse elektrijaama kõikides liitumispunktides kokku kauplemisperioodi jooksul võrku antud saldeeritud toodang",
        "@language": "et"
      },
      "estleg:definedIn": [
