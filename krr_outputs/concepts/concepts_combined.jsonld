      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_lisatasu_taiendavate_teenistusulesannete_eest"
        }
      ]
    },
    {
      "@id": "estleg:Concept_poltsamaa_valla_ametiasutuse_palgajuhend_t1054343_taiendavad_teenistusulesanded",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "täiendavad teenistusülesanded",
      "skos:definition": "ametijuhendis või õigusaktides fikseerimata ülesandeid, mis oluliselt suurendavad teenistuja töömahtu ja mida talle annab vahetu juht või mille täitmine toimub seaduse alusel; 11",
      "estleg:definedIn": [
