      ],
      "skos:prefLabel": {
        "@value": "andmekaitsealane mõjuhinnang",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kirjeldab isikuandmete töötlemise protsessi ja kuidas tagatakse isikuandmete kaitse, aitab hinnata töötlemisega seotud riske, tuvastada andmekaitsealaseid puudusi ning leida lahendusi puuduste kõrvaldamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
