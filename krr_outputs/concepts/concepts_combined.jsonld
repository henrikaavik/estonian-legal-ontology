      "skos:prefLabel": {
        "@value": "asendustasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lisatasu puuduva teenistuja ülesannete täitmise eest, mida võib määrata ja maksta ajutiselt puuduva teenistuja asendamise või ajutiselt vaba teenistuskoha eest juhul, kui asendamine ei tulene teenistuja ametijuhendist ning kui asendamine toob endaga kaasa teenistuja ametijuhendi tavapäraste töökohustustega võrreldes ettenähtud töökoormuse olulise suurenemise",
        "@language": "et"
      },
