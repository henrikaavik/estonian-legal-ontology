      ],
      "skos:prefLabel": {
        "@value": "reoveepuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kogum kindlate dimensioonidega rajatisi, milles ühiskanalisatsioonivõrgu kaudu või muul käesolevas eeskirjas reguleeritud viisil kogutud reovesi puhastatakse nõnda, et seda võib keskkonda ohustamata loodusesse heita",
