    {
      "@id": "estleg:Concept_poltsamaa_valla_ametiasutuse_palgajuhend_t1054343_asendustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "asendustasu",
      "skos:definition": "tasu puuduva teenistuja ülesannete täitmise eest, kui asendamine ei ole ette nähtud teenistuja ametijuhendis või tingib võrreldes ametijuhendis määratuga töökoormuse olulise suurenemise; 9",
