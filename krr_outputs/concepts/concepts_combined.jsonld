      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "ametnik",
      "skos:definition": "isik, kes on Viljandi linnaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud linnavalitsuses ametikohale, millel teostatakse avalikku võimu; 3",
      "estleg:definedIn": [
