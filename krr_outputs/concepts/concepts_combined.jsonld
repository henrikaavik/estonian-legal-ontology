      "rdfs:label": "teenistuskoht",
      "skos:altLabel": [
        {
          "@value": "Teenistuskoht",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ametiasutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse teenistuskohtade koosseisus ette nähtud ameti- või töökoht",
          "@language": "et"
        },
        {
          "@value": "vallavalitsuse teenistuskohtade koosseisus ette nähtud ameti- või töökoht. Palgajuhendis käsitletakse vallavalitsuse struktuuriüksusena kantseleid ja vallavalitsuse osakondi. Palgajuhendis kasutatakse ametniku palga ja töötaja töötasu ühtse mõistena mõistet palk.",
          "@language": "et"
        },
        {
          "@value": "asutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht",
          "@language": "et"
        },
        {
          "@value": "linnavalitsuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht, sh ametikoht on ametniku teenistuskoht ja töökoht on töötaja teenistuskoht.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "15",
        "@type": "xsd:integer"
      },
