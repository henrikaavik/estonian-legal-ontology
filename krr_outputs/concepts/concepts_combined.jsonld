      "rdfs:label": "probleemtoode",
      "skos:definition": [
        {
          "@value": "toode, mille jäätmed põhjustavad või võivad põhjustada tervise- või keskkonnaohtu, keskkonnahäiringuid või keskkonna ülemäärast risustumist. Probleemtoodete hulka kuuluvad patareid, akud, PCB-sid sisaldavad seadmed, mootorsõidukid ja nende osad, vanarehvid, elektri- ja elektroonikaseadmed ja nende osad; 12",
          "@language": "et"
        }
      ]
