        "@id": "estleg:Concept_sissetulekupiir"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_andmise_kord_t1052751_abi_korraldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "abi korraldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "inimese rahvastikuregistrisse kantud elukoha järgne linnaosa valitsus või õigusaktis sätestatud juhtudel sotsiaal- ja tervishoiuamet.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
