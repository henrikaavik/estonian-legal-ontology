      ]
    },
    {
      "@id": "estleg:Concept_majapidamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "majapidamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toetuse_andmise_kord_maapiirkondades_asuvate_juurdepaasuteed_t1049702_majapidamine"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_kord_maapiirkondades_elavate_perede_elutingi_t1049428_majapidamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "majapidamine",
      "skos:definition": [
        {
          "@value": "elamu koos abihoonetega. Elamu kasutusotstarve peab olema ehitisregistris elamu või sellele peab olema väljastatud ehitusluba elamu ehitamiseks; 6",
          "@language": "et"
        },
        {
          "@value": "elamuna kasutatav hoone koos sinna juurde kuuluvate abihoonetega. Elamuna kasutatava hoone kasutusotstarve peab olema avalikes registrites majandus- ja taristuministri 2. juuni 2015. a määruse nr 51 „Ehitise kasutamise otstarvete loetelu” kohaselt elamu või sellele peab olema väljastatud ehitusluba elamu ehitamiseks või enne 22. juulit 1995. a ehitatud hoonete puhul peab olema tegemist asjaõigusseaduse rakendamise seaduse tähenduses õiguslikul alusel ehitatud ehitisega, mille ettenähtud kasutusotstarve on elamu.",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_makse_on_maksja_voi_saaja_algatatud_sularaha_sisse",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Makse on maksja või saaja algatatud sularaha sisse",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_krediidiasutuste_maksestatistilise_aruandluse_kehtestamine_t1052122_Makse_on_maksja_voi_saaja_algatatud_sularaha_sisse"
        },
        {
          "@id": "estleg:Concept_maksebilansi_koostamiseks_vajalike_andmete_esitamine_t1017615_Makse_on_maksja_voi_saaja_algatatud_sularaha_sisse"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Makse on maksja või saaja algatatud sularaha sisse",
      "skos:definition": [
        {
          "@value": "või väljamakse ja raha ülekanne, sõltumata selle aluseks olevast maksja ja saaja vahelisest õigussuhtest. 2 (",
          "@language": "et"
        },
        {
