          "@id": "estleg:Concept_koduteenuse_osutamise_kord_t1051939_Koduteenus_koduteenuse_osutamise_kord_t1051939_1_1"
        },
        {
          "@id": "estleg:Concept_koduteenuse_osutamise_tingimused_ja_kord_t1050439_koduteenus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Koduteenus",
      "skos:altLabel": [
        {
          "@value": "koduteenus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "täisealise isiku abistamine kodu ja isikliku eluga seotud igapäevaeluks vajalike toimingute sooritamisel ja asjaajamisel, et tagada isiku iseseisev ja turvaline toimetulek kodustes tingimustes ja väljaspool kodu ning aidata kaasa elukvaliteedi säilitamisele ja parandamisele.",
          "@language": "et"
        },
        {
          "@value": "sotsiaalteenus, mille eesmärk on täisealise isiku iseseisva ja turvalise toimetuleku tagamine kodustes tingimustes, säilitades ja parandades tema elukvaliteeti",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_koduteenused"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
