        }
      ]
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_valireklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "välireklaam",
      "skos:definition": "avalikus kohas asuv või avalikust kohast jälgitav reklaam; 2015-12-10 RT IV 2015-12-18 13 418122015013 2015-12-21 12",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
