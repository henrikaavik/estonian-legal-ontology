      },
      "rdfs:label": "raamatupidamise aastaaruanne",
      "skos:definition": [
        {
          "@value": "majandusaasta aruanne, mis koosneb bilansist, tulemiaruandest, rahavoogude aruandest, netovara liikumise aruandest ning lisadest",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
