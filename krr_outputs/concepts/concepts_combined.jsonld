      },
      "rdfs:label": "ehitise omanik",
      "skos:definition": [
        {
          "@value": "füüsiline või juriidiline isik, kelle tellimusel ehitustöid tehakse; 6",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_ehitise_sugavus",
