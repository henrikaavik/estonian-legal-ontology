    {
      "@id": "estleg:Concept_pohiprojekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhiprojekt",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_covid_19_kriisist_tuleneva_korterelamute_rekonstrueerimise_t_t1049605_pohiprojekt"
        },
        {
          "@id": "estleg:Concept_ida_virumaa_korterelamute_energiatohususe_toetuse_tingimused_t1059481_pohiprojekt"
        },
        {
          "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_pohiprojekt"
        },
        {
          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetamine_t1053122_pohiprojekt"
        },
        {
          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetuse_andmise_tingimused_j_t1046780_pohiprojekt"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "põhiprojekt",
      "skos:definition": [
        {
          "@value": "korterelamu rekonstrueerimiseks vajalik ehitusprojekt, mis on koostatud ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuete, standardi EVS 932 või samaväärsete nõuete ja määruse nõuete kohaselt. Korteriühistu võib põhiprojekti koostamisse kaasata arhitektuurse osa koostaja, kellel peab olema vähemalt volitatud arhitekti kutse 7. tase. Arhitektuurse osa koostamine tähendab, et arhitekt peab olema kaasatud ja koostama vähemalt ühe osa ehitusprojektist; 9",
          "@language": "et"
        },
        {
          "@value": "korterelamu rekonstrueerimiseks vajalik ehitusprojekt, mis on koostatud vastavalt ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuetele, standardi EVS 932 või samaväärsetele nõuetele ja käesoleva määruse nõuetele; RT I 2024-04-25 8 125042024008 2024-04-28 8",
          "@language": "et"
        },
        {
          "@value": "korterelamu rekonstrueerimiseks vajalik ehitusprojekt, mis on koostatud vastavalt ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuetele, standardi EVS 932 või samaväärsetele nõuetele ja määruse nõuetele ning mille arhitektuuri osa koostaja peab omama vähemalt volitatud arhitekti kutse 7. taset; 11",
          "@language": "et"
        },
        {
          "@value": "korterelamu rekonstrueerimiseks vajalik ehitusprojekt, mis on koostatud vastavalt ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuetele, standardi EVS 932:2017 või samaväärsetele nõuetele ja käesoleva määruse nõuetele; 8",
          "@language": "et"
        },
        {
          "@value": "korterelamu rekonstrueerimiseks vajalik ehitusprojekt, mis on koostatud vastavalt ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuetele, standardi EVS 932:2017 või samaväärsetele nõuetele ja käesoleva määruse nõuetele; 9",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_pohiprojekti_ekspertiis",
