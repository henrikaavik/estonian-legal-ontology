      "rdfs:label": "asendustasu",
      "skos:altLabel": [
        {
          "@value": "Asendustasu",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "puuduva teenistuja ülesannete täitmise eest makstav lisatasu, mida makstakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, juhul kui asendamine ei ole ettenähtud teenistuja ametijuhendis",
          "@language": "et"
        },
        {
          "@value": "puuduva teenistuja ülesannete täitmise eest makstav lisatasu, mida makstakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, kui asendamine ei ole ette nähtud teenistuja ametijuhendis või töölepingus",
          "@language": "et"
        },
        {
          "@value": "tasu puuduva teenistuja ülesannete täitmise eest, kui asendamine ei ole ette nähtud teenistuja ametijuhendis või tingib võrreldes ametijuhendis määratuga töökoormuse olulise suurenemise",
          "@language": "et"
        },
        {
          "@value": "lisatasu puuduva teenistuja ülesannete täitmise eest, mida võib määrata ja maksta ajutiselt puuduva teenistuja asendamise või ajutiselt vaba teenistuskoha eest juhul, kui asendamine ei tulene teenistuja ametijuhendist ning kui asendamine toob endaga kaasa teenistuja ametijuhendi tavapäraste töökohustustega võrreldes ettenähtud töökoormuse olulise suurenemise",
          "@language": "et"
        },
        {
          "@value": "lisatasu, mida makstakse ajutiselt äraoleva teenistuja või ajutiselt vaba teenistuskoha ülesannete täitmise eest, kui asendamine ei ole ette nähtud teenistuja ametijuhendis või töölepingus või juhul kui asendamine tingiks võrreldes ametijuhendis ettenähtuga töökoormuse olulise suurenemise",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "14",
        "@type": "xsd:integer"
      },
