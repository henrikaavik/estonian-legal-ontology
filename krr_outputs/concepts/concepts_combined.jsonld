      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "humanitaarabi",
      "skos:definition": [
        {
          "@value": "arenguriigile antav kiireloomuline rahaline või esemeline abi või oskusteave või tegevus, mille eesmärk on loodusõnnetusest, kliimamuutusest või inimtegevusest põhjustatud katastroofi ajal või selle järel päästa inimelusid, vähendada inimeste kannatusi ja tagada inimväärseks eluks hädavajalik; samuti abi, mille eesmärk on nimetatud olukorda ennetada ja parandada valmisolekut sellele reageerimiseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvide_konflikt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
