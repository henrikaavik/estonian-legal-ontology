          "@id": "estleg:Concept_johvi_valla_infoturvapoliitika_t1058728_isikuandmed"
        },
        {
          "@id": "estleg:Concept_jalgimisseadmestiku_paigaldamise_kasutamise_ning_andmete_too_t1053791_isikuandmed"
        },
        {
          "@id": "estleg:Concept_jalgimisseadmestiku_paigaldamise_kasutamise_ning_andmete_too_t1060748_isikuandmed"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "isikuandmed",
      "skos:definition": [
        {
          "@value": "igasugune teave tuvastatud või tuvastatava füüsilise isiku („andmesubjekti“) kohta; tuvastatav füüsiline isik on isik, keda saab otseselt või kaudselt tuvastada, eelkõige sellise identifitseerimistunnuse põhjal nagu nimi, isikukood, asukohateave, võrguidentifikaator või selle füüsilise isiku ühe või mitme füüsilise, füsioloogilise, geneetilise, vaimse, majandusliku, kultuurilise või sotsiaalse tunnuse põhjal",
          "@language": "et"
        },
        {
          "@value": "isikuandmeteks on sellised andmed, mille kaudu on võimalik konkreetset füüsilist isikut otseselt või kaudselt tuvastada",
          "@language": "et"
        },
        {
          "@value": "kõik andmed füüsilise isiku kohta, mille alusel on isiku tuvastamine otseselt või kaudselt võimalik, sõltumata sellest, millisel kujul või millises vormis need andmed on",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_isikuandmete_tootlemine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "isikuandmete töötlemine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
