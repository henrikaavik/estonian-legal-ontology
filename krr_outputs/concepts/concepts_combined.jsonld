    {
      "@id": "estleg:Concept_taastuvenergia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taastuvenergia",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_elektriauto_laadimispunktide_rajamise_toetamise_tingimused_j_t1061561_taastuvenergia"
        },
        {
          "@id": "estleg:Concept_elektribusside_transpordisektoris_kasutuselevotu_toetamise_t_t1050819_taastuvenergia"
        },
        {
          "@id": "estleg:Concept_rohelise_investeerimisskeemi_korterelamute_rekonstrueerimise_t345791_taastuvenergia"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_energiasalvestuse_pilootp_t1055298_taastuvenergia"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_rohevesiniku_kasutuselevo_t1052247_taastuvenergia"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_rohevesiniku_kasutuselevo_t1055698_taastuvenergia"
        },
        {
          "@id": "estleg:Concept_vaikeelamute_rekonstrueerimise_toetamine_t1058695_taastuvenergia"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "taastuvenergia",
      "skos:definition": [
        {
          "@value": "energia mittefossiilsetest allikatest, s.o. tuule-, päikese-, laine-, hüdro- ja hoovuste energia; õhu-, vee- ja maasoojus; bioenergia; prügila- ja reoveepuhastigaasid",
          "@language": "et"
        },
        {
          "@value": "energia, mille allikas on vesi, tuul, päike, laine, tõus-mõõn, maasoojus, prügilagaas, heitvee puhastamisel eralduv gaas, biogaas või biomass",
          "@language": "et"
        },
        {
          "@value": "energia, mis on täielikult pärit veest, tuulest, päikesest, lainetest, loodetest, maasoojusest, prügilagaasist, heitvee puhastamisel eralduvast gaasist, biomassist või sellest toodetud kütustest",
          "@language": "et"
        },
        {
          "@value": "taastuvatest energiaallikatest saadud energia",
          "@language": "et"
        },
        {
          "@value": "taastuvatest energiaallikatest saadud energia elektrituruseaduse § 57 mõistes",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_taastuvenergia_allikad",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taastuvenergia allikad",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_ettevotja_varustuskindluse_toetuse_tingimused_ja_kord_t1056746_taastuvenergia_allikad"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "taastuvenergia allikad",
      "skos:definition": [
        {
          "@value": "taastuvatest mittefossiilsetest allikatest pärit energia, nimelt tuuleenergia, päikeseenergia (päikese soojusenergia ja fotogalvaaniline päikeseenergia), geotermiline energia, ümbritseva keskkonna energia, loodete, lainete ja muu ookeanienergia, hüdroenergia ning biomassist, prügilagaasist, reoveepuhasti gaasist ja biogaasist toodetud energia",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_taastuvenergia_tootmisseade",
