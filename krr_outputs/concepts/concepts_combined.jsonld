      },
      "rdfs:label": "riiklik tasand on telefoni",
      "skos:definition": [
        {
          "@value": "või mobiiltelefonivõrgu sidumispunkt, mis on ühendatud sidumist pakkuva või sidumiseks kohustatud sideettevõtja telefonijaamaga ja mille kaudu on juurdepääs kõikidele selle sideettevõtja lõppkasutajatele; 13",
          "@language": "et"
        }
      ]
    },
    {
