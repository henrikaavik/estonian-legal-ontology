      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Lahtekoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Lähtekoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tellimuses näidatud aadress, kust klient sõitu alustab.",
