        "@id": "estleg:Concept_jaatmekaitleja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toila_valla_jaatmehoolduseeskiri_t1056448_jaatmejaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmejaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "spetsiaalselt rajatud, tehniliselt varustatud jäätmekäitluskoht, kuhu on paigutatud taaskasutatavate jäätmete kogumiseks ja taaskasutustoiminguks kogumismahutid, sh ohtlike jäätmete kogumismahutid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056448_Par_3"
        }
      ],
      "estleg:sourceAct": "Toila valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmejaam (toila_valla_jaatmehoolduseeskiri_t1056448)",
