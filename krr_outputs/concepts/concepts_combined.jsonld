      },
      "rdfs:label": "pedagoog",
      "skos:definition": [
        {
          "@value": "Viimsi valla üldhariduskoolides, lasteaedades, lastehoidudes või huvikoolides pedagoogina töötav või pedagoogilist ülesannet täitev isik",
          "@language": "et"
        }
      ],
