      "skos:definition": [
        {
          "@value": "ilmastikuolud, mille puhul esineb vähemalt üks järgmistest asjaoludest: katkematu lumesadu, mille jooksul sajab vähemalt 10 cm lund nelja tunni jooksul; lumesadu, mille jooksul sajab vähemalt 5 cm lund nelja tunni jooksul ja samal ajal esineb tuulepuhanguid üle 12 m/s; muu ilmastikuoludest tingitud olukord, mille tõttu on väga raske tagada tee vastavust seisundinõuetele; 10",
          "@language": "et"
        },
        {
          "@value": "olukord, kus intensiivne lumesadu, tuisk, tugev tuul või muud ilmastikutingimused muudavad lumetõrje ajutiselt ebamõistlikuks või ohtlikuks ning takistavad tööde tõhusat teostamist; 7",
          "@language": "et"
        }
      ]
    },
