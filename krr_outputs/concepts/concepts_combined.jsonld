    {
      "@id": "estleg:Concept_mustvee_valla_avalikuks_kasutamiseks_maaramata_erateedel_lum_t1062768_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "tee",
      "skos:definition": "lumetõrje mõttes teelõik, mis vastab vähemalt ühele järgmistest tingimustest: tee on registreeritud Eesti Teeregistris või kantud Eesti põhikaardi teekihile kui lineaarne teeobjekt; tee on füüsiliselt rajatud, mille kattematerjaliks kruus-, killustik-, bituumen- või asfaltkate ning tagab ühenduse avaliku teega; tee on äsja ehitatud ja veel registritesse või põhikaardile kandmata, kuid on füüsiliselt eristatav teekoridorina või vald on teadlik tee rajamisest (projekti, ehitusteatise, akti või muu kinnitus) ja seda kasutatakse regulaarseks juurdepääsuks hoonetele või kinnistutele; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062768_Par_2"
        }
      ],
      "estleg:sourceAct": "Mustvee valla avalikuks kasutamiseks määramata erateedel lumetõrje teostamise kord",
      "rdfs:label": "tee (mustvee_valla_avalikuks_kasutamiseks_maaramata_erateedel_lum_t1062768)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tee"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_tee"
        }
      ]
    },
