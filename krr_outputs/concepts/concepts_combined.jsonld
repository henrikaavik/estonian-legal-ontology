        {
          "@value": "Saue Vallavalitsuse tellimusel töötav ühistranspordi liin mille liinilepingu pikkus ei ületa 12 kalendrikuud ning liinilepingu on vedajaga sõlminud Saue Vallavalitsus.",
          "@language": "et"
        }
      ],
