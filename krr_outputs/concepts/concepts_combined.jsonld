        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "illegaalne graffiti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "omaniku ja vallavalitsuse loata hoone seinale, müürile, piirdeaiale, pingile, kõnniteele, ühissõiduki peatuse ootekojale, kommunikatsiooni ehitisele ning ühistranspordisõidukitele vms kantud kritseldused ja joonistused; 11) tuleohtlik aeg Päästeameti peadirektori käskkirjas sätestatud periood, mil keelatakse küttekoldevälise tule tegemine",
        "@language": "et"
      },
      "estleg:definedIn": [
