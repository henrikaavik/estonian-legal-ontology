        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eutanaasia",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "looma hukkamine looma omaniku algatusel või kaastundest, kui ellujäämine tekitaks loomale kestvaid kannatusi või kui tema liigiomane eluviis osutub võimatuks. Looma eutanaasia viib läbi veterinaararst.",
        "@language": "et"
      },
      "estleg:definedIn": [
