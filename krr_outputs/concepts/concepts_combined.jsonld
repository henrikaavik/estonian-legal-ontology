      "rdfs:label": "purgla",
      "skos:definition": [
        {
          "@value": "kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas määratud ametlik reovee ja fekaalide ühiskanalisatsiooni juhtimise koht; 18) purgimissõiduk (edaspidi sõiduk) – mahutiga sõiduk, mille abil tühjendatakse reovee kohtkäitlusrajatis reoveest või -settest ning mis viib selle purgimissõlme",
          "@language": "et"
        }
      ],
