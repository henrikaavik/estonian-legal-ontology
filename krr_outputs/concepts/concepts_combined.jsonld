      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringile kasutamiseks antud või määratlemata isikute kasutuses olev avalikkusele juurdepääsetav maa-ala, ehitis, ruum või selle osa, samuti ühissõiduk",
        "@language": "et"
      },
      "estleg:definedIn": [
