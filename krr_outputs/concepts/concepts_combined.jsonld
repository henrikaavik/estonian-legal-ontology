        "@id": "estleg:Concept_riigihange"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_valla_hankekord_t1058651_lihthange",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lihthange",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hange, mille eeldatav maksumus on võrdne või suurem RHS § 14 lõikes 1 nimetatud piirmääraga, kuid jääb alla RHS § 14 lõikes 2 sätestatud piirmäära",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058651_Par_3"
        }
      ],
      "estleg:sourceAct": "Vormsi valla hankekord",
