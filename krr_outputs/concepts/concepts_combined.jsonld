      ],
      "skos:prefLabel": {
        "@value": "inimekvivalent",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühe inimese põhjustatud keskmine ööpäevane tingliku reostuskoormuse ühik (ie)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051019_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja valla reovee kohtkäitluse ja äraveo eeskiri",
