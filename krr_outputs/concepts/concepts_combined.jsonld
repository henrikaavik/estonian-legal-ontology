      },
      "rdfs:label": "avalikult kasutatav tee",
      "skos:altLabel": [
        {
          "@value": "Avalikult kasutatav tee",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "avalik tee ning eratee, mis on määratud avalikuks kasutamiseks, st tee, mis on kasutatav igaühe poolt",
          "@language": "et"
        },
        {
          "@value": "riigitee, kohalik tee ja avalikuks kasutamiseks määratud eratee. Avalikult kasutatavat teed võib kasutada igaüks õigusaktides sätestatud piiranguid järgides",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku tähenduses",
          "@language": "et"
        },
        {
          "@value": "riigimaantee, kohalik tee, üldiseks või kohalikuks liiklemiseks",
          "@language": "et"
        },
        {
          "@value": "riigimaantee, kohalik tee, üldiseks või kohalikuks liiklemiseks ettenähtud avalikult kasutatav eratee ja muu rajatis teeseaduse § 2 mõistes",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
