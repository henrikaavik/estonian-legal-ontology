    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049815_kohtkaitlussusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kohtkäitlussüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis või üksteisega seotud rajatiste komplekt, mida kasutatakse reovee ja käimlajäätmete kogumiseks, puhastamiseks ja/või suublasse juhtimiseks, sh maapinda immutamiseks; 4) omapuhasti (sh imbsüsteem) - rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti (edaspidi ie)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049815_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "kohtkäitlussüsteem (reovee_kohtkaitluse_ja_araveo_eeskiri_t1049815)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kohtkaitlussusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049815_purgimine",
