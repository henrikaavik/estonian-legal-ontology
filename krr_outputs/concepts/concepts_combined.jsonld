        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pakendijäätmed",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_joelahtme_valla_jaatmehoolduseeskiri_t1053601_pakendijaatmed"
        },
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pakendijaatmed"
        },
        {
          "@id": "estleg:Concept_rapina_valla_jaatmehoolduseeskiri_t1057272_pakendijaatmed"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "pakendijäätmed",
      "skos:definition": [
        {
          "@value": "mis tahes pakend või pakendimaterjal, mis muutub pärast pakendi kasutamist jäätmeteks",
          "@language": "et"
        },
        {
          "@value": "mistahes pakend või pakendimaterjal, mis muutub pärast pakendi kasutamist jäätmeteks käesoleva eeskirja § 2 lg 2 p.5 mõistes. Pakendijäätmeteks ei loeta pakendi ja pakendimaterjali tootmisel tekkinud jääke",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_pakendijaatmete_kogumissusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pakendijäätmete kogumissüsteem",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pakendijaatmete_kogumissusteem"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "pakendijäätmete kogumissüsteem",
      "skos:definition": [
        {
          "@value": "pakendiettevõtjate korraldatud pakendijäätmete kogumise süsteem, mis hõlmab kõiki Eesti Vabariigis turule lastud kaupade pakenditest tekkinud pakendijäätmeid, olenemata sellest, kas need on tekitatud tööstuses, kaubandustegevuses, olmes, ametiasutuses või mujal ning olenemata kasutatud materjalidest",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
