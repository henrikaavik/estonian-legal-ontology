        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sademevee kogumise süsteem",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_korteriuhistute_toetamise_kord_uus_elu_sinu_hoovile_t1056426_Sademevee_kogumise_susteem"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Sademevee kogumise süsteem",
      "skos:definition": [
        {
          "@value": "lokaalne või ühiskanalisatsiooniga liidetud süsteem, mille abil tagatakse õuealal sademevee kogumise ja sademevee õuealalt ärajuhtimise.",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_sademevee_arajuhtimise_leping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sademevee ärajuhtimise leping",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_paide_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_k_t1043354_sademevee_arajuhtimise_leping"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sademevee ärajuhtimise leping",
      "skos:definition": [
        {
          "@value": "sademeveekanalisatsiooni omaniku ja kinnistuomaniku vahel sõlmitud leping sademe- ja drenaaživee ning pinna- ja pinnasevee ärajuhtimise teenuse osutamiseks; 31",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_sademeveekanalisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sademeveekanalisatsioon",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kohila_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eesk_t1061205_sademeveekanalisatsioon"
        },
        {
          "@id": "estleg:Concept_maardu_linna_uhisveevargi_ja_kanalisatsiooni_liitumise_ning__t1063268_sademeveekanalisatsioon"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sademeveekanalisatsioon",
      "skos:definition": [
        {
          "@value": "rajatised ainult sademe-, drenaaži- ja pinnase- ja pinnavee kanaliseerimiseks ja ärajuhtimiseks; 13",
          "@language": "et"
        },
        {
          "@value": "rajatiste, sealhulgas kraavituste ja seadmete süsteem sademevee ärajuhtimiseks; 19",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
