      "estleg:definesConcept": {
        "@id": "estleg:Concept_valtimatu_sotsiaalabi"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_andmise_kord_t1052751_sissetulekupiir",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sissetulekupiir",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rahasumma, mis peab inimesele või perekonnale jääma elamiseks kätte vastavalt käesolevas määruses sätestatud tingimustele pärast rahvastikuregistrisse kantud eluasemega seotud kulude katmist. Sissetulekupiiri suurus kehtestatakse Tallinna Linnavalitsuse määrusega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052751_Par_3"
        }
      ],
      "estleg:sourceAct": "Sotsiaalhoolekandelise abi andmise kord",
