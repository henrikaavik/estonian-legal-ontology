    {
      "@id": "estleg:Concept_kiili_valla_heakorraeeskiri_t1052603_Romusoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Romusõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "romusõiduk jäätmeseaduse § 26 3 lg 5 tähenduses on sõiduk, mis ei ole komplektne, millel puuduvad varem selle komplektis olnud materjalimahukuselt või tehniliselt olulised osad, nagu kere, sild, mootor, käigukast, katalüsaator, elektrooniline juhtplokk või muud osad, mis takistavad sõiduki liikluses osalemist.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052603_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla heakorraeeskiri",
      "rdfs:label": "Romusõiduk (kiili_valla_heakorraeeskiri_t1052603)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_romusoiduk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_jaatmevedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevedaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenuste kontsessiooni või teenuste riigihanke korras valitud isik, kes osutab jäätmevaldajatele korraldatud jäätmeveo teenust kindlaksmääratud jäätmeliikide osas ja jäätmeveopiirkonnas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059124_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevedaja (kiili_valla_jaatmehoolduseeskiri_t1059124)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevedaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_jaatmevaldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevaldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu- või äriruum",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059124_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevaldaja (kiili_valla_jaatmehoolduseeskiri_t1059124)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevaldaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_jaatmekaitleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmekäitleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidiline või füüsiline isik, kes kogub, veab, taaskasutab või kõrvaldab jäätmeid majandus- või kutsetegevusena ja kellel on selleks tegevuseks vastav keskkonnakaitseluba",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059124_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmekäitleja (kiili_valla_jaatmehoolduseeskiri_t1059124)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmekaitleja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_jaatmejaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmejaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "spetsiaalselt rajatud, tehniliselt varustatud jäätmekäitluskoht, kuhu on paigutatud taaskasutatavate jäätmete kogumiseks ja taaskasutustoiminguks kogumismahutid, sh ohtlike jäätmete kogumismahutid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059124_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmejaam (kiili_valla_jaatmehoolduseeskiri_t1059124)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmejaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_hankija",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hankija",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallavalitsuse või vallavolikogu volitatud juriidiline isik, kes vastab jäätmeseaduse nõuetele; 7) jäätmeveopiirkond (edaspidi piirkond) – eeskirjaga kindlaksmääratud ala, kust kohaliku omavalitsuse üksuse korraldatud jäätmeveoga hõlmatud jäätmed kokku kogutakse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059124_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla jäätmehoolduseeskiri",
      "rdfs:label": "hankija (kiili_valla_jaatmehoolduseeskiri_t1059124)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hankija"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_jaatmekaitlusleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmekäitlusleping",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmevaldaja ja jäätmekäitleja vahel sõlmitav kahepoolne leping, millega jäätmekäitleja võtab endale jäätmete osalise või täieliku käitlemise kohustuse ning millega jäätmekäitleja muutub jäätmevaldajaks pärast seda, kui jäätmevaldaja on jäätmed üle andnud, kui leping ei näe ette teisiti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059124_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmekäitlusleping (kiili_valla_jaatmehoolduseeskiri_t1059124)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmekaitlusleping"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_tiheasustusala_ja_hajaasustusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tiheasustusala ja hajaasustusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on valla üldplaneeringuga määratud valla territooriumi osad. Tiheasustusala hulka kuulub lisaks ka Mõisaküla tänava, Väljamäe tee, Väljamäe põik ja Kanuti tänava järgi adresseeritud katastriüksused; 10) kogumispunkt on üldkasutatavas kohas paiknev vastavalt märgistatud jäätmete kogumismahuti või mahutid või jäätmete kogumisringi peatuskoht, kuhu saab viia liigiti kogutud jäätmeid. Käesoleva paragrahvi lõikes 1 nimetamata mõiste kasutamisel lähtutakse jäätmeseaduses, pakendiseaduses ja teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest. Elamu ja mitteelamu määratlemisel lähtutakse Majandus- ja taristuministri 02.06.2015 määruse nr 51 „Ehitise kasutamise otstarvete loetelu“ lisas sätestatust.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059124_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla jäätmehoolduseeskiri",
      "rdfs:label": "tiheasustusala ja hajaasustusala (kiili_valla_jaatmehoolduseeskiri_t1059124)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tiheasustusala_ja_hajaasustusala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_valla_koerte_kasside_ja_teiste_lemmikloomade_pidamise_t1006928_looma_suhtes_lubamatu_tegu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "looma suhtes lubamatu tegu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "looma hukkumist, vigastamist või talle valu ja välditavaid füüsilisi ja vaimseid kannatusi põhjustav tegu, nagu looma sundimine talle üle jõu käivatele pingutustele, loomavõitluse korraldamine, looma hülgamine või abitusse seisundisse jätmine, loomale kannatusi põhjustav aretustegevus ja muu sarnaste tagajärgedega tegu, mis ei ole tingitud looma ravimisest, muust veterinaarsest menetlusest ega hädaolukorrast, välja arvatud Loomakaitseseaduses ettenähtud juhud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1006928_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla koerte, kasside ja teiste lemmikloomade pidamise eeskiri",
      "rdfs:label": "looma suhtes lubamatu tegu (kiili_valla_koerte_kasside_ja_teiste_lemmikloomade_pidamise__t1006928)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_looma_suhtes_lubamatu_tegu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
