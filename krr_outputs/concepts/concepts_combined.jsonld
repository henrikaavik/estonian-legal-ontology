        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "arvestusperiood",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "veevarustuse ja/või reovee ärajuhtimise teenuse osutamise periood, mille kohta teenuse tarbijale esitatakse nõue tarbitud teenuste tasumiseks. Arvestusperioodiks on üldjuhul kalendrikuu. Arvestusperioodi täpne alguse ja lõppkuupäev, samuti muu arvestusperiood võib olla kehtestatud veevarustuse ja/või reovee ärajuhtimise teenuse osutamise lepingus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1022773_Par_2"
        }
      ],
