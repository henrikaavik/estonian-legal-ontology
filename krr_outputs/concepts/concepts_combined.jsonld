      ],
      "skos:prefLabel": {
        "@value": "volitatud isik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes Saue linnavolikogu otsusega on volitatud kontrollima ühisveevärgi ja -kanalisatsiooni seaduse § 5 lõikes 3 ja §11 lõigetes 2 ja 3 sätestatud nõuete täitmist.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1036784_Par_2"
        }
      ],
