        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "suletav ala",
      "skos:definition": [
        {
          "@value": "tee, teelõik, parkla või väljak, mille täielikku või osalist sulgemist sulgemisloa taotleja taotleb ja mis suletakse sulgemisloa alusel",
          "@language": "et"
        },
        {
          "@value": "Tallinna linna omandis olev avalikult kasutatav tee, teelõik, parkla või väljak, mille täielikku või osalist sulgemist sulgemisloa taotleja taotleb ja mis suletakse sulgemisloa alusel",
