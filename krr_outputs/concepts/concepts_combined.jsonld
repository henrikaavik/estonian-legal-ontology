      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "romusõiduk",
      "skos:definition": "sõiduk, millele puuduvad selle mehaanilised osad või kereosad või autoklaasid või rattad ja mis oma välimusega riivad ümbruskonna esteetilist väljanägemist või rikub ümbruskonna puhtust ja heakorda; 12",
      "estleg:definedIn": [
