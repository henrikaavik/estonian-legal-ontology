    },
    {
      "@id": "estleg:Concept_vabauhenduste_toetamise_kord_kastre_vallas_t1057934_taotleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taotleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "mittetulundusühing, sihtasutus, seltsing või eraisik, kes taotleb käesoleva korra alusel toetust; 3) hindamiskomisjon (edaspidi komisjon) - vallavalitsuse korraldusega üheks kalendriaastaks kinnitatud kolmeliikmeline vabaühenduste toetuste taotluste hindamiseks moodustatud komisjoni. Komisjoni hulgas on üks Kastre Vallavolikogu kultuuri- ja spordikomisjoni liige ja 2 vallavalitsuse haridus- ja kultuuriosakonna liiget. Komisjoni liige ei tohi kuuluda Kastre Vallavolikokku. Huvide konflikti vältimiseks ei saa hindamiskomisjoni liige hinnata projekti, millega ta ise seotud on. Huvide konfliktist peab hindamiskomisjoni liige ise komisjoni teavitama. 4) hindamiskriteerium- kokkulepitud aluspõhimõte, mille alusel hinnatakse taotluse vastavust toetuse eesmärkidele ja tingimustele.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057934_Par_2"
        }
      ],
      "estleg:sourceAct": "Vabaühenduste toetamise kord Kastre vallas",
      "rdfs:label": "taotleja (vabauhenduste_toetamise_kord_kastre_vallas_t1057934)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_taotleja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
