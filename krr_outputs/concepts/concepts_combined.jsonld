      "skos:definition": [
        {
          "@value": "omapuhasti, mille kaudu majapidamise reovesi immutatakse pinnasesse",
          "@language": "et"
        },
        {
          "@value": "omapuhasti osa, kus ehitatud pinnasefiltersüsteemis toimub reovee bioloogiline puhastamine pinnaseosakestele tekkivas biokiles elavate mikroorganismide poolt",
          "@language": "et"
        },
        {
          "@value": "omapuhasti osa, mille kaudu heitvesi immutatakse hajutatult pinnasesse",
          "@language": "et"
        },
        {
          "@value": "omapuhasti, mille kaudu majapidamise reovesi immutatakse pinnassesse",
          "@language": "et"
        },
        {
          "@value": "omapuhasti osa, mille kaudu majapidamise reovesi immutatakse pinnasesse",
          "@language": "et"
        }
      ],
