    {
      "@id": "estleg:Concept_avalik_rajatis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik rajatis",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_ulesannete_jaotus_planeerimisel_ja_avalike_rajatiste_valjaeh_t1059110_avalik_rajatis"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "avalik rajatis",
      "skos:definition": [
        {
          "@value": "detailplaneeringukohane (planeeringualal asuv) ning planeeringulahenduse elluviimiseks otseselt vajalik (planeeringualast väljapool asuv) avalikuks kasutamiseks ette nähtud rajatis (sõidutee, jalg- või jalgrattatee ning sellega seotud rajatised, tänavavalgustus, haljastus, maaparandussüsteem, sademeveesüsteem, spordi- või puhkerajatis, sh mänguväljak).",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_avalik_ruum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik ruum",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_avalik_ruum"
        },
        {
          "@id": "estleg:Concept_saaremaa_valla_heakorra_eeskiri_t1048851_avalik_ruum"
        },
        {
          "@id": "estleg:Concept_vormsi_valla_heakorra_ja_kaevetoode_eeskiri_t1059297_avalik_ruum"
        },
        {
          "@id": "estleg:Concept_riigisaladuse_ja_salastatud_valisteabe_kaitse_kord_t317593_avalik_ruum"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "avalik ruum",
      "skos:definition": [
        {
          "@value": "ala, mis ei ole turva- ega administratiivala",
          "@language": "et"
        },
        {
          "@value": "detailplaneeringuga määratud avalikult kasutatavad teed (sh tee materjalist tõstetud künnised, ümberkeeramis koht - minimaalsuurusega 12x12 meetrit), valgustatud kergliiklusteed, liikluskorralduslik parkimislahendus, üldkasutatav haljasala, jäätmete liigiti kogumise plats (valgustatud ja liikluskorralduslikult lihtsa ligipääsuga ~ 30 m2 ala), mänguväljakud (sisaldades erivanuses kasutajate mänguvahendeid) ja heakorraelemendid jms.",
          "@language": "et"
        },
        {
          "@value": "igaühele, ligipääsetav ja piiranguteta kasutatav ruum (teed, haljasalad, bussipeatused), samuti poolavalik ruum, mille kasutamine võib olla tingitud ajast, loast jms (asutuste territooriumid, õuealad, rannad jne).",
          "@language": "et"
        },
        {
          "@value": "määratlemata isikute ringile kasutamiseks antud või määratlemata isikute ringi kasutuses olev üldkasutatav territoorium (maa-ala, ala)",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
