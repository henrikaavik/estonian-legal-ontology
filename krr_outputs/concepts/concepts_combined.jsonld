        }
      ],
      "skos:definition": [
        {
          "@value": "tõenäoline tase, milleni võib tõusta reo- ning sademevee tasapind ühiskanalisatsioonis",
          "@language": "et"
        },
        {
          "@value": "tõenäoline tase, milleni võib tõusta reovee tasapind ühiskanalisatsioonis",
          "@language": "et"
        },
        {
          "@value": "veepinna kõrgusmärk, milleni kanalisatsioonivesi võib uputuse või ummistuse korral ühiskanalisatsioonis tõusta",
          "@language": "et"
        },
        {
          "@value": "tõenäoline tase, milleni võib tõusta reo- ning sademevee tase ühiskanalisatsioonis.",
          "@language": "et"
        },
        {
          "@value": "tõenäoline tase, milleni võib tõusta reo- või sademevee tasapind ühiskanalisatsioonis",
          "@language": "et"
        }
      ],
