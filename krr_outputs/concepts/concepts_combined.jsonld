    {
      "@id": "estleg:Concept_podrala_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ees_t1025182_teenusleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenusleping",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kliendi ja vee-ettevõtja vahel sõlmitud leping veevarustuse ja heitvee ärajuhtimise teenuste ostu-müügi kohta; 14) ühisveevärgi ja -kanalisatsiooni avarii – ühisveevärgi ja -kanalisatsiooni ehitiste või seadmete ettenägematu purunemine või rikkiminek, mille tagajärjel oluliselt halveneb või katkeb klientide veega varustamine või nende reovee ärajuhtimine või on ohustatud inimesed, ehitised või keskkond; 15) ühisveevärk ja -kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reovee ärajuhtimine ja mis on vee-ettevõtja hallatav. Ühisveevärgi ja -kanalisatsioonina käsitletakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025182_Par_2"
        }
      ],
      "estleg:sourceAct": "Põdrala valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "teenusleping (podrala_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ees_t1025182)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenusleping"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
