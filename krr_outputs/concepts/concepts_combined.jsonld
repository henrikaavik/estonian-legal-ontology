    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_isiku_majandus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "isiku majandus",
      "skos:definition": "või kutsetegevuses kasutatava sõiduki tähistust selle isiku nime, kontaktandmete, kaubamärgi, domeeninime ja tegevusalaga; 5",
