      }
    },
    {
      "@id": "estleg:Concept_vanemate_omaosalus_marjamaa_valla_lasteaedades_t1061010_valvelasteaed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valvelasteaed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lasteaed, mis avatakse Märjamaa valla lasteaedade suvise kinnioleku ajal juulikuus ja kuhu võetakse lasteaedades juba kohta kasutavaid lapsi vanema taotluse alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061010_Par_1"
        }
      ],
