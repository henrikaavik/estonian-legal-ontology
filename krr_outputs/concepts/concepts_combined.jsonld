    {
      "@id": "estleg:Concept_kohaliku_omavalitsuse_uksuse_elamufondi_arendamiseks_juhtumi_t1039590_Sotsiaal",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Sotsiaal",
      "skos:definition": "majanduslikult vähekindlustatud sihtgrupp – isikud, kelle omandis ei ole kohaliku omavalitsuse üksuse halduspiirides elamiskõlblikku eluruumi ning kellel ei ole sissetuleku puudumise, madala sissetuleku või muu objektiivse asjaolu tõttu võimalik eluruumi turutingimustel üürida. Sotsiaal-majanduslikult vähekindlustatud sihtgrupi moodustavad sealhulgas asenduskoduteenuselt ellu astunud noored, puudega või erivajadusega isikud, töövõimekaotusega isikud, lasterikkad pered, üksikvanemaga pered, kinnipidamisasutusest vabanenud isikud, õnnetusjuhtumi tagajärjel eluaseme kaotanud isikud, eakad, tühjenevatest haldamata korterelamutest kohaliku omavalitsuse poolt pakutavasse üürikorterisse ümber kolida soovivad isikud ning madala sissetulekuga isikud. Madala sissetuleku piiri määramisel võetakse aluseks Statistikaameti viimati avaldatud suhtelise vaesuse piir enne taotlusvooru avanemist. 3 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039590_Par_3"
        }
      ],
      "estleg:sourceAct": "Kohaliku omavalitsuse üksuse elamufondi arendamiseks juhtumipõhise investeeringutoetuse andmise tingimused ja kord",
      "rdfs:label": "Sotsiaal (kohaliku_omavalitsuse_uksuse_elamufondi_arendamiseks_juhtumi_t1039590)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_sotsiaal"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_sotsiaal"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kohaliku_omavalitsuse_uksuse_elamufondi_arendamiseks_juhtumi_t1039590_Projekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Projekt",
      "skos:definition": "taotleja tegevused käesoleva määruse § 1 lõike 3 punktis 1 või 5 nimetatud eesmärgi saavutamiseks, mida kirjeldatakse Ettevõtluse ja Innovatsiooni Sihtasutuse (edaspidi EIS ) vormil. Projekt koosneb kavandatava üürielamu ehitus- ja ümberehitustööde eesmärgist, tööde kirjeldusest ning milles on esitatud üürielamu ehitamise seos kohaliku omavalitsuse arengukava strateegiliste eesmärkidega, töökohtade ja eluruumide suhe, üürielamu arendusprojekti kalkulatsioon, sihtgrupile kavandatavate eluruumide osakaal üürielamus, üüritase ning projekti tasuvusaeg. RT I 2021-12-29 3 129122021003 2022-01-01 4 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039590_Par_3"
        }
      ],
      "estleg:sourceAct": "Kohaliku omavalitsuse üksuse elamufondi arendamiseks juhtumipõhise investeeringutoetuse andmise tingimused ja kord",
      "rdfs:label": "Projekt (kohaliku_omavalitsuse_uksuse_elamufondi_arendamiseks_juhtumi_t1039590)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_projekt"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_projekt"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kohaliku_omavalitsuse_uksuse_elamufondi_arendamiseks_juhtumi_t1039590_Tegevuskasum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Tegevuskasum",
      "skos:definition": "erinevus diskonteeritud tulude ja diskonteeritud tegevuskulude vahel investeeringu majandusliku eluea jooksul, kui see vahe on positiivne. 5 (",
      "estleg:definedIn": [
