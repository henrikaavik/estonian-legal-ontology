      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vanemate_omaosalus_marjamaa_valla_lasteaedades_t1061010_nadalatasu",
      "@type": [
        "owl:NamedIndividual",
