          "@id": "estleg:Concept_vinni_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_eesk_t1058825_peatorustik"
        }
      ],
      "estleg:definitionCount": {
        "@value": "12",
        "@type": "xsd:integer"
      },
      "rdfs:label": "peatorustik",
      "skos:definition": [
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, väljaarvatud ühendustorustik, mille kaudu toimub tarbimiskoha veega varustamine või tarbimiskohalt reo- ning sademevee ärajuhtimine",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub kinnistute veega varustamine ühisveevärgist või kinnistutelt reovee ärajuhtimine ühiskanalisatsiooni; 14) saasteaine (reoaine) – mis tahes aine, mis võib põhjustada reostust",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, välja arvatud ühendustorustik, mille kaudu toimub tarbimiskoha veega varustamine või tarbimiskohalt reo- ja sademevee ärajuhtimine",
          "@language": "et"
        },
        {
          "@value": "vee-ettevõtja omandis olev või tema valdusse antud ühisveevärgi- ja/või kanalisatsioonitorustik, läbi mille tarbijat varustatakse veega või millesse juhitakse tarbija reovesi",
          "@language": "et"
        },
        {
          "@value": "vee-ettevõtja omandis olev või tema valdusse antud ühisveevärgi- ja/või kanalisatsioonitorustik, millest varustatakse klienti veega või millesse juhitakse kliendi reovesi",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
