      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "muutuvpalk",
      "skos:definition": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, preemiana erakordsete teenistusalaste saavutuste eest või lisatasuna ülesannete eest, mis ületavad kokkulepitud töömahtu, ei tulene töö sisust või ei ole seotud teenistuskoha eesmärgiga; 7",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040857_Par_3"
        }
      ],
      "estleg:sourceAct": "Tõrva Vallavalitsuse palgajuhend",
