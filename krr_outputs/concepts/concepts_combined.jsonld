      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tehnorajatis",
      "skos:definition": [
        {
          "@value": "kütte-, veevarustuse- ja kanalisatsioonitorustikud, telekommunikatsiooni-, elektrivõrgu, nõrkvoolu-, küttegaasi- või elektripaigaldised või surveseadmed jms",
          "@language": "et"
        },
        {
          "@value": "maapõue või maapinnale inimtegevuse tulemusena paigaldatud torustik, pumpla, kaablivõrk või muu taoline rajatis",
          "@language": "et"
        },
        {
          "@value": "maapõue või maapinnale ehitatud kütte-, veevarustus- või kanalisatsiooni-torustik, elektroonilise side- või elektrivõrk, nõrkvoolu-, gaasi- või elektripaigaldis või surve-seadmestik ja eelmärgitud ehitiste või rajatiste funktsioneerimisega seotud ehitis, samuti maaparandussüsteem ja sademevee ärajuhtimise süsteem, sh kraav",
          "@language": "et"
        },
        {
          "@value": "maapõue või maapinnale inimtegevuse tulemusena paigaldatud torustik, pumpla, kaablivõrk, gaasijuhe jms.; teemaa on maa, mis õigusaktidega kehtestatud korras on määratud tee koosseisus olevate rajatiste paigutamiseks ja teehoiu korraldamiseks.",
          "@language": "et"
        },
        {
          "@value": "on maapõue või maapinnale paigaldatud torustik, pumpla, kaablivõrk, gaasijuhe jne",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
