        "@value": "Klient",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sotsiaaltransporditeenust kasutav isik, kes kuulub Vinni Vallavolikogu 25.11.2010 määruse nr 27 § 1 lg 2 nimetatud sihtgruppi.",
        "@language": "et"
