    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Kuludokument",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Kuludokument",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kauba- või teenusepakkuja esitatud arve kauba müügi või teenuse osutamis eest. Kuludokument peab sisaldama dokumendi nimetust ja numbrit, koostamise kuupäeva, tehingu majandusliku sisu (kauba või teenuse nimetus), tehingu arvnäitajad (kogus, hind, summa), tehingu osapoolte nimed ja asu-või elukoha aadressid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
