        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toila_valla_korraldatavate_elutahtsate_teenuste_kirjeldus_ja_t1061413_elutahtsa_teenuse_osutaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elutähtsa teenuse osutaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühisveevärgi ja kanalisatsiooni seaduse § 7 lõikes 11 nimetatud vee-ettevõtja ning ehitusseadustiku § 97 lõikes 8 nimetatud kohalikke teid korrashoidev ettevõtja.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061413_Par_2"
        }
      ],
