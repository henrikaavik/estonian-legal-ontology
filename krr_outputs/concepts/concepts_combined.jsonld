      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rae_vallavalitsuse_palgajuhend_t1056436_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhipalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga või töötasu fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal",
        "@language": "et"
      },
      "estleg:definedIn": [
