    {
      "@id": "estleg:Concept_kose_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054491_reovee_kohtkaitlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee kohtkäitlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kogumine, puhastamine, äravedu ja purgimine ühiskanalisatsiooni või reovee puhastamine omapuhastis, suublasse juhtimine, pinnasesse immutamine või kompostimine, üldjuhul reovee tekkekoha kinnistu piires",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054491_Par_2"
        }
      ],
