      },
      "rdfs:label": "ametiasutuse hallatav asutus",
      "skos:definition": [
        {
          "@value": "Kadrina valla asutused, kes ei teosta avalikku võimu; 4",
          "@language": "et"
        },
        {
          "@value": "kõik Mulgi valla asutused, kes ei teosta avalikku võimu; 4",
          "@language": "et"
        },
        {
          "@value": "kõik Türi valla asutused, kes ei tegutse avaliku võimuga; 4",
          "@language": "et"
        },
        {
          "@value": "kõik Viru-Nigula valla asutused, kes ei tegutse avaliku võimuna; 4",
          "@language": "et"
        },
        {
          "@value": "vallavolikogu poolt teenuste osutamiseks moodustatud asutus, mis ei teosta avalikku võimu; 3",
          "@language": "et"
        }
      ]
    },
