          "@id": "estleg:Concept_johvi_valla_infoturvapoliitika_t1058728_tulemuur"
        },
        {
          "@id": "estleg:Concept_mustvee_vallavalitsuse_infoturbepoliitika_t1047495_Tulemuur"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Tulemüür",
      "skos:altLabel": [
        {
          "@value": "tulemüür",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "tarkvara või seade, mis turvakaalutlustel piirab ja reguleerib võrguliiklust arvutivõrgus või võrkude vahel vastavalt seadistatud reeglitele. Tulemüüri esmane otstarve on väljastpoolt juurdepääsu takistamine ressurssidele, millele pole sellist juurdepääsu ette nähtud. 14 (",
          "@language": "et"
        },
        {
          "@value": "tarkvara või seade, mis turvakaalutlustel piirab ja reguleerib võrguliiklust arvutivõrgus või võrkude vahel vastavalt seadistatud reeglitele. Tulemüüri esmane otstarve on väljastpoolt juurdepääsu takistamine ressurssidele, millele pole sellist juurdepääsu ette nähtud; 18",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tuleohtlik_aeg",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tuleohtlik aeg",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_paide_linna_heakorraeeskiri_t1044647_tuleohtlik_aeg"
        },
        {
          "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_tuleohtlik_aeg"
        },
        {
          "@id": "estleg:Concept_rapla_valla_heakorraeeskiri_t1045563_tuleohtlik_aeg"
        },
        {
          "@id": "estleg:Concept_tartu_valla_heakorraeeskiri_t1004440_tuleohtlik_aeg"
        },
        {
          "@id": "estleg:Concept_ulenurme_valla_heakorraeeskiri_t1004353_tuleohtlik_aeg"
        },
        {
          "@id": "estleg:Concept_viru_nigula_valla_heakorra_eeskiri_t1058823_tuleohtlik_aeg"
        }
      ],
      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tuleohtlik aeg",
      "skos:definition": [
        {
          "@value": "metsa ja muu taimestikuga kaetud alal algab kevadel pärast lume sulamist ning lõpeb sügisel vihmaste ilmade saabumisel. Tuleohtliku aja alguse ja lõpu määrab Eesti Meteoroloogia ja Hüdroloogia Instituut ning teavitab sellest avalikkust; 12",
          "@language": "et"
        },
        {
          "@value": "ajavahemik, mil metsa- ja muu taimestikuga ning turbapinnasega alal on keelatud küttekoldevälise tule tegemine (välja arvatud selleks ettevalmistatud kohas), kuluheina ja roostiku põletamine ning muu tegevus, mis võib põhjustada tulekahju. Tuleohtliku aja alguse ja lõpu määrab Päästeamet; 25",
          "@language": "et"
        },
        {
          "@value": "Päästeameti peadirektori vastavas õigusaktis sätestatud periood, mil keelatakse küttekoldevälise tule tegemine.",
          "@language": "et"
        },
        {
          "@value": "päästeameti peadirektori õigusaktiga sätestatud periood, mil on metsa- ja muu taimestikuga ning turbapinnasega alal keelatud küttekoldevälise tule tegemine (välja arvatud selleks ettevalmistatud kohas), kuluheina ja roostiku põletamine ning muu tegevus, mis võib põhjustada tulekahju; 30",
          "@language": "et"
        },
        {
          "@value": "Päästeameti poolt määratud ja avalikustatud tuleohtlik aeg.",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_tuleohtlik_ala"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tuleohtlik_ala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tuleohtlik ala",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_tuleohtlik_ala"
        },
        {
          "@id": "estleg:Concept_tartu_valla_heakorraeeskiri_t1004440_tuleohtlik_ala"
        },
        {
          "@id": "estleg:Concept_ulenurme_valla_heakorraeeskiri_t1004353_tuleohtlik_ala"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tuleohtlik ala",
      "skos:definition": [
        {
          "@value": "metsa ja muu taimestikuga (kuluhein, tuleohtlik põõsastiku, poolpõõsastik) kaetud ala ning turbapinnasega ala; 13",
          "@language": "et"
        },
        {
          "@value": "metsa ja muu taimestikuga nagu kuluheinaga, tuleohtliku põõsastikuga (kadakas), poolpõõsastikuga (kanarbik, sookail,põõsasmaran) ja kuivanud rooga kaetud ala ning turbapinnasega ala.",
          "@language": "et"
        },
        {
          "@value": "metsa ning muu taimestikuga, nagu kuluheinaga, tuleohtliku põõsastikuga, poolpõõsastikuga ja kuivanud rooga kaetud ala ning turbapinnasega ala; 26",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_tuleohtlik_aeg"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tuletorje_veevotukoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
