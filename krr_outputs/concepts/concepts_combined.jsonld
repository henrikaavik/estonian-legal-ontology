      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Reisija",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reisija",
        "@language": "et"
      },
      "skos:definition": {
