        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elutähtis teenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kaugküttega varustamine, veega varustamine ja kanalisatsiooni teenuse osutamine ning kohalike teede sõidetavuse tagamine; 2) elutähtsa teenuse osutaja − kaugkütteseaduse § 7 lõikes 3 nimetatud soojusettevõtja, ühisveevärgi ja -kanalisatsiooni seaduse § 6 lõikes 2 nimetatud vee-ettevõtja ning ehitusseadustiku § 97 lõikes 8 nimetatud kohalikke teid korrashoidev ettevõtja.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061326_Par_2"
        }
      ],
