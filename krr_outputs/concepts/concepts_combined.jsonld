      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Sisekontrolör",
      "skos:definition": [
        {
          "@value": "käesoleva eeskirja tähenduses isik või teenuse osutaja, kes täidab vallas sisekontrolli ülesandeid (edaspidi sisekontrolör).",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
