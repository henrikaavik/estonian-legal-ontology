        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tehingupartnerid",
      "skos:definition": [
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tunnused – tehingupartneri koodid, eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud finantsaruandeid",
          "@language": "et"
        },
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tehingupartneri koodid, eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud raamatupidamisaruandeid",
          "@language": "et"
        },
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tunnused – tehingupartneri koodid (numbrite kombinatsioonid), mis võimaldavad koostada avaliku sektori üksuste finantsaruandeid.",
          "@language": "et"
        }
      ],
