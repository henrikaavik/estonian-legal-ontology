      ],
      "skos:prefLabel": {
        "@value": "BHT",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "bioloogiline hapnikutarve, veekogu üldseisundit iseloomustav parameeter. Näitab hapniku hulka, mis on vajalik orgaanilise aine määratletud bioloogiliseks lagunemiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052568_Par_2"
        }
      ],
