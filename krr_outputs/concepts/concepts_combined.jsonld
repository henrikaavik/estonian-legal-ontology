    {
      "@id": "estleg:Concept_pohja_sakala_valla_uhisveevargi_ja_kanalisatsiooniga_liitumi_t1051670_vee_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eraõiguslik juriidiline isik, kes varustab kliendi kinnistu veevärki ühisveevärgi kaudu veega või korraldab ühiskanalisatsiooni kaudu kliendi kinnistu kanalisatsioonist reo- ning sademevee ärajuhtimist; 18) ühisveevärk ja -kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reo- ning sademevee ärajuhtimine ja mis on vee-ettevõtja hallatav. Ühisveevärgi ja -kanalisatsioonina käsitletakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051670_Par_2"
        }
      ],
      "estleg:sourceAct": "Põhja-Sakala valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
      "rdfs:label": "vee-ettevõtja (pohja_sakala_valla_uhisveevargi_ja_kanalisatsiooniga_liitumi_t1051670)",
