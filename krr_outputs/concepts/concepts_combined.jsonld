          "@value": "osalustasu või õppetasu",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "lapsevanema poolt tasutav summa huvihariduse või -tegevuse pakkujale.",
          "@language": "et"
        },
        {
          "@value": "lapsevanema poolt tasutav summa huvihariduse või huvitegevuse pakkujale; 6) laager, võistlus (turniir, konkurss, festival jms) - huvikooli või huvitegevuse osutaja poolt korraldatud või nende eestvedamisel ja osalusel toimuv eesmärgistatud ühistegevus, mille käigus tegeletakse intensiivselt huviõppega.",
          "@language": "et"
        },
        {
          "@value": "lapsevanema poolt tasutav summa huvihariduse- või- tegevuse pakkujale.",
          "@language": "et"
        },
        {
          "@value": "õpilase huvihariduse omandamise või huvitegevuses osalemise eest makstav tasu huvihariduse või huvitegevuse pakkujale",
          "@language": "et"
        }
      ],
