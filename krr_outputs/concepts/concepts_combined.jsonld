        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "uus sõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduk, mis pärast valmistamist ei ole olnud kasutuses ega kantud Eesti või muu riigi registrisse. Sõiduk loetakse uueks ka juhul, kui see on registreeritud Euroopa Liidu liikmesriigis transpordiks sõiduki valmistaja juurest ametliku maaletooja juurde Eestis",
        "@language": "et"
      },
      "estleg:definedIn": [
