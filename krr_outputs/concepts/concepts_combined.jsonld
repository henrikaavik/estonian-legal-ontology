    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1060457_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "septik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pealt kinnine ja veetihe mitmest sektsioonist mahuti reoveest sette eemaldamiseks. Septikut tuleb perioodiliselt sinna kogunenud settest tühjendada ja setted tuleb purgida purgimissõlme.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060457_Par_1"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "septik (reovee_kohtkaitluse_ja_araveo_eeskiri_t1060457)",
