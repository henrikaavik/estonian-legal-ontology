    },
    {
      "@id": "estleg:Concept_raasiku_vallavalitsuse_raamatupidamise_sise_eeskiri_t1062145_aktsepteerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "aktsepteerimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandustehingu toimumise ja õiguspärasuse kinnitamine allkirjaga ning eelarve tunnuste määramine eelarve vastutava täitja või volitatud täitja poolt. Allkirjale lisatakse allkirjastaja nimi ja aktsepteerimise kuupäev; allkirjastada võib ka digitaalselt; 4) allkiri (sh raamatupidamise algdokumendi allkiri) - omakäeline allkiri paberdokumendil, digitaalallkiri või dokumendi menetlemiseks ette nähtud infotehnoloogilises süsteemis antud kooskõlastus või kinnitus, kui selle andjat ja selle andmise kuupäeva on võimalik elektrooniliselt säilitada ja dokumendi säilitustähtaja jooksul tuvastada",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062145_Par_2"
        }
      ],
      "estleg:sourceAct": "Raasiku Vallavalitsuse raamatupidamise sise-eeskiri",
