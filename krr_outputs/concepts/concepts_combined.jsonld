      ],
      "skos:prefLabel": "omanik",
      "skos:definition": "Viru-Nigula vallas asuva kinnis- või vallasasja omanik, kellega heakorra nõuete täitmisel on võrdsustatud tema poolt volitatud valdaja, haldaja või kasutaja; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058823_Par_2"
        }
      ],
      "estleg:sourceAct": "Viru-Nigula valla heakorra eeskiri",
