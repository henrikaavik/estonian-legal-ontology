    {
      "@id": "estleg:Concept_terviklahendus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "terviklahendus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rohelise_investeerimisskeemi_korterelamute_rekonstrueerimise_t345791_terviklahendus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "terviklahendus",
      "skos:definition": [
        {
          "@value": "korterelamu kompleksseks rekonstrueerimiseks ja energiatõhususe saavutamiseks teostatavate tööde kogum. Terviklahenduseks võib lugeda ka energiaaudiitori poolt koostatud energiaauditis toodud soovitusliku töödepaketi teostamist, kui valitud tööd tagavad hoone sisekliimat halvendamata vähemalt 20%-lise energiasäästu saavutamise kuni 2000 m 2 suletud netopinnaga korterelamus ja vähemalt 30%-lise energiasäästu saavutamise üle 2000 m 2 suletud netopinnaga korterelamus.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_terviklik_rekonstrueerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "terviklik rekonstrueerimine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_vaikeelamute_energiatohususe_suurendamise_toetuse_kasutamise_t1049699_terviklik_rekonstrueerimine"
        },
        {
          "@id": "estleg:Concept_vaikeelamute_rekonstrueerimise_toetamine_t1058695_terviklik_rekonstrueerimine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "terviklik rekonstrueerimine",
      "skos:definition": [
        {
          "@value": "projekt, mille alusel ja kompleksselt § 7 lõikes 2 nimetatud nõuete kohaselt soojustatakse vähemalt kõik välisseinad ja katus, vahetatakse kõigi eluruumide aknad, rekonstrueeritakse küttesüsteem ja paigaldatakse soojustagastusega sissepuhke-väljatõmbe ventilatsioonisüsteem ning mille tulemusena saavutatakse vähemalt energiatõhususarvu klass C",
          "@language": "et"
        },
        {
          "@value": "projekt, millega teostatakse kompleksselt § 6 lõikes 2 nimetatud nõuetele vastavalt vähemalt välisseinte ja katuse soojustamine, akende vahetamine, rekonstrueeritakse küttesüsteem ja paigaldatakse soojustagastusega sissepuhke-väljatõmbe ventilatsioonisüsteem; toetuse saaja – paragrahvi 1 lõikes 4 nimetatud juhul üldtingimuste määruse § 3 punktis 5 nimetatud lõppsaaja",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_terviklikkus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "terviklikkus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_riigisaladuse_ja_salastatud_valisteabe_kaitse_kord_t317593_terviklikkus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "terviklikkus",
      "skos:definition": [
        {
          "@value": "teabe omadus olla volitamata isikute poolt muutmata, täiendamata või hävitamata",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_terviklus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "terviklus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_johvi_valla_infoturvapoliitika_t1058728_terviklus"
        },
        {
          "@id": "estleg:Concept_marjamaa_vallavalitsuse_infoturvapoliitika_t1063063_terviklus"
        },
        {
          "@id": "estleg:Concept_tori_vallavalitsuse_infoturvapoliitika_t1062443_terviklus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "terviklus",
      "skos:definition": [
        {
          "@value": "andmete ja teabe korrektsus ja muutumatus",
          "@language": "et"
        },
        {
          "@value": "andmete õigsuse, täielikkuse ja ajakohasuse tagatus ning päritolu autentsus ja volitamatute muutuste puudumine",
          "@language": "et"
        },
        {
          "@value": "teave on täpne ja usaldusväärne ning kaitstud volitamata muutmise eest",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
