        "@language": "et"
      },
      "skos:definition": {
        "@value": "ajavahemik lindude pesitsemise ja puude aktiivse vegetatsiooni ajal, millal puu raiumist võib mitte lubada (aprillist kuni juuli lõpuni).",
        "@language": "et"
      },
      "estleg:definedIn": [
