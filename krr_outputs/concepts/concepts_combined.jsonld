          "@id": "estleg:Concept_kiirabi_haiglate_paaste_ja_politseiasutuste_kaitsevae_ning_t_t1045437_abiandja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "abiandja",
      "skos:definition": [
        {
          "@value": "kiirabibrigaad, Päästeameti, Kaitseväe ning Politsei- ja Piirivalveameti üksus, keda Häirekeskus või Politsei- ja Piirivalveamet saadab välja abi andma",
          "@language": "et"
        },
        {
          "@value": "Päästeameti, Kaitseväe, Politsei- ja Piirivalveameti, Terviseameti ning nende lepingupartnerite üksused, keda Häirekeskus või Politsei- ja Piirivalveamet saadab välja abi andma",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
