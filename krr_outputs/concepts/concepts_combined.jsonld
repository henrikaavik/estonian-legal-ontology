      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sademeveekanalisatsiooni avarii",
      "skos:definition": [
        {
          "@value": "sademeveekanalisatsiooni ehitiste või seadmete ettenägematu purunemine või rikkiminek, mille tagajärjel oluliselt halveneb või katkeb piirkonna sademevee kokku kogumine ja ära juhtimine ning mille tagajärjel tekib üleujutuse oht; 26",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_sademeveekorraldus",
