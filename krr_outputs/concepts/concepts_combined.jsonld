      "rdfs:label": "Eesti finantsaruandluse standard",
      "skos:definition": [
        {
          "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev raamatupidamistava, mille põhinõuded kehtestatakse RPS-s, mida täiendavad RTJ-d, üldeeskiri ja sise-eeskiri",
          "@language": "et"
        },
        {
          "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev avalikkusele suunatud finantsaruandluse nõuete kogum, mille põhinõuded kehtestatakse RPS-is ja mida täpsustavad RTJ-id; 2016-12-21",
          "@language": "et"
        },
        {
          "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev avalikkusele suunatud finantsaruandluse nõuete kogum, mille põhinõuded kehtestatakse RPS-s ning mida täpsustavad RTJ-id ja üldeeskiri",
          "@language": "et"
        },
        {
