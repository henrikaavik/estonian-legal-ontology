      ],
      "skos:prefLabel": "maksukohustuslane",
      "skos:definition": "välireklaamikandja otsene valdaja või ühistranspordiloa või taksoveoloa omaja; (Tvk m 17.11.2011 nr 36 - jõust. 01.01.",
