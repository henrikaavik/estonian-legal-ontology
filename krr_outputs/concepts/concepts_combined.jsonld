      "skos:definition": {
        "@value": "isik, kes Kadrina Vallavolikogu otsusega on volitatud kontrollima kinnistu veevärgi ja kanalisatsiooni vastavust nõuetele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1035403_Par_2"
        }
      ],
