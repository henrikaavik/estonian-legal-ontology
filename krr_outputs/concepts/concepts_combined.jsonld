        "@type": "xsd:integer"
      },
      "rdfs:label": "lihthäälteenamus",
      "skos:definition": [
        {
          "@value": "kui otsuse poolt hääletab üle poole koosolekul osalejatest. Käesoleva paragrahvi lõikes 2 nimetamata mõiste kasutamisel lähtutakse õigusaktides sisalduvatest mõistest, vastava mõiste puudumisel aga sõna üldlevinud tähendusest.",
          "@language": "et"
        }
      ],
