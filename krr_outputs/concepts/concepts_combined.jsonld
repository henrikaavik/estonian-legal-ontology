      "skos:definition": {
        "@value": "KOKS § 66 1 alusel valla ametiasutuste, ametnike ning vallavalitsuse hallatavate asutuste ja nende juhtide tegevuse seaduslikkuse ja otstarbekuse üle teostatav kontroll.",
        "@language": "et"
      },
