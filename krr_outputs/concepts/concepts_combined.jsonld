    {
      "@id": "estleg:Concept_perekonna_sissetulek",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Perekonna sissetulek",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_viimsi_valla_sotsiaaltoetuste_maaramise_ja_maksmise_tingimus_t1054418_Perekonna_sissetulek"
        },
        {
          "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_andmise_tingimused_ja_kord_t1059372_perekonna_sissetulek"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Perekonna sissetulek",
      "skos:altLabel": [
        {
          "@value": "perekonna sissetulek",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kõigi perekonnaliikmete netotulud, mille hulka ei arvata sotsiaalhoolekande seaduse § 133 lõikes 2 sätestatut",
          "@language": "et"
        },
        {
          "@value": "toetuse määramisel arvestatakse toetuse saaja ja tema perekonnaliikmete netosissetulekuid ning perekonnaseadusest tulenevat ülalpidamiskohustust. Sissetulekute hulka ei arvata sotsiaalhoolekande seaduse § 133 lõikes 2 nimetatud toetusi.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_perekonnas_hooldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
