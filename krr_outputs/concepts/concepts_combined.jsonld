      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "optiline kiirgus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tootervishoiu_ja_tooohutuse_nouded_tehislikust_optilisest_ki_t342860_optiline_kiirgus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "optiline kiirgus",
      "skos:definition": [
        {
          "@value": "elektromagnetkiirgus, mille lainepikkus on vahemikus 100 nm kuni 1 mm. Optilise kiirguse spekter jaguneb ultraviolettkiirguseks, nähtavaks valguseks ja infrapunakiirguseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_orgaaniline_lahusti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "orgaaniline lahusti",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_lenduvaid_orgaanilisi_uhendeid_sisaldavate_varvide_ja_muude_t1036173_orgaaniline_lahusti"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "orgaaniline lahusti",
      "skos:definition": [
        {
          "@value": "LOÜ, mida kasutatakse iseseisvalt või koos muude kemikaalidega tooraine, toote või jäätmete lahustamiseks või lahjendamiseks, puhastusvahendina saasteainete lahustamiseks, dispergandina, viskoossuse või pindpinevuse regulaatorina, plastifikaatorina või konservandina",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_orgaaniline_uhend",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "orgaaniline ühend",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_lenduvaid_orgaanilisi_uhendeid_sisaldavate_varvide_ja_muude_t1036173_orgaaniline_uhend"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "orgaaniline ühend",
      "skos:definition": [
        {
          "@value": "ühend, mis koosneb süsinikust ja ühest või mitmest vesiniku-, hapniku-, väävli-, fosfori-, räni-, lämmastiku- või halogeeniaatomist, välja arvatud süsinikoksiidid, anorgaanilised karbonaadid ja vesinikkarbonaadid",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_organisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "organisatsioon",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101_organisatsioon"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "organisatsioon",
      "skos:definition": [
        {
          "@value": "huviharidust või -tegevust pakkuv asutus, sealhulgas üldhariduskool, huvikool, rahvamaja, noortekeskus, mittetulundusühing jms. Organisatsioon on registreeritud äriregistris ja tegutseb Rapla vallas või vallaga külgnevas vallas või pakub sellise spetsiifikaga huviala, mida ei ole võimalik pakkuda Rapla valla või vallaga külgneva valla territooriumil; 5) õppekoha maksumus (edaspidi kohatasu ) – majandusaastaks huvikooli pidaja kinnitatud õppekoha tegevuskulu arvestuslik maksumus, mida makstakse huvihariduse omandamiseks ühel huvialal ühe õppuri kohta.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_osaajaga_lastehoiu_teenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
