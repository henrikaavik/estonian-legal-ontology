      "rdfs:label": "omafinantseering",
      "skos:altLabel": [
        {
          "@value": "Omafinantseering",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "abikõlblik kulu, mida toetusest ei hüvitata ja mille tasub toetuse saaja või partner; 2",
          "@language": "et"
        },
        {
          "@value": "Interreg programmi raames struktuuritoetuse saamiseks Eesti partnerilt nõutav rahaline ja/või mitterahaline panus. Omafinantseering võib koosneda Eesti partneri omavahenditest ja/või Eesti avaliku sektori eraldistest; 3",
          "@language": "et"
        },
        {
          "@value": "linna rahaline ja/või mitterahaline kohustus projekti elluviimiseks, mille linn eraldab oma eelarve piires või mida ta korras sätestatud juhul taotleb Kiviõli linna eelarve reservfondist (linn või linna hallatav asutus osaleb projektis juhtpartnerina); 9",
          "@language": "et"
        },
        {
          "@value": "osa projekti abikõlblikest kuludest, mille katab rahaliselt toetuse saaja või partner; 3",
          "@language": "et"
        },
        {
          "@value": "osa projekti abikõlblikest kuludest, mille katab rahaliselt toetuse saaja või partner; 6",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "22",
        "@type": "xsd:integer"
      }
    },
