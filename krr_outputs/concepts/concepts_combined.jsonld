      "rdfs:label": "vormipuu",
      "skos:definition": [
        {
          "@value": "ilupuu, mille võrale on puu kasvu algusest saadik antud erinevate hooldusvõtetega soovitud kuju",
          "@language": "et"
        },
        {
          "@value": "ilupuu, mille võrale on puu kasvu algusest saadik antud erinevate hooldus-võtetega soovitud kuju.",
          "@language": "et"
        },
        {
          "@value": "puu, mille võrale on puu kasvu algusest saadik antud okste kärpimise, painutamise või tugedele sidumisega soovitud kuju",
          "@language": "et"
        }
      ],
