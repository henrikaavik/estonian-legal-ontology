        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eraõiguslik juriidiline isik, kes varustab kliendi kinnistu veevärki ühisveevärgi kaudu veega või korraldab ühiskanalisatsiooni kaudu kliendi kinnistu kanalisatsioonist reovee ärajuhtimist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028459_Par_2"
        }
      ],
      "estleg:sourceAct": "Puka valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
