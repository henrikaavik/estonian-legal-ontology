      ],
      "skos:prefLabel": "varjumiskoha kohandamine",
      "skos:definition": "olemasoleva hoone osa või ruumi ettevalmistamine selliselt, et see pakuks inimestele võimalikult head kaitset ohuolukorras, arvestades hoone ehituslikke ja tehnilisi võimalusi. Üldkasutatava ruumi varjumiskohaks kohandamisel lähtutakse koostatud eskiisist, skeemist, projektist vms; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061194_Par_3"
