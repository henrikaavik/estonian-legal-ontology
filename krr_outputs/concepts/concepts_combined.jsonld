    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_linna_uhiskondlikuks_objektiks_olev_valireklaamikandja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "linna ühiskondlikuks objektiks olev välireklaamikandja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Tallinna linnale kui avalik-õiguslikule juriidilisele isikule kuuluva ehitise pinnale õiguspäraselt paigutatud välireklaamikandja, mis samaaegselt selle kasutamisega reklaamialaseks tegevuseks teenib linna avalikke huve (linnateaberajatis, ootekoda, prügikast jm)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Tallinnas",
