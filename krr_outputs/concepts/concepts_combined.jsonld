      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sisekliima tagamine",
      "skos:definition": [
        {
          "@value": "energia kasutamine ruumiõhu kvaliteedi tagamiseks ning valgustamiseks vastavalt hoone tüüpilisele kasutusele.",
          "@language": "et"
        },
        {
          "@value": "energia kasutamine hoone ruumiõhu kvaliteedi tagamiseks, vastavalt ehitusseadustiku § 65 lõike 3 alusel kehtestatud määruses hoone energiatõhususe miinimumnõuete kohta sätestatud ventilatsiooni- ja ruumitemperatuuri nõuetele ning valgustamiseks vastavalt hoone tüüpilisele kasutusele; RT I 2019-01-18 7 118012019007 2019-01-21 3",
          "@language": "et"
        },
        {
          "@value": "energia kasutamine ruumiõhu kvaliteedi tagamiseks ning valgustamiseks vastavalt hoone tüüpilisele kasutusele; 12",
          "@language": "et"
        },
        {
          "@value": "energia kasutamine ruumiõhu kvaliteedi tagamiseks ning valgustamiseks vastavalt hoone tüüpilisele kasutusele; 13",
          "@language": "et"
        },
        {
          "@value": "energia kasutamine ruumiõhu kvaliteedi tagamiseks ning valgustamiseks vastavalt hoone tüüpilisele kasutusele; 15",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_sisekontrollimeede",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sisekontrollimeede",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Sisekontrollimeede"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Sisekontrollimeede",
      "skos:definition": [
        {
          "@value": "asutuses sisekontrolli teostamisel kasutatavad abinõud, mis on suunatud kõrvalekallete või pettuste ennetamisele. Ennetava meetme osas rakendatakse ametnike ja töötajate töökohustuste lahusust, tegvuste kooskõlastust ja kinnitamist, ametnike ja töötajate erialast täiendkoolitust, valla IT-süsteemi tehnoloogilisi võimalusi. Vallas võib kasutada ka muid sisekontrollimeetmeid, mis tagavad sisekontrolli eesmärgi saavutamise. 5",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_sisekontrolor",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sisekontrolör",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Sisekontrolor"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Sisekontrolör",
      "skos:definition": [
        {
          "@value": "käesoleva eeskirja tähenduses isik või teenuse osutaja, kes täidab vallas sisekontrolli ülesandeid (edaspidi sisekontrolör). 4",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_sisekontrolori_tooplaan",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sisekontrolöri tööplaan",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Sisekontrolori_tooplaan"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Sisekontrolöri tööplaan",
      "skos:definition": [
        {
          "@value": "sisekontrolli läbiviimise aastaplaan, mis kinnitatakse vallavalitsuse korraldusega ja tehakse kättesaadavaks vallavalitsuse ametiasutuste ja nende ametiasutuste hallatavate asutuste juhtidele või valla valitseva mõju all oleva äriühingu, sihtasutuse ja mittetulundusühingu juhtorganitele. 6",
          "@language": "et"
        }
      ]
    },
