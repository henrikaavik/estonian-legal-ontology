    },
    {
      "@id": "estleg:Concept_vormsi_valla_heakorra_ja_kaevetoode_eeskiri_t1059297_avalik_ruum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik ruum",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "igaühele, ligipääsetav ja piiranguteta kasutatav ruum (teed, haljasalad, bussipeatused), samuti poolavalik ruum, mille kasutamine võib olla tingitud ajast, loast jms (asutuste territooriumid, õuealad, rannad jne).",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059297_Par_2"
        }
      ],
      "estleg:sourceAct": "Vormsi valla heakorra ja kaevetööde eeskiri",
