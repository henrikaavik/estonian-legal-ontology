      "rdfs:label": "taotleja",
      "skos:definition": [
        {
          "@value": "leibkonnaliige, kes on tühjenevas korterelamus asuva korteri omanik ja taotleb asenduskorteri omandamise kompensatsiooni",
          "@language": "et"
        },
        {
          "@value": "12-19 aastane füüsiline isik, kes tegutseb Peipsiääre vallas.",
          "@language": "et"
        },
        {
          "@value": "erakool, mis pakub üldharidust Saue valla elanikuna rahvastikuregistrisse kantud 7-19-aastasele õpilasele",
          "@language": "et"
        },
        {
          "@value": "eralasteasutus, mis pakub vastavat teenust Kastre valla elanikuna rahvastikuregistrisse kantud eelkooliealisele pooleteise kuni seitsmeaastasele lapsele (või kuni kooli õppima asumiseni)",
          "@language": "et"
        },
        {
          "@value": "eralastehoid või eralasteaed, kus käivad Keila linna lapsed",
          "@language": "et"
        }
      ],
