        }
      ]
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_kompetents",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kompetents",
      "skos:definition": "uuendusliku teabe, selle loomise, vahendamise ja rakendamisega seotud asjatundlikkus, mille valdkondlik suund on selgelt piiritletav ning mille abil saab luua lisandväärtust tekitavaid ressursi- või tulemuspõhiseid uuenduslikke arendusi ja saavutada kompetentsikeskuse kõrge konkurentsivõime; 5",
      "estleg:definedIn": [
        {
