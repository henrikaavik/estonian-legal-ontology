        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hanke eest vastutav isik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vastutab hanke korraldamise seaduslikkuse eest vastavalt riigihankeseaduses ja hankedokumentides sätestatud nõuetele, sh juhib hankega seotud komisjonide tööd ja korraldab riigihangete registrisse hankemenetlusega seotud informatsiooni edastamist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058651_Par_3"
        }
      ],
      "estleg:sourceAct": "Vormsi valla hankekord",
