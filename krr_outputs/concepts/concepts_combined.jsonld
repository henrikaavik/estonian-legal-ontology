    {
      "@id": "estleg:Concept_luganuse_vallavalitsuse_palgajuhend_t1041205_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Lüganuse vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041205_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (luganuse_vallavalitsuse_palgajuhend_t1041205)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_vallavalitsuse_palgajuhend_t1041205_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Lüganuse vallaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud vallavalitsuse teenistuskohtade koosseisus ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041205_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (luganuse_vallavalitsuse_palgajuhend_t1041205)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_vallavalitsuse_palgajuhend_t1041205_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on võetud vallavalitsuse teenistuskohtade kooseisus ettenähtud töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041205_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (luganuse_vallavalitsuse_palgajuhend_t1041205)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
