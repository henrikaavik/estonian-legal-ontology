    {
      "@id": "estleg:Concept_loksa_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_nend_t1004275_uhisveevark",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühisveevärk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitiste ja seadmete kompleks mitme kinnistu veega varustamiseks ning vee kasutamiseks kahjutule tõrjumisel, kui selleks ei ole ette nähtud muid veevõtukohti; 28) ühisveevärgi ja -kanalisatsiooni avarii – ühisveevärgi ja -kanalisatsiooni ehitiste või seadmete ettenägematu purunemine või rikki minek, mille tagajärjel oluliselt halveneb või katkeb klientide veega varustamine ja nende heitvee kanaliseerimine, või on ohustatud inimesed, ehitised või keskkond",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1004275_Par_2"
        }
      ],
      "estleg:sourceAct": "Loksa linna ühisveevärgi ja -kanalisatsiooniga liitumise, nende kasutamise ja liitumistasu võtmise kord",
      "rdfs:label": "ühisveevärk (loksa_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_nend_t1004275)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhisveevark"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
