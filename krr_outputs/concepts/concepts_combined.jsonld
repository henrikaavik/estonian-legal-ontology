        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "palk",
      "skos:definition": "ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu; 7",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040989_Par_2"
        }
      ],
      "estleg:sourceAct": "Võru Vallavalitsuse palgajuhend",
