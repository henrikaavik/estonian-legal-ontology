        {
          "@id": "estleg:Concept_palk"
        }
      ]
    },
    {
      "@id": "estleg:Concept_voru_vallavalitsuse_palgajuhend_t1040989_tootasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "töötasu",
      "skos:definition": "tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasust, mida ametiasutus maksab töötajale või töölisele tehtud töö eest vastavalt töölepingule, õigusaktidele ja tööandja poolt kehtestatud korrale; RT IV 2024-01-19 19 419012024019 2024-01-22 42 , rakendatakse 01.01.2024 8",
