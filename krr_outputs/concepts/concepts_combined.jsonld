      },
      "rdfs:label": "avalikult kasutatav maa-ala",
      "skos:definition": [
        {
          "@value": "määratlemata isikute ringile kasutamiseks antud ning kasutuses olev üldjuhul hooneteta maa, nt tee, tänav, väljak, park, puhkeala vms",
          "@language": "et"
        },
        {
          "@value": "munitsipaalomandis olev maa Rae valla haldusterritooriumil",
          "@language": "et"
        },
        {
          "@value": "määratlemata isikute kasutusse antud maa-ala, näiteks tee, tänav, väljak, park, puhkeala, hoov või muud sellist",
          "@language": "et"
        },
        {
          "@value": "määratlemata isikute ringile kasutamiseks antud ning",
          "@language": "et"
        },
        {
          "@value": "määratlemata isikute ringile kasutamiseks antud ning kasutuses olev üldjuhul hoonestamata maa, nt tee, tänav, väljak, park, puhke- või virgestusala vms. Käesoleva määruse tähenduses ei kuulu kalmistu maa avalikult kasutatava maa-ala hulka",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "11",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
