        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Anija vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik ja vallavalitsuses eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040811_Par_2"
        }
      ],
      "estleg:sourceAct": "Anija Vallavalitsuse teenistujate ja hallatavate asutuste töötajate palgajuhend",
