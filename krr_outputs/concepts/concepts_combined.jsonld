      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kaevaja",
      "skos:definition": [
        {
          "@value": "füüsiline või juriidiline isik, kellele on väljastatud kaevetööluba või kes on avariikaevetöö teostaja",
          "@language": "et"
        },
        {
          "@value": "isik, kelle kasuks on maaüksusele vormistatud luba (v avariikaevetööde puhul)",
          "@language": "et"
        },
        {
          "@value": "kaevetöö tegija on juriidiline isik, kes omab vastavat ehitusalast pädevust ning ehituse valdkonna tegevusala registreeringut Majandustegevuse registris (MTR), kes otseselt teostab kaevetöid, kellele on väljastatud luba kaevetööde tegemiseks, kes vastutab kaevetöödega seonduvate tegevuste eest käesoleva eeskirja kohaselt",
          "@language": "et"
        },
        {
          "@value": "kaevetöö tegija on juriidiline isik, kes omab vastavat ehitusalast pädevust ning on esitanud ehituse valdkonna majandustegevuse teate ja, kes otseselt teostab kaevetöid, kellele on väljastatud luba kaevetööde tegemiseks, kes vastutab kaevetöödega seonduvate tegevuste eest käesoleva eeskirja kohaselt",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
