      },
      "skos:definition": {
        "@value": "kodumajapidamistest kogutud segajäätmed ja liigiti kogutud jäätmed, sealhulgas paber ja kartong, klaas, metallid, plast, biojäätmed, puit, tekstiil, pakendid, elektri- ja elektroonikaseadmetest tekkinud jäätmed, patareid ja akud ning suuremõõtmelised jäätmed, sealhulgas madratsid ja mööbel; 22) paber- ja kartongijäätmed – liigiti kogutavad paberist ja kartongist materjalid",
        "@language": "et"
      },
      "estleg:definedIn": [
