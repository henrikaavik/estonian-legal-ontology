      "rdfs:label": "kanalisatsiooni vaatluskaev",
      "skos:altLabel": [
        {
          "@value": "Kanalisatsiooni vaatluskaev",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "maapinnale ulatuva luugiga kaev (toru) kanalisatsiooni torustikul",
          "@language": "et"
        },
        {
          "@value": "kanalisatsioonirajatiste hulka kuuluv maapinnale ulatuva avatava luugiga kaev kanalisatsiooni töö jälgimiseks, torustiku ja liivapüüdurite puhastamiseks, pindmise äravooluvee vastuvõtuks, kanalisatsiooni sissepääsuks või ühenduse teostamiseks.",
          "@language": "et"
        },
        {
          "@value": "maapinnale ulatuva luugiga kaev(toru) kanalisatsiooni torustikul",
          "@language": "et"
        },
        {
          "@value": "reovee või sademetevee ning ühisvoolse kanalisatsioonirajatiste hulka kuuluv maapinnale ulatuva avatava luugiga kaev kanalisatsiooni töö jälgimiseks, torustiku ja liivapüüdurite puhastamiseks, pindmise äravooluvee vastuvõtuks, kanalisatsiooni sissepääsuks või liitmike teostamiseks. Maapinnale ulatuv kanalisatsiooniluuk kuulub kanalisatsioonikaevu osana kanalisatsioonirajatiste hulka",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
