      ],
      "skos:prefLabel": {
        "@value": "hooldajatoetuse suurus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühe isiku eest makstav tasu kalendrikuus, mille suurus sõltub hooldatava hooldusvajadusest ja kehtestatud hooldajatoetuse määrast.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
