        }
      ],
      "skos:definition": [
        {
          "@value": "huvikooli õpilaskoha tegevuskulu arvestuslik maksumus, ühe õppuri huvihariduse omandamine ühe õppekava ulatuses.",
          "@language": "et"
        },
        {
          "@value": "huvikooli õpilaskoha tegevuskulu arvestuslik maksumus, ühe õppuri huvihariduse omandamiseks ühe õppekava ulatuses; 5) õppemaks (osalustasu) - lapsevanema poolt tasutav summa huvihariduse või huvitegevuse pakkujale.",
          "@language": "et"
        },
        {
          "@value": "huvikooli ja/või huvitegevuse tegevuskulu arvestuslik maksumus ühe õppija kohta",
          "@language": "et"
        },
        {
          "@value": "huvikooli pidaja poolt kinnitatud huvikooli õppekoha tegevuskulu arvestuslik maksumus ühe õpilase kohta ühe õppekava ulatuses",
          "@language": "et"
        },
        {
          "@value": "huvikooli õpilaskoha tegevuskulu arvestuslik maksumus ühe õpilase huvihariduse omandamiseks ühe õppekava ulatuses",
          "@language": "et"
