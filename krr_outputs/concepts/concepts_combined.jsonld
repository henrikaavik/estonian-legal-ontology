    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1060168_reklaampind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaampind",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Saarde valla haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampinna suurus määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060168_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri ja reklaamimaksu kehtestamise kord Saarde vallas",
      "rdfs:label": "reklaampind (valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1060168)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaampind"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1060168_mobiilne_konstruktsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "mobiilne konstruktsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduk või haagis, mis on välireklaami edastamiseks kohandatud ja mille vahendusel välireklaami edastatakse, samuti reklaami eesmärgil spetsiaalselt paigutatud/pargitud reklaamkirjadega (soodushinnad, allahindlused, müügikuulutused, toodete kaubamärgid, liigid jm) sõiduk. Mobiilne konstruktsioon ei pea olema kantud liiklusregistrisse; 6) reklaamimaks –määruses sätestatud korras maksukohustuslase poolt maksuobjekti osas, suuruses ja tähtaegadel ilma otsese vastutasuta tasumisele kuuluv kohalik maks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060168_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri ja reklaamimaksu kehtestamise kord Saarde vallas",
      "rdfs:label": "mobiilne konstruktsioon (valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1060168)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_mobiilne_konstruktsioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1060168_tagastusnoue",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tagastusnõue",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "seaduses või haldusaktis ettenähtust suuremas summas tehtud makse ja rahalise kohustuse tasumisel või tasaarvestamisel tekkinud enammakse tagasisaamiseks koostatud kirjalik taotlus, mis esitatakse maksuhaldurile reklaamimaksualase maksudeklaratsiooni (edaspidi maksudeklaratsioon) paranduses või muus kirjalikus või kirjalikku taasesitamist võimaldavas vormis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060168_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri ja reklaamimaksu kehtestamise kord Saarde vallas",
      "rdfs:label": "tagastusnõue (valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1060168)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tagastusnoue"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1060168_maksudeklaratsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "maksudeklaratsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "maksuhaldurile esitatav reklaamimaksu arvestamise dokument",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060168_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri ja reklaamimaksu kehtestamise kord Saarde vallas",
