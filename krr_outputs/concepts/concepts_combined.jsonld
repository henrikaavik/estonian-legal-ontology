      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_toetuse_t1056629_institutsionaalselt_akrediteeritud_ulikool_voi_riigi_rakenduskorgkool"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "institutsionaalselt akrediteeritud ülikool või riigi rakenduskõrgkool",
      "skos:definition": [
        {
          "@value": "kõrgkool, mis vastab kõrgharidusseaduse § 38 lõike 3 punktile 1 või 2 või millel on välismaa ülikooli puhul ENIC/NARIC keskuse kinnitus ülikooli tunnustamise kohta",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
