    },
    {
      "@id": "estleg:Concept_laste_koolieelsesse_lasteasutusse_vastuvotu_ja_valjaarvamise_t1052957_osaajaline_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "osaajaline koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "luuakse lasteasutuses vallavalitsuse otsusel erandjuhul, kui ajutiselt on vajadus lasteaiakoha järele suurem kui olemasoleva lasteasutuse üldkohtade arv või juhul, kui laps ei vaja täisajaga kohta või kohta kasutatakse kindlatel nädalapäevadel. Osaajalise koha kasutamisel sõlmivad vanem ja lasteasutuse direktor lepingu, milles määratakse lapse poolt lasteasutuse kasutamise aeg",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052957_Par_2"
        }
      ],
      "estleg:sourceAct": "Laste koolieelsesse lasteasutusse vastuvõtu ja väljaarvamise kord Nõo vallas",
      "rdfs:label": "osaajaline koht (laste_koolieelsesse_lasteasutusse_vastuvotu_ja_valjaarvamise_t1052957)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_osaajaline_koht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_laste_koolieelsesse_lasteasutusse_vastuvotu_ja_valjaarvamise_t1052957_sobitusruhm",
      "@type": [
