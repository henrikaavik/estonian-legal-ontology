      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Ametnik",
      "skos:definition": "isik, kes on vallavalitsusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks. 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040865_Par_3"
        }
      ],
      "estleg:sourceAct": "Lääneranna Vallavalitsuse ametiasutuse palgajuhend",
