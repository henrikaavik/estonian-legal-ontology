    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_huvitatud_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "huvitatud isik",
      "skos:definition": "isik, kes on huvitatud detailplaneeringu algatamisest, vastuvõtmisest, kehtestamisest ja elluviimisest st kelle huvides menetletakse detailplaneeringut; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
