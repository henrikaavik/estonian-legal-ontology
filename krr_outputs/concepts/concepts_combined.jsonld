        "@type": "xsd:integer"
      },
      "rdfs:label": "energiatootmisseade",
      "skos:definition": [
        {
          "@value": "päikese abil ehitusseadustiku § 65 lõike 3 alusel kehtestatud nõuetele vastava elektrienergia, mida kasutatakse eelkõige hoone toimimiseks või kasutamiseks, tootmise seade; 2",
          "@language": "et"
        },
        {
          "@value": "päikese abil elektrit tootev taastuvenergia tootmisseade; 3",
          "@language": "et"
        }
      ]
    },
