    {
      "@id": "estleg:Concept_aseri_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_k_t1004688_arvestusperiood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "arvestusperiood",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "veevarustuse või reovee ärajuhtimise teenuste osutamise periood, mille kohta esitatakse kliendile arve. Arvestusperioodiks on reeglina kalendrikuu. Arvestusperioodi täpse alguse ja lõpu kuupäevadeks on vee-(reovee-) arvesti näidu lugemise kuupäevad, mis määratakse teenuslepingus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1004688_Par_2"
        }
      ],
