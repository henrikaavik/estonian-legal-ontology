    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1052013_avalikult_kasutatav_maa_ala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalikult kasutatav maa-ala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringile kasutamiseks antud ning kasutuses olev üldjuhul hooneteta maa, millel võivad paikneda üksnes abihooned, nt tee, tänav, väljak, parkla, park, puhke- või virgestusala vms. Käesoleva määruse tähenduses ei kuulu kalmistu maa avalikult kasutatava maa-ala hulka",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052013_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
