      }
    },
    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1060663_avalikult_kasutatav_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalikult kasutatav tee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "riigitee, kohalik tee ja avalikuks kasutamiseks määratud eratee. Avalikult kasutatavat teed võib kasutada igaüks õigusaktides sätestatud piiranguid järgides",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060663_Par_2"
        }
      ],
      "estleg:sourceAct": "Erateede avalikuks kasutamiseks määramise kord",
      "rdfs:label": "avalikult kasutatav tee (erateede_avalikuks_kasutamiseks_maaramise_kord_t1060663)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalikult_kasutatav_tee"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1060663_kohalik_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kohalik tee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tee, mille osas omaniku ülesandeid täidab kohaliku omavalitsuse üksus. Kohalik tee võib olla avalikuks kasutamiseks määratud eratee, kohalikule omavalitsuse üksusele kuuluv tee või kohaliku omavalitsuse volikogu otsuse kohaselt kohaliku omavalitsuse hallatav kohaliku liikluse korraldamiseks vajalik muu tee",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060663_Par_2"
        }
      ],
      "estleg:sourceAct": "Erateede avalikuks kasutamiseks määramise kord",
      "rdfs:label": "kohalik tee (erateede_avalikuks_kasutamiseks_maaramise_kord_t1060663)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kohalik_tee"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1060663_pinnastee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pinnastee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tee, millel puudub pealiskiht ja mis on pikaajaliselt väljakujunenud liikumistee looduslikul pinnasel",
        "@language": "et"
      },
      "estleg:definedIn": [
