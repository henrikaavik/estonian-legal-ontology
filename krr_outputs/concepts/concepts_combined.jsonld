        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reoveekogumisala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "keskkonnaministri poolt kinnitatav ala, kus on piisavalt elanikke või majandustegevust reovee ühiskanalisatsiooni kaudu reoveepuhastisse kogumiseks või heitvee suublasse juhtimiseks; 6) inimekvivalent (edaspidi ie) – ühe inimese põhjustatud keskmise ööpäevase tingliku veereostuskoormuse ühik, mida arvutatakse aasta kestel suurima nädala keskmise saasteaine hulga alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1037807_Par_2"
        }
      ],
