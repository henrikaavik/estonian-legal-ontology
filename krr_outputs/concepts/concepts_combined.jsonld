    {
      "@id": "estleg:Concept_tallinna_linna_raamatupidamise_sise_eeskiri_t1013515_linna_oluline_moju",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "linna oluline mõju",
      "skos:definition": "linna omanduses on otse või valitseva mõju all oleva juriidilise isiku kaudu rohkem kui 20% sidusüksuste hääleõigusest, välja arvatud erandjuhud, kus on võimalik selgelt tõlgendada, et sellise hääleõigusega ei kaasne olulist mõju; 23",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013515_Par_3"
        }
      ],
      "estleg:sourceAct": "Tallinna linna raamatupidamise sise-eeskiri",
