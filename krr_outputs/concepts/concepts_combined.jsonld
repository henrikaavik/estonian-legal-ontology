      ],
      "skos:prefLabel": {
        "@value": "Vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühisveevärgi- ja kanalisatsiooni seaduse § 7 alusel kohaliku omavalitsuse poolt määratud juriidiline isik, kes korraldab omavalitsuse haldusterritooriumil reovee ärajuhtimist ja puhastamist.",
        "@language": "et"
      },
      "estleg:definedIn": [
