      "rdfs:label": "liitumisprojekt",
      "skos:altLabel": [
        {
          "@value": "Liitumisprojekt",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ehitusprojekt eelprojekti mahus, tarbimiskoha kommunikatsioonide (sh vee- ja kanalisatsioonitorustike) planeerimiseks ning kooskõlastatakse.",
          "@language": "et"
        },
        {
          "@value": "tarbimiskoha liitumispunktist kuni hoonestuseni märgitud kinnistusiseste võrkude (välisvõrkude) projekt, mille alusel ehitatakse tarbimiskoha veevärk ja kanalisatsioon",
          "@language": "et"
        },
        {
          "@value": "kinnistu liitumispunktist kuni hoonestuseni märgitud kinnistusiseste võrkude (välisvõrkude) projekt, mille alusel ehitatakse kinnistu veevärk ja kanalisatsioon",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni omaniku või valdaja tehniliste tingimuste alusel koostatud dokument (skeem) alates kinnistu liitumispunktist kuni hoonestuseni, mille alusel ehitatakse välja kinnistu veevärk ja kanalisatsioon",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
