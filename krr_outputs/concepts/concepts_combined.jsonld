        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rahvusvaheline külastustaotlus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_riigisaladuse_ja_salastatud_valisteabe_kaitse_kord_t317593_rahvusvaheline_kulastustaotlus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rahvusvaheline külastustaotlus",
      "skos:definition": [
        {
          "@value": "rahvusvahelise külastuse puhul vastuvõtva riigi asjaomasele asutusele esitatav taotlus, mis hõlmab juurdepääsu teise riigi või rahvusvahelise organisatsiooni salastatud teabele, kui see on välislepinguga ette nähtud.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
