          "@language": "et"
        },
        {
          "@value": "turvameetmete loomise, valimise ja rakendamise protsesside kogum, andmete tervikluse, käideldavuse ja konfidentsiaalsuse tagamiseks",
          "@language": "et"
        }
      ],
