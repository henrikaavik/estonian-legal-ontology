        "@type": "xsd:integer"
      },
      "rdfs:label": "abikõlblikkuse periood",
      "skos:definition": [
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning abikõlblik kulu tekib; 3",
          "@language": "et"
        },
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning projekti tegevuste elluviimiseks abikõlblikud kulud tekivad ja makse on toetuse saajale teostatud; 3",
          "@language": "et"
        },
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning projekti tegevuste elluviimiseks abikõlblikud kulud tekivad; 8",
          "@language": "et"
        },
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning projekti tegevuste elluviimiseks vajalikud kulud tekivad ja tasutakse lõppsaaja poolt; 2",
          "@language": "et"
        },
        {
          "@value": "ajavahemik, millal projekti tegevused algavad ja lõppevad ning projekti tegevuste elluviimiseks vajalikud kulud tekivad ja tasutakse; 4",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
