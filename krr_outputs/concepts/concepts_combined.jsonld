        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "teadmussiire",
      "skos:definition": "protsess, mille eesmärk on omandada, koguda ja jagada väljendatavaid ja vaiketeadmisi, sealhulgas oskusi ja pädevust, nii majandusliku kui ka mittemajandusliku tegevuse käigus, näiteks teaduskoostöö, konsulteerimise, litsentsimise, edasiarenduse, avaldamise ning teadlaste ja nimetatud tegevusaladega seotud muude töötajate liikuvuse kaudu; lisaks teaduslikele ja tehnoloogilistele teadmistele hõlmab see muud liiki teadmisi, näiteks teadmisi standardite ja standardeid sisaldavate õigusaktide kasutamise kohta ning tegelike töötingimuste ja organisatsiooniinnovatsiooni meetodite kohta ja immateriaalse vara kindlakstegemise, omandamise, kaitsmise ja kasutamisega seotud teadmiste haldamist; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059326_Par_2"
        }
      ],
