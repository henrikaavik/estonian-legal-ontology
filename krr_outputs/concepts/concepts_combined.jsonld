    {
      "@id": "estleg:Concept_maardu_linna_eelarve_koostamise_vastuvotmise_ja_taitmise_kor_t1044863_eelarve",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eelarve",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eelarveaasta põhitegevuse tulude, põhitegevuse kulude, investeerimistegevuse, finantseerimistegevuse ja likviidsete varade muutuse plaan koos täiendavate nõuete, volituste ja informatsiooniga, mis on aluseks kohaliku omavalitsuse üksuse vastava aasta tegevuste finantseerimisele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044863_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna eelarve koostamise, vastuvõtmise ja täitmise kord",
      "rdfs:label": "eelarve (maardu_linna_eelarve_koostamise_vastuvotmise_ja_taitmise_kor_t1044863)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eelarve"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_maardu_linna_eelarve_koostamise_vastuvotmise_ja_taitmise_kor_t1044863_eelarvestrateegia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eelarvestrateegia",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "arengukavast tulenev finantsplaan nelja eelseisva eelarveaasta kohta; 3) vastuvõetud eelarve– volikogu poolt eelarveaastaks kinnitatud esimene eelarve; 4) lisaeelarve– vastuvõetud eelarve muutmiseks eelarve kogumahu suurenemisel või vähenemisel koostatud eelarve; 5) alaeelarve– vastuvõetud eelarve või lisaeelarve baasil hallatavate asutuste tulude ja kulude jaotus tululiikide, tegevusalade ja kululiikide lõikes; 6) eelarve tulem– põhitegevuse tulude eelarveosa kogusumma ja põhitegevuse 7) investeering– põhivara soetus ja sellega kaasnev käibemaksukulu seoses objekti ehitamise või renoveerimisega või vara soetamisega; 8) kulujuht- osakonna, asutuse ettevõte jne kuludokumentide kinnitamise õigust omav juht, kelle poolt juhitava struktuuri kulude katteks on linnaeelarvest ette nähtud finantseerimine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044863_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna eelarve koostamise, vastuvõtmise ja täitmise kord",
      "rdfs:label": "eelarvestrateegia (maardu_linna_eelarve_koostamise_vastuvotmise_ja_taitmise_kor_t1044863)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eelarvestrateegia"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_maardu_linna_eelarve_koostamise_vastuvotmise_ja_taitmise_kor_t1044863_eelarve_tegevusalakoodid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
