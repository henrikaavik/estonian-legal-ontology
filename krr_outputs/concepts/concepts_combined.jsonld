        "@id": "estleg:Concept_omapuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1052981_omapuhasti_isiklikus_majapidamises",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti isiklikus majapidamises",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reoveepuhasti jõudlusega alla 50 inimekvivalendi alaliik lisatingimusega, et seda puhastit kasutab vaid üks majapidamine oma isiklikul eesmärgil",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052981_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
