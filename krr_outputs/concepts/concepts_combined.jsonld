        }
      ]
    },
    {
      "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Ameti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Ameti",
      "skos:definition": "ja tööalane rikkumine - ametniku või töötaja ametijuhendist ja töölepingust tulenevate ülesannete mittekohane täitmine. 3",
      "estleg:definedIn": [
