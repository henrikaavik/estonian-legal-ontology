      "rdfs:label": "maksumaksja",
      "skos:altLabel": [
        {
          "@value": "Maksumaksja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "füüsilisest või juriidilisest isikust reklaami paigaldaja või avalikustaja",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kes avalikustab (paigaldab) käesoleva määruse § 2 lõike 2 punktis 1 nimetatud reklaami",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kes on paigaldanud käesoleva määruse kohaldamisalasse kuuluva reklaami",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kes on paigaldanud käesoleva määruse § 2 punktis 6 nimetatud reklaami",
          "@language": "et"
        },
        {
          "@value": "isik, kelle tehtud tehingu väärtust käesoleva määruse alusel käsitletakse",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
