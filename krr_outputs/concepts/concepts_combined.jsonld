      "skos:definition": [
        {
          "@value": "käesoleva korra alusel valitud isik, kes on külaelanike ühiste huvide esindaja, kes juhindub oma tegevuses küla ühistest seisukohtadest, külas väljakujunenud tavadest, küla ja valla arengukavast, Eesti Vabariigi seadustest ja teistest õigusaktidest. Olukordades, kus tegevus ei ole reguleeritud kehtivate õigusaktidega, tegutseb külavanem lähtudes headest tavadest. 4 (",
          "@language": "et"
        },
        {
          "@value": "valla asustusüksuse esindaja, kes on valitud hääleõiguslike asustusüksuse elanike poolt statuudi alusel ning juhindub oma tegevuses küla ühistest huvidest ja seisukohtadest. Külavanem on küla ühendaja, hoidja ja innustaja ning on riigi ja kohaliku omavalitsuse ametlikult tunnustatud kontaktisik külas.",
          "@language": "et"
        },
        {
          "@value": "vähemalt 18-aastane külas püsivalt elav külaelanike ja nende ühiste huvide esindaja.",
          "@language": "et"
        }
      ]
    },
