        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Perekonna sissetulek",
      "skos:definition": "toetuse määramisel arvestatakse toetuse saaja ja tema perekonnaliikmete netosissetulekuid ning perekonnaseadusest tulenevat ülalpidamiskohustust. Sissetulekute hulka ei arvata sotsiaalhoolekande seaduse § 133 lõikes 2 nimetatud toetusi. 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054418_Par_2"
        }
      ],
