        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "terviklik rekonstrueerimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "projekt, millega teostatakse kompleksselt § 6 lõikes 2 nimetatud nõuetele vastavalt vähemalt välisseinte ja katuse soojustamine, akende vahetamine, rekonstrueeritakse küttesüsteem ja paigaldatakse soojustagastusega sissepuhke-väljatõmbe ventilatsioonisüsteem; toetuse saaja – paragrahvi 1 lõikes 4 nimetatud juhul üldtingimuste määruse § 3 punktis 5 nimetatud lõppsaaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049699_Par_3"
        }
      ],
      "estleg:sourceAct": "Väikeelamute energiatõhususe suurendamise toetuse kasutamise tingimused ja kord",
