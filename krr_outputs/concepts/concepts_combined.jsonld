      },
      "rdfs:label": "hindamisinstrument",
      "skos:definition": [
        {
          "@value": "ette antud struktuuriga kirjalik dokument, milles antakse hinnang isiku tegevusvõimele, kõrvalabi, juhendamise või isiku järelevalve vajadusele ning tuuakse ära isiku iseseisvaks toimetulekuks ja sotsiaalseks integreerumiseks vajalikud tegevused",
          "@language": "et"
        },
        {
          "@value": "hindamise vahend, mis vaatleb mitmekülgselt teenust vajava isiku toimetulekut keskkonnas (majanduslikke, sotsiaalseid, psühholoogilisi ja muid probleeme)",
          "@language": "et"
        },
        {
          "@value": "küsimustik, mille abil selgitatakse välja isiku hooldusvajadus",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
