        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötulemuste hindamise alusel püstitatud eesmärkide saavutamisel konkreetse töö või perioodi erakordse tulemuse või linnale olulise projekti tulemusliku lõpetamise eest makstav täiendav tasu; 2026-01-27",
        "@language": "et"
      },
