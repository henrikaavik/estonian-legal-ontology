        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toimetulekuraskustes või riskirühma pere",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pere, kus kasvab erivajadusega laps, kus kasvab kolm või enam alaealist last, kus puudub teise vanema toetus, kus üks lapsevanem on töötu või tema tervislik seisund ei võimalda töötamist või pere, kus perekonna sissetulek pereliikme kohta jääb alla kahekordset toimetulekupiiri. (Toimetulekupiir käesoleva korra tähenduses on Riigikogu kehtestatud toimetulekupiir.).",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
