        {
          "@value": "asutuse korraldatav kauba või teenuse müük (sh kandekaubandus) selle asutuse korraldatud avalikul üritusel",
          "@language": "et"
        },
        {
          "@value": "kauplemine või teenuse osutamine laadal ning meelelahutuslikel, kultuuri-, sporditemaatilistel ja muudel avalikkusele suunatud üritusel",
