      }
    },
    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1054227_avalikult_kasutatav_maa_ala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalikult kasutatav maa-ala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringile kasutamiseks antud ning kasutuses olev üldjuhul hooneteta maa (nt tee, tänav, väljak, park, puhke- või virgestusala vms) sõltumata omandiliigist; 2) müügikoht- koht, kus kaupleja vahetult pakub ja müüb kaupa või pakub ja osutab teenust; 3) kaup- pakutav, müüdav või muul viisil turustatav asi või õigus; 4) teenus- pakutav, osutatav või muul viisil turustatav hüve, mis ei ole kaup, või muu pakutav või tehtav sooritus; 5) kaubanduse korraldaja- Toila Vallavalitsus, Toila Vallavalitsuse hallatav asutus, avaliku ürituse korraldaja või maa-ala valdaja või omanik, kes majandus- või kutsetegevuse raames korraldab tänavakaubandust või kaubandust avalikul üritusel, sealhulgas laadal ja messil; 6) kaupleja- füüsiline või juriidiline isik, sealhulgas avalik-õiguslik juriidiline isik, kes majandus- või kutsetegevuse raames pakub ja müüb kaupa või pakub ja osutab teenust; 7) müügipilet- kaubanduse korraldaja poolt väljastatud dokument, mille alusel võib sellel märgitud tingimustel kaupa või teenust müüa.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054227_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
      "rdfs:label": "avalikult kasutatav maa-ala (avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1054227)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalikult_kasutatav_maa_ala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
