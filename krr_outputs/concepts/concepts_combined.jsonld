      ],
      "skos:prefLabel": {
        "@value": "iseseisev õpe",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tööalaste teadmiste ja oskuste täiendamine läbi iseseisva lugemise ja õppematerjalide ning valdkonna kirjanduse läbitöötamise (hõlmab võimalust tellida valdkondlikku ajakirjandust, õpikuid jm koolitusmaterjale).",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058534_Par_2"
        }
      ],
