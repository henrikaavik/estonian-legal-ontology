      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_kinnistu"
        }
      ]
    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_kinnistu_kasutaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kinnistu kasutaja",
      "skos:definition": "kinnisasja juriidilisest või füüsilisest isikust omanik, hoonestusõiguse omanik või korteriühistu olemasolu korral ühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorranõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest; 10",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
      "rdfs:label": "kinnistu kasutaja (peipsiaare_valla_heakorra_eeskiri_t1044621)",
