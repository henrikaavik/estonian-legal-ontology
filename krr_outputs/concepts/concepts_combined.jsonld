      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Põhipalk",
      "skos:definition": "teenistuja palga fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal. 8",
