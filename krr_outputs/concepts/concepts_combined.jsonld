      "rdfs:label": "ühisveevärk",
      "skos:altLabel": [
        {
          "@value": "Ühisveevärk",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ehitiste, rajatiste ja seadmete kompleks mitme kinnistu veega varustamiseks ning vee kasutamiseks kahjutule tõrjumisel, kui selleks ei ole ette nähtud muid veevõtukohti. Ühisveevärgi ehitiste, rajatiste ja seadmete kompleks on vee-ettevõtja hallatav või teenindab vähemalt 50 elanikku; 37",
          "@language": "et"
        },
        {
          "@value": "ehitiste ja seadmete süsteem, mille kaudu varustatakse tarbijaid joogiveega.",
          "@language": "et"
        },
        {
          "@value": "ehitiste, rajatiste ja seadmete kompleks mitme kinnistu veega varustamiseks ning vee kasutamiseks kahjutule tõrjumisel, kui selleks ei ole ette nähtud muid veevõtukohti. Ühisveevärgi ehitiste, rajatiste ja seadmete kompleks on vee-ettevõtja hallatav või teenindab vähemalt 50 elanikku; 38",
          "@language": "et"
        },
        {
          "@value": "ehitiste ja seadmete kompleks kinnistute veega varustamiseks ja vee kasutamiseks kahjutule tõrjumisel ning mis on vee-ettevõtja hallatav või teenindab vähemalt 50 elanikku; 37",
          "@language": "et"
        },
        {
          "@value": "ehitiste ja seadmete kompleks kinnistute veega varustamiseks ning vee kasutamiseks kahjutule tõrjumisel, kui selleks ei ole ette nähtud muid veevõtukohti; 31",
          "@language": "et"
        }
