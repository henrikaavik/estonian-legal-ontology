          "@id": "estleg:Concept_energiamojuga_toodete_energia_ja_muude_ressursside_tarbimise_t1003070_energiamargistus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiamärgistus",
      "skos:definition": [
        {
          "@value": "rakendusmeetmes sätestatud nõuetele vastav teave toote kohta, mis sisaldab infot toote elektrienergia, muude energialiikide ja vajaduse korral muude oluliste ressursside tarbimise kohta toote kasutamise ajal; 3",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_energiamargistuse_loata_kasutamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
