        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tootenäidis",
      "skos:definition": [
        {
          "@value": "taotluses kirjeldatud ja taotleja või toetuse saaja poolt valmistatud või tellitud näidis taotluse esitamise hetkeks juba tootmises olevast sihtturule eksporditavast tootest; 7",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tootja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tootja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_paritolutunnistuse_valjastamise_voorandamise_ja_kustutamise__t1054739_tootja"
        },
        {
          "@id": "estleg:Concept_taastuvast_energiaallikast_toodetava_elektrienergia_osakaalu_t157212_tootja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tootja",
      "skos:definition": [
        {
          "@value": "elektriettevõtja, kes toodab elektrienergiat taastuvatest energiaallikatest, kombineeritult taastuvast ja muust energiaallikast või tõhusa koostootmise režiimil elektrituruseaduse tähenduses. RT I 2024-02-16 1 116022024001 2024-02-19",
          "@language": "et"
        },
        {
          "@value": "isik, kes on tootmisseadmega seotud mõõtepunkti võrgulepingu osapool ning kelle toodetud energia päritolu tõendamiseks väljastab päritolutunnistuste süsteemi haldaja (edaspidi süsteemihaldaja ) päritolutunnistusi. RT I 2026-03-19 7 119032026007 2026-03-22",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_toote"
        }
      ]
    },
