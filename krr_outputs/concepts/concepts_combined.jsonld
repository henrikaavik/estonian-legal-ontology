          "@id": "estleg:Concept_kohtla_jarve_jaatmehoolduseeskiri_t1050158_tervishoiu"
        },
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_tervishoiu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tervishoiu",
      "skos:definition": [
        {
          "@value": "ja veterinaarjäätmed on tervishoiu-, hoolekande- või veterinaarteenuse osutamisel tekkinud nakkusohtlikud, bioloogilised, ravimi- ja muud jäätmed; 35",
          "@language": "et"
        },
        {
          "@value": "ja veterinaarteenuse osutamisel tekkinud jäätmed - jäätmed, mis kuuluvad tervishoiu ja veterinaarteenuste osutamise kohas, sh mikrobioloogia ja viroloogia laboratooriumid, eraldi kogumisele teistest jäätmevoogudest- diskreetne vanapaber, bioloogilised jäätmed, teravad ja torkivad jäätmed, nakkusohtlikud jäätmed; 35",
          "@language": "et"
        }
      ]
    },
