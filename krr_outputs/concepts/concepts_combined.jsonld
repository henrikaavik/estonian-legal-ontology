      "estleg:definesConcept": {
        "@id": "estleg:Concept_hooldaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_taisealisele_isikule_hoolduse_seadmise_hooldaja_maaramise_ja_t1043261_Hooldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Hooldus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vajaliku kõrvalabi, juhendamise ja järelvalve tagamine isikule, kes ei tule iseseisvalt toime söömise, hügieenitoimingute, riietumise, liikumise või suhtlemisega või kes oma tegevuse või tegevusetusega võib tekitada kahju iseenda või teiste inimeste elule, tervisele või varale.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043261_Par_2"
        }
      ],
      "estleg:sourceAct": "Täisealisele isikule hoolduse seadmise, hooldaja määramise ja hooldajatoetuse maksmise kord Haapsalu linnas",
