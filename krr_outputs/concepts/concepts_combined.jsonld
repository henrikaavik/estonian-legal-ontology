      "rdfs:label": "avariitöö",
      "skos:definition": [
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud käesoleva korraga kehtestatud korras; 3",
          "@language": "et"
        },
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud käesoleva määrusega kehtestatud korras; 3",
          "@language": "et"
        },
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud vastavalt käesoleva määruse §-le 9; 3",
          "@language": "et"
        },
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud Viimsi Vallavalitsuse (edaspidi vallavalitsus ) määrusega kehtestatud korras; 3",
          "@language": "et"
        },
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud; 3",
          "@language": "et"
        }
      ],
