          "@id": "estleg:Concept_preemia"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_lisatasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "lisatasu",
      "skos:definition": "seaduse alusel makstav lisatasu valveaja, ületunnitöö, ööajal tehtava töö ja riigipühadel tehtava töö eest; 11",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040965_Par_2"
        }
      ],
