      "skos:definition": [
        {
          "@value": "puu likvideerimine juurekaelalt, puu tavapärase võra vähendamine rohkem kui 25% võrra, puu mõõtmete vähendamine selliselt, et puu kõrgus jääb madalamaks kui 6 m ning puu võra laius jääb väiksemaks kui 2 m",
          "@language": "et"
        },
        {
          "@value": "puu likvideerimine juurekaelalt; puu tavapärase võra vähendamine rohkem kui 25 % võrra; puu mõõtmete vähendamine selliselt, et puu kõrgus jääb madalamaks kui 6 m ning puu võra laius jääb väiksemaks kui 2 m",
          "@language": "et"
