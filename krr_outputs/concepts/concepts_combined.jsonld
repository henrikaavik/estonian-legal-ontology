    {
      "@id": "estleg:Concept_marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265_ERC_grant",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ERC grant",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ERC välja antav grant, mis on avatud kõigi teadusvaldkondade teadlastele, mille ainukeseks hindamiskriteeriumiks on teaduslik tipptase. ERC annab välja ERC alustava teadlase granti, iseseisvuse saavutanud teadlase granti, kogenud teadlase granti, sünergia granti ning ERC Plus granti, mis ületavad ERC tavagrandi mahtu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1063265_Par_2"
        }
      ],
      "estleg:sourceAct": "Marie Skłodowska Curie Action järeldoktori individuaalgrandi ja ERC grandi taotlemise edukuse tõstmiseks toetuse taotlemise, toetuse eraldamise ning toetuse tagasinõudmise tingimused ja kord",
      "rdfs:label": "ERC grant (marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_erc_grant"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
