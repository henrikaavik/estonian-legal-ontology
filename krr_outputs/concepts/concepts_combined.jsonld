    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101_huvitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "huvitegevus",
      "skos:definition": "lühiajaline süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest ja kutseõppest vabal ajal, et omandada süvendatud teadmisi ja oskusi valitud huvialal kultuuri, spordi, muusika, kunsti, loodus- ja täppisteaduste või tehnoloogia valdkondades. Huvitegevusega tegeletakse huviringides, klubides, stuudiotes jne; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1045101_Par_2"
