    {
      "@id": "estleg:Concept_erc_grant",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ERC grant",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265_ERC_grant"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ERC grant",
      "skos:definition": [
        {
          "@value": "ERC välja antav grant, mis on avatud kõigi teadusvaldkondade teadlastele, mille ainukeseks hindamiskriteeriumiks on teaduslik tipptase. ERC annab välja ERC alustava teadlase granti, iseseisvuse saavutanud teadlase granti, kogenud teadlase granti, sünergia granti ning ERC Plus granti, mis ületavad ERC tavagrandi mahtu",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_erijuhtum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "erijuhtum",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_erijuhtum"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "erijuhtum",
      "skos:definition": [
        {
          "@value": "erandlik hindamisjuhtum, mille korral valdkondade kaupa tegutsemisvõimet hinnates on inimese tegutsemise ja osalemise piirangud vähe väljendunud ja ei vasta osalise või puuduva töövõime kriteeriumitele, kuid tema töötamine on terviseseisundi tõttu osaliselt või täielikult takistatud",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_erikamber",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "erikamber",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_nouded_kaitsevae_arestimajale_ja_kinnipidamiseks_kohandatud_t1012309_erikamber"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "erikamber",
      "skos:definition": [
        {
          "@value": "ühekohaline erisisustusega kamber agressiivse käitumisega distsiplinaarkinnipidamisel oleva kaitseväelase kinnipidamiseks. Kaitseväe kinnipidamiskamber on Kaitseväe territooriumil või Kaitseväe ajutisel julgeolekualal paiknevas hoones kaitseväelaste kinnipidamiseks distsiplinaarkinnipidamiskambrile või agressiivse käitumisega isiku erikambrile esitatavate nõuetele vastav ruum, mille juurde kuulub võimalusel jalutusala. Kaitseväelaste kinnipidamiseks kohandatud ruum on Kaitseväe julgeolekualal või Kaitseliidu territooriumil paiknev ruum, mis ei ole kaitseväelaste kinnipidamiseks ehitatud, kuid mida võib vajadusel kinnipidamiseks kasutada.",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_urnikamber"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
