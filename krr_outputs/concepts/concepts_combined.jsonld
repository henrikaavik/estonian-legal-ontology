        "@id": "estleg:Concept_kaevetoode_luba"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_valla_heakorra_ja_kaevetoode_eeskiri_t1059297_kaevetoode_teostaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaevetööde teostaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle nimele on vormistatud kaevetööde luba või kes on asunud teostama avariikaevetöid.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059297_Par_2"
        }
      ],
      "estleg:sourceAct": "Vormsi valla heakorra ja kaevetööde eeskiri",
