      "estleg:definitionCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "reoveepuhasti",
      "skos:altLabel": [
        {
          "@value": "Reoveepuhasti",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kogum kindlate dimensioonidega rajatisi ja seadmeid, milles ühiskanalisatsioonivõrgu kaudu või eeskirjas reguleeritud muul viisil kogutud reovesi puhastatakse tasemeni, et seda võib keskkonda ohustamata loodusesse juhtida.",
          "@language": "et"
        },
        {
          "@value": "kogum kindlate dimensioonidega rajatisi, milles ühiskanalisatsioonivõrgu kaudu või muul käesolevas eeskirjas reguleeritud viisil kogutud reovesi puhastatakse nõnda, et seda võib keskkonda ohustamata loodusesse heita",
          "@language": "et"
        },
        {
          "@value": "kogum kindlate dimensioonidega rajatisi, milles ühiskanalisatsioonivõrgu kaudu või muul käesolevas eeskirjas reguleeritud viisil kogutud reovesi puhastatakse nõnda, et seda võib keskkonda ohustamata loodusesse edastada; 31) sademete- ja drenaaživesi ning muu pinnase- ja pinnavesi – loodusliku päritoluga ühiskanalisatsiooni juhitav vesi, mis ei ole reovesi",
          "@language": "et"
        },
        {
          "@value": "kogum rajatisi, milles ühiskanalisatsioonivõrgu kaudu kogutud reovesi puhastatakse nõnda, et seda võib keskkonda ohustamata loodusesse heita",
          "@language": "et"
        },
        {
          "@value": "kogum rajatisi, milles ühiskanalisatsioonivõrgu kaudu kogutud reovesi puhastatakse selliselt, et seda võib keskkonda ohustamata loodusesse heita",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
