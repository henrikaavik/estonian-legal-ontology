    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_lokaalne_taastuvenergia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "lokaalne taastuvenergia",
      "skos:definition": "ehitusseadustiku § 65 lõike 3 alusel kehtestatud nõuetele vastav energia, mida kasutatakse eelkõige hoone toimimiseks või kasutamiseks; 7 7<sup>1</sup>) muinsus- ja miljööväärtuslik korterelamu – üld- või detailplaneeringu alusel miljööväärtuslikule hoonestusalale jääv, väärtusliku üksikobjektina määratletud, kultuurimälestiseks tunnistatud, muinsuskaitsealal asuv või UNESCO maailmapärandi nimekirja kantud alal asuv korterelamu; RT I 2024-09-24 1 124092024001 2024-09-27 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
      "rdfs:label": "lokaalne taastuvenergia (korterelamute_energiatohususe_toetuse_tingimused_t1056183)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_lokaalne_taastuvenergia"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_lokaalne_taastuvenergia"
        }
      ]
    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_moodetud_energiakasutuse_andmetel_pohinev_energiamargis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "mõõdetud energiakasutuse andmetel põhinev energiamärgis",
      "skos:definition": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis; 8 8<sup>1</sup>) naabruskonnapõhine rekonstrueerimine – kahe või enama ruumiliselt seotud korterelamu rekonstrueerimine, mille rekonstrueerimistööde ostumenetlus korraldatakse samadele korterelamutele ühiselt või projekteerimise ja rekonstrueerimistööde ostumenetlus on korraldatud korterelamutele ühiselt ja selliste ostumenetluste tulemusel leitud edukas pakkuja teostab töid kõigile ostumenetluses kaasatud korterelamutele; RT I 2025-07-11 1 111072025001 2025-07-14 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
      "rdfs:label": "mõõdetud energiakasutuse andmetel põhinev energiamärgis (korterelamute_energiatohususe_toetuse_tingimused_t1056183)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_moodetud_energiakasutuse_andmetel_pohinev_energiamargis"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_moodetud_energiakasutuse_andmetel_pohinev_energiamargis"
        }
      ]
    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_projekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "projekt",
      "skos:definition": "toetuse ja vajadusel omafinantseeringuga teostatav määruse nõuetele vastav rekonstrueerimiseks vajalik tehnilise konsultandi teenuse osutamine, ehitusprojekti koostamine, rekonstrueerimistööd ja omanikujärelevalve, millega kaasnevate kulude hüvitamiseks toetust taotletakse ja kasutatakse; 10",
      "estleg:definedIn": [
