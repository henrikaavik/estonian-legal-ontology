      },
      "rdfs:label": "osalustasu",
      "skos:definition": [
        {
          "@value": "lapsevanema poolt makstav tasu eralasteaias või -lastehoius, mis ei sisalda toidukulu.",
          "@language": "et"
        },
        {
          "@value": "lasteaia kulude (majandamiskulud, personali töötasu ja sotsiaalmaks ning õppevahendite kulud) vanemate poolt kaetava osa määr, mille kinnitab Saue Vallavolikogu.",
          "@language": "et"
        },
        {
          "@value": "lasteaia majandamiskulude, personali töötasu ja sotsiaalmaksu ning õppevahendite kulude osaline katmine vanema poolt",
          "@language": "et"
        },
        {
          "@value": "lasteaia muude kulude lapsevanema poolt kaetava osa määr, mille kinnitab Saaremaa Vallavolikogu",
          "@language": "et"
        },
        {
          "@value": "lasteaia muude kulude vanema poolt kaetava osa määr, mille kinnitab Keila Linnavolikogu",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
