      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Toidukulu",
      "skos:definition": "lapse toidukulu lasteaias, mille katab vanem. Toidukulu päevamaksumuse kehtestab Viljandi Linnavalitsus (edaspidi linnavalitsus ), kusjuures toidukulu päevamaksumusest moodustab hommikusöök 25%, lõunasöök 45% ja oode 30% (edaspidi toidukorrad ). 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061761_Par_2"
        }
      ],
      "estleg:sourceAct": "Lasteaia toidu- ja õppekulu arvestamise, maksmise ja soodustuse taotlemise kord",
      "rdfs:label": "Toidukulu (lasteaia_toidu_ja_o_ppekulu_arvestamise_maksmise_ja_soodustu_t1061761)",
