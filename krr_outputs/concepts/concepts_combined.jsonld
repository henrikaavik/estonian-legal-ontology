        },
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmevaldaja"
        },
        {
          "@id": "estleg:Concept_narva_linna_jaatmehoolduseeskiri_t1056868_jaatmevaldaja"
        },
        {
          "@id": "estleg:Concept_toila_valla_jaatmehoolduseeskiri_t1056448_jaatmevaldaja"
        },
        {
          "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_jaatmevaldaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "jäätmevaldaja",
      "skos:definition": [
        {
          "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu- või äriruum",
          "@language": "et"
        },
        {
          "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu-, äri- või tootmisruum",
          "@language": "et"
        },
        {
          "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel kinnisasja omanik, millel asub suvila, elu- või äriruum",
          "@language": "et"
        },
        {
          "@value": "jäätmetekitaja või muu isik, riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed",
          "@language": "et"
        },
        {
          "@value": "on jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu- või äriruum",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_jaatmevedaja"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
