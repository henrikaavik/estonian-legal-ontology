    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_reklaampind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "reklaampind",
      "skos:definition": "tasapinnaline või ruumiline objekt, mis paigaldatakse Raasiku valla haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025627_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla reklaamimäärus",
      "rdfs:label": "reklaampind (raasiku_valla_reklaamimaarus_t1025627)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaampind"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_reklaampind"
        }
      ]
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_mobiilne_valireklaami_alus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "mobiilne välireklaami alus",
      "skos:definition": "sõiduk, haagis, või muu ratastel ja sõidukiga teisaldatav konstruktsioon, mis on välireklaami edastamiseks kohandatud ja mille vahendusel välireklaami edastatakse, samuti reklaami eesmärgil valla haldusterritooriumile spetsiaalselt paigutatud või pargitud reklaamkirjadega sõiduk. Mobiilne välireklaami alus ei pea olema kantud liiklusregistrisse; 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025627_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla reklaamimäärus",
