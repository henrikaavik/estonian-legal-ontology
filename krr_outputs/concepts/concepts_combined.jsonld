    {
      "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_kaevandustoostus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kaevandustööstus",
      "skos:definition": "kõik isikud, kes tegelevad ärieesmärkidel maavarade peal- või allmaakaevandamisega, sealhulgas kaevandamisega puuraukude kaudu või kaevandatud materjali rikastamisega; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000061_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaevandamisjäätmete käitlemise kord",
      "rdfs:label": "kaevandustööstus (kaevandamisjaatmete_kaitlemise_kord_t1000061)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kaevandustoostus"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_kaevandustoostus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_rikastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "rikastamine",
      "skos:definition": "maavaradega tehtavad mehaanilised, füüsikalised, bioloogilised, termilised või keemilised protsessid või nende protsesside kombinatsioon (sealhulgas karjääride tegevus), mille käigus eraldatakse maavara vähemväärtuslik osa väärtuslikumast osast või muudetakse materjali tükisuurust või sorteeritakse materjali või toimub materjali leostumine või eraldumine ning eelnevalt kõrvale jäetud jäätmete ümbertöötamine, välja arvatud sulatamine, termilised tootmisprotsessid (välja arvatud lubjakivi põletamine) ja metallurgiatööd; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000061_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaevandamisjäätmete käitlemise kord",
      "rdfs:label": "rikastamine (kaevandamisjaatmete_kaitlemise_kord_t1000061)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_rikastamine"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_rikastamine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_rikastamisjaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "rikastamisjäätmed",
      "skos:definition": "pärast maavara väärtuslikuma osa vähemväärtuslikust kivimist eraldamist (nt purustamist, peenestamist, suuruse järgi sorteerimist, flotatsiooni ja muude füüsikalis-keemiliste tehnoloogiate rakendamist) järele jäävad tahked või vedelad jäätmed; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000061_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaevandamisjäätmete käitlemise kord",
