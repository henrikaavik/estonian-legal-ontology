      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_nouded_energiamargise_andmisele_ja_energiamargisele_t1029420_kraadpaev"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kraadpäev",
      "skos:definition": [
        {
          "@value": "hoone sisetemperatuuri ja välisõhu temperatuuri vahet iseloomustav näitaja, mille ühikuks on Celsiuse skaala (°C) järgi ühekraadine temperatuurierinevus arvestusliku sisetemperatuuri ja ööpäeva ehk 24-tunnise ajavahemiku keskmise välisõhu temperatuuri vahel",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
