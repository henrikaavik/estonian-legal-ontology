        "@id": "estleg:Concept_aktsepteerimine"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_aktsepteerimine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tori_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055533_Aruandeperiood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Aruandeperiood",
      "skos:definition": "periood, mille jooksul toimunud majandustehingute kirjendid võetakse arvesse aruannete koostamisel. Lühim aruandeperiood on kalendrikuu. Majandusaasta aruandeperiood on kalendriaasta. 4 (",
