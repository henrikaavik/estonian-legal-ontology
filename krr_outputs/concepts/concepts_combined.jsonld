      ],
      "skos:prefLabel": {
        "@value": "jäätmete kogumine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmete kokku korjamine, sealhulgas jäätmete eelsortimine ja eelladustamine ning mehaaniline töötlemine ilma jäätmete koostist ja olemust muutmata, eesmärgiga vedada need edasiseks käitlemiseks jäätmekäitluskohta",
        "@language": "et"
      },
