        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ühisveevärk ja kanalisatsioon",
      "skos:definition": [
        {
          "@value": "ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reovee kanaliseerimine ja mis on vee-ettevõtja hallatav. Ühisveevärgi ja kanalisatsioonina käsitatakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat üheskoos. Sademetevee kanalisatsiooni ei käsitleta ühiskanalisatsioonina; 24",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_uhisveevark_ja_kanalisatsioon_2"
        }
      ]
