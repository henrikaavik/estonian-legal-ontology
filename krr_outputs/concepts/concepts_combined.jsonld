        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tegevustoetus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "toetuseliik, millega toetatakse muuseumi põhitegevust ja arengut tervikuna, eesmärgiga säilitada või tõsta tema võimekust. Tegevustoetuse hulka ei loeta investeeringuid põhivarasse ega muid sihtotstarbelisi toetusi.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057348_Par_2"
        }
      ],
      "estleg:sourceAct": "Riigieelarvest muuseumide tegevustoetuse taotlemise, taotleja hindamise ja toetuse määramise tingimused ja kord",
