      "skos:definition": [
        {
          "@value": "reovee kogumismahuti, omapuhasti või kuivkäimla kogumismahuti",
          "@language": "et"
        },
        {
          "@value": "kogumismahuti, reovee eelpuhasti või omapuhasti",
          "@language": "et"
        },
        {
          "@value": "reovee kogumismahuti ja sellega lahutamatult seotud lokaalne torustik",
          "@language": "et"
        },
        {
          "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (sh kuivkäimla), puhastamiseks (sh septik) või maapinda immutamiseks",
          "@language": "et"
        },
        {
