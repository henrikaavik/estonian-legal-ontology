      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevaldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu- või äriruum",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056448_Par_3"
        }
      ],
      "estleg:sourceAct": "Toila valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevaldaja (toila_valla_jaatmehoolduseeskiri_t1056448)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevaldaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toila_valla_jaatmehoolduseeskiri_t1056448_jaatmekaitleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmekäitleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidiline või füüsiline isik, kes kogub, veab, taaskasutab või kõrvaldab jäätmeid majandus- või kutsetegevusena ja kellel on selleks tegevuseks vastav keskkonnakaitseluba",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056448_Par_3"
        }
      ],
      "estleg:sourceAct": "Toila valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmekäitleja (toila_valla_jaatmehoolduseeskiri_t1056448)",
