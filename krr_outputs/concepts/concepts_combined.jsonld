        }
      ],
      "skos:definition": [
        {
          "@value": "spordi-, kultuuri- või meelelahutusüritus, avalik koosolek või muu selline üritus, mille korraldamiseks on väljastatud avaliku ürituse luba; 2",
          "@language": "et"
        },
        {
          "@value": "spordi-, kultuuri- või meelelahutusüritus, avalik koosolek või muu selline sündmus, mille korraldamiseks on väljastatud avaliku ürituse luba; 2",
          "@language": "et"
        },
        {
          "@value": "avalik üritus korrakaitseseaduse § 58 lõike 3 tähenduses; 4",
          "@language": "et"
        },
        {
          "@value": "avalikus kohas Rapla valla haldusterritooriumil korraldatav avalikkusele suunatud üritus. 3",
          "@language": "et"
        },
        {
          "@value": "avalikus kohas toimuv ja avalikkusele avatud lõbustusüritus, võistlus, etendus, kaubandusüritus, või muu sellesarnane inimeste koos olemine, mis ei ole koosolek; 5",
          "@language": "et"
