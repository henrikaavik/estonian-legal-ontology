        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on olmetingimustes või tööstuses kasutatud vesi, mille saasteainete hulk ületab lubatud piirmäära, ja mida tuleb enne suublasse või pinnasesse juhtimist puhastada",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048980_Par_2"
        }
      ],
