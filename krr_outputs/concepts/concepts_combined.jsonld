    {
      "@id": "estleg:Concept_poltsamaa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1059391_Valla_oluline_moju",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Valla oluline mõju",
      "skos:definition": "RTJ 11 punkti 8 kohaselt valla osalusega sidusettevõtted, s.o asutused, mille üle vald omab olulist, kuid mitte valitsevat mõju. Sidusettevõteteks loetakse ka ühisettevõtteid, mille tegevuse üle on omanikel ühine valitsev mõju. Olulise mõju olemasolu eeldatakse ka, kui valla omanduses on otse või tütarettevõtete kaudu rohkem kui 20% sidusettevõtte hääleõigusest. Olulise mõju olemasolu iseloomustavad tavaliselt järgmised asjaolud: 1",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059391_Par_2"
        }
      ],
      "estleg:sourceAct": "Põltsamaa Vallavalitsuse raamatupidamise sise-eeskiri",
