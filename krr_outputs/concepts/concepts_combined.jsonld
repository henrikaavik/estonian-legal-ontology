    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051640_purgimisteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimisteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kogumismahutist väljapumpamine, äravedamine ja purgimissõlme juhtimine; 2) reovee kohtkäitlus (edaspidi kohtkäitlus) – reovee kogumine kogumismahutisse, äravedu kogumismahutist ja purgimine ühiskanalisatsiooni või reovee puhastamine omapuhastis; 3) reovee kohtkäitlusrajatis (edaspidi kohtkäitlusrajatis) – lekkekindel kogumismahuti (sh kuivkäimla lampkast) või omapuhasti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051640_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "purgimisteenus (reovee_kohtkaitluse_ja_araveo_eeskiri_t1051640)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_purgimisteenus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
