        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "turuanalüüs",
      "skos:definition": [
        {
          "@value": "projekti valdkonnas piiritletud turu analüüs eesmärgiga saada igakülgne teadmine projektis kirjeldatud eesmärgi saavutamiseks vajalikest lahendustest. Turuanalüüsi korraldus ja selle tulemuste kasutamine juhindub objektiivsuse, läbipaistvuse ja mittediskrimineerivuse põhimõtetest",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_turudialoog",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "turudialoog",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_innovatsiooni_edendavate_hangete_toetamise_tingimused_t1033984_turudialoog"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "turudialoog",
      "skos:definition": [
        {
          "@value": "osa turuanalüüsist või seda toetav tegevus eesmärgiga saada igakülgne teadmine võimalikest pakkujatest ning nende võimekusest ja valmisolekust pakkuda lahendusi projektis kirjeldatud eesmärgi saavutamiseks ning informeerida võimalikke pakkujaid projekti eesmärgist ning selle saavutamisega seotud kriteeriumitest ja muudest asjakohastest aspektidest",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
