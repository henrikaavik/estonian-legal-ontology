        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "juhtrühm",
      "skos:definition": [
        {
          "@value": "toetuse saaja ja partnerite esindajatest ning koostööpartnerite kaasamise korral nende esindajatest koosnev meeskond, kes vastutab piirkonnas võrgustikutöö juhtimise eest, sealhulgas eri valdkondade spetsialistide eesmärgipärase koostöö ja regulaarsete kohtumiste korraldamise eest; 2",
          "@language": "et"
        },
        {
          "@value": "toetuse saaja ja partnerite esindajatest ning koostööpartnerite kaasamise korral nende esindajatest koosnev tiim, kes vastutab piirkonnas võrgustikutöö juhtimise eest, sealhulgas eri valdkondade spetsialistide eesmärgipärase koostöö ja regulaarsete kohtumiste korraldamise eest; 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_juhtumimeeskond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
