          "@value": "ühe kilovatt-tunni tarnitud energia tootmiseks vajalik esmane energiahulk taastuvatest ja mittetaastuvatest energiaallikatest, mis sisaldab kõiki energiaallika ammutamise, energia tootmise, ülekande ja jaotamise kadusid",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
