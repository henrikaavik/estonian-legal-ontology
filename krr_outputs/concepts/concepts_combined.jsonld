        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiamärgis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis; mittetoetatav kulu – paragrahvi 1 lõikes 5 sätestatud juhul mitteabikõlblik kulu perioodi 2014–2020 struktuuritoetuse seaduse (edaspidi struktuuritoetuse seadus ) tähenduses",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049699_Par_3"
        }
      ],
      "estleg:sourceAct": "Väikeelamute energiatõhususe suurendamise toetuse kasutamise tingimused ja kord",
