    {
      "@id": "estleg:Concept_toetuse_andmise_kord_maapiirkondades_asuvate_juurdepaasuteed_t1049702_majapidamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "majapidamine",
      "skos:definition": "elamuna kasutatav hoone koos sinna juurde kuuluvate abihoonetega. Elamuna kasutatava hoone kasutusotstarve peab olema avalikes registrites majandus- ja taristuministri 2. juuni 2015. a määruse nr 51 „Ehitise kasutamise otstarvete loetelu” kohaselt elamu või sellele peab olema väljastatud ehitusluba elamu ehitamiseks või enne 22. juulit 1995. a ehitatud hoonete puhul peab olema tegemist asjaõigusseaduse rakendamise seaduse tähenduses õiguslikul alusel ehitatud ehitisega, mille ettenähtud kasutusotstarve on elamu.",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049702_Par_3"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise kord maapiirkondades asuvate juurdepääsuteede remonditööde teostamiseks",
