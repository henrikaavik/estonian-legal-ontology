      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_pollumajandustoodete_esmane_tootmine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põllumajandustoodete esmane tootmine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tegevus, milleks on esmatoodete tootmine, pidamine või kasvatamine, kaasa arvatud saagikoristus, lüpsmine ja põllumajandusloomade kasvatamine enne tapmist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
