        "@language": "et"
      },
      "skos:definition": {
        "@value": "tegevus, mille käigus kontrollitakse ehitusprojekti kui tervikut või ehitusprojekti osa koosmõjus ehitusprojekti kui tervikuga ning vastavust põhiprojektile kehtestatud nõuetele, kusjuures ekspertiisi ei tehta § 13 lõikes 2 sätestatud juhul",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053122_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute rekonstrueerimise toetamine",
      "rdfs:label": "põhiprojekti ekspertiis (korterelamute_rekonstrueerimise_toetamine_t1053122)",
