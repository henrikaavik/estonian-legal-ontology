      "rdfs:label": "esmase abi brigaad",
      "skos:definition": [
        {
          "@value": "püsiasustusega väikesaarel asuv kolmeliikmeline erakorralise meditsiini alase ettevalmistusega isikute rühm, mille teine ja kolmas liige osutavad patsiendile abi sündmuskohal ning mille juht koordineerib brigaadi tegevust telemeditsiiniliste vahendite kaudu või tema asemel juhib brigaadi tegevust väikesaarel asuv õebrigaadi juht",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
