    {
      "@id": "estleg:Concept_saku_vallavalitsuse_palgajuhend_t1011634_Lisatasu_ooajal_tehtava_too_eest",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Lisatasu ööajal tehtava töö eest",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lisatasu, mida makstakse juhul kui teenistuja tööaeg langeb ööajale ning kui nimetatud kohustus ei sisaldu tema ametijuhendis ja seda ei ole arvestatud tema palga määramisel.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011634_Par_2"
        }
      ],
