      "rdfs:label": "arstlik toetusbrigaad",
      "skos:definition": [
        {
          "@value": "kaheliikmeline anestesioloogi või erakorralise meditsiini arsti juhitud kiirabibrigaad, mis toetab sündmuskohal teisi kiirabibrigaade kiirabi osutamisel raskes ja eluohtlikus seisundis patsiendile ning millel endal puudub patsiendi transportimise võimekus, kuid vajaduse korral on tagatud patsiendi transport haiglasse",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
