          "@id": "estleg:Concept_sporditegevuse_toetamise_kord_t1056997_harrastaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "harrastaja",
      "skos:definition": [
        {
          "@value": "spordiklubi treeningrühmas regulaarselt osalev isik; 4",
          "@language": "et"
        },
        {
          "@value": "kuni 19-aastane huvitegevuses osalev isik, kelle elukoht rahvastikuregistri andmetel on Lääne-Harju vald; 3",
          "@language": "et"
        },
        {
          "@value": "spordi- või liikumisharrastusega tegelev rahvastikuregistri andmetel Maardu linna elanik; 4",
          "@language": "et"
        },
        {
          "@value": "spordiklubi treeningrühmas regulaarselt osalev 7 kuni 19-aastane Kohila valla elanikuna registreeritud isik; 4",
          "@language": "et"
        },
        {
          "@value": "spordiklubi või kultuuriseltsi tegevuses (sh treeningrühmas, ringis jms) regulaarselt osalev isik; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      }
    },
