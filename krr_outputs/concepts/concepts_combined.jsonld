        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maapinna piiritletud osa ehk maaüksus) või hoonestusõigus. Kinnistu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted maa-ala, territoorium, krunt, maaüksus ja katastriüksus ning maaüksuse olulised osad",
        "@language": "et"
      },
      "estleg:definedIn": [
