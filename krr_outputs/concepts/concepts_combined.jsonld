        }
      ],
      "skos:definition": [
        {
          "@value": "Alutaguse Vallavolikogu (edaspidi vallavolikogu ), mis kohaliku omavalitsuse korralduse seaduse kohaselt on valla esinduskogu ja kes nimetatud seaduse sätetest tulenevalt kinnitab valla majandusaasta aruande ning määrab audiitori; 9",
          "@language": "et"
        },
        {
          "@value": "Räpina Vallavolikogu, mis kohaliku omavalitsuse korralduse seaduse kohaselt on valla esinduskogu ja mis nimetatud seaduse sätetest tulenevalt kinnitab valla eelarve, majandusaasta aruande ja määrab audiitori. 10 (",
          "@language": "et"
        },
        {
          "@value": "vallavolikogu, mis kohaliku omavalitsuse korralduse seaduse kohaselt on valla esinduskogu ja mis kinnitab valla majandusaasta aruande ning määrab audiitori. 10 (",
          "@language": "et"
        }
      ]
    },
