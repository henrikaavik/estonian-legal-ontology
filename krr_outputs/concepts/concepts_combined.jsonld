      "rdfs:label": "kanalisatsioonikaev",
      "skos:definition": [
        {
          "@value": "kanalisatsioonirajatiste hulka kuuluv maapinnale ulatuva avatava luugiga kaev kanalisatsiooni töö jälgimiseks, torustiku ja liivapüüdurite puhastamiseks, pindmise äravooluvee vastuvõtuks, kanalisatsiooni sissepääsuks või liitmike teostamiseks. Maapinnale ulatuv kanalisatsiooniluuk kuulub kanalisatsioonikaevu osana kanalisatsioonirajatiste hulka",
          "@language": "et"
        },
        {
          "@value": "reovee või sademetevee ning ühisvoolse kanalisatsiooni rajatiste hulka kuuluv maapinnale ulatuva avatava luugiga kaev kanalisatsiooni töö jälgimiseks, torustiku ja liivapüüdurite puhastamiseks, pindmise äravooluvee vastuvõtuks, kanalisatsiooni sissepääsuks või liitmike teostamiseks. Maapinnale ulatuv kanalisatsiooniluuk kuulub kanalisatsioonikaevu osana kanalisatsioonirajatiste hulka",
          "@language": "et"
        },
        {
          "@value": "reovee või sademetevee ning ühisvoolse kanalisatsioonirajatiste hulka kuuluv maapinnale ulatuva avatava luugiga kaev kanalisatsiooni töö jälgimiseks, torustiku ja liivapüüdurite puhastamiseks, pindmise äravooluvee vastuvõtuks, kanalisatsiooni sissepääsuks või liitmike teostamiseks. Maapinnale ulatuv kanalisatsiooniluuk kuulub kanalisatsioonikaevu osana kanalisatsioonirajatiste hulka",
          "@language": "et"
        },
        {
          "@value": "võrgu hoolduseks ja kontrolliks kanalisatsioonitorustikule ehitatud kaev (toru)",
          "@language": "et"
        }
      ],
