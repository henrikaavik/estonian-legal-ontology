        {
          "@id": "estleg:Concept_parnu_linna_kinnisasja_reaalservituudi_ja_isikliku_kasutusoi_t1045870_avarii"
        },
        {
          "@id": "estleg:Concept_rakvere_linnale_kuuluva_kinnisasja_tehnorajatise_pustitamise_t1047463_avarii"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "avarii",
      "skos:definition": [
        {
          "@value": "tehnorajatise ootamatu või juhuslik purunemine, tehnorajatise seiskumine või muu rike, mille tagajärjel võib tekkida märkimisväärne materiaalne kahju servituudi teostajale, kinnisasja või kinnisasjal piiratud asjaõigusi omavatele või kolmandatele isikutele",
          "@language": "et"
        },
        {
          "@value": "ehitiste või seadmete ettenägematu purunemine või rikki minek, mille tagajärjel oluliselt halveneb või katkeb klientide veega varustamine ja nendelt reovee ärajuhtimine, või on ohustatud inimesed, ehitised või keskkond",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
