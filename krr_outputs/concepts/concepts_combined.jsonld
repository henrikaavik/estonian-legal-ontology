      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1045949_kuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kanalisatsiooniehitiste, torustik välja arvatud, lubatud kõige väiksem kaugus hoonest, joogivee salv- või puurkaevust ning muuks kui joogiveeotstarbeks kasutatavast puurkaevust; 6) inimekvivalenti (edaspidi ka ie) – ühe inimese poolt põhjustatud keskmise ööpäevase tingliku veereostuskoormuse ühik. Biokeemilise hapnikutarbe (BHT 7 ) kaudu väljendatud ie väärtus on 60 grammi hapnikku ööpäevas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1045949_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "kuja (reovee_kohtkaitluse_ja_araveo_eeskiri_t1045949)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1045949_omapuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk kohtpuhasti on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1045949_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "omapuhasti (reovee_kohtkaitluse_ja_araveo_eeskiri_t1045949)",
