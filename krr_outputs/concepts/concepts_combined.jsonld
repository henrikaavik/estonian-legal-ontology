    {
      "@id": "estleg:Concept_kaubanduse_korraldamine_tallinna_linnas_t1056502_kaupleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaupleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, sh avalik-õiguslik juriidiline isik, kes müüb kaupa või teenust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056502_Par_2"
        }
      ],
