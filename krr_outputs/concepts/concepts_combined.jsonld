      ],
      "skos:prefLabel": {
        "@value": "Sisendustoru",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "liitumispunkti ja veearvesti vaheline kinnisasja veetorustik.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058810_Par_2"
