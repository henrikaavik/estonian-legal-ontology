      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kanepi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044995_purgimiskoht",
      "@type": [
        "owl:NamedIndividual",
