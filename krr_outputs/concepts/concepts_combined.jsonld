      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tekkepõhine arvestus",
      "skos:definition": [
        {
          "@value": "majandustehingute kajastamine vastavalt majandustehingu toimumisele sõltumata sellest, kas sellega seotud raha on laekunud või välja makstud. Aruande koostamisel tehakse reguleerimis- ja lõpetamiskanded, mis võimaldavad määrata aruandeperioodi tulud ja kulud",
          "@language": "et"
        }
      ],
