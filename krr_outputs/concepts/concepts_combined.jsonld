    {
      "@id": "estleg:Concept_riigisaladuse_ja_salastatud_valisteabe_kaitse_kord_t317593_riskihaldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riskihaldus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vara, teabe, ohu, intsidendi ja turvariski analüüs, mille põhjal määratakse kindlaks teabe ja selle kaitsmist toetavate süsteemitoimingute ja -vahendite turvameetmed. Riskihaldus hõlmab süsteemi turvameetmete planeerimist, korraldamist, kasutamist ja kontrollimist, selleks et vältida turvariski väljumist vastuvõetavatest piiridest ja intsidente",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_317593_Par_104"
        }
      ],
      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
