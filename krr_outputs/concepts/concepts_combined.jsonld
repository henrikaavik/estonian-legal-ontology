      "rdfs:label": "suurettevõtja",
      "skos:definition": [
        {
          "@value": "ettevõtja, kes ei vasta komisjoni määruse (EL) nr 651/2014 I lisas väikese ja keskmise suurusega ettevõtjale sätestatud kriteeriumidele; 9",
          "@language": "et"
