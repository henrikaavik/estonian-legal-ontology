    {
      "@id": "estleg:Concept_joelahtme_valla_jaatmehoolduseeskiri_t1053601_suurjaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "suurjäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmed, mida kaalu või mahu tõttu ei ole võimalik paigutada olmejäätmete mahutisse, nagu mööbliesemed, vaibad, madratsid, kardinapuud, aknaraamid, kraanikausid jms. Suurjäätmetena ei käsitleta ehitusjäätmeid ning suuremõõtmelisi probleemtooteid, nagu autoromud või nende osad (sealhulgas vanarehvid), ning elektri- ja elektroonikaseadmeid või nende jäätmeid (sealhulgas pesumasinad, telerid, külmkapid, elektripliidid) ja muid tootjavastutusega hõlmatud jäätmeid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053601_Par_3"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla jäätmehoolduseeskiri",
      "rdfs:label": "suurjäätmed (joelahtme_valla_jaatmehoolduseeskiri_t1053601)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_suurjaatmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
