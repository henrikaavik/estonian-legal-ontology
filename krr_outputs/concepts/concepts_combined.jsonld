      ]
    },
    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "töötaja",
      "skos:definition": "isik, kes on võetud vallavalitsuse töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040857_Par_3"
        }
      ],
