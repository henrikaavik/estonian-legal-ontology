      "rdfs:label": "komposter",
      "skos:definition": [
        {
          "@value": "biolagunevate jäätmete kogumiseks tekkekohas mikro- ja makroorganismide kaasabil aeroobseks lagundamiseks kasutatav mahuti, kuhu on takistatud lindude ja loomade juurdepääs",
          "@language": "et"
        },
        {
          "@value": "biolagunevate jäätmete lagundamiseks kasutatav mahuti",
          "@language": "et"
        },
        {
          "@value": "biolagunevate jäätmete lagundamiseks kasutatav selleks ettenähtud funktsionaalsusega seade",
          "@language": "et"
        },
        {
          "@value": "orgaaniliste jäätmete lagundamiseks kasutatav mahuti",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
