        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teegrupp",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_teede_ja_tanavate_ajutise_sulgemise_eeskiri_t1013672_teegrupp"
        },
        {
          "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_maks_t1010651_teegrupp"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teegrupp",
      "skos:definition": [
        {
          "@value": "loetelu teedest ja teelõikudest, mis on määruse lisas liiklusintensiivsuse ja strateegilise tähtsuse alusel määratud ühte gruppi neljast",
          "@language": "et"
        },
        {
          "@value": "loetelu teedest ja teelõikudest, mis on Tallinna Linnavolikogu 20. detsembri 2013 määruse nr 31 \"Teede ja tänavate sulgemise maks\" lisas liiklusintensiivsuse ja strateegilise tähtsuse alusel määratud ühte gruppi neljast.",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
