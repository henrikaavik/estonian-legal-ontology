      },
      "skos:definition": {
        "@value": "maantee, tänav ja jalgrattatee või muu sõidukite või jalakäijate liiklemiseks kasutatav rajatis, mis võib olla riigi või kohaliku omavalitsuse või muu juriidilise isiku või füüsilise isiku omandis.",
        "@language": "et"
      },
      "estleg:definedIn": [
