        "@type": "xsd:integer"
      },
      "rdfs:label": "tuletõrje veevõtukoht",
      "skos:definition": [
        {
          "@value": "ühisveevärgil või tarbimiskohal paiknev maapealne või maa-alune aasta ringi kasutatav rajatis, mille kaudu võetakse vett pääste- ja demineerimistöödeks ning veekahuri täitmiseks; 16",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tulu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_loksa_linna_raamatupidamise_sise_eeskiri_t1056998_tulu"
        },
        {
          "@id": "estleg:Concept_muhu_vallavalitsuse_raamatupidamise_sise_eeskiri_t1060379_tulu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tulu",
      "skos:definition": [
        {
          "@value": "aruandeperioodi sissetulekud, millega kaasneb varade suurenemine või kohustuste vähenemine ja mis suurendavad omakapitali, va omanike sissemaksed omakapitali; 11",
          "@language": "et"
        },
        {
