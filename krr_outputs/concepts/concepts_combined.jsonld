      }
    },
    {
      "@id": "estleg:Concept_anija_valla_heakorra_eeskiri_t1060686_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: maa-ala, maatükk ja maatüki olulised osad, territoorium, krunt, maaüksus ja katastriüksus; 11) kõnnitee (sh kergliiklustee) – jalgsi ja kergliiklusvahendiga (nt jalgratas, tasakaaluliikur jms) liiklemiseks ettenähtud tee või sõidutee osa",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060686_Par_3"
        }
      ],
