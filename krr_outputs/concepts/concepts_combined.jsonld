      "skos:definition": {
        "@value": "sisekliima tagamiseks, tarbevee soojendamiseks ning valgustuse ja seadmete kasutamiseks vajalik soojus- ja elektrienergia ilma süsteemikadudeta ning energia muundamiseta. Netoenergiavajadus jaguneb: netoenergiavajadus ruumide kütteks, ruumide jahutamiseks, ventilatsiooniõhu soojendamiseks, ventilatsiooniõhu jahutamiseks, tarbevee soojendamiseks, valgustamiseks ja seadmete kasutamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
