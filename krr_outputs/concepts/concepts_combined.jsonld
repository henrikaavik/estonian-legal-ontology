        "@language": "et"
      },
      "skos:definition": {
        "@value": "radooni aktiivsuskontsentratsioon, milleks on ruumiõhus sisalduva radooni aktiivsus ruumalaühiku kohta, mida mõõdetakse bekerellides kuupmeetri kohta (Bq/m³)",
