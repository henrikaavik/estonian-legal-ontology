        {
          "@value": "Reklaamikandja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "spetsiaalselt reklaami eksponeerimiseks valmistatud ja paigaldatud konstruktsioon, alus, seadeldis; 10",
          "@language": "et"
        },
        {
          "@value": "reklaami eksponeerimiseks ja paigaldamiseks kasutatav alus, seadeldis, konstruktsioon (reklaampost, tahvel, haagis jms) või ühistranspordivahend; 9",
          "@language": "et"
        },
        {
          "@value": "reklaami eksponeerimiseks valmistatud ja paigaldatud konstruktsioon, alus, seadeldis (reklaampost,- tahvel, treiler jms); 2",
          "@language": "et"
        },
        {
          "@value": "reklaami paigaldamiseks kasutatav alus, konstruktsioon, seadeldis (reklaamipost,- tahvel, treiler jms); 3",
          "@language": "et"
        },
        {
          "@value": "reklaami paigaldamiseks kasutatav alus, seadeldis (seinapannoo, konsool, transparendid jms), mis paigaldatakse hoonetele ja rajatistele ning konstruktsioon (reklaamipost, -tahvel, treiler jms), mis paigaldatakse maapinnale 11",
          "@language": "et"
        }
      ],
