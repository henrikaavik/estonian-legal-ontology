    {
      "@id": "estleg:Concept_tori_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055533_Analuutiline_ja_sunteetiline_arvestus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Analüütiline ja sünteetiline arvestus",
      "skos:definition": "majandusinformatsiooni liigendamise erinevad detailsuse tasemed. Sünteetiline arvestus on majandusinformatsiooni kirjendamine raamatupidamiskontodele. Analüütiline arvestus on raamatupidamiskontodele kirjendatud majandusinformatsiooni detailiseerimine (nõuded ja kohustised – kelle vastu jms). Analüütilist arvestust peetakse kas majandustarkavara pearaamatust eristatud moodulites (registrites) või teiste tarkvaravahenditega või käsitsi. 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055533_Par_3"
        }
      ],
      "estleg:sourceAct": "Tori vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "Analüütiline ja sünteetiline arvestus (tori_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055533)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_analuutiline_ja_sunteetiline_arvestus"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_analuutiline_ja_sunteetiline_arvestus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tori_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055533_Aktsepteerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Aktsepteerimine",
      "skos:definition": "majandustehingu toimumise ja õiguspärasuse kinnitamine allkirjaga ning eelarve tunnuse või nimetuse määramine valla eelarveklassifikaatorite liigenduses. Toiming kuulub kuludokumendi kontrollija või vastutava isiku (eelarve vastutav täitja, projekti vastutav täitja või muu aktseptiõiguslik isik) kompetentsi. 3 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055533_Par_3"
        }
      ],
      "estleg:sourceAct": "Tori vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "Aktsepteerimine (tori_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055533)",
