        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "edukas sportlane",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rahvastikuregistri andmetel Kuusalu valla 12-26-aastane sportlane, kes on riiklikul või rahvusvaheliselt tasemel saavutanud silmapaistva sportliku tulemuse. Toetust makstakse: 1) andeka sportlase toetamiseks; 2) eduka tulemuse saavutanud sportlasele või võistkonnale. Sama sportliku tulemuse alusel ei saa küsida andeka sportlase toetust ja eduka tulemuse toetust.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057451_Par_2"
        }
      ],
