      "rdfs:label": "puu",
      "skos:definition": [
        {
          "@value": "kõrghaljastuse element, mille rinnasdiameeter on üle 8 cm",
          "@language": "et"
        },
        {
          "@value": "kasvav puu, mille rinnasdiameeter on vähemalt 15 sentimeetrit",
          "@language": "et"
        },
        {
          "@value": "puu, mille rinnasdiameeter on vähemalt 15 cm ning puul on selgelt nähtav(ad) või määratav(ad) tüvi ja võra",
          "@language": "et"
        },
        {
          "@value": "puuliigi pikaealine isend, millel on vähemalt üks püstine puitunud tüvi ning selgelt määratletav võra, mis kinnitub tüvele maapinnast kõrgemal",
          "@language": "et"
        },
        {
          "@value": "kasvav puu, mille rinnasdiameeter (tüve läbimõõt 1,3 meetri kõrguselt juurekaelast) on vähemalt 10 sentimeetrit, kõrghaljastuse element; [Jõelähtme Vallavolikogu 28.08.2007 määrus nr 71 – jõust. 10.09.2007]",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
