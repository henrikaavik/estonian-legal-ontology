    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1051973_avalikult_kasutatav_maa_ala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalikult kasutatav maa-ala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringile kasutamiseks antud ning kasutuses olev üldjuhul hoonestamata maa, nt tee, tänav, väljak, park, puhke- või virgestusala vms. Käesoleva määruse tähenduses ei kuulu kalmistu maa avalikult kasutatava maa-ala hulka",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051973_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
      "rdfs:label": "avalikult kasutatav maa-ala (avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1051973)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalikult_kasutatav_maa_ala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1051973_kaupleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaupleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, sealhulgas avalik-õiguslik juriidiline isik, kes tegutseb eesmärgil, mis on seotud tema majandus- või kutsetegevusega või isik, kes müüb kaupa või osutab teenust väljaspool majandus- või kutsetegevust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051973_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
