    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmetekitaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jäätmetekitaja",
      "skos:definition": "isik, riigi või kohaliku omavalitsuse asutus, kelle tegevuse käigus tekivad jäätmed või isik, kes sooritab jäätmetega toiminguid, mille tagajärjel jäätmete olemus või koostis muutub (näiteks tegeleb jäätmete eeltöötlusega või segab jäätmeid); 13",
      "estleg:definedIn": [
