      ],
      "skos:prefLabel": {
        "@value": "lisatasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "seaduse alusel makstav lisatasu valveaja, ületunnitöö, ööajal tehtava töö ja riigipühadel tehtava töö eest",
