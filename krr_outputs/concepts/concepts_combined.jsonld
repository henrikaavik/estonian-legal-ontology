          "@value": "Teenuse osutaja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ametiasutus või ametiasutuse hallatav asutus või muu sotsiaalteenust osutav juriidiline või füüsiline isik; 19",
          "@language": "et"
        },
        {
          "@value": "asutus või isik, kes peab vastama sotsiaalhoolekande seaduses kehtestatud nõuetele, sealhulgas rahvatervise seaduse, ehitusseadustiku ja teistes käesolevas määruses nimetamata õigusaktides sätestatud nõuetele, mis reguleerivad asjaomase teenuse osutamist.",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kohaliku omavalitsuse üksus või tema hallatav asutus; 6",
          "@language": "et"
        },
        {
          "@value": "füüsilisest isikust ettevõtja, juriidiline isik ja kohaliku omavalitsuse üksus või kohaliku omavalitsuse üksuse hallatav asutus. Teenuse osutaja osutab teenust vastavalt käesolevale korrale. 6",
          "@language": "et"
        },
        {
          "@value": "füüsilisest isikust ettevõtja, juriidiline isik või kohaliku omavalitsuse üksus või kohaliku omavalitsuse üksuse hallatav asutus. 6 (",
          "@language": "et"
        }
      ],
