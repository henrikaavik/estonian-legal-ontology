    {
      "@id": "estleg:Concept_poltsamaa_valla_ametiasutuse_palgajuhend_t1054343_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Põltsamaa vallaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud ametiasutuses ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054343_Par_2"
        }
      ],
      "estleg:sourceAct": "Põltsamaa valla ametiasutuse palgajuhend",
      "rdfs:label": "ametnik (poltsamaa_valla_ametiasutuse_palgajuhend_t1054343)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_poltsamaa_valla_ametiasutuse_palgajuhend_t1054343_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes teeb ametiasutuses töölepingu alusel tööd töökohal, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054343_Par_2"
        }
      ],
      "estleg:sourceAct": "Põltsamaa valla ametiasutuse palgajuhend",
      "rdfs:label": "töötaja (poltsamaa_valla_ametiasutuse_palgajuhend_t1054343)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_poltsamaa_valla_ametiasutuse_palgajuhend_t1054343_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Põltsamaa vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja",
        "@language": "et"
      },
