        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "innovatsioon",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_innovatsiooni_edendavate_hangete_toetamise_tingimused_t1033984_innovatsioon"
        },
        {
          "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_innovatsioon"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "innovatsioon",
      "skos:definition": [
        {
          "@value": "uue või oluliselt uuendatud toote, teenuse või lahenduse väljatöötamine või kasutuselevõtmine, kusjuures nimetatud toode, teenus või lahendus peab olema lõpptarbija, hankija või turu jaoks uus või märkimisväärselt täiustatud",
          "@language": "et"
        },
        {
          "@value": "uute ideede ja teadmiste kasutamine uudsete lahenduste rakendamiseks, mis hõlmab toodete ja teenuste väljatöötamist ning uuendamist",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
