    {
      "@id": "estleg:Concept_kehtna_valla_raamatupidamise_sise_eeskiri_t1060946_analuutiline_ja_sunteetiline_arvestus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "analüütiline ja sünteetiline arvestus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandusinformatsiooni liigendamise erinevad detailsuse tasemed. Sünteetiline arvestus on majandusinformatsiooni kirjendamine raamatupidamiskontodele. Analüütiline arvestus on raamatupidamiskontodele kirjendatud majandusinformatsiooni detailiseerimine (nõuded ja kohustused – kelle vastu jms). Analüütilist arvestust peetakse majandustarkavara pearaamatust eristatud moodulites (registrites).",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060946_Par_2"
        }
      ],
      "estleg:sourceAct": "Kehtna valla raamatupidamise sise-eeskiri",
      "rdfs:label": "analüütiline ja sünteetiline arvestus (kehtna_valla_raamatupidamise_sise_eeskiri_t1060946)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_analuutiline_ja_sunteetiline_arvestus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
