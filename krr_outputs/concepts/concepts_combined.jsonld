        "@type": "xsd:integer"
      },
      "rdfs:label": "rahvusvaheline projekt",
      "skos:definition": [
        {
          "@value": "väljaspool Eestit paikneva või registreeritud avalik-õigusliku juriidilise isiku, eraõigusliku juriidilise isiku või füüsilise isiku poolt ellukutsutud või osalusega tegevuste kogum tulemuse saavutamiseks, mille realiseerimine on seotud tähtajalise ja rahalise piiranguga ning mille kulud kaetakse täielikult või osaliselt eespool nimetatud isikute poolt; 3",
          "@language": "et"
        }
      ]
    },
