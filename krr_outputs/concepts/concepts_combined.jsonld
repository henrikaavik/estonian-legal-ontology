      "estleg:definesConcept": {
        "@id": "estleg:Concept_korvalkulu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edendamise või isiku käitumise avalikes huvides suunamise eesmärgil; 2) majandus- või kutsetegevuse koht – koht, kus vahetult pakutakse ja müüakse kaupa või vahetult pakutakse ja osutatakse teenust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025627_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla reklaamimäärus",
      "rdfs:label": "reklaam (raasiku_valla_reklaamimaarus_t1025627)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_reklaampind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaampind",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Raasiku valla haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025627_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla reklaamimäärus",
      "rdfs:label": "reklaampind (raasiku_valla_reklaamimaarus_t1025627)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaampind"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_mobiilne_valireklaami_alus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "mobiilne välireklaami alus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduk, haagis, või muu ratastel ja sõidukiga teisaldatav konstruktsioon, mis on välireklaami edastamiseks kohandatud ja mille vahendusel välireklaami edastatakse, samuti reklaami eesmärgil valla haldusterritooriumile spetsiaalselt paigutatud või pargitud reklaamkirjadega sõiduk. Mobiilne välireklaami alus ei pea olema kantud liiklusregistrisse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025627_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla reklaamimäärus",
      "rdfs:label": "mobiilne välireklaami alus (raasiku_valla_reklaamimaarus_t1025627)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_mobiilne_valireklaami_alus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_valireklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
