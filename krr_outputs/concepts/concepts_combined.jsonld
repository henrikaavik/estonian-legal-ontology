      },
      "rdfs:label": "ühendustoru",
      "skos:altLabel": [
        {
          "@value": "Ühendustoru",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kinnistu veevärki veega varustav või kinnistu kanalisatsioonist reo- või sademevett ärajuhtiv toru peatorust liitumispunktini, viimane kaasa arvatud",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärki veega varustav või kinnistu kanalisatsioonist reovett vastuvõttev toru peatorust liitumispunktini",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärki veega varustav või kinnistu kanalisatsioonist reo- või sademevett ärajuhtiv toru peatorust liitumispunktini, viimane kaasaarvatud; 22) ühisveevärk ja –kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reo- ning sademevee ärajuhtimine ja mis on vee-ettevõtja hallatav. Ühisveevärgi ja –kanalisatsioonina käsitletakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos.",
          "@language": "et"
        },
        {
          "@value": "tarbimiskoha veevärki veega varustav või tarbimiskoha kanalisatsioonist reo- või sademevett ärajuhtiv toru peatorust liitumispunktini, viimane kaasa arvatud. 24) Ühisveevärk ja -kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu varustatakse tarbijaid joogiveega ja juhitakse ära ning puhastatakse reo- ja sademevett ning mille projekteeritud jõudlus on vähemalt kümme kuupmeetrit ööpäevas ja mis teenindab vähemalt 50 inimest. Ühisveevärgi ja -kanalisatsioonina käsitatakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos. Ühisveevärgi ja -kanalisatsioonina käsitatakse ka ehitiste ja seadmete süsteemi, mille projekteeritud jõudlus on alla kümne kuupmeetri ööpäevas või mis teenindab alla 50 inimese ja mille kohaliku omavalitsuse üksus on ühisveevärgi ja -kanalisatsiooni arendamise kavaga määranud ühisveevärgiks ja -kanalisatsiooniks.",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärki veega varustav või kinnistu kanalisatsioonist reovett vastu võttev toru peatorust liitumispunktini",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "16",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
