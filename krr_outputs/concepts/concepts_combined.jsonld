        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee süvapuhastus ehk tertsiaarne puhastus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_saaremaa_vallas_t1047226_reovee_suvapuhastus_ehk_tertsiaarne_puhastus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "reovee süvapuhastus ehk tertsiaarne puhastus",
      "skos:definition": [
        {
          "@value": "täiendav reoainete reoveest kõrvaldamine, mille käigus rakendatakse reovee puhastamiseks nii tõhustatud bioloogilisi fosfori- ja lämmastikuärastuse tehnoloogiaid kui ka keemilisi meetodeid ja mille tulemusena peab heitvesi vastama üle 100 000ie reostuskoormusega reoveekogumisala nõuetele, kusjuures pinnasesse juhitav heitvesi ei tohi sisaldada üle 0,1 mg/l nitriteid ja üle 45 mg/l nitraate",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_reovee_suvapuhastus_ehk_tertsiaalne_puhastus"
        }
      ],
