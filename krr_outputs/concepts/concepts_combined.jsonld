        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tasemekoolitus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "õpe, mille korraldamist reguleerivad põhikooli- ja gümnaasiumiseadus, kutseõppeasutuse seadus, rakenduskõrgkooli seadus, ülikooliseadus ning erakooliseadus",
        "@language": "et"
      },
      "estleg:definedIn": [
