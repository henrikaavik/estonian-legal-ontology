          "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_tehingupartner_voi_tehingupartnerid"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tehingupartner või tehingupartnerid",
      "skos:definition": [
        {
          "@value": "avaliku sektori üksus, kohalik omavalitsus ja sidusüksus, kellele on antud tehingupartneri kood ning on esitatud Avaliku sektori finantsarvestuse ja -aruandluse juhendi lisas tehingupartnerite nimekirjas; 4",
          "@language": "et"
        },
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingu või -tehingute osapool või -pooled, kellele on omistatud tunnused (tehingupartneri koodid) eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud finantsaruandeid; 9",
          "@language": "et"
        },
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingu või -tehingute osapool või -pooled, kellele on omistatud tunnused (tehingupartneri koodid) eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideerituid finantsaruandeid.",
          "@language": "et"
        },
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingu või -tehingute osapool või -pooled, kellele on omistatud tunnused (tehingupartneri koodid) eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideerituid finantsaruandeid; 10",
          "@language": "et"
        }
      ]
    },
