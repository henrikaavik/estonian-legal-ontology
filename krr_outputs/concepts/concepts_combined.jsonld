        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kogukonnateenus",
      "skos:definition": [
        {
          "@value": "kogukonna käivitatud kohalikule arengule ja töökohtade loomisele orienteeritud jätkusuutlik tegevus uute väärtuste loomiseks kogukonna või tema liikmete jaoks",
          "@language": "et"
        },
        {
          "@value": "mittetulundusühenduse poolt kogukonna liikmete heaolule ja kogukonna arengule suunatud teenus või koostöökokkuleppe alusel omavalitsuse poolt mittetulundusühendusele korraldada antud avalik teenus, mida osutatakse vabatahtlikkuse või kehtestatud hinnakirja alusel",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
