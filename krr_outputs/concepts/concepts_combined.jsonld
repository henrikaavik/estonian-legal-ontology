    {
      "@id": "estleg:Concept_haljastuse_inventeerimise_kord_t1049755_puu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puittaime pikaealine isend, millel on vähemalt üks püstine puitunud tüvi ning selgelt määratletav elusatest külgokstest moodustunud võra, mis kinnitub tüvele maapinnast kõrgemal",
        "@language": "et"
      },
      "estleg:definedIn": [
