      "estleg:definesConcept": {
        "@id": "estleg:Concept_valdkond"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_votmetegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
