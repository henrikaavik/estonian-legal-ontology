    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1051799_Kaubanduse_korraldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kaubanduse korraldaja",
      "skos:definition": "Kose Vallavalitsus (edaspidi vallavalitsus), vallavalitsuse hallatav asutus, avaliku ürituse korraldaja või maa-ala valdaja või omanik. Kaubanduse korraldajal (v.a vallavalitsus ja vallavalitsuse hallatav asutus) on lubatud tegeleda kaubandustegevusega, kui ta on registreeritud majandustegevuse registris. 4 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051799_Par_2"
        }
      ],
