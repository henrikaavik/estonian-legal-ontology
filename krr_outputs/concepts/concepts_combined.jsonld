    {
      "@id": "estleg:Concept_tallinna_kaubamarkide_registreerimise_ning_kaubamarkide_ja_s_t1014912_Tallinna_kaubamark_maaruse_tahenduses_on_kauba",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Tallinna kaubamärk määruse tähenduses on kauba",
      "skos:definition": "ja teenindusmärkide registris Tallinna Linnakantselei (edaspidi linnakantselei ) nimele registreeritud kaubamärk ning muu kaubamärk, mille ainuõigus kuulub tulenevalt seadusest Tallinnale. 2022-03-30 RT IV 2022-04-05 2 405042022002 2022-04-08 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1014912_Par_2"
