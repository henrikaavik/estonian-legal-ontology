    {
      "@id": "estleg:Concept_juhtruhm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "juhtrühm",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_inimkeskse_hoolekande_ja_tervishoiususteemi_koordinatsioonim_t1053036_juhtruhm"
        },
        {
          "@id": "estleg:Concept_inimkeskse_hoolekande_ja_tervishoiususteemi_koordinatsioonim_t1057292_juhtruhm"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "juhtrühm",
      "skos:definition": [
        {
          "@value": "toetuse saaja ja partnerite esindajatest ning koostööpartnerite kaasamise korral nende esindajatest koosnev meeskond, kes vastutab piirkonnas võrgustikutöö juhtimise eest, sealhulgas eri valdkondade spetsialistide eesmärgipärase koostöö ja regulaarsete kohtumiste korraldamise eest",
          "@language": "et"
        },
        {
          "@value": "toetuse saaja ja partnerite esindajatest ning koostööpartnerite kaasamise korral nende esindajatest koosnev tiim, kes vastutab piirkonnas võrgustikutöö juhtimise eest, sealhulgas eri valdkondade spetsialistide eesmärgipärase koostöö ja regulaarsete kohtumiste korraldamise eest",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_sihtruhm"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_juhtumimeeskond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "juhtumimeeskond",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_inimkeskse_hoolekande_ja_tervishoiususteemi_koordinatsioonim_t1053036_juhtumimeeskond"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "juhtumimeeskond",
      "skos:definition": [
        {
          "@value": "inimese terviklikku toimetulekut toetav eri valdkondade spetsialistidest koosnev meeskond, millesse võivad kuuluda nimistuga perearst, pereõde, sotsiaaltöötaja, haigla töötaja, hoolekande- ja tervishoiuteenuse osutaja, sealhulgas eriarsti- ja õendusabi osutaja, vabatahtlik abistaja ja hooldaja ning vajaduse korral Sotsiaalkindlustusameti juhtumikonsultant või Eesti Töötukassa juhtumikorraldaja, samuti teised avaliku teenuse osutajad, kelle pädevuses on osutada abivajadusega inimesele asjakohaseid teenuseid",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
