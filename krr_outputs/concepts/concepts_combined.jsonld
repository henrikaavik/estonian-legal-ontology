      "skos:definition": [
        {
          "@value": "lennujaamateenuse põhjendatud müügitulu, mille arvutab lennujaama haldaja hinna kehtestamisel ning mille arvutamisel võetakse arvesse käesoleva määrusega lubatud kulud, kapitalikulu ning mõistlik ärikasum.",
          "@language": "et"
