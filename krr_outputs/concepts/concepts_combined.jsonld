      "rdfs:label": "reoveesete",
      "skos:definition": [
        {
          "@value": "reovee käitlemise tulemusel tekkivad jäätmed.",
          "@language": "et"
        },
        {
          "@value": "reoveest füüsikaliste, bioloogiliste või keemiliste meetoditega eraldatud vee ja tahke aine segu; 13",
          "@language": "et"
        }
      ]
    },
