        "@type": "xsd:integer"
      },
      "rdfs:label": "töötaja",
      "skos:altLabel": [
        {
          "@value": "Töötaja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "asutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks",
          "@language": "et"
        },
        {
          "@value": "isik, kes on võetud vallavalitsuse töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel",
          "@language": "et"
        },
        {
          "@value": "isik, kes teeb ametiasutuses töölepingu alusel tööd töökohal, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd",
          "@language": "et"
        },
        {
          "@value": "allasutusega töölepingulises suhtes olev isik",
          "@language": "et"
        },
        {
          "@value": "ametiasutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning tema teenistuskohta nimetatakse töökohaks",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "32",
        "@type": "xsd:integer"
      },
