      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009_purgimisteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimisteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kohtkäitlusesüsteemist reovee või –sette eemaldamine ja äravedu purgimissõidukiga ning selle väljutamine purgimiskohta; 10) purgimissõiduk (edaspidi sõiduk ) – mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi/fekaal purgimiskohta",
        "@language": "et"
      },
      "estleg:definedIn": [
