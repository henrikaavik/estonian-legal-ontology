    {
      "@id": "estleg:Concept_reklaamimaks_t1055745_Reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edendamise või isiku käitumise avalikes huvides suunamise eesmärgil",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055745_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks",
      "rdfs:label": "Reklaam (reklaamimaks_t1055745)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_t1055745_maksuobjekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "maksuobjekt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaam, mida eksponeeritakse Narva-Jõesuu linna haldusterritooriumil füüsilise või juriidilise isiku poolt a) avalikus kohas, milleks on üldkasutatav koht või vabaks liikumiseks ja kasutamiseks piiratud territoorium, ehitis või selle osa ja mis asub ehitise siseruumides või väljaspool ehitise siseruume avalikkusele suunatult; b) eraomandis oleval kinnistul või ehitisel või selle siseruumides avalikkusele suunatult; c) mobiilse konstruktsiooni vahendusel avalikkusele suunatult",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055745_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks",
      "rdfs:label": "maksuobjekt (reklaamimaks_t1055745)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_maksuobjekt"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
