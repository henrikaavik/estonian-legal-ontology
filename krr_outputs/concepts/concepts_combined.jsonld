      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rae_vallavalitsuse_palgajuhend_t1056436_tootasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötajale makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise lisatasust, valveaja lisatasust ja asendustasust",
        "@language": "et"
      },
      "estleg:definedIn": [
