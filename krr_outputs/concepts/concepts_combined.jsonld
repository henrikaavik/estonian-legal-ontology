    {
      "@id": "estleg:Concept_huvihariduses_ja_huvitegevuses_osalemise_toetuse_maksmise_ko_t1041085_Huvitegevus_kaesoleva_maaruse_moistes_on_susteemne_juhendatud_tegelemine_huviala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Huvitegevus käesoleva määruse mõistes on süsteemne juhendatud tegelemine huvialaga vaba tahte alusel alus",
      "skos:definition": ", põhi-, gümnaasiumi-, kutse- ja ülikooliõppest ning tööst vabal ajal süvendatud teadmiste ja oskuste omandamiseks valitud huvialal. RT IV 2023-05-03 12 403052023012 2023-05-06 13 2 (2<sup>1</sup>) Huvitegevuseks ei loeta vabaaja tegevusi, mille pakkumine on ette nähtud: 1",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041085_Par_2"
