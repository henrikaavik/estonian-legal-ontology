    {
      "@id": "estleg:Concept_kolga_jaani_valla_heakorraeeskiri_t1002995_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidilise või füüsilise isiku omandis või kasutuses olev maa-ala, millega on võrdsustatud territoorium, krunt, maaüksus, katastriüksus ja maatüki olulised osad; 2) omanik- füüsiline või juriidiline isik, kelle omandis on maa või ehitised või kelle kasuks on seatud hoonestusõigus; 3) avalik koht- avalikult kasutatav ala, territoorium, rajatis või ruum, mis on antud üldiseks kasutamiseks või mis on tegelikult üldkasutatav; 4) hooldusala- kinnistuga või krundiga külgnev maa-ala kuni sõiduteeni. Vallavalitsus võib, võttes arvesse maa-ala asukohta, määrata ka teistsuguse hooldusala. Vaidlused hooldusala suuruse üle lahendab vallavalitsus; 5) heakorratööd- rohu ja muru niitmine; puulehtede, prahi, liiva, lume ja jää koristamine ning libeduse tõrje; 6) vallavalitsus- Kolga-Jaani Vallavalitsus.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1002995_Par_2"
        }
      ],
      "estleg:sourceAct": "Kolga-Jaani valla heakorraeeskiri",
      "rdfs:label": "kinnistu (kolga_jaani_valla_heakorraeeskiri_t1002995)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
