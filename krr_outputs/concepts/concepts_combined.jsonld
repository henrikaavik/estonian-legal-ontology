    },
    {
      "@id": "estleg:Concept_heakorraeeskiri_ja_koormise_kehtestamine_t1052685_kinnistu_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu omanik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidilisest või füüsilisest isikust kinnisasja omanik, hoonestusõiguse omanik või korteriühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorranõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052685_Par_2"
        }
      ],
      "estleg:sourceAct": "Heakorraeeskiri ja koormise kehtestamine",
