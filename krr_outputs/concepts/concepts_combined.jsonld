      "rdfs:label": "põhipalk",
      "skos:altLabel": [
        {
          "@value": "Põhipalk",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "teenistuja palga fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal",
          "@language": "et"
        },
        {
          "@value": "teenistuja palga või töötasu fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal",
          "@language": "et"
        },
        {
          "@value": "teenistuja palga või töötasu fikseeritud osa",
          "@language": "et"
        },
        {
          "@value": "teenistujale määratud kuupalgamäär, mille aluseks on vastava teenistuskoha grupile vastav palgamäär",
          "@language": "et"
        },
        {
          "@value": "fikseeritud ja regulaarne palga osa ametijuhendis ettenähtud teenistusülesannete ja ettenähtud teenistusalase hariduse, teadmiste, oskuste ja kogemuste eest",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "22",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
