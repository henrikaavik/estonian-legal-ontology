      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rouge_valla_heakorraeeskiri_t1050548_romusoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "romusõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduk, mis ei saa tehnilise seisukorra tõttu osaleda liikluses või millel puuduvad selle mehaanilised osad või kereosad või autoklaasid või rattad või mis oma välimusega riivab piirkonna esteetilist väljanägemist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050548_Par_3"
        }
      ],
