      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "huvide konflikt",
      "skos:definition": [
        {
          "@value": "olukord, kus linna asutuse või tema nimel tegutseva isiku töötajal, ametnikul, juhatuse liikmel või muul pädeval esindajal, kes on kaasatud riigihanke ettevalmistamisse või korraldamisse või kes võib muul moel mõjutada selle riigihanke tulemust, on otseselt või kaudselt finantsalaseid, majanduslikke või muid isiklikke huvisid, mida võib käsitada tema erapooletust või sõltumatust kahjustavatena",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
