    {
      "@id": "estleg:Concept_alutaguse_valla_raamatupidamise_sise_eeskiri_t1049736_analuutiline_ja_sunteetiline_arvestus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "analüütiline ja sünteetiline arvestus",
      "skos:definition": "majandusinformatsiooni liigendamise erinevad detailsuse tasemed. Sünteetiline arvestus on majandusinformatsiooni kirjendamine raamatupidamiskontodele. Analüütiline arvestus on raamatupidamiskontodele kirjendatud majandusinformatsiooni detailiseerimine (nõuded ja kohustised – kelle vastu jms). Analüütilist arvestust peetakse kas majandustarkvara pearaamatust eristatud moodulites (registrites) või teiste tarkvaravahenditega; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049736_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla raamatupidamise sise-eeskiri",
      "rdfs:label": "analüütiline ja sünteetiline arvestus (alutaguse_valla_raamatupidamise_sise_eeskiri_t1049736)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_analuutiline_ja_sunteetiline_arvestus"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_analuutiline_ja_sunteetiline_arvestus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_alutaguse_valla_raamatupidamise_sise_eeskiri_t1049736_aktsepteerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "aktsepteerimine",
      "skos:definition": "majandustehingu toimumise ja õiguspärasuse kinnitamine allkirjaga ning eelarve tunnuse või nimetuse määramine valla eelarveklassifikaatorite liigenduses. Toiming kuulub kuludokumendi kontrollija ja/või vastutava isiku (eelarve vastutav täitja, projekti vastutav täitja või muu aktseptiõiguslik isik) vastutusalasse; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049736_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla raamatupidamise sise-eeskiri",
      "rdfs:label": "aktsepteerimine (alutaguse_valla_raamatupidamise_sise_eeskiri_t1049736)",
