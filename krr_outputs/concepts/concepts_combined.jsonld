      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kehtna_valla_raamatupidamise_sise_eeskiri_t1060946_eelarve_vastutav_taitja",
