          "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_majandusinformatsiooni_liigendamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "10",
        "@type": "xsd:integer"
      },
      "rdfs:label": "majandusinformatsiooni liigendamine",
      "skos:definition": [
        {
          "@value": "valla majandustehingute kirjendamine, kasutades riigi või valla õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid valla juhtimisotsuste tegemiseks ning riigi aruandluse jaoks",
          "@language": "et"
        },
        {
          "@value": "linna majandustehingute kirjendamine, kasutades riigi ja linna õigusaktidega kehtestatud ning linna finantsteenistuse loodud tunnuseid (koode), mis on vajalikud nii linna sise- kui ka välise aruandluse tagamiseks",
          "@language": "et"
        },
        {
          "@value": "Linna majandustehingute kirjendamine, kasutades riigi õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid Linna juhtimisotsuste tegemiseks ning nõutava välise aruandluse tagamiseks",
          "@language": "et"
        },
        {
          "@value": "majandustehingute kirjendamine, kasutades riigi või omavalitsuse õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid juhtimisotsuste tegemiseks ning aruandluse jaoks",
          "@language": "et"
        },
        {
          "@value": "valla majandustehingute kirjendamine, kasutades riigi või valla õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad akumuleerunud majandusinformatsiooni põhjal koostada finantsaruandeid valla juhtimisotsuste tegemiseks ning riigi aruandluse jaoks",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
