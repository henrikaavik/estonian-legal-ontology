    {
      "@id": "estleg:Concept_vaike_maarja_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051019_reovee_bioloogiline_puhastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee bioloogiline puhastamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "orgaanilise aine ja toitainete kõrvaldamine reoveest bioloogiliste protsesside toimel, mille tulemusel pinnasesse või veekogusse juhitav heitvesi vastab kehtestatud reostusnäitajate piirväärtustele biokeemilise ja keemilise hapnikutarbe ning heljumi osas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051019_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja valla reovee kohtkäitluse ja äraveo eeskiri",
