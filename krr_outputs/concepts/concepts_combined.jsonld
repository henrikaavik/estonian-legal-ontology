        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_mustvee_valla_ametiasutuse_palgajuhend_t1054711_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes teeb ametiasutuses töölepingu alusel tööd töökohal, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054711_Par_2"
        }
      ],
      "estleg:sourceAct": "Mustvee valla ametiasutuse palgajuhend",
      "rdfs:label": "töötaja (mustvee_valla_ametiasutuse_palgajuhend_t1054711)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_mustvee_valla_ametiasutuse_palgajuhend_t1054711_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Mustvee vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
