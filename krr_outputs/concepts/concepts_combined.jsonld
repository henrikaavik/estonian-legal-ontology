    {
      "@id": "estleg:Concept_viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil_t1059033_validaator_ehk_e_komposter",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "validaator ehk e-komposter",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühissõidukis paiknev elektrooniline seade, mille juurde e- kaardi asetamisel toimub sõiduõiguse registreerimine. Sõiduõiguse olemasolust või puudumisest antakse märku seadme ekraanil ilmuva teksti ja helisignaalide abil. Sõit tuleb registreerida igakordsel ühissõidukisse sisenemisel. Sõidu registreerimine on kohustuslik kõigile sõidupileti kasutajatele ja sõidusoodustuse õigust omavatele isikutele, välja arvatud sügava või raske puudega isikutele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059033_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi valla bussiliinidel ja Leppneeme-Kelnase laevaliinil sõidu eest tasumise kord ja sõidupiletite hinnad",
      "rdfs:label": "validaator ehk e-komposter (viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil__t1059033)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_validaator_ehk_e_komposter"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
