      "rdfs:label": "hoolduspäevik",
      "skos:definition": [
        {
          "@value": "vabas vormis päevik, mis kajastab omapuhasti hooldamisega seotud informatsiooni.",
          "@language": "et"
        },
        {
          "@value": "vabas vormis päevik, mis kajastab omapuhasti hooldamisega seotud informatsiooni; 8",
          "@language": "et"
        },
        {
          "@value": "vabas vormis peetav dokument (päevik), milles kajastatakse reovee kohtkäitlussüsteemi hooldamisega seotud teavet; 3",
          "@language": "et"
        },
        {
          "@value": "vabas vormis peetav päevik, mis kajastab omapuhasti hooldamisega seotud informatsiooni, vastavalt eeskirja § 7 lg 5 toodule; 6",
          "@language": "et"
        },
        {
          "@value": "vabas vormis peetav päevik, mis kajastab omapuhasti hooldamisega seotud informatsiooni; 3",
          "@language": "et"
