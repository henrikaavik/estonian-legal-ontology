        }
      ],
      "skos:definition": [
        {
          "@value": "isik, kellel on anatoomilise, füsioloogilise või psüühilise struktuuri või funktsiooni kaotus või kõrvalekalle, millest tingituna vajab isik pidevat kõrvalabi, juhendamist või järelevalvet.",
          "@language": "et"
        },
        {
          "@value": "isik, kellel on anatoomilise, füsioloogilise või psüühilise struktuuri või funktsiooni kaotus või kõrvalekalle, millest tingituna vajab isik pidevat kõrvalabi, juhendamist või järelevalvet, ning kellele on määratud arstliku komisjoni otsusega puude raskusaste.",
          "@language": "et"
        },
        {
          "@value": "isik, kellel on puue puuetega inimeste sotsiaaltoetuste seaduse tähenduses",
          "@language": "et"
        },
        {
          "@value": "puuetega inimeste sotsiaaltoetuste seaduses toodud korras määratud puudega inimene",
