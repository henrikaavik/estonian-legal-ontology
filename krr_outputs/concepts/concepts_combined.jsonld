      "estleg:definesConcept": {
        "@id": "estleg:Concept_tulemusnaitaja"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_tulemusnaitaja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_toetatav_kulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "toetatav kulu",
      "skos:definition": "projekti toetusest rahastatava tegevuse elluviimiseks vajalik ja mõistlik kulu, sh toetus ja omafinantseering, mis on tekkinud abikõlblikkuse perioodil ning mille aluseks olevad tegevused on kooskõlas Eesti ja Euroopa Liidu õigusega, käesoleva määruse ning üldmääruse nõuetega; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
