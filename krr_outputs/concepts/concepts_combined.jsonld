      "rdfs:label": "üüriturult eluruumi leidmise toetamine",
      "skos:definition": [
        {
          "@value": "sotsiaalmajanduslikust olukorrast tulenevalt madala võimekusega inimeste nõustamine ja toetamine tema perekonna vajadustele vastava eluruumi leidmisel üüriturult ja üürilepinguni jõudmisel",
          "@language": "et"
        }
      ],
