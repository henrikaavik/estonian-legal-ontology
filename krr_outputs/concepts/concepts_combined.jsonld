      ],
      "skos:prefLabel": {
        "@value": "tiheasustusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla üldplaneeringuga määratud ja hoonestatud tiheasustusala või kompaktse asustusega ala; 2) puu/üksikpuu – kasvav puu, mille rinnasdiameeter on vähemalt 12 sentimeetrit ning puul on selgelt nähtav või määratav tüvi ja võra; 3) raie– puu likvideerimine",
        "@language": "et"
      },
