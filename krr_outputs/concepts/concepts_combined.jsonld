    {
      "@id": "estleg:Concept_filtervaljak",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "filterväljak",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_saaremaa_vallas_t1047226_filtervaljak"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "filterväljak",
      "skos:definition": [
        {
          "@value": "reoveekäitlussüsteemi osa reovee bioloogiliseks puhastamiseks, kus reovee puhastus viiakse läbi pinnaseosakestele tekkivas biokiles elavate mikroorganismide poolt, filtersüsteem on ümbritsevast keskkonnast eraldatud vedelikke mitteläbilaskva geomembraaniga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_filtervaljak_ehk_filtersusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "filterväljak ehk filtersüsteem",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_filtervaljak_ehk_filtersusteem"
        },
        {
          "@id": "estleg:Concept_kose_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054491_filtervaljak_ehk_filtersusteem"
        },
        {
          "@id": "estleg:Concept_narva_joesuu_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1057667_filtervaljak_ehk_filtersusteem"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "filterväljak ehk filtersüsteem",
      "skos:definition": [
        {
          "@value": "septikule või biopuhastile järgnev heitvee puhastussüsteem, mis rajatakse juhul, kui imbsüsteemi paigalduskoha pinnas ei ima või ei lase vett läbi. Killustikukihi alla ehitatakse liivast filtreerimiskiht ja selle alla paigaldatakse drenaažitorud, mis juhivad läbi liivakihi valgunud ja puhastatud vee kogumiskaevu ja sealt suublasse. Filtersüsteem isoleeritakse ümbritsevast pinnasest geomembraaniga",
          "@language": "et"
        },
        {
          "@value": "septikule või biopuhastile järgnev heitvee puhastussüsteem, mis rajatakse juhul, kui imbsüsteemi paigalduskoha pinnas ei ima või ei lase vett läbi.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
