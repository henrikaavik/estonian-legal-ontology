      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduses_ja_huvitegevuses_osalemise_toetamise_kord_t1056731_huviharidus",
