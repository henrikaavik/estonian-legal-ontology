          "@id": "estleg:Concept_tallinna_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_n_t1060473_lahkvoolne_kanalisatsioon"
        },
        {
          "@id": "estleg:Concept_tartu_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeski_t1062951_lahkvoolne_kanalisatsioon"
        }
      ],
      "estleg:definitionCount": {
        "@value": "12",
        "@type": "xsd:integer"
      },
      "rdfs:label": "lahkvoolne kanalisatsioon",
      "skos:definition": [
        {
          "@value": "kanalisatsioonisüsteem, kus reovesi ja sademevesi voolavad eraldi torustikes",
          "@language": "et"
        },
        {
          "@value": "rajatised reovee ja sademevee, drenaaživee ning muu pinnase- ja pinnavee eraldi kanaliseerimiseks",
          "@language": "et"
        },
        {
          "@value": "eraldiseisvad ja omavaheliste ühendusteta ehitised ja seadmed reovee ning sademevee eraldiseisvaks kanaliseerimiseks.",
          "@language": "et"
        },
        {
          "@value": "kanalisatsioon, milles reovesi ja sademevesi koos drenaaživeega juhitakse ära eraldi torustikes.",
          "@language": "et"
        },
        {
          "@value": "kanalisatsioonivõrk reovee ja sademevee eraldi kogumiseks, ärajuhtimiseks ja puhastamiseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
