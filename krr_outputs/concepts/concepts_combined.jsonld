      },
      "rdfs:label": "konsolideeritud raamatupidamiskontode saldoandmik",
      "skos:definition": [
        {
          "@value": "kontokombinatsioonide ja nende saldode järjestatud loetelu, milles konsolideerimisgruppi kuuluvate üksuste ühesuguste kontokombinatsioonide saldod on liidetud rida-realt meetodil ning omavahelisi varasid, kohustusi, netovara, tulusid ja kulusid kajastavad kontokombinatsioonide saldod on elimineeritud",
          "@language": "et"
        }
      ],
