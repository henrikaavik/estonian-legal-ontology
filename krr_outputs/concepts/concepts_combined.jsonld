        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "juhtpartner",
      "skos:definition": [
        {
          "@value": "juriidiline isik või asutus, kes esitab Interreg programmi tehnilisele sekretariaadile projektitaotluse struktuuritoetuse saamiseks ning kellega sõlmitakse struktuuritoetuse leping",
          "@language": "et"
        },
        {
          "@value": "projektis osalev linnavalitsus, hallatav asutus või linna lepinguline partner, kes vastutab eesmärkide saavutamise eest kogu projektiga võetud kohustuste ulatuses",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
