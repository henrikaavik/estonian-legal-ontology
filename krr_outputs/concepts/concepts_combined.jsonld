        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "elektriauto laadija",
      "skos:definition": [
        {
          "@value": "elektriauto laadijaks loetakse elektrotehnilist seadet elektriautode laadimiseks, mis vastab standardis IEC 61851-1 defineeritud laadimismoodustele 2 või 3; RT I 2012-06-06 1 106062012001 2012-06-09 4",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_elektribuss",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elektribuss",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
