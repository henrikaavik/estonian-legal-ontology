        "@language": "et"
      },
      "skos:definition": {
        "@value": "«Ravikindlustuse seaduse» § 31 lõike 2 alusel Vabariigi Valitsuse kehtestatud korras määratud isiku antud hinnang; 8) diagnoosipõhine kompleksteenus (edaspidi DRG ) on tervishoiuteenuse eest tasu maksmise meetod, mis põhineb samade tunnustega raviarvete grupeerimisel kliiniliselt ja ressursikulult sarnastesse rühmadesse. Grupeerimiseks kasutatakse NordDRG süsteemis defineeritud rühmi.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_309871_Par_26"
        }
      ],
