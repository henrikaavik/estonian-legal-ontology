    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_marjamaa_vallas_t1012141_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edendamise või isiku käitumise avalikes huvides suunamise eesmärgil",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1012141_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri Märjamaa vallas",
      "rdfs:label": "reklaam (valireklaami_paigaldamise_eeskiri_marjamaa_vallas_t1012141)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_marjamaa_vallas_t1012141_valireklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "välireklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avalikus kohas asuv või avalikust kohast jälgitav reklaam",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1012141_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri Märjamaa vallas",
      "rdfs:label": "välireklaam (valireklaami_paigaldamise_eeskiri_marjamaa_vallas_t1012141)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valireklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_marjamaa_vallas_t1012141_reklaami_avalikustaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaami avalikustaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik või riigi- või kohaliku omavalitsuse asutus, kes reklaami avalikult esitab, edastab, näitab või levitab",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1012141_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri Märjamaa vallas",
      "rdfs:label": "reklaami avalikustaja (valireklaami_paigaldamise_eeskiri_marjamaa_vallas_t1012141)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaami_avalikustaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_marjamaa_vallas_t1012141_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "territoorium, ehitis või selle osa, mis on avatud üldiseks kasutamiseks või mis on tegelikult üldkasutatav, või ühistranspordivahend. Välireklaamina ei käsitata: 1) majandus- või kutsetegevuse kohas, kus müüakse kaupa või osutatakse teenust, antavat teavet kauba, teenuse või selle müügitingimuste kohta, ning käesoleva lõike punktis 2 nimetatud teavet; 2) majandus- või kutsetegevuse koha tähistust selle nime, liigi, kauba müügi või teenuse osutamise aja, isiku nime, kaubamärgi ja domeeninimega ehitisel, kus majandus- või kutsetegevuse koht asub, ja majandus- või kutsetegevuse koha sissepääsu juures; 3) väljaspool ehitist asuva majandus- või kutsetegevuse koha tähistust käesoleva lõike punktis 2 nimetatud teabega; 4) isiku majandus- või kutsetegevuses kasutatava sõiduki tähistust selle isiku nime, kontaktandmete, kaubamärgi, domeeninime ja tegevusalaga; 5) sponsorteates avaldatud spondeerija nime, kaubamärki ja teavet tema antud materiaalse toetuse kohta.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1012141_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamise eeskiri Märjamaa vallas",
      "rdfs:label": "avalik koht (valireklaami_paigaldamise_eeskiri_marjamaa_vallas_t1012141)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_koht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vanemate_omaosalus_marjamaa_valla_lasteaedades_t1061010_lasteaiakoht",
      "@type": [
        "owl:NamedIndividual",
