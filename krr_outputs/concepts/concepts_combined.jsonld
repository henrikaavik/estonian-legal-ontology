      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tiheasustus",
      "skos:definition": [
        {
          "@value": "ja küla keskuse maa-alad põhinevad valla üldplaneeringul ja on märgitud eraldi kaartidel, mis on määruse lisad. Ülejäänud valla territoorium loetakse hajaasustusalaks.",
          "@language": "et"
        }
