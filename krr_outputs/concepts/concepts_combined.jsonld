      "rdfs:label": "jäätmetekitaja",
      "skos:definition": [
        {
          "@value": "isik või riigi või kohaliku omavalitsuse üksuse asutus, kelle tegevuse käigus tekib jäätmeid või isik, kes sooritab jäätmetega toiminguid, mille tagajärjel jäätmete olemus või koostis muutub; 6",
          "@language": "et"
        },
        {
          "@value": "isik või riigi või kohaliku omavalitsuse üksuse asutus, kelle tegevuse käigus tekivad jäätmed, või isik, kes sooritab jäätmetega toiminguid, mille tagajärjel jäätmete olemus või kooslus muutub; 12",
          "@language": "et"
        },
        {
          "@value": "isik või riigi või kohaliku omavalitsuse üksuse asutus, kelle tegevuse käigus tekivad jäätmed, või isik, kes sooritab jäätmetega toiminguid, mille tagajärjel jäätmete olemus või kooslus muutub; 18",
