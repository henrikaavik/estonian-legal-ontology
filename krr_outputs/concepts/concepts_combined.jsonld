      "rdfs:label": "avalik koht",
      "skos:altLabel": [
        {
          "@value": "Avalik koht",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "määratlemata isikute ringile kasutamiseks antud või määratlemata isikute ringi kasutuses olev maa-ala, ehitis, ruum või selle osa, samuti ühissõiduk; 2",
          "@language": "et"
        },
        {
          "@value": "määratlemata isikute ringile kasutamiseks antud või määratlemata isikute ringi kasutuses olev maa-ala, ehitis, ruum või selle osa, samuti ühissõiduk; 4",
          "@language": "et"
        },
        {
          "@value": "on määratlemata isikute ringile kasutamiseks antud või määratlemata isikute ringi kasutuses olev maa-ala, ehitis, ruum või selle osa, samuti ühissõiduk; 2",
          "@language": "et"
        },
        {
          "@value": "igaühele vabalt ligipääsetav ja kasutatav maa-ala, ehitis või selle osa; 2",
          "@language": "et"
        },
        {
          "@value": "määratlemata isikute ringile kasutamiseks antud või määratlemata isikute kasutuses olev avalikkusele juurdepääsetav maa-ala, ehitis, ruum või selle osa, samuti ühissõiduk; 2",
          "@language": "et"
        }
      ],
