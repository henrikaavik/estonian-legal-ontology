      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "TEN",
      "skos:definition": [
        {
          "@value": "T lennujaamade põhivõrku kuulub Tallinna Lennujaam; 4",
          "@language": "et"
        },
        {
          "@value": "T põhivõrku ( Core Network ) kuuluvad järgmised Eesti riigi maanteed: Tallinn–Pärnu–Ikla, Tallinn–Tartu–Võru–Luhamaa. TEN-T üldvõrgustikku ( Comprehensive Network ) kuuluvad Tallinna ringtee, Tallinn–Narva, Tallinn–Paldiski, Jõhvi–Tartu–Valga; Rakvere–Paide–Pärnu, Tallinn–Haapsalu–Rohuküla; Risti–Virtsu; Riia–Luhamaa (E",
          "@language": "et"
        },
        {
          "@value": "T põhivõrku kuulub Tallinna Vanasadam; 6",
          "@language": "et"
        },
        {
          "@value": "T raudtee põhivõrku kuuluvad Tallinn–Tapa–Tartu–Koidula. TEN-T üldvõrgustikku kuuluvad Tartu–Valga, Valga–Koidula, Tallinn–Paldiski, Tallinn–Pärnu, Tapa–Narva ning sadama põhivõrk Tallinna Sadam (Vanasadam ning Muuga); 5",
          "@language": "et"
        },
        {
          "@value": "T üldvõrku kuuluvad sadamad: Kuivastu–Virtsu ja Rohuküla–Heltermaa sadamad; 7",
          "@language": "et"
        }
      ]
    },
