      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_omanik"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tartu_valla_heakorraeeskiri_t1004440_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kinnistu",
      "skos:definition": "kinnistatud maatükk koos selle oluliste osadega. Kinnistu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: maa-ala, territoorium, krunt, maaüksus, katastriüksus; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1004440_Par_2"
        }
      ],
      "estleg:sourceAct": "Tartu valla heakorraeeskiri",
