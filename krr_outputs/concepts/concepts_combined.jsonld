          "@value": "tähistatud, vajalike ehitistega maa-ala inimeste surnukehade või nende tuha matmiseks ja surnute mälestamiseks; 2",
          "@language": "et"
        },
        {
          "@value": "tähistatud, vajalike ehitistega maa-ala surnute või nende tuhaurni matmiseks ja surnute mälestamiseks; 2",
          "@language": "et"
        },
        {
          "@value": "tähistatud, vajalike ehitistega maa-ala surnute või nende tuha matmiseks ja surnute mälestamiseks; 2",
          "@language": "et"
        },
        {
          "@value": "inimese surnukeha või surnud inimese säilmete (edaspidi nimetatud surnu ) matmiseks ja mälestamiseks ettenähtud ning vajalike ehitistega maa-ala; 2",
          "@language": "et"
        },
