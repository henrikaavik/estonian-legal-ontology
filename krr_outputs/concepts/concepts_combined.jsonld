      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omafinantseering",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "toetuse saaja rahaline panus abikõlblike kulude katmisse. Omafinantseeringuna ei käsitata teisi kohaliku omavalitsuse, riigi või Euroopa Liidu institutsioonide või fondide antud tagastamatuid toetusi",
