      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_kinnistu"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kuusalu_valla_heakorra_eeskiri_t1012575_Omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Omanik",
      "skos:definition": "kinnis- või vallasvara omanik, kellega heakorra nõuete täitmisel on võrdsustatud tema poolt volitatud valdaja, haldaja või kasutaja. 3 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1012575_Par_2"
        }
      ],
