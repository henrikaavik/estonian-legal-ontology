      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "vedaja",
      "skos:altLabel": [
        {
          "@value": "Vedaja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "jäätmekäitleja, kellele kohalik omavalitsus on riigihanke tulemusena andnud teenuste kontsessiooni korraldatud jäätmeveoga hõlmatud jäätmete vedamiseks Lüganuse valla haldusterritooriumil. 2 (",
          "@language": "et"
        },
        {
          "@value": "jäätmekäitleja, kellele vallavalitsus on riigihanke tulemusena andnud teenuste kontsessioonikorraldatud jäätmeveoga hõlmatud jäätmete vedamiseks valla haldusterritooriumil või jäätmete vedamiseks vastavat luba omav jäätmekäitleja; 33",
          "@language": "et"
        },
        {
          "@value": "jäätmekäitleja, kellele Võru Linnavalitsuselt (edaspidi linnavalitsus) on riigihanke tulemusena andnud teenuste kontsessiooni korraldatud jäätmeveoga hõlmatud jäätmete vedamiseks Võru linna haldusterritooriumil või isik, kellel on õigus vedada korraldatud jäätmeveoga hõlmamata jäätmeid. 10",
          "@language": "et"
        },
        {
          "@value": "Saku vallasisestel avalikel bussiliinidel liiniveoteenust osutav ettevõte; 3",
          "@language": "et"
        },
        {
          "@value": "Vinni Vallavalitsuse või tema volitatud esindajaga vastava teenuse osutamise lepingu sõlminud isik, kelle ülesandeks on veoteenuse osutamine vastavalt § 6. 25",
          "@language": "et"
        }
      ]
    },
