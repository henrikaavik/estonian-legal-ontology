      }
    },
    {
      "@id": "estleg:Concept_mittetulundusliku_tegevuse_toetamise_kord_t1044543_toetus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toetus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallaeelarvest kindla eesmärgi täitmiseks antav raha, mis kantakse rahastamise otsuse ja/või toetuslepingu allkirjastamise järgselt tervikuna või tingimustes ette nähtud osade kaupa üle toetuse saaja arvelduskontole",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044543_Par_3"
        }
      ],
