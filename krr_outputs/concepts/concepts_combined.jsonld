      "rdfs:label": "mõõdusõlm",
      "skos:altLabel": [
        {
          "@value": "Mõõdusõlm",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "vee või reovee mõõtmiseks ettenähtud arvestist ja arvesti juurde kuuluvast armatuurist koosnev tehniline sõlm",
          "@language": "et"
        },
        {
          "@value": "joogi-, sademe või reovee mõõtmiseks ettenähtud arvestist ja arvesti juurde kuuluvast armatuurist koosnev tehniline sõlm.",
          "@language": "et"
        },
        {
          "@value": "vee mõõtmiseks või reovee ja sademevee arvestamiseks ettenähtud arvestist ja arvesti juurde kuuluvatest seadmetest koosnev tehniline sõlm.",
          "@language": "et"
        },
        {
          "@value": "vee või reovee mõõtmiseks ettenähtud arvestist ja arvesti juurde kuuluv armatuurist koosnev tehniline sõlm",
          "@language": "et"
        },
        {
          "@value": "vee, reovee või heitvee mõõtmiseks ettenähtud tehniline sõlm",
          "@language": "et"
        }
      ],
