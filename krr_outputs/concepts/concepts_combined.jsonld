      ],
      "skos:prefLabel": {
        "@value": "noor",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rahvastikuregistri andmetel Elva vallas elav 7–19-aastane laps või noor, kes osaleb huvihariduses ja/või huvitegevuses ja on registreeritud EHIS-es huvihariduses või kantud Elva valla Spoku keskkonnas (edaspidi infosüsteem Spoku) vastava huvikooli huvitegevuses osalejate nimekirja",
        "@language": "et"
      },
