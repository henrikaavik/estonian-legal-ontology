      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_korraldatud_jaatmeveo_teenustasu"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_liigiti_kogumine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "liigiti kogumine",
      "skos:definition": "jäätmete kogumistegevus, mille käigus jäätmed eraldatakse liigi ja olemuse alusel nende edasise käitlemise lihtsustamiseks, sealhulgas taaskasutamise soodustamiseks; 21",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "liigiti kogumine (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_liigiti_kogumine"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_liigiti_kogumine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_ohtlikud_jaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "ohtlikud jäätmed",
      "skos:definition": "jäätmed, mis komisjoni määruse (EL) nr 1357/2014 lisas nimetatud vähemalt ühe ohtliku omaduse tõttu võivad olla ohtlikud tervisele, varale või keskkonnale; 22",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "ohtlikud jäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ohtlikud_jaatmed"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_ohtlikud_jaatmed"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_olmejaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "olmejäätmed",
      "skos:definition": "1) kodumajapidamistest kogutud segajäätmed ja liigiti kogutud jäätmed, sealhulgas paber ja kartong, klaas, metallid, plast, biojäätmed, puit, tekstiil, pakendid, elektri- ja elektroonikaseadmetest tekkinud jäätmed, patareid ja akud ning suuremõõtmelised jäätmed, sealhulgas madratsid ja mööbel",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "olmejäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_olmejaatmed"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_olmejaatmed"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_paberi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "paberi",
      "skos:definition": "ja kartongijäätmed - puhas ja kuiv tarbimisest kõrvaldatud paber ja kartong. Paberiks eeskirja tähenduses ei loeta dokumente, mis tuleb hävitada vastavalt isikuandmete kaitse seadusele ja arhiiviseadusele; 24",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "paberi (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_paberi"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_paberi"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pakendijaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "pakendijäätmed",
      "skos:definition": "mistahes pakend või pakendimaterjal, mis muutub pärast pakendi kasutamist jäätmeteks käesoleva eeskirja § 2 lg 2 p.5 mõistes. Pakendijäätmeteks ei loeta pakendi ja pakendimaterjali tootmisel tekkinud jääke; 25",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "pakendijäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pakendijaatmed"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_pakendijaatmed"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pakendijaatmete_kogumissusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "pakendijäätmete kogumissüsteem",
      "skos:definition": "pakendiettevõtjate korraldatud pakendijäätmete kogumise süsteem, mis hõlmab kõiki Eesti Vabariigis turule lastud kaupade pakenditest tekkinud pakendijäätmeid, olenemata sellest, kas need on tekitatud tööstuses, kaubandustegevuses, olmes, ametiasutuses või mujal ning olenemata kasutatud materjalidest; 26",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "pakendijäätmete kogumissüsteem (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pakendijaatmete_kogumissusteem"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_pakendijaatmete_kogumissusteem"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pakendiettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "pakendiettevõtja",
      "skos:definition": "isik, kes majandus-või kutsetegevuse raames pakendab kaupa, veab sisse või müüb pakendatud kaupa. Samuti akrediteeritud taaskasutusorganisatsioon, kellele pakendiseaduses ettenähtud juhtudel on eelpool nimetatud isikud oma kohustused pakendi ja pakendijäätmete käitlemisel lepinguga üle andnud; 27",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "pakendiettevõtja (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pakendiettevotja"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_pakendiettevotja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_probleemtoodete_jaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "probleemtoodete jäätmed",
      "skos:definition": "jäätmed, mille kokku kogumist ja taaskasutamist või kõrvaldamist korraldavad probleemtoodete tootjad või tootjate ühendused. JäätS alusel kuuluvad probleemtoodete hulka patareid ja akud, mootorsõidukid ja nende osad, elektri-ja elektroonikaseadmed ja nende osad, rehvid ja põllumajandusplast; 28",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "probleemtoodete jäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_probleemtoodete_jaatmed"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_probleemtoodete_jaatmed"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pollumajandusplast",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "põllumajandusplast",
      "skos:definition": "põllumajanduses kasutatav silopallikile, silokattekile, kiletunnel, kattevõrk ja plastnöör; 29",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "põllumajandusplast (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pollumajandusplast"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_pollumajandusplast"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_segaolmejaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "segaolmejäätmed",
      "skos:definition": "keskkonnaministri 14. detsembri 2015. a määruse nr 70 \"Jäätmete liigitamise kord ja jäätmenimistu\" lisas jäätmekoodiga 20 03 01 toodud jäätmed; 30",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "segaolmejäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_segaolmejaatmed"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_segaolmejaatmed"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_suurjaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "suurjäätmed",
      "skos:definition": "olmejäätmed, mida ei ole võimalik nende mõõtude või kaalu tõttu paigutada jäätmemahutisse (nt mööbliesemed). Suurjäätmetena ei käsitleta olmejäätmetest välja nopitud ohtlikke jäätmeid ega probleemtoodete jäätmeid (nt elektroonikaromud); 31",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "suurjäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_suurjaatmed"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_suurjaatmed"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_taaskasutatavad_jaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "taaskasutatavad jäätmed",
      "skos:definition": "määrdumata paber, papp ja kartong, klaas- ja plastiktaara, metallpurgid jm metallijäätmed, puhas kile jm plastikjäätmed, puit ja teised jäätmeliigid, mida jäätmevaldajal on segajäätmetest eraldi kogutuna võimalik üle anda korraldatud olmejäätmete veosüsteemi või liigiti kogutuna teisese toorme kasutajale/kokkuostjale, elanikel täiendavalt viia vastavatesse kogumispunktidesse; 32",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "taaskasutatavad jäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_taaskasutatavad_jaatmed"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_taaskasutatavad_jaatmed"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_tavajaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "tavajäätmed",
      "skos:definition": "kõik jäätmed, mis ei kuulu ohtlike jäätmete hulka; 33",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "tavajäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tavajaatmed"
      },
      "skos:exactMatch": [
