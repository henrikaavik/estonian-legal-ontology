      "estleg:definitionCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "rdfs:label": "omapuhasti ehk kohtpuhasti",
      "skos:definition": [
        {
          "@value": "on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 ie-d; 10",
          "@language": "et"
        },
        {
          "@value": "rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid olmereoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti. Siia alla kuuluvad nii septikud kui biopuhastid koos puhastatud reovee suublasse juhtimisega. Omapuhasti koosneb mahutist, millele järgneb suubla; 9",
          "@language": "et"
        },
        {
          "@value": "rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti; 6",
          "@language": "et"
        },
        {
          "@value": "rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ning mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti (edaspidi ie ); 7",
          "@language": "et"
        },
        {
          "@value": "rajatis, kus kõrvaldatakse reoaineid ja ebasoovitatavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 ie; 11",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_omapuhasti_e_kohtpuhasti"
        }
      ]
