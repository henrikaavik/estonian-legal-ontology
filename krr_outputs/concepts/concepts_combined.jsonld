    {
      "@id": "estleg:Concept_joelahtme_valla_ehitusmaarus_t1027827_krundi_hoonestusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "krundi hoonestusala",
      "skos:definition": "krundi osa, kuhu võib rajada detailplaneeringus määratud ehitusõigusega lubatud hooneid ja rajatisi. Krundi ehitusõiguse hulka kuni 20 m 2 ehitisealuse pinnaga väikeehitisi üldjuhul ei arvestata va juhul, kui detailplaneeringus või ehitise arhitektuursed ja ehituslikud lisatingimused ei ole määranud teisiti; 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1027827_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla ehitusmäärus",
      "rdfs:label": "krundi hoonestusala (joelahtme_valla_ehitusmaarus_t1027827)",
      "estleg:definesConcept": {
