        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riikliku tähtsusega teadustaristu",
      "skos:definition": [
        {
          "@value": "haridus- ja teadusministri 28. septembri 2023. a määruse nr 36 „Riikliku tähtsusega teadustaristu toetamine” § 3 punkti 2 tähenduses",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riistvara",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
