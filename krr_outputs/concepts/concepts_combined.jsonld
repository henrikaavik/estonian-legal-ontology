      },
      "rdfs:label": "reovee mõõdusõlm",
      "skos:definition": [
        {
          "@value": "mõõtmiseks ettenähtud arvestist ja arvesti juurde kuuluvast armatuurist koosnev tehniline sõlm; 12) saasteaine (reoaine) – tahes aine, mis võib põhjustada reostust",
          "@language": "et"
