          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetamine_t1053122_sisekliima_tagamine"
        },
        {
          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetuse_andmise_tingimused_j_t1046780_sisekliima_tagamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sisekliima tagamine",
      "skos:definition": [
        {
          "@value": "energia kasutamine ruumiõhu kvaliteedi tagamiseks ning valgustamiseks vastavalt hoone tüüpilisele kasutusele",
          "@language": "et"
        },
        {
          "@value": "energia kasutamine hoone ruumiõhu kvaliteedi tagamiseks, vastavalt ehitusseadustiku § 65 lõike 3 alusel kehtestatud määruses hoone energiatõhususe miinimumnõuete kohta sätestatud ventilatsiooni- ja ruumitemperatuuri nõuetele ning valgustamiseks vastavalt hoone tüüpilisele kasutusele",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sisekontrollimeede",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sisekontrollimeede",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Sisekontrollimeede"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Sisekontrollimeede",
      "skos:definition": [
        {
          "@value": "asutuses sisekontrolli teostamisel kasutatavad abinõud, mis on suunatud kõrvalekallete või pettuste ennetamisele. Ennetava meetme osas rakendatakse ametnike ja töötajate töökohustuste lahusust, tegvuste kooskõlastust ja kinnitamist, ametnike ja töötajate erialast täiendkoolitust, valla IT-süsteemi tehnoloogilisi võimalusi. Vallas võib kasutada ka muid sisekontrollimeetmeid, mis tagavad sisekontrolli eesmärgi saavutamise.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sisekontrolor",
