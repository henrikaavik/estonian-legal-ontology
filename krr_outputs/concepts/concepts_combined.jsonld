    {
      "@id": "estleg:Concept_viimsi_valla_reklaamimaarus_t1039864_reklaampind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "reklaampind",
      "skos:definition": "tasapinnaline või ruumiline objekt, mis paigaldatakse Viimsi valla haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega; 10",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039864_Par_1"
        }
      ],
      "estleg:sourceAct": "Viimsi valla reklaamimäärus",
