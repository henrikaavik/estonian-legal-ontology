    {
      "@id": "estleg:Concept_leping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "leping",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooni_kasutamis_t1058898_Leping"
        },
        {
          "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_t1058810_Leping"
        },
        {
          "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1058915_Leping"
        },
        {
          "@id": "estleg:Concept_parnu_linna_kinnisasja_reaalservituudi_ja_isikliku_kasutusoi_t1045870_leping"
        },
        {
          "@id": "estleg:Concept_rakvere_linnale_kuuluva_kinnisasja_tehnorajatise_pustitamise_t1047463_leping"
        },
        {
          "@id": "estleg:Concept_rongisoidul_soodustuse_saamise_kord_t1043437_leping"
        },
        {
          "@id": "estleg:Concept_valireklaami_ja_teabe_paigaldamise_kord_t1042891_leping"
        },
        {
          "@id": "estleg:Concept_puudega_isiku_eluruumi_kohandamise_kulude_huvitamise_kord_t1043349_leping"
        }
      ],
      "estleg:definitionCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "leping",
      "skos:altLabel": [
        {
          "@value": "Leping",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "tarbija ja vee-ettevõtja vahel sõlmitud leping, mh nimetatud ka kui teenusleping ühisveevärgi ja -kanalisatsiooniteenuste osutamise kohta.",
          "@language": "et"
        },
        {
          "@value": "servituudiga koormamiseks sõlmitav leping ja asjaõigusleping",
          "@language": "et"
        },
        {
          "@value": "ehitustööde teostamiseks ja tööde eest tasumiseks sõlmitavad lepingud, kus lepitakse kokku kohanduse saaja õigused ja kohustused. Eluruumi kohandamise kuludeks ei loeta tehnilise abivahendi ostmise kulusid, kui tehniline abivahend on võimalik osta sotsiaalhoolekande seaduse § 47 lõike 5 alusel. Toetatavad tegevused on: 1) liikuvusega seotud toimingute parandamine, sealhulgas eluruumi sissepääsu, hoone välisukse ja eluruumi vahelise käigutee, hoone ja selle territooriumile sissepääsu või piirde kohandamine; 2) hügieenitoimingute parandamine; 3) köögitoimingute parandamine.",
          "@language": "et"
        },
        {
          "@value": "Saue valla ja Elroni vahel sõlmitud leping, millega Saue vald võtab soodustatud isikutelt, kas osaliselt või tervikuna, üle tasu maksmise kohustuse",
          "@language": "et"
        },
        {
          "@value": "Tallinna linnale kuuluva või Tallinna linna valduses oleva ehitise pinna kasutusse andmise leping",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
