    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_heakorratood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "heakorratööd",
      "skos:definition": "tolmu, liiva, prahi, jäätmete, lume ja jää koristamine (sh jääpurikad katusel) ning libedusetõrje teostamine, muru niitmine, rohu ja heina niitmine, lehtede riisumine, heki pügamine jms ning sõidu- ja/või kõnniteel liikumist takistavate puude ja põõsaste okste lõikamine; 7",
