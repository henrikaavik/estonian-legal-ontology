      },
      "rdfs:label": "tegevustoetus",
      "skos:altLabel": [
        {
          "@value": "Tegevustoetus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "linna poolne rahaline toetus ühingu tegevuse toetamiseks, s.o. igapäevased haldus- ja majanduskulud, milles arvestatakse liikmete või tegevusega hõlmatud isikute arvu, ruumide majanduskulusid jne. 6 (",
          "@language": "et"
        },
        {
          "@value": "linnaeelarveline eraldis mittetulundusühingutele, seltsingutele või kogukondadele linna arengukavaga ning küla- või asumivanema statuudiga kooskõlas oleva mittetulundusliku tegevuse toetamiseks. 2",
          "@language": "et"
        },
        {
          "@value": "on taotlemise aastale järgnevaks kalendriaastaks või jooksval aastal Rakvere linnaeelarvest antav toetus toetuse saaja regulaarse tegevusega seotud kulude katmiseks. 2",
          "@language": "et"
        },
        {
          "@value": "rahastamisliik, millega toetatakse mittetulundusühingu igapäevast tegevust ja arengut tervikuna, eesmärgiga säilitada või tõsta selle võimekust. 4 (",
          "@language": "et"
        },
        {
          "@value": "toetus, mis on ette nähtud Maardu linna lastele ja noortele vanuses 7‑19 aastat (erandkorras alates 4. eluaastast) suunatud sporditegevuse korraldamiseks Maardu linnas; 6",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      }
    },
