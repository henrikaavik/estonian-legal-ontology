        "@id": "estleg:Concept_jaatmejaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toila_valla_jaatmehoolduseeskiri_t1056448_hankija",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
