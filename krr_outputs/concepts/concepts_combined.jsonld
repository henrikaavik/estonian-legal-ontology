    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "teenistuja",
      "skos:definition": "vastavalt avaliku teenistuse seaduse § 5 on avalik teenistuja asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o töölepingu alusel töötav) töötaja; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
