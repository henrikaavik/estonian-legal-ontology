      },
      "rdfs:label": "reostusgrupp",
      "skos:altLabel": [
        {
          "@value": "Reostusgrupp",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "reovee reostustaset näitavate reostusnäitajate vahemik, mis on aluseks ülenormatiivse reostuse tasu kehtestamisele. Reostusgrupp on veeteenuse hinna alus",
          "@language": "et"
        },
        {
          "@value": "reovee reostustaset näitavate reostusnäitajate vahemik, mis on aluseks veeteenuse hinna määramisele või ülenormatiivse reostuse tasu kehtestamisele",
          "@language": "et"
        },
        {
          "@value": "reovee reostustaset näitavate reostusnäitajate vahemik, mis on aluseks ülenormatiivse reostuse tasu kehtestamisele",
          "@language": "et"
        },
        {
          "@value": "reovee reostusnäitajate piirväärtuste gruppide ja maksimaalsete reoainete sisalduse kujunemise vahemik, sõltuvalt reostatusest kehtestatakse ülenormatiivse reostuse tasu 24) reovee ärajuhtimise ja puhastamise eest, mille aluseks on vastav hinnagrupp.",
          "@language": "et"
        },
        {
          "@value": "reovee reostustaset määravate reostusnäitajate vahemik mis on aluseks ülenormatiivse reostuse tasu määramisele",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "12",
        "@type": "xsd:integer"
      },
