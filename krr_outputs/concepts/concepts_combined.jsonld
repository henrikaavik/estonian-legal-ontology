    {
      "@id": "estleg:Concept_johvi_valla_infoturvapoliitika_t1058728_ariprotsess",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "äriprotsess",
      "skos:definition": "kogum loogiliselt seotud tegevusi, mis sooritatakse asutuse eesmärkide saavutamiseks. Äriprotsessi tulemusena võidakse luua sise- või väliskliendile väärtust toodete või teenustena; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058728_Par_2"
        }
      ],
