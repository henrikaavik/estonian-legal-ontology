      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hea raamatupidamistava",
      "skos:definition": [
        {
          "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev raamatupidamistava, mille põhinõuded kehtestatakse raamatupidamise seaduses, mida täiendavad RTJ-d, FA juhend ja eeskiri; 6",
          "@language": "et"
        },
        {
          "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev raamatupidamistava, mille põhinõuded kehtestatakse RPS-is ning mida täiendavad RTJ-id ja Juhend; 2",
          "@language": "et"
        },
        {
          "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev raamatupidamistava, mille põhinõuded kehtestatakse RPS-s, mida täiendavad RTJ-d, FA juhend ja eeskiri; 6",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_heakord",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heakord",
