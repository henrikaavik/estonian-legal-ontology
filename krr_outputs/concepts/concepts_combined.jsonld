        "@language": "et"
      },
      "skos:definition": {
        "@value": "viimane sulgemisseade ühendustorul enne tarbimiskoha piiri, krundistamata hoonestuse puhul aga enne ehitisse sisenemist; peakraan lõpetab ühendustoru ja on üldjuhul liitumispunktiks",
        "@language": "et"
