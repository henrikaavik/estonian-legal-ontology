      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "septik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on pealt kinnine setiti, millesse sadestunud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043827_Par_2"
        }
      ],
