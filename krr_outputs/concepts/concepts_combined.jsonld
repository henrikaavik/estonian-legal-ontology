        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "korduskasutus",
      "skos:definition": [
        {
          "@value": "korduskasutus jäätmeseaduse mõistes, sealhulgas vastuvõtupunktidesse, turustajatele, ringlussevõtjatele või tootjatele tagastatud toote jätkuv kasutamine, samuti toote korduskasutus pärast ümbertöötamist",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korduskasutuspakend",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "korduskasutuspakend",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_korduskasutuspakend"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "korduskasutuspakend",
      "skos:definition": [
        {
          "@value": "pakend, mis on mõeldud ja kavandatud läbima oma olelustsükli jooksul mitu kasutuskäiku või- ringi. Korduvalt kasutatav pakend muutub pakendijäätmeks, kui ta ei kuulu enam korduskasutusele",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
