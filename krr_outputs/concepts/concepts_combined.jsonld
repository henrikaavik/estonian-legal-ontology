      },
      "rdfs:label": "väikeelamu",
      "skos:definition": [
        {
          "@value": "ühe või mitme leibkonna aastaringseks elamiseks ettenähtud üksikelamu, ridaelamu või kaksikelamu sektsioon, kahe korteriga elamu või ridaelamu.",
          "@language": "et"
        },
        {
          "@value": "üksikelamu, ridaelamu või kaksikelamu sektsioon, kahe korteriga elamu või ridaelamu.",
          "@language": "et"
        }
      ],
