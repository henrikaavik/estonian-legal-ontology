    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_hankeleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hankeleping",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "linna asutuse ja eduka pakkuja vahel sõlmitud rahaliste huvidega seotud leping, sealhulgas kontsessioonileping, mille esemeks on asjad, teenused või ehitustööd",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "hankeleping (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hankeleping"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_huvide_konflikt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvide konflikt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olukord, kus linna asutuse või tema nimel tegutseva isiku töötajal, ametnikul, juhatuse liikmel või muul pädeval esindajal, kes on kaasatud riigihanke ettevalmistamisse või korraldamisse või kes võib muul moel mõjutada selle riigihanke tulemust, on otseselt või kaudselt finantsalaseid, majanduslikke või muid isiklikke huvisid, mida võib käsitada tema erapooletust või sõltumatust kahjustavatena",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "huvide konflikt (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huvide_konflikt"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_huvide_konflikti_valtimise_deklaratsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvide konflikti vältimise deklaratsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hankekeskuse koostatud vormil antud kinnitus huvide konflikti puudumise kohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "huvide konflikti vältimise deklaratsioon (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huvide_konflikti_valtimise_deklaratsioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_keskkonnahoidlik_riigihange",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "keskkonnahoidlik riigihange",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "riigihange, kus on lisaks muudele tingimustele kehtestatud keskkonnanõuded ja -kriteeriumid, mille rakendamise eesmärk on vähendada negatiivset keskkonnamõju keskkonnahoidlike toodete, teenuste ja ehitustööde hankimise kaudu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "keskkonnahoidlik riigihange (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_keskkonnahoidlik_riigihange"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_keskne_riigihange",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "keskne riigihange",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "keskse hankija poolt linna asutustele asjade ostmine, teenuste või ehitustööde tellimine või raamlepingu sõlmimine asutustele asjade ostmiseks või teenuste või ehitustööde tellimiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "keskne riigihange (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_keskne_riigihange"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_korruptsiooni_valtimise_standardklauslid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "korruptsiooni vältimise standardklauslid",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lepingusse lisatavad või lepingus sisalduvad tingimused, mis hõlmavad lepingupoolte kohustusi, mis on seotud korruptsiooni vältimisega, ja vastutust korruptsioonivastaste meetmete rikkumise eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "korruptsiooni vältimise standardklauslid (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korruptsiooni_valtimise_standardklauslid"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_kirjalik_vorm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kirjalik vorm",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tehingudokumendi vormistamine paberil või elektrooniliselt, tehingu teinud isikute omakäelise või elektroonilise allkirjaga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "kirjalik vorm (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kirjalik_vorm"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_kirjalikku_taasesitamist_voimaldav_vorm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kirjalikku taasesitamist võimaldav vorm",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tahteavalduse vormistamine või teabe esitamine selliselt, et see on hiljem loetavalt esitatav ja sisaldab tehingu teinud isikute nimesid või teabe esitaja nime, kuid ei pea olema omakäeliselt allkirjastatud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "kirjalikku taasesitamist võimaldav vorm (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kirjalikku_taasesitamist_voimaldav_vorm"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_lepingu_taitmise_eest_vastutav_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lepingu täitmise eest vastutav isik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja, kes jälgib ja vajadusel korraldab, et lepingut täidetakse selles kokku lepitud tingimustel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "lepingu täitmise eest vastutav isik (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_lepingu_taitmise_eest_vastutav_isik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_ostumenetlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ostumenetlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asjade ostmine, teenuste (sh sotsiaal- ja eriteenused) ning ehitustööde tellimine või muu riigihange, millega ei kaasne riigihangete seaduse kohaselt nõutavaid toiminguid riigihangete registris ning mille korraldamisel lähtutakse hankekorras kehtestatud nõuetest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "ostumenetlus (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ostumenetlus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_raamleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "raamleping",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühe või mitme eduka pakkuja ja ühe või mitme linna asutuse vahel sõlmitud leping, millega kehtestatakse lepingu kehtivusaja vältel selle alusel sõlmitavaid hankelepinguid reguleerivad tingimused",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "raamleping (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_raamleping"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihange",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihange",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "maksumusest olenemata asja ostmine, teenuse tellimine, ideekavandi saamine, ehitustöö tellimine või kontsessioonilepingu sõlmimine linna asutuse poolt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "riigihange (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_riigihange"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_alusdokumendid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke alusdokumendid",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hanketeade, kontsessiooniteade, ideekonkursi kutse, pakkumuse esitamise ettepanek ja kõik linna asutuse koostatud või viidatud muud riigihanke menetlusega seotud dokumendid (välja arvatud riigihanke otsused), milles on määratud ühe konkreetse riigihanke üksikasjad, sealhulgas pakkujale ja taotlejale esitatud tingimused ja dokumentide esitamise nõuded, tehniline kirjeldus, lepingu tingimused ning pakkumuste hindamise kriteeriumid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "riigihanke alusdokumendid (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_riigihanke_alusdokumendid"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_eest_vastutav_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke eest vastutav isik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "linna asutuse juhi või tema volitatud isiku määratud isik, kes viib läbi riigihanke menetluse või ostumenetluse ja vastutab riigihanke menetluse või ostumenetluse läbiviimise õiguspärasuse eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "riigihanke eest vastutav isik (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_riigihanke_eest_vastutav_isik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_menetlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke menetlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "riigihangete seaduse alusel läbiviidav menetlus, millega kaasneb kohustus teha riigihangete seaduse kohaselt riigihangete registris toiminguid ja mille eesmärk on lepingu sõlmimine või ideekavandi saamine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "riigihanke menetlus (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_riigihanke_menetlus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_otsused",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke otsused",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "riigihangete seaduse või riigihanke alusdokumentide alusel vastuvõetavad otsused, mis vormistatakse käskkirja või korraldusena",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "riigihanke otsused (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_riigihanke_otsused"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_tehniline_kirjeldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke tehniline kirjeldus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asjade või teenuste lepingu esemeks olevate asjade või teenuste omaduste ja neile esitatavate nõuete loetelu ning ehitustööde lepingu esemeks olevate ehitustööde omaduste ja neile esitatavate tehniliste nõuete kogum. Lepingu eseme kirjeldamiseks kasutatakse vastavas valdkonnas tegutsevatele isikutele arusaadavat terminoloogiat ja täpsusastet",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "riigihanke tehniline kirjeldus (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_riigihanke_tehniline_kirjeldus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihangete_tugiteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihangete tugiteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "keskse hankija osutatav riigihangete korraldamise teenus, sealhulgas linna asutuste nõustamine riigihangetega seotud küsimustes, riigihanke ettevalmistamine ja toimingute tegemine linna asutuse nimel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "riigihangete tugiteenus (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_riigihangete_tugiteenus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
