      "rdfs:label": "sademetevee kanalisatsioon",
      "skos:definition": [
        {
          "@value": "ehitised ja seadmed sademete- ja drenaaživee ning muu pinnase- ja pinnavee ja puhta heitvee ära juhtimiseks; 20",
          "@language": "et"
        },
        {
          "@value": "ehitiste, sealhulgas kraavituste ja seadmete süsteem sademetevee ärajuhtimiseks ja kanaliseerimiseks. Sademetevee kanalisatsiooni käsitletakse ühiskanalisatsioonina; 18",
          "@language": "et"
        },
        {
          "@value": "ehitiste, sealhulgas kraavituste ja seadmete süsteem sademetevee ärajuhtimiseks ja kanaliseerimiseks. Sademetevee kanalisatsiooni käsitletakse ühiskanalisatsioonina; 23",
          "@language": "et"
        },
        {
          "@value": "rajatised ja seadmed sademete- ja drenaaživee ning muu pinnase- ja pinnavee ja puhta heitvee kanaliseerimiseks; 19",
          "@language": "et"
        }
      ],
