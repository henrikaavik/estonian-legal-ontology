      "rdfs:label": "kinnistu veevärk ja kanalisatsioon",
      "skos:definition": [
        {
          "@value": "liitumispunktist kinnistu pool asuvad ehitised ja seadmed, sealhulgas ehitiste siseveevärk ja - kanalisatsioon; 7",
