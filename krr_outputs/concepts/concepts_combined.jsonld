      }
    },
    {
      "@id": "estleg:Concept_johvi_vallavalitsuse_palgajuhend_t1062502_tootasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning muutuvpalgast, mida asutus maksab töötajale tehtud töö eest vastavalt töölepingule, õigusaktidele ja tööandja poolt kehtestatud korrale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062502_Par_2"
        }
      ],
