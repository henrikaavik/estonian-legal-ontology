    {
      "@id": "estleg:Concept_rahvusvaheliste_kultuuri_ja_spordisundmuste_toetamise_tingim_t1046611_rahvusvaheline_kultuuri",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "rahvusvaheline kultuuri",
      "skos:definition": "ja spordisündmus (edaspidi sündmus ) on Eestis aset leidev rahvusvahelisi kaaskorraldajaid ja/või osalejaid ja/või pealtvaatajaid kaasav üksiksündmus või sündmuste sari, millel esineb turutõrge ning mille toetamise tulemusena on rahvusvaheliste kaaskorraldajate, välismaiste toetajate toetuse arvelt tehtavatelt kuludelt, välisosalejate ja väliskülastajate poolt Eestis tehtud kuludelt riigile laekuv hinnanguline täiendav maksutulu vähemalt võrdne toetuse 1,2 kordse suurusega; RT I 2025-10-22 1 122102025001 2025-10-25 1 1<sup>1</sup>) sündmuste sari on kahest kuni viiest ühe valdkonna üksiksündmusest koosnev tervik, mille üksiksündmuse kestus ei ületa kahte nädalat, kõik üksiksündmused korraldab sama käesoleva määruse § 5 lõikes 1 nimetatud isik, kõik üksiksündmused toimuvad 12 kuu jooksul, iga üksiksündmus on rahvusvaheline ning omab majanduslikku mõju ning mille üksiksündmuste kogumajanduslik mõju vastab käesoleva paragrahvi punktis 1 nimetatud suurusele; RT I 2025-10-22 1 122102025001 2025-10-25 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046611_Par_2"
        }
      ],
      "estleg:sourceAct": "Rahvusvaheliste kultuuri- ja spordisündmuste toetamise tingimused ja kord",
      "rdfs:label": "rahvusvaheline kultuuri (rahvusvaheliste_kultuuri_ja_spordisundmuste_toetamise_tingim_t1046611)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_rahvusvaheline_kultuuri"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_rahvusvaheline_kultuuri"
        }
      ]
    },
    {
