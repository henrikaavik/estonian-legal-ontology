      "rdfs:label": "komposter",
      "skos:definition": [
        {
          "@value": "biolagunevate jäätmete kogumiseks tekkekohas mikro- ja makroorganismide kaasabil aeroobseks lagundamiseks kasutatav mahuti, kuhu on takistatud lindude ja loomade juurdepääs; 20",
          "@language": "et"
        },
        {
          "@value": "biolagunevate jäätmete lagundamiseks kasutatav mahuti; 17",
          "@language": "et"
        },
        {
          "@value": "biolagunevate jäätmete lagundamiseks kasutatav selleks ettenähtud funktsionaalsusega seade; 12",
          "@language": "et"
        },
        {
          "@value": "orgaaniliste jäätmete lagundamiseks kasutatav mahuti; 14",
          "@language": "et"
        }
      ]
    },
