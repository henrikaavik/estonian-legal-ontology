        },
        {
          "@value": "koostööpartneri või doonori rahaline või rahaliselt mõõdetav panus projekti lisaks toetusele ja toetuse saaja omafinantseeringule",
          "@language": "et"
        },
        {
          "@value": "projekti, ürituse või tegevuse kaasrahastamiseks sihtotstarbeliselt eraldatud toetus teistelt rahastajatelt",
          "@language": "et"
        },
        {
          "@value": "teised kohaliku omavalitsuse, riigi või Euroopa Liidu institutsioonide või fondide või ettevõtete antud tagastamatud toetused ning konverentsi osalustasudest vms saadav tulu",
          "@language": "et"
        }
