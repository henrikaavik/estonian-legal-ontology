          "@id": "estleg:Concept_viimsi_valla_sotsiaaltoetuste_maaramise_ja_maksmise_tingimus_t1054418_Uksikvanem"
        },
        {
          "@id": "estleg:Concept_viimsi_valla_sporditegevuse_toetamise_kord_t1060393_uksikvanem"
