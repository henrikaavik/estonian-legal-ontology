    {
      "@id": "estleg:Concept_reklaami_paigaldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaami paigaldaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaks_t1043694_reklaami_paigaldaja"
        },
        {
          "@id": "estleg:Concept_reklaami_paigaldamine_ja_reklaamimaksu_kehtestamine_rae_vall_t1055163_reklaami_paigaldaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "reklaami paigaldaja",
      "skos:definition": [
        {
          "@value": "isik, kes korraldab reklaami paigaldamist või kelle korraldusel reklaami paigaldatakse",
          "@language": "et"
        },
        {
          "@value": "reklaami tellija, teostaja või avalikustaja",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaami paigaldamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_reklaamimaks_t1055745_reklaami_paigaldamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "reklaami paigaldamine",
      "skos:definition": [
        {
          "@value": "reklaami avalikustamise eesmärgil selle eksponeerimine avalikus kohas ning füüsilistele ja juriidilistele isikutele kuuluvatel kinnistutel, territooriumil, ehitisel või selle osal kui see on suunatud avalikkusele",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamise_luba",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaami paigaldamise luba",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_reklaami_paigaldamise_luba"
        },
        {
          "@id": "estleg:Concept_viimsi_valla_reklaamimaarus_t1039864_reklaami_paigaldamise_luba"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "reklaami paigaldamise luba",
      "skos:definition": [
        {
          "@value": "Raasiku Vallavalitsuse (edaspidi vallavalitsus ) korraldus, millega antakse nõusolek reklaami või reklaamialuse paigaldamiseks. Reklaamina ei käsitata: 1) majandus- või kutsetegevuse kohas antavat teavet kauba, teenuse või selle müügitingimuste kohta (tarbijakaitseseaduse § 4 lõikes 2 nimetatud teave); 2) majandus- või kutsetegevuse koha tähistust selle nime, liigi, kauba müügi või teenuse osutamise aja, isiku nime, kaubamärgi ja domeeninimega ehitisel või tänavakaubanduse kioskil, kus majandus- või kutsetegevuse koht asub; 3) väljaspool ehitist asuva majandus- või kutsetegevuse koha tähistust käesoleva lõike punktides 1 ja 2 nimetatud teabega, mis asub majandus- või kutsetegevuse ehitise juurde kuuluval kinnistul; 4) isiku majandus- või kutsetegevuses kasutatava sõiduki tähistust selle isiku nime, kontaktandmete, kaubamärgi, domeeninime ja tegevusalaga; 5) märgistust kauba müügipakendil pakendiseaduse tähenduses; 6) sponsorteates avaldatud spondeerija nime, kaubamärki ja teavet tema antud toetuse kohta; 7) roogade ja jookide hinnakirja, mis on paigutatud toitlustusettevõtte sissekäigu juurde.",
          "@language": "et"
        },
        {
          "@value": "Viimsi Vallavalitsuse (edaspidi vallavalitsus ) nimel ehitus- ja kommunaalosakond poolt väljastatav luba, millega antakse nõusolek välireklaami eksponeerimiseks või reklaamikandja paigaldamiseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldusluba",
      "@type": [
        "owl:NamedIndividual",
