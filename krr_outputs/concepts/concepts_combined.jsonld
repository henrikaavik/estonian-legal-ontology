      },
      "rdfs:label": "avalik rajatis",
      "skos:definition": [
        {
          "@value": "detailplaneeringukohane (planeeringualal asuv) ning planeeringulahenduse elluviimiseks otseselt vajalik (planeeringualast väljapool asuv) avalikuks kasutamiseks ette nähtud rajatis (sõidutee, jalg- või jalgrattatee ning sellega seotud rajatised, tänavavalgustus, haljastus, maaparandussüsteem, sademeveesüsteem, spordi- või puhkerajatis, sh mänguväljak).",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_avalik_ruum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik ruum",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_avalik_ruum"
