      "rdfs:label": "reovee kohtkäitlusrajatis",
      "skos:definition": [
        {
          "@value": "reovee kogumismahuti (sh kuivkäimla lampkast) või omapuhasti (septik filterväljakuga või biopuhasti imbväljakuga)",
          "@language": "et"
        },
        {
          "@value": "reovee kogumismahuti (sh kuivkäimla lampkast) või omapuhasti (sh septik)",
          "@language": "et"
        },
        {
          "@value": "reovee kogumismahuti, omapuhasti või kuivkäimla kogumismahuti",
          "@language": "et"
        },
        {
          "@value": "reovee kogumismahuti, omapuhasti või kuivkäimla lampkast",
          "@language": "et"
        },
        {
          "@value": "lekkekindel kogumismahuti (sh kuivkäimla lampkast) või omapuhasti",
          "@language": "et"
        }
      ],
