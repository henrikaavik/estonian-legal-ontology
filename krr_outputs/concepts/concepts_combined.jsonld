        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tehases eelnevalt valmistatud elementidega rekonstrueerimine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_tehases_eelnevalt_valmistatud_elementidega_rekonstrueerimine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tehases eelnevalt valmistatud elementidega rekonstrueerimine",
      "skos:definition": [
        {
          "@value": "korterelamu rekonstrueerimine, mille raames kandekonstruktsioon, soojustus ja põhimahus elementide välisviimistlus on teostatud tehases, sealjuures peab 2/3 fassaadi pinnast olema tehases lõplikult viimistletud ning välisseina element peab olema vähemalt korterelamu ühe korruse kõrgune, aknad paigaldatakse välisseina elementi tehases, lodža või rõdu sisse jäävat seinaosa ei ole kohustuslik eeltoodetud elementidega soojustada ning kui ka katuse rekonstrueerimiseks kasutatakse eeltoodetud elemente, siis peavad elemendid vähemalt kandekonstruktsiooni ja soojustuskihi osas olema tehases koostatud, kuid katusekatte paigalduse võib teha ka ehitusobjektil",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
