          "@id": "estleg:Concept_haademeeste_valla_arengukava_ja_eelarvestrateegia_koostamise_t1056791_Arengukava_on_Haademeeste_valla_pika"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Arengukava on Häädemeeste valla pika",
      "skos:definition": [
        {
          "@value": "ja lühiajalise arengu eesmärke määratlev ja nende elluviimise tegevusi kavandav dokument, mis tasakaalustatult arvestab demograafilise, majandusliku, sotsiaalse ja kultuurilise keskkonna ning looduskeskkonna arengu pikaajalisi suundumusi ja vajadusi ning on aluseks erinevate eluvaldkondade arengute integreerimisele ja koordineerimisele. 2 (",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_arengukava_on_linna_pika",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Arengukava on linna pika",
