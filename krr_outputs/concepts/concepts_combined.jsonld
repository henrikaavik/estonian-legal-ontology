    {
      "@id": "estleg:Concept_kohila_vallavalitsuse_palgajuhend_t1060653_ametiasutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametiasutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kohaliku omavalitsuse üksuse eelarvest finantseeritav asutus, mille ülesanne on avaliku võimu teostamine ja tema allasutused",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060653_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila Vallavalitsuse palgajuhend",
      "rdfs:label": "ametiasutus (kohila_vallavalitsuse_palgajuhend_t1060653)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametiasutus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_vallavalitsuse_palgajuhend_t1060653_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vastavalt avaliku teenistuse seadusele on avalik teenistuja ametiasutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (so töölepingu alusel töötav) töötaja või tööline",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060653_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (kohila_vallavalitsuse_palgajuhend_t1060653)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_vallavalitsuse_palgajuhend_t1060653_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on ametiasutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060653_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (kohila_vallavalitsuse_palgajuhend_t1060653)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_vallavalitsuse_palgajuhend_t1060653_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060653_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (kohila_vallavalitsuse_palgajuhend_t1060653)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_vallavalitsuse_palgajuhend_t1060653_spetsialist",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "spetsialist",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötaja, kelle tööülesannete täitmiseks on vaja keskeri või kõrgharidust ja häid praktilisi teadmisi ja kogemusi vastavas valdkonnas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060653_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila Vallavalitsuse palgajuhend",
      "rdfs:label": "spetsialist (kohila_vallavalitsuse_palgajuhend_t1060653)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_spetsialist"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_vallavalitsuse_palgajuhend_t1060653_tooline",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tööline",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutusega eraõiguslikus töösuhtes olev teenindustöötaja, oskustööline, lihttööline. Tööline töötab töölepingu alusel ning töölise teenistuskohta nimetatakse töökohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060653_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila Vallavalitsuse palgajuhend",
      "rdfs:label": "tööline (kohila_vallavalitsuse_palgajuhend_t1060653)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tooline"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_vallavalitsuse_palgajuhend_t1060653_teenistuskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht",
