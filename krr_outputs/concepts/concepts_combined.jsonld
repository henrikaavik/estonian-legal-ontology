    {
      "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Toimingupiirang",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Toimingupiirang",
      "skos:definition": "vastutava isiku kohustus end toimingu tegemisest taandada, kui vastutav isik KVS § 2 lg 1 tähenduses peab oma tööülesannetest tulenevalt tegema toimingu või otsuse, millele rakendub KVS § 11 lõike 1 mõttes toimingupiirang. 9",
      "estleg:definedIn": [
