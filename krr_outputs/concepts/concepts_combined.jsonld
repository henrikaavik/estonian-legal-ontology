    {
      "@id": "estleg:Concept_saue_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeskir_t1006506_tegevuspiirkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tegevuspiirkond",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "piiritletud maa-ala kus vee-ettevõtja osutab veega varustamise ja reo- ning sademevee ärajuhtimise teenuseid",
