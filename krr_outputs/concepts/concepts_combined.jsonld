    {
      "@id": "estleg:Concept_haljastuse_inventeerimise_kord_t1049755_puuderuhma_koosseis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puuderühma koosseis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puuliikide osatähtsus rühmas, mida väljendatakse enamasti kooseisuvalemina (nt 70Ku20Ks10Hb tähendab, et 70% puuderühmast moodustavad kuused, 20% kased ja 10% haavad; kui puuderühmas kasvab üle 90% ühte liiki puid, võib puuderühma koosseisuks märkida selle liigi)",
        "@language": "et"
      },
      "estleg:definedIn": [
