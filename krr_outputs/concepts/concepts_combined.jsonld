      ],
      "skos:prefLabel": {
        "@value": "Teenistuskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "linnavalitsuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht, sh ametikoht on ametniku teenistuskoht ja töökoht on töötaja teenistuskoht.",
        "@language": "et"
