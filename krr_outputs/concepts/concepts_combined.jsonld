      ],
      "estleg:definitionCount": {
        "@value": "10",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hooldaja",
      "skos:altLabel": [
        {
          "@value": "Hooldaja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "Haapsalu Linnavalitsuse (edaspidi linnavalitsus) poolt määratud teovõimeline isik, kes tagab hooldatavale igapäevase kõrvalabi, juhendamise ja järelvalve. 3",
          "@language": "et"
        },
        {
          "@value": "isik, kes on määratud sotsiaal- ja tervishoiu osakonna (edaspidi osakond) poolt raske või sügava puudega täisealise isiku hooldajaks või keskmise, raske või sügava puudega lapse hooldajaks. 7",
          "@language": "et"
        },
        {
          "@value": "kohaliku omavalitsuse poolt määratud teovõimeline isik, kes tagab hooldatavale kõrvalabi, juhendamise ja järelevalve. 3",
          "@language": "et"
        },
        {
          "@value": "Saarde vallavalitsuse (edaspidi vallavalitsus) poolt määratud teovõimeline isik, kes tagab hooldatavale kõrvalabi, juhendamise ja järelevalve; 3",
          "@language": "et"
        },
        {
          "@value": "sotsiaalhoolekande osakonna juhataja käskkirjaga määratud hooldust teostav isik, kes tagab hooldatavale kõrvalabi, juhendamise ja järelevalve; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "10",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_hooldatav"
        }
      ]
    },
