    {
      "@id": "estleg:Concept_rae_valla_kaevetoode_eeskiri_t1023385_Kaevaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kaevaja",
      "skos:definition": "tehnovõrgu omanik kelle kasuks on maaüksusele seatud notariaalne kasutusvaldus ja kellele on vormistatud kaeveluba. Avariikaevetööde puhul võib olla Kaevajaks tehnovõrgu omaniku poolt kirjalikult määratud isik, kes asub tegema avariikaevetöid tehnovõrgu avarii likvideerimiseks tehnovõrgu omaniku poolt kinnitatud avariikaevetööde akti alusel. 5 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1023385_Par_2"
        }
      ],
