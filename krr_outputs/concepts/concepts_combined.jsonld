      }
    },
    {
      "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "septik",
