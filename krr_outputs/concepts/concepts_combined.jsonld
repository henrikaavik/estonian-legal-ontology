      },
      "rdfs:label": "projekti abikõlblikkuse periood",
      "skos:definition": [
        {
          "@value": "taotleja poolt projekti elluviimiseks kavandatud aeg taotlusvooru abikõlblikkuse perioodi jooksul. Projekti abikõlblikkuse periood sätestatakse taotluse rahuldamise otsuses ja toetuslepingus.",
          "@language": "et"
        },
        {
          "@value": "taotleja poolt projekti elluviimiseks kavandatud aeg taotlusvooru abikõlblikkuse perioodi jooksul. Projekti abikõlblikkuse periood sätestatakse toetuslepingus.",
          "@language": "et"
        },
        {
          "@value": "toetuse taotluse rahuldamise otsuses määratud ajavahemik, millal algavad ja lõpevad projekti tegevused ning tekivad projekti elluviimiseks vajalikud kulud",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
