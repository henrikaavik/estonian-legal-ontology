          "@value": "osalustasu või õppetasu",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "lapsevanema poolt tasutav summa huvihariduse või -tegevuse pakkujale. 5",
          "@language": "et"
        },
        {
          "@value": "lapsevanema poolt tasutav summa huvihariduse või huvitegevuse pakkujale; 6",
          "@language": "et"
        },
        {
          "@value": "lapsevanema poolt tasutav summa huvihariduse- või- tegevuse pakkujale. 5",
          "@language": "et"
        },
        {
          "@value": "õpilase huvihariduse omandamise või huvitegevuses osalemise eest makstav tasu huvihariduse või huvitegevuse pakkujale; 6",
          "@language": "et"
        }
      ]
    },
