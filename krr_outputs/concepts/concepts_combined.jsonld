      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvitegevuse_ja_huvihariduse_toetuse_maaramise_ja_maksmise_k_t1047523_oppekoha_maksumus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "õppekoha maksumus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "huvikooli õpilaskoha tegevuskulu arvestuslik maksumus, ühe õppuri huvihariduse omandamiseks ühe õppekava ulatuses; 6) õppemaks (osalustasu) - lapsevanema poolt tasutav summa huvihariduse või huvitegevuse pakkujale; 7) laager, võistlus (turniir, konkurss, festival) - huvikooli või huviringi poolt korraldatud eesmärgistatud ühistegevus, mille jooksul tegeletakse intensiivselt huviõppega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047523_Par_3"
        }
      ],
