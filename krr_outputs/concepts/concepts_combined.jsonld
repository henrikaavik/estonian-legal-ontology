    {
      "@id": "estleg:Concept_laane_harju_vallavalitsuse_infoturbepoliitika_t1047850_Andmete_tootlemine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Andmete töötlemine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "informatsiooni kirjapanek taasesitamist võimaldaval kujul, andmete kogumine, salvestamine, korrastamine, säilitamine, muutmine, nende kohta päringute teostamine, nendest väljavõtete tegemine, andmete kasutamine, üleandmine, ühendamine, sulgemine, kustutamine või hävitamine või mitu eeltoodud toimingut, sõltumata toimingute teostamise viisist või kasutatavatest vahenditest; 6) Infosüsteemide kolmeastmeline etalonturve (edaspidi ISKE) − infoturbe metoodika, mida rakendatakse andmekogudele ja mis sisaldab juhised, kuidas korraldada infoturbe haldust, määrata infovarade turbevajadust ning turvameetmete kataloogi; 7) Kasutusõigus (pääsuõigus) - isikule antav mistahes infosüsteemis konkreetsele kasutajakontole antud kasutusõigus ja õiguste tase",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047850_Par_3"
        }
      ],
      "estleg:sourceAct": "Lääne-Harju Vallavalitsuse infoturbepoliitika",
      "rdfs:label": "Andmete töötlemine (laane_harju_vallavalitsuse_infoturbepoliitika_t1047850)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_andmete_tootlemine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_laane_harju_vallavalitsuse_infoturbepoliitika_t1047850_Kaugtoo",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Kaugtöö",
        "@language": "et"
