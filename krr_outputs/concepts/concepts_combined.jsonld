        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tüübivastavuse tunnistus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduki valmistaja, tema ametliku esindaja, sissetooja või Transpordiameti poolt väljastatav dokument, mis kinnitab, et toode vastab tüübikinnitusega määratud tüübile; 20) identifitseerimisnumber ( VIN- või TIN-kood või kere/raami number ) – sõidukile kantud tähtede ja/või numbrite kombinatsioon, mille valmistaja on määranud konkreetse sõiduki tähistamiseks ja tuvastamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000727_Par_2"
        }
      ],
      "estleg:sourceAct": "Mootorsõiduki ja selle haagise registreerimise tingimused ja kord",
