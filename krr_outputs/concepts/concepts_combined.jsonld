      "@id": "estleg:Concept_tallinna_hankekord_t1058097_kirjalik_vorm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kirjalik vorm",
      "skos:definition": "tehingudokumendi vormistamine paberil või elektrooniliselt, tehingu teinud isikute omakäelise või elektroonilise allkirjaga; 8",
