      ],
      "skos:prefLabel": {
        "@value": "ohtlik rikošett",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "nähtus, mille tagajärjel kuul või lendkeha kas põrkub või fragmenteerub ohtlikult, kui tabab kõva materjali või objekti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051456_Par_2"
