        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Korterelamu liftisüsteemi uuendamine",
      "skos:definition": [
        {
          "@value": "olemasoleva lifti osade vahetus, lifti terviklik asendamine, lifti lisamine kortermajale",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamu_terviklik_rekonstrueerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Korterelamu terviklik rekonstrueerimine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Korterelamu_terviklik_rekonstrueerimine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Korterelamu terviklik rekonstrueerimine",
      "skos:definition": [
        {
          "@value": "korterelamul soojustatakse vähemalt kõik välisseinad ja katus, vahetatakse kõigi eluruumide aknad, rekonstrueeritakse küttesüsteem, rekonstrueeritakse elektrisüsteem. Kortermaja täisrekonstrueerimisel võivad ehitustööd olla alustatud enne toetuse taotluse esitamist. Ehitustööd peavad lõppema avalduse esitamise aastal ja aruanne peab olema esitatud käesoleva määruse § 5 lõikes 11 sätestatud korras",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamu_tervikliku_rekonstrueerimise_pohiprojekti_koostamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Korterelamu tervikliku rekonstrueerimise põhiprojekti koostamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Korterelamu_tervikliku_rekonstrueerimise_pohiprojekti_koostamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Korterelamu tervikliku rekonstrueerimise põhiprojekti koostamine",
      "skos:definition": [
        {
          "@value": "ehitusprojekt, mis on koostatud vastavalt ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuetele, põhiprojekti järgi peab korterelamul soojustatama vähemalt kõik välisseinad ja katus, vahetatama kõigi eluruumide aknad, rekonstrueeritama küttesüsteem, rekonstrueeritama elektrisüsteem",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
