      "skos:definition": [
        {
          "@value": "süvendi kaevamine sügavamale kui 30 cm maapinnast",
          "@language": "et"
        },
        {
          "@value": "sügavamal kui 30 cm pinnases mehhaniseeritud seadmega tehtav töö või pinnase planeerimise käigus maapinna kõrguse muutmine üle 30 cm",
          "@language": "et"
        },
        {
          "@value": "pinnasetöö, mida tehakse sügavamal kui 30 cm maapinnast, samuti töö, mille käigus rikutakse tee-või pinnakatet (asfalt, sillutis, muru jne).",
          "@language": "et"
        },
        {
          "@value": "sügavamal kui 30 cm pinnases tehtav töö või pinnase planeerimise käigus maapinna kõrguse muutmine üle 30 cm",
          "@language": "et"
        },
        {
          "@value": "tagasitäidetavate süvendite kaevamine ja tagasitäitmine või pinnase koorimine sügavamale kui 30 cm maapinnast",
          "@language": "et"
        }
      ],
