      ],
      "skos:prefLabel": {
        "@value": "Õppur",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Rõuge vallas elav laps või noor vanuses 7 kuni 19 eluaastat, kes õpib huvikoolis või osaleb huvitegevuses.",
        "@language": "et"
      },
      "estleg:definedIn": [
