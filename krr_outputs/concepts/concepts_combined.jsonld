      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_linna_jaatmehoolduseeskiri_t1056868_jaatmevedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevedaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenuste kontsessiooni või teenuste riigihanke korras valitud isik, kes osutab jäätmevaldajatele korraldatud jäätmeveo teenust kindlaksmääratud jäätmeliikide osas ja jäätmeveopiirkonnas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056868_Par_3"
        }
      ],
      "estleg:sourceAct": "Narva linna jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevedaja (narva_linna_jaatmehoolduseeskiri_t1056868)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevedaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_linna_jaatmehoolduseeskiri_t1056868_jaatmevaldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevaldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu-, äri- või tootmisruum",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056868_Par_3"
        }
      ],
      "estleg:sourceAct": "Narva linna jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevaldaja (narva_linna_jaatmehoolduseeskiri_t1056868)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevaldaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_linna_jaatmehoolduseeskiri_t1056868_jaatmekaitleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmekäitleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidiline või füüsiline isik, kes kogub, veab, taaskasutab või kõrvaldab jäätmeid majandus- või kutsetegevusena ja kellel on selleks tegevuseks vastav keskkonnaluba",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056868_Par_3"
        }
      ],
      "estleg:sourceAct": "Narva linna jäätmehoolduseeskiri",
      "rdfs:label": "jäätmekäitleja (narva_linna_jaatmehoolduseeskiri_t1056868)",
