      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_hankeleping"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_huvide_konflikt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "huvide konflikt",
      "skos:definition": "olukord, kus linna asutuse või tema nimel tegutseva isiku töötajal, ametnikul, juhatuse liikmel või muul pädeval esindajal, kes on kaasatud riigihanke ettevalmistamisse või korraldamisse või kes võib muul moel mõjutada selle riigihanke tulemust, on otseselt või kaudselt finantsalaseid, majanduslikke või muid isiklikke huvisid, mida võib käsitada tema erapooletust või sõltumatust kahjustavatena; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
      "estleg:sourceAct": "Tallinna hankekord",
      "rdfs:label": "huvide konflikt (tallinna_hankekord_t1058097)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huvide_konflikt"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_huvide_konflikt"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_huvide_konflikti_valtimise_deklaratsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "huvide konflikti vältimise deklaratsioon",
      "skos:definition": "hankekeskuse koostatud vormil antud kinnitus huvide konflikti puudumise kohta; 4",
