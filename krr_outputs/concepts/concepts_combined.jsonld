    {
      "@id": "estleg:Concept_joelahtme_valla_jaatmehoolduseeskiri_t1053601_uhismahuti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühismahuti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmemahuti, mida omavahelise kokkuleppe alusel kasutab rohkem kui üks jäätmevaldaja ning mille tühjendamiseks on vähemalt ühel jäätmevaldajal sõlmitud jäätmevedajaga jäätmeleping. Eeskirjas nimetamata mõiste kasutamisel lähtutakse jäätmeseaduses, pakendiseaduses ja teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053601_Par_3"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla jäätmehoolduseeskiri",
      "rdfs:label": "ühismahuti (joelahtme_valla_jaatmehoolduseeskiri_t1053601)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhismahuti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_koerte_ja_kasside_pidamise_eeskiri_t1013342_loomapidaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "loomapidaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kellele loom kuulub (edaspidi nimetatud loomaomanik) või kes tegeleb loomapidamisega rendi- või muu selletaolise suhte alusel looma omanikuna. Kuuluvuse kaudu identifitseerimisel loetakse loom kuuluvaks isikule, kelle valduses, sealhulgas kelle kinnisel territooriumil või kellele kuuluvas hoones või rajatises ta asub kui looma kuuluvusest huvitatud isik ei tõenda vastupidist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013342_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla koerte ja kasside pidamise eeskiri",
      "rdfs:label": "loomapidaja (joelahtme_valla_koerte_ja_kasside_pidamise_eeskiri_t1013342)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_loomapidaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_koerte_ja_kasside_pidamise_eeskiri_t1013342_hulkuv_loom",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hulkuv loom",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "märgistamata loom, kelle omanikku ei ole võimalik tuvastada või loomapidaja juurest lahti pääsenud loom, kes viibib omaniku või looma eest vastutava isiku juuresolekuta väljaspool loomapidajale kuuluvat või tema kasutuses olevat territooriumi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013342_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla koerte ja kasside pidamise eeskiri",
