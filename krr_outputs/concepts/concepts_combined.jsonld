    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_meetme_ettevotete_ressursitohusus_t1042181_alginvesteering",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "alginvesteering",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "investeering materiaalsesse ja/või immateriaalsesse varasse seoses uue ettevõtte asutamisega, olemasoleva ettevõtte tootmisvõimsuse suurendamisega, ettevõtte toodangu mitmekesistamisega toodetega, mida ei ole veel ettevõttes toodetud, või olemasoleva ettevõtte kogu tootmisprotsessi täieliku ümberkorraldamisega, või vara soetamine ettevõttelt, mis on lõpetanud tegevuse või oleks tegevuse lõpetanud, kui seda ei oleks ostetud, ja seda ostab müüjaga mitteseotud investor ning tegemist ei ole üksnes ettevõtja aktsiate omandamisega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042181_Par_2"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused meetme „Ettevõtete ressursitõhusus” tegevuse „Jäätmete ringlussevõtu toetamine” jaoks avatud taotlemise korral",
      "rdfs:label": "alginvesteering (toetuse_andmise_tingimused_meetme_ettevotete_ressursitohusus_t1042181)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_alginvesteering"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_meetme_ettevotete_ressursitohusus_t1042181_umberpaigutamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ümberpaigutamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sama või sarnase tegevuse või selle osa üleviimine ühest EMP (Euroopa Majanduspiirkond) lepingu osalisriigi ettevõttest (algne ettevõte) teise EMP lepingu muus osalisriigis asuvasse ettevõttesse, kuhu toetatav investeering tehakse (toetatav ettevõte). Ümberpaigutamine toimub siis, kui toode või teenus täidab nii algses kui ka toetatavas ettevõttes vähemalt osaliselt sama otstarvet ja vastab sama liiki tarbija nõudmistele või vajadustele ja EMPs asuva abisaaja ühes ettevõttes lähevad samas või sarnases tegevusalas kaduma töökohad",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042181_Par_2"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused meetme „Ettevõtete ressursitõhusus” tegevuse „Jäätmete ringlussevõtu toetamine” jaoks avatud taotlemise korral",
      "rdfs:label": "ümberpaigutamine (toetuse_andmise_tingimused_meetme_ettevotete_ressursitohusus_t1042181)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_umberpaigutamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_meetme_kaitsealuste_liikide_ja_el_t1030319_pinnaveekogum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pinnaveekogum",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "mõistet kasutatakse veeseaduse § 2 punkti 37 tähenduses; 15) materiaalne vara on üldise grupierandi määruse artikli 2 punkti 29 tähenduses maast, hoonetest ja tootmisrajatistest, masinatest ja seadmetest koosnev vara, mis on tingimata vajalik keskkonnakaitse eesmärkide saavutamiseks ning investeeringud tootmismeetodite kohandamisse keskkonnakaitsega; 16) looduslähedane kalapääs on jõe looduslikku elupaika jäljendav kalapääs. Looduslähedaseks kalapääsuks ei loeta näiteks kamber-tüüpi kalapääse ja kalalifti; 17) partner on taotluses nimetatud füüsiline isik, juriidiline isik, riigiasutus, kohaliku omavalitsuse asutus või rahvusvaheline organisatsioon, kes osaleb projektis toetatava tegevuse rakendamisel ja kellel tekivad selle käigus kulud.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030319_Par_2"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused meetme „Kaitsealuste liikide ja elupaikade säilimine ning taastamine” tegevuse „Vooluveekogude tervendamine” jaoks avatud taotlemise korral",
      "rdfs:label": "pinnaveekogum (toetuse_andmise_tingimused_meetme_kaitsealuste_liikide_ja_el_t1030319)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pinnaveekogum"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_meetmes_ettevotete_ressursitohusu_t1043913_umberpaigutamine",
