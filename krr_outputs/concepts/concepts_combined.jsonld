      ],
      "skos:prefLabel": {
        "@value": "liitumispunkt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "võrgu ja tarbijapaigaldise ühenduskoht, mis on ka soojuse üleandmispunktiks müüjalt ostjale (punkt arvesti ja soojussõlme vahel, ehk seal, kus toimub soojuskandja parameetrite mõõtmine",
        "@language": "et"
      },
      "estleg:definedIn": [
