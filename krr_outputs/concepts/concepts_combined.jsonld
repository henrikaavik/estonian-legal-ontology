      ],
      "skos:prefLabel": {
        "@value": "ohuala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eluohtlik ala, kus viibiv inimene päästetakse või evakueeritakse ning kuhu võib siseneda vaid asjakohast väljaõpet omav ja kaitsemeetmeid kasutav inimene päästetöö juhi antud ülesande täitmiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000524_Par_13"
        }
      ],
