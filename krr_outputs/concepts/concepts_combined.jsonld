    {
      "@id": "estleg:Concept_voru_vallavalitsuse_palgajuhend_t1040989_ametiasutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametiasutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kohaliku omavalitsuse üksuse eelarvest finantseeritav asutus, kelle ülesanne on avaliku võimu teostamine",
        "@language": "et"
      },
      "estleg:definedIn": [
