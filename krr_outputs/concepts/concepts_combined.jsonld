    {
      "@id": "estleg:Concept_ida_viru_taiskasvanutele_suunatud_hariduslike_algatuste_toet_t1061040_opisundmus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "õpisündmus",
      "skos:definition": "mitteformaalõppe osa, mis ei nõua eraldi õppekava koostamist ning õpiväljundite sõnastamist; õpisündmus aitab kaasa õppimisele, teadmiste omandamisele või oskuste arendamisele ning võib hõlmata mitmesuguseid õppevorme nagu loengud, seminarid, praktilised harjutused, töötoad, õppekäigud, arutelud ja muud sarnased tegevused; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061040_Par_2"
        }
      ],
