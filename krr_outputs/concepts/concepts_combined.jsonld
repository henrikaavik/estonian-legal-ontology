    {
      "@id": "estleg:Concept_kohila_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eesk_t1061205_uhisveevark_ja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "ühisveevärk ja",
      "skos:definition": "kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu varustatakse tarbijaid joogiveega ja juhitakse ära ning puhastatakse reovett ning mille projekteeritud jõudlus on vähemalt kümme kuupmeetrit ööpäevas ja mis teenindab vähemalt 50 inimest. Ühisveevärgi ja -kanalisatsioonina käsitatakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos. Sademeveekanalisatsioon Kohila vallas ei ole ühiskanalisatsiooni osa; 24",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061205_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
