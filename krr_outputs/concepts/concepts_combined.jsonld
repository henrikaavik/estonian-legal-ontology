    {
      "@id": "estleg:Concept_paide_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_k_t1043354_tegevuspiirkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tegevuspiirkond",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "piiritletud maa-ala, kus vee-ettevõtja osutab veega varustamise või reo- ning sademevee ärajuhtimise teenuseid",
        "@language": "et"
      },
      "estleg:definedIn": [
