      "rdfs:label": "lisatasu",
      "skos:definition": [
        {
          "@value": "põhi- ja muutuvpalgale lisaks makstav täiendav tasu puuduva ametniku ülesannete täitmise ning ületunnitöö, valveaja, öötöö ja riigipühadel töötamise eest",
          "@language": "et"
        },
        {
          "@value": "seaduse alusel makstav lisatasu valveaja, ületunnitöö, ööajal tehtava töö ja riigipühadel tehtava töö eest",
          "@language": "et"
        },
        {
          "@value": "täiendavate tööülesannete täitmise eest makstav tasu",
          "@language": "et"
        },
        {
          "@value": "ametniku ja töötaja põhi- ja muutuvpalgale lisaks makstav täiendav tasu puuduva teenistuja ülesannete täitmise ning ületunnitöö ja riigipühadel töötamise eest",
          "@language": "et"
        },
        {
          "@value": "palgale või töötasule lisaks makstav täiendav tasu puuduva teenistuja ülesannete täitmise ning ületunnitöö, valveaja, öötöö ja riigipühadel töötamise eest",
          "@language": "et"
        }
      ],
