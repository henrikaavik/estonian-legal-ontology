      "skos:definition": {
        "@value": "on määratlemata isikute ringile kasutamiseks antud või määratlemata isikute ringi kasutuses olev maa-ala, ehitis, ruum või selle osa, samuti ühissõiduk",
        "@language": "et"
      },
