      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_esinduskollektiiv"
        }
      ]
    },
    {
      "@id": "estleg:Concept_parnu_linna_eelarvest_kultuuriuhingutele_ning_avatud_kultuur_t1051323_laulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "laulu",
      "skos:definition": "ja tantsupeoprotsessis osalev kollektiiv – kollektiiv, mille koori või puhkpilliorkestri töös osaleb aktiivselt vähemalt 16 liiget, tantsurühmas vähemalt 12 liiget, rahvamuusika- ja folkloorirühmas vähemalt 6 liiget, kollektiiv ei kuulu esinduskollektiivide hulka ning vähemalt 50% kollektiivi juhendajatest omavad või omandavad erialast haridust; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051323_Par_2"
        }
      ],
      "estleg:sourceAct": "Pärnu linna eelarvest kultuuriühingutele ning avatud kultuurikeskustele tegevustoetuse arvutamise juhend",
