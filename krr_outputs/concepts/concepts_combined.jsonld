    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Kandeabiteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Kandeabiteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kliendi kandmine kodust, haiglaruumist vm mistahes korrusel asuvast hoonesisesest asukohast sõidukisse või sõidukist sõidukijuhi abiga.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltransporditeenuse osutamise juhend",
      "rdfs:label": "Kandeabiteenus (sotsiaaltransporditeenuse_osutamise_juhend_t1018233)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kandeabiteenus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Kanderaamiteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Kanderaamiteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kliendi tema kodust, haiglaruumist vm hoonesisesest mistahes korrusel asuvast asukohast kanderaamil pealevõtmine või sinna kanderaamil mahapanemine, kliendi eest hoolitsemine veo ajal (sh nt lamamisasendi muutmine, juua andmine vms.), sõiduki ettevalmistamine ja korrastamine enne kliendile teenuse osutamist.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltransporditeenuse osutamise juhend",
      "rdfs:label": "Kanderaamiteenus (sotsiaaltransporditeenuse_osutamise_juhend_t1018233)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kanderaamiteenus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Kliendi_kaasreisija",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Kliendi kaasreisija",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes reisib koos kliendiga, kuid kelle kaasasolek ei ole kliendiprofiilis reglementeeritud.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltransporditeenuse osutamise juhend",
      "rdfs:label": "Kliendi kaasreisija (sotsiaaltransporditeenuse_osutamise_juhend_t1018233)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kliendi_kaasreisija"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Kliendi_saatja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Kliendi saatja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes reisib koos kliendiga ning kel on kohustus klienti abistada kogu veoteenuse vältel ning kelle kaasasolek on kliendiprofiilis nõutav või lubatav.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltransporditeenuse osutamise juhend",
      "rdfs:label": "Kliendi saatja (sotsiaaltransporditeenuse_osutamise_juhend_t1018233)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kliendi_saatja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Kliendi_saatmise_teenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Kliendi saatmise teenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kliendi aitamine liikumisel kodust, haiglaruumist vm hoonesisesest mistahes korrusel asuvast asukohast sõidukini või vastupidi (sh. näiteks haiglas arsti vastuvõtu kabineti ukse taha saatmine, ja haigla vastutavale töötajale edasiseks saatmiseks üleandmine).",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltransporditeenuse osutamise juhend",
      "rdfs:label": "Kliendi saatmise teenus (sotsiaaltransporditeenuse_osutamise_juhend_t1018233)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kliendi_saatmise_teenus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Klient",
      "@type": [
        "owl:NamedIndividual",
