      "rdfs:label": "ADR",
      "skos:definition": [
        {
          "@value": "sõiduk on autoveoseaduse § 23 lõike 1 punkti 1 alusel kehtestatud nõuete kohaselt ohtlike veoste riigisisesel või rahvusvahelisel autoveol kasutatav sõiduk; 2",
          "@language": "et"
        },
        {
          "@value": "sõiduki ülevaatus on ohtlike veoste autoveol kasutatava sõiduki tehnoseisundile kehtestatud nõuetele vastavuse kontrollimine; RT I 2019-07-19 3 119072019003 2019-07-22 2",
          "@language": "et"
        }
      ]
    },
    {
