      "rdfs:label": "liitumine",
      "skos:altLabel": [
        {
          "@value": "Liitumine",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kinnistu veevärgi ühendamine ühisveevärgiga või kinnistu kanalisatsiooni ühendamine ühiskanalisatsiooniga veevarustuse või reo- ning sademevee ärajuhtimise teenuste edaspidiseks kasutamiseks",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärgi torustiku ühendamine ühisveevärgi torustikuga või kinnistu kanalisatsiooni ühendamine ühiskanalisatsiooni torustikuga veevarustuse või reovee ärajuhtimise teenuste kasutamiseks",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärgi ühendamine ühisveevärgiga või kinnistu kanalisatsiooni ühendamine ühiskanalisatsiooniga veevarustuse või reovee ärajuhtimise teenuste edaspidiseks kasutamiseks",
          "@language": "et"
        },
        {
          "@value": "tarbijapaigaldise ühendamine võrguga.",
          "@language": "et"
        },
        {
          "@value": "tarbimiskoha veevärgi ühendamine ühisveevärgiga või tarbimiskoha kanalisatsiooni ühendamine ühiskanalisatsiooniga veevarustuse või reo-ning sademevee ärajuhtimise teenuste edaspidiseks kasutamiseks.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "29",
        "@type": "xsd:integer"
      },
