    {
      "@id": "estleg:Concept_tootearendus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tootearendus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_innovatsiooni_edendavate_hangete_toetamise_tingimused_t1033984_tootearendus"
