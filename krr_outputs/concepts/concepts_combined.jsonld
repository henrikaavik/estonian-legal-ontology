      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_ametnik"
        }
      ]
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "töötaja",
      "skos:definition": "isik, kes on võetud linnavalitsuse töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi Linnavalitsuse palgajuhend",
      "rdfs:label": "töötaja (viljandi_linnavalitsuse_palgajuhend_t1057306)",
