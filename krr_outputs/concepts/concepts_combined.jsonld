      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tapa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1060264_eelarve_vastutav_taitja",
      "@type": [
        "owl:NamedIndividual",
