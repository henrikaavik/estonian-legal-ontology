      "rdfs:label": "abonenttasu",
      "skos:altLabel": [
        {
          "@value": "Abonenttasu",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "tasu, mida klient maksab ühisveevärgi ja -kanalisatsiooni nõuetekohase toimimise tagamise eest sõltumata ühisveevärgi ja -kanalisatsiooni kasutamisest; 2",
          "@language": "et"
        },
        {
          "@value": "tasu, mida klient maksab ühisveevärgi ja -kanalisatsiooni nõuetekohase toimimise tagamise eest sõltumata kasutamisest; 2",
          "@language": "et"
        },
        {
          "@value": "tasu, mida makstakse ühisveevärgi ja -kanalisatsiooni püsikulude eest teenuse stabiilseks toimimiseks sõltumata ühisveevärgi ja -kanalisatsiooni kasutamisest. 2",
          "@language": "et"
        },
        {
          "@value": "teenuse hinnakomponent ühisveevärgi ja -kanalisatsiooni nõuetekohase toimimise tagamise eest katmaks teatud kokkuleppelise osa vee-ettevõtja püsikuludest ja mida tasutakse sõltumata teenuse tarbimisest; 2",
          "@language": "et"
        },
        {
          "@value": "tasu, mida kliendid tasuvad ühisveevärgi ja -kanalisatsiooni kasutamise eest; 2",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "18",
        "@type": "xsd:integer"
      }
    },
