        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kohtpuhasti, mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti; 6) inimekvivalent (edaspidi ie) - ühik, millega mõõdetakse ühe inimese põhjustatud keskmist ööpäevast tinglikku veereostuskoormust. Biokeemilise hapnikutarbe kaudu väljendatud ie väärtus on 60 grammi hapnikku ööpäevas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048284_Par_2"
        }
      ],
