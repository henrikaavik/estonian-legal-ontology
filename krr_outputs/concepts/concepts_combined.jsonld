    {
      "@id": "estleg:Concept_heakorraeeskiri_ja_koormise_kehtestamine_t1052685_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidilise või füüsilise isiku omandis, valduses või kasutuses olev kinnisasi (kaasa arvatud maaüksus, mis ei ole veel kinnisturaamatusse kantud)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052685_Par_2"
        }
      ],
