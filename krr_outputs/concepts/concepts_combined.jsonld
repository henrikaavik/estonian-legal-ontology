      },
      "skos:definition": {
        "@value": "maksuhaldurile esitatav reklaamimaksu arvestamise dokument",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Tallinnas",
