    {
      "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809_Liitumine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Liitumine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tarbimiskoha veevärgi ühendamine ühisveevärgiga või tarbimiskoha kanalisatsiooni ühendamine ühiskanalisatsiooniga veevarustuse või reo-ning sademevee ärajuhtimise teenuste edaspidiseks kasutamiseks.",
