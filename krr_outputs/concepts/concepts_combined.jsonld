        {
          "@value": "investeering materiaalsesse või immateriaalsesse põhivarasse rahandusministri 22. detsembri 2017. a määruse nr 105 „Raamatupidamise Toimkonna juhendite kehtestamine“ lisa 5 mõistes; 10",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_pohja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Põhja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tallinna_uhistranspordis_soidu_eest_tasumise_kord_ja_soidupi_t1026696_Pohja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Põhja",
      "skos:definition": [
        {
          "@value": "Eesti ühispilet on elektrooniline sõidupilet, mis annab õiguse kasutada Tallinna linna ühistranspordi liine, MTÜ Põhja-Eesti Ühistranspordikeskuse poolt korraldatavaid avalikke maakonnaliine ning sõita ASi Eesti Liinirongid reisirongidega riikliku Transpordiameti peadirektori käskkirjaga määratud tsoonides. Põhja-Eesti ühispilet võimaldab sõita määratud tsoonides ja liinidel määratud aja jooksul piiramatu arv sõidukordi; 2023-06-15 RT IV 2023-06-28 37 428062023037 2023-07-01 15",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_pohjavee_kaitstus",
      "@type": [
        "owl:NamedIndividual",
