    {
      "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_t1058810_Reoveepuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reoveepuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kogum kindlate dimensioonidega rajatisi ja seadmeid, milles ühiskanalisatsioonivõrgu kaudu või eeskirjas reguleeritud muul viisil kogutud reovesi puhastatakse tasemeni, et seda võib keskkonda ohustamata loodusesse juhtida.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058810_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
