    {
      "@id": "estleg:Concept_rapina_valla_raamatupidamise_sise_eeskiri_t1055826_Analuutiline_ja_sunteetiline_arvestus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Analüütiline ja sünteetiline arvestus",
      "skos:definition": "majandusinformatsiooni liigendamise erinevad detailsuse tasemed. Sünteetiline arvestus on majandusinformatsiooni kirjendamine raamatupidamiskontodele. Analüütiline arvestus on raamatupidamiskontodele kirjendatud majandusinformatsiooni detailiseerimine. Analüütilist arvestust peetakse kas majandustarkvara moodulites või teiste tarkvaradega või käsitsi. 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055826_Par_2"
        }
      ],
      "estleg:sourceAct": "Räpina valla raamatupidamise sise-eeskiri",
