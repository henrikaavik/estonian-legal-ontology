        "@id": "estleg:Concept_hanke_tehniline_kirjeldus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_valla_hankekord_t1058651_hankeleping",
