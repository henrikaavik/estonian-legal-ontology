          "@id": "estleg:Concept_anija_valla_heakorra_eeskiri_t1060686_ehitaja"
        },
        {
          "@id": "estleg:Concept_rae_valla_heakorraeeskiri_t1050570_ehitaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ehitaja",
      "skos:definition": [
        {
          "@value": "isik, kes teostab ehitustöid, sh kaeve- või remonditöid; 6",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_ehitamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ehitamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kogukondlikuks_arendustegevuseks_toetuse_andmise_kord_t1044929_ehitamine"
        },
        {
          "@id": "estleg:Concept_rapla_valla_heakorraeeskiri_t1045563_ehitamine"
        },
        {
          "@id": "estleg:Concept_lasterikaste_perede_kodutoetuse_kasutamise_tingimused_ja_kor_t1048177_ehitamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ehitamine",
      "skos:definition": [
        {
          "@value": "ehitise püstitamine, rajamine, paigaldamine, lammutamine ja muu ehitisega seonduv tegevus, mille tulemusel ehitis tekib või muutuvad selle füüsikalised omadused; 4",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku tähenduses; 6",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 4 lõigete 1 ja 2 kohane eluruumi püstitamine ja laiendamine, lõike 3 punktide 1–3 kohane ümberehitamine ning ehitise üksikute osade vahetamine samaväärsete vastu; 3",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_ehitamise_kuupaev",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ehitamise kuupäev",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_laevade_ohutusnouded_t156777_ehitamise_kuupaev"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ehitamise kuupäev",
      "skos:definition": [
        {
          "@value": "kui ei ole märgitud teisiti, on kuupäev, millal on pandud laeva kiil või algab antud laevale eriomaste konstruktsioonide kokkupanek või laev on sellises ehitusjärgus, millal laeva mass on vähemalt 50 tonni või 1% laeva ehitusjärgsest massist (vastavalt milline arv on väiksem); RT I 2024-04-09 2 109042024002 2024-04-12 6",
          "@language": "et"
        }
      ]
    },
