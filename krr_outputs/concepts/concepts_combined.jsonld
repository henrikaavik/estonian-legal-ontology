        }
      ],
      "skos:definition": [
        {
          "@value": "veevarustuse ja reovee ärajuhtimise teenuste osutamise periood, mille kohta kliendile esitatakse arve; 3",
          "@language": "et"
        },
        {
          "@value": "veevarustuse või reovee ärajuhtimise teenuse osutamise periood, mille kohta kliendile esitatakse arve; 3",
          "@language": "et"
        },
        {
          "@value": "veevarustuse või reo- ning sademevee ärajuhtimise teenuse osutamise periood, mille kohta kliendile esitatakse arve; 3",
          "@language": "et"
        },
        {
          "@value": "veevarustuse või reo- ning sademevee ärajuhtimise teenuse osutamise periood, mille kohta kliendile esitatakse arve; 4",
          "@language": "et"
        },
        {
          "@value": "veevarustuse või reo- ning sademevee ärajuhtimise teenuse osutamise periood, mille kohta tarbijale esitatakse arve; 5",
          "@language": "et"
        }
      ],
