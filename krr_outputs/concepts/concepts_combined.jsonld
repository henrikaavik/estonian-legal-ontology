      },
      "skos:definition": {
        "@value": "vallavanema või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
        "@language": "et"
