      },
      "skos:definition": {
        "@value": "linna omanduses on otse või valitseva mõju all oleva juriidilise isiku kaudu rohkem kui 50% juriidilise isiku hääleõigusest, välja arvatud erandjuhud, kui on võimalik selgelt tõendada, et sellise hääleõigusega ei kaasne kontrolli. Kontroll eksisteerib ka siis, kui linnale kuulub 50% ja vähem hääleõigusest, kuid linn kas: a) omab tegelikku kontrolli rohkem kui 50% hääleõiguse üle kokkuleppe alusel teiste investoritega; b) kontrollib juriidilise isiku finants- ja tegevuspoliitikat teatud lepingu või kokkuleppe alusel; c) suudab määrata või tagasi kutsuda enamikku tegev- ja kõrgema juhtkonna liikmetest; d) suudab määrata tegevjuhtkonna ja kõrgema juhtorgani koosolekute otsuseid.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013515_Par_3"
        }
      ],
      "estleg:sourceAct": "Tallinna linna raamatupidamise sise-eeskiri",
      "rdfs:label": "linna valitsev mõju (tallinna_linna_raamatupidamise_sise_eeskiri_t1013515)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_linna_valitsev_moju"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
