      },
      "rdfs:label": "reklaampind",
      "skos:definition": [
        {
          "@value": "igasugune tasapinnaline või ruumiline objekt, mis paigaldatakse üldsusele suunatud reklaami eksponeerimise eesmärgil",
          "@language": "et"
        },
        {
          "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Narva linna haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil",
          "@language": "et"
        },
        {
          "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Raasiku valla haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
          "@language": "et"
        },
        {
          "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Saarde valla haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampinna suurus määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
          "@language": "et"
        },
        {
          "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Tallinna linna haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
