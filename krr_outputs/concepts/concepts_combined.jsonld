        "@language": "et"
      },
      "skos:definition": {
        "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud käesoleva määrusega kehtestatud korras",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028010_Par_2"
        }
      ],
