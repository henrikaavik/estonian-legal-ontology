        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "andmevarundus",
      "skos:definition": [
        {
          "@value": "teatud ajahetkel varukoopia loomine varundamisele kuuluvatest andmetest, mis salvestatakse mõnele lisaandmekandjale. Andmevarunduse liigid on: a) täielik andmevarundus - varukoopia loomine kõigist varundamisele kuuluvatest andmetest; b) diferentseeritud andmevarundus – varukoopia tegemine ainult sellistest failidest, mis on võrreldes viimase täieliku andmevarundusega muutunud; c) inkrementaalne andmevarundus – vastupidiselt täielikule andmevarundusele varukoopia tegemine ainult sellistest failidest, mis on võrreldes viimase andmevarundusega muutunud.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
