      "skos:definition": [
        {
          "@value": "kalmistul asuv maa-ala ühe või mitme surnu matmiseks kirstus või tuhaurnis; 3",
          "@language": "et"
        },
        {
          "@value": "kalmistul asuv maa-ala ühe või mitme surnu matmiseks kirstus või tuhaurnis; 2",
          "@language": "et"
        },
        {
          "@value": "maa-ala kalmistul, mis eraldatakse isiku(te)le surnu(te) matmise eesmärgil ja mis koosneb ühest või mitmest matmiskohast; 2",
          "@language": "et"
        },
        {
          "@value": "kalmistul asuv maa-ala ühe või mitme surnu matmiseks kirstuga või tuhaurniga; 3",
          "@language": "et"
        },
        {
          "@value": "kalmistul asuv maa- ala, mis koosneb ühest või mitmest hauakohast surnu matmiseks kirstus või tuhaurnis: 3",
          "@language": "et"
        }
      ],
