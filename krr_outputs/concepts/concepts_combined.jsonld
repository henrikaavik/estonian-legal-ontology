      "skos:definition": {
        "@value": "volikogu otsusega määratud eraõiguslik juriidiline isik, kes varustab tarbija tarbimiskoha veevärki ühisveevärgi kaudu veega või korraldab tarbija tarbimiskoha kanalisatsioonist reovee ärajuhtimist ja puhastamist",
