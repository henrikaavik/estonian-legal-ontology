      }
    },
    {
      "@id": "estleg:Concept_kanepi_valla_heakorraeeskiri_t1043205_heakorratood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heakorratööd",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on tolmu, liiva, prahi, lume ja jää koristamine, libedusetõrje, muru ja rohu niitmine ning maha langenud puulehtede, okste vms koristamine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043205_Par_2"
        }
      ],
