      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühendustoru",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistu veevärki veega varustav või kinnistu kanalisatsioonist reo- või sademevett ärajuhtiv toru peatorust liitumispunktini, viimane kaasaarvatud; 22) ühisveevärk ja –kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reo- ning sademevee ärajuhtimine ja mis on vee-ettevõtja hallatav. Ühisveevärgi ja –kanalisatsioonina käsitletakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030580_Par_2"
        }
      ],
      "estleg:sourceAct": "Raasiku valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
      "rdfs:label": "ühendustoru (raasiku_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ee_t1030580)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhendustoru"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rongisoidul_soodustuse_saamise_kord_t1036572_soodustuse_saaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "soodustuse saaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määruse tähenduses loetakse soodustuse saajaks 7–19-aastast õpilast, kelle elukoht ja kelle mõlema vanema või üksikvanema elukoht on soodustuse saamise perioodile eelneva kalendriaasta 31. detsembri seisuga ja/või jooksva aasta 30. juuni seisuga rahvastikuregistri andmetel Raasiku vald",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1036572_Par_2"
        }
      ],
      "estleg:sourceAct": "Rongisõidul soodustuse saamise kord",
      "rdfs:label": "soodustuse saaja (rongisoidul_soodustuse_saamise_kord_t1036572)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_soodustuse_saaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rongisoidul_soodustuse_saamise_kord_t1036572_uksikvanem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "üksikvanem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vanem, kes kasvatab last üksi ja leibkonnas puudub teine vanem. Eelkõige loetakse üksikvanemaks vanemat, kellel on õigus riiklikule üksikvanema lapsetoetusele või kelle lapse teine vanem on surnud. Vallavalitsusel on õigus rakendada üksikvanema mõistet ka vanemale, kes kinnitab oma allkirjaga, et kasvatab last üksinda ja esitab vallavalitsusele selle tõendamiseks vastavad andmed ja dokumendid (abielu lahutust tõendav dokument, andmed määratud elatisraha, hooldusõigus jne kohta), mille õigsust on vallavalitsusel õigus läbi ametlike andmekogude ning avalike infokanalite kontrollida",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1036572_Par_2"
        }
      ],
      "estleg:sourceAct": "Rongisõidul soodustuse saamise kord",
      "rdfs:label": "üksikvanem (rongisoidul_soodustuse_saamise_kord_t1036572)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uksikvanem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
