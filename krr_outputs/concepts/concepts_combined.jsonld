      "rdfs:label": "põhipalk",
      "skos:altLabel": [
        {
          "@value": "Põhipalk",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "teenistuja palga fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal; 8",
          "@language": "et"
        },
        {
          "@value": "teenistuja palga või töötasu fikseeritud osa; 7",
          "@language": "et"
        },
        {
          "@value": "teenistuja palga või töötasu fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal; 7",
          "@language": "et"
        },
        {
          "@value": "teenistuja palga või töötasu fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal; 8",
          "@language": "et"
        },
        {
          "@value": "ametniku palga fikseeritud osa või töötaja igakuine kokkulepitud töötasu, mida makstakse teenistuskoha ülesannete ning teenistusalaste teadmiste, oskuste ja kogemuste põhjal; 6",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "34",
        "@type": "xsd:integer"
      }
