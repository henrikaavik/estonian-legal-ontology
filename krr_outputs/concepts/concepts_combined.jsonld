          "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809_Liitumisavaldus"
        },
        {
          "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_e_t1058914_Liitumisavaldus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Liitumisavaldus",
      "skos:definition": [
        {
          "@value": "tarbimiskoha ühisveevärgi ja -kanalisatsiooni omaniku kirjaliku avalduse alusel tehakse liitumisettepanek, millega soovitakse ühisveevärgi ja -kanalisatsiooniga liituda.",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_liitumiskilp",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "liitumiskilp",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_elektrisusteemi_toimimise_vorgueeskiri_t1046164_liitumiskilp"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "liitumiskilp",
      "skos:definition": [
        {
          "@value": "elektrikilp, milles asub liitumispunkt; 4",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_liitumisleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "liitumisleping",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_anija_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ning_t1051204_liitumisleping"
        },
        {
          "@id": "estleg:Concept_harku_valla_uhisveevargi_ja_kanalisatsiooni_liitumise_ning_k_t1035491_liitumisleping"
        },
        {
          "@id": "estleg:Concept_laane_harju_valla_uhisveevargi_ja_kanalisatsiooni_liitumise__t1059614_liitumisleping"
        },
        {
          "@id": "estleg:Concept_rakvere_valla_uhisveevargiga_ja_kanalisatsiooniga_liitumise__t1051130_liitumisleping"
        },
        {
          "@id": "estleg:Concept_tallinna_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_n_t1060473_liitumisleping"
        },
        {
          "@id": "estleg:Concept_uhisveevargi_ja_kanalisatsiooniga_liitumise_ning_uhisveevarg_t1054109_liitumisleping"
        }
      ],
      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "liitumisleping",
      "skos:definition": [
        {
          "@value": "kinnistu omaniku või valdajaga sõlmitav leping liitumiseks ühisveevärgi ja –kanalisatsiooniga; 13",
          "@language": "et"
        },
        {
          "@value": "kinnistu omaniku, hoonestusõiguse alusel maakasutaja või kinnistu valdajaga sõlmitav leping liitumiseks ühisveevärgi ja -kanalisatsiooniga; 13",
          "@language": "et"
        },
        {
          "@value": "kirjalikku taasesitamist võimaldavas vormis sõlmitud leping tarbimiskoha veevärgi ja kanalisatsiooni ühendamiseks ühisveevärgi ja -kanalisatsiooniga; 6",
          "@language": "et"
        },
        {
          "@value": "vee-ettevõtja ja liituja vahel kirjalikult sõlmitav ühisveevärgi ja -kanalisatsiooniga liitumise leping; 14",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni vee-ettevõtja ja liituja vahel kirjalikult sõlmitav ühisveevärgi ja -kanalisatsiooniga liitumise leping; 25",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_liitumisprojekt",
      "@type": [
        "owl:NamedIndividual",
