      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringi kasutuses olev maa-ala, ehitis või ruum; 5) puhastusala –kompaktse hoonestuse alal kinnistuga piirnev avalik koht, mis ulatub kinnistu piirist sõiduteeni",
        "@language": "et"
      },
      "estleg:definedIn": [
