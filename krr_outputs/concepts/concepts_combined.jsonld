      "rdfs:label": "omaksed",
      "skos:definition": [
        {
          "@value": "surnu abikaasa, vanemad, täisealine laps, õde, vend või muu surnu lähedane isik tulenevalt tema elukorraldusest.",
          "@language": "et"
        },
        {
