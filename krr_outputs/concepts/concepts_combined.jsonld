          "@id": "estleg:Concept_euroopa_uhenduse_algatuse_interreg_programmide_elluviimise_k_t158972_abikolblik_kulu"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_rohevesiniku_kasutuselevo_t1052247_abikolblik_kulu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "abikõlblik kulu",
      "skos:definition": [
        {
          "@value": "kulu, mis on põhjendatud, mõistlik ja vajalik ning tehtud kooskõlas käesoleva määrusega ning Majandusliku Koostöö ja Arengu Organisatsiooni (edaspidi OECD ) arenguabikomitee (DAC) reeglite kohaselt; 2",
          "@language": "et"
        },
        {
          "@value": "kulu, mis vastab vastava Interreg programmi programmdokumendis, programmitäiendis, Euroopa Komisjoni määruses (EÜ) nr 448/2004, millega muudetakse Komisjoni määrust (EÜ) nr 1685/2000 (ELT L 193, 29.07.2000, lk 39–",
          "@language": "et"
        },
        {
          "@value": "kulutus, mis on põhjendatud, mõistlik ja vajalik projekti elluviimiseks ning mis on tehtud kooskõlas õigusaktides ja toetuse rahuldamisega seotud dokumentides sätestatud nõuetega; 16",
          "@language": "et"
        },
        {
          "@value": "projekti elluviimiseks vajalik ja mõistlik kulu, mis on tekkinud abikõlblikkuse perioodil ning mille aluseks olevad tegevused on kooskõlas Eesti ja Euroopa Liidu õigusega; 2",
          "@language": "et"
        },
        {
          "@value": "projekti elluviimiseks vajalik ja mõistlik kulu, mis on tekkinud abikõlblikkuse perioodil; 9",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      }
    },
    {
