      "skos:definition": [
        {
          "@value": "tootmisele ja logistikale suunatud ettevõtluse jaoks vajalik tootmispind koos teenindavate maa-aladega, mis on kontsentreeritud piiratud territooriumile ning mille administreerimiseks on loodud ühtne juhtimine; RTL 2009 65 970 13211092 2009-08-10",
          "@language": "et"
        }
      ],
