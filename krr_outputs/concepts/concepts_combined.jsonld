          "@id": "estleg:Concept_tehingupartnerid"
        }
      ]
    },
    {
      "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1060663_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "tee",
      "skos:definition": "rajatis, mis on ette nähtud inimeste, sõidukite, või loomade liikumiseks või liiklemiseks. Tee osadeks loetakse ka liiklemiseks kasutatavad ning tee toimimiseks vajalikud rajatised; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060663_Par_2"
