      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kadrina_valla_jaatmehoolduseeskiri_t1053453_olmejaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "olmejäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kodumajapidamises tekkinud jäätmed ning kaubanduses, teeninduses või mujal tekkinud oma koostiselt ja omadustelt samalaadsed jäätmed",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053453_Par_2"
        }
      ],
      "estleg:sourceAct": "Kadrina valla jäätmehoolduseeskiri",
