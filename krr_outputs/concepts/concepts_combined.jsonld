    {
      "@id": "estleg:Concept_pakendiettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pakendiettevõtja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pakendiettevotja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "pakendiettevõtja",
      "skos:definition": [
        {
          "@value": "isik, kes majandus-või kutsetegevuse raames pakendab kaupa, veab sisse või müüb pakendatud kaupa. Samuti akrediteeritud taaskasutusorganisatsioon, kellele pakendiseaduses ettenähtud juhtudel on eelpool nimetatud isikud oma kohustused pakendi ja pakendijäätmete käitlemisel lepinguga üle andnud",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_pakendijaatmed",
