      }
    },
    {
      "@id": "estleg:Concept_korteriuhistule_kriisivalmidustoetuste_andmise_kord_t1061194_varjumiskoha_kohandamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "varjumiskoha kohandamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olemasoleva hoone osa või ruumi ettevalmistamine selliselt, et see pakuks inimestele võimalikult head kaitset ohuolukorras, arvestades hoone ehituslikke ja tehnilisi võimalusi. Üldkasutatava ruumi varjumiskohaks kohandamisel lähtutakse koostatud eskiisist, skeemist, projektist vms",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061194_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule kriisivalmidustoetuste andmise kord",
      "rdfs:label": "varjumiskoha kohandamine (korteriuhistule_kriisivalmidustoetuste_andmise_kord_t1061194)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_varjumiskoha_kohandamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korteriuhistule_kriisivalmidustoetuste_andmise_kord_t1061194_varjumisplaan",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "varjumisplaan",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juhend, milles on hinnatud konkreetses hoones varjumise võimalusi ning kirjeldatud ettevalmistusi, tegevusi ja meetmeid, millega tagatakse inimeste kiire ja turvaline varjumine ohuolukorras",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061194_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule kriisivalmidustoetuste andmise kord",
