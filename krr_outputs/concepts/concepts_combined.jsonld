    {
      "@id": "estleg:Concept_viimsi_valla_projektides_osalemise_kord_t1058228_projekti_vedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "projekti vedaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla struktuuriüksus või valla hallatav asutus, kes koostab ja esitab projekti taotluse ning projekti rahastamise korral vastutab projektiga võetud ülesannete ellu viimise ja projekti eesmärkide saavutamise eest. Projekti vedajat esindab valla struktuuriüksuse/hallatava asutuse juht või abivallavanem, kellel on projekti dokumentide allkirjastamise õigus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058228_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi valla projektides osalemise kord",
