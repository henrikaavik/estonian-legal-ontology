      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rouge_valla_heakorraeeskiri_t1050548_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi, hoonestusõigus, korteriomand ja korterihoonestusõigus. Kinnistuga on eeskirjas võrdsustatud ka kinnistamata maaüksus, mille suhtes isikul on kasutusõigus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050548_Par_3"
        }
      ],
