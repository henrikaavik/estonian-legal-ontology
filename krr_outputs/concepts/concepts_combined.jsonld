      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_andmise_kord_t1052751_taotleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taotleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "inimene, kes esitab abivajaduse väljaselgitamise taotluse oma rahvastikuregistrisse kantud elukoha järgsele linnaosa valitsusele või õigusaktis sätestatud juhtudel sotsiaal- ja tervishoiuametile või muule volitatud üksusele. Taotluse võib esitada nii abi vajav inimene ise kui ka tema seaduslik esindaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052751_Par_3"
        }
      ],
      "estleg:sourceAct": "Sotsiaalhoolekandelise abi andmise kord",
      "rdfs:label": "taotleja (sotsiaalhoolekandelise_abi_andmise_kord_t1052751)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_taotleja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_andmise_kord_t1052751_valtimatu_sotsiaalabi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vältimatu sotsiaalabi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "inimesele (sh ajutiselt Eestis viibivale välismaalasele) hädavajaliku toidu, riietuse, ajutise majutuse, sotsiaalnõustamise, transpordi ja muu põhjendatud abi tagamine, kui inimene on elatusvahendite kaotuse või puudumise või eluaseme ootamatult kasutuskõlbmatuks muutumise tõttu sotsiaalselt abitus olukorras; 2022-12-15",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052751_Par_3"
        }
      ],
      "estleg:sourceAct": "Sotsiaalhoolekandelise abi andmise kord",
