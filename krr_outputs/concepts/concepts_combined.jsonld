      "rdfs:label": "liitumispunkt",
      "skos:altLabel": [
        {
          "@value": "Liitumispunkt",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ÜVK ühenduskoht kinnistu veevärgi ja kanalisatsiooniga; 16",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni olulise osana ühisveevärgi ja -kanalisatsiooni ning kinnistu veevärgi ja-kanalisatsiooniühenduskoht; 11",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni olulise osana ühisveevärgi ja -kanalisatsiooni ning kinnistu veevärgi ja-kanalisatsiooni ühenduskoht; 16",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni ühenduskoht tarbimiskoha veevärgi ja kanalisatsiooniga, mis määrab ühisveevärgi ja -kanalisatsiooni ning tarbimiskoha veevärgi ja kanalisatsiooni vahelise piiri. Liitumispunkt on ühisveevärgi ja -kanalisatsiooni osa. 11",
          "@language": "et"
        },
        {
          "@value": "võrgu ja tarbijapaigaldise ühenduskoht; 8",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "47",
        "@type": "xsd:integer"
      }
