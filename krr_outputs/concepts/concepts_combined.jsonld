          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "mistahes kõrvalekalle infosüsteemi normaalse talitluse reeglitest.",
          "@language": "et"
        },
        {
          "@value": "teenuse katkemine või mõne seadme rike, süsteemi tõrge või ülekoormus, inimlikud vead, mittevastavus infoturbepoliitika või juhenditega, füüsiliste turvameetmete rikkumine, mitte kontrollitud muudatused süsteemides, tarkvara või riistvara tõrge, ligipääsu rikkumised; 13",
          "@language": "et"
        },
        {
          "@value": "sündmus või sündmused, millega kaasneb andmete või muude infovarade käideldavuse, tervikluse või konfidentsiaalsuse kadu või tekib oluline oht andmete käideldavuse, tervikluse või konfidentsiaalsuse kao tekkeks; 18",
          "@language": "et"
        }
      ]
    },
