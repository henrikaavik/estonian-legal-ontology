      }
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_tulemusnaitaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tulemusnäitaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "näitaja, mille abil mõõdetakse toetatud sekkumiste mõju ning mis kajastab eelkõige vahetule sihtrühmale, sihtpopulatsioonile või rohetehnoloogia kasutajatele avalduvat mõju. Tulemusnäitaja peab peegeldama toetatava tegevuse otsest tulemust ja mõju selle otsestele adressaatidele, sihtrühmale või kasutajatele kindla ajaperioodi jooksul alates projekti väljundi saavutamisest või projekti lõpust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
      "rdfs:label": "tulemusnäitaja (rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tulemusnaitaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_toetatav_kulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toetatav kulu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "projekti toetusest rahastatava tegevuse elluviimiseks vajalik ja mõistlik kulu, sh toetus ja omafinantseering, mis on tekkinud abikõlblikkuse perioodil ning mille aluseks olevad tegevused on kooskõlas Eesti ja Euroopa Liidu õigusega, käesoleva määruse ning üldmääruse nõuetega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
      "rdfs:label": "toetatav kulu (rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_toetatav_kulu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_omafinantseering",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omafinantseering",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "toetuse saaja või partneri poolt kaetav abikõlblik osa toetatava tegevuse kuludest vastavalt käesolevas määruses seatud tingimustele ja abimäärale. Käibemaks võib olla osa toetatavate tegevuste kuludest juhul, kui see ei ületa tegevuse omafinantseeringu osakaalu ning mille puhul on tõendatav, et vastavalt käibemaksu reguleerivatele õigusaktidele ei ole tasutud käibemaksu sisendkäibemaksuna õigust maha arvata või käibemaksu tagasi taotleda ja käibemaksu ei hüvitata ka muul moel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
      "rdfs:label": "omafinantseering (rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omafinantseering"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_ostumenetlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ostumenetlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "riigihangete seaduse tähenduses hankijaks mitteoleva isiku korraldatav riigihangete seaduse § 3 nõuetele vastav asjade, teenuste või ehitustööde hankimine; 10) „ei kahjusta oluliselt” põhimõte – põhimõte, mille kohaselt ei tekitata Euroopa Parlamendi ja nõukogu määruse (EL) 2020/852, millega kehtestatakse kestlike investeeringute hõlbustamise raamistik ja muudetakse määrust (EL) 2019/2088 (ELT L 198, 22.06.2020, lk 13–43), artiklis 17 nimetatud olulist kahju ühelegi artiklis 9 sätestatud keskkonnaeesmärgile",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
      "rdfs:label": "ostumenetlus (rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ostumenetlus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_iduettevote",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "iduettevõte",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "käesoleva määruse tähenduses Eestis registreeritud VKE va FIE, kelle arendatav uus, innovaatiline, rohetehnoloogiline kliima ja keskkonnaga seotud lahendus aitab kaasa kliimamuutuste leevenemisele või nende mõjudega kohanemisele ja panustab oluliselt keskkonnaeesmärkide saavutamisele ning lahendus on turul potentsiaalselt skaleeritav",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
      "rdfs:label": "iduettevõte (rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_iduettevote"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_partner",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "partner",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidiline isik, riigiasutus, kohaliku omavalitsuse asutus või rahvusvaheline organisatsioon, kes osaleb toetatavas tegevuses ja kellel tekivad selle käigus abikõlblikud kulud. Partner ei ole toetuse saajale töövõtja ega teenuse osutaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
      "rdfs:label": "partner (rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_partner"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_rohetehnoloogia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rohetehnoloogia",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kestlik tehnoloogia, mis väldib või vähendab kogu elutsükli ulatuses inimtegevuse mõju keskkonnale ja kliimale. Rohetehnoloogia kasutab maksimaalselt ära taastuvaid energiaallikaid ja materjale, tagades minimaalse ressursside, sh energia kasutuse. Rohetehnoloogia määratluses ei piirduta vaid kasutusfaasiga, vaid arvestatakse toote või teenuse kogu elutsükli ulatust (toorme kavandamine ja tootmine, toote tootmine, levitamine ja pakendamine, korduskasutus, lõplik kasutusest kõrvaldamine, ümbertöötlus)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
      "rdfs:label": "rohetehnoloogia (rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_rohetehnoloogia"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_innovatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "innovatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "uute ideede ja teadmiste kasutamine uudsete lahenduste rakendamiseks, mis hõlmab toodete ja teenuste väljatöötamist ning uuendamist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058554_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohetehnoloogiate arendamise toetuse andmise tingimused ja kord",
      "rdfs:label": "innovatsioon (rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_innovatsioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_tootearendus",
      "@type": [
        "owl:NamedIndividual",
