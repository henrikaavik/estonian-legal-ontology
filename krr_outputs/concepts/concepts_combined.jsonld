        "@id": "estleg:Concept_eriolukord"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_valla_heakorraeeskiri_t1044267_romusoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "romusõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tehniliselt mittekorras olev sõiduk, millel puuduvad selle mehaanilised osad või kereosad või autoklaasid või rattad või mille autokere on roostetanud ja mis oma välimusega riivab haldusüksuse esteetilist väljanägemist või rikub selle puhtust ja heakorda",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044267_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala valla heakorraeeskiri",
