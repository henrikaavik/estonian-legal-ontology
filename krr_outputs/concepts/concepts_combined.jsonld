    {
      "@id": "estleg:Concept_raasiku_vallavalitsuse_raamatupidamise_sise_eeskiri_t1062145_eelarve_vastutav_taitja_voi_volitatud_taitja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eelarve vastutav täitja või volitatud täitja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kellel on õigus käsutada vallaeelarve vahendeid kinnitatud eelarve piires ja struktuuris ning millist õigust käesoleva eeskirja tähenduses teostab vastav isik kulude aktsepteerimisega. Eelarve vastutavaks täitjaks on üldjuhul üksuse või osakonna juht. 13) aruandev isik on osakonna või hallatava asutuse juht või tema poolt kirjalikult määratud isik, kellele on antud volitus majandustehingute tegemiseks; 14) sissetulekud ja väljaminekud (laekumised ja tasumised) – omavalitsuse tulud, kulud, investeeringud ning finantseerimistehingud rahalises väljenduses",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062145_Par_2"
        }
      ],
      "estleg:sourceAct": "Raasiku Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "eelarve vastutav täitja või volitatud täitja (raasiku_vallavalitsuse_raamatupidamise_sise_eeskiri_t1062145)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eelarve_vastutav_taitja_voi_volitatud_taitja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
