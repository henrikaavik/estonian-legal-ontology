      ],
      "skos:prefLabel": {
        "@value": "lisatasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötasule lisaks makstav tasu täiendavate tööülesannete, töökoormuse või vastutuse suurenemise eest ning muud töölepingu seaduses sätestatud lisatasud ja hüvitised",
