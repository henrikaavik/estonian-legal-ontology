      "rdfs:label": "reoveekogumisala",
      "skos:definition": [
        {
          "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee keskkonda juhtimiseks; 11",
          "@language": "et"
        },
        {
          "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee keskkonda juhtimiseks; 12",
          "@language": "et"
        },
        {
          "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee keskkonda juhtimiseks; 13",
          "@language": "et"
        },
        {
          "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee keskkonda juhtimiseks; 15",
          "@language": "et"
        },
        {
          "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee keskkonda juhtimiseks; 17",
          "@language": "et"
        }
      ],
