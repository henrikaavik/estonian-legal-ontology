      "estleg:definesConcept": {
        "@id": "estleg:Concept_toetuse_saaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_taaste_ja_vastupidavuskava_elluviimise_korraldus_ja_toetuse_t1052947_partner",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "partner",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "toetuse andmise tingimuste käskkirjas või määruses nimetatud juriidiline isik, riigiasutus, kohaliku omavalitsuse asutus või rahvusvaheline organisatsioon, kes osaleb toetatavas tegevuses ja kellel tekivad selle käigus kulud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052947_Par_3"
        }
      ],
