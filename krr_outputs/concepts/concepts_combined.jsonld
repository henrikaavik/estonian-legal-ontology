      ]
    },
    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "põhipalk",
      "skos:definition": "teenistuja kuupalgamäär, mille aluseks on vastava teenistuskoha palgagrupile vastav palgamäär; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040857_Par_3"
        }
      ],
