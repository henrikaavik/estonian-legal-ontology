    {
      "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1058915_Joogivesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Joogivesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "joogivesi on algkujul või töödeldud vesi, sealhulgas allikavesi, mis on mõeldud joomiseks, keetmiseks, toiduvalmistamiseks või muuks olmeotstarbeks kõigis omandivormides, olenemata vee päritolust ning sellest, kas see toimetatakse tarbijani jaotusvõrgu kaudu, paagiga, pudelis või mahutis.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058915_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "Joogivesi (marjamaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1058915)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_joogivesi"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1058915_Sademevesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sademevesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi (edaspidi sademevesi ), mis ei ole reovesi ning mis juhitakse ühiskanalisatsiooni või sademevee kanalisatsiooni.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058915_Par_2"
        }
      ],
