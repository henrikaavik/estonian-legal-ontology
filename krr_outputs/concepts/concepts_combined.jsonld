    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101_huviharidus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huviharidus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pikaajaline süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest ja kutseõppest vabal ajal, omandades süvendatud teadmisi ja oskusi valitud huvialal. Huviharidust omandatakse huvikoolis või erakooli seaduse alusel tegutsevas koolis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1045101_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "rdfs:label": "huviharidus (huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huviharidus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101_huvitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvitegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lühiajaline süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest ja kutseõppest vabal ajal, et omandada süvendatud teadmisi ja oskusi valitud huvialal kultuuri, spordi, muusika, kunsti, loodus- ja täppisteaduste või tehnoloogia valdkondades. Huvitegevusega tegeletakse huviringides, klubides, stuudiotes jne",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1045101_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "rdfs:label": "huvitegevus (huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huvitegevus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101_huvikool",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvikool",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "haridusasutus, mis tegutseb noorsootöö valdkonnas ning loob eeldused ja võimalused noortele huvihariduse omandamiseks, sealhulgas oma keele ja kultuuri viljelemise võimalused huvihariduse erinevates valdkondades. Huvikool on registreeritud Eesti Hariduse Infosüsteemis (edaspidi EHIS ) ja omab koolitusluba",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1045101_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "rdfs:label": "huvikool (huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huvikool"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101_organisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "organisatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "huviharidust või -tegevust pakkuv asutus, sealhulgas üldhariduskool, huvikool, rahvamaja, noortekeskus, mittetulundusühing jms. Organisatsioon on registreeritud äriregistris ja tegutseb Rapla vallas või vallaga külgnevas vallas või pakub sellise spetsiifikaga huviala, mida ei ole võimalik pakkuda Rapla valla või vallaga külgneva valla territooriumil; 5) õppekoha maksumus (edaspidi kohatasu ) – majandusaastaks huvikooli pidaja kinnitatud õppekoha tegevuskulu arvestuslik maksumus, mida makstakse huvihariduse omandamiseks ühel huvialal ühe õppuri kohta.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1045101_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "rdfs:label": "organisatsioon (huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_organisatsioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
