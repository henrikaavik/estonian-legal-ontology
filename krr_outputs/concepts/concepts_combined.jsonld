    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_mootorsoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "mootorsõiduk",
      "skos:definition": "mootori jõul liikuv sõiduk, välja arvatud üksnes piiratud liikumisvõimega isikule kasutamiseks ettenähtud mootoriga sõiduk, elektrimootoriga jalgratas, tasakaaluliikur, pisimopeed, robotliikur, maastikusõiduk, tramm ja sõiduk, mille valmistajakiirus ei ületa kuut kilomeetrit tunnis; 13",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
