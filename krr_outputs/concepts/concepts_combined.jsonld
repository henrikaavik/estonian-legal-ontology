          "@id": "estleg:Concept_reklaam"
        }
      ]
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_maksuobjekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "maksuobjekt",
      "skos:definition": "reklaam, mida eksponeeritakse Tallinna linna haldusterritooriumil füüsilise või juriidilise isiku poolt; 4",
