      ],
      "skos:prefLabel": {
        "@value": "NOTAM-teade",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lennundussidevõrgus levitatav teade, mis sisaldab aeronavigatsiooniseadme, -teeninduse, -protseduuri või -ohu kehtestamist, seisukorda või muudatust puudutavat teavet, mille õigeaegne teadmine on oluline lennutegevusega seotud personalile",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_337512_Par_2"
