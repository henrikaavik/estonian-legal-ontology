      "rdfs:label": "kohtkäitlussüsteem",
      "skos:definition": [
        {
          "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (sh kuivkäimla), puhastamiseks (sh septik) või maapinda immutamiseks; 5",
          "@language": "et"
        },
        {
          "@value": "lekkekindel kogumismahuti (sh kuivkäimla lampkast) või omapuhasti; 3",
          "@language": "et"
        },
        {
          "@value": "rajatis reovee kogumiseks (kogumismahuti) või puhastamiseks (omapuhasti); 8",
          "@language": "et"
        },
        {
          "@value": "rajatis reovee kogumiseks, st reovee kogumismahuti (sh kuivkäimla) või puhastamiseks, st omapuhasti (biopuhasti või septik koos puhastatud reovee suublasse juhtimisega); 8",
          "@language": "et"
        },
        {
          "@value": "reovee nõuetekohaseks käitlemiseks rajatud tehniliste seadmete ja/või ehitiste kogum, mis võimaldab reovee nõuetekohast kogumist või puhastamist ning keskkonda juhtimist. Kohtkäitlussüsteemi alla kuuluvad erinevad tehnoloogilised lahendused, sealhulgas ka kuivkäimlad, mis võimaldavad fekaalide kogumist ja suunamist edasiseks käitluseks piirkondlikule reoveepuhastile; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "16",
        "@type": "xsd:integer"
      }
    },
