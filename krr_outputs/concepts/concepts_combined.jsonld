      },
      "rdfs:label": "võra projektsioon",
      "skos:definition": [
        {
          "@value": "plaanil näidatud vastava tingmärgiga puuvõra ulatus maapinnal, kus on puu elutegevuse tagamiseks piisav juurekava",
