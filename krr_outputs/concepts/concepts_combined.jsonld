    {
      "@id": "estleg:Concept_laane_nigula_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044893_omapuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
