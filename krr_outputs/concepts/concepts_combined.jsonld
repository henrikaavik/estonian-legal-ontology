    {
      "@id": "estleg:Concept_kuressaare_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1009864_kinnistu_kanalisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu kanalisatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "liitumispunktist kinnistupoolsed ehitised ja seadmed (sealhulgas hoovivõrk, ehitiste sisekanalisatsioon, reovee mõõtesõlm) kinnistult reovee ärajuhtimiseks ühiskanalisatsiooni",
