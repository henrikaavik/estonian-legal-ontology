    {
      "@id": "estleg:Concept_eesti_riikliku_arengukava_euroopa_liidu_struktuurifondide_ka_t158708_rakendusuuringu_voi_toote",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "rakendusuuringu või toote",
      "skos:definition": "ja protsessiarenduse eeluuring (edaspidi eeluuring ) on raamdokumendi tähenduses teadus- ja arendustegevuste kogum, mille eesmärk on ettevõtja või teadus- ja arendusasutuse poolt kavandatava rakendusuuringu või toote- ja protsessiarenduse teostatavuse ja selle tulemuste kasutamise võimalikkuse kohta adekvaatse informatsiooni saamine või rakendusuuringu või toote- ja protsessiarenduse ettevalmistamine; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_158708_Par_2"
        }
      ],
      "estleg:sourceAct": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks - ühtne programmdokument aastateks 2004-2006\" meetme nr 2.3 \"Teadus- ja arendustegevuse ning innovatsiooni edendamine\" osa \"Teadus- ja arendustegevuse projektide toetamine\" tingimused",
      "rdfs:label": "rakendusuuringu või toote (eesti_riikliku_arengukava_euroopa_liidu_struktuurifondide_ka_t158708)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_rakendusuuringu_voi_toote"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_rakendusuuringu_voi_toote"
        }
      ]
    },
    {
      "@id": "estleg:Concept_eesti_riikliku_arengukava_euroopa_liidu_struktuurifondide_ka_t158708_rakendusuuring_on_raamdokumendi_tahenduses_teadus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "rakendusuuring on raamdokumendi tähenduses teadus",
      "skos:definition": "ja arendustegevuste kogum, mille all mõistetakse eesmärgipärast uurimistegevust, mis on suunatud uute teadmiste hankimisele ja võimalikule kasutamisele uute toodete, protsesside või teenuste arendamiseks või olemasolevate toodete, protsesside või teenuste oluliseks täiustamiseks; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_158708_Par_2"
        }
      ],
      "estleg:sourceAct": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks - ühtne programmdokument aastateks 2004-2006\" meetme nr 2.3 \"Teadus- ja arendustegevuse ning innovatsiooni edendamine\" osa \"Teadus- ja arendustegevuse projektide toetamine\" tingimused",
      "rdfs:label": "rakendusuuring on raamdokumendi tähenduses teadus (eesti_riikliku_arengukava_euroopa_liidu_struktuurifondide_ka_t158708)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_rakendusuuring_on_raamdokumendi_tahenduses_teadus"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_rakendusuuring_on_raamdokumendi_tahenduses_teadus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_eesti_riikliku_arengukava_euroopa_liidu_struktuurifondide_ka_t158708_toote",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "toote",
      "skos:definition": "ja protsessiarendus (edaspidi tootearendus ) on raamdokumendi tähenduses teadus- ja arendustegevuste kogum, mille all mõistetakse rakendusuuringu tulemustele toetudes kavandi ettevalmistamist uutele, muudetud või täiustatud toodetele, protsessidele või teenustele, olenemata sellest, kas neid kavatsetakse müüa või kasutada (kaasa arvatud prototüüpide loomine, mida ei saa kommertsotstarbel kasutada). Toote- ja protsessiarendus ei sisalda tavalises töökorras või perioodiliselt läbiviidavaid muudatusi olemasolevate toodete, tootmisliinide, tootmisprotsesside, teenuste ja muude käimasolevate operatsioonide juures, isegi kui selliste muudatustega kaasnevad täiustused. 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_158708_Par_2"
        }
      ],
      "estleg:sourceAct": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks - ühtne programmdokument aastateks 2004-2006\" meetme nr 2.3 \"Teadus- ja arendustegevuse ning innovatsiooni edendamine\" osa \"Teadus- ja arendustegevuse projektide toetamine\" tingimused",
      "rdfs:label": "toote (eesti_riikliku_arengukava_euroopa_liidu_struktuurifondide_ka_t158708)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_toote"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_toote"
        }
      ]
    },
