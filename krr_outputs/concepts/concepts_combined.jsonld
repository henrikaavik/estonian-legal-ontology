      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_valla_hankekord_t1058651_riigihange",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihange",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hange, mille eeldatav maksumus on võrdne või suurem RHS § 14 lõikes 2 nimetatud piirmääraga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058651_Par_3"
        }
      ],
