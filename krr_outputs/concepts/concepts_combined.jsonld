        "@type": "xsd:integer"
      },
      "rdfs:label": "rahvusvaheline menetlus",
      "skos:definition": [
        {
          "@value": "taotleja, vastuvõtva ameti, Rahvusvahelise Büroo ja teiste PCT ametite toimingud, mis on sooritatud enne PCT taotluse esitamist Patendiametile kui märgitud ametile või märgitud ja väljavalitud ametile",
          "@language": "et"
        }
      ],
