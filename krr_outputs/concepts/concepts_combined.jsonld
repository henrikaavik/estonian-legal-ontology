    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_majandus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "majandus",
      "skos:definition": "või kutsetegevuse kohas, kus müüakse kaupa või osutatakse teenust, antavat teavet kauba, teenuse või selle müügitingimuste kohta ning käesoleva lõike punktis 2 nimetatud teavet; 2025-02-27 RT IV 2025-03-07 2 407032025002 2025-03-10 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "majandus (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_majandus"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_majandus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_majandus_valireklaami_paigaldamine_jogeva_vallas_t1057646_2_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "majandus",
      "skos:definition": "või kutsetegevuse koha tähistust selle nime, liigi, kauba müügi või teenuse osutamise aja, isiku nime, kaubamärgi ja domeeninimega ehitisel, kus majandus- või kutsetegevuse koht asub, ja selle sissepääsu juures; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "majandus (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_majandus"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_majandus"
        }
      ]
    },
