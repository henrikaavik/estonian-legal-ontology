          "@id": "estleg:Concept_rouge_valla_heakorraeeskiri_t1050548_heakorratoo"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "heakorratöö",
      "skos:definition": [
        {
          "@value": "kinnistu heakorraga seotud tööd, sealhulgas haljastuse hooldamine, niitmine, lume- ja libedusetõrje teostamine, kevadine libedusetõrjeks kasutatud puistematerjali koristamine, haljastus-, olme- ning muude jäätmete koristamine jmt tööd; 6",
          "@language": "et"
        },
        {
          "@value": "tolmu, liiva, prahi, jäätmete, lume ja jää koristamine, lume- ja libedusetõrje, muru ja rohu niitmine, lehtede riisumine, heki pügamine, teedel liikumist takistavate puude ja põõsaste okste lõikamine, k.a mahalangenud puude koristamine; 9",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_heakorratood"
        }
      ]
    },
