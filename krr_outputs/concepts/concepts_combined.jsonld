      },
      "skos:definition": {
        "@value": "ehitustöö mahupõhine maksumus. Hinnakalkulatsioon peab sisaldama ehitustöö ja kasutatavate materjalide loetelu, koguseid, ühikuhindu ja maksumust",
        "@language": "et"
      },
