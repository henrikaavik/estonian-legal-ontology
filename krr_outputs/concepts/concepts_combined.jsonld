      "rdfs:label": "kuulutus",
      "skos:definition": [
        {
          "@value": "füüsilise või juriidilise isiku poolt ühekordseid üritusi või soove kajastav teave",
          "@language": "et"
        },
        {
          "@value": "lühiajaliseks perioodiks paigaldatav infoplakat, mis paigutatakse selleks ettenähtud kuulutusestendile või -tulbale ja mis ei ole reklaam",
          "@language": "et"
        },
        {
          "@value": "lühiajaliseks perioodiks infostendile või -tulbale paigaldatav infoplakat",
          "@language": "et"
        },
        {
          "@value": "lühiajaliseks perioodiks ühekordselt paigaldatav reklaamiplakat,",
          "@language": "et"
        },
        {
          "@value": "lühiajaliseks perioodiks ühekordselt paigaldatav reklaamplakat",
          "@language": "et"
        }
      ],
