      "skos:definition": [
        {
          "@value": "Harku valla taotluste esitamise ja menetlemise keskkond.",
          "@language": "et"
        },
        {
          "@value": "Raasiku valla iseteeninduskeskkond",
          "@language": "et"
        },
        {
          "@value": "Saue Valla taotluste esitamise ja menetlemise infosüsteem.",
          "@language": "et"
        },
        {
          "@value": "taotluste vastuvõtu ja menetlemise süsteem kohalikule omavalitsusele ning iseteeninduskeskkond elanikule. Süsteemi eesmärk on lihtsustada taotlemist ja kiirendada omavalitsuse töötaja tööd ning muuta kohaliku omavalitsuse töö võimalikult läbipaistvaks.",
          "@language": "et"
        }
      ],
