      ],
      "skos:prefLabel": {
        "@value": "kaevis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "looduslikust olekust eemaldatud mis tahes kivimi või setendi tahke osis (liiv, kruus, lubjakivi, muld jne), mida kasutatakse tagasitäiteks samal kinnistul või maapinna tõstmiseks samal või muul kinnistul",
        "@language": "et"
      },
      "estleg:definedIn": [
