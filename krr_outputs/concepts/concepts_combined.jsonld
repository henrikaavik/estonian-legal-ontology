    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_immateriaalne_vara",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "immateriaalne vara",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vara, mis saadakse tehnosiirde käigus patendiõiguste, litsentside, oskusteabe või patentimata tehniliste teadmiste omandamise teel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
