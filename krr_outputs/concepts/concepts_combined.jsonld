        "@type": "xsd:integer"
      },
      "rdfs:label": "reklaamipind",
      "skos:altLabel": [
        {
          "@value": "Reklaamipind",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "igasugune tasapinnaline või ruumiline objekt, mis paigaldatakse üldsusele suunatud reklaami eksponeerimise eesmärgil",
          "@language": "et"
        },
        {
          "@value": "igasugune tasapinnaline või ruumiline objekt, sh. lipp, vimpel, mis paigaldatakse üldsusele suunatud reklaami eksponeerimise eesmärgil",
          "@language": "et"
        },
        {
          "@value": "objekt, mida kasutatakse Muhu valla haldusterritooriumil avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaamipind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
          "@language": "et"
        },
        {
          "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Kose valla haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
          "@language": "et"
        },
        {
          "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Narva-Jõesuu linna haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaamipind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
