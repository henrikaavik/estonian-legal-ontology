      },
      "rdfs:label": "partner",
      "skos:definition": [
        {
          "@value": "isik, asutus või organisatsioon, kellega koostöös toetuse saaja projekti ellu viib ja kelle osalemine projektis on vajalik soovitud tulemuste saavutamiseks; 4",
          "@language": "et"
        },
        {
          "@value": "juriidiline isik, riigiasutus, kohaliku omavalitsuse asutus või rahvusvaheline organisatsioon, kes osaleb toetatavas tegevuses ja kellel tekivad selle käigus abikõlblikud kulud. Partner ei ole toetuse saajale töövõtja ega teenuse osutaja; 13",
          "@language": "et"
        },
        {
          "@value": "partner on taotluses nimetatud projektiga otseselt seotud kohaliku omavalitsuse üksus või riigiasutus või erakooli pidaja, kes osaleb projektis toetatava tegevuse rakendamisel ja kellel tekivad selle käigus kulud; RT I 2021-06-11 2 111062021002 2021-06-14 6",
          "@language": "et"
        },
        {
          "@value": "projekti kaasatud asutus või isik, kes ei ole koostööpartner, kuid panustab projekti eesmärkide täitmisesse; 4",
          "@language": "et"
        },
        {
          "@value": "projekti kaaselluviija ÜSS 2021–2027 § 2 lõike 5 mõistes; 10",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "13",
        "@type": "xsd:integer"
      }
    },
