      ],
      "skos:prefLabel": {
        "@value": "huvitegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "süsteemne juhendatud tegelemine vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal, et omandada teadmisi ja oskusi valitud huvialal. Huvitegevusega tegeldakse huviringides, klubides, stuudiotes jne. Huvitegevuseks ei loeta lühiajalisi kursusi ja tervisesporti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051775_Par_2"
