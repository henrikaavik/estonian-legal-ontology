        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vaike_maarja_valla_jaatmehoolduseeskiri_t1050452_jaatmete_kogumine",
      "@type": [
        "owl:NamedIndividual",
