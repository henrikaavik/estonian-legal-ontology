    {
      "@id": "estleg:Concept_toila_valla_jaatmehoolduseeskiri_t1056448_tiheasustusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tiheasustusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Kohtla-Nõmme alev, Järve küla, Toila alevik ja Voka alevik. Käesoleva paragrahvi lõikes 1 nimetamata mõiste kasutamisel lähtutakse JääTS, pakendiseaduses (edaspidi PakS) ja teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056448_Par_3"
        }
      ],
      "estleg:sourceAct": "Toila valla jäätmehoolduseeskiri",
