    {
      "@id": "estleg:Concept_hiiumaa_valla_ametiasutuste_ja_nende_hallatavate_asutuste_pa_t1057591_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tehtud töö eest makstav tasu, mis koosneb põhipalgast, millele võivad lisanduda lisatasu ja eritingimustes töötamise eest makspalktav tasu; 7) põhipalk- fikseeritud palga osa, mis on määratud ametikoha ülesannete ning ametniku teenistusalaste teadmiste, oskuste, kogemuste ja vastutuse põhjal",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057591_Par_2"
        }
      ],
      "estleg:sourceAct": "Hiiumaa valla ametiasutuste ja nende hallatavate asutuste palgajuhend",
