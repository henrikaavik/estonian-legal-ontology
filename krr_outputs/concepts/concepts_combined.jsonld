      "skos:definition": [
        {
          "@value": "rahvusvahelise külastuse puhul vastuvõtva riigi asjaomasele asutusele esitatav taotlus, mis hõlmab juurdepääsu teise riigi või rahvusvahelise organisatsiooni salastatud teabele, kui see on välislepinguga ette nähtud. RT I 2023-05-31 3 131052023003 2023-06-05",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_rahvusvaheline_menetlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
