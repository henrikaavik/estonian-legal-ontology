        "@type": "xsd:integer"
      },
      "rdfs:label": "elektriauto aku",
      "skos:definition": [
        {
          "@value": "elektriauto liikuma panemiseks kasutatava elektrienergia salvestamise süsteem; 4 4<sup>1</sup>) krediidiasutus – krediidiasutus või sellega ühte kontserni kuuluv äriühing või välisriigi krediidiasutuse filiaal; RT I 2014-05-09 24 109052014024 2014-05-12 5",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_elektriauto_laadija",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elektriauto laadija",
