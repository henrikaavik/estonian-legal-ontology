      ],
      "skos:prefLabel": {
        "@value": "inimekvivalent",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühe inimese põhjustatud keskmise ööpäevase tingliku reostuskoormuse ühik. Biokeemilise hapnikutarbe (BHT7) kaudu väljendatud inimekvivalendi väärtus on 60 grammi hapnikku ööpäevas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049110_Par_2"
        }
      ],
