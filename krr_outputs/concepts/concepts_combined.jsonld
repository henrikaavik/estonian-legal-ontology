      "estleg:definesConcept": {
        "@id": "estleg:Concept_puu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljastuse_inventeerimise_kord_t1049755_puu_korgus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puu kõrgus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "mõõdetakse maapinnast kuni ladvatipuni; 11) puu rinnasläbimõõt ja -ümbermõõt - mõõdetakse 1,3 meetri kõrguselt juurekaelast või maapinnast",
        "@language": "et"
      },
      "estleg:definedIn": [
