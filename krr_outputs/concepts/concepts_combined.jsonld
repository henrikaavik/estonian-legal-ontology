      },
      "rdfs:label": "reoveekogumisala",
      "skos:definition": [
        {
          "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee keskkonda juhtimiseks",
          "@language": "et"
        },
        {
          "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee suublasse juhtimiseks",
          "@language": "et"
        },
        {
          "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee ühiskanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee keskkonda juhtimiseks",
          "@language": "et"
        },
        {
          "@value": "keskkonnaministri käskkirjaga kinnitatud ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee suublasse juhtimiseks",
          "@language": "et"
        },
        {
          "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee suublasse juhtimiseks. Alale on ühisveevärgi ja- kanalisatsiooni (ÜVK) arengukavas või valla üldplaneeringus määratud rajada ühiskanalisatsioonitrassid",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "13",
        "@type": "xsd:integer"
      },
