        },
        {
          "@id": "estleg:Concept_paide_linna_kaevetoode_eeskiri_t1044349_avariikaevetoo"
        },
        {
          "@id": "estleg:Concept_turi_valla_kaevetoode_eeskiri_t1048022_avariikaevetoo"
        },
        {
          "@id": "estleg:Concept_kaevetoode_eeskiri_t1019648_avariikaevetoo"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "avariikaevetöö",
      "skos:definition": [
        {
          "@value": "kaevetöö, mille tegemise vajadus tekib ootamatult ja mis on ebasoovitavaid tagajärgi silmas pidades edasilükkamatu; 4",
          "@language": "et"
        },
        {
          "@value": "kaevetöö, mille tegemise vajadus tekib ootamatult ja mis on edasilükkamatu; 5 (",
          "@language": "et"
        },
        {
          "@value": "kaevetöö, mille tegemise vajadus tekib ootamatult ja mis on ulatuslike ebasoovitavate tagajärgede tõttu edasilükkamatu; 8",
          "@language": "et"
        },
        {
          "@value": "kaevetöö, mille tegemise vajadus tekib ootamatult ja on vajalik tehnovõrgu avarii likvideerimiseks juhul, kui kaevetöö alustamisega viivitamine põhjustab olulise materiaalse kahju, takistab vastava elutähtsa teenuse osutamist tarbijatele või ohustab inimesi, ehitisi, keskkonda. Avariikaevetööna on põhjendatud maagaasi-, ühisvee ja -kanalisatsiooni- ja soojatrasside lekete likvideerimine, elektri ja sideliinide avariide likvideerimine; 3",
          "@language": "et"
        },
        {
          "@value": "on kaevetöö, mille tegemise vajadus tekib ootamatult ja mis on ulatuslike ebasoovitavate tagajärgede tõttu edasilükkamatu ning millest võib tuleneda suur kahju kinnisasja või tehnorajatise omanikule või valdajale; 6",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_avariikaevetood"
        }
      ]
    },
    {
      "@id": "estleg:Concept_avariikaevetood",
