      "rdfs:label": "volitatud isik",
      "skos:altLabel": [
        {
          "@value": "Volitatud isik",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "isik, kes vallavolikogu otsusega on volitatud kontrollima kinnistu veevärgi ja kanalisatsiooni vastavust nõuetele",
          "@language": "et"
        },
        {
          "@value": "isik, kes KOVi volikogu otsusega on volitatud kontrollima kinnistu veevärgi ja kanalisatsiooni vastavust nõuetele",
          "@language": "et"
        },
        {
          "@value": "isik, kes vallavolikogu otsusega on volitatud kontrollima tarbimiskoha veevärgi ja kanalisatsiooni vastavust nõuetele.",
          "@language": "et"
        },
        {
          "@value": "isik, kes valla(linna ) volikogu otsusega on volitatud kontrollima kinnistu veevärgi ja kanalisatsiooni vastavust nõuetele",
          "@language": "et"
        },
        {
          "@value": "isik, kes valla(linna)volikogu otsusega on volitatud kontrollima kinnistu veevärgi ja kanalisatsiooni vastavust nõuetele",
          "@language": "et"
        }
      ],
