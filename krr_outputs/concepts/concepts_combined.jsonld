      "rdfs:label": "kopsupeetuse tüüp",
      "skos:definition": [
        {
          "@value": "klassifikaator, mis iseloomustab sissehingatud radionukliidi kopsust kehavedelikesse ärastuse kiirust, mille juures eristatakse kolme kopsupeetuse tüüpi, mis tähistavad radionukliidi kiiret (F), mõõdukat (M) ja aeglast (S) ärastust kopsust.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
