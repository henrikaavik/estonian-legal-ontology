      "rdfs:label": "ametnik",
      "skos:altLabel": [
        {
          "@value": "Ametnik",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "isik, kes on asutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks",
          "@language": "et"
        },
        {
          "@value": "ametiasutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev isik, kes teostab avalikku võimu",
          "@language": "et"
        },
        {
          "@value": "ametiasutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev isik, kes teostab avalikku võimu. Ametnik nimetatakse ametikohale ja vabastatakse teenistusest avaliku teenistuse seaduse alusel. Ametniku teenistuskohta nimetatakse ametikohaks",
          "@language": "et"
        },
        {
          "@value": "isik, kes on asutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel, ametniku teenistuskohta nimetatakse ametikohaks",
          "@language": "et"
        },
        {
          "@value": "isik, kes on vallavalitsusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks",
          "@language": "et"
        }
      ],
