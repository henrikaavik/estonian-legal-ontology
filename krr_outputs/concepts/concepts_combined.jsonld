        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee kohtkäitlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee tekkimise asukohas reovee kogumine, puhastamine, heitvee suublasse juhtimine või taaskasutamine, sealhulgas kompostimine, üldjuhul reovee tekkekoha katastriüksuse piires. Ühise kogumismahuti või ühise omapuhasti olemasolul ka teisel katastriüksusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048183_Par_2"
        }
      ],
