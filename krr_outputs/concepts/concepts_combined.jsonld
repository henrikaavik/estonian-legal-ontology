      "estleg:definesConcept": {
        "@id": "estleg:Concept_suubla"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_taastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taastamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmehoidlast mõjutatud maapinna töötlemine, et taastada selle rahuldav seisukord, pöörates erilist tähelepanu mulla kvaliteedile, loodusliku loomastiku ja taimestiku, looduslike elupaikade, pinnaveekogude ja põhjaveekogumite hea seisundi saavutamisele ja hoidmisele lähtudes „Veeseaduse” §-st 3 5 ja maastikule ning selle asjakohasele kasutamisele tulevikus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000061_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaevandamisjäätmete käitlemise kord",
      "rdfs:label": "taastamine (kaevandamisjaatmete_kaitlemise_kord_t1000061)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_taastamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
