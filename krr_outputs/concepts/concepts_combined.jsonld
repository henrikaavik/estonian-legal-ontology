          "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_jaatmevedaja"
        },
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmevedaja"
        },
        {
          "@id": "estleg:Concept_narva_linna_jaatmehoolduseeskiri_t1056868_jaatmevedaja"
        },
        {
          "@id": "estleg:Concept_toila_valla_jaatmehoolduseeskiri_t1056448_jaatmevedaja"
        },
        {
          "@id": "estleg:Concept_vaike_maarja_valla_jaatmehoolduseeskiri_t1050452_jaatmevedaja"
        },
        {
          "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_jaatmevedaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "jäätmevedaja",
      "skos:definition": [
        {
          "@value": "teenuste kontsessiooni või teenuste riigihanke korras valitud isik, kes osutab jäätmevaldajatele korraldatud jäätmeveo teenust kindlaksmääratud jäätmeliikide osas ja jäätmeveopiirkonnas",
          "@language": "et"
        },
        {
          "@value": "isik, kes osutab korraldatud jäätmeveo raames jäätmevaldajale oma nimel või valla eest vallaga või valla poolt volitatud isikuga sõlmitud lepingu alusel jäätmeveo teenust",
          "@language": "et"
        },
        {
          "@value": "jäätmekäitleja, kellele ametiasutus on riigihanke tulemusena sõlminud hankelepingu korraldatud jäätmeveoga hõlmatud jäätmete vedamiseks Kadrina valla haldusterritooriumil või jäätmete vedamiseks vastavat luba omav jäätmekäitleja.",
          "@language": "et"
        },
        {
          "@value": "jäätmekäitleja, kellele vallavalitsus on riigihanke tulemusena andnud teenuste kontsessiooni korraldatud jäätmeveoga hõlmatud jäätmete vedamiseks Väike-Maarja valla haldusterritooriumil või jäätmete vedamiseks vastavat luba omav jäätmekäitleja. Käesoleva paragrahvi lõikes 1 nimetamata mõistete kasutamisel lähtutakse keskkonnaseadustiku üldosa seaduses, jäätmeseaduses, pakendiseaduses, riigihangete seaduses ja teistes jäätmehooldust reguleerivates õigusaktides määratletud mõistetest, vastava mõiste puudumisel aga sõna üldlevinud tähendusest.",
          "@language": "et"
        },
        {
          "@value": "jäätmete üleandmisel nende vedu teostav isik. Eeskirja 4.peatüki mõistes on jäätmevedaja riigihanke käigus välja valitud jäätmeveoettevõte, kellel on ainuõigus teostada korraldatud jäätmeveoga hõlmatud jäätmete vedu konkreetses jäätmeveo piirkonnas",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_jaatmevaldaja"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
