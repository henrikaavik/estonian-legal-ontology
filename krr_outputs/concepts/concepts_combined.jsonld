    {
      "@id": "estleg:Concept_sotsiaal",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sotsiaal",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
