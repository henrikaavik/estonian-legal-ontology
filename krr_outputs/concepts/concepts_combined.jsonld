      },
      "rdfs:label": "spordiklubi",
      "skos:definition": [
        {
          "@value": "sportliku tegevuse arendamiseks moodustatud klubi, selts või muu ühing, mis tegutseb mittetulundusühinguna; 2",
          "@language": "et"
        },
        {
          "@value": "eraõiguslik juriidiline isik, kes on registreeritud Eesti Spordiregistris (edaspidi „spordiregister“) spordiklubina; 4",
          "@language": "et"
        },
        {
          "@value": "eraõiguslik juriidiline isik, mille põhitegevus on spordi arendamine ja mis on registreeritud Eesti Spordiregistris (edaspidi Spordiregistris) spordiklubina; 2",
          "@language": "et"
        },
        {
          "@value": "eraõiguslik juriidiline isik, mille põhitegevus on spordi arendamine; 4",
          "@language": "et"
        },
        {
          "@value": "eraõiguslik juriidiline isik, mille põhitegevus on sporditegevuse korraldamine ning mis on suunatud Maardu linna elanikele; 2",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "9",
        "@type": "xsd:integer"
      }
