      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "reklaamimaks",
      "skos:definition": "Saue valla territooriumil reklaami avaldamise eest käesolevas määruses sätestatud korras, ulatuses ja tähtaegadel tasumisele kuuluv maks (edaspidi maks); 6",
      "estleg:definedIn": [
