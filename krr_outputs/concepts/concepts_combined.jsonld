      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kuusalu_vallavalitsuse_palgajuhend_t1051697_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu, mida makstakse ametnikule teenistusülesannete täitmise eest ja tasu, mida makstakse töötajale töölepingu alusel tehtud töö eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051697_Par_1"
        }
      ],
