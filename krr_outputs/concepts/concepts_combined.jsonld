        "@id": "estleg:Concept_reklaamikandja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421_mobiilne_konstruktsioon",
      "@type": [
        "owl:NamedIndividual",
