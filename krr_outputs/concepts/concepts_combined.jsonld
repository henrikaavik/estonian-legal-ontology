    },
    {
      "@id": "estleg:Concept_saue_valla_valireklaami_maarus_t1060944_maksumaksja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "maksumaksja",
      "skos:definition": "füüsiline või juriidiline isik, kes on paigaldanud käesoleva määruse § 2 punktis 6 nimetatud reklaami; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060944_Par_2"
        }
