    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihange",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "riigihange",
      "skos:definition": "maksumusest olenemata asja ostmine, teenuse tellimine, ideekavandi saamine, ehitustöö tellimine või kontsessioonilepingu sõlmimine linna asutuse poolt; 13",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058097_Par_2"
        }
      ],
