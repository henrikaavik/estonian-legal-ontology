      "skos:definition": [
        {
          "@value": "vee omadusi halvendav saasteainete, organismide sisaldus vees, vee ülemäärane soojus või radioaktiivsus; 17",
          "@language": "et"
        },
        {
          "@value": "vee omadusi halvendav saasteainete, organismide sisaldus vees, vee ülemäärane soojus või radioaktiivsus; 24",
          "@language": "et"
        },
        {
          "@value": "vee omadusi halvendav reoainete, organismide, soojuse või radioaktiivsuse sisaldus vees. 23",
