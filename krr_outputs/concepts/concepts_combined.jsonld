        "@value": "lühiajaline kaubandustegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kauba või teenuse müük kuni kuuel päeval ühe kuu jooksul, mis võib toimuda ka väljaspool hooajalise kaubandustegevuse perioodi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
