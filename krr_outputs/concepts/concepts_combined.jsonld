        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "põhiprojekt",
      "skos:definition": "korterelamu rekonstrueerimiseks vajalik ehitusprojekt, mis on koostatud ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuete, standardi EVS 932 või samaväärsete nõuete ja määruse nõuete kohaselt. Korteriühistu võib põhiprojekti koostamisse kaasata arhitektuurse osa koostaja, kellel peab olema vähemalt volitatud arhitekti kutse 7. tase. Arhitektuurse osa koostamine tähendab, et arhitekt peab olema kaasatud ja koostama vähemalt ühe osa ehitusprojektist; 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059481_Par_2"
        }
      ],
      "estleg:sourceAct": "Ida-Virumaa korterelamute energiatõhususe toetuse tingimused",
