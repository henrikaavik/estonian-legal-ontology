      "estleg:definesConcept": {
        "@id": "estleg:Concept_preemia"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_asendustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "asendustasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puuduva teenistuja ülesannete täitmise eest makstav lisatasu, mida makstakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, juhul kui asendamine ei ole ettenähtud teenistuja ametijuhendis ja kui asendamine tingib võrreldes ametijuhendis ettenähtuga töökoormuse olulise suurenemise.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi Linnavalitsuse palgajuhend",
      "rdfs:label": "asendustasu (viljandi_linnavalitsuse_palgajuhend_t1057306)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_asendustasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_hoolduse_seadmise_hooldaja_maaramise_ja_hooldajatoetuse_maks_t1047383_hooldaja",
