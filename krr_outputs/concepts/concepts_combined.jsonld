      "estleg:definesConcept": {
        "@id": "estleg:Concept_lisatasu_taiendavate_teenistusulesannete_eest"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_asendustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "asendustasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puuduva teenistuja ülesannete täitmise eest makstav lisatasu, mida makstakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, kui asendamine ei tulene ametniku ametijuhendist või tingib võrreldes ametijuhendis ettenähtuga töökoormuse olulise suurenemise",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "asendustasu (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_asendustasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_lisatasu_valveaja_eest",
