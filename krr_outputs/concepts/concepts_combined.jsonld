    {
      "@id": "estleg:Concept_viimsi_valla_teede_ja_tanavate_sulgemise_maks_t1028011_soidutee_taielik_sulgemine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sõidutee täielik sulgemine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõidutee sulgemine selliselt, kus enam kui 50% selle laiusest on suletud, sõltumata suletava teelõigu pikkusest. Sõidutee loetakse täielikult suletuks ka juhul, kui tee mittesuletava osa laius on alla kolme meetri",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028011_Par_3"
        }
      ],
      "estleg:sourceAct": "Viimsi valla teede ja tänavate sulgemise maks",
