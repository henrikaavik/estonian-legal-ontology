      "rdfs:label": "tootja",
      "skos:definition": [
        {
          "@value": "elektriettevõtja, kes toodab elektrienergiat taastuvatest energiaallikatest, kombineeritult taastuvast ja muust energiaallikast või tõhusa koostootmise režiimil elektrituruseaduse tähenduses.",
          "@language": "et"
        },
        {
          "@value": "isik, kes on tootmisseadmega seotud mõõtepunkti võrgulepingu osapool ning kelle toodetud energia päritolu tõendamiseks väljastab päritolutunnistuste süsteemi haldaja (edaspidi süsteemihaldaja ) päritolutunnistusi.",
          "@language": "et"
        }
      ],
