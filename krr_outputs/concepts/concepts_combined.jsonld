        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taotleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kes taotleb PCT taotluse alusel patenti või kasuliku mudeli õiguskaitset Eestis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1002215_Par_1"
        }
      ],
