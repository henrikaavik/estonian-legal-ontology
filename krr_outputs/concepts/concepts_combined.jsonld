      "rdfs:label": "Kanderaamiteenus",
      "skos:definition": [
        {
          "@value": "kliendi tema kodust, haiglaruumist vm hoonesisesest mistahes korrusel asuvast asukohast kanderaamil pealevõtmine või sinna kanderaamil mahapanemine, kliendi eest hoolitsemine veo ajal (sh nt lamamisasendi muutmine, juua andmine vms.), sõiduki ettevalmistamine ja korrastamine enne kliendile teenuse osutamist.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
