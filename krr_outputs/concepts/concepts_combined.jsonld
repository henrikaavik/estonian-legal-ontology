      },
      "skos:definition": {
        "@value": "väljaspool tasemekoolitust, teenistuja isiklikust huvist lähtuvalt valitud õppetegevus, mis ei lähtu otseselt tööandja huvist ja vajadusest",
        "@language": "et"
