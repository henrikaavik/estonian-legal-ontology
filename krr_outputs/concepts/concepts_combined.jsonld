    {
      "@id": "estleg:Concept_rahvusvahelise_patenditaotluse_patendiametile_esitamise_kord_t1002215_rahvusvaheline_menetlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rahvusvaheline menetlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "taotleja, vastuvõtva ameti, Rahvusvahelise Büroo ja teiste PCT ametite toimingud, mis on sooritatud enne PCT taotluse esitamist Patendiametile kui märgitud ametile või märgitud ja väljavalitud ametile",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1002215_Par_1"
        }
      ],
      "estleg:sourceAct": "Rahvusvahelise patenditaotluse Patendiametile esitamise kord",
