        "@value": "septik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on pealt suletav mahuti, kus toimub reovee mehhaanilise puhastamise käigus heljumi settimine ning anaeroobne lagundamine, septik koosneb üldjuhul kolmest üksteisele järgnevast kambrist ning sellel on väljavool",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
