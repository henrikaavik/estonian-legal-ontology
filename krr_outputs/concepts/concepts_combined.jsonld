        "@type": "xsd:integer"
      },
      "rdfs:label": "kogukonnakeskus",
      "skos:definition": [
        {
          "@value": "mittetulundusühing, mis tegutseb kultuuri valdkonnas ja mille tegevuse sisuks on kogukonna ja/või külaliikumise arendamine ning kodanikualgatuse ja ühistegevuse aktiviseerimine",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
