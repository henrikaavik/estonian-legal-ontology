        "@type": "xsd:integer"
      },
      "rdfs:label": "rahvusvaheline sertifikaat",
      "skos:definition": [
        {
          "@value": "ametlik vastavustõend keeleoskustaseme kohta, mille määramise aluseks on rahvusvaheliselt tunnustatud keeleeksam",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
