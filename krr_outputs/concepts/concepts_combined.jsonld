      "rdfs:label": "kompostimine",
      "skos:definition": [
        {
          "@value": "biolagunevate jäätmete looduslik biokeemiline lagundamine mikroorganismide toimel maapinnal või kompostris; 10",
          "@language": "et"
        },
        {
          "@value": "biolagunevate jäätmete segamine ja ladestamine ning käitlemine maapinnal või kompostris nende looduslikuks lagundamiseks mullaviljakuse parandamise eesmärgil 21",
          "@language": "et"
        },
        {
          "@value": "biolagunevate jäätmete töötlemine kindlate tingimuste alusel; 13",
          "@language": "et"
        },
        {
          "@value": "biolagunevate jäätmete töötlemine kindlate tingimuste alusel; 18",
