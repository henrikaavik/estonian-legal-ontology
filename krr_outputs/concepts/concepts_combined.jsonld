    {
      "@id": "estleg:Concept_looma_identifitseerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "looma identifitseerimine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kiili_valla_koerte_kasside_ja_teiste_lemmikloomade_pidamise__t1006928_looma_identifitseerimine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "looma identifitseerimine",
      "skos:definition": [
        {
          "@value": "identifitseerimisviisid on looma märgistamine, looma kirjeldamine või looma kuuluvuse määratlemine. Looma märgistamine on tema varustamine eristamist võimaldava püsiva ning kordumatu kunstliku tunnusega. Looma kirjeldamist tema eristamise eesmärgil kasutatakse loomade puhul, keda ei ole võimalik või otstarbekas märgistada. Loomad, keda ei ole võimalik või otstarbekas märgistada ja kelle kohta ei saa selle loomaliigi isendite suure välise sarnasuse tõttu koostada kirjeldust, identifitseeritakse nende kuuluvuse kaudu; 8",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_looma_margistamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "looma märgistamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_joelahtme_valla_koerte_ja_kasside_pidamise_eeskiri_t1013342_looma_margistamine"
        },
