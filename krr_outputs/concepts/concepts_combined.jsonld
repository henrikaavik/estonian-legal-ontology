      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809_Sademevesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sademevesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi (edaspidi sademevesi ), mis ei ole reovesi ning mis juhitakse ühiskanalisatsiooni või sademevee kanalisatsiooni.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058809_Par_2"
        }
      ],
