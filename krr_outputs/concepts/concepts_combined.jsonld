      "skos:definition": [
        {
          "@value": "energiamärgistuse kasutamine muul kui liikmesriigi ametiasutuste või Euroopa Liidu institutsioonide poolt viisil, mida ei ole ette nähtud käesoleva direktiivi või delegeeritud õigusaktiga; 4",
          "@language": "et"
        }
      ]
    },
