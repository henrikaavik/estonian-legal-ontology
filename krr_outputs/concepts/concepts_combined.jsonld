      }
    },
    {
      "@id": "estleg:Concept_tapa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1060264_analuutiline_ja_sunteetiline_arvestus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "analüütiline ja sünteetiline arvestus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandusinformatsiooni liigendamise erinevad detailsuse tasemed. Sünteetiline arvestus on majandusinformatsiooni kirjendamine raamatupidamiskontodele. Analüütiline arvestus on raamatupidamiskontodele kirjendatud majandusinformatsiooni detailiseerimine (nõuded ja kohustused – kelle vastu jms). Analüütilist arvestust peetakse kas majandustarkavara pearaamatust eristatud moodulites (registrites) või teiste tarkvaravahenditega või käsitsi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060264_Par_2"
        }
      ],
      "estleg:sourceAct": "Tapa Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "analüütiline ja sünteetiline arvestus (tapa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1060264)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_analuutiline_ja_sunteetiline_arvestus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tapa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1060264_kinnitamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnitamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandustehingu toimumise ja õiguspärasuse kinnitamine allkirjaga ning eelarve tunnuse või nimetuse määramine valla eelarveklassifikaatorite liigenduses. Toiming kuulub kuludokumendi kontrollija või vastutava isiku (eelarve vastutav täitja, projekti vastutav täitja või muu aktseptiõiguslik isik) kompetentsi ja on üks sisekontrolli komponentidest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060264_Par_2"
        }
      ],
      "estleg:sourceAct": "Tapa Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "kinnitamine (tapa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1060264)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnitamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tapa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1060264_aruandeperiood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "aruandeperiood",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "periood, mille jooksul toimunud majandustehingute kirjendid võetakse arvesse aruannete koostamisel. Lühim aruandeperiood on kalendrikuu. Majandusaasta aruandeperiood on kalendriaasta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060264_Par_2"
        }
      ],
      "estleg:sourceAct": "Tapa Vallavalitsuse raamatupidamise sise-eeskiri",
