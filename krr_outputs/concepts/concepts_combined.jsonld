      },
      "skos:definition": {
        "@value": "üheks liikumiseks mõeldud eelmüügist või ühissõiduki juhi käest ostetud sõidudokument, mis kehtib sellele märgitud aja jooksul ja annab õiguse ümberistumiseks",
        "@language": "et"
      },
