        }
      ],
      "estleg:sourceAct": "Tartu Vallavalitsuse palgajuhend",
      "rdfs:label": "palk (tartu_vallavalitsuse_palgajuhend_t1041625)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_palk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tartu_vallavalitsuse_palgajuhend_t1041625_tootasu",
      "@type": [
