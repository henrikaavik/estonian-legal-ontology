      },
      "rdfs:label": "Sisekontrolöri tööplaan",
      "skos:definition": [
        {
          "@value": "sisekontrolli läbiviimise aastaplaan, mis kinnitatakse vallavalitsuse korraldusega ja tehakse kättesaadavaks vallavalitsuse ametiasutuste ja nende ametiasutuste hallatavate asutuste juhtidele või valla valitseva mõju all oleva äriühingu, sihtasutuse ja mittetulundusühingu juhtorganitele.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
