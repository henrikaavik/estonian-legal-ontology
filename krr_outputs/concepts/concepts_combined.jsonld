    {
      "@id": "estleg:Concept_spetsialistidele_munitsipaalkorterite_uurile_andmise_kord_na_t1050466_spetsialist",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "spetsialist",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "oma ametikohale vastava kvalifikatsiooniga (vajalik haridus, väljaõpe või töökogemus) isik, kellel on töö- või teenistussuhe Narva linna ametiasutuse või Narva linna ametiasutuse hallatava asutuse või juriidilise isikuga, kus Narva linn on asutaja, osaleja või aktsionär ning kes vajab eluruumi teenistus- või töösuhte ajaks; 3) Narva Linnavalitsuse eluasemekomisjon (edaspidi ka eluasemekomisjon ) – Narva Linnavalitsuse alaline komisjon, kelle ülesandeks on temale Narva linna õigusaktidega pandud kohustuste täitmine Narva linna eluasemevaldkonnas.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050466_Par_2"
        }
      ],
      "estleg:sourceAct": "Spetsialistidele munitsipaalkorterite üürile andmise kord Narva linnas",
      "rdfs:label": "spetsialist (spetsialistidele_munitsipaalkorterite_uurile_andmise_kord_na_t1050466)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_spetsialist"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_spetsialistidele_munitsipaalkorterite_uurile_andmise_kord_na_t1050466_vabaturult_uuritud_eluruum_kaesoleva_Korra_tahenduses",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vabaturult üüritud eluruum käesoleva Korra tähenduses",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Narva linna haldusterritooriumil asuv ja eraomandis olev korteriomand, mida kasutatakse alaliseks elamiseks ning mille kasutamiseks on spetsialistil sõlmitud kirjalik eluruumi üürileping",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050466_Par_2"
        }
      ],
      "estleg:sourceAct": "Spetsialistidele munitsipaalkorterite üürile andmise kord Narva linnas",
      "rdfs:label": "vabaturult üüritud eluruum käesoleva Korra tähenduses (spetsialistidele_munitsipaalkorterite_uurile_andmise_kord_na_t1050466)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vabaturult_uuritud_eluruum_kaesoleva_korra_tahenduses"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_spetsialistidele_munitsipaalkorterite_uurile_andmise_kord_na_t1050466_uur",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "üür",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu eluruumi kasutamise eest, välja arvatud kõrvalkulud ning hoone korrashoiu- ja parenduskulud, vastavalt üürileandja ja spetsialisti vahel sõlmitud kirjalikule eluruumi üürilepingule.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050466_Par_2"
        }
      ],
