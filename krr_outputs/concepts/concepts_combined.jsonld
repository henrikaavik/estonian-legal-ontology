      },
      "skos:definition": {
        "@value": "kinnistu veevärki veega varustav või kinnistu kanalisatsioonist reo- või sademevett ärajuhtiv toru peatorust liitumispunktini, viimane kaasa arvatud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059614_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Harju valla ühisveevärgi ja -kanalisatsiooni liitumise ning kasutamise eeskiri",
      "rdfs:label": "ühendustoru (laane_harju_valla_uhisveevargi_ja_kanalisatsiooni_liitumise__t1059614)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhendustoru"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_laane_harju_valla_uhisveevargi_ja_kanalisatsiooni_liitumise_t1059614_uhiskanalisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühiskanalisatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühiskanalisatsioon võib olla rajatud sõltuvalt asukoha eripärast isevoolse-, survelise või vaakumsüsteemina; 56) ühisveevärgi ja -kanalisatsiooni arendamise kava – kava, mille kinnitab kohaliku omavalitsuse volikogu ning mille alusel piirkonnas toimub ühisveevärgi ja -kanalisatsiooni arendamine; 57) ühisveevärgi ja -kanalisatsiooni avarii – ühisveevärgi ja -kanalisatsiooni ehitiste või seadmete ettenägematu purunemine või mittetoimimine, mille tagajärjel oluliselt halveneb või katkeb tarbijate veega varustamine või nende reovee ning sademevee ärajuhtimine või on ohustatud inimesed, ehitised või keskkond; 58) ühisveevärgi ja/või -kanalisatsiooniga kaetud ala – ühisveevärgi ja -kanalisatsiooni arendamise kavaga määratud ala, kus ühisveevärk ja -kanalisatsioon on rajatud või selle arengukavajärgne rajamise tähtaeg on möödunud; 59) ühisveevärk ja -kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu varustatakse tarbijaid joogiveega ja juhitakse ära ning puhastatakse reo- ja sademevett ja mille projekteeritud jõudlus on vähemalt kümme kuupmeetrit ööpäevas ning mis teenindab vähemalt 50 inimest. Ühisveevärgi ja -kanalisatsioonina käsitatakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059614_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Harju valla ühisveevärgi ja -kanalisatsiooni liitumise ning kasutamise eeskiri",
      "rdfs:label": "ühiskanalisatsioon (laane_harju_valla_uhisveevargi_ja_kanalisatsiooni_liitumise__t1059614)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhiskanalisatsioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
