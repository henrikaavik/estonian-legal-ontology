        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiakandjate kaalumistegurid",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tegurid, millega võetakse arvesse tarnitud energia tootmiseks vajalik primaarenergia kasutus ja selle keskkonnamõju. Energiakandjate kaalumistegurite arvväärtused on sätestatud ehitusseadustiku § 65 lõike 3 alusel kehtestatud määruses hoone energiatõhususe miinimumnõuete kohta (edaspidi energiatõhususe miinimumnõuete määrus )",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1029420_Par_2"
        }
      ],
      "estleg:sourceAct": "Nõuded energiamärgise andmisele ja energiamärgisele",
      "rdfs:label": "energiakandjate kaalumistegurid (nouded_energiamargise_andmisele_ja_energiamargisele_t1029420)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_energiakandjate_kaalumistegurid"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_nouded_energiamargise_andmisele_ja_energiamargisele_t1029420_energiakasutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiakasutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "elektri- või soojusenergia kasutus vaadeldavas süsteemipunktis. Energiakasutus arvutatakse netoenergiavajadusest, võttes arvesse süsteemikaod ja kaod energia muundamisel. Tehnosüsteemi lõpp-punktis (üldjuhul liitumispunkt energiavõrguga) võrdub tehnosüsteemi energiakasutus tarnitud energia ja lokaalse taastuvenergia summaga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1029420_Par_2"
        }
      ],
