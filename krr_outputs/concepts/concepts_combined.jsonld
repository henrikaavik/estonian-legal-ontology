    {
      "@id": "estleg:Concept_kohtla_jarve_linnavalitsuse_palgajuhend_t1048458_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "töötaja",
      "skos:definition": "Kohtla-Järve linnaga ametiasutuse kaudu eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks; RT IV 2025-03-07 9 407032025009 2025-03-10 , rakendatakse alates 01.02.2025 6",
