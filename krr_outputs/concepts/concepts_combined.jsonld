      "rdfs:label": "põhipalk (viimsi_vallavalitsuse_palgajuhend_t1055505)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pohipalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_vallavalitsuse_palgajuhend_t1055505_muutuvpalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muutuvpalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga või töötasu ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055505_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi Vallavalitsuse palgajuhend",
      "rdfs:label": "muutuvpalk (viimsi_vallavalitsuse_palgajuhend_t1055505)",
      "estleg:definesConcept": {
