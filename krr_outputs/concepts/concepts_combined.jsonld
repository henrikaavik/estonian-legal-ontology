          "@value": "Haridus- ja Teadusministeeriumi pidamisel olev gümnaasium, mis tegutseb põhikooli- ja gümnaasiumiseaduse § 2 lõike 3 punktides 4, 6 1 või 8 toodud vormis ja kus võib toimuda nii statsionaarne kui mittestatsionaarne õpe",
          "@language": "et"
        },
        {
          "@value": "Haridus- ja Teadusministeeriumi pidamisel olev gümnaasium, mis tegutseb põhikooli- ja gümnaasiumiseaduse § 2 lõike 3 punktis 4 toodud vormis",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riigihange",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihange",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_johvi_valla_hankekord_t1042458_riigihange"
        },
        {
          "@id": "estleg:Concept_laaneranna_valla_hankekord_t1057992_riigihange"
        },
        {
          "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihange"
        },
        {
          "@id": "estleg:Concept_vormsi_valla_hankekord_t1058651_riigihange"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riigihange",
      "skos:definition": [
        {
          "@value": "hange, mille eeldatav maksumus on võrdne või suurem RHS § 14 lõikes 2 nimetatud piirmääraga",
          "@language": "et"
        },
        {
          "@value": "maksumusest olenemata asja ostmine, teenuse tellimine, ideekavandi saamine, ehitustöö tellimine või kontsessioonilepingu sõlmimine linna asutuse poolt",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riigihangete_tugiteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihangete tugiteenus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihangete_tugiteenus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riigihangete tugiteenus",
      "skos:definition": [
        {
          "@value": "keskse hankija osutatav riigihangete korraldamise teenus, sealhulgas linna asutuste nõustamine riigihangetega seotud küsimustes, riigihanke ettevalmistamine ja toimingute tegemine linna asutuse nimel",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riigihanke_alusdokumendid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke alusdokumendid",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_alusdokumendid"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riigihanke alusdokumendid",
      "skos:definition": [
        {
          "@value": "hanketeade, kontsessiooniteade, ideekonkursi kutse, pakkumuse esitamise ettepanek ja kõik linna asutuse koostatud või viidatud muud riigihanke menetlusega seotud dokumendid (välja arvatud riigihanke otsused), milles on määratud ühe konkreetse riigihanke üksikasjad, sealhulgas pakkujale ja taotlejale esitatud tingimused ja dokumentide esitamise nõuded, tehniline kirjeldus, lepingu tingimused ning pakkumuste hindamise kriteeriumid",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riigihanke_eest_vastutav_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke eest vastutav isik",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_paide_linna_hankekord_t1042558_riigihanke_eest_vastutav_isik"
        },
        {
          "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_eest_vastutav_isik"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riigihanke eest vastutav isik",
      "skos:definition": [
        {
          "@value": "isik, kes vastutab hanke korraldamise seaduslikkuse eest vastavalt riigihankeseaduses ja hankedokumentides sätestatud nõuetele, sh juhib hankega seotud komisjonide tööd ja sisestab riigihangete registrisse hankemenetlusega seotud informatsiooni.",
          "@language": "et"
        },
        {
          "@value": "linna asutuse juhi või tema volitatud isiku määratud isik, kes viib läbi riigihanke menetluse või ostumenetluse ja vastutab riigihanke menetluse või ostumenetluse läbiviimise õiguspärasuse eest",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riigihanke_menetlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke menetlus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_menetlus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riigihanke menetlus",
      "skos:definition": [
        {
          "@value": "riigihangete seaduse alusel läbiviidav menetlus, millega kaasneb kohustus teha riigihangete seaduse kohaselt riigihangete registris toiminguid ja mille eesmärk on lepingu sõlmimine või ideekavandi saamine",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riigihanke_otsused",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke otsused",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_otsused"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riigihanke otsused",
      "skos:definition": [
        {
          "@value": "riigihangete seaduse või riigihanke alusdokumentide alusel vastuvõetavad otsused, mis vormistatakse käskkirja või korraldusena",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riigihanke_tehniline_kirjeldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigihanke tehniline kirjeldus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_tehniline_kirjeldus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riigihanke tehniline kirjeldus",
      "skos:definition": [
        {
          "@value": "asjade või teenuste lepingu esemeks olevate asjade või teenuste omaduste ja neile esitatavate nõuete loetelu ning ehitustööde lepingu esemeks olevate ehitustööde omaduste ja neile esitatavate tehniliste nõuete kogum. Lepingu eseme kirjeldamiseks kasutatakse vastavas valdkonnas tegutsevatele isikutele arusaadavat terminoloogiat ja täpsusastet",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riigikaitselise_ehitise_piiranguvoond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riigikaitselise ehitise piiranguvöönd",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_riigikaitselise_ehitise_toovoime_kriteeriumid_piirangute_ruu_t1030130_riigikaitselise_ehitise_piiranguvoond"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riigikaitselise ehitise piiranguvöönd",
      "skos:definition": [
        {
          "@value": "riigikaitselist ehitist ümbritsev ala, kus asuvad ehitised või kus toimuv tegevus võib ohustada riigikaitselist ehitist või mõjutada riigikaitselise ehitise töövõimet.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riiklik_registreerimismark",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riiklik registreerimismärk",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_maastikusoiduki_registreerimise_tingimused_ja_kord_t1001130_riiklik_registreerimismark"
        },
        {
          "@id": "estleg:Concept_mootorsoiduki_ja_selle_haagise_registreerimise_tingimused_ja_t1000727_riiklik_registreerimismark"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "riiklik registreerimismärk",
      "skos:definition": [
        {
          "@value": "majandus- ja kommunikatsiooniministri 21. juuni 2011. a määruse nr 49 „Riiklikele registreerimismärkidele ja nende valmistamisele esitatavad nõuded” kohane sõiduki tunnusmärk, millele on kantud sõidukile omistatud registreerimisnumber",
          "@language": "et"
        },
        {
          "@value": "majandus- ja kommunikatsiooniministri poolt riiklikele registreerimismärkidele kehtestatud nõuete kohane sõiduki tunnusmärk, millele on kantud sõidukile omistatud registreerimisnumber; 13) vastutav kasutaja (registreerimistunnistuse omanik) – eesti kodakondsusega või Eestis elamisloa või -õiguse saanud füüsiline isik või Eestis registreeritud juriidiline isik, kes kasutab sõidukit kasutuslepingu või omandireservatsiooniga müügilepingu alusel ning kes on kantud mootorsõiduki eest vastutava kasutajana registrisse",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_riikliku_tahtsusega_teadustaristu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "riikliku tähtsusega teadustaristu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_riikliku_tahtsusega_teadustaristu"
        }
      ],
