          "@id": "estleg:Concept_maardu_linna_uhisveevargi_ja_kanalisatsiooni_liitumise_ning_t1063268_sademeveekanalisatsioon"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sademeveekanalisatsioon",
      "skos:definition": [
        {
          "@value": "rajatised ainult sademe-, drenaaži- ja pinnase- ja pinnavee kanaliseerimiseks ja ärajuhtimiseks",
          "@language": "et"
        },
        {
          "@value": "rajatiste, sealhulgas kraavituste ja seadmete süsteem sademevee ärajuhtimiseks",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_sademevee_kanalisatsioon"
        }
      ],
