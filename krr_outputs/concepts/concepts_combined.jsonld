      },
      "rdfs:label": "jäätmevaldaja",
      "skos:definition": [
        {
          "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu- või äriruum; 6",
          "@language": "et"
        },
        {
          "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu- või äriruum; 7",
          "@language": "et"
        },
        {
          "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu-, äri- või tootmisruum; 7",
          "@language": "et"
        },
        {
          "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel kinnisasja omanik, millel asub suvila, elu- või äriruum; 9",
          "@language": "et"
        },
        {
          "@value": "jäätmetekitaja või muu isik, riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed; 15",
