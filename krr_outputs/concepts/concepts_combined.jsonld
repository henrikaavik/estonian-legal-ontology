      "estleg:definitionCount": {
        "@value": "65",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sademevesi",
      "skos:altLabel": [
        {
          "@value": "Sademevesi",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi, mis ei ole reovesi ning mis juhitakse ühiskanalisatsiooni või sademevee kanalisatsiooni; 19",
          "@language": "et"
        },
        {
          "@value": "sademetena maapinnale langenud ning ehitiste, sh kraavide abil kogutud ja suublasse suunatud vesi; 25",
          "@language": "et"
        },
        {
          "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi, mis ei ole reovesi ning mis juhitakse ühisvoolsesse kanalisatsiooni või sademevee kanalisatsiooni; 28",
          "@language": "et"
        },
        {
          "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning maapinnalähedase põhjaveekihi, mis toitub otseselt sademetest, vesi; 7",
          "@language": "et"
        },
        {
          "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi (edaspidi sademevesi ), mis ei ole reovesi ning mis juhitakse ühiskanalisatsiooni või sademevee kanalisatsiooni. 19",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "39",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_sademetevesi"
        }
      ]
    },
    {
