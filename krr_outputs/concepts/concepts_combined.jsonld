        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Linna oluline mõju",
      "skos:definition": "Linna omanduses on otse või valitseva mõju all oleva juriidilise isiku kaudu rohkem kui 20% sidusüksuste hääleõigusest, välja arvatud erandjuhud, kus on võimalik selgelt tõlgendada, et sellise hääleõigusega ei kaasne olulist mõju; 17",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056998_Par_3"
        }
      ],
      "estleg:sourceAct": "Loksa linna raamatupidamise sise-eeskiri",
      "rdfs:label": "Linna oluline mõju (loksa_linna_raamatupidamise_sise_eeskiri_t1056998)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_linna_oluline_moju"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_linna_oluline_moju"
        }
      ]
    },
    {
      "@id": "estleg:Concept_loksa_linna_raamatupidamise_sise_eeskiri_t1056998_Linna_valitsev_moju",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Linna valitsev mõju",
      "skos:definition": "Linna omanduses on otse või valitseva mõju all oleva juriidilise isiku kaudu rohkem kui 20% sidusüksuste hääleõigusest, välja arvatud erandjuhud, kui on võimalik selgelt tõlgendada, et sellise hääleõigusega ei kaasne kontrolli. Kontroll eksisteerib ka siis, kui Linnale kuulub 50% ja vähem hääleõigusest, kuid Linn: a) omab tegelikku kontrolli rohkem kui 50% häälõiguse üle kokkuleppe alusel teise investoriga; b) kontrollib juriidilise isiku finants- ja tegevuspoliitikat teatud lepingu või kokkuleppe alusel; c) suudab määrata või tagasi kutsuda enamust tegev- ja kõrgema juhtkonna liikmetest; d) suudab määrata tegevjuhtkonna ja kõrgema juhtorgani koosoleku otsuseid.",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056998_Par_3"
        }
      ],
      "estleg:sourceAct": "Loksa linna raamatupidamise sise-eeskiri",
      "rdfs:label": "Linna valitsev mõju (loksa_linna_raamatupidamise_sise_eeskiri_t1056998)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_linna_valitsev_moju"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_linna_valitsev_moju"
        }
      ]
    },
