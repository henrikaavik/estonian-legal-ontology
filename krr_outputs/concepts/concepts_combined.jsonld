    {
      "@id": "estleg:Concept_sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_toetuse_t1056629_nutika_spetsialiseerumise_kasvuvaldkonnad",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "nutika spetsialiseerumise kasvuvaldkonnad",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Eesti teadus-, arendustegevuse, innovatsiooni ning ettevõtluse arengukavas 2021–2035 välja toodud fookusvaldkonnad: digilahendused igas eluvaldkonnas; tervisetehnoloogiad ja –teenused; kohalike ressursside väärindamine ning nutikad ja kestlikud energialahendused; 5) positiivselt evalveeritud teadus- ja arendusasutus – juriidiline isik või asutus, mille vähemalt ühe teadus- ja arendustegevuse valdkonna kohta on tehtud positiivne evalveerimisotsus või rakenduskõrgkool",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056629_Par_2"
        }
      ],
      "estleg:sourceAct": "„Sektoritevahelise mobiilsuse toetamine“ elluviimiseks toetuse andmise tingimused ja kord",
      "rdfs:label": "nutika spetsialiseerumise kasvuvaldkonnad (sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_toetuse_t1056629)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_nutika_spetsialiseerumise_kasvuvaldkonnad"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
