    {
      "@id": "estleg:Concept_huvihariduse_toetamise_kord_t1056792_huviharidus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huviharidus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pikaajaline süsteemne juhendatud tegelemine vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal, et omandada süvendatud teadmisi ja oskusi valitud huvialal. Huvihariduse õppekavad registreeritakse Eesti Hariduse Infosüsteemis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056792_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse toetamise kord",
      "rdfs:label": "huviharidus (huvihariduse_toetamise_kord_t1056792)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huviharidus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduse_toetamise_kord_t1056792_huvitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvitegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "süsteemne juhendatud tegelemine vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal, et omandada teadmisi ja oskusi valitud huvialal. Huvitegevuseks ei loeta lühiajalisi kursusi ja tervisesporti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056792_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse toetamise kord",
