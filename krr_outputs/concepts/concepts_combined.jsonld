      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ohtlikud jäätmed",
      "skos:definition": [
        {
          "@value": "jäätmed, mis komisjoni määruse (EL) nr 1357/2014 lisas nimetatud vähemalt ühe ohtliku omaduse tõttu võivad olla ohtlikud tervisele, varale või keskkonnale; 22",
          "@language": "et"
        },
        {
          "@value": "jäätmed, mis oma kahjuliku toime tõttu võivad olla ohtlikud tervisele, varale või keskkonnale, mis nõuavad erimenetlust nende käitlemisel (vanad õlid, lahustid, vanad värvid, vanad ravimid ning teravad ja torkivad jäätmed). 4",
          "@language": "et"
        },
        {
          "@value": "jäätmed, mis vähemalt ühe kahjuliku toime tõttu võivad olla ohtlikud tervisele, varale või keskkonnale; 15",
          "@language": "et"
        },
        {
          "@value": "jäätmed, mis vähemalt ühe kahjuliku toime tõttu võivad olla ohtlikud tervisele, varale või keskkonnale; 21",
          "@language": "et"
        },
        {
          "@value": "jäätmed, mis vähemalt ühe kahjuliku toime tõttu võivad olla ohtlikud tervisele, varale või keskkonnale; 9",
          "@language": "et"
        }
      ]
    },
