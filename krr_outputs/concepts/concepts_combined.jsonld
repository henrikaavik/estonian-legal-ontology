      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "parkla",
      "skos:definition": "sõidukite parkimiseks ettenähtud ehituslikult või liikluskorralduslikult kujundatud ala, mille moodustavad parkimiskohad ja neid ühendavad teeosad. Parklaks ei loeta sõidutee laiendit või jalgteed, mis on tähistatud parkimist korraldava liikluskorraldusvahendiga; 6",
      "estleg:definedIn": [
