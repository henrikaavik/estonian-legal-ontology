    {
      "@id": "estleg:Concept_reklaami_ja_teabe_paigaldamise_kord_t1002806_sotsiaalreklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "sotsiaalreklaam",
      "skos:definition": "reklaam, mille eesmärk on saavutada hinnangute andmise kaudu inimese käitumine avalikes huvides ja milles teatud probleemile keskendudes ei pakuta kaubamärgipõhist, vaid üldist lahendit; 11",
