        }
      ]
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Kliendi_kaasreisija",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kliendi kaasreisija",
      "skos:definition": "isik, kes reisib koos kliendiga, kuid kelle kaasasolek ei ole kliendiprofiilis reglementeeritud. 8",
