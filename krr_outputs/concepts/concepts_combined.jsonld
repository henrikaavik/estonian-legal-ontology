    {
      "@id": "estleg:Concept_pohja_sakala_valla_lemmikloomade_pidamise_eeskiri_t1059179_loomapidaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "loomapidaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle omandis või valduses on lemmikloom ning kes peab lemmiklooma kokkuleppel omanikuga rendi- või muu lepingulise suhte alusel. Juriidilisest isikust loomapidaja on kohustatud määrama lemmiklooma heaolu eest vastutava isiku. Lemmikloom loetakse kuuluvaks isikule, kelle valduses, sealhulgas kelle piiratud territooriumil või kellele kuuluvas ehitises loom asub, kui looma kuuluvusest huvitatud isik ei tõenda vastupidist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059179_Par_2"
        }
      ],
      "estleg:sourceAct": "Põhja-Sakala valla lemmikloomade pidamise eeskiri",
