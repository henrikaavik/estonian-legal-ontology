    {
      "@id": "estleg:Concept_vaike_maarja_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055415_Analuutiline_ja_sunteetiline_arvestus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Analüütiline ja sünteetiline arvestus",
      "skos:definition": "majandusinformatsiooni liigendamise erinevad detailsuse tasemed. Sünteetiline arvestus on majandusinformatsiooni kirjendamine raamatupidamiskontodele. Analüütiline arvestus on raamatupidamiskontodele kirjendatud majandusinformatsiooni detailiseerimine (nõuded ja kohustised – kelle vastu jms). 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055415_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja Vallavalitsuse raamatupidamise sise-eeskiri",
