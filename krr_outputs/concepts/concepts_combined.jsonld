      },
      "rdfs:label": "alaeelarve",
      "skos:definition": [
        {
          "@value": "vastuvõetud eelarve või lisaeelarve baasil hallatavate asutuste tulude ja kulude jaotus tululiikide, tegevusalade ja kululiikide lõikes; 6",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse ja hallatavate asutuste tulude ja kulude detailne jaotus vastavalt majanduslikule sisule lähtudes eelarve klassifikaatorist; 4",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse ja hallatavate asutuste tulude ja kulude detailne jaotus vastavalt majanduslikule sisule lähtudes eelarve klassifikaatorist; 5",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse Luunja Vallavalitsus (edaspidi vallavalitsus), struktuuriüksuse ja vallavalitsuse hallatava asutuse tulude ja kulude detailne jaotus vastavalt majanduslikule sisule lähtudes eelarve klassifikaatorist; 3",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse Põlva Vallavalitsus (edaspidi ametiasutus ) ja valitsuse hallatava asutuse eelarve; 4",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
