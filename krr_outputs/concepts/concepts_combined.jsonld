      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_jaatmeveo_dokument"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_korduskasutuspakend",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "korduskasutuspakend",
      "skos:definition": "pakend, mis on mõeldud ja kavandatud läbima oma olelustsükli jooksul mitu kasutuskäiku või- ringi. Korduvalt kasutatav pakend muutub pakendijäätmeks, kui ta ei kuulu enam korduskasutusele; 18",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "korduskasutuspakend (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korduskasutuspakend"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_korduskasutuspakend"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_korraldatud_jaatmevedu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "korraldatud jäätmevedu",
      "skos:definition": "olmejäätmete, eelkõige prügi ehk segaolmejäätmete, nende sortimisjääkide ja olmejäätmete tekkekohas liigiti kogumisel tekkinud jäätmeliikide kogumine ja vedamine määratud piirkonnast määratud jäätmekäitluskohta või -kohtadesse kohaliku omavalitsuse üksuse korraldatud konkursi korras valitud ettevõtja (jäätmevedaja) poolt. Korraldatud jäätmevedu võib hõlmata ka teisi olmejäätmete liike või muid jäätmeid, kui see on vajalik jäätmeseaduse nõuete täitmiseks või seda tingib oluline avalik huvi; 19",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "korraldatud jäätmevedu (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korraldatud_jaatmevedu"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_korraldatud_jaatmevedu"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_korraldatud_jaatmeveo_teenustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "korraldatud jäätmeveo teenustasu",
      "skos:definition": "jäätmevaldaja poolt jäätmevedajale korraldatud jäätmeveoga hõlmatud jäätmete käitlemise eest makstav ühekordne konteineri tühjendustasu; 20",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "korraldatud jäätmeveo teenustasu (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
