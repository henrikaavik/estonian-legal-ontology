      "rdfs:label": "kaugküttesüsteem",
      "skos:definition": [
        {
          "@value": "soojuse tootmise, jaotamise ja tarbimise tehniline süsteem, mille moodustavad soojuse tootmise, jaotamise ja tarbimise tehnilised vahendid ja nendega seonduvad ehitised",
          "@language": "et"
        },
        {
          "@value": "soojuse tootmise, jaotamise ja tarbimise tehniline süsteem, mille moodustavad soojuse tootmise, jaotamise ja tarbimise tehnilised vahendid ja nendega seotud ehitised",
          "@language": "et"
        },
        {
          "@value": "kaugküttesüsteem kaugkütteseaduse § 2 punkti 2 mõistes",
          "@language": "et"
        }
      ],
