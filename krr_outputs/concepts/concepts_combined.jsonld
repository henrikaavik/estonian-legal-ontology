      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vaikeettevotja_digilahenduste_toetuse_andmise_kord_t1049765_omafinantseering",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omafinantseering",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "toetuse saaja rahaline panus abikõlblike kulude katmisse. Omafinantseering ei sisalda muid kohaliku omavalitsuse, riigi või Euroopa Liidu institutsioonide või fondide antud tagastamatuid toetusi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049765_Par_4"
        }
      ],
