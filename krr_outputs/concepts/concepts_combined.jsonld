    {
      "@id": "estleg:Concept_luganuse_vallavalitsuse_palgajuhend_t1041205_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "teenistuja",
      "skos:definition": "isik, kes on Lüganuse vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja; 2",
      "estleg:definedIn": [
