        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "võistkond",
      "skos:definition": [
        {
          "@value": "Rae vallas tegutseva spordiklubi võistkondliku sportmängu võistkond, kuhu kuulub minimaalselt kaks sportlast",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
