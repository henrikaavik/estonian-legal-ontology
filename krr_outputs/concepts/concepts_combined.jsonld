      },
      "rdfs:label": "sagedusautomaat",
      "skos:definition": [
        {
          "@value": "elektrisüsteemi sageduse järgi koormuse juhtimise automaat; 8",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_saku_valla_noor_on_uldhariduskoolis_voi_pohikoolijargses_kutseoppes_oppiv_kuni_1",
