    {
      "@id": "estleg:Concept_viimsi_valla_reklaamimaarus_t1039864_maksuhaldur",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "maksuhaldur",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kellel on kõik maksukorralduse seadusega antud maksuhalduri õigused ja pandud maksuhalduri kohustused, välja arvatud need õigused ja kohustused, mis on ainuomased riiklike maksude maksuhaldurile; 6) majandus- või kutsetegevuse koht – koht, kus vahetult pakutakse ja müüakse kaupa või vahetult pakutakse ja osutatakse teenust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039864_Par_1"
        }
      ],
