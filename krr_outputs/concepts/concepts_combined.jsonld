    {
      "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1058915_Ehitis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Ehitis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on inimtegevuse tulemusel loodud ja aluspinnasega ühendatud või sellele toetuv asi, mille kasutamise otstarve, eesmärk, kasutamise viis või kestvus võimaldab seda eristada teistest asjadest. Ehitis on hoone või rajatis. Hoone on väliskeskkonnast katuse ja teiste välispiiretega eraldatud siseruumiga ehitis. Rajatis on ehitis, mis ei ole hoone.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058915_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "Ehitis (marjamaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1058915)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ehitis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1058915_Fekaalid",
      "@type": [
        "owl:NamedIndividual",
