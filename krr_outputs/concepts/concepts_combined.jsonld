      ],
      "skos:prefLabel": {
        "@value": "äriprotsess",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kogum loogiliselt seotud tegevusi, mis sooritatakse asutuse eesmärkide saavutamiseks. Äriprotsessi tulemusena võidakse luua sise- või väliskliendile väärtust toodete või teenustena",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058728_Par_2"
        }
      ],
