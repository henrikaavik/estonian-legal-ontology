      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "pakendijäätmete kogumissüsteem",
      "skos:definition": [
        {
          "@value": "pakendiettevõtjate korraldatud pakendijäätmete kogumise süsteem, mis hõlmab kõiki Eesti Vabariigis turule lastud kaupade pakenditest tekkinud pakendijäätmeid, olenemata sellest, kas need on tekitatud tööstuses, kaubandustegevuses, olmes, ametiasutuses või mujal ning olenemata kasutatud materjalidest; 26",
          "@language": "et"
        }
      ]
    },
