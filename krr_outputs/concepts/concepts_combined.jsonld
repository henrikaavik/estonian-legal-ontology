        "@id": "estleg:Concept_eelarve_tegevusalakoodid"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_maardu_linna_koerte_ja_kasside_pidamise_eeskiri_t1051833_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "territoorium, rajatis või ruum, mis on antud üldiseks kasutamiseks või mis on tegelikult üldkasutatav (pargid, teed, tänavad, hoovid, haljasalad, parklad, kalmistud, avalikud veekogud, staadionid, mänguväljakud, bussootepaviljonid, ettevõtete piirdeaiata territooriumid, väljakud vms), üldkasutatavad hooned (ametiasutused, koolid, klubid, raamatukogud, spordihooned, toitlustus- ja kaubandusettevõtted, saunad, lasteaiad, kirikud vms), kortermajade üldkasutatavad ruumid (trepikojad, pööningud, keldrid vms), ühistransport; 2) loom on antud eeskirja kontekstis koer või kass",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051833_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna koerte ja kasside pidamise eeskiri",
      "rdfs:label": "avalik koht (maardu_linna_koerte_ja_kasside_pidamise_eeskiri_t1051833)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_koht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
