      ],
      "skos:definition": [
        {
          "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest; 6",
          "@language": "et"
        },
        {
          "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest; 9",
          "@language": "et"
        },
        {
          "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest; 8",
          "@language": "et"
        },
        {
          "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, preemiana erakordsete teenistusalaste saavutuste eest või lisatasuna ülesannete eest, mis ületavad kokkulepitud töömahtu, ei tulene töö sisust või ei ole seotud teenistuskoha eesmärgiga; 3",
          "@language": "et"
        },
        {
          "@value": "teenistuja palga või töötasu ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest; 5",
          "@language": "et"
        }
      ],
