      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rakendusuuringute_toetamine_nutika_spetsialiseerumise_kasvuv_t1030494_nutika_spetsialiseerumise_juhtkomitee_on_majandus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "nutika spetsialiseerumise juhtkomitee on majandus",
      "skos:definition": [
        {
          "@value": "ja kommunikatsiooniministri 10.02.2014 käskkirjaga nr 14-0042 loodud kogu, kuhu kuuluvad ministeeriumite, Riigikantselei, Rektorite Nõukogu ja ettevõtjate esindajad. Juhtkomitee ülesanne on jälgida nutika spetsialiseerumise püstitatud eesmärkide täitmist ja nende suunas liikumist ning vajadusel teha ettepanekuid muudatusteks strateegiate meetmetes ja tegevustes või algatada strateegiate muutmine; 12",
          "@language": "et"
        }
      ]
    },
