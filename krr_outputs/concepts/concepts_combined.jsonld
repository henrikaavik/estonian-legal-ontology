      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_infoturvapoliitika_t1058728_vara",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vara",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "miski, mida asutus, isik või riik oma olemasoluks ja tegutsemiseks vajab ning millel on selle omaniku jaoks väärtus. Varade hulka kuuluvad näiteks teave, andmed, tarkvara, füüsiline vara (taristu, hoone, riistvara, sisseseade), rahaline vara, teenus, inimressurss (inimesed, kvalifikatsioon, oskused, kogemused), oskusteave, mitteaineline vara (maine, kuvand); 9) infoturbe- või turvameetmed ehk meetmed – organisatsioonilised, füüsilised ja infotehnilised toimingud või vahendid andmete ja süsteemide turvalisuse saavutamiseks ning säilitamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058728_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla infoturvapoliitika",
      "rdfs:label": "vara (johvi_valla_infoturvapoliitika_t1058728)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vara"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
