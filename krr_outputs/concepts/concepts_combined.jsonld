      },
      "rdfs:label": "Üldhooldusteenus",
      "skos:altLabel": [
        {
          "@value": "üldhooldusteenus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kohaliku omavalitsuse üksuse korraldatav väljaspool kodu osutatav sotsiaalteenus täisealisele isikule, kes terviseseisundist, tegevusvõimest või elukeskkonnast tulenevatel põhjustel ei suuda kodustes tingimustes ajutiselt või püsivalt iseseisvalt toime tulla.",
          "@language": "et"
        },
        {
          "@value": "sotsiaalteenus sotsiaalhoolekande seaduse § 20 tähenduses",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
