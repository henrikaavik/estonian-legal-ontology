      "rdfs:label": "raieluba",
      "skos:definition": [
        {
          "@value": "luba, mis annab õiguse puu raieks ning määrab raietööde tingimused",
          "@language": "et"
        },
        {
          "@value": "luba, mis annab õiguse puu raieks ja hoolduslõikuseks ning vajadusel määrab selle lisatingimused",
          "@language": "et"
        },
        {
          "@value": "luba, mis annab õiguse puu raieks ning milles vajadusel määratakse loa kõrvaltingimused",
          "@language": "et"
        },
        {
          "@value": "kirjalik dokument, mis annab õiguse Paide linna haldusterritooriumil puu raiumiseks ning määrab raietööde tingimused",
          "@language": "et"
        },
        {
          "@value": "luba, mis annab taotlejale õiguse puu raieks ning vajadusel määrab ka kõrvaltingimused (sh asendusistutus)",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "17",
        "@type": "xsd:integer"
      },
