    },
    {
      "@id": "estleg:Concept_viimsi_valla_reklaamimaarus_t1039864_hinnakiri",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hinnakiri",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kõikide pakutavate roogade ja jookide hindade loetelu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039864_Par_1"
        }
      ],
