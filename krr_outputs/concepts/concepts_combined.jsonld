      },
      "rdfs:label": "tervishoiutöötaja kvalifikatsioon",
      "skos:definition": [
        {
          "@value": "dokumentaalselt tõendatud kutse- või erialane kõrgharidus või määruses sätestatud juhtudel töökogemus, mida nõutakse Eesti Vabariigis arstina, hambaarstina, õena või ämmaemandana töötamiseks.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
