      ],
      "skos:prefLabel": {
        "@value": "treener",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sportlasi ja teisi spordis osalevaid isikuid juhendav spordispetsialist, kellel on kutseseadusele vastav treeneri kutsekvalifikatsioon. Treeneril, kes juhendab noori vanuses 6-24 aastat, peab olema vähemalt treeneri kutsekvalifikatsiooni 4. aste",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057284_Par_2"
        }
      ],
