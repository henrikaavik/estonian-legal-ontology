    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_majandus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "majandus",
      "skos:definition": "või kutsetegevuse koht – koht, kus vahetult pakutakse ja müüakse kaupa või vahetult pakutakse ja osutatakse teenust; 3",
