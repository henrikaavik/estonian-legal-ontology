      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_pohja_sakala_vallavalitsuse_ametiasutuse_palgajuhend_t1049942_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Põhja-Sakala vallaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud ametiasutuses ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049942_Par_2"
        }
      ],
      "estleg:sourceAct": "Põhja-Sakala Vallavalitsuse ametiasutuse palgajuhend",
      "rdfs:label": "ametnik (pohja_sakala_vallavalitsuse_ametiasutuse_palgajuhend_t1049942)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_pohja_sakala_vallavalitsuse_ametiasutuse_palgajuhend_t1049942_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on võetud ametiasutuse töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049942_Par_2"
        }
      ],
      "estleg:sourceAct": "Põhja-Sakala Vallavalitsuse ametiasutuse palgajuhend",
