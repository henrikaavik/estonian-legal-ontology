        "@type": "xsd:integer"
      },
      "rdfs:label": "ringmajanduse tootmis",
      "skos:definition": [
        {
          "@value": "ja tarbimismudel on majandusmudel, mille kohaselt on kasutusel olevad ressursid kestlikult saadud ning mida tarbitakse targalt ning keskkonda hoidvalt, sealhulgas pikendatakse toodete eluiga ning kasutatakse teisest tooret; 11",
          "@language": "et"
        }
      ]
    },
