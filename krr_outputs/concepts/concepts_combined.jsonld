      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_kinnitamine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_vaike_maarja_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055415_Aruandeperiood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Aruandeperiood",
      "skos:definition": "periood, mille jooksul toimunud majandustehingute kirjendid võetakse arvesse aruannete koostamisel. Lühim aruandeperiood on kalendrikuu. Majandusaasta aruandeperiood on kalendriaasta. 4 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055415_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja Vallavalitsuse raamatupidamise sise-eeskiri",
