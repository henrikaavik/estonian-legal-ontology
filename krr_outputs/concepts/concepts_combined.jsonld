    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_purotehniline_toode",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pürotehniline toode",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "toode, mis on mõeldud kuumuse, valguse, heli, gaasi, suitsu või nende nähtuste kombinatsiooni saamiseks mitteplahvatusliku eksotermilise keemilise reaktsiooni abil ja mis sisaldab lõhkeainet või pürotehnilist ainet",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
      "rdfs:label": "pürotehniline toode (peipsiaare_valla_heakorra_eeskiri_t1044621)",
