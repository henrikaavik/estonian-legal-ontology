        "@id": "estleg:Concept_huviharidus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduses_ja_huvitegevuses_osalemise_toetamise_kord_t1056731_huvikool",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvikool",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kool, mis tegutseb huvikooli seaduse alusel, omab koolitusluba ja on registreeritud Eesti Hariduse Infosüsteemis.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056731_Par_2"
        }
