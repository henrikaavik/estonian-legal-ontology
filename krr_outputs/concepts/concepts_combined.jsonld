        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "osalustasu",
      "skos:definition": [
        {
          "@value": "lapsevanema poolt makstav tasu eralasteaias või -lastehoius, mis ei sisalda toidukulu.",
          "@language": "et"
        },
        {
          "@value": "lasteaia kulude (majandamiskulud, personali töötasu ja sotsiaalmaks ning õppevahendite kulud) vanemate poolt kaetava osa määr, mille kinnitab Saue Vallavolikogu. 10",
          "@language": "et"
        },
        {
          "@value": "lasteaia majandamiskulude, personali töötasu ja sotsiaalmaksu ning õppevahendite kulude osaline katmine vanema poolt; 3",
          "@language": "et"
        },
        {
          "@value": "lasteaia muude kulude lapsevanema poolt kaetava osa määr, mille kinnitab Saaremaa Vallavolikogu; 5",
          "@language": "et"
        },
        {
          "@value": "lasteaia muude kulude vanema poolt kaetava osa määr, mille kinnitab Keila Linnavolikogu; 7",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      }
    },
