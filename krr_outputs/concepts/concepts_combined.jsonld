      ],
      "skos:prefLabel": {
        "@value": "eelarve tegevusalakoodid",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rahandusministri määruse või muu õigusaktiga kehtestatud eelarve tegevusalade koodid. Korras täpsustamata mõisteid kasutatakse kohaliku omavalitsuse üksuse finantsjuhtimise seaduse ja raamatupidamise seaduse tähenduses.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044863_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna eelarve koostamise, vastuvõtmise ja täitmise kord",
