      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_reoveekogumisala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reoveekogumisala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee suublasse juhtimiseks. Reoveekogumisalad jagunevad suurteks (koormusega üle 2000 inimekvivalendi) ja väikesteks (koormusega alla 2000 inimekvivalendi)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054022_Par_2"
        }
      ],
