    {
      "@id": "estleg:Concept_elanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elanik",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rahvakusitluse_korraldamise_kord_johvi_vallas_t1044292_elanik"
        },
        {
          "@id": "estleg:Concept_rahvakusitluse_labiviimise_kord_pohja_sakala_vallas_t1055473_elanik"
        },
        {
          "@id": "estleg:Concept_rahvakusitluse_korraldamise_kord_t1060556_elanik"
        },
        {
          "@id": "estleg:Concept_elanike_arvamuse_valjaselgitamise_kord_t1061368_elanik"
        },
        {
          "@id": "estleg:Concept_valga_valla_kulavanema_statuut_t1048207_Elanik"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "elanik",
      "skos:altLabel": [
        {
          "@value": "Elanik",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "füüsiline isik, kelle elukoht või kinnisvara on asjaomases alevikus või külas (edaspidi küla). Elukoha määramise aluseks on rahvastikuregister ning kinnisvara määramise aluseks on kinnistusraamat. 2 (",
          "@language": "et"
        },
        {
          "@value": "vähemalt 16 aastat vanune isik, kelle rahvastikuregistri järgne elukoht on Jõhvi valla haldusterritooriumil; 2",
          "@language": "et"
        },
        {
          "@value": "vähemalt 16 aastat vanune isik, kelle rahvastikuregistri järgne elukoht on Põltsamaa valla haldusterritooriumil; 2",
          "@language": "et"
        },
        {
          "@value": "vähemalt 16-aastane E esti kodanik või Euroopa Liidu kodanik, kes on rahvaküsitluse päevaks saanud 16-aastaseks ja kelle Eesti rahvastikuregistri järgne elukoht asub Põhja-Sakala vallas või valla territooriumi vastaval osal selle päeva seisuga, kui volikogu otsustas rahvaküsitluse korraldamise. Hääleõiguslik ei ole isik, kes on valimisõiguse osas teovõimetuks tunnistatud. Hääletamisest ei võta osa isik, kes on kohtu poolt süüdi mõistetud ja kannab karistust kinnipidamiskohas; 2",
          "@language": "et"
        },
        {
          "@value": "vähemalt 16-aastane isik, kelle rahvastikuregistri järgne elukoht on Valga valla haldusterritooriumil; 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_elanikkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
