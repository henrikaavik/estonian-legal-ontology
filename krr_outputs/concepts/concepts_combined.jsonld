        }
      ]
    },
    {
      "@id": "estleg:Concept_johvi_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeski_t1036622_abonent",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "abonent",
      "skos:definition": "iga korter kortermajas ja/või iga mõõdusõlme omav ehitis/hoone kinnistul; 3",
      "estleg:definedIn": [
