      "rdfs:label": "müüja (kaubanduse_korraldamine_tallinna_linnas_t1056502)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
