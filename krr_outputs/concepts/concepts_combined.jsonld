      "rdfs:label": "tee",
      "skos:altLabel": [
        {
          "@value": "Tee",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "rajatis, mis on ette nähtud inimeste, sõidukite või loomade liikumiseks või liiklemiseks",
          "@language": "et"
        },
        {
          "@value": "maantee, tänav, jalgtee või muu sõidukite või jalakäijate liiklemiseks kasutatav rajatis",
          "@language": "et"
        },
        {
          "@value": "maantee, tänav, metsatee, jalgtee ja jalgrattatee või muu sõidukite või jalakäijate liiklemiseks kasutatav rajatis ehitusseadustiku tähenduses",
          "@language": "et"
        },
        {
          "@value": "on maantee, tänav, jalgtee ja jalgrattatee või muu sõidukite või jalakäijate liiklemiseks kasutatav rajatis, mis võib olla riigi või kohaliku omavalitsuse või muu juriidilise isiku või füüsilise isiku omandis",
          "@language": "et"
        },
        {
          "@value": "rajatis, mis on ette nähtud inimeste, sõidukite, või loomade liikumiseks või liiklemiseks. Tee osadeks loetakse ka liiklemiseks kasutatavad ning tee toimimiseks vajalikud rajatised",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "12",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tee_kaitsevoond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
