      "estleg:definesConcept": {
        "@id": "estleg:Concept_hea_raamatupidamistava"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_majandustehingute_kirjendaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "majandustehingute kirjendaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötaja, kes lähtudes heast raamatupidamistavast kirjendab valla majandustehingud raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on majandustehingute kirjendajaks raamatupidaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "majandustehingute kirjendaja (jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_majandustehingute_kirjendaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_majandusinformatsiooni_liigendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "majandusinformatsiooni liigendamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla majandustehingute kirjendamine, kasutades riigi või valla õigusaktidega kehtestatud tunnuseid (koode), mis võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid valla juhtimisotsuste tegemiseks ning riigi aruandluse jaoks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "majandusinformatsiooni liigendamine (jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_majandusinformatsiooni_liigendamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_tehingupartner_voi_tehingupartnerid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tehingupartner või tehingupartnerid",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingu või -tehingute osapool või -pooled, kellele on omistatud tunnused (tehingupartneri koodid) eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud finantsaruandeid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "tehingupartner või tehingupartnerid (jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tehingupartner_voi_tehingupartnerid"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_konsolideerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "konsolideerimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "raamatupidamisüksuste aruannete ühendamine nii, nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega kaasneb elimineerimine, milline tehing on konsolideerimisgruppi kuuluvate isikute omavaheliste vastandtehingute (tulud-kulud, nõuded-kohustised) liitmine nii, et grupi aruandes neid ei esine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "konsolideerimine (jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_konsolideerimine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_valla_konsolideerimisgrupp",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valla konsolideerimisgrupp",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutus koos struktuuriüksustega, hallatavad asutused ja valla valitseva või olulise mõju all olevad juriidilised isikud ning nende kaudu valitseva mõju all olevad juriidilised isikud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "valla konsolideerimisgrupp (jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valla_konsolideerimisgrupp"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_valla_oluline_moju",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valla oluline mõju",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "RTJ 11 punkti 9 kohaselt valla osalusega sidusettevõtted, s.o asutused, mille üle vald omab olulist mõju, kuid mis ei allu kontrollile. Olulise mõju olemasolu eeldatakse juhul, kui valla omanduses on otse või tütarettevõtete kaudu rohkem kui 20% sidusettevõtete hääleõigusest, välja arvatud erandjuhud kus on võimalik selgelt tõlgendada, et sellise hääleõigusega ei kaasne olulist mõju. Olulise mõju olemasolu iseloomustavad tavaliselt järgmised asjaolud: - esindatus investeerimisobjekti tegev- või kõrgemas juhtkonnas; - osalemine investeerimisobjekti äripoliitiliste otsuste tegemisel; - olulised tehingud valla ja investeerimisobjekti vahel; - valla ja investeerimisobjekti juhtkondade kattumine; - tehnilise informatsiooni vahetamine valla ja investeerimisobjekti vahel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "valla oluline mõju (jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valla_oluline_moju"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_valla_valitsev_moju",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valla valitsev mõju",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "RTJ 11 punkti 8 kohaselt osalusega tütarettevõtted, mida kontrollib vald. Kontrolli olemasolu eeldatakse juhul, kui valla omanduses on otse või tütarettevõtete kaudu rohkem kui 50% tütarettevõtte hääleõigusest, välja arvatud erandjuhud, kui on võimalik selgelt tõendada, et sellise hääleõigusega ei kaasne kontrolli. Kontroll eksisteerib ka siis, kui vallale kuulub 50% ja vähem hääleõigusest, kuid vald: - omab tegelikku kontrolli rohkem kui 50% hääleõiguse üle kokkuleppe alusel teiste investoritega; - kontrollib ettevõtte finants- ja tegevuspoliitikat teatud lepingu või kokkuleppe alusel; - suudab määrata või tagasi kutsuda tegev- ja kõrgema juhtkonna liikmeid; - suudab määrata tegevjuhtkonna ja kõrgema juhtorgani koosolekute otsuseid.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "valla valitsev mõju (jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valla_valitsev_moju"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_valla_sidusuksused",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valla sidusüksused",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla otsese või kaudse (st valitseva või olulise mõju all olevate isikute kaudu) olulise mõju alla olevad juriidilised isikud.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
