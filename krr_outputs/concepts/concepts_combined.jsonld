      "rdfs:label": "purgimissõlm",
      "skos:definition": [
        {
          "@value": "kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas määratud ametlik reovee ja fekaalide ühiskanalisatsiooni juhtimise koht; 13) purgimissõiduk (edaspidi sõiduk) – mahutiga auto, mille abil tühjendatakse reovee kohtkäitlusrajatis reoveest või -settest ning mis viib selle purgimissõlme",
          "@language": "et"
        },
        {
          "@value": "reovee tekkekohas kogutud reovee ja fekaalide ühiskanalisatsiooni juhtimise koht",
          "@language": "et"
        },
        {
          "@value": "koht, mis on Türi valla ühisveevärgi ja -kanalisatsiooni arendamise kavas määratud tekkekohast ära veetud reovee ühiskanalisatsiooni juhtimiseks.",
          "@language": "et"
        },
        {
          "@value": "rajatis, mis on määratud kohaliku omavalitsuse ühisveevärgi ja - kanalisatsiooni arendamise kavas tekkekohast väljaveetud reovee ühiskanalisatsiooni juhtimiseks",
          "@language": "et"
        },
        {
          "@value": "tekkekohast äraveetava reovee ühiskanalisatsiooni juhtimise koht",
          "@language": "et"
        }
      ],
