        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoiatusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ala, kus viibivat inimest teavitatakse ja hoiatatakse päästesündmuse mõjudest ning kust ta vajaduse korral evakueeritakse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000524_Par_13"
        }
      ],
