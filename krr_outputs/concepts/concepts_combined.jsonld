      },
      "rdfs:label": "heakorratöö",
      "skos:definition": [
        {
          "@value": "kinnistu heakorraga seotud tööd, sealhulgas haljastuse hooldamine, niitmine, lume- ja libedusetõrje teostamine, kevadine libedusetõrjeks kasutatud puistematerjali koristamine, haljastus-, olme- ning muude jäätmete koristamine jmt tööd",
          "@language": "et"
        },
        {
          "@value": "tolmu, liiva, prahi, jäätmete, lume ja jää koristamine, lume- ja libedusetõrje, muru ja rohu niitmine, lehtede riisumine, heki pügamine, teedel liikumist takistavate puude ja põõsaste okste lõikamine, k.a mahalangenud puude koristamine",
          "@language": "et"
        },
        {
          "@value": "kinnistu heakorraga seotud tööd, sealhulgas haljastuse hooldamine, niitmine, lume- ja libedusetõrje teostamine, kevadine libedusetõrjeks kasutatud puistematerjali koristamine, haljastus-, olme- ning muude jäätmete koristamine, umbrohu eemaldamine jms tööd",
          "@language": "et"
        },
        {
          "@value": "tolmu, liiva, prahi, jäätmete, lume ja jää koristamine (sh jääpurikad katusel) ning libedusetõrje teostamine, muru niitmine, rohu ja heina niitmine, lehtede riisumine, heki pügamine jms ning sõidu- ja/või kõnniteel liikumist takistavate puude ja põõsaste okste lõikamine",
          "@language": "et"
        },
        {
          "@value": "tolmu, liiva, prahi, lume ja jää koristamine, libedustõrje, muru ja rohu niitmine ning mahalangenud puulehtede, okste vms koristamine",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      },
