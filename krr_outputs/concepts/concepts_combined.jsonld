        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvitegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "süsteemne juhendatud tegelemine vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal, et omandada teadmised ja oskused valitud huvialal. Huvitegevusega tegeletakse huviringis, klubis, stuudios või muus juhendatud tegevuses. Huvitegevuseks ei loeta lühiajalist kursust",
        "@language": "et"
      },
