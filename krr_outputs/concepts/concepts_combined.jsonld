      "skos:definition": [
        {
          "@value": "isik või ühist kodust majapidamist jagavad isikud",
          "@language": "et"
        },
        {
          "@value": "majapidamisüksus, mille moodustavad ühise eelarvega ja koos majapidamisotsuseid langetavad inimesed",
          "@language": "et"
        },
        {
          "@value": "samas eluruumis elavad ühise majapidamisega isikud",
          "@language": "et"
        },
        {
          "@value": "taotleja ja kolm või enam last, kes elavad alaliselt samas eluruumis ning jagavad ühist kodust majapidamist",
          "@language": "et"
        },
        {
          "@value": "üksi elav isik või perekond või ühist eluruumi ja tuluallikat ühiselt kasutatavad või ühise majapidamisega isikud",
          "@language": "et"
        }
      ],
