      "estleg:definitionCount": {
        "@value": "11",
        "@type": "xsd:integer"
      },
      "rdfs:label": "palgagrupp",
      "skos:definition": [
        {
          "@value": "valdavas osas sarnaste teenistusülesannetega teenistuskohtade grupp, mis on jaotatud tasemeteks vastavalt täidetavate ülesannete iseloomule ja teenistusülesannete täitmisega kaasnevale vastutusele ning millele on määratud põhipalga miinimum- ja maksimummäär; 5",
          "@language": "et"
        },
        {
          "@value": "valdavas osas sarnaste tööülesannetega töökohtade grupp, mis on jaotatud tasemeteks vastavalt täidetavate ülesannete iseloomule ja tööülesannete täitmisega kaasnevale vastutusele ning millele on määratud põhipalga miinimum- ja maksimummäär; 4",
          "@language": "et"
        },
        {
          "@value": "näitab teenistusgruppi kuuluvust ja määrab vastava teenistusgrupi põhipalga palgavahemiku.",
          "@language": "et"
        },
        {
          "@value": "näitarv, mis seob teenistuskoha sellele vastava põhipalga või töötasuga.",
          "@language": "et"
        },
        {
          "@value": "näitarv, mis seob teenistuskoha sellele vastava põhipalga või töötasuga (edaspidi palk/töötasu) .",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "9",
        "@type": "xsd:integer"
      }
    },
