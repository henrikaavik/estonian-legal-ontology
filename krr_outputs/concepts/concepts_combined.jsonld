      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_teede_ajutise_sulgemise_eeskiri_t1028010_sulgeja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sulgeja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kellele on antud sulgemisluba ja kelle tegevusega kaasneb tee, teelõigu, parkla või väljaku täielik või osaline ajutine sulgemine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028010_Par_2"
        }
