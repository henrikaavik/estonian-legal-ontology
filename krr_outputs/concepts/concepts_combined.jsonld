    {
      "@id": "estleg:Concept_viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil__t1059033_soiduoigust_toendav_dokument",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "sõiduõigust tõendav dokument",
      "skos:definition": "sõidupilet (paberpilet või e-pilet) või sõidusoodustuse õigust tõendav dokument. E-pileti olemasolu tõendatakse valideeritud Ühiskaardi või muu andmekandja abil. Sõidupileti tooted on: üksikpilet, perioodipilet (kuukaart); 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059033_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi valla bussiliinidel ja Leppneeme-Kelnase laevaliinil sõidu eest tasumise kord ja sõidupiletite hinnad",
