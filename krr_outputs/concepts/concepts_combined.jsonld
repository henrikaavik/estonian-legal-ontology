        "@value": "sulgemisloa taotleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kes taotleb tee, teelõigu, parkla või väljaku täielikku või osalist ajutist sulgemist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028010_Par_2"
