        {
          "@value": "konkreetse maa-ala kohta koostatav terviklik ruumilahendus, millega määratakse seaduses sätestatud juhtudel maakasutus- ja ehitustingimused. Planeering koosneb tekstiosast ja joonistest, mis täiendavad üksteist ja moodustavad ühtse terviku",
          "@language": "et"
        }
      ],
