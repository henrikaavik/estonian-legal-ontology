      "skos:definition": [
        {
          "@value": "vallavalitsuse ametnik, kes menetleb puudega isiku taotluse alusel eluruumi kohandamise kulu hüvitamist",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
