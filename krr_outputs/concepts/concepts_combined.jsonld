        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tihe",
      "skos:definition": [
        {
          "@value": "ja kompaktse asustusega ala – üldplaneeringus määratud ala joonistel märgitud piirides; 13",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_tirk"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tiheasustus",
      "@type": [
        "owl:NamedIndividual",
