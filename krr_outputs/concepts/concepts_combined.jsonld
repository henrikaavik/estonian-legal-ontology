        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "olmereovesi",
      "skos:definition": [
        {
          "@value": "inimese elutegevuse tulemusena üle kahjustuspiiri rikutud ja puhastamist vajav vesi, reovesi või saastunud vesi; 13",
          "@language": "et"
        },
        {
          "@value": "ehk majapidamisreovesi on köökides, pesumajades, pesuruumides, WCdes, vannitubades vms paikades tekkiv reovesi; 4",
          "@language": "et"
        },
        {
          "@value": "elu- ja ametkondlikus veetarbimises tekkinud reovesi, kui selle reostusaste on grupi piirväärtuste piires, milline kuulub reostusgruppi RG1; 20",
          "@language": "et"
        },
        {
          "@value": "inimese elutegevuse tulemusena üle kahjustuspiiri rikutud ja puhastamist vajav vesi, reovesi või saastunud vesi; 6",
          "@language": "et"
        },
        {
          "@value": "inimese elutegevusega kaasnevate heitmetega reostunud vesi; 26 (",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_olmevesi_ehk_joogivesi",
