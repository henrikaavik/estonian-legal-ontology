    {
      "@id": "estleg:Concept_tartu_vallavalitsuse_palgajuhend_t1041625_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "teenistuja",
      "skos:definition": "Tartu vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o. töölepingu alusel töötav) töötaja; 2",
