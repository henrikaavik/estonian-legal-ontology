        {
          "@id": "estleg:Concept_kose_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054491_vedaja_kaart"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "vedaja kaart",
      "skos:definition": [
        {
          "@value": "Kohila Vallavalitsuse poolt väljastatud dokument, mis tõendab vastava sõiduki õigust teostada reovee või -sette äravedu Kohila valla territooriumil.",
          "@language": "et"
        },
        {
          "@value": "Kose Vallavalitsuse poolt väljastatud dokument, mis tõendab vastava sõiduki õigust teostada reovee või -sette äravedu Kose valla territooriumil.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
