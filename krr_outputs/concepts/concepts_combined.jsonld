      "skos:definition": [
        {
          "@value": "18-aastane ja vanem inimene, kes vajab järelevalvet, juhendamist ja/või abi toimingutes (kehahooldus, toitumine, liikumine), mis on vajalikud igapäevaseks toimetulekuks; 6",
          "@language": "et"
        },
        {
          "@value": "18-aastane ja vanem inimene, kes vajab järelevalvet, juhendamist ja/või abi toimingutes (toitumine, liikumine), mis on vajalikud igapäevaseks toimetulekuks; 5",
          "@language": "et"
        },
        {
          "@value": "18-aastane ja vanem inimene, kes vajab järelevalvet, juhendamist või abi igapäevaseks toimetulekuks vajalikes toimingutes, sealhulgas kehahooldusel, toitumisel ja liikumisel; 4",
          "@language": "et"
        },
        {
          "@value": "18-aastane või vanem inimene, kes vajab järelevalvet, juhendamist või abi igapäevaseks toimetulekuks vajalikes toimingutes, sealhulgas kehahooldus, toitumine ja liikumine; 5",
          "@language": "et"
        },
        {
          "@value": "inimene, kes vajab puude või erivajaduse tõttu ajutist või pidevat kõrvalabi, juhendamist ja/või järelevalvet igapäevaelu toimingutes; 4",
          "@language": "et"
        }
      ]
