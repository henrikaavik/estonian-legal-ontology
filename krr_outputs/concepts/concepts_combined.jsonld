        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "arvestusperiood",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "veevarustuse või reovee ning sademetevee ärajuhtimise teenuste osutamise periood, mille kohta esitatakse kliendile arve. Arvestusperioodiks on reeglina kalendrikuu. Arvestusperioodi täpse alguse ja lõpu kuupäevadeks on vee-(reovee-) arvesti näidu lugemise kuupäevad, mis määratakse teenuslepingus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1024955_Par_2"
        }
      ],
