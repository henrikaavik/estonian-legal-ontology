      "estleg:definesConcept": {
        "@id": "estleg:Concept_palk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_anija_vallavalitsuse_teenistujate_ja_hallatavate_asutuste_to_t1040811_tootasu",
