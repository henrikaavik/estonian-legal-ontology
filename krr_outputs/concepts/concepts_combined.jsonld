    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Eramajade_kuttesusteemide_uuendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Eramajade küttesüsteemide uuendamine",
      "skos:definition": "õhk-vesi ja õhk-õhk soojuspumba, maasoojuspumba, pelleti- või halupuidukatla paigaldamine, kütteseadme uuendamisel tahkekütteahju või tahkeküttepliidi soetamine koos paigaldamisega, tahkekütteahju või tahkeküttepliidi ehitamine, sh soojamüüri ehitamine, radiaatorite, sh torustiku ja armatuuri soetamine uue kütteseadme paigaldamisel, moodulkorstna soetamine ja paigaldus või uue korstnasüsteemi ehitus või olemasoleva korstnasüsteemi renoveerimine koos korstnahülsi paigaldusega tahkekütuse katla, ahju või pliidi ehitamisel. Toetuskõlbulik ei ole eis’i väikeelamute kütteseadmete uuendamise toetuse taotlemisel omaosaluse osa; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
