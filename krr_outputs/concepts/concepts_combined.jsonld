      }
    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_pauguti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pauguti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teravaid kilde mitteandvasse mittemetallist kesta paigutatud pürotehniline toode, mis laengu süttimisel tekitab peamiselt pauguga heliefekti",
        "@language": "et"
      },
