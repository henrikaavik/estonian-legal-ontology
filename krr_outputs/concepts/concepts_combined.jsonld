        "@id": "estleg:Concept_huviharidus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamine_t1059488_huvikool",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvikool",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "haridusasutus, mis tegutseb noorsootöö valdkonnas ning loob huvihariduse omandamise ja isiksuse mitmekülgse arengu võimalused huvihariduse erinevates valdkondades. Huvikool on registreeritud Eesti Hariduse Infosüsteemis (edaspidi EHIS ) ja omab koolitusluba",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059488_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamine",
      "rdfs:label": "huvikool (huvihariduse_ja_huvitegevuse_toetamine_t1059488)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huvikool"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamine_t1059488_huvitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvitegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "süsteemne juhendatud tegelemine vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal, et omandada teadmised ja oskused valitud huvialal. Huvitegevus ei pea olema õppekavapõhine ja korraldatakse erinevates asutustes ja erinevates organisatsioonides. Huvitegevuseks ei loeta lühiajalisi kursusi ja tervisesporti; 5) huvihariduse ja huvitegevuse pakkuja (edaspidi teenuse pakkuja ) - kultuuri-, noorsoo-, haridus- või spordiasutus, mis on äriregistris, Eesti spordiregistris või EHISes registreeritud juriidiline isik, kes võimaldab õppuritel tegeleda neid huvitavate huvialadega; 6) õpilaskoha arvestusliku maksumuse määr (edaspidi kohatasu ) – majandusaastaks teenuse pakkuja kinnitatud õppekoha tegevuskulu arvestuslik maksumus ühe õpilase kohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059488_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamine",
      "rdfs:label": "huvitegevus (huvihariduse_ja_huvitegevuse_toetamine_t1059488)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huvitegevus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
