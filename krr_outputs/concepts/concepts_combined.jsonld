      "skos:definition": [
        {
          "@value": "kliendi ja vee-ettevõtja vahel sõlmitud leping veevarustuse ja heitvee ärajuhtimise teenuste ostu-müügi kohta; 14",
          "@language": "et"
        },
        {
          "@value": "ja vee-ettevõtja vahel sõlmitud leping veevarustuse ja heitvee ärajuhtimise teenuse ostu-müügi kohta; 18",
          "@language": "et"
        },
        {
          "@value": "kliendi ja vee-ettevõtja vahel sõlmitud leping ühisveevärgi ja -kanalisatsiooniteenuste osutamise kohta; 34",
          "@language": "et"
        },
        {
          "@value": "kliendi ja vee-ettevõtja vahel sõlmitud leping ühisveevärgist vee võtmiseks ja/või reovee ja/või sademevee juhtimiseks ühiskanalisatsiooni; 13",
