      "estleg:definitionCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kaeveala",
      "skos:definition": [
        {
          "@value": "maa-ala, kus paikneb kaevatav süvend (kaevik) ja kaevikuga vahetult piirnev maa-ala, kus hoitakse kaevetööks materjale, sõidukeid, masinaid, mehhanisme ja seadmeid",
          "@language": "et"
        },
        {
          "@value": "kaevik ja kaevikuga piirnev maa-ala, millele ulatub kaevetööst tulenev mõju (kaevetööl kasutatavate materjalide, sõidukite ja seadmete hoidmine, juurdepääsuteeks vajalik ala, liikluse ümberkorraldamise ala jms), mille piirid määratakse vajadusel kaeveloas.",
          "@language": "et"
        },
        {
          "@value": "kaevik ja kaevikuga piirnev maa-ala, millele ulatub kaevetööst tulenev mõju (kaevetööl kasutatavate materjalide, sõidukite ja seadmete hoidmine, juurdepääsuteeks vajalik ala, liikluse ümberkorraldamise ala jms), mille piirid määratakse vastavalt vajadusele kaevamisloas",
          "@language": "et"
        },
        {
          "@value": "kaevik ja kaevikuga vahetult piirnev maa-ala, kus hoitakse kaevetööks vajalike materjale, sõidukeid, masinaid, mehhanisme ja seadmeid.",
          "@language": "et"
        },
        {
          "@value": "kaevik ja sellega vahetult piirnev lähiala",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
