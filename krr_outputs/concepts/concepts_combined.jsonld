    {
      "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_jaatmejaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jäätmejaam",
      "skos:definition": "spetsiaalselt rajatud, tehniliselt varustatud jäätmekäitluskoht, kuhu on paigutatud taaskasutatavate jäätmete kogumiseks ja taaskasutustoiminguks kogumismahutid, sh ohtlike jäätmete kogumismahutid; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054824_Par_3"
