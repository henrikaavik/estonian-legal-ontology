        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiakasutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "soojus- või elektrienergia kasutus vaadeldavas korterelamus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
