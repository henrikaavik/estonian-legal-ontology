    {
      "@id": "estleg:Concept_raasiku_vallavalitsuse_raamatupidamise_sise_eeskiri_t1062145_analuutiline_ja_sunteetiline_arvestus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "analüütiline ja sünteetiline arvestus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandusinformatsiooni liigendamise erinevad detailsuse tasemed. Sünteetiline arvestus on majandusinformatsiooni kirjendamine raamatupidamiskontodele. Analüütiline arvestus on raamatupidamiskontodele kirjendatud majandusinformatsiooni detailiseerimine (nõuded ja kohustused reskontrotes - kelle vastu jms)",
        "@language": "et"
      },
      "estleg:definedIn": [
