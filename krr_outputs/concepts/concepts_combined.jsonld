      }
    },
    {
      "@id": "estleg:Concept_mustvee_valla_ametiasutuse_palgajuhend_t1054711_muutuvpalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muutuvpalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054711_Par_2"
        }
