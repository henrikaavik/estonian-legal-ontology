          "@id": "estleg:Concept_heakorraeeskiri_ja_koormise_kehtestamine_t1012077_kinnistu_kasutaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kinnistu kasutaja",
      "skos:definition": [
        {
          "@value": "juriidilisest või füüsilisest isikust kinnisasja omanik, hoonestusõiguse omanik või korteriühistu olemasolu korral ühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorra nõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest",
          "@language": "et"
        },
        {
          "@value": "juriidiline või füüsiline isik, kelle omandis või valduses on kinnisasi, sh kinnistu omanik, hoonestusõiguse omanik või korteriühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorra nõuete täitmine tuleneb omaniku ja muu isiku vahelisest kasutuskokkuleppest",
          "@language": "et"
        },
        {
          "@value": "juriidilisest või füüsilisest isikust kinnisasja omanik, hoonestusõiguse omanik või korteriühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorra nõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest",
          "@language": "et"
        },
        {
          "@value": "kinnisasja juriidilisest või füüsilisest isikust omanik, hoonestusõiguse omanik või korteriühistu olemasolu korral ühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorranõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
