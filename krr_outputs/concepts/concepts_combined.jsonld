      "@id": "estleg:Concept_kuusalu_valla_heakorra_eeskiri_t1012575_Kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kinnistu",
      "skos:definition": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maapinna piiritletud osa ehk maatükk) või hoonestusõigus; kinnistu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: maa-ala, territoorium, krunt, maaüksus ja katastriüksus. 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1012575_Par_2"
        }
      ],
      "estleg:sourceAct": "Kuusalu valla heakorra eeskiri",
