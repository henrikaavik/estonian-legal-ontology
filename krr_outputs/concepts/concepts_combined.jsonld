      }
    },
    {
      "@id": "estleg:Concept_haljastuse_inventeerimise_kord_t1049755_puuderuhm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puuderühm",
