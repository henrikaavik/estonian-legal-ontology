    {
      "@id": "estleg:Concept_otepaa_valla_kaevetoode_eeskiri_t1023645_Kaevetoo_tegija",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kaevetöö tegija",
      "skos:definition": "(edaspidi kaevaja) juriidiline või füüsiline isik, kes on vormistanud enda nimele kaeveloa ja kes teeb kaevetööd. Isik, kes teostab kaevetööd, millega kaasneb ehitamine ehitusseaduse mõistes, peab omama registreeringut majandustegevuse registris vastava tegevusala kohta. 3 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1023645_Par_2"
        }
      ],
