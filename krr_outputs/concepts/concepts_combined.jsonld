      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhendustoru"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saue_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_eeski_t1036784_uhetaolised_liitujad",
