    {
      "@id": "estleg:Concept_kuusalu_vallavalitsuse_palgajuhend_t1051697_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "teenistuja",
      "skos:definition": "vastavalt avaliku teenistuse seaduse § 5 alusel on avalik teenistuja asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja (s.o. töölepingu alusel töötav); 2",
