      "rdfs:label": "jäätmeleping",
      "skos:definition": [
        {
          "@value": "dokument, millega isikud reguleerivad omavahelisi suhteid jäätmete kogumiseks ja üleandmiseks veoteenuse osutajale või teistele vastavate jäätmete vastuvõtu õigust omavatele isikutele",
          "@language": "et"
        }
      ],
