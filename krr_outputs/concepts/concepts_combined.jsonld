          "@id": "estleg:Concept_raie_ja_hooldusloikusloa_andmise_kord_t1059300_avalik_ala"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "avalik ala",
      "skos:definition": [
        {
          "@value": "koht või keskkond, mis on ligipääsetav kõikidele inimestele (nt linna haljasalad, pargid jne).",
          "@language": "et"
        },
        {
          "@value": "Rae valla omandis või Rae valla omandisse antav ala, mis on igaühele kasutamiseks mõeldud terviklik ja sidus välisruum, mis koosneb tänavatest, kergliiklusteedest ning nendega seotud teenustest, külaplatsidest ja väljakutest, rohe- ja pargialadest, mänguväljakutest ning muudest samalaadsetest paikadest",
          "@language": "et"
        },
        {
          "@value": "Tallinna linna omandis olev igaühele vabalt ligipääsetav ja kasutatav maa-ala",
          "@language": "et"
        },
        {
          "@value": "Viimsi vallale kuuluv kõigile vabalt ligipääsetav ja kasutatav maa-ala",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
