    {
      "@id": "estleg:Concept_uhing",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Ühing",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sillamae_linna_eelarvest_kultuuri_haridus_spordi_ja_noorsoov_t1063287_uhing"
        },
        {
          "@id": "estleg:Concept_viimsi_valla_kultuuritooga_tegelevate_mittetulundusuhingute__t1057733_Uhing"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Ühing",
      "skos:altLabel": [
        {
          "@value": "ühing",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kultuuritöö korraldamiseks moodustatud mittetulundusühing, kes ei ole kohaliku omavalitsuse, riigiasutuse või avalik-õigusliku institutsiooni valitseva mõju all (edaspidi ka ühing). 3 (",
          "@language": "et"
        },
        {
          "@value": "linnas registreeritud ja tegutsev mittetulundusühing, sihtasutus, mille eesmärgiks on kultuuri-, hariduse-, spordi- ja noorsootööalase tegevuse ning ürituste korraldamine; 2",
          "@language": "et"
        }
      ]
