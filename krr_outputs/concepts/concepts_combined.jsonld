    {
      "@id": "estleg:Concept_haljala_valla_koerte_ja_kasside_pidamise_eeskiri_t1044268_loomapidaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "loomapidaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle omandis või valduses on koer või kass või kes peab koera või kassi kokkuleppel omanikuga rendi- või muu lepingulise suhte alusel. Juriidilisest isikust loomapidaja on kohustatud määrama koera või kassi heaolu eest vastutava isiku. Loom loetakse kuuluvaks isikule, kelle valduses, sealhulgas kelle piiratud territooriumil või kellele kuuluvas ehitises loom asub, kui looma kuuluvusest huvitatud isik ei tõenda vastupidist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044268_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala valla koerte ja kasside pidamise eeskiri",
      "rdfs:label": "loomapidaja (haljala_valla_koerte_ja_kasside_pidamise_eeskiri_t1044268)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_loomapidaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_valla_koerte_ja_kasside_pidamise_eeskiri_t1044268_hulkuv_loom",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hulkuv loom",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "loomapidaja juurest lahti pääsenud loom, kes viibib omaniku või looma eest vastutava isiku juuresolekuta väljaspool loomapidajale kuuluvat või tema kasutuses olevat territooriumi või identifitseerimata loom, kelle omanikku ei ole võimalik tuvastada",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044268_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala valla koerte ja kasside pidamise eeskiri",
