      "skos:altLabel": [
        {
          "@value": "Kaitsetarve",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "andmete ja teabe omadus, mis väljendab vajadust kaitsta teda kahju eest, mille võib tekitada konfidentsiaalsuse, tervikluse ja/või käideldavuse rikkumine; 10",
          "@language": "et"
        },
        {
          "@value": "hinnang infovara või sihtobjekti vajaliku kaitse tasemele konfidentsiaalsuse, tervikluse ja käideldavuse aspektist (normaalne, suur, väga suur) vastavalt E-ITS rakendusjuhendile; 15",
          "@language": "et"
        },
        {
          "@value": "näitab, milline kaitse on äriprotsessile, selles töödeldavale informatsioonile ja rakendatavale infotehnoloogiale piisav ja sobiv. 5 (",
          "@language": "et"
        },
        {
          "@value": "vara väärtusest tulenev vajadus seda kaitsta. Kaitsetarve on andmete ja teabe vajadus kaitsta neid kahju eest, mille võib tekitada konfidentsiaalsuse, tervikluse või käideldavuse või kõigi kolme rikkumine; 12",
          "@language": "et"
        }
      ]
    },
