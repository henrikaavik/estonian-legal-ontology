      ],
      "skos:prefLabel": {
        "@value": "Ühisvoolne kanalisatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rajatiste kogum reovee ning sademe- ja drenaaživee ning muu pinnase- ja pinnavee juhtimiseks ühte ja samasse ühiskanalisatsiooni torustikku.",
