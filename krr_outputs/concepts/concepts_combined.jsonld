    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_lisatasu_uletunnitoo_eest",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lisatasu ületunnitöö eest",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ületundide tegemise eest makstav lisatasu. Ületundide arvestamise alused ja kord on kehtestatud asutuse sisekorraeeskirjades",
        "@language": "et"
      },
      "estleg:definedIn": [
