      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_valla_heakorraeeskiri_t1044267_illegaalne_graffiti",
      "@type": [
        "owl:NamedIndividual",
