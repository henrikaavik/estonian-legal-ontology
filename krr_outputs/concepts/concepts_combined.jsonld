      },
      "skos:definition": {
        "@value": "tasu puuduva teenistuja ülesannete täitmise eest, kui asendamine ei ole ette nähtud teenistuja ametijuhendis või tingib võrreldes ametijuhendis määratuga töökoormuse olulise suurenemise",
        "@language": "et"
      },
