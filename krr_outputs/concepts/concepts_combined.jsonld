        {
          "@value": "kuluarvestuse metoodika ( activity based costing – ABC), mis põhineb põhjuslikul seosel kiirabi osutamiseks vajalike ressursside (edaspidi ressurss ) vahel",
          "@language": "et"
        }
      ],
