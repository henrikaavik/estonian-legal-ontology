          "@id": "estleg:Concept_vaike_maarja_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055415_Konsolideerimine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "10",
        "@type": "xsd:integer"
      },
      "rdfs:label": "konsolideerimine",
      "skos:altLabel": [
        {
          "@value": "Konsolideerimine",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "erinevate üksuste raamatupidamisaruannete koondamine üheks koondaruandeks. Konsolideerimise käigus elimineeritakse konsolideerimisgruppi kuuluvate üksuste omavahelised tehingud; 12",
          "@language": "et"
        },
        {
          "@value": "gruppi kuuluvate üksuste omavaheliste tehingute elimineerimine ja erinevate üksuste raamatupidamisaruannete koondamine üheks koondaruandeks; 9",
          "@language": "et"
        },
        {
          "@value": "konsolideerimisgruppi kuuluvate raamatupidamisüksuste aruannete ühendamine (finantsnäitajate liitmine rida-realt) nii, nagu oleks tegemist ühe raamatupidamiskohustuslasega. 8 (",
          "@language": "et"
        },
        {
          "@value": "raamatupidamisüksuste aruannete ühendamine nii nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega elimineeritakse konsolideerimisgruppi kuuluvate isikute omavahelised tehingud. 8 (",
          "@language": "et"
        },
        {
          "@value": "raamatupidamisüksuste aruannete ühendamine nii nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega kaasneb konsolideerimisgruppi kuuluvate isikute omavaheliste vastandtehingute (tulud-kulud, nõuded-kohustised) liitmine nii, et grupi aruandes neid ei esine; 7",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "10",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_konsolideeritav_uksus",
