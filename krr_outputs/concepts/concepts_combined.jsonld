      },
      "skos:definition": {
        "@value": "isik, kes on linnavalitsusega avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud linnavalitsuses ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
