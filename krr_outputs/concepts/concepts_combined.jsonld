    {
      "@id": "estleg:Concept_sporditegevuse_toetamise_kord_johvi_vallas_t1054762_spordiklubi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "spordiklubi",
      "skos:definition": "Jõhvi valla haldusterritooriumil registreeritud ja vähemalt ühe aasta tegutsenud eraõiguslik juriidiline isik, mille põhitegevuseks on spordi arendamine ning kus treeningtegevus toimub vähemalt 11 kuul aastas vähemalt 3 korda nädalas; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054762_Par_2"
        }
      ],
      "estleg:sourceAct": "Sporditegevuse toetamise kord Jõhvi vallas",
