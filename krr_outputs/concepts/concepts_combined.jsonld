        },
        {
          "@id": "estleg:Concept_nouded_energiamargise_andmisele_ja_energiamargisele_t1029420_energiakasutus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiakasutus",
      "skos:definition": [
        {
          "@value": "soojus- või elektrienergia kasutus vaadeldavas korterelamus",
          "@language": "et"
        },
        {
          "@value": "elektri- või soojusenergia kasutus vaadeldavas süsteemipunktis. Energiakasutus arvutatakse netoenergiavajadusest, võttes arvesse süsteemikaod ja kaod energia muundamisel. Tehnosüsteemi lõpp-punktis (üldjuhul liitumispunkt energiavõrguga) võrdub tehnosüsteemi energiakasutus tarnitud energia ja lokaalse taastuvenergia summaga",
          "@language": "et"
        },
        {
          "@value": "jäätmete energiakasutus jäätmeseaduse mõistes",
          "@language": "et"
        },
        {
          "@value": "soojus- või elektrienergia kasutus korterelamus",
          "@language": "et"
        },
        {
          "@value": "soojus- või elektrienergia kasutus vaadeldavas süsteemipunktis",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
