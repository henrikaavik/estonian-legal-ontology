        "@id": "estleg:Concept_turvaintsident"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_turvameetmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "turvameetmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "organisatoorsed toimingud ja vahendid, tehnilised protsessid ja tehniliste vahendite rakendamine andmete ja infosüsteemide turvalisuse saavutamiseks ja säilitamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna infoturbepoliitika",
