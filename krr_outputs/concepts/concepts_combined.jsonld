      },
      "skos:definition": {
        "@value": "toetuse saaja või partneri rahaline või rahaliselt mõõdetav panus projekti. Omafinantseeringu hulka arvatakse ainult toetuse saaja või partneri tehtavad abikõlblikud kulud. Omafinantseeringut toetuse hulka ei arvata, samuti ei saa toetust kasutada omafinantseeringuks.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
