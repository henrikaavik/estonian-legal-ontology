      "skos:definition": [
        {
          "@value": "aine, mis võib põhjustada saastatust või mille esinemisega vees võib kaasneda keskkonnahäiring. 16",
          "@language": "et"
        },
        {
          "@value": "mis tahes aine, mis võib põhjustada reostust; 21",
          "@language": "et"
        }
      ],
