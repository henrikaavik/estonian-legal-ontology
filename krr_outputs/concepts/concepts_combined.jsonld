      "estleg:definitionCount": {
        "@value": "19",
        "@type": "xsd:integer"
      },
      "rdfs:label": "müügikoht",
      "skos:definition": [
        {
          "@value": "koht, kus kaupleja vahetult pakub ja müüb kaupa või pakub ja osutab teenust",
          "@language": "et"
        },
        {
          "@value": "kavandatava kauba müügiks sobiv koht, kus kaupleja vahetult pakub ja müüb kaupa või pakub ja osutab teenust",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse kirjalikult kooskõlastatud asukohas kauba või teenuse müügiks sobiv koht, kus kaupleja vahetult müüb kaupa või pakub ja osutab teenust",
          "@language": "et"
        },
        {
          "@value": "koht, kus kaupleja vahetult pakub ja müüb kaupa või pakub ja osutab teenust. Üks müügikoht käesoleva korra mõistes on suuruses 3 m 2",
          "@language": "et"
        },
        {
          "@value": "koht, kus kaupleja vahetult pakub ja müüb kaupa või pakub ja/või osutab teenust (sh välikohvik)",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
