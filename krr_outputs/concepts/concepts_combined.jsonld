    {
      "@id": "estleg:Concept_jarva_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1055623_omapuhasti_ehk_kohtpuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti ehk kohtpuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid olmereoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti. Siia alla kuuluvad nii septikud kui biopuhastid koos puhastatud reovee suublasse juhtimisega. Omapuhasti koosneb mahutist, millele järgneb suubla",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055623_Par_2"
        }
      ],
      "estleg:sourceAct": "Järva valla reovee kohtkäitluse ja äraveo eeskiri",
