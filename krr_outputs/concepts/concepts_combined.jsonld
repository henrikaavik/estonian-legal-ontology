        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "abikõlblik kulu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_projektides_osalemise_kord_t1038063_abikolblik_kulu"
