      },
      "rdfs:label": "Riistvara",
      "skos:definition": [
        {
          "@value": "arvutit või arvutisüsteemi moodustavate seadmete kogum",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
