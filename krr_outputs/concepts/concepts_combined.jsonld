      "skos:definition": [
        {
          "@value": "sõidukite parkimiseks ettenähtud ehituslikult või liikluskorralduslikult kujundatud ala, mille moodustavad parkimiskohad ja neid ühendavad teeosad. Parklaks ei loeta sõidutee laiendit või jalgteed, mis on tähistatud parkimist korraldava liikluskorraldusvahendiga",
          "@language": "et"
        },
        {
          "@value": "sõidukite parkimiseks ette nähtud ehituslikult või liikluskorralduslikult kujundatud ala, mille moodustavad parkimiskohad ja neid ühendavad teeosad. Parklaks ei loeta sõidutee laiendit või jalgteed, mis on tähistatud parkimist korraldava liikluskorraldusvahendiga",
