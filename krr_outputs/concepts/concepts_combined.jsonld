      ],
      "skos:prefLabel": {
        "@value": "biolagunevad jäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "aia- ja haljastujäätmed (nt rohi, lehed, oksad) ning biolagundatavad köögi- ja sööklajäätmed (kodumajapidamises, jaemüügikohas ja toitlustusasutuses tekkinud)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056868_Par_3"
        }
      ],
      "estleg:sourceAct": "Narva linna jäätmehoolduseeskiri",
