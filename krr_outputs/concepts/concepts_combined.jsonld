      }
    },
    {
      "@id": "estleg:Concept_reklaami_ja_teabe_paigaldamise_kord_t1002806_reklaami_avalikustaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaami avalikustaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline- või juriidiline isik või riigi- või kohaliku omavalitsuse asutus, kes reklaami avalikult esitab, edastab, näitab või levitab",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
