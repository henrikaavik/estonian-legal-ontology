    {
      "@id": "estleg:Concept_korterelamu_katusekatte_vahetamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Korterelamu katusekatte vahetamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Korterelamu_katusekatte_vahetamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Korterelamu katusekatte vahetamine",
      "skos:definition": [
        {
          "@value": "olemasoleva amortiseerunud või asbesti sisaldava katusekatte asendamine katusekivi, profiilpleki, bituumensindli, bituumenplaadi, rullmaterjali, laastude, roo või tsementkiudplaatidega (v.a asbesti sisaldav eterniit, ruberoid ja PVC laineplaat), pööningu põranda ja katuslagede soojustamine, vihmaveerennide terviklahenduse paigaldamine, kütte- või ventilatsioonikorstnate remontimine, korstnamütsi paigaldamine",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamu_liftisusteemi_uuendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Korterelamu liftisüsteemi uuendamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Korterelamu_liftisusteemi_uuendamine"
        }
      ],
