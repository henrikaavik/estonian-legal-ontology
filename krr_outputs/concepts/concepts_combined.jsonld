      "rdfs:label": "lokaalne taastuvenergia",
      "skos:definition": [
        {
          "@value": "ehitusseadustiku § 65 lõike 3 alusel kehtestatud nõuetele vastav energia, mida kasutatakse eelkõige hoone toimimiseks või kasutamiseks; 6",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 65 lõike 3 alusel kehtestatud nõuetele vastav energia, mida kasutatakse eelkõige hoone toimimiseks või kasutamiseks; 5",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 65 lõike 3 alusel kehtestatud nõuetele vastav energia, mida kasutatakse eelkõige hoone toimimiseks või kasutamiseks; 7 7<sup>1</sup>) muinsus- ja miljööväärtuslik korterelamu – üld- või detailplaneeringu alusel miljööväärtuslikule hoonestusalale jääv, väärtusliku üksikobjektina määratletud, kultuurimälestiseks tunnistatud, muinsuskaitsealal asuv või UNESCO maailmapärandi nimekirja kantud alal asuv korterelamu; RT I 2024-09-24 1 124092024001 2024-09-27 8",
          "@language": "et"
        },
        {
          "@value": "hoones, kinnistul või hoone lähiümbruses päikese-, välisõhu-, vee-, pinnase- või tuuleenergiast toodetud elekter või soojusenergia. Soojuspumbal võetakse arvesse soojustegurit; RT I 2024-11-15 2 115112024002 2025-06-01 ; jõustumine muudetud [RT I, 19.02.2025, 1] 4",
          "@language": "et"
        },
        {
          "@value": "hoones, kinnistul või hoone lähiümbruses päikese-, välisõhu-, vee-, pinnase- või tuuleenergiast toodetud elekter või soojusenergia; RT I 2024-11-15 2 115112024002 2025-06-01 ; jõustumine muudetud [RT I, 19.02.2025, 1] 12",
          "@language": "et"
        }
      ]
    },
