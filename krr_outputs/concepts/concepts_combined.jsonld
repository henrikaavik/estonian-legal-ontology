      "skos:definition": [
        {
          "@value": "vallavalitsuse poolt väljastatav luba reklaami paigaldamiseks selles kindlaks määratud kohas, ajal, kujul ja viisil",
          "@language": "et"
        },
        {
          "@value": "Harku Vallavalitsuse planeerimis- ja ehitusosakonna (edaspidi nimetatud ka PEO) poolt käesolevas määruses sätestatud tingimustel väljastatud luba, mille alusel reklaami avalikustaja võib paigaldada paigaldusloa taotluses näidatud reklaami",
          "@language": "et"
        },
        {
          "@value": "Harku Vallavalitsuse planeerimis- ja ehitusosakonna (edaspidi nimetatud ka PEO) poolt käesolevas määruses sätestatud tingimustel väljastatud luba, mille alusel reklaami avalikustaja võib paigaldada paigaldusloa taotluses näidatud reklaami",
          "@language": "et"
        },
        {
          "@value": "Kohila Vallavalitsuse korrakaitsespetsialisti poolt antud luba, mis võimaldab paigaldada reklaami määruses sätestatud tingimustel",
          "@language": "et"
        },
        {
          "@value": "luba, mis annab õiguse reklaami ja/või reklaamikandja paigaldamiseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
