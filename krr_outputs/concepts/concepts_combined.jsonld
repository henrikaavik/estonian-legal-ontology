      "skos:definition": [
        {
          "@value": "ajavahemik lindude pesitsemise ajal, millal puu raiumist võib mitte lubada; 6",
          "@language": "et"
        },
        {
          "@value": "ajavahemik lindude pesitsemise ja puude aktiivse vegetatsiooni ajal, millal puu raiumist võib mitte lubada (aprillist kuni juuli lõpuni).",
          "@language": "et"
        },
        {
          "@value": "ajavahemik lindude pesitsemise ja puude aktiivse vegetatsiooni ajal, millal puu raiumist võib mitte lubada (aprillist kuni juuli lõpuni); 7",
          "@language": "et"
