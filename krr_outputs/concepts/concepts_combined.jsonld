      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_tugitegevus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_pohitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "põhitegevus",
      "skos:definition": "kompetentsikeskuse väljaarendamisele otseselt suunatud tegevus või tegevuste kogum, mis omab selget valdkondlikku piiritletust ja mida finantseeritakse käesoleva meetme raames; 11",
