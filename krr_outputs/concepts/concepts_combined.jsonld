    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_varundamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "varundamine",
      "skos:definition": "andmete kopeerimine, mis tähendab nende salvestamist algsest asukohast erinevasse asukohta; 7",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
