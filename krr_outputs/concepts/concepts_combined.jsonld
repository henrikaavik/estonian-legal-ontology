      "estleg:definesConcept": {
        "@id": "estleg:Concept_kaupleja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1051973_kaubanduse_korraldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaubanduse korraldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Jõhvi Vallavalitsus ametiasutusena (edaspidi vallavalitsus), ametiasutuse hallatav asutus, avaliku ürituse korraldaja või maa-ala valdaja või omanik",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051973_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
