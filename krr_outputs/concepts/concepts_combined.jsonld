      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "treener",
      "skos:definition": "sportlasi ja teisi spordis osalevaid isikuid juhendav spordispetsialist, kellel on treeneri kutsekvalifikatsioon kutseseaduse tähenduses või tunnustatud kutsekvalifikatsioon välisriigi kutsekvalifikatsiooni tunnustamise seaduse tähenduses. Treeneril, kes juhendab noori vanuses 6–21 aastat, peab olema vähemalt treeneri kutsekvalifikatsiooni 4. tase; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054762_Par_2"
        }
      ],
      "estleg:sourceAct": "Sporditegevuse toetamise kord Jõhvi vallas",
