      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lõppsaaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik või asutus, kellele vahendusasutus annab toetust vastavalt toetuse andmise tingimuste määruse alusel kehtestatud taotluse rahuldamise otsusele või rahastamislepingule",
        "@language": "et"
      },
      "estleg:definedIn": [
