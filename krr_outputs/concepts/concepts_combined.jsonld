      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kose_valla_ametiasutuse_palgajuhend_t1053626_asendustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "asendustasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puuduva teenistuja ülesannete täitmise eest määratav ja makstav lisatasu. See määratakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, kui asendamine ei ole ette nähtud teenistuja ametijuhendis; 2024-02-22",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053626_Par_2"
        }
      ],
      "estleg:sourceAct": "Kose valla ametiasutuse palgajuhend",
      "rdfs:label": "asendustasu (kose_valla_ametiasutuse_palgajuhend_t1053626)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_asendustasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
