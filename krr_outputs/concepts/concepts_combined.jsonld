      ],
      "skos:prefLabel": {
        "@value": "perioodipilet",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "e-pileti süsteemi kaudu ostetud sõidupilet (kuukaart), mis annab sõitjale õiguse kasutada ühistranspordi teenust määratud aja jooksul piiramatu arv kordi",
