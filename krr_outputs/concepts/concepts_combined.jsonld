        {
          "@value": "reovee kogumine, puhastamine, immutamine pinnasesse või pinnasele või kompostimine üldjuhul reovee tekkekoha kinnistu piires",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine, puhastamine, pinnasesse immutamine, suublasse juhtimine või taaskasutamine, sealhulgas kompostimine, üldjuhul reovee tekkekoha kinnistu piires",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine kogumismahutisse või puhastamine omapuhastis, sh heitvee immutamine või juhtimine suublasse",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine kogumismahutisse, äravedu kogumismahutist ja purgimine ühiskanalisatsiooni või reovee puhastamine omapuhastis",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine, vajadusel puhastamine, immutamine pinnasesse, kompostimine, üldjuhul reovee tekkekoha kinnistu piires",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
