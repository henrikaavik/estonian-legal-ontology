      ],
      "skos:prefLabel": {
        "@value": "eelarve vastutav täitja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratud isik või isikud, kellele on antud õigus käsutada vallaeelarve vahendeid kinnitatud eelarve piires ja struktuuris, millist õigust teostab vastutav isik kulude aktsepteerimisega valla eelarveklassifikaatorite liigenduses.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060946_Par_2"
        }
      ],
