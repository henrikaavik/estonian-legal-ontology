      },
      "rdfs:label": "Kuludokument",
      "skos:definition": [
        {
          "@value": "kauba- või teenusepakkuja esitatud arve kauba müügi või teenuse osutamis eest. Kuludokument peab sisaldama dokumendi nimetust ja numbrit, koostamise kuupäeva, tehingu majandusliku sisu (kauba või teenuse nimetus), tehingu arvnäitajad (kogus, hind, summa), tehingu osapoolte nimed ja asu-või elukoha aadressid",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
