      "rdfs:label": "energiatõhususe tööd",
      "skos:definition": [
        {
          "@value": "olemasoleva hoone energiatõhusust parandavad, kasvuhoonegaaside heidet vähendavad, hoonesse tarnitud energiat ja hoone ülalpidamiskulusid vähendavad ning taastuvenergia kasutust edendavad rekonstrueerimis- ja ehitustööd. RT I 2022-09-29 2 129092022002 2022-10-02",
          "@language": "et"
        },
        {
          "@value": "olemasoleva hoone energiatõhusust parandavad, kasvuhoonegaaside heidet vähendavad, hoonesse tarnitud energiat ja hoone ülalpidamiskulusid vähendavad ning taastuvenergia kasutust edendavad rekonstrueerimis- ja ehitustööd; 3",
