      }
    },
    {
      "@id": "estleg:Concept_vaike_maarja_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051019_immutussusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "immutussüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "heitvee immutussüsteem järgneb tavaliselt septikule. Immutussüsteem koosneb aukudega heitvee immutustorustikust, mis on paigaldatud immutusväljakule teatud kindlate vahedega. Immutusväljak rajatakse tavapäraselt koredast pinnasest (kruus, killustik), et tagada pinnaseosakestel bioloogilistele organismidele elutingimused ja selle tulemusel parem heitvee puhastusvõime",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051019_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "immutussüsteem (vaike_maarja_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051019)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_immutussusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
