    {
      "@id": "estleg:Concept_ehitise_kasutamise_otstarve",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Ehitise kasutamise otstarve",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_detailplaneeringu_algatamise_taotluse_vorm_ning_detailplanee_t1043425_Ehitise_kasutamise_otstarve"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Ehitise kasutamise otstarve",
      "skos:definition": [
        {
          "@value": "kasutatakse/tähistatakse vastavalt majandus- ja taristuministri 02.06.2015 määrusega nr 51 kehtestatud „Ehitise kasutamise otstarvete loetelu“ lisas esitatud loetelule kasutamise otstarbe nimetusega.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_ehitise_korgus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Ehitise kõrgus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_joelahtme_valla_ehitusmaarus_t1027827_ehitise_korgus"
        },
        {
          "@id": "estleg:Concept_detailplaneeringu_algatamise_taotluse_vorm_ning_detailplanee_t1043425_Ehitise_korgus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Ehitise kõrgus",
      "skos:altLabel": [
        {
          "@value": "ehitise kõrgus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ehitise suurim vertikaalmõõde ehitist vahetult ümbritsevast maapinnast või katendist ehitise kõrgeima tarindi kõrgeima punktini, võtmata arvesse kohalikke väiksemaid süvendeid ja kõrgendusi",
          "@language": "et"
        },
        {
          "@value": "ehitist vahetult ümbritseva olemasoleva maapinna minimaalse ja maksimaalse kõrguse aritmeetilise keskmise ja ehitise katuseharja või parapeti kõrguste vahe. Ehitisel paiknevat tehnoseadet ja -süsteemi ning selle osa, sealhulgas korsten ja antenn ning välireklaami ja muud taolist ehitise kõrguse hulka üldjuhul ei arvestata",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_ehitise_laiendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
