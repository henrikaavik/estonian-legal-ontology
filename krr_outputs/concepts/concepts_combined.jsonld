    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Operaatorteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Operaatorteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenus, mille eesmärgiks on korraldada sotsiaaltranspordi tellinud isikute transport soovitud sihtkohta nõuetekohasel viisil ja tingimustel tagades veoteenust osutavate sõidukite maksimaalselt efektiivse kasutuskoormuse.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltransporditeenuse osutamise juhend",
      "rdfs:label": "Operaatorteenus (sotsiaaltransporditeenuse_osutamise_juhend_t1018233)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_operaatorteenus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Operaatorteenuse_osutaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Operaatorteenuse osutaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Vinni Vallavalitsuse või tema volitatud esindajaga vastava teenuse osutamise lepingu sõlminud isik, kelle ülesandeks on sotsiaaltranspordi korraldamine vastavalt § 5.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltransporditeenuse osutamise juhend",
      "rdfs:label": "Operaatorteenuse osutaja (sotsiaaltransporditeenuse_osutamise_juhend_t1018233)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_operaatorteenuse_osutaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Otsereisivahemaa",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Otsereisivahemaa",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vahemaa, mille teenindav sõiduk oleks pidanud läbima kliendi vedamiseks lähtekohast sihtkohta juhul, kui reis ei oleks olnud teiste reisidega kokku planeeritud.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltransporditeenuse osutamise juhend",
      "rdfs:label": "Otsereisivahemaa (sotsiaaltransporditeenuse_osutamise_juhend_t1018233)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_otsereisivahemaa"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Reis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenindava sõiduki liikumise teekond alates esimese reisija pealevõtmisest kuni viimase reisija mahapanekuni.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltransporditeenuse osutamise juhend",
