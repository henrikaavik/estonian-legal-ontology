        "@id": "estleg:Concept_avalik_ruum"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_valla_heakorra_ja_kaevetoode_eeskiri_t1059297_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi, hoonestusõigus, korteriomand. Kinnistuga on eeskirjas võrdsustatud ka kinnistamata maaüksus, mille suhtes isikul on kasutusõigus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059297_Par_2"
        }
      ],
      "estleg:sourceAct": "Vormsi valla heakorra ja kaevetööde eeskiri",
      "rdfs:label": "kinnistu (vormsi_valla_heakorra_ja_kaevetoode_eeskiri_t1059297)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_valla_heakorra_ja_kaevetoode_eeskiri_t1059297_kaevetoo",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaevetöö",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pinnasetöö, mida tehakse sügavamal kui 30 cm maapinnast, samuti töö, mille käigus rikutakse tee-või pinnakatet (asfalt, sillutis, muru jne).",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059297_Par_2"
        }
      ],
      "estleg:sourceAct": "Vormsi valla heakorra ja kaevetööde eeskiri",
