    {
      "@id": "estleg:Concept_viljandi_valla_finantsjuhtimise_kord_t1028098_soltuv_uksus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sõltuv üksus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallavalitsuse otsese või kaudse valitseva mõju all olev üksus, kes on saanud vallavalitsuselt, riigilt, muult avalik-õiguslikult juriidiliselt isikult või eelnimetatud üksuste valitseva mõju all olevatelt üksustelt üle poole tuludest, või kes on saanud toetust või renditulu vallavalitsuselt või vallavalitsuse valitseva mõju all olevatelt üksustelt rohkem kui 10 % vastava aasta põhitegevuse tuludest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028098_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi valla finantsjuhtimise kord",
      "rdfs:label": "sõltuv üksus (viljandi_valla_finantsjuhtimise_kord_t1028098)",
