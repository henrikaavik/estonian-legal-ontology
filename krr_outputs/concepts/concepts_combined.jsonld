      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_harku_vallavalitsuse_teenistujate_koolituste_ja_arengu_toeta_t1062138_oppereis"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "õppereis",
      "skos:definition": [
        {
          "@value": "õpisündmus, mille raames toimub tutvumine teenistuja teenistusülesannetele analoogse töö või asutustega Eestis või väljaspool Eestit. Ressursimahukas koolitus on koolitus, mis kestab kalendriaasta jooksul kokku kauem kui 90 kalendripäeva ja selle vältel teenistuja koolitusele kuluv aeg moodustab olulise osa tema tööajast või ületavad asutuse tasutud koolituse maksumus ja koolitusega seonduvad muud kulud vähemalt viis korda (riikliku) kuu töötasu alammäära. Ressursimahuka koolituse leping – leping, mis sõlmitakse asutuse ja teenistuja vahel käesoleva paragrahvi lõikes 3 nimetatud ressursimahuka koolituse korral ja kus määratakse teenistuja kohustus töötada pärast koolituse lõppu asutuses kindlaksmääratud aja jooksul, kuid mitte kauem kui kolm aastat.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
