    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_maastikuarhitektuurne_projekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "maastikuarhitektuurne projekt",
      "skos:definition": "terviklik planeerimis- ja kujunduslahendus, mille eesmärk on arendada väliruume, võttes arvesse esteetilisi, funktsionaalseid, ökoloogilisi ja kultuurilisi aspekte. Lahendus hõlmab nii looduslike elementide (vesi, taimestik, pinnavormid) kui ka kunstlike elementide (rajatised, teed, platsid) koostoime planeerimist ning ala terviklikkuse säilitamist. Maastikuarhitektuurne projekt võib sisaldada eriosasid, näiteks haljastusprojekti või looduslähedase sademeveesüsteemi projekti; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "maastikuarhitektuurne projekt (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
