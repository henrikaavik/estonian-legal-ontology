      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teenistuskoer",
      "skos:definition": [
        {
          "@value": "koer, kes on saanud erialase koolituse vastavalt koerajuhtide põhikursuse õppele ja omab vastavat kvalifikatsiooni ja keda kasutatakse politseis, piirivalves, päästeteenistuses või pimeda juhtkoerana; 5",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_teenistuskoht"
        }
      ]
    },
