      },
      "rdfs:label": "turvaalased kohustused",
      "skos:definition": [
        {
          "@value": "kõik turvalisusega seotud teenistusülesanded ja kohustused laevadel, nagu on määratletud 1974. aasta rahvusvahelises konventsioonis inimelude ohutusest merel ning selle ajakohastatud XI-2 peatükis ning laevade ja sadamarajatiste rahvusvahelise turvalisuse (ISPS) koodeksis",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
