      "rdfs:label": "peatoru",
      "skos:altLabel": [
        {
          "@value": "Peatoru",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ÜVK torustik, mille kaudu toimub kinnistute veega varustamine või kinnistutelt reovee ärajuhtimine; 20",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub kinnistute veega varustamine või kinnistutelt reo- ning sademevee ärajuhtimine; 15",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub kinnistute veega varustamine või kinnistutelt reo- ning sademevee ärajuhtimine; 21",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub tarbimiskoha veega varustamine või tarbimiskohalt reo- ning sademevee ärajuhtimine. 15",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub tarbimiskoha veega varustamine või tarbimiskohalt reovee ärajuhtimine. 19",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "39",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_peatorustik",
