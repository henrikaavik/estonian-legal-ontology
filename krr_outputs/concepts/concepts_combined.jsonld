      "rdfs:label": "taotlus",
      "skos:definition": [
        {
          "@value": "toetuse taotlemise avaldus ja sellele lisatud dokumendid. Taotluse vormi kinnitab keskus; 2020-12-17 RT IV 2020-12-29 43 429122020043 2021-01-01 10",
          "@language": "et"
        },
        {
          "@value": "vormikohane kirjalik avaldus ja sellele lisatud dokumendid toetuse taotlemiseks.",
          "@language": "et"
        },
        {
          "@value": "Rahandusministeeriumile toetuse saamiseks esitatav taotlusvorm koos lisadega; RT I 2015-08-19 1 119082015001 2015-09-01 5",
          "@language": "et"
        },
        {
          "@value": "taotleja poolt rakendusüksusele esitatav vormikohane avaldus ja sellele lisatud dokumendid toetuse taotlemiseks; 10",
          "@language": "et"
        },
        {
          "@value": "teabekandja paigaldamiseks vajalikud dokumendid; 16",
          "@language": "et"
        }
      ],
