      "estleg:definitionCount": {
        "@value": "21",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toetuse saaja",
      "skos:definition": [
        {
          "@value": "taotleja, kelle taotlus on saanud rahuldamise otsuse ning kes viib ellu määruse alusel toetatavat projekti",
          "@language": "et"
        },
        {
          "@value": "eralastehoid või eralasteaed",
          "@language": "et"
        },
        {
          "@value": "eraõiguslik või avalik-õiguslik juriidiline isik, kes on kinnitanud toetuse kasutamise nõusoleku või kellega strateegiakeskus on sõlminud toetuse kasutamiseks lepingu (edaspidi ka leping )",
          "@language": "et"
        },
        {
          "@value": "ettevõtja, kelle esitatud taotluse on keskus vastavaks tunnistanud; 2020-12-17",
          "@language": "et"
        },
        {
          "@value": "isik või asutus, kelle projekti või tegevust rahastatakse § 6 või 7 alusel ning kes vastutab rahastamislepingus või käskkirjas nimetatud eelarve ulatuses tegevuste ja tulemuste eest",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "20",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_teenuse_saaja"
        }
      ],
