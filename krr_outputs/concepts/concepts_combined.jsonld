    {
      "@id": "estleg:Concept_parnu_linna_eelarvest_kultuuriuhingutele_ning_avatud_kultuur_t1051323_esinduskollektiiv",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "esinduskollektiiv",
      "skos:definition": "kollektiiv, mis kvalifitseerub kultuuriühingute toetusele, kuulub ekspertkomisjoni ettepanekul nimetatud kuni 7 esinduskollektiivi hulka ning vähemalt 50% kollektiivi juhendajatest omavad või omandavad erialast haridust. RT IV 2024-02-22 24 422022024024 2024-02-25 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051323_Par_2"
        }
      ],
      "estleg:sourceAct": "Pärnu linna eelarvest kultuuriühingutele ning avatud kultuurikeskustele tegevustoetuse arvutamise juhend",
      "rdfs:label": "esinduskollektiiv (parnu_linna_eelarvest_kultuuriuhingutele_ning_avatud_kultuur_t1051323)",
      "estleg:definesConcept": {
