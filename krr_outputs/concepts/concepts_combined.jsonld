    {
      "@id": "estleg:Concept_muhu_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeskir_t1019384_uhisveevark",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühisveevärk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitiste, rajatiste ja seadmete kompleks mitme kinnistu veega varustamiseks ning vee kasutamiseks kahjutule tõrjumisel, kui selleks ei ole ette nähtud muid veevõtukohti. Ühisveevärgi ehitiste, rajatiste ja seadmete kompleks on vee-ettevõtja hallatav või teenindab",
        "@language": "et"
      },
      "estleg:definedIn": [
