          "@language": "et"
        },
        {
          "@value": "kaeviku kaevamisel looduslikust olekust eemaldatud mis tahes kivimi või setendi tahke osis; 10",
          "@language": "et"
        },
        {
          "@value": "kaeviku kaevamisel looduslikust olekust eemaldatud mis tahes kivimi või setendi tahke osis; 9",
