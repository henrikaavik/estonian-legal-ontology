      "skos:definition": "valla rahaline panus projektis ettenähtud tegevuste elluviimiseks, mille vald eraldab oma eelarve piires või mida käesoleva määrusega sätestatud korras taotletakse reservfondist või vastavast tegevusalast.",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058228_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi valla projektides osalemise kord",
