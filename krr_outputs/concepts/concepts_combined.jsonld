    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edendamise või isiku käitumise avalikes huvides suunamise eesmärgil; 2) reklaamimaks (edaspidi maks ) – Tallinna linna avalik-õiguslike ülesannete täitmiseks vajaliku tulu saamiseks määruses sätestatud korras maksukohustuslase poolt maksuobjekti osas, suuruses ja tähtaegadel ilma otsese vastutasuta tasumisele kuuluv kohalik maks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Tallinnas",
      "rdfs:label": "reklaam (reklaamimaks_tallinnas_t1011811)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_maksuobjekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "maksuobjekt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaam, mida eksponeeritakse Tallinna linna haldusterritooriumil füüsilise või juriidilise isiku poolt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Tallinnas",
      "rdfs:label": "maksuobjekt (reklaamimaks_tallinnas_t1011811)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_maksuobjekt"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_maksukohustuslane",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "maksukohustuslane",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "välireklaamikandja otsene valdaja või ühistranspordiloa või taksoveoloa omaja; (Tvk m 17.11.2011 nr 36 - jõust. 01.01.2012)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Tallinnas",
      "rdfs:label": "maksukohustuslane (reklaamimaks_tallinnas_t1011811)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_maksukohustuslane"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_tagastusnoue",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tagastusnõue",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "seaduses või haldusaktis ettenähtust suuremas summas tehtud makse ja rahalise kohustuse tasumisel või tasaarvestamisel tekkinud enammakse tagasisaamiseks koostatud kirjalik taotlus, mis esitatakse maksuhaldurile reklaamimaksualase maksudeklaratsiooni (edaspidi maksudeklaratsioon ) paranduses või muus kirjalikus või kirjalikku taasesitamist võimaldavas vormis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Tallinnas",
      "rdfs:label": "tagastusnõue (reklaamimaks_tallinnas_t1011811)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tagastusnoue"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_maksudeklaratsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
