      },
      "rdfs:label": "kaitseala",
      "skos:definition": [
        {
          "@value": "kirjeldus, millega piiritletakse asutuse infoturbe ulatus, arvestades, et kaitseala on Eesti infoturbestandardis (E-ITS) kaitstav äriprotsess ja selle toimimiseks vajalikud infotehnoloogia (IT) varad",
          "@language": "et"
        },
        {
          "@value": "käsitlusala, mille ulatuses koostatakse turbekontseptsioon ja rakendatakse infoturbemeetmed",
