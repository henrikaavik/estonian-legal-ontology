        "@id": "estleg:Concept_valimiskampaania_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_valla_uhiskondlikuks_objektiks_olev_reklaamikandja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valla ühiskondlikuks objektiks olev reklaamikandja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallale kuuluva ehitise või rajatise pinnale paigutatud reklaamikandja, mis samaaegselt selle kasutamisega reklaamialaseks tegevuseks teenib valla avalikke huve (bussiootepaviljon, prügikast jm). Reklaamina ei käsitata: 1) majandus- või kutsetegevuse kohas, kus müüakse kaupa või osutatakse teenust, antavat teavet kauba, teenuse või selle müügitingimuste kohta ning käesoleva lõike punktis 2 nimetatud teavet; 2025-02-27",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "valla ühiskondlikuks objektiks olev reklaamikandja (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valla_uhiskondlikuks_objektiks_olev_reklaamikandja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_infoturvapoliitika_t1058728_infoturve",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "infoturve",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teabe põhiomaduste käideldavuse, tervikluse ja konfidentsiaalsuse tagamine",
        "@language": "et"
      },
