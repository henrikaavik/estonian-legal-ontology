        "@language": "et"
      },
      "skos:definition": {
        "@value": "käesoleva eeskirja tähenduses isik või teenuse osutaja, kes täidab vallas sisekontrolli ülesandeid (edaspidi sisekontrolör).",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052595_Par_2"
        }
      ],
