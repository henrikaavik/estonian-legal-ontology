    {
      "@id": "estleg:Concept_joelahtme_valla_koerte_ja_kasside_pidamise_eeskiri_t1013342_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "territoorium, hoone või ruum, mis on antud avalikuks kasutamiseks või mis on üldkasutatav (pargid, teed, tänavad, hoovid, haljasalad, parklad, kalmistud, avalikud veekogud, staadionid, mänguväljakud, bussiooteplatvormid, ettevõtete piirdeaiata territooriumid vms.), üldkasutatavad hooned (ametiasutused, koolid, lasteaiad, klubid, raamatukogud, spordihooned, toitlustusettevõtted, kauplused, kirikud, elamud vms.)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013342_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla koerte ja kasside pidamise eeskiri",
