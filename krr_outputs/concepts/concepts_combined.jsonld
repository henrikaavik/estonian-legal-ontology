      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallavalitsusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o töölepingu alusel töötav) töötaja",
        "@language": "et"
      },
