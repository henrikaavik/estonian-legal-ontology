      "rdfs:label": "hooldaja",
      "skos:altLabel": [
        {
          "@value": "Hooldaja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "Haapsalu Linnavalitsuse (edaspidi linnavalitsus) poolt määratud teovõimeline isik, kes tagab hooldatavale igapäevase kõrvalabi, juhendamise ja järelvalve.",
          "@language": "et"
        },
        {
          "@value": "isik, kes on määratud sotsiaal- ja tervishoiu osakonna (edaspidi osakond) poolt raske või sügava puudega täisealise isiku hooldajaks või keskmise, raske või sügava puudega lapse hooldajaks.",
          "@language": "et"
        },
        {
          "@value": "kohaliku omavalitsuse poolt määratud teovõimeline isik, kes tagab hooldatavale kõrvalabi, juhendamise ja järelevalve.",
          "@language": "et"
        },
        {
          "@value": "Saarde vallavalitsuse (edaspidi vallavalitsus) poolt määratud teovõimeline isik, kes tagab hooldatavale kõrvalabi, juhendamise ja järelevalve",
          "@language": "et"
        },
        {
          "@value": "sotsiaalhoolekande osakonna juhataja käskkirjaga määratud hooldust teostav isik, kes tagab hooldatavale kõrvalabi, juhendamise ja järelevalve",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "10",
        "@type": "xsd:integer"
      },
