      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rikastamisjäätmed",
      "skos:definition": [
        {
          "@value": "pärast maavara väärtuslikuma osa vähemväärtuslikust kivimist eraldamist (nt purustamist, peenestamist, suuruse järgi sorteerimist, flotatsiooni ja muude füüsikalis-keemiliste tehnoloogiate rakendamist) järele jäävad tahked või vedelad jäätmed; 4",
          "@language": "et"
        }
      ]
    },
