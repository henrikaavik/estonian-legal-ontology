      },
      "skos:definition": {
        "@value": "kasumit mittetaotlev valla elanikele suunatud tegevus elukeskkonna, turvalisuse, kultuuri, spordi, noorsoo- ja sotsiaaltöö, tervise, külaliikumise ning vaba aja sisustamise edendamiseks",
        "@language": "et"
      },
