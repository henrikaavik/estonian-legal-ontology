    {
      "@id": "estleg:Concept_maksmist_toendav_dokument",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Maksmist tõendav dokument",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Maksmist_toendav_dokument"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Maksmist tõendav dokument",
      "skos:definition": [
        {
          "@value": "osaleja poolt kauba või teenuse eest tasumist tõendav panga arhiveerimistunnusega maksekorraldus, kaardimakse- või sularahakviitung. Kaardimaksega tasumisel peab olema kviitungil näidatud lisaks maksekaardi tunnusele ka maksja nimi. Juhul, kui maksete teostaja ei ole programmis osaleja või osaleja poolt volitatud isik, peab maksedokument sisaldama selgitust kelle nimel makse on teostatud. Nõuetele mittevastavalt koostatud kulu- ja maksedokumente on vallavalitsusel õigus mitte arvestada.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
