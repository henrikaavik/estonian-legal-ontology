    },
    {
      "@id": "estleg:Concept_institutsionaalne_arendusprogramm_teadus_ja_arendusasutustel_t1029191_taotlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taotlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vormikohane kirjalik avaldus ja sellele lisatud dokumendid projekti elluviimiseks vajaliku toetuse taotlemiseks, mis esitatakse rakendusüksusele pärast projekti investeeringute kavaga kinnitamist Vabariigi Valitsuse poolt, juhul kui projekt sisaldab investeeringuid teadus- ja õppehoonete rajamisse, või pärast projekti hindamiskomisjoni poolt heakskiitmist, juhul kui projekt ei sisalda investeeringuid teadus- ja õppehoonete rajamisse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1029191_Par_2"
        }
      ],
      "estleg:sourceAct": "Institutsionaalne arendusprogramm teadus- ja arendusasutustele ja kõrgkoolidele",
