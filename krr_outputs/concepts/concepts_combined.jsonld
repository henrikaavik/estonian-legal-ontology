        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eratee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tee, mis paikneb juriidilise või füüsilise isiku kinnisasjal ja ei ole avalikus kasutuses",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
