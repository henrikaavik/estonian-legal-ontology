      "rdfs:label": "risustamine",
      "skos:definition": [
        {
          "@value": "igasugune materjalide, jäätmete või muu kinnistule ebakorrapäraselt laiali laotamine ehk olukord, mis erineb piirkonna üldisest heakorrastatusest",
          "@language": "et"
        },
        {
          "@value": "materjalide, jäätmete või tehnika kinnistule ebakorrapäraselt laiali laotamine, mis erineb piirkonna üldisest heakorrastatusest",
          "@language": "et"
        },
        {
          "@value": "igasugune materjalide, jäätmete või muu ainese kinnistule ebakorraspäraselt laiali laotamine, mis erineb piirkonna üldisest heakorrastatusest",
          "@language": "et"
        },
        {
          "@value": "jäätmete kinnistule ebakorrapäraselt laiali laotamine ehk olukord, mis erineb piirkonna üldisest heakorrastatusest",
          "@language": "et"
        },
        {
          "@value": "materjalide, jäätmete või tehnika kinnistule ebakorrapäraselt laiali laotamine, mis erineb piirkonna üldisest heakorrastatusest; Lõikes 1 nimetamata mõiste kasutamisel lähtutakse teistes õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest või Eesti keele instituudi tõlgendusest.",
          "@language": "et"
        }
      ],
