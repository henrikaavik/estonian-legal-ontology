        },
        {
          "@value": "ettevõtja, kes vastab komisjoni määruse (EL) nr 651/2014 I lisas väikese suurusega ettevõtjale sätestatud kriteeriumitele; 8",
          "@language": "et"
        },
        {
          "@value": "ettevõtja, kes vastab üldise grupierandi määruse I lisa artikli 2 punktides 2 ja 3 sätestatud kriteeriumitele, ka mikroettevõtja.",
          "@language": "et"
        },
        {
          "@value": "ettevõtja, kes vastab üldise grupierandi määruse I lisas väikeettevõtjale sätestatud kriteeriumitele; 5",
