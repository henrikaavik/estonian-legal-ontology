      "rdfs:label": "maksudeklaratsioon",
      "skos:altLabel": [
        {
          "@value": "Maksudeklaratsioon",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "maksuhaldurile esitatav reklaamimaksu arvestamise dokument",
          "@language": "et"
        },
        {
          "@value": "reklaamimaksudeklaratsioon, mille reklaami avalikustaja esitab maksuhaldurile ja mis on reklaamimaksu arvutamise aluseks",
          "@language": "et"
        },
        {
          "@value": "maksu suuruse arvutamiseks ettenähtud dokument, mille maksumaksja on maksuseaduse alusel kohustatud esitama maksuhaldurile",
          "@language": "et"
        },
        {
          "@value": "maksu suuruse arvutamiseks ettenähtud dokument, mille alusel on maksumaksja kohustatud tasuma maksuhaldurile reklaamimaksu",
          "@language": "et"
        },
        {
          "@value": "maksuhaldurile esitatav reklaamimaksu arvestamise dokument (vastavalt käesoleva määruse lisale nr 1)",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
