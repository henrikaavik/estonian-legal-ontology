    {
      "@id": "estleg:Concept_maardu_linna_uhisveevargi_ja_kanalisatsiooni_liitumise_ning_t1063268_uhendustoru",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühendustoru",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tarbimiskoha veevärki veega varustav või tarbimiskoha kanalisatsioonist reo- või sademevett vastuvõttev toru peatorust liitumispunktini; 19) ühisveevärgi ja/või -kanalisatsiooni avarii – ühisveevärgi ja/või -kanalisatsiooni ehitiste või seadmete purunemine või rike, mille tulemusena katkeb või halveneb tarbijate veevarustus ja/või nende reovee ning sademevee kanaliseerimine ja/või on ohustatud inimesed, ehitised või keskkond; 20) ühisveevärgi ja/või -kanalisatsiooniga kaetud ala – ühisveevärgi ja -kanalisatsiooni arendamise kavaga määratud ala, kus ühisveevärk ja -kanalisatsioon on rajatud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1063268_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna ühisveevärgi ja -kanalisatsiooni liitumise ning kasutamise eeskiri",
      "rdfs:label": "ühendustoru (maardu_linna_uhisveevargi_ja_kanalisatsiooni_liitumise_ning__t1063268)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhendustoru"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
