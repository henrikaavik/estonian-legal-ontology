      ],
      "skos:prefLabel": {
        "@value": "energiamärgis",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_covid_19_kriisist_tuleneva_korterelamute_rekonstrueerimise_t_t1049605_energiamargis"
        },
