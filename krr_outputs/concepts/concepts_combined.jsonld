        {
          "@value": "samas eluruumis elavad ühise majapidamisega isikud; 13",
          "@language": "et"
        },
        {
          "@value": "taotleja ja kolm või enam last, kes elavad alaliselt samas eluruumis ning jagavad ühist kodust majapidamist; RT I 2025-08-19 2 119082025002 2025-08-22 5",
          "@language": "et"
        },
        {
          "@value": "üksi elav isik või perekond või ühist eluruumi ja tuluallikat ühiselt kasutatavad või ühise majapidamisega isikud; 5",
