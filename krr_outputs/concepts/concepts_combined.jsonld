      },
      "skos:definition": {
        "@value": "potentsiaalselt pika elueaga taim, millel on vähemalt üks püstine puitunud tüvi ning selgelt määratletav, külgokstest moodustunud võra, mis kinnitub tüvele maapinnast kõrgemal; puu käesoleva korra tähenduses on kasvav puu, mille rinnasdiameeter on vähemalt 15 cm",
        "@language": "et"
      },
      "estleg:definedIn": [
