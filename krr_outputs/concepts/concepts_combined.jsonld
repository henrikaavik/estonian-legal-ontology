        "@value": "toimepidevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "suutlikkus tagada oluliste teenuste ja tegevuste katkematu toimimine või nende kiire taastamine häire, kriisi või elutähtsa teenuse ootamatu katkestuse korral",
        "@language": "et"
      },
