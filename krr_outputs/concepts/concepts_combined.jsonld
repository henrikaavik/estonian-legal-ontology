      "skos:definition": [
        {
          "@value": "seadusjärgne ülalpidamiskohustus alanejate ja ülenejate sugulaste suhtes; 5",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_ulalpidamiskohustusega_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ülalpidamiskohustusega isik",
