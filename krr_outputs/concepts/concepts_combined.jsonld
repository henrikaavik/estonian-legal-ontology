      "skos:definition": [
        {
          "@value": "äriregistris registreeritud juriidiline isik, kes võimaldab Rakvere linna noortel osaleda huvihariduses ja huvitegevuses",
          "@language": "et"
        },
        {
          "@value": "(edaspidi teenuse pakkujad ) äriregistris registreeritud juriidilised isikud või riigi ja kohaliku omavalitsuse asutuste registris registreeritud asutused, kes võimaldavad valla noortel tegeleda erinevate huvialadega",
          "@language": "et"
        }
      ],
