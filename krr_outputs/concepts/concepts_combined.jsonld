      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kaevetööd",
      "skos:definition": "maapinnast arvestatuna enam kui 30 cm sügavuste süvendite kaevamine ehitiste ehitamiseks, kui tööde tegemisel rikutakse tee- või pinnakate (asfalt, sillutis, muru jne), muudetakse maapinna kõrgust. Kaevetööd on ka tööd, mis on seotud puude ja põõsaste väljajuurimise või istutamisega tehnorajatiste kaitsevööndis. 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1023385_Par_2"
        }
      ],
