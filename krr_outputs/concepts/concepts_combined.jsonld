      "estleg:definesConcept": {
        "@id": "estleg:Concept_rahvusvaheline_buroo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rahvusvahelise_patenditaotluse_patendiametile_esitamise_kord_t1002215_vastuvottev_amet",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vastuvõttev amet",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "PCT lepinguosalise riigi institutsioon või valitsustevaheline organisatsioon, kes võtab vastu PCT taotlusi edastamiseks Rahvusvahelisele Büroole; 5) märgitud amet, märgitud ja väljavalitud amet – PCT lepinguosalise riigi institutsioon, kelle ülesandeks on PCT taotluse alusel siseriikliku patendi väljaandmine või kasuliku mudeli registreerimine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1002215_Par_1"
        }
      ],
      "estleg:sourceAct": "Rahvusvahelise patenditaotluse Patendiametile esitamise kord",
      "rdfs:label": "vastuvõttev amet (rahvusvahelise_patenditaotluse_patendiametile_esitamise_kord_t1002215)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vastuvottev_amet"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rahvusvahelise_patenditaotluse_patendiametile_esitamise_kord_t1002215_Patendiamet",
