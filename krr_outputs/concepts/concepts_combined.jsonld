      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "adresseeritud seade",
      "skos:definition": [
        {
          "@value": "üksik adresseeritud andur, tulekahjuteatenupp või sobitusseade, mis teate edastamisel annab täpse aadressi keskseadmele, või adresseeritud juhtimisseade, mis toimib keskseadmest antud juhtimiskäsu järgi; 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_adresseeritud_susteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "adresseeritud süsteem",
