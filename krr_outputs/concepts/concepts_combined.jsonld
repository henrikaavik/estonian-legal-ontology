    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_majandusinformatsiooni_liigendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "majandusinformatsiooni liigendamine",
      "skos:definition": "valla majandustehingute kirjendamine, kasutades riigi või valla õigusaktidega kehtestatud tunnuseid (koode), mis võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid valla juhtimisotsuste tegemiseks ning riigi aruandluse jaoks; 8",
