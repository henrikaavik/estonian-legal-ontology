        "@id": "estleg:Concept_haljasala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rouge_valla_heakorraeeskiri_t1050548_heakorratoo",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heakorratöö",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistu heakorraga seotud tööd, sealhulgas haljastuse hooldamine, niitmine, lume- ja libedusetõrje teostamine, kevadine libedusetõrjeks kasutatud puistematerjali koristamine, haljastus-, olme- ning muude jäätmete koristamine jmt tööd",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050548_Par_3"
        }
      ],
