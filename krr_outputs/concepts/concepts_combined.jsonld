      "estleg:definesConcept": {
        "@id": "estleg:Concept_tallinna_linnapiirkond"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_meetmes_linnapiirkondade_jatkusuu_t1028551_Tartu_linnapiirkond",
      "@type": [
