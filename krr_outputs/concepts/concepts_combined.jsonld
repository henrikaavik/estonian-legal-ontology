    {
      "@id": "estleg:Concept_varjupaigateenuse_ja_turvakoduteenuse_osutamise_tingimused_j_t1046392_turvakodu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "turvakodu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ajutine eluase, kus abivajajale on tagatud turvaline keskkond ja esmane abi, voodikoht, võimalus hoolitseda isikliku hügieeni eest ning vajadusel ka kriisiabi. Kuigi turvakoduteenuse puhul on tegu ajutise abimeetmega, võib abivajaja edasisele elukorraldusele kuluva asjaajamise aja tõttu viibida turvakoduteenusel pikemat aega.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046392_Par_2"
        }
      ],
