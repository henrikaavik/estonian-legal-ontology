    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamise_kord_t1046990_Oppur",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Õppur",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Rahvastikuregistri järgi Narva-Jõesuu linnas elav isik vanuses 7 kuni 19 eluaastat, kes õpib huvikoolis või osaleb huvitegevuses. Huvitegevuseks ei loeta lühiajalisi kursusi ja tervisesporti. Toetus käesoleva korra mõistes on linna eelarvest eraldatavad rahalised vahendid õppuri huvihariduse või -tegevuse toetamiseks. Lasterikka pere õppuriks loetakse käesoleva määruse tähenduses õppurit, kelle leibkonnas on kuni 19-aastaste laste ja noorte arv kolm ja enam last/noort.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046990_Par_2"
        }
      ],
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "rdfs:label": "Õppur (huvihariduse_ja_huvitegevuse_toetamise_kord_t1046990)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_oppur"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
