    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Reisijauhik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reisijaühik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühes sõidukis maksimaalselt kohtade arvule koos reisivate isikute hulk, kelle vedu on tellitud ühe tellimuse alusel.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
