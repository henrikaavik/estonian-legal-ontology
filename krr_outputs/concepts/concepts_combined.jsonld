        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taristu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "planeerimisseaduse § 131 lõikes 1 nimetatud detailplaneeringukohane - avalikuks kasutamiseks ette nähtud tee ning sellega seotud rajatised; - haljastus- ja tehnorajatised (sh välisvalgustus); - planeeringulahenduse elluviimiseks otseselt vajalikud ja sellega funktsionaalselt seotud ehitised; - planeeringulahendusest sõltuvad maaparandussüsteemi ehitised ja -rajatised.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057580_Par_2"
        }
      ],
