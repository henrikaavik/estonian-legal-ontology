        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teadmussiirdedoktorant",
      "skos:definition": [
        {
          "@value": "era-, avaliku- või kolmanda sektori asutuses töölepingu alusel töötav või teenistussuhtes olev isik, kes õpib samaaegselt ülikooli doktoriõppes ja kelle doktoritöö teema on seotud tööandja tegevusega ning on kooskõlas doktorandi individuaalse õppe- ja teadustöö kavaga; RT I 2023-11-29 3 129112023003 2023-12-02 , rakendatakse 22. maist 2023. aastast 13",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_teadmussiirdedoktorantuur",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadmussiirdedoktorantuur",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_toetuse_t1056629_teadmussiirdedoktorantuur"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teadmussiirdedoktorantuur",
      "skos:definition": [
        {
          "@value": "kolmepoolne koostöö era-, avaliku- või kolmanda sektori asutuse/ettevõtte, ülikooli ja doktorandi vahel, kus doktoriõppesse immatrikuleeritud doktorandil on ettevõttes, avaliku- või kolmanda sektori asutuses töö- või teenistussuhe, mille põhisisu on doktorandi doktoritöö tegemine kooskõlas tema individuaalse õppe- ja teadustöö kavaga; RT I 2023-11-29 3 129112023003 2023-12-02 , rakendatakse 22. maist 2023. aastast 12",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_teadmussiire",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadmussiire",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
