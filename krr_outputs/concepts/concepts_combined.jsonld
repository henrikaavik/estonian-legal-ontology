    {
      "@id": "estleg:Concept_traktori_ja_selle_haagise_tuubikinnituse_uksiktraktori_kinni_t1000261_haagis_on_pollu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "haagis on põllu",
      "skos:definition": "või metsamajanduses kasutatav sõiduk, mille peamine otstarve on koorma vedamine ja mis on konstrueeritud traktori haakes vedamiseks. Haagiseks loetakse ka püsivalt kinnitatud töövahendiga sõidukit, kui selle täismassi suhe tühimassi on 3,0 või üle selle ja kui see sõiduk ei ole konstrueeritud materjalide töötlemiseks; 11",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000261_Par_2"
        }
      ],
      "estleg:sourceAct": "Traktori ja selle haagise tüübikinnituse, üksiktraktori kinnituse ja ümberehituse tingimused, nõuded ja kord",
      "rdfs:label": "haagis on põllu (traktori_ja_selle_haagise_tuubikinnituse_uksiktraktori_kinni_t1000261)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_haagis_on_pollu"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_haagis_on_pollu"
        }
      ]
    },
    {
      "@id": "estleg:Concept_traktori_ja_selle_haagise_tuubikinnituse_uksiktraktori_kinni_t1000261_traktor_on_rataste_voi_roomikutega_pollu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "traktor on rataste või roomikutega põllu",
      "skos:definition": "või metsatööks ette nähtud mootorsõiduk, millel on vähemalt kaks telge ja mille suurim valmistajakiirus on vähemalt 6 km/h. Traktori peamine otstarve seisneb veojõus, mis on spetsiaalselt kavandatud põllu- ja metsatöödel haakemasinate tõmbamiseks, lükkamiseks, kandmiseks või käitamiseks, samuti põllu- või metsatööl kasutatavate haagiste pukseerimiseks. Traktor võib olla kohandatud koorma vedamiseks põllu- või metsatöödel ja varustatud kaassõitja istmetega; 31",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000261_Par_2"
        }
      ],
      "estleg:sourceAct": "Traktori ja selle haagise tüübikinnituse, üksiktraktori kinnituse ja ümberehituse tingimused, nõuded ja kord",
      "rdfs:label": "traktor on rataste või roomikutega põllu (traktori_ja_selle_haagise_tuubikinnituse_uksiktraktori_kinni_t1000261)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_traktor_on_rataste_voi_roomikutega_pollu"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_traktor_on_rataste_voi_roomikutega_pollu"
        }
      ]
    },
    {
      "@id": "estleg:Concept_traktori_ja_selle_haagise_tuubikinnituse_uksiktraktori_kinni_t1000261_vahetatav_pukseeritav_seadeldis_on_pollu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "vahetatav pukseeritav seadeldis on põllu",
      "skos:definition": "või metsamajanduses kasutatav mehhanism, mille peamine otstarve on täiendada või muuta traktori funktsioone ja mis on konstrueeritud traktori haakes vedamiseks. Pukseeritaval seadeldisel võib olla koormaplatvorm, mis on ette nähtud vajalike töövahendite ja seadmete vedamiseks ning töö ajal toodetava või kasutatava materjali ajutiseks ladustamiseks. Vahetatavaks seadmeks loetakse ka püsivalt kinnitatud töövahendiga sõidukit, kui selle täismassi suhe tühimassi on väiksem kui 3,0; RT I 2014-03-18 9 118032014009 2014-03-21 39",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000261_Par_2"
        }
      ],
      "estleg:sourceAct": "Traktori ja selle haagise tüübikinnituse, üksiktraktori kinnituse ja ümberehituse tingimused, nõuded ja kord",
      "rdfs:label": "vahetatav pukseeritav seadeldis on põllu (traktori_ja_selle_haagise_tuubikinnituse_uksiktraktori_kinni_t1000261)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vahetatav_pukseeritav_seadeldis_on_pollu"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_vahetatav_pukseeritav_seadeldis_on_pollu"
        }
      ]
    },
