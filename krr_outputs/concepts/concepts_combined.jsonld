    {
      "@id": "estleg:Concept_jaatmetekke_ja_pakendamise_valtimise_ja_vahendamise_ning_kor_t1060580_protsessiinnovatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "protsessiinnovatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "uue või oluliselt täiustatud tootmis- või tarnemeetodi rakendamine, sealhulgas olulised muudatused tehnilistes võtetes, seadmetes või tarkvaras, ettevõtja tasandil (EMP tööstusharudes kontserni tasandil), sealhulgas näiteks uut või innovaatilist digitehnoloogiat või innovaatilisi digilahendusi kasutades.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060580_Par_2"
        }
      ],
      "estleg:sourceAct": "Jäätmetekke ja pakendamise vältimise ja vähendamise ning korduskasutuse edendamiseks toetuse andmise tingimused ja kord perioodil 2021–2027",
      "rdfs:label": "protsessiinnovatsioon (jaatmetekke_ja_pakendamise_valtimise_ja_vahendamise_ning_kor_t1060580)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_protsessiinnovatsioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaasaegse_ja_uuendusliku_oppevara_uhiskasutuskorralduse_toet_t1038763_digipadevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "digipädevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "suutlikkus kasutada uuenevat digitehnoloogiat toimetulekuks kiiresti muutuvas ühiskonnas nii õppimisel, kodanikuna tegutsedes kui ka kogukondades suheldes; leida ja säilitada digivahendite abil infot ning hinnata selle asjakohasust ja usaldusväärsust; osaleda digitaalses sisuloomes, sh tekstide, piltide, multimeediumide loomisel ja kasutamisel; kasutada probleemilahenduseks sobivaid digivahendeid ja võtteid, suhelda ja teha koostööd erinevates digikeskkondades; olla teadlik digikeskkonna ohtudest ning osata kaitsta oma privaatsust, isikuandmeid ja digitaalset identiteeti; järgida digikeskkonnas samu moraali- ja väärtuspõhimõtteid nagu igapäevaelus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1038763_Par_2"
        }
      ],
      "estleg:sourceAct": "„Kaasaegse ja uuendusliku õppevara ühiskasutuskorralduse toetamine“ elluviimiseks struktuuritoetuse andmise tingimused ja kord",
      "rdfs:label": "digipädevus (kaasaegse_ja_uuendusliku_oppevara_uhiskasutuskorralduse_toet_t1038763)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_digipadevus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
