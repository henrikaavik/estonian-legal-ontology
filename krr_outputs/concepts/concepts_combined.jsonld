      "rdfs:label": "taotlus",
      "skos:definition": [
        {
          "@value": "toetuse taotlemise avaldus ja sellele lisatud dokumendid. Taotluse vormi kinnitab keskus; 2020-12-17",
          "@language": "et"
        },
        {
          "@value": "vormikohane kirjalik avaldus ja sellele lisatud dokumendid toetuse taotlemiseks.",
          "@language": "et"
        },
        {
          "@value": "Rahandusministeeriumile toetuse saamiseks esitatav taotlusvorm koos lisadega",
          "@language": "et"
        },
        {
          "@value": "taotleja poolt rakendusüksusele esitatav vormikohane avaldus ja sellele lisatud dokumendid toetuse taotlemiseks",
          "@language": "et"
        },
        {
          "@value": "teabekandja paigaldamiseks vajalikud dokumendid",
          "@language": "et"
        }
      ],
