      ],
      "skos:prefLabel": {
        "@value": "taotleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "leibkonnaliige, kes on tühjenevas korterelamus asuva korteri omanik ja taotleb asenduskorteri omandamise kompensatsiooni",
        "@language": "et"
      },
      "estleg:definedIn": [
