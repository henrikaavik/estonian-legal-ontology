        "@type": "xsd:integer"
      },
      "rdfs:label": "tööpere",
      "skos:definition": [
        {
          "@value": "sarnase funktsiooni või töö sisuga teenistuskohtade kogum, mis on jaotatud tasemeteks, lähtudes töö tegijale esitatavatest nõuetest, töö keerukusest ja vastutuse ulatusest",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
