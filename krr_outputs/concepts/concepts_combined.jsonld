        }
      ]
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_otsused",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "riigihanke otsused",
      "skos:definition": "riigihangete seaduse või riigihanke alusdokumentide alusel vastuvõetavad otsused, mis vormistatakse käskkirja või korraldusena; 17",
