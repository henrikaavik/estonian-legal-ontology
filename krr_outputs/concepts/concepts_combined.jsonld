      "skos:definition": {
        "@value": "teenistujale tehtud töö eest makstav tasu, mis koosneb ametniku põhipalgast või töötaja töötasust koos muutuvpalga, eritingimustes töötamise eest makstavate lisatasude ning asendustasuga.",
        "@language": "et"
      },
      "estleg:definedIn": [
