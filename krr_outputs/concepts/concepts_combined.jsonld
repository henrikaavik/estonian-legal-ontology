          "@id": "estleg:Concept_tapa_vallavalitsuse_teenistujate_koolituse_kord_t1018272_sisekoolitus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "10",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sisekoolitus",
      "skos:definition": [
        {
          "@value": "tööalane täienduskoolitus, mille läbiviijaks on ametiasutuse enda teenistuja ja koolitamine või juhendamine ei tulene tema teenistuskoha eesmärgist ega ametijuhendist",
          "@language": "et"
        },
        {
          "@value": "asutuse teenistuja läbiviidav koolitus.",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse teenistuja läbiviidav koolitus",
          "@language": "et"
        },
        {
          "@value": "asutuse teenistuja poolt läbiviidav koolitus asutuse või selle valitsemisala teenistujatele",
          "@language": "et"
        },
        {
          "@value": "linnavalitsuse teenistujatele tellitud koolitus või linnavalitsuse teenistuja poolt läbiviidav koolitus",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
