    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_saaremaa_vallas_t1047226_reovee_bioloogiline_puhastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee bioloogiline puhastamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "orgaanilise aine ja toitainete ärastamine reoveest bioloogiliste protsesside toimel, mille tulemusel heitvesi vastab kehtestatud reostusnäitajate piirväärtustele heljuvaine, biokeemilise ja keemilise hapnikutarbe osas",
        "@language": "et"
      },
      "estleg:definedIn": [
