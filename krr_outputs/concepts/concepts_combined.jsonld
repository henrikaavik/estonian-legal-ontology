    },
    {
      "@id": "estleg:Concept_kohila_valla_heakorraeeskiri_t1057788_heakord",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heakord",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla haldusterritooriumi puhtus ja korrastatus. Avalikku heaolu ja kvaliteetset elukeskkonda soodustavad tegevused kinnis- ja vallasvara ning avaliku koha korrashoiu, puhtuse, ohutuse ja seisundi tagamiseks; 13) reostamine (sh saastamine, saastus, reostus) – ainete (sh jäätmed), vibratsiooni, soojuse, kiirguse, valguse või müra inimtegevusest põhjustatud otsene või kaudne väljutamine ümbritsevasse keskkonda, sh õhku, vette, maapinnale või pinnasesse nii, et see võib ohustada inimeste tervist või keskkonda, põhjustada varalist kahju või kahjustada või häirida keskkonna puhkeotstarbelist või muud õiguspärast kasutamist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057788_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla heakorraeeskiri",
      "rdfs:label": "heakord (kohila_valla_heakorraeeskiri_t1057788)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_heakord"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_heakorraeeskiri_t1057788_risustamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "risustamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "materjalide, jäätmete või tehnika kinnistule ebakorrapäraselt laiali laotamine, mis erineb piirkonna üldisest heakorrastatusest; Lõikes 1 nimetamata mõiste kasutamisel lähtutakse teistes õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest või Eesti keele instituudi tõlgendusest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057788_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla heakorraeeskiri",
      "rdfs:label": "risustamine (kohila_valla_heakorraeeskiri_t1057788)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_risustamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
