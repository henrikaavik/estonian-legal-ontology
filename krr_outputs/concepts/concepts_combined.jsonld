      "skos:definition": [
        {
          "@value": "PCT lepinguosalise riigi institutsioon või valitsustevaheline organisatsioon, kes võtab vastu PCT taotlusi edastamiseks Rahvusvahelisele Büroole; 5) märgitud amet, märgitud ja väljavalitud amet – PCT lepinguosalise riigi institutsioon, kelle ülesandeks on PCT taotluse alusel siseriikliku patendi väljaandmine või kasuliku mudeli registreerimine",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vedaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_luganuse_valla_jaatmehoolduseeskiri_t1057045_vedaja"
        },
        {
          "@id": "estleg:Concept_rapina_valla_jaatmehoolduseeskiri_t1057272_vedaja"
        },
        {
          "@id": "estleg:Concept_pileti_hinna_kehtestamise_ja_soidusoodustuste_andmise_kord_s_t1057406_vedaja"
        },
        {
          "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Vedaja"
        },
        {
          "@id": "estleg:Concept_jaatmehoolduseeskiri_t1052495_vedaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "vedaja",
      "skos:altLabel": [
        {
          "@value": "Vedaja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "jäätmekäitleja, kellele kohalik omavalitsus on riigihanke tulemusena andnud teenuste kontsessiooni korraldatud jäätmeveoga hõlmatud jäätmete vedamiseks Lüganuse valla haldusterritooriumil. Käesoleva paragrahvi lõikes 1 nimetamata termini kasutamisel lähtutakse jäätmeseaduses, pakendiseaduses ja teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest.",
          "@language": "et"
        },
        {
          "@value": "jäätmekäitleja, kellele vallavalitsus on riigihanke tulemusena andnud teenuste kontsessioonikorraldatud jäätmeveoga hõlmatud jäätmete vedamiseks valla haldusterritooriumil või jäätmete vedamiseks vastavat luba omav jäätmekäitleja",
          "@language": "et"
        },
        {
          "@value": "jäätmekäitleja, kellele Võru Linnavalitsuselt (edaspidi linnavalitsus) on riigihanke tulemusena andnud teenuste kontsessiooni korraldatud jäätmeveoga hõlmatud jäätmete vedamiseks Võru linna haldusterritooriumil või isik, kellel on õigus vedada korraldatud jäätmeveoga hõlmamata jäätmeid.",
          "@language": "et"
        },
        {
          "@value": "Saku vallasisestel avalikel bussiliinidel liiniveoteenust osutav ettevõte",
          "@language": "et"
        },
        {
          "@value": "Vinni Vallavalitsuse või tema volitatud esindajaga vastava teenuse osutamise lepingu sõlminud isik, kelle ülesandeks on veoteenuse osutamine vastavalt § 6.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
