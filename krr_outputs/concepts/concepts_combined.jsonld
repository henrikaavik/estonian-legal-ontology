      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_alutaguse_valla_raamatupidamise_sise_eeskiri_t1049736_valla_tegevjuhtkond"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "valla tegevjuhtkond",
      "skos:definition": [
        {
          "@value": "Alutaguse Vallavalitsus (edaspidi vallavalitsus ), mis kohaliku omavalitsuse korralduse seaduse kohaselt on valla täitevorgan. Nimetatud seaduse sätetest tulenevalt esindab vallavalitsust temale seadusega, valla põhimäärusega või vallavolikogu poolt antud pädevusele vallavanem",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valla_valitsev_moju",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valla valitsev mõju",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_alutaguse_valla_raamatupidamise_sise_eeskiri_t1049736_valla_valitsev_moju"
        },
        {
          "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_valla_valitsev_moju"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "valla valitsev mõju",
      "skos:definition": [
        {
          "@value": "Raamatupidamise Toimkonna juhendi kohaselt võime valla osalusega tütarettevõtte üle otsustamine. Kontrolli olemasolu eeldatakse juhul, kui valla omanduses on otse või tütarettevõtete kaudu rohkem kui 50% tütarettevõtte hääleõigusest",
          "@language": "et"
        },
        {
          "@value": "RTJ 11 punkti 8 kohaselt osalusega tütarettevõtted, mida kontrollib vald. Kontrolli olemasolu eeldatakse juhul, kui valla omanduses on otse või tütarettevõtete kaudu rohkem kui 50% tütarettevõtte hääleõigusest, välja arvatud erandjuhud, kui on võimalik selgelt tõendada, et sellise hääleõigusega ei kaasne kontrolli. Kontroll eksisteerib ka siis, kui vallale kuulub 50% ja vähem hääleõigusest, kuid vald: - omab tegelikku kontrolli rohkem kui 50% hääleõiguse üle kokkuleppe alusel teiste investoritega; - kontrollib ettevõtte finants- ja tegevuspoliitikat teatud lepingu või kokkuleppe alusel; - suudab määrata või tagasi kutsuda tegev- ja kõrgema juhtkonna liikmeid; - suudab määrata tegevjuhtkonna ja kõrgema juhtorgani koosolekute otsuseid.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
