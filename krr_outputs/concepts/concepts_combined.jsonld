      ]
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_teehoiu_eeskiri_t1061479_Kohalik_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kohalik tee",
      "skos:definition": "on tee mille osas omaniku ülesandeid täidab Lääne-Nigula vald. Kohalik tee võib olla avalikuks kasutamiseks määratud eratee, Lääne-Nigula vallale kuuluv tee või Lääne-Nigula valla hallatav kohaliku liikluse korraldamiseks vajalik muu tee (edaspidi vallatee). 3 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061479_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla teehoiu eeskiri",
      "rdfs:label": "Kohalik tee (laane_nigula_valla_teehoiu_eeskiri_t1061479)",
