      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kasutusest väljas olev sõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduk, mis on registreeritud liiklusregistris, kuid millel puudub kehtiv liikluskindlustus rohkem kui 90 päeva või tehnoülevaatus rohkem kui 90 päeva või sõiduk on liiklemiseks tehniliselt korrast ära või puuduvad numbrimärgid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060686_Par_3"
        }
      ],
