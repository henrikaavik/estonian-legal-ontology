        "@type": "xsd:integer"
      },
      "rdfs:label": "elutähtsa teenuse osutaja",
      "skos:definition": [
        {
          "@value": "juriidiline isik, kelle pädevuses on elutähtsa teenusena määratletud avaliku halduse ülesande täitmine",
          "@language": "et"
        },
        {
          "@value": "juriidiline isik, kelle pädevuses on elutähtsa teenusena määratletud avaliku halduse ülesande täitmine või elutähtsat teenust osutav ettevõtjana tegutsev isik",
          "@language": "et"
        },
        {
          "@value": "kaugkütteseaduse § 7 lõikes 3 nimetatud soojusettevõtja, ühisveevärgi ja kanalisatsiooni seaduse § 6 lõikes 2 nimetatud vee-ettevõtja ning ehitusseadustiku § 97 lõikes 8 nimetatud kohalikke teid korrashoidev ettevõtja.",
          "@language": "et"
        },
        {
          "@value": "kaugkütteseaduse § 7 lõikes 3 nimetatud soojusettevõtja, ühisveevärgi ja kanalisatsiooni seaduse § 7 lõikes 1 1 nimetatud vee-ettevõtja ning ehitusseadustiku § 97 lõikes 8 nimetatud kohalikke teid korrashoidev ettevõtja.",
          "@language": "et"
        },
        {
          "@value": "kaugkütteseaduse § 7 lõikes 3 nimetatud soojusettevõtja, ühisveevärgi ja kanalisatsiooni seaduse § 6 nimetatud vee-ettevõtja ning ehitusseadustiku § 97 lõikes 8 nimetatud kohalikke teid korrashoidev ettevõtja.",
          "@language": "et"
        }
