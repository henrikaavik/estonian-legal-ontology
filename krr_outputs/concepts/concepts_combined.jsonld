      },
      "rdfs:label": "Abivahend",
      "skos:altLabel": [
        {
          "@value": "abivahend",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "sõidukis täiendavat ruumi vajav kliendi liikumise hõlbustaja, nt ratastool, käimisraam, juhtkoer.",
          "@language": "et"
        },
        {
          "@value": "toode, mille abil on võimalik parandada inimese füüsilist ja sotsiaalset isetegevust, tegevus- ja töövõimet ning mis on kantud sotsiaalkaitseministri määrusega kinnitatud abivahendite loetellu või tervise- ja tööministri määrusega kinnitatud meditsiiniseadmete loetellu",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
