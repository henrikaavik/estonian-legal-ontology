      "rdfs:label": "sisestusmaht",
      "skos:definition": [
        {
          "@value": "sisestuspunkti kaudu aastas ülekandevõrku sisestatud biometaani kogus, mõõdetuna gigavatt-tundides",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
