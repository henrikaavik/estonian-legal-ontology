        },
        {
          "@value": "asutus, mis pakub huvihariduse, huvitegevuse ja noorsootöö teenust Saaremaa vallas",
          "@language": "et"
        },
        {
          "@value": "teenust pakkuva andmekogu vastutav töötleja või teabevaldaja või andmekogu volitatud töötleja",
          "@language": "et"
        }
      ],
