      "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_hea_raamatupidamistava",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "hea raamatupidamistava",
      "skos:definition": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev raamatupidamistava, mille põhinõuded kehtestatakse RPS-s, mida täiendavad RTJ-d, FA juhend ja eeskiri; 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044080_Par_2"
        }
      ],
      "estleg:sourceAct": "Türi valla raamatupidamise sise-eeskiri",
