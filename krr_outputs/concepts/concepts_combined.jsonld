      "rdfs:label": "teade",
      "skos:definition": [
        {
          "@value": "Häirekeskusele või Politsei- ja Piirivalveametile edastatud info asjaoludest, mille puhul tuleb hinnata abi kiire väljasaatmise vajadust",
          "@language": "et"
        },
        {
          "@value": "Häirekeskusele või Politsei- ja Piirivalveametile edastatud informatsioon asjaoludest, mille puhul tuleb hinnata abi kiire väljasaatmise vajadust",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
