      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_reovee_bioloogiline_puhastamine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "septik",
      "skos:definition": "pealt kinnine setiti, millesse sadestunud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt. Septik on omapuhasti osa, mille ülesandeks on selitada reovees olev heljum. Veetiheda ja ventileeritava kinnise mahuti põhja settivad reovee tahked osad ja lagunevad seal anaeroobselt bioloogiliste protsesside tulemusena. Pärast septiku kambrite (1-",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039009_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskirja kehtestamine",
