    {
      "@id": "estleg:Concept_arsti_vastuvott",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "arsti vastuvõtt",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_arsti_vastuvott"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "arsti vastuvõtt",
      "skos:definition": [
        {
          "@value": "kui isik ei ole kuue kuu jooksul enne töövõime hindamise taotluse esitamist perearsti, teda põhiliselt raviva eriarsti või töötervishoiuarsti (edaspidi arst ) vastuvõtul käinud, teavitab töötukassa isikut töövõimetoetuse seaduse § 6 lõike 5 alusel arsti vastuvõtul käimise vajadusest ja määrab selleks tähtaja. Kui isik on kuue kuu jooksul enne töövõime taotluse esitamist mõne arsti vastuvõtul käinud, siis teda andmete täpsustamise vajaduse tõttu arsti vastuvõtule ei saadeta",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
