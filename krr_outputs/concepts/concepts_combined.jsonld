      "@id": "estleg:Concept_nutika_spetsialiseerumise_fookusvaldkonnad",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "nutika spetsialiseerumise fookusvaldkonnad",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265_nutika_spetsialiseerumise_fookusvaldkonnad"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "nutika spetsialiseerumise fookusvaldkonnad",
      "skos:definition": [
        {
          "@value": "TAIE arengukavas kirjeldatud Eesti arenguvajadustele ja -võimalustele vastavad eelisarendatavad teadus- ja arendustegevuse, innovatsiooni ja ettevõtluse valdkonnad, milleks on digilahendused igas eluvaldkonnas, tervisetehnoloogiad- ja teenused, kohalike ressursside väärindamine ning nutikad ja kestlikud energialahendused; 7",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_nutika_spetsialiseerumise_fookusvaldkond"
        }
      ]
    },
    {
      "@id": "estleg:Concept_nutika_spetsialiseerumise_juhtkomitee_on_majandus",
      "@type": [
        "owl:NamedIndividual",
