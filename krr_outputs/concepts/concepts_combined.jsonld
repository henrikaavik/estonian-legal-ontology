      "rdfs:label": "kaitsevöönd",
      "skos:altLabel": [
        {
          "@value": "Kaitsevöönd",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ühisveevärgi ja -kanalisatsiooni kaitsevöönd on seaduse alusel ühisveevärgi ja -kanalisatsiooni ehitisi ümbritsev maa-ala, õhuruum või veekogu, kus kinnisasja kasutamist on kitsendatud ühisveevärgi ja -kanalisatsiooni ehitiste kaitse ja ohutuse tagamiseks",
          "@language": "et"
        },
        {
          "@value": "kitsendustega maa-ala ÜVK ehitiste kaitse ja ohutuse ning hoolduse tagamiseks",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku alusel ühisveevärgi ja -kanalisatsiooni ehitisi ümbritsev maa-ala, õhuruum või veekogu, kus kinnisasja kasutamist on kitsendatud ühisveevärgi ja -kanalisatsiooni ehitiste kaitse ja ohutuse tagamiseks.",
          "@language": "et"
        },
        {
          "@value": "seaduse alusel ühisveevärgi ja -kanalisatsiooni ehitisi ümbritsev maa-ala, õhuruum või veekogu, kus kinnisasja kasutamist on kitsendatud ühisveevärgi ja -kanalisatsiooni ehitiste kaitse ja ohutuse tagamiseks",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi ja –kanalisatsiooni ehitisi ümbritsev maa-ala, õhuruum või veekogu, kus kinnisasja kasutamist on kitsendatud ehitiste kaitse ja ohutuse tagamiseks",
          "@language": "et"
