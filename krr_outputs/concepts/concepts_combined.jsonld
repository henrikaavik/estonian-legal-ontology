        "@language": "et"
      },
      "skos:definition": {
        "@value": "ruumi või ruumide ruumitemperatuurini kütmiseks vajalik soojusenergia (soojushulk), arvestades vabasoojust, välispiirde soojuskadu, välispiirde ebatihedustest (infiltratsioonist) tulenevat soojuskadu ja ruumi sissepuhutava ventilatsiooniõhu soojenemist ruumitemperatuurini",
        "@language": "et"
      },
      "estleg:definedIn": [
