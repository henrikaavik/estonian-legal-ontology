      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_reovee_bioloogiline_puhastamine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_johvi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054000_reoveekogumisala",
      "@type": [
