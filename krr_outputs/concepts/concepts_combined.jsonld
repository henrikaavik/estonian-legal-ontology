      "skos:prefLabel": {
        "@value": "hanke eest vastutavad isikud",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutuses struktuuriüksuse juht ja vastava valdkonna teenistuja, hallatavas asutuses asutuse juht ja vastava valdkonna töötaja",
