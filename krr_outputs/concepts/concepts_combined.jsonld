    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_taotlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "taotlus",
      "skos:definition": "vormikohane kirjalik avaldus tugi- või põhitegevuse läbiviimiseks, mis sisaldab projekti, millele toetust taotletakse, ja sellele lisatud dokumente toetuse taotlemiseks; 12",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
