      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_maks_t1043195_jalgtee_taielik_sulgemine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jalgtee täielik sulgemine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jalgtee sulgemine selliselt, kus mittesuletava osa laius on alla 1,5 m",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043195_Par_2"
        }
      ],
      "estleg:sourceAct": "Teede ja tänavate sulgemise maks",
