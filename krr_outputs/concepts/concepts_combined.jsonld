    {
      "@id": "estleg:Concept_reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edendamise või isiku käitumise avalikes huvides suunamise eesmärgil; 2) reklaamimaks (edaspidi maks ) - Tõrva valla avalik-õiguslike ülesannete täitmiseks vajaliku tulu saamiseks määruses sätestatud korras maksukohustuslase poolt maksuobjekti osas, suuruses ja tähtaegadel ilma otsese vastutasuta tasumisele kuuluv kohalik maks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048421_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaami paigaldamise kord ja reklaamimaks",
      "rdfs:label": "reklaam (reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421_maksuobjekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "maksuobjekt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaam, mida eksponeeritakse Tõrva valla haldusterritooriumil füüsilise või juriidilise isiku poolt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048421_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaami paigaldamise kord ja reklaamimaks",
      "rdfs:label": "maksuobjekt (reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_maksuobjekt"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421_maksukohustuslane",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "maksukohustuslane",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "välireklaamikandja otsene valdaja; 5) majandus- või kutsetegevuse koht - koht, kus vahetult pakutakse ja müüakse kaupa või vahetult pakutakse ja osutatakse teenust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048421_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaami paigaldamise kord ja reklaamimaks",
      "rdfs:label": "maksukohustuslane (reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_maksukohustuslane"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421_tagastusnoue",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tagastusnõue",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "seaduses või haldusaktis ettenähtust suuremas summas tehtud makse ja rahalise kohustuse tasumisel või tasaarvestamisel tekkinud enammakse tagasisaamiseks koostatud kirjalik taotlus, mis esitatakse maksuhaldurile reklaamimaksualase maksudeklaratsiooni (edaspidi maksudeklaratsioon) paranduses või muus kirjalikus või kirjalikku taasesitamist võimaldavas vormis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048421_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaami paigaldamise kord ja reklaamimaks",
      "rdfs:label": "tagastusnõue (reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tagastusnoue"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421_maksudeklaratsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "maksudeklaratsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "maksuhaldurile esitatav reklaamimaksu arvestamise dokument",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048421_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaami paigaldamise kord ja reklaamimaks",
