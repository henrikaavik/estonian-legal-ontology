      },
      "skos:definition": {
        "@value": "reklaam, mis on avalikustatud (paigaldatud) füüsiliste ning juriidiliste isikute poolt Saue valla territooriumile väljaspool siseruume või siseruumis vaid väljaspool siseruume vaadeldavana",
        "@language": "et"
