      },
      "skos:definition": {
        "@value": "ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest)",
        "@language": "et"
      },
      "estleg:definedIn": [
