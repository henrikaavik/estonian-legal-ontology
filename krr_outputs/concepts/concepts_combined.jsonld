      },
      "rdfs:label": "reovee mehaaniline puhastamine",
      "skos:definition": [
        {
          "@value": "reoainete eemaldamine, mille korral reovee puhastusaste peab olema biokeemilise hapnikutarbe (BHT) osas vähemalt 20% ja hõljuvaine sisalduse osas vähemalt 50%; 15",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_reovee_moodusolm",
      "@type": [
        "owl:NamedIndividual",
