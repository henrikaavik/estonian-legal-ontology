      "estleg:definesConcept": {
        "@id": "estleg:Concept_lihthange"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_valla_hankekord_t1058651_vaikehange",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "väikehange",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hange, mille eeldatav maksumus jääb vahemikku 5000 eurot kuni lihthanke piirmäär; 6) ostumenetlus- hange, mille eeldatav maksumus on kuni 4999 eurot",
        "@language": "et"
      },
      "estleg:definedIn": [
