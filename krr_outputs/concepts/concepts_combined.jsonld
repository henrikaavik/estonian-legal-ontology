      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmekaitluskoha_jarelhooldus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmeleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmeleping",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "dokument, millega isikud reguleerivad omavahelisi suhteid jäätmete kogumiseks ja üleandmiseks veoteenuse osutajale või teistele vastavate jäätmete vastuvõtu õigust omavatele isikutele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmeleping (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmeleping"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmetekitaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmetekitaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, riigi või kohaliku omavalitsuse asutus, kelle tegevuse käigus tekivad jäätmed või isik, kes sooritab jäätmetega toiminguid, mille tagajärjel jäätmete olemus või koostis muutub (näiteks tegeleb jäätmete eeltöötlusega või segab jäätmeid)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmetekitaja (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmetekitaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmete_kogumine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmete kogumine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmete kokku korjamine, sealhulgas jäätmete eelsortimine ja ajutine ladustamine ning mehaaniline töötlemine ilma jäätmete koostist ja olemust muutmata, eesmärgiga vedada need edasiseks käitlemiseks jäätmekäitluskohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmete kogumine (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmete_kogumine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmevaldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevaldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmetekitaja või muu isik, riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevaldaja (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevaldaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmevedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevedaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmete üleandmisel nende vedu teostav isik. Eeskirja 4.peatüki mõistes on jäätmevedaja riigihanke käigus välja valitud jäätmeveoettevõte, kellel on ainuõigus teostada korraldatud jäätmeveoga hõlmatud jäätmete vedu konkreetses jäätmeveo piirkonnas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevedaja (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevedaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmeveo_dokument",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmeveo dokument",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmevedaja poolt jäätmekäitluskohta veetavate jäätmete omadusi ja koguseid näitav saateleht",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmeveo dokument (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmeveo_dokument"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_korduskasutuspakend",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "korduskasutuspakend",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pakend, mis on mõeldud ja kavandatud läbima oma olelustsükli jooksul mitu kasutuskäiku või- ringi. Korduvalt kasutatav pakend muutub pakendijäätmeks, kui ta ei kuulu enam korduskasutusele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "korduskasutuspakend (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korduskasutuspakend"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_korraldatud_jaatmevedu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "korraldatud jäätmevedu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olmejäätmete, eelkõige prügi ehk segaolmejäätmete, nende sortimisjääkide ja olmejäätmete tekkekohas liigiti kogumisel tekkinud jäätmeliikide kogumine ja vedamine määratud piirkonnast määratud jäätmekäitluskohta või -kohtadesse kohaliku omavalitsuse üksuse korraldatud konkursi korras valitud ettevõtja (jäätmevedaja) poolt. Korraldatud jäätmevedu võib hõlmata ka teisi olmejäätmete liike või muid jäätmeid, kui see on vajalik jäätmeseaduse nõuete täitmiseks või seda tingib oluline avalik huvi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "korraldatud jäätmevedu (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korraldatud_jaatmevedu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_korraldatud_jaatmeveo_teenustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "korraldatud jäätmeveo teenustasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmevaldaja poolt jäätmevedajale korraldatud jäätmeveoga hõlmatud jäätmete käitlemise eest makstav ühekordne konteineri tühjendustasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "korraldatud jäätmeveo teenustasu (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korraldatud_jaatmeveo_teenustasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_liigiti_kogumine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "liigiti kogumine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmete kogumistegevus, mille käigus jäätmed eraldatakse liigi ja olemuse alusel nende edasise käitlemise lihtsustamiseks, sealhulgas taaskasutamise soodustamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "liigiti kogumine (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_liigiti_kogumine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_ohtlikud_jaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ohtlikud jäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmed, mis komisjoni määruse (EL) nr 1357/2014 lisas nimetatud vähemalt ühe ohtliku omaduse tõttu võivad olla ohtlikud tervisele, varale või keskkonnale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "ohtlikud jäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ohtlikud_jaatmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_olmejaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "olmejäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "1) kodumajapidamistest kogutud segajäätmed ja liigiti kogutud jäätmed, sealhulgas paber ja kartong, klaas, metallid, plast, biojäätmed, puit, tekstiil, pakendid, elektri- ja elektroonikaseadmetest tekkinud jäätmed, patareid ja akud ning suuremõõtmelised jäätmed, sealhulgas madratsid ja mööbel; 2) muudest allikatest kogutud segajäätmed ja liigiti kogutud jäätmed, mis on oma koostise ja omaduste poolest kodumajapidamisjäätmete sarnased. Olmejäätmete hulka ei kuulu tootmis-, põllumajandus-, metsandus-, kalandus-, septiku ega kanalisatsioonivõrgu ja reovee töötlemise jäätmed, romusõidukid ega ehitus- ja lammutusjäätmed; 23) paberi- ja kartongijäätmed - puhas ja kuiv tarbimisest kõrvaldatud paber ja kartong. Paberiks eeskirja tähenduses ei loeta dokumente, mis tuleb hävitada vastavalt isikuandmete kaitse seadusele ja arhiiviseadusele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "olmejäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_olmejaatmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pakendijaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pakendijäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "mistahes pakend või pakendimaterjal, mis muutub pärast pakendi kasutamist jäätmeteks käesoleva eeskirja § 2 lg 2 p.5 mõistes. Pakendijäätmeteks ei loeta pakendi ja pakendimaterjali tootmisel tekkinud jääke",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "pakendijäätmed (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pakendijaatmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pakendijaatmete_kogumissusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pakendijäätmete kogumissüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pakendiettevõtjate korraldatud pakendijäätmete kogumise süsteem, mis hõlmab kõiki Eesti Vabariigis turule lastud kaupade pakenditest tekkinud pakendijäätmeid, olenemata sellest, kas need on tekitatud tööstuses, kaubandustegevuses, olmes, ametiasutuses või mujal ning olenemata kasutatud materjalidest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "pakendijäätmete kogumissüsteem (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pakendijaatmete_kogumissusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_pakendiettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "pakendiettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes majandus-või kutsetegevuse raames pakendab kaupa, veab sisse või müüb pakendatud kaupa. Samuti akrediteeritud taaskasutusorganisatsioon, kellele pakendiseaduses ettenähtud juhtudel on eelpool nimetatud isikud oma kohustused pakendi ja pakendijäätmete käitlemisel lepinguga üle andnud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "pakendiettevõtja (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pakendiettevotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_probleemtoodete_jaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "probleemtoodete jäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmed, mille kokku kogumist ja taaskasutamist või kõrvaldamist korraldavad probleemtoodete tootjad või tootjate ühendused. JäätS alusel kuuluvad probleemtoodete hulka patareid ja akud, mootorsõidukid ja nende osad, elektri-ja elektroonikaseadmed ja nende osad, rehvid ja põllumajandusplast",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
