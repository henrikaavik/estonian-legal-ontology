      "@id": "estleg:Concept_ehitaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ehitaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
