      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lisatasu täiendavate teenistusülesannete eest",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ette kokkulepitav tasu selle eest, kui keegi täidab ülesandeid, mida tema tavapärane töö ette ei näe või teeb seda oluliselt suuremas mahus oma isikliku aja arvelt ning seniste ülesannete mahtu vähendamata ja tähtaegu muutmata",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054711_Par_2"
        }
      ],
