      "estleg:definitionCount": {
        "@value": "118",
        "@type": "xsd:integer"
      },
      "rdfs:label": "vee",
      "skos:altLabel": [
        {
          "@value": "Vee",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ettevõtja – eraõiguslik juriidiline isik, kes varustab kliendi kinnistu veevärki ühisveevärgi kaudu veega või korraldab ühiskanalisatsiooni kaudu kliendi kinnistu kanalisatsioonist reo- ning sademevee ärajuhtimist; 22",
          "@language": "et"
        },
        {
          "@value": "või reovee mõõtekaev – kaev, kus asub vee- või reoveemõõtesõlm; 28",
          "@language": "et"
        },
        {
          "@value": "ettevõtja - eraõiguslik juriidiline isik, kelle kohaliku omavalitsuse üksus on määranud ühisveevärgi ja –kanalisatsiooni teenuse osutajaks; 34",
          "@language": "et"
        },
        {
          "@value": "ettevõtja – eraõiguslik juriidiline isik, kelle on kohaliku omavalitsuse üksus määranud ühisveevärgi ja -kanalisatsiooni teenuse osutajaks. 22",
          "@language": "et"
        },
        {
          "@value": "ettevõtja – vee-ettevõtja on eraõiguslik juriidiline isik, kelle on kohaliku omavalitsuse üksus määranud ühisveevärgi ja -kanalisatsiooni teenuse osutajaks. 30",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "93",
        "@type": "xsd:integer"
      }
    },
