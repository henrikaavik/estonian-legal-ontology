      "skos:definition": [
        {
          "@value": "Alutaguse Vallavalitsus (edaspidi vallavalitsus ), mis kohaliku omavalitsuse korralduse seaduse kohaselt on valla täitevorgan. Nimetatud seaduse sätetest tulenevalt esindab vallavalitsust temale seadusega, valla põhimäärusega või vallavolikogu poolt antud pädevusele vallavanem; 8",
          "@language": "et"
        },
        {
          "@value": "Räpina Vallavalitsus, mis kohaliku omavalitsuse korralduse seaduse kohaselt on valla täitevorgan. Nimetatud seaduse sätetest tulenevalt esindab vallavalitsust temale seadusega, valla põhimäärusega või vallavolikogu poolt antud pädevusega vallavanem või tema poolt volitatud isik. 9 (",
          "@language": "et"
        },
        {
          "@value": "vallavalitsus, mis kohaliku omavalitsuse korralduse seaduse kohaselt on valla täitevorgan ja mida esindab talle seadusega, valla põhimäärusega või vallavolikogu poolt antud pädevusega vallavanem. 9 (",
          "@language": "et"
        }
      ]
    },
