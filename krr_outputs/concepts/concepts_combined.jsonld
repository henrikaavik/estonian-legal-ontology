      ],
      "skos:prefLabel": {
        "@value": "kinnistu kanalisatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "liitumispunktist kinnistupoolsed ehitised ja seadmed (sealhulgas ehitiste sisekanalisatsioon) kinnistult reovee ärajuhtimiseks ühiskanalisatsiooni",
