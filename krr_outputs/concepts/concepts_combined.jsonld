          "@value": "iseloomulikud tehnilised omadused merekeskkonna seisundi ja survetegurite hindamiseks, mis on seotud käesoleva määruse lisas 1 nimetatud kvalitatiivsete tunnustega",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
