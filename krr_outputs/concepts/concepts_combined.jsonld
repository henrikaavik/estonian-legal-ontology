        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaam, mida paigaldatakse müügi-, teenindus- või ettevõtja muu tegutsemiskoha juurde ajutiselt mingiks ajaperioodiks ööpäeva jooksul, kusjuures reklaam ei ole kohtkindlalt ühendatud maapinna ega ehitisega ning mille pindala on alla 3 m 2",
        "@language": "et"
      },
      "estleg:definedIn": [
