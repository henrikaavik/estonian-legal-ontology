      "skos:definition": [
        {
          "@value": "ja arendustegevusest ja sellega kaasnevatest tegevustest. Uurimisteema täitmine võib olla ajaliselt piiritlemata nagu näiteks õppejõudude uuringute või baasfinantseerimise puhul või ajaliselt piiritletud nagu näiteks institutsionaalse uurimisteema või muu kõrgetasemelise rahvusvahelise projekti puhul; 4",
          "@language": "et"
        }
