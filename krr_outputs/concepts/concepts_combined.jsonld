      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_hea_raamatupidamistava",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hea raamatupidamistava",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev raamatupidamistava, mille põhinõuded kehtestatakse raamatupidamise seaduses, mida täiendavad RTJ-d, FA juhend ja eeskiri",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051084_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõgeva Vallavalitsuse raamatupidamise sise-eeskiri",
