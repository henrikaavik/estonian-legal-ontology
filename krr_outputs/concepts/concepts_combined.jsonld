        }
      ]
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_teehoiu_eeskiri_t1061479_Tee_kaitsevoond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Tee kaitsevöönd",
      "skos:definition": "avalikult kasutatava tee kaitsevöönd on teed ümbritsev maa-ala, mis tagab tee kaitse, teehoiu korraldamise, liiklusohutuse ning vähendab teelt lähtuvaid keskkonnakahjulikke ja inimestele ohtlikke mõjusid. Teel on kaitsevöönd, kui tee on avalikult kasutatav. Tee kaitsevööndi laius äärmise sõiduraja servast mõlemale poole on 20 meetrit. Tänavate kaitsevööndi laius äärmise sõiduraja servast mõlemale poole on 10 meetrit. 7 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061479_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla teehoiu eeskiri",
