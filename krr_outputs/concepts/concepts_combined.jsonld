      "skos:definition": {
        "@value": "rahvastikuregistri andmetel Kuusalu valla 12-26-aastane sportlane, kes on saavutanud spordialal märkimisväärseid tulemusi ning omab treeneri põhjendatud soovituskirja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057451_Par_2"
