      "skos:definition": [
        {
          "@value": "erakordsete teenistusalaste saavutuste eest makstav lisatasu",
          "@language": "et"
        },
        {
          "@value": "kauaaegse laitmatu teenistuse või teenistuskohustuste silmapaistvalt hea täitmise eest kohaldatav ergutus",
          "@language": "et"
        },
        {
          "@value": "erakordsete teenistusalaste saavutuste eest makstav täiendav tasu",
          "@language": "et"
        },
        {
          "@value": "erakordsete teenistus- või tööalaste saavutuste või oodatust tulemuslikuma töö eest makstav tasu",
          "@language": "et"
        },
        {
          "@value": "erakordsete teenistusalaste saavutuste eest määratav ja makstav täiendav tasu",
          "@language": "et"
        }
      ],
