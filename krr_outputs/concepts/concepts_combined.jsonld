        },
        {
          "@id": "estleg:Concept_vormsi_vallavalitsuse_hallatavate_asutuste_palgajuhend_t1058708_tulemustasu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tulemustasu",
      "skos:definition": [
        {
          "@value": "ametiasutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
          "@language": "et"
        },
        {
          "@value": "tulemuspalk vms töötulemuste hindamise alusel makstav täiendav tasu; 2014-06-18",
          "@language": "et"
        },
        {
          "@value": "töötajatele makstav tasu seatud eesmärkide või tööalaste tulemuste või projektipõhiste ülesannete täitmise eest. Tulemustasu maksmise tingimused ja korra kehtestab asutuse juht, arvestades tööfondi võimalusi",
          "@language": "et"
        },
        {
          "@value": "vallavanema või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
