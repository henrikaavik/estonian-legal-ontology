      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "VIN",
      "skos:definition": [
        {
          "@value": "kood ( vehicle identification number ) ehk valmistajatehase tähis, on ainulaadne tähtnumbriline kood, mille annab igale sõidukile valmistaja ning üksikkorras valmistatud sõidukile Transpordiamet eesmärgiga tagada iga sõiduki nõuetekohane identifitseerimine; RT I 2021-07-02 9 102072021009 2021-07-05 123",
          "@language": "et"
        },
        {
          "@value": "kood on 17 tähest ja numbrist koosnev tähistus, mille valmistaja on määranud konkreetse sõiduki tähistamiseks. Tähistamise kord on määratud standardiga ISO 3779-1983; 30",
          "@language": "et"
        },
        {
          "@value": "kood või tehasetunnus on tähtedest ja numbritest koosnev tähistus, mille valmistaja või Maanteeamet on määranud konkreetse sõiduki tähistamiseks.",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_vke",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "VKE",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toetus_digitaalsete_tehnoloogiate_robotite_ja_automatiseerim_t1046845_VKE"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_meetmes_ida_virumaa_linnapiirkond_t1028550_VKE"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "VKE",
      "skos:definition": [
        {
          "@value": "dele investeeringuteks antav abi käesoleva määruse tähenduses on toetus, mida antakse üldise grupierandi määruse artikli 17 alusel. 10 (",
          "@language": "et"
        },
        {
          "@value": "väike- ja keskmise suurusega ettevõtja, kes vastab üldise grupierandi määruse lisas I sätestatud kriteeriumitele; 13",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_vke_on_vaike",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "VKE on väike",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_innovatsiooniosakute_toetusmeetme_tingimused_ja_kord_t332278_VKE_on_vaike"
        },
        {
          "@id": "estleg:Concept_tehnoloogia_arenduskeskuste_toetamise_tingimused_t1026295_VKE_on_vaike"
        },
        {
          "@id": "estleg:Concept_tehnoloogia_arenduskeskuste_toetamise_tingimused_t322357_VKE_on_vaike"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "VKE on väike",
      "skos:definition": [
        {
          "@value": "ja keskmise suurusega ettevõtja Euroopa Komisjoni määruse (EÜ) nr 70/2001 tähenduses, mis käsitleb Euroopa Ühenduse asutamislepingu artiklite 87 ja 88 kohaldamist väikestele ja keskmise suurusega ettevõtjatele antava riigiabi suhtes (EÜT L 10, 13.01.2001, lk 33–",
          "@language": "et"
        },
        {
          "@value": "ja keskmise suurusega ettevõtja, kes vastab Euroopa Komisjoni määruse (EL) nr 651/2014 ELi aluslepingu artiklite 107 ja 108 kohaldamise kohta, millega teatavat liiki abi tunnistatakse siseturuga kokkusobivaks (ELT L 187, 26.06.2014, lk 1–",
          "@language": "et"
        },
        {
          "@value": "ja keskmise suurusega ettevõtja, kes vastab üldise grupierandi määruse lisas I sätestatud kriteeriumitele; 12",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_vke_on_vaikese"
        }
      ]
    },
    {
      "@id": "estleg:Concept_vke_on_vaikese",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "VKE on väikese",
        "@language": "et"
      },
