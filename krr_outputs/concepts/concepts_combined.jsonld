    {
      "@id": "estleg:Concept_energiaarvutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiaarvutus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_nouded_energiamargise_andmisele_ja_energiamargisele_t1029420_energiaarvutus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiaarvutus",
      "skos:definition": [
        {
          "@value": "hoone tüüpilise kasutusega seotud kaalutud energiaerikasutuse arvutus, mis lähtub välis- ja sisekliimast, hoone ja tehnosüsteemide kasutus- ja käiduajast, vabasoojusest, hoone õhupidavusest ning muudest hoonet ehitusprojektis iseloomustavatest andmetest; 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_energiaarvutuse_baasaasta",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiaarvutuse baasaasta",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_hoone_energiatohususe_arvutamise_metoodika_t1029856_energiaarvutuse_baasaasta"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiaarvutuse baasaasta",
      "skos:definition": [
        {
          "@value": "sisekliima- ja energiaarvutuseks koostatud väliskliima andmete kogum, mis põhineb üle-eestilistel kliimaandmetel ajavahemikus 1990–2020; RT I 2024-03-19 1 119032024001 2025-06-01 ; jõustumine muudetud [RT I, 19.02.2025, 1] 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_energiaaudit",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiaaudit",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rohelise_investeerimisskeemi_korterelamute_rekonstrueerimise_t345791_energiaaudit"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiaaudit",
      "skos:definition": [
        {
          "@value": "mõõtmistele ja kogutud andmetele tuginev analüüs, mis selgitab energiakasutust sisekliima tagamisega hoones või selle eraldi kasutatavas osas, annab ülevaate hoone tehnilisest seisukorrast, energiakadudest ning võimalikest meetmetest energia ja kütuse kokkuhoiuks ja sisekliima parandamiseks hoones. Energiaauditis peavad sisalduma ka andmed erinevate rekonstrueerimistööde tulemusena saavutatavate energiasäästu määrade kohta. Energiaauditis tuuakse välja võimalikud rekonstrueerimistööde paketid koos paketis nimetatud tööde koosmõjuna saavutatava energiasäästuga; 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_energiabilanss",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiabilanss",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_elamu_energiaauditile_esitatavad_nouded_t1029194_energiabilanss"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiabilanss",
      "skos:definition": [
        {
          "@value": "elamu energia kasutuse analüüsi tulemusena saadav tarnitud energia ja energiavajaduse tasakaal. Energiabilansis kajastatakse elamu energia kadude jaotust sisekliima tagamiseks (kütmiseks, jahutamiseks, ventilatsiooniks ja valgustuseks), tarbevee soojendamiseks, tehnosüsteemide ja elektriseadmete kasutamiseks ning energiaallikate jaotuskadude kompenseerimiseks; 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_energiakandjate_kaalumistegurid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiakandjate kaalumistegurid",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_hoone_energiatohususe_arvutamise_metoodika_t1029856_energiakandjate_kaalumistegurid"
        },
        {
          "@id": "estleg:Concept_nouded_energiamargise_andmisele_ja_energiamargisele_t1029420_energiakandjate_kaalumistegurid"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiakandjate kaalumistegurid",
      "skos:definition": [
        {
          "@value": "tegurid, millega võetakse arvesse tarnitud energia tootmiseks vajalik primaarenergia kasutus ja selle keskkonnamõju. Energiakandjate kaalumistegurite arvväärtused on sätestatud ehitusseadustiku § 65 lõike 3 alusel kehtestatud määruses hoone energiatõhususe miinimumnõuete kohta (edaspidi energiatõhususe miinimumnõuete määrus ); 3",
          "@language": "et"
        },
        {
          "@value": "tegurid, millega võetakse arvesse tarnitud energia tootmiseks vajalik primaarenergia kasutus ja selle keskkonnamõju; 8",
          "@language": "et"
        }
      ]
    },
    {
