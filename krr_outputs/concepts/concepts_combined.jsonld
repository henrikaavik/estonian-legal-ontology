        {
          "@value": "taotleja, vastuvõtva ameti, Rahvusvahelise Büroo ja teiste PCT ametite toimingud, mis on sooritatud enne PCT taotluse esitamist Patendiametile kui märgitud ametile või märgitud ja väljavalitud ametile; 8",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_rahvusvaheline_patenditaotlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rahvusvaheline patenditaotlus",
