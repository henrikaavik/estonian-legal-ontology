        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaubanduse korraldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tänava- või turukaubandust korraldav isik või asutus (s. h Alutaguse Vallavalitsus (edaspidi ametiasutus ), ametiasutuse hallatav asutus, avaliku ürituse korraldaja või maa-ala valdaja või omanik); 5) tänava- ja turukaubandus – kauba või teenuse müük käest, käsikorvist, kandelaualt või muust kaupleja poolt kantavast või liigutatavast inventarist või kaupleja paigaldatud ajutiselt müügikohalt, müügiletilt või -kärult, autolt või selle haagiselt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052050_Par_2"
        }
      ],
