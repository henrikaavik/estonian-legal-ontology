      "skos:altLabel": [
        {
          "@value": "Ohustamine",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "lemmikloomapidaja tegevus või tegevusetus, millega seatakse ohtu teiste inimeste elu, tervis või vara või teiste loomade elu ja tervis",
          "@language": "et"
        },
        {
          "@value": "inimeste elu, tervist või vara ohtu asetav tegevus",
          "@language": "et"
        },
        {
          "@value": "kaaskodanike elu, vara või tervist ohtu seadev või kahjustav tegevus",
          "@language": "et"
        },
        {
          "@value": "on vara, kaaskodanike elu või tervist ohtu asetav tegevus või tegevusetus",
          "@language": "et"
        },
        {
          "@value": "vara, kaaskodanike elu või tervist ohtu asetav tegevus",
          "@language": "et"
        }
      ],
