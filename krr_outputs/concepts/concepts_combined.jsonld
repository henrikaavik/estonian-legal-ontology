      },
      "rdfs:label": "avalik ala",
      "skos:definition": [
        {
          "@value": "koht või keskkond, mis on ligipääsetav kõikidele inimestele (nt linna haljasalad, pargid jne).",
          "@language": "et"
        },
        {
          "@value": "Rae valla omandis või Rae valla omandisse antav ala, mis on igaühele kasutamiseks mõeldud terviklik ja sidus välisruum, mis koosneb tänavatest, kergliiklusteedest ning nendega seotud teenustest, külaplatsidest ja väljakutest, rohe- ja pargialadest, mänguväljakutest ning muudest samalaadsetest paikadest; 3",
          "@language": "et"
        },
        {
          "@value": "Tallinna linna omandis olev igaühele vabalt ligipääsetav ja kasutatav maa-ala; 3",
          "@language": "et"
        },
        {
          "@value": "Viimsi vallale kuuluv kõigile vabalt ligipääsetav ja kasutatav maa-ala; 4",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_avalik_maa"
        },
        {
          "@id": "estleg:Concept_avalik_vara"
        }
      ]
    },
