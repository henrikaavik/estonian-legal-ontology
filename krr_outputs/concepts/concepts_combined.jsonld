    {
      "@id": "estleg:Concept_maardu_linna_jaatmehoolduseeskiri_t1055314_biolagunevad_koogi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "biolagunevad köögi",
      "skos:definition": "ja sööklajäätmed on kodumajapidamises, büroos, jaemüügikohas, hulgimüügiettevõttes ja toitlustusasutuses tekkinud toidu- ja köögijäätmed nagu puu- ja köögiviljade puhastamise jäägid, liha- ja kalajäägid, poolfabrikaadid, kohvi- ja teepuru, sh filtrid, pagaritooted jmt; 3",
