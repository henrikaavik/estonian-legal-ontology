        "@id": "estleg:Concept_koduteenused"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_koduteenuse_osutamise_kord_t1043350_pohiteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhiteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on koduteenus, mis aitab harjumuspärases keskkonnas toime tulla ning võimaldab isikul jätkata elamist kodus, 1.",
        "@language": "et"
      },
      "estleg:definedIn": [
