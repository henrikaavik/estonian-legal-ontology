      },
      "skos:definition": {
        "@value": "kodumajapidamistest kogutud segajäätmed ja liigiti kogutud jäätmed, sealhulgas paber ja kartong, klaas, metallid, plast, biojäätmed, puit, tekstiil, pakendid, elektri- ja elektroonikaseadmetest tekkinud jäätmed, patareid ja akud ning suuremõõtmelised jäätmed, sealhulgas madratsid ja mööbel",
        "@language": "et"
      },
