          "@id": "estleg:Concept_voru_valla_heakorraeeskiri_t1044236_omanik"
        }
      ],
      "estleg:definitionCount": {
        "@value": "27",
        "@type": "xsd:integer"
      },
      "rdfs:label": "omanik",
      "skos:definition": [
        {
          "@value": "füüsiline või juriidiline isik, kelle omandis on kinnistu või vallasasi. Omanikuga on eeskirja nõuete täitmisel võrdsustatud tema poolt volitatud valdaja, haldaja või kasutaja",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kelle omandis on kinnistu või vallasasi. Omanikuga on võrdsustatud isik, kes õiguslikul alusel asja valdab või kasutab või kes on omaniku poolt volitatud asja haldama",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kelle omandis on kinnisasi või vallasasi. Omanikuga on eeskirjas võrdsustatud ka kinnistamata maaüksuse valdaja ja/või valitseja. Juhul, kui omaniku poolt sõlmitud leping ei kehtesta teise poole kohustusi heakorra tagamiseks, lasub nimetatud kohustus omanikul",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kelle omandis on kinnistu või ehitis vallasasjana, või isik, kelle kasuks on seatud hoonestusõigus, samuti omanikuga on võrdsustatud isik, kes on omaniku poolt volitatud asja valdama, haldama või kasutama",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kelle omandis on kinnistu või ehitis vallasasjana, või isik, kelle kasuks on seatud hoonestusõigus. Omanikuga heakorra nõuete täitmisel on võrdsustatud tema volitatud valdaja, haldaja või kasutaja. Juhul, kui omaniku sõlmitud leping ei kehtesta teise poole kohustusi heakorra tagamiseks, lasub nimetatud kohustus omanikul",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "20",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
