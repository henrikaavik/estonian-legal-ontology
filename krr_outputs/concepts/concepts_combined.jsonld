    {
      "@id": "estleg:Concept_konkursi_narva_ettevotja_labiviimise_korra_kinnitamine_t1061582_Mikroettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Mikroettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "raamatupidamiskohustuslane, kelle aruandekuupäeva näitajatest kaks ei ületa järgmisi näitajaid: varad kokku 450 000 eurot, aruandeaasta tulu 900 000 eurot ja keskmine töötajate arv aruandeaasta jooksul 10 inimest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061582_Par_2"
        }
      ],
      "estleg:sourceAct": "Konkursi “Narva Ettevõtja” läbiviimise korra kinnitamine",
