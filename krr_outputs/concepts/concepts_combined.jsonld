        "@id": "estleg:Concept_juhtpartner"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_euroopa_uhenduse_algatuse_interreg_programmide_elluviimise_k_t158972_projektipartner",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "projektipartner",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidiline isik või asutus, kes ei ole projekti juhtpartner, kuid kes on kaasatud Interreg programmist toetatava projekti elluviimisse ning kes kasutab oma tegevuste elluviimiseks struktuuritoetust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_158972_Par_2"
        }
      ],
