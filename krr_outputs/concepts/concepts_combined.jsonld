      ],
      "skos:prefLabel": "energiamärgis",
      "skos:definition": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav märgis, mis annab infot projekteeritava või olemasoleva hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
