      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "avariikaevetöö",
      "skos:definition": [
        {
          "@value": "kaevetöö, mille tegemise vajadus tekib ootamatult ja mis on ebasoovitavaid tagajärgi silmas pidades edasilükkamatu",
          "@language": "et"
        },
        {
          "@value": "kaevetöö, mille tegemise vajadus tekib ootamatult ja mis on ulatuslike ebasoovitavate tagajärgede tõttu edasilükkamatu",
          "@language": "et"
        },
        {
          "@value": "kaevetöö, mille tegemise vajadus tekib ootamatult ja on vajalik tehnovõrgu avarii likvideerimiseks juhul, kui kaevetöö alustamisega viivitamine põhjustab olulise materiaalse kahju, takistab vastava elutähtsa teenuse osutamist tarbijatele või ohustab inimesi, ehitisi, keskkonda. Avariikaevetööna on põhjendatud maagaasi-, ühisvee ja -kanalisatsiooni- ja soojatrasside lekete likvideerimine, elektri ja sideliinide avariide likvideerimine; 3) kaevetöö tegija (edaspidi kaevaja) - füüsiline või juriidiline isik, kes teostab kaevetööd kaevetöö loa alusel või kes teostab avariikaevetööd tehnovõrgu valdaja poolt kinnitatud avariikaevetöö akti alusel",
          "@language": "et"
        },
        {
          "@value": "on kaevetöö, mille tegemise vajadus tekib ootamatult ja mis on ulatuslike ebasoovitavate tagajärgede tõttu edasilükkamatu ning millest võib tuleneda suur kahju kinnisasja või tehnorajatise omanikule või valdajale",
          "@language": "et"
        },
        {
          "@value": "kaevetööd, mille tegemise vajadus tekib ootamatult ja mis on ulatuslike ebasoovitavate tagajärgede tõttu edasilükkamatud. Avariikaevetööle kehtivad kõik käesoleva eeskirja nõuded",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:altLabel": [
