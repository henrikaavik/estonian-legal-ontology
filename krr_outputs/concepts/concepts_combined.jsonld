    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_kompetentsikeskus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kompetentsikeskus",
      "skos:definition": "piirkonna teadus- ja arendusasutuste ning haridusasutuste, ettevõtjate ja avaliku võimu esindajatest koosnev sektoritevahelisel koostööl põhinev ühendus, mis omab kindlaid kompetentse ja ressursse ning tegutseb ettevõtluse arendamise eesmärgil koondades, vahendades, rakendades ja arendades neid ressursse ja kompetentse; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
