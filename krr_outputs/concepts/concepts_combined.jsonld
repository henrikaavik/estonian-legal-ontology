      "skos:definition": [
        {
          "@value": "hoone tüüpilise kasutusega seotud kaalutud energiaerikasutuse arvutus, mis lähtub välis- ja sisekliimast, hoone ja tehnosüsteemide kasutus- ja käiduajast, vabasoojusest, hoone õhupidavusest ning muudest hoonet ehitusprojektis iseloomustavatest andmetest",
