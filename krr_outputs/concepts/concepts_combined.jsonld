        {
          "@value": "teenistuja personaalsest vajadusest lähtuv, eelkõige tema enda poolt välja valitud teenistusalaseid teadmisi arendav, kompetentse tõstev või muul viisil tööalast sooritust toetav täienduskoolitus, sh tasemekoolitus või loeng tasemekoolituse õppekavast.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
