      "@id": "estleg:Concept_saue_linna_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeskir_t1036783_reostusgrupp",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reostusgrupp",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee reostustaset näitavate reostusnäitajate vahemik, mis on aluseks ülenormatiivse reostuse tasu kehtestamisele. Reostusgrupp on veeteenuse hinna alus. Konkurentsiametiga kooskõlastatud veeteenuse hinna kehtestab vee-ettevõtja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1036783_Par_2"
        }
      ],
