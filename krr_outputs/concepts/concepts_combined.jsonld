      "rdfs:label": "purgimiskoht",
      "skos:definition": [
        {
          "@value": "koht, mis on määratud kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas tekkekohast äraveetud reovee ühiskanalisatsiooni juhtimiseks",
          "@language": "et"
        },
        {
          "@value": "tekkekohast äraveetud reovee või fekaalide ühiskanalisatsiooni laskmise koht",
          "@language": "et"
        },
        {
          "@value": "tekkekohast äraveetud reovee ja/või fekaalide ühiskanalisatsiooni laskmise koht",
          "@language": "et"
        },
        {
          "@value": "tekkekohast äraveetud reovee ühiskanalisatsiooni laskmise koht",
          "@language": "et"
        },
        {
          "@value": "tekkekohast ära veetud reovee või fekaalide ühiskanalisatsiooni laskmise koht",
          "@language": "et"
        }
      ],
