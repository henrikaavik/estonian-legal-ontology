      },
      "skos:definition": {
        "@value": "kontokombinatsioonide ja nende saldode järjestatud loetelu üldeeskirja lisades toodud kontoplaani järgi; 15) sissetulekud ja väljaminekud (laekumised ja tasumised) – valla tulud, kulud, investeeringud ja finantseerimistehingud rahalises väljenduses",
        "@language": "et"
      },
      "estleg:definedIn": [
