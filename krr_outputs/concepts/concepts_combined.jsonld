      "rdfs:label": "alaline elukoht",
      "skos:definition": [
        {
          "@value": "elukoht, kus isik veedab enamiku oma igapäevasest puhke- ja uneajast",
          "@language": "et"
        },
        {
          "@value": "elukoha aadress, kus isik veedab enamiku oma igapäevasest puhke- ja uneajast",
          "@language": "et"
        },
        {
          "@value": "elukoha aadress, kus isik alaliselt või peamiselt elab",
          "@language": "et"
        },
        {
          "@value": "kinnistul asuv elamu, mille aadress on rahvastikuregistris registreeritud isiku põhielukohana ning mida kasutatakse aastaringselt",
          "@language": "et"
        },
        {
          "@value": "kinnistul asuv üksikelamu, mis on rahvastikuregistrisse märgitud elukoha aadressina",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
