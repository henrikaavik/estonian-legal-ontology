      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_biolagunevad_aia"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kuusalu_valla_jaatmehoolduseeskiri_t1055504_bioloogiliselt_mittelagunevad_aia",
