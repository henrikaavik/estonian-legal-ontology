    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_detailplaneering",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "detailplaneering",
      "skos:definition": "on konkreetse maa-ala kohta koostatav terviklik ruumilahendus, millega määratakse seaduses sätestatud juhtudel maakasutus- ja ehitustingimused ning mis vastab PlanS § 3 sätestatule. Detailplaneeringus tuuakse välja detailplaneeringukohased avalikuks kasutamiseks ette nähtud teed ja sellega seonduvad rajatised, haljastus, välisvalgustus ning tehnorajatised; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "detailplaneering (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_detailplaneering"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_detailplaneering"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_taristu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "taristu",
      "skos:definition": "detailplaneeringuga määratud kütte-, veevarustus-, sademevee- ja kanalisatsioonitorustikud (maaparandussüsteemide rajatised, sademevee kraavid ja –truubid), telekommunikatsiooni- nõrkvoolu- ja elektrivõrgud, küttegaasi- ja elektripaigaldised, tuletõrje veevõtukoht (hüdrant/mahutid), surveseadmestikud ja nende teenindamiseks vajalikud ehitised, välisvalgustus jms. 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "taristu (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_taristu"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_taristu"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_avalik_ruum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "avalik ruum",
      "skos:definition": "detailplaneeringuga määratud avalikult kasutatavad teed (sh tee materjalist tõstetud künnised, ümberkeeramis koht - minimaalsuurusega 12x12 meetrit), valgustatud kergliiklusteed, liikluskorralduslik parkimislahendus, üldkasutatav haljasala, jäätmete liigiti kogumise plats (valgustatud ja liikluskorralduslikult lihtsa ligipääsuga ~ 30 m2 ala), mänguväljakud (sisaldades erivanuses kasutajate mänguvahendeid) ja heakorraelemendid jms. 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "avalik ruum (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_ruum"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_avalik_ruum"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_hupoteek",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "hüpoteek",
      "skos:definition": "hüpoteek on kinnisasja pant, mis kantakse kinnistusraamatusse neljandasse jakku. Isikul, kelle kasuks on hüpoteek seatud (hüpoteegipidajal), on õigus hüpoteegiga tagatud nõude rahuldamisele panditud kinnisasja arvel. Teiste sõnadega – kui hüpoteegiga tagatud nõuet ei rahuldata, on hüpoteegipidajal õigus nõuda hüpoteegiga koormatud kinnisasja müüki läbi kohtutäituri; 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055909_Par_1"
        }
      ],
      "estleg:sourceAct": "Kastre valla rajatiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kokkuleppimise kord",
      "rdfs:label": "hüpoteek (kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hupoteek"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_hupoteek"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_hoidumisservituut",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "hoidumisservituut",
      "skos:definition": "hoidumisservituudi sisuks on detailplaneeringuga hõlmatud kinnistute igakordsete omanike, samuti nimetatud kinnistute jagamise tulemusena tekkivate kinnistute igakordsete omanike kohustus hoiduda kinnistule detailplaneeringuga ette nähtud hoonete ehitustegevuse alustamisest enne lepinguga võetud kohustuste täitmist.",
      "estleg:definedIn": [
