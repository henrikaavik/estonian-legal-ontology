      },
      "rdfs:label": "reovee kohtkäitlusrajatis",
      "skos:definition": [
        {
          "@value": "lekkekindel kogumismahuti (sh kuivkäimla lampkast) või omapuhasti; 4",
          "@language": "et"
        },
        {
          "@value": "lekkekindel reovee kogumismahuti, omapuhasti või kuivkäimla lampkast; 3",
          "@language": "et"
        },
        {
          "@value": "reovee kogumismahuti (sh kuivkäimla lampkast) või omapuhasti (septik filterväljakuga või biopuhasti imbväljakuga); 4",
          "@language": "et"
        },
        {
          "@value": "reovee kogumismahuti (sh kuivkäimla lampkast) või omapuhasti (septik filterväljakuga või biopuhasti imbväljakuga); 6",
          "@language": "et"
        },
        {
          "@value": "reovee kogumismahuti (sh kuivkäimla lampkast) või omapuhasti (septik) ning nendega kaasnev torustik; 6",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "21",
