      },
      "rdfs:label": "linna raamatupidamiskeskus",
      "skos:definition": [
        {
          "@value": "linna finantsteenistuse struktuuriüksus, kes linna pearaamatupidaja juhtimisel korraldab linna ning linna asutuste (LRK üksuste) majandusarvestust ja finantsaruandlust ning osutab LRK üksustele ja vastava kokkuleppe alusel linna osalusega eraõiguslikele juriidilistele isikutele raamatupidamisteenust; 2025-06-17 RT IV 2025-06-28 8 428062025008 2025-07-01 19",
          "@language": "et"
        }
      ]
    },
