      "rdfs:label": "ametiasutus",
      "skos:altLabel": [
        {
          "@value": "Ametiasutus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "Saue valla ametiasutus Saue Vallavalitsus; 2",
          "@language": "et"
        },
        {
          "@value": "vallavalitsus kui ametiasutus; 2",
          "@language": "et"
        },
        {
          "@value": "Jõhvi Vallavalitsus ametiasutusena; 2",
          "@language": "et"
        },
        {
          "@value": "kohaliku omavalitsuse üksuse eelarvest finantseeritav asutus, kelle ülesanne on avaliku võimu teostamine; 2",
          "@language": "et"
        },
        {
          "@value": "Rakvere Linnavalitsus ametiasutusena (koos struktuuriüksustega), sh linnavalitsuse või ametiasutuse poolt haldusmenetluse seaduse § 8 lg 2 alusel ülesannet täitma määratud ametnik või ametnikud.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "30",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_ametiasutuse_hallatav_asutus",
