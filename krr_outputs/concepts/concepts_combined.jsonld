        "@type": "xsd:integer"
      },
      "rdfs:label": "reklaamimaks",
      "skos:definition": [
        {
          "@value": "tasu reklaami avalikustamise eest",
          "@language": "et"
        },
        {
          "@value": "Harku valla territooriumil reklaami avaldamise eest käesolevas määruses sätestatud korras, ulatuses ja tähtaegadel tasumisele kuuluv maks",
          "@language": "et"
        },
        {
          "@value": "Kambja valla avalik-õiguslike ülesannete täitmiseks vajaliku tulu saamise ja vallapildi kujundamise eesmärgil reklaamimaksu maksja poolt käesolevas määruses sätestatud korras, suuruses ja tähtaegadel ilma otsese vastutasuta tasumisele kuuluv kohalik maks",
          "@language": "et"
        },
        {
          "@value": "käesoleva määrusega kehtestatud kohalik maks",
          "@language": "et"
        },
        {
          "@value": "Saue valla territooriumil reklaami avaldamise eest käesolevas määruses sätestatud korras, ulatuses ja tähtaegadel tasumisele kuuluv maks (edaspidi maks)",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
