      "rdfs:label": "infovara",
      "skos:altLabel": [
        {
          "@value": "Infovara",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "informatsioon, andmed ja nende töötlemiseks vajalikud infotehnoloogilised rakendused ning tehnilised vahendid; 4",
          "@language": "et"
        },
        {
          "@value": "mistahes kujul talletatud andmed ja informatsioon, mis on asutusele väärtuslik ja mida asutus kasutab oma põhimääruses ettenähtud ülesannete täitmiseks ning asutuse omandis olevad infotöötlusvahendid, rakendused ja taristu, mis tagavad asutusele informatsiooni nõuetekohase töötlemise; 2",
          "@language": "et"
        },
        {
          "@value": "ameti infosüsteemide varad (edaspidi infovara) on käesoleva poliitika tähenduses ametis kasutusel olevad infotehnoloogilised vahendid ja viimaste abil töödeldavad andmed. Infotehnoloogilised vahendid on riist-, tarkvara ja andmesideseadmed. 3 (",
          "@language": "et"
        },
        {
          "@value": "asutuse valduses või vastutusel olev teave ja andmed (sh isikuandmed, töö- ja menetlusdokumendid, registri- ja andmekogude andmed, logid), sõltumata vormist ja kandjast; vajadusel kasutatakse infovara kirjeldamisel eraldi mõistena „infosüsteem” ning „taristu”; 7",
          "@language": "et"
        },
        {
          "@value": "informatsioon, andmed ja nende töötlemiseks vajalikud infotehnoloogilised rakendused ning tehnilised vahendid. 6 (",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "9",
        "@type": "xsd:integer"
      }
    },
