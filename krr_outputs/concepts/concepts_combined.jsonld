    },
    {
      "@id": "estleg:Concept_puudega_isiku_eluruumi_kohandamise_kulude_huvitamise_kord_t1043349_leping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "leping",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitustööde teostamiseks ja tööde eest tasumiseks sõlmitavad lepingud, kus lepitakse kokku kohanduse saaja õigused ja kohustused. Eluruumi kohandamise kuludeks ei loeta tehnilise abivahendi ostmise kulusid, kui tehniline abivahend on võimalik osta sotsiaalhoolekande seaduse § 47 lõike 5 alusel. Toetatavad tegevused on: 1) liikuvusega seotud toimingute parandamine, sealhulgas eluruumi sissepääsu, hoone välisukse ja eluruumi vahelise käigutee, hoone ja selle territooriumile sissepääsu või piirde kohandamine; 2) hügieenitoimingute parandamine; 3) köögitoimingute parandamine.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043349_Par_2"
        }
      ],
      "estleg:sourceAct": "Puudega isiku eluruumi kohandamise kulude hüvitamise kord",
      "rdfs:label": "leping (puudega_isiku_eluruumi_kohandamise_kulude_huvitamise_kord_t1043349)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_leping"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
