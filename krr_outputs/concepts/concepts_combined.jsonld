          "@id": "estleg:Concept_majandus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_viimsi_valla_reklaamimaarus_t1039864_majandus_viimsi_valla_reklaamimaarus_t1039864_1_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "majandus",
      "skos:definition": "või kutsetegevuse koha tähistust selle nime, liigi, kauba müügi või teenuse osutamise aja, isiku nime, kaubamärgi ja domeeninimega ehitisel või tänavakaubanduse kioskil, kus majandus- või kutsetegevuse koht asub ja majandus- või kutsetegevuse koha sissepääsu juures; 3",
      "estleg:definedIn": [
