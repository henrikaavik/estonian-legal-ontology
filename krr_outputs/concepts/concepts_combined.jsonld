    {
      "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_teaduse_tippkeskus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teaduse tippkeskus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "mitme silmapaistvalt kõrge tasemega uurimisrühma ühendus, mille eesmärgiks on koostöö ja ühistegevuse kaudu tõsta läbiviidavate teadus- ja arendustegevuse taset, tulemuslikkust ja mõju; 4) teaduse tippkeskuse toetus (edaspidi toetus ) – vähemalt kahe teadus- ja arendusasutuse, ülikooli või evalveeritud rakenduskõrgkooli kolme või enama kõrgetasemelise uurimisrühma nii siseriiklikku kui rahvusvahelist koostööd toetav rahastusmeede, mis eraldatakse rahvusvahelisel tipptasemel ja läbimurdelise teadustulemuste saamiseks ja levitamiseks Eestile olulistes valdkondades; 5) kõrge riski, suure kasupotentsiaaliga teadus- ja arendustegevus – eksperimentaalne või teoreetiline uurimistöö, millel on oma uudsuse, ainulaadsuse või interdistsiplinaarsuse tõttu suur risk ebaõnnestuda, kuid mille õnnestumisel tekkinud uus teadmine on murranguline, erinedes silmapaistvalt senisest teadmistest ja praktikatest või millel on potentsiaalne rakendusala paljudes eri teadusvaldkondades",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062228_Par_2"
        }
      ],
      "estleg:sourceAct": "Teaduse tippkeskuste nimetamise ning finantseerimise tingimused ja kord",
      "rdfs:label": "teaduse tippkeskus (teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teaduse_tippkeskus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_labimurdeline_teadustulemus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "läbimurdeline teadustulemus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kõrge riski ja suure kasupotentsiaaliga teadus- ja arendustegevuse tulemusel tekkiv murranguline uus teadmine, mis mõjutab oluliselt ühe või mitme valdkonna seniseid teadmisi ja/või praktikaid; 7) teadus- ja arendustöötaja – isik, kes töötab teadus- ja arendusasutuses, ülikoolis või evalveeritud rakenduskõrgkoolis kas akadeemilise töötajana, teadus- ja arendusspetsialistina või insenerina, ning teadus- ja arendusasutuse, ülikooli või evalveeritud rakenduskõrgkooli ja selle struktuuriüksuse juht, kes korraldab teadus- ja arendustegevuse kavandamist ning elluviimist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062228_Par_2"
        }
      ],
      "estleg:sourceAct": "Teaduse tippkeskuste nimetamise ning finantseerimise tingimused ja kord",
      "rdfs:label": "läbimurdeline teadustulemus (teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_labimurdeline_teadustulemus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_uurimisruhm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "uurimisrühm",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teadus- ja arendusasutuses, ülikoolis või evalveeritud rakenduskõrgkoolis töötavate teadus- ja arendustöötajate rühm, mis koosneb uurimisrühma juhist, põhitäitjatest ja täitjatest ning mis tegeleb vähemalt ühe käimasoleva teadus- ja arendusprojekti läbiviimisega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062228_Par_2"
        }
      ],
      "estleg:sourceAct": "Teaduse tippkeskuste nimetamise ning finantseerimise tingimused ja kord",
      "rdfs:label": "uurimisrühm (teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uurimisruhm"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_uurimisruhma_juht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "uurimisrühma juht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "doktorikraadi või sellele vastava kvalifikatsiooniga rahvusvaheliselt kõrge tasemega teadus- ja arendustegevuse läbiviimise kogemusega teadus- ja arendustöötaja, kellel on taotlemise hetkel kehtiv tööleping Eesti teadus- ja arendusasutuse, ülikooli või evalveeritud rakenduskõrgkooliga, töö asukohaga Eestis, ning kes on vähemalt ühe käimasoleva teadus- ja arendusprojekti vastutav täitja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062228_Par_2"
        }
      ],
      "estleg:sourceAct": "Teaduse tippkeskuste nimetamise ning finantseerimise tingimused ja kord",
      "rdfs:label": "uurimisrühma juht (teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uurimisruhma_juht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_pohitaitja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhitäitja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "doktorikraadi või sellele vastava kvalifikatsiooniga teadus- ja arendustegevust teostav isik, kes töötab teaduse tippkeskuse tegevuse elluviimise ajal Eesti teadus- ja arendusasutuses, ülikoolis või evalveeritud rakenduskõrgkoolis ja kuulub teaduse tippkeskuse uurimisrühma; 11) teadus- ja arendusprojekt – Eesti Teadusinfosüsteemis kajastuv taotlemise aastal käimasolev teadus- ja arendusprojekt, mille eesmärk on luua uut teadmist ning mille periood on vähemalt kaks aastat ja mille rahastuse maht on kokku vähemalt 210 000 eurot",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062228_Par_2"
        }
      ],
      "estleg:sourceAct": "Teaduse tippkeskuste nimetamise ning finantseerimise tingimused ja kord",
      "rdfs:label": "põhitäitja (teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pohitaitja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
