        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kogumine, puhastamine, pinnasesse immutamine, suublasse juhtimine või taaskasutamine, sealhulgas kompostimine, üldjuhul reovee tekkekoha kinnistu piires",
