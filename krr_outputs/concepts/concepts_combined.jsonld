          "@value": "ehitise pinna kasutusse andmisel pakkumise esitanud isik",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik või füüsilisest isikust ettevõtja, kes on esitanud linnarajatise kaubandustegevuseks kasutusse andmiseks pakkumise või taotluse",
          "@language": "et"
        },
        {
          "@value": "isik, kes on vähempakkumisele pakkumise esitanud",
          "@language": "et"
        },
        {
          "@value": "projektiga kavandatavas hankes pakkumuse esitav või esitanud ettevõtja",
          "@language": "et"
        }
      ],
