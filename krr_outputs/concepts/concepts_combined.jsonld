      },
      "rdfs:label": "huvitegevus",
      "skos:altLabel": [
        {
          "@value": "Huvitegevus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal. 3",
          "@language": "et"
        },
        {
          "@value": "harrastus; 2",
          "@language": "et"
        },
        {
          "@value": "juhendatud tegevust süvendatud teadmiste ja oskuste omandamiseks valitud huvialal. 3",
          "@language": "et"
        },
        {
          "@value": "läbiviimise koht ei ole üheselt määratletud. Viiakse läbi huviringidena koolis, noortekeskustes, noorteühingute, seltsimajade, kultuurimajade, raamatukogude juures ja mujal, kus toimub regulaarne ja süsteemne juhendamine vastavalt noorsootöö seaduses kirjeldatud definitsioonile ja noorsootöö põhimõtetele; 4",
          "@language": "et"
        },
        {
          "@value": "lühiajaline juhendatud huvialaga tegelemine vaba tahte alusel tasemeõppest ja tööst vabal ajal teadmiste ja oskuste omandamiseks valitud huvialal; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "29",
        "@type": "xsd:integer"
      }
    },
