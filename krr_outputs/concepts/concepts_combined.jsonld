      "rdfs:label": "suverühm",
      "skos:definition": [
        {
          "@value": "Keila linna lasteaia juures suveperioodil (juulikuus) vastavalt vajadusele töötav lasteaiarühm, kuhu võetakse lasteaias juba kohta kasutavaid lapsi vanema avalduse alusel",
          "@language": "et"
        },
        {
          "@value": "Keila linna lasteaia juures suveperioodil (juulikuus) vastavalt võimalusele ja vajadusele töötav lasteaiarühm, kuhu võetakse Keila lasteaedades juba kohta kasutavaid lapsi vanema või üksikvanema avalduse alusel.",
          "@language": "et"
        },
        {
          "@value": "valla lasteasutuse juures töötav lasteaiarühm, mis töötab suvekuudel (juuni, juuli, august) ning kuhu võetakse vanema avalduse alusel lapsi, kes juba kasutavad lasteaiakohta.",
          "@language": "et"
        },
        {
          "@value": "valla lasteasutuse juures töötav lasteaiarühm, mis töötab suvekuudel valla teiste lasteasutuste kinnioleku ajal",
          "@language": "et"
        }
      ],
