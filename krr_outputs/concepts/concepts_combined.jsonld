      ],
      "estleg:definitionCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "heakord",
      "skos:definition": [
        {
          "@value": "Kiili valla haldusterritooriumi puhtus ja korrastatus. Avalikku heaolu ja kvaliteetset elukeskkonda soodustavad tegevused kinnis- ja vallasvara ning avaliku koha korrashoiu, puhtuse, ohutuse ja seisundi tagamiseks; 2",
          "@language": "et"
        },
        {
          "@value": "kinnistu ja avaliku ruumi korrashoid, mis on tagatud läbi heakorratööde, näiteks jäätmete, libedustõrjeks kasutatud puistmaterjali jääkide, lume ja jää koristamine ning libedustõrje tegemine, niitmine, murdunud puude ja okste likvideerimine, võsaraie ja mahalangenud lehtede koristamine jm; 6",
          "@language": "et"
        },
        {
          "@value": "kinnistu ja avaliku ruumi korrashoid, mis on tagatud läbi korrashoiu tööde; 3",
          "@language": "et"
        },
        {
          "@value": "kinnistu ja kõnnitee puhtus ja korrastatus; 4",
          "@language": "et"
        },
        {
          "@value": "kinnistu ja kõnnitee puhtus ning korrastatus; 2",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_heakorratoo",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
