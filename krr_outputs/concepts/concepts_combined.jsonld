      },
      "rdfs:label": "omafinantseering",
      "skos:definition": [
        {
          "@value": "osa projekti abikõlblikest kuludest, mille katab rahaliselt toetuse saaja või partner",
          "@language": "et"
        },
        {
          "@value": "toetuse saaja rahaline panus abikõlblike kulude katmisse. Omafinantseeringuna ei käsitata teisi kohaliku omavalitsuse, riigi või Euroopa Liidu institutsioonide või fondide antud tagastamatuid toetusi",
          "@language": "et"
        },
        {
          "@value": "abikõlblik kulu, mida toetusest ei hüvitata ja mille tasub toetuse saaja või partner",
          "@language": "et"
        },
        {
          "@value": "Interreg programmi raames struktuuritoetuse saamiseks Eesti partnerilt nõutav rahaline ja/või mitterahaline panus. Omafinantseering võib koosneda Eesti partneri omavahenditest ja/või Eesti avaliku sektori eraldistest",
          "@language": "et"
        },
        {
          "@value": "linna rahaline ja/või mitterahaline kohustus projekti elluviimiseks, mille linn eraldab oma eelarve piires või mida ta korras sätestatud juhul taotleb Kiviõli linna eelarve reservfondist (linn või linna hallatav asutus osaleb projektis juhtpartnerina)",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "18",
        "@type": "xsd:integer"
      },
