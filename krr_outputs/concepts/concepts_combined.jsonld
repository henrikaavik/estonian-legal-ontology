    {
      "@id": "estleg:Concept_kuusalu_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ees_t1024398_Vee_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eraõiguslik juriidiline isik, kes varustab kliendi kinnistu veevärki ühisveevärgi kaudu veega või korraldab ühiskanalisatsiooni kaudu kliendi kinnistu kanalisatsioonist reovee või kinnistult sademevee ärajuhtimist. Vee-ettevõtja määrab Kuusalu vallavalitsus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1024398_Par_2"
        }
      ],
      "estleg:sourceAct": "Kuusalu valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "Vee-ettevõtja (kuusalu_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ees_t1024398)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vee_ettevotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kuusalu_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ees_t1024398_volitatud_isik",
      "@type": [
        "owl:NamedIndividual",
