          "@id": "estleg:Concept_rae_valla_heakorraeeskiri_t1050570_konnitee"
        },
        {
          "@id": "estleg:Concept_rapla_valla_heakorraeeskiri_t1045563_konnitee"
        },
        {
          "@id": "estleg:Concept_ulenurme_valla_heakorraeeskiri_t1004353_konnitee"
        },
        {
          "@id": "estleg:Concept_heakorraeeskiri_ja_koormise_kehtestamine_t1052685_konnitee"
        },
        {
          "@id": "estleg:Concept_viru_nigula_valla_heakorra_eeskiri_t1058823_konnitee"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kõnnitee",
      "skos:definition": [
        {
          "@value": "jalakäijate liiklemiseks ettenähtud teeosa või sama otstarbega omaette tee",
          "@language": "et"
        },
        {
          "@value": "jalakäija liiklemiseks ette nähtud tee osa või sama otstarbega omaette tee",
          "@language": "et"
        },
        {
          "@value": "jalakäija, robotliikuri ja kergliikuriga liiklemiseks ettenähtud ja äärekiviga või muul viisil sõiduteest või jalgrattateest eraldatud teeosa, mis võib olla tähistatud asjakohaste liiklusmärkide või teekattemärgistega",
          "@language": "et"
        },
        {
          "@value": "jalakäijale, robotliikurile ja tasakaaluliikurile liiklemiseks ettenähtud ja äärekiviga või muul viisil sõidu- või jalgrattateest eraldatud teeosa, mis võib olla tähistatud asjakohaste liiklusmärkide või teekattemärgistega",
          "@language": "et"
        },
        {
          "@value": "jalgsi ja kergliiklusvahendiga (nt jalgratas, tasakaaluliikur jms) liiklemiseks ettenähtud tee või sõidutee osa",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korge_kvalifikatsiooniga_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kõrge kvalifikatsiooniga töötaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_korge_kvalifikatsiooniga_tootaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kõrge kvalifikatsiooniga töötaja",
      "skos:definition": [
        {
          "@value": "teadur, insener, disainer ja müügijuht, kellel on kolmanda taseme haridust tõendav kraad ning vähemalt viieaastane töökogemus asjaomases valdkonnas. Doktoriõpet võib lugeda asjaomaseks töökogemuseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korged_rakendusvaartused_magnetvaljade_puhul",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kõrged rakendusväärtused magnetväljade puhul",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tootervishoiu_ja_tooohutuse_nouded_elektromagnetvaljadest_mo_t1034216_korged_rakendusvaartused_magnetvaljade_puhul"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kõrged rakendusväärtused magnetväljade puhul",
      "skos:definition": [
        {
          "@value": "tasemed, mis on seotud kehalist toimet avaldava kokkupuute piirnormidega. Töötajale kehalist toimet avaldava kokkupuute ja meelelist toimet avaldava kokkupuute piirnormid ja rakendusväärtused on esitatud lisades 2 ja 3. Riskirühmadesse kuuluvad töötajad – töötajad, kes kasutavad siiratud meditsiiniseadet (näiteks kardiostimulaator) või kehal kantavat meditsiiniseadet (näiteks insuliinipump), rasedad ja alaealised. Töötaja peab tööandjat teavitama enda kuulumisest riskirühma.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korgem_juhtkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kõrgem juhtkond",
        "@language": "et"
      },
