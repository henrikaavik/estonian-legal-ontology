        "@id": "estleg:Concept_purotehniline_toode"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_rannaala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rannaala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "järvede ja jõgede kalda maismaaosa veepiirist kuni tugevaima tormilaine mõjupiirini või vastavate viitadega märgistatud piirini. Rannaala võib olla koht inimestele puhkuse veetmiseks ning vabaaja võimaldamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
