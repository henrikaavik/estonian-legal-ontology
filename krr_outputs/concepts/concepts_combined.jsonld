    {
      "@id": "estleg:Concept_hiiumaa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_t1046659_uhetaolised_liitujad",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühetaolised liitujad",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "liitujad, kellel on ühesugune tarbimisvõimsus (l/s) või kelle siseveevärgi ja -kanalisatsiooni torud on sama läbimõõduga; 33) ühisveevärk ja -kanalisatsioon - ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reovee ärajuhtimine ja mis on vee-ettevõtja hallatav; 34) ühisveevärgi ja -kanalisatsiooni arendamise kava - volikogu kinnitatud kava, mille alusel arenduspiirkonnas toimub ühisveevärgi ja-kanalisatsiooni arendamine; 35) ühisveevärgi ja -kanalisatsiooni avarii - ühisveevärgi ja -kanalisatsiooni ehitiste või seadmete ettenägematu purunemine või rikkiminek, mille tagajärjel oluliselt halveneb või katkeb klientide veega varustamine või nende reovee ning sademevee ärajuhtimine või on ohustatud inimesed, ehitised või keskkond. Ühisveevärgi ja -kanalisatsioonina käsitletakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046659_Par_2"
        }
      ],
      "estleg:sourceAct": "Hiiumaa valla ühisveevärgi ja -kanalisatsiooniga liitumise ja kasutamise eeskiri",
      "rdfs:label": "ühetaolised liitujad (hiiumaa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_t1046659)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhetaolised_liitujad"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
