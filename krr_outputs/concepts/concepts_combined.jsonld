      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "asenduskodu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "looma ajutine elukoht kuni looma omaniku või loomale uue omaniku leidmiseni, mis ei ole hoiupaik",
        "@language": "et"
      },
      "estleg:definedIn": [
