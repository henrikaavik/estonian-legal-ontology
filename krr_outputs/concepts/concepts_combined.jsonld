    {
      "@id": "estleg:Concept_valisprojektides_osalemise_kord_t1054417_projekti_kogumaksumus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "projekti kogumaksumus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "projekti tegevuste elluviimiseks tehtavad kulutused kokku, mis kaetakse välisrahastusest ja projektis osalevate partnerite omafinantseeringust; 9) projektide oma- ja kaasfinantseerimise ja välisprojektide ettevalmistamise reserv (edaspidi projektide reserv ) – Tallinna linnaeelarves kavandatud kulutuste reserv nende projektide ettevalmistamiseks ja käivitamiseks, mis on saanud positiivse rahastusotsuse eelarveaasta kestel ning mille tulusid, kulutusi ja omafinantseeringut ei olnud võimalik eelarve koostamisel ette näha ja eelarvesse kavandada",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054417_Par_2"
        }
      ],
      "estleg:sourceAct": "Välisprojektides osalemise kord",
      "rdfs:label": "projekti kogumaksumus (valisprojektides_osalemise_kord_t1054417)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_projekti_kogumaksumus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valisprojektides_osalemise_kord_t1054417_projekti_lisafinantseering",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "projekti lisafinantseering",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lisavahendid, mis on vajalikud projekti tegevuste elluviimiseks, kuid mis ei ole projekti mõistes abikõlblikud. Projektiga seotud lisafinantseeringu katteks ei eraldata lisavahendeid projektide reservist; 11) välisprojektide andmekogu (edaspidi andmekogu ) – Tallinna andmekogu, milles menetletakse ja säilitatakse projektidega seotud teavet ja dokumente digitaalselt ning mis võimaldab teha projektide üle järelevalvet.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054417_Par_2"
        }
      ],
      "estleg:sourceAct": "Välisprojektides osalemise kord",
      "rdfs:label": "projekti lisafinantseering (valisprojektides_osalemise_kord_t1054417)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_projekti_lisafinantseering"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
