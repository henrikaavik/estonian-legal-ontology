      "skos:definition": [
        {
          "@value": "jäätmete kokku korjamine, sealhulgas jäätmete eelsortimine ja ajutine ladustamine ning mehaaniline töötlemine ilma jäätmete koostist ja olemust muutmata, eesmärgiga vedada need edasiseks käitlemiseks jäätmekäitluskohta; 14",
