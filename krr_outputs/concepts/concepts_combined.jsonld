    {
      "@id": "estleg:Concept_esinduskollektiiv",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "esinduskollektiiv",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_johvi_valla_eelarvest_kultuuritegevuse_ja_kohaliku_omaalgatu_t1054761_esinduskollektiiv"
        },
        {
          "@id": "estleg:Concept_parnu_linna_eelarvest_kultuuriuhingutele_ning_avatud_kultuur_t1051323_esinduskollektiiv"
        },
        {
          "@id": "estleg:Concept_rakvere_valla_eelarvest_mittetulunduslikuks_tegevuseks_toetu_t1056755_esinduskollektiiv"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "esinduskollektiiv",
      "skos:definition": [
        {
          "@value": "kollektiiv, mis kvalifitseerub kultuuriühingute toetusele, kuulub ekspertkomisjoni ettepanekul nimetatud kuni 7 esinduskollektiivi hulka ning vähemalt 50% kollektiivi juhendajatest omavad või omandavad erialast haridust.",
          "@language": "et"
        },
        {
          "@value": "kollektiiv, mis tegutseb rahvakultuuri või spordi valdkonnas, osaleb valla kultuuri- ja spordiüritustel, esindab valda üleriigilistel või rahvusvahelistel konkurssidel, võistlustel, festivalidel või muudel sarnastel üritustel",
          "@language": "et"
        },
        {
          "@value": "rahvakultuuri valdkonnas tegutsev kollektiiv, mille tegevuses osaleb regulaarselt vähemalt 8 isikut ja tegevus toimub vähemalt 9 kuul aastas. Esinduskollektiiv osaleb Jõhvi valla üritustel, üleriigilistel või rahvusvahelistel konkurssidel, festivalidel või võistlustel ning kollektiivi juhendaja(d) omavad või omandavad erialast haridust",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
