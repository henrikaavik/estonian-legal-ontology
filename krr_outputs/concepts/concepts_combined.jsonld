      "skos:definition": [
        {
          "@value": "aktsiaselts, mille kõik aktsiad kuuluvad linnale (edaspidi linna aktsiaselts ), või osaühing, mille ainuke osa kuulub linnale (edaspidi linna osaühing )",
          "@language": "et"
        },
        {
          "@value": "aktsiaselts, mille kõik aktsiad kuuluvad linnale (edaspidi linna aktsiaselts), või osaühing, mille osad kuuluvad linnale (edaspidi linna osaühing)",
          "@language": "et"
        },
        {
