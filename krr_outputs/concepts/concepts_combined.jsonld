      "rdfs:label": "abiandja",
      "skos:definition": [
        {
          "@value": "kiirabibrigaad, Päästeameti, Kaitseväe ning Politsei- ja Piirivalveameti üksus, keda Häirekeskus või Politsei- ja Piirivalveamet saadab välja abi andma; RT I 2022-07-21 1 121072022001 2023-01-01 2",
          "@language": "et"
