    {
      "@id": "estleg:Concept_rahvakusitluse_labiviimise_kord_pohja_sakala_vallas_t1055473_elanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "elanik",
      "skos:definition": "vähemalt 16-aastane E esti kodanik või Euroopa Liidu kodanik, kes on rahvaküsitluse päevaks saanud 16-aastaseks ja kelle Eesti rahvastikuregistri järgne elukoht asub Põhja-Sakala vallas või valla territooriumi vastaval osal selle päeva seisuga, kui volikogu otsustas rahvaküsitluse korraldamise. Hääleõiguslik ei ole isik, kes on valimisõiguse osas teovõimetuks tunnistatud. Hääletamisest ei võta osa isik, kes on kohtu poolt süüdi mõistetud ja kannab karistust kinnipidamiskohas; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055473_Par_2"
        }
      ],
      "estleg:sourceAct": "Rahvaküsitluse läbiviimise kord Põhja-Sakala vallas",
      "rdfs:label": "elanik (rahvakusitluse_labiviimise_kord_pohja_sakala_vallas_t1055473)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_elanik"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_elanik"
        }
      ]
