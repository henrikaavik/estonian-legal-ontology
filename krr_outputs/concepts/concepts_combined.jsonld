    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_turu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "turu",
      "skos:definition": "uuring – riigihanke ettevalmistamiseks riigihanke esemele vastavas valdkonnas tehtav analüüs või ettevõtjate või erialaliitudega konsulteerimine. Turu-uuringu eesmärk on välja selgitada, milliseid tingimusi on riigihanke tulemuslikuks läbiviimiseks võimalik ja otstarbekas esitada, võttes arvesse turul pakutavat, ettevõtjate võimalusi ja võimekust ning hinnataset; 23",
