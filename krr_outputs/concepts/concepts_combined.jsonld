        {
          "@value": "tervishoiu-, hoolekande- või veterinaarteenuse osutamisel tekkinud nakkusohtlikud, bioloogilised, ravimi- ja muud jäätmed",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tervishoiuteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervishoiuteenus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
