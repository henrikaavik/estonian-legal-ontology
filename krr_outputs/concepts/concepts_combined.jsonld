      "rdfs:label": "jäätmemahuti",
      "skos:definition": [
        {
          "@value": "konteiner, mahuti jm anum ja pakend, kuhu kogutakse territooriumil tekkinud jäätmed",
          "@language": "et"
        },
        {
          "@value": "nõuetele vastav vahend (prügikast, konteiner jne) jäätmete kogumiseks",
          "@language": "et"
        },
        {
          "@value": "prügiurn, -konteiner, mitmesektsiooniline prügiurn prügi sorteeritult kogumiseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
