        },
        {
          "@id": "estleg:Concept_toohoiveprogramm_2024_2029_t1057476_rahvusvahelise_kaitse_saaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rahvusvahelise kaitse saaja",
      "skos:definition": [
        {
          "@value": "inimene, kes on Eestis rahvusvahelise kaitse, sealhulgas ajutise või täiendava kaitse saaja või Eestis rahvusvahelise kaitse taotleja välismaalasele rahvusvahelise kaitse andmise seaduse tähenduses",
          "@language": "et"
        },
        {
          "@value": "välismaalane, keda on tunnustatud pagulasena, täiendava kaitse või ajutise kaitse saajana ning kellele on antud Eesti elamisluba",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
