      "estleg:definesConcept": {
        "@id": "estleg:Concept_kuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044617_omapuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk kohtpuhasti on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti",
        "@language": "et"
      },
      "estleg:definedIn": [
