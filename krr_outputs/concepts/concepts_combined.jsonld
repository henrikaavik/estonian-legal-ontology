          "@id": "estleg:Concept_saue_valla_munitsipaallasteaeda_ja_hoidu_vastuvotmise_ja_sea_t1062616_vanem"
        },
        {
          "@id": "estleg:Concept_voru_valla_aleviku_ja_kulavanema_statuut_t1048342_vanem"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "vanem",
      "skos:definition": [
        {
          "@value": "lapse seaduslik esindaja (lapse vanem või eestkostja)",
          "@language": "et"
        },
        {
          "@value": "aleviku või küla esindaja, kes on valitud hääleõiguslike elanike poolt statuudi alusel ning juhindub oma tegevuses aleviku või küla ühistest huvidest ja seisukohtadest; 3) ühine aleviku- ja/või külavanem - mitme aleviku ja/või küla ühiselt valitud vanem, kes esindab neid alevikke ja/või külasid võrdsetel alustel",
          "@language": "et"
        },
        {
          "@value": "lapse (õpilase) vanem või eestkostja",
          "@language": "et"
        },
        {
          "@value": "lapsevanem või muu lapse seaduslik esindaja",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_valim"
        }
      ],
