    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vastavalt avaliku teenistuse seaduse §-le 5 on avalik teenistuja asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o töölepingu alusel töötav) töötaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013184_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (kiili_vallavalitsuse_palgajuhend_t1013184)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on asutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013184_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (kiili_vallavalitsuse_palgajuhend_t1013184)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013184_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (kiili_vallavalitsuse_palgajuhend_t1013184)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_teenistuskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013184_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuskoht (kiili_vallavalitsuse_palgajuhend_t1013184)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuskoht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu",
        "@language": "et"
      },
