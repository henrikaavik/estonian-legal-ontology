    {
      "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_raskustes_olev_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "raskustes olev ettevõtja",
      "skos:definition": "ettevõtja, mis vastab üldise grupierandi määruse artikkel 2 punktis 18 või IPCEI teatise punkti 10 alapunktis (a) nimetatud kriteeriumitele, välja arvatud iduettevõte või kasvuettevõte, mille puhul ei arvata aktsia- või osakapitali hulka ülekurssi; 20",
