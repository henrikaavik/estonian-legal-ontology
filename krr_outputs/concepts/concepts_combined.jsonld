      },
      "rdfs:label": "välireklaami paigaldamine",
      "skos:definition": [
        {
          "@value": "välireklaami avalikustamise eesmärgil selle eksponeerimine avalikus kohas ning füüsilistele ja juriidilistele isikutele kuuluvatel kinnistutel, territooriumil, ehitisel või selle osal ja sõidukil, kui see on suunatud avalikkusele",
          "@language": "et"
        }
      ],
