      "skos:definition": [
        {
          "@value": "6 kuni 19 aastane rahvastikuregistri alusel Pärnu linna elanik; 3",
          "@language": "et"
        },
        {
          "@value": "7-19aastane noor, kelle rahvastikuregistrijärgne elukoht on Kambja vald; 2",
          "@language": "et"
        },
        {
          "@value": "Antsla vallas elav noor vanuses 7-19 eluaastat, kes õpib huvikoolis või osaleb huvitegevuses. RT IV 2020-06-02 10 402062020010 2020-06-05 6",
          "@language": "et"
        },
        {
          "@value": "Eesti rahvastikuregistri andmetel alalise elukohaga Setomaa vallas elav 7–19-aastane laps või noor, kes osaleb huvihariduses ja/või huvitegevuses; 3",
          "@language": "et"
        },
        {
          "@value": "huvikoolis või huvitegevuse teenust pakkuva juriidilise isiku juures õppiv isik; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
