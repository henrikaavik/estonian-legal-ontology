      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vaikeettevotja_digilahenduste_toetuse_andmise_kord_t1049765_projekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "projekt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühekordne tegevus või tegevuste kogum, millega taotletakse korra §-s 3 nimetatud eesmärgi saavutamist ning mille elluviimiseks toetust taotletakse või kasutatakse ja mille eelarve koosneb abikõlblikest kuludest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049765_Par_4"
        }
      ],
      "estleg:sourceAct": "Väikeettevõtja digilahenduste toetuse andmise kord",
