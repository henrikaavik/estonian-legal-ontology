        "@id": "estleg:Concept_energiabilanss"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_energiabilanss"
        }
      ]
    },
    {
      "@id": "estleg:Concept_elamu_energiaauditile_esitatavad_nouded_t1029194_valispiire",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "välispiire",
      "skos:definition": "elamu piirdetarind, mis eraldab ruumi välisõhust või pinnasest (näiteks sein, sokkel, aken, välisuks, põrand pinnasel, põrand välisõhu kohal, katuslagi, mitteköetava pööningu põrand ja muud seesugused); 3",
