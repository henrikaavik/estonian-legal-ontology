    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_uhiskasutuses_jaatmemahuti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühiskasutuses jäätmemahuti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmemahuti, mida omavahelise kokkuleppe alusel kasutab rohkem kui üks jäätmevaldaja ning mille tühjendamiseks on vähemalt ühel jäätmevaldajal sõlmitud jäätmevedajaga jäätmeleping. Eeskirja § 2 lõikes 2 nimetamata mõistete defineerimisel lähtutakse keskkonnaseadustiku üldosa seaduses, jäätmeseaduses, pakendiseaduses, riigihangete seaduses ning teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest terminitest ja mõistetest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "ühiskasutuses jäätmemahuti (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhiskasutuses_jaatmemahuti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_koerte_ja_kasside_pidamise_eeskiri_t1008977_loomapidaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "loomapidaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kellele loom kuulub ( edaspidi loomaomanik) või kes tegeleb looma pidamisega rendi- või muu selletaolise suhte alusel loomaomanikuga. Kuuluvuse kaudu identifitseerimisel loetakse loom kuuluvaks isikule, kelle valduses, sealhulgas kelle kinnisel territooriumil või kellele kuuluvas hoones või rajatises ta asub kui looma kuuluvusest huvitatud isik ei tõenda vastupidist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1008977_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla koerte ja kasside pidamise eeskiri",
      "rdfs:label": "loomapidaja (muhu_valla_koerte_ja_kasside_pidamise_eeskiri_t1008977)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_loomapidaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_muhu_valla_koerte_ja_kasside_pidamise_eeskiri_t1008977_hulkuv_loom",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hulkuv loom",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "märgistamata loom, kelle omanikku ei ole võimalik tuvastada või loomapidaja juurest lahti pääsenud loom, kes viibib omaniku või looma eest vastutava isiku juuresolekuta väljaspool loomapidajale kuuluvat või tema kasutuses olevat territooriumi; 3) põllumajandusloom (sh linnud) - põllumajandusloom on loomsete saaduste tootmise eesmärgil peetav ja aretatav loom (veis, lammas, kits, siga, küülik, nutria jt) ja lind (kana, kalkun, hani, part, faasan, jaanalind jt). Põllumajandusloomaks loetakse ka hobuslane",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1008977_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla koerte ja kasside pidamise eeskiri",
      "rdfs:label": "hulkuv loom (muhu_valla_koerte_ja_kasside_pidamise_eeskiri_t1008977)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hulkuv_loom"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
