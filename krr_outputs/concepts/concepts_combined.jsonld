        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809_Reovesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reovesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on olmes, tööstuses või muus tootmises tekkinud vesi, mis ületab kehtestatud heite piirväärtusi ja mida tuleb enne suublasse juhtimist puhastada. Reoveeks peetakse ka ühisvoolsesse kanalisatsiooni juhitud sademevett.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058809_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
