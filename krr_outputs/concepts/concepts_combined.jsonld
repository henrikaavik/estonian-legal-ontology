      "@id": "estleg:Concept_saku_vallavalitsuse_palgajuhend_t1011634_Palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Palk",
      "skos:definition": "ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu. 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011634_Par_2"
        }
      ],
      "estleg:sourceAct": "Saku Vallavalitsuse palgajuhend",
