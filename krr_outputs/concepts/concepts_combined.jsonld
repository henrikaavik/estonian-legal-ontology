        }
      ],
      "skos:definition": [
        {
          "@value": "Riigikogu poolt igaks eelarveaastaks perekonna esimesele liikmele kehtestatud toimetulekupiir",
          "@language": "et"
        },
        {
          "@value": "on käesoleva määruse tähenduses Riigikogu poolt kehtestatud toimetulekupiir.",
