      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_aeronavigatsiooniteabe_edastamise_ja_avaldamise_kord_ning_no_t337512_SNOWTAM_teade",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "SNOWTAM-teade",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "NOTAM-teate eriseeria, mis sisaldab kehtestatud vormil teavet lume, lörtsi ja jää ning nendega seotud seisva vee tõttu tekkinud ohtlike tingimuste olemasolust või likvideerimisest lennuvälja liiklusalal. 8) aeronavigatsiooniline fikseeritud teenindus ( Aeronautical fixed service – AFS) – telekommunikatsiooniteenus kindlate püsipunktide vahel, mille põhieesmärk on tagada aeronavigatsiooniline ohutus ning lennutalituste regulaarne, efektiivne ja säästlik tegutsemine.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_337512_Par_2"
        }
      ],
      "estleg:sourceAct": "Aeronavigatsiooniteabe edastamise ja avaldamise kord ning nõuded aeronavigatsioonimõõdistustele",
      "rdfs:label": "SNOWTAM-teade (aeronavigatsiooniteabe_edastamise_ja_avaldamise_kord_ning_no_t337512)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_snowtam_teade"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
