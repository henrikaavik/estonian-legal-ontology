      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "biolagunevad aia",
      "skos:definition": "ja haljastujäätmed on aedade ja haljasalade hooldamisel tekkinud biolagunevad jäätmed nagu rohi, lehed, peened oksad ja muu taoline; 2",
