      },
      "rdfs:label": "taastuvelekter",
      "skos:definition": [
        {
          "@value": "taastuvatest energiaallikatest toodetud elekter Euroopa Parlamendi ja Nõukogu direktiivi (EL) 2018/2001, 11. detsember 2018, taastuvatest energiaallikatest toodetud energia kasutamise edendamise kohta (ELT L 328 21.12.2018, lk 82) artikli 2 punkti 1 tähenduses",
          "@language": "et"
        },
        {
          "@value": "taastuvenergiast toodetud elekter",
          "@language": "et"
        },
        {
          "@value": "täielikult taastuvenergiast toodetud elekter",
          "@language": "et"
        }
      ],
