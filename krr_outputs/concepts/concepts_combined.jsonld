      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_nende_kasutam_t1015413_vaaramatu_joud",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vääramatu jõud",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "loodusõnnetus, katastroof, üldstreik, ülestõus, sõda või muu taoline asjaolu, mille saabumist õigussuhete pooled ette ei näinud ega saanud ette näha ega ära hoida",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1015413_Par_2"
        }
      ],
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooniga liitumise ja nende kasutamise eeskiri",
