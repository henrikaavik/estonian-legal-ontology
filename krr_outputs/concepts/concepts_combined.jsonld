        "@language": "et"
      },
      "skos:definition": {
        "@value": "pinnas, materjal või aine (sh vesi, jää ja külmunud materjal), mille omadused või koostisosad võivad põhjustada ohtliku rikošeti",
        "@language": "et"
      },
