          "@value": "Kogukond",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "mingis piirkonnas elav ja ühist toimekeskkonda jagav ning teatud sotsiaalsete suhete võrgustikuga seotud inimeste rühm; 3",
          "@language": "et"
        },
        {
          "@value": "teatud sotsiaalse suhtevõrgustikuga seotud inimeste rühm paikkonnas või asumis; 5",
          "@language": "et"
        },
        {
          "@value": "territoriaalselt määratletud inimeste kooslus; 3",
          "@language": "et"
        },
        {
          "@value": "ühes geograafilises piirkonnas elav inimeste grupp, kes jagab ühiseid väärtusi ja huvisid ning tegutseb koos. 3 (",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kogukonnakeskus",
