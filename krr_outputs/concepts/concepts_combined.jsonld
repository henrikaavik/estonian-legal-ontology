    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1051880_avalikustaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalikustaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidiline või füüsiline isik, kes taotleb välireklaami paigaldamisluba või on loa alusel välireklaami avaldaja",
        "@language": "et"
      },
