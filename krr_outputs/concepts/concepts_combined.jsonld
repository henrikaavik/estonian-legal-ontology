      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_valla_uhiskondlikuks_objektiks_olev_reklaamikandja"
        },
        {
          "@id": "estleg:Concept_viimsi_valla_reklaamimaarus_t1039864_valla_uhiskondlikuks_objektiks_olev_reklaamikandja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "valla ühiskondlikuks objektiks olev reklaamikandja",
      "skos:definition": [
        {
          "@value": "vallale kuuluva ehitise või rajatise pinnale paigutatud reklaamikandja, mis samaaegselt selle kasutamisega reklaamialaseks tegevuseks teenib valla avalikke huve (bussiootepaviljon, prügikast jm). Reklaamina ei käsitata: 1) majandus- või kutsetegevuse kohas, kus müüakse kaupa või osutatakse teenust, antavat teavet kauba, teenuse või selle müügitingimuste kohta ning käesoleva lõike punktis 2 nimetatud teavet; 2025-02-27",
          "@language": "et"
        },
        {
          "@value": "Viimsi vallale kuuluva ehitise või rajatise pinnale õiguspäraselt paigutatud reklaamikandja, mis samaaegselt selle kasutamisega reklaamialaseks tegevuseks teenib valla avalikke huve (bussiootepaviljon, prügikast jm)",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_v_alla_uhiskondlikuks_objektiks_olev_reklaamikandja"
        }
      ],
