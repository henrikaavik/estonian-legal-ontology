        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tuulutusasend",
      "skos:definition": [
        {
          "@value": "osaliselt avatud akna või ukse fikseerimine ruumi õhutamiseks, mis toimub selleks otstarbeks tarindi valmistaja poolt tarindi külge kinnitatud spetsiaalse furnituuri või muu tehnilise tootega",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
