    {
      "@id": "estleg:Concept_viimsi_valla_heakorraeeskiri_t1060690_looduslahedane_lahendus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "looduslähedane lahendus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "haljastuslahendus, mis on rajatud haljastusprojekti alusel või selle osana ning mis jäljendab loodust või sisaldab maastiku kujundamisel alasid, kus taimestikul lastakse kasvada (nt lilleniit, lillemuru, vihmapeenar jmt) ning millisel juhul on vastava projektiga määratud alale eraldi niidu- ja hooldere˛iim",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060690_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi valla heakorraeeskiri",
      "rdfs:label": "looduslähedane lahendus (viimsi_valla_heakorraeeskiri_t1060690)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_looduslahedane_lahendus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_heakorraeeskiri_t1060690_romusoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "romusõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "mittekomplektne liiklusvahend, mis oma välimusega rikub ümbruskonna esteetilist väljanägemist, mida ei kasutata ja mis võib olla keskkonnaohtlik.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060690_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi valla heakorraeeskiri",
