    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_tootasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasust, mida asutus maksab töötajale tehtud töö eest vastavalt töölepingule, õigusaktidele ja tööandja poolt kehtestatud korrale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013184_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili Vallavalitsuse palgajuhend",
      "rdfs:label": "töötasu (kiili_vallavalitsuse_palgajuhend_t1013184)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhipalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013184_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili Vallavalitsuse palgajuhend",
      "rdfs:label": "põhipalk (kiili_vallavalitsuse_palgajuhend_t1013184)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pohipalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_muutuvpalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muutuvpalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013184_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili Vallavalitsuse palgajuhend",
      "rdfs:label": "muutuvpalk (kiili_vallavalitsuse_palgajuhend_t1013184)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muutuvpalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_tulemuspalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tulemuspalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
