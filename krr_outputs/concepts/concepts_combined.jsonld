    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Programmis_osaleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Programmis osaleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "riiklikusse ehitisregistrisse kantud, Lüganuse vallas asuva eluhoone omanik, ühis- või kaasomanikud, kellest vähemalt pooltel on elukoht taotluse esitamise aasta 1. jaanuari seisuga rahvastikuregistri andmetel Lüganuse vald ning Lüganuse vallas toimivad äriregistrisse kantud korteriühistud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Programmis osaleja (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_programmis_osaleja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Toetuskolbulikud_tood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Toetuskõlbulikud tööd",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "käesolevas määruses loetletud tegevused ja struktuurfondidest toetuse taotlemise korral korterelamu tervikliku rekonstrueerimise omaosaluse osa",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Toetuskõlbulikud tööd (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_toetuskolbulikud_tood"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Eramaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Eramaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "üksikelamu, ridaelamu sektsioon, eramajaga võrdsustatakse kuni 4 korteriga elamu, kusjuures osalejaks on omanike esindaja volituse alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Eramaja (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eramaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Eramaja_fassaadi_valisviimistluse_uuendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Eramaja fassaadi välisviimistluse uuendamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tööd hoone fassaadi ringpiires osaliselt või tervikuna, välisuste asendamine, akende vahetamine, soklitööd; 5) Eramaja vee- ja kanalisatsioonitööd – puur- ja salvkaevude rajamine või puhastamine, veefiltrite ja -puhastusseadmete lisamine, bioloogilise puhasti, reovee kogumismahuti, vee- ja kanalisatsioonitorustike paigaldamine kinnistule, drenaa˛ kinnistule ning liitumine ühisveevärgi- ja kanalisatsiooniga (edaspidi ÜVK), kaasaarvatud projekteerimine. Toetuskõlbulik ei ole hajaasustuse programmist toetuse taotlemisel omaosaluse osa",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Eramaja fassaadi välisviimistluse uuendamine (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eramaja_fassaadi_valisviimistluse_uuendamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Eramaja_katusekatte_vahetamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Eramaja katusekatte vahetamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olemasoleva amortiseerunud või asbesti sisaldava katusekatte asendamine katusekivi, profiilpleki, bituumensindli, bituumenplaadi, rullmaterjali, laastude, roo või tsementkiudplaatidega (v.a asbesti sisaldav eterniit, ruberoid ja PVC laineplaat), pööningu põranda ja katuslagede soojustamine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Eramaja katusekatte vahetamine (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eramaja_katusekatte_vahetamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Eramajade_kuttesusteemide_uuendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Eramajade küttesüsteemide uuendamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "õhk-vesi ja õhk-õhk soojuspumba, maasoojuspumba, pelleti- või halupuidukatla paigaldamine, kütteseadme uuendamisel tahkekütteahju või tahkeküttepliidi soetamine koos paigaldamisega, tahkekütteahju või tahkeküttepliidi ehitamine, sh soojamüüri ehitamine, radiaatorite, sh torustiku ja armatuuri soetamine uue kütteseadme paigaldamisel, moodulkorstna soetamine ja paigaldus või uue korstnasüsteemi ehitus või olemasoleva korstnasüsteemi renoveerimine koos korstnahülsi paigaldusega tahkekütuse katla, ahju või pliidi ehitamisel. Toetuskõlbulik ei ole eis’i väikeelamute kütteseadmete uuendamise toetuse taotlemisel omaosaluse osa; 8) Korterelamu fassaadi välisviimistluse uuendamine- elamu fassaadi ringpiires osaline või terviklik soojustamine, krohvimine, värvimine, lõppviimistlusega materjalide paigaldamine, trepikodade akende vahetamine, trepikoja välisuste asendamine, keldriakende asendamine, trepimademe katuse paigaldamine, välistreppide, sokli ja panduse remont, rõdu/lod˛a asendamine või remont (ah piirded)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Eramajade küttesüsteemide uuendamine (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eramajade_kuttesusteemide_uuendamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Korterelamu_katusekatte_vahetamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Korterelamu katusekatte vahetamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olemasoleva amortiseerunud või asbesti sisaldava katusekatte asendamine katusekivi, profiilpleki, bituumensindli, bituumenplaadi, rullmaterjali, laastude, roo või tsementkiudplaatidega (v.a asbesti sisaldav eterniit, ruberoid ja PVC laineplaat), pööningu põranda ja katuslagede soojustamine, vihmaveerennide terviklahenduse paigaldamine, kütte- või ventilatsioonikorstnate remontimine, korstnamütsi paigaldamine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Korterelamu katusekatte vahetamine (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korterelamu_katusekatte_vahetamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Korterelamu_liftisusteemi_uuendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Korterelamu liftisüsteemi uuendamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olemasoleva lifti osade vahetus, lifti terviklik asendamine, lifti lisamine kortermajale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Korterelamu liftisüsteemi uuendamine (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korterelamu_liftisusteemi_uuendamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Korterelamu_terviklik_rekonstrueerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Korterelamu terviklik rekonstrueerimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "korterelamul soojustatakse vähemalt kõik välisseinad ja katus, vahetatakse kõigi eluruumide aknad, rekonstrueeritakse küttesüsteem, rekonstrueeritakse elektrisüsteem. Kortermaja täisrekonstrueerimisel võivad ehitustööd olla alustatud enne toetuse taotluse esitamist. Ehitustööd peavad lõppema avalduse esitamise aastal ja aruanne peab olema esitatud käesoleva määruse § 5 lõikes 11 sätestatud korras",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Korterelamu terviklik rekonstrueerimine (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korterelamu_terviklik_rekonstrueerimine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Korterelamu_tervikliku_rekonstrueerimise_pohiprojekti_koostamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Korterelamu tervikliku rekonstrueerimise põhiprojekti koostamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitusprojekt, mis on koostatud vastavalt ehitusseadustiku § 13 lõike 3 alusel kehtestatud nõuetele, põhiprojekti järgi peab korterelamul soojustatama vähemalt kõik välisseinad ja katus, vahetatama kõigi eluruumide aknad, rekonstrueeritama küttesüsteem, rekonstrueeritama elektrisüsteem",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062557_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla programmi “Ehitised korda Lüganuse vallas” läbiviimise kord",
      "rdfs:label": "Korterelamu tervikliku rekonstrueerimise põhiprojekti koostamine (luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korterelamu_tervikliku_rekonstrueerimise_pohiprojekti_koostamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_programmi_ehitised_korda_luganuse_vallas_labi_t1062557_Hinnapakkumus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Hinnapakkumus",
        "@language": "et"
      },
