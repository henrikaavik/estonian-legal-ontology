    },
    {
      "@id": "estleg:Concept_kaugkuttepiirkonna_kehtestamine_t1015382_vorgu_teeninduspiir",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
