        "@value": "liitumistasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühekordne tasu, mida võib küsida vaid volikogu poolt määratud vee-ettevõtja ning mis tuleb tarbimiskoha omanikul maksta liitumiseks ühisveevärgi ja/või -kanalisatsiooniga",
