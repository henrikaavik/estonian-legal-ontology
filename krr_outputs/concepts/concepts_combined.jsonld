      "rdfs:label": "romusõiduk",
      "skos:altLabel": [
        {
          "@value": "Romusõiduk",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "sõiduk, mis ei saa tehnilise seisukorra tõttu osaleda liikluses või millel puuduvad selle mehaanilised osad või kereosad või autoklaasid või rattad ja mis oma välimusega riivab piirkonna esteetilist väljanägemist; 10",
          "@language": "et"
        },
        {
          "@value": "liiklusseaduse § 2 lõigetes 36 ja 40 nimetatud sõidukite ja nende osade jäätmed: maastikuautod ja mootorsõidukid, v.a. mootoriga jalgratas, pisimopeed, tramm. 2 (",
          "@language": "et"
        },
        {
          "@value": "liiklusvahend, mis välimusega rikub ümbruskonna esteetilist väljanägemist ja võib olla keskkonnaohtlik; 10",
          "@language": "et"
        },
        {
          "@value": "mittekomplektne liiklusvahend, mis oma välimusega rikub ümbruskonna esteetilist väljanägemist, mida ei kasutata ja mis võib olla keskkonnaohtlik. 12",
          "@language": "et"
        },
        {
          "@value": "mittekomplektne liiklusvahend, mis välimusega rikub ümbruskonna esteetilist väljanägemist ja võib olla keskkonnaohtlik.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "27",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_roomikmaastikusoiduk",
