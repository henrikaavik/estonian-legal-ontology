        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hooldusvajadusega inimene",
      "skos:definition": [
        {
          "@value": "18-aastane ja vanem inimene, kes vajab järelevalvet, juhendamist ja/või abi toimingutes (kehahooldus, toitumine, liikumine), mis on vajalikud igapäevaseks toimetulekuks",
          "@language": "et"
        },
        {
          "@value": "18-aastane ja vanem inimene, kes vajab järelevalvet, juhendamist ja/või abi toimingutes (toitumine, liikumine), mis on vajalikud igapäevaseks toimetulekuks",
          "@language": "et"
        },
        {
          "@value": "18-aastane ja vanem inimene, kes vajab järelevalvet, juhendamist või abi igapäevaseks toimetulekuks vajalikes toimingutes, sealhulgas kehahooldusel, toitumisel ja liikumisel",
          "@language": "et"
        },
        {
          "@value": "18-aastane või vanem inimene, kes vajab järelevalvet, juhendamist või abi igapäevaseks toimetulekuks vajalikes toimingutes, sealhulgas kehahooldus, toitumine ja liikumine",
          "@language": "et"
        },
        {
          "@value": "inimene, kes vajab puude või erivajaduse tõttu ajutist või pidevat kõrvalabi, juhendamist ja/või järelevalvet igapäevaelu toimingutes",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
