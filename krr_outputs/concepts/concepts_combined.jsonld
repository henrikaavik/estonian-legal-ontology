      "skos:definition": {
        "@value": "koht, mis on kohaliku omavalitsuse ühisveevärgi- ja kanalisatsiooni arengukavas ning eeskirjas määratud tekkekohast äraveetud reovee kogumiseks ja/või ühiskanalisatsiooni juhtimiseks, vt ka vahemahuti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043193_Par_2"
        }
      ],
