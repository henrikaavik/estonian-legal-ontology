    {
      "@id": "estleg:Concept_anija_vallavalitsuse_teenistujate_ja_hallatavate_asutuste_to_t1040811_eritingimustes_tootamise_eest_makstav_tasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eritingimustes töötamise eest makstav tasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu, mida makstakse juhul kui teenistuja või töötaja tööaeg langeb ööajale või riigipühale ning kui nimetatud kohustus ei sisaldu tema ametijuhendis ja seda ei ole arvestatud tema töötasu määramisel või kokku leppimisel",
        "@language": "et"
      },
      "estleg:definedIn": [
