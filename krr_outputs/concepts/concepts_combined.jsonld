      "rdfs:label": "saatekiri",
      "skos:definition": [
        {
          "@value": "määruse lisas esitatud vormi kohaselt koostatud dokument, kuhu märgitakse andmed vere- või uriiniproovi võtmise ja selle analüüsimiseks edastamise ning riiklikus ekspertiisiasutuses tehtud analüüsi tulemuste kohta, samuti hinnang isikul narkootilise või psühhotroopse aine tarvitamisest põhjustatud joobeseisundi olemasolu või puudumise kohta; 3",
          "@language": "et"
        }
      ]
    },
