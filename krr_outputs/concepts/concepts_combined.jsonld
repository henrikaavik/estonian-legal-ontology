    {
      "@id": "estleg:Concept_taaskasutatavad_jaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taaskasutatavad jäätmed",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_joelahtme_valla_jaatmehoolduseeskiri_t1053601_taaskasutatavad_jaatmed"
        },
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_taaskasutatavad_jaatmed"
        },
        {
          "@id": "estleg:Concept_rapina_valla_jaatmehoolduseeskiri_t1057272_taaskasutatavad_jaatmed"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "taaskasutatavad jäätmed",
      "skos:definition": [
        {
          "@value": "jäätmed, mille taaskasutamine on õiguslikult ja tehnoloogiliselt võimalik",
          "@language": "et"
        },
        {
          "@value": "määrdumata paber, papp ja kartong, klaas- ja plastiktaara, metallpurgid jm metallijäätmed, puhas kile jm plastikjäätmed, puit ja teised jäätmeliigid, mida jäätmevaldajal on segajäätmetest eraldi kogutuna võimalik üle anda korraldatud olmejäätmete veosüsteemi või liigiti kogutuna teisese toorme kasutajale/kokkuostjale, elanikel täiendavalt viia vastavatesse kogumispunktidesse",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_taaskasutusorganisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taaskasutusorganisatsioon",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_narva_linna_jaatmehoolduseeskiri_t1056868_taaskasutusorganisatsioon"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "taaskasutusorganisatsioon",
      "skos:definition": [
        {
          "@value": "pakendiettevõtete või nende moodustatud juriidiliste isikute poolt asutatud organisatsioon, kes haldab pakendi ja pakendijäätmete kogumis- ja taas- kasutussüsteemi ning kellele ettevõtted saavad üle anda oma tagasivõtu- ja taaskasutus- kohustused. Käesoleva paragrahvi lõikes 1 nimetamata mõiste kasutamisel lähtutakse jäätmeseaduses, pakendiseaduses ja teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_taastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taastamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_taastamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "taastamine",
      "skos:definition": [
        {
          "@value": "jäätmehoidlast mõjutatud maapinna töötlemine, et taastada selle rahuldav seisukord, pöörates erilist tähelepanu mulla kvaliteedile, loodusliku loomastiku ja taimestiku, looduslike elupaikade, pinnaveekogude ja põhjaveekogumite hea seisundi saavutamisele ja hoidmisele lähtudes „Veeseaduse” §-st 3 5 ja maastikule ning selle asjakohasele kasutamisele tulevikus",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_saastamine"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_taastav_oigus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taastav õigus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_avatud_taotlusvooru_taastava_oiguse_arendamine_eestis_ii_toe_t1053078_taastav_oigus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "taastav õigus",
      "skos:definition": [
        {
          "@value": "lähenemine õigusrikkumistele ja konfliktidele viisil, mis võimaldab konflikti tõttu tekkinud kahju heastada. See põhineb lahendusprotsessidel, milles osalevad aktiivselt kõik mõjutatud osapooled ning mille eesmärk on tervendada kõiki osapooli ja luua turvaline kogukond",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
