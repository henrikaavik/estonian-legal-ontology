      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevaldaja"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_jaatmevaldaja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmevedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jäätmevedaja",
      "skos:definition": "jäätmete üleandmisel nende vedu teostav isik. Eeskirja 4.peatüki mõistes on jäätmevedaja riigihanke käigus välja valitud jäätmeveoettevõte, kellel on ainuõigus teostada korraldatud jäätmeveoga hõlmatud jäätmete vedu konkreetses jäätmeveo piirkonnas; 16",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevedaja (muhu_valla_jaatmehoolduseeskiri_t1055427)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevedaja"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_jaatmevedaja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmeveo_dokument",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jäätmeveo dokument",
      "skos:definition": "jäätmevedaja poolt jäätmekäitluskohta veetavate jäätmete omadusi ja koguseid näitav saateleht; 17",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
