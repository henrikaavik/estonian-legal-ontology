        "@id": "estleg:Concept_purgimisteenus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rakvere_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048980_reovesi",
      "@type": [
        "owl:NamedIndividual",
