        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "integreeritud hoolekandeteenused",
      "skos:definition": [
        {
          "@value": "inimese individuaalsest vajadusest lähtuvalt käesoleva määruse § 6 lõike 1 punktides 1–5 nimetatud teenuste või teenuse osade ühendamisega loodud uus teenus.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
