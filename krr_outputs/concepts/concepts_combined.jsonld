      ],
      "skos:prefLabel": {
        "@value": "ühendustoru",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistu veevärki veega varustav või kinnistu kanalisatsioonist reovett ärajuhtiv toru peatorust liitumispunktini, viimane kaasa arvatud; 18) ühisveevärk ja -kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reovee ärajuhtimine ning mis on vee-ettevõtja hallatav või teenindab vähemalt 50 elanikku. Ühisveevärgi ja -kanalisatsioonina käsitletakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013461_Par_2"
        }
      ],
      "estleg:sourceAct": "Kernu valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
