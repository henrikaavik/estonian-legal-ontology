    {
      "@id": "estleg:Concept_rakvere_valla_heakorraeeskiri_t1049363_romusoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "romusõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tehniliselt mittekorras olev sõiduk, millel puuduvad selle mehaanilised osad või kereosad või autoklaasid või rattad või mille autokere on roostetanud ja mis oma välimusega riivab territooriumi esteetilist väljanägemist või rikub selle puhtust ja heakorda; 9) illegaalne graffiti– omaniku ja vallavalitsuse loata hoone seinale, müürile, piirdeaiale, pingile, kõnniteele, ühissõiduki peatuse ootekojale vms kantud kiri või joonised; 10) tiheasustusala– linna ja alevi piiridesse jääva territooriumi ning aleviku ja küla selgelt piiritletavad kompaktse hoonestusega olemasoleva või planeeritava territooriumi osa.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049363_Par_2"
        }
      ],
      "estleg:sourceAct": "Rakvere valla heakorraeeskiri",
      "rdfs:label": "romusõiduk (rakvere_valla_heakorraeeskiri_t1049363)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_romusoiduk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rakvere_valla_koerte_ja_kasside_pidamise_eeskiri_t1049364_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "territoorium, rajatis või ruum, mis on antud üldiseks kasutamiseks või mis on tegelikult üldkasutatav (pargid, teed, tänavad, hoovid, haljasalad, parklad, kalmistud, avalikud veekogud, staadionid, mänguväljakud, bussootepaviljonid, ettevõtete piirdeaiata territooriumid, väljakud vms), üldkasutatavad hooned (ametiasutused, koolid, klubid, raamatukogud, spordihooned, toitlustus- ja kaubandusettevõtted, saunad, lasteaiad, kirikud, palvemajad vms), kortermajade üldkasutatavad ruumid (trepikojad, pööningud, keldrid vms), ühistransport",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049364_Par_2"
        }
      ],
      "estleg:sourceAct": "Rakvere valla koerte ja kasside pidamise eeskiri",
      "rdfs:label": "avalik koht (rakvere_valla_koerte_ja_kasside_pidamise_eeskiri_t1049364)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_koht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
