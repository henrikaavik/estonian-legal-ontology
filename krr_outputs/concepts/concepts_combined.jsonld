      "estleg:definitionCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "laps",
      "skos:definition": [
        {
          "@value": "alla 18-aastane inimene. Kui inimese vanus ei ole teada ja on põhjust arvata, et ta on alla 18-aastane, käsitatakse inimest lapsena, kuni ei ole tõendatud vastupidine",
          "@language": "et"
        },
        {
          "@value": "alla 18-aastane isik",
          "@language": "et"
        },
        {
          "@value": "isik, kes on alla 18 aasta vanune.",
          "@language": "et"
        },
        {
          "@value": "kuni 19-aastane ravikindlustuse seaduse mõistes kindlustatud isik.",
          "@language": "et"
        },
        {
          "@value": "laps, kelle rahvastikuregistrijärgne või tegelik elukoht on Saue vallas. Juhul, kui lapse elukoht ei ole rahvastikuregistri andmetel Saue vallas, esitab vanem või eestkostja Saue Vallavalitsusele selle tõendamiseks vajaliku dokumendi (dokument jagatud vanemluse kohta, asendushooldusteenuse leping vms) ja saab seejärel registris taotluse esitamise õiguse.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
