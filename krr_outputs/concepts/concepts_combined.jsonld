    {
      "@id": "estleg:Concept_lenduvaid_orgaanilisi_uhendeid_sisaldavate_varvide_ja_muude_t1036173_orgaaniline_uhend",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "orgaaniline ühend",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühend, mis koosneb süsinikust ja ühest või mitmest vesiniku-, hapniku-, väävli-, fosfori-, räni-, lämmastiku- või halogeeniaatomist, välja arvatud süsinikoksiidid, anorgaanilised karbonaadid ja vesinikkarbonaadid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1036173_Par_2"
        }
      ],
      "estleg:sourceAct": "Lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite, välja arvatud aerosoolide, ning sõidukite väljaspool tootmisseadeldisi kasutatavate viimistlusmaterjalide alaliigid, lenduvate orgaaniliste ühendite sisalduse piirväärtused ning piirväärtustele vastavuse määramiseks kasutatavad meetodid",
      "rdfs:label": "orgaaniline ühend (lenduvaid_orgaanilisi_uhendeid_sisaldavate_varvide_ja_muude__t1036173)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_orgaaniline_uhend"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_lenduvaid_orgaanilisi_uhendeid_sisaldavate_varvide_ja_muude_t1036173_lenduv_orgaaniline_uhend",
