    {
      "@id": "estleg:Concept_uhisveevark_ja_kanalisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühisveevärk ja kanalisatsioon",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
