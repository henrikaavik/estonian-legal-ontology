    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidilise või füüsilise isiku omandis või valduses olev kinnisasi. Kinnistuga on eeskirjas võrdsustatud ka kinnistamata maaüksus, mille suhtes isikul on kasutusõigus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
      "rdfs:label": "kinnistu (peipsiaare_valla_heakorra_eeskiri_t1044621)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_kinnistu_kasutaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu kasutaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnisasja juriidilisest või füüsilisest isikust omanik, hoonestusõiguse omanik või korteriühistu olemasolu korral ühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorranõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
      "rdfs:label": "kinnistu kasutaja (peipsiaare_valla_heakorra_eeskiri_t1044621)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu_kasutaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_kogumismahuti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kogumismahuti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "nõuetele vastav vahend prügi kogumiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
