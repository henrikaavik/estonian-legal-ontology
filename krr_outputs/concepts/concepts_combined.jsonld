      "rdfs:label": "keskmise suurusega ettevõtja",
      "skos:definition": [
        {
          "@value": "ettevõtja, kes vastab komisjoni määruse (EL) nr 651/2014 I lisas keskmise suurusega ettevõtjale sätestatud kriteeriumidele",
          "@language": "et"
        },
        {
          "@value": "ettevõtja, kes vastab komisjoni määruse (EL) nr 651/2014 I lisas keskmise suurusega ettevõtjale sätestatud kriteeriumitele",
          "@language": "et"
        },
        {
          "@value": "ettevõtja, kes vastab üldise grupierandi määruse I lisa artikli 2 punktis 1 sätestatud kriteeriumitele",
          "@language": "et"
        },
        {
          "@value": "ettevõtja, kes vastab üldise grupierandi määruse I lisas keskmise suurusega ettevõtjale sätestatud kriteeriumidele",
