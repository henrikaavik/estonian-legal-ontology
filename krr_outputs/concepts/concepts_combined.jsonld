          "@value": "Palk",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ametnikule tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust",
          "@language": "et"
        },
        {
          "@value": "ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu",
          "@language": "et"
        },
        {
          "@value": "teenistuja põhipalk koos muutuvpalga ja lisatasudega",
          "@language": "et"
        },
        {
          "@value": "ametnikule makstav põhipalk, muutuvpalk, eritingimustes töötamise lisatasu ning asendustasu",
          "@language": "et"
        },
        {
          "@value": "tasu, mida makstakse ametnikule teenistusülesannete täitmise eest ja tasu, mida makstakse töötajale töölepingu alusel tehtud töö eest",
          "@language": "et"
        }
      ],
