    {
      "@id": "estleg:Concept_viru_nigula_valla_asutuste_infoturbe_pohimotted_t1047485_andmete_terviklus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "andmete terviklus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "andmete õigsus, puutumatus ja täielikkus, infovara lubamatute muudatuste puudumine; hõlmab ka info allika autentsust ja salgamatust",
