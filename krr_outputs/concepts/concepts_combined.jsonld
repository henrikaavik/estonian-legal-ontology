      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heitvesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on mehaaniliselt või bioloogiliselt puhastatud reovesi, mille saasteainete hulk pärast puhastamist vastab lubatud piirmäärale, ja mida saab juhtida suublasse või pinnasesse. 6) ie (inimekvivalent) - on ühe inimese tekitatud keskmine reostusmaht ööpäevas.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048980_Par_2"
        }
      ],
      "estleg:sourceAct": "Rakvere valla reovee kohtkäitluse ja äraveo eeskiri",
