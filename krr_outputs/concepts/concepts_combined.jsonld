      }
    },
    {
      "@id": "estleg:Concept_vaike_maarja_valla_jaatmehoolduseeskiri_t1050452_segaolmejaatmed_ehk_prugi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "segaolmejäätmed ehk prügi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olmejäätmed, mida ei ole liigiti kogutud või liigiti kogutud olmejäätmetest üle jäänud sortimisjääk",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050452_Par_2"
        }
      ],
