          "@value": "puu, mille rinnasdiameeter on vähemalt 15 cm ning puul on selgelt nähtav(ad) või määratav(ad) tüvi ja võra; 2",
          "@language": "et"
        },
        {
          "@value": "kasvav puu, mille rinnasdiameeter (tüve läbimõõt 1,3 meetri kõrguselt juurekaelast) on vähemalt 10 sentimeetrit, kõrghaljastuse element; [Jõelähtme Vallavolikogu 28.08.2007 määrus nr 71 – jõust. 10.09.2007] 2",
          "@language": "et"
        },
        {
          "@value": "kasvav puu, mille rinnasdiameeter (tüve läbimõõt 1,3 meetri kõrguselt juurekaelast) on vähemalt 8 sentimeetrit, kõrghaljastuse element; 2",
          "@language": "et"
        }
      ],
