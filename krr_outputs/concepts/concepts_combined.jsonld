      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tapa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1060264_Eesti_finantsaruandluse_standard",
