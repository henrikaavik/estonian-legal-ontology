      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhipalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametniku palga või töötaja töötasu fikseeritud osa, mis on määratud teenistuskoha teenistusülesannete ja vastutuse ning teenistuja teenistusalaste teadmiste, oskuste, kogemuste ja hariduse põhjal",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi Linnavalitsuse palgajuhend",
      "rdfs:label": "põhipalk (viljandi_linnavalitsuse_palgajuhend_t1057306)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pohipalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_muutuvpalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muutuvpalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi Linnavalitsuse palgajuhend",
      "rdfs:label": "muutuvpalk (viljandi_linnavalitsuse_palgajuhend_t1057306)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muutuvpalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_tulemuspalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tulemuspalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi Linnavalitsuse palgajuhend",
      "rdfs:label": "tulemuspalk (viljandi_linnavalitsuse_palgajuhend_t1057306)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tulemuspalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viljandi_linnavalitsuse_palgajuhend_t1057306_preemia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "preemia",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "erakordsete teenistusalaste saavutuste eest makstav lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057306_Par_2"
        }
      ],
      "estleg:sourceAct": "Viljandi Linnavalitsuse palgajuhend",
