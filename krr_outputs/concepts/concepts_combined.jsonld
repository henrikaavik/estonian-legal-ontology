    {
      "@id": "estleg:Concept_raieloa_ja_hooldusloikusloa_andmise_kord_t1050444_asendusistutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "asendusistutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ameti määratud kohale uu(t)e puu(de) istutamine raiutava(te) puu(de) asendamiseks ja istutatud puu(de) hooldamine kahe aasta jooksul",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050444_Par_2"
        }
      ],
      "estleg:sourceAct": "Raieloa ja hoolduslõikusloa andmise kord",
      "rdfs:label": "asendusistutus (raieloa_ja_hooldusloikusloa_andmise_kord_t1050444)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_asendusistutus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raieloa_ja_hooldusloikusloa_andmise_kord_t1050444_dendroloogiline_hinnang",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "dendroloogiline hinnang",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puu tervisliku seisundi hindamine ja edasise majandamise soovitused, mille lähteülesanne koostatakse lähtuvalt hinnangu eesmärgist ja konkreetsest objektist ja võib sisaldada muuhulgas täiendavate uuringute teostamist, puu väärtuse hindamist antud kasvukohal (sealhulgas linnaruumis), puu mõju hindamist rajatistele ja hoonete konstruktsioonidele või muid hinnanguid ning mille koostab puittaimede hindaja tase 5 või samaväärset (osa)kutset omav isik",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050444_Par_2"
        }
      ],
      "estleg:sourceAct": "Raieloa ja hoolduslõikusloa andmise kord",
      "rdfs:label": "dendroloogiline hinnang (raieloa_ja_hooldusloikusloa_andmise_kord_t1050444)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_dendroloogiline_hinnang"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raieloa_ja_hooldusloikusloa_andmise_kord_t1050444_hooldusloikus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoolduslõikus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puuokste eemaldamine, millega säilib puu elujõulisus ning mille tagajärjel vähemalt üks tekkiv lõikehaav on 3 cm või suurema läbimõõduga (käesolev kord sisaldab kõiki lõikusviise olenemata eesmärgist)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050444_Par_2"
        }
      ],
      "estleg:sourceAct": "Raieloa ja hoolduslõikusloa andmise kord",
      "rdfs:label": "hoolduslõikus (raieloa_ja_hooldusloikusloa_andmise_kord_t1050444)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hooldusloikus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raieloa_ja_hooldusloikusloa_andmise_kord_t1050444_hooldusloikusluba",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoolduslõikusluba",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vormikohane luba, mis annab õiguse teha puu hoolduslõikust ja milles sätestatakse töö iseloomust või asukohast tulenevad tingimused (nt arboristi kasutamise nõue, oksade koristus, ohutusnõuded vm); 6) murdunud puu/oks – puu või oks, mis on loodusjõudude tulemusel osaliselt või täielikult murdunud ja mis on vaja kohe likvideerida; 7) potentsiaalselt ohtlik puu/oks – puu tervisliku seisundi (nt mädanikud, kuivanud oksad, haigustekitajad või nende tegevuse tunnused jms) või muude näitajate poolest (nt v-ühendusega harud, teravnurga all väljuv oks, teadaolevad kaevetööd võra ulatuses, hiljuti viltu vajunud vms) potentsiaalselt ohtlik puu või oks.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050444_Par_2"
        }
      ],
      "estleg:sourceAct": "Raieloa ja hoolduslõikusloa andmise kord",
      "rdfs:label": "hoolduslõikusluba (raieloa_ja_hooldusloikusloa_andmise_kord_t1050444)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hooldusloikusluba"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
