      "skos:definition": [
        {
          "@value": "maksuhaldurile esitatav reklaamimaksu arvestamise dokument (edaspidi ka maksudeklaratsioon); 10",
          "@language": "et"
        },
        {
          "@value": "maksuhaldurile esitatav reklaamimaksu arvestamise dokument (edaspidi maksudeklaratsioon); 10",
          "@language": "et"
        }
      ]
    },
