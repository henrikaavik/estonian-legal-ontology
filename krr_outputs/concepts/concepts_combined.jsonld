        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ehitamise kuupäev",
      "skos:definition": [
        {
          "@value": "kui ei ole märgitud teisiti, on kuupäev, millal on pandud laeva kiil või algab antud laevale eriomaste konstruktsioonide kokkupanek või laev on sellises ehitusjärgus, millal laeva mass on vähemalt 50 tonni või 1% laeva ehitusjärgsest massist (vastavalt milline arv on väiksem)",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
