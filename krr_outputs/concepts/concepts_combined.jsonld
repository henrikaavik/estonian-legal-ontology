      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_reovee_kogumismahuti",
