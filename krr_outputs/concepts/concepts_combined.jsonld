      },
      "skos:definition": {
        "@value": "ajutine eluase, kus abivajajale on tagatud voodikoht, võimalus hoolitseda isikliku hügieeni eest. Tegemist on vältimatu abi korras osutatava eluasemeteenusega",
        "@language": "et"
      },
