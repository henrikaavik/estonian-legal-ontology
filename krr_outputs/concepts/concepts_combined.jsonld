      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_laevade_umberehitamiseks_t1060874_heiteta_soiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heiteta sõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "mere- ja rannikulaev reisijate- või kaubaveoks, sadamatoiminguteks või abitegevuseks, millel puudub väljalasketoru CO 2 otseheide vastavalt üldise grupierandi määruse artikli 2 punkti 102g alapunktile e",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060874_Par_4"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused ja kord laevade ümberehitamiseks keskkonnasõbralikumaks",
      "rdfs:label": "heiteta sõiduk (toetuse_andmise_tingimused_ja_kord_laevade_umberehitamiseks__t1060874)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_heiteta_soiduk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_laevade_umberehitamiseks_t1060874_keskkonnasobralik_soiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "keskkonnasõbralik sõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reisijate- ja kaubaveoks, sadamatoiminguteks või abitegevuseks kasutatav mere- ja rannikulaev, millel on hübriid- või kaherežiimiline mootor ja mille energiast pärineb vähemalt 25 protsenti väljalasketoru CO 2 otseheiteta kütustest või mis kasutab merel ja sadamates tavatingimustes käitamiseks elektrivõrgu energiat või mille Rahvusvahelise Mereorganisatsiooni energiatõhususe indeksi väärtus on 10 protsenti väiksem kui 1. aprillil 2022 kohaldatavad energiatõhususe indeksi nõuded ning laev on suuteline sõitma väljalasketoru CO 2 otseheiteta kütuste või taastuvatest energiaallikatest saadud kütuste jõul vastavalt üldise grupierandi määruse artikli 2 punkti 102f alampunktile d",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060874_Par_4"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused ja kord laevade ümberehitamiseks keskkonnasõbralikumaks",
      "rdfs:label": "keskkonnasõbralik sõiduk (toetuse_andmise_tingimused_ja_kord_laevade_umberehitamiseks__t1060874)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_keskkonnasobralik_soiduk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
