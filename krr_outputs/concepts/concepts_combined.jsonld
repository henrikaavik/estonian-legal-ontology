      "rdfs:label": "täiendusõpe",
      "skos:definition": [
        {
          "@value": "õpetajate ja haridusasutuste juhtide professionaalset arengut toetavad arenduslahendused. Täiendusõpe on suunatud õpetajate ja koolijuhtide kutsealaste teadmiste ja oskuste süvendamisele, mis loob uusi võimalusi nende poolt omandatud kutsemeisterlikkuse efektiivsemaks kasutamiseks; 11",
          "@language": "et"
        },
        {
          "@value": "õpetajate professionaalset arengut toetavad lahendused, mis on suunatud õpetajate õppevara kasutamiseks vajalike teadmiste ja oskuste süvendamisele ning loovad uusi võimalusi nende poolt omandatud kutsemeisterlikkuse efektiivsemaks kasutamiseks. 7",
          "@language": "et"
        }
      ]
    },
