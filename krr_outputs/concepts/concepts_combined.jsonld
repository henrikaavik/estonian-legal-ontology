      "skos:prefLabel": {
        "@value": "Palgafondina käsitletakse esindusvõistkonna nimekirja kuuluvatele inimestele suunatavaid palga",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_viimsi_valla_sportmangu_esindusvoistkondade_toetamise_kord_t1043149_Palgafondina_kasitletakse_esindusvoistkonna_nimekirja_kuuluvatele_inimestele_suu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Palgafondina käsitletakse esindusvõistkonna nimekirja kuuluvatele inimestele suunatavaid palga",
      "skos:definition": [
        {
          "@value": "ja stipendiumifondi rahalisi vahendeid. Palgafondi rahaliste vahendite hulka kuuluvad üksnes võistlevatele sportlastele, esindusvõistkonna treeneritele, füsioterapeutidele, arstidele ja võistkonna juhile makstavad tasud. RT IV 2021-10-22 15 422102021015 2021-10-25 23",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_palgagrupp",
