          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "lisatasu, mida makstakse juhul kui teenistuja tööaeg langeb ööajale ning kui nimetatud kohustus ei sisaldu tema ametijuhendis ja seda ei ole arvestatud tema palga määramisel; 16",
          "@language": "et"
        },
        {
          "@value": "kui nimetatud kohustus ei sisaldu teenistuja ametijuhendis ja seda ei ole arvestatud tema palga määramisel või töötasu kokku leppimisel. 3",
          "@language": "et"
        },
        {
          "@value": "kui nimetatud kohustus ei sisaldu töötaja tööülesannete kirjelduses ja seda ei ole arvestatud tema töötasu kokku leppimisel. 3",
          "@language": "et"
        },
        {
          "@value": "lisatasu, mida makstakse juhul kui teenistuja tööaeg langeb ööajale ning kui nimetatud kohustus ei sisaldu tema ametijuhendis ja seda ei ole arvestatud tema palga määramisel. 16",
          "@language": "et"
        },
        {
          "@value": "lisatasu, mida makstakse teenistujale juhul, kui teenistuja tööaeg langeb ööajale (kella 22:00-06:",
          "@language": "et"
        }
      ]
    },
