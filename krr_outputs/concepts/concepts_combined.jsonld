      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "konverents",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kohtumine, mis on korraldatud teatava valdkonna või teema(de) arutamiseks ning teabe ja uuenduslike ideede vahetamiseks. Konverentsiks ei loeta kohtumist, kus osalevad ainult sama juriidilise isiku, organisatsiooni vms töötajad, kliendid, koostöö- ja/või äripartnerid, ega õppereisi, koolitust, võistlust, messi, töökoosolekut, infopäeva, näitust, festivali või häkatoni; 2026-03-05",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057929_Par_4"
        }
      ],
