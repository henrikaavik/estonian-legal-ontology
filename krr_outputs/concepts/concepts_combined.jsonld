    {
      "@id": "estleg:Concept_uhisveevargi_ja_kanalisatsiooniga_liitumise_ning_uhisveevarg_t1054109_vee_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Valga vallavolikogu poolt määratud vee-ettevõtja, kes osutab valla territooriumil veevarustuse ja reovee ärajuhtimise teenuseid; 25) vee- või reovee mõõtesõlm – vee või reovee mõõtmiseks ettenähtud vee- või reovee arvestist ja arvesti juurde kuuluvast armatuurist koosnev tehniline sõlm; 26) vee- või reovee mõõtekaev – kaev, kus asub vee- või reovee mõõtesõlm",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054109_Par_2"
        }
      ],
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooniga liitumise ning ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
