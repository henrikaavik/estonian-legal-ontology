    },
    {
      "@id": "estleg:Concept_johvi_valla_infoturvapoliitika_t1058728_terviklus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "terviklus",
      "skos:definition": "andmete õigsuse, täielikkuse ja ajakohasuse tagatus ning päritolu autentsus ja volitamatute muutuste puudumine; 4",
