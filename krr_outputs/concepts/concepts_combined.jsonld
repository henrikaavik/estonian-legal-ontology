      "estleg:definesConcept": {
        "@id": "estleg:Concept_avaliku_sektori_uksused"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_raamatupidamise_sise_eeskiri_t1060536_Eesti_finantsaruandluse_standard",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Eesti finantsaruandluse standard",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev avalikkusele suunatud finantsaruandluse nõuete kogum, mille põhinõuded kehtestatakse RPS-s ning mida täpsustavad RTJ-id ja üldeeskiri",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060536_Par_4"
        }
      ],
      "estleg:sourceAct": "Kohila valla raamatupidamise sise-eeskiri",
      "rdfs:label": "Eesti finantsaruandluse standard (kohila_valla_raamatupidamise_sise_eeskiri_t1060536)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eesti_finantsaruandluse_standard"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_raamatupidamise_sise_eeskiri_t1060536_konsolideerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "konsolideerimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "raamatupidamisüksuste aruannete ühendamine nii, nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega kaasneb elimineerimine, so konsolideerimisgruppi kuuluvate isikute omavaheliste vastandtehingute (tulud-kulud, nõuded-kohustused) liitmine nii, et grupi aruandes neid ei esine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060536_Par_4"
        }
      ],
      "estleg:sourceAct": "Kohila valla raamatupidamise sise-eeskiri",
      "rdfs:label": "konsolideerimine (kohila_valla_raamatupidamise_sise_eeskiri_t1060536)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_konsolideerimine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_raamatupidamise_sise_eeskiri_t1060536_majandustehingute_kirjendaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "majandustehingute kirjendaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja/töötaja, kes lähtuvalt finantsaruandluse standardist kirjendab majandustehinguid raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on kirjendajaks raamatupidaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060536_Par_4"
        }
      ],
