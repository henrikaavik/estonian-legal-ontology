        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toetuse taotleja",
      "skos:definition": [
        {
          "@value": "juriidiline isik või asutus, kes on esitanud taotluse toetuse saamiseks. Toetuse taotleja võib olla kas projekti juhtpartner või projektipartner",
          "@language": "et"
        },
        {
          "@value": "kohanduse saaja või tema (seaduslik) esindaja",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_teenuse_taotleja"
        }
      ],
