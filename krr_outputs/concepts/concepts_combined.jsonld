        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huviharidus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pikaajaline süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest ja õppetööst vabal ajal huvikooli seaduse alusel tegutsevas koolis.",
