      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jäätmekäitlus",
      "skos:definition": "jäätmete kogumine, vedamine, taaskasutamine, sealhulgas sortimine ja kõrvaldamine, sealhulgas vahendamine või edasimüümine; 8",
      "estleg:definedIn": [
