        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palgagrupp",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valdavas osas sarnaste teenistusülesannetega teenistuskohtade grupp, mis on jaotatud tasemeteks vastavalt täidetavate ülesannete iseloomule ja teenistusülesannete täitmisega kaasnevale vastutusele ning millele on määratud põhipalga miinimum- ja maksimummäär; Palgajuhendis käsitletakse vallavalitsuse struktuuriüksusena kantseleid ja vallavalitsuse teenistusi. Palgajuhendis kasutatakse ametniku palga ja töötaja töötasu ühtse mõistena mõistet palk.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041450_Par_2"
        }
      ],
