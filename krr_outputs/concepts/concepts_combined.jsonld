      "rdfs:label": "töötasu",
      "skos:altLabel": [
        {
          "@value": "Töötasu",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "töötajale tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust.",
          "@language": "et"
        },
        {
          "@value": "töötajale tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust; 6",
          "@language": "et"
        },
        {
          "@value": "tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasust, mida asutus maksab töötajale tehtud töö eest vastavalt töölepingule, õigusaktidele ja tööandja poolt kehtestatud korrale; 7",
          "@language": "et"
        },
        {
          "@value": "töölepingu alusel töötajale makstav tasu; 2",
          "@language": "et"
        },
        {
          "@value": "töötajale tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust. 6",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "33",
        "@type": "xsd:integer"
      },
