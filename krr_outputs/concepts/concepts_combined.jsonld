    {
      "@id": "estleg:Concept_kiili_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeski_t1024955_vaatluskaev",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vaatluskaev",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "maa- või teepinnale avanev eemaldatava luugiga kaev (toru) kanalisatsioonitorustikul. Maapinnale ulatuv luuk kuulub vaatluskaevu osana kanalisatsioonirajatiste hulka",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1024955_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
