    {
      "@id": "estleg:Concept_taiendavad_terviseandmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "täiendavad terviseandmed",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_taiendavad_terviseandmed"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "täiendavad terviseandmed",
      "skos:definition": [
        {
          "@value": "töötukassa poolt töövõimetoetuse seaduse § 7 lõike 6 alusel arstilt taotletud isiku terviseandmed, kui isiku töövõime hindamise taotlusel märgitud arst ei ole andmeid tervise infosüsteemi sisestanud või tervise infosüsteemi sisestatud andmed on töövõime hindamiseks ebapiisavad, sealhulgas juhul, kui olemasolevad terviseandmed vajavad täpsustamist või on sisult vastuolulised. Töötukassa võib isiku piirangute täpsustamiseks andmeid taotleda ka töövõime hindamise taotlusel märgitud spetsialistilt.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
