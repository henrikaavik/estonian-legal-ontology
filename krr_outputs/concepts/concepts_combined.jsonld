    {
      "@id": "estleg:Concept_messitoetuse_andmise_kord_t1021057_toetuse_saaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toetuse saaja",
        "@language": "et"
