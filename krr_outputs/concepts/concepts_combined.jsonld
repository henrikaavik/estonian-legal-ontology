      "rdfs:label": "vähekindlustatud isik või pere",
      "skos:definition": [
        {
          "@value": "isik või pere, kelle sissetulek ühe isiku või pereliikme kohta kuus jääb alla kohaliku toimetulekupiiri",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
