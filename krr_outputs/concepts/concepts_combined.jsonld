      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_mootorsoiduki_ja_selle_haagise_registreerimise_tingimused_ja_t1000727_riiklik_registreerimismark",
      "@type": [
