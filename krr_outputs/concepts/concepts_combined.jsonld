      "skos:definition": [
        {
          "@value": "koer või kass",
          "@language": "et"
        },
        {
          "@value": "imetaja, lind, roomaja, kahepaikne, kala või selgrootu",
          "@language": "et"
        },
        {
          "@value": "koer ja kass",
          "@language": "et"
        },
        {
          "@value": "imetaja, lind, roomaja, kahepaikne, kala või selgrootu. Põllumajandusloom on loomsete saaduste tootmise eesmärgil peetav ja aretatav loom sh ka hobuslane",
          "@language": "et"
        },
        {
          "@value": "inimese isiklikuks meelelahutuseks või seltsiks peetav või sellel eesmärgil pidamiseks mõeldud loom sh loomsete saaduste tootmise eesmärgil peetav ja aretatav loom",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
