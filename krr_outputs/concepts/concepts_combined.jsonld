      }
    },
    {
      "@id": "estleg:Concept_biomassist_elektrienergia_koostootmise_juhis_t345646_elektrienergia_omatarve",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elektrienergia omatarve",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "osa elektrienergia brutotoodangust, mida koostootmisseade kasutab tootmisprotsessis oma vajadusteks, eelkõige suitsuimurite, ventilaatorite ja toitepumpade tööks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_345646_Par_2"
        }
      ],
