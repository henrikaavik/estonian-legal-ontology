        },
        {
          "@id": "estleg:Concept_raie_ja_hooldusloikusloa_andmise_kord_t1059300_ohtlik_puu_voi_oks"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ohtlik puu või oks",
      "skos:definition": [
        {
          "@value": "puu või oks, mis on osaliselt või täielikult murdunud või mis murdub välise vaatluse järgi ilmselgelt lähiajal või ohustab liiklejaid ning mida on vaja kohe raiuda või eemaldada",
          "@language": "et"
        },
        {
          "@value": "puu või oks, mis on osaliselt või täielikult murdunud või mis on välise vaatluse põhjal peatselt murdumas ning ohustab inimesi või vara",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
