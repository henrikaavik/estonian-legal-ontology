      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Rakvere vallaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud vallavalitsuses ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
