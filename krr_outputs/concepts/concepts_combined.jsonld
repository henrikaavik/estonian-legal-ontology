        "@id": "estleg:Concept_omapuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054816_purgimiskoht",
