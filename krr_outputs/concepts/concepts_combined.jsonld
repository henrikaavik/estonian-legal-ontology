      "skos:definition": [
        {
          "@value": "Harku Vallavalitsuse planeerimis- ja ehitusosakonna (edaspidi nimetatud ka PEO) poolt käesolevas määruses sätestatud tingimustel väljastatud luba, mille alusel reklaami avalikustaja võib paigaldada paigaldusloa taotluses näidatud reklaami; RT IV 2025-04-03 4 403042025004 2025-04-06 4",
          "@language": "et"
        },
        {
          "@value": "Harku Vallavalitsuse planeerimis- ja ehitusosakonna (edaspidi nimetatud ka PEO) poolt käesolevas määruses sätestatud tingimustel väljastatud luba, mille alusel reklaami avalikustaja võib paigaldada paigaldusloa taotluses näidatud reklaami; RT IV 2025-04-03 5 403042025005 2025-04-06 4",
          "@language": "et"
        },
        {
          "@value": "Kohila Vallavalitsuse korrakaitsespetsialisti poolt antud luba, mis võimaldab paigaldada reklaami määruses sätestatud tingimustel; 4",
          "@language": "et"
        },
        {
          "@value": "luba, mis annab õiguse reklaami ja/või reklaamikandja paigaldamiseks; 3",
          "@language": "et"
        },
        {
          "@value": "luba, mis annab õiguse reklaami ja/või reklaamikandja paigaldamiseks; 5",
          "@language": "et"
        }
