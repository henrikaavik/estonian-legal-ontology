        {
          "@value": "Projekt",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "toetuse taotluses märgitud tegevuste kogum, mis viiakse ellu abikõlblikkuse perioodil.",
          "@language": "et"
        },
        {
          "@value": "ettepanekus sisalduv kindlaksmääratud tulemuse, eelarve ja piiritletud ajaraamiga tegevus või seotud tegevuste kogum, millega kaasnevate kulude hüvitamiseks toetust taotletakse või kasutatakse; 9",
          "@language": "et"
        },
        {
          "@value": "kindla eesmärgi saavutamisele suunatud ajas ja ruumis piiritletud ühekordne tegevus või tegevuste kogum tulemuse saavutamiseks, mille kulud kaetakse osaliselt või täielikult valla eelarvevälistest vahenditest, kuid mille üheks partneriks on Viimsi vallavalitsus või valla hallatav asutus; 2",
          "@language": "et"
        },
        {
          "@value": "kindla eesmärgi saavutamisele suunatud ajas ja ruumis piiritletud ühekordne tegevus või tegevuste kogum, mille tegemiseks toetust taotletakse ja kasutatakse; 7",
          "@language": "et"
        },
        {
          "@value": "kindla eesmärgi saavutamisele suunatud ajas ja ruumis piiritletud ühekordne tegevus või tegevuste kogum, milleks toetust taotletakse, antakse ja kasutatakse. 3 (",
          "@language": "et"
        }
      ],
