      "rdfs:label": "lisatasu täiendavate teenistusülesannete täitmise eest",
      "skos:definition": [
        {
          "@value": "ametijuhendis või töölepingus sätestamata teenistusülesannete täitmise eest makstav täiendav tasu",
          "@language": "et"
        },
        {
          "@value": "ametijuhendis või töölepingus nimetamata teenistusülesannete täitmise eest makstav täiendav tasu",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
