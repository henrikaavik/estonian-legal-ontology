    {
      "@id": "estleg:Concept_korraldatud_jaatmevedu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "korraldatud jäätmevedu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_joelahtme_valla_jaatmehoolduseeskiri_t1053601_korraldatud_jaatmevedu"
        },
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_korraldatud_jaatmevedu"
        },
        {
          "@id": "estleg:Concept_rapina_valla_jaatmehoolduseeskiri_t1057272_korraldatud_jaatmevedu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "korraldatud jäätmevedu",
      "skos:definition": [
        {
          "@value": "korraldatud jäätmeveoga hõlmatud jäätmete kogumine ja transportimine jäätmekäitluskohta",
          "@language": "et"
        },
        {
          "@value": "olmejäätmete kogumine ja vedamine määratud piirkonnast jäätmete käitluskohta või kohtadesse vallavalitsuse valitud ettevõtja poolt",
          "@language": "et"
        },
        {
          "@value": "olmejäätmete, eelkõige prügi ehk segaolmejäätmete, nende sortimisjääkide ja olmejäätmete tekkekohas liigiti kogumisel tekkinud jäätmeliikide kogumine ja vedamine määratud piirkonnast määratud jäätmekäitluskohta või -kohtadesse kohaliku omavalitsuse üksuse korraldatud konkursi korras valitud ettevõtja (jäätmevedaja) poolt. Korraldatud jäätmevedu võib hõlmata ka teisi olmejäätmete liike või muid jäätmeid, kui see on vajalik jäätmeseaduse nõuete täitmiseks või seda tingib oluline avalik huvi",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
