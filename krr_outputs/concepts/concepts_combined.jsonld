        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tehtud töö eest makstav tasu, mis koosneb põhipalgast, millele võivad lisanduda lisatasu ja eritingimustes töötamise eest makstav tasu; 6) põhipalk- fikseeritud palga osa, mis on määratud ametikoha ülesannete ning ametniku teenistusalaste teadmiste, oskuste, kogemuste ja vastutuse põhjal",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040811_Par_2"
        }
      ],
      "estleg:sourceAct": "Anija Vallavalitsuse teenistujate ja hallatavate asutuste töötajate palgajuhend",
