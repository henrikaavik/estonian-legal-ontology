    {
      "@id": "estleg:Concept_ruhnu_valla_avaliku_urituse_korraldamise_kord_t1024896_Korgendatud_turvarisk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kõrgendatud turvarisk",
      "skos:definition": "kõrgendatud turvariski olemasolu hindab Ruhnu Vallavalitsus. Kõrgendatud turvariskiga ürituseks võidakse lugeda üritust, mis vastab vähemalt ühele järgmistest tingimustest: a) toimub alkoholi müük; b) korraldatakse selle pakkumine selleks mitteettenähtud ehitises või kohas ja/või millega kaasneb tribüüni, lava või muu lisainventari paigaldamine; c) piirneb alaga, mis võib kujutada kõrgendatud turvariski; d) lahtise tule kasutamine; e) keskkonnakahju tekkimise oht.",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1024896_Par_1"
        }
      ],
      "estleg:sourceAct": "Ruhnu valla avaliku ürituse korraldamise kord",
      "rdfs:label": "Kõrgendatud turvarisk (ruhnu_valla_avaliku_urituse_korraldamise_kord_t1024896)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korgendatud_turvarisk"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_korgendatud_turvarisk"
        }
      ]
    },
    {
      "@id": "estleg:Concept_ruhnu_valla_jaatmehoolduseeskiri_t1053973_biolagunevad_aia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "biolagunevad aia",
      "skos:definition": "ja haljastusjäätmedon aedade ja haljasalade hooldamisel tekkinud biolagunevad jäätmed (nt rohi, lehed, peened oksad jmt); 2",
