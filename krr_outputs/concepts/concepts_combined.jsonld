      "rdfs:label": "majandusinformatsiooni liigendamine",
      "skos:altLabel": [
        {
          "@value": "Majandusinformatsiooni liigendamine",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "valla majandustehingute kirjendamine, kasutades riigi või valla õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid valla juhtimisotsuste tegemiseks ning riigi aruandluse jaoks.",
          "@language": "et"
        },
        {
          "@value": "valla majandustehingute kirjendamine, kasutades riigi või valla õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid valla juhtimisotsuste tegemiseks ning riigi aruandluse jaoks; 9",
          "@language": "et"
        },
        {
          "@value": "linna majandustehingute kirjendamine, kasutades riigi ja linna õigusaktidega kehtestatud ning linna finantsteenistuse loodud tunnuseid (koode), mis on vajalikud nii linna sise- kui ka välise aruandluse tagamiseks; 6",
          "@language": "et"
        },
        {
          "@value": "Linna majandustehingute kirjendamine, kasutades riigi õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid Linna juhtimisotsuste tegemiseks ning nõutava välise aruandluse tagamiseks; 13",
          "@language": "et"
        },
        {
          "@value": "majandustehingute kirjendamine, kasutades riigi või omavalitsuse õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid juhtimisotsuste tegemiseks ning aruandluse jaoks; 8",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "12",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_majanduskulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
