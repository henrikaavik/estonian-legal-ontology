      "skos:definition": [
        {
          "@value": "füüsilisest või juriidilisest isikust reklaami paigaldaja või avalikustaja; 5",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kes avalikustab (paigaldab) käesoleva määruse § 2 lõike 2 punktis 1 nimetatud reklaami; 10",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kes on paigaldanud käesoleva määruse kohaldamisalasse kuuluva reklaami; 10",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isik, kes on paigaldanud käesoleva määruse § 2 punktis 6 nimetatud reklaami; 8",
          "@language": "et"
        },
        {
          "@value": "isik, kelle tehtud tehingu väärtust käesoleva määruse alusel käsitletakse; 2",
          "@language": "et"
        }
      ],
