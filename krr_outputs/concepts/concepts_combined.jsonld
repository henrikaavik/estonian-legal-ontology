        "@language": "et"
      },
      "skos:definition": {
        "@value": "puu langetamine (likvideerimine juurekaelalt) koos töömaa koristusega ja raiejäätmete utiliseerimisega (ilma kändude freesimiseta), puu tüveharu ja ladva eemaldamine või puu võra vähendamine rohkem kui 50%",
        "@language": "et"
      },
