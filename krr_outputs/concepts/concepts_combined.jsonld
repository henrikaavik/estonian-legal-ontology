        }
      ],
      "skos:definition": [
        {
          "@value": "heitvee, reovee ja sademevee kogumine, ärajuhtimine ning reovee vastu võtmine puhastamise eesmärgil. 11",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine ja ärajuhtimine kanalisatsiooni kaudu; 7",
          "@language": "et"
        },
        {
          "@value": "reovee ärajuhtimine reovee kanalisatsiooni või sademevee ärajuhtimine sademevee kanalisatsiooni kaudu; 3",
          "@language": "et"
        },
        {
          "@value": "heit-, reo-, sademe- ja drenaaživee või muu pinnase- ja pinnavee kogumine ja ärajuhtimine kanalisatsiooni kaudu; 3",
          "@language": "et"
        },
        {
          "@value": "heit-, reo-, sademe- ja drenaaživee või muu vee kogumine ja ärajuhtimine kanalisatsiooni kaudu; 9",
          "@language": "et"
        }
      ],
