        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rapina_vallavalitsuse_palgajuhend_t1040940_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Räpina vallaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud vallavalitsuses ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040940_Par_2"
        }
      ],
      "estleg:sourceAct": "Räpina Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (rapina_vallavalitsuse_palgajuhend_t1040940)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rapina_vallavalitsuse_palgajuhend_t1040940_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on võetud vallavalitsuse töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040940_Par_2"
        }
      ],
      "estleg:sourceAct": "Räpina Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (rapina_vallavalitsuse_palgajuhend_t1040940)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
