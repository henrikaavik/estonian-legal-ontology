      },
      "rdfs:label": "bioloogiliselt mittelagunevad aia",
      "skos:definition": [
        {
          "@value": "ja haljastujäätmed on pinnas, kivid ja muud bioloogiliselt mittelagunevad aia- ja haljastujäätmed; 8",
          "@language": "et"
        },
        {
          "@value": "ja haljastujäätmed on pinnas, kivid ja muud bioloogiliselt mittelagunevad aia- ja haljastujäätmed; 5",
          "@language": "et"
        },
        {
          "@value": "ja haljastujäätmed on kivid, pinnas jms jäätmed, mis tekivad aiapidamisel, kuid ei ole biolagunevad; 9",
          "@language": "et"
        },
        {
          "@value": "ja haljastujäätmed on pinnas, kivid ja muud bioloogiliselt mittelagunevad aia- ja haljastujäätmed; 9",
          "@language": "et"
        }
      ]
    },
