        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toetus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla eelarvest kindla eesmärgi täitmiseks antav raha, mis kantakse rahastamise otsuse ja/või toetuslepingu allkirjastamise järgselt tervikuna või tingimustes ette nähtud osade kaupa üle toetuse saaja arvelduskontole",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056755_Par_3"
        }
      ],
