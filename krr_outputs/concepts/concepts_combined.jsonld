      "skos:definition": [
        {
          "@value": "asutusele infotehnoloogia- ja kommunikatsiooniteenuseid (edaspidi IT ) või teisi teabe turvalisusega seotud teenuseid kokkulepitud tingimustel ja tasemel osutav organisatsioon või isik",
          "@language": "et"
        },
        {
          "@value": "eralasteasutus, mis osutab vastavat teenust Saku valla elanikuna rahvastikuregistrisse kantud hoiu- või lasteaiarühmaealisele lapsele",
          "@language": "et"
        },
        {
          "@value": "ettevõtja, kes osutab kalmistul klientidele teenuseid (hauaplatside kujundamine, hooldamine jms)",
