    {
      "@id": "estleg:Concept_liitumisavaldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Liitumisavaldus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooniga_liitumi_t1058899_Liitumisavaldus"
        },
