      "estleg:definesConcept": {
        "@id": "estleg:Concept_spordiedendaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rae_vallavalitsuse_palgajuhend_t1056436_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev isik, kes teostab avalikku võimu. Ametnik nimetatakse ametikohale ja vabastatakse teenistusest avaliku teenistuse seaduse alusel. Ametniku teenistuskohta nimetatakse ametikohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056436_Par_2"
        }
      ],
      "estleg:sourceAct": "Rae Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (rae_vallavalitsuse_palgajuhend_t1056436)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rae_vallavalitsuse_palgajuhend_t1056436_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning tema teenistuskohta nimetatakse töökohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056436_Par_2"
        }
      ],
      "estleg:sourceAct": "Rae Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (rae_vallavalitsuse_palgajuhend_t1056436)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rae_vallavalitsuse_palgajuhend_t1056436_teenistuja",
