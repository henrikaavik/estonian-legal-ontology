      ],
      "skos:prefLabel": {
        "@value": "eluruum",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Saue valla omandis olev alaliseks elamiseks kasutatav elamu, korter ja muu ruum, mis vastab eluruumile kehtestatud nõuetele",
