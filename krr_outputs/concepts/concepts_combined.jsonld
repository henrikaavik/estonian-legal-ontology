      },
      "rdfs:label": "partner",
      "skos:definition": [
        {
          "@value": "isik, asutus või organisatsioon, kellega koostöös toetuse saaja projekti ellu viib ja kelle osalemine projektis on vajalik soovitud tulemuste saavutamiseks",
          "@language": "et"
        },
        {
          "@value": "juriidiline isik, riigiasutus, kohaliku omavalitsuse asutus või rahvusvaheline organisatsioon, kes osaleb toetatavas tegevuses ja kellel tekivad selle käigus abikõlblikud kulud. Partner ei ole toetuse saajale töövõtja ega teenuse osutaja",
          "@language": "et"
        },
        {
          "@value": "partner on taotluses nimetatud projektiga otseselt seotud kohaliku omavalitsuse üksus või riigiasutus või erakooli pidaja, kes osaleb projektis toetatava tegevuse rakendamisel ja kellel tekivad selle käigus kulud",
          "@language": "et"
        },
        {
          "@value": "projekti kaasatud asutus või isik, kes ei ole koostööpartner, kuid panustab projekti eesmärkide täitmisesse",
          "@language": "et"
        },
        {
          "@value": "projekti kaaselluviija ÜSS 2021–2027 § 2 lõike 5 mõistes",
          "@language": "et"
        }
      ],
