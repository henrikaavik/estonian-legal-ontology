      ],
      "skos:prefLabel": {
        "@value": "vahelduva reklaamiga välireklaamikandja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teabekandja (tahvel, digi- või LED-ekraan vm), millel edastatakse liikuva kujutisega reklaami või vahelduvat reklaami, mis paigaldatakse hoonetele või maapinnale",
        "@language": "et"
      },
