    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_piirkondade_konkurentsivoime",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "piirkondade konkurentsivõime",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "piirkondade võime luua eeldusi jätkusuutlike töökohtade pakkumiseks, elujõuliste ettevõtete tekkeks ning erainvesteeringute kaasamiseks, samuti võime luua eeldusi piirkonna elanike arvu stabiliseerimiseks või kasvuks ja külastajate arvu suurendamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "piirkondade konkurentsivõime (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_piirkondade_konkurentsivoime"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_kompetentsikeskus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kompetentsikeskus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "piirkonna teadus- ja arendusasutuste ning haridusasutuste, ettevõtjate ja avaliku võimu esindajatest koosnev sektoritevahelisel koostööl põhinev ühendus, mis omab kindlaid kompetentse ja ressursse ning tegutseb ettevõtluse arendamise eesmärgil koondades, vahendades, rakendades ja arendades neid ressursse ja kompetentse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "kompetentsikeskus (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kompetentsikeskus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_kompetents",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kompetents",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "uuendusliku teabe, selle loomise, vahendamise ja rakendamisega seotud asjatundlikkus, mille valdkondlik suund on selgelt piiritletav ning mille abil saab luua lisandväärtust tekitavaid ressursi- või tulemuspõhiseid uuenduslikke arendusi ja saavutada kompetentsikeskuse kõrge konkurentsivõime; 5) teadus- ja arendusasutus – asutus ja juriidiline isik, mille põhitegevus on teadus- ja arendustegevus «Teadus- ja arendustegevuse korralduse seaduse» mõistes",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "kompetents (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kompetents"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_haridusasutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "haridusasutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "riigi- või munitsipaalasutus nagu rakenduskõrgkool või kutseõppeasutus, kus õpetamine ja õppimine toimub vastavalt õppekavale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "haridusasutus (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_haridusasutus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_kompetentsikeskuse_konkurentsivoime",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kompetentsikeskuse konkurentsivõime",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "piirkonnas tegutseva kompetentsikeskuse võime saavutada tervikuna selline väljaarendatuse tase, mis annab perspektiivis eelduse koostöö- ja partnerlussidemete loomiseks või kujuneda konkurentsivõimeliseks nii Eestis kui välisriigis olevate samalaadsete, konkreetses kompetentsivaldkonnas tegutsevate organisatsioonidega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "kompetentsikeskuse konkurentsivõime (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kompetentsikeskuse_konkurentsivoime"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_ideekavand",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ideekavand",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eeltaotlemise korras vormikohaselt esitatud kavandatava kompetentsikeskuse kontseptuaalne kirjeldus, mille heakskiitmise korral saab selle esitaja või tema koostööpartner õiguse esitada taotlus tugi- või põhitegevuse finantseerimiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "ideekavand (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ideekavand"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_tugitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tugitegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kavandatava kompetentsikeskuse välja arendamisele ja põhitegevuste ette valmistamisele kaasa aitav strateegilise iseloomuga tegevus, mille tulemusena on kompetentsikeskuse arendamisega seotud partnerid omavahelises koostöös välja selgitanud kompetentsikeskuse ellukutsumiseks vajalikud arendustööd ja edasised põhitegevused",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "tugitegevus (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tugitegevus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_pohitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhitegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kompetentsikeskuse väljaarendamisele otseselt suunatud tegevus või tegevuste kogum, mis omab selget valdkondlikku piiritletust ja mida finantseeritakse käesoleva meetme raames",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "põhitegevus (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pohitegevus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_taotlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taotlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vormikohane kirjalik avaldus tugi- või põhitegevuse läbiviimiseks, mis sisaldab projekti, millele toetust taotletakse, ja sellele lisatud dokumente toetuse taotlemiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "taotlus (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_taotlus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_koostoopartner",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "koostööpartner",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kompetentsikeskuse arendamisega seotud, koostöölepingu allkirjastanud juriidiline isik, kes on kaasatud kompetentsikeskuse arendamiseks läbiviidava projekti finantseerimisse, juhtimisse või elluviimisse. Koostööpartneritena käsitletakse nii mittetulundusühingut, sihtasutust, äriühingut, teadus- ja arendusasutust ning haridusasutust kui ka riigi- ja kohaliku omavalitsuse üksusi. Koostööpartneri rahaline panus projekti elluviimisse ei pea olema rahaliselt mõõdetav",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "koostööpartner (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_koostoopartner"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_koostooleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "koostööleping",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kompetentsikeskuse arendamisega seotud koostööpartnerite vahel sõlmitud kirjalik ühise tegutsemise leping, mis esitatakse koos taotlusega ideekavandi esitamise ja põhitegevuse toetuse taotlemisel juhul, kui taotlejaks ei ole määruse § 5 kohaselt asutatud sihtasutus või mittetulundusühing, mis reguleerib partneritevahelisi suhteid ideekavandi esitamisest taotluses sisalduva projekti elluviimiseni ja kompetentsikeskuse alalise juhtorgani koosseisu määramist ja juhtorgani tööpõhimõtteid; 14) teadus- ja arendusasutuse teadustöötaja – teadur, vanemteadur ja juhtivteadur; ka teadus- ja arendusasutuste juht ning teadus- ja arendusasutuste teadusliku struktuuriüksuse juht juhul, kui nad osalevad teadusteema või uurimisprojekti täitmises",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "koostööleping (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_koostooleping"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_korge_kvalifikatsiooniga_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kõrge kvalifikatsiooniga töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teadur, insener, disainer ja müügijuht, kellel on kolmanda taseme haridust tõendav kraad ning vähemalt viieaastane töökogemus asjaomases valdkonnas. Doktoriõpet võib lugeda asjaomaseks töökogemuseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
      "rdfs:label": "kõrge kvalifikatsiooniga töötaja (meetme_kompetentsikeskuste_arendamine_tingimused_t336593)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korge_kvalifikatsiooniga_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "«Äriseadustiku» kohaselt äriregistris registreeritud äriühing; 17) väike- ja keskmise suurusega ettevõtja (edaspidi VKE ) – väikeettevõtja ja keskmise suurusega ettevõtja vastavalt üldise grupierandi määruse lisale 1",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_336593_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme «Kompetentsikeskuste arendamine» tingimused",
