        "@value": "ühiskanalisatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitiste ja seadmete kompleks kinnistute reovee kanaliseerimiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
