      "rdfs:label": "lahkvoolne kanalisatsioon",
      "skos:definition": [
        {
          "@value": "kanalisatsioonisüsteem, kus reovesi ja sademevesi voolavad eraldi torustikes; 13",
          "@language": "et"
        },
        {
          "@value": "rajatised reovee ja sademevee, drenaaživee ning muu pinnase- ja pinnavee eraldi kanaliseerimiseks; 11",
          "@language": "et"
        },
        {
          "@value": "eraldiseisvad ja omavaheliste ühendusteta ehitised ja seadmed reovee ning sademevee eraldiseisvaks kanaliseerimiseks.",
          "@language": "et"
        },
        {
          "@value": "kanalisatsioon, milles reovesi ja sademevesi koos drenaaživeega juhitakse ära eraldi torustikes.",
          "@language": "et"
        },
        {
          "@value": "kanalisatsioonisüsteem, kus reovesi ja sademevesi voolavad eraldi torustikes",
          "@language": "et"
        }
      ],
