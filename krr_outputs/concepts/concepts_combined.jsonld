      ],
      "skos:prefLabel": {
        "@value": "mõõdetud energiakasutuse andmetel põhinev energiamärgis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis; piirkond – Põhja-Eesti, Lääne-Eesti, Kesk-Eesti, Kirde-Eesti või Lõuna-Eesti, vastavalt Eurostati territoriaalse statistika arvepidamisele (NUTS 3)",
        "@language": "et"
      },
      "estleg:definedIn": [
