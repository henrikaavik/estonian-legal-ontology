    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1045949_kohtkaitlussusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kohtkäitlussüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (sh kuivkäimla), puhastamiseks (sh septik) või maapinda immutamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
