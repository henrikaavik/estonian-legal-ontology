      "estleg:definesConcept": {
        "@id": "estleg:Concept_vee_ettevotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_hiiumaa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_t1046659_volitatud_isik",
      "@type": [
        "owl:NamedIndividual",
