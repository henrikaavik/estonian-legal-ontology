      "skos:definition": [
        {
          "@value": "isiku või perekonna toimetulekut soodustav mitterahaline hüvitis",
          "@language": "et"
        },
        {
          "@value": "isiku või perekonna toimetulekut soodustav mitterahaline toetus",
          "@language": "et"
        },
        {
          "@value": "mitterahaline hüvitis ehk isikule antav soodustus, mis ei seisne rahasumma maksmises, vaid on eelkõige isikule osutatav teenus või teenuse osutamise korraldamine, sealhulgas isikult talle kolmanda isiku poolt osutatud teenuse eest tasu maksmise kohustuse täielik või osaline ülevõtmine",
          "@language": "et"
        },
        {
          "@value": "toimetuleku soodustamiseks antav mitterahaline hüvitis",
          "@language": "et"
        },
        {
          "@value": "toimetulekut soodustav mitterahaline hüvitis",
          "@language": "et"
        }
