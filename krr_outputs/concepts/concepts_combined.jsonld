      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "praktika korraldaja",
      "skos:definition": [
        {
          "@value": "Euroopa Majanduspiirkonna lepinguriigi antud tegevusloaga audiitorettevõtja, kes tegeleb vandeaudiitori kutsetegevusalaste ülesannete täitmisega, äriühing või avaliku sektori üksus, kus tegeletakse siseaudiitori kutsetegevusalaste ülesannete täitmisega, või tunnustatud siseaudiitor, kes tegeleb siseaudiitori kutsetegevusalaste ülesannete täitmisega.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_praktikajuhendaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "praktikajuhendaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_ettevotja_praktikajuhendaja_toetuse_andmise_kord_t1048059_praktikajuhendaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "praktikajuhendaja",
      "skos:definition": [
        {
          "@value": "õppepraktika toimumise ajal praktikanti juhendav spetsialist, kellel on vähemalt kolmeaastane erialane töökogemus või vastav kvalifikatsioon ning kellel on taotlejaga sõlmitud täistööajaga tööleping",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
