        }
      ]
    },
    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_filtervaljak_ehk_filtersusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "filterväljak ehk filtersüsteem",
      "skos:definition": "septikule või biopuhastile järgnev heitvee puhastussüsteem, mis rajatakse juhul, kui imbsüsteemi paigalduskoha pinnas ei ima või ei lase vett läbi. Killustikukihi alla ehitatakse liivast filtreerimiskiht ja selle alla paigaldatakse drenaažitorud, mis juhivad läbi liivakihi valgunud ja puhastatud vee kogumiskaevu ja sealt suublasse. Filtersüsteem isoleeritakse ümbritsevast pinnasest geomembraaniga; 13",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
