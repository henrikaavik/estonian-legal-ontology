    {
      "@id": "estleg:Concept_nouded_suplusveele_ja_supelrannale_t1047813_reostus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reostus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "suplusvee mikrobioloogilise saaste või muude suplusvee kvaliteeti mõjutavate organismide, ainete või jäätmete esinemine, sealhulgas § 4 lõikes 3 ja § 8 lõigetes 4–6 ning lisa 1 punkti 6 veerus A nimetatud mikroorganismid, mis ohustavad suplejate tervist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047813_Par_2"
        }
      ],
      "estleg:sourceAct": "Nõuded suplusveele ja supelrannale",
      "rdfs:label": "reostus (nouded_suplusveele_ja_supelrannale_t1047813)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reostus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_nouded_suplusveele_ja_supelrannale_t1047813_luhiajaline_reostus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lühiajaline reostus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lisa 1 punkti 6 veerus A nimetatud mikroorganismide põhjustatud mikrobioloogiline saaste, millel on selgelt määratavad põhjused ning mis ei mõjuta tavaliselt suplusvee kvaliteeti kauem kui ligikaudu 72 tundi ja mida hindab Terviseamet lisas 2 sätestatud hindamismeetodi kohaselt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047813_Par_2"
        }
      ],
