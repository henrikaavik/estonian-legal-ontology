    {
      "@id": "estleg:Concept_luganuse_valla_huvihariduse_ja_tegevuse_toetamise_kord_t1043095_Oppekoha_maksumus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Õppekoha maksumus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "huvikooli õpilaskoha tegevuskulu arvestuslik maksumus, ühe õppuri huvihariduse omandamine ühe õppekava ulatuses.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043095_Par_2"
        }
      ],
