        "@language": "et"
      },
      "skos:definition": {
        "@value": "fikseeritud ja igakuiselt palgalisele vallavalitsuse liikmele makstav tasu, mis moodustab 20% tema põhipalgast, millest palgaline vallavalitsuse liige tasub enda mobiiltelefoniga seotud kulud ning isikliku sõiduauto kasutamise kulud",
        "@language": "et"
      },
      "estleg:definedIn": [
