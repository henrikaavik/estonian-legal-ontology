      ],
      "skos:prefLabel": {
        "@value": "suletav ala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tee, teelõik, parkla või väljak, mille täielikku või osalist sulgemist sulgemisloa taotleja taotleb ja mis suletakse sulgemisloa alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
