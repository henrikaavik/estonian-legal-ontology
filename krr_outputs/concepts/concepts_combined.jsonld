      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_metsatee"
        }
      ]
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_teehoiu_eeskiri_t1061479_Teemaa",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Teemaa",
      "skos:definition": "maa, mis on õigusaktidega määratud liiklemiseks, tee koosseisus olevate rajatiste paigutamiseks ja teehoiu korraldamiseks. Tee maakasutuse sihtotstarve on transpordimaa v a kui eramaa omanikuga on teekasutamine kokkulepitud teisiti. 6 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061479_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla teehoiu eeskiri",
