        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "saatekiri",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_bioloogilise_vedeliku_proovi_votmise_sailitamise_uuringuks_e_t1024832_saatekiri"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "saatekiri",
      "skos:definition": [
        {
          "@value": "määruse lisas esitatud vormi kohaselt koostatud dokument, kuhu märgitakse andmed vere- või uriiniproovi võtmise ja selle analüüsimiseks edastamise ning riiklikus ekspertiisiasutuses tehtud analüüsi tulemuste kohta, samuti hinnang isikul narkootilise või psühhotroopse aine tarvitamisest põhjustatud joobeseisundi olemasolu või puudumise kohta",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saavutustoetus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "saavutustoetus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kultuuri_valdkonnas_tegutsevatele_mittetulundusuhingutele_te_t1048864_saavutustoetus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "saavutustoetus",
      "skos:definition": [
        {
          "@value": "toetus, mida Pärnu linn annab kultuuriühingule, mis on aktiivselt osalenud oma valdkonna suurüritustel ja ise üritusi korraldanud ja/või mille koosseisus tegutsev kollektiiv on saavutanud silmapaistvaid tulemusi üleriigilistel või rahvusvahelistel konkurssidel, võistlustel ja festivalidel",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
