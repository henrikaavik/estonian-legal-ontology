        "@value": "Vältimatu abi",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sotsiaaltoetuste_maaramise_ja_maksmise_kord_t1041861_Valtimatu_abi"
        },
        {
          "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_osutamise_tingimused_ja_kord_t1058311_valtimatu_abi"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Vältimatu abi",
      "skos:altLabel": [
        {
          "@value": "vältimatu abi",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "elatusvahenditeta isiku olukorrale vastavad hädavajalikud hoolekandelised abinõud, mis tagavad vähemalt toidu, riietuse ja ajutise peavarju",
          "@language": "et"
        },
        {
          "@value": "on elatusvahenditeta isiku olukorrale vastavad hädavajalikud hoolekandelised abinõud, mis tagavad vähemalt toidu, riietuse ja ajutise peavarju.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valtimatu_sotsiaalabi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vältimatu sotsiaalabi",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_andmise_kord_t1052751_valtimatu_sotsiaalabi"
        },
