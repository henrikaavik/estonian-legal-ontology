        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_mets",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "mets",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ökosüsteem, mis koosneb metsamaast, sellel kasvavast taimestikust ja seal elunevast loomastikust. Metsamaa on maa, mis on kõlvikuna kantud maakatastrisse või maatükk pindalaga vähemalt 0,1 hektarit, millel kasvavad puittaimed kõrgusega vähemalt 1,3 meetrit puuvõrade liitusega vähemalt 30 protsenti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
      "rdfs:label": "mets (peipsiaare_valla_heakorra_eeskiri_t1044621)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_mets"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_mootorsoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "mootorsõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "mootori jõul liikuv sõiduk, välja arvatud üksnes piiratud liikumisvõimega isikule kasutamiseks ettenähtud mootoriga sõiduk, elektrimootoriga jalgratas, tasakaaluliikur, pisimopeed, robotliikur, maastikusõiduk, tramm ja sõiduk, mille valmistajakiirus ei ületa kuut kilomeetrit tunnis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
      "rdfs:label": "mootorsõiduk (peipsiaare_valla_heakorra_eeskiri_t1044621)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_mootorsoiduk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_numbrisilt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "numbrisilt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "silt, millel on ametlik aadressinumber",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
