      "skos:definition": {
        "@value": "Viimsi Vallavalitsuse (edaspidi vallavalitsus ) ehitus- ja kommunaalosakonna (edaspidi ehitus- ja kommunaalisakond ) antud luba tee, teelõik, parkla või väljak täielikult või osaliselt ajutiselt sulgeda",
        "@language": "et"
      },
