        }
      ]
    },
    {
      "@id": "estleg:Concept_otepaa_valla_kaevetoode_eeskiri_t1023645_Vastutav_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Vastutav isik",
      "skos:definition": "kaevaja poolt kirjalikult määratud isik, kes vastutab kaevetöö eest. Kui vastutavat isikut ei ole määratud, loetakse vastutavaks isikuks kaevaja tegevjuht või juhatuse esimees. Kui kaevaja on füüsiline isik, siis on ta ise vastutavaks isikuks. 4 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1023645_Par_2"
        }
      ],
      "estleg:sourceAct": "Otepää valla kaevetööde eeskiri",
