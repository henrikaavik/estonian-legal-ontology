        }
      ]
    },
    {
      "@id": "estleg:Concept_vaike_maarja_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055415_Konsolideerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Konsolideerimine",
      "skos:definition": "raamatupidamisüksuste aruannete ühendamine nii, nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega kaasneb elimineerimine, milline tehing on konsolideerimisgruppi kuuluvate isikute omavaheliste vastandtehingute (tulud-kulud, nõuded-kohustised) liitmine nii, et grupi aruandes neid ei esine. 7 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055415_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "Konsolideerimine (vaike_maarja_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055415)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_konsolideerimine"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_konsolideerimine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_vaike_maarja_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055415_Majandusinformatsiooni_liigendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Majandusinformatsiooni liigendamine",
      "skos:definition": "valla majandustehingute kirjendamine, kasutades riigi või valla õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid valla juhtimisotsuste tegemiseks ning riigi aruandluse jaoks. 8 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055415_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "Majandusinformatsiooni liigendamine (vaike_maarja_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055415)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_majandusinformatsiooni_liigendamine"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_majandusinformatsiooni_liigendamine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_vaike_maarja_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055415_Tehingupartnerid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Tehingupartnerid",
      "skos:definition": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tunnused – tehingupartneri koodid, eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud finantsaruandeid. 9 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055415_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "Tehingupartnerid (vaike_maarja_vallavalitsuse_raamatupidamise_sise_eeskiri_t1055415)",
