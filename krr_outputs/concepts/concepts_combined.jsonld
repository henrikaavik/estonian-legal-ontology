    },
    {
      "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Sisekontrolor",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Sisekontrolör",
      "skos:definition": "käesoleva eeskirja tähenduses isik või teenuse osutaja, kes täidab vallas sisekontrolli ülesandeid (edaspidi sisekontrolör). 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052595_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla sisekontrolli rakendamise kord",
