    {
      "@id": "estleg:Concept_sotsiaalteenuste_osutamise_tingimused_ja_kord_t1052761_kohandatud_eluruum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kohandatud eluruum",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eluruum, mis on kohandatud inimese puudest tingitud vajadustele vastavaks nii, et inimene tuleks võimalikult iseseisvalt koduses keskkonnas toime; abi korraldaja – inimese rahvastikuregistrisse kantud elukoha järgne linnaosa valitsus või õigusaktis sätestatud juhtudel amet; 2025-04-03",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052761_Par_2"
        }
      ],
      "estleg:sourceAct": "Sotsiaalteenuste osutamise tingimused ja kord",
