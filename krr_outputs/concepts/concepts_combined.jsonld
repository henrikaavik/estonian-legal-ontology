    {
      "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_e_t1058914_Tarbimiskoha_veevark_ja_kanalisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Tarbimiskoha veevärk ja kanalisatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on ehitiste ja seadmete süsteem tarbija veega varustamiseks ühisveevärgist või reo- või sademevee ärajuhtimiseks ühiskanalisatsiooni. Tarbimiskoha veevärk ja kanalisatsioon ei ole ühisveevärgi ja -kanalisatsiooni osa. Tarbimiskoha veevärgil või kanalisatsioonil asuv veemõõdusõlm, välja arvatud veearvesti, on tarbimiskoha veevärgi või kanalisatsiooni osa.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058914_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
      "rdfs:label": "Tarbimiskoha veevärk ja kanalisatsioon (marjamaa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_e_t1058914)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tarbimiskoha_veevark_ja_kanalisatsioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_e_t1058914_Tarbija",
