      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_maastikuarhitektuurne_projekt"
        }
      ]
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_soojussolm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "soojussõlm",
      "skos:definition": "hoone või hoonerühma seadmestik, mille abil soojusenergia tarbijad on ühenduses soojusvõrguga. Soojussõlmes muudetakse kaugküttevõrgu soojuskandja temperatuur ja rõhk hoone sooja tarbevee, kütte- ja ventilatsioonisüsteemile sobivaks; 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "soojussõlm (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_soojussolm"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_soojussolm"
        }
      ]
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_tarbijapaigaldis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "tarbijapaigaldis",
      "skos:definition": "kinnistul, ehitises või ühtse majandusüksuse moodustavas funktsionaalselt seotud ehitiste kompleksis ja nende teenindamiseks vajalikul maal ehitatud omavahel ühendatud soojatorustike ja abiseadmete võrguga ühendatud või ühendatav talituslik kogum tarbija varustamiseks soojusega; 10",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "tarbijapaigaldis (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tarbijapaigaldis"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_tarbijapaigaldis"
        }
      ]
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_toovotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "töövõtja",
      "skos:definition": "äriregistrisse kantud majandustegevuses tegutsev isik, kes on esitanud äriregistrile vähemalt ühe majandusaasta aruande, mille põhjal on ettevõtja tegevusala olnud asjaomase teenuse osutamine. Kui töövõtja teeb õigusaktide mõistes eritöid, siis peab ta olema registreeritud majandustegevuse registris või peab tal olema vastavas valdkonnas tegutsemiseks tegevusluba; 11",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "töövõtja (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_toovotja"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_toovotja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_valmis_too",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "valmis töö",
      "skos:definition": "töö on valmis, kui see on tehtud nõuetekohaselt ja nõuetekohase töövõtja poolt ning taotleja on töö vastu võtnud ja töö eest tasunud (nt projekteerimine, ekspertiisi koostamine, omanikujärelevalve teenus, maastikuarhitektuurse projekti koostamine, puude ja põõsaste hoolduslõikus, turvakaamera paigaldamine); 13",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "valmis töö (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valmis_too"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_valmis_too"
        }
      ]
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_vork",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "võrk",
      "skos:definition": "torustike, seadmete, abiseadmete ja nendega seotud ehitiste kohtkindlalt ehitatud talitluslik kogum või selle osa, mis on vajalik soojuse jaotamiseks. Võrguks ei loeta kaugkütteseaduses nimetatud tarbijapaigaldisi.",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
