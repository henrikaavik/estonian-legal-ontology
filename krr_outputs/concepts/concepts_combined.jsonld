      "rdfs:label": "kogukond",
      "skos:definition": [
        {
          "@value": "mingis piirkonnas elav ja ühist toimekeskkonda jagav ning teatud sotsiaalsete suhete võrgustikuga seotud inimeste rühm",
          "@language": "et"
        },
        {
          "@value": "teatud sotsiaalse suhtevõrgustikuga seotud inimeste rühm paikkonnas või asumis",
          "@language": "et"
        },
        {
          "@value": "territoriaalselt määratletud inimeste kooslus",
          "@language": "et"
        }
      ],
