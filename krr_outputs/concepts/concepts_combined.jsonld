    {
      "@id": "estleg:Concept_tallinna_avalike_teenuste_andmekogu_pohimaarus_t1050882_arve",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "arve",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsilise või juriidilise isiku ja Tallinna linna vahel sõlmitud lepingu alusel teenuse kasutajale edastatav arve või Tallinna linna asutuse nõue teenuse kasutajale, näiteks trahvi või maksu tasumise nõue",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
