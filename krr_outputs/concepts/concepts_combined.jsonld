    {
      "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_analuutiline_ja_sunteetiline_arvestus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "analüütiline ja sünteetiline arvestus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandusinformatsiooni liigendamise erinevad detailsuse tasemed. Sünteetiline arvestus on majandusinformatsiooni kirjendamine raamatupidamiskontodele. Analüütiline arvestus on raamatupidamiskontodele kirjendatud majandusinformatsiooni detailiseerimine (nõuded ja kohustused – kelle vastu jms). Analüütilist arvestust peetakse kas majandustarkavara pearaamatust eristatud moodulites (registrites) või teiste tarkvaravahenditega või käsitsi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044080_Par_2"
        }
      ],
      "estleg:sourceAct": "Türi valla raamatupidamise sise-eeskiri",
      "rdfs:label": "analüütiline ja sünteetiline arvestus (turi_valla_raamatupidamise_sise_eeskiri_t1044080)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_analuutiline_ja_sunteetiline_arvestus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_aktsepteerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "aktsepteerimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandustehingu toimumise ja õiguspärasuse kinnitamine allkirjaga ning eelarve tunnuse või nimetuse määramine valla eelarveklassifikaatorite liigenduses. Toiming kuulub kuludokumendi kontrollija või vastutava isiku (eelarve vastutav täitja, projekti vastutav täitja või muu aktseptiõiguslik isik) kompetentsi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044080_Par_2"
        }
      ],
      "estleg:sourceAct": "Türi valla raamatupidamise sise-eeskiri",
      "rdfs:label": "aktsepteerimine (turi_valla_raamatupidamise_sise_eeskiri_t1044080)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_aktsepteerimine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_aruandeperiood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "aruandeperiood",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "periood, mille jooksul toimunud majandustehingute kirjendid võetakse arvesse aruannete koostamisel. Lühim aruandeperiood on kalendrikuu. Majandusaasta aruandeperiood on kalendriaasta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044080_Par_2"
        }
      ],
      "estleg:sourceAct": "Türi valla raamatupidamise sise-eeskiri",
      "rdfs:label": "aruandeperiood (turi_valla_raamatupidamise_sise_eeskiri_t1044080)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_aruandeperiood"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_eelarve_vastutav_taitja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eelarve vastutav täitja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratud isik või isikud, kellele on antud õigus kasutada vallaeelarve raha kinnitatud eelarve piires ja struktuuris. Vastavat õigust teostab vastutav isik kulu aktsepteerimisega valla eelarveklassifikaatorite liigenduses",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044080_Par_2"
        }
      ],
      "estleg:sourceAct": "Türi valla raamatupidamise sise-eeskiri",
      "rdfs:label": "eelarve vastutav täitja (turi_valla_raamatupidamise_sise_eeskiri_t1044080)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eelarve_vastutav_taitja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_hea_raamatupidamistava",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hea raamatupidamistava",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev raamatupidamistava, mille põhinõuded kehtestatakse RPS-s, mida täiendavad RTJ-d, FA juhend ja eeskiri",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044080_Par_2"
        }
      ],
      "estleg:sourceAct": "Türi valla raamatupidamise sise-eeskiri",
      "rdfs:label": "hea raamatupidamistava (turi_valla_raamatupidamise_sise_eeskiri_t1044080)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_hea_raamatupidamistava"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_majandustehingute_kirjendaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "majandustehingute kirjendaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötaja, kes lähtudes heast raamatupidamistavast, kirjendab valla majandustehingud raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on majandustehingute kirjendajaks raamatupidaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044080_Par_2"
