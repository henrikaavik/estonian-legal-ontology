      },
      "rdfs:label": "tulemustasu",
      "skos:altLabel": [
        {
          "@value": "Tulemustasu",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ametiasutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu; 12",
          "@language": "et"
        },
        {
          "@value": "tasu, mida makstakse tulemusliku töö eest hallatava asutuse eesmärkide saavutamisel. RT IV 2025-04-12 5 412042025005 2025-04-15 6 (",
          "@language": "et"
        },
        {
          "@value": "tulemuspalk vms töötulemuste hindamise alusel makstav täiendav tasu; 2014-06-18 RT IV 2014-06-28 14 428062014014 2014-07-01 36 36<sup>1</sup>) preemia – tasu erakordsete tööalaste saavutuste eest; 2022-09-21 RT IV 2022-09-28 6 428092022006 2022-10-01 37",
          "@language": "et"
        },
        {
          "@value": "töötajatele makstav tasu seatud eesmärkide või tööalaste tulemuste või projektipõhiste ülesannete täitmise eest. Tulemustasu maksmise tingimused ja korra kehtestab asutuse juht, arvestades tööfondi võimalusi; RT IV 2026-03-25 16 425032026016 2026-03-28 , rakendatakse alates 1. märtsist 2026 5",
          "@language": "et"
        },
        {
          "@value": "vallavanema või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu; 8",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tulemuur",
      "@type": [
        "owl:NamedIndividual",
