          "@id": "estleg:Concept_kadrina_valla_opilastele_tasuta_soidukaartide_valjastamise_k_t1031769_Kadrina_valla_opilane"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Kadrina valla õpilane",
      "skos:definition": [
        {
          "@value": "üldhariduskooli päevases õppevormis põhi- ja keskharidust omandav õpilane, kelle elukoht Eesti rahvastikuregistris on registreeritud Kadrina vald ja kes õpib teise omavalitsuse haldusterritooriumil asuvas koolis; 3",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kadu_seadmetes",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kadu seadmetes",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
