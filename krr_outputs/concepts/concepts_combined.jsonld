      ],
      "skos:prefLabel": {
        "@value": "eelarve täitmine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sissetulekute kogumine, väljaminekute tegemine ning tehingud varade ja kohustustega, samuti nende kohta arvestuse pidamine; 5) Põlva Vallavalitsus (edaspidi valitsus ) – Põlva valla kui omavalitsusüksuse täitevorgan, mis moodustatakse volikogu poolt. Käesolevas korras täpsustamata mõisteid kasutatakse kohaliku omavalitsuse üksuse finantsjuhtimise seaduse ja raamatupidamise seaduse tähenduses.",
        "@language": "et"
      },
      "estleg:definedIn": [
