      "rdfs:label": "sisekoolitus",
      "skos:definition": [
        {
          "@value": "asutuse teenistuja läbiviidav koolitus.",
          "@language": "et"
        },
        {
          "@value": "tööalane täienduskoolitus, mille läbiviijaks on ametiasutuse enda teenistuja ja koolitamine või juhendamine ei tulene tema teenistuskoha eesmärgist ega ametijuhendist; 6",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse teenistuja läbiviidav koolitus; 6",
          "@language": "et"
        },
        {
          "@value": "asutuse teenistuja poolt läbiviidav koolitus asutuse või selle valitsemisala teenistujatele; 5",
          "@language": "et"
        },
        {
          "@value": "linnavalitsuse teenistujatele tellitud koolitus või linnavalitsuse teenistuja poolt läbiviidav koolitus; 4",
          "@language": "et"
        }
      ],
