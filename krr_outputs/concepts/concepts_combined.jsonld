        "@id": "estleg:Concept_pohipalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_antsla_vallavalitsuse_palgajuhend_t1040957_muutuvpalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muutuvpalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040957_Par_2"
        }
      ],
