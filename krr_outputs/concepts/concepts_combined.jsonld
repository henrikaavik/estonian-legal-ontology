      ],
      "skos:prefLabel": {
        "@value": "likviidsed varad",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "raha ja pangakontodel olevad vahendid, rahaturu- ja intressifondide aktsiad ja osakud ning soetatud võlakirjad",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044235_Par_2"
        }
      ],
