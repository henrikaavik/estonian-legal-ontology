      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_jaatmevedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevedaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenuste kontsessiooni või teenuste riigihanke korras valitud isik, kes osutab jäätmevaldajatele korraldatud jäätmeveo teenust kindlaksmääratud jäätmeliikide osas ja jäätmeveopiirkonnas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054824_Par_3"
        }
      ],
      "estleg:sourceAct": "Viimsi valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevedaja (viimsi_valla_jaatmehoolduseeskiri_t1054824)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevedaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_jaatmevaldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevaldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel aga selle kinnisasja omanik, millel asub suvila, elu- või äriruum",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054824_Par_3"
        }
      ],
      "estleg:sourceAct": "Viimsi valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmevaldaja (viimsi_valla_jaatmehoolduseeskiri_t1054824)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmevaldaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_jaatmekaitleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmekäitleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidiline või füüsiline isik, kes kogub, veab, taaskasutab või kõrvaldab jäätmeid majandus- või kutsetegevusena ja kellel on selleks tegevuseks vastav keskkonnakaitseluba",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054824_Par_3"
        }
      ],
      "estleg:sourceAct": "Viimsi valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmekäitleja (viimsi_valla_jaatmehoolduseeskiri_t1054824)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmekaitleja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_jaatmejaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmejaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "spetsiaalselt rajatud, tehniliselt varustatud jäätmekäitluskoht, kuhu on paigutatud taaskasutatavate jäätmete kogumiseks ja taaskasutustoiminguks kogumismahutid, sh ohtlike jäätmete kogumismahutid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054824_Par_3"
        }
      ],
      "estleg:sourceAct": "Viimsi valla jäätmehoolduseeskiri",
      "rdfs:label": "jäätmejaam (viimsi_valla_jaatmehoolduseeskiri_t1054824)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_jaatmejaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_jaatmehoolduseeskiri_t1054824_hankija",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hankija",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallavalitsuse või vallavolikogu volitatud juriidiline isik, kes vastab jäätmeseaduse nõuetele; 9) jäätmeveopiirkond (edaspidi piirkond) – eeskirjaga kindlaksmääratud ala, kust kohaliku omavalitsuse üksuse korraldatud jäätmeveoga hõlmatud jäätmed kokku kogutakse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054824_Par_3"
        }
      ],
      "estleg:sourceAct": "Viimsi valla jäätmehoolduseeskiri",
