    {
      "@id": "estleg:Concept_alutaguse_valla_heakorraeeskiri_t1049887_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omanik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle omandis on maa või ehitised või kelle kasuks on seatud hoonestusõigus; heakorra nõuete täitmisel on omanikuga võrdsustatud tema poolt volitatud valdaja, haldaja või kasutaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049887_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla heakorraeeskiri",
      "rdfs:label": "omanik (alutaguse_valla_heakorraeeskiri_t1049887)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_alutaguse_valla_heakorraeeskiri_t1049887_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maatükk), hoonestusõigus, kasutusvaldus, korteriomand, korterihoonestusõigus, muud võimalikud seadusjärgsed kasutused, samuti katastriüksus ja reformimata riigimaa; heakorra nõuete täitmisel on võrdsustatud mõisteteks maa-ala, territoorium, krunt, maaüksus, katastriüksus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049887_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla heakorraeeskiri",
      "rdfs:label": "kinnistu (alutaguse_valla_heakorraeeskiri_t1049887)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_alutaguse_valla_heakorraeeskiri_t1049887_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringile üldiseks liikumiseks ja kasutamiseks antud igasugune territoorium, hoone, rajatis või ruum (näiteks teed, tänavad, hoovid, haljasalad, pargid, terviserajad, parklad, kalmistud, ametiasutused, haridus-, tervishoiu- ja kultuuriasutused, toitlustusettevõtted, kauplused, spordihooned, ühissõidukid jmt)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049887_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla heakorraeeskiri",
      "rdfs:label": "avalik koht (alutaguse_valla_heakorraeeskiri_t1049887)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalik_koht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_alutaguse_valla_heakorraeeskiri_t1049887_heakorratood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heakorratööd",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistu heakorraga seotud tööd, sealhulgas tolmu, liiva, prahi ja lume koristamine ning libedustõrje teostamine, muru ja rohu niitmine, puude ja põõsaste okste kärpimine ja raie ning maha langenud puulehtede vms koristamine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049887_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla heakorraeeskiri",
      "rdfs:label": "heakorratööd (alutaguse_valla_heakorraeeskiri_t1049887)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_heakorratoo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_alutaguse_valla_heakorraeeskiri_t1049887_haljasala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "haljasala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teadlikult kujundatud maastik, maastikuosa või hoonetevaheline välisruum, samuti avamaataimkattega ala asulates, mida iseloomustab ümberkujundatud reljeef ja taimestik ning vastavafunktsioonilised rajatised",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049887_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla heakorraeeskiri",
      "rdfs:label": "haljasala (alutaguse_valla_heakorraeeskiri_t1049887)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_haljasala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_alutaguse_valla_heakorraeeskiri_t1049887_romusoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "romusõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduk, mis ei saa tehnilise seisukorra tõttu osaleda liikluses või millel puuduvad selle mehhaanilised osad või kereosad või klaasid või rattad ja mis oma välimusega riivab avaliku koha või kinnistu esteetilist väljanägemist ja rikub visuaalselt heakorda",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049887_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla heakorraeeskiri",
      "rdfs:label": "romusõiduk (alutaguse_valla_heakorraeeskiri_t1049887)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_romusoiduk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_alutaguse_valla_heakorraeeskiri_t1049887_kompaktse_asustusega_ala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kompaktse asustusega ala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olemasolev või üldplaneeringuga kavandatud selgelt piiritletav kompaktse asustusega territooriumi osa",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049887_Par_2"
        }
      ],
      "estleg:sourceAct": "Alutaguse valla heakorraeeskiri",
