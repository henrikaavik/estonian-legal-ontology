        "@id": "estleg:Concept_kohandatav_eluruum"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_puudega_isikule_eluruumi_kohandamise_toetuse_maaramise_ja_ma_t1046923_fuusiline_kohandamine",
