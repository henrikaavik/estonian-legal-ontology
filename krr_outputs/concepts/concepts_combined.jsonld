      "skos:definition": [
        {
          "@value": "tegevus projekti või teetööde kirjeldusele vastavate ehitus- ja remonditööde nõuetekohase kvaliteedi tagamiseks, samuti tehniliste dokumentide vormistamise tagamiseks ja kontrollimiseks; 10",
          "@language": "et"
        },
        {
          "@value": "tegevus projekti või teetööde kirjeldusele vastavate ehitus- ja remonditööde nõuetekohase kvaliteedi tagamiseks, samuti tehniliste dokumentide vormistamise tagamiseks ja kontrollimiseks; 8 (",
          "@language": "et"
        },
        {
          "@value": "tegevus projekti või teetööde kirjeldusele vastavate ehitus- ja remonditööde nõuetekohase kvaliteedi tagamiseks, samuti tehniliste dokumentide vormistamise tagamiseks ja kontrollimiseks; 9",
