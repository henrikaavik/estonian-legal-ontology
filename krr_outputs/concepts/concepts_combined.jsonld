        "@id": "estleg:Concept_reoveepuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooni_kasutamis_t1058898_Reovesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reovesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on olmes, tööstuses või muus tootmises tekkinud vesi, mis ületab kehtestatud heite piirväärtusi ja mida tuleb enne suublasse juhtimist puhastada. Reoveeks peetakse ka ühisvoolsesse kanalisatsiooni juhitud sademevett",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058898_Par_2"
        }
      ],
