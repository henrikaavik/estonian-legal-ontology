    {
      "@id": "estleg:Concept_terviseharitus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "terviseharitus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tervishoiuteenuste_kvaliteedi_ja_patsiendiohutuse_tagamise_n_t1059772_terviseharitus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "terviseharitus",
      "skos:definition": [
        {
          "@value": "hõlmab inimeste teadmisi, motivatsiooni ja oskusi leida tervisealast teavet ning seda mõista, hinnata ja kasutada tervise edendamise ja hoidmisega, haiguste ennetamisega ja tervishoiuteenuste kasutamisega seotud otsuste tegemisel eesmärgiga säilitada või parandada elukvaliteeti eluaja jooksul",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_terviseseisundi_kirjeldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "terviseseisundi kirjeldus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_puude_raskusastme_tuvastamise_tingimused_ja_kord_ning_puudeg_t1033407_terviseseisundi_kirjeldus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "terviseseisundi kirjeldus",
      "skos:definition": [
        {
          "@value": "puuetega inimeste sotsiaaltoetuste seaduse § 2 3 lõike 5 alusel kehtestatud andmekoosseis",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tervisest_tulenev_takistus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervisest tulenev takistus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toohoiveprogramm_2024_2029_t1057476_tervisest_tulenev_takistus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tervisest tulenev takistus",
      "skos:definition": [
        {
          "@value": "seisund, millest tulenevalt on inimesele määratud puue puuetega inimeste sotsiaaltoetuste seaduse tähenduses või ta on tunnistatud püsivalt töövõimetuks riikliku pensionikindlustuse seaduse alusel, sealhulgas juhul, kui talle riiklike elatusrahade seaduse alusel määratud invaliidsusgrupp on loetud vastavaks püsivale töövõimetusele või tal on tuvastatud osaline või puuduv töövõime töövõimetoetuse seaduse alusel",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tervishoiu_ja_veterinaarteenuse_osutamisel_tekkinud_jaatmed",
