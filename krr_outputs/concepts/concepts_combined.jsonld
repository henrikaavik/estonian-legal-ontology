      "skos:definition": [
        {
          "@value": "1970. aasta 19. juunil Washingtonis sõlmitud „Patendikoostöölepingu” (edaspidi PCT ) (RT II 1994, 6/7,",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_rahvusvaheline_projekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
