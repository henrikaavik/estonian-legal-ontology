      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "filterväljak ehk filtersüsteem",
      "skos:definition": [
        {
          "@value": "septikule või biopuhastile järgnev heitvee puhastussüsteem, mis rajatakse juhul, kui imbsüsteemi paigalduskoha pinnas ei ima või ei lase vett läbi. 13",
          "@language": "et"
        },
        {
          "@value": "septikule või biopuhastile järgnev heitvee puhastussüsteem, mis rajatakse juhul, kui imbsüsteemi paigalduskoha pinnas ei ima või ei lase vett läbi. Killustikukihi alla ehitatakse liivast filtreerimiskiht ja selle alla paigaldatakse drenaažitorud, mis juhivad läbi liivakihi valgunud ja puhastatud vee kogumiskaevu ja sealt suublasse. Filtersüsteem isoleeritakse ümbritsevast pinnasest geomembraaniga; 13",
          "@language": "et"
        },
        {
          "@value": "septikule või biopuhastile järgnev heitvee puhastussüsteem, mis rajatakse juhul, kui imbsüsteemi paigalduskoha pinnas ei ima või ei lase vett läbi. Killustikukihi alla ehitatakse liivast filtreerimiskiht ja selle alla paigaldatakse drenaažitorud, mis juhivad läbi liivakihi valgunud ja puhastatud vee kogumiskaevu ja sealt suublasse. Filtersüsteem isoleeritakse ümbritsevast pinnasest geomembraaniga; 9",
          "@language": "et"
        }
      ]
    },
