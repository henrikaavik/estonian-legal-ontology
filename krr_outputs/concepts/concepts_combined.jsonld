      },
      "rdfs:label": "biolagunevad köögi",
      "skos:definition": [
        {
          "@value": "ja sööklajäätmed on kodumajapidamistes, büroos, jaemüügikohtades, hulgimüügiettevõtetes ja toitlustusasutustes tekkinud toidu- ja köögijäätmed; 6",
          "@language": "et"
        },
        {
          "@value": "ja sööklajäätmed on kodumajapidamises, jaemüügikohas ja toitlustusasutuses tekkinud toidu- ja köögijäätmed nagu puu- ja köögiviljade puhastamise jäägid, liha- ja kalajäägid, poolfabrikaadid, kohvi- ja teepuru sh filtrid, pagaritooted jmt; 3",
          "@language": "et"
        },
        {
          "@value": "ja sööklajäätmed on kodumajapidamistes, büroos, jaemüügikohtades, hulgimüügiettevõtetes ja toitlustusasutustes tekkinud toidu- ja köögijäätmed; 8",
          "@language": "et"
        },
        {
          "@value": "ja sööklajäätmed on kodumajapidamises, büroos, jaemüügikohas, hulgimüügiettevõttes ja toitlustusasutuses tekkinud toidu- ja köögijäätmed; 3",
          "@language": "et"
        },
        {
          "@value": "ja sööklajäätmed on kodumajapidamistes, büroos, jaemüügikohtades, hulgimüügiettevõtetes ja toitlustusasutustes tekkinud toidu- ja köögijäätmed; 7",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
