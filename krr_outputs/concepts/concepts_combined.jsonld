      },
      "rdfs:label": "hoolduse seadmine",
      "skos:definition": [
        {
          "@value": "abivajavale isikule tema taotluse alusel kõrvalabi osutamise korraldamine tuvastades tema abivajaduse sisu, määrates hooldaja ja tema ülesanded",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_hoolduskava",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoolduskava",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_koduteenuse_osutamise_tingimused_ja_kord_t1050439_hoolduskava"
        },
        {
          "@id": "estleg:Concept_koduteenuse_osutamise_kord_t1043350_hoolduskava"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hoolduskava",
      "skos:definition": [
        {
          "@value": "on teenuse vajaduse hindamise juures kohustuslik lisadokument, milles kajastatakse osutatavate teenuste loetelu, maht, teenuse osutamise aeg ja koht ning millele kirjutavad alla teenust vajav isik või tema seadusjärgne ülalpidaja.",
          "@language": "et"
        },
        {
          "@value": "teenusevajaduse hindamisel koostatav dokument, mis sisaldab kirjeldust kõrvalabi vajava isiku seisundi kohta ja temale osutatavate teenuste loetelu, kestvuse, ulatuse ja osutamise tingimused",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_hoolduskoormusega_inimene",
