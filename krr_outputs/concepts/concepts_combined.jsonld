    {
      "@id": "estleg:Concept_harku_valla_ametiasutuste_ja_palgaliste_vallavalitsuse_liikm_t1059584_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev isik, kes teostab avalikku võimu. Ametnik nimetatakse ametikohale ja vabastatakse teenistusest avaliku teenistuse seaduse alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059584_Par_2"
        }
      ],
      "estleg:sourceAct": "Harku valla ametiasutuste ja palgaliste vallavalitsuse liikmete palgajuhend",
      "rdfs:label": "ametnik (harku_valla_ametiasutuste_ja_palgaliste_vallavalitsuse_liikm_t1059584)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_harku_valla_ametiasutuste_ja_palgaliste_vallavalitsuse_liikm_t1059584_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töökohal töölepingu alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059584_Par_2"
        }
      ],
      "estleg:sourceAct": "Harku valla ametiasutuste ja palgaliste vallavalitsuse liikmete palgajuhend",
