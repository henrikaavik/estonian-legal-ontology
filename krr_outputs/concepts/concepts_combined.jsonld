    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1043827_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "septik",
      "skos:definition": "on pealt kinnine setiti, millesse sadestunud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt; 12",
