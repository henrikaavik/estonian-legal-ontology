        {
          "@value": "ilma kindla osalejaskonnata läbiviidav kultuuritöö, mis on suunatud omaalgatuse toetamisele ning erinevate tegevuste läbiviimiseks vajalike tingimuste loomisele; 6",
          "@language": "et"
        }
      ]
    },
