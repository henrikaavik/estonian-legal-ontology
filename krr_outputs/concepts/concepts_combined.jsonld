    },
    {
      "@id": "estleg:Concept_tartu_vallavalitsuse_palgajuhend_t1041625_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "töötaja",
      "skos:definition": "isik, kes on võetud vallavalitsuse töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning tema teenistuskohta nimetatakse töökohaks; 4",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041625_Par_2"
        }
      ],
