    {
      "@id": "estleg:Concept_saue_vallavalitsuse_palgajuhend_t1040965_asendustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "asendustasu",
      "skos:definition": "puuduva teenistuja ülesannete täitmise eest makstav lisatasu, mida makstakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, juhul kui asendamine ei ole ettenähtud teenistuja ametijuhendis või asendamine toob endaga kaasa olulise töökoormuse suurenemise. RT IV 2023-03-03 10 403032023010 2023-03-06 12",
