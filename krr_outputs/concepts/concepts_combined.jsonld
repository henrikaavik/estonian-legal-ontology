    {
      "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetamine_t1053122_renoveerimislaen",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "renoveerimislaen",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "korterelamu rekonstrueerimisele ja energiasäästu saavutamisele suunatud krediidi- või finantseerimisasutuse või ettevõtluse toetamise ja laenude riikliku tagamise seaduse § 5 1 lõikes 1 nimetatud sihtasutuse väljastatav laen, mida ei rahastata taaste- ja vastupidavusrahastu või perioodi 2021–2027 Euroopa Liidu struktuurifondide vahenditest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053122_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute rekonstrueerimise toetamine",
      "rdfs:label": "renoveerimislaen (korterelamute_rekonstrueerimise_toetamine_t1053122)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_renoveerimislaen"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetamine_t1053122_sisekliima_tagamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sisekliima tagamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "energia kasutamine ruumiõhu kvaliteedi tagamiseks ning valgustamiseks vastavalt hoone tüüpilisele kasutusele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053122_Par_4"
        }
      ],
