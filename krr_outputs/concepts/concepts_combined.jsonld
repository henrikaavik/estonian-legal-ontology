        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rahvusvaheline patenditaotlus",
      "skos:definition": [
        {
          "@value": "1970. aasta 19. juunil Washingtonis sõlmitud „Patendikoostöölepingu” (edaspidi PCT ) (RT II 1994, 6/7, 21) artikli 3 kohane rahvusvaheline taotlus (edaspidi PCT taotlus )",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rahvusvaheline_projekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rahvusvaheline projekt",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_projektides_osalemise_kord_t1004136_rahvusvaheline_projekt"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rahvusvaheline projekt",
      "skos:definition": [
        {
          "@value": "väljaspool Eestit paikneva või registreeritud avalik-õigusliku juriidilise isiku, eraõigusliku juriidilise isiku või füüsilise isiku poolt ellukutsutud või osalusega tegevuste kogum tulemuse saavutamiseks, mille realiseerimine on seotud tähtajalise ja rahalise piiranguga ning mille kulud kaetakse täielikult või osaliselt eespool nimetatud isikute poolt",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rahvusvaheline_sertifikaat",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rahvusvaheline sertifikaat",
