      "rdfs:label": "reklaam (viimsi_valla_reklaamimaarus_t1039864)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_reklaamimaarus_t1039864_maksuobjekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
