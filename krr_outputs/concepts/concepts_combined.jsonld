        "@id": "estleg:Concept_teenistuskoht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_vallavalitsuse_palgajuhend_t1055505_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistujale makstav põhipalk või töötasu, muutuvpalk, eritingimustes töötamise eest makstav lisatasu (lisatasu ületunnitöö, ööajal ja riigipühal tehtava töö eest), asendustasu ja lisatasu valveaja eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055505_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi Vallavalitsuse palgajuhend",
      "rdfs:label": "palk (viimsi_vallavalitsuse_palgajuhend_t1055505)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_palk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_vallavalitsuse_palgajuhend_t1055505_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhipalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga või töötasu fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055505_Par_2"
        }
      ],
