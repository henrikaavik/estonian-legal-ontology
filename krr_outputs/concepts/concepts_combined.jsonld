      },
      "rdfs:label": "omapuhasti ehk kohtpuhasti",
      "skos:definition": [
        {
          "@value": "reoveepuhasti, mille projekteeritud reostuskoormus on kuni 50 ie-d",
          "@language": "et"
        },
        {
          "@value": "on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 ie-d",
          "@language": "et"
        },
        {
          "@value": "rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid olmereoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti. Siia alla kuuluvad nii septikud kui biopuhastid koos puhastatud reovee suublasse juhtimisega. Omapuhasti koosneb mahutist, millele järgneb suubla",
          "@language": "et"
        },
        {
          "@value": "rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti",
          "@language": "et"
        },
        {
          "@value": "rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ning mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti (edaspidi ie )",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
