      },
      "rdfs:label": "elanikkond",
      "skos:definition": [
        {
          "@value": "elamu- ja korteriühistud ning füüsilised isikud, kes kasutavad vee- ja kanalisatsiooniteenust isiklikus majapidamises; 7 (",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_elektri",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elektri",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_elektri"
        },
        {
          "@id": "estleg:Concept_probleemtoodete_kohta_kehtestatud_keeldude_ja_piirangute_rak_t1036384_elektri"
        },
        {
          "@id": "estleg:Concept_probleemtoodete_kohta_kehtestatud_keeldude_ja_piirangute_rak_t1036384_elektri_probleemtoodete_kohta_kehtestatud_keeldude_ja_piirangute_rak_t1036384_2_11"
        },
        {
          "@id": "estleg:Concept_soojus_ja_elektrienergia_tohusa_koostootmise_nouded_t1036997_elektri"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "elektri",
      "skos:definition": [
        {
          "@value": "ja elektroonikaseade - seade, mis vajab töötamiseks elektrivoolu või elektromagnetvälja ning seade selle voolu ja välja tekitamiseks, suunamiseks ning mõõtmiseks ja on mõeldud kasutamiseks pingel mitte üle 1000 V vahelduvvoolu korral ning mitte üle 1500 V alalisvoolu korral; 4",
          "@language": "et"
        },
        {
          "@value": "ja elektroonikaseade on seade, mis vajab nõuetekohaseks toimimiseks elektrivoolu või elektromagnetvälja, ja seade, mida kasutatakse elektrivoolu ja elektromagnetväljade loomiseks, ülekandmiseks ja mõõtmiseks ning mis on kavandatud kasutamiseks kuni 1000-voldise vahelduvvooluga ja 1500-voldise alalisvooluga, ja on määratud käesoleva määruse lisas loetletud kategooriasse; 8",
          "@language": "et"
        },
        {
          "@value": "ja elektroonikaseadme varuosa on elektri- ja elektroonikaseadme üksikosa, millega saab asendada elektri- või elektroonikaseadme osa. Elektri- või elektroonikaseade ei saa kavandatult talitleda ilma selle osata, elektri- või elektroonikaseadme funktsioon taastub või paraneb, kui see osa asendatakse varuosaga. 2 (",
          "@language": "et"
        },
        {
          "@value": "ja soojusenergia suhe – talitlusandmetel põhinev elektri- ja soojusenergia suhe koostootmisrežiimil; 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_elektri_ja_soojuse_koostootmisjaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elektri ja soojuse koostootmisjaam",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_energiasalvestuse_pilootp_t1055298_elektri_ja_soojuse_koostootmisjaam"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "elektri ja soojuse koostootmisjaam",
      "skos:definition": [
        {
          "@value": "elektrijaama tüüp, mis üheaegselt toodab elektri- ja soojusenergiat, kasutades ära elektrienergia tootmisel tekkiva heitsoojuse; 4",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_elektriauto",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "elektriauto",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
