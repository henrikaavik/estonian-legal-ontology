    {
      "@id": "estleg:Concept_anija_vallavalitsuse_teenistujate_ja_hallatavate_asutuste_to_t1040811_personalikulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "personalikulu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutuse eelarves sisalduv teenistujate ja töötajate brutopalk koos kõikide riiklike maksudega; 12) palga- ja töötasuvahemik – ametniku ja töötajate gruppidele palga ja töötasu määramise aluseks olev palga- ja töötasu vahemik. Palga- ja töötasuvahemik sõltub ameti- või töökohale esitatud nõuetest, ülesannete keerukusest, tööülesannete täitmisega kaasnevast vastutusest ja lojaalsusest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040811_Par_2"
        }
      ],
