        "@language": "et"
      },
      "skos:definition": {
        "@value": "puuduva teenistuja ülesannete täitmise eest makstav lisatasu, mida makstakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, juhul kui asendamine ei ole ettenähtud teenistuja ametijuhendis või asendamine toob endaga kaasa olulise töökoormuse suurenemise.",
        "@language": "et"
      },
