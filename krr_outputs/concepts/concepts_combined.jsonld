      "rdfs:label": "Avariikaevetööd",
      "skos:altLabel": [
        {
          "@value": "avariikaevetööd",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kaevetööd avarii likvideerimiseks, mille tegemise vajadust ei olnud eelnevalt võimalik ette näha. 5 (",
          "@language": "et"
        },
        {
          "@value": "Kaevetööd, mille tegemise vajadus tekib ootamatult ja mis ebasoovitavaid tagajärgi silmas pidades on edasilükkamatud ning hädavajalikud. 6 (",
          "@language": "et"
        },
        {
          "@value": "kaevetööd, mille tegemise vajadus tekib ootamatult ja mis on ulatuslike ebasoovitavate tagajärgede tõttu edasilükkamatud. Avariikaevetööle kehtivad kõik käesoleva eeskirja nõuded; 4",
          "@language": "et"
        },
        {
          "@value": "kaevetööd, mille teostamise vajadus tekib ootamatult ja mille teostamist ei ole võimalik edasi lükata. 6",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_avariikaevetoo"
        }
      ]
    },
