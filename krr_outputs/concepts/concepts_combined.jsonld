        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (sh kuivkäima), puhastamiseks (sh septik) või maapinda immutamiseks",
        "@language": "et"
      },
