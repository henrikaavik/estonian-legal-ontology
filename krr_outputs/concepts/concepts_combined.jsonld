        }
      ]
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooni_kasutamis_t1058898_Uhisveevark_ja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Ühisveevärk ja",
      "skos:definition": "kanalisatsioon – on ehitiste ja seadmete süsteem, mille kaudu varustatakse tarbijaid joogiveega ja juhitakse ära ning puhastatakse reo- ja sademevett ning mille projekteeritud jõudlus on vähemalt kümme kuupmeetrit ööpäevas ja mis teenindab vähemalt 50 inimest. Ühisveevärgi ja -kanalisatsioonina käsitatakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos. Ühisveevärgi ja -kanalisatsioonina käsitatakse ka ehitiste ja seadmete süsteemi, mille projekteeritud jõudlus on alla kümne kuupmeetri ööpäevas või mis teenindab alla 50 inimese ja mille kohaliku omavalitsuse üksus on ühisveevärgi ja -kanalisatsiooni arendamise kavaga määranud ühisveevärgiks ja -kanalisatsiooniks.",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058898_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "Ühisveevärk ja (laane_nigula_valla_uhisveevargi_ja_kanalisatsiooni_kasutamis_t1058898)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhisveevark_ja"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_uhisveevark_ja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooniga_liitumi_t1058899_Uhisveevargi_ja__kanalisatsiooni_arendamise_kava",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Ühisveevärgi ja- kanalisatsiooni arendamise kava",
      "skos:definition": "kava, mille kinnitab kohaliku omavalitsuse Volikogu määrusega ja mille alusel toimub ühisveevärgi ja-kanalisatsiooni kohta koostatav analüüs, mis käsitleb valla või linna ühisveevärgi ja -kanalisatsiooni hetkeolukorda ja arendamisettepanekuid ning arendamine. 2",
