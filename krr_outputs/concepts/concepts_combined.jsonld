      "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_jaatmevedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jäätmevedaja",
      "skos:definition": "teenuste kontsessiooni või teenuste riigihanke korras valitud isik, kes osutab jäätmevaldajatele korraldatud jäätmeveo teenust kindlaksmääratud jäätmeliikide osas ja jäätmeveopiirkonnas; 3",
