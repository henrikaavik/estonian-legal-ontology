      }
    },
    {
      "@id": "estleg:Concept_kaevetoode_eeskiri_t1060811_vastutav_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vastutav isik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kaevetöö tegija poolt kirjalikult määratud isik, kes vastutab kaevetööde eest. Vastutavaks isikuks võib olla Euroopa Liidu kodanik või kehtivat töö- ja elamisluba omav muu isik. Kui vastutavat isikut ei ole määratud, loetakse vastutavaks isikuks kaevetöö tegija tegevjuht või juhatuse esimees. Kui kaevetöö tegija on füüsiline isik, võib ta ise olla ka vastutavaks isikuks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060811_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaevetööde eeskiri",
      "rdfs:label": "vastutav isik (kaevetoode_eeskiri_t1060811)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vastutav_isik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
