      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Aleviku",
      "skos:definition": "või külavanem (edaspidi külavanem ) on külaelanike esindaja, kes juhindub oma tegevuses küla huvidest ja ühistest seisukohtadest, valla arengukavast ning riigi ja kohaliku omavalitsuse õigusaktidest. Olukordades, kus tegevus ei ole määratletud olemasolevate seadustega, tegutseb külavanem heast tavast ja eetikanormidest lähtuvalt.",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042477_Par_1"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla aleviku- ja külavanema statuut",
