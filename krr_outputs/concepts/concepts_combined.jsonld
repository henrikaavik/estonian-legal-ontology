      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1056892_kaupleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "kaupleja",
      "skos:definition": "füüsiline või juriidiline isik, sealhulgas avalik-õiguslik juriidiline isik, kes majandus- või kutsetegevuse raames pakub ja müüb kaupa või pakub ja osutab teenust ning füüsiline isik, kes tegutseb väljaspool majandustegevust.",
      "estleg:definedIn": [
