        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "lisatasu täiendavate ülesannete eest",
      "skos:definition": [
        {
          "@value": "ametijuhendis või töölepingus nimetamata teenistusülesannete täitmise eest makstav või töömahu ajutisel olulisel määral suurenemise korral teenistujale makstav täiendav tasu",
          "@language": "et"
        },
        {
          "@value": "teenistujale makstav lisatasu ülesannete eest, mis ületavad kokkulepitud töömahtu, ei tulene olemasolevast töö sisust või ei ole seotud teenistuskoha eesmärgiga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
