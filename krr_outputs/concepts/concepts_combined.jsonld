      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_valla_hankekord_t1058651_volitatud_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
