        "@id": "estleg:Concept_tarbijapaigaldis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaugkuttepiirkonna_kehtestamine_t1015382_liitumispunkt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
