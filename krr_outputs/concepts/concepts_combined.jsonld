      }
    },
    {
      "@id": "estleg:Concept_meetme_piirkondade_konkurentsivoime_tugevdamine_tingimused_t315718_piirkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "piirkond",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühe või mitme kohaliku omavalitsuse üksuse territoorium, samuti külade kogum, linnaosa või linnaosade kogum, mida iseloomustab ühtse keskuse olemasolu või sarnased sotsiaal-majanduslikud või kultuurilised tingimused",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_315718_Par_2"
        }
