      ],
      "skos:prefLabel": {
        "@value": "koolituse arendamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hoolduskoormusega inimesele uue koolituse loomine projekti piirkonnas, kus seda koolitust pole varem pakutud, või olemasoleva koolituse parendamine või täiendamine uue koolituskomponendiga või koolituse ümberkujundamine hoolduskoormusega inimese vajadustele vastavamaks; koolituse arendamine hõlmab ka selle testimist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054007_Par_2"
        }
      ],
