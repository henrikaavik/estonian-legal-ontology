      "rdfs:label": "vaatluskaev",
      "skos:definition": [
        {
          "@value": "avatava luugi ja põhjas asuva voolurenniga kaev kanalisatsioonitorustikul",
          "@language": "et"
        },
        {
          "@value": "avatava luugi ja põhjasasuva voolurenniga kaev kanalisatsioonitorustikul",
          "@language": "et"
        },
        {
          "@value": "maa- või teepinnale avanev eemaldatava luugiga kaev (toru) kanalisatsioonitorustikul. Maapinnale ulatuv luuk kuulub vaatluskaevu osana kanalisatsioonirajatiste hulka",
          "@language": "et"
        },
        {
          "@value": "avatava luugi ja põhjas asuva voolurenniga kaev kanalisatsiooni-torustikul",
          "@language": "et"
        },
        {
          "@value": "avatava luugi ja põhjas asuva voolurenniga kaev kanalisatsioonitorustikul; vee- või reovee mõõtekaev - kaev, kus asub vee- või reoveemõõtesõlm; 27) vee- või reovee mõõtekaev - kaev, kus asub vee- või reoveemõõtesõlm; 28) vee- või reovee mõõtesõlm - vee- või reovee mõõtmiseks ettenähtud vee- või reoveearvesti ja arvesti juurde kuuluvast armatuurist koosnev tehniline sõlm",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
