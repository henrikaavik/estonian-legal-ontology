      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rahvusvahelise_patenditaotluse_patendiametile_esitamise_kord_t1002215_taotleja",
      "@type": [
        "owl:NamedIndividual",
