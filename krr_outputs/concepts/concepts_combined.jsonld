    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_infoturbe_haldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "infoturbe haldus",
      "skos:definition": "protsess, mida kasutatakse infovara konfidentsiaalsuse, tervikluse ja käideldavuse asjakohaste tasemete saavutamiseks ja säilitamiseks. Infoturbe halduse põhifunktsioonide hulka kuuluvad strateegilise infoturbepoliitika (põhimõtete) ja selle rakendamise kava koostamine, infoturbe organisatsiooni loomine, riskihaldus ja infoturbe käigus hoidmine; 11",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna infoturbepoliitika",
