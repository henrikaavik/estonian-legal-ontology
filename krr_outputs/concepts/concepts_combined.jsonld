      "skos:definition": [
        {
          "@value": "isiku või perekonna toimetulekut soodustav mitterahaline hüvitis. 4 (",
          "@language": "et"
        },
        {
          "@value": "isiku või perekonna toimetulekut soodustav mitterahaline hüvitis; 16",
          "@language": "et"
        },
        {
          "@value": "isiku või perekonna toimetulekut soodustav mitterahaline toetus; 3",
          "@language": "et"
        },
        {
          "@value": "mitterahaline hüvitis ehk isikule antav soodustus, mis ei seisne rahasumma maksmises, vaid on eelkõige isikule osutatav teenus või teenuse osutamise korraldamine, sealhulgas isikult talle kolmanda isiku poolt osutatud teenuse eest tasu maksmise kohustuse täielik või osaline ülevõtmine",
          "@language": "et"
        },
        {
          "@value": "toimetuleku soodustamiseks antav mitterahaline hüvitis; 3",
          "@language": "et"
        }
      ],
