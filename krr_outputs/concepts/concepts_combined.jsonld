    {
      "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809_Tarbimiskoha_veevark_ja_kanalisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Tarbimiskoha veevärk ja kanalisatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on ehitiste ja seadmete süsteem tarbija veega varustamiseks ühisveevärgist või reo- või sademevee ärajuhtimiseks ühiskanalisatsiooni. Tarbimiskoha veevärk ja kanalisatsioon ei ole ühisveevärgi ja -kanalisatsiooni osa. Tarbimiskoha veevärgil või kanalisatsioonil asuv veemõõdusõlm, välja arvatud veearvesti, on tarbimiskoha veevärgi või kanalisatsiooni osa.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058809_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
      "rdfs:label": "Tarbimiskoha veevärk ja kanalisatsioon (laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tarbimiskoha_veevark_ja_kanalisatsioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
