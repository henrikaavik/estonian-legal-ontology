    {
      "@id": "estleg:Concept_ruhnu_valla_jaatmehoolduseeskiri_t1053973_biolagunevad_koogi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "biolagunevad köögi",
      "skos:definition": "ja sööklajäätmed on kodumajapidamises, jaemüügikohas ja toitlustusasutuses tekkinud toidu- ja köögijäätmed nagu puu- ja köögiviljade puhastamise jäägid, liha- ja kalajäägid, poolfabrikaadid, kohvi- ja teepuru sh filtrid, pagaritooted jmt; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053973_Par_2"
        }
      ],
