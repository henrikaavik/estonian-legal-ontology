      ],
      "skos:prefLabel": {
        "@value": "elemendid",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ökosüsteemi olulised osad, eelkõige selle bioloogilised elemendid (liigid, elupaigad, kooslused) või merekeskkonnale avalduva surve aspektid (bioloogilised, füüsilised, ained, prügi, energia), mida kriteeriumi puhul hinnatakse",
        "@language": "et"
      },
