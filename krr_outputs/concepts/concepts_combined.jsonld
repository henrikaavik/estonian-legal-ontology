    {
      "@id": "estleg:Concept_meetme_tooturul_osalemist_toetavad_hoolekandeteenused_elluvi_t1035121_sihtruhm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "sihtrühm",
      "skos:definition": "käesoleva määruse tähenduses erivajadusega, hoolduskoormusega, hooldusvajadusega ja toimetulekuraskustes inimesed; RT I 2020-05-15 18 115052020018 2020-05-18 , rakendatakse tagasiulatuvalt alates 12. märtsist 2020. a. 6 6<sup>1</sup>) toimetulekuraskustes inimene – 18-aastane ja vanem inimene, kelle toimetulekut või kelle perekonna toimetulekut raskendavad ajutised või püsivad asjaolud, mille tulemusena ei ole igapäevaelu vajaduste rahuldamine, õiguste realiseerimine ja kohustuste täitmine konkreetses elukeskkonnas inimese jaoks jõukohane; RT I 2020-05-15 18 115052020018 2020-05-18 , rakendatakse tagasiulatuvalt alates 12. märtsist 2020. a. 6 6<sup>2</sup>) rahvusvahelise kaitse saanud isik – välismaalane, kes on Vabariigi Valitsuse 8. märtsi 2022. a korraldusest nr 66 „Ajutise kaitse kohaldamine” tulenevalt välismaalasele rahvusvahelise kaitse andmise seaduse kohaselt ajutise kaitse saaja, ja Ukrainas elanud Ukraina kodanik, kes ei ole sellise kaitse saaja, kuid kellele on välismaalasele rahvusvahelise kaitse andmise seaduse § 37 alusel antud rahvusvaheline kaitse ja tähtajaline elamisluba; RT I 2022-07-08 11 108072022011 2022-07-11 7",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1035121_Par_2"
        }
      ],
      "estleg:sourceAct": "Meetme „Tööturul osalemist toetavad hoolekandeteenused” elluviimiseks struktuuritoetuse andmise tingimused ja kord",
      "rdfs:label": "sihtrühm (meetme_tooturul_osalemist_toetavad_hoolekandeteenused_elluvi_t1035121)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_sihtruhm"
      },
      "skos:exactMatch": [
