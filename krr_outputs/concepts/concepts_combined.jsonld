      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "v alla ühiskondlikuks objektiks olev reklaamikandja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Rae vallale kuuluva ehitise või rajatise pinnale paigutatud reklaamikandja, mis samaaegselt selle kasutamisega reklaamialaseks tegevuseks teenib valla avalikke huve (bussiootepaviljon, prügikast jm)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055163_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaami paigaldamine ja reklaamimaksu kehtestamine Rae vallas",
