      "rdfs:label": "kohalik tee",
      "skos:altLabel": [
        {
          "@value": "Kohalik tee",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "tee, mille osas omaniku ülesandeid täidab kohaliku omavalitsuse üksus. Kohalik tee võib olla avalikuks kasutamiseks määratud eratee, kohalikule omavalitsuse üksusele kuuluv tee või kohaliku omavalitsuse volikogu otsuse kohaselt kohaliku omavalitsuse hallatav kohaliku liikluse korraldamiseks vajalik muu tee; 5",
          "@language": "et"
        },
        {
          "@value": "tee, mille osas omaniku ülesandeid täidab kohaliku omavalitsuse üksus. Kohalik tee võib olla avalikuks kasutamiseks määratud eratee, kohaliku omavalitsuse üksusele kuuluv tee või kohaliku omavalitsuse volikogu otsuse kohaselt kohaliku omavalitsuse hallatav kohaliku liikluse korraldamiseks vajalik muu tee; 3",
          "@language": "et"
        },
        {
          "@value": "kohalik maantee, tänav, jalgtee, jalgrattatee ja kohalikuks liiklemiseks ettenähtud talitee ning vallavalitsuse ja eratee omaniku vahel sõlmitud lepingu alusel avalikuks kasutamiseks määratud eratee. 4",
          "@language": "et"
        },
        {
          "@value": "on tee mille osas omaniku ülesandeid täidab Lääne-Nigula vald. Kohalik tee võib olla avalikuks kasutamiseks määratud eratee, Lääne-Nigula vallale kuuluv tee või Lääne-Nigula valla hallatav kohaliku liikluse korraldamiseks vajalik muu tee (edaspidi vallatee). 3 (",
          "@language": "et"
        },
        {
          "@value": "on tee mille osas omaniku ülesandeid täidab Lääneranna vald. Kohalik tee võib olla avalikuks kasutamiseks määratud eratee, Lääneranna vallale kuuluv tee või Lääneranna valla hallatav kohaliku liikluse korraldamiseks vajalik muu tee. 3 (",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      }
    },
