        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vaatluskaev",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avatava luugi ja põhjasasuva voolurenniga kaev kanalisatsioonitorustikul; 20) vee- või reovee mõõtesõlm - vee või reovee mõõtmiseks ettenähtud vee- või reoveearvesti ja arvesti juurde kuuluvast armatuurist koosnev tehniline sõlm; 21) vee- või reovee mõõtekaev - kaev, kus asub vee- või reoveemõõtesõlm",
        "@language": "et"
      },
      "estleg:definedIn": [
