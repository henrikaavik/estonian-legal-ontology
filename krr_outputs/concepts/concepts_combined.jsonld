    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_andmevarundus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "andmevarundus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teatud ajahetkel varukoopia loomine varundamisele kuuluvatest andmetest, mis salvestatakse mõnele lisaandmekandjale. Andmevarunduse liigid on: a) täielik andmevarundus - varukoopia loomine kõigist varundamisele kuuluvatest andmetest; b) diferentseeritud andmevarundus – varukoopia tegemine ainult sellistest failidest, mis on võrreldes viimase täieliku andmevarundusega muutunud; c) inkrementaalne andmevarundus – vastupidiselt täielikule andmevarundusele varukoopia tegemine ainult sellistest failidest, mis on võrreldes viimase andmevarundusega muutunud.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna infoturbepoliitika",
      "rdfs:label": "andmevarundus (maardu_linna_infoturbepoliitika_t1049639)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_andmevarundus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_infosusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "infosüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "andmeid töötlev, salvestav või edastav tehniline süsteem koos tema normaalseks talitluseks vajalike vahendite, ressursside ja protsessidega; 9) infosüsteemide kolmeastmeline etalonturve (edaspidi ISKE) − infoturbe metoodika, mida rakendatakse infovarale ja mis sisaldab juhised ning turvameetmete kataloogi, kuidas korraldada infoturbe haldust, määrata infovarade turbevajadust ja turvameetmeid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna infoturbepoliitika",
      "rdfs:label": "infosüsteem (maardu_linna_infoturbepoliitika_t1049639)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_infosusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_infoturbe_haldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "infoturbe haldus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "protsess, mida kasutatakse infovara konfidentsiaalsuse, tervikluse ja käideldavuse asjakohaste tasemete saavutamiseks ja säilitamiseks. Infoturbe halduse põhifunktsioonide hulka kuuluvad strateegilise infoturbepoliitika (põhimõtete) ja selle rakendamise kava koostamine, infoturbe organisatsiooni loomine, riskihaldus ja infoturbe käigus hoidmine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna infoturbepoliitika",
      "rdfs:label": "infoturbe haldus (maardu_linna_infoturbepoliitika_t1049639)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_infoturbe_haldus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
