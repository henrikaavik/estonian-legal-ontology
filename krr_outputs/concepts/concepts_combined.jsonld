      },
      "rdfs:label": "sademevee ärajuhtimise leping",
      "skos:definition": [
        {
          "@value": "sademeveekanalisatsiooni omaniku ja kinnistuomaniku vahel sõlmitud leping sademe- ja drenaaživee ning pinna- ja pinnasevee ärajuhtimise teenuse osutamiseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sademeveekanalisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sademeveekanalisatsioon",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kohila_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eesk_t1061205_sademeveekanalisatsioon"
        },
