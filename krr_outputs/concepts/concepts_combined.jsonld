      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "arst",
      "skos:definition": [
        {
          "@value": "puude raskusastme tuvastamist taotleva isiku perearst või isikut põhiliselt raviv eriarst, kellel on tema terviseseisundi kirjeldamiseks asjakohased andmed; 3) tegutsemise ja osalemise piirang (edaspidi piirang ) – takistus, mida isik kogeb tegevuse sooritamisel või igapäevaelu olukordades",
          "@language": "et"
        },
        {
          "@value": "registreeritud tervishoiutöötajate riiklikus registris arstina",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_arno"
        },
