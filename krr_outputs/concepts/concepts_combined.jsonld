      "rdfs:label": "täiendavad teenistusülesanded",
      "skos:definition": [
        {
          "@value": "ametijuhendis või õigusaktides fikseerimata ülesandeid, mis oluliselt suurendavad teenistuja töömahtu ja mida talle annab vahetu juht või mille täitmine toimub seaduse alusel",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
