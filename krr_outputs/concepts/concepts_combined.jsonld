      }
    },
    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1054448_kaubanduse_korraldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaubanduse korraldaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik või asutus, kes majandus- või kutsetegevuse raames korraldab tänava- või turukaubandust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054448_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord Mustvee vallas",
      "rdfs:label": "kaubanduse korraldaja (avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1054448)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kaubanduse_korraldaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1054448_muuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "müüja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kaupleja nimel klienti teenindav füüsiline isik või isik, kes müüb kaupa või osutab teenust tänava- või turukaubanduse korras; 4) tänavakaubandus, sh kandekaubandus on valla omandis asuval kinnisasjal avalikus kohas toimuv kauba või teenuse müük; 5) kandekaubandus on kauba jaemüük, mis toimub müüja käest, käsikorvist, kandelaualt või muust müüja poolt kantavast või kaasaveetavast inventarist, kus müüja pakub kaupa liikudes jalgsi või kergliiklusvahendil ning peatub kauba müügiks ostjale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054448_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord Mustvee vallas",
      "rdfs:label": "müüja (avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1054448)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1054448_korvalkulud",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kõrvalkulud",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "täiendavad kulud kaubanduse korraldajale, mis kaasnevad kaupleja tegevusega müügikohal. Kõrvalkuludeks on näiteks elektrienergiakulud, vee- ja kanalisatsioonikulud, jäätmeveokulud jms",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054448_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord Mustvee vallas",
