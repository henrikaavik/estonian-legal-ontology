      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vaike_maarja_valla_heakorraeeskiri_t1046087_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omanik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle omandis on kinnisasi või vallasasi. Omanikuga on eeskirjas võrdsustatud ka kinnistamata maaüksuse valdaja ja/või valitseja. Juhul, kui omaniku poolt sõlmitud leping ei kehtesta teise poole kohustusi heakorra tagamiseks, lasub nimetatud kohustus omanikul",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046087_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja valla heakorraeeskiri",
      "rdfs:label": "omanik (vaike_maarja_valla_heakorraeeskiri_t1046087)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vaike_maarja_valla_heakorraeeskiri_t1046087_puhastusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puhastusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistuga vahetult piirnev üldkasutatav ala, sealhulgas kõnnitee, mis ulatub kinnistu piirist sõiduteeni, välja arvatud teemaa",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046087_Par_2"
        }
      ],
