      "rdfs:label": "Mikroettevõtja",
      "skos:altLabel": [
        {
          "@value": "mikroettevõtja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "raamatupidamiskohustuslane, kelle aruandekuupäeva näitajatest kaks ei ületa järgmisi näitajaid: varad kokku 450 000 eurot, aruandeaasta tulu 900 000 eurot ja keskmine töötajate arv aruandeaasta jooksul 10 inimest.",
          "@language": "et"
        },
        {
          "@value": "vastavalt komisjoni määruse (EL) nr 651/2014 lisa I artikli 2 lõikele 3 loetakse mikroettevõtteks see ettevõtja, mis annab tööd vähem kui kümnele inimesele ja mille aastakäive ja/või aastabilansi kogumaht ei ületa kahte miljonit eurot",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
