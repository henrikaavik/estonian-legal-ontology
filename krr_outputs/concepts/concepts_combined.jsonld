      "rdfs:label": "puu hoolduslõikus",
      "skos:definition": [
        {
          "@value": "lõikus puu võra hooldamiseks ja/või kujundamiseks, mille käigus säilib puu elujõulisus",
          "@language": "et"
        },
        {
          "@value": "on puuokste eemaldamine (kärpimine, pügamine, tagasilõikamine), millega säilib puu elujõulisus ning mille tagajärjel vähemalt üks tekkiv lõikehaav on 3 cm või suurema läbimõõduga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
