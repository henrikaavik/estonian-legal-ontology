      },
      "rdfs:label": "teenistuja",
      "skos:altLabel": [
        {
          "@value": "Teenistuja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ametiasutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja; 2",
          "@language": "et"
        },
        {
          "@value": "linnavalitsusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik, kes teostab avalikku võimu või eraõiguslikus töösuhtes olev (s.o. töölepingu alusel töötav) töötaja, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. 2",
          "@language": "et"
        },
        {
          "@value": "vallavalituse teenistujate koosseisus ettenähtud ametikohale nimetatud ametnik või töökohale võetud töötaja; 6",
          "@language": "et"
        },
        {
          "@value": "vastavalt avaliku teenistuse seaduse § 5 alusel on avalik teenistuja asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja (s.o. töölepingu alusel töötav); 2",
          "@language": "et"
        },
        {
          "@value": "ametiasutusega avalik- õiguslikus teenistus- ja usaldussuhtes olev ametisse nimetatud ametnik või eraõiguslikus töösuhtes olev (s.o töölepingu alusel töötav) töötaja; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "55",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_teenistujad"
        }
      ]
    },
    {
      "@id": "estleg:Concept_teenistujad",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistujad",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_peipsiaare_vallavalitsuse_palgajuhend_t1054997_teenistujad"
        },
        {
          "@id": "estleg:Concept_viljandi_valla_finantsjuhtimise_kord_t1028098_teenistujad"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teenistujad",
      "skos:definition": [
        {
          "@value": "Peipsiääre vallaga avalik õigusliku teenistus ja usaldussuhtes olev ametnik või eraõiguslikus suhtes olev töötaja; 2",
          "@language": "et"
        },
        {
          "@value": "vallavalitsuse ametiasutuse ametnikud ja töötajad ning vallavalitsuse ametiasutuse hallatavate asutuste töötajad; 9",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_teenistuja"
        }
      ]
    },
    {
      "@id": "estleg:Concept_teenistusgrupp",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistusgrupp",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_harku_valla_ametiasutuste_ja_palgaliste_vallavalitsuse_liikm_t1059584_teenistusgrupp"
        },
        {
          "@id": "estleg:Concept_joelahtme_vallavalitsuse_palgajuhend_t1054402_teenistusgrupp"
        },
        {
          "@id": "estleg:Concept_keila_linnavalitsuse_asutusena_struktuur_teenistuskohtade_ko_t1011457_Teenistusgrupp"
        },
        {
