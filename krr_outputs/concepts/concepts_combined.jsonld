        "@type": "xsd:integer"
      },
      "rdfs:label": "projekt",
      "skos:definition": [
        {
          "@value": "käesoleva määruse nõuetele vastavate tegevuste kogum, mille kulud hüvitatakse osaliselt toetuse arvelt",
          "@language": "et"
        },
        {
          "@value": "kindlaks määratud eesmärgi, tulemusnäitaja, eelarve ja piiritletud ajaraamiga tegevus või seotud tegevuste kogum, millega kaasnevate kulude hüvitamiseks toetust taotletakse ja kasutatakse",
          "@language": "et"
        },
        {
          "@value": "toetuse taotluses märgitud tegevuste kogum, mis viiakse ellu abikõlblikkuse perioodil.",
          "@language": "et"
        },
        {
          "@value": "ettepanekus sisalduv kindlaksmääratud tulemuse, eelarve ja piiritletud ajaraamiga tegevus või seotud tegevuste kogum, millega kaasnevate kulude hüvitamiseks toetust taotletakse või kasutatakse",
          "@language": "et"
        },
        {
          "@value": "kindla eesmärgi saavutamisele suunatud ajas ja ruumis piiritletud ühekordne tegevus või tegevuste kogum tulemuse saavutamiseks, mille kulud kaetakse osaliselt või täielikult valla eelarvevälistest vahenditest, kuid mille üheks partneriks on Viimsi vallavalitsus või valla hallatav asutus",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "31",
        "@type": "xsd:integer"
      },
