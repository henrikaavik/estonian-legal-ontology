    },
    {
      "@id": "estleg:Concept_saarde_vallavalitsuse_palgajuhend_t1058256_tootasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötajale tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust",
        "@language": "et"
      },
