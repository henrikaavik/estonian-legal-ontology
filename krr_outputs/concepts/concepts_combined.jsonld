          "@id": "estleg:Concept_purotehniline_toode"
        }
      ]
    },
    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_rannaala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "rannaala",
      "skos:definition": "järvede ja jõgede kalda maismaaosa veepiirist kuni tugevaima tormilaine mõjupiirini või vastavate viitadega märgistatud piirini. Rannaala võib olla koht inimestele puhkuse veetmiseks ning vabaaja võimaldamiseks; 21",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044621_Par_2"
        }
      ],
      "estleg:sourceAct": "Peipsiääre valla heakorra eeskiri",
