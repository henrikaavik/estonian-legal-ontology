      "skos:definition": [
        {
          "@value": "mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi/fekaal purgimiskohta.",
          "@language": "et"
        },
        {
          "@value": "mahutiga auto, mille abil tühjendatakse reoveekogumismahutit ning veetakse reovesi purgimiskohta",
          "@language": "et"
        },
        {
          "@value": "(edaspidi sõiduk) – mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi/fekaal purgimiskohta",
          "@language": "et"
        },
        {
          "@value": "lekkekindla mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi purgimissõlme.",
          "@language": "et"
        },
