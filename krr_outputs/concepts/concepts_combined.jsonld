    {
      "@id": "estleg:Concept_bioloogilise_vedeliku_proovi_votmise_sailitamise_uuringuks_e_t1024832_volitatud_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "volitatud isik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tervishoiutöötaja, bioanalüütik või riikliku ekspertiisiasutuse meditsiinilise haridusega töötaja, kellel on õigus võtta analüüsimiseks vere- või uriiniproovi või osaleda selleks vajalike toimingute tegemises, samuti politsei või seaduses sätestatud juhul muu korrakaitseorgan, kellel on õigus võtta uriiniproovi indikaatorvahendiga kontrollimiseks ning indikaatorvahendi positiivse näidu korral proovi uuringuks edastamiseks vajalike toimingute tegemiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1024832_Par_1"
        }
      ],
      "estleg:sourceAct": "Bioloogilise vedeliku proovi võtmise, säilitamise, uuringuks edastamise, uuringu tegemise ja nende toimingute tasustamise kord",
      "rdfs:label": "volitatud isik (bioloogilise_vedeliku_proovi_votmise_sailitamise_uuringuks_e_t1024832)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_volitatud_isik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_bioloogilise_vedeliku_proovi_votmise_sailitamise_uuringuks_e_t1024832_saatekiri",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "saatekiri",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määruse lisas esitatud vormi kohaselt koostatud dokument, kuhu märgitakse andmed vere- või uriiniproovi võtmise ja selle analüüsimiseks edastamise ning riiklikus ekspertiisiasutuses tehtud analüüsi tulemuste kohta, samuti hinnang isikul narkootilise või psühhotroopse aine tarvitamisest põhjustatud joobeseisundi olemasolu või puudumise kohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1024832_Par_1"
        }
      ],
      "estleg:sourceAct": "Bioloogilise vedeliku proovi võtmise, säilitamise, uuringuks edastamise, uuringu tegemise ja nende toimingute tasustamise kord",
      "rdfs:label": "saatekiri (bioloogilise_vedeliku_proovi_votmise_sailitamise_uuringuks_e_t1024832)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_saatekiri"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
