      "estleg:definesConcept": {
        "@id": "estleg:Concept_mitterikosettiv"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_lasketiiru_ja_laskepaiga_ning_laskevoistluse_ja_treeninglask_t1051456_kova_materjal_voi_objekt",
