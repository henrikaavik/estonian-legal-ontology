      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_reostus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_nouded_suplusveele_ja_supelrannale_t1047813_luhiajaline_reostus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "lühiajaline reostus",
      "skos:definition": "lisa 1 punkti 6 veerus A nimetatud mikroorganismide põhjustatud mikrobioloogiline saaste, millel on selgelt määratavad põhjused ning mis ei mõjuta tavaliselt suplusvee kvaliteeti kauem kui ligikaudu 72 tundi ja mida hindab Terviseamet lisas 2 sätestatud hindamismeetodi kohaselt; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047813_Par_2"
        }
      ],
