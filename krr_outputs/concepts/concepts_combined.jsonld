          "@value": "teemaa",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "maa, mis on vajalik tee koosseisus olevate rajatiste paigutamiseks ja teehoiu korraldamiseks. 5",
          "@language": "et"
        },
        {
          "@value": "maa, mis on õigusaktidega määratud liiklemiseks, tee koosseisus olevate rajatiste paigutamiseks ja teehoiu korraldamiseks. Tee maakasutuse sihtotstarve on transpordimaa v a kui eramaa omanikuga on teekasutamine kokkulepitud teisiti. 6 (",
          "@language": "et"
        },
        {
          "@value": "maa, mis on õigusaktidega määratud liiklemiseks, tee koosseisus olevate rajatiste paigutamiseks ja teehoiu korraldamiseks. Tee maakasutuse sihtotstarve on transpordimaa. 6 (",
          "@language": "et"
        },
        {
          "@value": "maa, mis õigusaktidega kehtestatud korras on määratud tee kooseisus olevate rajatiste paigutamiseks ja teehoiu korraldamiseks. 6",
          "@language": "et"
        },
        {
          "@value": "maa, mis õigusaktidega kehtestatud korras on määratud tee koosseisus olevate rajatiste paigutamiseks ja teehoiu korraldamiseks.",
          "@language": "et"
        }
      ]
