    {
      "@id": "estleg:Concept_looma_identifitseerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "looma identifitseerimine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kiili_valla_koerte_kasside_ja_teiste_lemmikloomade_pidamise_t1006928_looma_identifitseerimine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "looma identifitseerimine",
      "skos:definition": [
        {
          "@value": "identifitseerimisviisid on looma märgistamine, looma kirjeldamine või looma kuuluvuse määratlemine. Looma märgistamine on tema varustamine eristamist võimaldava püsiva ning kordumatu kunstliku tunnusega. Looma kirjeldamist tema eristamise eesmärgil kasutatakse loomade puhul, keda ei ole võimalik või otstarbekas märgistada. Loomad, keda ei ole võimalik või otstarbekas märgistada ja kelle kohta ei saa selle loomaliigi isendite suure välise sarnasuse tõttu koostada kirjeldust, identifitseeritakse nende kuuluvuse kaudu",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_looma_margistamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "looma märgistamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_joelahtme_valla_koerte_ja_kasside_pidamise_eeskiri_t1013342_looma_margistamine"
        },
        {
          "@id": "estleg:Concept_koerte_ja_kasside_pidamise_eeskiri_t1054552_looma_margistamine"
        },
        {
          "@id": "estleg:Concept_muhu_valla_koerte_ja_kasside_pidamise_eeskiri_t1008977_looma_margistamine"
        },
        {
          "@id": "estleg:Concept_rakvere_valla_koerte_ja_kasside_pidamise_eeskiri_t1049364_looma_margistamine"
        },
        {
          "@id": "estleg:Concept_saarde_valla_koerte_ja_kasside_pidamise_eeskiri_t1049818_looma_margistamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "looma märgistamine",
      "skos:definition": [
        {
          "@value": "tegevusluba omava veterinaararsti poolt loomale mikrokiibi paigaldamine",
          "@language": "et"
        },
        {
          "@value": "looma varustamine eristamist võimaldava püsiva ning kordumatu kunstliku tunnusega, milleks Saarde vallas peetavatel loomadel on mikrokiip",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_looma_suhtes_lubamatu_tegu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "looma suhtes lubamatu tegu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kiili_valla_koerte_kasside_ja_teiste_lemmikloomade_pidamise_t1006928_looma_suhtes_lubamatu_tegu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "looma suhtes lubamatu tegu",
      "skos:definition": [
        {
          "@value": "looma hukkumist, vigastamist või talle valu ja välditavaid füüsilisi ja vaimseid kannatusi põhjustav tegu, nagu looma sundimine talle üle jõu käivatele pingutustele, loomavõitluse korraldamine, looma hülgamine või abitusse seisundisse jätmine, loomale kannatusi põhjustav aretustegevus ja muu sarnaste tagajärgedega tegu, mis ei ole tingitud looma ravimisest, muust veterinaarsest menetlusest ega hädaolukorrast, välja arvatud Loomakaitseseaduses ettenähtud juhud",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_loomad_ja_linnud",
