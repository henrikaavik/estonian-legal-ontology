      "rdfs:label": "energiatõhususe tööd",
      "skos:definition": [
        {
          "@value": "olemasoleva hoone energiatõhusust parandavad, kasvuhoonegaaside heidet vähendavad, hoonesse tarnitud energiat ja hoone ülalpidamiskulusid vähendavad ning taastuvenergia kasutust edendavad rekonstrueerimis- ja ehitustööd",
          "@language": "et"
        },
        {
          "@value": "olemasoleva hoone energiatõhusust parandavad, kasvuhoonegaaside heidet vähendavad, hoonesse tarnitud energiat ja hoone ülalpidamiskulusid vähendavad ning taastuvenergia kasutust edendavad rekonstrueerimis- ja ehitustööd.",
