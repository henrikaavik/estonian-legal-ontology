      "estleg:definesConcept": {
        "@id": "estleg:Concept_reoveepuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1058915_Reovesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reovesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on olmes, tööstuses või muus tootmises tekkinud vesi, mis ületab kehtestatud heite piirväärtusi ja mida tuleb enne suublasse juhtimist puhastada. Reoveeks peetakse ka ühisvoolsesse kanalisatsiooni juhitud sademevett.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058915_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
