          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetamine_t1053122_energiamargis"
        },
        {
          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetuse_andmise_tingimused_j_t1046780_energiamargis"
        },
        {
          "@id": "estleg:Concept_vaikeelamute_energiatohususe_suurendamise_toetuse_kasutamise_t1049699_energiamargis"
        },
        {
          "@id": "estleg:Concept_vaikeelamute_rekonstrueerimise_toetamine_t1058695_energiamargis"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiamärgis",
      "skos:definition": [
        {
          "@value": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav märgis, mis annab infot projekteeritava või olemasoleva hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta; 3",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav märgis, mis annab infot projekteeritava või olemasoleva hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta; 2 2<sup>1</sup>) energiasäästu maht – energiamärgise kohase energiaerikasutuse ja energiaarvutusel põhineva energiamärgise kohase planeeritava energiaerikasutuse vahe, kusjuures energiaerikasutuseks loetakse aastane tarnitud energiate summaarne kasutus kilovatt-tundides hoone köetava pinna ruutmeetri kohta [kWh/(m²·a)]; RT I 2020-05-08 7 108052020007 2020-05-11 3",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav märgis, mis annab infot projekteeritava või olemasoleva hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta; 4",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav tähis, mis annab infot hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta; 3",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis; 1 1<sup>1</sup>) mittetoetatav kulu – paragrahvi 1 lõikes 5 sätestatud juhul mitteabikõlblik kulu perioodi 2014–2020 struktuuritoetuse seaduse (edaspidi struktuuritoetuse seadus ) tähenduses; RT I 2022-08-16 2 116082022002 2022-08-19 1 1<sup>2</sup>) projekti elluviimisperiood – paragrahvi 1 lõikes 5 sätestatud juhul struktuuritoetuse seaduse § 2 punktis 6 nimetatud abikõlblikkuse periood; RT I 2022-08-16 2 116082022002 2022-08-19 2",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_energiamargistus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiamärgistus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
