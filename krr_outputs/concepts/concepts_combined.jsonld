      "rdfs:label": "rahvusvahelise kaitse saaja",
      "skos:definition": [
        {
          "@value": "inimene, kes on Eestis rahvusvahelise kaitse, sealhulgas ajutise või täiendava kaitse saaja või Eestis rahvusvahelise kaitse taotleja välismaalasele rahvusvahelise kaitse andmise seaduse tähenduses; 7",
          "@language": "et"
        },
        {
          "@value": "välismaalane, keda on tunnustatud pagulasena, täiendava kaitse või ajutise kaitse saajana ning kellele on antud Eesti elamisluba; 11",
          "@language": "et"
        }
      ]
    },
