      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "aia",
      "skos:definition": [
        {
          "@value": "ja haljastujäätmed – aedade ja haljasalade hooldamisel tekkinud biolagunevad jäätmed (rohi, lehed ja oksad); 2",
          "@language": "et"
        },
        {
          "@value": "ja haljastujäätmed – aedade ja haljasalade hooldamisel tekkinud biolagunevad jäätmed nagu rohi, lehed, puude- ja põõsaste oksad jne; 2",
          "@language": "et"
        },
        {
          "@value": "ja haljastujäätmed on aedade ja haljasalade hooldamisel tekkinud biolagunevad jäätmed (nt rohi, lehed, oksad jms); 2",
          "@language": "et"
        },
        {
          "@value": "ja haljastujäätmed on aedade ja haljastusalade hooldamisel tekkinud biolagunevad jäätmed nagu rohi, lehed, puude- ja põõsaste oksad jne; 2",
          "@language": "et"
        }
      ]
    },
