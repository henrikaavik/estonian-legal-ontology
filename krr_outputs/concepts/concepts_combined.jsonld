      }
    },
    {
      "@id": "estleg:Concept_laaneranna_vallavalitsuse_ametiasutuse_palgajuhend_t1040865_Ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on vallavalitsusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks.",
        "@language": "et"
      },
      "estleg:definedIn": [
