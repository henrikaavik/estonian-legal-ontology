        },
        {
          "@id": "estleg:Concept_taisealise_isiku_hoolduse_seadmise_hooldaja_maaramise_ning_h_t1042005_hooldatav"
        }
      ],
      "estleg:definitionCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hooldatav",
      "skos:altLabel": [
        {
          "@value": "Hooldatav",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "täisealine raske või sügava puudega abivajav isik, kelle hoolduse vajadus on tuvastatud Sotsiaalkindlustusameti ekspertiisi otsusega",
          "@language": "et"
        },
        {
          "@value": "igapäevast kõrvalabi, juhendamist ja järelevalvet vajav vaimse või füüsilise puudega täisealine isik, kellele on puuetega inimeste sotsiaaltoetuste seaduse kohaselt määratud raske või sügav puue.",
          "@language": "et"
        },
        {
          "@value": "isik, kelle hooldusvajadus on välja selgitatud hindamise abil ning tal on ajutiselt või püsivalt vajadus kasutada kõrvalabi",
          "@language": "et"
        },
        {
          "@value": "isik, kelle hooldusvajadus on välja selgitatud ning kellel on ajutiselt või püsivalt vaja kasutada pidevat kõrvalabi",
          "@language": "et"
        },
        {
          "@value": "kõrvalabi, juhendamist ja järelevalvet vajav vaimse või füüsilise puudega isik, kellele on puuetega inimeste sotsiaaltoetuste seaduse kohaselt määratud raske või sügav puue",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
