      "skos:definition": {
        "@value": "reovee reostustaset näitavate reostusnäitajate vahemik, mis on aluseks ülenormatiivse reostuse tasu kehtestamisele. Reostusgrupp on veeteenuse hinna alus. Konkurentsiametiga või kohaliku omavalitsusega kooskõlastatud veeteenuse hinna kehtestab vee- ettevõtja",
        "@language": "et"
      },
