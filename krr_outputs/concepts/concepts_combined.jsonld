        "@id": "estleg:Concept_vee_ettevotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saue_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_eeski_t1036784_volitatud_isik",
      "@type": [
