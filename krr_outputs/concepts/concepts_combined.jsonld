      "skos:prefLabel": {
        "@value": "tühisõit",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vedaja poolt jäätmevaldaja kinnistule tehtud sõit jäätmeveoteenuse osutamiseks, mille käigus jäätmete üleandmist ei toimunud jäätmevaldaja poolse eeskirja nõuete rikkumise tõttu",
