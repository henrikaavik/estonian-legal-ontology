        {
          "@value": "taotlusvoor, kus taotluse esitamine toimub jooksvalt kuni eelarve vabade vahendite lõppemiseni, kuid hiljemalt väljakuulutamise teates sätestatud tähtpäevaks.",
          "@language": "et"
        }
      ],
