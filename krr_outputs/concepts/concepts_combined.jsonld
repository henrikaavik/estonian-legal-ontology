      "skos:definition": {
        "@value": "reovee tekkimise asukohas kasutatav tehnoloogiline rajatis, mida kasutatakse reovee kogumiseks (sh kuivkäimla), puhastamiseks (sh biopuhasti) või maapinda immutamiseks",
        "@language": "et"
      },
