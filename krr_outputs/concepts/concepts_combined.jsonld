      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "maksudeklaratsioon",
      "skos:definition": "maksu suuruse arvutamiseks ettenähtud dokument, mille maksumaksja on maksuseaduse alusel kohustatud esitama maksuhaldurile; 12",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060944_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue valla välireklaami määrus",
