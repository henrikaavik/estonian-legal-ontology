    {
      "@id": "estleg:Concept_loksa_linna_korraldatavate_elutahtsate_teenuste_kirjeldused_t1061405_soojusettevotjad",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "soojusettevõtjad",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kaugkütteseaduse § 7 lõikes 3 sätestatud nõuetele vastavad soojuse tootja või ettevõtja, kes kasutab võrku soojuse jaotamiseks",
        "@language": "et"
      },
