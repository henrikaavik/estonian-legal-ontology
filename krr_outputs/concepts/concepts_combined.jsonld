      ],
      "skos:prefLabel": {
        "@value": "suverühm",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla lasteasutuse juures töötav lasteaiarühm, mis töötab suvekuudel valla teiste lasteasutuste kinnioleku ajal",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052957_Par_2"
        }
      ],
