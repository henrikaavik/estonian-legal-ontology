      ],
      "skos:prefLabel": {
        "@value": "avariikaevetööd",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kaevetööd, mille tegemise vajadus tekib ootamatult ja mis on ulatuslike ebasoovitavate tagajärgede tõttu edasilükkamatud. Avariikaevetööle kehtivad kõik käesoleva eeskirja nõuded",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060811_Par_2"
        }
      ],
