        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "väikese lisandväärtusega kontsernisisesed teenused",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "toetavat laadi teenused, mis ei kuulu hargmaiste ettevõtjate kontserni põhitegevuse hulka, ei eelda ainulaadsete või väärtuslike mittemateriaalsete varade kasutamist, ei too kaasa ainulaadsete või väärtuslike mittemateriaalsete varade teket ega põhjusta teenusepakkujale olulist riski ning mida osutab üks või mitu hargmaiste ettevõtjate kontserni liiget vaid teistele kontserniliikmetele.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_308002_Par_2"
        }
      ],
      "estleg:sourceAct": "Seotud isikute vahel tehtud tehingute väärtuse määramise meetodid",
