      "skos:definition": [
        {
          "@value": "eraõiguslik juriidiline isik (klubi, selts või muu ühing) või füüsilisest isikust ettevõtja, kes pakub harrastajale võimalusi osaleda huvitegevuses (edaspidi taotleja või toetuse saaja ); meisterlikkuse toetuse või stipendiumi puhul ka täiskasvanud füüsiline isik",
          "@language": "et"
        }
      ],
