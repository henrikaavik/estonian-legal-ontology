    },
    {
      "@id": "estleg:Concept_ce_margistus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "CE-märgistus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_saaremaa_vallas_t1047226_CE_margistus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "CE-märgistus",
      "skos:definition": [
        {
          "@value": "tootja või importija poolt antud garantii, et toode vastab kõikidele olulistele töötervishoiu, töö- ja keskkonnaohutuse nõuetele",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_dendroloogiline_hinnang",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "dendroloogiline hinnang",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_raieloa_ja_hooldusloikusloa_andmise_kord_t1050444_dendroloogiline_hinnang"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "dendroloogiline hinnang",
      "skos:definition": [
        {
          "@value": "puu tervisliku seisundi hindamine ja edasise majandamise soovitused, mille lähteülesanne koostatakse lähtuvalt hinnangu eesmärgist ja konkreetsest objektist ja võib sisaldada muuhulgas täiendavate uuringute teostamist, puu väärtuse hindamist antud kasvukohal (sealhulgas linnaruumis), puu mõju hindamist rajatistele ja hoonete konstruktsioonidele või muid hinnanguid ning mille koostab puittaimede hindaja tase 5 või samaväärset (osa)kutset omav isik",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_detailne_alaeelarve",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "detailne alaeelarve",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_hiiumaa_valla_finantsjuhtimise_kord_t1041766_detailne_alaeelarve"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "detailne alaeelarve",
      "skos:definition": [
        {
          "@value": "valitsuse kinnitatud alaeelarve tegevusalade ja hallatavate asutuste kasutus- ja vastutusalas olevad eelarved detailsemas jaotuses",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_detailplaneering",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "detailplaneering",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_detailplaneeringukohaste_ja_planeeringulahenduse_elluviimise_t1055786_detailplaneering"
        },
        {
          "@id": "estleg:Concept_kastre_valla_rajatiste_valjaehitamise_ja_valjaehitamisega_se_t1055909_detailplaneering"
        },
        {
          "@id": "estleg:Concept_detailplaneeringukohaste_ja_planeeringulahenduse_elluviimise_t1056680_detailplaneering"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "detailplaneering",
      "skos:definition": [
        {
          "@value": "menetletav detailplaneering, kehtestatud detailplaneering, planeerimisseaduse (edaspidi PlanS) § 125 lg-s 5 nimetatud projekteerimistingimused ja ehitusseadustiku (edaspidi EhS) §-s 27 nimetatud projekteerimistingimused",
          "@language": "et"
        },
        {
          "@value": "menetletav detailplaneering, kehtestatud detailplaneering, PlanS § 125 lg-s 5 nimetatud projekteerimistingimused ja EhS §-s 27 nimetatud projekteerimistingimused",
          "@language": "et"
        },
        {
          "@value": "on konkreetse maa-ala kohta koostatav terviklik ruumilahendus, millega määratakse seaduses sätestatud juhtudel maakasutus- ja ehitustingimused ning mis vastab PlanS § 3 sätestatule. Detailplaneeringus tuuakse välja detailplaneeringukohased avalikuks kasutamiseks ette nähtud teed ja sellega seonduvad rajatised, haljastus, välisvalgustus ning tehnorajatised",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_detailplaneeringu_eskiislahendus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "detailplaneeringu eskiislahendus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_joelahtme_valla_ehitusmaarus_t1027827_detailplaneeringu_eskiislahendus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "detailplaneeringu eskiislahendus",
      "skos:definition": [
        {
          "@value": "planeeringulahenduse ettepanek, mis koosneb joonistest ja seletuskirjast ning mille alusel on võimalik hinnata kavandatava ruumilist sobivust keskkonda",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_detailplaneeringu_koostamisest_huvitatud_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "detailplaneeringu koostamisest huvitatud isik",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_planeerimisalase_tegevuse_korraldamine_viimsi_vallas_t1055507_detailplaneeringu_koostamisest_huvitatud_isik"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "detailplaneeringu koostamisest huvitatud isik",
      "skos:definition": [
        {
          "@value": "isik, kellel on planeeringuala ruumilahenduse visioon, huvi konkreetse planeeringu koostamiseks ja maa-ala arendamiseks ning finants- ja muud vahendid arenduse elluviimiseks, samuti isik, kes on huvitatud detailplaneeringu elluviimisest",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_detailplaneeringu_tehniline_koostaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "detailplaneeringu tehniline koostaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_planeerimisalase_tegevuse_korraldamine_viimsi_vallas_t1055507_detailplaneeringu_tehniline_koostaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "detailplaneeringu tehniline koostaja",
      "skos:definition": [
        {
          "@value": "planeerija (jooniste ja seletuskirja koostaja), kes on asjakohase erialase kõrgharidusega ja piisava töökogemusega või vastava kutsega isik, arvestades planeeringu liiki ja eesmärki ning kelle ülesandeks on planeeringu (sh jooniste ja seletuskirja) koostamine vastavalt planeerimise heale tavale",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_detailplaneeringukohane_rajatis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "detailplaneeringukohane rajatis",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_planeerimisalase_tegevuse_korraldamine_viimsi_vallas_t1055507_detailplaneeringukohane_rajatis"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "detailplaneeringukohane rajatis",
      "skos:definition": [
        {
          "@value": "detailplaneeringukohased avalikuks kasutamiseks ette nähtud teed (sh sõidu- ja kergteed, parklad jms) ja sellega seonduvad rajatised (sh bussipeatused, piirdeaiad, pollarid, müratõkked, liikluskorraldusvahendid jms), haljastus (sh haljakud, taskupargid jms), välisvalgustus, tehnorajatised (sh sademevesi, drenaaž, looduspõhised sademevee lahendused), koerte- ja mänguväljakud, avaliku ruumi mööbel (pargi ja tänavamööbel) ning muud planeeringulahenduse elluviimiseks otseselt vajalikud ning sellega funktsionaalselt seotud rajatised (sh ka pakendipunktid, erirajatised jms). Detailplaneeringukohaseks rajatiseks loetakse ka olemasolevat ümberehitamist vajavat rajatist, kui see on vajalik läbilaskvuse või võimsuse muutmiseks (nt vee- ja kanalisatsioonitorustiku asendamine, rõhutõstejaama paigaldamine, ristmiku või alajaama ümberehitamine jms).",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_detailse_alaeelarve_kasutaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "detailse alaeelarve kasutaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_hiiumaa_valla_finantsjuhtimise_kord_t1041766_detailse_alaeelarve_kasutaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "detailse alaeelarve kasutaja",
      "skos:definition": [
