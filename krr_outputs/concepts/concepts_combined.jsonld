          "@id": "estleg:Concept_tervishoiutootajate_registreerimise_aluseks_olevate_kvalifik_t312134_tervishoiutootaja_kvalifikatsioon"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tervishoiutöötaja kvalifikatsioon",
      "skos:definition": [
        {
          "@value": "dokumentaalselt tõendatud kutse- või erialane kõrgharidus või määruses sätestatud juhtudel töökogemus, mida nõutakse Eesti Vabariigis arstina, hambaarstina, õena või ämmaemandana töötamiseks. 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tihe",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tihe",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
