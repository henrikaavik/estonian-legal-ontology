      },
      "rdfs:label": "ühissõiduk",
      "skos:definition": [
        {
          "@value": "Jõhvi valla haldusterritooriumil tasulise sõitjateveo teostamiseks kasutatav buss, sõiduauto või muu mootori jõul liikuv transpordivahend",
          "@language": "et"
        },
        {
          "@value": "ühistransporditeenuse osutamiseks ettenähtud transpordivahend",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_uhissoiduki_kaart",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühissõiduki kaart",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rongisoidul_soodustuse_saamise_kord_t1036572_uhissoiduki_kaart"
        },
        {
          "@id": "estleg:Concept_rongisoidul_soodustuse_saamise_kord_t1043437_uhissoiduki_kaart"
        },
        {
          "@id": "estleg:Concept_saue_valla_opilastele_soidusoodustuste_andmise_tingimused_ja_t1043788_uhissoiduki_kaart"
        },
        {
          "@id": "estleg:Concept_valla_bussiliinidel_piletihinna_kehtestamine_ja_bussisoidul_t1043803_uhissoiduki_kaart"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ühissõiduki kaart",
      "skos:definition": [
        {
          "@value": "elektrooniline kontaktivaba isikustatud või isikustamata andmekandja (Ühiskaart) sõiduõiguse tõendamiseks Harju Maakonna avalikel liinidel ja vallaliinidel, millele saab soetada piletitooteid ning mis annab kiipkaardi valdajale õiguse sõita tasuta või saada sõidusoodustust maakonna avalikul bussiliinil Tallinn – Saue – Tallinn või vallaliinil",
          "@language": "et"
        },
        {
          "@value": "elektrooniline kontaktivaba isikustatud või isikustamata andmekandja sõiduõiguse tõendamiseks Harju Maakonna avalikel liinidel",
          "@language": "et"
        },
        {
          "@value": "elektrooniline kontaktivaba isikustatud või isikustamata andmekandja sõiduõiguse tõendamiseks Harju Maakonna avalikel liinidel (Ühiskaart), millele saab soetada piletitooteid ning mis annab kiipaardi valdajale õiguse sõita Elroni rongides piletitootena aktiveeritud reisil või piiramatu arv kordi piletitootena aktiveeritud perioodi vältel",
          "@language": "et"
        },
        {
          "@value": "elektrooniline kontaktivaba isikustatud või isikustamata andmekandja sõiduõiguse tõendamiseks Harju Maakonna avalikel liinidel (Ühiskaart), millele saab soetada piletitooteid ning mis annab kiipkaardi valdajale õiguse sõita maakonnaliinil, vallaliinil ja Elroni rongides piletitootena aktiveeritud reisil või piiramatu arv kordi piletitootena aktiveeritud perioodi vältel",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_uhisturunduse_projekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühisturunduse projekt",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_ekspordi_arendamise_toetamise_tingimused_ja_kord_t1000010_uhisturunduse_projekt"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ühisturunduse projekt",
      "skos:definition": [
        {
          "@value": "tegevuste kogum, mille raames kaks või enam sarnast majandushuvi jagavat ettevõtjat teostavad projektis määratletud sihtturgude osas ühiselt läbiviidavaid turundustegevusi, saavutades seeläbi iga projektis osaleva ettevõtja individuaalseid eesmärke",
          "@language": "et"
        }
