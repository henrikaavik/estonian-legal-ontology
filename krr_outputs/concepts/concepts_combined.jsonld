      ],
      "skos:prefLabel": {
        "@value": "liitumispunkt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühisveevärgi ja -kanalisatsiooni omaniku või valdaja määratud ühisveevärgi ja -kanalisatsiooni ühenduskoht kinnistu veevärgi või kanalisatsiooniga. Liitumispunkt asub avalikult kasutataval maal kuni üks meeter väljaspool kinnistu piiri. Kui liitumispunkti ei ole võimalik määrata eelnimetatud tingimusel, lepitakse liitumispunkti asukoht vee-ettevõtja ja liituja vahelise kokkuleppega. Liitumispunkt on ühisveevärgi ja -kanalisatsiooni oluline osa",
        "@language": "et"
      },
