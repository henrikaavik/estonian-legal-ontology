      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaamialus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_sotsiaalreklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sotsiaalreklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaam, mille eesmärk on saavutada hinnangute andmise kaudu inimese käitumine avalikes huvides ja milles teatud probleemile keskendudes ei pakuta kaubamärgipõhist, vaid üldist lahendit",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025627_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla reklaamimäärus",
      "rdfs:label": "sotsiaalreklaam (raasiku_valla_reklaamimaarus_t1025627)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_sotsiaalreklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_valla_uhiskondlikuks_objektiks_olev_reklaamialus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valla ühiskondlikuks objektiks olev reklaamialus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Raasiku vallale kuuluva ehitisele õiguspäraselt paigutatud reklaamialus, mis samaaegselt selle kasutamisega reklaamialaseks tegevuseks teenib valla avalikke huve (bussiootepaviljon, prügikast jm)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025627_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla reklaamimäärus",
      "rdfs:label": "valla ühiskondlikuks objektiks olev reklaamialus (raasiku_valla_reklaamimaarus_t1025627)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valla_uhiskondlikuks_objektiks_olev_reklaamialus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_reklaami_paigaldamise_luba",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaami paigaldamise luba",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Raasiku Vallavalitsuse (edaspidi vallavalitsus ) korraldus, millega antakse nõusolek reklaami või reklaamialuse paigaldamiseks. Reklaamina ei käsitata: 1) majandus- või kutsetegevuse kohas antavat teavet kauba, teenuse või selle müügitingimuste kohta (tarbijakaitseseaduse § 4 lõikes 2 nimetatud teave); 2) majandus- või kutsetegevuse koha tähistust selle nime, liigi, kauba müügi või teenuse osutamise aja, isiku nime, kaubamärgi ja domeeninimega ehitisel või tänavakaubanduse kioskil, kus majandus- või kutsetegevuse koht asub; 3) väljaspool ehitist asuva majandus- või kutsetegevuse koha tähistust käesoleva lõike punktides 1 ja 2 nimetatud teabega, mis asub majandus- või kutsetegevuse ehitise juurde kuuluval kinnistul; 4) isiku majandus- või kutsetegevuses kasutatava sõiduki tähistust selle isiku nime, kontaktandmete, kaubamärgi, domeeninime ja tegevusalaga; 5) märgistust kauba müügipakendil pakendiseaduse tähenduses; 6) sponsorteates avaldatud spondeerija nime, kaubamärki ja teavet tema antud toetuse kohta; 7) roogade ja jookide hinnakirja, mis on paigutatud toitlustusettevõtte sissekäigu juurde.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025627_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla reklaamimäärus",
      "rdfs:label": "reklaami paigaldamise luba (raasiku_valla_reklaamimaarus_t1025627)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaami_paigaldamise_luba"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1047567_biopuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "biopuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "omapuhasti, milles reoveest reoainete kõrvaldamine toimub bioloogiliste protsesside toimel ja mille tulemusel heitvesi vastab Vabariigi Valitsuse 29.11.2012. a määruses nr 99 “ Reovee puhastamise ning heit- ja sademevee suublasse juhtimise kohta esitatavad nõuded, heit- ja sademevee reostusnäitajate piirmäärad ning nende nõuete täitmise kontrollimise meetmed“ lisas 1 esitatud heitvee reostusnäitajate piirväärtustele biokeemilise hapnikutarbe, heljuvaine ja keemilise hapnikutarbe osas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047567_Par_1"
        }
      ],
      "estleg:sourceAct": "Raasiku valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "biopuhasti (raasiku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1047567)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_biopuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
