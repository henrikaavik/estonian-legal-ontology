        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huviharidus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pikaajaline ning õppekavale tuginev süsteemne ja juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest vabal ajal, et omandada teadmised ja oskused valitud valdkonnas",
        "@language": "et"
      },
