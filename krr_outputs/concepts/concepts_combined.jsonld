        "@id": "estleg:Concept_valireklaam"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_valireklaam"
        }
      ]
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_valireklaamikandja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "välireklaamikandja",
      "skos:definition": "asi, millele paigaldatakse välireklaami või mille vahendusel edastatakse välireklaami; 13",
      "estleg:definedIn": [
