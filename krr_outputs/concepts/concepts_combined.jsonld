        "@value": "grupp",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "linna konsolideerimisgrupp, kuhu kuuluvad LRK-d, linnakassa ja linna valitseva või olulise mõju all olevad juriidilised isikud ning nende kaudu valitseva mõju all olevad juriidilised isikud",
        "@language": "et"
      },
      "estleg:definedIn": [
