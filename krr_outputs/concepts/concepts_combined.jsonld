    {
      "@id": "estleg:Concept_saue_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_eeski_t1036784_vee_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eraõiguslik juriidiline isik, kes varustab kliendi kinnistu veevärki ühisveevärgi kaudu veega või korraldab ühiskanalisatsiooni kaudu kliendi kinnistu kanalisatsioonist reovee ärajuhtimist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
