    {
      "@id": "estleg:Concept_poltsamaa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1059391_Valla_valitsev_moju",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Valla valitsev mõju",
      "skos:definition": "RTJ 11 punkti 7 kohaselt osalusega tütarettevõtted, mida kontrollib vald. Kontrolli olemasolu eeldatakse juhul, kui valla omanduses on otse või tütarettevõtete kaudu rohkem kui 50% tütarettevõtte hääleõigusest, välja arvatud erandjuhud, kui on võimalik selgelt tõendada, et sellise hääleõigusega ei kaasne kontrolli. Kontroll eksisteerib ka siis, kui vallale kuulub 50% ja vähem hääleõigusest, kuid vald: 1",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059391_Par_2"
        }
      ],
      "estleg:sourceAct": "Põltsamaa Vallavalitsuse raamatupidamise sise-eeskiri",
