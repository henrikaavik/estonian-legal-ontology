          "@id": "estleg:Concept_reklaamimaks_t1055745_reklaamipind"
        },
        {
          "@id": "estleg:Concept_reklaami_paigaldamine_ja_reklaamimaksu_kehtestamine_rae_vall_t1055163_reklaamipind"
        }
      ],
      "estleg:definitionCount": {
