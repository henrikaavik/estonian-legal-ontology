    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallavalitsusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o. töölepingu alusel töötav) töötaja. 2) Ametnik –vallavalitsusega avalik-õiguslikus teenistus- ja usaldussuhtes olev isik, kes on nimetatud ametikohale, millel teostatakse avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Teenistuja (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Töötaja (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Teenistuskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Teenistuskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Teenistuskoht (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuskoht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Palk (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_palk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Tootasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Töötasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasust, mida asutus maksab töötajale tehtud töö eest vastavalt töölepingule, õigusaktidele ja tööandja poolt kehtestatud korrale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Töötasu (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Põhipalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Põhipalk (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pohipalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Muutuvpalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Muutuvpalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Muutuvpalk (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muutuvpalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Tulemuspalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Tulemuspalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Tulemuspalk (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tulemuspalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Preemia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Preemia",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "erakordsete teenistusalaste saavutuste eest makstav lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Preemia (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_preemia"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Lisatasu_taiendavate_teenistusulesannete_eest",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Lisatasu täiendavate teenistusülesannete eest",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "täiendavate teenistusülesannete täitmise eest makstav lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Lisatasu täiendavate teenistusülesannete eest (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_lisatasu_taiendavate_teenistusulesannete_eest"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Asendustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Asendustasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puuduva teenistuja ülesannete täitmise eest makstav lisatasu, mida makstakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, juhul kui asendamine ei ole ettenähtud teenistuja ametijuhendis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Asendustasu (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_asendustasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Lisatasu_valveaja_eest",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Lisatasu valveaja eest",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valveaja eest makstav lisatasu; 14) .Lisatasu ületunnitöö eest – ületundide tegemise eest makstav lisatasu. Ületundide arvestamise alused ja kord on kehtestatud asutuse sisekorraeeskirjades",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Lisatasu valveaja eest (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_lisatasu_valveaja_eest"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Lisatasu_ooajal_tehtava_too_eest",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Lisatasu ööajal tehtava töö eest",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lisatasu, mida makstakse juhul kui teenistuja tööaeg langeb ööajale ning kui nimetatud kohustus ei sisaldu tema ametijuhendis ja seda ei ole arvestatud tema palga määramisel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Lisatasu ööajal tehtava töö eest (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_lisatasu_ooajal_tehtava_too_eest"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kihnu_vallavalitsuse_palgajuhend_t1013680_Lisatasu_riigipuhal_tootamise_eest",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Lisatasu riigipühal töötamise eest",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lisatasu, mida makstakse juhul kui tööaeg langeb riigipühale; 17) Tööjõukulud (ka personalikulud) – vastavalt rahandusministri määrusele „Riigi raamatupidamise üldeeskiri“ sisaldavad tööjõukulud töötasu ja palka, eripensionidega ja erisoodustustega seotud kulusid ning tööjõukuludega kaasnevaid makse ja sotsiaalkindlustusmakse; 18) Töötasukulud (ka palgakulud) – vastavalt rahandusministri määrusele \"Riigi raamatupidamise üldeeskiri\" sisaldavad töötasukulud palka ja kokkulepitud tasusid, ergutusi ning hüvitisi ja toetusi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013680_Par_3"
        }
      ],
      "estleg:sourceAct": "Kihnu vallavalitsuse palgajuhend",
      "rdfs:label": "Lisatasu riigipühal töötamise eest (kihnu_vallavalitsuse_palgajuhend_t1013680)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_lisatasu_riigipuhal_tootamise_eest"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
