      "skos:definition": [
        {
          "@value": "müügikohas antav kauba, teenuse või selle müügitingimuste kohta käiv kliendile suunatud teave; tegevuskoha tähistus kaupleja ärinime, kaubamärgi, domeeninime ning kliendile mõistetava tegevuskoha liigiga, tegevuskoha nime olemasolu korral ka tegevuskoha nimega; tegevuskohas teave kauplemisaja kohta; 13",
          "@language": "et"
        },
        {
          "@value": "müügikohas antav kauba, teenuse või selle müügitingimuste kohta käiv kliendile suunatud teave; tegevuskoha tähistus kaupleja ärinime, kaubamärgi, domeeninime ning kliendile mõistetava tegevuskoha liigiga, tegevuskoha nime olemasolu korral ka tegevuskoha nimega; tegevuskohas teave kauplemisaja kohta; 14",
          "@language": "et"
