    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamise_kord_t1045101_huviharidus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "huviharidus",
      "skos:definition": "pikaajaline süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest ja kutseõppest vabal ajal, omandades süvendatud teadmisi ja oskusi valitud huvialal. Huviharidust omandatakse huvikoolis või erakooli seaduse alusel tegutsevas koolis; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1045101_Par_2"
        }
