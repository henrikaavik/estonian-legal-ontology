      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_mehaaniline_puhastamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_antsla_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1052568_BHT",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
