      },
      "rdfs:label": "Kliendi saatmise teenus",
      "skos:definition": [
        {
          "@value": "kliendi aitamine liikumisel kodust, haiglaruumist vm hoonesisesest mistahes korrusel asuvast asukohast sõidukini või vastupidi (sh. näiteks haiglas arsti vastuvõtu kabineti ukse taha saatmine, ja haigla vastutavale töötajale edasiseks saatmiseks üleandmine).",
          "@language": "et"
        }
      ],
