      },
      "rdfs:label": "kinnistutorustik",
      "skos:definition": [
        {
          "@value": "kinnistusisesed veevärgi- ja/või kanalisatsioonirajatised (kinnistu veevärk ja kanalisatsioon) alates liitumispunktist ühisveevärgi ja/või -kanalisatsiooniga, sealhulgas ehitise sisevõrgud; 19",
          "@language": "et"
        },
