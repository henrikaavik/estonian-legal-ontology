    {
      "@id": "estleg:Concept_laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660_Tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Tee",
      "skos:definition": "on rajatis, mis on ette nähtud inimeste, sõidukite või loomade liikumiseks või liiklemiseks. Tee osaks loetakse tunnel, sild, viadukt ja muud liiklemiseks kasutatavad ning tee toimimiseks vajalikud rajatised. 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060660_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla teede kasutamise ja kaitse eeskiri",
      "rdfs:label": "Tee (laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tee"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_tee"
        }
      ]
    },
    {
      "@id": "estleg:Concept_laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660_Kohalik_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kohalik tee",
      "skos:definition": "on tee mille osas omaniku ülesandeid täidab Lääneranna vald. Kohalik tee võib olla avalikuks kasutamiseks määratud eratee, Lääneranna vallale kuuluv tee või Lääneranna valla hallatav kohaliku liikluse korraldamiseks vajalik muu tee. 3 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060660_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla teede kasutamise ja kaitse eeskiri",
      "rdfs:label": "Kohalik tee (laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kohalik_tee"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_kohalik_tee"
        }
      ]
    },
    {
      "@id": "estleg:Concept_laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660_Eratee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Eratee",
      "skos:definition": "tee, mis paikneb juriidilise või füüsilise isiku kinnisasjal. Erateed võib kasutada ainult kinnisasja omaniku loal, välja arvatud alarmsõidukid ja erakorralise või sõjaseisukorra ajal kaitseväe sõidukid. 4 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060660_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla teede kasutamise ja kaitse eeskiri",
      "rdfs:label": "Eratee (laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eratee"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_eratee"
        }
      ]
    },
    {
      "@id": "estleg:Concept_laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660_Metsatee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Metsatee",
      "skos:definition": "on riigi omandisse jäetud maal paiknev valdavalt riigimetsa majandamiseks kasutatav tee. Metsateed võib kasutada igaüks, kui riigimetsa majandamist korraldav isik või riigiasutus ei ole metsateed või selle osa sulgenud või metsateel liiklust piiranud. 5 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060660_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla teede kasutamise ja kaitse eeskiri",
      "rdfs:label": "Metsatee (laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_metsatee"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_metsatee"
        }
      ]
    },
    {
      "@id": "estleg:Concept_laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660_Teemaa",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Teemaa",
      "skos:definition": "maa, mis on õigusaktidega määratud liiklemiseks, tee koosseisus olevate rajatiste paigutamiseks ja teehoiu korraldamiseks. Tee maakasutuse sihtotstarve on transpordimaa. 6 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060660_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla teede kasutamise ja kaitse eeskiri",
      "rdfs:label": "Teemaa (laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teemaa"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_teemaa"
        }
      ]
    },
    {
      "@id": "estleg:Concept_laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660_Tee_kaitsevoond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Tee kaitsevöönd",
      "skos:definition": "avalikult kasutatava tee kaitsevöönd on teed ümbritsev maa-ala, mis tagab tee kaitse, teehoiu korraldamise, liiklusohutuse ning vähendab teelt lähtuvaid keskkonnakahjulikke ja inimestele ohtlikke mõjusid. Teel on kaitsevöönd, kui tee on avalikult kasutatav. Tee kaitsevööndi laius sõidutee teljest mõlemale poole on 10 meetrit. 7 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060660_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääneranna valla teede kasutamise ja kaitse eeskiri",
      "rdfs:label": "Tee kaitsevöönd (laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660)",
