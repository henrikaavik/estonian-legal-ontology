        "@id": "estleg:Concept_purgimiskoht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054000_purgimisteenus",
