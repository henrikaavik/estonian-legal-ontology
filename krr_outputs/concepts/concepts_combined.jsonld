      ],
      "skos:definition": [
        {
          "@value": "ühisveevärgil asuv veevõtukoht koos teenindamiseks vajalike seadmete, ehitiste ja muu sellisega",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgil asuva avaliku veevõtmise seadme koht koos teenindamiseks vajalike ehitistega.",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgil asuva veevõtmise seadme (olmevesik, paakautode täitmise seade jms) koht koos teenindamiseks vajalike ehitistega",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgil asuva veevõtmise seadme (olmevesik, paakautode täitmise seade jms.) koht koos teenindamiseks vajalike ehitistega",
          "@language": "et"
        },
