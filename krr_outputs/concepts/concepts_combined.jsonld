        "@type": "xsd:integer"
      },
      "rdfs:label": "käideldavus",
      "skos:definition": [
        {
          "@value": "andmete, teabe ja infosüsteemide kättesaadavus vajalikel hetkedel",
          "@language": "et"
        },
        {
          "@value": "teabe kasutamise ja teabele juurdepääsu võimalus volitatud isiku nõudel",
          "@language": "et"
        },
        {
          "@value": "teave ja vajalikud süsteemid on õigel ajal kättesaadavad volitatud kasutajatele",
          "@language": "et"
        },
        {
          "@value": "vajalikul ja nõutaval tööajal kasutamiskõlblike andmete õigeaegne ning hõlbus kättesaadavus selleks volitatud isikule või tehnilisele vahendile",
          "@language": "et"
        }
      ],
