      ],
      "skos:prefLabel": {
        "@value": "elektriauto",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "M1 ja N1 kategooria täiselektriline või pistikhübriidsõiduk ning käesoleva määruse § 4 lõikes 1 1 nimetatud tingimustele vastav L6E ja L7E kategooria täiselektriline sõiduk",
        "@language": "et"
      },
      "estleg:definedIn": [
