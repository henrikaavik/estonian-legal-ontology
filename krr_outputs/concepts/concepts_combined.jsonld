      "skos:definition": [
        {
          "@value": "hulkuvate loomade pidamiseks ettenähtud ning selleks kohandatud koht",
          "@language": "et"
        },
        {
          "@value": "hulkuvate loomade pidamiseks ettenähtud koht",
          "@language": "et"
        },
        {
          "@value": "loomade pidamiseks ettenähtud ning selleks kohandatud koht",
          "@language": "et"
        },
        {
          "@value": "ajutine eluase, kus abivajajale on tagatud voodikoht, võimalus hoolitseda isikliku hügieeni eest. Tegemist on vältimatu abi korras osutatava eluasemeteenusega",
          "@language": "et"
        },
        {
          "@value": "asutus, mis on ettenähtud hulkuvate loomade pidamiseks.",
