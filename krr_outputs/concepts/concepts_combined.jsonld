        "@language": "et"
      },
      "skos:definition": {
        "@value": "täiendava aine, eriala õpetamise, pedagoogilise, eripedagoogilise ja ainedidaktilise pädevuse omandamine juba töötavate või elukutset vahetavate isikute poolt",
