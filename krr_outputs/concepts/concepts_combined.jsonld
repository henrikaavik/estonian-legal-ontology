    {
      "@id": "estleg:Concept_sotsiaaltoetuste_maksmise_ja_sotsiaalhoolekandelise_abi_andm_t1041856_sissetulekust_mittesoltuv_toetus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sissetulekust mittesõltuv toetus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sissetulekust mittesõltuv toetus konkreetselt määratletud sihtrühmale; 10) rehabilitatsiooniplaan on õigustatud isiku ja tema seadusliku esindaja osalemisel rehabilitatsioonimeeskonna koostatud dokument, milles kajastub hinnang isiku tegevusvõimele, sotsiaalse rehabilitatsiooni eesmärk, eesmärgi saavutamiseks vajalikud rehabiliteerivad teenused ja hinnang sotsiaalse rehabilitatsiooni eesmärgi saavutamise koht; 11) hooldusplaan on teenuse osutaja poolt koostöös teenuse saajaga või juhul, kui teenuse saaja pole kontaktne, teenuse rahastajaga koostatud kirjalik dokument, mis sisaldab teenuse osutamise eesmärki, eesmärgi saavutamise tegevusi ja sagedust ning teenuse osutaja hinnangut tegevuste elluviimise kohta; 12) juhtumiplaan on kirjalik dokument, mis koosneb hinnangust isiku abivajadusele ja abimeetmete rakendamise tegevuskavast.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041856_Par_2"
        }
      ],
      "estleg:sourceAct": "Sotsiaaltoetuste maksmise ja sotsiaalhoolekandelise abi andmise kord Narva-Jõesuu linnas",
      "rdfs:label": "sissetulekust mittesõltuv toetus (sotsiaaltoetuste_maksmise_ja_sotsiaalhoolekandelise_abi_andm_t1041856)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_sissetulekust_mittesoltuv_toetus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
