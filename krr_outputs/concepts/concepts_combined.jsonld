      "skos:definition": {
        "@value": "sademeveekanalisatsiooni ehitiste või seadmete ettenägematu purunemine või rikkiminek, mille tagajärjel oluliselt halveneb või katkeb piirkonna sademevee kokku kogumine ja ära juhtimine ning mille tagajärjel tekib üleujutuse oht",
        "@language": "et"
      },
      "estleg:definedIn": [
