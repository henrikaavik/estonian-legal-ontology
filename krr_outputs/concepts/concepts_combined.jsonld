        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühenduskraan",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "veevarustuse ühendustorul peatoru juures asuv sulgur, mis järgneva sulguri puudumisel on ühtlasi peakraaniks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1035491_Par_2"
        }
      ],
