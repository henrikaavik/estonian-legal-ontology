      "estleg:definesConcept": {
        "@id": "estleg:Concept_kaevetoo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_valla_heakorra_ja_kaevetoode_eeskiri_t1059297_kaevetoode_luba",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaevetööde luba",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla ehitusspetsialisti poolt väljastatud dokument, mis annab õiguse kaevetööde teostamiseks, määrab kaevetööde tingimused ja aja.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059297_Par_2"
        }
      ],
      "estleg:sourceAct": "Vormsi valla heakorra ja kaevetööde eeskiri",
