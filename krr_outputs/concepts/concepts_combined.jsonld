      "rdfs:label": "ühisveevärgi ja- kanalisatsiooni arendamise kava",
      "skos:altLabel": [
        {
          "@value": "Ühisveevärgi ja- kanalisatsiooni arendamise kava",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kava mille kinnitab kohaliku omavalitsuse volikogu ja mille alusel arenduspiirkonnas toimub ühisveevärgi ja-kanalisatsiooni arendamine; 2",
          "@language": "et"
        },
        {
          "@value": "kava, mille kinnitab kohaliku omavalitsuse Volikogu määrusega ja mille alusel toimub ühisveevärgi ja-kanalisatsiooni kohta koostatav analüüs, mis käsitleb valla või linna ühisveevärgi ja -kanalisatsiooni hetkeolukorda ja arendamisettepanekuid ning arendamine. 2",
          "@language": "et"
        },
        {
          "@value": "kava, mille kinnitab kohaliku omavalitsuse volikogu ja mille alusel arenduspiirkonnas toimub ühisveevärgi, -kanalisatsiooni ning sademevee kanalisatsiooni arendamine; 37",
          "@language": "et"
        },
        {
          "@value": "kava, mille kinnitab kohaliku omavalitsuse volikogu määrusega ja mille alusel toimub ühisveevärgi ja-kanalisatsiooni kohta koostatav analüüs, mis käsitleb valla ühisveevärgi ja -kanalisatsiooni hetkeolukorda ja arendamisettepanekuid ning arendamist. 2",
          "@language": "et"
        }
      ]
    },
