        "@id": "estleg:Concept_muutuvpalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tallinna_linna_ametiasutuste_palgajuhend_t1056815_asendustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "asendustasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "puuduva teenistuja ülesannete täitmise eest määratav ja makstav lisatasu. See määratakse ajutiselt äraoleva teenistuja asendamise või ajutiselt vaba teenistuskoha ülesannete täitmise eest, kui asendamine ei ole ette nähtud teenistuja ametijuhendis või töölepingus",
        "@language": "et"
      },
      "estleg:definedIn": [
