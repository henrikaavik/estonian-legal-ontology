      },
      "rdfs:label": "klient",
      "skos:altLabel": [
        {
          "@value": "Klient",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kinnistu omanik, hoonestusõiguse alusel maakasutaja või ehitise kui vallasasja omanik, kelle kinnistu või ehitise veevärk või kanalisatsioon on ühendatud ühisveevärgi ja -kanalisatsiooniga vajaliku torustikuühenduse kaudu ja kellega vee-ettevõtja on sõlminud lepingu ühisveevärgist vee võtmiseks või reo- ning sademevee ärajuhtimiseks",
          "@language": "et"
        },
        {
          "@value": "juriidiline või füüsiline isik, kes on vee-ettevõttega sõlminud teenuslepingu",
          "@language": "et"
        },
        {
          "@value": "kinnistu omanik, hoonestusõiguse alusel maakasutaja või ehitise kui vallasasja omanik, kelle kinnistu või ehitise veevärk või kanalisatsioon on ühendatud ühisveevärgi ja -kanalisatsiooniga vajaliku torustikuühenduse kaudu ja kellega vee-ettevõtja on sõlminud lepingu ühisveevärgist vee võtmiseks või reovee ärajuhtimiseks",
          "@language": "et"
        },
        {
          "@value": "kinnistu omanik või valdaja, hoonestusõiguse alusel maakasutaja või ehitise kui vallasasja omanik või valdaja, kelle kinnistu veevärk või kanalisatsioon on ühendatud ühisveevärgi ja –kanalisatsiooniga vastava torustikuühenduse kaudu ja kellega vee-ettevõtja on sõlminud lepingu ühisveevärgivee võtmiseks või reo- ning sademevee ärajuhtimiseks",
          "@language": "et"
        },
        {
          "@value": "kinnistu omanik või valdaja, hoonestusõiguse alusel maakasutaja või ehitise kui vallasasja omanik või valdaja, kelle kinnistu või ehitise veevärk või kanalisatsioon on ühendatud ühisveevärgi ja -kanalisatsiooniga vajaliku torustikuühenduse kaudu ja kellega vee-ettevõtja on sõlminud lepingu ühisveevärgist vee võtmiseks või reo- ning sademevee ärajuhtimiseks",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "26",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kliimakindlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kliimakindlus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_rohevesiniku_kasutuselevo_t1055698_kliimakindlus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kliimakindlus",
      "skos:definition": [
        {
          "@value": "kliimakindlus on taristu vastupanuvõime võimalikele pikaajalistele kliimamõjudele. Kliimakindluse tagamine on protsess, mille eesmärk on vältida taristu vastuvõtlikkust võimalikele pikaajalistele kliimamõjudele, tagades samas, et järgitakse energiatõhususe esikohale seadmise põhimõtet ja projektist tulenevate kasvuhoonegaaside heitkoguste tase on kooskõlas 2050. aastaks saavutatava kliimaneutraalsuse eesmärgiga.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kliimakindluse_tagamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kliimakindluse tagamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_avalike_biometaani_sisestuspunktide_toetuse_andmise_tingimus_t1062653_kliimakindluse_tagamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kliimakindluse tagamine",
      "skos:definition": [
        {
          "@value": "protsess, mille eesmärk on vältida taristu vastuvõtlikkust võimalikele pikaajalistele kliimamõjudele, tagades, et järgitakse energiatõhususe esikohale seadmise põhimõtet ja et projektist tulenevate kasvuhoonegaaside heitkoguste tase on kooskõlas 2050. aastaks saavutatava kliimaneutraalsuse eesmärgiga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
