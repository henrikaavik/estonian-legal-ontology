    {
      "@id": "estleg:Concept_kanepi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044995_reovee_bioloogiline_puhastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee bioloogiline puhastamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk sekundaarne puhastamine on reoveest reoainete kõrvaldamine bioloogiliste protsesside toimel, mille tulemusena heitvesi vastab Vabariigi Valitsuse 29.11.2012. a määruses nr 99 “ Reovee puhastamise ning heit- ja sademevee suublasse juhtimise kohta esitatavad nõuded, heit- ja sademevee reostusnäitajate piirmäärad ning nende nõuete täitmise kontrollimise meetmed“ esitatud heitvee reostusnäitajate piirväärtustele biokeemilise hapnikutarbe, heljuvaine ja keemilise hapnikutarbe osas; 10) ala, kus on piisavalt elanikke või majandustegevust reovee kanalisatsiooni kaudu kogumiseks ja reovee reoveepuhastisse või heitvee keskkonda juhtimiseks.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044995_Par_2"
        }
      ],
      "estleg:sourceAct": "Kanepi valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "reovee bioloogiline puhastamine (kanepi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044995)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_bioloogiline_puhastamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kanepi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044995_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "septik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pealt kinnine setiti, millesse sadestunud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044995_Par_2"
        }
      ],
      "estleg:sourceAct": "Kanepi valla reovee kohtkäitluse ja äraveo eeskiri",
