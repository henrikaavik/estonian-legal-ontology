      },
      "skos:definition": {
        "@value": "liitumispunkt on ühisveevärgi ja -kanalisatsiooni ühenduskoht tarbimiskoha veevärgi ja kanalisatsiooniga ning määrab ühisveevärgi ja -kanalisatsiooni ning tarbimiskoha veevärgi ja kanalisatsiooni vahelise piiri; liitumispunkt on ühisveevärgi ja -kanalisatsiooni osa",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1035491_Par_2"
        }
      ],
