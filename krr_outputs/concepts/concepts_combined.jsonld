          "@id": "estleg:Concept_biomassist_elektrienergia_koostootmise_juhis_t345646_kadu_seadmetes"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kadu seadmetes",
      "skos:definition": [
        {
          "@value": "elektrienergia tootmisprotsessis tekkiv energiakadu, eelkõige generaatoris, torustikes, soojusvahetis ning seoses turbiini välisjahtumisega. Kadu seadmetes ei sisalda katla soojuskadu; 5",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kaevaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
