    {
      "@id": "estleg:Concept_loodus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "loodus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
