          "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1051880_reklaamloosung"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "reklaamloosung",
      "skos:definition": [
        {
          "@value": "sõidutee kohale või selleks ettenähtud konstruktsioonile paigaldatud välireklaam; 12) reklaamimaks (edaspidi maks ) – Saaremaa valla avalik-õiguslike ülesannete täitmiseks vajaliku tulu saamiseks määruses sätestatud korras maksukohustuslase poolt maksuobjekti osas, suuruses ja tähtaegadel ilma otsese vastutasuta tasumisele kuuluv kohalik maks",
          "@language": "et"
        },
        {
          "@value": "välireklaam, mis paigaldatakse sõidu- või kergliiklustee kohale",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaammaterjal",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaammaterjal",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_ekspordi_arendamise_toetamise_tingimused_ja_kord_t1000010_reklaammaterjal"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "reklaammaterjal",
      "skos:definition": [
        {
          "@value": "ettevõtjat või ettevõtja poolt pakutavat toodet või teenust reklaamiv sihtturule suunatud trükis või muu audio, visuaalne või audiovisuaalne reklaammaterjal; 9) välismess või -näitus – toodete või teenuste turu mõjutamiseks korraldatav sündmus, mis toimub välisriigis ning mille toimumise ajal ettevõtja koos ühe või mitme tegevusvaldkonna ettevõtjatega tutvustab turuosalistele oma tooteid või teenuseid eesmärgiga edendada nende müüki",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
