        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teede grupp",
      "skos:definition": [
        {
          "@value": "loetelu teedest ja teelõikudest, mis on määruse lisas 1 liiklusintensiivsuse ja strateegilise tähtsuse alusel määratud ühte gruppi kolmest",
          "@language": "et"
        },
        {
          "@value": "teede liigitus ehk esimese grupi teed on asfaltbetoon kattega ja mustkattega teed ning teise grupi teed on pinnatud kruuskattega ja kruuskattega teed",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_teedegrupp"
        }
      ],
      "skos:inScheme": {
