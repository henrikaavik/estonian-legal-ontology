        {
          "@value": "kontseptsiooni või protsessi testimiseks ehitatud esialgne proovtoode, mudel või versioon, mida saab kopeerida ning vajaduse korral täiendada ning mis vastavalt üldise grupierandi määruse artiklile 25 liigitub tootearenduseks",
          "@language": "et"
        }
      ],
