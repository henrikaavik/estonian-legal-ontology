        "@type": "xsd:integer"
      },
      "rdfs:label": "reostus",
      "skos:altLabel": [
        {
          "@value": "Reostus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "vee omadusi halvendav saasteainete, organismide sisaldus vees, vee ülemäärane soojus või radioaktiivsus",
          "@language": "et"
        },
        {
          "@value": "vee omadusi halvendav reoainete, organismide, soojuse või radioaktiivsuse sisaldus vees",
          "@language": "et"
        },
        {
          "@value": "vee omadusi halvendav saasteainete, organismide, soojuse või radioaktiivsuse sisaldus vees",
          "@language": "et"
        },
        {
          "@value": "vee omadusi halvendav saasteainete või organismide sisaldus vees, või vee ülemäärane soojus või radioaktiivsus",
          "@language": "et"
        },
        {
          "@value": "suplusvee mikrobioloogilise saaste või muude suplusvee kvaliteeti mõjutavate organismide, ainete või jäätmete esinemine, sealhulgas § 4 lõikes 3 ja § 8 lõigetes 4–6 ning lisa 1 punkti 6 veerus A nimetatud mikroorganismid, mis ohustavad suplejate tervist",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
