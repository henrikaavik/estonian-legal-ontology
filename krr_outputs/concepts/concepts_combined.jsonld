    {
      "@id": "estleg:Concept_kiili_valla_heakorraeeskiri_t1052603_Romusoiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Romusõiduk",
      "skos:definition": "romusõiduk jäätmeseaduse § 26 3 lg 5 tähenduses on sõiduk, mis ei ole komplektne, millel puuduvad varem selle komplektis olnud materjalimahukuselt või tehniliselt olulised osad, nagu kere, sild, mootor, käigukast, katalüsaator, elektrooniline juhtplokk või muud osad, mis takistavad sõiduki liikluses osalemist. RT IV 2025-05-30 15 430052025015 2025-06-02",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052603_Par_2"
        }
      ],
