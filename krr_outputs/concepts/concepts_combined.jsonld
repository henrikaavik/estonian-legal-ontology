      }
    },
    {
      "@id": "estleg:Concept_rahvusvahelise_patenditaotluse_patendiametile_esitamise_kord_t1002215_Rahvusvaheline_Buroo",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Rahvusvaheline Büroo",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Ülemaailmse Intellektuaalomandi Organisatsiooni (WIPO) Rahvusvaheline Büroo, kes võtab vastuvõtvatelt ametitelt vastu PCT taotlusi ja vahendab neid märgitud ametitele või märgitud ja väljavalitud ametitele ning teistele PCT ametitele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1002215_Par_1"
        }
      ],
      "estleg:sourceAct": "Rahvusvahelise patenditaotluse Patendiametile esitamise kord",
