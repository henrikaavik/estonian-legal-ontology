      "estleg:definitionCount": {
        "@value": "30",
        "@type": "xsd:integer"
      },
      "rdfs:label": "huvitegevus",
      "skos:altLabel": [
        {
          "@value": "Huvitegevus",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal.",
          "@language": "et"
        },
        {
          "@value": "harrastus",
          "@language": "et"
        },
        {
          "@value": "juhendatud tegevust süvendatud teadmiste ja oskuste omandamiseks valitud huvialal. 3) Huviring, ring – huvitegevuse/huvihariduse pakkumiseks korraldatav tegevus, milles noored osalevad regulaarselt. 4) Huvitegevuse/huvihariduse pakkuja (teenusepakkuja) – kultuuri-, noorsoo-, haridus- või spordiasutus või äriregistris, Eesti spordiregistris, EHISes registreeritud juriidiline isik, kes võimaldab Luunja valla noortel tegeleda neid huvitavate huvialadega.",
          "@language": "et"
        },
        {
          "@value": "läbiviimise koht ei ole üheselt määratletud. Viiakse läbi huviringidena koolis, noortekeskustes, noorteühingute, seltsimajade, kultuurimajade, raamatukogude juures ja mujal, kus toimub regulaarne ja süsteemne juhendamine vastavalt noorsootöö seaduses kirjeldatud definitsioonile ja noorsootöö põhimõtetele",
          "@language": "et"
        },
        {
          "@value": "lühiajaline juhendatud huvialaga tegelemine vaba tahte alusel tasemeõppest ja tööst vabal ajal teadmiste ja oskuste omandamiseks valitud huvialal",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "27",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_tugitegevus"
        }
      ],
