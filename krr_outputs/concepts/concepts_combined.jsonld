        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "suletav ala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Tallinna linna omandis olev avalikult kasutatav tee, teelõik, parkla või väljak, mille täielikku või osalist sulgemist sulgemisloa taotleja taotleb ja mis suletakse sulgemisloa alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047120_Par_2"
        }
      ],
      "estleg:sourceAct": "Teede ja tänavate ajutise sulgemise eeskiri",
