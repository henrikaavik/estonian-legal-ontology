      "skos:definition": {
        "@value": "toetuse liik, millega toetatakse juriidilist isikut, seltsingut või üksikisikut kindla eesmärgi saavutamisele suunatud, ajas ja ruumis piiritletud, enamasti ühekordset elluviidavat tegevust või tegevuste kogumit",
        "@language": "et"
