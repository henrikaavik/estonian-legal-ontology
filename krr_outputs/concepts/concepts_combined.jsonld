      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "madala temperatuuriga pind",
      "skos:definition": [
        {
          "@value": "sisekliima tagamisega ruumide netopind, mille kütmise seadeväärtus on oluliselt madalam kui energiatõhususe miinimumnõuete määruse lisas 1 sätestatud väärtus.",
          "@language": "et"
        },
        {
          "@value": "sisekliima tagamisega ruumide netopind, mille kütmise seadeväärtus on oluliselt madalam kui käesoleva määruse § 3 lõikes 3 nimetatud määruse lisas 1 sätestatud väärtus",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
