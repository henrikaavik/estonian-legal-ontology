    {
      "@id": "estleg:Concept_kanepi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044995_omapuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk kohtpuhasti on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti (edaspidi ie)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044995_Par_2"
        }
      ],
