      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1044617_kuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kanalisatsiooniehitiste, torustik välja arvatud, lubatud kõige väiksem kaugus hoonest, joogivee salv- või puurkaevust ning muuks kui joogiveeotstarbeks kasutatavast puurkaevust; 6) inimekvivalenti (edaspidi ka ie ) – ühe inimese poolt põhjustatud keskmise ööpäevase tingliku veereostuskoormuse ühik. Biokeemilise hapnikutarbe (BHT7) kaudu väljendatud ie väärtus on 60 grammi hapnikku ööpäevas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044617_Par_2"
        }
      ],
