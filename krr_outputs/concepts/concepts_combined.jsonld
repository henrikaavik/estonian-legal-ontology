      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_jaatmehoolduseeskiri_t1057045_jaatmekaitlusleping",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmekäitlusleping",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmevaldaja ja jäätmekäitleja või jäätmevedaja vahel sõlmitud leping, millega jäätmekäitleja või jäätmevedaja võtab endale jäätmete osalise või täieliku käitlemise kohustuse ning millega jäätmekäitleja muutub jäätmevaldajaks pärast seda, kui jäätmevaldaja on jäätmed üle andnud, kui leping ei näe ette teisiti; 8) ehitus- ja lammutusjäätmed – puidu, metalli, betooni, telliste, ehituskivide, klaasi ja muude ehitusmaterjalide jäätmed, sh need, mis sisaldavad asbesti ja teisi ohtlikke jäätmeid ning mittekasutatav äraveetav pinnas, mis tekib ehitamisel, remontimisel ja lammutamisel ning mida ehitusobjektil tööde tegemiseks ei kasutata",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057045_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla jäätmehoolduseeskiri",
