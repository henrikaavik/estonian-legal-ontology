      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_hiiumaa_valla_heakorra_eeskiri_t1044299_tiheasustusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tiheasustusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla üldplaneeringuga määratud ja hoonestatud tiheasustusala või kompaktse asustusega ala; 4) romusõiduk on sõiduk, millel puuduvad selle mehaanilised osad või kereosad või autoklaasid või rattad ja mis oma välimusega riivab asula esteetilist väljanägemist või rikub valla puhtust ja heakorda",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044299_Par_2"
        }
      ],
      "estleg:sourceAct": "Hiiumaa valla heakorra eeskiri",
