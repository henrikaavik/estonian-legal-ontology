          "@language": "et"
        },
        {
          "@value": "ametniku ja töötaja põhi- ja muutuvpalgale lisaks makstav täiendav tasu puuduva teenistuja ülesannete täitmise ning ületunnitöö ja riigipühadel töötamise eest",
          "@language": "et"
        },
        {
          "@value": "palgale või töötasule lisaks makstav täiendav tasu puuduva teenistuja ülesannete täitmise ning ületunnitöö, valveaja, öötöö ja riigipühadel töötamise eest",
          "@language": "et"
