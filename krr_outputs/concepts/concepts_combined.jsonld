      "rdfs:label": "tulemuspalk",
      "skos:altLabel": [
        {
          "@value": "Tulemuspalk",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "asutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu; 10",
          "@language": "et"
        },
        {
          "@value": "tasu igapäevaste teenistuskohajärgsete ülesannete (väga) hea täitmise eest teatud perioodil; 8",
          "@language": "et"
        },
        {
          "@value": "asutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu; 9",
          "@language": "et"
        },
        {
          "@value": "aasta töötulemuste hindamise alusel tööplaanis kavandatud ja kalendriaastaks kokkulepitud eesmärkide saavutamise ja ülesannete täitmise eest määratav ja makstav täiendav tasu.",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu; RT IV 2024-01-19 19 419012024019 2024-01-22 42 11",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "19",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_tulemustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tulemustasu",
