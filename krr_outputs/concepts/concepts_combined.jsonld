    {
      "@id": "estleg:Concept_tartu_vallavalitsuse_palgajuhend_t1041625_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Tartu vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o. töölepingu alusel töötav) töötaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041625_Par_2"
        }
      ],
      "estleg:sourceAct": "Tartu Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (tartu_vallavalitsuse_palgajuhend_t1041625)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tartu_vallavalitsuse_palgajuhend_t1041625_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avalikku võimu teostav, Tartu vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev isik. Ametnik nimetatakse ja vabastatakse teenistusest avaliku teenistuse seaduse alusel. Ametniku teenistuskohta nimetatakse ametikohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041625_Par_2"
        }
      ],
      "estleg:sourceAct": "Tartu Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (tartu_vallavalitsuse_palgajuhend_t1041625)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tartu_vallavalitsuse_palgajuhend_t1041625_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on võetud vallavalitsuse töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning tema teenistuskohta nimetatakse töökohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1041625_Par_2"
        }
      ],
      "estleg:sourceAct": "Tartu Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (tartu_vallavalitsuse_palgajuhend_t1041625)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tartu_vallavalitsuse_palgajuhend_t1041625_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametnikule tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest (lisatasu öötöö, riiklikel pühadel töötamise ja ületundide ning valveaja eest) ning asendustasust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
