      "rdfs:label": "ümberpaigutamine (ida_viru_maakonna_ettevotluse_ning_inimeste_tooalaste_oskust_t1049493)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_umberpaigutamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
