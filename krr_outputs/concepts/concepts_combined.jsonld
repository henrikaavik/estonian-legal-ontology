      "skos:definition": [
        {
          "@value": "tehniline lahendus, mida kasutatakse selleks, et parandada, säilitada või suurendada hooldusvajadusega inimese toimetulekut",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
