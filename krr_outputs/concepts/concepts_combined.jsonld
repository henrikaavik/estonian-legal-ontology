      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_kohtkaitlussusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kohtkäitlussüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rajatis reovee kogumiseks, st reovee kogumismahuti (sh kuivkäimla) või puhastamiseks, st omapuhasti (biopuhasti või septik koos puhastatud reovee suublasse juhtimisega)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054022_Par_2"
        }
      ],
      "estleg:sourceAct": "Saku valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "kohtkäitlussüsteem (saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kohtkaitlussusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_omapuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk kohtpuhasti on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid olmereoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti. Siia alla kuuluvad nii septikud kui biopuhastid koos puhastatud reovee suublasse juhtimisega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054022_Par_2"
        }
      ],
      "estleg:sourceAct": "Saku valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "omapuhasti (saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omapuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_purgimiskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimiskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "koht, mis on määratud kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas tekkekohast äraveetud reovee ühiskanalisatsiooni juhtimiseks; 10) purgimissõiduk (edaspidi sõiduk ) – nõuetekohane mahutiga sõiduk, mille abil tühjendatakse reovee kogumismahutit või omapuhastit ja veetakse reovesi purgimiskohta või vastavasse jäätmete käitlemise kohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054022_Par_2"
        }
      ],
      "estleg:sourceAct": "Saku valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "purgimiskoht (saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_purgimiskoht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_purgimisteenus",
      "@type": [
        "owl:NamedIndividual",
