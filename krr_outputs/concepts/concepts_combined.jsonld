          "@id": "estleg:Concept_rohelise_investeerimisskeemi_korterelamute_rekonstrueerimise_t345791_terviklahendus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "terviklahendus",
      "skos:definition": [
        {
          "@value": "korterelamu kompleksseks rekonstrueerimiseks ja energiatõhususe saavutamiseks teostatavate tööde kogum. Terviklahenduseks võib lugeda ka energiaaudiitori poolt koostatud energiaauditis toodud soovitusliku töödepaketi teostamist, kui valitud tööd tagavad hoone sisekliimat halvendamata vähemalt 20%-lise energiasäästu saavutamise kuni 2000 m 2 suletud netopinnaga korterelamus ja vähemalt 30%-lise energiasäästu saavutamise üle 2000 m 2 suletud netopinnaga korterelamus.",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_terviklik_rekonstrueerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "terviklik rekonstrueerimine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_vaikeelamute_energiatohususe_suurendamise_toetuse_kasutamise_t1049699_terviklik_rekonstrueerimine"
        },
        {
          "@id": "estleg:Concept_vaikeelamute_rekonstrueerimise_toetamine_t1058695_terviklik_rekonstrueerimine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "terviklik rekonstrueerimine",
      "skos:definition": [
        {
          "@value": "projekt, mille alusel ja kompleksselt § 7 lõikes 2 nimetatud nõuete kohaselt soojustatakse vähemalt kõik välisseinad ja katus, vahetatakse kõigi eluruumide aknad, rekonstrueeritakse küttesüsteem ja paigaldatakse soojustagastusega sissepuhke-väljatõmbe ventilatsioonisüsteem ning mille tulemusena saavutatakse vähemalt energiatõhususarvu klass C; 10",
          "@language": "et"
        },
        {
          "@value": "projekt, millega teostatakse kompleksselt § 6 lõikes 2 nimetatud nõuetele vastavalt vähemalt välisseinte ja katuse soojustamine, akende vahetamine, rekonstrueeritakse küttesüsteem ja paigaldatakse soojustagastusega sissepuhke-väljatõmbe ventilatsioonisüsteem; 5 5<sup>1</sup>) toetuse saaja – paragrahvi 1 lõikes 4 nimetatud juhul üldtingimuste määruse § 3 punktis 5 nimetatud lõppsaaja; RT I 2022-03-16 9 116032022009 2022-03-19 5 5<sup>2</sup>) toetuse tagasinõudmine – paragrahvi 1 lõikes 5 sätestatud juhul finantskorrektsioon struktuuritoetuse seaduse tähenduses; RT I 2022-08-16 2 116082022002 2022-08-19 5 5<sup>3</sup>) toetatav kulu – paragrahvi 1 lõikes 5 sätestatud juhul struktuuritoetuse seaduse § 2 punktis 5 nimetatud abikõlblik kulu; RT I 2022-08-16 2 116082022002 2022-08-19 6",
          "@language": "et"
        }
      ]
    },
    {
