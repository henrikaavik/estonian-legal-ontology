        }
      ],
      "estleg:sourceAct": "Detailplaneeringukohaste ja planeeringulahenduse elluviimiseks otseselt vajalike ning sellega funktsionaalselt seotud ehitiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kord",
      "rdfs:label": "avalikult kasutatava taristu tasu (detailplaneeringukohaste_ja_planeeringulahenduse_elluviimise_t1055786)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalikult_kasutatava_taristu_tasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
