          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_aleviku",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Aleviku",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_joelahtme_valla_aleviku_ja_kulavanema_statuut_t1042477_Aleviku"
        },
