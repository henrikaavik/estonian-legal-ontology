      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "praktikant",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
