      },
      "skos:definition": {
        "@value": "ehitustegevus ja seadmete soetamine eesmärgiga vahetada või mitmekesistada ettevõtja kasutatavat energiaallikat või aidata energiat salvestada ja energia kvaliteeti parandada või liituda võrguga kaugkütteseaduse tähenduses",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056746_Par_4"
        }
      ],
