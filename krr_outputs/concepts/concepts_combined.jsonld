      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kuusalu_valla_reovee_kohtkaitlemise_ja_araveo_eeskiri_t1052145_septik",
