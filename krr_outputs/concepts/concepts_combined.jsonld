      }
    },
    {
      "@id": "estleg:Concept_laane_harju_valla_heakorraeeskiri_t1045685_haljasala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "haljasala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teadlikult kujundatud maastik, maastikuosa või hoonetevaheline välisruum, mida iseloomustab ümberkujundatud reljeef, valitud taimestik või vastavafunktsioonilised rajatised",
        "@language": "et"
      },
      "estleg:definedIn": [
