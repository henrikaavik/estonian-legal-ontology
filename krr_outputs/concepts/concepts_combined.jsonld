          "@value": "Tehingupartnerid",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tehingupartneri koodid, eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud raamatupidamisaruandeid; 28",
          "@language": "et"
        },
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tunnused (tehingupartneri koodid), eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud finantsaruandeid. 21 (",
          "@language": "et"
        },
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tunnused - tehingupartneri koodid eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud finantsaruandeid. 20 (",
          "@language": "et"
        },
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tunnused – tehingupartneri koodid (numbrite kombinatsioonid), mis võimaldavad koostada avaliku sektori üksuste finantsaruandeid.",
          "@language": "et"
        },
        {
          "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tunnused – tehingupartneri koodid -, eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideerituid finantsaruandeid.",
          "@language": "et"
        }
      ],
