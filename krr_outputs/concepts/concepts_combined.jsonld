      "estleg:definesConcept": {
        "@id": "estleg:Concept_vee_ettevotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_mulgi_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_k_t1056494_volitatud_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "volitatud isik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes volikogu otsusega on volitatud kontrollima kinnistu veevärgi ja kanalisatsiooni vastavust nõuetele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056494_Par_2"
        }
      ],
