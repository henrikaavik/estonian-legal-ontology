      },
      "rdfs:label": "Tee kaitsevöönd",
      "skos:altLabel": [
        {
          "@value": "tee kaitsevöönd",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kohaliku maantee kaitseks, teehoiu korraldamiseks, liiklusohutuse tagamiseks ja teelt lähtuvate ohtlike mõjude vähendamiseks teega külgnevatel maavaldustel väljaspool teemaad rajatud kaitsevöönd ulatusega kakskümmend (20) meetrit kummalegi poole sõiduraja teljest, mille piires kehtivad maaomanikele ja maakasutajatele erinõuded. Teed jagunevad olenevalt pealiskihist",
          "@language": "et"
        },
        {
          "@value": "tee kaitseks, teehoiu korraldamiseks, liiklusohutuse tagamiseks ning teelt lähtuvate keskkonnakahjustuste ja inimestele ohtlike mõjude vähendamiseks tee äärte rajatud kaitsevöönd.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
