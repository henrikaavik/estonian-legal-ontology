        "@language": "et"
      },
      "skos:definition": {
        "@value": "olemasolev või üldplaneeringuga kavandatud selgelt piiritletav kompaktse asustusega territooriumi osa; 2) puu/üksikpuu – kasvav puu, mille rinnasdiameeter on vähemalt 15 sentimeetrit ning puul on selgelt nähtav(ad) või määratav(ad) tüvi ja võra",
        "@language": "et"
      },
