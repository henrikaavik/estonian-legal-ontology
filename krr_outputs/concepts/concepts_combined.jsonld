          "@value": "laager",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "huvikooli või huviringi poolt korraldatud eesmärgistatud ühistegevus, mille jooksul tegeletakse intensiivselt huviõppega. Huvitegevuseks ei loeta lühiajalisi kursusi ja tervisesporti. Toetus käesoleva korra mõistes on valla eelarvest eraldatavad rahalised vahendid õppuri huvihariduse või -tegevuse toetamiseks.",
          "@language": "et"
        },
        {
          "@value": "huvitegevuse läbiviija poolt korraldatud eesmärgistatud ühistegevus, mille jooksul tegeletakse intensiivselt huvihariduse või huvitegevusega.",
          "@language": "et"
        },
        {
          "@value": "tervistav ja arendav puhkuse veetmise vorm 7-19 aastastele õpilasele",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
