    {
      "@id": "estleg:Concept_luganuse_valla_infoturbepoliitika_t1047031_puudused_infotehnoloogias",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puudused infotehnoloogias",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "süsteemide või seadmete tõrked (näiteks serveririke või võrguühenduse katkestus), seadmete paigutus, süsteemide jõudlus või ülepingutatud turvameetmed; 3) puudused inimeste töös − vead, mida inimesed teevad turvanõuete järgimisel (näiteks antakse edasi ligipääsuõigusi või taotletakse tarbetuid ligipääsuõigusi, ei järgita töö- ja eraasjade lahususe põhimõtet)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047031_Par_6"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla infoturbepoliitika",
      "rdfs:label": "puudused infotehnoloogias (luganuse_valla_infoturbepoliitika_t1047031)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_puudused_infotehnoloogias"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_infoturbepoliitika_t1047031_puudused_tookorralduses",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puudused töökorralduses",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juhtumid, kus järgitakse turvanõuete täitmise reegleid puudulikult või ei täideta neid, kasutusjuhendid või süsteemikirjeldused on ebaselged või puuduvad, süsteemile juurdepääsu reguleerimise vahend ehk parool on nõrk või ebapiisav või arvutisse on paigaldatud volitamata tarkvara; 5) turvaründed; nõrkus – infovara omadus, mis laseb ohul realiseeruda; risk – tõenäosus, et oht kasutab ära nõrkuse ja tekitab infovarale kahju; jääkrisk – risk, mida on mõistlik aktsepteerida; turvaintsident – mistahes kõrvalekalle infosüsteemi normaalse talitluse reeglitest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047031_Par_6"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla infoturbepoliitika",
      "rdfs:label": "puudused töökorralduses (luganuse_valla_infoturbepoliitika_t1047031)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_puudused_tookorralduses"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
