          "@id": "estleg:Concept_laane_nigula_valla_teehoiu_eeskiri_t1061479_Tee_kaitsevoond"
        },
        {
          "@id": "estleg:Concept_laaneranna_valla_teede_kasutamise_ja_kaitse_eeskiri_t1060660_Tee_kaitsevoond"
        },
        {
          "@id": "estleg:Concept_teede_valla_omandisse_votmise_ja_avalikuks_kasutamiseks_maar_t1004736_Tee_kaitsevoond"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Tee kaitsevöönd",
      "skos:altLabel": [
        {
          "@value": "tee kaitsevöönd",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "avalikult kasutatava tee kaitsevöönd on teed ümbritsev maa-ala, mis tagab tee kaitse, teehoiu korraldamise, liiklusohutuse ning vähendab teelt lähtuvaid keskkonnakahjulikke ja inimestele ohtlikke mõjusid. Teel on kaitsevöönd, kui tee on avalikult kasutatav. Tee kaitsevööndi laius sõidutee teljest mõlemale poole on 10 meetrit. 7 (",
          "@language": "et"
        },
        {
          "@value": "avalikult kasutatava tee kaitsevöönd on teed ümbritsev maa-ala, mis tagab tee kaitse, teehoiu korraldamise, liiklusohutuse ning vähendab teelt lähtuvaid keskkonnakahjulikke ja inimestele ohtlikke mõjusid. Teel on kaitsevöönd, kui tee on avalikult kasutatav. Tee kaitsevööndi laius äärmise sõiduraja servast mõlemale poole on 20 meetrit. Tänavate kaitsevööndi laius äärmise sõiduraja servast mõlemale poole on 10 meetrit. 7 (",
          "@language": "et"
        },
        {
          "@value": "kohaliku maantee kaitseks, teehoiu korraldamiseks, liiklusohutuse tagamiseks ja teelt lähtuvate ohtlike mõjude vähendamiseks teega külgnevatel maavaldustel väljaspool teemaad rajatud kaitsevöönd ulatusega kakskümmend (",
          "@language": "et"
        },
        {
          "@value": "tee kaitseks, teehoiu korraldamiseks, liiklusohutuse tagamiseks ning teelt lähtuvate keskkonnakahjustuste ja inimestele ohtlike mõjude vähendamiseks tee äärte rajatud kaitsevöönd.",
          "@language": "et"
        }
      ]
    },
