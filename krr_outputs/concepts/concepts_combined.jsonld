      },
      "skos:definition": {
        "@value": "koht, kus kaupleja vahetult pakub ja müüb kaupa või pakub ja osutab teenust. Üks müügikoht käesoleva korra mõistes on suuruses 3 m 2",
        "@language": "et"
      },
