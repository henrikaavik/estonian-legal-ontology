      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_puhastusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "puhastusala",
      "skos:definition": "tiheasustusega alal kinnistuga külgnev haljasala või muu ala kuni kõnni- või sõiduteeni; 19",
