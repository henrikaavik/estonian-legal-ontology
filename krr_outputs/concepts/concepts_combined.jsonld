        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "LRK pearaamatupidaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "raamatupidaja, kes tagab LRK raamatupidamise ning raamatupidamisaruannete koostamise ja esitamise õigustatud isikutele. LRK pearaamatupidaja ülesandeid täidab § 3 lõike 1 punktis 18 nimetatud linna raamatupidamiskeskuse koosseisus töötav juhtivraamatupidaja; 2020-02-19",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013515_Par_3"
        }
      ],
