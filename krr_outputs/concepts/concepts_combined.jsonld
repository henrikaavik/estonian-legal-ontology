          "@id": "estleg:Concept_turi_valla_raamatupidamise_sise_eeskiri_t1044080_majandustehingute_kirjendaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "majandustehingute kirjendaja",
      "skos:definition": [
        {
          "@value": "töötaja, kes lähtudes heast raamatupidamistavast, kirjendab valla majandustehingud raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on majandustehingute kirjendajaks raamatupidaja",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse teenistuja, kes lähtudes Eesti finantsaruandluse standardist kirjendab valla majandustehingud raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on majandustehingute kirjendajaks raamatupidaja",
          "@language": "et"
        },
        {
          "@value": "teenistuja/töötaja, kes lähtuvalt finantsaruandluse standardist kirjendab majandustehinguid raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on kirjendajaks raamatupidaja",
          "@language": "et"
        },
        {
          "@value": "töötaja, kes lähtub Eesti finantsaruandluse standardist ja kirjendab raamatupidamises linna majandustehinguid nõuetekohases liigenduses. Üldjuhul on majandustehingute kirjendajaks raamatupidaja; 2020-02-19",
          "@language": "et"
        },
        {
          "@value": "töötaja, kes lähtudes finantsaruandluse standardist kirjendab valla majandustehingud raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on majandustehingute kirjendajaks finantsosakonna töötajad.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
