      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421_reklaampind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaampind",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Tõrva valla haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048421_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaami paigaldamise kord ja reklaamimaks",
      "rdfs:label": "reklaampind (reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaampind"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421_valireklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "välireklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avalikus kohas asuv või avalikust kohast jälgitav reklaam, mis asub ehitisel või ehitise siseruumides avalikkusele suunatult või eraomandis oleval kinnistul, ehitisel või selle siseruumides avalikkusele suunatult või mobiilse konstruktsiooni vahendusel avalikkusele suunatult",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048421_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaami paigaldamise kord ja reklaamimaks",
      "rdfs:label": "välireklaam (reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valireklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaami_paigaldamise_kord_ja_reklaamimaks_t1048421_reklaamikandja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaamikandja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaami paigaldamiseks kasutatav alus, seadeldis (seinapannoo, konsool, transparendid jms), mis paigaldatakse hoonetele ja rajatistele ning konstruktsioon (reklaamipost, -tahvel, treiler jms), mis paigaldatakse maapinnale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048421_Par_2"
        }
      ],
      "estleg:sourceAct": "Reklaami paigaldamise kord ja reklaamimaks",
