        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töövõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "äriregistrisse kantud majandustegevuses osalev isik, kes on esitanud vähemalt ühe majandusaasta aruande, millest nähtub, et tema põhitegevusala on seotud asjaomase teenuse osutamisega. Kui töövõtja teeb õigusaktides määratletud eritöid, peab ta olema kantud majandustegevuse registrisse või peab tal olema asjaomane tegevusluba.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061194_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule kriisivalmidustoetuste andmise kord",
      "rdfs:label": "töövõtja (korteriuhistule_kriisivalmidustoetuste_andmise_kord_t1061194)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_toovotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_heitevaba_kutteviis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heitevaba kütteviis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "maapinnas või õhus sisalduvast energiast küttesoojust tootev soojuspumbasüsteem, millega toodetud soojust jaotatakse hoones vedeliksoojuskandjaga keskse küttesüsteemi kaudu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
