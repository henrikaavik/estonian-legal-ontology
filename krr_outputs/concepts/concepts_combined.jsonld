      "estleg:definesConcept": {
        "@id": "estleg:Concept_ohuala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_paastesundmusel_osalevate_riigi_ja_kohaliku_omavalitsuse_asu_t1000524_turvaala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "turvaala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ala, kus viibiv inimene evakueeritakse või antakse korraldus varjumiseks ning kuhu lubatakse ainult päästetööga otseselt seotud inimesed ja päästetöö juhi lubatud inimesed ja tehnika",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000524_Par_13"
        }
      ],
