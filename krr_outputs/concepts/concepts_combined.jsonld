      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu kasutaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidilisest või füüsilisest isikust kinnisasja omanik, hoonestusõiguse omanik või korteriühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorra nõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048851_Par_2"
        }
      ],
