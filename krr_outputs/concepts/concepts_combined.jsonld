          "@value": "korduskasutus jäätmeseaduse mõistes, sealhulgas vastuvõtupunktidesse, turustajatele, ringlussevõtjatele või tootjatele tagastatud toote jätkuv kasutamine, samuti toote korduskasutus pärast ümbertöötamist; 9",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_korduskasutuspakend",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
