    {
      "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809_Liitumisavaldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Liitumisavaldus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tarbimiskoha ühisveevärgi ja -kanalisatsiooni omaniku kirjaliku avalduse alusel tehakse liitumisettepanek, millega soovitakse ühisveevärgi ja -kanalisatsiooniga liituda.",
        "@language": "et"
      },
      "estleg:definedIn": [
