      },
      "rdfs:label": "ühine ehitusplats",
      "skos:definition": [
        {
          "@value": "ehitusplats, kus töötavad samal ajal või järjestikku kahe või enama tööandja töötajad või teenuse osutamise lepingu alusel töötavad füüsilised isikud (edaspidi teenuseosutaja )",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
