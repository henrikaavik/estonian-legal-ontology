        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huviharidus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "omandatakse Eesti Hariduse Infosüsteemis registreeritud huvikoolis õppekavapõhise õppena vastavalt huvikooli seadusele ja selle alusel kehtestatud huviharidusstandardile",
        "@language": "et"
      },
