    {
      "@id": "estleg:Concept_detailplaneeringukohaste_rajatiste_valjaehitamine_ja_valjaeh_t1055750_Kaesoleva_maarusega_nahakse_ette_detailplaneeringust_huvitatud_isiku_ja_Viru",
