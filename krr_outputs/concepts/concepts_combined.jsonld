      },
      "rdfs:label": "liitumine",
      "skos:altLabel": [
        {
          "@value": "Liitumine",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kinnistu veevärgi torustiku ühendamine ühisveevärgi torustikuga või kinnistu kanalisatsiooni ühendamine ühiskanalisatsiooni torustikuga veevarustuse või reovee ärajuhtimise teenuste kasutamiseks; 15",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärgi ühendamine ühisveevärgiga või kinnistu kanalisatsiooni ühendamine ühiskanalisatsiooniga veevarustuse või reo- ning sademevee ärajuhtimise teenuste edaspidiseks kasutamiseks; 14",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärgi ühendamine ühisveevärgiga või kinnistu kanalisatsiooni ühendamine ühiskanalisatsiooniga veevarustuse või reo- ning sademevee ärajuhtimise teenuste edaspidiseks kasutamiseks; 9",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärgi torustiku ühendamine ühisveevärgi torustikuga või kinnistu kanalisatsiooni ühendamine ühiskanalisatsiooni torustikuga veevarustuse või reovee ärajuhtimise teenuste kasutamiseks; 16",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärgi ühendamine ühisveevärgiga või kinnistu kanalisatsiooni ühendamine ühiskanalisatsiooniga veevarustuse või reo- ning sademevee ärajuhtimise teenuste edaspidiseks kasutamiseks; 7",
          "@language": "et"
        }
      ],
