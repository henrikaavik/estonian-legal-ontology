      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "täiendav toetus",
      "skos:definition": [
        {
          "@value": "Viimsi valla haldusterritooriumil asuva eralasteaia või eralastehoiu teenuse osutajatele makstav toetus investeeringu, üürikulude või amortisatsioonikulude katteks.",
          "@language": "et"
        }
      ],
