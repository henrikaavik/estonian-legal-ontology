    {
      "@id": "estleg:Concept_joelahtme_valla_ehitusmaarus_t1027827_krundi_hoonestusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "krundi hoonestusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "krundi osa, kuhu võib rajada detailplaneeringus määratud ehitusõigusega lubatud hooneid ja rajatisi. Krundi ehitusõiguse hulka kuni 20 m 2 ehitisealuse pinnaga väikeehitisi üldjuhul ei arvestata va juhul, kui detailplaneeringus või ehitise arhitektuursed ja ehituslikud lisatingimused ei ole määranud teisiti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1027827_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla ehitusmäärus",
      "rdfs:label": "krundi hoonestusala (joelahtme_valla_ehitusmaarus_t1027827)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_krundi_hoonestusala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_ehitusmaarus_t1027827_krundi_taisehitusprotsent",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "krundi täisehitusprotsent",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hoonete ja rajatiste aluse pindala suhe krundi pindalasse. Krundi täisehitusprotsendi leidmisel ei võeta arvesse teede ja platside alust pindala",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1027827_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla ehitusmäärus",
      "rdfs:label": "krundi täisehitusprotsent (joelahtme_valla_ehitusmaarus_t1027827)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_krundi_taisehitusprotsent"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_joelahtme_valla_ehitusmaarus_t1027827_krundi_haljastusprotsent",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "krundi haljastusprotsent",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "krundil aastaringselt kasvava haljastuse aluse pindala suhe krundi pindalasse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1027827_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla ehitusmäärus",
