        "@id": "estleg:Concept_heakorratoo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kanepi_valla_heakorraeeskiri_t1043205_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi, hoonestusõigus, korteriomand ja korterihoonestusõigus. Kinnistuga on eeskirjas võrdsustatud ka kinnistamata maaüksus, mille suhtes isikul on kasutusõigus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043205_Par_2"
        }
      ],
