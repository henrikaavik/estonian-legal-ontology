      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "pakendijäätmed",
      "skos:definition": [
        {
          "@value": "mis tahes pakend või pakendimaterjal, mis muutub pärast pakendi kasutamist jäätmeteks; 17",
          "@language": "et"
        },
        {
          "@value": "mis tahes pakend või pakendimaterjal, mis muutub pärast pakendi kasutamist jäätmeteks; 24",
          "@language": "et"
        },
        {
          "@value": "mistahes pakend või pakendimaterjal, mis muutub pärast pakendi kasutamist jäätmeteks käesoleva eeskirja § 2 lg 2 p.5 mõistes. Pakendijäätmeteks ei loeta pakendi ja pakendimaterjali tootmisel tekkinud jääke; 25",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_pakendijaatmete_kogumissusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
