        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rikkumine",
      "skos:definition": [
        {
          "@value": "rikkumiseks loetakse näiteks nõuetele mitte vastava kohtkäitlussüsteemi kasutamist või puhastamata reovee keskkonda juhtimist",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_pakkumine"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
