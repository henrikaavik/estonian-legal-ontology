      "rdfs:label": "kohtkäitlus",
      "skos:definition": [
        {
          "@value": "reovee kogumine, puhastamine, pinnasesse immutamine, suublasse juhtimine või taaskasutamine, sealhulgas kompostimine, üldjuhul reovee tekkekoha kinnistu piires",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine kogumismahutisse või puhastamine omapuhastis (sh heitvee suublasse juhtimine) ja kuivkäimla sisu käitlemine üldjuhul reovee tekkekoha kinnistu piires",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine, puhastamine, pinnasesse immutamine, suublasse juhtimine või taaskasutamine tekkekoha kinnistu piires, sealhulgas käimlajäätmete kogumine, kompostimine või taaskasutamine nende tekkekoha kinnistu piires",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine, puhastamine, pinnasesse immutamine, suublasse juhtimine või taaskasutamine, sh kompostimine, üldjuhul reovee tekkekoha kinnistu piires",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine, puhastamine, pinnassesse immutamine, suublasse juhtimine või taaskasutamine, sealhulgas kompostimine, üldjuhul reovee tekkekoha kinnistu piires",
          "@language": "et"
        }
      ],
