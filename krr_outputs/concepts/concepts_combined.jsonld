        {
          "@value": "elektriauto aku laadimise seade, mis asub kohaliku omavalitsuse üksuse kasutuses oleval maatükil mitte kaugemal kui 300 meetrit toimiva korteriühistuga kortermajast ja millele on avalik juurdepääs",
          "@language": "et"
        }
      ],
