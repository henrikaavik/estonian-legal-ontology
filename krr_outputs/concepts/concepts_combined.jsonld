    {
      "@id": "estleg:Concept_kinnistu_kasutaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu kasutaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_heakorra_eeskiri_t1023768_kinnistu_kasutaja"
        },
        {
          "@id": "estleg:Concept_heakorraeeskirja_ja_koormise_kehtestamine_t1050932_kinnistu_kasutaja"
        },
        {
          "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_kinnistu_kasutaja"
        },
        {
          "@id": "estleg:Concept_saaremaa_valla_heakorra_eeskiri_t1048851_kinnistu_kasutaja"
        },
        {
          "@id": "estleg:Concept_heakorraeeskiri_ja_koormise_kehtestamine_t1012077_kinnistu_kasutaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kinnistu kasutaja",
      "skos:definition": [
        {
          "@value": "juriidiline või füüsiline isik, kelle omandis või valduses on kinnisasi, sh kinnistu omanik, hoonestusõiguse omanik või korteriühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorra nõuete täitmine tuleneb omaniku ja muu isiku vahelisest kasutuskokkuleppest; 5",
          "@language": "et"
        },
        {
          "@value": "juriidilisest või füüsilisest isikust kinnisasja omanik, hoonestusõiguse omanik või korteriühistu olemasolu korral ühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorra nõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest; 3",
          "@language": "et"
        },
        {
          "@value": "juriidilisest või füüsilisest isikust kinnisasja omanik, hoonestusõiguse omanik või korteriühistu olemasolu korral ühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorra nõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest; 4",
          "@language": "et"
        },
        {
          "@value": "juriidilisest või füüsilisest isikust kinnisasja omanik, hoonestusõiguse omanik või korteriühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorra nõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest; 5",
          "@language": "et"
        },
        {
          "@value": "kinnisasja juriidilisest või füüsilisest isikust omanik, hoonestusõiguse omanik või korteriühistu olemasolu korral ühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorranõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest; 10",
          "@language": "et"
        }
      ]
    },
