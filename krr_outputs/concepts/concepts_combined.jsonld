        "@id": "estleg:Concept_heakorratoo"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_valla_heakorraeeskiri_t1044267_eriolukord",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eriolukord",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "erilistest ilmastikutingimustest (torm, tugevad sademed, üleujutus) tingitud valla heakorra ja/või teeolude halvenemine määral, mis nõuab erimeetmete rakendamist",
        "@language": "et"
      },
      "estleg:definedIn": [
