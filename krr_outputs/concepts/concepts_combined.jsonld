        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tootearenduskeskus",
      "skos:definition": [
        {
          "@value": "keskus, mille põhitegevus on tootearendusteenuste, sealhulgas nõustamis-, info- ja koolituseteenus ning seadmete ühiskasutus, osutamine ettevõtjatele piirkonna seisukohast olulises ja perspektiivses tootearendusvaldkonnas ettevõtete toodangu lisandväärtuse kasvu tagamiseks; 15",
          "@language": "et"
        }
      ]
    },
