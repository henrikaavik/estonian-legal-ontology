      "estleg:definesConcept": {
        "@id": "estleg:Concept_palk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_voru_vallavalitsuse_palgajuhend_t1040989_tootasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasust, mida ametiasutus maksab töötajale või töölisele tehtud töö eest vastavalt töölepingule, õigusaktidele ja tööandja poolt kehtestatud korrale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040989_Par_2"
        }
      ],
      "estleg:sourceAct": "Võru Vallavalitsuse palgajuhend",
      "rdfs:label": "töötasu (voru_vallavalitsuse_palgajuhend_t1040989)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_voru_vallavalitsuse_palgajuhend_t1040989_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhipalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal",
        "@language": "et"
      },
      "estleg:definedIn": [
