      "rdfs:label": "jäätmekäitlus",
      "skos:definition": [
        {
          "@value": "jäätmete kogumine, vedamine, taaskasutamine ja kõrvaldamine, sealhulgas vahendaja või edasimüüja tegevus",
          "@language": "et"
        },
        {
          "@value": "jäätmete kogumine, vedamine, taaskasutamine, sealhulgas sortimine ja kõrvaldamine, sealhulgas vahendamine või edasimüümine",
          "@language": "et"
        }
