      "rdfs:label": "projektitoetus",
      "skos:definition": [
        {
          "@value": "toetuse liik, millega toetatakse isikut kindla eesmärgi saavutamisele suunatud, ajas ja ruumis piiritletud, enamasti ühekordset elluviidavat tegevust või tegevuste kogumit",
          "@language": "et"
        },
        {
          "@value": "toetuse liik, millega toetatakse juriidilist isikut, seltsingut või üksikisikut kindla eesmärgi saavutamisele suunatud, ajas ja ruumis piiritletud, enamasti ühekordset elluviidavat tegevust või tegevuste kogumit",
          "@language": "et"
        },
        {
          "@value": "valla eelarvest lepinguga eraldatav sihtotstarbeline toetus, millega toetatakse kindlal ajavahemikul mingi eesmärgi või tulemuse saavutamist",
          "@language": "et"
        }
