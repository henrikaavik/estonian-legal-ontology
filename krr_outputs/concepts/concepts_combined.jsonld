      "rdfs:label": "lokaalne taastuvenergia",
      "skos:definition": [
        {
          "@value": "ehitusseadustiku § 65 lõike 3 alusel kehtestatud nõuetele vastav energia, mida kasutatakse eelkõige hoone toimimiseks või kasutamiseks",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 65 lõike 3 alusel kehtestatud nõuetele vastav energia, mida kasutatakse eelkõige hoone toimimiseks või kasutamiseks; muinsus- ja miljööväärtuslik korterelamu – üld- või detailplaneeringu alusel miljööväärtuslikule hoonestusalale jääv, väärtusliku üksikobjektina määratletud, kultuurimälestiseks tunnistatud, muinsuskaitsealal asuv või UNESCO maailmapärandi nimekirja kantud alal asuv korterelamu",
          "@language": "et"
        },
        {
          "@value": "hoones, kinnistul või hoone lähiümbruses päikese-, välisõhu-, vee-, pinnase- või tuuleenergiast toodetud elekter või soojusenergia. Soojuspumbal võetakse arvesse soojustegurit",
          "@language": "et"
        },
        {
          "@value": "hoones, kinnistul või hoone lähiümbruses päikese-, välisõhu-, vee-, pinnase- või tuuleenergiast toodetud elekter või soojusenergia",
          "@language": "et"
        }
      ],
