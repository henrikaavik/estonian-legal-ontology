          "@id": "estleg:Concept_soojus_ja_elektrienergia_tohusa_koostootmise_nouded_t1036997_koostoodetud_elektrienergia"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "koostoodetud elektrienergia",
      "skos:definition": [
        {
          "@value": "kasuliku soojuse tootmisprotsessis toodetud elektrienergia, mis on mõõdetud generaatori väljundklemmidel; 6",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_koostootmine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "koostootmine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_biomassist_elektrienergia_koostootmise_juhis_t345646_koostootmine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "koostootmine",
      "skos:definition": [
        {
          "@value": "ühes protsessis samaaegne soojus- ja elektrienergia tootmine. Koostootmisseade võib üheaegselt töötada nii koostootmis- kui ka kondensatsioonirežiimil; 9",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_koostootmisreziim",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
