      },
      "rdfs:label": "rehabilitatsiooniplaan",
      "skos:definition": [
        {
          "@value": "rehabilitatsiooniasutuses isiku või tema seadusliku esindaja aktiivsel",
          "@language": "et"
        },
        {
          "@value": "õigustatud isiku ja tema seadusliku esindaja osalemisel rehabilitatsioonimeeskonna koostatud dokument, milles kajastub hinnang isiku tegevusvõimele, sotsiaalse või tööalase rehabilitatsiooni eesmärk, eesmärgi saavutamiseks vajalikud rehabiliteerivad teenused ja hinnang rehabilitatsiooni eesmärgi saavutamise kohta. Programmipõhise rehabilitatsiooni alusel teenust saava isiku põhjal loetakse rehabilitatsiooniprogramm samaks rehabilitatsiooniplaaniga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
