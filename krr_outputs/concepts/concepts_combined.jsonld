    {
      "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_pauguti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "pauguti",
      "skos:definition": "teravaid kilde mitteandvasse mittemetallist kesta paigutatud pürotehniline toode, mis laengu süttimisel tekitab peamiselt pauguga heliefekti; 17",
