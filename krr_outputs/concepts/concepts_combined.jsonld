      "estleg:definitionCount": {
        "@value": "44",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tiheasustusala",
      "skos:definition": [
        {
          "@value": "üldplaneeringus määratud ala joonistel märgitud piirides",
          "@language": "et"
        },
        {
          "@value": "alevi ja küla selgelt piiritletav kompaktse asustusega ala.",
          "@language": "et"
        },
        {
          "@value": "valla üldplaneeringuga määratud ja hoonestatud tiheasustusala või kompaktse asustusega ala; 2) puu/üksikpuu – kasvav puu, mille rinnasdiameeter on vähemalt 12 sentimeetrit ning puul on selgelt nähtav või määratav tüvi ja võra; 3) raie– puu likvideerimine",
          "@language": "et"
        },
        {
          "@value": "aleviku ja/või küla selgelt piiritletava hoonestusega olemasolev või planeeritav territooriumi osa",
          "@language": "et"
        },
        {
          "@value": "alevis, alevikus ja külas selgelt piiritletav kompaktse asustuse ja hoonestusega ala",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "38",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:altLabel": [
        {
          "@value": "tiheasustusalad",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tiheasustusala_ja_hajaasustusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tiheasustusala ja hajaasustusala",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kiili_valla_jaatmehoolduseeskiri_t1059124_tiheasustusala_ja_hajaasustusala"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tiheasustusala ja hajaasustusala",
      "skos:definition": [
        {
          "@value": "on valla üldplaneeringuga määratud valla territooriumi osad. Tiheasustusala hulka kuulub lisaks ka Mõisaküla tänava, Väljamäe tee, Väljamäe põik ja Kanuti tänava järgi adresseeritud katastriüksused; 10) kogumispunkt on üldkasutatavas kohas paiknev vastavalt märgistatud jäätmete kogumismahuti või mahutid või jäätmete kogumisringi peatuskoht, kuhu saab viia liigiti kogutud jäätmeid. Käesoleva paragrahvi lõikes 1 nimetamata mõiste kasutamisel lähtutakse jäätmeseaduses, pakendiseaduses ja teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest. Elamu ja mitteelamu määratlemisel lähtutakse Majandus- ja taristuministri 02.06.2015 määruse nr 51 „Ehitise kasutamise otstarvete loetelu“ lisas sätestatust.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tiheasustusega_ala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tiheasustusega ala",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_peipsiaare_valla_heakorra_eeskiri_t1044621_tiheasustusega_ala"
        },
        {
          "@id": "estleg:Concept_heakorraeeskirja_ja_koormise_kehtestamine_t1043374_tiheasustusega_ala"
        },
        {
          "@id": "estleg:Concept_vaike_maarja_valla_heakorraeeskiri_t1046087_tiheasustusega_ala"
        },
        {
          "@id": "estleg:Concept_heakorra_ja_kaevetoode_eeskiri_t1044811_tiheasustusega_ala"
        },
        {
          "@id": "estleg:Concept_topo_geodeetilisele_uuringule_ja_teostusmoodistamisele_esita_t1034509_tiheasustusega_ala"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tiheasustusega ala",
      "skos:definition": [
        {
          "@value": "selgelt piiritletav kompaktse asustusega territooriumi osa",
          "@language": "et"
        },
        {
          "@value": "ala, kus on tänavavõrk ja tänavate ääres paiknevad kas elamumaa, ärimaa, tootmismaa või ühiskondlike ehitiste maa sihtotstarbega katastriüksused. Käesolevas määruses kasutatakse geodeetilise võrgu ja mõõdistamise metoodikaga seonduvaid termineid järgmises tähenduses:",
          "@language": "et"
        },
        {
          "@value": "selgelt piiritletav kompaktse asustusega territooriumi osa (eeskirja lisa 1)",
          "@language": "et"
        },
        {
          "@value": "valla üldplaneeringus määratud kompaktse hoonestusega ala joonistel märgitud piirides",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tiitlivoistlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tiitlivõistlus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kohila_valla_sporditegevuse_toetamise_kord_t1054494_tiitlivoistlus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tiitlivõistlus",
      "skos:definition": [
        {
          "@value": "üleriigilisel tasemel toimuv spordivõistlus, mida korraldab vastava spordiala alaliit või muu organisatsioon.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tippspetsialist",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tippspetsialist",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_toetuse_t1056629_tippspetsialist"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tippspetsialist",
      "skos:definition": [
        {
          "@value": "kõrge kvalifikatsiooniga era-, avaliku- või kolmanda sektori töötaja, kellel on kõrgharidus ning täidetud vähemalt üks järgnevatest tingimustest: vähemalt 5-aastane teadus- või arendustegevuse või innovatsiooni alane töökogemus; või ta on taotluse esitamise hetkest viimasel järjestikusel kolmel aastal olnud taotlusega seotud valdkonnas tegutseva ühe ja sama vähemalt 3-aastase juriidilise isiku osanik või juhtimis- või kontrollorgani liige tulumaksuseaduse § 9 tähenduses, kelle iga-aastastes majandusaasta aruannetes peab olema kajastatud kaupade või teenuste müük; või ta on rahvusvaheliselt tunnustatud ekspert.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toatemperatuuriga_pind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toatemperatuuriga pind",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_hoone_energiatohususe_arvutamise_metoodika_t1029856_toatemperatuuriga_pind"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toatemperatuuriga pind",
      "skos:definition": [
        {
          "@value": "sisekliima tagamisega ruumide suletud netopindade summa, millest on maha arvestatud madala temperatuuriga pind",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toetatav_kulu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toetatav kulu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_toetatav_kulu"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_energiasalvestuse_pilootp_t1055298_toetatav_kulu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toetatav kulu",
      "skos:definition": [
        {
          "@value": "projekti toetusest rahastatava tegevuse elluviimiseks vajalik ja mõistlik kulu, mis on tekkinud projekti abikõlblikkuse perioodil ning mille aluseks olevad tegevused on kooskõlas Eesti ja Euroopa Liidu õigusega; 14) väike- ja keskmise suurusega ettevõtja – ettevõtja, kes vastab üldise grupierandi määruse lisa I artiklis 2 sätestatud kriteeriumidele.",
          "@language": "et"
        },
        {
          "@value": "projekti toetusest rahastatava tegevuse elluviimiseks vajalik ja mõistlik kulu, sh toetus ja omafinantseering, mis on tekkinud abikõlblikkuse perioodil ning mille aluseks olevad tegevused on kooskõlas Eesti ja Euroopa Liidu õigusega, käesoleva määruse ning üldmääruse nõuetega",
          "@language": "et"
        }
      ],
