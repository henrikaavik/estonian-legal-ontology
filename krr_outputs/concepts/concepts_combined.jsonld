        },
        {
          "@id": "estleg:Concept_nouded_energiamargise_andmisele_ja_energiamargisele_t1029420_energiakandjate_kaalumistegurid"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiakandjate kaalumistegurid",
      "skos:definition": [
        {
          "@value": "tegurid, millega võetakse arvesse tarnitud energia tootmiseks vajalik primaarenergia kasutus ja selle keskkonnamõju",
          "@language": "et"
        },
        {
          "@value": "tegurid, millega võetakse arvesse tarnitud energia tootmiseks vajalik primaarenergia kasutus ja selle keskkonnamõju. Energiakandjate kaalumistegurite arvväärtused on sätestatud ehitusseadustiku § 65 lõike 3 alusel kehtestatud määruses hoone energiatõhususe miinimumnõuete kohta (edaspidi energiatõhususe miinimumnõuete määrus )",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
