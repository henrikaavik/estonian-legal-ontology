        "@language": "et"
      },
      "skos:definition": {
        "@value": "Keila Linnavalitsus. Reklaamina ei käsitata majandustegevuse kohas asuvat informatsiooni ja ekspositsiooni vastavalt reklaamiseaduses sätestatud korrale ega teavet, mis tuleb avalikustada seaduse alusel.",
        "@language": "et"
      },
