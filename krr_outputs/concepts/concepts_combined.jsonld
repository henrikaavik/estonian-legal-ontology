      "rdfs:label": "sissetulek",
      "skos:definition": [
        {
          "@value": "isiku või leibkonna mistahes liiki tulu, välja arvatud riigi ja kohaliku omavalitsuse vahenditest makstavad ühekordsed sotsiaaltoetused; 15",
          "@language": "et"
        },
        {
          "@value": "isiku või perekonna mistahes liiki tulu, välja arvatud riigi ja kohaliku omavalitsuse vahenditest makstavad ühekordsed sotsiaaltoetused; 9",
          "@language": "et"
        },
        {
          "@value": "kõik töised sissetulekud ja töist sissetulekut asendavad hüvitised, riikliku pensionikindlustuse seaduse alusel makstavad pensionid, puuetega inimeste sotsiaaltoetuste seaduse ja perehüvitiste seaduse alusel määratud toetused; 8",
          "@language": "et"
        }
      ],
