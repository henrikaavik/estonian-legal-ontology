      },
      "skos:definition": {
        "@value": "Linna majandustehingute kirjendamine, kasutades riigi õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid Linna juhtimisotsuste tegemiseks ning nõutava välise aruandluse tagamiseks",
        "@language": "et"
