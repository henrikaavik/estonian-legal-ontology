        "@id": "estleg:Concept_pohiprojekti_ekspertiis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetamine_t1053122_rekonstrueerimine",
      "@type": [
        "owl:NamedIndividual",
