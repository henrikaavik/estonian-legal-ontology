      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "innovatsioon",
      "skos:definition": "uute ideede ja teadmiste kasutamine uudsete lahenduste rakendamiseks, mis hõlmab toodete ja teenuste väljatöötamist ning uuendamist; 15",
