    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_kanalisatsiooniehitise_kuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kanalisatsiooniehitise kuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kanalisatsiooniehitise, välja arvatud torustik, kõige väiksem lubatud kaugus elamust ning majutus-, ravi-, spordi-, haridus-, kaubandus- ja teenindushoonest, samuti transpordihoonest, mis teenindab regulaarselt inimesi, ning salv- ja puurkaevust. Kanalisatsiooniehitise kuja ulatust arvestatakse kanalisatsiooniehitise hoone välisseinast või rajatise või seadme välispiirjoonest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
        }
      ],
