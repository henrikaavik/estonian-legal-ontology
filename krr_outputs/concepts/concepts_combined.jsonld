      ],
      "skos:prefLabel": {
        "@value": "klient",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistu omanik, hoonestusõiguse alusel maakasutaja või ehitise kui vallasasja omanik, kelle kinnistu või ehitise veevärk või kanalisatsioon on ühendatud ühisveevärgi ja -kanalisatsiooniga vajaliku torustikuühenduse kaudu ja kellega vee-ettevõtja on sõlminud liitumis- ja teenuslepingu ühisveevärgist vee võtmiseks ja/või reovee ärajuhtimiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
