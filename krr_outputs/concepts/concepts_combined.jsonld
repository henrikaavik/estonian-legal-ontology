        },
        {
          "@id": "estleg:Concept_vaikeelamute_rekonstrueerimise_toetamine_t1058695_taastuvenergia_tootmisseade"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "taastuvenergia tootmisseade",
      "skos:definition": [
        {
          "@value": "päikese abil soojust või elektrit tootev seade",
          "@language": "et"
        },
        {
          "@value": "päikese abil soojust või elektrit tootev seade; taotluste menetleja, maksete tegija ja järelevalve teostaja – paragrahvi 1 lõikes 5 sätestatud juhul struktuuritoetuse seaduse § 8 lõikes 1 nimetatud rakendusüksus",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
