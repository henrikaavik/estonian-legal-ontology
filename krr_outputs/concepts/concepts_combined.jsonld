          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetuse_andmise_tingimused_j_t1046780_pohiprojekti_ekspertiis"
        }
      ],
      "estleg:definitionCount": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "rdfs:label": "põhiprojekti ekspertiis",
      "skos:definition": [
        {
          "@value": "tegevus, mille käigus kontrollitakse ehitusprojekti kui tervikut või ehitusprojekti osa koosmõjus ehitusprojekti kui tervikuga ning vastavust põhiprojektile kehtestatud nõuetele, kusjuures ekspertiisi ei tehta § 13 lõikes 2 sätestatud juhul; 9",
          "@language": "et"
        },
        {
          "@value": "tegevus, mille käigus kontrollitakse ehitusprojekti kui tervikut või ehitusprojekti osa koosmõjus ehitusprojekti kui tervikuga ning vastavust põhiprojektile kehtestatud nõuetele; 10",
          "@language": "et"
        }
      ]
    },
