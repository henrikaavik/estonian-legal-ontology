      "rdfs:label": "pinnastee",
      "skos:definition": [
        {
          "@value": "tee, millel puudub pealiskiht ja mis on pikaajaliselt väljakujunenud liikumistee looduslikul pinnasel.",
          "@language": "et"
        },
        {
          "@value": "põllu-, metsa- või muu pealiskihita tee, mis on teeks rajatud või sõidukite liikumise tulemusena selliseks kujunenud",
          "@language": "et"
        },
        {
          "@value": "põllu-, metsa- või muu sellise pealiskihita tee, mis on teeks rajatud või sõidukite liikumise tulemusena selliseks kujunenud",
