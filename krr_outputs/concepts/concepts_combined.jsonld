        "@value": "kanalisatsiooniehitiste, välja arvatud torustik, lubatud vähim kaugus hoonest, joogivee salv- või puurkaevust ning muuks kui joogivee otstarbeks kasutatavast puurkaevust",
        "@language": "et"
      },
      "estleg:definedIn": [
