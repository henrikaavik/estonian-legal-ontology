      "rdfs:label": "volitatud töötleja",
      "skos:definition": [
        {
          "@value": "füüsiline või juriidiline isik või riigi- või kohaliku omavalitsuse asutus, kes töötleb isikuandmeid vastutava töötleja ülesandel haldusakti või lepingu alusel",
          "@language": "et"
        },
        {
          "@value": "on füüsiline või juriidiline isik, kes töötleb isikuandmeid vastutava töötleja nimel (nt hallatav kool, lasteaed, hooldekodu jt)",
          "@language": "et"
        },
        {
          "@value": "vallavalitsuse poolt volitatud veterinaararst.",
          "@language": "et"
        }
      ],
