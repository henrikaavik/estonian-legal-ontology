      "rdfs:label": "soojusettevõtja",
      "skos:definition": [
        {
          "@value": "ettevõtja, kes tegutseb vähemalt ühel tegevusalal, milleks on soojuse tootmine, jaotamine või müük ning vastutab nende tegevustega seonduvate kaubanduslike, tehniliste või hooldusküsimuste lahendamise eest",
          "@language": "et"
        },
        {
          "@value": "ettevõtja, kes tegutseb vähemalt ühel tegevusalal, milleks on soojuse tootmine, jaotamine või müük, ning vastutab nende tegevustega seonduvate kaubanduslike, tehniliste või hooldusküsimuste lahendamise eest",
          "@language": "et"
        },
        {
          "@value": "kaugkütteseaduse § 7 lõikes 3 sätestatud nõuetele vastavad soojuse tootja või ettevõtja, kes kasutab võrku soojuse jaotamiseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:altLabel": [
        {
          "@value": "soojusettevõtjad",
          "@language": "et"
        }
      ]
    },
    {
