    },
    {
      "@id": "estleg:Concept_laane_harju_valla_heakorraeeskiri_t1045685_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
