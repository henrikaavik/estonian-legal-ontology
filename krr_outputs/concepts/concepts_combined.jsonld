      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_reklaampind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaampind",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Tallinna linna haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
