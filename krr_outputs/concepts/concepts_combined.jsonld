      ],
      "skos:definition": [
        {
          "@value": "elatusvahenditeta isiku olukorrale vastavad hädavajalikud hoolekandelised abinõud, mis tagavad vähemalt toidu, riietuse ja ajutise peavarju; 4",
          "@language": "et"
        },
        {
          "@value": "on elatusvahendite kaotuse või puuduse tõttu sotsiaalselt abitusse olukorda sattunud isikule osutatav sotsiaalabi, mis tagab vähemalt toidu, riietuse ja ajutise majutuse. 5",
          "@language": "et"
        },
        {
          "@value": "on elatusvahenditeta isiku olukorrale vastavad hädavajalikud hoolekandelised abinõud, mis tagavad vähemalt toidu, riietuse ja ajutise peavarju. 6",
          "@language": "et"
