      "skos:definition": [
        {
          "@value": "ametnikule tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust; 5",
          "@language": "et"
        },
        {
          "@value": "ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu; 6",
          "@language": "et"
        },
        {
          "@value": "ametnikule makstav põhipalk, muutuvpalk, eritingimustes töötamise lisatasu ning asendustasu; 6",
          "@language": "et"
        },
        {
          "@value": "teenistuja põhipalk koos muutuvpalga ja lisatasudega; 4",
          "@language": "et"
        },
        {
          "@value": "teenistuja põhipalk koos muutuvpalga ja lisatasudega; 5",
          "@language": "et"
        }
