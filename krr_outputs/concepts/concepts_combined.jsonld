    },
    {
      "@id": "estleg:Concept_rouge_valla_huvihariduse_ja_tegevuse_toetamise_kord_t1052488_Toimetulekuraskuses_pere",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Toimetulekuraskuses pere",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "perekond, kus kasvab 7- kuni 19-aastane noor ning kelle taotluse esitamise eelneva kuu netosissetulek peale eluasemekulude mahaarvamist jääb alla 1.5-kordse riikliku toimetulekupiiri.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052488_Par_2"
        }
      ],
      "estleg:sourceAct": "Rõuge valla huvihariduse ja -tegevuse toetamise kord",
