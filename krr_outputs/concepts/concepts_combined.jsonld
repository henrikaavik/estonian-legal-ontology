    {
      "@id": "estleg:Concept_reklaamimaks_viljandis_t1002807_sotsiaalreklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sotsiaalreklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaam, mille eesmärk on saavutada hinnangute andmise kaudu inimese käitumine avalikes huvides ja milles teatud probleemile keskendudes ei pakuta kaubamärgipõhist, vaid üldist lahendit",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1002807_Par_4"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Viljandis",
      "rdfs:label": "sotsiaalreklaam (reklaamimaks_viljandis_t1002807)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_sotsiaalreklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_viljandis_t1002807_kampaaniareklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kampaaniareklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hoonele, rajatisele või mujale paigaldatud reklaam, mis teavitab hooajalistest sündmustest, aktsioonidest (kultuuri-, sotsiaal-, toote, valimisreklaam vms) ning mis paigaldatakse reklaamikampaania ajaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1002807_Par_4"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Viljandis",
      "rdfs:label": "kampaaniareklaam (reklaamimaks_viljandis_t1002807)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kampaaniareklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_viljandis_t1002807_kaubanduslik_teave",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaubanduslik teave",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "müügikohas antav kauba, teenuse või selle müügitingimuste kohta käiv kliendile suunatud teave; tegevuskoha tähistus kaupleja ärinime, kaubamärgi, domeeninime ning kliendile mõistetava tegevuskoha liigiga, tegevuskoha nime olemasolu korral ka tegevuskoha nimega; tegevuskohas teave kauplemisaja kohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1002807_Par_4"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Viljandis",
      "rdfs:label": "kaubanduslik teave (reklaamimaks_viljandis_t1002807)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kaubanduslik_teave"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_viljandis_t1002807_teabeviit",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teabeviit",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "objekti asukohta tähistav teave, mis võib sisaldada üksnes objekti nime ja objekti asukoha aadressi. Määruses ei käsitleta reklaamina ja reklaamimaksuga ei maksustata: 1) kaubanduslikku teavet, sealhulgas vaateakende ekspositsioone; 2) isiku majandus- või kutsetegevuses kasutatava sõiduki tähistust ühistranspordiseaduse tähenduses; 3) märgistust kauba müügipakendil pakendiseaduse tähenduses; 4) sponsorreklaamis avaldatud sponsori nime, kaubamärki ja teavet tema antud materiaalse toetuse kohta; 5) kaupade ja teenuste hinnakirja, mis on paigutatud ettevõtja tegevuskohta või tegevuskoha peasissekäigu juurde; 6) teabeviidal avalikustatud teavet objekti nime ja objekti asukoha aadressi kohta.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1002807_Par_4"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Viljandis",
      "rdfs:label": "teabeviit (reklaamimaks_viljandis_t1002807)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teabeviit"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
