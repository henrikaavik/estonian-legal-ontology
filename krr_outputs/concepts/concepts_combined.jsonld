      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tooturul_osalemist_toetavad_hoolekandeteenused_hoolduskoormu_t1054007_koolituse_arendamine",
      "@type": [
