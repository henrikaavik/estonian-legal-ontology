    {
      "@id": "estleg:Concept_saue_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeskir_t1006506_vee_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eraõiguslik juriidiline isik, kes varustab kliendi kinnistu veevärki ühisveevärgi kaudu veega või korraldab ühiskanalisatsiooni kaudu kliendi kinnistu kanalisatsioonist reo- ning sademevee ärajuhtimist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1006506_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "vee-ettevõtja (saue_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeskir_t1006506)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vee_ettevotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_saue_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeskir_t1006506_uhendustoru",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühendustoru",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistu veevärki veega varustav või kinnistu kanalisatsioonist reo- või sademevett ärajuhtiv toru peatorust liitumispunktini, viimane kaasaarvatud; 32) ühisveevärk ja –kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reo- ning sademevee ärajuhtimine ja mis on vee-ettevõtja hallatav; 33) ühisveevärgi ja -kanalisatsiooni avarii – ühisveevärgi ja -kanalisatsiooni ehitiste või seadmete purunemine või rikkiminek, mille tagajärjel oluliselt halveneb või katkeb klientide veega varustamine või nende reo- ning sademevee ärajuhtimine, või on ohustatud inimesed, ehitised või keskkond. Ühisveevärgi ja -kanalisatsioonina käsitletakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos. Reo- ning sademeveena käsitletakse reovett või sademevett eraldi või mõlemat koos.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1006506_Par_2"
        }
      ],
      "estleg:sourceAct": "Saue valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
      "rdfs:label": "ühendustoru (saue_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeskir_t1006506)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhendustoru"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
