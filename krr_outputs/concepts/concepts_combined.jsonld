      "estleg:definitionCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "rdfs:label": "reklaamimaks",
      "skos:definition": [
        {
          "@value": "tasu reklaami avalikustamise eest; 3",
          "@language": "et"
        },
        {
          "@value": "Harku valla territooriumil reklaami avaldamise eest käesolevas määruses sätestatud korras, ulatuses ja tähtaegadel tasumisele kuuluv maks; 8",
          "@language": "et"
        },
        {
          "@value": "Kambja valla avalik-õiguslike ülesannete täitmiseks vajaliku tulu saamise ja vallapildi kujundamise eesmärgil reklaamimaksu maksja poolt käesolevas määruses sätestatud korras, suuruses ja tähtaegadel ilma otsese vastutasuta tasumisele kuuluv kohalik maks; 10",
          "@language": "et"
        },
        {
          "@value": "käesoleva määrusega kehtestatud kohalik maks; 2",
          "@language": "et"
        },
        {
          "@value": "määruses sätestatud korras maksukohustuslase poolt maksuobjekti osas, suuruses ja tähtaegadel ilma otsese vastutasuta tasumisele kuuluv kohalik maks; 7",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_reklaamimaks_on_viru",
