      "rdfs:label": "infosüsteem",
      "skos:definition": [
        {
          "@value": "andmeid töötlev, salvestav või edastav tehniline süsteem koos tema normaalseks talitluseks vajalike vahendite, ressursside ja protsessidega",
          "@language": "et"
        },
        {
          "@value": "andmeid töötlev, salvestav või edastav tehniline süsteem koos tema normaalseks talitluseks vajalike vahendite, ressursside ja protsessidega (sh tarkvara, andmebaasid, liidesed, X-tee teenused, pilveteenused)",
          "@language": "et"
        },
        {
          "@value": "arvutid ja arvutivõrk (edaspidi arvutivõrk), tarkvara, rakendused",
          "@language": "et"
        },
        {
          "@value": "vahendite ja põhimõtete kogum, mille abil kogutakse, töödeldakse, säilitatakse ja väljastatakse teatavaid andmeid",
          "@language": "et"
        },
        {
          "@value": "äriprotsesside ja -teenuste toetamiseks ja/või võimaldamiseks vajalike vahendite ja põhimõtete kogum, tark- ja riistvarast koosnev infotehnoloogiline lahendus, mille abil kogutakse, töödeldakse, säilitatakse ja väljastatakse andmeid",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
