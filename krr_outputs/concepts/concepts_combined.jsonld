        "@id": "estleg:Concept_septik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teave, mis on avalikustatud mis tahes üldtajutaval kujul, tasu eest või tasuta, teenuse osutamise või kauba müügi suurendamise, ürituse edendamise või üritusest teavitamise või isiku käitumise avalikes huvides suunamise eesmärgil",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "reklaam (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_valireklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "välireklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avalikus kohas asuv või avalikust kohast jälgitav reklaam",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "välireklaam (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valireklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_reklaami_avalikustaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaami avalikustaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik või riigi- või kohaliku omavalitsuse asutus, kes reklaami avalikult esitab, edastab, näitab või levitab",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "reklaami avalikustaja (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaami_avalikustaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_statsionaarne_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "statsionaarne reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaam, mis on paigaldatud spetsiaalselt selleks ehitatud vundamendiga maa või ehituskonstruktsioonidega hoone või rajatise külge või olemasolevate vundamentide, lahtiselt tõstetud betoonplokkide või ehituskonstruktsioonide külge",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "statsionaarne reklaam (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_statsionaarne_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_mittestatsionaarne_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "mittestatsionaarne reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "maapinnaga või ehitisega mittepüsivalt ühendatud reklaamikandjale paigaldatud välireklaam, mis asub kaupluse, toitlustusasutuse või mõne muu majandus- või kutsetegevuse koha sissekäigu vahetus läheduses",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "mittestatsionaarne reklaam (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_mittestatsionaarne_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_mobiilne_konstruktsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "mobiilne konstruktsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduk või haagis, mis on välireklaami edastamiseks kohandatud ja mille vahendusel välireklaami edastatakse, samuti reklaami eesmärgil spetsiaalselt paigutatud või pargitud sõiduk reklaamkirjadega (soodushinnad, allahindlused, müügikuulutused, üritused, toodete kaubamärgid ja liigid jm). Mobiilne konstruktsioon ei pea olema kantud liiklusregistrisse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "mobiilne konstruktsioon (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_mobiilne_konstruktsioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_digitaalne_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "digitaalne reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "digitaalselt elektroonilise paneeli või ekraani vahendusel edastatav välireklaam",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "digitaalne reklaam (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_digitaalne_reklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_reklaamikandja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaamikandja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaami eksponeerimiseks ja paigaldamiseks kasutatav alus, seadeldis, konstruktsioon (reklaampost, tahvel, haagis jms) või ühistranspordivahend",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "reklaamikandja (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaamikandja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_reklaampind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaampind",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "igasugune tasapinnaline või ruumiline objekt, mis paigaldatakse üldsusele suunatud reklaami eksponeerimise eesmärgil",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "reklaampind (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaampind"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_sotsiaalreklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sotsiaalreklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reklaam, mille eesmärk on saavutada hinnangute andmise kaudu inimese käitumine avalikes huvides ja milles teatud probleemile keskendudes ei pakuta kaubamärgipõhist, vaid üldist lahendit",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "sotsiaalreklaam (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_sotsiaalreklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamine_jogeva_vallas_t1057646_valimiskampaania_reklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valimiskampaania reklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "erakondade, valimisliitude või üksikkandidaatide reklaam, mille eesmärk on oma vaadete tutvustamine ja valijate mõjutamine reklaamija poolt häält andma valimiste väljakuulutamisest kuni valimispäevani",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057646_Par_2"
        }
      ],
      "estleg:sourceAct": "Välireklaami paigaldamine Jõgeva vallas",
      "rdfs:label": "valimiskampaania reklaam (valireklaami_paigaldamine_jogeva_vallas_t1057646)",
