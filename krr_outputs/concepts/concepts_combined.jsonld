        "@id": "estleg:Concept_omapuhasti_ehk_kohtpuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "septik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pealt kinnine väljavooluga reovee mehhaaniline puhasti, millesse sadenenud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt. Kohila vallas pole septikut eraldiseisva süsteemina lubatud kasutada",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "septik (kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_septik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_biopuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "biopuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pealt kinnine väljavooluga reovee bioloogiline puhasti, milles läbivoolavas reovees sisalduvat orgaanilist ainet lagundatakse aeroobsetes tingimustes mikroorganismide toimel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "biopuhasti (kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_biopuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_imbvaljak_ehk_imbsusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "imbväljak ehk imbsüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "biopuhastile järgnev heitvee puhastussüsteem, kus killustikukihi sisse teatud kindlate vahedega paigaldatud imbtorud jaotavad heitvee ühtlaselt üle kogu filtreeriva ala (imbväljaku) ning tänu millele imendub sinna valguv heitvesi ühtlaselt pinnasesse, läbides seejuures pinnaseosakestele kasvanud biokile, mis lagundab vees sisalduvad tahked ainekübemed aeroobselt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "imbväljak ehk imbsüsteem (kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_imbvaljak_ehk_imbsusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_filtervaljak_ehk_filtersusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "filterväljak ehk filtersüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "septikule või biopuhastile järgnev heitvee puhastussüsteem, mis rajatakse juhul, kui imbsüsteemi paigalduskoha pinnas ei ima või ei lase vett läbi. Killustikukihi alla ehitatakse liivast filtreerimiskiht ja selle alla paigaldatakse drenaažitorud, mis juhivad läbi liivakihi valgunud ja puhastatud vee kogumiskaevu ja sealt suublasse. Filtersüsteem isoleeritakse ümbritsevast pinnasest geomembraaniga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "filterväljak ehk filtersüsteem (kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_filtervaljak_ehk_filtersusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_eelpuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eelpuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "muda-, liiva-, rasva- või õlipüünis ning nende kombinatsioon ja muu reovee osalise puhastamise tehnoloogiline seade, mille läbimise järel juhitakse reovesi ühiskanalisatsiooni või tööstusreoveepuhastisse; 14) inimekivalent (ie) – ühik, millega mõõdetakse ühe inimese põhjustatud keskmist ööpäevast tinglikku veereostuskoormust. Biokeemilise hapnikutarbe kaudu väljendatud ie väärtus on 60 grammi hapnikku ööpäevas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
        }
      ],
      "estleg:sourceAct": "Kohila valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "eelpuhasti (kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eelpuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_purgimisteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimisteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kohtkäitlusrajatisest reovee või -sette eemaldamine ja äravedu purgimissõidukiga ning selle väljutamine purgimissõlme",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
