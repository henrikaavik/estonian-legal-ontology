      "estleg:definesConcept": {
        "@id": "estleg:Concept_olmejaatmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kadrina_valla_jaatmehoolduseeskiri_t1053453_segaolmejaatmed_ehk_prugi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "segaolmejäätmed ehk prügi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olmejäätmed, mida ei ole liigiti kogutud või liigiti kogutud olmejäätmetest üle jäänud sortimisjääk 4) biolagunevad aia- ja haljastusjäätmed – aedade ja haljasalade hooldamisel tekkinud biolagunevad jäätmed (rohi, lehed ja oksad); 5) biolagunevad köögi- ja sööklajäätmed – kodumajapidamistes, kauplustes, toitlustusasutustes muudes ettevõtetes ja asutustes tekkinud toidu- ja köögijäätmed; 6) ehitus- ja lammutusjäätmed – ehitamise, remondi ja lammutamise käigus tekkivad jäätmed ning väljaveetud pinnas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053453_Par_2"
        }
      ],
      "estleg:sourceAct": "Kadrina valla jäätmehoolduseeskiri",
      "rdfs:label": "segaolmejäätmed ehk prügi (kadrina_valla_jaatmehoolduseeskiri_t1053453)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_segaolmejaatmed_ehk_prugi"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kadrina_valla_jaatmehoolduseeskiri_t1053453_suurjaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "suurjäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olmejäätmed, mida kaalu või mahu tõttu ei ole võimalik paigutada segaolmejäätmete mahutisse (mööbliesemed, vaibad, madratsid, kardinapuud, kraanikausid jms). Suurjäätmetena ei käsitata ehitusjäätmeid k.a aknaraamid ning suuremõõtmelisi probleemtooteid (autoromud või nende osad, vanarehvid, elektri- ja elektroonikaseadmed või nende jäätmed, pesumasinad, telerid, külmkapid, elektripliidid jms) ja muid tootjavastutusega hõlmatud jäätmeid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053453_Par_2"
        }
      ],
      "estleg:sourceAct": "Kadrina valla jäätmehoolduseeskiri",
      "rdfs:label": "suurjäätmed (kadrina_valla_jaatmehoolduseeskiri_t1053453)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_suurjaatmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kadrina_valla_jaatmehoolduseeskiri_t1053453_ohtlikud_jaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ohtlikud jäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmed, mis vähemalt ühe kahjuliku toime tõttu võivad olla ohtlikud tervisele, varale või keskkonnale; 9) taaskasutatavad jäätmed on jäätmed, mida saab kasutada toorainena, kütusena või muuks otstarbeks (paber, kartong, pakendijäätmed, biolagunevad jäätmed, suurjäätmed, metallijäätmed, puidujäätmed ning aia- ja haljastusjäätmed); 10) pakendijäätmed on mis tahes pakend või pakendimaterjal, mis muutub pärast pakendi kasutamist jäätmeks. Pakendijäätmeteks ei loeta pakendi ja pakendimaterjali tootmisel tekkinud jääke",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053453_Par_2"
        }
      ],
      "estleg:sourceAct": "Kadrina valla jäätmehoolduseeskiri",
      "rdfs:label": "ohtlikud jäätmed (kadrina_valla_jaatmehoolduseeskiri_t1053453)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ohtlikud_jaatmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
