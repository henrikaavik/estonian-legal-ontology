      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "saldoandmik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "üldeeskirjas kontokombinatsioonide ja nende saldode järjestatud loetelu üldeeskirja lisades toodud kontoplaani järgi; konsolideeritud saldoandmikus on konsolideerimisgruppi kuuluvate üksuste omavahelisi varasid, kohustusi, netovara, tulusid ja kulusid kajastavad kontokombinatsioonide saldod elimineeritud",
        "@language": "et"
      },
      "estleg:definedIn": [
