      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametnikule tehtud töö eest makstav tasu, mis võib koosneda põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust.",
        "@language": "et"
      },
      "estleg:definedIn": [
