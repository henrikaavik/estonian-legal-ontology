      "rdfs:label": "kinnistu",
      "skos:altLabel": [
        {
          "@value": "Kinnistu",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maatükk) või hoonestusõigus käesoleva eeskirja tähenduses; 6",
          "@language": "et"
        },
        {
          "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maatükk) või hoonestusõigus; 10",
          "@language": "et"
        },
        {
          "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi, hoonestusõigus, korteriomand ja korterihoonestusõigus. Kinnistuga on eeskirjas võrdsustatud ka kinnistamata maaüksus, mille suhtes isikul on kasutusõigus; 5",
          "@language": "et"
        },
        {
          "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maatükk) või hoonestusõigus; 9",
          "@language": "et"
        },
        {
          "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maatükk). 12",
          "@language": "et"
        }
      ],
