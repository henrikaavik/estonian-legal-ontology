    {
      "@id": "estleg:Concept_biopuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "biopuhasti",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_haapsalu_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1061262_biopuhasti"
        },
        {
          "@id": "estleg:Concept_jarva_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1055623_biopuhasti"
        },
        {
          "@id": "estleg:Concept_kohila_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051835_biopuhasti"
        },
        {
          "@id": "estleg:Concept_kose_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054491_biopuhasti"
        },
        {
          "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048274_biopuhasti"
        },
        {
          "@id": "estleg:Concept_raasiku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1047567_biopuhasti"
        },
        {
          "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_biopuhasti"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "biopuhasti",
      "skos:definition": [
        {
          "@value": "pealt kinnine väljavooluga reovee bioloogiline puhasti, milles läbivoolavas reovees sisalduvat orgaanilist ainet lagundatakse aeroobsetes tingimustes mikroorganismide toimel; 11",
          "@language": "et"
        },
        {
          "@value": "süsteem, kus reovesi puhastatakse bakterite ja mikroorganismide abil, kes lagundavad reovees olevaid orgaanilisi aineid ja kasutavad neid toiduks, tagades reovee bioloogilise puhastuse; 2",
          "@language": "et"
        },
        {
          "@value": "kinnine mahuti, kus reovee orgaanilise aine sisaldus ja heljumi vähendamine toimub aeroobsete bakterite kaasabil hapnikuga rikastatud keskkonnas. Biopuhastist juhitakse reovesi immutus- või filtersüsteemil põhinevasse puhastussüsteemi. 9",
          "@language": "et"
        },
        {
          "@value": "omapuhasti, milles reoveest reoainete kõrvaldamine toimub bioloogiliste protsesside toimel ja mille tulemusel heitvesi vastab Vabariigi Valitsuse 29.11.2012. a määruses nr 99 “ Reovee puhastamise ning heit- ja sademevee suublasse juhtimise kohta esitatavad nõuded, heit- ja sademevee reostusnäitajate piirmäärad ning nende nõuete täitmise kontrollimise meetmed“ lisas 1 esitatud heitvee reostusnäitajate piirväärtustele biokeemilise hapnikutarbe, heljuvaine ja keemilise hapnikutarbe osas; 2",
          "@language": "et"
        },
        {
          "@value": "silindrikujuline vähemalt kolmest kambrist koosnev plast- või betoonmahuti, mis kasutab mikroorganisme reovee puhastamiseks.",
          "@language": "et"
        }
      ]
    },
