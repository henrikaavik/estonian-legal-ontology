        {
          "@value": "Reklaami avalikustaja",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "füüsiline või juriidiline isik või riigi- või kohaliku omavalitsuse asutus, kes reklaami avalikult esitab, edastab, näitab või levitab; 4",
          "@language": "et"
        },
        {
          "@value": "füüsiline või juriidiline isiku või riigi- või kohaliku omavalitsuse asutus, kes reklaami avalikult esitab, edastab, näitab või levitab; 3",
          "@language": "et"
        },
        {
          "@value": "füüsiline- või juriidiline isik või riigi- või kohaliku omavalitsuse asutus, kes reklaami avalikult esitab, edastab, näitab või levitab; 3",
          "@language": "et"
        },
        {
          "@value": "paigaldusloa alusel reklaami paigaldaja, reklaami paigaldamise tellinud isik või isik, kelle huvides reklaam avalikustatakse; 6",
          "@language": "et"
        },
        {
          "@value": "reklaami avalik esitaja; 9",
