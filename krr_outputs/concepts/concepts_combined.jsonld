      "@id": "estleg:Concept_noorteuhing",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "noorteühing",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
