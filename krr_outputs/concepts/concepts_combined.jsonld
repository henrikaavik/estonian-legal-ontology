    },
    {
      "@id": "estleg:Concept_kose_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054491_omapuhasti_e_kohtpuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti e kohtpuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reoveepuhasti, mille suublaks on pinnas või veekogu ja projekteeritud reostuskoormus on kuni 49 inimekivalenti (ie):",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054491_Par_2"
        }
