      "estleg:definesConcept": {
        "@id": "estleg:Concept_mikroettevotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_konkursi_narva_ettevotja_labiviimise_korra_kinnitamine_t1061582_Vaikeettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Väikeettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "raamatupidamiskohustuslane, kes ei ole mikroettevõtja ja kelle aruandekuupäeva näitajatest kaks ei ületa järgmisi näitajaid: varad kokku 7 500 000 eurot, aruandeaasta tulu 15 000 000 eurot ja keskmine töötajate arv aruandeaasta jooksul 50 inimest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061582_Par_2"
        }
      ],
      "estleg:sourceAct": "Konkursi “Narva Ettevõtja” läbiviimise korra kinnitamine",
