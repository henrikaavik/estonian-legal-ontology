      }
    },
    {
      "@id": "estleg:Concept_puka_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_eeski_t1028459_volitatud_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "volitatud isik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes vallavolikogu otsusega on volitatud kontrollima kinnistu veevärgi ja kanalisatsiooni vastavust nõuetele; 20) ühisveevärk ja -kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reovee ärajuhtimine ja mis on vee-ettevõtja hallatav; Ühisveevärgi ja -kanalisatsioonina käsitletakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028459_Par_2"
        }
      ],
      "estleg:sourceAct": "Puka valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
      "rdfs:label": "volitatud isik (puka_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_eeski_t1028459)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_volitatud_isik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_infoturvapoliitika_t1062399_infovara",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "infovara",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutuse valduses või vastutusel olev teave ja andmed (sh isikuandmed, töö- ja menetlusdokumendid, registri- ja andmekogude andmed, logid), sõltumata vormist ja kandjast; vajadusel kasutatakse infovara kirjeldamisel eraldi mõistena „infosüsteem” ning „taristu”",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062399_Par_3"
        }
      ],
      "estleg:sourceAct": "Raasiku valla infoturvapoliitika",
      "rdfs:label": "infovara (raasiku_valla_infoturvapoliitika_t1062399)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_infovara"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_infoturvapoliitika_t1062399_infosusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "infosüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "andmeid töötlev, salvestav või edastav tehniline süsteem koos tema normaalseks talitluseks vajalike vahendite, ressursside ja protsessidega (sh tarkvara, andmebaasid, liidesed, X-tee teenused, pilveteenused)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062399_Par_3"
        }
      ],
      "estleg:sourceAct": "Raasiku valla infoturvapoliitika",
      "rdfs:label": "infosüsteem (raasiku_valla_infoturvapoliitika_t1062399)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_infosusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_infoturvapoliitika_t1062399_taristu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taristu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "infosüsteemide toimimiseks vajalik tehniline keskkond (serverid, võrguseadmed, tööjaamad, andmesalvestus, varundus, sidekanalid, hooned ja ruumid jms)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062399_Par_3"
        }
      ],
      "estleg:sourceAct": "Raasiku valla infoturvapoliitika",
      "rdfs:label": "taristu (raasiku_valla_infoturvapoliitika_t1062399)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_taristu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_infoturvapoliitika_t1062399_turvameetmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "turvameetmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "organisatsioonilised toimingud, protsessid, tehnilised ja füüsilised vahendid, millega tagatakse infovarade, infosüsteemide ja taristu turvalisus (sh poliitikad, protseduurid, tehnilised seaded, füüsiline turve); 10) infoturbehaldus on infoturbe rajamise läbimõeldud ja toimiva protsessi loomiseks ja pidevaks ümberkujunduseks vajalik plaanimis-, suunamis- ja kontrollimistöö. Infoturbe haldus on pidev protsess, mille aluseks olevate strateegiate ja kontseptsioonide tõhusust ja toimivust pidevalt kontrollitakse ja vajaduse korral ajakohastatakse; 11) jääkrisk on infoturbe riskihalduse protsessis maandamata jäänud risk; 12) infoturbeintsident on reaalse või potentsiaalse kahju juhtum, mis võib ohustada või halvata IT-vara turvalisust, põhjustades selle tervikluse, käideldavuse või konfidentsiaalsuse kao. Infoturbeintsidentideks loetakse muu hulgas ka toimingud, mis ei ole infoturbe valdkonda reguleerivate õigusaktidega kooskõlas; 13) krüpteerimine on andmete muundamine infosisu peitmiseks, näiteks interneti kasutamine https-protokolliga või adressaadiga ühenduse loomine virtuaalse privaatvõrgu (VPN) tunneli kaudu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062399_Par_3"
        }
      ],
      "estleg:sourceAct": "Raasiku valla infoturvapoliitika",
      "rdfs:label": "turvameetmed (raasiku_valla_infoturvapoliitika_t1062399)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_turvameetmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_infoturvapoliitika_t1062399_kaitsetarve",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaitsetarve",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hinnang infovara või sihtobjekti vajaliku kaitse tasemele konfidentsiaalsuse, tervikluse ja käideldavuse aspektist (normaalne, suur, väga suur) vastavalt E-ITS rakendusjuhendile; 15) IT-varad on organisatsiooni jaoks väärtust loovad tarkvara või riistvara komponendid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1062399_Par_3"
        }
      ],
      "estleg:sourceAct": "Raasiku valla infoturvapoliitika",
      "rdfs:label": "kaitsetarve (raasiku_valla_infoturvapoliitika_t1062399)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kaitsetarve"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_infoturvapoliitika_t1062399_turbeviis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "turbeviis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "E-ITS-is kirjeldatud turbetase (põhiturve, standardturve, tuumikuturve), mida rakendatakse vastavalt määratud kaitsetarbele.",
        "@language": "et"
      },
      "estleg:definedIn": [
