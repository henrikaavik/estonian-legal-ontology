        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiakasutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "soojus- või elektrienergia kasutus vaadeldavas süsteemipunktis. Energiakasutus arvutatakse netoenergiavajadusest, võttes arvesse süsteemikao ja energia muundumise. Tehnosüsteemi lõpp-punktis (üldjuhul liitumispunkt energiavõrguga) võrdub tehnosüsteemi energiakasutus tarnitud energia ja lokaalse taastuvenergia summaga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1029856_Par_2"
        }
      ],
      "estleg:sourceAct": "Hoone energiatõhususe arvutamise metoodika",
