      },
      "rdfs:label": "tulemuspalk",
      "skos:altLabel": [
        {
          "@value": "Tulemuspalk",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "asutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
          "@language": "et"
        },
        {
          "@value": "muutuvpalga üks komponent, mida võib teenistujale maksta silmapaistvate tulemuste eest seatud eesmärkide saavutamisel",
          "@language": "et"
        },
        {
          "@value": "tasu igapäevaste teenistuskohajärgsete ülesannete (väga) hea täitmise eest teatud perioodil",
          "@language": "et"
        },
        {
          "@value": "vallavanema või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
          "@language": "et"
        },
        {
          "@value": "aasta töötulemuste hindamise alusel tööplaanis kavandatud ja kalendriaastaks kokkulepitud eesmärkide saavutamise ja ülesannete täitmise eest määratav ja makstav täiendav tasu.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "12",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_tulemustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
