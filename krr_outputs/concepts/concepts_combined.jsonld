      "@id": "estleg:Concept_johvi_valla_infoturvapoliitika_t1058728_konfidentsiaalsus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "konfidentsiaalsus",
      "skos:definition": "andmete kättesaadavus ainult selleks volitatud isikule või tehnilisele vahendile; 5",
      "estleg:definedIn": [
