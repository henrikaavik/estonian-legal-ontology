    {
      "@id": "estleg:Concept_haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672_analuutiline_ja_sunteetiline_arvestus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "analüütiline ja sünteetiline arvestus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandusinformatsiooni liigendamise erinevad detailsuse tasemed. Sünteetiline arvestus on majandusinformatsiooni kirjendamine raamatupidamiskontodele. Analüütiline arvestus on raamatupidamiskontodele kirjendatud majandusinformatsiooni detailiseerimine (nõuded ja kohustised – kelle vastu jms)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058672_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "analüütiline ja sünteetiline arvestus (haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_analuutiline_ja_sunteetiline_arvestus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672_kinnitamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnitamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "majandustehingu toimumise ja õiguspärasuse kinnitamine allkirjaga ning eelarve tunnuse või nimetuse määramine valla eelarveklassifikaatorite liigenduses. Toiming kuulub kuludokumendi kontrollija või vastutava isiku (eelarve vastutav täitja, projekti vastutav täitja või muu kinnitamise õigusega isik) kompetentsi; 3) allkiri (sh raamatupidamise algdokumendi allkiri) – omakäeline allkiri paberdokumendil, digitaalallkiri või dokumendi menetlemiseks ette nähtud infotehnoloogilises süsteemis antud kooskõlastus või kinnitus, kui selle andjat ja selle andmise kuupäeva on võimalik elektrooniliselt säilitada ja dokumendi säilitustähtaja jooksul tuvastada",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058672_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "kinnitamine (haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnitamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672_aruandeperiood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "aruandeperiood",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "periood, mille jooksul toimunud majandustehingute kirjendid võetakse arvesse aruannete koostamisel. Lühim aruandeperiood on kalendrikuu. Majandusaasta aruandeperiood on kalendriaasta; 5) eelarve vastutav täitja (ka volitatud töötaja, projektijuht) – määratud isik või isikud, kellele on antud õigus käsutada vallaeelarve vahendeid kinnitatud eelarve piires ja struktuuris, millist õigust teostab vastutav isik nii kulude kinnitamisega valla eelarveklassifikaatorite liigenduses kui ka tulude eelarve täitmise tagamisega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058672_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "aruandeperiood (haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_aruandeperiood"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672_Eesti_finantsaruandluse_standard",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Eesti finantsaruandluse standard",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev raamatupidamistava, mille põhinõuded kehtestatakse RPS-s, mida täiendavad RTJ-d, üldeeskiri ja sise-eeskiri",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058672_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "Eesti finantsaruandluse standard (haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eesti_finantsaruandluse_standard"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672_konsolideerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "konsolideerimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "raamatupidamisüksuste aruannete ühendamine nii, nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega kaasneb elimineerimine, milline tehing on konsolideerimisgruppi kuuluvate isikute omavaheliste vastandtehingute (tulud-kulud, nõuded-kohustised) liitmine nii, et grupi aruandes neid ei esine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058672_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala Vallavalitsuse raamatupidamise sise-eeskiri",
      "rdfs:label": "konsolideerimine (haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_konsolideerimine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672_majandusinformatsiooni_liigendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "majandusinformatsiooni liigendamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla majandustehingute kirjendamine, kasutades riigi või valla õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid valla juhtimisotsuste tegemiseks ning riigi aruandluse jaoks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058672_Par_2"
        }
