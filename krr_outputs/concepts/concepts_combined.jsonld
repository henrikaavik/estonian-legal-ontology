        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "abiandja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Päästeameti, Kaitseväe, Politsei- ja Piirivalveameti, Terviseameti ning nende lepingupartnerite üksused, keda Häirekeskus või Politsei- ja Piirivalveamet saadab välja abi andma",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039014_Par_2"
        }
