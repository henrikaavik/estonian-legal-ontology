    {
      "@id": "estleg:Concept_viljandi_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1023250_vee_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eraõiguslik juriidiline isik, kes varustab kliendi kinnistu veevärki ühisveevärgi kaudu veega või korraldab ühiskanalisatsiooni kaudu kliendi kinnistu kanalisatsioonist reo- ning sademevee ärajuhtimist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1023250_Par_2"
        }
      ],
