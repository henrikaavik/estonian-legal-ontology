      ],
      "skos:prefLabel": {
        "@value": "reovesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olmes, tööstuses ja tootmises tekkiv vesi, mis ei vasta kehtestatud kvaliteedi piirväärtustele ja mida on vaja enne suublasse juhtimist puhastada",
        "@language": "et"
      },
