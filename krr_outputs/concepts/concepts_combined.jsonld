      }
    },
    {
      "@id": "estleg:Concept_rikastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rikastamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_rikastamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rikastamine",
      "skos:definition": [
        {
          "@value": "maavaradega tehtavad mehaanilised, füüsikalised, bioloogilised, termilised või keemilised protsessid või nende protsesside kombinatsioon (sealhulgas karjääride tegevus), mille käigus eraldatakse maavara vähemväärtuslik osa väärtuslikumast osast või muudetakse materjali tükisuurust või sorteeritakse materjali või toimub materjali leostumine või eraldumine ning eelnevalt kõrvale jäetud jäätmete ümbertöötamine, välja arvatud sulatamine, termilised tootmisprotsessid (välja arvatud lubjakivi põletamine) ja metallurgiatööd",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_risustamine"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rikastamisjaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rikastamisjäätmed",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_rikastamisjaatmed"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rikastamisjäätmed",
      "skos:definition": [
        {
          "@value": "pärast maavara väärtuslikuma osa vähemväärtuslikust kivimist eraldamist (nt purustamist, peenestamist, suuruse järgi sorteerimist, flotatsiooni ja muude füüsikalis-keemiliste tehnoloogiate rakendamist) järele jäävad tahked või vedelad jäätmed",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rikkumine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rikkumine",
