      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "soojuskoormus",
      "skos:definition": [
        {
          "@value": "hoone soojusvarustuseks vajalik soojusvõimsus, mis koosneb soojuskadudest läbi piirdetarindite, soojuskoormusest ventilatsioonile, infiltratsioonile, soojale tarbeveele, külmade materjalide ja seadmete soojendamiseks; mõõteühik watt (W).",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_soojussolm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "soojussõlm",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_soojussolm"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "soojussõlm",
      "skos:definition": [
        {
          "@value": "hoone või hoonerühma seadmestik, mille abil soojusenergia tarbijad on ühenduses soojusvõrguga. Soojussõlmes muudetakse kaugküttevõrgu soojuskandja temperatuur ja rõhk hoone sooja tarbevee, kütte- ja ventilatsioonisüsteemile sobivaks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sooline_vordsus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sooline võrdsus",
