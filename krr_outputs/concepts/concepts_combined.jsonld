      ],
      "skos:prefLabel": {
        "@value": "jäätmejaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "üldjuhul detailplaneeringu ja projekti alusel rajatud ning tehniliselt varustatud jäätmekäitluskoht, kuhu on paigutatud taaskasutatavate jäätmete kogumiseks ja esmaseks töötlemiseks kogumismahutid, sh ohtlike jäätmete kogumismahutid",
        "@language": "et"
      },
      "estleg:definedIn": [
