      "rdfs:label": "pauguti",
      "skos:definition": [
        {
          "@value": "teravaid kilde mitteandvasse mittemetallist kesta paigutatud pürotehniline toode, mis laengu süttimisel tekitab peamiselt pauguga heliefekti",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
