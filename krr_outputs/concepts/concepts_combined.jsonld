      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "liikuv reklaam",
      "skos:definition": [
        {
          "@value": "reklaam, mis asub pidevat teisaldamist võimaldaval alusel (haagised või muud selleks spetsiaalselt kohandatud, reeglina ratastel asetsevad konstruktsioonid)",
          "@language": "et"
        },
        {
          "@value": "reklaam, mis asub teisaldamist võimaldaval alusel (haagised või muud selleks kohandatud konstruktsioonid) ning mille pindala on üle 3 m 2",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
