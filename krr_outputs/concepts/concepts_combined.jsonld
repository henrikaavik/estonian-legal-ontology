        {
          "@value": "asutuse või hallatava asutuse juht või tema poolt kirjalikult määratud isik, kellele on antud volitus majandustehingute tegemiseks; 6",
          "@language": "et"
        },
        {
          "@value": "isik, kes on kohustatud oma ameti- või tööülesannete tõttu esitama raamatupidamisele dokumente vastavalt dokumendikäibele; 35",
          "@language": "et"
        }
      ]
    },
