        "@value": "purgimiskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "koht, mis on määratud kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas (edaspidi ÜVK) tekkekohast äraveetud reovee ühiskanalisatsiooni juhtimiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039009_Par_2"
        }
      ],
