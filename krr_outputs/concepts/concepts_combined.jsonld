        "@id": "estleg:Concept_illegaalne_grafiti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Tõrva vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040857_Par_3"
        }
      ],
      "estleg:sourceAct": "Tõrva Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (torva_vallavalitsuse_palgajuhend_t1040857)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Tõrva vallaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud vallavalitsuses ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040857_Par_3"
        }
      ],
      "estleg:sourceAct": "Tõrva Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (torva_vallavalitsuse_palgajuhend_t1040857)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on võetud vallavalitsuse töökohale, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040857_Par_3"
        }
      ],
      "estleg:sourceAct": "Tõrva Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (torva_vallavalitsuse_palgajuhend_t1040857)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
