    {
      "@id": "estleg:Concept_filter",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "filter",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048274_filter"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "filter",
      "skos:definition": [
        {
          "@value": "ja imbsüsteem – koredast pinnasest (kruus, kergkruus või killustik) ja reovee jaotussüsteemist ehitatud tehislooduslik süsteem reovee bioloogiliseks puhastamiseks bakterite abil ja keskkonda (suublasse) juhtimiseks. Filter- või imbsüsteemi ette paigaldatakse septik, kus toimub reovee mehhaaniline puhastus või omapuhasti, kus toimub reovee bioloogiline puhastamine; 6",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_filtervaljak",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "filterväljak",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_saaremaa_vallas_t1047226_filtervaljak"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "filterväljak",
      "skos:definition": [
        {
          "@value": "reoveekäitlussüsteemi osa reovee bioloogiliseks puhastamiseks, kus reovee puhastus viiakse läbi pinnaseosakestele tekkivas biokiles elavate mikroorganismide poolt, filtersüsteem on ümbritsevast keskkonnast eraldatud vedelikke mitteläbilaskva geomembraaniga; 4",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_filtervaljak_ehk_filtersusteem",
      "@type": [
        "owl:NamedIndividual",
