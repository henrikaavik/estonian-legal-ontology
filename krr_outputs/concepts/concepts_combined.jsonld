      "rdfs:label": "palgaaste",
      "skos:definition": [
        {
          "@value": "teenistuskohtade palgaastmele vastav põhipalgavahemik. Palgaaste on seotud teenistuskohtade grupiga, kuhu on koondatud vallavalitsuse jaoks sarnase tööväärtusega teenistuskohad",
          "@language": "et"
        }
      ],
