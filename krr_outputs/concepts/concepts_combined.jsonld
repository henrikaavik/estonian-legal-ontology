    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_vahendid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "vahendid",
      "skos:definition": "infrastruktuur (näiteks hooned, ruumid, kaablid, võrguühendus), arvutid (näiteks lauaarvutid, sülearvutid, tahvelarvutid), lisaseadmed (näiteks printerid), andmekandjad (näiteks serverid, mälupulgad, CD-d, DVD-d) jms.",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna infoturbepoliitika",
      "rdfs:label": "vahendid (maardu_linna_infoturbepoliitika_t1049639)",
      "estleg:definesConcept": {
