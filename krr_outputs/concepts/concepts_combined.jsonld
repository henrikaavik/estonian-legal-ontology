      ],
      "skos:prefLabel": {
        "@value": "Akuutsete tellimuste esitamiseks õigustatud isikud",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "haiglate erakorralise meditsiini osakonna vastutav töötaja ning kohaliku omavalitsuse sotsiaaltöötaja.",
