        "@value": "kohtkäitlus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kogumine kogumismahutisse või puhastamine omapuhastis (sh heitvee suublasse juhtimine) ja kuivkäimla sisu käitlemine üldjuhul reovee tekkekoha kinnistu piires",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054022_Par_2"
        }
      ],
