        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Eesti finantsaruandluse standard",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rahvusvaheliselt tunnustatud arvestuse ja aruandluse põhimõtetele tuginev standard, mille põhinõuded kehtestatakse RPS-s, mida täiendavad RTJ-d, üldeeskiri ja eeskiri",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
