        "@type": "xsd:integer"
      },
      "rdfs:label": "toote keskkonnatoime",
      "skos:definition": [
        {
          "@value": "tootja poolt toote keskkonnaaspektide parandamiseks tehtud jõupingutuste tulemus, mis on kirjas tehnilistes dokumentides; 15",
          "@language": "et"
        }
      ]
    },
    {
