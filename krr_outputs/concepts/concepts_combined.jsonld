      "rdfs:label": "CE",
      "skos:definition": [
        {
          "@value": "märgis – märgis, mis näitab väikelaeva ja jeti vastavust Euroopa Parlamendi ja nõukogu direktiivi 2013/53/EL väikelaevade ja jettide kohta ning direktiivi 94/25/EÜ kehtetuks tunnistamise kohta (ELT L 354, 28.12.2013, lk 90–",
          "@language": "et"
        },
        {
          "@value": "märgistus – tootja või importija poolt antud garantii, et toode vastab kõikidele olulistele töötervishoiu, töö- ja keskkonnaohutuse nõuetele; 2",
          "@language": "et"
        }
      ]
    },
