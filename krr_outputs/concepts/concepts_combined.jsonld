      "skos:definition": [
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine; 2021-12-16",
          "@language": "et"
        },
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud",
          "@language": "et"
        },
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud käesoleva korraga kehtestatud korras",
          "@language": "et"
        },
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud käesoleva määrusega kehtestatud korras",
          "@language": "et"
        },
        {
          "@value": "tehnovõrgu või muu rikke korral tehtav ettenägematu töö või hoonelt lume, jääpurikate või muude kukkumisohtlike osade kõrvaldamine, millest on asjaomaseid ametiasutusi teavitatud vastavalt käesoleva määruse §-le 9",
