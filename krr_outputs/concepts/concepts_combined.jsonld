    {
      "@id": "estleg:Concept_ohtlikud_ehitusjaatmed_on_ehitamisel_voi_ehitusmaterjalide_ja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ohtlikud ehitusjäätmed on ehitamisel või ehitusmaterjalide ja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_elva_valla_jaatmehoolduseeskiri_t1056560_ohtlikud_ehitusjaatmed_on_ehitamisel_voi_ehitusmaterjalide_ja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ohtlikud ehitusjäätmed on ehitamisel või ehitusmaterjalide ja",
      "skos:definition": [
        {
          "@value": "toodete hoidmisel või ladustamisel tekkivad jäätmed, mis nende ohtlike omaduste tõttu võivad põhjustada kahju tervisele ja keskkonnale ning nõuavad käitlemisel erimenetlust. 17",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_ohtlikud_jaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ohtlikud jäätmed",
