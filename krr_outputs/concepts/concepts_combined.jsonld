        "@id": "estleg:Concept_aktsepteerimine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kehtna_valla_raamatupidamise_sise_eeskiri_t1060946_aruandeperiood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "aruandeperiood",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "periood, mille jooksul toimunud majandustehingute kirjendid võetakse arvesse aruannete koostamisel. Lühem aruandeperiood on kalendrikuu. Majandusaasta aruandeperiood on kalendriaasta.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060946_Par_2"
        }
      ],
