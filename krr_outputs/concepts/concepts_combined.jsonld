      ],
      "skos:prefLabel": {
        "@value": "ERC",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Euroopa Liidu asutatud teadus- ja arendustegevuse rahastamise organisatsioon, mis toetab konkurentsipõhiselt kõrgetasemelisi teadusuuringuid ja innovatsiooni",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1063265_Par_2"
        }
      ],
      "estleg:sourceAct": "Marie Skłodowska Curie Action järeldoktori individuaalgrandi ja ERC grandi taotlemise edukuse tõstmiseks toetuse taotlemise, toetuse eraldamise ning toetuse tagasinõudmise tingimused ja kord",
      "rdfs:label": "ERC (marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265)",
