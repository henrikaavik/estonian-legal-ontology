      },
      "skos:definition": {
        "@value": "lühiajaline süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest ja kutseõppest vabal ajal, et omandada süvendatud teadmisi ja oskusi valitud huvialal",
        "@language": "et"
      },
      "estleg:definedIn": [
