    {
      "@id": "estleg:Concept_teadlane",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadlane",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_toetuse_t1056629_teadlane"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teadlane",
      "skos:definition": [
        {
          "@value": "alus- ja rakendusuuringuid, arendustegevust või innovatsioonitegevusi läbi viiv doktori- või magistrikraadiga isik, kes käesolevas tegevuses osalemiseks peab omama vähemalt viieaastast teadus- ja arendustegevuse alast töökogemust ning töötama taotluse esitamise hetkel töölepingu alusel positiivselt evalveeritud teadus- ja arendusasutuses vähemalt 0,5 koormusega",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teadmussiirdedoktorant",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadmussiirdedoktorant",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_toetuse_t1056629_teadmussiirdedoktorant"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teadmussiirdedoktorant",
      "skos:definition": [
        {
          "@value": "era-, avaliku- või kolmanda sektori asutuses töölepingu alusel töötav või teenistussuhtes olev isik, kes õpib samaaegselt ülikooli doktoriõppes ja kelle doktoritöö teema on seotud tööandja tegevusega ning on kooskõlas doktorandi individuaalse õppe- ja teadustöö kavaga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teadmussiirdedoktorantuur",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadmussiirdedoktorantuur",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_toetuse_t1056629_teadmussiirdedoktorantuur"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teadmussiirdedoktorantuur",
      "skos:definition": [
        {
          "@value": "kolmepoolne koostöö era-, avaliku- või kolmanda sektori asutuse/ettevõtte, ülikooli ja doktorandi vahel, kus doktoriõppesse immatrikuleeritud doktorandil on ettevõttes, avaliku- või kolmanda sektori asutuses töö- või teenistussuhe, mille põhisisu on doktorandi doktoritöö tegemine kooskõlas tema individuaalse õppe- ja teadustöö kavaga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teadmussiire",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadmussiire",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326_teadmussiire"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teadmussiire",
      "skos:definition": [
        {
          "@value": "protsess, mille eesmärk on omandada, koguda ja jagada väljendatavaid ja vaiketeadmisi, sealhulgas oskusi ja pädevust, nii majandusliku kui ka mittemajandusliku tegevuse käigus, näiteks teaduskoostöö, konsulteerimise, litsentsimise, edasiarenduse, avaldamise ning teadlaste ja nimetatud tegevusaladega seotud muude töötajate liikuvuse kaudu; lisaks teaduslikele ja tehnoloogilistele teadmistele hõlmab see muud liiki teadmisi, näiteks teadmisi standardite ja standardeid sisaldavate õigusaktide kasutamise kohta ning tegelike töötingimuste ja organisatsiooniinnovatsiooni meetodite kohta ja immateriaalse vara kindlakstegemise, omandamise, kaitsmise ja kasutamisega seotud teadmiste haldamist",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teaduse_tippkeskus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teaduse tippkeskus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_teaduse_tippkeskus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teaduse tippkeskus",
      "skos:definition": [
        {
          "@value": "mitme silmapaistvalt kõrge tasemega uurimisrühma ühendus, mille eesmärgiks on koostöö ja ühistegevuse kaudu tõsta läbiviidavate teadus- ja arendustegevuse taset, tulemuslikkust ja mõju; 4) teaduse tippkeskuse toetus (edaspidi toetus ) – vähemalt kahe teadus- ja arendusasutuse, ülikooli või evalveeritud rakenduskõrgkooli kolme või enama kõrgetasemelise uurimisrühma nii siseriiklikku kui rahvusvahelist koostööd toetav rahastusmeede, mis eraldatakse rahvusvahelisel tipptasemel ja läbimurdelise teadustulemuste saamiseks ja levitamiseks Eestile olulistes valdkondades; 5) kõrge riski, suure kasupotentsiaaliga teadus- ja arendustegevus – eksperimentaalne või teoreetiline uurimistöö, millel on oma uudsuse, ainulaadsuse või interdistsiplinaarsuse tõttu suur risk ebaõnnestuda, kuid mille õnnestumisel tekkinud uus teadmine on murranguline, erinedes silmapaistvalt senisest teadmistest ja praktikatest või millel on potentsiaalne rakendusala paljudes eri teadusvaldkondades",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teaduse_tippkeskuse_juht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teaduse tippkeskuse juht",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_teaduse_tippkeskuse_juht"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teaduse tippkeskuse juht",
      "skos:definition": [
        {
          "@value": "teaduse tippkeskusesse kuuluva uurimisrühma juht, kelle ülesanne on teaduse tippkeskuse teadus- ja arendustegevuse juhtimine ja tippkeskusesse kuuluvate uurimisrühmade koostöö koordineerimine",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teaduse_tippkeskuse_teadusnoukoda",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teaduse tippkeskuse teadusnõukoda",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_teaduse_tippkeskuse_teadusnoukoda"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teaduse tippkeskuse teadusnõukoda",
      "skos:definition": [
        {
          "@value": "tippkeskuse välistest valdkonna ekspertidest või välisriikide rahvusvaheliselt tunnustatud teadus- ja arendustöötajatest ning ekspertidest moodustatud nõuandev kogu, mille ülesanne on teaduse tippkeskuse tegevussuundade ja tegevuste osas soovituste andmine; teaduse tippkeskuse teadusnõukojast vähemalt pooled liikmed on välisriikide teadus- ja arendustöötajad või eksperdid.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teadushaldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadushaldus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326_teadushaldus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teadushaldus",
      "skos:definition": [
        {
          "@value": "teadmiste kogumine, organiseerimine, levitamine ja tõhus kasutamine teadus- ja arendusasutuse teadusliku arengu soodustamine ja selle juhtimise kvaliteedi parandamine, millega tagatakse edu teaduses ning teadus- ja arendusasutuse aktiivsuse ja efektiivsuse tõstmine paremaks asutuste vaheliseks koostööks teadmussiirde teenuste vahendamisel ja pakkumisel.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teadustaristu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teadustaristu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_teaduse_tippkeskuste_nimetamise_ning_finantseerimise_tingimu_t1062228_teadustaristu"
        },
        {
          "@id": "estleg:Concept_teadusuuringute_moju_suurendamine_ning_teadusasutuste_ja_kor_t1059326_teadustaristu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teadustaristu",
      "skos:definition": [
        {
          "@value": "haridus- ja teadusministri 28. septembri 2023. a määruse nr 36 „Riikliku tähtsusega teadustaristu toetamine” § 3 punkti 1 tähenduses",
          "@language": "et"
        },
        {
          "@value": "ruumid, vahendid ja teenused, sealhulgas teadusaparatuur ja uurimistarbed, seadmed, teaduskollektsioonid, arhiivid, struktureeritud teadusalane informatsioon või nende kompleks ning nendega seotud tingimused, ja teenused, mida teadlased kasutavad uute teadmiste loomiseks, teadmiste ülekandmiseks, vahetamiseks ja/või säilitamiseks oma teadusala uurimistöös",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
