        },
        {
          "@id": "estleg:Concept_tallinna_linna_raamatupidamise_sise_eeskiri_t1013515_konsolideerimine"
        },
        {
          "@id": "estleg:Concept_tapa_vallavalitsuse_raamatupidamise_sise_eeskiri_t1060264_konsolideerimine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "konsolideerimine",
      "skos:definition": [
        {
          "@value": "raamatupidamisüksuste aruannete ühendamine nii, nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega kaasneb elimineerimine, milline tehing on konsolideerimisgruppi kuuluvate isikute omavaheliste vastandtehingute (tulud-kulud, nõuded-kohustised) liitmine nii, et grupi aruandes neid ei esine",
          "@language": "et"
        },
        {
          "@value": "erinevate üksuste raamatupidamisaruannete koondamine üheks koondaruandeks. Konsolideerimise käigus elimineeritakse konsolideerimisgruppi kuuluvate üksuste omavahelised tehingud",
          "@language": "et"
        },
        {
          "@value": "gruppi kuuluvate üksuste omavaheliste tehingute elimineerimine ja erinevate üksuste raamatupidamisaruannete koondamine üheks koondaruandeks",
          "@language": "et"
        },
        {
          "@value": "raamatupidamisüksuste aruannete ühendamine nii nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega kaasneb konsolideerimisgruppi kuuluvate isikute omavaheliste vastandtehingute (tulud-kulud, nõuded-kohustised) liitmine nii, et grupi aruandes neid ei esine",
          "@language": "et"
        },
        {
          "@value": "raamatupidamisüksuste aruannete ühendamine nii, nagu oleks tegemist ühe raamatupidamiskohustuslasega. Konsolideerimisega kaasneb elimineerimine, so konsolideerimisgruppi kuuluvate isikute omavaheliste vastandtehingute (tulud-kulud, nõuded-kohustused) liitmine nii, et grupi aruandes neid ei esine",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
