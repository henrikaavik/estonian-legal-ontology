        }
      ]
    },
    {
      "@id": "estleg:Concept_kastre_valla_jaatmehoolduseeskiri_t1054861_bioloogiliselt_mittelagunevad_aia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "bioloogiliselt mittelagunevad aia",
      "skos:definition": "ja haljastujäätmed on pinnas, kivid ja muud bioloogiliselt mittelagunevad aia- ja haljastujäätmed; 8",
