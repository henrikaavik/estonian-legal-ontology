      "rdfs:label": "Üürnik",
      "skos:altLabel": [
        {
          "@value": "üürnik",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "isik, kellega Kehtna Vallavalitsuse (edaspidi vallavalitsus kui täitevorgan) korralduse alusel sõlmitakse munitsipaaleluruumi üürileping.",
          "@language": "et"
        },
        {
          "@value": "isik, kellega linn on sõlminud eluruumi üürilepingu.",
          "@language": "et"
        }
      ]
