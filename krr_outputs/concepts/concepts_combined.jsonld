      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_vallavalitsuse_raamatupidamise_sise_eeskiri_t1058672_tehingupartnerid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tehingupartnerid",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avaliku sektori üksuste majandusarvestuses eristatavad majandustehingute osapooled, kellele on omistatud tunnused – tehingupartneri koodid, eesmärgiga võimaldada koostada avaliku sektori üksuste konsolideeritud finantsaruandeid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058672_Par_2"
        }
      ],
