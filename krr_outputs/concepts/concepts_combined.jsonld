      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil_t1059033_pedagoog"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
