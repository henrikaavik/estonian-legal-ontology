        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Operaatorteenus",
      "skos:definition": [
        {
          "@value": "teenus, mille eesmärgiks on korraldada sotsiaaltranspordi tellinud isikute transport soovitud sihtkohta nõuetekohasel viisil ja tingimustel tagades veoteenust osutavate sõidukite maksimaalselt efektiivse kasutuskoormuse.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_operaatorteenuse_osutaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Operaatorteenuse osutaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Operaatorteenuse_osutaja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Operaatorteenuse osutaja",
      "skos:definition": [
        {
          "@value": "Vinni Vallavalitsuse või tema volitatud esindajaga vastava teenuse osutamise lepingu sõlminud isik, kelle ülesandeks on sotsiaaltranspordi korraldamine vastavalt § 5.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
