        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoolekandeasutus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sotsiaaltoetuste_kord_t1050690_hoolekandeasutus"
        },
        {
          "@id": "estleg:Concept_valjaspool_kodu_osutatava_uldhooldusteenuse_korraldamise_ja_t1056739_hoolekandeasutus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hoolekandeasutus",
      "skos:definition": [
        {
          "@value": "sotsiaalhoolekande seaduses nimetatud sotsiaalteenust osutav asutus. Antud määruses loetakse hoolekandeasutuste alla ka statsionaarsed õendusabi haiglad ja hooldusravi haiglad.",
          "@language": "et"
        },
        {
          "@value": "üldhooldusteenust osutav juriidiline isik",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_hoolekandeasutuse_teenuskoha_maksumus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoolekandeasutuse teenuskoha maksumus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_valjaspool_kodu_osutatava_uldhooldusteenuse_korraldamise_ja_t1056739_hoolekandeasutuse_teenuskoha_maksumus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "hoolekandeasutuse teenuskoha maksumus",
      "skos:definition": [
        {
          "@value": "hoolekandeasutuse kehtestatav maksumus, mis sisaldab: - hoolduskulu - (hõlmab tööjõukulu (koos maksudega), tööriietuse ja isikukaitsevahendite kulud, tervisekontrolli ja vaktsineerimise kulud, koolitused ja supervisioon); - hooldusteenuse kulu - isikult võetav tasu teenuse maksumusest majutus- ja toitlustuskuludele ehk hoolekandeasutuse hinnakirja alusel teenuse saaja ülalpidamiseks kuluv summa kalendrikuus, millele lisanduvad vajadusel (sõltuvalt hoolekandeasutusest) kulud ravimitele, isiklikele abivahenditele, sh mähkmed, transpordikulud ja muud personaalselt isikule osutatavad teenused",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
