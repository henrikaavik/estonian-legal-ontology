    {
      "@id": "estleg:Concept_viimsi_valla_reklaamimaarus_t1039864_reklaampind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaampind",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasapinnaline või ruumiline objekt, mis paigaldatakse Viimsi valla haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega; 10) diferentseeritud maksumäär, koefitsient – määruses kehtestatud tavamaksumäärast kõrgem maksumäär",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1039864_Par_1"
        }
      ],
      "estleg:sourceAct": "Viimsi valla reklaamimäärus",
      "rdfs:label": "reklaampind (viimsi_valla_reklaamimaarus_t1039864)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaampind"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_reklaamimaarus_t1039864_mobiilne_konstruktsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
