    {
      "@id": "estleg:Concept_terviklahendus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "terviklahendus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
