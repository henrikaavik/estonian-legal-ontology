        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimiskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "koht, mis on määratud kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas tekkekohast ära veetud reovee ühiskanalisatsiooni juhtimiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046190_Par_2"
        }
      ],
