    {
      "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_andmise_kord_t1052751_abi_vajav_inimene",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "abi vajav inimene",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "inimene, kes ei tule eluga iseseisvalt toime näiteks sotsiaal-majanduslikel põhjustel, puude või erivajaduse tõttu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052751_Par_3"
        }
      ],
      "estleg:sourceAct": "Sotsiaalhoolekandelise abi andmise kord",
