      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_analuutiline_ja_sunteetiline_arvestus"
        }
      ]
    },
    {
      "@id": "estleg:Concept_jogeva_vallavalitsuse_raamatupidamise_sise_eeskiri_t1051084_aktsepteerimine",
      "@type": [
        "owl:NamedIndividual",
