      "rdfs:label": "liikuvusega seotud toimingud",
      "skos:definition": [
        {
          "@value": "püsti, pikali ja istuma saamine, treppidest üles ja alla liikumine, ustest ja väravatest sisse ja välja liikumine",
          "@language": "et"
        },
        {
          "@value": "püsti, pikali ja istuma saamine, treppidest üles ja alla liikumine, ustest sisse ja välja liikumine ja muu selline tegevus",
