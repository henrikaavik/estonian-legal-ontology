        "@id": "estleg:Concept_erivajadus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaalteenuste_osutamise_tingimused_ja_kord_t1052761_hooldusvajadusega_inimene",
      "@type": [
