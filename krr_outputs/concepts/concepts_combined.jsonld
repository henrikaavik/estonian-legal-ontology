    {
      "@id": "estleg:Concept_puude_raiumiseks_loa_andmise_kord_harku_vallas_t1042779_vaartuslik_puu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "väärtuslik puu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "väärtusklassi I ja II kuuluvad puud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042779_Par_2"
        }
      ],
