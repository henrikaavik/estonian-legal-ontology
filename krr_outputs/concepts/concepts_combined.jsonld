      "skos:definition": [
        {
          "@value": "ruumi või ruumide ruumitemperatuurini jahutamiseks vajalik energia, mis sisaldab nii ilmset kui varjatud soojust, arvestades vabasoojust, välispiirde soojusläbivust, infiltratsiooni ja ruumi sissepuhutava ventilatsiooniõhu temperatuuri",
          "@language": "et"
