      ],
      "skos:prefLabel": {
        "@value": "liitumisprojekt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tarbimiskoha liitumispunktist kuni hoonestuseni märgitud kinnistusiseste võrkude (välisvõrkude) projekt, mille alusel ehitatakse tarbimiskoha veevärk ja kanalisatsioon",
