      },
      "rdfs:label": "müüja",
      "skos:definition": [
        {
          "@value": "kaupleja nimel klienti teenindav füüsiline isik või isik, kes müüb kaupa või osutab teenust väljaspool majandus- või kutsetegevust tänava- või turukaubanduse korras",
          "@language": "et"
        },
        {
          "@value": "kaupleja nimel klienti teenindav füüsiline isik või isik, kes müüb kaupa või osutab teenust tänava- või turukaubanduse korras",
          "@language": "et"
        },
        {
          "@value": "kaupleja nimel klienti teenindav füüsiline isik või isik, kes pakub ja müüb kaupa või pakub ja osutab teenust tänava- või turukaubanduse korras",
          "@language": "et"
        },
        {
          "@value": "kaupleja nimel klienti teenindav füüsiline isik, kes müüb kaupa või teenust kandekaubanduse, lühiajalise tänavakaubanduse või turukaubandusena või avalikul üritusel",
          "@language": "et"
        },
        {
          "@value": "levitaja, kes müüb, annab rendile, müüb järelmaksuga või esitleb toodet lõppkasutajatele",
          "@language": "et"
        }
      ],
