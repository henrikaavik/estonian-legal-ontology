      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054000_omapuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk kohtpuhasti on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti (edaspidi ie)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054000_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "omapuhasti (johvi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054000)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omapuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_johvi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054000_purgimiskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimiskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "koht, mis on määratud Jõhvi valla ühisveevärgi ja -kanalisatsiooni arendamise kavas tekkekohast äraveetud reovee ühiskanalisatsiooni juhtimiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054000_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "purgimiskoht (johvi_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054000)",
