    {
      "@id": "estleg:Concept_meetme_kompetentsikeskuste_arendamine_tingimused_t336593_piirkondade_konkurentsivoime",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "piirkondade konkurentsivõime",
      "skos:definition": "piirkondade võime luua eeldusi jätkusuutlike töökohtade pakkumiseks, elujõuliste ettevõtete tekkeks ning erainvesteeringute kaasamiseks, samuti võime luua eeldusi piirkonna elanike arvu stabiliseerimiseks või kasvuks ja külastajate arvu suurendamiseks; 3",
      "estleg:definedIn": [
