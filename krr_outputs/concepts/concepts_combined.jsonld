      "rdfs:label": "muutuvpalk (kohila_vallavalitsuse_palgajuhend_t1060653)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muutuvpalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kohila_vallavalitsuse_palgajuhend_t1060653_tulemustasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tulemustasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
