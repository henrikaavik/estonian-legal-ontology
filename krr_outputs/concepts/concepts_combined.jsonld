      "skos:definition": [
        {
          "@value": "koer, kes on saanud erialase koolituse vastavalt koerajuhtide põhikursuse õppele ja omab vastavat kvalifikatsiooni ja keda kasutatakse politseis, piirivalves, päästeteenistuses või pimeda juhtkoerana",
          "@language": "et"
        }
      ],
