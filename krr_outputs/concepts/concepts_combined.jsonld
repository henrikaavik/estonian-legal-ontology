      ],
      "skos:prefLabel": {
        "@value": "reovesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "üle kahjutuspiiri rikutud ja enne suublasse juhtimist puhastamist vajav vesi; 12) purgimissõiduk (edaspidi sõiduk) – mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi/fekaal purgimiskohta.",
        "@language": "et"
      },
      "estleg:definedIn": [
