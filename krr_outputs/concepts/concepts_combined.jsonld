        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub kinnistute veega varustamine ühisveevärgist või kinnistutelt reovee ärajuhtimine ühiskanalisatsiooni; 14) saasteaine (reoaine) – mis tahes aine, mis võib põhjustada reostust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028459_Par_2"
        }
      ],
