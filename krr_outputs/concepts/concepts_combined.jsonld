      ],
      "skos:prefLabel": {
        "@value": "registreerimisnumber",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Transpordiameti poolt sõidukile omistatud tähtede ja numbrite kombinatsioon. Trollibussi registreerimisnumbriks on omaniku poolt trollibussi registreerimisel antud number või numbrite ja tähtede kombinatsioon",
        "@language": "et"
      },
      "estleg:definedIn": [
