      "rdfs:label": "kohanduse saaja",
      "skos:definition": [
        {
          "@value": "inimene, kelle eluruume kohandatakse tema puudest tuleneva erivajaduse tõttu",
          "@language": "et"
        },
        {
          "@value": "isik, kelle eluruume kohandatakse tema puudest tuleneva erivajaduse tõttu",
          "@language": "et"
        },
        {
          "@value": "isik, kellel on puue puuetega inimeste sotsiaaltoetuste seaduse tähenduses ja kelle eluruume kohandatakse tema puudest tuleneva erivajaduse tõttu",
          "@language": "et"
