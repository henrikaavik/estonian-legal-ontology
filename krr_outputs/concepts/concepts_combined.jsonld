          "@id": "estleg:Concept_kehtna_valla_kula_alevi_voi_alevikuvanema_statuut_t1050358_Kula"
        },
        {
          "@id": "estleg:Concept_kulavanema_statuut_t1005770_Kula"
        },
        {
          "@id": "estleg:Concept_kulavanema_statuut_t1054683_Kula"
        },
        {
          "@id": "estleg:Concept_rapla_vallavolikogu_kogukonnakomisjoni_pohimaarus_t1053899_kula"
        }
      ],
      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Küla",
      "skos:altLabel": [
        {
          "@value": "küla",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": ", aleviku- või alevivanem (edaspidi külavanem) on asula ja elanike ühiste huvide esindaja, kelle on statuudi alusel valinud hääleõiguslikud elanikud. Külavanem on asula elanike ühendaja, hoidja ja edendaja, kes koordineerib ja aitab korraldada asula ühistegevusi ning aitab ellu viia ühisprojekte. Külavanem on riigi ja kohaliku omavalitsuse ametlikult tunnustatud kontaktisik asulas. Koostööd tegevad ühist piiri omavad asulad võivad valida ühise külavanema. 5 (",
          "@language": "et"
        },
        {
          "@value": "Eesti territooriumi haldusjaotuse seaduse § lõikes 2 sätestatud asustusüksuse liik; 4",
          "@language": "et"
        },
        {
          "@value": "Haapsalu linna territooriumil paiknev küla; 2",
          "@language": "et"
        },
        {
          "@value": "Koigi valla haldusterritooriumi osa. Koigi valla külad on: Huuksi, Kahala, Keri, Koigi, Lähevere, Prandi, Päinurme, Rutikvere, Silmsi, Sõrandu, Tamsi, Vaali, Väike-Kareda, Ülejõe. 2 (",
          "@language": "et"
        },
        {
          "@value": "Rapla valla territooriumil paiknev asustusüksus. 2",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      }
    },
