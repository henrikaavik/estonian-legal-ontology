        "@type": "xsd:integer"
      },
      "rdfs:label": "kogukonnateenus",
      "skos:definition": [
        {
          "@value": "kogukonna käivitatud kohalikule arengule ja töökohtade loomisele orienteeritud jätkusuutlik tegevus uute väärtuste loomiseks kogukonna või tema liikmete jaoks; 4",
          "@language": "et"
        },
        {
          "@value": "mittetulundusühenduse poolt kogukonna liikmete heaolule ja kogukonna arengule suunatud teenus või koostöökokkuleppe alusel omavalitsuse poolt mittetulundusühendusele korraldada antud avalik teenus, mida osutatakse vabatahtlikkuse või kehtestatud hinnakirja alusel; 6",
          "@language": "et"
        }
      ]
    },
