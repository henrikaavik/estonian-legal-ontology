      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "muutuvpalk",
      "skos:definition": "isiku palga või töötasu ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest; 8",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058256_Par_2"
        }
      ],
