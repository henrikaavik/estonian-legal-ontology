      "estleg:definesConcept": {
        "@id": "estleg:Concept_vaaramatu_joud"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_nende_kasutam_t1015413_uhenduskraan",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühenduskraan",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "veevarustuse ühendustorul peatoru juures asuv sulgur, mis on viimane sulgemisseade enne kinnistu veevärki",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1015413_Par_2"
        }
      ],
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooniga liitumise ja nende kasutamise eeskiri",
      "rdfs:label": "ühenduskraan (uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_nende_kasutam_t1015413)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhenduskraan"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_nende_kasutam_t1015413_uhendustoru",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühendustoru",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistu veevärki veega varustav või kinnistu kanalisatsioonist reovett vastuvõttev toru peatorust liitumispunktini; 30) ühisveevärk ja –kanalisatsioon - ehitiste ja seadmete süsteem, mille kaudu toimub kinnistute veega varustamine või reovee kanaliseerimine, mis on vee-ettevõtja hallatav või teenindab vähemalt 50 elanikku. Ühisveevärgi ja -kanalisatsioonina käsitatakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat üheskoos. Sademetevee kanalisatsiooni käsitletakse ühiskanalisatsioonina; 31) ühisveevärgi ja -kanalisatsiooni avarii - ühisveevärgi ja -kanalisatsiooni ehitiste või seadmete ettenägematu purunemine või rikkiminek, mille tagajärjel oluliselt halveneb või katkeb klientide veega varustamine ja nende reovee kanaliseerimine, või on ohustatud inimesed, ehitised või keskkond",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1015413_Par_2"
        }
      ],
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooniga liitumise ja nende kasutamise eeskiri",
      "rdfs:label": "ühendustoru (uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_nende_kasutam_t1015413)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhendustoru"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_nende_kasutam_t1015413_uhisvoolne_kanalisatsioon",
      "@type": [
        "owl:NamedIndividual",
