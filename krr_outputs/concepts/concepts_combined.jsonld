      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_messitoetuse_andmise_kord_t1021057_mess",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "mess",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Eestis toimuv ettevõtjate tooteid või teenuseid tutvustav väljapanek, mis toimub väljaspool ettevõtjate müügikohta ja mille eesmärk on laiendada ettevõtjate müügi- ja kontaktvõrgustikku ning leida koostööpartnereid; messikorraldaja - äriühing või mittetulundusühing, sihtasutus või erialaliit, kelle tegevusala on viimase äriregistrile esitatud majandusaasta aruande põhjal messide korraldamine; 2018-01-25",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1021057_Par_3"
        }
      ],
      "estleg:sourceAct": "Messitoetuse andmise kord",
      "rdfs:label": "mess (messitoetuse_andmise_kord_t1021057)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_mess"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_messitoetuse_andmise_kord_t1021057_messistend",
