      "estleg:definesConcept": {
        "@id": "estleg:Concept_omapuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskirja_kehtestamine_t1039009_inimekvivalent",
      "@type": [
        "owl:NamedIndividual",
