    {
      "@id": "estleg:Concept_kaasaegse_ja_uuendusliku_oppevara_uhiskasutuskorralduse_toet_t1038763_taiendusope",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "täiendusõpe",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "õpetajate professionaalset arengut toetavad lahendused, mis on suunatud õpetajate õppevara kasutamiseks vajalike teadmiste ja oskuste süvendamisele ning loovad uusi võimalusi nende poolt omandatud kutsemeisterlikkuse efektiivsemaks kasutamiseks.",
        "@language": "et"
      },
      "estleg:definedIn": [
