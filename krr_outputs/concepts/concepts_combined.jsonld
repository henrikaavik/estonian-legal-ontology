    {
      "@id": "estleg:Concept_laaneranna_vallavalitsuse_ametiasutuse_palgajuhend_t1040865_Teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Teenistuja",
      "skos:definition": "vastavalt avaliku teenistuse seaduse § 5 on avalik teenistuja (edaspidi teenistuja) asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja. 1",
