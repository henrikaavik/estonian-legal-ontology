      }
    },
    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1048492_inimekvivalent",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "inimekvivalent",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühe inimese põhjustatud keskmise ööpäevase tingliku reostuskoormuse ühik. Biokeemilise hapnikutarbe (BHT 7 ) kaudu väljendatud inimekvivalendi väärtus on 60 grammi hapnikku ööpäevas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048492_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
