        "@value": "Tee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "maantee, tänav, jalgtee ja jalgrattatee või muu sõidukite või jalakäijate liiklemiseks kasutatav rajatis, mis võib olla riigi või kohaliku omavalitsuse või muu juriidilise isiku või füüsilise isiku omandis.",
        "@language": "et"
      },
