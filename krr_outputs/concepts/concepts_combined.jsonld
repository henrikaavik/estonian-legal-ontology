          "@value": "andmeliidestus, mis on kahe või enama infosüsteemi vaheline standardiseeritud andmevahetus, mis võimaldab automaatset, turvalist ja masinloetavat andmete edastamist ning sünkroniseerimist erinevate tarkvarade või platvormide vahel; 9",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_koostoodetud_elektrienergia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
