    {
      "@id": "estleg:Concept_kiili_valla_heakorraeeskiri_t1052603_heakord",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heakord",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Kiili valla haldusterritooriumi puhtus ja korrastatus. Avalikku heaolu ja kvaliteetset elukeskkonda soodustavad tegevused kinnis- ja vallasvara ning avaliku koha korrashoiu, puhtuse, ohutuse ja seisundi tagamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052603_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili valla heakorraeeskiri",
