      }
    },
    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Kokkuplaneerimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Kokkuplaneerimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "erinevad veotellimused esitanud klientide samaaegse veo korraldamine eesmärgiga tagada sõidukite maksimaalselt kuluefektiivne koormatus.",
        "@language": "et"
      },
      "estleg:definedIn": [
