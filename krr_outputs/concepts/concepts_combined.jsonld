    {
      "@id": "estleg:Concept_marjamaa_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ee_t1058915_Reoveepuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reoveepuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kogum kindlate dimensioonidega rajatisi ja seadmeid, milles ühiskanalisatsioonivõrgu kaudu või eeskirjas reguleeritud muul viisil kogutud reovesi puhastatakse tasemeni, et seda võib keskkonda ohustamata loodusesse juhtida.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058915_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
