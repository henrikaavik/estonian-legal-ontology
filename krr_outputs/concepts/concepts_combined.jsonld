      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kehtna_valla_raamatupidamise_sise_eeskiri_t1060946_majandustehingute_kirjendaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "majandustehingute kirjendaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötaja, kes lähtudes finantsaruandluse standarditest kirjendab valla majandustehingud raamatupidamisarvestuses nõuetekohases liigenduses. Üldjuhul on majandustehingute kirjendajaks raamatupidaja.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060946_Par_2"
        }
      ],
      "estleg:sourceAct": "Kehtna valla raamatupidamise sise-eeskiri",
