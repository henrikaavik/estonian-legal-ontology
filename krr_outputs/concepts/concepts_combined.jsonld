        "@id": "estleg:Concept_reovee_bioloogiline_puhastamine"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vaike_maarja_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051019_septik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "septik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pealt kinnine väljavooluga reovee mehaaniline puhasti, millesse sadenenud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051019_Par_2"
        }
      ],
