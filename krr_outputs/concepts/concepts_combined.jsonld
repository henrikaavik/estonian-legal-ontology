      },
      "rdfs:label": "reostusgrupp",
      "skos:altLabel": [
        {
          "@value": "Reostusgrupp",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "reovee reostustaset näitavate reostusnäitajate vahemik, mis on aluseks ülenormatiivse reostuse tasu kehtestamisele. Reostusgrupp on veeteenuse hinna alus; 25",
          "@language": "et"
        },
        {
          "@value": "reovee reostusnäitajate piirväärtuste gruppide ja maksimaalsete reoainete sisalduse kujunemise vahemik, sõltuvalt reostatusest kehtestatakse ülenormatiivse reostuse tasu",
          "@language": "et"
        },
        {
          "@value": "reovee reostustaset näitavate reostusnäitajate vahemik, mis on aluseks veeteenuse hinna määramisele või ülenormatiivse reostuse tasu kehtestamisele; 15",
          "@language": "et"
        },
        {
          "@value": "reovee reostustaset näitavate reostusnäitajate vahemik, mis on aluseks ülenormatiivse reostuse tasu kehtestamisele. 18",
          "@language": "et"
        },
        {
          "@value": "reovee reostustaset näitavate reostusnäitajate vahemik, mis on aluseks ülenormatiivse reostuse tasu kehtestamisele. Reostusgrupp on veeteenuse hinna alus. Konkurentsiametiga või kohaliku omavalitsusega kooskõlastatud veeteenuse hinna kehtestab vee- ettevõtja; 11",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "20",
        "@type": "xsd:integer"
      }
    },
