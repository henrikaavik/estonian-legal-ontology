      "skos:definition": [
        {
          "@value": "ja kontrollisüsteemide audit määruse tähenduses on audit «Perioodi 2004–2006 struktuuritoetuse seaduse» § 6 lõike 1 tähenduses (edaspidi audit ). 5 (",
          "@language": "et"
        },
        {
          "@value": "või kontrollorgan on käesoleva määruse tähenduses juhatus, nõukogu, täis- või usaldusühingut esindama volitatud osanik, prokurist, asutaja kuni juriidilise isiku registrisse kandmiseni, likvideerija, pankrotihaldur, audiitor, revident või revisjonikomisjon. 3 (",
          "@language": "et"
        },
        {
          "@value": "või kontrollorgan on käesoleva määruse tähenduses juhatus, nõukogu, täis- või usaldusühingut esindama volitatud osanik, prokurist, asutaja kuni juriidilise isiku registrisse kandmiseni, likvideerija, pankrotihaldur, audiitor, revident või revisjonikomisjon. 5 (",
          "@language": "et"
        }
      ]
    },
