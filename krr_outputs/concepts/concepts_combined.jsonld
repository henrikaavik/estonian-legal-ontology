    {
      "@id": "estleg:Concept_ulenurme_valla_heakorraeeskiri_t1004353_tuleohtlik_aeg",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tuleohtlik aeg",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "metsa ja muu taimestikuga kaetud alal algab kevadel pärast lume sulamist ning lõpeb sügisel vihmaste ilmade saabumisel. Tuleohtliku aja alguse ja lõpu määrab Eesti Meteoroloogia ja Hüdroloogia Instituut ning teavitab sellest avalikkust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1004353_Par_2"
        }
      ],
      "estleg:sourceAct": "Ülenurme valla heakorraeeskiri",
