      "skos:definition": [
        {
          "@value": "töötajate gruppidele palga määramise aluseks olev palgavahemik, mis sõltub töökohale esitatud nõuetest, ülesannete keerukusest, tööülesannete täitmisega kaasnevast vastutusest",
          "@language": "et"
        },
        {
