    {
      "@id": "estleg:Concept_jaatmevedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmevedaja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
