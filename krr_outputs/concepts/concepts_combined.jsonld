        "@type": "xsd:integer"
      },
      "rdfs:label": "juhtimisgrupp",
      "skos:definition": [
        {
          "@value": "sündmuse lahendamiseks ning asutuste ja isikute koostöö paremaks tagamiseks moodustatud juhtimisstruktuur, mis moodustatakse vajaduse korral sündmuskohal enne seda, kui sündmuse juht moodustab staabi",
          "@language": "et"
        }
      ],
