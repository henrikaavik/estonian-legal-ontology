      "rdfs:label": "kinnistu veevärk",
      "skos:definition": [
        {
          "@value": "liitumispunktist kinnistupoolsed ehitised ja seadmed (seal- hulgas hoovitorustikud, ehitiste siseveevärk jne) kinnistu veega varustamiseks ühisveevärgist",
          "@language": "et"
        },
        {
          "@value": "liitumispunktist kinnistupoolsed ehitised ja seadmed (sealhulgas ehitiste siseveevärk) kinnistu veega varustamiseks ühisveevärgist",
          "@language": "et"
        },
        {
          "@value": "liitumispunktist kinnistupoolsed ehitised ja seadmed (sealhulgas hoovitorustikud, ehitiste siseveevärk jne) kinnistu veega varustamiseks ühisveevärgist",
          "@language": "et"
        },
        {
          "@value": "kinnistu veevärk ja kanalisatsioon „Ühisveevärgi ja -kanalisatsiooni seaduse“ § 11 mõttes",
