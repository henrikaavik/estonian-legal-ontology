    {
      "@id": "estleg:Concept_valga_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1042793_omapuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk kohtpuhasti on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti (edaspidi ie)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042793_Par_2"
        }
      ],
      "estleg:sourceAct": "Valga valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "omapuhasti (valga_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1042793)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omapuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valga_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1042793_purgimiskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimiskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "koht, mis on määratud kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas tekkekohast äraveetud reovee ühiskanalisatsiooni juhtimiseks; 8) purgimissõiduk (edaspidi sõiduk) – mahutiga auto, mille abil tühjendatakse reovee kogumismahutit ja veetakse reovesi/fekaal purgimiskohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042793_Par_2"
        }
      ],
      "estleg:sourceAct": "Valga valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "purgimiskoht (valga_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1042793)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_purgimiskoht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_valga_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1042793_purgimisteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimisteenus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee kohtkäitlusesüsteemist reovee või –sette eemaldamine ja äravedu purgimissõidukiga ning selle väljutamine purgimiskohta; 10) reovee bioloogiline puhastamine ehk sekundaarne puhastamine on reoveest reoainete kõrvaldamine bioloogiliste protsesside toimel, mille tulemusena heitvesi vastab Vabariigi Valitsuse 29.11.2012. a määruses nr 99 “ Reovee puhastamise ning heit- ja sademevee suublasse juhtimise kohta esitatavad nõuded, heit- ja sademevee reostusnäitajate piirmäärad ning nende nõuete täitmise kontrollimise meetmed“ esitatud heitvee reostusnäitajate piirväärtustele biokeemilise hapnikutarbe, heljuvaine ja keemilise hapnikutarbe osas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042793_Par_2"
        }
      ],
      "estleg:sourceAct": "Valga valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "purgimisteenus (valga_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1042793)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_purgimisteenus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
