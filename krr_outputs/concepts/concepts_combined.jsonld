    {
      "@id": "estleg:Concept_ekspordi_arendamise_toetamise_tingimused_ja_kord_t1000010_ekspordiplaan",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ekspordiplaan",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "väljaspool Eestit asuvatele turgudele suunatud turundusplaan, mille elluviimiseks rahastamist taotletakse. Ekspordiplaanis kirjeldatakse ettevõtja poolt ekspordiks pakutavaid tooteid või teenuseid, selgitatakse välja potentsiaalsed sihtturud, analüüsitakse konkurentsiolukorda sihtturgudel, seatakse konkreetsed eesmärgid ekspordi müügitulu suurendamiseks ning koostatakse tegevuskava seatud eesmärkide saavutamiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000010_Par_4"
        }
      ],
