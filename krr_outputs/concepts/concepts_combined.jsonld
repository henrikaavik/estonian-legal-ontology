    {
      "@id": "estleg:Concept_keila_linna_heakorraeeskiri_t1023346_kasutusest_valjas_olev_soiduk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kasutusest väljas olev sõiduk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõiduk, mis on registreeritud liiklusregistris, kuid millel puudub kehtiv liikluskindlustus rohkem kui 60 päeva või tehnoülevaatus rohkem kui 60 päeva või sõiduk on liiklemiseks tehniliselt korrast ära.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1023346_Par_2"
        }
      ],
      "estleg:sourceAct": "Keila linna heakorraeeskiri",
