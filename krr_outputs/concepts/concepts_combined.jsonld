      "skos:definition": {
        "@value": "reovee kogumismahuti (sh kuivkäimla lampkast) või omapuhasti (septik filterväljakuga või biopuhasti imbväljakuga)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057667_Par_2"
        }
      ],
      "estleg:sourceAct": "Narva-Jõesuu linna reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "reovee kohtkäitlusrajatis (narva_joesuu_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1057667)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_kohtkaitlusrajatis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_joesuu_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1057667_reovee_kogumismahuti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee kogumismahuti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tootja toimivusdeklaratsiooniga, pealt suletav, lekkekindel äravooluta rajatis reovee ajutiseks kogumiseks; 5) omapuhasti-septik on pealt kinnine väljavooluga reovee mehhaaniline puhasti, millesse sadenenud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt. 6) omapuhasti-biopuhasti on pealt kinnine väljavooluga reovee bioloogiline puhasti, milles läbivoolavas reovees sisalduvat orgaanilist ainet lagundatakse aeroobsetes tingimustes mikroorganismide toimel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057667_Par_2"
        }
      ],
      "estleg:sourceAct": "Narva-Jõesuu linna reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "reovee kogumismahuti (narva_joesuu_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1057667)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_kogumismahuti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_joesuu_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1057667_imbvaljak_ehk_imbsusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "imbväljak ehk imbsüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "biopuhastile järgnev heitvee puhastussüsteem, kus killustikukihi sisse teatud kindlate vahedega paigaldatud imbtorud jaotavad heitvee ühtlaselt üle kogu filtreeriva ala (imbväljaku) ning tänu millele imendub sinna valguv heitvesi ühtlaselt pinnasesse, läbides seejuures pinnaseosakestele kasvanud biokile, mis lagundab vees sisalduvad tahked ainekübemed aeroobselt",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057667_Par_2"
        }
      ],
      "estleg:sourceAct": "Narva-Jõesuu linna reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "imbväljak ehk imbsüsteem (narva_joesuu_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1057667)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_imbvaljak_ehk_imbsusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_joesuu_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1057667_filtervaljak_ehk_filtersusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "filterväljak ehk filtersüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "septikule või biopuhastile järgnev heitvee puhastussüsteem, mis rajatakse juhul, kui imbsüsteemi paigalduskoha pinnas ei ima või ei lase vett läbi. Killustikukihi alla ehitatakse liivast filtreerimiskiht ja selle alla paigaldatakse drenaažitorud, mis juhivad läbi liivakihi valgunud ja puhastatud vee kogumiskaevu ja sealt suublasse. Filtersüsteem isoleeritakse ümbritsevast pinnasest geomembraaniga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057667_Par_2"
        }
      ],
      "estleg:sourceAct": "Narva-Jõesuu linna reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "filterväljak ehk filtersüsteem (narva_joesuu_linna_reovee_kohtkaitluse_ja_araveo_eeskiri_t1057667)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_filtervaljak_ehk_filtersusteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
