    {
      "@id": "estleg:Concept_viimsi_valla_teede_ja_tanavate_sulgemise_maks_t1028011_jalgtee_taielik_sulgemine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jalgtee täielik sulgemine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jalgtee sulgemine selliselt, kus mittesuletava osa laius on alla 1,5 m",
        "@language": "et"
      },
