      },
      "skos:definition": {
        "@value": "korterelamu juurde kuuluv maatükk (maaüksus) või selle osa või korteriühistu kasutusse või valdusesse antud maatükk (maaüksus) või selle osa",
        "@language": "et"
      },
      "estleg:definedIn": [
