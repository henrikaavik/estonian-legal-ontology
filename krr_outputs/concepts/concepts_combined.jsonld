        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "palgaaste",
      "skos:definition": [
        {
          "@value": "teenistuskohtade palgaastmele vastav põhipalgavahemik. Palgaaste on seotud teenistuskohtade grupiga, kuhu on koondatud vallavalitsuse jaoks sarnase tööväärtusega teenistuskohad; 14",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_palgafondina_kasitletakse_esindusvoistkonna_nimekirja_kuuluvatele_inimestele_suu",
