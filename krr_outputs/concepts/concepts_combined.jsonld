    {
      "@id": "estleg:Concept_reklaamimaksu_kehtestamine_ja_reklaami_paigaldamise_kord_t1057748_Reklaamipind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reklaamipind",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "objekt, mida kasutatakse Muhu valla haldusterritooriumil avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaamipind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057748_Par_2"
        }
      ],
