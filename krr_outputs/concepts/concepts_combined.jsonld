      "rdfs:label": "jäätmetekitaja",
      "skos:definition": [
        {
          "@value": "isik või riigi või kohaliku omavalitsuse üksuse asutus, kelle tegevuse käigus tekivad jäätmed, või isik, kes sooritab jäätmetega toiminguid, mille tagajärjel jäätmete olemus või kooslus muutub",
          "@language": "et"
        },
        {
          "@value": "isik või riigi või kohaliku omavalitsuse üksuse asutus, kelle tegevuse käigus tekib jäätmeid või isik, kes sooritab jäätmetega toiminguid, mille tagajärjel jäätmete olemus või koostis muutub",
          "@language": "et"
        },
        {
          "@value": "isik, riigi või kohaliku omavalitsuse asutus, kelle tegevuse käigus tekivad jäätmed või isik, kes sooritab jäätmetega toiminguid, mille tagajärjel jäätmete olemus või koostis muutub (näiteks tegeleb jäätmete eeltöötlusega või segab jäätmeid)",
          "@language": "et"
        },
        {
          "@value": "jäätmevaldaja või muu isik või riigi või kohaliku omavalitsuse üksuse asutus, kelle tegevuse käigus tekivad jäätmed, või isik, kes sooritab jäätmetega toiminguid, mille tagajärjel jäätmete olemus või kooslus muutub",
          "@language": "et"
        }
      ],
