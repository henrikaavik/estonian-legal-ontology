    {
      "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooni_kasutamis_t1058898_Reoveepuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reoveepuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kogum kindlate dimensioonidega rajatisi ja seadmeid, milles ühiskanalisatsioonivõrgu kaudu või eeskirjas reguleeritud muul viisil kogutud reovesi puhastatakse tasemeni, et seda võib keskkonda ohustamata loodusesse juhtida.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058898_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla ühisveevärgi ja -kanalisatsiooni kasutamise eeskiri",
