      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "palga",
      "skos:definition": [
        {
          "@value": "ja töötasuvahemik – ametniku ja töötajate gruppidele palga ja töötasu määramise aluseks olev palga- ja töötasu vahemik. Palga- ja töötasuvahemik sõltub ameti- või töökohale esitatud nõuetest, ülesannete keerukusest, tööülesannete täitmisega kaasnevast vastutusest ja lojaalsusest.",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_palk"
        }
      ]
    },
    {
