      ],
      "skos:prefLabel": {
        "@value": "avalikult kasutatav maa-ala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "määratlemata isikute ringile kasutamiseks antud ning kasutuses olev üldjuhul hooneteta maa, millel võivad paikneda üksnes abihooned, nt tee, tänav, väljak, park, puhke- või virgestusala vms; käesoleva määruse tähenduses ei kuulu kalmistu maa avalikult kasutatava maa-ala hulka",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051796_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
