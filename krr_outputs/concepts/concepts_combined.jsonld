    },
    {
      "@id": "estleg:Concept_rohelise_investeerimisskeemi_elektriautode_toetus_kasutamise_t1001255_liising_voi_liisimine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "liising või liisimine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "elektriauto või elektriauto koos selle aku rentimisega soetamine krediidiasutusega sõlmitava liisingulepingu alusel, mille puhul kohustub krediidiasutus omandama taotleja määratud müüjalt elektriauto või elektriauto koos selle aku rentimisega ja andma selle või need tasu eest pikaajaliseks perioodiks taotlejale kasutamiseks, sealjuures jääb lepingu perioodil elektriauto omanikuks või elektriauto omanikuks ja selle aku rentnikuks krediidiasutus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1001255_Par_3"
        }
      ],
      "estleg:sourceAct": "Rohelise investeerimisskeemi „Elektriautode toetus” kasutamise tingimused ja kord",
