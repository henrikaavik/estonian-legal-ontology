          "@id": "estleg:Concept_tervishoiuteenuste_kvaliteedi_ja_patsiendiohutuse_tagamise_n_t1059772_inimkesksus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "inimkesksus",
      "skos:definition": [
        {
          "@value": "tervishoiuteenuse osutamise viis, mille puhul nähakse tervishoiuteenust kasutavat inimest tervikuna ja võrdse partnerina, kellega tehakse koostööd sobivate lahenduste leidmiseks nii tervise säilitamisel ja parandamisel kui ka haigustega toimetulekul, arvestades ühtlasi inimese vajadusi, tahet ja väärtushinnanguid ning sotsiaalset ja kultuurilist tausta",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_innovatsioon",
