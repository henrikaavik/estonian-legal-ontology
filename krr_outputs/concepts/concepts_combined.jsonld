      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_sisekontrolor"
        }
      ]
    },
    {
      "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Sisekontrollimeede",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Sisekontrollimeede",
      "skos:definition": "asutuses sisekontrolli teostamisel kasutatavad abinõud, mis on suunatud kõrvalekallete või pettuste ennetamisele. Ennetava meetme osas rakendatakse ametnike ja töötajate töökohustuste lahusust, tegvuste kooskõlastust ja kinnitamist, ametnike ja töötajate erialast täiendkoolitust, valla IT-süsteemi tehnoloogilisi võimalusi. Vallas võib kasutada ka muid sisekontrollimeetmeid, mis tagavad sisekontrolli eesmärgi saavutamise. 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052595_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla sisekontrolli rakendamise kord",
      "rdfs:label": "Sisekontrollimeede (johvi_valla_sisekontrolli_rakendamise_kord_t1052595)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_sisekontrollimeede"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_sisekontrollimeede"
        }
      ]
    },
    {
      "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Sisekontrolori_tooplaan",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Sisekontrolöri tööplaan",
      "skos:definition": "sisekontrolli läbiviimise aastaplaan, mis kinnitatakse vallavalitsuse korraldusega ja tehakse kättesaadavaks vallavalitsuse ametiasutuste ja nende ametiasutuste hallatavate asutuste juhtidele või valla valitseva mõju all oleva äriühingu, sihtasutuse ja mittetulundusühingu juhtorganitele. 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052595_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla sisekontrolli rakendamise kord",
      "rdfs:label": "Sisekontrolöri tööplaan (johvi_valla_sisekontrolli_rakendamise_kord_t1052595)",
      "estleg:definesConcept": {
