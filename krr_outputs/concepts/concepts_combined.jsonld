    {
      "@id": "estleg:Concept_johvi_valla_sisekontrolli_rakendamise_kord_t1052595_Asutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Asutus",
      "skos:definition": "vallavalitsus ja vallavalitsuse hallatavad asutused, vallavalitsuse valitseva ja olulise mõju all olevad sihtasutused, mittetulundusühingud, äriühingud. 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052595_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõhvi valla sisekontrolli rakendamise kord",
