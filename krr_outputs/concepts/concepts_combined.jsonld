      },
      "rdfs:label": "Rahvusvaheline Büroo",
      "skos:definition": [
        {
          "@value": "Ülemaailmse Intellektuaalomandi Organisatsiooni (WIPO) Rahvusvaheline Büroo, kes võtab vastuvõtvatelt ametitelt vastu PCT taotlusi ja vahendab neid märgitud ametitele või märgitud ja väljavalitud ametitele ning teistele PCT ametitele; 4",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_rahvusvaheline_kultuuri",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rahvusvaheline kultuuri",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rahvusvaheliste_kultuuri_ja_spordisundmuste_toetamise_tingim_t1046611_rahvusvaheline_kultuuri"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rahvusvaheline kultuuri",
      "skos:definition": [
        {
          "@value": "ja spordisündmus (edaspidi sündmus ) on Eestis aset leidev rahvusvahelisi kaaskorraldajaid ja/või osalejaid ja/või pealtvaatajaid kaasav üksiksündmus või sündmuste sari, millel esineb turutõrge ning mille toetamise tulemusena on rahvusvaheliste kaaskorraldajate, välismaiste toetajate toetuse arvelt tehtavatelt kuludelt, välisosalejate ja väliskülastajate poolt Eestis tehtud kuludelt riigile laekuv hinnanguline täiendav maksutulu vähemalt võrdne toetuse 1,2 kordse suurusega; RT I 2025-10-22 1 122102025001 2025-10-25 1 1<sup>1</sup>) sündmuste sari on kahest kuni viiest ühe valdkonna üksiksündmusest koosnev tervik, mille üksiksündmuse kestus ei ületa kahte nädalat, kõik üksiksündmused korraldab sama käesoleva määruse § 5 lõikes 1 nimetatud isik, kõik üksiksündmused toimuvad 12 kuu jooksul, iga üksiksündmus on rahvusvaheline ning omab majanduslikku mõju ning mille üksiksündmuste kogumajanduslik mõju vastab käesoleva paragrahvi punktis 1 nimetatud suurusele; RT I 2025-10-22 1 122102025001 2025-10-25 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_rahvusvaheline_kulastustaotlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rahvusvaheline külastustaotlus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_riigisaladuse_ja_salastatud_valisteabe_kaitse_kord_t317593_rahvusvaheline_kulastustaotlus"
        }
