        "@id": "estleg:Concept_muugiala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaubanduse_korraldamine_tallinna_linnas_t1056502_muugiala_valitseja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "müügiala valitseja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "müügiala omanik. Tallinna linna omandis oleva müügiala puhul loetakse müügiala valitsejaks linnavara valitseja, kelle valitsemisel on müügiala kui linnavara vastavalt linnavolikogu kehtestatud linnavara valitsemise alustele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056502_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaubanduse korraldamine Tallinna linnas",
      "rdfs:label": "müügiala valitseja (kaubanduse_korraldamine_tallinna_linnas_t1056502)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muugiala_valitseja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaubanduse_korraldamine_tallinna_linnas_t1056502_muugiluba",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "müügiluba",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutuse poolt välja antud dokument, mis annab kauplejale õiguse kasutada selles nimetatud müügiala kindlaks määratud ajal kauba või teenuse müügiks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056502_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaubanduse korraldamine Tallinna linnas",
      "rdfs:label": "müügiluba (kaubanduse_korraldamine_tallinna_linnas_t1056502)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muugiluba"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaubanduse_korraldamine_tallinna_linnas_t1056502_muuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "müüja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kaupleja nimel klienti teenindav füüsiline isik, kes müüb kaupa või teenust kandekaubanduse, lühiajalise tänavakaubanduse või turukaubandusena või avalikul üritusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056502_Par_2"
        }
      ],
