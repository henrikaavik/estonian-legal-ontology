      },
      "skos:definition": {
        "@value": "Eesti majanduse tegevusalade klassifikaator, mis on kehtestatud justiitsministri 28. detsembri 2005. a määruse nr 59 „Kohtule dokumentide esitamise kord” lisas 16 „Eesti majanduse tegevusalade klassifikaator (EMTAK)”",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056746_Par_4"
        }
      ],
