        },
        {
          "@id": "estleg:Concept_nouded_energiamargise_andmisele_ja_energiamargisele_t1029420_energiakasutus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiakasutus",
      "skos:definition": [
        {
          "@value": "soojus- või elektrienergia kasutus vaadeldavas korterelamus; 2",
          "@language": "et"
        },
        {
          "@value": "elektri- või soojusenergia kasutus vaadeldavas süsteemipunktis. Energiakasutus arvutatakse netoenergiavajadusest, võttes arvesse süsteemikaod ja kaod energia muundamisel. Tehnosüsteemi lõpp-punktis (üldjuhul liitumispunkt energiavõrguga) võrdub tehnosüsteemi energiakasutus tarnitud energia ja lokaalse taastuvenergia summaga; 4",
          "@language": "et"
        },
        {
          "@value": "jäätmete energiakasutus jäätmeseaduse mõistes; 3",
          "@language": "et"
        },
        {
          "@value": "soojus- või elektrienergia kasutus korterelamus; 2",
          "@language": "et"
        },
        {
          "@value": "soojus- või elektrienergia kasutus vaadeldavas korterelamus; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_energiamargis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiamärgis",
