        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lisatasu täiendavate ülesannete eest",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_harku_valla_ametiasutuste_ja_palgaliste_vallavalitsuse_liikm_t1059584_lisatasu_taiendavate_ulesannete_eest"
