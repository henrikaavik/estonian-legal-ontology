    },
    {
      "@id": "estleg:Concept_luganuse_valla_jaatmehoolduseeskiri_t1057045_suurjaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "suurjäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olmejäätmed, mida kaalu või mahu tõttu ei ole võimalik paigutada segaolmejäätmete kogumismahutisse (mööbliesemed, vaibad, madratsid, kardinapuud, kraanikausid jms). Suurjäätmetena ei käsitata ehitusjäätmeid ning probleemtooteid (autoromud või nende osad, vanarehvid, elektri- ja elektroonikaseadmeid või nende jäätmeid, pesumasinad, telerid, külmkapid, elektripliidid) ja muid tootjavastutusega hõlmatud jäätmeid",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057045_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla jäätmehoolduseeskiri",
      "rdfs:label": "suurjäätmed (luganuse_valla_jaatmehoolduseeskiri_t1057045)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_suurjaatmed"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_jaatmehoolduseeskiri_t1057045_tuhisoit",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tühisõit",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vedaja poolt jäätmevaldaja kinnistule või krundile tehtud sõit, mille eesmärk oli osutada jäätmeveo teenust, kuid mille käigus ei olnud võimalik jäätmeid ära vedada jäätmevaldaja poolse eeskirjas sätestatud nõuete täitmata jätmise tõttu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057045_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla jäätmehoolduseeskiri",
      "rdfs:label": "tühisõit (luganuse_valla_jaatmehoolduseeskiri_t1057045)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tuhisoit"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_jaatmehoolduseeskiri_t1057045_vedaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vedaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmekäitleja, kellele kohalik omavalitsus on riigihanke tulemusena andnud teenuste kontsessiooni korraldatud jäätmeveoga hõlmatud jäätmete vedamiseks Lüganuse valla haldusterritooriumil. Käesoleva paragrahvi lõikes 1 nimetamata termini kasutamisel lähtutakse jäätmeseaduses, pakendiseaduses ja teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057045_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla jäätmehoolduseeskiri",
      "rdfs:label": "vedaja (luganuse_valla_jaatmehoolduseeskiri_t1057045)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vedaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
