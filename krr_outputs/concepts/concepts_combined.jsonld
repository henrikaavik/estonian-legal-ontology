      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_haapsalu_linna_hajaasustuspiirkonna_teede_talihoolduse_teost_t1052668_rasked_ilmaolud"
        },
        {
          "@id": "estleg:Concept_mulgi_valla_lumetorje_teostamise_kord_t1055015_rasked_ilmaolud"
        },
        {
          "@id": "estleg:Concept_rakvere_valla_heakorraeeskiri_t1049363_rasked_ilmaolud"
        },
        {
          "@id": "estleg:Concept_tee_seisundinouded_t1030329_rasked_ilmaolud"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rasked ilmaolud",
      "skos:definition": [
        {
          "@value": "ilmastikutingimused, mille puhul esineb vähemalt üks järgmistest asjaoludest: katkematu lumesadu, mille jooksul sajab vähemalt 10 cm lund nelja tunni jooksul, lumesadu, mille jooksul sajab vähemalt 5 cm lund nelja tunni jooksul, kui samaaegselt on tugev tuul puhanguti üle 12 m/s ning lumi tekitab ohtlikud tuisuvaalud üle lumekihi kriitilise paksuse, või muu ilmastikutingimustest tingitud olukord, kus kehtestatud seisundinõuete tagamine võib olulisel määral olla raskendatud",
          "@language": "et"
        },
        {
          "@value": "ilmastikutingimustest tulenev teeolude oluline halvenemine",
          "@language": "et"
        },
        {
          "@value": "on lumesadu üle 20 cm lund 24 tunni jooksul, tuisk kestusega üle 6 tunni",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rasked_ilmastikuolud",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rasked ilmastikuolud",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_mustvee_valla_avalikuks_kasutamiseks_maaramata_erateedel_lum_t1062768_rasked_ilmastikuolud"
        },
        {
          "@id": "estleg:Concept_heakorraeeskiri_t1049643_rasked_ilmastikuolud"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "rasked ilmastikuolud",
      "skos:definition": [
        {
          "@value": "ilmastikuolud, mille puhul esineb vähemalt üks järgmistest asjaoludest: katkematu lumesadu, mille jooksul sajab vähemalt 10 cm lund nelja tunni jooksul; lumesadu, mille jooksul sajab vähemalt 5 cm lund nelja tunni jooksul ja samal ajal esineb tuulepuhanguid üle 12 m/s; muu ilmastikuoludest tingitud olukord, mille tõttu on väga raske tagada tee vastavust seisundinõuetele",
          "@language": "et"
        },
        {
          "@value": "olukord, kus intensiivne lumesadu, tuisk, tugev tuul või muud ilmastikutingimused muudavad lumetõrje ajutiselt ebamõistlikuks või ohtlikuks ning takistavad tööde tõhusat teostamist",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raskmetall",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "raskmetall",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_jaatmete_liigitamise_kord_ja_jaatmenimistu_t1032201_raskmetall"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "raskmetall",
      "skos:definition": [
        {
          "@value": "iga antimoni-, arseeni-, kaadmiumi-, kroom(VI)-, vase-, plii-, elavhõbeda-, nikli-, seleeni-, telluuri-, talliumi- ja tinaühend ning need materjalid metallilises vormis, juhul kui need on klassifitseeritud ohtlikeks aineteks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raskustes_olev_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "raskustes olev ettevõtja",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rohetehnoloogiate_arendamise_toetuse_andmise_tingimused_ja_k_t1058554_raskustes_olev_ettevotja"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "raskustes olev ettevõtja",
      "skos:definition": [
        {
          "@value": "ettevõtja, mis vastab üldise grupierandi määruse artikkel 2 punktis 18 või IPCEI teatise punkti 10 alapunktis (a) nimetatud kriteeriumitele, välja arvatud iduettevõte või kasvuettevõte, mille puhul ei arvata aktsia- või osakapitali hulka ülekurssi; 20) teadus- ja arendustöötaja – teadus- ja arendustegevusega tegelev vähemalt magistrikraadiga või sellele vastava kvalifikatsiooniga isik.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
