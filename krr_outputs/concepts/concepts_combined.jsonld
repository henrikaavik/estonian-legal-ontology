          "@id": "estleg:Concept_keskne_riigihange"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_korruptsiooni_valtimise_standardklauslid",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "korruptsiooni vältimise standardklauslid",
      "skos:definition": "lepingusse lisatavad või lepingus sisalduvad tingimused, mis hõlmavad lepingupoolte kohustusi, mis on seotud korruptsiooni vältimisega, ja vastutust korruptsioonivastaste meetmete rikkumise eest; 7",
