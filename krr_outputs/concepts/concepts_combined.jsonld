        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "väikepuhasti",
      "skos:definition": [
        {
          "@value": "reoveepuhasti, mille projekteeritud reostuskoormus on 50-1999 ie; 5) filter- ja imbsüsteem – koredast pinnasest (kruus, kergkruus või killustik) ja reovee jaotussüsteemist ehitatud tehislooduslik süsteem reovee bioloogiliseks puhastamiseks bakterite abil ja keskkonda (suublasse) juhtimiseks. Filter- või imbsüsteemi ette paigaldatakse septik, kus toimub reovee mehhaaniline puhastus või omapuhasti, kus toimub reovee bioloogiline puhastamine",
          "@language": "et"
        },
        {
          "@value": "suurema kui 5 m 3 ööpäevase (reostuskoormus suurem kui 50 ie) jõudlusega reoveepuhasti, mis ei kuulu vee-ettevõtjale.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
