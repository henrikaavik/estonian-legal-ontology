      },
      "skos:definition": {
        "@value": "tarbimiskoha veevärki veega varustav või tarbimiskoha kanalisatsioonist reo- või sademevett ärajuhtiv toru peatorust liitumispunktini, viimane kaasa arvatud; 15) ühisveevärk ja -kanalisatsioon – ehitiste ja seadmete süsteem, mille kaudu varustatakse tarbijaid joogiveega ja juhitakse ära ning puhastatakse reo- ning sademevett ning mille projekteeritud jõudlus on vähemalt kümme kuupmeetrit ööpäevas ja mis teenindab vähemalt 50 inimest või mille projekteeritud jõudlus on alla kümne kuupmeetri ööpäevas või mis teenindab alla 50 inimese, mille kohaliku omavalitsuse üksus on ühisveevärgi ja -kanalisatsiooni arendamise kavaga määranud ühisveevärgiks ja -kanalisatsiooniks. Ühisveevärgi ja -kanalisatsioonina käsitletakse ühisveevärki või ühiskanalisatsiooni eraldi või mõlemat koos.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059912_Par_2"
        }
      ],
      "estleg:sourceAct": "Põlva valla ühisveevärgi ja -kanalisatsiooniga liitumise eeskiri",
      "rdfs:label": "ühendustoru (polva_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_eesk_t1059912)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_uhendustoru"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
