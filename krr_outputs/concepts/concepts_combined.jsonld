    {
      "@id": "estleg:Concept_hoone_energiatohususe_arvutamise_metoodika_t1029856_energiatohususarv",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiatõhususarv",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "arvutuslik summaarne tarnitud energiate kaalutud erikasutus hoone tüüpilisel kasutusel, mis kajastab hoone kompleksset energiakasutust nii sisekliima tagamiseks, tarbevee soojendamiseks kui ka olme- ja muude elektriseadmete kasutamiseks hoone toatemperatuuriga pinna ruutmeetri kohta hoone tüüpilisel kasutamisel ja mida väljendatakse kilovatt-tundides hoone toatemperatuuriga pinna ruutmeetri kohta aastas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1029856_Par_2"
        }
      ],
      "estleg:sourceAct": "Hoone energiatõhususe arvutamise metoodika",
