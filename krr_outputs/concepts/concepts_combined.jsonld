    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_energiamargis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiamärgis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav märgis, mis annab infot projekteeritava või olemasoleva hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
      "rdfs:label": "energiamärgis (korterelamute_energiatohususe_toetuse_tingimused_t1056183)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_energiamargis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_energiatohususarv",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiatõhususarv",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "arvutuslik summaarne tarnitud energiate kaalutud erikasutus hoone tüüpilisel kasutusel, millest arvatakse maha summaarne eksporditud energiate erikasutus; 5) „Euroopa uus Bauhaus” – algatus, mille eesmärk on hõlbustada terviklikke, koostööl põhinevaid ja valdkondadevahelisi ühiskondlikke muutusi kolmes mõõtmes, milleks on ruumikogemuse esteetiline kvaliteet, ruumilahenduse kestlikkus ja kliimakindlus ning elanike kaasamine ruumiloomeprotsessi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
      "rdfs:label": "energiatõhususarv (korterelamute_energiatohususe_toetuse_tingimused_t1056183)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_energiatohususarv"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_korterelamu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "korterelamu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "enne 2000. aastat kasutusse võetud elamu, milles on kolm või enam korteriomandit, kui § 6 lõikest 3 ei tulene teisiti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
      "rdfs:label": "korterelamu (korterelamute_energiatohususe_toetuse_tingimused_t1056183)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korterelamu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_lokaalne_taastuvenergia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lokaalne taastuvenergia",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitusseadustiku § 65 lõike 3 alusel kehtestatud nõuetele vastav energia, mida kasutatakse eelkõige hoone toimimiseks või kasutamiseks; muinsus- ja miljööväärtuslik korterelamu – üld- või detailplaneeringu alusel miljööväärtuslikule hoonestusalale jääv, väärtusliku üksikobjektina määratletud, kultuurimälestiseks tunnistatud, muinsuskaitsealal asuv või UNESCO maailmapärandi nimekirja kantud alal asuv korterelamu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
      "rdfs:label": "lokaalne taastuvenergia (korterelamute_energiatohususe_toetuse_tingimused_t1056183)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_lokaalne_taastuvenergia"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_moodetud_energiakasutuse_andmetel_pohinev_energiamargis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "mõõdetud energiakasutuse andmetel põhinev energiamärgis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis; naabruskonnapõhine rekonstrueerimine – kahe või enama ruumiliselt seotud korterelamu rekonstrueerimine, mille rekonstrueerimistööde ostumenetlus korraldatakse samadele korterelamutele ühiselt või projekteerimise ja rekonstrueerimistööde ostumenetlus on korraldatud korterelamutele ühiselt ja selliste ostumenetluste tulemusel leitud edukas pakkuja teostab töid kõigile ostumenetluses kaasatud korterelamutele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
      ],
      "estleg:sourceAct": "Korterelamute energiatõhususe toetuse tingimused",
      "rdfs:label": "mõõdetud energiakasutuse andmetel põhinev energiamärgis (korterelamute_energiatohususe_toetuse_tingimused_t1056183)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_moodetud_energiakasutuse_andmetel_pohinev_energiamargis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_projekt",
      "@type": [
        "owl:NamedIndividual",
