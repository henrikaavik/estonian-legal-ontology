      "rdfs:label": "majanduslikult põhjendatud nõudlus",
      "skos:definition": [
        {
          "@value": "nõudlus, mis ei ületa kütte või jahutuse vajadust ja mille rahuldamiseks võib energia olla turutingimustes toodetud ka teisiti kui koostootmise protsessis",
          "@language": "et"
        },
        {
          "@value": "nõudlus, mis ei ületa kütte või jahutuse vajadust ja mille rahuldamiseks võib energia olla turutingimustes toodetud ka teisiti kui koostootmisprotsessis",
          "@language": "et"
        }
      ],
