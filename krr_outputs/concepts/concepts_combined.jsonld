        },
        {
          "@id": "estleg:Concept_korterelamute_energiatohususe_toetuse_tingimused_t1056183_moodetud_energiakasutuse_andmetel_pohinev_energiamargis"
        },
        {
          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetamine_t1053122_moodetud_energiakasutuse_andmetel_pohinev_energiamargis"
        },
        {
          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetuse_andmise_tingimused_j_t1046780_moodetud_energiakasutuse_andmetel_pohinev_energiamargis"
        }
      ],
      "estleg:definitionCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "rdfs:label": "mõõdetud energiakasutuse andmetel põhinev energiamärgis",
      "skos:definition": [
        {
          "@value": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis; naabruskonnapõhine rekonstrueerimine – kahe või enama ruumiliselt seotud korterelamu rekonstrueerimine, mille rekonstrueerimistööde ostumenetlus korraldatakse samadele korterelamutele ühiselt või projekteerimise ja rekonstrueerimistööde ostumenetlus on korraldatud korterelamutele ühiselt ja selliste ostumenetluste tulemusel leitud edukas pakkuja teostab töid kõigile ostumenetluses kaasatud korterelamutele",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis; piirkond – Põhja-Eesti, Lääne-Eesti, Kesk-Eesti, Kirde-Eesti või Lõuna-Eesti, vastavalt Eurostati territoriaalse statistika arvepidamisele (NUTS 3)",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
