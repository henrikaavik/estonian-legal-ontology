    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_meetmes_linnapiirkondade_jatkusuu_t1028551_Parnu_linnapiirkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Pärnu linnapiirkond",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Pärnu linn (välja arvatud ühinenud Tõstamaa valla territoorium enne 2017. aasta 15. oktoobrit kehtinud haldusüksuste piirides) koos selle lähiümbruse järgmiste kohaliku omavalitsuse üksustega: Häädemeeste vald (ühinenud Tahkuranna valla territooriumi osas enne 2017. a kohaliku omavalitsuse volikogu valimisi kehtinud haldusüksuste piirides) ja Tori vald (ühinenud Sauga valla ja Sindi linna territooriumi osas enne 2017. aasta 15. oktoobrit kehtinud haldusüksuste piirides)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028551_Par_2"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused meetmes „Linnapiirkondade jätkusuutlik areng”",
      "rdfs:label": "Pärnu linnapiirkond (toetuse_andmise_tingimused_meetmes_linnapiirkondade_jatkusuu_t1028551)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_parnu_linnapiirkond"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toetuse_andmise_tingimused_meetmes_linnapiirkondade_jatkusuu_t1028551_Tallinna_linnapiirkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Tallinna linnapiirkond",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Tallinna linn koos selle lähiümbruse järgmiste kohaliku omavalitsuse üksustega: Harku vald, Jõelähtme vald, Kiili vald, Maardu linn, Rae vald, Saku vald, Saue vald (välja arvatud ühinenud Kernu valla ja Nissi valla territoorium enne 2017. aasta 15. oktoobrit kehtinud haldusüksuste piirides) ja Viimsi vald",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1028551_Par_2"
        }
      ],
      "estleg:sourceAct": "Toetuse andmise tingimused meetmes „Linnapiirkondade jätkusuutlik areng”",
