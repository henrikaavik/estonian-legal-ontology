    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1051799_Avalikult_kasutatav_maa_ala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Avalikult kasutatav maa-ala",
      "skos:definition": "määratlemata isikute ringile kasutamiseks antud ning kasutuses olev üldjuhul hooneteta maa, nt tee, tänav, väljak, park, puhke- või virgestusala vms. Käesoleva määruse tähenduses ei kuulu kalmistu maa avalikult kasutatava maa-ala hulka. 2 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051799_Par_2"
        }
      ],
