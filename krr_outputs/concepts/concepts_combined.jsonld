        "@id": "estleg:Concept_arenduspiirkond"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_uhisveevargi_ja_kanalisatsiooniga_liitumi_t1058899_Kaitsevoond",
      "@type": [
        "owl:NamedIndividual",
