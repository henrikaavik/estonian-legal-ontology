    {
      "@id": "estleg:Concept_hiiumaa_valla_ametiasutuste_ja_nende_hallatavate_asutuste_pa_t1057591_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik; 3) töötaja (ametiasutuses) – vallavalitsuses eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks; 4) töötaja (ametiasutuse hallatavas asutuses) – asutusega eraõiguslikus töösuhtes olev isik, kes töötab töölepingu alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057591_Par_2"
        }
      ],
      "estleg:sourceAct": "Hiiumaa valla ametiasutuste ja nende hallatavate asutuste palgajuhend",
      "rdfs:label": "ametnik (hiiumaa_valla_ametiasutuste_ja_nende_hallatavate_asutuste_pa_t1057591)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
