        "@language": "et"
      },
      "skos:definition": {
        "@value": "jäätmetekitaja või muu isik või riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed. Jäätmevaldaja korraldatud jäätmeveo tähenduses on ka korteriühistu, selle puudumisel kinnisasja omanik, millel asub suvila, elu- või äriruum",
        "@language": "et"
      },
