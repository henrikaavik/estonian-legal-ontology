          "@id": "estleg:Concept_kohtla_jarve_linnavalitsuse_palgajuhend_t1048458_praktikant"
        },
        {
          "@id": "estleg:Concept_vandeaudiitori_voi_tunnustatud_siseaudiitori_juhendamisel_pr_t1001209_praktikant"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "praktikant",
      "skos:definition": [
        {
          "@value": "isik, kellega on sõlmitud vastava sisuline leping, et rakendada ametiasutuses kindlal perioodi jooksul õppekava raames rakendatuid teadmisi ja oskusi vastavalt õppeasutuse või muu asutuse poolsele praktikajuhendile",
          "@language": "et"
        },
        {
          "@value": "isik, kes käesolevas määruses sätestatud korras omandab vandeaudiitori või tunnustatud siseaudiitori juhendamisel praktiseerides kutsetegevuse valdkondades teadmisi, oskusi ja vilumusi",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
