        {
          "@value": "abi elatusvahendite kaotuse või puudumise tõttu sotsiaalselt abitusse olukorda sattunud isikule, mis tagab vähemalt toidu ja ajutise ööbimisvõimaluse",
          "@language": "et"
        },
        {
          "@value": "inimesele (sh ajutiselt Eestis viibivale välismaalasele) hädavajaliku toidu, riietuse, ajutise majutuse, sotsiaalnõustamise, transpordi ja muu põhjendatud abi tagamine, kui inimene on elatusvahendite kaotuse või puudumise või eluaseme ootamatult kasutuskõlbmatuks muutumise tõttu sotsiaalselt abitus olukorras; 2022-12-15 RT IV 2022-12-22 5 422122022005 2023-01-01 7",
          "@language": "et"
        },
        {
          "@value": "piisavate elatusvahenditeta isiku olukorrale vastavad hädavajalikud sotsiaalhoolekandelised abinõud, mis tagavad vähemalt toidu, riietuse, ravimid ja ajutise peavarju; 6",
          "@language": "et"
        }
      ]
    },
