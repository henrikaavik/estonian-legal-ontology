      ],
      "skos:prefLabel": {
        "@value": "kohtkäitlussüsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "reovee nõuetekohaseks käitlemiseks rajatud tehniliste seadmete ja/või ehitiste kogum, mis võimaldab reovee nõuetekohast kogumist või puhastamist ning keskkonda juhtimist. Kohtkäitlussüsteemi alla kuuluvad erinevad tehnoloogilised lahendused, sealhulgas ka kuivkäimlad, mis võimaldavad fekaalide kogumist ja suunamist edasiseks käitluseks piirkondlikule reoveepuhastile",
        "@language": "et"
      },
      "estleg:definedIn": [
