    {
      "@id": "estleg:Concept_noortekeskuse_teenuse_ja_ulelinnaliste_noorsootoo_programmid_t1024697_noortekeskus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "noortekeskus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "linnaosa valitsuse hallatav noorsootööasutus või linnaosa valitsuse hallatava vaba aja, noorsootöö- või kultuuriasutuse struktuuriüksus, mis osutab noortekeskuse teenust ja lähtub oma töös avatud noorsootöö meetodist ning mille nimetuses sisaldub sõna noortekeskus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1024697_Par_2"
        }
      ],
