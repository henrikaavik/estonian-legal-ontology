      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_muutuvpalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muutuvpalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, preemiana erakordsete teenistusalaste saavutuste eest või lisatasuna ülesannete eest, mis ületavad kokkulepitud töömahtu, ei tulene töö sisust või ei ole seotud teenistuskoha eesmärgiga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040857_Par_3"
        }
      ],
      "estleg:sourceAct": "Tõrva Vallavalitsuse palgajuhend",
