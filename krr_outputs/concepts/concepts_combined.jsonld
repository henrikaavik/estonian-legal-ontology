          "@id": "estleg:Concept_joelahtme_valla_aleviku_ja_kulavanema_statuut_t1042477_Aleviku_joelahtme_valla_aleviku_ja_kulavanema_statuut_t1042477_1_2"
        },
        {
          "@id": "estleg:Concept_kulavanema_statuut_t1054808_Aleviku"
        },
        {
          "@id": "estleg:Concept_sauga_alevikuvanema_ja_sauga_valla_kulade_kulavanema_statuut_t1022727_Aleviku"
        },
        {
          "@id": "estleg:Concept_sauga_alevikuvanema_ja_sauga_valla_kulade_kulavanema_statuut_t1022727_Aleviku_sauga_alevikuvanema_ja_sauga_valla_kulade_kulavanema_statuut_t1022727_2_2"
        },
        {
          "@id": "estleg:Concept_viljandi_valla_aleviku_ja_kulavanema_statuut_t1033262_Aleviku"
        },
        {
          "@id": "estleg:Concept_viljandi_valla_aleviku_ja_kulavanema_statuut_t1033262_Aleviku_viljandi_valla_aleviku_ja_kulavanema_statuut_t1033262_2_2"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Aleviku",
      "skos:definition": [
        {
          "@value": "või külaelanik (edaspidi külaelanik ) on käesoleva statuudi mõistes isik, kelle elukohaks rahvastikuregistri andmetel on vastav alevik või küla (edaspidi küla ). 2 (",
          "@language": "et"
        },
        {
          "@value": "või külaelanik (edaspidi külaelanik) käesoleva statuudi mõistes on inimene, kellel on Sauga alevikus või Sauga valla külades elukoht Eesti rahvastikuregistri andmetel. 2 (",
          "@language": "et"
        },
        {
          "@value": "või külavanem (edaspidi külavanem ) on külaelanike esindaja, kes juhindub oma tegevuses küla huvidest ja ühistest seisukohtadest, valla arengukavast ning riigi ja kohaliku omavalitsuse õigusaktidest. Olukordades, kus tegevus ei ole määratletud olemasolevate seadustega, tegutseb külavanem heast tavast ja eetikanormidest lähtuvalt.",
          "@language": "et"
        },
        {
          "@value": "või külavanem (edaspidi külavanem) ja tema abi on külaelanike ja nende ühiste huvide esindajad, kes juhinduvad oma tegevuses aleviku või küla (edaspidi küla) ühistest seisukohtadest, küla ja valla arengukavast, Eesti Vabariigi seadustest, omavalitsuse otsustest ja määrustest. Kui tegevus ei ole määratletud olemasolevate seadustega, tegutsevad nad, lähtudes üldinimlikest seisukohtadest ning inimõigustest.",
          "@language": "et"
        },
        {
          "@value": "või külavanem (edaspidi külavanem) on küla esindaja, kes on valitud hääleõiguslike külaelanike poolt külavanema statuudi alusel ning juhindub oma tegevuses küla ühistest huvidest ja seisukohtadest. Külavanem koordineerib ja aitab korraldada küla ühistegevusi ning ellu viia küla ühisprojekte.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_alevi"
        }
      ]
    },
    {
      "@id": "estleg:Concept_alginvesteering",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "alginvesteering",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_ida_viru_maakonna_ettevotluse_ning_inimeste_tooalaste_oskust_t1049493_alginvesteering"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ida_virumaa_toostusinvesteeringut_t1044463_alginvesteering"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_meetme_ettevotete_ressursitohusus_t1042181_alginvesteering"
        },
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_tegevuseks_ida_virumaa_toostusinv_t1049464_alginvesteering"
        }
      ],
      "estleg:definitionCount": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "rdfs:label": "alginvesteering",
      "skos:definition": [
        {
          "@value": "investeering materiaalsesse ja/või immateriaalsesse varasse seoses uue ettevõtja asutamisega, olemasoleva ettevõtja tootmisvõimsuse suurendamisega, ettevõtja toodangu mitmekesistamisega toodetega, mida ei ole veel ettevõttes toodetud, või olemasoleva ettevõtja kogu tootmisprotsessi täieliku ümberkorraldamisega; 3 3<sup>1</sup>) uut majandustegevust soodustav alginvesteering – investeering materiaalsesse ja immateriaalsesse varasse seoses uue ettevõtte asutamisega või ettevõtte tegevuse mitmekesistamisega tingimusel, et uus tegevus ei ole sama või sarnane ettevõtte varasema tegevusalaga; RT I 2022-01-12 10 112012022010 2022-01-15 4",
          "@language": "et"
        },
        {
          "@value": "investeering materiaalsesse ja/või immateriaalsesse varasse seoses uue ettevõtja asutamisega, olemasoleva ettevõtja tootmisvõimsuse suurendamisega, ettevõtja toodangu mitmekesistamisega toodetega, mida ei ole veel ettevõttes toodetud, või olemasoleva ettevõtja kogu tootmisprotsessi täieliku ümberkorraldamisega; 5",
          "@language": "et"
        },
        {
          "@value": "investeering materiaalsesse ja/või immateriaalsesse varasse seoses uue ettevõtte asutamisega, olemasoleva ettevõtte tootmisvõimsuse suurendamisega, ettevõtte toodangu mitmekesistamisega toodetega, mida ei ole veel ettevõttes toodetud, või olemasoleva ettevõtte kogu tootmisprotsessi täieliku ümberkorraldamisega, või vara soetamine ettevõttelt, mis on lõpetanud tegevuse või oleks tegevuse lõpetanud, kui seda ei oleks ostetud, ja seda ostab müüjaga mitteseotud investor ning tegemist ei ole üksnes ettevõtja aktsiate omandamisega; RT I 2020-10-28 1 128102020001 2020-10-31 17",
          "@language": "et"
        },
        {
