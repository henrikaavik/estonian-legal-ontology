    {
      "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetuse_maksmise_kord_toimetule_t1043553_huvitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvitegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "läbiviimise koht ei ole üheselt määratletud. Viiakse läbi huviringidena koolis, noortekeskustes, noorteühingute, seltsimajade, kultuurimajade, raamatukogude juures ja mujal, kus toimub regulaarne ja süsteemne juhendamine vastavalt noorsootöö seaduses kirjeldatud definitsioonile ja noorsootöö põhimõtetele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043553_Par_2"
