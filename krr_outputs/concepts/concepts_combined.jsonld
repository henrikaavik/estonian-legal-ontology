        }
      ],
      "skos:definition": [
        {
          "@value": "aasta ringi elamiseks sobiv eramu, ridaelamu- või paarismajaboks või korter",
          "@language": "et"
        },
        {
          "@value": "aasta ringi elamiseks sobiv eramu, ridaelamu- või paarismajaboks, korter",
          "@language": "et"
        },
        {
          "@value": "ehitisregistrisse kantud aasta ringi elamiseks sobiv eramu, ridaelamu- või paarismajaboks või korter",
          "@language": "et"
        },
        {
          "@value": "elamus alaliseks elamiseks üüritav korter",
          "@language": "et"
        },
        {
          "@value": "korteriomand, mis on kasutatav alaliseks elamiseks",
          "@language": "et"
        }
