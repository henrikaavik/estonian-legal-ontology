      "skos:definition": [
        {
          "@value": "liiklusregister „Liiklusseaduse” tähenduses; 2",
          "@language": "et"
        },
        {
          "@value": "lemmikloomade identifitseerimise ja arvestuse pidamise andmebaas.",
          "@language": "et"
        },
        {
          "@value": "liiklusregister liiklusseaduse tähenduses; 2",
          "@language": "et"
        },
        {
          "@value": "Rae valla koerte register, mis on ühildatud üle-eestilise lemmikloomaregistriga (Lemmikloomaregister LLR, www.llr.ee). 8",
