        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ringlusse võtmine",
      "skos:definition": [
        {
          "@value": "toiming, mille käigus radioaktiivsed ained töödeldakse kasutuselevõtuks ümber uuteks toodeteks, materjalideks või aineteks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
