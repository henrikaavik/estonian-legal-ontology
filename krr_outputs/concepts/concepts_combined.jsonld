      }
    },
    {
      "@id": "estleg:Concept_teedegrupp",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teedegrupp",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
