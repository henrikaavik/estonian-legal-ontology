    {
      "@id": "estleg:Concept_poltsamaa_valla_ametiasutuse_palgajuhend_t1054343_lisatasu_taiendavate_teenistusulesannete_eest",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "lisatasu täiendavate teenistusülesannete eest",
      "skos:definition": "ette kokkulepitav tasu selle eest, kui keegi täidab ülesandeid, mida tema tavapärane töö ette ei näe või teeb seda oluliselt suuremas mahus oma isikliku aja arvelt ning seniste ülesannete mahtu vähendamata ja tähtaegu muutmata; 10",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054343_Par_2"
        }
      ],
      "estleg:sourceAct": "Põltsamaa valla ametiasutuse palgajuhend",
