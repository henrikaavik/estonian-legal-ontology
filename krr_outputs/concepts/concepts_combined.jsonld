    {
      "@id": "estleg:Concept_polva_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049369_reovee_bioloogiline_puhastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "reovee bioloogiline puhastamine",
      "skos:definition": "ehk sekundaarne puhastamine on reoveest reoainete kõrvaldamine bioloogiliste protsesside toimel, mille tulemusena heitvesi vastab keskkonnaministri 08.11.2019. aasta määruses nr 61 \"Nõuded reovee puhastamise ning heit-, sademe-, kaevandus-, karjääri- ja jahutusvee suublasse juhtimise kohta, nõuetele vastavuse hindamise meetmed ning saasteainesisalduse piirväärtused 1 \" esitatud heitvee reostusnäitajate piirväärtustele biokeemilise hapnikutarbe, heljuvaine ja keemilise hapnikutarbe osas; 14",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049369_Par_2"
        }
      ],
      "estleg:sourceAct": "Põlva valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "reovee bioloogiline puhastamine (polva_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049369)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_bioloogiline_puhastamine"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_reovee_bioloogiline_puhastamine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_polva_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049369_reovee_mehaaniline_puhastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "reovee mehaaniline puhastamine",
      "skos:definition": "reoainete eemaldamine, mille korral reovee puhastusaste peab olema biokeemilise hapnikutarbe (BHT) osas vähemalt 20% ja hõljuvaine sisalduse osas vähemalt 50%; 15",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049369_Par_2"
        }
      ],
      "estleg:sourceAct": "Põlva valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "reovee mehaaniline puhastamine (polva_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049369)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reovee_mehaaniline_puhastamine"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_reovee_mehaaniline_puhastamine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_polva_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049369_BHT",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "BHT",
      "skos:definition": "bioloogiline hapnikutarve, veekogu üldseisundit iseloomustav parameeter. Näitab hapniku hulka, mis on vajalik orgaanilise aine määratletud bioloogiliseks lagunemiseks; 16",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049369_Par_2"
        }
      ],
      "estleg:sourceAct": "Põlva valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "BHT (polva_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049369)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_bht"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_bht"
        }
      ]
