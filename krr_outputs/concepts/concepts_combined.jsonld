      },
      "skos:definition": {
        "@value": "ehk kohtpuhasti on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti (edaspidi ie )",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1042724_Par_2"
        }
      ],
      "estleg:sourceAct": "Setomaa valla reovee kohtkäitluse ja äraveo eeskiri",
      "rdfs:label": "omapuhasti (setomaa_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1042724)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omapuhasti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
