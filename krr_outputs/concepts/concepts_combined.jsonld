    {
      "@id": "estleg:Concept_jarva_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_k_t1056756_liitumispunkt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "liitumispunkt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühisveevärgi ja -kanalisatsiooni omaniku või valdaja määratud ühisveevärgi ja -kanalisatsiooni ühenduskoht tarbimiskoha veevärgi või kanalisatsiooniga. Liitumispunkt asub avalikult kasutataval maal kuni üks meeter väljaspool tarbimiskoha piiri. Kui liitumispunkti ei ole võimalik määrata eelnimetatud tingimusel, lepitakse liitumispunkti asukoht kokku vee-ettevõtja ja liituja vahelise kokkuleppega. Liitumispunkt on ühisveevärgi ja -kanalisatsiooni oluline osa",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056756_Par_2"
        }
