          "@id": "estleg:Concept_viimsi_valla_teede_ja_tanavate_sulgemise_maks_t1028011_tee"
        },
        {
          "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284_tee"
        }
      ],
      "estleg:definitionCount": {
        "@value": "22",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tee",
      "skos:altLabel": [
        {
          "@value": "Tee",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "rajatis, mis on ette nähtud inimeste, sõidukite või loomade liikumiseks või liiklemiseks; 2",
          "@language": "et"
        },
        {
          "@value": "on maantee, tänav, jalgtee ja jalgrattatee või muu sõidukite või jalakäijate liiklemiseks kasutatav rajatis, mis võib olla riigi või kohaliku omavalitsuse või muu juriidilise isiku või füüsilise isiku omandis; 2",
          "@language": "et"
        },
        {
          "@value": "on rajatis, mis on ette nähtud inimeste, sõidukite või loomade liikumiseks või liiklemiseks. Tee osaks loetakse tunnel, sild, viadukt ja muud liiklemiseks kasutatavad ning tee toimimiseks vajalikud rajatised. 2 (",
          "@language": "et"
        },
        {
          "@value": "rajatis, mis on ette nähtud inimeste, sõidukite, või loomade liikumiseks või liiklemiseks. Tee osadeks loetakse ka liiklemiseks kasutatavad ning tee toimimiseks vajalikud rajatised; 2",
          "@language": "et"
        },
        {
          "@value": "ettevõtja – tee-ettevõtja on tee valdaja.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "17",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_tee_kaitsevoond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Tee kaitsevöönd",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_abja_valla_teede_kasutamise_ja_kaitse_eeskiri_t1003627_tee_kaitsevoond"
