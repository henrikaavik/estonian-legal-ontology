        {
          "@value": "alusharidusseaduse alusel tegutsev ning tegevusluba omav eralasteaed",
          "@language": "et"
        },
        {
          "@value": "koolieelse lasteasutuse seaduse ja erakooliseaduse alusel tegutsev ning tegevusluba omav koolieelne eralasteasutus",
          "@language": "et"
