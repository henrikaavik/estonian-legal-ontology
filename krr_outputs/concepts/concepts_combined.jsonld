    {
      "@id": "estleg:Concept_luganuse_valla_huvihariduse_ja_tegevuse_toetamise_kord_t1043095_Laager",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Laager",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "huvikooli või huviringi poolt korraldatud eesmärgistatud ühistegevus, mille jooksul tegeletakse intensiivselt huviõppega. Huvitegevuseks ei loeta lühiajalisi kursusi ja tervisesporti. Toetus käesoleva korra mõistes on valla eelarvest eraldatavad rahalised vahendid õppuri huvihariduse või -tegevuse toetamiseks.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043095_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla huvihariduse ja -tegevuse toetamise kord",
