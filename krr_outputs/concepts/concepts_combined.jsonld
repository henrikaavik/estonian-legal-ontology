    {
      "@id": "estleg:Concept_tervishoiuteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervishoiuteenus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_sotsiaaltoetuste_taotlemise_maaramise_ja_maksmise_kord_t1057749_tervishoiuteenus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tervishoiuteenus",
      "skos:definition": [
        {
          "@value": "tervishoiutöötaja tegevus haiguse, vigastuse või mürgistuse ennetamiseks, diagnoosimiseks ja ravimiseks eesmärgiga leevendada inimese vaevusi, hoida ära tema tervise seisundi halvenemist või haiguse ägenemist ning taastada tervist; 13",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tervishoiuteenuse_kattesaadavus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervishoiuteenuse kättesaadavus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tervishoiuteenuste_kattesaadavuse_ja_ravijarjekorra_pidamise_t1045617_tervishoiuteenuse_kattesaadavus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tervishoiuteenuse kättesaadavus",
      "skos:definition": [
        {
          "@value": "vajamineva vältimatu abi, perearstiabi, kiirabi, eriarstiabi, sealhulgas hambaarstiabi ja õendusabi õigeaegne ning kvaliteetne tagamine patsiendile, lähtuvalt tema meditsiinilisest vajadusest, tervishoiuteenuse osutaja erialasest pädevusest ja raviressursi olemasolust; RT I 2024-10-04 1 104102024001 2024-10-07 , rakendatakse tagasiulatuvalt alates 1. juulist 2024. a 2",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tervishoiuteenuse_osutaja_digiregistratuur",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervishoiuteenuse osutaja digiregistratuur",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tervishoiuteenuste_kattesaadavuse_ja_ravijarjekorra_pidamise_t1045617_tervishoiuteenuse_osutaja_digiregistratuur"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tervishoiuteenuse osutaja digiregistratuur",
      "skos:definition": [
        {
          "@value": "vastuvõtuaegade haldamise veebikeskkond, mis võimaldab registreerida, muuta ja tühistada aega eriarsti esmasele vastuvõtule; 5",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tervishoiuteenuse_osutaja_vastuvott",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervishoiuteenuse osutaja vastuvõtt",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_tervishoiuteenuse_osutaja_vastuvott"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tervishoiuteenuse osutaja vastuvõtt",
      "skos:definition": [
        {
          "@value": "töötukassa võib suunata isiku töövõimetoetuse seaduse § 7 lõike 3 alusel tervishoiuteenuse osutaja vastuvõtule visiidipõhisele hindamisele, et hinnata isiku tegutsemis- ja osalusvõimet isiku selgituste, vaatluse ja testide abil. Visiidipõhine hindamine tehakse juhul, kui töövõime hindamise taotlusel välja toodud piirangud ja terviseandmed erinevad üksteisest olulisel määral või arstide poolt tervise infosüsteemi sisestatud terviseandmed on sisult vastuolulised. Visiidipõhist hindamist ei tehta, kui isik ei ole seoses töövõime hindamise taotlusel välja toodud piirangutega arsti vastuvõtul käinud või taotluses välja toodud piiranguid kirjeldavad terviseandmed on olemas ja terviseandmetes vastuolud puuduvad, samuti uute diagnooside püstitamiseks või ägenemiste ja remissioonidega kulgevatest haigustest tulenevate piirangute tuvastamiseks; RT I 2020-02-19 1 119022020001 2020-03-01 11",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tervishoiuteenuste_integreeritus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervishoiuteenuste integreeritus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tervishoiuteenuste_kvaliteedi_ja_patsiendiohutuse_tagamise_n_t1059772_tervishoiuteenuste_integreeritus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tervishoiuteenuste integreeritus",
      "skos:definition": [
        {
          "@value": "tervishoiuteenuste osutamine koostöös ja koordineeritult tervishoiuteenuse osutajatega ning sotsiaalsüsteemi ja muude vajalike osapooltega, arvestades inimese vajadusi kogu elukaare vältel; 6",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tervishoiutootaja_kvalifikatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervishoiutöötaja kvalifikatsioon",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
