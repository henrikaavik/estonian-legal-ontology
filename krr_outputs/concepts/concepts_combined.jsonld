          "@id": "estleg:Concept_viru_nigula_valla_ametiasutuse_palgajuhend_t1063214_teenistusgrupp"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teenistusgrupp",
      "skos:altLabel": [
        {
          "@value": "Teenistusgrupp",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "linnavalitsuse teenistuskohad, mis on jaotatud tasemeteks vastavalt täidetavate ülesannete iseloomule ja tööülesannete täitmisega kaasnevale vastutusele.",
          "@language": "et"
        },
        {
          "@value": "sarnase funktsiooni ja töö sisuga teenistuskohtade kogum, mis on jaotatud tasemeteks lähtudes töö tegijale esitatavatest nõuetest, töö keerukusest ja vastutuse ulatusest",
          "@language": "et"
        },
        {
          "@value": "teenistusgruppi kuuluvad ameti- või töökohad, mis on klassifitseeritud gruppi oma vastutuse ulatuse, ülesannete täitmiseks vajalike teadmiste, oskuste, kohustuste, hariduse jms poolest",
          "@language": "et"
        },
        {
          "@value": "teenistuskohtade jaotus gruppidesse, lähtudes teenistuskohal ettenähtud teenistusülesannete iseloomust ning teenistuskoha keerukuse ja vastutuse astmest.",
          "@language": "et"
        },
        {
          "@value": "valdavas osas sarnaste teenistus- ja tööülesannetega teenistuskohtade grupp, mis on jaotatud tasemeteks vastavalt täidetavate ülesannete iseloomule",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
