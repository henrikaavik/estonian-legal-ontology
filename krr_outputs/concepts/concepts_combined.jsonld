        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "üksikpilet",
      "skos:definition": "üheks liikumiseks mõeldud eelmüügist või ühissõiduki juhi käest ostetud sõidudokument, mis kehtib sellele märgitud aja jooksul ja annab õiguse ümberistumiseks; 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059033_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi valla bussiliinidel ja Leppneeme-Kelnase laevaliinil sõidu eest tasumise kord ja sõidupiletite hinnad",
      "rdfs:label": "üksikpilet (viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil__t1059033)",
