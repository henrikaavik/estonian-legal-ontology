    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_maastikuarhitektuurne_projekt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "maastikuarhitektuurne projekt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "terviklik planeerimis- ja kujunduslahendus, mille eesmärk on arendada väliruume, võttes arvesse esteetilisi, funktsionaalseid, ökoloogilisi ja kultuurilisi aspekte. Lahendus hõlmab nii looduslike elementide (vesi, taimestik, pinnavormid) kui ka kunstlike elementide (rajatised, teed, platsid) koostoime planeerimist ning ala terviklikkuse säilitamist. Maastikuarhitektuurne projekt võib sisaldada eriosasid, näiteks haljastusprojekti või looduslähedase sademeveesüsteemi projekti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "maastikuarhitektuurne projekt (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_maastikuarhitektuurne_projekt"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_soojussolm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "soojussõlm",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hoone või hoonerühma seadmestik, mille abil soojusenergia tarbijad on ühenduses soojusvõrguga. Soojussõlmes muudetakse kaugküttevõrgu soojuskandja temperatuur ja rõhk hoone sooja tarbevee, kütte- ja ventilatsioonisüsteemile sobivaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "soojussõlm (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_soojussolm"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_tarbijapaigaldis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tarbijapaigaldis",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistul, ehitises või ühtse majandusüksuse moodustavas funktsionaalselt seotud ehitiste kompleksis ja nende teenindamiseks vajalikul maal ehitatud omavahel ühendatud soojatorustike ja abiseadmete võrguga ühendatud või ühendatav talituslik kogum tarbija varustamiseks soojusega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "tarbijapaigaldis (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tarbijapaigaldis"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_toovotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töövõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "äriregistrisse kantud majandustegevuses tegutsev isik, kes on esitanud äriregistrile vähemalt ühe majandusaasta aruande, mille põhjal on ettevõtja tegevusala olnud asjaomase teenuse osutamine. Kui töövõtja teeb õigusaktide mõistes eritöid, siis peab ta olema registreeritud majandustegevuse registris või peab tal olema vastavas valdkonnas tegutsemiseks tegevusluba; 11) valmis ehitis (sh tarbijapaigaldis, lift jms) – ehitis on valmis ehitatud, kui sellele on antud kasutusluba või on esitatud kasutusteatis ja pädev asutus ei ole kümne päeva jooksul pärast kasutusteatise esitamist teatanud vajadusest täiendavalt kontrollida kasutusteatises esitatud andmeid ning töö eest on tasutud. Kui ehitustöö ei ole ehitusloakohustuslik ega ehitusteatise esitamise kohustusega, on ehitis valmis ehitatud, kui tööd on tehtud nõuetekohaselt, need on vastu võetud ja nende eest on tasutud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "töövõtja (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_toovotja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_valmis_too",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "valmis töö",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töö on valmis, kui see on tehtud nõuetekohaselt ja nõuetekohase töövõtja poolt ning taotleja on töö vastu võtnud ja töö eest tasunud (nt projekteerimine, ekspertiisi koostamine, omanikujärelevalve teenus, maastikuarhitektuurse projekti koostamine, puude ja põõsaste hoolduslõikus, turvakaamera paigaldamine)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "valmis töö (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_valmis_too"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_korteriuhistule_toetuse_andmise_kord_t1060569_vork",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "võrk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "torustike, seadmete, abiseadmete ja nendega seotud ehitiste kohtkindlalt ehitatud talitluslik kogum või selle osa, mis on vajalik soojuse jaotamiseks. Võrguks ei loeta kaugkütteseaduses nimetatud tarbijapaigaldisi.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060569_Par_3"
        }
      ],
      "estleg:sourceAct": "Korteriühistule toetuse andmise kord",
      "rdfs:label": "võrk (korteriuhistule_toetuse_andmise_kord_t1060569)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_vork"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_messitoetuse_andmise_kord_t1021057_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline isik, kes pakub oma nimel tasu eest kaupu või teenuseid ning kellele on kaupade müük või teenuste osutamine püsiv tegevus, või seaduses sätestatud äriühing",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1021057_Par_3"
        }
      ],
      "estleg:sourceAct": "Messitoetuse andmise kord",
      "rdfs:label": "ettevõtja (messitoetuse_andmise_kord_t1021057)",
      "estleg:definesConcept": {
