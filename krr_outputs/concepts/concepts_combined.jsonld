        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ohuala",
      "skos:definition": [
        {
          "@value": "ala, kuhu võib ulatuda lõhkematerjali hävitamisega kaasnev kahjulik mõju inimestele ja ehitistele nii maismaal kui ka veekogul",
          "@language": "et"
        },
        {
          "@value": "eluohtlik ala, kus viibiv inimene päästetakse või evakueeritakse ning kuhu võib siseneda vaid asjakohast väljaõpet omav ja kaitsemeetmeid kasutav inimene päästetöö juhi antud ülesande täitmiseks",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_roheala"
        }
      ],
