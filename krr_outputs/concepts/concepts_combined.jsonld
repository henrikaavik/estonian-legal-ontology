        "@type": "xsd:integer"
      },
      "rdfs:label": "avalikkusele suunatud hoone",
      "skos:definition": [
        {
          "@value": "avalikus kasutuses olev seltsimaja, kultuurimaja, spordihoone või muu sarnase eesmärgi ja otstarbega hoone",
          "@language": "et"
        },
        {
          "@value": "avalikus kasutuses olev seltsimaja, käsitöökoda, külamaja, rahvamaja või muu sarnase eesmärgi ja otstarbega hoone",
          "@language": "et"
        },
        {
          "@value": "munitsipaalomandis olev ja toetuse taotlejale avalikku kasutusse antud seltsimaja või muu sarnase eesmärgi ja otstarbega hoone või hoone osa",
          "@language": "et"
        }
      ],
