      "estleg:definitionCount": {
        "@value": "21",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toetus",
      "skos:definition": [
        {
          "@value": "raha, mida eraldatakse riigieelarvest taotlejale taotluse rahuldamise otsuse alusel",
          "@language": "et"
        },
        {
          "@value": "eelarveline eraldis valla arengukavaga kooskõlas oleva mittetulundusliku tegevuse toetamiseks",
          "@language": "et"
        },
        {
          "@value": "isiku või perekonna toimetuleku soodustamiseks või toimetulekuraskuste leevendamiseks antav rahaline või mitterahaline toetus",
          "@language": "et"
        },
        {
          "@value": "Kambja valla eelarvest eraldatavad rahalised vahendid huvitegevuses osalemise toetamiseks",
          "@language": "et"
        },
        {
          "@value": "käesoleva eeskirja mõistes saadud või antud vahendid jooksvateks või kapitalikuludeks, mis ei kuulu tagasimaksmisele. Toetused võivad olla nii rahalised kui ka mitterahalised.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "20",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
