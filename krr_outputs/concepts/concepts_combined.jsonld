    {
      "@id": "estleg:Concept_konnitee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kõnnitee",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kose_valla_heakorra_eeskiri_t1013153_konnitee"
