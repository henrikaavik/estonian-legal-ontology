        "@value": "vaatluskaev",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "maa- või teepinnale avanev eemaldatava luugiga kaev (toru) kanalisatsioonitorustikul. Maapinnale ulatuv luuk kuulub vaatluskaevu osana kanalisatsioonirajatiste hulka",
        "@language": "et"
      },
      "estleg:definedIn": [
