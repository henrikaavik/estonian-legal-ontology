      },
      "skos:definition": {
        "@value": "periood, mille jooksul toimunud majandustehingute kirjendid võetakse arvesse aruannete koostamisel. Lühem aruandeperiood on kalendrikuu. Majandusaasta aruandeperiood on kalendriaasta",
        "@language": "et"
      },
      "estleg:definedIn": [
