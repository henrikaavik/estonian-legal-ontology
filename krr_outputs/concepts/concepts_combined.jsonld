    {
      "@id": "estleg:Concept_vaike_maarja_valla_heakorraeeskiri_t1046087_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi, hoonestusõigus, korteriomand ja korterihoonestusõigus. Kinnistuga on eeskirjas võrdsustatud ka kinnistamata maaüksus, mille suhtes isikul on kasutusõigus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1046087_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja valla heakorraeeskiri",
