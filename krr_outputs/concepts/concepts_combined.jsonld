      ],
      "skos:prefLabel": {
        "@value": "rohi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rohu all mõistetakse käesolevas määruses hein- ja murutaimi, rohttaimedest taimkatet",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
