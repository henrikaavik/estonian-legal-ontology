    {
      "@id": "estleg:Concept_torva_vallavalitsuse_palgajuhend_t1040857_tulemuspalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "tulemuspalk",
