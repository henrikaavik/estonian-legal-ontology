      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "KEK energiamärgis",
      "skos:definition": [
        {
          "@value": "korterelamule väljastatud energiamärgis, mis tõendab mõõdetud ja kaalutud energiaerikasutuse (KEK) arvutuse alusel hoone energiatõhusust. KEK energiamärgise andmisel võetakse aluseks viimase kolme kalendriaasta tegelik energiatarve. KEK energiamärgis ei või toetuse taotluse esitamisel olla vanem kui aasta. Uue KEK energiamärgise aluseks on tegelik energiatarve toetusega ehitatu valmimisele järgneval kalendriaastal; 4",
          "@language": "et"
        }
      ]
    },
