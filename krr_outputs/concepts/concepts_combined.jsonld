      ],
      "skos:prefLabel": {
        "@value": "reovesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "üle kahjutuspiiri rikutud ja enne suublasse juhtimist puhastamist vajav vesi (mõiste hõlmab muuhulgas kuivkäimla sisu ja isikliku majapidamise omapuhasti reoveesetet)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054022_Par_2"
