      "rdfs:label": "avatud koolitus",
      "skos:definition": [
        {
          "@value": "tööalane täienduskoolitus, kus teenistujad osalevad erinevatele asutustele suunatud koolitusasutuse poolt pakutaval koolitusel; 4",
          "@language": "et"
        },
        {
          "@value": "koolitusasutuse pakutav koolitus (sh konverents, infopäev, foorum, õppereis, seminar); 2",
          "@language": "et"
        },
        {
          "@value": "koolitusasutuse poolt avalikult välja pakutud koolitus (sh infopäev, konverents, foorum, e-õpe); 5",
          "@language": "et"
        },
        {
          "@value": "koolitusasutuse poolt avalikult välja pakutud koolitus (sh konverents, foorum); 5",
          "@language": "et"
        },
        {
          "@value": "täiendkoolitusasutuste poolt avalikult väljapakutud koolitus (sh konverents, seminar, infopäev,veebiseminar, aga ka mikrokvalifikatsiooni omandamine), mis võib toimuda nii Eestis kui väljaspool Eestit; 2",
          "@language": "et"
        }
      ],
