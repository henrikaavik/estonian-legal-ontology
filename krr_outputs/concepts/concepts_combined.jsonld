      }
    },
    {
      "@id": "estleg:Concept_vormsi_vallavalitsuse_palgajuhend_t1055926_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on vallaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud ametiasutuses ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055926_Par_2"
        }
      ],
      "estleg:sourceAct": "Vormsi Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (vormsi_vallavalitsuse_palgajuhend_t1055926)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_vallavalitsuse_palgajuhend_t1055926_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes teeb ametiasutuses töölepingu alusel tööd töökohal, millel ei teostata avalikku võimu, vaid tehakse avaliku võimu teostamist toetavat tööd",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055926_Par_2"
        }
      ],
      "estleg:sourceAct": "Vormsi Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (vormsi_vallavalitsuse_palgajuhend_t1055926)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_vallavalitsuse_palgajuhend_t1055926_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev töötaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055926_Par_2"
        }
      ],
      "estleg:sourceAct": "Vormsi Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (vormsi_vallavalitsuse_palgajuhend_t1055926)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vormsi_vallavalitsuse_palgajuhend_t1055926_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametnikule tehtud töö eest makstav tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest ning asendustasust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055926_Par_2"
        }
