    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmete_kogumine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jäätmete kogumine",
      "skos:definition": "jäätmete kokku korjamine, sealhulgas jäätmete eelsortimine ja ajutine ladustamine ning mehaaniline töötlemine ilma jäätmete koostist ja olemust muutmata, eesmärgiga vedada need edasiseks käitlemiseks jäätmekäitluskohta; 14",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
