          "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_ja_lumetorjeteenus_t1049985_eratee"
        },
        {
          "@id": "estleg:Concept_erateedel_tasuta_lumetorje_teostamise_kord_t1053677_eratee"
        },
        {
          "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1060663_eratee"
        },
        {
          "@id": "estleg:Concept_erateede_avalikuks_kasutamiseks_maaramise_kord_t1052284_eratee"
        }
      ],
      "estleg:definitionCount": {
        "@value": "14",
        "@type": "xsd:integer"
      },
      "rdfs:label": "eratee",
      "skos:altLabel": [
        {
          "@value": "Eratee",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "tee, mis kuulub füüsilisele või juriidilisele isikule ning mida võib ilma omaniku loata kasutada ainult seadusega määratud juhtudel.",
          "@language": "et"
        },
        {
          "@value": "tee, mis paikneb juriidilise või füüsilise isiku kinnisasjal ning mis pole kantud avalikult kasutatavate teede nimekirja. Eratee ei pea olema kantud teeregistrisse",
          "@language": "et"
        },
        {
          "@value": "on tee, mis paikneb juriidilise või füüsilise isiku kinnisasjal",
          "@language": "et"
        },
        {
          "@value": "tee, mis paikneb füüsilisele või juriidilisele isikule kuuluval kinnisasjal ning mida võib ilma omaniku loata kasutada ainult seadusega määratud juhtudel; 3) pinnastee on pealiskihita tee, mis on teeks rajatud või pikaajaliselt väljakujunenud sõidukite liikumise tulemusena selleks kujunenud; 4) avalikult kasutatav tee on riigitee, kohalik tee ja avalikuks kasutamiseks määratud eratee. Avalikult kasutatavat teed võib kasutada igaüks õigusaktides sätestatud piiranguid järgides; 5) teel on kaitsevöönd, kui tee on avalikult kasutatav. Avalikult kasutatava tee kaitsevöönd on teed ümbritsev maa-ala, mis tagab tee kaitse, teehoiu korraldamise, liiklusohutuse ning vähendab teelt lähtuvaid keskkonnakahjulikke ja inimestele ohtlikke mõjusid. Kaitsevööndite ulatused kehtestatakse üldplaneeringuga.",
          "@language": "et"
        },
        {
          "@value": "tee, mis paikneb juriidilise või füüsilise isiku kinnisasjal ja ei ole avalikus kasutuses",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_peatee"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
