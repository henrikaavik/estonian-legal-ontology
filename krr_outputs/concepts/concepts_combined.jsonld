      },
      "skos:definition": {
        "@value": "viimane sulgemisseade ühendustorul enne kinnistu veevärki, krundistamata hoonestuse puhul aga enne ehitisse sisenemist. Peakraan lõpetab ühendustoru ja on üldjuhul liitumispunktiks",
        "@language": "et"
      },
      "estleg:definedIn": [
