        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ESFRI teekaart on Euroopa Komisjoni pika",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_riikliku_tahtsusega_teaduse_infrastruktuuri_toetamine_teekaa_t1030371_ESFRI_teekaart_on_Euroopa_Komisjoni_pika"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ESFRI teekaart on Euroopa Komisjoni pika",
      "skos:definition": [
        {
          "@value": "ajaline abivahend otsuste tegemiseks, mis sisaldab loendit uutest või kaasajastamist vajavatest üle-euroopalise tähtsusega teaduse infrastruktuuridest. ESFRI on Euroopa Teaduse Infrastruktuuride Strateegiafoorum ( European Strategy Forum for Research Infrastructures ), mis on Euroopa Liidu algatatud riikide mitteformaalne koostööorgan teaduse infrastruktuuride strateegiliseks loomiseks ja koostööks; 8",
          "@language": "et"
        }
      ]
