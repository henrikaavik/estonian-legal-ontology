      },
      "rdfs:label": "ehitise ümberehitamine ehk rekonstrueerimine",
      "skos:definition": [
        {
          "@value": "ehitamine, mille käigus olemasoleva ehitise omadused muutuvad oluliselt; 6",
          "@language": "et"
        }
      ]
    },
