    {
      "@id": "estleg:Concept_laaneranna_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_t1058809_Reostus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Reostus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vee omadusi halvendav saasteainete, organismide sisaldus vees, vee ülemäärane soojus või radioaktiivsus.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058809_Par_2"
        }
      ],
