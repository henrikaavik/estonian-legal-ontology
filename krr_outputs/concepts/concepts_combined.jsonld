    {
      "@id": "estleg:Concept_saue_linna_uhisveevargi_ja_kanalisatsiooniga_liitumise_eeski_t1036784_sademevesi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sademevesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "loodusliku päritoluga sademe- ja drenaaživesi ning muu pinnase- ja pinnavesi, mis ei ole reovesi ning mis juhitakse ühiskanalisatsiooni või sademevee kanalisatsiooni",
        "@language": "et"
      },
      "estleg:definedIn": [
