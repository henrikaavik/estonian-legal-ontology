      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "purgimiskoht",
      "skos:definition": "koht, mis on määratud kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas tekkekohast äraveetud reovee ühiskanalisatsiooni juhtimiseks; 10",
