      "rdfs:label": "projekti kogumaksumus",
      "skos:definition": [
        {
          "@value": "projekti elluviimiseks tehtavate toetatavate ja mittetoetatavate kulude kogusumma",
          "@language": "et"
        },
        {
          "@value": "projekti elluviimiseks linnavalitsusele ja selle hallatavale asutusele antava toetuse ja oma- või kaasfinantseeringu summa, sh ka mitteabikõlblikud kulud.",
          "@language": "et"
        },
        {
          "@value": "projekti elluviimiseks tehtavate toetatavate, sealhulgas omafinantseering ja mitte toetatavate kulude summa",
          "@language": "et"
        },
        {
          "@value": "projekti kõikide partnerite tegevuste läbiviimiseks vajalik summa, mis sisaldab toetust, projekti kaas- ja omafinantseeringut.",
          "@language": "et"
        },
        {
          "@value": "projekti tegevuste elluviimiseks tehtavad kulutused kokku, mis kaetakse välisrahastusest ja projektis osalevate partnerite omafinantseeringust; 9) projektide oma- ja kaasfinantseerimise ja välisprojektide ettevalmistamise reserv (edaspidi projektide reserv ) – Tallinna linnaeelarves kavandatud kulutuste reserv nende projektide ettevalmistamiseks ja käivitamiseks, mis on saanud positiivse rahastusotsuse eelarveaasta kestel ning mille tulusid, kulutusi ja omafinantseeringut ei olnud võimalik eelarve koostamisel ette näha ja eelarvesse kavandada",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
