          "@id": "estleg:Concept_raasiku_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_ees_t1013851_olmereovesi"
        },
        {
          "@id": "estleg:Concept_tartu_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeski_t1005283_olmereovesi"
        },
        {
          "@id": "estleg:Concept_tartu_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeski_t1062951_olmereovesi"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "olmereovesi",
      "skos:definition": [
        {
          "@value": "inimese elutegevuse tulemusena üle kahjustuspiiri rikutud ja puhastamist vajav vesi, reovesi või saastunud vesi",
          "@language": "et"
        },
        {
          "@value": "ehk majapidamisreovesi on köökides, pesumajades, pesuruumides, WCdes, vannitubades vms paikades tekkiv reovesi",
          "@language": "et"
        },
        {
          "@value": "elu- ja ametkondlikus veetarbimises tekkinud reovesi, kui selle reostusaste on grupi piirväärtuste piires, milline kuulub reostusgruppi RG1",
          "@language": "et"
        },
        {
          "@value": "köökides, pesumajades, pesuruumides, WCdes, vannitubades vms paikades tekkiv reovesi. Olmereovesi jaguneb pesu-, kümblus- ja köögiveeks (neid kokku nimetatakse majapidamisreoveeks ehk hallveeks) ning WC-veeks ehk mustveeks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
