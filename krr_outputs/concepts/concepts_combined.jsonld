    {
      "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_andmise_kord_t1052751_perekond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "perekond",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vanem või vanemad ja alaealine laps või lapsed. Perekonnaks loetakse muu hulgas üksikvanem ja tema laps; laps, tema vanemad ja kummagi abikaasa. Perekonna hulka ei loeta lapse vanema elukaaslast",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052751_Par_3"
        }
      ],
      "estleg:sourceAct": "Sotsiaalhoolekandelise abi andmise kord",
      "rdfs:label": "perekond (sotsiaalhoolekandelise_abi_andmise_kord_t1052751)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_perekond"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaalhoolekandelise_abi_andmise_kord_t1052751_laps",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "laps",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "alla 18-aastane inimene. Kui inimese vanus ei ole teada ja on põhjust arvata, et ta on alla 18-aastane, käsitatakse inimest lapsena, kuni ei ole tõendatud vastupidine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052751_Par_3"
        }
      ],
      "estleg:sourceAct": "Sotsiaalhoolekandelise abi andmise kord",
