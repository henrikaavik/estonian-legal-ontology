      },
      "rdfs:label": "peatoru",
      "skos:altLabel": [
        {
          "@value": "Peatoru",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub kinnistute veega varustamine või kinnistutelt reo- ning sademevee ärajuhtimine",
          "@language": "et"
        },
        {
          "@value": "ÜVK torustik, mille kaudu toimub kinnistute veega varustamine või kinnistutelt reovee ärajuhtimine",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või –kanalisatsiooni torustik, mille kaudu toimub kinnistute veega varustamine või kinnistutelt reo- ning sademevee ärajuhtimine",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub kinnistute veega varustamine või kinnistutelt heitvee kanaliseerimine",
          "@language": "et"
        },
        {
          "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub kinnistute veega varustamine või kinnistutelt reovee ärajuhtimine",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "23",
        "@type": "xsd:integer"
      },
