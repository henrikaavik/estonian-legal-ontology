    {
      "@id": "estleg:Concept_sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_struktu_t1050293_Positiivselt_evalveeritud_teadus__ja_arendusasutus_on_teadus__ja_arendusasutus_t",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Positiivselt evalveeritud teadus- ja arendusasutus on teadus- ja arendusasutus teadus",
      "skos:definition": "ja arendustegevuse korralduse seaduse § 3 mõistes ning on vastavalt teadus- ja arendustegevuse korralduse seaduse § 3 lõikele 2 vähemalt ühes valdkonnas korraliselt positiivselt evalveeritud. 3 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050293_Par_2"
        }
      ],
      "estleg:sourceAct": "„Sektoritevahelise mobiilsuse toetamine” elluviimiseks struktuuritoetuse andmise tingimused ja kord",
      "rdfs:label": "Positiivselt evalveeritud teadus- ja arendusasutus on teadus- ja arendusasutus teadus (sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_struktu_t1050293)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_positiivselt_evalveeritud_teadus__ja_arendusasutus_on_teadus__ja_arendusasutus_t"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_positiivselt_evalveeritud_teadus__ja_arendusasutus_on_teadus__ja_arendusasutus_t"
        }
      ]
    },
    {
      "@id": "estleg:Concept_sektoritevahelise_mobiilsuse_toetamine_elluviimiseks_struktu_t1050293_Teadus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Teadus",
      "skos:definition": "ja arendustegevus (edaspidi TA ) on isiku loomevabadusel põhinev süstemaatiline tegevus, mille eesmärk on teaduslike uuringute abil uute teadmiste saamine inimese, looduse ja ühiskonna ning nende vastastikkuse toime kohta ning nende teadmiste rakendamine. Teadus- ja arendustegevus hõlmab alus- ja rakendusuuringuid ning eksperimentaalarendust, mis võivad omavahel osaliselt kattuda. 4 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1050293_Par_2"
        }
