      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_ja_reklaamimaksu_kehtestam_t1051880_valireklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "välireklaam",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avalikus kohas asuv või jälgitav reklaam, mis on paigaldatud hoonele, rajatisele või maapinnale koos reklaamikandjaga või ilma; 3) välireklaamikandja (edaspidi reklaamikandja ) - välireklaami paigaldamiseks kasutatav alus, konstruktsioon, seadeldis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051880_Par_2"
        }
      ],
