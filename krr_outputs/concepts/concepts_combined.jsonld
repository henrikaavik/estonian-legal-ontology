      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vastavalt avaliku teenistuse seaduse § 5 on avalik teenistuja asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o töölepingu alusel töötav) töötaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on asutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_teenistuskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuskoht (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuskoht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "palk (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_palk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_tootasu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu, mis koosneb põhipalgast, muutuvpalgast, eritingimustes töötamise eest makstavatest lisatasudest (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasust, mida asutus maksab töötajale tehtud töö eest vastavalt töölepingule, õigusaktidele ja tööandja poolt kehtestatud korrale",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "töötasu (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhipalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga fikseeritud osa, mis on määratud teenistuskoha ülesannete ning teenistuja teenistusalaste teadmiste, oskuste ja kogemuste põhjal",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "põhipalk (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_pohipalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_muutuvpalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muutuvpalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga ebaregulaarne osa, mida võib maksta tulemuspalgana, lisatasuna täiendavate teenistusülesannete täitmise eest või preemiana erakordsete teenistusalaste saavutuste eest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "muutuvpalk (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_muutuvpalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_tulemuspalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tulemuspalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutuse juhi või tema volitatud isiku poolt eelnevalt kindlaks määratud kriteeriumite alusel konkreetse töö või perioodi erakordsete tulemuste eest makstav ühekordne lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
      "estleg:sourceAct": "Märjamaa Vallavalitsuse palgajuhend",
      "rdfs:label": "tulemuspalk (marjamaa_vallavalitsuse_palgajuhend_t1057388)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tulemuspalk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marjamaa_vallavalitsuse_palgajuhend_t1057388_preemia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "preemia",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "erakordsete teenistusalaste saavutuste eest makstav lisatasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057388_Par_2"
        }
      ],
