      "estleg:definesConcept": {
        "@id": "estleg:Concept_netoenergiavajadus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_hoone_energiatohususe_arvutamise_metoodika_t1029856_netoenergiavajadus_ruumi_kutteks",
