      "rdfs:label": "rakendusmeede",
      "skos:definition": [
        {
          "@value": "Euroopa Parlamendi ja nõukogu direktiivi 2009/125/EÜ alusel vastu võetud ja jõustunud Euroopa Liidu õigusakt toote ökodisaini nõuete või selle toote teatavate keskkonnaaspektide sätestamiseks",
          "@language": "et"
        },
        {
          "@value": "Euroopa Parlamendi ja nõukogu direktiivi 2010/30/EL alusel vastu võetud ja jõustunud Euroopa Liidu õigusakt toote energiamärgistuse ja tootekirjelduse nõuete kohta",
          "@language": "et"
        }
      ],
