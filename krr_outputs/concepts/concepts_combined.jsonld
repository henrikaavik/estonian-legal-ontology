      },
      "rdfs:label": "reoveepuhasti",
      "skos:altLabel": [
        {
          "@value": "Reoveepuhasti",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kogum kindlate dimensioonidega rajatisi ja seadmeid, milles ühiskanalisatsioonivõrgu kaudu või eeskirjas reguleeritud muul viisil kogutud reovesi puhastatakse tasemeni, et seda võib keskkonda ohustamata loodusesse juhtida. 27",
          "@language": "et"
        },
        {
          "@value": "kogum kindlate dimensioonidega rajatisi, milles ühiskanalisatsioonivõrgu kaudu või muul käesolevas eeskirjas reguleeritud viisil kogutud reovesi puhastatakse nõnda, et seda võib keskkonda ohustamata loodusesse heita; 17",
          "@language": "et"
        },
        {
          "@value": "kogum kindlate dimensioonidega rajatisi, milles ühiskanalisatsioonivõrgu kaudu või muul käesolevas eeskirjas reguleeritud viisil kogutud reovesi puhastatakse nõnda, et seda võib keskkonda ohustamata loodusesse edastada; 31",
          "@language": "et"
        },
        {
          "@value": "kogum rajatisi, milles kanalisatsioonivõrgu kaudu kogutud reovesi puhastatakse nõnda, et seda võib keskkonda ohustamata loodusesse heita; 34 (",
          "@language": "et"
        },
        {
          "@value": "kogum rajatisi, milles ühiskanalisatsioonivõrgu kaudu kogutud reovesi puhastatakse nõnda, et seda võib keskkonda ohustamata loodusesse heita; 20",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "6",
        "@type": "xsd:integer"
      }
    },
