        "@type": "xsd:integer"
      },
      "rdfs:label": "Patendiamet",
      "skos:definition": [
        {
          "@value": "valitsusasutus, kes täidab vastuvõtva ameti ja märgitud ameti või märgitud ja väljavalitud ameti ülesandeid Eestis",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
