    {
      "@id": "estleg:Concept_marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265_MSCA_jareldoktor",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "MSCA järeldoktor",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "MSCA järeldoktori individuaalgranti taotlenud teadlane, kellele vastuvõttev asutus käesoleva määrusega reguleeritud toetust taotleb; 5) MSCA järeldoktori või ERC grandi taotlemise toetus (edaspidi toetus ) – käesoleva määrusega reguleeritud ja selle alusel makstav toetus, et teadlane saaks tulla välisriigist Eestisse ning viia siin ellu oma järeldoktori projekti või teadlane saaks taasesitada oma ERC grandi taotluse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1063265_Par_2"
        }
      ],
      "estleg:sourceAct": "Marie Skłodowska Curie Action järeldoktori individuaalgrandi ja ERC grandi taotlemise edukuse tõstmiseks toetuse taotlemise, toetuse eraldamise ning toetuse tagasinõudmise tingimused ja kord",
      "rdfs:label": "MSCA järeldoktor (marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_msca_jareldoktor"
