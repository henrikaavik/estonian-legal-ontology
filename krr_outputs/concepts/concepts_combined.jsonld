    {
      "@id": "estleg:Concept_noustamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Nõustamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_perioodi_2021_2027_innovatsiooni_ja_arendusosaku_toetuse_and_t1056023_Noustamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Nõustamine",
      "skos:definition": [
        {
          "@value": "individuaalne tegevus, mille käigus innovatsiooniteenuse pakkuja innovatsiooniosaku raames (edaspidi IOT ) või innovatsiooniteenuse pakkuja arendusosaku raames (edaspidi AOT ) pakub teenuse tellijale esitatud probleemi kõrvaldamiseks metoodilist, informatiivset või tehnilist teavet. Nõustamise tulemusena valmib IOT või AOT välja töötatud individuaalne lahendus tellija esitatud probleemi kõrvaldamiseks. Nõustamise lõppedes jääb IOT või AOT oskusteave IOT-le või AOT-le ning IOT või AOT annab nõustamistegevuse tulemi üle tellijale. Nõustamine ei ole taotleja ettevalmistamine taseme- või erialakoolituse eksamite sooritamiseks. 7 (",
          "@language": "et"
        }
      ]
    },
