      ],
      "skos:prefLabel": {
        "@value": "käideldavus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vajalikul ja nõutaval tööajal kasutamiskõlblike andmete õigeaegne ning hõlbus kättesaadavus selleks volitatud isikule või tehnilisele vahendile",
        "@language": "et"
      },
