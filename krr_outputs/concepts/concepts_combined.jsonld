    },
    {
      "@id": "estleg:Concept_viru_nigula_valla_asutuste_infoturbe_pohimotted_t1047485_oht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "oht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "olukord, mis võib kahjustada infovarasid ning võib peituda infrastruktuuris, tehnoloogias, inimeste turbeteadlikkuses või asutuse töökorralduses. Ohuallikaks võivad olla: a) puudused infrastruktuuris – ebapiisav kaitse füüsiliste ohtude eest (näiteks kuum, külm, elektrikatkestus) või turbe füüsiliste meetmete osaline rakendamine; b) puudused infotehnoloogias – süsteemide või seadmete tõrked (näiteks serveririke või võrguühenduse katkestus), seadmete paigutus, süsteemide jõudlus või ülepingutatud turvameetmed; c) puudused inimeste töös − vead, mida inimesed teevad turvanõuete järgimisel (näiteks antakse edasi ligipääsuõigusi või taotletakse tarbetuid ligipääsuõigusi, ei järgita töö- ja eraasjade lahususe põhimõtet); d) puudused töökorralduses – juhtumid, kus järgitakse turvanõuete täitmise reegleid puudulikult või ei täideta neid, kasutusjuhendid või süsteemikirjeldused on ebaselged või puuduvad, süsteemile juurdepääsu reguleerimise vahend ehk parool on nõrk või ebapiisav või arvutisse on paigaldatud volitamata tarkvara; e) turvaründed",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047485_Par_6"
        }
      ],
      "estleg:sourceAct": "Viru-Nigula valla asutuste infoturbe põhimõtted",
      "rdfs:label": "oht (viru_nigula_valla_asutuste_infoturbe_pohimotted_t1047485)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_oht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
