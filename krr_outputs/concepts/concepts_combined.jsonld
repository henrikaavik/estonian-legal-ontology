      ]
    },
    {
      "@id": "estleg:Concept_saue_valla_valireklaami_maarus_t1060944_sotsiaalreklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "sotsiaalreklaam",
      "skos:definition": "reklaam, mille eesmärk on saavutada hinnangute andmise kaudu inimese käitumine avalikes huvides ja milles teatud probleemile keskendudes ei pakuta kaubamärgipõhist, vaid üldist lahendit; 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060944_Par_2"
        }
      ],
