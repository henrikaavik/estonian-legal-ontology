      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Õppekulu",
      "skos:definition": "lasteaia majandamiskulu, personali töötasu ja sotsiaalmaks ning õppevahendite kulu, mille katmine toimub linnaeelarve vahenditest ning on osaliselt vanema poolt kaetav osalustasu. Vanema poolt kaetava õppekulu suuruse kehtestab Viljandi Linnavolikogu (edaspidi linnavolikogu). 3 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061761_Par_2"
        }
      ],
      "estleg:sourceAct": "Lasteaia toidu- ja õppekulu arvestamise, maksmise ja soodustuse taotlemise kord",
