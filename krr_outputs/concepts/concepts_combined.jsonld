      "rdfs:label": "JUHTIMISVÕIMETU LAEV",
      "skos:definition": [
        {
          "@value": "laev, mis erinevate asjaolude tõttu pole võimeline manööverdama nende reeglite kohaselt ja seetõttu ei saa teisele laevale teed anda",
          "@language": "et"
