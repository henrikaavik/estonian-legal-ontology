        "@type": "xsd:integer"
      },
      "rdfs:label": "sotsiaaleluruum",
      "skos:definition": [
        {
          "@value": "eluruum, mida kasutatakse isikule sotsiaalhoolekande seaduses ja linna õigusaktides eluruumi tagamise teenuse osutamiseks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
