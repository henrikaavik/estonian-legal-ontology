      "estleg:definesConcept": {
        "@id": "estleg:Concept_e_pileti_susteem"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viimsi_valla_bussiliinidel_ja_leppneeme_kelnase_laevaliinil_t1059033_uksikpilet",
      "@type": [
        "owl:NamedIndividual",
