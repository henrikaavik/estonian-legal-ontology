        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kehtna_valla_raamatupidamise_sise_eeskiri_t1060946_majandusinformatsiooni_liigendamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "majandusinformatsiooni liigendamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "valla majandustehingute kirjendamine, kasutades riigi või valla õigusaktidega kehtestatud tunnuseid (koode), millised võimaldavad majandusinformatsiooni põhjal koostada finantsaruandeid valla juhtimisotsuste tegemiseks ning riigi aruandluse jaoks.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060946_Par_2"
        }
      ],
      "estleg:sourceAct": "Kehtna valla raamatupidamise sise-eeskiri",
