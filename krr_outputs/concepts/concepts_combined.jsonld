      "rdfs:label": "purgimissõlm",
      "skos:definition": [
        {
          "@value": "reovee tekkekohas kogutud reovee ja fekaalide ühiskanalisatsiooni juhtimise koht; 11",
          "@language": "et"
        },
        {
          "@value": "kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas määratud ametlik reovee ja fekaalide ühiskanalisatsiooni juhtimise koht; 13",
          "@language": "et"
        },
        {
          "@value": "kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas määratud ametlik reovee ja fekaalide ühiskanalisatsiooni juhtimise koht; 18",
          "@language": "et"
        },
        {
          "@value": "koht, mis on Türi valla ühisveevärgi ja -kanalisatsiooni arendamise kavas määratud tekkekohast ära veetud reovee ühiskanalisatsiooni juhtimiseks.",
          "@language": "et"
        },
        {
          "@value": "rajatis, mis on määratud kohaliku omavalitsuse ühisveevärgi ja - kanalisatsiooni arendamise kavas tekkekohast väljaveetud reovee ühiskanalisatsiooni juhtimiseks; 11",
          "@language": "et"
        }
      ],
