        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimiskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "koht, mis on määratud kohaliku omavalitsuse ühisveevärgi ja -kanalisatsiooni arendamise kavas tekkekohast äraveetud reovee ühiskanalisatsiooni juhtimiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
