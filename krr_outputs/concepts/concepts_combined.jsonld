        {
          "@id": "estleg:Concept_muhu_valla_koerte_ja_kasside_pidamise_eeskiri_t1008977_looma_margistamine"
        },
        {
          "@id": "estleg:Concept_rakvere_valla_koerte_ja_kasside_pidamise_eeskiri_t1049364_looma_margistamine"
        },
        {
          "@id": "estleg:Concept_saarde_valla_koerte_ja_kasside_pidamise_eeskiri_t1049818_looma_margistamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "rdfs:label": "looma märgistamine",
      "skos:definition": [
        {
          "@value": "tegevusluba omava veterinaararsti poolt loomale mikrokiibi paigaldamine.",
          "@language": "et"
        },
        {
          "@value": "looma varustamine eristamist võimaldava püsiva ning kordumatu kunstliku tunnusega, milleks Saarde vallas peetavatel loomadel on mikrokiip; 8",
          "@language": "et"
        },
        {
          "@value": "tegevusluba omava veterinaararsti poolt loomale mikrokiibi paigaldamine; 6",
          "@language": "et"
        },
        {
          "@value": "tegevusluba omava veterinaararsti poolt loomale mikrokiibi paigaldamine; 7",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_looma_suhtes_lubamatu_tegu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "looma suhtes lubamatu tegu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kiili_valla_koerte_kasside_ja_teiste_lemmikloomade_pidamise__t1006928_looma_suhtes_lubamatu_tegu"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "looma suhtes lubamatu tegu",
      "skos:definition": [
        {
          "@value": "looma hukkumist, vigastamist või talle valu ja välditavaid füüsilisi ja vaimseid kannatusi põhjustav tegu, nagu looma sundimine talle üle jõu käivatele pingutustele, loomavõitluse korraldamine, looma hülgamine või abitusse seisundisse jätmine, loomale kannatusi põhjustav aretustegevus ja muu sarnaste tagajärgedega tegu, mis ei ole tingitud looma ravimisest, muust veterinaarsest menetlusest ega hädaolukorrast, välja arvatud Loomakaitseseaduses ettenähtud juhud; 5",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_loomad_ja_linnud",
      "@type": [
        "owl:NamedIndividual",
