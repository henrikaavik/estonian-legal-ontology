          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "reklaami paigaldamiseks kasutatav alus, seadeldis (seinapannoo, konsool, transparendid jms), mis paigaldatakse hoonetele ja rajatistele ning konstruktsioon (reklaamipost, -tahvel, treiler jms), mis paigaldatakse maapinnale",
          "@language": "et"
        },
        {
          "@value": "spetsiaalselt reklaami eksponeerimiseks valmistatud ja paigaldatud konstruktsioon, alus, seadeldis",
          "@language": "et"
        },
        {
          "@value": "reklaami eksponeerimiseks ja paigaldamiseks kasutatav alus, seadeldis, konstruktsioon (reklaampost, tahvel, haagis jms) või ühistranspordivahend",
          "@language": "et"
        },
        {
          "@value": "reklaami eksponeerimiseks valmistatud ja paigaldatud konstruktsioon, alus, seadeldis (reklaampost,- tahvel, treiler jms)",
          "@language": "et"
        },
        {
          "@value": "reklaami paigaldamiseks kasutatav alus, konstruktsioon, seadeldis (reklaamipost,- tahvel, treiler jms)",
          "@language": "et"
        }
      ],
