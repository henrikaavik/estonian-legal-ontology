    {
      "@id": "estleg:Concept_antsla_valla_jaatmehoolduseeskiri_t1057628_teenuste_kontsessioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenuste kontsessioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "hankelepinguga antud õigus olla määratud veopiirkonnas korraldatud jäätmeveoga hõlmatud jäätmeliikide ainsaks jäätmeveo ettevõtjaks. Lõikes 1 nimetamata termini kasutamisel lähtutakse jäätmeseaduses, pakendiseaduses, riigihangete seaduses ja teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1057628_Par_3"
        }
      ],
      "estleg:sourceAct": "Antsla valla jäätmehoolduseeskiri",
      "rdfs:label": "teenuste kontsessioon (antsla_valla_jaatmehoolduseeskiri_t1057628)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenuste_kontsessioon"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_antsla_vallavalitsuse_palgajuhend_t1040957_ametiasutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametiasutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kohaliku omavalitsuse üksuse eelarvest finantseeritav asutus, kelle ülesanne on avaliku võimu teostamine; 2) ametnik  isik, kes on ametiasutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning on ametiasutuses nimetatud ametikohale, millel teostatakse avalikku võimu. Ametnik nimetatakse ametikohale ja vabastatakse teenistusest Avaliku teenistuse seaduse alusel. Ametniku teenistuskohta nimetatakse ametikohaks; 3) teenistuja  vastavalt avaliku teenistuse seadusele on avalik teenistuja ametiasutusega avalik- õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o töölepingu alusel töötav) töötaja; 4) töötaja  ametiasutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning tema teenistuskohta nimetatakse töökohaks; 5) teenistuskoht  ametiasutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040957_Par_2"
        }
      ],
      "estleg:sourceAct": "Antsla Vallavalitsuse palgajuhend",
      "rdfs:label": "ametiasutus (antsla_vallavalitsuse_palgajuhend_t1040957)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametiasutus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_antsla_vallavalitsuse_palgajuhend_t1040957_pohipalk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "põhipalk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "teenistuja palga fikseeritud osa, mis on määratud ametikoha teenistusülesannete ning ametniku teenistusalaste teadmiste, oskuste ja kogemuste põhjal; 7) palk  ametnikule makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040957_Par_2"
        }
      ],
      "estleg:sourceAct": "Antsla Vallavalitsuse palgajuhend",
