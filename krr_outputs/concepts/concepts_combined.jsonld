    },
    {
      "@id": "estleg:Concept_uhiskasutuses_jaatmemahuti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühiskasutuses jäätmemahuti",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_uhiskasutuses_jaatmemahuti"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ühiskasutuses jäätmemahuti",
      "skos:definition": [
        {
          "@value": "jäätmemahuti, mida omavahelise kokkuleppe alusel kasutab rohkem kui üks jäätmevaldaja ning mille tühjendamiseks on vähemalt ühel jäätmevaldajal sõlmitud jäätmevedajaga jäätmeleping. Eeskirja § 2 lõikes 2 nimetamata mõistete defineerimisel lähtutakse keskkonnaseadustiku üldosa seaduses, jäätmeseaduses, pakendiseaduses, riigihangete seaduses ning teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest terminitest ja mõistetest.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_uhismahuti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ühismahuti",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_joelahtme_valla_jaatmehoolduseeskiri_t1053601_uhismahuti"
        },
        {
          "@id": "estleg:Concept_rapina_valla_jaatmehoolduseeskiri_t1057272_uhismahuti"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "ühismahuti",
      "skos:definition": [
        {
          "@value": "jäätmemahuti, mida omavahelise kokkuleppe alusel kasutab rohkem kui üks jäätmevaldaja ning mille tühjendamiseks on vähemalt ühel jäätmevaldajal sõlmitud jäätmevedajaga jäätmeleping. Eeskirjas nimetamata mõiste kasutamisel lähtutakse jäätmeseaduses, pakendiseaduses ja teistes jäätmehooldust reguleerivates õigusaktides sisalduvatest legaaldefinitsioonidest, vastava legaaldefinitsiooni puudumisel aga sõna üldlevinud tähendusest.",
          "@language": "et"
        },
        {
          "@value": "jäätmemahuti, mida omavahelise kokkuleppe alusel kasutab rohkem kui üks jäätmevaldaja ning mille tühjendamiseks on vähemalt ühel jäätmevaldajal sõlmitud jäätmevedajaga jäätmeleping; Eeskirjas nimetamata mõistete kasutamisel lähtutakse jäätmeseaduses, pakendiseaduses ja teistes jäätmehooldust reguleerivates õigusaktides määratletud mõistetest, vastava mõiste puudumisel aga sõna üldlevinud tähenduses.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
