      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_maks_t1043195_parkla",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "parkla",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sõidukite parkimiseks ettenähtud ehituslikult või liikluskorralduslikult kujundatud ala, mille moodustavad parkimiskohad ja neid ühendavad teeosad. Parklaks ei loeta sõidutee laiendit või jalgteed, mis on tähistatud parkimist korraldava liikluskorraldusvahendiga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043195_Par_2"
        }
      ],
      "estleg:sourceAct": "Teede ja tänavate sulgemise maks",
      "rdfs:label": "parkla (teede_ja_tanavate_sulgemise_maks_t1043195)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_parkla"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_sulgemise_maks_t1043195_soidutee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
