        "@id": "estleg:Concept_personalikulu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_eratee_avalikuks_kasutamiseks_maaramise_ja_erateedel_tasuta_t1051795_tee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rajatis, mis on ette nähtud inimeste, sõidukite või loomade liikumiseks või liiklemiseks. Tee osaks loetakse tunnel, sild, viadukt ja muud liiklemiseks kasutatavad ning tee toimimiseks vajalikud rajatised",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051795_Par_2"
        }
      ],
      "estleg:sourceAct": "Eratee avalikuks kasutamiseks määramise ja erateedel tasuta lumetõrjeteenuse osutamise kord",
      "rdfs:label": "tee (eratee_avalikuks_kasutamiseks_maaramise_ja_erateedel_tasuta__t1051795)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tee"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_eratee_avalikuks_kasutamiseks_maaramise_ja_erateedel_tasuta_t1051795_eratee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eratee",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tee, mis paikneb füüsilisele või juriidilisele isikule kuuluval kinnisasjal ning mida võib ilma omaniku loata kasutada ainult seadusega määratud juhtudel; 3) pinnastee on pealiskihita tee, mis on teeks rajatud või pikaajaliselt väljakujunenud sõidukite liikumise tulemusena selleks kujunenud; 4) avalikult kasutatav tee on riigitee, kohalik tee ja avalikuks kasutamiseks määratud eratee. Avalikult kasutatavat teed võib kasutada igaüks õigusaktides sätestatud piiranguid järgides; 5) teel on kaitsevöönd, kui tee on avalikult kasutatav. Avalikult kasutatava tee kaitsevöönd on teed ümbritsev maa-ala, mis tagab tee kaitse, teehoiu korraldamise, liiklusohutuse ning vähendab teelt lähtuvaid keskkonnakahjulikke ja inimestele ohtlikke mõjusid. Kaitsevööndite ulatused kehtestatakse üldplaneeringuga.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051795_Par_2"
        }
      ],
      "estleg:sourceAct": "Eratee avalikuks kasutamiseks määramise ja erateedel tasuta lumetõrjeteenuse osutamise kord",
      "rdfs:label": "eratee (eratee_avalikuks_kasutamiseks_maaramise_ja_erateedel_tasuta__t1051795)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_eratee"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
