        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "tervisest tulenev takistus",
      "skos:definition": [
        {
          "@value": "seisund, millest tulenevalt on inimesele määratud puue puuetega inimeste sotsiaaltoetuste seaduse tähenduses või ta on tunnistatud püsivalt töövõimetuks riikliku pensionikindlustuse seaduse alusel, sealhulgas juhul, kui talle riiklike elatusrahade seaduse alusel määratud invaliidsusgrupp on loetud vastavaks püsivale töövõimetusele või tal on tuvastatud osaline või puuduv töövõime töövõimetoetuse seaduse alusel; 8",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tervishoiu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervishoiu",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
