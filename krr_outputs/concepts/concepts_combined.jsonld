          "@value": "tellija",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "kaevetööde tellija on juriidiline või füüsiline isik, kes tellib kaevetööd, omades selleks seaduslikke volitusi ning määrab ehitustööde omanikujärelevalve teostaja (ehitusjärelevalve) ja teede ehitus- ja remonditööde järelevalve teostaja (teehoiutööde järelevalve). 12 (",
          "@language": "et"
        },
        {
          "@value": "kaevetööde tellija, kes on juriidiline või füüsiline isik, kes tellib kaevetööd, omades selleks seaduslikke volitusi ning määrab ehitustööde omanikujärelevalve teostaja (ehitusjärelevalve) ning teede ehituse- ja remonditööde järelevalve teostaja (teehoiutööde järelevalve); 5",
          "@language": "et"
        },
        {
          "@value": "Haapsalu Linnavalitsus; 10",
          "@language": "et"
        },
        {
