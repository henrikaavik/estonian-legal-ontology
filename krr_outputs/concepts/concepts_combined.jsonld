    {
      "@id": "estleg:Concept_saku_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1054022_omapuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "omapuhasti",
      "skos:definition": "ehk kohtpuhasti on rajatis, kus kõrvaldatakse reoained ja ebasoovitavad organismid olmereoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus on kuni 50 inimekvivalenti. Siia alla kuuluvad nii septikud kui biopuhastid koos puhastatud reovee suublasse juhtimisega; 9",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054022_Par_2"
        }
      ],
      "estleg:sourceAct": "Saku valla reovee kohtkäitluse ja äraveo eeskiri",
