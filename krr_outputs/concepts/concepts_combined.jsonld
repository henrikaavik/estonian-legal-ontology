    {
      "@id": "estleg:Concept_kadrina_valla_jaatmehoolduseeskiri_t1053453_jaatmed",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "jäätmed",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "mis tahes vallasasi, mille nende valdaja on ära visanud, kavatseb seda teha või on kohustatud seda tegema",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1053453_Par_2"
        }
      ],
