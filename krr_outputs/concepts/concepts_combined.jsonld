      ],
      "skos:prefLabel": "septik",
      "skos:definition": "pealt kinnine väljavooluga reovee mehhaaniline puhasti, millesse sadenenud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt. Kohila vallas pole septikut eraldiseisva süsteemina lubatud kasutada; 10",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051835_Par_2"
