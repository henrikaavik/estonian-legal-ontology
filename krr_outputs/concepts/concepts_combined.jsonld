      ],
      "skos:prefLabel": {
        "@value": "raieluba",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vormikohane luba, mis annab õiguse nii puu raieks kui ka hoolduslõikuseks ning määrab raietööde lisatingimused",
        "@language": "et"
      },
