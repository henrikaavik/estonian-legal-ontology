    {
      "@id": "estleg:Concept_kiili_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eeski_t1024955_sademetevee_kanalisatsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sademetevee kanalisatsioon",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehitiste, sealhulgas kraavituste ja seadmete süsteem sademetevee ärajuhtimiseks ja kanaliseerimiseks. Sademetevee kanalisatsiooni käsitletakse ühiskanalisatsioonina",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
