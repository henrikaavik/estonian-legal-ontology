    },
    {
      "@id": "estleg:Concept_heakorra_eeskiri_t1023768_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidilise või füüsilise isiku omandis või valduses olev kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maatükk), hoonestusõigus, korteriomand või korterihoonestusõigus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1023768_Par_2"
        }
      ],
      "estleg:sourceAct": "Heakorra eeskiri",
      "rdfs:label": "kinnistu (heakorra_eeskiri_t1023768)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_heakorra_eeskiri_t1023768_kinnistu_kasutaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu kasutaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidilisest või füüsilisest isikust kinnisasja omanik, hoonestusõiguse omanik või korteriühistu olemasolu korral ühistu. Muu isik on kinnistu kasutajaks juhul, kui heakorra nõuete täitmine tuleneb omaniku ja muu isiku vahelisest lepingust (välja arvatud teenuse osutamine) või volitusest",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1023768_Par_2"
        }
