      },
      "rdfs:label": "Tegevusteraapia teenus",
      "skos:definition": [
        {
          "@value": "häiritud või piiratud tegevusvõimega inimese füüsilise ja psüühilise arengu toetamine ning tegevusvõime säilitamine ja edendamine, et inimene tuleks võimalikult hästi ja iseseisvalt toime oma igapäevaelu toimingutega. RT IV 2024-10-18 18 418102024018 2024-10-21 11",
          "@language": "et"
        },
        {
          "@value": "häiritud või piiratud tegevusvõimega inimese füüsilise ja psüühilise arengu toetamine ning tegevusvõime säilitamine ja edendamine, et toetada isiku võimalikult iseseisvat toimetulekut igapäevaelu toimingutega; RT IV 2024-10-18 19 418102024019 2024-10-21 11",
          "@language": "et"
        }
      ]
    },
