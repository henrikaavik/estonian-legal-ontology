        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühisveevärgi või -kanalisatsiooni torustik, mille kaudu toimub tarbimiskoha veega varustamine või tarbimiskohalt reovee ärajuhtimine.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
