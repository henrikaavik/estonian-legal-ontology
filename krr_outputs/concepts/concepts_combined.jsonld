    {
      "@id": "estleg:Concept_maardu_linna_jaatmehoolduseeskiri_t1055314_biolagunevad_aia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "biolagunevad aia",
      "skos:definition": "ja haljastujäätmed on aedade ning haljasalade hooldamisel tekkinud biolagunevad jäätmed nagu rohi, lehed, peened oksad jmt; 2",
