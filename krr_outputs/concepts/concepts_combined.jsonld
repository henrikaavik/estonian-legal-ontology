        "@language": "et"
      },
      "skos:definition": {
        "@value": "toetuse saaja poolt toetuse taotluses nimetatud projektis osalev kohaliku omavalitsuse üksus, avalik-õiguslik juriidiline isik, riigiasutus, mittetulundusühing, sihtasutus või avaliku sektori valitseva mõju all olev äriühing, kes panustab abikõlbliku omafinantseeringu katmisel projekti rahaliselt; RTL 2010 24 426 13309745 2010-05-14",
        "@language": "et"
      },
      "estleg:definedIn": [
