      "skos:prefLabel": "energiatõhususarv",
      "skos:definition": "arvutuslik summaarne tarnitud energiate kaalutud erikasutus hoone tüüpilisel kasutusel, millest arvatakse maha summaarne eksporditud energiate erikasutus; 5",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056183_Par_4"
        }
