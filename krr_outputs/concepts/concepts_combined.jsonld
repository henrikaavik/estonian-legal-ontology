        "@type": "xsd:integer"
      },
      "rdfs:label": "kogumismahuti",
      "skos:definition": [
        {
          "@value": "lekkekindel äravooluta rajatis kanalisatsioonivee ajutiseks hoidmiseks",
          "@language": "et"
        },
        {
          "@value": "lekkekindel äravooluta rajatis reovee ajutiseks hoidmiseks",
          "@language": "et"
        },
        {
          "@value": "lekkekindel äravooluta rajatis reovee ja käimlajäätmete ajutiseks hoidmiseks",
          "@language": "et"
        },
        {
          "@value": "plastmassist, klaasplastist, betoonist, terasest või mõnest muust materjalist reovee kogumiseks mõeldud lekkekindel äravooluta mahuti, millesse kogutud reovesi veetakse edasiseks käitlemiseks reoveepuhastile",
          "@language": "et"
        },
        {
          "@value": "konteiner, mahuti jm anum ja pakend, kuhu kogutakse territooriumil tekkinud jäätmed",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "12",
        "@type": "xsd:integer"
      },
