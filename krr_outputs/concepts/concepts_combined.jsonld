    {
      "@id": "estleg:Concept_viimsi_valla_heakorraeeskiri_t1060690_vihmaperiood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vihmaperiood",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "enam kui 5-päevane järjestikune sademerohke periood (vähemalt 5 mm päevas), mil pinnas küllastub sademeveega ja niidutööd võivad kahjustada pinnast",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1060690_Par_2"
        }
      ],
