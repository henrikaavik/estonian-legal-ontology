      ],
      "skos:prefLabel": {
        "@value": "hankija",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallavalitsuse või vallavolikogu volitatud juriidiline isik, kes vastab jäätmeseaduse (edaspidi JääTS) nõuetele; 10) jäätmeveopiirkond (edaspidi piirkond) – eeskirjaga kindlaks määratud ala, kust kohaliku omavalitsuse üksuse korraldatud jäätmeveoga hõlmatud jäätmed kokku kogutakse",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056448_Par_3"
        }
      ],
