        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "e-pileti süsteem",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "piletisüsteem, mille kaudu ostetakse elektrooniline isikustatud või isikustamata sõidupilet, mida tõendatakse Ühiskaardiga. Isikustatud e pileti süsteemi kaudu ostetud sõidupilet kehtib ainult koos isikut tõendava dokumendiga",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1059033_Par_2"
        }
      ],
      "estleg:sourceAct": "Viimsi valla bussiliinidel ja Leppneeme-Kelnase laevaliinil sõidu eest tasumise kord ja sõidupiletite hinnad",
