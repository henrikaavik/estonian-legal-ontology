      ],
      "skos:prefLabel": {
        "@value": "heitvesi",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "maapinda või veekogusse juhitav õigusaktides ettenähtud saastenäitajateni puhastatud reovesi",
