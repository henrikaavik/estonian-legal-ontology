    },
    {
      "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_erijuhtum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "erijuhtum",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "erandlik hindamisjuhtum, mille korral valdkondade kaupa tegutsemisvõimet hinnates on inimese tegutsemise ja osalemise piirangud vähe väljendunud ja ei vasta osalise või puuduva töövõime kriteeriumitele, kuid tema töötamine on terviseseisundi tõttu osaliselt või täielikult takistatud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030642_Par_2"
        }
      ],
      "estleg:sourceAct": "Töövõime hindamise taotlusele kantavate andmete loetelu, töövõime hindamise tingimused ja töövõimet välistavate seisundite loetelu",
      "rdfs:label": "erijuhtum (toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_erijuhtum"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_tegutsemisvoime",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tegutsemisvõime",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isiku võime täita ülesannet või sooritada tegevust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030642_Par_2"
        }
      ],
      "estleg:sourceAct": "Töövõime hindamise taotlusele kantavate andmete loetelu, töövõime hindamise tingimused ja töövõimet välistavate seisundite loetelu",
      "rdfs:label": "tegutsemisvõime (toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tegutsemisvoime"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_ekspertiisimeeskond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ekspertiisimeeskond",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töövõime hindamise pädevusega arstidest ja spetsialistidest (eelkõige füsio- või tegevusterapeut, psühholoog, eripedagoog või logopeed) koosnev meeskond, keda eksperdiarvamuse andja kaasab vajaduse korral eksperdiarvamuse andmiseks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030642_Par_2"
        }
      ],
      "estleg:sourceAct": "Töövõime hindamise taotlusele kantavate andmete loetelu, töövõime hindamise tingimused ja töövõimet välistavate seisundite loetelu",
      "rdfs:label": "ekspertiisimeeskond (toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ekspertiisimeeskond"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_arsti_vastuvott",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "arsti vastuvõtt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kui isik ei ole kuue kuu jooksul enne töövõime hindamise taotluse esitamist perearsti, teda põhiliselt raviva eriarsti või töötervishoiuarsti (edaspidi arst ) vastuvõtul käinud, teavitab töötukassa isikut töövõimetoetuse seaduse § 6 lõike 5 alusel arsti vastuvõtul käimise vajadusest ja määrab selleks tähtaja. Kui isik on kuue kuu jooksul enne töövõime taotluse esitamist mõne arsti vastuvõtul käinud, siis teda andmete täpsustamise vajaduse tõttu arsti vastuvõtule ei saadeta",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1030642_Par_2"
        }
      ],
      "estleg:sourceAct": "Töövõime hindamise taotlusele kantavate andmete loetelu, töövõime hindamise tingimused ja töövõimet välistavate seisundite loetelu",
      "rdfs:label": "arsti vastuvõtt (toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_arsti_vastuvott"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_tervishoiuteenuse_osutaja_vastuvott",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tervishoiuteenuse osutaja vastuvõtt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "töötukassa võib suunata isiku töövõimetoetuse seaduse § 7 lõike 3 alusel tervishoiuteenuse osutaja vastuvõtule visiidipõhisele hindamisele, et hinnata isiku tegutsemis- ja osalusvõimet isiku selgituste, vaatluse ja testide abil. Visiidipõhine hindamine tehakse juhul, kui töövõime hindamise taotlusel välja toodud piirangud ja terviseandmed erinevad üksteisest olulisel määral või arstide poolt tervise infosüsteemi sisestatud terviseandmed on sisult vastuolulised. Visiidipõhist hindamist ei tehta, kui isik ei ole seoses töövõime hindamise taotlusel välja toodud piirangutega arsti vastuvõtul käinud või taotluses välja toodud piiranguid kirjeldavad terviseandmed on olemas ja terviseandmetes vastuolud puuduvad, samuti uute diagnooside püstitamiseks või ägenemiste ja remissioonidega kulgevatest haigustest tulenevate piirangute tuvastamiseks",
        "@language": "et"
      },
