      "skos:definition": [
        {
          "@value": "vallavalitsuse poolt väljastatud dokument kauplemiseks avalikult kasutataval maa-alal.",
          "@language": "et"
        },
        {
          "@value": "vallavalitsuse väljastatud dokument kauplemiseks avalikult kasutataval maa-alal.",
          "@language": "et"
        },
        {
          "@value": "ametiasutuse või ametiasutuse hallatava asutuse väljastatud dokument kauplemiseks munitsipaalmaal, v.a avalike ürituste puhul, mille korraldajaks ei ole ametiasutus või ametiasutuse hallatav asutus. RT IV 2023-03-04 5 404032023005 2023-03-07",
          "@language": "et"
        },
        {
          "@value": "kaubanduse korraldaja poolt väljastatud dokument, mille alusel võib sellel märgitud tingimustel kaupa või teenust müüa.",
          "@language": "et"
        },
        {
          "@value": "korraldus, millega on määratud müügikoha hooajalisele laiendusele või hooajalisele müügikoha kasutamisele hind. RT IV 2024-04-23 3 423042024003 2024-05-01",
          "@language": "et"
        }
      ],
