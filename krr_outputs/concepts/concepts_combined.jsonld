    {
      "@id": "estleg:Concept_joelahtme_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1049453_hoolduspaevik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoolduspäevik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vabas vormis peetav dokument (päevik), milles kajastatakse reovee kohtkäitlussüsteemi hooldamisega seotud teavet",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049453_Par_2"
        }
      ],
      "estleg:sourceAct": "Jõelähtme valla reovee kohtkäitluse ja äraveo eeskiri",
