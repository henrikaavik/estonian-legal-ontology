      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_riigihanke_eest_vastutav_isik"
        }
      ]
    },
    {
      "@id": "estleg:Concept_tallinna_hankekord_t1058097_riigihanke_menetlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "riigihanke menetlus",
      "skos:definition": "riigihangete seaduse alusel läbiviidav menetlus, millega kaasneb kohustus teha riigihangete seaduse kohaselt riigihangete registris toiminguid ja mille eesmärk on lepingu sõlmimine või ideekavandi saamine; 16",
      "estleg:definedIn": [
        {
