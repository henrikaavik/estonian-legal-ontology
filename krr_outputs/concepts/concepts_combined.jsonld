      "@id": "estleg:Concept_saarde_vallavalitsuse_palgajuhend_t1058256_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "töötaja",
      "skos:definition": "vallavalitsusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd; 4",
