      },
      "rdfs:label": "reovee kohtkäitlus",
      "skos:definition": [
        {
          "@value": "reovee kogumine, puhastamine, immutamine pinnasesse või pinnasele või kompostimine üldjuhul reovee tekkekoha kinnistu piires; 3",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine, puhastamine, pinnasesse immutamine, suublasse juhtimine või taaskasutamine, sealhulgas kompostimine, üldjuhul reovee tekkekoha kinnistu piires; 2",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine kogumismahutisse, äravedu kogumismahutist ja purgimine ühiskanalisatsiooni või reovee puhastamine omapuhastis; 3",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine, vajadusel puhastamine, immutamine pinnasesse, kompostimine, üldjuhul reovee tekkekoha kinnistu piires; 10",
          "@language": "et"
        },
        {
          "@value": "reovee kogumine kogumismahutisse või puhastamine omapuhastis, sh heitvee immutamine või juhtimine suublasse; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "20",
        "@type": "xsd:integer"
      }
    },
