        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "teegrupp",
      "skos:definition": [
        {
          "@value": "loetelu teedest ja teelõikudest, mis on määruse lisas liiklusintensiivsuse ja strateegilise tähtsuse alusel määratud ühte gruppi neljast; 11",
          "@language": "et"
        },
        {
          "@value": "loetelu teedest ja teelõikudest, mis on Tallinna Linnavolikogu 20. detsembri 2013 määruse nr 31 \"Teede ja tänavate sulgemise maks\" lisas liiklusintensiivsuse ja strateegilise tähtsuse alusel määratud ühte gruppi neljast.",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
