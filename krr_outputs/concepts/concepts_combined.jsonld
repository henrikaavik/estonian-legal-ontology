    {
      "@id": "estleg:Concept_rae_valla_kaevetoode_eeskiri_t1023385_Vastutav_isik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Vastutav isik",
      "skos:definition": "kaevaja poolt kirjalikult määratud juriidiline isik kes omab vastavat ehitusalast pädevust ning ehituse valdkonna tegevusala registreeringut Majandustegevuse registris (MTR-is). Kui vastutavat isikut ei ole määratud, loetakse vastutavaks isikuks kaevaja tegevjuht või juhatuse liige. Kui kaevaja on füüsiline isik, siis on tal kohustus tellida Kaevetööd vastavat ehitusalast pädevust ja MTR registreeringut ehituse valdkonna tegevusalas „ehitamine“ omavalt isikult. 8 (",
      "estleg:definedIn": [
