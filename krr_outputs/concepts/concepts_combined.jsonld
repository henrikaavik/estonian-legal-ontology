        "@id": "estleg:Concept_valireklaam"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_raasiku_valla_reklaamimaarus_t1025627_reklaamialus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reklaamialus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asi, millele paigaldatakse või mille vahendusel edastatakse välireklaami",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1025627_Par_1"
        }
      ],
