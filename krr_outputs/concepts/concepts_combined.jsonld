      },
      "skos:definition": {
        "@value": "määratlemata isikute kasutuses olev ja üldjuhul hooneteta maa, millel võivad paikneda üksnes abihooned (tee, tänav, väljak, park, puhke- või virgestusala vms). Käesoleva määruse tähenduses ei loeta avalikult kasutatava maa-ala hulka kalmistute maad; 2) hooajaline kaubandus (edaspidi kaubandus ) – kauba või teenuse müük avalikult kasutataval munitsipaalmaal Lääne-Harju Vallavalitsuse (edaspidi vallavalitsus ) poolt lubatud kohas kaubanduse korraldaja omandis või valduses olevas müügikohas; 3) müügikoha hooajaline laiendus (edaspidi hooajaline laiendus ) – müügikoha vahetus läheduses väljaspool siseruume asuv ja müügikoha juurde kuuluv piiritletud ala, kus kaupleja vahetult pakub ja müüb kaupa või teenust; 4) hooajaline müügikoht (edaspidi müügikoht ) – avalikult kasutatavale munitsipaalmaale paigaldatav müügikoht, kus kaupleja vahetult pakub ja müüb kaupa või teenust või koht, mis on maa-alal kaubandustegevusega tegelemiseks sobivalt välja ehitatud või varustatud. Müügikohaks loetakse ka kandekaubandust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054273_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
      "rdfs:label": "avalikult kasutatav munitsipaalmaa (avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1054273)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_avalikult_kasutatav_munitsipaalmaa"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
