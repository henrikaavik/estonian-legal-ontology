      },
      "rdfs:label": "liitumistasu",
      "skos:altLabel": [
        {
          "@value": "Liitumistasu",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "tasu, mis tuleb kinnistuomanikul, hoonestusõiguse alusel maakasutajal või ehitise kui vallasasja omanikul maksta kinnistu või ehitise kui vallasasja veevärgi või kanalisatsiooni ühendamiseks ühisveevärgi või kanalisatsiooniga; 10",
          "@language": "et"
        },
        {
          "@value": "ühekordne tasu, mis tuleb kinnistu omanikul tasuda kinnistu veevärgi või kanalisatsiooni liitmiseks ÜVK-ga vee-ettevõtjale liitumiseks tehtud kulutuste katmiseks; 17",
          "@language": "et"
        },
        {
          "@value": "tasu, mis tuleb kinnistuomanikul, hoonestusõiguse alusel maakasutajal või ehitise kui vallasasja omanikul maksta kinnistu või ehitise kui vallasasja veevärgi või kanalisatsiooni ühendamiseks ühisveevärgi või kanalisatsiooniga; 15",
          "@language": "et"
        },
        {
          "@value": "tasu, mis tuleb kinnistuomanikul, hoonestusõiguse alusel maakasutajal või ehitise kui vallasasja omanikul maksta kinnistu või ehitise kui vallasasja veevärgi või kanalisatsiooni ühendamiseks ühisveevärgi või kanalisatsiooniga; 8",
          "@language": "et"
        },
        {
          "@value": "tasu, mis tuleb liitujal maksta tarbimiskoha veevärgi või kanalisatsiooni ühendamiseks ühisveevärgi või –kanalisatsiooniga. 10",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "36",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_liitumisvoimsus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "liitumisvõimsus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_taastuvelektri_tootmissea_t1055256_liitumisvoimsus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "liitumisvõimsus",
      "skos:definition": [
        {
          "@value": "elektriline võimus, mida asjakohase elektritaristu väljaehitamisel on võimalik ühendada jaotus- ja põhivõrku elektrienergia ostu ja müügi eesmärgil; 4",
          "@language": "et"
        }
      ]
    },
