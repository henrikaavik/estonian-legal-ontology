      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "turu-uuring",
      "skos:definition": [
        {
          "@value": "riigihanke ettevalmistamiseks riigihanke esemele vastavas valdkonnas tehtav analüüs või ettevõtjate või erialaliitudega konsulteerimine. Turu-uuringu eesmärk on välja selgitada, milliseid tingimusi on riigihanke tulemuslikuks läbiviimiseks võimalik ja otstarbekas esitada, võttes arvesse turul pakutavat, ettevõtjate võimalusi ja võimekust ning hinnataset",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
