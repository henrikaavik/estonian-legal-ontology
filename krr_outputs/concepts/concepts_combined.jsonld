      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_huvihariduse_ja_tegevuse_toetamise_kord_t1043095_Huviharidus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Huviharidus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pikaajaline süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal. Huviharidust omandatakse huvikooli seaduse alusel tegutsevas huvikoolis ja tugineb õppekavale.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043095_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla huvihariduse ja -tegevuse toetamise kord",
      "rdfs:label": "Huviharidus (luganuse_valla_huvihariduse_ja_tegevuse_toetamise_kord_t1043095)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_huviharidus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_luganuse_valla_huvihariduse_ja_tegevuse_toetamise_kord_t1043095_Huvitegevus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Huvitegevus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043095_Par_2"
        }
      ],
      "estleg:sourceAct": "Lüganuse valla huvihariduse ja -tegevuse toetamise kord",
