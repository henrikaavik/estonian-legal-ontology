      "rdfs:label": "hoolduskoormusega inimene",
      "skos:altLabel": [
        {
          "@value": "Hoolduskoormusega inimene",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "15-aastane ja vanem inimene, kes üldjuhul tasuta abistab hooldusvajadusega inimest; 3",
          "@language": "et"
        },
        {
          "@value": "tööealine hooldaja, kes hooldusvajadusega pereliikme hooldamise tõttu ei saa osaleda või jätkata osalemist tööturul täis- või osalise tööajaga või kellel on oht hoolduskoormuse tõttu tööturult välja langeda. 10",
          "@language": "et"
        },
        {
          "@value": "tööealine hooldaja, kes hooldusvajadusega pereliikme hooldamise tõttu ei saa osaleda või jätkata osalemist tööturul täis- või osalise tööajaga või kellel on oht hoolduskoormuse tõttu tööturult välja langeda; 5",
          "@language": "et"
        },
        {
          "@value": "tööealine isik, kes hooldusvajadusega pereliikme hooldamise tõttu ei saa osaleda või jätkata osalemist tööturul täis- või osalise tööajaga; 4",
          "@language": "et"
        }
      ]
    },
