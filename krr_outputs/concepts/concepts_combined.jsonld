      },
      "rdfs:label": "ettevõtja",
      "skos:definition": [
        {
          "@value": "füüsiline isik, kes pakub oma nimel tasu eest kaupu või teenuseid ning kellele kaupade müük või teenuste osutamine on püsiv tegevus, või äriühing äriseadustiku tähenduses",
          "@language": "et"
        },
        {
          "@value": "füüsiline isik, kes pakub oma nimel tasu eest kaupu või teenuseid ning kellele on kaupade müük või teenuste osutamine püsiv tegevus, või seaduses sätestatud äriühing",
          "@language": "et"
        },
        {
          "@value": "majandustegevusega tegelev üksus sõltumata tema õiguslikust vormist ja rahastamisviisist",
          "@language": "et"
        },
        {
          "@value": "meresõiduohutuse seaduse § 35 2 lõikes 2 nimetatud ettevõtja",
          "@language": "et"
        },
        {
          "@value": "pakkuja, taotleja või huvitatud isik.",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "8",
        "@type": "xsd:integer"
      },
