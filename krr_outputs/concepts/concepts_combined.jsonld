      },
      "skos:definition": {
        "@value": "kontori-, lao-, kultuur- hariduslik-, seltsitegevuse vm ruum, mida vallavalitsus annab üürile või tasuta kasutusse",
        "@language": "et"
      },
      "estleg:definedIn": [
