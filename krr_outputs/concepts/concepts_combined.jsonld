        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vaikeettevotja_digilahenduste_toetuse_andmise_kord_t1049765_digilahenduse_arendamise_lahteulesanne",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "digilahenduse arendamise lähteülesanne",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "dokument, milles on kirjeldatud ettevõtjale vajalikku digilahendust, digilahenduse arendamise eesmärki ja nõudeid, millele digilahendus peab vastama",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049765_Par_4"
        }
      ],
