    {
      "@id": "estleg:Concept_maardu_linna_infoturbepoliitika_t1049639_turvaintsident",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "turvaintsident",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "sündmus või sündmused, millega kaasneb andmete või muude infovarade käideldavuse, tervikluse või konfidentsiaalsuse kadu või tekib oluline oht andmete käideldavuse, tervikluse või konfidentsiaalsuse kao tekkeks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1049639_Par_2"
        }
      ],
      "estleg:sourceAct": "Maardu linna infoturbepoliitika",
      "rdfs:label": "turvaintsident (maardu_linna_infoturbepoliitika_t1049639)",
