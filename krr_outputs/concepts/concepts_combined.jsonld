    {
      "@id": "estleg:Concept_ettevotja_varustuskindluse_toetuse_tingimused_ja_kord_t1056746_taastuvenergia_allikad",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "taastuvenergia allikad",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "taastuvatest mittefossiilsetest allikatest pärit energia, nimelt tuuleenergia, päikeseenergia (päikese soojusenergia ja fotogalvaaniline päikeseenergia), geotermiline energia, ümbritseva keskkonna energia, loodete, lainete ja muu ookeanienergia, hüdroenergia ning biomassist, prügilagaasist, reoveepuhasti gaasist ja biogaasist toodetud energia",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056746_Par_4"
        }
      ],
      "estleg:sourceAct": "Ettevõtja varustuskindluse toetuse tingimused ja kord",
      "rdfs:label": "taastuvenergia allikad (ettevotja_varustuskindluse_toetuse_tingimused_ja_kord_t1056746)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_taastuvenergia_allikad"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
