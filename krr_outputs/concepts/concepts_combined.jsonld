      }
    },
    {
      "@id": "estleg:Concept_kaubanduse_korraldamine_tallinna_linnas_t1056502_luhiajaline_tanavakaubandus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lühiajaline tänavakaubandus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "kauba või teenuse müük Tallinna linna omandis oleval avalikult kasutataval maa-alal kuni kahel päeval ühe kuu jooksul. Lühiajaliseks tänavakaubanduseks ei loeta kandekaubandust, kaubandust avalikul üritusel või turukaubandust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056502_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaubanduse korraldamine Tallinna linnas",
      "rdfs:label": "lühiajaline tänavakaubandus (kaubanduse_korraldamine_tallinna_linnas_t1056502)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_luhiajaline_tanavakaubandus"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_kaubanduse_korraldamine_tallinna_linnas_t1056502_muugiala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "müügiala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ala, millel kaupleja soovib müüa või müüb kaupa või teenust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1056502_Par_2"
        }
      ],
      "estleg:sourceAct": "Kaubanduse korraldamine Tallinna linnas",
