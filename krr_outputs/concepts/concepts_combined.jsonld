    {
      "@id": "estleg:Concept_puudega_isikule_eluruumi_kohandamise_toetuse_maaramise_ja_ma_t1046923_kohandatav_eluruum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
