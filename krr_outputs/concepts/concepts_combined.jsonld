    {
      "@id": "estleg:Concept_reovee_kohtkaitluse_ja_araveo_eeskiri_t1043487_reovee_bioloogiline_puhastamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "reovee bioloogiline puhastamine",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ehk sekundaarne puhastamine on reoveest reoainete kõrvaldamine bioloogiliste protsesside toimel, mille tulemusena heitvesi vastab Vabariigi Valitsuse 29.11.2012. a määruses nr 99 “Reovee puhastamise ning heit- ja sademevee suublasse juhtimise kohta esitatavad nõuded, heit- ja sademevee reostusnäitajate piirmäärad ning nende nõuete täitmise kontrollimise meetmed“ esitatud heitvee reostusnäitajate piirväärtustele biokeemilise hapnikutarbe, heljuvaine ja keemilise hapnikutarbe osas",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043487_Par_2"
        }
      ],
      "estleg:sourceAct": "Reovee kohtkäitluse ja äraveo eeskiri",
