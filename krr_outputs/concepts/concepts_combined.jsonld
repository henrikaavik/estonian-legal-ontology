      },
      "skos:definition": {
        "@value": "kinnistusraamatusse iseseisva üksusena kantud kinnisasi (maapinna piiritletud osa ehk maatükk) või hoonestusõigus. Kinnistu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: maa-ala, territoorium, krunt, maaüksus ja katastriüksus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044267_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala valla heakorraeeskiri",
      "rdfs:label": "kinnistu (haljala_valla_heakorraeeskiri_t1044267)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_valla_heakorraeeskiri_t1044267_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omanik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle omandis on kinnistu või vallasasi. Omanikuga on eeskirja nõuete täitmisel võrdsustatud tema poolt volitatud valdaja, haldaja või kasutaja; 4) puhastusala (koormisala KOKS § 36 lõike 3 alusel) – on kõnnitee, mis asub teega külgneva kinnistu ja sõidutee vahel; 5) muru käesoleva määruse tähenduses lõigatud rohi ja rohuala; 6) rohumaa on kas looduslik rohumaa, poollooduslik rohumaa või kultuurrohumaa",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044267_Par_2"
        }
      ],
      "estleg:sourceAct": "Haljala valla heakorraeeskiri",
      "rdfs:label": "omanik (haljala_valla_heakorraeeskiri_t1044267)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_haljala_valla_heakorraeeskiri_t1044267_heakorratood",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "heakorratööd",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tolmu, liiva, prahi, maha langenud puulehtede ja -okste, lume ja jää vms koristamine, libedusetõrje teostamine, muru ja rohu niitmine, hekkide ja puude hoolduslõikus",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044267_Par_2"
        }
      ],
