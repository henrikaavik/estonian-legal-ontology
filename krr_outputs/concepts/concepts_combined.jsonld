      "skos:definition": [
        {
          "@value": "tarbija ja vee-ettevõtja vahel sõlmitud leping, mh nimetatud ka kui teenusleping ühisveevärgi ja -kanalisatsiooniteenuste osutamise kohta. 14",
          "@language": "et"
        },
        {
          "@value": "detailplaneeringu elluviimiseks sõlmitud haldusleping 2 (",
          "@language": "et"
        },
        {
          "@value": "ehitustööde teostamiseks ja tööde eest tasumiseks sõlmitavad lepingud, kus lepitakse kokku kohanduse saaja õigused ja kohustused. 2 (",
          "@language": "et"
        },
        {
          "@value": "Saue valla ja Elroni vahel sõlmitud leping, millega Saue vald võtab soodustatud isikutelt, kas osaliselt või tervikuna, üle tasu maksmise kohustuse; 8",
          "@language": "et"
        },
        {
          "@value": "servituudiga koormamiseks sõlmitav leping ja asjaõigusleping; 14",
          "@language": "et"
        }
      ],
