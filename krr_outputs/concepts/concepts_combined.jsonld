    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "teenistuja",
      "skos:definition": "vastavalt avaliku teenistuse seaduse §-le 5 on avalik teenistuja asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o töölepingu alusel töötav) töötaja; 2",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013184_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili Vallavalitsuse palgajuhend",
