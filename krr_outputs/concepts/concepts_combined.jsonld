    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_reklaampind",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "reklaampind",
      "skos:definition": "tasapinnaline või ruumiline objekt, mis paigaldatakse Tallinna linna haldusterritooriumile avalikkusele suunatud reklaami eksponeerimise eesmärgil. Reklaampind määratakse tasapinnalise reklaami puhul avalikkusele suunatud tervikliku reklaami pindalaga ja ruumilise reklaami puhul avalikkusele suunatud vaadete arvutuslike pindaladega; 10",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Tallinnas",
      "rdfs:label": "reklaampind (reklaamimaks_tallinnas_t1011811)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_reklaampind"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_reklaampind"
        }
      ]
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_mobiilne_konstruktsioon",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "mobiilne konstruktsioon",
      "skos:definition": "sõiduk, haagis või pukseeritav seade, mille vahendusel reklaami edastatakse. Mobiilne konstruktsioon ei pea olema kantud liiklusregistrisse; 2015-12-10 RT IV 2015-12-18 13 418122015013 2015-12-21 11",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
