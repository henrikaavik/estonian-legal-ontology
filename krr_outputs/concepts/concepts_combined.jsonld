    {
      "@id": "estleg:Concept_erahuvikool",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "erahuvikool",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_erahuvikoolide_toetamise_kord_t1048953_erahuvikool"
        },
        {
          "@id": "estleg:Concept_huvihariduse_toetamise_kord_t1043555_erahuvikool"
        },
        {
          "@id": "estleg:Concept_erahuvikooli_toetus_t1038866_erahuvikool"
