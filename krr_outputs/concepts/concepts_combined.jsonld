      "estleg:definitionCount": {
        "@value": "23",
        "@type": "xsd:integer"
      },
      "rdfs:label": "haljasala",
      "skos:definition": [
        {
          "@value": "teadlikult kujundatud maastik, maastikuosa või hoonete vaheline välisruum, mida iseloomustab ümberkujundatud reljeef, valitud taimestik ning vastavad funktsionaalsed rajatised",
          "@language": "et"
        },
        {
          "@value": "piiratud suurusega loodusliku või rajatud taimkattega ala, mille kujundus on inimeste loodud või mõjutatud",
          "@language": "et"
        },
        {
          "@value": "taimestikuga kaetud ala välisruumis, mis ei ole mets või metsa tunnustega ala. Samuti ala, mis on ettenähtud haljasalana, kuid millel tegelikkuses on taimestik rikutud või hävinenud",
          "@language": "et"
        },
        {
          "@value": "teadlikult kujundatud maastik, maastikuosa või hoonetevaheline välisruum, mida iseloomustab ümberkujundatud reljeef, valitud taimestik või vastavafunktsioonilised rajatised",
          "@language": "et"
        },
        {
          "@value": "muru, lillede, puude ja põõsastega kaetud ala linnas vm asulas",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "13",
        "@type": "xsd:integer"
      },
