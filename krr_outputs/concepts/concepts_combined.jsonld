      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_anija_vallavalitsuse_teenistujate_ja_hallatavate_asutuste_to_t1040811_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Anija vallaga avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik; 3) töötaja (vallavalitsuses) – vallavalitsuses eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks; 4) töötaja (vallavalitsuse hallatavas asutuses) – asutusega eraõiguslikus töösuhtes olev isik, kes töötab töölepingu alusel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040811_Par_2"
        }
      ],
      "estleg:sourceAct": "Anija Vallavalitsuse teenistujate ja hallatavate asutuste töötajate palgajuhend",
      "rdfs:label": "ametnik (anija_vallavalitsuse_teenistujate_ja_hallatavate_asutuste_to_t1040811)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_anija_vallavalitsuse_teenistujate_ja_hallatavate_asutuste_to_t1040811_palk",
      "@type": [
        "owl:NamedIndividual",
