        "@id": "estleg:Concept_suletav_ala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_teede_ja_tanavate_ajutise_sulgemise_eeskiri_t1013672_sulgeja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sulgeja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "füüsiline või juriidiline isik, kelle tegevusega kaasneb tee, teelõigu, parkla või väljaku täielik või osaline ajutine sulgemine olenemata sellest, kas talle on antud sulgemisluba või mitte; 2015-10-21",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047120_Par_2"
        }
      ],
