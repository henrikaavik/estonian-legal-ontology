        "@id": "estleg:Concept_kohalik_tee"
      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_kohalik_tee"
        }
      ]
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_teehoiu_eeskiri_t1061479_Eratee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Eratee",
      "skos:definition": "tee, mis paikneb juriidilise või füüsilise isiku kinnisasjal. Erateed võib kasutada ainult kinnisasja omaniku loal, välja arvatud alarmsõidukid ja erakorralise või sõjaseisukorra ajal kaitseväe sõidukid. 4 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061479_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla teehoiu eeskiri",
