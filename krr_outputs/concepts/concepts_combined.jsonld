    {
      "@id": "estleg:Concept_kaevandamisjaatmete_kaitlemise_kord_t1000061_suubla",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "suubla",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pinnavesi, põhjavesi, siirdevesi ja rannikuvesi vastavalt Veeseaduses esitatud määratlustele ning maapõue osa, millesse voolab nõrgvesi",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1000061_Par_2"
        }
      ],
