      ],
      "skos:prefLabel": {
        "@value": "ametiasutus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Järva valla asutus, mida finantseeritakse valla eelarvest ning mille ülesandeks on avaliku võimu teostamine; 2) ametiasutuse hallatav asutus (edaspidi hallatav asutus ) – vallavolikogu poolt teenuste osutamiseks moodustatud asutus, mis ei teosta avalikku võimu",
        "@language": "et"
      },
      "estleg:definedIn": [
