        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "madalad rakendusväärtused magnetväljade puhul",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasemed, mis on seotud meelelist toimet avaldava kokkupuute piirnormidega",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
