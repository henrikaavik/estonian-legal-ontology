        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "purgimissõlm",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "koht, mis on Türi valla ühisveevärgi ja -kanalisatsiooni arendamise kavas määratud tekkekohast ära veetud reovee ühiskanalisatsiooni juhtimiseks.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051640_Par_2"
        }
      ],
