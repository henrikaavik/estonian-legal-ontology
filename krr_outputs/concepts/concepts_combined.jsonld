        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rouge_vallavalitsuse_palgajuhend_t1040960_teenistuja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vastavalt avaliku teenistuse seaduse §-le 5 on avalik teenistuja asutusega avalik-õiguslikus teenistus- ja usaldussuhtes olev ametnik või eraõiguslikus töösuhtes olev (s.o. töölepingu alusel töötav) töötaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040960_Par_2"
        }
      ],
      "estleg:sourceAct": "Rõuge Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuja (rouge_vallavalitsuse_palgajuhend_t1040960)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rouge_vallavalitsuse_palgajuhend_t1040960_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on asutusega avalik-õiguslikus teenistus- ja usaldussuhtes ning teostab avalikku võimu. Ametnik töötab avaliku teenistuse seaduse alusel ning ametniku teenistuskohta nimetatakse ametikohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040960_Par_2"
        }
      ],
      "estleg:sourceAct": "Rõuge Vallavalitsuse palgajuhend",
      "rdfs:label": "ametnik (rouge_vallavalitsuse_palgajuhend_t1040960)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_ametnik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rouge_vallavalitsuse_palgajuhend_t1040960_tootaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "töötaja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "asutusega eraõiguslikus töösuhtes olev isik, kes ei teosta avalikku võimu, vaid teeb avaliku võimu teostamist toetavat tööd. Töötaja töötab töölepingu alusel ning töötaja teenistuskohta nimetatakse töökohaks",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040960_Par_2"
        }
      ],
      "estleg:sourceAct": "Rõuge Vallavalitsuse palgajuhend",
      "rdfs:label": "töötaja (rouge_vallavalitsuse_palgajuhend_t1040960)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tootaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rouge_vallavalitsuse_palgajuhend_t1040960_teenistuskoht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "teenistuskoht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametiasutuse teenistuskohtade koosseisus ettenähtud ameti- või töökoht",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040960_Par_2"
        }
      ],
      "estleg:sourceAct": "Rõuge Vallavalitsuse palgajuhend",
      "rdfs:label": "teenistuskoht (rouge_vallavalitsuse_palgajuhend_t1040960)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuskoht"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_rouge_vallavalitsuse_palgajuhend_t1040960_palk",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "palk",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametnikule või töötajale makstav põhipalk, muutuvpalk ning eritingimustes töötamise eest makstavad lisatasud (lisatasu öötöö, riiklikel pühadel töötamise ja ületunni ning valveaja eest) ning asendustasu. Palgajuhendis kasutatakse ametniku palga ja töötaja töötasu ühtse mõistena mõistet palk.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1040960_Par_2"
        }
      ],
      "estleg:sourceAct": "Rõuge Vallavalitsuse palgajuhend",
      "rdfs:label": "palk (rouge_vallavalitsuse_palgajuhend_t1040960)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_palk"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
