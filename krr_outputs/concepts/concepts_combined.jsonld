      },
      "skos:exactMatch": [
        {
          "@id": "estleg:Concept_jaatmete_kogumine"
        }
      ]
    },
    {
      "@id": "estleg:Concept_muhu_valla_jaatmehoolduseeskiri_t1055427_jaatmevaldaja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jäätmevaldaja",
      "skos:definition": "jäätmetekitaja või muu isik, riigi või kohaliku omavalitsuse asutus, kelle valduses on jäätmed; 15",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1055427_Par_2"
        }
      ],
      "estleg:sourceAct": "Muhu valla jäätmehoolduseeskiri",
