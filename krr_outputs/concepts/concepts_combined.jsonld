        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Saku valla noor on üldhariduskoolis või põhikoolijärgses kutseõppes õppiv kuni 19",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_saku_valla_laste_ja_noorte_sporditegevuse_toetamise_kord_t1055162_Saku_valla_noor_on_uldhariduskoolis_voi_pohikoolijargses_kutseoppes_oppiv_kuni_1"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Saku valla noor on üldhariduskoolis või põhikoolijärgses kutseõppes õppiv kuni 19",
      "skos:definition": [
        {
          "@value": "aastane noor, kelle elukoht Eesti rahvastikuregistri andmetel on Saku vald; 2",
          "@language": "et"
        }
      ]
    },
    {
