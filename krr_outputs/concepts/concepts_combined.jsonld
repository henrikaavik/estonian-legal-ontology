        "@id": "estleg:Concept_reovee_kogumismahuti"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_vaike_maarja_valla_reovee_kohtkaitluse_ja_araveo_eeskiri_t1051019_omapuhasti",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omapuhasti",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "rajatis, kus kõrvaldatakse reoveest saasteained mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega ja mille projekteeritud reostuskoormus ei ületa 49 inimekvivalenti",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051019_Par_2"
        }
      ],
      "estleg:sourceAct": "Väike-Maarja valla reovee kohtkäitluse ja äraveo eeskiri",
