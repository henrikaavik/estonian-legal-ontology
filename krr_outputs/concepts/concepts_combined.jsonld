      },
      "rdfs:label": "ametiisik",
      "skos:definition": [
        {
          "@value": "füüsiline isik, kellel on avaliku ülesande täitmiseks ametiseisund sõltumata sellest, kas ta täidab talle pandud ülesandeid alaliselt või ajutiselt, tasu eest või tasuta, teenistuses olles või vabakutselisena või lepingu, nimetamise või valimise alusel; 7",
          "@language": "et"
        }
      ]
    },
