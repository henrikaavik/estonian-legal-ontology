      "rdfs:label": "tee sulgemise laius",
      "skos:definition": [
        {
          "@value": "tee suletud osa laius, mida mõõdetakse kohast, kus suletud ala kõrval sõidu- või jalgtee vabaks jääv osa on kõige kitsam; 13",
          "@language": "et"
