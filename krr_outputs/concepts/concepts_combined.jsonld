      ],
      "skos:prefLabel": "jäätmekäitluskoha järelhooldus",
      "skos:definition": "suletud jäätmekäitluskoha keskkonnaseire ning võimaliku negatiivse keskkonnamõju, sealhulgas keskkonnahäiringu tõrje; 11",
