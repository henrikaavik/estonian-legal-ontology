      },
      "skos:definition": {
        "@value": "hoone fassaadil paikneva füüsilise või juriidilise isiku logo, nime ja kontaktandmete, tegevusala (ühes iseloomustava laiendiga või ilma selleta näiteks kauplus/toiduainete kauplus, töökoda/autoremonditöökoda jms) ja lahtiolekuaja, toitlustusettevõtte puhul ka pakutava toidu kohta käiva teabe eksponeerimine samal hoonel",
        "@language": "et"
      },
      "estleg:definedIn": [
