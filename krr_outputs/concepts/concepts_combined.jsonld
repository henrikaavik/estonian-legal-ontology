      "rdfs:label": "tarbija veevärk ja kanalisatsioon",
      "skos:definition": [
        {
          "@value": "ehitiste ja seadmete süsteem tarbimiskoha veega varustamiseks ühisveevärgist või reo- või sademevee ärajuhtimiseks ühiskanalisatsiooni. Tarbija veevärk ja kanalisatsioon ei kuulu ühisveevärgi ja –kanalisatsiooni hulka",
          "@language": "et"
        },
        {
          "@value": "ehitiste ja seadmete süsteem tarbimiskoha veega varustamiseks ühisveevärgist või reo- või sademevee ärajuhtimiseks ühiskanalisatsiooni. Tarbija veevärk ja kanalisatsioon ei kuulu ühisveevärgi ja -kanalisatsiooni hulka.",
          "@language": "et"
        },
        {
          "@value": "ehitiste ja seadmete süsteem tarbimiskoha veega varustamiseks ühisveevärgist või reo- või sademevee ärajuhtimiseks ühiskanalisatsiooni. Tarbija veevärk ja kanalisatsioon ei kuulu ühisveevärgi ja – kanalisatsiooni hulka.",
          "@language": "et"
        },
        {
          "@value": "ehitiste ja seadmete süsteem tarbimiskoha veega varustamiseks ühisveevärgist või reo- või sademevee ärajuhtimiseks ühiskanalisatsiooni. Tarbija veevärk ning kanalisatsioon ei kuulu ühisveevärgi ja -kanalisatsiooni hulka",
          "@language": "et"
