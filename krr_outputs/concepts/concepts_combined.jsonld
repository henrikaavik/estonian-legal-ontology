      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "põhipalk",
      "skos:definition": "isiku palga või töötasu fikseeritud osa, mis on määratud teenistuskoha ülesannete ning isiku teenistusalaste teadmiste, oskuste ja kogemuste põhjal; 5",
