    {
      "@id": "estleg:Concept_tapa_valla_uhisveevargi_ja_kanalisatsiooniga_liitumise_ja_ka_t1048396_vee_ettevotja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vee-ettevõtja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eraõiguslik juriidiline isik, kes varustab kliendi kinnistu veevärki ühisveevärgi kaudu veega või korraldab ühiskanalisatsiooni kaudu klientide reo- ning sademe- ja drenaaživee ning muu pinnase- ja pinnavee ärajuhtimist ja puhastamist ning järelevalvet",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1048396_Par_2"
        }
      ],
      "estleg:sourceAct": "Tapa valla ühisveevärgi ja -kanalisatsiooniga liitumise ja kasutamise eeskiri",
