      }
    },
    {
      "@id": "estleg:Concept_valireklaami_paigaldamise_eeskiri_t1029790_vallavalitsuse_reklaamikandja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "vallavalitsuse reklaamikandja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vallavalitsuse poolt reklaamipaigaldamiseks avalikku ruumi paigaldatud alus või seadeldis",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1029790_Par_2"
        }
      ],
