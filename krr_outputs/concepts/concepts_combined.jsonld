    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1054448_kaupleja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kaupleja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik või asutus, kes majandus- või kutsetegevuse raames pakub ja müüb kaupa või pakub ja osutab teenust",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054448_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord Mustvee vallas",
