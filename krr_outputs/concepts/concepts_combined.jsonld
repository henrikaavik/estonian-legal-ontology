      "rdfs:label": "üldkasutatav territoorium",
      "skos:definition": [
        {
          "@value": "maa-ala või veekogu osa, mis on avalikult kasutatav igaühe poolt.",
          "@language": "et"
        },
        {
          "@value": "avalikult kasutatav territoorium, mis hõlmab teid, tänavaid, teeradasid, parke, väljakuid, platse, haljasalasid, ehitisi jmt, mida võivad kasutada kõik isikud; 8",
          "@language": "et"
        },
        {
          "@value": "füüsilise või juriidilise isiku omandis või valduses oleva territooriumiga vahetult piirnev avalik koht",
          "@language": "et"
        },
        {
          "@value": "maa-ala, mis on avalikult kasutatav ehk määratlemata isikute ringile kasutamiseks antud või määratlemata isikute ringi kasutuses olev maa-ala.",
          "@language": "et"
        },
        {
          "@value": "osa valla haldusterritooriumist, mis hõlmab tänavaid, teid, platse, parke, haljasalasid, mänguväljakuid jmt ning mis on avalikult igaühe kasutatav.",
          "@language": "et"
        }
      ],
