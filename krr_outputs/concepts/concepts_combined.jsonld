      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "jäätmekäitleja",
      "skos:definition": "juriidiline või füüsiline isik, kes kogub, veab, taaskasutab ja kõrvaldab jäätmeid majandus- või kutsetegevusena ja omab või on kohustatud omama selleks tegevuseks keskkonnakaitseluba, sh jäätmete vahendaja ja edasimüüja; 9",
      "estleg:definedIn": [
