      },
      "skos:definition": {
        "@value": "reklaam, mis paigaldatakse müügi-, teenindus- või ettevõtja muu tegutsemiskoha ette ajutiselt mingiks perioodiks ööpäeva jooksul, kusjuures ühe külje pind ei ületa 1 m 2 ja koht ei ole kindlalt ühendatud maapinna ega ehitisega",
        "@language": "et"
      },
      "estleg:definedIn": [
