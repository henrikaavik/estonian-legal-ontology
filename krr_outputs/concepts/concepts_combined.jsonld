      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toovoime_hindamise_taotlusele_kantavate_andmete_loetelu_toov_t1030642_toovoime_hindamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "töövõime hindamine",
      "skos:definition": [
        {
          "@value": "pikaajalise tervisekahjustusega isiku töövõime ulatuse tuvastamine, mille käigus võetakse arvesse isiku terviseseisundit, isiku hinnangut oma tegutsemisvõimele ning sellest tulenevaid tegutsemise ja osalemise piiranguid, nende prognoosi ja eeldatavat kestust ja tehakse otsus töövõime ulatuse kohta ning vajaduse korral antakse soovitusi töötingimuste ja abivahendite kasutamise ja töövõime toetamise kohta; 2) tegutsemise ja osalemise piirang (edaspidi piirang ) – takistus, mida isik kogeb tegevuse sooritamisel või igapäevaelu olukordades",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
