      },
      "rdfs:label": "Külaelanik",
      "skos:altLabel": [
        {
          "@value": "külaelanik",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "inimene, kellel on vastavas külas püsiv või ajutine elukoht; 2",
          "@language": "et"
        },
        {
          "@value": "on isik, kellel on Koigi valla külas alaline elukoht, isik on alalise elaniku leibkonna- või pereliige või omab külas kinnisvara. 3 (",
          "@language": "et"
        }
      ]
    },
    {
