    {
      "@id": "estleg:Concept_tootervishoiu_ja_tooohutuse_nouded_elektromagnetvaljadest_mo_t1034216_korged_rakendusvaartused_magnetvaljade_puhul",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kõrged rakendusväärtused magnetväljade puhul",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasemed, mis on seotud kehalist toimet avaldava kokkupuute piirnormidega. Töötajale kehalist toimet avaldava kokkupuute ja meelelist toimet avaldava kokkupuute piirnormid ja rakendusväärtused on esitatud lisades 2 ja 3. Riskirühmadesse kuuluvad töötajad – töötajad, kes kasutavad siiratud meditsiiniseadet (näiteks kardiostimulaator) või kehal kantavat meditsiiniseadet (näiteks insuliinipump), rasedad ja alaealised. Töötaja peab tööandjat teavitama enda kuulumisest riskirühma.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1034216_Par_2"
        }
      ],
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded elektromagnetväljadest mõjutatud töökeskkonnale, elektromagnetväljadega kokkupuute piirnormid ja rakendusväärtused ning elektromagnetväljade mõõtmise kord",
      "rdfs:label": "kõrged rakendusväärtused magnetväljade puhul (tootervishoiu_ja_tooohutuse_nouded_elektromagnetvaljadest_mo_t1034216)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_korged_rakendusvaartused_magnetvaljade_puhul"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
