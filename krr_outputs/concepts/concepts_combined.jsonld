        }
      ]
    },
    {
      "@id": "estleg:Concept_laane_nigula_valla_teehoiu_eeskiri_t1061479_Metsatee",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Metsatee",
      "skos:definition": "on riigi omandisse jäetud maal paiknev valdavalt riigimetsa majandamiseks kasutatav tee. Metsateed võib kasutada igaüks, kui riigimetsa majandamist korraldav isik või riigiasutus ei ole metsateed või selle osa sulgenud või metsateel liiklust piiranud. 5 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061479_Par_2"
        }
      ],
      "estleg:sourceAct": "Lääne-Nigula valla teehoiu eeskiri",
      "rdfs:label": "Metsatee (laane_nigula_valla_teehoiu_eeskiri_t1061479)",
