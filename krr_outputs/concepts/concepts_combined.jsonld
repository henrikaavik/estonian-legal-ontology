      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_joesuu_linna_infoturbepoliitika_kinnitamine_t1047619_puudused_tookorralduses",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puudused töökorralduses",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juhtumid, kus järgitakse turvanõuete täitmise reegleid puudulikult või ei täideta neid, kasutusjuhendid või süsteemikirjeldused on ebaselged või puuduvad, süsteemile juurdepääsu reguleerimise vahend ehk parool on nõrk või ebapiisav või arvutisse on paigaldatud volitamata tarkvara; 5) turvaründed; nõrkus – infovara omadus, mis laseb ohul realiseeruda; risk – tõenäosus, et oht kasutab ära nõrkuse ja tekitab infovarale kahju; jääkrisk – risk, mida on mõistlik aktsepteerida; turvaintsident – mistahes kõrvalekalle infosüsteemi normaalse talitluse reeglitest.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047619_Par_6"
        }
      ],
      "estleg:sourceAct": "Narva-Jõesuu linna infoturbepoliitika kinnitamine",
      "rdfs:label": "puudused töökorralduses (narva_joesuu_linna_infoturbepoliitika_kinnitamine_t1047619)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_puudused_tookorralduses"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_narva_joesuu_linnaeelarve_ja_lisaeelarve_eelnou_koostamise_n_t1044071_eelarve",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eelarve",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "eelarveaasta põhitegevuse tulude, põhitegevuse kulude, investeerimistegevuse, finantseerimistegevuse ja likviidsete varade muutuse plaan koos täiendavate nõuete, volituste ja informatsiooniga, mis on aluseks vastava aasta tegevuste finantseerimisele",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1044071_Par_2"
        }
      ],
