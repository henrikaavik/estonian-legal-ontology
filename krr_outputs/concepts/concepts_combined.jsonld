    {
      "@id": "estleg:Concept_kiili_vallavalitsuse_palgajuhend_t1013184_lisatasu_ooajal_tehtava_too_eest",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "lisatasu ööajal tehtava töö eest",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "lisatasu, mida makstakse juhul kui teenistuja tööaeg langeb ööajale ning kui nimetatud kohustus ei sisaldu tema ametijuhendis ja seda ei ole arvestatud tema palga määramisel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1013184_Par_2"
        }
      ],
      "estleg:sourceAct": "Kiili Vallavalitsuse palgajuhend",
      "rdfs:label": "lisatasu ööajal tehtava töö eest (kiili_vallavalitsuse_palgajuhend_t1013184)",
