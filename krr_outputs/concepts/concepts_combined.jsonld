      "rdfs:label": "tiheasustusala",
      "skos:definition": [
        {
          "@value": "alevi ja küla selgelt piiritletav kompaktse asustusega ala.",
          "@language": "et"
        },
        {
          "@value": "üldplaneeringus määratud ala joonistel märgitud piirides; 6",
          "@language": "et"
        },
        {
          "@value": "aleviku ja/või küla selgelt piiritletava hoonestusega olemasolev või planeeritav territooriumi osa; 19",
          "@language": "et"
        },
        {
          "@value": "alevis, alevikus ja külas selgelt piiritletav kompaktse asustuse ja hoonestusega ala; 2",
          "@language": "et"
        },
        {
          "@value": "Anija valla üldplaneeringuga määratud olemasoleva või kavandatava tiheasustusega ala; 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "39",
        "@type": "xsd:integer"
      },
      "skos:closeMatch": [
