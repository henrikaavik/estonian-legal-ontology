    {
      "@id": "estleg:Concept_toimetulekuraskuses_pere",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Toimetulekuraskuses pere",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_rouge_valla_huvihariduse_ja_tegevuse_toetamise_kord_t1052488_Toimetulekuraskuses_pere"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Toimetulekuraskuses pere",
      "skos:definition": [
        {
          "@value": "perekond, kus kasvab 7- kuni 19-aastane noor ning kelle taotluse esitamise eelneva kuu netosissetulek peale eluasemekulude mahaarvamist jääb alla 1.5-kordse riikliku toimetulekupiiri.",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_toimetulekuraskustes_pere"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toimetulekuraskustes_inimene",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toimetulekuraskustes inimene",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_meetme_tooturul_osalemist_toetavad_hoolekandeteenused_elluvi_t1051695_toimetulekuraskustes_inimene"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toimetulekuraskustes inimene",
      "skos:definition": [
        {
          "@value": "18-aastane ja vanem inimene, kelle toimetulekut või kelle perekonna toimetulekut raskendavad ajutised või püsivad asjaolud, mille tulemusena ei ole võimalik rahuldada igapäevaelu vajadusi",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toimetulekuraskustes_leibkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toimetulekuraskustes leibkond",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_huvihariduses_ja_huvitegevuses_osalemise_toetamise_kord_t1056731_toimetulekuraskustes_leibkond"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toimetulekuraskustes leibkond",
      "skos:definition": [
        {
          "@value": "leibkond, kus noor elab ning viimase kuue kuu keskmine netosissetulek iga pereliikme kohta jääb alla 1/2 Vabariigi Valitsuse poolt kinnitatud töötasu alammäära.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toimetulekuraskustes_pere",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toimetulekuraskustes pere",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetuse_maksmise_kord_toimetule_t1043553_toimetulekuraskustes_pere"
        },
        {
          "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetuse_maksmise_kord_toimetule_t1052214_toimetulekuraskustes_pere"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toimetulekuraskustes pere",
      "skos:definition": [
        {
          "@value": "on pere, kus kasvab 7-19-aastane noor (sh puudega noor) ning kelle netosissetulek iga pereliikme kohta pere eluasemekulude ja puudest tulenevate lisakulude maha arvamisest jääb alla riiklikult kehtestatud toimetulekupiiri kahekordset määra",
          "@language": "et"
        },
        {
          "@value": "pere, kus kasvab 7- kuni 19-aastane noor ning kelle perekonna eelmise kolme kuu keskmine netosissetulek peale eluasemekulude, ülalpidamiskohustuste täitmiseks makstud elatise ja eluasemelaenu kulude mahaarvamist on väiksem kui riiklikult kehtestatud kahekordne toimetulekupiir pereliikme kohta",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_toimetulekuraskuses_pere"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_toimetulekuraskustes_voi_riskiruhma_pere",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toimetulekuraskustes või riskirühma pere",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetamine_t1059488_toimetulekuraskustes_voi_riskiruhma_pere"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toimetulekuraskustes või riskirühma pere",
      "skos:definition": [
        {
          "@value": "pere, kus kasvab erivajadusega laps, kus kasvab kolm või enam alaealist last, kus puudub teise vanema toetus, kus üks lapsevanem on töötu või tema tervislik seisund ei võimalda töötamist või pere, kus perekonna sissetulek pereliikme kohta jääb alla kahekordset toimetulekupiiri. (Toimetulekupiir käesoleva korra tähenduses on Riigikogu kehtestatud toimetulekupiir.).",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
