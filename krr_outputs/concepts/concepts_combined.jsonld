      "@id": "estleg:Concept_toimetulekuraskustes_inimene",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toimetulekuraskustes inimene",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_meetme_tooturul_osalemist_toetavad_hoolekandeteenused_elluvi_t1051695_toimetulekuraskustes_inimene"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toimetulekuraskustes inimene",
      "skos:definition": [
        {
          "@value": "18-aastane ja vanem inimene, kelle toimetulekut või kelle perekonna toimetulekut raskendavad ajutised või püsivad asjaolud, mille tulemusena ei ole võimalik rahuldada igapäevaelu vajadusi; 6",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_toimetulekuraskustes_leibkond",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toimetulekuraskustes leibkond",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_huvihariduses_ja_huvitegevuses_osalemise_toetamise_kord_t1056731_toimetulekuraskustes_leibkond"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toimetulekuraskustes leibkond",
      "skos:definition": [
        {
          "@value": "leibkond, kus noor elab ning viimase kuue kuu keskmine netosissetulek iga pereliikme kohta jääb alla 1/2 Vabariigi Valitsuse poolt kinnitatud töötasu alammäära. RT IV 2023-10-06 1 406102023001 2023-10-09 6",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_toimetulekuraskustes_pere",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "toimetulekuraskustes pere",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetuse_maksmise_kord_toimetule_t1043553_toimetulekuraskustes_pere"
        },
        {
          "@id": "estleg:Concept_huvihariduse_ja_huvitegevuse_toetuse_maksmise_kord_toimetule_t1052214_toimetulekuraskustes_pere"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "toimetulekuraskustes pere",
      "skos:definition": [
        {
          "@value": "on pere, kus kasvab 7-19-aastane noor (sh puudega noor) ning kelle netosissetulek iga pereliikme kohta pere eluasemekulude ja puudest tulenevate lisakulude maha arvamisest jääb alla riiklikult kehtestatud toimetulekupiiri kahekordset määra; 6",
          "@language": "et"
        },
        {
          "@value": "pere, kus kasvab 7- kuni 19-aastane noor ning kelle perekonna eelmise kolme kuu keskmine netosissetulek peale eluasemekulude, ülalpidamiskohustuste täitmiseks makstud elatise ja eluasemelaenu kulude mahaarvamist on väiksem kui riiklikult kehtestatud kahekordne toimetulekupiir pereliikme kohta; 2",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_toimetulekuraskuses_pere"
        }
      ]
    },
    {
      "@id": "estleg:Concept_toimetulekuraskustes_voi_riskiruhma_pere",
