      ],
      "skos:prefLabel": {
        "@value": "investeerimisprojekt",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "taastekavas kinnitatud reformi või investeeringu osaks olev või sellest eraldiseisev investeering või muu projekt, mille toetuse saaja on kindlaks määratud ja mille taastekavas kindlaks määratud tegevused moodustavad üksikprojektina terviku",
        "@language": "et"
      },
      "estleg:definedIn": [
