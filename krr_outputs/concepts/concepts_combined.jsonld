      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenust_vajav_isik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_koduteenuse_osutamise_kord_t1043350_hoolduskava",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "hoolduskava",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "on teenuse vajaduse hindamise juures kohustuslik lisadokument, milles kajastatakse osutatavate teenuste loetelu, maht, teenuse osutamise aeg ja koht ning millele kirjutavad alla teenust vajav isik või tema seadusjärgne ülalpidaja.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1043350_Par_3"
        }
      ],
      "estleg:sourceAct": "Koduteenuse osutamise kord",
