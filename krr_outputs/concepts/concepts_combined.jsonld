      "rdfs:label": "kaeveala",
      "skos:altLabel": [
        {
          "@value": "Kaeveala",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "maa-ala, kus paikneb kaevatav süvend (kaevik) ja kaevikuga vahetult piirnev maa-ala, kus hoitakse kaevetööks materjale, sõidukeid, masinaid, mehhanisme ja seadmeid; 4",
          "@language": "et"
        },
        {
          "@value": "on maa-ala, kus paikneb kaevik ja kaevikuga vahetult piirnev maa-ala, kus hoitakse kaevetööks materjale, sõidukeid, masinaid, mehhanisme ja seadmeid; 4",
          "@language": "et"
        },
        {
          "@value": "Kaeveloas määratud maa-ala, kus paikneb kaevik ja kaevikuga vahetult piirnev maa-ala, kus hoitakse Kaevetöödeks materjale, sõidukeid, masinaid, mehhanisme ja seadmeid, samuti ohutusala ning juurdepääsud Kaevetööde teostajale(tele). 16 (",
          "@language": "et"
        },
        {
          "@value": "kaevik ja kaevikuga piirnev maa-ala, millele ulatub kaevetööst tulenev mõju (kaevetööl kasutatavate materjalide, sõidukite ja seadmete hoidmine, juurdepääsuteeks vajalik ala, liikluse ümberkorraldamise ala jms), mille piirid määratakse vajadusel kaeveloas.",
          "@language": "et"
        },
        {
          "@value": "kaevik ja kaevikuga piirnev maa-ala, millele ulatub kaevetööst tulenev mõju (kaevetööl kasutatavate materjalide, sõidukite ja seadmete hoidmine, juurdepääsuteeks vajalik ala, liikluse ümberkorraldamise ala jms), mille piirid määratakse vastavalt vajadusele kaevamisloas; 11",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "10",
        "@type": "xsd:integer"
      },
