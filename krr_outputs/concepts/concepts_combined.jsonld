      }
    },
    {
      "@id": "estleg:Concept_sotsiaalteenuste_osutamise_tingimused_ja_kord_t1052761_puue",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "puue",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "inimese anatoomilise, füsioloogilise või psüühilise struktuuri või funktsiooni kaotus või kõrvalekalle, mis koostoimes suhtumuslike ja keskkondlike takistustega tõkestab ühiskonnaelus osalemist teistega võrdsetel alustel ning mille raskusastme ja liigi on tuvastanud Sotsiaalkindlustusamet",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052761_Par_2"
        }
      ],
      "estleg:sourceAct": "Sotsiaalteenuste osutamise tingimused ja kord",
      "rdfs:label": "puue (sotsiaalteenuste_osutamise_tingimused_ja_kord_t1052761)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_puue"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sotsiaalteenuste_osutamise_tingimused_ja_kord_t1052761_erivajadus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "erivajadus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "vaimne või füüsiline eripära või kõrvalekalle, mis tingib abivajaduse iseseisva toimetuleku tagamisel ja mida Sotsiaalkindlustusamet ei ole puudena tuvastanud",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1052761_Par_2"
        }
      ],
      "estleg:sourceAct": "Sotsiaalteenuste osutamise tingimused ja kord",
