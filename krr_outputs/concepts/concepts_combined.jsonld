      },
      "rdfs:label": "infoturbe haldus on infoturbe rajamise läbimõeldud ja toimiva protsessi loomiseks ja pidevaks ümberkujunduseks vajalik plaanimis",
      "skos:definition": [
        {
          "@value": ", suunamis- ja kontrollimistöö. Infoturbe haldus on pidev protsess, mille aluseks olevate strateegiate ja kontseptsioonide tõhusust ja toimivust pidevalt kontrollitakse ja vajaduse korral ajakohastatakse; 7",
          "@language": "et"
        },
        {
          "@value": ", suunamis- ja kontrollimistöö, arvestades, et infoturbe haldus on pidev protsess, mille aluseks olevate strateegiate ja kontseptsioonide tõhusust ja toimivust pidevalt kontrollitakse ja vajaduse korral ajakohastatakse; 7",
          "@language": "et"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "estleg:Concept_infoturbehaldus_on_infoturbe_rajamise_labimoeldud_ja_toimiva_protsessi_loomiseks"
