        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "nädalatasu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "tasu mis saadakse kuu osalustasu (§ 2 p 1) jagamisel juulikuu tööpäevade arvuga ja saadud tasust lähtuvalt arvestatakse nädalatasu. Nädalatasu rakendatakse valvelasteaia lasteaiakoha osalustasu arvestamisel.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1061010_Par_1"
        }
      ],
      "estleg:sourceAct": "Vanemate omaosalus Märjamaa valla lasteaedades",
      "rdfs:label": "nädalatasu (vanemate_omaosalus_marjamaa_valla_lasteaedades_t1061010)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_nadalatasu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
