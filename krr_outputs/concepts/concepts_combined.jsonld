      "estleg:definesConcept": {
        "@id": "estleg:Concept_teenistuja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_paide_linnavalitsuse_ametiasutuse_struktuur_ja_teenistuskoht_t1062050_Teenistuskoht",
