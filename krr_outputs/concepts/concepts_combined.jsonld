      "rdfs:label": "arst",
      "skos:definition": [
        {
          "@value": "puude raskusastme tuvastamist taotleva isiku perearst või isikut põhiliselt raviv eriarst, kellel on tema terviseseisundi kirjeldamiseks asjakohased andmed; 3",
          "@language": "et"
        },
        {
          "@value": "registreeritud tervishoiutöötajate riiklikus registris arstina; 6",
