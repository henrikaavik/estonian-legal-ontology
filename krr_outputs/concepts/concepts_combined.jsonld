        "@language": "et"
      },
      "skos:definition": {
        "@value": "ametliku e-posti infosüsteemi kaudu lõppkasutajale teabe kättesaadavaks tegemiseks vajalik unikaalne e-posti aadress, mis moodustatakse füüsilisest isikust lõppkasutajale isikukoodi põhjal ja juriidilisest isikust lõppkasutajale registrikoodi põhjal.",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1016781_Par_2"
