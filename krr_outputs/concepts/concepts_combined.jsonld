        {
          "@id": "estleg:Reg_1055786_Par_2"
        }
      ],
      "estleg:sourceAct": "Detailplaneeringukohaste ja planeeringulahenduse elluviimiseks otseselt vajalike ning sellega funktsionaalselt seotud ehitiste väljaehitamise ja väljaehitamisega seotud kulude kandmise kord",
