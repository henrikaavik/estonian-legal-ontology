      "rdfs:label": "hulkuv loom",
      "skos:altLabel": [
        {
          "@value": "Hulkuv loom",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "märgistamata loom, kelle omanikku ei ole võimalik tuvastada või loomapidaja juurest lahti pääsenud loom, kes viibib omaniku või looma eest vastutava isiku juuresolekuta väljaspool loomapidajale kuuluvat või tema kasutuses olevat territooriumi; 4",
          "@language": "et"
        },
        {
          "@value": "märgistamata loom, kelle omanikku ei ole võimalik tuvastada või loomapidaja juurest lahti pääsenud loom, kes viibib omaniku või looma eest vastutava isiku juuresolekuta väljaspool loomapidajale kuuluvat või tema kasutuses olevat territooriumi; 3",
          "@language": "et"
        },
        {
          "@value": "loom, kes viibib loomapidaja juuresolekuta väljaspool loomapidajale kuuluvat või tema valduses olevat territooriumi või kes on identifitseerimata ja kelle omanikku ei ole võimalik tuvastada; 3",
          "@language": "et"
        },
        {
          "@value": "loomapidaja juurest lahti pääsenud loom, kes viibib omaniku või looma eest vastutava isiku juuresolekuta väljaspool loomapidajale kuuluvat või tema kasutuses olevat territooriumi või identifitseerimata loom, kelle omanikku ei ole võimalik tuvastada; 3",
          "@language": "et"
        },
        {
          "@value": "loom, kelle omanikku või valdajat ei ole võimalik tuvastada, või kes on loomapidaja juurest lahti pääsenud ja viibib loomapidaja juuresolekuta väljaspool loomapidajale kuuluvat või tema kasutuses olevat territooriumi. 3",
          "@language": "et"
        }
      ],
      "estleg:definitionVariantCount": {
        "@value": "12",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "estleg:Concept_humanitaarabi",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "humanitaarabi",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_arengukoostoo_tegemise_ja_humanitaarabi_andmise_tingimused_j_t1061969_humanitaarabi"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "humanitaarabi",
      "skos:definition": [
        {
          "@value": "arenguriigile antav kiireloomuline rahaline või esemeline abi või oskusteave või tegevus, mille eesmärk on loodusõnnetusest, kliimamuutusest või inimtegevusest põhjustatud katastroofi ajal või selle järel päästa inimelusid, vähendada inimeste kannatusi ja tagada inimväärseks eluks hädavajalik; samuti abi, mille eesmärk on nimetatud olukorda ennetada ja parandada valmisolekut sellele reageerimiseks; 7",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_huvide_konflikt",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huvide konflikt",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_tallinna_hankekord_t1058097_huvide_konflikt"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "huvide konflikt",
      "skos:definition": [
        {
          "@value": "olukord, kus linna asutuse või tema nimel tegutseva isiku töötajal, ametnikul, juhatuse liikmel või muul pädeval esindajal, kes on kaasatud riigihanke ettevalmistamisse või korraldamisse või kes võib muul moel mõjutada selle riigihanke tulemust, on otseselt või kaudselt finantsalaseid, majanduslikke või muid isiklikke huvisid, mida võib käsitada tema erapooletust või sõltumatust kahjustavatena; 3",
          "@language": "et"
        }
      ]
    },
    {
