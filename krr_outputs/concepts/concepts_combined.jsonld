      },
      "rdfs:label": "ehitise laiendamine",
      "skos:definition": [
        {
          "@value": "ehitamine, mille käigus muudetakse olemasolevat ehitist sellele juurde- ehk külge-, peale- või allaehitamisega",
          "@language": "et"
        }
      ],
