    {
      "@id": "estleg:Concept_kohandatud_eluruum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kohandatud eluruum",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
