    {
      "@id": "estleg:Concept_sademeveekanalisatsiooni_avarii",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "sademeveekanalisatsiooni avarii",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kohila_valla_uhisveevargi_ja_kanalisatsiooni_kasutamise_eesk_t1061205_sademeveekanalisatsiooni_avarii"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "sademeveekanalisatsiooni avarii",
      "skos:definition": [
        {
          "@value": "sademeveekanalisatsiooni ehitiste või seadmete ettenägematu purunemine või rikkiminek, mille tagajärjel oluliselt halveneb või katkeb piirkonna sademevee kokku kogumine ja ära juhtimine ning mille tagajärjel tekib üleujutuse oht",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sademeveekorraldus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sademeveekorraldus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_viimsi_valla_sademeveesusteemide_kasutamise_eeskiri_t1051954_Sademeveekorraldus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Sademeveekorraldus",
      "skos:definition": [
        {
          "@value": "kogu sademevee valdkonda (sh sellega seotud tegevusi, korraldust, seadusandlust ja rajatisi) hõlmav süsteem.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_sademeveesusteem",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Sademeveesüsteem",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_viimsi_valla_sademeveesusteemide_kasutamise_eeskiri_t1051954_Sademeveesusteem"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "Sademeveesüsteem",
      "skos:definition": [
        {
          "@value": "ühtne ehitiste süsteem sademevee kogumiseks, ärajuhtimiseks ja/või puhastamiseks. 3) Drenaaž/drenaažisüsteem – perforeeritud torusid ja/või kaeve/mahuteid sisaldav süsteem sademevee pinnasesse immutamiseks. 4) Eesvool/eelvool – kuivendusvõrgust voolava liigvee ärajuhtimiseks või niisutusvõrgu veehaardesse vee juurdevooluks rajatud veejuhe või loodusliku veekogu reguleeritud lõik, mille veeseisust või toru veejuhtme vee läbilaskevõimest sõltub reguleeriva võrgu nõuetekohane toimimine või suublaks olev vooluveekogu (nt kraav, jõgi, oja).",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
