          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_toetuse_andmise_tingimused_j_t1046780_energiamargis"
        },
        {
          "@id": "estleg:Concept_vaikeelamute_energiatohususe_suurendamise_toetuse_kasutamise_t1049699_energiamargis"
        },
        {
          "@id": "estleg:Concept_vaikeelamute_rekonstrueerimise_toetamine_t1058695_energiamargis"
        }
      ],
      "estleg:definitionCount": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiamärgis",
      "skos:definition": [
        {
          "@value": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav märgis, mis annab infot projekteeritava või olemasoleva hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav märgis, mis annab infot projekteeritava või olemasoleva hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta; energiasäästu maht – energiamärgise kohase energiaerikasutuse ja energiaarvutusel põhineva energiamärgise kohase planeeritava energiaerikasutuse vahe, kusjuures energiaerikasutuseks loetakse aastane tarnitud energiate summaarne kasutus kilovatt-tundides hoone köetava pinna ruutmeetri kohta [kWh/(m²·a)]",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 alusel kehtestatud nõuetele vastav tähis, mis annab infot hoone projekteeritud energiavajaduse või tegeliku energiatarbimise kohta",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis",
          "@language": "et"
        },
        {
          "@value": "ehitusseadustiku § 66 lõike 6 alusel kehtestatud nõuetele vastav olemasoleva hoone energiamärgis; mittetoetatav kulu – paragrahvi 1 lõikes 5 sätestatud juhul mitteabikõlblik kulu perioodi 2014–2020 struktuuritoetuse seaduse (edaspidi struktuuritoetuse seadus ) tähenduses",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_energiamargistus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiamärgistus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_energiamojuga_toodete_energia_ja_muude_ressursside_tarbimise_t1003070_energiamargistus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiamärgistus",
      "skos:definition": [
        {
          "@value": "rakendusmeetmes sätestatud nõuetele vastav teave toote kohta, mis sisaldab infot toote elektrienergia, muude energialiikide ja vajaduse korral muude oluliste ressursside tarbimise kohta toote kasutamise ajal",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_energiamargistuse_loata_kasutamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiamärgistuse loata kasutamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_energiamojuga_toodete_energia_ja_muude_ressursside_tarbimise_t1003070_energiamargistuse_loata_kasutamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiamärgistuse loata kasutamine",
      "skos:definition": [
        {
          "@value": "energiamärgistuse kasutamine muul kui liikmesriigi ametiasutuste või Euroopa Liidu institutsioonide poolt viisil, mida ei ole ette nähtud käesoleva direktiivi või delegeeritud õigusaktiga",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_energiamojuga_toode",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiamõjuga toode",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_energiamojuga_toodete_energia_ja_muude_ressursside_tarbimise_t1003070_energiamojuga_toode"
        },
        {
          "@id": "estleg:Concept_energiamojuga_toote_tahistamise_teabega_varustamise_ja_vasta_t1002501_energiamojuga_toode"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiamõjuga toode",
      "skos:definition": [
        {
          "@value": "mis tahes kaup, mille kasutamine mõjutab energiatarbimist ning mis lastakse turule või võetakse kasutusele, sealhulgas osad, mis on ette nähtud Euroopa Parlamendi ja nõukogu direktiivi 2010/30/EL rakendusmeetme kohaldamisalasse kuuluvatesse energiamõjuga toodetesse paigaldamiseks, kui need on lõppkasutajate jaoks turule lastud või kasutusele võetud üksikosana ning kui nende keskkonnatoimet saab eraldi hinnata",
          "@language": "et"
        },
        {
          "@value": "mis tahes kaup, millel on selle kasutamisajal mõju energiatarbimisele, mis lastakse turule või võetakse kasutusele, sealhulgas osad, mis on ette nähtud Euroopa Parlamendi ja nõukogu direktiivi 2009/125/EÜ reguleerimisalasse kuuluvasse tootesse paigaldamiseks, ning mis on lõppkasutaja jaoks turule lastud või kasutusele võetud üksikosadena, mille keskkonnatoimet saab eraldi kontrollida",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_energiasalvestusseade",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiasalvestusseade",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_energiasalvestuse_pilootp_t1055298_energiasalvestusseade"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiasalvestusseade",
      "skos:definition": [
        {
          "@value": "elektrienergia vähemalt ühetunniseks salvestamiseks ja hoiustamiseks või soojusenergia aktiivseks või passiivseks salvestamiseks ja hoiustamiseks ette nähtud paigaldis koos selle toimimiseks vajalike lisadega; energiasalvestusseadme rajamine – uue energiasalvestusseadme ehitamine seadmete ja materjalide ostu ning paigaldusega või olemasoleva mahuti rekonstrueerimine soojuse salvestiks",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_energiatootmisseade",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "energiatootmisseade",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_korterelamute_rekonstrueerimise_erakorralise_toetuse_andmise_t1054178_energiatootmisseade"
        },
        {
          "@id": "estleg:Concept_paikesepaneelide_investeeringutoetuse_andmise_tingimused_ja_t1042802_energiatootmisseade"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "energiatootmisseade",
      "skos:definition": [
        {
          "@value": "päikese abil ehitusseadustiku § 65 lõike 3 alusel kehtestatud nõuetele vastava elektrienergia, mida kasutatakse eelkõige hoone toimimiseks või kasutamiseks, tootmise seade",
          "@language": "et"
        },
        {
          "@value": "päikese abil elektrit tootev taastuvenergia tootmisseade",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
