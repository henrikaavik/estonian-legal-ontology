        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kuluaruanne",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "aruanne, kus on esitatud kululiigid, kulu kujunemise alused ja sisu kirjeldus, eelarve täitmine, kasutatud toetus ning taotleja oma- ja kaasfinantseering. Kuluaruandele lisatakse abikõlblike kulude tegemist tõendavad dokumendid (arvete ja maksekorralduste koopiad). Kuluaruande vormi kinnitab strateegiakeskus",
        "@language": "et"
      },
      "estleg:definedIn": [
