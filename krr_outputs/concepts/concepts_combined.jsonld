      },
      "rdfs:label": "eralasteaed ja eralastehoid",
      "skos:definition": [
        {
          "@value": "õppeasutus, mille pidaja on eraõiguslik juriidiline isik või füüsilisest isikust ettevõtja ning mis võimaldab alushariduse omandamist alushariduse riikliku õppekava alusel ja tegutseb alusharidusseaduse alusel antud tegevusloa alusel.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_eralasteasutus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "eralasteasutus",
        "@language": "et"
      },
