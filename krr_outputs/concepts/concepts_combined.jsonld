        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "täiendusõpe",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_kaasaegse_ja_uuendusliku_oppevara_uhiskasutuskorralduse_toet_t1038763_taiendusope"
        },
        {
          "@id": "estleg:Concept_tanapaevase_opikasituse_rakendamine_ning_kompetentsikeskuste_t1031393_taiendusope"
        }
      ],
      "estleg:definitionCount": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "rdfs:label": "täiendusõpe",
      "skos:definition": [
        {
          "@value": "õpetajate ja haridusasutuste juhtide professionaalset arengut toetavad arenduslahendused. Täiendusõpe on suunatud õpetajate ja koolijuhtide kutsealaste teadmiste ja oskuste süvendamisele, mis loob uusi võimalusi nende poolt omandatud kutsemeisterlikkuse efektiivsemaks kasutamiseks",
          "@language": "et"
        },
        {
          "@value": "õpetajate professionaalset arengut toetavad lahendused, mis on suunatud õpetajate õppevara kasutamiseks vajalike teadmiste ja oskuste süvendamisele ning loovad uusi võimalusi nende poolt omandatud kutsemeisterlikkuse efektiivsemaks kasutamiseks.",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
