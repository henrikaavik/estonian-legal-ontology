          "@value": "seade või seadeldis, milles osakesi kiirendatakse, mille tulemusena kiiratakse ioniseerivat kiirgust energiaga rohkem kui 1 megaelektronvolti",
          "@language": "et"
        }
      ],
      "skos:inScheme": {
