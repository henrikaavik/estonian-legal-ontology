      "skos:definition": {
        "@value": "vee-ettevõtja ja kliendi vahel sõlmitud müügileping kliendile veevarustuse ja reo-, sademe- ja drenaaživee ärajuhtimise teenuse müügiks",
        "@language": "et"
      },
