    {
      "@id": "estleg:Concept_johvi_valla_eelarvest_kultuuritegevuse_ja_kohaliku_omaalgatu_t1054761_muuseum",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "muuseum",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ühiskonna ja selle arengu teenistuses alaliselt tegutsev kultuuri- ja haridusasutus, mis on üldsusele avatud ning mille ülesanne on eelkõige Jõhvi vallaga seotud kultuuriväärtuste ja -lugude kogumine, dokumenteerimine, jäädvustamine, säilitamine ja publitseerimine",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054761_Par_2"
        }
      ],
