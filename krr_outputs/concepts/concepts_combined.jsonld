        "@language": "et"
      },
      "skos:definition": {
        "@value": "vajaliku kõrvalabi, juhendamise ja järelevalve tagamine isikule, kes ei tule iseseisvalt toime söömise, hügieenitoimingute, riietumise, liikumise või suhtlemisega või kes oma tegevuse või tegevusetusega võib tekitada kahju iseenda või teiste inimeste elule, tervisele või varale.",
        "@language": "et"
      },
      "estleg:definedIn": [
