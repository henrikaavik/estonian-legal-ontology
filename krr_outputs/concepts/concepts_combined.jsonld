    {
      "@id": "estleg:Concept_saarde_vallavalitsuse_palgajuhend_t1058256_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "ametnik",
      "skos:definition": "isik, kes on vallavalitsusega avalik-õiguslikus teenistus- ja usaldussuhtes ning nimetatud ametikohale, millel teostatakse avalikku võimu; 3",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058256_Par_2"
        }
      ],
