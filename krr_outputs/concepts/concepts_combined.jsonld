    {
      "@id": "estleg:Concept_aia",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "aia",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
