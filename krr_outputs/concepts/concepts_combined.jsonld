    {
      "@id": "estleg:Concept_sotsiaaltransporditeenuse_osutamise_juhend_t1018233_Kandeabiteenus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Kandeabiteenus",
      "skos:definition": "kliendi kandmine kodust, haiglaruumist vm mistahes korrusel asuvast hoonesisesest asukohast sõidukisse või sõidukist sõidukijuhi abiga. 6",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1018233_Par_1"
        }
      ],
