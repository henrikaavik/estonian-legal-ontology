    {
      "@id": "estleg:Concept_huvitegevuse_ja_huvihariduse_toetuse_maaramise_ja_maksmise_k_t1047523_huviharidus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "huviharidus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "pikaajaline süsteemne juhendatud tegelemine huvialaga vaba tahte alusel üldhariduse tasemeõppest ja kutseõppest vabal ajal, et omandada süvendatud teadmisi ja oskusi valitud huvialal. Huviharidust omandatakse huvikooli seaduse alusel tegutsevas koolis (kunstikool, muusikakool, spordikool)",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1047523_Par_3"
        }
      ],
