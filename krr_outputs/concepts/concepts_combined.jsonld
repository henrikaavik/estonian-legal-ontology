    {
      "@id": "estleg:Concept_viru_nigula_valla_heakorra_eeskiri_t1058823_omanik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "omanik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Viru-Nigula vallas asuva kinnis- või vallasasja omanik, kellega heakorra nõuete täitmisel on võrdsustatud tema poolt volitatud valdaja, haldaja või kasutaja",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058823_Par_2"
        }
      ],
      "estleg:sourceAct": "Viru-Nigula valla heakorra eeskiri",
      "rdfs:label": "omanik (viru_nigula_valla_heakorra_eeskiri_t1058823)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_omanik"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viru_nigula_valla_heakorra_eeskiri_t1058823_kinnistu",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kinnistu",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "juriidilise või füüsilise isiku omandis või valduses olev kinnisasi. Kinnistu mõistega on heakorra nõuete täitmisel võrdsustatud mõisted: maa-ala, territoorium, krunt, maaüksus, katastriüksus ja maatüki olulised osad",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058823_Par_2"
        }
      ],
      "estleg:sourceAct": "Viru-Nigula valla heakorra eeskiri",
      "rdfs:label": "kinnistu (viru_nigula_valla_heakorra_eeskiri_t1058823)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_kinnistu"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viru_nigula_valla_heakorra_eeskiri_t1058823_tiheasustusala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tiheasustusala",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "Viru-Nigula valla üldplaneeringuga määratud linnas ja alevikus selgelt piiritletav kompaktse asustuse ja hoonestusega ala",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058823_Par_2"
        }
      ],
      "estleg:sourceAct": "Viru-Nigula valla heakorra eeskiri",
      "rdfs:label": "tiheasustusala (viru_nigula_valla_heakorra_eeskiri_t1058823)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_tiheasustusala"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_viru_nigula_valla_heakorra_eeskiri_t1058823_avalik_koht",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "avalik koht",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "territoorium, ehitis või selle osa, mis on avatud üldiseks kasutamiseks või mis on tegelikult üldkasutatav, või määratlemata isikute ringile kasutamiseks antud või määratlemata isikute ringi kasutuses olev maa-ala, ehitis, ruum või selle osa, samuti ühissõiduk; 5) puhastusala (koormisala kohaliku omavalitsuse korralduse seaduse § 36 lõike 3 alusel) – kinnistuga külgnev kõnnitee, haljasriba ning muu ala, mis asub kinnistu ja sõidutee vahel",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1058823_Par_2"
        }
      ],
      "estleg:sourceAct": "Viru-Nigula valla heakorra eeskiri",
      "rdfs:label": "avalik koht (viru_nigula_valla_heakorra_eeskiri_t1058823)",
