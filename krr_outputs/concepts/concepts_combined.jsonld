      "estleg:definesConcept": {
        "@id": "estleg:Concept_kaubanduse_korraldaja"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_avalikult_kasutataval_maa_alal_kaubanduse_korraldamise_noude_t1051973_tanavakaubandus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "tänavakaubandus",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "avalikult kasutataval maa-alal kauba või teenuse müük kaupleja poolt paigaldatud ajutiselt müügikohalt, müügiletilt või auto pealt, müügiautomaadist, müügikärult ja kandekaubandusena. Tänavakaubanduseks ei loeta kaupleja müügikoha hooajalist laiendamist",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1051973_Par_2"
        }
      ],
      "estleg:sourceAct": "Avalikult kasutataval maa-alal kaubanduse korraldamise nõuded ja kord",
