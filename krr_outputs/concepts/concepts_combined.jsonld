    {
      "@id": "estleg:Concept_homoopaatiliste_preparaatide_muugiloa_taotlemise_tingimused__t158606_Homoopaatiline_lahteaine_on_taimse_voi_loomse_paritoluga_materjalist_valmistatud",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "Homöopaatiline lähteaine on taimse või loomse päritoluga materjalist valmistatud lähte",
      "skos:definition": "ehk ematinktuur või glütseroolitõmmis, keemilise või mineraalaine puhul tahke või vedel aine, mis saadakse taimse või loomse materjali ekstraheerimisel lahustiga ning mida kasutatakse homöopaatilise preparaadi tootmiseks. Homöopaatiline lähteaine võib olla valmistatud taimede mahladest, kuhu vajadusel lisatakse lahustit. Samuti võivad homöopaatiliseks lähteaineks olla pulbriliste ainete lahused, mida kasutatakse algkontsentratsioonis või lahjendustena homöopaatiliste preparaatide valmistamiseks. Ematinktuuri tähis on «TM» või Ø. 4 (",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_158606_Par_2"
        }
      ],
      "estleg:sourceAct": "Homöopaatiliste preparaatide müügiloa taotlemise tingimused ja kord",
      "rdfs:label": "Homöopaatiline lähteaine on taimse või loomse päritoluga materjalist valmistatud lähte (homoopaatiliste_preparaatide_muugiloa_taotlemise_tingimused__t158606)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_homoopaatiline_lahteaine_on_taimse_voi_loomse_paritoluga_materjalist_valmistatud"
      },
