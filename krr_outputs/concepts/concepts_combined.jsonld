      },
      "rdfs:label": "reovesi",
      "skos:altLabel": [
        {
          "@value": "Reovesi",
          "@language": "et"
        }
      ],
      "skos:definition": [
        {
          "@value": "üle kahjutuspiiri rikutud ja enne suublasse juhtimist puhastamist vajav vesi; 13",
          "@language": "et"
        },
        {
          "@value": "üle kahjustuspiiri rikutud ja enne suublasse juhtimist puhastamist vajav vesi; 26",
          "@language": "et"
        },
        {
          "@value": "on üle kahjutuspiiri rikutud ning puhastamist vajav vesi; 23",
          "@language": "et"
        },
        {
          "@value": "üle kahjustuspiiri rikutud ja enne suublasse juhtimist puhastamist vajav vesi; 18",
          "@language": "et"
        },
        {
          "@value": "olmes, tööstuses või muus tootmises tekkinud vesi, mis ületab kehtestatud heite piirväärtusi ja mida tuleb enne suublasse juhtimist puhastada. Reoveeks peetakse ka ühisvoolsesse kanalisatsiooni juhitud sademevett; 2",
          "@language": "et"
        }
      ],
