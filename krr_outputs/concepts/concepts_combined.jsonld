    {
      "@id": "estleg:Concept_mustvee_valla_ametiasutuse_palgajuhend_t1054711_ametnik",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "ametnik",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "isik, kes on Mustvee vallaga avalik-õiguslikus teenistus- ja usaldussuhtes ning on nimetatud ametiasutuses ametikohale, millel teostatakse avalikku võimu",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1054711_Par_2"
        }
      ],
