      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265_nutika_spetsialiseerumise_fookusvaldkonnad",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "nutika spetsialiseerumise fookusvaldkonnad",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "TAIE arengukavas kirjeldatud Eesti arenguvajadustele ja -võimalustele vastavad eelisarendatavad teadus- ja arendustegevuse, innovatsiooni ja ettevõtluse valdkonnad, milleks on digilahendused igas eluvaldkonnas, tervisetehnoloogiad- ja teenused, kohalike ressursside väärindamine ning nutikad ja kestlikud energialahendused",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1063265_Par_2"
        }
      ],
      "estleg:sourceAct": "Marie Skłodowska Curie Action järeldoktori individuaalgrandi ja ERC grandi taotlemise edukuse tõstmiseks toetuse taotlemise, toetuse eraldamise ning toetuse tagasinõudmise tingimused ja kord",
      "rdfs:label": "nutika spetsialiseerumise fookusvaldkonnad (marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265)",
      "estleg:definesConcept": {
        "@id": "estleg:Concept_nutika_spetsialiseerumise_fookusvaldkonnad"
      },
      "skos:inScheme": {
        "@id": "estleg:LegalConceptScheme"
      }
    },
    {
      "@id": "estleg:Concept_marie_sk_odowska_curie_action_jareldoktori_individuaalgrandi_t1063265_taitja",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "täitja",
        "@language": "et"
      },
      "skos:definition": {
        "@value": "ERC projekti täitmises osalev doktorikraadi või sellele vastava kvalifikatsiooniga alus- ja rakendusuuringuid või eksperimentaalarendust läbi viiv inimene või doktorant, kelle töö on taotluses esitatud projektiga sisuliselt seotud ning kelle töötasu kaetakse täielikult või osaliselt ERC projekti vahenditest; 8) vastuvõttev asutus (edaspidi ka asutus või taotleja ) – Eestis registreeritud teadus- ja arendusasutus, kõrgkool või muu era- või avaliku sektori asutus, kus nõuetele vastav teadlane soovib järeldoktori projekti ellu viia, või kus vastutav täitja ERC grandi toetuse kasutamise ajal töötab",
        "@language": "et"
      },
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1063265_Par_2"
