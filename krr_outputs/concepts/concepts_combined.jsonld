        }
      ]
    },
    {
      "@id": "estleg:Concept_reklaamimaks_tallinnas_t1011811_sotsiaalreklaam",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalConcept"
      ],
      "skos:prefLabel": "sotsiaalreklaam",
      "skos:definition": "reklaam, mille eesmärk on saavutada hinnangute andmise kaudu inimese käitumine avalikes huvides ja milles teatud probleemile keskendudes ei pakuta kaubamärgipõhist, vaid üldist lahendit; 14",
      "estleg:definedIn": [
        {
          "@id": "estleg:Reg_1011811_Par_1"
        }
      ],
      "estleg:sourceAct": "Reklaamimaks Tallinnas",
