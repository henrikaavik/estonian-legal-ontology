          "@value": "koolieelne lasteasutus (v.a lastehoiuteenust osutavad organisatsioonid), üldhariduskool (sh täiskasvanute gümnaasium) ja kutseõppeasutus; 3",
          "@language": "et"
        },
        {
          "@value": "koolieelne lasteasutus, põhikool, gümnaasium ja kutseõppeasutus; 4",
          "@language": "et"
        },
        {
          "@value": "koolieelne lasteasutus, üldhariduskool, kutseõppeasutus, rakenduskõrgkool ja ülikool; 5",
          "@language": "et"
        },
        {
          "@value": "riigi- või munitsipaalasutus nagu rakenduskõrgkool või kutseõppeasutus, kus õpetamine ja õppimine toimub vastavalt õppekavale; 7",
          "@language": "et"
        },
        {
          "@value": "õppe läbiviimise õigust omav kutseõppeasutus või kõrgkool; 5",
          "@language": "et"
        }
      ],
