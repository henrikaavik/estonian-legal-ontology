    {
      "@id": "estleg:Concept_rasked_ilmaolud",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "rasked ilmaolud",
