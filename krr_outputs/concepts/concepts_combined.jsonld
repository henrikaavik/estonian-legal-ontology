    {
      "@id": "estleg:Concept_kliimakindlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kliimakindlus",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_toetuse_andmise_tingimused_ja_kord_rohevesiniku_kasutuselevo_t1055698_kliimakindlus"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kliimakindlus",
      "skos:definition": [
        {
          "@value": "kliimakindlus on taristu vastupanuvõime võimalikele pikaajalistele kliimamõjudele. Kliimakindluse tagamine on protsess, mille eesmärk on vältida taristu vastuvõtlikkust võimalikele pikaajalistele kliimamõjudele, tagades samas, et järgitakse energiatõhususe esikohale seadmise põhimõtet ja projektist tulenevate kasvuhoonegaaside heitkoguste tase on kooskõlas 2050. aastaks saavutatava kliimaneutraalsuse eesmärgiga. RT I 2024-02-07 1 107022024001 2024-02-10",
          "@language": "et"
        }
      ]
    },
    {
      "@id": "estleg:Concept_kliimakindluse_tagamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Concept"
      ],
      "skos:prefLabel": {
        "@value": "kliimakindluse tagamine",
        "@language": "et"
      },
      "estleg:hasDefinitionNode": [
        {
          "@id": "estleg:Concept_avalike_biometaani_sisestuspunktide_toetuse_andmise_tingimus_t1062653_kliimakindluse_tagamine"
        }
      ],
      "estleg:definitionCount": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "rdfs:label": "kliimakindluse tagamine",
      "skos:definition": [
        {
          "@value": "protsess, mille eesmärk on vältida taristu vastuvõtlikkust võimalikele pikaajalistele kliimamõjudele, tagades, et järgitakse energiatõhususe esikohale seadmise põhimõtet ja et projektist tulenevate kasvuhoonegaaside heitkoguste tase on kooskõlas 2050. aastaks saavutatava kliimaneutraalsuse eesmärgiga; 12",
          "@language": "et"
        }
      ]
    },
