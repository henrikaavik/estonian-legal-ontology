    {
      "@id": "estleg:HMS_Par_HaldusmenetluseMoisteJaKohaldamisala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "HMS § 1–§ 2",
      "rdfs:label": "Haldusmenetluse ülesanne ja mõiste",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusmenetlus_haldusmenetluse_peep"
      },
      "estleg:summary": "Määratleb haldusmenetluse eesmärgi ja ulatuse ning kirjeldab haldusmenetlust kui haldusorgani tegevust haldusakti andmisel, toimingu sooritamisel või halduslepingu sõlmimisel.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map"
      }
    },
    {
      "@id": "estleg:HMS_Par_HaldusmenetlusePohimotted",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "HMS § 3–§ 7",
      "rdfs:label": "Haldusmenetluse põhimõtted",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusmenetlus_haldusmenetluse_peep"
      },
      "estleg:summary": "Sätestab seaduslikkuse, proportsionaalsuse, uurimispõhimõtte, avalikkuse ja menetluse eesmärgipärase korraldamise nõuded, mille järgi haldusorgan peab menetlust läbi viima.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:HMS_Par_MenetlusosalisedJaAsjaajamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "HMS § 11–§ 34",
      "rdfs:label": "Menetlusosalised, asjaajamine ja kättetoimetamine",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusmenetlus_haldusmenetluse_peep"
      },
      "estleg:summary": "Reguleerib menetlusosaliste õigusi ja kohustusi, esindust, dokumentide vormi/säilitamist, ametlikku kinnitamist, dokumentide kättetoimetamist ning menetlustähtaegade arvestamist ja ennistamist.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map"
      }
    },
    {
