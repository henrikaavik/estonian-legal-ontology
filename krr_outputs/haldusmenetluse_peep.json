    {
      "@id": "estleg:HMS_Par_HaldusmenetluseMoisteJaKohaldamisala",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_HMS"
      ],
      "estleg:paragrahv": "HMS § 1–§ 2",
      "rdfs:label": "Haldusmenetluse ülesanne ja mõiste",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusmenetlus_haldusmenetluse_peep"
      },
      "estleg:summary": "Määratleb haldusmenetluse eesmärgi ja ulatuse ning kirjeldab haldusmenetlust kui haldusorgani tegevust haldusakti andmisel, toimingu sooritamisel või halduslepingu sõlmimisel.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map_2026"
      }
    },
    {
      "@id": "estleg:HMS_Par_HaldusmenetlusePohimotted",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_HMS"
      ],
      "estleg:paragrahv": "HMS § 3–§ 7",
      "rdfs:label": "Haldusmenetluse põhimõtted",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusmenetlus_haldusmenetluse_peep"
      },
      "estleg:summary": "Sätestab seaduslikkuse, proportsionaalsuse, uurimispõhimõtte, avalikkuse ja menetluse eesmärgipärase korraldamise nõuded, mille järgi haldusorgan peab menetlust läbi viima.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map_2026"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:HMS_Par_MenetlusosalisedJaAsjaajamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_HMS"
      ],
      "estleg:paragrahv": "HMS § 11–§ 34",
      "rdfs:label": "Menetlusosalised, asjaajamine ja kättetoimetamine",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusmenetlus_haldusmenetluse_peep"
      },
      "estleg:summary": "Reguleerib menetlusosaliste õigusi ja kohustusi, esindust, dokumentide vormi/säilitamist, ametlikku kinnitamist, dokumentide kättetoimetamist ning menetlustähtaegade arvestamist ja ennistamist.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map_2026"
      }
    },
    {
      "@id": "estleg:HMS_Par_MenetluseLabiviimineJaAvatudMenetlus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_HMS"
      ],
      "estleg:paragrahv": "HMS § 35–§ 50",
      "rdfs:label": "Haldusmenetluse läbiviimine ja avatud menetlus",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusmenetlus_haldusmenetluse_peep"
      },
      "estleg:summary": "Koondab menetlustoimingute tegemise korra, menetluse peatamise/lõpetamise, ärakuulamise ja avatud menetluse reeglid olukordades, kus otsus mõjutab laiemat isikute ringi.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map_2026"
      },
      "estleg:targetGroup": [
        "citizen"
      ]
    },
    {
      "@id": "estleg:HMS_Par_HaldusaktiYldsatted",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_HMS"
      ],
      "estleg:paragrahv": "HMS § 51–§ 53",
      "rdfs:label": "Haldusakti mõiste, liigid ja kõrvaltingimus",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusaktid_haldusmenetluse_peep"
      },
      "estleg:summary": "Määratleb haldusakti, osahaldusakti ja eelhaldusakti ning sätestab haldusaktile kõrvaltingimuste seadmise alused.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map_2026"
      }
    },
    {
      "@id": "estleg:HMS_Par_HaldusaktiOiguspArasusJaVorm",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_HMS"
      ],
      "estleg:paragrahv": "HMS § 54–§ 59",
      "rdfs:label": "Haldusakti õiguspärasus, vorm ja põhjendamine",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusaktid_haldusmenetluse_peep"
      },
      "estleg:summary": "Sätestab haldusakti õiguspärasuse eeldused, vorminõuded ja põhjendamisnõude ning reeglid ilmse ebatäpsuse parandamiseks.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map_2026"
      }
    },
    {
      "@id": "estleg:HMS_Par_HaldusaktiKehtivusJaTuHisus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_HMS"
      ],
      "estleg:paragrahv": "HMS § 60–§ 63",
      "rdfs:label": "Haldusakti kehtivus, teatavakstegemine ja tühisus",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_haldusaktid_haldusmenetluse_peep"
      },
      "estleg:summary": "Reguleerib haldusakti kehtivaks muutumist, haldusakti või selle andmisest keeldumise teatavakstegemist ning tühise haldusakti juhtumeid.",
      "estleg:sourceAct": "Haldusmenetluse seadus",
      "estleg:partOfAct": {
        "@id": "estleg:HMS_Map_2026"
      }
    },
    {
      "@id": "estleg:HMS_Par_HaldusaktiMuutmineJaKehtetuksTunnistamine",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_HMS"
      ],
      "estleg:paragrahv": "HMS § 64–§ 70",
      "rdfs:label": "Haldusakti muutmine ja kehtetuks tunnistamine",
