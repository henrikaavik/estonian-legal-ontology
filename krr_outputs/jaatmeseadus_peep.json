      ],
      "estleg:paragrahv": "§ 12",
      "rdfs:label": "§ 12. Jäätmehoolduse arendamine",
      "estleg:requestedCluster": {
        "@id": "jäätmehooldus"
      },
      "estleg:summary": "Sätestab jäätmehoolduse arendamise üldsuunad, sh süsteemse planeerimise ja keskkonnahoidliku korralduse põhimõtted.",
      "estleg:sourceAct": "Jäätmeseadus"
    },
    {
