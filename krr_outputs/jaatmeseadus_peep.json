      "estleg:paragrahv": "§ 14",
      "rdfs:label": "§ 14. Jäätmete kogumine, liigiti kogumine ja vedamine",
      "estleg:requestedCluster": {
        "@id": "jäätmehooldus"
      },
      "estleg:summary": "Reguleerib jäätmete kogumise ja veo korraldust, sh liigiti kogumise kohustusi jäätmete ohutu käitluse tagamiseks.",
      "estleg:sourceAct": "Jäätmeseadus"
    },
