      "estleg:paragrahv": "§ 11",
      "rdfs:label": "§ 11. Jäätmehooldus",
      "estleg:requestedCluster": {
        "@id": "jäätmehooldus"
      },
      "estleg:summary": "Määratleb jäätmehoolduse kui jäätmete käitlemise, tekke vältimise ja sellega seotud korraldusmeetmete terviku.",
      "estleg:sourceAct": "Jäätmeseadus"
    },
    {
      "@id": "estleg:JäätS_Par_12",
