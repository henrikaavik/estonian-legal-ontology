      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Konventsiooni ratifitseerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Euroopa Liidu Nõukogu konventsiooni sissenõudmiskulude määramise kohta kesksel tollivormistusel ratifitseerimise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:euroopa_liidu_noukogu_konventsiooni_siss_Map"
      },
      "estleg:summary": {
        "@value": "Ratifitseerida Euroopa Liidu Nõukogu konventsioon keskse tollivormistuse kohta seoses traditsiooniliste omavahendite ELi eelarve kasutusse andmisel endale jäetavate siseriiklike sissenõudmiskulude määramisega¹, mis on alla kirjutatud 2009. aasta 10. märtsil Brüsselis.",
        "@language": "et"
      },
      "estleg:legalText": "Ratifitseerida Euroopa Liidu Nõukogu konventsioon keskse tollivormistuse kohta seoses traditsiooniliste omavahendite ELi eelarve kasutusse andmisel endale jäetavate siseriiklike sissenõudmiskulude määramisega¹, mis on alla kirjutatud 2009. aasta 10. märtsil Brüsselis.",
