      "rdfs:label": {
        "@value": "§ 2. Ratifitseerimisel teha järgmine reservatsioon:",
        "@language": "et"
      },
      "estleg:sourceAct": "Terrorismi tõkestamise Euroopa konventsiooni ratifitseerimise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:TTEKR_Map"
      },
      "estleg:summary": {
        "@value": "Konventsiooni artikli 13 lõike 1 kohaselt ning kooskõlas selles sätestatud tingimustega reserveerib Eesti Vabariik õiguse keelduda väljaandmisest konventsiooni artiklis 1 nimetatud ükskõik millise kuriteo puhul, mida ta peab poliitiliseks kuriteoks või poliitilise kuriteoga seotud kuriteoks.",
        "@language": "et"
      },
      "estleg:legalText": "Konventsiooni artikli 13 lõike 1 kohaselt ning kooskõlas selles sätestatud tingimustega reserveerib Eesti Vabariik õiguse keelduda väljaandmisest konventsiooni artiklis 1 nimetatud ükskõik millise kuriteo puhul, mida ta peab poliitiliseks kuriteoks või poliitilise kuriteoga seotud kuriteoks.",
