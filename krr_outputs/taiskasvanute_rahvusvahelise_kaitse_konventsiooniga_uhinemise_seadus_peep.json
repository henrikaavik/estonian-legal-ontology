      "rdfs:label": {
        "@value": "§ 3. Reservatsioon",
        "@language": "et"
      },
      "estleg:sourceAct": "Täiskasvanute rahvusvahelise kaitse konventsiooniga ühinemise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:TRKKU_Map"
      },
      "estleg:summary": {
        "@value": "Ühinemisel teha artikli 56 alusel artikli 51 lõike 2 suhtes reservatsioon, et Eesti Vabariigi keskasutusele või muule ametiasutusele originaalkeeles saadetud materjalidele peab olema lisatud tõlge inglise keelde, kui tõlge eesti keelde ei ole võimalik.",
        "@language": "et"
      },
      "estleg:legalText": "Ühinemisel teha artikli 56 alusel artikli 51 lõike 2 suhtes reservatsioon, et Eesti Vabariigi keskasutusele või muule ametiasutusele originaalkeeles saadetud materjalidele peab olema lisatud tõlge inglise keelde, kui tõlge eesti keelde ei ole võimalik.",
