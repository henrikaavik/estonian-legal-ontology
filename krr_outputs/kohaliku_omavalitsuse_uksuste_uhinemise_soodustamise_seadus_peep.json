    {
      "@id": "estleg:KOUS_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Seaduse eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohaliku omavalitsuse üksuste ühinemise soodustamise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:KOUS_Map"
      },
      "estleg:summary": {
        "@value": "Seaduse eesmärk on soodustada kohaliku omavalitsuse üksuste ühinemist ja territooriumi haldusjaotuse korrastumist, millega kaasneb kohaliku omavalitsuse üksuste haldussuutlikkuse ja edukate projektitaotluste koostamise suutlikkuse tõus, kohaliku omavalitsuse üksuste poolt tema territooriumil pakutavate avalike teenuste kättesaadavuse ja kvaliteedi paranemine ning kohaliku omavalitsuse üksuste koostöövõime arenemine.",
        "@language": "et"
      },
      "estleg:legalText": "Seaduse eesmärk on soodustada kohaliku omavalitsuse üksuste ühinemist ja territooriumi haldusjaotuse korrastumist, millega kaasneb kohaliku omavalitsuse üksuste haldussuutlikkuse ja edukate projektitaotluste koostamise suutlikkuse tõus, kohaliku omavalitsuse üksuste poolt tema territooriumil pakutavate avalike teenuste kättesaadavuse ja kvaliteedi paranemine ning kohaliku omavalitsuse üksuste koostöövõime arenemine.",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_KOUS_1"
      },
      "estleg:isPartOf": {
        "@id": "estleg:Chapter_KOUS_1"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:KOUS_Par_1_Lg_1"
        }
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Institution_kohalik_omavalitsus"
        }
      ],
      "estleg:hasVersion": [
        {
          "@id": "estleg:KOUS_Par_1_v778809"
        }
      ]
    },
    {
      "@id": "estleg:KOUS_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Seaduse eesmärk on soodustada kohaliku omavalitsuse üksuste ühinemist ja territooriumi haldusjaotuse korrastumist, millega kaasneb kohaliku omavalitsuse üksuste haldussuutlikkuse ja edukate projektitaotluste koostamise suutlikkuse tõus, kohaliku omavalitsuse üksuste poolt tema territooriumil pakutavate avalike teenuste kättesaadavuse ja kvaliteedi paranemine ning kohaliku omavalitsuse üksuste koostöövõime arenemine.",
      "estleg:parentProvision": {
        "@id": "estleg:KOUS_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Institution_kohalik_omavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:KOUS_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Seaduse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohaliku omavalitsuse üksuste ühinemise soodustamise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:KOUS_Map"
      },
      "estleg:summary": {
        "@value": "(1) Seadusega kehtestatakse kohaliku omavalitsuse üksuste ühinemise soodustamise põhimõtted ja ühinemise soodustamise tingimused, kohaliku omavalitsuse üksuste pakutavate avalike teenuste ühinemisjärgsele kättesaadavusele esitatavad nõuded, ühinemisega seotud kulude katteks riigieelarvest toetuste eraldamise alused ning ühinemise järel riigieelarveliste eraldiste vähenemise kompenseerimise põhimõtted. (2) Haldusterritoriaalse korralduse muutmise ning haldusüksuste piiride ja nimede muutmise",
        "@language": "et"
      },
      "estleg:legalText": "(1) Seadusega kehtestatakse kohaliku omavalitsuse üksuste ühinemise soodustamise põhimõtted ja ühinemise soodustamise tingimused, kohaliku omavalitsuse üksuste pakutavate avalike teenuste ühinemisjärgsele kättesaadavusele esitatavad nõuded, ühinemisega seotud kulude katteks riigieelarvest toetuste eraldamise alused ning ühinemise järel riigieelarveliste eraldiste vähenemise kompenseerimise põhimõtted. (2) Haldusterritoriaalse korralduse muutmise ning haldusüksuste piiride ja nimede muutmise alused ja kord sätestatakse Eesti territooriumi haldusjaotuse seaduses.",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_KOUS_1"
      },
      "estleg:isPartOf": {
