      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Seadustes, välja arvatud välislaenulepingute ja laenudele riigigarantii andmise...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Õigusaktides rahaühikute euroga asendamise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:OREAS_Map"
      },
      "estleg:summary": {
        "@value": "Seadustes, välja arvatud välislaenulepingute ja laenudele riigigarantii andmise ratifitseerimise seadused, loetakse euro kasutusele võtnud Euroopa Liidu liikmesriikide rahaühikud rahaühikuks euro (EUR), arvestades Euroopa Liidu Nõukogu kehtestatud konverteerimiskursse.",
        "@language": "et"
      },
      "estleg:legalText": "Seadustes, välja arvatud välislaenulepingute ja laenudele riigigarantii andmise ratifitseerimise seadused, loetakse euro kasutusele võtnud Euroopa Liidu liikmesriikide rahaühikud rahaühikuks euro (EUR), arvestades Euroopa Liidu Nõukogu kehtestatud konverteerimiskursse.",
