    {
      "@id": "estleg:AOS_Osa7_Par_256",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 256.",
      "rdfs:label": "§ 256. Ostueesõiguse mõiste",
      "estleg:sourceAct": "Asjaõigusseadus",
      "estleg:partOfAct": {
        "@id": "estleg:AOS_Osa7"
      },
      "estleg:summary": "(1) Kinnisasja võib koormata asjaõigusliku ostueesõigusega. (2) Ostueesõiguse võib seada teatud isiku või teise kinnisasja igakordse omaniku kasuks. (3) Kinnisasja mõttelist osa võib ostueesõigusega koormata ainult siis, kui see on kaasomaniku osa.",
      "estleg:legalText": "(1) Kinnisasja võib koormata asjaõigusliku ostueesõigusega. (2) Ostueesõiguse võib seada teatud isiku või teise kinnisasja igakordse omaniku kasuks. (3) Kinnisasja mõttelist osa võib ostueesõigusega koormata ainult siis, kui see on kaasomaniku osa.",
