    {
      "@id": "estleg:VOS_Osa12_Par_396",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Section"
      ],
      "owl:sameAs": {
        "@id": "estleg:volaoigusseadus_Osa3_Par_396"
      },
      "estleg:sectionNumber": "396",
      "rdfs:label": "§ 396. Laenulepingu mõiste",
      "estleg:inPart": {
        "@id": "estleg:VOS_Part12"
      },
      "estleg:coversConcept": [
        {
          "@id": "estleg:LoanAgreement"
        }
      ],
      "estleg:summary": "Määratleb laenulepingu: laenuandja annab rahasumma või asendatava asja, laenusaaja kohustub tagastama sama rahasumma või sama liiki ja kvaliteediga asja. Sätet kohaldatakse ka liigitunnustega esemetele (nt väärtpaberid), kui pooled ei lepi teisiti.",
      "estleg:semanticallySimilarTo": [
        {
          "@id": "estleg:volaoigusseadus_Osa3_Par_396"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:VOS_Osa12_Par_397",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Section"
      ],
      "owl:sameAs": {
        "@id": "estleg:volaoigusseadus_Osa3_Par_397"
      },
      "estleg:sectionNumber": "397",
      "rdfs:label": "§ 397. Laenuintress",
      "estleg:inPart": {
        "@id": "estleg:VOS_Part12"
      },
      "estleg:coversConcept": [
        {
          "@id": "estleg:LoanInterest"
        },
        {
          "@id": "estleg:LoanRepayment"
        }
      ],
      "estleg:summary": "Majandus- või kutsetegevuses antud laen on intressikohustuslik; muul juhul üksnes kokkuleppel. Kui intressimäär puudub, eeldatakse harilikku määra, selle puudumisel VÕS § 94 määra. Intress tasutakse kalendriaasta lõpus või laenu tagasimaksmisel, kui tagasimakse toimub varem.",
      "estleg:references": [
        {
          "@id": "estleg:volaoigusseadus_Osa1_Par_94"
        }
      ]
    },
    {
      "@id": "estleg:VOS_Osa12_Par_398",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Section"
      ],
      "owl:sameAs": {
        "@id": "estleg:volaoigusseadus_Osa3_Par_398"
      },
      "estleg:sectionNumber": "398",
      "rdfs:label": "§ 398. Tähtajatu laenulepingu korraline ülesütlemine",
      "estleg:inPart": {
        "@id": "estleg:VOS_Part12"
      },
      "estleg:coversConcept": [
        {
          "@id": "estleg:LoanRepayment"
        }
      ],
      "estleg:summary": "Kui tagastamise tähtaega pole kokku lepitud, saab laenuandja nõuda tagastamist pärast ülesütlemist. Tähtajatu laenulepingu võivad üles öelda nii laenuandja kui laenusaaja, etteteatamisega vähemalt kaks kuud; intressita laenu võib laenusaaja tagastada ette teatamata.",
      "estleg:semanticallySimilarTo": [
        {
          "@id": "estleg:volaoigusseadus_Osa3_Par_398"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:VOS_Osa12_Par_399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Section"
      ],
      "owl:sameAs": {
        "@id": "estleg:volaoigusseadus_Osa3_Par_399"
      },
      "estleg:sectionNumber": "399",
      "rdfs:label": "§ 399. Laenulepingu erakorraline ülesütlemine laenuandja poolt",
      "estleg:inPart": {
        "@id": "estleg:VOS_Part12"
      },
      "estleg:coversConcept": [
        {
          "@id": "estleg:LoanRepayment"
        }
      ],
      "estleg:summary": "Laenuandja võib lepingu erakorraliselt üles öelda ja nõuda kohest tagastamist, kui laenusaaja rikub osamakseid, intressi maksmist või sihtotstarbelise kasutuse kohustust. Samuti võib laenuandja enne üleandmist lepingust taganeda/keelduda üleandmisest laenusaaja maksevõime olulise halvenemise või pettuslike andmete korral.",
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:VOS_Osa12_Par_400",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Section"
      ],
      "owl:sameAs": {
        "@id": "estleg:volaoigusseadus_Osa3_Par_400"
      },
      "estleg:sectionNumber": "400",
      "rdfs:label": "§ 400. Muutuva intressimääraga laenulepingu erakorraline ülesütlemine laenusaaja poolt",
      "estleg:inPart": {
        "@id": "estleg:VOS_Part12"
      },
      "estleg:coversConcept": [
        {
          "@id": "estleg:LoanInterest"
        },
        {
          "@id": "estleg:LoanRepayment"
        }
      ],
      "estleg:summary": "Muutuva intressimääraga laenu võib laenusaaja igal ajal üles öelda, teatades ette vähemalt kolm kuud. Ülesütlemine eeldab laenu tagastamist kahe nädala jooksul pärast ülesütlemise jõustumist; vastupidine kokkulepe, mis piirab laenusaaja õigust, on tühine.",
      "estleg:semanticallySimilarTo": [
        {
          "@id": "estleg:volaoigusseadus_Osa3_Par_400"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      }
    }
