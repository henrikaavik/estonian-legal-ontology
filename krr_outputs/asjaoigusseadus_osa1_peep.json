    {
      "@id": "estleg:AOS_Osa1_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Asjaõigused",
        "@language": "et"
      },
      "estleg:sourceAct": "Asjaõigusseadus",
      "estleg:partOfAct": {
        "@id": "estleg:AOS_Map"
      },
      "estleg:summary": {
        "@value": "(1) Asjaõigused on omand (omandiõigus) ja piiratud asjaõigused: servituudid, reaalkoormatised, hoonestusõigus, ostueesõigus ja pandiõigus. (2) Seaduses võib lisaks käesoleva paragrahvi 1. lõikes nimetatule sätestada ka muid asjaõigusi.",
        "@language": "et"
      },
      "estleg:legalText": "(1) Asjaõigused on omand (omandiõigus) ja piiratud asjaõigused: servituudid, reaalkoormatised, hoonestusõigus, ostueesõigus ja pandiõigus. (2) Seaduses võib lisaks käesoleva paragrahvi 1. lõikes nimetatule sätestada ka muid asjaõigusi.",
