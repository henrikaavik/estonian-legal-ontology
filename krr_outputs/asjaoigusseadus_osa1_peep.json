      "estleg:sourceAct": "Asjaõigusseadus",
      "estleg:partOfAct": {
        "@id": "estleg:AOS_Map"
      },
      "estleg:summary": {
        "@value": "(2) Kõigil omanikel on võrdsed õigused, kui seaduses ei ole sätestatud teisiti. Juriidilise isiku vara ega juriidiline isik ei saa kuuluda teistele isikutele.",
        "@language": "et"
      },
