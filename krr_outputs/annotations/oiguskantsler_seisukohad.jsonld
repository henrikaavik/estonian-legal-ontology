      "rdfs:label": {
        "@value": "Õiguskantsleri seisukohad — praktiku annotatsioonid (6 annotatsiooni)",
        "@language": "et"
      },
      "dc:source": "Õiguskantsler"
    },
    {
      "@id": "estleg:Annotation_OK_karistusseadustiku3811pohiseadusparasus",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Annotation"
      ],
      "estleg:annotates": {
        "@id": "estleg:KARIST_2_Osa1_1_87"
      },
      "estleg:annotationText": "Karistusseadustiku § 381¹ põhiseaduspärasus\n\nÕiguskantsler hindas karistusseadustiku raamatupidamiskohustuse rikkumise koosseisu (§ 381¹) põhiseaduspärasust ning leidis, et säte ei ole vastuolus põhiseadusega: kuriteokoosseisu määratlemine on piisavalt selge ja karistus proportsionaalne, kui kohus arvestab konkreetse rikkumise raskust ja tahtluse vormi. Tõlgendamisel tuleb lähtuda õigusselguse põhimõttest ja koosseisu ahtast (mitte laiendavast) tõlgendusest.",
      "estleg:annotationType": "interpretation",
      "estleg:annotationSource": "Õiguskantsler",
      "rdfs:label": {
        "@value": "Õiguskantsleri seisukoht: Karistusseadustiku § 381¹ põhiseaduspärasus",
        "@language": "et"
      },
      "estleg:annotationSourceUrl": {
        "@value": "https://www.oiguskantsler.ee/seisukohad-ja-algatused/seisukohad/karistusseadustiku-381-1-pohiseadusparasus",
        "@type": "xsd:anyURI"
      },
      "estleg:annotationDate": {
        "@value": "2026-05-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Annotation_OK_looduskaitseseaduse9115vastavuspohiseadusele",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Annotation"
      ],
      "estleg:annotates": {
        "@id": "estleg:LKS_Map_2026"
      },
      "estleg:annotationText": "Looduskaitseseaduse § 91 lõike 15 vastavus põhiseadusele\n\nÕiguskantsler analüüsis looduskaitseseaduse § 91 lõiget 15, mis reguleerib varem kehtinud kaitsekorra üleminekut, ega tuvastanud vastuolu põhiseadusega. Omandipõhiõiguse riive on lubatav, kui kitsendused tulenevad seadusest, on proportsionaalsed looduskaitse eesmärgiga ja maaomanikule on tagatud õigus saada talumiskohustuse eest hüvitist; sätet tuleb tõlgendada koostoimes hüvitamisnorme reguleerivate sätetega.",
      "estleg:annotationType": "interpretation",
      "estleg:annotationSource": "Õiguskantsler",
      "rdfs:label": {
        "@value": "Õiguskantsleri seisukoht: Looduskaitseseaduse § 91 lõike 15 vastavus põhiseadusele",
        "@language": "et"
      },
      "estleg:annotationSourceUrl": {
        "@value": "https://www.oiguskantsler.ee/seisukohad-ja-algatused/seisukohad/looduskaitseseaduse-91-loike-15-vastavus-pohiseadusele",
        "@type": "xsd:anyURI"
      },
      "estleg:annotationDate": {
        "@value": "2025-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Annotation_OK_kasutusloaandmineenneehitusseadusejoustumist",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Annotation"
      ],
      "estleg:annotates": {
        "@id": "estleg:EHS_Map_2026"
      },
      "estleg:annotationText": "Enne ehitusseaduse jõustumist antud ehitusloa alusel ehitatud hoone kasutusluba\n\nÕiguskantsler selgitas, et enne ehitusseadustiku jõustumist välja antud ehitusloa alusel valminud hoonele kasutusloa andmisel ei saa kohalik omavalitsus nõuda tagasiulatuvalt kehtivate ehitusnõuete täitmist, mida ehitusloa andmise ajal ei kehtinud. Kasutusloa menetluses tuleb hinnata hoone ohutust ja vastavust ehitamise ajal kehtinud nõuetele; hilisemate nõuete kohaldamine on lubatud üksnes seaduses sätestatud ulatuses ja peab arvestama õiguspärase ootuse põhimõtet.",
      "estleg:annotationType": "interpretation",
      "estleg:annotationSource": "Õiguskantsler",
      "rdfs:label": {
        "@value": "Õiguskantsleri seisukoht: Enne ehitusseaduse jõustumist antud ehitusloa alusel ehitatud hoone kasutusluba",
        "@language": "et"
      },
      "estleg:annotationSourceUrl": {
        "@value": "https://www.oiguskantsler.ee/seisukohad-ja-algatused/seisukohad/enne-ehitusseaduse-joustumist-antud-ehitusloa-alusel-ehitatud-hoone-kasutusluba",
        "@type": "xsd:anyURI"
      },
      "estleg:annotationDate": {
        "@value": "2025-07-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Annotation_OK_ettepanekkliimaministrimaarusemaapoueseadusegakooskolla",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Annotation"
      ],
      "estleg:annotates": {
        "@id": "estleg:MAAPOUE_Map_2026"
      },
      "estleg:annotationText": "Ettepanek viia kliimaministri määrus põhiseaduse ja maapõueseadusega kooskõlla\n\nÕiguskantsler tegi ettepaneku viia kliimaministri määrus kooskõlla maapõueseadusega: ministri määrusega ei tohi laiendada loakohustust ega kehtestada kaevandamisõiguse tasu ulatust kaugemale, kui seadus volitusnormiga lubab. Määruse andja peab püsima volitusnormi piirides ning maapõue kasutamise tingimuste sisuline reguleerimine, mis riivab ettevõtlusvabadust või omandit, kuulub seadusandja pädevusse.",
      "estleg:annotationType": "interpretation",
      "estleg:annotationSource": "Õiguskantsler",
      "rdfs:label": {
        "@value": "Õiguskantsleri seisukoht: Ettepanek viia kliimaministri määrus põhiseaduse ja maapõueseadusega kooskõlla",
        "@language": "et"
      },
      "estleg:annotationSourceUrl": {
        "@value": "https://www.oiguskantsler.ee/seisukohad-ja-algatused/seisukohad/ettepanek-viia-kliimaministri-maarus-pohiseaduse-ja-maapoueseadusega-kooskolla",
        "@type": "xsd:anyURI"
      },
      "estleg:annotationDate": {
        "@value": "2026-01-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Annotation_OK_kovsotsiaalvaldkonnaulesannetetaitmine_KOKS",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Annotation"
      ],
      "estleg:annotates": {
        "@id": "estleg:KOKS_Map_2026"
      },
      "estleg:annotationText": "Kohaliku omavalitsuse sotsiaalvaldkonna ülesannete täitmine\n\nÕiguskantsler rõhutas, et sotsiaalhoolekande seadusest tulenevad ülesanded on kohaliku omavalitsuse kohustuslikud (mitte vabatahtlikud) ülesanded ning vald või linn ei saa nende täitmisest keelduda eelarvevahendite väidetava nappuse tõttu. Abivajaja õigus saada toimetulekuks vajalikku abi on subjektiivne õigus; KOKS § 6 ja sotsiaalhoolekande seaduse koostoimes peab omavalitsus tagama teenuste tegeliku kättesaadavuse ja korraldama rahastuse selle järgi, mitte vastupidi.",
      "estleg:annotationType": "interpretation",
      "estleg:annotationSource": "Õiguskantsler",
      "rdfs:label": {
        "@value": "Õiguskantsleri seisukoht: Kohaliku omavalitsuse sotsiaalvaldkonna ülesannete täitmine",
        "@language": "et"
      },
      "estleg:annotationSourceUrl": {
        "@value": "https://www.oiguskantsler.ee/seisukohad-ja-algatused/seisukohad/kohaliku-omavalitsuse-sotsiaalvaldkonna-ulesannete-taitmine",
        "@type": "xsd:anyURI"
      },
      "estleg:annotationDate": {
        "@value": "2026-01-27",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Annotation_OK_kovsotsiaalvaldkonnaulesannetetaitmine_SHS",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Annotation"
      ],
      "estleg:annotates": {
        "@id": "estleg:SOTSIA_Map_2026"
      },
      "estleg:annotationText": "Kohaliku omavalitsuse sotsiaalvaldkonna ülesannete täitmine\n\nÕiguskantsler rõhutas, et sotsiaalhoolekande seadusest tulenevad ülesanded on kohaliku omavalitsuse kohustuslikud (mitte vabatahtlikud) ülesanded ning vald või linn ei saa nende täitmisest keelduda eelarvevahendite väidetava nappuse tõttu. Abivajaja õigus saada toimetulekuks vajalikku abi on subjektiivne õigus; KOKS § 6 ja sotsiaalhoolekande seaduse koostoimes peab omavalitsus tagama teenuste tegeliku kättesaadavuse ja korraldama rahastuse selle järgi, mitte vastupidi.",
      "estleg:annotationType": "interpretation",
      "estleg:annotationSource": "Õiguskantsler",
      "rdfs:label": {
        "@value": "Õiguskantsleri seisukoht: Kohaliku omavalitsuse sotsiaalvaldkonna ülesannete täitmine",
        "@language": "et"
      },
      "estleg:annotationSourceUrl": {
        "@value": "https://www.oiguskantsler.ee/seisukohad-ja-algatused/seisukohad/kohaliku-omavalitsuse-sotsiaalvaldkonna-ulesannete-taitmine",
        "@type": "xsd:anyURI"
      },
      "estleg:annotationDate": {
        "@value": "2026-01-27",
        "@type": "xsd:date"
      }
    }
  ]
