      }
    },
    {
      "@id": "estleg:Reg_1035221_Par_13_v1035221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035221_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on kaitsta Kirikumäe järve ja seda ümbritsevaid kultuur- ja loodusmaastikke, metsade bioloogilist mitmekesisust, ohustatud, haruldasi ja kaitsealuseid liike ning elupaigatüüpe liigirikkad madalsood, liiva-alade vähetoitelised järved ning huumustoitelised järved ja järvikud. Piiranguvööndi kaitse-eesmärk on kaitsta Kirikumäe järve ja seda ümbritsevaid kultuur- ja loodusmaastikke, metsade bioloogilist mitmekesisust, ohustatud, haruldasi ja kaitsealuseid liike ning elupaigatüüpe liigirikkad madalsood, liiva-alade vähetoitelised järved ning huumustoitelised järved ja järvikud.",
      "rdfs:label": {
        "@value": "Reg_1035221_Par_13 (redaktsioon 1035221)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035221",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035221",
      "estleg:sourceAct": "Kirikumäe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035221 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035221_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035221_Par_14_v1035221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035221_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) biotsiidi, taimekaitsevahendi ja väetise kasutamine õuemaal, haritaval maal ja looduslikul rohumaal, mis pole poollooduslik kooslus, ning võõrliigi tõrjeks väljaspool veekaitsevööndit ja veekogu; 3 3) karjaaia rajamine ja õuealale ehitusteatise kohustusega ehitise või sellise ehitise püstitamine, mis ei nõua ehitusluba või ehitusteatise esitamist; 4 4) kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas. Piiranguvööndis on lubatud: majandustegevus; biotsiidi, taimekaitsevahendi ja väetise kasutamine õuemaal, haritaval maal ja looduslikul rohumaal, mis pole poollooduslik kooslus, ning võõrliigi tõrjeks väljaspool veekaitsevööndit ja veekogu; karjaaia rajamine ja õuealale ehitusteatise kohustusega ehitise või sellise ehitise püstitamine, mis ei nõua ehitusluba või ehitusteatise esitamist; kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) uute ehitiste püstitamine lõike 1 punktis 3 nimetamata juhtudel; 2 2) veekogude veetaseme ja kaldajoone muutmine; 3 3) rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas; 4 4) lageraie kuni 1 ha suuruse langina; 5 5) turberaie kuni 5 ha suuruse langina. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: uute ehitiste püstitamine lõike 1 punktis 3 nimetamata juhtudel; veekogude veetaseme ja kaldajoone muutmine; rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas; lageraie kuni 1 ha suuruse langina; turberaie kuni 5 ha suuruse langina. 3 (3) Raie tegemisel tuleb elustiku mitmekesisuse tagamiseks säilitada kasvavaid puid ja nende säilinud osi tüvepuidu kogumahuga vähemalt 20 tihumeetrit hektari kohta, välja arvatud hall-lepikutes. Elustiku mitmekesisuse tagamiseks alles jäetavad puud valitakse eri puuliikide esimese rinde suurima diameetriga puude hulgast, eelistades kõvalehtpuid, mände ja haabasid, samuti eritunnustega, nagu põlemisjälgede, õõnsuste, tuuleluudade või suurte okstega puid. Raie tegemisel tuleb elustiku mitmekesisuse tagamiseks säilitada kasvavaid puid ja nende säilinud osi tüvepuidu kogumahuga vähemalt 20 tihumeetrit hektari kohta, välja arvatud hall-lepikutes. Elustiku mitmekesisuse tagamiseks alles jäetavad puud valitakse eri puuliikide esimese rinde suurima diameetriga puude hulgast, eelistades kõvalehtpuid, mände ja haabasid, samuti eritunnustega, nagu põlemisjälgede, õõnsuste, tuuleluudade või suurte okstega puid.",
      "rdfs:label": {
        "@value": "Reg_1035221_Par_14 (redaktsioon 1035221)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035221",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035221",
      "estleg:sourceAct": "Kirikumäe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035221 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035221_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035221_Par_15_v1035221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035221_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavara kaevandamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) roo varumine külmumata pinnaselt. Piiranguvööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: uue maaparandussüsteemi rajamine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; roo varumine külmumata pinnaselt. 2 (2) Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab. Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab.",
      "rdfs:label": {
        "@value": "Reg_1035221_Par_15 (redaktsioon 1035221)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035221",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035221",
      "estleg:sourceAct": "Kirikumäe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035221 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035221_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035221_Par_16_v1035221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035221_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on vaadete avamiseks ning poollooduslike koosluste ja rohumaade esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Piiranguvööndis on vaadete avamiseks ning poollooduslike koosluste ja rohumaade esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_1035221_Par_16 (redaktsioon 1035221)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035221",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035221",
      "estleg:sourceAct": "Kirikumäe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035221 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035221_Map_2026"
      }
    },
