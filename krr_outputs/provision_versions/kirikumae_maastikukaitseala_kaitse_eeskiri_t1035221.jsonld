    },
    {
      "@id": "estleg:Reg_1035221_Par_12_v1035221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035221_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Kirikumäe piiranguvöönd. Kaitsealal on Kirikumäe piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1035221_Par_12 (redaktsioon 1035221)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035221",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035221",
      "estleg:sourceAct": "Kirikumäe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035221 § 12",
      "estleg:partOfAct": {
