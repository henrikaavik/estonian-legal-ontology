      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Keskkonnasõbraliku köögivilja-, ravimtaime- ja maitsetaimekasvatuse ning maasikakasvatuse toetus (19 versiooni)",
        "@language": "et"
      },
      "dc:source": "Keskkonnasõbraliku köögivilja-, ravimtaime- ja maitsetaimekasvatuse ning maasikakasvatuse toetus"
    },
    {
      "@id": "estleg:Reg_1029406_Par_1_v1029406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029406_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” (edaspidi arengukava) meetme 10 „Põllumajanduse keskkonna- ja kliimameede” tegevuse liigi „Keskkonnasõbraliku aianduse toetus” raames antava keskkonnasõbraliku köögivilja-, ravimtaime- ja maitsetaimekasvatuse ning maasikakasvatuse toetuse (edaspidi toetus) andmise tingimused ning kord. Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” (edaspidi arengukava) meetme 10 „Põllumajanduse keskkonna- ja kliimameede” tegevuse liigi „Keskkonnasõbraliku aianduse toetus” raames antava keskkonnasõbraliku köögivilja-, ravimtaime- ja maitsetaimekasvatuse ning maasikakasvatuse toetuse (edaspidi toetus) andmise tingimused ning kord.",
      "rdfs:label": {
        "@value": "Reg_1029406_Par_1 (redaktsioon 1029406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029406",
      "estleg:sourceAct": "Keskkonnasõbraliku köögivilja-, ravimtaime- ja maitsetaimekasvatuse ning maasikakasvatuse toetus",
      "estleg:provisionRef": "Reg_1029406 § 1",
      "estleg:partOfAct": {
