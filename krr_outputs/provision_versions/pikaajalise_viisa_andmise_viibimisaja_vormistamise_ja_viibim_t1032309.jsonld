      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032309_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet, Kaitsepolitseiamet või Välisministeerium tühistab viisa või tunnistab selle kehtetuks viivitamata viisa tühistamise või kehtetuks tunnistamise aluseks olevate asjaolude ilmnemisel. Politsei- ja Piirivalveamet, Kaitsepolitseiamet või Välisministeerium tühistab viisa või tunnistab selle kehtetuks viivitamata viisa tühistamise või kehtetuks tunnistamise aluseks olevate asjaolude ilmnemisel.",
      "rdfs:label": {
        "@value": "Reg_1032309_Par_14 (redaktsioon 1032309)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032309",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032309",
      "estleg:sourceAct": "Pikaajalise viisa andmise, viibimisaja vormistamise ja viibimisaja pikendamise kord ja tähtajad ning piisavate rahaliste vahendite määr",
      "estleg:provisionRef": "Reg_1032309 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032309_Map"
      }
