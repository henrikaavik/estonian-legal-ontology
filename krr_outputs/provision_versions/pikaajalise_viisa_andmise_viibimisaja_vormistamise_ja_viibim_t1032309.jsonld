      },
      "estleg:versionText": "Määrus jõustub 1. jaanuaril 2016. aastal. Määrus jõustub 1. jaanuaril 2016. aastal.",
      "rdfs:label": {
        "@value": "Reg_1032309_Par_18 (redaktsioon 1032309)",
