      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Pikaajalise viisa andmise, viibimisaja vormistamise ja viibimisaja pikendamise kord ja tähtajad ning piisavate rahaliste vahendite määr (26 versiooni)",
        "@language": "et"
