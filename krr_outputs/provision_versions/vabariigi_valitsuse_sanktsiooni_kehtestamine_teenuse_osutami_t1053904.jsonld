      "estleg:versionValidFrom": {
        "@value": "2022-04-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse rahvusvahelise sanktsiooni seaduse § 3 lõikes 1 ja §-s 4 nimetatud eesmärkide toetamiseks Vabariigi Valitsuse sanktsioonina piirang teenuse osutamiseks ja teenuse osutamise võimaldamiseks Eestis. Määrusega kehtestatakse rahvusvahelise sanktsiooni seaduse § 3 lõikes 1 ja §-s 4 nimetatud eesmärkide toetamiseks Vabariigi Valitsuse sanktsioonina piirang teenuse osutamiseks ja teenuse osutamise võimaldamiseks Eestis.",
      "rdfs:label": {
