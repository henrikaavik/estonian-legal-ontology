        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotlejal on õigus vaidlustada vastavuseksami tulemus ülikooli kehtestatud tingimustel ja korras. Taotlejal on õigus vaidlustada vastavuseksami tulemus ülikooli kehtestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "Reg_1047605_Par_8 (redaktsioon 1047605)",
