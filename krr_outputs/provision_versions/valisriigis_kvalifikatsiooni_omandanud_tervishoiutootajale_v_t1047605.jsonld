    {
      "@id": "estleg:Reg_1047605_Par_11_v1047605",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047605_Par_11"
