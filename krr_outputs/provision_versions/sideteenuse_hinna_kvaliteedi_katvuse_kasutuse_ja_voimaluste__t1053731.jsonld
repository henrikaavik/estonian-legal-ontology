      }
    },
    {
      "@id": "estleg:Reg_1053731_Par_15_v1053731",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053731_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu funktsionaalsus, mis võimaldab võrrelda internetiühenduse teenuse ja numbripõhise isikutevahelise side teenuse hindu ja kvaliteeti tehakse kättesaadavaks hiljemalt 30. juunil 2023. a. Andmekogu funktsionaalsus, mis võimaldab võrrelda internetiühenduse teenuse ja numbripõhise isikutevahelise side teenuse hindu ja kvaliteeti tehakse kättesaadavaks hiljemalt 30. juunil 2023. a.",
      "rdfs:label": {
        "@value": "Reg_1053731_Par_15 (redaktsioon 1053731)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053731",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053731",
      "estleg:sourceAct": "Sideteenuse hinna, kvaliteedi, katvuse, kasutuse ja võimaluste kaardistuse infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_1053731 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053731_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053731_Par_2_v1053731",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053731_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu pidamise eesmärk on võrrelda üldkasutatava elektroonilise side teenuse (edaspidi sideteenus) hindu ja kvaliteeti ning kaardistada Eesti territooriumi aadressiobjektidel pakutavate interneriühenduse teenuste võimalused ja tehnilised parameetrid ning tuvastada geograafilised alad või aadressiobjektid, millel puudub internetiühenduse teenus. Andmekogu pidamise eesmärk on võrrelda üldkasutatava elektroonilise side teenuse (edaspidi sideteenus) hindu ja kvaliteeti ning kaardistada Eesti territooriumi aadressiobjektidel pakutavate interneriühenduse teenuste võimalused ja tehnilised parameetrid ning tuvastada geograafilised alad või aadressiobjektid, millel puudub internetiühenduse teenus. 2 (2) Andmekogu põhilised ülesanded on: 1 1) sideteenuste võimaluste kaardi koostamine ja visualiseerimine kaardil; 2 2) turutõrke hindamiseks vajalike väljundite, sealhulgas ruutkaart ja statistika, koostamine ja visualiseerimine kaardil; 3 3) internetiühenduse teenuste kohta statistika koostamine; 4 4) statistiliste andmete arhiveerimine, esitamine ja printimise võimaldamine vastavalt esitatud päringutingimustele; 5 5) asjast huvitatud isikule sideteenuste võimaluse ja turutõrgete kohta info jagamine ning hinna ja kvaliteedi võrdlemise võimaldamine. Andmekogu põhilised ülesanded on: sideteenuste võimaluste kaardi koostamine ja visualiseerimine kaardil; turutõrke hindamiseks vajalike väljundite, sealhulgas ruutkaart ja statistika, koostamine ja visualiseerimine kaardil; internetiühenduse teenuste kohta statistika koostamine; statistiliste andmete arhiveerimine, esitamine ja printimise võimaldamine vastavalt esitatud päringutingimustele; asjast huvitatud isikule sideteenuste võimaluse ja turutõrgete kohta info jagamine ning hinna ja kvaliteedi võrdlemise võimaldamine.",
      "rdfs:label": {
        "@value": "Reg_1053731_Par_2 (redaktsioon 1053731)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053731",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053731",
      "estleg:sourceAct": "Sideteenuse hinna, kvaliteedi, katvuse, kasutuse ja võimaluste kaardistuse infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_1053731 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053731_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053731_Par_3_v1053731",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053731_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu vastutav töötleja on Tarbijakaitse ja Tehnilise Järelevalve Amet. Andmekogu vastutav töötleja on Tarbijakaitse ja Tehnilise Järelevalve Amet. 2 (2) Andmekogu vastutav töötleja tagab: 1 1) andmekogu pidamise vastavalt õigusaktides sätestatud nõuetele; 2 2) andmekogu toimimise ja andmete esitamise võimaluse; 3 3) andmekogu toimingute õiguspärasuse; 4 4) andmekogust andmete väljastamise nõuetekohasuse; 5 5) andmekogu kasutajatoe olemasolu; 6 6) õigustatud isikutele juurdepääsu andmekogule ning selles sisaldavatele andmetele; 7 7) koostöös elektroonilise side ettevõtjatega (edaspidi sideettevõtja) andmekogus korrastatud ja õige andmete esituse ning töötluse; 8 8) andmekogule esitatud andmete kasutamise ainult § 2 sätestatud eesmärgi täitmiseks. Andmekogu vastutav töötleja tagab: andmekogu pidamise vastavalt õigusaktides sätestatud nõuetele; andmekogu toimimise ja andmete esitamise võimaluse; andmekogu toimingute õiguspärasuse; andmekogust andmete väljastamise nõuetekohasuse; andmekogu kasutajatoe olemasolu; õigustatud isikutele juurdepääsu andmekogule ning selles sisaldavatele andmetele; koostöös elektroonilise side ettevõtjatega (edaspidi sideettevõtja) andmekogus korrastatud ja õige andmete esituse ning töötluse; andmekogule esitatud andmete kasutamise ainult § 2 sätestatud eesmärgi täitmiseks.",
      "rdfs:label": {
        "@value": "Reg_1053731_Par_3 (redaktsioon 1053731)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053731",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053731",
      "estleg:sourceAct": "Sideteenuse hinna, kvaliteedi, katvuse, kasutuse ja võimaluste kaardistuse infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_1053731 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053731_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053731_Par_4_v1053731",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053731_Par_4"
