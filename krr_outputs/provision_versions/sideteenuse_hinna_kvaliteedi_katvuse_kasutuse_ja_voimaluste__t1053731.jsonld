      "estleg:sourceAct": "Sideteenuse hinna, kvaliteedi, katvuse, kasutuse ja võimaluste kaardistuse infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_1053731 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053731_Map"
      }
    },
