    {
      "@id": "estleg:Reg_1053731_Par_14_v1053731",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053731_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu pidamise lõpetamine otsustatakse seadusega. Andmekogu pidamise lõpetamine otsustatakse seadusega. 2 (2) Andmekogu laiendamine, ühendamine ja lõpetamine ning andmete üleandmine teise andmekogusse, avalikku või riigiasutuse arhiivi või nende hävitamine toimub kooskõlas avaliku teabe seaduses ja arhiiviseaduses sätestatud nõuetega. Andmekogu laiendamine, ühendamine ja lõpetamine ning andmete üleandmine teise andmekogusse, avalikku või riigiasutuse arhiivi või nende hävitamine toimub kooskõlas avaliku teabe seaduses ja arhiiviseaduses sätestatud nõuetega.",
      "rdfs:label": {
        "@value": "Reg_1053731_Par_14 (redaktsioon 1053731)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053731",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053731",
      "estleg:sourceAct": "Sideteenuse hinna, kvaliteedi, katvuse, kasutuse ja võimaluste kaardistuse infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_1053731 § 14",
