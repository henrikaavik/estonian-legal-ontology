      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Euroopa Ühenduse asutamislepingu artikli 61 punkti c alusel vastuvõetud määruste rakendamine (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Euroopa Ühenduse asutamislepingu artikli 61 punkti c alusel vastuvõetud määruste rakendamine"
    },
    {
      "@id": "estleg:Reg_157631_Par_1_v157631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157631_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "EL nõukogu määruse 1348/2000/EÜ: 1 1) artikli 2 lõike 1 alusel määratakse edastavaks asutuseks Justiits- ja Digiministeerium; RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 2 2) artikli 2 lõike 2 alusel määratakse vastuvõtvaks asutuseks Justiits- ja Digiministeerium; RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 3 3) artikli 2 lõike 4 punkti d alusel aktsepteerib Eesti Vabariik nii eesti kui inglise keeles koostatud tüüpvorme; 4 4) artikli 3 alusel määratakse keskasutuseks Justiits- ja Digiministeerium; RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 5 5) artikli 10 lõike 2 teise lause alusel aktsepteerib Eesti Vabariik inglise keeles täidetud vormi; 6 6) artikli 14 lõike 2 alusel aktsepteerib Eesti Vabariik kohtudokumentide kätteandmist posti teel tingimusel, et: – kohtudokument antakse kätte allkirja vastu teatisel, millele märgitakse dokumendi kätteandmise aeg ja – kohtudokument on koostatud eesti keeles või tõlgitud eesti keelde või koostatud edastava liikmesriigi ametlikus keeles, millest adressaat aru saab; 7 7) artikli 15 lõike 2 alusel ei luba Eesti Vabariik oma territooriumil kohtudokumente määruse artikli 15 lõikes 1 sätestatud viisil kätte anda. 8 8) kehtetu - RTL 2005 124 1972 972616 2006-01-01 9 9) kehtetu - RTL 2005 124 1972 972616 2006-01-01 EL nõukogu määruse 1348/2000/EÜ: artikli 2 lõike 1 alusel määratakse edastavaks asutuseks Justiits- ja Digiministeerium; , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes artikli 2 lõike 2 alusel määratakse vastuvõtvaks asutuseks Justiits- ja Digiministeerium; , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes artikli 2 lõike 4 punkti d alusel aktsepteerib Eesti Vabariik nii eesti kui inglise keeles koostatud tüüpvorme; artikli 3 alusel määratakse keskasutuseks Justiits- ja Digiministeerium; , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes artikli 10 lõike 2 teise lause alusel aktsepteerib Eesti Vabariik inglise keeles täidetud vormi; artikli 14 lõike 2 alusel aktsepteerib Eesti Vabariik kohtudokumentide kätteandmist posti teel tingimusel, et: – kohtudokument antakse kätte allkirja vastu teatisel, millele märgitakse dokumendi kätteandmise aeg ja – kohtudokument on koostatud eesti keeles või tõlgitud eesti keelde või koostatud edastava liikmesriigi ametlikus keeles, millest adressaat aru saab; artikli 15 lõike 2 alusel ei luba Eesti Vabariik oma territooriumil kohtudokumente määruse artikli 15 lõikes 1 sätestatud viisil kätte anda. kehtetu - kehtetu -",
      "rdfs:label": {
        "@value": "Reg_157631_Par_1 (redaktsioon 157631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157631",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157631",
      "estleg:sourceAct": "Euroopa Ühenduse asutamislepingu artikli 61 punkti c alusel vastuvõetud määruste rakendamine",
      "estleg:provisionRef": "Reg_157631 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157631_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157631_Par_2_v157631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157631_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "EL nõukogu määruse 1206/2001/EÜ: 1 1) artikli 2 lõike 2 kohaselt on tõendite kogumiseks pädevad maakohtud oma tööpiirkonnas; 2 2) artikli 3 lõike 1 alusel määratakse keskasutuseks Justiits- ja Digiministeerium; RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 3 3) artikli 3 lõike 3 alusel määratakse Justiits- ja Digiministeerium asutuseks, kes otsustab määruse artikli 17 alusel esitatud taotluse rahuldamise või rahuldamatajätmise; RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 4 4) artikli 5 alusel määratakse, et Eesti Vabariik võtab vastu ainult eesti keeles koostatud või eesti keelde tõlgitud dokumente; 5 5) artikli 6 alusel määratakse, et Eesti Vabariik võtab vastu posti, elektronposti ja faksi teel edastatud taotlusi. RTL 2005 124 1972 972616 2006-01-01 EL nõukogu määruse 1206/2001/EÜ: artikli 2 lõike 2 kohaselt on tõendite kogumiseks pädevad maakohtud oma tööpiirkonnas; artikli 3 lõike 1 alusel määratakse keskasutuseks Justiits- ja Digiministeerium; , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes artikli 3 lõike 3 alusel määratakse Justiits- ja Digiministeerium asutuseks, kes otsustab määruse artikli 17 alusel esitatud taotluse rahuldamise või rahuldamatajätmise; , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes artikli 5 alusel määratakse, et Eesti Vabariik võtab vastu ainult eesti keeles koostatud või eesti keelde tõlgitud dokumente; artikli 6 alusel määratakse, et Eesti Vabariik võtab vastu posti, elektronposti ja faksi teel edastatud taotlusi.",
      "rdfs:label": {
        "@value": "Reg_157631_Par_2 (redaktsioon 157631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157631",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157631",
      "estleg:sourceAct": "Euroopa Ühenduse asutamislepingu artikli 61 punkti c alusel vastuvõetud määruste rakendamine",
      "estleg:provisionRef": "Reg_157631 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157631_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157631_Par_2_2_v157631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157631_Par_2_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "EL nõukogu määruse 2201/2003/EÜ: 1 1) artikli 21 ja 29 alusel lahendavad tunnustamis- ja täidetavaks tunnistamise avaldusi maakohtud; 2 2) artikli 33 alusel vaatavad täidetavaks tunnistamise otsuse kohta esitatud kaebusi läbi ringkonnakohtud; 3 3) artiklis 34 sätestatud vaidlustamise viisiks on kassatsioonkaebus; 4 4) artikli 45 lõike 2 alusel aktsepteerib Eesti Vabariik tõlget inglise keelde; 5 5) artikli 53 alusel määratakse keskasutuseks Justiits- ja Digiministeerium; RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 6 6) artikli 57 lõike 2 alusel võtab Eesti Vabariik vastu inglise keeles koostatud teateid. RTL 2005 124 1972 972616 2006-01-01 EL nõukogu määruse 2201/2003/EÜ: artikli 21 ja 29 alusel lahendavad tunnustamis- ja täidetavaks tunnistamise avaldusi maakohtud; artikli 33 alusel vaatavad täidetavaks tunnistamise otsuse kohta esitatud kaebusi läbi ringkonnakohtud; artiklis 34 sätestatud vaidlustamise viisiks on kassatsioonkaebus; artikli 45 lõike 2 alusel aktsepteerib Eesti Vabariik tõlget inglise keelde; artikli 53 alusel määratakse keskasutuseks Justiits- ja Digiministeerium; , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes artikli 57 lõike 2 alusel võtab Eesti Vabariik vastu inglise keeles koostatud teateid.",
      "rdfs:label": {
        "@value": "Reg_157631_Par_2_2 (redaktsioon 157631)",
        "@language": "et"
      },
