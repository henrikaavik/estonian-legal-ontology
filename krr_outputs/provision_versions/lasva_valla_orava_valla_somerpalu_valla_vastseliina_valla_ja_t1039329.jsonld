    },
    {
      "@id": "estleg:Reg_1039329_Par_3_v1039329",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039329_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatava Võru valla piiriks on senise Lasva valla, Orava valla, Sõmerpalu valla, Vastseliina valla ja Võru valla piir, välja arvatud nende omavahelises osas. Haldusterritoriaalse korralduse muutmise käigus moodustatava Võru valla piiriks on senise Lasva valla, Orava valla, Sõmerpalu valla, Vastseliina valla ja Võru valla piir, välja arvatud nende omavahelises osas. 2 (2) Maa-amet kannab Võru valla piiri riigi maakatastri kaardile. Maa-amet kannab Võru valla piiri riigi maakatastri kaardile.",
      "rdfs:label": {
        "@value": "Reg_1039329_Par_3 (redaktsioon 1039329)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039329",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039329",
      "estleg:sourceAct": "Lasva valla, Orava valla, Sõmerpalu valla, Vastseliina valla ja Võru valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ muutmine",
      "estleg:provisionRef": "Reg_1039329 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039329_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039329_Par_4_v1039329",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039329_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatavale Võru vallale makstakse ühinemistoetust haldusreformi seaduse §-des 20‒23 sätestatud korras. Haldusterritoriaalse korralduse muutmise käigus moodustatavale Võru vallale makstakse ühinemistoetust haldusreformi seaduse §-des 20‒23 sätestatud korras. 2 (2) Ühinemistoetust arvutatakse senise Lasva valla, Sõmerpalu valla ja Võru valla volikogu algatatud haldusterritoriaalse korralduse muutmist taotlenud Lasva valla, Sõmerpalu valla ja Võru valla elanike arvu põhjal rahvastikuregistri andmetel 1. jaanuari 2017. a seisuga. Ühinemistoetust arvutatakse senise Lasva valla, Sõmerpalu valla ja Võru valla volikogu algatatud haldusterritoriaalse korralduse muutmist taotlenud Lasva valla, Sõmerpalu valla ja Võru valla elanike arvu põhjal rahvastikuregistri andmetel 1. jaanuari 2017. a seisuga. 3 (3) Ühinemistoetust arvutatakse senise Orava valla ja Vastseliina valla volikogu algatatud haldusterritoriaalse korralduse muutmist taotlenud Orava valla ja Vastseliina valla elanike arvu põhjal rahvastikuregistri andmetel 1. jaanuari 2017. a seisuga. Ühinemistoetust arvutatakse senise Orava valla ja Vastseliina valla volikogu algatatud haldusterritoriaalse korralduse muutmist taotlenud Orava valla ja Vastseliina valla elanike arvu põhjal rahvastikuregistri andmetel 1. jaanuari 2017. a seisuga. 4 (4) Käesoleva määrusega haldusterritoriaalse korralduse muutmise tulemusena moodustatavale Võru vallale hüvitatakse riigieelarvest Vabariigi Valitsuse algatatud ühinemisega seotud tegelikud tehtud kulud kuludokumentide alusel haldusreformi seaduse § 24 lõike 2 alusel kehtestatud korras. Käesoleva määrusega haldusterritoriaalse korralduse muutmise tulemusena moodustatavale Võru vallale hüvitatakse riigieelarvest Vabariigi Valitsuse algatatud ühinemisega seotud tegelikud tehtud kulud kuludokumentide alusel haldusreformi seaduse § 24 lõike 2 alusel kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1039329_Par_4 (redaktsioon 1039329)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039329",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039329",
      "estleg:sourceAct": "Lasva valla, Orava valla, Sõmerpalu valla, Vastseliina valla ja Võru valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ muutmine",
      "estleg:provisionRef": "Reg_1039329 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039329_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039329_Par_5_v1039329",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039329_Par_5"
