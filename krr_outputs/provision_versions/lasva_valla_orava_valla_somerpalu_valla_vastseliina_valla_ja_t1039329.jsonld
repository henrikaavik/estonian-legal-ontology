      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 3. aprilli 1995. a määrusega nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ kinnitatud „Eesti territooriumi haldusüksuste nimistut“ muudetakse järgmiselt: 1 1) Põlva maakonna valdade loetelust jäetakse välja sõna „Orava,“; 2 2) Võru maakonna valdade loetelust jäetakse välja sõnad „Lasva,“, „Sõmerpalu,“ ja „Vastseliina,“. Vabariigi Valitsuse 3. aprilli 1995. a määrusega nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ kinnitatud „Eesti territooriumi haldusüksuste nimistut“ muudetakse järgmiselt: Põlva maakonna valdade loetelust jäetakse välja sõna „Orava,“; Võru maakonna valdade loetelust jäetakse välja sõnad „Lasva,“, „Sõmerpalu,“ ja „Vastseliina,“.",
      "rdfs:label": {
        "@value": "Reg_1039329_Par_5 (redaktsioon 1039329)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039329",
