    {
      "@id": "estleg:Reg_1026762_Par_18_v1026762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026762_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 13. augusti 2013. a käskkirjaga nr 835 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Kaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 13. augusti 2013. a käskkirjaga nr 835 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1026762_Par_18 (redaktsioon 1026762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026762",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026762",
      "estleg:sourceAct": "Viitna maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1026762 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026762_Map"
      }
    },
    {
      "@id": "estleg:Reg_1026762_Par_19_v1026762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026762_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
