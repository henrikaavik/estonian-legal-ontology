      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kohaliku omavalitsuse üksuste poolt ühiselt maakonna arengu kavandamise ja selle elluviimise ülesande täitmiseks toetuse eraldamise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kohaliku omavalitsuse üksuste poolt ühiselt maakonna arengu kavandamise ja selle elluviimise ülesande täitmiseks toetuse eraldamise kord"
    },
    {
      "@id": "estleg:Reg_1041183_Par_1_v1041183",
      "@type": [
