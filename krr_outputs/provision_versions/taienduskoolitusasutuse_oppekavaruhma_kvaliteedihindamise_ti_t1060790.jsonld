      "estleg:sourceAct": "Täienduskoolitusasutuse õppekavarühma kvaliteedihindamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1060790 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060790_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060790_Par_4_v1060790",
      "@type": [
        "owl:NamedIndividual",
