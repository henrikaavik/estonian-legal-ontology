      }
    },
    {
      "@id": "estleg:Reg_1060790_Par_5_v1060790",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060790_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kvaliteedihindamine koosneb täienduskoolitusasutuse eneseanalüüsist ja hindamiskomisjoni koostatud hindamisaruandest. Kvaliteedihindamine koosneb täienduskoolitusasutuse eneseanalüüsist ja hindamiskomisjoni koostatud hindamisaruandest. 2 (2) HAKA moodustab õppekavarühma kvaliteedihindamiseks vähemalt kaheliikmelise hindamiskomisjoni. Hindamiskomisjoni liige on kompetentne täienduskoolituse ja selle kvaliteedi tagamise ekspert, kes on oma tegevuses sõltumatu. HAKA moodustab õppekavarühma kvaliteedihindamiseks vähemalt kaheliikmelise hindamiskomisjoni. Hindamiskomisjoni liige on kompetentne täienduskoolituse ja selle kvaliteedi tagamise ekspert, kes on oma tegevuses sõltumatu. 3 (3) Hindamiskomisjon hindab õppekavarühma kvaliteeti täiskasvanute koolituse seaduse, selle alusel antud õigusaktide ja hindamisjuhendi alusel ning koostab hindamisaruande. Hindamiskomisjon esitab hindamisaruande hindamisnõukogule. Hindamiskomisjon hindab õppekavarühma kvaliteeti täiskasvanute koolituse seaduse, selle alusel antud õigusaktide ja hindamisjuhendi alusel ning koostab hindamisaruande. Hindamiskomisjon esitab hindamisaruande hindamisnõukogule. 4 (4) Hindamisnõukogul on õigus nõuda täienduskoolitusasutuselt täiendavate dokumentide esitamist. Hindamisnõukogul on õigus nõuda täienduskoolitusasutuselt täiendavate dokumentide esitamist.",
      "rdfs:label": {
        "@value": "Reg_1060790_Par_5 (redaktsioon 1060790)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060790",
