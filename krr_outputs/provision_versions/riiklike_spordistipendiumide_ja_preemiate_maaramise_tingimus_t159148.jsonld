    {
      "@id": "estleg:Reg_159148_Par_8_v159148",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159148_Par_8"
