    {
      "@id": "estleg:Reg_1038118_Par_8_v1038118",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038118_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohalik tegevusgrupp esitab iga aasta 15. märtsiks Regionaal- ja Põllumajandusministeeriumile seireandmed eelmise aruandeaasta kohta. Kohalik tegevusgrupp esitab iga aasta 15. märtsiks Regionaal- ja Põllumajandusministeeriumile seireandmed eelmise aruandeaasta kohta. 2 (2) 2018. aastal toimub kohalike tegevusgruppide strateegiate vahehindamine. 2018. aastal toimub kohalike tegevusgruppide strateegiate vahehindamine.",
      "rdfs:label": {
        "@value": "Reg_1038118_Par_8 (redaktsioon 1038118)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038118",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038118",
      "estleg:sourceAct": "Eesti maaelu arengukava 2014–2020 seire ja hindamise kord",
      "estleg:provisionRef": "Reg_1038118 § 8",
      "estleg:partOfAct": {
