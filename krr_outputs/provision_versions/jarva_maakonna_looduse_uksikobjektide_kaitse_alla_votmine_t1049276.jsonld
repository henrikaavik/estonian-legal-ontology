      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Järva maakonna looduse üksikobjektide kaitse alla võtmine (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Järva maakonna looduse üksikobjektide kaitse alla võtmine"
    },
    {
      "@id": "estleg:Reg_1056294_Par_1_v1056294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056294_Par_1"
