    {
      "@id": "estleg:Reg_1056294_Par_4_v1056294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056294_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitstavate looduse üksikobjektide kaitsekord on kehtestatud keskkonnaministri 1. märtsi 2023. a määrusega nr 10 „Kaitstavate looduse üksikobjektide kaitse-eeskiri”. RT I 2023-03-14 1 114032023001 2023-03-20 Kaitstavate looduse üksikobjektide kaitsekord on kehtestatud keskkonnaministri 1. märtsi 2023. a määrusega nr 10 „Kaitstavate looduse üksikobjektide kaitse-eeskiri”.",
      "rdfs:label": {
        "@value": "Reg_1056294_Par_4 (redaktsioon 1056294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056294",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056294",
      "estleg:sourceAct": "Järva maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1056294 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056294_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056294_Par_5_v1056294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056294_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas2 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti piiranguvööndi piiri kulgemise kohta. Määruse seletuskirjas2 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti piiranguvööndi piiri kulgemise kohta.",
      "rdfs:label": {
        "@value": "Reg_1056294_Par_5 (redaktsioon 1056294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056294",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056294",
      "estleg:sourceAct": "Järva maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1056294 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056294_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056294_Par_6_v1056294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056294_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist. Määrus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist.",
      "rdfs:label": {
        "@value": "Reg_1056294_Par_6 (redaktsioon 1056294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056294",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056294",
      "estleg:sourceAct": "Järva maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1056294 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056294_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056294_Par_7_v1056294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056294_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 29. juuli 2010. a käskkirjaga nr 1067 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 29. juuli 2010. a käskkirjaga nr 1067 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1056294_Par_7 (redaktsioon 1056294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056294",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056294",
      "estleg:sourceAct": "Järva maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1056294 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056294_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056294_Par_8_v1056294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056294_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1056294_Par_8 (redaktsioon 1056294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056294",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056294",
      "estleg:sourceAct": "Järva maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1056294 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056294_Map"
      }
    },
