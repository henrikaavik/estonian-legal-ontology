      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitse alla võtmise eesmärk on tagada Järva maakonnas asuvate esinduslikemate põlispuude ja geoloogiliste üksikobjektide säilimine. Kaitse alla võtmise eesmärk on tagada Järva maakonnas asuvate esinduslikemate põlispuude ja geoloogiliste üksikobjektide säilimine.",
      "rdfs:label": {
        "@value": "Reg_1056294_Par_1 (redaktsioon 1056294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056294",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056294",
      "estleg:sourceAct": "Järva maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1056294 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056294_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056294_Par_2_v1056294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056294_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Järva maakonnas võetakse kaitse alla järgmised looduse üksikobjektid: 1 1) Küti tamm Järva vallas Võrevere külas; 2 2) Kirikoja kadakas Türi vallas Änari külas; 3 3) Puhmu rahn Järva vallas Puhmu külas; 4 4) Roosna Laikivi Järva vallas Roosna külas; 5 5) Kiigumõisa kivi Paide linnas Oeti külas; 6 6) Epu kivi Türi vallas Saueaugu külas; 7 7) Tudavere kivi Türi vallas Saueaugu külas; 8 8) Vassaare põllukivi Türi vallas Äiamaa külas. Järva maakonnas võetakse kaitse alla järgmised looduse üksikobjektid: Küti tamm Järva vallas Võrevere külas; Kirikoja kadakas Türi vallas Änari külas; Puhmu rahn Järva vallas Puhmu külas; Roosna Laikivi Järva vallas Roosna külas; Kiigumõisa kivi Paide linnas Oeti külas; Epu kivi Türi vallas Saueaugu külas; Tudavere kivi Türi vallas Saueaugu külas; Vassaare põllukivi Türi vallas Äiamaa külas. 2 (2) Lõikes 1 nimetatud looduse üksikobjektide piiranguvööndi ulatus on kehtestatud keskkonnaministri 18. novembri 2019. a määrusega nr 62 „Järva maakonna kaitstavad looduse üksikobjektid ja nende piiranguvööndi ulatus”. RT I 2021-09-03 13 103092021013 2021-09-13 Lõikes 1 nimetatud looduse üksikobjektide piiranguvööndi ulatus on kehtestatud keskkonnaministri 18. novembri 2019. a määrusega nr 62 „Järva maakonna kaitstavad looduse üksikobjektid ja nende piiranguvööndi ulatus”.",
      "rdfs:label": {
        "@value": "Reg_1056294_Par_2 (redaktsioon 1056294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056294",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056294",
      "estleg:sourceAct": "Järva maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1056294 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056294_Map"
      }
    },
