      },
      "estleg:versionValidFrom": {
        "@value": "2020-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. oktoobril 2010. a. Määrus jõustub 1. oktoobril 2010. a.",
      "rdfs:label": {
        "@value": "Reg_346400_Par_21 (redaktsioon 346400)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "346400",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/346400",
      "estleg:sourceAct": "Kavandatavast tehnilisest normist, infoühiskonna teenusele kehtestatavast nõudest ja teenuse osutamise nõudest teavitamise kord ning teavitamist koordineeriva asutuse määramine",
      "estleg:provisionRef": "Reg_346400 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_346400_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_346400_Par_3_v346400",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_346400_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teavitamist koordineerivaks asutuseks on Majandus- ja Kommunikatsiooniministeerium. Teavitamist koordineerivaks asutuseks on Majandus- ja Kommunikatsiooniministeerium. 2 (2) Tehnilist normi, teenuse osutamise suhtes teavitamisele kuuluvat nõuet või infoühiskonna teenusele kehtestatavat nõuet sisaldava eelnõu ettevalmistaja käesoleva määruse tähenduses on: RT I 2014-08-12 6 112082014006 2014-08-15 1 1) ministeerium seaduse eelnõu, Vabariigi Valitsuse määruse eelnõu või ministri määruse eelnõu puhul; 2 2) Riigikantselei, kui Vabariigi Valitsuse algatatud õigusakti eelnõu ettevalmistajaks ei ole ministeerium; 3 3) kohaliku omavalitsuse üksuse valitsus kohaliku omavalitsuse üksuse valitsuse ja volikogule esitatava volikogu määruse eelnõu puhul; 4 4) kohaliku omavalitsuse üksuse volikogu kohaliku omavalitsuse üksuse volikogu määruse eelnõu puhul; 5 5) Vabariigi Presidendi Kantselei seadluse eelnõu puhul. Tehnilist normi, teenuse osutamise suhtes teavitamisele kuuluvat nõuet või infoühiskonna teenusele kehtestatavat nõuet sisaldava eelnõu ettevalmistaja käesoleva määruse tähenduses on: ministeerium seaduse eelnõu, Vabariigi Valitsuse määruse eelnõu või ministri määruse eelnõu puhul; Riigikantselei, kui Vabariigi Valitsuse algatatud õigusakti eelnõu ettevalmistajaks ei ole ministeerium; kohaliku omavalitsuse üksuse valitsus kohaliku omavalitsuse üksuse valitsuse ja volikogule esitatava volikogu määruse eelnõu puhul; kohaliku omavalitsuse üksuse volikogu kohaliku omavalitsuse üksuse volikogu määruse eelnõu puhul; Vabariigi Presidendi Kantselei seadluse eelnõu puhul. 3 (3) Lõikes 2 nimetatud asutustel ei ole kohustust algatada teavitamise protseduuri, kui tehnilist normi, teenuse osutamise suhtes teavitamisele kuuluvat nõuet või infoühiskonna teenusele kehtestatavat nõuet sisaldavast eelnõust on juba nõuetekohaselt teavitatud. RT I 2014-08-12 6 112082014006 2014-08-15 Lõikes 2 nimetatud asutustel ei ole kohustust algatada teavitamise protseduuri, kui tehnilist normi, teenuse osutamise suhtes teavitamisele kuuluvat nõuet või infoühiskonna teenusele kehtestatavat nõuet sisaldavast eelnõust on juba nõuetekohaselt teavitatud. 4 (4) Kui eelnõu menetluse käigus muudetakse oluliselt selle sisu, lühendatakse algselt planeeritud rakendamise ajakava, lisatakse tehnilisi norme või muudetakse nõudeid, tuleb lõikes 2 nimetatud asutusel teavitada eelnõust uuesti enne selle õigusaktina vastuvõtmist. Kui eelnõu menetluse käigus muudetakse oluliselt selle sisu, lühendatakse algselt planeeritud rakendamise ajakava, lisatakse tehnilisi norme või muudetakse nõudeid, tuleb lõikes 2 nimetatud asutusel teavitada eelnõust uuesti enne selle õigusaktina vastuvõtmist.",
      "rdfs:label": {
        "@value": "Reg_346400_Par_3 (redaktsioon 346400)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "346400",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/346400",
      "estleg:sourceAct": "Kavandatavast tehnilisest normist, infoühiskonna teenusele kehtestatavast nõudest ja teenuse osutamise nõudest teavitamise kord ning teavitamist koordineeriva asutuse määramine",
      "estleg:provisionRef": "Reg_346400 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_346400_Map_2026"
      }
    },
