      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_3_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ligipääsetavuselement käesoleva määruse tähenduses on teatud tootele või teenusele või selle kohta antavale teabele juurdepääsu võimaldav osa, omadus või tunnusjoon. Ligipääsetavuselement käesoleva määruse tähenduses on teatud tootele või teenusele või selle kohta antavale teabele juurdepääsu võimaldav osa, omadus või tunnusjoon.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_3 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_30_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse nõudeid kohaldatakse alates 28. juunist 2025. a turule lastava toote ja osutatava teenuse suhtes, arvestades toodete ja teenuste ligipääsetavuse seaduse §-s 22 sätestatud erisusi. Käesoleva määruse nõudeid kohaldatakse alates 28. juunist 2025. a turule lastava toote ja osutatava teenuse suhtes, arvestades toodete ja teenuste ligipääsetavuse seaduse §-s 22 sätestatud erisusi.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_30 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
