  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_toote_ja_teenuse_funktsionaalsed_ligipaasetavusnouded_ja_nou_t1054315_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele (31 versiooni)",
        "@language": "et"
      },
      "dc:source": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele"
    },
    {
      "@id": "estleg:Reg_1054315_Par_1_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määruse nõudeid kohaldatakse toodete ja teenuste ligipääsetavuse seaduse kohaldamisalasse kuuluvatele toodetele ja teenustele ning nende kohta antavale teabele. Käesoleva määruse nõudeid kohaldatakse toodete ja teenuste ligipääsetavuse seaduse kohaldamisalasse kuuluvatele toodetele ja teenustele ning nende kohta antavale teabele. 2 (2) Käesoleva määruse nõudeid kohaldatakse teenusele ka siis, kui seda osutatakse veebilehe või mobiilirakenduse kaudu. Käesoleva määruse nõudeid kohaldatakse teenusele ka siis, kui seda osutatakse veebilehe või mobiilirakenduse kaudu. 3 (3) Käesoleva määruse nõuded kohalduvad riigihankele, mille ese kuulub toodete ja teenuste ligipääsetavuse seaduse kohaldamisalasse ning mille kavandatud kasutaja on füüsiline isik. Nõudeid tuleb arvestada riigihanke alusdokumentide tehnilise kirjelduse koostamisel. Käesoleva määruse nõuded kohalduvad riigihankele, mille ese kuulub toodete ja teenuste ligipääsetavuse seaduse kohaldamisalasse ning mille kavandatud kasutaja on füüsiline isik. Nõudeid tuleb arvestada riigihanke alusdokumentide tehnilise kirjelduse koostamisel. 4 (4) Toote pakendile ning veebilehelt leitavatele juhistele toote paigaldamise, hooldamise, ladustamise ja äraviskamise kohta esitatavaid nõudeid ei kohaldata iseteenindusterminalile. Toote pakendile ning veebilehelt leitavatele juhistele toote paigaldamise, hooldamise, ladustamise ja äraviskamise kohta esitatavaid nõudeid ei kohaldata iseteenindusterminalile.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_1 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_10_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenuse osutamisel tuleb tagada kasutatava toote ligipääsetavus kooskõlas käesoleva määruse §-des 6–8 ning 3. ja 5. peatükis sätestatuga. Teenuse osutamisel tuleb tagada kasutatava toote ligipääsetavus kooskõlas käesoleva määruse §-des 6–8 ning 3. ja 5. peatükis sätestatuga. 2 (2) Veebileht ja mobiilsideseadmel põhinev teenus muudetakse ligipääsetavaks järjepideval ja sobival viisil, tehes see tajutavaks, kasutatavaks, arusaadavaks ja töökindlaks. Veebileht ja mobiilsideseadmel põhinev teenus muudetakse ligipääsetavaks järjepideval ja sobival viisil, tehes see tajutavaks, kasutatavaks, arusaadavaks ja töökindlaks.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_10 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_11_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Iseteenindusterminal peab: 1 1) sisaldama kõnesünteesi tehnoloogiat; 2 2) võimaldama kasutada isiklikke kõrvaklappe; 3 3) piiratud reageerimisaja korral esitama kasutajale hoiatusteate rohkem kui ühe meele kaudu; 4 4) võimaldama pikendada kasutamiseks eraldatud aega; 5 5) olema piisava kontrastsusega ja kompimise teel eristatavate klahvide ja juhtseadistega, kui need on olemas; 6 6) helisignaalide kasutamisel olema ühilduv Euroopa Liidu tasandil olemasolevate abivahendite ja tugitehnoloogiatega; 7 7) võimaldama puudega kasutaja ligipääsu ligipääsetavuselementi aktiveerimata. Iseteenindusterminal peab: sisaldama kõnesünteesi tehnoloogiat; võimaldama kasutada isiklikke kõrvaklappe; piiratud reageerimisaja korral esitama kasutajale hoiatusteate rohkem kui ühe meele kaudu; võimaldama pikendada kasutamiseks eraldatud aega; olema piisava kontrastsusega ja kompimise teel eristatavate klahvide ja juhtseadistega, kui need on olemas; helisignaalide kasutamisel olema ühilduv Euroopa Liidu tasandil olemasolevate abivahendite ja tugitehnoloogiatega; võimaldama puudega kasutaja ligipääsu ligipääsetavuselementi aktiveerimata.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_11 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_12_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "E-lugeril peab olema funktsioon teksti audioesitluseks. E-lugeril peab olema funktsioon teksti audioesitluseks.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_12 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_13_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui tootel on lisaks hääle edastamise võimalusele ka teksti edastamise võimalus, peab toode võimaldama reaalajas tekstiedastust ja toetama kõrgetasemelisi audioseadmeid. Kui tootel on lisaks hääle edastamise võimalusele ka teksti edastamise võimalus, peab toode võimaldama reaalajas tekstiedastust ja toetama kõrgetasemelisi audioseadmeid. 2 (2) Kui tootel on lisaks teksti ja hääle edastamise võimalusele ka video edastamise võimalus, peab toode võimaldama tervikvestluse kasutamist, sealhulgas sünkroniseeritud häält, reaalajas tekstiedastust ja videoresolutsiooni, mis võimaldab suhtlust viipekeeles. Kui tootel on lisaks teksti ja hääle edastamise võimalusele ka video edastamise võimalus, peab toode võimaldama tervikvestluse kasutamist, sealhulgas sünkroniseeritud häält, reaalajas tekstiedastust ja videoresolutsiooni, mis võimaldab suhtlust viipekeeles. 3 (3) Toode peab olema ühildatav traadita võrgu ühendusel kuulmistehnoloogiatega. Toode peab olema ühildatav traadita võrgu ühendusel kuulmistehnoloogiatega. 4 (4) Toote funktsioonid ei või häirida tugitehnoloogia toimimist. Toote funktsioonid ei või häirida tugitehnoloogia toimimist.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_13 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_14_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puudega kasutajale tehakse kättesaadavaks audiovisuaalmeedia teenuse osutaja edastatud ligipääsetavuselemendid kasutaja ligipääsu, valimise, juhtimise, isikustamise ja abivahendisse edastamise kohta. Puudega kasutajale tehakse kättesaadavaks audiovisuaalmeedia teenuse osutaja edastatud ligipääsetavuselemendid kasutaja ligipääsu, valimise, juhtimise, isikustamise ja abivahendisse edastamise kohta.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_14 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_15_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teabe kättesaadavus seoses toote toimimise ja ligipääsetavuselementidega peab vastama käesoleva määruse § 6 lõigetes 4 ja 6 sätestatud elementidele. Teabe kättesaadavus seoses toote toimimise ja ligipääsetavuselementidega peab vastama käesoleva määruse § 6 lõigetes 4 ja 6 sätestatud elementidele. 2 (2) Kasutajaliidese omaduste, elementide ja funktsioonide ligipääsetavus ning toodete funktsionaalsuse kavandamine peavad vastama käesoleva määruse §-s 7 sätestatud asjakohastele nõuetele. Kasutajaliidese omaduste, elementide ja funktsioonide ligipääsetavus ning toodete funktsionaalsuse kavandamine peavad vastama käesoleva määruse §-s 7 sätestatud asjakohastele nõuetele. 3 (3) Pakend ning sellel esitatav teave ja juhised toote paigaldamise, hooldamise, kasutamise ja äraviskamise kohta, mis ei ole esitatud tootel, vaid on kättesaadavad muude vahendite abil, nagu veebileht, välja arvatud iseteenindusterminalid, peavad vastama käesoleva määruse § 6 lõikes 5 ja §-s 8 sätestatud asjakohastele ligipääsetavusnõuetele. Pakend ning sellel esitatav teave ja juhised toote paigaldamise, hooldamise, kasutamise ja äraviskamise kohta, mis ei ole esitatud tootel, vaid on kättesaadavad muude vahendite abil, nagu veebileht, välja arvatud iseteenindusterminalid, peavad vastama käesoleva määruse § 6 lõikes 5 ja §-s 8 sätestatud asjakohastele ligipääsetavusnõuetele.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_15 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_16_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenus peab lisaks hääle ja teksti edastusele võimaldama reaalajas tekstiedastust. Kui lisaks häälele ja tekstile kasutatakse ka videot, peab teenus võimaldama sünkroniseeritud tervikvestlust. Teenus peab lisaks hääle ja teksti edastusele võimaldama reaalajas tekstiedastust. Kui lisaks häälele ja tekstile kasutatakse ka videot, peab teenus võimaldama sünkroniseeritud tervikvestlust. 2 (2) Teenus peab tagama hädaabiühenduse, mis võimaldab hädaabiteatele vastata, kasutades vastamisel samasugust vormingut nagu teate saamisel. Hädaabiühenduse ajal tagatakse hääle ja teksti, sealhulgas reaalajas tekstiedastuse sünkroniseeritus, või video olemasolu korral hääle, teksti ja video sünkroniseeritus tervikvestluses. Teenus peab tagama hädaabiühenduse, mis võimaldab hädaabiteatele vastata, kasutades vastamisel samasugust vormingut nagu teate saamisel. Hädaabiühenduse ajal tagatakse hääle ja teksti, sealhulgas reaalajas tekstiedastuse sünkroniseeritus, või video olemasolu korral hääle, teksti ja video sünkroniseeritus tervikvestluses.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_16 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_17_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenus peab pakkuma tajutavaid, kasutatavaid, arusaadavaid ja töökindlaid elektroonilisi saatekavasid, mis annavad teavet ligipääsetavusfunktsioonide kättesaadavuse kohta. Teenus peab pakkuma tajutavaid, kasutatavaid, arusaadavaid ja töökindlaid elektroonilisi saatekavasid, mis annavad teavet ligipääsetavusfunktsioonide kättesaadavuse kohta. 2 (2) Teenus peab tagama audiovisuaalmeedia teenuse ligipääsetavuselementide täieliku edastatuse, piisava kvaliteedi, heli ja video sünkroniseerituse ning võimaldatuse kasutajal seadistada kuva ja kasutust. Teenus peab tagama audiovisuaalmeedia teenuse ligipääsetavuselementide täieliku edastatuse, piisava kvaliteedi, heli ja video sünkroniseerituse ning võimaldatuse kasutajal seadistada kuva ja kasutust. 3 (3) Audiovisuaalmeedia teenuse ligipääsetavuselemendid on: 1 1) subtiitrid kurdile ja vaegkuuljale; 2 2) kirjeldustõlge; 3 3) subtiitrite pealelugemine; 4 4) viipekeelne tõlge. Audiovisuaalmeedia teenuse ligipääsetavuselemendid on: subtiitrid kurdile ja vaegkuuljale; kirjeldustõlge; subtiitrite pealelugemine; viipekeelne tõlge.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_17 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_18_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenus peab selle osutamisel vastama käesoleva määruse §-des 9 ja 10 sätestatud nõuetele. Teenus peab selle osutamisel vastama käesoleva määruse §-des 9 ja 10 sätestatud nõuetele. 2 (2) Teenuse osutamisel esitatakse: 1 1) teave sõiduki, ümbritseva taristu ja tehiskeskkonna ligipääsetavuse kohta ning abi kohta puudega kasutajale; 2 2) teave aruka piletimüügisüsteemi ja selle funktsioonide kohta; 3 3) reaalajas reisijateave; 4 4) teave lisateenuste kättesaadavuse kohta. Teenuse osutamisel esitatakse: teave sõiduki, ümbritseva taristu ja tehiskeskkonna ligipääsetavuse kohta ning abi kohta puudega kasutajale; teave aruka piletimüügisüsteemi ja selle funktsioonide kohta; reaalajas reisijateave; teave lisateenuste kättesaadavuse kohta.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_18 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_19_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenuse osutamisel kasutatavad iseteenindusterminalid peavad olema ligipääsetavad kooskõlas käesoleva määruse §-des 6, 7 ja 9, § 10 lõikes 1 ja §-s 11 sätestatuga. Teenuse osutamisel kasutatavad iseteenindusterminalid peavad olema ligipääsetavad kooskõlas käesoleva määruse §-des 6, 7 ja 9, § 10 lõikes 1 ja §-s 11 sätestatuga.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_19 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_2_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Järjestikjuhtimine käesoleva määruse tähenduses on funktsioon, mis võimaldab toodet juhtida üksteisele järgnevate kindlas järjekorras käsklustega, kasutades kasutajaliidest. Järjestikjuhtimine käesoleva määruse tähenduses on funktsioon, mis võimaldab toodet juhtida üksteisele järgnevate kindlas järjekorras käsklustega, kasutades kasutajaliidest. 2 (2) Kasutajaliides käesoleva määruse tähenduses on interaktiivse süsteemi (tarkvara või riistvara) kõik komponendid, mis pakuvad kasutajale teavet ja/või kontrolli, et täita konkreetseid ülesandeid interaktiivse süsteemiga. Kasutajaliides käesoleva määruse tähenduses on interaktiivse süsteemi (tarkvara või riistvara) kõik komponendid, mis pakuvad kasutajale teavet ja/või kontrolli, et täita konkreetseid ülesandeid interaktiivse süsteemiga. 3 (3) Kasutajaliidese komponent käesoleva määruse tähenduses on kasutajaliidese üksus, mille esitab kasutajale tarkvara. Kasutajaliidese komponent käesoleva määruse tähenduses on kasutajaliidese üksus, mille esitab kasutajale tarkvara.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_2 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_20_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenuse osutamisel kasutatavad autentimisviisid, elektroonilised allkirjad, maksejuhiste andmine ja maksetehingute täitmine ning rakendatavad turvameetmed, sealhulgas makseinstrumendi blokeerimine, peavad olema tajutavad, kasutatavad, arusaadavad ja töökindlad. Teenuse osutamisel kasutatavad autentimisviisid, elektroonilised allkirjad, maksejuhiste andmine ja maksetehingute täitmine ning rakendatavad turvameetmed, sealhulgas makseinstrumendi blokeerimine, peavad olema tajutavad, kasutatavad, arusaadavad ja töökindlad. 2 (2) Teenuse osutamisel antav teave peab olema arusaadav. Teabe keerukus ei või ületada Euroopa Nõukogu Euroopa keeleõppe raamdokumendi taset B2 (kõrgem kesktase). Teenuse osutamisel antav teave peab olema arusaadav. Teabe keerukus ei või ületada Euroopa Nõukogu Euroopa keeleõppe raamdokumendi taset B2 (kõrgem kesktase).",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_20 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_21_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui e-raamat sisaldab lisaks tekstile ka heli, tuleb tekst ja heli teenuse osutamisel esitada sünkroonselt. Kui e-raamat sisaldab lisaks tekstile ka heli, tuleb tekst ja heli teenuse osutamisel esitada sünkroonselt. 2 (2) E-raamatu digitaalne fail peab teenuse osutamisel võimaldama tugitehnoloogial nõuetekohaselt toimida. E-raamatu digitaalne fail peab teenuse osutamisel võimaldama tugitehnoloogial nõuetekohaselt toimida. 3 (3) Teenuse osutamisel peab puudega kasutajal olema võimalik: 1 1) pääseda ligi e-raamatu sisule; 2 2) navigeerida e-raamatu sisus ja kujunduses; 3 3) tajuda e-raamatu struktuuri; 4 4) kasutada e-raamatut paindlikult, omades valikuvõimalusi sisu esitamisel. Teenuse osutamisel peab puudega kasutajal olema võimalik: pääseda ligi e-raamatu sisule; navigeerida e-raamatu sisus ja kujunduses; tajuda e-raamatu struktuuri; kasutada e-raamatut paindlikult, omades valikuvõimalusi sisu esitamisel. 4 (4) E-raamatu sisu alternatiivsed esitusviisid ja koostalitlus mitmesuguste tugitehnoloogiatega peavad olema tajutavad, arusaadavad, kasutatavad ja töökindlad. E-raamatu sisu alternatiivsed esitusviisid ja koostalitlus mitmesuguste tugitehnoloogiatega peavad olema tajutavad, arusaadavad, kasutatavad ja töökindlad. 5 (5) E-raamat peab olema leitav metaandmete kaudu ligipääsetavuselementide kohta esitatud teabe järgi. E-raamat peab olema leitav metaandmete kaudu ligipääsetavuselementide kohta esitatud teabe järgi. 6 (6) E-raamatu ligipääsetavuselemendid peavad olema rakendatavad sõltumata autoriõiguste digitaalkaitse meetmetest. E-raamatu ligipääsetavuselemendid peavad olema rakendatavad sõltumata autoriõiguste digitaalkaitse meetmetest.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_21 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_22_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenuse osutamisel esitatav teave peab sisaldama teavet müüdava toote ja teenuse ligipääsetavuse kohta, kui vastutav ettevõtja on eelnevalt selle teabe müüjale kättesaadavaks teinud. Teenuse osutamisel esitatav teave peab sisaldama teavet müüdava toote ja teenuse ligipääsetavuse kohta, kui vastutav ettevõtja on eelnevalt selle teabe müüjale kättesaadavaks teinud. 2 (2) Teenuse osana pakutavad autentimis- ja makseviisid ning turvalisuse eesmärgil kasutatavad funktsioonid peavad olema tajutavad, kasutatavad, arusaadavad ja töökindlad. Teenuse osana pakutavad autentimis- ja makseviisid ning turvalisuse eesmärgil kasutatavad funktsioonid peavad olema tajutavad, kasutatavad, arusaadavad ja töökindlad. 3 (3) Teenuse osutamisel pakutav autentimismeetod, elektrooniline allkiri ja makseteenus peab olema tajutav, kasutatav, arusaadav ja töökindel. Teenuse osutamisel pakutav autentimismeetod, elektrooniline allkiri ja makseteenus peab olema tajutav, kasutatav, arusaadav ja töökindel.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_22 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_23_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenuse omaduste, elementide ja funktsioonide ligipääsetavus peab vastama selliste omaduste, elementide ja funktsioonide asjakohastele ligipääsetavusnõuetele, mis on sätestatud käesoleva määruse teenusega seotud paragrahvides. Teenuse omaduste, elementide ja funktsioonide ligipääsetavus peab vastama selliste omaduste, elementide ja funktsioonide asjakohastele ligipääsetavusnõuetele, mis on sätestatud käesoleva määruse teenusega seotud paragrahvides.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_23 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_24_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Funktsionaalse toimivuse kriteeriumeid kasutatakse tootmise teatud tootedisaini või teenuse osutamise teatud funktsiooni ja viisi suhtes, millele käesoleva määruse 2., 3. või 4. peatükis sätestatud ligipääsetavusnõuded ei kohaldu. Funktsionaalse toimivuse kriteeriumeid kasutatakse tootmise teatud tootedisaini või teenuse osutamise teatud funktsiooni ja viisi suhtes, millele käesoleva määruse 2., 3. või 4. peatükis sätestatud ligipääsetavusnõuded ei kohaldu. 2 (2) Funktsionaalse toimivuse kriteeriumeid kasutatakse: 1 1) alternatiivina ühele või enamale tehnilise nõudele, millele osutatakse käesoleva määruse 2., 3. või 4. peatükis sätestatud ligipääsetavusnõuetes, ja 2 2) ainult juhul, kui funktsionaalse toimivuse kriteeriumite kohaldamine vastab ligipääsetavusnõuetele ning 3 3) toote kavandamise ja tootmise ning teenuse osutamise tulemuseks on võrdväärne või parem ligipääs puudega kasutaja jaoks. Funktsionaalse toimivuse kriteeriumeid kasutatakse: alternatiivina ühele või enamale tehnilise nõudele, millele osutatakse käesoleva määruse 2., 3. või 4. peatükis sätestatud ligipääsetavusnõuetes, ja ainult juhul, kui funktsionaalse toimivuse kriteeriumite kohaldamine vastab ligipääsetavusnõuetele ning toote kavandamise ja tootmise ning teenuse osutamise tulemuseks on võrdväärne või parem ligipääs puudega kasutaja jaoks.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_24 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_25_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toode või teenus hõlmab vähemalt ühte töörežiimi, mille elemendid lihtsustavad ja hõlbustavad selle kasutamist kognitiivselt. Toode või teenus hõlmab vähemalt ühte töörežiimi, mille elemendid lihtsustavad ja hõlbustavad selle kasutamist kognitiivselt. 2 (2) Kui toode või teenus hõlmab elemente, mis on sellele paigaldatud ligipääsetavuse eesmärgil, pakutakse kasutajale vähemalt ühte töörežiimi, mis tagab ligipääsetavuse eesmärgil paigaldatud elementide kasutamisel eraelu puutumatuse. Kui toode või teenus hõlmab elemente, mis on sellele paigaldatud ligipääsetavuse eesmärgil, pakutakse kasutajale vähemalt ühte töörežiimi, mis tagab ligipääsetavuse eesmärgil paigaldatud elementide kasutamisel eraelu puutumatuse.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_25 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_26_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui toode või teenus pakub visuaalseid töörežiime, pakutakse kasutajale vähemalt ühte töörežiimi, mis võimaldab piiratud nägemisvõimega kasutajal toodet või teenust kasutada, samuti töörežiimi, mis ei eelda nägemisvõimet. Kui toode või teenus pakub visuaalseid töörežiime, pakutakse kasutajale vähemalt ühte töörežiimi, mis võimaldab piiratud nägemisvõimega kasutajal toodet või teenust kasutada, samuti töörežiimi, mis ei eelda nägemisvõimet. 2 (2) Kui toode või teenus pakub visuaalseid töörežiime, pakutakse kasutajale vähemalt ühte töörežiimi, mis ei eelda kasutaja värvitaju. Kui toode või teenus pakub visuaalseid töörežiime, pakutakse kasutajale vähemalt ühte töörežiimi, mis ei eelda kasutaja värvitaju. 3 (3) Kui toode pakub visuaalseid töörežiime, välditakse töörežiime, mis vallandavad valgustundlikkushoogusid. Kui toode pakub visuaalseid töörežiime, välditakse töörežiime, mis vallandavad valgustundlikkushoogusid.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_26 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_27_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui toode või teenus pakub auditiivseid töörežiime, pakutakse kasutajale vähemalt ühte tõhustatud helifunktsioonidega töörežiimi, mis võimaldab piiratud kuulmisvõimega kasutajal toodet või teenust kasutada, samuti töörežiimi, mis ei eelda kuulmisvõimet. Kui toode või teenus pakub auditiivseid töörežiime, pakutakse kasutajale vähemalt ühte tõhustatud helifunktsioonidega töörežiimi, mis võimaldab piiratud kuulmisvõimega kasutajal toodet või teenust kasutada, samuti töörežiimi, mis ei eelda kuulmisvõimet.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_27 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_28_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui toode või teenus nõuab kasutajalt häälsisendit, pakutakse kasutajale vähemalt ühte töörežiimi, mis ei nõua häälsisendit. Häälsisend hõlmab mis tahes suuliselt tekitatavat heli. Kui toode või teenus nõuab kasutajalt häälsisendit, pakutakse kasutajale vähemalt ühte töörežiimi, mis ei nõua häälsisendit. Häälsisend hõlmab mis tahes suuliselt tekitatavat heli.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_28 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054315",
      "estleg:sourceAct": "Toote ja teenuse funktsionaalsed ligipääsetavusnõuded ja nõuded nende kohta antavale teabele",
      "estleg:provisionRef": "Reg_1054315 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054315_Par_29_v1054315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054315_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui toode või teenus nõuab manuaalseid toiminguid, pakutakse kasutajale vähemalt ühte töörežiimi, mis võimaldab kasutada toodet alternatiivsete toimingute abil, mis ei eelda peenmotoorset juhtimist ega käsitsemist, käejõudu ega korraga rohkem kui ühe juhtseadise kasutamist. Kui toode või teenus nõuab manuaalseid toiminguid, pakutakse kasutajale vähemalt ühte töörežiimi, mis võimaldab kasutada toodet alternatiivsete toimingute abil, mis ei eelda peenmotoorset juhtimist ega käsitsemist, käejõudu ega korraga rohkem kui ühe juhtseadise kasutamist. 2 (2) Kui toode või teenus pakub manuaalset töörežiimi, pakutakse kasutajale vähemalt ühte töörežiimi, mida saab kasutada piiratud ulatusvõime korral. Toote juhtelemendid peavad olema piiratud võimekusega kasutaja küündivusulatuses. Kui toode või teenus pakub manuaalset töörežiimi, pakutakse kasutajale vähemalt ühte töörežiimi, mida saab kasutada piiratud ulatusvõime korral. Toote juhtelemendid peavad olema piiratud võimekusega kasutaja küündivusulatuses.",
      "rdfs:label": {
        "@value": "Reg_1054315_Par_29 (redaktsioon 1054315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054315",
