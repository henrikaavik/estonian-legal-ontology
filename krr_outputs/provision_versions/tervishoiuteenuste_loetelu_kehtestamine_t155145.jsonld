  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_tervishoiuteenuste_loetelu_kehtestamine_t155145_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tervishoiuteenuste loetelu kehtestamine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tervishoiuteenuste loetelu kehtestamine"
    },
    {
      "@id": "estleg:Reg_155145_Par_1_v155145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155145_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervishoiuteenuste loeteluna käsitletakse järgmisi tervishoiuteenuseid: 1) Rahvusvahelises haiguste ja tervisega seotud probleemide statistilise klassifikatsiooni kümnendas väljaandes (RHK-10) loetletud haiguste diagnoosimise ja ravimisega seotud tervishoiuteenused. Nimetatud klassifikatsiooni ingliskeelne nimetus ja lühend on International Statistical Classification of Diseases and Related Health Problems Tenth Revision (ICD-10); 2) Põhjamaade Meditsiinistatistika Komitee kirurgiliste protseduuride klassifikatsioonis loetletud kirurgilised protseduurid. Nimetatud klassifikatsiooni ingliskeelne nimetus ja lühend on Nordic Medico-Statistical Committee, Classification of Surgical Procedures (NOMESCO NCSP).",
      "rdfs:label": {
        "@value": "Reg_155145_Par_1 (redaktsioon 155145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155145",
      "estleg:sourceAct": "Tervishoiuteenuste loetelu kehtestamine",
      "estleg:provisionRef": "Reg_155145 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155145_Map"
      }
    },
    {
      "@id": "estleg:Reg_155145_Par_2_v155145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155145_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse paragrahvis 1 nimetatud klassifikatsioonid on aluseks riiklike tervishoiu statistiliste vaatluste ning tervishoiualase tegevuse rahastamise, kvaliteedikontrolli ja järelevalve korraldamisele.",
      "rdfs:label": {
        "@value": "Reg_155145_Par_2 (redaktsioon 155145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155145",
      "estleg:sourceAct": "Tervishoiuteenuste loetelu kehtestamine",
      "estleg:provisionRef": "Reg_155145 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155145_Map"
      }
    },
    {
      "@id": "estleg:Reg_155145_Par_3_v155145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155145_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse §-s 1 nimetatud klassifikatsioonid avaldatakse Sotsiaalministeeriumi Interneti koduleheküljel.",
      "rdfs:label": {
        "@value": "Reg_155145_Par_3 (redaktsioon 155145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155145",
      "estleg:sourceAct": "Tervishoiuteenuste loetelu kehtestamine",
      "estleg:provisionRef": "Reg_155145 § 3",
      "estleg:partOfAct": {
