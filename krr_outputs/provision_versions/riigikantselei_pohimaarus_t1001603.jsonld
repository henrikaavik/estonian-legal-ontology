    {
      "@id": "estleg:Reg_1001603_Par_7_v1001603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001603_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigikantselei struktuuriüksuste juhid on Riigikantselei direktorid ning osakondade ja osakondadega võrdsustatud struktuuriüksuste juhid (edaspidi üksuse juht). Riigikantselei struktuuriüksuste juhid on Riigikantselei direktorid ning osakondade ja osakondadega võrdsustatud struktuuriüksuste juhid (edaspidi üksuse juht). 2 (2) Üksuse juht juhib ja esindab üksust ning oma vastutusalas Riigikantseleid, tagab üksuse eesmärkide saavutamise ja ülesannete täitmise ning annab riigisekretärile aru üksuse tegevusest. RT I 2014-05-30 1 130052014001 2014-06-02 Üksuse juht juhib ja esindab üksust ning oma vastutusalas Riigikantseleid, tagab üksuse eesmärkide saavutamise ja ülesannete täitmise ning annab riigisekretärile aru üksuse tegevusest. 3 (3) Üksuse juhi nimetab ametikohale ja vabastab ametikohalt või sõlmib ja lõpetab temaga töölepingu riigisekretär. RT I 2014-05-30 1 130052014001 2014-06-02 Üksuse juhi nimetab ametikohale ja vabastab ametikohalt või sõlmib ja lõpetab temaga töölepingu riigisekretär. 4 (4) Üksuse juht allub vahetult riigisekretärile. Üksuse juht allub vahetult riigisekretärile.",
      "rdfs:label": {
        "@value": "Reg_1001603_Par_7 (redaktsioon 1001603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001603",
      "estleg:sourceAct": "Riigikantselei põhimäärus",
      "estleg:provisionRef": "Reg_1001603 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001603_Map"
      }
    },
    {
      "@id": "estleg:Reg_1001603_Par_8_v1001603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001603_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigikantselei struktuuriüksused on osakonnad ja osakondadega võrdsustatud muud käesolevas peatükis nimetatud struktuuriüksused (edaspidi üksused). Riigikantselei struktuuriüksused on osakonnad ja osakondadega võrdsustatud muud käesolevas peatükis nimetatud struktuuriüksused (edaspidi üksused). 2 (2) Üksuse ülesanded ja allstruktuuriüksused sätestatakse üksuse põhimääruses, mille kinnitab riigisekretär. Üksuse ülesanded ja allstruktuuriüksused sätestatakse üksuse põhimääruses, mille kinnitab riigisekretär.",
      "rdfs:label": {
        "@value": "Reg_1001603_Par_8 (redaktsioon 1001603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001603",
      "estleg:sourceAct": "Riigikantselei põhimäärus",
      "estleg:provisionRef": "Reg_1001603 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001603_Map"
      }
    },
    {
      "@id": "estleg:Reg_1001603_Par_9_v1001603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001603_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Peaministri tegevuse toetamiseks on Riigikantseleis peaministri büroo, mille koosseisu kuuluvad peaministri nõunikud ja abid. Peaministri tegevuse toetamiseks on Riigikantseleis peaministri büroo, mille koosseisu kuuluvad peaministri nõunikud ja abid. 2 (2) Peaministri büroo nõustab ja toetab peaministrit tema tegevuses. Peaministri büroo nõustab ja toetab peaministrit tema tegevuses.",
      "rdfs:label": {
