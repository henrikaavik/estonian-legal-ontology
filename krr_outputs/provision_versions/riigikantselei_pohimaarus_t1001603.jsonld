      },
      "estleg:versionText": "Määrus jõustub 1. jaanuaril 2012. a. Määrus jõustub 1. jaanuaril 2012. a.",
      "rdfs:label": {
        "@value": "Reg_1001603_Par_15 (redaktsioon 1001603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001603",
