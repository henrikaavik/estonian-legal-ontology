      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Autori või teose esitaja isiklike õiguste rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 500 000 krooni.",
      "rdfs:label": {
        "@value": "AUTORI_Par_81_3 (redaktsioon 12791124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12791124",
