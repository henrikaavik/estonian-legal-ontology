      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AUTORI_Par_53 (redaktsioon 128122021003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122021003"
    },
    {
      "@id": "estleg:AUTORI_Par_54_v22235",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTORI_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Autorilepingu järgi varaliste õiguste üleandmise või ainulitsentsi andmise kohta ei ole autoril ega tema õigusjärglasel õigust teise poole kirjaliku nõusolekuta anda lepingus nimetatud teost või selle osa kolmandatele isikutele samal viisil kasutamiseks, nagu oli lepingus kokku lepitud, kui lepinguga ei ole ette nähtud teisiti.",
      "rdfs:label": {
        "@value": "AUTORI_Par_54 (redaktsioon 22235)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22235",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTORI_Par_54_v128122011005"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTORI_Par_54_v128122011005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTORI_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AUTORI_Par_54 (redaktsioon 128122011005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011005"
    },
    {
      "@id": "estleg:AUTORI_Par_55_v22235",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTORI_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Autoritasu maksmise viis (protsent teose müügihinnast, konkreetselt kindlaksmääratud summa, protsent teose kasutamisel saadavast kasumist jne), tasu suurus, selle väljamaksmise tähtaeg ja kord määratakse autorilepingus poolte kokkuleppel. (2) Kui Eesti Vabariigi õigusaktidega on kehtestatud autoritasu alammäärad, ei tohi autorilepingus kokkulepitud tasumäärad olla nendest väiksemad.",
      "rdfs:label": {
        "@value": "AUTORI_Par_55 (redaktsioon 22235)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22235",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTORI_Par_55_v13314672"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTORI_Par_55_v13314672",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTORI_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud –",
      "rdfs:label": {
        "@value": "AUTORI_Par_55 (redaktsioon 13314672)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314672",
