  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_autorioiguse_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Autoriõiguse seadus (519 versiooni)",
        "@language": "et"
      },
      "dc:source": "Autoriõiguse seadus"
    },
    {
      "@id": "estleg:AUTORI_Par_1_v22235",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTORI_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Autoriõiguse seaduse eesmärk on tagada kultuuri järjepidevus ja kultuurisaavutuste kaitse, autoriõigusel põhinevate tootmisharude ja rahvusvahelise kaubanduse areng ning luua autoritele, teose esitajatele, fonogrammitootjatele, raadio- ja televisiooniorganisatsioonidele, filmi esmasalvestuse tootjatele, andmebaasi tegijatele ning teistele käesolevas seaduses nimetatud isikutele soodsad tingimused teoste ja muude kultuurisaavutuste loomiseks ja kasutamiseks. (2) Autoriõiguse seadus sätestab: kirjandus-, kunsti- ja teadusteoste autoritele spetsiifilise õiguse (autoriõiguse) kaitse oma loometöö tulemustele; isikute ringi, kes võivad omandada õigusi autori poolt loodud kirjandus-, kunsti- ja teadusteostele ning nende õigused; õigused teoste esitajatele, fonogrammitootjatele ning raadio- ja televisiooniorganisatsioonidele (autoriõigusega kaasnevad õigused); andmebaasi tegija õigused, nende teostamise tingimused ja kaitse; filmi esmasalvestuse tootja ning teiste käesolevas seaduses nimetatud isikute autoriõigusega kaasnevad õigused; autoriõiguse ja autoriõigusega kaasnevate õiguste teostamise piirangud teoste kasutamisel ühiskonna huvides; autoriõiguse ja autoriõigusega kaasnevate õiguste teostamise garantiid ja kaitse. (3) [kehtetu]",
      "rdfs:label": {
        "@value": "AUTORI_Par_1 (redaktsioon 22235)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22235",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTORI_Par_1_v810714"
      },
      "estleg:versionValidTo": {
        "@value": "2004-10-28",
        "@type": "xsd:date"
      }
    },
    {
