    {
      "@id": "estleg:AUTORI_Par_81_3_v810714",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTORI_Par_81_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 811 ja 812 sätestatud väärtegudele kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 82, 480; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40; 46, 329; 54, 387; 56, 401) üldosa ja väärteomenetluse seadustiku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590; 2004, 46, 329; 54, 387 ja 390; 56, 403) sätteid. (2) Käesoleva seaduse §-des 811 ja 812 sätestatud väärtegude kohtuväline menetleja on: politseiprefektuur; Tarbijakaitseamet. (3) Politseiprefektuur või kohus konfiskeerib käesoleva seaduse §-s 811 sätestatud väärteo toimepanemise vahetuks objektiks olnud eseme.",
      "rdfs:label": {
        "@value": "AUTORI_Par_81_3 (redaktsioon 810714)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "810714",
