      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teose kasutamise algustähtaeg ei tohi ületada ühte aastat, alates autori poolt teose kasutajale üleandmise momendist, kui lepinguga ei ole ette nähtud teisiti.",
      "rdfs:label": {
