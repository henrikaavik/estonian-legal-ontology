    },
    {
      "@id": "estleg:AUTORI_Par_53_v217212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTORI_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teose kasutamise algustähtaeg ei tohi ületada ühte aastat, alates autori poolt teose kasutajale üleandmise momendist, kui lepinguga ei ole ette nähtud teisiti. §-d 54--55. Kehtetud -",
      "rdfs:label": {
        "@value": "AUTORI_Par_53 (redaktsioon 217212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "217212",
