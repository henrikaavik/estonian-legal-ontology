      }
    },
    {
      "@id": "estleg:Reg_1002194_Par_7_v1002194",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002194_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmeleht on valge A4 formaadis (210 mm × 297 mm) kirjapaberi leht, mille esiküljele on kantud §-s 4 nimetatud andmed. Andmeleht on valge A4 formaadis (210 mm × 297 mm) kirjapaberi leht, mille esiküljele on kantud §-s 4 nimetatud andmed. 2 (2) Andmete trükkimisel kasutatakse Times New Roman kirja tüüpi. Andmete trükkimisel kasutatakse Times New Roman kirja tüüpi.",
      "rdfs:label": {
        "@value": "Reg_1002194_Par_7 (redaktsioon 1002194)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002194",
