      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Satelliit- ja GPS-jälgimissüsteemi kaudu esitatavate andmete nimistu, andmete esitamise sagedus ja kord ning nõuded jälgimisseadme ja selle kasutamise kohta (13 versiooni)",
        "@language": "et"
      },
      "dc:source": "Satelliit- ja GPS-jälgimissüsteemi kaudu esitatavate andmete nimistu, andmete esitamise sagedus ja kord ning nõuded jälgimisseadme ja selle kasutamise kohta"
    },
    {
      "@id": "estleg:Reg_1030536_Par_1_v1030536",
      "@type": [
