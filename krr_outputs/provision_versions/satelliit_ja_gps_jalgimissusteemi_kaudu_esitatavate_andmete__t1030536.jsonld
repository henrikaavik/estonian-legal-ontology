    {
      "@id": "estleg:Reg_1030536_Par_11_v1030536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030536_Par_11"
