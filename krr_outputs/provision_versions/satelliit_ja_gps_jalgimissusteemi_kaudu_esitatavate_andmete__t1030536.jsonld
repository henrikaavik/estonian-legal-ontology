      "estleg:provisionRef": "Reg_1030536 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030536_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030536_Par_3_v1030536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030536_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kalapüügiseaduse § 69 lõikes 1 nimetatud kalalaev peab olema varustatud Inmarsat-C või Iridium satelliitsidevõrku lülitatud ja selles töötava seadmega. RT I 2017-12-05 13 105122017013 2017-12-08 Kalapüügiseaduse § 69 lõikes 1 nimetatud kalalaev peab olema varustatud Inmarsat-C või Iridium satelliitsidevõrku lülitatud ja selles töötava seadmega. 2 (2) Kalalaeva pardale paigaldatud satelliitjälgimisseadme tehnilise rikke või toimumast lakkamise korral peab rikke viivitamata kõrvaldama. RT I 2017-12-05 13 105122017013 2017-12-08 Kalalaeva pardale paigaldatud satelliitjälgimisseadme tehnilise rikke või toimumast lakkamise korral peab rikke viivitamata kõrvaldama.",
      "rdfs:label": {
        "@value": "Reg_1030536_Par_3 (redaktsioon 1030536)",
        "@language": "et"
      },
