      "estleg:versionText": "Määrus jõustub 1. septembril 2015. a. Määrus jõustub 1. septembril 2015. a.",
      "rdfs:label": {
        "@value": "Reg_1030536_Par_13 (redaktsioon 1030536)",
        "@language": "et"
