      },
      "estleg:versionValidTo": {
        "@value": "2005-07-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RSS_Par_27_v921726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RSS_Par_27"
      },
      "estleg:versionValidFrom": {
