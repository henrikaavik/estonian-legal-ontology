    },
    {
      "@id": "estleg:UHISTR_Par_12_v123032015002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISTR_Par_12"
      },
