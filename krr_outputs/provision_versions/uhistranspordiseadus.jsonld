      },
      "estleg:versionValidTo": {
        "@value": "2003-11-24",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:UHISTR_Par_11_v672807",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
