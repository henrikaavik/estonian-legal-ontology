    {
      "@id": "estleg:UHISTR_Par_96_1_v130062020024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISTR_Par_96_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2020/698, milles sätestatakse seoses COVID-19 puhanguga ajutised erimeetmed teatavate tunnistuste, litsentside ja lubade uuendamise või pikendamise ning korraliste kontrollide ja jätkuõppe edasilükkamise kohta teatavates transpordialaste õigusaktide valdkondades (ELT L 165, 27.05.2020, lk 10–24), artikli 8 lõikes 5 sätestatud mittekohaldamise erandi kasutamise otsustab määrusega. (2) Käesoleva paragrahvi lõikes 1 nimetatud ministri määrust võib rakendada tagasiulatuvalt alates 2020. aasta 4. juunist.",
      "rdfs:label": {
        "@value": "UHISTR_Par_96_1 (redaktsioon 130062020024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062020024",
      "estleg:supersededByVersion": {
        "@id": "estleg:UHISTR_Par_96_1_v130032021009"
      },
      "estleg:versionValidTo": {
        "@value": "2021-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:UHISTR_Par_96_1_v130032021009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISTR_Par_96_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2021/267, milles sätestatakse COVID-19 kriisi jätkumisega seoses ajutised erimeetmed, mis käsitlevad teatavate tunnistuste, litsentside ja lubade uuendamist või pikendamist, korraliste kontrollide ja jätkuõppe edasilükkamist teatavates transpordialaste õigusaktide valdkondades ning määruses 2020/698 osutatud teatavate ajavahemike pikendamist (ELT L 60, 22.02.2021, lk 1–20), artikli 8 lõikes 5 sätestatud mittekohaldamise erandi kasutamise otsustab määrusega. (2) Käesoleva paragrahvi lõikes 1 nimetatud ministri määrust võib rakendada tagasiulatuvalt alates 2021. aasta 23. märtsist.",
      "rdfs:label": {
        "@value": "UHISTR_Par_96_1 (redaktsioon 130032021009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130032021009"
    },
    {
      "@id": "estleg:UHISTR_Par_97_v123032015002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISTR_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Halduskoostöö seaduse § 13 lõiget 11 täiendatakse punktiga 24 järgmises sõnastuses: „24) ühistranspordiseaduse § 15 lõikes 2 nimetatud haldusleping.”.",
      "rdfs:label": {
        "@value": "UHISTR_Par_97 (redaktsioon 123032015002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015002"
