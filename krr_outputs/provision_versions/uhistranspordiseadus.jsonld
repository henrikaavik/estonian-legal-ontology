  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_uhistranspordiseadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ühistranspordiseadus (598 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ühistranspordiseadus"
    },
    {
      "@id": "estleg:UHISTR_Par_1_v22458",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISTR_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatakse maantee-, raudtee-, vee- ja lennuliikluses ühistranspordi korraldamise alused. Maanteeliiklusena käsitatakse bussi-, trammi-, trollibussi- ja taksoliiklust, raudteeliiklusena rongi- ja rööbasbussiliiklust, veeliiklusena laeva-, väikelaeva- ja parvlaevaliiklust ning lennuliiklusena õhusõidukiliiklust. (2) Käesolevas seaduses ei käsitleta raudtee-, vee- ja lennuliikluses sõitjate veoks vajalike tegevuslubade ning kõigis veoliikides kiirabi- ja meditsiinitranspordi tegevuslubade väljaandmise, pikendamise, peatamise ning kehtetuks tunnistamise korda ja tingimusi, mida reguleeritakse teiste seadustega. (3) Motoriseerimata transpordivahendi kasutamist ühissõidukina reguleeritakse kohaliku omavalitsuse üksuse (edaspidi omavalitsusüksus ) õigusaktideda.",
      "rdfs:label": {
        "@value": "UHISTR_Par_1 (redaktsioon 22458)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22458",
      "estleg:supersededByVersion": {
        "@id": "estleg:UHISTR_Par_1_v180010"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:UHISTR_Par_1_v180010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISTR_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatakse maantee-, raudtee-, vee- ja lennuliikluses ühistranspordi korraldamise alused. Maanteeliiklusena käsitatakse bussi-, trammi-, trollibussi- ja taksoliiklust, raudteeliiklusena rongi- ja rööbasbussiliiklust, veeliiklusena laeva-, väikelaeva- ja parvlaevaliiklust ning lennuliiklusena õhusõidukiliiklust. (2) Käesolevas seaduses ei käsitleta raudtee-, vee- ja lennuliikluses sõitjate veoks vajalike tegevuslubade ning kõigis veoliikides kiirabi- ja meditsiinitranspordi tegevuslubade väljaandmise, pikendamise, peatamise ning kehtetuks tunnistamise korda ja tingimusi, mida reguleeritakse teiste seadustega. (3) Motoriseerimata transpordivahendi kasutamist ühissõidukina reguleeritakse kohaliku omavalitsuse üksuse (edaspidi omavalitsusüksus) õigusaktideda.",
      "rdfs:label": {
