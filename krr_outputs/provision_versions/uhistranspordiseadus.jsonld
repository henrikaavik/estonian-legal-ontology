      }
    },
    {
      "@id": "estleg:UHISTR_Par_30_v12794214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISTR_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Rahvusvahelisel liiniveol võib vedaja anda soodustusi, järgides Eesti Vabariigi välislepingutest tulenevaid nõudeid. (3) Kommertsliiniveol ja taksoveol vedaja antud soodustused hüvitamisele ei kuulu.",
      "rdfs:label": {
        "@value": "UHISTR_Par_30 (redaktsioon 12794214)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12794214",
      "estleg:supersededByVersion": {
        "@id": "estleg:UHISTR_Par_30_v13337617"
      },
      "estleg:versionValidTo": {
        "@value": "2010-09-01",
