        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-des 17–19 nimetatud ühistranspordiprojekti elluviimiseks korraldatakse hankemenetlus riigihangete seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "UHISTR_Par_21 (redaktsioon 13337617)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13337617",
      "estleg:supersededByVersion": {
