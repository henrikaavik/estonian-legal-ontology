        "@id": "estleg:Reg_1001141_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001141_Par_9_v1001141",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
