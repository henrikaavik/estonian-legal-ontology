    {
      "@id": "estleg:Reg_1001141_Par_7_v1001141",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001141_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pakkumiskutses ettenähtud juhul ja tingimustel võib võrguettevõtja nõuda pakkumise tagatisena konkreetse rahasumma deponeerimist võrguettevõtja arveldusarvele või krediidiasutuse või kindlustusandja garantii esitamist. Tagatist tuleb nõuda kõigilt pakkujatelt samas ulatuses. Pakkumiskutses ettenähtud juhul ja tingimustel võib võrguettevõtja nõuda pakkumise tagatisena konkreetse rahasumma deponeerimist võrguettevõtja arveldusarvele või krediidiasutuse või kindlustusandja garantii esitamist. Tagatist tuleb nõuda kõigilt pakkujatelt samas ulatuses. 2 (2) Võrguettevõtja tagastab pakkumise tagatise pakkujale kolme tööpäeva jooksul pärast: 1 1) konkursi võitjaga sõlmitava lepingu jõustumist; 2 2) pakkumise jõusoleku tähtaja lõppemist; 3 3) konkursi kehtetuks tunnistamist; 4 4) pakkumise tagasivõtmist. Võrguettevõtja tagastab pakkumise tagatise pakkujale kolme tööpäeva jooksul pärast: konkursi võitjaga sõlmitava lepingu jõustumist; pakkumise jõusoleku tähtaja lõppemist; konkursi kehtetuks tunnistamist; pakkumise tagasivõtmist. 3 (3) Pakkumise tagatist ei tagastata või see realiseeritakse, kui võitjaks tunnistatud pakkuja võtab pakkumise selle jõusoleku tähtaja jooksul tagasi või kui võitjaks tunnistatud pakkuja loobub õigusest lepingut sõlmida. Pakkumise tagatist ei tagastata või see realiseeritakse, kui võitjaks tunnistatud pakkuja võtab pakkumise selle jõusoleku tähtaja jooksul tagasi või kui võitjaks tunnistatud pakkuja loobub õigusest lepingut sõlmida.",
      "rdfs:label": {
        "@value": "Reg_1001141_Par_7 (redaktsioon 1001141)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001141",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001141",
      "estleg:sourceAct": "Soojuse ostmiseks konkursi korraldamise kord ja pakkumiste hindamise metoodika",
      "estleg:provisionRef": "Reg_1001141 § 7",
