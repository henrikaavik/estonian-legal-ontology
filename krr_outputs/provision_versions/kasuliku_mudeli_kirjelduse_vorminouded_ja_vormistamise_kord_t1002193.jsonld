    {
      "@id": "estleg:Reg_1002193_Par_8_v1002193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002193_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kasuliku mudeli kirjeldusest tehakse vähemalt kaks ärakirja, millest üht kasutatakse kasuliku mudeli tunnistuse koostamiseks ja teine edastatakse avalikustamiseks juriidilisele isikule, kellega riik on sõlminud vastava lepingu. RT I 2013-05-31 2 131052013002 2013-06-03 Kasuliku mudeli kirjeldusest tehakse vähemalt kaks ärakirja, millest üht kasutatakse kasuliku mudeli tunnistuse koostamiseks ja teine edastatakse avalikustamiseks juriidilisele isikule, kellega riik on sõlminud vastava lepingu. 2 (2) Patendiamet võib valmistada kasuliku mudeli kirjeldusest seoses registrist teabe väljastamisega piiranguteta vajaliku arvu ärakirju ja levitada ärakirja avalikes digitaalsetes andmebaasides. Patendiamet võib valmistada kasuliku mudeli kirjeldusest seoses registrist teabe väljastamisega piiranguteta vajaliku arvu ärakirju ja levitada ärakirja avalikes digitaalsetes andmebaasides.",
      "rdfs:label": {
        "@value": "Reg_1002193_Par_8 (redaktsioon 1002193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002193",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002193",
      "estleg:sourceAct": "Kasuliku mudeli kirjelduse vorminõuded ja vormistamise kord",
      "estleg:provisionRef": "Reg_1002193 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002193_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1002193_Par_9_v1002193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002193_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kasuliku mudeli kirjeldus avaldatakse kasuliku mudeli registreerimise teate Eesti Kasuliku Mudeli Lehes avaldamise päeval. Kasuliku mudeli kirjeldus avaldatakse kasuliku mudeli registreerimise teate Eesti Kasuliku Mudeli Lehes avaldamise päeval. 2 (2) Juriidiline isik, kellega riik on sõlminud vastava lepingu, paneb kasuliku mudeli registreerimise teate Eesti Kasuliku Mudeli Lehes avaldamise päeval avalikuks tutvumiseks välja vähemalt ühe eksemplari kasuliku mudeli kirjelduse ärakirja. RT I 2013-05-31 2 131052013002 2013-06-03 Juriidiline isik, kellega riik on sõlminud vastava lepingu, paneb kasuliku mudeli registreerimise teate Eesti Kasuliku Mudeli Lehes avaldamise päeval avalikuks tutvumiseks välja vähemalt ühe eksemplari kasuliku mudeli kirjelduse ärakirja.",
      "rdfs:label": {
