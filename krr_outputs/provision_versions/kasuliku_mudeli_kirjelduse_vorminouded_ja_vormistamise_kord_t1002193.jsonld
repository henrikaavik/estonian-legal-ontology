      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kasuliku mudeli kirjelduse vorminõuded ja vormistamise kord (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kasuliku mudeli kirjelduse vorminõuded ja vormistamise kord"
    },
    {
      "@id": "estleg:Reg_1002193_Par_1_v1002193",
      "@type": [
        "owl:NamedIndividual",
