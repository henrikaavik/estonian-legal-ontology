      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meetme raames ettevõtjale antav toetus on regionaalabi Euroopa Komisjoni juhiste riigipoolse regionaalabi andmiseks (ELT C 74, 10.03.1998) mõistes. Meetme raames ettevõtjale antav toetus on regionaalabi Euroopa Komisjoni juhiste riigipoolse regionaalabi andmiseks (ELT C 74, 10.03.1998) mõistes.",
      "rdfs:label": {
