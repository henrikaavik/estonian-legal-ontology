      }
    },
    {
      "@id": "estleg:Reg_158197_Par_29_v158197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158197_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA järelevalveametnikul on õigus «Struktuuritoetuse seaduse» § 25 lõike 1 punkti 5 alusel ja korras teha toetuse saajale järelevalve käigus avastatud puuduse kõrvaldamiseks ettekirjutus. PRIA järelevalveametnikul on õigus «Struktuuritoetuse seaduse» § 25 lõike 1 punkti 5 alusel ja korras teha toetuse saajale järelevalve käigus avastatud puuduse kõrvaldamiseks ettekirjutus.",
      "rdfs:label": {
        "@value": "Reg_158197_Par_29 (redaktsioon 158197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158197",
