      }
    },
    {
      "@id": "estleg:Reg_158197_Par_18_v158197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158197_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluse hindamisel arvestatavad hindamiskriteeriumid on: 1 1) kavandatava investeeringuobjekti sobivus meetme eesmärkidega, sealhulgas investeeringuobjekti kulutõhusus; 2 2) investeeringuobjekti vastavus asjaomase maapiirkonna arenguvajadustele. Taotluse hindamisel arvestatavad hindamiskriteeriumid on: kavandatava investeeringuobjekti sobivus meetme eesmärkidega, sealhulgas investeeringuobjekti kulutõhusus; investeeringuobjekti vastavus asjaomase maapiirkonna arenguvajadustele. 2 (2) Lõikes 1 nimetatud hindamiskriteeriumidele vastavuse hindamiseks annavad komisjoni liikmed hindepunkte, võrreldes selleks ka avalduses ja arengukava lühikokkuvõttes märgitud andmeid omavahel. Lõikes 1 nimetatud hindamiskriteeriumidele vastavuse hindamiseks annavad komisjoni liikmed hindepunkte, võrreldes selleks ka avalduses ja arengukava lühikokkuvõttes märgitud andmeid omavahel.",
      "rdfs:label": {
        "@value": "Reg_158197_Par_18 (redaktsioon 158197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158197",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158197",
      "estleg:sourceAct": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks - ühtne programmdokument aastateks 2004-2006\" meetme 3.5 \"Külade taastamine ja arendamine\" tingimused\"",
      "estleg:provisionRef": "Reg_158197 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158197_Map"
      }
    },
    {
      "@id": "estleg:Reg_158197_Par_19_v158197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158197_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hinnangu andmise korral investeeringuobjekti sobivusele meetme eesmärkidega on maksimaalselt võimalik anda: 1 1) kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt suurendab piirkonna elukvaliteeti; 2 2) kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt suurendab elukeskkonna atraktiivsust; 3 3) kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt suurendab piirkonna elanike omaalgatust ja võimalust teha koostööd ning tugevdab sotsiaalseid suhteid; 4 4) kuni 10 hindepunkti lähtuvalt sellest, millisel määral on piirkondliku arengukava koostamise protsessi kaasatud piirkonna elanikud; 5 5) kuni 15 hindepunkti lähtuvalt sellest, millisel määral on investeeringuobjekti kavandatav majandamine tegelikkuses teostatav; 6 6) kuni 15 hindepunkti lähtuvalt sellest, millisel määral on investeeringuobjekti kavandatav kasutajate arv vastavuses investeeringuobjektile tehtavate kulutustega. Hinnangu andmise korral investeeringuobjekti sobivusele meetme eesmärkidega on maksimaalselt võimalik anda: kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt suurendab piirkonna elukvaliteeti; kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt suurendab elukeskkonna atraktiivsust; kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt suurendab piirkonna elanike omaalgatust ja võimalust teha koostööd ning tugevdab sotsiaalseid suhteid; kuni 10 hindepunkti lähtuvalt sellest, millisel määral on piirkondliku arengukava koostamise protsessi kaasatud piirkonna elanikud; kuni 15 hindepunkti lähtuvalt sellest, millisel määral on investeeringuobjekti kavandatav majandamine tegelikkuses teostatav; kuni 15 hindepunkti lähtuvalt sellest, millisel määral on investeeringuobjekti kavandatav kasutajate arv vastavuses investeeringuobjektile tehtavate kulutustega.",
      "rdfs:label": {
        "@value": "Reg_158197_Par_19 (redaktsioon 158197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158197",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158197",
      "estleg:sourceAct": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks - ühtne programmdokument aastateks 2004-2006\" meetme 3.5 \"Külade taastamine ja arendamine\" tingimused\"",
      "estleg:provisionRef": "Reg_158197 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158197_Map"
      }
    },
