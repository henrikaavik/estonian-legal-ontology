      ],
      "estleg:versionOf": {
        "@id": "estleg:RLS_Par_60_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2011. aasta 31. detsembrini on Riigikogu liikme palk Eesti keskmise palga ning käesoleva seaduse §-s 29 sätestatud vastava koefitsiendi korrutis, kuid mitte suurem kui 2009. aasta neljanda kvartali Eesti keskmise palga ning käesoleva seaduse §-s 29 sätestatud vastava koefitsiendi korrutis. - jõustub Riigikogu XII koosseisu volituste alguspäeval.",
      "rdfs:label": {
        "@value": "RLS_Par_60_1 (redaktsioon 122122014010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122014010",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122014010",
      "estleg:sourceAct": "Riigikogu liikme staatuse seadus",
      "estleg:provisionRef": "RLS § 60_1",
      "estleg:partOfAct": {
        "@id": "estleg:RLS_Map"
      }
    },
    {
      "@id": "estleg:RLS_Par_60_2_v130122024019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RLS_Par_60_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2025. aasta 1. jaanuarist kuni Riigikogu XV koosseisu volituste lõpuni hüvitatakse Riigikogu liikmele kuludokumentide alusel tööga seotud kulutused kuni 25% Riigikogu liikme ametipalgast Riigikogu juhatuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "RLS_Par_60_2 (redaktsioon 130122024019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122024019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122024019",
      "estleg:sourceAct": "Riigikogu liikme staatuse seadus",
      "estleg:provisionRef": "RLS § 60_2",
      "estleg:partOfAct": {
        "@id": "estleg:RLS_Map"
      }
    },
    {
      "@id": "estleg:RLS_Par_61_v12846051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RLS_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 10. päeval pärast Riigi Teatajas avaldamist. (2) Käesoleva seaduse § 19 jõustub 2008. aasta 1. jaanuaril. (3) Käesoleva seaduse § 31 lõige 2 ning 9. peatükk jõustuvad Riigikogu XII koosseisu volituste alguspäeval. (4) Käesoleva seaduse § 31 lõige 1 tunnistatakse kehtetuks alates Riigikogu XII koosseisu volituste alguspäevast.",
      "rdfs:label": {
        "@value": "RLS_Par_61 (redaktsioon 12846051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12846051",
