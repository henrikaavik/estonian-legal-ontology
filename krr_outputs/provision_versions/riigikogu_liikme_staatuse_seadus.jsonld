      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liige ei või oma volituste ajal olla riigi osalusega äriühingu või riigi asutatud sihtasutuse juht ega juhatuse liige.",
      "rdfs:label": {
        "@value": "RLS_Par_28 (redaktsioon 12846051)",
