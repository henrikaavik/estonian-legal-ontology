        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12846051",
      "estleg:sourceAct": "Riigikogu liikme staatuse seadus",
      "estleg:provisionRef": "RLS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:RLS_Map"
      }
    },
    {
      "@id": "estleg:RLS_Par_29_v122122011040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RLS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu liikmete ametipalk määratakse kõrgemate riigiteenijate ametipalkade seadusega. (2) Kehtetu - (3) Kehtetu - (4) Kehtetu - (5) Kehtetu - (6) Kehtetu - (7) Kehtetu - (8) Riigikogu liikmele makstakse palka alates ametivande andmise päevast.",
