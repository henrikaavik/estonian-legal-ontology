    },
    {
      "@id": "estleg:RLS_Par_61_v129122010094",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RLS_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 10. päeval pärast Riigi Teatajas avaldamist. (2) Käesoleva seaduse § 19 jõustub 2008. aasta 1. jaanuaril. (3) Käesoleva seaduse § 31 lõige 2 jõustub Riigikogu XII koosseisu volituste alguspäeval 27.03.2011. (4) Käesoleva seaduse § 31 lõige 1 tunnistatakse kehtetuks alates Riigikogu XII koosseisu volituste alguspäevast 27.03.2011.",
