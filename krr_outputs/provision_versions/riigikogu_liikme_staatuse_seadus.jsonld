      "estleg:provisionRef": "RLS § 59",
      "estleg:partOfAct": {
        "@id": "estleg:RLS_Map"
      }
    },
    {
      "@id": "estleg:RLS_Par_59_v13154183",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
