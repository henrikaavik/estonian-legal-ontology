      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liikmele hüvitatakse kuludokumentide alusel tööga seotud kulutused kuni 30% Riigikogu liikme ametipalgast Riigikogu juhatuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "RLS_Par_30 (redaktsioon 12846051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12846051",
