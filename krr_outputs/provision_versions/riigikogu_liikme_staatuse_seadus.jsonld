      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12846051",
      "estleg:sourceAct": "Riigikogu liikme staatuse seadus",
      "estleg:provisionRef": "RLS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:RLS_Map"
      }
    },
    {
      "@id": "estleg:RLS_Par_30_v13154183",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RLS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liikmele hüvitatakse kuludokumentide alusel tööga seotud kulutused kuni 30% Riigikogu liikme ametipalgast Riigikogu juhatuse kehtestatud korras. Riigikogu XI koosseisu volituste lõppemiseni hüvitatakse Riigikogu liikmele kuludokumentide alusel tööga seotud kulutused kuni 10% Riigikogu liikme ametipalgast Riigikogu juhatuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "RLS_Par_30 (redaktsioon 13154183)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13154183",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13154183",
      "estleg:sourceAct": "Riigikogu liikme staatuse seadus",
      "estleg:provisionRef": "RLS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:RLS_Map"
      }
    },
    {
      "@id": "estleg:RLS_Par_31_v12846051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RLS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väljaspool Tallinna ja Tallinnaga piirnevaid kohalikke omavalitsusüksusi elavad Riigikogu liikmed kindlustatakse vajaduse korral elamispinnaga Riigikogu juhatuse kehtestatud ulatuses ja korras. (2) Riigikogu liikmele, kes Rahvastikuregistrisse kantud elukohaandmete järgi elab väljaspool Tallinna ja Tallinnaga piirnevaid kohaliku omavalitsuse üksusi, makstakse tema sooviavalduse alusel eluasemekulude hüvitamiseks iga kuu summa, mille suurus on 20% Riigikogu liikme ametipalgast.",
      "rdfs:label": {
        "@value": "RLS_Par_31 (redaktsioon 12846051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12846051",
      "estleg:supersededByVersion": {
        "@id": "estleg:RLS_Par_31_v13154183"
      },
      "estleg:versionValidTo": {
        "@value": "2009-02-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12846051",
      "estleg:sourceAct": "Riigikogu liikme staatuse seadus",
      "estleg:provisionRef": "RLS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:RLS_Map"
      }
    },
    {
      "@id": "estleg:RLS_Par_31_v13154183",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
