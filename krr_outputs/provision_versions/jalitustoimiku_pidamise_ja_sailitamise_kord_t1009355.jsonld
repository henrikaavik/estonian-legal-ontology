        "@id": "estleg:Reg_1009355_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009355_Par_3_v1009355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009355_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jälitustoimiku number koosneb 10-kohalisest numbrist, kus kaks esimest näitavad aastat, kolm järgmist jälitusasutuse koodi ning viis viimast jälitustoimiku järjekorra numbrit. Jälitustoimikutel võib kasutada tingnimetusi. Jälitustoimiku number koosneb 10-kohalisest numbrist, kus kaks esimest näitavad aastat, kolm järgmist jälitusasutuse koodi ning viis viimast jälitustoimiku järjekorra numbrit. Jälitustoimikutel võib kasutada tingnimetusi. 2 (2) Jälitusasutuste koodid on järgmised: 1 1) Kaitsepolitseiamet – 100; 2 2) Politsei- ja Piirivalveamet – 200; 3 3) Maksu- ja Tolliamet – 300; 4 4) Sõjaväepolitsei – 400; 5 5) Justiitsministeeriumi vanglate osakond ja vangla – 500. Jälitusasutuste koodid on järgmised: Kaitsepolitseiamet – 100; Politsei- ja Piirivalveamet – 200; Maksu- ja Tolliamet – 300; Sõjaväepolitsei – 400; Justiitsministeeriumi vanglate osakond ja vangla – 500. 3 (3) Jälitusasutuse juht võib oma käskkirjaga kinnitada lõikes 2 nimetatud jälitusasutuse koodi kahe viimase numbri jaotuse oma struktuuriüksuste vahel. Jälitusasutuse juht võib oma käskkirjaga kinnitada lõikes 2 nimetatud jälitusasutuse koodi kahe viimase numbri jaotuse oma struktuuriüksuste vahel. 4 (4) Jälitustoimikud registreeritakse ning nende üle peetakse arvestust jälitusasutuse juhi kehtestatud korras. Jälitustoimikud registreeritakse ning nende üle peetakse arvestust jälitusasutuse juhi kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1009355_Par_3 (redaktsioon 1009355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009355",
