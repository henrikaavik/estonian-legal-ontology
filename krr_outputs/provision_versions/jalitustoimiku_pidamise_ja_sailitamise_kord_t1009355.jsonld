    },
    {
      "@id": "estleg:Reg_1009355_Par_1_v1009355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009355_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse jälitusasutuses jälitustoimiku pidamise ja säilitamise kord. Määrusega kehtestatakse jälitusasutuses jälitustoimiku pidamise ja säilitamise kord. 2 (2) Määrust ei kohaldata tunnistajakaitse seaduse ja selle alusel kehtestatud õigusaktides sätestatud korras tunnistajakaitse teostamisel jälitustoimingutega kogutud teabe säilitamisel. Määrust ei kohaldata tunnistajakaitse seaduse ja selle alusel kehtestatud õigusaktides sätestatud korras tunnistajakaitse teostamisel jälitustoimingutega kogutud teabe säilitamisel.",
      "rdfs:label": {
        "@value": "Reg_1009355_Par_1 (redaktsioon 1009355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009355",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009355",
      "estleg:sourceAct": "Jälitustoimiku pidamise ja säilitamise kord",
      "estleg:provisionRef": "Reg_1009355 § 1",
      "estleg:partOfAct": {
