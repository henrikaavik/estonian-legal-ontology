      "estleg:provisionRef": "Reg_1009355 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009355_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009355_Par_4_v1009355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009355_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jälitustoimik suletakse kriminaalmenetluse seadustiku § 1262 lõike 1 punktides 1–4 nimetatud aluse äralangemise korral. Jälitustoimik suletakse kriminaalmenetluse seadustiku § 1262 lõike 1 punktides 1–4 nimetatud aluse äralangemise korral. 2 (2) Jälitustoimiku sulgemine vormistatakse kirjalikult, märkides ära vähemalt järgmised andmed: 1 1) jälitustoimiku sulgemise kuupäev; 2 2) paragrahvi 2 lõikes 2 loetletud andmed; 3 3) jälitustoimiku sulgemise alus. Jälitustoimiku sulgemine vormistatakse kirjalikult, märkides ära vähemalt järgmised andmed: jälitustoimiku sulgemise kuupäev; paragrahvi 2 lõikes 2 loetletud andmed; jälitustoimiku sulgemise alus.",
      "rdfs:label": {
        "@value": "Reg_1009355_Par_4 (redaktsioon 1009355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009355",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009355",
      "estleg:sourceAct": "Jälitustoimiku pidamise ja säilitamise kord",
      "estleg:provisionRef": "Reg_1009355 § 4",
      "estleg:partOfAct": {
