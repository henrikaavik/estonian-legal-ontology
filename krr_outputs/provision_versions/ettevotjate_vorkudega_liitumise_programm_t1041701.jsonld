      "estleg:provisionRef": "Reg_1041701 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041701_Map"
      }
    },
    {
      "@id": "estleg:Reg_1041701_Par_9_v1041701",
      "@type": [
        "owl:NamedIndividual",
