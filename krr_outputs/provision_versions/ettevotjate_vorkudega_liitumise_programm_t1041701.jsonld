    {
      "@id": "estleg:Reg_1041701_Par_10_v1041701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041701_Par_10"
