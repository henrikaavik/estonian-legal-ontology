      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse maksimaalne suurus projekti kohta on 100 000 eurot. Toetuse maksimaalne suurus projekti kohta on 100 000 eurot. 2 (2) Toetuse minimaalne suurus projekti kohta on 5000 eurot. Toetuse minimaalne suurus projekti kohta on 5000 eurot. 3 (3) Taotleja omafinantseering peab moodustama vähemalt 40 protsenti projekti abikõlblikest kuludest ja toetuse määr on kuni 60 protsenti abikõlblikest kuludest. Taotleja omafinantseering peab moodustama vähemalt 40 protsenti projekti abikõlblikest kuludest ja toetuse määr on kuni 60 protsenti abikõlblikest kuludest. 4 (4) Omafinantseeringu hulka arvatakse vaid toetuse saaja tehtavad abikõlblikud kulud. Omafinantseeringu hulka arvatakse vaid toetuse saaja tehtavad abikõlblikud kulud.",
      "rdfs:label": {
        "@value": "Reg_1041701_Par_6 (redaktsioon 1041701)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041701",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041701",
      "estleg:sourceAct": "Ettevõtjate võrkudega liitumise programm",
