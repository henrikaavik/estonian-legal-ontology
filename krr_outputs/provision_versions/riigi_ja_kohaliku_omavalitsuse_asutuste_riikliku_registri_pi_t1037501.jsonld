        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse riigi- ja kohaliku omavalitsuse asutuste riikliku registri (edaspidi register) pidamise kord. Käesoleva määrusega kehtestatakse riigi- ja kohaliku omavalitsuse asutuste riikliku registri (edaspidi register) pidamise kord.",
      "rdfs:label": {
        "@value": "Reg_1037501_Par_1 (redaktsioon 1037501)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037501",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037501",
      "estleg:sourceAct": "Riigi- ja kohaliku omavalitsuse asutuste riikliku registri pidamise kord",
      "estleg:provisionRef": "Reg_1037501 § 1",
      "estleg:partOfAct": {
