      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärnu maakonnas asuva Põhja-Pärnumaa valla ja Tori valla piiri muudetakse järgmiselt: 1 1) Põhja-Pärnumaa valla Kangru küla katastriüksus antakse Tori valla Parisselja küla koosseisu ja Põhja-Pärnumaa valla Tarva küla katastriüksus antakse Tori valla Elbu küla koosseisu vastavalt määruse lisale 1; 2 2) Tori valla Elbi küla katastriüksused antakse Põhja-Pärnumaa valla Viluvere küla koosseisu vastavalt määruse lisale 2. Pärnu maakonnas asuva Põhja-Pärnumaa valla ja Tori valla piiri muudetakse järgmiselt: Põhja-Pärnumaa valla Kangru küla katastriüksus antakse Tori valla Parisselja küla koosseisu ja Põhja-Pärnumaa valla Tarva küla katastriüksus antakse Tori valla Elbu küla koosseisu vastavalt määruse lisale 1; Tori valla Elbi küla katastriüksused antakse Põhja-Pärnumaa valla Viluvere küla koosseisu vastavalt määruse lisale 2.",
      "rdfs:label": {
        "@value": "Reg_1060033_Par_1 (redaktsioon 1060033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060033",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060033",
      "estleg:sourceAct": "Haldusüksuste piiride muutmine Pärnu maakonna Põhja-Pärnumaa vallas ja Tori vallas territooriumiosa üleandmisega",
      "estleg:provisionRef": "Reg_1060033 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060033_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060033_Par_2_v1060033",
