        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122011053",
      "estleg:sourceAct": "Kaubandusliku meresõidu seadus",
      "estleg:provisionRef": "KMSS § 124_1",
      "estleg:partOfAct": {
        "@id": "estleg:KMSS_Map"
      }
    },
    {
      "@id": "estleg:KMSS_Par_124_1_v130052013008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
