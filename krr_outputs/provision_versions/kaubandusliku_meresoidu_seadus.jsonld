    {
      "@id": "estleg:KMSS_Par_71_v117032023047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSS_Par_71"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 250-se kogumahutavusega laeva vastutuse piirmäär on vastavalt merinõuete korral vastutuse piiramise konventsiooni artikli 6 lõike 1 punktile b pool kuni 500-se kogumahutavusega laeva vastutuse piirmäärast.",
      "rdfs:label": {
        "@value": "KMSS_Par_71 (redaktsioon 117032023047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023047",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032023047",
