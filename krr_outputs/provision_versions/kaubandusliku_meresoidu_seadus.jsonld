      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reisijate veo eest ilma nõuetele vastava vastutuskindlustuse või muu rahalise tagatiseta –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "KMSS_Par_124_3 (redaktsioon 130052013008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130052013008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130052013008",
