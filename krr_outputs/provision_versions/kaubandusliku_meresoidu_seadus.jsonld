    {
      "@id": "estleg:KMSS_Par_77_5_v130052013008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSS_Par_77_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 774 lõikes 1 sätestatud tingimuste kohase vastutuskindlustuse või muu rahalise tagatise olemasolu ja kehtivuse tõendamiseks peab rahvusvahelise reisijateveo puhul Veeteede Ametilt taotlema asjaomast tõendit. Kui vastutuskindlustusleping või muu rahalise tagatise leping vastab käesoleva seaduse § 774 lõikes 1 sätestatud tingimustele, väljastab Veeteede Amet tõendi vastutuskindlustuse või muu rahalise tagatise olemasolu ja kehtivuse kohta (edaspidi vastutuskindlustuse või muu rahalise tagatise tõend). Tingimustele mittevastamise korral keeldub Veeteede Amet tõendi väljastamisest. (2) Vastutuskindlustuse või muu rahalise tagatise tõend antakse tähtajaks, mis ei saa olla pikem kui selle väljastamise aluseks oleva vastutuskindlustuslepingu või muu rahalise tagatise lepingu kehtivusaeg. (3) Vastutuskindlustuse või muu rahalise tagatise tõendi taotlemise, andmise, kehtetuks tunnistamise ja hoidmise korra ning tõendi vormi määrusega. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „majandus- ja kommunikatsiooniminister“ sõnadega „valdkonna eest vastutav minister“. (4) Vastutuskindlustuse või muu rahalise tagatise tõendi taotluse läbivaatamise eest tuleb tasuda riigilõivu.",
      "rdfs:label": {
        "@value": "KMSS_Par_77_5 (redaktsioon 130052013008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130052013008",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSS_Par_77_5_v112122018042"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130052013008",
      "estleg:sourceAct": "Kaubandusliku meresõidu seadus",
      "estleg:provisionRef": "KMSS § 77_5",
      "estleg:partOfAct": {
        "@id": "estleg:KMSS_Map"
      }
    },
