    {
      "@id": "estleg:KMSS_Par_124_1_v130122011053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSS_Par_124_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seadusega ettenähtud kindlustuspoliisita laeva kasutamise eest – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "KMSS_Par_124_1 (redaktsioon 130122011053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011053",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSS_Par_124_1_v130052013008"
      },
