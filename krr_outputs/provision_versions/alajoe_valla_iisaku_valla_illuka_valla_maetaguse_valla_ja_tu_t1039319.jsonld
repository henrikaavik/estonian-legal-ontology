      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Alajõe valla, Iisaku valla, Illuka valla, Mäetaguse valla ja Tudulinna valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ muutmine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Alajõe valla, Iisaku valla, Illuka valla, Mäetaguse valla ja Tudulinna valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ muutmine"
    },
    {
      "@id": "estleg:Reg_1039319_Par_1_v1039319",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039319_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Alajõe valla, Iisaku valla, Illuka valla, Mäetaguse valla ja Tudulinna valla ühinemise teel moodustatakse uus haldusüksus. Alajõe valla, Iisaku valla, Illuka valla, Mäetaguse valla ja Tudulinna valla ühinemise teel moodustatakse uus haldusüksus. 2 (2) Uue haldusüksuse nimeks määratakse Alutaguse vald. Uue haldusüksuse nimeks määratakse Alutaguse vald. 3 (3) Haldusterritoriaalse korralduse ja haldusüksuse piiride muutmise põhjendused on esitatud määruse seletuskirjas1. Haldusterritoriaalse korralduse ja haldusüksuse piiride muutmise põhjendused on esitatud määruse seletuskirjas1.",
      "rdfs:label": {
        "@value": "Reg_1039319_Par_1 (redaktsioon 1039319)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039319",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039319",
      "estleg:sourceAct": "Alajõe valla, Iisaku valla, Illuka valla, Mäetaguse valla ja Tudulinna valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ muutmine",
      "estleg:provisionRef": "Reg_1039319 § 1",
