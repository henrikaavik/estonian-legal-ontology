    {
      "@id": "estleg:Reg_1039319_Par_2_v1039319",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039319_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatava Alutaguse valla piiriks on senise Alajõe valla, Iisaku valla, Illuka valla, Mäetaguse valla ja Tudulinna valla piir, välja arvatud nende omavahelises osas. Haldusterritoriaalse korralduse muutmise käigus moodustatava Alutaguse valla piiriks on senise Alajõe valla, Iisaku valla, Illuka valla, Mäetaguse valla ja Tudulinna valla piir, välja arvatud nende omavahelises osas. 2 (2) Maa-amet kannab Alutaguse valla piiri riigi maakatastri kaardile. Maa-amet kannab Alutaguse valla piiri riigi maakatastri kaardile.",
      "rdfs:label": {
        "@value": "Reg_1039319_Par_2 (redaktsioon 1039319)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039319",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039319",
      "estleg:sourceAct": "Alajõe valla, Iisaku valla, Illuka valla, Mäetaguse valla ja Tudulinna valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ muutmine",
      "estleg:provisionRef": "Reg_1039319 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039319_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039319_Par_3_v1039319",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039319_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatavale Alutaguse vallale makstakse ühinemistoetust haldusreformi seaduse §-des 20‒23 sätestatud korras. Haldusterritoriaalse korralduse muutmise käigus moodustatavale Alutaguse vallale makstakse ühinemistoetust haldusreformi seaduse §-des 20‒23 sätestatud korras. 2 (2) Ühinemistoetust arvutatakse senise Alajõe valla, Iisaku valla, Mäetaguse valla ja Tudulinna valla volikogu algatatud haldusterritoriaalse korralduse muutmist taotlenud Alajõe valla, Iisaku valla, Mäetaguse valla ja Tudulinna valla elanike arvu põhjal rahvastikuregistri andmetel 1. jaanuari 2017. a seisuga. Ühinemistoetust arvutatakse senise Alajõe valla, Iisaku valla, Mäetaguse valla ja Tudulinna valla volikogu algatatud haldusterritoriaalse korralduse muutmist taotlenud Alajõe valla, Iisaku valla, Mäetaguse valla ja Tudulinna valla elanike arvu põhjal rahvastikuregistri andmetel 1. jaanuari 2017. a seisuga. 3 (3) Käesoleva määrusega haldusterritoriaalse korralduse muutmise tulemusena moodustatavale Alutaguse vallale hüvitatakse riigieelarvest Vabariigi Valitsuse algatatud ühinemisega seotud tegelikud tehtud kulud kuludokumentide alusel haldusreformi seaduse § 24 lõike 2 alusel kehtestatud korras. Käesoleva määrusega haldusterritoriaalse korralduse muutmise tulemusena moodustatavale Alutaguse vallale hüvitatakse riigieelarvest Vabariigi Valitsuse algatatud ühinemisega seotud tegelikud tehtud kulud kuludokumentide alusel haldusreformi seaduse § 24 lõike 2 alusel kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1039319_Par_3 (redaktsioon 1039319)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039319",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039319",
      "estleg:sourceAct": "Alajõe valla, Iisaku valla, Illuka valla, Mäetaguse valla ja Tudulinna valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ muutmine",
      "estleg:provisionRef": "Reg_1039319 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039319_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039319_Par_4_v1039319",
      "@type": [
