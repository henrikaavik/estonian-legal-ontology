      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliameti peadirektori moodustatud komisjon kontrollib erivahendite olemasolu, hoidmist ja arvestust vähemalt üks kord aastas ning rakendab vajalikke meetmeid avastatud puuduste kõrvaldamiseks. Maksu- ja Tolliameti peadirektori moodustatud komisjon kontrollib erivahendite olemasolu, hoidmist ja arvestust vähemalt üks kord aastas ning rakendab vajalikke meetmeid avastatud puuduste kõrvaldamiseks.",
      "rdfs:label": {
        "@value": "Reg_1039253_Par_5 (redaktsioon 1039253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039253",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039253",
