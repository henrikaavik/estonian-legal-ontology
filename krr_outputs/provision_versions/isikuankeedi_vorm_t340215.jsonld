      }
    },
    {
      "@id": "estleg:Reg_340215_Par_2_v340215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_340215_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isikuankeete hoitakse vastavalt Politsei- ja Piirivalveameti või Kaitsepolitseiameti valve- ja tulekahjusignalisatsiooniga varustatud ruumis, tulekindlas seifis või tulekahjusignalisatsiooniga varustatud ruumis asuvas raudkapis. Isikuankeete hoitakse vastavalt Politsei- ja Piirivalveameti või Kaitsepolitseiameti valve- ja tulekahjusignalisatsiooniga varustatud ruumis, tulekindlas seifis või tulekahjusignalisatsiooniga varustatud ruumis asuvas raudkapis. 2 (2) Isikuankeedis küsitud andmeid säilitatakse viis aastat isiku politseiteenistusse kandideerimisest või politseiteenistusest lahkumisest. RT I 2018-09-18 1 118092018001 2018-09-21 Isikuankeedis küsitud andmeid säilitatakse viis aastat isiku politseiteenistusse kandideerimisest või politseiteenistusest lahkumisest.",
      "rdfs:label": {
