      },
      "estleg:versionText": "Järelevalvet registri pidamise üle teostavad registri vastutav töötleja, Andmekaitse Inspektsioon ja avaliku teabe seaduse § 531 lõikes 1 nimetatud asutus oma pädevuse piires. Järelevalvet registri pidamise üle teostavad registri vastutav töötleja, Andmekaitse Inspektsioon ja avaliku teabe seaduse § 531 lõikes 1 nimetatud asutus oma pädevuse piires.",
      "rdfs:label": {
        "@value": "Reg_1041520_Par_14 (redaktsioon 1041520)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041520",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041520",
