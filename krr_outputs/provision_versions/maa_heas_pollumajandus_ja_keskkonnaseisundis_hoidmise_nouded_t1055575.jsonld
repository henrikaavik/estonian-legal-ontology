      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Maa heas põllumajandus- ja keskkonnaseisundis hoidmise nõuded, kohustuslikud majandamisnõuded ning töö- ja tööhõivetingimustega seotud nõuded ja tööandja kohustused (13 versiooni)",
        "@language": "et"
      },
      "dc:source": "Maa heas põllumajandus- ja keskkonnaseisundis hoidmise nõuded, kohustuslikud majandamisnõuded ning töö- ja tööhõivetingimustega seotud nõuded ja tööandja kohustused"
    },
    {
      "@id": "estleg:Reg_1055575_Par_1_v1055575",
      "@type": [
