      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 16. märtsi 2020. a käskkirjaga nr 1-2/20/121 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 16. märtsi 2020. a käskkirjaga nr 1-2/20/121 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1053338_Par_19 (redaktsioon 1053338)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053338",
