        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1053338_Par_3 (redaktsioon 1053338)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053338",
