      "estleg:sourceAct": "Mukri looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053338 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053338_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053338_Par_3_v1053338",
