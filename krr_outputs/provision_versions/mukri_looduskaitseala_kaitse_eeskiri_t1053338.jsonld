    {
      "@id": "estleg:Reg_1053338_Par_2_v1053338",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053338_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Rapla maakonnas Kehtna vallas Ellamaa, Koogiste, Kõrbja, Mukri, Reonda ja Saarepõllu külas ning Pärnu maakonnas Põhja-Pärnumaa vallas Kobra külas. Kaitseala asub Rapla maakonnas Kehtna vallas Ellamaa, Koogiste, Kõrbja, Mukri, Reonda ja Saarepõllu külas ning Pärnu maakonnas Põhja-Pärnumaa vallas Kobra külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1053338_Par_2 (redaktsioon 1053338)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053338",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053338",
      "estleg:sourceAct": "Mukri looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053338 § 2",
