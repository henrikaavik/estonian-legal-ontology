    {
      "@id": "estleg:Reg_1039595_Par_6_v1039595",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039595_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vaidlustuskomisjoni põhiülesanne on vaidlustusmenetluse läbiviimine, sh vaidlustuste ja kahju hüvitamise taotluste läbi vaatamine riigihangete seaduses sätestatud korras. Vaidlustuskomisjoni põhiülesanne on vaidlustusmenetluse läbiviimine, sh vaidlustuste ja kahju hüvitamise taotluste läbi vaatamine riigihangete seaduses sätestatud korras. 2 (2) Lisaks riigihangete seaduses sätestatule oma ülesannete täitmiseks vaidlustuskomisjon: 1 1) teeb koostööd valitsusasutuste ja valitsusasutuste hallatavate riigiasutuste, kohaliku omavalitsuse üksuste ning erialaliitude ja -ühendustega, samuti teiste riikide vastavate asutuste ja rahvusvaheliste organisatsioonidega oma pädevuse piires; 2 2) vastab oma tegevuse osas esitatud avaldustele, märgukirjadele ja teabenõuetele; 3 3) täidab muid talle õigusaktidega pandud ülesandeid. Lisaks riigihangete seaduses sätestatule oma ülesannete täitmiseks vaidlustuskomisjon: teeb koostööd valitsusasutuste ja valitsusasutuste hallatavate riigiasutuste, kohaliku omavalitsuse üksuste ning erialaliitude ja -ühendustega, samuti teiste riikide vastavate asutuste ja rahvusvaheliste organisatsioonidega oma pädevuse piires; vastab oma tegevuse osas esitatud avaldustele, märgukirjadele ja teabenõuetele; täidab muid talle õigusaktidega pandud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_1039595_Par_6 (redaktsioon 1039595)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039595",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039595",
      "estleg:sourceAct": "Riigihangete vaidlustuskomisjoni põhimäärus",
      "estleg:provisionRef": "Reg_1039595 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039595_Map"
      }
    },
