    {
      "@id": "estleg:Reg_1039595_Par_10_v1039595",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039595_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vaidlustuskomisjoni juhataja äraolekul asendab teda valdkonna eest vastutava ministri määratud vaidlustuskomisjoni liige. Vaidlustuskomisjoni juhataja äraolekul asendab teda valdkonna eest vastutava ministri määratud vaidlustuskomisjoni liige. 2 (2) Kuni valdkonna eest vastutava ministri poolt asendaja määramiseni asendab vaidlustuskomisjoni juhatajat vanim kohalolev vaidlustuskomisjoni liige. Kuni valdkonna eest vastutava ministri poolt asendaja määramiseni asendab vaidlustuskomisjoni juhatajat vanim kohalolev vaidlustuskomisjoni liige.",
      "rdfs:label": {
        "@value": "Reg_1039595_Par_10 (redaktsioon 1039595)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039595",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039595",
      "estleg:sourceAct": "Riigihangete vaidlustuskomisjoni põhimäärus",
      "estleg:provisionRef": "Reg_1039595 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039595_Map"
