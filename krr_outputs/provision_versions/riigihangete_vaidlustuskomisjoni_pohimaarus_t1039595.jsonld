    },
    {
      "@id": "estleg:Reg_1039595_Par_11_v1039595",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039595_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vaidlustuskomisjoni istungit juhib vaidlustuskomisjoni liige. Vaidlustuskomisjoni koosseisu istungit juhib vaidlustuskomisjoni juhataja poolt määratud liige. Vaidlustuskomisjoni istungit juhib vaidlustuskomisjoni liige. Vaidlustuskomisjoni koosseisu istungit juhib vaidlustuskomisjoni juhataja poolt määratud liige. 2 (2) Vaidlustuskomisjoni istungil kontrollib vaidlustuskomisjon menetlusosaliste ilmumist ja nende volitusi, selgitab menetlusosalistele nende õigusi, lahendab menetlusosaliste esitatud taandus- ja muud avaldused, kuulab ära menetlusosaliste seisukohad, esitab menetlusosalistele küsimusi ja korraldab menetlusosaliste poolt küsimuste esitamist ja nendele vastamist. Vaidlustuskomisjoni istungil kontrollib vaidlustuskomisjon menetlusosaliste ilmumist ja nende volitusi, selgitab menetlusosalistele nende õigusi, lahendab menetlusosaliste esitatud taandus- ja muud avaldused, kuulab ära menetlusosaliste seisukohad, esitab menetlusosalistele küsimusi ja korraldab menetlusosaliste poolt küsimuste esitamist ja nendele vastamist.",
      "rdfs:label": {
        "@value": "Reg_1039595_Par_11 (redaktsioon 1039595)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039595",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039595",
      "estleg:sourceAct": "Riigihangete vaidlustuskomisjoni põhimäärus",
      "estleg:provisionRef": "Reg_1039595 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039595_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039595_Par_12_v1039595",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039595_Par_12"
      },
