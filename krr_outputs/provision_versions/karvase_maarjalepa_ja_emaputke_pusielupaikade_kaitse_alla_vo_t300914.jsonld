      "estleg:versionText": "«Looduskaitseseaduse» § 21 lõike 1 kohaselt on püsielupaiga valitsejaks Keskkonnaamet. RTL 2009 11 131 13126723 2009-02-01+02:00 «Looduskaitseseaduse» § 21 lõike 1 kohaselt on püsielupaiga valitsejaks Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_300914_Par_3 (redaktsioon 300914)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300914",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300914",
      "estleg:sourceAct": "Karvase maarjalepa ja emaputke püsielupaikade kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_300914 § 3",
