    {
      "@id": "estleg:Reg_1054566_Par_10_v1054566",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054566_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õiglane hüvitis kantakse üle taotluses nimetatud arvelduskontole. Õiglane hüvitis kantakse üle taotluses nimetatud arvelduskontole. 2 (2) Õiglase hüvitise välisriigi krediidiasutuse arvelduskontole või muu makseasutuse kontole maksmise korral ei vastuta haldusorgan ajalise viivituse eest, mis on tekkinud makse tegemise ja arvelduskontole raha laekumise vahel, ega õiglase hüvitise suuruse erinevuse eest, mis on tekkinud välisriigi krediidiasutuse teenustasude maksmise või valuutakursi muutumise tõttu makse tegemise ja selle kontole laekumise vahelisel ajal. Haldusorgan võib vähendada hüvitise summat nende teenustasude võrra, mida tema peab makse tegijana kandma. Õiglase hüvitise välisriigi krediidiasutuse arvelduskontole või muu makseasutuse kontole maksmise korral ei vastuta haldusorgan ajalise viivituse eest, mis on tekkinud makse tegemise ja arvelduskontole raha laekumise vahel, ega õiglase hüvitise suuruse erinevuse eest, mis on tekkinud välisriigi krediidiasutuse teenustasude maksmise või valuutakursi muutumise tõttu makse tegemise ja selle kontole laekumise vahelisel ajal. Haldusorgan võib vähendada hüvitise summat nende teenustasude võrra, mida tema peab makse tegijana kandma.",
      "rdfs:label": {
        "@value": "Reg_1054566_Par_10 (redaktsioon 1054566)",
        "@language": "et"
