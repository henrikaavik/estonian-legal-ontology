      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigikaitseliste kohustuste täitmisega seotud õiglase hüvitise maksmise ‎tingimused ja kord (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigikaitseliste kohustuste täitmisega seotud õiglase hüvitise maksmise ‎tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1054566_Par_1_v1054566",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054566_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega reguleeritakse kõrgendatud kaitsevalmiduse, sõjaseisukorra, mobilisatsiooni või demobilisatsiooni ajal ühekordse töökohustuse, ühekordse riigikaitseülesande täitmise ning isikule kuuluva asja sundkasutusse võtmise või sundvõõrandamise eest õiglase hüvitise (edaspidi õiglane hüvitis) maksmise tingimusi ja korda. Määrusega reguleeritakse kõrgendatud kaitsevalmiduse, sõjaseisukorra, mobilisatsiooni või demobilisatsiooni ajal ühekordse töökohustuse, ühekordse riigikaitseülesande täitmise ning isikule kuuluva asja sundkasutusse võtmise või sundvõõrandamise eest õiglase hüvitise (edaspidi õiglane hüvitis) maksmise tingimusi ja korda. 2 (2) Määrust kohaldatakse sellise isiku suhtes, kellele on seaduse alusel või haldusaktiga pandud ühekordne töökohustus, ühekordse riigikaitseülesande täitmise kohustus või kellele kuuluv asi on võetud sundkasutusse või sundvõõrandatud kõrgendatud kaitsevalmiduse, sõjaseisukorra, mobilisatsiooni või demobilisatsiooni ajal, ja tema õigusjärglasele (edaspidi isik). Määrust kohaldatakse sellise isiku suhtes, kellele on seaduse alusel või haldusaktiga pandud ühekordne töökohustus, ühekordse riigikaitseülesande täitmise kohustus või kellele kuuluv asi on võetud sundkasutusse või sundvõõrandatud kõrgendatud kaitsevalmiduse, sõjaseisukorra, mobilisatsiooni või demobilisatsiooni ajal, ja tema õigusjärglasele (edaspidi isik).",
      "rdfs:label": {
        "@value": "Reg_1054566_Par_1 (redaktsioon 1054566)",
        "@language": "et"
      },
