    {
      "@id": "estleg:ELK_Par_33_v109122010002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Perekonnaliikme tähtajaline elamisõigus lõpeb: tähtajalise elamisõiguse kehtivusaja lõppemisel, alalise elamisõiguse omandamisel, talle Eesti või muu Euroopa Liidu liikmesriigi kodakondsuse andmisel või taastamisel, kui Euroopa Liidu kodanikul, kelle juurde elama asumiseks tähtajaline elamisõigus anti, ei ole Eestis elamisõigust, kui ta ei vasta enam käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele või tema surma või surnuks tunnistamise korral. (2) Politsei- ja Piirivalveamet tunnistab tähtajalise elamisõiguse lõppemisel perekonnaliikme elamisloakaardi kehtetuks.",
      "rdfs:label": {
        "@value": "ELK_Par_33 (redaktsioon 109122010002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109122010002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109122010002",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 33",
      "estleg:partOfAct": {
