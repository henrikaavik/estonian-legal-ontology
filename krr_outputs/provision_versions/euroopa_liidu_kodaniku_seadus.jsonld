    {
      "@id": "estleg:ELK_Par_33_v1034665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Perekonnaliikme tähtajaline elamisõigus lõpeb: tähtajalise elamisõiguse kehtivusaja lõppemisel, alalise elamisõiguse omandamisel, talle Eesti või muu Euroopa Liidu liikmesriigi kodakondsuse andmisel või taastamisel, kui Euroopa Liidu kodanikul, kelle juurde elama asumiseks tähtajaline elamisõigus anti, ei ole Eestis elamisõigust, kui ta ei vasta enam käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele või tema surma või surnuks tunnistamise korral. (2) Kodakondsus- ja Migratsiooniamet tunnistab tähtajalise elamisõiguse lõppemisel perekonnaliikme isikutunnistuse kehtetuks.",
      "rdfs:label": {
        "@value": "ELK_Par_33 (redaktsioon 1034665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034665",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_33_v13253941"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034665",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 33",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
    {
      "@id": "estleg:ELK_Par_33_v13253941",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Perekonnaliikme tähtajaline elamisõigus lõpeb: tähtajalise elamisõiguse kehtivusaja lõppemisel, alalise elamisõiguse omandamisel, talle Eesti või muu Euroopa Liidu liikmesriigi kodakondsuse andmisel või taastamisel, kui Euroopa Liidu kodanikul, kelle juurde elama asumiseks tähtajaline elamisõigus anti, ei ole Eestis elamisõigust, kui ta ei vasta enam käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele või tema surma või surnuks tunnistamise korral. (2) Politsei- ja Piirivalveamet tunnistab tähtajalise elamisõiguse lõppemisel perekonnaliikme isikutunnistuse kehtetuks.",
