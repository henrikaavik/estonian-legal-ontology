      }
    },
    {
      "@id": "estleg:ELK_Par_31_v1034665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kodakondsus- ja Migratsiooniamet keeldub perekonnaliikme tähtajalise elamisõiguse pikendamisest, kui: Euroopa Liidu kodanikul, kelle juurde elama asumiseks tähtajaline elamisõigus anti, ei ole Eestis elamisõigust, on põhjendatud alust arvata, et perekonnaliige ohustab avalikku korda, riigi julgeolekut või teiste isikute tervist või perekonnaliige või Euroopa Liidu kodanik, kelle juurde elama asumiseks tähtajaline elamisõigus anti, on kuritarvitanud selles seaduses ettenähtud õigusi või kasutanud pettust eesmärgiga võimaldada perekonnaliikmel omandada Eestis tähtajalist elamisõigust. (2) Kodakondsus- ja Migratsiooniamet võib perekonnaliikme tähtajalise elamisõiguse pikendamisest keelduda, kui: Euroopa Liidu kodanik, kelle juurde elama asumiseks tähtajaline elamisõigus anti, ei vasta käesoleva seaduse §-s 20 sätestatud eeldusele, tähtajalise elamisõiguse pikendamise taotleja ei vasta enam käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele või perekonnaliige ei ela püsivalt Eestis. (3) Kodakondsus- ja Migratsiooniamet keeldub perekonnaliikme vastsündinud lapsel, kes ei ole Euroopa Liidu kodanik ega vasta käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele, tähtajalise elamisõiguse pikendamisest, kui tema vanema tähtajalist elamisõigust ei pikendata või vanemal ei ole tähtajalist elamisõigust Eestis.",
      "rdfs:label": {
        "@value": "ELK_Par_31 (redaktsioon 1034665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034665",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_31_v13253941"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034665",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 31",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
