      }
    },
    {
      "@id": "estleg:ELK_Par_34_v1034665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Perekonnaliikme tähtajaline elamisõigus Eesti lõpetatakse: perekonnaliikme sooviavalduse alusel, kui on põhjendatud alust arvata, et perekonnaliige ohustab avalikku korda, riigi julgeolekut või teiste isikute tervist või kui perekonnaliige või Euroopa Liidu kodanik, kelle juurde elama asumiseks tähtajaline elamisõigus anti, on kuritarvitanud selles seaduses ettenähtud õigusi või kasutanud pettust eesmärgiga võimaldada perekonnaliikmel omandada Eestis tähtajalist elamisõigust. (2) Perekonnaliikme tähtajaline elamisõigus Eestis võidakse lõpetada, kui: Euroopa Liidu kodanik, kelle juurde elama asumiseks tähtajaline elamisõigus anti, ei vasta käesoleva seaduse §-s 20 sätestatud eeldusele või perekonnaliige ei ela püsivalt Eestis. (3) Perekonnaliikme tähtajaline elamisõigus Eestis lõpetatakse Kodakondsus- ja Migratsiooniameti otsusega. (4) Kodakondsus- ja Migratsiooniamet tunnistab tähtajalise elamisõiguse lõpetamisel perekonnaliikme isikutunnistuse kehtetuks.",
      "rdfs:label": {
        "@value": "ELK_Par_34 (redaktsioon 1034665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034665",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_34_v13253941"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034665",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 34",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
