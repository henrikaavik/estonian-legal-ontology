    {
      "@id": "estleg:ELK_Par_54_1_v13253941",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_54_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveamet võib põhjendatud kahtluse korral kontrollida, kas Euroopa Liidu kodanik ja tema perekonnaliige viibivad või elavad Eestis vastavalt selles seaduses sätestatud nõuetele, täidavad selles seaduses sätestatud kohustusi ja tingimusi ega ole kuritarvitanud selles seaduses ettenähtud õigusi või kasutanud pettust. (2) Euroopa Liidu kodanik ja perekonnaliige peavad Eestis viibimise ja elamisega seotud asjaolude üle järelevalve teostamisel tegema koostööd, alluma tema suhtes kohaldatavatele järelevalvemeetmetele ning esitama Politsei- ja Piirivalveameti ja Kaitsepolitseiameti nõudmisel oma valduses olevad dokumendid ja muud tõendid, mis võivad omada tähtsust Euroopa Liidu kodaniku või perekonnaliikme Eestis viibimise ja elamisega seotud asjaolude selgitamisel, ning andma suulisi ja kirjalikke selgitusi.",
      "rdfs:label": {
        "@value": "ELK_Par_54_1 (redaktsioon 13253941)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13253941",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_54_1_v114032014019"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13253941",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 54_1",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
    {
      "@id": "estleg:ELK_Par_54_1_v114032014019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_54_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveamet ning Kaitsepolitseiamet võivad põhjendatud kahtluse korral kontrollida, kas Euroopa Liidu kodanik ja tema perekonnaliige viibivad või elavad Eestis vastavalt käesolevas seaduses sätestatud nõuetele, täidavad selles seaduses sätestatud kohustusi ja tingimusi ega ole kuritarvitanud selles ettenähtud õigusi või kasutanud pettust. (2) Kaitsepolitseiamet teostab käesoleva paragrahvi lõikes 1 sätestatu kohaselt riiklikku järelevalvet Euroopa Liidu kodaniku ja tema perekonnaliikme Eestis viibimise ja elamise asjaolude üle julgeolekuasutuste seadusest tulenevate ülesannete täitmisel kuriteo tõkestamiseks.",
      "rdfs:label": {
        "@value": "ELK_Par_54_1 (redaktsioon 114032014019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032014019",
