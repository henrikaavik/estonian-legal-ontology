      },
      "estleg:versionValidFrom": {
        "@value": "2017-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ELK_Par_4 (redaktsioon 126042017008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126042017008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126042017008",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 4",
      "estleg:partOfAct": {
