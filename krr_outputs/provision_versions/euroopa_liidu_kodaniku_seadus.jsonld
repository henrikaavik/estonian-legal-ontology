    {
      "@id": "estleg:ELK_Par_28_v1034665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kodakondsus- ja Migratsiooniamet pikendab perekonnaliikme tähtajalist elamisõigust, kui on täidetud kõik järgmised tingimused: Euroopa Liidu kodanik, kelle juurde elama asumiseks tähtajaline elamisõigus anti, vastab käesoleva seaduse §-s 20 sätestatud eeldusele; Euroopa Liidu kodanikul, kelle juurde elama asumiseks tähtajaline elamisõigus anti, on jätkuvalt Eestis elamisõigus; perekonnaliikmel on jätkuvalt tähtajaline elamisõigus Eestis; tähtajalise elamisõiguse pikendamise taotleja vastab käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele; perekonnaliikme elukoht on registreeritud Eestis rahvastikuregistri seaduses sätestatud korras; perekonnaliikme suhtes ei esine tähtajalise elamisõiguse pikendamisest keeldumise aluseid. (2) Kodakondsus- ja Migratsiooniamet pikendab tähtajalist elamisõigust perekonnaliikme vastsündinud lapsel, kes ei ole Euroopa Liidu kodanik ega vasta käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele, tema vanema tähtajalise elamisõiguse ajaks.",
      "rdfs:label": {
        "@value": "ELK_Par_28 (redaktsioon 1034665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034665",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_28_v13253941"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034665",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 28",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
