      }
    },
    {
      "@id": "estleg:ELK_Par_4_v1034665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastsündinud lapseks käesoleva seaduse tähenduses loetakse alla üheaastast last.",
      "rdfs:label": {
        "@value": "ELK_Par_4 (redaktsioon 1034665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034665",
