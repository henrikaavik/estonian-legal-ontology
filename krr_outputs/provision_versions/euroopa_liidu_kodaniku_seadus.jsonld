    {
      "@id": "estleg:ELK_Par_52_5_v114032014020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_52_5"
      },
      "estleg:versionValidFrom": {
