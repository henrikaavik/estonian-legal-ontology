      }
    },
    {
      "@id": "estleg:ELK_Par_45_v1034665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Perekonnaliikmel, kes on tähtajalise elamisõiguse alusel Eestis püsivalt elanud viis aastat järjest, on õigus alalisele elamisõigusele. (2) Eestis tähtajalise elamisõigusega perekonnaliikmel on õigus alalisele elamisõigusele samal ajal Euroopa Liidu kodanikuga, kui Euroopa Liidu kodanikul tekib õigus alalisele elamisõigusele käesoleva seaduse § 40 lõike 2 alusel. (3) Eestis tähtajalise elamisõigusega perekonnaliikmel on õigus alalisele elamisõigusele Eestis elamisõigusega Euroopa Liidu kodaniku surma korral, kui: Euroopa Liidu kodanik töötas või tegutses füüsilisest isikust ettevõtjana Eestis ning oli surma hetkel elanud elamisõiguse alusel Eestis püsivalt vähemalt kaks aastat või Euroopa Liidu kodanik töötas või tegutses füüsilisest isikust ettevõtjana Eestis ning tema surma põhjustas tööõnnetus või kutsehaigus. (4) Eestis alalise elamisõigusega perekonnaliikme vastsündinud lapsel, sõltumata tema kodakondsusest, on õigus alalisele elamisõigusele. (5) Alalise elamisõigusega perekonnaliige on Eesti alaline elanik. (6) Perekonnaliikmel ei ole õigust alalisele elamisõigusele, kui ta tähtajaline elamisõigus on lõppenud või see on lõpetatud või kui ta ei ole Eestis elanud püsivalt viis aastat järjest, välja arvatud käesoleva paragrahvi lõikes 2 sätestatud juhul.",
      "rdfs:label": {
        "@value": "ELK_Par_45 (redaktsioon 1034665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034665",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_45_v103012017009"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034665",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 45",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
