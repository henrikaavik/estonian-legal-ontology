      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034665",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 25",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
    {
      "@id": "estleg:ELK_Par_25_v13253941",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveamet annab perekonnaliikmele, kes on saanud Eestis tähtajalise elamisõiguse, isikutunnistuse, mis on perekonnaliikme tähtajalist elamisõigust tõendav dokument. (2) Isikutunnistus antakse tähtajalise elamisõiguse kehtivusajaks.",
      "rdfs:label": {
        "@value": "ELK_Par_25 (redaktsioon 13253941)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13253941",
