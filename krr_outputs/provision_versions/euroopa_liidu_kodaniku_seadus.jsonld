    {
      "@id": "estleg:ELK_Par_87_v1034665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2006. aasta 1. augustil. (2) Käesoleva seaduse § 10 lõike 2 punkt 1 ja § 73 punkt 1 jõustuvad Eesti täielikul ühinemisel Euroopa Liidu ühtse viisaruumiga. 1 Euroopa Parlamendi ja nõukogu direktiiv 2004/38/EÜ, mis käsitleb Euroopa Liidu kodanike ja nende perekonnaliikmete õigust liikuda ja elada vabalt liikmesriikide territooriumil (ELT L 158, 30.04.2004, lk 77–123).",
      "rdfs:label": {
        "@value": "ELK_Par_87 (redaktsioon 1034665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034665",
      "estleg:supersededByVersion": {
