        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevat seadust kohaldatakse ka Euroopa Majanduspiirkonna liikmesriigi ja Šveitsi Konföderatsiooni kodaniku suhtes. §-d 18--22. [Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "ELK_Par_17 (redaktsioon 742614)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742614",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_17_v1034665"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742614",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 17",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
    {
      "@id": "estleg:ELK_Par_17_v1034665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kodakondsus- ja Migratsiooniamet teeb Euroopa Liidu kodanikule, kelle tähtajaline elamisõigus lõpetatakse, lahkumisettekirjutuse väljasõidukohustuse ja sissesõidukeelu seaduses sätestatud korras. (2) Käesoleva paragrahvi lõikes 1 nimetatud lahkumisettekirjutus kuulub sundtäitmisele 30. päevast ettekirjutuse tegemise päevast arvates. (3) Kui elamisõigus lõpetatakse ohu korral riigi julgeolekule, kuulub lahkumisettekirjutus viivitamata sundtäitmisele.",
      "rdfs:label": {
        "@value": "ELK_Par_17 (redaktsioon 1034665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034665",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_17_v13253941"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034665",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 17",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
