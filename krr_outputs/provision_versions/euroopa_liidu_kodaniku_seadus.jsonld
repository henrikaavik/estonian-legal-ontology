      }
    },
    {
      "@id": "estleg:ELK_Par_25_v109122010002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveamet annab perekonnaliikmele, kes on saanud Eestis tähtajalise elamisõiguse, elamisloakaardi, mis on perekonnaliikme tähtajalist elamisõigust tõendav dokument. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "ELK_Par_25 (redaktsioon 109122010002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109122010002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109122010002",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 25",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
    {
      "@id": "estleg:ELK_Par_26_v1034665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kodakondsus- ja Migratsiooniamet keeldub perekonnaliikmele tähtajalise elamisõiguse andmisest, kui: Euroopa Liidu kodanik, kelle juurde ta soovib elama asuda, ei vasta käesoleva seaduse §-s 20 sätestatud eeldustele, Euroopa Liidu kodanikul, kelle juurde ta soovib elama asuda, ei ole Eestis elamisõigust, tähtajalise elamisõiguse taotleja ei vasta käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele, on põhjendatud alust arvata, et perekonnaliige ohustab avalikku korda, riigi julgeolekut või teiste isikute tervist või perekonnaliige või Euroopa Liidu kodanik, kelle juurde ta soovib elama asuda, on kuritarvitanud selles seaduses ettenähtud õigusi või kasutanud pettust eesmärgiga võimaldada perekonnaliikmel omandada Eestis tähtajalist elamisõigust. (2) Kodakondsus- ja Migratsiooniamet keeldub perekonnaliikme vastsündinud lapsele, kes ei ole Euroopa Liidu kodanik ega vasta käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele, tähtajalise elamisõiguse andmisest, kui tema vanemal ei ole tähtajalist elamisõigust Eestis. (3) Käesoleva paragrahvi lõike 1 punktis 5 nimetatud õiguste kuritarvitamise ja pettusena käsitatakse muu hulgas: fiktiivse abielu sõlmimist, Euroopa Liidu kodaniku poolt Eestis elamisõiguse omandamist eesmärgiga võimaldada perekonnaliikmel omandada elamisõigust Eestis, võltsitud dokumentide esitamist või valeandmete esitamist.",
      "rdfs:label": {
        "@value": "ELK_Par_26 (redaktsioon 1034665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034665",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_26_v13253941"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034665",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 26",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
    {
      "@id": "estleg:ELK_Par_26_v13253941",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELK_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveamet keeldub perekonnaliikmele tähtajalise elamisõiguse andmisest, kui: Euroopa Liidu kodanik, kelle juurde ta soovib elama asuda, ei vasta käesoleva seaduse §-s 20 sätestatud eeldustele, Euroopa Liidu kodanikul, kelle juurde ta soovib elama asuda, ei ole Eestis elamisõigust, tähtajalise elamisõiguse taotleja ei vasta käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele, on põhjendatud alust arvata, et perekonnaliige ohustab avalikku korda, riigi julgeolekut või teiste isikute tervist või perekonnaliige või Euroopa Liidu kodanik, kelle juurde ta soovib elama asuda, on kuritarvitanud selles seaduses ettenähtud õigusi või kasutanud pettust eesmärgiga võimaldada perekonnaliikmel omandada Eestis tähtajalist elamisõigust. (2) Politsei- ja Piirivalveamet keeldub perekonnaliikme vastsündinud lapsele, kes ei ole Euroopa Liidu kodanik ega vasta käesoleva seaduse §-s 3 sätestatud perekonnaliikme määratlusele, tähtajalise elamisõiguse andmisest, kui tema vanemal ei ole tähtajalist elamisõigust Eestis. (3) Käesoleva paragrahvi lõike 1 punktis 5 nimetatud õiguste kuritarvitamise ja pettusena käsitatakse muu hulgas: fiktiivse abielu sõlmimist, Euroopa Liidu kodaniku poolt Eestis elamisõiguse omandamist eesmärgiga võimaldada perekonnaliikmel omandada elamisõigust Eestis, võltsitud dokumentide esitamist või valeandmete esitamist.",
      "rdfs:label": {
        "@value": "ELK_Par_26 (redaktsioon 13253941)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13253941",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELK_Par_26_v117122015005"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13253941",
      "estleg:sourceAct": "Euroopa Liidu kodaniku seadus",
      "estleg:provisionRef": "ELK § 26",
      "estleg:partOfAct": {
        "@id": "estleg:ELK_Map_2026"
      }
    },
