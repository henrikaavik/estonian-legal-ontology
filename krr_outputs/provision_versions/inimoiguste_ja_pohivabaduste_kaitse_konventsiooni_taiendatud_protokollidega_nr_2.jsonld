      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": ", mis on koostatud 1963. aasta 16. septembril Strasbourg'is ja alla kirjutatud Eesti Vabariigi poolt 1993. aasta 14. mail.",
      "rdfs:label": {
        "@value": "inimoiguste_ja_pohivabaduste_kaitse_konv_Par_3 (redaktsioon 922131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922131"
    },
    {
