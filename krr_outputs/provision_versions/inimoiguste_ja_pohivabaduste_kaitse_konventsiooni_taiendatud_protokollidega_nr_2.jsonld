  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_inimoiguste_ja_pohivabaduste_kaitse_konventsiooni_taiendatud_protokollidega_nr_2_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Inimõiguste ja põhivabaduste kaitse konventsiooni (täiendatud protokollidega nr 2, 3, 5 ja 8) ning selle lisaprotokollide nr 1, 4, 7, 9, 10 ja 11 ratifitseerimise seadus (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Inimõiguste ja põhivabaduste kaitse konventsiooni (täiendatud protokollidega nr 2, 3, 5 ja 8) ning selle lisaprotokollide nr 1, 4, 7, 9, 10 ja 11 ratifitseerimise seadus"
    },
    {
      "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_1_v922131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(edaspidi konventsioon), mis on koostatud 1950. aasta 4. novembril Roomas ja mida on täiendatud protokollidega nr. 2, 3, 5 ja 8 ning mis on alla kirjutatud Eesti Vabariigi poolt 1993. aasta 14. mail, tehes järgmise reservatsiooni: [Teine lõige kehtetu - - jõust. 1. 01. 2006]",
      "rdfs:label": {
        "@value": "inimoiguste_ja_pohivabaduste_kaitse_konv_Par_1 (redaktsioon 922131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922131"
    },
    {
      "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_2_v922131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": ", mis on koostatud 1952. aasta 20. märtsil Pariisis ja alla kirjutatud Eesti Vabariigi poolt 1993. aasta 14. mail, tehes järgmise reservatsiooni: Taasiseseisvunud Eesti on alustanud ulatuslikke majandus- ja sotsiaalreforme, mis hõlmavad Nõukogude Liidu anneksiooniperioodil natsionaliseeritud, konfiskeeritud, rekvireeritud, kollektiviseeritud või muul viisil ebaseaduslikult võõrandatud varade tagastamist või kompenseerimist endistele omanikele või nende pärijatele; kollektiivpõllumajanduse ümberkujundamist ja riikliku omandi erastamist. Vastavalt konventsiooni artiklile 64 deklareerib Eesti Vabariik, et protokolli nr. 1 artikli 1 sätted ei laiene omandireformi seadustele, mis reguleerivad Nõukogude Liidu anneksiooni ajal natsionaliseeritud, konfiskeeritud, rekvireeritud, kollektiviseeritud või muul viisil ebaseaduslikult võõrandatud varade tagastamist või kompenseerimist, kollektiivpõllumajanduse ümberkujundamist ja riikliku omandi erastamist. Käesolev reservatsioon hõlmab omandireformi aluste seaduse (RT 1991, 21, 257; RT I 1994, 38, 617; 40, 653; 51, 859; 94, 1609), maareformiseaduse (RT 1991, 34, 426; RT I 1995, 10, 113), põllumajandusreformi seaduse (RT 1992, 10, 143; 36, 474; RT I 1994, 52, 880), erastamisseaduse (RT I 1993, 45, 639; 1994, 50, 846; 79, 1329; 83, 1448; 1995, 22, 327; 54, 881; 57, 979), eluruumide erastamise seaduse (RT I 1993, 23, 411; 1995, 44, 671; 57, 979; 1996, 2, 28), õigusvastaselt võõrandatud vara maksumuse määramise ja kompenseerimise seaduse (RT I 1993, 30, 509; 1994, 8, 106; 51, 859; 54, 905; 1995, 29, 357) ja ühistatud vara maksumuse määramise seaduse (RT I 1993, 7, 104) käesoleva seaduse jõustumise hetkel kehtivat redaktsiooni.",
      "rdfs:label": {
        "@value": "inimoiguste_ja_pohivabaduste_kaitse_konv_Par_2 (redaktsioon 922131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922131"
    },
    {
      "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_3_v922131",
