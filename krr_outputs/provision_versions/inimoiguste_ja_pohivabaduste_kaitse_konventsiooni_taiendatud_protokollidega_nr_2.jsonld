      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": ", mis on koostatud 1992. aasta 25. märtsil Strasbourg'is ja alla kirjutatud Eesti Vabariigi poolt 1993. aasta 14. mail.",
      "rdfs:label": {
        "@value": "inimoiguste_ja_pohivabaduste_kaitse_konv_Par_6 (redaktsioon 922131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922131"
    },
    {
      "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_7_v922131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": ", mis on koostatud 1994. aasta 11. mail Strasbourg'is ja alla kirjutatud Eesti Vabariigi poolt 1994. aasta 11. mail.",
      "rdfs:label": {
        "@value": "inimoiguste_ja_pohivabaduste_kaitse_konv_Par_7 (redaktsioon 922131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922131"
    },
    {
      "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_8_v922131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teha vastavalt konventsiooni artiklile 25 deklaratsioon, kus tunnistatakse ratifitseerimiskirja deponeerimisest arvates kolmeks aastaks Euroopa Inimõiguste Komisjoni pädevust võtta vastu Euroopa Nõukogu peasekretärile adresseeritud petitsioone igalt isikult, valitsusväliselt organisatsioonilt ja isikute grupilt, kes väidavad, et Eesti Vabariik rikub nende õigusi, mis on sätestatud konventsioonis, samuti selle lisaprotokolli nr. 4 artiklites 1 kuni 4 ja lisaprotokolli nr. 7 artiklites 1 kuni 5.",
      "rdfs:label": {
        "@value": "inimoiguste_ja_pohivabaduste_kaitse_konv_Par_8 (redaktsioon 922131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922131"
    },
    {
      "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_9_v922131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:inimoiguste_ja_pohivabaduste_kaitse_konv_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teha vastavalt konventsiooni artiklile 46 deklaratsioon, kus tunnistatakse ratifitseerimiskirja deponeerimisest arvates kolmeks aastaks Kõrgete Lepinguosaliste vastastikku tunnustatud tingimustel ipso facto ja ilma sellekohase eraldi kokkuleppeta Euroopa Inimõiguste Kohtu pädevust kõigis konventsiooni, samuti selle lisaprotokolli nr. 4 artiklite 1 kuni 4 ja lisaprotokolli nr. 7 artiklite 1 kuni 5 tõlgendamisel ja kohaldamisel.",
      "rdfs:label": {
        "@value": "inimoiguste_ja_pohivabaduste_kaitse_konv_Par_9 (redaktsioon 922131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922131"
    }
  ]
}
