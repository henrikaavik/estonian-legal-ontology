        "@type": "xsd:date"
      },
      "estleg:versionText": ", mis on koostatud 1990. aasta 6. novembril Roomas ja alla kirjutatud Eesti Vabariigi poolt 1993. aasta 14. mail.",
      "rdfs:label": {
        "@value": "inimoiguste_ja_pohivabaduste_kaitse_konv_Par_5 (redaktsioon 922131)",
        "@language": "et"
      },
