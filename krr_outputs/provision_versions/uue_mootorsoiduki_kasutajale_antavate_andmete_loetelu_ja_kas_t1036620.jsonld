        "@value": "2021-06-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus jõustub 2017. aasta 1. jaanuaril. Käesolev määrus jõustub 2017. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "Reg_1036620_Par_11 (redaktsioon 1036620)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036620",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036620",
      "estleg:sourceAct": "Uue mootorsõiduki kasutajale antavate andmete loetelu ja kasutaja teavitamise kord",
