    {
      "@id": "estleg:Reg_1036620_Par_10_v1036620",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036620_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse §-des 6–9 nimetatud märgistel, teatmikus, plakatitel ja reklaamväljaannetes on keelatud selliste kütusekulu või süsinikdioksiidi heitkoguse andmete kasutamine, mis võivad uute sõiduautode võimalikke kasutajaid eksitada ja ei vasta käesoleva määruse nõuetele. Käesoleva määruse §-des 6–9 nimetatud märgistel, teatmikus, plakatitel ja reklaamväljaannetes on keelatud selliste kütusekulu või süsinikdioksiidi heitkoguse andmete kasutamine, mis võivad uute sõiduautode võimalikke kasutajaid eksitada ja ei vasta käesoleva määruse nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1036620_Par_10 (redaktsioon 1036620)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036620",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036620",
      "estleg:sourceAct": "Uue mootorsõiduki kasutajale antavate andmete loetelu ja kasutaja teavitamise kord",
      "estleg:provisionRef": "Reg_1036620 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036620_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036620_Par_11_v1036620",
