    {
      "@id": "estleg:Reg_1037433_Par_17_v1037433",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037433_Par_17"
