      "estleg:sourceAct": "Kodanikuühiskonna rahvusvahelise koostöö toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1061642 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061642_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061642_Par_7_v1061642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061642_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Projekti abikõlblikkuse periood on ajavahemik, mille kestel tehakse projekti tegevusi ja tekivad projekti kulud. Projekti abikõlblikkuse periood on ajavahemik, mille kestel tehakse projekti tegevusi ja tekivad projekti kulud. 2 (2) Käesoleva määruse § 2 lõike 2 punkti 2 raames toetatavate tegevuste abikõlblikkuse periood on konkursi väljakuulutamisel vastav kalendriaasta. Käesoleva määruse § 2 lõike 2 punkti 2 raames toetatavate tegevuste abikõlblikkuse periood on konkursi väljakuulutamisel vastav kalendriaasta. 3 (3) Projekti abikõlblikkuse perioodi pikendatakse vaid põhjendatud juhtudel. Projekti abikõlblikkuse perioodi pikendatakse vaid põhjendatud juhtudel.",
      "rdfs:label": {
        "@value": "Reg_1061642_Par_7 (redaktsioon 1061642)",
        "@language": "et"
      },
