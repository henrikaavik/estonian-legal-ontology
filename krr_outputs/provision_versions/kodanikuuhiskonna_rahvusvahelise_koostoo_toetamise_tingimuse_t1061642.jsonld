    {
      "@id": "estleg:Reg_1061642_Par_3_v1061642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061642_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andja on Sihtasutus Kodanikuühiskonna Sihtkapital (edaspidi KÜSK või toetuse andja), kes kuulutab taotlusvooru välja, menetleb toetuse taotlusi (edaspidi taotlus), teeb toetuse väljamakseid ja järelevalvet toetuse kasutamise üle. Toetuse andja on Sihtasutus Kodanikuühiskonna Sihtkapital (edaspidi KÜSK või toetuse andja), kes kuulutab taotlusvooru välja, menetleb toetuse taotlusi (edaspidi taotlus), teeb toetuse väljamakseid ja järelevalvet toetuse kasutamise üle.",
      "rdfs:label": {
        "@value": "Reg_1061642_Par_3 (redaktsioon 1061642)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061642",
