      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andja otsuse või toimingu peale võib esitada vaide haldusmenetluse seaduses sätestatud korras. Vaide lahendab toetuse andja. Toetuse andja otsuse või toimingu peale võib esitada vaide haldusmenetluse seaduses sätestatud korras. Vaide lahendab toetuse andja.",
