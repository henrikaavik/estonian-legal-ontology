    {
      "@id": "estleg:Reg_154074_Par_3_v154074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154074_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tunnused kantakse õhusõidukile värviga või kinnitatakse viisil, mis tagab hea püsivuse ja loetavuse. Tunnused peavad olema selgelt eraldatavad, puhtad ja vigastusteta. Tunnused kantakse õhusõidukile värviga või kinnitatakse viisil, mis tagab hea püsivuse ja loetavuse. Tunnused peavad olema selgelt eraldatavad, puhtad ja vigastusteta. 2 (2) Tunnuste taustast erinev õhusõiduki värvkate ei tohi asetseda tunnustele lähemal kui 1/4 tunnuste kõrgusest. Tunnuste taustast erinev õhusõiduki värvkate ei tohi asetseda tunnustele lähemal kui 1/4 tunnuste kõrgusest. 3 (3) Iga õhusõiduk varustatakse tulekindlast materjalist tunnussildiga, millele on graveeritud või söövitatud õhusõiduki tunnused. Iga õhusõiduk varustatakse tulekindlast materjalist tunnussildiga, millele on graveeritud või söövitatud õhusõiduki tunnused.",
      "rdfs:label": {
        "@value": "Reg_154074_Par_3 (redaktsioon 154074)",
        "@language": "et"
      },
