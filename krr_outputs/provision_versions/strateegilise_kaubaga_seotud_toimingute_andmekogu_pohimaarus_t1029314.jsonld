    {
      "@id": "estleg:Reg_1029314_Par_5_v1029314",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029314_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-09-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Litsentsitaotluse ja litsentsi kohta kantakse andmekogusse: 1 1) taotleja ja taotlusega seotud poole nimi, aadress, telefoni- ja faksinumber, elektronposti ja veebilehe aadress, isikukood või sünniaeg ja registrikood; 2 2) kauba või teenuse kirjeldus, teenuse osutamise viis, lõppkasutusvaldkond ja -koht; 3 3) litsentsitaotlusega seotud riik; 4 4) kauba teekond lähteriigist kuni lõppkasutajani; 5 5) kauba sisse- või väljaveo, transiidi või teenuse osutamise ajavahemik, tarkvara ja tehnoloogia edastamise aeg; 6 6) kauba kogus ja väärtus või teenuse maksumus; 7 7) kauba kood tollitariifistiku järgi; 8 8) lepingu kuupäev; 9 9) relva ning selle osa ja olulise osa markeering; 10 10) strateegilise kauba nimekirja kategooria tähis ja number või sanktsioonialuse kauba nimekirja kategooria number; RT I 2018-10-02 1 102102018001 2018-10-05 11 11) kontaktisiku ja esindaja nimi, aadress, telefoni- ja faksinumber, elektronposti aadress; 12 12) litsentsi taotlemise kuupäev; 13 13) taotluse menetlusega seotud märkus; 14 14) taotluse menetluse eest tasutud riigilõiv; 15 15) väljastatud litsents, selle number ja kehtivus või keeldumise teatis ja kuupäev; 16 16) litsentsiga seotud lisatingimus; 17 17) litsentsi andmete muutmine, litsentsi tühistamine, kehtetuks tunnistamine, kehtivuse peatamine või kehtivuse taastamine; 18 18) litsentsitaotlusega kaasnev dokument ja litsentsi saaja esitatud aruanne. Litsentsitaotluse ja litsentsi kohta kantakse andmekogusse: taotleja ja taotlusega seotud poole nimi, aadress, telefoni- ja faksinumber, elektronposti ja veebilehe aadress, isikukood või sünniaeg ja registrikood; kauba või teenuse kirjeldus, teenuse osutamise viis, lõppkasutusvaldkond ja -koht; litsentsitaotlusega seotud riik; kauba teekond lähteriigist kuni lõppkasutajani; kauba sisse- või väljaveo, transiidi või teenuse osutamise ajavahemik, tarkvara ja tehnoloogia edastamise aeg; kauba kogus ja väärtus või teenuse maksumus; kauba kood tollitariifistiku järgi; lepingu kuupäev; relva ning selle osa ja olulise osa markeering; strateegilise kauba nimekirja kategooria tähis ja number või sanktsioonialuse kauba nimekirja kategooria number; kontaktisiku ja esindaja nimi, aadress, telefoni- ja faksinumber, elektronposti aadress; litsentsi taotlemise kuupäev; taotluse menetlusega seotud märkus; taotluse menetluse eest tasutud riigilõiv; väljastatud litsents, selle number ja kehtivus või keeldumise teatis ja kuupäev; litsentsiga seotud lisatingimus; litsentsi andmete muutmine, litsentsi tühistamine, kehtetuks tunnistamine, kehtivuse peatamine või kehtivuse taastamine; litsentsitaotlusega kaasnev dokument ja litsentsi saaja esitatud aruanne.",
      "rdfs:label": {
        "@value": "Reg_1029314_Par_5 (redaktsioon 1029314)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029314",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029314",
      "estleg:sourceAct": "Strateegilise kaubaga seotud toimingute andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1029314 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029314_Map"
      }
