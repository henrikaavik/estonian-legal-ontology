      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigi territooriumi jaotus õhukvaliteedi piirkondadeks ja linnastuteks õhukvaliteedi taseme järgi ning linnastute määratlemiseks vajalik asustustihedus (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigi territooriumi jaotus õhukvaliteedi piirkondadeks ja linnastuteks õhukvaliteedi taseme järgi ning linnastute määratlemiseks vajalik asustustihedus"
    },
    {
      "@id": "estleg:Reg_1036550_Par_1_v1036550",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036550_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse riigi territooriumi jaotus piirkondadeks ja linnastuteks õhukvaliteedi taseme järgi ning linnastute määratlemiseks vajalik asustustihedus ruutkilomeetri kohta. Määrusega kehtestatakse riigi territooriumi jaotus piirkondadeks ja linnastuteks õhukvaliteedi taseme järgi ning linnastute määratlemiseks vajalik asustustihedus ruutkilomeetri kohta.",
      "rdfs:label": {
        "@value": "Reg_1036550_Par_1 (redaktsioon 1036550)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036550",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036550",
      "estleg:sourceAct": "Riigi territooriumi jaotus õhukvaliteedi piirkondadeks ja linnastuteks õhukvaliteedi taseme järgi ning linnastute määratlemiseks vajalik asustustihedus",
      "estleg:provisionRef": "Reg_1036550 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036550_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036550_Par_2_v1036550",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036550_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi territoorium jaguneb õhukvaliteedi taseme järgi, võttes arvesse saasteainete ülemisi ja alumisi hindamispiire, järgmisteks õhukvaliteedi piirkondadeks: 1 1) Põhja-Eesti piirkond, kuhu kuulub Harju maakond, Ida-Viru maakond ja Lääne-Viru maakond; 2 2) Lõuna-Eesti piirkond, kuhu kuulub Hiiu maakond, Jõgeva maakond, Järva maakond, Lääne maakond, Põlva maakond, Pärnu maakond, Rapla maakond, Saare maakond, Tartu maakond, Valga maakond, Viljandi maakond ja Võru maakond. Riigi territoorium jaguneb õhukvaliteedi taseme järgi, võttes arvesse saasteainete ülemisi ja alumisi hindamispiire, järgmisteks õhukvaliteedi piirkondadeks: Põhja-Eesti piirkond, kuhu kuulub Harju maakond, Ida-Viru maakond ja Lääne-Viru maakond; Lõuna-Eesti piirkond, kuhu kuulub Hiiu maakond, Jõgeva maakond, Järva maakond, Lääne maakond, Põlva maakond, Pärnu maakond, Rapla maakond, Saare maakond, Tartu maakond, Valga maakond, Viljandi maakond ja Võru maakond.",
      "rdfs:label": {
        "@value": "Reg_1036550_Par_2 (redaktsioon 1036550)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036550",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036550",
      "estleg:sourceAct": "Riigi territooriumi jaotus õhukvaliteedi piirkondadeks ja linnastuteks õhukvaliteedi taseme järgi ning linnastute määratlemiseks vajalik asustustihedus",
      "estleg:provisionRef": "Reg_1036550 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036550_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036550_Par_3_v1036550",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036550_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lähtudes elanike arvust on linnastu Tallinn. Lähtudes õhukvaliteedi tasemest ja õhukvaliteedi hindamispiiridest ja asustustihedusest üle 1000 elaniku ruutkilomeetril, on linnastu Kohtla-Järve. Lähtudes elanike arvust on linnastu Tallinn. Lähtudes õhukvaliteedi tasemest ja õhukvaliteedi hindamispiiridest ja asustustihedusest üle 1000 elaniku ruutkilomeetril, on linnastu Kohtla-Järve.",
      "rdfs:label": {
        "@value": "Reg_1036550_Par_3 (redaktsioon 1036550)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036550",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036550",
      "estleg:sourceAct": "Riigi territooriumi jaotus õhukvaliteedi piirkondadeks ja linnastuteks õhukvaliteedi taseme järgi ning linnastute määratlemiseks vajalik asustustihedus",
      "estleg:provisionRef": "Reg_1036550 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036550_Map"
      }
    },
