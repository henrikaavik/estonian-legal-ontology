      "estleg:provisionRef": "Reg_158761 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158761_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158761_Par_13_v158761",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
