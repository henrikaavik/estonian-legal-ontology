        "@id": "estleg:Reg_1060061_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060061_Par_7_v1060061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060061_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Välisesinduse juht või teenistuja vastutab üüri- või kasutamislepinguga võetud kohustuste nõuetekohase täitmise eest, sealhulgas teeb residentsi või eluruumi üürilepingu lõpetamisel kõik endast oleneva, et üürileandja tagastaks üüritagatise. Välisesinduse juht või teenistuja vastutab üüri- või kasutamislepinguga võetud kohustuste nõuetekohase täitmise eest, sealhulgas teeb residentsi või eluruumi üürilepingu lõpetamisel kõik endast oleneva, et üürileandja tagastaks üüritagatise. 2 (2) Välisesinduse juht või teenistuja on kohustatud hüvitama enda, oma perekonnaliikmete ja isiklike külaliste süülise tegevuse, tegevusetuse või hooletuse tagajärjel, kaasa arvatud lemmikloomade poolt residentsile või eluruumile või kummagi sisustusele tekitatud kahju. Vaidluse korral kahju hüvitamise suuruse ja põhjendatuse üle teeb otsuse Välisministeeriumi haldusküsimuste asekantsler või lähetajaministeeriumi kantsler või tema volitatud isik. Välisesinduse juht või teenistuja on kohustatud hüvitama enda, oma perekonnaliikmete ja isiklike külaliste süülise tegevuse, tegevusetuse või hooletuse tagajärjel, kaasa arvatud lemmikloomade poolt residentsile või eluruumile või kummagi sisustusele tekitatud kahju. Vaidluse korral kahju hüvitamise suuruse ja põhjendatuse üle teeb otsuse Välisministeeriumi haldusküsimuste asekantsler või lähetajaministeeriumi kantsler või tema volitatud isik.",
      "rdfs:label": {
        "@value": "Reg_1060061_Par_7 (redaktsioon 1060061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060061",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060061",
      "estleg:sourceAct": "Välisesinduse juhi residentsi soetamise, üürimise, kasutamise ja sisustamise alused ja kord ning välisesinduses töötava teenistuja kasutuses olevale eluruumile esitatavad tingimused ning eluruumi ja välisesinduse juhi residentsi kulude hüvitamise kord",
      "estleg:provisionRef": "Reg_1060061 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060061_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060061_Par_8_v1060061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
