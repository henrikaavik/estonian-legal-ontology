      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Residents on omandivormist sõltumata elamu, elamu osa või korter, mida välisesinduse juht kasutab elukohana ja esindusülesannete täitmiseks Viini diplomaatiliste suhete konventsiooni ja teiste rahvusvahelise õiguse normide, üldtunnustatud põhimõtete, tavade ja praktika tähenduses. Residents on omandivormist sõltumata elamu, elamu osa või korter, mida välisesinduse juht kasutab elukohana ja esindusülesannete täitmiseks Viini diplomaatiliste suhete konventsiooni ja teiste rahvusvahelise õiguse normide, üldtunnustatud põhimõtete, tavade ja praktika tähenduses.",
      "rdfs:label": {
