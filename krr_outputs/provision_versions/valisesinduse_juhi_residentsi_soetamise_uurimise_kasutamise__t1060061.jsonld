    {
      "@id": "estleg:Reg_1060061_Par_12_v1060061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060061_Par_12"
