    {
      "@id": "estleg:PLANEE_2_Par_16_v130122011023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PLANEE_2_Par_16"
