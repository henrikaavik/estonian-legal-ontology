      },
      "estleg:versionValidTo": {
        "@value": "2017-05-04",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PLANEE_2_Par_4_v104052017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
