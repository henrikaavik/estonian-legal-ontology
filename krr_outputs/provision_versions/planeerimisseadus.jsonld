      }
    },
    {
      "@id": "estleg:PLANEE_2_Par_30_v126022015003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PLANEE_2_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärast riigi eriplaneeringu ja keskkonnamõju strateegilise hindamise algatamist tehakse kavandatavale ehitisele sobivaima asukoha leidmiseks asukoha eelvalik, mis on riigi eriplaneeringu detailse lahenduse väljatöötamise alus. (2) Riigi eriplaneeringu asukoha eelvaliku tegemisel tuleb kaaluda mitut võimalikku asukohta. Kui riigi eriplaneeringu koostamiseks on esitatud mitu samasisulist taotlust, kaalutakse eelvaliku tegemisel ka esitatud taotlustes toodud võimalikke asukohti.",
      "rdfs:label": {
        "@value": "PLANEE_2_Par_30 (redaktsioon 126022015003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126022015003",
      "estleg:supersededByVersion": {
        "@id": "estleg:PLANEE_2_Par_30_v108072025036"
      },
      "estleg:versionValidTo": {
        "@value": "2025-07-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PLANEE_2_Par_30_v108072025036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PLANEE_2_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärast riigi eriplaneeringu ja keskkonnamõju strateegilise hindamise algatamist tehakse kavandatavale ehitisele sobivaima asukoha leidmiseks asukoha eelvalik, mis on riigi eriplaneeringu detailse lahenduse väljatöötamise alus. (1¹) Detailse lahenduse koostamisest loobumisel ja riigi eriplaneeringu kehtestamisel asukoha eelvaliku alusel kohaldatakse riigi eriplaneeringu koostamisel asukoha eelvalikule sätestatud nõudeid, välja arvatud käesoleva seaduse §-s 41 sätestatud nõudeid. (2) Riigi eriplaneeringu asukoha eelvaliku tegemisel tuleb kaaluda mitut võimalikku asukohta. Kui riigi eriplaneeringu koostamiseks on esitatud mitu samasisulist taotlust, kaalutakse eelvaliku tegemisel ka esitatud taotlustes toodud võimalikke asukohti.",
      "rdfs:label": {
        "@value": "PLANEE_2_Par_30 (redaktsioon 108072025036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025036"
    },
    {
      "@id": "estleg:PLANEE_2_Par_31_v226995",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
