      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "PLANEE_2_Par_30 (redaktsioon 114022013003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114022013003",
      "estleg:supersededByVersion": {
        "@id": "estleg:PLANEE_2_Par_30_v126022015003"
      },
      "estleg:versionValidTo": {
        "@value": "2015-06-30",
