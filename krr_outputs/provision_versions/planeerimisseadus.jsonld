        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtestatud üldplaneeringu või detailplaneeringu elluviimiseks võidakse kohaldada kinnisasja sundvõõrandamist kinnisasja sundvõõrandamise seaduses (RT I 1995, 30, 380; 59, 1006; 2002, 47, 297; 61, 375) ettenähtud alustel ja korras.",
      "rdfs:label": {
        "@value": "PLANEE_2_Par_31 (redaktsioon 226995)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "226995",
