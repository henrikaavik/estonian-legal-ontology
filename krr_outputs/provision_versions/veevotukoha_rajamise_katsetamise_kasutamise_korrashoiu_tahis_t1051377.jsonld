      },
      "estleg:versionText": "Määrusega kehtestatakse veevõtukoha rajamise, katsetamise, kasutamise, korrashoiu, tähistamise ja teabevahetuse nõuded, tingimused ning kord. Määrusega kehtestatakse veevõtukoha rajamise, katsetamise, kasutamise, korrashoiu, tähistamise ja teabevahetuse nõuded, tingimused ning kord.",
      "rdfs:label": {
        "@value": "Reg_1051377_Par_1 (redaktsioon 1051377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051377",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051377",
      "estleg:sourceAct": "Veevõtukoha rajamise, katsetamise, kasutamise, korrashoiu, tähistamise ja teabevahetuse nõuded, tingimused ning kord",
