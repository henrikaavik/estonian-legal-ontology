      }
    },
    {
      "@id": "estleg:Reg_158774_Par_7_v158774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158774_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevöönd on kaitseala maa- ja veeala seal väljakujunenud ja kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. Sihtkaitsevöönd on kaitseala maa- ja veeala seal väljakujunenud ja kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. 2 (2) Kaitsealal on Kahvena sihtkaitsevöönd. Kaitsealal on Kahvena sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_158774_Par_7 (redaktsioon 158774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158774",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158774",
      "estleg:sourceAct": "Kahvena looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158774 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158774_Map"
      }
    },
    {
      "@id": "estleg:Reg_158774_Par_8_v158774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158774_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud tee, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitseala tarbeks. Sihtkaitsevööndis on keelatud: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud tee, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitseala tarbeks.",
      "rdfs:label": {
        "@value": "Reg_158774_Par_8 (redaktsioon 158774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158774",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158774",
      "estleg:sourceAct": "Kahvena looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158774 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158774_Map"
      }
    },
    {
      "@id": "estleg:Reg_158774_Par_9_v158774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158774_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevöödis lubatud: 1 1) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 2 2) olemasolevate maaparandussüsteemide hoiutööd ja veerežiimi taastamine; 3 3) olemasolevate ehitiste hooldustööd; 4 4) metsakoosluse kujundamine 1. septembrist 31. jaanuarini vastavalt kaitse-eesmärgile, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas. Kaitseala valitseja nõusolekul on sihtkaitsevöödis lubatud: kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; olemasolevate maaparandussüsteemide hoiutööd ja veerežiimi taastamine; olemasolevate ehitiste hooldustööd; metsakoosluse kujundamine 1. septembrist 31. jaanuarini vastavalt kaitse-eesmärgile, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas.",
      "rdfs:label": {
        "@value": "Reg_158774_Par_9 (redaktsioon 158774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158774",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158774",
      "estleg:sourceAct": "Kahvena looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158774 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158774_Map"
      }
    },
