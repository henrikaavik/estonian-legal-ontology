    {
      "@id": "estleg:Reg_1050259_Par_13_v1050259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050259_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse § 12 lõikes 4 nimetatud merestrateegiaga seonduvad ruumiandmeteenused tuleb kättesaadavaks teha hiljemalt 31. detsembriks 2021. Käesoleva määruse § 12 lõikes 4 nimetatud merestrateegiaga seonduvad ruumiandmeteenused tuleb kättesaadavaks teha hiljemalt 31. detsembriks 2021.",
      "rdfs:label": {
