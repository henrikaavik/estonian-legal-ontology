    {
      "@id": "estleg:Reg_305946_Par_15_v305946",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305946_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uuendusraie, välja arvatud turberaie, mille puhul tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 2 2) uue maaparandussüsteemi ja tehisveekogu rajamine; 3 3) maavara kaevandamine; 4 4) puhtpuistute kujundamine ja energiapuistute rajamine; 5 5) biotsiidi ja taimekaitsevahendi kasutamine. Piiranguvööndis on keelatud: uuendusraie, välja arvatud turberaie, mille puhul tuleb säilitada koosluse liikide ja vanuse mitmekesisus; uue maaparandussüsteemi ja tehisveekogu rajamine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; biotsiidi ja taimekaitsevahendi kasutamine.",
      "rdfs:label": {
        "@value": "Reg_305946_Par_15 (redaktsioon 305946)",
        "@language": "et"
      },
