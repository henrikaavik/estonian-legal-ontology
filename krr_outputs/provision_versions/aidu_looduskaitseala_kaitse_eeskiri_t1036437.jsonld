    {
      "@id": "estleg:Reg_1036437_Par_1_v1036437",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036437_Par_1"
