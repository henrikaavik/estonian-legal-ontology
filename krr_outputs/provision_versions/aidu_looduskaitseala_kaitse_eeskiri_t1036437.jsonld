      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitsealal on vajalik metsa- ja sookoosluste taastamiseks kraavide sulgemine. Kaitsealal on vajalik metsa- ja sookoosluste taastamiseks kraavide sulgemine.",
      "rdfs:label": {
        "@value": "Reg_1036437_Par_6 (redaktsioon 1036437)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036437",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036437",
