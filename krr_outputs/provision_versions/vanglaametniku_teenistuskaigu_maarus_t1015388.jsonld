      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015388_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametniku vaba ametikoha täitmise viisi otsustab ametisse nimetamise õigust omav isik. Vanglaametniku vaba ametikoha täitmise viisi otsustab ametisse nimetamise õigust omav isik.",
      "rdfs:label": {
        "@value": "Reg_1015388_Par_1 (redaktsioon 1015388)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015388",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015388",
      "estleg:sourceAct": "Vanglaametniku teenistuskäigu määrus",
      "estleg:provisionRef": "Reg_1015388 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015388_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015388_Par_2_v1015388",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015388_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vanglaametniku edutamise otsustab ametisse nimetamise õigust omav isik. Vanglaametniku edutamise otsustab ametisse nimetamise õigust omav isik. 2 (2) Edutada saab vanglaametnikku: 1 1) kes vastab ametiastmele kehtestatud nõuetele; 2 2) kes on oma ametiastme järgsel ametikohal teeninud vähemalt ühe aasta; 3 3) kellel ei ole kehtivat distsiplinaarkaristust; 4 4) kes on andnud enda edutamiseks kirjaliku nõusoleku. Edutada saab vanglaametnikku: kes vastab ametiastmele kehtestatud nõuetele; kes on oma ametiastme järgsel ametikohal teeninud vähemalt ühe aasta; kellel ei ole kehtivat distsiplinaarkaristust; kes on andnud enda edutamiseks kirjaliku nõusoleku.",
      "rdfs:label": {
        "@value": "Reg_1015388_Par_2 (redaktsioon 1015388)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015388",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015388",
      "estleg:sourceAct": "Vanglaametniku teenistuskäigu määrus",
      "estleg:provisionRef": "Reg_1015388 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015388_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015388_Par_3_v1015388",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015388_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Enne vangistusseaduse jõustumist Sisekaitseakadeemia lõpetanud isik, kes vangistusseaduse jõustumisel ei töötanud vanglateenistusse kuuluval ametikohal, loetakse läbinuks II klassi vanglainspektori ametiastmele vastavale ametikohale nimetamiseks vajaliku ettevalmistusteenistuse. Enne vangistusseaduse jõustumist Sisekaitseakadeemia lõpetanud isik, kes vangistusseaduse jõustumisel ei töötanud vanglateenistusse kuuluval ametikohal, loetakse läbinuks II klassi vanglainspektori ametiastmele vastavale ametikohale nimetamiseks vajaliku ettevalmistusteenistuse. 2 (2) Enne vangistusseaduse jõustumist korrektsioonialast haridust andva muu õppeasutuse lõpetanud isik, kes vangistusseaduse jõustumisel ei töötanud vanglateenistusse kuuluval ametikohal, loetakse läbinuks II klassi valvuri ametiastmele vastavale ametikohale nimetamiseks vajaliku ettevalmistusteenistuse. Enne vangistusseaduse jõustumist korrektsioonialast haridust andva muu õppeasutuse lõpetanud isik, kes vangistusseaduse jõustumisel ei töötanud vanglateenistusse kuuluval ametikohal, loetakse läbinuks II klassi valvuri ametiastmele vastavale ametikohale nimetamiseks vajaliku ettevalmistusteenistuse.",
      "rdfs:label": {
        "@value": "Reg_1015388_Par_3 (redaktsioon 1015388)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015388",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015388",
      "estleg:sourceAct": "Vanglaametniku teenistuskäigu määrus",
      "estleg:provisionRef": "Reg_1015388 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015388_Map_2026"
      }
    },
