    {
      "@id": "estleg:Reg_1025192_Par_2_v1025192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025192_Par_2"
