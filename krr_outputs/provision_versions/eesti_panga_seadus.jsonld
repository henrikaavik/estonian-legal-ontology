      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22246",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_21_v1042865",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Pank on kohustatud tagama pangasaladusi sisaldavate andmete salastatuse (konfidentsiaalsuse). (2–3) Kehtetud - (4) Eesti Pangal on õigus avaldada oma käsutuses olevaid krediidiasutuste andmeid, mis ei sisalda pangasaladusi. (5) Eesti Pank avaldab perioodiliselt andmeid oma tegevuse ning Eesti ja Euroopa Liidu majanduse kohta.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_21 (redaktsioon 1042865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042865",
