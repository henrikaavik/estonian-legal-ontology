        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_1_v182537",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
