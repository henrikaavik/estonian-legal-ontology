      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Pangal on keelatud anda laenu Euroopa Liidu institutsioonidele või asutustele, Eesti ja Euroopa Liidu liikmesriikide valitsustele, kohalikele või muudele avaliku võimu organitele, teistele avalik-õiguslikele isikutele või riigi või kohaliku omavalitsuse osalusega äriühingutele.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_16 (redaktsioon 1042865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042865",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_2_Par_16_v112112010008"
      },
