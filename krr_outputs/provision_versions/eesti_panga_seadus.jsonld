    {
      "@id": "estleg:EESTI_2_Par_39_v1042865",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 10 lõike 1 jõustumisel ametis olev president loetakse ametisse nimetatuks seitsmeks aastaks arvates tema ametisse nimetamise hetkest. (2) Käesoleva seaduse § 10 lõike 21 jõustumisel ametis olevad asepresidendid loetakse eelnimetatud sätte jõustumise hetkest arvates viieks aastaks ametisse nimetatuks.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_39 (redaktsioon 1042865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042865",
