    {
      "@id": "estleg:EESTI_2_Par_25_v22246",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Panga omakapital koosneb: põhikapitalist; reservkapitalist; sihtkapitalidest ja -fondidest. (2) Eesti Panga põhikapitali suurus on 100 000 000 krooni. (3) Põhikapitali suurendatakse määratud suuruseni Eesti Panga kasumi ning sihtotstarbeliste laekumiste arvel. Riigikogu otsusel võidakse põhikapitali suurendada ka muudest allikatest.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_25 (redaktsioon 22246)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22246",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_2_Par_25_v112112010008"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22246",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_25_v112112010008",
