      }
    },
    {
      "@id": "estleg:EESTI_2_Par_34_v112112010008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Arvestades Euroopa Keskpanga ja Euroopa Keskpankade Süsteemi pädevust, kogub vajaliku raha-, finants- ja maksebilansistatistika saamiseks ning avaldamiseks riikliku statistika seaduses sätestatud alustel ja korras. (2) Eesti Pangal on õigus saada tasuta kõigilt riigi- ja omavalitsusorganitelt ning Eesti territooriumil asuvatelt välismajandustehinguid sooritavatelt isikutelt Eesti maksebilansi koostamiseks vajalikke andmeid.",
      "rdfs:label": {
