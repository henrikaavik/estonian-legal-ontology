      }
    },
    {
      "@id": "estleg:EESTI_2_Par_14_v112112010014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "väärtpaberite emiteerimine, ost ja müük; väärismetalli ning välisvaluuta ost ja müük; laenude andmine krediidiasutustele piisava tagatise olemasolul; laenuandmise limiitide kehtestamine krediidiasutustele; sanktsioonide rakendamine raharingluse kohta kehtestatud eeskirjade rikkujate suhtes.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_14 (redaktsioon 112112010014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010014",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_2_Par_14_v112112010008"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112112010014",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_14_v112112010008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arvestades Euroopa Keskpanga ja Euroopa Keskpankade Süsteemi pädevust, on Eesti Pangal oma võtta ja anda piisava tagatise olemasolu korral laenu; teha muid tehinguid raha-, väärtpaberi- ja välisvaluutaturul; omada aktsiaid ja muid osalusi ning kinnisvara; kehtestada rahaturgu reguleerivaid eeskirju ja seaduse alusel usaldatavusnormatiive; rakendada sanktsioone raharingluse kohta kehtestatud eeskirjade rikkujate suhtes, välja arvatud sanktsioonid, mida rakendab Euroopa Keskpank Euroopa Keskpankade Süsteemi ja Euroopa Keskpanga põhikirja artikli 34.3 alusel; saada riigi- ja kohaliku omavalitsuse asutustelt ning muudelt isikutelt ja asutustelt oma ülesannete täitmiseks vajalikke andmeid; teha muid oma ülesannete täitmiseks vajalikke toiminguid.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_14 (redaktsioon 112112010008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010008",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_2_Par_14_v109052014008"
      },
      "estleg:versionValidTo": {
        "@value": "2014-05-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112112010008",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_14_v109052014008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arvestades Euroopa Keskpanga ja Euroopa Keskpankade Süsteemi pädevust, on Eesti Pangal oma ülesannete täitmiseks õigus: võtta ja anda piisava tagatise olemasolu korral laenu; teha muid tehinguid raha-, väärtpaberi- ja välisvaluutaturul; omada aktsiaid ja muid osalusi ning kinnisvara; kehtestada rahaturgu reguleerivaid eeskirju ja seaduse alusel usaldatavusnormatiive; rakendada sanktsioone raharingluse kohta kehtestatud eeskirjade rikkujate suhtes, välja arvatud sanktsioonid, mida rakendab Euroopa Keskpank Euroopa Keskpankade Süsteemi ja Euroopa Keskpanga põhikirja artikli 34.3 alusel; saada riigi- ja kohaliku omavalitsuse asutustelt ning muudelt isikutelt ja asutustelt oma ülesannete täitmiseks vajalikke andmeid; teha muid oma ülesannete täitmiseks vajalikke toiminguid.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_14 (redaktsioon 109052014008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052014008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109052014008",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_14_1_v1042865",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_14_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Keskpanga loal on Eesti Pangal õigus emiteerida europangatähti. (2) Eesti Pangal on ainuõigus emiteerida Eesti Vabariigis euromünte. Euromüntide emissioonimahu peab eelnevalt heaks kiitma Euroopa Keskpank. (3) Vigastatud ja rikutud europangatähti ja euromünte võtavad vastu ning asendavad uutega Eesti Pank ning tema volitatud krediidiasutused Euroopa Liidu õigusaktidega sätestatud korras. Eesti Panga presidendil on õigus oma määrusega kehtestada täpsemad reeglid vigastatud ja rikutud europangatähtede ja euromüntide käitlemise kohta. - jõust. tähtpäeval, mis sätestatakse Euroopa Liidu nõukogu otsuses Eesti Vabariigi suhtes kehtestatud erandi tühistamiseks Euroopa Ühenduse asutamislepingu artikli 122 lõikes 2 sätestatud korras",
      "rdfs:label": {
        "@value": "EESTI_2_Par_14_1 (redaktsioon 1042865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042865",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_2_Par_14_1_v112112010008"
      },
      "estleg:versionValidTo": {
