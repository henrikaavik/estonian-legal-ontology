    },
    {
      "@id": "estleg:EESTI_2_Par_21_v22246",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Pank on kohustatud tagama pangasaladusi sisaldavate andmete salastatuse (konfidentsiaalsuse). (2–3) Kehtetud - (4) Eesti Pangal on õigus avaldada oma käsutuses olevaid krediidiasutuste andmeid, mis ei sisalda pangasaladusi. (5) Eesti Pank annab välja perioodiliselt, vähemalt kord kvartalis ilmuvat bülletääni ja üks kord aastas ilmuvat Eesti Panga Aastaraamatut.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_21 (redaktsioon 22246)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22246",
