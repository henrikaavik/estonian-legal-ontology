      }
    },
    {
      "@id": "estleg:EESTI_2_Par_14_v1042865",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "väärtpaberite emiteerimine, ost ja müük; väärismetalli ning välisvaluuta ost ja müük; laenude andmine krediidiasutustele piisava tagatise olemasolul; laenuandmise limiitide kehtestamine krediidiasutustele; sanktsioonide rakendamine raharingluse kohta kehtestatud eeskirjade rikkujate suhtes. [Paragrahvi 14 sõnastus alates tähtpäevast, mis sätestatakse Euroopa Liidu nõukogu otsuses Eesti Vabariigi suhtes kehtestatud erandi tühistamiseks Euroopa Ühenduse asutamislepingu artikli 122 lõikes 2 sätestatud korras]",
      "rdfs:label": {
        "@value": "EESTI_2_Par_14 (redaktsioon 1042865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042865",
