    {
      "@id": "estleg:EESTI_2_Par_29_v22246",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Panga tuludesse kuuluvad: intressid välismaale paigutatud välisvaluutareservidelt; intressid teistesse pankadesse paigutatud deposiitidelt ja pankadele antud laenudelt; emissioonitulud; tulud tehingutest välisvaluuta, väärtpaberite ja tagatistega; tulud muudest tehingutest, mis ei ole vastuolus käesoleva seaduse ja Eesti Panga põhikirjaga. (2) Eesti Panga kuludesse kuuluvad: Eesti Panka deponeeritud või muul viisil kaasatud summade pealt makstavad intressid; välistehingute kulud; välislaenude intressid ja muud kulud; kulud seoses välisvaluuta- ja väärtpaberitehingutega ning tagatiste andmisega; rahatähtede ja müntide valmistamise ja emiteerimise kulud; põhivara amortisatsioon; haldus- ja majanduskulud; muud Eesti Panga ülesannete täitmiseks vajalikud kulud.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_29 (redaktsioon 22246)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22246",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_2_Par_29_v112112010008"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22246",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
