        "@id": "estleg:EESTI_2_Par_13_v257027"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22246",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_13_v257027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Panga tegevust juhib Eesti Panga juhatus, kelle esimeheks on oma ametikoha järgi Eesti Panga president. [Lõige 11 jõustub alates Eesti Vabariigi ühinemisest Euroopa Liiduga] (1¹) Juhatuse ülesandeks on Eesti Panga töö kavandamine ja korraldamine. (2) Eesti Panga juhatuse struktuuri, tööjaotuse ja töökorralduse alused sätestab Eesti Panga põhikiri. - jõust. Eesti Vabariigi ühinemisel Euroopa Liiduga",
      "rdfs:label": {
        "@value": "EESTI_2_Par_13 (redaktsioon 257027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257027",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_2_Par_13_v1042865"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257027",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_13_v1042865",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Panga tegevust juhib Eesti Panga juhatus, kelle esimeheks on oma ametikoha järgi Eesti Panga president. Juhatus koosneb Eesti Panga presidendist ja asepresidentidest. (1¹) Juhatuse ülesandeks on Eesti Panga töö kavandamine ja korraldamine. Eesti Panga president võib juhatusele anda täiendavaid ülesandeid. Oma ülesannete täitmiseks võtab juhatus vastu otsuseid. (2) Eesti Panga juhatuse tööjaotuse ja töökorralduse alused sätestab Eesti Panga põhikiri.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_13 (redaktsioon 1042865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042865",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042865",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_14_v22246",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Pangal on õigus kasutada raharingluse reguleerimiseks peamiselt järgmisi vahendeid: väärtpaberite emiteerimine, ost ja müük; väärismetalli ning välisvaluuta ost ja müük; rahaturgu reguleerivate eeskirjade kehtestamine; kohustuslike reservide ja muude normatiivide kehtestamine Eestis tegutsevatele krediidiasutustele; laenude andmine krediidiasutustele; Eesti Panga intressimäärade kehtestamine; laenuandmise limiitide kehtestamine krediidiasutustele; sanktsioonide rakendamine raharingluse kohta kehtestatud eeskirjade rikkujate suhtes.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_14 (redaktsioon 22246)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22246",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_2_Par_14_v257027"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22246",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_14_v257027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
