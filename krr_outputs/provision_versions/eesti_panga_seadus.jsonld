    {
      "@id": "estleg:EESTI_2_Par_19_v22246",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Pank hoiab krediidiasutuste korrespondent- ja kohustuslike reservide kontosid, jälgib nende saldode vastavust esitatavatele nõuetele ja, kui ilmneb neist kõrvalekaldumisi, võtab tarvitusele abinõud nende nõuete täitmise tagamiseks.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_19 (redaktsioon 22246)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22246",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22246",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_2_Par_19_1_v101032023045",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_2_Par_19_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Pank võib toimida maksesüsteemide, sealhulgas makse- ja arveldussüsteemide seaduses määratletud arveldussüsteemide korraldajana, kui see on tema ülesannete täitmiseks vajalik. Maksesüsteemide reeglid ja liitumistingimused kehtestab (2) Maksesüsteemiga, mida korraldab Eesti Pank, võivad osalejad liituda eeldusel, et nad täidavad maksesüsteemi reeglitega määratud liitumistingimusi ja sõlmivad asjakohase liitumislepingu.",
      "rdfs:label": {
        "@value": "EESTI_2_Par_19_1 (redaktsioon 101032023045)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101032023045",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/101032023045",
      "estleg:sourceAct": "Eesti Panga seadus",
      "estleg:provisionRef": "EESTI_2 § 19_1",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_2_Map_2026"
      }
