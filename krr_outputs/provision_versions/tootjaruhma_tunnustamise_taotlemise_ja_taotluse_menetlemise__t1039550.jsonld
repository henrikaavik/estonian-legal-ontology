    {
      "@id": "estleg:Reg_1039550_Par_13_v1039550",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039550_Par_13"
