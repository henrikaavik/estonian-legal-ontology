      "estleg:sourceAct": "Tootjarühma tunnustamise taotlemise ja taotluse menetlemise täpsem kord",
      "estleg:provisionRef": "Reg_1039550 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039550_Map"
      }
