      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Koolivälisele nõustamismeeskonnale soovituse andmiseks esitatavate andmete loetelu, taotluse esitamise ning koolivälise nõustamismeeskonna soovituse andmise tingimused ja kord (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Koolivälisele nõustamismeeskonnale soovituse andmiseks esitatavate andmete loetelu, taotluse esitamise ning koolivälise nõustamismeeskonna soovituse andmise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1042038_Par_1_v1042038",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042038_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse koolivälisele nõustamismeeskonnale (edaspidi nõustamismeeskond) soovituse andmiseks esitatavate andmete loetelu, taotluse esitamise ning nõustamismeeskonna soovituse andmise tingimused ja kord. Määrusega kehtestatakse koolivälisele nõustamismeeskonnale (edaspidi nõustamismeeskond) soovituse andmiseks esitatavate andmete loetelu, taotluse esitamise ning nõustamismeeskonna soovituse andmise tingimused ja kord. 2 (2) Käesolevas määruses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse sätteid. Käesolevas määruses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse sätteid.",
      "rdfs:label": {
        "@value": "Reg_1042038_Par_1 (redaktsioon 1042038)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042038",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042038",
      "estleg:sourceAct": "Koolivälisele nõustamismeeskonnale soovituse andmiseks esitatavate andmete loetelu, taotluse esitamise ning koolivälise nõustamismeeskonna soovituse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1042038 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042038_Map"
      }
