    {
      "@id": "estleg:NOORSO_Par_13_1_v129062014043",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOORSO_Par_13_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrakaitseorgan võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30 ja 50 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "NOORSO_Par_13_1 (redaktsioon 129062014043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014043",
      "estleg:supersededByVersion": {
