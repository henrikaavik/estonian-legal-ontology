      },
      "estleg:versionValidFrom": {
        "@value": "2004-06-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub eraldi seadusega Eesti Vabariigi liitumisel Euroopa Liiduga. 1 EL Nõukogu direktiiv 93/7/EMÜ liikmesriigi territooriumilt ebaseaduslikult väljaviidud kultuuriväärtuste tagastamise kohta (EÜT L 74, 27.03.1993, lk 74–79).",
      "rdfs:label": {
        "@value": "ELKTS_Par_13 (redaktsioon 769973)",
        "@language": "et"
      },
