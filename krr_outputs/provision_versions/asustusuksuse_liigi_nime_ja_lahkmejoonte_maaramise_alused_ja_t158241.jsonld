    {
      "@id": "estleg:Reg_158241_Par_5_v158241",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158241_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Asustusüksuse lahkmejoon on asustusüksuse territooriumi piiritlev mõtteline joon. Asustusüksuse lahkmejoon on asustusüksuse territooriumi piiritlev mõtteline joon. 2 (2) Asustusüksuse nimi, liik ja lahkmejoon kantakse elektroonilisse katastrisse ning katastrikaardile. RT I 2024-10-29 4 129102024004 2024-11-01 Asustusüksuse nimi, liik ja lahkmejoon kantakse elektroonilisse katastrisse ning katastrikaardile.",
      "rdfs:label": {
        "@value": "Reg_158241_Par_5 (redaktsioon 158241)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158241",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158241",
      "estleg:sourceAct": "Asustusüksuse liigi, nime ja lahkmejoonte määramise alused ja kord",
      "estleg:provisionRef": "Reg_158241 § 5",
      "estleg:partOfAct": {
