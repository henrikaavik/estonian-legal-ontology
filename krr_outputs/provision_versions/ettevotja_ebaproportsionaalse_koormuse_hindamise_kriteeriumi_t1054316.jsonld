  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_ettevotja_ebaproportsionaalse_koormuse_hindamise_kriteeriumi_t1054316_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ettevõtja ebaproportsionaalse koormuse hindamise kriteeriumid ja ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ettevõtja ebaproportsionaalse koormuse hindamise kriteeriumid ja ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord"
    },
    {
      "@id": "estleg:Reg_1054316_Par_1_v1054316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054316_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse toodete ja teenuste ligipääsetavuse seaduse kohaldamisalasse kuuluva toote ja teenuse suhtes ettevõtja ebaproportsionaalse koormuse hindamise ja selle dokumenteerimise kriteeriumid ning ettevõtjale ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord. Määrusega kehtestatakse toodete ja teenuste ligipääsetavuse seaduse kohaldamisalasse kuuluva toote ja teenuse suhtes ettevõtja ebaproportsionaalse koormuse hindamise ja selle dokumenteerimise kriteeriumid ning ettevõtjale ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord.",
      "rdfs:label": {
        "@value": "Reg_1054316_Par_1 (redaktsioon 1054316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054316",
      "estleg:sourceAct": "Ettevõtja ebaproportsionaalse koormuse hindamise kriteeriumid ja ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord",
      "estleg:provisionRef": "Reg_1054316 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054316_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054316_Par_2_v1054316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054316_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kogukulu käesoleva määruse tähenduses on toote tootmise, turustamise või importimisega või teenuse osutamisega seotud ettevõtja tegevuskulu ja kapitalikulu summa. Kogukulu käesoleva määruse tähenduses on toote tootmise, turustamise või importimisega või teenuse osutamisega seotud ettevõtja tegevuskulu ja kapitalikulu summa.",
      "rdfs:label": {
        "@value": "Reg_1054316_Par_2 (redaktsioon 1054316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054316",
      "estleg:sourceAct": "Ettevõtja ebaproportsionaalse koormuse hindamise kriteeriumid ja ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord",
      "estleg:provisionRef": "Reg_1054316 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054316_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054316_Par_3_v1054316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054316_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja ebaproportsionaalse koormuse hindamisel hindab ettevõtja järgmisi kriteeriume: 1 1) ligipääsetavusnõuete järgimise netomaksumuse ja toote tootmise, turustamise või importimise või teenuse osutamise kogukulu suhe ettevõtjale; 2 2) ettevõtja hinnanguliste kulude ja tulude suhe võrrelduna eeldatava kasuga puudega inimesele; 3 3) ligipääsetavusnõuete järgimise netomaksumuse ja ettevõtja netokäibe suhe. Ettevõtja ebaproportsionaalse koormuse hindamisel hindab ettevõtja järgmisi kriteeriume: ligipääsetavusnõuete järgimise netomaksumuse ja toote tootmise, turustamise või importimise või teenuse osutamise kogukulu suhe ettevõtjale; ettevõtja hinnanguliste kulude ja tulude suhe võrrelduna eeldatava kasuga puudega inimesele; ligipääsetavusnõuete järgimise netomaksumuse ja ettevõtja netokäibe suhe.",
      "rdfs:label": {
        "@value": "Reg_1054316_Par_3 (redaktsioon 1054316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054316",
      "estleg:sourceAct": "Ettevõtja ebaproportsionaalse koormuse hindamise kriteeriumid ja ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord",
      "estleg:provisionRef": "Reg_1054316 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054316_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054316_Par_4_v1054316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054316_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ettevõtja hindab kohaldatavate ligipääsetavusnõuete järgimise netomaksumuse ja toote tootmise, turustamise või importimise või teenuse osutamise kogukulu suhet ettevõtja jaoks. Ettevõtja hindab kohaldatavate ligipääsetavusnõuete järgimise netomaksumuse ja toote tootmise, turustamise või importimise või teenuse osutamise kogukulu suhet ettevõtja jaoks. 2 (2) Kohaldatavate ligipääsetavusnõuete järgimise netomaksumuse hindamise elemendid on: 1 1) ühekordsete korralduslike kuludega seotud kriteeriumid; 2 2) jooksvate tootmis- ja arenduskuludega seotud kriteeriumid. Kohaldatavate ligipääsetavusnõuete järgimise netomaksumuse hindamise elemendid on: ühekordsete korralduslike kuludega seotud kriteeriumid; jooksvate tootmis- ja arenduskuludega seotud kriteeriumid. 3 (3) Ligipääsetavusnõuetega seotud ühekordsete korralduslike kuludega seotud elemendid, mida tuleb hindamisel arvestada, on järgmised: 1 1) ligipääsetavusalaste eriteadmistega inimressursi maksumus; 2 2) inimressursi koolitamise ja ligipääsetavusalaste teadmiste saamisega seotud kulud; 3 3) toote arendamisele või teenuse osutamisele ligipääsetavusvõimaluste lisamiseks uue protsessi väljatöötamise maksumus; 4 4) ligipääsetavust käsitleva juhendmaterjali väljatöötamise maksumus; 5 5) ligipääsetavust käsitlevate õigusaktide mõistmise ühekordne kulu. Ligipääsetavusnõuetega seotud ühekordsete korralduslike kuludega seotud elemendid, mida tuleb hindamisel arvestada, on järgmised: ligipääsetavusalaste eriteadmistega inimressursi maksumus; inimressursi koolitamise ja ligipääsetavusalaste teadmiste saamisega seotud kulud; toote arendamisele või teenuse osutamisele ligipääsetavusvõimaluste lisamiseks uue protsessi väljatöötamise maksumus; ligipääsetavust käsitleva juhendmaterjali väljatöötamise maksumus; ligipääsetavust käsitlevate õigusaktide mõistmise ühekordne kulu. 4 (4) Ligipääsetavusnõuetega seotud jooksvate tootmis- ja arenduskuludega seotud elemendid, mida tuleb hindamisel arvestada, on eelkõige: 1 1) toote või teenuse ligipääsetavuselementide väljatöötamise kulud; 2 2) tootmisprotsessis tehtavad kulud; 3 3) toote või teenuse ligipääsetavuse katsetamise kulud; 4 4) ligipääsetavusnõuetega seotud dokumentatsiooni koostamise kulud. Ligipääsetavusnõuetega seotud jooksvate tootmis- ja arenduskuludega seotud elemendid, mida tuleb hindamisel arvestada, on eelkõige: toote või teenuse ligipääsetavuselementide väljatöötamise kulud; tootmisprotsessis tehtavad kulud; toote või teenuse ligipääsetavuse katsetamise kulud; ligipääsetavusnõuetega seotud dokumentatsiooni koostamise kulud.",
      "rdfs:label": {
        "@value": "Reg_1054316_Par_4 (redaktsioon 1054316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054316",
      "estleg:sourceAct": "Ettevõtja ebaproportsionaalse koormuse hindamise kriteeriumid ja ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord",
      "estleg:provisionRef": "Reg_1054316 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054316_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054316_Par_5_v1054316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054316_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja võrdleb hinnangulist kulu ja tulu, sealhulgas seoses tootmisprotsesside ja investeeringutega, eeldatava kasuga puudega inimeste jaoks, võttes arvesse konkreetse toote või teenuse kasutamiskordade arvu ja kasutamise sagedust. Ettevõtja võrdleb hinnangulist kulu ja tulu, sealhulgas seoses tootmisprotsesside ja investeeringutega, eeldatava kasuga puudega inimeste jaoks, võttes arvesse konkreetse toote või teenuse kasutamiskordade arvu ja kasutamise sagedust.",
      "rdfs:label": {
        "@value": "Reg_1054316_Par_5 (redaktsioon 1054316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054316",
      "estleg:sourceAct": "Ettevõtja ebaproportsionaalse koormuse hindamise kriteeriumid ja ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord",
      "estleg:provisionRef": "Reg_1054316 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054316_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054316_Par_6_v1054316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054316_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja hindab konkreetse toote või teenuse kohaldatavate ligipääsetavusnõuete järgimise netomaksumuse ja ettevõtja poolt pakutava toote või teenuse netokäibe suhet. Hindamisel kasutatakse käesoleva määruse § 4 lõigetes 3 ja 4 sätestatud elemente. Ettevõtja hindab konkreetse toote või teenuse kohaldatavate ligipääsetavusnõuete järgimise netomaksumuse ja ettevõtja poolt pakutava toote või teenuse netokäibe suhet. Hindamisel kasutatakse käesoleva määruse § 4 lõigetes 3 ja 4 sätestatud elemente.",
      "rdfs:label": {
        "@value": "Reg_1054316_Par_6 (redaktsioon 1054316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054316",
      "estleg:sourceAct": "Ettevõtja ebaproportsionaalse koormuse hindamise kriteeriumid ja ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord",
      "estleg:provisionRef": "Reg_1054316 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054316_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054316_Par_7_v1054316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054316_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ligipääsetavusnõuete kohaldamata jätmisest teavitades esitab ettevõtja Tarbijakaitse ja Tehnilise Järelevalve Ametile järgmised andmed: 1 1) ettevõtja nimi ja e-posti aadress, tootega seotud ettevõtja korral roll; 2 2) toote või teenuse nimetus; 3 3) toote või teenuse liigitus vastavalt toodete ja teenuste ligipääsetavuse seaduse § 2 lõigetes 1 ja 3 sätestatule; 4 4) toote või teenuse sihtrühm; 5 5) toodete ja teenuste ligipääsetavuse seaduse §-s 4 ja selle lõike 4 alusel kehtestatud valdkonna eest vastutava ministri määruses sätestatud ligipääsetavusnõuded, mida tootele või teenusele ei kohaldata; 6 6) käesoleva paragrahvi punktis 5 märgitud ligipääsetavusnõuete kohaldamata jätmise põhjus; 7 7) kinnitus, et ettevõtjat ei ole rahastatud ligipääsetavuse parandamise eesmärgil muudest ressurssidest kui ettevõtja omavahendid. Ligipääsetavusnõuete kohaldamata jätmisest teavitades esitab ettevõtja Tarbijakaitse ja Tehnilise Järelevalve Ametile järgmised andmed: ettevõtja nimi ja e-posti aadress, tootega seotud ettevõtja korral roll; toote või teenuse nimetus; toote või teenuse liigitus vastavalt toodete ja teenuste ligipääsetavuse seaduse § 2 lõigetes 1 ja 3 sätestatule; toote või teenuse sihtrühm; toodete ja teenuste ligipääsetavuse seaduse §-s 4 ja selle lõike 4 alusel kehtestatud valdkonna eest vastutava ministri määruses sätestatud ligipääsetavusnõuded, mida tootele või teenusele ei kohaldata; käesoleva paragrahvi punktis 5 märgitud ligipääsetavusnõuete kohaldamata jätmise põhjus; kinnitus, et ettevõtjat ei ole rahastatud ligipääsetavuse parandamise eesmärgil muudest ressurssidest kui ettevõtja omavahendid.",
      "rdfs:label": {
        "@value": "Reg_1054316_Par_7 (redaktsioon 1054316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054316",
      "estleg:sourceAct": "Ettevõtja ebaproportsionaalse koormuse hindamise kriteeriumid ja ligipääsetavusnõuete kohaldamata jätmisest teavitamise kord",
      "estleg:provisionRef": "Reg_1054316 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054316_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054316_Par_8_v1054316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054316_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse nõudeid kohaldatakse alates 28. juunist 2025. a turule lastava toote ja osutatava teenuse suhtes. Käesoleva määruse nõudeid kohaldatakse alates 28. juunist 2025. a turule lastava toote ja osutatava teenuse suhtes.",
