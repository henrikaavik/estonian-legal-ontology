    {
      "@id": "estleg:KRA_Par_19_v128122011047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRA_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2012. aasta 1. jaanuaril. (2) Käesoleva seaduse § 3 lõiked 1, 3, 4, 6–10, 14 ja 16–21 ning §-d 6 ja 9–16 jõustuvad 2013. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "KRA_Par_19 (redaktsioon 128122011047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011047",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRA_Par_19_v129122012006"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRA_Par_19_v129122012006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRA_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2012. aasta 1. jaanuaril. (1<sup>1</sup>) Käesoleva seaduse § 3 lõiked 4, 8, 14 ja 16 ning § 6 jõustuvad 2013. aasta 1. juulil. (2) Käesoleva seaduse § 3 lõiked 1, 3, 6, 7, 9, 10 ja 17–21 ning §-d 9 ja 11–16 jõustuvad 2014. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "KRA_Par_19 (redaktsioon 129122012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122012006"
    },
    {
      "@id": "estleg:KRA_Par_2_v128122011047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRA_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kõrgemate riigiteenijate kõrgeim palgamäär on 5200 eurot. (2) Käesoleva paragrahvi lõikes 1 nimetatud kõrgeim palgamäär indekseeritakse iga kalendriaasta 1. aprilliks kõrgeima palgamäära indeksiga, mille väärtus on 50% tarbijahinnaindeksi aastase muutuse ja sotsiaalmaksu laekumise aastase muutuse aritmeetilisest keskmisest. Indeksit väljendatakse täpsusega kolm kohta pärast koma. (3) Tarbijahinnaindeksi aastast muutust väljendatakse indeksiga, mis saadakse eelmise kalendriaasta tarbijahinnaindeksi väärtuse ja üle-eelmise kalendriaasta tarbijahinnaindeksi väärtuse vahe jagamisel üle-eelmise kalendriaasta tarbijahinnaindeksi väärtusega, lähtudes Statistikaameti ametlikult avaldatud tarbijahinnaindeksi väärtusest. Indeksit väljendatakse täpsusega kolm kohta pärast koma. (4) Sotsiaalmaksu laekumise aastast muutust väljendatakse indeksiga, mis saadakse eelmise kalendriaasta sotsiaalmaksu laekumise kogusumma ja üle-eelmise kalendriaasta sotsiaalmaksu laekumise kogusumma vahe jagamisel üle-eelmise kalendriaasta sotsiaalmaksu laekumise kogusummaga, lähtudes Rahandusministeeriumi andmetest sotsiaalmaksu laekumise kohta. Indeksit väljendatakse täpsusega kolm kohta pärast koma. (5) Käesoleva paragrahvi lõikes 2 nimetatud kõrgeima palgamäära indeksi avaldab Rahandusministeerium oma veebilehel iga kalendriaasta 1. aprilliks.",
      "rdfs:label": {
        "@value": "KRA_Par_2 (redaktsioon 128122011047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011047",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRA_Par_2_v129122012006"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRA_Par_2_v129122012006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRA_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kõrgemate riigiteenijate kõrgeim palgamäär on 5200 eurot. (2) Käesoleva paragrahvi lõikes 1 nimetatud kõrgeim palgamäär indekseeritakse iga kalendriaasta 1. aprilliks kõrgeima palgamäära indeksiga, mille väärtus on 50% tarbijahinnaindeksi aastase muutuse ja sotsiaalmaksu laekumise aastase muutuse aritmeetilisest keskmisest. Indeksit väljendatakse täpsusega kolm kohta pärast koma. (3) Tarbijahinnaindeksi aastast muutust väljendatakse indeksiga, mis saadakse eelmise kalendriaasta tarbijahinnaindeksi väärtuse ja üle-eelmise kalendriaasta tarbijahinnaindeksi väärtuse vahe jagamisel üle-eelmise kalendriaasta tarbijahinnaindeksi väärtusega, lähtudes Statistikaameti ametlikult avaldatud tarbijahinnaindeksi väärtusest. Indeksit väljendatakse täpsusega kolm kohta pärast koma. (4) Sotsiaalmaksu laekumise aastast muutust väljendatakse indeksiga, mis saadakse eelmise kalendriaasta sotsiaalmaksu laekumise kogusumma ja üle-eelmise kalendriaasta sotsiaalmaksu laekumise kogusumma vahe jagamisel üle-eelmise kalendriaasta sotsiaalmaksu laekumise kogusummaga, lähtudes Rahandusministeeriumi andmetest sotsiaalmaksu laekumise kohta. Indeksit väljendatakse täpsusega kolm kohta pärast koma. (5) Käesoleva paragrahvi lõikes 2 nimetatud kõrgeima palgamäära indeksi avaldab Rahandusministeerium oma veebilehel iga kalendriaasta 15. märtsiks.",
      "rdfs:label": {
        "@value": "KRA_Par_2 (redaktsioon 129122012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122012006",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRA_Par_2_v128122017011"
      },
      "estleg:versionValidTo": {
        "@value": "2018-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRA_Par_2_v128122017011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRA_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kõrgemate riigiteenijate kõrgeim palgamäär on 5200 eurot. (2) Peale käesoleva seaduse §-s 21 sätestatud indekseerimist loetakse järgmise aasta kõrgeimaks palgamääraks eelmisel aastal indekseerimise tulemusel saadud kõrgeim palgamäär. (3) Kehtetu - (4) Kehtetu - (5) Kehtetu -",
      "rdfs:label": {
        "@value": "KRA_Par_2 (redaktsioon 128122017011)",
        "@language": "et"
      },
