    },
    {
      "@id": "estleg:KRA_Par_4_v128122011047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRA_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu otsustab vajaduse korral käesoleva seaduse § 2 lõikes 1 sätestatud kõrgemate riigiteenijate kõrgeima palgamäära muutmise koosseisu kolmanda aasta kevadistungjärgul. Palgamäära muutus jõustub Riigikogu järgmise koosseisu volituste alguspäeval.",
      "rdfs:label": {
        "@value": "KRA_Par_4 (redaktsioon 128122011047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011047",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRA_Par_4_v128122017010"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRA_Par_4_v128122017010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRA_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 2 lõikes 1 sätestatud kõrgeima palgamäära muutus jõustub Riigikogu järgmise koosseisu volituste alguspäeval.",
      "rdfs:label": {
        "@value": "KRA_Par_4 (redaktsioon 128122017010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017010"
    },
    {
      "@id": "estleg:KRA_Par_4_1_v112032015029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRA_Par_4_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kõrgendatud kaitsevalmiduse ja sõjaseisukorra ajal, kui riigi julgeoleku tagamise huvides on vaja riigieelarve seadusesse teha muudatus, mille tagajärjel vähendatakse riigi eelarvest makstavaid töötasusid, on Vabariigi Valitsusel õigus teha Riigikogule ettepanek käesoleva seaduse § 3 lõigetes 1, 3, 4, 6–10, 12, 14 ja 16–21 sätestatud koefitsientide ajutiseks vähendamiseks. (2) Vabariigi Valitsuse ettepanekus esitatakse koefitsientide vähendamise ulatus, võttes proportsionaalselt arvesse riigieelarvest makstavate töötasude kogusumma vähenemise ulatust. (3) Riigikogu otsustab koefitsientide vähendamise, vähendamise ulatuse ja otsuse kehtivuse aja esimesel võimalusel Vabariigi Valitsuse ettepanekust arvates. (4) Riigikogu otsus jõustub otsusele järgneva kalendrikuu esimesel kuupäeval.",
      "rdfs:label": {
        "@value": "KRA_Par_4_1 (redaktsioon 112032015029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015029"
    },
