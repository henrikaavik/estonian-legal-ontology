      },
      "estleg:versionText": "Käesolevas seaduses nimetatud kõrgemate riigiteenijate ametipalk on käesoleva seaduse § 2 lõikes 1 nimetatud kõrgeima palgamäära, lõikes 2 nimetatud kõrgeima palgamäära indeksi ning §-s 3 sätestatud koefitsiendi korrutis.",
      "rdfs:label": {
        "@value": "KRA_Par_1 (redaktsioon 128122011047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011047",
