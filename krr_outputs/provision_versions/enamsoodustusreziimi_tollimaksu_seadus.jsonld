  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_enamsoodustusreziimi_tollimaksu_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Enamsoodustusrežiimi tollimaksu seadus (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Enamsoodustusrežiimi tollimaksu seadus"
    },
    {
      "@id": "estleg:ETMS_Par_1_v26123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETMS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 30. 06. 2002] (1) Enamsoodustusrežiimi tollimaks on kauba tolliväärtusest lähtuv riiklik maks, millega maksustatakse Eesti tolliterritooriumile tolliprotseduuriga «import vabaks ringluseks» toimetatav kaup. [Lõike 1 sõnastus alates 1. 07. 2002] (1) Enamsoodustusrežiimi tollimaks on kauba tolliväärtusest lähtuv riiklik maks, millega maksustatakse Eesti tolliterritooriumile vabasse ringlusse lubamise tolliprotseduuriga toimetatud kaup. (2) Enamsoodustusrežiimi tollimaksuga maksustatakse välisriikidest pärinevad kaubad, välja arvatud kaubad, mis välislepingu kohaselt tollimaksuga maksustamisele ei kuulu.",
      "rdfs:label": {
        "@value": "ETMS_Par_1 (redaktsioon 26123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26123",
      "estleg:supersededByVersion": {
        "@id": "estleg:ETMS_Par_1_v208551"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ETMS_Par_1_v208551",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETMS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enamsoodustusrežiimi tollimaks on kauba tolliväärtusest lähtuv riiklik maks, millega maksustatakse Eesti tolliterritooriumile vabasse ringlusse lubamise tolliprotseduuriga toimetatud kaup. (2) Enamsoodustusrežiimi tollimaksuga maksustatakse välisriikidest pärinevad kaubad, välja arvatud kaubad, mis välislepingu kohaselt tollimaksuga maksustamisele ei kuulu.",
      "rdfs:label": {
        "@value": "ETMS_Par_1 (redaktsioon 208551)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "208551"
    },
    {
      "@id": "estleg:ETMS_Par_2_v26123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETMS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enamsoodustusrežiimi tollimaksuga maksustatavad kaubad vastavalt kehtivale Eesti kaupade nomenklatuurile ja neile kaupadele vastavad tollimaksu määrad on sätestatud käesoleva seaduse lisas «Enamsoodustusrežiimi tollimaksuga maksustatavad kaubad ja neile vastavad tollimaksu määrad». (2) Kaup, mis käesoleva seaduse lisas on toodud koos maksustamistähtajaga, on maksuobjekt selle tähtaja jooksul kalendriaastas.",
      "rdfs:label": {
        "@value": "ETMS_Par_2 (redaktsioon 26123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26123"
    },
    {
      "@id": "estleg:ETMS_Par_3_v26123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETMS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enamsoodustusrežiimi tollimaksu maksab deklarant või isik, kelle eest deklarant deklareeritava kauba ja tollideklaratsiooni esitas. [Paragrahvi 4 sõnastus kuni 30. 06. 2002]",
      "rdfs:label": {
        "@value": "ETMS_Par_3 (redaktsioon 26123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26123",
      "estleg:supersededByVersion": {
        "@id": "estleg:ETMS_Par_3_v208551"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ETMS_Par_3_v208551",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETMS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enamsoodustusrežiimi tollimaksu maksab deklarant või isik, kelle eest deklarant deklareeritava kauba ja tollideklaratsiooni esitas. [Paragrahvi 4 sõnastus kuni 31. 12. 2002]",
      "rdfs:label": {
        "@value": "ETMS_Par_3 (redaktsioon 208551)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "208551"
    },
    {
      "@id": "estleg:ETMS_Par_4_v26123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksustatava kauba klassifitseerimisel, päritolu määramisel, tolliväärtuse määramisel, enamsoodustusrežiimi tollimaksu tasumisel ja maksusoodustuste rakendamisel ning teistes käesolevas seaduses sätestamata küsimustes kohaldatakse tolliseadust (RT I 1998, 3, 54; 1999, 86, 782), tollitariifiseadust (RT I 1997, 78/79, 1321; 1998, 31/32, 432; 1999, 82, 748) ja tolliväärtuse määramise seadust (RT I 1995, 20, 298; 1999, 83, 756). [Paragrahvi 4 sõnastus alates 1. 07. 2002]",
      "rdfs:label": {
        "@value": "ETMS_Par_4 (redaktsioon 26123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26123",
      "estleg:supersededByVersion": {
        "@id": "estleg:ETMS_Par_4_v208551"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ETMS_Par_4_v208551",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksustatava kauba klassifitseerimisel, päritolu määramisel, tolliväärtuse määramisel, enamsoodustusrežiimi tollimaksu tasumisel ja maksusoodustuste rakendamisel ning teistes käesolevas seaduses sätestamata küsimustes kohaldatakse tolliseadustikku ja tollitariifiseadust (RT I 1997, 78/79, 1321; 1998, 31/32, 432; 1999, 82, 748; 2000, 84, 535). [Paragrahvi 4 sõnastus alates 1. 01. 2003]",
      "rdfs:label": {
        "@value": "ETMS_Par_4 (redaktsioon 208551)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "208551"
    },
    {
      "@id": "estleg:ETMS_Par_5_v26123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETMS_Par_5"
