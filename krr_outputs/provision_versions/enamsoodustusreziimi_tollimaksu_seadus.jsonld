      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2000. aasta 1. jaanuaril. Lisa enamsoodustusrežiimi tollimaksu seadusele ENAMSOODUSTUSREŽIIMI TOLLIMAKSUGA MAKSUSTATAVAD KAUBAD JA NEILE VASTAVAD TOLLIMAKSU MÄÄRAD",
      "rdfs:label": {
        "@value": "ETMS_Par_5 (redaktsioon 26123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26123"
    }
  ]
