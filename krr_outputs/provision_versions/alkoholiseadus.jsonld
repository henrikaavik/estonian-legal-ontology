      }
    },
    {
      "@id": "estleg:AS_Par_49_v693732",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadusega kehtestatud erinõuete ja piirangute järgimise üle teostavad järelevalvet vastavalt oma pädevusele: Maksu- ja Tolliameti ametnikud; piirivalveametnikud; politseiametnikud (välja arvatud kaitsepolitseiametnikud); tarbijakaitseametnikud; tervisekaitseametnikud; kehtetu - Veterinaar- ja Toiduameti ametnikud; valla- või linnavalitsuse ametnikud.",
      "rdfs:label": {
