      }
    },
    {
      "@id": "estleg:AS_Par_29_v129062014011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alkoholi hulgimüük on lubatud vaid majandustegevuse registri andmetes märgitud tegevuskoha kaudu, välja arvatud alkoholi ekspordil või juhul, kui alkoholi realiseeritakse selle edasisele käitlejale viimase tegevuskohas.",
      "rdfs:label": {
        "@value": "AS_Par_29 (redaktsioon 129062014011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014011",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014011",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_3_v22440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestis toodetav alkohol peab olema kantud riiklikusse alkoholiregistrisse (edaspidi register). (2) Eestisse sisseveetav alkohol peab olema kantud registrisse, välja arvatud käesoleva seaduse paragrahv 27 lõikes 3 nimetatud juhtudel. (3) Lubatud on kaubelda vaid sellise alkoholiga, mis on kantud registrisse ja mis vastab registris säilitatavale sama alkoholi näidisele või selle kirjeldusele. (4) Register asutatakse Vabariigi Valitsuse poolt andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155) alusel. Registri vastutav töötleja on Majandusministeerium.",
      "rdfs:label": {
        "@value": "AS_Par_3 (redaktsioon 22440)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22440",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_3_v193188"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22440",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_3_v193188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alkoholi käitlemiseks loetakse selle toidugrupi suhtes teostatavad järgmised toimingud: valmistamine, töötlemine ja villimine ehk pakendamine (edaspidi tootmine); importimine alkoholiaktsiisi seaduse § 5 lõike 2 tähenduses (edaspidi import); eksportimine alkoholiaktsiisi seaduse § 11 punkti 2 tähenduses (edaspidi eksport); müügiks pakkumine või müük ühelt ettevõtjalt teisele ettevõtjale või muule isikule, kes ei ole tarbija tarbijakaitseseaduse (RT I 1994, 2, 13; 1999, 35, 450; 102, 907; 2000, 40, 252; 59, 379; 2001, 50, 283 ja 289; 56, 332) § 3 punkti 1 tähenduses (edaspidi hulgimüük); müügiks pakkumine või müük tarbijale (edaspidi jaemüük); hoidmine, ladustamine või edasitoimetamine kaubanduslikul eesmärgil. (2) Käesoleva paragrahvi lõike 1 punktis 6 nimetatud toimingutel on kaubanduslik eesmärk, kui need on suunatud isiku käsutuses oleva alkoholi müügile, töötlemisele, pakendamisele või kasutamisele vahetuskaubana.",
      "rdfs:label": {
        "@value": "AS_Par_3 (redaktsioon 193188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193188",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_3_v244580"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/193188",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_3_v244580",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alkoholi käitlemiseks loetakse selle toidugrupi suhtes teostatavad järgmised toimingud: valmistamine, töötlemine ja villimine ehk pakendamine (edaspidi tootmine); [Alapunkti 2 sõnastus kuni 31. 03. 2003] importimine alkoholiaktsiisi seaduse § 5 lõike 2 tähenduses (edaspidi import); [Alapunkti 2 sõnastus alates 1. 04. 2003] import alkoholi-, tubaka- ja kütuseaktsiisi seaduse § 10 tähenduses (edaspidi import); [Alapunkti 3 sõnastus kuni 31. 03. 2003] eksportimine alkoholiaktsiisi seaduse § 11 punkti 2 tähenduses (edaspidi eksport); [Alapunkti 3 sõnastus alates 1. 04. 2003] eksport alkoholi-, tubaka- ja kütuseaktsiisi seaduse § 11 tähenduses (edaspidi eksport); müügiks pakkumine või müük ühelt ettevõtjalt teisele ettevõtjale või muule isikule, kes ei ole tarbija tarbijakaitseseaduse (RT I 1994, 2, 13; 1999, 35, 450; 102, 907; 2000, 40, 252; 59, 379; 2001, 50, 283 ja 289; 56, 332) § 3 punkti 1 tähenduses (edaspidi hulgimüük); müügiks pakkumine või müük tarbijale (edaspidi jaemüük); hoidmine, ladustamine või edasitoimetamine kaubanduslikul eesmärgil. (2) Käesoleva paragrahvi lõike 1 punktis 6 nimetatud toimingutel on kaubanduslik eesmärk, kui need on suunatud isiku käsutuses oleva alkoholi müügile, töötlemisele, pakendamisele või kasutamisele vahetuskaubana.",
      "rdfs:label": {
        "@value": "AS_Par_3 (redaktsioon 244580)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "244580",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_3_v693732"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/244580",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
