      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Kehtetu - (4) Eksporditava alkoholi kohta koostatavas tollideklaratsioonis peab kajastuma: selle alkoholi käesoleva seaduse § 21 lõike 1 punkti 1 kohane määratlus. kehtetu - (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "AS_Par_19 (redaktsioon 129062014011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014011",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014011",
      "estleg:sourceAct": "Alkoholiseadus",
