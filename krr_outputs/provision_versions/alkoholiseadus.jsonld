    {
      "@id": "estleg:AS_Par_42_v193188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohaliku omavalitsuse volikogu võib oma haldusterritooriumil: kehtestada alkohoolse joogi jaemüügil lisaks käesoleva seaduse §-des 40 ja 41 nimetatule sortimenti, müügikohti ja müügivormi puudutavad kitsendused; piirata alkohoolse joogiga kauplemise aega. (2) Kauplemisloa väljastajal on õigus alkohoolse joogi jaemüügi õiguse andmisel kehtestada käesoleva paragrahvi lõikes 1 sätestatu alusel alkohoolse joogi jaemüügile tingimusi, mis kantakse kauplemisloale.",
      "rdfs:label": {
        "@value": "AS_Par_42 (redaktsioon 193188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193188",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_42_v728975"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/193188",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 42",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
