      }
    },
    {
      "@id": "estleg:AS_Par_23_v22440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võltsitud alkoholiks loetakse alkohol: mis on tähistatud kaubamärgiomaniku loata õiguskaitset omava kaubamärgiga identse või äravahetamiseni sarnase tähisega; mis ei vasta registris säilitatavale sama alkoholi näidisele või selle kirjeldusele.",
      "rdfs:label": {
        "@value": "AS_Par_23 (redaktsioon 22440)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22440",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_23_v193188"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22440",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_23_v193188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alkoholi importi, hulgimüüki ja eksporti võib teostada äriregistrisse kantud ettevõtja, kelle kohta on kehtiv registreering Riiklikus erinõuetega tegevusaladel tegutsevate ettevõtjate registris (käesolevas jaos edaspidi register). (2) Alkoholi impordil ei ole toiduseaduse § 42 lõikes 1 nimetatud tegevusluba nõutav. (3) Kui alkoholi käideldakse täitemenetluse käigus, kehtivad kohtutäiturile ettevõtjaga samased õigused ja kohustused.",
      "rdfs:label": {
        "@value": "AS_Par_23 (redaktsioon 193188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193188",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_23_v728975"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/193188",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_23_v728975",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alkoholi importi, hulgimüüki ja eksporti võib teostada äriregistrisse ja hulgimüüjana majandustegevuse registrisse (edaspidi register) kantud ettevõtja, kellel on registri registreeringus märge vastavalt alkoholi impordi, hulgimüügi või ekspordi kohta. (2) Alkoholi impordil ei ole toiduseaduse § 42 lõikes 1 nimetatud tegevusluba nõutav. (3) Alkoholi käitlemisele täitemenetluse käigus ei kohaldata käesoleva paragrahvi lõikes 1 sätestatud äriregistrisse, samuti majandustegevuse registrisse kandmise nõuet.",
      "rdfs:label": {
        "@value": "AS_Par_23 (redaktsioon 728975)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "728975",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_23_v764836"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/728975",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_23_v764836",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_23"
      },
      "estleg:versionValidFrom": {
