        "@value": "2017-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014011",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 40",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_40_v116062017002",
