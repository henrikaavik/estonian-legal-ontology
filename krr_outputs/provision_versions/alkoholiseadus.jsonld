      }
    },
    {
      "@id": "estleg:AS_Par_49_v193188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadusega kehtestatud erinõuete ja piirangute järgimise üle teostavad järelevalvet vastavalt oma pädevusele: maksuametnikud; piirivalveametnikud; politseiametnikud (välja arvatud kaitsepolitseiametnikud); tarbijakaitseametnikud; tervisekaitseametnikud; tolliametnikud; Veterinaar- ja Toiduameti ametnikud; valla- või linnavalitsuse ametnikud.",
      "rdfs:label": {
        "@value": "AS_Par_49 (redaktsioon 193188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193188",
      "estleg:supersededByVersion": {
