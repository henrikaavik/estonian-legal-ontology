    },
    {
      "@id": "estleg:AS_Par_24_v13241974",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja, kes soovib teostada alkoholi hulgimüüki, importi või eksporti, esitab registri registreeringus käesoleva seaduse § 23 lõigetes 1–3 sätestatud märke tegemiseks taotluse, milles lisaks majandustegevuse registri seaduses ja kaubandustegevuse seaduses sätestatule peavad sisalduma: täpsustatud andmed tegevuse kohta (alkoholi import, hulgimüük, eksport); käideldava alkoholi määratlus vastavalt käesoleva seaduse § 2 lõigetes 2 ja 4–7 sätestatule.",
      "rdfs:label": {
