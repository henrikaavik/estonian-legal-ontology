      "rdfs:label": {
        "@value": "AS_Par_31 (redaktsioon 129062014011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014011",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014011",
      "estleg:sourceAct": "Alkoholiseadus",
