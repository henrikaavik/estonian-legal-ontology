      },
      "estleg:versionText": "Registreerimismenetlusele kohaldatakse kaubandustegevuse seaduses ja majandustegevuse registri seaduses sätestatut käesolevast seadusest tulenevate erisustega.",
      "rdfs:label": {
        "@value": "AS_Par_25 (redaktsioon 12925296)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12925296",
