      },
      "estleg:versionValidTo": {
        "@value": "2009-12-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040622",
      "estleg:sourceAct": "Alkoholiseadus",
