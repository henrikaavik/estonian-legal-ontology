      }
    },
    {
      "@id": "estleg:AS_Par_20_v193188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alkoholi impordi, hulgimüügi ja ekspordi korral arveldatakse selle alkoholi eest sularahata arvelduse korras.",
      "rdfs:label": {
        "@value": "AS_Par_20 (redaktsioon 193188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193188",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_20_v764836"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/193188",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 20",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_20_v764836",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alkoholi impordi, hulgimüügi ja ekspordi korral arveldatakse selle alkoholi eest sularahata arvelduse korras. (2) Käesoleva paragrahvi lõikes 1 sätestatud nõue ei kehti rahvusvaheliselt käitatava vee- või õhusõiduki pardal kasutamiseks mõeldud alkoholi suhtes.",
      "rdfs:label": {
        "@value": "AS_Par_20 (redaktsioon 764836)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "764836",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/764836",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 20",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_21_v22440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alkohol, mida Eestis toodetakse või Eestisse tegevusloa alusel või käesoleva seaduse paragrahv 27 lõike 3 punkti 3 kohaselt sisse veetakse, peab olema identifitseeritav selle alkoholi müügipakendil asuva tootjapoolse partii tähistuse (partii number või tootmise kuupäev või aastakäik või kuupäeva sisaldav minimaalne säilimisaeg) alusel. (2) Eestisse sissevedamiseks mittelubatud alkoholi ja võltsitud alkoholi käitlemine, hoidmine, ladustamine või edasitoimetamine on keelatud.",
      "rdfs:label": {
        "@value": "AS_Par_21 (redaktsioon 22440)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22440",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_21_v193188"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22440",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_21_v193188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alkoholi hulgimüük ja eksport tuleb vormistada paberkandjal saatedokumendiga, mis võimaldab kaupa ja selle partiid identifitseerida. Saatedokumendile peab lisaks muudele õigusaktis sätestatud nõuetele olema kantud: alkoholi määratlus (liik, nimi, tootja, müügipakendi maht, etanoolisisaldus, tootjapoolne partii tähistus, kusjuures partii numbri ja aastakäigu samaaegsel kasutamisel peavad olema märgitud mõlemad tähistused); käideldava alkoholi registrikande number ja kuupäev; alkoholi hulgimüüki või eksporti teostava ettevõtja registreeringu number; tollideklaratsiooni number (imporditud alkoholi puhul). (2) Alkoholi vastuvõtmisel hulgimüügi korras peab kontrollima saatedokumendi nõuetekohasust ja tootjapoolse partii tähistuse vastavust saatedokumendile. (3) Alkoholi eksport, hulgimüük ja jaemüük ettevõtja poolt, kes ei ole selle alkoholi tootja või importija, samuti alkoholi edasitoimetamine ettevõtja poolt väljaspool tema tegutsemiskohta on lubatud vaid juhul, kui selle alkoholi kohta omatakse nõuetekohast saatedokumenti. (4) Nõuetekohane saatedokument tuleb järelevalvet teostavale ametnikule esitada tema soovil kohe, välja arvatud juhtudel, kui saatedokumenti pole kontrollimomendil võimalik esitada ettevõtjal seadusega lasuvate muude kohustuste tõttu.",
      "rdfs:label": {
        "@value": "AS_Par_21 (redaktsioon 193188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193188",
      "estleg:supersededByVersion": {
        "@id": "estleg:AS_Par_21_v728975"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/193188",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
    },
    {
      "@id": "estleg:AS_Par_21_v728975",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_21"
