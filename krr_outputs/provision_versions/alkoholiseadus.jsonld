      }
    },
    {
      "@id": "estleg:AS_Par_24_v12925296",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja, kes soovib teostada alkoholi importi, hulgimüüki või eksporti, esitab registri registreeringus käesoleva seaduse § 23 lõikes 1 sätestatud märke tegemiseks taotluse, milles lisaks majandustegevuse registri seaduses ja kaubandustegevuse seaduses sätestatule peavad sisalduma: täpsustatud andmed tegevuse kohta (alkoholi import, hulgimüük, eksport); käideldava alkoholi määratlus vastavalt käesoleva seaduse § 2 lõigetes 2 ja 4–7 sätestatule.",
      "rdfs:label": {
