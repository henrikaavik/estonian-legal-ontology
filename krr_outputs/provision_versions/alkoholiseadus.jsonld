    {
      "@id": "estleg:AS_Par_42_v109012018006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohaliku omavalitsuse volikogu võib oma haldusterritooriumil: kehtestada alkohoolse joogi jaemüügil lisaks käesoleva seaduse §-des 40 ja 41 nimetatule sortimenti, müügikohti ja müügivormi puudutavad kitsendused; kehtetu - piirata alkohoolse joogi jaemüüki kohapeal tarbimiseks kogu haldusterritooriumil või selle mõnes osas korrakaitseseaduse § 56 lõikes 2 sätestatud ajavahemikus. (2) Kehtetu - (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "AS_Par_42 (redaktsioon 109012018006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109012018006",
