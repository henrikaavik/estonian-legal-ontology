        "@value": "2004-05-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/728975",
      "estleg:sourceAct": "Alkoholiseadus",
      "estleg:provisionRef": "AS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:AS_Map"
      }
