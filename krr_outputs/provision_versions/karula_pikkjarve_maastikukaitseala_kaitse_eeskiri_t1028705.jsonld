    {
      "@id": "estleg:Reg_1028705_Par_1_v1028705",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028705_Par_1"
