      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud olemasolevate teede hooldustööd. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud olemasolevate teede hooldustööd.",
      "rdfs:label": {
        "@value": "Reg_1028705_Par_10 (redaktsioon 1028705)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028705",
