      },
      "estleg:versionText": "Toetuse taotlusi menetleb, väljamakseid teeb ja järelevalvet teostab Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi EIS). RT I 2021-12-29 3 129122021003 2022-01-01 Toetuse taotlusi menetleb, väljamakseid teeb ja järelevalvet teostab Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi EIS).",
      "rdfs:label": {
        "@value": "Reg_1051822_Par_2 (redaktsioon 1051822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051822",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051822",
