      "estleg:provisionRef": "Reg_1051822 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1051822_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1051822_Par_10_v1051822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051822_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus makstakse toetuse saajale välja kümne tööpäeva jooksul pärast taotluse rahuldamise otsuse tegemist. Toetus makstakse toetuse saajale välja kümne tööpäeva jooksul pärast taotluse rahuldamise otsuse tegemist.",
      "rdfs:label": {
        "@value": "Reg_1051822_Par_10 (redaktsioon 1051822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051822",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051822",
      "estleg:sourceAct": "Kommertsliinivedu teostava ettevõtja toetamine seoses COVID-19 haigust põhjustava koroonaviiruse levikuga",
      "estleg:provisionRef": "Reg_1051822 § 10",
