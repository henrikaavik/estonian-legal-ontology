    {
      "@id": "estleg:Reg_1051822_Par_8_v1051822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051822_Par_8"
