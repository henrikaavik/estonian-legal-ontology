      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2019. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "POLLUM_Par_20 (redaktsioon 128122018035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122018035"
    },
    {
      "@id": "estleg:POLLUM_Par_3_v224353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tõug loetakse ohustatuks, kui aretuses kasutatavate emasloomade arv on alla tuhande või isasloomade arv alla kahekümne ja emaslindude arv alla kümne tuhande või isaslindude arv alla tuhande.",
      "rdfs:label": {
        "@value": "POLLUM_Par_3 (redaktsioon 224353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "224353",
