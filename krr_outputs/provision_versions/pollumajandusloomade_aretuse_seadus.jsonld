        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_12_v101072020010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet käesoleva seaduse ja selle alusel kehtestatud õigusaktide ning Euroopa Parlamendi ja nõukogu määruse (EL) 2016/1012 ja selle alusel kehtestatud õigusaktide nõuete täitmise üle teostab Põllumajandus- ja Toiduamet (edaspidi korrakaitseorgan).",
      "rdfs:label": {
        "@value": "POLLUM_Par_12 (redaktsioon 101072020010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101072020010"
    },
    {
      "@id": "estleg:POLLUM_Par_13_v224353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui aretusühing, jõudluskontrolli läbiviija või ohustatud tõu säilitaja ei suuda tagada oma aretustegevuse nõuetekohasust, on tunnustamise otsuse teinud järelevalveasutuse juhil või tema volitatud ametnikul õigus selle otsuse kehtivus aretusühingu, jõudluskontrolli läbiviija või ohustatud tõu säilitaja üle järelevalvet teostanud järelevalveametniku ettepanekul peatada kuni käesoleva seaduse ja selle alusel kehtestatud õigusaktide rikkumise asjaolude selgumiseni või järelevalveametniku ettekirjutuse täitmiseni. (2) Tunnustamise otsuse kehtivus taastatakse ja aretusühingul, jõudluskontrolli läbiviijal või ohustatud tõu säilitajal tekib otsusega lubatud aretustegevuse jätkamise õigus, kui nimetatud isik on tunnustamise otsuse kehtivuse peatamise tinginud asjaolud kõrvaldanud ning tunnustamise otsuse peatamise otsus on kehtetuks tunnistatud. (3) Tunnustamise otsuse kehtivuse peatamise otsuse ja selle kehtetuks tunnistamise otsuse ärakiri saadetakse posti teel asjaomasele isikule otsuse tegemisest arvates kolme tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "POLLUM_Par_13 (redaktsioon 224353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "224353",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_13_v129062014052"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_13_v129062014052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu - (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "POLLUM_Par_13 (redaktsioon 129062014052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014052",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_13_v128122018035"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_13_v128122018035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrakaitseorgan võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 32 ja 49–52 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "POLLUM_Par_13 (redaktsioon 128122018035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122018035"
    },
    {
      "@id": "estleg:POLLUM_Par_14_v224353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tunnustamise otsus tunnistatakse kehtetuks, kui aretusühing, jõudluskontrolli läbiviija või ohustatud tõu säilitaja: ei suuda püsivalt täita tema aretustegevusele esitatud nõudeid; on korduvalt rikkunud käesoleva seaduse või selle alusel kehtestatud õigusaktide nõudeid või lõpetab oma tegevuse. (2) Tunnustamise otsuse võib kehtetuks tunnistada ka käesoleva paragrahvi lõikes 1 nimetatud isiku kirjaliku taotluse alusel. (3) Tunnustamise otsuse tunnistab kehtetuks järelevalveasutuse juht või tema volitatud ametnik aretusühingu, jõudluskontrolli läbiviija või ohustatud tõu säilitaja üle järelevalvet teostava järelevalveametniku ettepanekul. (4) Tunnustamise otsuse kehtetuks tunnistamise otsuse ärakiri saadetakse posti teel asjaomasele isikule otsuse tegemisest arvates kolme tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "POLLUM_Par_14 (redaktsioon 224353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "224353",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_14_v129062014052"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_14_v129062014052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu - (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "POLLUM_Par_14 (redaktsioon 129062014052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014052",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_14_v128122018035"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_14_v128122018035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korrakaitseorgan võib korrakaitseseaduse §-s 50 sätestatud tingimustel siseneda aretusühingu ja aretusettevõtja ning nendega seotud loomapidaja territooriumile ja ruumidesse. (2) Korrakaitseorganil on õigus keelata aretuseks aretusmaterjali kasutamine, kui see kahjustab aretusprogrammi elluviimist ega taga aretusedu. (3) Põlvnemisandmete õigsuse geneetiline ekspertiis tehakse rahvusvaheliselt tunnustatud metoodika järgi.",
      "rdfs:label": {
        "@value": "POLLUM_Par_14 (redaktsioon 128122018035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122018035"
    },
    {
      "@id": "estleg:POLLUM_Par_15_v224353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tõuraamat jaguneb põhiosaks ja lisadeks. (2) Põllumajandusloom kantakse tõuraamatu põhiossa, kui ta: vanemad ja vanavanemad on kantud sellesama tõu tõuraamatusse; on käesoleva seaduse nõuete kohaselt identifitseeritud ja põlvnemine on dokumentaalselt tõendatud. (3) Tõuraamatu põhiosa võib jaguneda osadeks lähtuvalt aretuslooma jõudlus- ja geneetilisest väärtusest. (4) Põllumajanduslooma, kelle üks või mõlemad vanemad on kantud teise tõu tõuraamatu põhiossa, võib kanda tõuraamatu põhiossa juhul, kui aretusühing on tunnistanud selle tõu vastavaks oma aretusprogrammis esitatud nõuetele. (5) Tõuraamatu lisasse võib käesoleva paragrahvi lõike 2 punktis 1 toodud nõuet arvestamata kanda emaslooma, kelle jõudlus vastab looma jõudluse miinimumnõuetele. (6) Emasloom, kelle ema ja emaema on kantud tõuraamatu lisasse ning kelle isa ja mõlemad vanaisad on kantud tõuraamatu põhiossa, on tõupuhas ja kantakse tõuraamatu põhiossa.",
      "rdfs:label": {
        "@value": "POLLUM_Par_15 (redaktsioon 224353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "224353",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_15_v750669"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_15_v750669",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tõuraamat jaguneb põhiosaks ja lisadeks. (2) Põllumajandusloom kantakse tõuraamatu põhiossa, kui ta: vanemad ja vanavanemad on kantud sellesama tõu tõuraamatusse; on käesoleva seaduse nõuete kohaselt identifitseeritud ja põlvnemine on dokumentaalselt tõendatud. (3) Tõuraamatu põhiosa võib jaguneda osadeks lähtuvalt aretuslooma jõudlus- ja geneetilisest väärtusest. (4) Põllumajanduslooma, kelle üks või mõlemad vanemad on kantud teise tõu tõuraamatu põhiossa, võib kanda tõuraamatu põhiossa juhul, kui aretusühing on tunnistanud selle tõu vastavaks oma aretusprogrammis esitatud nõuetele. (5) Tõuraamatu lisasse võib käesoleva paragrahvi lõike 2 punktis 1 toodud nõuet arvestamata kanda emaslooma, kelle jõudlus vastab asjaomase tõu aretusprogrammis esitatud miinimumnõuetele. (6) Emasloom, kelle ema ja emaema on kantud tõuraamatu lisasse ning kelle isa ja mõlemad vanaisad on kantud tõuraamatu põhiossa, on tõupuhas ja kantakse tõuraamatu põhiossa. (7) Aretuslooma tõuraamatusse kandmine peab vastama lisaks käesolevas seaduses sätestatud nõuetele EÜ Nõukogu direktiivide 77/504/EMÜ artikli 4, 88/661/EMÜ artikli 4 ning 90/427/EMÜ artiklite 4 ja 6 nõuetele. – joust. 1. 05. 2004",
