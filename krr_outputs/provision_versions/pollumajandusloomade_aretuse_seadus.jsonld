        "@id": "estleg:POLLUM_Par_4_v963547"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_4_v963547",
