      }
    },
    {
      "@id": "estleg:POLLUM_Par_12_v128122018035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet käesoleva seaduse ja selle alusel kehtestatud õigusaktide ning Euroopa Parlamendi ja nõukogu määruse (EL) 2016/1012 ja selle alusel kehtestatud õigusaktide nõuete täitmise üle teostab Veterinaar- ja Toiduamet (edaspidi korrakaitseorgan).",
      "rdfs:label": {
        "@value": "POLLUM_Par_12 (redaktsioon 128122018035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122018035",
      "estleg:supersededByVersion": {
