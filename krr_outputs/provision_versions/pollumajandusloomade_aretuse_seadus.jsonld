      }
    },
    {
      "@id": "estleg:POLLUM_Par_3_v963547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tõug loetakse ohustatuks, kui aretuses kasutatavate emasloomade arv on alla tuhande või isasloomade arv alla kahekümne ja emaslindude arv alla kümne tuhande või isaslindude arv alla tuhande. (2) Põllumajandusloomade ohustatud tõugude loetelu kehtestab",
      "rdfs:label": {
        "@value": "POLLUM_Par_3 (redaktsioon 963547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "963547",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_3_v12899354"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_3_v12899354",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tõug loetakse ohustatuks, kui aretuses kasutatavate emasloomade arv on alla tuhande või isasloomade arv alla kahekümne ja emaslindude arv alla kümne tuhande või isaslindude arv alla tuhande. (2) Põllumajandusloomade ohustatud tõugude loetelu kehtestab (3) Ohustatud tõugude loetellu kantav põllumajanduslooma tõug on ajalooliselt Eesti päritolu. (4) Ohustatud tõugu põllumajanduslooma aretuses võib kasutada üksnes sama tõugu põllumajanduslooma spermat, munarakku ja embrüot (edaspidi aretusmaterjal ). (5) Ohustatud tõugu põllumajanduslooma aretuses võib aretusprogrammis ettenähtud teist tõugu põllumajanduslooma aretusmaterjali kasutada üksnes ühekordsel ristamisel sugulusaretuse vältimiseks.",
      "rdfs:label": {
        "@value": "POLLUM_Par_3 (redaktsioon 12899354)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12899354",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_3_v13085473"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_3_v13085473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tõug või eristatav osa ühte tõugu kuuluvate loomade populatsioonist loetakse ohustatuks, kui aretuses kasutatavate emasloomade arv on alla tuhande või isasloomade arv alla kahekümne ja emaslindude arv alla kümne tuhande või isaslindude arv alla tuhande (edaspidi ohustatud tõug ). (2) Põllumajandusloomade ohustatud tõugude loetelu kehtestab (3) Ohustatud tõugude loetellu kantav põllumajanduslooma tõug on ajalooliselt Eesti päritolu. (4) Ohustatud tõugu põllumajanduslooma aretuses võib kasutada üksnes sama tõugu põllumajanduslooma spermat, munarakku ja embrüot (edaspidi aretusmaterjal ). (5) Ohustatud tõugu põllumajanduslooma aretuses võib aretusprogrammis ettenähtud teist tõugu põllumajanduslooma aretusmaterjali kasutada üksnes ühekordsel ristamisel sugulusaretuse vältimiseks.",
      "rdfs:label": {
        "@value": "POLLUM_Par_3 (redaktsioon 13085473)",
