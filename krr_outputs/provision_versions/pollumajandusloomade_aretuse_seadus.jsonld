        "@id": "estleg:POLLUM_Par_8_v12899354"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_8_v12899354",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aretusühing peab olema tunnustatud enne tõuraamatu või aretusregistri pidamise alustamist ning põllumajanduslooma jõudluskontrolli läbiviimise või tema geneetilise väärtuse hindamisega tegelda sooviv isik (edaspidi jõudluskontrolli läbiviija ) peab olema tunnustatud enne põllumajanduslooma jõudluskontrolli läbiviimise või tema geneetilise väärtuse hindamise alustamist. (2) Ohustatud tõu säilitamisega tegelda sooviv isik (edaspidi ohustatud tõu säilitaja ) peab olema tunnustatud enne ohustatud tõu säilitamise alustamist. (3) Tunnustamine on menetlus, mille käigus hinnatakse aretusühingu, jõudluskontrolli läbiviija või ohustatud tõu säilitaja ja tema kavandatava aretustegevuse vastavust käesoleva seaduse ja selle alusel kehtestatud õigusaktide ning Euroopa Liidu õigusaktide nõuetele. – joust. 1.05.2004",
      "rdfs:label": {
        "@value": "POLLUM_Par_8 (redaktsioon 12899354)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12899354",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_8_v13318705"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_8_v13318705",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aretusühing peab olema tunnustatud enne tõuraamatu või aretusregistri pidamise alustamist ning põllumajanduslooma jõudluskontrolli läbiviimise või tema geneetilise väärtuse hindamisega tegelda sooviv isik (edaspidi jõudluskontrolli läbiviija) peab olema tunnustatud enne põllumajanduslooma jõudluskontrolli läbiviimise või tema geneetilise väärtuse hindamise alustamist. (2) Ohustatud tõu säilitamisega tegelda sooviv isik (edaspidi ohustatud tõu säilitaja) peab olema tunnustatud enne ohustatud tõu säilitamise alustamist. (3) Tunnustamine on menetlus, mille käigus hinnatakse aretusühingu, jõudluskontrolli läbiviija või ohustatud tõu säilitaja ja tema kavandatava aretustegevuse vastavust käesoleva seaduse ja selle alusel kehtestatud õigusaktide ning Euroopa Liidu õigusaktide nõuetele.",
      "rdfs:label": {
        "@value": "POLLUM_Par_8 (redaktsioon 13318705)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13318705",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_8_v129062014052"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_8_v129062014052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusluba peab olema järgmistel tegevusaladel tegutsemiseks: tõuraamatu või aretusregistri pidamine; põllumajanduslooma jõudluskontrolli läbiviimine või tema geneetilise väärtuse hindamine; ohustatud tõu säilitamine. (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "POLLUM_Par_8 (redaktsioon 129062014052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014052",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_8_v128122018035"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_8_v128122018035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aretusühingul ja aretusettevõtjal peab põllumajandusloomade aretusega tegelemiseks olema lisaks tegevusloale Veterinaar- ja Toiduameti heaks kiidetud aretusprogramm, millele nende tegevus peab vastama. (2) Kui tõusiseselt on eristatud käesoleva seaduse § 2 lõike 2 kohaselt mitu alampopulatsiooni, peab iga alampopulatsiooni kohta olema selle aretuseesmärgile vastav aretusprogramm.",
      "rdfs:label": {
        "@value": "POLLUM_Par_8 (redaktsioon 128122018035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122018035",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_8_v101072020010"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_8_v101072020010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aretusühingul ja aretusettevõtjal peab põllumajandusloomade aretusega tegelemiseks olema lisaks tegevusloale Põllumajandus- ja Toiduameti heaks kiidetud aretusprogramm, millele nende tegevus peab vastama. (2) Kui tõusiseselt on eristatud käesoleva seaduse § 2 lõike 2 kohaselt mitu alampopulatsiooni, peab iga alampopulatsiooni kohta olema selle aretuseesmärgile vastav aretusprogramm.",
      "rdfs:label": {
        "@value": "POLLUM_Par_8 (redaktsioon 101072020010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101072020010"
    },
    {
      "@id": "estleg:POLLUM_Par_9_v224353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tunnustamist taotlevad aretusühing ja jõudluskontrolli läbiviija peavad olema võimelised osutama aretusteenust oma valitud aretusvaldkonnas, kusjuures aretusühingul või tema liikmetel peab olema aretuseduks piisav arv aretusloomi ning ohustatud tõu säilitaja peab olema võimeline läbi viima ohustatud tõu säilitusprogrammi. (2) Tunnustamist taotlev aretusühing, jõudluskontrolli läbiviija ja ohustatud tõu säilitaja peavad esitama Veterinaar- ja Toiduametile (edaspidi järelevalveasutus ) kirjaliku taotluse. Taotluses peavad olema järgmised andmed: taotleja või tema esindaja nimi ja isiku- või registrikood (isikukoodi puudumisel sünnikuupäev, -kuu ja -aasta); taotleja või tema esindaja elu- või asukoht ja aadress ning sidevahendite numbrid; tegevuspiirkond ja aretusvaldkond, mille osas tunnustamist taotletakse; taotluse koostamise kuupäev ja taotleja allkiri. (3) Aretusühing esitab koos taotlusega: ärakirja põhikirjast, millest selgub aretusvaldkond; liikmete nimekirja; ärakirja aretusprogrammist; ohustatud tõu puhul ärakirja ohustatud tõu säilitamisprogrammist. (4) Aretusprogramm on teatava tõu kohta koostatud dokument, millest selguvad aretuse eesmärk, aretusmeetodid, aretusedu saavutamise abinõud ja aretusprogrammi täitmiseks vajalik aretusloomade arv. Aretusprogrammi osadeks on: tõuraamatusse või aretusregistrisse kandmise alused ja tõuraamatu või aretusregistri pidamise kord; aretuslooma põlvnemise registreerimise ning põlvnemise õigsuse kontrollimise kord; aretuslooma jõudlusandmete ja geneetilise väärtuse hindamistulemuste kasutamise kord; aretuslooma ja aretusmaterjali aretuseks sobivaks tunnistamise kord; emaslooma seemendusandmete registreerimise kord; põllumajanduslooma, keda soovitakse tõuraamatusse või aretusregistrisse kanda, identifitseerimise ja selle üle arvestuse pidamise kord; seemendamise koolitusprogrammid ning seemendaja tunnistuse saamise nõuded ja tunnistuse väljastamise kord. (5) Aretusühing, kes tahab hakata pidama hobuslaste tõuraamatut, selle osa või aretusregistrit tõu kohta, mille originaaltõuraamatut peetakse mõnes välisriigis, peab tagama, et on täidetud originaaltõuraamatut pidava organisatsiooni või ühingu poolt sätestatud põhimõtted, ja saama sellekohase nõusoleku. (6) Jõudluskontrolli läbiviija esitab koos taotlusega: aretuslooma põlvnemis- ja jõudlusandmete kogumise, nende õigsuse kontrollimise, töötlemise ja säilitamise korra; andmed laboratooriumi kohta, kus tehakse jõudluse määramiseks vajalikke analüüse; aretuslooma jõudlusandmete ja nende hindamistulemuste avaldamise korra; jõudlusandmete kogumise koolitusprogrammid ning jõudlusandmete koguja tunnistuse saamise nõuded ja tunnistuse väljastamise korra. (7) Ohustatud tõu säilitaja esitab koos taotlusega: ärakirja põhikirjast, millest selgub aretusvaldkond; ärakirja ohustatud tõu säilitamisprogrammist, milles tuleb näidata aretamise viisid, mis tagavad ohustatud tõu säilimise.",
      "rdfs:label": {
        "@value": "POLLUM_Par_9 (redaktsioon 224353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "224353",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_9_v750669"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POLLUM_Par_9_v750669",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLLUM_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tunnustamist taotlevad aretusühing ja jõudluskontrolli läbiviija peavad olema võimelised osutama aretusteenust oma valitud aretusvaldkonnas, kusjuures aretusühingul või tema liikmetel peab olema aretuseduks piisav arv aretusloomi ning ohustatud tõu säilitaja peab olema võimeline läbi viima ohustatud tõu säilitusprogrammi. (2) Tunnustamist taotlev aretusühing, jõudluskontrolli läbiviija ja ohustatud tõu säilitaja peavad esitama Veterinaar- ja Toiduametile (edaspidi järelevalveasutus ) kirjaliku taotluse. Taotluses peavad olema järgmised andmed: taotleja või tema esindaja nimi ja isiku- või registrikood (isikukoodi puudumisel sünnikuupäev, -kuu ja -aasta); taotleja või tema esindaja elu- või asukoht ja aadress ning sidevahendite numbrid; tegevuspiirkond ja aretusvaldkond, mille osas tunnustamist taotletakse; taotluse koostamise kuupäev ja taotleja allkiri. (3) Aretusühing esitab koos taotlusega: ärakirja põhikirjast, millest selgub aretusvaldkond; liikmete nimekirja; ärakirja aretusprogrammist; ohustatud tõu puhul ärakirja ohustatud tõu säilitamisprogrammist. (4) Aretusprogramm on teatava tõu kohta koostatud dokument, millest selguvad aretuse eesmärk, aretusmeetodid, aretusedu saavutamise abinõud ja aretusprogrammi täitmiseks vajalik aretusloomade arv. Aretusprogrammi osadeks on: tõuraamatusse või aretusregistrisse kandmise alused ja tõuraamatu või aretusregistri pidamise kord; aretuslooma põlvnemise registreerimise ning põlvnemise õigsuse kontrollimise kord; aretuslooma jõudlusandmete ja geneetilise väärtuse hindamistulemuste kasutamise kord; aretuslooma ja aretusmaterjali aretuseks sobivaks tunnistamise kord; emaslooma seemendusandmete registreerimise kord; põllumajanduslooma, keda soovitakse tõuraamatusse või aretusregistrisse kanda, identifitseerimise ja selle üle arvestuse pidamise kord; seemendamise koolitusprogrammid ning seemendaja tunnistuse saamise nõuded ja tunnistuse väljastamise kord. (5) Tunnustamist taotlev aretusühing, kes tahab hakata pidama hobuslaste tõuraamatut või selle osa või aretusregistrit tõu kohta, mille orginaaltõuraamatut või -aretusregistrit juba peetakse Euroopa Liidu liikmesriigis, peab tagama, et on täidetud originaaltõuraamatut või -aretusregistrit pidava organisatsiooni või ühingu sätestatud põhimõtted. (6) Jõudluskontrolli läbiviija esitab koos taotlusega: aretuslooma põlvnemis- ja jõudlusandmete kogumise, nende õigsuse kontrollimise, töötlemise ja säilitamise korra; andmed laboratooriumi kohta, kus tehakse jõudluse määramiseks vajalikke analüüse; aretuslooma jõudlusandmete ja nende hindamistulemuste avaldamise korra; jõudlusandmete kogumise koolitusprogrammid ning jõudlusandmete koguja tunnistuse saamise nõuded ja tunnistuse väljastamise korra. (7) Ohustatud tõu säilitaja esitab koos taotlusega: ärakirja põhikirjast, millest selgub aretusvaldkond; ärakirja ohustatud tõu säilitamisprogrammist, milles tuleb näidata aretamise viisid, mis tagavad ohustatud tõu säilimise. – joust. 1. 05. 2004",
      "rdfs:label": {
        "@value": "POLLUM_Par_9 (redaktsioon 750669)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750669",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLLUM_Par_9_v963547"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-30",
        "@type": "xsd:date"
      }
    },
