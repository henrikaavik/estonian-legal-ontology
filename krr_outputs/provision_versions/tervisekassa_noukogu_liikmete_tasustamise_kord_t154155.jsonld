    },
    {
      "@id": "estleg:Reg_154155_Par_2_v154155",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154155_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõukogu liikmetele makstakse nõukogus töötamise eest ühekordses suuruses arvestusliku kuu töötasu, mis arvutatakse vastavalt töötatud ajale Vabariigi Valitsuse kehtestatud tunnitasu alammäära alusel. RT I 2018-08-18 2 118082018002 2018-09-01 Nõukogu liikmetele makstakse nõukogus töötamise eest ühekordses suuruses arvestusliku kuu töötasu, mis arvutatakse vastavalt töötatud ajale Vabariigi Valitsuse kehtestatud tunnitasu alammäära alusel.",
      "rdfs:label": {
        "@value": "Reg_154155_Par_2 (redaktsioon 154155)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154155",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154155",
      "estleg:sourceAct": "Tervisekassa nõukogu liikmete tasustamise kord",
      "estleg:provisionRef": "Reg_154155 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154155_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154155_Par_3_v154155",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154155_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nõukogu liikmetele makstakse määruse §-s 2 nimetatud tasu välja üks kord kuus. Kui nõukogu liige ei osalenud mingil ajavahemikul mõjuva põhjuseta nõukogu töös, siis selle ajavahemiku eest talle tasu ei maksta. Nõukogu liikmetele makstakse määruse §-s 2 nimetatud tasu välja üks kord kuus. Kui nõukogu liige ei osalenud mingil ajavahemikul mõjuva põhjuseta nõukogu töös, siis selle ajavahemiku eest talle tasu ei maksta. 2 (2) Nõukogu liikmetele makstakse tasu Tervisekassa eelarvest. RT I 2023-04-05 1 105042023001 2023-04-08 Nõukogu liikmetele makstakse tasu Tervisekassa eelarvest.",
      "rdfs:label": {
