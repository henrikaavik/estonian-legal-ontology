      }
    },
    {
      "@id": "estleg:Reg_158188_Par_6_v158188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158188_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arstiõppe läbimisel omandab üliõpilane: 1 1) piisavad teadmised meditsiiniga seotud teadusharudest ning hea teadusmeetodite rakendamise oskuse, sealhulgas bioloogiliste funktsioonide mõõtmise, teaduslikult tõendatud faktide hindamise ja andmete analüüsimise oskuse; 2 2) piisavad teadmised inimese normaalsest ja patoloogilisest anatoomiast, füsioloogiast ja käitumisest, samuti inimese tervisliku seisundi ja tema elukeskkonna vahelistest suhetest; 3 3) piisavad teadmised kliinilistest distsipliinidest ja meetoditest, mis annavad ülevaatliku pildi psüühilistest ja füüsilistest haigustest, haiguste profülaktikast, diagnoosimisest ja ravist ning inimese reproduktiivsusest; 4 4) küllaldased kliinilised kogemused asjakohase järelevalve all. Arstiõppe läbimisel omandab üliõpilane: piisavad teadmised meditsiiniga seotud teadusharudest ning hea teadusmeetodite rakendamise oskuse, sealhulgas bioloogiliste funktsioonide mõõtmise, teaduslikult tõendatud faktide hindamise ja andmete analüüsimise oskuse; piisavad teadmised inimese normaalsest ja patoloogilisest anatoomiast, füsioloogiast ja käitumisest, samuti inimese tervisliku seisundi ja tema elukeskkonna vahelistest suhetest; piisavad teadmised kliinilistest distsipliinidest ja meetoditest, mis annavad ülevaatliku pildi psüühilistest ja füüsilistest haigustest, haiguste profülaktikast, diagnoosimisest ja ravist ning inimese reproduktiivsusest; küllaldased kliinilised kogemused asjakohase järelevalve all.",
      "rdfs:label": {
        "@value": "Reg_158188_Par_6 (redaktsioon 158188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158188",
      "estleg:sourceAct": "Arstiõppe, loomaarstiõppe, proviisoriõppe, hambaarstiõppe, ämmaemandaõppe, õeõppe, arhitektiõppe ja ehitusinseneriõppe raamnõuded",
      "estleg:provisionRef": "Reg_158188 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158188_Map_2026"
      }
    },
