    {
      "@id": "estleg:Reg_158188_Par_28_v158188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158188_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ämmaemandaõpe lõpeb lõpueksami sooritamisega või lõputöö kaitsmisega. Ämmaemandaõpe lõpeb lõpueksami sooritamisega või lõputöö kaitsmisega. 2 (2) Ämmaemandaõppe lõpetanud isikule annab rakenduskõrgkool diplomi õppekava täitmise ja bakalaureusekraadi andmise kohta, akadeemilise õiendi ja ingliskeelse akadeemilise õiendi. RT I 2019-07-31 1 131072019001 2019-09-01 Ämmaemandaõppe lõpetanud isikule annab rakenduskõrgkool diplomi õppekava täitmise ja bakalaureusekraadi andmise kohta, akadeemilise õiendi ja ingliskeelse akadeemilise õiendi. 3 (3) Ämmaemandaõppe lõpetanud isikul on õigus jätkata õpinguid magistriõppes õppeasutuse nõukogu kehtestatud tingimustel ja korras. Ämmaemandaõppe lõpetanud isikul on õigus jätkata õpinguid magistriõppes õppeasutuse nõukogu kehtestatud tingimustel ja korras. 4 (4) Kehtetu - RT I 2010 28 148 13321389 2010-06-12 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_158188_Par_28 (redaktsioon 158188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158188",
      "estleg:sourceAct": "Arstiõppe, loomaarstiõppe, proviisoriõppe, hambaarstiõppe, ämmaemandaõppe, õeõppe, arhitektiõppe ja ehitusinseneriõppe raamnõuded",
      "estleg:provisionRef": "Reg_158188 § 28",
