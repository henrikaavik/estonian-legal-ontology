      "estleg:provisionRef": "Reg_158188 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158188_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158188_Par_12_v158188",
      "@type": [
