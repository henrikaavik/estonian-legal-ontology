      "estleg:versionText": "Loomaarstiõppe alustamise tingimus on keskharidus või sellele vastav kvalifikatsioon. RT I 2019-07-31 1 131072019001 2019-09-01 Loomaarstiõppe alustamise tingimus on keskharidus või sellele vastav kvalifikatsioon.",
      "rdfs:label": {
        "@value": "Reg_158188_Par_10 (redaktsioon 158188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158188",
      "estleg:sourceAct": "Arstiõppe, loomaarstiõppe, proviisoriõppe, hambaarstiõppe, ämmaemandaõppe, õeõppe, arhitektiõppe ja ehitusinseneriõppe raamnõuded",
