    {
      "@id": "estleg:Reg_158188_Par_5_v158188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158188_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arstiõppe alustamise tingimus on keskharidus või sellele vastav kvalifikatsioon. RT I 2019-07-31 1 131072019001 2019-09-01 Arstiõppe alustamise tingimus on keskharidus või sellele vastav kvalifikatsioon.",
      "rdfs:label": {
        "@value": "Reg_158188_Par_5 (redaktsioon 158188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158188",
      "estleg:sourceAct": "Arstiõppe, loomaarstiõppe, proviisoriõppe, hambaarstiõppe, ämmaemandaõppe, õeõppe, arhitektiõppe ja ehitusinseneriõppe raamnõuded",
      "estleg:provisionRef": "Reg_158188 § 5",
