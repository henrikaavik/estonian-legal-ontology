    {
      "@id": "estleg:Reg_158188_Par_34_v158188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158188_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Arhitektiõppe nominaalkestus on 5 aastat ja õppekavas määratud õppe maht 300 ainepunkti. RT I 2010 28 148 13321389 2010-06-12 Arhitektiõppe nominaalkestus on 5 aastat ja õppekavas määratud õppe maht 300 ainepunkti. 2 (2) Arhitektiõpe koosneb teoreetilisest ja praktilisest õppest, mis peavad olema tasakaalus ja omavahel kooskõlas. Arhitektiõpe toimub ülikoolis. Arhitektiõpe koosneb teoreetilisest ja praktilisest õppest, mis peavad olema tasakaalus ja omavahel kooskõlas. Arhitektiõpe toimub ülikoolis. 3 (3) Kehtetu - RT I 2016-01-12 11 112012016011 2016-01-18 Kehtetu - 4 (4) Arhitektiõppes moodustab lõputöö õppekavas määratud õppe mahust vähemalt 15 ainepunkti. RT I 2010 28 148 13321389 2010-06-12 Arhitektiõppes moodustab lõputöö õppekavas määratud õppe mahust vähemalt 15 ainepunkti.",
      "rdfs:label": {
        "@value": "Reg_158188_Par_34 (redaktsioon 158188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158188",
      "estleg:sourceAct": "Arstiõppe, loomaarstiõppe, proviisoriõppe, hambaarstiõppe, ämmaemandaõppe, õeõppe, arhitektiõppe ja ehitusinseneriõppe raamnõuded",
      "estleg:provisionRef": "Reg_158188 § 34",
