      }
    },
    {
      "@id": "estleg:Reg_158188_Par_43_v158188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158188_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ehitusinseneriõpe lõpeb lõputöö kaitsmisega. Ehitusinseneriõpe lõpeb lõputöö kaitsmisega. 2 (2) Ehitusinseneriõppe lõpetanud isikule annab ülikool diplomi õppekava täitmise ja magistrikraadi andmise kohta, akadeemilise õiendi ja ingliskeelse akadeemilise õiendi. RT I 2019-07-31 1 131072019001 2019-09-01 Ehitusinseneriõppe lõpetanud isikule annab ülikool diplomi õppekava täitmise ja magistrikraadi andmise kohta, akadeemilise õiendi ja ingliskeelse akadeemilise õiendi. 3 (3) Ehitusinseneriõppe lõpetanud isikul on õigus jätkata õpinguid doktoriõppes ülikooli nõukogu kehtestatud korras. Ehitusinseneriõppe lõpetanud isikul on õigus jätkata õpinguid doktoriõppes ülikooli nõukogu kehtestatud korras. 4 (4) Kehtetu - RT I 2010 28 148 13321389 2010-06-12 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_158188_Par_43 (redaktsioon 158188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158188",
      "estleg:sourceAct": "Arstiõppe, loomaarstiõppe, proviisoriõppe, hambaarstiõppe, ämmaemandaõppe, õeõppe, arhitektiõppe ja ehitusinseneriõppe raamnõuded",
      "estleg:provisionRef": "Reg_158188 § 43",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158188_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158188_Par_44_v158188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158188_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kuni 1. septembrini 2006. a võib ämmaemandaõpe ja õeõpe toimuda rakenduskõrgharidusõpet läbiviivas õppeasutuses. Kuni 1. septembrini 2006. a võib ämmaemandaõpe ja õeõpe toimuda rakenduskõrgharidusõpet läbiviivas õppeasutuses. 2 (2) Enne 2010/2011. õppeaastat arstiõppesse, hambaarstiõppesse, loomaarstiõppesse, proviisoriõppesse, õeõppesse või ämmaemandaõppesse vastu võetud üliõpilastele rakendatakse õppekava, kus lõputöö või lõpueksam moodustab õppekavas määratud õppe mahust vähemalt 3 ainepunkti. RT I 2010 28 148 13321389 2010-06-12 Enne 2010/2011. õppeaastat arstiõppesse, hambaarstiõppesse, loomaarstiõppesse, proviisoriõppesse, õeõppesse või ämmaemandaõppesse vastu võetud üliõpilastele rakendatakse õppekava, kus lõputöö või lõpueksam moodustab õppekavas määratud õppe mahust vähemalt 3 ainepunkti. 3 (3) Enne 2019/2020. õppeaastat ämmaemanda- või õeõppesse vastuvõetud üliõpilasele antakse õppekava täies mahus täitmisel rakenduskõrghariduse diplom. RT I 2019-07-31 1 131072019001 2019-09-01 Enne 2019/2020. õppeaastat ämmaemanda- või õeõppesse vastuvõetud üliõpilasele antakse õppekava täies mahus täitmisel rakenduskõrghariduse diplom.",
      "rdfs:label": {
        "@value": "Reg_158188_Par_44 (redaktsioon 158188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158188",
