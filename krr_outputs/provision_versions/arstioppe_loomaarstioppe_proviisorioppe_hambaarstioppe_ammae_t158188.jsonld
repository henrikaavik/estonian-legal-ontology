      },
      "estleg:versionText": "Hambaarstiõppe alustamise tingimus on keskharidus või sellele vastav kvalifikatsioon. RT I 2019-07-31 1 131072019001 2019-09-01 Hambaarstiõppe alustamise tingimus on keskharidus või sellele vastav kvalifikatsioon.",
      "rdfs:label": {
        "@value": "Reg_158188_Par_20 (redaktsioon 158188)",
        "@language": "et"
      },
