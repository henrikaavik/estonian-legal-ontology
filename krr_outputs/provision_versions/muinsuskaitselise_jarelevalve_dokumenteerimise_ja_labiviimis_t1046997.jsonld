      "estleg:provisionRef": "Reg_1046997 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046997_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046997_Par_5_v1046997",
      "@type": [
        "owl:NamedIndividual",
