    {
      "@id": "estleg:Reg_1046997_Par_8_v1046997",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046997_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotlus jäetakse rahuldamata, kui: 1 1) muinsuskaitseline järelevalve ei ole läbi viidud nõuetekohaselt; 2 2) muinsuskaitselist järelevalvet ei ole teinud pädev isik; 3 3) amet ei ole järelevalve aruannet heaks kiitnud; 4 4) taotleja on esitanud valeandmeid. Taotlus jäetakse rahuldamata, kui: muinsuskaitseline järelevalve ei ole läbi viidud nõuetekohaselt; muinsuskaitselist järelevalvet ei ole teinud pädev isik; amet ei ole järelevalve aruannet heaks kiitnud; taotleja on esitanud valeandmeid.",
      "rdfs:label": {
        "@value": "Reg_1046997_Par_8 (redaktsioon 1046997)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046997",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046997",
      "estleg:sourceAct": "Muinsuskaitselise järelevalve dokumenteerimise ja läbiviimisega seotud kulu hüvitamise ning kinnismälestisel ja vallasmälestisel tehtud tööde dokumenteerimise kord",
      "estleg:provisionRef": "Reg_1046997 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046997_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046997_Par_9_v1046997",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046997_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui muinsuskaitselist järelevalvet ei ole määratud, dokumenteerib kinnismälestisel ja muinsuskaitsealal paikneval ehitisel tehtud töö tegija ja koostab sellekohase aruande. Kui muinsuskaitselist järelevalvet ei ole määratud, dokumenteerib kinnismälestisel ja muinsuskaitsealal paikneval ehitisel tehtud töö tegija ja koostab sellekohase aruande. 2 (2) Töö aruandes esitatakse: 1 1) kasutatud materjalide loetelu; 2 2) kasutatud metoodika kirjeldus; 3 3) teostusjoonised ja fotod, sealhulgas mälestise kaetud või varjatud osade kohta, millega töid tehti. Töö aruandes esitatakse: kasutatud materjalide loetelu; kasutatud metoodika kirjeldus; teostusjoonised ja fotod, sealhulgas mälestise kaetud või varjatud osade kohta, millega töid tehti.",
      "rdfs:label": {
        "@value": "Reg_1046997_Par_9 (redaktsioon 1046997)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046997",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046997",
      "estleg:sourceAct": "Muinsuskaitselise järelevalve dokumenteerimise ja läbiviimisega seotud kulu hüvitamise ning kinnismälestisel ja vallasmälestisel tehtud tööde dokumenteerimise kord",
      "estleg:provisionRef": "Reg_1046997 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046997_Map"
      }
    },
