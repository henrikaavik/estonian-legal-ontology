        "@type": "xsd:date"
      },
      "estleg:versionText": "Muinsuskaitselise järelevalve kulu hüvitatakse 50% ulatuses muinsuskaitselise järelevalve läbiviimise kulust, kuid mitte rohkem kui üks tuhat viissada eurot. Muinsuskaitselise järelevalve kulu hüvitatakse 50% ulatuses muinsuskaitselise järelevalve läbiviimise kulust, kuid mitte rohkem kui üks tuhat viissada eurot.",
      "rdfs:label": {
        "@value": "Reg_1046997_Par_5 (redaktsioon 1046997)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046997",
