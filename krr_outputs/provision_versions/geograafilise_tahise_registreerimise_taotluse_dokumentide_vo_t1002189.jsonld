      }
    },
    {
      "@id": "estleg:Reg_1002189_Par_9_v1002189",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002189_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Avalduses viidatakse geograafilise tähise kaitse seaduse § 9 lõike 1 vastavale punktile, mille alusel taotleja geograafilise tähise registreerimist taotleb. Avalduses viidatakse geograafilise tähise kaitse seaduse § 9 lõike 1 vastavale punktile, mille alusel taotleja geograafilise tähise registreerimist taotleb. 2 (2) Kui taotleja on Eesti ametiasutus, viidatakse avalduses lisaks lõikes 1 nimetatule geograafilise tähise kaitse seaduse § 9 lõike 3 alusel antud Vabariigi Valitsuse määruse sättele, millega antakse sellele asutusele õigus geograafilise tähise registreerimist taotleda. Välisriigi asutuse korral võib avalduses näidata, millise õigusaktiga on asutusele vastav õigus antud. Kui taotleja on Eesti ametiasutus, viidatakse avalduses lisaks lõikes 1 nimetatule geograafilise tähise kaitse seaduse § 9 lõike 3 alusel antud Vabariigi Valitsuse määruse sättele, millega antakse sellele asutusele õigus geograafilise tähise registreerimist taotleda. Välisriigi asutuse korral võib avalduses näidata, millise õigusaktiga on asutusele vastav õigus antud.",
      "rdfs:label": {
        "@value": "Reg_1002189_Par_9 (redaktsioon 1002189)",
        "@language": "et"
      },
