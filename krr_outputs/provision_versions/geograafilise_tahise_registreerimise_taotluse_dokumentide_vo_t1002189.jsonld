      }
    },
    {
      "@id": "estleg:Reg_1002189_Par_8_v1002189",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002189_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Geograafilise tähise reproduktsioon peab andma täieliku ülevaate geograafilisest tähisest. Geograafilise tähise reproduktsioon peab andma täieliku ülevaate geograafilisest tähisest. 2 (2) Kehtetu - RT I 2023-09-08 1 108092023001 2023-09-11 Kehtetu - 3 (3) Geograafilise tähise graafiline või fotograafiline reproduktsioon kantakse avaldusele mõõtmetega 80 × 80 mm. Geograafilise tähise graafiline või fotograafiline reproduktsioon kantakse avaldusele mõõtmetega 80 × 80 mm. 4 (4) Kehtetu - RT I 2023-09-08 1 108092023001 2023-09-11 Kehtetu - 5 (5) Geograafilise tähise reproduktsiooni juurde võib lisada tähise kohta selgituse, millel ei ole õiguslikku tähendust. Geograafilise tähise reproduktsiooni juurde võib lisada tähise kohta selgituse, millel ei ole õiguslikku tähendust.",
      "rdfs:label": {
        "@value": "Reg_1002189_Par_8 (redaktsioon 1002189)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002189",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002189",
      "estleg:sourceAct": "Geograafilise tähise registreerimise taotluse dokumentide vorminõuded",
      "estleg:provisionRef": "Reg_1002189 § 8",
