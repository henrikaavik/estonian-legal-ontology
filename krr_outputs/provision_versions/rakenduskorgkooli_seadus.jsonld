    {
      "@id": "estleg:RakKKS_Par_20_v13000988",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RakKKS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Täiendusõpe on täiskasvanute koolituse seaduse tähenduses tööalane koolitus ning võimaldab kutse-, ameti- ning erialaste teadmiste, oskuste ja vilumuste omandamist ja täiendamist, samuti ümberõpet. (2) Rakenduskõrgkoolis korraldatava täiendusõppe vormid ja täiendusõppe läbiviimise korra kehtestab rakenduskõrgkooli nõukogu",
      "rdfs:label": {
        "@value": "RakKKS_Par_20 (redaktsioon 13000988)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13000988",
      "estleg:supersededByVersion": {
        "@id": "estleg:RakKKS_Par_20_v130052012006"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RakKKS_Par_20_v130052012006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RakKKS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Täiendusõpe on täiskasvanute koolituse seaduse tähenduses tööalane koolitus ning võimaldab kutse-, ameti- ning erialaste teadmiste, oskuste ja vilumuste omandamist ja täiendamist, samuti ümberõpet. (2) Rakenduskõrgkoolis korraldatava täiendusõppe vormid ja täiendusõppe läbiviimise korra kehtestab rakenduskõrgkooli nõukogu.",
      "rdfs:label": {
        "@value": "RakKKS_Par_20 (redaktsioon 130052012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130052012006",
