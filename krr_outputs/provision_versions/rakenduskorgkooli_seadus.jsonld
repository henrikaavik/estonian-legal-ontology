      },
      "estleg:versionText": "Ministeerium, kelle valitsemisalasse rakenduskõrgkool kuulub, teostab rakenduskõrgkooli tegevuse üle teenistuslikku järelevalvet seaduses sätestatud korras.",
      "rdfs:label": {
