      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RakKKS_Par_16_v215321",
      "@type": [
        "owl:NamedIndividual",
