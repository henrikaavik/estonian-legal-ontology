    {
      "@id": "estleg:RakKKS_Par_16_v22416",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RakKKS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rakenduskõrgkooli õppekava kinnitab haridusminister. (2) Pärast õppekava kinnitamist kantakse rakenduskõrgkooli õppekava Haridusministeeriumi õppekavade registrisse vastavalt haridusministri määrusega kehtestatud korrale.",
      "rdfs:label": {
        "@value": "RakKKS_Par_16 (redaktsioon 22416)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22416",
