      }
    },
    {
      "@id": "estleg:Reg_1043571_Par_9_v1043571",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043571_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseväe peastaap on sõjaaja üksus ja alaliselt tegutsev struktuuriüksus. Kaitseväe peastaap on sõjaaja üksus ja alaliselt tegutsev struktuuriüksus. 2 (2) Kaitseväe peastaabi põhiülesanded on: 1 1) toetada Kaitseväe juhatajat ja Kaitseväe juhataja asetäitja tegevust ning tagada nende käskude täitmine; 2 2) planeerida Kaitseväe tegevust; 3 3) nõustada, juhendada, koordineerida ja kontrollida Kaitseväe üksuste tegevust. Kaitseväe peastaabi põhiülesanded on: toetada Kaitseväe juhatajat ja Kaitseväe juhataja asetäitja tegevust ning tagada nende käskude täitmine; planeerida Kaitseväe tegevust; nõustada, juhendada, koordineerida ja kontrollida Kaitseväe üksuste tegevust.",
      "rdfs:label": {
        "@value": "Reg_1043571_Par_9 (redaktsioon 1043571)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043571",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043571",
      "estleg:sourceAct": "Kaitseväe põhimäärus",
      "estleg:provisionRef": "Reg_1043571 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043571_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043571_Par_9_9_v1043571",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043571_Par_9_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Diviis on sõjaaja üksus ja alaliselt tegutsev struktuuriüksus. Diviis on sõjaaja üksus ja alaliselt tegutsev struktuuriüksus. 2 (2) Diviisi põhiülesanne on oma vastutusalas planeerida ja teostada koosseisus olevate ja ajutiselt allutatud üksustega, sealhulgas välisriigi relvajõudude üksustega, sõjalisi operatsioone. Diviisi põhiülesanne on oma vastutusalas planeerida ja teostada koosseisus olevate ja ajutiselt allutatud üksustega, sealhulgas välisriigi relvajõudude üksustega, sõjalisi operatsioone. 3 (3) Diviisi koosseisus on: 1 1) 1. jalaväebrigaad; 2 2) 2. jalaväebrigaad; 2 2¹) suurtükiväerügement; RT I 2025-07-29 3 129072025003 2025-08-01 3 3) logistikapataljon; 4 4) staabi- ja sidepataljon. Diviisi koosseisus on: 1. jalaväebrigaad; 2. jalaväebrigaad; suurtükiväerügement; logistikapataljon; staabi- ja sidepataljon. 4 (4) Diviisi põhimääruses võib ette näha diviisi ülema alluvuses muid üksuseid. RT I 2022-12-14 12 114122022012 2022-12-17 Diviisi põhimääruses võib ette näha diviisi ülema alluvuses muid üksuseid.",
      "rdfs:label": {
        "@value": "Reg_1043571_Par_9_9 (redaktsioon 1043571)",
        "@language": "et"
      },
