    {
      "@id": "estleg:Reg_1043571_Par_16_17_v1043571",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043571_Par_16_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tulevikuvõime ja innovatsiooni väejuhatus on alaliselt tegutsev struktuuriüksus. Tulevikuvõime ja innovatsiooni väejuhatus on alaliselt tegutsev struktuuriüksus. 2 (2) Tulevikuvõime ja innovatsiooni väejuhatuse põhiülesanne on koordineerida Kaitseväe võitlusvõime jätkusuutlikku arengut. Tulevikuvõime ja innovatsiooni väejuhatuse põhiülesanne on koordineerida Kaitseväe võitlusvõime jätkusuutlikku arengut. 3 (3) Tulevikuvõime ja innovatsiooni väejuhatuse tegevusvaldkonnad põhiülesande täitmiseks on järgmised: 1 1) sõjaliste nõuete ajakohasuse tagamine, lähtudes ohukeskkonnast ja tehnoloogilistest arengusuundadest; 2 2) strateegiliste ressursside planeerimine ning kaitse-eelarve jaotuste sidumine tegelike vajadustega; 3 3) Kaitseväe võimevajadustest ja eelarvelistest võimalustest lähtuv riigivara omandamise korraldamine. RT I 2025-10-15 1 115102025001 2025-10-18 Tulevikuvõime ja innovatsiooni väejuhatuse tegevusvaldkonnad põhiülesande täitmiseks on järgmised: sõjaliste nõuete ajakohasuse tagamine, lähtudes ohukeskkonnast ja tehnoloogilistest arengusuundadest; strateegiliste ressursside planeerimine ning kaitse-eelarve jaotuste sidumine tegelike vajadustega; Kaitseväe võimevajadustest ja eelarvelistest võimalustest lähtuv riigivara omandamise korraldamine.",
      "rdfs:label": {
        "@value": "Reg_1043571_Par_16_17 (redaktsioon 1043571)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043571",
