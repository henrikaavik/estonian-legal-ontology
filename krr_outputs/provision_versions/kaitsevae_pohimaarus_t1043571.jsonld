      "estleg:provisionRef": "Reg_1043571 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043571_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043571_Par_14_v1043571",
      "@type": [
        "owl:NamedIndividual",
