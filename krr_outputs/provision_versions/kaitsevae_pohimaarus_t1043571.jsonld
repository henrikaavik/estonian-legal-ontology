    {
      "@id": "estleg:Reg_1043571_Par_12_v1043571",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043571_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maakaitse on sõjaaja üksus. Maakaitse on sõjaaja üksus. 2 (2) Maakaitse põhiülesanne on oma vastutusalas planeerida ja teostada koosseisus olevate ja ajutiselt allutatud üksustega sõjalisi operatsioone. Maakaitse põhiülesanne on oma vastutusalas planeerida ja teostada koosseisus olevate ja ajutiselt allutatud üksustega sõjalisi operatsioone. 2 (2¹) Lõikes 2 sätestatud põhiülesande ettevalmistamist korraldab Kaitseväe juhataja. RT I 2022-12-14 12 114122022012 2022-12-17 Lõikes 2 sätestatud põhiülesande ettevalmistamist korraldab Kaitseväe juhataja. 3 (3) Maakaitse koosseisus on neli territoriaalset maakaitseringkonda. Maakaitse koosseisus on neli territoriaalset maakaitseringkonda.",
      "rdfs:label": {
        "@value": "Reg_1043571_Par_12 (redaktsioon 1043571)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043571",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043571",
      "estleg:sourceAct": "Kaitseväe põhimäärus",
      "estleg:provisionRef": "Reg_1043571 § 12",
