      "estleg:sourceAct": "Perioodi 2021–2027 starditoetuse andmise ja kasutamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1058347 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058347_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058347_Par_24_v1058347",
      "@type": [
        "owl:NamedIndividual",
