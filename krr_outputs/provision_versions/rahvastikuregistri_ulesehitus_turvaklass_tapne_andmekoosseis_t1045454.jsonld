    {
      "@id": "estleg:Reg_1045454_Par_40_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registri aktuaalsetele andmetele juurdepääsupiirangu kehtestamisel rahvastikuregistri seaduse § 57 alusel edastab püsijuurdepääsuga andmetöötleja juurdepääsupiirangu kehtestamise avalduse digitaalselt registri volitatud töötlejale. Registri aktuaalsetele andmetele juurdepääsupiirangu kehtestamisel rahvastikuregistri seaduse § 57 alusel edastab püsijuurdepääsuga andmetöötleja juurdepääsupiirangu kehtestamise avalduse digitaalselt registri volitatud töötlejale. 2 (2) Välisriigi dokumendi andmete kandmisel registrisse rahvastikuregistri seaduse § 29 lõike 2 alusel edastab dokumendi vastuvõtja selle registri volitatud töötlejale digitaalselt koos tõlkega eesti, inglise või vene keelde. Välisriigi dokumendi andmete kandmisel registrisse rahvastikuregistri seaduse § 29 lõike 2 alusel edastab dokumendi vastuvõtja selle registri volitatud töötlejale digitaalselt koos tõlkega eesti, inglise või vene keelde. 3 (3) Kehtetu - RT I 2025-11-25 3 125112025003 2025-12-02 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_40 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 40",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_41_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Transpordiamet annab dokumendi- ja sellega seotud andmed juhiloa kohta, samuti andmed lisa-aadresside ja kontaktandmete kohta ning edastab elukohateate. RT I 2022-05-19 1 119052022001 2022-05-22 Transpordiamet annab dokumendi- ja sellega seotud andmed juhiloa kohta, samuti andmed lisa-aadresside ja kontaktandmete kohta ning edastab elukohateate. 2 (2) Transpordiamet annab menetluslikud andmed isikukoodi andmise menetluse kohta. RT I 2024-05-22 1 122052024001 2024-05-25 Transpordiamet annab menetluslikud andmed isikukoodi andmise menetluse kohta.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_41 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 41",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_42_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Politsei- ja Piirivalveamet annab dokumendi- ja sellega seotud andmed järgmiste dokumentide kohta: 1 1) isikutunnistus; 2 2) elamisloakaart; 3 3) Eesti kodaniku pass; 4 4) Politsei- ja Piirivalveameti otsus Eesti kodakondsuse kaotamise kohta mõne muu riigi kodakondsuse vastuvõtmise või Eesti kodakondsusest loobumise tõttu; 5 5) Vabariigi Valitsuse korraldus Eesti kodakondsuse andmise või taastamise kohta; 6 6) Vabariigi Valitsuse korraldus Eesti kodakondsusest vabastamise või Eesti kodakondsuse äravõtmise kohta; 7 7) meremehe teenistusraamat; 8 8) meresõidutunnistus; 9 9) välismaalase pass; 10 10) pagulase reisidokument; 11 11) ajutine reisidokument; 12 12) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 13 13) tähtajalise elamisloa andmise otsus; 14 14) tähtajalise elamisloa pikendamise otsus; 15 15) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 16 16) tähtajalise elamisloa kehtetuks tunnistamise otsus; 17 17) pikaajalise elaniku elamisloa andmise otsus; 18 18) pikaajalise elaniku elamisloa kehtetuks tunnistamise otsus; 19 19) tähtajalise elamisõiguse andmise otsus; 20 20) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 21 21) tähtajalise elamisõiguse pikendamise otsus; 22 22) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 23 23) tähtajalise elamisõiguse lõpetamise otsus; 24 24) alalise elamisõiguse registreerimise otsus; 25 25) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 26 26) alalise elamisõiguse lõpetamise otsus; 27 27) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 28 28) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 29 29) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 30 30) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 31 31) kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 32 32) teade § 27 punktis 1 või 2 nimetatud dokumendi kehtivusaja lõppemisest tuleneva viibimisõiguse olemasolu ja kehtivuse kohta; RT I 2024-05-22 1 122052024001 2024-05-25 33 33) e-residendi digitaalse isikutunnistuse väljaandja teade e-residentsuse olemasolu ja kehtivuse kohta. RT I 2024-05-22 1 122052024001 2024-05-25 Politsei- ja Piirivalveamet annab dokumendi- ja sellega seotud andmed järgmiste dokumentide kohta: isikutunnistus; elamisloakaart; Eesti kodaniku pass; Politsei- ja Piirivalveameti otsus Eesti kodakondsuse kaotamise kohta mõne muu riigi kodakondsuse vastuvõtmise või Eesti kodakondsusest loobumise tõttu; Vabariigi Valitsuse korraldus Eesti kodakondsuse andmise või taastamise kohta; Vabariigi Valitsuse korraldus Eesti kodakondsusest vabastamise või Eesti kodakondsuse äravõtmise kohta; meremehe teenistusraamat; meresõidutunnistus; välismaalase pass; pagulase reisidokument; ajutine reisidokument; kehtetu - tähtajalise elamisloa andmise otsus; tähtajalise elamisloa pikendamise otsus; kehtetu - tähtajalise elamisloa kehtetuks tunnistamise otsus; pikaajalise elaniku elamisloa andmise otsus; pikaajalise elaniku elamisloa kehtetuks tunnistamise otsus; tähtajalise elamisõiguse andmise otsus; kehtetu - tähtajalise elamisõiguse pikendamise otsus; kehtetu - tähtajalise elamisõiguse lõpetamise otsus; alalise elamisõiguse registreerimise otsus; kehtetu - alalise elamisõiguse lõpetamise otsus; kehtetu - kehtetu - kehtetu - kehtetu - kehtetu - teade § 27 punktis 1 või 2 nimetatud dokumendi kehtivusaja lõppemisest tuleneva viibimisõiguse olemasolu ja kehtivuse kohta; e-residendi digitaalse isikutunnistuse väljaandja teade e-residentsuse olemasolu ja kehtivuse kohta. 2 (2) Kehtetu - RT I 2024-05-22 1 122052024001 2024-05-25 Kehtetu - 3 (3) Politsei- ja Piirivalveamet annab andmed lisa-aadresside, kontaktandmete ja ütluspõhiste andmete kohta. RT I 2024-05-22 1 122052024001 2024-05-25 Politsei- ja Piirivalveamet annab andmed lisa-aadresside, kontaktandmete ja ütluspõhiste andmete kohta.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_42 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
