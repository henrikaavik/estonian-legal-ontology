      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantavad viibimiskoha aadressi andmed on järgmised: 1 1) viibimiskoha aadress; 2 2) viibimiskoha aadressil viibimise alguse ja lõppemise aeg. Registrisse kantavad viibimiskoha aadressi andmed on järgmised: viibimiskoha aadress; viibimiskoha aadressil viibimise alguse ja lõppemise aeg.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_12 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
