      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_30_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantavad andmed registrisse andmete andmise kohta on järgmised: 1 1) andmete registrisse kandmise aeg; 2 2) andmete andmise aeg; 3 3) registrisse kande tegija nimi või nimetus, isiku- või registrikood; 4 4) andmeandja nimi või nimetus ning isiku- või registrikood. Registrisse kantavad andmed registrisse andmete andmise kohta on järgmised: andmete registrisse kandmise aeg; andmete andmise aeg; registrisse kande tegija nimi või nimetus, isiku- või registrikood; andmeandja nimi või nimetus ning isiku- või registrikood.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_30 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_31_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kande tegemise alusdokumendi andmed on järgmised: 1 1) dokumendi liik; 2 2) dokumendi nimetus; 3 3) dokumendi number; 4 4) dokumendi koostamise, väljaandmise, jõustumise, kehtetuks tunnistamise või tühistamise aeg või kehtivuse tähtaeg; 5 5) dokumendi koostanud, välja andnud, tühistanud või kehtetuks tunnistanud asutuse nimetus ja asukoha riik ning olemasolu korral vastava toimingu teinud isiku ees- ja perekonnanimi ja isikukood; 6 6) andmehõivekande aluseks olev skaneeritud dokument. Kande tegemise alusdokumendi andmed on järgmised: dokumendi liik; dokumendi nimetus; dokumendi number; dokumendi koostamise, väljaandmise, jõustumise, kehtetuks tunnistamise või tühistamise aeg või kehtivuse tähtaeg; dokumendi koostanud, välja andnud, tühistanud või kehtetuks tunnistanud asutuse nimetus ja asukoha riik ning olemasolu korral vastava toimingu teinud isiku ees- ja perekonnanimi ja isikukood; andmehõivekande aluseks olev skaneeritud dokument.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_31 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 31",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_32_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantavad andmetele juurdepääsu andmed on järgmised: 1 1) andmesaaja nimi või nimetus ning isiku- või registrikood; 2 2) viide andmetele, millele võimaldati juurdepääs; 3 3) andmetele juurdepääsu viis; 4 4) andmetele juurdepääsu aeg. Registrisse kantavad andmetele juurdepääsu andmed on järgmised: andmesaaja nimi või nimetus ning isiku- või registrikood; viide andmetele, millele võimaldati juurdepääs; andmetele juurdepääsu viis; andmetele juurdepääsu aeg.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_32 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 32",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_33_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantavad andmetele juurdepääsu piirangute andmed on järgmised: 1 1) juurdepääsupiirangu alus; 2 2) juurdepääsupiirangu ulatus; 3 3) juurdepääsupiirangu taotleja nimi või nimetus ning isiku- või registrikood; 4 4) juurdepääsupiirangu tähtaeg. Registrisse kantavad andmetele juurdepääsu piirangute andmed on järgmised: juurdepääsupiirangu alus; juurdepääsupiirangu ulatus; juurdepääsupiirangu taotleja nimi või nimetus ning isiku- või registrikood; juurdepääsupiirangu tähtaeg.",
      "rdfs:label": {
