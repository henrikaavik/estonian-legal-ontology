    {
      "@id": "estleg:Reg_1045454_Par_13_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantavad perekonnaseisu andmed on järgmised: 1 1) vallaline, kui on tõendatud või on alust eeldada, et isik ei ole olnud kunagi abielus ega registreeritud kooselus; RT I 2023-09-28 3 128092023003 2023-10-01 2 2) abielus, kui isiku kohta on registrisse kantud kehtiva abielu sõlmimist tõendava dokumendi andmed; 3 3) lahutatud, kui isiku kohta on registrisse kantud perekonnaseisu kajastava viimase dokumendina abielu lahutamist tõendava dokumendi andmed; 4 4) lesk, kui isiku kohta on registrisse kantud perekonnaseisu kajastava viimase dokumendina abielu sõlmimist tõendava dokumendi andmed ja see abielu on lõppenud abikaasa surmaga; 4 4¹) registreeritud kooselus, kui isiku kohta on registrisse kantud kehtiva kooselulepingu sõlmimist tõendava dokumendi andmed; RT I 2023-09-28 3 128092023003 2023-10-01 4 4²) registreeritud kooselu lõpetatud, kui isiku kohta on registrisse kantud perekonnaseisu kajastava viimase dokumendina kooselulepingu lõpetamist tõendava dokumendi andmed; RT I 2023-09-28 3 128092023003 2023-10-01 4 4³) registreeritud kooselu lõppenud, kui isiku kohta on registrisse kantud perekonnaseisu kajastava viimase dokumendina kooselulepingu sõlmimist tõendava dokumendi andmed ja see registreeritud kooselu on lõppenud registreeritud elukaaslase surmaga; RT I 2023-09-28 3 128092023003 2023-10-01 5 5) dokumenteerimata abielus, dokumenteerimata lahutatud või dokumenteerimata lesk, kui isiku perekonnaseis on registrisse kantud rahvastiku arvestuse andmebaasist ja registrisse ei ole kantud nende andmete kandmise aluseks olnud perekonnaseisudokumentide andmeid. RT I 2019-07-31 2 131072019002 2019-08-03 Registrisse kantavad perekonnaseisu andmed on järgmised: vallaline, kui on tõendatud või on alust eeldada, et isik ei ole olnud kunagi abielus ega registreeritud kooselus; abielus, kui isiku kohta on registrisse kantud kehtiva abielu sõlmimist tõendava dokumendi andmed; lahutatud, kui isiku kohta on registrisse kantud perekonnaseisu kajastava viimase dokumendina abielu lahutamist tõendava dokumendi andmed; lesk, kui isiku kohta on registrisse kantud perekonnaseisu kajastava viimase dokumendina abielu sõlmimist tõendava dokumendi andmed ja see abielu on lõppenud abikaasa surmaga; registreeritud kooselus, kui isiku kohta on registrisse kantud kehtiva kooselulepingu sõlmimist tõendava dokumendi andmed; registreeritud kooselu lõpetatud, kui isiku kohta on registrisse kantud perekonnaseisu kajastava viimase dokumendina kooselulepingu lõpetamist tõendava dokumendi andmed; registreeritud kooselu lõppenud, kui isiku kohta on registrisse kantud perekonnaseisu kajastava viimase dokumendina kooselulepingu sõlmimist tõendava dokumendi andmed ja see registreeritud kooselu on lõppenud registreeritud elukaaslase surmaga; dokumenteerimata abielus, dokumenteerimata lahutatud või dokumenteerimata lesk, kui isiku perekonnaseis on registrisse kantud rahvastiku arvestuse andmebaasist ja registrisse ei ole kantud nende andmete kandmise aluseks olnud perekonnaseisudokumentide andmeid.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_13 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_14_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantavad hooldusõiguse andmed on järgmised: 1 1) ees- ja perekonnanimi või asutuse nimetus; 2 2) isiku- või registrikood; 3 3) hooldusõiguse osaline või täielik üleandmine; 4 4) hooldusõiguse peatumine, ennistamine ja taastamine; 5 5) hooldusõiguse piiramine; 6 6) hooldusõiguse täielik äravõtmine; 7 7) lapse eraldamine perekonnast; 8 8) hooldusõiguse alguse ja lõppemise aeg. Registrisse kantavad hooldusõiguse andmed on järgmised: ees- ja perekonnanimi või asutuse nimetus; isiku- või registrikood; hooldusõiguse osaline või täielik üleandmine; hooldusõiguse peatumine, ennistamine ja taastamine; hooldusõiguse piiramine; hooldusõiguse täielik äravõtmine; lapse eraldamine perekonnast; hooldusõiguse alguse ja lõppemise aeg.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_14 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_15_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_15"
      },
