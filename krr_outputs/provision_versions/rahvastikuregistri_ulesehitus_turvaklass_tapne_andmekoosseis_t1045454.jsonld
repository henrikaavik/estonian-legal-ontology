    {
      "@id": "estleg:Reg_1045454_Par_21_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045454_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registrisse kantakse andmed järgmiste isikut tõendavate dokumentide kohta: 1 1) isikutunnistus; 2 2) pass; 3 3) elamisloakaart; 4 4) diplomaatiline pass; 5 5) meremehe teenistusraamat; 6 6) meresõidutunnistus; 7 7) ajutine reisidokument; 8 8) pagulase reisidokument; 9 9) juhiluba. Registrisse kantakse andmed järgmiste isikut tõendavate dokumentide kohta: isikutunnistus; pass; elamisloakaart; diplomaatiline pass; meremehe teenistusraamat; meresõidutunnistus; ajutine reisidokument; pagulase reisidokument; juhiluba. 2 (2) Lõike 1 punktides 3–8 sätestatud dokumentide kohta ei kanta andmeid registrisse, kui dokumendid on välja antud välisriigis. RT I 2024-05-22 1 122052024001 2024-05-25 Lõike 1 punktides 3–8 sätestatud dokumentide kohta ei kanta andmeid registrisse, kui dokumendid on välja antud välisriigis.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_21 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
