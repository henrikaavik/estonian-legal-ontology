      "estleg:provisionRef": "Reg_1045454 § 1_1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_2_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
