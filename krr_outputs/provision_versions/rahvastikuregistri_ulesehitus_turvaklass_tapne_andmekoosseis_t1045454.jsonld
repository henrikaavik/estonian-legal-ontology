        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantavad eestkoste andmed on järgmised: 1 1) ees- ja perekonnanimi või asutuse nimetus; 2 2) isiku- või registrikood; 3 3) eestkoste alguse ja lõppemise aeg; 4 4) tehingud, mida eestkostetav võib teha eestkostja nõusolekuta. Registrisse kantavad eestkoste andmed on järgmised: ees- ja perekonnanimi või asutuse nimetus; isiku- või registrikood; eestkoste alguse ja lõppemise aeg; tehingud, mida eestkostetav võib teha eestkostja nõusolekuta.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_15 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_16_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
