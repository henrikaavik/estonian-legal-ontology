      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantakse andmed kontaktandmete valideerimise kehtivuse kohta. Andmed kontaktandmete valideerimise kehtivuse kohta annab vaid andmeandja, kellele see käesoleva määrusega on eraldi ette nähtud. RT I 2025-11-25 3 125112025003 2025-12-02 Registrisse kantakse andmed kontaktandmete valideerimise kehtivuse kohta. Andmed kontaktandmete valideerimise kehtivuse kohta annab vaid andmeandja, kellele see käesoleva määrusega on eraldi ette nähtud.",
      "rdfs:label": {
        "@value": "Reg_1045454_Par_11_12 (redaktsioon 1045454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045454",
      "estleg:sourceAct": "Rahvastikuregistri ülesehitus, turvaklass, täpne andmekoosseis ja andmeandjate üleantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1045454 § 11_12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045454_Par_12_v1045454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
