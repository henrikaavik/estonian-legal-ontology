        "@value": "2020-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandus- ja taristuministri 24. septembri 2015. a määrus nr 116 „Ehitise auditi tegemise kord” tunnistatakse kehtetuks. Majandus- ja taristuministri 24. septembri 2015. a määrus nr 116 „Ehitise auditi tegemise kord” tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1050333_Par_11 (redaktsioon 1050333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050333",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050333",
      "estleg:sourceAct": "Ehitise auditi tegemise kord",
