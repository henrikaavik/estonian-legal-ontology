    {
      "@id": "estleg:Reg_1050333_Par_7_v1050333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050333_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitise korralise auditi juhud ja sagedus võivad tuleneda: 1 1) õigusaktist; 2 2) kasutusloa või ehitusseadustiku § 48 lõikes 6 sätestatud haldusakti kõrvaltingimustest; 3 3) hooldusjuhendist; 4 4) eelnevast auditi aruandest. Ehitise korralise auditi juhud ja sagedus võivad tuleneda: õigusaktist; kasutusloa või ehitusseadustiku § 48 lõikes 6 sätestatud haldusakti kõrvaltingimustest; hooldusjuhendist; eelnevast auditi aruandest.",
      "rdfs:label": {
        "@value": "Reg_1050333_Par_7 (redaktsioon 1050333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050333",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050333",
      "estleg:sourceAct": "Ehitise auditi tegemise kord",
      "estleg:provisionRef": "Reg_1050333 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050333_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050333_Par_8_v1050333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050333_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitise erakorraline audit tehakse: 1 1) õnnetusjuhtumi, avarii, tehnosüsteemi rikke või muu ehitise või ehitise osa nõuetele mittevastavuse põhjuse tuvastamiseks; 2 2) ehitise või ehitise osa nõuetele vastavuse hindamiseks või vajadusel enne ehitusprojekti koostamist olemasoleva ehitise kohta eelhinnangu saamiseks; 3 3) ehitusseadustiku ja planeerimisseaduse rakendamise seaduse § 28 lõikes 6 või § 29 lõikes 6 toodud ehitusprojekti asendamiseks; 4 4) ehitusdokumentide asendamiseks, kui ehitusdokumendid on puudulikud määral, mis takistab pädeval asutusel andmast hinnangut kasutusloa menetluses või kasutusteatise kontrollimisel. Ehitise erakorraline audit tehakse: õnnetusjuhtumi, avarii, tehnosüsteemi rikke või muu ehitise või ehitise osa nõuetele mittevastavuse põhjuse tuvastamiseks; ehitise või ehitise osa nõuetele vastavuse hindamiseks või vajadusel enne ehitusprojekti koostamist olemasoleva ehitise kohta eelhinnangu saamiseks; ehitusseadustiku ja planeerimisseaduse rakendamise seaduse § 28 lõikes 6 või § 29 lõikes 6 toodud ehitusprojekti asendamiseks; ehitusdokumentide asendamiseks, kui ehitusdokumendid on puudulikud määral, mis takistab pädeval asutusel andmast hinnangut kasutusloa menetluses või kasutusteatise kontrollimisel.",
      "rdfs:label": {
        "@value": "Reg_1050333_Par_8 (redaktsioon 1050333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050333",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050333",
      "estleg:sourceAct": "Ehitise auditi tegemise kord",
      "estleg:provisionRef": "Reg_1050333 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050333_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050333_Par_9_v1050333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050333_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Auditi aruanne esitatakse ehitisregistrile elektroonselt. Auditi aruanne esitatakse ehitisregistrile elektroonselt. 2 (2) Ehitise omanik või auditi tellija säilitab auditi aruannet vähemalt seitse aastat. Ehitise omanik või auditi tellija säilitab auditi aruannet vähemalt seitse aastat.",
