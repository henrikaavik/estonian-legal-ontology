      "estleg:versionValidFrom": {
        "@value": "2019-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõrgkool valdab, kasutab ja käsutab kõrgharidusseadusest ja põhimäärusest tulenevate eesmärkide saavutamiseks kõrgkooli kasutusse antud riigivara riigivaraseadusega sätestatud korras. Kõrgkool valdab, kasutab ja käsutab kõrgharidusseadusest ja põhimäärusest tulenevate eesmärkide saavutamiseks kõrgkooli kasutusse antud riigivara riigivaraseadusega sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1047543_Par_26 (redaktsioon 1047543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047543",
