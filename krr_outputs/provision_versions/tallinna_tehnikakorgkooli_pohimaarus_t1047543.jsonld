    {
      "@id": "estleg:Reg_1047543_Par_15_v1047543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047543_Par_15"
