    {
      "@id": "estleg:Reg_1047543_Par_3_v1047543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047543_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõrgkoolil on väikese riigivapi kujutise ja oma nimega pitsat, riigikassa ühendkontserni koosseisu kuuluvad arvelduskontod ning oma eelarve. Kõrgkoolil on väikese riigivapi kujutise ja oma nimega pitsat, riigikassa ühendkontserni koosseisu kuuluvad arvelduskontod ning oma eelarve.",
      "rdfs:label": {
        "@value": "Reg_1047543_Par_3 (redaktsioon 1047543)",
        "@language": "et"
      },
