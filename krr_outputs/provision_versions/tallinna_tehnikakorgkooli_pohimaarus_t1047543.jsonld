    {
      "@id": "estleg:Reg_1047543_Par_31_v1047543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047543_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kõrgkooli rektori ja nõukogu õigusaktid viiakse põhimäärusega vastavusse selle jõustumise päevast arvates kolme kuu jooksul. Kõrgkooli rektori ja nõukogu õigusaktid viiakse põhimäärusega vastavusse selle jõustumise päevast arvates kolme kuu jooksul. 2 (2) Seoses Tallinna Tehnikakõrgkooli ja Lääne-Viru Rakenduskõrgkooli ümberkorraldamisega viia nõukogu koosseis alates määruse jõustumisest kolme kuu jooksul kooskõlla käesoleva määruse § 6 lõikega 3. Seoses Tallinna Tehnikakõrgkooli ja Lääne-Viru Rakenduskõrgkooli ümberkorraldamisega viia nõukogu koosseis alates määruse jõustumisest kolme kuu jooksul kooskõlla käesoleva määruse § 6 lõikega 3.",
      "rdfs:label": {
        "@value": "Reg_1047543_Par_31 (redaktsioon 1047543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047543",
      "estleg:sourceAct": "Tallinna Tehnikakõrgkooli põhimäärus",
      "estleg:provisionRef": "Reg_1047543 § 31",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047543_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047543_Par_32_v1047543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047543_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhimäärus jõustub 1. septembril 2019. aastal. Põhimäärus jõustub 1. septembril 2019. aastal.",
      "rdfs:label": {
        "@value": "Reg_1047543_Par_32 (redaktsioon 1047543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047543",
