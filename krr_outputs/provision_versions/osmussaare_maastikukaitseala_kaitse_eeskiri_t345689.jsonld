    {
      "@id": "estleg:Reg_345689_Par_14_v345689",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345689_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine; 2 2) õhuliinide ja muude kommunikatsioonide rajamine; 3 3) rahvaürituste korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohtades. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine; õhuliinide ja muude kommunikatsioonide rajamine; rahvaürituste korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohtades.",
      "rdfs:label": {
        "@value": "Reg_345689_Par_14 (redaktsioon 345689)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345689",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345689",
      "estleg:sourceAct": "Osmussaare maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_345689 § 14",
      "estleg:partOfAct": {
