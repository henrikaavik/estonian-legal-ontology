      }
    },
    {
      "@id": "estleg:Reg_345689_Par_11_v345689",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345689_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on poollooduslike koosluste esinemisaladel vajalik nende ilme ja liigikoosseisu taastamiseks ja säilitamiseks heina ja roo niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine ja kujundamine. Sihtkaitsevööndis on poollooduslike koosluste esinemisaladel vajalik nende ilme ja liigikoosseisu taastamiseks ja säilitamiseks heina ja roo niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine ja kujundamine.",
      "rdfs:label": {
        "@value": "Reg_345689_Par_11 (redaktsioon 345689)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345689",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345689",
      "estleg:sourceAct": "Osmussaare maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_345689 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345689_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_345689_Par_12_v345689",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
