      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maa-ametil kanda muudetud piirilõigud ja lahkmejooned riigi maakatastrikaardile. Peaminister Mart LAAR Siseminister Tarmo LOODUS Riigisekretär Aino LEPIK von WIRÉN",
