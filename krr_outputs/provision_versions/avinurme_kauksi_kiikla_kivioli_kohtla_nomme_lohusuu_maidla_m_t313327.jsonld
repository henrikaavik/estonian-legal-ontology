    {
      "@id": "estleg:Reg_313327_Par_5_v313327",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313327_Par_5"
