      "estleg:provisionRef": "Reg_313327 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313327_Map"
      }
    },
    {
      "@id": "estleg:Reg_313327_Par_8_v313327",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313327_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mäetaguse jahipiirkonna pindala on 9600 hektarit. Mäetaguse jahipiirkonna pindala on 9600 hektarit. 2 (2) Mäetaguse jahipiirkonna piirikirjeldus on järgmine: Mäetaguse jahipiirkonna piirikirjeldus on järgmine: Mäetaguse jahipiirkonna piir läheb Iisaku–Mäetaguse maantee ja Mäetaguse tee ristumiskohast mööda Mäetaguse teed Kohtla-Järve–Mäetaguse maanteeni, jätkudes mööda Kohtla-Järve–Mäetaguse maanteed Jõhvi–Tartu maanteeni; teeristist mööda Jõhvi–Tartu maanteed Iisaku–Avinurme maanteeni; siis mööda Iisaku–Avinurme maanteed Saarevälja ojani ning mööda Saarevälja oja Mäetaguse jõeni, jätkudes mööda Mäetaguse jõge Metsküla teeni; edasi mööda Metsküla teed Iisaku–Mäetaguse maanteeni ning mööda Iisaku–Mäetaguse maanteed Mäetaguse teeni. Mäetaguse jahipiirkonna piir läheb Iisaku–Mäetaguse maantee ja Mäetaguse tee ristumiskohast mööda Mäetaguse teed Kohtla-Järve–Mäetaguse maanteeni, jätkudes mööda Kohtla-Järve–Mäetaguse maanteed Jõhvi–Tartu maanteeni; teeristist mööda Jõhvi–Tartu maanteed Iisaku–Avinurme maanteeni; siis mööda Iisaku–Avinurme maanteed Saarevälja ojani ning mööda Saarevälja oja Mäetaguse jõeni, jätkudes mööda Mäetaguse jõge Metsküla teeni; edasi mööda Metsküla teed Iisaku–Mäetaguse maanteeni ning mööda Iisaku–Mäetaguse maanteed Mäetaguse teeni.",
      "rdfs:label": {
        "@value": "Reg_313327_Par_8 (redaktsioon 313327)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313327",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313327",
      "estleg:sourceAct": "Avinurme, Kauksi, Kiikla, Kiviõli, Kohtla-Nõmme, Lohusuu, Maidla, Mäetaguse, Ontika, Oonurme ja Tudulinna jahipiirkonna moodustamine",
      "estleg:provisionRef": "Reg_313327 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313327_Map"
      }
    },
    {
      "@id": "estleg:Reg_313327_Par_9_v313327",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313327_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ontika jahipiirkonna pindala on 10 070 hektarit. Ontika jahipiirkonna pindala on 10 070 hektarit. 2 (2) Ontika jahipiirkonna piirikirjeldus on järgmine: Ontika jahipiirkonna piirikirjeldus on järgmine: Ontika jahipiirkonna piir läheb Saka oja suudmest Soome lahes mööda Soome lahe rannajoont Toila sadama läänepiirini (jahipiirkonna juurde kuulub mere akvatooriumi osa, mis ulatub 200 meetri kaugusele rannajoonest); edasi mööda Toila sadama läänepiiri sadama teeni, jätkudes mööda sadama teed Toila–Kõrve maanteeni ning mööda Toila–Kõrve maanteed Tallinna–Narva maanteeni; teeristist mööda Tallinna–Narva maanteed Kalevi teeni ning mööda Kalevi teed Uus Tehase teeni; sealt mööda Uus Tehase teed Nitroferti raudteeni, jätkudes mööda Nitroferti raudteed Pavandu teeni ning mööda Pavandu teed Tallinna–Narva maanteeni; teeristist mööda Tallinna–Narva maanteed Kolga–Saka maanteeni; seejärel mööda Kolga–Saka maanteed Saka ojani ning mööda Saka oja selle suudmeni Soome lahes. Ontika jahipiirkonna piir läheb Saka oja suudmest Soome lahes mööda Soome lahe rannajoont Toila sadama läänepiirini (jahipiirkonna juurde kuulub mere akvatooriumi osa, mis ulatub 200 meetri kaugusele rannajoonest); edasi mööda Toila sadama läänepiiri sadama teeni, jätkudes mööda sadama teed Toila–Kõrve maanteeni ning mööda Toila–Kõrve maanteed Tallinna–Narva maanteeni; teeristist mööda Tallinna–Narva maanteed Kalevi teeni ning mööda Kalevi teed Uus Tehase teeni; sealt mööda Uus Tehase teed Nitroferti raudteeni, jätkudes mööda Nitroferti raudteed Pavandu teeni ning mööda Pavandu teed Tallinna–Narva maanteeni; teeristist mööda Tallinna–Narva maanteed Kolga–Saka maanteeni; seejärel mööda Kolga–Saka maanteed Saka ojani ning mööda Saka oja selle suudmeni Soome lahes.",
      "rdfs:label": {
        "@value": "Reg_313327_Par_9 (redaktsioon 313327)",
        "@language": "et"
      },
