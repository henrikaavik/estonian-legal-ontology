    {
      "@id": "estleg:Reg_1043729_Par_17_v1043729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043729_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitatud töötleja võib andmeid muuta: 1 1) andmete parandamiseks; 2 2) uute andmete registrisse kandmiseks; 3 3) kande alusandmete muutumisel; 4 4) kande alusandmete kehtivuse tähtaja möödumisel; 5 5) muul õigusaktist tuleneval põhjusel. Volitatud töötleja võib andmeid muuta: andmete parandamiseks; uute andmete registrisse kandmiseks; kande alusandmete muutumisel; kande alusandmete kehtivuse tähtaja möödumisel; muul õigusaktist tuleneval põhjusel.",
      "rdfs:label": {
        "@value": "Reg_1043729_Par_17 (redaktsioon 1043729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043729",
