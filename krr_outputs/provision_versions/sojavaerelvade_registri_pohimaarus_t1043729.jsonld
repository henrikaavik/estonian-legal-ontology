      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseliit edastab relvaseaduse § 241 lõigetes 21 ja 22 sätestatud andmed jooksva kalendriaasta 30. juuni ja 31. detsembri seisuga. Andmed edastatakse 10 kalendripäeva jooksul käesoleva lõike esimeses lauses nimetatud tähtpäeva möödumisest. RT I 2024-06-29 33 129062024033 2024-07-02 Kaitseliit edastab relvaseaduse § 241 lõigetes 21 ja 22 sätestatud andmed jooksva kalendriaasta 30. juuni ja 31. detsembri seisuga. Andmed edastatakse 10 kalendripäeva jooksul käesoleva lõike esimeses lauses nimetatud tähtpäeva möödumisest.",
      "rdfs:label": {
