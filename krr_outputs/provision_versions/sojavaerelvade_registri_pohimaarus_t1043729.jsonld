        "@id": "estleg:Reg_1043729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043729_Par_7_v1043729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043729_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseliidu tavaregistri turbeaste on keskmine (M) ja registri turvaklass on K2T2S2. Kaitseliidu tavaregistri turbeaste on keskmine (M) ja registri turvaklass on K2T2S2. 2 (2) Kaitseväe relvaregistri, Välisluureameti relvaregistri ja Kaitseliidu piiratud registri turvalisuse tagamisel kohaldatakse riigisaladuse ja salastatud välisteabe seaduses ning selle alusel antud õigusaktides elektroonilisele teabeturbele sätestatut. Kaitseväe relvaregistri, Välisluureameti relvaregistri ja Kaitseliidu piiratud registri turvalisuse tagamisel kohaldatakse riigisaladuse ja salastatud välisteabe seaduses ning selle alusel antud õigusaktides elektroonilisele teabeturbele sätestatut.",
      "rdfs:label": {
        "@value": "Reg_1043729_Par_7 (redaktsioon 1043729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043729",
      "estleg:sourceAct": "Sõjaväerelvade registri põhimäärus",
      "estleg:provisionRef": "Reg_1043729 § 7",
