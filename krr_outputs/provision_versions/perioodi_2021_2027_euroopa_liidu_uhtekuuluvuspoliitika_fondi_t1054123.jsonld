    {
      "@id": "estleg:Reg_1054123_Par_18_v1054123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054123_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Auditeeriva asutuse arvamuse ja auditeerimise aastaaruande kinnitab auditeeriva asutuse juht. Auditeeriva asutuse arvamuse ja auditeerimise aastaaruande kinnitab auditeeriva asutuse juht. 2 (2) Auditeeriva asutuse arvamus ja auditeerimise aastaaruanne esitatakse Euroopa Komisjonile aruandeaastale järgneva aasta 15. veebruariks alates 2023. aastast kuni 2031. aastani. Tähtaeg võib pikeneda Euroopa Komisjoniga peetavate läbirääkimiste tulemusena 1. märtsini. Auditeeriva asutuse arvamus ja auditeerimise aastaaruanne esitatakse Euroopa Komisjonile aruandeaastale järgneva aasta 15. veebruariks alates 2023. aastast kuni 2031. aastani. Tähtaeg võib pikeneda Euroopa Komisjoniga peetavate läbirääkimiste tulemusena 1. märtsini.",
      "rdfs:label": {
        "@value": "Reg_1054123_Par_18 (redaktsioon 1054123)",
