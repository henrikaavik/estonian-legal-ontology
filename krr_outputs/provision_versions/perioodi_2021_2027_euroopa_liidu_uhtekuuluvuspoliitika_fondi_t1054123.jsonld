    {
      "@id": "estleg:Reg_1054123_Par_19_v1054123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054123_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Interregi programmide elluviimise auditeerimisel kohaldatakse määruses sätestatut, arvestades Euroopa Parlamendi ja nõukogu määrusest (EL) 2021/1059, mis käsitleb Euroopa Regionaalarengu Fondist ja välistegevuse rahastusest toetatava Euroopa territoriaalse koostöö eesmärgi (Interreg) erisätteid (ELT L 231, 30.6.2021, lk 94–158), tulenevate erisustega. Interregi programmide elluviimise auditeerimisel kohaldatakse määruses sätestatut, arvestades Euroopa Parlamendi ja nõukogu määrusest (EL) 2021/1059, mis käsitleb Euroopa Regionaalarengu Fondist ja välistegevuse rahastusest toetatava Euroopa territoriaalse koostöö eesmärgi (Interreg) erisätteid (ELT L 231, 30.6.2021, lk 94–158), tulenevate erisustega.",
      "rdfs:label": {
        "@value": "Reg_1054123_Par_19 (redaktsioon 1054123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054123",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054123",
      "estleg:sourceAct": "Perioodi 2021–2027 Euroopa Liidu ühtekuuluvuspoliitika fondide vahendite kasutamise auditeerimine",
      "estleg:provisionRef": "Reg_1054123 § 19",
