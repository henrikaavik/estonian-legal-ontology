      },
      "estleg:versionText": "Auditeeriv asutus esitab iga aruandeaasta kohta korraldusasutusele teabe juhtkonna kinnituse koostamiseks ja vajaduse korral täiendavat informatsiooni. Auditeeriv asutus esitab iga aruandeaasta kohta korraldusasutusele teabe juhtkonna kinnituse koostamiseks ja vajaduse korral täiendavat informatsiooni.",
      "rdfs:label": {
        "@value": "Reg_1054123_Par_17 (redaktsioon 1054123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054123",
