      "dc:source": "Haridusasutuses mahepõllumajandusliku toidu ja mahepõllumajanduslikke koostisosi sisaldava toidu pakkumise toetus"
    },
    {
      "@id": "estleg:Reg_1054538_Par_1_v1054538",
      "@type": [
        "owl:NamedIndividual",
