      "estleg:provisionRef": "Reg_1049238 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049238_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1049238_Par_12_v1049238",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049238_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vesiviljelusrajatise käitamise kohta peab pidama arvestust käitamispäevikus. Vesiviljelusrajatise käitamise kohta peab pidama arvestust käitamispäevikus. 2 (2) Sõltuvalt kasvanduse liigist peab käitamispäevikus kajastuma järgmine info: 1 1) kasvanduses olevate tiikide, basseinide või sumpade arv, nende ruumala ja pindala; 2 2) karbi- ja vetikaliinide arv, pikkus ja pindala või muu sarnase rajatise iseloomustus; 3 3) sumpade, karbi- ja vetikaliinide paigaldamise ja äraviimise aeg; 4 4) kasvandusse toodud ja äraviidud isendite kogus, liiginimetus, aeg; 5 5) kasutatava sööda nimetus, päevane kogus (kg/päevas), üldlämmastiku ja üldfosfori sisaldus (%); 6 6) kvartaalne veevõtt (m³); 7 7) eemaldatud kalakasvatussette kogus (t/a); 8 8) kemikaalide ja ravimite kasutamine (nimetused, kogused); 9 9) muud asjakohased andmed, mis määratakse veeloas. Sõltuvalt kasvanduse liigist peab käitamispäevikus kajastuma järgmine info: kasvanduses olevate tiikide, basseinide või sumpade arv, nende ruumala ja pindala; karbi- ja vetikaliinide arv, pikkus ja pindala või muu sarnase rajatise iseloomustus; sumpade, karbi- ja vetikaliinide paigaldamise ja äraviimise aeg; kasvandusse toodud ja äraviidud isendite kogus, liiginimetus, aeg; kasutatava sööda nimetus, päevane kogus (kg/päevas), üldlämmastiku ja üldfosfori sisaldus (%); kvartaalne veevõtt (m³); eemaldatud kalakasvatussette kogus (t/a); kemikaalide ja ravimite kasutamine (nimetused, kogused); muud asjakohased andmed, mis määratakse veeloas.",
      "rdfs:label": {
        "@value": "Reg_1049238_Par_12 (redaktsioon 1049238)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049238",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049238",
