      }
    },
    {
      "@id": "estleg:Reg_1000856_Par_12_v1000856",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000856_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui langeb ära välis- või julgeolekupoliitiline vajadus eksperdi osalemiseks missioonil, võib eksperdi lähetaja ta missioonilt tagasi kutsuda. Kui langeb ära välis- või julgeolekupoliitiline vajadus eksperdi osalemiseks missioonil, võib eksperdi lähetaja ta missioonilt tagasi kutsuda.",
      "rdfs:label": {
        "@value": "Reg_1000856_Par_12 (redaktsioon 1000856)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000856",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000856",
      "estleg:sourceAct": "Eksperdi rahvusvahelisele tsiviilmissioonile lähetamise ja sealt tagasikutsumise kord ning tsiviilmissioonile lähetatud eksperdi kulude katmise ulatus, tingimused ja kord",
      "estleg:provisionRef": "Reg_1000856 § 12",
