      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eksperdi rahvusvahelisele tsiviilmissioonile lähetamise ja sealt tagasikutsumise kord ning tsiviilmissioonile lähetatud eksperdi kulude katmise ulatus, tingimused ja kord (21 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eksperdi rahvusvahelisele tsiviilmissioonile lähetamise ja sealt tagasikutsumise kord ning tsiviilmissioonile lähetatud eksperdi kulude katmise ulatus, tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1000856_Par_1_v1000856",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000856_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse: 1 1) eksperdi rahvusvahelisele tsiviilmissioonile (edaspidi missioon) lähetamise kord; 2 2) eksperdi missioonilt tagasikutsumise kord; 3 3) pikaajalisele missioonile lähetatud eksperdi kulude katmise ulatus, tingimused ja kord; 4 4) lühiajalisele missioonile lähetatud eksperdi kulude katmise ulatus, tingimused ja kord; 5 5) kiireloomulisele missioonile lähetatud eksperdi kulude katmise ulatus, tingimused ja kord. Määrusega kehtestatakse: eksperdi rahvusvahelisele tsiviilmissioonile (edaspidi missioon) lähetamise kord; eksperdi missioonilt tagasikutsumise kord; pikaajalisele missioonile lähetatud eksperdi kulude katmise ulatus, tingimused ja kord; lühiajalisele missioonile lähetatud eksperdi kulude katmise ulatus, tingimused ja kord; kiireloomulisele missioonile lähetatud eksperdi kulude katmise ulatus, tingimused ja kord.",
      "rdfs:label": {
        "@value": "Reg_1000856_Par_1 (redaktsioon 1000856)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000856",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000856",
