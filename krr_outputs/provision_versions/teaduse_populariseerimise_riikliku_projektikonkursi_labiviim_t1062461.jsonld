      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Teaduse populariseerimise riikliku projektikonkursi läbiviimise tingimused ja kord (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teaduse populariseerimise riikliku projektikonkursi läbiviimise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1062461_Par_1_v1062461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062461_Par_1"
