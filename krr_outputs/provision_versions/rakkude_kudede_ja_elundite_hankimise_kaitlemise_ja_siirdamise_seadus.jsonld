      },
      "estleg:versionValidFrom": {
        "@value": "2017-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rakkude, kudede ja elundite hankimis- ja käitlemisnõuete rikkumise eest – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "RKEHKS_Par_47 (redaktsioon 109032017002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109032017002"
    },
    {
      "@id": "estleg:RKEHKS_Par_48_v126022015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
