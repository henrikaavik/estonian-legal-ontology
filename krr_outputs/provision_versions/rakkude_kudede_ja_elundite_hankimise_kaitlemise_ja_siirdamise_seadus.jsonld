    },
    {
      "@id": "estleg:RKEHKS_Par_49_v126022015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKEHKS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 46–48 sätestatud väärtegudele kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. (2) Käesoleva seaduse §-s 46 sätestatud väärteo kohtuväline menetleja on politseiasutus. (3) Käesoleva seaduse §-s 47 sätestatud väärteo kohtuväline menetleja on Ravimiamet. (4) Käesoleva seaduse §-s 48 sätestatud väärteo kohtuväline menetleja on Terviseamet.",
      "rdfs:label": {
        "@value": "RKEHKS_Par_49 (redaktsioon 126022015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126022015001",
      "estleg:supersededByVersion": {
