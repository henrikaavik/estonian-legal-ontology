        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete täitmise üle teostab riiklikku järelevalvet Tehnilise Järelevalve Amet.",
      "rdfs:label": {
        "@value": "SeOS_Par_14 (redaktsioon 123032015004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015004",
      "estleg:supersededByVersion": {
        "@id": "estleg:SeOS_Par_14_v112122018063"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032015004",
      "estleg:sourceAct": "Seadme ohutuse seadus",
      "estleg:provisionRef": "SeOS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:SeOS_Map"
      }
    },
    {
      "@id": "estleg:SeOS_Par_14_v112122018063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SeOS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete täitmise üle teostab riiklikku järelevalvet Tarbijakaitse ja Tehnilise Järelevalve Amet.",
      "rdfs:label": {
        "@value": "SeOS_Par_14 (redaktsioon 112122018063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112122018063",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112122018063",
      "estleg:sourceAct": "Seadme ohutuse seadus",
      "estleg:provisionRef": "SeOS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:SeOS_Map"
      }
    },
    {
      "@id": "estleg:SeOS_Par_15_v123032015004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SeOS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tehnilise Järelevalve Amet võib riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 49, 50, 51, 52 ja 53 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras. (2) Tehnilise Järelevalve Amet võib seadme kasutamise peatamise ettekirjutusega koos kasutada erivahendina seadme kasutamist takistavaid või seadme kasutamist tuvastavaid tehnilisi tõkkeid. Tehnilist tõket võib kasutada, kui on alust arvata, et seadme kasutamist jätkatakse hoolimata ettekirjutusega määratud keelust ja seadme kasutamisega kaasneks vahetu oht inimese elule või tervisele, asjale või keskkonnale. Tehnilise tõkke kasutamine lõpetatakse ettekirjutuses kirjeldatud ohu kõrvaldamise korral. (3) Tehnilise Järelevalve Amet võib selgitada välja seadme, seadmetööde või seadmega seotud protsesside tõttu toimunud avariide ja õnnetusjuhtumite tehnilisi tekkepõhjusi.",
      "rdfs:label": {
        "@value": "SeOS_Par_15 (redaktsioon 123032015004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015004",
      "estleg:supersededByVersion": {
        "@id": "estleg:SeOS_Par_15_v112122018063"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032015004",
      "estleg:sourceAct": "Seadme ohutuse seadus",
      "estleg:provisionRef": "SeOS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:SeOS_Map"
      }
    },
    {
      "@id": "estleg:SeOS_Par_15_v112122018063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SeOS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tarbijakaitse ja Tehnilise Järelevalve Amet võib riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 49, 50, 51, 52 ja 53 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras. (2) Tarbijakaitse ja Tehnilise Järelevalve Amet võib seadme kasutamise peatamise ettekirjutusega koos kasutada erivahendina seadme kasutamist takistavaid või seadme kasutamist tuvastavaid tehnilisi tõkkeid. Tehnilist tõket võib kasutada, kui on alust arvata, et seadme kasutamist jätkatakse hoolimata ettekirjutusega määratud keelust ja seadme kasutamisega kaasneks vahetu oht inimese elule või tervisele, asjale või keskkonnale. Tehnilise tõkke kasutamine lõpetatakse ettekirjutuses kirjeldatud ohu kõrvaldamise korral. (3) Tarbijakaitse ja Tehnilise Järelevalve Amet võib selgitada välja seadme, seadmetööde või seadmega seotud protsesside tõttu toimunud avariide ja õnnetusjuhtumite tehnilisi tekkepõhjusi.",
      "rdfs:label": {
        "@value": "SeOS_Par_15 (redaktsioon 112122018063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112122018063",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112122018063",
      "estleg:sourceAct": "Seadme ohutuse seadus",
      "estleg:provisionRef": "SeOS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:SeOS_Map"
      }
    },
    {
      "@id": "estleg:SeOS_Par_16_v123032015004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SeOS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seadme kasutusele võtmise või kasutamise või seadmetööle esitatud nõuete rikkumise eest, kui sellega põhjustati oht või tekitati kahju inimese elule või tervisele, asjale või keskkonnale, –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, −karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "SeOS_Par_16 (redaktsioon 123032015004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015004",
