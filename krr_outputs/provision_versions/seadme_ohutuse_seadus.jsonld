      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadusega tunnistatakse kehtetuks: surveseadme ohutuse seadus; küttegaasi ohutuse seadus; masina ohutuse seadus; elektriohutusseadus; lifti ja köistee ohutuse seadus.",
      "rdfs:label": {
        "@value": "SeOS_Par_27 (redaktsioon 123032015004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015004",
