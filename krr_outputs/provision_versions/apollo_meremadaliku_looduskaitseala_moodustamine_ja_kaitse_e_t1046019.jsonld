    {
      "@id": "estleg:Reg_1046019_Par_9_v1046019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046019_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-02-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 14. novembri 2016. a käskkirjaga nr 1-2/16/1129 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 14. novembri 2016. a käskkirjaga nr 1-2/16/1129 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
