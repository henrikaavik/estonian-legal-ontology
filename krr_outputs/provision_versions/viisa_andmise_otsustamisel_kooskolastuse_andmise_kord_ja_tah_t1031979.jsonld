      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Viisa andmise otsustamisel kooskõlastuse andmise kord ja tähtajad ning viisa andmise kooskõlastamiseks ja Euroopa Liidu ühtses viisainfosüsteemis andmete töötlemiseks pädevad asutused (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Viisa andmise otsustamisel kooskõlastuse andmise kord ja tähtajad ning viisa andmise kooskõlastamiseks ja Euroopa Liidu ühtses viisainfosüsteemis andmete töötlemiseks pädevad asutused"
    },
    {
      "@id": "estleg:Reg_1031979_Par_1_v1031979",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031979_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse: 1 1) viisa andmise otsustamisel kooskõlastuse andmise kord ja tähtajad; 2 2) viisa andmise kooskõlastamiseks pädevate asutuste loetelu; 3 3) Schengeni konventsiooni liikmesriigi pädeva asutuse antud ühtse viisa alase teabevahetuse korraldamiseks pädevate asutuste loetelu; 4 4) Euroopa Liidu ühtses viisainfosüsteemis (VIS) andmete töötlemiseks pädevate asutuste loetelu. Määrusega kehtestatakse: viisa andmise otsustamisel kooskõlastuse andmise kord ja tähtajad; viisa andmise kooskõlastamiseks pädevate asutuste loetelu; Schengeni konventsiooni liikmesriigi pädeva asutuse antud ühtse viisa alase teabevahetuse korraldamiseks pädevate asutuste loetelu; Euroopa Liidu ühtses viisainfosüsteemis (VIS) andmete töötlemiseks pädevate asutuste loetelu.",
      "rdfs:label": {
        "@value": "Reg_1031979_Par_1 (redaktsioon 1031979)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031979",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031979",
