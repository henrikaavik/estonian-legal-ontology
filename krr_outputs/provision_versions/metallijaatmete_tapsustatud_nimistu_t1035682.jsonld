      "estleg:versionValidFrom": {
        "@value": "2022-01-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse nende metallijäätmete täpsustatud nimistu, millele kehtivad erinõuded jäätmeseaduse 8. peatüki tähenduses ja mille kogumiseks või veoks tuleb taotleda jäätmeluba jäätmeseaduse 6. peatüki 3. jao tähenduses. Määrusega kehtestatakse nende metallijäätmete täpsustatud nimistu, millele kehtivad erinõuded jäätmeseaduse 8. peatüki tähenduses ja mille kogumiseks või veoks tuleb taotleda jäätmeluba jäätmeseaduse 6. peatüki 3. jao tähenduses.",
      "rdfs:label": {
        "@value": "Reg_1035682_Par_1 (redaktsioon 1035682)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035682",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035682",
      "estleg:sourceAct": "Metallijäätmete täpsustatud nimistu",
      "estleg:provisionRef": "Reg_1035682 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035682_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035682_Par_2_v1035682",
