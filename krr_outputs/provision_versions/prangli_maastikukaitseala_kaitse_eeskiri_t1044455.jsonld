    {
      "@id": "estleg:Reg_1044455_Par_16_v1044455",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044455_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) veekogude veetaseme ja kaldajoone muutmine; 3 3) maavara kaevandamine; 4 4) puhtpuistute kujundamine ja energiapuistute rajamine; 5 5) biotsiidi, taimekaitsevahendi ja väetise kasutamine. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; veekogude veetaseme ja kaldajoone muutmine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine. 2 (2) Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kui pinnas seda võimaldab, võib kaitseala valitseja lubada puidu kokku- ja väljavedu. Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kui pinnas seda võimaldab, võib kaitseala valitseja lubada puidu kokku- ja väljavedu.",
      "rdfs:label": {
        "@value": "Reg_1044455_Par_16 (redaktsioon 1044455)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044455",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044455",
