      "estleg:provisionRef": "Reg_1035299 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035299_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035299_Par_9_v1035299",
      "@type": [
        "owl:NamedIndividual",
