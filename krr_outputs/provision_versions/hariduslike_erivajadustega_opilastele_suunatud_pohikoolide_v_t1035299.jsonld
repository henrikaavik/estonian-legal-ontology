    {
      "@id": "estleg:Reg_1035299_Par_4_v1035299",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035299_Par_4"
