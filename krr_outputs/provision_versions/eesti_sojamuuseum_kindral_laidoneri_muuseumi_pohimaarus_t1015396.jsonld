        "@value": "2021-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Muuseum asub Harju maakonnas. Postiaadress on Mõisa tee 1, 74001 Viimsi alevik, Viimsi vald. Muuseum asub Harju maakonnas. Postiaadress on Mõisa tee 1, 74001 Viimsi alevik, Viimsi vald.",
      "rdfs:label": {
        "@value": "Reg_1015396_Par_2 (redaktsioon 1015396)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015396",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015396",
      "estleg:sourceAct": "Eesti Sõjamuuseum – kindral Laidoneri muuseumi põhimäärus",
