    {
      "@id": "estleg:Reg_1001095_Par_2_v1001095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001095_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jalgratturi juhtimisõigust võib taotleda isik, kes vastab jalgratturile kehtestatud kvalifikatsiooninõuetele ja on sooritanud eksamid. RT I 2016-04-05 5 105042016005 2016-05-01 Jalgratturi juhtimisõigust võib taotleda isik, kes vastab jalgratturile kehtestatud kvalifikatsiooninõuetele ja on sooritanud eksamid. 2 (2) Kuni 15-aastasel juhiloa taotlejal peab olema seadusliku esindaja kirjalik nõusolek jalgratturi juhiloa saamiseks. Kuni 15-aastasel juhiloa taotlejal peab olema seadusliku esindaja kirjalik nõusolek jalgratturi juhiloa saamiseks. 3 (3) Jalgratturi juhtimisõigus annab liiklusseaduses sätestatud korras 10–15-aastasele isikule õiguse jalgratta juhtimiseks sõiduteel ning 14–15-aastasele isikule õiguse pisimopeedi juhtimiseks sõiduteel. RT I 2016-04-05 5 105042016005 2016-05-01 Jalgratturi juhtimisõigus annab liiklusseaduses sätestatud korras 10–15-aastasele isikule õiguse jalgratta juhtimiseks sõiduteel ning 14–15-aastasele isikule õiguse pisimopeedi juhtimiseks sõiduteel.",
      "rdfs:label": {
        "@value": "Reg_1001095_Par_2 (redaktsioon 1001095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001095",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001095",
      "estleg:sourceAct": "Jalgratturi ja pisimopeedijuhi eksamineerimise, jalgratta juhtimisõiguse andmise ning juhiloa väljastamise kord, jalgratturi juhiloa vorm ning nõuded jalgratturi kvalifikatsioonile",
      "estleg:provisionRef": "Reg_1001095 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001095_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001095_Par_3_v1001095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001095_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kvalifikatsiooninõuded kehtestatakse jalgratturi teadmistele, oskustele ja käitumisele, arvestades, et jalgrattur peab oskama ja suutma valitseda jalgratast, jälgida liiklust, märgata ja ette näha võimalikke ohte ning sellele vastavalt tegutseda. Kvalifikatsiooninõuded kehtestatakse jalgratturi teadmistele, oskustele ja käitumisele, arvestades, et jalgrattur peab oskama ja suutma valitseda jalgratast, jälgida liiklust, märgata ja ette näha võimalikke ohte ning sellele vastavalt tegutseda. 2 (2) Kvalifikatsiooninõuded on aluseks jalgratturi koolitamisel ja eksamineerimisel. Kvalifikatsiooninõuded on aluseks jalgratturi koolitamisel ja eksamineerimisel. 3 (3) Pisimopeedijuhi kvalifikatsioon peab vastama jalgratturi kvalifikatsioonile. Pisimopeedijuhi kvalifikatsioon peab vastama jalgratturi kvalifikatsioonile.",
      "rdfs:label": {
        "@value": "Reg_1001095_Par_3 (redaktsioon 1001095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001095",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001095",
      "estleg:sourceAct": "Jalgratturi ja pisimopeedijuhi eksamineerimise, jalgratta juhtimisõiguse andmise ning juhiloa väljastamise kord, jalgratturi juhiloa vorm ning nõuded jalgratturi kvalifikatsioonile",
      "estleg:provisionRef": "Reg_1001095 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001095_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001095_Par_4_v1001095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001095_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jalgrattur peab teadma: 1 1) liiklusohutust mõjutavaid tegureid ja jalgratturikiivri kasutamise nõudeid; 2 2) teistest liiklejatest lähtuvaid riske; 3 3) jalgratturi ohutuks liiklemiseks vajalikke liiklusreegleid, liikluskorraldusvahendite tähendust, reguleerija märguandeid, teeandmise kohustust ja piiranguid; 4 4) ohutu pikivahe hoidmise, pidurdusteekonna ja teelpüsimise põhimõtteid, ja riskitegureid, mida põhjustab jalgratta juhtimine erinevates tee- ja ilmastikuoludes; 5 5) sõidukiiruse valikuga seonduvaid ohte; 6 6) väsimusest ja pimedusest tulenevat mõju juhi käitumisele ja reageerimisajale; 7 7) käitumisjuhiseid liiklusõnnetuse korral; 8 8) jalgratta tehnilisele seisukorrale kehtestatud nõudeid. RT I 2016-04-05 5 105042016005 2016-05-01 Jalgrattur peab teadma: liiklusohutust mõjutavaid tegureid ja jalgratturikiivri kasutamise nõudeid; teistest liiklejatest lähtuvaid riske; jalgratturi ohutuks liiklemiseks vajalikke liiklusreegleid, liikluskorraldusvahendite tähendust, reguleerija märguandeid, teeandmise kohustust ja piiranguid; ohutu pikivahe hoidmise, pidurdusteekonna ja teelpüsimise põhimõtteid, ja riskitegureid, mida põhjustab jalgratta juhtimine erinevates tee- ja ilmastikuoludes; sõidukiiruse valikuga seonduvaid ohte; väsimusest ja pimedusest tulenevat mõju juhi käitumisele ja reageerimisajale; käitumisjuhiseid liiklusõnnetuse korral; jalgratta tehnilisele seisukorrale kehtestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1001095_Par_4 (redaktsioon 1001095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001095",
