      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Jalgratturi ja pisimopeedijuhi eksamineerimise, jalgratta juhtimisõiguse andmise ning juhiloa väljastamise kord, jalgratturi juhiloa vorm ning nõuded jalgratturi kvalifikatsioonile (19 versiooni)",
        "@language": "et"
      },
      "dc:source": "Jalgratturi ja pisimopeedijuhi eksamineerimise, jalgratta juhtimisõiguse andmise ning juhiloa väljastamise kord, jalgratturi juhiloa vorm ning nõuded jalgratturi kvalifikatsioonile"
    },
    {
      "@id": "estleg:Reg_1001095_Par_1_v1001095",
      "@type": [
