      "estleg:versionValidFrom": {
        "@value": "2017-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatava Põhja-Sakala valla piiriks on endise Kõo valla, Kõpu valla, Suure-Jaani valla ja Võhma linna piir, välja arvatud nende omavahelises osas. Haldusterritoriaalse korralduse muutmise käigus moodustatava Põhja-Sakala valla piiriks on endise Kõo valla, Kõpu valla, Suure-Jaani valla ja Võhma linna piir, välja arvatud nende omavahelises osas. 2 (2) Maa-amet kannab Põhja-Sakala valla piiri riigi maakatastri kaardile. Maa-amet kannab Põhja-Sakala valla piiri riigi maakatastri kaardile.",
      "rdfs:label": {
        "@value": "Reg_1037674_Par_2 (redaktsioon 1037674)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037674",
