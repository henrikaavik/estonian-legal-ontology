      "estleg:provisionRef": "Reg_1029405 § 20_21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029405_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029405_Par_21_v1029405",
