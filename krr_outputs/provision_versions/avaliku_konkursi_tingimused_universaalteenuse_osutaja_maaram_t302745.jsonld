    {
      "@id": "estleg:Reg_302745_Par_6_v302745",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302745_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pakkumise esitamise tähtaeg ei või olla lühem kui 30 kalendripäeva alates konkursi väljakuulutamisest. Pakkumise esitamise tähtaeg ei või olla lühem kui 30 kalendripäeva alates konkursi väljakuulutamisest. 2 (2) Pakkumist, mis laekub pärast pakkumise esitamise tähtpäeva, ei avata ning see tagastatakse pakkujale. Pakkumist, mis laekub pärast pakkumise esitamise tähtpäeva, ei avata ning see tagastatakse pakkujale. 3 (3) Konkursi korraldaja võib pakkumise esitamise tähtaega pikendada. Konkursi korraldaja võib pakkumise esitamise tähtaega pikendada. 4 (4) Konkursi korraldaja teatab esitamise tähtaja pikendamisest kirjalikult kõigile pakkumiskutse väljavõtnud isikutele ja pakkujatele ning avaldab vastava teate § 2 lõikes 1 sätestatud korra kohaselt. Konkursi korraldaja teatab esitamise tähtaja pikendamisest kirjalikult kõigile pakkumiskutse väljavõtnud isikutele ja pakkujatele ning avaldab vastava teate § 2 lõikes 1 sätestatud korra kohaselt. 5 (5) Pakkumised peavad olema jõus pakkumiskutses näidatud tähtaja jooksul. Pakkumised peavad olema jõus pakkumiskutses näidatud tähtaja jooksul.",
      "rdfs:label": {
        "@value": "Reg_302745_Par_6 (redaktsioon 302745)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302745",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302745",
      "estleg:sourceAct": "Avaliku konkursi tingimused universaalteenuse osutaja määramiseks, konkursi või riigihanke korraldaja ja universaalteenuse lepingu sõlmija",
      "estleg:provisionRef": "Reg_302745 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302745_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_302745_Par_7_v302745",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302745_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pakkuja võib enne pakkumise esitamise tähtpäeva oma pakkumist muuta, pakkumise tagasi võtta või esitada uue pakkumise. Pakkuja võib enne pakkumise esitamise tähtpäeva oma pakkumist muuta, pakkumise tagasi võtta või esitada uue pakkumise.",
      "rdfs:label": {
        "@value": "Reg_302745_Par_7 (redaktsioon 302745)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302745",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302745",
      "estleg:sourceAct": "Avaliku konkursi tingimused universaalteenuse osutaja määramiseks, konkursi või riigihanke korraldaja ja universaalteenuse lepingu sõlmija",
      "estleg:provisionRef": "Reg_302745 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302745_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_302745_Par_8_v302745",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302745_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Konkursi korraldaja avab tähtpäevaks laekunud pakkumised pakkumiskutses või pakkumise esitamise tähtaja pikendamisel konkursi korraldaja poolt määratud kohas ja ajal. Konkursi korraldaja avab tähtpäevaks laekunud pakkumised pakkumiskutses või pakkumise esitamise tähtaja pikendamisel konkursi korraldaja poolt määratud kohas ja ajal. 2 (2) Pakkumiste avamise juures võivad viibida pakkujad või nende volitatud esindajad. Pakkumiste avamise juures võivad viibida pakkujad või nende volitatud esindajad. 3 (3) Pakkumiste avamise kohta koostatakse protokoll. Pakkumiste avamise kohta koostatakse protokoll. 4 (4) Ärakiri pakkumiste avamise protokollist saadetakse pakkujale kolme tööpäeva jooksul pakkumiste avamisest arvates. Ärakiri pakkumiste avamise protokollist saadetakse pakkujale kolme tööpäeva jooksul pakkumiste avamisest arvates.",
      "rdfs:label": {
        "@value": "Reg_302745_Par_8 (redaktsioon 302745)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302745",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302745",
      "estleg:sourceAct": "Avaliku konkursi tingimused universaalteenuse osutaja määramiseks, konkursi või riigihanke korraldaja ja universaalteenuse lepingu sõlmija",
      "estleg:provisionRef": "Reg_302745 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302745_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_302745_Par_9_v302745",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302745_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pakkuja kvalifitseerimisel kontrollitakse, et pakkuja: 1 1) on sideettevõtja, kes osutab sideteenust «Elektroonilise side seaduses» sätestatud korras; 2 2) on maksevõimeline, tema vara ei ole sekvestreeritud, tema suhtes ei ole algatatud likvideerimis- ega pankrotimenetlust või ta ei ole pankrotis; 3 3) on andnud konkursi korraldajale nõusoleku järelepärimise tegemiseks Maksu- ja Tolliametile või muule õiguspädevale institutsioonile. Pakkuja kvalifitseerimisel kontrollitakse, et pakkuja: on sideettevõtja, kes osutab sideteenust «Elektroonilise side seaduses» sätestatud korras; on maksevõimeline, tema vara ei ole sekvestreeritud, tema suhtes ei ole algatatud likvideerimis- ega pankrotimenetlust või ta ei ole pankrotis; on andnud konkursi korraldajale nõusoleku järelepärimise tegemiseks Maksu- ja Tolliametile või muule õiguspädevale institutsioonile. 2 (2) Konkursi korraldaja on kohustatud kontrollima pakkuja vastavust lõikes 1 sätestatud nõuetele enne pakkumise sisulist läbivaatamist. Konkursi korraldaja on kohustatud kontrollima pakkuja vastavust lõikes 1 sätestatud nõuetele enne pakkumise sisulist läbivaatamist. 3 (3) Konkursi korraldajal on õigus pakkuja konkursilt igal ajal kõrvaldada, kui selgub, et pakkuja on esitanud ebaõigeid andmeid või dokumente. Konkursi korraldajal on õigus pakkuja konkursilt igal ajal kõrvaldada, kui selgub, et pakkuja on esitanud ebaõigeid andmeid või dokumente. 4 (4) Pakkujat ei kvalifitseerita, kui ta: 1 1) ei vasta lõikes 1 sätestatud nõuetele või 2 2) ei ole esitanud pakkumiskutses kvalifikatsiooni hindamiseks nõutud andmeid või dokumente. Pakkujat ei kvalifitseerita, kui ta: ei vasta lõikes 1 sätestatud nõuetele või ei ole esitanud pakkumiskutses kvalifikatsiooni hindamiseks nõutud andmeid või dokumente. 5 (5) Konkursi korraldaja otsus pakkuja kvalifitseerimise, kvalifitseerimata jätmise või konkursilt kõrvaldamise kohta edastatakse pakkujatele kolme tööpäeva jooksul vastava otsuse tegemisest arvates. Konkursi korraldaja otsus pakkuja kvalifitseerimise, kvalifitseerimata jätmise või konkursilt kõrvaldamise kohta edastatakse pakkujatele kolme tööpäeva jooksul vastava otsuse tegemisest arvates.",
      "rdfs:label": {
        "@value": "Reg_302745_Par_9 (redaktsioon 302745)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302745",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302745",
      "estleg:sourceAct": "Avaliku konkursi tingimused universaalteenuse osutaja määramiseks, konkursi või riigihanke korraldaja ja universaalteenuse lepingu sõlmija",
      "estleg:provisionRef": "Reg_302745 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302745_Map_2026"
      }
    },
