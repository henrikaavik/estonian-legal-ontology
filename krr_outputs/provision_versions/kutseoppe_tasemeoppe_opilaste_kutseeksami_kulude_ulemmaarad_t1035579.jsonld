      "estleg:versionValidFrom": {
        "@value": "2021-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse kutseõppe tasemeõppe õpilase õppe lõpetamiseks sooritatavate kutseeksamite läbiviimisega seotud kulude ülemmäärad ning kutseeksami väljatöötamise ja arendamisega seotud kulude ülemmäär. Määrusega kehtestatakse kutseõppe tasemeõppe õpilase õppe lõpetamiseks sooritatavate kutseeksamite läbiviimisega seotud kulude ülemmäärad ning kutseeksami väljatöötamise ja arendamisega seotud kulude ülemmäär.",
      "rdfs:label": {
        "@value": "Reg_1035579_Par_1 (redaktsioon 1035579)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035579",
