    {
      "@id": "estleg:Reg_1012203_Par_8_v1012203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012203_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isikule tagatakse raviplaanis ettenähtud ravimid kokku kuni 1279 euro ulatuses aastas raviplaani koostamisest arvates. Isikule tagatakse raviplaanis ettenähtud ravimid kokku kuni 1279 euro ulatuses aastas raviplaani koostamisest arvates. 2 (2) Juhul kui isikule on raviplaanis ette nähtud ravimid, mille maksumus ühe aasta jooksul ületab käesoleva paragrahvi lõikes 1 kehtestatud piirmäära, otsustab ravimite tagamise Kaitseväe juhataja või tema volitatud isik. Juhul kui isikule on raviplaanis ette nähtud ravimid, mille maksumus ühe aasta jooksul ületab käesoleva paragrahvi lõikes 1 kehtestatud piirmäära, otsustab ravimite tagamise Kaitseväe juhataja või tema volitatud isik.",
      "rdfs:label": {
        "@value": "Reg_1012203_Par_8 (redaktsioon 1012203)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012203",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012203",
      "estleg:sourceAct": "Teenistusülesannete täitmise tõttu tervisekahjustuse saanud ja teenistusest vabastatud isiku tervishoiuteenuste, meditsiiniseadmete, ravimite ja raviga seotud kulu katmise tingimused, ulatus ja kord",
      "estleg:provisionRef": "Reg_1012203 § 8",
      "estleg:partOfAct": {
