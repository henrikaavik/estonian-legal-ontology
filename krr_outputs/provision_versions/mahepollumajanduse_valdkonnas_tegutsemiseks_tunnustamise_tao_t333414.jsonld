    },
    {
      "@id": "estleg:Reg_333414_Par_9_10_v333414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333414_Par_9_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajandusliku vesiviljelusloomade tootmisega tegeleda sooviv isik lisab taotlusele järgmised andmed ja dokumendid: 1 1) vesiviljelusloomade tootmise asukohta iseloomustav kaart mõõtkavas vähemalt 1:10 000, millele on kantud ala, millel kavatsetakse vesiviljelusloomade tootmist alustada, pindala ja piirid; 2 2) nende liikide loetelu, millesse kuuluvaid vesiviljelusloomi kavatsetakse kasvatada, ning andmed kavandatava tootmismahu kohta. RTL 2010 12 221 13285775 2010-07-01 Mahepõllumajandusliku vesiviljelusloomade tootmisega tegeleda sooviv isik lisab taotlusele järgmised andmed ja dokumendid: vesiviljelusloomade tootmise asukohta iseloomustav kaart mõõtkavas vähemalt 1:10 000, millele on kantud ala, millel kavatsetakse vesiviljelusloomade tootmist alustada, pindala ja piirid; nende liikide loetelu, millesse kuuluvaid vesiviljelusloomi kavatsetakse kasvatada, ning andmed kavandatava tootmismahu kohta.",
      "rdfs:label": {
        "@value": "Reg_333414_Par_9_10 (redaktsioon 333414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333414",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333414",
      "estleg:sourceAct": "Mahepõllumajanduse valdkonnas tegutsemiseks tunnustamise taotlemine ja taotluse menetlemise kord",
      "estleg:provisionRef": "Reg_333414 § 9_10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333414_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333414_Par_9_9_v333414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333414_Par_9_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajandusliku merevetikate tootmisega tegeleda sooviv isik lisab taotlusele järgmised andmed ja dokumendid: 1 1) merevetikate kasvatamise ja kogumise ning kogumisjärgse tegevuse asukohta iseloomustav kaart mõõtkavas vähemalt 1:10 000, millele on kantud ala, millel kavatsetakse merevetikate kasvatamist, kogumist ja kogumisjärgset tegevust alustada, pindala ja piirid; 2 2) nende liikide loetelu, millesse kuuluvaid merevetikaid kavatsetakse kasvatada või koguda, ning andmed kavandatava koguse ja kogumise aja kohta. RTL 2010 12 221 13285775 2010-07-01 Mahepõllumajandusliku merevetikate tootmisega tegeleda sooviv isik lisab taotlusele järgmised andmed ja dokumendid: merevetikate kasvatamise ja kogumise ning kogumisjärgse tegevuse asukohta iseloomustav kaart mõõtkavas vähemalt 1:10 000, millele on kantud ala, millel kavatsetakse merevetikate kasvatamist, kogumist ja kogumisjärgset tegevust alustada, pindala ja piirid; nende liikide loetelu, millesse kuuluvaid merevetikaid kavatsetakse kasvatada või koguda, ning andmed kavandatava koguse ja kogumise aja kohta.",
      "rdfs:label": {
        "@value": "Reg_333414_Par_9_9 (redaktsioon 333414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333414",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333414",
      "estleg:sourceAct": "Mahepõllumajanduse valdkonnas tegutsemiseks tunnustamise taotlemine ja taotluse menetlemise kord",
      "estleg:provisionRef": "Reg_333414 § 9_9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333414_Map_2026"
      }
    },
