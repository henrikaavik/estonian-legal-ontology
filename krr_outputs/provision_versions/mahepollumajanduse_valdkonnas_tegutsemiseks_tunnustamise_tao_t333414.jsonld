      "estleg:provisionRef": "Reg_333414 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333414_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333414_Par_10_v333414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333414_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajandusliku sööda tootmisega tegeleda sooviv isik lisab taotlusele järgmised andmed ja dokumendid: RT I 2013-06-28 2 128062013002 2013-07-01 1 1) toote ja tootegrupi nimetus ning andmed toote koostisosade, nende päritolu ja tootes kasutatava koguse kohta; 2 2) tootmisprotsessi tehnoloogiline skeem ja andmed kasutatavate tehnoloogiliste võtete kohta; 3 3) andmed tegeliku tootmisvõimsuse ja eeldatava toodangumahu kohta; 4 4) nende meetmete kirjeldus, millega tagatakse mahepõllumajandusliku sööda nõuetekohane tootmine; RT I 2013-06-28 2 128062013002 2013-07-01 5 5) kehtetu – RTL 2010 12 221 13285775 2010-03-22+02:00 6 6) märgistuse näidis. Mahepõllumajandusliku sööda tootmisega tegeleda sooviv isik lisab taotlusele järgmised andmed ja dokumendid: toote ja tootegrupi nimetus ning andmed toote koostisosade, nende päritolu ja tootes kasutatava koguse kohta; tootmisprotsessi tehnoloogiline skeem ja andmed kasutatavate tehnoloogiliste võtete kohta; andmed tegeliku tootmisvõimsuse ja eeldatava toodangumahu kohta; nende meetmete kirjeldus, millega tagatakse mahepõllumajandusliku sööda nõuetekohane tootmine; kehtetu – märgistuse näidis.",
      "rdfs:label": {
        "@value": "Reg_333414_Par_10 (redaktsioon 333414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333414",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333414",
      "estleg:sourceAct": "Mahepõllumajanduse valdkonnas tegutsemiseks tunnustamise taotlemine ja taotluse menetlemise kord",
      "estleg:provisionRef": "Reg_333414 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333414_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333414_Par_11_v333414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333414_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajandusliku toote turuleviimise, sealhulgas importimisega ja pakendamata toote lõpptarbijale turustamisega tegeleda sooviv isik lisab taotlusele järgmised andmed ja dokumendid: 1 1) turuleviidavate toodete loetelu ning märgistuse näidis; 2 2) nende meetmete kirjeldus, millega tagatakse mahepõllumajandusliku toote nõuetekohane turuleviimine, sealhulgas importimine ja pakendamata toote turustamine lõpptarbijale. Mahepõllumajandusliku toote turuleviimise, sealhulgas importimisega ja pakendamata toote lõpptarbijale turustamisega tegeleda sooviv isik lisab taotlusele järgmised andmed ja dokumendid: turuleviidavate toodete loetelu ning märgistuse näidis; nende meetmete kirjeldus, millega tagatakse mahepõllumajandusliku toote nõuetekohane turuleviimine, sealhulgas importimine ja pakendamata toote turustamine lõpptarbijale.",
      "rdfs:label": {
        "@value": "Reg_333414_Par_11 (redaktsioon 333414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333414",
