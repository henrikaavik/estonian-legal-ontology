      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse rahvusvahelise sanktsiooni seaduse § 3 lõikes 1 ja §-s 4 nimetatud eesmärkide toetamiseks Vabariigi Valitsuse sanktsioonina sissesõidukeeld. Määrusega kehtestatakse rahvusvahelise sanktsiooni seaduse § 3 lõikes 1 ja §-s 4 nimetatud eesmärkide toetamiseks Vabariigi Valitsuse sanktsioonina sissesõidukeeld.",
      "rdfs:label": {
        "@value": "Reg_1061943_Par_1 (redaktsioon 1061943)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061943",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061943",
      "estleg:sourceAct": "Vabariigi Valitsuse sanktsioon suveräänsuse ja territoriaalse terviklikkuse õõnestamise ning separatismi õhutamise vastu",
      "estleg:provisionRef": "Reg_1061943 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061943_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061943_Par_2_v1061943",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061943_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sissesõidukeeldu kohaldatakse Eesti Vabariigi territooriumil rahvusvahelise sanktsiooni seaduse § 27 lõike 2 alusel välisministri käskkirjas määratud isikute suhtes, kelle kohta on andmeid või on põhjendatud alust arvata, et nad on osalenud välisriigis sellises tegevuses või aktiivselt toetanud välisriigis sellist tegevust, mis rikub rahvusvahelise õiguse norme ja põhimõtteid, õõnestab riigi suveräänsust ja territoriaalset terviklikkust, ohustab demokraatiat, õigusriiki, julgeolekut ja põhiseaduslikku korda, õhutab separatismi või destabiliseerib riiki, või pannud toime avaliku sektori vahenditega seotud raske finantsrikkumise, sealhulgas korruptsiooni, kapitali loata riigist välja viimise või kuriteo, mis vastab rahapesu tunnustele. Sissesõidukeeldu kohaldatakse Eesti Vabariigi territooriumil rahvusvahelise sanktsiooni seaduse § 27 lõike 2 alusel välisministri käskkirjas määratud isikute suhtes, kelle kohta on andmeid või on põhjendatud alust arvata, et nad on osalenud välisriigis sellises tegevuses või aktiivselt toetanud välisriigis sellist tegevust, mis rikub rahvusvahelise õiguse norme ja põhimõtteid, õõnestab riigi suveräänsust ja territoriaalset terviklikkust, ohustab demokraatiat, õigusriiki, julgeolekut ja põhiseaduslikku korda, õhutab separatismi või destabiliseerib riiki, või pannud toime avaliku sektori vahenditega seotud raske finantsrikkumise, sealhulgas korruptsiooni, kapitali loata riigist välja viimise või kuriteo, mis vastab rahapesu tunnustele. 2 (2) Sissesõidukeeldu rakendatakse väljasõidukohustuse ja sissesõidukeelu seaduses sätestatud korras. Sissesõidukeeldu rakendatakse väljasõidukohustuse ja sissesõidukeelu seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1061943_Par_2 (redaktsioon 1061943)",
        "@language": "et"
      },
