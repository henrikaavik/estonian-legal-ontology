      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtotstarbelisi annetusi ja pärandusi võib Kultuurkapital kasutada ainult annetaja või pärandaja näidatud eesmärgil.",
      "rdfs:label": {
        "@value": "KultKS_Par_5 (redaktsioon 22287)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22287",
      "estleg:supersededByVersion": {
