      }
    },
    {
      "@id": "estleg:KultKS_Par_18_v22287",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KultKS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kultuuriminister kinnitab kolme kuu jooksul käesoleva seaduse jõustumisest arvates käesoleva seaduse paragrahvis 10 sätestatud sihtkapitalide nõukogude koosseisud. (2) Vabariigi Valitsus kinnitab nelja kuu jooksul käesoleva seaduse jõustumisest arvates Kultuurkapitali nõukogu koosseisu.",
      "rdfs:label": {
        "@value": "KultKS_Par_18 (redaktsioon 22287)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22287",
      "estleg:supersededByVersion": {
