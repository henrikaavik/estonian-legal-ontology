      }
    },
    {
      "@id": "estleg:KultKS_Par_20_v210596",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KultKS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1994. aasta 1. juulil. (2) Käesoleva seaduse § 19 3. lõige jõustub 1995. aasta 1. jaanuaril.",
      "rdfs:label": {
