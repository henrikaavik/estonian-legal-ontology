        "@id": "estleg:KultKS_Map"
      }
    },
    {
      "@id": "estleg:KultKS_Par_5_v263188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KultKS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KultKS_Par_5 (redaktsioon 263188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "263188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/263188",
      "estleg:sourceAct": "Eesti Kultuurkapitali seadus",
      "estleg:provisionRef": "KultKS § 5",
