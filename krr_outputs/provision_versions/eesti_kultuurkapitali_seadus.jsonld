      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22287",
      "estleg:sourceAct": "Eesti Kultuurkapitali seadus",
      "estleg:provisionRef": "KultKS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:KultKS_Map"
      }
    },
