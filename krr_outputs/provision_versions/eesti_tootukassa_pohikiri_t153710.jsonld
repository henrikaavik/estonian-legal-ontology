      "estleg:provisionRef": "Reg_153710 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153710_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153710_Par_17_v153710",
      "@type": [
