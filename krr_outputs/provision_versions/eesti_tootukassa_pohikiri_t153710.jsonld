    {
      "@id": "estleg:Reg_153710_Par_32_v153710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153710_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Töötukassa ei või jaguneda ega ühineda teiste juriidiliste isikutega ning töötukassat ei või ümber kujundada muud liiki juriidiliseks isikuks. Töötukassa ei või jaguneda ega ühineda teiste juriidiliste isikutega ning töötukassat ei või ümber kujundada muud liiki juriidiliseks isikuks.",
      "rdfs:label": {
