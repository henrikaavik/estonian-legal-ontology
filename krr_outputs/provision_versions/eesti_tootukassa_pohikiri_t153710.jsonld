      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne töötuskindlustuse seaduse § 341 lõikes 1 nimetatud hoiulepingu sõlmimist töötukassa vahendite arvelt omandatud finantsvara kohta kohaldatakse kuni nimetatud finantsvara realiseerimiseni käesoleva määruse § 16 lõike 1 punkti 8, § 29 lõike 1 punkti 2, § 29 lõikeid 2, 3 ja 6 ning § 30 enne käesoleva paragrahvi jõustumist kehtinud redaktsioonis. RT I 2012-02-02 2 102022012002 2012-02-05 Enne töötuskindlustuse seaduse § 341 lõikes 1 nimetatud hoiulepingu sõlmimist töötukassa vahendite arvelt omandatud finantsvara kohta kohaldatakse kuni nimetatud finantsvara realiseerimiseni käesoleva määruse § 16 lõike 1 punkti 8, § 29 lõike 1 punkti 2, § 29 lõikeid 2, 3 ja 6 ning § 30 enne käesoleva paragrahvi jõustumist kehtinud redaktsioonis.",
      "rdfs:label": {
        "@value": "Reg_153710_Par_33_34 (redaktsioon 153710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153710",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153710",
      "estleg:sourceAct": "Eesti Töötukassa põhikiri",
      "estleg:provisionRef": "Reg_153710 § 33_34",
