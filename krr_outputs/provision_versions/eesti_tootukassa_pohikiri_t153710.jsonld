        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhatuse koosolekut protokollitakse vastavalt käesoleva põhikirja §-s 13 sätestatule. Juhatuse koosolekut protokollitakse vastavalt käesoleva põhikirja §-s 13 sätestatule.",
      "rdfs:label": {
        "@value": "Reg_153710_Par_21 (redaktsioon 153710)",
