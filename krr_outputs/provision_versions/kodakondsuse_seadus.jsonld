      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalane, kes soovib saada Eesti kodakondsust, peab: olema vähemalt 15-aastane; omama pikaajalise elaniku elamisluba või alalist elamisõigust; olema elanud enne Eesti kodakondsuse saamise sooviavalduse esitamise päeva Eestis elamisloa või elamisõiguse alusel vähemalt kaheksa aastat, millest viimased viis aastat püsivalt; olema elanud Eestis seaduslikult ja püsivalt pikaajalise elaniku elamisloa või alalise elamisõiguse alusel kuus kuud pärast Eesti kodakondsuse saamise sooviavalduse registreerimisele järgnevat päeva; omama registreeritud elukohta Eestis; oskama eesti keelt vastavalt käesoleva seaduse §-s 8 sätestatud nõuetele; tundma Eesti Vabariigi põhiseadust ja kodakondsuse seadust vastavalt käesoleva seaduse §-s 9 sätestatud nõuetele; omama legaalset püsivat sissetulekut, mis tagab tema ja tema ülalpeetavate äraelamise; olema lojaalne Eesti riigile; andma vande: «Taotledes Eesti kodakondsust, tõotan olla ustav Eesti põhiseaduslikule korrale.»",
      "rdfs:label": {
        "@value": "KodS_Par_6 (redaktsioon 13291995)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13291995",
      "estleg:supersededByVersion": {
        "@id": "estleg:KodS_Par_6_v103022015004"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KodS_Par_6_v103022015004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalane, kes soovib saada Eesti kodakondsust, peab: olema vähemalt 15-aastane; omama pikaajalise elaniku elamisluba või alalist elamisõigust; olema elanud enne Eesti kodakondsuse saamise sooviavalduse esitamise päeva Eestis elamisloa või elamisõiguse alusel vähemalt kaheksa aastat, millest viimased viis aastat püsivalt; olema elanud Eestis seaduslikult ja püsivalt pikaajalise elaniku elamisloa või alalise elamisõiguse alusel kuus kuud pärast Eesti kodakondsuse saamise sooviavalduse registreerimisele järgnevat päeva; omama registreeritud elukohta Eestis; oskama eesti keelt vastavalt käesoleva seaduse §-s 8 sätestatud nõuetele; tundma Eesti Vabariigi põhiseadust ja kodakondsuse seadust vastavalt käesoleva seaduse §-s 9 sätestatud nõuetele; omama legaalset püsivat sissetulekut; olema lojaalne Eesti riigile; andma vande: «Taotledes Eesti kodakondsust, tõotan olla ustav Eesti põhiseaduslikule korrale.»",
      "rdfs:label": {
        "@value": "KodS_Par_6 (redaktsioon 103022015004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103022015004",
      "estleg:supersededByVersion": {
        "@id": "estleg:KodS_Par_6_v123032015260"
      },
      "estleg:versionValidTo": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KodS_Par_6_v123032015260",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalane, kes soovib saada Eesti kodakondsust, peab: olema vähemalt 15-aastane; omama pikaajalise elaniku elamisluba või alalist elamisõigust; olema elanud enne Eesti kodakondsuse saamise taotluse esitamise päeva Eestis elamisloa või elamisõiguse alusel vähemalt kaheksa aastat, millest viis aastat püsivalt; kehtetu - omama registreeritud elukohta Eestis; oskama eesti keelt vastavalt käesoleva seaduse §-s 8 sätestatud nõuetele; tundma Eesti Vabariigi põhiseadust ja kodakondsuse seadust vastavalt käesoleva seaduse §-s 9 sätestatud nõuetele; omama legaalset püsivat sissetulekut; olema lojaalne Eesti riigile; andma vande: «Taotledes Eesti kodakondsust, tõotan olla ustav Eesti põhiseaduslikule korrale.»",
      "rdfs:label": {
        "@value": "KodS_Par_6 (redaktsioon 123032015260)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015260"
    },
    {
      "@id": "estleg:KodS_Par_7_v22309",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Legaalseks püsivaks sissetulekuks loetakse: seaduslikult teenitud tasu töö-, teenistus- või tsiviilõigusliku lepingu või liikmelisuse alusel; seaduslikust äritegevusest või omandist saadav tulu; pension; stipendium; elatis; riiklikud toetused, sealhulgas töötu abiraha ning lastetoetus; ülalpidamine Eestis legaalse püsiva sissetulekuga perekonnaliikmelt.",
      "rdfs:label": {
        "@value": "KodS_Par_7 (redaktsioon 22309)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22309",
      "estleg:supersededByVersion": {
        "@id": "estleg:KodS_Par_7_v961169"
      },
      "estleg:versionValidTo": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KodS_Par_7_v961169",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Legaalseks püsivaks sissetulekuks loetakse: seaduslikult teenitud tasu töö-, teenistus- või tsiviilõigusliku lepingu või liikmelisuse alusel; seaduslikust äritegevusest või omandist saadav tulu; pension; stipendium; elatis; [Punkti 6 sõnastus kuni 31. 12. 2005] riiklikud toetused, sealhulgas töötu abiraha ning lastetoetus; [Punkti 6 sõnastus alates 1. 01. 2006] seaduse alusel makstavad toetused; ülalpidamine Eestis legaalse püsiva sissetulekuga perekonnaliikmelt.",
      "rdfs:label": {
