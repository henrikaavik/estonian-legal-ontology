      }
    },
    {
      "@id": "estleg:KodS_Par_15_v103012017017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_15"
      },
