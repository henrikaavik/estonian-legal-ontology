        "@value": "2002-11-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KodS_Par_22_v710551",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti kodakondsus kaob: Eesti kodakondsusest vabastamisega; Eesti kodakondsuse äravõtmisega; mõne muu riigi kodakondsuse vastuvõtmisega.",
      "rdfs:label": {
        "@value": "KodS_Par_22 (redaktsioon 710551)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "710551"
    },
    {
      "@id": "estleg:KodS_Par_23_v22309",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik esitab Eesti kodakondsusest vabastamiseks: sooviavalduse, milles on märgitud ees- ja perekonnanimi, sünniaeg ja -koht, elukoht, taotletav kodakondsus ja allkiri; isikut ja kodakondsust tõendavad dokumendid; tõendi selle kohta, et ta on saanud mõne muu riigi kodakondsuse või saab selle seoses Eesti kodakondsusest vabastamisega; riigilõivu tasumise kviitungi.",
      "rdfs:label": {
        "@value": "KodS_Par_23 (redaktsioon 22309)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22309",
      "estleg:supersededByVersion": {
        "@id": "estleg:KodS_Par_23_v710425"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KodS_Par_23_v710425",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik esitab Eesti kodakondsusest vabastamiseks: sooviavalduse, milles on märgitud ees- ja perekonnanimi, sünniaeg ja -koht, elukoht, taotletav kodakondsus ja allkiri; isikut ja kodakondsust tõendavad dokumendid; tõendi selle kohta, et ta on saanud mõne muu riigi kodakondsuse või saab selle seoses Eesti kodakondsusest vabastamisega; riigilõivu tasumise kviitungi. [Paragrahvi 23 sõnastus alates 1.08.2002]",
      "rdfs:label": {
        "@value": "KodS_Par_23 (redaktsioon 710425)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "710425",
      "estleg:supersededByVersion": {
        "@id": "estleg:KodS_Par_23_v710551"
      },
      "estleg:versionValidTo": {
        "@value": "2002-11-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KodS_Par_23_v710551",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik esitab Eesti kodakondsusest vabastamiseks: sooviavalduse, milles on märgitud ees- ja perekonnanimi, sünniaeg ja -koht, elukoht, taotletav kodakondsus ja allkiri; isikut ja kodakondsust tõendavad dokumendid; tõendi selle kohta, et ta on saanud mõne muu riigi kodakondsuse või saab selle seoses Eesti kodakondsusest vabastamisega.(2) Enne Eesti kodakondsusest vabastamist peab isik tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "KodS_Par_23 (redaktsioon 710551)",
        "@language": "et"
      },
