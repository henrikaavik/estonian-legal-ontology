        "@language": "et"
      },
      "estleg:versionRedactionId": "22309",
      "estleg:supersededByVersion": {
        "@id": "estleg:KodS_Par_29_v13291995"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KodS_Par_29_v13291995",
