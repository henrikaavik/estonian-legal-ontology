      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 1990. aasta 1. juulit Eestisse asunud või Eestis sündinud isiku suhtes, kes taotleb Eesti kodakondsust, ei rakendata käesoleva seaduse § 6 punktis 2 sätestatud pikaajalise elaniku elamisloa või alalise elamisõiguse omamise nõuet.",
      "rdfs:label": {
        "@value": "KodS_Par_33 (redaktsioon 123032015260)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015260"
    },
