      }
    },
    {
      "@id": "estleg:KodS_Par_15_v107022020008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KodS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alaealisele käesoleva seaduse §-des 13 ja 14 sätestatud juhtudel Eesti kodakondsuse saamise taotluses esitatavate andmete ja taotlusele lisatavate dokumentide loetelu ning taotluse esitamise nõuded kehtestab määrusega. (2) Kehtetu - (3) Kehtetu -",
