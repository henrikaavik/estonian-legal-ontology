      "estleg:versionValidFrom": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik loetakse volitatud valitsusasutuse poolt Eesti kodakondsuse kaotanuks mõne muu riigi kodakondsuse vastuvõtmise või Eesti kodakondsusest loobumisega mõne muu riigi kodakondsuse kasuks.",
      "rdfs:label": {
        "@value": "KodS_Par_29 (redaktsioon 120062014004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062014004",
      "estleg:supersededByVersion": {
