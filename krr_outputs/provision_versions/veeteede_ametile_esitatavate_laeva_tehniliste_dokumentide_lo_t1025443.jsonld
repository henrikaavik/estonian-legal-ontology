      "estleg:provisionRef": "Reg_1025443 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025443_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025443_Par_14_v1025443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025443_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus jõustub 2014. aasta 1. septembril. Käesolev määrus jõustub 2014. aasta 1. septembril.",
      "rdfs:label": {
        "@value": "Reg_1025443_Par_14 (redaktsioon 1025443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025443",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025443",
      "estleg:sourceAct": "Veeteede Ametile esitatavate laeva tehniliste dokumentide loetelu ja dokumentide esitamise kord",
      "estleg:provisionRef": "Reg_1025443 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025443_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025443_Par_2_v1025443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025443_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tehniline ülesanne sisaldab järgmisi andmeid: 1 1) laeva põhiandmed, milledeks on tehnilised üldandmed, kasutusotstarve ja sõiduomadused; 2 2) laeva kere andmed, milledeks on konstruktsiooni ja materjalide andmed; 3 3) laeva süsteemide andmed; 4 4) laeva seadmete andmed; 5 5) teave laeva ruumide paigutuse ja nende seadmestamise kohta; 6 6) teave isolatsiooni ja viimistlemise kohta; 7 7) masinate, mehhanismide ja nende süsteemide, käiturite andmed; 8 8) elektrisüsteemide ja -seadmete andmed; 9 9) raadio-, navigatsiooni- ja alarmseadmete andmed; 10 10) kai- ja käigukatsetuste nimistu. Tehniline ülesanne sisaldab järgmisi andmeid: laeva põhiandmed, milledeks on tehnilised üldandmed, kasutusotstarve ja sõiduomadused; laeva kere andmed, milledeks on konstruktsiooni ja materjalide andmed; laeva süsteemide andmed; laeva seadmete andmed; teave laeva ruumide paigutuse ja nende seadmestamise kohta; teave isolatsiooni ja viimistlemise kohta; masinate, mehhanismide ja nende süsteemide, käiturite andmed; elektrisüsteemide ja -seadmete andmed; raadio-, navigatsiooni- ja alarmseadmete andmed; kai- ja käigukatsetuste nimistu.",
      "rdfs:label": {
        "@value": "Reg_1025443_Par_2 (redaktsioon 1025443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025443",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025443",
      "estleg:sourceAct": "Veeteede Ametile esitatavate laeva tehniliste dokumentide loetelu ja dokumentide esitamise kord",
      "estleg:provisionRef": "Reg_1025443 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025443_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025443_Par_3_v1025443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025443_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva ülddokumentatsioon koosneb järgmistest dokumentidest: 1 1) teoreetiline joonis; 2 2) üldasendi joonis; 3 3) dokumendid konstruktiivsete elementide määratlemise kohta; 4 4) tankide plaan. Laeva ülddokumentatsioon koosneb järgmistest dokumentidest: teoreetiline joonis; üldasendi joonis; dokumendid konstruktiivsete elementide määratlemise kohta; tankide plaan.",
      "rdfs:label": {
        "@value": "Reg_1025443_Par_3 (redaktsioon 1025443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025443",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025443",
      "estleg:sourceAct": "Veeteede Ametile esitatavate laeva tehniliste dokumentide loetelu ja dokumentide esitamise kord",
      "estleg:provisionRef": "Reg_1025443 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025443_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025443_Par_4_v1025443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025443_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva kerekonstruktsiooni joonised on: 1 1) kerekonstruktsiooni pikilõike joonis; 2 2) keskkaare joonis; 3 3) tekkide konstruktsiooni joonis; 4 4) sisepõhja konstruktsiooni joonis; 5 5) veekindlate vaheseinte joonised; 6 6) välisplaadistuse joonis metallkerega laeval; 7 7) peamasina ja suuremate seadmete vundamendite joonised; 8 8) luukide, veekindlate uste ja kaante joonised; 9 9) paigaldatud mahutite joonised. Laeva kerekonstruktsiooni joonised on: kerekonstruktsiooni pikilõike joonis; keskkaare joonis; tekkide konstruktsiooni joonis; sisepõhja konstruktsiooni joonis; veekindlate vaheseinte joonised; välisplaadistuse joonis metallkerega laeval; peamasina ja suuremate seadmete vundamendite joonised; luukide, veekindlate uste ja kaante joonised; paigaldatud mahutite joonised.",
      "rdfs:label": {
        "@value": "Reg_1025443_Par_4 (redaktsioon 1025443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025443",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025443",
      "estleg:sourceAct": "Veeteede Ametile esitatavate laeva tehniliste dokumentide loetelu ja dokumentide esitamise kord",
      "estleg:provisionRef": "Reg_1025443 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025443_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025443_Par_5_v1025443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025443_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva süsteemide joonised on: 1 1) tulekaitsesüsteemide joonis; 2 2) kuivendussüsteemi joonis; 3 3) ballastsüsteemi joonis; 4 4) sanitaarsüsteemide joonis; 5 5) ventilatsiooni- ja konditsioneerimise süsteemi joonis; 6 6) tankide ja tsisternide täite-, õhu- ja mõõtesüsteemide joonis. Laeva süsteemide joonised on: tulekaitsesüsteemide joonis; kuivendussüsteemi joonis; ballastsüsteemi joonis; sanitaarsüsteemide joonis; ventilatsiooni- ja konditsioneerimise süsteemi joonis; tankide ja tsisternide täite-, õhu- ja mõõtesüsteemide joonis.",
      "rdfs:label": {
        "@value": "Reg_1025443_Par_5 (redaktsioon 1025443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025443",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025443",
      "estleg:sourceAct": "Veeteede Ametile esitatavate laeva tehniliste dokumentide loetelu ja dokumentide esitamise kord",
      "estleg:provisionRef": "Reg_1025443 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025443_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025443_Par_6_v1025443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025443_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva seadmete joonised on: 1 1) ankruseadme joonis; 2 2) rooliseadme joonis; 3 3) päästevahendite paigutuse joonis; 4 4) veeskamise seadmete joonis; 5 5) reelingu ja umbreelingu joonis; 6 6) lastiseadmete joonis; 7 7) kinnitus- ja puksiirseadmete joonis; 8 8) mastide ja taglase joonis. Laeva seadmete joonised on: ankruseadme joonis; rooliseadme joonis; päästevahendite paigutuse joonis; veeskamise seadmete joonis; reelingu ja umbreelingu joonis; lastiseadmete joonis; kinnitus- ja puksiirseadmete joonis; mastide ja taglase joonis.",
      "rdfs:label": {
        "@value": "Reg_1025443_Par_6 (redaktsioon 1025443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025443",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025443",
      "estleg:sourceAct": "Veeteede Ametile esitatavate laeva tehniliste dokumentide loetelu ja dokumentide esitamise kord",
      "estleg:provisionRef": "Reg_1025443 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025443_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025443_Par_7_v1025443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025443_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva mehhanismide dokumentatsioon koosneb järgmistest dokumentidest: 1 1) masinaruumi üldpaigutuse joonis; 2 2) võllide ja tugilaagrite tugevusarvutus; 3 3) võlliliini koostejoonis; 4 4) käituri koostejoonis; 5 5) peamasina, abimasinate ja muude masinaruumis asuvate mehhanismide süsteemide, see tähendab kütte- ja õlitorustiku, jahutussüsteemide, käivitussüsteemide ning heitgaasitorustike joonised koos katelde ja katalüsaatoriga; 6 6) pea- ja abimasinate juhtimisautomaatika ja kontrollisüsteemide skeemid. Laeva mehhanismide dokumentatsioon koosneb järgmistest dokumentidest: masinaruumi üldpaigutuse joonis; võllide ja tugilaagrite tugevusarvutus; võlliliini koostejoonis; käituri koostejoonis; peamasina, abimasinate ja muude masinaruumis asuvate mehhanismide süsteemide, see tähendab kütte- ja õlitorustiku, jahutussüsteemide, käivitussüsteemide ning heitgaasitorustike joonised koos katelde ja katalüsaatoriga; pea- ja abimasinate juhtimisautomaatika ja kontrollisüsteemide skeemid.",
      "rdfs:label": {
        "@value": "Reg_1025443_Par_7 (redaktsioon 1025443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025443",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025443",
