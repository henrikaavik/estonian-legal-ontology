      }
    },
    {
      "@id": "estleg:Reg_1025443_Par_9_v1025443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025443_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva elektriseadmete dokumentatsioon koosneb järgmistest dokumentidest: 1 1) elektrivõrgu, see tähendab jõuseadmete, valgustuse, avariivalgustuse, navigatsioonitulede, kontroll- ja avariisignalisatsiooni skeemid; 2 2) peajaotuskilbi skeem; 3 3) elektrivõrgu koormuste tabelid; 4 4) elektriseadmete maandamise skeem. Laeva elektriseadmete dokumentatsioon koosneb järgmistest dokumentidest: elektrivõrgu, see tähendab jõuseadmete, valgustuse, avariivalgustuse, navigatsioonitulede, kontroll- ja avariisignalisatsiooni skeemid; peajaotuskilbi skeem; elektrivõrgu koormuste tabelid; elektriseadmete maandamise skeem.",
