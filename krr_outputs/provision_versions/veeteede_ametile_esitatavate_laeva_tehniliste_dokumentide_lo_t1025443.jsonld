    {
      "@id": "estleg:Reg_1025443_Par_8_v1025443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025443_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva raadio- ja navigatsiooniseadmete dokumentatsioon koosneb järgmistest dokumentidest: 1 1) raadio- ja navigatsiooniseadmete paigaldusjoonised; 2 2) antennide paigaldusjoonised; 3 3) seadmete pea- ja reservtoiteskeemid; 4 4) seadmete montaažiskeemid koos spetsifikatsioonidega; 5 5) avariiakude mahutavuse arvutus. Laeva raadio- ja navigatsiooniseadmete dokumentatsioon koosneb järgmistest dokumentidest: raadio- ja navigatsiooniseadmete paigaldusjoonised; antennide paigaldusjoonised; seadmete pea- ja reservtoiteskeemid; seadmete montaažiskeemid koos spetsifikatsioonidega; avariiakude mahutavuse arvutus.",
      "rdfs:label": {
        "@value": "Reg_1025443_Par_8 (redaktsioon 1025443)",
        "@language": "et"
      },
