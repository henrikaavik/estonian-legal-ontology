    {
      "@id": "estleg:Reg_1042654_Par_10_v1042654",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042654_Par_10"
