        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on maastikuilme säilitamine ja kaitsealuste liikide kaitse. Piiranguvööndi kaitse-eesmärk on maastikuilme säilitamine ja kaitsealuste liikide kaitse.",
      "rdfs:label": {
        "@value": "Reg_1042654_Par_14 (redaktsioon 1042654)",
        "@language": "et"
      },
