      "estleg:sourceAct": "Jalase maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1042654 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042654_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042654_Par_11_v1042654",
      "@type": [
        "owl:NamedIndividual",
