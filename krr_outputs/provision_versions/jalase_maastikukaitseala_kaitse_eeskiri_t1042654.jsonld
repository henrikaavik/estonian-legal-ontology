      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 4. detsembri 2015. a käskkirjaga nr 1085 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 4. detsembri 2015. a käskkirjaga nr 1085 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1042654_Par_20 (redaktsioon 1042654)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042654",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042654",
