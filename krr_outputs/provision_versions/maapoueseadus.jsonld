      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_81 (redaktsioon 22304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22304",
      "estleg:supersededByVersion": {
