      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Maapueseadus_Par_5_v121122019011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maardla on geoloogilise uuringuga piiritletud ja uuritud ning keskkonnaregistris arvele võetud maavara lasund või selle osa koos vahekihtidega.",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_5 (redaktsioon 121122019011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122019011",
      "estleg:supersededByVersion": {
