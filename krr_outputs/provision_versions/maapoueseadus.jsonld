    {
      "@id": "estleg:Maapueseadus_Par_61_v12766617",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_61 (redaktsioon 12766617)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12766617",
