      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_82 (redaktsioon 191594)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "191594",
      "estleg:supersededByVersion": {
