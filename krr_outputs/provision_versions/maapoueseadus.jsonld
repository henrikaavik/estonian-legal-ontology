      }
    },
    {
      "@id": "estleg:Maapueseadus_Par_46_v824890",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üldgeoloogilise uurimistöö või uurimistöö uuringuruumi teenindusala korrastamise kohta koostab töö tegija akti, mis tuleb kooskõlastada kinnisasja valdajaga. (2) Korrastamiskohustus on täidetud, kui uuringuruumi teenindusala korrastamise akti on heaks kiitnud uuringuruumi asukoha keskkonnateenistuse juhataja või tema volitatud isik. (3) Uuringuruumi asukoha keskkonnateenistuse juhataja või tema volitatud isik kiidab uuringuruumi teenindusala korrastamise akti heaks, kui uuringuruumi teenindusala on korrastatud nõuetekohaselt.",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_46 (redaktsioon 824890)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "824890",
      "estleg:supersededByVersion": {
        "@id": "estleg:Maapueseadus_Par_46_v13118973"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Maapueseadus_Par_46_v13118973",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üldgeoloogilise uurimistöö või uurimistöö uuringuruumi teenindusala korrastamise kohta koostab töö tegija akti, mis tuleb kooskõlastada kinnisasja valdajaga. (2) Korrastamiskohustus on täidetud, kui uuringuruumi teenindusala korrastamise akti on heaks kiitnud Keskkonnaamet. (3) Keskkonnaamet kiidab uuringuruumi teenindusala korrastamise akti heaks, kui uuringuruumi teenindusala on korrastatud nõuetekohaselt.",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_46 (redaktsioon 13118973)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13118973",
      "estleg:supersededByVersion": {
