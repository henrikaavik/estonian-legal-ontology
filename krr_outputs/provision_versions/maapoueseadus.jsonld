        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_82 (redaktsioon 13342547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13342547",
      "estleg:supersededByVersion": {
