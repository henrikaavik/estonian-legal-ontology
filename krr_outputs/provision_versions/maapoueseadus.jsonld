      }
    },
    {
      "@id": "estleg:Maapueseadus_Par_64_v970635",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Kriitiliseks varuks arvatud turbavarudega alade nimekirja kehtestab keskkonnaminister.",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_64 (redaktsioon 970635)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "970635",
