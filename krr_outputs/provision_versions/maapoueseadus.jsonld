      }
    },
    {
      "@id": "estleg:Maapueseadus_Par_64_v12989007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Kehtetu –",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_64 (redaktsioon 12989007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12989007",
      "estleg:supersededByVersion": {
        "@id": "estleg:Maapueseadus_Par_64_v13341455"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Maapueseadus_Par_64_v13341455",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Kehtetu – (3) Kaevandamisega rikutud mahajäetud turbaalade nimekirja kinnitab keskkonnaminister. (4) Kaevandamisega rikutud mahajäetud turbaaladel kaevandamisele ei kohaldata käesoleva paragrahvi lõike 1 alusel kehtestatud turba kriitilise varu suurust ning kasutusmäära. (5) Käesoleva paragrahvi lõikes 3 nimetatud aladele esitatud maavara kaevandamise loa taotlusi menetletakse käesolevas seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_64 (redaktsioon 13341455)",
