    {
      "@id": "estleg:Maapueseadus_Par_83_v727596",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_83"
      },
      "estleg:versionValidFrom": {
