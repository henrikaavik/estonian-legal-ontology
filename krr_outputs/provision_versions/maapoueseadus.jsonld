    },
    {
      "@id": "estleg:Maapueseadus_Par_69_v115032013035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaevandamisega rikutud maa nõuetekohaselt korrastamata jätmise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_69 (redaktsioon 115032013035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032013035",
