      }
    },
    {
      "@id": "estleg:Maapueseadus_Par_64_v824890",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turba kriitilise varu suuruse ja kasutusmäärad kehtestab Vabariigi Valitsus. (2) Kriitiliseks varuks arvatud turbavarudega alade nimekirja kehtestab keskkonnaminister.",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_64 (redaktsioon 824890)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "824890",
      "estleg:supersededByVersion": {
