      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mäeeraldis on kaevandamisloaga kaevandamiseks määratud maapõue osa. (2) Mäeeraldise teenindusmaa on kaevandamisloaga kaevandamiseks määratud ala mäeeraldise ümber või kohal ja ümber.",
      "rdfs:label": {
