      }
    },
    {
      "@id": "estleg:Maapueseadus_Par_82_v824890",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaregistri seaduse (RT I 2002, 58, 361; 2004, 30, 209) §-s 38 tehakse järgmised muudatused: lõike 1 punkt 4 muudetakse ja sõnastatakse järgmiselt: « 4) programmi, uuringu või inventeerimise alusel tehtud töö vastuvõtja või kinnitaja;»; lõike 4 sissejuhatav osa muudetakse ja sõnastatakse järgmiselt: « (4) Seadusega nimetatud või riigieelarvest rahastatava programmi, uuringu või inventeerimise alusel tehtud töö vastuvõtja või kinnitaja esitab keskkonnaregistrile andmed järgmiste objektide ja andmestike kohta:».",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_82 (redaktsioon 824890)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "824890",
      "estleg:supersededByVersion": {
        "@id": "estleg:Maapueseadus_Par_82_v13342547"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Maapueseadus_Par_82_v13342547",
