      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maardla on üldgeoloogilise uurimistöö või geoloogilise uuringuga piiritletud ja uuritud ning keskkonnaregistris arvele võetud maavara lasund või selle osa koos vahekihtidega.",
      "rdfs:label": {
