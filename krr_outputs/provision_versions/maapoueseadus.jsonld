    {
      "@id": "estleg:Maapueseadus_Par_70_v110112016001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Maapueseadus_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 66 lõike 1 punktis 2 ning keskkonnaseadustiku üldosa seaduse § 59 lõike 1 punktides 2 ja 3 sätestatud alustel võib kaevandamisloa andja kaevandamisloa kehtivuse täielikult või osaliselt peatada kuni kolmeks kuuks. (2) Kaevandamisloa kehtivuse peatamine otsustatakse avatud menetluseta. (3) Kaevandamisloa andja teavitab loa peatamisest mäeeraldise asukoha kohaliku omavalitsuse üksust, Maa-ametit, Keskkonnaministeeriumi, Keskkonnainspektsiooni ja Tehnilise Järelevalve Ametit.",
      "rdfs:label": {
        "@value": "Maapueseadus_Par_70 (redaktsioon 110112016001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110112016001",
      "estleg:supersededByVersion": {
        "@id": "estleg:Maapueseadus_Par_70_v112122018053"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
