    {
      "@id": "estleg:Reg_159070_Par_3_4_v159070",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159070_Par_3_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2023. aastal võib Tartu Halduskohtus nimetada ametisse täiendava kohtuniku, arvestades, et Tartu kohtumajas võib 2023. aastal olla 6 kohtunikku ning Tartu Halduskohtus kokku 9 kohtunikku. RT I 2023-01-10 5 110012023005 2023-01-13 2023. aastal võib Tartu Halduskohtus nimetada ametisse täiendava kohtuniku, arvestades, et Tartu kohtumajas võib 2023. aastal olla 6 kohtunikku ning Tartu Halduskohtus kokku 9 kohtunikku.",
      "rdfs:label": {
        "@value": "Reg_159070_Par_3_4 (redaktsioon 159070)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159070",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159070",
      "estleg:sourceAct": "Maa-, haldus- ja ringkonnakohtu kohtunike ja kohtunikuabide arv ning jagunemine kohtumajade vahel",
      "estleg:provisionRef": "Reg_159070 § 3_4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159070_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_159070_Par_3_5_v159070",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159070_Par_3_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2023. aastal võib Tartu Ringkonnakohtus nimetada ametisse kaks täiendavat kohtunikku, arvestades, et ringkonnakohtus võib kuni 2024. aasta lõpuni olla 18 kohtunikku. RT I 2023-04-06 3 106042023003 2023-04-09 2023. aastal võib Tartu Ringkonnakohtus nimetada ametisse kaks täiendavat kohtunikku, arvestades, et ringkonnakohtus võib kuni 2024. aasta lõpuni olla 18 kohtunikku.",
      "rdfs:label": {
        "@value": "Reg_159070_Par_3_5 (redaktsioon 159070)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159070",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159070",
      "estleg:sourceAct": "Maa-, haldus- ja ringkonnakohtu kohtunike ja kohtunikuabide arv ning jagunemine kohtumajade vahel",
      "estleg:provisionRef": "Reg_159070 § 3_5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159070_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_159070_Par_3_6_v159070",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159070_Par_3_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2024. aastal võib Tallinna Ringkonnakohtus nimetada ametisse kolm täiendavat kohtunikku arvestusega, et kuni 2024. aasta lõpuni võib ringkonnakohtus olla 33 kohtunikku. RT I 2023-10-24 1 124102023001 2024-01-01 2024. aastal võib Tallinna Ringkonnakohtus nimetada ametisse kolm täiendavat kohtunikku arvestusega, et kuni 2024. aasta lõpuni võib ringkonnakohtus olla 33 kohtunikku.",
      "rdfs:label": {
        "@value": "Reg_159070_Par_3_6 (redaktsioon 159070)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159070",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159070",
      "estleg:sourceAct": "Maa-, haldus- ja ringkonnakohtu kohtunike ja kohtunikuabide arv ning jagunemine kohtumajade vahel",
      "estleg:provisionRef": "Reg_159070 § 3_6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159070_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_159070_Par_3_7_v159070",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159070_Par_3_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2024. aastal võib Tallinna Halduskohtus nimetada ametisse täiendava kohtuniku arvestusega, et kuni 31. maini 2025. aastal võib Pärnu kohtumajas olla 2 kohtunikku ning halduskohtus kokku 19 kohtunikku. RT I 2024-04-02 4 102042024004 2024-04-05 2024. aastal võib Tallinna Halduskohtus nimetada ametisse täiendava kohtuniku arvestusega, et kuni 31. maini 2025. aastal võib Pärnu kohtumajas olla 2 kohtunikku ning halduskohtus kokku 19 kohtunikku.",
      "rdfs:label": {
        "@value": "Reg_159070_Par_3_7 (redaktsioon 159070)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159070",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159070",
      "estleg:sourceAct": "Maa-, haldus- ja ringkonnakohtu kohtunike ja kohtunikuabide arv ning jagunemine kohtumajade vahel",
      "estleg:provisionRef": "Reg_159070 § 3_7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159070_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_159070_Par_3_8_v159070",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159070_Par_3_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2025. aastal võib Tartu Ringkonnakohtus nimetada ametisse ühe täiendava kohtuniku arvestusega, et kuni 2030. aasta lõpuni võib ringkonnakohtus olla 17 kohtunikku. RT I 2025-04-12 49 112042025049 2025-04-15 2025. aastal võib Tartu Ringkonnakohtus nimetada ametisse ühe täiendava kohtuniku arvestusega, et kuni 2030. aasta lõpuni võib ringkonnakohtus olla 17 kohtunikku.",
      "rdfs:label": {
        "@value": "Reg_159070_Par_3_8 (redaktsioon 159070)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159070",
