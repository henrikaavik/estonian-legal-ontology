    {
      "@id": "estleg:Reg_319477_Par_1_v319477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_319477_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse: 1 1) riigi infosüsteemi haldussüsteem; 2 2) andmekogu registreerimise kord riigi infosüsteemi halduse infosüsteemis; 3 3) andmekogu tehnilise dokumentatsiooni (edaspidi andmekogu dokumentatsioon) kooskõlastamise tingimused ja kord; 4 4) andmekogu asutamise korralduslikud nõuded; 5 5) riigi infosüsteemi halduse infosüsteemi pidamise kord. Käesoleva määrusega kehtestatakse: riigi infosüsteemi haldussüsteem; andmekogu registreerimise kord riigi infosüsteemi halduse infosüsteemis; andmekogu tehnilise dokumentatsiooni (edaspidi andmekogu dokumentatsioon) kooskõlastamise tingimused ja kord; andmekogu asutamise korralduslikud nõuded; riigi infosüsteemi halduse infosüsteemi pidamise kord.",
      "rdfs:label": {
        "@value": "Reg_319477_Par_1 (redaktsioon 319477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "319477",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/319477",
