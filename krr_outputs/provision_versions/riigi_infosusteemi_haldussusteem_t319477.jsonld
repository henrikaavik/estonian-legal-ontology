        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "RIHA vastutav töötleja on Riigi Infosüsteemi Amet. RT I 2016-03-29 2 129032016002 2016-04-01 RIHA vastutav töötleja on Riigi Infosüsteemi Amet.",
      "rdfs:label": {
        "@value": "Reg_319477_Par_15 (redaktsioon 319477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "319477",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/319477",
      "estleg:sourceAct": "Riigi infosüsteemi haldussüsteem",
      "estleg:provisionRef": "Reg_319477 § 15",
      "estleg:partOfAct": {
