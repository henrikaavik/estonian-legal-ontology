      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "RIHA kasutajatoe süsteemi, mis hõlmab intsidendi- ja probleemihaldust, muudatuste halduse süsteemi ning monitooringusüsteemi, rakendatakse hiljemalt 1. juulil 2009. a. RIHA kasutajatoe süsteemi, mis hõlmab intsidendi- ja probleemihaldust, muudatuste halduse süsteemi ning monitooringusüsteemi, rakendatakse hiljemalt 1. juulil 2009. a.",
      "rdfs:label": {
        "@value": "Reg_319477_Par_35 (redaktsioon 319477)",
        "@language": "et"
      },
