    {
      "@id": "estleg:Reg_319477_Par_8_v319477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_319477_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu dokumentatsiooni kooskõlastamisest keeldumise korral tuuakse välja kooskõlastamisest keeldumise põhjused, mille kõrvaldamise järel tuleb parandatud dokumentatsioon esitada uuesti kooskõlastamiseks. RT I 2009 11 68 13143614 2009-02-16 Andmekogu dokumentatsiooni kooskõlastamisest keeldumise korral tuuakse välja kooskõlastamisest keeldumise põhjused, mille kõrvaldamise järel tuleb parandatud dokumentatsioon esitada uuesti kooskõlastamiseks. 2 (2) Paragrahvi 7 lõikes 1 sätestatud kooskõlastuseta ei või andmekogu asutada ega andmekogu andmete koosseisu muuta. Paragrahvi 7 lõikes 1 sätestatud kooskõlastuseta ei või andmekogu asutada ega andmekogu andmete koosseisu muuta.",
      "rdfs:label": {
        "@value": "Reg_319477_Par_8 (redaktsioon 319477)",
