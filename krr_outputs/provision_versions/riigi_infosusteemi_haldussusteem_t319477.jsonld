      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi infosüsteemi haldussüsteemi eesmärk on riigi infosüsteemi haldamise läbipaistvuse tagamine, riigi infohalduse planeerimine, riigi, kohaliku omavalitsuse üksuse ja avalikke ülesandeid täitvate eraõiguslike isikute andmekogude koosvõime toetamine ning andmekogude nõuetele vastavuse kontrollifunktsiooni võimaldamine. RT I 2016-03-29 2 129032016002 2016-04-01 Riigi infosüsteemi haldussüsteemi eesmärk on riigi infosüsteemi haldamise läbipaistvuse tagamine, riigi infohalduse planeerimine, riigi, kohaliku omavalitsuse üksuse ja avalikke ülesandeid täitvate eraõiguslike isikute andmekogude koosvõime toetamine ning andmekogude nõuetele vastavuse kontrollifunktsiooni võimaldamine.",
      "rdfs:label": {
        "@value": "Reg_319477_Par_3 (redaktsioon 319477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "319477",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/319477",
      "estleg:sourceAct": "Riigi infosüsteemi haldussüsteem",
      "estleg:provisionRef": "Reg_319477 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_319477_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_319477_Par_30_v319477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
