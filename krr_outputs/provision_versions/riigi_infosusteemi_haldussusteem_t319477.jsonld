    {
      "@id": "estleg:Reg_319477_Par_20_v319477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_319477_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) RIHA kontaktisikute alamregistrisse kantakse § 19 lõikes 1 sätestatud RIHA organisatsioonide alamregistrisse kantavate organisatsioonide kontaktisikute kohta käesoleva paragrahvi lõikes 2 loetletud üldandmed. RT I 2016-03-29 2 129032016002 2016-04-01 RIHA kontaktisikute alamregistrisse kantakse § 19 lõikes 1 sätestatud RIHA organisatsioonide alamregistrisse kantavate organisatsioonide kontaktisikute kohta käesoleva paragrahvi lõikes 2 loetletud üldandmed. 2 (2) RIHA kontaktisikute alamregistrisse kantavate kontaktisikute üldandmete koosseis: 1 1) kontaktisiku ametikoha nimi; 2 2) kontaktisiku ees- ja perekonnanimi; 3 3) kontaktisiku kirjeldus; 4 4) kontaktisiku õigused RIHA-s; 5 5) kontaktisiku õiguste kehtivuse aeg, õiguste kehtivuse olek; 6 6) kontaktisiku rolli nimetus asutuses; 7 7) kontaktisiku vastutustaset iseloomustav tunnus; 8 8) kontaktisiku e-posti aadress ja telefoninumber. RIHA kontaktisikute alamregistrisse kantavate kontaktisikute üldandmete koosseis: kontaktisiku ametikoha nimi; kontaktisiku ees- ja perekonnanimi; kontaktisiku kirjeldus; kontaktisiku õigused RIHA-s; kontaktisiku õiguste kehtivuse aeg, õiguste kehtivuse olek; kontaktisiku rolli nimetus asutuses; kontaktisiku vastutustaset iseloomustav tunnus; kontaktisiku e-posti aadress ja telefoninumber.",
      "rdfs:label": {
        "@value": "Reg_319477_Par_20 (redaktsioon 319477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "319477",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/319477",
      "estleg:sourceAct": "Riigi infosüsteemi haldussüsteem",
      "estleg:provisionRef": "Reg_319477 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_319477_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_319477_Par_21_v319477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
