    {
      "@id": "estleg:Reg_1040646_Par_12_v1040646",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040646_Par_12"
