        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RVaS_Par_7_v130042024006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVaS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väikest riigivappi kasutatakse kujundus- või turvaelemendina Riigikogu, peaministri, Vabariigi Valitsuse, Riigikohtu, kohtute, õiguskantsleri, Riigikogu Kantselei, Riigikantselei, Riigikontrolli, Vabariigi Presidendi Kantselei, Eesti Panga, kaitseväe juhataja, ministeeriumide ja muude riigiasutuste või riigivõimu teostavate organite ja isikute väljaantavatel dokumentidel ning seda võib kasutada nende trükistel. (2) Väikest riigivappi kasutatakse kujunduselemendina: käesoleva paragrahvi lõikes 1 loetletud riigiasutuste, riigivõimu teostavate organite ja isikute alalise asukoha hoonetel, siltidel ja embleemidel ning seda võib kasutada muudel esemetel; kaitseväe juhataja ja Eesti mereväe lipul; Eesti rahvusvõistkonna riietusel; väärtpaberitel, postimaksevahenditel ja rahamärkidel; riiklikel autasudel ja nende tunnistustel seadusega või seaduse alusel kehtestatud juhtudel. (3) Väikest riigivappi kasutatakse pitseri elemendina: käesoleva paragrahvi lõikes 1 loetletud riigiasutuste, riigivõimu teostavate organite ja isikute pitseril; kohaliku omavalitsuse riigivapiga pitseril; vandetõlkidel ja vandeadvokaatidel. (4) Kaitseliit kasutab väikest riigivappi enda embleemi osana.",
      "rdfs:label": {
        "@value": "RVaS_Par_7 (redaktsioon 130042024006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130042024006"
    },
    {
      "@id": "estleg:RVaS_Par_8_v27149",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVaS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigivappi ei tohi kasutada vääritul moel.",
      "rdfs:label": {
        "@value": "RVaS_Par_8 (redaktsioon 27149)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27149"
    },
    {
      "@id": "estleg:RVaS_Par_9_v27149",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVaS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kauba- ega teenindusmärgina ei registreerita tähist, mis sisaldab riigivappi. (2) Riigivappi sisaldavat tähist ei tohi kasutada kauba- või teenindusmärgina.",
      "rdfs:label": {
        "@value": "RVaS_Par_9 (redaktsioon 27149)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27149"
