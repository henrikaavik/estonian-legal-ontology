      }
    },
    {
      "@id": "estleg:RVaS_Par_6_v13188457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVaS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Suurt riigivappi kasutatakse kujundus- või turvaelemendina: seadustel, Riigikogu otsustel, avaldustel, deklaratsioonidel ja pöördumistel, Vabariigi Presidendi seadlustel, otsustel ja käskkirjadel ning tema antavatel teistel dokumentidel ja seda võib kasutada Vabariigi Presidendi poolt väljaantavatel muudel trükistel; Riigikohtu lahenditel; välislepingutega ühinemise ja nende denonsseerimise kirjadel, välislepingute ratifitseerimise kirjadel ja välislepingute kaantel; Eesti Vabariigi erakorraliste ja täievoliliste suursaadikute välissuhtluses kasutatavatel dokumentidel ja kutsetel; seadusega või seaduse alusel Vabariigi Valitsuse määratud juhtudel antavatel isikut ja kodakondsust, perekonnaseisu, haridust, ametit ja elukutset tõendavatel dokumentidel; väärtpaberitel, postimaksevahenditel ja rahamärkidel. (2) Suurt riigivappi kasutatakse kujunduselemendina: Vabariigi Presidendi residentsil, esindusruumides ja Riigikogu ja Vabariigi Valitsuse alalise asukoha hoonetel ning nende asutuste istungisaalides, esindusruumides ja trükistel; Eesti Vabariigi välisesinduste ja aukonsuli juhitavate konsulaarasutuste asukohta tähistavatel siltidel; Riigikohtu ja kohtute hoonetel, siltidel ja kohtusaalides; perekonnaseisuasutuste saalides; Vabariigi Presidendi lipul ja vimplil; ajalooliste kahepoolsete väeosalippude riigilipu värvidega küljel; kaitseväelaste vormiriietusel ning ametnike ameti- ja vormiriietusel Vabariigi Valitsuse sätestatud juhtudel; kohtunike ja prokuröride ametiriietusel; Riigi Teataja esimese, teise ja kolmanda osa ning Riigi Teataja Lisa esimesel leheküljel; riiklikel autasudel ja nende tunnistustel seadusega või seaduse alusel kehtestatud juhtudel; Eesti riigipiiri tähistavatel põhipiirimärkidel ja piiripunktides. (3) Suurt riigivappi kasutatakse pitseri elemendina: riigipitseris; Vabariigi Presidendi pitseris.",
      "rdfs:label": {
        "@value": "RVaS_Par_6 (redaktsioon 13188457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13188457",
      "estleg:supersededByVersion": {
        "@id": "estleg:RVaS_Par_6_v13312011"
      },
      "estleg:versionValidTo": {
        "@value": "2010-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RVaS_Par_6_v13312011",
