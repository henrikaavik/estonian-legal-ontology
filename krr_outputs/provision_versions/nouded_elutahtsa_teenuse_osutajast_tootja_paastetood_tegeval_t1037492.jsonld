      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037492_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Päästeüksuse ülesanne on teha elutähtsa teenuse toimepidevuse tagamist ohustava päästesündmuse korral elektrijaamas päästetööd nii iseseisvalt Päästeameti päästemeeskonna saabumiseni kui ka koostöös Päästeametiga. Päästeüksuse ülesanne on teha elutähtsa teenuse toimepidevuse tagamist ohustava päästesündmuse korral elektrijaamas päästetööd nii iseseisvalt Päästeameti päästemeeskonna saabumiseni kui ka koostöös Päästeametiga.",
      "rdfs:label": {
        "@value": "Reg_1037492_Par_3 (redaktsioon 1037492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037492",
      "estleg:sourceAct": "Nõuded elutähtsa teenuse osutajast tootja päästetööd tegevale päästeüksusele ja päästeüksuse koostöö kord päästeasutusega",
      "estleg:provisionRef": "Reg_1037492 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037492_Par_4_v1037492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037492_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Päästeüksuse töökorraldus peab tagama ööpäev ringi vähemalt ühe päästemeeskonna valmisoleku päästetöö alustamiseks viie minuti jooksul arvates teate saamisest päästesündmuse kohta elektrijaamas. Päästeüksuse töökorraldus peab tagama ööpäev ringi vähemalt ühe päästemeeskonna valmisoleku päästetöö alustamiseks viie minuti jooksul arvates teate saamisest päästesündmuse kohta elektrijaamas. 2 (2) Päästetöö tegemiseks võib elektrijaama töötajatest moodustada pääste abimeeskondi, keda kaasatakse päästetööle. Päästetöö tegemiseks võib elektrijaama töötajatest moodustada pääste abimeeskondi, keda kaasatakse päästetööle.",
      "rdfs:label": {
        "@value": "Reg_1037492_Par_4 (redaktsioon 1037492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037492",
      "estleg:sourceAct": "Nõuded elutähtsa teenuse osutajast tootja päästetööd tegevale päästeüksusele ja päästeüksuse koostöö kord päästeasutusega",
      "estleg:provisionRef": "Reg_1037492 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037492_Par_5_v1037492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037492_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Päästeüksust omav isik, päästeüksus ja päästeasutus teevad koostööd päästesündmuseks valmisoleku tagamisel, sealhulgas toimepidevuse riskide hindamisel, ennetavate meetmete ja päästetöö planeerimisel ning päästetöö tegemisel. Päästeüksust omav isik, päästeüksus ja päästeasutus teevad koostööd päästesündmuseks valmisoleku tagamisel, sealhulgas toimepidevuse riskide hindamisel, ennetavate meetmete ja päästetöö planeerimisel ning päästetöö tegemisel. 2 (2) Päästeüksust omav isik esitab hiljemalt iga aasta 1. märtsil Päästeameti etteantud vormi alusel ülevaate päästetöö tegemiseks valmisoleku tagamise meetmetest, sealhulgas varustusest, väljaõppest ja töökorralduse muudatustest. Päästeametil on õigus nõuda päästeüksust omavalt isikult ülevaate täiendamist, kui ülevaate alusel ei ole võimalik hinnata, kas päästeüksuse valmisolek päästetöö tegemiseks on tagatud. Päästeüksust omav isik esitab hiljemalt iga aasta 1. märtsil Päästeameti etteantud vormi alusel ülevaate päästetöö tegemiseks valmisoleku tagamise meetmetest, sealhulgas varustusest, väljaõppest ja töökorralduse muudatustest. Päästeametil on õigus nõuda päästeüksust omavalt isikult ülevaate täiendamist, kui ülevaate alusel ei ole võimalik hinnata, kas päästeüksuse valmisolek päästetöö tegemiseks on tagatud. 3 (3) Päästeüksust omav isik või päästeüksus teavitab päästesündmusest elektrijaamas Häirekeskust ja annab päästetöö tegemisest päästeasutusele regulaarselt teavet. Päästeüksust omav isik või päästeüksus teavitab päästesündmusest elektrijaamas Häirekeskust ja annab päästetöö tegemisest päästeasutusele regulaarselt teavet. 4 (4) Päästeüksust omava isiku ja päästeüksuse koostöö korraldamisel päästeasutusega päästetöö tegemisel lähtutakse päästeseaduse § 5 lõike 3 alusel kehtestatud päästesündmusel osalevate riigi- ja kohaliku omavalitsuse asutuste ning isikute koostöö korrast. Päästeüksust omava isiku ja päästeüksuse koostöö korraldamisel päästeasutusega päästetöö tegemisel lähtutakse päästeseaduse § 5 lõike 3 alusel kehtestatud päästesündmusel osalevate riigi- ja kohaliku omavalitsuse asutuste ning isikute koostöö korrast.",
      "rdfs:label": {
        "@value": "Reg_1037492_Par_5 (redaktsioon 1037492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037492",
      "estleg:sourceAct": "Nõuded elutähtsa teenuse osutajast tootja päästetööd tegevale päästeüksusele ja päästeüksuse koostöö kord päästeasutusega",
      "estleg:provisionRef": "Reg_1037492 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037492_Par_6_v1037492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
