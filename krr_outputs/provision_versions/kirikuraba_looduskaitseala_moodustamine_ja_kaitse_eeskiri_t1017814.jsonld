    {
      "@id": "estleg:Reg_1017814_Par_12_v1017814",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017814_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Kirikumetsa piiranguvöönd. Kaitsealal on Kirikumetsa piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1017814_Par_12 (redaktsioon 1017814)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017814",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017814",
      "estleg:sourceAct": "Kirikuraba looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1017814 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017814_Map"
      }
    },
    {
      "@id": "estleg:Reg_1017814_Par_13_v1017814",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017814_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse säilitamine, liikide soodsa seisundi tagamine ning seal esinevate elupaikade kaitse. Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse säilitamine, liikide soodsa seisundi tagamine ning seal esinevate elupaikade kaitse.",
      "rdfs:label": {
        "@value": "Reg_1017814_Par_13 (redaktsioon 1017814)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017814",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017814",
      "estleg:sourceAct": "Kirikuraba looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1017814 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017814_Map"
      }
    },
    {
      "@id": "estleg:Reg_1017814_Par_14_v1017814",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017814_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus, arvestades käesolevas määruses sätestatud erisustega; 2 2) rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas. Piiranguvööndis on lubatud: majandustegevus, arvestades käesolevas määruses sätestatud erisustega; rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas. 2 (2) Piiranguvööndis on lubatud uuendusraie tegemine 1. septembrist 31. jaanuarini, kusjuures arvestada tuleb järgmisi piiranguid: 1 1) lageraie korral ei tohi langi pindala ületada 1 ha ning laius 30 meetrit; 2 2) turberaie korral ei tohi langi pindala ületada 2 ha; 3 3) üle 60 aasta vanuse metsa osakaal piiranguvööndis tervikuna ei tohi jääda väiksemaks kui 50%; 4 4) uuendusraielankide ümber tuleb jätta üle 60 aasta vanust puistut vähemalt 100 m laiuse ribana; 5 5) männikute, kuusikute, kaasikute, haavikute ja sanglepikute uuendusraielangil tuleb elustiku mitmekesisuse tagamiseks jätta alles säilikpuud ja nende säilinud osad tüvepuidu kogumahuga vähemalt kümme tihumeetrit hektari kohta. Piiranguvööndis on lubatud uuendusraie tegemine 1. septembrist 31. jaanuarini, kusjuures arvestada tuleb järgmisi piiranguid: lageraie korral ei tohi langi pindala ületada 1 ha ning laius 30 meetrit; turberaie korral ei tohi langi pindala ületada 2 ha; üle 60 aasta vanuse metsa osakaal piiranguvööndis tervikuna ei tohi jääda väiksemaks kui 50%; uuendusraielankide ümber tuleb jätta üle 60 aasta vanust puistut vähemalt 100 m laiuse ribana; männikute, kuusikute, kaasikute, haavikute ja sanglepikute uuendusraielangil tuleb elustiku mitmekesisuse tagamiseks jätta alles säilikpuud ja nende säilinud osad tüvepuidu kogumahuga vähemalt kümme tihumeetrit hektari kohta.",
      "rdfs:label": {
        "@value": "Reg_1017814_Par_14 (redaktsioon 1017814)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017814",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017814",
      "estleg:sourceAct": "Kirikuraba looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1017814 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017814_Map"
      }
    },
    {
      "@id": "estleg:Reg_1017814_Par_15_v1017814",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017814_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) veekogude veetaseme ja kaldajoone muutmine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab; 5 5) maavara kaevandamine; 6 6) biotsiidi, taimekaitsevahendi ja väetise kasutamine. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; veekogude veetaseme ja kaldajoone muutmine; puhtpuistute kujundamine ja energiapuistute rajamine; puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab; maavara kaevandamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine.",
      "rdfs:label": {
        "@value": "Reg_1017814_Par_15 (redaktsioon 1017814)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017814",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017814",
      "estleg:sourceAct": "Kirikuraba looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1017814 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017814_Map"
      }
    },
