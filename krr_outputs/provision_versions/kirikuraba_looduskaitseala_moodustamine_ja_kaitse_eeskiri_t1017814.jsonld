    {
      "@id": "estleg:Reg_1017814_Par_17_v1017814",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017814_Par_17"
      },
