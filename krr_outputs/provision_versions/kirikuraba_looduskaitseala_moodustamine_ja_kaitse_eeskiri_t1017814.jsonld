      "estleg:provisionRef": "Reg_1017814 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017814_Map"
      }
    },
    {
      "@id": "estleg:Reg_1017814_Par_18_v1017814",
      "@type": [
        "owl:NamedIndividual",
