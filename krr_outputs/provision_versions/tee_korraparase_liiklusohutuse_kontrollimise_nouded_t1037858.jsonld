      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tee korrapärase liiklusohutuse kontrollimise nõuded (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tee korrapärase liiklusohutuse kontrollimise nõuded"
    },
    {
      "@id": "estleg:Reg_1037858_Par_1_v1037858",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037858_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tee ohutuse kontrollimise eesmärk on tuvastada ja liiklusohutuse parandamiseks kõrvaldada teedevõrgu ülevaatusel tuvastatud puudused esimesel mõistlikul võimalusel. Tee ohutuse kontrollimise eesmärk on tuvastada ja liiklusohutuse parandamiseks kõrvaldada teedevõrgu ülevaatusel tuvastatud puudused esimesel mõistlikul võimalusel. 2 (2) Tee ohutuse kontrollimisel keskendutakse puudustele, mida on võimalik kõrvaldada korrashoiuga. Tee ohutuse kontrollimisel keskendutakse puudustele, mida on võimalik kõrvaldada korrashoiuga. 3 (3) Tee ohutuse kontrollimine jaguneb teedevõrgu ülevaatuseks ja tee ehitamise aegseks ülevaatuseks. Tee ohutuse kontrollimine jaguneb teedevõrgu ülevaatuseks ja tee ehitamise aegseks ülevaatuseks. 4 (4) Tee ohutuse kontrollimine on kohustuslik ehitusseadustiku § 102 lõikes 11 nimetatud teel. RT I 2021-12-09 2 109122021002 2021-12-17 Tee ohutuse kontrollimine on kohustuslik ehitusseadustiku § 102 lõikes 11 nimetatud teel. 5 (5) Tee ohutuse kontrollimist korraldab riigiteel Transpordiamet ja kohalikul teel valla- või linnavalitsus (edaspidi pädev asutus). RT I 2021-12-09 2 109122021002 2021-12-17 Tee ohutuse kontrollimist korraldab riigiteel Transpordiamet ja kohalikul teel valla- või linnavalitsus (edaspidi pädev asutus). 6 (6) Pädev asutus säilitab käesoleva määruse § 2 lõikes 4 ning § 3 lõikes 4 nimetatud aruandeid vähemalt viis aastat või arhiiviseaduses sätestatud korras arhiivi üleandmiseni. Pädev asutus säilitab käesoleva määruse § 2 lõikes 4 ning § 3 lõikes 4 nimetatud aruandeid vähemalt viis aastat või arhiiviseaduses sätestatud korras arhiivi üleandmiseni.",
      "rdfs:label": {
        "@value": "Reg_1037858_Par_1 (redaktsioon 1037858)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037858",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037858",
      "estleg:sourceAct": "Tee korrapärase liiklusohutuse kontrollimise nõuded",
      "estleg:provisionRef": "Reg_1037858 § 1",
