      }
    },
    {
      "@id": "estleg:Reg_1042331_Par_22_v1042331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042331_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vangiregistri hooldus- ja arendustöid ning pidamist rahastatakse riigieelarvest Justiits- ja Digiministeeriumi eelarve kaudu. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Vangiregistri hooldus- ja arendustöid ning pidamist rahastatakse riigieelarvest Justiits- ja Digiministeeriumi eelarve kaudu. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
