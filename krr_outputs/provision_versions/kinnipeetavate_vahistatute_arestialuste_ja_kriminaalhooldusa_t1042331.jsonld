      "estleg:provisionRef": "Reg_1042331 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042331_Map"
      }
    },
    {
      "@id": "estleg:Reg_1042331_Par_9_v1042331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042331_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastutava ja volitatud töötleja ning halduri ametnik või töötaja (edaspidi teenistuja) kasutab vangiregistrit oma teenistuskohale määratud kasutajaliigi ulatuses. Vastutava ja volitatud töötleja ning halduri ametnik või töötaja (edaspidi teenistuja) kasutab vangiregistrit oma teenistuskohale määratud kasutajaliigi ulatuses.",
