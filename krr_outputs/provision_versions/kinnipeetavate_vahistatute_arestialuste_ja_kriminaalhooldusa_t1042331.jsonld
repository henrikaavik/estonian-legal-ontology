        "@type": "xsd:date"
      },
      "estleg:versionText": "Vangiregistri turvaklass on K2T2S2, turbeaste on keskmine. Vangiregistri turvaklass on K2T2S2, turbeaste on keskmine.",
      "rdfs:label": {
        "@value": "Reg_1042331_Par_2 (redaktsioon 1042331)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042331",
