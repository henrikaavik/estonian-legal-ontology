      "estleg:provisionRef": "ELTS § 41",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_41_v13277850",
      "@type": [
