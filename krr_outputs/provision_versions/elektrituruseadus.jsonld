      }
    },
    {
      "@id": "estleg:ELTS_Par_79_v264412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 77 kohaselt avalikustatud müüja esitab Energiaturu Inspektsioonile müügikohustuse täitmiseks müüdava elektrienergia kaalutud keskmise hinna piirmäära kooskõlastamisel eraldi tulude ja kulude jaotuse müügikohustuse täitmiseks müüdava elektrienergia ning muu elektrienergia müügi osas.",
      "rdfs:label": {
        "@value": "ELTS_Par_79 (redaktsioon 264412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264412",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_79_v12894671"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/264412",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 79",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_79_v12894671",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 77 kohaselt avalikustatud müüja esitab Konkurentsiametile müügikohustuse täitmiseks müüdava elektrienergia kaalutud keskmise hinna piirmäära kooskõlastamisel eraldi tulude ja kulude jaotuse müügikohustuse täitmiseks müüdava elektrienergia ning muu elektrienergia müügi osas.",
      "rdfs:label": {
        "@value": "ELTS_Par_79 (redaktsioon 12894671)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894671",
      "estleg:supersededByVersion": {
