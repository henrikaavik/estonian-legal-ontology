      },
      "estleg:versionValidTo": {
        "@value": "2014-05-06",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112122011009",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 21_2",
      "estleg:partOfAct": {
