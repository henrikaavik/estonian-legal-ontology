      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhivõrguettevõtja töötab välja segajäägi arvutamise metoodika ja avaldab 30. juuniks eelneva kalendriaasta kohta arvutatud segajäägi.",
      "rdfs:label": {
        "@value": "ELTS_Par_58_2 (redaktsioon 112072014020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014020",
      "estleg:supersededByVersion": {
