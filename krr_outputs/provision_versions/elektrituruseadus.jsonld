      "estleg:provisionRef": "ELTS § 94",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_94_v12894671",
      "@type": [
