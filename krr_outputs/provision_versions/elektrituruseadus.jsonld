    {
      "@id": "estleg:ELTS_Par_1_v130122021013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib elektrienergia tootmist, edastamist, müüki, eksporti, importi ja transiiti ning elektrisüsteemi majanduslikku ja tehnilist juhtimist. Seadus näeb ette elektrituru toimimise põhimõtted, lähtudes vajadusest tagada põhjendatud hinnaga, keskkonnanõuete ja tarbija vajaduste kohane tõhus elektrivarustus ning energiaallikate tasakaalustatud, keskkonnahoidlik ja pikaajaline kasutamine. (2) Käesoleva paragrahvi lõikes 1 nimetatud tegevuses järgitakse koostöö, võrdse kohtlemise ja läbipaistvuse põhimõtet. (2¹) Elektriettevõtja maksab järelevalvetasu konkurentsiseaduses sätestatud alustel ja korras. (3) Elektriettevõtja soodustab tarbija tegevust, mille eesmärk on elektrienergiat säästa. (4) Käesolevas seaduses käsitletud haldusmenetlusele kohaldatakse haldusmenetluse seadust, arvestades käesolevast seadusest tulenevaid erisusi. (5) Käesolevat seadust, välja arvatud §-e 58–596, 925, 108, 1081 ja § 1113 lõiget 3, ei kohaldata võrguga ühendamata elektrijaamale.",
      "rdfs:label": {
        "@value": "ELTS_Par_1 (redaktsioon 130122021013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122021013",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_1_v115032022009"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122021013",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_1_v115032022009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib elektrienergia tootmist, salvestamist, edastamist, müüki, eksporti, importi ja transiiti ning elektrisüsteemi majanduslikku ja tehnilist juhtimist. Seadus näeb ette elektrituru toimimise põhimõtted, lähtudes vajadusest tagada põhjendatud hinnaga, keskkonnanõuete ja tarbija vajaduste kohane tõhus elektrivarustus ning energiaallikate tasakaalustatud, keskkonnahoidlik ja pikaajaline kasutamine. (2) Käesoleva paragrahvi lõikes 1 nimetatud tegevuses järgitakse koostöö, võrdse kohtlemise ja läbipaistvuse põhimõtet. (2¹) Elektriettevõtja maksab järelevalvetasu konkurentsiseaduses sätestatud alustel ja korras. (3) Elektriettevõtja soodustab tarbija tegevust, mille eesmärk on elektrienergiat säästa. (4) Käesolevas seaduses käsitletud haldusmenetlusele kohaldatakse haldusmenetluse seadust, arvestades käesolevast seadusest tulenevaid erisusi. (5) Käesolevat seadust, välja arvatud §-e 58–596, 925, 108, 1081 ja § 1113 lõiget 3, ei kohaldata võrguga ühendamata elektrijaamale.",
      "rdfs:label": {
        "@value": "ELTS_Par_1 (redaktsioon 115032022009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032022009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032022009",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_10_v264412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Müüja on elektrienergiat müüv elektriettevõtja.",
      "rdfs:label": {
        "@value": "ELTS_Par_10 (redaktsioon 264412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264412",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/264412",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 10",
      "estleg:partOfAct": {
