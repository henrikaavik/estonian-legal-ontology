    {
      "@id": "estleg:ELTS_Par_98_v264412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikul, keda Energiaturu Inspektsioon on volitanud täitma käesoleva seaduse § 94 lõikes 1 nimetatud järelevalveülesannet, on õigus siseneda turuosalise territooriumile, ruumi või rajatisse, et kohapeal kontrollida järelevalve teostamiseks vajalikke andmeid ja asjaolusid ning teha dokumentidest väljavõtteid, ärakirju ja koopiaid. (2) Turuosaline või tema esindaja võimaldab takistuste ja piiranguteta teostada käesoleva paragrahvi lõikes 1 nimetatud õigust Energiaturu Inspektsiooni määratud ajal ja kohas ning osutab järelevalvet teostavale isikule igakülgset kaasabi.",
      "rdfs:label": {
        "@value": "ELTS_Par_98 (redaktsioon 264412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264412",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_98_v12894671"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/264412",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 98",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_98_v12894671",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikul, keda Konkurentsiamet on volitanud täitma käesoleva seaduse § 94 lõikes 1 nimetatud järelevalveülesannet, on õigus siseneda turuosalise territooriumile, ruumi või rajatisse, et kohapeal kontrollida järelevalve teostamiseks vajalikke andmeid ja asjaolusid ning teha dokumentidest väljavõtteid, ärakirju ja koopiaid. (2) Turuosaline või tema esindaja võimaldab takistuste ja piiranguteta teostada käesoleva paragrahvi lõikes 1 nimetatud õigust Konkurentsiameti määratud ajal ja kohas ning osutab järelevalvet teostavale isikule igakülgset kaasabi.",
      "rdfs:label": {
        "@value": "ELTS_Par_98 (redaktsioon 12894671)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894671",
      "estleg:supersededByVersion": {
