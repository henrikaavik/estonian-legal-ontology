        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062012023",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 69",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_69_v115032022009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Võrguettevõtja hoiab talle tema tegevuse käigus teatavaks saanud turuosalise tundlikku äriteavet. Sätet ei kohaldata, kui: teave on juba avalikustatud või saanud avalikuks muul viisil kui võrguettevõtja kohustuste rikkumise tõttu; teave on vaja kolmandale isikule edastada käesolevast seadusest tulenevate võrguettevõtja kohustuste täitmiseks; võrguettevõtja peab teabe edastama õigusakti kohaselt. (2) Võrguettevõtja järgib oma tegevusega seotud teavet avaldades võrdse kohtlemise põhimõtet.",
      "rdfs:label": {
        "@value": "ELTS_Par_69 (redaktsioon 115032022009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032022009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032022009",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 69",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_7_v264412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tootja on elektriettevõtja, kes toodab elektrienergiat ühe või mitme tootmisseadme abil. (2) Väiketootja on tootja, kelle Eestis asuvate tootmisseadmete netovõimsus koos temaga ühte kontserni kuuluvate teiste tootjate Eestis asuvate tootmisseadmete netovõimsusega kokku ei ületa 10 MW.",
      "rdfs:label": {
        "@value": "ELTS_Par_7 (redaktsioon 264412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264412",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_7_v12805105"
      },
      "estleg:versionValidTo": {
        "@value": "2007-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/264412",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_7_v12805105",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tootja on elektriettevõtja, kes toodab elektrienergiat ühe või mitme tootmisseadme abil. (2) Väiketootja on tootja, kelle Eestis asuvate tootmisseadmete netovõimsus koos temaga ühte kontserni kuuluvate teiste tootjate Eestis asuvate tootmisseadmete netovõimsusega kokku ei ületa 10 MW. (3) Koostootja on isik, kes toodab elektrienergiat tõhusa koostootmise režiimil. Tõhusa koostootmise nõuded , lähtudes Euroopa Parlamendi ja nõukogu direktiivi 2004/8/EÜ soojus- ja elektrienergia koostootmise stimuleerimiseks siseturu kasuliku soojuse nõudluse alusel, millega muudetakse direktiivi 92/42/EMÜ (ELT L 052, 21.02.2004, lk 50–60) lisas 3 esitatud metoodikast.",
      "rdfs:label": {
        "@value": "ELTS_Par_7 (redaktsioon 12805105)",
        "@language": "et"
      },
