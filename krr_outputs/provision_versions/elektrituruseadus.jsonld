      }
    },
    {
      "@id": "estleg:ELTS_Par_81_2_v128062012023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_81_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Müüja säilitab tehingu tegemisest alates vähemalt viis aastat järgmisi Konkurentsiametile ja Euroopa Komisjonile vajaduse korral esitatavaid teise müüja ja põhivõrguettevõtjaga tehtud elektritehingute ning elektrienergiaga seotud tuletisinstrumentide, mille alusvaraks on elektrienergia, alusel tehtud kõikide tehingute andmeid: tehingu tegemise kuupäev ning tarne- ja arveldustingimused; tehingu maht; tehingu täitmise kuupäev ja kellaaeg kauplemisperioodide kaupa; tehingu hind; ostja andmed; tarnelepingute üksikasjad.",
      "rdfs:label": {
        "@value": "ELTS_Par_81_2 (redaktsioon 128062012023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062012023",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_81_2_v115032022009"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062012023",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 81_2",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_81_2_v115032022009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_81_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Müüja säilitab tehingu tegemisest alates vähemalt viis aastat järgmisi Konkurentsiametile ja Euroopa Komisjonile vajaduse korral esitatavaid teise müüja ja põhivõrguettevõtjaga tehtud elektritehingute ning elektrienergiaga seotud tuletisinstrumentide Euroopa Parlamendi ja nõukogu direktiivi 2014/65/EL finantsinstrumentide turgude kohta ning millega muudetakse direktiive 2002/92/EÜ ja 2011/61/EL (ELT L 173, 12.06.2014, lk 349–496) (16) I lisa C jao punktide 5–7 tähenduses, mille alusvaraks on elektrienergia, alusel tehtud kõikide tehingute andmeid: tehingu tegemise kuupäev ning tarne- ja arveldustingimused; tehingu maht; tehingu täitmise kuupäev ja kellaaeg kauplemisperioodide kaupa; tehingu hind; ostja andmed; tarnelepingute üksikasjad.",
      "rdfs:label": {
        "@value": "ELTS_Par_81_2 (redaktsioon 115032022009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032022009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032022009",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 81_2",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_81_3_v112072014021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
