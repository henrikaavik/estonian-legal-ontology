    {
      "@id": "estleg:ELTS_Par_109_3_v122092022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_109_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2023. aasta 30. septembrini ei või elektrimüüja nõuda universaalteenuse tarbimiseks elektrilepingut sõlmivalt tarbijalt enne käesoleva seaduse § 765 jõustumist sõlmitud elektrilepingu ennetähtaegse lõpetamisega kaasnevat leppetrahvi ega kahju hüvitamist.",
      "rdfs:label": {
        "@value": "ELTS_Par_109_3 (redaktsioon 122092022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122092022002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_109_3_v122102022006"
      },
      "estleg:versionValidTo": {
        "@value": "2022-10-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122092022002",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 109_3",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_109_3_v122102022006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_109_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2023. aasta 30. septembrini ei või elektrimüüja nõuda universaalteenuse tarbimiseks elektrilepingut sõlmivalt kodutarbijalt enne käesoleva seaduse § 765 jõustumist sõlmitud elektrilepingu ennetähtaegse lõpetamisega kaasnevat leppetrahvi ega kahju hüvitamist.",
      "rdfs:label": {
        "@value": "ELTS_Par_109_3 (redaktsioon 122102022006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122102022006",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_109_3_v102052024005"
      },
      "estleg:versionValidTo": {
        "@value": "2024-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122102022006",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 109_3",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_109_3_v102052024005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
