      }
    },
    {
      "@id": "estleg:ELTS_Par_101_5_v130062017027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_101_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Süsteemihalduri või vertikaalselt integreeritud ettevõtja poolt käesoleva seaduse § 16 lõigetes 1, 3 ja 4, §-des 17 ja 181, § 38 lõikes 3, § 39 lõigetes 1, 31, 4 ja 6, § 40 lõikes 7 ning §-des 401, 53, 66, 70, 71, 72, 73 ja 74 sätestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni kümme protsenti ettevõtja viimase auditeeritud majandusaasta käibest.",
      "rdfs:label": {
        "@value": "ELTS_Par_101_5 (redaktsioon 130062017027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062017027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062017027",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 101_5",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_102_v264412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turuosalist võrguteenuse või elektrienergia omavolilise kasutamise eest – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 50 000 krooni. (3) Kohus võib kohaldada käesolevas paragrahvis nimetatud väärteo toimepanemise vahetuks objektiks olnud eseme konfiskeerimist karistusseadustiku (RT I 2001, 61, 364; 2002, 82, 480; 86, 504; 105, 612; 2003, 4, 22) § 83 alusel.",
      "rdfs:label": {
        "@value": "ELTS_Par_102 (redaktsioon 264412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264412",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_102_v12805105"
      },
      "estleg:versionValidTo": {
        "@value": "2007-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/264412",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 102",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
