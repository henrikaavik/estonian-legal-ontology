    {
      "@id": "estleg:ELTS_Par_81_1_v13085438",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_81_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elektriettevõtja esitab Statistikaametile andmed elektrienergia või võrguteenuse hinna kujunemise kohta. Andmete esitamise vormi kehtestab rahandusminister riikliku statistika seaduse § 3 lõike 3 alusel.",
      "rdfs:label": {
        "@value": "ELTS_Par_81_1 (redaktsioon 13085438)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13085438",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_81_1_v13338041"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13085438",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 81_1",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_81_1_v13338041",
      "@type": [
