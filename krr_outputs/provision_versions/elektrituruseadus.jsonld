    {
      "@id": "estleg:ELTS_Par_92_2_v13277850",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_92_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hoonestusloa avaliku veekogu tuuleelektrijaamaga koormamiseks võib anda vaid elektriettevõtjale käesoleva seaduse tähenduses või elektriettevõtjaga ühte kontserni kuuluvale ettevõtjale konkurentsiseaduse § 2 lõike 3 tähenduses. Nimetatud hoonestusloa võib üle anda vaid teisele elektriettevõtjale, elektriettevõtjaga ühte kontserni kuuluvale ettevõtjale või Eesti Vabariigile.",
      "rdfs:label": {
        "@value": "ELTS_Par_92_2 (redaktsioon 13277850)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13277850",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_92_2_v127042022005"
      },
      "estleg:versionValidTo": {
        "@value": "2022-05-06",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13277850",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 92_2",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_92_2_v127042022005",
      "@type": [
