    {
      "@id": "estleg:ELTS_Par_40_1_v13277850",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_40_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Süsteemihaldur maksab perimeetritasu Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 714/2009 võrkudele juurdepääsu tingimuste kohta piiriüleses elektrikaubanduses ning millega tunnistatakse kehtetuks määrus (EÜ) nr 1228/2003 (ELT L 211, 14.8.2009, lk 15–35) kohaselt põhivõrguettevõtjate vahelise elektrienergia transiidi hüvitusmehhanismiga loodud fondi. Perimeetritasu makstakse nendelt tarnetelt, mis pärinevad riikidest või lõpevad riikides, mis ei ole ühinenud nimetatud hüvitusmehhanismiga. Perimeetritasu suurus määratakse igal aastal hüvitusmehhanismi osaks oleva süsteemihaldurite vahelise lepinguga.",
      "rdfs:label": {
        "@value": "ELTS_Par_40_1 (redaktsioon 13277850)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13277850",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_40_1_v128062012023"
      },
      "estleg:versionValidTo": {
        "@value": "2012-07-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13277850",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 40_1",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_40_1_v128062012023",
