    {
      "@id": "estleg:ELTS_Par_16_v13280336",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_16"
      },
      "estleg:versionValidFrom": {
