      "estleg:versionText": "Kehtetu - (jõustumine muudetud - RT I, 02.05.2024, 2)",
      "rdfs:label": {
        "@value": "ELTS_Par_76_5 (redaktsioon 102052024005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102052024005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102052024005",
      "estleg:sourceAct": "Elektrituruseadus",
