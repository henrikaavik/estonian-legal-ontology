      }
    },
    {
      "@id": "estleg:ELTS_Par_39_1_v129062018071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_39_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jaotusvõrguettevõtja, kelle teeninduspiirkonnas üliväike eraldatud võrk asub, tagab selle võrgu varustuskindluse ja bilansi kooskõlas käesoleva seaduse ning võrgueeskirjaga.",
      "rdfs:label": {
        "@value": "ELTS_Par_39_1 (redaktsioon 129062018071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062018071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062018071",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 39_1",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_4_v264412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsus võib kindla tähtaja jooksul rakendada kõigi turuosaliste suhtes varustuskindluse tagamise abinõusid, kui ilmneb: varustuskindlust ohustav tegur; primaarenergiaallikate vähesus; oht inimeste elule või tervisele või võrgu või muu elektripaigaldise säilimisele. (2) Käesoleva paragrahvi lõikes 1 nimetatud abinõusid võib rakendada käesoleva seaduse 3.–7. peatüki sätteid järgimata, kui see on varustuskindluse tagamiseks hädavajalik. (3) Käesoleva paragrahvi lõikes 1 nimetatud juhul kehtestab Vabariigi Valitsus abinõude rakendamisest tingitud kulutuste arvutamise alused, kulutusi hüvitama kohustatud isikute ja hüvitist saama õigustatud isikute nimekirjad ning kulutuste hüvitamise ulatuse ja korra. (4) Käesoleva paragrahvi lõikes 1 nimetatud juhul võib rakendada muu hulgas järgmisi abinõusid: piirata käesolevas seaduses sätestatud vabatarbija õigusi; kohustada soetama ja hoidma tootmiseks vajalike primaarenergiaallikate varusid; peatada tootjale või muule turuosalisele käesoleva seadusega antud õigused või piirata neid; piirata teatavate turuosaliste elektrivarustust või katkestada see; piirata või muuta võrguteenuste osutamise kohustust. (5) Vabariigi Valitsus teeb käesoleva paragrahvi alusel rakendatud abinõud viivitamata teatavaks Euroopa Komisjonile.",
      "rdfs:label": {
        "@value": "ELTS_Par_4 (redaktsioon 264412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264412",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_4_v12805105"
      },
      "estleg:versionValidTo": {
        "@value": "2007-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/264412",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_4_v12805105",
      "@type": [
        "owl:NamedIndividual",
