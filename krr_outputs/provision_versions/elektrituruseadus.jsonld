      "estleg:provisionRef": "ELTS § 110",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_110_v129062018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
