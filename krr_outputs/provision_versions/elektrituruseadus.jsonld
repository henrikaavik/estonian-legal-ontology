      "estleg:provisionRef": "ELTS § 58",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_58_v12894671",
      "@type": [
