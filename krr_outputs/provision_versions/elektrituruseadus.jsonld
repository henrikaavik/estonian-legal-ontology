    {
      "@id": "estleg:ELTS_Par_81_3_v129062018071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_81_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ELTS_Par_81_3 (redaktsioon 129062018071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062018071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062018071",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 81_3",
      "estleg:partOfAct": {
