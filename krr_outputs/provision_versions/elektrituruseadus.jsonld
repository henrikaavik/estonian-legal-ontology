      "estleg:provisionRef": "ELTS § 94",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_94_v128062012025",
      "@type": [
        "owl:NamedIndividual",
