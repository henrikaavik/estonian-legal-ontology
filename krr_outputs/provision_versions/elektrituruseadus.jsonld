    {
      "@id": "estleg:ELTS_Par_119_v264412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2003. aasta 1. juulil. (2) Käesoleva seaduse §-d 15, 16 ja 18 jõustuvad 2005. aasta 1. jaanuaril. (3) Käesoleva seaduse § 4 lõige 5, § 29 lõige 6, § 70 lõige 5 ning § 74 lõiked 4 ja 5 jõustuvad eraldi seadusega Eesti ühinemisel Euroopa Liiduga.",
      "rdfs:label": {
        "@value": "ELTS_Par_119 (redaktsioon 264412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264412",
      "estleg:supersededByVersion": {
