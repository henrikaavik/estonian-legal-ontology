      }
    },
    {
      "@id": "estleg:ELTS_Par_59_2_v128062012023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_59_2"
