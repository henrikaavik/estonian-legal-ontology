      "estleg:provisionRef": "ELTS § 87_1",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_87_1_v104022026002",
      "@type": [
        "owl:NamedIndividual",
