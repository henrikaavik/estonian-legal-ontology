      }
    },
    {
      "@id": "estleg:ELTS_Par_83_v115032022009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva peatüki sätteid kohaldatakse võrguettevõtjaga võrguga ühendamiseks ja tarbimis- või tootmistingimuste muutmiseks sõlmitavale lepingule (edaspidi liitumisleping) ja muude võrguteenuste osutamiseks sõlmitavale lepingule (edaspidi võrguleping), elektrilepingule ning agregeerimiseks sõlmitavale lepingule (edaspidi agregeerimisleping). (2) Käesoleva peatüki sätetest võib poolte kokkuleppel kõrvale kalduda. Füüsilisest isikust tarbija kahjuks kõrvalekalduvad kokkulepped on tühised. (3) Liitumislepingule, võrgulepingule, elektrilepingule ja agregeerimislepingule kohaldatakse käesolevas seaduses reguleerimata osas võlaõigusseadust.",
      "rdfs:label": {
        "@value": "ELTS_Par_83 (redaktsioon 115032022009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032022009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032022009",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 83",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
    {
      "@id": "estleg:ELTS_Par_84_v264412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTS_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrilepingu võib sõlmida suuliselt. Kui seda nõuab üks lepingupool, sõlmitakse leping kirjalikus või kirjalikku taasesitamist võimaldavas või elektroonilises vormis. (2) Liitumisleping ja võrguleping sõlmitakse kirjalikus või kirjalikku taasesitamist võimaldavas või elektroonilises vormis. (3) Võrguettevõtja võib erinevate võrguteenuste osutamiseks sõlmida tarbijaga eraldi võrgulepingud. (4) Füüsilisest isikust tarbijal, kes käesoleva seaduse § 76 lõikes 1 nimetatud müügikohustust kasutades ostab elektrienergiat võrguettevõtja nimetatud müüjalt, on õigus nõuda müüjalt, et elektrileping sisaldaks ka võrgulepingu sätteid, mis käsitlevad müüdava elektrienergia edastamiseks vajalike võrguteenuste osutamist. Sellisel juhul sõlmitakse leping käesoleva paragrahvi lõikes 2 nimetatud vormis.",
      "rdfs:label": {
        "@value": "ELTS_Par_84 (redaktsioon 264412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264412",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTS_Par_84_v128062012024"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/264412",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 84",
      "estleg:partOfAct": {
        "@id": "estleg:ELTS_Map_2026"
      }
    },
