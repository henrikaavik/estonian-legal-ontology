        "@type": "xsd:date"
      },
      "estleg:versionText": "Elektriettevõtja esitab Statistikaametile andmed elektrienergia või võrguteenuse hinna kujunemise kohta riikliku statistika seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "ELTS_Par_81_1 (redaktsioon 13338041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13338041",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13338041",
      "estleg:sourceAct": "Elektrituruseadus",
      "estleg:provisionRef": "ELTS § 81_1",
