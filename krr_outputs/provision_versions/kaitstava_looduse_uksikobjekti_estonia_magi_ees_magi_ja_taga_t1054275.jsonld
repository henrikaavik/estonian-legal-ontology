      "estleg:sourceAct": "Kaitstava looduse üksikobjekti Estonia mägi (Ees-mägi ja Tagamägi) kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1054275 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054275_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054275_Par_5_v1054275",
      "@type": [
        "owl:NamedIndividual",
