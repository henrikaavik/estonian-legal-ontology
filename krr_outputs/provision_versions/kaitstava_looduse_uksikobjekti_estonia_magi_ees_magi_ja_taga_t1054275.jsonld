      "dc:source": "Kaitstava looduse üksikobjekti Estonia mägi (Ees-mägi ja Tagamägi) kaitse alt väljaarvamine"
    },
    {
      "@id": "estleg:Reg_1054275_Par_1_v1054275",
      "@type": [
