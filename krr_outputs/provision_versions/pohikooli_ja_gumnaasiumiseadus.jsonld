      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POHIKO_Par_6_v214557",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
