      },
      "estleg:versionText": "Kuni riiklike õppekavade kehtestamiseni kehtivad senised õppekavad ning nende kinnitamise kord.",
      "rdfs:label": {
        "@value": "POHIKO_Par_53 (redaktsioon 22261)",
        "@language": "et"
      },
