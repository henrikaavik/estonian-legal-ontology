      }
    },
    {
      "@id": "estleg:POHIKO_Par_53_v13332410",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Koduõpe on õppe korraldamine õpilase kodus või muus õpilasega või piiratud teovõimega õpilase vanemaga kokkulepitud kohas väljaspool kooli ruume. Haridusliku erivajadusega õpilasele rakendatakse koduõpet tulenevalt tema terviseseisundist. (2) Haiglaõppena käsitatakse haiglas ravil viibiva põhi- või üldkeskharidust omandava õpilase õpetamist. (3) Koduõppe ja haiglaõppe tingimused ja korra",
      "rdfs:label": {
        "@value": "POHIKO_Par_53 (redaktsioon 13332410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13332410",
