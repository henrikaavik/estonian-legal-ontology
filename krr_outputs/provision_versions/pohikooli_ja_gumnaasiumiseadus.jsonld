      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "POHIKO_Par_10 (redaktsioon 109012025024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109012025024"
    },
    {
      "@id": "estleg:POHIKO_Par_100_v13332410",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_100"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2010. aasta 1. septembrit koolitervishoiuteenust osutavatel arstidel on õigus jätkata koolitervishoiuteenuse osutamist, mille hulka kuuluvad alates 2010. aasta 1. septembrist ainult õe tegevused, kuni 2014. aasta 31. augustini.",
      "rdfs:label": {
        "@value": "POHIKO_Par_100 (redaktsioon 13332410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13332410"
    },
    {
      "@id": "estleg:POHIKO_Par_100_1_v111072013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_100_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2013. aasta 1. septembri seisuga tegutsevad põhikool ja gümnaasium, mis tegutsevad ühe asutusena, või üldhariduskool ja huvikool, mis tegutsevad ühe asutusena, võivad jätkata tegevust ühe asutusena.",
      "rdfs:label": {
        "@value": "POHIKO_Par_100_1 (redaktsioon 111072013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111072013002",
      "estleg:supersededByVersion": {
        "@id": "estleg:POHIKO_Par_100_1_v111032015016"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POHIKO_Par_100_1_v111032015016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_100_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2013. aasta 1. septembri seisuga ühe asutusena tegutsevad üldhariduskool ja huvikool võivad jätkata tegevust ühe asutusena.",
      "rdfs:label": {
        "@value": "POHIKO_Par_100_1 (redaktsioon 111032015016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032015016"
    },
    {
      "@id": "estleg:POHIKO_Par_100_10_v122012018003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_100_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 82 lõike 3 alusel eraldatakse riigieelarvest toetust 2018. aastal tõhustatud toe ja eritoe kulude katmiseks alates 2018. aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "POHIKO_Par_100_10 (redaktsioon 122012018003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122012018003"
    },
