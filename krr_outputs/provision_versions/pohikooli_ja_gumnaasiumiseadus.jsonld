    {
      "@id": "estleg:POHIKO_Par_39_v214557",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_39"
      },
      "estleg:versionValidFrom": {
