        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhikool ja gümnaasium on munitsipaalkoolid. Vabariigi Valitsuse otsusel võivad põhikool ja gümnaasium olla ka Haridusministeeriumi hallatavad või maavalitsuse haldamisele kuuluvad riigikoolid.",
      "rdfs:label": {
        "@value": "POHIKO_Par_5 (redaktsioon 22261)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22261",
      "estleg:supersededByVersion": {
        "@id": "estleg:POHIKO_Par_5_v214557"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POHIKO_Par_5_v214557",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhikool ja gümnaasium on munitsipaalkoolid. Vabariigi Valitsuse otsusel võivad põhikool ja gümnaasium olla ka Haridusministeeriumi hallatavad või maavalitsuse haldamisele kuuluvad riigikoolid. [Paragrahvi 5 sõnastus alates 1. 01. 2003]",
      "rdfs:label": {
        "@value": "POHIKO_Par_5 (redaktsioon 214557)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "214557",
      "estleg:supersededByVersion": {
        "@id": "estleg:POHIKO_Par_5_v263199"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-12",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POHIKO_Par_5_v263199",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhikool ja gümnaasium on munitsipaalkoolid. Vabariigi Valitsuse otsusel võivad põhikool ja gümnaasium olla ka Haridus- ja Teadusministeeriumi hallatavad või maavalitsuse haldamisele kuuluvad riigikoolid.",
      "rdfs:label": {
        "@value": "POHIKO_Par_5 (redaktsioon 263199)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "263199",
      "estleg:supersededByVersion": {
        "@id": "estleg:POHIKO_Par_5_v13332410"
      },
      "estleg:versionValidTo": {
        "@value": "2010-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POHIKO_Par_5_v13332410",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gümnaasiumil on nii hariv kui ka kasvatav ülesanne. Gümnaasiumi ülesanne on noore ettevalmistamine toimima loova, mitmekülgse, sotsiaalselt küpse, usaldusväärse ning oma eesmärke teadvustava ja saavutada oskava isiksusena erinevates eluvaldkondades: partnerina isiklikus elus, kultuuri kandja ja edendajana, tööturul erinevates ametites ja rollides ning ühiskonna ja looduskeskkonna jätkusuutlikkuse eest vastutava kodanikuna. (2) Gümnaasiumis on õpetuse ja kasvatuse põhitaotlus, et õpilased leiaksid endale huvi- ja võimetekohase tegevusvaldkonna, millega siduda oma edasine haridustee. Gümnaasiumi ülesanne on luua tingimused, et õpilased omandaksid teadmised, oskused ja väärtushoiakud, mis võimaldavad jätkata tõrgeteta õpiteed kõrgkoolis või gümnaasiumijärgses kutseõppes.",
      "rdfs:label": {
        "@value": "POHIKO_Par_5 (redaktsioon 13332410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13332410",
      "estleg:supersededByVersion": {
        "@id": "estleg:POHIKO_Par_5_v111072013002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:POHIKO_Par_5_v111072013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gümnaasiumil on nii hariv kui ka kasvatav ülesanne. Gümnaasiumi ülesanne on noore ettevalmistamine toimima loova, mitmekülgse, sotsiaalselt küpse, usaldusväärse ning oma eesmärke teadvustava ja saavutada oskava isiksusena erinevates eluvaldkondades: partnerina isiklikus elus, kultuuri kandja ja edendajana, tööturul erinevates ametites ja rollides ning ühiskonna ja looduskeskkonna jätkusuutlikkuse eest vastutava kodanikuna. (2) Gümnaasiumis on õpetuse ja kasvatuse põhitaotlus, et õpilased leiaksid endale huvi- ja võimetekohase tegevusvaldkonna, millega siduda oma edasine haridustee. Gümnaasiumi ülesanne on luua tingimused, et õpilased omandaksid teadmised, oskused ja väärtushoiakud, mis võimaldavad jätkata tõrgeteta õpiteed kõrgkoolis või kutseõppeasutuses.",
      "rdfs:label": {
        "@value": "POHIKO_Par_5 (redaktsioon 111072013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111072013002"
    },
    {
      "@id": "estleg:POHIKO_Par_50_v22261",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POHIKO_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[kehtetu]",
      "rdfs:label": {
        "@value": "POHIKO_Par_50 (redaktsioon 22261)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22261",
      "estleg:supersededByVersion": {
