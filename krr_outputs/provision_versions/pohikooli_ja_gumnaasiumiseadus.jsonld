        "@type": "xsd:date"
      },
      "estleg:versionText": "[kehtetu]",
      "rdfs:label": {
        "@value": "POHIKO_Par_10 (redaktsioon 22261)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22261",
