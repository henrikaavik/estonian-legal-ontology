      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kool registreeritakse valla- või linnavalitsuse juures õigusaktides kehtestatud korras. [Paragrahvi 15 sõnastus kuni 31. 12. 2002]",
      "rdfs:label": {
        "@value": "POHIKO_Par_14 (redaktsioon 214557)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "214557",
