  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_teatud_liiki_ja_teatud_koguses_tavajaatmete_mille_vastava_ka_t157527_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Teatud liiki ja teatud koguses tavajäätmete, mille vastava käitlemise korral pole jäätmeloa omamine kohustuslik, taaskasutamise või tekkekohas kõrvaldamise nõuded (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teatud liiki ja teatud koguses tavajäätmete, mille vastava käitlemise korral pole jäätmeloa omamine kohustuslik, taaskasutamise või tekkekohas kõrvaldamise nõuded"
    },
    {
      "@id": "estleg:Reg_157527_Par_1_v157527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157527_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus sätestab tavajäätmete liigid, kogused ja nende taaskasutamise või tekkekohas kõrvaldamise tingimused, millele vastava käitlemise korral ei ole jäätmeloa omamine kohustuslik. Määrus sätestab tavajäätmete liigid, kogused ja nende taaskasutamise või tekkekohas kõrvaldamise tingimused, millele vastava käitlemise korral ei ole jäätmeloa omamine kohustuslik. 2 (2) Jäätmete tekkekoht selle määruse mõistes on jäätmevaldaja valduses olev ehitis või territoorium, kus jäätmed vahetult tekivad. Jäätmete tekkekoht selle määruse mõistes on jäätmevaldaja valduses olev ehitis või territoorium, kus jäätmed vahetult tekivad.",
      "rdfs:label": {
        "@value": "Reg_157527_Par_1 (redaktsioon 157527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157527",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157527",
      "estleg:sourceAct": "Teatud liiki ja teatud koguses tavajäätmete, mille vastava käitlemise korral pole jäätmeloa omamine kohustuslik, taaskasutamise või tekkekohas kõrvaldamise nõuded",
      "estleg:provisionRef": "Reg_157527 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157527_Map"
      }
    },
    {
      "@id": "estleg:Reg_157527_Par_2_v157527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157527_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmeloa omamine pole kohustuslik tavajäätmete taaskasutamise või tekkekohas kõrvaldamise korral, kui: 1 1) jäätmeid taaskasutatakse kuni 5 tonni aastas; 2 2) jäätmed kõrvaldatakse nende tekkekohas kuni 1 tonn aastas. Jäätmeloa omamine pole kohustuslik tavajäätmete taaskasutamise või tekkekohas kõrvaldamise korral, kui: jäätmeid taaskasutatakse kuni 5 tonni aastas; jäätmed kõrvaldatakse nende tekkekohas kuni 1 tonn aastas.",
      "rdfs:label": {
        "@value": "Reg_157527_Par_2 (redaktsioon 157527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157527",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157527",
      "estleg:sourceAct": "Teatud liiki ja teatud koguses tavajäätmete, mille vastava käitlemise korral pole jäätmeloa omamine kohustuslik, taaskasutamise või tekkekohas kõrvaldamise nõuded",
      "estleg:provisionRef": "Reg_157527 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157527_Map"
      }
    },
    {
      "@id": "estleg:Reg_157527_Par_2_2_v157527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157527_Par_2_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jäätmeloa omamine pole kohustuslik tavajäätmete teadusuuringutes, arendustegevuses või uute toodete ja protsesside katsetamisel taaskasutamise korral, olenemata nende liigist või kogusest. Jäätmeloa omamine pole kohustuslik tavajäätmete teadusuuringutes, arendustegevuses või uute toodete ja protsesside katsetamisel taaskasutamise korral, olenemata nende liigist või kogusest. 2 (2) Lõikes 1 sätestatut rakendatakse tingimusel, et katsetusi teeb teadus- ja arendusasutus või keskkonnakaitseluba omav isik ning nende tegevuste ulatus on nii väike, et ei mõjuta keskkonda oluliselt. RT I 2022-09-14 5 114092022005 2022-09-17 Lõikes 1 sätestatut rakendatakse tingimusel, et katsetusi teeb teadus- ja arendusasutus või keskkonnakaitseluba omav isik ning nende tegevuste ulatus on nii väike, et ei mõjuta keskkonda oluliselt.",
      "rdfs:label": {
        "@value": "Reg_157527_Par_2_2 (redaktsioon 157527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157527",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157527",
      "estleg:sourceAct": "Teatud liiki ja teatud koguses tavajäätmete, mille vastava käitlemise korral pole jäätmeloa omamine kohustuslik, taaskasutamise või tekkekohas kõrvaldamise nõuded",
      "estleg:provisionRef": "Reg_157527 § 2_2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157527_Map"
      }
    },
    {
      "@id": "estleg:Reg_157527_Par_3_v157527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157527_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jäätmeloa omamine pole kohustuslik, kui tootmisprotsessis vaheproduktina tekkinud tavajäätmete, olenemata nende liigist või kogusest, taaskasutamine on osa tootmistehnoloogiast. Jäätmeloa omamine pole kohustuslik, kui tootmisprotsessis vaheproduktina tekkinud tavajäätmete, olenemata nende liigist või kogusest, taaskasutamine on osa tootmistehnoloogiast. 2 (2) Lõikes 1 sätestatut rakendatakse tingimusel, et lõikes 1 nimetatud jäätmed suunatakse tagasi samasse tootmisprotsessi ja neid ei ladustata koguses, mis ületab nende jäätmete 5 tööpäeva jooksul tekkiva koguse. RT I 2020-07-29 1 129072020001 2020-08-01 Lõikes 1 sätestatut rakendatakse tingimusel, et lõikes 1 nimetatud jäätmed suunatakse tagasi samasse tootmisprotsessi ja neid ei ladustata koguses, mis ületab nende jäätmete 5 tööpäeva jooksul tekkiva koguse. 3 (3) Lõikes 2 sätestatud ladustatavate jäätmete koguse piirangut ei rakendata „Ehitusseadustiku” kohaselt teostataval tee-ehitusel või -remondil. RT I 2020-07-29 1 129072020001 2020-08-01 Lõikes 2 sätestatud ladustatavate jäätmete koguse piirangut ei rakendata „Ehitusseadustiku” kohaselt teostataval tee-ehitusel või -remondil.",
      "rdfs:label": {
        "@value": "Reg_157527_Par_3 (redaktsioon 157527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157527",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157527",
      "estleg:sourceAct": "Teatud liiki ja teatud koguses tavajäätmete, mille vastava käitlemise korral pole jäätmeloa omamine kohustuslik, taaskasutamise või tekkekohas kõrvaldamise nõuded",
      "estleg:provisionRef": "Reg_157527 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157527_Map"
      }
    },
    {
      "@id": "estleg:Reg_157527_Par_4_v157527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157527_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tavajäätmete liigid ja nende taaskasutamise või tekkekohas kõrvaldamise nõuded, mille korral, olenemata kogusest jäätmeloa omamine pole kohustuslik, on sätestatud määruse lisas 1. RT I 2010 46 273 13338680 2010-07-17 Tavajäätmete liigid ja nende taaskasutamise või tekkekohas kõrvaldamise nõuded, mille korral, olenemata kogusest jäätmeloa omamine pole kohustuslik, on sätestatud määruse lisas 1. 2 (2) Lisas 1 nimetatud taaskasutamistoimingutega võib kaasneda jäätmete ladustamine (taaskasutamistoiming R13 vastavalt Vabariigi Valitsuse 8. detsembri 2011. a määrusele nr 148 «Jäätmete taaskasutamis- ja kõrvaldamistoimingute nimistud») kui Keskkonnaamet ei nõua selleks toiminguks jäätmeloa taotlemist käesoleva määruse § 5 alusel. RT I 2020-07-29 1 129072020001 2020-08-01 Lisas 1 nimetatud taaskasutamistoimingutega võib kaasneda jäätmete ladustamine (taaskasutamistoiming R13 vastavalt Vabariigi Valitsuse 8. detsembri 2011. a määrusele nr 148 «Jäätmete taaskasutamis- ja kõrvaldamistoimingute nimistud») kui Keskkonnaamet ei nõua selleks toiminguks jäätmeloa taotlemist käesoleva määruse § 5 alusel.",
      "rdfs:label": {
        "@value": "Reg_157527_Par_4 (redaktsioon 157527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157527",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157527",
      "estleg:sourceAct": "Teatud liiki ja teatud koguses tavajäätmete, mille vastava käitlemise korral pole jäätmeloa omamine kohustuslik, taaskasutamise või tekkekohas kõrvaldamise nõuded",
      "estleg:provisionRef": "Reg_157527 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157527_Map"
      }
    },
    {
      "@id": "estleg:Reg_157527_Par_4_5_v157527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157527_Par_4_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse lisas 1 nimetatud ja jäätmekoodidega 01 01 01, 01 01 02, 01 04 08, 01 04 09, 01 04 13, 10 01 01, 10 01 02, 10 01 03, 10 12 08, 10 13 14, 17 01 01, 17 01 02, 17 01 03, 17 01 07, 17 03 02, 17 05 04, 17 05 06, 17 05 08, 17 08 02, 19 12 09 ning 20 02 02 tähistatud jäätmete taaskasutamisel teedeehitusel, maa-alade planeerimisel, täitmisel, taastamisel ja korrastamisel tuleb arvestada järgmisi nõudeid: 1 1) ohtlike ainete sisaldus jäätmetes ei tohi ületada veeseaduse § 83 alusel pinnase kohta kehtestatud piirväärtust elumaal või tööstusmaal sõltuvalt territooriumi, kus jäätmeid taaskasutatakse, maakasutuse sihtotstarbest; RT I 2020-02-18 1 118022020001 2020-02-21 2 2) tuhkades määratava orgaanilise süsiniku koguhulk (TOC) ei tohi ületada 30 g/kg; RT I 2017-07-11 11 111072017011 2017-07-14 3 3) jäätmetes sisalduvate saasteainete leostuvuse piirväärused ei tohi ületada lisas 2 sätestatut; 4 4) jäätmete leostuvus arvutatakse vedeliku ja tahke aine suhte (L/S) 10 l/kg juures mõõdetava aine leostuva osa koguhulga ja aine massi suhtena; RT I 2017-07-11 11 111072017011 2017-07-14 5 5) jäätmematerjalidest proovide võtmisel ja analüüsimisel on soovitav järgida asjakohaseid standardeid või nende puudumise korral muid usaldusväärseid analüüsimeetodeid; RT I 2017-07-11 11 111072017011 2017-07-14 6 6) proovi võtmise ja analüüsi teostamise sagedus peab olema piisav, et tagada jäätmete omaduste vastavus käesoleva määruse nõuetele; 7 7) jäätmete omaduste parandamiseks nende segamine omavahel või muude materjalidega, nagu näiteks tsemendi või lubjaga, ei tohi suurendada saadud segu saasteainete sisaldust või nende leostuvust üle punktides 1 ja 2 sätestatu; 8 8) jäätmed ei tohi nende taaskasutamisel ulatuda põhjaveekihini või kokku puutuda põhjaveega veeseaduse §-de 7 ja 15 mõistes; RT I 2020-02-18 1 118022020001 2020-02-21 9 9) kehtetu - RT I 2017-07-11 11 111072017011 2017-07-14 10 10) jäätmete ajutine ladustamine või hoidmine taaskasutuskohas enne taaskasutamise alustamist või taaskasutamise kestel ei tohi põhjustada jäätmete või neist lähtuvate saasteainete sattumist keskkonda; 11 11) kui ajavahemik jäätmete, v.a asfaltbetooni jäätmete tekke ja taaskasutamise vahel on pikem kui 9 kuud, peab jäätmete ladustamine toimuma selleks kohandatud laoplatsil; 12 12) ehitus- ja lammutusjäätmete ning maa-aladelt eemaldatud pinnase käitlemisel tuleb järgida lisaks käesoleva määruse nõuetele «Jäätmeseaduse» § 71 lõike 1 alusel kehtestatud kohaliku omavalitsuse jäätmehoolduseeskirja nõudeid. RT I 2010 46 273 13338680 2010-07-17 Käesoleva määruse lisas 1 nimetatud ja jäätmekoodidega 01 01 01, 01 01 02, 01 04 08, 01 04 09, 01 04 13, 10 01 01, 10 01 02, 10 01 03, 10 12 08, 10 13 14, 17 01 01, 17 01 02, 17 01 03, 17 01 07, 17 03 02, 17 05 04, 17 05 06, 17 05 08, 17 08 02, 19 12 09 ning 20 02 02 tähistatud jäätmete taaskasutamisel teedeehitusel, maa-alade planeerimisel, täitmisel, taastamisel ja korrastamisel tuleb arvestada järgmisi nõudeid: ohtlike ainete sisaldus jäätmetes ei tohi ületada veeseaduse § 83 alusel pinnase kohta kehtestatud piirväärtust elumaal või tööstusmaal sõltuvalt territooriumi, kus jäätmeid taaskasutatakse, maakasutuse sihtotstarbest; tuhkades määratava orgaanilise süsiniku koguhulk (TOC) ei tohi ületada 30 g/kg; jäätmetes sisalduvate saasteainete leostuvuse piirväärused ei tohi ületada lisas 2 sätestatut; jäätmete leostuvus arvutatakse vedeliku ja tahke aine suhte (L/S) 10 l/kg juures mõõdetava aine leostuva osa koguhulga ja aine massi suhtena; jäätmematerjalidest proovide võtmisel ja analüüsimisel on soovitav järgida asjakohaseid standardeid või nende puudumise korral muid usaldusväärseid analüüsimeetodeid; proovi võtmise ja analüüsi teostamise sagedus peab olema piisav, et tagada jäätmete omaduste vastavus käesoleva määruse nõuetele; jäätmete omaduste parandamiseks nende segamine omavahel või muude materjalidega, nagu näiteks tsemendi või lubjaga, ei tohi suurendada saadud segu saasteainete sisaldust või nende leostuvust üle punktides 1 ja 2 sätestatu; jäätmed ei tohi nende taaskasutamisel ulatuda põhjaveekihini või kokku puutuda põhjaveega veeseaduse §-de 7 ja 15 mõistes; kehtetu - jäätmete ajutine ladustamine või hoidmine taaskasutuskohas enne taaskasutamise alustamist või taaskasutamise kestel ei tohi põhjustada jäätmete või neist lähtuvate saasteainete sattumist keskkonda; kui ajavahemik jäätmete, v.a asfaltbetooni jäätmete tekke ja taaskasutamise vahel on pikem kui 9 kuud, peab jäätmete ladustamine toimuma selleks kohandatud laoplatsil; ehitus- ja lammutusjäätmete ning maa-aladelt eemaldatud pinnase käitlemisel tuleb järgida lisaks käesoleva määruse nõuetele «Jäätmeseaduse» § 71 lõike 1 alusel kehtestatud kohaliku omavalitsuse jäätmehoolduseeskirja nõudeid.",
      "rdfs:label": {
        "@value": "Reg_157527_Par_4_5 (redaktsioon 157527)",
        "@language": "et"
      },
