      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008270_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ajateenija ja reservväelase (edaspidi koos kaitseväelane) toitlustuse arvestuslikuks suuruseks on 8,36 eurot ööpäevas. RT I 2022-12-09 6 109122022006 2024-01-01 Ajateenija ja reservväelase (edaspidi koos kaitseväelane) toitlustuse arvestuslikuks suuruseks on 8,36 eurot ööpäevas. 2 (2) Kaitseväelase toitlustus sõjaväelise väljaõppe toimumise ajal ja kohas on tasuta. Kaitseväelase toitlustus sõjaväelise väljaõppe toimumise ajal ja kohas on tasuta. 3 (3) Kaitseväelasele tagatakse kuni kolm liitrit joogivett ööpäevas koos tasuta toitlustusega väljaspool ööpäevase toitlustuse arvestuslikku suurust. Joogivesi peab vastama joogiveele kehtestatud nõuetele. Kaitseväelasele tagatakse kuni kolm liitrit joogivett ööpäevas koos tasuta toitlustusega väljaspool ööpäevase toitlustuse arvestuslikku suurust. Joogivesi peab vastama joogiveele kehtestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1008270_Par_1 (redaktsioon 1008270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008270",
      "estleg:sourceAct": "Ajateenijale ja reservväelasele tagatava toitlustuse ulatus ja kord",
      "estleg:provisionRef": "Reg_1008270 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008270_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1008270_Par_2_v1008270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008270_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lähtuvalt väljaspool väeosa paiknemise kohta läbiviidava sõjaväelise väljaõppe iseloomust ja toitlustamise korraldusest võib Kaitseväe juhataja või tema volitusel väeosa ülem suurendada kaitseväelase toitlustuse arvestuslikku suurust ööpäevas toitlustamisel väliköögist või toitlustusteenuse sisse ostmise korral kuni 100 protsenti ning toitlustamisel kuivtoidupakkidega kuni 200 protsenti. RT I 2022-12-09 6 109122022006 2023-01-01 Lähtuvalt väljaspool väeosa paiknemise kohta läbiviidava sõjaväelise väljaõppe iseloomust ja toitlustamise korraldusest võib Kaitseväe juhataja või tema volitusel väeosa ülem suurendada kaitseväelase toitlustuse arvestuslikku suurust ööpäevas toitlustamisel väliköögist või toitlustusteenuse sisse ostmise korral kuni 100 protsenti ning toitlustamisel kuivtoidupakkidega kuni 200 protsenti.",
      "rdfs:label": {
        "@value": "Reg_1008270_Par_2 (redaktsioon 1008270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008270",
      "estleg:sourceAct": "Ajateenijale ja reservväelasele tagatava toitlustuse ulatus ja kord",
      "estleg:provisionRef": "Reg_1008270 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008270_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1008270_Par_3_v1008270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008270_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigis sõjaväelisel väljaõppel viibimise ajal võib Kaitseväe juhataja või tema volitatud väeosa ülem suurendada kaitseväelase toitlustuse arvestuslikku suurust kuni 400 protsenti. Välisriigis sõjaväelisel väljaõppel viibimise ajal võib Kaitseväe juhataja või tema volitatud väeosa ülem suurendada kaitseväelase toitlustuse arvestuslikku suurust kuni 400 protsenti.",
      "rdfs:label": {
        "@value": "Reg_1008270_Par_3 (redaktsioon 1008270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008270",
      "estleg:sourceAct": "Ajateenijale ja reservväelasele tagatava toitlustuse ulatus ja kord",
      "estleg:provisionRef": "Reg_1008270 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008270_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1008270_Par_4_v1008270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008270_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljaspool Eesti merepiiri viibimise ajal, kui viibimine ületab 24 tundi, või kui Kaitseväe laev viibib mereväebaasist eemal kauem kui 24 tundi võib Kaitseväe juhataja või tema volitatud ülema nõusolekul laevale toiduainete soetamisel suurendada kaitseväelase ööpäevase toitlustuse arvestuslikku suurust kuni 100 protsenti. Väljaspool Eesti merepiiri viibimise ajal, kui viibimine ületab 24 tundi, või kui Kaitseväe laev viibib mereväebaasist eemal kauem kui 24 tundi võib Kaitseväe juhataja või tema volitatud ülema nõusolekul laevale toiduainete soetamisel suurendada kaitseväelase ööpäevase toitlustuse arvestuslikku suurust kuni 100 protsenti.",
      "rdfs:label": {
        "@value": "Reg_1008270_Par_4 (redaktsioon 1008270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008270",
      "estleg:sourceAct": "Ajateenijale ja reservväelasele tagatava toitlustuse ulatus ja kord",
      "estleg:provisionRef": "Reg_1008270 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008270_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1008270_Par_5_v1008270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008270_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseväelasest õhusõiduki meeskonnaliikmele tagatakse teenistusülesannete täitmisel tasuta toitlustamine õhusõiduki pardal, kui lend kestab kauem kui kolm tundi. Kaitseväelasest õhusõiduki meeskonnaliikmele tagatakse teenistusülesannete täitmisel tasuta toitlustamine õhusõiduki pardal, kui lend kestab kauem kui kolm tundi. 2 (2) Kaitseväe juhataja või tema volitatud väeosa ülem võib käesoleva paragrahvi lõikes 1 sätestatud juhul kaitseväelase ööpäevase toitlustuse arvestuslikust suurust suurendada kuni 70 protsenti. Kaitseväe juhataja või tema volitatud väeosa ülem võib käesoleva paragrahvi lõikes 1 sätestatud juhul kaitseväelase ööpäevase toitlustuse arvestuslikust suurust suurendada kuni 70 protsenti.",
      "rdfs:label": {
        "@value": "Reg_1008270_Par_5 (redaktsioon 1008270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008270",
      "estleg:sourceAct": "Ajateenijale ja reservväelasele tagatava toitlustuse ulatus ja kord",
      "estleg:provisionRef": "Reg_1008270 § 5",
      "estleg:partOfAct": {
