      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ühistatud vara maksumuse määramise seadus (12 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ühistatud vara maksumuse määramise seadus"
    },
    {
      "@id": "estleg:UVMS_Par_1_v22239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab ühistatud vara maksumuse määramise selle kompenseerimiseks vastavalt Eesti Vabariigi omandireformi aluste seaduse (RT 1991, nr. 21, art. 257 ja nr. 45, art. 565; 1992, nr. 19, art. 275 ja nr. 33, art. 420) §-le 14 ja Eesti Vabariigi põllumajandusreformi seaduse (RT 1992, nr. 10, art. 143 ja nr. 36, art. 474) §-le 9.",
      "rdfs:label": {
        "@value": "UVMS_Par_1 (redaktsioon 22239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22239",
      "estleg:supersededByVersion": {
        "@id": "estleg:UVMS_Par_1_v13315835"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22239",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_1_v13315835",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab ühistatud vara maksumuse määramise selle kompenseerimiseks vastavalt Eesti Vabariigi omandireformi aluste seaduse §-le 14 ja Eesti Vabariigi põllumajandusreformi seaduse §-le 9.",
      "rdfs:label": {
        "@value": "UVMS_Par_1 (redaktsioon 13315835)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315835",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13315835",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_2_v22239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühistatud vara maksumuse määramise aluseks on lehma arvestuslik hind, mille kinnitab esmatasandi kohaliku omavalitsuse volikogu ühismajandi põllumajandusreformi komisjoni ettepanekul. Lehma arvestusliku hinna alammäär on 500 Eesti krooni (EEK).",
      "rdfs:label": {
        "@value": "UVMS_Par_2 (redaktsioon 22239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22239",
      "estleg:supersededByVersion": {
        "@id": "estleg:UVMS_Par_2_v13315835"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22239",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_2_v13315835",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühistatud vara maksumuse määramise aluseks on lehma arvestuslik hind, mille kinnitab esmatasandi kohaliku omavalitsuse volikogu ühismajandi põllumajandusreformi komisjoni ettepanekul. Lehma arvestusliku hinna alammäär on 31,96 eurot.",
      "rdfs:label": {
        "@value": "UVMS_Par_2 (redaktsioon 13315835)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315835",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13315835",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_3_v22239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühistatud vara maksumus määratakse lehma arvestusliku hinna ja Vabariigi Valitsuse poolt kehtestatud ühistatud varade hinna ümberarvestuse koefitsientide alusel.",
      "rdfs:label": {
        "@value": "UVMS_Par_3 (redaktsioon 22239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22239",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22239",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_4_v22239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühistatud vara maksumuse määramiseks teeb ühismajandi põllumajandusreformi komisjon kindlaks õigustatud subjektile kuulunud ühistatud vara koosseisu ühistamise akti ja muude tõendite alusel. Kui ühistatud vara koosseisu ei ole võimalik tõendada, loetakse ühistatud vara maksumus võrdseks ühe lehma arvestusliku hinnaga talumaa iga nelja hektari kohta.",
      "rdfs:label": {
        "@value": "UVMS_Par_4 (redaktsioon 22239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22239",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22239",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_5_v22239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "UVMS_Par_5 (redaktsioon 22239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22239",
      "estleg:supersededByVersion": {
        "@id": "estleg:UVMS_Par_5_v13315835"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22239",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_5_v13315835",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "UVMS_Par_5 (redaktsioon 13315835)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315835",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13315835",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_6_v22239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse jõustumise päevaks kohaliku omavalitsuse volikogu poolt kinnitatud lehma arvestuslik hind on kehtiv, kui see ei ole madalam antud ühismajandi lehma keskmisest bilansilisest maksumusest.",
      "rdfs:label": {
        "@value": "UVMS_Par_6 (redaktsioon 22239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22239",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22239",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_7_v22239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühistatud vara kompenseeritakse natuuras põllumajandusreformi õigustatud subjektidele, kes on asunud või asuvad talu pidama, hiljemalt 1993. aasta 15. maiks, kui õigustatud subjekt ja ühismajandi põllumajandusreformi komisjon ei lepi kokku teisiti.",
      "rdfs:label": {
        "@value": "UVMS_Par_7 (redaktsioon 22239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22239",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22239",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_8_v22239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõik käesoleva seaduse ja muude õigusaktidega reguleerimata ühistatud vara maksumuse määramise küsimused otsustab ühismajandi põllumajandusreformi komisjoni ettepanekul esmatasandi kohaliku omavalitsuse volikogu.",
      "rdfs:label": {
        "@value": "UVMS_Par_8 (redaktsioon 22239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22239",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22239",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    },
    {
      "@id": "estleg:UVMS_Par_9_v22239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UVMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub väljakuulutamise päevast.",
      "rdfs:label": {
        "@value": "UVMS_Par_9 (redaktsioon 22239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22239",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22239",
      "estleg:sourceAct": "Ühistatud vara maksumuse määramise seadus",
      "estleg:provisionRef": "UVMS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:UVMS_Map_2026"
      }
    }
  ]
}
