    {
      "@id": "estleg:Reg_155211_Par_4_v155211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155211_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ravimiamet avaldab Euroopa farmakopöa kehtivate monograafiate loetelu ja vajadusel teavet muutuste ja muu asjassepuutuva kohta Ravimiameti Interneti koduleheküljel. Ravimiamet avaldab Euroopa farmakopöa kehtivate monograafiate loetelu ja vajadusel teavet muutuste ja muu asjassepuutuva kohta Ravimiameti Interneti koduleheküljel. 2 (2) Ravimiamet teeb koostööd ravimite ja ravimiteraapia Euroopa komitee, Euroopa Farmakopöa Komisjoni ja ravimite kvaliteedi ja tervishoiu Euroopa direktoraadiga Euroopa farmakopöa küsimustes. RT I 2012-04-12 3 112042012003 2012-04-15 Ravimiamet teeb koostööd ravimite ja ravimiteraapia Euroopa komitee, Euroopa Farmakopöa Komisjoni ja ravimite kvaliteedi ja tervishoiu Euroopa direktoraadiga Euroopa farmakopöa küsimustes.",
      "rdfs:label": {
        "@value": "Reg_155211_Par_4 (redaktsioon 155211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155211",
