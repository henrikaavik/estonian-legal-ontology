      "dc:source": "Ülalpidamiskohustuste määruse rakendamise määrus"
    },
    {
      "@id": "estleg:Reg_1001082_Par_1_v1001082",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
