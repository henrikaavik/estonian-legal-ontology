      "estleg:provisionRef": "Reg_1047430 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047430_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047430_Par_6_v1047430",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
