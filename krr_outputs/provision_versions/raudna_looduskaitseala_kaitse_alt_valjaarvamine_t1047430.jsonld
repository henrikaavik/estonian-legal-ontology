      "estleg:versionValidFrom": {
        "@value": "2019-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 6. juuni 2018. a käskkirjaga nr 1-2/18/461 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 6. juuni 2018. a käskkirjaga nr 1-2/18/461 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1047430_Par_5 (redaktsioon 1047430)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047430",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047430",
