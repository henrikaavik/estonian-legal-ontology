    {
      "@id": "estleg:Reg_1047430_Par_5_v1047430",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047430_Par_5"
