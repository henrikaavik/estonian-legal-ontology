      "estleg:versionText": "Määrusega kehtestatakse vastutuskindlustuse lepituskomisjoni (edaspidi komisjon) moodustamise alused ja töökord, sealhulgas liikmete nimetamise ja tasustamise kord. Määrusega kehtestatakse vastutuskindlustuse lepituskomisjoni (edaspidi komisjon) moodustamise alused ja töökord, sealhulgas liikmete nimetamise ja tasustamise kord.",
      "rdfs:label": {
        "@value": "Reg_1059736_Par_1 (redaktsioon 1059736)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059736",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1059736",
      "estleg:sourceAct": "Vastutuskindlustuse lepituskomisjon",
      "estleg:provisionRef": "Reg_1059736 § 1",
