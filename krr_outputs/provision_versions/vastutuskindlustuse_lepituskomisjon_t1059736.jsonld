    {
      "@id": "estleg:Reg_1059736_Par_3_v1059736",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059736_Par_3"
