    },
    {
      "@id": "estleg:Reg_1059535_Par_7_v1059535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059535_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlusvooru eelarve kujuneb vastavalt riigieelarvest sihtotstarbeliselt eraldatud vahenditele kalendriaasta kohta ja kinnitatakse Päästeameti peadirektori käskkirjaga. Taotlusvooru eelarve kujuneb vastavalt riigieelarvest sihtotstarbeliselt eraldatud vahenditele kalendriaasta kohta ja kinnitatakse Päästeameti peadirektori käskkirjaga. 2 (2) Toetuse ülemmäär on 6000 eurot eluruumi kohta. Toetuse ülemmäär on 6000 eurot eluruumi kohta.",
      "rdfs:label": {
        "@value": "Reg_1059535_Par_7 (redaktsioon 1059535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059535",
