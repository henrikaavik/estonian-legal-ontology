      "dc:source": "Tee-ehitusmaterjalidele ja -toodetele esitatavad nõuded ja nende nõuetele vastavuse tõendamise kord"
    },
    {
      "@id": "estleg:Reg_1025807_Par_1_v1025807",
      "@type": [
