      },
      "estleg:versionText": "Turujärelevalvet tee-ehitusmaterjalide üle teeb Tarbijakaitse ja Tehnilise Järelevalve Amet. RT I 2019-02-19 1 119022019001 2019-02-22 Turujärelevalvet tee-ehitusmaterjalide üle teeb Tarbijakaitse ja Tehnilise Järelevalve Amet.",
      "rdfs:label": {
