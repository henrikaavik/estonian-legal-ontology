      "estleg:versionValidFrom": {
        "@value": "2026-02-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse avalikult kasutataval teel toimuvatel teehoiutöödel kasutatavate tee-ehitusmaterjalide ja -toodete (edaspidi tee-ehitusmaterjalid) kohustuslikule deklareerimisele kuuluvad põhiomadused vastavalt kasutusalale ja põhiomaduste tõendamise kord. Määrusega kehtestatakse avalikult kasutataval teel toimuvatel teehoiutöödel kasutatavate tee-ehitusmaterjalide ja -toodete (edaspidi tee-ehitusmaterjalid) kohustuslikule deklareerimisele kuuluvad põhiomadused vastavalt kasutusalale ja põhiomaduste tõendamise kord.",
      "rdfs:label": {
        "@value": "Reg_1025807_Par_1 (redaktsioon 1025807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025807",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025807",
      "estleg:sourceAct": "Tee-ehitusmaterjalidele ja -toodetele esitatavad nõuded ja nende nõuetele vastavuse tõendamise kord",
      "estleg:provisionRef": "Reg_1025807 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025807_Map"
      }
    },
    {
