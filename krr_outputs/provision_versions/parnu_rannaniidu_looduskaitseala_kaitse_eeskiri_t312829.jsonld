    {
      "@id": "estleg:Reg_312829_Par_10_v312829",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312829_Par_10"
