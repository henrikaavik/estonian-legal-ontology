    {
      "@id": "estleg:Reg_312829_Par_4_v312829",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312829_Par_4"
