        "@value": "2023-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet asub Tallinnas. Ameti postiaadress on Tatari 51, 10134 Tallinn. Amet asub Tallinnas. Ameti postiaadress on Tatari 51, 10134 Tallinn.",
      "rdfs:label": {
        "@value": "Reg_1016097_Par_4 (redaktsioon 1016097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016097",
