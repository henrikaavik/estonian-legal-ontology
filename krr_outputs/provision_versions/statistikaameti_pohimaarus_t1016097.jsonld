    {
      "@id": "estleg:Reg_1016097_Par_2_v1016097",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1016097_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ameti kulud kaetakse riigieelarvest. Ameti eelarve kinnitab, seda muudab ja selle täitmist kontrollib rahandusminister. Ameti kulud kaetakse riigieelarvest. Ameti eelarve kinnitab, seda muudab ja selle täitmist kontrollib rahandusminister. 2 (2) Ametil on oma nimega dokumendiplangid, mille kasutamise kord määratakse kindlaks ameti asjaajamiskorraga. Ametil on oma nimega dokumendiplangid, mille kasutamise kord määratakse kindlaks ameti asjaajamiskorraga. 3 (3) Ametil on väikese riigivapi kujutisega pitsat. Ametil on väikese riigivapi kujutisega pitsat. 4 (4) Ametil on logo. Logol on sõnaühend „Eesti Statistika”. RT I 2020-11-25 1 125112020001 2020-12-01 Ametil on logo. Logol on sõnaühend „Eesti Statistika”.",
      "rdfs:label": {
        "@value": "Reg_1016097_Par_2 (redaktsioon 1016097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016097",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1016097",
