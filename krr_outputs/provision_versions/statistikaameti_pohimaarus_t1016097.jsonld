    {
      "@id": "estleg:Reg_1016097_Par_3_v1016097",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1016097_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Amet on aruandekohustuslik rahandusministri ees, kes suunab ja koordineerib ameti tegevust ja teostab ameti üle teenistuslikku järelevalvet õigusaktidega sätestatud korras. Amet on aruandekohustuslik rahandusministri ees, kes suunab ja koordineerib ameti tegevust ja teostab ameti üle teenistuslikku järelevalvet õigusaktidega sätestatud korras. 2 (2) Riikliku statistika programmi täitmise aruanne esitatakse vastavalt riikliku statistika seaduse §-le 19. Riikliku statistika programmi täitmise aruanne esitatakse vastavalt riikliku statistika seaduse §-le 19.",
      "rdfs:label": {
        "@value": "Reg_1016097_Par_3 (redaktsioon 1016097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016097",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1016097",
      "estleg:sourceAct": "Statistikaameti põhimäärus",
      "estleg:provisionRef": "Reg_1016097 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1016097_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1016097_Par_4_v1016097",
      "@type": [
