      }
    },
    {
      "@id": "estleg:Reg_1016097_Par_5_v1016097",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1016097_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti tegevusvaldkonnaks on Euroopa Liidu statistikasüsteemis kehtivatele põhimõtetele ja kvaliteedikriteeriumidele vastava riikliku statistika tegemine ja andmehalduse koordineerimine. RT I 2019-07-24 3 124072019003 2019-09-01 Ameti tegevusvaldkonnaks on Euroopa Liidu statistikasüsteemis kehtivatele põhimõtetele ja kvaliteedikriteeriumidele vastava riikliku statistika tegemine ja andmehalduse koordineerimine.",
      "rdfs:label": {
        "@value": "Reg_1016097_Par_5 (redaktsioon 1016097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016097",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1016097",
      "estleg:sourceAct": "Statistikaameti põhimäärus",
      "estleg:provisionRef": "Reg_1016097 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1016097_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1016097_Par_6_v1016097",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1016097_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet täidab riikliku statistika seaduse § 9 lõikes 2 esitatud ülesandeid. Amet täidab riikliku statistika seaduse § 9 lõikes 2 esitatud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_1016097_Par_6 (redaktsioon 1016097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016097",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1016097",
      "estleg:sourceAct": "Statistikaameti põhimäärus",
      "estleg:provisionRef": "Reg_1016097 § 6",
