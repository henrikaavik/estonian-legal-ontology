        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 2013. aasta 1. oktoobril. Määrus jõustub 2013. aasta 1. oktoobril.",
      "rdfs:label": {
        "@value": "Reg_1016097_Par_20 (redaktsioon 1016097)",
        "@language": "et"
      },
