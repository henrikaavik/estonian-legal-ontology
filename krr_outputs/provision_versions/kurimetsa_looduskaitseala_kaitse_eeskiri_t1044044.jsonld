      "estleg:sourceAct": "Kurimetsa looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1044044 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044044_Map"
      }
    },
    {
      "@id": "estleg:Reg_1044044_Par_2_v1044044",
