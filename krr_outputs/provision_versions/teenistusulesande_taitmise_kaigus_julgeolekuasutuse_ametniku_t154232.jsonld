      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistusjuurdluse kokkuvõttes võetakse seisukoht avalduse põhjendatuse või põhjendamatuse kohta ning esitatakse arvestused hüvitamisele kuuluva varalise kahju summa osas. Teenistusjuurdluse kokkuvõte peab olema motiveeritud ning sisaldama viidet vastavale seadusesättele. 2. peatükk HÜVITISE SUURUSE MÄÄRAMINE",
      "rdfs:label": {
