  },
  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_teenistusulesande_taitmise_kaigus_julgeolekuasutuse_ametniku_t154232_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord (16 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord"
    },
    {
      "@id": "estleg:Reg_154232_Par_1_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastavalt «Julgeolekuasutuste seaduse» § 18 lõikele 1 hüvitab teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele (edaspidi kannatanu) tekitatud otsese varalise kahju riik.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_1 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_10_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Varalise kahju hüvitise (edaspidi hüvitis ) suuruse määramisel võetakse aluseks kahjustatud vara harilik väärtus «Asjaõigusseaduse» (RT I 1993, 39, 590; 1999, 44, 509; 2001, 34, 185) § 29 lõike 2 tähenduses.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_10 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_11_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kahjustatud vara esialgset harilikku väärtust hindab kannatanu ise ja märgib selle avaldusse.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_11 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_12_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hüvitise suuruse määramise aluseks olevast kahjust arvatakse maha kõik summad, mis kannatanu on sama kahju hüvitamiseks saanud või on õigustatud saama muudest allikatest.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_12 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_13_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kannatanu pärast hüvitise kättesaamist käesoleva määruse alusel saab ka muudest allikatest hüvitist, mida ei ole arvatud hüvitise suuruse määramise aluseks olevast kahjust maha vastavalt käesoleva määruse §-le 12, peab ta sellest teatama asutuse juhile ühe nädala jooksul hüvitise saamise päevast arvates ning maksma hüvitisest tagasi summa, mis maksti talle välja muudest allikatest.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_13 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_14_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui varaline kahju on väiksem kui Vabariigi Valitsuse poolt kehtestatud kuupalga kolmekordne alammäär, hüvitatakse varaline kahju asutuse juhi käskkirja alusel ühe kuu jooksul, arvates teenistusjuurdluse kokkuvõtte kinnitamisest asutuse juhi poolt.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_14 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_15_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui varaline kahju on suurem kui Vabariigi Valitsuse poolt kehtestatud kuupalga kolmekordne alammäär, taotletakse hüvitamisele kuuluvat summat kuni kuuekümne kuupalga alammäära ulatuses Vabariigi Valitsuse reservist järgmiselt: 1) asutuse juht esitab vastavalt alluvusele Siseministeeriumile või Kaitseministeeriumile kannatanu avalduse ja teenistusjuurdluse kokkuvõtte hiljemalt viie päeva jooksul teenistusjuurdluse kokkuvõtte kinnitamise päevast arvates; 2) Siseministeerium või Kaitseministeerium vaatab avalduse ja teenistusjuurdluse kokkuvõtte läbi ning esitab pärast seda ühe kuu jooksul Rahandusministeeriumi kaudu Vabariigi Valitsusele ettepaneku varalise kahju hüvitamiseks Vabariigi Valitsuse reservist vastavalt Vabariigi Valitsuse 16. novembri 1999. a määrusega nr 346 «Vabariigi Valitsuse reservist raha eraldamise ja selle kasutamise kord» (RT I 1999, 86, 787) kehtestatud korrale.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_15 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_16_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhul kui kannatanu avaldus osutus põhjendamatuks, teatab asutuse juht kannatanule oma otsusest avalduse rahuldamata jätmise kohta, viidates ka vastavale seadusesättele, ning lisab teatele teenistusjuurdluse kokkuvõtte kinnitatud koopia. Peaminister Mart LAAR Siseminister Tarmo LOODUS Riigisekretär Aino LEPIK von WIRÉN",
      "rdfs:label": {
        "@value": "Reg_154232_Par_16 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_2_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Varalise kahju hüvitamise aluseks on avaldus ja teenistusjuurdluse kokkuvõte.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_2 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_3_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Varaline kahju hüvitatakse kannatanu kirjaliku motiveeritud avalduse alusel, milles peab olema: 1) kannatanu ees- ja perekonnanimi, isikukood või selle puudumisel sünniaeg, elu- ja töökoht. Juhul kui kannatanuks on julgeolekuasutuse ametniku perekonnaliige, esitatakse ka andmed tema kuulumise kohta julgeolekuasutuse ametniku perekonda; 2) hävinud, kadunud või rikutud vara nimetus, liik, soetusaasta, soetushind ning selle arvatav harilik väärtus vara hävimise, kaotsimineku või rikkumise päeval. Vara rikkumise korral märgitakse selle jääkväärtus; 3) näidatud põhjuslik seos varalise kahju tekkimise ja julgeolekuasutuse ametniku teenistusülesande täitmise vahel; 4) avalduse esitamise kuupäev ja avalduse esitaja allkiri.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_3 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_4_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avaldusele lisatakse varalise kahju tekitamist ja vara väärtust tõendavad dokumendid. Kui sama kahju on osaliselt või täielikult hüvitatud muudest allikatest, peab kannatanu avaldusele lisama muudest allikatest saadud või saadavat hüvitist tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_4 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_5_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avaldus esitatakse julgeolekuasutusele, mille koosseisu kuulus julgeolekuasutuse ametnik temale või tema perekonnaliikmele varalise kahju tekitamise ajal (edaspidi asutus).",
      "rdfs:label": {
        "@value": "Reg_154232_Par_5 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_6_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui avaldus ei vasta nõuetele või selle juurde pole lisatud nõutavaid dokumente, teatab asutus sellest kannatanule ühe nädala jooksul ning määrab puuduvate andmete või dokumendi esitamise tähtaja. Kui nimetatud puudused ei ole määratud tähtajaks kõrvaldatud, jäetakse avaldus ilma käiguta asutuse juhi motiveeritud otsusel. Asutuse juhi otsusest teavitatakse kannatanut kirjalikult ühe nädala jooksul avalduse käiguta jätmise otsuse tegemise päevast arvates.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_6 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_7_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avalduses märgitud asjaolude kontrollimiseks viiakse läbi teenistusjuurdlus, mille käigus kontrollitakse avalduses nimetatud asjaolusid ning vajaduse korral määratakse ekspertiis kahju suuruse või selle tekke asjaolude väljaselgitamiseks.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_7 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
      "estleg:provisionRef": "Reg_154232 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154232_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154232_Par_8_v154232",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154232_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistusjuurdluse määrab asutuse juht, kes ühtlasi määrab ka juurdlust teostava ametiisiku. Teenistusjuurdlus peab olema läbi viidud ühe kuu jooksul avalduse saamisele järgnevast päevast arvates. Teenistusjuurdluse kokkuvõtte kinnitab asutuse juht.",
      "rdfs:label": {
        "@value": "Reg_154232_Par_8 (redaktsioon 154232)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154232",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154232",
      "estleg:sourceAct": "Teenistusülesande täitmise käigus julgeolekuasutuse ametnikule või tema perekonnaliikmele tekitatud otsese varalise kahju hüvitamise piirmäär ja kord",
