    {
      "@id": "estleg:RavS_Par_65_v129062014059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RavS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
