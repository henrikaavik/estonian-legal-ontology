      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RavS_Par_82_v120062022075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
