    },
    {
      "@id": "estleg:RavS_Par_13_v121062024020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RavS_Par_13"
