      }
    },
    {
      "@id": "estleg:RavS_Par_28_v13336587",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RavS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaks käesoleva seaduse §-des 26 ja 27 nimetatutele on ravimite hulgiostu õigus hoolekandeasutustel, koolidel, kus on loodud põhikooli- ja gümnaasiumiseaduses sätestatud hariduslike erivajadustega õpilaste klassid, riigi- ja teadusasutustel ning kiirabibrigaadi pidajatel, kes on kantud ravimite hulgiostu õigust omavate isikute nimekirja. (2) Hulgiostuõiguse saamiseks peab taotleja esitama sellekohase taotluse Sotsiaalministeeriumile.",
      "rdfs:label": {
        "@value": "RavS_Par_28 (redaktsioon 13336587)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13336587",
      "estleg:supersededByVersion": {
        "@id": "estleg:RavS_Par_28_v129062014059"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
