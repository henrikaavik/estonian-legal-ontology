      },
      "estleg:versionValidTo": {
        "@value": "2015-03-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RavS_Par_102_v110032015023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RavS_Par_102"
      },
