        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RavS_Par_9_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uudne ravim on geeniteraapiaks või somaatilise raku teraapiaks ettenähtud ravim või koetehnoloogiline toode, mis on määratletud Euroopa Parlamendi ja nõukogu määruses (EÜ) nr 1394/2007 uudsete ravimite kohta (ELT L 324, 10.12.2007, lk 121).",
      "rdfs:label": {
        "@value": "RavS_Par_9_1 (redaktsioon 117042013004)",
        "@language": "et"
      },
