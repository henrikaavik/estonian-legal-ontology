    {
      "@id": "estleg:RavS_Par_100_v101072020011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RavS_Par_100"
