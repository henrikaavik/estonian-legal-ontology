    {
      "@id": "estleg:Reg_301688_Par_14_v301688",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301688_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine kaitseala või kaitsealale jääva kinnistu tarbeks. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine kaitseala või kaitsealale jääva kinnistu tarbeks.",
      "rdfs:label": {
        "@value": "Reg_301688_Par_14 (redaktsioon 301688)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301688",
