      "estleg:provisionRef": "Reg_301688 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301688_Map"
      }
    },
    {
      "@id": "estleg:Reg_301688_Par_5_v301688",
      "@type": [
