      }
    },
    {
      "@id": "estleg:Reg_301688_Par_10_v301688",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301688_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) kaitsealuste liikide elutingimuste säilitamiseks ja poollooduslike koosluste ilme ja liigikoosseisu tagamiseks vajalik tegevus; 2 2) tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitseala tarbeks ning olemasolevate ehitiste hooldustööd; 3 3) metsakoosluste kujundamine vastavalt kaitse-eesmärgile, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas; 4 4) olemasolevate maaparandussüsteemide hoiutööd. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: kaitsealuste liikide elutingimuste säilitamiseks ja poollooduslike koosluste ilme ja liigikoosseisu tagamiseks vajalik tegevus; tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitseala tarbeks ning olemasolevate ehitiste hooldustööd; metsakoosluste kujundamine vastavalt kaitse-eesmärgile, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas; olemasolevate maaparandussüsteemide hoiutööd.",
      "rdfs:label": {
        "@value": "Reg_301688_Par_10 (redaktsioon 301688)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301688",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301688",
      "estleg:sourceAct": "Lümandu maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301688 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301688_Map"
      }
    },
