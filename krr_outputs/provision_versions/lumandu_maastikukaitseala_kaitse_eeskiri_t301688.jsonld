    {
      "@id": "estleg:Reg_301688_Par_15_v301688",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301688_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 2 2) puidu kokku- ja väljavedu külmumata pinnasel; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) maavara kaevandamine; 5 5) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 6 6) biotsiidi ja taimekaitsevahendi kasutamine; 7 7) uue maaparandussüsteemi rajamine. Piiranguvööndis on keelatud: uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel; puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; biotsiidi ja taimekaitsevahendi kasutamine; uue maaparandussüsteemi rajamine.",
      "rdfs:label": {
        "@value": "Reg_301688_Par_15 (redaktsioon 301688)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301688",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301688",
      "estleg:sourceAct": "Lümandu maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301688 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301688_Map"
      }
    },
    {
      "@id": "estleg:Reg_301688_Par_2_v301688",
      "@type": [
        "owl:NamedIndividual",
