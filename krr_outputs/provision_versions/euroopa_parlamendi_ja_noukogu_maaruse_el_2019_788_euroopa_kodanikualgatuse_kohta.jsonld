        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Parlamendi ja nõukogu määruse (EL) nr 211/2011 „Kodanikualgatuse kohta” rakendamise seadus tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "EKodAS_Par_5 (redaktsioon 121122019021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122019021"
    },
    {
      "@id": "estleg:EKodAS_Par_6_v121122019021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EKodAS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2020. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "EKodAS_Par_6 (redaktsioon 121122019021)",
        "@language": "et"
