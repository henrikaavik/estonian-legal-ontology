      "estleg:provisionRef": "Reg_1035137 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035137_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035137_Par_10_v1035137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035137_Par_10"
