      "estleg:versionValidFrom": {
        "@value": "2016-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 22. juuni 2015. a käskkirjaga nr 606 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Määruse menetlus viidi läbi keskkonnaministri 22. juuni 2015. a käskkirjaga nr 606 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1035137_Par_10 (redaktsioon 1035137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035137",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035137",
