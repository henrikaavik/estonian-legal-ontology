    {
      "@id": "estleg:Reg_1041152_Par_5_v1041152",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041152_Par_5"
