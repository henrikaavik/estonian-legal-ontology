      "estleg:sourceAct": "Tolliagendi eksami läbiviimise ja tunnistuse väljastamise kord",
      "estleg:provisionRef": "Reg_1039221 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039221_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039221_Par_2_v1039221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039221_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Komisjon vormistab eksami tulemused eksamiprotokollis kümne kalendripäeva jooksul eksami toimumise päevast arvates ja vormistab eksami sooritanule tolliagendi tunnistuse. Komisjon vormistab eksami tulemused eksamiprotokollis kümne kalendripäeva jooksul eksami toimumise päevast arvates ja vormistab eksami sooritanule tolliagendi tunnistuse.",
      "rdfs:label": {
        "@value": "Reg_1039221_Par_2 (redaktsioon 1039221)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039221",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039221",
      "estleg:sourceAct": "Tolliagendi eksami läbiviimise ja tunnistuse väljastamise kord",
      "estleg:provisionRef": "Reg_1039221 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039221_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039221_Par_3_v1039221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039221_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eksamit mittesooritanu võib eksamit korrata kahe kuu möödumisel eksami mittesooritamise päevast arvates. Eksamit mittesooritanu võib eksamit korrata kahe kuu möödumisel eksami mittesooritamise päevast arvates.",
      "rdfs:label": {
        "@value": "Reg_1039221_Par_3 (redaktsioon 1039221)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039221",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039221",
      "estleg:sourceAct": "Tolliagendi eksami läbiviimise ja tunnistuse väljastamise kord",
      "estleg:provisionRef": "Reg_1039221 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039221_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039221_Par_4_v1039221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
