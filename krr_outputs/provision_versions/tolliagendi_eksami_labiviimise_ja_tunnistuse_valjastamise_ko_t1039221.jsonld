      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tolliagendi eksami läbiviimise ja tunnistuse väljastamise kord (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tolliagendi eksami läbiviimise ja tunnistuse väljastamise kord"
    },
    {
      "@id": "estleg:Reg_1039221_Par_1_v1039221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039221_Par_1"
