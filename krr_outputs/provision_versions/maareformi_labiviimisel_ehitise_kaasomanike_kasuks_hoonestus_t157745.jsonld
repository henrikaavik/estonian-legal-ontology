      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157745_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib ehitise alusele ja selle teenindamiseks vajalikule maale (edaspidi ehitise teenindamiseks vajalik maa) hoonestusõiguse seadmist kõigi ehitise kaasomanike kasuks, kui mõni ehitise kaasomanik ei soovi ehitise juurde maareformi käigus maad omandada ja teine kaasomanik taotleb ehitise teenindamiseks vajaliku maa omandamist. RT I 2014-01-09 1 109012014001 2014-01-12 Määrus reguleerib ehitise alusele ja selle teenindamiseks vajalikule maale (edaspidi ehitise teenindamiseks vajalik maa) hoonestusõiguse seadmist kõigi ehitise kaasomanike kasuks, kui mõni ehitise kaasomanik ei soovi ehitise juurde maareformi käigus maad omandada ja teine kaasomanik taotleb ehitise teenindamiseks vajaliku maa omandamist.",
      "rdfs:label": {
        "@value": "Reg_157745_Par_1 (redaktsioon 157745)",
        "@language": "et"
      },
