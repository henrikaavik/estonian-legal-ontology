      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_157745_Par_2 (redaktsioon 157745)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157745",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157745",
      "estleg:sourceAct": "Maareformi läbiviimisel ehitise kaasomanike kasuks hoonestusõiguse seadmise kord",
