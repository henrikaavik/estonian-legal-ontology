    {
      "@id": "estleg:Reg_157745_Par_6_v157745",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157745_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu - RT I 2014-01-09 1 109012014001 2014-01-12 Kehtetu - 2 (2) Maa müügileping peab sisaldama: 1 1) kokkulepet hoonestusõiguse seadmise tagamiseks kinnistusraamatusse eelmärke kandmise kohta; 2 2) ostuhinna järelmaksuga tasumise korral erastaja eesõigust hoonestusõiguse kandmiseks esimesele järjekohale. Eelmärge erastaja eesõiguse kohta kantakse kinnistusraamatusse. Maa müügileping peab sisaldama: kokkulepet hoonestusõiguse seadmise tagamiseks kinnistusraamatusse eelmärke kandmise kohta; ostuhinna järelmaksuga tasumise korral erastaja eesõigust hoonestusõiguse kandmiseks esimesele järjekohale. Eelmärge erastaja eesõiguse kohta kantakse kinnistusraamatusse.",
      "rdfs:label": {
        "@value": "Reg_157745_Par_6 (redaktsioon 157745)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157745",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157745",
      "estleg:sourceAct": "Maareformi läbiviimisel ehitise kaasomanike kasuks hoonestusõiguse seadmise kord",
      "estleg:provisionRef": "Reg_157745 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157745_Map"
      }
    },
    {
      "@id": "estleg:Reg_157745_Par_7_v157745",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157745_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast maa kinnistusraamatusse kandmist peab Maa- ja Ruumiamet või valla- või linnavalitsus, kes tegi maa omandisse andmise otsuse, teavitama ehitise kaasomanikku, kes ei ole avaldanud soovi maad omandada, et tal on õigus nõuda ehitise teenindamiseks vajalikule maale hoonestusõiguse seadmist kõigi ehitise kaasomanike kasuks ühe aasta jooksul maa kinnistusraamatusse kandmisest arvates. Teavitus peab sisaldama ka selgitust asjaõigusseaduse rakendamise seaduse § 15 sisu kohta. RT I 2024-12-29 4 129122024004 2025-01-01 Pärast maa kinnistusraamatusse kandmist peab Maa- ja Ruumiamet või valla- või linnavalitsus, kes tegi maa omandisse andmise otsuse, teavitama ehitise kaasomanikku, kes ei ole avaldanud soovi maad omandada, et tal on õigus nõuda ehitise teenindamiseks vajalikule maale hoonestusõiguse seadmist kõigi ehitise kaasomanike kasuks ühe aasta jooksul maa kinnistusraamatusse kandmisest arvates. Teavitus peab sisaldama ka selgitust asjaõigusseaduse rakendamise seaduse § 15 sisu kohta.",
      "rdfs:label": {
