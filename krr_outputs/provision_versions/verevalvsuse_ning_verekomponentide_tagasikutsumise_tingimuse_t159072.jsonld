      }
    },
    {
      "@id": "estleg:Reg_159072_Par_2_v159072",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159072_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Raske kõrvaltoime ehk raske vereülekande reaktsioon on vereülekande ajal või selle järgselt ilmnenud ohtlik ja soovimatu verekomponendi toime retsipiendi tervisele, mis võib põhjustada rasket tervisehäiret või surma. Raske kõrvaltoime ehk raske vereülekande reaktsioon on vereülekande ajal või selle järgselt ilmnenud ohtlik ja soovimatu verekomponendi toime retsipiendi tervisele, mis võib põhjustada rasket tervisehäiret või surma. 2 (2) Ohtlik kõrvalekalle on vere kogumise, uurimise, verekomponentide valmistamise, säilitamise, väljastamise ja kasutamise käigus ilmnenud juhtum, mis võib retsipiendil või doonoril põhjustada rasket kõrvaltoimet või surma. Ohtlik kõrvalekalle on vere kogumise, uurimise, verekomponentide valmistamise, säilitamise, väljastamise ja kasutamise käigus ilmnenud juhtum, mis võib retsipiendil või doonoril põhjustada rasket kõrvaltoimet või surma. 3 (3) Tagasivaate protseduur on vere käitlemise protsessis aset leidnud ohtliku kõrvalekalde või raske kõrvaltoime (edaspidi juhtumi) tekkepõhjuste väljaselgitamiseks algatatud toiming eesmärgiga tuvastada retsipient, kellele kanti üle potentsiaalselt nakkusohtlikku verekomponenti, või doonor, kelle loovutatud verest oli verekomponent valmistatud. Tagasivaate protseduur on vere käitlemise protsessis aset leidnud ohtliku kõrvalekalde või raske kõrvaltoime (edaspidi juhtumi) tekkepõhjuste väljaselgitamiseks algatatud toiming eesmärgiga tuvastada retsipient, kellele kanti üle potentsiaalselt nakkusohtlikku verekomponenti, või doonor, kelle loovutatud verest oli verekomponent valmistatud.",
      "rdfs:label": {
        "@value": "Reg_159072_Par_2 (redaktsioon 159072)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159072",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159072",
      "estleg:sourceAct": "Verevalvsuse ning verekomponentide tagasikutsumise tingimused ja kord",
      "estleg:provisionRef": "Reg_159072 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159072_Map"
      }
    },
