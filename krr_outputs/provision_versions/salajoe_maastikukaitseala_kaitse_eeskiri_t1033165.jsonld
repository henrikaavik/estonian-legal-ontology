      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033165",
      "estleg:sourceAct": "Salajõe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1033165 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033165_Map_2026"
      }
    },
    {
