      }
    },
    {
      "@id": "estleg:EPV_Par_75_v101112012005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EPV_Par_75"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Parlamendi liikmeks ei või olla: Riigikogu liige; Vabariigi President; Vabariigi Valitsuse liige; Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse, peaministri, mõne valitsusasutuse või muu riigiasutuse juhi poolt nimetatud ametikohal teenistuses olev isik, välja arvatud Riigikogu poolt seaduse alusel nimetatud mõne nõukogu esimees või liige; Eesti Panga Nõukogu esimees; tegevväelane; vallavanem või linnapea; valla- või linnavolikogu liige; Euroopa Ühenduste Komisjoni liige; Euroopa Ühenduste Kohtu või Euroopa Ühenduste esimese astme kohtu kohtunik, kohtujurist või kohtusekretär; Euroopa Keskpanga direktorite nõukogu liige; Euroopa Ühenduste Kontrollikoja liige; Euroopa Ühenduste ombudsman; Euroopa Majandusühenduse ja Euroopa Aatomienergiaühenduse majandus- ja sotsiaalkomitee liige; Regioonide Komitee liige; Euroopa Majandusühenduse asutamislepingu ja Euroopa Aatomienergiaühenduse asutamislepingu alusel ühenduste fondide haldamiseks või alalise vahetu haldusülesande täitmiseks loodud komitee või muu organi liige; Euroopa Investeerimispanga direktorite nõukogu, halduskomitee või personali liige; Euroopa Ühenduste institutsioonide või nendega liidetud spetsialiseeritud asutuste või Euroopa Keskpanga tegevametnik või -teenistuja.",
      "rdfs:label": {
        "@value": "EPV_Par_75 (redaktsioon 101112012005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101112012005",
      "estleg:supersededByVersion": {
        "@id": "estleg:EPV_Par_75_v125062021009"
      },
      "estleg:versionValidTo": {
        "@value": "2021-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EPV_Par_75_v125062021009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EPV_Par_75"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-10-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Parlamendi liikmeks ei või olla: Riigikogu liige; Vabariigi President; Vabariigi Valitsuse liige; Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse, peaministri, mõne valitsusasutuse või muu riigiasutuse juhi poolt nimetatud ametikohal teenistuses olev isik, välja arvatud Riigikogu poolt seaduse alusel nimetatud mõne nõukogu esimees või liige; Eesti Panga Nõukogu esimees; tegevväelane; vallavanem või linnapea, valla- või linnavalitsuse liige; kehtetu - Euroopa Ühenduste Komisjoni liige; Euroopa Ühenduste Kohtu või Euroopa Ühenduste esimese astme kohtu kohtunik, kohtujurist või kohtusekretär; Euroopa Keskpanga direktorite nõukogu liige; Euroopa Ühenduste Kontrollikoja liige; Euroopa Ühenduste ombudsman; Euroopa Majandusühenduse ja Euroopa Aatomienergiaühenduse majandus- ja sotsiaalkomitee liige; Regioonide Komitee liige; Euroopa Majandusühenduse asutamislepingu ja Euroopa Aatomienergiaühenduse asutamislepingu alusel ühenduste fondide haldamiseks või alalise vahetu haldusülesande täitmiseks loodud komitee või muu organi liige; Euroopa Investeerimispanga direktorite nõukogu, halduskomitee või personali liige; Euroopa Ühenduste institutsioonide või nendega liidetud spetsialiseeritud asutuste või Euroopa Keskpanga tegevametnik või -teenistuja.",
      "rdfs:label": {
        "@value": "EPV_Par_75 (redaktsioon 125062021009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "125062021009"
    },
    {
      "@id": "estleg:EPV_Par_75_1_v810702",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EPV_Par_75_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Parlamendi liikme palk on võrdne Riigikogu liikme ametipalgaga. Euroopa Parlamendi liikme palka makstakse riigieelarvest Riigikogu Kantselei kaudu. Hüvitisi Euroopa Parlamendi liikmele Eesti riigieelarvest ei maksta.",
      "rdfs:label": {
        "@value": "EPV_Par_75_1 (redaktsioon 810702)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "810702",
      "estleg:supersededByVersion": {
        "@id": "estleg:EPV_Par_75_1_v13207876"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EPV_Par_75_1_v13207876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
