        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EPV_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-11-11",
        "@type": "xsd:date"
