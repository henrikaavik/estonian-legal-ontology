      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "EPV_Par_75_1 (redaktsioon 13207876)",
        "@language": "et"
      },
