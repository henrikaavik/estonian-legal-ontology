      },
      "estleg:versionText": "Euroopa Parlamendi valimised toimuvad ühes üleriigilises valimisringkonnas.",
      "rdfs:label": {
        "@value": "EPV_Par_6 (redaktsioon 237664)",
        "@language": "et"
      },
