        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EPV_Par_61_v1045567",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
