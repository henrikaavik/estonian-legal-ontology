      "estleg:versionRedactionId": "116062017001"
    },
    {
      "@id": "estleg:Tolliseadus_Par_9_v22395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tolliamet jaguneb osakondadeks ja piirkondlikeks tolliinspektuurideks. (2) Tolliameti ülesandeid kindlaksmääratud piirkondades täidavad piirkondlikud tolliinspektuurid. (3) Piirkondlik tolliinspektuur viib läbi tolliformaalsusi tollipunktides.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_9 (redaktsioon 22395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22395",
