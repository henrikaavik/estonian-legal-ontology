      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_81 (redaktsioon 102122014006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102122014006",
      "estleg:supersededByVersion": {
