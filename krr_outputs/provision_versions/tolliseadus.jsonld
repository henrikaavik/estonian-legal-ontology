      },
      "estleg:versionValidTo": {
        "@value": "2014-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_82_v114012014007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kauba liiduvälisest riigist Eestisse või Eestist liiduvälisesse riiki toimetamise või tollikäitlusviisile deklareerimise eest isiku poolt, kellel ei ole selles valdkonnas tegutsemise õigust tõendavat kohustuslikku dokumenti või registreeringut, –karistatakse rahatrahviga kuni 200 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 2600 eurot.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_82 (redaktsioon 114012014007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114012014007",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_82_v129062014082"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_82_v129062014082",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kauba ühendusevälisest riigist Eestisse või Eestist ühendusevälisesse riiki toimetamise või tollikäitlusviisile deklareerimise eest isiku poolt, kellel ei ole selles valdkonnas tegutsemise õigust tõendavat kohustuslikku dokumenti, –karistatakse rahatrahviga kuni 200 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 2600 eurot.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_82 (redaktsioon 129062014082)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014082",
