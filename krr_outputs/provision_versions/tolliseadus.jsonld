      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_83_v116062017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tolliteenistuse staaži hulka arvatakse sooduskorras kolmekordselt teenistuse aeg tolliametnikuna alates 1990. aasta 22. oktoobrist kuni 1994. aasta 31. juulini, kui isiku tolliteenistuse staaž on kokku vähemalt 20 aastat.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_83 (redaktsioon 116062017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017001"
    },
    {
      "@id": "estleg:Tolliseadus_Par_84_v740392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tollitõkendi või kauba identifitseerimisvahendi rikkumise, omavolilise eemaldamise või tollitõkendiga kaitstud kommertstranspordivahendisse või ehitisse tungimise eest – karistatakse rahatrahviga kuni 200 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 40 000 krooni.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_84 (redaktsioon 740392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740392",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_84_v118112010006"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_84_v118112010006",
