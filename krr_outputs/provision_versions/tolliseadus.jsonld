        "@id": "estleg:Tolliseadus_Par_69_v118112010006"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_69_v118112010006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_69 (redaktsioon 118112010006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118112010006",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_69_v116062017001"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_69_v116062017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Deklareeritava kauba või sularaha liiduvälisest riigist Eestisse või Eestist liiduvälisesse riiki toimetamise eest tollikontrollist kõrvale hoides, kaupa või sularaha deklareerimata jättes, seda vale tariifse klassifikatsiooniga või kirjeldusega deklareerides või muul pettuslikul viisil toimides –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot. (3) Käesolevas paragrahvis nimetatud väärteo katse on karistatav.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_69 (redaktsioon 116062017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017001",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_69_v130122024018"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_69_v130122024018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Deklareeritava kauba või sularaha liiduvälisest riigist Eestisse või Eestist liiduvälisesse riiki toimetamise eest tollikontrollist kõrvale hoides, kaupa või sularaha deklareerimata jättes, seda vale tariifse klassifikatsiooniga või kirjeldusega deklareerides või muul pettuslikul viisil toimides –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 100 000 eurot. (3) Käesolevas paragrahvis nimetatud väärteo katse on karistatav.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_69 (redaktsioon 130122024018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122024018"
    },
    {
      "@id": "estleg:Tolliseadus_Par_7_v22395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tolliametil on tollilipp, tollivapp ja tolliembleem. (2) Tollilipu, tollivapi ja tolliembleemi kirjelduse kinnitab Vabariigi Valitsus. (3) Tollilipu, tollivapi ja tolliembleemi kasutamise korra kehtestab rahandusminister.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_7 (redaktsioon 22395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22395",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_7_v740392"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_7_v740392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul on õigus esitada tolli otsuse või tolliametniku toimingu peale vaie. Vaide esitamine ja lahendamine toimub maksukorralduse seaduses (RT I 2002, 26, 150; 57, 358; 63, 387; 99, 581; 110, 660; 111, 662; 2003, 2, 17; 48, 341; 71, 472; 82, 554; 88, 591; 2004, 2, 7) vaide kohta sätestatud korras, arvestades ühenduse õigusaktides sätestatud erisusi.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_7 (redaktsioon 740392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740392",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_7_v13198080"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_7_v13198080",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul on õigus esitada tolli otsuse või tolliametniku toimingu peale vaie. Vaide esitamine ja lahendamine toimub maksukorralduse seaduses vaide kohta sätestatud korras, arvestades ühenduse õigusaktides sätestatud erisusi.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_7 (redaktsioon 13198080)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13198080",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_7_v114012014007"
      },
      "estleg:versionValidTo": {
        "@value": "2014-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_7_v114012014007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul on õigus esitada tolli otsuse või tolliametniku toimingu peale vaie. Vaide esitamine ja lahendamine toimub maksukorralduse seaduses vaide kohta sätestatud korras, arvestades liidu õigusaktides sätestatud erisusi.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_7 (redaktsioon 114012014007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114012014007",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_7_v116062017001"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_7_v116062017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksu- ja Tolliameti ametnikud kannavad teenistuses olles ettenähtud juhtudel vormiriietust. Vormiriietust võivad ette nähtud juhtudel kanda ka Maksu- ja Tolliameti töötajad ning Sisekaitseakadeemia üliõpilased. (2) Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjelduse kehtestab määrusega. (3) Vormiriietuse kandjad, vormiriietuse andmise ja kandmise korra ning kandmise tähtajad määrab Maksu- ja Tolliameti peadirektor või tema volitatud ametnik.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_7 (redaktsioon 116062017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017001",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_7_v130122024018"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_7_v130122024018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksu- ja Tolliameti ametnikud kannavad teenistuses olles ettenähtud juhtudel vormiriietust. Vormiriietust võivad ette nähtud juhtudel kanda ka Maksu- ja Tolliameti peadirektor ja töötajad ning Sisekaitseakadeemia töötajad ja üliõpilased. (2) Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjelduse kehtestab määrusega. (3) Vormiriietuse kandjad, vormiriietuse andmise ja kandmise korra ning kandmise tähtajad määrab Maksu- ja Tolliameti peadirektor või tema volitatud ametnik.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_7 (redaktsioon 130122024018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122024018"
    },
    {
      "@id": "estleg:Tolliseadus_Par_70_v22395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tollieeskirjade rikkumise ettevalmistamine on süüdlase tahtlik tegevus tingimuste loomisel tollieeskirjade rikkumiseks. (2) Tollieeskirjade rikkumise katse on tollieeskirjade rikkumisele suunatud tahtlik tegu, mis jäi süüdlase tahtest sõltumata lõpule viimata. (3) Karistus tollieeskirjade rikkumise ettevalmistamise või rikkumiskatse eest mõistetakse käesoleva seaduse sätte alusel, mis näeb ette vastutuse vastava tollieeskirjade rikkumise eest.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_70 (redaktsioon 22395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22395",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_70_v740392"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_70_v740392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toll võib lubada, et kui kannete summeerimise või kauba vabastamise ajavahemik on kalendrinädal või -kuu, tasutakse impordi- ja eksporditollimaksude summa, mille tasumise tähtaega on pikendatud, hiljemalt: sellele kalendrinädalale järgneva neljanda nädala reedel, kui ajavahemik on kalendrinädal; sellele kalendrikuule järgneva kuu 16. kuupäeval, kui ajavahemik on kalendrikuu.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_70 (redaktsioon 740392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740392",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_70_v116062017001"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_70_v116062017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohustusliku dokumendita või riikliku registri kandeta kauba, mille suhtes kehtivad piirangud, või keelatud kauba liiduvälisest riigist Eestisse või Eestist liiduvälisesse riiki toimetamise või tolliprotseduurile deklareerimise eest –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot. (3) Käesolevas paragrahvis nimetatud väärteo katse on karistatav.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_70 (redaktsioon 116062017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017001",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_70_v130122024018"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_70_v130122024018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohustusliku dokumendita või riikliku registri kandeta kauba, mille suhtes kehtivad piirangud, või keelatud kauba liiduvälisest riigist Eestisse või Eestist liiduvälisesse riiki toimetamise või tolliprotseduurile deklareerimise eest –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 100 000 eurot. (3) Käesolevas paragrahvis nimetatud väärteo katse on karistatav.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_70 (redaktsioon 130122024018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122024018"
    },
    {
      "@id": "estleg:Tolliseadus_Par_71_v22395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_71"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tolliametnik, kelle menetluses on konkreetne tollieeskirjade rikkumine, on õiguspädev välja nõudma asja lahendamiseks vajalikke dokumente. Isik, kellelt nõutakse dokumentide väljastamist, on kohustatud esitama need tasuta 10 kalendripäeva jooksul nõude saabumise hetkest arvates.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_71 (redaktsioon 22395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22395",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_71_v740392"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_71_v740392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_71"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui tollivõlast tulenevat impordi- ja eksporditollimaksude summat ei ole tasutud ettenähtud tähtaja jooksul, nõuab toll summa koos sellelt arvestatud intressiga sisse maksukorralduse seaduses sätestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_71 (redaktsioon 740392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740392",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_71_v116062017001"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_71_v116062017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_71"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohustusliku dokumendita või riikliku registri kandeta kauba, mille suhtes kehtivad piirangud, või keelatud kauba teisest liidu liikmesriigist Eestisse või Eestist teise liidu liikmesriiki toimetamise eest selliste keeldude ja piirangute korral, mille riiklikku järelevalvet teostab toll, –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot. (3) Käesolevas paragrahvis nimetatud väärteo katse on karistatav.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_71 (redaktsioon 116062017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017001",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_71_v130122024018"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_71_v130122024018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_71"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohustusliku dokumendita või riikliku registri kandeta kauba, mille suhtes kehtivad piirangud, või keelatud kauba teisest liidu liikmesriigist Eestisse või Eestist teise liidu liikmesriiki toimetamise eest selliste keeldude ja piirangute korral, mille riiklikku järelevalvet teostab toll, –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 100 000 eurot. (3) Käesolevas paragrahvis nimetatud väärteo katse on karistatav.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_71 (redaktsioon 130122024018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122024018"
    },
    {
      "@id": "estleg:Tolliseadus_Par_72_v22395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tolliametnikul, kelle menetluses on konkreetne tollieeskirjade rikkumine ning kellel on piisavalt andmeid, et isiku territooriumil, talle kuuluvates ruumides või veokites võib leiduda kaupa, mis kujutab endast tollieeskirjade rikkumise objekti, erilisi hoiukohti ülalmainitud kauba varjatud toimetamiseks üle tollipiiri või tollieeskirjade rikkumist kajastavaid dokumente, on õigus tolliasutuse juhataja kirjalikul korraldusel administratsiooni esindaja ja manukate juuresolekul teha territooriumi, ruumide või transpordivahendite vaatlust, kaasates vajaduse korral vastava eriala eksperte. (2) Vaatluse tulemused kantakse vaatlusprotokolli, mille ärakiri antakse 48 tunni jooksul asjaomasele isikule või tema esindajale.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_72 (redaktsioon 22395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22395",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_72_v740392"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_72_v740392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Impordi- ja eksporditollimaksud laekuvad riigieelarvesse.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_72 (redaktsioon 740392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740392",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_72_v116062017001"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_72_v116062017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liiduvälisest riigist Eestisse tollisoodustusega toimetatud või tollijärelevalve all oleva kaubaga tehtavate teadvalt ebaseaduslike toimingute või tehingute eest –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_72 (redaktsioon 116062017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017001",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_72_v130122024018"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_72_v130122024018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liiduvälisest riigist Eestisse tollisoodustusega toimetatud või tollijärelevalve all oleva kaubaga tehtavate teadvalt ebaseaduslike toimingute või tehingute eest –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 100 000 eurot.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_72 (redaktsioon 130122024018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122024018"
    },
    {
      "@id": "estleg:Tolliseadus_Par_73_v22395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tolliametnik, kelle menetluses on konkreetne tollieeskirjade rikkumine, võib kontrollida tollieeskirjadest kinnipidamist isiku majandustegevuses. Kontrolli tulemused vormistatakse aktiga ning tehakse kontrollitavale teatavaks pärast kontrolli lõppemist.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_73 (redaktsioon 22395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22395",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_73_v740392"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_73_v740392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Tolliseadus_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Deklareeritava kauba toimetamise eest ühendusevälisest riigist Eestisse või Eestist ühendusevälisesse riiki tollikontrollist kõrvale hoidudes, kauba deklareerimata jättes, kaupa vale tariifse klassifikatsiooniga või kirjeldusega deklareerides või muul pettuslikul viisil toimides – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "Tolliseadus_Par_73 (redaktsioon 740392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740392",
      "estleg:supersededByVersion": {
        "@id": "estleg:Tolliseadus_Par_73_v118112010006"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_73_v118112010006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
