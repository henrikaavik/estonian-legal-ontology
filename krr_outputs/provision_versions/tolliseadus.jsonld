        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Tolliseadus_Par_9_v740392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
