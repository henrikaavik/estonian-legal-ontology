      "estleg:provisionRef": "Reg_313480 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313480_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_313480_Par_2_v313480",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
