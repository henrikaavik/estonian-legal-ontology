      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_15_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eraeksperdi surma korral kustutab EKEI personalitalitus ta § 2 lõike 1 punktis 5 nimetatud veebilehel asuvast nimekirjast viivitamatult eraeksperdi surmast teada saamisel. Eraeksperdi surma korral kustutab EKEI personalitalitus ta § 2 lõike 1 punktis 5 nimetatud veebilehel asuvast nimekirjast viivitamatult eraeksperdi surmast teada saamisel. 2 (2) Lõikes 1 nimetatud juhul ei koostata EKEI direktori käskkirja ega saadeta teavitust. Lõikes 1 nimetatud juhul ei koostata EKEI direktori käskkirja ega saadeta teavitust.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_15 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_16_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eraeksperdi nimekirjast kustutamisel kohtuekspertiisiseaduse § 31 lõike 1 punktides 4 ja 5 nimetatud juhtudel koostatakse EKEI direktori käskkiri eraeksperdi nimekirjast kustutamiseks 10 tööpäeva jooksul EKEI-le kustutamise aluseks olevate asjaolude teatavaks saamisest arvates või lisaandmete kogumise või eraeksperdilt selgituse nõudmise korral nende saamisest arvates, kuid mitte hiljem kui kohtuekspertiisiseaduse § 28 lõikes 2 nimetatud tähtajal. Eraeksperdi nimekirjast kustutamisel kohtuekspertiisiseaduse § 31 lõike 1 punktides 4 ja 5 nimetatud juhtudel koostatakse EKEI direktori käskkiri eraeksperdi nimekirjast kustutamiseks 10 tööpäeva jooksul EKEI-le kustutamise aluseks olevate asjaolude teatavaks saamisest arvates või lisaandmete kogumise või eraeksperdilt selgituse nõudmise korral nende saamisest arvates, kuid mitte hiljem kui kohtuekspertiisiseaduse § 28 lõikes 2 nimetatud tähtajal. 2 (2) EKEI personalitalitus kustutab eraeksperdi § 2 lõike 1 punktis 5 nimetatud veebilehel asuvast nimekirjast viie tööpäeva jooksul lõikes 1 nimetatud käskkirja allkirjastamisest. EKEI personalitalitus kustutab eraeksperdi § 2 lõike 1 punktis 5 nimetatud veebilehel asuvast nimekirjast viie tööpäeva jooksul lõikes 1 nimetatud käskkirja allkirjastamisest. 3 (3) Lõikes 2 sätestatud tähtaja jooksul edastatakse eraeksperdile lõikes 1 nimetatud käskkiri ja teavitus tema nimekirjast kustutamisest. Lõikes 2 sätestatud tähtaja jooksul edastatakse eraeksperdile lõikes 1 nimetatud käskkiri ja teavitus tema nimekirjast kustutamisest.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_16 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_17_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eraeksperdi võib kustutada nimekirjast, kui menetleja on teavitanud EKEI-d kohtuekspertiisiseaduse § 31 lõike 2 punktides 1 ja 2 nimetatud asjaoludest ja teinud ettepaneku eraeksperdi nimekirjast kustutamiseks. Eraeksperdi võib kustutada nimekirjast, kui menetleja on teavitanud EKEI-d kohtuekspertiisiseaduse § 31 lõike 2 punktides 1 ja 2 nimetatud asjaoludest ja teinud ettepaneku eraeksperdi nimekirjast kustutamiseks. 2 (2) Eraeksperdi võib kustutada nimekirjast, kui EKEI-le saab teatavaks eraeksperdi tegevus, mis on nimetatud kohtuekspertiisiseaduse § 31 lõike 2 punktides 3–5. Eraeksperdi võib kustutada nimekirjast, kui EKEI-le saab teatavaks eraeksperdi tegevus, mis on nimetatud kohtuekspertiisiseaduse § 31 lõike 2 punktides 3–5. 3 (3) Lõigetes 1 ja 2 nimetatud juhul otsustab eraeksperdi nimekirjast kustutamise kohtuekspertiisiseaduse § 28 lõikes 2 nimetatud tähtaja jooksul EKEI direktor, kes kogub otsustamiseks lisaandmeid või -selgitusi eraeksperdilt ja vajaduse korral kustutamise ettepaneku esitanud menetlejalt. Lõigetes 1 ja 2 nimetatud juhul otsustab eraeksperdi nimekirjast kustutamise kohtuekspertiisiseaduse § 28 lõikes 2 nimetatud tähtaja jooksul EKEI direktor, kes kogub otsustamiseks lisaandmeid või -selgitusi eraeksperdilt ja vajaduse korral kustutamise ettepaneku esitanud menetlejalt. 4 (4) Lõigetes 1 ja 2 nimetatud juhul koostatakse EKEI direktori käskkiri eraeksperdi nimekirjast kustutamiseks 10 tööpäeva jooksul lõikes 3 nimetatud otsuse tegemisest arvates. Lõigetes 1 ja 2 nimetatud juhul koostatakse EKEI direktori käskkiri eraeksperdi nimekirjast kustutamiseks 10 tööpäeva jooksul lõikes 3 nimetatud otsuse tegemisest arvates. 5 (5) EKEI personalitalitus kustutab eraeksperdi § 2 lõike 1 punktis 5 nimetatud veebilehel asuvast nimekirjast viie tööpäeva jooksul lõikes 4 nimetatud käskkirja allkirjastamisest. EKEI personalitalitus kustutab eraeksperdi § 2 lõike 1 punktis 5 nimetatud veebilehel asuvast nimekirjast viie tööpäeva jooksul lõikes 4 nimetatud käskkirja allkirjastamisest. 6 (6) Lõikes 5 sätestatud tähtaja jooksul edastatakse eraeksperdile lõikes 4 nimetatud käskkiri ja teavitus tema nimekirjast kustutamisest. Lõikes 5 sätestatud tähtaja jooksul edastatakse eraeksperdile lõikes 4 nimetatud käskkiri ja teavitus tema nimekirjast kustutamisest.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_17 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_2_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nimekirja peab Eesti Kohtuekspertiisi Instituut (edaspidi EKEI), kes: 1 1) võtab vastu taotlusi füüsilistelt isikutelt nimekirja kandmiseks või kande kustutamiseks; 2 2) vaatab läbi esitatud taotlused ja nõuab vajaduse korral taotluse esitajalt lisadokumente; 3 3) otsustab taotleja nimekirja kandmise või kande kehtivusaja pikendamise; 4 4) otsustab eraeksperdi nimekirjast kustutamise; 5 5) avaldab nimekirja veebilehel www.ekei.ee; 6 6) peab arvestust nimekirjas olevate eraekspertide üle ja teeb vajaduse korral nimekirjas muudatusi; 7 7) vastab eraekspertidega seotud päringutele; 8 8) kutsub vajaduse korral asjatundjaid esitama taotlust enda eraekspertide nimekirja kandmiseks. Nimekirja peab Eesti Kohtuekspertiisi Instituut (edaspidi EKEI), kes: võtab vastu taotlusi füüsilistelt isikutelt nimekirja kandmiseks või kande kustutamiseks; vaatab läbi esitatud taotlused ja nõuab vajaduse korral taotluse esitajalt lisadokumente; otsustab taotleja nimekirja kandmise või kande kehtivusaja pikendamise; otsustab eraeksperdi nimekirjast kustutamise; avaldab nimekirja veebilehel www.ekei.ee; peab arvestust nimekirjas olevate eraekspertide üle ja teeb vajaduse korral nimekirjas muudatusi; vastab eraekspertidega seotud päringutele; kutsub vajaduse korral asjatundjaid esitama taotlust enda eraekspertide nimekirja kandmiseks. 2 (2) Nimekirja koostamise eesmärk, nimekirja kandmise üldised põhimõtted ja nimekirja veebilehel avaldamise nõue on sätestatud kohtuekspertiisiseaduse §-s 25. Nimekirja koostamise eesmärk, nimekirja kandmise üldised põhimõtted ja nimekirja veebilehel avaldamise nõue on sätestatud kohtuekspertiisiseaduse §-s 25. 3 (3) Lõike 1 punktis 5 nimetatud veebilehel avaldatakse eraeksperdi nimi, isikukood, kontaktandmed, ekspertiisiliik ja vajaduse korral täpsem spetsialiseerumise kirjeldus, milles eraekspert on nimekirja kantud, ja kande tegemise ning kande kehtivuse lõppemise kuupäevad. Lõike 1 punktis 5 nimetatud veebilehel avaldatakse eraeksperdi nimi, isikukood, kontaktandmed, ekspertiisiliik ja vajaduse korral täpsem spetsialiseerumise kirjeldus, milles eraekspert on nimekirja kantud, ja kande tegemise ning kande kehtivuse lõppemise kuupäevad.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_2 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_3_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nõuded füüsilisele isikule, kes soovib enda registreerimist eraeksperdina ja kandmist nimekirja, on sätestatud kohtuekspertiisiseaduse § 7 lõike 1 punktides 1–5 ja lõigetes 2–5. Nõuded füüsilisele isikule, kes soovib enda registreerimist eraeksperdina ja kandmist nimekirja, on sätestatud kohtuekspertiisiseaduse § 7 lõike 1 punktides 1–5 ja lõigetes 2–5. 2 (2) Nõuded eraeksperdi kvalifikatsioonile, töökogemusele, samuti tegevusloa, litsentsi või kutsetunnistuse olemasolule ning ekspertiisiks vajalike vahendite kasutamisele on sätestatud kohtuekspertiisiseaduse § 26 lõike 1 punktides 2–4. Nõuded eraeksperdi kvalifikatsioonile, töökogemusele, samuti tegevusloa, litsentsi või kutsetunnistuse olemasolule ning ekspertiisiks vajalike vahendite kasutamisele on sätestatud kohtuekspertiisiseaduse § 26 lõike 1 punktides 2–4. 3 (3) Nimekirja kandmist saab taotleda isik, kes tegutseb valdkonnas, milles tavatsetakse ekspertiise määrata ja mida ei tehta EKEI-s ning mis ei ole kantud kohtuekspertiisiseaduse § 11 lõike 2 alusel kehtestatud loetelusse. Nimekirja kandmist saab taotleda isik, kes tegutseb valdkonnas, milles tavatsetakse ekspertiise määrata ja mida ei tehta EKEI-s ning mis ei ole kantud kohtuekspertiisiseaduse § 11 lõike 2 alusel kehtestatud loetelusse.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_3 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_4_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eraeksperdina nimekirja kandmiseks esitab isik EKEI direktorile digiallkirjastatud taotluse koos § 5 lõikes 2 nimetatud dokumentidega. Eraeksperdina nimekirja kandmiseks esitab isik EKEI direktorile digiallkirjastatud taotluse koos § 5 lõikes 2 nimetatud dokumentidega. 2 (2) Taotlus peab sisaldama taotleja kohta järgmisi andmeid: 1 1) ees- ja perekonnanimi; 2 2) isikukood; 3 3) postiaadress; 4 4) e-posti aadress; 5 5) telefoninumber; 6 6) ekspertiisiliik (vajaduse korral täpsustatud spetsialiseerumisega), milles taotletakse enda nimekirja kandmist; 7 7) haridustase ja omandatud eriala; 8 8) taotletavas ekspertiisiliigis või sellega lähedasel erialal omandatud töökogemus ja töötatud aeg. Taotlus peab sisaldama taotleja kohta järgmisi andmeid: ees- ja perekonnanimi; isikukood; postiaadress; e-posti aadress; telefoninumber; ekspertiisiliik (vajaduse korral täpsustatud spetsialiseerumisega), milles taotletakse enda nimekirja kandmist; haridustase ja omandatud eriala; taotletavas ekspertiisiliigis või sellega lähedasel erialal omandatud töökogemus ja töötatud aeg. 3 (3) Lisaks lõikes 2 loetletud andmetele peab taotlus sisaldama kinnitust, et taotleja: 1 1) vastab kohtuekspertiisiseaduse § 7 lõike 1 punktides 1–5 ja lõigetes 2–5 sätestatud nõuetele; 2 2) on teadlik menetlusseadustikest tulenevatest eksperdi õigustest ja kohustustest; 3 3) tunneb taotletava ekspertiisiliigi valdkonda reguleerivaid õigusakte; 4 4) omab võimalust kasutada ekspertiisi tegemiseks vajalikke vahendeid. Lisaks lõikes 2 loetletud andmetele peab taotlus sisaldama kinnitust, et taotleja: vastab kohtuekspertiisiseaduse § 7 lõike 1 punktides 1–5 ja lõigetes 2–5 sätestatud nõuetele; on teadlik menetlusseadustikest tulenevatest eksperdi õigustest ja kohustustest; tunneb taotletava ekspertiisiliigi valdkonda reguleerivaid õigusakte; omab võimalust kasutada ekspertiisi tegemiseks vajalikke vahendeid.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_4 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_5_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlusele lisatakse dokumendid, mis tõendavad taotleja vastavust kohtuekspertiisiseaduses sätestatud nõuetele ning tema tööalast pädevust ja sobivust tegutseda nimekirja kantud eraeksperdina. Taotlusele lisatakse dokumendid, mis tõendavad taotleja vastavust kohtuekspertiisiseaduses sätestatud nõuetele ning tema tööalast pädevust ja sobivust tegutseda nimekirja kantud eraeksperdina. 2 (2) Taotlusele lisatavad dokumendid on: 1 1) elulookirjeldus (CV), mis on koostatud Europassi vormis; 2 2) haridust ja täienduskoolitust tõendavate dokumentide koopiad; 3 3) eesti keele oskust tõendava dokumendi koopia, kui taotleja emakeel ei ole eesti keel; 4 4) tegevusloa, kehtiva litsentsi või kutsetunnistuse koopia, kui tegemist on reguleeritud kutsealaga; 5 5) karistusregistri teatis, mis tõendab, et taotleja ei ole süüdi mõistetud tahtliku kuriteo toimepanemises ega karistatud korruptsioonivastases seaduses sätestatud väärteo eest. Taotlusele lisatavad dokumendid on: elulookirjeldus (CV), mis on koostatud Europassi vormis; haridust ja täienduskoolitust tõendavate dokumentide koopiad; eesti keele oskust tõendava dokumendi koopia, kui taotleja emakeel ei ole eesti keel; tegevusloa, kehtiva litsentsi või kutsetunnistuse koopia, kui tegemist on reguleeritud kutsealaga; karistusregistri teatis, mis tõendab, et taotleja ei ole süüdi mõistetud tahtliku kuriteo toimepanemises ega karistatud korruptsioonivastases seaduses sätestatud väärteo eest. 3 (3) Taotleja võib esitada enda kohta täiendavalt dokumente, mida ei ole lõikes 2 nimetatud ning mis tõendavad taotleja vastavust kohtuekspertiisiseaduses sätestatud nõuetele. Taotleja võib esitada enda kohta täiendavalt dokumente, mida ei ole lõikes 2 nimetatud ning mis tõendavad taotleja vastavust kohtuekspertiisiseaduses sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_5 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_6_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotlus koos lisadokumentidega registreeritakse selle saabumisel EKEI dokumendihaldussüsteemis vastavalt EKEI asjaajamiskorrale. Taotlus koos lisadokumentidega registreeritakse selle saabumisel EKEI dokumendihaldussüsteemis vastavalt EKEI asjaajamiskorrale.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_6 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_7_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlused vaadatakse läbi saabumise järjekorras. Taotlused vaadatakse läbi saabumise järjekorras. 2 (2) Taotlused vaatab läbi EKEI personalitalitus, kes: 1 1) kontrollib esitatud taotluse ja lisadokumentide põhjal taotleja vastavust eraeksperdile kohtuekspertiisiseaduses kehtestatud nõuetele; 2 2) nõuab taotlejalt lisadokumentide esitamist, kui taotluses on puudusi või ei ole esitatud andmeid, mis tõendavad taotleja vastavust kohtuekspertiisiseaduses eraeksperdile kehtestatud nõuetele; 3 3) teeb vajaduse korral EKEI direktorile ettepaneku moodustada eraeksperdi nimekirja kandmise otsustamiseks komisjon ja see kokku kutsuda. Taotlused vaatab läbi EKEI personalitalitus, kes: kontrollib esitatud taotluse ja lisadokumentide põhjal taotleja vastavust eraeksperdile kohtuekspertiisiseaduses kehtestatud nõuetele; nõuab taotlejalt lisadokumentide esitamist, kui taotluses on puudusi või ei ole esitatud andmeid, mis tõendavad taotleja vastavust kohtuekspertiisiseaduses eraeksperdile kehtestatud nõuetele; teeb vajaduse korral EKEI direktorile ettepaneku moodustada eraeksperdi nimekirja kandmise otsustamiseks komisjon ja see kokku kutsuda.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_7 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_8_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nimekirja kandmise taotluse ja lisadokumentide läbivaatamise ning otsuse tegemise tähtaeg ja selle pikendamise võimalus on sätestatud kohtuekspertiisiseaduse § 28 lõikes 2. Nimekirja kandmise taotluse ja lisadokumentide läbivaatamise ning otsuse tegemise tähtaeg ja selle pikendamise võimalus on sätestatud kohtuekspertiisiseaduse § 28 lõikes 2. 2 (2) Kui taotleja ei esita lisadokumente, lõpetatakse taotluse läbivaatamine otsust tegemata ühe kuu möödudes päevast, mil taotlejal oli kohustus lisadokumendid esitada. Kui taotleja ei esita lisadokumente, lõpetatakse taotluse läbivaatamine otsust tegemata ühe kuu möödudes päevast, mil taotlejal oli kohustus lisadokumendid esitada.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_8 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058351_Par_9_v1058351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058351_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eraeksperdi nimekirja kandmise otsustab personalitalituse ettepanekul EKEI direktor oma käskkirjaga. Eraeksperdi nimekirja kandmise otsustab personalitalituse ettepanekul EKEI direktor oma käskkirjaga. 2 (2) EKEI direktor võib vajaduse korral kaasata otsuse tegemisse taotletava ekspertiisiliigi või sellele lähedase eriala asjatundjaid, moodustades selleks kuni viieliikmelise komisjoni, kelle töövormiks on koosolek. Komisjoni seisukoht ei ole direktorile siduv otsuse tegemisel. EKEI direktor võib vajaduse korral kaasata otsuse tegemisse taotletava ekspertiisiliigi või sellele lähedase eriala asjatundjaid, moodustades selleks kuni viieliikmelise komisjoni, kelle töövormiks on koosolek. Komisjoni seisukoht ei ole direktorile siduv otsuse tegemisel. 3 (3) EKEI direktor keeldub taotleja eraeksperdina nimekirja kandmisest, kui taotleja ei vasta kohtuekspertiisiseaduse § 7 lõike 1 punktides 1–5 ja lõigetes 2–5 ning § 26 lõike 1 punktides 2–4 ja lõikes 2 eraeksperdile esitatud nõuetele. Taotlejat teavitatakse keeldumisest kirjalikult. EKEI direktor keeldub taotleja eraeksperdina nimekirja kandmisest, kui taotleja ei vasta kohtuekspertiisiseaduse § 7 lõike 1 punktides 1–5 ja lõigetes 2–5 ning § 26 lõike 1 punktides 2–4 ja lõikes 2 eraeksperdile esitatud nõuetele. Taotlejat teavitatakse keeldumisest kirjalikult.",
      "rdfs:label": {
        "@value": "Reg_1058351_Par_9 (redaktsioon 1058351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058351",
      "estleg:sourceAct": "Registreeritud eraekspertide nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_1058351 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058351_Map_2026"
      }
    },
