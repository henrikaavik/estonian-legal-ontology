      }
    },
    {
      "@id": "estleg:Reg_1030323_Par_2_v1030323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030323_Par_2"
