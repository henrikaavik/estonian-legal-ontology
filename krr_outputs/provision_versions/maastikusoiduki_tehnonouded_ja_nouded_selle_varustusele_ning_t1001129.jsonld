      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kütusepaak peab vastama valmistaja poolt ettenähtule. Kütusepaak peab vastama valmistaja poolt ettenähtule. 2 (2) Kütusepaak peab olema valmistatud metallist või tulekindlast plastikust, olema keemiliselt vastupidav erinevatele kütuselisanditele ja ei tohi lekkida. Kütusepaak peab olema valmistatud metallist või tulekindlast plastikust, olema keemiliselt vastupidav erinevatele kütuselisanditele ja ei tohi lekkida. 3 (3) Kütusepaaki kontrollitakse vaatlusega. Kütusepaaki kontrollitakse vaatlusega.",
      "rdfs:label": {
        "@value": "Reg_1001129_Par_29 (redaktsioon 1001129)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001129",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001129",
