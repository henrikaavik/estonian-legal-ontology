    {
      "@id": "estleg:Reg_1061626_Par_7_v1061626",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061626_Par_7"
