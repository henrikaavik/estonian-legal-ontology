      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse taotlemise ja kasutamisega seotud teavet ja dokumente esitatakse perioodi 2021–2027 Euroopa Liidu ühtekuuluvus- ja siseturvalisuspoliitika fondide rakendamise seaduse § 21 lõikes 3 sätestatud e-toetuse keskkonnas. Toetuse taotlemise ja kasutamisega seotud teavet ja dokumente esitatakse perioodi 2021–2027 Euroopa Liidu ühtekuuluvus- ja siseturvalisuspoliitika fondide rakendamise seaduse § 21 lõikes 3 sätestatud e-toetuse keskkonnas.",
      "rdfs:label": {
        "@value": "Reg_1062599_Par_3 (redaktsioon 1062599)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062599",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062599",
      "estleg:sourceAct": "Ida-Viru elektrivõrgu uuendamise toetus",
      "estleg:provisionRef": "Reg_1062599 § 3",
      "estleg:partOfAct": {
