      },
      "dc:source": "Rahastamiskohustusega postiteenuse osutaja tulu- ja kuluarvestuse andmete deklareerimise nõuded"
    },
    {
      "@id": "estleg:Reg_333660_Par_1_v333660",
      "@type": [
