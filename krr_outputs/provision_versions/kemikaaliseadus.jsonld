    {
      "@id": "estleg:KEMIKA_Par_11_v110112015002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KEMIKA_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turule lastavad detergendid peavad vastama Euroopa Parlamendi ja nõukogu määruses (EÜ) nr 648/2004 detergentide kohta (ELT L 104, 08.04.2004, lk 1–35) (edaspidi detergendimäärus) sätestatud nõuetele. (2) Detergendi turule laskmiseks detergendimääruse kohaselt erandit taotlev isik peab enne taotluse esitamist tasuma riigilõivu riigilõivuseaduses sätestatud määras.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_11 (redaktsioon 110112015002)",
        "@language": "et"
      },
