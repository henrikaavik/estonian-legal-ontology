        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KEMIKA_Par_9 (redaktsioon 130122010018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122010018",
      "estleg:supersededByVersion": {
