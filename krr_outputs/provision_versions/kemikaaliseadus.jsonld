        "@type": "xsd:date"
      },
      "estleg:versionText": "Kemikaali käitlemine on kemikaali valmistamine, töötlemine, pakendamine, hoidmine, vedamine, müümine, kasutamine ja kemikaaliga seonduv muu tegevus.",
      "rdfs:label": {
