      }
    },
    {
      "@id": "estleg:KEMIKA_Par_41_v110122020011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KEMIKA_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaametil on lubatud kasutada füüsilist jõudu korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_41 (redaktsioon 110122020011)",
        "@language": "et"
