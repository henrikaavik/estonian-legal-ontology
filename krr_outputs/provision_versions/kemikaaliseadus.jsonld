    {
      "@id": "estleg:KEMIKA_Par_31_v110112015002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KEMIKA_Par_31"
      },
