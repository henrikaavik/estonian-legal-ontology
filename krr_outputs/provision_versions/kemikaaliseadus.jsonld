      "estleg:versionValidTo": {
        "@value": "2015-12-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KEMIKA_Par_10_v110112015002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KEMIKA_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kemikaali käitleja teavitab viivitamata Häirekeskust kemikaali käitlemisega kaasnenud keskkonnareostusest või muust õnnetusest. Häirekeskus edastab saadud teabe õnnetusega kaasnenud keskkonnahäiringu puhul esimesel võimalusel Keskkonnainspektsioonile, ja kui õnnetus toimus ohtlikus ettevõttes või suurõnnetuse ohuga ettevõttes, Tehnilise Järelevalve Ametile.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_10 (redaktsioon 110112015002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110112015002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KEMIKA_Par_10_v112122018044"
      },
      "estleg:versionValidTo": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KEMIKA_Par_10_v112122018044",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KEMIKA_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kemikaali käitleja teavitab viivitamata Häirekeskust kemikaali käitlemisega kaasnenud keskkonnareostusest või muust õnnetusest. Häirekeskus edastab saadud teabe õnnetusega kaasnenud keskkonnahäiringu puhul esimesel võimalusel Keskkonnainspektsioonile, ja kui õnnetus toimus ohtlikus ettevõttes või suurõnnetuse ohuga ettevõttes, Tarbijakaitse ja Tehnilise Järelevalve Ametile.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_10 (redaktsioon 112122018044)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112122018044",
      "estleg:supersededByVersion": {
        "@id": "estleg:KEMIKA_Par_10_v110122020011"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KEMIKA_Par_10_v110122020011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KEMIKA_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kemikaali käitleja teavitab viivitamata Häirekeskust kemikaali käitlemisega kaasnenud keskkonnareostusest või muust õnnetusest. Häirekeskus edastab saadud teabe õnnetusega kaasnenud keskkonnahäiringu puhul esimesel võimalusel Keskkonnaametile, ja kui õnnetus toimus ohtlikus ettevõttes või suurõnnetuse ohuga ettevõttes, Tarbijakaitse ja Tehnilise Järelevalve Ametile.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_10 (redaktsioon 110122020011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020011"
    },
    {
      "@id": "estleg:KEMIKA_Par_11_v22410",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KEMIKA_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sotsiaalministri määrusega kehtestatakse: ohtlike ainete loetelu; ohtlike ainete piirnormid töökeskkonnas; elanikkonnale ja loodusele ohtlike kemikaalide käitlemise piirangud. (2) Majandusministri määrusega kehtestatakse: nõuded kemikaali käitlemise seadmele, lähtudes kemikaali ohtlikkusest ja käitlemisviisist; ohtlike ettevõtete ohtlikkuse kategooriad ning kemikaalide summaarse ohtlikkuse määra ja alammäära arvutamise juhend; ohtliku kemikaali künniskogus ja käitlemise piirkogus suurõnnetuse ohuga ettevõttele. (3) Teede- ja sideministri määrusega kehtestatakse, lähtudes kemikaali ohtlikkusest: nõuded kemikaali hoiukohale, peale-, maha- ja ümberlaadimiskohale ning teistele kemikaali käitlemiseks vajalikele ehitistele sadamas, autoterminalis, raudteejaamas, lennujaamas; nõuded veovahendile; tervisele, varale või keskkonnale kemikaalist johtuda võiva kahju vältimist või vähendamist võimaldavad nõuded veose jälgimisele ning veole teedel, veeteedel, õhu kaudu ja posti teel. (4) Siseministri määrusega kehtestatakse: ohtlikus ettevõttes riskianalüüsi tegemise kord ning õnnetuse ärahoidmise ja õnnetuse korral tegutsemise nõuded; suurõnnetuse ohuga ettevõtte teabelehe, ohutusaruande ning hädaolukorra plaanide koostamise ja esitamise kord; suurõnnetuse ohuga ettevõtete loetelu.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_11 (redaktsioon 22410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22410",
      "estleg:supersededByVersion": {
        "@id": "estleg:KEMIKA_Par_11_v264729"
      },
      "estleg:versionValidTo": {
        "@value": "2003-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KEMIKA_Par_11_v264729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KEMIKA_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sotsiaalministri määrusega kehtestatakse: ohtlike ainete loetelu; kehtetu - elanikkonnale ja loodusele ohtlike kemikaalide käitlemise piirangud. (2) Majandus- ja kommunikatsiooniministri määrusega kehtestatakse: nõuded kemikaali käitlemise seadmele, lähtudes kemikaali ohtlikkusest ja käitlemisviisist; lähtudes kemikaali ohtlikkusest, nõuded kemikaali hoiukohale, peale-, maha- ja ümberlaadimiskohale ning teistele kemikaali käitlemiseks vajalikele ehitistele sadamas, autoterminalis, raudteejaamas ja lennujaamas; lähtudes kemikaali ohtlikkusest, nõuded veovahendile; kemikaali ohtlikkuse alammäär ja ohtliku kemikaali künniskogus ning suurõnnetuse ohuga ettevõtte ohtlikkuse kategooria ja ohtliku ettevõtte määratlemise kord; ohutusnõuniku koolituse õppekava, kutseoskusnõuded ja koolitustunnistuse vorm. (3) Kehtetu - (4) Siseministri määrusega kehtestatakse ohtliku ja suurõnnetuse ohuga ettevõtte teabelehe, ohutusaruande ja hädaolukorra lahendamise plaanide koostamise ja esitamise kord ning suurõnnetuse ohuga ettevõtete loetelu pidamine.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_11 (redaktsioon 264729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264729",
