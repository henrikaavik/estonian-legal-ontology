      },
      "estleg:versionText": "Järelevalvet käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete täitmise üle teostavad vastavalt oma pädevusele keskkonnajärelevalve asutused ja päästeasutused ning Majandusministeeriumi, Siseministeeriumi, Sotsiaalministeeriumi ja Teede- ja Sideministeeriumi valitsemisala ametid ja inspektsioonid.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_24 (redaktsioon 22410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22410",
      "estleg:supersededByVersion": {
