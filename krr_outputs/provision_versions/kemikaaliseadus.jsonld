      },
      "estleg:versionValidFrom": {
        "@value": "2015-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnainspektsioonil on lubatud kasutada füüsilist jõudu korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_41 (redaktsioon 110112015002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110112015002",
      "estleg:supersededByVersion": {
