      }
    },
    {
      "@id": "estleg:KEMIKA_Par_9_v110112015002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KEMIKA_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majandus- ja kutsetegevuse raames kemikaali käitlev isik peab arvestust käideldavate ohtlike kemikaalide üle ja säilitab arvestusdokumente kümme aastat. Ohtlike kemikaalide arvestus peab näitama iga kemikaali koguse liikumist ettevõttes selle soetamisest kuni töötlemise, väljastamise või kahjutustamiseni. (2) kehtestab määrusega ohtlike kemikaalide üle arvestuse pidamise korra.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_9 (redaktsioon 110112015002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110112015002"
    }
  ]
}
