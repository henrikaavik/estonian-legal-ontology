        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KEMIKA_Par_3 (redaktsioon 117042013003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117042013003",
