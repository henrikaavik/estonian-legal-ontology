      },
      "estleg:versionText": "Kemikaali käitlemine on kemikaali valmistamine, töötlemine, pakendamine, hoidmine, vedamine, turustamine, kasutamine ja kemikaaliga seonduv muu tegevus.",
      "rdfs:label": {
        "@value": "KEMIKA_Par_4 (redaktsioon 816476)",
        "@language": "et"
      },
