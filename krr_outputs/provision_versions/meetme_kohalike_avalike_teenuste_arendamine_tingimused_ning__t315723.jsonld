    {
      "@id": "estleg:Reg_315723_Par_12_14_v315723",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_315723_Par_12_14"
