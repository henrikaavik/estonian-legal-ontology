      }
    },
    {
      "@id": "estleg:KOHTUT_Par_53_v12895876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOHTUT_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse alusel ametisse nimetatud endisele maakohtu täitevosakonna kohtutäiturile ei maksta avaliku teenistuse seaduse §-s 131 ettenähtud hüvitist.",
      "rdfs:label": {
        "@value": "KOHTUT_Par_53 (redaktsioon 12895876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895876",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOHTUT_Par_53_v13252632"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOHTUT_Par_53_v13252632",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOHTUT_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohus on tunnistanud kohtutäituri tegevuse tasu sissenõudmisel või tasu suuruse määramisel seadusvastaseks, tagastab kohtutäitur alusetult nõutud ja tasutud summa kohustatud isikule kümne päeva jooksul kohtulahendi jõustumisest arvates.",
      "rdfs:label": {
        "@value": "KOHTUT_Par_53 (redaktsioon 13252632)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13252632"
    },
    {
      "@id": "estleg:KOHTUT_Par_54_v26816",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOHTUT_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel ametisse nimetatud kohtutäiturile võib tema tegevuse alustamiseks võõrandada riigile kuuluvat vallasvara. (2) Käesoleva paragrahvi lõikes 1 nimetatud juhul ei kohaldata riigivaraseaduse (RT I 1995, 22, 327; 1996, 36, 738; 40, 773; 48, 942; 81, 1446; 1997, 45, 724; 1998, 30, 409; 1999, 10, 155; 16, 271; 2000, 39, 239; 49, 306; 51, 319; 2001, 7, 17) §-s 24 ettenähtud piiranguid. (3) Käesoleva seaduse alusel ametisse nimetatud kohtutäiturile võib tema tegevuse alustamiseks anda kuni 2001. aasta 31. detsembrini tasuta kasutada enne käesoleva seaduse jõustumist maa- või linnakohtu täitevosakonna käsutuses olnud ruumi.",
      "rdfs:label": {
        "@value": "KOHTUT_Par_54 (redaktsioon 26816)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26816",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOHTUT_Par_54_v704018"
      },
      "estleg:versionValidTo": {
        "@value": "2003-10-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOHTUT_Par_54_v704018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOHTUT_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel ametisse nimetatud kohtutäiturile võib tema tegevuse alustamiseks võõrandada riigile kuuluvat vallasvara. (2) Käesoleva paragrahvi lõikes 1 nimetatud juhul ei kohaldata riigivaraseaduse (RT I 1995, 22, 327; 1996, 36, 738; 40, 773; 48, 942; 81, 1446; 1997, 45, 724; 1998, 30, 409; 1999, 10, 155; 16, 271; 2000, 39, 239; 49, 306; 51, 319; 2001, 7, 17) §-s 24 ettenähtud piiranguid. (3) Käesoleva seaduse alusel ametisse nimetatud kohtutäiturile võib tema tegevuse alustamiseks anda kuni 2001. aasta 31. detsembrini tasuta kasutada enne käesoleva seaduse jõustumist maa- või linnakohtu täitevosakonna käsutuses olnud ruumi. §-d 55--58 [Käesolevast tekstist välja jäetud]",
