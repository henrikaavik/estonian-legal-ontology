      },
      "estleg:versionText": "Käesolev seadus reguleerib kohtutäituri õiguslikku seisundit ja distsiplinaarvastutust ning kohtutäituri tasustamise aluseid.",
      "rdfs:label": {
        "@value": "KOHTUT_Par_1 (redaktsioon 26816)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26816",
      "estleg:supersededByVersion": {
