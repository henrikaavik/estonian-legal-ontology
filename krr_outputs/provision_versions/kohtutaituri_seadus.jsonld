      }
    },
    {
      "@id": "estleg:KOHTUT_Par_4_v13252632",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOHTUT_Par_4"
      },
      "estleg:versionValidFrom": {
