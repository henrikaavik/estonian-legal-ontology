      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määrusega kehtestatakse välismaiste ametiisikute loetelu, kelle puhul eeldatakse volitaja isikusamasuse ja tehingu tegemise võime usaldusväärset tuvastamist. Niisuguse ametiisiku kinnitatud või tõestatud volikiri on võrdne Eesti notari tõestatud volikirjaga, kui on täidetud käesoleva seaduse §-st 56 tulenev legaliseerimise või apostilliga kinnitamise nõue. (2) Kohus võib tunnustada ka teiste välismaiste ametiisikute pädevust volikirja tõestamisel, kui ametiisiku ametialane ettevalmistus ja seisund vastab Eesti notari omale ning volikirja tõestamise põhimõtted vastavad käesolevas seaduses tehingute tõestamise kohta sätestatule.",
      "rdfs:label": {
        "@value": "TõS_Par_57 (redaktsioon 110032016013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110032016013"
    },
    {
      "@id": "estleg:TõS_Par_58_v27352",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TõS_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Justiitsminister võib oma määrusega kohustada notarit arvutivõrgu kaudu kontrollima tõestamistoimingu suhtes olulisi asjaolusid registritest ja muudest andmekogudest.",
      "rdfs:label": {
        "@value": "TõS_Par_58 (redaktsioon 27352)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27352",
      "estleg:supersededByVersion": {
        "@id": "estleg:TõS_Par_58_v13184823"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TõS_Par_58_v13184823",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
