    },
    {
      "@id": "estleg:TõS_Par_59_v27352",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TõS_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. veebruaril. (2) Käesoleva seaduse §-d 56-57 jõustuvad kümnendal päeval pärast seaduse Riigi Teatajas avaldamist. (3) Notariaalselt kinnitatud tehing käesoleva seaduse ning tõestamisseaduse rakendamisega seotud seaduste muutmise seaduse mõttes on notariaalselt tõestatud allkirjadega tehing tsiviilseadustiku üldosa seaduse (RT I 1994, 53, 889; 65, õiend; 89, 1516; 1995, 26-28, 355; 49, 749; 87, 1540; 1996, 40, 773; 42, 811; 1998, 30, 409; 59, 941; 1999, 10, 155) § 92 lõike 2 tähenduses. Riigikogu esimees Toomas SAVI",
      "rdfs:label": {
        "@value": "TõS_Par_59 (redaktsioon 27352)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27352",
      "estleg:supersededByVersion": {
        "@id": "estleg:TõS_Par_59_v179694"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TõS_Par_59_v179694",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TõS_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. veebruaril. (2) Käesoleva seaduse §-d 56-57 jõustuvad kümnendal päeval pärast seaduse Riigi Teatajas avaldamist. (3) Notariaalselt kinnitatud tehing käesoleva seaduse ning tõestamisseaduse rakendamisega seotud seaduste muutmise seaduse mõttes on notariaalselt tõestatud allkirjadega tehing tsiviilseadustiku üldosa seaduse (RT I 1994, 53, 889; 65, õiend; 89, 1516; 1995, 26-28, 355; 49, 749; 87, 1540; 1996, 40, 773; 42, 811; 1998, 30, 409; 59, 941; 1999, 10, 155) § 92 lõike 2 tähenduses.",
      "rdfs:label": {
        "@value": "TõS_Par_59 (redaktsioon 179694)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "179694",
      "estleg:supersededByVersion": {
        "@id": "estleg:TõS_Par_59_v12896100"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-27",
        "@type": "xsd:date"
      }
    },
    {
