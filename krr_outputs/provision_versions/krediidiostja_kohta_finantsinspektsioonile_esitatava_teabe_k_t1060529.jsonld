      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Krediidiostja kohta Finantsinspektsioonile esitatava teabe kord ja vormid (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Krediidiostja kohta Finantsinspektsioonile esitatava teabe kord ja vormid"
    },
    {
      "@id": "estleg:Reg_1060529_Par_1_v1060529",
      "@type": [
