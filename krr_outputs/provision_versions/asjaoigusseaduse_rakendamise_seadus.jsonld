      "estleg:provisionRef": "AÕSRS § 13_3",
      "estleg:partOfAct": {
        "@id": "estleg:AOSRS_Map"
      }
    },
    {
      "@id": "estleg:AOSRS_Par_13_3_v254264",
      "@type": [
