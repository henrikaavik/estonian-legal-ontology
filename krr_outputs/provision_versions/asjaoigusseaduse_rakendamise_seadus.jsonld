    {
      "@id": "estleg:AOSRS_Par_1_v115032013034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOSRS_Par_1"
