        "@value": "2013-03-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asjaõigusseadus jõustub 1993. aasta 1. detsembril.",
      "rdfs:label": {
        "@value": "AÕSRS_Par_1 (redaktsioon 115032013034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032013034",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032013034",
      "estleg:sourceAct": "Asjaõigusseaduse rakendamise seadus",
      "estleg:provisionRef": "AÕSRS § 1",
