      }
    },
    {
      "@id": "estleg:AOSRS_Par_13_5_v129062011007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOSRS_Par_13_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-06-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantstagatise kokkuleppele, mis on sõlmitud enne 2011. aasta 30. juunit, ning sellise kokkuleppe alusel finantstagatise realiseerimisele kohaldatakse enne käesoleva seaduse 2011. aasta 9. juunit vastuvõetud redaktsiooni jõustumist finantstagatise kokkulepete suhtes kehtinud õigusakte. Esimeses lauses sätestatut kohaldatakse ka juhul, kui enne 2011. aasta 30. juunit sõlmitud tagatiskokkuleppe kohaselt tagatiseks olevad nõuded tekivad pärast 2011. aasta 30. juunit.",
      "rdfs:label": {
        "@value": "AÕSRS_Par_13_5 (redaktsioon 129062011007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062011007",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOSRS_Par_13_5_v113032014084"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062011007",
      "estleg:sourceAct": "Asjaõigusseaduse rakendamise seadus",
      "estleg:provisionRef": "AÕSRS § 13_5",
      "estleg:partOfAct": {
        "@id": "estleg:AOSRS_Map"
      }
    },
    {
      "@id": "estleg:AOSRS_Par_13_5_v113032014084",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOSRS_Par_13_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Finantstagatise kokkuleppele, mis on sõlmitud enne 2011. aasta 30. juunit, ning sellise kokkuleppe alusel finantstagatise realiseerimisele kohaldatakse enne käesoleva seaduse 2011. aasta 9. juunit vastuvõetud redaktsiooni jõustumist finantstagatise kokkulepete suhtes kehtinud õigusakte. Esimeses lauses sätestatut kohaldatakse ka juhul, kui enne 2011. aasta 30. juunit sõlmitud tagatiskokkuleppe kohaselt tagatiseks olevad nõuded tekivad pärast 2011. aasta 30. juunit.",
      "rdfs:label": {
        "@value": "AÕSRS_Par_13_5 (redaktsioon 113032014084)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014084",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014084",
      "estleg:sourceAct": "Asjaõigusseaduse rakendamise seadus",
      "estleg:provisionRef": "AÕSRS § 13_5",
      "estleg:partOfAct": {
        "@id": "estleg:AOSRS_Map"
      }
    },
    {
      "@id": "estleg:AOSRS_Par_14_v22263",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOSRS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakasutusõiguseta või ehitusloata püstitatud ehitis või selle osa (juurdeehitis), mis on maaga püsivas ühenduses, on asjaõigusseaduse § 16 kohaselt maatüki oluline osa. Maakasutusõiguse või ehitusloata püstitatud ning omandireformi aluste seaduse ja sellest tulenevate õigusaktide alusel üleantava ehitise või selle osa või teeseaduse (RT I 1999, 26, 377; 93, 831) § 2 2. lõikes nimetatud rajatise suhtes kohaldatakse käesoleva seaduse § 13 sätteid ning ehitist võib käsutada pärast ehitisele kasutusloa andmist. Õigusliku aluseta püstitatud ehitisele kasutusloa andmine toimub planeerimis- ja ehitusseaduse (RT I 1995, 59, 1006; 1996, 36, 738; 49, 953; 1999, 27, 380; 29, 398 ja 399) § 70 alusel, kuid sellega ei või rikkuda maa tagastamise õigustatud subjekti õigusi. (1¹) Ehitusloana käesoleva paragrahvi 1. lõike tähenduses käsitletakse ka enne 1991. aasta 1. novembrit koostatud ja kehtinud korras kinnitatud maa ostueesõigusega erastamist taotleva isiku elamu, suvila või aiamaja tüüpprojekti või enne nimetatud tähtpäeva koostatud ja kehtinud korras kinnitatud maa ostueesõigusega erastamist taotleva isiku elamu, suvila või aiamaja ehitusprojekti, kui ehitusloa väljaandmist ei ole võimalik tuvastada. (2) Maa omaniku ja ehitaja vahelistele suhetele kohaldatakse asjaõigusseaduse §-de 138 ja 139 sätteid, välja arvatud käesoleva paragrahvi 1. lõike teises lauses sätestatud ehitise puhul. (3) Käesoleva paragrahvi 1. lõikes nimetatud ehitise olemasolu ei saa olla aluseks selle maa suhtes maareformi seaduse § 6 2. lõike punkti 3 sätete kohaldamisele, välja arvatud käesoleva paragrahvi 1. lõike teises lauses sätestatud ehitise puhul.",
      "rdfs:label": {
        "@value": "AÕSRS_Par_14 (redaktsioon 22263)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22263",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOSRS_Par_14_v175989"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22263",
      "estleg:sourceAct": "Asjaõigusseaduse rakendamise seadus",
      "estleg:provisionRef": "AÕSRS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:AOSRS_Map"
      }
    },
    {
      "@id": "estleg:AOSRS_Par_14_v175989",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOSRS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 31. 12. 2002] (1) Maakasutusõiguseta või ehitusloata püstitatud ehitis või selle osa (juurdeehitis), mis on maaga püsivas ühenduses, on asjaõigusseaduse § 16 kohaselt maatüki oluline osa. Maakasutusõiguse või ehitusloata püstitatud ning omandireformi aluste seaduse ja sellest tulenevate õigusaktide alusel üleantava ehitise või selle osa või teeseaduse (RT I 1999, 26, 377; 93, 831) § 2 2. lõikes nimetatud rajatise suhtes kohaldatakse käesoleva seaduse § 13 sätteid ning ehitist võib käsutada pärast ehitisele kasutusloa andmist. Õigusliku aluseta püstitatud ehitisele kasutusloa andmine toimub planeerimis- ja ehitusseaduse (RT I 1995, 59, 1006; 1996, 36, 738; 49, 953; 1999, 27, 380; 29, 398 ja 399) § 70 alusel, kuid sellega ei või rikkuda maa tagastamise õigustatud subjekti õigusi. [Lõike 1 sõnastus alates 1. 01. 2003] (1) Maakasutusõiguseta või ehitusloata püstitatud ehitis või selle osa (juurdeehitis), mis on maaga püsivas ühenduses, on asjaõigusseaduse § 16 kohaselt maatüki oluline osa. Maakasutusõiguse või ehitusloata püstitatud ning omandireformi aluste seaduse ja sellest tulenevate õigusaktide alusel üleantava ehitise või selle osa või teeseaduse (RT I 1999, 26, 377; 93, 831) § 2 2. lõikes nimetatud rajatise suhtes kohaldatakse käesoleva seaduse § 13 sätteid ning ehitist võib käsutada pärast ehitisele kasutusloa andmist. Õigusliku aluseta püstitatud ehitisele kasutusloa andmine toimub ehitusseaduse alusel, kuid sellega ei või rikkuda maa tagastamise õigustatud subjekti õigusi. (1¹) Ehitusloana käesoleva paragrahvi 1. lõike tähenduses käsitletakse ka enne 1991. aasta 1. novembrit koostatud ja kehtinud korras kinnitatud maa ostueesõigusega erastamist taotleva isiku elamu, suvila või aiamaja tüüpprojekti või enne nimetatud tähtpäeva koostatud ja kehtinud korras kinnitatud maa ostueesõigusega erastamist taotleva isiku elamu, suvila või aiamaja ehitusprojekti, kui ehitusloa väljaandmist ei ole võimalik tuvastada. (2) Maa omaniku ja ehitaja vahelistele suhetele kohaldatakse asjaõigusseaduse §-de 138 ja 139 sätteid, välja arvatud käesoleva paragrahvi 1. lõike teises lauses sätestatud ehitise puhul. (3) Käesoleva paragrahvi 1. lõikes nimetatud ehitise olemasolu ei saa olla aluseks selle maa suhtes maareformi seaduse § 6 2. lõike punkti 3 sätete kohaldamisele, välja arvatud käesoleva paragrahvi 1. lõike teises lauses sätestatud ehitise puhul.",
      "rdfs:label": {
        "@value": "AÕSRS_Par_14 (redaktsioon 175989)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "175989",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOSRS_Par_14_v254264"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/175989",
      "estleg:sourceAct": "Asjaõigusseaduse rakendamise seadus",
      "estleg:provisionRef": "AÕSRS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:AOSRS_Map"
      }
    },
    {
      "@id": "estleg:AOSRS_Par_14_v254264",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOSRS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakasutusõiguseta või ehitusloata püstitatud ehitis või selle osa (juurdeehitis), mis on maaga püsivas ühenduses, on asjaõigusseaduse § 16 kohaselt maatüki oluline osa. Maakasutusõiguse või ehitusloata püstitatud ning omandireformi aluste seaduse ja sellest tulenevate õigusaktide alusel üleantava ehitise või selle osa või teeseaduse (RT I 1999, 26, 377; 93, 831) § 2 2. lõikes nimetatud rajatise suhtes kohaldatakse käesoleva seaduse § 13 sätteid ning ehitist võib käsutada pärast ehitisele kasutusloa andmist. Õigusliku aluseta püstitatud ehitisele kasutusloa andmine toimub ehitusseaduse alusel, kuid sellega ei või rikkuda maa tagastamise õigustatud subjekti õigusi. (1¹) Ehitusloana käesoleva paragrahvi 1. lõike tähenduses käsitletakse ka enne 1991. aasta 1. novembrit koostatud ja kehtinud korras kinnitatud maa ostueesõigusega erastamist taotleva isiku elamu, suvila või aiamaja tüüpprojekti või enne nimetatud tähtpäeva koostatud ja kehtinud korras kinnitatud maa ostueesõigusega erastamist taotleva isiku elamu, suvila või aiamaja ehitusprojekti, kui ehitusloa väljaandmist ei ole võimalik tuvastada. [Lõike 2 sõnastus kuni 30. 06. 2003] (2) Maa omaniku ja ehitaja vahelistele suhetele kohaldatakse asjaõigusseaduse §-de 138 ja 139 sätteid, välja arvatud käesoleva paragrahvi 1. lõike teises lauses sätestatud ehitise puhul. [Lõike 2 sõnastus alates 1. 07. 2003] (2) Ehitaja võib esitada maa omaniku suhtes võlaõigusseaduse §-s 1042 sätestatud nõude. Käesoleva paragrahvi 1. lõike teises lauses sätestatud ehitise ehitajal ei ole võlaõigusseaduse §-s 1042 sätestatud nõuet. Kui maatükile on ehitatud maa omaniku nõusolekuta, on omanikul õigus nõuda materjali eemaldamist ehitaja kulul. (3) Käesoleva paragrahvi 1. lõikes nimetatud ehitise olemasolu ei saa olla aluseks selle maa suhtes maareformi seaduse § 6 2. lõike punkti 3 sätete kohaldamisele, välja arvatud käesoleva paragrahvi 1. lõike teises lauses sätestatud ehitise puhul.",
      "rdfs:label": {
        "@value": "AÕSRS_Par_14 (redaktsioon 254264)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254264",
      "estleg:supersededByVersion": {
