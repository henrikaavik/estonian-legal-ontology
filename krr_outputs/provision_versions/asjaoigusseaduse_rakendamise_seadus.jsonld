    },
    {
      "@id": "estleg:AOSRS_Par_11_1_v22263",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOSRS_Par_11_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi omandisse jäetud maa kantakse kinnistusraamatusse Vabariigi Valitsuse poolt määratud valitsusasutuse volitatud isiku kirjaliku kinnistamisavalduse, riigi omandiõigust tõendava dokumendi ja maakatastri andmete alusel. Riigi omandiõigust tõendavaks dokumendiks on ka väljavõte Riigi Teatajast, milles on avaldatud maa riigi omandisse jätmise otsus. (2) Kinnistusamet peab kinnistusregistriosa avamisest teatama ehitise asukohajärgsele riiklikule hooneregistrile.",
      "rdfs:label": {
        "@value": "AÕSRS_Par_11_1 (redaktsioon 22263)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22263",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOSRS_Par_11_1_v175989"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22263",
      "estleg:sourceAct": "Asjaõigusseaduse rakendamise seadus",
      "estleg:provisionRef": "AÕSRS § 11_1",
      "estleg:partOfAct": {
        "@id": "estleg:AOSRS_Map"
      }
    },
    {
      "@id": "estleg:AOSRS_Par_11_1_v175989",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
