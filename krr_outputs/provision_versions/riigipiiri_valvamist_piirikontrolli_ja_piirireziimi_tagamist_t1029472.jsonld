      }
    },
    {
      "@id": "estleg:Reg_1029472_Par_2_v1029472",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029472_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hoiatusmärk käesoleva määruse tähenduses on märk, mis paigaldatakse riigipiiri valvamise, piirikontrolli ja piirirežiimi tagamise hõlbustamiseks. Hoiatusmärk käesoleva määruse tähenduses on märk, mis paigaldatakse riigipiiri valvamise, piirikontrolli ja piirirežiimi tagamise hõlbustamiseks. 2 (2) Lisateatetahvel täpsustab või piirab selle hoiatusmärgi mõju, mille alla see on paigaldatud, ning annab teavet. Lisateatetahvlit võib kasutada eraldi või koos hoiatusmärgiga. Lisateatetahvli kujutis on esitatud käesoleva määruse lisas 1. Lisateatetahvel täpsustab või piirab selle hoiatusmärgi mõju, mille alla see on paigaldatud, ning annab teavet. Lisateatetahvlit võib kasutada eraldi või koos hoiatusmärgiga. Lisateatetahvli kujutis on esitatud käesoleva määruse lisas 1. 3 (3) Lisateatetahvlil olevad sümbolid võib asendada tekstiga, mida võib vajaduse korral muuta. Lisateatetahvlil olevad sümbolid võib asendada tekstiga, mida võib vajaduse korral muuta.",
      "rdfs:label": {
        "@value": "Reg_1029472_Par_2 (redaktsioon 1029472)",
        "@language": "et"
      },
