      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmevahetus teiste andmekogudega toimub avaliku teabe seaduse § 439 lõike 1 punkti 5 alusel kehtestatud korras riigi infosüsteemide andmevahetuskihi kaudu. Andmevahetus teiste andmekogudega toimub avaliku teabe seaduse § 439 lõike 1 punkti 5 alusel kehtestatud korras riigi infosüsteemide andmevahetuskihi kaudu.",
      "rdfs:label": {
        "@value": "Reg_1008322_Par_10 (redaktsioon 1008322)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008322",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008322",
