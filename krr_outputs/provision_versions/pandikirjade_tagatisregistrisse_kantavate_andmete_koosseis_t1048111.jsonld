      },
      "estleg:versionText": "Määrus reguleerib pandikirjade tagatisregistrisse (edaspidi tagatisregister) tehtavate kannete sisu ja koosseisu. Määrus reguleerib pandikirjade tagatisregistrisse (edaspidi tagatisregister) tehtavate kannete sisu ja koosseisu.",
      "rdfs:label": {
        "@value": "Reg_1048111_Par_1 (redaktsioon 1048111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048111",
