      }
    },
    {
      "@id": "estleg:Reg_1048111_Par_2_v1048111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048111_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust kohaldatakse Eestis tegutsevatele krediidiasutustele, kes on saanud Finantsinspektsioonilt täiendava tegevusloa pandikirjade emiteerimiseks. Määrust kohaldatakse Eestis tegutsevatele krediidiasutustele, kes on saanud Finantsinspektsioonilt täiendava tegevusloa pandikirjade emiteerimiseks.",
      "rdfs:label": {
        "@value": "Reg_1048111_Par_2 (redaktsioon 1048111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048111",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048111",
      "estleg:sourceAct": "Pandikirjade tagatisregistrisse kantavate andmete koosseis",
      "estleg:provisionRef": "Reg_1048111 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048111_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048111_Par_3_v1048111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048111_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Emitendil on kohustus tagada, et tagatisregistrist oleksid näha kannete tegemise, nende muutmise, kustutamise või muu töötlemise ajahetked vähemalt sekundi täpsusega. Väljavõtte tegemine peab olema võimalik ka tagasiulatuvalt. Emitendil on kohustus tagada, et tagatisregistrist oleksid näha kannete tegemise, nende muutmise, kustutamise või muu töötlemise ajahetked vähemalt sekundi täpsusega. Väljavõtte tegemine peab olema võimalik ka tagasiulatuvalt.",
      "rdfs:label": {
        "@value": "Reg_1048111_Par_3 (redaktsioon 1048111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048111",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048111",
      "estleg:sourceAct": "Pandikirjade tagatisregistrisse kantavate andmete koosseis",
      "estleg:provisionRef": "Reg_1048111 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048111_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048111_Par_4_v1048111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048111_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pandikirjaseaduse § 25 lõikes 1 ja § 30 lõike 1 punktis 3 nimetatud tagatiste kohta kantakse tagatisregistrisse järgmised andmed: 1 1) krediidi saaja nimi; 2 2) krediidi valuuta; 3 3) tagasi maksmata krediidisumma; 4 4) krediidilepingu kuupäev ja number; 5 5) hüpoteegiga koormatud kinnisasja registriosa number, selle puudumisel lepinguriigi territooriumil asuva kinnisasja katastritunnus või kinnistamisavalduse notariaalse kinnitamise või tõestamise number, või muud samalaadsed andmed kinnisasja kohta; 6 6) hüpoteegiga koormatud kinnisasja aadress; 7 7) hüpoteegiga koormatud kinnisasja pandikirjaseaduse § 28 või § 67 järgi määratud turuväärtus ja turuväärtuse määramise kuupäev; 8 8) hüpoteegisumma; 9 9) krediiti tagava pandiõiguse nimetus kinnistu asukohariigi keeles. Pandikirjaseaduse § 25 lõikes 1 ja § 30 lõike 1 punktis 3 nimetatud tagatiste kohta kantakse tagatisregistrisse järgmised andmed: krediidi saaja nimi; krediidi valuuta; tagasi maksmata krediidisumma; krediidilepingu kuupäev ja number; hüpoteegiga koormatud kinnisasja registriosa number, selle puudumisel lepinguriigi territooriumil asuva kinnisasja katastritunnus või kinnistamisavalduse notariaalse kinnitamise või tõestamise number, või muud samalaadsed andmed kinnisasja kohta; hüpoteegiga koormatud kinnisasja aadress; hüpoteegiga koormatud kinnisasja pandikirjaseaduse § 28 või § 67 järgi määratud turuväärtus ja turuväärtuse määramise kuupäev; hüpoteegisumma; krediiti tagava pandiõiguse nimetus kinnistu asukohariigi keeles. 2 (2) Ühes tagatisvara kandes kajastatakse vaid ühte krediiti. Kui ühte krediiti tagab mitu kinnisasja, kantakse kõik krediiti tagavad kinnisasjad samasse kandese. Kui üks kinnisasi tagab mitut krediiti, tuuakse see kinnisasi välja kõikide krediitide kannetes, mida ta tagab. Ühes tagatisvara kandes kajastatakse vaid ühte krediiti. Kui ühte krediiti tagab mitu kinnisasja, kantakse kõik krediiti tagavad kinnisasjad samasse kandese. Kui üks kinnisasi tagab mitut krediiti, tuuakse see kinnisasi välja kõikide krediitide kannetes, mida ta tagab. 3 (3) Tagatisregistris võib lisaks lõikes 1 nimetatud teabele olla välja toodud ka muu tagatisvara puudutav teave, juhul kui vastava muu teabe kajastamine ei kahjusta tagatisregistri selgust. Tagatisregistris võib lisaks lõikes 1 nimetatud teabele olla välja toodud ka muu tagatisvara puudutav teave, juhul kui vastava muu teabe kajastamine ei kahjusta tagatisregistri selgust.",
      "rdfs:label": {
        "@value": "Reg_1048111_Par_4 (redaktsioon 1048111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048111",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048111",
      "estleg:sourceAct": "Pandikirjade tagatisregistrisse kantavate andmete koosseis",
      "estleg:provisionRef": "Reg_1048111 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048111_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048111_Par_5_v1048111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048111_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pandikirjaseaduse § 30 lõike 1 punktides 4–7 nimetatud tagatiste kohta kantakse tagatisregistrisse järgmised andmed: 1 1) võlgniku nimi või väärtpaberi emitent ja nimetus; 2 2) krediidilepingu number ja sõlmimise kuupäev või väärtpaberi ISIN-kood; 3 3) võlakohustuse valuuta; 4 4) võlakohustuse summa (krediidijääk või väärtpaberi lunastamata põhiosa); 5 5) tagatis, kui see on antud või seatud; 6 6) kui tagatis on antud, siis tagatise andja või tagatiseks olev vara. Pandikirjaseaduse § 30 lõike 1 punktides 4–7 nimetatud tagatiste kohta kantakse tagatisregistrisse järgmised andmed: võlgniku nimi või väärtpaberi emitent ja nimetus; krediidilepingu number ja sõlmimise kuupäev või väärtpaberi ISIN-kood; võlakohustuse valuuta; võlakohustuse summa (krediidijääk või väärtpaberi lunastamata põhiosa); tagatis, kui see on antud või seatud; kui tagatis on antud, siis tagatise andja või tagatiseks olev vara. 2 (2) Tagatisregistris võib lisaks lõikes 1 nimetatud teabele olla välja toodud ka muu tagatisvara puudutav teave, juhul kui vastava muu teabe kajastamine ei kahjusta tagatisregistri selgust. Tagatisregistris võib lisaks lõikes 1 nimetatud teabele olla välja toodud ka muu tagatisvara puudutav teave, juhul kui vastava muu teabe kajastamine ei kahjusta tagatisregistri selgust.",
      "rdfs:label": {
        "@value": "Reg_1048111_Par_5 (redaktsioon 1048111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048111",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048111",
      "estleg:sourceAct": "Pandikirjade tagatisregistrisse kantavate andmete koosseis",
      "estleg:provisionRef": "Reg_1048111 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048111_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048111_Par_6_v1048111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048111_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pandikirjaseaduse § 23 lõikes 1 nimetatud tuletisinstrumentidest tulenevate nõuete ja kohustuste kohta peetavasse tagatisregistrisse tuleb kanda järgmised andmed: 1 1) tuletisinstrumendi nimetus vastavalt sellele kohalduvale raamlepingule ja raamlepingu keeles; 2 2) tehingu number või selle puudumisel tehingu identifitseerimist võimaldav muu teave; 3 3) tehingupäev; 4 4) tuletisinstrumendi algus- ja lõppkuupäev; 5 5) tehingule kohalduva raamlepingu kuupäev ja number või nende puudumisel raamlepingu identifitseerimist võimaldav muu teave; 6 6) nimivaluuta; 7 7) nimiväärtus; 8 8) teine nimivaluuta, kui see eksisteerib; 9 9) teine nimiväärtus, kui see eksisteerib; 10 10) fikseeritud intressimäär; 11 11) fikseerimata intressimäär; 12 12) nüüdispuhasväärtus; 13 13) nüüdispuhasväärtuse valuuta. Pandikirjaseaduse § 23 lõikes 1 nimetatud tuletisinstrumentidest tulenevate nõuete ja kohustuste kohta peetavasse tagatisregistrisse tuleb kanda järgmised andmed: tuletisinstrumendi nimetus vastavalt sellele kohalduvale raamlepingule ja raamlepingu keeles; tehingu number või selle puudumisel tehingu identifitseerimist võimaldav muu teave; tehingupäev; tuletisinstrumendi algus- ja lõppkuupäev; tehingule kohalduva raamlepingu kuupäev ja number või nende puudumisel raamlepingu identifitseerimist võimaldav muu teave; nimivaluuta; nimiväärtus; teine nimivaluuta, kui see eksisteerib; teine nimiväärtus, kui see eksisteerib; fikseeritud intressimäär; fikseerimata intressimäär; nüüdispuhasväärtus; nüüdispuhasväärtuse valuuta. 2 (2) Tagatisregistris võib lisaks lõikes 1 nimetatud teabele olla välja toodud ka muu tagatisvara puudutav teave, juhul kui vastava muu teabe kajastamine ei kahjusta tagatisregistri selgust. Tagatisregistris võib lisaks lõikes 1 nimetatud teabele olla välja toodud ka muu tagatisvara puudutav teave, juhul kui vastava muu teabe kajastamine ei kahjusta tagatisregistri selgust.",
      "rdfs:label": {
        "@value": "Reg_1048111_Par_6 (redaktsioon 1048111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048111",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048111",
      "estleg:sourceAct": "Pandikirjade tagatisregistrisse kantavate andmete koosseis",
      "estleg:provisionRef": "Reg_1048111 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048111_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048111_Par_7_v1048111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048111_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pandikirjaseaduse § 20 lõike 1 punktides 1–6 ja § 21 lõikes 1 nimetatud tagatiste kohta tuleb tagatisregistrisse kanda järgmised andmed: 1 1) võlgniku või hoiusevõtja nimi või väärtpaberi emitent ja nimetus; 2 2) krediidilepingu number ja kuupäev, hoiusetehingu number ja kuupäev või väärtpaberi ISIN-kood; 3 3) krediidi, hoiuse või väärtpaberi valuuta; 4 4) krediidijääk, hoiusumma või väärtpaberi lunastamata põhiosa; 5 5) märkused. Pandikirjaseaduse § 20 lõike 1 punktides 1–6 ja § 21 lõikes 1 nimetatud tagatiste kohta tuleb tagatisregistrisse kanda järgmised andmed: võlgniku või hoiusevõtja nimi või väärtpaberi emitent ja nimetus; krediidilepingu number ja kuupäev, hoiusetehingu number ja kuupäev või väärtpaberi ISIN-kood; krediidi, hoiuse või väärtpaberi valuuta; krediidijääk, hoiusumma või väärtpaberi lunastamata põhiosa; märkused. 2 (2) Tagatisregistrites võib lisaks lõikes 1 nimetatud teabele olla välja toodud ka muu tagatisvara puudutav teave, juhul kui vastava muu teabe kajastamine ei kahjusta tagatisregistri selgust. Tagatisregistrites võib lisaks lõikes 1 nimetatud teabele olla välja toodud ka muu tagatisvara puudutav teave, juhul kui vastava muu teabe kajastamine ei kahjusta tagatisregistri selgust.",
      "rdfs:label": {
        "@value": "Reg_1048111_Par_7 (redaktsioon 1048111)",
        "@language": "et"
      },
