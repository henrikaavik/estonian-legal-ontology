      "estleg:sourceAct": "Riigi õigusabi infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_1052190 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052190_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1052190_Par_9_v1052190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052190_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Infosüsteemis säilitatakse andmeid kolm aastat pärast riigi õigusabi tellimuse lõpetatuks märkimist. Infosüsteemis säilitatakse andmeid kolm aastat pärast riigi õigusabi tellimuse lõpetatuks märkimist. 2 (2) Infosüsteemi andmete töötlemise logisid säilitatakse üks aasta. Infosüsteemi andmete töötlemise logisid säilitatakse üks aasta. 3 (3) RIK tagab säilitamistähtaja möödumisel andmete kustutamise. RIK tagab säilitamistähtaja möödumisel andmete kustutamise.",
      "rdfs:label": {
