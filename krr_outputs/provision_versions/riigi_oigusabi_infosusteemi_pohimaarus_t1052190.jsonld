    {
      "@id": "estleg:Reg_1052190_Par_2_v1052190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052190_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi õigusabi infosüsteem on riigi õigusabi osutamise korraldamiseks peetav riigi infosüsteemi kuuluv andmekogu, mille eesmärk on: 1 1) riigi õigusabi osutaja nimetamiseks andmete elektrooniline haldamine; 2 2) riigi õigusabi tasu maksmise ja kulude hüvitamise elektrooniline haldamine; 3 3) advokatuuri liikmete andmete elektroonilise kättesaadavuse võimaldamine; 4 4) riigi õigusabi teenuse kiirema kättesaadavuse tagamine; 5 5) statistilise ülevaate saamine riigi õigusabi teenuse osutamisest. Riigi õigusabi infosüsteem on riigi õigusabi osutamise korraldamiseks peetav riigi infosüsteemi kuuluv andmekogu, mille eesmärk on: riigi õigusabi osutaja nimetamiseks andmete elektrooniline haldamine; riigi õigusabi tasu maksmise ja kulude hüvitamise elektrooniline haldamine; advokatuuri liikmete andmete elektroonilise kättesaadavuse võimaldamine; riigi õigusabi teenuse kiirema kättesaadavuse tagamine; statistilise ülevaate saamine riigi õigusabi teenuse osutamisest.",
      "rdfs:label": {
        "@value": "Reg_1052190_Par_2 (redaktsioon 1052190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052190",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052190",
      "estleg:sourceAct": "Riigi õigusabi infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_1052190 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052190_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1052190_Par_3_v1052190",
      "@type": [
        "owl:NamedIndividual",
