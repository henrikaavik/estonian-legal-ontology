      "estleg:provisionRef": "Reg_1031369 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031369_Map"
      }
    },
    {
      "@id": "estleg:Reg_1031369_Par_2_v1031369",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
