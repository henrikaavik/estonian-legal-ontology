      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded krüptomaterjalidele, nende töötlemisele ja kaitsmisele (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded krüptomaterjalidele, nende töötlemisele ja kaitsmisele"
    },
    {
      "@id": "estleg:Reg_1031369_Par_1_v1031369",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031369_Par_1"
