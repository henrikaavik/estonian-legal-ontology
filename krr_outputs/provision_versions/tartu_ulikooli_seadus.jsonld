    {
      "@id": "estleg:TÜKS_Par_6_v22320",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜKS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ülikooli raamatukogu on ülikooli koosseisus olev riiklik universaalne teadusraamatukogu, mille ülesanne on infoteenuste osutamine, Eesti rahvustrükiste täieliku kogu loomine ja säilitamine ning ülikooli liikmeskonna teenindamine. (2) Ülikooli raamatukogu tegutseb seaduse ja oma põhikirja alusel. Põhikirja kinnitab ülikooli nõukogu.",
      "rdfs:label": {
        "@value": "TÜKS_Par_6 (redaktsioon 22320)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22320",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜKS_Par_6_v186692"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22320",
      "estleg:sourceAct": "Tartu Ülikooli seadus",
      "estleg:provisionRef": "TÜKS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:TÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:TÜKS_Par_6_v186692",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
