      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülikool on oma vara omanik, kes valdab, kasutab ja käsutab oma vara käesolevas seaduses ja oma põhikirjas sätestatud ulatuses ja korras.",
      "rdfs:label": {
        "@value": "TÜKS_Par_8 (redaktsioon 22320)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22320",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜKS_Par_8_v186692"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22320",
      "estleg:sourceAct": "Tartu Ülikooli seadus",
      "estleg:provisionRef": "TÜKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:TÜKS_Par_8_v186692",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülikool on oma vara omanik, kesvaldab, kasutab ja käsutab oma vara käesolevasseaduses ja oma põhikirjassätestatudulatuses ja korras.",
      "rdfs:label": {
        "@value": "TÜKS_Par_8 (redaktsioon 186692)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186692",
      "estleg:supersededByVersion": {
