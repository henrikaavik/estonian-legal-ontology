      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/186692",
      "estleg:sourceAct": "Tartu Ülikooli seadus",
      "estleg:provisionRef": "TÜKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:TÜKS_Par_8_v215009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
