        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/186692",
      "estleg:sourceAct": "Tartu Ülikooli seadus",
      "estleg:provisionRef": "TÜKS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:TÜKS_Map_2026"
      }
    },
