      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "TÜKS_Par_14 (redaktsioon 13001698)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13001698",
