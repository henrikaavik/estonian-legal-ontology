      "estleg:provisionRef": "TÜKS § 7_2",
      "estleg:partOfAct": {
        "@id": "estleg:TÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:TÜKS_Par_7_2_v111032023091",
      "@type": [
        "owl:NamedIndividual",
