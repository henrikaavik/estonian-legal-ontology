        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab Tartu Ülikooli õigusliku seisundi, eesmärgi ja autonoomia piirid ning juhtimise, rahastamise ja tegevuse alused.",
      "rdfs:label": {
        "@value": "TÜKS_Par_1 (redaktsioon 119032019091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019091",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019091",
