    {
      "@id": "estleg:Reg_1049017_Par_15_v1049017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049017_Par_15"
