      }
    },
    {
      "@id": "estleg:Reg_1049017_Par_5_v1049017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049017_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse maksimaalne suurus on 32 000 eurot ja § 7 lõikes 8 nimetatud tegevustoetuse puhul 20 000 eurot. Projekti minimaalne toetuse suurus on 3200 eurot. Toetuse maksimaalne suurus on 32 000 eurot ja § 7 lõikes 8 nimetatud tegevustoetuse puhul 20 000 eurot. Projekti minimaalne toetuse suurus on 3200 eurot. 2 (2) Toetuse määr on kuni 85 protsenti projekti abikõlblikest kuludest. Paragrahvi 7 lõike 3 punktis 1 nimetatud ettevõtlusnõustamise tugiteenuse osutamise ja § 7 lõikes 10 nimetatud välisabi projekti kaasfinantseerimise toetuse taotlemise korral on toetuse määr kuni 100 protsenti projekti abikõlblikest kuludest. Toetuse määr on kuni 85 protsenti projekti abikõlblikest kuludest. Paragrahvi 7 lõike 3 punktis 1 nimetatud ettevõtlusnõustamise tugiteenuse osutamise ja § 7 lõikes 10 nimetatud välisabi projekti kaasfinantseerimise toetuse taotlemise korral on toetuse määr kuni 100 protsenti projekti abikõlblikest kuludest. 3 (3) Oma- või kaasfinantseering peavad moodustama vähemalt 15 protsenti projekti abikõlblikest kuludest. Oma- või kaasfinantseering ei ole nõutav § 7 lõike 3 punktis 1 nimetatud ettevõtlusnõustamise tugiteenuse osutamise ja § 7 lõikes 10 nimetatud välisabi projekti kaasfinantseerimise toetuse taotlemise korral. Oma- või kaasfinantseering peavad moodustama vähemalt 15 protsenti projekti abikõlblikest kuludest. Oma- või kaasfinantseering ei ole nõutav § 7 lõike 3 punktis 1 nimetatud ettevõtlusnõustamise tugiteenuse osutamise ja § 7 lõikes 10 nimetatud välisabi projekti kaasfinantseerimise toetuse taotlemise korral.",
      "rdfs:label": {
        "@value": "Reg_1049017_Par_5 (redaktsioon 1049017)",
        "@language": "et"
      },
