    {
      "@id": "estleg:Reg_1002190_Par_5_v1002190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002190_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tunnistuse andmelehe plank on A4 formaadis leht, mille ühele või mõlemale küljele kantakse määruse §-s 3 nimetatud andmed. Tunnistuse andmelehe plank on A4 formaadis leht, mille ühele või mõlemale küljele kantakse määruse §-s 3 nimetatud andmed.",
      "rdfs:label": {
        "@value": "Reg_1002190_Par_5 (redaktsioon 1002190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002190",
