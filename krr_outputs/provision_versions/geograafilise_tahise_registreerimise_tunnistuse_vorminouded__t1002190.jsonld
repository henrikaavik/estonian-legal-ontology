        "@type": "xsd:date"
      },
      "estleg:versionText": "Geograafilise tähise registreerimise tunnistus (edaspidi tunnistus) koosneb kaantest ja andmelehest. Geograafilise tähise registreerimise tunnistus (edaspidi tunnistus) koosneb kaantest ja andmelehest.",
      "rdfs:label": {
        "@value": "Reg_1002190_Par_1 (redaktsioon 1002190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002190",
