    {
      "@id": "estleg:Reg_158947_Par_4_v158947",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158947_Par_4"
