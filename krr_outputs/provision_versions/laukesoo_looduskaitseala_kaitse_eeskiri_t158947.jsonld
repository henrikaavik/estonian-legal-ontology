      }
    },
    {
      "@id": "estleg:Reg_158947_Par_9_v158947",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158947_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud:11)hooldustööd kaitsealuste liikide elutingimuste säilitamiseks;22)olemasolevate metsasihtide, teede, sildade, purrete ja maaparandussüsteemide hooldustööd. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: hooldustööd kaitsealuste liikide elutingimuste säilitamiseks; olemasolevate metsasihtide, teede, sildade, purrete ja maaparandussüsteemide hooldustööd.",
      "rdfs:label": {
