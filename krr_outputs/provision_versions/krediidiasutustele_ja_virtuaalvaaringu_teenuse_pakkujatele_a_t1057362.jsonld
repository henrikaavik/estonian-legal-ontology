      "estleg:provisionRef": "Reg_1057362 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057362_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057362_Par_6_v1057362",
