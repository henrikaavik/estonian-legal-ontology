    {
      "@id": "estleg:Reg_1029842_Par_29_v1029842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029842_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rõdu ja lodža, sealhulgas ka välisõhust avatäitega eraldatud rõdu ja lodža pinnaks loetakse nende suurim võimalik pind. Rõdu ja lodža, sealhulgas ka välisõhust avatäitega eraldatud rõdu ja lodža pinnaks loetakse nende suurim võimalik pind. 2 (2) Rõdu ja lodža suurima võimaliku pinna määramisel ei arvata maha käsipuu, astme ja muu sarnase alla jäävaid pindasid. Rõdu ja lodža suurima võimaliku pinna määramisel ei arvata maha käsipuu, astme ja muu sarnase alla jäävaid pindasid.",
      "rdfs:label": {
