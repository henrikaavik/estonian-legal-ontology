      "estleg:sourceAct": "Ehitise tehniliste andmete loetelu ja arvestamise alused",
      "estleg:provisionRef": "Reg_1029842 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029842_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029842_Par_23_v1029842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
