      }
    },
    {
      "@id": "estleg:Reg_1029842_Par_27_v1029842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029842_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Üldkasutatav pind on hoone kasutajate ühises kasutuses oleva või ühisesse kasutusse kavandatud ruumi või hoone osa suletud netopind. Üldkasutatav pind on hoone kasutajate ühises kasutuses oleva või ühisesse kasutusse kavandatud ruumi või hoone osa suletud netopind. 2 (2) Üldkasutatav pind on sealhulgas ühises kasutuses olev: 1 1) ühendustee, nagu trepikoda, koridor, liftišaht; 2 2) olmeruum, nagu puhkeruum, koristustarvete ruum, saun, duširuum, riietusruum, tualett; 3 3) kelder või keldriboks; 4 4) hoones asuv parkimiskoht ja muu taoline. Üldkasutatav pind on sealhulgas ühises kasutuses olev: ühendustee, nagu trepikoda, koridor, liftišaht; olmeruum, nagu puhkeruum, koristustarvete ruum, saun, duširuum, riietusruum, tualett; kelder või keldriboks; hoones asuv parkimiskoht ja muu taoline. 3 (3) Ainukasutuses oleva hoones, nagu ühepereelamus, loetakse üldkasutatavaks pinnaks ka ainukasutuses olev pind, mis asub väljaspool eluruumi koosseisu, nagu kelder, garaaž, parkimiskoht ja muu taoline. Ainukasutuses oleva hoones, nagu ühepereelamus, loetakse üldkasutatavaks pinnaks ka ainukasutuses olev pind, mis asub väljaspool eluruumi koosseisu, nagu kelder, garaaž, parkimiskoht ja muu taoline. 4 (4) Hoone üldkasutatava pinna hulka ei kuulu tehnopind. Hoone üldkasutatava pinna hulka ei kuulu tehnopind.",
      "rdfs:label": {
        "@value": "Reg_1029842_Par_27 (redaktsioon 1029842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029842",
      "estleg:sourceAct": "Ehitise tehniliste andmete loetelu ja arvestamise alused",
      "estleg:provisionRef": "Reg_1029842 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029842_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029842_Par_28_v1029842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
