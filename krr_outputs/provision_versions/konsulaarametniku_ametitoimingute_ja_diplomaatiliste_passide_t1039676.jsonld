      "estleg:provisionRef": "Reg_1039676 § 41",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039676_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039676_Par_42_v1039676",
      "@type": [
        "owl:NamedIndividual",
