      "estleg:sourceAct": "Konsulaarametniku ametitoimingute ja diplomaatiliste passide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039676 § 48",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039676_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039676_Par_49_v1039676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039676_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu hooldus- ja arendustöid ning andmekogu pidamist rahastatakse igal aastal riigieelarvest Välisministeeriumile eraldatud vahenditest. Andmekogu hooldus- ja arendustöid ning andmekogu pidamist rahastatakse igal aastal riigieelarvest Välisministeeriumile eraldatud vahenditest.",
      "rdfs:label": {
        "@value": "Reg_1039676_Par_49 (redaktsioon 1039676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039676",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039676",
      "estleg:sourceAct": "Konsulaarametniku ametitoimingute ja diplomaatiliste passide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039676 § 49",
