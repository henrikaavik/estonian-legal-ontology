      "estleg:provisionRef": "Reg_1039676 § 47",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039676_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039676_Par_48_v1039676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
