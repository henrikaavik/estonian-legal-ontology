      "estleg:versionValidFrom": {
        "@value": "2025-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu pidamise seaduslikkuse järele valvavad Riigi Infosüsteemi Amet, Andmekaitse Inspektsioon ja vastutava töötleja ametnikud oma pädevuse piires. RT I 2019-09-04 2 104092019002 2019-09-07 Andmekogu pidamise seaduslikkuse järele valvavad Riigi Infosüsteemi Amet, Andmekaitse Inspektsioon ja vastutava töötleja ametnikud oma pädevuse piires.",
      "rdfs:label": {
        "@value": "Reg_1039676_Par_48 (redaktsioon 1039676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039676",
