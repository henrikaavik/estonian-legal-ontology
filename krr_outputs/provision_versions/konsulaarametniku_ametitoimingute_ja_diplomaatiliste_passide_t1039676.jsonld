        "@id": "estleg:Reg_1039676_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039676_Par_5_v1039676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039676_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogusse kantakse andmed järgmiste teenuste ja toimingute kohta: 1 1) konsulaarametniku vastuvõtule registreerimine; 2 2) tõendi andmine; 3 3) tõestamistoiming; 4 4) tõestamistoiming Välisministeeriumi osalusel; 5 5) ametlik kinnitamine; 6 6) avaliku dokumendi legaliseerimine; 7 7) Eesti laeva suhtes tehtav toiming; 8 8) tõlketeenus; 9 9) välisriigis ajutise viibimise või püsiva elukoha registreerimine; 10 10) Euroopa Liidu tagasipöördumistunnistuse andmine; RT I 2025-01-14 5 114012025005 2025-12-09 11 11) kehtetu - RT I 2025-01-14 5 114012025005 2025-12-09 12 12) foto tellimine; 13 13) konsulaarabi andmine; 14 14) kehtetu - RT I 2019-06-18 5 118062019005 2019-06-21 15 15) kodakondsusest vabastamisega seotud toiming; 16 16) laevaloa taotlemine; 17 17) lennuloa taotlemine; 18 18) dokumendi, sealhulgas dokumendi tunnistusega kinnitamise tellimine; 19 19) dokumendi edastamine; 20 20) juhiloa, rahvusvahelise juhiloa, esmase juhiloa ja duplikaadi väljastamine; 21 21) dokumendi väljastamine ametiabi korras; 22 22) Eesti kodaniku passi ja isikutunnistuse väljaandmise taotluse edastamine ning passi ja isikutunnistuse väljastamine; 23 23) digitaalse isikutunnistuse väljastamine; RT I 2025-10-29 1 129102025001 2025-11-01 24 24) elamisloa, elamisõiguse ning elamisloakaardi taotluse edastamine ning elamisloa ja elamisõigust tõendava dokumendi ning elamisloakaardi väljastamine; 25 25) kehtetu - RT I 2019-06-18 5 118062019005 2019-06-21 26 26) rahvastikuregistritoiming; 27 27) vaidemenetlus; 28 28) aukonsuli toiming; 29 29) PIN-ümbriku väljastamine. RT I 2025-10-29 1 129102025001 2025-11-15 Andmekogusse kantakse andmed järgmiste teenuste ja toimingute kohta: konsulaarametniku vastuvõtule registreerimine; tõendi andmine; tõestamistoiming; tõestamistoiming Välisministeeriumi osalusel; ametlik kinnitamine; avaliku dokumendi legaliseerimine; Eesti laeva suhtes tehtav toiming; tõlketeenus; välisriigis ajutise viibimise või püsiva elukoha registreerimine; Euroopa Liidu tagasipöördumistunnistuse andmine; kehtetu - foto tellimine; konsulaarabi andmine; kehtetu - kodakondsusest vabastamisega seotud toiming; laevaloa taotlemine; lennuloa taotlemine; dokumendi, sealhulgas dokumendi tunnistusega kinnitamise tellimine; dokumendi edastamine; juhiloa, rahvusvahelise juhiloa, esmase juhiloa ja duplikaadi väljastamine; dokumendi väljastamine ametiabi korras; Eesti kodaniku passi ja isikutunnistuse väljaandmise taotluse edastamine ning passi ja isikutunnistuse väljastamine; digitaalse isikutunnistuse väljastamine; elamisloa, elamisõiguse ning elamisloakaardi taotluse edastamine ning elamisloa ja elamisõigust tõendava dokumendi ning elamisloakaardi väljastamine; kehtetu - rahvastikuregistritoiming; vaidemenetlus; aukonsuli toiming; PIN-ümbriku väljastamine.",
      "rdfs:label": {
        "@value": "Reg_1039676_Par_5 (redaktsioon 1039676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039676",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039676",
      "estleg:sourceAct": "Konsulaarametniku ametitoimingute ja diplomaatiliste passide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039676 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039676_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039676_Par_50_v1039676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
