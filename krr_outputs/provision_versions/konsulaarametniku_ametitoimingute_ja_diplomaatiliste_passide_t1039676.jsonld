    {
      "@id": "estleg:Reg_1039676_Par_29_v1039676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039676_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu - RT I 2025-10-29 1 129102025001 2025-11-01 Kehtetu - 2 (2) Digitaalse isikutunnistuse väljastamisel kantakse andmekogusse järgmised lisaandmed: 1 1) märge dokumendi omaniku kohta (e-resident); 2 2) Politsei- ja Piirivalveameti dokumendi taotluse number; 3 3) taotluse esitaja (taotleja, tema vanema või seadusliku esindaja) ees- ja perekonnanimi, isikukood ja/või sünniaeg; 4 4) taotluse esitaja kontaktandmed (telefoninumber ja e-posti aadress); 5 5) märge isiku tuvastamise kohta ja isiku tuvastanud ametniku andmed; 6 6) taotluse esitaja isikut tõendava dokumendi number; 6 6¹) sõrmejäljekujutised; 6 6²) andmed isikult sõrmejälgede võtmise võimatuse kohta; 7 7) väljastatava digitaalse isikutunnistuse number; 8 8) väljastamise kuupäev. RT I 2025-10-29 1 129102025001 2025-11-01 Digitaalse isikutunnistuse väljastamisel kantakse andmekogusse järgmised lisaandmed: märge dokumendi omaniku kohta (e-resident); Politsei- ja Piirivalveameti dokumendi taotluse number; taotluse esitaja (taotleja, tema vanema või seadusliku esindaja) ees- ja perekonnanimi, isikukood ja/või sünniaeg; taotluse esitaja kontaktandmed (telefoninumber ja e-posti aadress); märge isiku tuvastamise kohta ja isiku tuvastanud ametniku andmed; taotluse esitaja isikut tõendava dokumendi number; sõrmejäljekujutised; andmed isikult sõrmejälgede võtmise võimatuse kohta; väljastatava digitaalse isikutunnistuse number; väljastamise kuupäev.",
      "rdfs:label": {
        "@value": "Reg_1039676_Par_29 (redaktsioon 1039676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039676",
