      "estleg:versionValidFrom": {
        "@value": "2025-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogusse kantakse andmed väljastatud diplomaatiliste passide, nende kasutajate ning diplomaatiliste passide väljaandmise, kehtivuse ja tagastamise, samuti diplomaatiliste passide numbri kohta. RT I 2019-06-18 5 118062019005 2019-06-21 Andmekogusse kantakse andmed väljastatud diplomaatiliste passide, nende kasutajate ning diplomaatiliste passide väljaandmise, kehtivuse ja tagastamise, samuti diplomaatiliste passide numbri kohta.",
      "rdfs:label": {
        "@value": "Reg_1039676_Par_35_35 (redaktsioon 1039676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039676",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039676",
      "estleg:sourceAct": "Konsulaarametniku ametitoimingute ja diplomaatiliste passide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039676 § 35_35",
