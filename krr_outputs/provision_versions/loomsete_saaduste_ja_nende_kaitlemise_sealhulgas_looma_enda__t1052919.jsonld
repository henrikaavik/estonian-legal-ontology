      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sealt või metssealt pärit loomsed saadused märgistatakse komisjoni rakendusmääruse (EL) 2023/594, millega kehtestatakse sigade Aafrika katku tõrje erimeetmed ja tunnistatakse kehtetuks rakendusmäärus (EL) 2021/605 (ELT L 79, 17.03.2023, lk 65–150), artikli 47 kohaselt. RT I 2023-10-26 5 126102023005 2023-10-29 Sealt või metssealt pärit loomsed saadused märgistatakse komisjoni rakendusmääruse (EL) 2023/594, millega kehtestatakse sigade Aafrika katku tõrje erimeetmed ja tunnistatakse kehtetuks rakendusmäärus (EL) 2021/605 (ELT L 79, 17.03.2023, lk 65–150), artikli 47 kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1052919_Par_2 (redaktsioon 1052919)",
        "@language": "et"
      },
