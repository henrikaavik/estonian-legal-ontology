        "@id": "estleg:Reg_1042855_Map"
      }
    },
    {
      "@id": "estleg:Reg_1042855_Par_12_v1042855",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042855_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus makstakse välja toetuse saajale 10 tööpäeva jooksul pärast rahuldamise otsuse tegemist vastavalt rahuldamise otsuses sätestatud tingimustele. Toetus makstakse välja toetuse saajale 10 tööpäeva jooksul pärast rahuldamise otsuse tegemist vastavalt rahuldamise otsuses sätestatud tingimustele.",
      "rdfs:label": {
        "@value": "Reg_1042855_Par_12 (redaktsioon 1042855)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042855",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042855",
      "estleg:sourceAct": "Välisvärbamise toetuse taotlemise ja kasutamise tingimused ning kord",
      "estleg:provisionRef": "Reg_1042855 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042855_Map"
      }
    },
    {
      "@id": "estleg:Reg_1042855_Par_13_v1042855",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042855_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse saajal on õigus saada Ettevõtluse ja Innovatsiooni Sihtasutuselt informatsiooni ja nõuandeid, mis on seotud käesoleva määruse alusel toetuse taotlemisega ja seonduvate protseduuridega. Toetuse saajal on õigus saada Ettevõtluse ja Innovatsiooni Sihtasutuselt informatsiooni ja nõuandeid, mis on seotud käesoleva määruse alusel toetuse taotlemisega ja seonduvate protseduuridega. 2 (2) Toetuse saaja kohustub: 1 1) tagastama toetuse, kui Ettevõtluse ja Innovatsiooni Sihtasutus nõuab toetuse saajalt toetuse osaliselt või täielikult tagasi; 2 2) esitama Ettevõtluse ja Innovatsiooni Sihtasutuse nõutud informatsiooni ettenähtud vormil, viisil ja tähtajal; 3 3) teavitama avalikkust Ettevõtluse ja Innovatsiooni Sihtasutuse etteantud viisil, et ta on käesoleva määruse alusel toetust saanud; 4 4) kajastama saadud toetust oma raamatupidamisarvestuses; 5 5) säilitama vastavalt raamatupidamise seaduse §-le 12 taotluse, toetuse ja projekti teostamisega seonduvat dokumentatsiooni ja materjale seitse aastat; 6 6) viivitamatult kirjalikult informeerima Ettevõtluse ja Innovatsiooni Sihtasutust kõigist esitatud andmetes toimunud muudatustest või asjaoludest, mis mõjutavad või võivad mõjutada toetuse saamist. Toetuse saaja kohustub: tagastama toetuse, kui Ettevõtluse ja Innovatsiooni Sihtasutus nõuab toetuse saajalt toetuse osaliselt või täielikult tagasi; esitama Ettevõtluse ja Innovatsiooni Sihtasutuse nõutud informatsiooni ettenähtud vormil, viisil ja tähtajal; teavitama avalikkust Ettevõtluse ja Innovatsiooni Sihtasutuse etteantud viisil, et ta on käesoleva määruse alusel toetust saanud; kajastama saadud toetust oma raamatupidamisarvestuses; säilitama vastavalt raamatupidamise seaduse §-le 12 taotluse, toetuse ja projekti teostamisega seonduvat dokumentatsiooni ja materjale seitse aastat; viivitamatult kirjalikult informeerima Ettevõtluse ja Innovatsiooni Sihtasutust kõigist esitatud andmetes toimunud muudatustest või asjaoludest, mis mõjutavad või võivad mõjutada toetuse saamist.",
      "rdfs:label": {
        "@value": "Reg_1042855_Par_13 (redaktsioon 1042855)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042855",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042855",
      "estleg:sourceAct": "Välisvärbamise toetuse taotlemise ja kasutamise tingimused ning kord",
      "estleg:provisionRef": "Reg_1042855 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042855_Map"
      }
    },
    {
      "@id": "estleg:Reg_1042855_Par_14_v1042855",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042855_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ettevõtluse ja Innovatsiooni Sihtasutusel on õigus: 1 1) kontrollida esitatud informatsiooni ja dokumentide paikapidavust; 2 2) nõuda toetus osaliselt või täielikult tagasi, kui selgub, et toetuse saaja on toetuse saamiseks esitanud ebaõigeid andmeid. Ettevõtluse ja Innovatsiooni Sihtasutusel on õigus: kontrollida esitatud informatsiooni ja dokumentide paikapidavust; nõuda toetus osaliselt või täielikult tagasi, kui selgub, et toetuse saaja on toetuse saamiseks esitanud ebaõigeid andmeid. 2 (2) Ettevõtluse ja Innovatsiooni Sihtasutus kohustub: 1 1) nõustama taotlejaid projektiga seotud küsimustes; 2 2) tegema taotlusvormi ja asjakohased juhendmaterjalid kättesaadavaks oma veebilehel; 3 3) hoidma konfidentsiaalsena informatsiooni, mis on teatavaks saanud taotluse menetlemise käigus, välja arvatud punktis 5 nimetatud informatsioon ja õigusaktides sätestatud juhud; 4 4) säilitama toetuse andmisega seotud dokumente 10 aastat viimase abi andmise otsusest arvates; 5 5) pärast rahuldamise otsust tegema oma veebilehel kättesaadavaks toetuse saaja nime, taotluse nimetuse ning toetuse summa. Ettevõtluse ja Innovatsiooni Sihtasutus kohustub: nõustama taotlejaid projektiga seotud küsimustes; tegema taotlusvormi ja asjakohased juhendmaterjalid kättesaadavaks oma veebilehel; hoidma konfidentsiaalsena informatsiooni, mis on teatavaks saanud taotluse menetlemise käigus, välja arvatud punktis 5 nimetatud informatsioon ja õigusaktides sätestatud juhud; säilitama toetuse andmisega seotud dokumente 10 aastat viimase abi andmise otsusest arvates; pärast rahuldamise otsust tegema oma veebilehel kättesaadavaks toetuse saaja nime, taotluse nimetuse ning toetuse summa.",
      "rdfs:label": {
        "@value": "Reg_1042855_Par_14 (redaktsioon 1042855)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042855",
