    {
      "@id": "estleg:Reg_1035942_Par_6_v1035942",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035942_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskusel on õigus jätta X-teega liitumise taotlus rahuldamata, kui: 1 1) taotlejal puudub unikaalne tunnus, millele on võimalik väljastada keskuse veebilehel avalikustatud nõuetele vastavat e-templi sertifikaati; 2 2) taotleja ei ole keskuse nõudmisel esitanud esindusõiguse tuvastamiseks vajalikke dokumente või taotluse esitajal puudub esindusõigus taotluse esitamiseks; 3 3) taotleja esitatud andmed ei ole tõesed; RT I 2019-08-06 6 106082019006 2019-08-09 4 4) taotleja või tema infosüsteem ei vasta käesolevas määruses esitatud muudele nõuetele või X-tee toimimise põhimõtetele. Keskusel on õigus jätta X-teega liitumise taotlus rahuldamata, kui: taotlejal puudub unikaalne tunnus, millele on võimalik väljastada keskuse veebilehel avalikustatud nõuetele vastavat e-templi sertifikaati; taotleja ei ole keskuse nõudmisel esitanud esindusõiguse tuvastamiseks vajalikke dokumente või taotluse esitajal puudub esindusõigus taotluse esitamiseks; taotleja esitatud andmed ei ole tõesed; taotleja või tema infosüsteem ei vasta käesolevas määruses esitatud muudele nõuetele või X-tee toimimise põhimõtetele.",
      "rdfs:label": {
        "@value": "Reg_1035942_Par_6 (redaktsioon 1035942)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035942",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035942",
      "estleg:sourceAct": "Infosüsteemide andmevahetuskiht",
      "estleg:provisionRef": "Reg_1035942 § 6",
