    {
      "@id": "estleg:Reg_1057888_Par_14_v1057888",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057888_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on metsakoosluste elustiku mitmekesisuse, poollooduslike koosluste ja kaitsealuste liikide kaitse. Piiranguvööndi kaitse-eesmärk on metsakoosluste elustiku mitmekesisuse, poollooduslike koosluste ja kaitsealuste liikide kaitse.",
      "rdfs:label": {
        "@value": "Reg_1057888_Par_14 (redaktsioon 1057888)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057888",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057888",
      "estleg:sourceAct": "Sõrve looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1057888 § 14",
