    {
      "@id": "estleg:Reg_1057888_Par_3_v1057888",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057888_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1057888_Par_3 (redaktsioon 1057888)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057888",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057888",
      "estleg:sourceAct": "Sõrve looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1057888 § 3",
      "estleg:partOfAct": {
