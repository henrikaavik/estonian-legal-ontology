        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas2. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas2.",
      "rdfs:label": {
        "@value": "Reg_1057888_Par_2 (redaktsioon 1057888)",
