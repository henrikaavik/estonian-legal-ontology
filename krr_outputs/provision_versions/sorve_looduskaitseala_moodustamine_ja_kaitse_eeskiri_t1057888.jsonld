      "estleg:sourceAct": "Sõrve looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1057888 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057888_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057888_Par_16_v1057888",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
