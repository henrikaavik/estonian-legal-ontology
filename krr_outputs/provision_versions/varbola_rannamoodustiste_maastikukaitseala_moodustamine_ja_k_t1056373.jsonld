        "@id": "estleg:Reg_1056373_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056373_Par_12_v1056373",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056373_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on kaks piiranguvööndit: 1 1) Varbola rannamoodustiste piiranguvöönd; 2 2) Varbola linnuse piiranguvöönd. Kaitsealal on kaks piiranguvööndit: Varbola rannamoodustiste piiranguvöönd; Varbola linnuse piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1056373_Par_12 (redaktsioon 1056373)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056373",
