        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1056373_Par_3 (redaktsioon 1056373)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056373",
