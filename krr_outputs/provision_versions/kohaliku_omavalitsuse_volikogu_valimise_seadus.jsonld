      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uue kohaliku omavalitsuse üksuse tekkimisel kohalike omavalitsuse üksuste ühinemise või jagunemise tõttu korraldatakse moodustuva kohaliku omavalitsuse üksuse volikogu valimised käesoleva seaduse §-s 2 ettenähtud ajal.",
      "rdfs:label": {
        "@value": "KOVVS_Par_4 (redaktsioon 1045577)",
        "@language": "et"
      },
