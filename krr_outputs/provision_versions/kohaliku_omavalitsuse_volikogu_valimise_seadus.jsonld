        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Hääletamisruumis on valimisagitatsioon keelatud. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "KOVVS_Par_6 (redaktsioon 103012020010)",
