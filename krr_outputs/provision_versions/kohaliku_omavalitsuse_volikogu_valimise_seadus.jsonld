        "@type": "xsd:date"
      },
      "estleg:versionText": "Elektroonilise hääletamise komisjoni pädevus sätestatakse Riigikogu valimise seaduse §-s 172.",
      "rdfs:label": {
        "@value": "KOVVS_Par_20_1 (redaktsioon 101112012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101112012006",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOVVS_Par_20_1_v117112017007"
      },
