    {
      "@id": "estleg:KOVVS_Par_24_v121062016008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOVVS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valijate arvestust peetakse rahvastikuregistris. (2) Rahvastikuregistri pidamise korra näeb ette seadus. (3) Valijate arvestust peetakse rahvastikuregistrisse kantud käesoleva seaduse § 22 lõikes 2 toodud andmete ja isiku kohta rahvastikuregistrisse kantud järgmiste andmete alusel: ees- ja perekonnanimi; sünniaeg; isikukood; kodakondsuse andmed; teovõimetuks tunnistamise andmed; elukoha andmed.",
      "rdfs:label": {
        "@value": "KOVVS_Par_24 (redaktsioon 121062016008)",
        "@language": "et"
      },
