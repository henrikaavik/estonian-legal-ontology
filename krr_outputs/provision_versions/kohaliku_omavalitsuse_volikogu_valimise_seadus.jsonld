        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktiivne agitatsioon on valimispäeval keelatud. (2) Agitatsioon on keelatud hääletamisruumis ja ruumides, mille kaudu valija siseneb hääletamisruumi.",
      "rdfs:label": {
        "@value": "KOVVS_Par_6 (redaktsioon 95225)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "95225",
