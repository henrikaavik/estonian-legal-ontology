      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Avaliku teenindamise lepingu alusel teostatava liiniveo kõrgeim piletihind sõitjateveol Eestisisestel lennuliinidel ja sõidusoodustused (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Avaliku teenindamise lepingu alusel teostatava liiniveo kõrgeim piletihind sõitjateveol Eestisisestel lennuliinidel ja sõidusoodustused"
    },
    {
      "@id": "estleg:Reg_1058957_Par_1_v1058957",
      "@type": [
