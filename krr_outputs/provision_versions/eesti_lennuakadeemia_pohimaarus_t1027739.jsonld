      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Akadeemia majandustegevust ning akadeemia kasutusse antud riigivara kasutamist ja säilitamist kontrollivad Haridus- ja Teadusministeerium ning Riigikontroll. Akadeemia majandustegevust ning akadeemia kasutusse antud riigivara kasutamist ja säilitamist kontrollivad Haridus- ja Teadusministeerium ning Riigikontroll.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_37 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 37",
