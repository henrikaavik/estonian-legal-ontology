      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rektor annab oma pädevuse piires käskkirju. Rektor annab oma pädevuse piires käskkirju.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_8 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 8",
