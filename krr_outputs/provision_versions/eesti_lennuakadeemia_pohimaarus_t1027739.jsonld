      },
      "estleg:versionText": "Akadeemia kõrgeim kollegiaalne otsustuskogu on nõukogu. Akadeemia kõrgeim kollegiaalne otsustuskogu on nõukogu.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_12 (redaktsioon 1027739)",
        "@language": "et"
      },
