      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Akadeemia valdab, kasutab ja käsutab kõrgharidusseadusest ja põhimäärusest tulenevate ülesannete täitmiseks akadeemia kasutusse antud riigivara riigivaraseadusega sätestatud korras. RT I 2019-08-09 1 109082019001 2019-09-01 Akadeemia valdab, kasutab ja käsutab kõrgharidusseadusest ja põhimäärusest tulenevate ülesannete täitmiseks akadeemia kasutusse antud riigivara riigivaraseadusega sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_34 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
