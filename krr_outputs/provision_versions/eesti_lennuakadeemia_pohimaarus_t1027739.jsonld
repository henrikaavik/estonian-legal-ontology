      }
    },
    {
      "@id": "estleg:Reg_1027739_Par_38_v1027739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027739_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Akadeemia tegevuse üle teostab seadusega sätestatud korras teenistuslikku järelevalvet Haridus- ja Teadusministeerium. Lennunduskoolituse üle teostab riiklikku järelevalvet Transpordiamet. RT I 2021-11-18 1 118112021001 2021-11-21 Akadeemia tegevuse üle teostab seadusega sätestatud korras teenistuslikku järelevalvet Haridus- ja Teadusministeerium. Lennunduskoolituse üle teostab riiklikku järelevalvet Transpordiamet.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_38 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 38",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027739_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027739_Par_39_v1027739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027739_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Akadeemia rektori ja nõukogu õigusaktid viiakse põhimäärusega vastavusse selle jõustumise päevast arvates kolme kuu jooksul. Akadeemia rektori ja nõukogu õigusaktid viiakse põhimäärusega vastavusse selle jõustumise päevast arvates kolme kuu jooksul.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_39 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 39",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027739_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027739_Par_4_v1027739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027739_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Akadeemia eesmärk on koolitada kõrge kvalifikatsiooniga lennunduspersonali, viia läbi lennundusalaseid ja lennundust toetavaid rakendusuuringuid, tegeleda arendustööga, korraldada täienduskoolitust, arendada riigisisest ja rahvusvahelist koostööd ning edendada lennunduskultuuri Eestis kooskõlas riigi vajaduste ja rahvusvaheliste lennundusnõuetega. Akadeemia eesmärk on koolitada kõrge kvalifikatsiooniga lennunduspersonali, viia läbi lennundusalaseid ja lennundust toetavaid rakendusuuringuid, tegeleda arendustööga, korraldada täienduskoolitust, arendada riigisisest ja rahvusvahelist koostööd ning edendada lennunduskultuuri Eestis kooskõlas riigi vajaduste ja rahvusvaheliste lennundusnõuetega.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_4 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027739_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027739_Par_5_v1027739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027739_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Akadeemia ülesanne on: 1 1) viia läbi õpet rakenduskõrgharidusõppe, kutseõppe tasemeõppe (edaspidi kutseõpe) ja täienduskoolituse õppekavade alusel; RT I 2021-11-18 1 118112021001 2021-11-21 2 2) tagada õppe- ja töökorraldus, mis võimaldab üliõpilastel ja õpilastel omandada eluks ja tööks vajalikke teadmisi, oskusi ja eetilisi tõekspidamisi; 3 3) luua akadeemia liikmeskonnale soodsad tingimused õppetööks, rakendusuuringute läbiviimiseks, arendustööks, erialaseks enesetäiendamiseks ning suhtlemiseks teiste akadeemiliste töötajate, üliõpilaste ja õpilastega Eestis ja välisriikides; RT I 2021-11-18 1 118112021001 2021-11-21 4 4) arendada õppetööks, rakendusuuringute läbiviimiseks ning arendustegevuseks vajalikku infrastruktuuri ja vara; 5 5) teha koostööd Eesti ja välisriikide õppe-, teadus- ja arendusasutustega ning ettevõtetega ja kogu ühiskonnaga; RT I 2021-11-18 1 118112021001 2021-11-21 6 6) korraldada akadeemia tegevusvaldkonnaga seonduvaid konverentse, seminare ja teisi üritusi; 7 7) tegeleda lennundusalase nõustamisega; 8 8) koostada ja arendada kõrgkooli õppekavasid ning korraldada õppemetoodilist tööd, sealhulgas koostada õppevahendeid ja -materjale ning toetada nende väljaandmist; RT I 2019-08-09 1 109082019001 2019-09-01 9 9) teha lennundushariduse arendamisel ning töökultuuri ja lennuohutuse tagamisel koostööd institutsioonide ja isikutega; 10 10) osaleda eestikeelse lennundusterminoloogia väljatöötamisel ja lennundusajaloo materjalide kogumisel; 11 11) osutada põhitegevusega seotud tasulisi teenuseid; 12 12) sõlmida akadeemia eesmärkidest lähtuvalt lepinguid õppe- ning teadus- ja arendusasutuste ning füüsiliste ja juriidiliste isikutega; 13 13) osaleda akadeemia eesmärkidest lähtuvalt rahvusvahelistes, riigisisestes ja ühiskondlikes projektides; 14 14) rakendada elukestva õppe ja hariduse rahvusvahelistumise põhimõtteid; 15 15) rakendada ühiskonna arengust lähtuvaid uusi õppetöö vorme ja liike. Akadeemia ülesanne on: viia läbi õpet rakenduskõrgharidusõppe, kutseõppe tasemeõppe (edaspidi kutseõpe) ja täienduskoolituse õppekavade alusel; tagada õppe- ja töökorraldus, mis võimaldab üliõpilastel ja õpilastel omandada eluks ja tööks vajalikke teadmisi, oskusi ja eetilisi tõekspidamisi; luua akadeemia liikmeskonnale soodsad tingimused õppetööks, rakendusuuringute läbiviimiseks, arendustööks, erialaseks enesetäiendamiseks ning suhtlemiseks teiste akadeemiliste töötajate, üliõpilaste ja õpilastega Eestis ja välisriikides; arendada õppetööks, rakendusuuringute läbiviimiseks ning arendustegevuseks vajalikku infrastruktuuri ja vara; teha koostööd Eesti ja välisriikide õppe-, teadus- ja arendusasutustega ning ettevõtetega ja kogu ühiskonnaga; korraldada akadeemia tegevusvaldkonnaga seonduvaid konverentse, seminare ja teisi üritusi; tegeleda lennundusalase nõustamisega; koostada ja arendada kõrgkooli õppekavasid ning korraldada õppemetoodilist tööd, sealhulgas koostada õppevahendeid ja -materjale ning toetada nende väljaandmist; teha lennundushariduse arendamisel ning töökultuuri ja lennuohutuse tagamisel koostööd institutsioonide ja isikutega; osaleda eestikeelse lennundusterminoloogia väljatöötamisel ja lennundusajaloo materjalide kogumisel; osutada põhitegevusega seotud tasulisi teenuseid; sõlmida akadeemia eesmärkidest lähtuvalt lepinguid õppe- ning teadus- ja arendusasutuste ning füüsiliste ja juriidiliste isikutega; osaleda akadeemia eesmärkidest lähtuvalt rahvusvahelistes, riigisisestes ja ühiskondlikes projektides; rakendada elukestva õppe ja hariduse rahvusvahelistumise põhimõtteid; rakendada ühiskonna arengust lähtuvaid uusi õppetöö vorme ja liike.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_5 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027739_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027739_Par_6_v1027739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027739_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Akadeemiat juhib rektor. Rektor vastutab akadeemia üldseisundi, arengu ning rahaliste vahendite õiguspärase ja otstarbeka kasutamise eest. Rektor on ka akadeemia koosseisus tegutseva lennunduskoolituse üksuse üldjuht. Akadeemiat juhib rektor. Rektor vastutab akadeemia üldseisundi, arengu ning rahaliste vahendite õiguspärase ja otstarbeka kasutamise eest. Rektor on ka akadeemia koosseisus tegutseva lennunduskoolituse üksuse üldjuht.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_6 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027739_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027739_Par_7_v1027739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027739_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rektor: 1 1) teostab oma pädevuse piires akadeemias kõrgeimat haldus- ja distsiplinaarvõimu; 2 2) esindab akadeemiat kõrgharidusseaduse ja põhimäärusega antud volituste piires; RT I 2019-08-09 1 109082019001 2019-09-01 3 3) võib volitada prorektoreid või teisi akadeemia töötajaid esindama akadeemiat ja tegema selle nimel tehinguid talle kõrgharidusseaduse ja põhimäärusega antud volituste piires; RT I 2019-08-09 1 109082019001 2019-09-01 4 4) nimetab ametisse prorektorid ning sõlmib nendega kuni viieks aastaks töölepingud; 5 5) juhib akadeemia nõukogu (edaspidi nõukogu) tegevust ja tagab nõukogu otsuste täitmise; 6 6) teeb valdkonna eest vastutavale ministrile ettepanekuid nõunike kogu koosseisu kohta; 7 7) kinnitab käskkirjaga akadeemia töökorralduse reeglid ja teabehalduse korra; RT I 2021-11-18 1 118112021001 2021-11-21 7 7¹) kinnitab käskkirjaga akadeemia struktuuriüksuste põhimäärused; RT I 2019-08-09 1 109082019001 2019-09-01 8 8) hoolitseb õppe- ning teadus- ja arendustegevuse otstarbeka korraldamise eest; 9 9) immatrikuleerib ja eksmatrikuleerib üliõpilasi ja õpilasi; 10 10) kuulutab välja avaliku konkursi akadeemiliste töötajate ja õppekasvatusala töötajate vabadele ametikohtadele; RT I 2019-08-09 1 109082019001 2019-09-01 11 11) sõlmib, muudab ja lõpetab töölepinguid akadeemia töötajatega ning kinnitab nende ametijuhendid; 12 12) tagab akadeemia eelarveprojekti ja finantseerimistaotluste koostamise; 13 13) kinnitab akadeemia eelarve ja tagab selle täitmise; 14 14) käsutab akadeemia eelarvevahendeid kõrgharidusseaduse ning teiste õigusaktidega antud volituste ulatuses; RT I 2019-08-09 1 109082019001 2019-09-01 15 15) otsustab olulisemaid majandusküsimusi; 16 16) on aruandekohustuslik nõukogu ja valdkonna eest vastutava ministri ees ning tagab neile õigusaktidest tulenevate andmete esitamise; 17 17) täidab teisi kõrgharidusseadusest, põhimäärusest ja teistest õigusaktidest tulenevaid ülesandeid, mis ei ole antud kellegi teise pädevusse. RT I 2019-08-09 1 109082019001 2019-09-01 Rektor: teostab oma pädevuse piires akadeemias kõrgeimat haldus- ja distsiplinaarvõimu; esindab akadeemiat kõrgharidusseaduse ja põhimäärusega antud volituste piires; võib volitada prorektoreid või teisi akadeemia töötajaid esindama akadeemiat ja tegema selle nimel tehinguid talle kõrgharidusseaduse ja põhimäärusega antud volituste piires; nimetab ametisse prorektorid ning sõlmib nendega kuni viieks aastaks töölepingud; juhib akadeemia nõukogu (edaspidi nõukogu) tegevust ja tagab nõukogu otsuste täitmise; teeb valdkonna eest vastutavale ministrile ettepanekuid nõunike kogu koosseisu kohta; kinnitab käskkirjaga akadeemia töökorralduse reeglid ja teabehalduse korra; kinnitab käskkirjaga akadeemia struktuuriüksuste põhimäärused; hoolitseb õppe- ning teadus- ja arendustegevuse otstarbeka korraldamise eest; immatrikuleerib ja eksmatrikuleerib üliõpilasi ja õpilasi; kuulutab välja avaliku konkursi akadeemiliste töötajate ja õppekasvatusala töötajate vabadele ametikohtadele; sõlmib, muudab ja lõpetab töölepinguid akadeemia töötajatega ning kinnitab nende ametijuhendid; tagab akadeemia eelarveprojekti ja finantseerimistaotluste koostamise; kinnitab akadeemia eelarve ja tagab selle täitmise; käsutab akadeemia eelarvevahendeid kõrgharidusseaduse ning teiste õigusaktidega antud volituste ulatuses; otsustab olulisemaid majandusküsimusi; on aruandekohustuslik nõukogu ja valdkonna eest vastutava ministri ees ning tagab neile õigusaktidest tulenevate andmete esitamise; täidab teisi kõrgharidusseadusest, põhimäärusest ja teistest õigusaktidest tulenevaid ülesandeid, mis ei ole antud kellegi teise pädevusse.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_7 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027739_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027739_Par_8_v1027739",
      "@type": [
        "owl:NamedIndividual",
