      }
    },
    {
      "@id": "estleg:Reg_1027739_Par_22_v1027739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027739_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Akadeemias toimub õppetöö: 1 1) kõrghariduse tasemel kõrgharidusseadusele vastavate ja Vabariigi Valitsuse määrusega kehtestatud kõrgharidusstandardile ja rahvusvahelistele lennundusregulatsioonidele vastavate rakenduskõrgharidusõppe õppekavade alusel; RT I 2019-08-09 1 109082019001 2019-09-01 2 2) kutsehariduse tasemel kutseõppeasutuse seadusele vastavate ja kutseõppeasutuse seaduse § 22 alusel Vabariigi Valitsuse määrusega kehtestatud kutseharidusstandardile vastavate kutseõppe tasemeõppe õppekavade alusel. RT I 2019-08-09 1 109082019001 2019-09-01 Akadeemias toimub õppetöö: kõrghariduse tasemel kõrgharidusseadusele vastavate ja Vabariigi Valitsuse määrusega kehtestatud kõrgharidusstandardile ja rahvusvahelistele lennundusregulatsioonidele vastavate rakenduskõrgharidusõppe õppekavade alusel; kutsehariduse tasemel kutseõppeasutuse seadusele vastavate ja kutseõppeasutuse seaduse § 22 alusel Vabariigi Valitsuse määrusega kehtestatud kutseharidusstandardile vastavate kutseõppe tasemeõppe õppekavade alusel.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_22 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027739_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027739_Par_23_v1027739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
