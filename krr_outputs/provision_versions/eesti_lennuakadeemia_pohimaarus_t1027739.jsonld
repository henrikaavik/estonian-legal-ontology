        "@type": "xsd:date"
      },
      "estleg:versionText": "Akadeemia õppekorralduse alus on õppekorralduseeskiri, milles sätestatakse õppetöö korralduse üldnõuded. Akadeemia õppekorralduse alus on õppekorralduseeskiri, milles sätestatakse õppetöö korralduse üldnõuded.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_24 (redaktsioon 1027739)",
        "@language": "et"
      },
