    {
      "@id": "estleg:Reg_1027739_Par_21_v1027739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027739_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lennunduskoolituse üksus viib läbi õppetööd rahvusvaheliste lennundusregulatsioonide, koolituskäsiraamatu, põhimääruse ja teiste õigusaktide alusel. RT I 2019-08-09 1 109082019001 2019-09-01 Lennunduskoolituse üksus viib läbi õppetööd rahvusvaheliste lennundusregulatsioonide, koolituskäsiraamatu, põhimääruse ja teiste õigusaktide alusel. 2 (2) Lennunduskoolituse üksust juhib vahetult rektorile alluv lennunduseriala koolitusjuht, kelle kandidatuur kooskõlastatakse Transpordiametiga. RT I 2021-11-18 1 118112021001 2021-11-21 Lennunduskoolituse üksust juhib vahetult rektorile alluv lennunduseriala koolitusjuht, kelle kandidatuur kooskõlastatakse Transpordiametiga. 3 (3) Lennunduskoolituse üksuse koolitusõigust kinnitab Transpordiameti väljastatud sertifikaat. RT I 2021-11-18 1 118112021001 2021-11-21 Lennunduskoolituse üksuse koolitusõigust kinnitab Transpordiameti väljastatud sertifikaat.",
      "rdfs:label": {
        "@value": "Reg_1027739_Par_21 (redaktsioon 1027739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027739",
      "estleg:sourceAct": "Eesti Lennuakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1027739 § 21",
      "estleg:partOfAct": {
