      "estleg:provisionRef": "Reg_1001176 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001176_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001176_Par_16_v1001176",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001176_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkursi käigus tehtud konkursi korraldaja otsuse (konkursilt kõrvaldamise otsus, pakkuja kvalifitseerimise otsus, pakkuja kvalifitseerimata jätmise otsus, pakkumise vastavaks tunnistamise otsus, pakkumise tagasilükkamise otsus või konkursi võitjaks tunnistamise otsus) peale võib esitada kaebuse õigusaktides sätestatud korras. Konkursi käigus tehtud konkursi korraldaja otsuse (konkursilt kõrvaldamise otsus, pakkuja kvalifitseerimise otsus, pakkuja kvalifitseerimata jätmise otsus, pakkumise vastavaks tunnistamise otsus, pakkumise tagasilükkamise otsus või konkursi võitjaks tunnistamise otsus) peale võib esitada kaebuse õigusaktides sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1001176_Par_16 (redaktsioon 1001176)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001176",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001176",
      "estleg:sourceAct": "Avaliku konkursi läbiviimise kord sageduslubade andmiseks maapealsetes süsteemides elektrooniliste side teenuste osutamiseks sagedusalas 1800 MHz",
      "estleg:provisionRef": "Reg_1001176 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001176_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001176_Par_2_v1001176",
      "@type": [
