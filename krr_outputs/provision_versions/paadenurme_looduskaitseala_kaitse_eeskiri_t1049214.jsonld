      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 27. märtsi 2019. a käskkirjaga nr 1-2/19/266 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 27. märtsi 2019. a käskkirjaga nr 1-2/19/266 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1049214_Par_12 (redaktsioon 1049214)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049214",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049214",
      "estleg:sourceAct": "Paadenurme looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1049214 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049214_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049214_Par_13_v1049214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049214_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1049214_Par_13 (redaktsioon 1049214)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049214",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049214",
      "estleg:sourceAct": "Paadenurme looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1049214 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049214_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049214_Par_2_v1049214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049214_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Lääne-Viru maakonnas Vinni vallas Kaasiksaare külas, Ida-Viru maakonnas Alutaguse vallas Peressaare külas ning Jõgeva maakonnas Mustvee vallas Kiissa ja Paadenurme külas. Kaitseala asub Lääne-Viru maakonnas Vinni vallas Kaasiksaare külas, Ida-Viru maakonnas Alutaguse vallas Peressaare külas ning Jõgeva maakonnas Mustvee vallas Kiissa ja Paadenurme külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1049214_Par_2 (redaktsioon 1049214)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049214",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049214",
      "estleg:sourceAct": "Paadenurme looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1049214 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049214_Map"
      }
    },
