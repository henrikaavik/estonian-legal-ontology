      }
    },
    {
      "@id": "estleg:Reg_305885_Par_7_v305885",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305885_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. Sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. 2 (2) Kaitsealal on kaks sihtkaitsevööndit: 1 1) Laiksaare sihtkaitsevöönd; 2 2) Rebase sihtkaitsevöönd. Kaitsealal on kaks sihtkaitsevööndit: Laiksaare sihtkaitsevöönd; Rebase sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_305885_Par_7 (redaktsioon 305885)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305885",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305885",
      "estleg:sourceAct": "Laiksaare looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305885 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305885_Map"
      }
    },
    {
      "@id": "estleg:Reg_305885_Par_8_v305885",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305885_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Laiksaare sihtkaitsevööndi kaitse-eesmärk on metsaökosüsteemi arengu tagamine üksnes loodusliku protsessina. Laiksaare sihtkaitsevööndi kaitse-eesmärk on metsaökosüsteemi arengu tagamine üksnes loodusliku protsessina. 2 (2) Rebase sihtkaitsevööndi kaitse-eesmärk on kaitstavate liikide elupaikade ja metsakoosluste säilitamine. Rebase sihtkaitsevööndi kaitse-eesmärk on kaitstavate liikide elupaikade ja metsakoosluste säilitamine.",
      "rdfs:label": {
        "@value": "Reg_305885_Par_8 (redaktsioon 305885)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305885",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305885",
      "estleg:sourceAct": "Laiksaare looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305885 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305885_Map"
      }
    },
    {
      "@id": "estleg:Reg_305885_Par_9_v305885",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305885_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) Rebase sihtkaitsevööndis koosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures metsakoosluse kujundamisel on kaitseala valitsejal õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas; 2 2) olemasolevate ehitiste hooldustööd; 3 3) poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 4 4) kuni 10 osalejaga rahvaürituse korraldamine. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: Rebase sihtkaitsevööndis koosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures metsakoosluse kujundamisel on kaitseala valitsejal õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas; olemasolevate ehitiste hooldustööd; poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; kuni 10 osalejaga rahvaürituse korraldamine.",
      "rdfs:label": {
        "@value": "Reg_305885_Par_9 (redaktsioon 305885)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305885",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305885",
