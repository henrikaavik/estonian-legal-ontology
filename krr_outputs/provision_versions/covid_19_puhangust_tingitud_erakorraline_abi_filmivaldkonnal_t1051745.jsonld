      "estleg:versionValidFrom": {
        "@value": "2021-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus makstakse toetuse saajale välja kümne tööpäeva jooksul pärast taotluse rahuldamise otsuse tegemist. Toetus makstakse toetuse saajale välja kümne tööpäeva jooksul pärast taotluse rahuldamise otsuse tegemist.",
      "rdfs:label": {
        "@value": "Reg_1051745_Par_11 (redaktsioon 1051745)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051745",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051745",
      "estleg:sourceAct": "COVID-19 puhangust tingitud erakorraline abi filmivaldkonnale",
      "estleg:provisionRef": "Reg_1051745 § 11",
