    {
      "@id": "estleg:Reg_1051745_Par_11_v1051745",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051745_Par_11"
