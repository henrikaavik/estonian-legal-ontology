      "estleg:versionValidFrom": {
        "@value": "2023-09-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse ühisveevärgi ja -kanalisatsiooni ehitistele kaitsevööndi ulatus ehitise otstarbe, asukoha, paigaldussügavuse ja läbimõõdu järgi. Määrusega kehtestatakse ühisveevärgi ja -kanalisatsiooni ehitistele kaitsevööndi ulatus ehitise otstarbe, asukoha, paigaldussügavuse ja läbimõõdu järgi.",
      "rdfs:label": {
        "@value": "Reg_1057356_Par_1 (redaktsioon 1057356)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057356",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057356",
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooni kaitsevööndi ulatus",
      "estleg:provisionRef": "Reg_1057356 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057356_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057356_Par_2_v1057356",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057356_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ühisveevärgi ja -kanalisatsiooni maa-aluste survetorustike kaitsevööndi ulatus torustiku telgjoonest mõlemale poole on: 1 1) alla 250 mm siseläbimõõduga torustikul 2 m; 2 2) 250 mm kuni alla 500 mm siseläbimõõduga torustikul 2,5 m; 3 3) 500 mm ja suurema siseläbimõõduga torustikul 3 m. Ühisveevärgi ja -kanalisatsiooni maa-aluste survetorustike kaitsevööndi ulatus torustiku telgjoonest mõlemale poole on: alla 250 mm siseläbimõõduga torustikul 2 m; 250 mm kuni alla 500 mm siseläbimõõduga torustikul 2,5 m; 500 mm ja suurema siseläbimõõduga torustikul 3 m. 2 (2) Ühisveevärgi ja -kanalisatsiooni maa-aluste vabavoolsete torustike kaitsevööndi ulatus torustiku telgjoonest mõlemale poole on: 1 1) torustikul, mille siseläbimõõt on alla 250 mm ja mis on paigaldatud kuni 2 m sügavusele, – 2 m; 2 2) torustikul, mille siseläbimõõt on alla 250 mm ja mis on paigaldatud sügavamale kui 2 m, – 2,5 m; 3 3) torustikul, mille siseläbimõõt on 250 mm ja suurem ning mis on paigaldatud kuni 2 m sügavusele, – 2,5 m; 4 4) torustikul, mille siseläbimõõt on 250 kuni siseläbimõõduni, mis jääb alla 1000 mm, ning mis on paigaldatud sügavamale kui 2 m, – 3 m; 5 5) torustikul, mille siseläbimõõt on 1000 mm ja suurem ning mis on paigaldatud sügavamale kui 2 m või allmaakaeveõõnesse, – 5 m. Ühisveevärgi ja -kanalisatsiooni maa-aluste vabavoolsete torustike kaitsevööndi ulatus torustiku telgjoonest mõlemale poole on: torustikul, mille siseläbimõõt on alla 250 mm ja mis on paigaldatud kuni 2 m sügavusele, – 2 m; torustikul, mille siseläbimõõt on alla 250 mm ja mis on paigaldatud sügavamale kui 2 m, – 2,5 m; torustikul, mille siseläbimõõt on 250 mm ja suurem ning mis on paigaldatud kuni 2 m sügavusele, – 2,5 m; torustikul, mille siseläbimõõt on 250 kuni siseläbimõõduni, mis jääb alla 1000 mm, ning mis on paigaldatud sügavamale kui 2 m, – 3 m; torustikul, mille siseläbimõõt on 1000 mm ja suurem ning mis on paigaldatud sügavamale kui 2 m või allmaakaeveõõnesse, – 5 m.",
      "rdfs:label": {
        "@value": "Reg_1057356_Par_2 (redaktsioon 1057356)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057356",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057356",
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooni kaitsevööndi ulatus",
      "estleg:provisionRef": "Reg_1057356 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057356_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057356_Par_3_v1057356",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057356_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühisveevärgi ja -kanalisatsiooni maa- ja veepealsete torustike kaitsevööndi ulatus on 2 m torustiku välispinnast või kandekonstruktsioonist mõlemale poole. Ühisveevärgi ja -kanalisatsiooni maa- ja veepealsete torustike kaitsevööndi ulatus on 2 m torustiku välispinnast või kandekonstruktsioonist mõlemale poole.",
      "rdfs:label": {
        "@value": "Reg_1057356_Par_3 (redaktsioon 1057356)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057356",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057356",
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooni kaitsevööndi ulatus",
      "estleg:provisionRef": "Reg_1057356 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057356_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057356_Par_4_v1057356",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057356_Par_4"
      },
