  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_menetlustoimingule_valjakutsutud_isiku_voi_tema_lahedase_ilm_t1032876_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Menetlustoimingule väljakutsutud isiku või tema lähedase ilmumata jätmisel terviseseisundist tingitud põhjendatud takistuse kohta menetlejale esitatava tõendi vorm ja väljaandmise kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Menetlustoimingule väljakutsutud isiku või tema lähedase ilmumata jätmisel terviseseisundist tingitud põhjendatud takistuse kohta menetlejale esitatava tõendi vorm ja väljaandmise kord"
    },
    {
      "@id": "estleg:Reg_1032876_Par_1_v1032876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032876_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse menetlustoimingule väljakutsutud isiku või tema lähedase terviseseisundi kohta menetlejale esitatava tõendi (edaspidi tõend) vorm ja väljaandmise kord. Määrusega kehtestatakse menetlustoimingule väljakutsutud isiku või tema lähedase terviseseisundi kohta menetlejale esitatava tõendi (edaspidi tõend) vorm ja väljaandmise kord. 2 (2) Tõendina käsitletakse käesoleva määruse tähenduses väljavõtet tervisekaardist, haigusloo epikriisi, haigusloo erakorralise meditsiini osakonna patsiendikaardi osa, kiirabikaarti, väljavõtet hambaravikaardi päeviku osast või muud terviseseisundit kirjeldavat asjakohast dokumenti või selle osa. Tõendina käsitletakse käesoleva määruse tähenduses väljavõtet tervisekaardist, haigusloo epikriisi, haigusloo erakorralise meditsiini osakonna patsiendikaardi osa, kiirabikaarti, väljavõtet hambaravikaardi päeviku osast või muud terviseseisundit kirjeldavat asjakohast dokumenti või selle osa.",
      "rdfs:label": {
        "@value": "Reg_1032876_Par_1 (redaktsioon 1032876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032876",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032876",
      "estleg:sourceAct": "Menetlustoimingule väljakutsutud isiku või tema lähedase ilmumata jätmisel terviseseisundist tingitud põhjendatud takistuse kohta menetlejale esitatava tõendi vorm ja väljaandmise kord",
      "estleg:provisionRef": "Reg_1032876 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032876_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032876_Par_2_v1032876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032876_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tõendi väljaandmise õigus on perearsti nimistu alusel tegutseval perearstil, tegevusluba omaval eriarstil ja hambaarstil ning eriarstiabi tegevusluba omava tervishoiuteenuse osutaja juures töötaval arstil ja hambaarstil, kes osutab isikule tervishoiuteenust. Tõendi väljaandmise õigus on perearsti nimistu alusel tegutseval perearstil, tegevusluba omaval eriarstil ja hambaarstil ning eriarstiabi tegevusluba omava tervishoiuteenuse osutaja juures töötaval arstil ja hambaarstil, kes osutab isikule tervishoiuteenust. 2 (2) Tõend antakse välja menetlustoimingule väljakutsutud isikule, kelle terviseseisund või lähedase isiku haigus ei võimalda väljakutsutud isikul ilmuda kutses esitatud tähtajaks menetlustoimingule. Tõend antakse välja menetlustoimingule väljakutsutud isikule, kelle terviseseisund või lähedase isiku haigus ei võimalda väljakutsutud isikul ilmuda kutses esitatud tähtajaks menetlustoimingule. 3 (3) Kiirabikaarti või selle koopiat käsitletakse tõendina juhul, kui kiirabi väljakutse esitati päeval, mil isik pidi menetleja juurde ilmuma ja menetlustoimingule ilmumise tähtajale eelnevalt. Kiirabikaarti või selle koopiat käsitletakse tõendina juhul, kui kiirabi väljakutse esitati päeval, mil isik pidi menetleja juurde ilmuma ja menetlustoimingule ilmumise tähtajale eelnevalt. 4 (4) Tõend vormistatakse ja väljastatakse isikule pärast tervishoiuteenuse osutamist ning sellekohase kande tegemist tervishoiuteenuse osutamist tõendavasse dokumenti, mis on vormistatud sotsiaalministri 18. septembri 2008. a määrusega nr 56 „Tervishoiuteenuse osutamise dokumenteerimise ning nende dokumentide säilitamise tingimused ja kord” ning sotsiaalministri 17. septembri 2008. a määrusega nr 53 „Tervise infosüsteemi edastatavate dokumentide andmekoosseisud ning nende säilitamise tingimused ja kord” kehtestatud tingimustel ja korras. Tõend vormistatakse ja väljastatakse isikule pärast tervishoiuteenuse osutamist ning sellekohase kande tegemist tervishoiuteenuse osutamist tõendavasse dokumenti, mis on vormistatud sotsiaalministri 18. septembri 2008. a määrusega nr 56 „Tervishoiuteenuse osutamise dokumenteerimise ning nende dokumentide säilitamise tingimused ja kord” ning sotsiaalministri 17. septembri 2008. a määrusega nr 53 „Tervise infosüsteemi edastatavate dokumentide andmekoosseisud ning nende säilitamise tingimused ja kord” kehtestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "Reg_1032876_Par_2 (redaktsioon 1032876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032876",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032876",
      "estleg:sourceAct": "Menetlustoimingule väljakutsutud isiku või tema lähedase ilmumata jätmisel terviseseisundist tingitud põhjendatud takistuse kohta menetlejale esitatava tõendi vorm ja väljaandmise kord",
      "estleg:provisionRef": "Reg_1032876 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032876_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032876_Par_3_v1032876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
