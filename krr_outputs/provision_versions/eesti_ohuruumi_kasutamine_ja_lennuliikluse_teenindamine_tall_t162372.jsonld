  },
  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_eesti_ohuruumi_kasutamine_ja_lennuliikluse_teenindamine_tall_t162372_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas (76 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas"
    },
    {
      "@id": "estleg:Reg_162372_Par_1_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega sätestatakse Eesti Vabariigi õhuruumi kasutamise ja Tallinna lennuinfopiirkonnas lennuliikluse teenindamise kord, reguleerimaks lennutegevuse planeerimist ja korraldamist ning õhusõidukite käitamise ja teenindamisega seotud toiminguid.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_1 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_10_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eraldatud piiritletud õhuruumis korraldab lennutegevust Kaitseväe vastav struktuuriüksus koostöös lennuliiklusteenistustega, kelle vastutusalades toimuvat lennutegevust võivad Kaitseväe õhusõidukite lennud mõjutada.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_10 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_11_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Langevarjuhüpped, purilennud ja muu klubiline õhuruumi kasutamisega seotud tegevus tuleb iga kord eelnevalt koordineerida asjaomaste lennuliiklusteenistustega. Õhuruumi korduvalt kasutavatel lennuklubidel tuleb avaldada teave tegevushooaegadest ja kasutatavast õhuruumist ning sõlmida asjaomaste lennuliiklusteenistustega vastavasisulised koostöökokkulepped, kus ühe osana sisalduksid täpsed koordineerimisprotseduurid.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_11 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_12_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_162372_Par_12 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_13_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui valitsusasutuste ja eraõiguslike juriidiliste isikute mistahes eesmärgil õhuruumi kasutamine võib mõjutada lennuohutust ning lendude sujuvust, peavad nad kooskõlastama oma tegevuse Transpordiametiga, kes tagab vastava informatsiooni õigeaegse levitamise. Selliseks tegevuseks on muu hulgas: 1) kõrge intensiivsusega valgusseadmete käitamine ja valgusefekti omavate pürotehniliste vahendite kasutamine; 2) ulatuslikud lõhkamistööd; 3) Kaitseväe ja Kaitseliidu laskeharjutused; [ - jõust. 01.04.2013] 4) õhusõidukitest erinevate lennuvahendite käitamine.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_13 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_14_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kasutamata kütust võib õhusõiduki maandumismassi vähendamise eesmärgil lennu ajal välja lasta ainult ohuolukorra puhul või kui õhusõiduki kapten on veendunud, et seda tegemata satub õhusõiduk ohuolukorda, või kui õhusõiduki lennu normaalne jätkamine on ohtlik selle pardal olevatele reisijatele. Kõigil muudel juhtudel peab õhusõiduk vabanema üleliigsest kütusest seda lennul kulutades.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_14 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_15_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpordiamet määrab spetsiaalsed alad kütuse väljalaskmiseks õhusõiduki sattumisel ohuolukorda. Nimetatud alad ei tohi paikneda tihedalt asustatud elamis- ja tööstuspiirkondade või tuleohtlike piirkondade kohal.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_15 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_16_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kütuse väljalaskmise vajadusest teatab õhusõiduki kapten vastavale lennuliiklusteenistusele, lisades teabe võimalikust lennurežiimi muutusest ja väljalastava kütuse kogusest. Õhusõiduki kapten informeerib lennuliiklusteenistust kütuse väljalaskmise alustamisest ja lõpetamisest.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_16 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_17_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kütuse väljalaskmisel juhindutakse järgmistest nõuetest: 1) kütuse väljalaskmine peab toimuma lennujuhtimisteenistuse poolt lubatud ja selleks ettenähtud alal; 2) kütuse väljalaskmine peab üldjuhul toimuma maapinnast kõrgemal kui 6000 jalga (1800 m); 3) kütuse väljalaskmine maapinnast madalamal kui 6000 jalga (1800 m) või väljaspool selleks ettenähtud ala on lubatud, kui õhusõiduk on otseses ohus ega ole seetõttu võimeline seda tegema ettenähtud kõrgusel ja kohas.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_17 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_18_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuliiklusteenistus ei luba 15 minuti jooksul kütuse väljalaskmise lõppemisest arvates teistel kontrollitavatel õhusõidukitel läbida õhuruumi, kus toimus kütuse väljalaskmine. Lennujuhtimisteenust mittesaavatele, kuid lennuliiklusteenistusele teadaolevatele õhusõidukitele annab lennuliiklusteenistus teavet kütuse väljalaskmisest ja selle toimumiskohast.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_18 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_19_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kütuse väljalaskmise kohta teevad õhusõiduki kapten ja vastav lennuliiklusteenistus esimesel võimalusel, kuid mitte hiljem kui ühe ööpäeva jooksul, kirjaliku ettekande Transpordiametile.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_19 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_2_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti õhuruumi kasutamisel ja lennuliikluse teenindamisel Tallinna lennuinfopiirkonnas juhindutakse 1944. aasta Chicago rahvusvahelise tsiviillennunduse konventsioonist, selle lisadest ja muudest Rahvusvahelise Tsiviillennunduse Organisatsiooni (ICAO) dokumentidest ning Euroopa Lennuliikluse Ohutuse Organisatsiooni (EUROCONTROL) standarditest ning nõuetest ja Eesti õigusaktidest.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_2 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_20_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi riiklikus lennunduses teenistuslikeks vajadusteks kasutatava või muu eriotstarbelise õhusõiduki sisenemist Eesti õhuruumi, maandumist Eesti territooriumil ja lendu üle Eesti territooriumi reguleerib Vabariigi Valitsuse 19. detsembri 2003. a määrus nr 345 «Välisriigi sõjalaevale territoriaal- või sisevetesse sisenemise loa ning välisriigi relvajõudude ja eriotstarbelisele õhusõidukile õhuruumi sisenemise loa andmise kord» ( ) või välisleping. Käesolevas peatükis sätestatut ei kohaldata Eesti õhuruumi kaitsel ja selle puutumatuse tagamisel (edaspidi õhuturbe teostamine) osalevatele välisriigi relvajõudude õhusõidukitele.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_20 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_21_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lendamiseks Vabariigi Valitsuse kehtestatud piirangualas on vajalik Transpordiameti luba, välja arvatud lendamiseks otsingu- ja päästetööde, riikliku järelevalve, esmaabi või teadusliku uurimistöö eesmärgil või laskumiseks maandumiseks sertifitseeritud lennuväljale või kopteriväljakule või stardijärgseks tõusuks sellelt või kui seda nõuab lennuohutus. Loa andmisel peab Transpordiamet arvestama Kliimaministeeriumi, Politsei- ja Piirivalveameti või muu asjaomase ametkonna seisukohta.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_21 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_22_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taksolennuks loetakse kaupa või reisijaid vedava õhusõiduki mitteregulaarset lendu, millel on kuni 10 reisijakohta või mille suurim lubatud stardimass ei ületa 5700 kg.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_22 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_23_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taksolennud Eesti õhuruumis toimuvad lennuplaani alusel ning ei vaja luba.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_23 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_24_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühekordseteks taksolendudeks kopteriga, mis maandub või stardib mujalt kui lennuväljadelt või lennuväljakutelt, on vajalik kasutatava territooriumi valdaja eelnev nõusolek.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_24 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_25_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tellimuslennuks loetakse sellise kaupa või reisijaid vedava õhusõiduki mitteregulaarset lendu, millel on vähemalt 11 reisijakohta või mille suurim lubatud stardimass ületab 5700 kg.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_25 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_26_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tellimuslennuks on vaja Transpordiameti luba, kui lennu sooritab välisriigi lennuettevõtja ja see on seotud reisijate või kauba pealevõtmisega Eestist või mahapanemisega Eestis.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_26 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_27_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks 5. peatükis nõutud andmetele peab loa taotlus sisaldama lennu tellija nime, aadressi ja sidevahendite numbreid.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_27 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_28_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loa taotlemine pole vajalik, kui riikidevahelistes lennunduslepingutes või rahvusvahelistes kokkulepetes on sätestatud teisiti.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_28 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_29_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Regulaarliinilennud Eesti õhuruumis toimuvad Transpordiameti kinnitatud korduvlennuplaanide alusel, mis esitatakse kinnitamiseks vähemalt 30 päeva enne esimest plaanijärgset lendu.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_29 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_3_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpordiamet jälgib rahvusvaheliste tsiviillennundusorganisatsioonide poolt väljaantavate soovituslike juhendite ja standardite täitmist ning Eesti õigusaktide vastavust ja teavitab Eesti õigusaktides sisalduvatest erisustest ettenähtud korras ICAO-d ja EUROCONTROL-i.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_3 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_30_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Regulaarliinilendude sooritamiseks nõutakse vastavat liiniluba.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_30 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusvaheliste regulaarliinilendude sooritamisel juhindutakse rahvusvahelistest lennunduslepingutest või nende puudumisel riikide lennundusvõimude kokkulepetest.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_31_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kontrollitavas õhuruumis lendamiseks peab õhusõiduk olema varustatud töökorras ja töörežiimis A/3+C sisselülitatud sekundaarradari transpondriga.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31_31 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31_31",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_32_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõiduk peab olema varustatud kodeeriva kõrgusmõõturiga transpondri tarvis.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31_32 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31_32",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_33_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpondri kasutamine toimub kooskõlas Rahvusvahelise Tsiviillennunduse Organisatsiooni (ICAO) ja Euroopa Lennuliikluse Ohutuse Organisatsiooni (EUROCONTROL) nõuetega. Piloot seab transpondril tunnuskoodi («squawk» – Code/FLT ID) lennuliiklusteenistuse juhiste kohaselt.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31_33 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31_33",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_34_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sisenemisel Tallinna lennuinfopiirkonda peab piloot, kes on saanud lennuliiklusteenistuselt juhised tunnuskoodi seadmiseks transpondril, kasutama seda tunnuskoodi kuni uue juhise saamiseni. Piloot, kes ei ole saanud lennuliiklusteenistuselt juhiseid transpondri seadistuse kohta, käitab Tallinna lennuinfopiirkonda sisenemisel transpondrit tunnuskoodiga 2000 kuni juhise saamiseni.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31_34 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31_34",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_35_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpondrit kasutamata või kõrgusinformatsiooni mitteedastava transpondriga või kodeeriva kõrgusmõõturi puudumisel võib õhusõidukit kontrollitavas õhuruumis käitada ainult erijuhul (ühekordne lend hoolduskohta, otsimis- ja päästetööd vms) asjaomase lennuliiklusteenistuse nõusolekul. Ilma transpondrita purilennukiga võib lende teostada üksnes selleks ettenähtud alal.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31_35 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31_35",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_36_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpondri identifitseerimisrežiimi («squawk – IDENT») tohib kasutada vaid lennuliiklusteenistuse sellekohaste juhiste saamisel või ebaseadusliku sekkumise korral õhusõiduki lendu, hädaolukorras või raadioside katkemisel.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31_36 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31_36",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_37_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhul kui transpondrit kasutatakse mittekontrollitavas õhuruumis, kehtivad kõik §-des 311–316 nimetatud nõuded. Kui need nõuded ei ole täidetud, tuleb mittekontrollitavas õhuruumis lennata väljalülitatud transpondriga.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31_37 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31_37",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_38_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31_38 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31_38",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_31_39_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_31_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõik jäigatiivalised turbiinmootoriga õhusõidukid suurima lubatud stardimassiga üle 5700 kg või lubatud istekohtade arvuga üle 19 peavad Eesti õhuruumis lendamisel olema varustatud õhus kokkupõrke vältimise süsteemi (ACAS) II seadmetega ja neid lennul kasutama.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_31_39 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 31_39",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_32_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõidukite ülehelikiirusel lennuks Eesti õhuruumis on nõutav Vabariigi Valitsuse luba. Loa taotlus tuleb esitada Transpordiametile vähemalt viis tööpäeva enne väljalendu. Taotlus peab sisaldama järgmisi andmeid: 1) õhusõiduki riikkondsus, tüüp, registreerimistunnus; 2) õhusõiduki suurim lubatud stardimass (MTOW); 3) lennu eesmärk; 4) Eesti õhuruumi sisenemise ja väljumise punktid ning nende läbimise kellaajad; 5) kasutatav lennutasand.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_32 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 32",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_33_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusvahelisteks lendudeks vesilennukiga peab käitajal olema Transpordiameti luba, mille taotlus tuleb esitada vähemalt kaks tööpäeva enne lendu. Taotlus peab sisaldama 5. peatükis nõutud andmeid.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_33 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 33",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_34_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ükskõik millise õhusõiduki esimene maandumine Eesti territooriumil ja väljalend välisriiki peab toimuma nendes kohtades, kus on tagatud piiri- ja tolliteenindus.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_34 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 34",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_35_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piloteeritavate vabalennuõhupallide sisenemiseks Eesti õhuruumi ja sellest väljumiseks on vaja Transpordiameti luba. Loa taotlus tuleb esitada vähemalt kaks tööpäeva enne väljalendu. Loa taotlus peab sisaldama järgmisi andmeid: 1) vabalennuõhupalli kirjeldus (tüüp, materjal, suurus, värvus, kaal, last jne); 2) stardikoht ja/või Eesti õhuruumi sisenemise ja väljumise punktid ning marsruut Eestis; 3) lennukõrgused; 4) kasutatavad raadioseadmed ja -sagedused.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_35 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 35",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_36_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Regulaarne meteoroloogiliste raadiosondpallide lendulaskmine tuleb eelnevalt kooskõlastada Transpordiametiga.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_36 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 36",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_37_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuettevõtja võib teha lennuettevõtja sertifikaadiga määratletud lennutöid.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_37 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 37",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_38_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi lennuettevõtja peab lennutööde tegemiseks taotlema Transpordiameti luba. Loa taotlus tuleb esitada vähemalt viis tööpäeva enne tööde kavandatud algust ja see peab sisaldama 5. peatükis nõutud andmeid, millele on lisatud lennutööde tellija nimi, aadress ja sidevahendite numbrid.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_38 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 38",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_39_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriikide eksperimentaalõhusõidukite lennud sisenemisega Eesti õhuruumi, samuti katselende sooritavate õhusõidukite lennud ning demonstratsioonlennud võivad toimuda ainult Transpordiameti loal. Loa taotlus peab sisaldama 5. peatükis nõutud andmeid.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_39 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 39",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_4_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "Reg_162372_Par_4 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_40_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Suure kiirgusintensiivsusega või muul viisil õhusõiduki pardasüsteemide või maapealsete side-, seire- ja navigatsioonisüsteemide tööd häirida võivate seadmete kasutamiseks lendava õhusõiduki pardal tehtavatel töödel on vaja Transpordiameti luba, kui tegemist on Eesti õhusõidukiga, või Välisministeeriumi luba, kui tegemist on välisriigi õhusõidukiga. Loa taotlus peab sisaldama lisaks 4. peatükis nõutud andmetele töödel kasutatava aparatuuri kirjeldust, tööde tellija nime, aadressi ja sidevahendite numbreid.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_40 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 40",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_40_49_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_40_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Allahelikiirusega tsiviilkasutuses olev reaktiivlennuk, mille suurim lubatud stardimass on 34 tonni või rohkem ja reisijakohtade arv on üle 19, võib maanduda Eesti lennuväljale või startida sellelt, kui tema müratase ei ületa 1944. aasta Chicago rahvusvahelise tsiviillennunduse konventsiooni lisa 16 «Keskkonnakaitse» 1. köite II osa 3. peatükis toodud piirväärtusi.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_40_49 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 40_49",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_40_50_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_40_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvis 401 nimetatud lennuk, mille müratase ületab §-s 401 nimetatud piirväärtusi, võib maanduda Eesti lennuväljale või startida sellelt ainult Transpordiameti loal. Loa saamiseks tuleb vähemalt seitse päeva enne lendu esitada Transpordiametile taotlus koos §-s 41 loetletud andmetega ning koopiaga õhusõiduki registreerinud riigi poolt väljastatud või tunnustatud mürasertifikaadist.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_40_50 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 40_50",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_41_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "4. peatükis sätestatud lendudeks välisriigi õhusõidukiga Eesti õhuruumis tuleb taotleda lennuluba. Taotlus lennuloa saamiseks esitatakse Transpordiametile koos järgmiste andmetega: 1) käitaja nimi, aadress ja sidevahendid; 2) õhusõiduki riikkondsus, tüüp ja registreerimistunnus; 3) õhusõiduki suurim lubatud stardimass (MTOW); 4) kapteni nimi, meeskonna suurus; 5) lennu eesmärk ning kirjeldus/liik; 6) lähtelennuväli, marsruut, sihtlennuväli; 7) lennu kuupäevad ning kellaajad; 8) Eesti õhuruumi sisenemise ja väljumise punktid ning nende läbimise kellaajad; 9) meeskonnaliikmete, reisijate ja kolmandate isikute kasuks tehtud kindlustust tõendavad dokumendid või nende koopiad; 10) taotletava lennuloa kehtivusaeg.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_41 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 41",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_42_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotlust ei rahuldata, kui: 1) pole tagatud lennuohutus; 2) taotleja pole esitanud kõiki nõutavaid andmeid või on esitanud valeandmeid; 3) kui taotleja asukohariik keeldub Eesti lennuettevõtja samaväärse taotluse rahuldamisest.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_42 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 42",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_43_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuliikluse teenuste osutamise vajalikkuse üle konkreetses õhuruumi osas või konkreetsel lennuväljal otsustab Transpordiamet, kes määrab osutatava teenuse liigi, arvestades liikluses osalevate õhusõidukite tüüpe, sooritatavate lendude liike, liiklustihedust, meteoroloogilisi tingimusi ja muid lennuliiklust mõjutavaid tegureid.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_43 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 43",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_44_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpordiamet tagab lennuliikluse teenindamise tsiviil- ja riiklikus lennunduses lennuettevõtjate ja lennuliiklusteenistuste sertifitseerimiseelse kontrolli, sertifitseerimise, lennujuhtimis- ja raadionavigatsiooniseadmete sertifitseerimise ning lennuliikluse lennujuhtide ja informaatorite atesteerimise kaudu.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_44 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 44",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_45_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuliiklust teenindavad järgmised Transpordiameti poolt sertifitseeritud lennuliiklusteenistused: 1) lennuliikluse juhtimisteenistus – lähi-, lähenemis- või piirkondlik lennujuhtimise üksus, kes vastutab lennujuhtimise, teabe- ja häireteeninduse eest kontrollitavas õhuruumis ning kontrollitavatel lennuväljadel; 2) lennuvälja lennuinformatsiooniteenistus – üksus, kes vastutab lendude ohutuse ja efektiivsuse tagamiseks vajalike nõuannete ning teabe andmise ja häireteenuste osutamise eest mittekontrollitavatel lennuväljadel.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_45 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 45",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_45_56_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_45_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti õhuruumi neis osades, kus lennuliiklust teenindavad naaberriikide lennuliiklusteenistused, toimub vastavalt nende riikidega sõlmitud rahvusvahelistele kokkulepetele lennuliikluse teenindamine neis riikides kehtivate õigusaktide kohaselt.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_45_56 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 45_56",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_45_57_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_45_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennujuhtimise erisusi õhuturbe teostamisel reguleerib peatükk 81.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_45_57 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 45_57",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_46_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuliiklusteenistused osutavad lennuliiklusteenust neile sertifikaadiga antud õiguste ja tingimuste ulatuses.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_46 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 46",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_46_59_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_46_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_162372_Par_46_59 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 46_59",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_47_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuliiklusteenistus võib sõltuvalt vajadusest, mille üle otsustamisel arvestatakse §-s 43 toodud asjaolusid, töötada vaheldumisi lennuliikluse juhtimisteenistusena või lennuvälja lennuinfoteenistusena.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_47 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 47",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_48_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuliiklusteenistus, kelle kontrollitavas õhuruumis (vastutusalas) õhusõiduk asub, tagab õhusõiduki lennujuhtimise ja hajutamise senikaua, kuni õhusõiduk väljub selle lennujuhtimisteenistuse poolt kontrollitavast õhuruumist.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_48 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 48",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_49_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennujuhtimine antakse teisele lennujuhtimisteenistusele üle teenistuste vastutusalade piiril või kokkulepitud kohas. Lennujuhtimise üleandmiseks on vajalik kooskõlastus teenistusega, kelle vastutusalasse õhusõiduk suundub.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_49 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 49",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_5_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuliikluse ohutuse ja otstarbekuse tagamiseks määrab Transpordiamet Tallinna lennuinfopiirkonna kontrollitavad ja mittekontrollitavad osad, samuti purilennu-, langevarjuhüpete, vigurlennu-, harjutus- ja muud vajalikud alad ning lennuprotseduurid ja marsruudid. Vajadusel kooskõlastab Transpordiamet need teiste ametkondadega, sealhulgas naaberriikide vastavate asutustega.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_5 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_50_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuliiklusteenistus, kelle vastutusalasse õhusõiduk suundub, ei tohi anda õhusõidukile lendu puutuvaid korraldusi enne, kui see on jõudnud tema vastutusalasse. Teise lennujuhtimisüksuse vastutusalas asuvale õhusõidukile antud loa muutmiseks tuleb saada nõusolek vastutavalt lennujuhtimisteenistuselt.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_50 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 50",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_51_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväe õhusõidukite lennutegevust selleks ajutiselt eraldatud õhuruumiosades ja kriisiolukorras korraldab vastav õhuväeteenistus koostöös lennuliiklusteenistustega, kelle vastutusalades toimuvat lennutegevust võivad Kaitseväe õhusõidukite lennud mõjutada.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_51 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 51",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_52_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Külgnevad lennuliiklusteenistused sõlmivad omavahelisi koostööprotseduure kirjeldavad kokkulepped (sh naaberriikide külgnevate lennuliiklusteenistustega) ja teevad koostööd eesmärgiga tagada katkematu ja võimalikult ühtlane teeninduse tase.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_52 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 52",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_53_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "§ 53.",
      "rdfs:label": {
        "@value": "Reg_162372_Par_53 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 53",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_6_v162372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162372_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuliiklust puudutava teabe avaldab Transpordiamet Eesti lennundusteabe kogumikus (AIP).",
      "rdfs:label": {
        "@value": "Reg_162372_Par_6 (redaktsioon 162372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162372",
      "estleg:sourceAct": "Eesti õhuruumi kasutamine ja lennuliikluse teenindamine Tallinna lennuinfopiirkonnas",
      "estleg:provisionRef": "Reg_162372 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162372_Par_63_v162372",
