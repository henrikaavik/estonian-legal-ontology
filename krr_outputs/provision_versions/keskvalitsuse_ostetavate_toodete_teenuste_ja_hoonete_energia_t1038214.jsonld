      "estleg:provisionRef": "Reg_1038214 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038214_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1038214_Par_2_v1038214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038214_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskvalitsus nõuab teenuste riigihankelepingu alusdokumentides, et teenuseosutaja kasutaks teenuse pakkumisel üksnes selliseid tooteid, mis vastavad §-s 1 sätestatud nõuetele. Sellist nõuet kohaldatakse ainult uuele tootele, mille teenuseosutaja ostab osaliselt või täielikult keskvalitsuse tellitud teenuse osutamise eesmärgil. Keskvalitsus nõuab teenuste riigihankelepingu alusdokumentides, et teenuseosutaja kasutaks teenuse pakkumisel üksnes selliseid tooteid, mis vastavad §-s 1 sätestatud nõuetele. Sellist nõuet kohaldatakse ainult uuele tootele, mille teenuseosutaja ostab osaliselt või täielikult keskvalitsuse tellitud teenuse osutamise eesmärgil.",
      "rdfs:label": {
        "@value": "Reg_1038214_Par_2 (redaktsioon 1038214)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038214",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038214",
      "estleg:sourceAct": "Keskvalitsuse ostetavate toodete, teenuste ja hoonete energiatõhususe nõuded",
      "estleg:provisionRef": "Reg_1038214 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038214_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1038214_Par_3_v1038214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038214_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Keskvalitsus ostab üksnes sellise hoone või sõlmib selle kohta uue kasutuslepingu, mis vastab vähemalt ehitusseadustiku § 65 lõike 3 alusel kehtestatud hoone energiatõhususe miinimumnõuetele oluliselt rekonstrueeritava hoone kohta, ning kontrollib nõude täitmist ehitusseadustiku §-s 66 kehtestatud energiamärgise alusel. Keskvalitsus ostab üksnes sellise hoone või sõlmib selle kohta uue kasutuslepingu, mis vastab vähemalt ehitusseadustiku § 65 lõike 3 alusel kehtestatud hoone energiatõhususe miinimumnõuetele oluliselt rekonstrueeritava hoone kohta, ning kontrollib nõude täitmist ehitusseadustiku §-s 66 kehtestatud energiamärgise alusel. 2 (2) Lõikes 1 sätestatud nõudeid ei kohaldata juhul, kui: 1 1) ostu eesmärgiks on hoone lammutamine või ehitusseadustiku § 65 lõike 3 alusel kehtestatud hoone energiatõhususe miinimumnõuete määruse mõistes oluline rekonstrueerimine; 2 2) ostu eesmärgiks on keskvalitsuse kavatsus hoone edasi võõrandada ilma seda avaliku asutuse enda tarbeks kasutamata; 3 3) hoone kuulub ehitusseadustiku § 62 lõikes 2 loetletud hoonete hulka; 4 4) kehtetu - RT I 2019-12-03 6 103122019006 2019-12-06 5 5) kasutusse andjaks on riigivaraseaduse mõistes riigivara valitseja või volitatud asutus või vara võetakse kasutusse riigihangete seaduse mõistes sisetehinguga; 6 6) kõnealuses piirkonnas ei ole samal eesmärgil kasutamiseks sobivat energiatõhususe miinimumnõuetele vastavat pinda pakkuda. Lõikes 1 sätestatud nõudeid ei kohaldata juhul, kui: ostu eesmärgiks on hoone lammutamine või ehitusseadustiku § 65 lõike 3 alusel kehtestatud hoone energiatõhususe miinimumnõuete määruse mõistes oluline rekonstrueerimine; ostu eesmärgiks on keskvalitsuse kavatsus hoone edasi võõrandada ilma seda avaliku asutuse enda tarbeks kasutamata; hoone kuulub ehitusseadustiku § 62 lõikes 2 loetletud hoonete hulka; kehtetu - kasutusse andjaks on riigivaraseaduse mõistes riigivara valitseja või volitatud asutus või vara võetakse kasutusse riigihangete seaduse mõistes sisetehinguga; kõnealuses piirkonnas ei ole samal eesmärgil kasutamiseks sobivat energiatõhususe miinimumnõuetele vastavat pinda pakkuda.",
      "rdfs:label": {
        "@value": "Reg_1038214_Par_3 (redaktsioon 1038214)",
        "@language": "et"
      },
