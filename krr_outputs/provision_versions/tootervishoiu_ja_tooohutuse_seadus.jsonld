      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22454",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse seadus",
      "estleg:provisionRef": "TTOS § 25",
      "estleg:partOfAct": {
        "@id": "estleg:TTOS_Map"
      }
    },
    {
      "@id": "estleg:TTOS_Par_25_v262686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
