        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22454",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse seadus",
      "estleg:provisionRef": "TTOS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:TTOS_Map"
      }
    },
    {
      "@id": "estleg:TTOS_Par_31_v12883561",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
