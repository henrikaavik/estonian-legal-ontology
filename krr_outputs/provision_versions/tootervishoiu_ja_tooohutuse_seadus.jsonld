    {
      "@id": "estleg:TTOS_Par_31_v22454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTOS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi töökaitseseaduse (RT I 1992, 25, 343; RT I 1996, 49, 953) alusel kehtestatud õigusaktid kehtivad pärast käesoleva seaduse jõustumist niivõrd, kuivõrd need ei ole vastuolus käesoleva seadusega, ja seni, kuni need kas tühistatakse või viiakse käesoleva seadusega vastavusse.",
      "rdfs:label": {
        "@value": "TTOS_Par_31 (redaktsioon 22454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22454",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTOS_Par_31_v12883561"
      },
      "estleg:versionValidTo": {
