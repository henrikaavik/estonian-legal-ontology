    {
      "@id": "estleg:TTOS_Par_26_2_v262686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTOS_Par_26_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vaie ettekirjutuse peale esitatakse, vaadatakse läbi ja lahendatakse haldusmenetluse seaduses sätestatud korras, arvestades käesolevas seaduses ettenähtud erisusi. (2) Kui tööandja ei nõustu tööinspektori ettekirjutusega, on tal õigus esitada vaie Tööinspektsiooni kohaliku asutuse juhatajale haldusakti saamisest arvates kümne kalendripäeva jooksul. Kui ettekirjutuse on teinud Tööinspektsiooni kohaliku asutuse juhataja, on tööandjal õigus esitada vaie Tööinspektsiooni peadirektorile haldusakti saamise päevast arvates kümne päeva jooksul.",
      "rdfs:label": {
        "@value": "TTOS_Par_26_2 (redaktsioon 262686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262686",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTOS_Par_26_2_v129062014079"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/262686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse seadus",
      "estleg:provisionRef": "TTOS § 26_2",
      "estleg:partOfAct": {
        "@id": "estleg:TTOS_Map"
      }
    },
    {
      "@id": "estleg:TTOS_Par_26_2_v129062014079",
