      }
    },
    {
      "@id": "estleg:TTOS_Par_16_1_v108102014006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTOS_Par_16_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-10-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ohutu tööelu andmekogu on riigi infosüsteemi kuuluv andmekogu, mille vastutav töötleja on Sotsiaalministeerium. (2) Ohutu tööelu andmekogu eesmärk on abistada tööandjat ohutu töökeskkonna loomiseks vajalike töötervishoiu ja tööohutusega seotud andmete töötlemisel. (3) Ohutu tööelu andmekogu kasutamine on ettevõttele vabatahtlik. Juurdepääs andmekogus sisalduvatele andmetele on tööandjal ja töötajal. Tööandjal on juurdepääs tema enda ja tema töötajate kohta käivatele andmetele. Töötajal on juurdepääs tema kohta käivatele andmetele. (4) Andmekogu asutab ja selle põhimääruse kehtestab määrusega.",
      "rdfs:label": {
        "@value": "TTOS_Par_16_1 (redaktsioon 108102014006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108102014006",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTOS_Par_16_1_v112062018005"
      },
      "estleg:versionValidTo": {
        "@value": "2018-06-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108102014006",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse seadus",
      "estleg:provisionRef": "TTOS § 16_1",
