        "@value": "2007-11-25",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12779732",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse seadus",
      "estleg:provisionRef": "TTOS § 24",
      "estleg:partOfAct": {
        "@id": "estleg:TTOS_Map"
      }
    },
