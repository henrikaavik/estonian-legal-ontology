      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112122018074",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse seadus",
      "estleg:provisionRef": "TTOS § 27_1",
      "estleg:partOfAct": {
        "@id": "estleg:TTOS_Map"
      }
    },
    {
      "@id": "estleg:TTOS_Par_27_1_v109072020007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTOS_Par_27_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 4 lõigetes 2, 3 ja 41–44 ning lõigete 31, 4, 45 ja 5 alusel töökohale kehtestatud töötervishoiu ja tööohutuse nõuete rikkumise eest, kui sellega kaasnes oht töötaja tervisele või elule, tööandja, tema juhatuse liikme või muu esindaja poolt, kellele oli vastavate nõuete täitmise tagamise kohustus delegeeritud, –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "TTOS_Par_27_1 (redaktsioon 109072020007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109072020007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109072020007",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse seadus",
      "estleg:provisionRef": "TTOS § 27_1",
      "estleg:partOfAct": {
        "@id": "estleg:TTOS_Map"
      }
    },
    {
      "@id": "estleg:TTOS_Par_27_2_v189870",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
