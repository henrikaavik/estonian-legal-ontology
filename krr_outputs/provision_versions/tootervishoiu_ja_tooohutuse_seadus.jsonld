      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete täitmise üle teostab Tööinspektsioon. (2) Tööinspektsioon teostab käesoleva seaduse rakendusalas kasutatavate isikukaitsevahendite turujärelevalvet toote ohutuse seaduses (RT I 1998, 40, 613; 1999, 82, 753; 2000, 86, 546; 2002, 47, 297; 61, 375; 63, 387) sätestatud korras.",
      "rdfs:label": {
        "@value": "TTOS_Par_25 (redaktsioon 262686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262686",
