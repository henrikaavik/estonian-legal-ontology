        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/262686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse seadus",
      "estleg:provisionRef": "TTOS § 25",
      "estleg:partOfAct": {
        "@id": "estleg:TTOS_Map"
      }
    },
    {
      "@id": "estleg:TTOS_Par_25_v12778170",
