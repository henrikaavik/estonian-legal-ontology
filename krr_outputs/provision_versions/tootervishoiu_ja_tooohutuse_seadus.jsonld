        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär 3200 eurot.",
      "rdfs:label": {
        "@value": "TTOS_Par_26_1 (redaktsioon 129062014079)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014079",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTOS_Par_26_1_v128042017009"
      },
      "estleg:versionValidTo": {
        "@value": "2017-05-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014079",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse seadus",
      "estleg:provisionRef": "TTOS § 26_1",
