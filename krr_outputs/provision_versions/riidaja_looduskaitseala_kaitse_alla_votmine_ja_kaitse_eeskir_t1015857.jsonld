    {
      "@id": "estleg:Reg_1015857_Par_4_v1015857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015857_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välispiiri kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välispiiri kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1015857_Par_4 (redaktsioon 1015857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015857",
      "estleg:sourceAct": "Riidaja looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1015857 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015857_Map_2026"
