      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti kodakondsuse saanud, taastanud või kaotanud isikute andmekogu põhimäärus (25 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti kodakondsuse saanud, taastanud või kaotanud isikute andmekogu põhimäärus"
    },
    {
      "@id": "estleg:Reg_1032302_Par_1_v1032302",
