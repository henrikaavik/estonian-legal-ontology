      "estleg:provisionRef": "Reg_1032302 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032302_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032302_Par_7_v1032302",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
