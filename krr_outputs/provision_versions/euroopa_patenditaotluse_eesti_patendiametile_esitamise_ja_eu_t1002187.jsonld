      }
    },
    {
      "@id": "estleg:Reg_1002187_Par_15_v1002187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002187_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti Patendiametisse saabunud Euroopa patenditaotluse sisu on konfidentsiaalne. Eesti Patendiametisse saabunud Euroopa patenditaotluse sisu on konfidentsiaalne. 2 (2) Mitte keegi peale patenditaotleja või tema volitatud kutselise esindaja ei saa nõuda Eesti Patendiametilt Euroopa patenditaotlusega tutvumist. Mitte keegi peale patenditaotleja või tema volitatud kutselise esindaja ei saa nõuda Eesti Patendiametilt Euroopa patenditaotlusega tutvumist. 3 (3) Euroopa patenditaotluse tutvumise eesmärgil väljaviimine Eesti Patendiameti ruumidest või selle dokumentidest ärakirjade tegemine on keelatud. Euroopa patenditaotluse tutvumise eesmärgil väljaviimine Eesti Patendiameti ruumidest või selle dokumentidest ärakirjade tegemine on keelatud.",
      "rdfs:label": {
