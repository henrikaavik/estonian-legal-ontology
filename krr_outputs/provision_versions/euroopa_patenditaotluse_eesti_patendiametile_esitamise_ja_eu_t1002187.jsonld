      }
    },
    {
      "@id": "estleg:Reg_1002187_Par_22_v1002187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002187_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti Patendiamet registreerib saabunud Euroopa patenditaotluse patendinõudluse tõlke ja sellele lisatud dokumendid ja kontrollib nende vastavust vorminõuetele, riigilõivu tasumist, volikirja, kui tõlke esitas patendivolinik, ning käesoleva määruse § 20 lõikes 3 loetletud andmeid. Eesti Patendiamet registreerib saabunud Euroopa patenditaotluse patendinõudluse tõlke ja sellele lisatud dokumendid ja kontrollib nende vastavust vorminõuetele, riigilõivu tasumist, volikirja, kui tõlke esitas patendivolinik, ning käesoleva määruse § 20 lõikes 3 loetletud andmeid. 2 (2) Kontrolli tulemusena ilmnenud puudustest teatatakse patenditaotlejale, sealhulgas ilmselgelt ebakorrektsest või eesti kirjakeele normile mittevastavast tõlkest. Kontrolli tulemusena ilmnenud puudustest teatatakse patenditaotlejale, sealhulgas ilmselgelt ebakorrektsest või eesti kirjakeele normile mittevastavast tõlkest. 3 (3) Puuduste ilmnemise korral ei loeta Euroopa patenditaotluse patendinõudluse tõlget enne kõigi puuduste kõrvaldamist esitatuks. Puuduste ilmnemise korral ei loeta Euroopa patenditaotluse patendinõudluse tõlget enne kõigi puuduste kõrvaldamist esitatuks.",
      "rdfs:label": {
        "@value": "Reg_1002187_Par_22 (redaktsioon 1002187)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002187",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002187",
      "estleg:sourceAct": "Euroopa patenditaotluse Eesti Patendiametile esitamise ja Euroopa Patendiametile edastamise, Euroopa patenditaotluse patendinõudluse ja patendikirjelduse tõlke esitamise ja avalikustamise ning Euroopa patenditaotluse siseriiklikuks patenditaotluseks ja kasuliku mudeli registreerimise taotluseks muutmise kord",
      "estleg:provisionRef": "Reg_1002187 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002187_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002187_Par_23_v1002187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002187_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Esitatuks loetud Euroopa patenditaotluse patendinõudluse tõlke kohta avaldatakse esimesel võimalusel teade „Eesti Patendilehes”. Teade sisaldab käesoleva määruse § 20 lõikes 3 loetletud andmeid. Esitatuks loetud Euroopa patenditaotluse patendinõudluse tõlke kohta avaldatakse esimesel võimalusel teade „Eesti Patendilehes”. Teade sisaldab käesoleva määruse § 20 lõikes 3 loetletud andmeid. 2 (2) Tõlke avalikustamisest teatatakse patenditaotlejale või tema esindajale kirjalikult. Tõlke avalikustamisest teatatakse patenditaotlejale või tema esindajale kirjalikult. 3 (3) Euroopa patenditaotluse patendinõudluse tõlge avalikustatakse tõlke kohta „Eesti Patendilehes” teate avaldamise päeval Eesti Patendiametis ja juriidilise isiku juures, kellega riik on sõlminud vastava lepingu. RT I 2013-05-31 2 131052013002 2013-06-03 Euroopa patenditaotluse patendinõudluse tõlge avalikustatakse tõlke kohta „Eesti Patendilehes” teate avaldamise päeval Eesti Patendiametis ja juriidilise isiku juures, kellega riik on sõlminud vastava lepingu. 4 (4) Igaüks võib Euroopa patenditaotluse patendinõudluse tõlke esitamise kohta „Eesti Patendilehes” teate avaldamise päevast alates tutvuda tõlkega juriidilise isiku juures, kellega riik on sõlminud vastava lepingu, ja saada sellest Eesti Patendiametilt ettenähtud riigilõivu tasumisel kinnitatud ärakirja. RT I 2013-05-31 2 131052013002 2013-06-03 Igaüks võib Euroopa patenditaotluse patendinõudluse tõlke esitamise kohta „Eesti Patendilehes” teate avaldamise päevast alates tutvuda tõlkega juriidilise isiku juures, kellega riik on sõlminud vastava lepingu, ja saada sellest Eesti Patendiametilt ettenähtud riigilõivu tasumisel kinnitatud ärakirja.",
      "rdfs:label": {
        "@value": "Reg_1002187_Par_23 (redaktsioon 1002187)",
        "@language": "et"
      },
