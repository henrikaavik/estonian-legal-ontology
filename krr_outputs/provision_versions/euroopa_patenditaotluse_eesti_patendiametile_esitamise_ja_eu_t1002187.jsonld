    {
      "@id": "estleg:Reg_1002187_Par_6_v1002187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002187_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa patenditaotluse võib iga isik esitada kas iseseisvalt või esindaja kaudu. Esindajaks võib olla Euroopa Patendiameti poolt peetavasse kutseliste esindajate nimekirja kantud isik (edaspidi kutseline esindaja), kelle tegevuskoht on konventsiooni osalisriigis. Mitme patenditaotleja korral võib esindajaks olla ka konventsiooni osalisriigis asuv ühine esindaja. Euroopa patenditaotluse võib iga isik esitada kas iseseisvalt või esindaja kaudu. Esindajaks võib olla Euroopa Patendiameti poolt peetavasse kutseliste esindajate nimekirja kantud isik (edaspidi kutseline esindaja), kelle tegevuskoht on konventsiooni osalisriigis. Mitme patenditaotleja korral võib esindajaks olla ka konventsiooni osalisriigis asuv ühine esindaja.",
