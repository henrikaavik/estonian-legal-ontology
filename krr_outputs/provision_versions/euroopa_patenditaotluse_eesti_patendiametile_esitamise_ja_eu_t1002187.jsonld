    {
      "@id": "estleg:Reg_1002187_Par_28_v1002187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002187_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Euroopa patendikirjelduse tõlke ja sellele lisatud dokumentide suhtes kehtivad patendiseaduse § 19 lõike 4 ja § 20 lõike 4 alusel kehtestatud justiitsministri määruse §-s 52 kehtestatud tekstidokumentide vormistamise üldnõuded. Euroopa patendikirjelduse tõlke ja sellele lisatud dokumentide suhtes kehtivad patendiseaduse § 19 lõike 4 ja § 20 lõike 4 alusel kehtestatud justiitsministri määruse §-s 52 kehtestatud tekstidokumentide vormistamise üldnõuded. 2 (2) Euroopa patendikirjelduse tõlke identifitseerimiseks trükitakse tõlke kõigi lehtede ülaveerise parempoolsesse ossa Euroopa patendikirjelduse number, mille ette lisatakse sidekriips „-” ja Eesti Vabariigi kahetäheline kood „EE”. Euroopa patendikirjelduse tõlke identifitseerimiseks trükitakse tõlke kõigi lehtede ülaveerise parempoolsesse ossa Euroopa patendikirjelduse number, mille ette lisatakse sidekriips „-” ja Eesti Vabariigi kahetäheline kood „EE”.",
      "rdfs:label": {
