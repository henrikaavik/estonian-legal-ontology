      }
    },
    {
      "@id": "estleg:RVMS_Par_8_v130122011026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raskeveokimaksust on vabastatud kaitseväe, Kaitseliidu, Politsei- ja Piirivalveameti ja päästeasutuste raskeveokid ning päästetöid tegeva kohaliku omavalitsuse, mittetulundusühingu, sihtasutuse või ettevõtja raskeveokid, mida kasutatakse peamiselt päästetööl.",
      "rdfs:label": {
        "@value": "RVMS_Par_8 (redaktsioon 130122011026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011026"
    },
    {
      "@id": "estleg:RVMS_Par_9_v234985",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raskeveokimaksumaksuhaldur on Maksuamet. (2) Autoregistrikeskus on kohustatudesitamaMaksuametileigamaksustamisperioodiesimese kuu 10. kuupäevakseelmiselmaksustamisperioodilliiklusregistrisregistreeritudvõisellestkustutatudraskeveokite kohta järgmisedandmed: veoautoomanikuvõikäesolevaseaduse § 3 lõigetes 11 ja 2 nimetatudjuhtudelvaldaja nimi (füüsiliseisikupuhulees- ja perekonnanimi); veoautoomanikuvõikäesolevaseaduse § 3 lõigetes 11 ja 2 nimetatudjuhtudelvaldajaisikukood (sellepuudumiselisikusünnikuupäev, -kuu ja -aasta) võiregistrikood; veoautoomanikuvõikäesolevaseaduse § 3 lõigetes 1 1 ja 2 nimetatudjuhtudelvaldajaelu-võiasukohaaadress; veoautoregistreerimismärgiandmed; veoautoregistri-võitäismass; autorongikoosseisusüheaegseltkasutatavatehaagistetelgedearv ja nimetatudhaagistesuurimmass, mis on kantudliiklusregistrisse, samutikandetegemisekuupäev; veoautomark; veoautoveoteljelõhkvedrustusevõisellegasamaväärsevedrustuse olemasolu võipuudumine; veoautotelgedearv; veoautoregistreerimise, registrikandemuutmisevõiregistristkustutamisekuupäev. (3) Kuiliiklusregistrismaksustamisealuseksolevadraskeveokivõimaksumaksjaandmedmaksustamisperioodijooksulmuutuvad, on AutoregistrikeskuskohustatudsellestMaksuametileteatamamaksustamisperioodilejärgneva kuu 10. kuupäevaks.",
      "rdfs:label": {
        "@value": "RVMS_Par_9 (redaktsioon 234985)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "234985",
      "estleg:supersededByVersion": {
        "@id": "estleg:RVMS_Par_9_v693680"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RVMS_Par_9_v693680",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raskeveokimaksumaksuhaldur on Maksu- ja Tolliamet. (2) Autoregistrikeskus on kohustatudesitama Maksu- ja Tolliametileigamaksustamisperioodiesimese kuu 10. kuupäevakseelmiselmaksustamisperioodilliiklusregistrisregistreeritudvõisellestkustutatudraskeveokite kohta järgmisedandmed: veoautoomanikuvõikäesolevaseaduse § 3 lõigetes 1 1 ja 2 nimetatudjuhtudelvaldaja nimi (füüsiliseisikupuhulees- ja perekonnanimi); veoautoomanikuvõikäesolevaseaduse § 3 lõigetes 1 1 ja 2 nimetatudjuhtudelvaldajaisikukood (sellepuudumiselisikusünnikuupäev, -kuu ja -aasta) võiregistrikood; veoautoomanikuvõikäesolevaseaduse § 3 lõigetes 1 1 ja 2 nimetatudjuhtudelvaldajaelu-võiasukohaaadress; veoautoregistreerimismärgiandmed; veoautoregistri-võitäismass; autorongikoosseisusüheaegseltkasutatavatehaagistetelgedearv ja nimetatudhaagistesuurimmass, mis on kantudliiklusregistrisse, samutikandetegemisekuupäev; veoautomark; veoautoveoteljelõhkvedrustusevõisellegasamaväärsevedrustuse olemasolu võipuudumine; veoautotelgedearv; veoautoregistreerimise, registrikandemuutmisevõiregistristkustutamisekuupäev. (3) Kuiliiklusregistrismaksustamisealuseksolevadraskeveokivõimaksumaksjaandmedmaksustamisperioodijooksulmuutuvad, on Autoregistrikeskuskohustatudsellest Maksu- ja Tolliametileteatamamaksustamisperioodilejärgneva kuu 10. kuupäevaks.",
      "rdfs:label": {
        "@value": "RVMS_Par_9 (redaktsioon 693680)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693680",
      "estleg:supersededByVersion": {
        "@id": "estleg:RVMS_Par_9_v13181369"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RVMS_Par_9_v13181369",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raskeveokimaksu maksuhaldur on Maksu- ja Tolliamet. (2) Maanteeameti kohalik asutus on kohustatud esitama Maksu- ja Tolliametile iga maksustamisperioodi esimese kuu 10. kuupäevaks eelmisel maksustamisperioodil liiklusregistris registreeritud või sellest kustutatud raskeveokite kohta järgmised andmed: veoauto omaniku või käesoleva seaduse § 3 lõigetes 1 1 ja 2 nimetatud juhtudel valdaja nimi (füüsilise isiku puhul ees- ja perekonnanimi); veoauto omaniku või käesoleva seaduse § 3 lõigetes 1 1 ja 2 nimetatud juhtudel valdaja isikukood (selle puudumisel isiku sünnikuupäev, -kuu ja -aasta) või registrikood; veoauto omaniku või käesoleva seaduse § 3 lõigetes 1 1 ja 2 nimetatud juhtudel valdaja elu- või asukoha aadress; veoauto registreerimismärgi andmed; veoauto registri- või täismass; autorongi koosseisus üheaegselt kasutatavate haagiste telgede arv ja nimetatud haagiste suurim mass, mis on kantud liiklusregistrisse, samuti kande tegemise kuupäev; veoauto mark; veoauto veoteljel õhkvedrustuse või sellega samaväärse vedrustuse olemasolu või puudumine; veoauto telgede arv; veoauto registreerimise, registrikande muutmise või registrist kustutamise kuupäev. (3) Kui liiklusregistris maksustamise aluseks olevad raskeveoki või maksumaksja andmed maksustamisperioodi jooksul muutuvad, on Maanteeameti kohalik asutus kohustatud sellest Maksu- ja Tolliametile teatama maksustamisperioodile järgneva kuu 10. kuupäevaks.",
      "rdfs:label": {
        "@value": "RVMS_Par_9 (redaktsioon 13181369)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13181369",
      "estleg:supersededByVersion": {
        "@id": "estleg:RVMS_Par_9_v13322129"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RVMS_Par_9_v13322129",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raskeveokimaksu maksuhaldur on Maksu- ja Tolliamet. (2) Maanteeameti kohalik asutus on kohustatud esitama Maksu- ja Tolliametile iga maksustamisperioodi esimese kuu 10. kuupäevaks eelmisel maksustamisperioodil liiklusregistris registreeritud või sellest kustutatud raskeveokite kohta järgmised andmed: veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja nimi (füüsilise isiku puhul ees- ja perekonnanimi); veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja isikukood (selle puudumisel isiku sünnikuupäev, -kuu ja -aasta) või registrikood; veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja elu- või asukoha aadress; veoauto registreerimismärgi andmed; veoauto registri- või täismass; autorongi koosseisus üheaegselt kasutatavate haagiste telgede arv ja nimetatud haagiste suurim mass, mis on kantud liiklusregistrisse, samuti kande tegemise kuupäev; veoauto mark; veoauto veoteljel õhkvedrustuse või sellega samaväärse vedrustuse olemasolu või puudumine; veoauto telgede arv; veoauto registreerimise, registrikande muutmise või registrist kustutamise kuupäev. (3) Kui liiklusregistris maksustamise aluseks olevad raskeveoki või maksumaksja andmed maksustamisperioodi jooksul muutuvad, on Maanteeameti kohalik asutus kohustatud sellest Maksu- ja Tolliametile teatama maksustamisperioodile järgneva kuu 10. kuupäevaks.",
      "rdfs:label": {
        "@value": "RVMS_Par_9 (redaktsioon 13322129)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13322129",
      "estleg:supersededByVersion": {
        "@id": "estleg:RVMS_Par_9_v117032011025"
      },
      "estleg:versionValidTo": {
        "@value": "2011-03-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RVMS_Par_9_v117032011025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raskeveokimaksu maksuhaldur on Maksu- ja Tolliamet. (2) Maanteeamet on kohustatud esitama Maksu- ja Tolliametile iga maksustamisperioodi esimese kuu 10. kuupäevaks eelmisel maksustamisperioodil liiklusregistris registreeritud või sellest kustutatud raskeveokite kohta järgmised andmed: veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja nimi (füüsilise isiku puhul ees- ja perekonnanimi); veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja isikukood (selle puudumisel isiku sünnikuupäev, -kuu ja -aasta) või registrikood; veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja elu- või asukoha aadress; veoauto registreerimismärgi andmed; veoauto registri- või täismass; autorongi koosseisus üheaegselt kasutatavate haagiste telgede arv ja nimetatud haagiste suurim mass, mis on kantud liiklusregistrisse, samuti kande tegemise kuupäev; veoauto mark; veoauto veoteljel õhkvedrustuse või sellega samaväärse vedrustuse olemasolu või puudumine; veoauto telgede arv; veoauto registreerimise, registrikande muutmise või registrist kustutamise kuupäev. (3) Kui liiklusregistris maksustamise aluseks olevad raskeveoki või maksumaksja andmed maksustamisperioodi jooksul muutuvad, on Maanteeamet kohustatud sellest Maksu- ja Tolliametile teatama maksustamisperioodile järgneva kuu 10. kuupäevaks.",
      "rdfs:label": {
        "@value": "RVMS_Par_9 (redaktsioon 117032011025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RVMS_Par_9_v107122018015"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-16",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RVMS_Par_9_v107122018015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raskeveokimaksu maksuhaldur on Maksu- ja Tolliamet. (2) Maanteeamet on kohustatud esitama Maksu- ja Tolliametile iga maksustamisperioodi esimese kuu 10. kuupäevaks eelmisel maksustamisperioodil liiklusregistris registreeritud või sellest kustutatud raskeveokite kohta järgmised andmed: veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja nimi (füüsilise isiku puhul ees- ja perekonnanimi); veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja isikukood (selle puudumisel isiku sünnikuupäev, -kuu ja -aasta) või registrikood; veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja elu- või asukoha aadress; veoauto registreerimismärgi andmed; veoauto registri- või täismass; autorongi koosseisus üheaegselt kasutatavate haagiste telgede arv ja nimetatud haagiste suurim mass, mis on kantud liiklusregistrisse, samuti kande tegemise kuupäev; veoauto mark; veoauto veoteljel õhkvedrustuse või sellega samaväärse vedrustuse olemasolu või puudumine; veoauto telgede arv; veoauto registreerimise, registrikande muutmise või registrist kustutamise kuupäev. (3) Kui liiklusregistris maksustamise aluseks olevad raskeveoki või maksumaksja andmed maksustamisperioodi jooksul muutuvad, on Maanteeamet kohustatud sellest Maksu- ja Tolliametile teatama maksustamisperioodile järgneva kuu 10. kuupäevaks. (4) Maksu- ja Tolliametil on õigus nõuda raskeveoki omanikult või valdajalt Maanteeametile esitatud andmete korrigeerimist.",
      "rdfs:label": {
        "@value": "RVMS_Par_9 (redaktsioon 107122018015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107122018015",
      "estleg:supersededByVersion": {
        "@id": "estleg:RVMS_Par_9_v110122020026"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RVMS_Par_9_v110122020026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raskeveokimaksu maksuhaldur on Maksu- ja Tolliamet. (2) Transpordiamet on kohustatud esitama Maksu- ja Tolliametile iga maksustamisperioodi esimese kuu 10. kuupäevaks eelmisel maksustamisperioodil liiklusregistris registreeritud või sellest kustutatud raskeveokite kohta järgmised andmed: veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja nimi (füüsilise isiku puhul ees- ja perekonnanimi); veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja isikukood (selle puudumisel isiku sünnikuupäev, -kuu ja -aasta) või registrikood; veoauto omaniku või käesoleva seaduse § 3 lõigetes 11 ja 2 nimetatud juhtudel valdaja elu- või asukoha aadress; veoauto registreerimismärgi andmed; veoauto registri- või täismass; autorongi koosseisus üheaegselt kasutatavate haagiste telgede arv ja nimetatud haagiste suurim mass, mis on kantud liiklusregistrisse, samuti kande tegemise kuupäev; veoauto mark; veoauto veoteljel õhkvedrustuse või sellega samaväärse vedrustuse olemasolu või puudumine; veoauto telgede arv; veoauto registreerimise, registrikande muutmise või registrist kustutamise kuupäev. (3) Kui liiklusregistris maksustamise aluseks olevad raskeveoki või maksumaksja andmed maksustamisperioodi jooksul muutuvad, on Transpordiamet kohustatud sellest Maksu- ja Tolliametile teatama maksustamisperioodile järgneva kuu 10. kuupäevaks. (4) Maksu- ja Tolliametil on õigus nõuda raskeveoki omanikult või valdajalt Transpordiametile esitatud andmete korrigeerimist.",
      "rdfs:label": {
        "@value": "RVMS_Par_9 (redaktsioon 110122020026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020026"
    },
    {
      "@id": "estleg:RVMS_Par_9_1_v107122018015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_9_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksu- ja Tolliamet võib teha hoiatuse, et käesoleva seaduse § 9 lõikes 2 nimetatud andmete tähtajaks esitamata jätmise korral või valeandmete esitamise korral võidakse rakendada sunniraha. (2) Kui isik ei täida kohustust hoiatuses märgitud tähtajaks, peab ta tasuma hoiatuses märgitud sunniraha. (3) Selle kohustuse täitmisele sundimiseks ei või sunniraha esimesel korral ületada 1300 eurot ja teisel korral 2000 eurot. Sellesama kohustuse täitmisele sundimiseks kasutatav sunniraha ei või ületada 3300 eurot.",
      "rdfs:label": {
        "@value": "RVMS_Par_9_1 (redaktsioon 107122018015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107122018015"
    }
  ]
}
