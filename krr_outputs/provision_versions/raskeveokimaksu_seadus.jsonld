      },
      "estleg:versionValidTo": {
        "@value": "2010-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RVMS_Par_8_v13321214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RVMS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raskeveokimaksust on vabastatud kaitseväe, Kaitseliidu, politseiasutuste ja päästeasutuste raskeveokid ning päästetöid tegeva kohaliku omavalitsuse, mittetulundusühingu, sihtasutuse või ettevõtja raskeveokid, mida kasutatakse peamiselt päästetööl.",
      "rdfs:label": {
        "@value": "RVMS_Par_8 (redaktsioon 13321214)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13321214",
