      "estleg:provisionRef": "ATKE § 33_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_33_1_v116062017004",
      "@type": [
        "owl:NamedIndividual",
