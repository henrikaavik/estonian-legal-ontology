      }
    },
    {
      "@id": "estleg:ATKE_Par_49_3_v116122022023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_49_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sertifitseeritud kaubasaaja või alkoholi importija, kes ei ole aktsiisilaopidaja ega registreeritud kaubasaaja, peab esitama tagatise aktsiisisumma ulatuses, mis kuulub maksmisele maksumärgistatavalt alkoholilt. Tagatissumma suurus peab võimaldama tekkida võiva või tekkinud maksukohustuse täitmise kogu tagatava perioodi vältel. (2) Käesolevas paragrahvis nimetatud tagatise puhul kohaldatakse käesoleva seaduse § 31 lõikes 3 sätestatut.",
      "rdfs:label": {
        "@value": "ATKE_Par_49_3 (redaktsioon 116122022023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116122022023",
