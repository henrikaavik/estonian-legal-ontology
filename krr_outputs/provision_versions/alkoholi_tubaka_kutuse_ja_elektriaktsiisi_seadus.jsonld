      }
    },
    {
      "@id": "estleg:ATKE_Par_79_1_v120062014008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_79_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksu- ja Tolliamet võib jätta aktsiisikauba järelevalve alla, kui selle aktsiisikauba mitte-eesmärgipärane kasutamine toob kaasa maksukohustuse tekkimise või suurenemise. (2) Aktsiisikauba järelevalve alla jätmise kohta väljastab Maksu- ja Tolliamet aktsiisikauba saajale või tema esindajale või omanikule või tema esindajale elektroonse teate, kuhu märgitakse aktsiisikaubaga lubatud toiming. Kokkuleppel kohustatud isikuga võib Maksu- ja Tolliamet väljastada kirjaliku teate. (3) Järelevalve alla jäetud aktsiisikaupa võib lähetada Maksu- ja Tolliameti loal. (4) Aktsiisikauba järelevalve alla jätmise ja järelevalve lõpetamise kord kehtestatakse määrusega.",
      "rdfs:label": {
        "@value": "ATKE_Par_79_1 (redaktsioon 120062014008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062014008",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_79_1_v107122018031"
      },
      "estleg:versionValidTo": {
        "@value": "2019-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062014008",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 79_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_79_1_v107122018031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_79_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksu- ja Tolliamet võib jätta aktsiisikauba järelevalve alla, kui selle müük, müügiks pakkumine või kasutamine võib kaasa tuua maksukohustuse tekkimise või suurenemise. (2) Aktsiisikauba järelevalve alla jätmise kohta annab Maksu- ja Tolliamet kohustatud isikule otsuse, kuhu märgitakse aktsiisikauba kasutusotstarve ning järelevalve teostamise tingimused. Otsus toimetatakse kätte maksukorralduse seaduses sätestatud korras. (2¹) Järelevalve teostamisel võib Maksu- ja Tolliamet rakendada maksukorralduse seaduse 6. peatükis sätestatud meetmeid. (3) Järelevalve alla jäetud aktsiisikauba kasutamiseks muul otstarbel kui on käesoleva paragrahvi lõikes 2 nimetatud otsuses märgitud, samuti kauba võõrandamiseks või veoks on vajalik Maksu- ja Tolliameti luba. Järelevalve teostamise tingimuste rikkumise ja kauba järelevalve alt väljumise korral kohaldatakse kohustatud isiku suhtes käesoleva seaduse § 22 lõike 1 punkti 4 ja § 24 lõiget 12. Järelevalve alt väljunud aktsiisikaup loetakse kasutatuks viisil, millel on võimalikest suurim maksumäär. (4) Aktsiisikauba järelevalve alla jätmise ja järelevalve lõpetamise kord kehtestatakse määrusega.",
      "rdfs:label": {
        "@value": "ATKE_Par_79_1 (redaktsioon 107122018031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107122018031",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107122018031",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 79_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_79_2_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_79_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksu- ja Tolliamet lõpetab järelevalve aktsiisikauba üle, kui: see ei ole enam põhjendatud, arvestades käesoleva seaduse § 79 1 lõikes 1 sätestatut; aktsiisikaup on eesmärgipäraselt ära kasutatud; aktsiisikaubalt on aktsiis tasutud; aktsiisikaup on hävinud ettenägematu olukorra tõttu ja hävimine on tõendatud Maksu- ja Tolliametit rahuldavalt. (2) Isik taotleb järelevalve alla jäetud aktsiisikauba mitte-eesmärgipäraseks kasutamiseks Maksu- ja Tolliametilt eelnevalt luba.",
      "rdfs:label": {
        "@value": "ATKE_Par_79_2 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_79_2_v130122010006"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 79_2",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_79_2_v130122010006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_79_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksu- ja Tolliamet lõpetab järelevalve aktsiisikauba üle, kui: see ei ole enam põhjendatud, arvestades käesoleva seaduse § 791 lõikes 1 sätestatut; aktsiisikaup on eesmärgipäraselt ära kasutatud; aktsiisikaubalt on aktsiis tasutud; aktsiisikaup on hävinud ettenägematu olukorra tõttu ja hävimine on tõendatud Maksu- ja Tolliametit rahuldavalt. (2) Isik taotleb järelevalve alla jäetud aktsiisikauba mitte-eesmärgipäraseks kasutamiseks Maksu- ja Tolliametilt eelnevalt luba.",
      "rdfs:label": {
        "@value": "ATKE_Par_79_2 (redaktsioon 130122010006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122010006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122010006",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 79_2",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_8_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiisikauba võõrandamine käesoleva seaduse mõistes on aktsiisikauba müük, vahetamine või tasuta üleandmine, samuti aktsiisikauba andmine tööandja poolt töötajale või juhtimis- või kontrollorgani liikmele.",
      "rdfs:label": {
        "@value": "ATKE_Par_8 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
