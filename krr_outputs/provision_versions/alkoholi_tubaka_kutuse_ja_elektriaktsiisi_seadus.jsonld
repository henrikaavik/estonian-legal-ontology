    {
      "@id": "estleg:ATKE_Par_9_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiisikauba importija käesoleva seaduse mõistes on isik, kelle poolt või kelle nimel deklareeritakse aktsiisikaup vabasse ringlusse lubamise tolliprotseduurile EÜNi määruse nr 2913/92/EMÜ (edaspidi ühenduse tolliseadustik) mõistes.",
      "rdfs:label": {
        "@value": "ATKE_Par_9 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
