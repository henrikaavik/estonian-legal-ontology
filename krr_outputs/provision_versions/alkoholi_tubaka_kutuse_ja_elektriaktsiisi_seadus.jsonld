    {
      "@id": "estleg:ATKE_Par_5_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiisikauba ladustamine käesoleva seaduse mõistes on aktsiisikauba hoidmine isiku või asutuse valduses.",
      "rdfs:label": {
        "@value": "ATKE_Par_5 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 5",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
