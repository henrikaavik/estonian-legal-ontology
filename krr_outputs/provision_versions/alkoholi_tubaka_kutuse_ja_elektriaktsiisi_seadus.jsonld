    {
      "@id": "estleg:ATKE_Par_18_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sigarettide maksimaalne jaehind on sigarettide müügipakendile kinnitatud maksumärgile trükitud hind, mis sisaldab aktsiisi vastavalt käesoleva seaduse § 56 lõikes 1 sätestatud määrale ja käibemaksu.",
      "rdfs:label": {
        "@value": "ATKE_Par_18 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_18_v108032012004"
      },
      "estleg:versionValidTo": {
        "@value": "2012-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 18",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_18_v108032012004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sigarettide maksimaalne jaehind on sigarettide müügipakendile või käesolevas seaduses sätestatud juhtudel sigarettide rühmapakendile kinnitatud maksumärgile trükitud hind, mis sisaldab aktsiisi vastavalt käesoleva seaduse § 56 lõigetes 1 ja 11 sätestatud määradele ja käibemaksu.",
      "rdfs:label": {
        "@value": "ATKE_Par_18 (redaktsioon 108032012004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108032012004",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_18_v116062017004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108032012004",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 18",
