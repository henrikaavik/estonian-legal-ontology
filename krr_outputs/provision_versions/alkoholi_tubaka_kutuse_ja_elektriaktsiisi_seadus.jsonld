      }
    },
    {
      "@id": "estleg:ATKE_Par_41_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsiisilao tegevusloa, registreeritud kaupleja tegevusloa või maksuesindaja tegevusloa väljastamisel selle taotlejale registreerib Maksu- ja Tolliamet ta Maksu- ja Tolliameti elektroonses infosüsteemis, andes talle vastavalt aktsiisilaopidaja, registreeritud kaupleja või maksuesindaja numbri. (2) Infosüsteemi kantavad andmed ning aktsiisilaopidaja, registreeritud kaupleja ja maksuesindaja numbrite kombinatsioon (3) Maksu- ja Tolliamet väljastab informatsiooni isiku aktsiisilaopidaja, registreeritud kaupleja või maksuesindajana registreerituse kohta. (4) Maksu- ja Tolliamet väljastab teise liikmesriigi pädevale riigiasutusele järgmised infosüsteemi kantavad andmed: aktsiisilaopidaja ja registreeritud kaupleja number; aktsiisilaopidaja ja registreeritud kaupleja aadress; aktsiisikauba liik, mida aktsiisilaopidaja või registreeritud kaupleja võib vastu võtta; aktsiisilao või registreeritud kaupleja tegevuskoha üle järelevalvet teostava Maksu- ja Tolliameti piirkondliku struktuuriüksuse aadress; aktsiisilaopidaja ja registreeritud kaupleja tegevusloa väljastamise kuupäev ja kehtivusaeg. (5) Käesoleva paragrahvi lõikes 1 nimetatud infosüsteemi kantavad andmed on osa maksukohustuslaste registrist vastavalt maksukorralduse seadusele.",
      "rdfs:label": {
        "@value": "ATKE_Par_41 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_41_v13279879"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 41",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_41_v13279879",
      "@type": [
        "owl:NamedIndividual",
