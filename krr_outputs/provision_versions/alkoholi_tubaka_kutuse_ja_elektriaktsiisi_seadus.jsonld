    },
    {
      "@id": "estleg:ATKE_Par_85_1_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliamet võib väljastada käesoleva seaduse § 38 lõikes 3 nimetatud aktsiisilao tegevusloa ja registreeritud kaupleja tegevusloa, § 53 lõikes 5 nimetatud alkoholi aktsiisivabastuse loa, § 581 lõikes 5 nimetatud tubakatoodete aktsiisivabastuse loa, § 72 lõikes 4 nimetatud kütuse aktsiisivabastuse loa ja § 77 lõikes 4 nimetatud kemikaalikäitleja aktsiisivabastuse loa enne Eesti liitumist Euroopa Liiduga.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_1 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_85_1_v13279879"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_1_v13279879",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliamet võib väljastada käesoleva seaduse § 38 lõikes 3 nimetatud aktsiisilao tegevusloa ja registreeritud kaubasaaja tegevusloa, § 53 lõikes 5 nimetatud alkoholi aktsiisivabastuse loa, § 581 lõikes 5 nimetatud tubakatoodete aktsiisivabastuse loa, § 72 lõikes 4 nimetatud kütuse aktsiisivabastuse loa ja § 77 lõikes 4 nimetatud kemikaalikäitleja aktsiisivabastuse loa enne Eesti liitumist Euroopa Liiduga.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_1 (redaktsioon 13279879)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13279879",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13279879",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_10_v108032012004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2011. aasta 17. novembrit tarbimisse lubatud sigarettidelt, mis ei vasta Euroopa Standardikomitee standardis EN 16156:2010 „Sigaretid. Süütevõime hindamine. Ohutusnõue” sätestatud ohutusnõuetele, tagastatakse aktsiis maksumärgi tagastamisel. Nimetatud maksumärgid peab tagastama kolme kalendrikuu jooksul käesoleva sätte jõustumisest arvates.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_10 (redaktsioon 108032012004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108032012004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108032012004",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_10",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_11_v120062014008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiisikauba veol on SADHESi kaudu esitatava saatelehe asemel lubatud kasutada enne 2014. aasta 1. juulit kehtinud saatelehte kuni 2014. aasta 30. septembrini.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_11 (redaktsioon 120062014008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062014008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062014008",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_11",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_12_v117122015016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus esitab Riigikogule hiljemalt 2018. aasta 1. märtsil analüüsi ja vajaduse korral ettepaneku aktsiisimäära muutmiseks, kui käesolevas seaduses sätestatud või käesoleva seaduse 2015. aasta juunis vastu võetud muudatustega võivad kaasneda ootustele mittevastavad negatiivse mõjuga asjaolud, muu hulgas rahva tervisele, tarbimisele, ettevõtlusele või aktsiisi laekumisele.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_12 (redaktsioon 117122015016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117122015016",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_12",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_13_v116062017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jaehinnast sõltuva aktsiisimäära rakendamise aastal arvutatakse maksumärgistamata sigarite ja sigarillode aktsiis, lähtudes nende minimaalselt makstavast aktsiisisummast.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_13 (redaktsioon 116062017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116062017004",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_13",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_14_v116062017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne 2018. aasta 1. jaanuari Eestis vabas ringluses väljaspool aktsiisiladu olevate maksumärgistamata alternatiivsete tubakatoodete müük on lubatud 2018. aasta 31. märtsini. (2) Sigareid ja sigarillosid, mis on lubatud tarbimisse enne 2018. aasta 1. jaanuari, on lubatud müüa kuni 2019. aasta 31. detsembrini. (3) Käesoleva seaduse §-s 45 nimetatud saateleht ei ole nõutav alternatiivsete tubakatoodete veol, kui vedu algas enne 2018. aasta 1. jaanuari.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_14 (redaktsioon 116062017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017004",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_85_14_v123122019006"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116062017004",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_14",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_14_v123122019006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne 2018. aasta 1. jaanuari Eestis vabas ringluses väljaspool aktsiisiladu olevate maksumärgistamata alternatiivsete tubakatoodete müük on lubatud 2018. aasta 31. märtsini. (2) Sigareid ja sigarillosid, mis on lubatud tarbimisse enne 2018. aasta 1. jaanuari, on lubatud müüa kuni 2019. aasta 31. detsembrini. Käesolevas lõikes nimetatud toodetelt tagastatakse aktsiis maksukorralduse seaduse § 33 lõike 1 alusel, kui on täidetud mõlemad järgmised tingimused: nendele toodetele on aktsiisilaos kinnitatud 2020. aastal kehtivad maksumärgid ja makstud on kehtiv aktsiis; maksuhaldurile on tagastatud nendele toodetele kinnitatud maksumärgid või enne uute maksumärkide kinnitamist toodetele kirjalikult teatatud varem kinnitatud maksumärkide koodid, nendele maksumärkidele trükitud tubakatoote liigi tähistused ja tubakatoote kogused müügipakendis. (3) Käesoleva seaduse §-s 45 nimetatud saateleht ei ole nõutav alternatiivsete tubakatoodete veol, kui vedu algas enne 2018. aasta 1. jaanuari.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_14 (redaktsioon 123122019006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122019006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122019006",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_14",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_15_v107122018030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Energia aktsiisivabastuse luba omav või omanud elektrointensiivne ettevõtja võib taotleda 2019. aasta jooksul elektrienergia aktsiisi osalist tagastamist elektrienergia koguselt, mis tarbiti perioodil, mis algas ajavahemikus 2018. aasta 1. jaanuarist kuni energia aktsiisivabastuse loa väljastamise kuupäevani ja mis lõppes nimetatud loa väljastamise kuupäeval ning mille kestel oli ettevõtja elektrointensiivsus keskmiselt vähemalt 20 protsenti ja mille kestel ta vastas muudele käesoleva seaduse § 202 lõikes 3 sätestatud tingimustele, arvestades, et nimetatud lõike punktile 2 vastavuse hindamisel loetakse elektrointensiivse ettevõtja energiajuhtimissüsteem standardile EVS-EN ISO 50001 vastavaks 180 kalendripäeva varem, kui tema energiajuhtimissüsteem nimetatud standardile vastavaks tunnistati. (2) Elektrienergia aktsiisi osaliseks tagastamiseks esitab taotleja Maksu- ja Tolliametile taotluse, mis sisaldab järgmisi andmeid ning dokumente: taotleja nimi ja registrikood, asukoha ja tegevuskoha aadressid, kontaktandmed ning pangarekvisiidid; ajavahemik, mille jooksul tarbitud elektrienergialt aktsiisi osalist tagastamist taotletakse, ning selle elektrienergia kasutusala; võrguettevõtja või liinivaldaja kinnitus käesoleva lõike punktis 2 nimetatud perioodil ettevõtjale edastatud aktsiisiga maksustatud elektrienergia saldeeritud koguse kohta megavatt-tundides; elektrointensiivse ettevõtja enda käesoleva lõike punktis 2 nimetatud perioodil toodetud ja tarbitud elektrienergia kogus, mis on mõõdetud ning aktsiisiga maksustatud, megavatt-tundides; taotletav tagastussumma, mis leitakse, liites käesoleva lõike punktides 3 ja 4 nimetatud elektrienergia kogused megavatt-tundides ning korrutades saadud koguse tarbimise ajal kehtinud käesoleva seaduse § 66 lõikes 12 sätestatud elektrienergia aktsiisimäära ja elektrienergia soodusaktsiisimäära vahega; käesoleva seaduse § 693 lõike 11 punktis 2 nimetatud sõltumatu vandeaudiitori põhjendatud kindlustunnet väljendav aruanne käesoleva lõike punktis 2 nimetatud perioodi kohta. (3) Maksuhalduril on õigus nõuda taotluse esitajalt lisaks käesoleva paragrahvi lõikes 2 nimetatule täiendavaid asjassepuutuvaid dokumente. (4) Elektrienergia aktsiisi osalise tagastamise või sellest keeldumise otsus tehakse 30 päeva jooksul käesolevas paragrahvis nimetatud nõuetekohaste dokumentide ja andmete esitamise päevast arvates. (5) Elektrienergia aktsiisi ühekordne osaline tagastamine elektrointensiivsele ettevõtjale on riigiabi vastavalt käesoleva seaduse § 66 lõikes 122 sätestatule.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_15 (redaktsioon 107122018030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107122018030",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107122018030",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_15",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_16_v123122020006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 2020. aasta 12. märtsil väljakuulutatud eriolukorra tõttu kehtivad 2020. aasta 1. maist kuni 2022. aasta 30. aprillini järgmised aktsiisimäärad: vedelgaasi aktsiisimäär on 55 eurot 1000 kilogrammi vedelgaasi kohta; diislikütuse aktsiisimäär on 372 eurot 1000 liitri diislikütuse kohta; eriotstarbelise diislikütuse aktsiisimäär on 100 eurot 1000 liitri eriotstarbelise diislikütuse kohta; kerge kütteõli aktsiisimäär on 372 eurot 1000 liitri kerge kütteõli kohta; raske kütteõli aktsiisimäär on 422 eurot 1000 kilogrammi raske kütteõli kohta; põlevkivikütteõli aktsiisimäär on 414 eurot 1000 kilogrammi põlevkivikütteõli kohta; maagaasi aktsiisimäär on 40 eurot 1000 m3 maagaasi kohta; mootorimaagaasi aktsiisimäär on 40 eurot 1000 m3 mootorimaagaasi kohta; veeldatud olekus mootorimaagaasi aktsiisimäär on 55,79 eurot 1000 kilogrammi nimetatud kütuse kohta; elektrienergia aktsiisimäär on 1 euro ühe megavatt-tunni elektrienergia kohta; kütuse, mille KNi kaheksa numbrit on 2710 19 31 või 2710 19 35, aktsiisimäär on 372 eurot 1000 liitri kütuse kohta.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_16 (redaktsioon 123122020006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122020006",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_85_16_v130122021004"
      },
      "estleg:versionValidTo": {
        "@value": "2022-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122020006",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_16",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_16_v130122021004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
