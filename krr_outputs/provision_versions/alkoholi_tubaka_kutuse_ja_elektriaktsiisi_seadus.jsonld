      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiisikauba tarbimisse lubamine käesoleva seaduse mõistes on ajutise aktsiisivabastuse lõpetamine ning tootmine, import või aktsiisiga maksustamata aktsiisikauba valdamine ajutise aktsiisivabastuseta.",
      "rdfs:label": {
