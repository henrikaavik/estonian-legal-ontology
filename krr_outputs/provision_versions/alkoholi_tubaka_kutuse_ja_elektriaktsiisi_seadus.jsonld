      }
    },
    {
      "@id": "estleg:ATKE_Par_65_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tagastada saab maksumärke: mida ei ole tubakatootele või selle müügipakendile kinnitatud; mis on rikutud maksumärgistamisel ja millest on säilinud vähemalt 80 protsenti; mis on kinnitatud tarvitamata tubakatootele või selle müügipakendile ja maksumärkide saaja tõendab Maksu- ja Tolliametit rahuldavalt, et tubakatoode on tarvitamata. (3) Tagastamise eesmärgil on lubatud maksumärk eemaldada tubakatootelt või selle müügipakendilt ainult tollijärelevalve all. Maksumärk loetakse tagastatuks ka juhul, kui see on hävitatud Maksu- ja Tolliameti esindajate juuresolekul.",
      "rdfs:label": {
        "@value": "ATKE_Par_65 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_65_v13076672"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 65",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
