      "estleg:provisionRef": "ATKE § 49_3",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_49_4_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_49_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 491 lõikes 2 nimetatud alkoholi importimisel tuleb koos tollideklaratsiooniga esitada maksumärkide saateleht, välja arvatud juhul, kui alkohol ei ole maksumärgistatud.",
      "rdfs:label": {
        "@value": "ATKE_Par_49_4 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
