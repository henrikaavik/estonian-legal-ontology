      }
    },
    {
      "@id": "estleg:ATKE_Par_85_17_v123122020006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_85_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alates 2021. aasta 1. aprillist kuni 2022. aasta 31. detsembrini ei maksustata aktsiisiga nikotiinisisaldusega ja ilma nikotiinisisalduseta tubakavedelikke ning nimetatud perioodil ei kohaldata tubakavedelike puhul alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadust. (2) Käesoleva paragrahvi lõikes 1 nimetatud ajavahemikul ei teki tubakavedelike maksumärkidelt aktsiisi maksmise kohustust. (3) Maksuhaldur ei võta vastu tubakavedelike maksumärkide tellimusi, mille täitmise tähtpäev on pärast 2021. aasta 31. märtsi. Maksuhaldur alustab tubakavedelike maksumärkide tellimuste vastuvõtmist hiljemalt 2022. aasta 1. novembril.",
      "rdfs:label": {
        "@value": "ATKE_Par_85_17 (redaktsioon 123122020006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122020006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122020006",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_17",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_85_18_v130122021003",
