      "estleg:provisionRef": "ATKE § 27",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_27_v118112022004",
      "@type": [
        "owl:NamedIndividual",
