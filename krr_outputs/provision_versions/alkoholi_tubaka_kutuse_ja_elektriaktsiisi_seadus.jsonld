    {
      "@id": "estleg:ATKE_Par_28_v108032012004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_28"
      },
      "estleg:versionValidFrom": {
