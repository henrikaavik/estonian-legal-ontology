    },
    {
      "@id": "estleg:ATKE_Par_1_1_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Ühenduse (edaspidi EÜ) territooriumina käsitatakse käesoleva seaduse mõistes EÜNi direktiivi 92/12/EMÜ artiklis 2 määratletud territooriumi, mille suhtes kohaldatakse nimetatud direktiivi. (2) Liikmesriik käesoleva seaduse mõistes on riik või territoorium, mis asub EÜ territooriumil. (3) Ühenduseväline riik käesoleva seaduse mõistes on riik või territoorium, mis asub väljaspool EÜ territooriumi.",
      "rdfs:label": {
        "@value": "ATKE_Par_1_1 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_1_1_v13279879"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 1_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_1_1_v13279879",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Ühenduse (edaspidi EÜ) territooriumina käsitatakse käesoleva seaduse mõistes EÜ mis tahes liikmesriigi territooriumi, kus kohaldatakse Euroopa Ühenduse asutamislepingut vastavalt selle artiklile 299, arvestades nõukogu direktiivi 2008/118/EÜ, mis käsitleb aktsiisi üldist korda ja millega tunnistatakse kehtetuks direktiiv 92/12/EMÜ (ELT L 9, 14.1.2009, lk 12–30), artiklites 5 ja 6 sätestatut. (2) Liikmesriik käesoleva seaduse mõistes on riik või territoorium, mis asub EÜ territooriumil. (3) Ühenduseväline riik käesoleva seaduse mõistes on riik või territoorium, mille suhtes Euroopa Ühenduse asutamislepingut ei kohaldata, ja territoorium, mis on nimetatud nõukogu direktiivi 2008/118/EÜ artikli 5 lõikes 2 või 3.",
      "rdfs:label": {
        "@value": "ATKE_Par_1_1 (redaktsioon 13279879)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13279879",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_1_1_v108032012004"
      },
      "estleg:versionValidTo": {
        "@value": "2012-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13279879",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 1_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_1_1_v108032012004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Liidu territooriumina (edaspidi liidu territoorium) käsitatakse käesoleva seaduse tähenduses Euroopa Liidu mis tahes liikmesriigi territooriumi, kus kohaldatakse Euroopa Liidu toimimise lepingut vastavalt selle artiklile 52, arvestades nõukogu direktiivi 2008/118/EÜ, mis käsitleb aktsiisi üldist korda ja millega tunnistatakse kehtetuks direktiiv 92/12/EMÜ (ELT L 9, 14.1.2009, lk 12–30), artiklites 5 ja 6 sätestatut. (2) Liikmesriik käesoleva seaduse mõistes on riik või territoorium, mis asub liidu territooriumil. (3) Euroopa Liidu väline (edaspidi liiduväline) riik käesoleva seaduse tähenduses on riik või territoorium, mille suhtes Euroopa Liidu toimimise lepingut ei kohaldata, ja territoorium, mis on nimetatud nõukogu direktiivi 2008/118/EÜ artikli 5 lõikes 2 või 3.",
      "rdfs:label": {
        "@value": "ATKE_Par_1_1 (redaktsioon 108032012004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108032012004",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_1_1_v116122022023"
      },
      "estleg:versionValidTo": {
        "@value": "2023-02-12",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108032012004",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 1_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_1_1_v116122022023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Liidu territooriumina (edaspidi liidu territoorium) käsitatakse käesoleva seaduse tähenduses Euroopa Liidu mis tahes liikmesriigi territooriumi, kus kohaldatakse Euroopa Liidu aluslepinguid kooskõlas Euroopa Liidu toimimise lepingu artiklitega 349 ja 355, välja arvatud kolmandad territooriumid. (2) Liikmesriik käesoleva seaduse tähenduses on riik või territoorium, mis asub liidu territooriumil. (2¹) Kolmandad territooriumid käesoleva seaduse tähenduses on nõukogu direktiivi (EL) 2020/262, millega nähakse ette aktsiisi üldine kord (uuesti sõnastatud) (ELT L 58, 27.02.2020, lk 4−42), artikli 4 lõigetes 2 ja 3 nimetatud territooriumid. (3) Euroopa Liidu väline (edaspidi liiduväline) riik käesoleva seaduse tähenduses on riik või territoorium, mille suhtes Euroopa Liidu aluslepinguid ei kohaldata, ja kolmandad territooriumid. (4) Sihtliikmesriik käesoleva seaduse tähenduses on liikmesriik, kuhu aktsiisikaup tarnitakse või kus seda kasutatakse.",
      "rdfs:label": {
        "@value": "ATKE_Par_1_1 (redaktsioon 116122022023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116122022023",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116122022023",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 1_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_2_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiisiladu käesoleva seaduse mõistes on koht, kus aktsiisilaopidajal on õigus käesolevas seaduses sätestatud korras ajutises aktsiisivabastuses toota, ladustada, vastu võtta ja lähetada aktsiisikaupa.",
      "rdfs:label": {
        "@value": "ATKE_Par_2 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 2",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_20_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kütusesarnane toode käesoleva seaduse mõistes on toode, mille KNi esimesed neli, esimesed kuus või KNi kaheksa numbrit on 2707 10, 2707 20, 2707 30, 2707 50, 2710 11 11–2710 11 25, 2710 11 90, 2710 19 11, 2710 19 15, 2710 19 31, 2710 19 35, 2710 19 51, 2710 19 55, 2711 12–2711 14 ja mida kasutatakse mootorikütusena, kaasa arvatud statsionaarses mootoris, ex 2901 (ained, mis atmosfäärirõhul ja 15 oC juures ei ole gaasilises olekus), 2902 20 00, 2902 30 00, 2902 41 00, 2902 42 00, 2902 43 00 ja 2902 44 00.",
      "rdfs:label": {
        "@value": "ATKE_Par_20 (redaktsioon 12906565)",
        "@language": "et"
