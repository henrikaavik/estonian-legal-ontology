    {
      "@id": "estleg:ATKE_Par_49_5_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_49_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tagastada saab maksumärke: mida ei ole alkoholi müügipakendile kinnitatud; mis on rikutud maksumärgistamisel ja millest on säilinud vähemalt 80 protsenti; mis on kinnitatud alkoholi avamata müügipakendile.",
      "rdfs:label": {
        "@value": "ATKE_Par_49_5 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
