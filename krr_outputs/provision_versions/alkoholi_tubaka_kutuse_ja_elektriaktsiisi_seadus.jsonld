    {
      "@id": "estleg:ATKE_Par_57_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vähemalt 18 aasta vanusel reisijal on lubatud väljastpoolt EÜ territooriumi ühe päeva jooksul esmakordsel Eestisse saabumisel mitteärilisel eesmärgil kasutamiseks aktsiisivabalt toimetada Eestisse koos temaga liikuvas pagasis tubakatooteid mitte rohkem kui 200 sigaretti või 100 sigarillot või 50 sigarit või 250 grammi suitsetamistubakat või 250 grammi närimistubakat. (2) Eksituse tõttu ebaõigesse sihtpunkti saadetud pagasit käsitatakse selle jõudmisel Eestisse reisijaga koos liikuva pagasina.",
      "rdfs:label": {
        "@value": "ATKE_Par_57 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_57_v13074668"
      },
      "estleg:versionValidTo": {
        "@value": "2008-11-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 57",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_57_v13074668",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vähemalt 18 aasta vanusel reisijal on lubatud väljastpoolt EÜ territooriumi Eestisse saabumisel tuua ühe päeva jooksul koos temaga liikuvas pagasis aktsiisivabalt mitteärilisel eesmärgil kuni: 200 sigaretti; 100 sigarillot; 50 sigarit; 250 grammi suitsetamistubakat või 250 grammi närimistubakat. (1¹) Käesoleva paragrahvi lõike 1 punktides 1–5 nimetatud iga tubakatoote kogus moodustab 100 protsenti tubakatoodete aktsiisivabastusest. Ühe reisija puhul kohaldatakse aktsiisivabastust tubakatoodete mis tahes kombinatsiooni suhtes tingimusel, et üksikute aktsiisivabastuste protsentide kogusumma ei ületa 100 protsenti. (2) Eksituse tõttu ebaõigesse sihtpunkti saadetud pagasit käsitatakse selle jõudmisel Eestisse reisijaga koos liikuva pagasina.",
      "rdfs:label": {
        "@value": "ATKE_Par_57 (redaktsioon 13074668)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13074668",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_57_v13197100"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13074668",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 57",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
