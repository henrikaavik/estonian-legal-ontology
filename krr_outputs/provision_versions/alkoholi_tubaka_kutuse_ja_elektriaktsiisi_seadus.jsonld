      },
      "estleg:versionText": "- kehtis kuni 30.04.2022",
      "rdfs:label": {
        "@value": "ATKE_Par_85_16 (redaktsioon 130122021004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122021004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122021004",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 85_16",
      "estleg:partOfAct": {
