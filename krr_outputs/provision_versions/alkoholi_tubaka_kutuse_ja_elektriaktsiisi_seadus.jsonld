    {
      "@id": "estleg:ATKE_Par_58_v12906565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiisivabalt on lubatud mitteärilisel eesmärgil importida tubakatooteid mitte rohkem kui 50 sigaretti või 25 sigarillot või 10 sigarit või 50 grammi suitsetamistubakat või 50 grammi närimistubakat, kui on täidetud alljärgnevad tingimused: tubakatooted saadab ühendusevälises riigis elav füüsiline isik vähemalt 18 aasta vanusele füüsilisele isikule Eestis; tubakatooteid ei ole saadetud samale isikule rohkem kui kolm korda kalendriaastas.",
      "rdfs:label": {
        "@value": "ATKE_Par_58 (redaktsioon 12906565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906565",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_58_v13076672"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906565",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 58",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_58_v13076672",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATKE_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisel isikul on lubatud aktsiisivabalt importida käesoleva paragrahvi lõikes 2 nimetatud tingimustel tubakatooteid mitte rohkem kui 50 sigaretti, 25 sigarillot, 10 sigarit, 50 grammi suitsetamistubakat või 50 grammi närimistubakat. (2) Aktsiisivabastuse kohaldamise tingimused on järgmised: tubakatooted saadab ühendusevälises riigis elav füüsiline isik vähemalt 18 aasta vanusele füüsilisele isikule Eestis; tubakatooteid saadetakse juhuti; tubakatooteid kasutatakse mitteärilisel eesmärgil; saadetise väärtus ei ületa 704 krooni; saadetise eest ei nõuta saajalt tasu.",
      "rdfs:label": {
        "@value": "ATKE_Par_58 (redaktsioon 13076672)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13076672",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATKE_Par_58_v130122010006"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13076672",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 58",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
