      "estleg:provisionRef": "ATKE § 69_3",
      "estleg:partOfAct": {
        "@id": "estleg:ATKE_Map_2026"
      }
    },
    {
      "@id": "estleg:ATKE_Par_69_3_v13278401",
      "@type": [
        "owl:NamedIndividual",
