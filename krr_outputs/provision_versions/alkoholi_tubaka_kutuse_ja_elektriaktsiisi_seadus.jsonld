        "@value": "2023-02-12",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116062017003",
      "estleg:sourceAct": "Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadus",
      "estleg:provisionRef": "ATKE § 10",
      "estleg:partOfAct": {
