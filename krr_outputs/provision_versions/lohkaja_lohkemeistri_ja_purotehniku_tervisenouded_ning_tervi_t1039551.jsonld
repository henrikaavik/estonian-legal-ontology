      }
    },
    {
      "@id": "estleg:Reg_1039551_Par_12_v1039551",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039551_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisetõend, mis on väljastatud enne käesoleva määruse jõustumist, kehtib tervisetõendil märgitud kuupäevani. Tervisetõend, mis on väljastatud enne käesoleva määruse jõustumist, kehtib tervisetõendil märgitud kuupäevani.",
      "rdfs:label": {
        "@value": "Reg_1039551_Par_12 (redaktsioon 1039551)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039551",
