      "estleg:provisionRef": "Reg_1046454 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046454_Par_5_v1046454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046454_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registriandmete turvaklass on K1T1S2. Registri turbeaste on keskmine (M). Registriandmete turvaklass on K1T1S2. Registri turbeaste on keskmine (M).",
      "rdfs:label": {
        "@value": "Reg_1046454_Par_5 (redaktsioon 1046454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046454",
      "estleg:sourceAct": "Riigi toidu ja sööda käitlejate registri põhimäärus",
      "estleg:provisionRef": "Reg_1046454 § 5",
