  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_eriolukorra_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eriolukorra seadus (54 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eriolukorra seadus"
    },
    {
      "@id": "estleg:EOS_Par_1_v22351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab loodusõnnetuse ja katastroofi korral ning nakkushaiguse leviku tõkestamisel vajalike abinõude rakendamiseks: eriolukorra väljakuulutamise aluse, tingimused ja korra ning eriolukorda korraldavate organite pädevuse; eriolukorra ajal rakendatavad abinõud ning isikute õigused, kohustused ja vastutuse eriolukorra ajal.",
      "rdfs:label": {
        "@value": "EOS_Par_1 (redaktsioon 22351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22351",
      "estleg:sourceAct": "Eriolukorra seadus",
      "estleg:provisionRef": "EOS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:EOS_Map_2026"
      }
    },
    {
      "@id": "estleg:EOS_Par_10_v22351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsust teavitavad loodusõnnetusest, katastroofist ja nakkushaiguse levikust riigiasutused ning valla- ja linnavalitsused Vabariigi Valitsuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "EOS_Par_10 (redaktsioon 22351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22351",
      "estleg:sourceAct": "Eriolukorra seadus",
      "estleg:provisionRef": "EOS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:EOS_Map_2026"
      }
    },
    {
      "@id": "estleg:EOS_Par_11_v22351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse moodustatud kriisikomisjoni ülesanded abinõude rakendamisel seoses loodusõnnetuse, katastroofi ja nakkushaiguse levikuga on: riikliku poliitika ja tegevuskavade väljatöötamine ohu prognoosimiseks, ennetamiseks ja kõrvaldamiseks; teabe analüüsimine ning analüüsitulemuste esitamine peaministrile koos ohu prognoosimise, ennetamise ja kõrvaldamise kavaga; arvamuse andmine Vabariigi Valitsusele ohueelse seisundi, tekkinud ohu iseloomu, ulatuse ja kõrvaldamise ning eriolukorra väljakuulutamise vajaduse kohta; arvamuse andmine Vabariigi Valitsusele ja eriolukorra juhile abinõude rakendamise kohta eriolukorra ajal, samuti eriolukorra lõpetamise vajaduse kohta.",
      "rdfs:label": {
        "@value": "EOS_Par_11 (redaktsioon 22351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22351",
      "estleg:sourceAct": "Eriolukorra seadus",
      "estleg:provisionRef": "EOS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:EOS_Map_2026"
      }
    },
    {
      "@id": "estleg:EOS_Par_12_v22351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eriolukorra väljakuulutamise otsustamiseks kutsub peaminister või tema äraolekul teda asendav minister viivitamatult kokku Vabariigi Valitsuse istungi, kus kuulatakse ära Vabariigi Valitsuse kriisikomisjoni arvamus eriolukorra väljakuulutamise vajaduse kohta. (2) Vabariigi Valitsuse määruse eelnõu eriolukorra väljakuulutamise kohta esitab Vabariigi Valitsusele otsustamiseks peaminister või tema äraolekul teda asendav minister. (3) Vabariigi Valitsus kuulutab eriolukorra välja kogu riigi või vastava maakonna, linna või valla territooriumil.",
      "rdfs:label": {
        "@value": "EOS_Par_12 (redaktsioon 22351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22351",
      "estleg:sourceAct": "Eriolukorra seadus",
      "estleg:provisionRef": "EOS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:EOS_Map_2026"
      }
    },
    {
      "@id": "estleg:EOS_Par_13_v22351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsuse määruses eriolukorra väljakuulutamise kohta sätestatakse: eriolukorra väljakuulutamine vastavalt Eesti Vabariigi põhiseaduse paragrahv 87 punktile 8; eriolukorra väljakuulutamise põhjus; eriolukorra piirkond; eriolukorra juhiks ministri nimetamine, kelle pädevusse kuulub põhiliste abinõude rakendamine eriolukorra väljakuulutamise põhjustanud sündmusest tuleneva ohu kõrvaldamiseks; valitsusasutused ning valla- ja linnavalitsused, kes on kohustatud rakendama abinõusid eriolukorra väljakuulutamise põhjustanud sündmusest tuleneva ohu kõrvaldamiseks ja kannatanute abistamiseks; muud eriolukorra ajal ja eriolukorra piirkonnas rakendatavad esialgsed abinõud vastavalt käesoleva seaduse paragrahv 18 1. lõikele; massiteabevahendite valdajate kohustus avaldada määrus viivitamatult ja muutmata kujul. (2) Vabariigi Valitsuse määrus eriolukorra väljakuulutamise kohta jõustub alates selle avaldamisest massiteabevahendites.",
      "rdfs:label": {
        "@value": "EOS_Par_13 (redaktsioon 22351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22351",
      "estleg:supersededByVersion": {
        "@id": "estleg:EOS_Par_13_v13124173"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22351",
      "estleg:sourceAct": "Eriolukorra seadus",
      "estleg:provisionRef": "EOS § 13",
      "estleg:partOfAct": {
        "@id": "estleg:EOS_Map_2026"
      }
    },
    {
      "@id": "estleg:EOS_Par_13_v13124173",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsuse määruses eriolukorra väljakuulutamise kohta sätestatakse: eriolukorra väljakuulutamine vastavalt Eesti Vabariigi põhiseaduse § 87 punktile 8; eriolukorra väljakuulutamise põhjus; eriolukorra piirkond; eriolukorra juhiks ministri nimetamine, kelle pädevusse kuulub põhiliste abinõude rakendamine eriolukorra väljakuulutamise põhjustanud sündmusest tuleneva ohu kõrvaldamiseks; valitsusasutused ning valla- ja linnavalitsused, kes on kohustatud rakendama abinõusid eriolukorra väljakuulutamise põhjustanud sündmusest tuleneva ohu kõrvaldamiseks ja kannatanute abistamiseks; muud eriolukorra ajal ja eriolukorra piirkonnas rakendatavad esialgsed abinõud vastavalt käesoleva seaduse § 18 1. lõikele; massiteabevahendite valdajate kohustus avaldada määrus viivitamatult ja muutmata kujul. (2) Vabariigi Valitsuse määrus eriolukorra väljakuulutamise kohta jõustub alates selle avaldamisest massiteabevahendites.",
      "rdfs:label": {
        "@value": "EOS_Par_13 (redaktsioon 13124173)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13124173",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13124173",
      "estleg:sourceAct": "Eriolukorra seadus",
