        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22351",
      "estleg:sourceAct": "Eriolukorra seadus",
      "estleg:provisionRef": "EOS § 17",
      "estleg:partOfAct": {
        "@id": "estleg:EOS_Map_2026"
      }
    },
    {
      "@id": "estleg:EOS_Par_17_v13124173",
