    {
      "@id": "estleg:EOS_Par_14_v22351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse määruse eriolukorra väljakuulutamise kohta avaldavad massiteabevahendite valdajad muutmata kujul viivitamatult.",
      "rdfs:label": {
        "@value": "EOS_Par_14 (redaktsioon 22351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22351",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22351",
      "estleg:sourceAct": "Eriolukorra seadus",
      "estleg:provisionRef": "EOS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:EOS_Map_2026"
      }
    },
    {
      "@id": "estleg:EOS_Par_15_v22351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsus võib eriolukorra ajal muuta eriolukorra piirkonda. Eriolukorra piirkonna laiendamist ei loeta uue eriolukorra väljakuulutamiseks. (2) Eriolukorra piirkonna muutmine sätestatakse Vabariigi Valitsuse määrusega ja sellest teavitatakse elanikkonda käesoleva seaduse paragrahvis 14 sätestatud korras. (3) Vabariigi Valitsuse määrus eriolukorra piirkonna muutmise kohta jõustub alates selle avaldamisest massiteabevahendites.",
      "rdfs:label": {
        "@value": "EOS_Par_15 (redaktsioon 22351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22351",
      "estleg:supersededByVersion": {
        "@id": "estleg:EOS_Par_15_v13124173"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22351",
      "estleg:sourceAct": "Eriolukorra seadus",
      "estleg:provisionRef": "EOS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:EOS_Map_2026"
      }
    },
    {
      "@id": "estleg:EOS_Par_15_v13124173",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsus võib eriolukorra ajal muuta eriolukorra piirkonda. Eriolukorra piirkonna laiendamist ei loeta uue eriolukorra väljakuulutamiseks. (2) Eriolukorra piirkonna muutmine sätestatakse Vabariigi Valitsuse määrusega ja sellest teavitatakse elanikkonda käesoleva seaduse §-s 14 sätestatud korras. (3) Vabariigi Valitsuse määrus eriolukorra piirkonna muutmise kohta jõustub alates selle avaldamisest massiteabevahendites.",
      "rdfs:label": {
        "@value": "EOS_Par_15 (redaktsioon 13124173)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13124173",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13124173",
      "estleg:sourceAct": "Eriolukorra seadus",
      "estleg:provisionRef": "EOS § 15",
      "estleg:partOfAct": {
