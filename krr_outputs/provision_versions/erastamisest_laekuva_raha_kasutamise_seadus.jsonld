      },
      "estleg:versionText": "[Kehtetud alates 1. 01. 2002 – vt. seaduse § 11 lõiget 6]",
      "rdfs:label": {
        "@value": "ELRKS_Par_36 (redaktsioon 694475)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "694475",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/694475",
