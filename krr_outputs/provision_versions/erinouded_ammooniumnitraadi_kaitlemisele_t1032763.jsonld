    {
      "@id": "estleg:Reg_1032763_Par_4_v1032763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032763_Par_4"
