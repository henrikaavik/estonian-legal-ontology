    {
      "@id": "estleg:Reg_1032763_Par_2_v1032763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032763_Par_2"
