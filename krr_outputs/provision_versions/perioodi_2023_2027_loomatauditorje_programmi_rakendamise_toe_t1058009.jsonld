      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andmise eesmärk on motiveerida koostööd põllumajandustootjate ja neid ühendavate tulundusühistute vahel eesmärgiga töötada välja majandusliku mõjuga loomataudide kontrolli- ja likvideerimisprogrammid. Toetuse andmise eesmärk on motiveerida koostööd põllumajandustootjate ja neid ühendavate tulundusühistute vahel eesmärgiga töötada välja majandusliku mõjuga loomataudide kontrolli- ja likvideerimisprogrammid.",
      "rdfs:label": {
        "@value": "Reg_1058009_Par_2 (redaktsioon 1058009)",
        "@language": "et"
      },
