      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Isikut tõendavate dokumentide seadus (477 versiooni)",
        "@language": "et"
      },
      "dc:source": "Isikut tõendavate dokumentide seadus"
    },
    {
      "@id": "estleg:ITD_Par_1_v22443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
