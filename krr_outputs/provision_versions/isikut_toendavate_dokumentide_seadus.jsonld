        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikut tõendava dokumendi väljaandmise taotluse läbivaatamise eest tasutakse riigilõivu riigilõivuseaduses sätestatud määra järgi.",
      "rdfs:label": {
        "@value": "ITD_Par_4_1 (redaktsioon 13184598)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13184598",
      "estleg:supersededByVersion": {
