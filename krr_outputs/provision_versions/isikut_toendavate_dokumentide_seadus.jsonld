      }
    },
    {
      "@id": "estleg:ITD_Par_27_v1003571",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välismaalase pass antakse välja välismaalasele, kellel on kehtiv Eesti elamisluba, ning kui on tõendatud, et välismaalasel puudub välisriigi reisidokument ja tal ei ole võimalik seda saada. (2) Kehtetu – (3) Välisriigi kodanikule välismaalase passi väljaandmiseks peab välismaalane esitama oma kodakondsusriigi pädeva ametiasutuse nõusoleku talle välismaalase passi väljaandmiseks või tõendama, et nimetatud nõusolekut ei ole võimalik saada.",
      "rdfs:label": {
        "@value": "ITD_Par_27 (redaktsioon 1003571)",
        "@language": "et"
      },
