      }
    },
    {
      "@id": "estleg:ITD_Par_20_1_v121032014011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Digitaalne isikutunnistus on digitaalne dokument. Digitaalne isikutunnistus antakse välja: Eesti kodanikule ja välismaalasele, kellele on varem välja antud isikutunnistus või elamisloakaart või kes taotleb isikutunnistust või elamisloakaarti samaaegselt digitaalse isikutunnistusega; käesoleva lõike punktis 1 nimetamata Eesti kodanikule ja välismaalasele. (2) Käesoleva paragrahvi lõike 1 punktis 2 nimetatud isikutele digitaalse isikutunnistuse väljaandmise alustamise aja määrab",
      "rdfs:label": {
        "@value": "ITD_Par_20_1 (redaktsioon 121032014011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121032014011",
      "estleg:supersededByVersion": {
