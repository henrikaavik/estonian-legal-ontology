        "@id": "estleg:ITD_Par_1_1_v13247568"
      },
      "estleg:versionValidTo": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_1_1_v13247568",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
