      }
    },
    {
      "@id": "estleg:ITD_Par_27_v1036260",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 31. 07. 2006] (1) Välismaalase pass antakse välja välismaalasele, kellel on kehtiv Eesti elamisluba, ning kui on tõendatud, et välismaalasel puudub välisriigi reisidokument ja tal ei ole võimalik seda saada. [Lõike 1 sõnastus alates 1. 08. 2006] (1) Välismaalase pass antakse välja välismaalasele, kellel on kehtiv Eesti elamisluba või elamisõigus Eestis, ning kui on tõendatud, et välismaalasel puudub välisriigi reisidokument ja tal ei ole võimalik seda saada. (2) Kehtetu – (3) Välisriigi kodanikule välismaalase passi väljaandmiseks peab välismaalane esitama oma kodakondsusriigi pädeva ametiasutuse nõusoleku talle välismaalase passi väljaandmiseks või tõendama, et nimetatud nõusolekut ei ole võimalik saada.",
      "rdfs:label": {
        "@value": "ITD_Par_27 (redaktsioon 1036260)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036260",
      "estleg:supersededByVersion": {
        "@id": "estleg:ITD_Par_27_v1042877"
      },
      "estleg:versionValidTo": {
        "@value": "2006-08-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_27_v1042877",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välismaalase pass antakse välja välismaalasele, kellel on kehtiv Eesti elamisluba või elamisõigus Eestis, ning kui on tõendatud, et välismaalasel puudub välisriigi reisidokument ja tal ei ole võimalik seda saada. (2) Kehtetu – (3) Välisriigi kodanikule välismaalase passi väljaandmiseks peab välismaalane esitama oma kodakondsusriigi pädeva ametiasutuse nõusoleku talle välismaalase passi väljaandmiseks või tõendama, et nimetatud nõusolekut ei ole võimalik saada.",
      "rdfs:label": {
        "@value": "ITD_Par_27 (redaktsioon 1042877)",
