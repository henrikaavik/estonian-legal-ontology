      },
      "estleg:versionValidTo": {
        "@value": "2002-12-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_21_v214301",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti kodaniku pass antakse Eesti kodanikule riigipiiri ületamiseks. (2) Kehtetu - (3) Eesti kodanikule, kes tõendab põhjendatud isikliku või teenistusliku vajaduse olemasolu, võidakse lisaks varem väljaantud kehtivale Eesti kodaniku passile anda teine Eesti kodaniku pass (lisapass).",
      "rdfs:label": {
        "@value": "ITD_Par_21 (redaktsioon 214301)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "214301",
      "estleg:supersededByVersion": {
