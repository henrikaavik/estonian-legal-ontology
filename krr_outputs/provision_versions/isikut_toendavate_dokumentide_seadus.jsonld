      }
    },
    {
      "@id": "estleg:ITD_Par_21_v1003571",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_21"
      },
      "estleg:versionValidFrom": {
