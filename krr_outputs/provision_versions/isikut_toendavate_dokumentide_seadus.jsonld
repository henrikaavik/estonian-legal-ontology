    {
      "@id": "estleg:ITD_Par_36_1_v22443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_36_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tagasipöördumise loa võib anda Eestisse tagasipöördumiseks Eesti Vabariigis elamisloa alusel elavale välismaalasele, kellele väljaantud välismaalase pass, ajutine reisidokument või pagulase reisidokument on välisriigis viibides muutunud kasutamiskõlbmatuks, hävinud või kaotsi läinud.",
      "rdfs:label": {
        "@value": "ITD_Par_36_1 (redaktsioon 22443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22443",
      "estleg:supersededByVersion": {
        "@id": "estleg:ITD_Par_36_1_v686784"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_36_1_v686784",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_36_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tagasipöördumise loa võib anda Eestisse tagasipöördumiseks Eesti Vabariigis elamisloa alusel elavale välismaalasele, kellele väljaantud välismaalase pass, ajutine reisidokument või pagulase reisidokument on välisriigis viibides muutunud kasutamiskõlbmatuks, hävinud või kaotsi läinud. (2) Eesti Vabariigis elamisloa alusel elava välismaalase välisriigis sündinud alla üheaastasele lapsele võib anda tagasipöördumise loa sünnitõendi või sünnitunnistuse alusel.",
      "rdfs:label": {
        "@value": "ITD_Par_36_1 (redaktsioon 686784)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "686784",
      "estleg:supersededByVersion": {
        "@id": "estleg:ITD_Par_36_1_v697053"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-16",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_36_1_v697053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_36_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tagasipöördumise loa võib anda Eestisse tagasipöördumiseks välismaalasele: kes elab Eesti Vabariigis elamisloa alusel ja kellele väljaantud välismaalase pass, ajutine reisidokument või pagulase reisidokument on välisriigis viibides muutunud kasutamiskõlbmatuks, hävinud või kaotsi läinud; kelle Eesti Vabariik võtab välislepingu alusel tagasi. (2) Eesti Vabariigis elamisloa alusel elava välismaalase välisriigis sündinud alla üheaastasele lapsele võib anda tagasipöördumise loa sünnitõendi või sünnitunnistuse alusel.",
      "rdfs:label": {
        "@value": "ITD_Par_36_1 (redaktsioon 697053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "697053",
      "estleg:supersededByVersion": {
        "@id": "estleg:ITD_Par_36_1_v13184598"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_36_1_v13184598",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
