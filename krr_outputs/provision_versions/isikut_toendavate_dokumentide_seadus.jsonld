        "@value": "2006-08-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_36_2_v1042877",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_36_2"
      },
