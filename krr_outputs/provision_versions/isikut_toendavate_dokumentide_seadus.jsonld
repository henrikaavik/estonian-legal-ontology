      }
    },
    {
      "@id": "estleg:ITD_Par_36_3_v12899636",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_36_3"
