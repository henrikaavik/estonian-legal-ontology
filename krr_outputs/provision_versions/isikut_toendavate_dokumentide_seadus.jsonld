      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_12_1_v120062022056",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_12_1"
