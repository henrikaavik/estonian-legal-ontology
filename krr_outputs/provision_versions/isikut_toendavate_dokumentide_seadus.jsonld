        "@type": "xsd:date"
      },
      "estleg:versionText": "Meresõidutunnistus antakse kehtivusajaga kuni viis aastat, kusjuures kehtivusaeg ei tohi ületada välismaalasele antud elamisloa kehtivusaega.",
      "rdfs:label": {
        "@value": "ITD_Par_34 (redaktsioon 22443)",
        "@language": "et"
      },
