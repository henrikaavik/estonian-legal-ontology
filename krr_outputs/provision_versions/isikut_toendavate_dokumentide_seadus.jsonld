      }
    },
    {
      "@id": "estleg:ITD_Par_4_1_v119122012012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ITD_Par_4_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikut tõendava dokumendi väljaandmise, väljastuskoha muutmise ning selle Euroopa Liidu liikmesriigi välisesindusele edastamise taotluse läbivaatamise eest tasutakse riigilõivu riigilõivuseaduses sätestatud määra järgi.",
      "rdfs:label": {
        "@value": "ITD_Par_4_1 (redaktsioon 119122012012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119122012012",
      "estleg:supersededByVersion": {
        "@id": "estleg:ITD_Par_4_1_v126062025002"
      },
      "estleg:versionValidTo": {
        "@value": "2025-07-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_4_1_v126062025002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
