      },
      "estleg:versionValidTo": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ITD_Par_36_2_v185010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
