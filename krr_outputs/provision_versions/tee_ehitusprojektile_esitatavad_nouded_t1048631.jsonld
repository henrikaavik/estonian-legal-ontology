      },
      "estleg:versionText": "Määrus jõustub 2020. aasta 1. veebruaril. Määrus jõustub 2020. aasta 1. veebruaril.",
      "rdfs:label": {
        "@value": "Reg_1048631_Par_37 (redaktsioon 1048631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048631",
