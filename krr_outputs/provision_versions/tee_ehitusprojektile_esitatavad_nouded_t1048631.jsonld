      },
      "estleg:versionValidFrom": {
        "@value": "2020-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tee ehitusprojekti graafilises osas esitatakse katendi taastamise kohta lisaks §-s 27 sätestatule: 1 1) projekteeritud tehnovõrkude ja kaeviku asukoht, kui katendi taastamine on tingitud tehnovõrgu ehitamisest; 2 2) projekteeritud katte taastamise ulatus ja ristlõige. Tee ehitusprojekti graafilises osas esitatakse katendi taastamise kohta lisaks §-s 27 sätestatule: projekteeritud tehnovõrkude ja kaeviku asukoht, kui katendi taastamine on tingitud tehnovõrgu ehitamisest; projekteeritud katte taastamise ulatus ja ristlõige.",
      "rdfs:label": {
        "@value": "Reg_1048631_Par_30 (redaktsioon 1048631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048631",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048631",
      "estleg:sourceAct": "Tee ehitusprojektile esitatavad nõuded",
      "estleg:provisionRef": "Reg_1048631 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048631_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048631_Par_31_v1048631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048631_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Silla, viadukti, tunneli, tugiseina ja müratõkkeseina projekteerimisel esitatakse tee ehitusprojekti graafilises osas: 1 1) telgede asukohad ja nende vahekaugused; 2 2) konstruktsioonide välispindade omavahelised kaugused; 3 3) vaadete, ristlõigete ja sõlmede asukohad ja telje mõõtmed; 4 4) maapinna, avaehituse, samba, vundamendi ja teiste osade mõõtmed ja gabariidid; 5 5) madalveepinna ja kõrgveepinna kõrgused; 6 6) olemasolevad ja kavandatavad kõrgusmärgid; 7 7) voolusängi ja koonuste kindlustus ja selle ulatus; 8 8) geoloogilised lõiked puuraukude või šurfide asukohtadega ning kihtide näitajad ja pinnaseveetase; 9 9) vundamendi ja vaiade plaanid koos rajamissügavusega ning neile mõjuvad koormused; 10 10) konstruktsioonide ja selle elementide mõõtmed ja sidumine telgedega ning lõiked, põhisõlmed ja töövuugid; 11 11) raudbetoonkonstruktsioonidel põhisarruste paigutus ja kaitsekihid; 12 12) elementide, põhidetailide ja sõlmede põhilised lahendused ja nende paigutus; 13 13) lahendused sademe- ja pinnasevee ärajuhtimiseks konstruktsioonidelt; 14 14) tugiosade ja vuukide paigutus ja tüübid koos liikuvuse ja koormustega; 15 15) nõuded materjalidele koos spetsifikatsiooni ja kogustega. Silla, viadukti, tunneli, tugiseina ja müratõkkeseina projekteerimisel esitatakse tee ehitusprojekti graafilises osas: telgede asukohad ja nende vahekaugused; konstruktsioonide välispindade omavahelised kaugused; vaadete, ristlõigete ja sõlmede asukohad ja telje mõõtmed; maapinna, avaehituse, samba, vundamendi ja teiste osade mõõtmed ja gabariidid; madalveepinna ja kõrgveepinna kõrgused; olemasolevad ja kavandatavad kõrgusmärgid; voolusängi ja koonuste kindlustus ja selle ulatus; geoloogilised lõiked puuraukude või šurfide asukohtadega ning kihtide näitajad ja pinnaseveetase; vundamendi ja vaiade plaanid koos rajamissügavusega ning neile mõjuvad koormused; konstruktsioonide ja selle elementide mõõtmed ja sidumine telgedega ning lõiked, põhisõlmed ja töövuugid; raudbetoonkonstruktsioonidel põhisarruste paigutus ja kaitsekihid; elementide, põhidetailide ja sõlmede põhilised lahendused ja nende paigutus; lahendused sademe- ja pinnasevee ärajuhtimiseks konstruktsioonidelt; tugiosade ja vuukide paigutus ja tüübid koos liikuvuse ja koormustega; nõuded materjalidele koos spetsifikatsiooni ja kogustega.",
      "rdfs:label": {
        "@value": "Reg_1048631_Par_31 (redaktsioon 1048631)",
        "@language": "et"
      },
