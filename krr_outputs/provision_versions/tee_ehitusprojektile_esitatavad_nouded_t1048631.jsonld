    {
      "@id": "estleg:Reg_1048631_Par_12_v1048631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048631_Par_12"
