      },
      "estleg:versionValidFrom": {
        "@value": "2020-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2021. aasta 1. veebruari ehitusloa taotlemiseks esitatud tee ehitusprojekt võib käesoleva määruse nõuete asemel olla koostatud vastavalt majandus- ja taristuministri 2. juuli 2015. a määrusele nr 82 „Tee ehitusprojektile esitatavad nõuded”. Enne 2021. aasta 1. veebruari ehitusloa taotlemiseks esitatud tee ehitusprojekt võib käesoleva määruse nõuete asemel olla koostatud vastavalt majandus- ja taristuministri 2. juuli 2015. a määrusele nr 82 „Tee ehitusprojektile esitatavad nõuded”.",
      "rdfs:label": {
        "@value": "Reg_1048631_Par_35 (redaktsioon 1048631)",
        "@language": "et"
      },
