    },
    {
      "@id": "estleg:Reg_1057620_Par_3_v1057620",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057620_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruses kasutatakse termineid järgmises tähenduses: 1 1) e-ehituse platvorm – infosüsteem, mis koondab sellega liidestunud ehitusvaldkonna teenuseid ja andmeid; 2 2) uuenduslikud digilahendused – erinevad tarkvaralahendused, teenused ja nende rakendamist võimaldavad praktikad, mis toetavad ehitussektori turuosaliste põhitegevust ja on sihtgrupi jaoks uued või oluliselt uuendatud. Määruses kasutatakse termineid järgmises tähenduses: e-ehituse platvorm – infosüsteem, mis koondab sellega liidestunud ehitusvaldkonna teenuseid ja andmeid; uuenduslikud digilahendused – erinevad tarkvaralahendused, teenused ja nende rakendamist võimaldavad praktikad, mis toetavad ehitussektori turuosaliste põhitegevust ja on sihtgrupi jaoks uued või oluliselt uuendatud.",
      "rdfs:label": {
        "@value": "Reg_1057620_Par_3 (redaktsioon 1057620)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057620",
