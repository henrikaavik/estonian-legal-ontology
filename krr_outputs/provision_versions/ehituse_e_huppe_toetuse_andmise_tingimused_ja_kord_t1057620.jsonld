      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahendusasutus on Riigi Tugiteenuste Keskus. Vahendusasutus on Riigi Tugiteenuste Keskus.",
      "rdfs:label": {
        "@value": "Reg_1057620_Par_4 (redaktsioon 1057620)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057620",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057620",
      "estleg:sourceAct": "Ehituse e-hüppe toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1057620 § 4",
