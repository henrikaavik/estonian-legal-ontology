      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.] [Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Reg_1057620_Par_28 (redaktsioon 1057620)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057620",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057620",
      "estleg:sourceAct": "Ehituse e-hüppe toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1057620 § 28",
