    {
      "@id": "estleg:Reg_1052912_Par_4_v1052912",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052912_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veterinaararst esitab komisjoni delegeeritud määruse (EL) 2021/578, millega täiendatakse Euroopa Parlamendi ja nõukogu määrust (EL) 2019/6 seoses mikroobivastaste ravimite müügimahu ja loomadel kasutamise kohta (ELT L 123, 09.04.2021, lk 7–20), lisa punktides 3 ja 4 loetletud välja kirjutatud ravimi ning veterinaarteenuse osutamise käigus väljastatud ja kasutatud ravimi kohta Põllumajandus- ja Toiduametile järgmised andmed: RT I 2022-06-28 33 128062022033 2022-07-01 1 1) ravimi nimetus, selle toimeaine ja pakendikood; 2 2) ravimi kogus pakendite arvuna, kasutades vajadusel komakohti; 3 3) ravitud loomade arv; 4 4) ravitud põllumajanduslooma puhul loomapidaja selle tegevuskoha põllumajandusloomade registris registreerimise number, kus ravitud põllumajanduslooma peetakse. RT I 2022-06-28 33 128062022033 2022-07-01 Veterinaararst esitab komisjoni delegeeritud määruse (EL) 2021/578, millega täiendatakse Euroopa Parlamendi ja nõukogu määrust (EL) 2019/6 seoses mikroobivastaste ravimite müügimahu ja loomadel kasutamise kohta (ELT L 123, 09.04.2021, lk 7–20), lisa punktides 3 ja 4 loetletud välja kirjutatud ravimi ning veterinaarteenuse osutamise käigus väljastatud ja kasutatud ravimi kohta Põllumajandus- ja Toiduametile järgmised andmed: ravimi nimetus, selle toimeaine ja pakendikood; ravimi kogus pakendite arvuna, kasutades vajadusel komakohti; ravitud loomade arv; ravitud põllumajanduslooma puhul loomapidaja selle tegevuskoha põllumajandusloomade registris registreerimise number, kus ravitud põllumajanduslooma peetakse.",
      "rdfs:label": {
        "@value": "Reg_1052912_Par_4 (redaktsioon 1052912)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052912",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052912",
      "estleg:sourceAct": "Veterinaarteenuse osutamise kohta arvestuse pidamise ning aruande ja andmete esitamise täpsemad nõuded ja kord",
      "estleg:provisionRef": "Reg_1052912 § 4",
