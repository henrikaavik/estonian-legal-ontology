      }
    },
    {
      "@id": "estleg:Reg_1052912_Par_5_v1052912",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052912_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Veterinaararst esitab §-s 4 loetletud andmed Põllumajandus- ja Toiduametile komisjoni delegeeritud määruse (EL) 2021/578 artiklis 15 nimetatud loomaliikide, -kategooriate ja vanuserühmade kaupa. Veterinaararst esitab §-s 4 loetletud andmed Põllumajandus- ja Toiduametile komisjoni delegeeritud määruse (EL) 2021/578 artiklis 15 nimetatud loomaliikide, -kategooriate ja vanuserühmade kaupa. 2 (2) Lisaks komisjoni delegeeritud määruse (EL) 2021/578 artiklis 15 nimetatud loomaliikide, -kategooriate ja vanuserühmade kaupa esitatavatele andmetele esitab veterinaararst välja kirjutatud ravimite ning veterinaarteenuse osutamise käigus väljastatud ja kasutatud ravimite kohta §-s 4 loetletud andmed järgmiste loomaliikide kaupa: RT I 2022-06-28 33 128062022033 2022-07-01 1 1) muud kui määruse (EL) 2021/578 artiklis 15 nimetatud kodulinnud; 2 2) hirvlased; 3 3) kaamellased; 4 4) muud kui määruse (EL) 2021/578 artiklis 15 nimetatud vesiviljelusloomad. Lisaks komisjoni delegeeritud määruse (EL) 2021/578 artiklis 15 nimetatud loomaliikide, -kategooriate ja vanuserühmade kaupa esitatavatele andmetele esitab veterinaararst välja kirjutatud ravimite ning veterinaarteenuse osutamise käigus väljastatud ja kasutatud ravimite kohta §-s 4 loetletud andmed järgmiste loomaliikide kaupa: muud kui määruse (EL) 2021/578 artiklis 15 nimetatud kodulinnud; hirvlased; kaamellased; muud kui määruse (EL) 2021/578 artiklis 15 nimetatud vesiviljelusloomad.",
      "rdfs:label": {
        "@value": "Reg_1052912_Par_5 (redaktsioon 1052912)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052912",
