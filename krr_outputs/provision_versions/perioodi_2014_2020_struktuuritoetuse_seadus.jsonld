    },
    {
      "@id": "estleg:STS2014_2020_Par_4_v121062014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:STS2014_2020_Par_4"
      },
      "estleg:versionValidFrom": {
