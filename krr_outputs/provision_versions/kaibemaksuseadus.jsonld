        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMS_Par_30_v107072017025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
