        "@value": "2004-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMS_Par_18_v759871",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
