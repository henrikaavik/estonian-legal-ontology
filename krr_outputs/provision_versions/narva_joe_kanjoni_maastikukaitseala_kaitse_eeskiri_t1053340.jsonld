      },
      "estleg:versionText": "Vabariigi Valitsuse 13. mai 1999. a määruses nr 155 „Panga maastikukaitseala ja Narva jõe kanjoni maastikukaitseala kaitse-eeskirjade ja välispiiri kirjelduste kinnitamine” tehakse järgmised muudatused:",
      "rdfs:label": {
        "@value": "Reg_1053340_Par_10 (redaktsioon 1053340)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053340",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053340",
      "estleg:sourceAct": "Narva jõe kanjoni maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053340 § 10",
      "estleg:partOfAct": {
