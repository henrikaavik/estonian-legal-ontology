        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1053340_Par_3 (redaktsioon 1053340)",
        "@language": "et"
      },
