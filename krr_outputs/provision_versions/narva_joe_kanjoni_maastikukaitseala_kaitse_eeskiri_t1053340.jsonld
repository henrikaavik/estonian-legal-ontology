      }
    },
    {
      "@id": "estleg:Reg_1053340_Par_11_v1053340",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053340_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 14. detsembri 2010. a käskkirjaga nr 1831 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 14. detsembri 2010. a käskkirjaga nr 1831 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1053340_Par_11 (redaktsioon 1053340)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053340",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053340",
      "estleg:sourceAct": "Narva jõe kanjoni maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053340 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053340_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1053340_Par_12_v1053340",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053340_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1053340_Par_12 (redaktsioon 1053340)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053340",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053340",
      "estleg:sourceAct": "Narva jõe kanjoni maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053340 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053340_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1053340_Par_2_v1053340",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053340_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Ida-Viru maakonnas Narva linnas ja Narva jõe alal. Kaitseala asub Ida-Viru maakonnas Narva linnas ja Narva jõe alal. 2 (2) Kaitseala välispiir ja vööndi piirid on esitatud kaardil määruse lisas2. Kaitseala välispiir ja vööndi piirid on esitatud kaardil määruse lisas2.",
      "rdfs:label": {
        "@value": "Reg_1053340_Par_2 (redaktsioon 1053340)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053340",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053340",
      "estleg:sourceAct": "Narva jõe kanjoni maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053340 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053340_Map_2026"
      }
    },
    {
