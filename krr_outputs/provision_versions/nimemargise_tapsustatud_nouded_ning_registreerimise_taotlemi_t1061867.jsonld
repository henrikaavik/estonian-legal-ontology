  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_nimemargise_tapsustatud_nouded_ning_registreerimise_taotlemi_t1061867_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nimemärgise täpsustatud nõuded ning registreerimise taotlemise, registreerimise, registreeringu kehtivusaja pikendamise, muutmise, kehtetuks tunnistamise ja keeldumise kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nimemärgise täpsustatud nõuded ning registreerimise taotlemise, registreerimise, registreeringu kehtivusaja pikendamise, muutmise, kehtetuks tunnistamise ja keeldumise kord"
    },
    {
      "@id": "estleg:Reg_1061867_Par_1_v1061867",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061867_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nimemärgise registreerimise, registreeringu muutmise, kehtivusaja pikendamise ja kehtetuks tunnistamise taotluses esitatakse järgmised andmed: 1 1) ettevõtja nimi, registrikood ning telefoninumber, elektronposti aadress ja postiaadress; 2 2) väärismetalltoodete seaduse § 6 lõikes 2 nimetatud ettevõtja tegevusala – valmistaja või sissevedaja; 3 3) taotletav toiming; 4 4) taotluse esitamise kuupäev ja allkiri; 5 5) taotluse allkirjastanud isiku nimi ja vajaduse korral esindusõigust tõendav dokument. Nimemärgise registreerimise, registreeringu muutmise, kehtivusaja pikendamise ja kehtetuks tunnistamise taotluses esitatakse järgmised andmed: ettevõtja nimi, registrikood ning telefoninumber, elektronposti aadress ja postiaadress; väärismetalltoodete seaduse § 6 lõikes 2 nimetatud ettevõtja tegevusala – valmistaja või sissevedaja; taotletav toiming; taotluse esitamise kuupäev ja allkiri; taotluse allkirjastanud isiku nimi ja vajaduse korral esindusõigust tõendav dokument.",
      "rdfs:label": {
        "@value": "Reg_1061867_Par_1 (redaktsioon 1061867)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061867",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061867",
      "estleg:sourceAct": "Nimemärgise täpsustatud nõuded ning registreerimise taotlemise, registreerimise, registreeringu kehtivusaja pikendamise, muutmise, kehtetuks tunnistamise ja keeldumise kord",
      "estleg:provisionRef": "Reg_1061867 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061867_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061867_Par_2_v1061867",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061867_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nimemärgist kujutatakse üldiselt kättesaadavat tehnoloogiat kasutades kujul, mis võimaldab esitada nimemärgise Tarbijakaitse ja Tehnilise Järelevalve Ameti järelevalve infosüsteemis viisil, mis on selge, täpne, täielik, kergesti kättesaadav, arusaadav, püsiv ja objektiivne. Nimemärgist kujutatakse üldiselt kättesaadavat tehnoloogiat kasutades kujul, mis võimaldab esitada nimemärgise Tarbijakaitse ja Tehnilise Järelevalve Ameti järelevalve infosüsteemis viisil, mis on selge, täpne, täielik, kergesti kättesaadav, arusaadav, püsiv ja objektiivne.",
      "rdfs:label": {
        "@value": "Reg_1061867_Par_2 (redaktsioon 1061867)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061867",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061867",
      "estleg:sourceAct": "Nimemärgise täpsustatud nõuded ning registreerimise taotlemise, registreerimise, registreeringu kehtivusaja pikendamise, muutmise, kehtetuks tunnistamise ja keeldumise kord",
      "estleg:provisionRef": "Reg_1061867 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061867_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061867_Par_3_v1061867",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061867_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tarbijakaitse ja Tehnilise Järelevalve Amet otsustab nimemärgise registreerimise, registreeringu muutmise, kehtetuks tunnistamise või kehtivusaja pikendamise seitsme tööpäeva jooksul arvates taotluse esitamisest. Tarbijakaitse ja Tehnilise Järelevalve Amet otsustab nimemärgise registreerimise, registreeringu muutmise, kehtetuks tunnistamise või kehtivusaja pikendamise seitsme tööpäeva jooksul arvates taotluse esitamisest. 2 (2) Kui taotlus ei vasta väärismetalltoodete seaduses ja käesolevas määruses sätestatud nõuetele, annab Tarbijakaitse ja Tehnilise Järelevalve Amet taotlejale puuduse kõrvaldamiseks vähemalt kahenädalase tähtaja. Kui taotlus ei vasta väärismetalltoodete seaduses ja käesolevas määruses sätestatud nõuetele, annab Tarbijakaitse ja Tehnilise Järelevalve Amet taotlejale puuduse kõrvaldamiseks vähemalt kahenädalase tähtaja.",
      "rdfs:label": {
        "@value": "Reg_1061867_Par_3 (redaktsioon 1061867)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061867",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061867",
      "estleg:sourceAct": "Nimemärgise täpsustatud nõuded ning registreerimise taotlemise, registreerimise, registreeringu kehtivusaja pikendamise, muutmise, kehtetuks tunnistamise ja keeldumise kord",
      "estleg:provisionRef": "Reg_1061867 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061867_Map"
      }
    },
