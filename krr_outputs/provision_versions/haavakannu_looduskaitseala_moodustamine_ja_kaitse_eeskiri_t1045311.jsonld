      "estleg:provisionRef": "Reg_1045311 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045311_Par_11_v1045311",
      "@type": [
