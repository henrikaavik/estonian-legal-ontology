      }
    },
    {
      "@id": "estleg:Reg_1045311_Par_12_v1045311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045311_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatise püstitamine kaitseala tarbeks; 4 4) Raeküla sihtkaitsevööndis inimeste viibimine väljaspool teid 1. veebruarist 30. juunini, välja arvatud järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel ning kaitseala valitseja nõusolekul teostataval teadustegevusel. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatise püstitamine kaitseala tarbeks; Raeküla sihtkaitsevööndis inimeste viibimine väljaspool teid 1. veebruarist 30. juunini, välja arvatud järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel ning kaitseala valitseja nõusolekul teostataval teadustegevusel.",
      "rdfs:label": {
        "@value": "Reg_1045311_Par_12 (redaktsioon 1045311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045311",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045311",
      "estleg:sourceAct": "Haavakannu looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1045311 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045311_Par_13_v1045311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
