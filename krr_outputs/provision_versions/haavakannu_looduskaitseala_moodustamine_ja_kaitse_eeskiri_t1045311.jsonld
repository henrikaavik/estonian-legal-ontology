      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 9. septembri 2016. a käskkirjaga nr 1-2/16/865 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 9. septembri 2016. a käskkirjaga nr 1-2/16/865 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1045311_Par_20 (redaktsioon 1045311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045311",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045311",
      "estleg:sourceAct": "Haavakannu looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1045311 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045311_Par_21_v1045311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045311_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1045311_Par_21 (redaktsioon 1045311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045311",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045311",
      "estleg:sourceAct": "Haavakannu looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1045311 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045311_Par_3_v1045311",
      "@type": [
        "owl:NamedIndividual",
