      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Kullerkupu piiranguvöönd. Kaitsealal on Kullerkupu piiranguvöönd.",
      "rdfs:label": {
