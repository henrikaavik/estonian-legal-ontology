  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_vanglaametnikule_voi_muule_vanglatootajale_justiits_ja_digim_t324710_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Vanglaametnikule või muule vanglatöötajale Justiits- ja Digiministeeriumi ametniku poolt korralduste andmise ja vanglas teenistusülesannete täitmise kord (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vanglaametnikule või muule vanglatöötajale Justiits- ja Digiministeeriumi ametniku poolt korralduste andmise ja vanglas teenistusülesannete täitmise kord"
    },
    {
      "@id": "estleg:Reg_324710_Par_1_v324710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324710_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Justiits- ja Digiministeeriumi ametnikul on õigus anda vanglaametnikule või muule vanglatöötajale (edaspidi vanglateenistuja) korraldusi ja täita vanglas teenistusülesandeid, kui see on vajalik vanglale pandud ülesannete täitmiseks. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Justiits- ja Digiministeeriumi ametnikul on õigus anda vanglaametnikule või muule vanglatöötajale (edaspidi vanglateenistuja) korraldusi ja täita vanglas teenistusülesandeid, kui see on vajalik vanglale pandud ülesannete täitmiseks. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_324710_Par_1 (redaktsioon 324710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "324710",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/324710",
      "estleg:sourceAct": "Vanglaametnikule või muule vanglatöötajale Justiits- ja Digiministeeriumi ametniku poolt korralduste andmise ja vanglas teenistusülesannete täitmise kord",
      "estleg:provisionRef": "Reg_324710 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_324710_Map"
      }
    },
    {
      "@id": "estleg:Reg_324710_Par_2_v324710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324710_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Justiits- ja Digiministeeriumi vanglate valdkonna asekantsleril on õigus anda korraldusi kõigis vangla tegevusvaldkondades. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Justiits- ja Digiministeeriumi vanglate valdkonna asekantsleril on õigus anda korraldusi kõigis vangla tegevusvaldkondades. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 2 (2) Justiits- ja Digiministeeriumi vanglate osakonna talituse juhatajal on õigus anda korraldusi järgmistes valdkondades: RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 1 1) Kehtetu - RT I 2022-04-22 1 122042022001 2022-04-25 2 2) taasühiskonnastamise talituse juhatajal on õigus anda korraldusi individuaalse täitmiskava koostamise, vangla sotsiaaltöö, kriminaalhoolduse ning tervishoiuteenuse osutamise valdkonnas; RTL 2009 89 1297 13238339 2009-12-11 3 3) vanglatöö korraldamise talituse juhatajal on õigus anda korraldusi registrite arendamise, kinni peetavate isikute arvestuse, vangistuse täideviimise ja järelevalve valdkonnas; RT I 2025-07-18 1 118072025001 2025-08-01 4 4) sisekontrolli ja teabe talituse juhatajal on õigus anda korraldusi sisekontrolli, julgeoleku ja jälitustegevuse valdkonnas, riigisaladuse ja salastatud välisteabe kaitse valdkonnas ja menetluste kohta, mis puudutavad kinnipeetavaid ja nende poolt toimepandud õigusrikkumisi ning menetluste kohta, mis puudutavad ametnikke ja töötajaid ning nende poolt toimepandud õigusrikkumisi. RT I 2025-07-18 1 118072025001 2025-08-01 Justiits- ja Digiministeeriumi vanglate osakonna talituse juhatajal on õigus anda korraldusi järgmistes valdkondades: , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Kehtetu - taasühiskonnastamise talituse juhatajal on õigus anda korraldusi individuaalse täitmiskava koostamise, vangla sotsiaaltöö, kriminaalhoolduse ning tervishoiuteenuse osutamise valdkonnas; vanglatöö korraldamise talituse juhatajal on õigus anda korraldusi registrite arendamise, kinni peetavate isikute arvestuse, vangistuse täideviimise ja järelevalve valdkonnas; sisekontrolli ja teabe talituse juhatajal on õigus anda korraldusi sisekontrolli, julgeoleku ja jälitustegevuse valdkonnas, riigisaladuse ja salastatud välisteabe kaitse valdkonnas ja menetluste kohta, mis puudutavad kinnipeetavaid ja nende poolt toimepandud õigusrikkumisi ning menetluste kohta, mis puudutavad ametnikke ja töötajaid ning nende poolt toimepandud õigusrikkumisi.",
      "rdfs:label": {
        "@value": "Reg_324710_Par_2 (redaktsioon 324710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "324710",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/324710",
      "estleg:sourceAct": "Vanglaametnikule või muule vanglatöötajale Justiits- ja Digiministeeriumi ametniku poolt korralduste andmise ja vanglas teenistusülesannete täitmise kord",
      "estleg:provisionRef": "Reg_324710 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_324710_Map"
      }
    },
    {
      "@id": "estleg:Reg_324710_Par_3_v324710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324710_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Korraldus antakse suulises või taasesitamist võimaldavas vormis. Korralduse saajal on õigus nõuda suuliselt antud korralduse esitamist taasesitamist võimaldavas vormis. Korraldus antakse suulises või taasesitamist võimaldavas vormis. Korralduse saajal on õigus nõuda suuliselt antud korralduse esitamist taasesitamist võimaldavas vormis. 2 (2) Korraldus, mis antakse vangla direktori alluvuses oleva valdkonna kohta, antakse vangla direktorile. Edasilükkamatul juhul võib korralduse anda ka muule vangla direktori alluvuses olevale vanglateenistujale. RT I 2021-07-09 2 109072021002 2021-10-10 Korraldus, mis antakse vangla direktori alluvuses oleva valdkonna kohta, antakse vangla direktorile. Edasilükkamatul juhul võib korralduse anda ka muule vangla direktori alluvuses olevale vanglateenistujale. 3 (3) Muu vanglateenistuja teavitab saadud korraldusest vahetut ülemust, vangla direktorit või tema poolt määratud isikut. Muu vanglateenistuja teavitab saadud korraldusest vahetut ülemust, vangla direktorit või tema poolt määratud isikut.",
      "rdfs:label": {
        "@value": "Reg_324710_Par_3 (redaktsioon 324710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "324710",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/324710",
      "estleg:sourceAct": "Vanglaametnikule või muule vanglatöötajale Justiits- ja Digiministeeriumi ametniku poolt korralduste andmise ja vanglas teenistusülesannete täitmise kord",
      "estleg:provisionRef": "Reg_324710 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_324710_Map"
      }
    },
    {
      "@id": "estleg:Reg_324710_Par_4_v324710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324710_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglateenistuja on kohustatud saadud korralduse täitma viivitamata. Kui vanglateenistuja ei saa korraldusest aru, peab ta korralduse andjalt küsima selgitust. Vanglateenistuja on kohustatud saadud korralduse täitma viivitamata. Kui vanglateenistuja ei saa korraldusest aru, peab ta korralduse andjalt küsima selgitust.",
      "rdfs:label": {
        "@value": "Reg_324710_Par_4 (redaktsioon 324710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "324710",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/324710",
      "estleg:sourceAct": "Vanglaametnikule või muule vanglatöötajale Justiits- ja Digiministeeriumi ametniku poolt korralduste andmise ja vanglas teenistusülesannete täitmise kord",
      "estleg:provisionRef": "Reg_324710 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_324710_Map"
      }
    },
    {
      "@id": "estleg:Reg_324710_Par_5_v324710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324710_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Justiits- ja Digiministeeriumi vanglate osakonna teenistuja täidab teenistusülesandeid vanglas samas korras nagu toimub teenistuslähetusse saatmine. Vanglate valdkonna asekantsleri antud korralduses peavad olema määratletud teenistusülesanded, mida ta vanglas täitma asub. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Justiits- ja Digiministeeriumi vanglate osakonna teenistuja täidab teenistusülesandeid vanglas samas korras nagu toimub teenistuslähetusse saatmine. Vanglate valdkonna asekantsleri antud korralduses peavad olema määratletud teenistusülesanded, mida ta vanglas täitma asub. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 2 (2) Vanglas teenistusülesannete täitmise ajaks võib lõikes 1 nimetatud teenistuja vabastada teenistusülesannete täitmisest Justiits- ja Digiministeeriumis osaliselt või täielikult. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Vanglas teenistusülesannete täitmise ajaks võib lõikes 1 nimetatud teenistuja vabastada teenistusülesannete täitmisest Justiits- ja Digiministeeriumis osaliselt või täielikult. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_324710_Par_5 (redaktsioon 324710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "324710",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/324710",
      "estleg:sourceAct": "Vanglaametnikule või muule vanglatöötajale Justiits- ja Digiministeeriumi ametniku poolt korralduste andmise ja vanglas teenistusülesannete täitmise kord",
      "estleg:provisionRef": "Reg_324710 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_324710_Map"
      }
    },
    {
      "@id": "estleg:Reg_324710_Par_6_v324710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324710_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Justiits- ja Digiministeeriumi vanglate osakonna teenistujal on vanglas teenistusülesannete täitmisel vastava vanglateenistuja õigused ja kohustused. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Justiits- ja Digiministeeriumi vanglate osakonna teenistujal on vanglas teenistusülesannete täitmisel vastava vanglateenistuja õigused ja kohustused. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 2 (2) Justiits- ja Digiministeerium peab vangla direktorit või tema määratud isikut teavitama vanglas täidetavatest teenistusülesannetest. Vangla peab tagama Justiits- ja Digiministeeriumi vanglate osakonna teenistujale vanglas teenistusülesannete täitmiseks vajaminevate vahendite olemasolu. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Justiits- ja Digiministeerium peab vangla direktorit või tema määratud isikut teavitama vanglas täidetavatest teenistusülesannetest. Vangla peab tagama Justiits- ja Digiministeeriumi vanglate osakonna teenistujale vanglas teenistusülesannete täitmiseks vajaminevate vahendite olemasolu. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_324710_Par_6 (redaktsioon 324710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "324710",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/324710",
      "estleg:sourceAct": "Vanglaametnikule või muule vanglatöötajale Justiits- ja Digiministeeriumi ametniku poolt korralduste andmise ja vanglas teenistusülesannete täitmise kord",
      "estleg:provisionRef": "Reg_324710 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_324710_Map"
      }
    },
    {
      "@id": "estleg:Reg_324710_Par_7_v324710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324710_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Justiits- ja Digiministeeriumi vanglate osakonna teenistuja ei või keelduda vanglas teenistusülesannete täitmisest, välja arvatud juhul, kui ta on rase, kasvatab alla kolmeaastast või puudega last. Samuti tuleb arvestada muid olulisi asjaolusid, mis takistavad teenistujal vanglas teenistusülesandeid täita. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Justiits- ja Digiministeeriumi vanglate osakonna teenistuja ei või keelduda vanglas teenistusülesannete täitmisest, välja arvatud juhul, kui ta on rase, kasvatab alla kolmeaastast või puudega last. Samuti tuleb arvestada muid olulisi asjaolusid, mis takistavad teenistujal vanglas teenistusülesandeid täita. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_324710_Par_7 (redaktsioon 324710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "324710",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/324710",
      "estleg:sourceAct": "Vanglaametnikule või muule vanglatöötajale Justiits- ja Digiministeeriumi ametniku poolt korralduste andmise ja vanglas teenistusülesannete täitmise kord",
      "estleg:provisionRef": "Reg_324710 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_324710_Map"
      }
    },
