    {
      "@id": "estleg:MaaKS_Par_6_v115032014005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MaaKS_Par_6"
      },
      "estleg:versionValidFrom": {
