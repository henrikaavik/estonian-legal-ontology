    },
    {
      "@id": "estleg:MaaKS_Par_16_v22310",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MaaKS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ümberkruntimine on maakorraldustoimingute kogum, millega omanike huvidest lähtuvalt korraldatakse ümber maakorralduspiirkonda arvatud kinnisasjad ja moodustatakse ning kinnistatakse kõigile omanikele käesoleva seaduse paragrahv 5 2. lõike sätetele vastavad uued kinnisasjad. (2) Ümberkruntimine koosneb järgmistest etappidest: ümberkruntimise taotluse esitamine; eeltööd; maakorralduspiirkonna ja osaliste selgitamine; osaliste koosoleku pidamine; ümberkruntimise algatamine; kinnisasja hindamine; läbirääkimised; ümberkruntimiskava koostamine; ümberkruntimiskava kooskõlastamine ja kinnitamine; ümberkruntimiskava elluviimine; kinnisasja registreerimine riigi maakatastris ja muudatuste kandmine kinnistusraamatusse. (3) Kui ümberkruntimist ei ole võimalik otstarbekalt läbi viia maakorralduspiirkonda arvatud kinnisasja endise väärtuse alusel, võib moodustatava kinnisasja väärtus olla kuni 10% väiksem endise kinnisasja väärtusest. Väärtuste vahe ulatuses makstakse osalisele, kelle kinnisasja väärtus väheneb, rahalist hüvitust. Hüvituse tasub osaline, kes saab suurema väärtusega kinnisasja.",
      "rdfs:label": {
        "@value": "MaaKS_Par_16 (redaktsioon 22310)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22310",
      "estleg:supersededByVersion": {
        "@id": "estleg:MaaKS_Par_16_v185922"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22310",
      "estleg:sourceAct": "Maakorraldusseadus",
      "estleg:provisionRef": "MaaKS § 16",
      "estleg:partOfAct": {
        "@id": "estleg:MaaKS_Map_2026"
      }
    },
