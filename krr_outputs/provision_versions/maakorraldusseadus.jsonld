      }
    },
    {
      "@id": "estleg:MaaKS_Par_9_v22310",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MaaKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakorraldusühistu liikmeks võib olla kinnisasja omanik, kelle kinnisasjal viiakse läbi maakorraldustoiminguid. (2) Maakorraldusühistu liige on kohustatud tasuma ühistule maakorralduse läbiviimisega seotud teostuskulud.",
      "rdfs:label": {
        "@value": "MaaKS_Par_9 (redaktsioon 22310)",
        "@language": "et"
      },
