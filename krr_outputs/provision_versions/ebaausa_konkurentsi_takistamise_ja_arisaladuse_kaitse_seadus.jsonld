      }
    },
    {
      "@id": "estleg:EKTAKS_Par_7_v107122018002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EKTAKS_Par_7"
      },
      "estleg:versionValidFrom": {
