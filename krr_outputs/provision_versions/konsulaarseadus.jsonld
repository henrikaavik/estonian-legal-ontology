      },
      "estleg:versionText": "(1) Erikutset mitteomav konsulaarametnik võib teha tõestamistoimingu üksnes Välisministeeriumi nõusolekul.",
      "rdfs:label": {
        "@value": "KONSUL_Par_26 (redaktsioon 1011730)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011730",
