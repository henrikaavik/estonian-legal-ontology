      }
    },
    {
      "@id": "estleg:KONSUL_Par_40_v922899",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KONSUL_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Konsulaarametnik või aukonsul edastab isiku või ametiasutuse taotlusel dokumendi Eesti või välisriigi ametiasutusele või isikule, kui välislepinguga ei ole ette nähtud teistsugust korda. (2) Ametiasutuse taotlusel dokumendi edastamine on riigilõivuvaba. (3) Dokumendi edastamistaotluse vormi määrusega.",
      "rdfs:label": {
        "@value": "KONSUL_Par_40 (redaktsioon 922899)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922899",
      "estleg:supersededByVersion": {
        "@id": "estleg:KONSUL_Par_40_v1011730"
      },
      "estleg:versionValidTo": {
        "@value": "2006-04-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KONSUL_Par_40_v1011730",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KONSUL_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Konsulaarametnik või aukonsul edastab isiku või ametiasutuse taotlusel dokumendi Eesti või välisriigi ametiasutusele või isikule, kui välislepinguga ei ole ette nähtud teistsugust korda. (2) Ametiasutuse taotlusel dokumendi edastamine on riigilõivuvaba.",
      "rdfs:label": {
        "@value": "KONSUL_Par_40 (redaktsioon 1011730)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011730",
      "estleg:supersededByVersion": {
