      },
      "estleg:versionValidFrom": {
        "@value": "2005-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KONSUL_Par_45 (redaktsioon 913288)",
