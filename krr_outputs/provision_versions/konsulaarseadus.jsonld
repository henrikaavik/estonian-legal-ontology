      }
    },
    {
      "@id": "estleg:KONSUL_Par_66_v121042018007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KONSUL_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KONSUL_Par_66 (redaktsioon 121042018007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121042018007"
