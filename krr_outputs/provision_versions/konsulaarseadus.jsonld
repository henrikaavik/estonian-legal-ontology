      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konsulaarasutuse tegevuse käigus loodud või saadud arhivaalid säilitatakse arhiiviseaduse (RT I 1998, 36/37, 552; 1999, 16, 271; 2000, 92, 597; 2001, 88, 531; 93, 565; 2002, 53, 336; 61, 375; 63, 387; 82, 480) kohaselt.",
      "rdfs:label": {
        "@value": "KONSUL_Par_12 (redaktsioon 685616)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "685616",
