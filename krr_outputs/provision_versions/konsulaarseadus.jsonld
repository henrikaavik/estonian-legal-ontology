      }
    },
    {
      "@id": "estleg:KONSUL_Par_26_v13186034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KONSUL_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konsulaarteenus on avalik teenus, mida konsulaarametnik ja aukonsul osutavad õigusaktide kohaselt.",
      "rdfs:label": {
        "@value": "KONSUL_Par_26 (redaktsioon 13186034)",
