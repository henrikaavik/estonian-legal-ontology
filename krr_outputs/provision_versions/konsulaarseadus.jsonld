      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konsulaarametnik võtab arvele konsulaarpiirkonnas viibiva Eesti kaitseväeteenistuse kutsealuse ja saadab kutsealuste nimekirja kaitseväeteenistuse seaduse (RT I 2000, 28, 167; 2003, 31, 195) kohaselt Kaitseministeeriumile.",
      "rdfs:label": {
        "@value": "KONSUL_Par_45 (redaktsioon 685616)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "685616",
