  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_maksukohustuslasena_voi_piiratud_maksukohustuslasena_registr_t1054392_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Maksukohustuslasena või piiratud maksukohustuslasena registreerimata isiku poolt aktsiisikauba teisest liikmesriigist soetamisel ja maksukohustuslasena registreerimata isiku poolt ilma kauba võõrandamiseta kauba maksuladustamise lõpetamisel või aktsiisikauba aktsiisilaost väljatoimetamisel käibemaksu deklareerimise ja tasumise kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Maksukohustuslasena või piiratud maksukohustuslasena registreerimata isiku poolt aktsiisikauba teisest liikmesriigist soetamisel ja maksukohustuslasena registreerimata isiku poolt ilma kauba võõrandamiseta kauba maksuladustamise lõpetamisel või aktsiisikauba aktsiisilaost väljatoimetamisel käibemaksu deklareerimise ja tasumise kord"
    },
    {
      "@id": "estleg:Reg_1054392_Par_1_v1054392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054392_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maksukohustuslasena või piiratud maksukohustuslasena registreerimata isik, välja arvatud füüsiline isik, kes soetab aktsiisikauba isiklikuks otstarbeks, esitab Maksu- ja Tolliametile lõikes 2 nimetatud andmed ning tasub käibemaksu aktsiisikauba teisest liikmesriigist soetamisel alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduses sätestatud aktsiisi tasumise tähtpäevaks. Maksukohustuslasena või piiratud maksukohustuslasena registreerimata isik, välja arvatud füüsiline isik, kes soetab aktsiisikauba isiklikuks otstarbeks, esitab Maksu- ja Tolliametile lõikes 2 nimetatud andmed ning tasub käibemaksu aktsiisikauba teisest liikmesriigist soetamisel alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduses sätestatud aktsiisi tasumise tähtpäevaks. 2 (2) Aktsiisikauba teisest liikmesriigist soetamisel esitatakse järgmised andmed: 1 1) kauba soetaja nimi ja registri- või isikukood; 2 2) aktsiisideklaratsiooni esitamise kuupäev; 3 3) kauba saatja nimi ja registrikood või käibemaksukohustuslasena registreerimise number; 4 4) aktsiisikauba Eestis vastuvõtmise või Eestisse toimetamise kuupäev; 5 5) kauba maksustatav väärtus eurodes sendi täpsusega; 6 6) maksumäär; 7 7) tasumisele kuuluv käibemaksusumma eurodes sendi täpsusega. Aktsiisikauba teisest liikmesriigist soetamisel esitatakse järgmised andmed: kauba soetaja nimi ja registri- või isikukood; aktsiisideklaratsiooni esitamise kuupäev; kauba saatja nimi ja registrikood või käibemaksukohustuslasena registreerimise number; aktsiisikauba Eestis vastuvõtmise või Eestisse toimetamise kuupäev; kauba maksustatav väärtus eurodes sendi täpsusega; maksumäär; tasumisele kuuluv käibemaksusumma eurodes sendi täpsusega. 3 (3) Kauba maksustatava väärtuse määramisel võetakse aluseks aktsiisikauba müügihind ning kõik tasuna käsitatav, mille kauba soetaja või kolmas isik kauba võõrandajale on tasunud või tasub, millele lisatakse sellelt kaubalt tasumisele kuuluv aktsiisisumma. Kauba maksustatava väärtuse määramisel võetakse aluseks aktsiisikauba müügihind ning kõik tasuna käsitatav, mille kauba soetaja või kolmas isik kauba võõrandajale on tasunud või tasub, millele lisatakse sellelt kaubalt tasumisele kuuluv aktsiisisumma.",
      "rdfs:label": {
        "@value": "Reg_1054392_Par_1 (redaktsioon 1054392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054392",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054392",
      "estleg:sourceAct": "Maksukohustuslasena või piiratud maksukohustuslasena registreerimata isiku poolt aktsiisikauba teisest liikmesriigist soetamisel ja maksukohustuslasena registreerimata isiku poolt ilma kauba võõrandamiseta kauba maksuladustamise lõpetamisel või aktsiisikauba aktsiisilaost väljatoimetamisel käibemaksu deklareerimise ja tasumise kord",
      "estleg:provisionRef": "Reg_1054392 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054392_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054392_Par_2_v1054392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054392_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käibemaksuseaduse § 3 lõike 6 punktides 5 ja 6 nimetatud isik, kes ei ole registreeritud maksukohustuslasena, esitab Maksu- ja Tolliametile lõikes 2 nimetatud andmed ning tasub käibemaksu hiljemalt kauba maksuladustamise lõpetamise või kauba aktsiisilaost väljatoimetamise päeval. Käibemaksuseaduse § 3 lõike 6 punktides 5 ja 6 nimetatud isik, kes ei ole registreeritud maksukohustuslasena, esitab Maksu- ja Tolliametile lõikes 2 nimetatud andmed ning tasub käibemaksu hiljemalt kauba maksuladustamise lõpetamise või kauba aktsiisilaost väljatoimetamise päeval. 2 (2) Kauba võõrandamiseta kauba maksuladustamise lõpetamisel või aktsiisikauba aktsiisilaost väljatoimetamisel esitatakse järgmised andmed: 1 1) kauba omaniku nimi ja registri- või isikukood; 2 2) laopidaja nimi ja registrikood; 3 3) kauba maksulaost või aktsiisikauba aktsiisilaost väljatoimetamise kuupäev; 4 4) kauba kombineeritud nomenklatuuri kood; 5 5) kauba maksustatav väärtus eurodes sendi täpsusega; 6 6) maksumäär; 7 7) tasumisele kuuluv käibemaksusumma eurodes sendi täpsusega. Kauba võõrandamiseta kauba maksuladustamise lõpetamisel või aktsiisikauba aktsiisilaost väljatoimetamisel esitatakse järgmised andmed: kauba omaniku nimi ja registri- või isikukood; laopidaja nimi ja registrikood; kauba maksulaost või aktsiisikauba aktsiisilaost väljatoimetamise kuupäev; kauba kombineeritud nomenklatuuri kood; kauba maksustatav väärtus eurodes sendi täpsusega; maksumäär; tasumisele kuuluv käibemaksusumma eurodes sendi täpsusega. 3 (3) Kauba maksustatava väärtuse hulka arvatakse tasumisele kuuluv aktsiisisumma. Kauba maksustatava väärtuse hulka arvatakse tasumisele kuuluv aktsiisisumma.",
      "rdfs:label": {
        "@value": "Reg_1054392_Par_2 (redaktsioon 1054392)",
        "@language": "et"
      },
