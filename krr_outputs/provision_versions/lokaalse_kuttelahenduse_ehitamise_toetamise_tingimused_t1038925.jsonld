      "estleg:provisionRef": "Reg_1038925 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038925_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038925_Par_24_v1038925",
