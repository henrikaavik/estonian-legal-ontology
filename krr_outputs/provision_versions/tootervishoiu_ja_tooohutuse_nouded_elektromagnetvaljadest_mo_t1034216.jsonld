    {
      "@id": "estleg:Reg_1034216_Par_13_v1034216",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034216_Par_13"
      },
