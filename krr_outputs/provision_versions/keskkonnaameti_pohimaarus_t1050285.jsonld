    {
      "@id": "estleg:Reg_1050285_Par_11_v1050285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050285_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ameti teenistuskohtade piirarvu kinnitab energeetika- ja keskkonnaminister peadirektori ettepanekul. RT I 2025-06-13 1 113062025001 2025-06-16 Ameti teenistuskohtade piirarvu kinnitab energeetika- ja keskkonnaminister peadirektori ettepanekul. 2 (2) Ameti struktuuriüksused on osakonnad. Ameti struktuuriüksused on osakonnad. 3 (3) Osakonna ülesanded, pädevus, juhtimiskorraldus ja struktuuriüksuse juhi asendamine sätestatakse struktuuriüksuse põhimäärusega. Osakonna ülesanded, pädevus, juhtimiskorraldus ja struktuuriüksuse juhi asendamine sätestatakse struktuuriüksuse põhimäärusega. 4 (4) Osakonna koosseisu võib kuuluda allüksus, mille ülesanded sätestatakse osakonna põhimääruses. Osakonna koosseisu võib kuuluda allüksus, mille ülesanded sätestatakse osakonna põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_1050285_Par_11 (redaktsioon 1050285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050285",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050285",
      "estleg:sourceAct": "Keskkonnaameti põhimäärus",
      "estleg:provisionRef": "Reg_1050285 § 11",
      "estleg:partOfAct": {
