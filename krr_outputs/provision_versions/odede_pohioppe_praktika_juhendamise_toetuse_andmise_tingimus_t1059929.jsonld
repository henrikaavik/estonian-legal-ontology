    {
      "@id": "estleg:Reg_1059929_Par_3_v1059929",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059929_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetusega toetatakse: 1 1) praktikabaasis õdede põhiõppe praktikatundide juhendamist; 2 2) tervishoiukõrgkoolis praktikakoordinaatori tasustamist õdede põhiõppe praktikatundide aruandluse koordineerimisel. Toetusega toetatakse: praktikabaasis õdede põhiõppe praktikatundide juhendamist; tervishoiukõrgkoolis praktikakoordinaatori tasustamist õdede põhiõppe praktikatundide aruandluse koordineerimisel. 2 (2) Abikõlblikkuse periood (edaspidi toetusperiood) on jooksva aasta 1. jaanuar kuni 31. detsember. Abikõlblikkuse periood (edaspidi toetusperiood) on jooksva aasta 1. jaanuar kuni 31. detsember.",
      "rdfs:label": {
        "@value": "Reg_1059929_Par_3 (redaktsioon 1059929)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059929",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1059929",
      "estleg:sourceAct": "Õdede põhiõppe praktika juhendamise toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1059929 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059929_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1059929_Par_4_v1059929",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059929_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse raames antav toetus ei ole riigiabi Euroopa Liidu toimimise lepingu artikli 107 lõike 1 tähenduses. Määruse raames antav toetus ei ole riigiabi Euroopa Liidu toimimise lepingu artikli 107 lõike 1 tähenduses.",
      "rdfs:label": {
        "@value": "Reg_1059929_Par_4 (redaktsioon 1059929)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059929",
