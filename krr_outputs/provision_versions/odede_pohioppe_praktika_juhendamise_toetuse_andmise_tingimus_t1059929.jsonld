      }
    },
    {
      "@id": "estleg:Reg_1059929_Par_5_v1059929",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059929_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetust võib taotleda juriidiline isik, mis vastab ühele järgmistest tingimustest: 1 1) õdede põhiõppe praktikabaasina tegutsev asutus, kellel on tervishoiukõrgkooliga sõlmitud raamleping või praktikaleping; 2 2) õdede põhiõpet korraldav tervishoiukõrgkool. Toetust võib taotleda juriidiline isik, mis vastab ühele järgmistest tingimustest: õdede põhiõppe praktikabaasina tegutsev asutus, kellel on tervishoiukõrgkooliga sõlmitud raamleping või praktikaleping; õdede põhiõpet korraldav tervishoiukõrgkool.",
      "rdfs:label": {
        "@value": "Reg_1059929_Par_5 (redaktsioon 1059929)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059929",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1059929",
      "estleg:sourceAct": "Õdede põhiõppe praktika juhendamise toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1059929 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059929_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1059929_Par_6_v1059929",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059929_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse taotlemisel lähtub taotleja e-toetuse keskkonna andmeväljadest. Toetuse taotlemisel lähtub taotleja e-toetuse keskkonna andmeväljadest. 2 (2) Taotluses kirjeldatud tegevused peavad hõlmama ühte § 3 lõikes 1 nimetatud tegevustest ning olema ellu viidud toetusperioodil, mis eelneb taotluse esitamise päevale ega kattu varem samal toetusperioodil esitatud taotlusega hõlmatud perioodiga. Taotluses kirjeldatud tegevused peavad hõlmama ühte § 3 lõikes 1 nimetatud tegevustest ning olema ellu viidud toetusperioodil, mis eelneb taotluse esitamise päevale ega kattu varem samal toetusperioodil esitatud taotlusega hõlmatud perioodiga. 3 (3) Taotluse on digitaalselt allkirjastanud esindusõigust omav isik. Kui taotleja esindusõiguslik isik tegutseb volikirja alusel, esitatakse koos taotlusega volikiri. Taotluse on digitaalselt allkirjastanud esindusõigust omav isik. Kui taotleja esindusõiguslik isik tegutseb volikirja alusel, esitatakse koos taotlusega volikiri. 4 (4) Määruse § 3 lõike 1 punktis 1 sätestatud toetuse taotlemisel tuleb taotlusele lisada määruse lisa 1 vormi kohane aruanne, mille koostamisel on lähtutud järgmisest: 1 1) praktikabaas täidab lisa 1 kohase vormi ja saadab selle allkirjastatult tervishoiukõrgkoolile, kellega tal on raamleping või praktikaleping; 2 2) tervishoiukõrgkooli praktikakoordinaator kontrollib lisa 1 vormi kohase aruande korrektsust vastavalt enda valduses olevatele praktikakorralduse dokumentidele, õppepraktika eeldatavale tundide mahule konkreetsel perioodil ning õppurite praktikapäevikutele ja muudele asjakohastele dokumentidele; 3 3) tervishoiukõrgkool edastab kinnitatud aruande allkirjastatuna praktikabaasile; 4 4) praktikabaas esitab tervishoiukõrgkooli poolt kinnitatud aruande RTK-le. Määruse § 3 lõike 1 punktis 1 sätestatud toetuse taotlemisel tuleb taotlusele lisada määruse lisa 1 vormi kohane aruanne, mille koostamisel on lähtutud järgmisest: praktikabaas täidab lisa 1 kohase vormi ja saadab selle allkirjastatult tervishoiukõrgkoolile, kellega tal on raamleping või praktikaleping; tervishoiukõrgkooli praktikakoordinaator kontrollib lisa 1 vormi kohase aruande korrektsust vastavalt enda valduses olevatele praktikakorralduse dokumentidele, õppepraktika eeldatavale tundide mahule konkreetsel perioodil ning õppurite praktikapäevikutele ja muudele asjakohastele dokumentidele; tervishoiukõrgkool edastab kinnitatud aruande allkirjastatuna praktikabaasile; praktikabaas esitab tervishoiukõrgkooli poolt kinnitatud aruande RTK-le. 5 (5) Määruse § 3 lõike 1 punktis 2 sätestatud toetuse taotlemisel tuleb taotlusele lisada määruse lisa 2 vormi kohane aruanne. Määruse § 3 lõike 1 punktis 2 sätestatud toetuse taotlemisel tuleb taotlusele lisada määruse lisa 2 vormi kohane aruanne.",
      "rdfs:label": {
        "@value": "Reg_1059929_Par_6 (redaktsioon 1059929)",
        "@language": "et"
      },
