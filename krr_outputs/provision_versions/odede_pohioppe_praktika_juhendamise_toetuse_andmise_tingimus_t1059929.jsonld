      }
    },
    {
      "@id": "estleg:Reg_1059929_Par_11_v1059929",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059929_Par_11"
