    {
      "@id": "estleg:Reg_1059929_Par_10_v1059929",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059929_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "RTK võib makstud toetuse osaliselt või täielikult tagasi nõuda, kui toetuse saaja on esitanud valeandmeid või ilmneb, et toetuse saaja või taotlus ei vastanud nõuetele. RTK võib makstud toetuse osaliselt või täielikult tagasi nõuda, kui toetuse saaja on esitanud valeandmeid või ilmneb, et toetuse saaja või taotlus ei vastanud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1059929_Par_10 (redaktsioon 1059929)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059929",
