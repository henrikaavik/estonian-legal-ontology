      "estleg:versionValidFrom": {
        "@value": "2024-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Otsuse või toimingu vaidlustamise korral võib taotleja esitada RTK-le vaide haldusmenetluse seaduses või kaebuse halduskohtule halduskohtumenetluse seadustikus sätestatud korras. Otsuse või toimingu vaidlustamise korral võib taotleja esitada RTK-le vaide haldusmenetluse seaduses või kaebuse halduskohtule halduskohtumenetluse seadustikus sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1059929_Par_11 (redaktsioon 1059929)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059929",
