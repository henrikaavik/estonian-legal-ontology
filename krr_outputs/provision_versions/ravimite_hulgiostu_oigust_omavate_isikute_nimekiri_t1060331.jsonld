    {
      "@id": "estleg:Reg_1060331_Par_4_v1060331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060331_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravimite hulgiostu õigus on järgmistel koolidel, kus on loodud põhikooli- ja gümnaasiumiseaduses sätestatud hariduslike erivajadustega õpilaste klassid: 1 1) Tallinna Konstantin Pätsi Vabaõhukool; 2 2) Haapsalu Viigi Kool. Ravimite hulgiostu õigus on järgmistel koolidel, kus on loodud põhikooli- ja gümnaasiumiseaduses sätestatud hariduslike erivajadustega õpilaste klassid: Tallinna Konstantin Pätsi Vabaõhukool; Haapsalu Viigi Kool.",
      "rdfs:label": {
        "@value": "Reg_1060331_Par_4 (redaktsioon 1060331)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060331",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060331",
      "estleg:sourceAct": "Ravimite hulgiostu õigust omavate isikute nimekiri",
      "estleg:provisionRef": "Reg_1060331 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060331_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060331_Par_5_v1060331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060331_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravimite hulgiostu õigus on järgmistel riigi- ja teadusasutustel või avalik-õiguslikel juriidilistel isikutel: 1 1) Tartu Ülikool; 2 2) Eesti Maaülikool; 3 3) Ravimiamet; 4 4) Põllumajandus- ja Toiduamet; 5 5) Keskkonnaagentuur; 6 6) Tervisekassa; 7 7) Tallinna Tehnikaülikool; 8 8) Kaitsepolitseiamet; 9 9) Politsei- ja Piirivalveamet. Ravimite hulgiostu õigus on järgmistel riigi- ja teadusasutustel või avalik-õiguslikel juriidilistel isikutel: Tartu Ülikool; Eesti Maaülikool; Ravimiamet; Põllumajandus- ja Toiduamet; Keskkonnaagentuur; Tervisekassa; Tallinna Tehnikaülikool; Kaitsepolitseiamet; Politsei- ja Piirivalveamet.",
      "rdfs:label": {
