        "@id": "estleg:Reg_1060331_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060331_Par_3_v1060331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060331_Par_3"
