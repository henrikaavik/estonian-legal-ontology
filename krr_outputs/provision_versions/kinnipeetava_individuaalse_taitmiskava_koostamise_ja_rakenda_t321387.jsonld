    {
      "@id": "estleg:Reg_321387_Par_6_v321387",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_321387_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Täitmiskava kinnitab ja allkirjastab inspektor-kontaktisik. Täitmiskava kinnitab ja allkirjastab inspektor-kontaktisik. 2 (2) Täitmiskava tutvustatakse kinnipeetavale. Kinnipeetav kinnitab täitmiskavaga tutvumist allkirjaga. RT I 2011-07-09 5 109072011005 2011-09-01 Täitmiskava tutvustatakse kinnipeetavale. Kinnipeetav kinnitab täitmiskavaga tutvumist allkirjaga.",
      "rdfs:label": {
        "@value": "Reg_321387_Par_6 (redaktsioon 321387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "321387",
