      "estleg:sourceAct": "Jälgimisseadmestiku kasutamisest avalikkuse teavitamise kord",
      "estleg:provisionRef": "Reg_1024830 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024830_Map_2026"
      }
    },
    {
