      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061786_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadamapidaja lähtub elutähtsa teenuse osutamist toetavate teenuste ostmisel lepingupartneri võimest osutada teenust hädaolukorras ja teise elutähtsa teenuse katkemise korral. Sadamapidaja lähtub elutähtsa teenuse osutamist toetavate teenuste ostmisel lepingupartneri võimest osutada teenust hädaolukorras ja teise elutähtsa teenuse katkemise korral.",
      "rdfs:label": {
        "@value": "Reg_1061786_Par_8 (redaktsioon 1061786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061786",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded ning elutähtsat teenust osutavate sadamapidajate ja nende hallatavate elutähtsa teenuse osutamiseks kasutatavate sadamate määramise metoodika",
      "estleg:provisionRef": "Reg_1061786 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061786_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061786_Par_9_v1061786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061786_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elutähtsa teenuse ulatuslikust või raskete tagajärgedega katkemisest põhjustatud hädaolukord on olukord, kui katkestus kestab § 7 lõikes 1 märgitud ajast kauem või kui elutähtsa teenuse katkemine põhjustab teise hädaolukorra seaduse §-s 36 sätestatud teenuse toimimise katkemise. Elutähtsa teenuse ulatuslikust või raskete tagajärgedega katkemisest põhjustatud hädaolukord on olukord, kui katkestus kestab § 7 lõikes 1 märgitud ajast kauem või kui elutähtsa teenuse katkemine põhjustab teise hädaolukorra seaduse §-s 36 sätestatud teenuse toimimise katkemise.",
      "rdfs:label": {
        "@value": "Reg_1061786_Par_9 (redaktsioon 1061786)",
        "@language": "et"
