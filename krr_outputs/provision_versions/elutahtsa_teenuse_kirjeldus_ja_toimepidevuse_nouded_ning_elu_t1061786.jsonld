        "@id": "estleg:Reg_1061786_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061786_Par_10_v1061786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061786_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sadamapidaja teavitab viivitamata Kliimaministeeriumit ja Transpordiametit hädaolukorrast või selle ohust telefonitsi ja e-posti teel. Sadamapidaja teavitab viivitamata Kliimaministeeriumit ja Transpordiametit hädaolukorrast või selle ohust telefonitsi ja e-posti teel. 2 (2) Lõikes 1 nimetatud teavitus peab sisaldama vähemalt järgmist teavet: 1 1) elutähtsa teenuse katkemise aeg ja kestus; 2 2) elutähtsa teenuse katkemise tegelik või oletatav põhjus ja hetkeolukorra lühikirjeldus; 3 3) elutähtsa teenuse katkemise mõju; 4 4) elutähtsa teenuse taastamiseks või teenuse katkemise mõju vähendamiseks rakendatud ja rakendatavad meetmed. Lõikes 1 nimetatud teavitus peab sisaldama vähemalt järgmist teavet: elutähtsa teenuse katkemise aeg ja kestus; elutähtsa teenuse katkemise tegelik või oletatav põhjus ja hetkeolukorra lühikirjeldus; elutähtsa teenuse katkemise mõju; elutähtsa teenuse taastamiseks või teenuse katkemise mõju vähendamiseks rakendatud ja rakendatavad meetmed.",
      "rdfs:label": {
        "@value": "Reg_1061786_Par_10 (redaktsioon 1061786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061786",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded ning elutähtsat teenust osutavate sadamapidajate ja nende hallatavate elutähtsa teenuse osutamiseks kasutatavate sadamate määramise metoodika",
      "estleg:provisionRef": "Reg_1061786 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061786_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061786_Par_2_v1061786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061786_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elutähtsat teenust osutav sadamapidaja (edaspidi sadamapidaja) sadamaseaduse § 31 lõike 1 ja käesoleva määruse tähenduses on isik, kelle hallatav sadam vastab vähemalt ühele järgmistest tingimustest: 1 1) sadama toimimine mõjutab teise elutähtsa teenuse toimepidevuse või riigikaitse tagamist; 2 2) sadamat läbivate reisijate arv moodustab vähemalt 50% rahvusvaheliste laevareisijate arvust Eestis; 3 3) sadamat läbiva kauba maht moodustab vähemalt 20% Eesti sadamaid läbivast kaubamahust. Elutähtsat teenust osutav sadamapidaja (edaspidi sadamapidaja) sadamaseaduse § 31 lõike 1 ja käesoleva määruse tähenduses on isik, kelle hallatav sadam vastab vähemalt ühele järgmistest tingimustest: sadama toimimine mõjutab teise elutähtsa teenuse toimepidevuse või riigikaitse tagamist; sadamat läbivate reisijate arv moodustab vähemalt 50% rahvusvaheliste laevareisijate arvust Eestis; sadamat läbiva kauba maht moodustab vähemalt 20% Eesti sadamaid läbivast kaubamahust.",
      "rdfs:label": {
        "@value": "Reg_1061786_Par_2 (redaktsioon 1061786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061786",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded ning elutähtsat teenust osutavate sadamapidajate ja nende hallatavate elutähtsa teenuse osutamiseks kasutatavate sadamate määramise metoodika",
      "estleg:provisionRef": "Reg_1061786 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061786_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061786_Par_3_v1061786",
      "@type": [
