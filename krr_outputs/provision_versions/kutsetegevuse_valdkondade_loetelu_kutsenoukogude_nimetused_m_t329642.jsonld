      }
    },
    {
      "@id": "estleg:Reg_329642_Par_13_v329642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_329642_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutsenõukogu liikmel on kohustus teavitada institutsiooni, kelle esindaja ta kutsenõukogus on, kutsenõukogu tegevusest ja kutsenõukogu vastuvõetud otsustest. Kutsenõukogu liikmel on kohustus teavitada institutsiooni, kelle esindaja ta kutsenõukogus on, kutsenõukogu tegevusest ja kutsenõukogu vastuvõetud otsustest.",
      "rdfs:label": {
        "@value": "Reg_329642_Par_13 (redaktsioon 329642)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "329642",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/329642",
      "estleg:sourceAct": "Kutsetegevuse valdkondade loetelu, kutsenõukogude nimetused, moodustamise ja lõpetamise kord, töökorraldus ning kutsenõukogusse institutsioonide esindajate nimetamise kord ja nende volituste kestus",
      "estleg:provisionRef": "Reg_329642 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_329642_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_329642_Par_2_v329642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_329642_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutsenõukogudel on järgmised nimetused: 1 1) Arhitektuuri, Geomaatika, Ehituse ja Kinnisvara Kutsenõukogu; 2 2) Energeetika, Mäe- ja Keemiatööstuse Kutsenõukogu; 3 3) Hariduse Kutsenõukogu; 4 4) Infotehnoloogia ja Telekommunikatsiooni Kutsenõukogu; 5 5) Kultuuri Kutsenõukogu; 6 6) Metsanduse Kutsenõukogu; 7 7) Sotsiaalhoolekande Kutsenõukogu; 8 8) Teeninduse Kutsenõukogu; 9 9) Tehnika, Tootmise ja Töötlemise Kutsenõukogu; 10 10) Tervishoiu Kutsenõukogu; 11 11) Toiduainetööstuse ja Põllumajanduse Kutsenõukogu; 12 12) Transpordi ja Logistika Kutsenõukogu; 13 13) Vara- ja Isikukaitse Kutsenõukogu; 14 14) Äriteeninduse ja Muu Äritegevuse Kutsenõukogu. RT I 2015-07-15 1 115072015001 2015-07-18 Kutsenõukogudel on järgmised nimetused: Arhitektuuri, Geomaatika, Ehituse ja Kinnisvara Kutsenõukogu; Energeetika, Mäe- ja Keemiatööstuse Kutsenõukogu; Hariduse Kutsenõukogu; Infotehnoloogia ja Telekommunikatsiooni Kutsenõukogu; Kultuuri Kutsenõukogu; Metsanduse Kutsenõukogu; Sotsiaalhoolekande Kutsenõukogu; Teeninduse Kutsenõukogu; Tehnika, Tootmise ja Töötlemise Kutsenõukogu; Tervishoiu Kutsenõukogu; Toiduainetööstuse ja Põllumajanduse Kutsenõukogu; Transpordi ja Logistika Kutsenõukogu; Vara- ja Isikukaitse Kutsenõukogu; Äriteeninduse ja Muu Äritegevuse Kutsenõukogu.",
      "rdfs:label": {
        "@value": "Reg_329642_Par_2 (redaktsioon 329642)",
        "@language": "et"
      },
