      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kutsetegevuse valdkondade loetelu, kutsenõukogude nimetused, moodustamise ja lõpetamise kord, töökorraldus ning kutsenõukogusse institutsioonide esindajate nimetamise kord ja nende volituste kestus (14 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kutsetegevuse valdkondade loetelu, kutsenõukogude nimetused, moodustamise ja lõpetamise kord, töökorraldus ning kutsenõukogusse institutsioonide esindajate nimetamise kord ja nende volituste kestus"
    },
    {
      "@id": "estleg:Reg_329642_Par_1_v329642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_329642_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kutsetegevuse valdkond on tegevusvaldkond, mis hõlmab mitut lähedast kutseala. Kutsetegevuse valdkond on tegevusvaldkond, mis hõlmab mitut lähedast kutseala. 2 (2) Kutsetegevuse valdkonnad on järgmised: 1 1) arhitektuur, geomaatika, ehitus ja kinnisvara; 2 2) energeetika, mäe- ja keemiatööstus; 3 3) haridus; 4 4) infotehnoloogia ja telekommunikatsioon; 5 5) kultuur; 6 6) metsandus; 7 7) sotsiaalhoolekanne; 8 8) teenindus; 9 9) tehnika, tootmine ja töötlemine; 10 10) tervishoid; 11 11) toiduainetööstus ja põllumajandus; 12 12) transport ja logistika; 13 13) vara- ja isikukaitse; 14 14) äriteenindus ja muu äritegevus. RT I 2015-07-15 1 115072015001 2015-07-18 Kutsetegevuse valdkonnad on järgmised: arhitektuur, geomaatika, ehitus ja kinnisvara; energeetika, mäe- ja keemiatööstus; haridus; infotehnoloogia ja telekommunikatsioon; kultuur; metsandus; sotsiaalhoolekanne; teenindus; tehnika, tootmine ja töötlemine; tervishoid; toiduainetööstus ja põllumajandus; transport ja logistika; vara- ja isikukaitse; äriteenindus ja muu äritegevus.",
      "rdfs:label": {
        "@value": "Reg_329642_Par_1 (redaktsioon 329642)",
        "@language": "et"
      },
