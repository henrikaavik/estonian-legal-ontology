      },
      "estleg:versionText": "Relvade ja laskemoona müügikoht (edaspidi müügikoht) on ruum, kus müüakse relvi ja laskemoona.",
      "rdfs:label": {
        "@value": "Reg_160010_Par_1 (redaktsioon 160010)",
        "@language": "et"
      },
