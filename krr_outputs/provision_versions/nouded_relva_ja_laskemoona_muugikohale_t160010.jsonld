    {
      "@id": "estleg:Reg_160010_Par_10_v160010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160010_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Relvahoidla elektriseadmed peavad olema plahvatusohutu teostusega. Relvahoidla elektriseadmed peavad olema plahvatusohutu teostusega. 2 (2) Relvahoidlas on valgustid, mida saab sisse ja välja lülitada ilma relvahoidla ust avamata. Relvahoidlas on valgustid, mida saab sisse ja välja lülitada ilma relvahoidla ust avamata.",
      "rdfs:label": {
        "@value": "Reg_160010_Par_10 (redaktsioon 160010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "160010",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/160010",
      "estleg:sourceAct": "Nõuded relva ja laskemoona müügikohale",
      "estleg:provisionRef": "Reg_160010 § 10",
