      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Isikuandmete automatiseeritud töötlemisel isiku kaitse konventsiooni ratifitseerimise seadus (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Isikuandmete automatiseeritud töötlemisel isiku kaitse konventsiooni ratifitseerimise seadus"
    },
    {
      "@id": "estleg:IATIKKR_Par_1_v26705",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:IATIKKR_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud , mis on koostatud 1981. aasta 28. jaanuaril Strasbourgis ning mille Eesti Vabariik kiitis heaks ja allkirjastas 2000. aasta 24. jaanuaril.",
      "rdfs:label": {
        "@value": "IATIKKR_Par_1 (redaktsioon 26705)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26705"
    },
    {
      "@id": "estleg:IATIKKR_Par_2_v26705",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:IATIKKR_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastavalt konventsiooni artikli 3 lõike 2 punktile a deklareerib Eesti Vabariik, et konventsiooni ei kohaldata füüsiliste isikute poolt kogutud isikuandmete töötlemisele isiklikuks otstarbeks.",
      "rdfs:label": {
        "@value": "IATIKKR_Par_2 (redaktsioon 26705)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26705"
    },
    {
      "@id": "estleg:IATIKKR_Par_3_v26705",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:IATIKKR_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastavalt konventsiooni artikli 13 lõike 2 punktile a nimetab Eesti Vabariik volitatud ametiasutuseks Andmekaitse Inspektsiooni.",
      "rdfs:label": {
        "@value": "IATIKKR_Par_3 (redaktsioon 26705)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26705"
    }
  ]
