      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui Euroopa Parlamendi ja nõukogu määruse (EL) nr 1305/2013 artiklis 48 nimetatud kohustuste kohandamine ei ole toetuse saajale vastuvõetav, siis kohustus lõppeb ja kohustuse kehtivusaja eest toetust tagasi ei nõuta. RT I 2018-01-04 1 104.01.2018001 2018-01-07 Kui Euroopa Parlamendi ja nõukogu määruse (EL) nr 1305/2013 artiklis 48 nimetatud kohustuste kohandamine ei ole toetuse saajale vastuvõetav, siis kohustus lõppeb ja kohustuse kehtivusaja eest toetust tagasi ei nõuta.",
      "rdfs:label": {
        "@value": "Reg_1029417_Par_14_14 (redaktsioon 1029417)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029417",
