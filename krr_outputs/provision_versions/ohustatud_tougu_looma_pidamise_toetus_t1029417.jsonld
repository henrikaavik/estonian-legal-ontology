    {
      "@id": "estleg:Reg_1029417_Par_7_v1029417",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029417_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Põllumajandusliku majapidamise üleandmise korral kohaldatakse komisjoni rakendusmääruse (EL) nr 809/2014, millega kehtestatakse Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 rakenduseeskirjad seoses ühtse haldus- ja kontrollisüsteemi, maaelu arengu meetmete ja nõuetele vastavusega (ELT L 227, 31.07.2014, lk 69–124), artiklis 8 sätestatut. Põllumajandusliku majapidamise üleandmise korral kohaldatakse komisjoni rakendusmääruse (EL) nr 809/2014, millega kehtestatakse Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 rakenduseeskirjad seoses ühtse haldus- ja kontrollisüsteemi, maaelu arengu meetmete ja nõuetele vastavusega (ELT L 227, 31.07.2014, lk 69–124), artiklis 8 sätestatut. 2 (2) Komisjoni rakendusmääruse (EL) nr 809/2014 artikli 8 lõike 3 punktis a nimetatud ajavahemik algab 22. mail ning lõppeb 8. septembril. RT I 2022-12-29 24 129122022024 2023-01-01 Komisjoni rakendusmääruse (EL) nr 809/2014 artikli 8 lõike 3 punktis a nimetatud ajavahemik algab 22. mail ning lõppeb 8. septembril.",
      "rdfs:label": {
        "@value": "Reg_1029417_Par_7 (redaktsioon 1029417)",
        "@language": "et"
      },
