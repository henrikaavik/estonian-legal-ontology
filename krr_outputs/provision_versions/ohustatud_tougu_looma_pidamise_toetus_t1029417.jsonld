    },
    {
      "@id": "estleg:Reg_1029417_Par_1_v1029417",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029417_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” (edaspidi arengukava) meetme 10 „Põllumajanduse keskkonna- ja kliimameede” tegevuse liigi „Ohustatud tõugu looma pidamise toetus” raames antava ohustatud tõugu looma pidamise toetuse (edaspidi toetus) andmise tingimused ja kord. Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” (edaspidi arengukava) meetme 10 „Põllumajanduse keskkonna- ja kliimameede” tegevuse liigi „Ohustatud tõugu looma pidamise toetus” raames antava ohustatud tõugu looma pidamise toetuse (edaspidi toetus) andmise tingimused ja kord.",
      "rdfs:label": {
        "@value": "Reg_1029417_Par_1 (redaktsioon 1029417)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029417",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029417",
