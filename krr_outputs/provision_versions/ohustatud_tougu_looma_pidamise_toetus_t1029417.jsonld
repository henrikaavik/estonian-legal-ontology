      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA teavitab toetuse saajat tema andmete avalikustamisest Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 artiklite 111 ja 112 kohaselt ning nende töötlemisest Euroopa Liidu finantshuvide tagamise eesmärgil sama määruse artikli 113 kohaselt. RT I 2018-01-04 1 104.01.2018001 2018-01-07 PRIA teavitab toetuse saajat tema andmete avalikustamisest Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 artiklite 111 ja 112 kohaselt ning nende töötlemisest Euroopa Liidu finantshuvide tagamise eesmärgil sama määruse artikli 113 kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1029417_Par_14_15 (redaktsioon 1029417)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029417",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029417",
      "estleg:sourceAct": "Ohustatud tõugu looma pidamise toetus",
      "estleg:provisionRef": "Reg_1029417 § 14_15",
