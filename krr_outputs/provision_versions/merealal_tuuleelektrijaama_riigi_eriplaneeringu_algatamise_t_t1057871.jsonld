      "dc:source": "Merealal tuuleelektrijaama riigi eriplaneeringu algatamise taotluse alusel konkursi algatamise ja läbiviimise kord ning tingimused"
    },
    {
      "@id": "estleg:Reg_1057871_Par_1_v1057871",
