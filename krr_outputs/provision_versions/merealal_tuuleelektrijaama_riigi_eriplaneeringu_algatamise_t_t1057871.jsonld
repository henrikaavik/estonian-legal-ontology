      }
    },
    {
      "@id": "estleg:Reg_1057871_Par_8_v1057871",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057871_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pädev asutus tunnistab konkursi nurjunuks, kui: 1 1) on rikutud konkursi läbiviimise korda; 2 2) pärast konkursi läbiviimist selgub, et konkursi võitnud osaleja on esitanud valeandmeid; 3 3) jääb ainult üks nõuetele vastav pakkumine pärast seda, kui konkursi võitja ei tasu enampakkumisel pakutud summat nõutud tähtaja jooksul või võtab riigi eriplaneeringu taotluse tagasi; 4 4) konkursil osalemiseks esitati ainult üks nõuetele vastav avaldus; 5 5) konkursil ei esitatud ühtegi pakkumist või nõuetele vastavat pakkumist; 6 6) konkursil ilmnes osalejate kokkulepe või kooskõlastatud tegevus, mis mõjutas või võis oluliselt mõjutada konkursi tulemust; 7 7) ilmnevad muud konkursi tulemust mõjutada võinud asjaolud. Pädev asutus tunnistab konkursi nurjunuks, kui: on rikutud konkursi läbiviimise korda; pärast konkursi läbiviimist selgub, et konkursi võitnud osaleja on esitanud valeandmeid; jääb ainult üks nõuetele vastav pakkumine pärast seda, kui konkursi võitja ei tasu enampakkumisel pakutud summat nõutud tähtaja jooksul või võtab riigi eriplaneeringu taotluse tagasi; konkursil osalemiseks esitati ainult üks nõuetele vastav avaldus; konkursil ei esitatud ühtegi pakkumist või nõuetele vastavat pakkumist; konkursil ilmnes osalejate kokkulepe või kooskõlastatud tegevus, mis mõjutas või võis oluliselt mõjutada konkursi tulemust; ilmnevad muud konkursi tulemust mõjutada võinud asjaolud.",
      "rdfs:label": {
        "@value": "Reg_1057871_Par_8 (redaktsioon 1057871)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057871",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057871",
      "estleg:sourceAct": "Merealal tuuleelektrijaama riigi eriplaneeringu algatamise taotluse alusel konkursi algatamise ja läbiviimise kord ning tingimused",
      "estleg:provisionRef": "Reg_1057871 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057871_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057871_Par_9_v1057871",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057871_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkurss lõpeb, kui: 1 1) pädev asutus esitab konkursi tulemused planeerimisseaduse § 281 lõikes 4 sätestatu kohaselt riigi eriplaneeringu koostamise korraldajale, ja algatatakse riigi eriplaneeringu menetlus; 2 2) käesoleva määruse § 10 lõikes 1 nimetatud tagatisraha ei ole ühegi konkursil osaleda soovinud konkureeriva taotluse esitaja poolt tähtajaks tasutud; 3 3) pädev asutus tunnistab konkursi nurjunuks käesoleva määruse § 8 alusel; 4 4) konkursile ei esitatud ühtegi nõuetele vastavat avaldust. Konkurss lõpeb, kui: pädev asutus esitab konkursi tulemused planeerimisseaduse § 281 lõikes 4 sätestatu kohaselt riigi eriplaneeringu koostamise korraldajale, ja algatatakse riigi eriplaneeringu menetlus; käesoleva määruse § 10 lõikes 1 nimetatud tagatisraha ei ole ühegi konkursil osaleda soovinud konkureeriva taotluse esitaja poolt tähtajaks tasutud; pädev asutus tunnistab konkursi nurjunuks käesoleva määruse § 8 alusel; konkursile ei esitatud ühtegi nõuetele vastavat avaldust.",
      "rdfs:label": {
        "@value": "Reg_1057871_Par_9 (redaktsioon 1057871)",
        "@language": "et"
      },
