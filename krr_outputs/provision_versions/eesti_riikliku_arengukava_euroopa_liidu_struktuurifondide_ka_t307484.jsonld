      "rdfs:label": {
        "@value": "Sätete redaktsioonid: \"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument 2004–2006” kolmanda prioriteedi toetuse kasutamise seire eeskiri (13 versiooni)",
        "@language": "et"
      },
      "dc:source": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument 2004–2006” kolmanda prioriteedi toetuse kasutamise seire eeskiri"
    },
    {
      "@id": "estleg:Reg_307484_Par_1_v307484",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_307484_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib «Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument 2004–2006» kolmanda prioriteedi «põllumajandus, kalandus ja maaelu» (edaspidi kolmas prioriteet) raames rakendatavate meetmete seire läbiviimist meetme ja kolmanda prioriteedi rakendusasutuses, kelleks on Põllumajandusministeerium, ning meetme ja kolmanda prioriteedi rakendusüksuses, kelleks on Põllumajanduse Registrite ja Informatsiooni Amet (edaspidi PRIA). Määrus reguleerib «Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument 2004–2006» kolmanda prioriteedi «põllumajandus, kalandus ja maaelu» (edaspidi kolmas prioriteet) raames rakendatavate meetmete seire läbiviimist meetme ja kolmanda prioriteedi rakendusasutuses, kelleks on Põllumajandusministeerium, ning meetme ja kolmanda prioriteedi rakendusüksuses, kelleks on Põllumajanduse Registrite ja Informatsiooni Amet (edaspidi PRIA).",
      "rdfs:label": {
        "@value": "Reg_307484_Par_1 (redaktsioon 307484)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "307484",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/307484",
      "estleg:sourceAct": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument 2004–2006” kolmanda prioriteedi toetuse kasutamise seire eeskiri",
      "estleg:provisionRef": "Reg_307484 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_307484_Map"
      }
    },
    {
      "@id": "estleg:Reg_307484_Par_10_v307484",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_307484_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Prioriteedi lõpparuanne sisaldab lisaks § 9 lõikes 1 nimetatud teabele Põllumajandusministeeriumi lõpphinnangut prioriteedi eesmärkide saavutamisele, prioriteedi tulemuslikkusele ja elluviimisele. Prioriteedi lõpparuanne sisaldab lisaks § 9 lõikes 1 nimetatud teabele Põllumajandusministeeriumi lõpphinnangut prioriteedi eesmärkide saavutamisele, prioriteedi tulemuslikkusele ja elluviimisele. 2(2)Põllumajandusministeerium esitab prioriteedi juhtkomisjoni kinnitatud prioriteedi lõpparuande Rahandusministeeriumile 2. juuliks 2010. a. Põllumajandusministeerium esitab prioriteedi juhtkomisjoni kinnitatud prioriteedi lõpparuande Rahandusministeeriumile 2. juuliks 2010. a.",
      "rdfs:label": {
        "@value": "Reg_307484_Par_10 (redaktsioon 307484)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "307484",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/307484",
      "estleg:sourceAct": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument 2004–2006” kolmanda prioriteedi toetuse kasutamise seire eeskiri",
      "estleg:provisionRef": "Reg_307484 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_307484_Map"
      }
    },
    {
      "@id": "estleg:Reg_307484_Par_11_v307484",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_307484_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Põllumajandusministeerium koondab ja esitab põllumajanduse seire teabe järgmiselt:11)Euroopa Põllumajanduse Peadirektoraadile esitatakse põllumajanduse seire teave;22)Rahandusministeeriumile esitatakse põllumajanduse seire teave koos prioriteedi aastaaruandega järgmise aasta 15. aprilliks. Põllumajandusministeerium koondab ja esitab põllumajanduse seire teabe järgmiselt: Euroopa Põllumajanduse Peadirektoraadile esitatakse põllumajanduse seire teave; Rahandusministeeriumile esitatakse põllumajanduse seire teave koos prioriteedi aastaaruandega järgmise aasta 15. aprilliks. 2(2)Põllumajandusministeerium koondab ja esitab kalanduse seire teabe Kalanduse Peadirektoraadile 30. aprilliks. Põllumajandusministeerium koondab ja esitab kalanduse seire teabe Kalanduse Peadirektoraadile 30. aprilliks.",
      "rdfs:label": {
        "@value": "Reg_307484_Par_11 (redaktsioon 307484)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "307484",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/307484",
      "estleg:sourceAct": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument 2004–2006” kolmanda prioriteedi toetuse kasutamise seire eeskiri",
      "estleg:provisionRef": "Reg_307484 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_307484_Map"
      }
    },
    {
      "@id": "estleg:Reg_307484_Par_12_v307484",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_307484_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandusministri 20. aprilli 2004. a määrus nr 45 «Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument aastateks 2004–2006 kolmanda prioriteedi toetuse seire läbiviimise eeskiri» (RTL 2004, 48, 827) tunnistatakse kehtetuks. Põllumajandusministri 20. aprilli 2004. a määrus nr 45 «Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument aastateks 2004–2006 kolmanda prioriteedi toetuse seire läbiviimise eeskiri» (RTL 2004, 48, 827) tunnistatakse kehtetuks.",
      "rdfs:label": {
