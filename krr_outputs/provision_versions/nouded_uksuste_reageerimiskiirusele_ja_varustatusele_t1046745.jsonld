      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded üksuste reageerimiskiirusele ja varustatusele (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded üksuste reageerimiskiirusele ja varustatusele"
    },
    {
      "@id": "estleg:Reg_1046745_Par_1_v1046745",
      "@type": [
