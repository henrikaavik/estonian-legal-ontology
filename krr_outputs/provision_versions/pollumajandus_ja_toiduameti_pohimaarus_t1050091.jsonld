      }
    },
    {
      "@id": "estleg:Reg_1050091_Par_5_v1050091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050091_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandus- ja Toiduameti tegevusvaldkonnad on toidu- ja söödaohutus, loomatervis ja -heaolu, põllumajandusloomade aretus, taimekaitse ja taimetervis, taimne paljundusmaterjal, väetis, mahepõllumajandus ja kutseline kalapüük ning Euroopa Liidu ühise põllumajanduspoliitika ning maaelu ja põllumajandusturu korraldamine. RT I 2024-12-28 13 128122024013 2025-01-01 Põllumajandus- ja Toiduameti tegevusvaldkonnad on toidu- ja söödaohutus, loomatervis ja -heaolu, põllumajandusloomade aretus, taimekaitse ja taimetervis, taimne paljundusmaterjal, väetis, mahepõllumajandus ja kutseline kalapüük ning Euroopa Liidu ühise põllumajanduspoliitika ning maaelu ja põllumajandusturu korraldamine.",
      "rdfs:label": {
        "@value": "Reg_1050091_Par_5 (redaktsioon 1050091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050091",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050091",
      "estleg:sourceAct": "Põllumajandus- ja Toiduameti põhimäärus",
      "estleg:provisionRef": "Reg_1050091 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050091_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050091_Par_6_v1050091",
      "@type": [
        "owl:NamedIndividual",
