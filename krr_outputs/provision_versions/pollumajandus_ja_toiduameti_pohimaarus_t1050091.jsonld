    {
      "@id": "estleg:Reg_1050091_Par_4_v1050091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050091_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet asub Sakus. Ameti postiaadress on Teaduse 2, Saku, 75501 Harjumaa. Ameti mujal asuva struktuuriüksuse asukoht märgitakse struktuuriüksuse põhimääruses. RT I 2023-04-14 3 114042023003 2023-05-01 Amet asub Sakus. Ameti postiaadress on Teaduse 2, Saku, 75501 Harjumaa. Ameti mujal asuva struktuuriüksuse asukoht märgitakse struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_1050091_Par_4 (redaktsioon 1050091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050091",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050091",
      "estleg:sourceAct": "Põllumajandus- ja Toiduameti põhimäärus",
      "estleg:provisionRef": "Reg_1050091 § 4",
      "estleg:partOfAct": {
