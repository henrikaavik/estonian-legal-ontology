    {
      "@id": "estleg:Reg_1050091_Par_2_v1050091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050091_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametil on sõõrikujuline 35-millimeetrise läbimõõduga pitsat, mille keskel on väikese riigivapi kujutis. Sõõri ülemist äärt mööda on sõnad „Põllumajandus- ja Toiduamet”. Ametil on sõõrikujuline 35-millimeetrise läbimõõduga pitsat, mille keskel on väikese riigivapi kujutis. Sõõri ülemist äärt mööda on sõnad „Põllumajandus- ja Toiduamet”. 2 (2) Ametil on oma nimega dokumendiplangid, mille kujundus- ja turvaelemendina kasutatakse väikese riigivapi kujutist. Dokumendiplangi kasutamise kord sätestatakse ameti asjaajamiskorras. Ametil on oma nimega dokumendiplangid, mille kujundus- ja turvaelemendina kasutatakse väikese riigivapi kujutist. Dokumendiplangi kasutamise kord sätestatakse ameti asjaajamiskorras. 3 (3) Ameti struktuuriüksusel võib olla oma nimega pitsat, kui see on ette nähtud struktuuriüksuse põhimääruses. Ameti struktuuriüksusel võib olla oma nimega pitsat, kui see on ette nähtud struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_1050091_Par_2 (redaktsioon 1050091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050091",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050091",
      "estleg:sourceAct": "Põllumajandus- ja Toiduameti põhimäärus",
      "estleg:provisionRef": "Reg_1050091 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050091_Map_2026"
      }
    },
