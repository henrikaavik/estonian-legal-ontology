    {
      "@id": "estleg:NotS_Par_1_v26691",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib notariameti ning Notarite Koja staatust. (2) Notariaalset tõestamismenetlust, notari distsiplinaarvastutust ning notari tasu määrasid reguleeritakse teiste seadustega.",
      "rdfs:label": {
        "@value": "NotS_Par_1 (redaktsioon 26691)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26691",
      "estleg:supersededByVersion": {
