      }
    },
    {
      "@id": "estleg:NotS_Par_1_v12895925",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib notariameti ning Notarite Koja staatust. (2) Notariaalset tõestamismenetlust, notari distsiplinaarvastutust ning notari tasu määrasid reguleeritakse teiste seadustega. (3) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse sätteid, arvestades käesoleva seaduse erisusi. Haldusmenetluse seadust ei kohaldata notari ametitoimingutele.",
      "rdfs:label": {
        "@value": "NotS_Par_1 (redaktsioon 12895925)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895925",
