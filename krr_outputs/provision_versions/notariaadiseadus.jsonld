    },
    {
      "@id": "estleg:NotS_Par_52_1_v119032019071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_52_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notarite Koja lepitus- ja vahekohus on vaidluste kohtuvälise lahendamise organ. (2) Notarite Koda kehtestab lepitus- ja vahekohtu reglemendi, milles sätestatakse lepitus- ja vahekohtu pädevus ja menetlus, arvestades tsiviilkohtumenetluse ning lepitusseaduse imperatiivseid sätteid, ja tasu. (3) Notarite Koja lepitus- ja vahekohtu tegevuse suhtes ei kohaldata lepitusseaduse 6. peatükki.",
      "rdfs:label": {
        "@value": "NotS_Par_52_1 (redaktsioon 119032019071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019071",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotS_Par_52_1_v122122020036"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotS_Par_52_1_v122122020036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_52_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notarite Koja vahekohus on vaidluste kohtuvälise lahendamise organ. (2) Notarite Koda kehtestab vahekohtu reglemendi, milles sätestatakse vahekohtu pädevus ja menetlus, arvestades tsiviilkohtumenetluse ning lepitusseaduse imperatiivseid sätteid, ja tasu. (3) Notarite Koja vahekohtu tegevuse suhtes ei kohaldata lepitusseaduse 6. peatükki.",
      "rdfs:label": {
        "@value": "NotS_Par_52_1 (redaktsioon 122122020036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122020036"
    },
    {
      "@id": "estleg:NotS_Par_53_v26691",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tõestamistoimingu võivad notari asemel teha järgmised ametiisikud ja -asutused: konsulaarametnik ja aukonsul - konsulaarseaduses (RT I 1998, 113/114, 1874) sätestatud tingimustel; valla- ja linnasekretär - dokumendi ärakirja ja väljavõtte õigsuse kinnitamisel, allkirja õigsuse kinnitamisel, auto kasutamise volikirja tõestamisel, pensioni, elatisraha ja toetuste vastuvõtmise volikirja tõestamisel; avalik arhiiv - arhivaali ärakirja ja väljavõtte ning arhiiviteatise õigsuse kinnitamisel; kohtunik, kohtunikuabi, kohtu kantseleijuhataja, kohtu arhivaar ning kinnistus- ja registrisekretär - kohtus säilitatava dokumendi ärakirja ja väljavõtte õigsuse kinnitamisel; vannutatud maamõõtja - piiriprotokollil ning kinnisasja piiri muutmiseks antud nõusolekul oleva allkirja õigsuse kinnitamisel; vandetõlk - dokumendi tõlke ja selle ärakirja õigsuse kinnitamisel; vangladirektor - kinnipeetava allkirja õigsuse ning kinnipeetava taotlusel dokumendi ärakirja ja väljavõtte õigsuse kinnitamisel.",
      "rdfs:label": {
        "@value": "NotS_Par_53 (redaktsioon 26691)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26691",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotS_Par_53_v686734"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotS_Par_53_v686734",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tõestamistoimingu võivad notari asemel teha järgmised ametiisikud ja -asutused: konsulaarametnik - konsulaarseaduses sätestatud tingimustel; valla- ja linnasekretär - dokumendi ärakirja ja väljavõtte õigsuse kinnitamisel, allkirja õigsuse kinnitamisel, auto kasutamise volikirja tõestamisel, pensioni, elatisraha ja toetuste vastuvõtmise volikirja tõestamisel; avalik arhiiv - arhivaali ärakirja ja väljavõtte ning arhiiviteatise õigsuse kinnitamisel; kohtunik, kohtunikuabi, kohtu kantseleijuhataja, kohtu arhivaar ning kinnistus- ja registrisekretär - kohtus säilitatava dokumendi ärakirja ja väljavõtte õigsuse kinnitamisel; vannutatud maamõõtja - piiriprotokollil ning kinnisasja piiri muutmiseks antud nõusolekul oleva allkirja õigsuse kinnitamisel; vandetõlk - dokumendi tõlke ja selle ärakirja õigsuse kinnitamisel; vangladirektor - kinnipeetava allkirja õigsuse ning kinnipeetava taotlusel dokumendi ärakirja ja väljavõtte õigsuse kinnitamisel.",
      "rdfs:label": {
        "@value": "NotS_Par_53 (redaktsioon 686734)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "686734",
