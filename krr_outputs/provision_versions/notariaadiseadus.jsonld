      }
    },
    {
      "@id": "estleg:NotS_Par_57_1_v130122010008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_57_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 29 lõike 3 punkti 6 kohaldatakse majandusaasta aruandele, mis on koostatud aruandeperioodi kohta, mis algab 2009. aasta 1. jaanuaril või hiljem, kuid mitte hiljem kui 2011. aasta 31. detsembril.",
      "rdfs:label": {
        "@value": "NotS_Par_57_1 (redaktsioon 130122010008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122010008",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotS_Par_57_1_v109102013008"
      },
      "estleg:versionValidTo": {
        "@value": "2013-10-27",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotS_Par_57_1_v109102013008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_57_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-10-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 29 lõike 3 punkti 6 kohaldatakse majandusaasta aruandele, mis on koostatud aruandeperioodi kohta, mis algab 2009. aasta 1. jaanuaril või hiljem.",
      "rdfs:label": {
        "@value": "NotS_Par_57_1 (redaktsioon 109102013008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109102013008"
    },
    {
      "@id": "estleg:NotS_Par_57_2_v13185042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_57_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-06-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse ametiteenuste regulatsiooniga täiendamist käesoleva seaduse § 15 kohaselt sõlmitud ametikindlustuslepingud kehtivad edasi käesoleva seaduse § 32 lõike 3 punktides 5–9 nimetatud ametiteenuste suhtes.",
      "rdfs:label": {
        "@value": "NotS_Par_57_2 (redaktsioon 13185042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13185042"
    },
    {
      "@id": "estleg:NotS_Par_57_3_v13185042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_57_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-06-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse kandidaaditeenistuse peatumise regulatsiooniga täiendamist kandidaaditeenistusse võetud, notari eksami sooritanud notarikandidaatide suhtes saab kandidaaditeenistuse peatumist rakendada vaid juhul, kui kandidaadile makstakse hüvitist avaliku teenistuse seaduse §-s 131 sätestatud ulatuses.",
      "rdfs:label": {
        "@value": "NotS_Par_57_3 (redaktsioon 13185042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13185042",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotS_Par_57_3_v13334474"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotS_Par_57_3_v13334474",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_57_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2009. aasta 8. juunit kandidaaditeenistusse võetud, notarieksami sooritanud kandidaadi kandidaaditeenistuse peatab justiitsminister Notarite Koja ettepanekul käesoleva seaduse § 25 lõike 3 alusel. Notarite Koda maksab kandidaadile tema kahe keskmise kuutasu suuruse hüvitise hiljemalt kandidaaditeenistuse peatumise päevale eelneval päeval.",
      "rdfs:label": {
        "@value": "NotS_Par_57_3 (redaktsioon 13334474)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334474",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotS_Par_57_3_v129062014044"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotS_Par_57_3_v129062014044",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_57_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2009. aasta 8. juunit kandidaaditeenistusse võetud, notarieksami sooritanud kandidaadi kandidaaditeenistuse peatab valdkonna eest vastutav minister Notarite Koja ettepanekul käesoleva seaduse § 25 lõike 3 alusel. Notarite Koda maksab kandidaadile tema kahe keskmise kuutasu suuruse hüvitise hiljemalt kandidaaditeenistuse peatumise päevale eelneval päeval.",
      "rdfs:label": {
        "@value": "NotS_Par_57_3 (redaktsioon 129062014044)",
        "@language": "et"
      },
