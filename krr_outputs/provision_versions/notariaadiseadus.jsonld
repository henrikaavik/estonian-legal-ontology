    },
    {
      "@id": "estleg:NotS_Par_58_v26691",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub samaaegselt tõestamisseadusega.",
      "rdfs:label": {
        "@value": "NotS_Par_58 (redaktsioon 26691)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26691",
      "estleg:supersededByVersion": {
