      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kõik notari ametitoimingud registreeritakse ametitoimingute raamatus. (3) Vajaduse korral antakse selle isiku kirjaliku avalduse alusel, kelle taotlusel või kelle suhtes toiming tehti, talle väljavõte ametitoimingute raamatust.",
      "rdfs:label": {
        "@value": "NotS_Par_39 (redaktsioon 924053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "924053",
