      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notari ametikohtade arvu ja tööpiirkonnad , lähtudes õiguskäibe vajadustest. (2) Notari nimetab ametisse valdkonna eest vastutav minister. (3) Notar nimetatakse kindlasse tööpiirkonda ja talle väljastatakse ametitunnistus. (4) Notar nimetatakse ametisse eluaegsena. Notari taotlusel võib valdkonna eest vastutav minister lubada notaril pärast pensioniea saabumist jääda ametisse, kui see on vajalik õiguskäibe vajaduste rahuldamiseks, kuid mitte kauemaks kui 10 aastaks.",
      "rdfs:label": {
        "@value": "NotS_Par_8 (redaktsioon 129062014044)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014044",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotS_Par_8_v131122014011"
      },
      "estleg:versionValidTo": {
        "@value": "2015-01-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotS_Par_8_v131122014011",
