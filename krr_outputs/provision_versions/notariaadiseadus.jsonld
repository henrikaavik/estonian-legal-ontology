      }
    },
    {
      "@id": "estleg:NotS_Par_13_v12895925",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notari ametitoimingute tegemine on tasuline. (2) Notari tasu määrad kehtestatakse seadusega. (3) Notaritel on keelatud sõlmida kokkuleppeid tasumäärade muutmiseks. (4) Kehtetu − (5) Notarit käsitatakse raamatupidamise ja maksustamise alal füüsilisest isikust ettevõtjana. Notar on käibemaksukohustuslane. Ühist bürood pidavatel notaritel võib olla ühine raamatupidamine. (6) Notari tulu ametialasest tegevusest on summa, mis jääb notarile pärast notari tasuna saadud summast notaribüroo ülalpidamiskulude, seadusega sätestatud maksude ja muude notari ametialase tegevusega seotud kohustuslike maksete tasumist.",
      "rdfs:label": {
        "@value": "NotS_Par_13 (redaktsioon 12895925)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895925",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotS_Par_13_v13185042"
