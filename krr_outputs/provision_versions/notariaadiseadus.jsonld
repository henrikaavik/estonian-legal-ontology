    {
      "@id": "estleg:NotS_Par_57_v26691",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Justiitsminister annab määrusi: notari ametitoimingute vormistuslikes ja tehnilistes küsimustes, sealhulgas notari ametipitsati kasutamise kohta; notarieksami korraldamise kohta; notari asendamise korra kohta; järelevalve korraldamiseks notarite ja Notarite Koja üle; notari ja Notarite Koja poolt statistiliste aruannete koostamise ja esitamise kohta; käesoleva seaduse §-s 33 nimetatud ametitoimingute tegemise korra kohta; Notarite Koja ettepanekul digitaalse notariaalarhiivi kasutuselevõtmise tähtaja kohta.",
      "rdfs:label": {
        "@value": "NotS_Par_57 (redaktsioon 26691)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26691",
