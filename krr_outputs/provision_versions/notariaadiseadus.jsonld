      },
      "estleg:versionValidTo": {
        "@value": "2010-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotS_Par_7_v13335496",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Notari ametikoht täidetakse konkursi alusel. Konkursi tingimused ja korra , ära kuulanud Notarite Koja arvamuse.",
      "rdfs:label": {
        "@value": "NotS_Par_7 (redaktsioon 13335496)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335496",
