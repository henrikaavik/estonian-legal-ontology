    {
      "@id": "estleg:Reg_1050489_Par_17_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhi äraolekul toimub juhi asendamine allolevas järjekorras: 1 1) juhi määratud asejuht; 2 2) juhi määratud Rahapesu Andmebüroo osakonnajuhataja. RT I 2022-07-08 1 108072022001 2022-07-11 Juhi äraolekul toimub juhi asendamine allolevas järjekorras: juhi määratud asejuht; juhi määratud Rahapesu Andmebüroo osakonnajuhataja.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_17 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_18_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rahapesu Andmebüroo osakonda juhib osakonnajuhataja, kes allub vahetult juhile või asejuhile. RT I 2022-07-08 1 108072022001 2022-07-11 Rahapesu Andmebüroo osakonda juhib osakonnajuhataja, kes allub vahetult juhile või asejuhile. 2 (2) Osakonnajuhataja: 1 1) vastutab tema poolt juhitavale osakonnale pandud ülesannete õiguspärase, õigeaegse ja asjatundliku täitmise eest ning kontrollib temale alluvate teenistujate teenistuskohustuste täitmist; 2 2) annab vahetule juhile aru osakonna tegevusest; 3 3) annab alluvatele teenistujatele korraldusi osakonna ülesannete täitmiseks; 4 4) täidab temale vahetu juhi ja kõrgemalseisva juhi poolt antud korraldused või teatab nende täitmise takistustest; 5 5) teeb vahetule juhile ettepanekuid osakonna struktuuri, koosseisu ja töökorralduse muutmiseks ning teenistujate motiveerimiseks ja vajadusel hoiatuste tegemiseks või distsiplinaarkaristuste määramiseks; 6 6) taotleb osakonna ülesannete täitmiseks vajalikke vahendeid ning korraldab nende nõuetekohase hoidmise, hooldamise ja kasutamise; 7 7) taotleb osakonna teenistujatele täienduskoolitust teenistuskohustuste tulemuslikumaks täitmiseks; 8 8) esindab osakonda ja esitab osakonna nimel arvamusi ja kooskõlastusi; 9 9) allkirjastab osakonnas koostatud kirjad ja dokumendid, millega ei võeta rahalisi ega muid varalisi kohustusi ning ei anta õigusi ega panda kohustusi Rahapesu Andmebüroo välistele isikutele, kui õigusakt ei sätesta teisiti. Osakonnajuhataja: vastutab tema poolt juhitavale osakonnale pandud ülesannete õiguspärase, õigeaegse ja asjatundliku täitmise eest ning kontrollib temale alluvate teenistujate teenistuskohustuste täitmist; annab vahetule juhile aru osakonna tegevusest; annab alluvatele teenistujatele korraldusi osakonna ülesannete täitmiseks; täidab temale vahetu juhi ja kõrgemalseisva juhi poolt antud korraldused või teatab nende täitmise takistustest; teeb vahetule juhile ettepanekuid osakonna struktuuri, koosseisu ja töökorralduse muutmiseks ning teenistujate motiveerimiseks ja vajadusel hoiatuste tegemiseks või distsiplinaarkaristuste määramiseks; taotleb osakonna ülesannete täitmiseks vajalikke vahendeid ning korraldab nende nõuetekohase hoidmise, hooldamise ja kasutamise; taotleb osakonna teenistujatele täienduskoolitust teenistuskohustuste tulemuslikumaks täitmiseks; esindab osakonda ja esitab osakonna nimel arvamusi ja kooskõlastusi; allkirjastab osakonnas koostatud kirjad ja dokumendid, millega ei võeta rahalisi ega muid varalisi kohustusi ning ei anta õigusi ega panda kohustusi Rahapesu Andmebüroo välistele isikutele, kui õigusakt ei sätesta teisiti.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_18 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_19_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
