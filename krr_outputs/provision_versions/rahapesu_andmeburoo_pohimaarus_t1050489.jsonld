    },
    {
      "@id": "estleg:Reg_1050489_Par_1_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rahapesu Andmebüroo on Rahandusministeeriumi valitsemisalasse kuuluv valitsusasutus, kes täidab seadusest ja teistest õigusaktidest tulenevaid ülesandeid, teostab riiklikku järelevalvet ning kohaldab riiklikku sundi seaduses ette nähtud alustel ja ulatuses. Rahapesu andmebüroo täidab rahapesu ja terrorismi rahastamise tõkestamise seadusest tulenevaid ülesandeid sõltumatult ja võtab nimetatud seaduses sätestatud tegevust puudutavaid otsuseid vastu iseseisvalt. Rahapesu Andmebüroo on Rahandusministeeriumi valitsemisalasse kuuluv valitsusasutus, kes täidab seadusest ja teistest õigusaktidest tulenevaid ülesandeid, teostab riiklikku järelevalvet ning kohaldab riiklikku sundi seaduses ette nähtud alustel ja ulatuses. Rahapesu andmebüroo täidab rahapesu ja terrorismi rahastamise tõkestamise seadusest tulenevaid ülesandeid sõltumatult ja võtab nimetatud seaduses sätestatud tegevust puudutavaid otsuseid vastu iseseisvalt. 2 (2) Oma ülesannete täitmisel esindab Rahapesu Andmebüroo riiki. Oma ülesannete täitmisel esindab Rahapesu Andmebüroo riiki.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_1 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_10_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahapesu Andmebüroo osakonnad on: 1 1) arendus- ja tugiosakond; 1 1¹) kommunikatsiooni ja koostöö osakond; RT I 2023-02-22 20 122022023020 2023-03-01 2 2) rahvusvahelise finantssanktsiooni ja terrorismi rahastamise tõkestamise osakond; 3 3) juhtumianalüüsi osakond; 4 4) järelevalveosakond; 4 4¹) organisatsiooni järelevalve osakond; RT I 2023-02-22 20 122022023020 2023-03-01 5 5) strateegilise analüüsi osakond; 6 6) õiguse ja sunni rakendamise osakond. RT I 2022-07-08 1 108072022001 2022-07-11 Rahapesu Andmebüroo osakonnad on: arendus- ja tugiosakond; kommunikatsiooni ja koostöö osakond; rahvusvahelise finantssanktsiooni ja terrorismi rahastamise tõkestamise osakond; juhtumianalüüsi osakond; järelevalveosakond; organisatsiooni järelevalve osakond; strateegilise analüüsi osakond; õiguse ja sunni rakendamise osakond.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_10 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_10_10_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_10_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arendus- ja tugiosakonna põhiülesandeks on Rahapesu Andmebüroo põhitegevuste toetamine, muu hulgas: 1 1) info- ja kommunikatsioonitehnoloogia alase tegevuse korraldamine; 2 2) asjaajamise ja dokumendihaldusalase tegevuse korraldamine; 3 3) finantshalduse korraldamine; 4 4) kehtetu - RT I 2023-02-22 20 122022023020 2023-03-01 5 5) personalijuhtimine; 6 6) Rahapesu Andmebüroo valduses oleva riigivara haldamise korraldamine. RT I 2022-07-08 1 108072022001 2022-07-11 Arendus- ja tugiosakonna põhiülesandeks on Rahapesu Andmebüroo põhitegevuste toetamine, muu hulgas: info- ja kommunikatsioonitehnoloogia alase tegevuse korraldamine; asjaajamise ja dokumendihaldusalase tegevuse korraldamine; finantshalduse korraldamine; kehtetu - personalijuhtimine; Rahapesu Andmebüroo valduses oleva riigivara haldamise korraldamine.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_10_10 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 10_10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_10_11_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_10_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusvahelise finantssanktsiooni ja terrorismi rahastamise tõkestamise osakonna põhiülesanded on: 1 1) finantssanktsiooni kohaldamise ja terrorismi rahastamisega seotud teabe vastuvõtmine, kogumine, väljanõudmine, töötlemine, analüüsimine ja kontrollimine; 2 2) finantssanktsiooniga seotud päringutele vastamine ning haldusaktide andmine ja toimingute tegemine vastavalt rahvusvahelist sanktsiooni kehtestavas või rakendavas õigusaktis sätestatule; 3 3) finantssanktsioonist kõrvalehoidumisele või rikkumisele ja terrorismi rahastamise kahtlusele ning sellega seotud kuritegudele viitava teabe edastamine uurimisasutustele, prokuratuurile ja teistele pädevatele asutustele; 4 4) finantssanktsiooni ja terrorismi rahastamise ning sellega seotud kuritegude tõkestamise ja analüüsimise eesmärgil teabe vahetamine vastavalt rahapesu ja terrorismi rahastamise tõkestamise seaduses ning rahvusvahelise sanktsiooni seaduses sätestatule. RT I 2022-07-08 1 108072022001 2022-07-11 Rahvusvahelise finantssanktsiooni ja terrorismi rahastamise tõkestamise osakonna põhiülesanded on: finantssanktsiooni kohaldamise ja terrorismi rahastamisega seotud teabe vastuvõtmine, kogumine, väljanõudmine, töötlemine, analüüsimine ja kontrollimine; finantssanktsiooniga seotud päringutele vastamine ning haldusaktide andmine ja toimingute tegemine vastavalt rahvusvahelist sanktsiooni kehtestavas või rakendavas õigusaktis sätestatule; finantssanktsioonist kõrvalehoidumisele või rikkumisele ja terrorismi rahastamise kahtlusele ning sellega seotud kuritegudele viitava teabe edastamine uurimisasutustele, prokuratuurile ja teistele pädevatele asutustele; finantssanktsiooni ja terrorismi rahastamise ning sellega seotud kuritegude tõkestamise ja analüüsimise eesmärgil teabe vahetamine vastavalt rahapesu ja terrorismi rahastamise tõkestamise seaduses ning rahvusvahelise sanktsiooni seaduses sätestatule.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_10_11 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 10_11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_10_12_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_10_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kommunikatsiooni ja koostöö osakonna põhiülesanded on: 1 1) sise- ja väliskommunikatsiooni korraldamine; 2 2) koostöö korraldamine teiste ametiasutuste, välisriikide asjakohaste ametiasutuste ja rahvusvaheliste organisatsioonidega; 3 3) ametiasutustele ja turuosalistele koolituste korraldamine. RT I 2023-02-22 20 122022023020 2023-03-01 Kommunikatsiooni ja koostöö osakonna põhiülesanded on: sise- ja väliskommunikatsiooni korraldamine; koostöö korraldamine teiste ametiasutuste, välisriikide asjakohaste ametiasutuste ja rahvusvaheliste organisatsioonidega; ametiasutustele ja turuosalistele koolituste korraldamine.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_10_12 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 10_12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_11_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhtumianalüüsi osakonna põhiülesanded on: 1 1) rahapesule viitava teabe vastuvõtmine, kogumine, väljanõudmine, töötlemine, analüüsimine ja kontrollimine; 2 2) rahapesu kahtlusele ja sellega seotud kuritegudele viitava teabe edastamine uurimisasutustele, prokuratuurile ja teistele pädevatele asustustele; 3 3) rahapesu ja sellega seotud kuritegude tõkestamise ning analüüsimise eesmärgil teabe vahetamine vastavalt rahapesu ja terrorismi rahastamise tõkestamise seaduses sätestatule; 4 4) Rahapesu Andmebüroo rahvusvahelise infovahetuse korraldamine. RT I 2022-07-08 1 108072022001 2022-07-11 Juhtumianalüüsi osakonna põhiülesanded on: rahapesule viitava teabe vastuvõtmine, kogumine, väljanõudmine, töötlemine, analüüsimine ja kontrollimine; rahapesu kahtlusele ja sellega seotud kuritegudele viitava teabe edastamine uurimisasutustele, prokuratuurile ja teistele pädevatele asustustele; rahapesu ja sellega seotud kuritegude tõkestamise ning analüüsimise eesmärgil teabe vahetamine vastavalt rahapesu ja terrorismi rahastamise tõkestamise seaduses sätestatule; Rahapesu Andmebüroo rahvusvahelise infovahetuse korraldamine.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_11 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_12_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalveosakonna põhiülesanne on järelevalve tegemine kohustatud isikute tegevuse üle rahapesu ja terrorismi rahastamise tõkestamise seaduse täitmisel ning erikohustusega isikute üle rahvusvahelise sanktsiooni seaduse ja selle alusel kehtestatud õigusaktide täitmisel. RT I 2023-02-22 20 122022023020 2023-03-01 Järelevalveosakonna põhiülesanne on järelevalve tegemine kohustatud isikute tegevuse üle rahapesu ja terrorismi rahastamise tõkestamise seaduse täitmisel ning erikohustusega isikute üle rahvusvahelise sanktsiooni seaduse ja selle alusel kehtestatud õigusaktide täitmisel.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_12 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_12_15_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_12_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Organisatsiooni järelevalve osakonna põhiülesanne on rahapesu ja terrorismi rahastamise tõkestamise seaduses sätestatud tegevuslubadega seotud menetluste ja sobivusmenetluste läbiviimine. RT I 2023-02-22 20 122022023020 2023-03-01 Organisatsiooni järelevalve osakonna põhiülesanne on rahapesu ja terrorismi rahastamise tõkestamise seaduses sätestatud tegevuslubadega seotud menetluste ja sobivusmenetluste läbiviimine.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_12_15 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 12_15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_13_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Strateegilise analüüsi osakonna põhiülesanneteks on rahapesu ja terrorismi rahastamise riske, ohte, suundumusi, mustreid ning toimimisviise käsitlevate uuringute ja analüüside läbiviimine. Strateegilise analüüsi osakonna põhiülesanneteks on rahapesu ja terrorismi rahastamise riske, ohte, suundumusi, mustreid ning toimimisviise käsitlevate uuringute ja analüüside läbiviimine.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_13 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_13_17_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_13_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguse ja sunni rakendamise osakonna põhiülesanded on: 1 1) Rahapesu Andmebüroo esindamine kohtumenetluses ning muudes õiguslikes küsimustes või aruteludes; 2 2) Rahapesu Andmebüroo tegevusvaldkonda puudutavate õigusaktide eelnõude kohta arvamuste andmine ning vajaduse korral õigusaktide eelnõude väljatöötamises osalemine; 3 3) teiste struktuuriüksuste juriidiline nõustamine; 4 4) rahapesu ja terrorismi rahastamise tõkestamise seaduses ja rahvusvahelise sanktsiooni seaduses sätestatud väärtegude menetlemine ja sunni rakendamine. RT I 2022-07-08 1 108072022001 2022-07-11 Õiguse ja sunni rakendamise osakonna põhiülesanded on: Rahapesu Andmebüroo esindamine kohtumenetluses ning muudes õiguslikes küsimustes või aruteludes; Rahapesu Andmebüroo tegevusvaldkonda puudutavate õigusaktide eelnõude kohta arvamuste andmine ning vajaduse korral õigusaktide eelnõude väljatöötamises osalemine; teiste struktuuriüksuste juriidiline nõustamine; rahapesu ja terrorismi rahastamise tõkestamise seaduses ja rahvusvahelise sanktsiooni seaduses sätestatud väärtegude menetlemine ja sunni rakendamine.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_13_17 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 13_17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
