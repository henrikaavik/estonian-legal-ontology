      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Juht teostab seadusega ette nähtud korras teenistuslikku järelevalvet Rahapesu Andmebüroo struktuuriüksuste ja teenistujate tegevuse üle. Juht teostab seadusega ette nähtud korras teenistuslikku järelevalvet Rahapesu Andmebüroo struktuuriüksuste ja teenistujate tegevuse üle. 2 (2) Juht võib teenistusliku järelevalve vahetu teostamise teha ülesandeks asejuhile või osakonna juhatajale või muule ametnikule. RT I 2022-07-08 1 108072022001 2022-07-11 Juht võib teenistusliku järelevalve vahetu teostamise teha ülesandeks asejuhile või osakonna juhatajale või muule ametnikule.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_19 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
