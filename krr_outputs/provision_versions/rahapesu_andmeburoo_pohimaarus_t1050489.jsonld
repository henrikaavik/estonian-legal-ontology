    },
    {
      "@id": "estleg:Reg_1050489_Par_6_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahapesu Andmebüroo tegevusvaldkond on rahapesu ja terrorismi rahastamise tõkestamine ja rahvusvahelise finantssanktsiooni rakendamise tagamine. RT I 2022-07-08 1 108072022001 2022-07-11 Rahapesu Andmebüroo tegevusvaldkond on rahapesu ja terrorismi rahastamise tõkestamine ja rahvusvahelise finantssanktsiooni rakendamise tagamine.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_6 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_7_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahapesu Andmebüroo ülesanded on: 1 1) rahapesu ja terrorismi rahastamise tõkestamine, sellele viitava teabe vastuvõtmine, kogumine, väljanõudmine, registreerimine, töötlemine, analüüsimine ja edastamine; 2 2) strateegiline analüüs, mis käsitleb rahapesu ja terrorismi rahastamise riske, ohte, suundumusi, mustreid ning toimimisviise; 3 3) seaduses sätestatud alustel ja ulatuses riikliku sunni rakendamine; 4 4) järelevalve tegemine kohustatud isikute tegevuse üle rahapesu ja terrorismi rahastamise tõkestamise seaduse täitmisel, kui õigusaktiga ei ole sätestatud teisiti; 5 5) rahapesu ja terrorismi rahastamise tõkestamise ja tuvastamise alane avalikkuse teavitamine ning koondülevaate koostamine ja avaldamine vähemalt üks kord aastas; 6 6) koostöö kohustatud isikute, pädevate järelevalveasutuste ja uurimisasutustega rahapesu ja terrorismi rahastamise tõkestamisel; 7 7) kohustatud isiku töötajate, uurijate, prokuröride ja kohtunike koolitamine rahapesu ja terrorismi rahastamise tõkestamisega seonduvates küsimustes; 8 8) rahvusvahelise sanktsiooni seadusest tulenevate ülesannete täitmine; 9 9) rahapesu ja terrorismi rahastamise tõkestamise seaduses ja rahvusvahelise sanktsiooni seaduses sätestatud väärtegude menetlemine; 10 10) tegevuslubade taotluste lahendamine, majandustegevuse peatamine või keelamine või tegevusloa peatamine või kehtetuks tunnistamine majandustegevuse seadustiku üldosa seaduses sätestatud korras, arvestades rahapesu ja terrorismi rahastamise tõkestamise seaduse erisusi; 11 11) koostöö teiste ametiasutuste, välisriikide asjakohaste ametiasutuste ja rahvusvaheliste organisatsioonidega, sh välissuhtlemise ja teabevahetuse korraldamine; 12 12) muude Rahapesu Andmebüroole õigusaktiga pandud ülesannete täitmine. Rahapesu Andmebüroo ülesanded on: rahapesu ja terrorismi rahastamise tõkestamine, sellele viitava teabe vastuvõtmine, kogumine, väljanõudmine, registreerimine, töötlemine, analüüsimine ja edastamine; strateegiline analüüs, mis käsitleb rahapesu ja terrorismi rahastamise riske, ohte, suundumusi, mustreid ning toimimisviise; seaduses sätestatud alustel ja ulatuses riikliku sunni rakendamine; järelevalve tegemine kohustatud isikute tegevuse üle rahapesu ja terrorismi rahastamise tõkestamise seaduse täitmisel, kui õigusaktiga ei ole sätestatud teisiti; rahapesu ja terrorismi rahastamise tõkestamise ja tuvastamise alane avalikkuse teavitamine ning koondülevaate koostamine ja avaldamine vähemalt üks kord aastas; koostöö kohustatud isikute, pädevate järelevalveasutuste ja uurimisasutustega rahapesu ja terrorismi rahastamise tõkestamisel; kohustatud isiku töötajate, uurijate, prokuröride ja kohtunike koolitamine rahapesu ja terrorismi rahastamise tõkestamisega seonduvates küsimustes; rahvusvahelise sanktsiooni seadusest tulenevate ülesannete täitmine; rahapesu ja terrorismi rahastamise tõkestamise seaduses ja rahvusvahelise sanktsiooni seaduses sätestatud väärtegude menetlemine; tegevuslubade taotluste lahendamine, majandustegevuse peatamine või keelamine või tegevusloa peatamine või kehtetuks tunnistamine majandustegevuse seadustiku üldosa seaduses sätestatud korras, arvestades rahapesu ja terrorismi rahastamise tõkestamise seaduse erisusi; koostöö teiste ametiasutuste, välisriikide asjakohaste ametiasutuste ja rahvusvaheliste organisatsioonidega, sh välissuhtlemise ja teabevahetuse korraldamine; muude Rahapesu Andmebüroole õigusaktiga pandud ülesannete täitmine.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_7 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_8_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahapesu Andmebüroo teenistuskohtade koosseisu kinnitab rahandusminister või tema volitusel Rahapesu Andmebüroo juht (edaspidi juht). Rahapesu Andmebüroo teenistuskohtade koosseisu kinnitab rahandusminister või tema volitusel Rahapesu Andmebüroo juht (edaspidi juht).",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_8 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
      "estleg:sourceAct": "Rahapesu Andmebüroo põhimäärus",
      "estleg:provisionRef": "Reg_1050489 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050489_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050489_Par_9_v1050489",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050489_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rahapesu Andmebüroo struktuuriüksused on osakonnad. Rahapesu Andmebüroo struktuuriüksused on osakonnad. 2 (2) Osakonna koosseisu võivad kuuluda talitused. Osakonna koosseisu võivad kuuluda talitused. 3 (3) Rahapesu Andmebüroo struktuuriüksuste ülesanded ja pädevus täpsustatakse juhi poolt kinnitatavates struktuuriüksuste põhimäärustes. Rahapesu Andmebüroo struktuuriüksuste ülesanded ja pädevus täpsustatakse juhi poolt kinnitatavates struktuuriüksuste põhimäärustes. 4 (4) Rahapesu Andmebüroo struktuuri võivad kuuluda juhile või asejuhile alluvad väljaspool struktuuriüksusi asuvate teenistujate ameti- või töökohad. RT I 2022-07-08 1 108072022001 2022-07-11 Rahapesu Andmebüroo struktuuri võivad kuuluda juhile või asejuhile alluvad väljaspool struktuuriüksusi asuvate teenistujate ameti- või töökohad. 5 (5) Väljaspool struktuuriüksusi asuvate teenistujate tööülesanded, õigused ja vastutus määratletakse vastavalt juhi kinnitatud ametijuhendiga või töölepingus. Väljaspool struktuuriüksusi asuvate teenistujate tööülesanded, õigused ja vastutus määratletakse vastavalt juhi kinnitatud ametijuhendiga või töölepingus.",
      "rdfs:label": {
        "@value": "Reg_1050489_Par_9 (redaktsioon 1050489)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050489",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050489",
