        "@language": "et"
      },
      "dc:source": "Topograafilistele kaartidele kantavate andmete koosseis, topograafiliste kaartide nomenklatuur, kasutatavad leppemärgid ja kartograafiliste tööde teostamise korraldus"
    },
    {
      "@id": "estleg:Reg_1018970_Par_1_v1018970",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1018970_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse ruumiandmete seaduse § 70 lõigetes 1 ja 2 nimetatud topograafilistele kaartidele kantavad andmed, topograafiliste kaartide nomenklatuur, kasutatavad leppemärgid ja kartograafiliste tööde tegemise kord. Määrusega kehtestatakse ruumiandmete seaduse § 70 lõigetes 1 ja 2 nimetatud topograafilistele kaartidele kantavad andmed, topograafiliste kaartide nomenklatuur, kasutatavad leppemärgid ja kartograafiliste tööde tegemise kord.",
      "rdfs:label": {
        "@value": "Reg_1018970_Par_1 (redaktsioon 1018970)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1018970",
