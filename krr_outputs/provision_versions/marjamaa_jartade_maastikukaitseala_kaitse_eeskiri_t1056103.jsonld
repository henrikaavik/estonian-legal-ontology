    {
      "@id": "estleg:Reg_1056103_Par_2_v1056103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056103_Par_2"
