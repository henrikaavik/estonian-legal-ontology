      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1056103_Par_3 (redaktsioon 1056103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056103",
