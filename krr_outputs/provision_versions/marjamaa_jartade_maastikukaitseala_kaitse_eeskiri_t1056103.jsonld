      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 31. augusti 2022. a käskkirjaga nr 1-2/22/298 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 31. augusti 2022. a käskkirjaga nr 1-2/22/298 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1056103_Par_20 (redaktsioon 1056103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056103",
      "estleg:sourceAct": "Märjamaa järtade maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056103 § 20",
      "estleg:partOfAct": {
