      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056103_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-12",
