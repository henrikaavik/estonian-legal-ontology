      }
    },
    {
      "@id": "estleg:Reg_1056103_Par_11_v1056103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056103_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on poollooduslike koosluste aladel nende ilme ja liigikoosseisu tagamiseks vajalik niitmine, loomade karjatamine ning puu- ja põõsarinde kujundamine ja harvendamine. Sihtkaitsevööndis on poollooduslike koosluste aladel nende ilme ja liigikoosseisu tagamiseks vajalik niitmine, loomade karjatamine ning puu- ja põõsarinde kujundamine ja harvendamine.",
      "rdfs:label": {
        "@value": "Reg_1056103_Par_11 (redaktsioon 1056103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056103",
      "estleg:sourceAct": "Märjamaa järtade maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056103 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056103_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056103_Par_12_v1056103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056103_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatise püstitamine kaitseala tarbeks ja Tallinna–Pärnu–Ikla maantee ehitamine. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatise püstitamine kaitseala tarbeks ja Tallinna–Pärnu–Ikla maantee ehitamine.",
      "rdfs:label": {
        "@value": "Reg_1056103_Par_12 (redaktsioon 1056103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056103",
      "estleg:sourceAct": "Märjamaa järtade maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056103 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056103_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056103_Par_13_v1056103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056103_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Märjamaa järtade piiranguvöönd. Kaitsealal on Märjamaa järtade piiranguvöönd.",
      "rdfs:label": {
