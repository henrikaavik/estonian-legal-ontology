        "@id": "estleg:Reg_1056103_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056103_Par_14_v1056103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056103_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on karstiala, maastikuilme, poollooduslike koosluste ning elustiku mitmekesisuse kaitse. Piiranguvööndi kaitse-eesmärk on karstiala, maastikuilme, poollooduslike koosluste ning elustiku mitmekesisuse kaitse.",
      "rdfs:label": {
        "@value": "Reg_1056103_Par_14 (redaktsioon 1056103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056103",
