      }
    },
    {
      "@id": "estleg:Reg_303660_Par_5_v303660",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303660_Par_5"
