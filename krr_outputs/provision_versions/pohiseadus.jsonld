  },
  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_pohiseadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti Vabariigi põhiseadus (26 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti Vabariigi põhiseadus"
    },
    {
      "@id": "estleg:PS_Par_102_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadusi võetakse vastu kooskõlas põhiseadusega.",
      "rdfs:label": {
        "@value": "PS_Par_102 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 102",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_11_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigusi ja vabadusi tohib piirata ainult kooskõlas põhiseadusega. Need piirangud peavad olema demokraatlikus ühiskonnas vajalikud ega tohi moonutada piiratavate õiguste ja vabaduste olemust.",
      "rdfs:label": {
        "@value": "PS_Par_11 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_12_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõik on seaduse ees võrdsed. Kedagi ei tohi diskrimineerida rahvuse, rassi, nahavärvuse, soo, keele, päritolu, usutunnistuse, poliitiliste või muude veendumuste, samuti varalise ja sotsiaalse seisundi või muude asjaolude tõttu. Rahvusliku, rassilise, usulise või poliitilise vihkamise, vägivalla ja diskrimineerimise õhutamine on seadusega keelatud ja karistatav. Samuti on seadusega keelatud ja karistatav õhutada vihkamist, vägivalda ja diskrimineerimist ühiskonnakihtide vahel.",
      "rdfs:label": {
        "@value": "PS_Par_12 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_129_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_129"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti põhiseaduslikku korda ähvardava ohu puhul võib Riigikogu Vabariigi Presidendi või Vabariigi Valitsuse ettepanekul oma koosseisu häälteenamusega välja kuulutada erakorralise seisukorra kogu riigis, kuid kõige kauem kolmeks kuuks. Erakorralise seisukorra korralduse sätestab seadus.",
      "rdfs:label": {
        "@value": "PS_Par_129 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 129",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_14_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguste ja vabaduste tagamine on seadusandliku, täidesaatva ja kohtuvõimu ning kohalike omavalitsuste kohustus.",
      "rdfs:label": {
        "@value": "PS_Par_14 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_146_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigust mõistab ainult kohus. Kohus on oma tegevuses sõltumatu ja mõistab õigust kooskõlas põhiseaduse ja seadustega.",
      "rdfs:label": {
        "@value": "PS_Par_146 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 146",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_15_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus pöörduda oma õiguste ja vabaduste rikkumise korral kohtusse. Igaüks võib oma kohtuasja läbivaatamisel nõuda mis tahes asjassepuutuva seaduse, muu õigusakti või toimingu põhiseadusevastaseks tunnistamist. Kohus järgib põhiseadust ja tunnistab põhiseadusevastaseks mis tahes seaduse, muu õigusakti või toimingu, mis rikub põhiseaduses sätestatud õigusi ja vabadusi või on muul viisil põhiseadusega vastuolus.",
      "rdfs:label": {
        "@value": "PS_Par_15 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_161_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_161"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigus algatada põhiseaduse muutmist on vähemalt viiendikul Riigikogu koosseisust ja Vabariigi Presidendil. Põhiseaduse muutmist ei saa algatada ega põhiseadust muuta erakorralise seisukorra ega sõjaseisukorra ajal.",
      "rdfs:label": {
        "@value": "PS_Par_161 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 161",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_162_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_162"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse I peatükki \"Üldsätted\" ja XV peatükki \"Põhiseaduse muutmine\" saab muuta ainult rahvahääletusega.",
      "rdfs:label": {
        "@value": "PS_Par_162 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 162",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_163_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_163"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseadust saab muuta seadusega, mis on vastu võetud: rahvahääletusel; Riigikogu kahe järjestikuse koosseisu poolt; Riigikogu poolt kiireloomulisena. Põhiseaduse muutmise seaduse eelnõu arutatakse Riigikogus kolmel lugemisel, kusjuures esimese ja teise lugemise vahet on vähemalt kolm kuud ning teise ja kolmanda lugemise vahet vähemalt üks kuu. Põhiseaduse muutmise viis otsustatakse kolmandal lugemisel.",
      "rdfs:label": {
        "@value": "PS_Par_163 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 163",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_164_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_164"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmise seaduse eelnõu rahvahääletusele panekuks on nõutav Riigikogu koosseisu kolmeviiendikuline häälteenamus. Rahvahääletus toimub kõige varem kolme kuu pärast, arvates sellekohase otsuse vastuvõtmisest Riigikogus.",
      "rdfs:label": {
        "@value": "PS_Par_164 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 164",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_165_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_165"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmiseks Riigikogu kahe järjestikuse koosseisu poolt peab põhiseaduse muutmise seaduse eelnõu saama Riigikogu koosseisu enamuse toetuse. Kui Riigikogu järgmine koosseis võtab esimesel lugemisel oma koosseisu kolmeviiendikulise häälteenamusega muutmatult vastu põhiseaduse muutmise seaduse eelnõu, mis sai eelmise koosseisu enamuse toetuse, siis on põhiseaduse muutmise seadus vastu võetud.",
      "rdfs:label": {
        "@value": "PS_Par_165 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 165",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_166_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_166"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Otsus põhiseaduse muutmise seaduse eelnõu käsitlemiseks kiireloomulisena võetakse vastu Riigikogu neljaviiendikulise häälteenamusega. Põhiseaduse muutmise seadus võetakse sel juhul vastu Riigikogu koosseisu kahekolmandikulise häälteenamusega.",
      "rdfs:label": {
        "@value": "PS_Par_166 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 166",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_167_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_167"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmise seaduse kuulutab välja Vabariigi President ja see jõustub seaduses eneses määratud tähtajal, kuid mitte varem kui kolm kuud pärast väljakuulutamist.",
      "rdfs:label": {
        "@value": "PS_Par_167 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 167",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_168_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmist ei saa samas küsimuses algatada ühe aasta jooksul, arvates vastava eelnõu tagasilükkamisest rahvahääletusel või Riigikogus. Õiend 25.06.2007 17:40 Käesolev tekst vastab 28. mail 1992. aastal rahvahääletusele pandud ja ajalehes «Rahva Hääl» avaldatud Eesti Vabariigi põhiseaduse eelnõu tekstile. Vastavalt riigisekretäri 19. juuni 2007. a resolutsioonile nr 07-02990 on parandatud vead seni elektroonilises Riigi Teatajas avaldatud Eesti Vabariigi põhiseaduse tekstides. «Rahva Hääles» avaldatud tekstiga võrreldes on parandatud viis ilmset trükiviga. Paragrahvis 53 on välja jäetud sõnade kordus «keskkonnale tekitatud», § 60 lõikes 5 on sõna «Riigikoguvalimise» lahku kirjutatud ning erinevalt «Rahva Hääles» ilmunud tekstist on § 64 lõikes 3 ja §-s 70 Riigikogu kirjutatud suure algustähega ja § 78 punktis 3 põhiseadus kirjutatud väikese algustähega.",
      "rdfs:label": {
        "@value": "PS_Par_168 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:supersededByVersion": {
        "@id": "estleg:PS_Par_168_v633949"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 168",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_168_v633949",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmist ei saa samas küsimuses algatada ühe aasta jooksul, arvates vastava eelnõu tagasilükkamisest rahvahääletusel või Riigikogus. Õiend 25.06.2007 18:00 Käesolev tekst vastab 28. mail 1992. aastal rahvahääletusele pandud ja ajalehes «Rahva Hääl» avaldatud Eesti Vabariigi põhiseaduse eelnõu tekstile. Vastavalt riigisekretäri 19. juuni 2007. a resolutsioonile nr 07-02990 on parandatud vead seni elektroonilises Riigi Teatajas avaldatud Eesti Vabariigi põhiseaduse tekstides. «Rahva Hääles» avaldatud tekstiga võrreldes on parandatud viis ilmset trükiviga. Paragrahvis 53 on välja jäetud sõnade kordus «keskkonnale tekitatud», § 60 lõikes 5 on sõna «Riigikoguvalimise» lahku kirjutatud ning erinevalt «Rahva Hääles» ilmunud tekstist on § 64 lõikes 3 ja §-s 70 Riigikogu kirjutatud suure algustähega ja § 78 punktis 3 põhiseadus kirjutatud väikese algustähega.",
      "rdfs:label": {
        "@value": "PS_Par_168 (redaktsioon 633949)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "633949",
      "estleg:supersededByVersion": {
        "@id": "estleg:PS_Par_168_v12846827"
      },
      "estleg:versionValidTo": {
        "@value": "2007-07-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/633949",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 168",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_168_v12846827",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmist ei saa samas küsimuses algatada ühe aasta jooksul, arvates vastava eelnõu tagasilükkamisest rahvahääletusel või Riigikogus. Õiend Käesolev tekst vastab 28. mail 1992. aastal rahvahääletusele pandud ja ajalehes «Rahva Hääl» avaldatud Eesti Vabariigi põhiseaduse eelnõu tekstile. Vastavalt riigisekretäri 19. juuni 2007. a resolutsioonile nr 07-02990 on parandatud vead seni elektroonilises Riigi Teatajas avaldatud Eesti Vabariigi põhiseaduse tekstides. «Rahva Hääles» avaldatud tekstiga võrreldes on parandatud viis ilmset trükiviga. Paragrahvis 53 on välja jäetud sõnade kordus «keskkonnale tekitatud», § 60 lõikes 5 on sõna «Riigikoguvalimise» lahku kirjutatud ning erinevalt «Rahva Hääles» ilmunud tekstist on § 64 lõikes 3 ja §-s 70 Riigikogu kirjutatud suure algustähega ja § 78 punktis 3 põhiseadus kirjutatud väikese algustähega.",
      "rdfs:label": {
        "@value": "PS_Par_168 (redaktsioon 12846827)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12846827",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12846827",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 168",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_32_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühe omand on puutumatu ja võrdselt kaitstud. Omandit võib omaniku nõusolekuta võõrandada ainult seaduses sätestatud juhtudel ja korras üldistes huvides õiglase ja kohese hüvituse eest. Igaühel, kelle vara on tema nõusolekuta võõrandatud, on õigus pöörduda kohtusse ning vaidlustada vara võõrandamine, hüvitus või selle suurus. Igaühel on õigus enda omandit vabalt vallata, kasutada ja käsutada. Kitsendused sätestab seadus. Omandit ei tohi kasutada üldiste huvide vastaselt. Seadus võib üldistes huvides sätestada vara liigid, mida tohivad Eestis omandada ainult Eesti kodanikud, mõnda liiki juriidilised isikud, kohalikud omavalitsused või Eesti riik. Pärimisõigus on tagatud.",
      "rdfs:label": {
        "@value": "PS_Par_32 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 32",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_45_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus vabalt levitada ideid, arvamusi, veendumusi ja muud informatsiooni sõnas, trükis, pildis või muul viisil. Seda õigust võib seadus piirata avaliku korra, kõlbluse, teiste inimeste õiguste ja vabaduste, tervise, au ning hea nime kaitseks. Seadus võib seda õigust piirata ka riigi ja kohalike omavalitsuste teenistujatel neile ameti tõttu teatavaks saanud riigi- või ärisaladuse või konfidentsiaalsena saadud informatsiooni ning teiste inimeste perekonna- ja eraelu kaitseks, samuti õigusemõistmise huvides. Tsensuuri ei ole.",
      "rdfs:label": {
        "@value": "PS_Par_45 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 45",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_56_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõrgeimat riigivõimu teostab rahvas hääleõiguslike kodanike kaudu: Riigikogu valimisega; rahvahääletusega.",
      "rdfs:label": {
        "@value": "PS_Par_56 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 56",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_59_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadusandlik võim kuulub Riigikogule.",
      "rdfs:label": {
        "@value": "PS_Par_59 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 59",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_65_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu: võtab vastu seadusi ja otsuseid; otsustab rahvahääletuse korraldamise; valib Vabariigi Presidendi vastavalt põhiseaduse §-le 79; ratifitseerib ja denonsseerib välislepinguid vastavalt põhiseaduse §-le 121; annab peaministrikandidaadile volitused Vabariigi Valitsuse moodustamiseks; võtab vastu riigieelarve ja kinnitab selle täitmise aruande; nimetab Vabariigi Presidendi ettepanekul ametisse Riigikohtu esimehe, Eesti Panga nõukogu esimehe, riigikontrolöri, õiguskantsleri ja kaitseväe juhataja või ülemjuhataja; nimetab Riigikohtu esimehe ettepanekul ametisse Riigikohtu liikmed; nimetab Eesti Panga nõukogu liikmed; otsustab Vabariigi Valitsuse ettepanekul riigilaenude tegemise ja riigile muude varaliste kohustuste võtmise; esineb avalduste ja deklaratsioonidega ning pöördumistega Eesti rahva, teiste riikide ning rahvusvaheliste organisatsioonide poole; kehtestab riiklikud autasud, sõjaväelised ja diplomaatilised auastmed; otsustab umbusalduse avaldamise Vabariigi Valitsusele, peaministrile või ministrile; kuulutab riigis välja erakorralise seisukorra vastavalt põhiseaduse §-le 129; kuulutab Vabariigi Presidendi ettepanekul välja sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni; lahendab muid riigielu küsimusi, mis ei ole põhiseadusega antud Vabariigi Presidendi, Vabariigi Valitsuse, teiste riigiorganite või kohalike omavalitsuste otsustada.",
      "rdfs:label": {
        "@value": "PS_Par_65 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:supersededByVersion": {
        "@id": "estleg:PS_Par_65_v127042011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 65",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_65_v127042011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu: võtab vastu seadusi ja otsuseid; otsustab rahvahääletuse korraldamise; valib Vabariigi Presidendi vastavalt põhiseaduse §-le 79; ratifitseerib ja denonsseerib välislepinguid vastavalt põhiseaduse §-le 121; annab peaministrikandidaadile volitused Vabariigi Valitsuse moodustamiseks; võtab vastu riigieelarve ja kinnitab selle täitmise aruande; nimetab Vabariigi Presidendi ettepanekul ametisse Riigikohtu esimehe, Eesti Panga nõukogu esimehe, riigikontrolöri ja õiguskantsleri; nimetab Riigikohtu esimehe ettepanekul ametisse Riigikohtu liikmed; nimetab Eesti Panga nõukogu liikmed; otsustab Vabariigi Valitsuse ettepanekul riigilaenude tegemise ja riigile muude varaliste kohustuste võtmise; esineb avalduste ja deklaratsioonidega ning pöördumistega Eesti rahva, teiste riikide ning rahvusvaheliste organisatsioonide poole; kehtestab riiklikud autasud, sõjaväelised ja diplomaatilised auastmed; otsustab umbusalduse avaldamise Vabariigi Valitsusele, peaministrile või ministrile; kuulutab riigis välja erakorralise seisukorra vastavalt põhiseaduse §-le 129; kuulutab Vabariigi Presidendi ettepanekul välja sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni; lahendab muid riigielu küsimusi, mis ei ole põhiseadusega antud Vabariigi Presidendi, Vabariigi Valitsuse, teiste riigiorganite või kohalike omavalitsuste otsustada.",
      "rdfs:label": {
        "@value": "PS_Par_65 (redaktsioon 127042011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127042011002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127042011002",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 65",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_77_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi President on Eesti riigipea.",
      "rdfs:label": {
        "@value": "PS_Par_77 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 77",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_8_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igal lapsel, kelle vanematest üks on Eesti kodanik, on õigus Eesti kodakondsusele sünnilt. Igaühel, kes on alaealisena kaotanud Eesti kodakondsuse, on õigus selle taastamisele. Kelleltki ei tohi võtta sünniga omandatud Eesti kodakondsust. Kelleltki ei tohi veendumuste pärast võtta Eesti kodakondsust. Eesti kodakondsuse saamise, kaotamise ja taastamise tingimused ning korra sätestab kodakondsuse seadus.",
      "rdfs:label": {
        "@value": "PS_Par_8 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    },
    {
      "@id": "estleg:PS_Par_86_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PS_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täidesaatev riigivõim kuulub Vabariigi Valitsusele.",
      "rdfs:label": {
        "@value": "PS_Par_86 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24304",
      "estleg:sourceAct": "Eesti Vabariigi põhiseadus",
      "estleg:provisionRef": "PS § 86",
      "estleg:partOfAct": {
        "@id": "estleg:PS_Map_2026"
      }
    }
  ]
}
