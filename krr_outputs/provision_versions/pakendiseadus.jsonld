      }
    },
    {
      "@id": "estleg:PakS_Par_29_1_v105052021002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakS_Par_29_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-15",
