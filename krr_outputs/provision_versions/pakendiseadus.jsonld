    {
      "@id": "estleg:PakS_Par_33_v750865",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 27–32 nimetatud väärtegude menetlemisel kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 82, 480; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40) üldosa ja väärteomenetluse seadustiku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590) sätteid. (2) Käesoleva seaduse §-des 27–32 nimetatud väärtegude kohtuväline menetleja on: Keskkonnainspektsioon; valla- ja linnavalitsus. (3) Käesoleva seaduse §-des 27, 28 ja 31 nimetatud väärtegude kohtuväline menetleja on: Tervisekaitseinspektsioon; Tarbijakaitseamet.",
      "rdfs:label": {
        "@value": "PakS_Par_33 (redaktsioon 750865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750865",
      "estleg:supersededByVersion": {
        "@id": "estleg:PakS_Par_33_v12906942"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PakS_Par_33_v12906942",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 27–32 nimetatud väärtegude menetlemisel kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. (2) Käesoleva seaduse §-des 27–32 nimetatud väärtegude kohtuväline menetleja on: Keskkonnainspektsioon; valla- ja linnavalitsus. (3) Käesoleva seaduse §-des 27, 28 ja 31 nimetatud väärtegude kohtuväline menetleja on: Tervisekaitseinspektsioon; Tarbijakaitseamet.",
      "rdfs:label": {
        "@value": "PakS_Par_33 (redaktsioon 12906942)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906942",
