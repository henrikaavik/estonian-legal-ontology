        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 23 lõiget 5 ja § 31 kohaldatakse alates 2005. aasta 1. augustist.",
      "rdfs:label": {
        "@value": "PakS_Par_36_1 (redaktsioon 833958)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "833958",
