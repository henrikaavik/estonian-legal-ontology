        "@language": "et"
      },
      "estleg:versionRedactionId": "105052021002"
    },
    {
      "@id": "estleg:PakS_Par_29_1_v117052014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
