      },
      "estleg:versionValidTo": {
        "@value": "2005-01-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PakS_Par_40_v833958",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
