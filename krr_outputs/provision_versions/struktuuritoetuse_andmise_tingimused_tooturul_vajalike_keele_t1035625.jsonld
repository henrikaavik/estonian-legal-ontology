    },
    {
      "@id": "estleg:Reg_1035625_Par_8_v1035625",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035625_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tegevuste abikõlblikkuse periood on 1. mai 2016. a kuni 31. detsember 2022. a. RT I 2020-03-06 10 106032020010 2020-03-09 Tegevuste abikõlblikkuse periood on 1. mai 2016. a kuni 31. detsember 2022. a. 2 (2) Käesoleva määruse § 6 lõike 2 punktis 1 nimetatud tegevust sisaldava projekti abikõlblikkuse periood ei tohi olla pikem kui 60 kuud ning punktides 2 ja 3 nimetatud tegevusi sisaldavate projektide abikõlblikkuse periood ei tohi olla pikem kui 24 kuud. RT I 2020-03-06 10 106032020010 2020-03-09 Käesoleva määruse § 6 lõike 2 punktis 1 nimetatud tegevust sisaldava projekti abikõlblikkuse periood ei tohi olla pikem kui 60 kuud ning punktides 2 ja 3 nimetatud tegevusi sisaldavate projektide abikõlblikkuse periood ei tohi olla pikem kui 24 kuud.",
      "rdfs:label": {
        "@value": "Reg_1035625_Par_8 (redaktsioon 1035625)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035625",
