      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega reguleeritakse „Ühtekuuluvuspoliitika fondide rakenduskava 2014–2020” prioriteetse suuna „Ühiskonna vajadustele vastav haridus ja hea ettevalmistus osalemaks tööturul” meetme 1.5 „Õppe seostamine tööturu vajadustega” tegevuse 1.5.5 „Keeleõppetegevused edukamaks toimetulekuks tööturul” eesmärkide elluviimist. RT I 2020-08-05 1 105082020001 2020-09-01 Määrusega reguleeritakse „Ühtekuuluvuspoliitika fondide rakenduskava 2014–2020” prioriteetse suuna „Ühiskonna vajadustele vastav haridus ja hea ettevalmistus osalemaks tööturul” meetme 1.5 „Õppe seostamine tööturu vajadustega” tegevuse 1.5.5 „Keeleõppetegevused edukamaks toimetulekuks tööturul” eesmärkide elluviimist.",
      "rdfs:label": {
        "@value": "Reg_1035625_Par_1 (redaktsioon 1035625)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035625",
