    },
    {
      "@id": "estleg:Reg_308928_Par_5_v308928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308928_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-05-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rahvakohtuniku tasu väljamaksmise aluseks on istungisekretäri koostatud ja tema poolt allkirjastatud õiend, millele on märgitud § 2 lõike 1 esimeses lauses sätestatud aeg. RT I 2018-05-29 16 129052018016 2018-06-01 Rahvakohtuniku tasu väljamaksmise aluseks on istungisekretäri koostatud ja tema poolt allkirjastatud õiend, millele on märgitud § 2 lõike 1 esimeses lauses sätestatud aeg. 2 (2) Rahvakohtuniku tasu ja §-s 3 ettenähtud hüvitised kannab Riigi Tugiteenuste Keskus rahvakohtuniku pangakontole. RT I 2011-12-15 4 115122011004 2012-01-01 Rahvakohtuniku tasu ja §-s 3 ettenähtud hüvitised kannab Riigi Tugiteenuste Keskus rahvakohtuniku pangakontole.",
      "rdfs:label": {
        "@value": "Reg_308928_Par_5 (redaktsioon 308928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308928",
      "estleg:sourceAct": "Rahvakohtuniku tasu suurus ja maksmise kord",
      "estleg:provisionRef": "Reg_308928 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308928_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308928_Par_6_v308928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308928_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-05-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvakohtunikule tasu ja hüvitiste maksmisel tekkinud vaidlused lahendab kohtudirektor rahvakohtuniku kirjaliku taotluse saamisest kolme tööpäeva jooksul. Rahvakohtunikule tasu ja hüvitiste maksmisel tekkinud vaidlused lahendab kohtudirektor rahvakohtuniku kirjaliku taotluse saamisest kolme tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "Reg_308928_Par_6 (redaktsioon 308928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308928",
      "estleg:sourceAct": "Rahvakohtuniku tasu suurus ja maksmise kord",
      "estleg:provisionRef": "Reg_308928 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308928_Map_2026"
      }
    },
