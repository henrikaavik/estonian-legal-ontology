  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_vedelkutuse_erimargistamise_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Vedelkütuse erimärgistamise seadus (119 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vedelkütuse erimärgistamise seadus"
    },
    {
      "@id": "estleg:VEDELK_Par_1_v22383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Erimärgistamisele kuulub Eestisse imporditav ja Eestis toodetav kergekütteõli ning see osadiislikütusest, mis on ette nähtud kasutamiseks traktorites ja põllutöömasinates ning kutselisel kalapüügil vastavalt käesoleva paragrahvi lõikes 3 sätestatule (edaspidi eriotstarbeline diislikütus). (2) Käesoleva paragrahvi lõikes 1 nimetatud kerget kütteõli on keelatud kasutada mootorikütusena sõiduautos ning reisijate- või kaubaveoks ettenähtud sõidukis (edaspidi sõiduk) liiklusseaduse (RT 1992, 12, 193; RT I 1995, 2/3, 3; 1996, 16, 268; 1997, 86, 1459; 1999, 16, 272) mõistes, välja arvatud traktoris. (3) Käesoleva paragrahvi lõikes 1 nimetatud eriotstarbelist diislikütust on lubatud kasutada ainult traktorites ja põllutöömasinates ning äriseadustikus (RT I 1995, 26 - 28, 355; 1998, 91 - 93, 1500; 1999, 10, 155; 23, 355; 24, 360; 57, 596; 102, 907; 2000, 29, 172) sätestatud korras registreeritud ettevõtjal kutselisel kalapüügil kalapüügiseaduse (RT I 1995, 80, 1384; 1996, 27, 567; 1998, 108/109, 1784; 1999, 10, 152; 54, 583; 95, 843; 2000, 13, 92) tähenduses. Kõigil muudel juhtudel on eriotstarbelise diislikütuse kasutamine keelatud.",
      "rdfs:label": {
        "@value": "VEDELK_Par_1 (redaktsioon 22383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22383",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEDELK_Par_1_v245043"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEDELK_Par_1_v245043",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erimärgistamisele kuulub Eestis toodetav ja tolliseadustiku (RT I 2001, 88, 531; 2002, 61, 375; 63, 387; 92, 528) mõistes vabasse ringlusse lubatav (edaspidi import) kerge kütteõli ning see osa diislikütusest, mis on ette nähtud kasutamiseks vastavalt käesoleva seaduse § 11 lõikes 2 sätestatule",
      "rdfs:label": {
        "@value": "VEDELK_Par_1 (redaktsioon 245043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "245043",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEDELK_Par_1_v693612"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEDELK_Par_1_v693612",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erimärgistamisele kuulub Eestis toodetav ja tolliseadustiku (RT I 2001, 88, 531; 2002, 61, 375; 63, 387; 92, 528) mõistes vabasse ringlusse lubatav (edaspidi import ) kerge kütteõli ning see osa diislikütusest, mis on ette nähtud kasutamiseks vastavalt käesoleva seaduse § 1 1 lõikes 2 sätestatule.",
      "rdfs:label": {
        "@value": "VEDELK_Par_1 (redaktsioon 693612)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693612",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEDELK_Par_1_v695526"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEDELK_Par_1_v695526",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erimärgistamisele kuulub Eestis toodetav, ühenduse tolliseadustiku (Euroopa Ühenduste Nõukogu määrus nr 2913/92/EMÜ) mõistes vabasse ringlusse lubatav (edaspidi import) ja Euroopa Liidu liikmesriigist (edaspidi liikmesriik) Eestisse sisse veetav kerge kütteõli ning see osa diislikütusest, mis on ette nähtud kasutamiseks vastavalt käesoleva seaduse § 11 lõikes 2 sätestatule. – jõustus Eesti ühinemisel Euroopa Liiduga eraldi seadusega.",
      "rdfs:label": {
        "@value": "VEDELK_Par_1 (redaktsioon 695526)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "695526",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEDELK_Par_1_v1027793"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEDELK_Par_1_v1027793",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erimärgistamisele kuulub Eestis toodetav, ühenduse tolliseadustiku (Euroopa Ühenduste Nõukogu määrus nr 2913/92/EMÜ) mõistes vabasse ringlusse lubatav (edaspidi import) ja Euroopa Liidu liikmesriigist (edaspidi liikmesriik) Eestisse sisse veetav kerge kütteõli ning see osa diislikütusest, mis on ette nähtud kasutamiseks vastavalt käesoleva seaduse § 11 lõikes 2 sätestatule.",
      "rdfs:label": {
        "@value": "VEDELK_Par_1 (redaktsioon 1027793)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027793",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEDELK_Par_1_v112072014018"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEDELK_Par_1_v112072014018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erimärgistamisele kuulub Eestis toodetav, ühenduse tolliseadustiku (Euroopa Ühenduste Nõukogu määrus nr 2913/92/EMÜ) mõistes vabasse ringlusse lubatav (edaspidi import) ja Euroopa Liidu liikmesriigist (edaspidi liikmesriik) Eestisse sisse veetav osa diislikütusest, mis on ette nähtud kasutamiseks vastavalt käesoleva seaduse § 11 lõikes 1 sätestatule.",
      "rdfs:label": {
        "@value": "VEDELK_Par_1 (redaktsioon 112072014018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014018",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEDELK_Par_1_v116062017034"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEDELK_Par_1_v116062017034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erimärgistamisele kuulub Eestis toodetav, Euroopa Parlamendi ja nõukogu määruse (EL) nr 952/2013, millega kehtestatakse liidu tolliseadustik (ELT L 269, 10.10.2013, lk 1–101), tähenduses vabasse ringlusse lubatav (edaspidi import) ja Euroopa Liidu liikmesriigist (edaspidi liikmesriik) Eestisse sisse veetav osa diislikütusest, mis on ette nähtud kasutamiseks vastavalt käesoleva seaduse § 11 lõikes 1 sätestatule.",
      "rdfs:label": {
        "@value": "VEDELK_Par_1 (redaktsioon 116062017034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017034"
    },
    {
      "@id": "estleg:VEDELK_Par_1_1_v245043",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kerget kütteõli on keelatud kasutada autos liiklusseaduse (RT I 2001, 3, 6; 2002, 92, 531; 90, 521) mõistes. Eesti Euroopa Liiduga liitumisest alates on kerget kütteõli lubatud kasutada ainult kütmiseks ning soojuse ja elektrienergia tootmiseks. (2) Erimärgistatud diislikütust (edaspidi eriotstarbeline diislikütus) on lubatud kasutada: kutselisel kalapüügil kalapüügiseaduse (RT I 1995, 80, 1384; 1996, 27, 567; 1998, 108/109, 1784; 1999, 10, 152; 54, 583; 95, 843; 2000, 13, 92; 54, 348; 81, 514; 2001, 18, 88; 2002, 41, 250; 61, 375; 63, 387) mõistes; traktoris ja liikurmasinas selle kasutamisel põllumajanduses, samuti põllumajanduses kasutatava traktori ja liikurmasina kasutamisel metsatöödel; kaevandus-, metsandus- või ehitustöödel kasutatavas traktoris, liikurmasinas või muus mootorsõidukis, mida ei ole õigusaktiga lubatud kasutada liiklemiseks avalikult kasutataval teel; muu seadme või masina mootoris, kui see ei ole mootorsõiduki osa; kütmiseks ning soojuse ja elektrienergia tootmiseks.",
      "rdfs:label": {
        "@value": "VEDELK_Par_1_1 (redaktsioon 245043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "245043",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEDELK_Par_1_1_v693612"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEDELK_Par_1_1_v693612",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kerget kütteõli on keelatud kasutada autos liiklusseaduse (RT I 2001, 3, 6; 2002, 92, 531; 90, 521) mõistes. Eesti Euroopa Liiduga liitumisest alates on kerget kütteõli lubatud kasutada ainult kütmiseks ning soojuse ja elektrienergia tootmiseks. (2) Erimärgistatud diislikütust (edaspidi eriotstarbeline diislikütus ) on lubatud kasutada: kutselisel kalapüügil kalapüügiseaduse (RT I 1995, 80, 1384; 1996, 27, 567; 1998, 108/109, 1784; 1999, 10, 152; 54, 583; 95, 843; 2000, 13, 92; 54, 348; 81, 514; 2001, 18, 88; 2002, 41, 250; 61, 375; 63, 387) mõistes; traktoris ja liikurmasinas selle kasutamisel põllumajanduses, samuti põllumajanduses kasutatava traktori ja liikurmasina kasutamisel metsatöödel; kaevandus-, metsandus- või ehitustöödel kasutatavas traktoris, liikurmasinas või muus mootorsõidukis, mida ei ole õigusaktiga lubatud kasutada liiklemiseks avalikult kasutataval teel; muu seadme või masina mootoris, kui see ei ole mootorsõiduki osa; kütmiseks ning soojuse ja elektrienergia tootmiseks.",
      "rdfs:label": {
        "@value": "VEDELK_Par_1_1 (redaktsioon 693612)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693612",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEDELK_Par_1_1_v695526"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEDELK_Par_1_1_v695526",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kerget kütteõli on lubatud kasutada: reisijate ja kaupade raudteeveol; laevaliikluses, sealhulgas kutselisel kalapüügil, välja arvatud lõbusõidul mitteärilisel eesmärgil; paikses mootoris; kütmiseks ning soojuse ja elektrienergia tootmiseks. (2) Erimärgistatud diislikütust (edaspidi eriotstarbeline diislikütus) on lubatud kasutada: reisijate ja kaupade raudteeveol; laevaliikluses, sealhulgas kutselisel kalapüügil, välja arvatud lõbusõidul mitteärilisel eesmärgil; põllumajanduses kasutatavas masinas, traktoris ja liikurmasinas, samuti põllumajanduses kasutatava traktori ja liikurmasina kasutamisel metsatöödel; masinas ja mootorsõidukis, mida ei ole õigusaktiga lubatud kasutada liiklemiseks avalikult kasutataval teel ja mida kasutatakse kaevandus-, metsandus- või ehitustöödel; paikses mootoris; kütmiseks ning soojuse ja elektrienergia tootmiseks. (3) Käesoleva seaduse tähenduses ei käsitata masinana mootorsõidukit liiklusseaduse (RT I 2001, 3, 6; 2002, 92, 531; 90, 521; 105, 613; 110, 654 ja 655; 2003, 26, 156; 32, õiend) mõistes ning vee- ja raudteesõidukit. – jõustus Eesti ühinemisel Euroopa Liiduga eraldi seadusega",
      "rdfs:label": {
        "@value": "VEDELK_Par_1_1 (redaktsioon 695526)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "695526",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEDELK_Par_1_1_v1027793"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEDELK_Par_1_1_v1027793",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEDELK_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kerget kütteõli on lubatud kasutada: reisijate ja kaupade raudteeveol; laevaliikluses, sealhulgas kutselisel kalapüügil, välja arvatud lõbusõidul mitteärilisel eesmärgil; paikses mootoris; kütmiseks ning soojuse ja elektrienergia tootmiseks. (2) Erimärgistatud diislikütust (edaspidi eriotstarbeline diislikütus) on lubatud kasutada: reisijate ja kaupade raudteeveol; laevaliikluses, sealhulgas kutselisel kalapüügil, välja arvatud lõbusõidul mitteärilisel eesmärgil; põllumajanduses kasutatavas masinas, traktoris ja liikurmasinas, samuti põllumajanduses kasutatava traktori ja liikurmasina kasutamisel metsatöödel; masinas ja mootorsõidukis, mida ei ole õigusaktiga lubatud kasutada liiklemiseks avalikult kasutataval teel ja mida kasutatakse kaevandus-, metsandus- või ehitustöödel; paikses mootoris; kütmiseks ning soojuse ja elektrienergia tootmiseks. (3) Käesoleva seaduse tähenduses ei käsitata masinana mootorsõidukit liiklusseaduse (RT I 2001, 3, 6; 2002, 92, 531; 90, 521; 105, 613; 110, 654 ja 655; 2003, 26, 156; 32, õiend) mõistes ning vee- ja raudteesõidukit.",
      "rdfs:label": {
        "@value": "VEDELK_Par_1_1 (redaktsioon 1027793)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027793",
