        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet käesoleva seaduse täitmise üle teostab Maksu- ja Tolliamet. (2) Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "VEDELK_Par_4 (redaktsioon 115032014083)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014083",
      "estleg:supersededByVersion": {
