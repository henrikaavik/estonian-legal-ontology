      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded vedelkütusega varustamisel (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded vedelkütusega varustamisel"
    },
    {
      "@id": "estleg:Reg_1043696_Par_1_v1043696",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043696_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määruses kehtestatakse nõuded hädaolukorra seaduse § 36 lõike 11 punktis 3 sätestatud elutähtsale teenuse osutamisele ning selle teenuse kirjeldus. RT I 2023-07-05 7 105072023007 2023-07-08 Määruses kehtestatakse nõuded hädaolukorra seaduse § 36 lõike 11 punktis 3 sätestatud elutähtsale teenuse osutamisele ning selle teenuse kirjeldus. 2 (2) Määruses sätestatakse elutähtsa teenuse taseme, valmisoleku ja teenuse katkestuse ennetamise nõuded. Samuti sätestatakse tingimused, mille puhul on tegemist elutähtsa teenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga, ja nõuded elutähtsa teenuse põhitegevust toetavate teenuste sisseostmiseks teiselt ettevõttelt ning hädaolukorrast või selle ohust teavitamise korraldus. Määruses sätestatakse elutähtsa teenuse taseme, valmisoleku ja teenuse katkestuse ennetamise nõuded. Samuti sätestatakse tingimused, mille puhul on tegemist elutähtsa teenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga, ja nõuded elutähtsa teenuse põhitegevust toetavate teenuste sisseostmiseks teiselt ettevõttelt ning hädaolukorrast või selle ohust teavitamise korraldus.",
      "rdfs:label": {
        "@value": "Reg_1043696_Par_1 (redaktsioon 1043696)",
        "@language": "et"
      },
