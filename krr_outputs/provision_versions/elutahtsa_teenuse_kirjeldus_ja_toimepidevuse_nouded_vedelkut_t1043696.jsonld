        "@type": "xsd:date"
      },
      "estleg:versionText": "Vedelkütuse müüja lähtub elutähtsa teenuse taastamisel toimepidevuse plaanis esitatud teenuse taastamise prioriteetidest, arvestades võimalusel järgmisega: 1 1) esimesena taastatakse teenus objektide valdajatele, kelle teenuse katkestusega kaasneb vahetu oht inimelule; 2 2) teisena taastatakse teenus objektide valdajatele, kes tagavad elutähtsa teenuse või riigikaitseobjektide toimepidevuse. Vedelkütuse müüja lähtub elutähtsa teenuse taastamisel toimepidevuse plaanis esitatud teenuse taastamise prioriteetidest, arvestades võimalusel järgmisega: esimesena taastatakse teenus objektide valdajatele, kelle teenuse katkestusega kaasneb vahetu oht inimelule; teisena taastatakse teenus objektide valdajatele, kes tagavad elutähtsa teenuse või riigikaitseobjektide toimepidevuse.",
      "rdfs:label": {
        "@value": "Reg_1043696_Par_7 (redaktsioon 1043696)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043696",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043696",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded vedelkütusega varustamisel",
      "estleg:provisionRef": "Reg_1043696 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043696_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043696_Par_8_v1043696",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043696_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vedelkütuse müüja lähtub elutähtsa teenuse osutamist toetavate teenuste ostmisel lepingupartneri võimest osutada teenust hädaolukorras ja teise elutähtsa teenuse katkestuse korral. Vedelkütuse müüja lähtub elutähtsa teenuse osutamist toetavate teenuste ostmisel lepingupartneri võimest osutada teenust hädaolukorras ja teise elutähtsa teenuse katkestuse korral.",
      "rdfs:label": {
        "@value": "Reg_1043696_Par_8 (redaktsioon 1043696)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043696",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043696",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded vedelkütusega varustamisel",
      "estleg:provisionRef": "Reg_1043696 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043696_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043696_Par_9_v1043696",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043696_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elutähtsa teenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga, mille lahendamist korraldab Kliimaministeerium, on tegemist juhul, kui esineb vähemalt üks järgmistest tingimustest: RT I 2023-07-05 7 105072023007 2023-07-08 1 1) elutähtsa teenuse osutaja ei suuda tagada § 4 lõikes 2 sätestatud tanklates katkematut teenust ja selle tulemusena on teenuse katkemise piirkonnas ohustatud teiste elutähtsate teenuste jätkamine; 2 2) katkeb vedelkütusega varustamise tarneahel. Elutähtsa teenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga, mille lahendamist korraldab Kliimaministeerium, on tegemist juhul, kui esineb vähemalt üks järgmistest tingimustest: elutähtsa teenuse osutaja ei suuda tagada § 4 lõikes 2 sätestatud tanklates katkematut teenust ja selle tulemusena on teenuse katkemise piirkonnas ohustatud teiste elutähtsate teenuste jätkamine; katkeb vedelkütusega varustamise tarneahel.",
      "rdfs:label": {
        "@value": "Reg_1043696_Par_9 (redaktsioon 1043696)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043696",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043696",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded vedelkütusega varustamisel",
      "estleg:provisionRef": "Reg_1043696 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043696_Map_2026"
      }
    },
