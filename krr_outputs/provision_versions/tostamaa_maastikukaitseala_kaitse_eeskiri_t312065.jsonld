      }
    },
    {
      "@id": "estleg:Reg_312065_Par_3_v312065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312065_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. RT I 2009 7 48 13125268 2009-02-01+02:00 Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_312065_Par_3 (redaktsioon 312065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312065",
      "estleg:sourceAct": "Tõstamaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312065 § 3",
      "estleg:partOfAct": {
