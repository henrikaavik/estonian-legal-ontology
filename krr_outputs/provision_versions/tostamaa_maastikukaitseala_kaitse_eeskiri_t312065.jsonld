      }
    },
    {
      "@id": "estleg:Reg_312065_Par_9_v312065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312065_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 2 2) poollooduslike koosluste hooldamine nende ilme ja liigikoosseisu säilimise tagamiseks; 3 3) pilliroo ja adru varumine. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; poollooduslike koosluste hooldamine nende ilme ja liigikoosseisu säilimise tagamiseks; pilliroo ja adru varumine.",
      "rdfs:label": {
        "@value": "Reg_312065_Par_9 (redaktsioon 312065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312065",
      "estleg:sourceAct": "Tõstamaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312065 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312065_Map"
      }
    },
