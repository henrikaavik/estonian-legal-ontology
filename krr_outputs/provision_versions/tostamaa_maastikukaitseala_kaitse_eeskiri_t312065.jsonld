      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312065",
      "estleg:sourceAct": "Tõstamaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312065 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312065_Map"
      }
    },
    {
      "@id": "estleg:Reg_312065_Par_2_v312065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312065_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Pärnu maakonnas Tõstamaa vallas Värati, Tõlli, Peerni, Pootsi ja Kavaru külas. Kaitseala asub Pärnu maakonnas Tõstamaa vallas Värati, Tõlli, Peerni, Pootsi ja Kavaru külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_312065_Par_2 (redaktsioon 312065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312065",
