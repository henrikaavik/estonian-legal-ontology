        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu tagamiseks vajalik heina niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ning harvendamine. Sihtkaitsevööndis poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu tagamiseks vajalik heina niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ning harvendamine.",
      "rdfs:label": {
        "@value": "Reg_312065_Par_11 (redaktsioon 312065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312065",
      "estleg:sourceAct": "Tõstamaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312065 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312065_Map"
      }
    },
    {
      "@id": "estleg:Reg_312065_Par_12_v312065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
