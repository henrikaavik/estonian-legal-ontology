    {
      "@id": "estleg:Reg_1053252_Par_2_v1053252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053252_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eelarveklassifikaator on piiritletud arvestuspõhimõtete ja -objektide kogum, millest lähtutakse eelarvestamisel ja finantsarvestuse pidamisel (edaspidi arvestuse pidamine), kulude jaotamisel teenustele (edaspidi kuluarvestuse pidamine), eelarve limiitide ja kasutamise piirangute seadmisel ja jälgimisel (edaspidi koos nimetatult eelarve piirmäärade seadmine), eelarve kasutamisel ning strateegilises planeerimises. Eelarveklassifikaator on piiritletud arvestuspõhimõtete ja -objektide kogum, millest lähtutakse eelarvestamisel ja finantsarvestuse pidamisel (edaspidi arvestuse pidamine), kulude jaotamisel teenustele (edaspidi kuluarvestuse pidamine), eelarve limiitide ja kasutamise piirangute seadmisel ja jälgimisel (edaspidi koos nimetatult eelarve piirmäärade seadmine), eelarve kasutamisel ning strateegilises planeerimises.",
      "rdfs:label": {
        "@value": "Reg_1053252_Par_2 (redaktsioon 1053252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053252",
