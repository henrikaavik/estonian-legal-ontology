  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_reguleeritud_ametikohad_ja_kutsealad_millel_tootamiseks_voib_t329638_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Reguleeritud ametikohad ja kutsealad, millel töötamiseks võib nõuda sobivustesti sooritamist või kohanemisaja läbimist ning millel ajutiseks töötamiseks võib teha välisriigi kutsekvalifikatsiooni eelnevat kontrolli (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Reguleeritud ametikohad ja kutsealad, millel töötamiseks võib nõuda sobivustesti sooritamist või kohanemisaja läbimist ning millel ajutiseks töötamiseks võib teha välisriigi kutsekvalifikatsiooni eelnevat kontrolli"
    },
    {
      "@id": "estleg:Reg_329638_Par_1_v329638",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_329638_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse reguleeritud ametikohad ja kutsealad: 1 1) millel töötamiseks võib välisriigi kutsekvalifikatsiooni tunnustamiseks pädev asutus (edaspidi pädev asutus) taotlejalt nõuda kas sobivustesti sooritamist või kohanemisaja läbimist, sõltumata taotleja valikust; 2 2) millel esmakordseks ajutiseks töötamiseks võib pädev asutus kontrollida taotleja välisriigi kutsekvalifikatsiooni enne, kui taotleja võib Eestis ajutiselt töötama asuda. Määrusega kehtestatakse reguleeritud ametikohad ja kutsealad: millel töötamiseks võib välisriigi kutsekvalifikatsiooni tunnustamiseks pädev asutus (edaspidi pädev asutus) taotlejalt nõuda kas sobivustesti sooritamist või kohanemisaja läbimist, sõltumata taotleja valikust; millel esmakordseks ajutiseks töötamiseks võib pädev asutus kontrollida taotleja välisriigi kutsekvalifikatsiooni enne, kui taotleja võib Eestis ajutiselt töötama asuda.",
      "rdfs:label": {
        "@value": "Reg_329638_Par_1 (redaktsioon 329638)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "329638",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/329638",
      "estleg:sourceAct": "Reguleeritud ametikohad ja kutsealad, millel töötamiseks võib nõuda sobivustesti sooritamist või kohanemisaja läbimist ning millel ajutiseks töötamiseks võib teha välisriigi kutsekvalifikatsiooni eelnevat kontrolli",
      "estleg:provisionRef": "Reg_329638 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_329638_Map"
      }
    },
    {
      "@id": "estleg:Reg_329638_Par_2_v329638",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_329638_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reguleeritud ametikohad ja kutsealad, millel töötamiseks võib pädev asutus taotlejalt nõuda sobivustesti sooritamist või kohanemisaja läbimist, sõltumata taotleja valikust, on: 1 1) pankrotihaldur „Pankrotiseaduse” tähenduses; 2 2) patendivolinik „Patendivoliniku seaduse” tähenduses; 3 3) vandeadvokaat „Advokatuuriseaduse” tähenduses. Reguleeritud ametikohad ja kutsealad, millel töötamiseks võib pädev asutus taotlejalt nõuda sobivustesti sooritamist või kohanemisaja läbimist, sõltumata taotleja valikust, on: pankrotihaldur „Pankrotiseaduse” tähenduses; patendivolinik „Patendivoliniku seaduse” tähenduses; vandeadvokaat „Advokatuuriseaduse” tähenduses.",
      "rdfs:label": {
        "@value": "Reg_329638_Par_2 (redaktsioon 329638)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "329638",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/329638",
      "estleg:sourceAct": "Reguleeritud ametikohad ja kutsealad, millel töötamiseks võib nõuda sobivustesti sooritamist või kohanemisaja läbimist ning millel ajutiseks töötamiseks võib teha välisriigi kutsekvalifikatsiooni eelnevat kontrolli",
      "estleg:provisionRef": "Reg_329638 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_329638_Map"
      }
    },
    {
      "@id": "estleg:Reg_329638_Par_3_v329638",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_329638_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reguleeritud ametikohad ja kutsealad, millel ajutiseks töötamiseks võib pädev asutus teha välisriigi kutsekvalifikatsiooni eelnevat kontrolli, on: 1 1) arst, hambaarst, õde ja ämmaemand „Tervishoiuteenuste korraldamise seaduse” tähenduses, kui tervishoiutöötaja välisriigi kutsekvalifikatsiooni tõendav dokument ei sisaldu „Tervishoiuteenuste korraldamise seaduse” § 29 lõike 4 alusel kehtestatud loetelus; 2 2) kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 3 3) farmatseut „Ravimiseaduse” tähenduses; 4 4) kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 5 5) lõhkaja, lõhkemeister, lõhkematerjali käitlemise korraldaja, lõhkematerjalilao juhataja, lõhkematerjali väljastaja, pürotehnilise toote käitlemise korraldaja ja pürotehnik „Lõhkematerjaliseaduse” tähenduses; 6 6) kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 7 7) nakkusohtliku materjali, lõhkematerjali, lõhkeseadeldise, samuti piiratud tsiviilkäibega või tsiviilkäibes keelatud relva ja laskemoona käsitlemisega seonduvaid ekspertiise tegev kohtuekspert „Kohtuekspertiisiseaduse” tähenduses; 8 8) proviisor „Ravimiseaduse” tähenduses, kui proviisori välisriigi kutsekvalifikatsiooni tõendav dokument ei sisaldu „Ravimiseaduse” § 58 lõike 2 alusel kehtestatud loetelus; 9 9) kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 10 10) kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 11 11) kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 12 12) turvatöötaja ja valvetöötaja „Turvategevuse seaduse” tähenduses; RT I 2024-06-28 30 128062024030 2024-07-01 13 13) kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 14 14) kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 15 15) vastutav spetsialist maapõueseaduse tähenduses; RT I 2021-12-11 16 111122021016 2021-12-14 16 16) veterinaararst veterinaarseaduse tähenduses, kui veterinaararsti kutsekvalifikatsiooni tõendav dokument ei sisaldu veterinaarseaduse § 14 lõike 4 alusel kehtestatud loetelus; RT I 2021-12-11 16 111122021016 2021-12-14 17 17) seadme vahetu kasutaja, kasutamise järelevaataja, seadmetööd tegev isik ja auditi tegija seadme ohutuse seaduse tähenduses; RT I 2015-04-08 1 108042015001 2015-07-01 18 18) pädev isik ehitusseadustiku tähenduses. RT I 2015-04-08 1 108042015001 2015-07-01 Reguleeritud ametikohad ja kutsealad, millel ajutiseks töötamiseks võib pädev asutus teha välisriigi kutsekvalifikatsiooni eelnevat kontrolli, on: arst, hambaarst, õde ja ämmaemand „Tervishoiuteenuste korraldamise seaduse” tähenduses, kui tervishoiutöötaja välisriigi kutsekvalifikatsiooni tõendav dokument ei sisaldu „Tervishoiuteenuste korraldamise seaduse” § 29 lõike 4 alusel kehtestatud loetelus; kehtetu - farmatseut „Ravimiseaduse” tähenduses; kehtetu - lõhkaja, lõhkemeister, lõhkematerjali käitlemise korraldaja, lõhkematerjalilao juhataja, lõhkematerjali väljastaja, pürotehnilise toote käitlemise korraldaja ja pürotehnik „Lõhkematerjaliseaduse” tähenduses; kehtetu - nakkusohtliku materjali, lõhkematerjali, lõhkeseadeldise, samuti piiratud tsiviilkäibega või tsiviilkäibes keelatud relva ja laskemoona käsitlemisega seonduvaid ekspertiise tegev kohtuekspert „Kohtuekspertiisiseaduse” tähenduses; proviisor „Ravimiseaduse” tähenduses, kui proviisori välisriigi kutsekvalifikatsiooni tõendav dokument ei sisaldu „Ravimiseaduse” § 58 lõike 2 alusel kehtestatud loetelus; kehtetu - kehtetu - kehtetu - turvatöötaja ja valvetöötaja „Turvategevuse seaduse” tähenduses; kehtetu - kehtetu - vastutav spetsialist maapõueseaduse tähenduses; veterinaararst veterinaarseaduse tähenduses, kui veterinaararsti kutsekvalifikatsiooni tõendav dokument ei sisaldu veterinaarseaduse § 14 lõike 4 alusel kehtestatud loetelus; seadme vahetu kasutaja, kasutamise järelevaataja, seadmetööd tegev isik ja auditi tegija seadme ohutuse seaduse tähenduses; pädev isik ehitusseadustiku tähenduses.",
      "rdfs:label": {
        "@value": "Reg_329638_Par_3 (redaktsioon 329638)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "329638",
