      }
    },
    {
      "@id": "estleg:Reg_1026938_Par_4_v1026938",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026938_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piimapulber selle määruse tähenduses on tahke toode, mis saadakse vee eemaldamisega piimast, väherasvasest piimast, lõssist, koorest või nende segust ning mille massist võib vesi moodustada kuni 5 protsenti. Piimapulber selle määruse tähenduses on tahke toode, mis saadakse vee eemaldamisega piimast, väherasvasest piimast, lõssist, koorest või nende segust ning mille massist võib vesi moodustada kuni 5 protsenti. 2 (2) Täispiimapulber koosneb veetustatud piimast ja sisaldab rasva vähemalt 26 massiprotsenti, kuid alla 42 massiprotsendi. Täispiimapulber koosneb veetustatud piimast ja sisaldab rasva vähemalt 26 massiprotsenti, kuid alla 42 massiprotsendi. 3 (3) Koorepulber koosneb veetustatud piimast ja sisaldab rasva vähemalt 42 massiprotsenti. Koorepulber koosneb veetustatud piimast ja sisaldab rasva vähemalt 42 massiprotsenti. 4 (4) Väherasvane piimapulber koosneb veetustatud piimast ja sisaldab rasva üle 1,5, kuid alla 26 massiprotsendi. Väherasvane piimapulber koosneb veetustatud piimast ja sisaldab rasva üle 1,5, kuid alla 26 massiprotsendi. 5 (5) Lõssipulber koosneb veetustatud piimast ja sisaldab rasva alla 1,5 massiprotsendi. Lõssipulber koosneb veetustatud piimast ja sisaldab rasva alla 1,5 massiprotsendi. 6 (6) Täispiimapulbri, kõrge rasvasisaldusega piimapulbri, väherasvase piimapulbri ja lõssipulbri säilivus saavutatakse veetustamisega, järgides Euroopa Parlamendi ja nõukogu määruses (EÜ) nr 853/2004 sätestatud nõudeid. Täispiimapulbri, kõrge rasvasisaldusega piimapulbri, väherasvase piimapulbri ja lõssipulbri säilivus saavutatakse veetustamisega, järgides Euroopa Parlamendi ja nõukogu määruses (EÜ) nr 853/2004 sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1026938_Par_4 (redaktsioon 1026938)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026938",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026938",
      "estleg:sourceAct": "Kondenspiimade ja piimapulbrite koostis- ja kvaliteedinõuded ning toidualase teabe esitamise nõuded, kondenspiimadest ja piimapulbritest proovide võtmise ja proovide analüüsimise meetodid",
      "estleg:provisionRef": "Reg_1026938 § 4",
