        "@type": "xsd:date"
      },
      "estleg:versionText": "Diplomaatilise isikutunnistuse kehtivusaeg ei tohi ületada käesoleva määruse § 3 lõike 1 punkti 4 alusel esitatud kehtiva reisidokumendi või Eesti kodaniku isikutunnistuse kehtivusaega ega asukohariigis viibimise loa kehtivusaega, kui välisesindus ei asu Eestis. RT I 2025-08-26 1 126082025001 2025-10-01 Diplomaatilise isikutunnistuse kehtivusaeg ei tohi ületada käesoleva määruse § 3 lõike 1 punkti 4 alusel esitatud kehtiva reisidokumendi või Eesti kodaniku isikutunnistuse kehtivusaega ega asukohariigis viibimise loa kehtivusaega, kui välisesindus ei asu Eestis.",
      "rdfs:label": {
        "@value": "Reg_1037879_Par_6 (redaktsioon 1037879)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037879",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037879",
      "estleg:sourceAct": "Diplomaatilise isikutunnistuse väljaandmise ja kehtetuks tunnistamise kord, vorm, tehniline kirjeldus ja diplomaatilisele isikutunnistusele kantavate andmete loetelu ning tulumaksust vabastatud mitteresidentide registreerimise kord",
      "estleg:provisionRef": "Reg_1037879 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037879_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037879_Par_6_6_v1037879",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037879_Par_6_6"
      },
      "estleg:versionValidFrom": {
