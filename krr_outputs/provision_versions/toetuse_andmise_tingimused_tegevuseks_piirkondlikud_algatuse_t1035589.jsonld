      "dc:source": "Toetuse andmise tingimused tegevuseks „Piirkondlikud algatused tööhõive ja ettevõtlikkuse edendamiseks” perioodil 2017–2023"
    },
    {
      "@id": "estleg:Reg_1035589_Par_1_v1035589",
      "@type": [
        "owl:NamedIndividual",
