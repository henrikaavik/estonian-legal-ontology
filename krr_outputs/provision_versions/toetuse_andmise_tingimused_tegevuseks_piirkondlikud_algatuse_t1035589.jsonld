      }
    },
    {
      "@id": "estleg:Reg_1035589_Par_9_v1035589",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035589_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse maksimaalne määr on 84 protsenti projekti abikõlblikest kuludest. Omafinantseeringu minimaalne määr on 16 protsenti projekti abikõlblikest kuludest. Toetuse maksimaalne määr on 84 protsenti projekti abikõlblikest kuludest. Omafinantseeringu minimaalne määr on 16 protsenti projekti abikõlblikest kuludest. 2 (2) Kehtetu - RT I 2019-03-29 1 129032019001 2019-04-01 Kehtetu - 3 (3) Projektile antava toetuse rahaline maht ei tohi ületada perioodiks 2019. aasta 1. aprillist kuni 2023. aasta 31. detsembrini PATEE vahenditest maakonnale eraldatud summat, millele lisandub eelmisest perioodist 2016. aasta 20. oktoobrist kuni 2019. aasta 31. märtsini kohustustega katmata jääk ning vabanevad vahendid. RT I 2022-09-21 6 121092022006 2022-09-24 Projektile antava toetuse rahaline maht ei tohi ületada perioodiks 2019. aasta 1. aprillist kuni 2023. aasta 31. detsembrini PATEE vahenditest maakonnale eraldatud summat, millele lisandub eelmisest perioodist 2016. aasta 20. oktoobrist kuni 2019. aasta 31. märtsini kohustustega katmata jääk ning vabanevad vahendid.",
