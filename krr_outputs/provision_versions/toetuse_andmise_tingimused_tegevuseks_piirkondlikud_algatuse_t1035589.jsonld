    {
      "@id": "estleg:Reg_1035589_Par_12_v1035589",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035589_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlusi võib esitada jooksvalt alates rakendusüksuse seatud tähtpäevast kuni 2020. aasta 31. märtsini. Rakendusüksus kuulutab toetuse andmiseks rakendusasutuse ettepanekul välja avatud taotlusvooru. RT I 2019-03-29 1 129032019001 2019-04-01 Taotlusi võib esitada jooksvalt alates rakendusüksuse seatud tähtpäevast kuni 2020. aasta 31. märtsini. Rakendusüksus kuulutab toetuse andmiseks rakendusasutuse ettepanekul välja avatud taotlusvooru. 2 (2) Kehtetu - RT I 2019-03-29 1 129032019001 2019-04-01 Kehtetu - 3 (3) Taotlus esitatakse rakendusüksusele e-keskkonna kaudu taotleja esindusõigusliku isiku poolt digitaalselt allkirjastatuna. RT I 2018-08-17 1 117082018001 2018-09-01 Taotlus esitatakse rakendusüksusele e-keskkonna kaudu taotleja esindusõigusliku isiku poolt digitaalselt allkirjastatuna. 3 (3¹) Taotleja võib esitada taotlusvooru raames ühe taotluse perioodiks 2019. aasta 1. aprillist kuni 2023. aasta 31. detsembrini, välja arvatud § 15 lõikes 3 või 8 nimetatud juhul, kui taotlejal on õigus muuta taotlust ja esitada taotlus uuesti. Taotlejal on õigus esitada uus, täiendatud taotlus ka juhul, kui taotlus jääb rahuldamata § 17 lõike 2 alusel. RT I 2022-09-21 6 121092022006 2022-09-24 Taotleja võib esitada taotlusvooru raames ühe taotluse perioodiks 2019. aasta 1. aprillist kuni 2023. aasta 31. detsembrini, välja arvatud § 15 lõikes 3 või 8 nimetatud juhul, kui taotlejal on õigus muuta taotlust ja esitada taotlus uuesti. Taotlejal on õigus esitada uus, täiendatud taotlus ka juhul, kui taotlus jääb rahuldamata § 17 lõike 2 alusel. 4 (4) Taotleja on taotluse esitamisel kohustatud järgima struktuuritoetuse seaduse § 21 lõikes 2 sätestatud nõudeid. Taotleja on taotluse esitamisel kohustatud järgima struktuuritoetuse seaduse § 21 lõikes 2 sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1035589_Par_12 (redaktsioon 1035589)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035589",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035589",
      "estleg:sourceAct": "Toetuse andmise tingimused tegevuseks „Piirkondlikud algatused tööhõive ja ettevõtlikkuse edendamiseks” perioodil 2017–2023",
      "estleg:provisionRef": "Reg_1035589 § 12",
