      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Toetuse andmise tingimused tegevuseks „Piirkondlikud algatused tööhõive ja ettevõtlikkuse edendamiseks” perioodil 2017–2023 (26 versiooni)",
        "@language": "et"
