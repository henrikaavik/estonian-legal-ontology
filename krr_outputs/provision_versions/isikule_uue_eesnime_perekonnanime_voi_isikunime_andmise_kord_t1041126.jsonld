        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. jaanuaril 2018. aastal. Määrus jõustub 1. jaanuaril 2018. aastal.",
      "rdfs:label": {
        "@value": "Reg_1041126_Par_15 (redaktsioon 1041126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041126",
