    {
      "@id": "estleg:Reg_157431_Par_21_v157431",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157431_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vahelaane jahipiirkonna pindala on 12 120 hektarit. Vahelaane jahipiirkonna pindala on 12 120 hektarit. 2 (2) Vahelaane jahipiirkonna piirikirjeldus on järgmine: Vahelaane jahipiirkonna piirikirjeldus on järgmine: Vahelaane jahipiirkonna piir läheb Pilu tee ja Kõnnujõe kraavi ristumise kohast mööda Kõnnujõe kraavi Laeva metskonna kvartali CK038 loodesihini, jätkudes mööda Laeva metskonna kvartalite CK038 ja CK039 loodesihti, kvartali CK0020 edelasihti, kvartalite CK007 ja CK008 põhjasihti Muda peakraavini; sealt mööda Muda peakraavi Jora teeni ning mööda Jora teed Suurevälja kraavini, jätkudes mööda Suurevälja kraavi Muda jõeni ning mööda Muda jõge Jõgeva–Tartu maanteeni; edasi mööda Jõgeva–Tartu maanteed Lähte–Kõrveküla maanteeni ning mööda Lähte–Kõrveküla maanteed Tartu–Kallaste maanteeni; teeristist mööda Tartu–Kallaste maanteed Tartu linna piirini; sealt mööda Tartu linna piiri Emajõeni ning mööda Emajõge Sultsi sihini; siitpeale mööda Sultsi sihti Kassarti ojani ning mööda Kassarti oja Kärevere–Kärkna maanteeni; seejärel mööda Kärevere–Kärkna maanteed Laugi teeni, jätkudes mööda Laugi teed Marjakingu teeni; teeristist mööda Marjakingu teed Pilu teeni ning mööda Pilu teed Kõnnujõe kraavini. Vahelaane jahipiirkonna piir läheb Pilu tee ja Kõnnujõe kraavi ristumise kohast mööda Kõnnujõe kraavi Laeva metskonna kvartali CK038 loodesihini, jätkudes mööda Laeva metskonna kvartalite CK038 ja CK039 loodesihti, kvartali CK0020 edelasihti, kvartalite CK007 ja CK008 põhjasihti Muda peakraavini; sealt mööda Muda peakraavi Jora teeni ning mööda Jora teed Suurevälja kraavini, jätkudes mööda Suurevälja kraavi Muda jõeni ning mööda Muda jõge Jõgeva–Tartu maanteeni; edasi mööda Jõgeva–Tartu maanteed Lähte–Kõrveküla maanteeni ning mööda Lähte–Kõrveküla maanteed Tartu–Kallaste maanteeni; teeristist mööda Tartu–Kallaste maanteed Tartu linna piirini; sealt mööda Tartu linna piiri Emajõeni ning mööda Emajõge Sultsi sihini; siitpeale mööda Sultsi sihti Kassarti ojani ning mööda Kassarti oja Kärevere–Kärkna maanteeni; seejärel mööda Kärevere–Kärkna maanteed Laugi teeni, jätkudes mööda Laugi teed Marjakingu teeni; teeristist mööda Marjakingu teed Pilu teeni ning mööda Pilu teed Kõnnujõe kraavini.",
      "rdfs:label": {
        "@value": "Reg_157431_Par_21 (redaktsioon 157431)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157431",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157431",
