    {
      "@id": "estleg:Reg_157431_Par_10_v157431",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157431_Par_10"
