      }
    },
    {
      "@id": "estleg:Reg_157431_Par_15_v157431",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157431_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Peipsiääre jahipiirkonna pindala on 25 140 hektarit. Peipsiääre jahipiirkonna pindala on 25 140 hektarit. 2 (2) Peipsiääre jahipiirkonna piirikirjeldus on järgmine: Peipsiääre jahipiirkonna piirikirjeldus on järgmine: Peipsiääre jahipiirkonna piir läheb Alatskivi–Pala maantee ja Kaasiku–Viljuse tee ristumiskohast mööda Kaasiku–Viljuse teed Viljuse–Karjamõisa teeni, jätkudes mööda Viljuse–Karjamõisa teed Kadrina ojani; sealt mööda Kadrina oja Halliku metskonna kvartali 475 lõunasihini; edasi mööda Halliku metskonna kvartalite 475 ja 476 lõunasihti Ööbiku sihini, jätkudes mööda Ööbiku sihti Kasahstani kraavini; siitpeale mööda Kasahstani kraavi Punikvere teeni ning mööda Punikvere teed Kadrina–Kodavere maanteeni; teeristist mööda Kadrina–Kodavere maanteed Mustvee–Kallaste maanteeni ning mööda Mustvee–Kallaste maanteed Kodavere ojani; edasi mööda Kodavere oja Peipsi järveni, jätkudes Kodavere oja suudmest mööda Peipsi järve randa Emajõe suudmeni (jahipiirkonna juurde kuulub Peipsi järve akvatooriumi osa, mis ulatub 200 meetri kaugusele rannajoonest); seejärel Emajõe suudmest mööda Emajõge Kavastuni; Kavastust mööda Kavastu–Koosa maanteed Tartu–Kallaste maanteeni ning mööda Tartu–Kallaste maanteed Alatskivi–Pala maanteeni; teeristist mööda Alatskivi–Pala maanteed Kaasiku–Viljuse teeni. Peipsiääre jahipiirkonna piir läheb Alatskivi–Pala maantee ja Kaasiku–Viljuse tee ristumiskohast mööda Kaasiku–Viljuse teed Viljuse–Karjamõisa teeni, jätkudes mööda Viljuse–Karjamõisa teed Kadrina ojani; sealt mööda Kadrina oja Halliku metskonna kvartali 475 lõunasihini; edasi mööda Halliku metskonna kvartalite 475 ja 476 lõunasihti Ööbiku sihini, jätkudes mööda Ööbiku sihti Kasahstani kraavini; siitpeale mööda Kasahstani kraavi Punikvere teeni ning mööda Punikvere teed Kadrina–Kodavere maanteeni; teeristist mööda Kadrina–Kodavere maanteed Mustvee–Kallaste maanteeni ning mööda Mustvee–Kallaste maanteed Kodavere ojani; edasi mööda Kodavere oja Peipsi järveni, jätkudes Kodavere oja suudmest mööda Peipsi järve randa Emajõe suudmeni (jahipiirkonna juurde kuulub Peipsi järve akvatooriumi osa, mis ulatub 200 meetri kaugusele rannajoonest); seejärel Emajõe suudmest mööda Emajõge Kavastuni; Kavastust mööda Kavastu–Koosa maanteed Tartu–Kallaste maanteeni ning mööda Tartu–Kallaste maanteed Alatskivi–Pala maanteeni; teeristist mööda Alatskivi–Pala maanteed Kaasiku–Viljuse teeni.",
      "rdfs:label": {
        "@value": "Reg_157431_Par_15 (redaktsioon 157431)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157431",
