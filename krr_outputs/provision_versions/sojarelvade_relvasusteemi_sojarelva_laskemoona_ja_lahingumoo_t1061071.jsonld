      }
    },
    {
      "@id": "estleg:Reg_1061071_Par_7_v1061071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061071_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Relvaseaduse § 833 lõikes 21 nimetatud sõjarelva laskemoona komponendid on sõltuvalt laskemoona liigist: 1 1) püssirohi või muu paiskelaeng; 2 2) sütik, sealhulgas relvaseaduse § 17 lõike 1 punktis 2 nimetatud sütik; 3 3) süütekapsel; 4 4) sõjaliseks otstarbeks mõeldud lõhkeaine; 5 5) kuul, haavel või muu lendkeha; 6 6) padruni- või mürsukest; 7 7) muu sõjarelva laskemoona komponent, mis on spetsiaalselt sõjarelva laskemoona jaoks konstrueeritud ja vajalik laskemoona kasutamiseks. Relvaseaduse § 833 lõikes 21 nimetatud sõjarelva laskemoona komponendid on sõltuvalt laskemoona liigist: püssirohi või muu paiskelaeng; sütik, sealhulgas relvaseaduse § 17 lõike 1 punktis 2 nimetatud sütik; süütekapsel; sõjaliseks otstarbeks mõeldud lõhkeaine; kuul, haavel või muu lendkeha; padruni- või mürsukest; muu sõjarelva laskemoona komponent, mis on spetsiaalselt sõjarelva laskemoona jaoks konstrueeritud ja vajalik laskemoona kasutamiseks. 2 (2) Sõjarelva laskemoon koosneb järgmistest olulistest komponentidest sõltuvalt sõjarelva laskemoona liigist: 1 1) sütik, välja arvatud relvaseaduse § 17 lõike 1 punktis 2 nimetatud sütik; 2 2) süütekapsel; 3 3) sõjaliseks otstarbeks mõeldud lõhkeaine; 4 4) mürsukest, kuul või muu lendkeha, mis on täidetud lõhkeainega või muu sõjalisel otstarbel kasutatava keemilise aine, segu või muu komponendiga. Sõjarelva laskemoon koosneb järgmistest olulistest komponentidest sõltuvalt sõjarelva laskemoona liigist: sütik, välja arvatud relvaseaduse § 17 lõike 1 punktis 2 nimetatud sütik; süütekapsel; sõjaliseks otstarbeks mõeldud lõhkeaine; mürsukest, kuul või muu lendkeha, mis on täidetud lõhkeainega või muu sõjalisel otstarbel kasutatava keemilise aine, segu või muu komponendiga.",
      "rdfs:label": {
        "@value": "Reg_1061071_Par_7 (redaktsioon 1061071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061071",
      "estleg:sourceAct": "Sõjarelvade, relvasüsteemi, sõjarelva laskemoona ja lahingumoona ning nende osade, sealhulgas oluliste osade või komponentide täpsustav loetelu ja liigitus",
      "estleg:provisionRef": "Reg_1061071 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061071_Par_8_v1061071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061071_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Relvaseaduse § 833 lõikes 2 nimetatud lahingumoona (edaspidi lahingumoon) liigitatakse järgmiselt: 1 1) pomm; 2 2) torpeedo; 3 3) reaktiivmürsk; 4 4) rakett; 5 5) miin; 6 6) granaat; 7 7) süvaveepomm; 8 8) lõhkelaeng; 9 9) lõhkeseade; 10 10) lõhkepakett; 11 11) süütepomm; 12 12) varitsev ründemoon. Relvaseaduse § 833 lõikes 2 nimetatud lahingumoona (edaspidi lahingumoon) liigitatakse järgmiselt: pomm; torpeedo; reaktiivmürsk; rakett; miin; granaat; süvaveepomm; lõhkelaeng; lõhkeseade; lõhkepakett; süütepomm; varitsev ründemoon. 2 (2) Varitsev ründemoon on käesoleva määruse tähenduses mehitamata õhu-, maismaa- või veesõiduki baasil sõjaliseks otstarbeks projekteeritud ja valmistatud lahingumoon, mis on võimeline sõidu kestel ja kindla aja vältel püsima ooterežiimis sihtmärgi leidmiseks, tuvastamiseks ja hävitamiseks. Varitsev ründemoon on käesoleva määruse tähenduses mehitamata õhu-, maismaa- või veesõiduki baasil sõjaliseks otstarbeks projekteeritud ja valmistatud lahingumoon, mis on võimeline sõidu kestel ja kindla aja vältel püsima ooterežiimis sihtmärgi leidmiseks, tuvastamiseks ja hävitamiseks. 3 (3) Lahingumoonaks ei loeta lahingumoonaks projekteeritud ja valmistatud mehitamata õhu-, maismaa- või veesõidukit, millel puudub lahingumoona oluline osa. Lahingumoonaks ei loeta lahingumoonaks projekteeritud ja valmistatud mehitamata õhu-, maismaa- või veesõidukit, millel puudub lahingumoona oluline osa.",
      "rdfs:label": {
        "@value": "Reg_1061071_Par_8 (redaktsioon 1061071)",
        "@language": "et"
      },
