    {
      "@id": "estleg:Reg_1035870_Par_13_v1035870",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035870_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse, maastikuilme ja pinnavormi säilitamine. Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse, maastikuilme ja pinnavormi säilitamine.",
      "rdfs:label": {
        "@value": "Reg_1035870_Par_13 (redaktsioon 1035870)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035870",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035870",
      "estleg:sourceAct": "Ebavere maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035870 § 13",
