    {
      "@id": "estleg:Reg_1035870_Par_18_v1035870",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035870_Par_18"
