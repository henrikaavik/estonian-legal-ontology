      }
    },
    {
      "@id": "estleg:Reg_1035870_Par_10_v1035870",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035870_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevööndis on lubatud kuni 50 osalejaga rahvaürituse korraldamine kohas, mis on kaitseala valitseja nõusolekul selleks ette valmistatud ja tähistatud, ning kuni 30 osalejaga rahvaürituse korraldamine kohas, mis on kaitseala valitseja nõusolekul selleks ette valmistamata ja tähistamata. Sihtkaitsevööndis on lubatud kuni 50 osalejaga rahvaürituse korraldamine kohas, mis on kaitseala valitseja nõusolekul selleks ette valmistatud ja tähistatud, ning kuni 30 osalejaga rahvaürituse korraldamine kohas, mis on kaitseala valitseja nõusolekul selleks ette valmistamata ja tähistamata. 2 (2) Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) rohkem kui 50 osalejaga rahvaürituse korraldamine kohas, mis on kaitseala valitseja nõusolekul selleks ette valmistatud ja tähistatud, ning rohkem kui 30 osalejaga rahvaürituse korraldamine kohas, mis on selleks ette valmistamata ja tähistamata; 2 2) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 3 3) koosluse kujundamine vastavalt kaitse-eesmärgile; 4 4) olemasolevate rajatiste hooldustööd. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: rohkem kui 50 osalejaga rahvaürituse korraldamine kohas, mis on kaitseala valitseja nõusolekul selleks ette valmistatud ja tähistatud, ning rohkem kui 30 osalejaga rahvaürituse korraldamine kohas, mis on selleks ette valmistamata ja tähistamata; kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; koosluse kujundamine vastavalt kaitse-eesmärgile; olemasolevate rajatiste hooldustööd.",
      "rdfs:label": {
        "@value": "Reg_1035870_Par_10 (redaktsioon 1035870)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035870",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035870",
      "estleg:sourceAct": "Ebavere maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035870 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035870_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035870_Par_11_v1035870",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035870_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesolevas määruses sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud rajatise püstitamine kaitseala tarbeks. Sihtkaitsevööndis on keelatud, arvestades käesolevas määruses sätestatud erisusi: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud rajatise püstitamine kaitseala tarbeks.",
      "rdfs:label": {
        "@value": "Reg_1035870_Par_11 (redaktsioon 1035870)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035870",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035870",
      "estleg:sourceAct": "Ebavere maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035870 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035870_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035870_Par_12_v1035870",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035870_Par_12"
