      }
    },
    {
      "@id": "estleg:Reg_157998_Par_18_v157998",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157998_Par_18"
