      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Krediidiasutusepõhise vastutsüklilise kapitalipuhvri määra arvutamine ja teise riigi vastutsüklilise kapitalipuhvri määra tunnustamine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Krediidiasutusepõhise vastutsüklilise kapitalipuhvri määra arvutamine ja teise riigi vastutsüklilise kapitalipuhvri määra tunnustamine"
    },
    {
      "@id": "estleg:Reg_1031890_Par_1_v1031890",
      "@type": [
        "owl:NamedIndividual",
