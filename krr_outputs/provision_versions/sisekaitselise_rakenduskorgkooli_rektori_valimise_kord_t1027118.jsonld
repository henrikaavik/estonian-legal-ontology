    {
      "@id": "estleg:Reg_1027118_Par_7_v1027118",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027118_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rektori valimine võib toimuda mitmes hindamisvoorus. Rektori valimine võib toimuda mitmes hindamisvoorus. 2 (2) Hindamisvoorude arvu ja kandidaatide hindamise meetodid otsustab komisjon esimesel kohtumisel. Hindamisvoorude arvu ja kandidaatide hindamise meetodid otsustab komisjon esimesel kohtumisel.",
      "rdfs:label": {
        "@value": "Reg_1027118_Par_7 (redaktsioon 1027118)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027118",
