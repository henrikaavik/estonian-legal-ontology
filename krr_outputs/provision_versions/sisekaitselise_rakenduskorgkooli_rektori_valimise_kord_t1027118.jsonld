    {
      "@id": "estleg:Reg_1027118_Par_10_v1027118",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027118_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkurss loetakse luhtunuks, kui: 1 1) sellel osalemiseks ei esitatud ühtegi taotlust; 2 2) töölepingu sõlmimise õigust omav isik loobus töökohale asumise ettepaneku tegemisest põhjusel, et ühegi rektorikandidaadi töökogemus, teadmised ja oskused ei vastanud teenistusülesannete täitmiseks kehtestatud nõuetele määral, mis võimaldanuks rektorikandidaadil täita teenistusülesandeid parimal võimalikul viisil; 3 3) ühegi konkursitingimustele vastava kandidaadiga ei sõlmitud töölepingut; 4 4) rikuti oluliselt protseduurireegleid. Konkurss loetakse luhtunuks, kui: sellel osalemiseks ei esitatud ühtegi taotlust; töölepingu sõlmimise õigust omav isik loobus töökohale asumise ettepaneku tegemisest põhjusel, et ühegi rektorikandidaadi töökogemus, teadmised ja oskused ei vastanud teenistusülesannete täitmiseks kehtestatud nõuetele määral, mis võimaldanuks rektorikandidaadil täita teenistusülesandeid parimal võimalikul viisil; ühegi konkursitingimustele vastava kandidaadiga ei sõlmitud töölepingut; rikuti oluliselt protseduurireegleid.",
      "rdfs:label": {
        "@value": "Reg_1027118_Par_10 (redaktsioon 1027118)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027118",
