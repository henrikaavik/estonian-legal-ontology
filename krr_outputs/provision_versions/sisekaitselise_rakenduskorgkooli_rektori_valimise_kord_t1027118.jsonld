      }
    },
    {
      "@id": "estleg:Reg_1027118_Par_8_v1027118",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027118_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohalolevatel komisjoni liikmetel ei ole õigust hääletamisest keelduda. Häälte võrdsel jagunemisel on otsustav komisjoni esimehe hääl, kusjuures komisjoni esimehel ei ole õigust erapooletuks jääda. Kohalolevatel komisjoni liikmetel ei ole õigust hääletamisest keelduda. Häälte võrdsel jagunemisel on otsustav komisjoni esimehe hääl, kusjuures komisjoni esimehel ei ole õigust erapooletuks jääda. 2 (2) Komisjon esitab konkursi lõppedes valdkonna eest vastutavale ministrile töölepingu sõlmimiseks ühe kuni kolm kandidaati. Sobivate kandidaatide puudumisel loobub komisjon kandidaadi esitamisest. RT I 2016-12-09 1 109122016001 2016-12-12 Komisjon esitab konkursi lõppedes valdkonna eest vastutavale ministrile töölepingu sõlmimiseks ühe kuni kolm kandidaati. Sobivate kandidaatide puudumisel loobub komisjon kandidaadi esitamisest.",
      "rdfs:label": {
        "@value": "Reg_1027118_Par_8 (redaktsioon 1027118)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027118",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027118",
