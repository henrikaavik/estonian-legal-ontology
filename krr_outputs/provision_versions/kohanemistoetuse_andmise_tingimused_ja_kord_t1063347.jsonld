      "estleg:versionText": "Enne käesoleva määruse jõustumist eraldatud kohanemistoetustele kohaldatakse toetuse taotlemise ajal kehtinud tingimusi ja korda. Enne käesoleva määruse jõustumist eraldatud kohanemistoetustele kohaldatakse toetuse taotlemise ajal kehtinud tingimusi ja korda.",
      "rdfs:label": {
        "@value": "Reg_1063347_Par_18 (redaktsioon 1063347)",
        "@language": "et"
      },
