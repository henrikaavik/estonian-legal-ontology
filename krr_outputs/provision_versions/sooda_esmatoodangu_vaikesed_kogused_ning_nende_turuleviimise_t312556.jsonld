      }
    },
    {
      "@id": "estleg:Reg_312556_Par_2_v312556",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312556_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Turuleviidav sööda esmatoodangu väike kogus peab vastama «Söödaseaduses» sätestatud nõuetele ning olema läbinud üksnes lihtsa füüsilise töötluse, sealhulgas puhastamise, pakendamise, ladustamise, loomuliku kuivatamise või sileerimise. Turuleviidav sööda esmatoodangu väike kogus peab vastama «Söödaseaduses» sätestatud nõuetele ning olema läbinud üksnes lihtsa füüsilise töötluse, sealhulgas puhastamise, pakendamise, ladustamise, loomuliku kuivatamise või sileerimise. 2 (2) Turuleviidav sööda esmatoodangu väike kogus peab olema kaitstud saastumise ja riknemise eest kõikides sööda käitlemise etappides ega tohi põhjustada sööda saastumist käitlemise järgmiste etappide käigus. Turuleviidav sööda esmatoodangu väike kogus peab olema kaitstud saastumise ja riknemise eest kõikides sööda käitlemise etappides ega tohi põhjustada sööda saastumist käitlemise järgmiste etappide käigus.",
      "rdfs:label": {
