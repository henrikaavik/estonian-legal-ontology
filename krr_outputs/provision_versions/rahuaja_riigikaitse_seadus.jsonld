        "@id": "estleg:RRKS_Par_22_v101092015026"
      },
      "estleg:versionValidTo": {
        "@value": "2015-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_22_v101092015026",
      "@type": [
        "owl:NamedIndividual",
