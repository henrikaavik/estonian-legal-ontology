        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_17_v178341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Siseministeeriumi valitsemisalas olevad sõjaväeliselt korraldatud üksused tagavad enda valmisoleku riigi sõjaliseks kaitseks ning täidavad oma pädevuse piires muid riigikaitselisi ülesandeid. (2) Käesoleva paragrahvi lõikes 1 nimetatud üksused lähevad kaitseväe koosseisu Vabariigi Valitsuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "RRKS_Par_17 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341",
