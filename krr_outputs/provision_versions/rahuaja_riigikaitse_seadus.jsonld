        "@value": "2014-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_23_v113032014052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus võib valdkonna eest vastutava ministri ettepanekul korraldusega panna maavalitsustele ülesandeid riigikaitse ettevalmistamiseks.",
      "rdfs:label": {
        "@value": "RRKS_Par_23 (redaktsioon 113032014052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014052"
    },
    {
      "@id": "estleg:RRKS_Par_24_v22313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadusega kehtestatud ülesannete eiramise eest isikute poolt, kellele need ülesanded on kohustuslikud täitmiseks, või riigikaitseliste õigusaktide muu rikkumise eest kohaldatakse vastavalt tehioludele distsiplinaar-, haldus-, tsiviil- või kriminaalvastutust.",
      "rdfs:label": {
        "@value": "RRKS_Par_24 (redaktsioon 22313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22313",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_24_v178341"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_24_v178341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohalikud omavalitsusüksused: aitavad oma pädevuse piires igakülgselt kaasa reservväelaste arvestuse pidamisele; aitavad kaasa sundvõõrandamise korraldamisele ning korraldavad kohaliku omavalitsuse territooriumil elavate isikute tehtavaid hädaabitöid; tagavad maanteede ja sildade korrashoiu seadusega sätestatud alustel ja korras; aitavad kohaliku omavalitsuse territooriumil kaasa isikute evakueerimisele ning evakueeritute majutamisele, toitlustamisele ja neile arstiabi andmisele; korraldavad sõjategevuses kannatada saanud isikute hoolekannet; toetavad mobiliseeritute perekondi; täidavad teiste seadustega neile pandud riigikaitselisi ülesandeid.",
      "rdfs:label": {
        "@value": "RRKS_Par_24 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_24_v255852"
      },
      "estleg:versionValidTo": {
        "@value": "2003-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_24_v255852",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohalikud omavalitsusüksused: aitavad oma pädevuse piires igakülgselt kaasa reservväelaste arvestuse pidamisele; aitavad kaasa sundvõõrandamise korraldamisele ning korraldavad kohaliku omavalitsuse territooriumil elavate isikute tehtavaid hädaabitöid; tagavad maanteede ja sildade korrashoiu seadusega sätestatud alustel ja korras; aitavad kohaliku omavalitsuse territooriumil kaasa isikute evakueerimisele ning evakueeritute majutamisele, toitlustamisele ja neile arstiabi andmisele; korraldavad sõjategevuses kannatada saanud isikute hoolekannet; toetavad mobiliseeritute perekondi; [Alapunkt 6 1 jõustub 1. 05. 2003] osalevad õppekogunemiste läbiviimisel, sõjalise valmisoleku muutmisel ja mobilisatsiooni läbiviimisel; täidavad teiste seadustega neile pandud riigikaitselisi ülesandeid.",
      "rdfs:label": {
        "@value": "RRKS_Par_24 (redaktsioon 255852)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "255852",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_24_v695946"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_24_v695946",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohalikud omavalitsusüksused: aitavad oma pädevuse piires igakülgselt kaasa reservväelaste arvestuse pidamisele; aitavad kaasa sundvõõrandamise korraldamisele ning korraldavad kohaliku omavalitsuse territooriumil elavate isikute tehtavaid hädaabitöid; tagavad maanteede ja sildade korrashoiu seadusega sätestatud alustel ja korras; aitavad kohaliku omavalitsuse territooriumil kaasa isikute evakueerimisele ning evakueeritute majutamisele, toitlustamisele ja neile arstiabi andmisele; korraldavad sõjategevuses kannatada saanud isikute hoolekannet; toetavad mobiliseeritute perekondi; osalevad õppekogunemiste läbiviimisel, sõjalise valmisoleku muutmisel ja mobilisatsiooni läbiviimisel; täidavad teiste seadustega neile pandud riigikaitselisi ülesandeid.",
      "rdfs:label": {
        "@value": "RRKS_Par_24 (redaktsioon 695946)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "695946"
    },
    {
      "@id": "estleg:RRKS_Par_25_v22313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "RRKS_Par_25 (redaktsioon 22313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22313",
