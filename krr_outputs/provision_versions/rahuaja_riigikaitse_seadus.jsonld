      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_10_v12794945",
      "@type": [
        "owl:NamedIndividual",
