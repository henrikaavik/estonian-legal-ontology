    },
    {
      "@id": "estleg:RRKS_Par_6_v22313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikaitset korraldavad Riigikogu, Vabariigi President, Vabariigi Valitsus ja kaitseväe juhataja, sõjaajal kaitseväe ülemjuhataja. (2) Riigikaitse kõrgeimaks juhiks on Vabariigi President. (3) Vabariigi Presidendi juures on nõuandvaks organiks Riigikaitse Nõukogu, mille koosseisu ja pädevuse sätestab käesolev seadus.",
      "rdfs:label": {
        "@value": "RRKS_Par_6 (redaktsioon 22313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22313",
