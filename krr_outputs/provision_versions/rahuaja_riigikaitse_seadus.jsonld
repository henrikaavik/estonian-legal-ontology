      }
    },
    {
      "@id": "estleg:RRKS_Par_28_v113032014052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitsetegevuse operatiivkava kirjeldab sõjalise kaitse ülesannete täitmist olemasolevate sõjaliste võimetega vastavalt Vabariigi Valitsuse riigikaitse strateegias püstitatud eesmärkidele. (2) Kaitsetegevuse operatiivkava kehtestab Kaitseväe juhataja kooskõlastatult valdkonna eest vastutava ministriga üheks aastaks.",
      "rdfs:label": {
        "@value": "RRKS_Par_28 (redaktsioon 113032014052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014052"
    },
    {
      "@id": "estleg:RRKS_Par_29_v178341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni kaitseväe korralduse seaduse jõustumiseni käsitatakse käesoleva seaduse § 3 lõike 1 punktis 4, § 5 lõike 2 punktis 3 ning § 14 lõike 3 punktis 4 nimetatud kaitseväe juhtkonnana Kaitsejõudude Peastaabi ülemat, väeliikide ülemaid ja Kaitseliidu ülemat.",
      "rdfs:label": {
        "@value": "RRKS_Par_29 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341"
    },
    {
      "@id": "estleg:RRKS_Par_3_v22313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiki kaitsevad sõjalise tegevusega kaitsejõud. (2) Kaitsejõududeks on: kaitsevägi; Kaitseliit; sõjaajal kaitseväe ülemjuhataja alluvusse antavad Siseministeeriumi valitsemisalas olevad sõjaväeliselt korraldatud asutused ja üksused (edaspidi teised relvaüksused) vastavalt sõjaaja riigikaitse seadusele (RT I 1994, 69, 1194).",
      "rdfs:label": {
        "@value": "RRKS_Par_3 (redaktsioon 22313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22313",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_3_v178341"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_3_v178341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi President riigikaitse kõrgeima juhina: teeb Riigikogule ettepaneku sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ning erakorralise seisukorra väljakuulutamiseks; kuulutab Eesti Vabariigi vastu suunatud agressiooni korral välja sõjaseisukorra ja mobilisatsiooni, nimetab kaitseväe ülemjuhataja, ootamata ära Riigikogu otsust, ning vastavalt ÜRO põhikirja artiklile 51 teavitab sellest viivitamatult Julgeolekunõukogu; teeb Riigikogule ettepaneku kaitseväe juhataja või ülemjuhataja ametisse nimetamiseks ja ametist vabastamiseks, olles ära kuulanud Riigikaitse Nõukogu arvamuse; nimetab Vabariigi Valitsuse ja kaitseväe juhataja ettepanekul ametisse ja vabastab ametist kaitseväe juhtkonna; annab ohvitseri sõjaväelisi auastmeid seadusega sätestatud korras; kutsub kokku Riigikaitse Nõukogu; täidab teiste seadustega talle pandud ülesandeid riigikaitse korraldamisel. (2) Vabariigi Presidendil on õigus nõuda riigi julgeoleku ja riigikaitse kohta informatsiooni kõigilt riigi- ja kohaliku omavalitsuse asutustelt ning Kaitseliidult. Vabariigi Presidendi sellisele järelepärimisele tuleb vastata viivitamatult. (3) Käesoleva paragrahvi lõikes 1 sätestatu alusel antud Vabariigi Presidendi aktide täitmist korraldab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "RRKS_Par_3 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_3_v108072011055"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-21",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_3_v108072011055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi President riigikaitse kõrgeima juhina: teeb Riigikogule ettepaneku sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ning erakorralise seisukorra väljakuulutamiseks; kuulutab Eesti Vabariigi vastu suunatud agressiooni korral välja sõjaseisukorra ja mobilisatsiooni, ootamata ära Riigikogu otsust, ja teavitab sellest Ühinenud Rahvaste Organisatsiooni põhikirja artikli 51 kohaselt viivitamata Julgeolekunõukogu; Kehtetu - Kehtetu - annab ohvitseri sõjaväelisi auastmeid seadusega sätestatud korras; kutsub kokku Riigikaitse Nõukogu; täidab teiste seadustega talle pandud ülesandeid riigikaitse korraldamisel. (2) Vabariigi Presidendil on õigus nõuda riigi julgeoleku ja riigikaitse kohta informatsiooni kõigilt riigi- ja kohaliku omavalitsuse asutustelt ning Kaitseliidult. Vabariigi Presidendi sellisele järelepärimisele tuleb vastata viivitamatult. (3) Käesoleva paragrahvi lõikes 1 sätestatu alusel antud Vabariigi Presidendi aktide täitmist korraldab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "RRKS_Par_3 (redaktsioon 108072011055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072011055",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_3_v129112011007"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_3_v129112011007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi President riigikaitse kõrgeima juhina: teeb Riigikogule ettepaneku sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ning erakorralise seisukorra väljakuulutamiseks; kuulutab Eesti Vabariigi vastu suunatud agressiooni korral välja sõjaseisukorra ja mobilisatsiooni, ootamata ära Riigikogu otsust, ja teavitab sellest Ühinenud Rahvaste Organisatsiooni põhikirja artikli 51 kohaselt viivitamata Julgeolekunõukogu; kehtetu - kehtetu - annab ohvitseri sõjaväelisi auastmeid seadusega sätestatud korras; kutsub kokku Riigikaitse Nõukogu; täidab teiste seadustega talle pandud ülesandeid riigikaitse korraldamisel. (2) Vabariigi Presidendil on õigus nõuda riigi julgeoleku ja riigikaitse kohta informatsiooni kõigilt riigi- ja kohaliku omavalitsuse asutustelt ning Kaitseliidult. Vabariigi Presidendi sellisele järelepärimisele tuleb vastata viivitamatult. (3) Käesoleva paragrahvi lõikes 1 sätestatu alusel antud Vabariigi Presidendi aktide täitmist korraldab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "RRKS_Par_3 (redaktsioon 129112011007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129112011007"
    },
    {
      "@id": "estleg:RRKS_Par_30_v178341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kuni kaitseväe korralduse seaduse jõustumiseni rakendatakse kaitseväe juhataja asendamise suhtes käesolevas paragrahvis sätestatud korda. (2) Kaitseväe juhataja puhkuse või haiguse ajal või kui ta ei saa oma ülesandeid täita muu mõjuva põhjuse tõttu, täidab neid kuni Vabariigi Presidendi määratud tähtajani Kaitsejõudude Peastaabi ülem. (3) Riigikogu poolt kaitseväe juhataja ametist vabastamise korral on kuni kaitseväe uue juhataja ametisse nimetamiseni Kaitsejõudude Peastaabi ülem kaitseväe juhataja ülesannetes. (4) Kui Kaitsejõudude Peastaabi ülem ei saa täita käesoleva paragrahvi lõigetes 2 ja 3 ettenähtud juhtudel kaitseväe juhataja ülesandeid, määrab Vabariigi President kaitseväe juhataja kohusetäitja. (5) Eesti Vabariigi vastu suunatud agressiooni korral nimetab Vabariigi President ametisse kaitseväe ülemjuhataja. Kaitseväe ülemjuhataja hukkumise, raske haavata saamise, raske haiguse või vangilangemise korral või kui ta ei saa oma ülesandeid täita muu mõjuva põhjuse tõttu, täidab neid kuni kaitseväe uue ülemjuhataja ametisse nimetamiseni Kaitsejõudude Peastaabi ülem.",
      "rdfs:label": {
        "@value": "RRKS_Par_30 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341"
    },
    {
      "@id": "estleg:RRKS_Par_31_v178341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni kaitseväe korralduse seaduse jõustumiseni: on kaitseväe juhataja töö korraldamiseks tema alluvuses Kaitsejõudude Peastaap; juhib Kaitsejõudude Peastaabi tööd ja vastutab selle eest Kaitsejõudude Peastaabi ülem; kehtestatakse Kaitsejõudude Peastaabi põhimäärus Vabariigi Valitsuse määrusega.",
      "rdfs:label": {
        "@value": "RRKS_Par_31 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_31_v255852"
      },
      "estleg:versionValidTo": {
        "@value": "2003-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_31_v255852",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni kaitseväe korralduse seaduse jõustumiseni: on kaitseväe juhataja töö korraldamiseks tema alluvuses Kaitsejõudude Peastaap; juhib Kaitsejõudude Peastaabi tööd ja vastutab selle eest Kaitsejõudude Peastaabi ülem; kehtestatakse Kaitsejõudude Peastaabi põhimäärus Vabariigi Valitsuse määrusega. §-d 32--38. [Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "RRKS_Par_31 (redaktsioon 255852)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "255852",
