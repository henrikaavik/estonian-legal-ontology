        "@id": "estleg:RRKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseministri määrused ja käskkirjad kaitseväele ja Kaitseliidule avaldatakse täitmiseks kaitseväe juhataja poolt.",
      "rdfs:label": {
        "@value": "RRKS_Par_17 (redaktsioon 22313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22313",
