      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub Riigi Teatajas avaldamisele järgneval päeval.",
      "rdfs:label": {
        "@value": "RRKS_Par_27 (redaktsioon 22313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22313",
