      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsusele esitatakse riigikaitseliste õigusaktide eelnõud: asjaomase ministri poolt koos kaitseministri ja kaitseväe juhataja arvamusega eelnõu kohta; kaitseministri poolt koos kaitseväe juhataja arvamusega eelnõu kohta.",
      "rdfs:label": {
        "@value": "RRKS_Par_15 (redaktsioon 22313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22313",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_15_v178341"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_15_v178341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe juhataja õigusakt on käskkiri. (2) Kaitseväe juhataja on kohustatud kaitseministri nõudmisel saatma kaitseministrile ärakirja oma käskkirjast kolme päeva jooksul, alates nõude saamisest.",
      "rdfs:label": {
        "@value": "RRKS_Par_15 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_15_v113032014051"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_15_v113032014051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe juhataja õigusakt on käskkiri. (2) Kaitseväe juhataja on kohustatud valdkonna eest vastutava ministri nõudmisel saatma valdkonna eest vastutavale ministrile ärakirja oma käskkirjast kolme päeva jooksul, alates nõude saamisest. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „kaitseministri“ sõnadega „valdkonna eest vastutava ministri“.",
      "rdfs:label": {
        "@value": "RRKS_Par_15 (redaktsioon 113032014051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014051",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_15_v113032014052"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_15_v113032014052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe juhataja õigusakt on käskkiri. (2) Kaitseväe juhataja on kohustatud valdkonna eest vastutava ministri nõudmisel saatma valdkonna eest vastutavale ministrile ärakirja oma käskkirjast kolme päeva jooksul, alates nõude saamisest.",
      "rdfs:label": {
        "@value": "RRKS_Par_15 (redaktsioon 113032014052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014052"
    },
    {
      "@id": "estleg:RRKS_Par_16_v22313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseministeeriumi valitsemisalas on : kaitsevägi; Kaitseliit; riigikaitseosakonnad; Kaitseväeteenistuse Peakomisjon; kaitseväeteenistuse komisjonid; Kaitseministeeriumi ettevõtted ja asutused; kaitseväe õppeasutused. (2) Kaitseministeerium: töötab välja riigikaitsepoliitika põhisuunad, teostab ja koordineerib nende elluviimist; töötab välja koostöös vastavate ministeeriumidega ja kaitseväe juhatajaga riigikaitse üldkava ning mobilisatsioonikava; juhib ja korraldab reservväelaste mobiliseerimist, neile mobilisatsioonikäskude edasiandmist, reservväelaste kogunemist ja teenistuskohtadesse toimetamist; töötab välja riigikaitset ja selle korraldust reguleerivate õigustloovate aktide eelnõud; vaatab läbi kaitseväe ja Kaitseliidu struktuuri ning nende struktuuriüksuste moodustamise, ümberformeerimise ja laialisaatmise, nende paiknemise ning esitab need kinnitamiseks Vabariigi Valitsusele; kinnitab kaitseväe juhataja ettepanekul kaitseväe ja Kaitseliidu palgalise koosseisu; koostab riigikaitse eelarveettepanekud ja esitab need Vabariigi Valitsusele; korraldab kaitseväe ja Kaitseliidu finantseerimist ning majandamist; korraldab koostöös Välisministeeriumiga suhtlemist välisriikide sõjaväeatašeedega; koostab ja esitab Vabariigi Valitsusele kinnitamiseks ameti- ja töökohtade loetelu, kus töötamine vabastab reservväelase kaitseväeteenistuse seaduse (RT I 1994, 23, 384) § 79 alusel mobilisatsiooni korral kogunemiskohta ilmumise kohustusest; teostab kaitseväe ja Kaitseliidu varustamist relvade, lahingutehnika, vormiriietuse, materiaal-tehniliste ja muude vahenditega ning vastavate mobilisatsioonivarude soetamist, säilitamist ja uuendamist; suunab kaitsetööstuse arendamist ja korraldab sõjaajal ministeeriumi valdusse antavate ettevõtete ettevalmistamist tegutsemiseks sõjaajal; korraldab kaitseväeteenistuse komisjonide tööd ja kutsealuste kutsumist ajateenistusse; suunab riigikaitsealast teadustööd; korraldab õppematerjalide ja ajakirjanduse kirjastamist kaitseväele ja Kaitseliidule; korraldab reservväelaste arvestust ja õppekogunemisi ning mobilisatsiooni ettevalmistamist; korraldab tervishoidu kaitseväes ja Kaitseliidus; [välja jäetud] nõuab riigikaitsega seotud informatsiooni asjaomastelt isikutelt, asutustelt ja organisatsioonidelt; informeerib eelnevalt kohaliku omavalitsuse täitevorganit (valla- või linnavalitsust) nende territooriumil toimuvast riigikaitselisest õppusest; korraldab riigikaitselise õppuse tagajärjel tekitatud kahjude kompenseerimise kahju kandnud füüsilistele ja juriidilistele isikutele; kontrollib kaitseväge ja Kaitseliitu, samuti riigikaitseliste õigusaktide täitmist riigiasutuste, valla- või linnavalitsuste ning riigikaitselisi ülesandeid täitvate muude asutuste, ettevõtete ja organisatsioonide poolt.",
      "rdfs:label": {
        "@value": "RRKS_Par_16 (redaktsioon 22313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22313",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_16_v178341"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKS_Par_16_v178341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväe juhataja alluvuses olevad asutused ja üksused registreeritakse riigi- ja kohaliku omavalitsuse asutuste riiklikus registris selle registri põhimääruses sätestatud korras.",
      "rdfs:label": {
        "@value": "RRKS_Par_16 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341",
