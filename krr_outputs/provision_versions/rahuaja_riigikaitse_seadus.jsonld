      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsuse juures tegutseb riigikaitse valdkonnas valitsuskomisjoni pädevusega julgeolekukomisjon. (2) Julgeolekukomisjon: täidab julgeolekuasutuste seaduses (RT I 2001, 7, 17; 100, 643) ettenähtud ülesandeid; nõustab käesoleva seaduse § 5 lõikes 2 ettenähtud ülesannete täitmist; avaldab oma seisukoha kaitseväe juhataja kandidaadi vastavuse kohta riigisaladusele juurdepääsu loa saamise tingimustele. (3) Julgeolekukomisjoni kuuluvad peaminister, justiitsminister, kaitseminister, rahandusminister, siseminister ja välisminister.",
      "rdfs:label": {
        "@value": "RRKS_Par_7 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_7_v13001725"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
