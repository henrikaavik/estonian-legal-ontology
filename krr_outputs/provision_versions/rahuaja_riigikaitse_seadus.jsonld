      }
    },
    {
      "@id": "estleg:RRKS_Par_27_v178341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjalise kaitse strateegiline kava käsitleb riigi sõjalist strateegiat välise sõjaohu kõrvaldamiseks, üldise kaitselahenduse kirjeldust, riigikaitseks eraldatavaid ressursse, kaitseväe rahuaja koosseisu ja sõjaaja koosseisu ning kaitsevõime tõstmise prioriteetseid suundi. (2) Sõjalise kaitse strateegilise kava kehtestab Vabariigi Valitsus kaitseministri ettepanekul viieks aastaks. Vabariigi Valitsus võib kaitseministri ettepanekul teha sõjalise kaitse strateegilises kavas muudatusi. (3) Enne sõjalise kaitse strateegilise kava või selle muutmise eelnõu esitamist Vabariigi Valitsusele kinnitamiseks kuulab kaitseminister ära Riigikogu riigikaitsekomisjoni liikmete seisukohad.",
      "rdfs:label": {
        "@value": "RRKS_Par_27 (redaktsioon 178341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178341",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKS_Par_27_v764844"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-26",
        "@type": "xsd:date"
      }
    },
