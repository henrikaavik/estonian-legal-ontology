      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Testament on ühepoolne tehing, millega pärandaja (testaator) teeb oma surma puhuks pärandi kohta korraldusi. (2) Testamendi teeb testaator isiklikult.",
      "rdfs:label": {
        "@value": "Primisseadus_Par_19 (redaktsioon 22355)",
        "@language": "et"
      },
