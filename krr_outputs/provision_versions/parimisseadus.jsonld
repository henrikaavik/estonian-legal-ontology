      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Primisseadus_Par_158_v925392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Primisseadus_Par_158"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärimisregistrisse kantakse andmed testamentide ja pärimislepingute kohta. [Lõike 2 sõnastus kuni 31. 12. 2005] (2) Pärimisregistri pidaja on Tallinna Linnakohus. [Lõike 2 sõnastus alates 1. 01. 2006] (2) Pärimisregistri pidaja on Harju Maakohus. (3) Justiitsministril on õigus anda määrusi pärimisregistri pidamise korra kohta. (4) Pärimisregistrile ja selle pidamisele ei kohaldata andmekogude seadust (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155; 2000, 57, 373; 92, 597; 2001, 7, 17; 17, 77), kui käesolevast seadusest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "Primisseadus_Par_158 (redaktsioon 925392)",
        "@language": "et"
      },
