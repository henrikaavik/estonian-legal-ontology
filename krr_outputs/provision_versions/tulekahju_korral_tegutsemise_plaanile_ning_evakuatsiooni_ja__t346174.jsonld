    {
      "@id": "estleg:Reg_346174_Par_12_v346174",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_346174_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Plaan tehakse allkirja vastu teatavaks kogu ettevõtte või asutuse töötajatele. Plaan tehakse allkirja vastu teatavaks kogu ettevõtte või asutuse töötajatele. 2(2)Skeem paigaldatakse hotellides, hostelites, motellides, külalistemajades ning varjupaikades igasse majutusruumi nähtavasse kohta. Skeem paigaldatakse hotellides, hostelites, motellides, külalistemajades ning varjupaikades igasse majutusruumi nähtavasse kohta. 3(3)Majutusruumi paigaldatud skeemile kantakse või paigaldatakse selle juurde tuleohutusmeelespea, mis sisaldab lühidalt juhiseid tulekahjust hoidumiseks või tulekahju korral tegutsemiseks. Majutusruumi paigaldatud skeemile kantakse või paigaldatakse selle juurde tuleohutusmeelespea, mis sisaldab lühidalt juhiseid tulekahjust hoidumiseks või tulekahju korral tegutsemiseks. 4(4)Skeemi paigaldatuse ühisvalduses olevates ruumides tagab ehitise valdaja. Skeemi paigaldatuse ühisvalduses olevates ruumides tagab ehitise valdaja.",
      "rdfs:label": {
        "@value": "Reg_346174_Par_12 (redaktsioon 346174)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "346174",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/346174",
      "estleg:sourceAct": "Tulekahju korral tegutsemise plaanile ning evakuatsiooni ja tulekahju korral tegutsemise õppuse korraldamisele esitatavad nõuded",
      "estleg:provisionRef": "Reg_346174 § 12",
      "estleg:partOfAct": {
