      }
    },
    {
      "@id": "estleg:RKKS_Par_81_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKKS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hääletamiseks kasutatakse elektroonilist hääletussüsteemi. (2) Vabariigi Presidendi ning Riigikogu esimehe ja aseesimeeste valimistel hääletatakse hääletamissedelitega. (3) Kui elektroonilist hääletussüsteemi ei ole võimalik kasutada, hääletatakse käe tõstmisega, või kui käesolev seadus näeb ette salajase hääletamise, hääletamissedelitega.",
      "rdfs:label": {
        "@value": "RKKS_Par_81 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKKS_Par_81_v102062020009"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKKS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:RKKS_Map_2026"
      }
    },
    {
      "@id": "estleg:RKKS_Par_81_v102062020009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKKS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hääletamiseks kasutatakse elektroonilist hääletussüsteemi. (2) Vabariigi Presidendi ning Riigikogu esimehe ja aseesimeeste valimistel hääletatakse hääletamissedelitega. (3) Kui elektroonilist hääletussüsteemi ei ole võimalik kasutada, hääletatakse käe tõstmisega, või kui käesolev seadus näeb ette salajase hääletamise, hääletamissedelitega. (4) Kui Riigikogu kaugosalusega istungil ei ole võimalik hääletada elektroonilise hääletussüsteemiga ega käe tõstmisega, võib hääletada muul istungi juhataja heakskiidetud viisil.",
      "rdfs:label": {
        "@value": "RKKS_Par_81 (redaktsioon 102062020009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102062020009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102062020009",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKKS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:RKKS_Map_2026"
      }
    },
    {
      "@id": "estleg:RKKS_Par_82_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKKS_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 81 lõikes 2 ettenähtud juhtudel korraldab hääletamist, selgitab valimistulemused ning lahendab protestid Vabariigi Valimiskomisjon. (2) Käesoleva seaduse § 81 lõikes 3 ettenähtud juhtudel korraldab hääletamist, selgitab hääletamistulemused ning lahendab protestid hääletamiskomisjon, mille koosseisu kuulub üks esindaja igast Riigikogu fraktsioonist.",
      "rdfs:label": {
        "@value": "RKKS_Par_82 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKKS_Par_82_v102062020009"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKKS § 82",
      "estleg:partOfAct": {
        "@id": "estleg:RKKS_Map_2026"
      }
    },
    {
      "@id": "estleg:RKKS_Par_82_v102062020009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKKS_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 81 lõikes 2 ettenähtud juhtudel korraldab hääletamist, selgitab valimistulemused ning lahendab protestid Vabariigi Valimiskomisjon. (2) Käesoleva seaduse § 81 lõigetes 3 ja 4 ettenähtud juhtudel korraldab hääletamist, selgitab hääletamistulemused ning lahendab protestid hääletamiskomisjon, mille koosseisu kuulub üks esindaja igast Riigikogu fraktsioonist.",
      "rdfs:label": {
        "@value": "RKKS_Par_82 (redaktsioon 102062020009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102062020009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102062020009",
