        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liige hääletab isiklikult.",
      "rdfs:label": {
        "@value": "RKKS_Par_80 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
