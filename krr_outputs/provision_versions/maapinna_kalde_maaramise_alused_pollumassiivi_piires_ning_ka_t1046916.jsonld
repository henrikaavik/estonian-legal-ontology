        "@value": "Sätete redaktsioonid: Maapinna kalde määramise alused põllumassiivi piires ning kaldega ala väetamise erandid (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Maapinna kalde määramise alused põllumassiivi piires ning kaldega ala väetamise erandid"
    },
    {
      "@id": "estleg:Reg_1046916_Par_1_v1046916",
      "@type": [
