      "estleg:sourceAct": "Maapinna kalde määramise alused põllumassiivi piires ning kaldega ala väetamise erandid",
      "estleg:provisionRef": "Reg_1046916 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046916_Map_2026"
      }
    },
