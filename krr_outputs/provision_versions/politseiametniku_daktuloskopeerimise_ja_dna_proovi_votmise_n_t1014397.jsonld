      "estleg:provisionRef": "Reg_1014397 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014397_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1014397_Par_3_v1014397",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014397_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sõrmejälgede kaardile võetud andmed edastatakse 30 päeva jooksul politseiametniku daktüloskopeerimisest arvates riikliku sõrmejälgede registri volitatud töötlejale, kes kannab need riiklikku sõrmejälgede registrisse ja automaatse biomeetrilise isikutuvastuse süsteemi andmekogusse. RT I 2022-08-26 1 126082022001 2022-08-29 Sõrmejälgede kaardile võetud andmed edastatakse 30 päeva jooksul politseiametniku daktüloskopeerimisest arvates riikliku sõrmejälgede registri volitatud töötlejale, kes kannab need riiklikku sõrmejälgede registrisse ja automaatse biomeetrilise isikutuvastuse süsteemi andmekogusse. 2 (2) Daktüloskopeerimisel saadud biomeetrilised andmed kantakse automaatse biomeetrilise isikutuvastuse süsteemi andmekogusse ning politseiametniku biograafilised andmed ja andmed daktüloskoopiaandmete võtmise kohta riiklikku sõrmejälgede registrisse. RT I 2022-08-26 1 126082022001 2022-08-29 Daktüloskopeerimisel saadud biomeetrilised andmed kantakse automaatse biomeetrilise isikutuvastuse süsteemi andmekogusse ning politseiametniku biograafilised andmed ja andmed daktüloskoopiaandmete võtmise kohta riiklikku sõrmejälgede registrisse.",
      "rdfs:label": {
        "@value": "Reg_1014397_Par_3 (redaktsioon 1014397)",
        "@language": "et"
      },
