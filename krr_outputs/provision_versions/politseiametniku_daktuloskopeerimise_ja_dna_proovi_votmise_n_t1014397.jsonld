      "estleg:provisionRef": "Reg_1014397 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014397_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1014397_Par_6_v1014397",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014397_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Politseiametniku daktüloskopeerimisel ja DNA-proovi analüüsil saadud andmed kustutatakse riiklikest registritest kolme aasta möödumisel politseiametniku politseiteenistusest vabastamisest arvates. RT I 2015-04-17 2 117042015002 2015-04-20 , rakendatakse alates 29.03.2015 Politseiametniku daktüloskopeerimisel ja DNA-proovi analüüsil saadud andmed kustutatakse riiklikest registritest kolme aasta möödumisel politseiametniku politseiteenistusest vabastamisest arvates. , rakendatakse alates 29.03.2015 2 (2) Politsei- ja Piirivalveamet ja Kaitsepolitseiamet teavitab 30 päeva jooksul politseiametniku politseiteenistusest vabastamisest arvates Eesti Kohtuekspertiisi Instituuti vajadusest kustutada politseiametniku andmed riiklikest registritest. RT I 2017-10-10 4 110102017004 2017-10-13 , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal Politsei- ja Piirivalveamet ja Kaitsepolitseiamet teavitab 30 päeva jooksul politseiametniku politseiteenistusest vabastamisest arvates Eesti Kohtuekspertiisi Instituuti vajadusest kustutada politseiametniku andmed riiklikest registritest. , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal",
      "rdfs:label": {
        "@value": "Reg_1014397_Par_6 (redaktsioon 1014397)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014397",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014397",
