      "estleg:provisionRef": "Reg_1014397 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014397_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1014397_Par_5_v1014397",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014397_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pakendatud DNA-proovi käideldakse, säilitatakse ja edastatakse viisil, mis tagab selle säilimise ja välistab kõrvaliste isikute juurdepääsu proovile ning selle kontamineerumise ja degradatsiooni. RT I 2017-10-10 4 110102017004 2017-10-13 , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal Pakendatud DNA-proovi käideldakse, säilitatakse ja edastatakse viisil, mis tagab selle säilimise ja välistab kõrvaliste isikute juurdepääsu proovile ning selle kontamineerumise ja degradatsiooni. , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal 2 (2) Vahendite soetamisel tuleb järgida riikliku DNA-registri volitatud töötleja kirjalikke soovitusi ja nõudeid. Vahendite soetamisel tuleb järgida riikliku DNA-registri volitatud töötleja kirjalikke soovitusi ja nõudeid. 3 (3) Kehtetu - RT I 2017-10-10 4 110102017004 2017-10-13 , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal Kehtetu - , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal 4 (4) Pakendatud proov koos DNA-proovi võtmise vormi ja sellele lisatud kaaskirjaga edastatakse riikliku DNA-registri volitatud töötlejale riiklikku DNA-registrisse kandmiseks hiljemalt 30 päeva jooksul proovi võtmisest. Pakendatud proov koos DNA-proovi võtmise vormi ja sellele lisatud kaaskirjaga edastatakse riikliku DNA-registri volitatud töötlejale riiklikku DNA-registrisse kandmiseks hiljemalt 30 päeva jooksul proovi võtmisest.",
      "rdfs:label": {
        "@value": "Reg_1014397_Par_5 (redaktsioon 1014397)",
        "@language": "et"
      },
