  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_pollumajanduse_registrite_ja_informatsiooni_ameti_pohimaarus_t159866_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus (34 versiooni)",
        "@language": "et"
      },
      "dc:source": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus"
    },
    {
      "@id": "estleg:Reg_159866_Par_1_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajanduse Registrite ja Informatsiooni Amet (edaspidi amet), lühendatult PRIA, on Regionaal- ja Põllumajandusministeeriumi (edaspidi ministeerium) valitsemisalas tegutsev valitsusasutus, kellel on juhtimisfunktsioon ning kes menetleb toetuse taotlusi, teostab riiklikku või haldusjärelevalvet ning teeb tegevus- või muu loa andmise menetlemise käigus nõuetekohasuse kontrolli, kohaldab riiklikku sundi Euroopa Liidu ühise põllumajanduspoliitika abinõude, maaelu ja põllumajandusturu korraldamise riiklike abinõude ning kalandusturu korraldamise abinõude rakendamisel seaduses ettenähtud alustel ja ulatuses, samuti tegeleb seadusega ettenähtud põllumajandusega seotud riiklike registrite ja muude andmekogude pidamisega, nende andmete töötlemise ja analüüsimisega.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_1 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_10_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametit juhib peadirektor, kelle nimetab ametisse ja vabastab ametist minister kantsleri ettepanekul.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_10 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_11_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti peadirektor: 1 1) juhib ameti tegevust kooskõlas põhimäärusega ja vastutab ametile pandud ülesannete täpse ja otstarbeka täitmise eest; 2 2) nimetab ametikohale ja vabastab ametikohalt ameti koosseisu kuuluva ametniku; RT I 2013-03-20 15 120032013015 2013-04-01 3 3) sõlmib ja lõpetab töötaja töölepingu; RT I 2013-03-20 15 120032013015 2013-04-01 4 4) kinnitab ameti asjaajamiskorra, töökorralduse, struktuuriüksuse põhimääruse, raamatupidamise sise-eeskirja ja ametikoha ametijuhendi; RT I 2013-03-20 15 120032013015 2013-04-01 5 5) määrab ametnikule distsiplinaarkaristuse õigusaktidega ettenähtud alustel ja korras; RT I 2013-03-20 15 120032013015 2013-04-01 6 6) käsutab kooskõlas riigivaraseaduse ja selle alusel antud õigusaktidega ameti valduses olevat riigivara, ameti rahalisi vahendeid, Euroopa Liidu ühise põllumajanduspoliitika abinõudena, maaelu ja põllumajandusturu korraldamise riiklike abinõudena ning kalandusturu korraldamise abinõudena antavaid toetusi ning teisi tema kaudu jagatavaid vahendeid, tagades nende sihipärase ja otstarbeka kasutamise; RT I 2014-11-26 3 126112014003 2014-11-29 7 7) teostab oma pädevuse piires riigihankeid; 8 8) annab seaduse, Vabariigi Valitsuse määruse või korralduse või ministri määruse või käskkirja alusel käskkirju teenistusalastes küsimustes; 9 9) sõlmib lepinguid ja esindab ametit teistes tsiviilõiguslikes suhetes ning annab volitusi ameti esindamiseks; 10 10) vastutab ameti tegevust korraldavate õigusaktide täpse ja otstarbeka täitmise eest ning annab aru ministrile; RT I 2014-08-19 10 119082014010 2014-08-22 11 11) moodustab vajaduse korral ameti tegevusvaldkonnas nõuandva õigusega alalise või ajutise komisjoni, nõukogu või töörühma ning määrab nende ülesanded ja töökorra. RTL 2008 38 544 12960811 2008-05-19 12 12) kinnitab ameti iga-aastase riskide hindamise läbiviimise korra; RTL 2009 9 113 13124110 2009-02-01+02:00 13 13) tagab sisekontrollisüsteemi rakendamise ja siseaudiitori kutsetegevuse korraldamise. RT I 2013-06-12 1 112062013001 2013-07-01 Ameti peadirektor: juhib ameti tegevust kooskõlas põhimäärusega ja vastutab ametile pandud ülesannete täpse ja otstarbeka täitmise eest; nimetab ametikohale ja vabastab ametikohalt ameti koosseisu kuuluva ametniku; sõlmib ja lõpetab töötaja töölepingu; kinnitab ameti asjaajamiskorra, töökorralduse, struktuuriüksuse põhimääruse, raamatupidamise sise-eeskirja ja ametikoha ametijuhendi; määrab ametnikule distsiplinaarkaristuse õigusaktidega ettenähtud alustel ja korras; käsutab kooskõlas riigivaraseaduse ja selle alusel antud õigusaktidega ameti valduses olevat riigivara, ameti rahalisi vahendeid, Euroopa Liidu ühise põllumajanduspoliitika abinõudena, maaelu ja põllumajandusturu korraldamise riiklike abinõudena ning kalandusturu korraldamise abinõudena antavaid toetusi ning teisi tema kaudu jagatavaid vahendeid, tagades nende sihipärase ja otstarbeka kasutamise; teostab oma pädevuse piires riigihankeid; annab seaduse, Vabariigi Valitsuse määruse või korralduse või ministri määruse või käskkirja alusel käskkirju teenistusalastes küsimustes; sõlmib lepinguid ja esindab ametit teistes tsiviilõiguslikes suhetes ning annab volitusi ameti esindamiseks; vastutab ameti tegevust korraldavate õigusaktide täpse ja otstarbeka täitmise eest ning annab aru ministrile; moodustab vajaduse korral ameti tegevusvaldkonnas nõuandva õigusega alalise või ajutise komisjoni, nõukogu või töörühma ning määrab nende ülesanded ja töökorra. kinnitab ameti iga-aastase riskide hindamise läbiviimise korra; tagab sisekontrollisüsteemi rakendamise ja siseaudiitori kutsetegevuse korraldamise.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_11 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_11_11_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_11_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Peadirektori asetäitja eelkõige juhib ja korraldab oma juhitavas valdkonnas vahetult või struktuuriüksuse juhi kaudu temale alluva struktuuriüksuse tööd ning osaleb ameti tegevusvaldkonnaga seotud õigusakti või haldusakti eelnõu, poliitika strateegia, arengukava või rahvusvahelise arengudokumendi väljatöötamisel ning vastutab nende elluviimise eest oma juhitavas valdkonnas.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_11_11 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 11_11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_12_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Peadirektori äraolekul asendab teda peadirektori poolt määratud peadirektori asetäitja, viimase äraolekul peadirektori poolt määratud ametnik. Peadirektori asetäitja teenistusülesanded, õigused ja vastutus määratakse peadirektori käskkirjaga kehtestatud ametijuhendis. Peadirektori asetäitjate arv määratakse kindlaks ameti teenistuskohtade koosseisus.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_12 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_13_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti struktuuriüksused on keskus ja osakond, kellel puuduvad täitevvõimu volitused ametiväliste isikute suhtes, kui seaduses ei ole sätestatud teisiti. Ameti struktuuri võib kuuluda väljaspool struktuuriüksust asuv teenistuskoht. Väljaspool struktuuriüksust asuva ameti- või töökoha puhul nimetab ametikohale ja vabastab ametikohalt ametniku ning sõlmib ja lõpetab töötajaga töölepingu peadirektor, kes kehtestab ka ametniku või töötaja ametijuhendi. Väljaspool struktuuriüksust asuval teenistuskohal olev ametnik või töötaja allub vastavalt oma ametijuhendile või töölepingule vahetult kas peadirektorile, peadirektori asetäitjale või osakonnajuhatajale ja täidab oma ametijuhendis või töölepingus ettenähtud ülesandeid. Väljaspool struktuuriüksust asuval teenistuskohal oleva ametniku või töötaja ülesanded, alluvus, õigused ja vastutus määratakse peadirektori käskkirjaga kehtestatud ametijuhendis.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_13 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_13_14_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_13_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskust juhib peadirektor või peadirektori asetäitja. Keskuse ülesanded ja juhtimine sätestatakse keskuse põhimäärusega, mille kinnitab peadirektor oma käskkirjaga, arvestades seejuures Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse §-s 4 nimetatud makseasutuse akrediteerimistingimustega.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_13_14 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 13_14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_13_15_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_13_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskuse koosseisu võib kuuluda osakond.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_13_15 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 13_15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_14_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osakonda juhib osakonnajuhataja, kes vastutab osakonnale pandud ülesannete õiguspärase, täpse ja õigeaegse täitmise eest. Osakonnajuhataja äraolekul asendab teda peadirektori poolt käskkirjaga määratud ametnik.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_14 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_15_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osakonna ülesanded ja juhtimine ning osakonnajuhataja asendamine sätestatakse osakonna põhimäärusega, mille kinnitab ameti peadirektor oma käskkirjaga.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_15 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_16_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osakonna koosseisus võivad olla bürood, mille ülesanded ja juhtimine sätestatakse osakonna põhimäärusega. Bürood juhib büroojuhataja.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_16 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_16_19_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_16_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Peadirektorile vahetult alluvate osakondade põhiülesanded on: 1 1) kehtetu - RT I 2025-06-05 4 105062025004 2025-10-01 2 2) teostada ameti siseauditit; 3 3) koordineerida ja korraldada ameti infoturvet, andmekaitset ja riskihaldust; 4 4) ennetada, tõkestada, avastada ja menetleda teenistuskohustuste rikkumist; 5 5) anda ametis õigusnõu ja korraldada ameti õigushuvide esindamist; 6 6) osaleda ameti tegevusvaldkonnaga seotud õigusaktide eelnõude väljatöötamisel; 7 7) kaitsta Euroopa Liidu ja Eesti finantshuve; 8 8) nõustada riigihangete läbiviimisel; 9 9) kehtetu - RT I 2025-06-05 4 105062025004 2025-10-01 10 10) teostada riiklikku järelevalvet toetuste sihipärase kasutamise üle. RT I 2025-06-05 4 105062025004 2025-10-01 Peadirektorile vahetult alluvate osakondade põhiülesanded on: kehtetu - teostada ameti siseauditit; koordineerida ja korraldada ameti infoturvet, andmekaitset ja riskihaldust; ennetada, tõkestada, avastada ja menetleda teenistuskohustuste rikkumist; anda ametis õigusnõu ja korraldada ameti õigushuvide esindamist; osaleda ameti tegevusvaldkonnaga seotud õigusaktide eelnõude väljatöötamisel; kaitsta Euroopa Liidu ja Eesti finantshuve; nõustada riigihangete läbiviimisel; kehtetu - teostada riiklikku järelevalvet toetuste sihipärase kasutamise üle.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_16_19 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 16_19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_17_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti keskused on: 1 1) teabe- ja registrite keskus, mille põhiülesanne on korraldada ameti andmeanalüüsi alast tööd, väärindada andmeid, koordineerida teabeteenuste arendust ja määrata kindlaks ameti andmearhitektuur, korraldada kokkulepitud infotehnoloogia teenuseid, sealhulgas täita andmekogu pidamisega seotud ülesandeid, tagada andmete kättesaadavus seatud eesmärkide täitmiseks ning andmepõhiste teenuste pakkumiseks; RT I 2025-06-05 4 105062025004 2025-10-01 2 2) kehtetu - RT I 2025-06-05 4 105062025004 2025-10-01 3 3) toetuste keskus, mille põhiülesanne on korraldada toetuste andmist, sealhulgas korraldada toetuste taotluste vastuvõtmist, kontrollida taotleja ja taotluse vastavust toetuse saamise nõuetele, hinnata esitatud taotlusi ning töödelda põllumajandustoetuste ja põllumassiivide registrisse kantud toetuse andmise ja abinõude rakendamisega seotud andmeid; RT I 2025-06-05 4 105062025004 2025-10-01 4 4) strateegia ja kliendisuhete keskus, mille põhiülesanne on korraldada ameti strateegilist planeerimist, finantsplaneerimist ja -juhtimisarvestust, kvaliteedijuhtimist, personalijuhtimist ja -teenust, ameti sise- ja väliskommunikatsiooni, kliendihaldust ning kliendikogemuse juhtimist, haldusteenuse ja finantsarvestuse pakkumist. RT I 2025-06-05 4 105062025004 2025-10-01 Ameti keskused on: teabe- ja registrite keskus, mille põhiülesanne on korraldada ameti andmeanalüüsi alast tööd, väärindada andmeid, koordineerida teabeteenuste arendust ja määrata kindlaks ameti andmearhitektuur, korraldada kokkulepitud infotehnoloogia teenuseid, sealhulgas täita andmekogu pidamisega seotud ülesandeid, tagada andmete kättesaadavus seatud eesmärkide täitmiseks ning andmepõhiste teenuste pakkumiseks; kehtetu - toetuste keskus, mille põhiülesanne on korraldada toetuste andmist, sealhulgas korraldada toetuste taotluste vastuvõtmist, kontrollida taotleja ja taotluse vastavust toetuse saamise nõuetele, hinnata esitatud taotlusi ning töödelda põllumajandustoetuste ja põllumassiivide registrisse kantud toetuse andmise ja abinõude rakendamisega seotud andmeid; strateegia ja kliendisuhete keskus, mille põhiülesanne on korraldada ameti strateegilist planeerimist, finantsplaneerimist ja -juhtimisarvestust, kvaliteedijuhtimist, personalijuhtimist ja -teenust, ameti sise- ja väliskommunikatsiooni, kliendihaldust ning kliendikogemuse juhtimist, haldusteenuse ja finantsarvestuse pakkumist.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_17 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_18_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet on riigivara valitsema volitatud asutus, mis valdab, kasutab ja käsutab riigivara «Riigivaraseaduses» ja selle alusel kehtestatud õigusaktides sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_18 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_19_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti kulud kaetakse riigieelarvest. Ametil on oma eelarve ja pangaarve.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_19 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_2_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Oma ülesannete täitmisel esindab amet riiki.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_2 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_20_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet korraldab oma finantsarvestust ja aruandlust seadusega kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_20 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_21_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet esitab rahaliste vahendite kasutamise aruandeid ja ülevaateid oma tegevusest ministeeriumile viimase poolt kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_21 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_22_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti tegevust kontrollivad ministeerium, Riigikontroll ja teised selleks volitatud asutused.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_22 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_23_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametil on sõõrikujuline 35 mm läbimõõduga pitsat, mille keskel on riigivapi kujutis. Sõõri ülemist äärt mööda on sõnad «Põllumajanduse Registrite ja Informatsiooni Amet». Ameti osakonnal võib olla oma nimega pitsat, kui see on ette nähtud osakonna põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_23 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_24_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti dokumendiplankidel kasutatakse kujundus- ja turvaelemendina väikese riigivapi kujutist. Dokumendiplangi kasutamise kord sätestatakse ameti asjaajamiskorras.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_24 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_25_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti kirjaplangile vormistatud dokumendile kirjutab oma pädevuse piires alla peadirektor, peadirektori asetäitja või osakonnajuhataja.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_25 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_26_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet kasutab riigilippu vastavalt seadusele.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_26 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_27_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_159866_Par_27 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_28_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_159866_Par_28 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_29_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti tegevuse korraldab ümber või lõpetab ministeerium seadusega kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_29 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_3_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet on aruandekohustuslik valdkonna eest vastutava ministri (edaspidi minister) ees, kes suunab ja koordineerib tema tegevust ning teostab tema tegevuse üle teenistuslikku järelevalvet. Ameti tegevust võib koordineerida ministeeriumi kantsler.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_3 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_30_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Reg_159866_Par_30 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_4_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametil on väikese riigivapi kujutise ja oma nimega pitsat, eelarve ning pangaarve.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_4 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_5_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet asub Tartus. Ameti postiaadress on Tähe 4, Tartu, 51010 Tartumaa. Ameti mujal asuva struktuuriüksuse asukoht märgitakse struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_5 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_6_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti tegevusvaldkond on Euroopa Liidu ühise põllumajanduspoliitika abinõude, maaelu ja põllumajandusturu korraldamise riiklike abinõude ning kalandusturu korraldamise abinõude rakendamise korraldamine, seadusega ettenähtud põllumajandusega seotud riiklike registrite ja muude andmekogude pidamine, nende andmete töötlemine ja analüüsimine.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_6 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_7_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet: 1 1) kogub ja töötleb Euroopa Liidu ühise põllumajanduspoliitika abinõudes, maaelu ja põllumajandusturu korraldamise riiklikes abinõudes ning kalandusturu korraldamise abinõudes osalemiseks esitatud taotlustes sisalduvaid andmeid oma pädevuse piires, valib projekte ning korraldab toetuste andmist; RT I 2014-11-26 3 126112014003 2014-11-29 2 2) koostab aruandeid antud toetustest; 3 3) korraldab oma pädevuse piires toetuste väljamaksmist; 4 4) peab arvet finantskohustuste ja väljamaksete üle; 5 5) teostab sisekontrolli (auditi) ameti toimingute üle; 6 6) kogub ja töötleb ministeeriumi esitatud põllumajanduslikke andmeid, on riiklike registrite volitatud töötleja, asutab ja peab muid ameti seaduse või muu õigusaktiga pandud ülesannete täitmiseks või töö korraldamise tagamiseks vajalikke andmekogusid; RT I 2014-08-19 10 119082014010 2014-08-22 7 7) korraldab ameti andmekogu kooskõlastatuse ministeeriumi valitsemisalas asuvate teiste riigiasutuste riiklike registrite ning muude andmekogudega; 8 8) kindlustab kooskõlastatuse riigi põhiregistrite, samuti teiste riiklike registritega; 9 9) loob suhtlussüsteemid registrite kasutajatega; 10 10) kehtetu - RT I 2025-06-05 4 105062025004 2025-10-01 11 11) õigusaktidest lähtuvalt viib ellu põllumajandust, maaelu ja kalamajandust käsitlevaid programme; RTL 2008 24 367 12941193 2008-04-01 12 12) koostab ja annab välja teabematerjale; 13 13) juhib ameti kaudu teostatavaid välisabiprojekte; 13 13¹) täidab \"Hädaolukorraks valmisoleku seaduse\" alusel ministeeriumi määratud kriisireguleerimisülesandeid; RT I 2014-08-19 10 119082014010 2014-08-22 14 14) täidab teisi seaduse või muu õigusaktiga antud või ministri poolt temale pandud ülesandeid. RT I 2014-08-19 10 119082014010 2014-08-22 Amet: kogub ja töötleb Euroopa Liidu ühise põllumajanduspoliitika abinõudes, maaelu ja põllumajandusturu korraldamise riiklikes abinõudes ning kalandusturu korraldamise abinõudes osalemiseks esitatud taotlustes sisalduvaid andmeid oma pädevuse piires, valib projekte ning korraldab toetuste andmist; koostab aruandeid antud toetustest; korraldab oma pädevuse piires toetuste väljamaksmist; peab arvet finantskohustuste ja väljamaksete üle; teostab sisekontrolli (auditi) ameti toimingute üle; kogub ja töötleb ministeeriumi esitatud põllumajanduslikke andmeid, on riiklike registrite volitatud töötleja, asutab ja peab muid ameti seaduse või muu õigusaktiga pandud ülesannete täitmiseks või töö korraldamise tagamiseks vajalikke andmekogusid; korraldab ameti andmekogu kooskõlastatuse ministeeriumi valitsemisalas asuvate teiste riigiasutuste riiklike registrite ning muude andmekogudega; kindlustab kooskõlastatuse riigi põhiregistrite, samuti teiste riiklike registritega; loob suhtlussüsteemid registrite kasutajatega; kehtetu - õigusaktidest lähtuvalt viib ellu põllumajandust, maaelu ja kalamajandust käsitlevaid programme; koostab ja annab välja teabematerjale; juhib ameti kaudu teostatavaid välisabiprojekte; täidab \"Hädaolukorraks valmisoleku seaduse\" alusel ministeeriumi määratud kriisireguleerimisülesandeid; täidab teisi seaduse või muu õigusaktiga antud või ministri poolt temale pandud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_7 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_8_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet korraldab koolitust, täienduskoolitust ja nõustamist oma tegevusvaldkonnas.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_8 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
    {
      "@id": "estleg:Reg_159866_Par_9_v159866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159866_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametil on temale pandud ülesannete täitmiseks õigus: 1 1) saada kehtestatud korras vajalikku teavet riigiasutustelt, kohaliku omavalitsuse asutustelt, juriidilistelt ja füüsilistelt isikutelt; 2 2) pidada läbirääkimisi ning sõlmida kokkuleppeid ja lepinguid juriidiliste ning füüsiliste isikutega; 3 3) teha ministrile ettepanekuid õigusaktide ettevalmistamiseks ja muutmiseks oma tegevusvaldkonnas; RT I 2014-08-19 10 119082014010 2014-08-22 4 4) luua sidemeid ja arendada koostööd riigiasutuste, kohaliku omavalitsuse asutuste ja juriidiliste isikutega, välisriikide samasuguseid ülesandeid täitvate institutsioonidega; 5 5) esitada ministeeriumile kehtestatud korras ettepanekuid oma eelarve koostamiseks; RT I 2014-08-19 10 119082014010 2014-08-22 6 6) kasutada ja hallata riigivara lähtudes «Riigivaraseadusest» ja teistest õigusaktidest; 7 7) esindada riiki riiklike ja Euroopa Liidu toetuste andmisel. Ametil on temale pandud ülesannete täitmiseks õigus: saada kehtestatud korras vajalikku teavet riigiasutustelt, kohaliku omavalitsuse asutustelt, juriidilistelt ja füüsilistelt isikutelt; pidada läbirääkimisi ning sõlmida kokkuleppeid ja lepinguid juriidiliste ning füüsiliste isikutega; teha ministrile ettepanekuid õigusaktide ettevalmistamiseks ja muutmiseks oma tegevusvaldkonnas; luua sidemeid ja arendada koostööd riigiasutuste, kohaliku omavalitsuse asutuste ja juriidiliste isikutega, välisriikide samasuguseid ülesandeid täitvate institutsioonidega; esitada ministeeriumile kehtestatud korras ettepanekuid oma eelarve koostamiseks; kasutada ja hallata riigivara lähtudes «Riigivaraseadusest» ja teistest õigusaktidest; esindada riiki riiklike ja Euroopa Liidu toetuste andmisel.",
      "rdfs:label": {
        "@value": "Reg_159866_Par_9 (redaktsioon 159866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159866",
      "estleg:sourceAct": "Põllumajanduse Registrite ja Informatsiooni Ameti põhimäärus",
      "estleg:provisionRef": "Reg_159866 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159866_Map"
      }
    },
