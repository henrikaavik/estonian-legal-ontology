        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_127_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": ". Ametiriietuse kandmise kohustuse korral antakse ametiriietus kohtuteenistujale tasuta.",
      "rdfs:label": {
        "@value": "KS_Par_127_1 (redaktsioon 13153856)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13153856",
