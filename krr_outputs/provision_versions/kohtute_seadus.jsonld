      }
    },
    {
      "@id": "estleg:KS_Par_22_v22213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnakohus jaguneb arutatavate asjade liikide järgi kolleegiumideks. Kolleegiumid, samuti igasse kolleegiumi kuuluvate kohtunike arvu ja kohtunikud ning kolleegiumi esimehe määrab Riigikohus. (2) Ringkonnakohtu esimehe äraolekul asendab teda ameti poolest vanim kohalolev kolleegiumi esimees, kolleegiumi esimehe äraolekul aga ameti poolest vanim kohalolev sama kolleegiumi liige, kui nimetatud esimehed ei ole oma äraoleku ajaks määranud kohusetäitjaid.",
      "rdfs:label": {
        "@value": "KS_Par_22 (redaktsioon 22213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22213",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_22_v181957"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22213",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_22_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnakohus on teise astme kohus, kes vaatab apellatsiooni korras läbi maa-, linna- ja halduskohtu lahendeid. (2) Ringkonnakohtud on Tallinna Ringkonnakohus, Tartu Ringkonnakohus ja Viru Ringkonnakohus. (3) Tallinna Ringkonnakohtu tööpiirkonnas on Harju Maakohus, Järva Maakohus, Lääne Maakohus, Pärnu Maakohus, Rapla Maakohus, Saare Maakohus ja Tallinna Linnakohus ning Tallinna Halduskohus ja Pärnu Halduskohus. (4) Tartu Ringkonnakohtu tööpiirkonnas on Jõgeva Maakohus, Põlva Maakohus, Tartu Maakohus, Valga Maakohus, Viljandi Maakohus ja Võru Maakohus ning Tartu Halduskohus ja Jõhvi Halduskohus. (5) Viru Ringkonnakohtu tööpiirkonnas on Ida-Viru Maakohus, Lääne-Viru Maakohus ja Narva Linnakohus. (6) Tallinna Ringkonnakohus asub Tallinnas, Tartu Ringkonnakohus Tartus ja Viru Ringkonnakohus Jõhvis. Ringkonnakohtu täpse asukoha määrab justiitsminister. (7) Ringkonnakohtu struktuuri ja kohtuteenistujate koosseisu kinnitab haldusdirektor, välja arvatud õigusemõistmise funktsiooni teostamisega seotud osas. Selles osas kinnitab struktuuri ja kohtuteenistujate koosseisu kohtu esimees. Struktuuri ja kohtuteenistujate koosseisu kinnitamisel lähtutakse käesoleva seaduse §-s 43 sätestatust.",
      "rdfs:label": {
        "@value": "KS_Par_22 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_22_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_22_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_22"
      },
      "estleg:versionValidFrom": {
