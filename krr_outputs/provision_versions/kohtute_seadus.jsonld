      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkursikomisjon lõpetab otsusega kohtunikuabi ettevalmistuskava täitmise: ebarahuldavate tulemuste tõttu; kui kohtunikuabi ettevalmistuskava täitja paneb toime vääritu teo; kui kohtunikuabi ettevalmistuskava täitja suhtes jõustub süüdimõistev kohtuotsus kriminaalasjas.",
      "rdfs:label": {
        "@value": "KS_Par_117_4 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_117_4_v111032023019"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
