      "estleg:provisionRef": "KS § 137_4",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_137_5_v111032023019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_137_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 584 kohaldatakse ka nendele kohtunikele, kes 2023. aasta 1. mail töötavad riigi ametiasutuses, avalik-õiguslikus ülikoolis, rahvusvahelises organisatsioonis, rahvusvahelises kohtuinstitutsioonis või Euroopa Prokuratuuris.",
      "rdfs:label": {
        "@value": "KS_Par_137_5 (redaktsioon 111032023019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023019",
