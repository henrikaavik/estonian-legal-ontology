      }
    },
    {
      "@id": "estleg:KS_Par_108_v111032023019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvakohtunikukandidaatide seast nimetab rahvakohtuniku ametisse kohtu juures asuv rahvakohtunike nimetamise komisjon, mille koosseisu kinnitab kohtu esimees. (2) Rahvakohtunike nimetamise komisjoni kuuluvad maakohtu esimees ja kohtu üldkogu valitud kohtunik. Komisjoni esimeheks on kohtu esimees. (3) Komisjon on otsustusvõimeline, kui kohal on üle poole komisjoni liikmetest, sealhulgas komisjoni esimees. Komisjon teeb otsuse kohalolevate liikmete häälteenamusega. Kui hääled jagunevad võrdselt, on otsustav komisjoni esimehe hääl. (4) Komisjon nimetab rahvakohtunikukandidaatide seast rahvakohtunikuks selle kohtu jaoks kindlaks määratud arvu isikuid. (5) Rahvakohtunikku nimetades arvestab komisjon kandidaadi sobivust, kandidaadi kohta esitatud põhjendatud vastuväiteid ning seda, et rahvakohtunike hulgas oleks eri soost ja vanusest, erinevatest sotsiaalsetest rühmadest ning eri tegevusvaldkondades tegutsevaid isikuid.",
      "rdfs:label": {
        "@value": "KS_Par_108 (redaktsioon 111032023019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/111032023019",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 108",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_109_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvakohtunik annab kohtu üldkogu ees järgmise vande: «Tõotan jääda ustavaks Eesti Vabariigile ja tema põhiseaduslikule korrale. Tõotan mõista õigust oma südametunnistuse järgi kooskõlas Eesti Vabariigi põhiseaduse ja seadustega.»",
      "rdfs:label": {
        "@value": "KS_Par_109 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
