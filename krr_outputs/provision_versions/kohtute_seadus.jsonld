    {
      "@id": "estleg:KS_Par_132_7_v117122015048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_132_7"
