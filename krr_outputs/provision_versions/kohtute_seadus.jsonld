      }
    },
    {
      "@id": "estleg:KS_Par_115_v111032023019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_115"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabiks võib nimetada isiku, kes: vastab käesoleva seaduse § 47 lõike 1 punktides 1–3 kehtestatud nõuetele ja on sooritanud kohtunikuabi eksami. (2) Kohtunikuabiks võib nimetada ka isiku, kes on sooritanud kohtuniku- või notarieksami. (3) Kohtunikuabiks ei või nimetada käesoleva seaduse § 47 lõikes 2 nimetatud isikut.",
      "rdfs:label": {
        "@value": "KS_Par_115 (redaktsioon 111032023019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/111032023019",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 115",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_116_v181957",
      "@type": [
