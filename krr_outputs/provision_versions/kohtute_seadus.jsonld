    {
      "@id": "estleg:KS_Par_104_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_104"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvakohtunik nimetatakse neljaks aastaks. (2) Isikut ei või nimetada rahvakohtunikuks järjest rohkem kui kaheks perioodiks. (3) Rahvakohtuniku volituste tähtaja lõppemisest teatab maa- või linnakohtu esimees kohaliku omavalitsuse volikogule vähemalt neli kuud ette. (4) Kui rahvakohtuniku volitused lõpevad kohtumenetluse ajal, jätkab ta oma ülesannete täitmist kohtuasja lahendamiseni selles kohtus.",
      "rdfs:label": {
        "@value": "KS_Par_104 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
