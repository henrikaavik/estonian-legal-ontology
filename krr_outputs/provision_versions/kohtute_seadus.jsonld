    {
      "@id": "estleg:KS_Par_122_v121062014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabi ametipalga suuruse kehtestab (2) Kohtunikuabi ettevalmistuskava täitjat juhendavale kohtunikuabile makstakse juhendamise ajal lisatasu 5% ametipalgast. (3) Maakohtu maksekäsuosakonna, kinnistusosakonna ja registriosakonna juhatajale ning kinnistusosakonna ja registriosakonna piirkondliku talituse juhatajale makstakse lisatasu juhatamisega seotud kohustuste täitmise eest kuni 35% kohtunikuabi ametipalgast. (3¹) Maakohtu maksekäsuosakonna, kinnistusosakonna ja registriosakonna juhataja ning kinnistusosakonna ja registriosakonna piirkondliku talituse juhataja lisatasu kehtestab määrusega. (4) Kehtetu -",
      "rdfs:label": {
        "@value": "KS_Par_122 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_122_v120062020002"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 122",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_122_v120062020002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabi ametipalk on pool esimese astme kohtu kohtuniku ametipalgast. (2) Katseajal on kohtunikuabi ametipalk 90% kohtunikuabi ametipalgast. (3) Kohtunikuabi ettevalmistuskava täitjat juhendavale kohtunikuabile makstakse juhendamise ajal lisatasu 5% kohtunikuabi ametipalgast. (3¹) Maakohtu kinnistusosakonna, registriosakonna ja maksekäsuosakonna juhatajale makstakse lisatasu juhatamisega seotud kohustuste täitmise eest 35% kohtunikuabi ametipalgast.",
      "rdfs:label": {
        "@value": "KS_Par_122 (redaktsioon 120062020002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062020002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_122_v111032023019"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062020002",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 122",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_122_v111032023019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabi ametipalk on 65% esimese astme kohtu kohtuniku ametipalgast. (2) Katseajal on kohtunikuabi ametipalk 90% kohtunikuabi ametipalgast. (3) Kohtunikuabi katseajal juhendavale kohtunikuabile makstakse juhendamise ajal lisatasu 10% kohtunikuabi ametipalgast. (3¹) Maakohtu kinnistusosakonna, registriosakonna ja maksekäsuosakonna juhatajale makstakse lisatasu juhatamisega seotud kohustuste täitmise eest 35% kohtunikuabi ametipalgast.",
      "rdfs:label": {
        "@value": "KS_Par_122 (redaktsioon 111032023019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/111032023019",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 122",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_122_1_v111032023019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_122_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusosakonna, registriosakonna ja maksekäsuosakonna kohtunikuabi suhtes võib distsiplinaarmenetluse algatada kohtudirektor või kohtu esimees. Tsiviilosakonna, süüteoosakonna ja eestkoste järelevalve osakonna kohtunikuabi suhtes võib distsiplinaarmenetluse algatada kohtu esimees. (2) Distsiplinaarmenetluse algatamise käskkirjaga moodustatakse kohtunikuabi distsiplinaarkomisjon. Komisjoni kuuluvad vastava ringkonnakohtu esimehe nimetatud ringkonnakohtunik, distsiplinaarmenetluse algataja nimetatud kohtunikuabi ja valdkonna eest vastutava ministri määratud ametnik. (3) Distsiplinaarkomisjon viib läbi distsiplinaarmenetluse, koostab distsiplinaarmenetluse kokkuvõtte ja esitab selle kohtu esimehele otsustamiseks.",
      "rdfs:label": {
        "@value": "KS_Par_122_1 (redaktsioon 111032023019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/111032023019",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 122_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_123_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohtunikuabi vabastatakse teenistusest ametikoha koondamise tõttu, makstakse talle kohtunikuabi ametipalka kuni uuele töökohale asumiseni, kuid mitte kauem kui kuus kuud.",
      "rdfs:label": {
        "@value": "KS_Par_123 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_123_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 123",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_123_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohtunikuabi vabastatakse teenistusest ametikoha koondamise tõttu, makstakse talle hüvitisena kohtunikuabi kuue kuu ametipalk.",
      "rdfs:label": {
        "@value": "KS_Par_123 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_123_v121062014012"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928212",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 123",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_123_v121062014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KS_Par_123 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 123",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_124_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_124"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtunikuabi võib tema soovil ja kohtu esimehe nõusolekul üle viia Justiitsministeeriumi teenistusse või kohtunikuabisid ettevalmistava rakenduskõrgkooli õppejõuks. Muus osas kohaldatakse käesoleva seaduse §-s 58 sätestatut.",
      "rdfs:label": {
        "@value": "KS_Par_124 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_124_v114032025024"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
