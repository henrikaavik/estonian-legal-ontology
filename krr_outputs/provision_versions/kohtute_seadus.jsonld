      },
      "estleg:versionValidTo": {
        "@value": "2007-12-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12769841",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 122",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_122_v12895676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabi ametipalga suuruse (2) Kohtunikuabikandidaati juhendavale kohtunikuabile ja kohtunikule makstakse juhendamise ajal juhendatava eest lisatasu 5% ametipalgast. (3) Maakohtu kinnistus- või registriosakonna juhatajale makstakse lisatasu osakonna juhatamisega seotud kohustuste täitmise eest kuni 35 % kohtunikuabi ametipalgast. (4) Kohtunikuabile ei maksta avaliku teenistuse seadusest tulenevaid lisatasusid, välja arvatud lisatasu teenistusaastate eest, akadeemilise kraadi eest ja puuduva ametniku asendamise eest. Puuduva ametniku asendamise eest makstakse kohtunikuabile lisatasu puuduva ametniku ametipalga ulatuses proportsionaalselt talle pandud puuduva ametniku ülesannete hulgale.",
      "rdfs:label": {
        "@value": "KS_Par_122 (redaktsioon 12895676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895676",
