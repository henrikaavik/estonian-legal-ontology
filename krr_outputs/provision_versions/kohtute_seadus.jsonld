    {
      "@id": "estleg:KS_Par_20_1_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtu esimees nimetab kohtumajas teenistuses olevate kohtunike seast viieks aastaks kohtumaja juhi, kuulanud ära kohtumajas teenistuses olevate kohtunike arvamuse. Kohtumaja juhti ei nimetata kohtumajas, kus asub kohtu esimehe alaline teenistuskoht. (2) Kohtumaja juht korraldab kohtumaja ning halduskohtu esimehe vahelist suhtlemist ning täidab muid seadusest ja kohtu kodukorrast tulenevaid ülesandeid. (3) Kohtumaja juhi võib halduskohtu esimees enne tähtaja lõppemist vabastada: tema enda soovil; koostöö mittelaabumise tõttu halduskohtu esimehega. (4) Kohtumaja juhi äraoleku ajal võib teda asendada halduskohtu esimehe määratud kohtunik. (5) Kui kohtumaja juht vabastatakse kohtunikuametist, vabastatakse ta ka kohtumaja juhi ülesannete täitmisest. (6) Kohtumaja juhi ülesannete täitmisest vabastatud kohtunikul säilivad kohtuniku volitused.",
      "rdfs:label": {
        "@value": "KS_Par_20_1 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_20_1_v122062016022"
      },
      "estleg:versionValidTo": {
        "@value": "2016-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928212",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 20_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_20_1_v122062016022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtu esimees nimetab kohtumajas teenistuses olevate kohtunike seast seitsmeks aastaks kohtumaja juhi, kuulanud ära kohtumajas teenistuses olevate kohtunike arvamuse. Kohtumaja juhti ei nimetata kohtumajas, kus asub kohtu esimehe alaline teenistuskoht. (2) Kohtumaja juht korraldab kohtumaja ning halduskohtu esimehe vahelist suhtlemist ning täidab muid seadusest ja kohtu kodukorrast tulenevaid ülesandeid. (3) Kohtumaja juhi võib halduskohtu esimees enne tähtaja lõppemist vabastada: tema enda soovil; koostöö mittelaabumise tõttu halduskohtu esimehega. (4) Kohtumaja juhi äraoleku ajal võib teda asendada halduskohtu esimehe määratud kohtunik. (5) Kui kohtumaja juht vabastatakse kohtunikuametist, vabastatakse ta ka kohtumaja juhi ülesannete täitmisest. (6) Kohtumaja juhi ülesannete täitmisest vabastatud kohtunikul säilivad kohtuniku volitused.",
      "rdfs:label": {
        "@value": "KS_Par_20_1 (redaktsioon 122062016022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122062016022",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_20_1_v111032023019"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122062016022",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 20_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
