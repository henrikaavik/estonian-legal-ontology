      }
    },
    {
      "@id": "estleg:KS_Par_60_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuniku kohta peetakse isikutoimikut, kuhu võetakse: õigusharidust ja akadeemilist kraadi tõendava dokumendi ärakiri; kohtunikueksamikomisjoni otsus; isikutunnistuse ärakiri; kohtunikuks nimetamise otsus; distsiplinaarkolleegiumi otsused; kohtunikuametist vabastamise või tagandamise otsus. (2) Isikutoimikusse võib lisada muid kohtuniku kutsetegevust kajastavaid dokumente. (3) Maa-, linna-, haldus- ja ringkonnakohtuniku isikutoimiku pidamist korraldab justiitsminister. (4) Riigikohtuniku isikutoimiku pidamist korraldab Riigikohtu esimees.",
      "rdfs:label": {
        "@value": "KS_Par_60 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
