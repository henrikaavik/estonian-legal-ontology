    {
      "@id": "estleg:KS_Par_135_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_135"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist valitud kohtukaasistujal on volituste tähtaja lõppemiseni rahvakohtuniku pädevus.",
      "rdfs:label": {
        "@value": "KS_Par_135 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
