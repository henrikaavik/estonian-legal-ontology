    {
      "@id": "estleg:KS_Par_114_1_v111032023019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_114_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtunikuabide arvu määrab , kuulanud ära maakohtu esimehe arvamuse.",
      "rdfs:label": {
        "@value": "KS_Par_114_1 (redaktsioon 111032023019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023019",
