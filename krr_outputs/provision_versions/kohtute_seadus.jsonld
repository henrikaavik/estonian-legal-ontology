      }
    },
    {
      "@id": "estleg:KS_Par_16_1_v13260029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_16_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärnu Maakohtus on maksekäsuosakond. (2) Maksekäsuosakonnas menetletakse maksekäsu kiirmenetluse avaldusi. (3) Maksekäsuosakonna juhataja on kohtudirektori määratud kohtunikuabi. Maksekäsuosakonna koosseisu kuuluvad kohtunikuabid ja muud kohtuteenistujad.",
      "rdfs:label": {
        "@value": "KS_Par_16_1 (redaktsioon 13260029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260029",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_16_1_v120062020002"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13260029",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 16_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_16_1_v120062020002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
