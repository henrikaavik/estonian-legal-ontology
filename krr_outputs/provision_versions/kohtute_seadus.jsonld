    {
      "@id": "estleg:KS_Par_151_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_151"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogus 2002. aasta 12. juunil vastuvõetud kohtute seaduse, Eesti Panga seaduse, rahuaja riigikaitse seaduse, Riigikogu töökorra seaduse ja Riigikontrolli seaduse muutmise seaduse § 1 tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "KS_Par_151 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_151_v13261518"
      },
      "estleg:versionValidTo": {
        "@value": "2010-01-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 151",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_151_v13261518",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_151"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "ÕiendParagrahvi 41 lõike 1 punkt 9 muudetud kehtetuks vastavalt RTI, 29.12.2005, 71, 549 avaldatud kohtute seaduse, advokatuuriseaduse ja teiste seaduste muutmise seaduse § 1 punkti 14 muutmiskäsule.",
      "rdfs:label": {
        "@value": "KS_Par_151 (redaktsioon 13261518)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13261518",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_151_v120122010003"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13261518",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 151",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_151_v120122010003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_151"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "KS_Par_151 (redaktsioon 120122010003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010003",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 151",
      "estleg:partOfAct": {
