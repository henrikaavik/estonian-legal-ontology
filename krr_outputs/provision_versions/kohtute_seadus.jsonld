        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvakohtunik osaleb õigusemõistmises maa- ja linnakohtus kohtumenetluse seadustes sätestatud alustel ja korras. (2) Õigusemõistmisel on rahvakohtunikul võrdsed õigused kohtunikuga.",
      "rdfs:label": {
        "@value": "KS_Par_102 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
