    {
      "@id": "estleg:KS_Par_15_v120122010003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtus on kinnistusosakond. (2) Kinnistusosakonnas peetakse kinnistusraamatut ja abieluvararegistrit. (3) Kehtetu - (4) Kinnistusosakonna juhataja on kohtudirektori määratud kohtunikuabi. Kinnistusosakonna koosseisu kuuluvad kohtunikuabid ja muud kohtuteenistujad.",
      "rdfs:label": {
        "@value": "KS_Par_15 (redaktsioon 120122010003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010003",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_15_v123122014003"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010003",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_15_v123122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tartu Maakohtus on kinnistusosakond. Kinnistusosakonnal on piirkondlikud talitused. (2) Kinnistusosakonnas peetakse kinnistusraamatut ja abieluvararegistrit. (3) Kehtetu - (4) Kinnistusosakonna koosseisu kuuluvad kohtunikuabid ja muud kohtuteenistujad. Kohtudirektor võib määrata kinnistusosakonna juhataja ja kinnistusosakonna piirkondlike talituste juhatajad. Kinnistusosakonna juhataja ja kinnistusosakonna piirkondliku talituse juhataja määratakse kohtunikuabide seast. Kui kohtudirektor kinnistusosakonna juhatajat ei määra, peab ta määrama kinnistusosakonna piirkondliku talituse juhataja.",
      "rdfs:label": {
        "@value": "KS_Par_15 (redaktsioon 123122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014003",
