        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtunikuabikandidaadi konkursi korra ja tingimused ning konkursikomisjoni koosseisu ja töökorra kehtestab justiitsminister.",
      "rdfs:label": {
        "@value": "KS_Par_116_1 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_116_1_v120122010003"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928212",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 116_1",
      "estleg:partOfAct": {
