    {
      "@id": "estleg:KS_Par_82_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikupension arvutatakse ümber, kui muutub ametikoha palk, mille järgi kohtunikupension on arvutatud. (2) Käesoleva paragrahvi lõikes 1 nimetatud juhul arvutatakse pension ümber kohtuniku ametipalga muutumise ajast alates.",
      "rdfs:label": {
        "@value": "KS_Par_82 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
