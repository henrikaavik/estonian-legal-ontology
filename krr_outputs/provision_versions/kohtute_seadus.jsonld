        "@type": "xsd:date"
      },
      "estleg:versionText": "Maakohtu rahvakohtunike arvu määrab kooskõlastatult kohtute haldamise nõukojaga, kuulanud ära maakohtu üldkogu arvamuse.",
      "rdfs:label": {
        "@value": "KS_Par_14 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 14",
      "estleg:partOfAct": {
