        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_121_v128012021002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_121"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtunikuabi annab ametisse astudes valdkonna eest vastutava ministri ees järgmise vande:«Tõotan olla ustav Eesti Vabariigile ja tema põhiseaduslikule korrale. Tõotan täita oma ametiülesandeid südametunnistuse järgi kooskõlas Eesti Vabariigi põhiseaduse ja seadustega.»",
      "rdfs:label": {
        "@value": "KS_Par_121 (redaktsioon 128012021002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128012021002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128012021002",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 121",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_122_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabi ametipalk on riigiteenistujate palgaastmestiku kõrgeima astme palgamäära ja koefitsiendi 1,12 korrutis. (2) Kohtunikuabikandidaati juhendavale kohtunikuabile makstakse juhendamise ajal iga juhendatava eest lisatasu 5% ametipalgast.",
      "rdfs:label": {
        "@value": "KS_Par_122 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_122_v12769841"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 122",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_122_v12769841",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabi ametipalga suuruse (2) Kohtunikuabikandidaati juhendavale kohtunikuabile ja kohtunikule makstakse juhendamise ajal juhendatava eest lisatasu 5% ametipalgast. (3) Maakohtu kinnistus- või registriosakonna juhatajale makstakse lisatasu osakonna juhatamisega seotud kohustuste täitmise eest kuni 35 % kohtunikuabi ametipalgast. (4) Kohtunikuabile ei maksta avaliku teenistuse seadusest tulenevaid lisatasusid, välja arvatud lisatasu teenistusaastate eest ja akadeemilise kraadi eest.",
      "rdfs:label": {
        "@value": "KS_Par_122 (redaktsioon 12769841)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12769841",
      "estleg:supersededByVersion": {
