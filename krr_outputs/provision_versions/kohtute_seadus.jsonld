      }
    },
    {
      "@id": "estleg:KS_Par_48_v129062012053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuniku teenistusvanuse ülemmäär on 67 aastat, kui käesolevas seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KS_Par_48 (redaktsioon 129062012053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062012053",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062012053",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 48",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_49_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunik ei või väljaspool kohtunikuametit töötada mujal kui õppe- või teadustööl. Kohtunik peab oma ametivälisest töötamisest teatama kohtu esimehele. Ametivälised tööülesanded ei tohi kahjustada kohtuniku ametikohustuste täitmist ega kohtuniku sõltumatust õigusemõistmisel. (2) Kohtunik ei või olla: Riigikogu liige ega valla- või linnavolikogu liige; erakonna liige; äriühingu asutaja, juhtimisõiguslik osanik, juhatuse või nõukogu liige ega välismaa äriühingu filiaali juhataja; pankrotihaldur, pankrotitoimkonna liige ega kinnisasja sundvalitseja; vaidlevate poolte valitud vahekohtunik.",
      "rdfs:label": {
        "@value": "KS_Par_49 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_49_v740817"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 49",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_49_v740817",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunik ei või väljaspool kohtunikuametit töötada mujal kui õppe- või teadustööl. Kohtunik peab oma ametivälisest töötamisest teatama kohtu esimehele. Ametivälised tööülesanded ei tohi kahjustada kohtuniku ametikohustuste täitmist ega kohtuniku sõltumatust õigusemõistmisel. (2) Kohtunik ei või olla: Riigikogu liige ega valla- või linnavolikogu liige; [Punkti 2 sõnastus kuni 31. 12. 2007] erakonna liige; [Punkti 2 sõnastus alates 1. 01. 2008] erakonna juht-, kontroll- või revisjoniorgani liige; äriühingu asutaja, juhtimisõiguslik osanik, juhatuse või nõukogu liige ega välismaa äriühingu filiaali juhataja; pankrotihaldur, pankrotitoimkonna liige ega kinnisasja sundvalitseja; vaidlevate poolte valitud vahekohtunik.",
      "rdfs:label": {
        "@value": "KS_Par_49 (redaktsioon 740817)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740817",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_49_v12749293"
      },
      "estleg:versionValidTo": {
        "@value": "2006-11-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/740817",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 49",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_49_v12749293",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunik ei või väljaspool kohtunikuametit töötada mujal kui õppe- või teadustööl. Kohtunik peab oma ametivälisest töötamisest teatama kohtu esimehele. Ametivälised tööülesanded ei tohi kahjustada kohtuniku ametikohustuste täitmist ega kohtuniku sõltumatust õigusemõistmisel. (2) Kohtunik ei või olla: Riigikogu liige ega valla- või linnavolikogu liige; erakonna liige; äriühingu asutaja, juhtimisõiguslik osanik, juhatuse või nõukogu liige ega välismaa äriühingu filiaali juhataja; pankrotihaldur, pankrotitoimkonna liige ega kinnisasja sundvalitseja; vaidlevate poolte valitud vahekohtunik.",
      "rdfs:label": {
        "@value": "KS_Par_49 (redaktsioon 12749293)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12749293",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_49_v106112019002"
      },
      "estleg:versionValidTo": {
        "@value": "2019-11-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12749293",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 49",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_49_v106112019002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunik ei või väljaspool kohtunikuametit töötada mujal kui õppe- või teadustööl. Kohtunik võib täita ka muid kohtute seaduses sätestatud ülesandeid. Kohtunik peab oma ametivälisest töötamisest teatama kohtu esimehele. Ametivälised tööülesanded ei tohi kahjustada kohtuniku ametikohustuste täitmist ega kohtuniku sõltumatust õigusemõistmisel. (2) Kohtunik ei või olla: Riigikogu liige ega valla- või linnavolikogu liige; erakonna liige; äriühingu asutaja, juhtimisõiguslik osanik, juhatuse või nõukogu liige ega välismaa äriühingu filiaali juhataja; pankrotihaldur, pankrotitoimkonna liige ega kinnisasja sundvalitseja; vaidlevate poolte valitud vahekohtunik.",
      "rdfs:label": {
        "@value": "KS_Par_49 (redaktsioon 106112019002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106112019002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106112019002",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 49",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_5_v22213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtumenetlus toimub eesti keeles. Kohtumenetlus võib toimuda ka muus keeles, kui kohus ja asjaosalised seda valdavad. (2) Asjaosalistele isikutele, kes ei saa aru kohtumenetluse keelest, tagatakse õigus tutvuda asja materjalidega ja võtta osa kohtumenetlusest tõlgi vahendusel. Neil on õigus esineda kohtus emakeeles või oma valikul mõnes muus keeles, mida nad valdavad.",
      "rdfs:label": {
        "@value": "KS_Par_5 (redaktsioon 22213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22213",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_5_v181957"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22213",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_5_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtumenetlus ja asjaajamine kohtus toimuvad eesti keeles. (2) Muu keele kasutamine kohtumenetluses sätestatakse kohtumenetluse seadustes.",
      "rdfs:label": {
        "@value": "KS_Par_5 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_50_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maa-, linna- või halduskohtu kohtunikuks (maa-, linna- või halduskohtunikuks) võib nimetada isiku, kes on läbinud kohtuniku ettevalmistusteenistuse või on sellest vabastatud ja on sooritanud kohtunikueksami.",
      "rdfs:label": {
        "@value": "KS_Par_50 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_50_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_50_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa-, linna- või halduskohtu kohtunikuks (maa-, linna- või halduskohtunikuks) võib nimetada isiku, kes on läbinud kohtuniku ettevalmistusteenistuse või on sellest vabastatud ja on sooritanud kohtunikueksami. (2) Kohtuniku ettevalmistusteenistust ei pea olema läbinud isik, kes on vahetult enne kohtunikueksami sooritamist töötanud kaks aastat vandeadvokaadi või prokurörina, välja arvatud prokuröri abina, samuti isik, kes on varem töötanud kohtunikuna ning kelle kohtunikuametist vabastamisest ei ole möödunud rohkem kui 10 aastat.",
      "rdfs:label": {
        "@value": "KS_Par_50 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_50_v110032015015"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928212",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_50_v110032015015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa-, linna- või halduskohtu kohtunikuks (maa-, linna- või halduskohtunikuks) võib nimetada isiku, kes on läbinud kohtuniku ettevalmistusteenistuse või on sellest vabastatud ja on sooritanud kohtunikueksami. (2) Kohtuniku ettevalmistusteenistust ei pea olema läbinud isik, kes on vahetult enne kohtunikueksami sooritamist töötanud kaks aastat vandeadvokaadi või prokurörina, välja arvatud abiprokurörina, samuti isik, kes on varem töötanud kohtunikuna ning kelle kohtunikuametist vabastamisest ei ole möödunud rohkem kui 10 aastat.",
      "rdfs:label": {
        "@value": "KS_Par_50 (redaktsioon 110032015015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110032015015",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_50_v122062016022"
      },
      "estleg:versionValidTo": {
