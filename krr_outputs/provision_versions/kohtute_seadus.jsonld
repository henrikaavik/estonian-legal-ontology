        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KS_Par_18_1 (redaktsioon 128122011048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122011048",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 18_1",
      "estleg:partOfAct": {
