    {
      "@id": "estleg:KS_Par_42_v22213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni halduskohtute moodustamiseni või halduskohtunike ametisse nimetamiseni arutavad haldusasju maa- ja linnakohtud.",
      "rdfs:label": {
        "@value": "KS_Par_42 (redaktsioon 22213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22213",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_42_v181957"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22213",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 42",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_42_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Esimese ja teise astme kohtu töökorraldus nähakse ette kohtu kodukorras. Kodukorra kehtestab kohtu esimees kooskõlastatult kohtu üldkoguga. Maa- või linnakohtu kinnistusosakonna, registriosakonna, kriminaalhooldusosakonna ja kantselei kodukorra kehtestab justiitsminister. (2) Kodukorras nähakse ette: kohtuteenistujate ülesanded; kohtu esimehe ja teiste kohtunike kohtu töökorraldusest tulenevad ülesanded; kohtu asjaajamise kord; kohtu muu töökorraldus. (3) Kodukord ei või sisaldada kohtumenetluse korda puudutavaid sätteid. (4) Kohtuasutuse sisekorraeeskirjad ja ametijuhendid kehtestatakse avaliku teenistuse seaduse kohaselt.",
      "rdfs:label": {
        "@value": "KS_Par_42 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_42_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 42",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_42_v928212",
