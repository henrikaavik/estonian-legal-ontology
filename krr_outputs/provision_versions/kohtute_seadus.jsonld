    {
      "@id": "estleg:KS_Par_82_v121062014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikupension arvutatakse ümber, kui muutub ametikoha palk, mille järgi kohtunikupension on arvutatud. (2) Käesoleva paragrahvi lõikes 1 nimetatud juhul arvutatakse pension ümber kohtuniku ametipalga muutumise ajast alates. - Riigikohtu üldkogu otsus tunnistab põhiseaduse vastaseks ja kehtetuks kohtute seaduse § 132.7 lõike 2 ja Eesti keskmise palgaga seotud ametipalkade maksmise ajutise korralduse seaduse, kõrgemate riigiteenijate ametipalkade seaduse ja kohtute seaduse muutmise seaduse § 3 punktiga 2 kohtute seaduse § 82 kehtetuks tunnistamine osas, milles need ei võimaldanud ümber arvutada kohtunike vanaduspensione lähtuvalt kohtunike ametipalkadest 1. juulil 2013.",
      "rdfs:label": {
        "@value": "KS_Par_82 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 82",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_83_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohtunik teenistuskohustuste täitmise tõttu kuritegeliku ründe tagajärjel hukkub, makstakse tema ülalpidamisel olnud perekonnaliikmetele ühekordset toetust kohtuniku viie aasta ametipalga ulatuses.",
      "rdfs:label": {
        "@value": "KS_Par_83 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_83_v129122012008"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 83",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_83_v129122012008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtunikule või tema perekonnaliikmele makstakse kohtuniku hukkumise või töövõime kaotuse korral hüvitist avaliku teenistuse seaduse §-s 49 kehtestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "KS_Par_83 (redaktsioon 129122012008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122012008",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_83_v117122015048"
      },
      "estleg:versionValidTo": {
        "@value": "2016-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129122012008",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 83",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_83_v117122015048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohtunik hukkub või sureb või kohtuniku töövõime väheneb seoses kohtuniku ametiülesannete täitmisega, maksab riik hüvitist avaliku teenistuse seaduse § 49 alusel ja korras. (jõustumine muudetud - RT I, 17.12.2015, 1)",
      "rdfs:label": {
        "@value": "KS_Par_83 (redaktsioon 117122015048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015048",
