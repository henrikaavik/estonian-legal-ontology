      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "võib kehtestada kohtuteenistujate ametiriietuse kirjelduse ning kandmise korra. Ametiriietuse kandmise kohustuse korral antakse ametiriietus kohtuteenistujale tasuta.",
