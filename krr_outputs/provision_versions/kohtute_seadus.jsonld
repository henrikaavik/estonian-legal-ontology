    {
      "@id": "estleg:KS_Par_119_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabieksami komisjon moodustatakse seitsmeliikmelisena viieks aastaks. (2) Kohtunikuabieksami komisjoni kuuluvad kohtunike täiskogu valitud kaks esimese astme kohtunikku ja üks ringkonnakohtunik, justiitsministri määratud kaks kohtunikuabi ja üks Justiitsministeeriumi esindaja ning kohtunikuabi eriharidust andva rakenduskõrgkooli rektori määratud õppejõud. (3) Kohtunikuabieksami komisjon on otsustusvõimeline, kui kohal on vähemalt viis liiget. (4) Kohtunikuabieksami komisjoni töökorra kinnitab justiitsminister.",
      "rdfs:label": {
        "@value": "KS_Par_119 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_119_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 119",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_119_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabieksami komisjon moodustatakse seitsmeliikmelisena viieks aastaks. (2) Kohtunikuabieksami komisjoni kuuluvad kohtunike täiskogu valitud kaks esimese astme kohtunikku ja üks ringkonnakohtunik, justiitsministri määratud kaks kohtunikuabi ja üks Justiitsministeeriumi esindaja ning Notarite Koja määratud notar. (3) Kohtunikuabieksami komisjon on otsustusvõimeline, kui kohal on vähemalt viis liiget.",
      "rdfs:label": {
        "@value": "KS_Par_119 (redaktsioon 928212)",
