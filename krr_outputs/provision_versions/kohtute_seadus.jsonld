        "@value": "2020-06-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122016018",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 16",
