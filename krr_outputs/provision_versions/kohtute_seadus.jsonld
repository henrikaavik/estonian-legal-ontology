    {
      "@id": "estleg:KS_Par_128_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_128"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist. (2) Käesoleva seaduse § 61 lõiget 5, § 76 lõikeid 1 ja 5, §-sid 122, 134 ja 146 rakendatakse alates 2002. aasta 1. juulist.",
      "rdfs:label": {
        "@value": "KS_Par_128 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 128",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_129_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_129"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse alusel moodustatakse Riigikohtu põhiseaduslikkuse järelevalve kolleegium 2003. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "KS_Par_129 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 129",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_129_1_v123122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_129_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2015. aasta 1. jaanuari nimetatud Riigikohtu kolleegiumi esimehe volituste tähtaega arvestatakse 2015. aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "KS_Par_129_1 (redaktsioon 123122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122014003",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 129_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_129_2_v122062016022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_129_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 31 lõikeid 4 ja 5 kohaldatakse kohtunõunike suhtes, kes nimetatakse ametisse pärast 2016. aasta 1. augustit.",
      "rdfs:label": {
        "@value": "KS_Par_129_2 (redaktsioon 122062016022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122062016022",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122062016022",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 129_2",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_12_1_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_12_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtu esimees nimetab igas kohtumajas teenistuses olevate kohtunike seast viieks aastaks kohtumaja juhi, kuulanud ära kohtumaja teenistuses olevate kohtunike arvamuse. Kohtumaja juhti ei nimetata kohtumajas, kus asub kohtu esimehe alaline teenistuskoht. (2) Kohtumaja juht korraldab kohtumaja ning maakohtu esimehe vahelist suhtlemist ning täidab muid seadusest ja kohtu kodukorrast tulenevaid ülesandeid. (3) Kohtumaja juhi võib maakohtu esimees enne tähtaja lõppemist vabastada: tema enda soovil; koostöö mittelaabumise tõttu maakohtu esimehega. (4) Kohtumaja juhi äraoleku ajal võib teda asendada maakohtu esimehe määratud kohtunik. (5) Kui kohtumaja juht vabastatakse kohtunikuametist, vabastatakse ta ka kohtumaja juhi ülesannete täitmisest. (6) Kohtumaja juhi ülesannete täitmisest vabastatud kohtunikul säilivad kohtuniku volitused.",
      "rdfs:label": {
        "@value": "KS_Par_12_1 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_12_1_v122062016022"
      },
      "estleg:versionValidTo": {
        "@value": "2016-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928212",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 12_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
