      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärnu Maakohtus on maksekäsuosakond. (2) Maksekäsuosakonnas menetletakse maksekäsu kiirmenetluse avaldusi. (3) Maksekäsuosakonna koosseisu kuuluvad kohtunikuabid ja muud kohtuteenistujad. Kohtudirektor määrab maksekäsuosakonna kohtunikuabide seast maksekäsuosakonna juhataja.",
      "rdfs:label": {
        "@value": "KS_Par_16_1 (redaktsioon 120062020002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062020002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062020002",
