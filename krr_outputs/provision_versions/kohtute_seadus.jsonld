      }
    },
    {
      "@id": "estleg:KS_Par_50_v113032019003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa- või halduskohtu kohtunikuks (maa- või halduskohtunikuks) võib nimetada isiku: kellel on pärast käesoleva seaduse § 47 lõike 1 punktis 1 sätestatud kvalifikatsiooni omandamist vähemalt viieaastane juriidilise töö kogemus või kes on töötanud kohtunõuniku või kohtujuristina vähemalt kolm aastat ja kes on sooritanud kohtunikueksami või on sellest vabastatud. (2) Kohtunikuks kandideerija vastavust käesoleva paragrahvi lõikes 1 nimetatud nõuetele hindab kohtunikueksamikomisjon.",
      "rdfs:label": {
        "@value": "KS_Par_50 (redaktsioon 113032019003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019003",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_51_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ringkonnakohtu kohtunikuks (ringkonnakohtunikuks) võib nimetada isiku, kes on kogenud ja tunnustatud jurist ning on sooritanud kohtunikueksami. Kohtunikueksamist on vabastatud isik, kes vahetult enne nimetamist töötas kohtunikuna.",
      "rdfs:label": {
        "@value": "KS_Par_51 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_51_v122062016022"
      },
      "estleg:versionValidTo": {
        "@value": "2016-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 51",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_51_v122062016022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnakohtu kohtunikuks (ringkonnakohtunikuks) võib nimetada isiku, kes on: kogenud ja tunnustatud jurist ning sooritanud kohtunikueksami või on sellest vabastatud. (2) Kohtunikuks kandideerija vastavust käesoleva paragrahvi lõikes 1 nimetatud nõuetele hindab kohtunikueksamikomisjon.",
      "rdfs:label": {
        "@value": "KS_Par_51 (redaktsioon 122062016022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122062016022",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122062016022",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 51",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_52_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
