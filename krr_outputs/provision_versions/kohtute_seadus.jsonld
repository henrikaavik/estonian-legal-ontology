      }
    },
    {
      "@id": "estleg:KS_Par_127_1_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_127_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Justiitsminister võib kehtestada kohtuteenistujate ametiriietuse kirjelduse ning kandmise korra. Ametiriietuse kandmise kohustuse korral antakse ametiriietus kohtuteenistujale tasuta.",
      "rdfs:label": {
        "@value": "KS_Par_127_1 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
