      }
    },
    {
      "@id": "estleg:KS_Par_19_v22213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtud arutavad kõiki haldusasju, mis on antud seadusega nende pädevusse. (2) [Kehtetu]",
      "rdfs:label": {
        "@value": "KS_Par_19 (redaktsioon 22213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22213",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_19_v181957"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22213",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_19_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Halduskohtu kohtunike arvu määrab justiitsminister, kuulanud ära halduskohtu esimehe arvamuse ja selle ringkonnakohtu esimehe arvamuse, kelle tööpiirkonda halduskohus kuulub.",
      "rdfs:label": {
        "@value": "KS_Par_19 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_19_v120122010003"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_19_v120122010003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Halduskohtu kohtunike arvu ja jagunemise kohtumajade vahel , kuulanud ära halduskohtu esimehe ja selle ringkonnakohtu esimehe arvamuse, kelle tööpiirkonda kohus kuulub.",
      "rdfs:label": {
        "@value": "KS_Par_19 (redaktsioon 120122010003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010003",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_19_v121062014012"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010003",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_19_v121062014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Halduskohtu kohtunike arvu ja jagunemise kohtumajade vahel määrab , kuulanud ära halduskohtu esimehe ja selle ringkonnakohtu esimehe arvamuse, kelle tööpiirkonda kohus kuulub.",
      "rdfs:label": {
        "@value": "KS_Par_19 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_19_1_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_19_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtu kohtuniku alaline teenistuskoht on kohtumajas, kuhu Riigikohtu üldkogu (§ 55 lõige 3) või kohtu üldkogu (§ 57) on ta määranud. (2) Halduskohtu kohtunik arutab asja kohtuistungil käesoleva seaduse §-s 181 sätestatud kohtumajas. Kohtunik ei või keelduda asja arutamisest teises sama halduskohtu kohtumajas. (3) Kui kohtunik arutab asja kohtumajas, mis ei ole tema alaline teenistuskoht, hüvitatakse talle sõidu- ja majutuskulud. Samuti hüvitatakse kohtunikule muud lähetuskulud Vabariigi Valitsuse määratud alustel ja korras.",
      "rdfs:label": {
        "@value": "KS_Par_19_1 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_19_1_v121062014012"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928212",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 19_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_19_1_v121062014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_19_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtu kohtuniku alaline teenistuskoht on kohtumajas, kuhu Riigikohtu üldkogu (§ 55 lõige 3) või kohtu üldkogu (§ 57) on ta määranud. (2) Kohtunik ei või keelduda asja arutamisest teises sama halduskohtu kohtumajas. (3) Kui kohtunik arutab asja kohtumajas, mis ei ole tema alaline teenistuskoht, hüvitatakse talle sõidu- ja majutuskulud. Samuti hüvitatakse kohtunikule muud lähetuskulud Vabariigi Valitsuse määratud alustel ja korras.",
      "rdfs:label": {
        "@value": "KS_Par_19_1 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_19_1_v122062016022"
      },
      "estleg:versionValidTo": {
        "@value": "2016-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 19_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_19_1_v122062016022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_19_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtu kohtuniku alaline teenistuskoht on kohtumajas, kuhu Riigikohtu üldkogu (§ 55 lõige 3) või kohtu üldkogu (§ 57) on ta määranud. (1¹) Kui halduskohtu esimeheks nimetatakse kohtunik, kes oli vahetult enne esimeheks nimetamist teise kohtu teenistuses, määrab ta esimehe ametiajaks ise kohtumaja, kus on tema alaline teenistuskoht. (2) Kohtunik ei või keelduda asja arutamisest teises sama halduskohtu kohtumajas. (3) Kui kohtunik arutab asja kohtumajas, mis ei ole tema alaline teenistuskoht, hüvitatakse talle sõidu- ja majutuskulud. Samuti hüvitatakse kohtunikule muud lähetuskulud Vabariigi Valitsuse määratud alustel ja korras.",
      "rdfs:label": {
        "@value": "KS_Par_19_1 (redaktsioon 122062016022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122062016022",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_19_1_v120062020002"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122062016022",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 19_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_19_1_v120062020002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_19_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtu kohtuniku alaline teenistuskoht on kohtumajas, kuhu Riigikohtu üldkogu (§ 55 lõige 3) või kohtu üldkogu (§ 57) on ta määranud. (1¹) Kui halduskohtu esimeheks nimetatakse kohtunik, kes oli vahetult enne esimeheks nimetamist teise kohtu teenistuses, määrab ta esimehe ametiajaks ise kohtumaja, kus on tema alaline teenistuskoht. (2) Kohtunik ei või keelduda asja arutamisest teises sama halduskohtu kohtumajas. (3) Kui kohtunik arutab asja kohtumajas, mis ei ole tema alaline teenistuskoht, hüvitatakse talle sõidu- ja majutuskulud, samuti muud lähetuskulud avaliku teenistuse seaduse § 44 lõike 5 alusel kehtestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "KS_Par_19_1 (redaktsioon 120062020002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062020002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_19_1_v111032023019"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062020002",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 19_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_19_1_v111032023019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_19_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtu kohtuniku alaline teenistuskoht on kohtumajas, kuhu Riigikohtu üldkogu (§ 55 lõige 3) või kohtu esimees (§ 57) on ta määranud. (1¹) Kui halduskohtu esimeheks nimetatakse kohtunik, kes oli vahetult enne esimeheks nimetamist teise kohtu teenistuses, määrab ta esimehe ametiajaks ise kohtumaja, kus on tema alaline teenistuskoht. (2) Kohtunik ei või keelduda asja arutamisest teises sama halduskohtu kohtumajas. (3) Kui kohtunik arutab asja kohtumajas, mis ei ole tema alaline teenistuskoht, hüvitatakse talle sõidu- ja majutuskulud, samuti muud lähetuskulud avaliku teenistuse seaduse § 44 lõike 5 alusel kehtestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "KS_Par_19_1 (redaktsioon 111032023019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/111032023019",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 19_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_2_v22213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigis sätestatakse kohtukorraldus põhiseaduse ja käesoleva seadusega.",
      "rdfs:label": {
        "@value": "KS_Par_2 (redaktsioon 22213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22213",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_2_v181957"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22213",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_2_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õigust mõistab ainult kohus. (2) Kellelgi ei ole õigust sekkuda õigusemõistmisesse. (3) Kohtus ja selle lähikonnas on keelatud teod, mis on suunatud õigusemõistmise häirimisele.",
      "rdfs:label": {
        "@value": "KS_Par_2 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_20_v22213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnakohtute ja kohtunike üldarvu määrab kindlaks Riigikogu justiitsministri ettepanekul, mis on kooskõlastatud Riigikohtuga. (2) Ringkonnakohtute tööpiirkonna, asukoha ja neis töötavate kohtunike arvu määrab kindlaks justiitsminister kooskõlastatult Riigikohtuga. (3) Ringkonnakohtu kohtunikud nimetab ametisse Vabariigi President Riigikohtu ettepanekul. (4) Ringkonnakohtu esimehe määrab Riigikogu justiitsministri ettepanekul, mis on kooskõlastatud Riigikohtuga. (5) Ringkonnakohtu reglemendi kinnitab justiitsminister.",
      "rdfs:label": {
        "@value": "KS_Par_20 (redaktsioon 22213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22213",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_20_v181957"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22213",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 20",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_20_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtu esimees nimetatakse selle kohtu kohtunike seast viieks aastaks. Kohtu esimehe nimetab justiitsminister, kuulanud ära kohtu üldkogu arvamuse. (2) Halduskohtu esimees esindab ja juhib kohtuasutust oma pädevuse piires. Kohtu esimees vastutab õigusemõistmise korrakohase toimumise eest kohtus. (3) Halduskohtu esimees: korraldab õigusemõistmise alast tegevust; kooskõlastab haldusdirektori koostatud kohtu eelarve eelnõu; teostab seaduses ettenähtud järelevalvet; koostab kohtu kohtunike koolituskava eelnõu ja esitab selle kinnitamiseks kohtu kohtunike üldkogule, korraldab ja kontrollib selle täitmist ning esitab vähemalt kord aastas kohtu üldkogule ülevaate selle täitmisest; täidab muid seadusest ja kohtu kodukorrast tulenevaid ülesandeid. (4) Kohtu esimehe võib justiitsminister enne tähtaja lõppemist vabastada: tema enda soovil; kui ta on süüliselt jätnud oma ülesanded olulisel määral täitmata. (5) Käesoleva paragrahvi lõike 4 punktis 2 nimetatud juhul kuulab justiitsminister ära kohtu üldkogu arvamuse ja selle ringkonnakohtu esimehe arvamuse, kelle tööpiirkonda halduskohus kuulub. (6) Kui kohtu esimees vabastatakse kohtunikuametist, vabastatakse ta ka kohtu esimehe ülesannete täitmisest. (7) Kohtu esimehe ülesannete täitmisest vabastatud kohtuesimehel säilivad kohtuniku volitused. (8) Kohtu esimehe äraoleku ajal asendab teda tema enda määratud kohtunik. Kui kohtu esimees ei ole asendajat määranud, asendab teda kõige kauem teenistuses olnud kohtunik või teenistusaegade võrdsuse korral vanim kohtunik. (9) Kedagi ei tohi nimetada kohtu esimeheks kaheks ametiajaks järjestikku.",
      "rdfs:label": {
        "@value": "KS_Par_20 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_20_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 20",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_20_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduskohtu esimees nimetatakse selle kohtu kohtunike seast viieks aastaks. Kohtu esimehe nimetab justiitsminister, kuulanud ära kohtu üldkogu arvamuse. (2) Halduskohtu esimees esindab ja juhib kohtuasutust oma pädevuse piires. Kohtu esimees vastutab õigusemõistmise korrakohase toimumise eest kohtus. (3) Halduskohtu esimees: korraldab õigusemõistmise alast tegevust; kooskõlastab kohtudirektori koostatud kohtu eelarve eelnõu; teostab seaduses ettenähtud järelevalvet; koostab kohtu kohtunike koolituskava eelnõu ja esitab selle kinnitamiseks kohtu kohtunike üldkogule, korraldab ja kontrollib selle täitmist ning esitab vähemalt kord aastas kohtu üldkogule ülevaate selle täitmisest; täidab muid seadusest ja kohtu kodukorrast tulenevaid ülesandeid. (4) Kohtu esimehe võib justiitsminister enne tähtaja lõppemist vabastada: tema enda soovil; kui ta on süüliselt jätnud oma ülesanded olulisel määral täitmata; tema valimisel või nimetamisel rahvusvahelise kohtuinstitutsiooni kohtunikuks (§ 581). (5) Käesoleva paragrahvi lõike 4 punktis 2 nimetatud juhul kuulab justiitsminister ära kohtu üldkogu arvamuse ja selle ringkonnakohtu esimehe arvamuse, kelle tööpiirkonda halduskohus kuulub. (6) Kui kohtu esimees vabastatakse kohtunikuametist, vabastatakse ta ka kohtu esimehe ülesannete täitmisest. (7) Kohtu esimehe ülesannete täitmisest vabastatud kohtuesimehel säilivad kohtuniku volitused. (8) Kohtu esimehe äraoleku ajal asendab teda tema enda määratud kohtunik. Kui kohtu esimees ei ole asendajat määranud, asendab teda kõige kauem teenistuses olnud kohtunik või teenistusaegade võrdsuse korral vanim kohtunik. (9) Kedagi ei tohi nimetada kohtu esimeheks rohkem kui kaheks ametiajaks järjestikku.",
      "rdfs:label": {
        "@value": "KS_Par_20 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_20_v129122012008"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928212",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 20",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
