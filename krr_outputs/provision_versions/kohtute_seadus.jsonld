        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtu kohtuniku alaline teenistuskoht on kohtumajas, kuhu Riigikohtu üldkogu (§ 55 lõige 3), kohtu üldkogu (§ 57 lõige 1) või kohtu esimees (§ 57 lõige 2) on ta määranud. (2) Maakohtu kohtunik arutab asja kohtuistungil käesoleva seaduse §-s 101 sätestatud kohtumajas. Kohtunik ei või keelduda asja arutamisest teises sama maakohtu kohtumajas. (3) Kui kohtunik arutab asja kohtumajas, mis ei ole tema alaline teenistuskoht, hüvitatakse talle sõidu- ja majutuskulud. Samuti hüvitatakse kohtunikule muud lähetuskulud Vabariigi Valitsuse määratud alustel ja korras.",
      "rdfs:label": {
        "@value": "KS_Par_11_1 (redaktsioon 13109273)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13109273",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_11_1_v121062014012"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13109273",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 11_1",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_11_1_v121062014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_11_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtu kohtuniku alaline teenistuskoht on kohtumajas, kuhu Riigikohtu üldkogu (§ 55 lõige 3), kohtu üldkogu (§ 57 lõige 1) või kohtu esimees (§ 57 lõige 2) on ta määranud. (2) Kohtunik ei või keelduda asja arutamisest teises sama maakohtu kohtumajas. (3) Kui kohtunik arutab asja kohtumajas, mis ei ole tema alaline teenistuskoht, hüvitatakse talle sõidu- ja majutuskulud. Samuti hüvitatakse kohtunikule muud lähetuskulud Vabariigi Valitsuse määratud alustel ja korras.",
      "rdfs:label": {
        "@value": "KS_Par_11_1 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
