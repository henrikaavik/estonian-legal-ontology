      }
    },
    {
      "@id": "estleg:KS_Par_136_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_136"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel tuleb kohtunikuabieksami komisjon moodustada hiljemalt 2003. aasta 1. jaanuariks. (2) Kuni käesoleva seaduse alusel kohtunikuabieksami komisjoni moodustamiseni täidab selle komisjoni ülesandeid senine kohtunikuabieksami komisjon.",
      "rdfs:label": {
        "@value": "KS_Par_136 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_136_v121062014012"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 136",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_136_v121062014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_136"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Kuni konkursikomisjoni moodustamiseni täidab selle komisjoni ülesandeid senine kohtunikuabieksami komisjon.",
      "rdfs:label": {
        "@value": "KS_Par_136 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 136",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_137_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_137"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kuni 2004. aastani sisaldub kohtunike koolituse programmis ka järelkoolitus. (2) Justiitsministeerium annab ministri kinnitatud korras kohtunike koolituse programmide koostamiseks vajaliku teabe ja lepingud sihtasutusele üle ja sihtasutus alustab 2003. aasta koolituse programmi koostamist hiljemalt 2002. aasta 1. septembril. (3) Käesoleva seaduse alusel koolitusnõukogu moodustamiseni täidab koolitusnõukogu ülesandeid senine koolitusnõukogu.",
      "rdfs:label": {
        "@value": "KS_Par_137 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 137",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_137_1_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_137_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 581 kohaldatakse ka enne nimetatud sätte jõustumist rahvusvahelise kohtuinstitutsiooni valitud või nimetatud kohtuniku suhtes.",
      "rdfs:label": {
