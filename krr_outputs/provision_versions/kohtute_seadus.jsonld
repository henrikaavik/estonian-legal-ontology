    {
      "@id": "estleg:KS_Par_13_v120122010003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KS_Par_13 (redaktsioon 120122010003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010003",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 13",
      "estleg:partOfAct": {
