    {
      "@id": "estleg:KS_Par_57_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikohtu üldkogu võib kohtuniku tema nõusolekul ja justiitsministri ettepanekul määrata kohtunikuametisse teise sama astme või madalama astme kohtusse.",
      "rdfs:label": {
        "@value": "KS_Par_57 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_57_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 57",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_57_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikohtu üldkogu võib kohtuniku tema nõusolekul ja justiitsministri ettepanekul määrata kohtunikuametisse teise sama astme või madalama astme kohtusse. Esimese astme kohtuniku võib kohtu üldkogu määrata tema nõusolekul alaliselt teenistusse sama kohtu teise kohtumajja.",
      "rdfs:label": {
        "@value": "KS_Par_57 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_57_v13109273"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928212",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 57",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_57_v13109273",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikohtu üldkogu võib kohtuniku tema nõusolekul ja justiitsministri ettepanekul määrata kohtunikuametisse teise sama astme või madalama astme kohtusse. Esimese astme kohtuniku võib kohtu üldkogu määrata tema nõusolekul alaliselt teenistusse sama kohtu teise kohtumajja. (2) Sama asula piires võib kohtu esimees õigusemõistmise korraldamise huvides määrata kohtuniku tema nõusolekuta alaliselt teenistusse teise sama kohtu kohtumajja. Kohtu esimees kuulab enne ära kohtu üldkogu arvamuse.",
      "rdfs:label": {
        "@value": "KS_Par_57 (redaktsioon 13109273)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13109273",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_57_v129122012008"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13109273",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 57",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_57_v129122012008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikohtu üldkogu võib kohtuniku tema nõusolekul ja justiitsministri ettepanekul määrata kohtunikuametisse teise sama astme või madalama astme kohtusse. Esimese astme kohtuniku võib kohtu üldkogu määrata tema nõusolekul alaliselt teenistusse sama kohtu teise kohtumajja. (2) Sama asula piires võib kohtu esimees õigusemõistmise korraldamise huvides määrata kohtuniku tema nõusolekuta alaliselt teenistusse teise sama kohtu kohtumajja. Kohtu esimees kuulab enne ära kohtu üldkogu arvamuse. (3) Kohtuniku üleviimisel teise sama astme või madalama astme kohtusse, välja arvatud Riigikohtu kohtuniku üleviimisel madalama astme kohtusse, ei maksta talle tema kasutamata jäänud aegumata põhipuhkuse eest hüvitist ning puhkuse arvestus jätkub kohtus, kuhu kohtunik üle viidi.",
      "rdfs:label": {
        "@value": "KS_Par_57 (redaktsioon 129122012008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122012008",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_57_v121062014012"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129122012008",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 57",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_57_v121062014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikohtu üldkogu võib kohtuniku tema nõusolekul ja valdkonna eest vastutava ministri ettepanekul määrata kohtunikuametisse teise sama astme või madalama astme kohtusse. Esimese astme kohtuniku võib kohtu üldkogu määrata tema nõusolekul alaliselt teenistusse sama kohtu teise kohtumajja. (2) Sama asula piires võib kohtu esimees õigusemõistmise korraldamise huvides määrata kohtuniku tema nõusolekuta alaliselt teenistusse teise sama kohtu kohtumajja. Kohtu esimees kuulab enne ära kohtu üldkogu arvamuse. (3) Kohtuniku üleviimisel teise sama astme või madalama astme kohtusse, välja arvatud Riigikohtu kohtuniku üleviimisel madalama astme kohtusse, ei maksta talle tema kasutamata jäänud aegumata põhipuhkuse eest hüvitist ning puhkuse arvestus jätkub kohtus, kuhu kohtunik üle viidi.",
      "rdfs:label": {
        "@value": "KS_Par_57 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_57_v122062016022"
      },
      "estleg:versionValidTo": {
        "@value": "2016-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 57",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_57_v122062016022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikohtu üldkogu võib kohtuniku tema nõusolekul ja valdkonna eest vastutava ministri ettepanekul määrata kohtunikuametisse teise sama astme või madalama astme kohtusse. Esimese astme kohtuniku võib kohtu üldkogu määrata tema nõusolekul alaliselt teenistusse sama kohtu teise kohtumajja. (1¹) Kui kohtu esimehe vaba ametikoht täidetakse käesoleva seaduse §-des 12, 20 ja 24 sätestatud korras, ei kohaldata käesoleva paragrahvi lõiget 1. Kohtuniku üleviimise vormistab valdkonna eest vastutav minister käskkirjaga. (2) Sama asula piires võib kohtu esimees õigusemõistmise korraldamise huvides määrata kohtuniku tema nõusolekuta alaliselt teenistusse teise sama kohtu kohtumajja. Kohtu esimees kuulab enne ära kohtu üldkogu arvamuse. (3) Kohtuniku üleviimisel teise sama astme või madalama astme kohtusse, välja arvatud Riigikohtu kohtuniku üleviimisel madalama astme kohtusse, ei maksta talle tema kasutamata jäänud aegumata põhipuhkuse eest hüvitist ning puhkuse arvestus jätkub kohtus, kuhu kohtunik üle viidi.",
      "rdfs:label": {
        "@value": "KS_Par_57 (redaktsioon 122062016022)",
        "@language": "et"
      },
