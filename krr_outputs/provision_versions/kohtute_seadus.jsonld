      "estleg:versionValidFrom": {
        "@value": "2016-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2016. aasta 1. augustit väljakuulutatud konkursid vabade kohtunikukohtade täitmiseks korraldatakse kuni 2016. aasta 31. juulini kehtinud seaduse alusel.",
      "rdfs:label": {
        "@value": "KS_Par_137_3 (redaktsioon 122062016022)",
        "@language": "et"
      },
