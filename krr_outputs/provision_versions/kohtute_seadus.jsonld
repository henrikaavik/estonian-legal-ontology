    },
    {
      "@id": "estleg:KS_Par_50_v122062016022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa- või halduskohtu kohtunikuks (maa- või halduskohtunikuks) võib nimetada isiku: kellel on vähemalt viieaastane töökogemus ameti- või töökohal, millel töötamise eelduseks on käesoleva seaduse § 47 lõike 1 punktis 1 nimetatud kvalifikatsioon, või kes on töötanud kohtunõuniku või kohtujuristina vähemalt kolm aastat ja kes on sooritanud kohtunikueksami või on sellest vabastatud. (2) Kohtunikuks kandideerija vastavust käesoleva paragrahvi lõikes 1 nimetatud nõuetele hindab kohtunikueksamikomisjon.",
      "rdfs:label": {
        "@value": "KS_Par_50 (redaktsioon 122062016022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122062016022",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_50_v113032019003"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122062016022",
      "estleg:sourceAct": "Kohtute seadus",
