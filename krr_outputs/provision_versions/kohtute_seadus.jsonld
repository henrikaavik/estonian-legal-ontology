    {
      "@id": "estleg:KS_Par_15_v22213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kõik otsused võetakse vastu lihthäälteenamusega. (2) Hääletamisest keeldumine või erapooletuks jäämine ei ole lubatud. (3) Kui hääled jagunevad võrdselt, otsustab asja eesistuja hääl.",
      "rdfs:label": {
        "@value": "KS_Par_15 (redaktsioon 22213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22213",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_15_v181957"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22213",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_15_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa- ja linnakohtus on kinnistusosakond. (2) Kinnistusosakonnas peetakse kinnistusraamatut ja abieluvararegistrit. (3) Justiitsminister võib määrata, et mõnes maa- või linnakohtus ei ole kinnistusosakonda. Sel juhul määrab justiitsminister, millise maa- või linnakohtu kinnistusosakond täidab registripidamisega seotud ülesandeid selle kohtu tööpiirkonnas, kus kinnistusosakonda ei ole. (4) Kinnistusosakonna juhataja on haldusdirektori määratud kohtunikuabi. Kinnistusosakonna koosseisu kuuluvad kohtunikuabid ja muud kohtuteenistujad.",
      "rdfs:label": {
        "@value": "KS_Par_15 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_15_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_15_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtus on kinnistusosakond. (2) Kinnistusosakonnas peetakse kinnistusraamatut ja abieluvararegistrit. (3) Kehtetu – (4) Kinnistusosakonna juhataja on haldusdirektori määratud kohtunikuabi. Kinnistusosakonna koosseisu kuuluvad kohtunikuabid ja muud kohtuteenistujad.",
      "rdfs:label": {
        "@value": "KS_Par_15 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
