        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabiks võib nimetada isiku, kes: vastab käesoleva seaduse § 47 lõike 1 punktides 1–3 kehtestatud nõuetele ja on täitnud kohtunikuabi ettevalmistuskava, kui konkursikomisjon ei ole isikut kohtunikuabi ettevalmistuskava täitmisest vabastanud. (2) Kohtunikuabiks võib nimetada ka isiku, kes ei ole täitnud kohtunikuabi ettevalmistuskava, kuid kes on läbinud kohtuniku ettevalmistusteenistuse või on sellest vabastatud ja on sooritanud kohtunikueksami. (3) Kohtunikuabiks ei või nimetada käesoleva seaduse § 47 lõikes 2 nimetatud isikut ega isikut, kes on kohtuniku ametist vabastatud käesoleva seaduse § 99 lõike 1 punkti 3 alusel.",
      "rdfs:label": {
        "@value": "KS_Par_115 (redaktsioon 121062014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014012",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_115_v122062016022"
      },
      "estleg:versionValidTo": {
        "@value": "2016-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014012",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 115",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
