    {
      "@id": "estleg:KS_Par_48_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuniku teenistusvanuse ülemmäär on 67 aastat.",
      "rdfs:label": {
        "@value": "KS_Par_48 (redaktsioon 181957)",
        "@language": "et"
      },
