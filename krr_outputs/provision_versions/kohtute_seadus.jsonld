      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ringkonnakohtu kohtunike arvu määrab justiitsminister, kuulanud ära ringkonnakohtu esimehe arvamuse.",
      "rdfs:label": {
        "@value": "KS_Par_23 (redaktsioon 181957)",
        "@language": "et"
      },
