    {
      "@id": "estleg:KS_Par_114_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_114"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabi on kohtuametnik, kes täidab seaduses nimetatud ülesandeid. (2) Kohtunikuabi on oma ülesannete täitmisel sõltumatu, kuid peab seaduses ettenähtud ulatuses järgima kohtuniku juhiseid.",
      "rdfs:label": {
        "@value": "KS_Par_114 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_114_v13109273"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 114",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_114_v13109273",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_114"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikuabi on kohtuametnik, kes täidab seaduses nimetatud ülesandeid. (2) Kohtunikuabi on oma ülesannete täitmisel sõltumatu, kuid peab seaduses ettenähtud ulatuses järgima kohtuniku juhiseid. (3) Kohtunikuabide lahendatavad asjad määrab kohtu piires kindlaks kohtu esimees enne kohtunike vahelise tööjaotusplaani kinnitamist kohtu üldkogu poolt.",
      "rdfs:label": {
        "@value": "KS_Par_114 (redaktsioon 13109273)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13109273",
