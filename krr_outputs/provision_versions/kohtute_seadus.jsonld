    {
      "@id": "estleg:KS_Par_23_v22213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikohus on Eesti Vabariigi kõrgeim kohus. (2) Riigikohus vaatab läbi kohtulahendeid kassatsiooni korras. Seaduses sätestatud juhtudel ja korras vaatab Riigikohus läbi kohtulahendite teistimisavaldused ja parandab kohtuvigu. (3) Riigikohus on ka põhiseadusliku järelevalve kohus.",
      "rdfs:label": {
        "@value": "KS_Par_23 (redaktsioon 22213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22213",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_23_v181957"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22213",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
