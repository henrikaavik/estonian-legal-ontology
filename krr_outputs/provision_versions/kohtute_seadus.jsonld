    },
    {
      "@id": "estleg:KS_Par_113_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_113"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui isik kaotab püsiva töövõime rahvakohtuniku kohustuste täitmise tõttu tema suhtes toimepandud kuritegeliku ründe tagajärjel, suurendatakse tema riiklikku töövõimetuspensioni 100%-lise töövõime kaotuse korral 20%, 80 või 90%-lise töövõime kaotuse korral 15% ja 40–70%-lise töövõime kaotuse korral 10%. (2) Kui isik sureb rahvakohtuniku kohustuste täitmise ajal tema suhtes toimepandud kuritegeliku ründe tagajärjel, suurendatakse igale tema ülalpidamisel olnud töövõimetule perekonnaliikmele makstavat riiklikku toitjakaotuspensioni 20%. (3) Rahvakohtunikupensioni see osa, mis ületab riiklikku pensioni või ei ole sellega kaetud, makstakse riigieelarve täiendavatest vahenditest.",
      "rdfs:label": {
        "@value": "KS_Par_113 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_113_v104032011007"
      },
      "estleg:versionValidTo": {
        "@value": "2011-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 113",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
