    {
      "@id": "estleg:KS_Par_112_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvakohtuniku tasu iga õigusemõistmises osaletud päeva eest on riigiteenistujate palgaastmestiku kõrgeima astme palgamäära ja koefitsiendi 0,024 korrutis. (2) Rahvakohtunikule hüvitatakse õigusemõistmises osalemisega seotud kulud. (3) Tööandja peab rahvakohtuniku õigusemõistmises osalemise ajaks tööst vabastama. (4) Rahvakohtunikule tasu maksmise korra kehtestab justiitsminister.",
      "rdfs:label": {
        "@value": "KS_Par_112 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_112_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 112",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_112_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
