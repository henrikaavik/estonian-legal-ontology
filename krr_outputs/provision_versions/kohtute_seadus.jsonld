    {
      "@id": "estleg:KS_Par_115_v122062016022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_115"
