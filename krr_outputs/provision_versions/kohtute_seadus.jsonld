        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 82",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_82_v129122012009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtunikupension arvutatakse ümber, kui muutub ametikoha palk, mille järgi kohtunikupension on arvutatud. (2) Käesoleva paragrahvi lõikes 1 nimetatud juhul arvutatakse pension ümber kohtuniku ametipalga muutumise ajast alates. - Riigikohtu üldkogu otsus tunnistab põhiseaduse vastaseks ja kehtetuks Eesti keskmise palgaga seotud ametipalkade maksmise ajutise korralduse seaduse § 3 punktiga 2 kohtute seaduse § 82 kehtetuks tunnistamine osas, milles need ei võimaldanud ümber arvutada kohtunike vanaduspensione lähtuvalt kohtunike ametipalkadest 1. juulil 2013.",
      "rdfs:label": {
        "@value": "KS_Par_82 (redaktsioon 129122012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122012009",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_82_v104072014035"
      },
      "estleg:versionValidTo": {
