      }
    },
    {
      "@id": "estleg:KS_Par_37_v22213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Kehtetu]",
      "rdfs:label": {
        "@value": "KS_Par_37 (redaktsioon 22213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22213",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_37_v181957"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22213",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 37",
      "estleg:partOfAct": {
