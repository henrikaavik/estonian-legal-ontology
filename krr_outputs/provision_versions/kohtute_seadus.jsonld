    {
      "@id": "estleg:KS_Par_86_v181957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtu likvideerimise või kohtunike arvu vähendamise tõttu ametist vabastatud kohtunikule makstakse hüvitisena viimase ametikoha kuue kuu ametipalk. (2) Hüvitist ei maksta kohtu esimehele, kes pärast kohtu esimehe ametikohalt vabastamist jätkab töötamist kohtunikuna. (3) Kui kõrgema astme kohtu kohtunik nimetatakse tema nõusolekul kohtu likvideerimise või kohtunike arvu vähendamise tõttu madalama astme kohtu kohtunikuks, säilib tal ühe aasta jooksul eelmise ametikoha ametipalk koos lisatasudega. (4) Kohtuniku kutsumise kaitseväe tegevteenistusse või õppekogunemisele kooskõlastab kaitseväe juhataja kohtute haldamise nõukojaga.",
      "rdfs:label": {
        "@value": "KS_Par_86 (redaktsioon 181957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181957",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_86_v928212"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181957",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 86",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_86_v928212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KS_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtu likvideerimise või kohtumaja sulgemise või kohtunike arvu vähendamise tõttu ametist vabastatud kohtunikule makstakse hüvitisena viimase ametikoha kuue kuu ametipalk. (2) Hüvitist ei maksta kohtu esimehele, kes pärast kohtu esimehe ametikohalt vabastamist jätkab töötamist kohtunikuna, ega kohtumaja juhile, kes pärast kohtumaja juhi ülesannete täitmisest vabastamist jätkab töötamist kohtunikuna. (3) Kui kõrgema astme kohtu kohtunik nimetatakse tema nõusolekul kohtu likvideerimise või kohtunike arvu vähendamise tõttu madalama astme kohtu kohtunikuks, säilib tal ühe aasta jooksul eelmise ametikoha ametipalk koos lisatasudega. (4) Kohtuniku kutsumisel kaitseväe tegevteenistusse on vajalik kohtute haldamise nõukoja nõusolek.",
      "rdfs:label": {
        "@value": "KS_Par_86 (redaktsioon 928212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KS_Par_86_v129122012008"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928212",
      "estleg:sourceAct": "Kohtute seadus",
      "estleg:provisionRef": "KS § 86",
      "estleg:partOfAct": {
        "@id": "estleg:KS_Map_2026"
      }
    },
    {
      "@id": "estleg:KS_Par_86_v129122012008",
