      }
    },
    {
      "@id": "estleg:Reg_1025418_Par_13_v1025418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025418_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse ja maastikuilme säilitamine ning kaitsealuste liikide elupaikade kaitse. Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse ja maastikuilme säilitamine ning kaitsealuste liikide elupaikade kaitse.",
      "rdfs:label": {
        "@value": "Reg_1025418_Par_13 (redaktsioon 1025418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025418",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025418",
      "estleg:sourceAct": "Sirtsi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1025418 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025418_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025418_Par_14_v1025418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025418_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus, kooskõlas käesolevas määruses sätestatud erisustega; 2 2) kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja tähistamata kohas ning kaitseala valitseja nõusolekul rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja tähistamata kohas. Piiranguvööndis on lubatud: majandustegevus, kooskõlas käesolevas määruses sätestatud erisustega; kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja tähistamata kohas ning kaitseala valitseja nõusolekul rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja tähistamata kohas. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) lageraie kuusikutes ja hall-lepikutes langi suurusega kuni üks hektar ja laiusega 30 meetrit; 2 2) turberaie raielangi pindalaga kuni kaks hektarit; 3 3) tootmisotstarbeta rajatise püstitamine kaitseala tarbeks, arvestades § 6 punktides 3–7 sätestatut; 4 4) veekogude veetaseme ja kaldajoone muutmine loodusliku veerežiimi taastamisel. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: lageraie kuusikutes ja hall-lepikutes langi suurusega kuni üks hektar ja laiusega 30 meetrit; turberaie raielangi pindalaga kuni kaks hektarit; tootmisotstarbeta rajatise püstitamine kaitseala tarbeks, arvestades § 6 punktides 3–7 sätestatut; veekogude veetaseme ja kaldajoone muutmine loodusliku veerežiimi taastamisel. 3 (3) Raie tegemisel tuleb säilitada koosluse looduslik tasakaal ning liigiline ja vanuseline mitmekesisus. Raie tegemisel tuleb säilitada koosluse looduslik tasakaal ning liigiline ja vanuseline mitmekesisus.",
      "rdfs:label": {
        "@value": "Reg_1025418_Par_14 (redaktsioon 1025418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025418",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025418",
      "estleg:sourceAct": "Sirtsi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1025418 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025418_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025418_Par_15_v1025418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025418_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) maavara kaevandamine; 3 3) uue maaparandussüsteemi rajamine; 4 4) biotsiidi, taimekaitsevahendi ja väetise kasutamine; 5 5) ehitise püstitamine, välja arvatud § 14 lõike 2 punktis 3 sätestatud juhul; 6 6) puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab. Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine; uue maaparandussüsteemi rajamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine; ehitise püstitamine, välja arvatud § 14 lõike 2 punktis 3 sätestatud juhul; puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab.",
      "rdfs:label": {
        "@value": "Reg_1025418_Par_15 (redaktsioon 1025418)",
        "@language": "et"
      },
