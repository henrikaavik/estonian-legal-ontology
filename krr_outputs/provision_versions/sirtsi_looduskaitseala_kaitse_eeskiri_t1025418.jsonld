      }
    },
    {
      "@id": "estleg:Reg_1025418_Par_2_v1025418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025418_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Lääne-Viru maakonnas Rägavere vallas Uljaste, Kõrma, Männikvälja ja Sae külas ning Vinni vallas Aravuse, Palasi ja Kaukvere külas ning Ida-Viru maakonnas Maidla vallas Sirtsi, Lümatu ja Koolma külas ning Sonda vallas Nüri külas. Kaitseala asub Lääne-Viru maakonnas Rägavere vallas Uljaste, Kõrma, Männikvälja ja Sae külas ning Vinni vallas Aravuse, Palasi ja Kaukvere külas ning Ida-Viru maakonnas Maidla vallas Sirtsi, Lümatu ja Koolma külas ning Sonda vallas Nüri külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1025418_Par_2 (redaktsioon 1025418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025418",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025418",
