      "estleg:versionText": "Sirtsi looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 25. augusti 2004. a käskkirjaga nr 776 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Sirtsi looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 25. augusti 2004. a käskkirjaga nr 776 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1025418_Par_18 (redaktsioon 1025418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025418",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025418",
      "estleg:sourceAct": "Sirtsi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1025418 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025418_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025418_Par_19_v1025418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
