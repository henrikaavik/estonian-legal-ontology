      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1025418_Par_3 (redaktsioon 1025418)",
        "@language": "et"
      },
