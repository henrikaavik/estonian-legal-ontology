        "@id": "estleg:Reg_1025418_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025418_Par_12_v1025418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025418_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on kuus piiranguvööndit: 1 1) Koolma piiranguvöönd; 2 2) Krüvissaare piiranguvöönd; 3 3) Kullikünka piiranguvöönd; 4 4) Kõrma piiranguvöönd; 5 5) Männikvälja piiranguvöönd; 6 6) Seltsi piiranguvöönd. Kaitsealal on kuus piiranguvööndit: Koolma piiranguvöönd; Krüvissaare piiranguvöönd; Kullikünka piiranguvöönd; Kõrma piiranguvöönd; Männikvälja piiranguvöönd; Seltsi piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1025418_Par_12 (redaktsioon 1025418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025418",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025418",
      "estleg:sourceAct": "Sirtsi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1025418 § 12",
      "estleg:partOfAct": {
