      }
    },
    {
      "@id": "estleg:Reg_1062245_Par_8_v1062245",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062245_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkurss loetakse luhtunuks, kui konkursil osalemiseks ei esitatud ühtegi taotlust või ükski taotlus ei vastanud esitatud nõuetele. Konkursi luhtumisel otsustab ministeerium uue konkursi korraldamise. Konkurss loetakse luhtunuks, kui konkursil osalemiseks ei esitatud ühtegi taotlust või ükski taotlus ei vastanud esitatud nõuetele. Konkursi luhtumisel otsustab ministeerium uue konkursi korraldamise.",
      "rdfs:label": {
        "@value": "Reg_1062245_Par_8 (redaktsioon 1062245)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062245",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062245",
      "estleg:sourceAct": "Eesti teaduskommunikatsiooni riikliku auhinnakonkursi läbiviimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1062245 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062245_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1062245_Par_9_v1062245",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062245_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Enne käesoleva määruse jõustumist välja kuulutatud teaduskommunikatsiooni riikliku auhinnakonkursi läbiviimisele kohaldatakse konkursi läbiviimise ajal kehtinud tingimusi ja korda. Enne käesoleva määruse jõustumist välja kuulutatud teaduskommunikatsiooni riikliku auhinnakonkursi läbiviimisele kohaldatakse konkursi läbiviimise ajal kehtinud tingimusi ja korda. 2 (2) Määrust rakendatakse 1. oktoobrist 2025. aastast. Määrust rakendatakse 1. oktoobrist 2025. aastast.",
      "rdfs:label": {
        "@value": "Reg_1062245_Par_9 (redaktsioon 1062245)",
        "@language": "et"
      },
