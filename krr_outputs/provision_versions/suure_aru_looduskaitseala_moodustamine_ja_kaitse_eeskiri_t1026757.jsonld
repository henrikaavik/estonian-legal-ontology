      "estleg:provisionRef": "Reg_1026757 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026757_Map"
      }
    },
    {
      "@id": "estleg:Reg_1026757_Par_9_v1026757",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
