    {
      "@id": "estleg:Reg_157240_Par_5_v157240",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157240_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tunnistuse andja keeldub tunnistuse väljastamisest «Okupatsioonirežiimide poolt represseeritud isiku seaduse» §-s 9 sätestatud alustel. Tunnistuse andja keeldub tunnistuse väljastamisest «Okupatsioonirežiimide poolt represseeritud isiku seaduse» §-s 9 sätestatud alustel.",
      "rdfs:label": {
        "@value": "Reg_157240_Par_5 (redaktsioon 157240)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157240",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157240",
      "estleg:sourceAct": "Represseeritu tunnistuse andmise korra ning taotluse andmete loetelu ja tunnistuse vormi kehtestamine ning represseeritu tunnistusi väljastava asutuse määramine",
      "estleg:provisionRef": "Reg_157240 § 5",
      "estleg:partOfAct": {
