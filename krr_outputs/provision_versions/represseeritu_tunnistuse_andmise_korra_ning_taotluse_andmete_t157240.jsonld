      }
    },
    {
      "@id": "estleg:Reg_157240_Par_6_v157240",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157240_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotlusele kantakse järgmised andmed: 1 1) taotluse esitamise kuupäev; 2 2) taotleja nimi, isikukood ja kontaktandmed; 3 3) taotleja selgitus, millisele okupatsioonirežiimide poolt represseeritud isiku seaduses sätestatud alusele taotleja enda vastavaks tunnistamist taotleb; 4 4) taotlusele lisatud dokumentide loetelu; 5 5) taotleja kinnitus okupatsioonirežiimide poolt represseeritud isiku seaduse § 2 lõikes 3 või § 4 lõikes 2 sätestatud välistavate asjaolude puudumise kohta; 6 6) märge tunnistuse väljastamise viisi kohta; 7 7) taotleja kinnitus taotluse esitamise kohta. RT I 2016-12-08 2 108122016002 2017-01-01 Taotlusele kantakse järgmised andmed: taotluse esitamise kuupäev; taotleja nimi, isikukood ja kontaktandmed; taotleja selgitus, millisele okupatsioonirežiimide poolt represseeritud isiku seaduses sätestatud alusele taotleja enda vastavaks tunnistamist taotleb; taotlusele lisatud dokumentide loetelu; taotleja kinnitus okupatsioonirežiimide poolt represseeritud isiku seaduse § 2 lõikes 3 või § 4 lõikes 2 sätestatud välistavate asjaolude puudumise kohta; märge tunnistuse väljastamise viisi kohta; taotleja kinnitus taotluse esitamise kohta.",
      "rdfs:label": {
        "@value": "Reg_157240_Par_6 (redaktsioon 157240)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157240",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157240",
      "estleg:sourceAct": "Represseeritu tunnistuse andmise korra ning taotluse andmete loetelu ja tunnistuse vormi kehtestamine ning represseeritu tunnistusi väljastava asutuse määramine",
      "estleg:provisionRef": "Reg_157240 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157240_Map"
      }
    },
    {
      "@id": "estleg:Reg_157240_Par_7_v157240",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157240_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tunnistuse vorm on toodud käesoleva määruse lisas 2. Tunnistuse vorm on toodud käesoleva määruse lisas 2. 2 (2) Tunnistus on valgest plastikust, suurusega 55×85 mm. Tunnistus on valgest plastikust, suurusega 55×85 mm. 3 (3) Tunnistuse esiküljele kantakse järgmised andmed: 1 1) tunnistuse number; 2 2) isiku ees- ja perekonnanimi ning isikukood või selle puudumisel sünniaeg; 3 3) tunnistuse väljaandmise alus; 4 4) tunnistuse väljaandnud asutuse juhi või tema poolt volitatud isiku nimi ja allkiri; 5 5) väljaandja nimi ja pitser; 6 6) tunnistuse väljaandmise kuupäev. Tunnistuse esiküljele kantakse järgmised andmed: tunnistuse number; isiku ees- ja perekonnanimi ning isikukood või selle puudumisel sünniaeg; tunnistuse väljaandmise alus; tunnistuse väljaandnud asutuse juhi või tema poolt volitatud isiku nimi ja allkiri; väljaandja nimi ja pitser; tunnistuse väljaandmise kuupäev. 4 (4) Tunnistuse tagaküljel on väike riigivapp. Tunnistuse tagaküljel on väike riigivapp. 5 (5) Tunnistus kehtib koos isikut tõendava dokumendiga. Tunnistus kehtib koos isikut tõendava dokumendiga.",
      "rdfs:label": {
        "@value": "Reg_157240_Par_7 (redaktsioon 157240)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157240",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157240",
      "estleg:sourceAct": "Represseeritu tunnistuse andmise korra ning taotluse andmete loetelu ja tunnistuse vormi kehtestamine ning represseeritu tunnistusi väljastava asutuse määramine",
      "estleg:provisionRef": "Reg_157240 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157240_Map"
      }
    },
    {
      "@id": "estleg:Reg_157240_Par_8_v157240",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157240_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 1. jaanuarini 2005. a võib represseeritu «Okupatsioonirežiimide poolt represseeritud isiku seaduses» sätestatud hüvitiste või soodustuste taotlemisel kasutada represseeritu tunnistuse asemel rehabiliteerimistunnistust, arhiiviteatist või muud dokumenti, millest nähtub isiku represseerimine ja asumisel oleku või vangistuse aeg. Kuni 1. jaanuarini 2005. a võib represseeritu «Okupatsioonirežiimide poolt represseeritud isiku seaduses» sätestatud hüvitiste või soodustuste taotlemisel kasutada represseeritu tunnistuse asemel rehabiliteerimistunnistust, arhiiviteatist või muud dokumenti, millest nähtub isiku represseerimine ja asumisel oleku või vangistuse aeg.",
      "rdfs:label": {
        "@value": "Reg_157240_Par_8 (redaktsioon 157240)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157240",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157240",
      "estleg:sourceAct": "Represseeritu tunnistuse andmise korra ning taotluse andmete loetelu ja tunnistuse vormi kehtestamine ning represseeritu tunnistusi väljastava asutuse määramine",
      "estleg:provisionRef": "Reg_157240 § 8",
      "estleg:partOfAct": {
