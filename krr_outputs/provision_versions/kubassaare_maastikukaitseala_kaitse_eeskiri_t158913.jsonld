      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. RT I 2009 7 48 13125268 2009-02-01+02:00 Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_158913_Par_3 (redaktsioon 158913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158913",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158913",
      "estleg:sourceAct": "Kübassaare maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158913 § 3",
