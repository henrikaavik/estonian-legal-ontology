        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "RahaS_Par_7 (redaktsioon 13247019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13247019"
    },
    {
      "@id": "estleg:RahaS_Par_8_v24290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub Eesti krooni käibelelaskmise päevast. Tallinn, 20. mail 1992.",
      "rdfs:label": {
        "@value": "RahaS_Par_8 (redaktsioon 24290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24290",
      "estleg:supersededByVersion": {
        "@id": "estleg:RahaS_Par_8_v193155"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RahaS_Par_8_v193155",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub Eesti krooni käibelelaskmise päevast. Õiend Akti metaandmetes parandatud väljaandjaks Ülemnõukogu.",
      "rdfs:label": {
        "@value": "RahaS_Par_8 (redaktsioon 193155)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193155",
