  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_eesti_vabariigi_rahaseadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti Vabariigi rahaseadus (14 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti Vabariigi rahaseadus"
    },
    {
      "@id": "estleg:RahaS_Par_1_v24290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi rahaühik on Eesti kroon, mis jaguneb sajaks sendiks. Eesti Vabariigi sularaha käibib paberrahana (pangatähed) ja metallrahana (mündid).",
      "rdfs:label": {
        "@value": "RahaS_Par_1 (redaktsioon 24290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24290"
    },
    {
      "@id": "estleg:RahaS_Par_2_v24290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti krooni käibelelaskmise (emiteerimise) ja käibelt kõrvaldamise ainuõigus kuulub Eesti Pangale. Eesti Pank määrab pangatähtede ja müntide nimiväärtuse ning nende kujunduse.",
      "rdfs:label": {
        "@value": "RahaS_Par_2 (redaktsioon 24290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24290",
      "estleg:supersededByVersion": {
        "@id": "estleg:RahaS_Par_2_v193155"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RahaS_Par_2_v193155",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti krooni käibelelaskmise (emiteerimise) ja käibelt kõrvaldamise ainuõigus kuulub Eesti Pangale. pangatähtede ja müntide nimiväärtuse ning nende kujunduse.",
      "rdfs:label": {
        "@value": "RahaS_Par_2 (redaktsioon 193155)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193155"
    },
    {
      "@id": "estleg:RahaS_Par_3_v24290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ainus seaduslik maksevahend Eesti Vabariigis on Eesti kroon. Eesti Vabariigis asuvatel juriidilistel ja füüsilistel isikutel ei ole õigust kasutada omavahelistes arveldustes muid maksevahendeid peale Eesti krooni.",
      "rdfs:label": {
        "@value": "RahaS_Par_3 (redaktsioon 24290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24290"
    },
    {
      "@id": "estleg:RahaS_Par_4_v24290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Pank, samuti kõik teised Eesti Vabariigi pangad ja muud krediidiasutused on kohustatud kehtivat Eesti Vabariigi raha vastu võtma piiranguteta. Muud juriidilised isikud on kohustatud vastu võtma kehtivaid münte korraga kuni 20 Eesti krooni ulatuses, pangatähti aga piiranguteta.",
      "rdfs:label": {
        "@value": "RahaS_Par_4 (redaktsioon 24290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24290"
    },
    {
      "@id": "estleg:RahaS_Par_5_v24290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti krooni vahetatavus teiste valuutadega määratakse seadusega. Eesti krooni teiste valuutade vastu vahetamise tingimused ja korra määrab Eesti Pank.",
      "rdfs:label": {
        "@value": "RahaS_Par_5 (redaktsioon 24290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24290",
      "estleg:supersededByVersion": {
        "@id": "estleg:RahaS_Par_5_v193155"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RahaS_Par_5_v193155",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti krooni vahetatavus teiste valuutadega määratakse seadusega. Eesti krooni teiste valuutade vastu vahetamise tingimused ja korra",
      "rdfs:label": {
        "@value": "RahaS_Par_5 (redaktsioon 193155)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193155"
    },
    {
      "@id": "estleg:RahaS_Par_6_v24290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vigastatud ja rikutud Eesti Vabariigi pangatähti ja münte võtavad vastu ning asendavad uutega Eesti Pank ning tema volitatud pangad tingimusel, et pangatähest on säilinud rohkem kui pool ning on tervikuna loetav selle seeria ja number; mündil peab olema loetav vähemalt nimiväärtus ja vermimise aeg. Muud juriidilised isikud ei ole kohustatud vigastatud ja rikutud pangatähti ega münte vastu võtma.",
      "rdfs:label": {
        "@value": "RahaS_Par_6 (redaktsioon 24290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24290"
    },
    {
      "@id": "estleg:RahaS_Par_7_v24290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi raha järeletegemine nende käibelelaskmise eesmärgil või järeletehtud raha käibelelaskmine toob kaasa kriminaalvastutuse Eesti Vabariigi seaduste alusel.",
      "rdfs:label": {
        "@value": "RahaS_Par_7 (redaktsioon 24290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24290",
      "estleg:supersededByVersion": {
        "@id": "estleg:RahaS_Par_7_v193155"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RahaS_Par_7_v193155",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RahaS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RahaS_Par_7 (redaktsioon 193155)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193155",
      "estleg:supersededByVersion": {
