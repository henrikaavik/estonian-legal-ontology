    {
      "@id": "estleg:Reg_1055260_Par_11_v1055260",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055260_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse üksus esitab Regionaal- ja Põllumajandusministeeriumile lisas 2 toodud vormil toetuse kasutamise lõpparuande hiljemalt 2024. aasta 1. veebruaril. Teise täiendava vooru puhul esitatakse aruanne hiljemalt 2025. aasta 1. veebruaril. Lõpparuandes tuleb muu hulgas märkida käesoleva määruse § 9 lõikes 2 sätestatud toetuse jäägi kasutamine. RT I 2023-07-15 2 115072023002 2023-07-18 , rakendatakse tagasiulatuvalt 2023. aasta 1. juulist. Kohaliku omavalitsuse üksus esitab Regionaal- ja Põllumajandusministeeriumile lisas 2 toodud vormil toetuse kasutamise lõpparuande hiljemalt 2024. aasta 1. veebruaril. Teise täiendava vooru puhul esitatakse aruanne hiljemalt 2025. aasta 1. veebruaril. Lõpparuandes tuleb muu hulgas märkida käesoleva määruse § 9 lõikes 2 sätestatud toetuse jäägi kasutamine. , rakendatakse tagasiulatuvalt 2023. aasta 1. juulist.",
      "rdfs:label": {
        "@value": "Reg_1055260_Par_11 (redaktsioon 1055260)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055260",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055260",
      "estleg:sourceAct": "Kohaliku omavalitsuse üksustele Ukraina sõjapõgenikele eluruumide korrastamiseks toetuse andmise tingimused ja kord",
