        "@value": "Sätete redaktsioonid: Kohaliku omavalitsuse üksustele Ukraina sõjapõgenikele eluruumide korrastamiseks toetuse andmise tingimused ja kord (16 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kohaliku omavalitsuse üksustele Ukraina sõjapõgenikele eluruumide korrastamiseks toetuse andmise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1055260_Par_1_v1055260",
      "@type": [
