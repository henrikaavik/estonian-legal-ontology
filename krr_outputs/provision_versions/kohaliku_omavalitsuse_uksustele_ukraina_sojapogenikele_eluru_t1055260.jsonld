        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui §-s 14 sätestatud kohaliku omavalitsuse üksuselt toetuse tagasinõudmise on tinginud eraõigusliku isiku üürilepingu või toetuslepingu rikkumine, võib kohaliku omavalitsuse üksus nõuda üüri ettemakse või toetuse eraõiguslikult isikult tagasi võlaõigusseaduses või kohaliku omavalitsuse üksuse kehtestatud tingimuste ja korra kohaselt. Kui §-s 14 sätestatud kohaliku omavalitsuse üksuselt toetuse tagasinõudmise on tinginud eraõigusliku isiku üürilepingu või toetuslepingu rikkumine, võib kohaliku omavalitsuse üksus nõuda üüri ettemakse või toetuse eraõiguslikult isikult tagasi võlaõigusseaduses või kohaliku omavalitsuse üksuse kehtestatud tingimuste ja korra kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1055260_Par_15 (redaktsioon 1055260)",
        "@language": "et"
      },
