      },
      "estleg:versionText": "Sadama registreerimistaotlusel kajastatakse sadamas teenindatavate veesõidukite liik ja kasutuspiirangud. Sadama registreerimistaotlusel kajastatakse sadamas teenindatavate veesõidukite liik ja kasutuspiirangud.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_8 (redaktsioon 1053857)",
        "@language": "et"
      },
