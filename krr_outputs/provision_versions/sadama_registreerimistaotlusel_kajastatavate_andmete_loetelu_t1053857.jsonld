    {
      "@id": "estleg:Reg_1053857_Par_2_v1053857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053857_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama registreerimistaotlusel kajastatakse järgmised sadama põhiandmed: 1 1) sadama nimi, mis on määratud vastavalt kohanimeseadusele; 2 2) sadama aadress; 3 3) sadama telefoninumber, veebiaadress, e-posti aadress ja faksinumber; 4 4) veekogu, millel asub sadama akvatoorium, liik ja nimi; 5 5) navigatsiooniperioodi algus ja lõpp; 6 6) sadama ülesanne – sadamateenuseid osutatakse sõltumata veesõiduki suurusest / sadamateenuseid osutatakse vaid alla 24-meetrise kogupikkusega veesõidukitele / väikesadam, kus ei osutata tasulisi sadamateenuseid; 7 7) märge selle kohta, kas sadamas on võimalik teenindada välisriigi veesõidukit. Sadama registreerimistaotlusel kajastatakse järgmised sadama põhiandmed: sadama nimi, mis on määratud vastavalt kohanimeseadusele; sadama aadress; sadama telefoninumber, veebiaadress, e-posti aadress ja faksinumber; veekogu, millel asub sadama akvatoorium, liik ja nimi; navigatsiooniperioodi algus ja lõpp; sadama ülesanne – sadamateenuseid osutatakse sõltumata veesõiduki suurusest / sadamateenuseid osutatakse vaid alla 24-meetrise kogupikkusega veesõidukitele / väikesadam, kus ei osutata tasulisi sadamateenuseid; märge selle kohta, kas sadamas on võimalik teenindada välisriigi veesõidukit.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_2 (redaktsioon 1053857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053857",
      "estleg:sourceAct": "Sadama registreerimistaotlusel kajastatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1053857 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053857_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053857_Par_3_v1053857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053857_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama registreerimistaotlusel kajastatakse järgmised sadama tehnilised andmed: 1 1) suurima sadamas teenindatava veesõiduki kogumahutavus; 2 2) sadamas teenindatava veesõiduki suurim süvis meetrites; 3 3) sadamas teenindatava veesõiduki suurim laius meetrites; 4 4) sadamas teenindatava veesõiduki suurim pikkus meetrites; 5 5) sadama sissesõidutee väikseim laius meetrites; 6 6) sadama sissesõidutee väikseim sügavus meetrites. Sadama registreerimistaotlusel kajastatakse järgmised sadama tehnilised andmed: suurima sadamas teenindatava veesõiduki kogumahutavus; sadamas teenindatava veesõiduki suurim süvis meetrites; sadamas teenindatava veesõiduki suurim laius meetrites; sadamas teenindatava veesõiduki suurim pikkus meetrites; sadama sissesõidutee väikseim laius meetrites; sadama sissesõidutee väikseim sügavus meetrites.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_3 (redaktsioon 1053857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053857",
      "estleg:sourceAct": "Sadama registreerimistaotlusel kajastatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1053857 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053857_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053857_Par_4_v1053857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053857_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama registreerimistaotlusel kajastatakse järgmised sadama pidaja andmed: 1 1) nimi; 2 2) isiku- või registrikood; 3 3) kontaktisiku nimi; 4 4) aadress, telefoninumber, veebiaadress, e-posti aadress ja faksinumber. Sadama registreerimistaotlusel kajastatakse järgmised sadama pidaja andmed: nimi; isiku- või registrikood; kontaktisiku nimi; aadress, telefoninumber, veebiaadress, e-posti aadress ja faksinumber.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_4 (redaktsioon 1053857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053857",
      "estleg:sourceAct": "Sadama registreerimistaotlusel kajastatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1053857 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053857_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053857_Par_5_v1053857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053857_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama, välja arvatud tasulisi teenuseid mitteosutava väikesadama registreerimistaotlusel kajastatakse järgmised sadamakapteni andmed: 1 1) ees- ja perekonnanimi; 2 2) isikukood; 3 3) kodakondsus; 4 4) telefoninumber ja e-posti aadress; 5 5) meresõidudiplomi või väikelaevajuhi tunnistuse number; 6 6) atesteerimise kuupäev, kui sadamakapten kuulub atesteerimisele. Sadama, välja arvatud tasulisi teenuseid mitteosutava väikesadama registreerimistaotlusel kajastatakse järgmised sadamakapteni andmed: ees- ja perekonnanimi; isikukood; kodakondsus; telefoninumber ja e-posti aadress; meresõidudiplomi või väikelaevajuhi tunnistuse number; atesteerimise kuupäev, kui sadamakapten kuulub atesteerimisele.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_5 (redaktsioon 1053857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053857",
      "estleg:sourceAct": "Sadama registreerimistaotlusel kajastatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1053857 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053857_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053857_Par_6_v1053857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053857_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama registreerimistaotlusel kajastatakse järgmised sadama maa-ala andmed: 1 1) pindala ruutmeetrites; 2 2) maa-ala piirid Maa- ja Ruumiameti geoportaali kaardirakendusest; RT I 2024-12-27 3 127122024003 2025-01-01 3 3) maa-alasse jäävate katastriüksuste tunnused; 4 4) sadama maa-ala kaldajoone punkti koordinaadid. Sadama registreerimistaotlusel kajastatakse järgmised sadama maa-ala andmed: pindala ruutmeetrites; maa-ala piirid Maa- ja Ruumiameti geoportaali kaardirakendusest; maa-alasse jäävate katastriüksuste tunnused; sadama maa-ala kaldajoone punkti koordinaadid.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_6 (redaktsioon 1053857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053857",
      "estleg:sourceAct": "Sadama registreerimistaotlusel kajastatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1053857 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053857_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053857_Par_7_v1053857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053857_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama, välja arvatud tasulisi teenuseid mitteosutava väikesadama registreerimistaotlusel kajastatakse järgmised sadama akvatooriumi andmed: 1 1) akvatooriumi määramise õigusakti väljaandja asutus, liik, number ja väljaandmise kuupäev; 2 2) akvatooriumi pindala ruutmeetrites; 3 3) akvatooriumi piiripunktide koordinaadid. Sadama, välja arvatud tasulisi teenuseid mitteosutava väikesadama registreerimistaotlusel kajastatakse järgmised sadama akvatooriumi andmed: akvatooriumi määramise õigusakti väljaandja asutus, liik, number ja väljaandmise kuupäev; akvatooriumi pindala ruutmeetrites; akvatooriumi piiripunktide koordinaadid.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_7 (redaktsioon 1053857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053857",
      "estleg:sourceAct": "Sadama registreerimistaotlusel kajastatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1053857 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053857_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053857_Par_8_v1053857",
