      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Sadama registreerimistaotlusel kajastatavate andmete loetelu (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Sadama registreerimistaotlusel kajastatavate andmete loetelu"
    },
    {
      "@id": "estleg:Reg_1053857_Par_1_v1053857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053857_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama registreerimistaotlusel kajastatakse sadama põhiandmed, tehnilised andmed, sadama pidaja andmed, sadamakapteni andmed, maa-ala andmed, akvatooriumi andmed, teenindatavad veesõidukid, sadamateenused ja ehitiste andmed. Sadama registreerimistaotlusel kajastatakse sadama põhiandmed, tehnilised andmed, sadama pidaja andmed, sadamakapteni andmed, maa-ala andmed, akvatooriumi andmed, teenindatavad veesõidukid, sadamateenused ja ehitiste andmed.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_1 (redaktsioon 1053857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053857",
      "estleg:sourceAct": "Sadama registreerimistaotlusel kajastatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1053857 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053857_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053857_Par_10_v1053857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053857_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama registreerimistaotlusel kajastatakse järgmised sadama ehitiste andmed: 1 1) ehitise liik; 2 2) ehitise alamliik; 3 3) ehitise tehnilised andmed vastavalt ehitise liigile; 4 4) kai alamliik; 5 5) kai nimi; 6 6) kai ehitisregistri kood; 7 7) kai pikkus meetrites; 8 8) kai laius meetrites; 9 9) sügavus kai ääres meetrites; 10 10) kai kasutusperiood; 11 11) kail teenindatavad veesõidukid; 12 12) vendri tüüp ja arv; 13 13) haalamispollari tüüp ja arv; 14 14) rampide arv; 15 15) võimalus kail varustada kütuse, joogivee või elektriga. Sadama registreerimistaotlusel kajastatakse järgmised sadama ehitiste andmed: ehitise liik; ehitise alamliik; ehitise tehnilised andmed vastavalt ehitise liigile; kai alamliik; kai nimi; kai ehitisregistri kood; kai pikkus meetrites; kai laius meetrites; sügavus kai ääres meetrites; kai kasutusperiood; kail teenindatavad veesõidukid; vendri tüüp ja arv; haalamispollari tüüp ja arv; rampide arv; võimalus kail varustada kütuse, joogivee või elektriga.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_10 (redaktsioon 1053857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053857",
      "estleg:sourceAct": "Sadama registreerimistaotlusel kajastatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1053857 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053857_Map"
      }
    },
    {
