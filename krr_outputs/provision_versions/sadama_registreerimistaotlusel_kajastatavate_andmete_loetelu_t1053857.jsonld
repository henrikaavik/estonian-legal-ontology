    {
      "@id": "estleg:Reg_1053857_Par_9_v1053857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053857_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama registreerimistaotlusel kajastatakse järgmised sadamateenuste andmed: 1 1) põhiteenuse liik ja kirjeldus; 2 2) põhiteenuse osutaja nimi, registrikood, aadress, telefoninumber, veebiaadress, e-posti aadress ja faksinumber; 3 3) lisateenuse liik, nimetus ja kirjeldus; 4 4) lisateenuse osutaja nimi, registrikood, aadress, telefoninumber, veebiaadress, e-posti aadress ja faksinumber; 5 5) sadamas käideldava kaubagrupi liik; 6 6) abilaevade nimi, registritunnus ja kasutusotstarve; 7 7) tehnilise vahendi liik, nimetus ja kasutustingimused. Sadama registreerimistaotlusel kajastatakse järgmised sadamateenuste andmed: põhiteenuse liik ja kirjeldus; põhiteenuse osutaja nimi, registrikood, aadress, telefoninumber, veebiaadress, e-posti aadress ja faksinumber; lisateenuse liik, nimetus ja kirjeldus; lisateenuse osutaja nimi, registrikood, aadress, telefoninumber, veebiaadress, e-posti aadress ja faksinumber; sadamas käideldava kaubagrupi liik; abilaevade nimi, registritunnus ja kasutusotstarve; tehnilise vahendi liik, nimetus ja kasutustingimused.",
      "rdfs:label": {
        "@value": "Reg_1053857_Par_9 (redaktsioon 1053857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053857",
