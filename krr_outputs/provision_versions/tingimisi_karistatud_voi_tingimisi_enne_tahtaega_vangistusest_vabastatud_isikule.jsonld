      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tingimisi karistatud või tingimisi enne tähtaega vangistusest vabastatud isikule käitumiskontrolli kohaldamise Euroopa konventsiooni ratifitseerimise seadus (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tingimisi karistatud või tingimisi enne tähtaega vangistusest vabastatud isikule käitumiskontrolli kohaldamise Euroopa konventsiooni ratifitseerimise seadus"
    },
    {
      "@id": "estleg:TKVTETVVIKKE_Par_1_v867994",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TKVTETVVIKKE_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida , mis on koostatud 1964. aasta 30. novembril Strasbourg’is ning millele Eesti Vabariik kirjutas alla 2001. aasta 19. juulil.",
      "rdfs:label": {
        "@value": "TKVTETVVIKKE_Par_1 (redaktsioon 867994)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "867994",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/867994",
      "estleg:sourceAct": "Tingimisi karistatud või tingimisi enne tähtaega vangistusest vabastatud isikule käitumiskontrolli kohaldamise Euroopa konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "TKVTETVVIKKE § 1",
      "estleg:partOfAct": {
        "@id": "estleg:TKVTETVVIKKE_Map_2026"
      }
    },
    {
      "@id": "estleg:TKVTETVVIKKE_Par_2_v867994",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TKVTETVVIKKE_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerimisel teha järgmine deklaratsioon: Konventsiooni artikli 29 lõike 2 alusel deklareerib Eesti Vabariik, et Eestile tuleb esitada taotlused ja lisadokumendid koos ingliskeelse tõlkega.",
      "rdfs:label": {
        "@value": "TKVTETVVIKKE_Par_2 (redaktsioon 867994)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "867994",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/867994",
      "estleg:sourceAct": "Tingimisi karistatud või tingimisi enne tähtaega vangistusest vabastatud isikule käitumiskontrolli kohaldamise Euroopa konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "TKVTETVVIKKE § 2",
      "estleg:partOfAct": {
        "@id": "estleg:TKVTETVVIKKE_Map_2026"
      }
    },
    {
      "@id": "estleg:TKVTETVVIKKE_Par_3_v867994",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TKVTETVVIKKE_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerimisel teha järgmine reservatsioon: Konventsiooni artikli 38 lõike 1 alusel teatab Eesti Vabariik, et ta ei rakenda konventsiooni III ja IV osa.",
      "rdfs:label": {
        "@value": "TKVTETVVIKKE_Par_3 (redaktsioon 867994)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "867994",
