  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_digitaalse_soidumeerikuga_mootorsoiduki_juhikaardi_ettevotte_t1040854_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Digitaalse sõidumeerikuga mootorsõiduki juhikaardi, ettevõttekaardi, töökojakaardi ja kontrollikaardi taotlemise ja väljastamise kord (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Digitaalse sõidumeerikuga mootorsõiduki juhikaardi, ettevõttekaardi, töökojakaardi ja kontrollikaardi taotlemise ja väljastamise kord"
    },
    {
      "@id": "estleg:Reg_1040854_Par_1_v1040854",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040854_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Juhikaardi taotlemiseks esitatakse Maanteeametile: 1 1) taotlus; 2 2) isikut tõendav dokument; 3 3) kehtiv juhiluba, kui liiklusregistris selle kohta andmed puuduvad; 4 4) isikut tõendavate dokumentide seaduse § 15 lõike 7 alusel kehtestatud õigusakti nõuetele vastav foto või näokujutis, kui seda ei ole liiklusregistris või isikut tõendavate dokumentide andmekogus või kui see on nimetatud andmekogudes vanem kui viis aastat; 5 5) allkirjakujutis, kui seda ei ole liiklusregistris või isikut tõendavate dokumentide andmekogus. Juhikaardi taotlemiseks esitatakse Maanteeametile: taotlus; isikut tõendav dokument; kehtiv juhiluba, kui liiklusregistris selle kohta andmed puuduvad; isikut tõendavate dokumentide seaduse § 15 lõike 7 alusel kehtestatud õigusakti nõuetele vastav foto või näokujutis, kui seda ei ole liiklusregistris või isikut tõendavate dokumentide andmekogus või kui see on nimetatud andmekogudes vanem kui viis aastat; allkirjakujutis, kui seda ei ole liiklusregistris või isikut tõendavate dokumentide andmekogus. 2 (2) Kui liiklusregistris või isikut tõendavate dokumentide andmekogus on olemas taotleja allkirjakujutis ja kuni viie aasta vanune foto või näokujutis, võib juhikaarti taotleda ka elektroonselt. Kui liiklusregistris või isikut tõendavate dokumentide andmekogus on olemas taotleja allkirjakujutis ja kuni viie aasta vanune foto või näokujutis, võib juhikaarti taotleda ka elektroonselt.",
      "rdfs:label": {
        "@value": "Reg_1040854_Par_1 (redaktsioon 1040854)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040854",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040854",
      "estleg:sourceAct": "Digitaalse sõidumeerikuga mootorsõiduki juhikaardi, ettevõttekaardi, töökojakaardi ja kontrollikaardi taotlemise ja väljastamise kord",
      "estleg:provisionRef": "Reg_1040854 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040854_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040854_Par_2_v1040854",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040854_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Töökojakaardi taotlemiseks esitatakse Maanteeametile taotlus, milles sisaldub: 1 1) isiku, kelle nimele kaarti taotletakse, ees- ja perekonnanimi ning isikukood; 2 2) töö- või võlaõigusliku lepingu sõlmimise kuupäev ja selle kehtivusaeg. Töökojakaardi taotlemiseks esitatakse Maanteeametile taotlus, milles sisaldub: isiku, kelle nimele kaarti taotletakse, ees- ja perekonnanimi ning isikukood; töö- või võlaõigusliku lepingu sõlmimise kuupäev ja selle kehtivusaeg. 2 (2) Lisaks taotlusele esitatakse Maanteeametile: 1 1) isiku, kelle nimele kaarti taotletakse, kirjalik kinnitus kaardi taotlemiseks; 2 2) isiku, kelle nimele kaarti taotletakse, kirjalik nõusolek, kui kaardi tegemisel soovitakse kasutada isikut tõendavate dokumentide andmekogus olevat fotot ja allkirjakujutist; 3 3) isiku, kelle nimele kaarti taotletakse, isikut tõendavate dokumentide seaduse § 15 lõike 7 alusel kehtestatud õigusakti nõuetele vastav foto või näokujutis, kui seda ei ole liiklusregistris või isikut tõendavate dokumentide andmekogus või kui see on nimetatud andmekogudes vanem kui viis aastat; 4 4) isiku, kelle nimele kaarti taotletakse, allkirjakujutis, kui seda ei ole liiklusregistris või isikut tõendavate dokumentide andmekogus; 5 5) töökoja esindusõigusega isiku isikut tõendav dokument. Lisaks taotlusele esitatakse Maanteeametile: isiku, kelle nimele kaarti taotletakse, kirjalik kinnitus kaardi taotlemiseks; isiku, kelle nimele kaarti taotletakse, kirjalik nõusolek, kui kaardi tegemisel soovitakse kasutada isikut tõendavate dokumentide andmekogus olevat fotot ja allkirjakujutist; isiku, kelle nimele kaarti taotletakse, isikut tõendavate dokumentide seaduse § 15 lõike 7 alusel kehtestatud õigusakti nõuetele vastav foto või näokujutis, kui seda ei ole liiklusregistris või isikut tõendavate dokumentide andmekogus või kui see on nimetatud andmekogudes vanem kui viis aastat; isiku, kelle nimele kaarti taotletakse, allkirjakujutis, kui seda ei ole liiklusregistris või isikut tõendavate dokumentide andmekogus; töökoja esindusõigusega isiku isikut tõendav dokument. 3 (3) Kui isik, kelle nimele on väljastatud töökojakaart, on töösuhtes mitme töökojaga, võib isiku nimel olla iga töökoja kohta ainult üks kaart. Kui isik, kelle nimele on väljastatud töökojakaart, on töösuhtes mitme töökojaga, võib isiku nimel olla iga töökoja kohta ainult üks kaart. 4 (4) Kui liiklusregistris või isikut tõendavate dokumentide andmekogus on olemas isiku, kelle nimele töökojakaarti taotletakse, allkirjakujutis ja kuni viie aasta vanune näokujutis või foto, võib kaarti taotleda ka elektroonselt. Kui liiklusregistris või isikut tõendavate dokumentide andmekogus on olemas isiku, kelle nimele töökojakaarti taotletakse, allkirjakujutis ja kuni viie aasta vanune näokujutis või foto, võib kaarti taotleda ka elektroonselt.",
      "rdfs:label": {
        "@value": "Reg_1040854_Par_2 (redaktsioon 1040854)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040854",
