      "estleg:provisionRef": "Reg_1040854 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040854_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040854_Par_3_v1040854",
      "@type": [
        "owl:NamedIndividual",
