        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõttekaardi ja kontrollikaardi väljastamiseks esitatakse Maanteeametile taotlus. Ettevõttekaardi ja kontrollikaardi väljastamiseks esitatakse Maanteeametile taotlus.",
      "rdfs:label": {
        "@value": "Reg_1040854_Par_3 (redaktsioon 1040854)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040854",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040854",
      "estleg:sourceAct": "Digitaalse sõidumeerikuga mootorsõiduki juhikaardi, ettevõttekaardi, töökojakaardi ja kontrollikaardi taotlemise ja väljastamise kord",
      "estleg:provisionRef": "Reg_1040854 § 3",
      "estleg:partOfAct": {
