        "@id": "estleg:Reg_1047739_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047739_Par_2_v1047739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047739_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veekeskkonnariskiga tegevuse registreerimisel märgitakse: 1 1) registreeringu saaja nimi ja registrikood või isikukood; 2 2) registreeringu saaja aadress, e-postiaadress ja telefoninumber; 3 3) registreeritud tegevuse kirjeldus ja iseloomustus; 4 4) registreeritud tegevuse asukoha koordinaadid ja kirjeldus; 5 5) mõjutatava veekogu või mereosa nimi; 6 6) andmete olemasolul veekogu Eesti looduse infosüsteemi registrikood ja kinnistu katastri number; RT I 2022-06-27 1 127062022001 2022-06-30 7 7) registreeritud tegevuse pinnavee või põhjavee omadustele, vee-elustikule või veega seotud elustikule avalduva võimaliku ebasoodsa mõju kirjeldus; 8 8) vajadusel registreeritud tegevusele seatud kõrvaltingimused; 9 9) registreeringu kehtivusaeg; 10 10) õiguslik alus ja faktilised asjaolud, mille alusel on registreering tehtud; 11 11) vaidlustamisviide; 12 12) registreerija andmed. Veekeskkonnariskiga tegevuse registreerimisel märgitakse: registreeringu saaja nimi ja registrikood või isikukood; registreeringu saaja aadress, e-postiaadress ja telefoninumber; registreeritud tegevuse kirjeldus ja iseloomustus; registreeritud tegevuse asukoha koordinaadid ja kirjeldus; mõjutatava veekogu või mereosa nimi; andmete olemasolul veekogu Eesti looduse infosüsteemi registrikood ja kinnistu katastri number; registreeritud tegevuse pinnavee või põhjavee omadustele, vee-elustikule või veega seotud elustikule avalduva võimaliku ebasoodsa mõju kirjeldus; vajadusel registreeritud tegevusele seatud kõrvaltingimused; registreeringu kehtivusaeg; õiguslik alus ja faktilised asjaolud, mille alusel on registreering tehtud; vaidlustamisviide; registreerija andmed.",
      "rdfs:label": {
