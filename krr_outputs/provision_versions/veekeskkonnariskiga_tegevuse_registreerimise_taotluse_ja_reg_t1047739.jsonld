        "@value": "Sätete redaktsioonid: Veekeskkonnariskiga tegevuse registreerimise taotluse ja registreeringu andmekoosseis (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Veekeskkonnariskiga tegevuse registreerimise taotluse ja registreeringu andmekoosseis"
    },
    {
      "@id": "estleg:Reg_1047739_Par_1_v1047739",
      "@type": [
