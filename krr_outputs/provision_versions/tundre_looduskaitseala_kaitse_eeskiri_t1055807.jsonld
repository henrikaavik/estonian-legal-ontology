        "@value": "2023-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1055807_Par_3 (redaktsioon 1055807)",
        "@language": "et"
      },
