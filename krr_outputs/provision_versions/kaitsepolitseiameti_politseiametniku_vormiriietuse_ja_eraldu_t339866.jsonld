    {
      "@id": "estleg:Reg_339866_Par_5_v339866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339866_Par_5"
