      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Püksirihm, naistel seelikuvöö, on mustast nahast, ühe keelega, oksüdeeritud kuldse pandlaga. Rihma laius meestel on 35 mm ja naistel 30 mm. Püksirihm, naistel seelikuvöö, on mustast nahast, ühe keelega, oksüdeeritud kuldse pandlaga. Rihma laius meestel on 35 mm ja naistel 30 mm.",
      "rdfs:label": {
        "@value": "Reg_339866_Par_17 (redaktsioon 339866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339866",
