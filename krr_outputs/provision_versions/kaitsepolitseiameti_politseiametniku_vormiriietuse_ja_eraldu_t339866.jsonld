      }
    },
    {
      "@id": "estleg:Reg_339866_Par_27_v339866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339866_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Meeste õhtuvormi kingad on mustast lakknahast. Meeste õhtuvormi kingad on mustast lakknahast. 2 (2) Naiste õhtuvormi kingad on pidulikud kinnised mustast nahast kingad. Naiste õhtuvormi kingad on pidulikud kinnised mustast nahast kingad.",
