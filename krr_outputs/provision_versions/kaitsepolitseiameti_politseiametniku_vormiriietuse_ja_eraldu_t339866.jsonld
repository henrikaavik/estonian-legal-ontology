        "@value": "2020-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. jaanuaril 2010. a. Määrus jõustub 1. jaanuaril 2010. a.",
      "rdfs:label": {
        "@value": "Reg_339866_Par_35 (redaktsioon 339866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339866",
