    {
      "@id": "estleg:Reg_339866_Par_6_v339866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339866_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jope on polüesterriidest, mille vooder on polüesterriidest ühes toonis pealismaterjaliga. Sirgelõikelisel jopel on lamav krae. Jopel on liistuga sissetöödeldud kaldega küljetaskud ning varrukaava ja allääre pingutamiseks on vorminööpidega 50 mm laiused tripid. Jope seljaosa vööjoone reguleerimiseks on sisseõmmeldud seosepael. Jope seljal ja vasakul pool rinna kohal on sõna KAITSEPOLITSEI või sõna KAPO. RT I 2020-05-08 23 108052020023 2020-05-11 Jope on polüesterriidest, mille vooder on polüesterriidest ühes toonis pealismaterjaliga. Sirgelõikelisel jopel on lamav krae. Jopel on liistuga sissetöödeldud kaldega küljetaskud ning varrukaava ja allääre pingutamiseks on vorminööpidega 50 mm laiused tripid. Jope seljaosa vööjoone reguleerimiseks on sisseõmmeldud seosepael. Jope seljal ja vasakul pool rinna kohal on sõna KAITSEPOLITSEI või sõna KAPO. 2 (2) Välivormi jope on tõmblukuga, taskute ja eemaldatava kapuutsiga ning puusajooneni ulatuva pikkusega. Jope vasakul hõlmal ja seljal võib kasutada sõnu KAPO ja KAITSEPOLITSEI. Jope vasakul varrukal võib kasutada varrukaembleemi. RT I 2020-05-08 23 108052020023 2020-05-11 Välivormi jope on tõmblukuga, taskute ja eemaldatava kapuutsiga ning puusajooneni ulatuva pikkusega. Jope vasakul hõlmal ja seljal võib kasutada sõnu KAPO ja KAITSEPOLITSEI. Jope vasakul varrukal võib kasutada varrukaembleemi.",
      "rdfs:label": {
        "@value": "Reg_339866_Par_6 (redaktsioon 339866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339866",
      "estleg:sourceAct": "Kaitsepolitseiameti politseiametniku vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_339866 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339866_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_339866_Par_6_6_v339866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339866_Par_6_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vormijakk on pikkade varrukate, kraest kuni rinnakuni tõmblukuga. Varrukatel on taskud. Vormijaki vasakul varrukal võib kasutada varrukaembleemi. Vormijakk on pikkade varrukate, kraest kuni rinnakuni tõmblukuga. Varrukatel on taskud. Vormijaki vasakul varrukal võib kasutada varrukaembleemi. 2 (2) Tuulejakk on tõmblukuga, pikkade varrukatega. Tuulejaki vasakul hõlmal võib kasutada sõnu KAPO ja KAITSEPOLITSEI. Tuulejaki vasakul varrukal võib kasutada varrukaembleemi. RT I 2020-05-08 23 108052020023 2020-05-11 Tuulejakk on tõmblukuga, pikkade varrukatega. Tuulejaki vasakul hõlmal võib kasutada sõnu KAPO ja KAITSEPOLITSEI. Tuulejaki vasakul varrukal võib kasutada varrukaembleemi.",
      "rdfs:label": {
        "@value": "Reg_339866_Par_6_6 (redaktsioon 339866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339866",
      "estleg:sourceAct": "Kaitsepolitseiameti politseiametniku vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_339866 § 6_6",
