      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhtuvormi seelik on õhtuvormi kuuega samast materjalist, sirgelõikeline ja kaetud voldiga. Seeliku allääre kõrgus maast on 15–20 cm. Õhtuvormi seelik on õhtuvormi kuuega samast materjalist, sirgelõikeline ja kaetud voldiga. Seeliku allääre kõrgus maast on 15–20 cm.",
      "rdfs:label": {
