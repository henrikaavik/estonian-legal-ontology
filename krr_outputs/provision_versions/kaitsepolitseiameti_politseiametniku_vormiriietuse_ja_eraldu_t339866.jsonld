    {
      "@id": "estleg:Reg_339866_Par_8_v339866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339866_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Bleiser on lahtise nurkkaelusega, üherealine, kergelt taljesse töödeldud. Hõlmade allosas on kaldega, sissetöödeldud kahe liistuga nööpauktaskud. Bleiseri esikinnis on suletav nelja suure vorminööbiga. Varruka allääre küünarnukiõmbluses on kolm väikest vorminööpi. Vasaku varruka välisküljele on tikitud varrukaembleem. Bleiseri pagunid kinnituvad õlgadele väikese vorminööbiga. Bleiser on lahtise nurkkaelusega, üherealine, kergelt taljesse töödeldud. Hõlmade allosas on kaldega, sissetöödeldud kahe liistuga nööpauktaskud. Bleiseri esikinnis on suletav nelja suure vorminööbiga. Varruka allääre küünarnukiõmbluses on kolm väikest vorminööpi. Vasaku varruka välisküljele on tikitud varrukaembleem. Bleiseri pagunid kinnituvad õlgadele väikese vorminööbiga.",
      "rdfs:label": {
        "@value": "Reg_339866_Par_8 (redaktsioon 339866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339866",
      "estleg:sourceAct": "Kaitsepolitseiameti politseiametniku vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_339866 § 8",
