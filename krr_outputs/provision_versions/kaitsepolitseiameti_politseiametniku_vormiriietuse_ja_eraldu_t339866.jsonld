    },
    {
      "@id": "estleg:Reg_339866_Par_18_v339866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339866_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kombinesoon on ühe- või kaheosaline musta värvi mittesüttivast ja veekindlast riidest. Kombinesoonil on püstkrae ja taskud. Vasakul varrukal on varrukaembleem. Parema rinnatasku kohal ning seljal on sõna KAITSEPOLITSEI või KAPO. Tõmblukud ja trukknööpide kübarad on musta värvi oksüdeeritud metallist. Kombinesooni peal on lubatud kanda soomusvesti või muud kuulikindlat vesti, mille esi- ja tagaküljel on sõna KAITSEPOLITSEI või KAPO. Kombinesoon on ühe- või kaheosaline musta värvi mittesüttivast ja veekindlast riidest. Kombinesoonil on püstkrae ja taskud. Vasakul varrukal on varrukaembleem. Parema rinnatasku kohal ning seljal on sõna KAITSEPOLITSEI või KAPO. Tõmblukud ja trukknööpide kübarad on musta värvi oksüdeeritud metallist. Kombinesooni peal on lubatud kanda soomusvesti või muud kuulikindlat vesti, mille esi- ja tagaküljel on sõna KAITSEPOLITSEI või KAPO.",
      "rdfs:label": {
        "@value": "Reg_339866_Par_18 (redaktsioon 339866)",
        "@language": "et"
      },
