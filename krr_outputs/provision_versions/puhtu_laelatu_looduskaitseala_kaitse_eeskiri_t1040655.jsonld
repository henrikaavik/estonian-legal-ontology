    {
      "@id": "estleg:Reg_1040655_Par_10_v1040655",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040655_Par_10"
