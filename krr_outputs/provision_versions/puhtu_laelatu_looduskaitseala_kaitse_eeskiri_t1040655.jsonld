      "estleg:sourceAct": "Puhtu-Laelatu looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1040655 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040655_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1040655_Par_3_v1040655",
