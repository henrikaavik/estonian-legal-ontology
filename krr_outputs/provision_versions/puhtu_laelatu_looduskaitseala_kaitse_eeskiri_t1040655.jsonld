      "estleg:provisionRef": "Reg_1040655 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040655_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1040655_Par_16_v1040655",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040655_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine, välja arvatud üksikkraavi rajamine kaitseala valitseja nõusolekul; 2 2) veekogude veetaseme ja kaldajoone muutmine; 3 3) maavara kaevandamine; 4 4) biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õue- ja põllumaal; 5 5) puhtpuistute kujundamine ja energiapuistute rajamine; 6 6) puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab; 7 7) Rame lahel Rõõmu silmas kalapüük lahvanduse tekkimisest jääkatte lagunemiseni. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine, välja arvatud üksikkraavi rajamine kaitseala valitseja nõusolekul; veekogude veetaseme ja kaldajoone muutmine; maavara kaevandamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õue- ja põllumaal; puhtpuistute kujundamine ja energiapuistute rajamine; puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab; Rame lahel Rõõmu silmas kalapüük lahvanduse tekkimisest jääkatte lagunemiseni.",
