    },
    {
      "@id": "estleg:Reg_1001123_Par_3_v1001123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001123_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemalt A-tasemel keeleoskust nõutakse isikutelt, kelle teenistuskohustused või tööülesanded on konkreetset laadi ning täpselt piiritletud, keelekasutusolukorrad on rutiinsed ja kirjalik töö piirdub tüüpdokumentide koostamise või plankide täitmisega. Vähemalt A-tasemel keeleoskust nõutakse isikutelt, kelle teenistuskohustused või tööülesanded on konkreetset laadi ning täpselt piiritletud, keelekasutusolukorrad on rutiinsed ja kirjalik töö piirdub tüüpdokumentide koostamise või plankide täitmisega.",
      "rdfs:label": {
        "@value": "Reg_1001123_Par_3 (redaktsioon 1001123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001123",
