    {
      "@id": "estleg:Reg_1001123_Par_2_v1001123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001123_Par_2"
