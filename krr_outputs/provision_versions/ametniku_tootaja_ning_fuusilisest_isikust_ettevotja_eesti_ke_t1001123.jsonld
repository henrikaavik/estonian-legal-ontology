    {
      "@id": "estleg:Reg_1001123_Par_4_v1001123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001123_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemalt B-tasemel keeleoskust nõutakse isikutelt, kelle teenistuskohustused või tööülesanded on mitmekesised ning võivad olla seotud asjaajamise, allüksuse juhtimise või koostööga, samuti tööks vajalike (etteantud sisuga) dokumentide koostamisega. Vähemalt B-tasemel keeleoskust nõutakse isikutelt, kelle teenistuskohustused või tööülesanded on mitmekesised ning võivad olla seotud asjaajamise, allüksuse juhtimise või koostööga, samuti tööks vajalike (etteantud sisuga) dokumentide koostamisega.",
      "rdfs:label": {
        "@value": "Reg_1001123_Par_4 (redaktsioon 1001123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001123",
