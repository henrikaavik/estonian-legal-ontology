      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ametniku, töötaja ning füüsilisest isikust ettevõtja eesti keele oskuse ja kasutamise nõuded (12 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ametniku, töötaja ning füüsilisest isikust ettevõtja eesti keele oskuse ja kasutamise nõuded"
    },
    {
      "@id": "estleg:Reg_1001123_Par_1_v1001123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001123_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse kohustusliku eesti keele oskuse tase (edaspidi keeleoskustase) „Keeleseaduse” § 23 lõigetes 1 ja 2 loetletud isikutele, samuti vastavate keelekasutusolukordade iseloomustused. Määrusega kehtestatakse kohustusliku eesti keele oskuse tase (edaspidi keeleoskustase) „Keeleseaduse” § 23 lõigetes 1 ja 2 loetletud isikutele, samuti vastavate keelekasutusolukordade iseloomustused.",
      "rdfs:label": {
        "@value": "Reg_1001123_Par_1 (redaktsioon 1001123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001123",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001123",
      "estleg:sourceAct": "Ametniku, töötaja ning füüsilisest isikust ettevõtja eesti keele oskuse ja kasutamise nõuded",
      "estleg:provisionRef": "Reg_1001123 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001123_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001123_Par_10_v1001123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
