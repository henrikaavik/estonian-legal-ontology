        "@value": "Sätete redaktsioonid: Nõuded tuleohutuse enesekontrollile ja tuleohutusaruandele ning tuleohutusaruande koostamise kohustuslikkuse kriteeriumid (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded tuleohutuse enesekontrollile ja tuleohutusaruandele ning tuleohutusaruande koostamise kohustuslikkuse kriteeriumid"
    },
    {
      "@id": "estleg:Reg_1000591_Par_1_v1000591",
      "@type": [
