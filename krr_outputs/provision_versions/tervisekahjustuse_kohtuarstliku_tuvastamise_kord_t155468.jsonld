      "estleg:provisionRef": "Reg_155468 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155468_Map"
      }
    },
    {
      "@id": "estleg:Reg_155468_Par_3_v155468",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155468_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekahjustuse tuvastamiseks teeb kohtuarstliku ekspertiisi kohtuarst või eksperdiks määratud muu isik (edaspidi ekspert) uurija, prokuröri või kohtu määruse alusel. Tervisekahjustuse tuvastamiseks teeb kohtuarstliku ekspertiisi kohtuarst või eksperdiks määratud muu isik (edaspidi ekspert) uurija, prokuröri või kohtu määruse alusel.",
      "rdfs:label": {
        "@value": "Reg_155468_Par_3 (redaktsioon 155468)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155468",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155468",
      "estleg:sourceAct": "Tervisekahjustuse kohtuarstliku tuvastamise kord",
      "estleg:provisionRef": "Reg_155468 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155468_Map"
      }
    },
    {
      "@id": "estleg:Reg_155468_Par_4_v155468",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
