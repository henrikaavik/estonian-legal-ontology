      }
    },
    {
      "@id": "estleg:Reg_155468_Par_2_v155468",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155468_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervisekahjustus tuvastatakse objektiivsete uuringute ja kliinilise leiu alusel. Tervisekahjustus tuvastatakse objektiivsete uuringute ja kliinilise leiu alusel. 2 (2) Tervisekahjustuse tuvastamisel arvestatakse isiku varasemat terviseseisundit, kui see on seotud temale tekitatud tervisekahjustusega. Tervisekahjustuse tuvastamisel arvestatakse isiku varasemat terviseseisundit, kui see on seotud temale tekitatud tervisekahjustusega.",
      "rdfs:label": {
        "@value": "Reg_155468_Par_2 (redaktsioon 155468)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155468",
