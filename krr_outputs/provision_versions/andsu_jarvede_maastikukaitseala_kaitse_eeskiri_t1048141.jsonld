      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048141",
      "estleg:sourceAct": "Andsu järvede maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1048141 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048141_Map"
      }
    },
