    {
      "@id": "estleg:Reg_1015605_Par_8_v1015605",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015605_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui täitematerjali, sealhulgas betooni või mördi täitematerjali, kasutusala ohutusnõuded on olulised, nagu näiteks kandekonstruktsioonide valmistamisel, toimub täitematerjali vastavushindamine toimivuse püsivuse hindamise ja kontrollimise süsteemi 2+ kohaselt. Kui täitematerjali, sealhulgas betooni või mördi täitematerjali, kasutusala ohutusnõuded on olulised, nagu näiteks kandekonstruktsioonide valmistamisel, toimub täitematerjali vastavushindamine toimivuse püsivuse hindamise ja kontrollimise süsteemi 2+ kohaselt. 2 (2) Käesoleva paragrahvi lõikes 1 nimetamata juhtudel toimub täitematerjali vastavushindamine toimivuse püsivuse hindamise ja kontrollimise süsteemi 4 kohaselt. Käesoleva paragrahvi lõikes 1 nimetamata juhtudel toimub täitematerjali vastavushindamine toimivuse püsivuse hindamise ja kontrollimise süsteemi 4 kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1015605_Par_8 (redaktsioon 1015605)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015605",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015605",
      "estleg:sourceAct": "Ehitusmaterjalidele ja -toodetele esitatavad nõuded ja nende nõuetele vastavuse tõendamise kord",
      "estleg:provisionRef": "Reg_1015605 § 8",
