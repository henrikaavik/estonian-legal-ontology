      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesvoolu kaitsevööndi ulatus ja kaitsevööndis tegutsemise kord (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesvoolu kaitsevööndi ulatus ja kaitsevööndis tegutsemise kord"
    },
    {
      "@id": "estleg:Reg_1045221_Par_1_v1045221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045221_Par_1"
