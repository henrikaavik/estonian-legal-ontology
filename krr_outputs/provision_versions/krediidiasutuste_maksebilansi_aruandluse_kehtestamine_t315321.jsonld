    },
    {
      "@id": "estleg:Reg_315321_Par_4_v315321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_315321_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahvis 3 nimetatud aruande aruandeperioodiks on kvartal. RT I2025-05-2731270520250032026-01-01 Paragrahvis 3 nimetatud aruande aruandeperioodiks on kvartal. 2 (2) Paragrahvis 3 nimetatud aruanne esitatakse 10. (kümnendaks) pangapäevaks pärast aruandeperioodi lõppu. RT I2025-05-2731270520250032026-01-01 Paragrahvis 3 nimetatud aruanne esitatakse 10. (kümnendaks) pangapäevaks pärast aruandeperioodi lõppu.",
      "rdfs:label": {
        "@value": "Reg_315321_Par_4 (redaktsioon 315321)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "315321",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/315321",
      "estleg:sourceAct": "Krediidiasutuste maksebilansi aruandluse kehtestamine",
      "estleg:provisionRef": "Reg_315321 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_315321_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_315321_Par_5_v315321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_315321_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aruanne esitatakse Eesti Pangale elektrooniliselt XML-is (eXtensible Markup Language) vormindatud dokumentidena Eesti Panga presidendi 29. mai 2018. aasta määruse nr 4 „Aruannete elektroonilise esitamise nõuded” (RT I, 05.06.2018, 1) kohaselt. RT I2025-05-2731270520250032026-01-01 Aruanne esitatakse Eesti Pangale elektrooniliselt XML-is (eXtensible Markup Language) vormindatud dokumentidena Eesti Panga presidendi 29. mai 2018. aasta määruse nr 4 „Aruannete elektroonilise esitamise nõuded” (RT I, 05.06.2018, 1) kohaselt. 2 (2) Vigade tuvastamisel ja arvestuspõhimõtete muutmisel esitatakse Eesti Pangale elektrooniliselt uued korrigeeritud aruanne. RT I2025-05-2731270520250032026-01-01 Vigade tuvastamisel ja arvestuspõhimõtete muutmisel esitatakse Eesti Pangale elektrooniliselt uued korrigeeritud aruanne. 3 (3) Aruandevaldkonda kuuluvate andmete puudumisel esitatakse tühi aruanne. Aruandevaldkonda kuuluvate andmete puudumisel esitatakse tühi aruanne.",
      "rdfs:label": {
        "@value": "Reg_315321_Par_5 (redaktsioon 315321)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "315321",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/315321",
      "estleg:sourceAct": "Krediidiasutuste maksebilansi aruandluse kehtestamine",
      "estleg:provisionRef": "Reg_315321 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_315321_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_315321_Par_6_v315321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_315321_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aruandes määratakse valuutakood vastavalt rahvusvahelise standardi ISO 4217 valuutakoodide tabelile ja näidatakse suurtähtedega. RT I2025-05-2731270520250032026-01-01 Aruandes määratakse valuutakood vastavalt rahvusvahelise standardi ISO 4217 valuutakoodide tabelile ja näidatakse suurtähtedega. 2 (2) Aruandes määratakse kliendi riigi kood vastavalt rahvusvahelise standardi ISO 3166-1 riikide ja territooriumide kahetäheliste koodide tabelile ja näidatakse suurtähtedega. RT I2025-05-2731270520250032026-01-01 Aruandes määratakse kliendi riigi kood vastavalt rahvusvahelise standardi ISO 3166-1 riikide ja territooriumide kahetäheliste koodide tabelile ja näidatakse suurtähtedega.",
      "rdfs:label": {
        "@value": "Reg_315321_Par_6 (redaktsioon 315321)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "315321",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/315321",
      "estleg:sourceAct": "Krediidiasutuste maksebilansi aruandluse kehtestamine",
      "estleg:provisionRef": "Reg_315321 § 6",
      "estleg:partOfAct": {
