      "estleg:sourceAct": "Kogukonnapõhise toetatud eluaseme toetamine",
      "estleg:provisionRef": "Reg_1057322 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057322_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057322_Par_6_v1057322",
      "@type": [
        "owl:NamedIndividual",
