      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057322_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Projekti abikõlblikkuse periood peab jääma vahemikku määruse jõustumise kuupäevast kuni 2028. aasta 31. detsembrini. Projekti abikõlblikkuse periood peab jääma vahemikku määruse jõustumise kuupäevast kuni 2028. aasta 31. detsembrini.",
