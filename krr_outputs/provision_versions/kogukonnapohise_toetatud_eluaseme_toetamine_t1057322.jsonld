    {
      "@id": "estleg:Reg_1057322_Par_21_v1057322",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057322_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluse rahuldamise otsus tunnistatakse osaliselt või täielikult kehtetuks vastavalt ühendmääruse §-s 14 või § 37 lõikes 7 sätestatule. Taotluse rahuldamise otsus tunnistatakse osaliselt või täielikult kehtetuks vastavalt ühendmääruse §-s 14 või § 37 lõikes 7 sätestatule. 2 (2) Toetuse saajal tuleb saadud toetus tagastada käesoleva paragrahvi lõikes 1 nimetatud otsuse kohaselt. Toetuse saajal tuleb saadud toetus tagastada käesoleva paragrahvi lõikes 1 nimetatud otsuse kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1057322_Par_21 (redaktsioon 1057322)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057322",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057322",
      "estleg:sourceAct": "Kogukonnapõhise toetatud eluaseme toetamine",
      "estleg:provisionRef": "Reg_1057322 § 21",
