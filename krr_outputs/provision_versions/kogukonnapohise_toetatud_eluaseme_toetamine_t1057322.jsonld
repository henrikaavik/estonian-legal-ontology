    },
    {
      "@id": "estleg:Reg_1057322_Par_7_v1057322",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057322_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse maksimaalne osakaal on 60% kuni 90% abikõlblike kulude maksumusest vastavalt lisas 2 sätestatud KOVi maksimaalsele toetusele. Sekkumise eelarvest moodustavad Euroopa Regionaalarengu Fondi vahendid kuni 70% ja riiklik kaasfinantseering kuni 20% ning toetuse saaja omaosalus minimaalselt 10%. Toetuse maksimaalne osakaal on 60% kuni 90% abikõlblike kulude maksumusest vastavalt lisas 2 sätestatud KOVi maksimaalsele toetusele. Sekkumise eelarvest moodustavad Euroopa Regionaalarengu Fondi vahendid kuni 70% ja riiklik kaasfinantseering kuni 20% ning toetuse saaja omaosalus minimaalselt 10%.",
      "rdfs:label": {
        "@value": "Reg_1057322_Par_7 (redaktsioon 1057322)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057322",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057322",
      "estleg:sourceAct": "Kogukonnapõhise toetatud eluaseme toetamine",
      "estleg:provisionRef": "Reg_1057322 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057322_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057322_Par_8_v1057322",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057322_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlejaks ja partneriks võib olla KOV, sealhulgas linnaosa või osavald, mis tegutseb valla maa-alal ja koosseisus volikogu kinnitatud osavalla põhimääruse alusel. Taotlejaks ja partneriks võib olla KOV, sealhulgas linnaosa või osavald, mis tegutseb valla maa-alal ja koosseisus volikogu kinnitatud osavalla põhimääruse alusel. 2 (2) Taotleja ja partner peavad vastama ühendmääruse § 3 lõigetes 2 ja 4 sätestatule. Taotleja ja partner peavad vastama ühendmääruse § 3 lõigetes 2 ja 4 sätestatule.",
      "rdfs:label": {
