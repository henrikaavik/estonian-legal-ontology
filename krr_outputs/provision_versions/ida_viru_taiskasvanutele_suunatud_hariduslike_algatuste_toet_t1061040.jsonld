        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja on kohustatud järgima ühendmääruse § 2 lõikes 3 nimetatud kohustusi. Taotleja on kohustatud järgima ühendmääruse § 2 lõikes 3 nimetatud kohustusi.",
      "rdfs:label": {
        "@value": "Reg_1061040_Par_11 (redaktsioon 1061040)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061040",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061040",
      "estleg:sourceAct": "„Ida-Viru täiskasvanutele suunatud hariduslike algatuste toetamine” elluviimiseks toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1061040 § 11",
