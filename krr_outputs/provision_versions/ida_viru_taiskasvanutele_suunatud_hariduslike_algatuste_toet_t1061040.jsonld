    },
    {
      "@id": "estleg:Reg_1061040_Par_8_v1061040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061040_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse minimaalne summa projekti kohta on 20 000 eurot ja maksimaalne summa projekti kohta on 200 000 eurot. Toetuse minimaalne summa projekti kohta on 20 000 eurot ja maksimaalne summa projekti kohta on 200 000 eurot. 2 (2) Toetuse maksimaalne osakaal projekti kohta on 100 protsenti projekti abikõlblikest kuludest, millest 70 protsenti moodustab õiglase ülemineku fondi toetus ja 30 protsenti riiklik kaasfinantseering. Toetuse maksimaalne osakaal projekti kohta on 100 protsenti projekti abikõlblikest kuludest, millest 70 protsenti moodustab õiglase ülemineku fondi toetus ja 30 protsenti riiklik kaasfinantseering.",
      "rdfs:label": {
        "@value": "Reg_1061040_Par_8 (redaktsioon 1061040)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061040",
