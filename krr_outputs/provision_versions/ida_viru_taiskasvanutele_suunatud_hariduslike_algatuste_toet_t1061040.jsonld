    },
    {
      "@id": "estleg:Reg_1061040_Par_4_v1061040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061040_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusasutus on Haridus- ja Teadusministeerium (edaspidi rakendusasutus). Rakendusasutus on Haridus- ja Teadusministeerium (edaspidi rakendusasutus). 2 (2) Rakendusüksus on Riigi Tugiteenuste Keskus (edaspidi rakendusüksus). Rakendusüksus on Riigi Tugiteenuste Keskus (edaspidi rakendusüksus).",
      "rdfs:label": {
        "@value": "Reg_1061040_Par_4 (redaktsioon 1061040)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061040",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061040",
      "estleg:sourceAct": "„Ida-Viru täiskasvanutele suunatud hariduslike algatuste toetamine” elluviimiseks toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1061040 § 4",
