    {
      "@id": "estleg:Reg_312324_Par_3_v312324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312324_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolitaja peab tagama koolituse läbiviimiseks vajaminevad õpperuumid ja -vahendid, pädevad koolitajad, koolituskavad ja õppedokumentatsiooni ning laskeinstruktori litsentside väljastamise korralduse. Koolitaja peab tagama koolituse läbiviimiseks vajaminevad õpperuumid ja -vahendid, pädevad koolitajad, koolituskavad ja õppedokumentatsiooni ning laskeinstruktori litsentside väljastamise korralduse.",
      "rdfs:label": {
        "@value": "Reg_312324_Par_3 (redaktsioon 312324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312324",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312324",
      "estleg:sourceAct": "Laskeinstruktori koolitusele esitatavad nõuded, eksami sooritamise- ja litsentsi väljaandmise kord ning laskeinstruktori litsentsi vorm",
      "estleg:provisionRef": "Reg_312324 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312324_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_312324_Par_4_v312324",
      "@type": [
        "owl:NamedIndividual",
