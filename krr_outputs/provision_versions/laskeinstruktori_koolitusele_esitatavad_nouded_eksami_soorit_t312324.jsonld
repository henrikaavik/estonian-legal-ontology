      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Laskeinstruktori koolitusele esitatavad nõuded, eksami sooritamise- ja litsentsi väljaandmise kord ning laskeinstruktori litsentsi vorm (12 versiooni)",
        "@language": "et"
      },
      "dc:source": "Laskeinstruktori koolitusele esitatavad nõuded, eksami sooritamise- ja litsentsi väljaandmise kord ning laskeinstruktori litsentsi vorm"
    },
    {
      "@id": "estleg:Reg_312324_Par_1_v312324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312324_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laskeinstruktori koolituse eesmärk on tagada laskeinstruktori teadmised ja oskused, mis on vajalikud laskevõistluse ja laskeharjutuse ohutuks läbiviimiseks ning laskealase tegevuse korraldamiseks. Laskeinstruktori koolituse eesmärk on tagada laskeinstruktori teadmised ja oskused, mis on vajalikud laskevõistluse ja laskeharjutuse ohutuks läbiviimiseks ning laskealase tegevuse korraldamiseks.",
      "rdfs:label": {
        "@value": "Reg_312324_Par_1 (redaktsioon 312324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312324",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312324",
      "estleg:sourceAct": "Laskeinstruktori koolitusele esitatavad nõuded, eksami sooritamise- ja litsentsi väljaandmise kord ning laskeinstruktori litsentsi vorm",
      "estleg:provisionRef": "Reg_312324 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312324_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_312324_Par_10_v312324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312324_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Laskeinstruktori litsentsi taotleja esitab litsentsi väljaandjale esmase või korduva litsentsi saamiseks kirjaliku taotluse, milles sisalduvad järgmised andmed taotleja kohta:11)ees- ja perekonnanimi;22)sünniaeg;33)relvaloa number;44)relvaloa väljaandja ja kehtivusaeg. Laskeinstruktori litsentsi taotleja esitab litsentsi väljaandjale esmase või korduva litsentsi saamiseks kirjaliku taotluse, milles sisalduvad järgmised andmed taotleja kohta: ees- ja perekonnanimi; sünniaeg; relvaloa number; relvaloa väljaandja ja kehtivusaeg. 2(2)Taotlusele lisatakse 2 fotot mõõtmetega 3×4 cm. Taotlusele lisatakse 2 fotot mõõtmetega 3×4 cm.",
      "rdfs:label": {
        "@value": "Reg_312324_Par_10 (redaktsioon 312324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312324",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312324",
      "estleg:sourceAct": "Laskeinstruktori koolitusele esitatavad nõuded, eksami sooritamise- ja litsentsi väljaandmise kord ning laskeinstruktori litsentsi vorm",
      "estleg:provisionRef": "Reg_312324 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312324_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_312324_Par_11_v312324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312324_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laskeinstruktori litsents on kahepoolne, kiletatud dokument mõõtmetega 8,5 cm × 5,4 cm, millele kantakse isiku foto, ees- ja perekonnanimi, sünniaeg, väljaandmise kuu ja aasta, kehtivuse aeg, litsentsi number ning väljaandva laskeorganisatsiooni nimi ja selle volitatud isiku allkiri. Laskeinstruktori litsents on kahepoolne, kiletatud dokument mõõtmetega 8,5 cm × 5,4 cm, millele kantakse isiku foto, ees- ja perekonnanimi, sünniaeg, väljaandmise kuu ja aasta, kehtivuse aeg, litsentsi number ning väljaandva laskeorganisatsiooni nimi ja selle volitatud isiku allkiri.",
      "rdfs:label": {
        "@value": "Reg_312324_Par_11 (redaktsioon 312324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312324",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312324",
