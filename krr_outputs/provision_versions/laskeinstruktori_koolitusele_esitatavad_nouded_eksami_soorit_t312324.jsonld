        "@value": "2007-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laskeinstruktori koolitusest osavõtjal peab olema kehtiv relvaluba. Laskeinstruktori koolitusest osavõtjal peab olema kehtiv relvaluba.",
      "rdfs:label": {
        "@value": "Reg_312324_Par_4 (redaktsioon 312324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312324",
