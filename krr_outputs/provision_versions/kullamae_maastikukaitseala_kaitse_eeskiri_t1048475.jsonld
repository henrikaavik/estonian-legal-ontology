      "estleg:versionValidFrom": {
        "@value": "2020-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas5 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndi piiride kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas5 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndi piiride kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1048475_Par_4 (redaktsioon 1048475)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048475",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048475",
      "estleg:sourceAct": "Kullamäe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1048475 § 4",
