    {
      "@id": "estleg:Reg_1048475_Par_4_v1048475",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048475_Par_4"
