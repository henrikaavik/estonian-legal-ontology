      },
      "estleg:versionText": "Andmekogu turbeaste on keskmine (L) ja turvaklass K0T1S0. RT I 2023-03-09 10 109032023010 2023-03-12 Andmekogu turbeaste on keskmine (L) ja turvaklass K0T1S0.",
      "rdfs:label": {
        "@value": "Reg_1053011_Par_2 (redaktsioon 1053011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053011",
