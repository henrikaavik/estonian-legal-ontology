    {
      "@id": "estleg:Reg_1053011_Par_5_v1053011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053011_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu pidaja kontrollib iga aasta 19. oktoobriks andmekogusse kantud andmete õigsust ja teeb vajadusel 14 tööpäeva jooksul ebaõigetest andmetest teada saamisest arvates andmetes parandused. Andmekogu pidaja kontrollib iga aasta 19. oktoobriks andmekogusse kantud andmete õigsust ja teeb vajadusel 14 tööpäeva jooksul ebaõigetest andmetest teada saamisest arvates andmetes parandused.",
      "rdfs:label": {
        "@value": "Reg_1053011_Par_5 (redaktsioon 1053011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053011",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053011",
      "estleg:sourceAct": "Elektroonilise teemaksu kogumise süsteemi andmekogu",
      "estleg:provisionRef": "Reg_1053011 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053011_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1053011_Par_6_v1053011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053011_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu on avalikkusele elektrooniliselt kättesaadav. Andmekogu on avalikkusele elektrooniliselt kättesaadav. 2 (2) Hiljemalt iga aasta 31. detsembriks esitab andmekogu pidaja Euroopa Komisjonile elektrooniliselt andmekogusse kantud andmed. Hiljemalt iga aasta 31. detsembriks esitab andmekogu pidaja Euroopa Komisjonile elektrooniliselt andmekogusse kantud andmed.",
      "rdfs:label": {
        "@value": "Reg_1053011_Par_6 (redaktsioon 1053011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053011",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053011",
      "estleg:sourceAct": "Elektroonilise teemaksu kogumise süsteemi andmekogu",
      "estleg:provisionRef": "Reg_1053011 § 6",
      "estleg:partOfAct": {
