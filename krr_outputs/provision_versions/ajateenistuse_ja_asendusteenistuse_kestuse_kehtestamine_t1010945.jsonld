    {
      "@id": "estleg:Reg_1010945_Par_2_v1010945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1010945_Par_2"
