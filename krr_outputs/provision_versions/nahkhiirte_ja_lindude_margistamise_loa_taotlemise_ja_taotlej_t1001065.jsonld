      "estleg:provisionRef": "Reg_1001065 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1001065_Par_2_v1001065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001065_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-06-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Värviliste märgistega, raadiosaatja või kiibiga märgistamise loa taotlemisel peab taotleja esitama taotluses järgmised andmed ja dokumendid: 1 1) märgistamise eesmärk; 2 2) uuritava liigi nimetus (liikide nimetused) ja märgistatavate isendite ligikaudne arv; 3 3) piirkonna ja perioodikirjeldus, kus ja millal märgistamine toimub; 4 4) värviliste märgiste kasutamise ja/või raadiosaatja või kiibi kinnitamise metoodika; 5 5) värviliste märgiste kasutamise korral kooskõlastus liigi või liigirühma värviliste märgiste kasutamise rahvusvahelise projekti juhiga; 6 6) kasutatava raadiosaatja ja kiibi tehnilised andmed; 7 7) projekti kaasatud märgistajate nimed. Värviliste märgistega, raadiosaatja või kiibiga märgistamise loa taotlemisel peab taotleja esitama taotluses järgmised andmed ja dokumendid: märgistamise eesmärk; uuritava liigi nimetus (liikide nimetused) ja märgistatavate isendite ligikaudne arv; piirkonna ja perioodikirjeldus, kus ja millal märgistamine toimub; värviliste märgiste kasutamise ja/või raadiosaatja või kiibi kinnitamise metoodika; värviliste märgiste kasutamise korral kooskõlastus liigi või liigirühma värviliste märgiste kasutamise rahvusvahelise projekti juhiga; kasutatava raadiosaatja ja kiibi tehnilised andmed; projekti kaasatud märgistajate nimed.",
      "rdfs:label": {
        "@value": "Reg_1001065_Par_2 (redaktsioon 1001065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001065",
