      }
    },
    {
      "@id": "estleg:Reg_1001065_Par_6_v1001065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001065_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-06-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Loa andja võib loa kehtivust pikendada järgmiseks kümneks aastaks „Looduskaitseseaduse” § 581 lõikes 5 kehtestatud tingimustel. Loa andja võib loa kehtivust pikendada järgmiseks kümneks aastaks „Looduskaitseseaduse” § 581 lõikes 5 kehtestatud tingimustel. 2 (2) Loa pikendamise taotlus tuleb esitada loa andjale hiljemalt 2 kuud enne loa kehtivusaja lõppu. Loa pikendamise taotlus tuleb esitada loa andjale hiljemalt 2 kuud enne loa kehtivusaja lõppu.",
