      }
    },
    {
      "@id": "estleg:Reg_1001065_Par_5_v1001065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001065_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-06-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Loa andja saadab taotlejale loa 30 päeva jooksul atesteerimise sooritamisest arvates väljastusteatega tähtkirjaga. Loa vorm on esitatud käesoleva määruse lisas. Loa andja saadab taotlejale loa 30 päeva jooksul atesteerimise sooritamisest arvates väljastusteatega tähtkirjaga. Loa vorm on esitatud käesoleva määruse lisas. 2 (2) Loa kaotamise või kasutamiskõlbmatuks muutumise korral väljastab loa andja märgistaja kirjaliku taotluse alusel uue loa. Loa kaotamise või kasutamiskõlbmatuks muutumise korral väljastab loa andja märgistaja kirjaliku taotluse alusel uue loa.",
      "rdfs:label": {
        "@value": "Reg_1001065_Par_5 (redaktsioon 1001065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001065",
      "estleg:sourceAct": "Nahkhiirte ja lindude märgistamise loa taotlemise ja taotleja atesteerimise kord, loa andmise ja pikendamise kord ning loa vorm",
      "estleg:provisionRef": "Reg_1001065 § 5",
      "estleg:partOfAct": {
