    },
    {
      "@id": "estleg:Reg_1025786_Par_2_v1025786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025786_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võtta II kaitsekategooria kivististena kaitse alla: 1 1) peajalgsete (Cephalopoda) kivististe tervikeksemplarid. Peajalgsete tervikeksemplariks loetakse kivistist, millel on säilinud nii elukamber kui ka gaasikambrid; 2 2) määruse § 1 punktis 4 nimetamata okasnahksete (Echinodermata) tervikeksemplarid. Okasnahksete tervikeksemplariks loetakse kivistist, millel on säilinud pähik (calyx); 3 3) trilobiitide (Trilobita) tervikeksemplarid. Trilobiitide tervikeksemplariks loetakse kivistist, millel on säilinud nii sabakilp kui peakilp. Võtta II kaitsekategooria kivististena kaitse alla: peajalgsete (Cephalopoda) kivististe tervikeksemplarid. Peajalgsete tervikeksemplariks loetakse kivistist, millel on säilinud nii elukamber kui ka gaasikambrid; määruse § 1 punktis 4 nimetamata okasnahksete (Echinodermata) tervikeksemplarid. Okasnahksete tervikeksemplariks loetakse kivistist, millel on säilinud pähik (calyx); trilobiitide (Trilobita) tervikeksemplarid. Trilobiitide tervikeksemplariks loetakse kivistist, millel on säilinud nii sabakilp kui peakilp.",
      "rdfs:label": {
        "@value": "Reg_1025786_Par_2 (redaktsioon 1025786)",
        "@language": "et"
      },
