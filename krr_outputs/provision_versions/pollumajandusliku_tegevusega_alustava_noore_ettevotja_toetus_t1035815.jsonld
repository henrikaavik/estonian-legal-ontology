      "estleg:versionValidFrom": {
        "@value": "2025-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse alusel esitatud dokumente taotlejale ei tagastata. Nimetatud dokumente säilitatakse PRIA-s kuni 2032. aasta 31. detsembrini. Määruse alusel esitatud dokumente taotlejale ei tagastata. Nimetatud dokumente säilitatakse PRIA-s kuni 2032. aasta 31. detsembrini.",
      "rdfs:label": {
        "@value": "Reg_1035815_Par_17 (redaktsioon 1035815)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035815",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035815",
