      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. RT I 2009 7 48 13125268 2009-02-01+02:00 Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_303771_Par_3 (redaktsioon 303771)",
        "@language": "et"
      },
