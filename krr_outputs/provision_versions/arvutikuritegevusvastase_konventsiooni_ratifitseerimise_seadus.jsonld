      "dc:source": "Arvutikuritegevusvastase konventsiooni ratifitseerimise seadus"
    },
    {
      "@id": "estleg:AKR_Par_1_v550351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
