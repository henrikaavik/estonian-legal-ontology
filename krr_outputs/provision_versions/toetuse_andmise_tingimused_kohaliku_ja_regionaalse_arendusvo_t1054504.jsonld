    {
      "@id": "estleg:Reg_1054504_Par_19_v1054504",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054504_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluse osalise rahuldamise otsuse teeb rakendusüksus ühendmääruse § 9 lõikes 1 nimetatud juhtudel. Taotluse osalise rahuldamise otsuse teeb rakendusüksus ühendmääruse § 9 lõikes 1 nimetatud juhtudel. 2 (2) Taotluse kõrvaltingimusega rahuldamise otsuse võib rakendusüksus teha vastavalt ühendmääruse § 9 lõikes 2 sätestatule. Taotluse kõrvaltingimusega rahuldamise otsuse võib rakendusüksus teha vastavalt ühendmääruse § 9 lõikes 2 sätestatule. 3 (3) Taotluse kõrvaltingimusega rahuldamise otsuse põhjal ei teki toetuse saajal õigust toetuse maksetele. Õigus toetusega seotud maksetele tekib toetuse saajal pärast seda, kui rakendusüksus on tingimuse saabumise või täitmise toetuse saaja esitatud teabe põhjal tuvastanud, välja arvatud juhul, kui teavet on võimalik rakendusüksusel tuvastada muust andmeallikast. Taotluse kõrvaltingimusega rahuldamise otsuse põhjal ei teki toetuse saajal õigust toetuse maksetele. Õigus toetusega seotud maksetele tekib toetuse saajal pärast seda, kui rakendusüksus on tingimuse saabumise või täitmise toetuse saaja esitatud teabe põhjal tuvastanud, välja arvatud juhul, kui teavet on võimalik rakendusüksusel tuvastada muust andmeallikast.",
      "rdfs:label": {
        "@value": "Reg_1054504_Par_19 (redaktsioon 1054504)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054504",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054504",
      "estleg:sourceAct": "Toetuse andmise tingimused kohaliku ja regionaalse arendusvõimekuse tõstmiseks",
      "estleg:provisionRef": "Reg_1054504 § 19",
