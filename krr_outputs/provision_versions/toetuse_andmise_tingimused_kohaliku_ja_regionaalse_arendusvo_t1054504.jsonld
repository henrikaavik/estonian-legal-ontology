    {
      "@id": "estleg:Reg_1054504_Par_3_v1054504",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054504_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusüksus on Riigi Tugiteenuste Keskus (edaspidi rakendusüksus). Rakendusüksus on Riigi Tugiteenuste Keskus (edaspidi rakendusüksus). 2 (2) Rakendusasutus on Regionaal- ja Põllumajandusministeerium (edaspidi rakendusasutus). RT I 2023-07-15 2 115072023002 2023-07-18 , rakendatakse tagasiulatuvalt 2023. aasta 1. juulist. Rakendusasutus on Regionaal- ja Põllumajandusministeerium (edaspidi rakendusasutus). , rakendatakse tagasiulatuvalt 2023. aasta 1. juulist.",
      "rdfs:label": {
        "@value": "Reg_1054504_Par_3 (redaktsioon 1054504)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054504",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054504",
      "estleg:sourceAct": "Toetuse andmise tingimused kohaliku ja regionaalse arendusvõimekuse tõstmiseks",
      "estleg:provisionRef": "Reg_1054504 § 3",
      "estleg:partOfAct": {
