    {
      "@id": "estleg:Reg_1054504_Par_12_v1054504",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054504_Par_12"
