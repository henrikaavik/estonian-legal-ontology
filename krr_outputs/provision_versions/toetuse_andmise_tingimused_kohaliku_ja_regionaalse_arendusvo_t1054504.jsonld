      "estleg:provisionRef": "Reg_1054504 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054504_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054504_Par_20_v1054504",
      "@type": [
        "owl:NamedIndividual",
