      }
    },
    {
      "@id": "estleg:Reg_1035607_Par_3_v1035607",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035607_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 3. aprilli 1995. a määrusega nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine” kinnitatud „Eesti territooriumi haldusüksuste nimistut” muudetakse ja Harju maakonna linnade ja valdade loetelu sõnastatakse järgmiselt: „linnad – Keila, Loksa, Maardu, Paldiski, Tallinn vallad – Aegviidu, Anija, Harku, Jõelähtme, Keila, Kiili, Kose, Kuusalu, Padise, Raasiku, Rae, Saku, Saue, Vasalemma, Viimsi”. Vabariigi Valitsuse 3. aprilli 1995. a määrusega nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine” kinnitatud „Eesti territooriumi haldusüksuste nimistut” muudetakse ja Harju maakonna linnade ja valdade loetelu sõnastatakse järgmiselt: „linnad – Keila, Loksa, Maardu, Paldiski, Tallinn vallad – Aegviidu, Anija, Harku, Jõelähtme, Keila, Kiili, Kose, Kuusalu, Padise, Raasiku, Rae, Saku, Saue, Vasalemma, Viimsi”.",
      "rdfs:label": {
        "@value": "Reg_1035607_Par_3 (redaktsioon 1035607)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035607",
