        "@value": "2024-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus jõustub 1. jaanuaril 2016. a. Käesolev määrus jõustub 1. jaanuaril 2016. a.",
      "rdfs:label": {
        "@value": "Reg_1032471_Par_22 (redaktsioon 1032471)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032471",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032471",
      "estleg:sourceAct": "Meditsiiniseadmete ja abivahendite andmekogu põhimäärus",
