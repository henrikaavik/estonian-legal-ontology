        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_14_v130062023017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa, tegevusloa ärakirja, juhitunnistuse ja sertifikaadi annab Kliimaministeeriumi volitusel Transpordiamet või käesoleva seaduse § 47 lõikes 1 nimetatud isik, kui temale on selle ülesande täitmine halduslepinguga üle antud.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_14 (redaktsioon 130062023017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023017"
    },
    {
      "@id": "estleg:AUTOVE_Par_15_v26401",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa andja annab tegevusloa või teatab selle taotlejale tegevusloa andmisest keeldumisest kirjalikult 30 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 1 nimetatud dokumentide esitamist. (2) Sõidukikaardi andja annab sõidukikaardi või teatab selle taotlejale sõidukikaardi andmisest keeldumisest kirjalikult 15 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 2 nimetatud dokumentide esitamist.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_15 (redaktsioon 26401)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26401",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_15_v184490"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_15_v184490",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa andja kontrollib taotleja andmeid äriregistrisse kantud ettevõtja puhul äriregistrist või seaduse alusel teise registrisse kantud isiku puhul sellest registrist ning annab tegevusloa või teatab selle taotlejale tegevusloa andmisest keeldumisest 30 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 1 nimetatud dokumentide esitamist. (2) Sõidukikaardi andja kontrollib taotleja andmeid esimese sõidukikaardi taotlemisel äriregistrisse kantud ettevõtja puhul äriregistrist või seaduse alusel teise registrisse kantud isiku puhul sellest registrist ning annab sõidukikaardi või teatab selle taotlejale sõidukikaardi andmisest keeldumisest 15 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 2 nimetatud dokumentide esitamist. (3) Käesoleva paragrahvi lõigetes 1 ja 2 nimetatud haldusaktid tehakse taotlejale teatavaks posti teel või elektrooniliselt.»",
      "rdfs:label": {
        "@value": "AUTOVE_Par_15 (redaktsioon 184490)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184490",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_15_v747699"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_15_v747699",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa andja kontrollib taotleja esitatud andmeid äriregistrisse kantud ettevõtja puhul äriregistrist või seaduse alusel teise registrisse kantud isiku puhul sellest registrist, samuti karistusregistrist ning annab tegevusloa või teatab selle taotlejale tegevusloa andmisest keeldumisest kirjalikult 30 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 1 nimetatud dokumentide esitamist . (2) Sõidukikaardi andja kontrollib taotleja andmeid esimese sõidukikaardi taotlemisel äriregistrisse kantud ettevõtja puhul äriregistrist või seaduse alusel teise registrisse kantud isiku puhul sellest registrist ning annab sõidukikaardi või teatab selle taotlejale sõidukikaardi andmisest keeldumisest 15 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 2 nimetatud dokumentide esitamist. (3) Käesoleva paragrahvi lõigetes 1 ja 2 nimetatud haldusaktid tehakse taotlejale teatavaks posti teel või elektrooniliselt.»",
      "rdfs:label": {
        "@value": "AUTOVE_Par_15 (redaktsioon 747699)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "747699",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_15_v13062111"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_15_v13062111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa andja kontrollib taotleja esitatud andmeid äriregistrisse kantud ettevõtja puhul äriregistrist või seaduse alusel teise registrisse kantud isiku puhul sellest registrist, samuti karistusregistrist ja välisriikidest edastatud karistusandmetest ning annab tegevusloa või teatab selle taotlejale tegevusloa andmisest keeldumisest kirjalikult 30 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 1 nimetatud dokumentide esitamist. (2) Sõidukikaardi andja kontrollib taotleja andmeid liiklusregistrist ja äriregistrisse kantud ettevõtja puhul äriregistrist või seaduse alusel teise registrisse kantud isiku puhul sellest registrist ning annab sõidukikaardi või teatab selle taotlejale sõidukikaardi andmisest keeldumisest 15 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 3 nimetatud dokumentide esitamist. (3) Käesoleva paragrahvi lõigetes 1 ja 2 nimetatud haldusaktid tehakse taotlejale teatavaks posti teel või elektrooniliselt.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_15 (redaktsioon 13062111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13062111",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_15_v102032012009"
      },
      "estleg:versionValidTo": {
        "@value": "2012-03-11",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_15_v102032012009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa taotluse läbivaatamisel kontrollib tegevusloa andja taotleja ajatamata maksuvõla puudumist ning taotleja esitatud andmeid äriregistris või mittetulundusühingute ja sihtasutuste registris, samuti karistusregistris ja liiklusjärelevalve infosüsteemis ning vajaduse korral majandustegevuse registris. Tegevusloa andmise otsus ja tegevusluba või selle andmisest keeldumise otsus antakse taotlejale või saadetakse talle posti teel 56 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 1 nimetatud dokumentide esitamist. Põhjendatud juhul võib tegevusloa andja taotluse läbivaatamise tähtaega 28 kalendripäeva võrra pikendada. (2) Tegevusloa kinnitatud ärakirja taotluse läbivaatamisel kontrollib tegevusloa kinnitatud ärakirja andja taotleja ajatamata maksuvõla puudumist ning taotleja esitatud andmeid äriregistris või mittetulundusühingute ja sihtasutuste registris, vajaduse korral majandustegevuse registris ning sõiduki andmeid liiklusregistris. Tegevusloa kinnitatud ärakirja andmise otsus ja kinnitatud ärakiri või selle andmisest keeldumise otsus antakse taotlejale või saadetakse talle posti teel 15 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 2 nimetatud dokumentide esitamist. (3) Juhitunnistuse taotluse läbivaatamisel kontrollib juhitunnistuse andja taotleja esitatud andmeid majandustegevuse registris. Juhitunnistuse andmise otsus ja juhitunnistus koos selle kinnitatud koopiaga või nende dokumentide andmisest keeldumise otsus antakse taotlejale või saadetakse talle posti teel 15 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 3 nimetatud dokumentide esitamist. (4) Oma kulul sõitjateveo sertifikaadi taotluse läbivaatamisel kontrollib sertifikaadi andja taotleja esitatud andmeid äriregistris või mittetulundusühingute ja sihtasutuste registris ning sõiduki andmeid liiklusregistris. Oma kulul sõitjateveo sertifikaadi andmise otsus ja sertifikaat või selle andmisest keeldumise otsus antakse taotlejale või saadetakse talle posti teel 15 kalendripäeva jooksul pärast käesoleva seaduse § 13 lõikes 4 nimetatud dokumentide esitamist. (5) Tegevusloa, selle kinnitatud ärakirja, juhitunnistuse ja oma kulul sõitjateveo sertifikaadi andmisest keeldumise otsuse võib taotlejale saata ka elektrooniliselt.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_15 (redaktsioon 102032012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102032012009",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_15_v111012018001"
      },
      "estleg:versionValidTo": {
        "@value": "2018-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_15_v111012018001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa ja tegevusloa ärakirja taotluse lahendamisel lähtutakse majandustegevuse seadustiku üldosa seaduse § 20 lõigetest 1–3. Tegevusloa ja tegevusloa ärakirja taotluse lahendamise tähtaja möödumisel ei loeta kumbagi dokumenti vaikimisi antuks. (2) Juhitunnistuse ja sertifikaadi taotlus lahendatakse 15 kalendripäeva jooksul kõigi nõutavate andmete ja dokumentide esitamisest arvates. (3) Kui juhitunnistuse või sertifikaadi taotlemiseks esitatud andmetes või dokumentides on puudusi, määratakse taotlejale mõistlik tähtaeg nende kõrvaldamiseks. Taotluse lahendamise tähtaja kulgemine peatub, kuni puudus on kõrvaldatud. Kui taotleja määratud tähtaja jooksul puudust ei kõrvalda, võib jätta taotluse lahendamata. (4) Tegevusluba, tegevusloa ärakiri, juhitunnistus, sertifikaat või nende dokumentide andmisest keeldumise otsus antakse taotlejale kätte või saadetakse taotlejale posti teel tähtkirjaga, väljastusteatega tähtkirjaga või lihtkirjaga. (5) Tegevusloa, tegevusloa ärakirja, juhitunnistuse ja sertifikaadi andmisest keeldumise otsuse võib taotlejale tema nõusolekul saata ka elektrooniliselt.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_15 (redaktsioon 111012018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111012018001"
    },
    {
      "@id": "estleg:AUTOVE_Par_16_v26401",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa andja keeldub tegevusloa andmisest, kui: tegevusloa taotleja on maksuvõlglane, kui talle on välja kuulutatud pankrot või kui ettevõtja eelmise tegevusloa kehtetuks tunnistamise põhjus on õigusnormide rikkumine, millest ei ole möödunud kahte aastat; tegevusloa taotleja ei vasta käesoleva seaduse §-s 5 või 10 esitatud nõuetele; tegevusloa taotlemiseks on esitatud tegelikkusele mittevastavaid andmeid.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_16 (redaktsioon 26401)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26401",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_16_v747699"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_16_v747699",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa andja võib keelduda tegevusloa andmisest, kui : tegevusloa taotleja on maksuvõlglane, kui talle on välja kuulutatud pankrot või kui ettevõtja eelmise tegevusloa kehtetuks tunnistamise põhjus on õigusnormide rikkumine, millest ei ole möödunud kahte aastat; tegevusloa taotleja ei vasta käesoleva seaduse §-s 5 või 10 esitatud nõuetele; tegevusloa taotlemiseks on esitatud tegelikkusele mittevastavaid andmeid; tegevusloa taotlejale on tehtud ettekirjutus käesoleva seaduse § 19 lõike 1 punktides 1, 3, 4, 5 või 6 nimetatud alustel ja sellest on möödunud vähem kui kuus kuud.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_16 (redaktsioon 747699)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "747699",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_16_v1027733"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_16_v1027733",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa andja võib keelduda tegevusloa andmisest, kui : tegevusloa taotleja on maksuvõlglane, kui talle on välja kuulutatud pankrot või kui ettevõtja eelmise tegevusloa kehtetuks tunnistamise põhjus on õigusnormide rikkumine, millest ei ole möödunud kahte aastat; tegevusloa taotleja ei vasta käesoleva seaduse § -s 5 või 10 esitatud nõuetele; tegevusloa taotlemiseks on esitatud tegelikkusele mittevastavaid andmeid; tegevusloa taotlejale on tehtud ettekirjutus käesoleva seaduse § 19 lõike 1 punktides 1, 3, 4, 5 või 6 nimetatud alustel ja sellest on möödunud vähem kui kuus kuud.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_16 (redaktsioon 1027733)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027733",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_16_v13062111"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_16_v13062111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa andja võib keelduda tegevusloa andmisest, kui: tegevusloa taotleja on maksuvõlglane, kui talle on välja kuulutatud pankrot või kui ettevõtja eelmise tegevusloa kehtetuks tunnistamise põhjus on õigusnormide rikkumine, millest ei ole möödunud kahte aastat; tegevusloa taotleja ei vasta käesoleva seaduse §-s 5 või 10 esitatud nõuetele; tegevusloa taotlemiseks on esitatud tegelikkusele mittevastavaid andmeid; tegevusloa taotlejale on tehtud ettekirjutus käesoleva seaduse § 19 lõike 1 punktis 1, 3, 4, 5 või 6 nimetatud alustel ja sellest on möödunud vähem kui kuus kuud; tegevusloa taotleja ei ole esitatud dokumentides olevaid puudusi käesoleva seaduse § 13 lõike 6 alusel määratud tähtajaks kõrvaldanud. (2) Sõidukikaardi andja keeldub sõidukikaardi andmisest, kui: sõidukikaardi taotleja ei vasta käesoleva seaduse § 6 lõikes 4 esitatud nõuetele; sõidukikaardi taotleja andmete kontrollimisel selgub, et ta ei vasta enam tegevusloa andmise aluseks olevatele nõuetele; sõidukikaardi taotleja andmete kontrollimisel selgub, et ta ei ole sõiduki omanik või kasutaja; sõiduk, millele sõidukikaarti taotletakse, ei ole läbinud nõutavat tehnoülevaatust või sõidukikaardi taotleja ei ole esitatud dokumentides olevaid puudusi käesoleva seaduse § 13 lõike 6 alusel määratud tähtajaks kõrvaldanud.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_16 (redaktsioon 13062111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13062111",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_16_v102032012009"
      },
      "estleg:versionValidTo": {
        "@value": "2012-03-11",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_16_v102032012009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa andmisest võib keelduda, kui: tegevusloa taotlejal on ajatamata maksuvõlg või on kohus välja kuulutanud taotleja pankroti; tegevusloa taotleja ei vasta käesoleva seaduse § 5 lõigetes 2–11 sätestatud mis tahes nõudele; tegevusloa taotleja eelmise tegevusloa käesoleva seaduse § 191 punktide 2–6 alusel kehtetuks tunnistamisest ei ole möödunud kahte aastat; tegevusloa taotleja suhtes kehtib autoveo tegevusalal majandusalase süüteo kriminaalasjas jõustunud kohtuotsusega kohaldatud tegutsemiskeeld või ettevõtluskeeld või seadusest või kohtulahendist tulenev ärikeeld. (2) Tegevusloa kinnitatud ärakirja andmisest võib keelduda, kui: tegevusloa kinnitatud ärakirja taotleja ei vasta käesoleva seaduse § 5 lõikes 1 või 11 sätestatud nõudele; tegevusloa kinnitatud ärakirja taotleja andmete kontrollimisel selgub, et ta ei vasta enam tegevusloa andmise aluseks olevatele nõuetele. (3) Juhitunnistuse andmisest võib keelduda, kui: juhitunnistuse taotleja ei vasta käesoleva seaduse § 51 lõikes 1 sätestatud nõudele; juhitunnistuse taotleja ei vasta enam tegevusloa andmise aluseks olevatele nõuetele; autojuht, kellele juhitunnistust taotletakse, ei vasta käesoleva seaduse § 51 lõikes 2, 3 või 4 sätestatud nõudele. (4) Oma kulul sõitjateveo sertifikaadi andmisest võib keelduda, kui sertifikaadi taotleja andmete kontrollimisel selgub, et ta ei vasta käesoleva seaduse § 81 lõikes 2 või 4 sätestatud nõudele. (5) Tegevusloa, selle kinnitatud ärakirja, juhitunnistuse ja oma kulul sõitjateveo sertifikaadi andmisest võib keelduda ka juhul, kui taotleja ei ole esitatud andmetes või dokumentides olevaid puudusi käesoleva seaduse § 13 lõike 6 alusel määratud tähtajaks kõrvaldanud või on esitanud dokumendi taotlemiseks tahtlikult valeandmeid või võltsinud dokumente, mis võivad mõjutada taotluse lahendamist.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_16 (redaktsioon 102032012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102032012009",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_16_v111012018001"
      },
      "estleg:versionValidTo": {
        "@value": "2018-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_16_v111012018001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaks majandustegevuse seadustiku üldosa seaduse § 25 lõikes 1 sätestatud alustele keeldutakse tegevusloa andmisest, kui taotleja eelmise tegevusloa käesoleva seaduse § 19 lõikes 2 sätestatud alusel kehtetuks tunnistamisest ei ole möödunud kahte aastat. (2) Tegevusloa andmisest keeldutakse ka perioodil, millal vedajale antud tegevusloa kehtivus on käesoleva seaduse § 19 lõikes 1 sätestatud alusel peatatud. (3) Kui vedaja on majandustegevusest loobunud, keeldutakse tegevusloa andmisest ka perioodil, milleks taotleja eelmise tegevusloa kehtivus oli käesoleva seaduse § 19 lõikes 1 sätestatud alusel peatatud. (4) Lisaks majandustegevuse seadustiku üldosa seaduse § 25 lõikes 1 sätestatud alustele keeldutakse tegevusloa ärakirja andmisest, kui tegevusloa ärakirja andmisel ilmneb, et taotleja ei vasta vähemalt ühele käesoleva seaduse §-s 7 sätestatud nõudele. (5) Tegevusloa ärakirja andmisest keeldutakse, kui taotleja eelmise tegevusloa ärakirja käesoleva seaduse § 19 lõikes 2 sätestatud alusel kehtetuks tunnistamisest ei ole möödunud ühte aastat. (6) Tegevusloa ärakirja andmisest keeldutakse ka perioodil, millal vedajale antud tegevusloa ärakirja kehtivus on käesoleva seaduse § 19 lõikes 1 sätestatud alusel peatatud. (7) Kui vedaja on majandustegevusest loobunud, keeldutakse tegevusloa ärakirja andmisest ka perioodil, milleks taotleja eelmise tegevusloa ärakirja kehtivus oli käesoleva seaduse § 19 lõikes 1 sätestatud alusel peatatud. (8) Juhitunnistuse andmisest keeldutakse järgmistel alustel: juhitunnistuse taotleja ei vasta vähemalt ühele Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 artikli 5 lõikes 1 sätestatud nõudele; autojuht, kellele juhitunnistust taotletakse, ei vasta vähemalt ühele käesoleva seaduse § 10 lõikes 2 sätestatud nõudele; juhitunnistuse andmisel ilmneb, et taotleja ei vasta vähemalt ühele käesoleva seaduse §-s 7 sätestatud nõudele. (9) Sertifikaadi andmisest keeldutakse, kui ei ole täidetud käesoleva seaduse § 12 lõikes 2 või 3 sätestatud nõuded. (10) Juhitunnistuse või sertifikaadi andmisest keeldutakse, kui taotleja on esitanud tahtlikult valeandmeid, mis võisid mõjutada taotluse lahendamist ning mille esitamata jätmise korral tuleks juhitunnistuse või sertifikaadi andmisest keelduda.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_16 (redaktsioon 111012018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111012018001"
    },
    {
      "@id": "estleg:AUTOVE_Par_17_v26401",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloale märgitakse järgmised andmed: autoveo liik (riigisisene või rahvusvaheline); vedaja nimi või ärinimi ning tema registreeritud asukoht ja registrikood; tegevusloa number; tegevusloa andmise kuupäev ja selle kehtivusaeg; tegevusloa andja nimetus ja pitser; tegevusloale alla kirjutava isiku ametinimetus, nimi ja allkiri. (2) Sõidukikaardile märgitakse järgmised andmed: autoveo liik (riigisisene või rahvusvaheline); selle vedaja, kelle omandis on või kelle renditud on mootorsõiduk, nimi või ärinimi ja tema registreeritud asukoht ning registrikood; sõidukikaardi number; sõidukikaardi andmise kuupäev ja selle kehtivusaeg; sõidukikaardi andmise aluseks oleva tegevusloa andja nimetus ja tegevusloa number; mootorsõiduki mark ja mudel ning riiklik registreerimismärk; mootorsõiduki omaniku nimi; sõidukikaardi andja nimetus ja pitser; sõidukikaardile alla kirjutava isiku ametinimetus, nimi ja allkiri. (3) Oma kulul korraldatava rahvusvahelise autoveo tegevusloale ja sõidukikaardile kantakse peale käesoleva paragrahvi lõigetes 1 ja 2 nimetatud andmete ka tegevusloa ja sõidukikaardi taotleja tegevusala, millega oma kulul korraldatav autovedu on seotud. (4) Tegevusloa ja sõidukikaardi vormid kehtestab teede- ja sideminister.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_17 (redaktsioon 26401)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26401",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_17_v230826"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_17_v230826",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloale märgitakse järgmised andmed: autoveo liik (riigisisene või rahvusvaheline); vedaja nimi või ärinimi ning tema registreeritud asukoht ja registrikood; tegevusloa number; tegevusloa andmise kuupäev ja selle kehtivusaeg; tegevusloa andja nimetus ja pitser; tegevusloale alla kirjutava isiku ametinimetus, nimi ja allkiri. (2) Sõidukikaardile märgitakse järgmised andmed: autoveo liik (riigisisene või rahvusvaheline); selle vedaja, kelle omandis on või kelle renditud on mootorsõiduk, nimi või ärinimi ja tema registreeritud asukoht ning registrikood; sõidukikaardi number; sõidukikaardi andmise kuupäev ja selle kehtivusaeg; sõidukikaardi andmise aluseks oleva tegevusloa andja nimetus ja tegevusloa number; mootorsõiduki mark ja mudel ning riiklik registreerimismärk; mootorsõiduki omaniku nimi; sõidukikaardi andja nimetus ja pitser; sõidukikaardile alla kirjutava isiku ametinimetus, nimi ja allkiri. (3) Oma kulul korraldatava rahvusvahelise autoveo tegevusloale ja sõidukikaardile kantakse peale käesoleva paragrahvi lõigetes 1 ja 2 nimetatud andmete ka tegevusloa ja sõidukikaardi taotleja tegevusala, millega oma kulul korraldatav autovedu on seotud. (4) Tegevusloa ja sõidukikaardi vormid kehtestab majandus- ja kommunikatsiooniminister.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_17 (redaktsioon 230826)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "230826",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_17_v747699"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_17_v747699",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloale märgitakse järgmised andmed: autoveo liik (riigisisene või rahvusvaheline); vedaja nimi või ärinimi ning tema registreeritud asukoht ja registrikood; tegevusloa number; tegevusloa andmise kuupäev ja selle kehtivusaeg; tegevusloa andja nimetus ja pitser; tegevusloale alla kirjutava isiku ametinimetus, nimi ja allkiri. (2) Sõidukikaardile märgitakse järgmised andmed: autoveo liik (riigisisene või rahvusvaheline); selle vedaja, kelle omandis on või kelle renditud on mootorsõiduk, nimi või ärinimi ja tema registreeritud asukoht ning registrikood; sõidukikaardi number; sõidukikaardi andmise kuupäev ja selle kehtivusaeg; sõidukikaardi andmise aluseks oleva tegevusloa andja nimetus ja tegevusloa number; mootorsõiduki mark ja mudel ning riiklik registreerimismärk; mootorsõiduki omaniku nimi; sõidukikaardi andja nimetus ja pitser; sõidukikaardile alla kirjutava isiku ametinimetus, nimi ja allkiri. (3) Oma kulul korraldatava rahvusvahelise autoveo tegevusloale ja sõidukikaardile kantakse peale käesoleva paragrahvi lõigetes 1 ja 2 nimetatud andmete ka tegevusloa ja sõidukikaardi taotleja tegevusala, millega oma kulul korraldatav autovedu on seotud.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_17 (redaktsioon 747699)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "747699",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_17_v13062111"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_17_v13062111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühenduse tegevusloa ja selle kinnitatud ärakirja vorm ning sellele kantavad andmed peavad vastama nõukogu määruse (EMÜ) nr 881/92 I lisas toodud loa vormile ja sellele kantavatele andmetele. Ühenduse tegevusloa kinnitatud ärakirja märkuste lahtrisse kantakse sõiduki registreerimismärk. Riigisisesele tegevusloale märgitakse järgmised andmed: vedaja nimi või ärinimi ning tema registreeritud asukoht ja registrikood; tegevusloa number; tegevusloa andmise kuupäev ja selle kehtivusaeg; tegevusloa andja nimetus ja pitser; tegevusloale alla kirjutava isiku ametinimetus, nimi ja allkiri. (2) Riigisisese autoveo sõidukikaardile märgitakse järgmised andmed: mootorsõiduki omanikuks või kasutajaks oleva vedaja nimi või ärinimi, registreeritud asukoht ja registrikood; sõidukikaardi number; sõidukikaardi andmise kuupäev ja selle kehtivusaeg; sõidukikaardi andmise aluseks oleva tegevusloa andja nimetus ja tegevusloa number; mootorsõiduki mark, kaubanduslik nimetus ja registreerimismärk; mootorsõiduki omaniku nimi; sõidukikaardi andja nimetus ja pitser; sõidukikaardile alla kirjutava isiku ametinimetus, nimi ja allkiri. (3) Oma kulul korraldatava rahvusvahelise autoveo tegevusloale ja sõidukikaardile kantakse peale käesoleva paragrahvi lõigetes 1 ja 2 nimetatud andmete ka tegevusloa ja sõidukikaardi taotleja tegevusala, millega oma kulul korraldatav autovedu on seotud. (4) Tegevusloa ja sõidukikaardi vormid",
      "rdfs:label": {
        "@value": "AUTOVE_Par_17 (redaktsioon 13062111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13062111",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_17_v102032012009"
      },
      "estleg:versionValidTo": {
        "@value": "2012-03-11",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_17_v102032012009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa ja selle kinnitatud ärakirja vorm ning sellele kantavad andmed peavad vastama Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 II lisale. Tegevusloa kinnitatud ärakirja erimärkuste lahtrisse kantakse sõiduki registreerimisnumber ja vedaja äriregistri kood. (2) Juhitunnistuse vorm ja sellele kantavad andmed peavad vastama Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 III lisale. (3) Oma kulul sõitjateveo sertifikaadi vorm ning sellele kantavad andmed peavad vastama Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1073/2009 artikli 5 lõike 5 alusel kehtestatud sertifikaadi vormile ja sellele kantavatele andmetele.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_17 (redaktsioon 102032012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102032012009",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_17_v111012018001"
      },
      "estleg:versionValidTo": {
        "@value": "2018-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_17_v111012018001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusluba antakse kümneks aastaks, kui taotleja ei soovi seda lühemaks ajaks. (2) Tegevusloa ärakiri antakse kümneks aastaks, kui taotleja ei soovi seda lühemaks ajaks. Tegevusloa ärakirja ei anta pikemaks ajaks kui tegevusloa kehtivusaeg. Kui tegevusloa ärakirja taotlemisel esitati Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 7 lõikes 2 nimetatud dokument, ei anta tegevusloa ärakirja pikemaks ajaks kui selle dokumendi kehtivusaeg. (3) Kui tegevusloa ärakirja taotletakse auto kohta, mis on registreeritud mõne teise Euroopa Liidu või Euroopa Majanduspiirkonna liikmesriigi või Šveitsi Konföderatsiooni ametlikus registris ja taotleja on kantud auto registreerimistunnistusele omaniku või kasutajana, antakse tegevusloa ärakiri käesoleva paragrahvi lõikes 2 nimetatud kehtivusajaga. (4) Kui tegevusloa ärakirja taotletakse auto kohta, mis on registreeritud mõne teise Euroopa Liidu või Euroopa Majanduspiirkonna liikmesriigi või Šveitsi Konföderatsiooni ametlikus registris ja autot kasutatakse kasutuslepingu alusel, ei või tegevusloa ärakirja kehtivusaeg olla pikem kui auto kasutuslepingu ja tegevusloa kehtivusaeg. (5) Juhitunnistus antakse viieks aastaks, kui taotleja ei soovi seda lühemaks ajaks. Juhitunnistust ei anta pikemaks ajaks kui juhitunnistust taotlevale vedajale antud tegevusloa kehtivusaeg või juhitunnistuse taotlemiseks esitatud käesoleva seaduse § 13 lõike 3 punktides 2–6 nimetatud dokumentide kehtivusaeg. (6) Sertifikaat antakse viieks aastaks, kui taotleja ei soovi seda lühemaks ajaks.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_17 (redaktsioon 111012018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111012018001",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_17_v122032022011"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_17_v122032022011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusluba antakse kümneks aastaks, kui taotleja ei soovi seda lühemaks ajaks. (2) Tegevusloa ärakiri antakse kümneks aastaks, kui taotleja ei soovi seda lühemaks ajaks. Tegevusloa ärakirja ei anta pikemaks ajaks kui tegevusloa kehtivusaeg. Kui tegevusloa ärakirja taotlemisel esitati Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 7 lõikes 2 nimetatud dokument, ei anta tegevusloa ärakirja pikemaks ajaks kui selle dokumendi kehtivusaeg. (3) Kui tegevusloa ärakirja taotletakse auto kohta, mis on registreeritud mõne teise Euroopa Liidu või Euroopa Majanduspiirkonna liikmesriigi või Šveitsi Konföderatsiooni ametlikus registris ja taotleja on kantud auto registreerimistunnistusele omaniku või kasutajana, antakse tegevusloa ärakiri käesoleva paragrahvi lõikes 2 nimetatud kehtivusajaga. (4) Kui tegevusloa ärakirja taotletakse auto kohta, mida vedaja kasutab kasutuslepingu alusel, ei või tegevusloa ärakirja kehtivusaeg olla pikem kui auto kasutuslepingu kehtivusaeg. (5) Juhitunnistus antakse viieks aastaks, kui taotleja ei soovi seda lühemaks ajaks. Juhitunnistust ei anta pikemaks ajaks kui juhitunnistust taotlevale vedajale antud tegevusloa kehtivusaeg või juhitunnistuse taotlemiseks esitatud käesoleva seaduse § 13 lõike 3 punktides 2–6 nimetatud dokumentide kehtivusaeg. (6) Sertifikaat antakse viieks aastaks, kui taotleja ei soovi seda lühemaks ajaks.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_17 (redaktsioon 122032022011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032022011"
    },
    {
      "@id": "estleg:AUTOVE_Par_18_v26401",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tasulise autoveo tegevusluba antakse esmakordselt üheks aastaks ja järgmistel kordadel viieks aastaks, kui tegevusloa taotleja ei soovi seda lühemaks ajaks. (2) Oma kulul korraldatava rahvusvahelise autoveo tegevusluba antakse viieks aastaks, kui tegevusloa taotleja ei soovi seda lühemaks ajaks. (3) Sõidukikaart kehtib üksnes tegevusloa kehtivusajal. Rendile võetud sõiduki korral kehtib sõidukikaart tegevusloa kehtivusajal, kuid mitte kauem kui rendilepingu tähtaja lõpuni. (4) Kui tegevusloa või sõidukikaardi kehtivusaeg on möödunud, nende kehtivus on peatatud või need on tunnistatud kehtetuks, tuleb dokument selle andjale viie tööpäeva jooksul tagastada.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_18 (redaktsioon 26401)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26401",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_18_v747699"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_18_v747699",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tasulise autoveo tegevusluba antakse esmakordselt üheks aastaks ja järgmistel kordadel viieks aastaks, kui ajavahemik eelmise tegevusloa lõppemise ja uue tegevusloa taotlemise vahel ei ületa kuut kuud. Nimetatud ajavahemiku ületamise korral antakse taotlejale tegevusluba üheks aastaks. Tegevusloa taotleja soovil võib tegevusloa anda lühemaks tähtajaks kui viis aastat. (2) Oma kulul korraldatava rahvusvahelise autoveo tegevusluba antakse viieks aastaks, kui tegevusloa taotleja ei soovi seda lühemaks ajaks. (3) Sõidukikaart kehtib üksnes tegevusloa kehtivusajal. Rendile võetud sõiduki korral kehtib sõidukikaart tegevusloa kehtivusajal, kuid mitte kauem kui rendilepingu tähtaja lõpuni. (4) Kui tegevusloa või sõidukikaardi kehtivusaeg on möödunud, nende kehtivus on peatatud või need on tunnistatud kehtetuks, tuleb dokument selle andjale viie tööpäeva jooksul tagastada.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_18 (redaktsioon 747699)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "747699",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_18_v1027733"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_18_v1027733",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tasulise autoveo tegevusluba antakse esmakordselt üheks aastaks ja järgmistel kordadel viieks aastaks, kui ajavahemik eelmise tegevusloa lõppemise ja uue tegevusloa taotlemise vahel ei ületa kuut kuud. Nimetatud ajavahemiku ületamise korral antakse taotlejale tegevusluba üheks aastaks. Tegevusloa taotleja soovil võib tegevusloa anda lühemaks tähtajaks kui viis aastat. (2) Oma kulul korraldatava rahvusvahelise autoveo tegevusluba antakse viieks aastaks, kui tegevusloa taotleja ei soovi seda lühemaks ajaks. (3) Sõidukikaart kehtib üksnes tegevusloa kehtivusajal. Rendile võetud sõiduki korral kehtib sõidukikaart tegevusloa kehtivusajal, kuid mitte kauem kui rendilepingu tähtaja lõpuni. (4) Kui tegevusloa või sõidukikaardi kehtivusaeg on möödunud, nende kehtivus on peatatud või need on tunnistatud kehtetuks, tuleb dokument selle andjale viie tööpäeva jooksul tagastada.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_18 (redaktsioon 1027733)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027733",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_18_v13062111"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_18_v13062111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühenduse tegevusluba antakse viieks aastaks. Riigisisene tegevusluba antakse esmakordselt kaheks aastaks ja järgmistel kordadel viieks aastaks, kui ajavahemik eelmise tegevusloa lõppemise ja uue tegevusloa taotlemise vahel ei ületa kuut kuud. Nimetatud ajavahemiku ületamise korral antakse taotlejale riigisisene tegevusluba kaheks aastaks. (2) Oma kulul korraldatava rahvusvahelise autoveo tegevusluba antakse viieks aastaks, kui tegevusloa taotleja ei soovi seda lühemaks ajaks. (3) Sõidukikaart kehtib üksnes tegevusloa kehtivusajal. (4) Kui tegevusloa või sõidukikaardi kehtivusaeg on möödunud, nende kehtivus on peatatud või need on tunnistatud kehtetuks, tuleb dokument selle andjale viie tööpäeva jooksul tagastada.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_18 (redaktsioon 13062111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13062111",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_18_v102032012009"
      },
      "estleg:versionValidTo": {
        "@value": "2012-03-11",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_18_v102032012009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusluba antakse kümneks aastaks, kui taotleja ei soovi seda lühemaks ajaks. (2) Tegevusloa kinnitatud ärakiri kehtib üksnes tegevusloa kehtivusajal. Kui tegevusloa kinnitatud ärakirja taotletakse mootorsõidukile, mis ei ole registreeritud Eesti Vabariigis, vaid mõnes teises EL-i või EMP liikmesriigis, antakse ärakiri kehtivusajaga, mis ei või olla pikem kui sõiduki kasutuslepingu kehtivusaeg ega pikem kui üks aasta. (3) Juhitunnistus antakse kehtivusajaga, mis ei tohi olla pikem kui juhitunnistust taotlevale vedajale antud ühenduse tegevusloa kehtivusaeg, juhitunnistuse taotlemiseks esitatud käesoleva seaduse § 13 lõike 3 punktides 2–4 nimetatud dokumentide kehtivusaeg ega pikem kui viis aastat. (4) Oma kulul sõitjateveo sertifikaat antakse kümneks aastaks, kui taotleja ei soovi seda lühemaks ajaks. (5) Kui tegevusloa, selle kinnitatud ärakirja, juhitunnistuse ja oma kulul sõitjateveo sertifikaadi kehtivus on peatatud või on nimetatud dokumendid kehtetuks tunnistatud, tuleb need dokumendi andjale viie tööpäeva jooksul tagastada.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_18 (redaktsioon 102032012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102032012009",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_18_v111012018001"
      },
      "estleg:versionValidTo": {
        "@value": "2018-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_18_v111012018001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa vorm ja tegevusloa ärakirja vorm ning nendele kantavad andmed peavad vastama Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 II lisale. Tegevusloa ärakirja erimärkuste lahtrisse kantakse auto registreerimisnumber ja vedaja äriregistri kood. (2) Juhitunnistuse vorm ja sellele kantavad andmed peavad vastama Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 III lisale. (3) Sertifikaadi vorm ning sellele kantavad andmed peavad vastama komisjoni määruse (EL) nr 361/2014, millega kehtestatakse Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1073/2009 üksikasjalikud rakenduseeskirjad seoses bussidega toimuva rahvusvahelise reisijateveo dokumentidega ning tunnistatakse kehtetuks komisjoni määrus (EÜ) nr 2121/984 (ELT L 107, 10.04.2014, lk 39–55), V lisale.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_18 (redaktsioon 111012018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111012018001",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_18_v126062018022"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_18_v126062018022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa vorm ja tegevusloa ärakirja vorm ning nendele kantavad andmed peavad vastama Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 II lisale. Tegevusloa ärakirja erimärkuste lahtrisse kantakse auto registreerimisnumber ja vedaja äriregistri kood. (2) Juhitunnistuse vorm ja sellele kantavad andmed peavad vastama Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 III lisale. (3) Sertifikaadi vorm ning sellele kantavad andmed peavad vastama komisjoni määruse (EL) nr 361/2014, millega kehtestatakse Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1073/2009 üksikasjalikud rakenduseeskirjad seoses bussidega toimuva rahvusvahelise reisijateveo dokumentidega ning tunnistatakse kehtetuks komisjoni määrus (EÜ) nr 2121/98 (ELT L 107, 10.04.2014, lk 39–55), V lisale.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_18 (redaktsioon 126062018022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018022",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_18_v130062020018"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_18_v130062020018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa vorm ja tegevusloa ärakirja vorm ning nendele kantavad andmed peavad vastama Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 II lisale. Tegevusloa ärakirja erimärkuste lahtrisse kantakse auto registreerimisnumber ja vedaja äriregistri kood. (2) Juhitunnistuse vorm ja sellele kantavad andmed peavad vastama Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 III lisale. Juhitunnistuse erimärkuste lahtrisse kantakse autojuhi ameti- või täienduskoolituse läbimist tõendav Euroopa Liidu ühtlustatud kood „95”, mida on nimetatud Euroopa Parlamendi ja nõukogu direktiivi 2006/126/EÜ juhilubade kohta (ELT L 403, 30.12.2006, lk 18–60) I lisas. (3) Sertifikaadi vorm ning sellele kantavad andmed peavad vastama komisjoni määruse (EL) nr 361/2014, millega kehtestatakse Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1073/2009 üksikasjalikud rakenduseeskirjad seoses bussidega toimuva rahvusvahelise reisijateveo dokumentidega ning tunnistatakse kehtetuks komisjoni määrus (EÜ) nr 2121/98 (ELT L 107, 10.04.2014, lk 39–55), V lisale.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_18 (redaktsioon 130062020018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062020018"
    },
    {
      "@id": "estleg:AUTOVE_Par_19_v26401",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa andja võib selle omanikule teha ettekirjutuse või ta võib tegevusloa või selle alusel antud sõidukikaardi kehtivuse kindlaksmääratud ajaks peatada või tunnistada kehtetuks, kui: tegevusloa omanik ei vasta enam käesoleva seaduse §-s 5 või 10 sätestatud nõuetele; tegevusloa ja sõidukikaardi omaniku andmed ei vasta tegevusloal ja sõidukikaardil märgitule. (2) Tegevusloa andja võib tegevusloa kehtivuse peatada või tegevusloa tunnistada kehtetuks ka selle omaniku enda taotlusel. (3) Kui kontrollimise tulemusel selgub, et vedaja majandusseisund ei vasta käesoleva seaduse §-s 6 sätestatud nõuetele, kuid tema tegevuse majanduslikud näitajad tõendavad, et ta on edaspidi suuteline seda nõuet täitma, võib tegevusloa andja jätta tasulise autoveo tegevusloa kehtivuse peatamata, lubades korraldada autovedu kuni üks aasta.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_19 (redaktsioon 26401)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26401",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_19_v747699"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_19_v747699",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa andja võib selle omanikule teha ettekirjutuse või ta võib tegevusloa või selle alusel antud sõidukikaardi kehtivuse kindlaksmääratud ajaks peatada või tunnistada kehtetuks, kui: tegevusloa omanik ei vasta enam käesoleva seaduse §-s 5 või 10 sätestatud nõuetele; tegevusloa ja sõidukikaardi omaniku andmed ei vasta tegevusloal ja sõidukikaardil märgitule; tegevusloa omanik, tema vedude eest vastutav isik või tema juures töötav autojuht on rikkunud vedude korraldamisel suuremõõtmelise või raskekaalulise veose vedamiseks teeseaduse (RT I 1999, 26, 377; 93, 831; 2001, 43, 241; 50, 283; 93, 565; 2002, 41, 249; 47, 297; 53, 336; 61, 375; 63, 387; 2003, 79, 530; 88, 594) § 35 lõike 2 alusel kehtestatud eriloal märgitud nõudeid või teinud nimetatud vedusid eriloata; tegevusloa omanik on rikkunud vedude korraldamisel rahvusvaheliste kokkulepetega kehtestatud nõudeid; oma kulul korraldatava rahvusvahelise autoveo tegevusloa omanik osutab selle alusel tasulist autoveoteenust; tegevusloa omanik ei täida ametialases tegevuses liiklusseaduse (RT I 2001, 3, 6; 2002, 92, 531; 90, 521; 105, 613; 110, 654 ja 655; 2003, 26, 156; 32, õiend; 78, 522), käesoleva seaduse või nende alusel vastuvõetud õigusaktidega kehtestatud nõudeid. (2) Tegevusloa andja võib tegevusloa kehtivuse peatada või tegevusloa tunnistada kehtetuks ka selle omaniku enda taotlusel. (3) Kui kontrollimise tulemusel selgub, et vedaja majandusseisund ei vasta käesoleva seaduse §-s 6 sätestatud nõuetele, kuid tema tegevuse majanduslikud näitajad tõendavad, et ta on edaspidi suuteline seda nõuet täitma, võib tegevusloa andja jätta tasulise autoveo tegevusloa kehtivuse peatamata, lubades korraldada autovedu kuni üks aasta.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_19 (redaktsioon 747699)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "747699",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_19_v1027733"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_19_v1027733",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa andja võib selle omanikule teha ettekirjutuse või ta võib tegevusloa või selle alusel antud sõidukikaardi kehtivuse kindlaksmääratud ajaks peatada või tunnistada kehtetuks, kui: tegevusloa omanik ei vasta enam käesoleva seaduse § -s 5 või 10 sätestatud nõuetele; tegevusloa ja sõidukikaardi omaniku andmed ei vasta tegevusloal ja sõidukikaardil märgitule; tegevusloa omanik, tema vedude eest vastutav isik või tema juures töötav autojuht on rikkunud vedude korraldamisel suuremõõtmelise või raskekaalulise veose vedamiseks teeseaduse (RT I 1999, 26, 377; 93, 831; 2001, 43, 241; 50, 283; 93, 565; 2002, 41, 249; 47, 297; 53, 336; 61, 375; 63, 387; 2003, 79, 530; 88, 594) § 35 lõike 2 alusel kehtestatud eriloal märgitud nõudeid või teinud nimetatud vedusid eriloata; tegevusloa omanik on rikkunud vedude korraldamisel rahvusvaheliste kokkulepetega kehtestatud nõudeid; oma kulul korraldatava rahvusvahelise autoveo tegevusloa omanik osutab selle alusel tasulist autoveoteenust; tegevusloa omanik ei täida ametialases tegevuses liiklusseaduse (RT I 2001, 3, 6; 2002, 92, 531; 90, 521; 105, 613; 110, 654 ja 655; 2003, 26, 156; 32, õiend; 78, 522), käesoleva seaduse või nende alusel vastuvõetud õigusaktidega kehtestatud nõudeid. (2) Tegevusloa andja võib tegevusloa kehtivuse peatada või tegevusloa tunnistada kehtetuks ka selle omaniku enda taotlusel. (3) Kui kontrollimise tulemusel selgub, et vedaja majandusseisund ei vasta käesoleva seaduse § -s 6 sätestatud nõuetele, kuid tema tegevuse majanduslikud näitajad tõendavad, et ta on edaspidi suuteline seda nõuet täitma, võib tegevusloa andja jätta tasulise autoveo tegevusloa kehtivuse peatamata, lubades korraldada autovedu kuni üks aasta.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_19 (redaktsioon 1027733)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027733",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_19_v13062111"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_19_v13062111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa või sõidukikaardi andja võib tegevusloa või sõidukikaardi omajale teha puuduste kõrvaldamiseks ettekirjutuse, tegevusloa või sõidukikaardi kehtivuse kindlaksmääratud ajaks peatada või tegevusloa või sõidukikaardi kehtetuks tunnistada, kui: tegevusloa omaja ei vasta enam käesoleva seaduse §-s 5 või 10 sätestatud nõuetele; tegevusloa ja sõidukikaardi omaja andmed ei vasta tegevusloal ja sõidukikaardil märgitule; tegevusloa omaja, tema vedude eest vastutav isik või tema juures töötav autojuht on rikkunud vedude korraldamisel suuremõõtmelise või raskekaalulise veose vedamiseks teeseaduse § 35 lõike 2 alusel kehtestatud eriloal märgitud nõudeid või teinud nimetatud vedusid eriloata; tegevusloa omaja on rikkunud vedude korraldamisel rahvusvaheliste kokkulepetega kehtestatud nõudeid; oma kulul korraldatava rahvusvahelise autoveo tegevusloa omaja osutab selle alusel tasulist autoveoteenust; tegevusloa omaja või tema vedude eest vastutav isik on rikkunud ametialases tegevuses liiklusseaduse, käesoleva seaduse või nende alusel vastuvõetud õigusaktidega kehtestatud nõudeid. (2) Tegevusloa andja võib tegevusloa kehtivuse peatada või tegevusloa tunnistada kehtetuks ka selle omaja enda taotlusel. (3) Kui kontrollimise tulemusel selgub, et vedaja majandusseisund ei vasta käesoleva seaduse § -s 6 sätestatud nõuetele, kuid tema tegevuse majanduslikud näitajad tõendavad, et ta on edaspidi suuteline seda nõuet täitma, võib tegevusloa andja jätta tasulise autoveo tegevusloa kehtivuse peatamata, lubades korraldada autovedu kuni üks aasta.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_19 (redaktsioon 13062111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13062111",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_19_v131122010008"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_19_v131122010008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa või sõidukikaardi andja võib tegevusloa või sõidukikaardi omajale teha puuduste kõrvaldamiseks ettekirjutuse, tegevusloa või sõidukikaardi kehtivuse kindlaksmääratud ajaks peatada või tegevusloa või sõidukikaardi kehtetuks tunnistada, kui: tegevusloa omaja ei vasta enam käesoleva seaduse §-s 5 või 10 sätestatud nõuetele; tegevusloa ja sõidukikaardi omaja andmed ei vasta tegevusloal ja sõidukikaardil märgitule; tegevusloa omaja, tema vedude eest vastutav isik või tema juures töötav autojuht on rikkunud vedude korraldamisel suuremõõtmelise või raskekaalulise veose vedamiseks teeseaduse § 35 lõike 2 alusel kehtestatud eriloal märgitud nõudeid või teinud nimetatud vedusid eriloata; tegevusloa omaja on rikkunud vedude korraldamisel rahvusvaheliste kokkulepetega kehtestatud nõudeid; oma kulul korraldatava rahvusvahelise autoveo tegevusloa omaja osutab selle alusel tasulist autoveoteenust; tegevusloa omaja või tema vedude eest vastutav isik on rikkunud ametialases tegevuses liiklusseaduse, käesoleva seaduse või nende alusel vastuvõetud õigusaktidega kehtestatud nõudeid. (2) Tegevusloa andja võib tegevusloa kehtivuse peatada või tegevusloa tunnistada kehtetuks ka selle omaja enda taotlusel. (3) Kui kontrollimise tulemusel selgub, et vedaja majandusseisund ei vasta käesoleva seaduse §-s 6 sätestatud nõuetele, kuid tema tegevuse majanduslikud näitajad tõendavad, et ta on edaspidi suuteline seda nõuet täitma, võib tegevusloa andja jätta tasulise autoveo tegevusloa kehtivuse peatamata, lubades korraldada autovedu kuni üks aasta.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_19 (redaktsioon 131122010008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010008",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_19_v102032012009"
      },
      "estleg:versionValidTo": {
        "@value": "2012-03-11",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_19_v102032012009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa, selle kinnitatud ärakirja ja juhitunnistuse andja teeb tegevusloa, selle kinnitatud ärakirja või juhitunnistuse omajale puuduste kõrvaldamiseks ettekirjutuse, kui kontrollimise tulemusena selgub, et: tegevusloa või selle kinnitatud ärakirja omaja ei vasta enam ühele või mitmele kehtivale nõudele, mis oli nimetatud dokumendi andmise aluseks; juhitunnistuse omaja ei vasta enam ühele või mitmele kehtivale nõudele, mis oli nimetatud dokumendi andmise aluseks; tegevusloa, selle kinnitatud ärakirja või juhitunnistuse omaja andmed ei vasta tegevusloale, selle kinnitatud ärakirjale või juhitunnistusele märgitule.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_19 (redaktsioon 102032012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102032012009",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_19_v111012018001"
      },
      "estleg:versionValidTo": {
        "@value": "2018-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_19_v111012018001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaks Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 13 lõikes 3, Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 artikli 12 lõigetes 1 ja 2 ning majandustegevuse seadustiku üldosa seaduse § 43 lõikes 1 sätestatud alustele võib tegevusloa või tegevusloa ärakirja kehtivuse kindlaksmääratud ajaks peatada, kui: vedajat, tema veokorraldusjuhti või vedaja juures töölepingu või võlaõigusliku lepingu alusel veosevedu teostavaid või teostanud autojuhte on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol karistatud Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 6 lõike 1 punktis b nimetatud raske õigusrikkumise eest, mille karistusandmed ei ole karistusregistri seaduse kohaselt sellest registrist kustutatud, või ilmneb asjaolu, et nimetatud rikkumise toimepanemisel välisriigis ei ole välisriigis tehtud otsuse jõustumisest möödunud karistusregistri seaduse §-s 24 sätestatud karistusandmete kustutamise tähtaeg; vedajat või tema veokorraldusjuhti on tasulisel või oma kulul korraldataval veoseveol karistusseadustiku § 279 alusel karistatud autojuhi töö-, sõidu- ja puhkeaja nõuete täitmise üle riikliku järelevalve teostamise takistamise eest ning selle õigusrikkumise karistusandmed ei ole karistusregistri seaduse kohaselt sellest registrist kustutatud; vedaja on rikkunud käesoleva seaduse § 5 lõikes 3 sätestatud nõuet ja ei ole selle rikkumise kohta tehtud ettekirjutuse kohaselt puudusi ettenähtud tähtaja jooksul kõrvaldanud; vedajat, tema veokorraldusjuhti või vedaja juures töölepingu või võlaõigusliku lepingu alusel veosevedu teostavaid või teostanud autojuhte on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol karistatud liiklusseaduse §-de 2616–2619 rikkumise eest. (2) Lisaks Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 13 lõikes 3, Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 artikli 12 lõigetes 1 ja 2 ning majandustegevuse seadustiku üldosa seaduse § 37 lõikes 2 sätestatud alustele võib tegevusloa või tegevusloa ärakirja kehtetuks tunnistada, kui: vedaja ei ole käesoleva seaduse või liiklusseaduse § 139 lõike 4 alusel tehtud ettekirjutuse kohaselt puudusi ettenähtud tähtaja jooksul kõrvaldanud; vedajat, tema veokorraldusjuhti või vedaja juures töölepingu või võlaõigusliku lepingu alusel veosevedu teostavaid või teostanud autojuhte on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol karistatud Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 6 lõike 1 punktis b nimetatud raske õigusrikkumise eest, mille karistusandmed ei ole karistusregistri seaduse kohaselt sellest registrist kustutatud, või ilmneb asjaolu, et nimetatud rikkumise toimepanemisel välisriigis ei ole välisriigis tehtud otsuse jõustumisest möödunud karistusregistri seaduse §-s 24 sätestatud karistusandmete kustutamise tähtaeg; vedajat või tema veokorraldusjuhti on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol karistusseadustiku § 279 alusel karistatud autojuhi töö-, sõidu- ja puhkeaja nõuete täitmise üle riikliku järelevalve teostamise takistamise eest ning selle õigusrikkumise karistusandmed ei ole karistusregistri seaduse kohaselt sellest registrist kustutatud; vedajat, tema veokorraldusjuhti või vedaja juures töölepingu või võlaõigusliku lepingu alusel veosevedu teostavaid või teostanud autojuhte on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol karistatud liiklusseaduse §-de 2616–2619 rikkumise eest. (3) Käesoleva paragrahvi lõike 1 punktides 1 ja 2 sätestatud tegevusloa või tegevusloa ärakirja kehtivuse kindlaksmääratud ajaks peatamise aluseid ja käesoleva paragrahvi lõike 2 punktides 2 ja 3 sätestatud tegevusloa või tegevusloa ärakirja kehtetuks tunnistamise aluseid ei rakendata juhul, kui asjaomase haldusmenetluse käigus leitakse, et tegevusloa või tegevusloa ärakirja kehtivuse kindlaksmääratud ajaks peatamine või kehtetuks tunnistamine oleks ebaproportsionaalne meede. (4) Tegevusloa või tegevusloa ärakirja võib kehtetuks tunnistada ka juhul, kui tegevusloa või tegevusloa ärakirja omaja ei ole kuue kuu jooksul alates tegevusloa või tegevusloa ärakirja kehtima hakkamise kuupäevast asjaomast tegevusluba või tegevusloa ärakirja välja võtnud või talle ei ole võimalik nimetatud dokumenti kätte toimetada. (5) Tegevusloa võib kehtetuks tunnistada ka juhul, kui käesoleva seaduse § 7 lõikes 10 sätestatud nõude kohaselt ei ole vedaja kasutuses ühtegi autot, mille kohta ta peab olema kuue kuu jooksul tegevusloa kehtivusaja algusest arvates taotlenud ja saanud tegevusloa ärakirja. (6) Tegevusloa kehtetuks tunnistamisel tunnistatakse kehtetuks ka selle tegevusloa alusel antud tegevusloa ärakiri ja juhitunnistus, välja arvatud juhul, kui tegevusluba tunnistatakse kehtetuks käesoleva seaduse § 13 lõikes 5 nimetatud tegevusloa kaotamise, varguse või hävimise korral, ning kaotatud, varastatud või hävinud tegevusloa asemel antakse taotlejale uus tegevusluba, mille kehtivusaeg ei ole pikem kui asendatava tegevusloa kehtivusaeg. (7) Tegevusloa ärakiri tunnistatakse kehtetuks ka juhul, kui tegevusloa ärakirja andja tuvastab, et vedaja on tegevusloa ärakirjale kantud registreerimisnumbriga auto võõrandanud või et auto kasutusleping on lõppenud. (8) Tegevusloa ärakirja võib kehtetuks tunnistada ka juhul, kui käesoleva seaduse § 31 lõikes 3 sätestatud nõude kohaselt ei ole tagatud auto ja selle haagise õige kasutamine, tehniline korrasolek ja nõuetekohane hoidmine. (9) Lisaks Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 artikli 7 lõikes 2 ja artikli 12 lõikes 2 sätestatud alustele tunnistatakse juhitunnistus kehtetuks, kui: vedaja on esitanud juhitunnistuse kehtetuks tunnistamise taotluse; autojuht, kellele juhitunnistus taotleti, ei vasta enam vähemalt ühele käesoleva seaduse § 10 lõikes 2 sätestatud nõudele. (10) Käesoleva paragrahvi lõigetes 1–9 sätestatud alustel teeb otsuse Majandus- ja Kommunikatsiooniministeerium või tema volitusel Maanteeamet või käesoleva seaduse § 47 lõikes 1 nimetatud isik, kui temale on selle ülesande täitmine halduslepinguga üle antud.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_19 (redaktsioon 111012018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111012018001",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_19_v126062018023"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_19_v126062018023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaks Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 13 lõikes 3, Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 artikli 12 lõigetes 1 ja 2 ning majandustegevuse seadustiku üldosa seaduse § 43 lõikes 1 sätestatud alustele võib tegevusloa või tegevusloa ärakirja kehtivuse kindlaksmääratud ajaks peatada, kui: vedajat, tema veokorraldusjuhti või vedaja juures töölepingu või võlaõigusliku lepingu alusel veosevedu teostavaid või teostanud autojuhte on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol karistatud Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 6 lõike 1 punktis b nimetatud raske õigusrikkumise eest, mille karistusandmed ei ole karistusregistri seaduse kohaselt sellest registrist kustutatud, või ilmneb asjaolu, et nimetatud rikkumise toimepanemisel välisriigis ei ole välisriigis tehtud otsuse jõustumisest möödunud karistusregistri seaduse §-s 24 sätestatud karistusandmete kustutamise tähtaeg; vedajat või tema veokorraldusjuhti on tasulisel või oma kulul korraldataval veoseveol karistusseadustiku § 279 alusel karistatud autojuhi töö-, sõidu- ja puhkeaja nõuete täitmise üle riikliku järelevalve teostamise takistamise eest ning selle õigusrikkumise karistusandmed ei ole karistusregistri seaduse kohaselt sellest registrist kustutatud; vedaja on rikkunud käesoleva seaduse § 5 lõikes 3 sätestatud nõuet ja ei ole selle rikkumise kohta tehtud ettekirjutuse kohaselt puudusi ettenähtud tähtaja jooksul kõrvaldanud; vedajale, tema veokorraldusjuhile või vedaja juures töölepingu või võlaõigusliku lepingu alusel veosevedu teostavale või teostanud autojuhile on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol määratud või mõistetud karistus või mõjutustrahv liiklusseaduse §-de 2616–2619 rikkumise eest. (2) Lisaks Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 13 lõikes 3, Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 artikli 12 lõigetes 1 ja 2 ning majandustegevuse seadustiku üldosa seaduse § 37 lõikes 2 sätestatud alustele võib tegevusloa või tegevusloa ärakirja kehtetuks tunnistada, kui: vedaja ei ole käesoleva seaduse või liiklusseaduse § 139 lõike 4 alusel tehtud ettekirjutuse kohaselt puudusi ettenähtud tähtaja jooksul kõrvaldanud; vedajat, tema veokorraldusjuhti või vedaja juures töölepingu või võlaõigusliku lepingu alusel veosevedu teostavaid või teostanud autojuhte on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol karistatud Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1071/2009 artikli 6 lõike 1 punktis b nimetatud raske õigusrikkumise eest, mille karistusandmed ei ole karistusregistri seaduse kohaselt sellest registrist kustutatud, või ilmneb asjaolu, et nimetatud rikkumise toimepanemisel välisriigis ei ole välisriigis tehtud otsuse jõustumisest möödunud karistusregistri seaduse §-s 24 sätestatud karistusandmete kustutamise tähtaeg; vedajat või tema veokorraldusjuhti on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol karistusseadustiku § 279 alusel karistatud autojuhi töö-, sõidu- ja puhkeaja nõuete täitmise üle riikliku järelevalve teostamise takistamise eest ning selle õigusrikkumise karistusandmed ei ole karistusregistri seaduse kohaselt sellest registrist kustutatud; vedajale, tema veokorraldusjuhile või vedaja juures töölepingu või võlaõigusliku lepingu alusel veosevedu teostavale või teostanud autojuhile on rohkem kui ühe korra tasulisel või oma kulul korraldataval veoseveol määratud või mõistetud karistus või mõjutustrahv liiklusseaduse §-de 2616–2619 rikkumise eest. (2¹) Käesoleva paragrahvi lõike 1 punktis 4 ja lõike 2 punktis 4 sätestatud mõjutustrahvi kohta e-toimiku süsteemi kantud andmetel on õiguslik tähendus. (3) Käesoleva paragrahvi lõike 1 punktides 1 ja 2 sätestatud tegevusloa või tegevusloa ärakirja kehtivuse kindlaksmääratud ajaks peatamise aluseid ja käesoleva paragrahvi lõike 2 punktides 2 ja 3 sätestatud tegevusloa või tegevusloa ärakirja kehtetuks tunnistamise aluseid ei rakendata juhul, kui asjaomase haldusmenetluse käigus leitakse, et tegevusloa või tegevusloa ärakirja kehtivuse kindlaksmääratud ajaks peatamine või kehtetuks tunnistamine oleks ebaproportsionaalne meede. (4) Tegevusloa või tegevusloa ärakirja võib kehtetuks tunnistada ka juhul, kui tegevusloa või tegevusloa ärakirja omaja ei ole kuue kuu jooksul alates tegevusloa või tegevusloa ärakirja kehtima hakkamise kuupäevast asjaomast tegevusluba või tegevusloa ärakirja välja võtnud või talle ei ole võimalik nimetatud dokumenti kätte toimetada. (5) Tegevusloa võib kehtetuks tunnistada ka juhul, kui käesoleva seaduse § 7 lõikes 10 sätestatud nõude kohaselt ei ole vedaja kasutuses ühtegi autot, mille kohta ta peab olema kuue kuu jooksul tegevusloa kehtivusaja algusest arvates taotlenud ja saanud tegevusloa ärakirja. (6) Tegevusloa kehtetuks tunnistamisel tunnistatakse kehtetuks ka selle tegevusloa alusel antud tegevusloa ärakiri ja juhitunnistus, välja arvatud juhul, kui tegevusluba tunnistatakse kehtetuks käesoleva seaduse § 13 lõikes 5 nimetatud tegevusloa kaotamise, varguse või hävimise korral, ning kaotatud, varastatud või hävinud tegevusloa asemel antakse taotlejale uus tegevusluba, mille kehtivusaeg ei ole pikem kui asendatava tegevusloa kehtivusaeg. (7) Tegevusloa ärakiri tunnistatakse kehtetuks ka juhul, kui tegevusloa ärakirja andja tuvastab, et vedaja on tegevusloa ärakirjale kantud registreerimisnumbriga auto võõrandanud või et auto kasutusleping on lõppenud. (8) Tegevusloa ärakirja võib kehtetuks tunnistada ka juhul, kui käesoleva seaduse § 31 lõikes 3 sätestatud nõude kohaselt ei ole tagatud auto ja selle haagise õige kasutamine, tehniline korrasolek ja nõuetekohane hoidmine. (9) Lisaks Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1072/2009 artikli 7 lõikes 2 ja artikli 12 lõikes 2 sätestatud alustele tunnistatakse juhitunnistus kehtetuks, kui: vedaja on esitanud juhitunnistuse kehtetuks tunnistamise taotluse; autojuht, kellele juhitunnistus taotleti, ei vasta enam vähemalt ühele käesoleva seaduse § 10 lõikes 2 sätestatud nõudele. (10) Käesoleva paragrahvi lõigetes 1–9 sätestatud alustel teeb otsuse Majandus- ja Kommunikatsiooniministeerium või tema volitusel Maanteeamet või käesoleva seaduse § 47 lõikes 1 nimetatud isik, kui temale on selle ülesande täitmine halduslepinguga üle antud.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_19 (redaktsioon 126062018023)",
        "@language": "et"
      },
