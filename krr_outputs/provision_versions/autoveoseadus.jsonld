        "@type": "xsd:date"
      },
      "estleg:versionText": "Autojuhi poolt tasulise veoseveo teostamise eest juhitunnistuseta –karistatakse rahatrahviga kuni 200 trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_58 (redaktsioon 111012018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111012018001"
    },
    {
      "@id": "estleg:AUTOVE_Par_59_v111012018001",
