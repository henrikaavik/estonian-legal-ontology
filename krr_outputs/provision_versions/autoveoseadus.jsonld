    {
      "@id": "estleg:AUTOVE_Par_13_v747699",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_13"
      },
      "estleg:versionValidFrom": {
