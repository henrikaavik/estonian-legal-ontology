      }
    },
    {
      "@id": "estleg:AUTOVE_Par_14_v230826",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tasulise riigisisese autoveo tegevusloa ja sõidukikaardi ning rahvusvahelise autoveo sõidukikaardi annab taotlejale mittetulundusühing, kellega Majandus- ja Kommunikatsiooniministeerium on riigi nimel sõlminud sellekohase lepingu. (2) Rahvusvahelise autoveo tegevusloa annab taotlejale Majandus- ja kommunikatsiooniministeerium. (3) Tegevusloa ja sõidukikaardi andjal on õigus tegevusloa kehtivuse ajal kontrollida tegevusloa omaniku vastavust käesoleva seaduse § 5 või 10 nõuetele. Tegevusloa omanik peab kontrollimist võimaldama.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_14 (redaktsioon 230826)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "230826",
