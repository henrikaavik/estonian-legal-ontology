      }
    },
    {
      "@id": "estleg:AUTOVE_Par_23_v176173",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUTOVE_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teede- ja sideministril on õigus kehtestada: eri liiki veoste veoeeskirju; veose laadimise ja kinnitamise eeskirja. (2) Käesoleva paragrahvi lõikes 1 nimetatud eeskirjadega ei saa reguleerida veolepingu poolte lepingust tulenevaid õigusi ja kohustusi.",
      "rdfs:label": {
        "@value": "AUTOVE_Par_23 (redaktsioon 176173)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "176173",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUTOVE_Par_23_v230826"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AUTOVE_Par_23_v230826",
