      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AUTOVE_Par_20 (redaktsioon 131122010008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010008",
      "estleg:supersededByVersion": {
