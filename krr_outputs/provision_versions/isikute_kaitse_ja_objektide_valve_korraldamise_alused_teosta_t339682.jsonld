      },
      "dc:source": "Isikute kaitse ja objektide valve korraldamise alused, teostamise viisid ning koostöö kord"
    },
    {
      "@id": "estleg:Reg_339682_Par_1_v339682",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339682_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Isikukaitse on politsei poolt meetmete planeerimine ja rakendamine lähtuvalt ohuhinnangust eesmärgiga ennetada ja tõrjuda ohtu, mis on suunatud kaitstava isiku elu, tervise või kehalise puutumatuse vastu. Isikukaitse on politsei poolt meetmete planeerimine ja rakendamine lähtuvalt ohuhinnangust eesmärgiga ennetada ja tõrjuda ohtu, mis on suunatud kaitstava isiku elu, tervise või kehalise puutumatuse vastu. 2(2)Kaitstav isik on isik, kelle suhtes rakendatakse isikukaitset. Kaitstav isik on isik, kelle suhtes rakendatakse isikukaitset.",
      "rdfs:label": {
        "@value": "Reg_339682_Par_1 (redaktsioon 339682)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339682",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339682",
      "estleg:sourceAct": "Isikute kaitse ja objektide valve korraldamise alused, teostamise viisid ning koostöö kord",
      "estleg:provisionRef": "Reg_339682 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339682_Map"
      }
    },
    {
      "@id": "estleg:Reg_339682_Par_10_v339682",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339682_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Politsei- ja Piirivalveamet ning riigi- ja kohaliku omavalitsuse asutused, sh Riigikogu Kantselei, Riigikantselei, Vabariigi Presidendi Kantselei ja Riigikohus (edaspidi asutused) teevad oma pädevuse piires koostööd isikute kaitse ja objektide valve korraldamisel. Politsei- ja Piirivalveamet ning riigi- ja kohaliku omavalitsuse asutused, sh Riigikogu Kantselei, Riigikantselei, Vabariigi Presidendi Kantselei ja Riigikohus (edaspidi asutused) teevad oma pädevuse piires koostööd isikute kaitse ja objektide valve korraldamisel. 2(2)Koostööd erinevate asutuste vahel juhib ja koordineerib Politsei- ja Piirivalveamet. Koostööd erinevate asutuste vahel juhib ja koordineerib Politsei- ja Piirivalveamet.",
      "rdfs:label": {
        "@value": "Reg_339682_Par_10 (redaktsioon 339682)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339682",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339682",
      "estleg:sourceAct": "Isikute kaitse ja objektide valve korraldamise alused, teostamise viisid ning koostöö kord",
      "estleg:provisionRef": "Reg_339682 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339682_Map"
      }
    },
    {
      "@id": "estleg:Reg_339682_Par_11_v339682",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339682_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikukaitse ja objektivalve korraldamiseks ja tagamiseks asutus:11)teavitab Siseministeeriumit ning Politsei- ja Piirivalveametit rahvusvaheliselt kaitstava isiku riiki kutsumisest ja saabumisest;22)kooskõlastab enne rahvusvaheliselt kaitstava isiku riiki saabumist Politsei- ja Piirivalveametiga tema visiidi programmi;33)eraldab vastavalt sisustatud ja sidevahenditega varustatud tööruumid ning kannab nende kommunaal- ja sidekulud;44)kannab Vabariigi Valitsuse määratud objekti tehniliseks valveks vajalike elektrooniliste valveseadmete projekteerimise, paigaldamise ja hooldamise kulud;55)kannab isikukaitse ja objektivalve tagamisega seotud võimalikud lisakulud;66)teavitab Politsei- ja Piirivalveametit kaitstava isiku või valvatava objekti suhtes kavatsetavast või toimepandud õigusrikkumisest. Isikukaitse ja objektivalve korraldamiseks ja tagamiseks asutus: teavitab Siseministeeriumit ning Politsei- ja Piirivalveametit rahvusvaheliselt kaitstava isiku riiki kutsumisest ja saabumisest; kooskõlastab enne rahvusvaheliselt kaitstava isiku riiki saabumist Politsei- ja Piirivalveametiga tema visiidi programmi; eraldab vastavalt sisustatud ja sidevahenditega varustatud tööruumid ning kannab nende kommunaal- ja sidekulud; kannab Vabariigi Valitsuse määratud objekti tehniliseks valveks vajalike elektrooniliste valveseadmete projekteerimise, paigaldamise ja hooldamise kulud; kannab isikukaitse ja objektivalve tagamisega seotud võimalikud lisakulud; teavitab Politsei- ja Piirivalveametit kaitstava isiku või valvatava objekti suhtes kavatsetavast või toimepandud õigusrikkumisest.",
      "rdfs:label": {
        "@value": "Reg_339682_Par_11 (redaktsioon 339682)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339682",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339682",
      "estleg:sourceAct": "Isikute kaitse ja objektide valve korraldamise alused, teostamise viisid ning koostöö kord",
      "estleg:provisionRef": "Reg_339682 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339682_Map"
      }
    },
