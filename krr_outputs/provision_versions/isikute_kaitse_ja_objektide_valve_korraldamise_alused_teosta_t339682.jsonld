      }
    },
    {
      "@id": "estleg:Reg_339682_Par_5_v339682",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339682_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Objektivalve on erinevate meetmete planeerimine ning rakendamine lähtuvalt ohuhinnangust eesmärgiga tagada valvatava objekti ja selle juurde kuuluva territooriumi puutumatus ja vara säilimine. Objektivalve on erinevate meetmete planeerimine ning rakendamine lähtuvalt ohuhinnangust eesmärgiga tagada valvatava objekti ja selle juurde kuuluva territooriumi puutumatus ja vara säilimine.",
      "rdfs:label": {
        "@value": "Reg_339682_Par_5 (redaktsioon 339682)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339682",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339682",
      "estleg:sourceAct": "Isikute kaitse ja objektide valve korraldamise alused, teostamise viisid ning koostöö kord",
      "estleg:provisionRef": "Reg_339682 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339682_Map"
      }
    },
    {
      "@id": "estleg:Reg_339682_Par_6_v339682",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339682_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Objektivalve teostamise viisid on mehitatud valve, tehniline valve, mobiilvalve ja kompleksvalve. Objektivalve teostamise viisid on mehitatud valve, tehniline valve, mobiilvalve ja kompleksvalve. 2(2)Mehitatud valve on objekti vahetu valvamine ühe või mitme ametniku poolt.RT I201032159133249242010-06-18+03:00 Mehitatud valve on objekti vahetu valvamine ühe või mitme ametniku poolt. 3(3)Tehniline valve on objekti valvamine elektrooniliste valveseadmete abil, mis on sidekanali kaudu ühendatud lokaalse ja/või tsentraalse valvekeskusega. Tehniline valve on objekti valvamine elektrooniliste valveseadmete abil, mis on sidekanali kaudu ühendatud lokaalse ja/või tsentraalse valvekeskusega. 4(4)Mobiilvalve on objekti perioodiline kontrollimine ja objektilt saabuvatele häiretele reageerimine liikuva politseipatrulli poolt. Mobiilvalve on objekti perioodiline kontrollimine ja objektilt saabuvatele häiretele reageerimine liikuva politseipatrulli poolt. 5(5)Kompleksvalve on mehitatud valve, tehnilise valve ja mobiilvalve kombineeritud rakendamine. Kompleksvalve on mehitatud valve, tehnilise valve ja mobiilvalve kombineeritud rakendamine.",
      "rdfs:label": {
