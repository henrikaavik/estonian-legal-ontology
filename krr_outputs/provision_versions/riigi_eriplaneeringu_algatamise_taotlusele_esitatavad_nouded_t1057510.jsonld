      "estleg:versionValidFrom": {
        "@value": "2023-10-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus sätestab riigi eriplaneeringu algatamise taotlusele esitatavad nõuded, mis esitatakse Regionaal- ja Põllumajandusministeeriumile. Määrus sätestab riigi eriplaneeringu algatamise taotlusele esitatavad nõuded, mis esitatakse Regionaal- ja Põllumajandusministeeriumile.",
      "rdfs:label": {
        "@value": "Reg_1057510_Par_1 (redaktsioon 1057510)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057510",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057510",
      "estleg:sourceAct": "Riigi eriplaneeringu algatamise taotlusele esitatavad nõuded",
