    {
      "@id": "estleg:Reg_1028701_Par_17_v1028701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028701_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui taotlus ei vasta see § 16 lõikes 4 kehtestatud tingimustele või selgub, et taotluses on esitatud valeandmeid või esineb asjaolu, mille tõttu taotlejat või taotlust ei saa nõuetele vastavaks tunnistada või taotlust rahuldada, teeb rakendusasutus taotluse investeeringute kavasse arvamata jätmise otsuse. RT I 2019-02-06 3 106022019003 2019-02-09 Kui taotlus ei vasta see § 16 lõikes 4 kehtestatud tingimustele või selgub, et taotluses on esitatud valeandmeid või esineb asjaolu, mille tõttu taotlejat või taotlust ei saa nõuetele vastavaks tunnistada või taotlust rahuldada, teeb rakendusasutus taotluse investeeringute kavasse arvamata jätmise otsuse. 2 (2) Investeeringute kavasse arvamata jätmise otsusest teavitatakse ettepaneku esitajat viivitamatult pärast investeeringute kava kinnitamist. Kui investeeringute kavasse ei arvata riigiasutuse projekti, teavitab rakendusasutus sellest riigiasutust, esitades teates investeeringute kavasse mittearvamise põhjenduse. Investeeringute kavasse arvamata jätmise otsusest teavitatakse ettepaneku esitajat viivitamatult pärast investeeringute kava kinnitamist. Kui investeeringute kavasse ei arvata riigiasutuse projekti, teavitab rakendusasutus sellest riigiasutust, esitades teates investeeringute kavasse mittearvamise põhjenduse.",
      "rdfs:label": {
        "@value": "Reg_1028701_Par_17 (redaktsioon 1028701)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028701",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028701",
      "estleg:sourceAct": "Nutika teenuste taristu arendamise toetamise tingimused ja investeeringute kava koostamise kord",
      "estleg:provisionRef": "Reg_1028701 § 17",
