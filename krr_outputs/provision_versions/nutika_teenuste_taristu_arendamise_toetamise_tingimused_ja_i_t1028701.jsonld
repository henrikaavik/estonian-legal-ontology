      }
    },
    {
      "@id": "estleg:Reg_1028701_Par_9_v1028701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028701_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse maksimaalne osakaal projekti kohta on 100% abikõlblikest kuludest. Toetuse maksimaalne osakaal projekti kohta on 100% abikõlblikest kuludest. 2 (2) Taotletava toetuse piirmäär on 500 000 eurot projekti kohta. Taotletava toetuse piirmäär on 500 000 eurot projekti kohta. 3 (3) Projektile antava toetuse osakaal abikõlblikest kuludest ja toetuse suurim summa kinnitatakse investeeringute kavas ning sätestatakse taotluse rahuldamise otsuses. Projektile antava toetuse osakaal abikõlblikest kuludest ja toetuse suurim summa kinnitatakse investeeringute kavas ning sätestatakse taotluse rahuldamise otsuses.",
