        "@value": "2021-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse § 10 lõiget 2 rakendatakse alates 1. jaanuarist 2015. a. Määruse § 10 lõiget 2 rakendatakse alates 1. jaanuarist 2015. a.",
      "rdfs:label": {
        "@value": "Reg_1028701_Par_34 (redaktsioon 1028701)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028701",
