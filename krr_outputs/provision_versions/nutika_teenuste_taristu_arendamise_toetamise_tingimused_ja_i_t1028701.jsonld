    {
      "@id": "estleg:Reg_1028701_Par_15_v1028701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028701_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlusega esitatud projektide hindamiseks moodustab rakendusasutuse juht projektide valikukomisjoni. Vajadusel kaasatakse menetlusse eksperte. Taotlusega esitatud projektide hindamiseks moodustab rakendusasutuse juht projektide valikukomisjoni. Vajadusel kaasatakse menetlusse eksperte. 2 (2) Valikukomisjoni liikmed ja kaasatud eksperdid peavad vastama struktuuritoetuse seaduse § 21 lõikes 4 toodud nõuetele ning kinnitama oma erapooletust ja sõltumatust hinnatavatest projektidest ja taotlejatest. Valikukomisjoni koosseis avalikustatakse rakendusüksuse veebilehel. Valikukomisjoni liikmed ja kaasatud eksperdid peavad vastama struktuuritoetuse seaduse § 21 lõikes 4 toodud nõuetele ning kinnitama oma erapooletust ja sõltumatust hinnatavatest projektidest ja taotlejatest. Valikukomisjoni koosseis avalikustatakse rakendusüksuse veebilehel.",
      "rdfs:label": {
        "@value": "Reg_1028701_Par_15 (redaktsioon 1028701)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028701",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028701",
      "estleg:sourceAct": "Nutika teenuste taristu arendamise toetamise tingimused ja investeeringute kava koostamise kord",
      "estleg:provisionRef": "Reg_1028701 § 15",
