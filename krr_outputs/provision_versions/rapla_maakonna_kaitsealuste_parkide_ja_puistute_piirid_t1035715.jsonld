    {
      "@id": "estleg:Reg_1035715_Par_7_v1035715",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035715_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 3. juuni 2015. a käskkirjaga nr 528 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 3. juuni 2015. a käskkirjaga nr 528 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1035715_Par_7 (redaktsioon 1035715)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035715",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035715",
      "estleg:sourceAct": "Rapla maakonna kaitsealuste parkide ja puistute piirid",
      "estleg:provisionRef": "Reg_1035715 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035715_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035715_Par_8_v1035715",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035715_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1035715_Par_8 (redaktsioon 1035715)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035715",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035715",
      "estleg:sourceAct": "Rapla maakonna kaitsealuste parkide ja puistute piirid",
      "estleg:provisionRef": "Reg_1035715 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035715_Map_2026"
      }
