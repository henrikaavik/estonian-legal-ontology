      },
      "estleg:versionText": "Paragrahvides 1 ja 2 nimetatud parkide ja puistute kaitsekord ning kaitse-eesmärk on sätestatud Vabariigi Valitsuse 3. märtsi 2006. a määrusega nr 64 „Kaitsealuste parkide, arboreetumite ja puistute kaitse-eeskiri”. Paragrahvides 1 ja 2 nimetatud parkide ja puistute kaitsekord ning kaitse-eesmärk on sätestatud Vabariigi Valitsuse 3. märtsi 2006. a määrusega nr 64 „Kaitsealuste parkide, arboreetumite ja puistute kaitse-eeskiri”.",
      "rdfs:label": {
        "@value": "Reg_1035715_Par_3 (redaktsioon 1035715)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035715",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035715",
      "estleg:sourceAct": "Rapla maakonna kaitsealuste parkide ja puistute piirid",
      "estleg:provisionRef": "Reg_1035715 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035715_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035715_Par_4_v1035715",
      "@type": [
        "owl:NamedIndividual",
