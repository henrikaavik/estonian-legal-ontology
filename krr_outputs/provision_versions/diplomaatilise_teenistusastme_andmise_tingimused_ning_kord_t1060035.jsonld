      "estleg:provisionRef": "Reg_1060035 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060035_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060035_Par_5_v1060035",
