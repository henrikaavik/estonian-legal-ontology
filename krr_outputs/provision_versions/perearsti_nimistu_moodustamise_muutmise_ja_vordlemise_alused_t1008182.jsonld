    },
    {
      "@id": "estleg:Reg_1008182_Par_5_v1008182",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008182_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Perearst registreerib isiku nimistusse registreerimisavalduse esitamise päevast arvates. Perearst registreerib isiku nimistusse registreerimisavalduse esitamise päevast arvates. 2 (2) Perearsti vahetamisel arvestatakse tervishoiuteenuste korraldamise seaduse § 8 lõike 3 kohaselt isiku üleminekut uue perearsti nimistusse avalduse esitamisele järgneva kalendrikuu esimesest päevast. Perearsti vahetamisel arvestatakse tervishoiuteenuste korraldamise seaduse § 8 lõike 3 kohaselt isiku üleminekut uue perearsti nimistusse avalduse esitamisele järgneva kalendrikuu esimesest päevast.",
      "rdfs:label": {
        "@value": "Reg_1008182_Par_5 (redaktsioon 1008182)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008182",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008182",
      "estleg:sourceAct": "Perearsti nimistu moodustamise, muutmise ja võrdlemise alused ja kord ning perearsti nimistute piirarv",
      "estleg:provisionRef": "Reg_1008182 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008182_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1008182_Par_6_v1008182",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008182_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Perearst teavitab isikut nimistusse registreerimisest või registreerimisest keeldumisest ja keeldumise põhjustest registreerimisavalduses märgitud aadressil kirjalikult või elektrooniliselt seitsme tööpäeva jooksul registreerimisavalduse kättesaamisest. Perearst teavitab isikut nimistusse registreerimisest või registreerimisest keeldumisest ja keeldumise põhjustest registreerimisavalduses märgitud aadressil kirjalikult või elektrooniliselt seitsme tööpäeva jooksul registreerimisavalduse kättesaamisest.",
      "rdfs:label": {
        "@value": "Reg_1008182_Par_6 (redaktsioon 1008182)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008182",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008182",
      "estleg:sourceAct": "Perearsti nimistu moodustamise, muutmise ja võrdlemise alused ja kord ning perearsti nimistute piirarv",
      "estleg:provisionRef": "Reg_1008182 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008182_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1008182_Par_7_v1008182",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008182_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervishoiuteenuste korraldamise seaduse § 8 lõike 4 kohaselt määrab Tervisekassa isiku nimistusse nimistu piirsuurust arvestades Eesti rahvastikuregistrisse kantud isiku elukoha aadressi või välismaalase tegeliku elukoha aadressi alusel. RT I 2022-07-01 31 101072022031 2022-07-04 , rakendatakse tagasiulatuvalt 1.07.2022 Tervishoiuteenuste korraldamise seaduse § 8 lõike 4 kohaselt määrab Tervisekassa isiku nimistusse nimistu piirsuurust arvestades Eesti rahvastikuregistrisse kantud isiku elukoha aadressi või välismaalase tegeliku elukoha aadressi alusel. , rakendatakse tagasiulatuvalt 1.07.2022 2 (2) Isiku määramisel nimistusse lähtub Tervisekassa laste ja perekonna kaitse kaalutlustest. Isiku määramisel nimistusse lähtub Tervisekassa laste ja perekonna kaitse kaalutlustest. 3 (3) Isiku määramisel nimistusse võrdleb Tervisekassa nimistuid ja kinnitab muudetud nimistud tervishoiuteenuste korraldamise seaduse § 8 lõikes 43 sätestatud tähtaegadel ja korras. RT I 2022-07-01 31 101072022031 2022-07-04 , rakendatakse tagasiulatuvalt 1.07.2022 Isiku määramisel nimistusse võrdleb Tervisekassa nimistuid ja kinnitab muudetud nimistud tervishoiuteenuste korraldamise seaduse § 8 lõikes 43 sätestatud tähtaegadel ja korras. , rakendatakse tagasiulatuvalt 1.07.2022",
      "rdfs:label": {
        "@value": "Reg_1008182_Par_7 (redaktsioon 1008182)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008182",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008182",
      "estleg:sourceAct": "Perearsti nimistu moodustamise, muutmise ja võrdlemise alused ja kord ning perearsti nimistute piirarv",
      "estleg:provisionRef": "Reg_1008182 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008182_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1008182_Par_8_v1008182",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008182_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervishoiuteenuste korraldamise seaduse § 8 lõigete 43 ja 45 alusel määrab Tervisekassa: 1 1) nimistusse mitteregistreerunud isiku nimistusse; 2 2) nimistu piirsuurust ületavasse nimistusse kantud isiku või ilma perearsti või asendajata nimistusse kuuluva isiku teise perearsti nimistusse. RT I 2024-10-04 1 104102024001 2024-10-07 Tervishoiuteenuste korraldamise seaduse § 8 lõigete 43 ja 45 alusel määrab Tervisekassa: nimistusse mitteregistreerunud isiku nimistusse; nimistu piirsuurust ületavasse nimistusse kantud isiku või ilma perearsti või asendajata nimistusse kuuluva isiku teise perearsti nimistusse. 2 (2) Tervishoiuteenuste korraldamise seaduse § 35 lõike 2 alusel nimistu kinnitamisega määrab Tervisekassa: 1 1) vabanenud nimistule perearstiabi osutamise korraldamisel nimistusse kuulunud isikud nimistu moodustamise õiguse saanud perearsti nimistusse; RT I 2024-10-04 1 104102024001 2024-10-07 , rakendatakse tagasiulatuvalt alates 1. juulist 2024. a. 2 2) nimistu osa üleandmisel nimistusse registreerimiseks kirjaliku nõusoleku andnud isikud uude nimistusse. Tervishoiuteenuste korraldamise seaduse § 35 lõike 2 alusel nimistu kinnitamisega määrab Tervisekassa: vabanenud nimistule perearstiabi osutamise korraldamisel nimistusse kuulunud isikud nimistu moodustamise õiguse saanud perearsti nimistusse; , rakendatakse tagasiulatuvalt alates 1. juulist 2024. a. nimistu osa üleandmisel nimistusse registreerimiseks kirjaliku nõusoleku andnud isikud uude nimistusse. 3 (3) Tervishoiuteenuste korraldamise seaduse § 8 lõike 45 ja perearsti avalduse alusel võib Tervisekassa määrata nimistusse piirsuurusega 1200–2000 isikut kantud ravikindlustamata isiku teise perearsti nimistusse, kui perearsti nimistusse kuulub rohkem kui 800 ravikindlustamata isikut. RT I 2022-07-01 31 101072022031 2022-07-04 , rakendatakse tagasiulatuvalt 1.07.2022 Tervishoiuteenuste korraldamise seaduse § 8 lõike 45 ja perearsti avalduse alusel võib Tervisekassa määrata nimistusse piirsuurusega 1200–2000 isikut kantud ravikindlustamata isiku teise perearsti nimistusse, kui perearsti nimistusse kuulub rohkem kui 800 ravikindlustamata isikut. , rakendatakse tagasiulatuvalt 1.07.2022",
      "rdfs:label": {
        "@value": "Reg_1008182_Par_8 (redaktsioon 1008182)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008182",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008182",
      "estleg:sourceAct": "Perearsti nimistu moodustamise, muutmise ja võrdlemise alused ja kord ning perearsti nimistute piirarv",
      "estleg:provisionRef": "Reg_1008182 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008182_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1008182_Par_9_v1008182",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008182_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isiku määramist perearsti nimistusse arvestatakse: 1 1) määramisele järgneva kalendrikuu esimesest päevast käesoleva määruse § 8 lõigetes 1 ja 3 nimetatud juhul; 2 2) nimistu kinnitamisest käesoleva määruse § 8 lõikes 2 nimetatud juhul. Isiku määramist perearsti nimistusse arvestatakse: määramisele järgneva kalendrikuu esimesest päevast käesoleva määruse § 8 lõigetes 1 ja 3 nimetatud juhul; nimistu kinnitamisest käesoleva määruse § 8 lõikes 2 nimetatud juhul.",
      "rdfs:label": {
        "@value": "Reg_1008182_Par_9 (redaktsioon 1008182)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008182",
