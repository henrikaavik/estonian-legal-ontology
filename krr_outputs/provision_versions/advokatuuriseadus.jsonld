        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AdvS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AdvS_Par_57 (redaktsioon 13314570)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314570"
    },
    {
      "@id": "estleg:AdvS_Par_57_1_v921782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AdvS_Par_57_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigusteenuse osutamise käigus kliendi esindamisel või kaitsmisel kolmandate isikute ees piisab advokaadi kinnitusest, et ta on kliendi esindaja või kaitsja ning vastava volituse olemasolu eeldatakse (volituse eeldus). Volituse eeldus ei kehti juhul, kui seadus näeb vastava toimingu tegemiseks ette notariaalse volikirja nõude.",
      "rdfs:label": {
        "@value": "AdvS_Par_57_1 (redaktsioon 921782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "921782",
      "estleg:supersededByVersion": {
        "@id": "estleg:AdvS_Par_57_1_v12895586"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-27",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AdvS_Par_57_1_v12895586",
      "@type": [
