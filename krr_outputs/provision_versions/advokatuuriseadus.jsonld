    },
    {
      "@id": "estleg:AdvS_Par_42_v22478",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AdvS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vandeadvokaadi abil ja vandeadvokaadi vanemabil on vandeadvokaadi õiguspädevus seadusega piiratud ulatuses. (2) Vandeadvokaadi vanemabi ja vandeadvokaadi abi ei ole pädevad täitma käesoleva seaduse § 41 punktis 6 nimetatud ülesandeid ja esindama või kaitsma klienti Riigikohtus. Vandeadvokaadi abi ei ole pädev täitma § 41 punktis 7 nimetatud ülesandeid. (3) Vandeadvokaadi abi võib õigusteenust osutada üksnes vandeadvokaadist patrooni juhendamisel.",
      "rdfs:label": {
        "@value": "AdvS_Par_42 (redaktsioon 22478)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22478",
      "estleg:supersededByVersion": {
