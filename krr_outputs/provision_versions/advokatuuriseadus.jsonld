    {
      "@id": "estleg:AdvS_Par_9_v104032016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AdvS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Üldkogu: määrab juhatuse ning revisjonikomisjoni liikmete ja asendusliikmete arvu ning aukohtu advokaatidest asendusliikmete arvu; valib esimehe, juhatuse ning revisjonikomisjoni liikmed ja asendusliikmed ning aukohtu advokaatidest liikmed ja asendusliikmed; kinnitab advokatuuri eelmise majandusaasta eelarve täitmise aruande ja uue majandusaasta eelarve; kinnitab advokatuuri majandusaasta aruande ja revisjonikomisjoni aastaaruande; võtab vastu advokatuuri kodukorra ja advokaadi kutse-eetika nõuded; lahendab advokatuuri juhatuse otsuste ja esimehe toimingute peale esitatud kaebusi, kui seda nõuab vähemalt üks kümnendik advokatuuri liikmetest; kinnitab advokatuuri sümboolika; otsustab advokaatidele tasu määramise alused advokatuuri huvides tehtud töö eest; kehtestab advokatuuri liikmemaksu maksmise tingimused ja korra ning liikmemaksu suuruse, samuti muude tasude maksmise ja kulude hüvitamise tingimused ja korra ning tasu suuruse; kehtetu - otsustab muid seaduses ja kodukorras sätestatud küsimusi.",
      "rdfs:label": {
        "@value": "AdvS_Par_9 (redaktsioon 104032016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104032016002",
