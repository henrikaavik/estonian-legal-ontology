      ],
      "estleg:versionOf": {
        "@id": "estleg:AdvS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
