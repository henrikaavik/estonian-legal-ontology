    {
      "@id": "estleg:AdvS_Par_18_v13260196",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AdvS_Par_18"
      },
      "estleg:versionValidFrom": {
