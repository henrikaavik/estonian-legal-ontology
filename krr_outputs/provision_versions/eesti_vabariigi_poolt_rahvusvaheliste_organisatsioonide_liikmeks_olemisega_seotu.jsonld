  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_eesti_vabariigi_poolt_rahvusvaheliste_organisatsioonide_liikmeks_olemisega_seotu_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti Vabariigi poolt rahvusvaheliste organisatsioonide liikmeks olemisega seotud varaliste kohustuste võtmise ja täitmise seadus (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti Vabariigi poolt rahvusvaheliste organisatsioonide liikmeks olemisega seotud varaliste kohustuste võtmise ja täitmise seadus"
    },
    {
      "@id": "estleg:ROLVKS_Par_1_v162908",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ROLVKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses sätestatakse Eesti Vabariigi poolt Rahvusvahelise Rekonstrueerimis- ja Arengupangaga ja Rahvusvahelise Valuutafondiga ning nende juurde kuuluvate organisatsioonidega ning Euroopa Nõukogu Arengupangaga (kõik edaspidi rahvusvaheline organisatsioon) ühinemisel võetud kohustuste täitmisega seotud täiendavate varaliste kohustuste, nagu võlakirja emiteerimine ja tagasiostmine, võtmise ja täitmise alused ja kord.",
      "rdfs:label": {
        "@value": "ROLVKS_Par_1 (redaktsioon 162908)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162908",
      "estleg:supersededByVersion": {
        "@id": "estleg:ROLVKS_Par_1_v123122011012"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ROLVKS_Par_1_v123122011012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ROLVKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses sätestatakse Eesti Vabariigi poolt Rahvusvahelise Rekonstrueerimis- ja Arengupangaga ja selle juurde kuuluvate organisatsioonidega ning Euroopa Nõukogu Arengupangaga (kõik edaspidi rahvusvaheline organisatsioon) ühinemisel võetud kohustuste täitmisega seotud täiendavate varaliste kohustuste, nagu võlakirja emiteerimine ja tagasiostmine, võtmise ja täitmise alused ja kord.",
      "rdfs:label": {
        "@value": "ROLVKS_Par_1 (redaktsioon 123122011012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122011012"
    },
    {
      "@id": "estleg:ROLVKS_Par_2_v162908",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ROLVKS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osaluse eest rahvusvahelises organisatsioonis tasub Eesti Vabariik kas rahas või võlakirja emiteerimise teel. (2) Kui valuuta, milles Eesti Vabariik on teinud makse või emiteerinud võlakirja, nõrgeneb valuuta suhtes, milles rahvusvaheline organisatsioon peab Eesti Vabariigi osaluse üle arvestust, tuleb osaluse suuruse säilitamiseks teostada juurdemakse vastavalt rahvusvahelise organisatsiooni poolt esitatud nõudele vajaliku summa tasumisega rahvusvahelise organisatsiooni kontole või võlakirja emiteerimisega.",
      "rdfs:label": {
        "@value": "ROLVKS_Par_2 (redaktsioon 162908)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162908"
    },
    {
      "@id": "estleg:ROLVKS_Par_3_v162908",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ROLVKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi poolt käesoleva seaduse §-s 2 nimetatud võlakirja emiteerimise otsuse teeb Vabariigi Valitsus. (2) Võlakiri emiteeritakse järgmistel tingimustel: võlakirja nimiväärtus võrdub summaga, mille ulatuses rahvusvaheline organisatsioon esitab Eesti Vabariigile tasumise nõude; võlakiri on intressita; võlakirja võõrandamine ei ole lubatud; võlakirja tagasiostmine toimub rahvusvahelise organisatsiooni esimesel nõudmisel. (3) Võlakirja emiteerimisega seotud toiminguid korraldab rahandusminister.",
      "rdfs:label": {
        "@value": "ROLVKS_Par_3 (redaktsioon 162908)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162908",
      "estleg:supersededByVersion": {
        "@id": "estleg:ROLVKS_Par_3_v123122011012"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ROLVKS_Par_3_v123122011012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ROLVKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi poolt käesoleva seaduse §-s 2 nimetatud võlakirja emiteerimise otsuse teeb Vabariigi Valitsus. (2) Võlakiri emiteeritakse järgmistel tingimustel: võlakirja nimiväärtus võrdub summaga, mille ulatuses rahvusvaheline organisatsioon esitab Eesti Vabariigile tasumise nõude; võlakiri on intressita; võlakirja võõrandamine ei ole lubatud; võlakirja tagasiostmine toimub rahvusvahelise organisatsiooni esimesel nõudmisel. (3) Võlakirja emiteerimisega seotud toiminguid korraldab valdkonna eest vastutav minister. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „rahandusminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "ROLVKS_Par_3 (redaktsioon 123122011012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122011012"
    },
    {
      "@id": "estleg:ROLVKS_Par_4_v162908",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ROLVKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi poolt rahvusvahelisele organisatsioonile emiteeritud võlakirja tagasiostmine toimub rahvusvahelise organisatsiooni poolt esitatud ajakava või nõudekirja alusel. (2) Võlakirja tagasiostmise korraldab Vabariigi Valitsus. (3) Vabariigi Valitsusel on õigus Riigikogu nõusolekuta võtta võlakirja tagasiostmiseks lühiajalist laenu kuni 5 protsendi ulatuses Riigikogu poolt jooksvaks eelarveaastaks kinnitatud riigieelarve tuludest.",
      "rdfs:label": {
        "@value": "ROLVKS_Par_4 (redaktsioon 162908)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162908"
    },
    {
      "@id": "estleg:ROLVKS_Par_5_v162908",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ROLVKS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tunnistatakse kehtetuks Eesti Vabariigi Ülemnõukogu 1992. aasta 22. aprilli otsuse «Nõusoleku andmise kohta Eesti Vabariigi astumiseks Rahvusvahelise Valuutafondi, Rahvusvahelise Rekonstrueerimis- ja Arengupanga ning nende juurde kuuluvate organisatsioonide liikmeks» (RT 1992, 18, 258) punktid 5 ja 8.",
      "rdfs:label": {
        "@value": "ROLVKS_Par_5 (redaktsioon 162908)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162908",
      "estleg:supersededByVersion": {
        "@id": "estleg:ROLVKS_Par_5_v123122011012"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ROLVKS_Par_5_v123122011012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ROLVKS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "ROLVKS_Par_5 (redaktsioon 123122011012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122011012"
    }
  ]
}
