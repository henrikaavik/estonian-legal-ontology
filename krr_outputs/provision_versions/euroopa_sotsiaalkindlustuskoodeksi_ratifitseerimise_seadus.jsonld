      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Euroopa sotsiaalkindlustuskoodeksi ratifitseerimise seadus (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Euroopa sotsiaalkindlustuskoodeksi ratifitseerimise seadus"
    },
    {
      "@id": "estleg:euroopa_sotsiaalkindlustuskoodeksi_ratif_Par_1_v724858",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:euroopa_sotsiaalkindlustuskoodeksi_ratif_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud mis on koostatud 1964. aasta 16. aprillil Strasbourg’is ja millele Eesti Vabariik on alla kirjutanud 2000. aasta 24. jaanuaril.",
      "rdfs:label": {
        "@value": "euroopa_sotsiaalkindlustuskoodeksi_ratif_Par_1 (redaktsioon 724858)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "724858"
    },
    {
      "@id": "estleg:euroopa_sotsiaalkindlustuskoodeksi_ratif_Par_2_v724858",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:euroopa_sotsiaalkindlustuskoodeksi_ratif_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerimisel teha järgmised deklaratsioonid: (1) Koodeksi artikli 2 lõike 1 punkti b ja artikli 3 alusel tunnistab Eesti Vabariik end seotuks järgmiste koodeksi osadega: II osa. Arstiabi; III osa. Haigushüvitis; IV osa. Töötushüvitis; V osa. Vanadushüvitis; VII osa. Perehüvitis; VIII osa. Emadushüvitis; IX osa. Invaliidsushüvitis; X osa. Toitjakaotushüvitis. (2) Koodeksi artikli 3 alusel tunnistab Eesti Vabariik, et ta ei kohalda enda suhtes koodeksi artikli 2 lõike 2 sätteid.",
      "rdfs:label": {
        "@value": "euroopa_sotsiaalkindlustuskoodeksi_ratif_Par_2 (redaktsioon 724858)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "724858"
    },
    {
      "@id": "estleg:euroopa_sotsiaalkindlustuskoodeksi_ratif_Par_3_v724858",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:euroopa_sotsiaalkindlustuskoodeksi_ratif_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koodeksi artiklites 74 ja 76 nimetatud aruanded esitab Euroopa Nõukogu peasekretärile Sotsiaalministeerium.",
      "rdfs:label": {
        "@value": "euroopa_sotsiaalkindlustuskoodeksi_ratif_Par_3 (redaktsioon 724858)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "724858"
    }
  ]
