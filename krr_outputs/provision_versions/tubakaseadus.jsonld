        "@value": "tubakaseadus_Par_2 (redaktsioon 129062014085)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014085"
    },
    {
      "@id": "estleg:tubakaseadus_Par_20_v22467",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse nõuetest kinnipidamise üle teostavad järelevalvet: suitsetamise piirangutest ja suitsetamisruumile ning -alale kehtestatud nõuetest kinnipidamise üle - politseiametnikud (välja arvatud kaitsepolitseiametnikud), tervishoiuametnikud ja tööinspektsiooni ametnikud; turujärelevalve osas - tarbijakaitseametnikud, politseiametnikud (välja arvatud kaitsepolitseiametnikud), maksuametnikud ja kohaliku omavalitsuse volikogu poolt volitatud ametnikud; tubakatoote sisseveol müügipakendi käesoleva seaduse §-des 3-5 sätestatud nõuetele vastavuse osas - tolliametnikud.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_20 (redaktsioon 22467)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22467",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_20_v693676"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_20_v693676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse nõuetest kinnipidamise üle teostavad järelevalvet: suitsetamise piirangutest ja suitsetamisruumile ning -alale kehtestatud nõuetest kinnipidamise üle - politseiametnikud (välja arvatud kaitsepolitseiametnikud), tervishoiuametnikud ja tööinspektsiooni ametnikud; turujärelevalve osas - tarbijakaitseametnikud, politseiametnikud (välja arvatud kaitsepolitseiametnikud), Maksu- ja Tolliameti ametnikud ja kohaliku omavalitsuse volikogu poolt volitatud ametnikud; tubakatoote sisseveol müügipakendi käesoleva seaduse §-des 3-5 sätestatud nõuetele vastavuse osas - Maksu- ja Tolliameti ametnikud.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_20 (redaktsioon 693676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693676",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_20_v903024"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-04",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_20_v903024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tubakatoote hulgimüügil arveldatakse sularahata arvelduse korras.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_20 (redaktsioon 903024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "903024",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_20_v109012018003"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_20_v109012018003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tubakatoote ja tubakatootega seonduva toote hulgimüügil arveldatakse sularahata arvelduse korras.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_20 (redaktsioon 109012018003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109012018003"
    },
    {
      "@id": "estleg:tubakaseadus_Par_21_v22467",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet teostaval ametiisikul on õigus: kontrollida käesoleva seaduse nõuetest kinnipidamist takistamatult ja ette teatamata; siseneda tubakatoote käitleja territooriumile, hoonesse, rajatisse, ruumi või avada tema veovahendeid; nõuda tubakatoote käitlemist puudutavate dokumentide kohest esitamist, neid kohapeal kontrollida, saada dokumendi ärakirja või väljavõtet, võtta võetuse protokolliga ära asja õigeks lahendamiseks tähtsust omavaid dokumente; võtta laboriuuringuteks tubakatootest tasuta proove; käesoleva seaduse rikkumise korral plommida või pitseerida tubakatoote hoiukoht või veo vahend või teostada tubakatoote võetus; menetleda käesoleva seaduse eiramisega seotud kriminaalasju või haldusõiguserikkumise asju eriseadustega sätestatud korras; teha ettepanek tubakatoote käitlemise õigust andva dokumendi kehtetuks tunnistamiseks.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_21 (redaktsioon 22467)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22467",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_21_v193270"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_21_v193270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet teostaval ametiisikul on õigus: kontrollida käesoleva seaduse nõuetest kinnipidamist takistamatult ja ette teatamata; siseneda tubakatoote käitleja territooriumile, hoonesse, rajatisse, ruumi või avada tema veovahendeid; nõuda tubakatoote käitlemist puudutavate dokumentide kohest esitamist, neid kohapeal kontrollida, saada dokumendi ärakirja või väljavõtet, võtta võetuse protokolliga ära asja õigeks lahendamiseks tähtsust omavaid dokumente; võtta laboriuuringuteks tubakatootest tasuta proove; käesoleva seaduse rikkumise korral plommida või pitseerida tubakatoote hoiukoht või veo vahend või teostada tubakatoote võetus; menetleda käesoleva seaduse eiramisega seotud kriminaalasju või väärteoasju seadusega sätestatud korras; teha ettepanek tubakatoote käitlemise õigust andva dokumendi kehtetuks tunnistamiseks.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_21 (redaktsioon 193270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193270",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_21_v728954"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_21_v728954",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet teostaval ametiisikul on õigus: kontrollida käesoleva seaduse nõuetest kinnipidamist takistamatult ja ette teatamata; siseneda tubakatoote käitleja territooriumile, hoonesse, rajatisse, ruumi või avada tema veovahendeid; nõuda tubakatoote käitlemist puudutavate dokumentide kohest esitamist, neid kohapeal kontrollida, saada dokumendi ärakirja või väljavõtet, võtta võetuse protokolliga ära asja õigeks lahendamiseks tähtsust omavaid dokumente; võtta laboriuuringuteks tubakatootest tasuta proove; käesoleva seaduse rikkumise korral plommida või pitseerida tubakatoote hoiukoht või veo vahend või teostada tubakatoote võetus; menetleda käesoleva seaduse eiramisega seotud kriminaalasju või väärteoasju seadusega sätestatud korras; teha ettepanek tubakatoote käitlemise õigust andva dokumendi kehtetuks tunnistamiseks või majandustegevuse registris jaemüügi kohta tehtud registreeringus sisalduva märke kustutamiseks.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_21 (redaktsioon 728954)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "728954",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_21_v903024"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-04",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_21_v903024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tubakatoote kohta vormistatud saatedokumendil, sealhulgas ettevõttesisesel saatedokumendil, peab olema märgitud: selle tubakatoote tootjapartii tähistus; sigarettide puhul maksimaalne jaehind.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_21 (redaktsioon 903024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "903024",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_21_v119052020013"
      },
      "estleg:versionValidTo": {
        "@value": "2020-05-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_21_v119052020013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tubakatoote kohta vormistatud saatedokumendil, sealhulgas ettevõttesisesel saatedokumendil, peab olema märgitud: selle tubakatoote tootjapartii tähistus või kordumatu tunnuse inimloetav kood; sigarettide puhul maksimaalne jaehind.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_21 (redaktsioon 119052020013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119052020013",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_21_v107032023020"
      },
      "estleg:versionValidTo": {
        "@value": "2024-05-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_21_v107032023020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tubakatoote kohta vormistatud saatedokumendil, sealhulgas ettevõttesisesel saatedokumendil, peab olema märgitud: selle tubakatoote kordumatu tunnuse inimloetav kood; sigarettide puhul maksimaalne jaehind.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_21 (redaktsioon 107032023020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032023020"
    },
    {
      "@id": "estleg:tubakaseadus_Par_22_v22467",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse nõuete rikkumise eest kannab füüsiline isik distsiplinaar-, tsiviil-, haldus- või kriminaalvastutust seadusega ettenähtud korras. (2) Füüsilisele isikule käesoleva seaduse nõuete rikkumise eest kohaldatav kriminaal- või haldusvastutus ei välista haldusvastutuse kohaldamist asjakohasele juriidilisele isikule.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_22 (redaktsioon 22467)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22467",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_22_v903024"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-04",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_22_v903024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tubakatoote jaemüük on keelatud müügikohas, mis paikneb järgmiste asutuste ruumides või nende piiratud maa-alal: laste hoolekandeasutus; koolieelne lasteasutus, lasteaed-algkool, algkool, põhikool, gümnaasium, kutseõppeasutus, huvialakool, avatud noortekeskus või noorte- ja projektlaager; haigla. (2) Tubakatoote jaemüük on keelatud: kandekaubanduses; müügiautomaadist; tänava- ja turukaubanduses kaubandustegevuse seaduse § 17 tähenduses; apteegis; aktsiisilaos. (3) Tubakatootega tükikaupa või avatud müügipakendist või lahtiselt kaalu järgi kauplemine on keelatud, välja arvatud: sigari jaemüügil avatud müügipakendist tingimusel, et sigarid on pakendatud ühekaupa ja iga sigar on eraldi maksumärgistatud; sigari jaemüügil toitlustusettevõttes avatud müügipakendist tingimusel, et sigar on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas; vesipiibutubaka jaemüügil toitlustusettevõttes või avaliku ürituse müügikohas kohapeal tarbimiseks tingimusel, et vesipiibutubakas on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas. (4) Keelatud on kaubelda tubakatootega ja muu tootega, mis asuvad ühtses pakendis. (5) Sigarettide jaemüügil on keelatud rakendada võtteid, mille eesmärgipärane või võimalik tulem on sigarettide maksimaalse jaehinna ületamine. (6) Müüjal on keelatud anda kasutusse vesipiibu suulist, mida on juba tarvitatud.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_22 (redaktsioon 903024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "903024",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_22_v12778255"
      },
      "estleg:versionValidTo": {
        "@value": "2007-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_22_v12778255",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tubakatoote jaemüük on keelatud müügikohas, mis paikneb järgmiste asutuste ruumides või nende piiratud maa-alal: laste hoolekandeasutus; koolieelne lasteasutus, lasteaed-algkool, algkool, põhikool, gümnaasium, kutseõppeasutus, huvikool, avatud noortekeskus või noorte- ja projektlaager; haigla. (2) Tubakatoote jaemüük on keelatud: kandekaubanduses; müügiautomaadist; tänava- ja turukaubanduses kaubandustegevuse seaduse § 17 tähenduses; apteegis; aktsiisilaos. (3) Tubakatootega tükikaupa või avatud müügipakendist või lahtiselt kaalu järgi kauplemine on keelatud, välja arvatud: sigari jaemüügil avatud müügipakendist tingimusel, et sigarid on pakendatud ühekaupa ja iga sigar on eraldi maksumärgistatud; sigari jaemüügil toitlustusettevõttes avatud müügipakendist tingimusel, et sigar on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas; vesipiibutubaka jaemüügil toitlustusettevõttes või avaliku ürituse müügikohas kohapeal tarbimiseks tingimusel, et vesipiibutubakas on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas. (4) Keelatud on kaubelda tubakatootega ja muu tootega, mis asuvad ühtses pakendis. (5) Sigarettide jaemüügil on keelatud rakendada võtteid, mille eesmärgipärane või võimalik tulem on sigarettide maksimaalse jaehinna ületamine. (6) Müüjal on keelatud anda kasutusse vesipiibu suulist, mida on juba tarvitatud.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_22 (redaktsioon 12778255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12778255",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_22_v13340623"
      },
      "estleg:versionValidTo": {
        "@value": "2010-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_22_v13340623",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tubakatoote jaemüük on keelatud müügikohas, mis paikneb järgmiste asutuste ruumides või nende piiratud maa-alal: laste hoolekandeasutus; koolieelne lasteasutus, põhikool, gümnaasium, kutseõppeasutus, huvikool, avatud noortekeskus või noorte püsilaager ja noorte projektlaager; haigla. (2) Tubakatoote jaemüük on keelatud: kandekaubanduses; müügiautomaadist; tänava- ja turukaubanduses kaubandustegevuse seaduse § 17 tähenduses; apteegis; aktsiisilaos. (3) Tubakatootega tükikaupa või avatud müügipakendist või lahtiselt kaalu järgi kauplemine on keelatud, välja arvatud: sigari jaemüügil avatud müügipakendist tingimusel, et sigarid on pakendatud ühekaupa ja iga sigar on eraldi maksumärgistatud; sigari jaemüügil toitlustusettevõttes avatud müügipakendist tingimusel, et sigar on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas; vesipiibutubaka jaemüügil toitlustusettevõttes või avaliku ürituse müügikohas kohapeal tarbimiseks tingimusel, et vesipiibutubakas on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas. (4) Keelatud on kaubelda tubakatootega ja muu tootega, mis asuvad ühtses pakendis. (5) Sigarettide jaemüügil on keelatud rakendada võtteid, mille eesmärgipärane või võimalik tulem on sigarettide maksimaalse jaehinna ületamine. (6) Müüjal on keelatud anda kasutusse vesipiibu suulist, mida on juba tarvitatud.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_22 (redaktsioon 13340623)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13340623",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_22_v128062016005"
      },
      "estleg:versionValidTo": {
        "@value": "2016-07-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_22_v128062016005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tubakatoote ja tubakatootega seonduva toote jaemüük on keelatud müügikohas, mis paikneb järgmiste asutuste ruumides või nende piiratud maa-alal: laste hoolekandeasutus; koolieelne lasteasutus, põhikool, gümnaasium, kutseõppeasutus, huvikool, avatud noortekeskus või noorte püsilaager ja noorte projektlaager; haigla. (2) Tubakatoote ja tubakatootega seonduva toote jaemüük on keelatud: kandekaubanduses; müügiautomaadist; tänava- ja turukaubanduses kaubandustegevuse seaduse § 17 tähenduses; apteegis; aktsiisilaos; piiriülesel kaugmüügil. (3) Tubakatootega tükikaupa või avatud müügipakendist või lahtiselt kaalu järgi kauplemine on keelatud, välja arvatud: sigari jaemüügil avatud müügipakendist tingimusel, et sigarid on pakendatud ühekaupa ja iga sigar on eraldi maksumärgistatud; sigari jaemüügil toitlustusettevõttes avatud müügipakendist tingimusel, et sigar on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas; vesipiibutubaka jaemüügil toitlustusettevõttes või avaliku ürituse müügikohas kohapeal tarbimiseks tingimusel, et vesipiibutubakas on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas. (4) Keelatud on kaubelda tubakatootega ja muu tootega, mis asuvad ühtses pakendis. (5) Sigarettide jaemüügil on keelatud rakendada võtteid, mille eesmärgipärane või võimalik tulem on sigarettide maksimaalse jaehinna ületamine. (6) Müüjal on keelatud anda kasutusse vesipiibu suulist, mida on juba tarvitatud.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_22 (redaktsioon 128062016005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016005",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_22_v116062017033"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_22_v116062017033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tubakatoote ja tubakatootega seonduva toote jaemüük on keelatud müügikohas, mis paikneb järgmiste asutuste ruumides või nende piiratud maa-alal: laste hoolekandeasutus; koolieelne lasteasutus, põhikool, gümnaasium, kutseõppeasutus, huvikool, avatud noortekeskus või noorte püsilaager ja noorte projektlaager; haigla. (2) Tubakatoote ja tubakatootega seonduva toote jaemüük on keelatud: kandekaubanduses; müügiautomaadist; tänava- ja turukaubanduses kaubandustegevuse seaduse § 17 tähenduses; apteegis; aktsiisilaos; piiriülesel kaugmüügil. (3) Tubakatootega ning alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduse tähenduses alternatiivse tubakatootega kauplemine tükikaupa, avatud müügipakendist või lahtiselt kaalu järgi on keelatud, välja arvatud: sigari jaemüügil avatud müügipakendist tingimusel, et sigarid on pakendatud ühekaupa ja iga sigar on eraldi maksumärgistatud; sigari jaemüügil toitlustusettevõttes avatud müügipakendist tingimusel, et sigar on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas; vesipiibutubaka jaemüügil toitlustusettevõttes või avaliku ürituse müügikohas kohapeal tarbimiseks tingimusel, et vesipiibutubakas on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas. (4) Keelatud on kaubelda tubakatootega ja muu tootega, mis asuvad ühtses pakendis. (5) Sigarettide, sigarite ja sigarillode jaemüügil on keelatud rakendada võtteid, mille eesmärgipärane või võimalik tulem on sigarettide, sigarite või sigarillode maksimaalse jaehinna ületamine. (6) Müüjal on keelatud anda kasutusse vesipiibu suulist, mida on juba tarvitatud.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_22 (redaktsioon 116062017033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062017033",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_22_v112122018070"
      },
      "estleg:versionValidTo": {
        "@value": "2019-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_22_v112122018070",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tubakatoote ja tubakatootega seonduva toote jaemüük on keelatud müügikohas, mis paikneb järgmiste asutuste ruumides või nende piiratud maa-alal: laste hoolekandeasutus; koolieelne lasteasutus, põhikool, gümnaasium, kutseõppeasutus, huvikool, avatud noortekeskus või noorte püsilaager ja noorte projektlaager; haigla. (2) Tubakatoote ja tubakatootega seonduva toote jaemüük on keelatud: kandekaubanduses; müügiautomaadist; tänava- ja turukaubanduses kaubandustegevuse seaduse § 17 tähenduses; apteegis; aktsiisilaos; piiriülesel kaugmüügil; riigisisesel kaugmüügil. (3) Tubakatootega ning alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduse tähenduses alternatiivse tubakatootega kauplemine tükikaupa, avatud müügipakendist või lahtiselt kaalu järgi on keelatud, välja arvatud: sigari jaemüügil avatud müügipakendist tingimusel, et sigarid on pakendatud ühekaupa ja iga sigar on eraldi maksumärgistatud; sigari jaemüügil toitlustusettevõttes avatud müügipakendist tingimusel, et sigar on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas; vesipiibutubaka jaemüügil toitlustusettevõttes või avaliku ürituse müügikohas kohapeal tarbimiseks tingimusel, et vesipiibutubakas on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas. (3¹) Tubakatoote või tubakatootega seonduva toote jaekaubanduse müügikohas kõnealuse toote nähtav väljapanek ja selle kaubamärgi esitlemine on keelatud, välja arvatud: tubakatoote või tubakatootega seonduva toote müügile spetsialiseerunud jaekaubanduse müügikohas tingimusel, et müüdavad tooted ja nende tähistamiseks kasutatavad kaubamärgid ei ole nähtavad väljaspool müügikohta; rahvusvahelisel liinil sõitval laeval; reisisadama ja lennujaama kinnisel territooriumil tegutsevas jaekaubanduse müügikohas; tubakatoote või tubakatootega seonduva toote jaekaubanduse müügikohas antav kaubanduslik teave kaubandustegevuse seaduse § 10 tähenduses sõnalisel kujul tubakatoote või tubakatootega seonduva toote nime ja kaubamärgi ning hinna kohta. (4) Keelatud on müügiks pakkuda ja müüa tubakatoodet ning tubakatootega seonduvat toodet, mis on muu tootega ühtsesse müügipakendisse pakendatud. (5) Sigarettide, sigarite ja sigarillode jaemüügil on keelatud rakendada võtteid, mille eesmärgipärane või võimalik tulem on sigarettide, sigarite või sigarillode maksimaalse jaehinna ületamine. (6) Müüjal on keelatud anda kasutusse vesipiibu suulist, mida on juba tarvitatud.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_22 (redaktsioon 112122018070)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112122018070",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_22_v104012021016"
      },
      "estleg:versionValidTo": {
        "@value": "2021-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_22_v104012021016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tubakatoote ja tubakatootega seonduva toote jaemüük on keelatud müügikohas, mis paikneb järgmiste asutuste ruumides või nende piiratud maa-alal: laste hoolekandeasutus; koolieelne lasteasutus, põhikool, gümnaasium, kutseõppeasutus, huvikool, avatud noortekeskus või noorte püsilaager ja noorte projektlaager; haigla. (2) Tubakatoote ja tubakatootega seonduva toote jaemüük on keelatud: kandekaubanduses; müügiautomaadist; müügisaalita müügikohas, välja arvatud müügikohtadest moodustuval marsruudil liikuvas kauba jaemüügiks kohandatud sõidukis ja kioskis, mis on kaupleja müügisaalita tegevuskoht eraldiseisva ehitisena või ehitise osana; apteegis; aktsiisilaos; piiriülesel kaugmüügil; riigisisesel kaugmüügil. (3) Tubakatootega ning alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduse tähenduses alternatiivse tubakatootega kauplemine tükikaupa, avatud müügipakendist või lahtiselt kaalu järgi on keelatud, välja arvatud: sigari jaemüügil avatud müügipakendist tingimusel, et sigarid on pakendatud ühekaupa ja iga sigar on eraldi maksumärgistatud; sigari jaemüügil toitlustusettevõttes avatud müügipakendist tingimusel, et sigar on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas; vesipiibutubaka jaemüügil toitlustusettevõttes või avaliku ürituse müügikohas kohapeal tarbimiseks tingimusel, et vesipiibutubakas on pärit nõuetekohasest müügipakendist ja see pakend asub müügikohas. (3¹) Tubakatoote või tubakatootega seonduva toote jaekaubanduse müügikohas kõnealuse toote nähtav väljapanek ja selle kaubamärgi esitlemine on keelatud, välja arvatud: tubakatoote või tubakatootega seonduva toote müügile spetsialiseerunud jaekaubanduse müügikohas tingimusel, et müüdavad tooted ja nende tähistamiseks kasutatavad kaubamärgid ei ole nähtavad väljaspool müügikohta; rahvusvahelisel liinil sõitval laeval; reisisadama ja lennujaama kinnisel territooriumil tegutsevas jaekaubanduse müügikohas; tubakatoote või tubakatootega seonduva toote nimi ja kaubamärk ning hind sõnalisel kujul. (4) Keelatud on müügiks pakkuda ja müüa tubakatoodet ning tubakatootega seonduvat toodet, mis on muu tootega ühtsesse müügipakendisse pakendatud. (5) Sigarettide, sigarite ja sigarillode jaemüügil on keelatud rakendada võtteid, mille eesmärgipärane või võimalik tulem on sigarettide, sigarite või sigarillode maksimaalse jaehinna ületamine. (6) Müüjal on keelatud anda kasutusse vesipiibu suulist, mida on juba tarvitatud.",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_22 (redaktsioon 104012021016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104012021016",
      "estleg:supersededByVersion": {
        "@id": "estleg:tubakaseadus_Par_22_v107032023019"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_22_v107032023019",
      "@type": [
        "owl:NamedIndividual",
