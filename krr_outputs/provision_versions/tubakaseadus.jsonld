      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tubakas on taim, mis kuulub perekonda Nicotiana .",
      "rdfs:label": {
        "@value": "tubakaseadus_Par_2 (redaktsioon 903024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "903024",
