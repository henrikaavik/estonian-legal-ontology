      }
    },
    {
      "@id": "estleg:tubakaseadus_Par_2_v129062014085",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tubakaseadus_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tubakas on taim, mis kuulub perekonda Nicotiana.",
