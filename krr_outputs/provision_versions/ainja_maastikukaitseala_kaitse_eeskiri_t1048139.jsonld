      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048139",
      "estleg:sourceAct": "Ainja maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1048139 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048139_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048139_Par_10_v1048139",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048139_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ainja mägede sihtkaitsevööndi kaitse-eesmärk on Ainja mägede pinnavormide ja maastikuilme säilitamine ja tutvustamine, sealsete metsakoosluste loodusliku seisundi taastamine ja säilitamine, neile omase liigi- ja vanusestruktuuri hoidmine ning looduse mitmekesisuse kaitse. Ainja mägede sihtkaitsevööndi kaitse-eesmärk on Ainja mägede pinnavormide ja maastikuilme säilitamine ja tutvustamine, sealsete metsakoosluste loodusliku seisundi taastamine ja säilitamine, neile omase liigi- ja vanusestruktuuri hoidmine ning looduse mitmekesisuse kaitse.",
      "rdfs:label": {
        "@value": "Reg_1048139_Par_10 (redaktsioon 1048139)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048139",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048139",
