      "estleg:provisionRef": "Reg_1048139 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048139_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048139_Par_2_v1048139",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
