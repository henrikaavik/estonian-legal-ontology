      "estleg:provisionRef": "Reg_1048139 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048139_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048139_Par_11_v1048139",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
