    {
      "@id": "estleg:Reg_1048139_Par_14_v1048139",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048139_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse ja maastikuilme säilitamine ning Ainja järve ja Sinejärve kaitse. Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse ja maastikuilme säilitamine ning Ainja järve ja Sinejärve kaitse.",
      "rdfs:label": {
        "@value": "Reg_1048139_Par_14 (redaktsioon 1048139)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048139",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048139",
      "estleg:sourceAct": "Ainja maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1048139 § 14",
      "estleg:partOfAct": {
