      }
    },
    {
      "@id": "estleg:Reg_153624_Par_20_v153624",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153624_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastutaval töötlejal on õigus kontrollida registrisse kantud andmete õigsust ja teha volitatud töötlejale järelepärimisi, kui registrisse kandmisele kuuluvad andmed on jäetud õigeaegselt kandmata või on tekkinud kahtlus, et registriandmetes esineb vigu. Volitatud töötleja on kohustatud järelepärimisele vastama kümne tööpäeva jooksul ning kandma andmed või andmete muudatused registrisse mitte hiljem kui viis tööpäeva pärast vastutavalt töötlejalt vastavasisulise järelepärimise saamist. Vastutaval töötlejal on õigus kontrollida registrisse kantud andmete õigsust ja teha volitatud töötlejale järelepärimisi, kui registrisse kandmisele kuuluvad andmed on jäetud õigeaegselt kandmata või on tekkinud kahtlus, et registriandmetes esineb vigu. Volitatud töötleja on kohustatud järelepärimisele vastama kümne tööpäeva jooksul ning kandma andmed või andmete muudatused registrisse mitte hiljem kui viis tööpäeva pärast vastutavalt töötlejalt vastavasisulise järelepärimise saamist.",
      "rdfs:label": {
        "@value": "Reg_153624_Par_20 (redaktsioon 153624)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153624",
