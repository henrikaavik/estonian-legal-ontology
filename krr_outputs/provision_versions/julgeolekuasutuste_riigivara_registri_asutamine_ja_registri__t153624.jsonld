      },
      "estleg:versionValidFrom": {
        "@value": "2017-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeolekuasutuste valduses oleva vara kohta käivate andmete ülekandmise riigivara registrist «Julgeolekuasutuste riigivara registrisse» korraldavad vastutavad töötlejad koostöös Rahandusministeeriumiga. Julgeolekuasutuste valduses oleva vara kohta käivate andmete ülekandmise riigivara registrist «Julgeolekuasutuste riigivara registrisse» korraldavad vastutavad töötlejad koostöös Rahandusministeeriumiga.",
      "rdfs:label": {
