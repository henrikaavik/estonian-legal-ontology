    },
    {
      "@id": "estleg:KrHS_Par_13_v114032014057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusametnikuks võib nimetada isiku, kellel on kriminaalhooldustööks vajalikud kõlbelised omadused ning vastav rakenduslik või akadeemiline kõrgharidus. (2) võib kehtestada täiendavaid kriminaalhooldusametniku, kriminaalhooldusosakonna talituse juhataja ja kriminaalhooldusosakonna juhataja kvalifikatsiooni nõudeid. (3) võib määrusega kehtestada kriminaalhooldusametniku tööülesanded, mida täitval ametnikul ei pea olema käesoleva paragrahvi lõikes 1 nimetatud rakenduslikku või akadeemilist kõrgharidust.",
      "rdfs:label": {
        "@value": "KrHS_Par_13 (redaktsioon 114032014057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014057",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_13_v130122015023"
      },
      "estleg:versionValidTo": {
        "@value": "2016-01-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_13_v130122015023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusametnikuks võib nimetada isiku, kellel on kriminaalhooldustööks vajalikud kõlbelised omadused ning vastav rakenduslik või akadeemiline kõrgharidus. (2) võib kehtestada täiendavaid kriminaalhooldusametniku, kriminaalhooldusosakonna talituse juhataja ja kriminaalhooldusosakonna juhataja kvalifikatsiooni nõudeid. (2<sup>1</sup>) Kriminaalhooldusametnikuks võib nimetada ka välisriigi kutsekvalifikatsiooni omandanud isiku, kui tema kutsekvalifikatsiooni on tunnustatud välisriigi kutsekvalifikatsiooni tunnustamise seaduse kohaselt. Välisriigi kutsekvalifikatsiooni tunnustamise seaduse § 7 lõikes 2 sätestatud pädev asutus on Justiitsministeerium. (3) võib määrusega kehtestada kriminaalhooldusametniku tööülesanded, mida täitval ametnikul ei pea olema käesoleva paragrahvi lõikes 1 nimetatud rakenduslikku või akadeemilist kõrgharidust.",
      "rdfs:label": {
        "@value": "KrHS_Par_13 (redaktsioon 130122015023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015023",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_13_v114032025025"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_13_v114032025025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusametnikuks võib nimetada isiku, kellel on kriminaalhooldustööks vajalikud kõlbelised omadused ning vastav rakenduslik või akadeemiline kõrgharidus. (2) võib kehtestada täiendavaid kriminaalhooldusametniku, kriminaalhooldusosakonna talituse juhataja ja kriminaalhooldusosakonna juhataja kvalifikatsiooni nõudeid. (2<sup>1</sup>) Kriminaalhooldusametnikuks võib nimetada ka välisriigi kutsekvalifikatsiooni omandanud isiku, kui tema kutsekvalifikatsiooni on tunnustatud välisriigi kutsekvalifikatsiooni tunnustamise seaduse kohaselt. Välisriigi kutsekvalifikatsiooni tunnustamise seaduse § 7 lõikes 2 sätestatud pädev asutus on Justiits- ja Digiministeerium. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes (3) võib määrusega kehtestada kriminaalhooldusametniku tööülesanded, mida täitval ametnikul ei pea olema käesoleva paragrahvi lõikes 1 nimetatud rakenduslikku või akadeemilist kõrgharidust.",
      "rdfs:label": {
        "@value": "KrHS_Par_13 (redaktsioon 114032025025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032025025"
    },
    {
      "@id": "estleg:KrHS_Par_14_v25479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusametnik nimetatakse ametisse avaliku konkursi teel. (2) Kriminaalhooldusametniku nimetab ametisse vastava kohtu esimees. (3) Kriminaalhooldusametnik nimetatakse ametisse kuuekuulise katseajaga.",
      "rdfs:label": {
        "@value": "KrHS_Par_14 (redaktsioon 25479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25479",
