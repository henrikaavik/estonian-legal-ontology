        "@value": "2008-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_14_v12952822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusametniku nimetab kuuekuulise katseajaga ametisse vangla direktor.",
      "rdfs:label": {
        "@value": "KrHS_Par_14 (redaktsioon 12952822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12952822",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_14_v106082022024"
      },
      "estleg:versionValidTo": {
        "@value": "2022-08-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_14_v106082022024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusametnikule kohaldatakse katseaega kuni kuus kuud ametikohale asumisest arvates.",
      "rdfs:label": {
        "@value": "KrHS_Par_14 (redaktsioon 106082022024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106082022024"
    },
    {
      "@id": "estleg:KrHS_Par_15_v25479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusametnik on kohustatud kriminaalhooldusosakonna juhataja korraldusel juhendama kriminaalhoolduse praktikanti ja kriminaalhooldusabilist. Kriminaalhooldusametnik ei ole kohustatud juhendama üheaegselt rohkem kui kahte praktikanti ja viit kriminaalhooldusabilist. (2) Kriminaalhooldusametnikule, kes juhendab praktikanti või kriminaalhooldusabilist, makstakse juhendamistasu, mis on viis protsenti kriminaalhooldusametniku ametipalgast ühe juhendatava eest.",
      "rdfs:label": {
        "@value": "KrHS_Par_15 (redaktsioon 25479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25479",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_15_v120122012009"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_15_v120122012009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusametnik on kohustatud kriminaalhooldusosakonna juhataja korraldusel juhendama kriminaalhoolduse praktikanti ja kriminaalhooldusabilist. Kriminaalhooldusametnik ei ole kohustatud juhendama üheaegselt rohkem kui kahte praktikanti ja viit kriminaalhooldusabilist. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "KrHS_Par_15 (redaktsioon 120122012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012009"
    },
    {
      "@id": "estleg:KrHS_Par_15_1_v120122012009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_15_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldust teostav ametnik peab teavitama talle ametitegevuse käigus teatavaks saanud kuritegudest ja väärtegudest.",
      "rdfs:label": {
        "@value": "KrHS_Par_15_1 (redaktsioon 120122012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012009"
    },
    {
      "@id": "estleg:KrHS_Par_15_2_v113032019100",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_15_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusametnik ei tohi avaldada talle seoses teenistusülesannete täitmisega teatavaks saanud asjaolusid ega andmeid, sealhulgas mistahes isikuandmeid ja isikute vahelisi suhteid puudutavaid andmeid. Ametisaladuse hoidmise kohustus on tähtajatu.",
      "rdfs:label": {
        "@value": "KrHS_Par_15_2 (redaktsioon 113032019100)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019100"
    },
    {
      "@id": "estleg:KrHS_Par_16_v25479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistusliku tegevuse tõttu kriminaalhooldusametnikule või tema perekonnaliikmele tahtlikult tekitatud varalise kahju hüvitab riik. Kahjutasu nõutakse sisse süüdiolevalt isikult.",
      "rdfs:label": {
        "@value": "KrHS_Par_16 (redaktsioon 25479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25479",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_16_v12952822"
      },
      "estleg:versionValidTo": {
        "@value": "2008-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_16_v12952822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusametniku teenistusülesannete täitmise tõttu kriminaalhooldusametnikule või tema perekonnaliikmele tahtlikult tekitatud varalise kahju hüvitab riik vangistusseaduse §-s 143 sätestatud korras. Kahjutasu nõutakse sisse süüdiolevalt isikult.",
      "rdfs:label": {
        "@value": "KrHS_Par_16 (redaktsioon 12952822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12952822"
    },
    {
      "@id": "estleg:KrHS_Par_17_v25479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusabiline on isik, kes täidab kriminaalhooldusülesandeid oma vabast ajast ja tasu saamata. (2) Kriminaalhooldusabiline tegutseb kriminaalhooldusametniku juhendamisel. (3) Kriminaalhooldusabiline võib olla isik, kes on avaldanud sellekohast soovi ja sobib kriminaalhooldusabilisena tegutsema. Sobivuse hindamisel tutvutakse dokumentide ja vestluse kaudu taotleja isikuomaduste, hariduse, elukäigu ja tööalase tegevusega. (4) Kriminaalhooldusabiline ei või olla kohtunik ega prokurör, samuti kohtu, prokuratuuri, politsei või kinnipidamiskoha koosseisuline töötaja, kes on avalik teenistuja.",
      "rdfs:label": {
        "@value": "KrHS_Par_17 (redaktsioon 25479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25479",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_17_v113032019100"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_17_v113032019100",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusabiline on isik, kes täidab kriminaalhooldusülesandeid oma vabast ajast ja tasu saamata. (2) Kriminaalhooldusabiline tegutseb kriminaalhooldusametniku juhendamisel. (3) Kriminaalhooldusabiline võib olla isik, kes on avaldanud sellekohast soovi ja sobib kriminaalhooldusabilisena tegutsema. Sobivuse hindamisel tutvutakse dokumentide ja vestluse kaudu taotleja isikuomaduste, hariduse, elukäigu ja tööalase tegevusega. (3<sup>1</sup>) Hindamisel on lubatud töödelda isiku tuvastamise andmeid, kontaktandmeid, elukoha andmeid, isikut iseloomustavaid andmeid, sealhulgas isikuomadusi, hariduse ja õpingute andmeid, elulookirjelduse andmeid, isiku karistusandmeid ning töökoha ja varasema töökogemuse andmeid. (4) Kriminaalhooldusabiline ei või olla kohtunik ega prokurör, samuti kohtu, prokuratuuri, politsei või kinnipidamiskoha koosseisuline töötaja, kes on avalik teenistuja. (5) Kriminaalhooldusabiline ei tohi avaldada talle seoses ülesannete täitmisega teatavaks saanud asjaolusid ega andmeid, sealhulgas mistahes isikuandmeid ja isikute vahelisi suhteid puudutavaid andmeid. Saladuse hoidmise kohustus on tähtajatu.",
      "rdfs:label": {
        "@value": "KrHS_Par_17 (redaktsioon 113032019100)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019100"
    },
    {
      "@id": "estleg:KrHS_Par_18_v25479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusabilisena võib tegutseda isik, kelle kohtu esimees on kriminaalhooldusosakonna juhataja ettepanekul kandnud kriminaalhooldusabiliste nimekirja. (2) Osakonna kriminaalhooldusabiliste nimekirja peab kohtu esimees, üleriigilist kriminaalhooldusabiliste nimekirja peab Justiitsministeerium. (3) Kriminaalhooldusabiliste nimekirja märgitakse kriminaalhooldusabilise ees- ja perekonnanimi, elukoht, telefon ja töökoht. Kui kriminaalhooldusabiline eelistab tegelemist kindla isikute rühmaga, tehakse selle kohta nimekirja märge. (4) Isik kustutatakse kriminaalhooldusabiliste nimekirjast, kui ta on rikkunud kriminaalhooldaja kohustusi või muul viisil osutunud sobimatuks kriminaalhooldusabilisena tegutsema või on korduvalt põhjendamatult keeldunud kriminaalhooldusülesannete täitmisest. (5) Kui ühe kohtu kriminaalhooldusosakond täidab kriminaalhooldusülesandeid ka teise kohtu tööpiirkonnas, teeb kohtu esimees kriminaalhooldusabiliste nimekirja ja selle muudatused teatavaks ka teise kohtu esimehele.",
      "rdfs:label": {
        "@value": "KrHS_Par_18 (redaktsioon 25479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25479",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_18_v184396"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_18_v184396",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusabilisena võib tegutseda isik, kelle kriminaalhooldusosakonna juhataja on kandnud kriminaalhooldusabiliste nimekirja. (2) Osakonna kriminaalhooldusabiliste nimekirja peab kriminaalhooldusosakonna juhataja, üleriigilist kriminaalhooldusabiliste nimekirja peab Justiitsministeerium. (3) Kriminaalhooldusabiliste nimekirja märgitakse kriminaalhooldusabilise ees- ja perekonnanimi, elukoht, telefon ja töökoht. Kui kriminaalhooldusabiline eelistab tegelemist kindla isikute rühmaga, tehakse selle kohta nimekirja märge. (4) Isik kustutatakse kriminaalhooldusabiliste nimekirjast, kui ta on rikkunud kriminaalhooldaja kohustusi või muul viisil osutunud sobimatuks kriminaalhooldusabilisena tegutsema või on korduvalt põhjendamatult keeldunud kriminaalhooldusülesannete täitmisest. (5) Kehtetu -",
      "rdfs:label": {
        "@value": "KrHS_Par_18 (redaktsioon 184396)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184396",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_18_v12744437"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
