        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_12_v120122012009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "KrHS_Par_12 (redaktsioon 120122012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012009"
    },
    {
      "@id": "estleg:KrHS_Par_13_v25479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusametnikuks võib nimetada isiku, kellel on kriminaalhooldustööks vajalikud kõlbelised omadused, vastav rakenduslik kõrgharidus või muu kõrgharidus ja kes on sooritanud kriminaalhooldusametniku eksami. (2) Kriminaalhooldusametniku eksami viib läbi kriminaalhooldusametniku eksamikomisjon, mille koosseisu kuuluvad justiitsministri nimetamisel Justiitsministeeriumi esindaja, kriminaalhooldusosakonna juhataja ja kriminaalhooldusametnik, Riigikohtu esimehe nimetamisel üks maa- või linnakohtu kohtunik ja üks Riigikohtu liige ning riigiprokuröri nimetamisel üks prokurör.",
      "rdfs:label": {
        "@value": "KrHS_Par_13 (redaktsioon 25479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25479",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_13_v740799"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KrHS_Par_13_v740799",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalhooldusametnikuks võib nimetada isiku, kellel on kriminaalhooldustööks vajalikud kõlbelised omadused ning vastav rakenduslik või akadeemiline kõrgharidus. (2) Justiitsminister võib kehtestada täiendavaid kriminaalhooldusametniku, kriminaalhooldusosakonna talituse juhataja ja kriminaalhooldusosakonna juhataja kvalifikatsiooni nõudeid.",
      "rdfs:label": {
        "@value": "KrHS_Par_13 (redaktsioon 740799)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740799",
