        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtu esimees esitab Justiitsministeeriumile iga aasta 1. märtsiks kriminaalhooldusosakonna eelneva aasta tegevusaruande.",
      "rdfs:label": {
        "@value": "KrHS_Par_12 (redaktsioon 25479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25479",
      "estleg:supersededByVersion": {
        "@id": "estleg:KrHS_Par_12_v184396"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
