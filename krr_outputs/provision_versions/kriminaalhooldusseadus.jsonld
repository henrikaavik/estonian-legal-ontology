      }
    },
    {
      "@id": "estleg:KrHS_Par_12_v184396",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KrHS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusosakonna juhataja korraldab regulaarsete statistiliste aruannete edastamise Justiitsministeeriumile.",
      "rdfs:label": {
        "@value": "KrHS_Par_12 (redaktsioon 184396)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184396",
