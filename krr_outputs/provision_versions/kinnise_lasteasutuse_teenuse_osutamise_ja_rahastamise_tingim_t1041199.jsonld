      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kinnise lasteasutuse teenuse osutamise ja rahastamise tingimused (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kinnise lasteasutuse teenuse osutamise ja rahastamise tingimused"
    },
    {
      "@id": "estleg:Reg_1041199_Par_1_v1041199",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
