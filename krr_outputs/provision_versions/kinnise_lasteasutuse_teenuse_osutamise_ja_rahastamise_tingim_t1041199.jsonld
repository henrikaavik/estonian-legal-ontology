      "estleg:sourceAct": "Kinnise lasteasutuse teenuse osutamise ja rahastamise tingimused",
      "estleg:provisionRef": "Reg_1041199 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041199_Map"
      }
    },
    {
      "@id": "estleg:Reg_1041199_Par_2_v1041199",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
