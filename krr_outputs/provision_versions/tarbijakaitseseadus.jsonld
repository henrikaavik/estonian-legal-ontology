      },
      "estleg:versionValidTo": {
        "@value": "2007-12-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/757827",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 4",
