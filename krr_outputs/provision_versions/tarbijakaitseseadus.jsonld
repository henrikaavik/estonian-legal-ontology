    {
      "@id": "estleg:TarbKS_Par_76_v131122015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandus- ja Kommunikatsiooniministeerium koostab ja avaldab esimese aruande käesoleva seaduse alusel tunnustatud vaidluste kohtuvälise lahendamise üksuste toimimise ja arengu kohta 2018. aasta 9. juuliks.",
      "rdfs:label": {
        "@value": "TarbKS_Par_76 (redaktsioon 131122015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015001",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 76",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_77_v131122015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majandus- ja Kommunikatsiooniministeerium kannab tunnustatud vaidluste kohtuvälise lahendamise üksuste nimekirja Tarbijakaitseameti juures tegutseva tarbijavaidluste komisjoni ja käesoleva seaduse § 30 lõike 6 alusel tunnustatud vaidluste kohtuvälise lahendamise üksused. Nimekiri edastatakse Euroopa Komisjonile. (2) Tunnustatud vaidluste kohtuvälise lahendamise üksuste nimekiri avaldatakse Majandus- ja Kommunikatsiooniministeeriumi ning Tarbijakaitseameti veebilehel.",
      "rdfs:label": {
        "@value": "TarbKS_Par_77 (redaktsioon 131122015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_77_v112122018065"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015001",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 77",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_77_v112122018065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majandus- ja Kommunikatsiooniministeerium kannab tunnustatud vaidluste kohtuvälise lahendamise üksuste nimekirja Tarbijakaitse ja Tehnilise Järelevalve Ameti juures tegutseva tarbijavaidluste komisjoni ja käesoleva seaduse § 30 lõike 6 alusel tunnustatud vaidluste kohtuvälise lahendamise üksused. Nimekiri edastatakse Euroopa Komisjonile. (2) Tunnustatud vaidluste kohtuvälise lahendamise üksuste nimekiri avaldatakse Majandus- ja Kommunikatsiooniministeeriumi ning Tarbijakaitse ja Tehnilise Järelevalve Ameti veebilehel.",
      "rdfs:label": {
        "@value": "TarbKS_Par_77 (redaktsioon 112122018065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112122018065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112122018065",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 77",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_77_1_v108072025031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_77_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2025. aasta 15. juulit käesoleva seaduse §-de 71–723 alusel alustatud, kuid 2025. aasta 15. juuli seisuga lõpetamata väärteomenetlused viib lõpuni väärteomenetluse alustanud kohtuväline menetleja enne 2025. aasta 15. juulit kehtinud õigusaktide alusel.",
      "rdfs:label": {
        "@value": "TarbKS_Par_77_1 (redaktsioon 108072025031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025031",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072025031",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 77_1",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_78_v131122015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Advokatuuriseaduse § 15 täiendatakse lõikega 11 järgmises sõnastuses: „(11) Aukohus võib lahendada lepitusmenetluse korras kliendilepingust, sealhulgas tarbijaga sõlmitud kliendilepingust, tulenevaid vaidlusi advokatuuri kodukorras sätestatud alustel ja korras. Lepitusmenetluse alused ja täpsem kord kehtestatakse kodukorras ja juhatuse kinnitatud töökorras.”.",
      "rdfs:label": {
        "@value": "TarbKS_Par_78 (redaktsioon 131122015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015001",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 78",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_8_v22269",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Müüjal on keelatud: ahistada käesoleva seadusega sätestatud tarbija õigusi; ebaseaduslikult piirata või soodustada kaupade või teenuste müüki, mõjutada tarbijat eksitava reklaami, teise müüja kauba või teenuse halvustamise, firmanimetuse, kaubamärgi või teiste tunnuste lubamatu kasutamisega või muul moel, mis on vastuolus üldiste kaubandustegevuse heade kommete ja tavadega; müüa markeerimata pakendatud kaupa; müüa tootja poolt märgitud realiseerimistähtaega ületanud kaupa; võtta müügile kaupa, mille hulgimüük on litsentsitud tegevusala, vastavat tegevusluba mitteomavalt vahendajalt. (2) Keelud ja piirangud tubakatoodete, alkohoolsete jookide, relvade, laskemoona, narkootiliste ja uimastavate ainete, ravimite ning muude tarbijat kahjustavate või kahjustada võivate kaupade ja teenuste reklaami, müügi või tootmise kohta sätestatakse eraldi seadusega või seaduses ettenähtud juhtudel Vabariigi Valitsuse määrusega. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "TarbKS_Par_8 (redaktsioon 22269)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22269",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_8_v179158"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22269",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_8_v179158",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Müüjal või teenuse osutajal on keelatud: ahistada käesoleva seadusega sätestatud tarbija õigusi; ebaseaduslikult piirata või soodustada kaupade või teenuste müüki, mõjutada tarbijat eksitava reklaami, teise müüja kauba või teenuse halvustamise, firmanimetuse, kaubamärgi või teiste tunnuste lubamatu kasutamisega või muul moel, mis on vastuolus üldiste kaubandustegevuse heade kommete ja tavadega; müüa markeerimata pakendatud kaupa; müüa tootja poolt märgitud realiseerimistähtaega ületanud kaupa; võtta müügile kaupa, mille hulgimüük on litsentsitud tegevusala, vastavat tegevusluba mitteomavalt vahendajalt. (2) Keelud ja piirangud tubakatoodete, alkohoolsete jookide, relvade, laskemoona, narkootiliste ja uimastavate ainete, ravimite ning muude tarbijat kahjustavate või kahjustada võivate kaupade ja teenuste reklaami, müügi või tootmise kohta sätestatakse eraldi seadusega või seaduses ettenähtud juhtudel Vabariigi Valitsuse määrusega. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "TarbKS_Par_8 (redaktsioon 179158)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "179158",
