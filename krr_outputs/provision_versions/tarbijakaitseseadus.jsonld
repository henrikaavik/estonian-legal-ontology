      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/192457",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 11",
      "estleg:partOfAct": {
