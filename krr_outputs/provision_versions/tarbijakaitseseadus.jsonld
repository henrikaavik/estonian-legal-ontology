      }
    },
    {
      "@id": "estleg:TarbKS_Par_38_v115032014055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet käesoleva seaduse ja teiste õigusaktide alusel tarbijale antud õiguste tagamise üle teostab Tarbijakaitseamet. (2) Riiklikku järelevalvet tarbijale osutatava teenuse terviseohutuse ja puudusega kauba müügile kehtestatud nõuete täitmise üle teostab Terviseamet. (3) Riiklikku järelevalvet tarbijale pakutavate kaupade ja osutatavate teenuste hinna avaldamise nõuete ning kauba märgistuse ja kasutusjuhendi suhtes kehtestatud nõuete täitmise üle oma haldusterritooriumil teostab valla- või linnavalitsus.",
      "rdfs:label": {
        "@value": "TarbKS_Par_38 (redaktsioon 115032014055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014055",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_38_v131122015001"
      },
      "estleg:versionValidTo": {
        "@value": "2016-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032014055",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_38_v131122015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vaidluste kohtuvälise lahendamise üksus teeb koostööd tarbijaõigusi käsitlevate õigusaktide täitmise tagamisega tegelevate riikliku järelevalve ülesannet täitvate asutustega. (2) Koostöö hõlmab eelkõige vastastikust teabevahetust tarbijate korduvalt esitatud kaebuste kohta seoses konkreetses ettevõtlussektoris kasutatava praktikaga. Koostöö hõlmab ka riikliku järelevalve ülesannet täitvate asutuste poolt tehniliste hinnangute ja teabe andmist vaidluste kohtuvälise lahendamise üksustele, kui see hinnang või teave on vajalik konkreetse vaidluse lahendamiseks ja seda on võimalik anda. (3) Käesoleva paragrahvi lõigetes 1 ja 2 nimetatud vastastikuse koostöö ja teabevahetuse puhul järgitakse isikuandmete kaitse seaduses ja ärisaladuse kohta konkurentsiseaduses sätestatut.",
      "rdfs:label": {
        "@value": "TarbKS_Par_38 (redaktsioon 131122015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015001",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_39_v715202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Oma ülesannete täitmiseks on järelevalve teostajal õigus: kontrollida tarbijale pakutavate kaupade ja teenuste nõuetekohasust, sooritades vajaduse korral kontrolloste; takistamatult siseneda kaupleja majandus- või kutsetegevuses kasutatavatesse ruumidesse ning avada kaupu vedavaid veovahendeid kaupleja või tema esindaja või politseiametniku juuresolekul; nõuda kauplejalt või tootjalt asjakohaseid dokumente, materjale ja seletusi ning muud asjakohast teavet; peatada tarbijale ohtliku kauba või teenuse pakkumine ja müük, kasutades vajaduse korral pitseerimist või plommimist; teha kauplejale suulisi hoiatusi ja juhtida tema tähelepanu tarbijakaitsealaste nõuete täitmata jätmisele; teha ettepanekuid pädevale isikule või institutsioonile kaupleja tegevuse peatamiseks või lõpetamiseks seadusega ettenähtud korras, kui kaupleja ei järgi oma tegevusalal tegutsemiseks kehtestatud nõudeid; teha oma pädevuse piires ettekirjutusi. (2) Järelevalve teostaja on kohustatud tööülesannete täitmisel esitama ametitõendi.",
      "rdfs:label": {
        "@value": "TarbKS_Par_39 (redaktsioon 715202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715202",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_39_v115032014055"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715202",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_39_v115032014055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tarbijakaitseamet ja Terviseamet võivad käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 49, 50, 51, 52 ja 53 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras. (2) Kohalik omavalitsus võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 49, 50 ja 51 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "TarbKS_Par_39 (redaktsioon 115032014055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014055",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_39_v131122015001"
      },
      "estleg:versionValidTo": {
        "@value": "2016-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032014055",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_39_v131122015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Internetipõhistest kauba müügi, teenuse osutamise või muu soorituse tegemisega seotud lepingutest tulenevate lepinguliste kohustustega seotud vaidluste lahendamine võib Euroopa Parlamendi ja nõukogu määruse (EL) nr 524/2013 kohaselt toimuda internetipõhise vaidluste lahendamise platvormi kaudu. (2) Käesoleva paragrahvi lõikes 1 nimetatud määruse artikli 7 lõike 1 kohase internetipõhise vaidluste lahendamise kontaktpunkti ülesandeid täidab Tarbijakaitseameti juures tegutsev Euroopa Liidu tarbija nõustamiskeskus. Euroopa Liidu tarbija nõustamiskeskus teeb vaidluste kohtuvälise lahendamise üksuste konsolideeritud nimekirja kättesaadavaks oma veebilehel, esitades lingi Euroopa Komisjoni asjakohasele veebilehele, ja võimaluse korral püsival andmekandjal oma ruumides.",
      "rdfs:label": {
        "@value": "TarbKS_Par_39 (redaktsioon 131122015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_39_v112122018065"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015001",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_39_v112122018065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Internetipõhistest kauba müügi, teenuse osutamise või muu soorituse tegemisega seotud lepingutest tulenevate lepinguliste kohustustega seotud vaidluste lahendamine võib Euroopa Parlamendi ja nõukogu määruse (EL) nr 524/2013 kohaselt toimuda internetipõhise vaidluste lahendamise platvormi kaudu. (2) Käesoleva paragrahvi lõikes 1 nimetatud määruse artikli 7 lõike 1 kohase internetipõhise vaidluste lahendamise kontaktpunkti ülesandeid täidab Tarbijakaitse ja Tehnilise Järelevalve Ameti juures tegutsev Euroopa Liidu tarbija nõustamiskeskus. Euroopa Liidu tarbija nõustamiskeskus teeb vaidluste kohtuvälise lahendamise üksuste konsolideeritud nimekirja kättesaadavaks oma veebilehel, esitades lingi Euroopa Komisjoni asjakohasele veebilehele, ja võimaluse korral püsival andmekandjal oma ruumides.",
      "rdfs:label": {
        "@value": "TarbKS_Par_39 (redaktsioon 112122018065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112122018065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112122018065",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_4_v22269",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tarbija põhiõigused on: nõuda vähemalt kohustuslikele nõuetele vastavat kaupa või teenust; olla kaitstud oma elule, tervisele, varale ja keskkonnale ohtliku ning kasutamiseks või omamiseks keelatud kauba või teenuse eest; saada vajalikku ja tõest teavet pakutavate kaupade ja teenuste hulgast teadliku valiku tegemiseks; taotleda oma huvide arvestamist ja olla esindatud oma liitude ja ühingute kaudu otsuste tegemisel tarbijapoliitikat puudutavates küsimustes; nõuda riiklikku kaitset oma õiguste ahistamise korral; nõuda müüjalt hüvitust endale tekitatud materiaalse ja moraalse kahju eest.",
      "rdfs:label": {
        "@value": "TarbKS_Par_4 (redaktsioon 22269)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22269",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_4_v179158"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22269",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_4_v179158",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tarbija põhiõigused on: nõuda vähemalt kohustuslikele nõuetele vastavat kaupa või teenust; olla kaitstud oma elule, tervisele, varale ja keskkonnale ohtliku ning kasutamiseks või omamiseks keelatud kauba või teenuse eest; saada vajalikku ja tõest teavet pakutavate kaupade ja teenuste hulgast teadliku valiku tegemiseks; taotleda oma huvide arvestamist ja olla esindatud oma liitude ja ühingute kaudu otsuste tegemisel tarbijapoliitikat puudutavates küsimustes; nõuda seaduses sätestatud korras riiklikku kaitset oma õiguste rikkumise korral. kehtetu -",
      "rdfs:label": {
        "@value": "TarbKS_Par_4 (redaktsioon 179158)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "179158",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_4_v715202"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/179158",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_4_v715202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tarbijal on õigus saada pakutava kauba või teenuse kohta ohutuse, samuti tervise, vara ja majandushuvide kaitse seisukohalt vajalikku teavet. (2) Kaupleja ja tootja on kohustatud andma tarbijale enne kauba omandamist või teenuse kasutamist üksikasjalikku teavet kauba või teenuse omaduste ja kasutamistingimuste ning käesoleva seaduse § 10 kohase garantii kohta selle olemasolu korral, samuti hinna ja tasumise tingimuste ning lepingu täitmise ja sellest tulenevate õiguste, kohustuste ja vastutuse, sealhulgas kauba või teenuse suhtes pretensiooni esitamise võimaluste kohta, pidades silmas käesoleva paragrahvi lõikes 1 sätestatut. (3) Lisaks käesoleva paragrahvi lõikes 2 nimetatud teabele on tarbijal õigus saada pakutava kauba või teenuse kohta lisateavet. (4) Tarbijale antav teave peab olema tõene ja arusaadav ning esitatud tarbijale eesti keeles. (5) Tarbijale kauba või teenuse kohta edastatava teabega ei tohi kaubale või teenusele omistada omadusi, mis sellel puuduvad, või anda mõista, et kaubal või teenusel on erilised omadused, kui tegelikult on omadused samasugused nagu kõigil seda laadi kaupadel või teenustel. (6) Kauba või teenuse eest tasumisel peab kaupleja andma tarbijale kauba või teenuse ostmist tõendava dokumendi, millel on vähemalt: kaupleja nimi või ärinimi ja tegevuskoha aadress; müügikuupäev; iga kauba või teenuse hind ja tasutud summa. (7) Kui tarbija tasutav summa on väiksem kui 300 krooni, antakse käesoleva paragrahvi lõikes 6 nimetatud dokument tarbija nõudmisel. (8) Vabariigi Valitsus või tema volitatud minister võib vajaduse korral kehtestada teatud kauba või teenuse kohta tarbijale teabe andmise nõuded.",
      "rdfs:label": {
        "@value": "TarbKS_Par_4 (redaktsioon 715202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715202",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_4_v757827"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715202",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_4_v757827",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tarbijal on õigus saada pakutava kauba või teenuse kohta ohutuse, samuti tervise, vara ja majandushuvide kaitse seisukohalt vajalikku teavet. (2) Kaupleja ja tootja on kohustatud andma tarbijale enne kauba omandamist või teenuse kasutamist üksikasjalikku teavet kauba või teenuse omaduste ja kasutamistingimuste ning käesoleva seaduse § 10 kohase garantii kohta selle olemasolu korral, samuti hinna ja tasumise tingimuste ning lepingu täitmise ja sellest tulenevate õiguste, kohustuste ja vastutuse, sealhulgas kauba või teenuse suhtes pretensiooni esitamise võimaluste kohta, pidades silmas käesoleva paragrahvi lõikes 1 sätestatut. (3) Lisaks käesoleva paragrahvi lõikes 2 nimetatud teabele on tarbijal õigus saada pakutava kauba või teenuse kohta lisateavet. (4) Tarbijale antav teave peab olema tõene ja arusaadav ning esitatud tarbijale eesti keeles. (5) Tarbijale kauba või teenuse kohta edastatava teabega ei tohi kaubale või teenusele omistada omadusi, mis sellel puuduvad, või anda mõista, et kaubal või teenusel on erilised omadused, kui tegelikult on omadused samasugused nagu kõigil seda laadi kaupadel või teenustel. (6) Kauba või teenuse eest tasumisel peab kaupleja andma tarbijale kauba või teenuse ostmist tõendava dokumendi, millel on vähemalt: kaupleja nimi või ärinimi ja tegevuskoha aadress; müügikuupäev; iga kauba või teenuse hind ja tasutud summa. (7) Kui tarbija tasutav summa on väiksem kui 300 krooni, antakse käesoleva paragrahvi lõikes 6 nimetatud dokument tarbija nõudmisel.",
      "rdfs:label": {
        "@value": "TarbKS_Par_4 (redaktsioon 757827)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "757827",
      "estleg:supersededByVersion": {
