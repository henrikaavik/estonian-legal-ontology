      }
    },
    {
      "@id": "estleg:TarbKS_Par_2_v715202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse tähenduses on: tarbija – füüsiline isik, kellele pakutakse või kes omandab või kasutab kaupa või teenust eesmärgil, mis ei seondu tema majandus- või kutsetegevusega; kaupleja – isik, kes oma majandus- või kutsetegevuses pakub ja müüb või muul viisil turustab tarbijale kaupa või osutab teenust; kaup – vallasasi, mida kaupleja pakub, müüb või muul viisil turustab tarbijale; teenus – teenus, mida pakub või osutab kaupleja; tootja – toote ohutuse seaduses määratletud isik; universaalteenus – üldistes huvides osutatav ja riigi või teatud piirkonna valdava enamiku elanike kasutatav teenus, milleks on gaasi-, elektri-, soojusenergia-, vee- ja kanalisatsiooni-, jäätmekäitlus- ja sideteenus ning muu samalaadne teenus.",
      "rdfs:label": {
        "@value": "TarbKS_Par_2 (redaktsioon 715202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715202",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_2_v12876059"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715202",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_2_v12876059",
