        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse ülesanne on tagada tarbija õiguste kaitsmine Eestis. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "TarbKS_Par_1 (redaktsioon 179158)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "179158",
