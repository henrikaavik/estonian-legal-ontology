      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse tähenduses on: tarbija – füüsiline isik, kellele pakutakse või kes omandab või kasutab kaupa või teenust eesmärgil, mis ei seondu tema majandus- või kutsetegevusega; kaupleja – isik, kes oma majandus- või kutsetegevuses pakub ja müüb või muul viisil turustab tarbijale kaupa või osutab teenust; kaup – kaupleja pakutav, müüdav või muul viisil turustatav asi või õigus; teenus – kaupleja pakutav, müüdav või muul viisil turustatav hüve, mis ei ole kaup; tootja – toote ohutuse seaduses määratletud isik; universaalteenus – üldistes huvides osutatav ja riigi või teatud piirkonna valdava enamiku elanike kasutatav teenus, milleks on gaasi-, elektri-, soojusenergia-, vee- ja kanalisatsiooni-, jäätmekäitlus- ja sideteenus ning muu samalaadne teenus.",
      "rdfs:label": {
        "@value": "TarbKS_Par_2 (redaktsioon 12876059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12876059",
