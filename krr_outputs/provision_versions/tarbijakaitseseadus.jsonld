    {
      "@id": "estleg:TarbKS_Par_16_1_v101042022007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_16_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet teostav korrakaitseorgan võib nõuda, et kaupleja tõendaks tema kauplemisvõttega seotud faktiliste väidete täpsust. (2) Kui kaupleja ei täida käesoleva paragrahvi lõikes 1 nimetatud nõuet, võib riiklikku järelevalvet teostav korrakaitseorgan lugeda kauplemisvõttega seotud faktilisi väiteid ebatäpseks.",
      "rdfs:label": {
        "@value": "TarbKS_Par_16_1 (redaktsioon 101042022007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101042022007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/101042022007",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 16_1",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_17_v22269",
      "@type": [
