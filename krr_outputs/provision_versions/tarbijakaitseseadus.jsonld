      }
    },
    {
      "@id": "estleg:TarbKS_Par_22_v22269",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni füüsiliste isikute mittetulundusühinguid reguleeriva seaduse kehtestamiseni toimub tarbijaühingute asutamine ja tegevus Eesti NSV seaduse «Kodanike ühenduste kohta» alusel.",
      "rdfs:label": {
        "@value": "TarbKS_Par_22 (redaktsioon 22269)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22269",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_22_v715202"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22269",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_22_v715202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tarbijakaebuste komisjon (edaspidi komisjon ) on tarbija ja kaupleja vahelisi vaidlusi lahendav sõltumatu institutsioon. (2) Komisjoni pädevuses on lahendada tarbija ja kaupleja vahel sõlmitud lepingust tulenevaid vaidlusi, mida pooled ei ole suutnud lahendada kokkuleppe teel ja kui vaidlusaluse kauba või teenuse väärtus on 300 või enam krooni. (3) Komisjon ei lahenda vaidlust, kui kahjunõue tuleneb surmajuhtumist, kehavigastusest või tervisekahjustusest. Need vaidlused lahendatakse kohtus. (4) Komisjon ei lahenda vaidlusi, mis on seotud tervishoiuteenuse ja õigusabiteenuse osutamisega, kinnisasja ja ehitise võõrandamisega, samuti vaidlusi, mille lahendamise kord on ette nähtud teistes seadustes. Need vaidlused lahendatakse pädevas institutsioonis või kohtus. (5) Komisjon ei tegele kaebusega, kui vaidluse lahendamine väljub komisjoni pädevusest käesoleva paragrahvi lõikest 2, 3 või 4 tulenevatel asjaoludel.",
      "rdfs:label": {
        "@value": "TarbKS_Par_22 (redaktsioon 715202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715202",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_22_v13329511"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715202",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_22_v13329511",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tarbijakaebuste komisjon (edaspidi komisjon) on tarbija ja kaupleja vahelisi vaidlusi lahendav sõltumatu institutsioon. (2) Komisjoni pädevuses on lahendada tarbija ja kaupleja vahel sõlmitud lepingust tulenevaid vaidlusi, mida pooled ei ole suutnud lahendada kokkuleppe teel ja kui vaidlusaluse kauba või teenuse väärtus on 20 või enam eurot. (3) Komisjon ei lahenda vaidlust, kui kahjunõue tuleneb surmajuhtumist, kehavigastusest või tervisekahjustusest. Need vaidlused lahendatakse kohtus. (4) Komisjon ei lahenda vaidlusi, mis on seotud tervishoiuteenuse ja õigusabiteenuse osutamisega, kinnisasja ja ehitise võõrandamisega, samuti vaidlusi, mille lahendamise kord on ette nähtud teistes seadustes. Need vaidlused lahendatakse pädevas institutsioonis või kohtus. (5) Komisjon ei tegele kaebusega, kui vaidluse lahendamine väljub komisjoni pädevusest käesoleva paragrahvi lõikest 2, 3 või 4 tulenevatel asjaoludel.",
      "rdfs:label": {
        "@value": "TarbKS_Par_22 (redaktsioon 13329511)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329511",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_22_v131122015001"
      },
      "estleg:versionValidTo": {
        "@value": "2016-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13329511",
