      "estleg:provisionRef": "TarbKS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_14_v131122013008",
      "@type": [
