        "@type": "xsd:date"
      },
      "estleg:versionText": "Kauba või teenuse pakkumine ja müük tarbijale kaupleja korraldatud sellise turustussüsteemi kaudu, kus leping sõlmitakse ja sellele eelnev pakkumine tehakse vaid sidevahendi abil ilma osapoolte üheaegse füüsilise kohalolekuta, peab toimuma võlaõigusseaduse §-des 52–621 sätestatu kohaselt.",
      "rdfs:label": {
        "@value": "TarbKS_Par_14 (redaktsioon 13329511)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329511",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_14_v131122013008"
      },
