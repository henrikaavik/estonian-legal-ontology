      }
    },
    {
      "@id": "estleg:TarbKS_Par_14_v22269",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tarbija võib oma õiguste kaitsmise eesmärgil pöörduda linna- või vallavalitsusse, Tarbijakaitseametisse või kohtusse kas otse või tarbijaühingu vahendusel ning osaleda oma avalduse või kaebuse arutamises. (2) Kui seadus ei sätesta teisiti, lahendatakse tarbija esitatud avaldus või kaebus hiljemalt ühe kuu jooksul.",
      "rdfs:label": {
        "@value": "TarbKS_Par_14 (redaktsioon 22269)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22269",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_14_v715202"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22269",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_14_v715202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kauba või teenuse pakkumine ja müük tarbijale kaupleja korraldatud sellise turustussüsteemi kaudu, kus leping sõlmitakse ja sellele eelnev pakkumine tehakse vaid sidevahendi abil ilma osapoolte üheaegse füüsilise kohalolekuta, peab toimuma võlaõigusseaduse §-des 52–62 1 sätestatu kohaselt.",
      "rdfs:label": {
        "@value": "TarbKS_Par_14 (redaktsioon 715202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715202",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_14_v13329511"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715202",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_14_v13329511",
