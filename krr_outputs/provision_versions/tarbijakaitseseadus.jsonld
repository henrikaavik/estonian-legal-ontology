    {
      "@id": "estleg:TarbKS_Par_8_v131122015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenust pakkudes teavitab kaupleja tarbijat teenuse eest tasutavast lõpphinnast. Kui teenuse lõpphinda ei ole võimalik eelnevalt kindlaks määrata, teavitab kaupleja tarbijat teenuse hinna komponentidest, tariifidest või hinna arvutamise alustest nii, et tarbijal on võimalik teenuse lõpphinda piisava täpsusega arvutada. (2) Teenuse pakkumisel pannakse pakutavate teenuste hinnakiri või teenuse hinna arvutamise aluseid kirjeldav muu dokument välja tarbijale nähtavale kohale teenuse osutamise kohas või tehakse muul viisil tarbijale kättesaadavaks. (3) võib määrusega kehtestada täpsemad nõuded teenuse hinna avaldamise kohta.",
      "rdfs:label": {
        "@value": "TarbKS_Par_8 (redaktsioon 131122015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015001",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
