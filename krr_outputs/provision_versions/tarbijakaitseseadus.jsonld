      }
    },
    {
      "@id": "estleg:TarbKS_Par_1_v186688",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse ülesanne on tagada tarbija õiguste kaitsmine Eestis. (2) Kehtetu - (3) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "TarbKS_Par_1 (redaktsioon 186688)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186688",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_1_v715202"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/186688",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_1_v715202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus kehtestatakse tarbija õiguste tagamiseks. (2) Käesolev seadus reguleerib tarbijale kauba või teenuse pakkumist ja müümist või muul viisil turustamist kaupleja poolt, määrab kindlaks tarbija kui kauba või teenuse ostja ja kasutaja õigused, sätestab tarbijakaitse korralduse ja järelevalve ning vastutuse seaduse rikkumise eest. (3) Käesolevat seadust kohaldatakse ka siis, kui kaupleja vahendab tarbijale kauba üleandmist või teenuse osutamist. (4) Tarbijale kauba või teenuse pakkumisel või müümisel või muul viisil turustamisel kohaldatakse käesolevat seadust, võlaõigusseadust (RT I 2001, 81, 487; 2002, 60, 374; 2003, 78, 523), toote ohutuse seadust (RT I 1998, 40, 613; 1999, 82, 753; 2000, 86, 546; 2002, 47, 297; 61, 375; 63, 387; 2003, 20, 120; 26, 156; 32, õiend) ning teisi seadusi. (5) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354; 2002, 53, 336; 61, 375; 2003, 20, 117; 78, 527) sätteid, arvestades käesoleva seaduse erisusi. Tarbija ja kaupleja vaheliste vaidluste lahendamine ei ole haldusmenetlus haldusmenetluse seaduse tähenduses.",
      "rdfs:label": {
        "@value": "TarbKS_Par_1 (redaktsioon 715202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715202",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_1_v13111390"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715202",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:TarbKS_Map"
      }
    },
    {
      "@id": "estleg:TarbKS_Par_1_v13111390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TarbKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus kehtestatakse tarbija õiguste tagamiseks. (2) Käesolev seadus reguleerib tarbijale kauba või teenuse pakkumist ja müümist või muul viisil turustamist kaupleja poolt, määrab kindlaks tarbija kui kauba või teenuse ostja ja kasutaja õigused, sätestab tarbijakaitse korralduse ja järelevalve ning vastutuse seaduse rikkumise eest. (3) Käesolevat seadust kohaldatakse ka siis, kui kaupleja vahendab tarbijale kauba üleandmist või teenuse osutamist. (4) Tarbijale kauba või teenuse pakkumisel või müümisel või muul viisil turustamisel kohaldatakse käesolevat seadust, võlaõigusseadust, toote ohutuse seadust ning teisi seadusi. (5) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse sätteid, arvestades käesoleva seaduse erisusi. Tarbija ja kaupleja vaheliste vaidluste lahendamine ei ole haldusmenetlus haldusmenetluse seaduse tähenduses.",
      "rdfs:label": {
        "@value": "TarbKS_Par_1 (redaktsioon 13111390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13111390",
      "estleg:supersededByVersion": {
        "@id": "estleg:TarbKS_Par_1_v13328494"
      },
      "estleg:versionValidTo": {
        "@value": "2010-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13111390",
