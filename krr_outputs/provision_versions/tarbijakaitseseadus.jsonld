      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui komisjoni esimees või liige leiab, et esineb asjaolu, mis on tema taandumise aluseks, teeb ta selle teatavaks Tarbijakaitseameti peadirektorile või tema volitatud isikule, kes asendab komisjoni esimehe või liikme esimesel võimalusel ja kinnitab käesoleva seaduse § 41 lõike 11 kohaselt uue komisjoni koosseisu.",
      "rdfs:label": {
        "@value": "TarbKS_Par_43 (redaktsioon 131122015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015001",
