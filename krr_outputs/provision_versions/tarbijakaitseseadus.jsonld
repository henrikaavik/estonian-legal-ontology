        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "TarbKS_Par_14 (redaktsioon 131122013008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122013008",
