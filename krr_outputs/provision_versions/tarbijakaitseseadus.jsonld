      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse ülesanne on tagada tarbija õiguste kaitsmine Eestis. (2) Käesoleva seadusega reguleerimata küsimustes kohaldatakse muid õigusakte.",
      "rdfs:label": {
        "@value": "TarbKS_Par_1 (redaktsioon 22269)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22269",
      "estleg:supersededByVersion": {
