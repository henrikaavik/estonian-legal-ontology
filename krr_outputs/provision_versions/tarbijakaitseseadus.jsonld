      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse rikkumise eest kannab füüsiline isik distsiplinaar-, tsiviil-, haldus- või kriminaalvastutust seaduses ettenähtud korras.",
