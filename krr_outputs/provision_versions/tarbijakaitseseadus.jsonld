      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui komisjoni esimees või liige leiab, et esineb asjaolu, mis on tema taandumise aluseks, teeb ta selle teatavaks Tarbijakaitse ja Tehnilise Järelevalve Ameti peadirektorile või tema volitatud isikule, kes asendab komisjoni esimehe või liikme esimesel võimalusel ja kinnitab käesoleva seaduse § 41 lõike 11 kohaselt uue komisjoni koosseisu.",
      "rdfs:label": {
        "@value": "TarbKS_Par_43 (redaktsioon 112122018065)",
