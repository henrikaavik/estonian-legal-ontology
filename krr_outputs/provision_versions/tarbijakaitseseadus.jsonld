      },
      "estleg:versionValidTo": {
        "@value": "2016-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/976018",
      "estleg:sourceAct": "Tarbijakaitseseadus",
      "estleg:provisionRef": "TarbKS § 31",
      "estleg:partOfAct": {
