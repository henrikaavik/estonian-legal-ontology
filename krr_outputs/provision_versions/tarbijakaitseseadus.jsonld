      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "TarbKS_Par_44 (redaktsioon 13329511)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329511",
