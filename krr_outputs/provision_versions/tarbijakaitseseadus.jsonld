      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse alusel Tarbijakaitse ja Tehnilise Järelevalve Ametile esitatavad andmed ja dokumendid kantakse seadme ohutuse seaduse § 12 alusel loodud Tarbijakaitse ja Tehnilise Järelevalve Ameti järelevalve infosüsteemi.",
      "rdfs:label": {
        "@value": "TarbKS_Par_21_1 (redaktsioon 110022023033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110022023033",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110022023033",
