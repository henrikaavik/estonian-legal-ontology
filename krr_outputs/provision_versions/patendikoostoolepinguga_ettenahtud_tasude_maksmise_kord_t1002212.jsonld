      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Patendikoostöölepinguga ettenähtud tasude maksmise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Patendikoostöölepinguga ettenähtud tasude maksmise kord"
    },
    {
      "@id": "estleg:Reg_1002212_Par_1_v1002212",
      "@type": [
        "owl:NamedIndividual",
