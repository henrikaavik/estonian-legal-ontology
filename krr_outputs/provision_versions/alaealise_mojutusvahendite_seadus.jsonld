      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seadus jõustub 1998. aasta 1. septembril. (2) Käesoleva seaduse §-s 28 sätestatud lastekaitseseaduse muutmine jõustub 10. päeval pärast seaduse Riigi Teatajas avaldamist.",
      "rdfs:label": {
        "@value": "AMVS_Par_30 (redaktsioon 184463)",
        "@language": "et"
      },
