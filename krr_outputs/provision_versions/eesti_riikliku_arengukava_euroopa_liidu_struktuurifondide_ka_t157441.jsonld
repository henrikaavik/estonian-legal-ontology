      }
    },
    {
      "@id": "estleg:Reg_157441_Par_4_v157441",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157441_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Nooreks ettevõtjaks loetakse füüsilisest isikust ettevõtjat, kes ei ole § 3 lõikes 1 nimetatud tegevusalal tegutsenud kauem kui toetuse taotluse esitamisele vahetult eelnenud viis kalendriaastat ning kes ei ole toetuse taotlemisele vahetult eelnenud kalendriaasta 31. detsembri seisuga vanem kui 39-aastane. Nooreks ettevõtjaks loetakse füüsilisest isikust ettevõtjat, kes ei ole § 3 lõikes 1 nimetatud tegevusalal tegutsenud kauem kui toetuse taotluse esitamisele vahetult eelnenud viis kalendriaastat ning kes ei ole toetuse taotlemisele vahetult eelnenud kalendriaasta 31. detsembri seisuga vanem kui 39-aastane. 2(2)Noore ettevõtja kohta sätestatut kohaldatakse ka äriühingule, kes ei ole § 3 lõikes 1 nimetatud tegevusalal tegutsenud kauem kui toetuse taotluse esitamisele vahetult eelnenud viis kalendriaastat ning kelle kõik osad või aktsiad kuuluvad füüsilisest isikust osanikule või aktsionärile, kes ei olnud toetuse taotlemisele vahetult eelnenud kalendriaasta 31. detsembri seisuga vanem kui 39-aastane. Noore ettevõtja kohta sätestatut kohaldatakse ka äriühingule, kes ei ole § 3 lõikes 1 nimetatud tegevusalal tegutsenud kauem kui toetuse taotluse esitamisele vahetult eelnenud viis kalendriaastat ning kelle kõik osad või aktsiad kuuluvad füüsilisest isikust osanikule või aktsionärile, kes ei olnud toetuse taotlemisele vahetult eelnenud kalendriaasta 31. detsembri seisuga vanem kui 39-aastane.",
      "rdfs:label": {
        "@value": "Reg_157441_Par_4 (redaktsioon 157441)",
        "@language": "et"
      },
