      "estleg:provisionRef": "Reg_157441 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157441_Map"
      }
    },
    {
      "@id": "estleg:Reg_157441_Par_5_v157441",
      "@type": [
        "owl:NamedIndividual",
