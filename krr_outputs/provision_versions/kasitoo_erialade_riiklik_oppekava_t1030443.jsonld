      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030443_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õppekava moodulite õpiväljundite saavutamisel täismahus omandatakse kutsele „Sepp, tase 4” vastavad kompetentsid. Õppekava moodulite õpiväljundite saavutamisel täismahus omandatakse kutsele „Sepp, tase 4” vastavad kompetentsid.",
      "rdfs:label": {
        "@value": "Reg_1030443_Par_19 (redaktsioon 1030443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030443",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030443",
      "estleg:sourceAct": "Käsitöö erialade riiklik õppekava",
