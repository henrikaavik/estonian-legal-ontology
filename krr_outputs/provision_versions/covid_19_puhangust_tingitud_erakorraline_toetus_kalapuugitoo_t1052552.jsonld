    {
      "@id": "estleg:Reg_1052552_Par_11_v1052552",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052552_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-09-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maaeluministri 16. märtsi 2021. a määrust nr 30 „2021. aastal antava kalamajandusliku riigiabi, kalamajandusliku vähese tähtsusega abi ja muu kalamajandusliku abi liigid” täiendatakse punktiga 3 järgmises sõnastuses:„3) COVID-19 puhangust tingitud erakorralist toetust kalapüügitoodete töötlemisega tegelevale ettevõtjale.”. Maaeluministri 16. märtsi 2021. a määrust nr 30 „2021. aastal antava kalamajandusliku riigiabi, kalamajandusliku vähese tähtsusega abi ja muu kalamajandusliku abi liigid” täiendatakse punktiga 3 järgmises sõnastuses:„3) COVID-19 puhangust tingitud erakorralist toetust kalapüügitoodete töötlemisega tegelevale ettevõtjale.”.",
      "rdfs:label": {
        "@value": "Reg_1052552_Par_11 (redaktsioon 1052552)",
        "@language": "et"
      },
