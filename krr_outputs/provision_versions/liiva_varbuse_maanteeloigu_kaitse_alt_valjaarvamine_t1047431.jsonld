      },
      "estleg:versionText": "Looduskaitselise otstarbekuse puudumise tõttu arvatakse looduskaitse alt välja Põlva maakonnas Põlva ja Kanepi valla territooriumil asuv Liiva-Varbuse maanteelõik (KLO1200114). Looduskaitselise otstarbekuse puudumise tõttu arvatakse looduskaitse alt välja Põlva maakonnas Põlva ja Kanepi valla territooriumil asuv Liiva-Varbuse maanteelõik (KLO1200114).",
      "rdfs:label": {
        "@value": "Reg_1047431_Par_1 (redaktsioon 1047431)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047431",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047431",
      "estleg:sourceAct": "Liiva-Varbuse maanteelõigu kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1047431 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047431_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047431_Par_2_v1047431",
