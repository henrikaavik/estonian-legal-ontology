    {
      "@id": "estleg:Reg_1047431_Par_5_v1047431",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047431_Par_5"
