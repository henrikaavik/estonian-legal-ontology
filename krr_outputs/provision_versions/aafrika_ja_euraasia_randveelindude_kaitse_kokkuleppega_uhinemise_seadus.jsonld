      "dc:source": "Aafrika ja Euraasia rändveelindude kaitse kokkuleppega ühinemise seadus"
    },
    {
      "@id": "estleg:aafrika_ja_euraasia_randveelindude_kaits_Par_1_v216012024009",
      "@type": [
