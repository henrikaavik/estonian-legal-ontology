      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "OHVRIA_Par_70 (redaktsioon 109072026045)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109072026045",
