      }
    },
    {
      "@id": "estleg:OHVRIA_Par_11_v106012023001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OHVRIA_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohvriabi vahetult osutavad isikud ja käesoleva seaduse § 10 alusel infot saanud isikud peavad hoidma konfidentsiaalsena neile ohvriabi osutamisel teatavaks saanud andmeid ohvri ja juhtunuga vahetult seotud isikute kohta, kui seaduses või kokkuleppel ohvriga ei ole ette nähtud teisiti.",
      "rdfs:label": {
        "@value": "OHVRIA_Par_11 (redaktsioon 106012023001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106012023001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106012023001",
      "estleg:sourceAct": "Ohvriabi seadus",
      "estleg:provisionRef": "OHVRIA § 11",
      "estleg:partOfAct": {
        "@id": "estleg:OHVRIA_Map"
      }
    },
    {
      "@id": "estleg:OHVRIA_Par_12_v113122013019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OHVRIA_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ohvri ravikulud on tema ravimise ning ravimite ja keha funktsioone asendavate abivahendite soetamise, traumajärgsete tüsistuste kergendamise ja tervislikule seisundile kohase uue eriala õpetamisega seotud hädavajalikud kulutused ning eespool nimetatud asjaoludega seotud hädavajalikud sõidukulud. (2) Ohvri ravikulude hulka loetakse ka järgmiste teenuste kasutamiseks tehtud kulutused: 1) psühholoogiline nõustamine kuni 10 seanssi; 2) psühhoteraapia kuni 15 seanssi. (3) Ohvri ravikulud hüvitatakse isikule, kes on neid kulusid kandnud.",
      "rdfs:label": {
        "@value": "OHVRIA_Par_12 (redaktsioon 113122013019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113122013019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113122013019",
      "estleg:sourceAct": "Ohvriabi seadus",
      "estleg:provisionRef": "OHVRIA § 12",
