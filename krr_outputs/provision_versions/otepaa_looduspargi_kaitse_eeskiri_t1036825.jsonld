      "estleg:versionValidFrom": {
        "@value": "2016-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades määruses sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine. Sihtkaitsevööndis on keelatud, arvestades määruses sätestatud erisusi: majandustegevus; loodusvarade kasutamine.",
      "rdfs:label": {
        "@value": "Reg_1036825_Par_12 (redaktsioon 1036825)",
        "@language": "et"
      },
