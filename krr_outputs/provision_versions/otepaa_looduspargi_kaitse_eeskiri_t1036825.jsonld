      },
      "estleg:versionValidFrom": {
        "@value": "2016-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 2. septembri 2014. a käskkirjaga nr 659 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas6. Määruse menetlus viidi läbi keskkonnaministri 2. septembri 2014. a käskkirjaga nr 659 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas6.",
      "rdfs:label": {
        "@value": "Reg_1036825_Par_23 (redaktsioon 1036825)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036825",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036825",
      "estleg:sourceAct": "Otepää looduspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1036825 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036825_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036825_Par_24_v1036825",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036825_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1036825_Par_24 (redaktsioon 1036825)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036825",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036825",
      "estleg:sourceAct": "Otepää looduspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1036825 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036825_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036825_Par_3_v1036825",
      "@type": [
        "owl:NamedIndividual",
