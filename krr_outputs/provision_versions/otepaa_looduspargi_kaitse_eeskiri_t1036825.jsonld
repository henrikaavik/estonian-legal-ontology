        "@value": "2016-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1036825_Par_3 (redaktsioon 1036825)",
        "@language": "et"
      },
