    {
      "@id": "estleg:Reg_1049951_Par_2_v1049951",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049951_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetust antakse Euroopa Parlamendi ja nõukogu määruse (EL) nr 508/2014 Euroopa Merendus- ja Kalandusfondi kohta ja millega tunnistatakse kehtetuks nõukogu määrused (EÜ) nr 2328/2003, (EÜ) nr 861/2006, (EÜ) nr 1198/2006 ja (EÜ) nr 791/2007 ning Euroopa Parlamendi ja nõukogu määrus (EL) nr 1255/2011 (ELT L 149, 20.05.2014, lk 1–66), artikli 55 lõike 1 punktis b nimetatud vormis. Toetust antakse Euroopa Parlamendi ja nõukogu määruse (EL) nr 508/2014 Euroopa Merendus- ja Kalandusfondi kohta ja millega tunnistatakse kehtetuks nõukogu määrused (EÜ) nr 2328/2003, (EÜ) nr 861/2006, (EÜ) nr 1198/2006 ja (EÜ) nr 791/2007 ning Euroopa Parlamendi ja nõukogu määrus (EL) nr 1255/2011 (ELT L 149, 20.05.2014, lk 1–66), artikli 55 lõike 1 punktis b nimetatud vormis.",
      "rdfs:label": {
        "@value": "Reg_1049951_Par_2 (redaktsioon 1049951)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049951",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049951",
      "estleg:sourceAct": "Vesiviljelusettevõtja müügikäibe vähenemise osalise hüvitamise toetus",
      "estleg:provisionRef": "Reg_1049951 § 2",
