      "estleg:versionValidFrom": {
        "@value": "2024-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kalapüügiseaduse § 12 lõikes 4 nimetatud volikirjas peab olema märgitud volitaja ja volitatava ees- ja perekonnanimi, isikukood, posti- ja e-postiaadress, telefoninumber, kalapüügivahendi märgistus, asukoht, püügilt eemaldamise kuupäev ning volitaja allkiri. Kalapüügiseaduse § 12 lõikes 4 nimetatud volikirjas peab olema märgitud volitaja ja volitatava ees- ja perekonnanimi, isikukood, posti- ja e-postiaadress, telefoninumber, kalapüügivahendi märgistus, asukoht, püügilt eemaldamise kuupäev ning volitaja allkiri.",
      "rdfs:label": {
