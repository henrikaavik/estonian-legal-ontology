      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kalastuskaardi taotlemise ja andmise kord, tähtajad, nõuded püügivahendi püügilt eemaldamiseks tehtava volikirja kohta ja volitamisest teavitamise kord, harrastuskalapüügi andmete esitamise kord ning harrastuskalapüügiõiguse tasu ja harrastuskalapüügiõiguse eest tasumise ning tasu maksmise kontrollimise kord (13 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kalastuskaardi taotlemise ja andmise kord, tähtajad, nõuded püügivahendi püügilt eemaldamiseks tehtava volikirja kohta ja volitamisest teavitamise kord, harrastuskalapüügi andmete esitamise kord ning harrastuskalapüügiõiguse tasu ja harrastuskalapüügiõiguse eest tasumise ning tasu maksmise kontrollimise kord"
    },
    {
      "@id": "estleg:Reg_1030047_Par_1_v1030047",
