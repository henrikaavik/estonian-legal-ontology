    {
      "@id": "estleg:Reg_1030047_Par_6_v1030047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030047_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Keskkonnaametit teavitatakse (Häirekeskuse) telefonil 1247 püügivahendi eemaldamise volitamisest üks tund enne veekogule minekut. RT I 2022-05-17 14 117052022014 2022-05-20 Keskkonnaametit teavitatakse (Häirekeskuse) telefonil 1247 püügivahendi eemaldamise volitamisest üks tund enne veekogule minekut. 2 (2) Keskkonnaametile esitatakse: RT I 2020-12-18 2 118122020002 2021-01-01 1 1) volitaja ees- ja perekonnanimi, isikukood ja telefoninumber; 2 2) volitatava ees- ja perekonnanimi, isikukood ja telefoninumber; 3 3) kalapüügivahendi asukoht; 4 4) lähtekoht kust suundutakse veekogule. Keskkonnaametile esitatakse: volitaja ees- ja perekonnanimi, isikukood ja telefoninumber; volitatava ees- ja perekonnanimi, isikukood ja telefoninumber; kalapüügivahendi asukoht; lähtekoht kust suundutakse veekogule.",
      "rdfs:label": {
        "@value": "Reg_1030047_Par_6 (redaktsioon 1030047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030047",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030047",
      "estleg:sourceAct": "Kalastuskaardi taotlemise ja andmise kord, tähtajad, nõuded püügivahendi püügilt eemaldamiseks tehtava volikirja kohta ja volitamisest teavitamise kord, harrastuskalapüügi andmete esitamise kord ning harrastuskalapüügiõiguse tasu ja harrastuskalapüügiõiguse eest tasumise ning tasu maksmise kontrollimise kord",
      "estleg:provisionRef": "Reg_1030047 § 6",
