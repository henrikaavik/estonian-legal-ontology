      ],
      "estleg:versionOf": {
        "@id": "estleg:MASINA_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registreerimismenetlusele kohaldatakse majandustegevuse registri seaduses sätestatut, arvestades käesolevast seadusest tulenevaid erisusi. (2) Lisaks majandustegevuse registri seaduses sätestatule avaldatakse majandustegevuse registris ettevõtja kohta käesoleva seaduse § 28 lõike 2 punktides 2–5 nimetatud andmed, §-s 37 nimetatud ettekirjutuse olemasolu korral andmed ettekirjutuse kohta ja muud seadusega sätestatud andmed.",
      "rdfs:label": {
        "@value": "MASINA_Par_29 (redaktsioon 12894941)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894941",
      "estleg:supersededByVersion": {
        "@id": "estleg:MASINA_Par_29_v12971197"
      },
      "estleg:versionValidTo": {
        "@value": "2008-06-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12894941",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 29",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_29_v12971197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MASINA_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registreerimismenetlusele kohaldatakse majandustegevuse registri seaduses sätestatut, arvestades käesolevast seadusest tulenevaid erisusi. (2) Lisaks majandustegevuse registri seaduses sätestatule avaldatakse majandustegevuse registris ettevõtja kohta käesoleva seaduse § 28 lõike 2 punktides 2–5 ja lõike 21 punktis 2 nimetatud andmed, §-s 37 nimetatud ettekirjutuse olemasolu korral andmed ettekirjutuse kohta ja muud seadusega sätestatud andmed.",
      "rdfs:label": {
        "@value": "MASINA_Par_29 (redaktsioon 12971197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12971197",
      "estleg:supersededByVersion": {
        "@id": "estleg:MASINA_Par_29_v13254924"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12971197",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 29",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_29_v13254924",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MASINA_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ettevõtjal, kes tegutseb teavitatud asutusena, tehnilise kontrolli teostajana või personali sertifitseerimisasutusena, peab olema vastutuskindlustus kindlustussumma ulatuses, mis: tagab tema tegevuses teavitatud asutusena, tehnilise kontrolli teostajana või personali sertifitseerijana kolmandale isikule tekkida võiva kahju hüvitamise; on teavitatud asutuse ja tehnilise kontrolli teostaja puhul vähemalt 1 000 000 krooni ja personali sertifitseerijana tegutsemise puhul vähemalt 100 000 krooni. (2) Kui kindlustusleping on sõlmitud omavastutusega, hüvitab kindlustusandja tekitatud kahju kogu ulatuses ja nõuab omavastutuse summa tagasi kindlustusvõtjalt.",
      "rdfs:label": {
        "@value": "MASINA_Par_29 (redaktsioon 13254924)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13254924",
      "estleg:supersededByVersion": {
        "@id": "estleg:MASINA_Par_29_v13329267"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13254924",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 29",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_29_v13329267",
