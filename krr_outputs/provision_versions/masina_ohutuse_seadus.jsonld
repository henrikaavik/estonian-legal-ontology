        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/729235",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 29",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_29_v12894941",
