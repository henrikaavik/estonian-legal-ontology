      }
    },
    {
      "@id": "estleg:MASINA_Par_15_v227008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MASINA_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Masina kasutamise järelevaataja peab: tagama, et masinat kasutataks käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete kohaselt; tagama, et masina kasutamine peatataks, kui selle edasine kasutamine võib ohustada inimese tervist, ohutust või vara; tagama, et masina paigaldust, remonti ja ümberehitust ning tehnohooldust teeks ja masinaga töötaks pädev isik; tagama, et esimesel võimalusel teatataks masinaga toimunud avariist ja sellega kaasnenud õnnetusjuhtumist Tehnilise Järelevalve Inspektsioonile; olema kättesaadav masina ohutuse tagamiseks ja tehnilise kontrolli ning riiklike järelevalvetoimingute teostamisel.",
      "rdfs:label": {
        "@value": "MASINA_Par_15 (redaktsioon 227008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "227008",
      "estleg:supersededByVersion": {
        "@id": "estleg:MASINA_Par_15_v12894941"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/227008",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 15",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_15_v12894941",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MASINA_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Masina kasutamise järelevaataja peab: tagama, et masinat kasutataks käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete kohaselt; tagama, et masina kasutamine peatataks, kui selle edasine kasutamine võib ohustada inimese tervist, ohutust või vara; tagama, et masina paigaldust, remonti ja ümberehitust ning tehnohooldust teeks ja masinaga töötaks pädev isik; tagama, et esimesel võimalusel teatataks masinaga toimunud avariist ja sellega kaasnenud õnnetusjuhtumist Tehnilise Järelevalve Ametile; olema kättesaadav masina ohutuse tagamiseks ja tehnilise kontrolli ning riiklike järelevalvetoimingute teostamisel.",
      "rdfs:label": {
        "@value": "MASINA_Par_15 (redaktsioon 12894941)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894941",
      "estleg:supersededByVersion": {
        "@id": "estleg:MASINA_Par_15_v13254924"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12894941",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 15",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_15_v13254924",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MASINA_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Masina paigaldamine käesoleva seaduse tähenduses on turule lastud masina kokkupanek või ülesseadmine kohas, kus masinat kasutatakse. (2) Masin tuleb paigaldada viisil, mis võimaldab seda ohutult kasutada, kontrollida, remontida ja hooldada. (3) Masina ehitisse paigaldaja peab välja selgitama, kas masina paigaldamisega ei teki ohtu inimese tervisele, ohutusele ja varale, ning kooskõlastama masina paigaldamise ehitise omanikuga. (4) Kui masina ehitisse paigaldamine on ehitamine ehitusseaduse mõistes, peab masina paigaldaja lisaks käesolevas peatükis sätestatud nõuetele täitma ehitusseaduse nõudeid. (5) Kõrgendatud ohtu kätkev masin tuleb paigaldada tehnilise kontrolli teostaja poolt heakskiidetud paigaldusprojekti alusel. Loetelu sellistest masinatest kehtestatakse käesoleva paragrahvi lõike 7 alusel. (6) Masina paigaldusprojekt peab tagama masina ohutu paigaldamise, ohutu kasutamise pärast paigaldamist ning registreeritava masina puhul ka tehnilise kontrolli teostajale võimaluse hinnata masina paigaldamise ja paigaldatud masina kasutamise ohutust. (7) Loetelu masinatest, mille paigaldamine on lubatud tehnilise kontrolli teostaja poolt heakskiidetud paigaldusprojekti alusel, nõuded paigaldusprojektile ning paigaldusprojekti heakskiitmise korra",
      "rdfs:label": {
        "@value": "MASINA_Par_15 (redaktsioon 13254924)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13254924",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13254924",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 15",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_16_v173441",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MASINA_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete rikkumise ning defektiga masina ja ohutusseadise turule laskmise eest kannab tootja või tarnija vastutust toote ohutuse seaduse 5. peatüki sätete kohaselt, rakendades käesolevas paragrahvis sätestatud trahvimäärasid. (2) Juriidilise isiku haldusvastutus: järelevalveametniku ettekirjutuse täitmata jätmise eest määratakse rahatrahv 10 000 kuni 200 000 krooni; turujärelevalveasutuse otsuse täitmata jätmise eest määratakse rahatrahv 10 000 kuni 600 000 krooni.",
      "rdfs:label": {
        "@value": "MASINA_Par_16 (redaktsioon 173441)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "173441",
      "estleg:supersededByVersion": {
        "@id": "estleg:MASINA_Par_16_v190050"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/173441",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 16",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_16_v190050",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
