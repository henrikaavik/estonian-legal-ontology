      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Masina käitaja käesoleva seaduse tähenduses on operaator, masinist või juht või muu füüsiline isik, kes vahetult juhib masinat, millega töötamiseks nõutakse pädevustunnistust. (2) Masina käitaja peab olema vähemalt 18-aastane ja tal peavad olema tööks vajalikud teadmised ja oskused. (3) Masina käitaja peab olema sooritanud eksami vastaval erialal töötamiseks. Masina käitaja erialaeksami komisjoni peab kuuluma käesoleva seaduse §-s 26 nimetatud isiku esindaja, kes annab allkirja masina käitamisoskust tõendavale pädevustunnistusele. (4) Loetelu masinatest, mille käitajalt nõutakse pädevustunnistust, kehtestab majandus- ja kommunikatsiooniminister.",
      "rdfs:label": {
        "@value": "MASINA_Par_16 (redaktsioon 227008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "227008",
      "estleg:supersededByVersion": {
        "@id": "estleg:MASINA_Par_16_v828981"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/227008",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 16",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_16_v828981",
