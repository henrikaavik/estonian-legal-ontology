      }
    },
    {
      "@id": "estleg:MASINA_Par_3_v173441",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MASINA_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Masinat või ohutusseadist ei tohi turule lasta või kasutusele võtta, kui see ei vasta ohutusnõuetele ja kui ei ole järgitud käesoleva seaduse 2. peatükis sätestatud nõuetele vastavuse tõendamise korda. (2) Masinat või ohutusseadist, mis ei vasta ohutusnõuetele ja mille puhul ei ole järgitud nõuetele vastavuse tõendamise korda, võib esitleda messidel, näitustel, demonstratsioonidel ja teistel avalikel esitlustel tingimusel, et selle juures on selgelt nähtav silt, mis teavitab, et masin või ohutusseadis ei vasta kehtestatud ohutusnõuetele ja seda ei lasta turule enne, kui see on ohutusnõuetele vastavaks muudetud. Esitluse ajal peab masina või ohutusseadise esitleja tagama inimeste ohutuse.",
      "rdfs:label": {
        "@value": "MASINA_Par_3 (redaktsioon 173441)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "173441",
      "estleg:supersededByVersion": {
        "@id": "estleg:MASINA_Par_3_v173535"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/173441",
      "estleg:sourceAct": "Masina ohutuse seadus",
      "estleg:provisionRef": "MASINA § 3",
      "estleg:partOfAct": {
        "@id": "estleg:MASINA_Map"
      }
    },
    {
      "@id": "estleg:MASINA_Par_3_v173535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MASINA_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Masinat või ohutusseadist ei tohi turule lasta või kasutusele võtta, kui see ei vasta ohutusnõuetele ja kui ei ole järgitud käesoleva seaduse 2. peatükis sätestatud nõuetele vastavuse tõendamise korda. (2) Masinat või ohutusseadist, mis ei vasta ohutusnõuetele ja mille puhul ei ole järgitud nõuetele vastavuse tõendamise korda, võib esitleda messidel, näitustel, demonstratsioonidel ja teistel avalikel esitlustel tingimusel, etsellejuures on selgelt nähtav silt, mis teavitab, et masin või ohutusseadis ei vasta kehtestatud ohutusnõuetele ja seda ei lasta turule enne, kui see on ohutusnõuetele vastavaks muudetud. Esitluse ajal peab masina või ohutusseadise esitleja tagama inimeste ohutuse.",
      "rdfs:label": {
        "@value": "MASINA_Par_3 (redaktsioon 173535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "173535",
