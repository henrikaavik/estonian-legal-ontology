  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_pusiasustusega_vaikesaarte_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Püsiasustusega väikesaarte seadus (51 versiooni)",
        "@language": "et"
      },
      "dc:source": "Püsiasustusega väikesaarte seadus"
    },
    {
      "@id": "estleg:VSaarS_Par_1_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab erisused, mis tulenevad püsiasustusega väikesaarte saareliste tingimuste eripärast ning ei ole sätestatud teiste seadustega.",
      "rdfs:label": {
        "@value": "VSaarS_Par_1 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923"
    },
    {
      "@id": "estleg:VSaarS_Par_10_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väikesaarel peab ööpäevaringselt olema elanike avalikus kasutuses avariiside, et telefoniühenduse katkemise korral edastada elutähtsaid teateid. (2) Riik peab tagama väikesaare varustamise elektrienergiaga. Asustuse eriiseloomust tulenevad lisakulutused kompenseeritakse Vabariigi Valitsuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "VSaarS_Par_10 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923"
    },
    {
      "@id": "estleg:VSaarS_Par_11_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väikesaare korrakaitse ja päästeteenistuse tegevuskava koostamisel kuulatakse ära väikesaare üldkogu arvamus.",
      "rdfs:label": {
        "@value": "VSaarS_Par_11 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_11_v13326355"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_11_v13326355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väikesaare politsei- ja päästeasutuste tegevuskava koostamisel kuulatakse ära väikesaare üldkogu arvamus.",
      "rdfs:label": {
        "@value": "VSaarS_Par_11 (redaktsioon 13326355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326355"
    },
    {
      "@id": "estleg:VSaarS_Par_11_1_v12808278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_11_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väikesaarel looduskaitseseaduse, muinsuskaitseseaduse, jäätmeseaduse ja teiste seaduste ning kohaliku omavalitsuse õigusaktide täitmise tagamiseks ja nimetatud õigusaktidest tulenevate nõuete rikkumisest teavitamiseks võib ametisse nimetada saarevahi. Saarevahi nimetab ametisse maavanem väikesaart või saarterühma haldava kohaliku omavalitsuse ettepanekul.",
      "rdfs:label": {
        "@value": "VSaarS_Par_11_1 (redaktsioon 12808278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12808278",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_11_1_v120122017004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_11_1_v120122017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_11_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väikesaarel looduskaitseseaduse, muinsuskaitseseaduse, jäätmeseaduse ja teiste seaduste ning kohaliku omavalitsuse üksuse õigusaktide täitmise tagamiseks ja nimetatud õigusaktidest tulenevate nõuete rikkumisest teavitamiseks võib kohaliku omavalitsuse üksuse volikogu moodustada saarevahi ametikoha.",
      "rdfs:label": {
        "@value": "VSaarS_Par_11_1 (redaktsioon 120122017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122017004"
    },
    {
      "@id": "estleg:VSaarS_Par_12_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigieelarvest eraldatakse saarvaldade ja saarelise osaga valdade eelarvetesse täiendavad vahendid",
      "rdfs:label": {
        "@value": "VSaarS_Par_12 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_12_v13326355"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_12_v13326355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigieelarvest eraldatakse saarvaldade ja saarelise osaga valdade eelarvetesse täiendavad vahendid korras.",
      "rdfs:label": {
        "@value": "VSaarS_Par_12 (redaktsioon 13326355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326355",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_12_v130062015055"
      },
      "estleg:versionValidTo": {
        "@value": "2015-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_12_v130062015055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigieelarvest eraldatakse saarvaldade ja saarelise osaga valdade eelarvetesse täiendavad vahendid kehtestatud korras.",
      "rdfs:label": {
        "@value": "VSaarS_Par_12 (redaktsioon 130062015055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062015055",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_12_v120122017004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_12_v120122017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Püsiasustusega väikesaarte saarelisusest tingitud täiendav arvestuslik kuluvajadus võetakse arvesse riigieelarve seaduse § 47 lõikes 2 nimetatud tasandusfondi valemis kohaliku omavalitsuse üksuse tulusid mitte arvestades. (2) Kohaliku omavalitsuse üksusele arvestatakse käesoleva paragrahvi lõikes 1 nimetatud täiendav kuluvajadus väikesaare nimistusse arvamise aastale järgnevast eelarveaastast. (3) Kohaliku omavalitsuse üksusele käesoleva paragrahvi lõikes 1 nimetatud täiendava kuluvajaduse arvestamine lõpetatakse väikesaare nimistust väljaarvamisele järgnevast eelarveaastast. ; § 12 lõikeid 2 ja 3 rakendatakse esmakordselt 2019. aastal kinnitatava väikesaarte nimistu suhtes.",
      "rdfs:label": {
        "@value": "VSaarS_Par_12 (redaktsioon 120122017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122017004"
    },
    {
      "@id": "estleg:VSaarS_Par_13_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi regionaalse arengu programmides tuleb ette näha vahendid majandustegevuse toetamiseks väikesaartel riiklike sihtotstarbeliste investeeringute, laenusoodustuste ja laenude garanteerimise kaudu.",
      "rdfs:label": {
        "@value": "VSaarS_Par_13 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923"
    },
    {
      "@id": "estleg:VSaarS_Par_14_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riik toetab väikesaarte looduskeskkonna ja maastikuilme taastamisele, säilitamisele ja parandamisele suunatud tegevust riigieelarvest selleks ettenähtud programmide kaudu. (2) Käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmiseks korraldab tegevuskava koostamist, selles vajaduse korral muudatuste tegemist ja selle elluviimist Keskkonnaministeerium.",
      "rdfs:label": {
        "@value": "VSaarS_Par_14 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_14_v130062023060"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_14_v130062023060",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riik toetab väikesaarte looduskeskkonna ja maastikuilme taastamisele, säilitamisele ja parandamisele suunatud tegevust riigieelarvest selleks ettenähtud programmide kaudu. (2) Käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmiseks korraldab tegevuskava koostamist, selles vajaduse korral muudatuste tegemist ja selle elluviimist Kliimaministeerium.",
      "rdfs:label": {
        "@value": "VSaarS_Par_14 (redaktsioon 130062023060)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023060"
    },
    {
      "@id": "estleg:VSaarS_Par_14_1_v12808278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_14_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saarvalla või saarelise osaga valla kohalikul omavalitsusel on väikesaarel asuva kinnisasja ostueesõigus. (2) Kohalikul omavalitsusel ei ole ostueesõigust, kui asi võõrandatakse abikaasale, alanejale sugulasele või vanemale, samuti vennale, õele ja nende alanejatele sugulastele. (3) Kohaliku omavalitsuse ühepoolse lihtkirjaliku avalduse alusel kantakse kinnistusraamatusse märkus selle kohta, et kinnistu on koormatud käesoleva paragrahvi lõikes 2 nimetatud ostueesõigusega. Avalduses ja märkuse kandes tuleb viidata käesolevale paragrahvile. (4) Kui kinnistusraamatu kandest nähtub, et kinnisasi on koormatud ostueesõigusega käesoleva paragrahvi tähenduses, saadab notar poolte kulul viie tööpäeva jooksul pärast võõrandamislepingu tõestamist lepingu koopia ostueesõiguse teostamiseks võõrandatava kinnisasja asukohajärgsele kohalikule omavalitsusele.",
      "rdfs:label": {
        "@value": "VSaarS_Par_14_1 (redaktsioon 12808278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12808278",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_14_1_v120122017003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_14_1_v120122017003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_14_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saarvallal või saarelise osaga kohaliku omavalitsuse üksusel on väikesaarel asuva kinnisasja ostueesõigus. (2) Kohalikul omavalitsusel ei ole ostueesõigust, kui asi võõrandatakse abikaasale, alanejale sugulasele või vanemale, samuti vennale, õele ja nende alanejatele sugulastele. (3) Kohaliku omavalitsuse ühepoolse lihtkirjaliku avalduse alusel kantakse kinnistusraamatusse märkus selle kohta, et kinnistu on koormatud käesoleva paragrahvi lõikes 2 nimetatud ostueesõigusega. Avalduses ja märkuse kandes tuleb viidata käesolevale paragrahvile. (4) Kui kinnistusraamatu kandest nähtub, et kinnisasi on koormatud ostueesõigusega käesoleva paragrahvi tähenduses, saadab notar poolte kulul viie tööpäeva jooksul pärast võõrandamislepingu tõestamist lepingu koopia ostueesõiguse teostamiseks võõrandatava kinnisasja asukohajärgsele kohalikule omavalitsusele.",
      "rdfs:label": {
        "@value": "VSaarS_Par_14_1 (redaktsioon 120122017003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122017003",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_14_1_v106072023070"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_14_1_v106072023070",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_14_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saarvallal või saarelise osaga kohaliku omavalitsuse üksusel on väikesaarel asuva kinnisasja ostueesõigus. (2) Kohalikul omavalitsusel ei ole ostueesõigust, kui asi võõrandatakse abikaasale, registreeritud elukaaslasele, alanejale sugulasele või vanemale, samuti vennale, õele ja nende alanejatele sugulastele. (3) Kohaliku omavalitsuse ühepoolse lihtkirjaliku avalduse alusel kantakse kinnistusraamatusse märkus selle kohta, et kinnistu on koormatud käesoleva paragrahvi lõikes 2 nimetatud ostueesõigusega. Avalduses ja märkuse kandes tuleb viidata käesolevale paragrahvile. (4) Kui kinnistusraamatu kandest nähtub, et kinnisasi on koormatud ostueesõigusega käesoleva paragrahvi tähenduses, saadab notar poolte kulul viie tööpäeva jooksul pärast võõrandamislepingu tõestamist lepingu koopia ostueesõiguse teostamiseks võõrandatava kinnisasja asukohajärgsele kohalikule omavalitsusele.",
      "rdfs:label": {
        "@value": "VSaarS_Par_14_1 (redaktsioon 106072023070)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023070"
    },
    {
      "@id": "estleg:VSaarS_Par_14_2_v120122017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_14_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) 2018. aastal kinnitatavasse väikesaarte nimistusse arvatakse lisaks käesoleva seaduse §-s 21 sätestatud tingimustele vastavatele väikesaartele ka kõik käesoleva seaduse kuni 2018. aasta 1. jaanuarini kehtinud redaktsiooni § 2 punktis 3 nimetatud väikesaared. Alates 2019. aastast kinnitatakse nimistusse vaid käesoleva seaduse §-s 21 sätestatud tingimustele vastavad väikesaared. (2) Käesoleva seaduse § 12 lõikeid 2 ja 3 rakendatakse esmakordselt 2019. aastal kinnitatava väikesaarte nimistu suhtes.",
      "rdfs:label": {
        "@value": "VSaarS_Par_14_2 (redaktsioon 120122017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122017004"
    },
    {
      "@id": "estleg:VSaarS_Par_15_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse korralduse seaduse § 1 täiendatakse lõikega 1 1 järgmises sõnastuses: « (1 1 ) Kohaliku omavalitsuse korralduse erisused püsiasustusega väikesaartel on sätestatud püsiasustusega väikesaarte seaduses.»",
      "rdfs:label": {
        "@value": "VSaarS_Par_15 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_15_v12808278"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_15_v12808278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "VSaarS_Par_15 (redaktsioon 12808278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12808278"
    },
    {
      "@id": "estleg:VSaarS_Par_16_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2004. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "VSaarS_Par_16 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923"
    },
    {
      "@id": "estleg:VSaarS_Par_2_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse mõisteid järgmises tähenduses: saarvald – asukohasaart või saarterühma tervikuna haldav vald; saarelise osaga vald – saarvaldade hulka mittekuuluv vald, mille koosseisus on püsiasustusega väikesaari; püsiasustusega väikesaared (edaspidi väikesaared ) – Abruka, Kihnu, Manija, Piirissaar, Prangli, Ruhnu, Vilsandi ja Vormsi; suursaared – Saaremaa, Hiiumaa ja Muhu.",
      "rdfs:label": {
        "@value": "VSaarS_Par_2 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_2_v12808278"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_2_v12808278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse mõisteid järgmises tähenduses: saarvald – püsiasustusega väikesaart või saarterühma tervikuna haldav vald; saarelise osaga vald – saarvaldade hulka mittekuuluv vald, mille koosseisus on püsiasustusega väikesaari; püsiasustusega väikesaared (edaspidi väikesaared) – Abruka, Kihnu, Kessulaid, Kõinastu, Manija, Osmussaar, Piirissaar, Prangli, Ruhnu, Vilsandi ja Vormsi; suursaared – Saaremaa, Hiiumaa ja Muhu. püsiasustus – alaliselt ja peamiselt väikesaarel elamine; püsielanik – isik, kes alaliselt ja peamiselt elab väikesaarel ja kelle elukoha andmed on kantud rahvastikuregistrisse väikesaarel asuva asustusüksuse täpsusega.",
      "rdfs:label": {
        "@value": "VSaarS_Par_2 (redaktsioon 12808278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12808278",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_2_v120122017003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_2_v120122017003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse mõisteid järgmises tähenduses: saarvald – püsiasustusega väikesaart või saarterühma tervikuna haldav vald; saarelise osaga kohaliku omavalitsuse üksus – saarvaldade hulka mittekuuluv kohaliku omavalitsuse üksus, mille koosseisus on püsiasustusega väikesaari; püsiasustusega väikesaar (edaspidi väikesaar) – alla 100 km2 suurune saar, kus elab vähemalt viis elanikku; suursaared – Saaremaa, Hiiumaa ja Muhu. püsiasustus – alaliselt ja peamiselt väikesaarel elamine; püsielanik – isik, kes alaliselt ja peamiselt elab väikesaarel ja kelle elukoha andmed on kantud rahvastikuregistrisse väikesaarel asuva asustusüksuse täpsusega.",
      "rdfs:label": {
        "@value": "VSaarS_Par_2 (redaktsioon 120122017003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122017003"
    },
    {
      "@id": "estleg:VSaarS_Par_2_1_v120122017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_2_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väikesaarte nimistusse (edaspidi nimistu) kantakse väikesaared, millel elas eelneval kalendriaastal rahvastikuregistri andmetel püsivalt kokku vähemalt viis isikut. Väikesaare vastavust käesolevas lõikes nimetatud kriteeriumile kontrollitakse iga kalendrikuu esimese kuupäeva seisuga. (2) Kui nimistusse kuuluv väikesaar ei vasta kalendriaastal vähemalt kuue kuu jooksul käesoleva paragrahvi lõikes 1 sätestatule, arvatakse ta nimistust välja. (3) Nimistu kehtestab määrusega. (4) Vabariigi Valitsus kehtestab käesoleva paragrahvi lõigete 1 ja 2 alusel tehtud nimistu muudatused hiljemalt 1. veebruaril.",
      "rdfs:label": {
        "@value": "VSaarS_Par_2_1 (redaktsioon 120122017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122017004"
    },
    {
      "@id": "estleg:VSaarS_Par_3_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi ja kohalike omavalitsuste eesmärgid püsiasustusega väikesaarte haldamisel on: püsiasustuse säilitamine ja arengusuutlikkuse toetamine; omavalitsusliku suutlikkuse toetamine; püsielanikkonnale töökohtade ja toimetulekuvõimaluste loomine; esmatähtsate avalike teenuste (korrakaitse- ja päästeteenistused, joogivesi, post- ja elektronside, elektrivarustus, transpordiühendus, alus- ja põhiharidus) kättesaadavuse tagamine; saarte elulaadi omapära ja kultuuri järjepidevuse säilitamine; väikesaartele iseloomuliku maastikuilme ja looduskeskkonna säilitamine ja kaitsmine; püsielanike tegevuse ja huvide sidumine territoriaalmere ja riigipiiri kaitse ning keskkonnahoiu riiklike vajadustega.",
      "rdfs:label": {
        "@value": "VSaarS_Par_3 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_3_v12808278"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_3_v12808278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi ja kohalike omavalitsuste eesmärgid püsiasustusega väikesaarte haldamisel on: püsiasustuse taastamine, säilitamine ja arengusuutlikkuse toetamine; omavalitsusliku suutlikkuse toetamine ja osalusdemokraatia suurendamine; püsielanikele töökohtade ja toimetulekuvõimaluste loomine ning ettevõtluse toetamine; esmatähtsate avalike teenuste (korrakaitse- ja päästeteenistused, joogivesi, post- ja elektronside, elektrivarustus, transpordiühendus, alus-, põhi- ja keskharidus, sotsiaalabi) kättesaadavuse tagamine; saarte elulaadi omapära ja rahvakultuuri järjepidevuse säilitamine; väikesaartele iseloomuliku maastikuilme ja looduskeskkonna säilitamine ja kaitsmine; püsielanike tegevuse ja huvide sidumine territoriaalmere ja riigipiiri kaitse ning keskkonnahoiu riiklike vajadustega.",
      "rdfs:label": {
        "@value": "VSaarS_Par_3 (redaktsioon 12808278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12808278",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_3_v13326355"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_3_v13326355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi ja kohalike omavalitsuste eesmärgid püsiasustusega väikesaarte haldamisel on: püsiasustuse taastamine, säilitamine ja arengusuutlikkuse toetamine; omavalitsusliku suutlikkuse toetamine ja osalusdemokraatia suurendamine; püsielanikele töökohtade ja toimetulekuvõimaluste loomine ning ettevõtluse toetamine; esmatähtsate avalike teenuste (politsei- ja päästeasutused, joogivesi, post- ja elektronside, elektrivarustus, transpordiühendus, alus-, põhi- ja keskharidus, sotsiaalabi) kättesaadavuse tagamine; saarte elulaadi omapära ja rahvakultuuri järjepidevuse säilitamine; väikesaartele iseloomuliku maastikuilme ja looduskeskkonna säilitamine ja kaitsmine; püsielanike tegevuse ja huvide sidumine territoriaalmere ja riigipiiri kaitse ning keskkonnahoiu riiklike vajadustega.",
      "rdfs:label": {
        "@value": "VSaarS_Par_3 (redaktsioon 13326355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326355"
    },
    {
      "@id": "estleg:VSaarS_Par_4_v262923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väikesaarte arenguga seonduvate küsimuste arutamiseks ja Vabariigi Valitsuse nõustamiseks väikesaartele suunatud regionaalpoliitika küsimustes moodustatakse väikesaarte komisjon (edaspidi komisjon ). (2) Komisjoni pädevuses on: seisukoha esitamine Vabariigi Valitsusele väikesaarte arengut mõjutavate programmide ja arengukavade kohta; ettepanekute esitamine Vabariigi Valitsusele ja ministeeriumidele väikesaartele suunatud riiklike programmide algatamiseks ja finantseerimiseks; seisukoha esitamine Vabariigi Valitsusele riigieelarve eelnõu kohta, lähtudes selle võimalikust mõjust väikesaarte arengule; ettepanekute esitamine Vabariigi Valitsusele seaduste muutmiseks ja täiendamiseks väikesaarte arenguga seonduvates küsimustes; ettepanekute esitamine Vabariigi Valitsusele väikesaarte liikluse ühendusteede ning nendega seotud sadamate ja sadamarajatiste määramiseks; riiklike investeeringute taotlemise koordineerimine väikesaartel; ettepanekute esitamine avaliku sektori töökohtade loomiseks väikesaartel; soovituste andmine väikesaartel tekkivate probleemide lahendamiseks ja vahendamine konfliktolukordades; muude põhimäärusega talle pandud ülesannete täitmine. (3) Komisjoni kuulub hääleõigusega regionaalpoliitika eest vastutav minister, Siseministeeriumi, Keskkonnaministeeriumi, Rahandusministeeriumi ning Majandus- ja Kommunikatsiooniministeeriumi esindaja, kaks maavanemate esindajat, üks iga käesolevas seaduses nimetatud väikesaare esindaja, üks saarte elanike huve esindavate ühingute esindaja ja kaks väikesaarte esindajate kutsutud Riigikogu liiget. Komisjoni koosseisu kinnitab Vabariigi Valitsus. (4) Komisjoni esimees on regionaalpoliitika eest vastutav minister. Komisjon valib oma liikmete hulgast aseesimehe, kes asendab esimeest tema äraolekul. Komisjoni tehnilise teenindamise tagab Siseministeerium. (5) Komisjon on otsustusvõimeline, kui kohal on vähemalt pool komisjoni koosseisust. Komisjon esitab oma ettepanekud ja seisukohad Vabariigi Valitsusele komisjoni esimehe kaudu. (6) Komisjon tegutseb põhimääruse alusel, mille",
      "rdfs:label": {
        "@value": "VSaarS_Par_4 (redaktsioon 262923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262923",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_4_v12808278"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_4_v12808278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väikesaarte arenguga seonduvate küsimuste arutamiseks ja Vabariigi Valitsuse nõustamiseks väikesaartele suunatud regionaalpoliitika küsimustes moodustatakse väikesaarte komisjon (edaspidi komisjon). (2) Komisjoni pädevuses on: seisukoha esitamine Vabariigi Valitsusele väikesaarte arengut mõjutavate programmide ja arengukavade kohta; ettepanekute esitamine Vabariigi Valitsusele ja ministeeriumidele väikesaartele suunatud riiklike programmide algatamiseks ja finantseerimiseks; seisukoha esitamine Vabariigi Valitsusele riigieelarve eelnõu kohta, lähtudes selle võimalikust mõjust väikesaarte arengule; ettepanekute esitamine Vabariigi Valitsusele seoses püsiasustusega väikesaarte nimistu täiendamisega ja püsiasustuse taastamisega; ettepanekute esitamine Vabariigi Valitsusele väikesaarte liikluse ühendusteede ning nendega seotud sadamate ja sadamarajatiste määramiseks; riiklike investeeringute taotlemise koordineerimine väikesaartel; ettepanekute esitamine avaliku sektori töökohtade loomiseks väikesaartel; soovituste andmine väikesaartel tekkivate probleemide lahendamiseks ja vahendamine konfliktolukordades; muude põhimäärusega talle pandud ülesannete täitmine. (3) Komisjoni kuulub hääleõigusega regionaalminister, Siseministeeriumi, Keskkonnaministeeriumi, Rahandusministeeriumi ning Majandus- ja Kommunikatsiooniministeeriumi esindaja, kaks maavanemate esindajat, üks iga väikesaarte nimekirja kantud saare esindaja, üks saarte elanike huve esindavate ühingute esindaja ja kolm väikesaarte esindajate kutsutud Riigikogu liiget. Komisjoni koosseisu kinnitab Vabariigi Valitsus. (4) Komisjoni esimees on regionaalpoliitika eest vastutav minister. Komisjon valib oma liikmete hulgast aseesimehe, kes asendab esimeest tema äraolekul. Komisjoni tehnilise teenindamise tagab Siseministeerium. (5) Komisjon on otsustusvõimeline, kui kohal on vähemalt pool komisjoni koosseisust. Komisjon esitab oma ettepanekud ja seisukohad Vabariigi Valitsusele komisjoni esimehe kaudu. (6) Komisjon tegutseb põhimääruse alusel, mille",
      "rdfs:label": {
        "@value": "VSaarS_Par_4 (redaktsioon 12808278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12808278",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSaarS_Par_4_v13326355"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSaarS_Par_4_v13326355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSaarS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väikesaarte arenguga seonduvate küsimuste arutamiseks ja Vabariigi Valitsuse nõustamiseks väikesaartele suunatud regionaalpoliitika küsimustes moodustatakse väikesaarte komisjon (edaspidi komisjon). (2) Komisjoni pädevuses on: seisukoha esitamine Vabariigi Valitsusele väikesaarte arengut mõjutavate programmide ja arengukavade kohta; ettepanekute esitamine Vabariigi Valitsusele ja ministeeriumidele väikesaartele suunatud riiklike programmide algatamiseks ja finantseerimiseks; seisukoha esitamine Vabariigi Valitsusele riigieelarve eelnõu kohta, lähtudes selle võimalikust mõjust väikesaarte arengule; ettepanekute esitamine Vabariigi Valitsusele seoses püsiasustusega väikesaarte nimistu täiendamisega ja püsiasustuse taastamisega; ettepanekute esitamine Vabariigi Valitsusele väikesaarte liikluse ühendusteede ning nendega seotud sadamate ja sadamarajatiste määramiseks; riiklike investeeringute taotlemise koordineerimine väikesaartel; ettepanekute esitamine avaliku sektori töökohtade loomiseks väikesaartel; soovituste andmine väikesaartel tekkivate probleemide lahendamiseks ja vahendamine konfliktolukordades; muude põhimäärusega talle pandud ülesannete täitmine. (3) Komisjoni kuulub hääleõigusega valdkonna eest vastutav minister, Siseministeeriumi, Keskkonnaministeeriumi, Rahandusministeeriumi ning Majandus- ja Kommunikatsiooniministeeriumi esindaja, kaks maavanemate esindajat, üks iga väikesaarte nimekirja kantud saare esindaja, üks saarte elanike huve esindavate ühingute esindaja ja kolm väikesaarte esindajate kutsutud Riigikogu liiget. Komisjoni koosseisu kinnitab Vabariigi Valitsus. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „regionaalminister“ sõnadega „valdkonna eest vastutav minister“. (4) Komisjoni esimees on regionaalpoliitika eest vastutav minister. Komisjon valib oma liikmete hulgast aseesimehe, kes asendab esimeest tema äraolekul. Komisjoni tehnilise teenindamise tagab Siseministeerium. (5) Komisjon on otsustusvõimeline, kui kohal on vähemalt pool komisjoni koosseisust. Komisjon esitab oma ettepanekud ja seisukohad Vabariigi Valitsusele komisjoni esimehe kaudu. (6) Komisjon tegutseb põhimääruse alusel, mille",
      "rdfs:label": {
        "@value": "VSaarS_Par_4 (redaktsioon 13326355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326355",
      "estleg:supersededByVersion": {
