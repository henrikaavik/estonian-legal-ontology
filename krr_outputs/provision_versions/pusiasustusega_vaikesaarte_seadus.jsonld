      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VSaarS_Par_9 (redaktsioon 120122017003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122017003"
    }
  ]
