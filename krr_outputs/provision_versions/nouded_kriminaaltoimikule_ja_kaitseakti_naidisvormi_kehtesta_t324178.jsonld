    {
      "@id": "estleg:Reg_324178_Par_2_v324178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324178_Par_2"
