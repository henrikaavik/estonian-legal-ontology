      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Pädeva ülema poolt riigi sõjaliseks kaitsmiseks jõu kasutamise otsustamine rahuajal (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Pädeva ülema poolt riigi sõjaliseks kaitsmiseks jõu kasutamise otsustamine rahuajal"
    },
    {
      "@id": "estleg:Reg_328930_Par_1_v328930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_328930_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega sätestatakse erandkord, mille korral ülem on rahuajal pädev otsustama jõu kasutamise alustamise väljastpoolt Eesti riigi territooriumi Eesti riigi vastu suunatud sõjalise ründe puhul. Määrusega sätestatakse erandkord, mille korral ülem on rahuajal pädev otsustama jõu kasutamise alustamise väljastpoolt Eesti riigi territooriumi Eesti riigi vastu suunatud sõjalise ründe puhul. 2 (2) Käesolev määrus käsitab sõjalise ründena sõjaliste jõudude aktiivset tegevust, mis seisneb relvade või füüsilise jõu kasutamises ja on suunatud Eesti riigi vastu. Käesolev määrus käsitab sõjalise ründena sõjaliste jõudude aktiivset tegevust, mis seisneb relvade või füüsilise jõu kasutamises ja on suunatud Eesti riigi vastu.",
      "rdfs:label": {
        "@value": "Reg_328930_Par_1 (redaktsioon 328930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "328930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/328930",
      "estleg:sourceAct": "Pädeva ülema poolt riigi sõjaliseks kaitsmiseks jõu kasutamise otsustamine rahuajal",
      "estleg:provisionRef": "Reg_328930 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_328930_Map"
      }
    },
    {
      "@id": "estleg:Reg_328930_Par_2_v328930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_328930_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseväe poolt jõu kasutamist otsustavaks pädevaks ülemaks on vahetult Eesti riigi vastu suunatud rünnet tuvastav tegevväelasest ülem või tema otsene ülem. RT I 2013-03-28 1 128032013001 2013-04-01 Kaitseväe poolt jõu kasutamist otsustavaks pädevaks ülemaks on vahetult Eesti riigi vastu suunatud rünnet tuvastav tegevväelasest ülem või tema otsene ülem. 2 (2) Ülem on sõjalist rünnet vahetult tuvastav, kui: 1 1) tema või temale vahetult alluvad kaitseväelased on sattunud sõjalise ründe alla; 2 2) ta on sõjalise ründe vahetuks tunnistajaks. Ülem on sõjalist rünnet vahetult tuvastav, kui: tema või temale vahetult alluvad kaitseväelased on sattunud sõjalise ründe alla; ta on sõjalise ründe vahetuks tunnistajaks.",
      "rdfs:label": {
        "@value": "Reg_328930_Par_2 (redaktsioon 328930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "328930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/328930",
      "estleg:sourceAct": "Pädeva ülema poolt riigi sõjaliseks kaitsmiseks jõu kasutamise otsustamine rahuajal",
      "estleg:provisionRef": "Reg_328930 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_328930_Map"
      }
    },
    {
      "@id": "estleg:Reg_328930_Par_3_v328930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_328930_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pädev ülem võib anda käsu jõu kasutamise alustamiseks rahuajal väljastpoolt Eesti riigi territooriumi Eesti riigi vastu suunatud sõjalise ründe tõrjumiseks või tõkestamiseks, kui kaitseministri teavitamiseks ei ole asjaolusid arvestades aega või kui kaitseminister ei ole kättesaadav. Pädev ülem võib anda käsu jõu kasutamise alustamiseks rahuajal väljastpoolt Eesti riigi territooriumi Eesti riigi vastu suunatud sõjalise ründe tõrjumiseks või tõkestamiseks, kui kaitseministri teavitamiseks ei ole asjaolusid arvestades aega või kui kaitseminister ei ole kättesaadav. 2 (2) Jõu kasutamise alustamise käsu võib anda, kui Eesti riigi territooriumile, õhuruumi või territoriaalvette tunginud relvastatud jõu sõjalise ründe muul viisil tõkestamine pole võimalik või kasutatud meetmed pole andnud tulemust. Jõu kasutamise alustamise käsu võib anda, kui Eesti riigi territooriumile, õhuruumi või territoriaalvette tunginud relvastatud jõu sõjalise ründe muul viisil tõkestamine pole võimalik või kasutatud meetmed pole andnud tulemust. 3 (3) Pädeva ülema poolt antud käsk jõu kasutamiseks piirdub Eesti riigi vastu suunatud sõjalise ründe tõrjumise või tõkestamisega. Kui pädev ülem pole saanud lisajuhiseid kaitseministrilt, peatub jõu kasutamine sõjalise ründe lõppemisel või ohu möödumisel. Pädeva ülema poolt antud käsk jõu kasutamiseks piirdub Eesti riigi vastu suunatud sõjalise ründe tõrjumise või tõkestamisega. Kui pädev ülem pole saanud lisajuhiseid kaitseministrilt, peatub jõu kasutamine sõjalise ründe lõppemisel või ohu möödumisel.",
      "rdfs:label": {
        "@value": "Reg_328930_Par_3 (redaktsioon 328930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "328930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/328930",
      "estleg:sourceAct": "Pädeva ülema poolt riigi sõjaliseks kaitsmiseks jõu kasutamise otsustamine rahuajal",
      "estleg:provisionRef": "Reg_328930 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_328930_Map"
      }
    },
    {
      "@id": "estleg:Reg_328930_Par_4_v328930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_328930_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti riigi vastu suunatud sõjalisest ründest ja pädeva ülema poolt otsustatud jõu kasutamisest Kaitseväe poolt tuleb viivitamatult teavitada kaitseministrit ja peaministrit. Kaitseväe esitatud info peab sisaldama teavet sõjalise ründe iseloomu, ulatuse, aja ja koha ning Kaitseväe tegevuse kohta. RT I 2013-03-28 1 128032013001 2013-04-01 Eesti riigi vastu suunatud sõjalisest ründest ja pädeva ülema poolt otsustatud jõu kasutamisest Kaitseväe poolt tuleb viivitamatult teavitada kaitseministrit ja peaministrit. Kaitseväe esitatud info peab sisaldama teavet sõjalise ründe iseloomu, ulatuse, aja ja koha ning Kaitseväe tegevuse kohta. 2 (2) Kaitseminister teavitab viivitamata Vabariigi Presidenti ja Vabariigi Valitsust Eesti riigi vastu suunatud sõjalisest ründest ja Kaitseväe poolt selle sõjalise ründe tõrjumiseks jõu kasutamise alustamisest või jõu kasutamisest loobumisest. RT I 2013-03-28 1 128032013001 2013-04-01 Kaitseminister teavitab viivitamata Vabariigi Presidenti ja Vabariigi Valitsust Eesti riigi vastu suunatud sõjalisest ründest ja Kaitseväe poolt selle sõjalise ründe tõrjumiseks jõu kasutamise alustamisest või jõu kasutamisest loobumisest.",
      "rdfs:label": {
        "@value": "Reg_328930_Par_4 (redaktsioon 328930)",
        "@language": "et"
      },
