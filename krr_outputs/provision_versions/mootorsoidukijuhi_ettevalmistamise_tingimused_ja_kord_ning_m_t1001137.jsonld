      }
    },
    {
      "@id": "estleg:Reg_1001137_Par_24_v1001137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001137_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolituskursusele võetakse õppima A-kategooria, A1- või A2-alamkategooria mootorsõiduki juhtimisõigust taotlev isik, kes: RT I 2017-11-14 1 114112017001 2017-11-17 1 1) A1-alamkategooria sõiduki juhtimisõiguse taotlemisel on õppetöö alustamisel vähemalt 15,5 aastat vana; 2 2) kehtetu - RT I 2011-06-28 39 128062011039 - kehtis kuni 18.01.2013 3 3) A2-alamkategooria sõiduki juhtimisõiguse taotlemisel on õppetöö alustamisel vähemalt 17,5 aastat vana; 2011-06-27 RT I 2011-06-28 39 128062011039 2013-01-19 4 4) A-kategooria sõiduki juhtimisõiguse taotlemisel omab esmast juhiluba või juhiluba mis tahes kategooria auto juhtimiseks; 5 5) kehtetu - RT I 2011-06-28 39 128062011039 - kehtis kuni 18.01.2013 6 6) A-kategooria sõiduki juhtimisõiguse taotlemisel on õppetöö alustamisel vähemalt 23,5 aastat vana. 2011-06-27 RT I 2011-06-28 39 128062011039 2013-01-19 Koolituskursusele võetakse õppima A-kategooria, A1- või A2-alamkategooria mootorsõiduki juhtimisõigust taotlev isik, kes: A1-alamkategooria sõiduki juhtimisõiguse taotlemisel on õppetöö alustamisel vähemalt 15,5 aastat vana; kehtetu - - kehtis kuni 18.01.2013 A2-alamkategooria sõiduki juhtimisõiguse taotlemisel on õppetöö alustamisel vähemalt 17,5 aastat vana; A-kategooria sõiduki juhtimisõiguse taotlemisel omab esmast juhiluba või juhiluba mis tahes kategooria auto juhtimiseks; kehtetu - - kehtis kuni 18.01.2013 A-kategooria sõiduki juhtimisõiguse taotlemisel on õppetöö alustamisel vähemalt 23,5 aastat vana.",
      "rdfs:label": {
