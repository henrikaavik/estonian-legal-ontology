        "@type": "xsd:date"
      },
      "estleg:versionText": "Lõppastme koolituse läbimist tõendab koolituskursuse tunnistus ning andmed selle kohta liiklusregistris. RT I 2023-07-28 1 128072023001 2023-10-01 Lõppastme koolituse läbimist tõendab koolituskursuse tunnistus ning andmed selle kohta liiklusregistris.",
      "rdfs:label": {
        "@value": "Reg_1001137_Par_20 (redaktsioon 1001137)",
        "@language": "et"
      },
