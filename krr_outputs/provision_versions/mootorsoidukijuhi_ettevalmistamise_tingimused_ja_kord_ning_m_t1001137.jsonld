      "estleg:versionValidFrom": {
        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahv 13 jõustub 2012. aasta 1. jaanuaril. Paragrahv 13 jõustub 2012. aasta 1. jaanuaril. 2 (2) Paragrahvi 24 punkt 2 kehtib kuni 2013. aasta 18. jaanuarini. Paragrahvi 24 punkt 2 kehtib kuni 2013. aasta 18. jaanuarini. 3 (3) Paragrahvi 24 punkt 3 jõustub 2013. aasta 19. jaanuaril. Paragrahvi 24 punkt 3 jõustub 2013. aasta 19. jaanuaril. 4 (4) Paragrahvi 24 punkt 5 kehtib kuni 2013. aasta 18. jaanuarini. Paragrahvi 24 punkt 5 kehtib kuni 2013. aasta 18. jaanuarini. 5 (5) Paragrahvi 24 punkt 6 jõustub 2013. aasta 19. jaanuaril. Paragrahvi 24 punkt 6 jõustub 2013. aasta 19. jaanuaril. 6 (6) Paragrahvi 27 lõike 1 punkt 3 kehtib kuni 2013. aasta 18. jaanuarini. Paragrahvi 27 lõike 1 punkt 3 kehtib kuni 2013. aasta 18. jaanuarini. 7 (7) Paragrahvi 27 lõike 1 punkt 4 jõustub 2013. aasta 19. jaanuaril. Paragrahvi 27 lõike 1 punkt 4 jõustub 2013. aasta 19. jaanuaril.",
      "rdfs:label": {
        "@value": "Reg_1001137_Par_53 (redaktsioon 1001137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001137",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001137",
      "estleg:sourceAct": "Mootorsõidukijuhi ettevalmistamise tingimused ja kord ning mootorsõidukijuhi ettevalmistamise õppekavad",
      "estleg:provisionRef": "Reg_1001137 § 53",
