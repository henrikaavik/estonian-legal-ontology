      "estleg:versionValidFrom": {
        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolituskursusele võetakse õppima B-kategooria ja B1-alamkategooria mootorsõiduki juhtimisõigust taotlev isik, kes on õppetöö alustamise ajaks vähemalt 15,5-aastane. RT I 2017-11-14 1 114112017001 2017-11-17 Koolituskursusele võetakse õppima B-kategooria ja B1-alamkategooria mootorsõiduki juhtimisõigust taotlev isik, kes on õppetöö alustamise ajaks vähemalt 15,5-aastane.",
      "rdfs:label": {
