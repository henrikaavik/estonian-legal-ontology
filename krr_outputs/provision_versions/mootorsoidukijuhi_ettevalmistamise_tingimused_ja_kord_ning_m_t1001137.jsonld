    },
    {
      "@id": "estleg:Reg_1001137_Par_6_v1001137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001137_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Algastmeõppes, täiendusõppes, jätkuõppes ning keskkonda säästva, riske vältiva ja teisi liiklejaid arvestava sõiduviisi õppes võib õppesõidul õpetaja õpetada korraga ainult ühte õpilast. RT I 2020-01-16 1 116012020001 2020-02-01 Algastmeõppes, täiendusõppes, jätkuõppes ning keskkonda säästva, riske vältiva ja teisi liiklejaid arvestava sõiduviisi õppes võib õppesõidul õpetaja õpetada korraga ainult ühte õpilast. 2 (2) Õppesõidul peab õpilasel olema kaasas õpilase koolituskursuse õpingukaart (edaspidi ka õpingukaart). Õppesõidul peab õpilasel olema kaasas õpilase koolituskursuse õpingukaart (edaspidi ka õpingukaart). 3 (3) Iga õppesõidu alustamisel märgib õpetaja õpingukaardile õppesõidu läbiviimise kuupäeva, kellaaja ja õppekava kohase teema. Iga õppesõidu alustamisel märgib õpetaja õpingukaardile õppesõidu läbiviimise kuupäeva, kellaaja ja õppekava kohase teema. 4 (4) Iga õppesõidu lõpus märgib õpetaja õpingukaardile õppesõidutundide arvu ja hinnangu õpilase oskuste kohta. Iga õppesõidu lõpus märgib õpetaja õpingukaardile õppesõidutundide arvu ja hinnangu õpilase oskuste kohta. 5 (5) Paberkandjal oleva õpingukaardi sissekannete õigsust kinnitavad õppesõidu lõpus õpilane ja õpetaja oma allkirjaga, elektroonilise õpingukaardi puhul toimub sõiduõppe sissekannete õigsuse kinnitamine elektroonilise õpingukaardi keskkonnas, millesse sisenemine nõuab õpetaja ja õpilase autentimist. Paberkandjal oleva õpingukaardi sissekannete õigsust kinnitavad õppesõidu lõpus õpilane ja õpetaja oma allkirjaga, elektroonilise õpingukaardi puhul toimub sõiduõppe sissekannete õigsuse kinnitamine elektroonilise õpingukaardi keskkonnas, millesse sisenemine nõuab õpetaja ja õpilase autentimist.",
      "rdfs:label": {
        "@value": "Reg_1001137_Par_6 (redaktsioon 1001137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001137",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001137",
      "estleg:sourceAct": "Mootorsõidukijuhi ettevalmistamise tingimused ja kord ning mootorsõidukijuhi ettevalmistamise õppekavad",
      "estleg:provisionRef": "Reg_1001137 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001137_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001137_Par_7_v1001137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001137_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Liiklusteooriaõppe ja õppesõidu ühe õppetunni arvestuslik kestus on 45 minutit. Korraga on teooria- ja sõiduõpet lubatud läbi viia kestusega kuni 90 minutit. Iga 90-minutilise ajavahemiku kohta peab õpetaja ja õpilase jaoks olema katkematu puhkepaus vähemalt 15 minutit, mille jooksul õppetegevust ei toimu. RT I 2020-01-16 1 116012020001 2020-02-01 Liiklusteooriaõppe ja õppesõidu ühe õppetunni arvestuslik kestus on 45 minutit. Korraga on teooria- ja sõiduõpet lubatud läbi viia kestusega kuni 90 minutit. Iga 90-minutilise ajavahemiku kohta peab õpetaja ja õpilase jaoks olema katkematu puhkepaus vähemalt 15 minutit, mille jooksul õppetegevust ei toimu.",
      "rdfs:label": {
        "@value": "Reg_1001137_Par_7 (redaktsioon 1001137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001137",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001137",
      "estleg:sourceAct": "Mootorsõidukijuhi ettevalmistamise tingimused ja kord ning mootorsõidukijuhi ettevalmistamise õppekavad",
      "estleg:provisionRef": "Reg_1001137 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001137_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001137_Par_8_v1001137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001137_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õpilase ettevalmistuse taseme kohta peab koolitaja andma õpilasele õppeprotsessi käigus tagasisidet ning mitterahuldava tulemuse korral vajadusel ka konsultatsioone, tagamaks juhile vajalike teadmiste ja oskuste omandamise. RT I 2020-01-16 1 116012020001 2020-02-01 Õpilase ettevalmistuse taseme kohta peab koolitaja andma õpilasele õppeprotsessi käigus tagasisidet ning mitterahuldava tulemuse korral vajadusel ka konsultatsioone, tagamaks juhile vajalike teadmiste ja oskuste omandamise.",
      "rdfs:label": {
        "@value": "Reg_1001137_Par_8 (redaktsioon 1001137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001137",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001137",
      "estleg:sourceAct": "Mootorsõidukijuhi ettevalmistamise tingimused ja kord ning mootorsõidukijuhi ettevalmistamise õppekavad",
      "estleg:provisionRef": "Reg_1001137 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001137_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001137_Par_9_v1001137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001137_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhi ettevalmistamise koolituskursuse lõpetamise eelduseks on õppekavas sätestatud õpiväljundite saavutamine. Juhi ettevalmistamise koolituskursuse lõpetamise eelduseks on õppekavas sätestatud õpiväljundite saavutamine.",
      "rdfs:label": {
