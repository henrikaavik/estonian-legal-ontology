    {
      "@id": "estleg:RAUDTEE_Par_78_v129062014058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAUDTEE_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_78 (redaktsioon 129062014058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014058",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAUDTEE_Par_78_v130102020001"
      },
      "estleg:versionValidTo": {
        "@value": "2020-10-30",
