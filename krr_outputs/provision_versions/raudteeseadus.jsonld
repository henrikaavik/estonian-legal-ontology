        "@id": "estleg:RAUDTEE_Par_3_v124032016003"
      },
      "estleg:versionValidTo": {
        "@value": "2016-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RAUDTEE_Par_3_v124032016003",
