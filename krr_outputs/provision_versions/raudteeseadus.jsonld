      },
      "estleg:versionValidFrom": {
        "@value": "2010-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandus- ja Kommunikatsiooniministeerium, Tehnilise Järelevalve Amet, Konkurentsiamet ning Tarbijakaitseamet on kohustatud tagama neile riikliku järelevalve teostamisel teatavaks saanud äri- ja tehnikaalase teabe konfidentsiaalsuse, kui seadus ei näe ette selle avaldamist.",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_75 (redaktsioon 13278288)",
        "@language": "et"
      },
