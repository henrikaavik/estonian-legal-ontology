      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandus- ja Kommunikatsiooniministeerium ning Raudteeinspektsioon on kohustatud tagama neile riikliku järelevalve teostamisel teatavaks saanud äri- ja tehnikaalase teabe konfidentsiaalsuse, kui seadus ei näe ette selle avaldamist.",
      "rdfs:label": {
