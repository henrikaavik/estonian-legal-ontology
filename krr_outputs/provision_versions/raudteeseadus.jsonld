    {
      "@id": "estleg:RAUDTEE_Par_92_v112072014117",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAUDTEE_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_92 (redaktsioon 112072014117)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014117",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAUDTEE_Par_92_v130102020001"
      },
      "estleg:versionValidTo": {
