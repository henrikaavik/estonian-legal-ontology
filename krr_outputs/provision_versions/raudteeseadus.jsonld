      },
      "estleg:versionValidTo": {
        "@value": "2014-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RAUDTEE_Par_100_v113032014111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAUDTEE_Par_100"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avaliku reisijateveoga tegelevaks raudteeveo-ettevõtjaks määratud raudtee-ettevõtja poolt avaliku reisijateveoga tegelemata jätmise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_100 (redaktsioon 113032014111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014111",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAUDTEE_Par_100_v130102020001"
      },
      "estleg:versionValidTo": {
        "@value": "2020-10-30",
