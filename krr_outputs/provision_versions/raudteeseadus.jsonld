        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtjal peab olema raudtee-ehituseks tegevusluba. (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_24 (redaktsioon 129062014058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014058",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAUDTEE_Par_24_v130102020001"
      },
      "estleg:versionValidTo": {
