      "rdfs:label": {
        "@value": "RAUDTEE_Par_12 (redaktsioon 131122010021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010021",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAUDTEE_Par_12_v129062014058"
