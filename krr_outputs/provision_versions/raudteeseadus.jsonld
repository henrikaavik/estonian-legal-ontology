      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RAUDTEE_Par_108_v12894961",
      "@type": [
        "owl:NamedIndividual",
