        "@id": "estleg:RAUDTEE_Par_3_v104072011005"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RAUDTEE_Par_3_v104072011005",
