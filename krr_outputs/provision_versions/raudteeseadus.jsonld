      "estleg:versionText": "Käesolev seadus jõustub 2004. aasta 31. märtsil.",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_119 (redaktsioon 739994)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "739994",
