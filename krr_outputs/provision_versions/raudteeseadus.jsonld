        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_87 (redaktsioon 112072014117)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014117",
