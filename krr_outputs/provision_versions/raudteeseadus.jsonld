      }
    },
    {
      "@id": "estleg:RAUDTEE_Par_119_v920786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAUDTEE_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2004. aasta 31. märtsil. (2) Käesoleva seaduse § 10 lõige 5 1 jõustub 2006. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_119 (redaktsioon 920786)",
        "@language": "et"
      },
