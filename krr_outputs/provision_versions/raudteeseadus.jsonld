    {
      "@id": "estleg:RAUDTEE_Par_92_v131122010021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAUDTEE_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vedurijuhiabi ülesannete täitmise eest joobeseisundis –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_92 (redaktsioon 131122010021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010021",
