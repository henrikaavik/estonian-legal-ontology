      }
    },
    {
      "@id": "estleg:RAUDTEE_Par_100_v130102020001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAUDTEE_Par_100"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raudteeinfrastruktuuriettevõtja, teenindusrajatise käitaja ning Tarbijakaitse ja Tehnilise Järelevalve Amet peavad Konkurentsiametile esitama kasutustasude kohta kõik vajalikud andmed, et Konkurentsiamet saaks täita käesoleva seaduse § 109 lõikes 1 nimetatud ülesandeid.",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_100 (redaktsioon 130102020001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130102020001"
    },
    {
      "@id": "estleg:RAUDTEE_Par_101_v739994",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAUDTEE_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avalikuks kasutamiseks määratud raudtee majandamise eest ohutustunnistuseta – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_101 (redaktsioon 739994)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "739994",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAUDTEE_Par_101_v13278288"
      },
      "estleg:versionValidTo": {
        "@value": "2010-02-26",
