    {
      "@id": "estleg:RAUDTEE_Par_32_v693644",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAUDTEE_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raudteeliikluse seisundi ning selles toimuvate muutuste hindamise eesmärgil võib Raudteeamet riikliku statistika seaduse (RT I 1997, 51, 822) kohaselt korraldada statistilisi vaatlusi Vabariigi Valitsuse kinnitatud riiklike statistiliste vaatluste loetelu alusel.",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_32 (redaktsioon 693644)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693644",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAUDTEE_Par_32_v739994"
      },
