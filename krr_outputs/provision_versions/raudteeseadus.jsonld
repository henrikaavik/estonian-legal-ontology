      }
    },
    {
      "@id": "estleg:RAUDTEE_Par_82_v131122010021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAUDTEE_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtestatud korras registreerimata raudteeveeremi juhtimise eest –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "RAUDTEE_Par_82 (redaktsioon 131122010021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010021",
