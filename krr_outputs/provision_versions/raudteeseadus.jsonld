      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja võib tegeleda raudtee-ehitusega, kui: ta on kantud äriregistrisse ja tal on majandustegevuse registri (edaspidi register) registreering; tal on vastav leping käesoleva seaduse §-s 25 nimetatud pädeva isikuga (edaspidi vastutav spetsialist) või füüsilisest isikust ettevõtja on ise pädev tegutsema vastutava spetsialistina.",
      "rdfs:label": {
