      "dc:source": "Nõuded erilendu tegeva mitte-EASA õhusõiduki käitaja lennutegevuse käsiraamatu sisule ja koostamisele"
    },
    {
      "@id": "estleg:Reg_1047848_Par_1_v1047848",
