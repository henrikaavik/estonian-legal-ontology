    {
      "@id": "estleg:Reg_1001424_Par_11_v1001424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001424_Par_11"
