        "@value": "2019-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 27. märtsi 2019. a käskkirjaga nr 1-2/19/265 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 27. märtsi 2019. a käskkirjaga nr 1-2/19/265 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1048344_Par_11 (redaktsioon 1048344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048344",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048344",
      "estleg:sourceAct": "Tupenurme maastikukaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1048344 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048344_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048344_Par_12_v1048344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
