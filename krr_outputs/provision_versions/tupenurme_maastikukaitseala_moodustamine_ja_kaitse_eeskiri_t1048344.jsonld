    {
      "@id": "estleg:Reg_1048344_Par_4_v1048344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048344_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas3 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndi piiride kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas3 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndi piiride kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1048344_Par_4 (redaktsioon 1048344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048344",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048344",
      "estleg:sourceAct": "Tupenurme maastikukaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1048344 § 4",
      "estleg:partOfAct": {
