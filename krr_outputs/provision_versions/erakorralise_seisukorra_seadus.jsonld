      }
    },
    {
      "@id": "estleg:ErSS_Par_13_v190234",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_13"
      },
      "estleg:versionValidFrom": {
