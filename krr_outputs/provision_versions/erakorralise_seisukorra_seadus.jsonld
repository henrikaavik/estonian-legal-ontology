        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 18 2. lõike punktides 2, 3 ja 4 tähendatud ametnikele säilitatakse teenistussuhte peatumise või teisele ametikohale üleviimise ajaks nende senise ametikoha palk.",
      "rdfs:label": {
        "@value": "ErSS_Par_23 (redaktsioon 190234)",
