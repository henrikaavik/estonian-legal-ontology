      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 33–35 sätestatud väärtegudele kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. (2) Käesoleva seaduse §-des 33–35 sätestatud väärtegude kohtuväline menetleja on politseiprefektuur.",
      "rdfs:label": {
        "@value": "ErSS_Par_35_1 (redaktsioon 13203809)",
