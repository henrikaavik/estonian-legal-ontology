        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Käesoleva seaduse §-des 33–35 sätestatud väärtegude kohtuväline menetleja on politseiasutus.",
      "rdfs:label": {
        "@value": "ErSS_Par_35_1 (redaktsioon 116122014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116122014012"
    },
    {
      "@id": "estleg:ErSS_Par_36_v25054",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-des 33, 34 ja 35 sätestatud õiguserikkumise asjades võib isikut kinni pidada kuni haldusõiguserikkumise asja arutamiseni.",
      "rdfs:label": {
        "@value": "ErSS_Par_36 (redaktsioon 25054)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25054",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErSS_Par_36_v182726"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ErSS_Par_36_v182726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse paragrahvides 33, 34 ja 35 sätestatud õiguserikkumise asjades võib isikut kinni pidada kuni haldusõiguserikkumise asja arutamiseni.",
      "rdfs:label": {
        "@value": "ErSS_Par_36 (redaktsioon 182726)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182726"
    },
    {
      "@id": "estleg:ErSS_Par_39_v25054",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Menetlus käesoleva seaduse §-des 33, 34 ja 35 sätestatud haldusõiguserikkumiste asjades toimub haldusõiguserikkumiste seadustikus kehtestatud korras, kui käesolevas seaduses ei sätestata teisiti.",
      "rdfs:label": {
        "@value": "ErSS_Par_39 (redaktsioon 25054)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25054",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErSS_Par_39_v182726"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ErSS_Par_39_v182726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Menetlus käesoleva seaduse paragrahvides 33, 34 ja 35 sätestatud haldusõiguse-rikkumiste asjades toimub haldusõiguserikkumiste seadustikus kehtestatud korras, kui käesolevas seaduses ei sätestata teisiti.",
      "rdfs:label": {
        "@value": "ErSS_Par_39 (redaktsioon 182726)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182726",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErSS_Par_39_v129122011208"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
