      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti põhiseaduslikku korda ähvardava ohu kõrvaldamisel tekitatud materiaalne kahju hüvitatakse seadusega sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "ErSS_Par_5 (redaktsioon 25054)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25054"
    },
    {
      "@id": "estleg:ErSS_Par_6_v25054",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erakorralise seisukorra ajal kehtivad seadused ja muud õigusaktid niivõrd, kuivõrd käesolevas seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "ErSS_Par_6 (redaktsioon 25054)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25054"
    },
    {
      "@id": "estleg:ErSS_Par_6_1_v182726",
      "@type": [
        "owl:NamedIndividual",
