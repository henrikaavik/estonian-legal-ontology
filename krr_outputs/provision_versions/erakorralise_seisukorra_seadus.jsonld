      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ErSS_Par_24_v182726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
