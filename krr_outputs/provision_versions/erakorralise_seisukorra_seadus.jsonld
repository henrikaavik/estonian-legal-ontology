      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "ErSS_Par_6_1 (redaktsioon 13203809)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13203809"
    },
    {
      "@id": "estleg:ErSS_Par_7_v25054",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti põhiseaduslikku korda ähvardavast ohust teatatakse viivitamatult Vabariigi Presidendile, Vabariigi Valitsusele ja kaitseväe juhatajale riigiasutuste ning valla- ja linnavalitsuste poolt Vabariigi Valitsuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "ErSS_Par_7 (redaktsioon 25054)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25054",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErSS_Par_7_v116122014011"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-16",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ErSS_Par_7_v116122014011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti põhiseaduslikku korda ähvardavast ohust teatatakse viivitamatult Vabariigi Presidendile, Vabariigi Valitsusele ja Kaitseväe juhatajale riigiasutuste ning valla- ja linnavalitsuste poolt Vabariigi Valitsuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "ErSS_Par_7 (redaktsioon 116122014011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116122014011",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErSS_Par_7_v112032015012"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ErSS_Par_7_v112032015012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti põhiseaduslikku korda ähvardavast ohust teavitatakse viivitamata Vabariigi Presidenti, Vabariigi Valitsust ning Riigikaitse Nõukogu ja Vabariigi Valitsuse julgeolekukomisjoni liikmeid.",
      "rdfs:label": {
        "@value": "ErSS_Par_7 (redaktsioon 112032015012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015012"
    },
    {
      "@id": "estleg:ErSS_Par_8_v25054",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse moodustatud kriisikomisjoni ülesanneteks abinõude rakendamisel seoses Eesti põhiseaduslikku korda ähvardava ohuga on: riikliku poliitika ja tegevuskavade väljatöötamine ohu prognoosimiseks, ennetamiseks ja kõrvaldamiseks; teabe analüüsimine ning analüüsitulemuste esitamine peaministrile ohu prognoosimise, selle ennetamise ja kõrvaldamise kavandamise kohta; arvamuse andmine Vabariigi Valitsusele ohueelse seisundi, tekkinud ohu iseloomu, ulatuse ja kõrvaldamise ning erakorralise seisukorra väljakuulutamise vajaduse kohta; arvamuse andmine Vabariigi Valitsusele ja erakorralise seisukorra juhile abinõude rakendamise kohta erakorralise seisukorra ajal.",
      "rdfs:label": {
        "@value": "ErSS_Par_8 (redaktsioon 25054)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25054",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErSS_Par_8_v112032015012"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ErSS_Par_8_v112032015012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ErSS_Par_8 (redaktsioon 112032015012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015012"
    },
    {
      "@id": "estleg:ErSS_Par_9_v25054",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti põhiseaduslikku korda ähvardava ohu puhul Riigikogule erakorralise seisukorra väljakuulutamise ettepaneku tegemise otsustamiseks kutsub peaminister või tema äraolekul teda asendav minister viivitamatult kokku Vabariigi Valitsuse istungi, kus kuulatakse ära Vabariigi Valitsuse kriisikomisjoni arvamus erakorralise seisukorra väljakuulutamise vajaduse kohta.",
      "rdfs:label": {
        "@value": "ErSS_Par_9 (redaktsioon 25054)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25054",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErSS_Par_9_v112032015012"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ErSS_Par_9_v112032015012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
