        "@id": "estleg:ErSS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 18 2. lõike punkti 4 kohaselt ametniku üleviimisel teisele ametikohale kohaldatakse Eesti Vabariigi töölepingu seaduse (RT 1992, 15/16, 241; 1993, 10, 150; RT I 1993, 26, 441; 1995, 14, 170; 16, 228; 1996, 3, 57) § 67 3. ja 4. lõikes sätestatud tingimusi. (2) Käesoleva paragrahvi 1. lõiget kohaldatakse ka neile töötajate kategooriatele, kellele Eesti Vabariigi töölepingu seadus ei laiene.",
      "rdfs:label": {
        "@value": "ErSS_Par_24 (redaktsioon 190234)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "190234",
