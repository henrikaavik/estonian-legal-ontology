    },
    {
      "@id": "estleg:ErSS_Par_41_v25054",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErSS_Par_41"
