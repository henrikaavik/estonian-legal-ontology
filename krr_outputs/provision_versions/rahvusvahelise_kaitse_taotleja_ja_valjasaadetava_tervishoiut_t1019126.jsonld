      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Rahvusvahelise kaitse taotleja ja väljasaadetava tervishoiuteenused (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Rahvusvahelise kaitse taotleja ja väljasaadetava tervishoiuteenused"
    },
    {
      "@id": "estleg:Reg_1019126_Par_1_v1019126",
      "@type": [
        "owl:NamedIndividual",
