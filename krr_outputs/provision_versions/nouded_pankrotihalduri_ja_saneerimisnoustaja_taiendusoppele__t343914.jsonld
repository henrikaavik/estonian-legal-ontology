      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded pankrotihalduri ja saneerimisnõustaja täiendusõppele ja täiendusõppe maht (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded pankrotihalduri ja saneerimisnõustaja täiendusõppele ja täiendusõppe maht"
    },
    {
      "@id": "estleg:Reg_343914_Par_1_v343914",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
