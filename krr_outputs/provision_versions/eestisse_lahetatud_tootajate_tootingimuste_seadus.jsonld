        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELTTS_Par_8_1_v109072020003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
