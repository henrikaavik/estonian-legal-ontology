      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses sätestatud väärtegude kohtuväline menetleja on Tööinspektsioon.",
      "rdfs:label": {
        "@value": "ELTTS_Par_9_4 (redaktsioon 109072020003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109072020003",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTTS_Par_9_4_v122032022013"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELTTS_Par_9_4_v122032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTTS_Par_9_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 5 lõikes 13 sätestatud nõuete täitmata jätmise eest veose saatja, ekspedeerija või veoseveo tellimisel osaleva pea- või alltöövõtja, tema juhatuse liikme või muu esindaja poolt, kellele oli veoseveo tellimise kohustus delegeeritud, –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "ELTTS_Par_9_4 (redaktsioon 122032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032022013"
    },
    {
      "@id": "estleg:ELTTS_Par_9_5_v109072020003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTTS_Par_9_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lähetatud töötajate puhul, kes viibivad Eestis käesoleva seaduse § 53 jõustumise hetkel, hakatakse § 53 lõigetes 1 ja 3 sätestatud perioodi arvestama käesoleva seaduse jõustumisele järgnevast päevast.",
      "rdfs:label": {
        "@value": "ELTTS_Par_9_5 (redaktsioon 109072020003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109072020003",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELTTS_Par_9_5_v122032022013"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELTTS_Par_9_5_v122032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELTTS_Par_9_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses sätestatud väärtegude kohtuväline menetleja on Tööinspektsioon.",
