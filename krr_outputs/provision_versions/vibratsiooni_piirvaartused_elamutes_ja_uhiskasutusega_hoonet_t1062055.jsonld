      "estleg:provisionRef": "Reg_1062055 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062055_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062055_Par_2_v1062055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062055_Par_2"
