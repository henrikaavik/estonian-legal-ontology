      },
      "estleg:versionText": "Määrusega kehtestatakse täpsustavad nõuded jäätmepõletus- ja koospõletustehase käitamise kohta. Määrusega kehtestatakse täpsustavad nõuded jäätmepõletus- ja koospõletustehase käitamise kohta.",
      "rdfs:label": {
        "@value": "Reg_1014865_Par_1 (redaktsioon 1014865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014865",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014865",
      "estleg:sourceAct": "Täpsemad nõuded jäätmepõletus- ja koospõletustehase käitamisele",
