      }
    },
    {
      "@id": "estleg:Reg_1045884_Par_2_v1045884",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045884_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ehitusprojekti ekspertiisi tellija esitab ehitusprojekti ekspertiisi tegijale ehitusprojekti koos asjakohaste andmete ja dokumentidega. Ehitusprojekti ekspertiisi tellija esitab ehitusprojekti ekspertiisi tegijale ehitusprojekti koos asjakohaste andmete ja dokumentidega. 2 (2) Ehitusprojekti ekspertiisi tellija esitab ehitusprojekti ekspertiisi tegijale vajaduse korral ehitusprojekti kohta lisaküsimusi, millele ta soovib ekspertiisi tulemusel vastust saada. Ehitusprojekti ekspertiisi tellija esitab ehitusprojekti ekspertiisi tegijale vajaduse korral ehitusprojekti kohta lisaküsimusi, millele ta soovib ekspertiisi tulemusel vastust saada.",
      "rdfs:label": {
        "@value": "Reg_1045884_Par_2 (redaktsioon 1045884)",
        "@language": "et"
      },
