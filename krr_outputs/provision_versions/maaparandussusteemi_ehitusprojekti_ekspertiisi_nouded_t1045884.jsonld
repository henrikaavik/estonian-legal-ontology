      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Maaparandussüsteemi ehitusprojekti ekspertiisi nõuded (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Maaparandussüsteemi ehitusprojekti ekspertiisi nõuded"
    },
    {
      "@id": "estleg:Reg_1045884_Par_1_v1045884",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045884_Par_1"
