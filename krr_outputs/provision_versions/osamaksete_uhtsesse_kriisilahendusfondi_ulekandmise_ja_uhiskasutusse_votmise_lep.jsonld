      "dc:source": "Osamaksete ühtsesse kriisilahendusfondi ülekandmise ja ühiskasutusse võtmise lepingu ratifitseerimise seadus"
    },
    {
      "@id": "estleg:OUKUUVLR_Par_1_v205112015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
