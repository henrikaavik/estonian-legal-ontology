      "estleg:versionValidFrom": {
        "@value": "2015-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud (edaspidi leping), millele Eesti Vabariik on alla kirjutanud 2014. aasta 21. mail Brüsselis.",
      "rdfs:label": {
        "@value": "OUKUUVLR_Par_1 (redaktsioon 205112015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "205112015005"
    },
    {
      "@id": "estleg:OUKUUVLR_Par_2_v205112015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OUKUUVLR_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariik deklareerib, et tõlgendab lepingut viisil, mis ei too kaasa lepinguosaliste ühisvastutust, avaliku sektori finantstoetuse andmist ega eelarvesuveräänsust ja fiskaalkohustusi mõjutavate meetmete võtmise kohustust.",
      "rdfs:label": {
        "@value": "OUKUUVLR_Par_2 (redaktsioon 205112015005)",
