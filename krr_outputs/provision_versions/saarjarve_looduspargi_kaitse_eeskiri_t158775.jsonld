    {
      "@id": "estleg:Reg_158775_Par_4_v158775",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158775_Par_4"
