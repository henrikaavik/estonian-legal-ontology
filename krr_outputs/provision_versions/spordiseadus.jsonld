      }
    },
    {
      "@id": "estleg:SpS_Par_19_v108072016032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SpS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toetust makstakse iga kuu jooksva kuu eest sotsiaalseadustiku üldosa seaduse §-s 28 sätestatud korras. (2) Kehtetu - (3) Kehtetu -",
      "rdfs:label": {
        "@value": "SpS_Par_19 (redaktsioon 108072016032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072016032",
