      "estleg:provisionRef": "Reg_1056683 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056683_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056683_Par_11_v1056683",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
