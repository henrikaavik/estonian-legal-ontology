    {
      "@id": "estleg:Reg_1056683_Par_20_v1056683",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056683_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevalt kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevalt kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1056683_Par_20 (redaktsioon 1056683)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056683",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056683",
      "estleg:sourceAct": "Kaarmise-Jõempa looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056683 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056683_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056683_Par_3_v1056683",
