      "estleg:sourceAct": "Kaarmise-Jõempa looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056683 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056683_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056683_Par_9_v1056683",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056683_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndi kaitse-eesmärk on metsa- ja sookoosluste, kaitstavate liikide ning nende elupaikade kaitse. Sihtkaitsevööndi kaitse-eesmärk on metsa- ja sookoosluste, kaitstavate liikide ning nende elupaikade kaitse.",
