      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1056683_Par_3 (redaktsioon 1056683)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056683",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056683",
      "estleg:sourceAct": "Kaarmise-Jõempa looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056683 § 3",
      "estleg:partOfAct": {
