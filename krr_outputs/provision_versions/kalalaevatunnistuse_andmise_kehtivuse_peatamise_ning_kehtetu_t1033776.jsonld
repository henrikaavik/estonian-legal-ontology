    {
      "@id": "estleg:Reg_1033776_Par_9_v1033776",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033776_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kalapüügiseaduse § 38 lõikes 4 sätestatud asjaolu esinemise korral tunnistab Põllumajandus- ja Toiduamet kalalaevatunnistuse kehtetuks. RT I 2020-11-06 1 106112020001 2021-01-01 Kalapüügiseaduse § 38 lõikes 4 sätestatud asjaolu esinemise korral tunnistab Põllumajandus- ja Toiduamet kalalaevatunnistuse kehtetuks. 2 (2) Kalapüügiseaduse § 38 lõikes 6 sätestatud asjaolu esinemise korral peatab Põllumajandus- ja Toiduamet kalalaevatunnistuse kehtivuse. RT I 2020-11-06 1 106112020001 2021-01-01 Kalapüügiseaduse § 38 lõikes 6 sätestatud asjaolu esinemise korral peatab Põllumajandus- ja Toiduamet kalalaevatunnistuse kehtivuse. 3 (3) Kehtetu - RT I 2025-12-20 36 120122025036 2025-12-23 Kehtetu - 4 (4) Kehtetu - RT I 2025-12-20 36 120122025036 2025-12-23 Kehtetu - 5 (5) Kehtetu - RT I 2025-12-20 36 120122025036 2025-12-23 Kehtetu -",
      "rdfs:label": {
