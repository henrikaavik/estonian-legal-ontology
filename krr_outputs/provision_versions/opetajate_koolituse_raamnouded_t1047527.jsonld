        "@type": "xsd:date"
      },
      "estleg:versionText": "Tugiprogrammi läbimise kohta väljastab õpetajakoolitust läbiviiv õppeasutus õpetajale tunnistuse. RT I 2023-10-27 1 127102023001 2024-09-01 Tugiprogrammi läbimise kohta väljastab õpetajakoolitust läbiviiv õppeasutus õpetajale tunnistuse.",
      "rdfs:label": {
        "@value": "Reg_1047527_Par_15 (redaktsioon 1047527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047527",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047527",
