    {
      "@id": "estleg:Reg_1061863_Par_6_v1061863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061863_Par_6"
