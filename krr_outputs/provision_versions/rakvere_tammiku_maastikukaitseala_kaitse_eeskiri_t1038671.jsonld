        "@language": "et"
      },
      "estleg:versionRedactionId": "1038671",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038671",
      "estleg:sourceAct": "Rakvere tammiku maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1038671 § 18",
