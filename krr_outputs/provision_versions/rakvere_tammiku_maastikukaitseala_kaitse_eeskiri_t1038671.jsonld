    {
      "@id": "estleg:Reg_1038671_Par_18_v1038671",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038671_Par_18"
