    },
    {
      "@id": "estleg:Reg_157226_Par_2_v157226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157226_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Harju prokuratuur ja Tallinna prokuratuur korraldatakse hiljemalt 1. juuliks 2004. a ümber Põhja Ringkonnaprokuratuuriks. Harju prokuratuur ja Tallinna prokuratuur korraldatakse hiljemalt 1. juuliks 2004. a ümber Põhja Ringkonnaprokuratuuriks. 2 (2) Jõgeva prokuratuur, Põlva prokuratuur, Tartu prokuratuur, Valga prokuratuur, Viljandi prokuratuur ja Võru prokuratuur korraldatakse hiljemalt 1. juuliks 2004. a ümber Lõuna Ringkonnaprokuratuuriks. Jõgeva prokuratuur, Põlva prokuratuur, Tartu prokuratuur, Valga prokuratuur, Viljandi prokuratuur ja Võru prokuratuur korraldatakse hiljemalt 1. juuliks 2004. a ümber Lõuna Ringkonnaprokuratuuriks. 3 (3) Ida-Viru prokuratuur, Lääne-Viru prokuratuur ja Narva prokuratuur korraldatakse hiljemalt 1. juuliks 2004. a ümber Viru Ringkonnaprokuratuuriks. Ida-Viru prokuratuur, Lääne-Viru prokuratuur ja Narva prokuratuur korraldatakse hiljemalt 1. juuliks 2004. a ümber Viru Ringkonnaprokuratuuriks. 4 (4) Järva prokuratuur, Lääne prokuratuur, Pärnu prokuratuur, Rapla prokuratuur ja Saaremaa prokuratuur korraldatakse hiljemalt 1. juuliks 2004. a ümber Lääne Ringkonnaprokuratuuriks. Järva prokuratuur, Lääne prokuratuur, Pärnu prokuratuur, Rapla prokuratuur ja Saaremaa prokuratuur korraldatakse hiljemalt 1. juuliks 2004. a ümber Lääne Ringkonnaprokuratuuriks.",
