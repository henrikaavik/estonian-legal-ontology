      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ringkonnaprokuratuuride asukoha ja tööpiirkonna kehtestamine (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ringkonnaprokuratuuride asukoha ja tööpiirkonna kehtestamine"
    },
    {
      "@id": "estleg:Reg_157226_Par_1_v157226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157226_Par_1"
