    {
      "@id": "estleg:Reg_158500_Par_5_v158500",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158500_Par_5"
