      "estleg:versionValidFrom": {
        "@value": "2023-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet trammijuhi koolituse üle teostab Transpordiameti regioon, mille piirkonnas koolitaja asub õpilaste eksamitulemuste analüüsi ja koolitusasutuse vahetu kontrolli teel. Riiklikku järelevalvet trammijuhi koolituse üle teostab Transpordiameti regioon, mille piirkonnas koolitaja asub õpilaste eksamitulemuste analüüsi ja koolitusasutuse vahetu kontrolli teel.",
      "rdfs:label": {
        "@value": "Reg_1000963_Par_15 (redaktsioon 1000963)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000963",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000963",
      "estleg:sourceAct": "Trammijuhi kvalifikatsiooninõuded, trammijuhi ettevalmistamise, eksamineerimise ja temale trammi juhtimise õiguse andmise kord",
      "estleg:provisionRef": "Reg_1000963 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000963_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1000963_Par_16_v1000963",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000963_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Trammijuhi eksamineerimist teostab Transpordiamet. RT I 2015-04-22 1 122042015001 2015-04-25 Trammijuhi eksamineerimist teostab Transpordiamet. 2 (2) Trammijuht peab sooritama edukalt liiklusteooria- ja sõidueksami. Trammijuht peab sooritama edukalt liiklusteooria- ja sõidueksami. 3 (3) Trammijuhi eksamineerimisel selgitatakse välja trammijuhi teadmiste, oskuste ja käitumise vastavus trammijuhi kvalifikatsiooninõuetele. Trammijuhi eksamineerimisel selgitatakse välja trammijuhi teadmiste, oskuste ja käitumise vastavus trammijuhi kvalifikatsiooninõuetele. 4 (4) Sõidueksami võtab vastu Transpordiameti eksamineerija. RT I 2015-04-22 1 122042015001 2015-04-25 Sõidueksami võtab vastu Transpordiameti eksamineerija. 5 (5) Sõidueksamil peab sõitma kaasa ka sõiduõpetaja. Sõidueksamil peab sõitma kaasa ka sõiduõpetaja.",
      "rdfs:label": {
        "@value": "Reg_1000963_Par_16 (redaktsioon 1000963)",
        "@language": "et"
      },
