    {
      "@id": "estleg:Reg_1000963_Par_20_v1000963",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000963_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eksami tulemusega mittenõustumisel võib esitada Transpordiametile vaide “Haldusmenetluse seaduses“ sätestatud korras 30 päeva jooksul arvates eksamitulemuse teatamisest. Eksami tulemusega mittenõustumisel võib esitada Transpordiametile vaide “Haldusmenetluse seaduses“ sätestatud korras 30 päeva jooksul arvates eksamitulemuse teatamisest.",
      "rdfs:label": {
        "@value": "Reg_1000963_Par_20 (redaktsioon 1000963)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000963",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000963",
      "estleg:sourceAct": "Trammijuhi kvalifikatsiooninõuded, trammijuhi ettevalmistamise, eksamineerimise ja temale trammi juhtimise õiguse andmise kord",
      "estleg:provisionRef": "Reg_1000963 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000963_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1000963_Par_21_v1000963",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000963_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Trammi juhtimisõigus antakse isikule, kes: 1 1) on Eestis alalist elukohta omav isik või elamisloa alusel Eestis viibiv välismaalane; 2 2) on vähemalt 21-aastane; 3 3) omab vähemalt keskharidust; 4 4) omab trammi juhtimist lubavat tervisetõendit; 5 5) omab B-kategooria mootorsõiduki juhtimisõigust; 6 6) on edukalt läbinud trammijuhi koolituse ja omab vastavat tunnistust; 7 7) on edukalt sooritanud teooria- ja sõidueksami Transpordiametis. RT I 2015-04-22 1 122042015001 2015-04-25 Trammi juhtimisõigus antakse isikule, kes: on Eestis alalist elukohta omav isik või elamisloa alusel Eestis viibiv välismaalane; on vähemalt 21-aastane; omab vähemalt keskharidust; omab trammi juhtimist lubavat tervisetõendit; omab B-kategooria mootorsõiduki juhtimisõigust; on edukalt läbinud trammijuhi koolituse ja omab vastavat tunnistust; on edukalt sooritanud teooria- ja sõidueksami Transpordiametis. 2 (2) Lõikes 1 toodud tingimustele vastavale isikule, kes on edukalt sooritanud nõutavad eksamid ja kelle eksami tulemused on kantud liiklusregistrisse, annab Transpordiameti eksamineerija trammi juhtimisõiguse suulise otsusega ja Transpordiamet väljastab temale sellekohase kandega juhiloa, mille tagakülje lisaandmete lahtrisse kantakse sõna „tramm” hiljemalt 10 tööpäeva jooksul arvates juhtimisõiguse andmisest. RT I 2015-04-22 1 122042015001 2015-04-25 Lõikes 1 toodud tingimustele vastavale isikule, kes on edukalt sooritanud nõutavad eksamid ja kelle eksami tulemused on kantud liiklusregistrisse, annab Transpordiameti eksamineerija trammi juhtimisõiguse suulise otsusega ja Transpordiamet väljastab temale sellekohase kandega juhiloa, mille tagakülje lisaandmete lahtrisse kantakse sõna „tramm” hiljemalt 10 tööpäeva jooksul arvates juhtimisõiguse andmisest. 3 (3) Eelnev juhiluba kuulub tagastamisele Transpordiametile uue juhiloa väljastamisel ning kaotab kehtivuse pärast uue juhiloa väljastamist selle omanikule. RT I 2015-04-22 1 122042015001 2015-04-25 Eelnev juhiluba kuulub tagastamisele Transpordiametile uue juhiloa väljastamisel ning kaotab kehtivuse pärast uue juhiloa väljastamist selle omanikule.",
      "rdfs:label": {
        "@value": "Reg_1000963_Par_21 (redaktsioon 1000963)",
        "@language": "et"
      },
