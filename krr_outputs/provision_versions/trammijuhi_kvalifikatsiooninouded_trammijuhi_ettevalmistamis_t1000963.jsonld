    {
      "@id": "estleg:Reg_1000963_Par_8_v1000963",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000963_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Trammijuhi ettevalmistamise kursusele võetakse Eestis alalist elukohta omav isik või elamisloa alusel Eestis viibiv välismaalane, kes on vähemalt 20,5-aastane, kellel on vähemalt keskharidus, kelle terviseseisund vastab trammi juhtimisõiguse taotleja terviseseisundile kehtestatud tervisenõuetele ning kes omab B-kategooria mootorsõiduki juhtimisõigust. Trammijuhi kursusest osavõtja mootorsõiduki juhtimisõigus ei tohi olla peatatud, ära võetud või kehtetuks tunnistatud ning ta ei tohi olla juhtimiselt kõrvaldatud. Trammijuhi ettevalmistamise kursusele võetakse Eestis alalist elukohta omav isik või elamisloa alusel Eestis viibiv välismaalane, kes on vähemalt 20,5-aastane, kellel on vähemalt keskharidus, kelle terviseseisund vastab trammi juhtimisõiguse taotleja terviseseisundile kehtestatud tervisenõuetele ning kes omab B-kategooria mootorsõiduki juhtimisõigust. Trammijuhi kursusest osavõtja mootorsõiduki juhtimisõigus ei tohi olla peatatud, ära võetud või kehtetuks tunnistatud ning ta ei tohi olla juhtimiselt kõrvaldatud.",
      "rdfs:label": {
        "@value": "Reg_1000963_Par_8 (redaktsioon 1000963)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000963",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000963",
      "estleg:sourceAct": "Trammijuhi kvalifikatsiooninõuded, trammijuhi ettevalmistamise, eksamineerimise ja temale trammi juhtimise õiguse andmise kord",
      "estleg:provisionRef": "Reg_1000963 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000963_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1000963_Par_9_v1000963",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000963_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu - RT I 2023-07-28 1 128072023001 2023-10-01 Kehtetu - 2 (2) Teooria ja sõiduõppe tundide ülesehitus ja vahelduvus peavad tagama õpilase ettevalmistamise vastavalt trammijuhi kvalifikatsiooninõuetele ja eksamite edukaks sooritamiseks Transpordiametis ning töötamiseks trammijuhina. RT I 2015-04-22 1 122042015001 2015-04-25 Teooria ja sõiduõppe tundide ülesehitus ja vahelduvus peavad tagama õpilase ettevalmistamise vastavalt trammijuhi kvalifikatsiooninõuetele ja eksamite edukaks sooritamiseks Transpordiametis ning töötamiseks trammijuhina. 2 (2¹) Jätkuõpe on sõiduõpe, mis viiakse läbi seoses juhtimisõiguse taotleja sõidueksami korduva mittesooritamisega ning mille eesmärk on süvendatud ettevalmistus sõidueksami edukaks sooritamiseks. RT I 2020-01-16 1 116012020001 2020-02-01 Jätkuõpe on sõiduõpe, mis viiakse läbi seoses juhtimisõiguse taotleja sõidueksami korduva mittesooritamisega ning mille eesmärk on süvendatud ettevalmistus sõidueksami edukaks sooritamiseks. 3 (3) Kehtetu - RT I 2023-07-28 1 128072023001 2023-10-01 Kehtetu - 4 (4) Teooria- ja sõiduõppe tunni kestus on 45 minutit. Teooria- ja sõiduõppe tunni kestus on 45 minutit.",
      "rdfs:label": {
        "@value": "Reg_1000963_Par_9 (redaktsioon 1000963)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000963",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000963",
      "estleg:sourceAct": "Trammijuhi kvalifikatsiooninõuded, trammijuhi ettevalmistamise, eksamineerimise ja temale trammi juhtimise õiguse andmise kord",
      "estleg:provisionRef": "Reg_1000963 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000963_Map_2026"
      }
    },
