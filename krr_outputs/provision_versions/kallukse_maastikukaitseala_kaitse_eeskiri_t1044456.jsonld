      }
    },
    {
      "@id": "estleg:Reg_1044456_Par_11_v1044456",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044456_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 31. märtsi 2011. a käskkirjaga nr 460 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 31. märtsi 2011. a käskkirjaga nr 460 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1044456_Par_11 (redaktsioon 1044456)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044456",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044456",
      "estleg:sourceAct": "Kallukse maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1044456 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044456_Map"
      }
    },
    {
      "@id": "estleg:Reg_1044456_Par_12_v1044456",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044456_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1044456_Par_12 (redaktsioon 1044456)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044456",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044456",
      "estleg:sourceAct": "Kallukse maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1044456 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044456_Map"
      }
    },
    {
      "@id": "estleg:Reg_1044456_Par_2_v1044456",
