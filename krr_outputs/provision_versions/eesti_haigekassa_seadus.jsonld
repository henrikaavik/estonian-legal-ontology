        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõukogu liikmetele, kes ei kuulu nõukogusse ametikoha järgi või kes ei ole Riigikogu poolt määratud, makstakse nõukogu liikme kohustuste täitmise eest tasu suuruses ja korras.",
      "rdfs:label": {
        "@value": "EESTI_Par_21 (redaktsioon 13311986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13311986",
