      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigekassa nimi on Eesti Haigekassa. Haigekassal on ainuõigus oma nimele.",
      "rdfs:label": {
        "@value": "EESTI_Par_6 (redaktsioon 26422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26422",
