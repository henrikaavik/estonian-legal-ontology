      }
    },
    {
      "@id": "estleg:EESTI_Par_38_v26422",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haigekassa reservkapital on haigekassa eelarve vahenditest moodustatav reserv ravikindlustussüsteemile makromajanduslikest muutustest tulenevate riskide vähendamiseks. (2) Reservkapitali suuruseks on 8 protsenti eelarve mahust. Reservkapitali kantakse igal aastal vähemalt 1/50 haigekassa eelarve kogumahust ning ravikindlustuseks ettenähtud sotsiaalmaksu ülelaekumised kuni käesolevas seaduses sätestatud reservkapitali suuruse saavutamiseni või taastamiseni. (3) Reservkapitali võib kasutusele võtta ainult erandkorras Vabariigi Valitsuse korraldusega sotsiaalministri ettepanekul. Enne ettepaneku esitamist Vabariigi Valitsusele kuulab sotsiaalminister ära haigekassa nõukogu arvamuse.",
      "rdfs:label": {
        "@value": "EESTI_Par_38 (redaktsioon 26422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26422",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_Par_38_v833252"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26422",
      "estleg:sourceAct": "Eesti Haigekassa seadus",
      "estleg:provisionRef": "EESTI § 38",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_Par_38_v833252",
