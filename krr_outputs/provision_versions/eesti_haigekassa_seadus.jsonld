      }
    },
    {
      "@id": "estleg:EESTI_Par_42_v26422",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigekassa majandusaasta algab 1. jaanuaril ja lõpeb 31. detsembril.",
      "rdfs:label": {
        "@value": "EESTI_Par_42 (redaktsioon 26422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26422",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26422",
      "estleg:sourceAct": "Eesti Haigekassa seadus",
      "estleg:provisionRef": "EESTI § 42",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_Par_43_v26422",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu esitab kord aastas sotsiaalministri kaudu Vabariigi Valitsusele aruande haigekassa majandustegevuse kohta. Aruande esitamise tähtaja, koostamise korra ja vormi määrab rahandusminister. Nõukogu teavitab koheselt Vabariigi Valitsust haigekassa majandusliku seisundi olulisest halvenemisest ning muudest haigekassa tegevusega seotud olulistest asjaoludest. (2) Juhatus peab esitama nõukogule vähemalt kord kolme kuu jooksul ülevaate haigekassa tegevusest ja majanduslikust olukorrast, samuti teatama koheselt haigekassa seisundi olulisest halvenemisest ning muudest haigekassa tegevusega seotud olulistest asjaoludest. (3) Pärast majandusaasta lõppu koostab juhatus raamatupidamise aastaaruande ja tegevusaruande seaduses sätestatud korras. (4) Juhatus esitab käesoleva paragrahvi lõigetes 1 ja 3 nimetatud aruanded kinnitamiseks nõukogule nelja kuu jooksul pärast majandusaasta lõppemist. Enne käesoleva paragrahvi lõikes 3 ettenähtud raamatupidamise aastaaruande esitamist nõukogule kinnitamiseks esitab juhatus aruande audiitorile kontrollimiseks.",
      "rdfs:label": {
        "@value": "EESTI_Par_43 (redaktsioon 26422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26422",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_Par_43_v113032014012"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26422",
      "estleg:sourceAct": "Eesti Haigekassa seadus",
      "estleg:provisionRef": "EESTI § 43",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_Par_43_v113032014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu esitab kord aastas valdkonna eest vastutava ministri kaudu Vabariigi Valitsusele aruande haigekassa majandustegevuse kohta. Aruande esitamise tähtaja, koostamise korra ja vormi määrab valdkonna eest vastutav minister. Nõukogu teavitab koheselt Vabariigi Valitsust haigekassa majandusliku seisundi olulisest halvenemisest ning muudest haigekassa tegevusega seotud olulistest asjaoludest. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „sotsiaalminister” ja „rahandusminister” sõnadega „valdkonna eest vastutav minister” vastavas käändes. (2) Juhatus peab esitama nõukogule vähemalt kord kolme kuu jooksul ülevaate haigekassa tegevusest ja majanduslikust olukorrast, samuti teatama koheselt haigekassa seisundi olulisest halvenemisest ning muudest haigekassa tegevusega seotud olulistest asjaoludest. (3) Pärast majandusaasta lõppu koostab juhatus raamatupidamise aastaaruande ja tegevusaruande seaduses sätestatud korras. (4) Juhatus esitab käesoleva paragrahvi lõigetes 1 ja 3 nimetatud aruanded kinnitamiseks nõukogule nelja kuu jooksul pärast majandusaasta lõppemist. Enne käesoleva paragrahvi lõikes 3 ettenähtud raamatupidamise aastaaruande esitamist nõukogule kinnitamiseks esitab juhatus aruande audiitorile kontrollimiseks.",
      "rdfs:label": {
        "@value": "EESTI_Par_43 (redaktsioon 113032014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014012",
      "estleg:supersededByVersion": {
        "@id": "estleg:EESTI_Par_43_v127122016022"
      },
      "estleg:versionValidTo": {
        "@value": "2016-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014012",
      "estleg:sourceAct": "Eesti Haigekassa seadus",
      "estleg:provisionRef": "EESTI § 43",
      "estleg:partOfAct": {
        "@id": "estleg:EESTI_Map_2026"
      }
    },
    {
      "@id": "estleg:EESTI_Par_43_v127122016022",
      "@type": [
