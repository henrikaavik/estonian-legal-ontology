    {
      "@id": "estleg:EESTI_Par_41_v26422",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haigekassa lähtub raamatupidamise korraldamisel raamatupidamise seadusest (RT I 1994, 48, 790; 1995, 26-28, 355; 92, 1604; 1996, 40, 773; 42, 811; 49, 953; 1998, 59, 941; 1999, 55, 584; 101, 903), raamatupidamise korraldamise ja raamatupidamisandmete õigsuse eest isikliku vastutuse kehtestamise seadusest (RT I 1993, 43, 620; 1996, 6, 101), teistest õigusaktidest ja haigekassa põhikirjast. (2) Haigekassa kasutab raamatupidamises rahandusministri poolt kinnitatud bilansi- ja kasumiaruande skeeme.",
      "rdfs:label": {
        "@value": "EESTI_Par_41 (redaktsioon 26422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26422",
      "estleg:supersededByVersion": {
