    {
      "@id": "estleg:EESTI_Par_37_v123122011007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haigekassa kassatagavara on haigekassa rahalised vahendid, välja arvatud reservkapitali vahendid, mida kasutatakse haigekassa rahavoogude juhtimiseks. (2) Kehtetu - (3) Kehtetu - (4) Kehtetu -",
      "rdfs:label": {
        "@value": "EESTI_Par_37 (redaktsioon 123122011007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122011007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122011007",
      "estleg:sourceAct": "Eesti Haigekassa seadus",
      "estleg:provisionRef": "EESTI § 37",
