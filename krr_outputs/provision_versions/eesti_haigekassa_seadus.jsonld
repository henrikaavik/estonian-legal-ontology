      }
    },
    {
      "@id": "estleg:EESTI_Par_21_v833252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EESTI_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõukogu liikmetele, kes ei kuulu nõukogusse ametikoha järgi või kes ei ole Riigikogu poolt määratud, makstakse nõukogu liikme kohustuste täitmise eest tasu",
      "rdfs:label": {
        "@value": "EESTI_Par_21 (redaktsioon 833252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "833252",
