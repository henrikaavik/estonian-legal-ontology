      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigekassa asukoht on Tallinn. Haigekassa aadress on koht, kus asub haigekassa juhatus.",
      "rdfs:label": {
        "@value": "EESTI_Par_7 (redaktsioon 26422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26422",
