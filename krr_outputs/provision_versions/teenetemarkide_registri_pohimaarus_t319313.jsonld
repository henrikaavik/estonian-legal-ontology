        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri vastutav töötleja on Vabariigi Presidendi Kantselei. Registri vastutav töötleja on Vabariigi Presidendi Kantselei.",
      "rdfs:label": {
        "@value": "Reg_319313_Par_2 (redaktsioon 319313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "319313",
