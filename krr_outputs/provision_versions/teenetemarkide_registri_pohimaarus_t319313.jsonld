    {
      "@id": "estleg:Reg_319313_Par_3_v319313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_319313_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Registri pidamise eesmärk on tagada korrastatud ülevaade isikutest, kellele, milliste teenete eest ja millise riikliku teenetemärgi on Vabariigi President andnud. Registri pidamise eesmärk on tagada ka ülevaade selle kohta, millised välisriigid on millistele Eesti kodanikele ja milliste teenete eest au- või teenetemärgi andnud. Registri pidamise eesmärk on tagada korrastatud ülevaade isikutest, kellele, milliste teenete eest ja millise riikliku teenetemärgi on Vabariigi President andnud. Registri pidamise eesmärk on tagada ka ülevaade selle kohta, millised välisriigid on millistele Eesti kodanikele ja milliste teenete eest au- või teenetemärgi andnud. 2(2)Registri ülesanne on tagada Vabariigi Presidendilt teenetemärgi saanud isikute ja välisriigilt au- või teenetemärgi saanud Eesti kodanike ning nendele antud teenetemärkide kohta teabe kättesaadavus selleks õigustatud isikutele ja asutustele. Registri ülesanne on tagada Vabariigi Presidendilt teenetemärgi saanud isikute ja välisriigilt au- või teenetemärgi saanud Eesti kodanike ning nendele antud teenetemärkide kohta teabe kättesaadavus selleks õigustatud isikutele ja asutustele.",
      "rdfs:label": {
        "@value": "Reg_319313_Par_3 (redaktsioon 319313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "319313",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/319313",
      "estleg:sourceAct": "Teenetemärkide registri põhimäärus",
      "estleg:provisionRef": "Reg_319313 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_319313_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_319313_Par_4_v319313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
