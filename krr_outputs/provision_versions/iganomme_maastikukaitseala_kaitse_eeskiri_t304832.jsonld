    {
      "@id": "estleg:Reg_304832_Par_2_v304832",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_304832_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Rapla maakonnas Märjamaa vallas Laukna külas. Kaitseala asub Rapla maakonnas Märjamaa vallas Laukna külas. 2 (2) Kaitseala välispiir on esitatud kaardil määruse lisas4. Kaitseala välispiir on esitatud kaardil määruse lisas4.",
