      "estleg:sourceAct": "Võlgade ümberkujundamise ja võlakaitse seadus",
      "estleg:provisionRef": "VÕVS § 49",
      "estleg:partOfAct": {
        "@id": "estleg:VOVS_Map"
      }
    },
    {
      "@id": "estleg:VOVS_Par_5_v106122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOVS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võlgade ümberkujundamise menetlusele kohaldatakse tsiviilkohtumenetluse seadustikus hagita menetluse kohta sätestatut, kui käesolevast seadusest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "VÕVS_Par_5 (redaktsioon 106122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106122010001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106122010001",
      "estleg:sourceAct": "Võlgade ümberkujundamise ja võlakaitse seadus",
      "estleg:provisionRef": "VÕVS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:VOVS_Map"
      }
    },
    {
      "@id": "estleg:VOVS_Par_50_v106122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOVS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2011. aasta 5. aprillil.",
      "rdfs:label": {
        "@value": "VÕVS_Par_50 (redaktsioon 106122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106122010001",
