    {
      "@id": "estleg:Reg_158811_Par_13_v158811",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158811_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Telkimine ja lõkke tegemine piiranguvööndis on lubatud ainult kaitseala valitseja nõusolekul selleks ettevalmistatud ja tähistatud paikades. Õuemaal on lubatud telkida ja lõket teha omaniku loal. Telkimine ja lõkke tegemine piiranguvööndis on lubatud ainult kaitseala valitseja nõusolekul selleks ettevalmistatud ja tähistatud paikades. Õuemaal on lubatud telkida ja lõket teha omaniku loal.",
      "rdfs:label": {
        "@value": "Reg_158811_Par_13 (redaktsioon 158811)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158811",
