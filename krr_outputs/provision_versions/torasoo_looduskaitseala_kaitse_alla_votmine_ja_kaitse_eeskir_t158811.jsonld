    {
      "@id": "estleg:Reg_158811_Par_14_v158811",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158811_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on keelatud: 1 1) maavara kaevandamine; 2 2) uue maaparandussüsteemi rajamine; 3 3) biotsiidi ja taimekaitsevahendi kasutamine; 4 4) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 5 5) puhtpuistute kujundamine ja energiapuistute rajamine. Piiranguvööndis on keelatud: maavara kaevandamine; uue maaparandussüsteemi rajamine; biotsiidi ja taimekaitsevahendi kasutamine; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; puhtpuistute kujundamine ja energiapuistute rajamine. 2 (2) Piiranguvööndis on kaitseala valitseja nõusolekuta keelatud: 1 1) ehitise, kaasa arvatud ajutise ehitise püstitamine; 2 2) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine. Piiranguvööndis on kaitseala valitseja nõusolekuta keelatud: ehitise, kaasa arvatud ajutise ehitise püstitamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine.",
      "rdfs:label": {
        "@value": "Reg_158811_Par_14 (redaktsioon 158811)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158811",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158811",
      "estleg:sourceAct": "Tõrasoo looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158811 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158811_Map"
      }
    },
