      },
      "estleg:versionText": "Määrusega sätestatakse piirhindade arvutamise metoodika, piirhindade kehtestamise tähtajad, piirhindade muutmise tingimused ja tähtajad. Määrusega sätestatakse piirhindade arvutamise metoodika, piirhindade kehtestamise tähtajad, piirhindade muutmise tingimused ja tähtajad.",
      "rdfs:label": {
        "@value": "Reg_1000136_Par_1 (redaktsioon 1000136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000136",
