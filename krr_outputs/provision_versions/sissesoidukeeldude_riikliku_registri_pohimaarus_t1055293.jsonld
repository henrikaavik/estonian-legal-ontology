    {
      "@id": "estleg:Reg_1055293_Par_10_v1055293",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055293_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu andmeandjad on: 1 1) Politsei- ja Piirivalveamet ning Kaitsepolitseiamet, kui sissesõidukeeldu on kohaldatud lahkumisettekirjutuses; 2 2) kohus, kui sissesõidukeeld on mõistetud lisakaristusena või määratud Eestist lahkumise kokkuleppes; 3 3) Siseministeerium, kui sissesõidukeeldu on kohaldatud väljasõidukohustuse ja sissesõidukeelu seaduse 5. peatüki alusel; 4 4) Välisministeerium, kui sissesõidukeeld on kehtestatud rahvusvahelise sanktsioonina; 5 5) Eestis seadusliku aluseta viibivate ja viibinud välismaalaste andmekogu, mis edastab andmekogule välismaalase isikuandmed, dokumendiandmed ja sissesõidukeelu andmed. Andmekogu andmeandjad on: Politsei- ja Piirivalveamet ning Kaitsepolitseiamet, kui sissesõidukeeldu on kohaldatud lahkumisettekirjutuses; kohus, kui sissesõidukeeld on mõistetud lisakaristusena või määratud Eestist lahkumise kokkuleppes; Siseministeerium, kui sissesõidukeeldu on kohaldatud väljasõidukohustuse ja sissesõidukeelu seaduse 5. peatüki alusel; Välisministeerium, kui sissesõidukeeld on kehtestatud rahvusvahelise sanktsioonina; Eestis seadusliku aluseta viibivate ja viibinud välismaalaste andmekogu, mis edastab andmekogule välismaalase isikuandmed, dokumendiandmed ja sissesõidukeelu andmed.",
      "rdfs:label": {
        "@value": "Reg_1055293_Par_10 (redaktsioon 1055293)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055293",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055293",
