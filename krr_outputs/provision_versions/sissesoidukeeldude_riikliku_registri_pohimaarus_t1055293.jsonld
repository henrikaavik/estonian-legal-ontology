      }
    },
    {
      "@id": "estleg:Reg_1055293_Par_9_v1055293",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055293_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse teevad päringuid järgmised andmekogud: 1 1) isikut tõendavate dokumentide andmekogu; 2 2) infosüsteem POLIS; 3 3) riiklik rahvusvahelise kaitse andmise register; 4 4) piirikontrolli infosüsteem; 5 5) Eesti kodakondsuse saanud, taastanud või kaotanud isikute andmekogu; 6 6) viisaregister; 7 7) välismaalase lühiajalise Eestis töötamise registreerimise andmekogu; 8 8) elamislubade ja töölubade register; 9 9) Eestis seadusliku aluseta viibivate ja viibinud välismaalaste andmekogu; 10 10) migratsioonijärelevalve andmekogu. RT I 2024-05-31 1 131052024001 2024-06-03 Andmekogusse teevad päringuid järgmised andmekogud: isikut tõendavate dokumentide andmekogu; infosüsteem POLIS; riiklik rahvusvahelise kaitse andmise register; piirikontrolli infosüsteem; Eesti kodakondsuse saanud, taastanud või kaotanud isikute andmekogu; viisaregister; välismaalase lühiajalise Eestis töötamise registreerimise andmekogu; elamislubade ja töölubade register; Eestis seadusliku aluseta viibivate ja viibinud välismaalaste andmekogu; migratsioonijärelevalve andmekogu. 2 (2) Käesoleva paragrahvi lõikes 1 nimetatud andmekogud teevad andmekogusse päringuid selleks, et kontrollida, kas välismaalase suhtes on kohaldatud sissesõidukeeldu. Käesoleva paragrahvi lõikes 1 nimetatud andmekogud teevad andmekogusse päringuid selleks, et kontrollida, kas välismaalase suhtes on kohaldatud sissesõidukeeldu.",
      "rdfs:label": {
        "@value": "Reg_1055293_Par_9 (redaktsioon 1055293)",
        "@language": "et"
