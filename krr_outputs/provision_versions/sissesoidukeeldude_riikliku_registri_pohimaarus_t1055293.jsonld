      "estleg:provisionRef": "Reg_1055293 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055293_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055293_Par_11_v1055293",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
