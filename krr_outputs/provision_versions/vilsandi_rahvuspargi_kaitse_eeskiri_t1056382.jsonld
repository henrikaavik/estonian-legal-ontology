      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 12. juuli 2022. a käskkirjaga nr 1-2/22/221 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 12. juuli 2022. a käskkirjaga nr 1-2/22/221 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1056382_Par_23 (redaktsioon 1056382)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056382",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056382",
      "estleg:sourceAct": "Vilsandi rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056382 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056382_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056382_Par_24_v1056382",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056382_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1056382_Par_24 (redaktsioon 1056382)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056382",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056382",
      "estleg:sourceAct": "Vilsandi rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056382 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056382_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056382_Par_3_v1056382",
      "@type": [
        "owl:NamedIndividual",
