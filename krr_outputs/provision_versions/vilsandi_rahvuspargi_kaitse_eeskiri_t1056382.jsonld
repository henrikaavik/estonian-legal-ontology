      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1056382_Par_3 (redaktsioon 1056382)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056382",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056382",
      "estleg:sourceAct": "Vilsandi rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056382 § 3",
