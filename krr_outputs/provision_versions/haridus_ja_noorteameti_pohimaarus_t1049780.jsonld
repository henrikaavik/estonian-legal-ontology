      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist moodustatud Eesti Kõrg- ja Kutsehariduse Kvaliteediagentuuri kõrghariduse hindamisnõukogu ja kutsehariduse hindamisnõukogu ning vaidekomisjonide volitused kehtivad kuni nende kogude moodustamisel määratud tähtaja lõpuni. Enne käesoleva määruse jõustumist moodustatud Eesti Kõrg- ja Kutsehariduse Kvaliteediagentuuri kõrghariduse hindamisnõukogu ja kutsehariduse hindamisnõukogu ning vaidekomisjonide volitused kehtivad kuni nende kogude moodustamisel määratud tähtaja lõpuni.",
      "rdfs:label": {
