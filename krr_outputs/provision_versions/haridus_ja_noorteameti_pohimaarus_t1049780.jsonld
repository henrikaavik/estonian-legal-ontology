      }
    },
    {
      "@id": "estleg:Reg_1049780_Par_18_v1049780",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049780_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haridusuuenduste osakonna põhiülesanded on toetada haridusasutustes innovaatiliste lahenduste kasutuselevõttu, teadus- ja arendustegevuste elluviimist, tööturu vajadustele vastavate õpivõimaluste arendamist ning pakkumist tehnoloogia- ja teadusmahukates valdkondades. Samuti on ülesanneteks digipädevuste valdkonna juhtimine ja siseriiklike kutsemeistrivõistluste läbiviimine, tegevuste rakendumiseks korraldatakse mh koolitusi ja toetatakse võrgustikutegevusi. RT I 2024-04-23 2 123042024002 2024-05-01 Haridusuuenduste osakonna põhiülesanded on toetada haridusasutustes innovaatiliste lahenduste kasutuselevõttu, teadus- ja arendustegevuste elluviimist, tööturu vajadustele vastavate õpivõimaluste arendamist ning pakkumist tehnoloogia- ja teadusmahukates valdkondades. Samuti on ülesanneteks digipädevuste valdkonna juhtimine ja siseriiklike kutsemeistrivõistluste läbiviimine, tegevuste rakendumiseks korraldatakse mh koolitusi ja toetatakse võrgustikutegevusi.",
      "rdfs:label": {
        "@value": "Reg_1049780_Par_18 (redaktsioon 1049780)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049780",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049780",
