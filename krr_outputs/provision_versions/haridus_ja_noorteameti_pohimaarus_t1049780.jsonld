    {
      "@id": "estleg:Reg_1049780_Par_1_v1049780",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049780_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haridus- ja Noorteamet (edaspidi amet) on Haridus ja Teadusministeeriumi (edaspidi ministeerium) valitsemisalas tegutsev valitsusasutus. Haridus- ja Noorteamet (edaspidi amet) on Haridus ja Teadusministeeriumi (edaspidi ministeerium) valitsemisalas tegutsev valitsusasutus. 2 (2) Ülesannete täitmisel esindab amet riiki. Ülesannete täitmisel esindab amet riiki.",
      "rdfs:label": {
        "@value": "Reg_1049780_Par_1 (redaktsioon 1049780)",
        "@language": "et"
      },
