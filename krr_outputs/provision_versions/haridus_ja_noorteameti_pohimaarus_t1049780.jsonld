      }
    },
    {
      "@id": "estleg:Reg_1049780_Par_27_28_v1049780",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049780_Par_27_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse § 24 lõike 2 alusel 2020. aastal moodustatud kuratooriumi volitused kehtivad kuni 30. oktoobrini 2024. aastal. RT I 2022-06-09 1 109062022001 2022-06-12 Käesoleva määruse § 24 lõike 2 alusel 2020. aastal moodustatud kuratooriumi volitused kehtivad kuni 30. oktoobrini 2024. aastal.",
      "rdfs:label": {
        "@value": "Reg_1049780_Par_27_28 (redaktsioon 1049780)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049780",
