      },
      "estleg:versionText": "Kehtetu - , rakendatakse tagasiulatuvalt 1. septembrist 2021. aastast",
      "rdfs:label": {
        "@value": "Reg_1049780_Par_13 (redaktsioon 1049780)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049780",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049780",
      "estleg:sourceAct": "Haridus- ja Noorteameti põhimäärus",
      "estleg:provisionRef": "Reg_1049780 § 13",
      "estleg:partOfAct": {
