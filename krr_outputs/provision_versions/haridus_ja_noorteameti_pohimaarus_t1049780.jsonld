      }
    },
    {
      "@id": "estleg:Reg_1049780_Par_14_v1049780",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049780_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osakonna põhiülesanneteks on hariduse kvaliteedi, välja arvatud kvaliteedi hindamise, heaks suunatud teenuste osutamine ja arendamine sealhulgas eksamite, testide ja uuringute läbiviimine, õppenõustamise korraldamine, kvalifikatsioonidokumentide kontroll ja hindamine, osalemine hariduse kvaliteedi alases rahvusvahelises koostöös ning eelpool nimetatud tegevustega seotud nõustamine. RT I 2024-04-23 2 123042024002 2024-05-01 Osakonna põhiülesanneteks on hariduse kvaliteedi, välja arvatud kvaliteedi hindamise, heaks suunatud teenuste osutamine ja arendamine sealhulgas eksamite, testide ja uuringute läbiviimine, õppenõustamise korraldamine, kvalifikatsioonidokumentide kontroll ja hindamine, osalemine hariduse kvaliteedi alases rahvusvahelises koostöös ning eelpool nimetatud tegevustega seotud nõustamine.",
      "rdfs:label": {
        "@value": "Reg_1049780_Par_14 (redaktsioon 1049780)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049780",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049780",
      "estleg:sourceAct": "Haridus- ja Noorteameti põhimäärus",
      "estleg:provisionRef": "Reg_1049780 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049780_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049780_Par_15_v1049780",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049780_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1049780_Par_15 (redaktsioon 1049780)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049780",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049780",
      "estleg:sourceAct": "Haridus- ja Noorteameti põhimäärus",
      "estleg:provisionRef": "Reg_1049780 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049780_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049780_Par_16_v1049780",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049780_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Osakonna põhiülesanneteks on haridus- ja noortevaldkonna arendamisele ja rahvusvahelistumisele suunatud teenuste pakkumine, sealhulgas erinevate toetusmeetmete ja programmide elluviimine ning stipendiumide vahendamine, koolitustegevuste korraldamine, auhindade andmine, võrgustike koordineerimine või nende töös osalemine, teabe vahendamine, uuringute kavandamine ja elluviimine ning turundustegevuste ja -programmide elluviimine. Osakonna põhiülesanneteks on haridus- ja noortevaldkonna arendamisele ja rahvusvahelistumisele suunatud teenuste pakkumine, sealhulgas erinevate toetusmeetmete ja programmide elluviimine ning stipendiumide vahendamine, koolitustegevuste korraldamine, auhindade andmine, võrgustike koordineerimine või nende töös osalemine, teabe vahendamine, uuringute kavandamine ja elluviimine ning turundustegevuste ja -programmide elluviimine. 2 (2) Osakonna juht moodustab Erasmus+ ja Euroopa Solidaarsuskorpuse programmiga seotud tegevustega seonduvalt alalisi ja ajutisi nõuandva õigusega komisjone, nõukogusid ja töörühmi. Komisjonid, nõukogud ja töörühmad moodustatakse osakonna juhi korraldusega, milles määratakse nende liikmed, ülesanded ja nende täitmise tähtajad ning töökord. RT I 2024-04-23 2 123042024002 2024-05-01 Osakonna juht moodustab Erasmus+ ja Euroopa Solidaarsuskorpuse programmiga seotud tegevustega seonduvalt alalisi ja ajutisi nõuandva õigusega komisjone, nõukogusid ja töörühmi. Komisjonid, nõukogud ja töörühmad moodustatakse osakonna juhi korraldusega, milles määratakse nende liikmed, ülesanded ja nende täitmise tähtajad ning töökord.",
      "rdfs:label": {
        "@value": "Reg_1049780_Par_16 (redaktsioon 1049780)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049780",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049780",
      "estleg:sourceAct": "Haridus- ja Noorteameti põhimäärus",
      "estleg:provisionRef": "Reg_1049780 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049780_Map"
      }
    },
    {
