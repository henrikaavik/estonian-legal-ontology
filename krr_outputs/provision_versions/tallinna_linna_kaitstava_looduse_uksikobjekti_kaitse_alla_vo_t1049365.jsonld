    {
      "@id": "estleg:Reg_1049365_Par_2_v1049365",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049365_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tallinna linnas Pirita linnaosas Tuulenurga tn 6 võetakse kaitstava looduse üksikobjektina kaitse alla Windecki punane tamm (Quercus rubra) ja määratakse sellele piiranguvöönd, mille ulatus on 20 meetrit ja mille piir on esitatud kaardil määruse lisas1. Tallinna linnas Pirita linnaosas Tuulenurga tn 6 võetakse kaitstava looduse üksikobjektina kaitse alla Windecki punane tamm (Quercus rubra) ja määratakse sellele piiranguvöönd, mille ulatus on 20 meetrit ja mille piir on esitatud kaardil määruse lisas1.",
      "rdfs:label": {
        "@value": "Reg_1049365_Par_2 (redaktsioon 1049365)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049365",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049365",
      "estleg:sourceAct": "Tallinna linna kaitstava looduse üksikobjekti kaitse alla võtmine ja selle piiranguvööndi ulatus ning kaitstava looduse üksikobjekti kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1049365 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049365_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049365_Par_3_v1049365",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049365_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitstava looduse üksikobjekti hävimise tõttu arvatakse kaitse alt välja Tallinnas A. Weizenbergi ja Narva mnt ristmiku nurgal kasvanud must pappel (KLO4000065)2. Kaitstava looduse üksikobjekti hävimise tõttu arvatakse kaitse alt välja Tallinnas A. Weizenbergi ja Narva mnt ristmiku nurgal kasvanud must pappel (KLO4000065)2. 2 (2) Punktis 1 nimetatud kaitstava looduse üksikobjekti kaitse alt välja arvamisega seoses tunnistatakse kehtetuks Tallinna Linnavalitsuse 28. mai 1993. a määruse nr 105 „Linnapuude, parkide ja aedade looduskaitse alla võtmine” nimekirja tabelis 1 „Looduskaitse all olevate üksikpuude ja puudegruppide nimekiri” punkt 28. Punktis 1 nimetatud kaitstava looduse üksikobjekti kaitse alt välja arvamisega seoses tunnistatakse kehtetuks Tallinna Linnavalitsuse 28. mai 1993. a määruse nr 105 „Linnapuude, parkide ja aedade looduskaitse alla võtmine” nimekirja tabelis 1 „Looduskaitse all olevate üksikpuude ja puudegruppide nimekiri” punkt 28.",
      "rdfs:label": {
        "@value": "Reg_1049365_Par_3 (redaktsioon 1049365)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049365",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049365",
      "estleg:sourceAct": "Tallinna linna kaitstava looduse üksikobjekti kaitse alla võtmine ja selle piiranguvööndi ulatus ning kaitstava looduse üksikobjekti kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1049365 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049365_Map"
      }
    },
