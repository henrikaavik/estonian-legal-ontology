    {
      "@id": "estleg:Reg_1049365_Par_8_v1049365",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049365_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 28. augusti 2018. a käskkirjaga nr 1-2/18/652 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 28. augusti 2018. a käskkirjaga nr 1-2/18/652 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1049365_Par_8 (redaktsioon 1049365)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049365",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049365",
      "estleg:sourceAct": "Tallinna linna kaitstava looduse üksikobjekti kaitse alla võtmine ja selle piiranguvööndi ulatus ning kaitstava looduse üksikobjekti kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1049365 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049365_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049365_Par_9_v1049365",
      "@type": [
        "owl:NamedIndividual",
