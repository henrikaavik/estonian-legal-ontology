      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tallinna linna kaitstava looduse üksikobjekti kaitse alla võtmine ja selle piiranguvööndi ulatus ning kaitstava looduse üksikobjekti kaitse alt väljaarvamine (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tallinna linna kaitstava looduse üksikobjekti kaitse alla võtmine ja selle piiranguvööndi ulatus ning kaitstava looduse üksikobjekti kaitse alt väljaarvamine"
    },
