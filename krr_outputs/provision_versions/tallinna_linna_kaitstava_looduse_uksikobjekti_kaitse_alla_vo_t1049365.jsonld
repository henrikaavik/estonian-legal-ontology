    {
      "@id": "estleg:Reg_1049365_Par_5_v1049365",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049365_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitstavate looduse üksikobjektide kaitsekord on kehtestatud keskkonnaministri 1. märtsi 2023. a määrusega nr 10 „Kaitstavate looduse üksikobjektide kaitse-eeskiri”. RT I 2023-03-14 1 114032023001 2023-03-20 Kaitstavate looduse üksikobjektide kaitsekord on kehtestatud keskkonnaministri 1. märtsi 2023. a määrusega nr 10 „Kaitstavate looduse üksikobjektide kaitse-eeskiri”.",
      "rdfs:label": {
        "@value": "Reg_1049365_Par_5 (redaktsioon 1049365)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049365",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049365",
      "estleg:sourceAct": "Tallinna linna kaitstava looduse üksikobjekti kaitse alla võtmine ja selle piiranguvööndi ulatus ning kaitstava looduse üksikobjekti kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1049365 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049365_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049365_Par_6_v1049365",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049365_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas3 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti piiranguvööndi ulatuse kohta; 5 5) loodusobjekti kaitse alt väljaarvamise kohta. Määruse seletuskirjas3 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti piiranguvööndi ulatuse kohta; loodusobjekti kaitse alt väljaarvamise kohta.",
      "rdfs:label": {
        "@value": "Reg_1049365_Par_6 (redaktsioon 1049365)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049365",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049365",
      "estleg:sourceAct": "Tallinna linna kaitstava looduse üksikobjekti kaitse alla võtmine ja selle piiranguvööndi ulatus ning kaitstava looduse üksikobjekti kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1049365 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049365_Map"
      }
    },
    {
