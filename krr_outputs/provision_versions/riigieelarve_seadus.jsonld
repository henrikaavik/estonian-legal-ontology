        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_80_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kuni käesoleva seaduse jõustumiseni kehtinud riigieelarve seaduse § 10 lõike 2 alusel antud kehtib pärast käesoleva seaduse jõustumist niivõrd, kuivõrd ta ei ole vastuolus käesoleva seadusega, kuni selle kehtetuks tunnistamiseni käesoleva seaduse § 20 lõikes 5 nimetatud määrusega. (2) Riigieelarves ministeeriumi valitsemisalas kavandatud toetusfondi vahendite jaotamisele kohaldatakse käesoleva seaduse § 48 lõike 4 alusel kehtestatavat määrust alates 2017. aasta 1. jaanuarist. (3) Käesoleva seaduse § 60 lõiget 3 kohaldatakse esmakordselt 2015. aasta riigieelarve seaduse suhtes.",
      "rdfs:label": {
        "@value": "REELS_Par_80 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_80_v107072017041"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 80",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_80_v107072017041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kuni käesoleva seaduse jõustumiseni kehtinud riigieelarve seaduse § 10 lõike 2 alusel antud määrus kehtib pärast käesoleva seaduse jõustumist niivõrd, kuivõrd ta ei ole vastuolus käesoleva seadusega, kuni selle kehtetuks tunnistamiseni käesoleva seaduse § 20 lõikes 5 nimetatud määrusega. (2) Riigieelarves ministeeriumi valitsemisalas kavandatud toetusfondi vahendite jaotamisele kohaldatakse käesoleva seaduse § 48 lõike 4 alusel kehtestatavat määrust alates 2017. aasta 1. jaanuarist. (3) Käesoleva seaduse § 60 lõiget 3 kohaldatakse esmakordselt 2015. aasta riigieelarve seaduse suhtes.",
      "rdfs:label": {
        "@value": "REELS_Par_80 (redaktsioon 107072017041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072017041",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107072017041",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 80",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_81_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse jõustumisest alates ei kohaldata 2014. aasta riigieelarve seaduse § 2 lõiget 12 ning §-e 4, 6–10, 12, 14 ja 16. (2) Käesoleva seaduse § 69 lõikes 2 nimetatud riigi võlakohustuste suurim lubatud kogujääk on 2014. aastal 2 500 000 000 eurot. (3) Käesoleva seaduse § 61 lõikes 5 nimetatud Vabariigi Valitsuse antavate laenude ja riigigarantiide suurim lubatud jääk 2014. aastal on 610 000 000 eurot.",
      "rdfs:label": {
        "@value": "REELS_Par_81 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_81_1_v107072017036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_81_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 331 lõiget 5 kohaldatakse esmakordselt 2020. aasta riigieelarve seaduse suhtes. (2) Käesoleva seaduse § 251, § 26 lõigete 1, 2, 3, 5 ja 6, § 29 lõigete 2 ja 3, § 30, § 31 lõigete 2 ja 3, § 32 lõike 4, §-de 331, 34, 341, 342 ja 35–37, § 38 lõike 3 ning § 58 lõigete 1 ja 11 2020. aasta 1. jaanuaril jõustuvaid redaktsioone kohaldatakse esmakordselt 2020. aasta riigieelarve seaduse suhtes.",
      "rdfs:label": {
        "@value": "REELS_Par_81_1 (redaktsioon 107072017036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072017036",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107072017036",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 81_1",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_81_2_v121042020029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_81_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eriolukorra tõttu käesoleva seaduse § 531 alusel kehtestatavate toetusmeetmete üldtingimused kehtestab määrusega. (2) Minister lähtub eriolukorra tõttu käesoleva seaduse § 531 alusel toetusprogrammide kehtestamisel käesoleva paragrahvi lõikes 1 nimetatud üldtingimustest.",
      "rdfs:label": {
        "@value": "REELS_Par_81_2 (redaktsioon 121042020029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121042020029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121042020029",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 81_2",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_81_3_v117042021004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_81_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) COVID-19 põhjustava viiruse levikuga seotud kriisi leevendamiseks ettenähtud toetusprogrammide üldtingimused kehtestab määrusega. (2) lähtub COVID-19 põhjustava viiruse levikuga seotud kriisi leevendamise toetusprogrammide kehtestamisel käesoleva paragrahvi lõikes 1 nimetatud üldtingimustest.",
      "rdfs:label": {
        "@value": "REELS_Par_81_3 (redaktsioon 117042021004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117042021004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117042021004",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 81_3",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_81_4_v107122021004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_81_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse 2021. aasta 15. detsembril jõustunud redaktsiooni § 26 lõikeid 5, 7 ja 8 kohaldatakse esmakordselt 2022. aasta riigieelarve liigendamisele.",
      "rdfs:label": {
        "@value": "REELS_Par_81_4 (redaktsioon 107122021004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107122021004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107122021004",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 81_4",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_81_5_v128112024003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_81_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse 2024. aasta 20. novembril vastuvõetud redaktsiooni § 26 lõikeid 51, 52 ja 8 kohaldatakse esmakordselt 2025. aasta riigieelarve liigendamisele.",
      "rdfs:label": {
        "@value": "REELS_Par_81_5 (redaktsioon 128112024003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128112024003",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_81_5_v119122025002"
      },
      "estleg:versionValidTo": {
        "@value": "2025-12-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128112024003",
