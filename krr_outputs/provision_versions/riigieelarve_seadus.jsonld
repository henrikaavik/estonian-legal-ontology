      },
      "estleg:versionValidTo": {
        "@value": "2025-12-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 52",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_52_v119122025002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui toetuse andja ei ole ette näinud toetusfondi või juhtumipõhise toetuse kasutamata jäänud vahendite tagastamist riigile, võib kohaliku omavalitsuse üksus neid kasutada järgmistel eelarveaastatel samal otstarbel.",
