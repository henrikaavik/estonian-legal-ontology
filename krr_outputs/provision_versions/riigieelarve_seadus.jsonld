      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "REELS_Par_7 (redaktsioon 112112010003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010003",
      "estleg:supersededByVersion": {
