        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 7 lõikes 2 nimetatud meetmete rakendamist ja §-s 8 nimetatud ülejäägi planeerimist võib edasi lükata erakorraliste asjaolude korral vastavalt stabiilsuse ja kasvu paktile.",
      "rdfs:label": {
        "@value": "REELS_Par_9 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
