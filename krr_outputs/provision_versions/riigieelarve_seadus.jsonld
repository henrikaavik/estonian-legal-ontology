        "@value": "2025-12-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128112024003",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 56",
