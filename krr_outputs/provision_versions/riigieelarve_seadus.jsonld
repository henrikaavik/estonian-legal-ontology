      },
      "estleg:versionValidTo": {
        "@value": "2014-03-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112112010003",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 52",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_52_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui toetuse andja ei ole ette näinud toetusfondi või juhtumipõhise toetuse kasutamata jäänud vahendite tagastamist riigieelarvesse, võib kohaliku omavalitsuse üksus neid kasutada järgmistel eelarveaastatel samal otstarbel.",
      "rdfs:label": {
        "@value": "REELS_Par_52 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
