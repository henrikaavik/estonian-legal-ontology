      }
    },
    {
      "@id": "estleg:REELS_Par_45_v22451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigieelarve täitmise aruande koostisse kuuluvad: riigieelarve tulude ja kulude täitmise aruanne; riigieelarve vahendite olemi ja paigutuse aruanne eelarveaasta alguse ja lõpu seisuga; eelarveaasta lõpuks täitmata rahaliste kohustuste loetelu; ülevaade käesoleva seaduse paragrahv 8 lõike 4 alusel ülekantud ja lõikes 3 sätestatud arvestuslikest kuludest; Vabariigi Valitsuse reservi kasutamise aruanne; riigi varaliste kohustuste aruanne; riiklikuks pensionikindlustuseks ja riiklikuks ravikindlustuseks ettenähtud vahendite laekumise ja kasutamise aruanne; stabiliseerimisreservi haldamise aruanne",
      "rdfs:label": {
        "@value": "REELS_Par_45 (redaktsioon 22451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22451",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_45_v183802"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22451",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 45",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_45_v183802",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigieelarve täitmise aruande koostisse kuuluvad: riigieelarve tulude ja kulude täitmise aruanne; Kehtetu - eelarveaasta lõpuks täitmata rahaliste kohustuste loetelu; ülevaade käesoleva seaduse § 8 lõike 4 alusel ülekantud ja lõikes 3 sätestatud arvestuslikest kuludest; Vabariigi Valitsuse reservi kasutamise aruanne; riigi varaliste kohustuste aruanne; Kehtetu - stabiliseerimisreservi haldamise aruanne; tegevuskavade täitmise aruanne.",
      "rdfs:label": {
        "@value": "REELS_Par_45 (redaktsioon 183802)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "183802",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_45_v733542"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/183802",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 45",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_45_v733542",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi majandusaasta aruanded on riigiraamatupidamiskohustuslaste majandusaasta aruanded ja riigi majandusaasta koondaruanne, mille koostab Rahandusministeerium. Aruanded koostatakse vastavalt raamatupidamise seadusele (RT I 2002, 102, 600). (2) Riigieelarve täitmise aruanne on vastavalt raamatupidamise seaduse § 38 lõikes 1 sätestatule riigi majandusaasta koondaruandesse kuuluva riigi raamatupidamise aastaaruande osa. (3) Riigi majandusaasta aruande auditi ja põhiseaduslike institutsioonide majandusaasta aruannete auditi viib läbi Riigikontroll. Ministeeriumi ja maavalitsuse majandusaasta aruande auditi viib läbi vastava riigiraamatupidamiskohustuslase siseauditi eest vastutav isik, kes annab hinnangu riigiraamatupidamiskohustuslase majandusaasta aruande õigsuse ja tehingute seaduslikkuse kohta. Riigikontroll võib riigi majandusaasta aruande auditi käigus toetuda riigiraamatupidamiskohustuslase siseauditi eest vastutava isiku hinnangule riigiraamatupidamiskohustuslase majandusaasta aruande õigsuse ja tehingute seaduslikkuse kohta. (4) Riigikontrolli majandusaasta aruande audiitorkontrolli viib läbi Riigikogu poolt vastavalt riigikontrolli seadusele (RT I 2002, 21, 117; 57, 356; 2003, 21, 121) määratud audiitor.",
      "rdfs:label": {
        "@value": "REELS_Par_45 (redaktsioon 733542)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "733542",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_45_v13164364"
      },
      "estleg:versionValidTo": {
        "@value": "2009-04-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/733542",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 45",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_45_v13164364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
