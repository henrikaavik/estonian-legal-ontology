      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ministril ei ole õigust muuta riigieelarves ettenähtud kulude otstarvet. (2) Riigieelarves määratud kulude otstarvet on võimalik muuta vaid riigieelarve muutmise teel.",
      "rdfs:label": {
        "@value": "REELS_Par_25 (redaktsioon 22451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22451",
