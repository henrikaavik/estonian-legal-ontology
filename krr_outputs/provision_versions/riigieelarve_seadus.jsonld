    },
    {
      "@id": "estleg:REELS_Par_10_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seadusega või seaduse alusel peab olema tagatud, et keskvalitsuse juriidilise isiku eelarveaasta lõpu seisuga planeeritud võlakohustuste ja likviidsete varade kogusumma vahe (edaspidi netovõlakoormus) võib moodustada kuni 40 protsenti samaks eelarveaastaks kavandatud põhitegevuse tuludest kogu käesoleva seaduse § 12 alusel esitatud finantsplaaniga hõlmatud perioodi kestel. Netovõlakoormuse üle 40 protsendi suurenemise lubamise otsustab Vabariigi Valitsus, arvestades käesolevas peatükis sätestatud nõudeid. (2) Keskvalitsuse juriidilise isiku võlakohustuste ja likviidsete varade arvutusmetoodika määrusega.",
      "rdfs:label": {
        "@value": "REELS_Par_10 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_10_v129062014131"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_10_v129062014131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seadusega või seaduse alusel peab olema tagatud, et keskvalitsuse juriidilise isiku eelarveaasta lõpu seisuga planeeritud võlakohustuste ja likviidsete varade kogusumma vahe (edaspidi netovõlakoormus) võib moodustada kuni 40 protsenti samaks eelarveaastaks kavandatud põhitegevuse tuludest kogu käesoleva seaduse § 12 alusel esitatud finantsplaaniga hõlmatud perioodi kestel. Netovõlakoormuse üle 40 protsendi suurenemise lubamise otsustab Vabariigi Valitsus, arvestades käesolevas peatükis sätestatud nõudeid. (2) Keskvalitsuse juriidilise isiku võlakohustuste ja likviidsete varade arvutusmetoodika kehtestab määrusega.",
      "rdfs:label": {
        "@value": "REELS_Par_10 (redaktsioon 129062014131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014131",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_11_v22451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ministeeriumi valitsemisala eelarve projekti koostamise aluseks on: käesoleva seaduse paragrahvis 10 nimetatud lähteandmed, normid ja määrad; ministeeriumi eelarve projekt; valitsemisala asutuste eelarvete projekt; seaduse alusel makstavad riiklikud eraldised ja toetused. (2) Kui eelarve projektis nähakse ette kulutusi alustatavale ehitusele või renoveerimisprojektile maksumusega üle ühe miljoni krooni, samuti programmile, tuleb eelarve projektile lisada arvestused ja põhjendused nende kulude üldsumma ja jaotuse kohta eelarveaastate lõikes. (3) Alustatava ehituse või renoveerimisprojekti puhul tuleb lisaks käesoleva paragrahvi lõikes 2 nimetatule esitada ka arvestused valminud või renoveeritud ehitise sisustamise ja majandamise kulude kohta. (4) Ministeeriumi valitsemisala eelarve projekti koostamise tingimused, projekti vormid ja eelarve projekti esitamise tähtaja kehtestab rahandusminister. (5) Ministeeriumi valitsemisala eelarve projekt esitatakse koos seletuskirja ning käesoleva seaduse paragrahv 10 lõikes 1 nimetatud kavadega Rahandusministeeriumile.",
      "rdfs:label": {
        "@value": "REELS_Par_11 (redaktsioon 22451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22451",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_11_v183802"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22451",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_11_v183802",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
