    {
      "@id": "estleg:REELS_Par_34_1_v107122021004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_34_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsus kinnitab eelarvestrateegia ja kiidab heaks riigieelarve eelnõu arvestusega, et need esitatakse Riigikogule hiljemalt kolm kuud enne eelarveaasta algust. (2) Kehtetu - (3) Kehtetu - (4) Kehtetu -",
      "rdfs:label": {
        "@value": "REELS_Par_34_1 (redaktsioon 107122021004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107122021004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107122021004",
