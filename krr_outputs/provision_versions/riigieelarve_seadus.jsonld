      }
    },
    {
      "@id": "estleg:REELS_Par_38_v183802",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigieelarvelised laenud on riigieelarve tulude ja kulude tasakaalustamiseks võetav pikaajaline laen (edaspidi eelarvelaen) ja kassalaen. (2) Riigieelarvelist laenu võetakse laenulepingu sõlmimise või riigi võlakirjade emiteerimise teel. Eelarvelaenu ja kassalaenu võtmiseks riigi võlakirjade emiteerimise korra ja tingimused kehtestab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "REELS_Par_38 (redaktsioon 183802)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "183802",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_38_v693352"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/183802",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
