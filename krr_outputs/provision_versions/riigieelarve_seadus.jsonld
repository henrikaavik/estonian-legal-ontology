      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigieelarve eelnõu koostatakse eelarvestrateegia ja kevadise rahandusprognoosi alusel.",
      "rdfs:label": {
        "@value": "REELS_Par_34 (redaktsioon 107072017041)",
        "@language": "et"
      },
