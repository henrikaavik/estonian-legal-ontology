      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "REELS_Par_8 (redaktsioon 122122023012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122023012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122023012",
