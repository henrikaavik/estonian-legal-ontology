        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_73_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Stabiliseerimisreservi vahendite kasutusele võtmise otsustab Riigikogu Vabariigi Valitsuse ettepanekul. Pärast otsuse tegemist esitab Vabariigi Valitsus Riigikogule lisaeelarve või riigieelarve muutmise eelnõu. Lisaeelarve või riigieelarve muutmise eelnõu menetlemine ei takista Riigikogu otsuse rakendamist. (2) Ulatusliku või kiire majanduslanguse korral või finantskriisi ajal võib Rahandusministeerium Vabariigi Valitsuse nõusolekul stabiliseerimisreservi vahendite arvel ostetud väärtpabereid kasutada kuni kuus kuud riigi võlakohustuste tagamiseks. Selle õiguse kasutamisest teavitab Rahandusministeerium viivitamata Riigikogu.",
      "rdfs:label": {
        "@value": "REELS_Par_73 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_73_v130112022004"
      },
      "estleg:versionValidTo": {
        "@value": "2022-12-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 73",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_73_v130112022004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Stabiliseerimisreservi vahendite kasutusele võtmise otsustab Riigikogu Vabariigi Valitsuse ettepanekul. Pärast otsuse tegemist esitab Vabariigi Valitsus Riigikogule lisaeelarve või riigieelarve muutmise eelnõu. Lisaeelarve või riigieelarve muutmise eelnõu menetlemine ei takista Riigikogu otsuse rakendamist. (2) Ulatusliku või kiire majanduslanguse korral või finantskriisi ajal või Tagatisfondi seaduses sätestatud hoiuste hüvitamise juhtumi korral võib Rahandusministeerium Vabariigi Valitsuse nõusolekul stabiliseerimisreservi vahendite arvel ostetud väärtpabereid kasutada kuni kuus kuud riigi võlakohustuste tagamiseks või anda Tagatisfondile laenu tingimusel, et vahendid tagastatakse koos intressiga. Selle õiguse kasutamise otsuse tegemisest teavitab Rahandusministeerium viivitamata Riigikogu.",
      "rdfs:label": {
        "@value": "REELS_Par_73 (redaktsioon 130112022004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112022004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130112022004",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 73",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_74_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahandusministeerium esitab Riigikontrollile, Vabariigi Valitsusele ja Riigikogu rahanduskomisjonile hiljemalt iga kvartali kümnendal tööpäeval aruande stabiliseerimisreservi varade koosseisu ja väärtuse kohta eelmise kvartali viimase tööpäeva seisuga. (2) Käesoleva paragrahvi lõikes 1 nimetatud aruandes esitatakse vähemalt: stabiliseerimisreservi varade turuväärtus ja selle muutus võrreldes aruandeperioodile eelneva kvartali lõpu ja aruandeaasta algusega; stabiliseerimisreservi sissemaksed ja väljamaksed koondsummadena; stabiliseerimisreservi tulusus; ülevaade stabiliseerimisreservi paigutuste struktuurist finantsvarade, suurimate emitentide ja krediidiasutuste, krediidireitingute, valuuta ja sektorite kaupa; stabiliseerimisreservi investeeringute keskmine kestus. (3) Rahandusministeerium avaldab käesoleva paragrahvi lõikes 1 nimetatud aruande oma kodulehel pärast Vabariigi Valitsuse istungit, kus aruannet arutati.",
      "rdfs:label": {
        "@value": "REELS_Par_74 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 74",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_75_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_75"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahandusministeerium jälgib riigieelarve täitmist ja annab sellest Vabariigi Valitsusele ülevaate vähemalt kaks korda aastas.",
      "rdfs:label": {
        "@value": "REELS_Par_75 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 75",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_76_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Finantskontrollisüsteem on sisekontrollisüsteemi osa, mis hõlmab riigiasutuse eelarvevahendite planeerimist, kasutamist ja kasutamise kontrollimist. Finantskontrollisüsteemi eesmärk on tagada riigieelarve vahendite säästlik, tõhus, mõjus, õiguspärane ja läbipaistev kasutamine. (2) Finantskontrollisüsteemi rakendamise ja selle tulemuslikkuse eest vastutab riigiasutuse juht.",
      "rdfs:label": {
        "@value": "REELS_Par_76 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 76",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_77_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi majandusaasta aruanded on riigiraamatupidamiskohustuslaste majandusaasta aruanne ja riigi majandusaasta koondaruanne. Aruanded koostatakse vastavalt raamatupidamise seadusele. (2) Riigi majandusaasta koondaruande osaks oleva raamatupidamise aastaaruande ja riigiraamatupidamiskohustuslase raamatupidamise aastaaruande auditi teeb Riigikontroll. Riigi ja riigiraamatupidamiskohustuslase tehingute seaduslikkust kontrollib Riigikontroll. (3) Riigikontrolli raamatupidamise aastaaruande auditi teeb ja tehingute seaduslikkust kontrollib Riigikogu poolt vastavalt Riigikontrolli seadusele määratud audiitorettevõtja. (4) Riigikontroll võib käesoleva paragrahvi lõikes 2 nimetatud auditi või tehingute seaduslikkuse kontrolli käigus toetuda riigi konsolideerimisgrupi üksuse raamatupidamise aastaaruande auditis või tehingute seaduslikkuse kontrolli põhjal audiitortegevuse seaduse § 54 tähenduses vormistatud vandeaudiitori aruandes avaldatule.",
      "rdfs:label": {
        "@value": "REELS_Par_77 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_77_v130122015068"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 77",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_77_v130122015068",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi majandusaasta aruanded on Riigikontrolli majandusaasta aruanne ja riigi majandusaasta koondaruanne. Aruanded koostatakse vastavalt raamatupidamise seadusele. (2) Riigi majandusaasta koondaruande osaks oleva raamatupidamise aastaaruande auditi teeb Riigikontroll. Riigi tehingute seaduslikkust kontrollib Riigikontroll. (3) Riigikontrolli raamatupidamise aastaaruande auditi teeb ja tehingute seaduslikkust kontrollib Riigikogu poolt vastavalt Riigikontrolli seadusele määratud audiitorettevõtja. (4) Riigikontroll võib käesoleva paragrahvi lõikes 2 nimetatud auditi või tehingute seaduslikkuse kontrolli käigus toetuda riigi konsolideerimisgrupi üksuse raamatupidamise aastaaruande auditis või tehingute seaduslikkuse kontrolli põhjal audiitortegevuse seaduse § 54 tähenduses vormistatud vandeaudiitori aruandes avaldatule.",
      "rdfs:label": {
        "@value": "REELS_Par_77 (redaktsioon 130122015068)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015068",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015068",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 77",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_78_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigiraamatupidamiskohustuslane, välja arvatud Riigikontroll, koostab majandusaasta aruande ja esitab selle Riigikontrollile hiljemalt aruandeaastale järgneva aasta 30. aprillil. Audiitorkontrolli käigus võib riigiraamatupidamiskohustuslane teha aruandesse parandusi ja täiendusi. (2) Riigikontroll lõpetab riigiraamatupidamiskohustuslase raamatupidamise aastaaruande auditi ja tehingute seaduslikkuse kontrolli hiljemalt aruandeaastale järgneva aasta 30. juunil. (3) Riigiraamatupidamiskohustuslane, välja arvatud Riigikontroll, esitab majandusaasta aruande koos riigiraamatupidamiskohustuslase raamatupidamise aastaaruande auditi ja tehingute seaduslikkuse kontrolli kohta avaldatava Riigikontrolli kontrolliaruandega Rahandusministeeriumile seitsme tööpäeva jooksul pärast Riigikontrollilt aruande saamist ja avalikustab esitatu oma kodulehel. Rahandusminister esitab ministeeriumide majandusaasta aruanded koos Riigikontrolli kontrolliaruannetega seitsme tööpäeva jooksul pärast viimase majandusaasta aruande ja selle juurde kuuluva kontrolliaruande saamist Vabariigi Valitsusele. (4) Käesoleva paragrahvi lõikes 3 sätestatud ministeeriumi majandusaasta aruande kinnitamise otsustab Vabariigi Valitsus hiljemalt majandusaastale järgneva aasta 31. juulil.",
      "rdfs:label": {
        "@value": "REELS_Par_78 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_78_v129062014131"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 78",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_78_v129062014131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigiraamatupidamiskohustuslane, välja arvatud Riigikontroll, koostab majandusaasta aruande ja esitab selle Riigikontrollile hiljemalt aruandeaastale järgneva aasta 30. aprillil. Audiitorkontrolli käigus võib riigiraamatupidamiskohustuslane teha aruandesse parandusi ja täiendusi. (2) Riigikontroll lõpetab riigiraamatupidamiskohustuslase raamatupidamise aastaaruande auditi ja tehingute seaduslikkuse kontrolli hiljemalt aruandeaastale järgneva aasta 30. juunil. (3) Riigiraamatupidamiskohustuslane, välja arvatud Riigikontroll, esitab majandusaasta aruande koos riigiraamatupidamiskohustuslase raamatupidamise aastaaruande auditi ja tehingute seaduslikkuse kontrolli kohta avaldatava Riigikontrolli kontrolliaruandega Rahandusministeeriumile seitsme tööpäeva jooksul pärast Riigikontrollilt aruande saamist ja avalikustab esitatu oma kodulehel. Valdkonna eest vastutav minister esitab ministeeriumide majandusaasta aruanded koos Riigikontrolli kontrolliaruannetega seitsme tööpäeva jooksul pärast viimase majandusaasta aruande ja selle juurde kuuluva kontrolliaruande saamist Vabariigi Valitsusele. (4) Käesoleva paragrahvi lõikes 3 sätestatud ministeeriumi majandusaasta aruande kinnitamise otsustab Vabariigi Valitsus hiljemalt majandusaastale järgneva aasta 31. juulil.",
      "rdfs:label": {
        "@value": "REELS_Par_78 (redaktsioon 129062014131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014131",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_78_v130122015068"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014131",
