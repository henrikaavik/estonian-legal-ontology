      }
    },
    {
      "@id": "estleg:REELS_Par_72_v122122023012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Stabiliseerimisreservi haldamine on stabiliseerimisreservi vahendite hoidmine ja paigutamine. (2) Stabiliseerimisreservi haldamist korraldab Rahandusministeerium. (3) Stabiliseerimisreservi haldamise eesmärk on kehtestatud piirangute raames pikaajaliselt stabiliseerimisreservi vahendite väärtuse kasvatamine ja piisava likviidsuse säilitamine, et vajaduse korral oleks võimalik täita käesoleva seaduse § 71 lõikes 1 nimetatud eesmärke. (4) Stabiliseerimisreservi haldamise ja sellega seonduvate finantsriskide juhtimise põhimõtted kehtestab määrusega.",
      "rdfs:label": {
        "@value": "REELS_Par_72 (redaktsioon 122122023012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122023012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122023012",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 72",
