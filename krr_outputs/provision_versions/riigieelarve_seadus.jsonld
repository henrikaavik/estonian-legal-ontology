      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/183802",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_11_v693352",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(3) Läbirääkimiste kohta koostatakse protokoll, milles fikseeritakse poolte esindajate vahel kooskõlastatud ja kooskõlastamata jäänud eelarve projekti summad, lisades viimaste puhul lahkarvamused. (4) Rahandusminister vaatab läbi ministeeriumi valitsemisala eelarve projekti ja käesoleva paragrahvi lõikes 3 nimetatud protokolli, tehes läbirääkimiste tulemused teatavaks vastavale ministrile. Rahandusministril on õigus teha ministrile ettepanek protokollis fikseeritud summade muutmiseks või väljajätmiseks.",
      "rdfs:label": {
        "@value": "REELS_Par_11 (redaktsioon 693352)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693352",
