      }
    },
    {
      "@id": "estleg:REELS_Par_28_v22451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigieelarve täitmise käigus on Riigikassa kohustatud ministeeriumi taotlusel, mis on kooskõlastatud rahandusministriga, muutma käesoleva seaduse paragrahv 27 lõikes 1 sätestatud jaotust. (2) Riigieelarve täitmise käigus tulude kavandatust väiksema laekumise korral on rahandusministril õigus Riigikassa ettepanekul ajutiselt piirata käesoleva seaduse paragrahvis 27 sätestatud ajalises jaotuses ettenähtud kulude tegemist, teatades sellest Vabariigi Valitsusele.",
      "rdfs:label": {
        "@value": "REELS_Par_28 (redaktsioon 22451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22451",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_28_v183802"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22451",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 28",
