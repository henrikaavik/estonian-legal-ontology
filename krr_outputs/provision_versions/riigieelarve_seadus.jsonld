      "estleg:provisionRef": "REELS § 51",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_52_v22451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2000. aasta 1. jaanuaril, välja arvatud selle 2. ja 3. peatükk, mis jõustuvad Riigi Teatajas avaldamisele järgneval päeval. (2) Riigieelarve täitmise aruanne 1999. aasta kohta koostatakse 1999. aasta riigieelarve koostamisel kehtinud riigieelarve seaduse alusel.",
      "rdfs:label": {
        "@value": "REELS_Par_52 (redaktsioon 22451)",
        "@language": "et"
      },
