      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigieelarve eelnõu menetletakse Riigikogus Riigikogu kodu- ja töökorra seaduse alusel käesolevast seadusest tulenevate erisustega.",
      "rdfs:label": {
        "@value": "REELS_Par_39 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
