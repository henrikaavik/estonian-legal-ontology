    {
      "@id": "estleg:REELS_Par_17_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Makromajandusprognoosi ja rahandusprognoosi koostab Rahandusministeerium käesolevas seaduses ja Euroopa Liidu õiguses esitatud nõuete kohaselt. (2) Makromajandusprognoosi ja rahandusprognoosi koostavad ametnikud või töötajad on prognoosi koostamisel ja koostamise metoodika valikul sõltumatud.",
      "rdfs:label": {
        "@value": "REELS_Par_17 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 17",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_18_v22451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigieelarve eelnõu menetlemine Riigikogus toimub Riigikogu kodukorra seaduses ( RT I 1994, 90, 1517; 1995, 11, 115; 20, 295; 74, 1285; 83, 1440 ja 1444; 1996, 29, 576; 30, 595; 1998, 107, 1765; 1999, 10, 148; 27, 382; 53, 574) sätestatud seaduseelnõude menetlemise korras, kui käesolevas seaduses ei ole sätestatud teisiti. (2) Riigieelarve eelnõu teise lugemise jätkamiseks, kolmandaks lugemiseks ning selle jätkamiseks esitatud muudatusettepanekuid, mida algataja ei toeta ja juhtivkomisjon on jätnud arvestamata, ei panda hääletusele.",
      "rdfs:label": {
        "@value": "REELS_Par_18 (redaktsioon 22451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22451",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_18_v183802"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22451",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_18_v183802",
