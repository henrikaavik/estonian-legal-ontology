      }
    },
    {
      "@id": "estleg:REELS_Par_37_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahandusministeerium esitab riigieelarve eelnõu koos seletuskirjaga Vabariigi Valitsusele hiljemalt neli kuud enne eelarveaasta algust. (2) Põhiseaduslikele institutsioonidele ja nende haldusala asutustele riigieelarve eelnõus ettenähtud vahendite mahtude muutmisel või vahendite väljajätmisel esitab Vabariigi Valitsus tehtud muudatused ja erimeelsused koos põhjendustega riigieelarve eelnõu seletuskirjas. (3) Maakohtutele, halduskohtutele või ringkonnakohtutele riigieelarve eelnõus ettenähtud vahendite mahtude muutmisel või vahendite väljajätmisel esitab Vabariigi Valitsus tehtud muudatused koos kohtute haldamise nõukoja arvamusega riigieelarve eelnõu seletuskirjas.",
      "rdfs:label": {
        "@value": "REELS_Par_37 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_37_v107072017041"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 37",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
