      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119122025002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 25_1",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_26_v22451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium, lähtudes riigieelarves ettenähtud kuludest, teatab oma valitsemisala riigiasutustele nende kulud eelseisvaks eelarveaastaks. Ministril on õigus riigieelarves ettenähtud kulusid täiendavalt liigendada. Kulude täiendavast liigendamisest teatab minister kirjalikult rahandusministrile. Kulude täiendav liigendus või selle muudatus, millest ei ole rahandusministrile kirjalikult teatatud, on kehtetu.",
      "rdfs:label": {
        "@value": "REELS_Par_26 (redaktsioon 22451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22451",
      "estleg:supersededByVersion": {
