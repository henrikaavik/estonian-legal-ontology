      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_37_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Stabiliseerimisreservi kantakse: eelarveaasta lõpuks riigieelarve kulusid ületav tulude summa, mille sihtotstarve ei ole seadusega määratud ja millest on maha arvatud käesoleva seaduse § 8 lõike 4 alusel järgmisesse eelarveaastasse ülekantavad kulud; riigieelarves selleks ettenähtud vahendid; riigivara erastamisest saadud tulu vastavalt erastamisest laekuva raha kasutamise seadusele; tulu riigivara võõrandamisest, kui seaduses ei ole ette nähtud teisiti; riigieelarvesse Eesti Panga kasumist tehtud eraldised; stabiliseerimisreservi haldamisel saadud tulu, mida ei võetud kasutusele käesoleva seaduse §-s 37 9 sätestatud korras; muud laekumised. (2) Stabiliseerimisreservi tehtavad sissemaksed kajastatakse riigieelarves ja selle täitmise aruandes. (3) Käesoleva paragrahvi lõike 1 punktis 1 nimetatud summa kantakse eelarveaasta alguse seisuga stabiliseerimisreservi rahandusministri käskkirja alusel.",
      "rdfs:label": {
        "@value": "REELS_Par_37_1 (redaktsioon 264887)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264887",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_37_1_v693352"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/264887",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 37_1",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_37_1_v693352",
      "@type": [
        "owl:NamedIndividual",
