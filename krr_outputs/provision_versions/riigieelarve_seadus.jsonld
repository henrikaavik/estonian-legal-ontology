    {
      "@id": "estleg:REELS_Par_12_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seadusega või seaduse alusel peab olema tagatud, et keskvalitsuse juriidiline isik esitab igal aastal finantsplaani oma jooksva eelarveaasta, sellele eelnenud eelarveaasta ja järgneva nelja eelarveaasta kohta. Andmed esitatakse asutajaõigusi teostava või valdkonna ministeeriumi vahendusel Rahandusministeeriumile 1. märtsiks. (2) Nõuded finantsplaani sisule ja finantsplaani esitamise korra määrusega.",
      "rdfs:label": {
        "@value": "REELS_Par_12 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_12_v129062014131"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
