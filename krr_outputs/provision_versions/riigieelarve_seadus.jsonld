      }
    },
    {
      "@id": "estleg:REELS_Par_126_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_126"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 47 lõige 3, § 48 lõiked 4–6 ja § 49 jõustuvad 2015. aasta 1. jaanuaril. (2) Käesoleva seaduse § 48 lõige 3, § 50 lõiked 2 ja 3 ning §-d 51 ja 110 jõustuvad 2017. aasta 1. jaanuaril. (3) Käesoleva seaduse §-d 108 ja 120 jõustuvad 2019. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "REELS_Par_126 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
