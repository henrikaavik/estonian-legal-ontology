      }
    },
    {
      "@id": "estleg:REELS_Par_31_v22451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ministeeriumil ja tema valitsemisala riigiasutusel on õigus sõlmida hankelepinguid järgmise aasta assigneeringute arvel kuni 50 protsendi ulatuses jooksvaks eelarveaastaks ettenähtud vastavatest assigneeringutest. (2) Hankelepingute sõlmimise summas, mis ületab käesoleva paragrahvi lõikes 1 nimetatud määra, otsustab rahandusministri ettepanekul Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "REELS_Par_31 (redaktsioon 22451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22451",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_31_v693352"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22451",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_31_v693352",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigiasutus võib sõlmida lepinguid esemete ostmiseks või teenuste, sealhulgas ehitustööde tellimiseks eelseisvate eelarveaastate arvel tingimusel, et ühelgi eesseisval eelarveaastal täitmisele kuuluvate lepingujärgsete maksete maht kokku ei ületa 50 protsenti temale jooksvaks eelarveaastaks ettenähtud vastava kuluartikli summast. (2) Lepingute sõlmimise esemete ostmiseks või teenuste, sealhulgas ehitustööde tellimiseks käesoleva paragrahvi lõikes 1 nimetatud määra ületamisel annab loa rahandusministri ettepanekul Vabariigi Valitsus, kui riigieelarves ei ole ette nähtud teisiti.",
      "rdfs:label": {
        "@value": "REELS_Par_31 (redaktsioon 693352)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693352",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_31_v113032014002"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/693352",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_31_v113032014002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsus liigendab riigieelarves märgitud ministeeriumi valitsemisala investeeringud kinnisasjadesse objektide kaupa. Vabariigi Valitsus võib riigieelarves märgitud ministeeriumi valitsemisala muid investeeringuid, kulusid ja finantseerimistehinguid liigendada kooskõlas eelarveklassifikaatoriga. (2) Minister liigendab riigieelarves märgitud ministeeriumi valitsemisala kulud, investeeringud ja finantseerimistehingud administratiivselt ja majandusliku sisu järgi valitsemisala eelarves kooskõlas eelarveklassifikaatoriga ja lähtudes käesoleva paragrahvi lõike 1 alusel kehtestatud Vabariigi Valitsuse liigendusest. Siseminister ja regionaalminister liigendavad Siseministeeriumi valitsemisala kulud oma valdkonna küsimuste piires eraldi. (3) Põhiseaduslikud institutsioonid ja nende haldusala asutused liigendavad riigieelarves märgitud kulud, investeeringud ja finantseerimistehingud majandusliku sisu järgi või tegevuspõhiselt oma eelarves kooskõlas eelarveklassifikaatoriga.",
      "rdfs:label": {
        "@value": "REELS_Par_31 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_31_v129062014131"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
