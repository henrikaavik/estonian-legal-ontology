        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigieelarve muutmiseks vahendite kogumahtu muutes võib Vabariigi Valitsus algatada hiljemalt kolm kuud enne eelarveaasta lõppu lisaeelarve eelnõu. (2) Lisaeelarve eelnõu koos seletuskirjaga koostab Rahandusministeerium. (3) Lisaeelarve eelnõu esitamine, arutamine ja vastuvõtmine toimub käesoleva seaduse §-des 39 ja 40 sätestatud korras.",
      "rdfs:label": {
        "@value": "REELS_Par_44 (redaktsioon 113032014002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014002",
      "estleg:supersededByVersion": {
        "@id": "estleg:REELS_Par_44_v128052024003"
      },
      "estleg:versionValidTo": {
        "@value": "2024-06-06",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014002",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 44",
      "estleg:partOfAct": {
        "@id": "estleg:REELS_Map_2026"
      }
    },
    {
      "@id": "estleg:REELS_Par_44_v128052024003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigieelarve muutmiseks vahendite kogumahtu muutes võib Vabariigi Valitsus algatada hiljemalt kolm kuud enne eelarveaasta lõppu lisaeelarve eelnõu. (2) Lisaeelarve eelnõu koos seletuskirjaga koostab Rahandusministeerium. (3) Lisaeelarve eelnõu esitamine, arutamine ja vastuvõtmine toimub käesoleva seaduse §-des 39 ja 40 sätestatud korras, arvestades § 38 lõikes 21 sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "REELS_Par_44 (redaktsioon 128052024003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128052024003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128052024003",
