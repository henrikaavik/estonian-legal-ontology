      }
    },
    {
      "@id": "estleg:REELS_Par_126_v121062016019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REELS_Par_126"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 47 lõige 3, § 48 lõiked 4–6 ja § 49 jõustuvad 2015. aasta 1. jaanuaril. (2) Käesoleva seaduse § 50 lõiked 2 ja 3 ning § 51 jõustuvad 2017. aasta 1. jaanuaril. (3) Käesoleva seaduse §-d 108 ja 120 jõustuvad 2019. aasta 1. jaanuaril. (4) Käesoleva seaduse § 48 lõige 3 ning § 110 jõustuvad 2020. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "REELS_Par_126 (redaktsioon 121062016019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062016019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062016019",
      "estleg:sourceAct": "Riigieelarve seadus",
      "estleg:provisionRef": "REELS § 126",
