    },
    {
      "@id": "estleg:Reg_1036568_Par_2_v1036568",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036568_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti Vabariik kasutab enampakkumisel lubatud heitkoguse ühikute müügiks Euroopa Liidu liikmesriikide ja Euroopa Komisjoni poolt ühise hankemenetluse kaudu valitud ühist enampakkumisplatvormi. Eesti Vabariik kasutab enampakkumisel lubatud heitkoguse ühikute müügiks Euroopa Liidu liikmesriikide ja Euroopa Komisjoni poolt ühise hankemenetluse kaudu valitud ühist enampakkumisplatvormi. 2 (2) Enampakkumise tehingute seiret teostab Euroopa Liidu liikmesriikide ja Euroopa Komisjoni poolt ühise hankemenetluse kaudu valitud enampakkumise seire teostaja. Enampakkumise tehingute seiret teostab Euroopa Liidu liikmesriikide ja Euroopa Komisjoni poolt ühise hankemenetluse kaudu valitud enampakkumise seire teostaja.",
      "rdfs:label": {
        "@value": "Reg_1036568_Par_2 (redaktsioon 1036568)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036568",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036568",
      "estleg:sourceAct": "Lubatud heitkoguse ühikute enampakkumise kord",
      "estleg:provisionRef": "Reg_1036568 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036568_Map_2026"
      }
    },
