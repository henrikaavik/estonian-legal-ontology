        "@id": "estleg:RaRS_Par_8_v115032014041"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaRS_Par_8_v115032014041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaRS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohalikule omavalitsusele raamatukoguteeninduse korraldamise kohta ettepanekute tegemiseks moodustatakse rahvaraamatukogu töö hindamiseks ja muude rahvaraamatukogu tegevust puudutavate oluliste küsimuste läbiarutamiseks vähemalt kolmeliikmeline rahvaraamatukogu nõukogu. Rahvaraamatukogu nõukogu moodustamise kord, pädevus ja töökord sätestatakse rahvaraamatukogu põhimääruses. (2) Rahvaraamatukogude arengusuundade ja sihtprogrammide läbiarutamiseks ning koostöö korraldamiseks moodustab valdkonna eest vastutav minister nõuandva koguna Rahvaraamatukogude Nõukogu ja",
      "rdfs:label": {
        "@value": "RaRS_Par_8 (redaktsioon 115032014041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014041"
    },
    {
      "@id": "estleg:RaRS_Par_9_v22422",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaRS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvaraamatukogu valduses oleva vara valdamine, kasutamine ja käsutamine toimub vastavalt kohaliku omavalitsuse volikogu kehtestatud korrale.",
      "rdfs:label": {
        "@value": "RaRS_Par_9 (redaktsioon 22422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22422"
    }
  ]
