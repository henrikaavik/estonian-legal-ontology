      "estleg:versionValidFrom": {
        "@value": "2026-02-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega sätestatakse rahvusvaheliseks liikluseks avatud piiripunktid ning reisijatele avatud piiripunktid Eesti Vabariigi ja Vene Föderatsiooni elanikele. RT I 2006 12 88 1000761 2006-03-12 Käesoleva määrusega sätestatakse rahvusvaheliseks liikluseks avatud piiripunktid ning reisijatele avatud piiripunktid Eesti Vabariigi ja Vene Föderatsiooni elanikele.",
      "rdfs:label": {
        "@value": "Reg_155289_Par_1 (redaktsioon 155289)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155289",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155289",
      "estleg:sourceAct": "Rahvusvaheliseks liikluseks avatud piiripunktid",
      "estleg:provisionRef": "Reg_155289 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155289_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155289_Par_2_v155289",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155289_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rahvusvaheliseks liikluseks avatud piiripunktid on: 1 1) maanteelõikudel (lisa 1); 2 2) raudteejaamades (lisa 2); 3 3) mere- ja piiriveekogude sadamates (lisa 3); 4 4) lennujaamades (lisa 4). Rahvusvaheliseks liikluseks avatud piiripunktid on: maanteelõikudel (lisa 1); raudteejaamades (lisa 2); mere- ja piiriveekogude sadamates (lisa 3); lennujaamades (lisa 4). 2 (2) Kehtetu - RT I 2006 12 88 1000761 2006-03-12 Kehtetu - 3 (3) Reisijatele avatud piiripunktid ainult Eesti Vabariigi ja Vene Föderatsiooni elanikele on sätestatud lisas 6. RT I 2003 44 306 588825 2003-06-02 Reisijatele avatud piiripunktid ainult Eesti Vabariigi ja Vene Föderatsiooni elanikele on sätestatud lisas 6.",
      "rdfs:label": {
        "@value": "Reg_155289_Par_2 (redaktsioon 155289)",
        "@language": "et"
      },
