      }
    },
    {
      "@id": "estleg:Reg_326697_Par_33_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Peadirektori avaliku võimu teostamise õiguse peatumisel paneb rahandusminister peadirektori ülesanded peadirektori asetäitjale või ameti osakonnajuhatajale. RT I 2023-01-31 2 131012023002 2023-02-03 Peadirektori avaliku võimu teostamise õiguse peatumisel paneb rahandusminister peadirektori ülesanded peadirektori asetäitjale või ameti osakonnajuhatajale. 2 (2) Erandjuhtudel võib rahandusminister määrata peadirektori asendajaks lõikes 1 nimetamata isiku. 2013-08-27 RT I 2013-08-29 8 129082013008 2013-09-01 Erandjuhtudel võib rahandusminister määrata peadirektori asendajaks lõikes 1 nimetamata isiku.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_33 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 33",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_34_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ameti osakonda juhib osakonnajuhataja, kes allub vahetult peadirektorile või peadirektori asetäitjale vastavalt osakonna põhimääruses sätestatule. Osakonna allüksust juhtiva teenistuja teenistuskoht ja tema alluvus nähakse ette osakonna põhimääruses. RT I 2023-10-12 15 112102023015 2024-02-01 Ameti osakonda juhib osakonnajuhataja, kes allub vahetult peadirektorile või peadirektori asetäitjale vastavalt osakonna põhimääruses sätestatule. Osakonna allüksust juhtiva teenistuja teenistuskoht ja tema alluvus nähakse ette osakonna põhimääruses. 2 (2) Iga üksuse juht peab tagama tema poolt juhitava üksuse põhimäärusega kinnitatud funktsioonide täitmise ning üksusele eraldatud ressursside sihipärase ja efektiivse kasutamise. Selleks üksuse juht: 1 1) vastutab tema poolt juhitavale üksusele pandud ülesannete õiguspärase, õigeaegse ja asjatundliku täitmise eest ning kontrollib temale alluvate teenistujate teenistuskohustuste täitmist; 2 2) osaleb arengustrateegiate ja aastaplaanide väljatöötamisel ning juhib üksuse arenguplaanide koostamist; 3 3) annab alluvatele teenistujatele korraldusi üksuse ülesannete täitmiseks; 4 4) täidab temale kõrgemalseisva juhi poolt antud korraldused või teatab nende täitmise takistustest ning annab kõrgemalseisvale juhile aru üksuse tegevusest; 5 5) annab üksuse nimel arvamusi ja kooskõlastusi juhtkonnale ja teistele üksustele; 6 6) teeb kõrgemalseisvale juhile ettepanekuid üksuse struktuuri, koosseisu ja töökorralduse muutmiseks ning üksuse teenistujate motiveerimiseks ja vajadusel nende vastutusele võtmiseks; 2013-08-27 RT I 2013-08-29 8 129082013008 2013-09-01 7 7) taotleb üksuse ülesannete täitmiseks vajalikke vahendeid ning korraldab nende nõuetekohase hoidmise, hooldamise ja kasutamise; 8 8) taotleb üksuse teenistujatele täienduskoolitust teenistuskohustuste tulemuslikumaks täitmiseks; 2013-08-27 RT I 2013-08-29 8 129082013008 2013-09-01 9 9) allkirjastab üksuses koostatud kirjad ja dokumendid, millega ei võeta rahalisi ega muid varalisi kohustusi ning ei anta õigusi ega panda kohustusi ametivälistele isikutele, kui õigusakt ei sätesta teisiti. Iga üksuse juht peab tagama tema poolt juhitava üksuse põhimäärusega kinnitatud funktsioonide täitmise ning üksusele eraldatud ressursside sihipärase ja efektiivse kasutamise. Selleks üksuse juht: vastutab tema poolt juhitavale üksusele pandud ülesannete õiguspärase, õigeaegse ja asjatundliku täitmise eest ning kontrollib temale alluvate teenistujate teenistuskohustuste täitmist; osaleb arengustrateegiate ja aastaplaanide väljatöötamisel ning juhib üksuse arenguplaanide koostamist; annab alluvatele teenistujatele korraldusi üksuse ülesannete täitmiseks; täidab temale kõrgemalseisva juhi poolt antud korraldused või teatab nende täitmise takistustest ning annab kõrgemalseisvale juhile aru üksuse tegevusest; annab üksuse nimel arvamusi ja kooskõlastusi juhtkonnale ja teistele üksustele; teeb kõrgemalseisvale juhile ettepanekuid üksuse struktuuri, koosseisu ja töökorralduse muutmiseks ning üksuse teenistujate motiveerimiseks ja vajadusel nende vastutusele võtmiseks; taotleb üksuse ülesannete täitmiseks vajalikke vahendeid ning korraldab nende nõuetekohase hoidmise, hooldamise ja kasutamise; taotleb üksuse teenistujatele täienduskoolitust teenistuskohustuste tulemuslikumaks täitmiseks; allkirjastab üksuses koostatud kirjad ja dokumendid, millega ei võeta rahalisi ega muid varalisi kohustusi ning ei anta õigusi ega panda kohustusi ametivälistele isikutele, kui õigusakt ei sätesta teisiti.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_34 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 34",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_35_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Peadirektor teostab seadusega ette nähtud korras teenistuslikku järelevalvet ameti struktuuriüksuste ja ameti teenistujate tegevuse üle. Peadirektor teostab seadusega ette nähtud korras teenistuslikku järelevalvet ameti struktuuriüksuste ja ameti teenistujate tegevuse üle. 2 (2) Peadirektor võib teenistusliku järelevalve vahetu teostamise teha ülesandeks peadirektori asetäitjale või ameti struktuuriüksuse juhile. Peadirektor võib teenistusliku järelevalve vahetu teostamise teha ülesandeks peadirektori asetäitjale või ameti struktuuriüksuse juhile.",
      "rdfs:label": {
