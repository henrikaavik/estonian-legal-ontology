    },
    {
      "@id": "estleg:Reg_326697_Par_1_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliamet (edaspidi amet) on Rahandusministeeriumi valitsemisalasse kuuluv valitsusasutus, millel on juhtimisfunktsioon ja mis teostab riiklikku järelevalvet ning kohaldab riiklikku sundi seaduses ette nähtud alustel ja ulatuses. Maksu- ja Tolliamet (edaspidi amet) on Rahandusministeeriumi valitsemisalasse kuuluv valitsusasutus, millel on juhtimisfunktsioon ja mis teostab riiklikku järelevalvet ning kohaldab riiklikku sundi seaduses ette nähtud alustel ja ulatuses.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_1 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_10_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti osakonnad on: 1 1) aktsiiside osakond; 2 2) arendusosakond; 3 3) haldusosakond; 4 4) juriidiline osakond; 5 5) klienditeeninduse osakond; 6 6) kommunikatsiooni- ja välissuhete osakond; 7 7) käibemaksu osakond; 8 8) maksuauditi osakond; 9 9) personaliosakond; 10 10) sisekontrolli osakond; 11 11) teabeosakond; 12 12) tolliformaalsuste osakond; 13 13) tollikontrolli osakond; 14 14) tollikorralduse osakond; 15 15) tulude osakond; 16 16) tulumaksu osakond; 17 17) uurimisosakond. RT I 2023-10-12 15 112102023015 2024-02-01 Ameti osakonnad on: aktsiiside osakond; arendusosakond; haldusosakond; juriidiline osakond; klienditeeninduse osakond; kommunikatsiooni- ja välissuhete osakond; käibemaksu osakond; maksuauditi osakond; personaliosakond; sisekontrolli osakond; teabeosakond; tolliformaalsuste osakond; tollikontrolli osakond; tollikorralduse osakond; tulude osakond; tulumaksu osakond; uurimisosakond.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_10 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_10_11_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_10_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_326697_Par_10_11 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 10_11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_10_12_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_10_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiiside osakonna põhiülesanded seonduvad alkoholi-, tubaka-, kütuse, elektri- ja pakendiaktsiisi, aktsiisikaupade käitlemise, hasartmängumaksu ja hasartmängude korraldamisega ning on järgmised: 1 1) avalike teenuste korraldamine ja arendamine; 2 2) maksuseaduste ja nende alusel antud õigusaktide rakendamine; 3 3) maksualaste õigusaktide eelnõude kohta arvamuste andmine; 4 4) maksuriskide ja kahjuarvutuste metoodikate väljatöötamine; 5 5) aktsiisikaupade käitlemisega seotud lubade menetlemine ja maksumärkide haldamine; 6 6) hasartmängude korraldamisega seotud lubade menetlemine; 7 7) aktsiise käsitlevate maksuseaduste, aktsiisikaupu käsitlevate eriseaduste, tollialaste õigusaktide, hasartmängumaksu seaduse ja hasartmänguseaduse rikkumiste ennetamine, tõkestamine ning kontrollide läbiviimine seaduses sätestatud alustel ja korras. RT I 2023-10-12 15 112102023015 2024-02-01 Aktsiiside osakonna põhiülesanded seonduvad alkoholi-, tubaka-, kütuse, elektri- ja pakendiaktsiisi, aktsiisikaupade käitlemise, hasartmängumaksu ja hasartmängude korraldamisega ning on järgmised: avalike teenuste korraldamine ja arendamine; maksuseaduste ja nende alusel antud õigusaktide rakendamine; maksualaste õigusaktide eelnõude kohta arvamuste andmine; maksuriskide ja kahjuarvutuste metoodikate väljatöötamine; aktsiisikaupade käitlemisega seotud lubade menetlemine ja maksumärkide haldamine; hasartmängude korraldamisega seotud lubade menetlemine; aktsiise käsitlevate maksuseaduste, aktsiisikaupu käsitlevate eriseaduste, tollialaste õigusaktide, hasartmängumaksu seaduse ja hasartmänguseaduse rikkumiste ennetamine, tõkestamine ning kontrollide läbiviimine seaduses sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_10_12 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 10_12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_10_13_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_10_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arendusosakonna põhiülesanded on: 1 1) ameti arendusprotsessi korraldamine ja koordineerimine; 2 2) ameti teenuste ja protsesside juhtimise metoodika arendamine ja koordineerimine; 3 3) infotehnoloogiliste arendusprojektide investeeringute kavandamine ja korraldamine. RT I 2023-10-12 15 112102023015 2024-02-01 Arendusosakonna põhiülesanded on: ameti arendusprotsessi korraldamine ja koordineerimine; ameti teenuste ja protsesside juhtimise metoodika arendamine ja koordineerimine; infotehnoloogiliste arendusprojektide investeeringute kavandamine ja korraldamine.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_10_13 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 10_13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_10_14_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_10_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": ", endine paragrahv 10ˇ2 loetakse §-ks 10ˇ4 Haldusosakonna põhiülesanded on: 1 1) ameti valduses oleva riigivara haldamise korraldamine; 2 2) kehtetu - RT I 2016-06-28 29 128062016029 2016-07-01 3 3) teenistuslähetustega seotud reisi- ja majutusteenuse korraldamine; 4 4) ametisisese logistikateenuse korraldamine; 5 5) Kehtetu – RT I 2012-05-29 13 129052012013 2012-06-01 6 6) kehtetu – RT I 2012-10-04 5 104102012005 2012-10-07 , rakendatakse 1. oktoobrist 2012. a 7 7) eelarve koostamine ja aruandluse korraldamine; RT I 2015-11-26 3 126112015003 2016-01-01 8 8) dokumendi- ja arhiivihalduse korraldamine ning koordineerimine; RT I 2015-11-26 3 126112015003 2016-01-01 9 9) raamatupidamisarvestuse pidamiseks vajaliku informatsiooni ja dokumentatsiooni edastamine Rahandusministeeriumi valitsemisala finants-, personali- ja palgaarvestuse teenuse osutajale Rahandusministeeriumis ning infovahetuse korraldamine. RT I 2015-11-26 3 126112015003 2016-01-01 Haldusosakonna põhiülesanded on: ameti valduses oleva riigivara haldamise korraldamine; kehtetu - teenistuslähetustega seotud reisi- ja majutusteenuse korraldamine; ametisisese logistikateenuse korraldamine; Kehtetu – kehtetu – , rakendatakse 1. oktoobrist 2012. a eelarve koostamine ja aruandluse korraldamine; dokumendi- ja arhiivihalduse korraldamine ning koordineerimine; raamatupidamisarvestuse pidamiseks vajaliku informatsiooni ja dokumentatsiooni edastamine Rahandusministeeriumi valitsemisala finants-, personali- ja palgaarvestuse teenuse osutajale Rahandusministeeriumis ning infovahetuse korraldamine.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_10_14 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 10_14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_11_v326697",
      "@type": [
        "owl:NamedIndividual",
