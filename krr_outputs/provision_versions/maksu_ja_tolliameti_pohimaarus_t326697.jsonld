      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti nimetuse ametlik lühend on MTA. RT I 2024-12-21 4 121122024004 2025-01-01 Ameti nimetuse ametlik lühend on MTA.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_4_4 (redaktsioon 326697)",
        "@language": "et"
      },
