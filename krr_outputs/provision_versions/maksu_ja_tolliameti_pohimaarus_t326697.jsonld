      }
    },
    {
      "@id": "estleg:Reg_326697_Par_4_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet asub Tallinnas. Ameti postiaadress on Lõõtsa 8a, 15176 Tallinn. Ameti struktuuriüksuse allüksused ja nende allüksused võivad asuda ka väljaspool Tallinna. RT I 2024-12-21 4 121122024004 2025-01-01 Amet asub Tallinnas. Ameti postiaadress on Lõõtsa 8a, 15176 Tallinn. Ameti struktuuriüksuse allüksused ja nende allüksused võivad asuda ka väljaspool Tallinna.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_4 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_4_4_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
