      }
    },
    {
      "@id": "estleg:Reg_326697_Par_5_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti ingliskeelne nimetus on Estonian Tax and Customs Board. Ameti ingliskeelne nimetus on Estonian Tax and Customs Board.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_5 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_6_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti tegevusvaldkond on riigitulude haldamine, riikliku maksu- ja tollipoliitika rakendamine ning ühiskonna ja seadusliku majandustegevuse kaitsmine. Ameti tegevusvaldkond on riigitulude haldamine, riikliku maksu- ja tollipoliitika rakendamine ning ühiskonna ja seadusliku majandustegevuse kaitsmine.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_6 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_7_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti ülesanded on: 1 1) riigieelarvesse laekunud ning tasumisele kuuluvate riiklike maksude ja muude rahaliste kohustuste täitmise üle arvestuse pidamine, aruannete koostamine, nende esitamine rahandusministrile ning maksukohustuslaste registri pidamine; 2 2) riiklike maksudega seotud maksuasjade menetlemine, riiklike maksude arvestamise ja tasumise õigsuse kontrollimine ning seadusega sätestatud suuruses ja korras maksude tasumise ning maksusoodustuste kohaldamise jälgimine, tasumisele kuuluva maksusumma ja intressi arvestamine ning määramine; 3 3) maksuvõlgade ja muude tasumata rahaliste kohustuste sissenõudmine ning sellega seotud tegevused; RT I 2024-12-21 4 121122024004 2025-01-01 4 4) enammakstud või hüvitatavate summade tagastamine ja tasaarvestamine; 5 5) Eesti ja liiduväliste riikide vahelise seadusliku kaubanduse hõlbustamine; RT I 2024-12-21 4 121122024004 2025-01-01 6 6) kaupade ebaseadusliku käitlemise tõkestamine nii riigi sees kui ka kaupade Eestisse või Eestist välja toimetamisel, sealhulgas rahvusvahelist sanktsiooni rakendavas või Vabariigi Valitsuse sanktsiooni kehtestavas õigusaktis sätestatud keelu tagamiseks; RT I 2024-12-21 4 121122024004 2025-01-01 7 7) tollialaste õigusaktide rakendamine ja nendest kinnipidamise tagamine; RT I 2018-01-26 1 126012018001 2018-02-01 8 8) ühiskonna ja majanduse kaitsmine maksu- ja tollialaste süütegude ennetamisega, tõkestamisega ja avastamisega ning nende süütegude menetlemine; RT I 2024-12-21 4 121122024004 2025-01-01 9 9) riikliku sunni kohaldamine tollialaste õigusaktide ja maksuseaduste rikkujate suhtes seaduses sätestatud korras ning ulatuses; RT I 2018-01-26 1 126012018001 2018-02-01 10 10) ameti tegevusvaldkonda puudutavate õigusaktide eelnõude kohta arvamuste andmine; 11 11) vaiete menetlemine, kaebuste läbivaatamine ja lahendamine; 12 12) isikute juhendamine ja informeerimine maksunduse küsimustes ja tolli valdkonnas; 12 12¹) maksukorralduse seaduse §-s 911 sätestatud siduvate eelotsuste tegemine; RT I 2024-12-21 4 121122024004 2025-01-01 13 13) oma pädevuse piires riigi ja ameti esindamine kohtus; 14 14) rahvusvahelise maksu- ja tollialase infovahetuse korraldamine; 15 15) väliskaubandusstatistikaks vajalike andmete kogumine ja töötlemine; 16 16) välislepingutega võetud maksu- ja tollialaste kohustuste täitmise tagamine; 17 17) hasartmängude tegevuslubade ja korralduslubade väljaandmine ning tegutsemine hasartmängu järelevalveasutusena; RTL 2009 14 151 13128313 2009-02-08+02:00 17 17¹) vedelkütuse käitlemise tegevuslubade väljastamine ja riikliku järelevalve teostamine vedelkütuse käitlemise üle vedelkütuse seadusega määratud ulatuses; RT I 2024-12-21 4 121122024004 2025-01-01 18 18) riigisisene ja rahvusvaheline koostöö teiste asutuste ja organisatsioonidega; RT I 2024-12-21 4 121122024004 2025-01-01 19 19) muude ametile õigusaktiga pandud ülesannete täitmine. Ameti ülesanded on: riigieelarvesse laekunud ning tasumisele kuuluvate riiklike maksude ja muude rahaliste kohustuste täitmise üle arvestuse pidamine, aruannete koostamine, nende esitamine rahandusministrile ning maksukohustuslaste registri pidamine; riiklike maksudega seotud maksuasjade menetlemine, riiklike maksude arvestamise ja tasumise õigsuse kontrollimine ning seadusega sätestatud suuruses ja korras maksude tasumise ning maksusoodustuste kohaldamise jälgimine, tasumisele kuuluva maksusumma ja intressi arvestamine ning määramine; maksuvõlgade ja muude tasumata rahaliste kohustuste sissenõudmine ning sellega seotud tegevused; enammakstud või hüvitatavate summade tagastamine ja tasaarvestamine; Eesti ja liiduväliste riikide vahelise seadusliku kaubanduse hõlbustamine; kaupade ebaseadusliku käitlemise tõkestamine nii riigi sees kui ka kaupade Eestisse või Eestist välja toimetamisel, sealhulgas rahvusvahelist sanktsiooni rakendavas või Vabariigi Valitsuse sanktsiooni kehtestavas õigusaktis sätestatud keelu tagamiseks; tollialaste õigusaktide rakendamine ja nendest kinnipidamise tagamine; ühiskonna ja majanduse kaitsmine maksu- ja tollialaste süütegude ennetamisega, tõkestamisega ja avastamisega ning nende süütegude menetlemine; riikliku sunni kohaldamine tollialaste õigusaktide ja maksuseaduste rikkujate suhtes seaduses sätestatud korras ning ulatuses; ameti tegevusvaldkonda puudutavate õigusaktide eelnõude kohta arvamuste andmine; vaiete menetlemine, kaebuste läbivaatamine ja lahendamine; isikute juhendamine ja informeerimine maksunduse küsimustes ja tolli valdkonnas; maksukorralduse seaduse §-s 911 sätestatud siduvate eelotsuste tegemine; oma pädevuse piires riigi ja ameti esindamine kohtus; rahvusvahelise maksu- ja tollialase infovahetuse korraldamine; väliskaubandusstatistikaks vajalike andmete kogumine ja töötlemine; välislepingutega võetud maksu- ja tollialaste kohustuste täitmise tagamine; hasartmängude tegevuslubade ja korralduslubade väljaandmine ning tegutsemine hasartmängu järelevalveasutusena; vedelkütuse käitlemise tegevuslubade väljastamine ja riikliku järelevalve teostamine vedelkütuse käitlemise üle vedelkütuse seadusega määratud ulatuses; riigisisene ja rahvusvaheline koostöö teiste asutuste ja organisatsioonidega; muude ametile õigusaktiga pandud ülesannete täitmine.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_7 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
