      }
    },
    {
      "@id": "estleg:Reg_326697_Par_12_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidilise osakonna põhiülesanded on: 1 1) vaiete menetlemine ja kaebuste lahendamine; 1 1¹) siduvate eelotsuste koostamine; RT I 2024-12-21 4 121122024004 2025-01-01 2 2) ameti esindamine likvideerimis-, maksejõuetus- ja kohtumenetluses; 3 3) ameti tegevusvaldkonda puudutavate õigusaktide eelnõude kohta arvamuste andmine ja sellealase tegevuse ametiülene koordineerimine; 4 4) osalemine lepingute koostamisel; 5 5) ameti teiste struktuuriüksuste juriidiline nõustamine ja koolitamine; 6 6) väärteomenetluse koordineerimine ametis. RT I 2023-10-12 15 112102023015 2024-02-01 Juriidilise osakonna põhiülesanded on: vaiete menetlemine ja kaebuste lahendamine; siduvate eelotsuste koostamine; ameti esindamine likvideerimis-, maksejõuetus- ja kohtumenetluses; ameti tegevusvaldkonda puudutavate õigusaktide eelnõude kohta arvamuste andmine ja sellealase tegevuse ametiülene koordineerimine; osalemine lepingute koostamisel; ameti teiste struktuuriüksuste juriidiline nõustamine ja koolitamine; väärteomenetluse koordineerimine ametis.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_12 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_12_17_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_12_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Klienditeeninduse osakonna põhiülesanded on: 1 1) klientide teenindamine ja nõustamine; 2 2) ameti teeninduskanalite haldamine ja arendamine; 3 3) ameti teeninduskvaliteedi parendamine. RT I 2023-10-12 15 112102023015 2024-02-01 Klienditeeninduse osakonna põhiülesanded on: klientide teenindamine ja nõustamine; ameti teeninduskanalite haldamine ja arendamine; ameti teeninduskvaliteedi parendamine.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_12_17 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 12_17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_12_18_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_12_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": ", endine paragrahv 12ˇ1 loetakse §-ks 12ˇ2 Kommunikatsiooni- ja välissuhete osakonna põhiülesanded on: 1 1) ameti meediasuhtluse, sisekommunikatsiooni ning maksu- ja tollialase teabe levitamise põhimõtete väljatöötamine, arendamine ja korraldamine; 2 2) koostöö välisriikide ametiasutuste ja rahvusvaheliste organisatsioonidega ning ameti välissuhtluse koordineerimine. RT I 2022-09-16 9 116092022009 2022-10-01 Kommunikatsiooni- ja välissuhete osakonna põhiülesanded on: ameti meediasuhtluse, sisekommunikatsiooni ning maksu- ja tollialase teabe levitamise põhimõtete väljatöötamine, arendamine ja korraldamine; koostöö välisriikide ametiasutuste ja rahvusvaheliste organisatsioonidega ning ameti välissuhtluse koordineerimine.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_12_18 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 12_18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_12_19_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_12_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käibemaksu osakonna põhiülesanded seonduvad käibemaksuga ja on järgmised: 1 1) avalike teenuste korraldamine ja arendamine; 2 2) maksuseaduste ja nende alusel antud õigusaktide rakendamine; 3 3) maksualaste õigusaktide eelnõude kohta arvamuste andmine; 4 4) maksuriskide ja kahjuarvutuste metoodikate väljatöötamine. RT I 2023-10-12 15 112102023015 2024-02-01 Käibemaksu osakonna põhiülesanded seonduvad käibemaksuga ja on järgmised: avalike teenuste korraldamine ja arendamine; maksuseaduste ja nende alusel antud õigusaktide rakendamine; maksualaste õigusaktide eelnõude kohta arvamuste andmine; maksuriskide ja kahjuarvutuste metoodikate väljatöötamine.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_12_19 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 12_19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_13_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuauditi osakonna põhiülesanne on maksukorralduse seaduse ja maksuseaduste, välja arvatud aktsiiside osakonna pädevusse kuuluvate rikkumiste ennetamine, tõkestamine ning kontrollide läbiviimine seaduses sätestatud alustel ja korras. RT I 2023-10-12 15 112102023015 2024-02-01 Maksuauditi osakonna põhiülesanne on maksukorralduse seaduse ja maksuseaduste, välja arvatud aktsiiside osakonna pädevusse kuuluvate rikkumiste ennetamine, tõkestamine ning kontrollide läbiviimine seaduses sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_13 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
