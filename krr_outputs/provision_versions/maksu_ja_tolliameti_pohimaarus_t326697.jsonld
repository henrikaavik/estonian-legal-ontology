      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tollikontrolli osakonna põhiülesanded on: 1 1) tollialaste rikkumiste ennetamine ja tõkestamine ning tollijärelevalve teostamine; 2 2) tollipunktides tolliformaalsuste läbiviimine, sealhulgas klientide teenindamine ja nõustamine, määratud ulatuses. RT I 2023-10-12 15 112102023015 2024-02-01 Tollikontrolli osakonna põhiülesanded on: tollialaste rikkumiste ennetamine ja tõkestamine ning tollijärelevalve teostamine; tollipunktides tolliformaalsuste läbiviimine, sealhulgas klientide teenindamine ja nõustamine, määratud ulatuses.",
      "rdfs:label": {
        "@value": "Reg_326697_Par_20_31 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 20_31",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_326697_Map"
      }
    },
    {
      "@id": "estleg:Reg_326697_Par_20_32_v326697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_326697_Par_20_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tollikorralduse osakonna põhiülesanded on: 1 1) tolliteenuste ja tollijärelevalve, sealhulgas tollivaldkonna infosüsteemide korraldamine ning arendamine; 2 2) tollialaste õigusaktide rakendamise korraldamine; 3 3) tollivaldkonda puudutavate õigusaktide eelnõude kohta arvamuste andmine; 4 4) tolliriskide ja kahjuarvutuste metoodikate väljatöötamine. RT I 2023-10-12 15 112102023015 2024-02-01 Tollikorralduse osakonna põhiülesanded on: tolliteenuste ja tollijärelevalve, sealhulgas tollivaldkonna infosüsteemide korraldamine ning arendamine; tollialaste õigusaktide rakendamise korraldamine; tollivaldkonda puudutavate õigusaktide eelnõude kohta arvamuste andmine; tolliriskide ja kahjuarvutuste metoodikate väljatöötamine.",
      "rdfs:label": {
