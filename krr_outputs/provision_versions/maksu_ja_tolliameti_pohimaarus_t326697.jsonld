      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Reg_326697_Par_11 (redaktsioon 326697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "326697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/326697",
      "estleg:sourceAct": "Maksu- ja Tolliameti põhimäärus",
      "estleg:provisionRef": "Reg_326697 § 11",
      "estleg:partOfAct": {
