      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus jõustub 1. detsembril 2008. a. 2014-01-02 RT I 2014-01-07 12 107012014012 2014-01-10 , rakendatakse tagasiulatuvalt 1. jaanuarist 2014. a. Määrus jõustub 1. detsembril 2008. a. , rakendatakse tagasiulatuvalt 1. jaanuarist 2014. a. 2 (2) Käesoleva määruse 2014. aasta jaanuaris jõustunud redaktsiooni rakendatakse tagasiulatuvalt 1. jaanuarist 2014. a. 2014-01-02 RT I 2014-01-07 12 107012014012 2014-01-10 , rakendatakse tagasiulatuvalt 1. jaanuarist 2014. a. Käesoleva määruse 2014. aasta jaanuaris jõustunud redaktsiooni rakendatakse tagasiulatuvalt 1. jaanuarist 2014. a. , rakendatakse tagasiulatuvalt 1. jaanuarist 2014. a.",
      "rdfs:label": {
