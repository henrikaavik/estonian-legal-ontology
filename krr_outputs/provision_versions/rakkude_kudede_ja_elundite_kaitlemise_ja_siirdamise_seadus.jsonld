      }
    },
    {
      "@id": "estleg:EKSS_Par_4_7_v12980151",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EKSS_Par_4_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ravimiamet võib keelduda tegevusloa andmisest või uuendamisest, kui esineb vähemalt üks järgmistest asjaoludest: tegevusloa taotleja tegevuses on avastatud korduvaid või olulisi käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuete rikkumisi; tegevusloa taotleja tegevus ei vasta tegevusloa tingimustele; tegevusloa taotleja tegutsemiskoht ei vasta käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele; pädev isik ei täida oma kohustusi; käitleja ei ole ettenähtud ajaks või ulatuses täitnud Ravimiameti ettekirjutust; käitleja ei vasta käesolevas seaduses sätestatud nõuetele. (2) Ravimiamet keeldub tegevusloa andmisest või uuendamisest, kui esineb vähemalt üks järgmistest asjaoludest: taotleja ei vasta käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele; ei ole käesoleva seaduse kohaselt esitatud tegevusloa saamiseks nõutavaid dokumente või andmeid; ei ole tasutud riigilõivu; taotleja ei ole esitanud käesoleva seaduse § 4 5 lõike 2 kohaseid selgitusi; taotleja ei ole kõrvaldanud lisatähtaja jooksul tegevusloa andmist takistavaid puudusi; tegevusloa taotlemisel on esitatud tegelikkusele mittevastavaid andmeid; on välja kuulutatud tegevusloa taotleja pankrot; taotlejat on karistatud tegevusloata tegutsemise eest tegevusalal, kus käesoleva seaduse kohaselt on tegevusluba nõutav, ja möödunud ei ole karistusregistri seaduse §-s 25 nimetatud tähtajad; pädeva isikuna tegevusloale kandmiseks esitatakse isik, kes oli määratud pädevaks isikuks käitleja poolt, kelle tegevusluba tunnistati kehtetuks käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuete rikkumise tõttu, ning tegevusloa kehtetuks tunnistamisest on möödunud vähem kui kaks aastat. (3) Tegevusloa andja teatab tegevusloa taotlejale tegevusloa andmisest või uuendamisest keeldumisest kirjalikult kümne tööpäeva jooksul keeldumisotsuse tegemisest arvates.",
      "rdfs:label": {
        "@value": "EKSS_Par_4_7 (redaktsioon 12980151)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12980151",
      "estleg:supersededByVersion": {
        "@id": "estleg:EKSS_Par_4_7_v13315405"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12980151",
      "estleg:sourceAct": "Rakkude, kudede ja elundite käitlemise ja siirdamise seadus",
      "estleg:provisionRef": "EKSS § 4_7",
      "estleg:partOfAct": {
        "@id": "estleg:EKSS_2_Map"
      }
    },
    {
      "@id": "estleg:EKSS_Par_4_7_v13315405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EKSS_Par_4_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ravimiamet võib keelduda tegevusloa andmisest või uuendamisest, kui esineb vähemalt üks järgmistest asjaoludest: tegevusloa taotleja tegevuses on avastatud korduvaid või olulisi käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuete rikkumisi; tegevusloa taotleja tegevus ei vasta tegevusloa tingimustele; tegevusloa taotleja tegutsemiskoht ei vasta käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele; pädev isik ei täida oma kohustusi; käitleja ei ole ettenähtud ajaks või ulatuses täitnud Ravimiameti ettekirjutust; käitleja ei vasta käesolevas seaduses sätestatud nõuetele. (2) Ravimiamet keeldub tegevusloa andmisest või uuendamisest, kui esineb vähemalt üks järgmistest asjaoludest: taotleja ei vasta käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele; ei ole käesoleva seaduse kohaselt esitatud tegevusloa saamiseks nõutavaid dokumente või andmeid; ei ole tasutud riigilõivu; taotleja ei ole esitanud käesoleva seaduse § 45 lõike 2 kohaseid selgitusi; taotleja ei ole kõrvaldanud lisatähtaja jooksul tegevusloa andmist takistavaid puudusi; tegevusloa taotlemisel on esitatud tegelikkusele mittevastavaid andmeid; on välja kuulutatud tegevusloa taotleja pankrot; taotlejat on karistatud tegevusloata tegutsemise eest tegevusalal, kus käesoleva seaduse kohaselt on tegevusluba nõutav, ja möödunud ei ole karistusregistri seaduse §-s 25 nimetatud tähtajad; pädeva isikuna tegevusloale kandmiseks esitatakse isik, kes oli määratud pädevaks isikuks käitleja poolt, kelle tegevusluba tunnistati kehtetuks käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuete rikkumise tõttu, ning tegevusloa kehtetuks tunnistamisest on möödunud vähem kui kaks aastat. (3) Tegevusloa andja teatab tegevusloa taotlejale tegevusloa andmisest või uuendamisest keeldumisest kirjalikult kümne tööpäeva jooksul keeldumisotsuse tegemisest arvates.",
      "rdfs:label": {
        "@value": "EKSS_Par_4_7 (redaktsioon 13315405)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315405",
      "estleg:supersededByVersion": {
        "@id": "estleg:EKSS_Par_4_7_v115032014063"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13315405",
      "estleg:sourceAct": "Rakkude, kudede ja elundite käitlemise ja siirdamise seadus",
      "estleg:provisionRef": "EKSS § 4_7",
      "estleg:partOfAct": {
        "@id": "estleg:EKSS_2_Map"
      }
    },
    {
      "@id": "estleg:EKSS_Par_4_7_v115032014063",
