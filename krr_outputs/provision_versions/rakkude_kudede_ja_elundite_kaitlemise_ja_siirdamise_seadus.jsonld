      "estleg:sourceAct": "Rakkude, kudede ja elundite käitlemise ja siirdamise seadus",
      "estleg:provisionRef": "EKSS § 4_7",
      "estleg:partOfAct": {
        "@id": "estleg:EKSS_2_Map"
      }
    },
    {
      "@id": "estleg:EKSS_Par_4_8_v12980151",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EKSS_Par_4_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusluba antakse üheks kuni viieks aastaks. (2) Kui tegevusloa taotleja taotleb tegevusluba esmakordselt, antakse talle tegevusluba üheks kuni kolmeks aastaks.",
      "rdfs:label": {
        "@value": "EKSS_Par_4_8 (redaktsioon 12980151)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12980151",
      "estleg:supersededByVersion": {
        "@id": "estleg:EKSS_Par_4_8_v115032014063"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12980151",
      "estleg:sourceAct": "Rakkude, kudede ja elundite käitlemise ja siirdamise seadus",
      "estleg:provisionRef": "EKSS § 4_8",
      "estleg:partOfAct": {
        "@id": "estleg:EKSS_2_Map"
      }
    },
    {
      "@id": "estleg:EKSS_Par_4_8_v115032014063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
