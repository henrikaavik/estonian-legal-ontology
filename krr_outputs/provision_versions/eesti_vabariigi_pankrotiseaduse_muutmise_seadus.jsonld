    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_eesti_vabariigi_pankrotiseaduse_muutmise_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti Vabariigi pankrotiseaduse muutmise seadus (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti Vabariigi pankrotiseaduse muutmise seadus"
    },
    {
      "@id": "estleg:EVPM_Par_131_v254075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_131"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 1997. aasta 1. veebruari alanud pankrotimenetluses kohaldatakse nende pankrotimenetluse toimingute suhtes, mida tehakse pärast 1997. aasta 1. veebruari, käesolevas seaduses sätestatut, kui rakendussätetest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "EVPM_Par_131 (redaktsioon 254075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254075"
    },
    {
      "@id": "estleg:EVPM_Par_132_v254075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_132"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui pankrot on välja kuulutatud enne 1997. aasta 1. veebruari, makstakse töötajatele hüvitist pankroti väljakuulutamise ajal kehtinud Eesti Vabariigi pankrotiseaduse §-s 58 sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "EVPM_Par_132 (redaktsioon 254075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254075"
    },
    {
      "@id": "estleg:EVPM_Par_133_v254075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_133"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kuni 1999. aasta 1. septembrini ei kohaldata käesoleva seaduse § 11 lõike 2 punktis 3 sätestatut aktsiaseltsi, osa-, täis- ja usaldusühingu suhtes. (2) Kuni 1999. aasta 1. septembrini ei algatata pankrotimenetlust, kui pankrotiavalduse aluseks olevate nõuete suurus ei ületa aktsiaseltsi puhul 25 000 krooni ning osa-, täis- ja usaldusühingu puhul 5000 krooni.",
      "rdfs:label": {
        "@value": "EVPM_Par_133 (redaktsioon 254075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254075"
    },
    {
      "@id": "estleg:EVPM_Par_134_v254075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_134"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui pankrot on välja kuulutatud enne 1997. aasta 1. veebruari, ei pea võlausaldaja, kelle nõue on pandiga tagatud, esitama pankrotiseaduse §-s 23 nimetatud nõudeavaldust. (2) Kui pankrot on välja kuulutatud enne 2003. aasta 1. jaanuari, ei kohaldata kommertspandiga tagatud nõude rahuldamise järjekorra määramisel pankrotiseaduse § 86 lõike 1 punkti 4. Kuni 2003. aasta 1. jaanuarini kohaldatakse kommertspandiga tagatud nõude rahuldamise järjekorra määramisel pankrotiseaduse § 86 lõike 1 punkti 1.",
      "rdfs:label": {
        "@value": "EVPM_Par_134 (redaktsioon 254075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254075",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVPM_Par_134_v254184"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EVPM_Par_134_v254184",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_134"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-02-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui pankrot on välja kuulutatud enne 1997. aasta 1. veebruari, ei pea võlausaldaja, kelle nõue on pandiga tagatud, esitama pankrotiseaduse §-s 23 nimetatud nõudeavaldust. (2) Kui pankrot on välja kuulutatud enne 2004. aasta 1. jaanuari, ei kohaldata kommertspandiga tagatud nõude rahuldamise järjekorra määramisel pankrotiseaduse § 86 lõike 1 punkti 4. Kuni 2004. aasta 1. jaanuarini kohaldatakse kommertspandiga tagatud nõude rahuldamise järjekorra määramisel pankrotiseaduse § 86 lõike 1 punkti 1.",
      "rdfs:label": {
        "@value": "EVPM_Par_134 (redaktsioon 254184)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254184"
    },
    {
      "@id": "estleg:EVPM_Par_135_v254075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_135"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pankrotiseaduse §-des 42-53 ja §-s 54 sätestatut kohaldatakse tagasiulatavalt.",
      "rdfs:label": {
        "@value": "EVPM_Par_135 (redaktsioon 254075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254075"
    },
    {
      "@id": "estleg:EVPM_Par_136_v254075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_136"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pankrotihaldurid, kelle kvalifikatsioonitõendi saamisest on hiljemalt 1998. aasta 1. juuliks möödunud vähemalt kolm aastat, peavad selleks ajaks läbima kordusatesteerimise.",
      "rdfs:label": {
        "@value": "EVPM_Par_136 (redaktsioon 254075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254075"
    },
    {
      "@id": "estleg:EVPM_Par_137142_v254075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_137142"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "EVPM_Par_137142 (redaktsioon 254075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254075"
    },
    {
      "@id": "estleg:EVPM_Par_143_v254075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_143"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1997. aasta 1. veebruaril.",
      "rdfs:label": {
        "@value": "EVPM_Par_143 (redaktsioon 254075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254075"
    },
    {
      "@id": "estleg:EVPM_Par_144_v254075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVPM_Par_144"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "EVPM_Par_144 (redaktsioon 254075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254075"
    }
  ]
}
