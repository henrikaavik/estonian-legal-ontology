      "estleg:versionValidFrom": {
        "@value": "2025-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega reguleeritakse riiklike teaduspreemiate (edaspidi teaduspreemiad) suurus, liigid, määramise tingimused ja kord ning riigi teaduspreemiate komisjoni moodustamine, ülesanded ja töökord. Määrusega reguleeritakse riiklike teaduspreemiate (edaspidi teaduspreemiad) suurus, liigid, määramise tingimused ja kord ning riigi teaduspreemiate komisjoni moodustamine, ülesanded ja töökord.",
      "rdfs:label": {
        "@value": "Reg_1061864_Par_1 (redaktsioon 1061864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061864",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061864",
