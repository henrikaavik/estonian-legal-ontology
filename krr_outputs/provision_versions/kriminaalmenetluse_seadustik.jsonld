        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuistungile kutsutakse prokurör, süüdistatav ja tema kaitsja, kelle osavõtt on kohustuslik.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_246 (redaktsioon 780297)",
        "@language": "et"
      },
