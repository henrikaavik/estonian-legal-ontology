    {
      "@id": "estleg:KRIMIN_2_Par_262_v119032015021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_262"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eelistungil võib kohtunik teha määruse: süüdistatava kohtu alla andmiseks; prokuratuurile süüdistusakti tagastamiseks, kui süüdistusakt ei vasta käesoleva seadustiku § 154 nõuetele; kaitseakti täiendamiseks või uue kaitseakti koostamiseks viie tööpäeva jooksul eelistungi toimumisest arvates, kui kaitseakt ei vasta käesoleva seadustiku § 227 lõikes 3 sätestatud nõuetele; kriminaalmenetluse lõpetamiseks käesoleva seadustiku § 199 lõike 1 punktides 2–6 loetletud juhtudel; tõkendi kohaldamiseks või muutmiseks; tsiviilhagi menetlusse võtmiseks või tähtaja määramiseks tsiviilhagis puuduste kõrvaldamiseks või tsiviilhagi läbi vaatamata jätmiseks; menetlusosalise taotluse lahendamiseks.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_262 (redaktsioon 119032015021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015021",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_262_v119032015022"
      },
      "estleg:versionValidTo": {
