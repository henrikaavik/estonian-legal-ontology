        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadustik jõustub 2004. aasta 1. juulil. (2) Käesoleva seadustiku rakenduskord sätestatakse rakendusseaduses. Õiend",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_509 (redaktsioon 1028011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028011",
