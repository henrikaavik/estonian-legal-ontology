      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_142_v12961296",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_142"
      },
      "estleg:versionValidFrom": {
