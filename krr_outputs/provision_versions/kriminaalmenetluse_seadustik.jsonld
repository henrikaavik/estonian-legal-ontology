      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teistmisavalduse käiguta ja läbi vaatamata jätmisel juhindutakse käesoleva seadustiku §-s 350 sätestatust.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_371 (redaktsioon 780297)",
