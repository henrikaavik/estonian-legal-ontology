        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_42_v782861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
