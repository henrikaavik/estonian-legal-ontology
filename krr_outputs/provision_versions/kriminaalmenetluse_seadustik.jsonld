      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_176_v923286",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_176"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Erikulud on: menetlusosalise ilmumata jäämise tõttu kohtuistungi edasilükkamisest tingitud kulud; sundtoomise kulud. (2) Erikulude arvutamise korra ja suuruse",
      "rdfs:label": {
