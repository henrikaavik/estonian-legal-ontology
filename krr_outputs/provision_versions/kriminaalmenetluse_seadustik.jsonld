      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teistmismenetluses järgitakse käesoleva seadustiku §-de 352–360 ja 363 sätteid, arvestades käesoleva peatüki erisusi.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_372 (redaktsioon 780297)",
        "@language": "et"
