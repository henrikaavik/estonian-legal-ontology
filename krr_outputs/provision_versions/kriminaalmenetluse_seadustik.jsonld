      },
      "estleg:versionValidTo": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_381_v130122014009",
      "@type": [
        "owl:NamedIndividual",
