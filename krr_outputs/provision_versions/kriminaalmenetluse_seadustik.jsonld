        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_206_v119032015021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_206"
