      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_417_v1028011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_417"
      },
      "estleg:versionValidFrom": {
