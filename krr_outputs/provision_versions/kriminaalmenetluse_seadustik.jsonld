      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_246"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuistungile kutsutakse prokurör, sü��distatav ja tema kaitsja, kelle osavõtt on kohustuslik.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_246 (redaktsioon 1013855)",
        "@language": "et"
      },
