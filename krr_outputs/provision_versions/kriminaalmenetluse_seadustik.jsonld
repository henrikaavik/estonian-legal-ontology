      },
      "estleg:versionRedactionId": "780297"
    },
    {
      "@id": "estleg:KRIMIN_2_Par_372_v780297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
