      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadustik jõustub 2004. aasta 1. juulil. (2) Käesoleva seadustiku rakenduskord sätestatakse rakendusseaduses. 13087555",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_509 (redaktsioon 13087555)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13087555",
      "estleg:supersededByVersion": {
