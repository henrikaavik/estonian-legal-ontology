        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi kohtuotsuste või muu asutuse otsuste tunnustamise otsustab Harju Maakohus.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_481 (redaktsioon 12999103)",
