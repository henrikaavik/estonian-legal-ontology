    {
      "@id": "estleg:KRIMIN_2_Par_21_v780297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eeluurimiskohtunik on maa- või linnakohtu kohtunik, kes täidab talle käesoleva seadustikuga pandud ülesandeid kohtueelses menetluses ainuisikuliselt.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_21 (redaktsioon 780297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "780297",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_21_v923286"
      },
      "estleg:versionValidTo": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_21_v923286",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eeluurimiskohtunik on maakohtu kohtunik, kes täidab talle käesoleva seadustikuga pandud ülesandeid kohtueelses menetluses ainuisikuliselt.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_21 (redaktsioon 923286)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "923286",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_21_v109072012004"
      },
      "estleg:versionValidTo": {
        "@value": "2012-07-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_21_v109072012004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eeluurimiskohtunik on maakohtu kohtunik, kes täidab talle käesoleva seadustikuga pandud ülesandeid kohtueelses menetluses ainuisikuliselt. (2) Käesolevas seadustikus sätestatud juhtudel annab jälitustoiminguks loa eeluurimiskohtunik.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_21 (redaktsioon 109072012004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109072012004"
    },
    {
      "@id": "estleg:KRIMIN_2_Par_210_v780297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_210"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikusse kriminaalmenetlusregistrisse kantakse andmed uurimisasutuse, prokuratuuri ja kohtu menetluses olevate kriminaalasjade kohta. (2) Riikliku kriminaalmenetlusregistri asutab ning selle vastutava ja volitatud töötleja määrab Vabariigi Valitsus. (3) Justiitsminister võib anda määrusi kriminaalmenetlusregistri tegevuse korraldamiseks. [Lõige 4 jõustub 1. 09. 2005] (4) Justiitsministeerium avaldab riikliku kriminaalmenetlusregistri andmete põhjal iga aasta 1. märtsiks aruande eelmise aasta kuritegevuse kohta. [Lõige 5 jõustub 1. 01. 2005] (5) Kuritegevuse statistika vormid, nende täitmise ja avaldamise korra uurimisasutustele, prokuratuurile ja kohtutele kehtestab Vabariigi Valitsus määrusega. ja 1. 09. 2005",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_210 (redaktsioon 780297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "780297",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_210_v782861"
      },
      "estleg:versionValidTo": {
        "@value": "2005-03-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_210_v782861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_210"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikusse kriminaalmenetlusregistrisse kantakse andmed uurimisasutuse, prokuratuuri ja kohtu menetluses olevate kriminaalasjade kohta. (2) Riikliku kriminaalmenetlusregistri asutab ning selle vastutava ja volitatud töötleja määrab Vabariigi Valitsus. (3) Justiitsminister võib anda määrusi kriminaalmenetlusregistri tegevuse korraldamiseks. [Lõige 4 jõustub 1.09.2005] (4) Justiitsministeerium avaldab riikliku kriminaalmenetlusregistri andmete põhjal iga aasta 1. märtsiks aruande eelmise aasta kuritegevuse kohta. [Lõige 5 jõustub 1.01.2005] (5) Kuritegevuse statistika vormid, nende täitmise ja avaldamise korra uurimisasutustele, prokuratuurile ja kohtutele kehtestab Vabariigi Valitsus määrusega. ja 1.09.2005",
