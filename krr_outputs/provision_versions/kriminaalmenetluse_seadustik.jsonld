      },
      "estleg:versionText": "Teistmismenetluses järgitakse käesoleva seadustiku §-de 352–3602 ja 363 sätteid, arvestades käesoleva peatüki erisusi.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_372 (redaktsioon 114032011035)",
        "@language": "et"
