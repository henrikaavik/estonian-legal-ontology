    },
    {
      "@id": "estleg:KRIMIN_2_Par_42_v923286",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalmenetluses on kaitsja: advokaat ja teised käesoleva seadusega lepingulisele esindajale kehtestatud haridusnõuetele vastavad isikud menetleja loal, kelle pädevus kriminaalmenetluses tuleneb kokkuleppest kaitsealusega (lepinguline kaitsja), või; advokaat, kelle pädevus kriminaalmenetluses tuleneb uurimisasutuse, prokuratuuri või kohtu määramisest (määratud kaitsja). (2) Kaitsealusel võib kokkuleppe kohaselt olla kohtumenetluses kuni kolm kaitsjat. (3) Kaitsjal võib olla mitu kaitsealust, kui nende huvid ei ole vastuolus.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_42 (redaktsioon 923286)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "923286",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_42_v13260374"
      },
      "estleg:versionValidTo": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_42_v13260374",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalmenetluses on kaitsja: advokaat ja teised käesoleva seadusega lepingulisele esindajale kehtestatud haridusnõuetele vastavad isikud menetleja loal, kelle pädevus kriminaalmenetluses tuleneb kokkuleppest kaitsealusega (lepinguline kaitsja), või; advokaat, kelle pädevus kriminaalmenetluses tuleneb uurimisasutuse, prokuratuuri või kohtu taotlusel Eesti Advokatuuri poolsest määramisest (määratud kaitsja). (2) Kaitsealusel võib kokkuleppe kohaselt olla kohtumenetluses kuni kolm kaitsjat. (3) Kaitsjal võib olla mitu kaitsealust, kui nende huvid ei ole vastuolus.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_42 (redaktsioon 13260374)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260374",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_42_v121062014036"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_42_v121062014036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalmenetluses on kaitsja: advokaat ja teised käesoleva seadusega lepingulisele esindajale kehtestatud haridusnõuetele vastavad isikud menetleja loal, kelle pädevus kriminaalmenetluses tuleneb kokkuleppest kaitsealusega (lepinguline kaitsja), või; advokaat, kelle pädevus kriminaalmenetluses tuleneb uurimisasutuse, prokuratuuri või kohtu määramisest ning Eesti Advokatuuri poolsest nimetamisest (määratud kaitsja). (2) Kaitsealusel võib kokkuleppe kohaselt olla kohtumenetluses kuni kolm kaitsjat. (3) Kaitsjal võib olla mitu kaitsealust, kui nende huvid ei ole vastuolus.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_42 (redaktsioon 121062014036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014036"
    },
    {
      "@id": "estleg:KRIMIN_2_Par_420_v780297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_420"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Süüdimõistetu elukoha järgse maa- või linnakohtu täitmiskohtunik võib süüdimõistetu taotlusel lükata oma määrusega edasi lisakaristusena mõistetud tegevuskeelu täitmisele pööramise kuni kuue kuu võrra või ta võib selle täitmisele pööramisest loobuda, kui täitmisega võivad kaasneda rasked tagajärjed süüdimõistetule või tema perekonnaliikmetele.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_420 (redaktsioon 780297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "780297",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_420_v923286"
      },
      "estleg:versionValidTo": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_420_v923286",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_420"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Süüdimõistetu elukoha järgse maakohtu täitmiskohtunik võib süüdimõistetu taotlusel lükata oma määrusega edasi lisakaristusena mõistetud tegevuskeelu täitmisele pööramise kuni kuue kuu võrra või ta võib selle täitmisele pööramisest loobuda, kui täitmisega võivad kaasneda rasked tagajärjed süüdimõistetule või tema perekonnaliikmetele.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_420 (redaktsioon 923286)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "923286",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_420_v13087555"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_420_v13087555",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_420"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegutsemiskeeld ja ettevõtluskeeld on täitmisele pööratud, kui kohtuotsus on jõustunud ja süüdimõistetule teatavaks tehtud ning kui tegutsemiskeelu või ettevõtluskeelu täitmisele pööramist ei ole käesoleva paragrahvi lõikes 2 nimetatud alusel edasi lükatud või täitmisele pööramisest loobutud. (2) Süüdimõistetu elukoha järgse maakohtu täitmiskohtunik võib süüdimõistetu taotlusel lükata oma määrusega edasi lisakaristusena mõistetud tegutsemiskeelu või ettevõtluskeelu täitmisele pööramise kuni kuue kuu võrra või ta võib selle täitmisele pööramisest loobuda, kui täitmisega võivad kaasneda rasked tagajärjed süüdimõistetule või tema perekonnaliikmetele. (3) Ettevõtluskeelu kohaldamisel edastab kohus jõustunud kohtuotsuse koopia registripidajale ettevõtluskeelu andmete sisestamiseks asjakohasesse andmebaasi. Kui lisakaristusena mõistetud ettevõtluskeelu täitmisele pööramine lükatakse edasi või täitmisele pööramisest loobutakse, edastab kohus registripidajale andmebaasis sellekohase märke tegemiseks ka vastava määruse koopia.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_420 (redaktsioon 13087555)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13087555"
    },
    {
      "@id": "estleg:KRIMIN_2_Par_421_v780297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_421"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seadustiku §-s 420 nimetamata lisakaristuse täitmisele pööramiseks saadetakse kohtuotsus või -määrus asjaomasele asutusele süüdimõistetult kohtulahendis märgitud õiguste äravõtmiseks või nende piiramiseks ning süüdimõistetule nende õiguste teostamiseks väljastatud dokumentide kehtetuks tunnistamiseks või hoiulevõtmiseks. (2) Varalist karistust täitmisele pöörates järgitakse käesoleva seadustiku sätteid rahalise karistuse täitmisele pööramise kohta. (3) Väljasaatmine pööratakse täitmisele väljasõidukohustuse ja sissesõidukeelu seaduses (RT I 1998, 98/99, 1575; 2001, 68, 407; 2002, 53, 336; 61, 375; 102, 599; 2003, 4, 21; 13, 65) sätestatud korras.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_421 (redaktsioon 780297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "780297",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_421_v12897094"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_421_v12897094",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_421"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seadustiku §-s 420 nimetamata lisakaristuse täitmisele pööramiseks saadetakse kohtuotsus või -määrus asjaomasele asutusele süüdimõistetult kohtulahendis märgitud õiguste äravõtmiseks või nende piiramiseks ning süüdimõistetule nende õiguste teostamiseks väljastatud dokumentide kehtetuks tunnistamiseks või hoiulevõtmiseks. (2) Varalist karistust täitmisele pöörates järgitakse käesoleva seadustiku sätteid rahalise karistuse täitmisele pööramise kohta. (3) Väljasaatmine pööratakse täitmisele väljasõidukohustuse ja sissesõidukeelu seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_421 (redaktsioon 12897094)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12897094",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_2_Par_421_v130122014009"
      },
      "estleg:versionValidTo": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_2_Par_421_v130122014009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_421"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seadustiku §-s 420 nimetamata lisakaristuse täitmisele pööramiseks saadetakse kohtuotsus või -määrus asjaomasele asutusele süüdimõistetult kohtulahendis märgitud õiguste äravõtmiseks või nende piiramiseks ning temalt vastavate õiguste teostamiseks väljastatud dokumentide kehtetuks tunnistamiseks või hoiulevõtmiseks või süüdimõistetule kohtulahendis märgitud keelu kohaldamiseks. (2) Varalist karistust täitmisele pöörates järgitakse käesoleva seadustiku sätteid rahalise karistuse täitmisele pööramise kohta. (3) Väljasaatmine pööratakse täitmisele väljasõidukohustuse ja sissesõidukeelu seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_421 (redaktsioon 130122014009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014009"
    },
    {
      "@id": "estleg:KRIMIN_2_Par_421_1_v780297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_2_Par_421_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui seadusega ei ole sätestatud teisiti, saadetakse konfiskeeritud vara ja riigi omandisse läinud asitõendeid käsitleva kohtuotsuse või määruse ja menetlusdokumendi koopia konfiskeeritud vara ja riigi omandisse läinud asitõendite asukoha järgsele maavalitsusele. (2) Konfiskeeritud vara võõrandamise ja hävitamise kulud tasub süüdimõistetu. (3) Konfiskeeritud vara ja riigi omandisse läinud asitõendite üleandmise korra kehtestab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "KRIMIN_2_Par_421_1 (redaktsioon 780297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "780297",
