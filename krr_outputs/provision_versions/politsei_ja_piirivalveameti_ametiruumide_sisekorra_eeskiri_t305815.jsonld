    {
      "@id": "estleg:Reg_305815_Par_5_v305815",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305815_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametiruumidesse võib siseneda ja seal viibida taotleja, kellel on kehtiv majutusluba. Ametiruumidesse võib siseneda ja seal viibida taotleja, kellel on kehtiv majutusluba. 2 (2) Ametiruumidesse võib taotleja siseneda ja sealt väljuda päevasel ajal. Päevaseks ajaks loetakse ajavahemikku kella 6.00-st kuni 22.00-ni. Ametiruumidesse võib taotleja siseneda ja sealt väljuda päevasel ajal. Päevaseks ajaks loetakse ajavahemikku kella 6.00-st kuni 22.00-ni. 3 (3) Ametiruumidesse ei lubata taotlejat, kes on alkoholi, narkootilise või psühhotroopse aine tarvitamisest põhjustatud joobeseisundis. Ametiruumidesse ei lubata taotlejat, kes on alkoholi, narkootilise või psühhotroopse aine tarvitamisest põhjustatud joobeseisundis. 4 (4) Ametiruumidesse sisenemine ja sealt väljumine registreeritakse. Sisenemisel kontrollitakse majutusloa olemasolu. RT I 2013-09-28 1 128092013001 2013-10-01 Ametiruumidesse sisenemine ja sealt väljumine registreeritakse. Sisenemisel kontrollitakse majutusloa olemasolu.",
      "rdfs:label": {
        "@value": "Reg_305815_Par_5 (redaktsioon 305815)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305815",
