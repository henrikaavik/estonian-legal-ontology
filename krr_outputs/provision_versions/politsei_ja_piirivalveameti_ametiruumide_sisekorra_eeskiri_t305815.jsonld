    {
      "@id": "estleg:Reg_305815_Par_4_v305815",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305815_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Esmavajalikud tarbeesemed väljastatakse taotlejale allkirja vastu. Esmavajalikeks tarbeesemeteks on vooditarbed ja käterätik. Esmavajalikud tarbeesemed väljastatakse taotlejale allkirja vastu. Esmavajalikeks tarbeesemeteks on vooditarbed ja käterätik. 2 (2) Esmavajalikud hügieenivahendid väljastatakse taotlejale allkirja vastu, kui taotlejal neid ei ole ja tal puuduvad rahalised vahendid nende soetamiseks. Esmavajalikeks hügieenivahenditeks on tualettseep, šampoon, hambapasta, hambahari, raseerimisvahendid, hügieenisidemed ja mähkmed. Esmavajalikud hügieenivahendid väljastatakse taotlejale allkirja vastu, kui taotlejal neid ei ole ja tal puuduvad rahalised vahendid nende soetamiseks. Esmavajalikeks hügieenivahenditeks on tualettseep, šampoon, hambapasta, hambahari, raseerimisvahendid, hügieenisidemed ja mähkmed.",
      "rdfs:label": {
