      "estleg:provisionRef": "Reg_305815 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305815_Map"
      }
    },
    {
      "@id": "estleg:Reg_305815_Par_2_v305815",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305815_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametiruumidesse sisenemiseks ja seal viibimiseks annab taotlejale loa (edaspidi majutusluba) selleks volitatud Politsei- ja Piirivalveameti ametnik (edaspidi volitatud ametnik). Majutusloa andmisel määratakse selle kehtivusaeg. RT I 2013-09-28 1 128092013001 2013-10-01 Ametiruumidesse sisenemiseks ja seal viibimiseks annab taotlejale loa (edaspidi majutusluba) selleks volitatud Politsei- ja Piirivalveameti ametnik (edaspidi volitatud ametnik). Majutusloa andmisel määratakse selle kehtivusaeg. 2 (2) Volitatud ametnik tunnistab taotlejale antud majutusloa kehtetuks järgmistel juhtudel: 1 1) majutusvajadus on ära langenud; 2 2) taotleja rikub ametiruumides viibimise korda; RT I 2013-09-28 1 128092013001 2013-10-01 3 3) esineb välismaalasele rahvusvahelise kaitse andmise seaduse § 361 sätestatud rahvusvahelise kaitse taotleja kinnipidamise alus. 2016-05-02 RT I 2016-05-10 8 110052016008 2016-05-13 Volitatud ametnik tunnistab taotlejale antud majutusloa kehtetuks järgmistel juhtudel: majutusvajadus on ära langenud; taotleja rikub ametiruumides viibimise korda; esineb välismaalasele rahvusvahelise kaitse andmise seaduse § 361 sätestatud rahvusvahelise kaitse taotleja kinnipidamise alus. 3 (3) Majutusloa andmine ja kehtetuks tunnistamine registreeritakse vastavalt Politsei- ja Piirivalveameti asjaajamiskorrale. RTL 2009 99 1476 13250661 2010-01-01+02:00 Majutusloa andmine ja kehtetuks tunnistamine registreeritakse vastavalt Politsei- ja Piirivalveameti asjaajamiskorrale.",
      "rdfs:label": {
        "@value": "Reg_305815_Par_2 (redaktsioon 305815)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305815",
