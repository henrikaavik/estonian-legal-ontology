      }
    },
    {
      "@id": "estleg:FIS_Par_8_v27053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:FIS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu koosneb kuuest liikmest, kellest kaks on liikmed ametikoha järgi ja neli on nimetatavad liikmed. (2) Rahandusminister ja Eesti Panga president on nõukogu liikmed ametikoha järgi. (3) Nõukogu nimetatavatest liikmetest pooled nimetab ja kutsub tagasi rahandusministri ettepanekul Vabariigi Valitsus ja pooled Eesti Panga presidendi ettepanekul Eesti Panga Nõukogu.",
      "rdfs:label": {
        "@value": "FIS_Par_8 (redaktsioon 27053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27053",
      "estleg:supersededByVersion": {
        "@id": "estleg:FIS_Par_8_v109052014009"
      },
      "estleg:versionValidTo": {
        "@value": "2014-05-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27053",
      "estleg:sourceAct": "Finantsinspektsiooni seadus",
      "estleg:provisionRef": "FIS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:FIS_Map"
      }
    },
    {
      "@id": "estleg:FIS_Par_8_v109052014009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:FIS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu koosneb kuuest liikmest, kellest kaks on liikmed ametikoha järgi ja neli on nimetatavad liikmed. (2) Valdkonna eest vastutav minister ja Eesti Panga president on nõukogu liikmed ametikoha järgi. (3) Nõukogu nimetatavatest liikmetest pooled nimetab ja kutsub tagasi valdkonna eest vastutava ministri ettepanekul Vabariigi Valitsus ja pooled Eesti Panga presidendi ettepanekul Eesti Panga Nõukogu. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel paragrahvis läbivalt asendatud alates 2014. aasta 1. juulist „rahandusminister” sõnadega „valdkonna eest vastutav minister” vastavas käändes.",
      "rdfs:label": {
        "@value": "FIS_Par_8 (redaktsioon 109052014009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052014009",
