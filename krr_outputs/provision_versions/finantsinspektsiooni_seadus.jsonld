      },
      "estleg:versionValidTo": {
        "@value": "2011-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12880901",
      "estleg:sourceAct": "Finantsinspektsiooni seadus",
      "estleg:provisionRef": "FIS § 22_1",
      "estleg:partOfAct": {
        "@id": "estleg:FIS_Map"
      }
    },
    {
      "@id": "estleg:FIS_Par_22_1_v108072011024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:FIS_Par_22_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juhatuse liige annab Inspektsiooni nimel korraldusi: finantsjärelevalve subjektilt ja kolmandalt isikult finantsjärelevalve menetluses tähtsust omava teabe nõudmiseks; finantsjärelevalve subjekti ja kolmanda isiku ilmumiseks Inspektsiooni ametiruumidesse seoses finantsjärelevalve menetluses tähtsust omava teabe andmisega; finantsjärelevalve subjekti kohapealse kontrolli tegemiseks; väärtpaberitega kauplemise peatamiseks või lõpetamiseks vastavalt väärtpaberituru seaduses sätestatule. (2) Kui käesoleva paragrahvi lõike 1 punktides 1–3 nimetatud isik ei täida talle korraldusega pandud kohustustust korralduses märgitud tähtpäevaks, võib tema suhtes rakendada sunniraha korralduses märgitud summas.",
      "rdfs:label": {
        "@value": "FIS_Par_22_1 (redaktsioon 108072011024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072011024",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072011024",
      "estleg:sourceAct": "Finantsinspektsiooni seadus",
      "estleg:provisionRef": "FIS § 22_1",
      "estleg:partOfAct": {
        "@id": "estleg:FIS_Map"
      }
    },
    {
      "@id": "estleg:FIS_Par_23_v27053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:FIS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu valib juhatuse liikmete hulgast juhatuse esimehe nõukogu reglemendis sätestatud korras. Juhatuse esimehe äraolekul täidab esimehe ülesandeid vanim juhatuse liige, kui juhatuse esimees ei ole oma käskkirjaga määranud teisiti. (2) Juhatuse esimees: korraldab juhatuse tegevust; kutsub kokku ja juhatab juhatuse koosolekuid ning korraldab nende protokollimist; korraldab Inspektsiooni asjaajamist ja Inspektsiooni tegevuse avalikustamist; korraldab Inspektsiooni raamatupidamist; otsustab nõukogu poolt kinnitatud eelarve kohaselt ja ulatuses Inspektsiooni tegevuseks vajalike kulutuste tegemise; sõlmib, muudab, peatab ja lõpetab töölepingud töötajatega. (3) Juhatuse esimees esindab Inspektsiooni kohtus ning suhetes riigiasutustega, Eesti Panga, muude isikute, rahvusvaheliste finantsjärelevalve organisatsioonidega ning välisriikide finantsjärelevalve asutustega ja muude pädevate asutuste, organisatsioonide või isikutega. (4) Juhatuse esimees annab juhatuse otsuse alusel volikirju teistele juhatuse liikmetele, töötajatele ja kolmandatele isikutele Inspektsiooni esindamiseks.",
      "rdfs:label": {
        "@value": "FIS_Par_23 (redaktsioon 27053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27053",
      "estleg:supersededByVersion": {
        "@id": "estleg:FIS_Par_23_v13124188"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27053",
      "estleg:sourceAct": "Finantsinspektsiooni seadus",
      "estleg:provisionRef": "FIS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:FIS_Map"
      }
    },
    {
      "@id": "estleg:FIS_Par_23_v13124188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:FIS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu valib juhatuse liikmete hulgast juhatuse esimehe nõukogu reglemendis sätestatud korras. Juhatuse esimehe äraolekul täidab esimehe ülesandeid vanim juhatuse liige, kui juhatuse esimees ei ole oma käskkirjaga määranud teisiti. (2) Juhatuse esimees: korraldab juhatuse tegevust; kutsub kokku ja juhatab juhatuse koosolekuid ning korraldab nende protokollimist; korraldab Inspektsiooni asjaajamist ja Inspektsiooni tegevuse avalikustamist; korraldab Inspektsiooni raamatupidamist; otsustab nõukogu poolt kinnitatud eelarve kohaselt ja ulatuses Inspektsiooni tegevuseks vajalike kulutuste tegemise; sõlmib, muudab ja ütleb töölepingud töötajatega üles. (3) Juhatuse esimees esindab Inspektsiooni kohtus ning suhetes riigiasutustega, Eesti Panga, muude isikute, rahvusvaheliste finantsjärelevalve organisatsioonidega ning välisriikide finantsjärelevalve asutustega ja muude pädevate asutuste, organisatsioonide või isikutega. (4) Juhatuse esimees annab juhatuse otsuse alusel volikirju teistele juhatuse liikmetele, töötajatele ja kolmandatele isikutele Inspektsiooni esindamiseks.",
      "rdfs:label": {
        "@value": "FIS_Par_23 (redaktsioon 13124188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13124188",
      "estleg:supersededByVersion": {
        "@id": "estleg:FIS_Par_23_v129032012004"
      },
      "estleg:versionValidTo": {
        "@value": "2012-03-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13124188",
      "estleg:sourceAct": "Finantsinspektsiooni seadus",
      "estleg:provisionRef": "FIS § 23",
      "estleg:partOfAct": {
