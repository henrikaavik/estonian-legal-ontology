    {
      "@id": "estleg:FIS_Par_1_v27053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:FIS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadusega määratakse kindlaks riikliku finantsjärelevalve eesmärk ning finantsinspektsiooni õiguslik seisund, tegevuse alused ning tema rahastamise alused ja kord.",
      "rdfs:label": {
        "@value": "FIS_Par_1 (redaktsioon 27053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27053",
      "estleg:supersededByVersion": {
