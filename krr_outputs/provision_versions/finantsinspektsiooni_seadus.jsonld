    {
      "@id": "estleg:FIS_Par_50_3_v107042017007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:FIS_Par_50_3"
