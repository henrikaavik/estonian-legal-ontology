      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102062021003",
      "estleg:sourceAct": "Finantsinspektsiooni seadus",
      "estleg:provisionRef": "FIS § 54",
      "estleg:partOfAct": {
        "@id": "estleg:FIS_Map"
