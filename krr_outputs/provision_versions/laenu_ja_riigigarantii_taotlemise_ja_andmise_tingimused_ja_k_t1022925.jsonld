      "estleg:sourceAct": "Laenu ja riigigarantii taotlemise ja andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1022925 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022925_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1022925_Par_6_v1022925",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022925_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laenu ja riigigarantii andmise otsustamisel ja tingimuste määramisel arvestatakse riigiabi andmise reegleid. Laenu ja riigigarantii andmise otsustamisel ja tingimuste määramisel arvestatakse riigiabi andmise reegleid.",
      "rdfs:label": {
        "@value": "Reg_1022925_Par_6 (redaktsioon 1022925)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022925",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022925",
      "estleg:sourceAct": "Laenu ja riigigarantii taotlemise ja andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1022925 § 6",
      "estleg:partOfAct": {
