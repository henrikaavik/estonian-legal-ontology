        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse riigi antava laenu ja riigigarantii taotlemise ja andmise tingimused ja kord. Määrusega kehtestatakse riigi antava laenu ja riigigarantii taotlemise ja andmise tingimused ja kord.",
      "rdfs:label": {
        "@value": "Reg_1022925_Par_1 (redaktsioon 1022925)",
        "@language": "et"
      },
