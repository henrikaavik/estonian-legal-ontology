      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1018083_Par_3 (redaktsioon 1018083)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1018083",
