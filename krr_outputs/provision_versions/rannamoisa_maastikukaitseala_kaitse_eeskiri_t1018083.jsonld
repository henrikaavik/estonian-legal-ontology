      "estleg:provisionRef": "Reg_1018083 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1018083_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1018083_Par_9_v1018083",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1018083_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rannamõisa sihtkaitsevööndi kaitse-eesmärk on kaitsta ranna- ja metsakooslusi ja kaitsealuste liikide elupaiku ning säilitada maastikuilme. Rannamõisa sihtkaitsevööndi kaitse-eesmärk on kaitsta ranna- ja metsakooslusi ja kaitsealuste liikide elupaiku ning säilitada maastikuilme.",
