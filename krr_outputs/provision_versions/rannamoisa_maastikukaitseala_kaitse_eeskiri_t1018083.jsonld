      "estleg:provisionRef": "Reg_1018083 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1018083_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1018083_Par_2_v1018083",
