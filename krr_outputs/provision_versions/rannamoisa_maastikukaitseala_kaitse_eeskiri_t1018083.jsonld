      "estleg:sourceAct": "Rannamõisa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1018083 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1018083_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1018083_Par_12_v1018083",
      "@type": [
        "owl:NamedIndividual",
