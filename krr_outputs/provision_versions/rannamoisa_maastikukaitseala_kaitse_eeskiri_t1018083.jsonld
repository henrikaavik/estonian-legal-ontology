      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on kaitsta metsa- ja poollooduslikke kooslusi ja kaitsealuste liikide elupaiku ning säilitada maastikuilme. Piiranguvööndi kaitse-eesmärk on kaitsta metsa- ja poollooduslikke kooslusi ja kaitsealuste liikide elupaiku ning säilitada maastikuilme.",
      "rdfs:label": {
