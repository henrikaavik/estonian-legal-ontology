      },
      "estleg:versionText": "Komisjoni töö korraldamise ja tehnilise teenindamise tagab Tarbijakaitse ja Tehnilise Järelevalve Amet. Komisjoni töö korraldamise ja tehnilise teenindamise tagab Tarbijakaitse ja Tehnilise Järelevalve Amet.",
      "rdfs:label": {
        "@value": "Reg_1057191_Par_2 (redaktsioon 1057191)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057191",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057191",
      "estleg:sourceAct": "Välisinvesteeringukomisjoni töökord",
      "estleg:provisionRef": "Reg_1057191 § 2",
      "estleg:partOfAct": {
