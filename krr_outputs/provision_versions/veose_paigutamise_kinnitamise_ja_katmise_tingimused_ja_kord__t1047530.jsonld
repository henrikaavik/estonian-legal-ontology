    {
      "@id": "estleg:Reg_1047530_Par_4_v1047530",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047530_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Veose kinnitamiseks tuleb valida viis ja vahend, mis kõige paremini vastab veose iseloomule ja omadustele ning tagab kohtkindla kinnituse. Veose kinnitamiseks tuleb valida viis ja vahend, mis kõige paremini vastab veose iseloomule ja omadustele ning tagab kohtkindla kinnituse. 2 (2) Kinnitusviisi valikul tuleb arvestada, kas kinnitusvahend on vajalik veose libisemise, veeremise või vibratsiooni vältimiseks, samuti kas on vajalik hõõrdejõudu suurendav sidumine või veose liikumist tõkestav sidumine. Kinnitusviisi valikul tuleb arvestada, kas kinnitusvahend on vajalik veose libisemise, veeremise või vibratsiooni vältimiseks, samuti kas on vajalik hõõrdejõudu suurendav sidumine või veose liikumist tõkestav sidumine. 3 (3) Veose kinnitusvahendid ei tohi veost kahjustada. Samuti ei tohi veos kahjustada kinnitusvahendeid. Vajadusel tuleb kahjustuste vältimiseks kasutada eri- või lisavahendeid. Veose kinnitusvahendid ei tohi veost kahjustada. Samuti ei tohi veos kahjustada kinnitusvahendeid. Vajadusel tuleb kahjustuste vältimiseks kasutada eri- või lisavahendeid. 4 (4) Veose kinnitamisel tuleb arvestada sõiduki ja kaubaruumi konstruktsiooni arvestuslikku tugevust, hõõrdejõudu veose ja kaubaruumi vahel ning veose kinnitamisega saavutatavat täiendavat hõõrdejõudu või tõkestusjõudu. Veose kinnitamisel tuleb arvestada sõiduki ja kaubaruumi konstruktsiooni arvestuslikku tugevust, hõõrdejõudu veose ja kaubaruumi vahel ning veose kinnitamisega saavutatavat täiendavat hõõrdejõudu või tõkestusjõudu.",
      "rdfs:label": {
        "@value": "Reg_1047530_Par_4 (redaktsioon 1047530)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047530",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047530",
      "estleg:sourceAct": "Veose paigutamise, kinnitamise ja katmise tingimused ja kord ning liiklusjärelevalve teostaja kasutatavad kontrollimise meetodid",
      "estleg:provisionRef": "Reg_1047530 § 4",
      "estleg:partOfAct": {
