      }
    },
    {
      "@id": "estleg:Reg_1047530_Par_6_v1047530",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047530_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Avatud kaubaruumi kasutamisel tuleb veos katta, kui on oht selle tolmamiseks, lendumiseks või varisemiseks. Avatud kaubaruumi kasutamisel tuleb veos katta, kui on oht selle tolmamiseks, lendumiseks või varisemiseks. 2 (2) Katmiseks tuleb kasutada kattelina, -kilet või -võrku. Katmiseks tuleb kasutada kattelina, -kilet või -võrku. 3 (3) Veose katmiseks kasutatav materjal tuleb kinnitada selliselt, et sõidul tekkiv õhuvool ei rebiks katet lahti. Veose katmiseks kasutatav materjal tuleb kinnitada selliselt, et sõidul tekkiv õhuvool ei rebiks katet lahti. 4 (4) Veose katmisel tuleb veenduda, et kattematerjali tepingud oleksid terved, kattematerjalil ja selle rihmadel ei oleks vigastusi ning võrkude metallosad ei oleks korrodeerunud või kahjustatud. Trossidest ja köitest võrkudel ei tohi olla sisselõikeid ega kiuvigastusi. Veose katmisel tuleb veenduda, et kattematerjali tepingud oleksid terved, kattematerjalil ja selle rihmadel ei oleks vigastusi ning võrkude metallosad ei oleks korrodeerunud või kahjustatud. Trossidest ja köitest võrkudel ei tohi olla sisselõikeid ega kiuvigastusi. 5 (5) Kattevõrgu võrgusilm peab olema piisavalt väike, et vältida veose väikseima osa veosest eemaldumist. Kattevõrgu võrgusilm peab olema piisavalt väike, et vältida veose väikseima osa veosest eemaldumist.",
      "rdfs:label": {
        "@value": "Reg_1047530_Par_6 (redaktsioon 1047530)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047530",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047530",
      "estleg:sourceAct": "Veose paigutamise, kinnitamise ja katmise tingimused ja kord ning liiklusjärelevalve teostaja kasutatavad kontrollimise meetodid",
      "estleg:provisionRef": "Reg_1047530 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047530_Map"
