      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu hooldustöid, haldamist ning arendustöid rahastatakse andmekogu haldamise teenuse pakkuja vahenditest. Andmekogu hooldustöid, haldamist ning arendustöid rahastatakse andmekogu haldamise teenuse pakkuja vahenditest.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_22 (redaktsioon 345722)",
