      "estleg:provisionRef": "Reg_345722 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_24_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni andmekogu haldamiseks infosüsteemi loomiseni võib andmekogu pidada paberkandjal. Kuni andmekogu haldamiseks infosüsteemi loomiseni võib andmekogu pidada paberkandjal.",
