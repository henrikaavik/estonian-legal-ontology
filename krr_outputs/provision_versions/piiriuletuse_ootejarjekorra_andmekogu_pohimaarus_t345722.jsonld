      }
    },
    {
      "@id": "estleg:Reg_345722_Par_25_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist. Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_25 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 25",
