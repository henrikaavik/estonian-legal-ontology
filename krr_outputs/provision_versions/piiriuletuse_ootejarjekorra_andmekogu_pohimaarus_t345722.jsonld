      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu likvideerimise otsustab valdkonna eest vastutav minister. Andmekogu likvideeritakse kooskõlas arhiiviseaduses sätestatud nõuetega. RT I 2016-07-22 1 122072016001 2016-09-01 Andmekogu likvideerimise otsustab valdkonna eest vastutav minister. Andmekogu likvideeritakse kooskõlas arhiiviseaduses sätestatud nõuetega.",
      "rdfs:label": {
