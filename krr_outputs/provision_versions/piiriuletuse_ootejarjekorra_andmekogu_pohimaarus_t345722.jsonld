    },
    {
      "@id": "estleg:Reg_345722_Par_10_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu andmete esitajaks on piiriületuse ootejärjekorra kohta taotlev isik. Andmekogu andmete esitajaks on piiriületuse ootejärjekorra kohta taotlev isik.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_10 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_11_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alusdokumendid on: 1 1) piiriületuse ootejärjekorra koha taotlus; 2 2) kehtetu - RT I 2016-07-22 1 122072016001 2016-09-01 3 3) kehtetu - RT I 2016-07-22 1 122072016001 2016-09-01 4 4) eelisjärjekorras piiriületuseks ootejärjekorra koha võtmist tõendavad dokumendid; 5 5) käesoleva määruse § 8 lõikes 1 nimetatud dokumendid; 6 6) muud esitatud dokumendid ja tõendid. Alusdokumendid on: piiriületuse ootejärjekorra koha taotlus; kehtetu - kehtetu - eelisjärjekorras piiriületuseks ootejärjekorra koha võtmist tõendavad dokumendid; käesoleva määruse § 8 lõikes 1 nimetatud dokumendid; muud esitatud dokumendid ja tõendid.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_11 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_12_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) «Riigipiiri seaduses» ning selle alusel sätestatud tingimustel ja korras kannab andmed andmekogusse: 1 1) piiriületuse ooteala teenuse pakkuja; 2 2) piiriületuse ootejärjekorra koha taotleja; 3 3) piiriületuse ootejärjekorra andmekogu haldamise teenuse pakkuja; 4 4) Politsei- ja Piirivalveamet. RT I 2011-12-29 72 129122011072 2012-01-01 «Riigipiiri seaduses» ning selle alusel sätestatud tingimustel ja korras kannab andmed andmekogusse: piiriületuse ooteala teenuse pakkuja; piiriületuse ootejärjekorra koha taotleja; piiriületuse ootejärjekorra andmekogu haldamise teenuse pakkuja; Politsei- ja Piirivalveamet. 2 (2) Andmed kantakse andmekogusse viivitamatult pärast andmete saamist. Andmed kantakse andmekogusse viivitamatult pärast andmete saamist.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_12 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_13_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmete esitaja vastutab tema poolt esitatud andmete ja alusdokumentidel olevate andmete õigsuse eest alusdokumendi esitamise ajal. Andmekogu haldamise teenuse pakkuja, Politsei- ja Piirivalveamet ning piiriületuse ooteala teenuse pakkuja vastutavad nende poolt andmekogusse kantud andmete vastavuse eest andmete esitaja poolt esitatud andmetele. RT I 2016-07-22 1 122072016001 2016-09-01 Andmete esitaja vastutab tema poolt esitatud andmete ja alusdokumentidel olevate andmete õigsuse eest alusdokumendi esitamise ajal. Andmekogu haldamise teenuse pakkuja, Politsei- ja Piirivalveamet ning piiriületuse ooteala teenuse pakkuja vastutavad nende poolt andmekogusse kantud andmete vastavuse eest andmete esitaja poolt esitatud andmetele.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_13 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_14_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui volitatud töötleja tuvastab andmekogus ebaõigeid andmeid või kui teda on nendest teavitatud, teavitab ta sellest kohe andmekogu haldamise teenuse pakkujat, välja arvatud juhul, kui tal on võimalik andmed iseseisvalt parandada. Andmete parandamisel lisatakse andmekogusse võimaluse korral viide õigeid andmeid tõendavale dokumendile. RT I 2016-07-22 1 122072016001 2016-09-01 Kui volitatud töötleja tuvastab andmekogus ebaõigeid andmeid või kui teda on nendest teavitatud, teavitab ta sellest kohe andmekogu haldamise teenuse pakkujat, välja arvatud juhul, kui tal on võimalik andmed iseseisvalt parandada. Andmete parandamisel lisatakse andmekogusse võimaluse korral viide õigeid andmeid tõendavale dokumendile.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_14 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_15_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu haldamise teenuse pakkuja peab arvestust andmete andmekogusse vastuvõtmise aja, andmete koosseisu ja andmete esitajate üle. RT I 2016-07-22 1 122072016001 2016-09-01 Andmekogu haldamise teenuse pakkuja peab arvestust andmete andmekogusse vastuvõtmise aja, andmete koosseisu ja andmete esitajate üle.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_15 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_16_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogusse kantud andmetele juurdepääsu ei suleta. Andmekogusse kantud andmetele juurdepääsu ei suleta.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_16 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_17_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse kantud andmetele võimaldatakse juurdepääs vastavalt õigusaktides sätestatule. RT I 2018-09-18 1 118092018001 2018-09-21 Andmekogusse kantud andmetele võimaldatakse juurdepääs vastavalt õigusaktides sätestatule. 2 (2) Juurdepääs andmekogusse kantud andmetele on volitatud ja vastutava töötleja, andmekaitse järelevalveasutuse ning andmekogu haldamise üle järelevalvet teostava asutuse poolt selleks volitatud isikutel nende teenistusülesannetega või nendele halduslepingu alusel üle antud andmekogu haldamise ülesandega määratud ulatuses. Juurdepääs andmekogusse kantud andmetele on volitatud ja vastutava töötleja, andmekaitse järelevalveasutuse ning andmekogu haldamise üle järelevalvet teostava asutuse poolt selleks volitatud isikutel nende teenistusülesannetega või nendele halduslepingu alusel üle antud andmekogu haldamise ülesandega määratud ulatuses. 3 (3) Andmekogule juurdepääsu õigus on ka isikul, kes arendab või hooldab andmekogu, arendus- või hoolduslepingus sätestatud ulatuses ja tingimustel. Andmekogule juurdepääsu õigus on ka isikul, kes arendab või hooldab andmekogu, arendus- või hoolduslepingus sätestatud ulatuses ja tingimustel.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_17 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_18_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse kantud andmed väljastatakse: 1 1) andmesubjektile või tema seaduslikule esindajale tema kohta käivaid isikuandmeid õigusaktides sätestatu kohaselt; RT I 2018-09-18 1 118092018001 2018-09-21 2 2) riigi- ja kohaliku omavalitsuse üksuse asutustele, avalik-õiguslikele juriidilistele isikutele ja eraõiguslikele juriidilistele isikutele, kui see on vajalik neile seaduse või seaduse alusel antud õigusaktidega pandud ülesannete täitmiseks; RT I 2020-07-14 2 114072020002 2020-08-01 3 3) teistele andmesaajatele, kui see on kooskõlas seaduste, teiste õigusaktide ja käesoleva määruse sätetega. Andmekogusse kantud andmed väljastatakse: andmesubjektile või tema seaduslikule esindajale tema kohta käivaid isikuandmeid õigusaktides sätestatu kohaselt; riigi- ja kohaliku omavalitsuse üksuse asutustele, avalik-õiguslikele juriidilistele isikutele ja eraõiguslikele juriidilistele isikutele, kui see on vajalik neile seaduse või seaduse alusel antud õigusaktidega pandud ülesannete täitmiseks; teistele andmesaajatele, kui see on kooskõlas seaduste, teiste õigusaktide ja käesoleva määruse sätetega. 2 (2) Andmekogu haldamise teenuse pakkuja ja piiriületuse ooteala teenuse pakkuja väljastavad sõiduki omanikule, kasutajale ja sõiduki piiriületuse ootejärjekorra koha taotlejale järgmiseid andmeid: RT I 2020-07-14 2 114072020002 2020-08-01 1 1) andmed sõiduki järjekorrakoha kohta; 2 2) andmed eeldatava järjekorras ootamise aja kohta; 3 3) andmed eeldatava piiriületuse aja kohta; 4 4) andmed piiripunkti suunamise kohta. Andmekogu haldamise teenuse pakkuja ja piiriületuse ooteala teenuse pakkuja väljastavad sõiduki omanikule, kasutajale ja sõiduki piiriületuse ootejärjekorra koha taotlejale järgmiseid andmeid: andmed sõiduki järjekorrakoha kohta; andmed eeldatava järjekorras ootamise aja kohta; andmed eeldatava piiriületuse aja kohta; andmed piiripunkti suunamise kohta. 3 (3) Juurdepääs käesoleva määruse §-s 8 sätestatud andmetele ilma andmete muutmise õiguseta on «Julgeolekuasutuste seaduses» ja «Kriminaalmenetluse seadustikus» sätestatud ülesannete täitmiseks Kaitsepolitseiameti ja Välisluureameti teenistujatel nende teenistusülesannetega määratud ulatuses. RT I 2017-06-20 1 120062017001 2017-07-01 Juurdepääs käesoleva määruse §-s 8 sätestatud andmetele ilma andmete muutmise õiguseta on «Julgeolekuasutuste seaduses» ja «Kriminaalmenetluse seadustikus» sätestatud ülesannete täitmiseks Kaitsepolitseiameti ja Välisluureameti teenistujatel nende teenistusülesannetega määratud ulatuses. 4 (4) Andmekogu vastutav töötleja otsustab kolmandatele isikutele andmetele juurdepääsu andmise andmesideühenduse kaudu neile seadusega pandud ülesannete täitmiseks. Vajadusel sõlmitakse andmesaajaga väljastatavate andmete kaitse leping, kus sätestatakse väljastatavate andmete koosseis, andmete väljastamise eesmärk, tingimused, kord ja viis. Andmekogu vastutav töötleja otsustab kolmandatele isikutele andmetele juurdepääsu andmise andmesideühenduse kaudu neile seadusega pandud ülesannete täitmiseks. Vajadusel sõlmitakse andmesaajaga väljastatavate andmete kaitse leping, kus sätestatakse väljastatavate andmete koosseis, andmete väljastamise eesmärk, tingimused, kord ja viis. 5 (5) Andmekogust väljastatakse andmeid tasuta. Andmekogust väljastatakse andmeid tasuta.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_18 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_19_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu haldamise teenuse pakkuja peab digitaalselt või digitaalse võimaluse puudumisel paberkandjal arvestust andmete väljastamise aja, andmete koosseisu ja andmete saajate üle. RT I 2016-07-22 1 122072016001 2016-09-01 Andmekogu haldamise teenuse pakkuja peab digitaalselt või digitaalse võimaluse puudumisel paberkandjal arvestust andmete väljastamise aja, andmete koosseisu ja andmete saajate üle.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_19 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_2_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu vastutav töötleja on Siseministeerium. Andmekogu vastutav töötleja on Siseministeerium. 2 (2) Andmekogu volitatud töötlejad on kohaliku omavalitsuse üksus või eraõiguslik juriidiline isik, kellele on andmekogu haldamise ülesanne halduslepingu alusel üle antud (edaspidi andmekogu haldamise teenuse pakkuja), Politsei- ja Piirivalveamet, Maksu- ja Tolliamet ning piiriületuse ooteala teenuse pakkuja. RT I 2020-07-14 2 114072020002 2020-08-01 Andmekogu volitatud töötlejad on kohaliku omavalitsuse üksus või eraõiguslik juriidiline isik, kellele on andmekogu haldamise ülesanne halduslepingu alusel üle antud (edaspidi andmekogu haldamise teenuse pakkuja), Politsei- ja Piirivalveamet, Maksu- ja Tolliamet ning piiriületuse ooteala teenuse pakkuja.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_2 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_20_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu andmeid säilitab volitatud töötleja vastavalt «Arhiiviseadusele» ja selle alusel kehtestatud õigusaktidele ning volitatud töötleja kehtestatud asjaajamise eeskirjadele. Andmekogu andmeid säilitab volitatud töötleja vastavalt «Arhiiviseadusele» ja selle alusel kehtestatud õigusaktidele ning volitatud töötleja kehtestatud asjaajamise eeskirjadele. 2 (2) Füüsiliste ja juriidiliste isikute piiriületuse ootejärjekorra koha taotlemise andmeid ning käesoleva määruse § 7 lõikes 4 sätestatud andmeid säilitatakse kaks aastat. Säilitustähtaja möödumisel andmed kustutatakse. RT I 2016-07-22 1 122072016001 2016-09-01 Füüsiliste ja juriidiliste isikute piiriületuse ootejärjekorra koha taotlemise andmeid ning käesoleva määruse § 7 lõikes 4 sätestatud andmeid säilitatakse kaks aastat. Säilitustähtaja möödumisel andmed kustutatakse. 3 (3) Käesoleva määruse § 8 lõigetes 3–5 nimetatud andmed kustutatakse andmekogust pärast töötlemist viivitamata, kuid mitte hiljem kui 24 tunni jooksul andmete andmekogusse kandmisest. RT I 2018-04-11 1 111042018001 2018-04-14 Käesoleva määruse § 8 lõigetes 3–5 nimetatud andmed kustutatakse andmekogust pärast töötlemist viivitamata, kuid mitte hiljem kui 24 tunni jooksul andmete andmekogusse kandmisest.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_20 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_21_v345722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345722_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Järelevalvet isikuandmete töötlemise ja andmekogu pidamise üle teostatakse isikuandmete kaitse seaduses ja avaliku teabe seaduses sätestatud korras. RT I 2016-07-22 1 122072016001 2016-09-01 Järelevalvet isikuandmete töötlemise ja andmekogu pidamise üle teostatakse isikuandmete kaitse seaduses ja avaliku teabe seaduses sätestatud korras. 2 (2) Kui andmekogu haldamise ülesanne on halduslepingu alusel antud üle kohaliku omavalitsuse üksusele või eraõiguslikule juriidilisele isikule, teostab andmekogu haldamise ülesande täitmise üle riiklikku järelevalvet Siseministeerium või valdkonna eest vastutava ministri volitusel Politsei- ja Piirivalveamet. RT I 2020-07-14 2 114072020002 2020-08-01 Kui andmekogu haldamise ülesanne on halduslepingu alusel antud üle kohaliku omavalitsuse üksusele või eraõiguslikule juriidilisele isikule, teostab andmekogu haldamise ülesande täitmise üle riiklikku järelevalvet Siseministeerium või valdkonna eest vastutava ministri volitusel Politsei- ja Piirivalveamet. 3 (3) Andmekogu üle järelevalvet teostama volitatud isikul on õigus tutvuda andmekogusse kantud andmete ja nende alusdokumentidega, siseneda ruumidesse, kus andmeid töödeldakse või kus paiknevad nende töötlemiseks kasutatavad seadmed, ja saada teavet andmete töötlemise kohta. Andmekogu üle järelevalvet teostama volitatud isikul on õigus tutvuda andmekogusse kantud andmete ja nende alusdokumentidega, siseneda ruumidesse, kus andmeid töödeldakse või kus paiknevad nende töötlemiseks kasutatavad seadmed, ja saada teavet andmete töötlemise kohta. 4 (4) Andmekogu pidamisel tekkinud puuduste ilmnemisel on vastutav ja volitatud töötleja kohustatud likvideerima järelevalvet teostanud isiku ettekirjutuses kajastatud puudused määratud tähtajaks. Andmekogu pidamisel tekkinud puuduste ilmnemisel on vastutav ja volitatud töötleja kohustatud likvideerima järelevalvet teostanud isiku ettekirjutuses kajastatud puudused määratud tähtajaks.",
      "rdfs:label": {
        "@value": "Reg_345722_Par_21 (redaktsioon 345722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345722",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345722",
      "estleg:sourceAct": "Piiriületuse ootejärjekorra andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_345722 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345722_Map"
      }
    },
    {
      "@id": "estleg:Reg_345722_Par_22_v345722",
      "@type": [
        "owl:NamedIndividual",
