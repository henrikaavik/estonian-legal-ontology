        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu ametlik nimi on «Piiriületuse ootejärjekorra andmekogu» (edaspidi andmekogu). Andmekogu ametlik nimi on «Piiriületuse ootejärjekorra andmekogu» (edaspidi andmekogu).",
      "rdfs:label": {
        "@value": "Reg_345722_Par_1 (redaktsioon 345722)",
        "@language": "et"
      },
