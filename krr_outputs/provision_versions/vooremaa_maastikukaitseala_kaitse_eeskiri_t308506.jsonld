  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_vooremaa_maastikukaitseala_kaitse_eeskiri_t308506_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Vooremaa maastikukaitseala kaitse-eeskiri (17 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vooremaa maastikukaitseala kaitse-eeskiri"
    },
    {
      "@id": "estleg:Reg_308506_Par_1_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vooremaa maastikukaitseala2 (edaspidi kaitseala) kaitse-eesmärk on: 1 1) suurvoorte kaitse; 2 2) pärandkultuurmaastike kaitse; 3 3) nõukogu direktiivi 92/43/EMÜ looduslike elupaikade ning loodusliku loomastiku ja taimestiku kaitse kohta I lisas nimetatud elupaigatüüpide – vähe- kuni kesktoiteliste mõõdukalt kareda veega järvede (31303), vähe- kuni kesktoiteliste kalgiveeliste järvede (3140), niiskuslembeste kõrgrohustute (6430), soostuvate ja soo-lehtmetsade (9080*) ning looduslikult rohketoiteliste järvede (3150) kaitse; 4 4) nõukogu direktiivi 92/43/EMÜ II lisas nimetatud liikide, hariliku hingi (Cobitis taenia), hariliku vingerja (Misgurnus fossilis) ja laiujuri (Dytiscus latissimus), kes kõik on III kategooria kaitsealused liigid, ning II kategooria kaitsealuse liigi kaitse; 5 5) nõukogu direktiivi 92/43/EMÜ IV lisas nimetatud väike-käsitiivaliste elupaikade kaitse; 6 6) nõukogu direktiivi 79/409/EMÜ loodusliku linnustiku kaitse kohta I lisas nimetatud linnuliikide, kes on I või II kategooria kaitsealused liigid, ja I lisas nimetatud liikide – herilaseviu (Pernis apivorus), händkaku (Strix uralensis), jõgitiiru (Sterna hirundo), musträhni (Dryocopus martius), mustviirese (Chlidonias niger), punaselg-õgija (Lanius collurio), roo-loorkulli (Circus aeruginosus), rukkiräägu (Crex crex), sookure (Grus grus), täpikhuigu (Porzana porzana), valge-toonekure (Ciconia ciconia), väike-kärbsenäpi (Ficedula parva), välja-loorkulli (Circus cyaneus), vööt-põõsalinnu (Sylvia nisoria), kes kõik on III kategooria kaitsealused liigid, kaitse. 7 7) hallpõsk-püti (Podiceps grisegena), kes on III kategooria kaitsealune liik, kaitse. Vooremaa maastikukaitseala2 (edaspidi kaitseala) kaitse-eesmärk on: suurvoorte kaitse; pärandkultuurmaastike kaitse; nõukogu direktiivi 92/43/EMÜ looduslike elupaikade ning loodusliku loomastiku ja taimestiku kaitse kohta I lisas nimetatud elupaigatüüpide – vähe- kuni kesktoiteliste mõõdukalt kareda veega järvede (31303), vähe- kuni kesktoiteliste kalgiveeliste järvede (3140), niiskuslembeste kõrgrohustute (6430), soostuvate ja soo-lehtmetsade (9080*) ning looduslikult rohketoiteliste järvede (3150) kaitse; nõukogu direktiivi 92/43/EMÜ II lisas nimetatud liikide, hariliku hingi (Cobitis taenia), hariliku vingerja (Misgurnus fossilis) ja laiujuri (Dytiscus latissimus), kes kõik on III kategooria kaitsealused liigid, ning II kategooria kaitsealuse liigi kaitse; nõukogu direktiivi 92/43/EMÜ IV lisas nimetatud väike-käsitiivaliste elupaikade kaitse; nõukogu direktiivi 79/409/EMÜ loodusliku linnustiku kaitse kohta I lisas nimetatud linnuliikide, kes on I või II kategooria kaitsealused liigid, ja I lisas nimetatud liikide – herilaseviu (Pernis apivorus), händkaku (Strix uralensis), jõgitiiru (Sterna hirundo), musträhni (Dryocopus martius), mustviirese (Chlidonias niger), punaselg-õgija (Lanius collurio), roo-loorkulli (Circus aeruginosus), rukkiräägu (Crex crex), sookure (Grus grus), täpikhuigu (Porzana porzana), valge-toonekure (Ciconia ciconia), väike-kärbsenäpi (Ficedula parva), välja-loorkulli (Circus cyaneus), vööt-põõsalinnu (Sylvia nisoria), kes kõik on III kategooria kaitsealused liigid, kaitse. hallpõsk-püti (Podiceps grisegena), kes on III kategooria kaitsealune liik, kaitse. 2 (2) Kaitseala maa- ja veeala jaguneb vastavalt kaitsekorra eripärale ja majandustegevuse piiramise astmele kolmeks sihtkaitsevööndiks ja üheks piiranguvööndiks. Kaitseala maa- ja veeala jaguneb vastavalt kaitsekorra eripärale ja majandustegevuse piiramise astmele kolmeks sihtkaitsevööndiks ja üheks piiranguvööndiks. 3 (3) Kaitsealal tuleb arvestada «Looduskaitseseaduses» sätestatud piiranguid käesolevas määruses sätestatud erisustega. Kaitsealal tuleb arvestada «Looduskaitseseaduses» sätestatud piiranguid käesolevas määruses sätestatud erisustega.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_1 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_10_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 2 2) olemasolevate ehitiste hooldustööd; 3 3) koosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures metsakoosluse kujundamisel on kaitseala valitsejal õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas; 4 4) olemasolevate maaparandussüsteemide hoiutööd ja veerežiimi taastamine. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; olemasolevate ehitiste hooldustööd; koosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures metsakoosluse kujundamisel on kaitseala valitsejal õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas; olemasolevate maaparandussüsteemide hoiutööd ja veerežiimi taastamine.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_10 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_11_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) jahipidamine, välja arvatud Ehavere sihtkaitsevööndis 1. septembrist 14. märtsini; 4 4) uute ehitiste püstitamine, välja arvatud tee rajamine, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks, arvestades § 5 punktides 4–7 ja §-s 6 sätestatut. Sihtkaitsevööndis on keelatud: majandustegevus; loodusvarade kasutamine; jahipidamine, välja arvatud Ehavere sihtkaitsevööndis 1. septembrist 14. märtsini; uute ehitiste püstitamine, välja arvatud tee rajamine, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks, arvestades § 5 punktides 4–7 ja §-s 6 sätestatut.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_11 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_12_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nava sihtkaitsevööndis on vajalik puu- ja põõsarinde harvendamine vastavalt kaitse-eesmärgile 1. oktoobrist 31. märtsini. Nava sihtkaitsevööndis on vajalik puu- ja põõsarinde harvendamine vastavalt kaitse-eesmärgile 1. oktoobrist 31. märtsini.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_12 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_13_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Vooremaa piiranguvöönd. Kaitsealal on Vooremaa piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_13 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_14_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vooremaa piiranguvööndi kaitse-eesmärk on Vooremaa maastikule tüüpiliste suurvoorte ja nende vahel asuvate järvede, sealse elustiku mitmekesisuse ja maa kasutamisel väljakujunenud traditsioonilise pärandkultuurmaastiku ilme säilitamine ja taastamine. Vooremaa piiranguvööndi kaitse-eesmärk on Vooremaa maastikule tüüpiliste suurvoorte ja nende vahel asuvate järvede, sealse elustiku mitmekesisuse ja maa kasutamisel väljakujunenud traditsioonilise pärandkultuurmaastiku ilme säilitamine ja taastamine.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_14 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_15_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) jahipidamine; 3 3) ehitise, kaasa arvatud ajutise ehitise püstitamine, arvestades § 5 punktides 4–7 ja §-s 6 sätestatut; 4 4) uuendusraie, sealjuures ei tohi lageraielangi laius ületada 30 meetrit ega pindala 2 hektarit. Piiranguvööndis on lubatud: majandustegevus; jahipidamine; ehitise, kaasa arvatud ajutise ehitise püstitamine, arvestades § 5 punktides 4–7 ja §-s 6 sätestatut; uuendusraie, sealjuures ei tohi lageraielangi laius ületada 30 meetrit ega pindala 2 hektarit. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 2 2) uue maaparandussüsteemi rajamine; 3 3) puhtpuistu kujundamine teadus- ja õppetöö eesmärgil. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; uue maaparandussüsteemi rajamine; puhtpuistu kujundamine teadus- ja õppetöö eesmärgil.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_15 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_16_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) energiapuistute rajamine; 2 2) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 3 3) biotsiidi ja taimekaitsevahendi kasutamine üleujutatavatel aladel ja külmunud pinnasel, metsamaal ning looduslikul rohumaal, välja arvatud kaitseala valitseja nõusolekul teadustöö eesmärgil ning putukkahjurite ja seenhaiguste kahjustuskolletes; 4 4) soo- ja soovikumetsades puidu kokku- ja väljavedu külmumata pinnasel. Piiranguvööndis on keelatud: energiapuistute rajamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; biotsiidi ja taimekaitsevahendi kasutamine üleujutatavatel aladel ja külmunud pinnasel, metsamaal ning looduslikul rohumaal, välja arvatud kaitseala valitseja nõusolekul teadustöö eesmärgil ning putukkahjurite ja seenhaiguste kahjustuskolletes; soo- ja soovikumetsades puidu kokku- ja väljavedu külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_16 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_17_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu säilitamiseks vajalik niitmine, karjatamine, puu- ja põõsarinde harvendamine ning puistu raadamine. Poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu säilitamiseks vajalik niitmine, karjatamine, puu- ja põõsarinde harvendamine ning puistu raadamine. 2 (2) Järvevaadete avamiseks on vajalikud puu- ja põõsarinde raied ning puistu raadamine. Järvevaadete avamiseks on vajalikud puu- ja põõsarinde raied ning puistu raadamine.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_17 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_2_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308506_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Jõgeva maakonnas Palamuse vallas Praaklima, Mullavere, Sudiste, Nava, Ehavere, Pikkjärve, Luua ja Kaiavere külas, Tabivere vallas Tormi, Elistvere, Kaiavere, Juula, Otslava, Kõrenduse, Lilu, Vahi, Valgma, Õvanurme, Voldi, Kärksi, Pataste, Reinu, Raigastvere külas ja Tabivere alevikus ning Tartu maakonnas Tartu vallas Soitsjärve, Äksi, Saadjärve, Puhtaleiva, Kukulinna, Salu ja Igavere külas. Kaitseala asub Jõgeva maakonnas Palamuse vallas Praaklima, Mullavere, Sudiste, Nava, Ehavere, Pikkjärve, Luua ja Kaiavere külas, Tabivere vallas Tormi, Elistvere, Kaiavere, Juula, Otslava, Kõrenduse, Lilu, Vahi, Valgma, Õvanurme, Voldi, Kärksi, Pataste, Reinu, Raigastvere külas ja Tabivere alevikus ning Tartu maakonnas Tartu vallas Soitsjärve, Äksi, Saadjärve, Puhtaleiva, Kukulinna, Salu ja Igavere külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_2 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_308506 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308506_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308506_Par_3_v308506",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
