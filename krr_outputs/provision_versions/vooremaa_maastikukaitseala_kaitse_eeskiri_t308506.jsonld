        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. RT I 2009 7 48 13125268 2009-02-01+02:00 Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_308506_Par_3 (redaktsioon 308506)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308506",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308506",
      "estleg:sourceAct": "Vooremaa maastikukaitseala kaitse-eeskiri",
