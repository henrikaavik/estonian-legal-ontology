  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_seadus_reisipraamlaeva_estonia_hukkumisel_teadmata_kadunuks_jaanud_isikute_surnu_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Seadus \"Reisipraamlaeva \"Estonia\" hukkumisel teadmata kadunuks jäänud isikute surnuks tunnistamise kohta\" (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Seadus \"Reisipraamlaeva \"Estonia\" hukkumisel teadmata kadunuks jäänud isikute surnuks tunnistamise kohta\""
    },
    {
      "@id": "estleg:REHTKJIST_Par_1_v24786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REHTKJIST_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1994. aasta 28. septembril hukkunud reisipraamlaeva \"Estonia\" pardal olnud ja teadmata kadunuks jäänud isikud tunnistatakse surnuks tsiviilseadustiku üldosa seaduses (RT I 1994, 53, 889) ja tsiviilkohtupidamise seadustikus (RT I 1993, 31/32, 538; 1994, 1, 5) sätestatud korras, arvestades käesolevas seaduses sätestatud erisusi.",
      "rdfs:label": {
        "@value": "REHTKJIST_Par_1 (redaktsioon 24786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24786",
      "estleg:sourceAct": "Seadus \"Reisipraamlaeva \"Estonia\" hukkumisel teadmata kadunuks jäänud isikute surnuks tunnistamise kohta\"",
      "estleg:provisionRef": "REHTKJIST § 1",
      "estleg:partOfAct": {
        "@id": "estleg:REHTKJIST_Map"
      }
    },
    {
      "@id": "estleg:REHTKJIST_Par_2_v24786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REHTKJIST_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hukkunud reisipraamlaeva \"Estonia\" pardal olnud ja teadmata kadunuks jäänud isiku võib kohus surnuks tunnistada enne tsiviilseadustiku üldosa seaduse paragrahvis 31 nimetatud tähtaega. (2) Kohus ei tunnista isikut surnuks, kui ühe kuu jooksul tsiviilseadustiku üldosa seaduse paragrahv 32 2. lõikes nimetatud teate avaldamisest saabuvad andmed, mis tõendavad, et isik on elus. (3) Käesoleva seaduse alusel esitatud hagid on vabastatud riigilõivust ja kohtukulude maksmisest riigituludesse.",
      "rdfs:label": {
        "@value": "REHTKJIST_Par_2 (redaktsioon 24786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24786",
      "estleg:sourceAct": "Seadus \"Reisipraamlaeva \"Estonia\" hukkumisel teadmata kadunuks jäänud isikute surnuks tunnistamise kohta\"",
      "estleg:provisionRef": "REHTKJIST § 2",
      "estleg:partOfAct": {
        "@id": "estleg:REHTKJIST_Map"
      }
    },
    {
      "@id": "estleg:REHTKJIST_Par_3_v24786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REHTKJIST_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Surnuks tunnistamise avaldus esitatakse Tallinna Linnakohtule. (2) Käesoleva seaduse paragrahvis 1 nimetatud isiku võib käesolevas seaduses sätestatud erisustega surnuks tunnistada, kui avaldus surnuks tunnistamise kohta on esitatud enne 1995. aasta 1. märtsi. (3) Kui surnuks tunnistamise avaldust ei ole käesolevas seaduses sätestatud korras esitatud enne 1995. aasta 1. märtsi, võib isiku surnuks tunnistada tsiviilseadustiku üldosa seaduses ja tsiviilkohtupidamise seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "REHTKJIST_Par_3 (redaktsioon 24786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24786",
      "estleg:sourceAct": "Seadus \"Reisipraamlaeva \"Estonia\" hukkumisel teadmata kadunuks jäänud isikute surnuks tunnistamise kohta\"",
      "estleg:provisionRef": "REHTKJIST § 3",
      "estleg:partOfAct": {
        "@id": "estleg:REHTKJIST_Map"
      }
    },
    {
      "@id": "estleg:REHTKJIST_Par_4_v24786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
