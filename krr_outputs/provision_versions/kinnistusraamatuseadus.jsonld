      },
      "estleg:versionText": "Kinnistusregistriosa pealkirjas näidatakse: kehtetu - kinnistusosakonna nimetus; kinnistu number. kehtetu - kehtetu -",
      "rdfs:label": {
        "@value": "KINNIS_Par_12 (redaktsioon 105122014036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014036",
