    },
    {
      "@id": "estleg:KINNIS_Par_77_3_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusraamatu töötlemisel tuleb: tarvitusele võtta abinõud informatsiooni kadumise vastu, tehes iga tööpäeva lõpus andmekogudest vajalikud koopiad ning tagades originaalandmete ja koopiate nõuetekohase säilitamise; kindlustada kannete tegemine, muutmine ja kustutamine ainult selleks pädevate isikute poolt ning välistada mittepädevate isikute juurdepääs andmetele; tagada elektroonilise kinnistusraamatu andmete tõrgeteta taasesitamise võimalused kuvaril ja väljatrükis; protokollida kõik pöördumised kinnistusraamatu poole.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_3 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_3",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_4_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kande taasesituse välise vormi määrab käesoleva seaduse 3. peatükk.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_4 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_4",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_5_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registriosa pealkiri ei pea asuma iseseisval leheküljel.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_5 (redaktsioon 22262)",
        "@language": "et"
