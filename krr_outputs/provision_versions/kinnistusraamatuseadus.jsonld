      }
    },
    {
      "@id": "estleg:KINNIS_Par_61_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusregistriosa kanne ei vasta kinnistamisotsusele ja kande ebaõigsus ilmneb enne, kui kinnistamisotsuse teinud isik sellele alla kirjutab, tehakse parandus uut kinnistamisotsust tegemata.",
      "rdfs:label": {
        "@value": "KINNIS_Par_61 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
