      "estleg:provisionRef": "KINNIS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_27_v12769835",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) –(4) Kehtetud – (5) Registrisse ei ole lubatud kanda märget, milles ei ole ära näidatud isikut, kelle kasuks märge tehakse. (6) Märke kandmise avaldus peab olema notariaalselt kinnitatud, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KINNIS_Par_27 (redaktsioon 12769835)",
        "@language": "et"
      },
