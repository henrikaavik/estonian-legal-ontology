        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/254248",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 7",
      "estleg:partOfAct": {
