        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub asjaõigusseaduse rakendamise seaduse jõustumisega.",
      "rdfs:label": {
        "@value": "KINNIS_Par_81 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
