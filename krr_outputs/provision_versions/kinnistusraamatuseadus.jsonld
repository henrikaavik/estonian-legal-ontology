      }
    },
    {
      "@id": "estleg:KINNIS_Par_76_v928203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusosakonnale on esitatud kinnistamisavaldus, mille kohta ei ole veel tehtud kandemäärust, peab kinnistusraamatu väljavõte sisaldama viidet kinnistamisavaldusele, mis on kantud kinnistuspäevikusse.",
      "rdfs:label": {
        "@value": "KINNIS_Par_76 (redaktsioon 928203)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928203",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_76_v13334064"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928203",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 76",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_76_v13334064",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusosakonnale on esitatud kinnistamisavaldus, mille kohta ei ole veel tehtud kandemäärust, peab kinnistusraamatu väljatrükk sisaldama viidet kinnistamisavaldusele, mis on kantud kinnistuspäevikusse.",
      "rdfs:label": {
        "@value": "KINNIS_Par_76 (redaktsioon 13334064)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334064",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13334064",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 76",
