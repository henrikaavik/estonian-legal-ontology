      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Kehtetu - (4) Kehtetu - (5) Registrisse ei ole lubatud kanda märget, milles ei ole ära näidatud isikut, kelle kasuks märge tehakse. (6) Märke kandmise avaldus peab olema notariaalselt kinnitatud, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KINNIS_Par_27 (redaktsioon 118122012013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118122012013",
