      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusraamatu vastutav töötleja on Justiits- ja Digiministeerium ja volitatud töötlejad on Tartu Maakohtu kinnistusosakond ning Registrite ja Infosüsteemide Keskus. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "KINNIS_Par_2 (redaktsioon 114032025029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032025029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032025029",
