      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusametil on pitsat, mille jälg (edaspidi pitser) koos kinnistamiseks pädevate isikute allkirjanäidistega saadetakse kõigile kinnistusametitele. [Paragrahvi 4 sõnastus alates 1.07.2003]",
      "rdfs:label": {
        "@value": "KINNIS_Par_4 (redaktsioon 254248)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254248",
