      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusosakonnale on esitatud kinnistamisavaldus, mille kohta ei ole veel tehtud kinnistamisotsust, peab kinnistusraamatu väljavõte sisaldama viidet kinnistamisavaldusele, mis on kantud kinnistuspäevikusse.",
      "rdfs:label": {
        "@value": "KINNIS_Par_76 (redaktsioon 722030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "722030",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_76_v928203"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/722030",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 76",
      "estleg:partOfAct": {
