    {
      "@id": "estleg:KINNIS_Par_48_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistamisotsuses peab sisalduma: otsuse tegemise aeg ja koht; kande tekst, samuti viide kinnistusregistriosale, selle jaole ja lahtrile, kuhu kanne tehakse; otsuse põhistus ja õiguslik alus, kui kinnistamisavaldust ei rahuldata; otsuse peale edasikaebamise kord ja tähtaeg; otsuse teinud isiku nimi ja ametikoht.",
      "rdfs:label": {
        "@value": "KINNIS_Par_48 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
