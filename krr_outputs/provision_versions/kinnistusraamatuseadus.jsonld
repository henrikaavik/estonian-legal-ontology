      }
    },
    {
      "@id": "estleg:KINNIS_Par_7_v722030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistu asub mitmes kinnistuspiirkonnas, peetakse selle kohta kinnistusraamatut ainult ühes kinnistusosakonnas, mille suhtes teeb valiku omanik kinnistusregistriosa avamisel.",
      "rdfs:label": {
        "@value": "KINNIS_Par_7 (redaktsioon 722030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "722030",
      "estleg:supersededByVersion": {
