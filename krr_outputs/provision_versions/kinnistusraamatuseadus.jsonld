      "estleg:versionValidFrom": {
        "@value": "2007-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusregistriosa teise jakku «Omanik» kantakse: omanik; kui kinnistu on ühises omandis – omanikud, see, kas kinnistu on ühis- või kaasomandis, ning kaasomandi korral kaasomanike osade suurus.",
      "rdfs:label": {
        "@value": "KINNIS_Par_14 (redaktsioon 12895670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895670",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12895670",
