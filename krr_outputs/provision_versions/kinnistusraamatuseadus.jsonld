        "@value": "2004-03-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/254248",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_18_v722030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
