        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_76_1_v992365",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_76_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-02-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isiku nõudel annab kinnistusosakond tõendi, et kannet ei ole muudetud või et teatud kannet või kandeid kinnistusraamatus ei ole.",
      "rdfs:label": {
        "@value": "KINNIS_Par_76_1 (redaktsioon 992365)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "992365",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_76_1_v13334987"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/992365",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 76_1",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_76_1_v13334987",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_76_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõudel annab kinnistusosakond tõendi, et kannet ei ole muudetud või et teatud kannet või kandeid kinnistusraamatus ei ole. (2) Tehniliste võimaluste olemasolu korral väljastatakse käesoleva paragrahvi 1. lõikes nimetatud tõend automatiseeritult. (3) Käesoleva paragrahvi 1. lõikes nimetatud tõendi automatiseeritult väljastamise korra kehtestab justiitsminister määrusega.",
      "rdfs:label": {
        "@value": "KINNIS_Par_76_1 (redaktsioon 13334987)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334987",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_76_1_v118122012013"
      },
      "estleg:versionValidTo": {
