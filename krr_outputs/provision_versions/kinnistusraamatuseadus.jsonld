        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusregistriosa kanne ei vasta kinnistamisotsusele ja kande ebaõigsus ilmneb pärast seda, kui kinnistamisotsuse teinud isik sellele alla kirjutab, kannab kinnistusosakond kinnistusregistrisse ametiülesande korras vastuväite ebaõigesti sissekantud õiguse parandamise tagamiseks ja teatab parandusettepanekust puudutatud isikutele, kellel on tema poolt määratud aja jooksul õigus esitada vastuväiteid. Tähtaja möödumisel otsustab kinnistamiseks pädev isik kande parandamise.",
      "rdfs:label": {
        "@value": "KINNIS_Par_62 (redaktsioon 722030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "722030",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_62_v928203"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/722030",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 62",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_62_v928203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_62"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusregistriosa kanne ei vasta kandemäärusele ja kande ebaõigsus ilmneb pärast seda, kui kandemääruse teinud isik sellele alla kirjutab, kannab kinnistusosakond kinnistusregistrisse ametiülesande korras vastuväite ebaõigesti sissekantud õiguse parandamise tagamiseks ja teatab parandusettepanekust puudutatud isikutele, kellel on tema poolt määratud aja jooksul õigus esitada vastuväiteid. Tähtaja möödumisel otsustab kinnistamiseks pädev isik kande parandamise.",
      "rdfs:label": {
        "@value": "KINNIS_Par_62 (redaktsioon 928203)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928203",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_62_v118122012013"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928203",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 62",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
