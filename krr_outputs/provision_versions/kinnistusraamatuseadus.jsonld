      }
    },
    {
      "@id": "estleg:KINNIS_Par_50_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast kande tegemist antakse või saadetakse kinnistamisotsuse ärakiri kohe avalduse esitanud isikutele, kinnistu omanikule, kõigile kinnistusregistrist nähtuvatele isikutele, kelle kasuks kanne tehti või kelle kinnistusregistrisse kantud õigust kanne kahjustab, ja teistele seaduses sätestatud isikutele ning ametiasutustele. Kinnistamisotsuse ärakirjale märgitakse kinnistusregistrisse vastava kande tegemise kuupäev.",
      "rdfs:label": {
        "@value": "KINNIS_Par_50 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_50_v928203"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_50_v928203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast kande tegemist edastatakse kandemääruse ärakiri justiitsministri määruses ettenähtud viisil viivitamata kinnistu omanikule, kõigile kinnistusregistrist nähtuvatele isikutele, kelle kasuks kanne tehti või kelle kinnistusregistrisse kantud õigust kanne kahjustab, ja teistele seaduses sätestatud isikutele ning ametiasutustele. Avalduse rahuldamata jätmise puhul toimetatakse määrus avalduse esitajale kätte tsiviilkohtumenetluse seadustikus sätestatud korras. Määruse edastamine või kättetoimetamine märgitakse kinnistuspäevikusse.",
      "rdfs:label": {
        "@value": "KINNIS_Par_50 (redaktsioon 928203)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928203",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_50_v12895670"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928203",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_50_v12895670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärast kande tegemist teatatakse sellest käesoleva seaduse § 1 lõike 2 alusel kehtestatud määruses ettenähtud korras viivitamata kinnistu omanikule, kõigile kinnistusregistrist nähtuvatele isikutele, kelle kasuks kanne tehti või kelle kinnistusregistrisse kantud õigust kanne kahjustab, ja teistele seaduses sätestatud isikutele ning ametiasutustele. (2) Kandemäärus, millega kandeavaldus jäetakse rahuldamata või millega määratakse tähtaeg puuduste kõrvaldamiseks, toimetatakse avalduse esitajale ja avaldajat kinnistamisasjas esindanud notarile kätte tsiviilkohtumenetluse seadustikus sätestatud korras. (3) Määruse edastamine või kättetoimetamine märgitakse kinnistuspäevikusse.",
      "rdfs:label": {
        "@value": "KINNIS_Par_50 (redaktsioon 12895670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895670",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12895670",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_51_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui kinnistamiseks pädev isik jätab kinnistamisavalduse rahuldamata, tagastatakse avaldajale allkirja vastu avaldus ning koos sellega esitatud dokumendid. (2) Avalduse täielikul või osalisel rahuldamata jätmisel tagastatakse tasutud lõiv kinnistusameti õiendi alusel. Tagastatavast lõivust arvatakse maha kinnistamismenetluse tegelikud kulud. (3) Tagastatud dokumentide ärakirjad lisatakse kinnistustoimikule.",
      "rdfs:label": {
        "@value": "KINNIS_Par_51 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_51_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
