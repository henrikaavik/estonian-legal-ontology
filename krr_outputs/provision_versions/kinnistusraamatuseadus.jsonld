      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KINNIS_Par_61 (redaktsioon 118122012013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118122012013",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 61",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_62_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_62"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusregistriosa kanne ei vasta kinnistamisotsusele ja kande ebaõigsus ilmneb pärast seda, kui kinnistamisotsuse teinud isik sellele alla kirjutab, kannab kinnistusamet kinnistusregistrisse ametiülesande korras vastuväite ebaõigesti sissekantud õiguse parandamise tagamiseks ja teatab parandusettepanekust puudutatud isikutele, kellel on tema poolt määratud aja jooksul õigus esitada vastuväiteid. Tähtaja möödumisel otsustab kinnistamiseks pädev isik kande parandamise.",
      "rdfs:label": {
        "@value": "KINNIS_Par_62 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_62_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 62",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
