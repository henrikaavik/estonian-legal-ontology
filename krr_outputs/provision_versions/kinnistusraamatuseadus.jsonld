      }
    },
    {
      "@id": "estleg:KINNIS_Par_76_1_v121062014032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_76_1"
      },
      "estleg:versionValidFrom": {
