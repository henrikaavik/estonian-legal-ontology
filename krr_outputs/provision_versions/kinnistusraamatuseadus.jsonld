        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistu jagamisel ja ühendamisel tuleb esitada käesoleva seaduse §-des 35 ja 36 nimetatud dokumendid.",
      "rdfs:label": {
        "@value": "KINNIS_Par_60 (redaktsioon 22262)",
