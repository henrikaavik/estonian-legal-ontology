      }
    },
    {
      "@id": "estleg:KINNIS_Par_23_1_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_23_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kanded tehakse asjaõiguste ja märgete kohta.",
      "rdfs:label": {
        "@value": "KINNIS_Par_23_1 (redaktsioon 254248)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254248",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/254248",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 23_1",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_24_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kande tekst sisaldab: kinnistatud asjaõiguse sisu, selle isiku nime, kelle kasuks kanne tehakse, ning füüsilise isiku puhul isikukoodi, selle puudumisel sünniaega, ja juriidilise isiku puhul asukohta ja registrikoodi või registreerimistunnistuse numbrit selle seadusega sätestatud tähtaja lõpuni; viidet algdokumendile ja dokumendile, mille alusel soovitakse asjaõiguse sisu täpsemalt tõendada; viidet järjekohale, kui samal päeval tehakse samasse registriossa mitu kannet (§ 49).",
      "rdfs:label": {
        "@value": "KINNIS_Par_24 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_24_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_24_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kande tekst sisaldab: [Alapunkti 1 sõnastus kuni 30.06.2003] kinnistatud asjaõiguse sisu, selle isiku nime, kelle kasuks kanne tehakse, ning füüsilise isiku puhul isikukoodi, selle puudumisel sünniaega, ja juriidilise isiku puhul asukohta ja registrikoodi või registreerimistunnistuse numbrit selle seadusega sätestatud tähtaja lõpuni; [Alapunkti 1 sõnastus alates 1.07.2003] kinnistatud asjaõiguse või märke sisu, selle isiku nime, kelle kasuks kanne tehakse, füüsilise isiku puhul isikukoodi (selle puudumisel sünniaega) ning juriidilise isiku puhul asukohta ja registrikoodi selle olemasolu korral; viidet algdokumendile ja dokumendile, mille alusel soovitakse asjaõiguse sisu täpsemalt tõendada; viidet järjekohale, kui samal päeval tehakse samasse registriossa mitu kannet (§ 49).",
      "rdfs:label": {
        "@value": "KINNIS_Par_24 (redaktsioon 254248)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254248",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_24_v722030"
      },
      "estleg:versionValidTo": {
        "@value": "2004-03-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/254248",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_24_v722030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kande tekst sisaldab: kinnistatud asjaõiguse või märke sisu, selle isiku nime, kelle kasuks kanne tehakse, füüsilise isiku puhul isikukoodi (selle puudumisel sünniaega) ning juriidilise isiku puhul asukohta ja registrikoodi selle olemasolu korral; viidet algdokumendile ja dokumendile, mille alusel soovitakse asjaõiguse sisu täpsemalt tõendada; viidet järjekohale, kui samal päeval tehakse samasse registriossa mitu kannet (§ 49).",
      "rdfs:label": {
        "@value": "KINNIS_Par_24 (redaktsioon 722030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "722030",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_24_v12895670"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/722030",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_24_v12895670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kande tekst sisaldab: kinnistatud asjaõiguse või märke sisu, sealhulgas isikut, kelle kasuks kanne tehakse; viidet algdokumendile ja dokumendile, mille alusel soovitakse asjaõiguse sisu täpsemalt tõendada; viidet järjekohale, kui samal päeval tehakse samasse registriossa mitu kannet (§ 49).",
      "rdfs:label": {
        "@value": "KINNIS_Par_24 (redaktsioon 12895670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895670",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12895670",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_25_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kanded kinnistusregistriosas nummerdatakse iga registrijao piires nende tegemise järjekorras. Muutmise ja kustutamise kanded saavad selle kande numbri, mille kohta need käivad.",
      "rdfs:label": {
        "@value": "KINNIS_Par_25 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 25",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_26_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kanded tuleb teha selgelt ja lühenditeta, välja arvatud üldkasutatavad lühendid. (2) Mahatõmbamised ja juurdekirjutused kande tekstis, välja arvatud õiguslikku tähendust mitteomavate kirjavigade parandamine, samuti teksti kustutamine või muul viisil loetamatuks muutmine ei ole lubatud.",
      "rdfs:label": {
        "@value": "KINNIS_Par_26 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_27_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Märge kantakse kinnistusregistrisse kinnisasja omaniku või puudutatud asjaõiguse omaja nõusolekul, kui seaduses ei ole sätestatud teisiti. (2) Eelmärge ja vastuväide kantakse kinnistusregistrisse: selle isiku avalduse alusel või nõusolekul, kelle omandit või piiratud asjaõigust see puudutab, või hagi tagamise määruse alusel. (3) Keelumärge kantakse kinnistusregistrisse hagi tagamise määruse või muul seaduses sätestatud alusel. (4) Märkus kantakse kinnistusregistrisse seaduses sätestatud juhtudel. (5) Registrisse ei ole lubatud kanda märget, milles ei ole ära näidatud isikut, kelle kasuks märge tehakse. (6) Märke kandmise avaldus peab olema notariaalselt kinnitatud, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KINNIS_Par_27 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_27_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_27_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõige 1 kehtetu alates 1.07.2003] (1) Märge kantakse kinnistusregistrisse kinnisasja omaniku või puudutatud asjaõiguse omaja nõusolekul, kui seaduses ei ole sätestatud teisiti. [Lõige 2 kehtetu alates 1.07.2003] (2) Eelmärge ja vastuväide kantakse kinnistusregistrisse: selle isiku avalduse alusel või nõusolekul, kelle omandit või piiratud asjaõigust see puudutab, või hagi tagamise määruse alusel. [Lõige 3 kehtetu alates 1.07.2003] (3) Keelumärge kantakse kinnistusregistrisse hagi tagamise määruse või muul seaduses sätestatud alusel. [Lõige 4 kehtetu alates 1.07.2003] (4) Märkus kantakse kinnistusregistrisse seaduses sätestatud juhtudel. (5) Registrisse ei ole lubatud kanda märget, milles ei ole ära näidatud isikut, kelle kasuks märge tehakse. (6) Märke kandmise avaldus peab olema notariaalselt kinnitatud, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KINNIS_Par_27 (redaktsioon 254248)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254248",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_27_v722030"
      },
      "estleg:versionValidTo": {
        "@value": "2004-03-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/254248",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_27_v722030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_27"
      },
      "estleg:versionValidFrom": {
