      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/722030",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_4_v928203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusosakonnal on riigivapiga pitsat. (2) Kohtuteenistujal, kes teeb kinnistusosakonnas tõestamistoiminguid, võib olla oma nimega riigivapiga pitsat.",
      "rdfs:label": {
        "@value": "KINNIS_Par_4 (redaktsioon 928203)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928203",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928203",
