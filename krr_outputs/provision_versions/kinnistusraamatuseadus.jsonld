    {
      "@id": "estleg:KINNIS_Par_77_15_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektroonilise kinnistusraamatu korral asendab ärakirja väljatrükk ning kinnitatud ärakirja kinnitatud väljatrükk. Kinnitamata väljatrükile alla ei kirjutata. (2) Väljatrükk elektroonilisest kinnistusraamatust tuleb varustada pealkirjaga «Väljatrükk» ja väljatrüki tegemise kuupäevaga. (3) Väljatrüki võib avalduse esitajale edastada ka elektroonilisel teel. (4) Ametlikus väljatrükis võib pitseri asemel vormile olla eelnevalt trükitud või trükitakse väljatrüki valmistamise käigus kinnistusameti pitsati jäljend.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_15 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_77_15_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_15",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_15_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektroonilise kinnistusraamatu korral asendab ärakirja väljatrükk ning kinnitatud ärakirja kinnitatud väljatrükk. Kinnitamata väljatrükile alla ei kirjutata. (2) Väljatrükk elektroonilisest kinnistusraamatust tuleb varustada pealkirjaga «Väljatrükk» ja väljatrüki tegemise kuupäevaga. (3) Väljatrüki võib avalduse esitajale edastada ka elektroonilisel teel. [Lõike 4 sõnastus kuni 30.06.2003] (4) Ametlikus väljatrükis võib pitseri asemel vormile olla eelnevalt trükitud või trükitakse väljatrüki valmistamise käigus kinnistusameti pitsati jäljend. [Lõike 4 sõnastus alates 1.07.2003] (4) Ametlikus väljatrükis võib pitseri asemel vormile olla eelnevalt trükitud või trükitakse väljatrüki valmistamise käigus kinnistusosakonna pitsati jäljend. [Paragrahvi 7716 sõnastus kuni 30.06.2003]",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_15 (redaktsioon 254248)",
        "@language": "et"
      },
