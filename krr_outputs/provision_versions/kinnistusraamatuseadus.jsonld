      }
    },
    {
      "@id": "estleg:KINNIS_Par_8_1_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_8_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne registriosa avamist kinnistusraamatusse kandmata kinnisasja kohta avaldab kinnistusamet selle kohta teate ametlikus väljaandes Ametlikud Teadaanded ning vajadusel muul puudutatud isikutele kättesaadaval viisil. (2) Teates märgitakse: sissekantava kinnisasja asukoht ja pindala; omanikuna sissekantava isiku nimi; ettepanek isikutele teatada kinnistusametile ühe kuu jooksul, arvates teate avaldamisest ametlikus väljaandes Ametlikud Teadaanded, oma õigustest ja vastuväidetest; kinnistusameti nimetus ja asukoht. (3) Registriosa avamise ja tehtava kande suhtes esitatud kaebus ei takista registriosa avamist. Kaebuse esitanud isik võib nõuda märke tegemist avatavasse kinnistusregistri ossa.",
      "rdfs:label": {
        "@value": "KINNIS_Par_8_1 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_8_1_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 8_1",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_8_1_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_8_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne registriosa avamist kinnistusraamatusse kandmata kinnisasja kohta avaldab kinnistusamet selle kohta teate ametlikus väljaandes Ametlikud Teadaanded ning vajadusel muul puudutatud isikutele kättesaadaval viisil. (2) Teates märgitakse: sissekantava kinnisasja asukoht ja pindala; omanikuna sissekantava isiku nimi; ettepanek isikutele teatada kinnistusametile ühe kuu jooksul, arvates teate avaldamisest ametlikus väljaandes Ametlikud Teadaanded, oma õigustest ja vastuväidetest; kinnistusameti nimetus ja asukoht. (3) Registriosa avamise ja tehtava kande suhtes esitatud kaebus ei takista registriosa avamist. Kaebuse esitanud isik võib nõuda märke tegemist avatavasse kinnistusregistri ossa. [Paragrahvi 81 sõnastus alates 1.07.2003]",
      "rdfs:label": {
        "@value": "KINNIS_Par_8_1 (redaktsioon 254248)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254248",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_8_1_v722030"
      },
      "estleg:versionValidTo": {
        "@value": "2004-03-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/254248",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 8_1",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_8_1_v722030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_8_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne registriosa avamist kinnistusraamatusse kandmata kinnisasja kohta avaldab kinnistusosakond selle kohta teate ametlikus väljaandes Ametlikud Teadaanded ning vajadusel muul puudutatud isikutele kättesaadaval viisil. (2) Teates märgitakse: sissekantava kinnisasja asukoht ja pindala; omanikuna sissekantava isiku nimi; ettepanek isikutele teatada kinnistusosakonnale ühe kuu jooksul, arvates teate avaldamisest ametlikus väljaandes Ametlikud Teadaanded, teates esitatud andmetes esinenud ebatäpsustest või vigadest; kinnistusosakonna nimetus ja asukoht. (3) Registriosa avamise ja tehtava kande suhtes esitatud kaebus ei takista registriosa avamist. Kaebuse esitanud isik võib nõuda märke tegemiseks avatavasse kinnistusregistri ossa nõusolekut isikult, kes kantakse omanikuna kinnistusraamatusse.",
      "rdfs:label": {
        "@value": "KINNIS_Par_8_1 (redaktsioon 722030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "722030",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/722030",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 8_1",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_9_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusraamatusse kantakse kinnisasjaga seotud asjaõigused. (2) Asjaõiguse kanne tehakse koormatava kinnisasja kinnistusregistriossa. (3) Kinnistu igakordsele omanikule kuuluvate piiratud asjaõiguste kohta tehakse kinnistu omaniku avalduse alusel märge ka tema kinnistu kinnistusregistriossa. Avaldus võib olla lihtkirjalik. (4) Kui käesoleva paragrahvi 3. lõikes nimetatud asjaõigus muudetakse või lõpetatakse, on kinnistusamet kohustatud märke parandama.",
      "rdfs:label": {
        "@value": "KINNIS_Par_9 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_9_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_9_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusraamatusse kantakse kinnisasjaga seotud asjaõigused. (2) Asjaõiguse kanne tehakse koormatava kinnisasja kinnistusregistriossa. (3) Kinnistu igakordsele omanikule kuuluvate piiratud asjaõiguste kohta tehakse kinnistu omaniku avalduse alusel märge ka tema kinnistu kinnistusregistriossa. Avaldus võib olla lihtkirjalik. [Lõike 4 sõnastus kuni 30.06.2003] (4) Kui käesoleva paragrahvi 3. lõikes nimetatud asjaõigus muudetakse või lõpetatakse, on kinnistusamet kohustatud märke parandama. [Lõike 4 sõnastus alates 1.07.2003] (4) Kui käesoleva paragrahvi 3. lõikes nimetatud asjaõigus muudetakse või lõpetatakse, on kinnistusosakond kohustatud märke parandama.",
      "rdfs:label": {
        "@value": "KINNIS_Par_9 (redaktsioon 254248)",
        "@language": "et"
