      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KINNIS_Par_3 (redaktsioon 13334987)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334987",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13334987",
