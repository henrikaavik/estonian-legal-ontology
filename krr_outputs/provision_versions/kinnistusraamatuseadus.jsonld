      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/722030",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 40",
      "estleg:partOfAct": {
