    },
    {
      "@id": "estleg:KINNIS_Par_77_17_v722030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kannete tegemine elektroonilises kinnistusraamatus pole ajutiselt võimalik, siis võib kandeid teha kinnistusosakonna juhataja loal paberil olevasse asenduskinnistusraamatusse. Need võetakse üle elektroonilisse kinnistusraamatusse niipea, kui see on jälle võimalik. Justiitsministril on õigus reguleerida määrusega menetluse üksikasju.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_17 (redaktsioon 722030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "722030",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_77_17_v13334987"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/722030",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_17",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_17_v13334987",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui kannete tegemine elektroonilises kinnistusraamatus või kinnistamisavalduste elektrooniline esitamine otse elektroonilise kinnistusraamatu infosüsteemi ei ole ajutiselt võimalik infosüsteemi tehnilise rikke tõttu, võib teha kandeid paberil olevasse asenduskinnistusraamatusse ja kinnistamisavaldusi esitada paberkandjal. Tehtud kanded ja esitatud dokumendid võetakse elektroonilisse kinnistusraamatusse üle esimesel võimalusel. (2) asenduskinnistusraamatu pidamise ja kinnistamisavalduste paberkandjal esitamise tingimused ja korra.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_17 (redaktsioon 13334987)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334987",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_77_17_v121062014032"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13334987",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_17",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_17_v121062014032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui kannete tegemine elektroonilises kinnistusraamatus või kinnistamisavalduste elektrooniline esitamine otse elektroonilise kinnistusraamatu infosüsteemi ei ole ajutiselt võimalik infosüsteemi tehnilise rikke tõttu, võib teha kandeid paberil olevasse asenduskinnistusraamatusse ja kinnistamisavaldusi esitada paberkandjal. Tehtud kanded ja esitatud dokumendid võetakse elektroonilisse kinnistusraamatusse üle esimesel võimalusel. (2) kehtestab määrusega asenduskinnistusraamatu pidamise ja kinnistamisavalduste paberkandjal esitamise tingimused ja korra.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_17 (redaktsioon 121062014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014032",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_17",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_18_v22262",
