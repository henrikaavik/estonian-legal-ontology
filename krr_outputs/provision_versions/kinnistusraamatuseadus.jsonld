      }
    },
    {
      "@id": "estleg:KINNIS_Par_32_2_v13334987",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_32_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistussekretär on pädev läbi vaatama kinnistamisavaldusi ja tegema kandemääruse eelnõusid. (2) Kehtetu - (3) Kinnistusosakonna juhataja võib lubada kinnistussekretäril teha kõiki kohtunikuabi pädevuses olevaid töid peale kandemääruse tegemise.",
      "rdfs:label": {
        "@value": "KINNIS_Par_32_2 (redaktsioon 13334987)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334987",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13334987",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 32_2",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_33_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistamine on kinnistamiseks pädeva isiku otsuse alusel kinnistusraamatusse kande tegemine, sealhulgas kande muutmine või kustutamine. (2) Kanne tehakse pärast lõivu tasumist, kui seaduses ei ole sätestatud teisiti. Kui ei ole kokku lepitud teisiti, tasub lõivu isik, kelle kasuks kinnistamine toimub.",
      "rdfs:label": {
        "@value": "KINNIS_Par_33 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_33_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 33",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_33_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistamine on kinnistamiseks pädeva isiku otsuse alusel kinnistusraamatusse kande tegemine, sealhulgas kande muutmine või kustutamine. (2) Kanne tehakse pärast lõivu tasumist, kui seaduses ei ole sätestatud teisiti. Kui ei ole kokku lepitud teisiti, tasub lõivu isik, kelle kasuks kinnistamine toimub. [Paragrahvi 33 sõnastus alates 1.07.2003]",
      "rdfs:label": {
        "@value": "KINNIS_Par_33 (redaktsioon 254248)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254248",
      "estleg:supersededByVersion": {
