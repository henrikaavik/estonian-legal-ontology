      }
    },
    {
      "@id": "estleg:KINNIS_Par_39_v928203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusosakonda saabunud kinnistamisavaldus registreeritakse kohe kinnistuspäevikus ja nummerdatakse vastavalt avalduse saabumise ajale. (2) Samal päeval posti teel või elektrooniliselt saabunud kinnistamisavaldused loetakse üheaegselt saabunuks ja registreeritakse päevikus sellel päeval saabunud avaldustest viimastena. Vastuvõtmise kellaajaks märgitakse kinnistamisavalduste vastuvõtu lõpetamise kellaaeg.",
      "rdfs:label": {
        "@value": "KINNIS_Par_39 (redaktsioon 928203)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928203",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_39_v12769835"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928203",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_39_v12769835",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusosakonda saabunud kinnistamisavaldus registreeritakse kohe kinnistuspäevikus ja nummerdatakse vastavalt avalduse saabumise ajale. (2) Samal päeval posti või e-posti teel saabunud kinnistamisavaldused loetakse üheaegselt saabunuks ja registreeritakse päevikus sellel päeval saabunud avaldustest viimastena. Vastuvõtmise kellaajaks märgitakse kinnistamisavalduste vastuvõtu lõpetamise kellaaeg. (3) Kui digitaalallkirjastatud avalduse saab esitada otse elektroonilise kinnistusraamatu infosüsteemi, registreeritakse avaldus ning tema laekumise aeg kinnistuspäevikus automatiseeritult ning nummerdatakse lõike 1 alusel. (4) Kui digitaalallkirjastatud avalduse saab esitada otse elektroonilise kinnistusraamatu infosüsteemi, ei või avaldust esitada e-posti teel. Vastasel juhul tagastab registripidaja e-postiga esitatud avalduse seda registripäevikusse kandmata, märkides ära tagastamise põhjuse.",
      "rdfs:label": {
        "@value": "KINNIS_Par_39 (redaktsioon 12769835)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12769835",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_39_v12895670"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12769835",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_39_v12895670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusosakonda saabunud kinnistamisavaldus registreeritakse kohe kinnistuspäevikus ja nummerdatakse vastavalt avalduse saabumise ajale. (2) Samal päeval posti või e-posti teel saabunud kinnistamisavaldused loetakse üheaegselt saabunuks ja registreeritakse päevikus sellel päeval saabunud avaldustest viimastena. Vastuvõtmise kellaajaks märgitakse kinnistamisavalduste vastuvõtu lõpetamise kellaaeg. (3) Kui digitaalallkirjastatud avalduse saab esitada otse elektroonilise kinnistusraamatu infosüsteemi, registreeritakse avaldus ning tema laekumise aeg kinnistuspäevikus automatiseeritult ning nummerdatakse lõike 1 alusel. (4) Kui digitaalallkirjastatud avalduse saab esitada otse elektroonilise kinnistusraamatu infosüsteemi, ei või avaldust esitada e-posti teel. Sellisel juhul tagastab kinnistusosakond e-postiga esitatud avalduse seda kinnistuspäevikusse kandmata, märkides ära tagastamise põhjuse.",
      "rdfs:label": {
        "@value": "KINNIS_Par_39 (redaktsioon 12895670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895670",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12895670",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_4_v22262",
