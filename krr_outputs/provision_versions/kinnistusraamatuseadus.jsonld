      }
    },
    {
      "@id": "estleg:KINNIS_Par_76_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusametile on esitatud kinnistamisavaldus, mille kohta ei ole veel tehtud kinnistamisotsust, peab kinnistusraamatu väljavõte sisaldama viidet kinnistamisavaldusele, mis on kantud kinnistuspäevikusse.",
      "rdfs:label": {
        "@value": "KINNIS_Par_76 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
