      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KINNIS_Par_79_9 (redaktsioon 109052017009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052017009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109052017009",
