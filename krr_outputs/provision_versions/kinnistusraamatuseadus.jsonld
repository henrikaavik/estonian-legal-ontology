      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/722030",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 79_2",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_79_2_v928203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_79_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrooniline kinnistusraamat astub paberkinnistusraamatu asemele, kui: kinnistusosakonna kõigi registriosade kanded on andmekandjale salvestatud; on tagatud salvestatud andmete säilivus ja muutumatul kujul taasesitamise võimalus; kinnistusosakond on ette valmistatud elektroonilise kinnistusraamatu pidamiseks. (2) Elektroonilise kinnistusraamatu avamise otsustab justiitsminister. (2¹) Kui käesoleva paragrahvi lõike 1 punktides 2 ja 3 sätestatud eeldused on täidetud, võib justiitsminister erinevalt lõike 1 punktis 1 sätestatust erandlikult otsustada elektroonilise kinnistusraamatu avamise kinnistusraamatu registriosade kaupa.",
      "rdfs:label": {
        "@value": "KINNIS_Par_79_2 (redaktsioon 928203)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928203",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_79_2_v13334064"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928203",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 79_2",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_79_2_v13334064",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_79_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrooniline kinnistusraamat asendab paberkinnistusraamatut, kui: kõigi registriosade kanded on andmekandjale salvestatud; kõik toimikus sisalduvad dokumendid on selleks ettenähtud andmekandjale salvestatud; on tagatud salvestatud andmete ning dokumentide säilivus ja nende muutumatul kujul taasesitamise võimalus; kinnistusosakond on ette valmistatud elektroonilise kinnistusraamatu ja digitaalse arhiivi pidamiseks. (2) Elektroonilisele kinnistustoimikule ja digitaalsele arhiivile minnakse üle toimikute kaupa. (4) Elektroonilisele kinnistustoimikule ja digitaalsele arhiivile ülemineku ning elektroonilise kinnistustoimiku pidamiseks mittevajalike dokumentide pabertoimikust eraldamise korra, samuti paberarhiivi säilitamise tähtajad",
      "rdfs:label": {
        "@value": "KINNIS_Par_79_2 (redaktsioon 13334064)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334064",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_79_2_v13334987"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13334064",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 79_2",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_79_2_v13334987",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_79_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrooniline kinnistusraamat asendab paberkinnistusraamatut, kui: kõigi registriosade kanded on andmekandjale salvestatud; kõik toimikus sisalduvad dokumendid on selleks ettenähtud andmekandjale salvestatud; on tagatud salvestatud andmete ning dokumentide säilivus ja nende muutumatul kujul taasesitamise võimalus; kinnistusosakond on ette valmistatud elektroonilise kinnistusraamatu ja digitaalse arhiivi pidamiseks. (2) Elektroonilisele kinnistustoimikule ja digitaalsele arhiivile minnakse üle toimikute kaupa. (3) Pärast elektroonilisele kinnistustoimikule ja digitaalsele arhiivile üleminekut ei võimaldata tutvuda pabertoimikuga. (4) Elektroonilisele kinnistustoimikule ja digitaalsele arhiivile ülemineku ning elektroonilise kinnistustoimiku pidamiseks mittevajalike dokumentide pabertoimikust eraldamise korra, samuti paberarhiivi säilitamise tähtajad",
      "rdfs:label": {
