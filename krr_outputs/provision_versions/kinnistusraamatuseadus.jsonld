        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_7_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistu asub mitmes kinnistuspiirkonnas, peetakse selle kohta kinnistusraamatut ainult ühes kinnistusametis, mille suhtes teeb valiku omanik kinnistusregistriosa avamisel. [Paragrahvi 7 sõnastus alates 1.07.2003]",
      "rdfs:label": {
        "@value": "KINNIS_Par_7 (redaktsioon 254248)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254248",
