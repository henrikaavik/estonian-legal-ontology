        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_10_v928203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jaatava kandemääruse korral saadetakse puudutatud ja teistele seaduses sätestatud isikutele ning asutustele §-s 50 nimetatud kandemääruse ärakirja asemel registrikande väljatrükk.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_10 (redaktsioon 928203)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928203",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928203",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_10",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_11_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektroonilise kinnistusraamatu kande muutmine toimub senise kande kustutamise ja uue kande tegemise teel. Senist kannet asendav uus kanne omandab senise kande järjekoha. (2) Kande muutmisel ja kustutamisel peab kustutatud osa olema võimalik kestvalt taasesitada. (3) Kinnistusraamatuga tutvumisel ja väljatrükil esitatakse kustutatud kanded vaid siis, kui seda eraldi taotletakse. (4) Kustutatud kannete taasesitamisel peavad need kuvaril ja väljatrükil olema alla joonitud.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_11 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_77_11_v105122014036"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-02",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_11",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_11_v105122014036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektroonilise kinnistusraamatu kande muutmine toimub senise kande kustutamise ja uue kande tegemise teel. Senist kannet asendav uus kanne omandab senise kande järjekoha. (2) Kande muutmisel ja kustutamisel peab kustutatud osa olema võimalik kestvalt taasesitada. (3) Kinnistusraamatuga tutvumisel ja väljatrükil esitatakse kustutatud kanded vaid siis, kui seda eraldi taotletakse. (4) Kustutatud kannete taasesitamisel peavad need kuvaril ja väljatrükil olema eristatavad kehtivatest kannetest.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_11 (redaktsioon 105122014036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014036",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105122014036",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_11",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_12_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistustoimikut peetakse ka pärast elektroonilise kinnistusraamatu sisseseadmist vastavalt käesoleva seaduse §-le 20. (2) Kinnistustoimikus säilitatakse kõik eitavad kinnistamisotsused ja määrused. Jaatav kinnistamisotsus säilitatakse kinnistamistoimikus vaid siis, kui see on eelnevalt paberil koostatud. (3) Elektroonilise kinnistusraamatu korral ei hoita kinnistustoimikus registriosa ärakirja. (4) Justiitsministril on õigus kehtestada kord kinnistusraamatu edasipidamiseks mittevajalike dokumentide kinnistustoimikust eraldamiseks.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_12 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_77_12_v928203"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_12",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_12_v928203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
