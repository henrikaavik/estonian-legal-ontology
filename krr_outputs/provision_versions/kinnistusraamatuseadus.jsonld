        "@id": "estleg:KINNIS_Par_61_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 61",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_61_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusregistriosa kanne ei vasta kinnistamisotsusele ja kande ebaõigsus ilmneb enne, kui kinnistamisotsuse teinud isik sellele alla kirjutab, tehakse parandus uut kinnistamisotsust tegemata. [Paragrahvi 62 sõnastus kuni 30.06.2003]",
