      }
    },
    {
      "@id": "estleg:KINNIS_Par_4_v722030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusosakonnal on pitsat, mille jälg (edaspidi pitser) koos kinnistamiseks pädevate isikute allkirjanäidistega saadetakse kõigile kinnistusosakondadele.",
      "rdfs:label": {
        "@value": "KINNIS_Par_4 (redaktsioon 722030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "722030",
