    {
      "@id": "estleg:KINNIS_Par_28_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Märge kantakse: kinnistusregistriosa kolmandasse jakku, kui märge tagab omandi ülekandmise nõuet; lõpliku kande jaoks ettenähtud lahtrisse, kui märge tagab nõuet mingi muu õiguse seadmiseks kinnistule või seda koormavale õigusele; ülejäänud juhtudel muudatuste lahtritesse selles jaos, kuhu on kantud õigus, mille kohta märge käib.",
      "rdfs:label": {
        "@value": "KINNIS_Par_28 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
