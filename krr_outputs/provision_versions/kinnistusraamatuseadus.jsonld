        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 76",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_76_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusametile on esitatud kinnistamisavaldus, mille kohta ei ole veel tehtud kinnistamisotsust, peab kinnistusraamatu väljavõte sisaldama viidet kinnistamisavaldusele, mis on kantud kinnistuspäevikusse. [Paragrahvi 76 sõnastus alates 1.07.2003]",
      "rdfs:label": {
        "@value": "KINNIS_Par_76 (redaktsioon 254248)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254248",
