    {
      "@id": "estleg:KINNIS_Par_7_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistu asub mitmes kinnistuspiirkonnas, peetakse selle kohta kinnistusraamatut ainult ühes kinnistusametis, mille suhtes teeb valiku omanik kinnistusregistriosa avamisel.",
      "rdfs:label": {
        "@value": "KINNIS_Par_7 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
