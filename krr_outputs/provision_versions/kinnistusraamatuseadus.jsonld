      },
      "estleg:versionText": "Kinnistamisavalduse vastuvõtmisel väljastab kinnistusosakond avaldaja soovil tõendi, mis kinnitab avalduse vastuvõtmist.",
      "rdfs:label": {
        "@value": "KINNIS_Par_40 (redaktsioon 722030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "722030",
