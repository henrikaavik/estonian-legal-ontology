    {
      "@id": "estleg:KINNIS_Par_77_1_v13334064",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektroonilise kinnistusraamatu koosseisu kuuluvad: kinnistusregister; kinnistustoimik; kinnistuspäevik. (3) Kinnistusosakonnad peavad elektroonilist kinnistusraamatut oma kinnistuspiirkonna kohta. (4) Kõik elektroonilise kinnistusraamatu andmed salvestatakse ja säilitatakse ühes andmetöötluskeskuses. elektroonilise kinnistusraamatu andmetöötluskeskuse ning kehtestab andmetöötluse korra. (5) Andmetöötluskeskus ei ole kinnistusosakond ega pea kinnistusraamatut, vaid tagab üksnes kinnistusraamatu andmete elektroonilise salvestamise, kestvalt muutumatu säilitamise ja taasesitamise.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_1 (redaktsioon 13334064)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334064",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_77_1_v118122012013"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13334064",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_1",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_1_v118122012013",
      "@type": [
        "owl:NamedIndividual",
