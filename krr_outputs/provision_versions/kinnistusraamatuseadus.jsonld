      }
    },
    {
      "@id": "estleg:KINNIS_Par_40_v13334987",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistamisavalduse vastuvõtmisel väljastab kinnistusosakond avaldaja soovil tõendi, mis kinnitab avalduse vastuvõtmist. (2) Elektroonilise kinnistusraamatu infosüsteemi esitatud kinnistamisavalduse kohta saadetakse selle esitajale automaatne vastuvõtukinnitus. Automaatne vastuvõtukinnitus ei ole esitatud dokumendi tehnilise ja õigusliku korrektsuse tunnustamise alus.",
      "rdfs:label": {
        "@value": "KINNIS_Par_40 (redaktsioon 13334987)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334987",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_40_v109052017009"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13334987",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 40",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_40_v109052017009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Elektroonilise kinnistusraamatu infosüsteemi esitatud kinnistamisavalduse kohta saadetakse selle esitajale automaatne vastuvõtukinnitus. Automaatne vastuvõtukinnitus ei ole esitatud dokumendi tehnilise ja õigusliku korrektsuse tunnustamise alus.",
      "rdfs:label": {
        "@value": "KINNIS_Par_40 (redaktsioon 109052017009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052017009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109052017009",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 40",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_41_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) [kehtetu] (2) Kui ühe kinnistu kohta on esitatud mitu kinnistamisavaldust, ei tohi hiljem esitatud avalduse alusel teha kannet enne varem esitatud avalduse alusel kande tegemist. (3) [kehtetu]",
      "rdfs:label": {
        "@value": "KINNIS_Par_41 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_41_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 41",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_41_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) [Kehtetu] [Lõike 2 sõnastus kuni 30.06.2003] (2) Kui ühe kinnistu kohta on esitatud mitu kinnistamisavaldust, ei tohi hiljem esitatud avalduse alusel teha kannet enne varem esitatud avalduse alusel kande tegemist. [Lõike 2 sõnastus alates 1.07.2003] (2) Kui ühe kinnistu või ühe õiguse kohta on esitatud mitu kinnistamisavaldust, ei tohi hiljem esitatud avalduse alusel teha kannet enne varem esitatud avalduse alusel kande tegemist. (3) [kehtetu]",
      "rdfs:label": {
