    {
      "@id": "estleg:KINNIS_Par_62_1_v13334064",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_62_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kanne parandatakse juhul, kui: kanne on tehtud ebaõige kandemääruse alusel; kanne on muutunud ebaõigeks asjaõiguse kinnistusraamatuvälise ülemineku tõttu; kanne on muutunud ebaõigeks kinnistusraamatusse kantud isiku isikuandmete muutumise tõttu. (2) Kinnistusosakond parandab kande kinnistamisavalduse alusel või omal algatusel ametiülesande korras. Seaduses sätestatud juhtudel toimub kande parandamine automatiseeritult.",
      "rdfs:label": {
        "@value": "KINNIS_Par_62_1 (redaktsioon 13334064)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334064",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13334064",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 62_1",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
