        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusregistri kanne sisaldab: kande teksti; kande tegemise kuupäeva. kehtetu -",
      "rdfs:label": {
        "@value": "KINNIS_Par_23 (redaktsioon 128112024005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128112024005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128112024005",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 23",
