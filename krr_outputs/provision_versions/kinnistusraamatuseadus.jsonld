        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistamine on kinnistamiseks pädeva isiku otsuse alusel kinnistusraamatusse kande tegemine, sealhulgas kande muutmine või kustutamine. (2) Kanne tehakse pärast lõivu tasumist, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KINNIS_Par_33 (redaktsioon 722030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "722030",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_33_v928203"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/722030",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 33",
      "estleg:partOfAct": {
