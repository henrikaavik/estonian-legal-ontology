    {
      "@id": "estleg:KINNIS_Par_77_16_v128112024005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektroonilise kinnistusraamatu andmete väljastamine on tasuline. (2) kehtestab määrusega elektroonilise kinnistusraamatu andmete väljastamise eest tasumäärad kuni kolm eurot ühe päringu või päringuobjekti kohta. (3) Elektroonilise kinnistusraamatu andmete väljastamise tasu maksmisest on vabastatud isik riigiportaalis ja kinnisasja omanik elektroonilise kinnistusraamatu päringusüsteemis päringu tegemisel enda kohta, samuti käesoleva paragrahvi lõike 4 alusel valdkonna eest vastutava ministri määratud isikud avalik-õiguslike ülesannete täitmiseks. Samuti on elektroonilise veebipäringu tasu maksmisest vabastatud korteriomandi omanik teistele kinnisasja kaasomanikele kuuluvate korteriomandi registriosade andmetega tutvumisel ning kinnisasja omaniku seadusjärgne esindaja ja eestkostja. (4) kehtestab määrusega avalik-õiguslike juriidiliste isikute ja teiste isikute loetelu, kellele väljastatakse tasuta andmeid seaduses sätestatud avalik-õiguslike ülesannete täitmiseks.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_16 (redaktsioon 128112024005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128112024005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128112024005",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_16",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_17_v22262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINNIS_Par_77_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kannete tegemine elektroonilises kinnistusraamatus pole ajutiselt võimalik, siis võib kandeid teha kinnistusameti juhataja loal paberil olevasse asenduskinnistusraamatusse. Need võetakse üle elektroonilisse kinnistusraamatusse niipea, kui see on jälle võimalik. Justiitsministril on õigus reguleerida määrusega menetluse üksikasju.",
      "rdfs:label": {
        "@value": "KINNIS_Par_77_17 (redaktsioon 22262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22262",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINNIS_Par_77_17_v254248"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22262",
      "estleg:sourceAct": "Kinnistusraamatuseadus",
      "estleg:provisionRef": "KINNIS § 77_17",
      "estleg:partOfAct": {
        "@id": "estleg:KINNIS_Map"
      }
    },
    {
      "@id": "estleg:KINNIS_Par_77_17_v254248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
