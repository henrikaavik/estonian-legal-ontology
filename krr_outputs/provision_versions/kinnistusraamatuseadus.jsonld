      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusosakonna arhiivi peetakse digitaalselt. (2) Kinnistusosakonna arhiivis hoitavate andmete ja dokumentide nimekirja ja säilitamise tähtajad, samuti arhiivi pidamise ja säilitamise korra ning arhiivile esitatavad nõuded kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KINNIS_Par_22 (redaktsioon 121062014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014032",
