    {
      "@id": "estleg:Reg_1052113_Par_5_v1052113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052113_Par_5"
