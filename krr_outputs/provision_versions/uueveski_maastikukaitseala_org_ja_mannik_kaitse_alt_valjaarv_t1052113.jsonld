      "estleg:sourceAct": "Uueveski maastikukaitseala (org ja männik) kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1052113 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052113_Map"
      }
    },
