      "estleg:versionValidFrom": {
        "@value": "2021-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 23. juuli 2020. a käskkirjaga nr 1-2/20/318 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 23. juuli 2020. a käskkirjaga nr 1-2/20/318 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1052113_Par_5 (redaktsioon 1052113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052113",
