      "estleg:provisionRef": "Reg_1052113 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052113_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052113_Par_6_v1052113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
