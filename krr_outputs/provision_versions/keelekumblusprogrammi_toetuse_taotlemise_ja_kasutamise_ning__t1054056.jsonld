      },
      "estleg:versionText": "Keelekümblusprogrammist välja astumiseks esitab haridusasutus avalduse. Keelekümblusprogrammist välja astumiseks esitab haridusasutus avalduse.",
      "rdfs:label": {
        "@value": "Reg_1054056_Par_14 (redaktsioon 1054056)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054056",
