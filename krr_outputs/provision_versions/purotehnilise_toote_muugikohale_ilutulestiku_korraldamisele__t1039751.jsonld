    {
      "@id": "estleg:Reg_1039751_Par_2_v1039751",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039751_Par_2"
