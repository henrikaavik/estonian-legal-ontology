  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_kutsealuse_reservis_oleva_isiku_kaitsevaekohustust_votta_soo_t1056518_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku terviseseisundi hindamiseks arstlikul läbivaatusel, terviseuuringul või kutsesobivuse hindamisel viibimisega seotud sõidu- ja toidukulu hüvitamise tingimused, ulatus ja hüvitise maksmise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku terviseseisundi hindamiseks arstlikul läbivaatusel, terviseuuringul või kutsesobivuse hindamisel viibimisega seotud sõidu- ja toidukulu hüvitamise tingimused, ulatus ja hüvitise maksmise kord"
    },
    {
      "@id": "estleg:Reg_1056518_Par_1_v1056518",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056518_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku sõidu- ja toidukulu katteks makstava hüvitise (edaspidi hüvitis) maksmise tingimused, kord ja ulatus järgnevatel juhtudel: 1 1) kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku terviseseisundi hindamiseks ettenähtud arstlikul läbivaatusel või terviseuuringul viibimine vastavalt kaitseväeteenistuse seaduse § 261 lõikele 8, § 34 lõikele 2, § 72 lõikele 2, § 81 lõikele 5 ja § 82 lõikele 51; 2 2) kutsealuse ja ajateenistusse asuda sooviva naissoost isiku kutsesobivuse hindamine Kaitseressursside Ametis vastavalt kaitseväeteenistuse seaduse § 35 lõike 3 ja § 82 lõike 54 alusel kehtestatud korrale. Käesoleva määrusega kehtestatakse kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku sõidu- ja toidukulu katteks makstava hüvitise (edaspidi hüvitis) maksmise tingimused, kord ja ulatus järgnevatel juhtudel: kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku terviseseisundi hindamiseks ettenähtud arstlikul läbivaatusel või terviseuuringul viibimine vastavalt kaitseväeteenistuse seaduse § 261 lõikele 8, § 34 lõikele 2, § 72 lõikele 2, § 81 lõikele 5 ja § 82 lõikele 51; kutsealuse ja ajateenistusse asuda sooviva naissoost isiku kutsesobivuse hindamine Kaitseressursside Ametis vastavalt kaitseväeteenistuse seaduse § 35 lõike 3 ja § 82 lõike 54 alusel kehtestatud korrale.",
      "rdfs:label": {
        "@value": "Reg_1056518_Par_1 (redaktsioon 1056518)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056518",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056518",
      "estleg:sourceAct": "Kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku terviseseisundi hindamiseks arstlikul läbivaatusel, terviseuuringul või kutsesobivuse hindamisel viibimisega seotud sõidu- ja toidukulu hüvitamise tingimused, ulatus ja hüvitise maksmise kord",
      "estleg:provisionRef": "Reg_1056518 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056518_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056518_Par_2_v1056518",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056518_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigus hüvitisele on: 1 1) kutsealusel, reservis oleval isikul, kaitseväekohustust võtta soovival isikul ja ajateenistusse asuda soovival naissoost isikul, kes on ettenähtud ulatuses osalenud terviseseisundi hindamiseks arstlikul läbivaatusel või terviseuuringul; 2 2) kutsealusel ja ajateenistusse asuda soovival naissoost isikul, kes on ettenähtud ulatuses osalenud kutsesobivuse hindamisel. Õigus hüvitisele on: kutsealusel, reservis oleval isikul, kaitseväekohustust võtta soovival isikul ja ajateenistusse asuda soovival naissoost isikul, kes on ettenähtud ulatuses osalenud terviseseisundi hindamiseks arstlikul läbivaatusel või terviseuuringul; kutsealusel ja ajateenistusse asuda soovival naissoost isikul, kes on ettenähtud ulatuses osalenud kutsesobivuse hindamisel.",
      "rdfs:label": {
        "@value": "Reg_1056518_Par_2 (redaktsioon 1056518)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056518",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056518",
      "estleg:sourceAct": "Kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku terviseseisundi hindamiseks arstlikul läbivaatusel, terviseuuringul või kutsesobivuse hindamisel viibimisega seotud sõidu- ja toidukulu hüvitamise tingimused, ulatus ja hüvitise maksmise kord",
      "estleg:provisionRef": "Reg_1056518 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056518_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056518_Par_3_v1056518",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056518_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Terviseseisundi hindamiseks ettenähtud arstlikul läbivaatusel või terviseuuringul ning kutsesobivuse hindamisel viibimisega seotud hüvitise ulatus on 15 eurot. Terviseseisundi hindamiseks ettenähtud arstlikul läbivaatusel või terviseuuringul ning kutsesobivuse hindamisel viibimisega seotud hüvitise ulatus on 15 eurot. 2 (2) Kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku, kelle elukoht on rahvastikuregistri andmetel välisriigis, terviseseisundi hindamiseks ettenähtud arstlikul läbivaatusel või terviseuuringul või kutsealuse kutsesobivuse hindamisel viibimisega seotud hüvitise ulatus on 70 eurot. Kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku, kelle elukoht on rahvastikuregistri andmetel välisriigis, terviseseisundi hindamiseks ettenähtud arstlikul läbivaatusel või terviseuuringul või kutsealuse kutsesobivuse hindamisel viibimisega seotud hüvitise ulatus on 70 eurot.",
      "rdfs:label": {
        "@value": "Reg_1056518_Par_3 (redaktsioon 1056518)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056518",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056518",
      "estleg:sourceAct": "Kutsealuse, reservis oleva isiku, kaitseväekohustust võtta sooviva isiku ja ajateenistusse asuda sooviva naissoost isiku terviseseisundi hindamiseks arstlikul läbivaatusel, terviseuuringul või kutsesobivuse hindamisel viibimisega seotud sõidu- ja toidukulu hüvitamise tingimused, ulatus ja hüvitise maksmise kord",
      "estleg:provisionRef": "Reg_1056518 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056518_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056518_Par_4_v1056518",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056518_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hüvitise saamiseks esitab kutsealune, reservis olev isik, kaitseväekohustust võtta sooviv isik ja ajateenistusse asuda sooviv naissoost isik Kaitseressursside Ametile selle arvelduskonto andmed, kuhu soovitakse hüvitise maksmist. Hüvitise saamiseks esitab kutsealune, reservis olev isik, kaitseväekohustust võtta sooviv isik ja ajateenistusse asuda sooviv naissoost isik Kaitseressursside Ametile selle arvelduskonto andmed, kuhu soovitakse hüvitise maksmist. 2 (2) Kaitseressursside Amet otsustab hüvitise maksmise seitsme kalendripäeva jooksul, kui hüvitise saaja on läbinud arstliku läbivaatuse või terviseuuringu terviseseisundi hindamiseks ettenähtud ulatuses või viibinud kutsesobivuse hindamisel ning esitanud arvelduskonto andmed. Kaitseväekohustuslaste registrist edastatakse väljamaksmisele kuuluva hüvitise summa ja arvelduskonto andmed riigi personali- ja palgaarvestuse andmekogusse. Hüvitise summa kantakse arvelduskontole 14 kalendripäeva jooksul hüvitise määramisest arvates. Kaitseressursside Amet otsustab hüvitise maksmise seitsme kalendripäeva jooksul, kui hüvitise saaja on läbinud arstliku läbivaatuse või terviseuuringu terviseseisundi hindamiseks ettenähtud ulatuses või viibinud kutsesobivuse hindamisel ning esitanud arvelduskonto andmed. Kaitseväekohustuslaste registrist edastatakse väljamaksmisele kuuluva hüvitise summa ja arvelduskonto andmed riigi personali- ja palgaarvestuse andmekogusse. Hüvitise summa kantakse arvelduskontole 14 kalendripäeva jooksul hüvitise määramisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1056518_Par_4 (redaktsioon 1056518)",
        "@language": "et"
      },
