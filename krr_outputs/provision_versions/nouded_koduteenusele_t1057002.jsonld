      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse täpsustatud nõuded koduteenuse sisule, sealhulgas tegevustele, mis on vajalikud teenuse eesmärgi saavutamiseks. Määrusega kehtestatakse täpsustatud nõuded koduteenuse sisule, sealhulgas tegevustele, mis on vajalikud teenuse eesmärgi saavutamiseks.",
      "rdfs:label": {
        "@value": "Reg_1057002_Par_1 (redaktsioon 1057002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057002",
      "estleg:sourceAct": "Nõuded koduteenusele",
