      "estleg:provisionRef": "Reg_1001209 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001209_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001209_Par_3_v1001209",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001209_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Praktika tuleb korraldada selliselt, et praktikandil oleks võimalik omandada iseseisvaks vandeaudiitori või siseaudiitori kutsetegevuseks vajalikud teadmised, oskused ning vilumus vandeaudiitori või siseaudiitori kutsetegevuse ulatuses valdkondades ja teemades, mis on nimetatud „Audiitortegevuse seaduse“ § 21 lõike 2 alusel kehtestatud rahandusministri määruse „Kutseeksami programm“ lisas „Kutseksami jaod“. Praktika tuleb korraldada selliselt, et praktikandil oleks võimalik omandada iseseisvaks vandeaudiitori või siseaudiitori kutsetegevuseks vajalikud teadmised, oskused ning vilumus vandeaudiitori või siseaudiitori kutsetegevuse ulatuses valdkondades ja teemades, mis on nimetatud „Audiitortegevuse seaduse“ § 21 lõike 2 alusel kehtestatud rahandusministri määruse „Kutseeksami programm“ lisas „Kutseksami jaod“. 2 (2) Praktikandil peab olema vähemalt üks juhendaja ja praktika korraldamiseks peab olema vähemalt üks praktika korraldaja. Praktikandil peab olema vähemalt üks juhendaja ja praktika korraldamiseks peab olema vähemalt üks praktika korraldaja.",
      "rdfs:label": {
        "@value": "Reg_1001209_Par_3 (redaktsioon 1001209)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001209",
