      }
    },
    {
      "@id": "estleg:Reg_162543_Par_15_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kopteri erapiloodil on õigus tegutseda kaptenina või teise piloodina mitteärilistel lendudel loale kantud tüübipädevustele vastavatel kopteritel. Kopteri erapiloodil on õigus tegutseda kaptenina või teise piloodina mitteärilistel lendudel loale kantud tüübipädevustele vastavatel kopteritel. 2 (2) Kopteri erapiloot ei tohi tegutseda kaptenina reisijateveol, kui ta 90 päeva jooksul ei ole iseseisvalt sooritatud kolme starti ja maandumist seda tüüpi kopteril. Samad nõuded kehtivad ka reisijateveoks öösel. Kopteri erapiloot ei tohi tegutseda kaptenina reisijateveol, kui ta 90 päeva jooksul ei ole iseseisvalt sooritatud kolme starti ja maandumist seda tüüpi kopteril. Samad nõuded kehtivad ka reisijateveoks öösel.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_15 (redaktsioon 162543)",
        "@language": "et"
      },
