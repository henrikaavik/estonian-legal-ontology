    {
      "@id": "estleg:Reg_162543_Par_48_55_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_48_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "B klassi ülikerglennuki ja ülikergõhusõiduki liigituse alla kuuluva kopteri piloodiloa omanik tohib lennule kaasa võtta reisija, kui ta on pärast lennuõppe läbimist lennanud ülikergõhusõidukil vähemalt 15 tundi soololendu ning lennule eelneva 90 päeva jooksul sooritanud vähemalt viis lendu antud tüüpi ülikergõhusõidukil. Lennule kaasavõetud ülikergõhusõiduki piloodiloa omanikku ei loeta reisijaks. RT I 2014-12-12 1 112122014001 2014-12-15 B klassi ülikerglennuki ja ülikergõhusõiduki liigituse alla kuuluva kopteri piloodiloa omanik tohib lennule kaasa võtta reisija, kui ta on pärast lennuõppe läbimist lennanud ülikergõhusõidukil vähemalt 15 tundi soololendu ning lennule eelneva 90 päeva jooksul sooritanud vähemalt viis lendu antud tüüpi ülikergõhusõidukil. Lennule kaasavõetud ülikergõhusõiduki piloodiloa omanikku ei loeta reisijaks.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_48_55 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 48_55",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_48_56_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_48_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ülikergõhusõiduki piloodiloa omanik võib loast tulenevaid õigusi kasutada üksnes tingimusel, et ta on eelneva 24 kuu jooksul ülikergõhusõiduki piloodina teinud järgmist: 1 1) lennanud kaptenina vähemalt 12 lennutundi, mis muu hulgas hõlmab 12 starti ja maandumist; 2 2) läbinud täiendusõppe, mis hõlmab vähemalt üht lennutundi koos lennuõpetajaga. Ülikergõhusõiduki piloodiloa omanik võib loast tulenevaid õigusi kasutada üksnes tingimusel, et ta on eelneva 24 kuu jooksul ülikergõhusõiduki piloodina teinud järgmist: lennanud kaptenina vähemalt 12 lennutundi, mis muu hulgas hõlmab 12 starti ja maandumist; läbinud täiendusõppe, mis hõlmab vähemalt üht lennutundi koos lennuõpetajaga. 2 (2) Ülikergõhusõiduki piloodiloa omanik, kes ei vasta käesoleva paragrahvi lõike 1 punktide 1 ja 2 nõuetele, peab tegema järgmist: 1 1) enne piloodiloast tulenevate õiguste kasutamise jätkamist sooritama lennuoskuse tasemekontrolli kontrollpiloodi osavõtul või 2 2) sooritama käesoleva paragrahvi lõike 1 nõuete täitmiseks koos lennuõpetajaga või soololennul lennuõpetaja järelevalve all täiendavaid lennutunde või starte ja maandumisi. RT I 2014-12-12 1 112122014001 2014-12-15 Ülikergõhusõiduki piloodiloa omanik, kes ei vasta käesoleva paragrahvi lõike 1 punktide 1 ja 2 nõuetele, peab tegema järgmist: enne piloodiloast tulenevate õiguste kasutamise jätkamist sooritama lennuoskuse tasemekontrolli kontrollpiloodi osavõtul või sooritama käesoleva paragrahvi lõike 1 nõuete täitmiseks koos lennuõpetajaga või soololennul lennuõpetaja järelevalve all täiendavaid lennutunde või starte ja maandumisi. 3 (3) Lõigetes 1 ja 2 sätestatut ei kohaldata A klassi ülikergõhusõiduki piloodiloa omaniku suhtes. RT I 2022-12-30 1 130122022001 2023-01-02 Lõigetes 1 ja 2 sätestatut ei kohaldata A klassi ülikergõhusõiduki piloodiloa omaniku suhtes. 4 (4) Taotleja, kes omab B klassi ülikerg-maalennuki pädevust ja ühe kolbmootoriga lennukite klassi maismaapädevust, võib lõigetes 1 ja 2 sätestatud hiljutise lennukogemuse nõuded täita ühes neist klassidest või kombineerituna mõlemas klassis. RT I 2022-12-30 1 130122022001 2023-01-02 Taotleja, kes omab B klassi ülikerg-maalennuki pädevust ja ühe kolbmootoriga lennukite klassi maismaapädevust, võib lõigetes 1 ja 2 sätestatud hiljutise lennukogemuse nõuded täita ühes neist klassidest või kombineerituna mõlemas klassis.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_48_56 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 48_56",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_48_57_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_48_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ülikergõhusõidukiga veekogudelt lendamise pädevuse taotlemiseks peab taotlejal olema: 1 1) läbitud ülikergõhusõiduki pilootide koolitust pakkuva koolitusorganisatsiooni asjakohane teooriakursus ja lennuõpe; RT I 2022-12-30 1 130122022001 2023-01-02 2 2) vähemalt 35 üldlennutundi ülikergõhusõidukil enne lennuõppe algust; 3 3) sooritatud ülikergõhusõidukil 50 starti ja maandumist veekogudel; 4 4) sooritatud kontroll-lend koos kontrollpiloodiga. Ülikergõhusõidukiga veekogudelt lendamise pädevuse taotlemiseks peab taotlejal olema: läbitud ülikergõhusõiduki pilootide koolitust pakkuva koolitusorganisatsiooni asjakohane teooriakursus ja lennuõpe; vähemalt 35 üldlennutundi ülikergõhusõidukil enne lennuõppe algust; sooritatud ülikergõhusõidukil 50 starti ja maandumist veekogudel; sooritatud kontroll-lend koos kontrollpiloodiga. 2 (2) Kui taotlejal on pädevus vesilennukil lendamiseks, tuleb tal sooritada vaid kontroll-lend koos kontrollpiloodiga. RT I 2014-12-12 1 112122014001 2014-12-15 Kui taotlejal on pädevus vesilennukil lendamiseks, tuleb tal sooritada vaid kontroll-lend koos kontrollpiloodiga.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_48_57 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 48_57",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
