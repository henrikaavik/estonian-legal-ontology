      }
    },
    {
      "@id": "estleg:Reg_162543_Par_63_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_63"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loa pikendamiseks peab taotleja eelnenud 12 kuu jooksul olema sooritanud motopurilennukil vähemalt 5 lendu kogulennuajaga 2 tundi, mida kinnitavad vastavad sissekanded lennuraamatus või sooritama kontroll-lennu. Loa pikendamiseks peab taotleja eelnenud 12 kuu jooksul olema sooritanud motopurilennukil vähemalt 5 lendu kogulennuajaga 2 tundi, mida kinnitavad vastavad sissekanded lennuraamatus või sooritama kontroll-lennu.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_63 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 63",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_64_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui motopurilennuki piloodiluba on olnud kehtetu kuni 12 kuud, peab taotleja selle uuendamiseks sooritama kontroll-lennu. Kui motopurilennuki piloodiluba on olnud kehtetu kuni 12 kuud, peab taotleja selle uuendamiseks sooritama kontroll-lennu. 2 (2) Kui piloodiluba on olnud kehtetu 12 kuni 48 kuud, peab selle uuendamiseks sooritama kontroll-lennu ja sooritama eksamid järgmistes ainetes: 1 1) lennundusõigusaktid; 2 2) lennu planeerimine ja teostamine; 3 3) õhusõiduki käitamine. Kui piloodiluba on olnud kehtetu 12 kuni 48 kuud, peab selle uuendamiseks sooritama kontroll-lennu ja sooritama eksamid järgmistes ainetes: lennundusõigusaktid; lennu planeerimine ja teostamine; õhusõiduki käitamine. 3 (3) Kui piloodiluba on olnud kehtetu üle 48 kuu, peab selle uuendamiseks läbima vastava teooriakursuse, sooritama kontroll-lennu ja eksamid järgmistes ainetes: 1 1) lennundusõigusaktid; 2 2) õhusõiduki üldehitus; 3 3) aerodünaamika; 4 4) lennu planeerimine ja tundmine; 5 5) navigatsioon; 6 6) meteoroloogia; 7 7) õhusõiduki käitamine; 8 8) inimfaktor ja sellest tulenevad piirangud; 9 9) lennundusraadioside. Kui piloodiluba on olnud kehtetu üle 48 kuu, peab selle uuendamiseks läbima vastava teooriakursuse, sooritama kontroll-lennu ja eksamid järgmistes ainetes: lennundusõigusaktid; õhusõiduki üldehitus; aerodünaamika; lennu planeerimine ja tundmine; navigatsioon; meteoroloogia; õhusõiduki käitamine; inimfaktor ja sellest tulenevad piirangud; lennundusraadioside.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_64 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 64",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
