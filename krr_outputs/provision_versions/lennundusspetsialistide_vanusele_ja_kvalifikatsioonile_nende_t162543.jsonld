    {
      "@id": "estleg:Reg_162543_Par_48_54_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_48_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) B klassi ülikerglennuki piloodile kohaldatakse Komisjoni määruse (EL) nr 1178/2011 lisa I punktides FCL.100, FCL.105, FCL.110, FCL.120, FCL.125, FCL.110.A ja FCL.135.A sätestatut. RT I 2022-12-30 1 130122022001 2023-01-02 B klassi ülikerglennuki piloodile kohaldatakse Komisjoni määruse (EL) nr 1178/2011 lisa I punktides FCL.100, FCL.105, FCL.110, FCL.120, FCL.125, FCL.110.A ja FCL.135.A sätestatut. 2 (2) Ülikergõhusõiduki liigituse alla kuuluva kopteri piloodile kohaldatakse Komisjoni määruse (EL) nr 1178/2011 lisa I punktides FCL.100, FCL.105, FCL.110, FCL.120, FCL.125, FCL.110.H ja FCL.135.H sätestatut. RT I 2014-12-12 1 112122014001 2014-12-15 Ülikergõhusõiduki liigituse alla kuuluva kopteri piloodile kohaldatakse Komisjoni määruse (EL) nr 1178/2011 lisa I punktides FCL.100, FCL.105, FCL.110, FCL.120, FCL.125, FCL.110.H ja FCL.135.H sätestatut.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_48_54 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 48_54",
