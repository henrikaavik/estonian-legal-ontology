    {
      "@id": "estleg:Reg_162543_Par_144_162_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_144_162"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mehitamata õhusõiduki kaugpilootide koolitusorganisatsiooni käsiraamat peab sisaldama järgmist teavet kaugpilootide koolituse korralduse kohta: 1 1) organisatsiooni juhtimisstruktuur ning juhtivtöötajate nimed; 2 2) juhtimissüsteemi kirjeldus; 3 3) õppeks ja eksamineerimiseks kasutatavad käitamiskohad ning loetelu seal kasutusel olevatest tehnilistest võimalustest või vahenditest; 4 4) õpetajate nimed ja kvalifikatsioon; 5 5) koolitusprogrammid; 6 6) eksamineerimise kord. Mehitamata õhusõiduki kaugpilootide koolitusorganisatsiooni käsiraamat peab sisaldama järgmist teavet kaugpilootide koolituse korralduse kohta: organisatsiooni juhtimisstruktuur ning juhtivtöötajate nimed; juhtimissüsteemi kirjeldus; õppeks ja eksamineerimiseks kasutatavad käitamiskohad ning loetelu seal kasutusel olevatest tehnilistest võimalustest või vahenditest; õpetajate nimed ja kvalifikatsioon; koolitusprogrammid; eksamineerimise kord. 2 (2) Juhul kui mehitamata õhusõiduki kaugpilootide koolitusorganisatsioon korraldab ainult lennundusseaduse § 4621 lõikes 3 sätestatud teooriaeksami, peab mehitamata õhusõiduki kaugpilootide koolitusorganisatsiooni käsiraamat sisaldama käesoleva paragrahvi lõike 1 punktides 1, 2, 3, ja 6 loetletud teavet. RT I 2022-08-16 3 116082022003 2022-08-19 Juhul kui mehitamata õhusõiduki kaugpilootide koolitusorganisatsioon korraldab ainult lennundusseaduse § 4621 lõikes 3 sätestatud teooriaeksami, peab mehitamata õhusõiduki kaugpilootide koolitusorganisatsiooni käsiraamat sisaldama käesoleva paragrahvi lõike 1 punktides 1, 2, 3, ja 6 loetletud teavet.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_144_162 (redaktsioon 162543)",
        "@language": "et"
      },
