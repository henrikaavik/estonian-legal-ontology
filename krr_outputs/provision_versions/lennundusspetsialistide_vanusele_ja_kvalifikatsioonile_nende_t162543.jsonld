    {
      "@id": "estleg:Reg_162543_Par_116_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_116"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülikergõhusõiduki lennuõpetaja pädevuse omanik võib oma pädevusega seotud õigusi kasutada juhul, kui ta on viimase viie aasta jooksul läbinud ülikergõhusõiduki lennuõpetaja täiendkoolituse, andnud vähemalt viis tundi lennuõpet lennuõpetajana või sooritanud § 114 lõike 6 kohase kontroll-lennu. RT I 2022-12-30 1 130122022001 2023-01-02 Ülikergõhusõiduki lennuõpetaja pädevuse omanik võib oma pädevusega seotud õigusi kasutada juhul, kui ta on viimase viie aasta jooksul läbinud ülikergõhusõiduki lennuõpetaja täiendkoolituse, andnud vähemalt viis tundi lennuõpet lennuõpetajana või sooritanud § 114 lõike 6 kohase kontroll-lennu.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_116 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 116",
