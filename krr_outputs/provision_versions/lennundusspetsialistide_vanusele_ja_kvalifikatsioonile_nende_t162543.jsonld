    {
      "@id": "estleg:Reg_162543_Par_17_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Loa pikendamiseks tuleb Transpordiametile esitada: 1 1) taotlus; 2 2) kopteri erapiloodiluba; 3 3) nõuetekohane kehtiv tervisetõend; 4 4) lennuraamat või väljavõte sellest lennutundide kohta; 5 5) aruanne edukalt sooritatud kontroll-lennu kohta juhul, kui taotleja lennukogemus kopteritel on vähem kui 150 lennutundi, millest viimase 24 kuu jooksul on vähem kui 20 lennutundi ning viimase 12 kuu jooksul on vähem kui 10 lennutundi; 6 6) maksekviitung riigilõivu tasumise kohta Transpordiameti toimingute eest. Loa pikendamiseks tuleb Transpordiametile esitada: taotlus; kopteri erapiloodiluba; nõuetekohane kehtiv tervisetõend; lennuraamat või väljavõte sellest lennutundide kohta; aruanne edukalt sooritatud kontroll-lennu kohta juhul, kui taotleja lennukogemus kopteritel on vähem kui 150 lennutundi, millest viimase 24 kuu jooksul on vähem kui 20 lennutundi ning viimase 12 kuu jooksul on vähem kui 10 lennutundi; maksekviitung riigilõivu tasumise kohta Transpordiameti toimingute eest. 2 (2) Loa pikendamiseks tuleb taotlejal sooritada lennundusõigusaktide tundmise test. Loa pikendamiseks tuleb taotlejal sooritada lennundusõigusaktide tundmise test.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_17 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 17",
      "estleg:partOfAct": {
