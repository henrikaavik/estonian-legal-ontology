    {
      "@id": "estleg:Reg_162543_Par_104_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_104"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pädevuse pikendamiseks tuleb sooritada kontroll-lend. Transpordiameti loal võib kontroll-lennu asendada kontrolliga antud kopteritüübile vastaval simulaatoril. Pädevuse pikendamiseks tuleb sooritada kontroll-lend. Transpordiameti loal võib kontroll-lennu asendada kontrolliga antud kopteritüübile vastaval simulaatoril. 2 (2) Kui kopteripiloodi instrumentaallennupädevus kehtib mitmemootorilisel kopteril, tuleb ka kontroll-lend sooritada mitmemootorilisel kopteril. Kui kopteripiloodi instrumentaallennupädevus kehtib mitmemootorilisel kopteril, tuleb ka kontroll-lend sooritada mitmemootorilisel kopteril.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_104 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 104",
      "estleg:partOfAct": {
