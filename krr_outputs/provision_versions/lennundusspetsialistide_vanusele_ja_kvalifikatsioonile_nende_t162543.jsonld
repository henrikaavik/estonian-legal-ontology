    {
      "@id": "estleg:Reg_162543_Par_10_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Erapiloodil on õigus tegutseda kaptenina või teise piloodina mitteärilistel lendudel loale kantud klassi- või tüübipädevusmärgetele vastavatel lennukitel. Erapiloodil on õigus tegutseda kaptenina või teise piloodina mitteärilistel lendudel loale kantud klassi- või tüübipädevusmärgetele vastavatel lennukitel. 2 (2) Erapiloot ei tohi tegutseda kaptenina reisijateveol, kui ta 90 päeva jooksul ei ole iseseisvalt sooritanud kolme starti ja maandumist sama tüüpi või klassi lennukil. Erapiloot ei tohi tegutseda kaptenina reisijateveol, kui ta 90 päeva jooksul ei ole iseseisvalt sooritanud kolme starti ja maandumist sama tüüpi või klassi lennukil. 3 (3) Öölendude sooritamiseks peab erapiloot läbi tegema § 9 lõike 5 punktis 4 nõutud lennukoolituse. Öölendude sooritamiseks peab erapiloot läbi tegema § 9 lõike 5 punktis 4 nõutud lennukoolituse.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_10 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_100_v162543",
      "@type": [
        "owl:NamedIndividual",
