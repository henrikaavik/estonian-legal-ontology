    {
      "@id": "estleg:Reg_162543_Par_58_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Loa pikendamiseks peab purilennuki piloot pikendamisele eelnenud 12 kuu jooksul olema sooritanud purilennukil vähemalt 5 lendu kogulennuajaga 2 tundi, mida kinnitavad vastavad sissekanded isiklikus lennuraamatus või esitama uuendamiseks kontroll-lennu sooritamise akti. Loa pikendamiseks peab purilennuki piloot pikendamisele eelnenud 12 kuu jooksul olema sooritanud purilennukil vähemalt 5 lendu kogulennuajaga 2 tundi, mida kinnitavad vastavad sissekanded isiklikus lennuraamatus või esitama uuendamiseks kontroll-lennu sooritamise akti. 2 (2) Pädevuste pikendamiseks peab purilennuki piloot esitama Transpordiametile vajaliku kontroll-lennu akti või tõestama, et ta on eelneva 12 kuu jooksul sooritanud vähemalt ühe vastavat pädevust nõudva lennu. Pädevuste pikendamiseks peab purilennuki piloot esitama Transpordiametile vajaliku kontroll-lennu akti või tõestama, et ta on eelneva 12 kuu jooksul sooritanud vähemalt ühe vastavat pädevust nõudva lennu.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_58 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 58",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
