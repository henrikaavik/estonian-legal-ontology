        "@type": "xsd:date"
      },
      "estleg:versionText": "Motopurilennuki piloodiluba kehtib kuni 5 aastat. Motopurilennuki piloodiluba kehtib kuni 5 aastat.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_61 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
