      "estleg:provisionRef": "Reg_162543 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_30_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Liinipiloodil on õigus töötada: 1 1) erapiloodina, ametpiloodina ja liinipiloodina visuaal- ja instrumentaallennu tingimustes; 2 2) kaptenina või teise piloodina ärilises lennutegevuses vastava tüübipädevusega lennukitel. Liinipiloodil on õigus töötada: erapiloodina, ametpiloodina ja liinipiloodina visuaal- ja instrumentaallennu tingimustes; kaptenina või teise piloodina ärilises lennutegevuses vastava tüübipädevusega lennukitel.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_30 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_31_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Liinipiloodi luba kehtib kuni viis aastat kehtiva tervisetõendi ja vähemalt ühe kehtiva pädevuse korral. Liinipiloodi luba kehtib kuni viis aastat kehtiva tervisetõendi ja vähemalt ühe kehtiva pädevuse korral.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_31 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 31",
