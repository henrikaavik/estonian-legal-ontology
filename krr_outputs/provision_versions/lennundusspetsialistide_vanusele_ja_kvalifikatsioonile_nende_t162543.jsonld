      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülikergõhusõidukite liigitus on sätestatud majandus- ja kommunikatsiooniministri 12. augusti 2003. a määruses nr 119 „Ülikergõhusõiduki käitamise eeskiri”. RT I 2014-12-12 1 112122014001 2014-12-15 Ülikergõhusõidukite liigitus on sätestatud majandus- ja kommunikatsiooniministri 12. augusti 2003. a määruses nr 119 „Ülikergõhusõiduki käitamise eeskiri”.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_48_49 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 48_49",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
