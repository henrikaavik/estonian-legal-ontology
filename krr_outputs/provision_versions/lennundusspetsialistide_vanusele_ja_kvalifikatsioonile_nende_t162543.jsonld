    {
      "@id": "estleg:Reg_162543_Par_129_143_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_129_143"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ülikergõhusõiduki kontrollpiloodina tegutsemisteks peab isikul olema ülikergõhusõiduki kontrollpiloodi tunnistus. Ülikergõhusõiduki kontrollpiloodina tegutsemisteks peab isikul olema ülikergõhusõiduki kontrollpiloodi tunnistus. 2 (2) Kehtetu - RT I 2023-10-04 1 104102023001 2023-10-07 Kehtetu - 3 (3) Ülikergõhusõiduki kontrollpiloodi tunnistuse taotlemiseks tuleb Transpordiametile esitada taotlus, milles isik tõendab enda vastavust käesoleva määruse § 1292 lõike 1 punktides 1–4 sätestatud nõuetele. RT I 2014-12-12 1 112122014001 2014-12-15 Ülikergõhusõiduki kontrollpiloodi tunnistuse taotlemiseks tuleb Transpordiametile esitada taotlus, milles isik tõendab enda vastavust käesoleva määruse § 1292 lõike 1 punktides 1–4 sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_129_143 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 129_143",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_129_144_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_129_144"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ülikergõhusõiduki kontrollpiloodi tunnistuse taotleja peab: 1 1) omama ülikergõhusõiduki piloodiluba; 2 2) omama vähemalt kaheaastast ülikergõhusõiduki lennuõpetaja pädevust; 3 3) olema lennanud vähemalt 200 lennutundi ülikergõhusõidukil; 4 4) olema läbinud kontrollpiloodi koolituse. 5 5) kehtetu - RT I 2022-12-30 1 130122022001 2023-01-02 Ülikergõhusõiduki kontrollpiloodi tunnistuse taotleja peab: omama ülikergõhusõiduki piloodiluba; omama vähemalt kaheaastast ülikergõhusõiduki lennuõpetaja pädevust; olema lennanud vähemalt 200 lennutundi ülikergõhusõidukil; olema läbinud kontrollpiloodi koolituse. kehtetu - 2 (2) Kehtetu - RT I 2022-12-30 1 130122022001 2023-01-02 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_162543_Par_129_144 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 129_144",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_129_145_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_129_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülikergõhusõiduki kontrollpiloodil on õigus sooritada oma lennundusloale märgitud lennundusloaga antud õigustele vastavat kontroll-lendu piloodiloa taotlejale ja lennuõpetajale pädevuse andmiseks või pädevuse kehtivuse jätkamiseks.. RT I 2022-12-30 1 130122022001 2023-01-02 Ülikergõhusõiduki kontrollpiloodil on õigus sooritada oma lennundusloale märgitud lennundusloaga antud õigustele vastavat kontroll-lendu piloodiloa taotlejale ja lennuõpetajale pädevuse andmiseks või pädevuse kehtivuse jätkamiseks..",
      "rdfs:label": {
        "@value": "Reg_162543_Par_129_145 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 129_145",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_129_146_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_129_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülikergõhusõiduki kontrollpiloodi tunnistuse kehtivusaja pikendamiseks peab kontrollpiloot olema tunnistuse kehtivusaja jooksul läbinud kontrollpiloodi täiendkoolituse. RT I 2022-12-30 1 130122022001 2023-01-02 Ülikergõhusõiduki kontrollpiloodi tunnistuse kehtivusaja pikendamiseks peab kontrollpiloot olema tunnistuse kehtivusaja jooksul läbinud kontrollpiloodi täiendkoolituse.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_129_146 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 129_146",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_162543_Par_13_v162543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162543_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui piloodiluba on olnud kehtetu kuni 12 kuud, tuleb taotlejal selle uuendamiseks sooritada kontroll-lend. Kui piloodiluba on olnud kehtetu kuni 12 kuud, tuleb taotlejal selle uuendamiseks sooritada kontroll-lend. 2 (2) Kui piloodiluba on olnud kehtetu 12 kuni 24 kuud, peab taotleja selle uuendamiseks sooritama kontroll-lennu ühtsete lennundusnõuete (JAR-FCL 1) kohaselt ja eksamid järgmistes ainetes: 1 1) lennundusõigusaktid; 2 2) lennu planeerimine ja teostamine. Kui piloodiluba on olnud kehtetu 12 kuni 24 kuud, peab taotleja selle uuendamiseks sooritama kontroll-lennu ühtsete lennundusnõuete (JAR-FCL 1) kohaselt ja eksamid järgmistes ainetes: lennundusõigusaktid; lennu planeerimine ja teostamine. 3 (3) Kui lennundusluba on olnud kehtetu 24 kuni 48 kuud, peab taotleja selle uuendamiseks sooritama kontroll-lennu ühtsete lennundusnõuete (JAR-FCL 1) kohaselt ja eksamid järgmistes ainetes: 1 1) lennundusõigusaktid; 2 2) lennu planeerimine ja teostamine; 3 3) navigatsioon; 4 4) meteoroloogia; 5 5) õhusõiduki käitamine. Kui lennundusluba on olnud kehtetu 24 kuni 48 kuud, peab taotleja selle uuendamiseks sooritama kontroll-lennu ühtsete lennundusnõuete (JAR-FCL 1) kohaselt ja eksamid järgmistes ainetes: lennundusõigusaktid; lennu planeerimine ja teostamine; navigatsioon; meteoroloogia; õhusõiduki käitamine. 4 (4) Kui lennundusluba on olnud kehtetu üle 48 kuu, peab selle uuendamiseks läbima ühtsetele lennundusnõuetele (JAR-FCL 1) vastava teooriakursuse, sooritama kontroll-lennu ühtsete lennundusnõuete (JAR-FCL 1) kohaselt ja eksamid järgmistes ainetes: 1 1) lennundusõigusaktid; 2 2) õhusõiduki üldehitus; 3 3) aerodünaamika; 4 4) lennu planeerimine ja teostamine; 5 5) navigatsioon; 6 6) meteoroloogia; 7 7) õhusõiduki käitamine; 8 8) inimfaktor ja sellest tulenevad piirangud; 9 9) lennundusraadioside. Kui lennundusluba on olnud kehtetu üle 48 kuu, peab selle uuendamiseks läbima ühtsetele lennundusnõuetele (JAR-FCL 1) vastava teooriakursuse, sooritama kontroll-lennu ühtsete lennundusnõuete (JAR-FCL 1) kohaselt ja eksamid järgmistes ainetes: lennundusõigusaktid; õhusõiduki üldehitus; aerodünaamika; lennu planeerimine ja teostamine; navigatsioon; meteoroloogia; õhusõiduki käitamine; inimfaktor ja sellest tulenevad piirangud; lennundusraadioside.",
      "rdfs:label": {
        "@value": "Reg_162543_Par_13 (redaktsioon 162543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162543",
      "estleg:sourceAct": "Lennundusspetsialistide vanusele ja kvalifikatsioonile, nende koolitusele ja eksamineerimisele esitatavad nõuded ning lennundusspetsialistidele lennunduslubade väljaandmise ja välisriikides väljaantud lennunduslubade tunnustamise eeskiri",
      "estleg:provisionRef": "Reg_162543 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162543_Map_2026"
      }
    },
