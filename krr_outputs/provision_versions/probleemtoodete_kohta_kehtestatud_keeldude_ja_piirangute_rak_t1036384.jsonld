      "estleg:sourceAct": "Probleemtoodete kohta kehtestatud keeldude ja piirangute rakendamise tähtajad ning probleemtoodetes ohtlike ainete sisalduse piirnormid",
      "estleg:provisionRef": "Reg_1036384 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036384_Map"
      }
    },
