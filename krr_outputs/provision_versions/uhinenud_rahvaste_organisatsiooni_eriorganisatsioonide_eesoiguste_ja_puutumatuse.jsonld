      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ühinenud Rahvaste Organisatsiooni eriorganisatsioonide eesõiguste ja puutumatuse konventsiooni Eesti Vabariigi suhtes kohaldatavate lisade määramise ja parandatud lisade heakskiitmise seadus (1 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ühinenud Rahvaste Organisatsiooni eriorganisatsioonide eesõiguste ja puutumatuse konventsiooni Eesti Vabariigi suhtes kohaldatavate lisade määramise ja parandatud lisade heakskiitmise seadus"
    },
    {
      "@id": "estleg:UROEEPKEVSKL_Par_1_v12951263",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UROEEPKEVSKL_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": ", mis on vastu võetud 1947. aasta 21. novembril New Yorgis, XI artikli 43. jao alusel deklareerida, et Eesti Vabariik kohaldab konventsiooni järgmiste ÜRO eriorganisatsioonide suhtes, arvestades neid käsitlevates konventsiooni lisades sätestatud erisusi: Rahvusvaheline Tööorganisatsioon (I lisa); ÜRO Toidu- ja Põllumajandusorganisatsioon (II lisa); Rahvusvaheline Tsiviillennunduse Organisatsioon (III lisa); ÜRO Hariduse, Teaduse ja Kultuuri Organisatsioon (IV lisa); Rahvusvaheline Valuutafond (V lisa); Rahvusvaheline Rekonstruktsiooni- ja Arengupank (VI lisa); Maailma Terviseorganisatsioon (VII lisa); Ülemaailmne Postiliit (VIII lisa); Rahvusvaheline Telekommunikatsiooniliit (IX lisa); Maailma Meteoroloogiaorganisatsioon (XI lisa); Rahvusvaheline Mereorganisatsioon (XII lisa); Rahvusvaheline Rahanduskorporatsioon (XIII lisa); Maailma Intellektuaalse Omandi Organisatsioon (XV lisa).",
      "rdfs:label": {
        "@value": "UROEEPKEVSKL_Par_1 (redaktsioon 12951263)",
        "@language": "et"
      },
