      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Muuseumisse hoiule võetud vallasmälestise õigustatud isikule tagastamisest teatab muuseumide andmekoguga liitunud muuseum Muinsuskaitseametile.",
      "rdfs:label": {
        "@value": "MUUSEU_Par_14 (redaktsioon 110072013001)",
        "@language": "et"
      },
