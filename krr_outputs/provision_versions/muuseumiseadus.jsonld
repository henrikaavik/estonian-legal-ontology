    {
      "@id": "estleg:MUUSEU_Par_38_v110072013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MUUSEU_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2013. aasta 15. juulil. (2) Käesoleva seaduse § 20 lõike 3 punktid 1, 2, 4 ja 5 ning § 35 jõustuvad 2014. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "MUUSEU_Par_38 (redaktsioon 110072013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072013001",
      "estleg:supersededByVersion": {
