      "estleg:sourceAct": "Tsiviilkohtumenetluse seadustiku ja täitemenetluse seadustiku rakendamise seadus",
      "estleg:provisionRef": "TsMSRS § 4_4",
      "estleg:partOfAct": {
        "@id": "estleg:TsMSRS_Map"
      }
    },
    {
      "@id": "estleg:TsMSRS_Par_4_5_v121062014063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TsMSRS_Par_4_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täitemenetluse seadustiku § 231 lõikes 2 sätestatud nõuet infosüsteemi kasutamise kohta rakendatakse 2015. aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "TsMSRS_Par_4_5 (redaktsioon 121062014063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014063",
