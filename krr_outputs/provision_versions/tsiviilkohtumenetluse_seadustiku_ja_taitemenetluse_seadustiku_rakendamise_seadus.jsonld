        "@id": "estleg:TsMSRS_Par_100"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus korraldab tsiviilkohtumenetluse seadustiku tervikteksti avaldamise Riigi Teatajas kahe kuu jooksul pärast käesoleva seaduse väljakuulutamist.",
      "rdfs:label": {
        "@value": "TsMSRS_Par_100 (redaktsioon 919178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "919178",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/919178",
      "estleg:sourceAct": "Tsiviilkohtumenetluse seadustiku ja täitemenetluse seadustiku rakendamise seadus",
      "estleg:provisionRef": "TsMSRS § 100",
      "estleg:partOfAct": {
        "@id": "estleg:TsMSRS_Map"
      }
    },
    {
      "@id": "estleg:TsMSRS_Par_101_v919178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TsMSRS_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2006. aasta 1. jaanuaril. (2) Käesoleva seaduse § 26 punkt 3, § 32 punktid 1 ja 2, §-d 36, 50 ja 65 jõustuvad kümnendal päeval pärast Riigi Teatajas avaldamist. Lugeda RT I 2005, 39, 308 avaldatud \"Tsiviilkohtumenetluse seadustiku ja täitemenetluse seadustiku rakendamise seaduse\" § 53 punktiga 10 \"Mittetulundusühingute seaduse\" §-s 52 täiendamisele kuuluva 3. lõike teises lauses 'likivdeerimiseks' asemel õigeks 'likvideerimiseks'. Alus: \"Riigi Teataja seaduse\" § 17 lõige 3 ja lõike 3 1 punkt 2 ning Riigikogu õiguskomisjoni taotlus 27.07.2007 nr 482.",
      "rdfs:label": {
        "@value": "TsMSRS_Par_101 (redaktsioon 919178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "919178",
      "estleg:supersededByVersion": {
        "@id": "estleg:TsMSRS_Par_101_v993170"
      },
      "estleg:versionValidTo": {
        "@value": "2006-02-03",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/919178",
      "estleg:sourceAct": "Tsiviilkohtumenetluse seadustiku ja täitemenetluse seadustiku rakendamise seadus",
      "estleg:provisionRef": "TsMSRS § 101",
      "estleg:partOfAct": {
        "@id": "estleg:TsMSRS_Map"
      }
    },
    {
      "@id": "estleg:TsMSRS_Par_101_v993170",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TsMSRS_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-02-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2006. aasta 1. jaanuaril. (2) Käesoleva seaduse § 26 punkt 3, § 32 punktid 1 ja 2, §-d 36, 50 ja 65 jõustuvad kümnendal päeval pärast Riigi Teatajas avaldamist. Õiend Algtekst, tervikteksti põhjal uue tervikteksti versiooni koostamisel jäetakse teiste aktide muutmise ja kehtetuks tunnistamise sätted terviktekstist välja.",
      "rdfs:label": {
        "@value": "TsMSRS_Par_101 (redaktsioon 993170)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "993170",
