      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tsiviilkohtumenetluse seadustiku § 462 lõiget 1 kohaldatakse 2006. aasta 1. jaanuaril või hiljem jõustunud kohtulahendi suhtes.",
      "rdfs:label": {
        "@value": "TsMSRS_Par_4_6 (redaktsioon 119032019027)",
        "@language": "et"
      },
