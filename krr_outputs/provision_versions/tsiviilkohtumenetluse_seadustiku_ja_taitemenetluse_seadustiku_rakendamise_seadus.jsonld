      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/993170",
      "estleg:sourceAct": "Tsiviilkohtumenetluse seadustiku ja täitemenetluse seadustiku rakendamise seadus",
      "estleg:provisionRef": "TsMSRS § 101",
      "estleg:partOfAct": {
        "@id": "estleg:TsMSRS_Map"
      }
    },
    {
      "@id": "estleg:TsMSRS_Par_101_v12769825",
