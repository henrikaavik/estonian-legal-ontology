      },
      "estleg:versionValidTo": {
        "@value": "2015-01-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062012055",
      "estleg:sourceAct": "Tsiviilkohtumenetluse seadustiku ja täitemenetluse seadustiku rakendamise seadus",
      "estleg:provisionRef": "TsMSRS § 2_2",
      "estleg:partOfAct": {
        "@id": "estleg:TsMSRS_Map"
      }
    },
    {
      "@id": "estleg:TsMSRS_Par_2_2_v131122014019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TsMSRS_Par_2_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mitte kauem kui 2015. aasta 1. jaanuarini kestva üleminekuaja infosüsteemi kaudu dokumentide kättetoimetamise ja kättesaadavaks tegemise rakendamisele võib kehtestada määrusega. (2) Mitte kauem kui 2015. aasta 1. jaanuarini kestva üleminekuaja kohtuotsuste elektrooniliselt vormistamise rakendamisele võib kehtestada määrusega. Üleminekuaja kehtestamise korral võib kohus kuni üleminekuaja lõppemiseni otsuse vormistada ja allkirjastada paberil.",
      "rdfs:label": {
        "@value": "TsMSRS_Par_2_2 (redaktsioon 131122014019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122014019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122014019",
      "estleg:sourceAct": "Tsiviilkohtumenetluse seadustiku ja täitemenetluse seadustiku rakendamise seadus",
      "estleg:provisionRef": "TsMSRS § 2_2",
      "estleg:partOfAct": {
        "@id": "estleg:TsMSRS_Map"
      }
    },
    {
      "@id": "estleg:TsMSRS_Par_2_3_v129062012055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
