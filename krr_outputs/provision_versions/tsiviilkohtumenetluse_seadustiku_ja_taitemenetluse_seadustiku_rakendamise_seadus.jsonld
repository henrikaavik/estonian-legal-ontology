    },
    {
      "@id": "estleg:TsMSRS_Par_7_v919178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TsMSRS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist esitatud kohtuvea parandamise avaldus ja teistmisavaldus vaadatakse läbi seni kehtinud tsiviilkohtumenetluse seadustiku kohaselt.",
      "rdfs:label": {
        "@value": "TsMSRS_Par_7 (redaktsioon 919178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "919178",
