        "@id": "estleg:TsMSRS_Map"
      }
    },
    {
      "@id": "estleg:TsMSRS_Par_11_7_v110022023005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TsMSRS_Par_11_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuasja toimikutele, mis on alustatud enne 2023. aasta 1. aprilli, kohaldatakse kuni 2023. aasta 31. märtsini kehtinud regulatsiooni.",
      "rdfs:label": {
        "@value": "TsMSRS_Par_11_7 (redaktsioon 110022023005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110022023005",
