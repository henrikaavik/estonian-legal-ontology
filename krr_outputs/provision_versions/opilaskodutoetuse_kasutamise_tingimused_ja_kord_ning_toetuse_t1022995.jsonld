    {
      "@id": "estleg:Reg_1022995_Par_2_v1022995",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022995_Par_2"
