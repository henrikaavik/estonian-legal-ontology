      "estleg:provisionRef": "Reg_1028704 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028704_Map"
      }
    },
    {
      "@id": "estleg:Reg_1028704_Par_3_v1028704",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028704_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1028704_Par_3 (redaktsioon 1028704)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028704",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028704",
      "estleg:sourceAct": "Erumäe maastikukaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1028704 § 3",
      "estleg:partOfAct": {
