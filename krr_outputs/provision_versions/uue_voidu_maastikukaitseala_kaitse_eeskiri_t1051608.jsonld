      "estleg:provisionRef": "Reg_1051608 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1051608_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1051608_Par_12_v1051608",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
