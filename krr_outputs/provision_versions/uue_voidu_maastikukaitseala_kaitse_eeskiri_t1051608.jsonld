    {
      "@id": "estleg:Reg_1051608_Par_4_v1051608",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051608_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas3 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndi piirde kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas3 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndi piirde kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1051608_Par_4 (redaktsioon 1051608)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051608",
