        "@id": "estleg:Reg_1057574_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega sätestatakse nõuded joobeseisundis isiku kainenema toimetamise protokolli (edaspidi protokoll) sisule ja kehtestatakse protokolli vorm, mis on esitatud käesoleva määruse lisas. Määrusega sätestatakse nõuded joobeseisundis isiku kainenema toimetamise protokolli (edaspidi protokoll) sisule ja kehtestatakse protokolli vorm, mis on esitatud käesoleva määruse lisas.",
      "rdfs:label": {
        "@value": "Reg_1057574_Par_1 (redaktsioon 1057574)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057574",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057574",
      "estleg:sourceAct": "Joobeseisundis isiku kainenema toimetamise protokolli vorm ja sellele esitatavad nõuded",
      "estleg:provisionRef": "Reg_1057574 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057574_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057574_Par_2_v1057574",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057574_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Protokolli kantakse järgmised andmed: 1 1) joobeseisundis isiku kainenema toimetamise andmed; 2 2) joobeseisundis isiku arestimajas, arestikambris või vanglas vastuvõtmise ja kinnipidamise (edaspidi koos kainenema paigutamine) andmed; 3 3) kainenenud isiku vabastamise andmed. Protokolli kantakse järgmised andmed: joobeseisundis isiku kainenema toimetamise andmed; joobeseisundis isiku arestimajas, arestikambris või vanglas vastuvõtmise ja kinnipidamise (edaspidi koos kainenema paigutamine) andmed; kainenenud isiku vabastamise andmed.",
      "rdfs:label": {
        "@value": "Reg_1057574_Par_2 (redaktsioon 1057574)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057574",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057574",
      "estleg:sourceAct": "Joobeseisundis isiku kainenema toimetamise protokolli vorm ja sellele esitatavad nõuded",
      "estleg:provisionRef": "Reg_1057574 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057574_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057574_Par_3_v1057574",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057574_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Joobeseisundis isiku kainenema toimetamise kohta kantakse protokolli järgmised andmed: 1 1) protokolli koostamise kuupäev, kellaaeg ja koht, selle asutuse nimetus ja aadress, kelle nimel protokoll koostatakse, ning protokolli koostaja nimi, ametinimetus ja allkiri; 2 2) joobeseisundis isiku nimi, isikukood või selle puudumise korral sünniaeg ja elukoht; 3 3) märge selle kohta, kas joobeseisundis isik tuvastati dokumendi alusel, märkides sellisel juhul selle nimetuse ja numbri, või andmekogu andmete põhjal või muul viisil; 4 4) kainenema toimetaja nimi ja ametinimetus ning aeg ja koht, millal ja kust joobeseisundis isik kainenema toimetati; 5 5) kainenema toimetamise õiguslik alus; 6 6) indikaatorvahendi või tõendusliku alkomeetri näit koos kasutatud mõõteriista margi ja seerianumbriga või joobeseisundile viitavad tunnused; 7 7) vahetu sunni kohaldamise korral selle kohaldamise põhjus, vahetu sunni vahend ja selle kasutamise kestus ning vahetu sunni kohaldaja nimi ja ametinimetus; 8 8) tervishoiutöötaja arvamus joobeseisundis isiku terviseseisundi kohta, kui tervishoiutöötaja kutsuti isiku terviseseisundit hindama. Joobeseisundis isiku kainenema toimetamise kohta kantakse protokolli järgmised andmed: protokolli koostamise kuupäev, kellaaeg ja koht, selle asutuse nimetus ja aadress, kelle nimel protokoll koostatakse, ning protokolli koostaja nimi, ametinimetus ja allkiri; joobeseisundis isiku nimi, isikukood või selle puudumise korral sünniaeg ja elukoht; märge selle kohta, kas joobeseisundis isik tuvastati dokumendi alusel, märkides sellisel juhul selle nimetuse ja numbri, või andmekogu andmete põhjal või muul viisil; kainenema toimetaja nimi ja ametinimetus ning aeg ja koht, millal ja kust joobeseisundis isik kainenema toimetati; kainenema toimetamise õiguslik alus; indikaatorvahendi või tõendusliku alkomeetri näit koos kasutatud mõõteriista margi ja seerianumbriga või joobeseisundile viitavad tunnused; vahetu sunni kohaldamise korral selle kohaldamise põhjus, vahetu sunni vahend ja selle kasutamise kestus ning vahetu sunni kohaldaja nimi ja ametinimetus; tervishoiutöötaja arvamus joobeseisundis isiku terviseseisundi kohta, kui tervishoiutöötaja kutsuti isiku terviseseisundit hindama.",
      "rdfs:label": {
        "@value": "Reg_1057574_Par_3 (redaktsioon 1057574)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057574",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057574",
      "estleg:sourceAct": "Joobeseisundis isiku kainenema toimetamise protokolli vorm ja sellele esitatavad nõuded",
      "estleg:provisionRef": "Reg_1057574 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057574_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057574_Par_4_v1057574",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057574_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Joobeseisundis isiku kainenema paigutamise kohta kantakse protokolli järgmised andmed: 1 1) kainenema paigutamise aeg ning kainenema paigutaja nimi ja ametinimetus; 2 2) joobeseisundis isiku vaatlemise tulemus; 3 3) andmed joobeseisundis isikult turvakontrollis ja asjade läbivaatuses hoiule võetud raha, väärtasja, dokumendi ja ravimi kohta ning muu asja kohta, mis võib ohustada isikut ennast või teist isikut, ning andmed nende hoidmise koha kohta; 4 4) vahetu sunni kohaldamise korral selle kohaldamise põhjus, vahetu sunni vahend ja selle kasutamise kestus ning vahetu sunni kohaldaja nimi ja ametinimetus. Joobeseisundis isiku kainenema paigutamise kohta kantakse protokolli järgmised andmed: kainenema paigutamise aeg ning kainenema paigutaja nimi ja ametinimetus; joobeseisundis isiku vaatlemise tulemus; andmed joobeseisundis isikult turvakontrollis ja asjade läbivaatuses hoiule võetud raha, väärtasja, dokumendi ja ravimi kohta ning muu asja kohta, mis võib ohustada isikut ennast või teist isikut, ning andmed nende hoidmise koha kohta; vahetu sunni kohaldamise korral selle kohaldamise põhjus, vahetu sunni vahend ja selle kasutamise kestus ning vahetu sunni kohaldaja nimi ja ametinimetus.",
      "rdfs:label": {
        "@value": "Reg_1057574_Par_4 (redaktsioon 1057574)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057574",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057574",
      "estleg:sourceAct": "Joobeseisundis isiku kainenema toimetamise protokolli vorm ja sellele esitatavad nõuded",
      "estleg:provisionRef": "Reg_1057574 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057574_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057574_Par_5_v1057574",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057574_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kainenenud isiku vabastamise kohta kantakse protokolli järgmised andmed: 1 1) kainenenud isiku vabastamise kuupäev ja kellaaeg; 2 2) märge selle kohta, et kainenenud isikule on tagastatud temalt hoiule võetud asjad, või tagastamata asja nimetus ja tagastamata jätmise alus; 3 3) kainenemisest vabastaja nimi ja ametinimetus; 4 4) kainenenud isiku avaldused ja taotlused. Kainenenud isiku vabastamise kohta kantakse protokolli järgmised andmed: kainenenud isiku vabastamise kuupäev ja kellaaeg; märge selle kohta, et kainenenud isikule on tagastatud temalt hoiule võetud asjad, või tagastamata asja nimetus ja tagastamata jätmise alus; kainenemisest vabastaja nimi ja ametinimetus; kainenenud isiku avaldused ja taotlused.",
      "rdfs:label": {
        "@value": "Reg_1057574_Par_5 (redaktsioon 1057574)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057574",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057574",
      "estleg:sourceAct": "Joobeseisundis isiku kainenema toimetamise protokolli vorm ja sellele esitatavad nõuded",
      "estleg:provisionRef": "Reg_1057574 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057574_Map"
      }
    },
