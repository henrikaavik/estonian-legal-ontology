      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Joobeseisundis isiku kainenema toimetamise protokolli vorm ja sellele esitatavad nõuded (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Joobeseisundis isiku kainenema toimetamise protokolli vorm ja sellele esitatavad nõuded"
    },
    {
      "@id": "estleg:Reg_1057574_Par_1_v1057574",
      "@type": [
