    {
      "@id": "estleg:Reg_1029942_Par_5_v1029942",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029942_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Relvaloa andmisest või selle andmisest keeldumisest teatatakse taotlejale kirjalikult kümne päeva jooksul otsuse tegemisest arvates. Teate koos otsusega võib kätte toimetada taotluses märgitud aadressil lihtkirjaga või taotluses märgitud e-posti aadressil. Relvaloa andmisest või selle andmisest keeldumisest teatatakse taotlejale kirjalikult kümne päeva jooksul otsuse tegemisest arvates. Teate koos otsusega võib kätte toimetada taotluses märgitud aadressil lihtkirjaga või taotluses märgitud e-posti aadressil.",
      "rdfs:label": {
