      },
      "estleg:versionText": "Soetamislubade valmistamist, jaotamist ja nende üle arvestuse pidamist korraldab Kaitseliidu ülem. Soetamislubade valmistamist, jaotamist ja nende üle arvestuse pidamist korraldab Kaitseliidu ülem.",
      "rdfs:label": {
        "@value": "Reg_1029942_Par_11 (redaktsioon 1029942)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029942",
