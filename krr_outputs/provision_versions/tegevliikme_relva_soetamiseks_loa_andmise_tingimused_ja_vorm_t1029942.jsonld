    {
      "@id": "estleg:Reg_1029942_Par_9_v1029942",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029942_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Soetamisluba on ühtse kujundusega, kolmest osast koosnev A4-formaadis dokument. Soetamisloa A-, B- ja C-osa on helerohelist värvi ja Kaitseliidu vappi kujutava turvamustriga. Soetamisluba on ühtse kujundusega, kolmest osast koosnev A4-formaadis dokument. Soetamisloa A-, B- ja C-osa on helerohelist värvi ja Kaitseliidu vappi kujutava turvamustriga. 2 (2) Soetamisloa plangid on nummerdatud. Plangi number on trükitud värviga, mis tekitab ümber musta numbri kujutise punase ringi, mis on nähtav ka trükise teisel küljel. Soetamisloa plangid on nummerdatud. Plangi number on trükitud värviga, mis tekitab ümber musta numbri kujutise punase ringi, mis on nähtav ka trükise teisel küljel. 3 (3) Soetamisloa vorm on toodud käesoleva määruse lisas. Soetamisloa vorm on toodud käesoleva määruse lisas.",
      "rdfs:label": {
        "@value": "Reg_1029942_Par_9 (redaktsioon 1029942)",
        "@language": "et"
