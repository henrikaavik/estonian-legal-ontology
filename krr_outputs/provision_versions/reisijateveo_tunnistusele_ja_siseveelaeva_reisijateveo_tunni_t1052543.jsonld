  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_reisijateveo_tunnistusele_ja_siseveelaeva_reisijateveo_tunni_t1052543_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Reisijateveo tunnistusele ja siseveelaeva reisijateveo tunnistusele kantavate andmete loetelu (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Reisijateveo tunnistusele ja siseveelaeva reisijateveo tunnistusele kantavate andmete loetelu"
    },
    {
      "@id": "estleg:Reg_1052543_Par_1_v1052543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052543_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-09-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Reisijateveo tunnistusele kantakse järgmised andmed: 1 1) laeva nimi; 2 2) registrinumber; 3 3) tunnusnumber või kutsung; 4 4) kodusadam; 5 5) kogumahutavus; 6 6) laevapere suurus; 7 7) lubatud reisijate arv; 8 8) kinnitus, et laev on läbinud meresõiduohutuse seaduse kohase ülevaatuse ja on tunnistatud merekõlblikuks; 9 9) lubatud sõidupiirkond; 10 10) märkused piirangute ja lisatingimuste kohta; 11 11) tunnistuse kehtivusaeg; 12 12) märge, kas tunnistusele on lisatud varustuse loetelu; 13 13) märge eripüstuvusnõuetele vastavuse kohta, kui see on laevale rakendatav; 14 14) tunnistuse väljastaja; 15 15) väljaandmise koht; 16 16) väljaandmise kuupäev; 17 17) tunnistuse number; 18 18) volitatud ametiisiku allkiri; 19 19) pitsati jäljend, elektroonilise tunnistuse puhul unikaalne tuvastusnumber või QR-kood. Reisijateveo tunnistusele kantakse järgmised andmed: laeva nimi; registrinumber; tunnusnumber või kutsung; kodusadam; kogumahutavus; laevapere suurus; lubatud reisijate arv; kinnitus, et laev on läbinud meresõiduohutuse seaduse kohase ülevaatuse ja on tunnistatud merekõlblikuks; lubatud sõidupiirkond; märkused piirangute ja lisatingimuste kohta; tunnistuse kehtivusaeg; märge, kas tunnistusele on lisatud varustuse loetelu; märge eripüstuvusnõuetele vastavuse kohta, kui see on laevale rakendatav; tunnistuse väljastaja; väljaandmise koht; väljaandmise kuupäev; tunnistuse number; volitatud ametiisiku allkiri; pitsati jäljend, elektroonilise tunnistuse puhul unikaalne tuvastusnumber või QR-kood. 2 (2) Reisijateveo tunnistuse iga-aastase ülevaatuse kohta kantakse tunnistusele järgmised andmed: 1 1) kinnitus, et laev on läbinud ülevaatuse ja tunnistus kehtib; 2 2) järgmise ülevaatuse ajavahemik; 3 3) väljaandmise koht; 4 4) väljaandmise kuupäev; 5 5) volitatud ametiisiku allkiri; 6 6) tempel, elektroonilise tunnistuse puhul unikaalne tuvastusnumber või QR-kood. Reisijateveo tunnistuse iga-aastase ülevaatuse kohta kantakse tunnistusele järgmised andmed: kinnitus, et laev on läbinud ülevaatuse ja tunnistus kehtib; järgmise ülevaatuse ajavahemik; väljaandmise koht; väljaandmise kuupäev; volitatud ametiisiku allkiri; tempel, elektroonilise tunnistuse puhul unikaalne tuvastusnumber või QR-kood.",
      "rdfs:label": {
        "@value": "Reg_1052543_Par_1 (redaktsioon 1052543)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052543",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052543",
      "estleg:sourceAct": "Reisijateveo tunnistusele ja siseveelaeva reisijateveo tunnistusele kantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1052543 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052543_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1052543_Par_2_v1052543",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052543_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-09-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Siseveelaeva reisijateveo tunnistusele kantakse järgmised andmed: 1 1) laeva nimi; 2 2) registrinumber; 3 3) reederi nimi ja registrikood; 4 4) laevapere suurus; 5 5) lubatud reisijate arv; 6 6) kinnitus, et laev on läbinud meresõiduohutuse seaduse kohase ülevaatuse ja on tunnistatud sõidukõlblikuks; 7 7) lubatud sõidupiirkond; 8 8) märkused piirangute ja lisatingimuste kohta; 9 9) tunnistuse kehtivusaeg; 10 10) märge, kas tunnistuse juurde kuulub varustuse loetelu; 11 11) tunnistuse väljastaja; 12 12) väljaandmise koht; 13 13) väljaandmise kuupäev; 14 14) tunnistuse number; 15 15) volitatud ametiisiku allkiri; 16 16) pitsati jäljend, elektroonilise tunnistuse puhul unikaalne tuvastusnumber või QR-kood. Siseveelaeva reisijateveo tunnistusele kantakse järgmised andmed: laeva nimi; registrinumber; reederi nimi ja registrikood; laevapere suurus; lubatud reisijate arv; kinnitus, et laev on läbinud meresõiduohutuse seaduse kohase ülevaatuse ja on tunnistatud sõidukõlblikuks; lubatud sõidupiirkond; märkused piirangute ja lisatingimuste kohta; tunnistuse kehtivusaeg; märge, kas tunnistuse juurde kuulub varustuse loetelu; tunnistuse väljastaja; väljaandmise koht; väljaandmise kuupäev; tunnistuse number; volitatud ametiisiku allkiri; pitsati jäljend, elektroonilise tunnistuse puhul unikaalne tuvastusnumber või QR-kood. 2 (2) Siseveelaeva reisijateveo tunnistuse iga-aastase ülevaatuse kohta kantakse tunnistusele § 1 lõikes 2 nimetatud andmed. Siseveelaeva reisijateveo tunnistuse iga-aastase ülevaatuse kohta kantakse tunnistusele § 1 lõikes 2 nimetatud andmed.",
