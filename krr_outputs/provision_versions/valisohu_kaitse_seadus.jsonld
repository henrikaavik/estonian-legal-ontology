      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "VKS_Par_60 (redaktsioon 12798057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12798057",
