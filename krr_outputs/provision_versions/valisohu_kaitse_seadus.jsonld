      }
    },
    {
      "@id": "estleg:VÕKS_Par_18_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VÕKS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui saastatuse taseme mõõtmise andmed on olemas lühema ajavahemiku kohta kui hindamisele eelnenud viis aastat, võib õhu kvaliteedi hindamisel kombineerida pistelise mõõtmise tulemusi modelleerimistulemustega.",
      "rdfs:label": {
        "@value": "VÕKS_Par_18 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
