        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus kehtestab määrusega osoonikihti kahandavate ainete nimekirja ja nendele ainetele esitatavad nõuded.",
      "rdfs:label": {
        "@value": "VKS_Par_110 (redaktsioon 756554)",
