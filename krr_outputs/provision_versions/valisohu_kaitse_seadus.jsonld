      "estleg:versionRedactionId": "105072011026"
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_19_v22408",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paikse saasteallika valdaja peab tagama, ettemavalduses olevast saasteallikast välisõhku eralduvad saasteainete kogused ei põhjustaks piirkonna saastetaseme piirväärtuse ületamist. (2) Paikse saasteallika valdaja peab kavandama meetmeid välisõhku eralduvate saasteainete koguste piiramiseks, et vähendada saastetaset ebasoodsate ilmastikutingimuste puhul. Korralduse saasteainete eraldumise piiramiseks annab valla- või linnavalitsus.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_19 (redaktsioon 22408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22408",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_19_v187150"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_19_v187150",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paikse saasteallika valdaja peab tagama, et tema valduses olevast saasteallikast välisõhku eralduvad saasteainete kogused ei põhjustaks piirkonna saastetaseme piirväärtuse ületamist. (2) Paikse saasteallika valdaja peab kavandama meetmeid välisõhku eralduvate saasteainete koguste piiramiseks, et vähendada saastetaset ebasoodsate ilmastikutingimuste puhul. Korralduse saasteainete eraldumise piiramiseks annab valla- või linnavalitsus.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_19 (redaktsioon 187150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "187150",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_19_v191969"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
