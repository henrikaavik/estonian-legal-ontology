      },
      "estleg:versionValidTo": {
        "@value": "2014-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_111_v108072014024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_111"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osoonikihti kahandavaid aineid sisaldavate või nendel ainetel põhinevate toodete, seadmete või mahutite käitlemisega tegeleval isikul peavad olema vajalikud teadmised ja oskused, mille olemasolu tõendab erialast väljaõpet kinnitav dokument. (2) Käesoleva paragrahvi lõikes 1 nimetatud isiku pädevusnõuded kehtestab määrusega. (3) Keskkonnainspektsioon kontrollib üheaegselt seadme kontrollimisega käesoleva paragrahvi lõikes 1 nimetatud isiku pädevust tõendava dokumendi olemasolu.",
      "rdfs:label": {
        "@value": "VKS_Par_111 (redaktsioon 108072014024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072014024"
    },
    {
      "@id": "estleg:VKS_Par_112_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rohkem kui kolm kilogrammi osoonikihti kahandavaid aineid sisaldava paikse seadme valdaja või omanik kontrollib vähemalt kord aastas, et seadmes ei oleks nende ainete leket. Keskkonnainspektsioon kontrollib seadmeid pisteliselt.",
      "rdfs:label": {
        "@value": "VKS_Par_112 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_112_v12798057"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_112_v12798057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osoonikihti kahandavaid aineid sisaldava paikse seadme valdaja või omanik kontrollib, et seadmes ei oleks nende ainete leket, kui seadmes sisalduvate ainete kogus on: rohkem kui kolm kilogrammi – vähemalt üks kord aastas; rohkem kui 30 kilogrammi – vähemalt üks kord kvartalis; rohkem kui 300 kilogrammi – vähemalt üks kord kuus. (2) Keskkonnainspektsioon kontrollib seadmeid pisteliselt.",
      "rdfs:label": {
        "@value": "VKS_Par_112 (redaktsioon 12798057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12798057",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_112_v104072012009"
      },
      "estleg:versionValidTo": {
        "@value": "2012-07-14",
        "@type": "xsd:date"
      }
    },
