    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_5_v22408",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saasteallikas on saasteaineid välisõhku suunav või eraldav objekt. Saasteallikad jagunevad paikseteks ja liikuvateks saasteallikateks. (2) Paikne saasteallikas on püsiva asukohaga saasteallikas. (3) Liikuv saasteallikas on mootorsõiduk või liikurmasin, mis kasutab gaasilist, vedelat või tahket kütust.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_5 (redaktsioon 22408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22408",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_5_v756554"
      },
      "estleg:versionValidTo": {
        "@value": "2004-09-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_5_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisõhu füüsikaline mõjutamine on mõjutamine müra, ioniseeriva ning ioniseeriva toimeta kiirguse, infra- ja ultraheliga.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_5 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554"
    },
    {
      "@id": "estleg:VKS_Par_50_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisõhu nõutava kvaliteedi tagamiseks koostab keskkonnateenistus saasteainete heitkoguste vähendamise tegevuskava piirkonna kohta, kus välisõhu saastatuse tase sõltub mitme saasteallika koosmõjust, kui välisõhu saastatuse tase ületab või tõenäoliselt ületab ühe või mitme saasteaine suhtes kehtestatud saastatuse taseme ühe tunni keskmist piirväärtust ja saastetaluvuse piirmäära summaarselt. (2) Tegevuskava sisule esitatavad nõuded ja koostamise korra kehtestab keskkonnaminister määrusega. (3) Piirkonna tegevuskava koostamisel lähtub keskkonnateenistus saasteallikate valdajate esitatud saasteainete heitkoguste vähendamise tegevuskavadest. (4) Keskkonnateenistus avalikustab piirkonna saasteainete heitkoguste vähendamise tegevuskava oma veebilehel. (5) Piirkonnas, kus saasteaine sisaldus välisõhus ületab saastatuse taseme ühe tunni keskmist piirväärtust, kehtivad käesoleva paragrahvi lõikes 1 nimetatud piirkonnale sätestatud nõuded, kui saasteaine kohta ei ole saastetaluvuse piirmäära kehtestatud.",
      "rdfs:label": {
        "@value": "VKS_Par_50 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_50_v874386"
      },
      "estleg:versionValidTo": {
        "@value": "2005-04-02",
        "@type": "xsd:date"
      }
    },
