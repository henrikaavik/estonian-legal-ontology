    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_6_v22408",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui saasteainete eraldumist välisõhku reguleeritakse rahvusvaheliste lepingutega, kehtestatakse Vabariigi Valitsuse määrusega nendele saasteainetele maakonna paiksetest saasteallikatest lubatud summaarne heitkogus. (2) Inimese tervise ja keskkonna kaitse huvides võib valla- ja linnavalitsus saasteainete hajumiseks ebasoodsate ilmastikutingimuste korral: liiklusmärkidega piirata mootorsõidukite ja liikurmasinate liikumist ja kasutamist, välja arvatud eritalituse sõidukid; piirata paiksete saasteallikate tööd oma haldusterritooriumi teatud piirkondades vastavalt välisõhu saasteloas märgitud tingimustele. (3) Valla- ja linnavalitsus võib ajutiselt või alaliselt piirata mootorsõidukite ja liikurmasinate liiklemist teatud piirkonnas, puhke- ja turismialal, vältimaks kehtestatud saastetaseme piirväärtuste ületamist.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_6 (redaktsioon 22408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22408",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_6_v756554"
      },
      "estleg:versionValidTo": {
        "@value": "2004-09-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_6_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ebasoodsad ilmastikutingimused käesoleva seaduse tähenduses on tingimused, mis soodustavad saasteainete akumuleerumist maapinnalähedases õhukihis.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_6 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_6_v12798057"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_6_v12798057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ebasoodsad ilmastikutingimused käesoleva seaduse tähenduses on maapinnalähedases õhukihis saasteainete akumuleerumist soodustavad tingimused, nagu omavahelises koostoimes temperatuuri inversioon vahetult maapinnalähedases õhukihis, vertikaalse turbulentsi puudumine ja tuulekiirus null kuni kaks meetrit sekundis.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_6 (redaktsioon 12798057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12798057"
    },
    {
      "@id": "estleg:VKS_Par_60_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eestis müüdavate mootorikütuste kvaliteedi ja koguste seiret korraldab ning andmeid koondab Keskkonnaministeerium.",
      "rdfs:label": {
        "@value": "VKS_Par_60 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_60_v12798057"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_60_v12798057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
