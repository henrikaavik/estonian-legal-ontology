    {
      "@id": "estleg:VKS_Par_56_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uue mootorsõiduki tootja, Eesti Vabariiki sissevedaja või müüja teavitab kasutajat mootorsõiduki kütuse erikulust ja eralduva süsinikdioksiidi heitkogusest. Kasutajale antavate andmete loetelu ja kasutaja teavitamise korra kehtestab keskkonnaminister määrusega.",
      "rdfs:label": {
        "@value": "VKS_Par_56 (redaktsioon 756554)",
