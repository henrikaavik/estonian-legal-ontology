      }
    },
    {
      "@id": "estleg:VKS_Par_121_v112072013013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_121"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Heitkoguse loa taotlus sisaldab vähemalt järgmisi andmeid: käitaja nime, äriregistrikoodi ja aadressi; tegevusala ja kasutatava tehnoloogia kirjeldust ning toor- ja lisaainete kulu, mille kasutamine võib tõenäoliselt põhjustada kasvuhoonegaaside tekkimist; eri kasvuhoonegaaside heitkoguseid saasteallikate kaupa; heidete kavandatud seiremeetmeid, sealhulgas seiremetoodikat ja -sagedust. kehtetu - (2) Heitkoguse luba sisaldab käesoleva paragrahvi lõikes 1 nimetatud teavet ja järgmisi lisaandmeid: loa andja nimetust; kehtetu - seirenõuet; aruandlusnõuet; loa kehtivusaega.",
      "rdfs:label": {
        "@value": "VKS_Par_121 (redaktsioon 112072013013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072013013"
    },
    {
      "@id": "estleg:VKS_Par_122_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käitaja esitab Keskkonnaministeeriumile kasvuhoonegaaside heitkogustega kauplemise aastaaruande, millega ta tõendab, et on kauplemiseks kasutanud kauplemisloaga määratud kasvuhoonegaaside heitkogust, mis on väljendatud süsinikdioksiidi ekvivalendina.",
      "rdfs:label": {
        "@value": "VKS_Par_122 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_122_v12798057"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_122_v12798057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käitaja esitab Keskkonnaministeeriumile iga aasta 15. jaanuariks eelnenud aasta kasvuhoonegaaside heitkogustega kauplemise aruande, milles on märgitud õhku paisatud kasvuhoonegaaside heitkogused ja kauplemiseks kasutatud heitkogused, mis peavad olema vastavuses kauplemisloas määratud kogustega. Keskkonnaministeeriumi Info- ja Tehnokeskus tõendab käitaja koostatud kasvuhoonegaaside aruandes märgitud heitkoguste määramise õigsust ja vastavust kehtivatele kauplemislubadele.",
      "rdfs:label": {
        "@value": "VKS_Par_122 (redaktsioon 12798057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12798057",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_122_v13340297"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_122_v13340297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käitaja esitab Keskkonnaministeeriumile iga aasta 15. jaanuariks eelnenud aasta kasvuhoonegaaside heitkogustega kauplemise aruande, milles on märgitud õhku paisatud kasvuhoonegaaside heitkogused ja kauplemiseks kasutatud heitkogused, mis peavad olema vastavuses kauplemisloas määratud kogustega. Aruandes märgitud heitkoguste määramise õigsust ja vastavust kehtivatele kauplemislubadele tõendab asutus, kelle määrab",
      "rdfs:label": {
        "@value": "VKS_Par_122 (redaktsioon 13340297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13340297",
      "estleg:supersededByVersion": {
