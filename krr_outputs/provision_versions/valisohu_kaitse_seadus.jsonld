        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_60_v118112010007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VKS_Par_60 (redaktsioon 118112010007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118112010007"
    },
    {
      "@id": "estleg:VKS_Par_62_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_62"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saasteainete välisõhku eraldumist vähendavad meetmed ei tohi kaasa tuua pinnase ja vee saastamist.",
      "rdfs:label": {
        "@value": "VKS_Par_62 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554"
    },
    {
      "@id": "estleg:VKS_Par_63_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_63"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpordisõlmede ning tootmis- ja teenindusobjektide kavandamisel tuleb vältida territooriume, kus ebasoodsate ilmastikutingimuste korral on välisõhku eraldunud saasteainete hajumine loodus- või tehisoludest tingitud põhjustel takistatud.",
      "rdfs:label": {
        "@value": "VKS_Par_63 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554"
    },
    {
      "@id": "estleg:VKS_Par_64_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Objekti valdaja on kohustatud rakendama abinõusid tolmu ja prahi leviku vältimiseks tema halduses olevatelt ladustamiskohtadelt, tänavatelt ja teedelt.",
      "rdfs:label": {
        "@value": "VKS_Par_64 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554"
    },
    {
      "@id": "estleg:VKS_Par_65_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootorsõiduki juht peab vältima: tolmu ja prahi levikut puistematerjalide veokilt; välisõhu saastamist töötava mootoriga seisvalt mootorsõidukilt, kui see ei ole tingitud töökorraldusest.",
      "rdfs:label": {
        "@value": "VKS_Par_65 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554"
    },
    {
      "@id": "estleg:VKS_Par_66_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Silmas pidades õhusaaste kauglevi, mis võib ületada riigipiire, ja piiriülese õhusaaste kauglevi Genfi konventsiooni (RT II 2000, 4, 25) nõudeid, on keelatud ehitada korstnaid, millest saasteained väljuvad kõrgemal kui 250 meetrit maapinnast. (2) Käitise projekteerimisel tuleb arvestada, et saasteaineid välisõhku väljutavad korstnad, ventilatsiooniavad ja -torud oleksid vähemalt viis meetrit kõrgemal saasteallikast, kuni viiekümne meetri kaugusel eluhoonetest ning oleksid täidetud käesoleva seaduse §-s 27 sätestatud nõuded. (3) Saasteainete väljumiskõrgus peab tagama saasteainete nõutava hajumise maapinnalähedases õhukihis, et vältida välisõhu saastatuse taseme piirväärtuse ületamist. (4) Saasteallikast eralduvate saasteainete maapinnalähedases õhukihis hajumise parandamiseks võib suurendada saasteainete väljumiskõrgust. (5) Saasteainete väljumiskõrguse või väljumisava läbimõõdu muutmise korral tuleb sellest teatada välisõhu saasteloa, keskkonnakompleksloa või jäätmepõletusloa andjale ja taotleda uus luba.",
      "rdfs:label": {
        "@value": "VKS_Par_66 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_66_v12798057"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_66_v12798057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Silmas pidades õhusaaste kauglevi, mis võib ületada riigipiire, ja piiriülese õhusaaste kauglevi Genfi konventsiooni (RT II 2000, 4, 25) nõudeid, on keelatud ehitada korstnaid, millest saasteained väljuvad kõrgemal kui 250 meetrit maapinnast. (2) Käitise projekteerimisel tuleb arvestada, et saasteaineid välisõhku väljutavad korstnad, ventilatsiooniavad ja -torud oleksid vähemalt viis meetrit kõrgemal saasteallikast, kuni viiekümne meetri kaugusel eluhoonetest ning oleksid täidetud käesoleva seaduse § -s 27 sätestatud nõuded. (3) Saasteainete väljumiskõrgus peab tagama saasteainete nõutava hajumise maapinnalähedases õhukihis, et vältida välisõhu saastatuse taseme piirväärtuse ületamist. (4) Saasteallikast eralduvate saasteainete maapinnalähedases õhukihis hajumise parandamiseks võib suurendada saasteainete väljumiskõrgust. (5) Saasteainete väljumiskõrguse või väljumisava läbimõõdu muutmise korral tuleb sellest teatada välisõhu saasteloa, keskkonnakompleksloa või jäätmepõletamist käsitleva jäätmeloa andjale ja taotleda uus luba.",
      "rdfs:label": {
        "@value": "VKS_Par_66 (redaktsioon 12798057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12798057",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_66_v12890004"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_66_v12890004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Silmas pidades õhusaaste kauglevi, mis võib ületada riigipiire, ja piiriülese õhusaaste kauglevi Genfi konventsiooni nõudeid, on keelatud ehitada korstnaid, millest saasteained väljuvad kõrgemal kui 250 meetrit maapinnast. (2) Käitise projekteerimisel tuleb arvestada, et saasteaineid välisõhku väljutavad korstnad, ventilatsiooniavad ja -torud oleksid vähemalt viis meetrit kõrgemal saasteallikast, kuni viiekümne meetri kaugusel eluhoonetest ning oleksid täidetud käesoleva seaduse §-s 27 sätestatud nõuded. (3) Saasteainete väljumiskõrgus peab tagama saasteainete nõutava hajumise maapinnalähedases õhukihis, et vältida välisõhu saastatuse taseme piirväärtuse ületamist. (4) Saasteallikast eralduvate saasteainete maapinnalähedases õhukihis hajumise parandamiseks võib suurendada saasteainete väljumiskõrgust. (5) Saasteainete väljumiskõrguse või väljumisava läbimõõdu muutmise korral tuleb sellest teatada välisõhu saasteloa, keskkonnakompleksloa või jäätmepõletamist käsitleva jäätmeloa andjale ja taotleda uus luba.",
      "rdfs:label": {
        "@value": "VKS_Par_66 (redaktsioon 12890004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12890004",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_66_v105072011026"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_66_v105072011026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Silmas pidades õhusaaste kauglevi, mis võib ületada riigipiire, ja piiriülese õhusaaste kauglevi Genfi konventsiooni nõudeid, on keelatud ehitada korstnaid, millest saasteained väljuvad kõrgemal kui 250 meetrit maapinnast. (2) Käitise projekteerimisel tuleb arvestada, et saasteaineid väljutavad korstnad, ventilatsiooniavad ja -torud ning muud saasteallikad oleksid paigaldatud vähemalt 50 meetri kaugusele eluhoonest ja nende kõrguse määramisel oleks tagatud käesoleva seaduse §-de 26 ja 27 alusel keskkonnaministri määrusega inimese tervise kaitseks kehtestatud välisõhu saastatuse taseme ühe tunni keskmiste piirväärtuste järgimine. (3) Saasteainete väljumiskõrgus peab tagama saasteainete nõutava hajumise maapinnalähedases õhukihis, et vältida välisõhu saastatuse taseme piirväärtuse ületamist. (4) Saasteallikast eralduvate saasteainete maapinnalähedases õhukihis hajumise parandamiseks võib suurendada saasteainete väljumiskõrgust. (5) Saasteainete väljumiskõrguse või väljumisava läbimõõdu muutmise korral tuleb sellest teatada välisõhu saasteloa, keskkonnakompleksloa või jäätmepõletamist käsitleva jäätmeloa andjale ja taotleda uus luba.",
      "rdfs:label": {
        "@value": "VKS_Par_66 (redaktsioon 105072011026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105072011026",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_66_v116052013007"
      },
      "estleg:versionValidTo": {
        "@value": "2013-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_66_v116052013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Silmas pidades õhusaaste kauglevi, mis võib ületada riigipiire, ja piiriülese õhusaaste kauglevi Genfi konventsiooni nõudeid, on keelatud ehitada korstnaid, millest saasteained väljuvad kõrgemal kui 250 meetrit maapinnast. (2) Käitise projekteerimisel tuleb arvestada, et saasteaineid väljutavad korstnad, ventilatsiooniavad ja -torud ning muud saasteallikad oleksid paigaldatud vähemalt 50 meetri kaugusele eluhoonest ja nende kõrguse määramisel oleks tagatud käesoleva seaduse §-de 26 ja 27 alusel keskkonnaministri määrusega inimese tervise kaitseks kehtestatud välisõhu saastatuse taseme ühe tunni keskmiste piirväärtuste järgimine. (3) Saasteainete väljumiskõrgus peab tagama saasteainete nõutava hajumise maapinnalähedases õhukihis, et vältida välisõhu saastatuse taseme piirväärtuse ületamist. (4) Saasteallikast eralduvate saasteainete maapinnalähedases õhukihis hajumise parandamiseks võib suurendada saasteainete väljumiskõrgust. (5) Saasteainete väljumiskõrguse või väljumisava läbimõõdu muutmise korral tuleb sellest teatada välisõhu saasteloa andjale ja taotleda uus luba.",
      "rdfs:label": {
        "@value": "VKS_Par_66 (redaktsioon 116052013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_66_v129062014093"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_66_v129062014093",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Silmas pidades õhusaaste kauglevi, mis võib ületada riigipiire, ja piiriülese õhusaaste kauglevi Genfi konventsiooni nõudeid, on keelatud ehitada korstnaid, millest saasteained väljuvad kõrgemal kui 250 meetrit maapinnast. (2) Käitise projekteerimisel tuleb arvestada, et saasteaineid väljutavad korstnad, ventilatsiooniavad ja -torud ning muud saasteallikad oleksid paigaldatud vähemalt 50 meetri kaugusele eluhoonest ja nende kõrguse määramisel oleks tagatud käesoleva seaduse §-de 26 ja 27 alusel valdkonna eest vastutava ministri määrusega inimese tervise kaitseks kehtestatud välisõhu saastatuse taseme ühe tunni keskmiste piirväärtuste järgimine. (3) Saasteainete väljumiskõrgus peab tagama saasteainete nõutava hajumise maapinnalähedases õhukihis, et vältida välisõhu saastatuse taseme piirväärtuse ületamist. (4) Saasteallikast eralduvate saasteainete maapinnalähedases õhukihis hajumise parandamiseks võib suurendada saasteainete väljumiskõrgust. (5) Saasteainete väljumiskõrguse või väljumisava läbimõõdu muutmise korral tuleb sellest teatada välisõhu saasteloa andjale ja taotleda uus luba.",
      "rdfs:label": {
        "@value": "VKS_Par_66 (redaktsioon 129062014093)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014093"
    },
    {
      "@id": "estleg:VKS_Par_67_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisõhu saasteluba (edaspidi saasteluba ) ja erisaasteluba on dokumendid, mis annavad käesolevas seaduses sätestatud juhtudel õiguse viia saasteaineid paiksest saasteallikast välisõhku ning määravad selle õiguse kasutamise tingimused. (2) Saasteallika valdajal, kes on kohustatud omama keskkonnakompleksluba või jäätmepõletusluba, ei ole vaja saasteluba ja erisaasteluba keskkonnakompleksloaga või jäätmepõletusloaga hõlmatud käitise suhtes. (3) Saasteloa ja erisaasteloa taotlemisele ning andmise ja muutmise menetlusele kohaldatakse haldusmenetluse seaduse avatud menetluse sätteid.",
      "rdfs:label": {
        "@value": "VKS_Par_67 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_67_v874386"
      },
      "estleg:versionValidTo": {
        "@value": "2005-04-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_67_v874386",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisõhu saasteluba (edaspidi saasteluba ) ja erisaasteluba on dokumendid, mis annavad käesolevas seaduses sätestatud juhtudel õiguse viia saasteaineid paiksest saasteallikast välisõhku ning määravad selle õiguse kasutamise tingimused. (2) Saasteallika valdajal, kes on kohustatud omama keskkonnakompleksluba või jäätmepõletusluba, ei ole vaja saasteluba ja erisaasteluba keskkonnakompleksloaga või jäätmepõletusloaga hõlmatud käitise suhtes. (3) Saasteloa ja erisaasteloa taotlemisele ning andmise ja muutmise menetlusele kohaldatakse haldusmenetluse seaduse avatud menetluse sätteid. (4) Keskkonnaministeeriumil või saasteallika asukoha keskkonnateenistusel on keskkonnamõju hindamise järelevalvajana õigus määrata keskkonnanõudeid välisõhku saasteainete eraldumise vältimiseks või vähendamiseks ning sellest tulenevalt keskkonnaseisundi kahjustumise vältimiseks.",
      "rdfs:label": {
        "@value": "VKS_Par_67 (redaktsioon 874386)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "874386",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_67_v12798057"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_67_v12798057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisõhu saasteluba (edaspidi saasteluba ) ja erisaasteluba on dokumendid, mis annavad käesolevas seaduses sätestatud juhtudel õiguse viia saasteaineid paiksest saasteallikast välisõhku ning määravad selle õiguse kasutamise tingimused. (2) Saasteallika valdajal, kes on kohustatud omama keskkonnakompleksluba või jäätmepõletamist käsitlev jäätmeluba, ei ole vaja saasteluba ja erisaasteluba keskkonnakompleksloaga või jäätmepõletamist käsitleva jäätmeloaga hõlmatud käitise suhtes. (3) Saasteloa ja erisaasteloa taotlemisele ning andmise ja muutmise menetlusele kohaldatakse haldusmenetluse seaduse avatud menetluse sätteid. (4) Keskkonnaministeeriumil või saasteallika asukoha keskkonnateenistusel on keskkonnamõju hindamise järelevalvajana õigus määrata keskkonnanõudeid välisõhku saasteainete eraldumise vältimiseks või vähendamiseks ning sellest tulenevalt keskkonnaseisundi kahjustumise vältimiseks.",
      "rdfs:label": {
        "@value": "VKS_Par_67 (redaktsioon 12798057)",
        "@language": "et"
      },
