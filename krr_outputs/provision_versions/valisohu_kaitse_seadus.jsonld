      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_28_v129062014093",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arvestades inimorganismide erinevat kohanemisreaktsiooni, võib valdkonna eest vastutav minister Terviseameti ettepanekul kehtestada määrusega elanikkonna tundlike gruppide tervise kaitseks välisõhu saastatuse taseme käesoleva seaduse §-s 26 sätestatutest rangemad piirväärtused järgmiste asutuste territooriumil: tervishoiuasutus; hoolekandeasutus; lasteaed; kool.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_28 (redaktsioon 129062014093)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014093"
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_29_v22408",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist väljaantud saasteload jäävad kehtima kuni nende väljavahetamiseni käesoleva seaduse nõuetele vastavate lubadega. Taotluste vastuvõtmine saastelubade väljavahetamiseks lõpetatakse 2000. aasta 31. detsembril.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_29 (redaktsioon 22408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22408",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_29_v756554"
      },
      "estleg:versionValidTo": {
        "@value": "2004-09-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_29_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arvestades ökosüsteemide eritundlikkust välisõhu vääveldioksiidi, lämmastikoksiidide või osooniga saastatuse kahjuliku mõju suhtes, kehtestab keskkonnaminister vajaduse korral nende ainete puhul saastatuse taseme käesoleva seaduse §-s 26 sätestatutes rangemad piirväärtused.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_29 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_29_v12798057"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      }
    },
    {
