      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saasteaine sisalduse häiretase on saasteaine kogus välisõhu ruumalaühikus, mille ületamisel ka lühiajaline mõju seab ohtu inimese tervise ning mille juures tuleb kohe rakendada meetmeid inimese tervise kaitseks.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_11 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554"
    },
