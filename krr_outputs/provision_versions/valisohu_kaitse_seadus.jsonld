      }
    },
    {
      "@id": "estleg:VKS_Par_133_v105072011026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_133"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisõhu strateegilise mürakaardi ja välisõhus leviva müra vähendamise tegevuskava sisule esitatavad miinimumnõuded määrusega.",
      "rdfs:label": {
