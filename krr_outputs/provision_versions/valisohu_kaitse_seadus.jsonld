      }
    },
    {
      "@id": "estleg:VKS_Par_119_v12798057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Käesoleva paragrahvi lõike 1 alusel kehtestatud jaotuskavaga käitajatele määratud lubatud heitkogused võtab saasteloa, keskkonnakompleksloa või jäätmeloa andja aluseks nende lubade andmisel.",
