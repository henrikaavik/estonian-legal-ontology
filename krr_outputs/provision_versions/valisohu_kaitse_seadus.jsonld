        "@id": "estleg:VKS_Par_54_v105072011026"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_54_v105072011026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tiheasustusega piirkonnas on riikliku õhuseire korraldamise aluseks välisõhus sisalduvate kohustuslikult määratavate saasteainete nimekiri, mille määrusega.",
      "rdfs:label": {
        "@value": "VKS_Par_54 (redaktsioon 105072011026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105072011026",
      "estleg:supersededByVersion": {
