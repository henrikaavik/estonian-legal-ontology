      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arvestades inimorganismide erinevat kohanemisreaktsiooni, võib keskkonnaminister Terviseameti ettepanekul kehtestada määrusega elanikkonna tundlike gruppide tervise kaitseks välisõhu saastatuse taseme käesoleva seaduse §-s 26 sätestatutest rangemad piirväärtused järgmiste asutuste territooriumil: tervishoiuasutus; hoolekandeasutus; lasteaed; kool.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_28 (redaktsioon 13228193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13228193",
      "estleg:supersededByVersion": {
