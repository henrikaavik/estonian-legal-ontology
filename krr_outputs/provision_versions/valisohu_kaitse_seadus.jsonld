    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_10_v22408",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootorsõiduki ja liikurmasina heitgaasi saasteainete sisalduse ja suitsususe normatiivid kehtestatakse keskkonnaministri määrusega.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_10 (redaktsioon 22408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22408",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_10_v756554"
      },
      "estleg:versionValidTo": {
        "@value": "2004-09-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_10_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saastetaluvuse piirmäär on protsent saastatuse taseme piirväärtusest, mille võrra võib kehtestatud piirväärtust ajutiselt ületada.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_10 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_10_v105072011026"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_10_v105072011026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saastetaluvuse piirmäär on protsent saastatuse taseme piirväärtusest, mille võrra käesolevas seaduses sätestatud tingimustel võib kehtestatud piirväärtust ajutiselt ületada.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_10 (redaktsioon 105072011026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105072011026"
    },
    {
      "@id": "estleg:VKS_Par_100_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_100"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Suure põletusseadme ilma püüdeseadmeta käitamise kestus ei tohi summaarselt ületada 120 tundi aastas, välja arvatud juhul, kui loa andja hinnangul eksisteerib energiavarustuse säilitamise põhjendatud vajadus.",
      "rdfs:label": {
        "@value": "VKS_Par_100 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554"
    },
    {
      "@id": "estleg:VKS_Par_101_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Olemasolevatele või hiljemalt 2002. aasta 27. novembril ehitusloa saanud või hiljemalt 2003. aasta 27. novembril käiku antud suurtele põletusseadmetele ei rakendata saasteainete heitkoguste piirväärtuste järgimise nõudeid, kui põletusseadme valdaja on loa andjale kirjalikult kinnitanud, et ta võtab endale kohustuse käitada põletusseadet perioodil 2008. aasta 1. jaanuarist kuni 2015. aasta 31. detsembrini summaarselt mitte üle 20 000 töötunni ja esitada igal aastal loa andjale põletusseadmete tegeliku käitamisaja andmed, või kui põletusseadme valdaja on sõlminud keskkonnaministriga lepingu põletusseadme töö järkjärgulise lõpetamise ja selle 2015. aastaks sulgemise kohta.",
      "rdfs:label": {
        "@value": "VKS_Par_101 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_101_v115112012004"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_101_v115112012004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Olemasolevatele või hiljemalt 2002. aasta 27. novembril ehitusloa saanud või hiljemalt 2003. aasta 27. novembril käiku antud suurtele põletusseadmetele ei rakendata saasteainete heitkoguste piirväärtuste järgimise nõudeid, kui põletusseadme käitaja on loa andjale kirjalikult kinnitanud, et ta võtab endale kohustuse käitada põletusseadet perioodil 2008. aasta 1. jaanuarist kuni 2015. aasta 31. detsembrini summaarselt mitte üle 20 000 töötunni ja esitada igal aastal loa andjale põletusseadmete tegeliku käitamisaja andmed, või kui põletusseadme käitaja on sõlminud keskkonnaministriga lepingu põletusseadme töö järkjärgulise lõpetamise ja selle 2015. aastaks sulgemise kohta.",
      "rdfs:label": {
        "@value": "VKS_Par_101 (redaktsioon 115112012004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115112012004"
    },
    {
      "@id": "estleg:VKS_Par_102_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loa andja võib kirjalikult lubada, et suure põletusseadme valdaja ei pea järgima saasteainete heitkoguste piirväärtusi kümne päeva kestel, kui seade, mis kasutab tavaliselt ainult gaaskütust ja millele muu kütuse kasutamise korral tuleks paigaldada väljuvate gaaside püüdeseadmed, peab erandkorras kasutama teisi kütuseliike peale gaasi. Kümnepäevane ajapiirang ei kehti põhjendatud vajaduse korral säilitada energiavarustus. Sellistest juhtudest tuleb viivitamata teavitada loa andjat ja Keskkonnainspektsiooni. (2) Loa andja võib kuni kuueks kuuks kirjalikult peatada kohustuse järgida vääveldioksiidi heitkoguse piirväärtust suure põletusseadme puhul, mis tavaliselt kasutab vähese väävlisisaldusega kütust, kui seadme valdaja ei suuda täita vääveldioksiidi piirväärtuse nõuet hädaolukorraks valmisoleku seaduse (RT I 2000, 95, 613; 2002, 61, 375; 63, 387; 2003, 88, 594; 2004, 26, 173) tähenduses hädaolukorra tagajärjel vähese väävlisisaldusega kütuse tarnete katkemise tõttu.",
      "rdfs:label": {
        "@value": "VKS_Par_102 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_102_v12890004"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_102_v12890004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loa andja võib kirjalikult lubada, et suure põletusseadme valdaja ei pea järgima saasteainete heitkoguste piirväärtusi kümne päeva kestel, kui seade, mis kasutab tavaliselt ainult gaaskütust ja millele muu kütuse kasutamise korral tuleks paigaldada väljuvate gaaside püüdeseadmed, peab erandkorras kasutama teisi kütuseliike peale gaasi. Kümnepäevane ajapiirang ei kehti põhjendatud vajaduse korral säilitada energiavarustus. Sellistest juhtudest tuleb viivitamata teavitada loa andjat ja Keskkonnainspektsiooni. (2) Loa andja võib kuni kuueks kuuks kirjalikult peatada kohustuse järgida vääveldioksiidi heitkoguse piirväärtust suure põletusseadme puhul, mis tavaliselt kasutab vähese väävlisisaldusega kütust, kui seadme valdaja ei suuda täita vääveldioksiidi piirväärtuse nõuet hädaolukorraks valmisoleku seaduse tähenduses hädaolukorra tagajärjel vähese väävlisisaldusega kütuse tarnete katkemise tõttu.",
      "rdfs:label": {
        "@value": "VKS_Par_102 (redaktsioon 12890004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12890004",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_102_v13202035"
      },
      "estleg:versionValidTo": {
