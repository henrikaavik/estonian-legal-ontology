      },
      "estleg:versionValidTo": {
        "@value": "2005-04-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_47_v874386",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_47"
      },
      "estleg:versionValidFrom": {
