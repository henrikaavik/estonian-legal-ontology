      }
    },
    {
      "@id": "estleg:VKS_Par_117_v131122010028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kliimamuutust vähendavat tegevust korraldab Keskkonnaministeerium lähtuvalt Ühinenud Rahvaste Organisatsiooni kliimamuutuste raamkonventsioonis (edaspidi kliimamuutuste raamkonventsioon) ja konventsiooni Kyoto protokollis (edaspidi Kyoto protokoll) sätestatud kasvuhoonegaaside heitkoguste piiramise nõuetest.",
      "rdfs:label": {
        "@value": "VKS_Par_117 (redaktsioon 131122010028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010028"
    },
    {
      "@id": "estleg:VKS_Par_118_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saasteallika valdaja rakendab täiendavaid meetmeid, et vähendada süsinikdioksiidi ja teiste kasvuhoonegaaside, nagu metaani, dilämmastikoksiidi, hüdrofluorosüsivesinike, perfluorosüsivesinike ja väävelheksafluoriidi heitkoguseid, mis välisõhus akumuleerides võivad põhjustada kliimamuutust.",
      "rdfs:label": {
        "@value": "VKS_Par_118 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_118_v105072011026"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_118_v105072011026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saasteallika valdaja rakendab lisameetmeid, et vähendada kasvuhoonegaaside heitkoguseid, mis välisõhus akumuleerudes võivad põhjustada kliimamuutust.",
      "rdfs:label": {
        "@value": "VKS_Par_118 (redaktsioon 105072011026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105072011026",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_118_v115112012004"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_118_v115112012004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saasteallika käitaja rakendab lisameetmeid, et vähendada kasvuhoonegaaside heitkoguseid, mis välisõhus akumuleerudes võivad põhjustada kliimamuutust.",
      "rdfs:label": {
        "@value": "VKS_Par_118 (redaktsioon 115112012004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115112012004"
    },
    {
      "@id": "estleg:VKS_Par_119_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paiksetest ja liikuvatest saasteallikatest eralduvate kasvuhoonegaaside summaarse lubatud heitkoguse ja selle jaotuskava kehtestab Vabariigi Valitsus määrusega. (2) Käesoleva paragrahvi lõike 1 alusel kehtestatud summaarsed lubatud heitkogused võtab saasteloa, keskkonnakompleksloa või jäätmepõletusloa andja aluseks nende lubade andmisel.",
      "rdfs:label": {
        "@value": "VKS_Par_119 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_119_v874386"
      },
      "estleg:versionValidTo": {
        "@value": "2005-04-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_119_v874386",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Käesoleva paragrahvi lõike 1 alusel kehtestatud summaarsed lubatud heitkogused võtab saasteloa, keskkonnakompleksloa või jäätmepõletusloa andja aluseks nende lubade andmisel.",
      "rdfs:label": {
        "@value": "VKS_Par_119 (redaktsioon 874386)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "874386",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_119_v12798057"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
