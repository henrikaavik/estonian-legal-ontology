      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisõhu saastatuse taseme paiksed mõõtmised riiklikul, kohaliku omavalitsuse organi või ettevõtja tasandil tehakse proovide pideva või perioodilise võtmisega keskkonnaseire seaduse (RT I 1999, 10, 154; 54, 583; 2000, 92, 597; 2002, 63, 387) alusel või välisõhu saasteloa, keskkonnakompleksloa või jäätmepõletamist käsitleva jäätmeloaga määratud sagedusega ja kohtadest.",
      "rdfs:label": {
