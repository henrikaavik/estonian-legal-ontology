        "@value": "VKS_Par_112 (redaktsioon 104072012009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072012009"
    },
    {
      "@id": "estleg:VKS_Par_113_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
