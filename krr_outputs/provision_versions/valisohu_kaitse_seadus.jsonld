        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse alusel väljaantud saasteload jõustuvad ühe kuu möödumisel saasteloa avalikustamisest käesoleva seadusega sätestatud korras.",
      "rdfs:label": {
        "@value": "VÕKS_Par_18 (redaktsioon 22408)",
