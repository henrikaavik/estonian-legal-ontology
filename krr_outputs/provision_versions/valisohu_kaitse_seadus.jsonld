    },
    {
      "@id": "estleg:VKS_Par_144_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_144"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saasteainete välisõhku suunamise ja käesoleva seaduse nõuete rikkumise tõttu tekitatud kahju korvab kahju tekitaja vastavalt võlaõigusseadusele (RT I 2001, 81, 487; 2002, 60, 374; 2003, 78, 523; 2004, 13, 86; 37, 255).",
      "rdfs:label": {
        "@value": "VKS_Par_144 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_144_v12890004"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKS_Par_144_v12890004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
