      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "võib määrusega kehtestada välisõhu saastatuse taseme piirväärtused esmatähtsuseta saasteainetele.",
