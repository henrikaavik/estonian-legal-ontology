    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_3_v22408",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saasteaine lubatud heitkogus on arvutuslik normatiiv, mille juures välisõhku suunatud või eraldunud saasteaine konkreetsest paiksest saasteallikast ja kõigist muudest allikatest samas piirkonnas ei ületa välisõhu saastetaseme piirväärtust. (2) Välisõhu saasteloaga kehtestatakse paiksele saasteallikale heitkoguse lubatud suurus sekundis ja aastas.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_3 (redaktsioon 22408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22408",
      "estleg:supersededByVersion": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_3_v756554"
      },
      "estleg:versionValidTo": {
        "@value": "2004-09-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:valisohu_kaitse_seadus_Par_3_v756554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:valisohu_kaitse_seadus_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisõhu keemiline mõjutamine on puhta välisõhu koostise muutmine saasteainete õhku eraldamisega.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_3 (redaktsioon 756554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "756554"
    },
