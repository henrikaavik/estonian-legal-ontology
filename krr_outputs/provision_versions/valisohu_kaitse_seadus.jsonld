      },
      "estleg:versionValidTo": {
        "@value": "2011-07-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VÕKS_Par_18_v105072011026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VÕKS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VÕKS_Par_18 (redaktsioon 105072011026)",
        "@language": "et"
