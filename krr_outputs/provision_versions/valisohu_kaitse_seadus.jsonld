      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisõhu saastatuse taseme pidev mõõtmine riiklikul või kohaliku omavalitsuse organi tasandil on kohustuslik tiheasustusega piirkondades, kus hindamisele eelnenud viie aasta pisteliste mõõtmiste tulemustest või modelleerimistulemustest selgub, et esmatähtsate saasteainete sisaldus välisõhus ületab käesoleva seaduse §-s 24 sätestatud väärtusi.",
      "rdfs:label": {
        "@value": "valisohu_kaitse_seadus_Par_19 (redaktsioon 756554)",
