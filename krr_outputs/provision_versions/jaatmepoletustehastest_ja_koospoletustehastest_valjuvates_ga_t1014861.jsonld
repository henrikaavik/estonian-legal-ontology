      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Jäätmepõletustehastest ja koospõletustehastest väljuvates gaasides ja nende puhastamisel tekkiva reovee käitlemise tulemusena tekkivas heitvees sisalduvate dioksiinide ja furaanide samaväärsuskordajad (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Jäätmepõletustehastest ja koospõletustehastest väljuvates gaasides ja nende puhastamisel tekkiva reovee käitlemise tulemusena tekkivas heitvees sisalduvate dioksiinide ja furaanide samaväärsuskordajad"
    },
    {
      "@id": "estleg:Reg_1014861_Par_1_v1014861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014861_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse dioksiinide ja furaanide samaväärsuskordajad, mille abil arvutatakse dioksiinide ja furaanide üldsisaldus jäätmepõletus- ja koospõletustehastest väljuvates gaasides ning jäätmepõletustehastest ja koospõletustehastest väljuvate gaaside puhastamisel tekkiva reovee käitlemisel tekkivas heitvees. Määrusega kehtestatakse dioksiinide ja furaanide samaväärsuskordajad, mille abil arvutatakse dioksiinide ja furaanide üldsisaldus jäätmepõletus- ja koospõletustehastest väljuvates gaasides ning jäätmepõletustehastest ja koospõletustehastest väljuvate gaaside puhastamisel tekkiva reovee käitlemisel tekkivas heitvees.",
      "rdfs:label": {
        "@value": "Reg_1014861_Par_1 (redaktsioon 1014861)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014861",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014861",
      "estleg:sourceAct": "Jäätmepõletustehastest ja koospõletustehastest väljuvates gaasides ja nende puhastamisel tekkiva reovee käitlemise tulemusena tekkivas heitvees sisalduvate dioksiinide ja furaanide samaväärsuskordajad",
      "estleg:provisionRef": "Reg_1014861 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014861_Map"
      }
    },
    {
      "@id": "estleg:Reg_1014861_Par_2_v1014861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014861_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Dioksiinid ja furaanid on kõik käesoleva määruse lisas loetletud polüklooritud dibenso-p-dioksiinid ja dibensofuraanid. Dioksiinid ja furaanid on kõik käesoleva määruse lisas loetletud polüklooritud dibenso-p-dioksiinid ja dibensofuraanid.",
      "rdfs:label": {
        "@value": "Reg_1014861_Par_2 (redaktsioon 1014861)",
