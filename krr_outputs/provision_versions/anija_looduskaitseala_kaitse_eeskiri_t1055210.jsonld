      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 18. märtsi 2021. a käskkirjaga nr 1-2/21/149 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 18. märtsi 2021. a käskkirjaga nr 1-2/21/149 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1055210_Par_10 (redaktsioon 1055210)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055210",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055210",
