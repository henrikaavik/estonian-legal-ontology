      }
    },
    {
      "@id": "estleg:Reg_1052228_Par_4_v1052228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052228_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väikelaevajuht, kelle lubatud sõidupiirkonnad on meri ja siseveed, peab teadma: 1 1) mereilmateate ja sisevete ilmateate saamise võimalusi; 2 2) kohalikke märke ilma ennustamiseks; 3 3) kuidas toimida erinevates ilmaoludes. Väikelaevajuht, kelle lubatud sõidupiirkonnad on meri ja siseveed, peab teadma: mereilmateate ja sisevete ilmateate saamise võimalusi; kohalikke märke ilma ennustamiseks; kuidas toimida erinevates ilmaoludes. 2 (2) Väikelaevajuht, kelle lubatud sõidupiirkond on siseveed, peab teadma lõikes 1 sätestatut, välja arvatud punktis 1 nimetatud mereilmateate saamise võimalused. Väikelaevajuht, kelle lubatud sõidupiirkond on siseveed, peab teadma lõikes 1 sätestatut, välja arvatud punktis 1 nimetatud mereilmateate saamise võimalused.",
      "rdfs:label": {
        "@value": "Reg_1052228_Par_4 (redaktsioon 1052228)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052228",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052228",
      "estleg:sourceAct": "Väikelaevajuhi teadmiste ja oskuste ning väljaõppe nõuded, eksamineerimise, tunnistuse taotlemise ja väljastamise kord ning tunnistuse vorm",
      "estleg:provisionRef": "Reg_1052228 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052228_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052228_Par_5_v1052228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052228_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väikelaevajuht, kelle lubatud sõidupiirkonnad on meri ja siseveed, peab teadma: 1 1) kuidas määrata ja parandada kurssi ning arvestada läbitud teekonda; 2 2) kuidas määrata esemete nähtavuskaugust; 3 3) kuidas määrata väikelaeva kiirust; 4 4) asukoha määramise erinevaid navigatsiooni viise; 5 5) kuidas kasutada orienteerumiseks toodreid, poisid ja kaldamärke ning tulede nähtavuskaugust; 6 6) poide ja kaldamärkide tulede iseloome; 7 7) kuidas kasutada mere- ja järvekaarte, jõeatlast ja käsiraamatuid navigatsiooni- ja lootsindusalase info saamiseks. Väikelaevajuht, kelle lubatud sõidupiirkonnad on meri ja siseveed, peab teadma: kuidas määrata ja parandada kurssi ning arvestada läbitud teekonda; kuidas määrata esemete nähtavuskaugust; kuidas määrata väikelaeva kiirust; asukoha määramise erinevaid navigatsiooni viise; kuidas kasutada orienteerumiseks toodreid, poisid ja kaldamärke ning tulede nähtavuskaugust; poide ja kaldamärkide tulede iseloome; kuidas kasutada mere- ja järvekaarte, jõeatlast ja käsiraamatuid navigatsiooni- ja lootsindusalase info saamiseks. 2 (2) Väikelaevajuht, kelle lubatud sõidupiirkonnad on meri ja siseveed, peab oskama: 1 1) lugeda kaarti ja teha kaarditööd (kanda kaardile kursse ja vahemaid); 2 2) määrata väikelaeva asukohta visuaalsete ja elektroonsete meetoditega; 3 3) määrata väikelaeva kurssi ja kiirust, kasutades erinevaid tehnilisi vahendeid; 4 4) kasutada tulede raamatut, eristada meremärkide tulede iseloomu, leida tulede nähtavuskaugust, lugeda kaldamärke. Väikelaevajuht, kelle lubatud sõidupiirkonnad on meri ja siseveed, peab oskama: lugeda kaarti ja teha kaarditööd (kanda kaardile kursse ja vahemaid); määrata väikelaeva asukohta visuaalsete ja elektroonsete meetoditega; määrata väikelaeva kurssi ja kiirust, kasutades erinevaid tehnilisi vahendeid; kasutada tulede raamatut, eristada meremärkide tulede iseloomu, leida tulede nähtavuskaugust, lugeda kaldamärke. 3 (3) Väikelaevajuht, kelle lubatud sõidupiirkonnaks on siseveed, peab teadma ja oskama lõigetes 1 ja 2 sätestatut, välja arvatud lõike 1 punktis 7 nimetatud merekaartide kasutamine. Väikelaevajuht, kelle lubatud sõidupiirkonnaks on siseveed, peab teadma ja oskama lõigetes 1 ja 2 sätestatut, välja arvatud lõike 1 punktis 7 nimetatud merekaartide kasutamine.",
      "rdfs:label": {
        "@value": "Reg_1052228_Par_5 (redaktsioon 1052228)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052228",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052228",
      "estleg:sourceAct": "Väikelaevajuhi teadmiste ja oskuste ning väljaõppe nõuded, eksamineerimise, tunnistuse taotlemise ja väljastamise kord ning tunnistuse vorm",
      "estleg:provisionRef": "Reg_1052228 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052228_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052228_Par_6_v1052228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052228_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väikelaevajuht peab teadma: 1 1) väikelaeva juhtimise iseärasusi sõltuvalt vee sügavusest, laevatee laiusest, tuulest, lainetusest ja voolust; 2 2) ohutusnõudeid sõidul, ankrus, manööverdamisel ja sadamas; 3 3) kuidas pääseda madalikult, likvideerida lekki ja pukseerida teist väikelaeva; 4 4) kuidas väikelaevaga silduda ja lahkuda, ankrusse jääda ja ankrust lahkuda. Väikelaevajuht peab teadma: väikelaeva juhtimise iseärasusi sõltuvalt vee sügavusest, laevatee laiusest, tuulest, lainetusest ja voolust; ohutusnõudeid sõidul, ankrus, manööverdamisel ja sadamas; kuidas pääseda madalikult, likvideerida lekki ja pukseerida teist väikelaeva; kuidas väikelaevaga silduda ja lahkuda, ankrusse jääda ja ankrust lahkuda. 2 (2) Väikelaevajuht peab oskama: 1 1) juhtida väikelaeva erineva tuule ja lainetusega ning arvestada voolu mõju juhitavusele; 2 2) jääda ankrusse, poile, tulla kai äärde või teise laeva pardasse, sealt lahkuda; 3 3) pukseerida teist väikelaeva; 4 4) teostada manöövrit „mees üle parda”. Väikelaevajuht peab oskama: juhtida väikelaeva erineva tuule ja lainetusega ning arvestada voolu mõju juhitavusele; jääda ankrusse, poile, tulla kai äärde või teise laeva pardasse, sealt lahkuda; pukseerida teist väikelaeva; teostada manöövrit „mees üle parda”.",
      "rdfs:label": {
        "@value": "Reg_1052228_Par_6 (redaktsioon 1052228)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052228",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052228",
      "estleg:sourceAct": "Väikelaevajuhi teadmiste ja oskuste ning väljaõppe nõuded, eksamineerimise, tunnistuse taotlemise ja väljastamise kord ning tunnistuse vorm",
      "estleg:provisionRef": "Reg_1052228 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052228_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052228_Par_7_v1052228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052228_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väikelaevajuht peab teadma, kuidas tegutseda otsingu- ja päästeoperatsioonil ning kuidas ja kellele teatada õnnetusjuhtumist. Väikelaevajuht peab teadma, kuidas tegutseda otsingu- ja päästeoperatsioonil ning kuidas ja kellele teatada õnnetusjuhtumist. 2 (2) Väikelaevajuht peab oskama eristada ja kasutada rahvusvahelisi hädasignaale. Väikelaevajuht peab oskama eristada ja kasutada rahvusvahelisi hädasignaale.",
      "rdfs:label": {
        "@value": "Reg_1052228_Par_7 (redaktsioon 1052228)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052228",
