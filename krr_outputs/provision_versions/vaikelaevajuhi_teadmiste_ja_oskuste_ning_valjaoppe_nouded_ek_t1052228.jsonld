      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Väikelaevajuhi teadmiste ja oskuste ning väljaõppe nõuded, eksamineerimise, tunnistuse taotlemise ja väljastamise kord ning tunnistuse vorm (25 versiooni)",
        "@language": "et"
      },
      "dc:source": "Väikelaevajuhi teadmiste ja oskuste ning väljaõppe nõuded, eksamineerimise, tunnistuse taotlemise ja väljastamise kord ning tunnistuse vorm"
    },
    {
      "@id": "estleg:Reg_1052228_Par_1_v1052228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
