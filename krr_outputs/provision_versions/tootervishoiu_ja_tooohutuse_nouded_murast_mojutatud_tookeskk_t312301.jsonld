      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Töötervishoiu ja tööohutuse nõuded mürast mõjutatud töökeskkonnale, töökeskkonna müra piirnormid ja müra mõõtmise kord (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Töötervishoiu ja tööohutuse nõuded mürast mõjutatud töökeskkonnale, töökeskkonna müra piirnormid ja müra mõõtmise kord"
    },
    {
      "@id": "estleg:Reg_312301_Par_1_v312301",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312301_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-11-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega sätestatakse töökeskkonna müra piirnormid, müra mõõtmise kord ning tööandja kohustused mürast tingitud terviseriskide vältimiseks või vähendamiseks. Määrusega sätestatakse töökeskkonna müra piirnormid, müra mõõtmise kord ning tööandja kohustused mürast tingitud terviseriskide vältimiseks või vähendamiseks.",
      "rdfs:label": {
        "@value": "Reg_312301_Par_1 (redaktsioon 312301)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312301",
