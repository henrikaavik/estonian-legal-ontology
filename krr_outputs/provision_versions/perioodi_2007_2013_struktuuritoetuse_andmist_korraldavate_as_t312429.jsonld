      "estleg:provisionRef": "Reg_312429 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312429_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_312429_Par_7_v312429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
