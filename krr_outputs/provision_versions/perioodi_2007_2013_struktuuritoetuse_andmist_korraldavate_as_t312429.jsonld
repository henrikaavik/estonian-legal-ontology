        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega määratakse kindlaks struktuuritoetuse andmist korraldavad asutused ja isikud. Käesoleva määrusega määratakse kindlaks struktuuritoetuse andmist korraldavad asutused ja isikud.",
      "rdfs:label": {
        "@value": "Reg_312429_Par_1 (redaktsioon 312429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312429",
