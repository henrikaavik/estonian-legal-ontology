      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312429_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakendusüksused inimressursi arendamise rakenduskava raames on: 1 1) INNOVE ja KIK prioriteetse suuna „Elukestev õpe” osas; 2 2) Sihtasutus Archimedes prioriteetse suuna „Teadus- ja arendustegevuse inimressursi arendamine” osas; 3 3) Riigi Tugiteenuste Keskus prioriteetse suuna „Suurem haldusvõimekus” osas; RT I 2018-08-28 8 128082018008 2018-09-01 4 4) INNOVE prioriteetse suuna „Pikk ja kvaliteetne tööelu” osas; 5 5) Riigi Tugiteenuste Keskus, EAS ja KredEx prioriteetse suuna „Teadmised ja oskused uuendusmeelseks ettevõtluseks” osas; RT I 2019-04-30 10 130042019010 2019-05-03 6 6) Riigi Tugiteenuste Keskus prioriteetsete suundade „Horisontaalne tehniline abi” ja „Tehniline abi” osas. RT I 2018-08-28 8 128082018008 2018-09-01 Rakendusüksused inimressursi arendamise rakenduskava raames on: INNOVE ja KIK prioriteetse suuna „Elukestev õpe” osas; Sihtasutus Archimedes prioriteetse suuna „Teadus- ja arendustegevuse inimressursi arendamine” osas; Riigi Tugiteenuste Keskus prioriteetse suuna „Suurem haldusvõimekus” osas; INNOVE prioriteetse suuna „Pikk ja kvaliteetne tööelu” osas; Riigi Tugiteenuste Keskus, EAS ja KredEx prioriteetse suuna „Teadmised ja oskused uuendusmeelseks ettevõtluseks” osas; Riigi Tugiteenuste Keskus prioriteetsete suundade „Horisontaalne tehniline abi” ja „Tehniline abi” osas.",
      "rdfs:label": {
        "@value": "Reg_312429_Par_8 (redaktsioon 312429)",
        "@language": "et"
      },
