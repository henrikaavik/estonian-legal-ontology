        "@language": "et"
      },
      "estleg:versionRedactionId": "1061665",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061665",
      "estleg:sourceAct": "Vähi sõeluuringute registri põhimäärus",
      "estleg:provisionRef": "Reg_1061665 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061665_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1061665_Par_16_v1061665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061665_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Juurdepääs registri andmetele ja andmete väljastamine võimaldatakse kooskõlas isikuandmete kaitset reguleerivate õigusaktidega, arvestades rahvatervishoiu seaduses sätestatud erisusi. Juurdepääs registri andmetele ja andmete väljastamine võimaldatakse kooskõlas isikuandmete kaitset reguleerivate õigusaktidega, arvestades rahvatervishoiu seaduses sätestatud erisusi. 2 (2) Registrist väljastatavate andmete õigsuse eest vastutab vastutav töötleja. Registrist väljastatavate andmete õigsuse eest vastutab vastutav töötleja. 3 (3) Vastutav töötleja avaldab avalikkusele asutuse veebilehel registri andmete põhjal koostatud statistilised andmed isikustamata kujul. Vastutav töötleja avaldab avalikkusele asutuse veebilehel registri andmete põhjal koostatud statistilised andmed isikustamata kujul. 4 (4) Vastutav töötleja peab arvestust selle üle, kellele, mis eesmärgil, millal, millisel viisil ja milliseid isikuandmeid on registrist väljastatud või muul moel töödeldud. Vastutav töötleja peab arvestust selle üle, kellele, mis eesmärgil, millal, millisel viisil ja milliseid isikuandmeid on registrist väljastatud või muul moel töödeldud.",
      "rdfs:label": {
        "@value": "Reg_1061665_Par_16 (redaktsioon 1061665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061665",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061665",
      "estleg:sourceAct": "Vähi sõeluuringute registri põhimäärus",
      "estleg:provisionRef": "Reg_1061665 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061665_Map_2026"
      }
    },
    {
