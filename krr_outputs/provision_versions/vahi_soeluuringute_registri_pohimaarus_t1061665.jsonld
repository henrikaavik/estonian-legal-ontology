      }
    },
    {
      "@id": "estleg:Reg_1061665_Par_10_v1061665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061665_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervise infosüsteem edastab registrile järgmised sõeluuringujärgse ravi andmed: 1 1) sõeluuringus osalenu isikukood; 2 2) meditsiinidokumendi andmed (tüüp, number, OID kood, versioon ja kinnitamise kuupäev); 3 3) uuringu või protseduuri kood ja nimetus (tervishoiuteenuste loetelu) ning toimumise kuupäev; 4 4) operatsiooni kood ja nimetus (tervishoiuteenuste loetelu) ning toimumise kuupäev; 5 5) uuringu, protseduuri või operatsiooni teinud tervishoiuteenuse osutaja nimi ja registrikood ning tervishoiutöötaja ees- ja perekonnanimi ja registreerimiskood. Tervise infosüsteem edastab registrile järgmised sõeluuringujärgse ravi andmed: sõeluuringus osalenu isikukood; meditsiinidokumendi andmed (tüüp, number, OID kood, versioon ja kinnitamise kuupäev); uuringu või protseduuri kood ja nimetus (tervishoiuteenuste loetelu) ning toimumise kuupäev; operatsiooni kood ja nimetus (tervishoiuteenuste loetelu) ning toimumise kuupäev; uuringu, protseduuri või operatsiooni teinud tervishoiuteenuse osutaja nimi ja registrikood ning tervishoiutöötaja ees- ja perekonnanimi ja registreerimiskood.",
      "rdfs:label": {
        "@value": "Reg_1061665_Par_10 (redaktsioon 1061665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061665",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061665",
      "estleg:sourceAct": "Vähi sõeluuringute registri põhimäärus",
      "estleg:provisionRef": "Reg_1061665 § 10",
