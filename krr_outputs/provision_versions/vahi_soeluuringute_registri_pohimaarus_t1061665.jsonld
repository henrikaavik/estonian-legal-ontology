    {
      "@id": "estleg:Reg_1061665_Par_15_v1061665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061665_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastutav töötleja ja volitatud töötleja tagavad infotehnoloogiliste vahenditega logid kande vaatamise, lisamise, muutmise ja kustutamise kohta, võimaldades tuvastada töötlemistoimingu teinud isiku ja töötlemise aja. Vastutav töötleja ja volitatud töötleja tagavad infotehnoloogiliste vahenditega logid kande vaatamise, lisamise, muutmise ja kustutamise kohta, võimaldades tuvastada töötlemistoimingu teinud isiku ja töötlemise aja.",
      "rdfs:label": {
