    {
      "@id": "estleg:Reg_1057214_Par_4_v1057214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057214_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mitteabikõlblikud kulud on Euroopa Parlamendi ja nõukogu määruse (EL) nr 1308/2013 artikli 23 lõike 1 punktis c ning komisjoni delegeeritud määruse (EL) 2017/40 artikli 4 lõike 1 punktides c‒f loetletud kulud. Mitteabikõlblikud kulud on Euroopa Parlamendi ja nõukogu määruse (EL) nr 1308/2013 artikli 23 lõike 1 punktis c ning komisjoni delegeeritud määruse (EL) 2017/40 artikli 4 lõike 1 punktides c‒f loetletud kulud. 2 (2) Mitteabikõlblik kulu on Euroopa Parlamendi ja nõukogu määruse (EL) nr 1308/2013 artikli 23 lõike 1 punktis a ning komisjoni delegeeritud määruse (EL) 2017/40 artikli 4 lõike 1 punktis a loetletud abikõlblike toodete tarnimisel ja jagamisel kasutatava varustuse ostmise, üürimise, rentimise ja liisimise kulud. Mitteabikõlblik kulu on Euroopa Parlamendi ja nõukogu määruse (EL) nr 1308/2013 artikli 23 lõike 1 punktis a ning komisjoni delegeeritud määruse (EL) 2017/40 artikli 4 lõike 1 punktis a loetletud abikõlblike toodete tarnimisel ja jagamisel kasutatava varustuse ostmise, üürimise, rentimise ja liisimise kulud.",
      "rdfs:label": {
        "@value": "Reg_1057214_Par_4 (redaktsioon 1057214)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057214",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057214",
