      },
      "estleg:versionValidTo": {
        "@value": "2011-04-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_19_v123022011030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravikindlustusega hõlmamata isikule antava vältimatu psühhiaatrilise abi, psüühikahäire tõttu vaeguriks tunnistatud isiku hooldamise ja taastusabi kulud, kohtupsühhiaatriaekspertiisi ja kaitseväeteenistuseks kõlblikkuse psühhiaatriaekspertiisi tegemise ja üheksa kuu pikkuse sõltuvusravi kohaldamise kulud ning kohtu poolt psühhiaatriahaiglasse paigutatud isiku psühhiaatrilise ravi kulud kaetakse riigieelarvest.",
      "rdfs:label": {
