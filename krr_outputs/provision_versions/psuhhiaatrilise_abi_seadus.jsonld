    },
    {
      "@id": "estleg:PsAS_Par_6_v115062012006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Psühhiaatrilise abiga tagatakse raviprotsessis psüühikahäirega isikule järjepidev ja valdkonna eest vastutava ministri poolt kehtestatud standarditele vastav ravi. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „sotsiaalministri“ sõnadega „valdkonna eest vastutava ministri“. (2) Psühhiaatrilist abi annavad sellekohase tegevusloaga raviasutused, arstid ja muud spetsialistid. (3) Kehtetu - (4) Psühhiaatriline eriarstiabi korraldatakse kohaliku omavalitsuse ja riigi tasandil. (5) Psühhiaatrilise abi andmisel välditakse võimaluse korral isiku eemaldamist harjumuspärasest elukeskkonnast. (6) Psühhiaatrilist haiglaravi rakendatakse juhul, kui isiku tervise seisundist lähtuvalt ei ole haiglaväline abi piisavalt tõhus või kui isik on temal esineva psüühikahäire tõttu muutunud endale või teistele ohtlikuks. (7) Sotsiaalministeerium korraldab psüühikahäireid ennetavat tegevust.",
      "rdfs:label": {
        "@value": "PsAS_Par_6 (redaktsioon 115062012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115062012006",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_6_v121122018012"
      },
      "estleg:versionValidTo": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_6_v121122018012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Psühhiaatrilise abiga tagatakse raviprotsessis psüühikahäirega isikule järjepidev ja valdkonna eest vastutava ministri poolt kehtestatud standarditele vastav ravi. (2) Psühhiaatrilist abi annavad sellekohase tegevusloaga raviasutused, arstid ja muud spetsialistid. (3) Kehtetu - (4) Psühhiaatriline eriarstiabi korraldatakse kohaliku omavalitsuse ja riigi tasandil. (5) Psühhiaatrilise abi andmisel välditakse võimaluse korral isiku eemaldamist harjumuspärasest elukeskkonnast. (6) Psühhiaatrilist haiglaravi rakendatakse juhul, kui isiku tervise seisundist lähtuvalt ei ole haiglaväline abi piisavalt tõhus või kui isik on temal esineva psüühikahäire tõttu muutunud endale või teistele ohtlikuks. (7) Sotsiaalministeerium korraldab psüühikahäireid ennetavat tegevust.",
      "rdfs:label": {
        "@value": "PsAS_Par_6 (redaktsioon 121122018012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122018012"
    },
    {
      "@id": "estleg:PsAS_Par_7_v22369",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi tasandil korraldab psühhiaatrilist abi Sotsiaalministeerium, kelle ülesanded täiendavalt tervishoiukorralduse seaduses (RT I 1994, 10, 133; 1995, 57, 978) sätestatule on: kohtu poolt psühhiaatriahaiglasse paigutatud isikute psühhiaatrilise ravi korraldamine; erihooldekodudes antava psühhiaatrilise abi korraldamine; psüühikahäireid ennetava tegevuse korraldamine.",
      "rdfs:label": {
        "@value": "PsAS_Par_7 (redaktsioon 22369)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22369",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_7_v123022011031"
      },
      "estleg:versionValidTo": {
        "@value": "2011-09-01",
        "@type": "xsd:date"
      }
    },
    {
