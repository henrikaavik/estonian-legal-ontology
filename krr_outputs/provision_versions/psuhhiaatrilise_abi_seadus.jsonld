    },
    {
      "@id": "estleg:PsAS_Par_19_v121122018012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravikindlustusega hõlmamata isikule antava vältimatu psühhiaatrilise abi kulud tasutakse Eesti Haigekassa eelarvest Eesti Haigekassa tervishoiuteenuste loetelus sätestatud alustel, tingimustel ja korras.",
      "rdfs:label": {
        "@value": "PsAS_Par_19 (redaktsioon 121122018012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122018012",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_19_v110102022002"
      },
      "estleg:versionValidTo": {
        "@value": "2022-10-11",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_19_v110102022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-10-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ravikindlustusega hõlmamata isikule antava vältimatu psühhiaatrilise abi kulud tasutakse Eesti Haigekassa eelarvest Eesti Haigekassa tervishoiuteenuste loetelus sätestatud alustel, tingimustel ja korras. (2) Ravikindlustatud isiku ja ravikindlustusega hõlmamata isiku psühhiaatrilise sundravi kulud tasutakse Eesti Haigekassa eelarvest Eesti Haigekassa tervishoiuteenuste loetelus sätestatud alustel, tingimustel ja korras.",
      "rdfs:label": {
        "@value": "PsAS_Par_19 (redaktsioon 110102022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110102022002",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_19_v111032023073"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_19_v111032023073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ravikindlustusega hõlmamata isikule antava vältimatu psühhiaatrilise abi kulud tasutakse Tervisekassa eelarvest Tervisekassa tervishoiuteenuste loetelus sätestatud alustel, tingimustel ja korras. (2) Ravikindlustatud isiku ja ravikindlustusega hõlmamata isiku psühhiaatrilise sundravi kulud tasutakse Tervisekassa eelarvest Tervisekassa tervishoiuteenuste loetelus sätestatud alustel, tingimustel ja korras.",
      "rdfs:label": {
        "@value": "PsAS_Par_19 (redaktsioon 111032023073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023073"
    },
    {
      "@id": "estleg:PsAS_Par_19_1_v107032012003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_19_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet käesoleva seaduse alusel psühhiaatrilise abi osutamise üle teostab Terviseamet tervishoiuteenuste korraldamise seaduse 6. peatükis sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "PsAS_Par_19_1 (redaktsioon 107032012003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032012003"
    },
    {
      "@id": "estleg:PsAS_Par_2_v22369",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse mõisteid järgmises tähenduses: psüühikahäire - kehtivale rahvusvahelisele psüühika- ja käitumishäirete klassifikatsioonile vastav psüühiline seisund või käitumishäire; psühhiaatriline abi - psüühikahäirete diagnostika, psüühikahäirega isiku ravi ja taastusabi ning psüühikahäireid ennetav tegevus; raviprotsess - isiku uurimise, diagnoosimise, ravimise ja taastusabiga seotud tegevus, mis hõlmab suhteid patsiendi ja arsti ning teiste ravimisele kaasatud isikute, raviasutuste ja haigekassaga; psüühikahäirega isiku taastusabi - tegevus psüühikahäirega isiku sotsiaalse toimetulekuvõime taastamiseks; teadev nõusolek - nõusolek, mille andmisel isik on võimeline aru saama nõusoleku olemusest ja selle andmise või sellest keeldumise tagajärgedest.",
      "rdfs:label": {
        "@value": "PsAS_Par_2 (redaktsioon 22369)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22369",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_2_v13227662"
      },
      "estleg:versionValidTo": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_2_v13227662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse mõisteid järgmises tähenduses: psüühikahäire – kehtivale rahvusvahelisele psüühika- ja käitumishäirete klassifikatsioonile vastav psüühiline seisund või käitumishäire; psühhiaatriline abi – psüühikahäirete diagnostika, psüühikahäirega isiku ravi ja taastusabi ning psüühikahäireid ennetav tegevus; raviprotsess – isiku uurimise, diagnoosimise, ravimise ja taastusabiga seotud tegevus, mis hõlmab suhteid patsiendi ja arsti ning teiste ravimisele kaasatud isikute, raviasutuste ja haigekassaga; psüühikahäirega isiku taastusabi – tegevus psüühikahäirega isiku sotsiaalse toimetulekuvõime taastamiseks; teadev nõusolek – nõusolek, mille andmisel isik on võimeline aru saama nõusoleku olemusest ja selle andmise või sellest keeldumise tagajärgedest.",
      "rdfs:label": {
        "@value": "PsAS_Par_2 (redaktsioon 13227662)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13227662",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_2_v111032023073"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_2_v111032023073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse mõisteid järgmises tähenduses: psüühikahäire – kehtivale rahvusvahelisele psüühika- ja käitumishäirete klassifikatsioonile vastav psüühiline seisund või käitumishäire; psühhiaatriline abi – psüühikahäirete diagnostika, psüühikahäirega isiku ravi ja taastusabi ning psüühikahäireid ennetav tegevus; raviprotsess – isiku uurimise, diagnoosimise, ravimise ja taastusabiga seotud tegevus, mis hõlmab suhteid patsiendi ja arsti ning teiste ravimisele kaasatud isikute, raviasutuste ja Tervisekassaga; psüühikahäirega isiku taastusabi – tegevus psüühikahäirega isiku sotsiaalse toimetulekuvõime taastamiseks; teadev nõusolek – nõusolek, mille andmisel isik on võimeline aru saama nõusoleku olemusest ja selle andmise või sellest keeldumise tagajärgedest.",
      "rdfs:label": {
        "@value": "PsAS_Par_2 (redaktsioon 111032023073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023073"
    },
    {
      "@id": "estleg:PsAS_Par_22_v13227662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "PsAS_Par_22 (redaktsioon 13227662)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13227662"
    },
    {
      "@id": "estleg:PsAS_Par_3_v22369",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Psühhiaatrilist abi antakse vaba tahte avalduse alusel, s.t. isiku soovil või teadval nõusolekul. (2) Teovõimetule isikule antakse psühhiaatrilist abi tema seadusliku esindaja soovil või nõusolekul. (3) Psüühikahäirega isiku ravi ilma tema teadva nõusolekuta või seadusliku esindaja nõusolekuta on lubatud ainult käesoleva seaduse paragrahvides 11 ja 17 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "PsAS_Par_3 (redaktsioon 22369)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22369",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_3_v178646"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_3_v178646",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Psühhiaatrilist abi antakse vaba tahte avalduse alusel, s.t. isiku soovil või teadval nõusolekul. (2) Piiratud teovõimega isikule antakse psühhiaatrilist abi tema seadusliku esindaja soovil või nõusolekul. (3) Psüühikahäirega isiku ravi ilma tema teadva nõusolekuta või seadusliku esindaja nõusolekuta on lubatud ainult käesoleva seaduse paragrahvides 11 ja 17 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "PsAS_Par_3 (redaktsioon 178646)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178646",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_3_v197199"
      },
      "estleg:versionValidTo": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_3_v197199",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Psühhiaatrilist abi antakse vaba tahte avalduse alusel, s.t. isiku soovil või teadval nõusolekul. (2) Piiratud teovõimega isikule antakse psühhiaatrilist abi tema seadusliku esindaja soovil või nõusolekul. (3) Psüühikahäirega isiku ravi ilma tema teadva nõusolekuta või seadusliku esindaja nõusolekuta on lubatud ainult käesoleva seaduse §-des 11 ja 17 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "PsAS_Par_3 (redaktsioon 197199)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "197199",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_3_v13111233"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_3_v13111233",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Psühhiaatrilist abi antakse vaba tahte avalduse alusel, s.t. isiku soovil või teadval nõusolekul. (2) Piiratud teovõimega isikule antakse psühhiaatrilist abi tema seadusliku esindaja nõusolekul ja isiku enda tahte alusel niivõrd, kuivõrd ta on võimeline sellekohast tahet avaldama. Seaduslik esindaja ei saa esindatava asemel avaldada tahet psühhiaatrilise abi osutamiseks. (3) Psüühikahäirega isiku ravi ilma tema enda teadva nõusolekuta on lubatud ainult käesoleva seaduse §-des 11 ja 17 sätestatud juhtudel. Sama kehtib piiratud teovõimega isikule psühhiaatrilise abi andmise ja tema ravi kohta, kui isik ise ei ole võimeline tahet avaldama või kui eestkostja abi või raviga ei nõustu.",
      "rdfs:label": {
        "@value": "PsAS_Par_3 (redaktsioon 13111233)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13111233",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_3_v107032012003"
      },
      "estleg:versionValidTo": {
        "@value": "2012-09-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_3_v107032012003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Psühhiaatrilist abi antakse vaba tahte avalduse alusel, st isiku soovil või teadval nõusolekul. (2) Piiratud teovõimega isikule antakse psühhiaatrilist abi tema seadusliku esindaja nõusolekul ja isiku enda tahte alusel niivõrd, kuivõrd ta on võimeline sellekohast tahet avaldama. Seaduslik esindaja ei saa esindatava asemel avaldada tahet psühhiaatrilise abi osutamiseks. (3) Psüühikahäirega isiku ravi ilma tema enda teadva nõusolekuta on lubatud ainult käesoleva seaduse §-des 11 ja 17 sätestatud juhtudel. Sama kehtib piiratud teovõimega isikule psühhiaatrilise abi andmise ja tema ravi kohta, kui isik ise ei ole võimeline tahet avaldama või kui eestkostja abi või raviga ei nõustu.",
      "rdfs:label": {
        "@value": "PsAS_Par_3 (redaktsioon 107032012003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032012003",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_3_v124032021006"
      },
      "estleg:versionValidTo": {
        "@value": "2021-04-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_3_v124032021006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Psühhiaatrilist abi antakse isiku enda nõusoleku alusel. (2) Psühhiaatrilise abi andmisel piiratud teovõimega isikule kohaldatakse võlaõigusseaduse § 766 lõiget 4. (3) Tervishoiuteenuse osutaja kaasab piiratud teovõimega isiku seadusliku esindaja või muu piiratud teovõimega isiku poolt usaldatud täisealise teovõimelise isiku, kui see on tervishoiuteenuse osutaja hinnangul piiratud teovõimega isiku huvides. (4) Psüühikahäirega isiku ravi ilma tema enda nõusolekuta on lubatud ainult käesoleva seaduse §-des 11 ja 17 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "PsAS_Par_3 (redaktsioon 124032021006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "124032021006"
    },
    {
      "@id": "estleg:PsAS_Par_4_v22369",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul on psühhiaatrilise abi saamisel õigus: saada ravi ja põetust võrdsel alusel muude haigetega; saada teavet oma psüühikahäire ja kasutatavate ravi- ning diagnostikameetodite kohta ja tutvuda temasse puutuvate ravidokumentidega, välja arvatud juhul, kui see võib osutuda kahjulikuks tema vaimsele tervisele või teiste isikute julgeolekule. Otsuse teabe edastamise kohta teeb ja annab õiguse tutvuda ravidokumentidega tema raviarst, kes teeb sellekohase kande tema ravidokumenti; keelduda psühhiaatrilistest uuringutest ja ravist või neid katkestada, välja arvatud käesoleva seaduse paragrahvides 11, 15, 16 ja 17 sätestatud juhtudel; kahju hüvitamisele ravi- või põetusvigadest põhjustatud kahju korral.",
      "rdfs:label": {
        "@value": "PsAS_Par_4 (redaktsioon 22369)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22369",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_4_v184448"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_4_v184448",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul on psühhiaatrilise abi saamisel õigus: saada ravi ja põetust võrdsel alusel muude haigetega; saada teavet oma psüühikahäire ja kasutatavate ravi- ning diagnostikameetodite kohta ja tutvuda temasse puutuvate ravidokumentidega, välja arvatud juhul, kui see võib osutuda kahjulikuks tema vaimsele tervisele või teiste isikute julgeolekule. Otsuse teabe edastamise kohta teeb ja annab õiguse tutvuda ravidokumentidega tema raviarst, kes teeb sellekohase kande tema ravidokumenti; keelduda psühhiaatrilistest uuringutest ja ravist või neid katkestada, välja arvatud käesoleva seaduse paragrahvides 11 ja 17 sätestatud juhtudel; kahju hüvitamisele ravi- või põetusvigadest põhjustatud kahju korral.",
      "rdfs:label": {
        "@value": "PsAS_Par_4 (redaktsioon 184448)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184448",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_4_v197199"
      },
      "estleg:versionValidTo": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_4_v197199",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul on psühhiaatrilise abi saamisel õigus: saada ravi ja põetust võrdsel alusel muude haigetega; saada teavet oma psüühikahäire ja kasutatavate ravi- ning diagnostikameetodite kohta ja tutvuda temasse puutuvate ravidokumentidega, välja arvatud juhul, kui see võib osutuda kahjulikuks tema vaimsele tervisele või teiste isikute julgeolekule. Otsuse teabe edastamise kohta teeb ja annab õiguse tutvuda ravidokumentidega tema raviarst, kes teeb sellekohase kande tema ravidokumenti; keelduda psühhiaatrilistest uuringutest ja ravist või neid katkestada, välja arvatud käesoleva seaduse §-des 11 ja 17 sätestatud juhtudel; kahju hüvitamisele ravi- või põetusvigadest põhjustatud kahju korral.",
      "rdfs:label": {
        "@value": "PsAS_Par_4 (redaktsioon 197199)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "197199"
    },
    {
      "@id": "estleg:PsAS_Par_5_v22369",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Arst on psüühikahäirete diagnoosimisel ja psühhiaatrilise abi andmisel sõltumatu ning juhindub arstiteadusest, arstieetikast, seadustest ja muudest õigusaktidest. (2) Psühhiaatrilist ravi ja diagnoosi puudutav teave on isiku eraelu saladus ja selle edastamine väljaspoole raviprotsessi on lubatud ainult isiku enda või tema seadusliku esindaja kirjalikul nõusolekul, samuti juurdlusorgani, politsei, prokuratuuri või kohtu seadusest tuleneva nõude alusel. (3) Psüühikahäirega isiku raviarst ei ole kohustatud andma kellelegi ütlusi isiku eraelu kohta, mida ta sai teada oma tööülesannete tõttu.",
      "rdfs:label": {
        "@value": "PsAS_Par_5 (redaktsioon 22369)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22369",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_5_v898852"
      },
      "estleg:versionValidTo": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_5_v898852",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Arst on psüühikahäirete diagnoosimisel ja psühhiaatrilise abi andmisel sõltumatu ning juhindub arstiteadusest, arstieetikast, seadustest ja muudest õigusaktidest. (2) Psühhiaatrilist ravi ja diagnoosi puudutav teave on isiku eraelu saladus ja selle edastamine väljapoole raviprotsessi on lubatud ainult isiku enda või tema seadusliku esindaja kirjalikul nõusolekul, samuti juurdlusorgani, politsei, prokuratuuri või kohtu seadusest tuleneva nõude alusel, narkootiliste ja psühhotroopsete ainete ning nende lähteainete seaduse (RT I 1997, 52, 834; 2001, 88, 531; 2002, 61, 375; 63, 387; 2003, 88, 591; 2005, 2, 4) alusel loodud narkomaaniaravi andmekogule esitamiseks ja Eesti Haigekassa nõudel talle seadusega pandud ülesannete täitmiseks. (3) Psüühikahäirega isiku raviarst ei ole kohustatud andma kellelegi ütlusi isiku eraelu kohta, mida ta sai teada oma tööülesannete tõttu.",
      "rdfs:label": {
        "@value": "PsAS_Par_5 (redaktsioon 898852)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898852",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_5_v12911534"
      },
      "estleg:versionValidTo": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_5_v12911534",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Arst on psüühikahäirete diagnoosimisel ja psühhiaatrilise abi andmisel sõltumatu ning juhindub arstiteadusest, arstieetikast, seadustest ja muudest õigusaktidest. (2) Psühhiaatrilist ravi ja diagnoosi puudutav teave on isiku eraelu saladus ja selle edastamine väljapoole raviprotsessi on lubatud ainult isiku enda või tema seadusliku esindaja kirjalikul nõusolekul, samuti juurdlusorgani, politsei, prokuratuuri või kohtu seadusest tuleneva nõude alusel, narkootiliste ja psühhotroopsete ainete ning nende lähteainete seaduse alusel loodud narkomaaniaravi andmekogule esitamiseks ja Eesti Haigekassa nõudel talle seadusega pandud ülesannete täitmiseks. (2<sup>1</sup>) Lõikes 2 sätestatu ei piira isikuandmete edastamist tervise infosüsteemi ja isikuandmete saamist tervise infosüsteemist vastavalt tervishoiuteenuste korraldamise seadusele. (3) Psüühikahäirega isiku raviarst ei ole kohustatud andma kellelegi ütlusi isiku eraelu kohta, mida ta sai teada oma tööülesannete tõttu.",
      "rdfs:label": {
        "@value": "PsAS_Par_5 (redaktsioon 12911534)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12911534",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_5_v13111233"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_5_v13111233",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Arst on psüühikahäirete diagnoosimisel ja psühhiaatrilise abi andmisel sõltumatu ning juhindub arstiteadusest, arstieetikast, seadustest ja muudest õigusaktidest. (2) Psühhiaatrilist ravi ja diagnoosi puudutav teave on isiku eraelu saladus ja selle edastamine väljapoole raviprotsessi on lubatud ainult isiku enda või tema seadusliku esindaja kirjalikul nõusolekul, samuti juurdlusorgani, politsei, prokuratuuri või kohtu seadusest tuleneva nõude alusel, narkootiliste ja psühhotroopsete ainete ning nende lähteainete seaduse alusel loodud narkomaaniaravi andmekogule esitamiseks ja Eesti Haigekassa nõudel talle seadusega pandud ülesannete täitmiseks. Teabe edastamine on lubatud isiku elukoha järgsele kohalikule omavalitsusele ja isiku lähedastele ulatuses, milles see on vajalik neile isikutele seisukoha või kaebuse esitamiseks isiku kinnisesse asutusse paigutamise menetluses. (2<sup>1</sup>) Lõikes 2 sätestatu ei piira isikuandmete edastamist tervise infosüsteemi ja isikuandmete saamist tervise infosüsteemist vastavalt tervishoiuteenuste korraldamise seadusele. (3) Psüühikahäirega isiku raviarst ei ole kohustatud andma kellelegi ütlusi isiku eraelu kohta, mida ta sai teada oma tööülesannete tõttu.",
      "rdfs:label": {
        "@value": "PsAS_Par_5 (redaktsioon 13111233)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13111233",
      "estleg:supersededByVersion": {
        "@id": "estleg:PsAS_Par_5_v123022011030"
      },
      "estleg:versionValidTo": {
        "@value": "2011-04-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_5_v123022011030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PsAS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Arst on psüühikahäirete diagnoosimisel ja psühhiaatrilise abi andmisel sõltumatu ning juhindub arstiteadusest, arstieetikast, seadustest ja muudest õigusaktidest. (2) Psühhiaatrilist ravi ja diagnoosi puudutav teave on isiku eraelu saladus ja selle edastamine väljapoole raviprotsessi on lubatud ainult isiku enda või tema seadusliku esindaja kirjalikul nõusolekul, samuti uurimisasutuse, politsei, prokuratuuri, kriminaalhooldusosakonna või kohtu seadusest tuleneva nõude alusel, narkootiliste ja psühhotroopsete ainete ning nende lähteainete seaduse alusel loodud narkomaaniaravi andmekogule esitamiseks ja Eesti Haigekassa nõudel talle seadusega pandud ülesannete täitmiseks. Teabe edastamine on lubatud isiku elukoha järgsele kohalikule omavalitsusele ja isiku lähedastele ulatuses, milles see on vajalik neile isikutele seisukoha või kaebuse esitamiseks isiku kinnisesse asutusse paigutamise menetluses. (2<sup>1</sup>) Lõikes 2 sätestatu ei piira isikuandmete edastamist tervise infosüsteemi ja isikuandmete saamist tervise infosüsteemist vastavalt tervishoiuteenuste korraldamise seadusele. (3) Psüühikahäirega isiku raviarst ei ole kohustatud andma kellelegi ütlusi isiku eraelu kohta, mida ta sai teada oma tööülesannete tõttu.",
      "rdfs:label": {
        "@value": "PsAS_Par_5 (redaktsioon 123022011030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123022011030",
