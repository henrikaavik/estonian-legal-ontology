      },
      "estleg:versionValidTo": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PsAS_Par_6_v197199",
      "@type": [
        "owl:NamedIndividual",
