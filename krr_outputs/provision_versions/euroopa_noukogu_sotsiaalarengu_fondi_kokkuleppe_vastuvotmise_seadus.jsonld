      "estleg:provisionRef": "ENSFKV § 1",
      "estleg:partOfAct": {
        "@id": "estleg:ENSFKV_Map_2026"
      }
    },
    {
      "@id": "estleg:ENSFKV_Par_2_v78842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ENSFKV_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi valitsus on volitatud tellima osalussertifikaate arvul, mis on määratud kokkuleppel fondi juhatusega käesoleva seadusega vastuvõetud kokkuleppe artikli IX § 3 lõike 1 punkti a kohaselt.",
      "rdfs:label": {
        "@value": "ENSFKV_Par_2 (redaktsioon 78842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "78842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/78842",
      "estleg:sourceAct": "Euroopa Nõukogu Sotsiaalarengu Fondi kokkuleppe vastuvõtmise seadus",
      "estleg:provisionRef": "ENSFKV § 2",
      "estleg:partOfAct": {
        "@id": "estleg:ENSFKV_Map_2026"
      }
    },
    {
      "@id": "estleg:ENSFKV_Par_3_v78842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ENSFKV_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariik kinnitab oma kavatsust ühineda esimesel võimalusel Euroopa Nõukogu privileegide ja immuniteetide üldkokkuleppe kolmanda protokolliga ja rakendab kuni selle jõustumiseni Eesti Vabariigi suhtes nimetatud protokolli järgseid õiguslikke meetmeid fondi omandi, varade ja tehingute suhtes ning annab fondi organitele ja personalile protokollijärgse õigusliku staatuse. Riigikogu esimees Toomas SAVI Õiend Akti metaandmed ja sisu tehniliselt korrastatud",
      "rdfs:label": {
        "@value": "ENSFKV_Par_3 (redaktsioon 78842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "78842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/78842",
      "estleg:sourceAct": "Euroopa Nõukogu Sotsiaalarengu Fondi kokkuleppe vastuvõtmise seadus",
      "estleg:provisionRef": "ENSFKV § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ENSFKV_Map_2026"
      }
    }
  ]
