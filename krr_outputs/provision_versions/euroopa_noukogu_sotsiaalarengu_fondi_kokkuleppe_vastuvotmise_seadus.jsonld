      },
      "estleg:versionText": "Võetakse vastu juurdelisatud (edaspidifond) kokkulepe.",
      "rdfs:label": {
        "@value": "ENSFKV_Par_1 (redaktsioon 78842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "78842",
