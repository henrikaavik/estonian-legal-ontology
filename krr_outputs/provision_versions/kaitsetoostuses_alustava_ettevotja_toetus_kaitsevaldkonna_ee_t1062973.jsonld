    {
      "@id": "estleg:Reg_1062973_Par_21_v1062973",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062973_Par_21"
