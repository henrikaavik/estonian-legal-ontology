    {
      "@id": "estleg:Reg_314059_Par_2_v314059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_314059_Par_2"
