      }
    },
    {
      "@id": "estleg:NETS_Par_44_v13227471",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NETS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalvet käesoleva seaduse ja selle alusel kehtestatud õigusaktidest tulenevate nõuete täitmise üle teostab Terviseamet, kui seadusega ei ole sätestatud teisiti. (1<sup>1</sup>) –(2) Kehtetud – (3) Järelevalve teostamisel tehtavale ettekirjutusele kohaldatakse haldusmenetluse seadust.",
      "rdfs:label": {
        "@value": "NETS_Par_44 (redaktsioon 13227471)",
        "@language": "et"
      },
