    {
      "@id": "estleg:NETS_Par_26_v264826",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NETS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nakkushaiguste leviku tõkestamiseks eriolukorra ajal abinõusid rakendades järgitakse eriolukorra seadust (RT I 1996, 8, 164; 1999, 57, 598; 2002, 57, 354; 61, 375; 63, 387).",
      "rdfs:label": {
        "@value": "NETS_Par_26 (redaktsioon 264826)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264826",
