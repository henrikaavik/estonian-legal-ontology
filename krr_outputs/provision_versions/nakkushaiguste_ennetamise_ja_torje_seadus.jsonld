        "@value": "2021-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NETS_Par_44_v101072020009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NETS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete täitmise üle teostab Terviseamet (edaspidi korrakaitseorgan). (2) Järelevalvet käesoleva seaduse § 13 lõike 1 punktide 1 ja 2 nõuete täitmise üle teeb Põllumajandus- ja Toiduamet. Põllumajandus- ja Toiduamet teostab järelevalvet joogivee käitleja üle toiduseaduses sätestatud ulatuses.",
      "rdfs:label": {
        "@value": "NETS_Par_44 (redaktsioon 101072020009)",
        "@language": "et"
      },
