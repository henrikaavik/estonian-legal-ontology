      },
      "estleg:versionText": "Välismaalase haldusorgani kutsel haldusorgani asukohta mitteilmumise korral võib haldusorgan alustada välismaalase tagaotsimise. Välismaalase haldusorgani kutsel haldusorgani asukohta mitteilmumise korral võib haldusorgan alustada välismaalase tagaotsimise.",
      "rdfs:label": {
        "@value": "Reg_345863_Par_1 (redaktsioon 345863)",
        "@language": "et"
      },
