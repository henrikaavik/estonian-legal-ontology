      "estleg:provisionRef": "Reg_1025350 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025350_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025350_Par_15_v1025350",
      "@type": [
        "owl:NamedIndividual",
