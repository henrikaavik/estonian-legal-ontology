      }
    },
    {
      "@id": "estleg:Reg_1025350_Par_2_v1025350",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025350_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametil on oma eelarve. Ametil on arvelduskontod riigikassa kontsernikonto koosseisus. Ametil on oma eelarve. Ametil on arvelduskontod riigikassa kontsernikonto koosseisus. 2 (2) Ameti kulud kaetakse riigieelarvest. Ameti kulud kaetakse riigieelarvest. 3 (3) Ameti eelarve kinnitab, seda muudab ja selle täitmist kontrollib valdkonna eest vastutav minister. Ameti eelarve kinnitab, seda muudab ja selle täitmist kontrollib valdkonna eest vastutav minister. 4 (4) Ameti kopteri kiirabilennu kulud kaetakse Tervisekassa eelarvest. RT I 2024-07-09 1 109072024001 2024-08-01 Ameti kopteri kiirabilennu kulud kaetakse Tervisekassa eelarvest.",
      "rdfs:label": {
