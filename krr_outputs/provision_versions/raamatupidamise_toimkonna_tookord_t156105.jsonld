    {
      "@id": "estleg:Reg_156105_Par_15_v156105",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156105_Par_15"
