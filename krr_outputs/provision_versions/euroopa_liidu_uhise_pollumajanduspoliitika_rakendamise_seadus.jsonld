        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Töötlemistoetuse saamiseks esitab isik vormikohase kirjaliku taotluse PRIA-le. (2) Töötlemistoetuse taotlemise ja taotluse menetlemise täpsema korra, taotluse vormi ning menetluse ajal väljastatavate dokumentide ning toetuse maksmise aluseks olevate dokumentide vormid kehtestab põllumajandusminister.",
      "rdfs:label": {
        "@value": "ELUP_Par_23 (redaktsioon 750786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750786",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_23_v843503"
      },
      "estleg:versionValidTo": {
        "@value": "2005-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/750786",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 23",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_23_v843503",
      "@type": [
        "owl:NamedIndividual",
