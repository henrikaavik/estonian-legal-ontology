    {
      "@id": "estleg:ELUP_Par_6_v126092023003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sertifitseerimisasutus Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2116 artikli 12 ning Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 artikli 9 tähenduses on Regionaal- ja Põllumajandusministeerium. (2) Regionaal- ja Põllumajandusministeerium võib sõlmida Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2116 artiklis 12 ning Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 artiklis 9 sätestatud ülesande täitmiseks halduskoostöö seaduses sätestatud korras halduslepingu eraõigusliku juriidilise isikuga, kellel on tehniline oskusteave ja teadmised ühise põllumajanduspoliitika kohta ning küllaldane toetuste auditeerimise kogemus. Eraõigusliku juriidilise isiku volitamise nimetatud ülesande täitmiseks otsustab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
        "@value": "ELUP_Par_6 (redaktsioon 126092023003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126092023003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126092023003",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 6",
      "estleg:partOfAct": {
