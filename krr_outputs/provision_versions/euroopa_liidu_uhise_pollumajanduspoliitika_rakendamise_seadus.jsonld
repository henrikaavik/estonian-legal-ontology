    {
      "@id": "estleg:ELUP_Par_13_v922110",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_13"
      },
