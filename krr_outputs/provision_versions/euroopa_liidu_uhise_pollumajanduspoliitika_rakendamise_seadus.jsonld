      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühise põllumajanduspoliitika abinõude rakendamisel saadud andmed edastab Euroopa Komisjonile Euroopa Liidu õigusaktides sätestatud tähtaegadel ja korras Põllumajandusministeerium või põllumajandusministri määratud valitsemisala riigiasutus.",
      "rdfs:label": {
        "@value": "ELUP_Par_3 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
