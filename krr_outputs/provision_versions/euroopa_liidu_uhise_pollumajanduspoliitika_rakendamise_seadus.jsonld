      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Arengukava seire ja hindamise korra (2) Maaelu arengu toetuse saaja esitab toetuse saamise ja kasutamise kohta seireks ja hindamiseks vajaliku teabe. Arengukava seiret või hindamist tegev isik võib toetuse seireks ja hindamiseks vajalikke tegevusi teha toetuse saaja ettevõttes või majapidamises üksnes toetuse saaja nõusolekul.",
      "rdfs:label": {
        "@value": "ELUP_Par_64 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
