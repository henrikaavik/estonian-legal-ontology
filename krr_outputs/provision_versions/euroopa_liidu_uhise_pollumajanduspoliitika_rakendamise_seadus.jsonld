        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühise põllumajanduspoliitika toetusabinõude rakendamisel saadud andmed edastab Euroopa Komisjonile Põllumajandusministeerium või põllumajandusministri määratud riigiasutus.",
      "rdfs:label": {
        "@value": "ELUP_Par_5 (redaktsioon 12807907)",
