        "@value": "2025-02-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-des 127 ja 1271 sätestatud väärtegude kohtuväline menetleja on oma pädevuse piires PRIA või Põllumajandus- ja Toiduamet.",
      "rdfs:label": {
        "@value": "ELUP_Par_128 (redaktsioon 114022025004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114022025004",
