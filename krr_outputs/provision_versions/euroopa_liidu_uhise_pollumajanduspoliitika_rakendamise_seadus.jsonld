        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-s 127 sätestatud väärteo kohtuväline menetleja on oma pädevuse piires PRIA või Põllumajandus- ja Toiduamet.",
      "rdfs:label": {
        "@value": "ELUP_Par_128 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
