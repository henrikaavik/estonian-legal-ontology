      }
    },
    {
      "@id": "estleg:ELUP_Par_130_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_130"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2023. aasta 1. jaanuari kehtinud Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse § 6 lõike 2, § 65 lõike 7 ja § 68 lõike 2 alusel sõlmitud ning käesoleva seaduse jõustumise ajal kehtiv haldusleping kehtib kuni lepingus sätestatud tähtpäevani.",
      "rdfs:label": {
        "@value": "ELUP_Par_130 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 130",
