      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/101092015003",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 137",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_137_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_137"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2023. aasta 1. jaanuari kehtinud Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse § 88 alusel tunnustatud tootjarühma tunnustus kehtib kuni ühise põllumajanduspoliitika abinõus osalemise lõpuni.",
      "rdfs:label": {
        "@value": "ELUP_Par_137 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 137",
      "estleg:partOfAct": {
