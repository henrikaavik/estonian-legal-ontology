        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus (RT I 2009, 56, 375) tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "ELUP_Par_137 (redaktsioon 104122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122014003",
