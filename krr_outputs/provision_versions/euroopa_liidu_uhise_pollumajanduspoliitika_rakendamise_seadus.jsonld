      },
      "estleg:versionValidTo": {
        "@value": "2005-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/843503",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 66",
