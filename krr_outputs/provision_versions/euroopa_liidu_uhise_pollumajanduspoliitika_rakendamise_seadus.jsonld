    },
    {
      "@id": "estleg:ELUP_Par_24_v13236848",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Püsirohumaa pindala tuleb säilitada nõukogu määruse (EÜ) nr 73/2009 artikli 6 lõike 2 kohaselt. (2) Püsirohumaa pindala üle peab arvestust PRIA. (3) Püsirohumaa pindala säilitamise kohustuse täitmise täpsema korra, püsirohumaa pindala säilitamise kohustuse üleandmise alused ja korra ning komisjoni määruse (EÜ) nr 796/2004 artiklis 4 nimetatud püsirohumaa pindala säilitamiseks vajalike abinõude rakendamise täpsema korra toetuse taotlejale esitatavate lisanõuetena (4) PRIA avaldab vajaduse korral teabe püsirohumaa pindala säilitamiseks vajalike abinõude rakendamise kohta ametlikus väljaandes Ametlikud Teadaanded.",
      "rdfs:label": {
        "@value": "ELUP_Par_24 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
