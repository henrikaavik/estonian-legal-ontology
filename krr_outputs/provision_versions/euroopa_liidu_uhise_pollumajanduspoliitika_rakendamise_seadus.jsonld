      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 112 lõikes 1 nimetatud põllumajandustoetuste ja põllumassiivide registrina käsitatakse enne käesoleva seaduse jõustumist kehtinud õigusaktide alusel asutatud põllumajandustoetuste ja põllumassiivide registrit.",
      "rdfs:label": {
        "@value": "ELUP_Par_139 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 139",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_14_v750786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui nõuetekohaste taotluste alusel toetuskõlblikuks tunnistatud põllumajandusmaa kogupindala on suurem kui 800 000 ha, vähendatakse ühikumäära võrdeliselt, järgides taotlejate võrdse kohtlemise põhimõtet. (2) Ühikumäära vähendamise otsuse teeb Põllumajandusministeerium PRIA-lt saadud andmete alusel. Ühikumäära vähendamise korral teatab Põllumajandusministeerium Euroopa Komisjonile toetuse ühikumäära vähendamise koefitsiendi.",
      "rdfs:label": {
        "@value": "ELUP_Par_14 (redaktsioon 750786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750786",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_14_v12760420"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/750786",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 14",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_14_v12760420",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui nõuetekohaste taotluste alusel toetuskõlblikuks tunnistatud põllumajandusmaa kogupindala on suurem kui 800 000 ha, vähendatakse ühikumäära võrdeliselt, järgides taotlejate võrdse kohtlemise põhimõtet. (2) Kehtetu –",
      "rdfs:label": {
        "@value": "ELUP_Par_14 (redaktsioon 12760420)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12760420",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_14_v13236848"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12760420",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 14",
      "estleg:partOfAct": {
