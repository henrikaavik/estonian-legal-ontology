    },
    {
      "@id": "estleg:ELUP_Par_29_v13236848",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Töötlemistoetuse rakendamise korral kontrollib põllumajandustoote vastavust kvaliteedi- ja koostisnõuetele ning toote hoiu- ja säilitusruumi nõuetekohasust PRIA.",
      "rdfs:label": {
        "@value": "ELUP_Par_29 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
