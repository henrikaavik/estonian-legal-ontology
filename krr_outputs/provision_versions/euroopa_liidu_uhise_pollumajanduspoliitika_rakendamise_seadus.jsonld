      }
    },
    {
      "@id": "estleg:ELUP_Par_14_v13236848",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Otsetoetuse taotleja täidab Euroopa Liidu asjakohastes määrustes ja käesoleva seaduse § 23 lõikes 1 sätestatud nõudeid kogu põllumajanduslikus majapidamises. (2) Ühtset pindalatoetust võib taotleda vähemalt 1 ha heas põllumajanduslikus korras põllumajandusmaa kohta: mille pindala määramisel võetakse arvesse põld pindalaga vähemalt 0,30 ha; mille kohta on põllumajandustoetuste ja põllumassiivide registris andmed, mille kohaselt oli põllumajandusmaa 2003. aastal heas põllumajanduslikus korras nõukogu määruse (EÜ) nr 73/2009 artikli 124 mõistes; mida taotleja kasutab taotluse esitamise aasta 15. juunil. (3) Nõukogu määruse (EÜ) nr 73/2009 artikli 68 alusel antava toetuse saamise nõuded kooskõlas samas nõukogu määruses sätestatud nõuetega. Nõuded võib kehtestada eraldi iga otsetoetuse liigi kohta.",
      "rdfs:label": {
        "@value": "ELUP_Par_14 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_14_v13283268"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236848",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 14",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_14_v13283268",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Otsetoetuse taotleja täidab Euroopa Liidu asjakohastes määrustes ja käesoleva seaduse § 23 lõikes 1 sätestatud nõudeid kogu põllumajanduslikus majapidamises. (2) Ühtset pindalatoetust võib taotleda vähemalt 1 ha heas põllumajanduslikus korras põllumajandusmaa kohta: mille pindala määramisel võetakse arvesse põld pindalaga vähemalt 0,30 ha; mille kohta on põllumajandustoetuste ja põllumassiivide registris andmed, mille kohaselt oli põllumajandusmaa 2003. aastal heas põllumajanduslikus korras nõukogu määruse (EÜ) nr 73/2009 artikli 124 mõistes; mida taotleja kasutab taotluse esitamise aasta 15. juunil. (2¹) Ühtset pindalatoetust võib taotleda ka käesoleva paragrahvi lõikes 2 sätestatud nõuetele vastava põllumajandusmaa kohta, millel kasvatatakse CN-koodi 0602 90 41 alla kuuluvaid lühikese raieringiga madalmetsas kasvatamiseks sobivaid puuliike. Nimetatud madalmetsa võib rajada ja kasvatada põllumajandusmaal, mille mulla keskmine boniteet on kuni 35 hindepunkti ning kus madalmetsa rajamine ja kasvatamine on kooskõlas maaparandusseaduses ja looduskaitseseaduses sätestatuga. Lühikese raieringiga madalmetsa kasvatamiseks sobivate puuliikide loetelu ja maksimaalse raieringi pikkuse (3) Nõukogu määruse (EÜ) nr 73/2009 artikli 68 alusel antava toetuse saamise nõuded kooskõlas samas nõukogu määruses sätestatud nõuetega. Nõuded võib kehtestada eraldi iga otsetoetuse liigi kohta.",
      "rdfs:label": {
        "@value": "ELUP_Par_14 (redaktsioon 13283268)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13283268",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_14_v117112011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13283268",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 14",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_14_v117112011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Otsetoetuse taotleja täidab Euroopa Liidu asjakohastes määrustes ja käesoleva seaduse § 23 lõikes 1 sätestatud nõudeid kogu põllumajanduslikus majapidamises. (2) Ühtset pindalatoetust võib taotleda vähemalt 1 ha põllumajandusmaa kohta, mida hoitakse heades põllumajandus- ja keskkonnatingimustes ning: mille pindala määramisel võetakse arvesse põld pindalaga vähemalt 0,30 ha, sealhulgas kuni 2 m laiune hekk, kraav, piire või muu traditsiooniline maastikuobjekt komisjoni määruse (EÜ) nr 1122/2009, millega kehtestatakse nõukogu määruse (EÜ) nr 73/2009 üksikasjalikud rakenduseeskirjad seoses põllumajandustootjate otsetoetuskavade alusel makstavate toetuste nõuetele vastavusega, ümbersuunamisega ning ühtse haldus- ja kontrollisüsteemiga ning määruse (EÜ) nr 1234/2007 üksikasjalikud rakenduseeskirjad seoses veinisektori toetuskavade alusel makstavate toetuste nõuetele vastavusega (ELT L 316, 02.12.2009, lk 65–112), artikli 34 lõike 2 kohaselt; mille kohta on põllumajandustoetuste ja põllumassiivide registris andmed, mille kohaselt oli põllumajandusmaa 2003. aasta 30. juunil heas põllumajanduslikus korras nõukogu määruse (EÜ) nr 73/2009 artikli 124 lõike 1 mõistes; mida taotleja kasutab taotluse esitamise aasta 15. juunil. (2¹) Ühtset pindalatoetust võib taotleda ka käesoleva paragrahvi lõikes 2 sätestatud nõuetele vastava põllumajandusmaa kohta, millel kasvatatakse CN-koodi 0602 90 41 alla kuuluvaid lühikese raieringiga madalmetsas kasvatamiseks sobivaid puuliike. Nimetatud madalmetsa võib rajada ja kasvatada põllumajandusmaal, mille mulla keskmine boniteet on kuni 35 hindepunkti ning kus madalmetsa rajamine ja kasvatamine on kooskõlas maaparandusseaduses ja looduskaitseseaduses sätestatuga. Lühikese raieringiga madalmetsa kasvatamiseks sobivate puuliikide loetelu ja maksimaalse raieringi pikkuse (3) Nõukogu määruse (EÜ) nr 73/2009 artikli 68 alusel antava toetuse saamise nõuded kooskõlas samas nõukogu määruses sätestatud nõuetega. Nõuded võib kehtestada eraldi iga otsetoetuse liigi kohta.",
      "rdfs:label": {
        "@value": "ELUP_Par_14 (redaktsioon 117112011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112011002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_14_v121052014030"
      },
      "estleg:versionValidTo": {
        "@value": "2014-05-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117112011002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 14",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
