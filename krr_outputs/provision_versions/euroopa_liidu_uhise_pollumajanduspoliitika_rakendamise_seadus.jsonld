      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12760420",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 20",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_20_v13236848",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Täiendavat otsetoetust vähendatakse alustel, mis on sätestatud komisjoni määruses (EÜ) nr 796/2004, millega kehtestatakse nõukogu määruses (EÜ) nr 1782/2003 (millega kehtestatakse ühise põllumajanduspoliitika raames kohaldatavate otsetoetuskavade ühiseeskirjad ja teatavad toetuskavad põllumajandustootjate jaoks) ette nähtud nõuetele vastavuse, toetuse ümbersuunamise ning ühtse haldus- ja kontrollisüsteemi rakendamise üksikasjalikud reeglid (ELT L 141, 30.04.2004, lk 18–58). (2) Täiendava otsetoetuse vähendamise täpsemad alused toetuse liikide kaupa",
      "rdfs:label": {
        "@value": "ELUP_Par_20 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_20_v13283268"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236848",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 20",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_20_v13283268",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Täiendavat otsetoetust vähendatakse alustel, mis on sätestatud komisjoni määruses (EÜ) nr 1122/2009, millega kehtestatakse nõukogu määruse (EÜ) nr 73/2009 üksikasjalikud rakenduseeskirjad seoses põllumajandustootjate otsetoetuskavade alusel makstavate toetuste nõuetele vastavusega, ümbersuunamisega ning ühtse haldus- ja kontrollisüsteemiga ning määruse (EÜ) nr 1234/2007 üksikasjalikud rakenduseeskirjad seoses veinisektori toetuskavade alusel makstavate toetuste nõuetele vastavusega (ELT L 316, 02.12.2009, lk 65–112). (2) Täiendava otsetoetuse vähendamise täpsemad alused toetuse liikide kaupa",
      "rdfs:label": {
        "@value": "ELUP_Par_20 (redaktsioon 13283268)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13283268",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_20_v117112011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13283268",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 20",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_20_v117112011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Täiendavat otsetoetust vähendatakse, kui: toetusõiguslikuks tunnistatud ühtse pindalatoetuse hektarite arv on väiksem käesoleva seaduse § 16 lõike 1 punktide 1 ja 6 alusel taotlejale määratud täiendava otsetoetuse toetusõiguste arvust või § 17 alusel omandatud § 16 lõike 1 punktide 1 ja 6 alusel taotlejale määratud täiendava otsetoetuse toetusõiguste arvust; toetusõiguslikuks tunnistatud põllumajandusloomade arv on väiksem taotlusel märgitud põllumajandusloomade arvust; taotleja peetavasse põllumajandusloomade arvestusse või veisepassi on kantud valeandmeid. (2) Täiendava otsetoetuse vähendamise ja selle arvutamise täpsemad alused toetuse liikide kaupa",
      "rdfs:label": {
        "@value": "ELUP_Par_20 (redaktsioon 117112011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112011002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_20_v121022013002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-02-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117112011002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 20",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_20_v121022013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-02-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Täiendavat otsetoetust ja üleminekutoetust vähendatakse, kui: toetusõiguslikuks tunnistatud ühtse pindalatoetuse hektarite arv on väiksem käesoleva seaduse § 16 lõike 1 punktide 1 ja 6 alusel taotlejale määratud täiendava otsetoetuse toetusõiguste arvust või § 17 alusel omandatud § 16 lõike 1 punktide 1 ja 6 alusel taotlejale määratud täiendava otsetoetuse toetusõiguste arvust; toetusõiguslikuks tunnistatud põllumajandusloomade arv on väiksem taotlusel märgitud põllumajandusloomade arvust; taotleja peetavasse põllumajandusloomade arvestusse või veisepassi on kantud valeandmeid. (2) Täiendava otsetoetuse ja üleminekutoetuse vähendamise ja selle arvutamise täpsemad alused toetuse liikide kaupa",
      "rdfs:label": {
