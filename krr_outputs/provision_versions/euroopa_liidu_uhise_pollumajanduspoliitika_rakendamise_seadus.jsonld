      "estleg:versionText": "võib määrusega kehtestada tootmiskvoodi ja riikliku koguse täitmise kohta andmete esitamise, arvestuse pidamise, samuti kvoodi suuruse korrigeerimise täpsemad nõuded ning ekvivalentkoguse.",
      "rdfs:label": {
        "@value": "ELUP_Par_37 (redaktsioon 121052014031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121052014031",
