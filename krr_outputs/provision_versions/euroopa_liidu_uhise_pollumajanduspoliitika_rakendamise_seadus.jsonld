      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "maaelu arengu toetuse kasutamise ning käesoleva seaduse § 51 lõikes 1 nimetatud programmi seire ja hindamise korra. Seire korra ja hindamise korra võib kehtestada eraldi.",
      "rdfs:label": {
        "@value": "ELUP_Par_56 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
