    {
      "@id": "estleg:ELUP_Par_24_v121052014031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Püsirohumaa pindala tuleb säilitada nõukogu määruse (EÜ) nr 73/2009 artikli 6 lõike 2 kohaselt. (2) Püsirohumaa pindala üle peab arvestust PRIA. (3) Püsirohumaa pindala säilitamise kohustuse täitmise täpsema korra, püsirohumaa pindala säilitamise kohustuse üleandmise alused ja korra ning komisjoni määruse (EÜ) nr 1122/2009 artiklis 4 nimetatud püsirohumaa pindala säilitamiseks vajalike abinõude rakendamise täpsema korra toetuse taotlejale esitatavate lisanõuetena kehtestab määrusega. (4) PRIA avaldab vajaduse korral teabe püsirohumaa pindala säilitamiseks vajalike abinõude rakendamise kohta ametlikus väljaandes Ametlikud Teadaanded.",
      "rdfs:label": {
        "@value": "ELUP_Par_24 (redaktsioon 121052014031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121052014031",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_24_v104122014003"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121052014031",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 24",
      "estleg:partOfAct": {
