    {
      "@id": "estleg:ELUP_Par_79_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruste (EL) nr 1308/2013 ja (EL) 2021/2116 alusel kehtestatud õigusaktides sätestatud nõuetele vastav ladustamiskoht leitakse hankemenetluse kaudu riigihangete seaduses sätestatud alustel ja korras. (2) võib määrusega kehtestada sekkumiskokkuostul kasutatava ladustamiskoha kohta esitatavad täpsemad nõuded.",
      "rdfs:label": {
        "@value": "ELUP_Par_79 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 79",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_8_v750786",
      "@type": [
