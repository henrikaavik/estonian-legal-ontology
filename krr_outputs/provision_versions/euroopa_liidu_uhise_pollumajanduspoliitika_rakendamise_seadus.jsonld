    {
      "@id": "estleg:ELUP_Par_105_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_105"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu määruse (EÜ) nr 1217/2009, millega luuakse Euroopa Liidu põllumajanduslike majapidamiste tulusid ja majandustegevust käsitlevate raamatupidamisandmete kogumise võrk (ELT L 328, 15.12.2009, lk 27), artiklis 7 sätestatud kontaktasutuse ülesannete täitmist korraldab Maaeluministeerium. (2) Maaeluministeerium võib käesoleva paragrahvi lõikes 1 nimetatud kontaktasutuse ülesannete täitmiseks määrata valitsemisala asutuse, valida juriidilise isiku, kellega sõlmitakse halduskoostöö seaduses sätestatud korras haldusleping, või täita neid ülesandeid ise. (3) Põllumajanduslike raamatupidamisandmete kogumiseks sõlmib kontaktasutus andmekogujatega ja aruandvate majapidamistega nõukogu määruse (EÜ) nr 1217/2009 artikli 5a alusel koostatud valimiplaani alusel asjakohased lepingud. (4) Käesoleva paragrahvi lõikes 3 nimetatud aruandvad majapidamised ei tohi lepingu lõppemisel keelata lepingu kehtivuse ajal esitatud andmete edasist töötlemist.",
      "rdfs:label": {
        "@value": "ELUP_Par_105 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_105_v126092023003"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 105",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_105_v126092023003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_105"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu määruse (EÜ) nr 1217/2009, millega luuakse Euroopa Liidu põllumajanduslike majapidamiste tulusid ja majandustegevust käsitlevate raamatupidamisandmete kogumise võrk (ELT L 328, 15.12.2009, lk 27), artiklis 7 sätestatud kontaktasutuse ülesannete täitmist korraldab Regionaal- ja Põllumajandusministeerium. (2) Regionaal- ja Põllumajandusministeerium võib käesoleva paragrahvi lõikes 1 nimetatud kontaktasutuse ülesannete täitmiseks määrata valitsemisala asutuse, valida juriidilise isiku, kellega sõlmitakse halduskoostöö seaduses sätestatud korras haldusleping, või täita neid ülesandeid ise. (3) Põllumajanduslike raamatupidamisandmete kogumiseks sõlmib kontaktasutus andmekogujatega ja aruandvate majapidamistega nõukogu määruse (EÜ) nr 1217/2009 artikli 5a alusel koostatud valimiplaani alusel asjakohased lepingud. (4) Käesoleva paragrahvi lõikes 3 nimetatud aruandvad majapidamised ei tohi lepingu lõppemisel keelata lepingu kehtivuse ajal esitatud andmete edasist töötlemist.",
      "rdfs:label": {
        "@value": "ELUP_Par_105 (redaktsioon 126092023003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126092023003",
