      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühise põllumajanduspoliitika abinõude rakendamisel saadud andmed edastab Euroopa Komisjonile Euroopa Liidu õigusaktides sätestatud tähtaegadel ja korras Põllumajandusministeerium või valdkonna eest vastutava ministri määratud valitsemisala riigiasutus.",
      "rdfs:label": {
        "@value": "ELUP_Par_3 (redaktsioon 121052014031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121052014031",
