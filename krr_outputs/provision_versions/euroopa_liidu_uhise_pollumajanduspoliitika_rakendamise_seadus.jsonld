      }
    },
    {
      "@id": "estleg:ELUP_Par_21_v12760420",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kasutustoetuse saamiseks esitab isik vormikohase kirjaliku taotluse PRIA-le. (2) Komisjoni määruses (EÜ) nr 1898/2005, millega kehtestatakse nõukogu määruse (EÜ) nr 1255/1999 üksikasjalikud rakenduseeskirjad seoses koore, või ja kontsentreeritud või realiseerimise meetmetega ühenduse turul (ELT L 308, 25.11.2005, lk 1–63), sätestatud alandatud hinnaga või müügi puhul toetuse andmise korral võib Vabariigi Valitsus või tema volitatud minister kehtestada nende isikute nimekirja, kellele toetuse taotleja võib alandatud hinnaga võid müüa. (3) Kasutustoetuse taotlemise ja taotluse menetlemise täpsema korra, taotluse vormi ning menetluse ajal väljastatavate dokumentide ning toetuse maksmise aluseks olevate dokumentide vormid",
      "rdfs:label": {
        "@value": "ELUP_Par_21 (redaktsioon 12760420)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12760420",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_21_v13236848"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12760420",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 21",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_21_v13236848",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täiendava otsetoetuse taotlus jäetakse rahuldamata, kui: taotleja ei ole põllumajandusliku tegevusega tegelev isik, ei kasvata toetuskõlblikke põllumajandusloomi ega põllukultuure ning tal ei ole taotluse esitamise aastal ühtegi kindlaksmääratud ühtse pindalatoetuse hektarit; taotleja ei oma täiendava otsetoetuse toetusõigust; taotluses esitatud või menetlemise käigus kindlaksmääratud põllumajandusmaa pindala või põllumajandusloomade arv on väiksem toetuse saamiseks vajalikust põllumajandusmaa pindalast või põllumajandusloomade arvust; esinevad komisjoni määruse (EÜ) nr 796/2004 artiklis 59 nimetatud taotluse rahuldamata jätmise alused, arvestades sama määruse artiklis 68 nimetatud erandeid; taotleja ei vasta muudele toetuse saamise nõuetele; taotleja on esitanud teadlikult valeandmeid või mõjutab taotluse menetlemist pettuse või ähvardusega või muul õigusvastasel viisil; taotleja ei võimalda teha kohapealset kontrolli; taotleja ei ole puuduste kõrvaldamiseks määratud tähtaja jooksul neid kõrvaldanud.",
      "rdfs:label": {
        "@value": "ELUP_Par_21 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_21_v13283268"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236848",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 21",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_21_v13283268",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täiendava otsetoetuse taotlus jäetakse rahuldamata, kui: taotleja ei ole põllumajandusliku tegevusega tegelev isik, ei kasvata toetuskõlblikke põllumajandusloomi ega põllukultuure ning tal ei ole taotluse esitamise aastal ühtegi kindlaksmääratud ühtse pindalatoetuse hektarit; taotleja ei oma täiendava otsetoetuse toetusõigust; taotluses esitatud või menetlemise käigus kindlaksmääratud põllumajandusmaa pindala või põllumajandusloomade arv on väiksem toetuse saamiseks vajalikust põllumajandusmaa pindalast või põllumajandusloomade arvust; esinevad komisjoni määruse (EÜ) nr 1122/2009 artiklis 65 nimetatud taotluse rahuldamata jätmise alused, arvestades sama määruse artiklis 73 toodud erandeid; taotleja ei vasta muudele toetuse saamise nõuetele; taotleja on esitanud teadlikult valeandmeid või mõjutab taotluse menetlemist pettuse või ähvardusega või muul õigusvastasel viisil; taotleja ei võimalda teha kohapealset kontrolli; taotleja ei ole puuduste kõrvaldamiseks määratud tähtaja jooksul neid kõrvaldanud.",
      "rdfs:label": {
        "@value": "ELUP_Par_21 (redaktsioon 13283268)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13283268",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_21_v117112011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13283268",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 21",
      "estleg:partOfAct": {
