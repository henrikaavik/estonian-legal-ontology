      }
    },
    {
      "@id": "estleg:ELUP_Par_103_v104122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riikliku järelevalve käigus kontrollitakse ühise põllumajanduspoliitika abinõude rakendamiseks esitatud nõuete täitmist ja toetuse saaja tegevuse vastavust pärast toetuse maksmist taotluse rahuldamise otsuses, asjakohastes Euroopa Liidu õigusaktides ning käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuetele. (2) Haldusjärelevalve käigus kontrollitakse käesoleva seaduse kohaselt sõlmitud halduslepingute täitmist ja toetuse saaja tegevuse vastavust pärast toetuse maksmist taotluse rahuldamise otsuses, asjakohastes Euroopa Liidu õigusaktides ning käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuetele, kui toetuse saajaks on riigi või kohaliku omavalitsuse asutus või muu avaliku halduse ülesandeid täitma volitatud isik või asutus või kohalik tegevusgrupp.",
      "rdfs:label": {
        "@value": "ELUP_Par_103 (redaktsioon 104122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122014003",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_103_v123112022002"
      },
      "estleg:versionValidTo": {
        "@value": "2022-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104122014003",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 103",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_103_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üleminekutoetusteks riigieelarvest eraldatud vahendite jaotuse toetuse liikide kaupa otsustab valdkonna eest vastutav minister käskkirjaga. (2) PRIA otsustab üleminekutoetuse ühikumäära, lähtudes käesoleva paragrahvi lõike 1 alusel kehtestatud vahendite jaotusest ja toetusõiguslikuks tunnistatud üleminekutoetuse ühikutest ning järgides taotlejate võrdse kohtlemise põhimõtet.",
      "rdfs:label": {
        "@value": "ELUP_Par_103 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 103",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_104_v13236848",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_104"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tootmiskvoodi alusel toodetava põllumajandustoote turustamise eest heakskiitmata kokkuostjatele –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "ELUP_Par_104 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
