    {
      "@id": "estleg:ELUP_Par_68_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) võib määrusega kehtestada arengukava seire ja hindamise korra. (2) Toetuse saaja esitab maaelu arengu toetuse saamise ja kasutamise kohta seireks ja hindamiseks vajaliku teabe arengukava seiravale ja hindavale isikule. Arengukava hindav isik võib toetuse hindamiseks vajalikke tegevusi teha toetuse saaja ettevõttes või majapidamises üksnes toetuse saaja nõusolekul.",
      "rdfs:label": {
        "@value": "ELUP_Par_68 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 68",
      "estleg:partOfAct": {
