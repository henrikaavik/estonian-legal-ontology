        "@type": "xsd:date"
      },
      "estleg:versionText": "Eraladustatava põllumajandustoote vastavust koostis- ja kvaliteedinõuetele ning põllumajandustoote hoiu- ja säilitusruumi nõuetekohasust kontrollib oma pädevuse piires Põllumajandus- ja Toiduamet.",
      "rdfs:label": {
        "@value": "ELUP_Par_42 (redaktsioon 110072020043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020043",
