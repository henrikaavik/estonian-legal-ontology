      }
    },
    {
      "@id": "estleg:ELUP_Par_138_v104122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_138"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2015. aasta 1. jaanuaril. (2) Käesoleva seaduse §-d 49–51 jõustuvad 2016. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "ELUP_Par_138 (redaktsioon 104122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122014003",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_138_v123112022002"
