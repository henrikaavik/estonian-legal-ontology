      }
    },
    {
      "@id": "estleg:ELUP_Par_60_v104122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lihakäitlemisettevõte peab täitma Euroopa Liidu asjakohastes õigusaktides sätestatud veise-, sea- ja lambarümpade kvaliteediklasside nõudeid. (2) Veise-, sea- ja lambarümpade kvaliteediklasside täpsemad nõuded ning veise-, sea- ja lambarümpade nõuetele vastavuse määramise ulatuse, meetodid ja korra kehtestab määrusega. (3) Veise-, sea- ja lambarümpade kvaliteediklasse võib määrata isik, kes on läbinud veise-, sea- ja lambarümpade kvaliteediklasside nõuetele vastavuse määramise koolituse ning saanud VTA sellekohase tunnustuse. (4) Veise-, sea- ja lambarümpade kvaliteediklasside määramiseks tunnustamise taotlemise ja taotluse menetlemise täpsema korra kehtestab määrusega. (5) Veise-, sea- ja lambarümpade kvaliteediklasside määramise nõuetekohasust ja kuni 12 kuu vanuste veiste liha kategooriatesse liigitamist kontrollib VTA.",
      "rdfs:label": {
        "@value": "ELUP_Par_60 (redaktsioon 104122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122014003",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_60_v110072020043"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104122014003",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 60",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_60_v110072020043",
