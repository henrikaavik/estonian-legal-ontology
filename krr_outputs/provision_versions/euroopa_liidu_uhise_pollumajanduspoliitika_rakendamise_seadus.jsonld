    },
    {
      "@id": "estleg:ELUP_Par_54_v13236848",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) PRIA jätab maaelu arengu toetuse taotluse rahuldamata Euroopa Liidu asjakohastes määrustes ja käesoleva seaduse § 53 lõike 2 alusel kehtestatud õigusaktis sätestatud alustel. (2) PRIA vähendab maaelu arengu toetust komisjoni määruses (EÜ) nr 796/2004 ja käesoleva seaduse § 53 lõike 2 alusel kehtestatud õigusaktis sätestatud alustel. (3) PRIA jätab maaelu arengu toetuse maksmata, kui pärast taotluse rahuldamist, kuid enne toetuse maksmist tehakse kindlaks taotluse rahuldamata jätmise alused või kui toetuse saaja ei ole täitnud toetuse saamise nõudeid.",
      "rdfs:label": {
        "@value": "ELUP_Par_54 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_54_v13283268"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236848",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 54",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_54_v13283268",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) PRIA jätab maaelu arengu toetuse taotluse rahuldamata Euroopa Liidu asjakohastes määrustes ja käesoleva seaduse § 53 lõike 2 alusel kehtestatud õigusaktis sätestatud alustel. (2) PRIA vähendab maaelu arengu toetust komisjoni määruses (EÜ) nr 1122/2009 ja käesoleva seaduse § 53 lõike 2 alusel kehtestatud õigusaktis sätestatud alustel. (3) PRIA jätab maaelu arengu toetuse maksmata, kui pärast taotluse rahuldamist, kuid enne toetuse maksmist tehakse kindlaks taotluse rahuldamata jätmise alused või kui toetuse saaja ei ole täitnud toetuse saamise nõudeid.",
      "rdfs:label": {
