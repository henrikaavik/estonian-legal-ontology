      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tootmiskvoodi või riikliku koguse ületamisel Euroopa Liidu asjakohase määruse alusel makstava tasu sissenõudmise, maksmise ning tagasimaksmise täpsema korra kehtestab põllumajandusminister.",
      "rdfs:label": {
