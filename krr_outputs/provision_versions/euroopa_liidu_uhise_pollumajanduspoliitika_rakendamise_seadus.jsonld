    {
      "@id": "estleg:ELUP_Par_31_v121052014030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) nende piima ja piimatoodete loetelu, mille pakkumiseks koolipiimatoetust antakse, võttes arvesse Euroopa Parlamendi ja nõukogu määruse (EL) nr 1308/2013, millega kehtestatakse põllumajandustoodete ühine turukorraldus ning millega tunnistatakse kehtetuks nõukogu määrused (EMÜ) nr 922/72, (EMÜ) nr 234/79, (EÜ) nr 1037/2001 ja (EÜ) nr 1234/2007 (ELT L 347, 20.12.2013, lk 671–854), artikli 27 lõike 1 punkti a alusel kehtestatud toodete loetelu. (2) nõukogu määruse (EL) nr 1370/2013, millega määratakse kindlaks põllumajandustoodete ühise turukorraldusega seotud teatavate toetuste kehtestamise meetmed (ELT L 346, 20.12.2013, lk 12–19), artiklis 6 või selle alusel kehtestatud õigusaktis sätestatud toetussummale lisaks antava toetuse, arvestades selleks riigieelarvest eraldatud rahalisi vahendeid.",
      "rdfs:label": {
        "@value": "ELUP_Par_31 (redaktsioon 121052014030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121052014030",
