      }
    },
    {
      "@id": "estleg:ELUP_Par_47_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "võib määrusega kehtestada strateegiakava raames antava toetuse andmisest ja kasutamisest teavitamise, toetatud objektide tähistamise ning Euroopa Põllumajanduse Tagatisfondi ja Euroopa Maaelu Arengu Põllumajandusfondi osalusele viitamise täpsemad tingimused ja korra.",
      "rdfs:label": {
        "@value": "ELUP_Par_47 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 47",
      "estleg:partOfAct": {
