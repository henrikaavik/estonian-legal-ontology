      }
    },
    {
      "@id": "estleg:ELUP_Par_73_v13236848",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Liidu põllumajandustoote, toidu, piiritusjoogi või veini kvaliteedimärki kandev toode on käesoleva seaduse tähenduses toode, mille nimetus on registreeritud järgmiste määruste alusel: nõukogu määrus (EÜ) nr 509/2006 põllumajandustoodete ja toidu garanteeritud traditsiooniliste eritunnuste kohta (ELT L 93, 31.03.2006, lk 1–11); nõukogu määrus (EÜ) nr 510/2006 põllumajandustoodete ja toidu geograafiliste tähiste ja päritolunimetuste kaitse kohta (ELT L 93, 31.03.2006, lk 12–25); Euroopa Parlamendi ja nõukogu määrus (EÜ) nr 110/2008 piiritusjookide määratlemise, kirjeldamise, esitlemise, märgistamise ja geograafiliste tähiste kaitse kohta ning millega tunnistatakse kehtetuks nõukogu määrus (EMÜ) nr 1576/89 (ELT L 39, 13.12.2008, lk 16–54); nõukogu määruse (EÜ) nr 1234/2007 artiklid 118a–118zb. (2) Käesoleva paragrahvi lõike 1 punktides 1–3 nimetatud määruste alusel toote nimetuse registreerimiseks esitab taotleja vormikohase kirjaliku taotluse Põllumajandusministeeriumile, kes otsustab taotluse nõuetekohasuse ja Euroopa Komisjonile edastamise või edastamata jätmise. (3) Käesoleva paragrahvi lõike 1 punktides 1–3 nimetatud määruste alusel toodete nimetuste registreerimise taotlemise ja taotluse menetlemise täpsema korra ning taotluse vormi , lähtudes asjakohastes Euroopa Liidu määrustes sätestatud nõuetest.",
      "rdfs:label": {
        "@value": "ELUP_Par_73 (redaktsioon 13236848)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236848",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_73_v121052014030"
      },
      "estleg:versionValidTo": {
        "@value": "2014-05-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236848",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 73",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
