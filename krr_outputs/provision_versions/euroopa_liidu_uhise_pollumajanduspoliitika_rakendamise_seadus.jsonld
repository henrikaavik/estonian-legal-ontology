      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 138/2004 põllumajanduse arvepidamise kohta ühenduses (ELT L 33, 05.02.2004, lk 1–87) II lisas nimetatud põllumajandusarvestuse näitajate hinnangulised andmed koondab Maaeluministeerium ning kalendriaasta lõpptulemuste andmed Statistikaamet samas määruses ettenähtud tähtaegade jooksul.",
      "rdfs:label": {
        "@value": "ELUP_Par_106 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
