    {
      "@id": "estleg:ELUP_Par_34_v12807907",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandustoodete eraladustamise korral esitab isik vormikohase kirjaliku taotluse või eraladustamislepingu sõlmimise taotluse. (2) Käesoleva paragrahvi lõikes 1 nimetatud taotluse rahuldamise korral sõlmib isikuga eraladustamislepingu PRIA. (3) Eraladustamise nõuded hoiu- ja säilitusruumide kohta, milles eraladustatavaid põllumajandustooteid hoitakse ning pakkumise ja eraladustamislepingu sõlmimise taotluse vormid",
      "rdfs:label": {
        "@value": "ELUP_Par_34 (redaktsioon 12807907)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12807907",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_34_v13236848"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12807907",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 34",
      "estleg:partOfAct": {
