      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühise põllumajanduspoliitika abinõu rakendamiseks turuinfo esitamata jätmise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "ELUP_Par_127 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:supersededByVersion": {
