      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2116 artiklis 71 nimetatud toetuse saajate identifitseerimise süsteemi rakendamisel arvestatakse samas artiklis ja komisjoni delegeeritud määruses (EL) 2022/1172 sätestatut.",
      "rdfs:label": {
