    {
      "@id": "estleg:ELUP_Par_138_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_138"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne 2023. aasta 1. jaanuari kehtinud Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse alusel antud toetus nõutakse tagasi käesolevas seaduses sätestatud alustel ja korras. (2) Enne käesoleva seaduse jõustumist tagasinõutud toetuse puhul arvestatakse viivist ja intressi käesolevas seaduses sätestatud määras sellelt toetuse osalt, mis on tagasi maksmata 2023. aasta 1. jaanuari seisuga. (3) Enne käesoleva seaduse jõustumist tagasinõutud toetuse puhul kohaldatakse käesoleva seaduse § 124 lõikes 5 sätestatut alates 2023. aasta 1. jaanuarist laekunud maksetele.",
      "rdfs:label": {
        "@value": "ELUP_Par_138 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 138",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_139_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
