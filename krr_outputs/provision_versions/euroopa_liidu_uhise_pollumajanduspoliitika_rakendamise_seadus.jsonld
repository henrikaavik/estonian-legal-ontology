      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_33_v12760420",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
