      }
    },
    {
      "@id": "estleg:ELUP_Par_9_v750786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kontrollimisel täidavad makseagentuuri ülesandeid ka muud käesolevas seaduses nimetatud asutused (edaspidi kontrolliasutus). (2) Makseagentuuri ja kontrolliasutuste koostöö täpsema korra kehtestab Vabariigi Valitsus või tema volitatud minister.",
      "rdfs:label": {
        "@value": "ELUP_Par_9 (redaktsioon 750786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750786",
