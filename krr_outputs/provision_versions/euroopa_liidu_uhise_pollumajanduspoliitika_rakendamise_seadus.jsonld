    {
      "@id": "estleg:ELUP_Par_6_v104122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sertifitseerimisasutus on Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 artikli 9 tähenduses Põllumajandusministeerium. (2) Põllumajandusministeerium võib sõlmida Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 artiklis 9 sätestatud ülesande täitmiseks halduskoostöö seaduses sätestatud korras halduslepingu eraõigusliku juriidilise isikuga, kellel on küllaldane kogemus toetuste auditeerimisel. Eraõigusliku juriidilise isiku volitamise nimetatud ülesande täitmiseks otsustab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
        "@value": "ELUP_Par_6 (redaktsioon 104122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122014003",
