      }
    },
    {
      "@id": "estleg:ELUP_Par_3_v104122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui Euroopa Liidu õigusaktides ei ole sätestatud ühise põllumajanduspoliitika abinõude rakendamisega seotud andmete esitajat, edastab andmed Euroopa Komisjonile Euroopa Liidu õigusaktides sätestatud tähtaegadel ja korras valdkonna eest vastutava ministri määratud riigiasutus.",
      "rdfs:label": {
        "@value": "ELUP_Par_3 (redaktsioon 104122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122014003",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_3_v123112022002"
      },
      "estleg:versionValidTo": {
        "@value": "2022-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104122014003",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_3_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
