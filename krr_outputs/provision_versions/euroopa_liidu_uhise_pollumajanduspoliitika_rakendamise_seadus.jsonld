        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "ELUP_Par_73 (redaktsioon 750786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750786",
      "estleg:supersededByVersion": {
