      }
    },
    {
      "@id": "estleg:ELUP_Par_129_v104122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_129"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne 2015. aasta 1. jaanuari kehtinud Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse § 83 alusel tunnustatud toidukvaliteedikava rakendav tootjarühm, kes soovib tunnustatud toidukvaliteedikava rakendamist jätkata, peab viima kvaliteedikava vastavusse käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuetele 2016. aasta 1. jaanuariks. (2) Toidukvaliteedikava tunnustamise otsus tunnistatakse kehtetuks, kui kvaliteedikava ei ole käesoleva paragrahvi lõikes 1 sätestatu kohaselt vastavusse viidud.",
      "rdfs:label": {
        "@value": "ELUP_Par_129 (redaktsioon 104122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122014003",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELUP_Par_129_v123112022002"
      },
      "estleg:versionValidTo": {
        "@value": "2022-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104122014003",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 129",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
      "@id": "estleg:ELUP_Par_129_v123112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELUP_Par_129"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2023. aasta 1. jaanuari kehtinud korras akrediteeritud makseasutus täidab makseasutuse ülesandeid akrediteerimise otsuses sätestatud kohustuste osas edasi.",
      "rdfs:label": {
        "@value": "ELUP_Par_129 (redaktsioon 123112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123112022002",
      "estleg:sourceAct": "Euroopa Liidu ühise põllumajanduspoliitika rakendamise seadus",
      "estleg:provisionRef": "ELUP § 129",
      "estleg:partOfAct": {
        "@id": "estleg:ELUP_Map_2026"
      }
    },
    {
