    {
      "@id": "estleg:Reg_1047783_Par_6_v1047783",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047783_Par_6"
