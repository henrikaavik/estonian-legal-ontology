    {
      "@id": "estleg:Reg_1047783_Par_8_v1047783",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047783_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mineraalväetise, sõnniku või silo vedamisel peab vedaja vältima väetise või silo keskkonda sattumise. Mineraalväetise, sõnniku või silo vedamisel peab vedaja vältima väetise või silo keskkonda sattumise. 2 (2) Pakendamata mineraalväetise veol peab väetis olema kaitstud sademete ja tuule eest. Pakendamata mineraalväetise veol peab väetis olema kaitstud sademete ja tuule eest.",
      "rdfs:label": {
        "@value": "Reg_1047783_Par_8 (redaktsioon 1047783)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047783",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047783",
      "estleg:sourceAct": "Väetise kasutamise ja hoidmise nõuded põhja- ja pinnavee kaitseks ning põllumajandustootmisest pärineva saastatuse vältimiseks ja piiramiseks",
      "estleg:provisionRef": "Reg_1047783 § 8",
