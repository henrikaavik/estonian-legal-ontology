      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2023/1114 artiklites 48–51 ja 53–55 sätestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 700 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni 12,5 protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "KruTS_Par_39 (redaktsioon 121062024003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062024003",
