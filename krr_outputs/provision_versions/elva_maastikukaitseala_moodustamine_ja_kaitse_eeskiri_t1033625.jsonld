    },
    {
      "@id": "estleg:Reg_1033625_Par_14_v1033625",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033625_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on Elva jõe, Illi ja Laguja oja oru ja selle ümbruse iseloomuliku maastiku ja looduse mitmekesisuse säilitamine, liikide soodsa seisundi tagamine, elupaigatüüpide jõed ja ojad, niiskuslembesed kõrgrohustud ja lamminiidud kaitse. Piiranguvööndi kaitse-eesmärk on Elva jõe, Illi ja Laguja oja oru ja selle ümbruse iseloomuliku maastiku ja looduse mitmekesisuse säilitamine, liikide soodsa seisundi tagamine, elupaigatüüpide jõed ja ojad, niiskuslembesed kõrgrohustud ja lamminiidud kaitse.",
      "rdfs:label": {
        "@value": "Reg_1033625_Par_14 (redaktsioon 1033625)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033625",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033625",
      "estleg:sourceAct": "Elva maastikukaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1033625 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033625_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033625_Par_15_v1033625",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033625_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) kuni 20 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas. Piiranguvööndis on lubatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; kuni 20 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) ehitise, kaasa arvatud ajutise ehitise püstitamine; 2 2) üle 20 osalejaga rahvaürituse korraldamine ettevalmistamata ja tähistamata kohas; 3 3) veekogude veetaseme ja kaldajoone muutmine; 4 4) turberaie kuni 5 ha suuruse langina; 5 5) lageraie kuusikutes ja hall-lepikutes kuni 1 ha suuruse langina. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: ehitise, kaasa arvatud ajutise ehitise püstitamine; üle 20 osalejaga rahvaürituse korraldamine ettevalmistamata ja tähistamata kohas; veekogude veetaseme ja kaldajoone muutmine; turberaie kuni 5 ha suuruse langina; lageraie kuusikutes ja hall-lepikutes kuni 1 ha suuruse langina. 3 (3) Raiete tegemisel metsamaal tuleb säilitada puistu liikide ja vanuse mitmekesisus. Elustiku mitmekesisuse säilitamiseks tuleb jätta raielangile hektari kohta alles vähemalt 20 tihumeetrit puid, mida ei koristata ja mis jäävad metsa alatiseks. Elustiku mitmekesisuse tagamiseks alles jäetavad puud valitakse eri puuliikide esimese rinde suurima diameetriga puude hulgast, eelistades kõvalehtpuid, mände ja haabasid, samuti eritunnustega, nagu põlemisjälgede, õõnsuste, tuuleluudade või suurte okstega puid. Raiete tegemisel metsamaal tuleb säilitada puistu liikide ja vanuse mitmekesisus. Elustiku mitmekesisuse säilitamiseks tuleb jätta raielangile hektari kohta alles vähemalt 20 tihumeetrit puid, mida ei koristata ja mis jäävad metsa alatiseks. Elustiku mitmekesisuse tagamiseks alles jäetavad puud valitakse eri puuliikide esimese rinde suurima diameetriga puude hulgast, eelistades kõvalehtpuid, mände ja haabasid, samuti eritunnustega, nagu põlemisjälgede, õõnsuste, tuuleluudade või suurte okstega puid.",
      "rdfs:label": {
        "@value": "Reg_1033625_Par_15 (redaktsioon 1033625)",
        "@language": "et"
      },
