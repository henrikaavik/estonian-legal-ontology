        "@value": "2016-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1033625_Par_3 (redaktsioon 1033625)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033625",
