      "estleg:provisionRef": "Reg_1033625 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033625_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033625_Par_16_v1033625",
