    {
      "@id": "estleg:Reg_158857_Par_13_v158857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158857_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puidu kokku- ja väljavedu külmumata pinnasel; 2 2) puhtpuistu kujundamine ja energiapuistu rajamine; 3 3) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 4 4) uue maaparandussüsteemi rajamine; 5 5) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 6 6) biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal ja metsamaal. Piiranguvööndis on keelatud: puidu kokku- ja väljavedu külmumata pinnasel; puhtpuistu kujundamine ja energiapuistu rajamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; uue maaparandussüsteemi rajamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal ja metsamaal.",
      "rdfs:label": {
        "@value": "Reg_158857_Par_13 (redaktsioon 158857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158857",
      "estleg:sourceAct": "Mustoja maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158857 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158857_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158857_Par_14_v158857",
      "@type": [
