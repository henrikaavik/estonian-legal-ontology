    {
      "@id": "estleg:Reg_158857_Par_12_v158857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158857_Par_12"
