    "dcterms": "http://purl.org/dc/terms/"
  },
  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_nsv_liidu_sojavaebaaside_jaoks_sundvoorandatud_maa_tagastamise_ja_kompenseerimis_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: NSV Liidu sõjaväebaaside jaoks sundvõõrandatud maa tagastamise ja kompenseerimise seadus (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "NSV Liidu sõjaväebaaside jaoks sundvõõrandatud maa tagastamise ja kompenseerimise seadus"
    },
    {
      "@id": "estleg:SbMTS_Par_1_v22270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SbMTS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi poolt ajavahemikus 1939. aasta septembrist kuni 1940. aasta 23. juulini NSV Liidu sõjaväebaaside jaoks sundvõõrandatud maa tagastatakse või kompenseeritakse isikutele, kellelt maa sundvõõrandati, või nende pärijatele, sõltumata maa sundvõõrandamise viisist. (2) Käesoleva paragrahvi 1. lõikes nimetatud maa tagastamise korral tagastatakse ka sellel maal sundvõõrandamise ajal asunud hooned ja rajatised, kui need on säilinud.",
      "rdfs:label": {
        "@value": "SbMTS_Par_1 (redaktsioon 22270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22270",
      "estleg:sourceAct": "NSV Liidu sõjaväebaaside jaoks sundvõõrandatud maa tagastamise ja kompenseerimise seadus",
      "estleg:provisionRef": "SbMTS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:SbMTS_Map_2026"
      }
    },
    {
      "@id": "estleg:SbMTS_Par_2_v22270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SbMTS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui isik, kellelt sundvõõrandati käesoleva seaduse §-s 1 nimetatud maa, omandas selle maa arvel Eesti Vabariigilt muu maa, mis 1940. aasta 23. juulil natsionaliseeriti, tagastatakse või kompenseeritakse talle või tema pärijatele natsionaliseeritud maa nende taotlusel. Sel juhul ei ole neil õigust käesoleva seaduse §-s 1 nimetatud maa tagastamisele või kompenseerimisele.",
      "rdfs:label": {
        "@value": "SbMTS_Par_2 (redaktsioon 22270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22270",
      "estleg:sourceAct": "NSV Liidu sõjaväebaaside jaoks sundvõõrandatud maa tagastamise ja kompenseerimise seadus",
      "estleg:provisionRef": "SbMTS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:SbMTS_Map_2026"
      }
    },
    {
      "@id": "estleg:SbMTS_Par_3_v22270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SbMTS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse alusel maa ja hoonete tagastamine ning kompenseerimine toimub omandireformi aluste seaduses (RT 1991, 21, 257; 1991, 45, 565; 1992, 19, 275; 1992, 33, 420; 1993, 15, 253 ja 254; RT I 1993, 35, 545; 1993, 45, 639) ja maareformi seaduses (RT 1991, 34, 426; 1992, 10, 145; RT I 1993, 20, 354) ning nende alusel vastuvõetud muudes õigusaktides ettenähtud korras, kuivõrd seda ei muuda käesolev seadus.",
      "rdfs:label": {
        "@value": "SbMTS_Par_3 (redaktsioon 22270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22270",
      "estleg:sourceAct": "NSV Liidu sõjaväebaaside jaoks sundvõõrandatud maa tagastamise ja kompenseerimise seadus",
      "estleg:provisionRef": "SbMTS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:SbMTS_Map_2026"
      }
    },
    {
      "@id": "estleg:SbMTS_Par_4_v22270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SbMTS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-s 1 nimetatud maa tagastamise ja kompenseerimise avaldusi võib esitada õigusvastaselt võõrandatud vara tagastamise ja kompenseerimise maakonna- ja linnakomisjonidele kolme kuu jooksul käesoleva seaduse jõustumise päevast, kui need pole varem juba esitatud.",
      "rdfs:label": {
        "@value": "SbMTS_Par_4 (redaktsioon 22270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22270",
      "estleg:sourceAct": "NSV Liidu sõjaväebaaside jaoks sundvõõrandatud maa tagastamise ja kompenseerimise seadus",
      "estleg:provisionRef": "SbMTS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:SbMTS_Map_2026"
      }
    },
    {
      "@id": "estleg:SbMTS_Par_5_v22270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SbMTS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsusel on õigus anda käesoleva seaduse rakendamise korra kohta määrusi.",
      "rdfs:label": {
        "@value": "SbMTS_Par_5 (redaktsioon 22270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22270",
      "estleg:sourceAct": "NSV Liidu sõjaväebaaside jaoks sundvõõrandatud maa tagastamise ja kompenseerimise seadus",
      "estleg:provisionRef": "SbMTS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:SbMTS_Map_2026"
      }
    },
    {
      "@id": "estleg:SbMTS_Par_6_v22270",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SbMTS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub selle väljakuulutamise päeval.",
      "rdfs:label": {
        "@value": "SbMTS_Par_6 (redaktsioon 22270)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22270",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22270",
      "estleg:sourceAct": "NSV Liidu sõjaväebaaside jaoks sundvõõrandatud maa tagastamise ja kompenseerimise seadus",
      "estleg:provisionRef": "SbMTS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:SbMTS_Map_2026"
      }
    }
  ]
}
