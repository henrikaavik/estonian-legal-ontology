        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala välis- ja vööndite piir on esitatud kaardil määruse lisas4. Kaitseala välis- ja vööndite piir on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1020297_Par_2 (redaktsioon 1020297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1020297",
