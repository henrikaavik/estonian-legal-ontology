      }
    },
    {
      "@id": "estleg:Reg_1020297_Par_14_v1020297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1020297_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on kaitsta ja säilitada looduse mitmekesisust, liigirikkaid niitusid lubjavaestel muldadel ja lamminiite. Piiranguvööndi kaitse-eesmärk on kaitsta ja säilitada looduse mitmekesisust, liigirikkaid niitusid lubjavaestel muldadel ja lamminiite.",
      "rdfs:label": {
        "@value": "Reg_1020297_Par_14 (redaktsioon 1020297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1020297",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1020297",
      "estleg:sourceAct": "Maalasti looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1020297 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1020297_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1020297_Par_15_v1020297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1020297_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus, arvestades käesolevas määruses sätestatud erisustega; 2 2) kuni 30 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas; 3 3) puhtpuistute kujundamine. Piiranguvööndis on lubatud: majandustegevus, arvestades käesolevas määruses sätestatud erisustega; kuni 30 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas; puhtpuistute kujundamine. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) ehitise, kaasa arvatud tehnovõrgurajatise ja ajutise ehitise, püstitamine; 2 2) rohkem kui 30 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: ehitise, kaasa arvatud tehnovõrgurajatise ja ajutise ehitise, püstitamine; rohkem kui 30 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas. 3 (3) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud uuendusraie järgmistel tingimustel: 1 1) lageraie kuusikutes ja hall-lepikutes kuni 1 hektari suuruse langina; 2 2) turberaie kuni 5 hektari suuruse langina; 3 3) raiete tegemisel metsamaal tuleb säilitada puistu liikide ja vanuse mitmekesisus. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud uuendusraie järgmistel tingimustel: lageraie kuusikutes ja hall-lepikutes kuni 1 hektari suuruse langina; turberaie kuni 5 hektari suuruse langina; raiete tegemisel metsamaal tuleb säilitada puistu liikide ja vanuse mitmekesisus. 4 (4) Elustiku mitmekesisuse säilitamiseks tuleb jätta raielangile hektari kohta alles vähemalt 10 tihumeetrit puid, mida ei koristata ja mis jäävad metsa alatiseks. Elustiku mitmekesisuse tagamiseks alles jäetavad puud valitakse eri puuliikide esimese rinde suurima diameetriga puude hulgast, eelistades kõvalehtpuid, mände ja haabasid, samuti eritunnustega, näiteks põlemisjälgede, õõnsuste, tuuleluudade või suurte okstega puid. Elustiku mitmekesisuse säilitamiseks tuleb jätta raielangile hektari kohta alles vähemalt 10 tihumeetrit puid, mida ei koristata ja mis jäävad metsa alatiseks. Elustiku mitmekesisuse tagamiseks alles jäetavad puud valitakse eri puuliikide esimese rinde suurima diameetriga puude hulgast, eelistades kõvalehtpuid, mände ja haabasid, samuti eritunnustega, näiteks põlemisjälgede, õõnsuste, tuuleluudade või suurte okstega puid.",
      "rdfs:label": {
        "@value": "Reg_1020297_Par_15 (redaktsioon 1020297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1020297",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1020297",
      "estleg:sourceAct": "Maalasti looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1020297 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1020297_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1020297_Par_16_v1020297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1020297_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) veekogude veetaseme ja kaldajoone muutmine; 2 2) energiapuistute rajamine; 3 3) maavara kaevandamine; 4 4) uue maaparandussüsteemi rajamine; 5 5) biotsiidi, taimekaitsevahendi ja väetise kasutamine metsamaal ja looduslikul rohumaal. Piiranguvööndis on keelatud: veekogude veetaseme ja kaldajoone muutmine; energiapuistute rajamine; maavara kaevandamine; uue maaparandussüsteemi rajamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine metsamaal ja looduslikul rohumaal.",
      "rdfs:label": {
        "@value": "Reg_1020297_Par_16 (redaktsioon 1020297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1020297",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1020297",
      "estleg:sourceAct": "Maalasti looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1020297 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1020297_Map_2026"
      }
    },
