      "estleg:provisionRef": "RAAMAT § 41",
      "estleg:partOfAct": {
        "@id": "estleg:RAAMAT_Map_2026"
      }
    },
    {
      "@id": "estleg:RAAMAT_Par_42_v22289",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAAMAT_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isiklik vastutus raamatupidamise korraldamise alaste õiguserikkumiste eest on sätestatud raamatupidamise korraldamise ja raamatupidamise õigsuse eest isikliku vastutuse kehtestamise seaduses (RT I 1993, 43, 620).",
      "rdfs:label": {
        "@value": "RAAMAT_Par_42 (redaktsioon 22289)",
        "@language": "et"
      },
