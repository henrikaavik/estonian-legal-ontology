      }
    },
    {
      "@id": "estleg:RAAMAT_Par_8_v178687",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAAMAT_Par_8"
      },
      "estleg:versionValidFrom": {
