    {
      "@id": "estleg:RAAMAT_Par_21_v112112010020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAAMAT_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raamatupidamise aastaaruande lisades on raamatupidamiskohustuslane kohustatud avalikustama: millisest käesoleva seaduse §-s 17 sätestatud raamatupidamistavast lähtuvalt on raamatupidamise aastaaruanne koostatud; aastaaruande koostamisel kasutatud arvestuspõhimõtted; selgitused põhiaruannete oluliste kirjete ning nende muutumise kohta aruandeperioodil; muud olulised asjaolud õige ja õiglase ülevaate andmiseks raamatupidamiskohustuslase finantsseisundist, majandustulemusest ja rahavoogudest. (1¹) Kehtetu - (2) Raamatupidamise aastaaruande lisad peavad vastama ühele käesoleva seaduse §-s 17 nimetatud raamatupidamistavale.",
      "rdfs:label": {
        "@value": "RAAMAT_Par_21 (redaktsioon 112112010020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010020",
      "estleg:supersededByVersion": {
