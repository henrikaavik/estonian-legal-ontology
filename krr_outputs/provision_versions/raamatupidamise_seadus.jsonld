      }
    },
    {
      "@id": "estleg:RAAMAT_Par_11_v130122015065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAAMAT_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raamatupidamiskohustuslane on kohustatud koostama raamatupidamise sise-eeskirja, mis kehtestab kontoplaani koos kontode sisu kirjeldusega ning reguleerib muu hulgas majandustehingute dokumenteerimist ja kirjendamist, algdokumentide käivet ja säilitamist, raamatupidamisregistrite pidamist, tulude ja kulude kajastamist kasumiaruande kirjetel, varade ja kohustiste inventeerimist, raamatupidamiskohustuslase kasutatavaid arvestuspõhimõtteid ja informatsiooni esitusviisi, aruannete koostamise korda, arvutitarkvara kasutamist raamatupidamises ning raamatupidamise korraldamisega ja sellega kaasnevate sisekontrolli meetmete rakendamisega seotud asjaolusid. (2) Riigiraamatupidamiskohustuslane koostab raamatupidamise sise-eeskirja, arvestades üldeeskirja nõudeid.",
      "rdfs:label": {
        "@value": "RAAMAT_Par_11 (redaktsioon 130122015065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015065",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAAMAT_Par_11_v127122016003"
      },
      "estleg:versionValidTo": {
        "@value": "2016-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015065",
      "estleg:sourceAct": "Raamatupidamise seadus",
      "estleg:provisionRef": "RAAMAT § 11",
      "estleg:partOfAct": {
