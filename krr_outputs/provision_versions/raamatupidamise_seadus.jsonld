    {
      "@id": "estleg:RAAMAT_Par_27_v22289",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAAMAT_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raamatupidamiskohustuslase vara koosneb põhi- ja käibevarast. Põhivara on vara, mida kasutatakse majandustegevuses pikema ajavahemiku jooksul, tavaliselt rohkem kui üks aasta. Kõik muu vara on käibevara. (2) [Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "RAAMAT_Par_27 (redaktsioon 22289)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22289",
