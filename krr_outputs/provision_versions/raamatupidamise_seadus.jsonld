    {
      "@id": "estleg:RAAMAT_Par_41_v22289",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAAMAT_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lõppenud juriidilise isiku algdokumente, raamatupidamisregistreid, lepinguid, raamatupidamise aastaaruandeid ja majandusaasta teisi aruandeid hoitakse tsiviilseadustiku üldosa seaduses ja eraõiguslike juriidiliste isikute kohta käivates seadustes sätestatud korras.",
      "rdfs:label": {
        "@value": "RAAMAT_Par_41 (redaktsioon 22289)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22289",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAAMAT_Par_41_v229287"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22289",
      "estleg:sourceAct": "Raamatupidamise seadus",
      "estleg:provisionRef": "RAAMAT § 41",
      "estleg:partOfAct": {
        "@id": "estleg:RAAMAT_Map_2026"
      }
    },
    {
      "@id": "estleg:RAAMAT_Par_41_v229287",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
