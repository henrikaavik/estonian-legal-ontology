      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse üksuse raamatupidamise aastaaruanne sisaldab täiendava aruandena vastava valla või linna eelarve täitmise aruannet.",
      "rdfs:label": {
        "@value": "RAAMAT_Par_41 (redaktsioon 229287)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "229287",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/229287",
