        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raamatupidamiskohustuslane peab pidama raamatupidamisarvestust kahekordse kirjendamise põhimõttel.",
      "rdfs:label": {
        "@value": "RAAMAT_Par_9 (redaktsioon 22289)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22289",
