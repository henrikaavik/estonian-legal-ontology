    {
      "@id": "estleg:RAAMAT_Par_27_v182278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAAMAT_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raamatupidamiskohustuslase vara koosneb põhi- ja käibevarast. Põhivara on vara, mida kasutatakse majandustegevuses pikema ajavahemiku jooksul, tavaliselt rohkem kui üks aasta. Kõik muu vara on käibevara. (2) [Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "RAAMAT_Par_27 (redaktsioon 182278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182278",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAAMAT_Par_27_v229287"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/182278",
      "estleg:sourceAct": "Raamatupidamise seadus",
      "estleg:provisionRef": "RAAMAT § 27",
      "estleg:partOfAct": {
