    {
      "@id": "estleg:RAAMAT_Par_60_v12985310",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAAMAT_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raamatupidamise seadus tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "RAAMAT_Par_60 (redaktsioon 12985310)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12985310",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12985310",
      "estleg:sourceAct": "Raamatupidamise seadus",
      "estleg:provisionRef": "RAAMAT § 60",
