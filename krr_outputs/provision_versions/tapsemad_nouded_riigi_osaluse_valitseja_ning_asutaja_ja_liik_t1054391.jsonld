    {
      "@id": "estleg:Reg_1054391_Par_6_v1054391",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054391_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Asutajaõiguste teostaja esitab hiljemalt aruandeaastale järgneva aasta 10. mail seisukohad ja teabe kõigi sihtasutuste, mille suhtes ta asutajaõigusi teostab, eesmärkide täitmise ja nendes asutajaõiguste teostamise kohta. Asutajaõiguste teostaja esitab hiljemalt aruandeaastale järgneva aasta 10. mail seisukohad ja teabe kõigi sihtasutuste, mille suhtes ta asutajaõigusi teostab, eesmärkide täitmise ja nendes asutajaõiguste teostamise kohta. 2 (2) Sihtasutuse puhul, mille majandusaasta ei kattu kalendriaastaga, esitatakse lõikes 1 nimetatud seisukohad ja teave 40 kalendripäeva jooksul pärast majandusaasta aruande kinnitamist. Sihtasutuse puhul, mille majandusaasta ei kattu kalendriaastaga, esitatakse lõikes 1 nimetatud seisukohad ja teave 40 kalendripäeva jooksul pärast majandusaasta aruande kinnitamist.",
      "rdfs:label": {
        "@value": "Reg_1054391_Par_6 (redaktsioon 1054391)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054391",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054391",
      "estleg:sourceAct": "Täpsemad nõuded riigi osaluse valitseja ning asutaja- ja liikmeõiguste teostaja seisukohtade ja teabe esitamisele",
      "estleg:provisionRef": "Reg_1054391 § 6",
