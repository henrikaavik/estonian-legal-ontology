    {
      "@id": "estleg:Reg_1053548_Par_3_v1053548",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053548_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu volitatud töötleja on numbriloa omanikust sideettevõtja või numbriloa omanikust ettevõtja, kes ei ole sideettevõtja; Andmekogu volitatud töötleja on numbriloa omanikust sideettevõtja või numbriloa omanikust ettevõtja, kes ei ole sideettevõtja; 2 (2) Andmekogu sideettevõtjast volitatud töötleja täidab järgmisi ülesandeid: 1 1) numbriloa andmete kooskõlastamine; 2 2) numbrite broneerimine ja vabastamine; 3 3) broneeritud numbrite marsruutimisnumbrite haldamine; 4 4) oma äriühingu kohta päringute tegemine; 5 5) broneeritud numbrite andmebaasi ja selle muudatuste alla laadimine; 6 6) oma äriühinguga seotud numbri liikuvuse toimingute tegemine ja teabevahetus. Andmekogu sideettevõtjast volitatud töötleja täidab järgmisi ülesandeid: numbriloa andmete kooskõlastamine; numbrite broneerimine ja vabastamine; broneeritud numbrite marsruutimisnumbrite haldamine; oma äriühingu kohta päringute tegemine; broneeritud numbrite andmebaasi ja selle muudatuste alla laadimine; oma äriühinguga seotud numbri liikuvuse toimingute tegemine ja teabevahetus. 3 (3) Andmekogu volitatud töötleja, kes ei ole sideettevõtja, täidab järgmisi ülesandeid: 1 1) numbriloa andmete kooskõlastamine; 2 2) numbrite broneerimiseks vabastamine; 3 3) broneeritud numbrite marsruutimisnumbrite haldamine; 4 4) oma äriühingu kohta kehtivate andmete infopäringute esitamine; 5 5) oma äriühinguga seotud numbri liikuvuse toimingute tegemine ja teabevahetus. Andmekogu volitatud töötleja, kes ei ole sideettevõtja, täidab järgmisi ülesandeid: numbriloa andmete kooskõlastamine; numbrite broneerimiseks vabastamine; broneeritud numbrite marsruutimisnumbrite haldamine; oma äriühingu kohta kehtivate andmete infopäringute esitamine; oma äriühinguga seotud numbri liikuvuse toimingute tegemine ja teabevahetus.",
      "rdfs:label": {
        "@value": "Reg_1053548_Par_3 (redaktsioon 1053548)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053548",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053548",
      "estleg:sourceAct": "Numbri broneerimise andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1053548 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053548_Map_2026"
      }
