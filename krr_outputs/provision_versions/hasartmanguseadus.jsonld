        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsusel või rahandusministril on õigus kehtestada erinõudeid hasartmängude korraldamise kajastamisele raamatupidamises ja raamatupidamise algdokumentide kohustuslikke vorme.",
      "rdfs:label": {
        "@value": "HASART_Par_11 (redaktsioon 22332)",
        "@language": "et"
      },
