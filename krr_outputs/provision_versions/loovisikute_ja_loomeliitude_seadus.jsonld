      "estleg:provisionRef": "LOOVIS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:LOOVIS_Map"
      }
    },
    {
      "@id": "estleg:LOOVIS_Par_4_v824850",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LOOVIS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loomeliit on käesolevas seaduses sätestatud korras tunnustatud mittetulundusühing, mille eesmärk on edendada vastavat loomeala ja toetada oma liikmeks olevate loovisikute loometegevust.",
      "rdfs:label": {
        "@value": "LOOVIS_Par_4 (redaktsioon 824850)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "824850",
      "estleg:supersededByVersion": {
        "@id": "estleg:LOOVIS_Par_4_v110012014007"
      },
      "estleg:versionValidTo": {
        "@value": "2014-01-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/824850",
      "estleg:sourceAct": "Loovisikute ja loomeliitude seadus",
      "estleg:provisionRef": "LOOVIS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:LOOVIS_Map"
      }
    },
    {
      "@id": "estleg:LOOVIS_Par_4_v110012014007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LOOVIS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loomeliit on käesolevas seaduses sätestatud korras tunnustatud mittetulundusühing, mille eesmärk on edendada ühte loomeala ja toetada oma liikmeks olevate loovisikute loometegevust. (2) Loomeliit ühendab ja esindab ühel loomealal tegutsevaid isikuid. Ühel loomealal võib eraldi luua kutsealapõhiseid loomeliite. Loomeliidu liikmetest üle 40 protsendi ei või kuuluda mõne teise samal loomealal tunnustatud loomeliidu liikmeskonda. (3) Loomeliidus peab olema vähemalt 50 teovõimelist füüsilist isikut, kes on vähemalt kolm viimast aastat vastaval loomealal loometööga tegelenud ja kelle teosed on selles ajavahemikus avaldatud või üldsusele suunatud autoriõiguse seaduse §-de 9 ja 10 tähenduses. (4) Loomeliidu põhikirjaline eesmärk ja kutseala, millel tegutsevaid isikuid loomeliit ühendab ja esindab, ei või ühtida mõne teise samal loomealal tunnustatud loomeliidu põhikirjalise eesmärgi ja kutsealaga. Loomeliit ei või oma liikmeskonnale ja tegevusele seada piirkondlikke, etnilisi, soolisi, rassilisi või muid piiranguid, mis ei tulene loome- või kutsealast.",
      "rdfs:label": {
        "@value": "LOOVIS_Par_4 (redaktsioon 110012014007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110012014007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110012014007",
      "estleg:sourceAct": "Loovisikute ja loomeliitude seadus",
      "estleg:provisionRef": "LOOVIS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:LOOVIS_Map"
      }
    },
    {
      "@id": "estleg:LOOVIS_Par_5_v824850",
