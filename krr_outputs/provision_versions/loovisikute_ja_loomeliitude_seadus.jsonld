      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loomeliidu tunnustamine on menetlus, mille käigus hinnatakse loomeliidu vastavust käesoleva seaduse nõuetele. (2) Loomeliidu tunnustamise või tunnustamisest keeldumise otsuse teeb kultuuriminister.",
      "rdfs:label": {
        "@value": "LOOVIS_Par_7 (redaktsioon 824850)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "824850",
