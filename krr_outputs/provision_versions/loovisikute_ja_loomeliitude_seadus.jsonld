    {
      "@id": "estleg:LOOVIS_Par_6_v824850",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LOOVIS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loomeliidu põhikirjas märgitakse mittetulundusühingute seaduses (RT I 1996, 42, 811; 1998, 96, 1515; 1999, 10, 155; 23, 355; 67, 658; 2000, 55, 365; 88, 576; 2001, 56, 336; 93, 565; 2002, 53, 336; 2003, 88, 591) sätestatule lisaks: loomeliidu asutamise aeg; loomeliidu loomeala; loomeliidu juhtimise kord; kord, mille kohaselt tuleb teatada teostest, mis loomeliidu liige on loomeliidu loomealal loonud või esitanud, ja neid registreerida; loometoetuse määramise komisjoni liikmete valimise kord ja komisjoni töökord; loometoetust saavate isikute ja loometoetuste üle arvestuse pidamise kord; loovisikule makstavate stipendiumide ja muude hüvitiste maksmise alused ja kord.",
      "rdfs:label": {
        "@value": "LOOVIS_Par_6 (redaktsioon 824850)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "824850",
      "estleg:supersededByVersion": {
        "@id": "estleg:LOOVIS_Par_6_v1010884"
      },
      "estleg:versionValidTo": {
        "@value": "2006-04-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/824850",
      "estleg:sourceAct": "Loovisikute ja loomeliitude seadus",
      "estleg:provisionRef": "LOOVIS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:LOOVIS_Map"
      }
    },
    {
      "@id": "estleg:LOOVIS_Par_6_v1010884",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LOOVIS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loomeliidu põhikirjas märgitakse mittetulundusühingute seaduses (RT I 1996, 42, 811; 1998, 96, 1515; 1999, 10, 155; 23, 355; 67, 658; 2000, 55, 365; 88, 576; 2001, 56, 336; 93, 565; 2002, 53, 336; 2003, 88, 591) sätestatule lisaks: loomeliidu asutamise aeg; loomeliidu loomeala; loomeliidu juhtimise kord; kord, mille kohaselt tuleb teatada teostest, mis loomeliidu liige on loomeliidu loomealal loonud või esitanud, ja neid registreerida; loometoetuse määramise komisjoni liikmete valimise kord ja komisjoni töökord; loometoetust saavate isikute ja loometoetuste üle arvestuse pidamise kord; loovisikule makstavate stipendiumide ja muude hüvitiste maksmise alused ja kord. (2) Käesoleva paragrahvi lõike 1 punktis 5 nimetatud loometoetuste määramise komisjoni töökord ja punktis 7 nimetatud stipendiumide ja muude hüvitiste maksmise kord võib põhikirja alusel olla kinnitatud eraldi dokumendiga.",
      "rdfs:label": {
        "@value": "LOOVIS_Par_6 (redaktsioon 1010884)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1010884",
      "estleg:supersededByVersion": {
        "@id": "estleg:LOOVIS_Par_6_v13114762"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1010884",
      "estleg:sourceAct": "Loovisikute ja loomeliitude seadus",
      "estleg:provisionRef": "LOOVIS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:LOOVIS_Map"
      }
    },
