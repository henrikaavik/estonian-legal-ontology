    {
      "@id": "estleg:Reg_1048476_Par_7_v1048476",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048476_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitsealal on maastikuvaadete avamiseks ja säilimiseks vajalik puu- ja põõsarinde kujundamine ja harvendamine või raadamine. Kaitsealal on maastikuvaadete avamiseks ja säilimiseks vajalik puu- ja põõsarinde kujundamine ja harvendamine või raadamine. 2 (2) Poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu tagamiseks vajalik rohu niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ja harvendamine või raadamine. Poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu tagamiseks vajalik rohu niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ja harvendamine või raadamine.",
      "rdfs:label": {
        "@value": "Reg_1048476_Par_7 (redaktsioon 1048476)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048476",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048476",
      "estleg:sourceAct": "Varesemägede maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1048476 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048476_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048476_Par_8_v1048476",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048476_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitsealal on keelatud: 1 1) maavara kaevandamine; 2 2) puhtpuistute kujundamine ja energiapuistute rajamine; 3 3) biotsiidi, taimekaitsevahendi ja väetise kasutamine. Kaitsealal on keelatud: maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine. 2 (2) Kaitseala valitseja nõusolekuta on kaitsealal keelatud: 1 1) muuta katastriüksuse kõlvikute piire ja kõlviku sihtotstarvet; 2 2) koostada maakorralduskava ja teha maakorraldustoiminguid; 3 3) kehtestada detailplaneeringut ja üldplaneeringut; 4 4) lubada ehitada ehitusteatise kohustusega või ehitusloakohustuslikku ehitist; 5 5) anda projekteerimistingimusi; 6 6) anda ehitusluba; 7 7) rajada uut veekogu, mille pindala on suurem kui viis ruutmeetrit, kui selleks ei ole vaja anda veeluba, ehitusluba ega esitada ehitusteatist; 8 8) jahiulukeid lisasööta. Kaitseala valitseja nõusolekuta on kaitsealal keelatud: muuta katastriüksuse kõlvikute piire ja kõlviku sihtotstarvet; koostada maakorralduskava ja teha maakorraldustoiminguid; kehtestada detailplaneeringut ja üldplaneeringut; lubada ehitada ehitusteatise kohustusega või ehitusloakohustuslikku ehitist; anda projekteerimistingimusi; anda ehitusluba; rajada uut veekogu, mille pindala on suurem kui viis ruutmeetrit, kui selleks ei ole vaja anda veeluba, ehitusluba ega esitada ehitusteatist; jahiulukeid lisasööta.",
      "rdfs:label": {
        "@value": "Reg_1048476_Par_8 (redaktsioon 1048476)",
        "@language": "et"
      },
