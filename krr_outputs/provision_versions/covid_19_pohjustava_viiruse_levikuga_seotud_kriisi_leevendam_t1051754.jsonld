        "@language": "et"
      },
      "dc:source": "COVID-19 põhjustava viiruse levikuga seotud kriisi leevendamiseks ette nähtud toetusmeede spordiorganisatsioonidele ja spordikoolidele võlaõigusliku lepingu alusel töötavate treenerite ja juhendajate tööjõukulude hüvitamiseks"
    },
    {
      "@id": "estleg:Reg_1051754_Par_1_v1051754",
      "@type": [
