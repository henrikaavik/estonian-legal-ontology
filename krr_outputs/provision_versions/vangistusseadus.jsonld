      }
    },
    {
      "@id": "estleg:VANGIS_Par_135_v120122012017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_135"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnik ei tohi osaleda streikides, pikettides ega muudes teenistusalastes surveaktsioonides.",
      "rdfs:label": {
        "@value": "VANGIS_Par_135 (redaktsioon 120122012017)",
        "@language": "et"
      },
