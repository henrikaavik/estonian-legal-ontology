      "estleg:provisionRef": "VANGIS § 107",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_107_v13251273",
      "@type": [
