      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab vangistuse, aresti, eelvangistuse ja karistusjärgse kinnipidamise täideviimise korra ning korralduse, samuti vanglateenistuse ning teenistuse vanglaametnikuna mõiste ja tingimused.",
      "rdfs:label": {
        "@value": "VANGIS_Par_1 (redaktsioon 13204483)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13204483",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_1_v105072013018"
      },
      "estleg:versionValidTo": {
        "@value": "2013-07-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13204483",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
