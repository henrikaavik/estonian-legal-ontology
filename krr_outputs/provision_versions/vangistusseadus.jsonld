      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 146",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_146_v109122010015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riik tagab vanglaametnikule tasuta terviseuuringud. Terviseuuringute läbiviimise tingimused, perioodilisuse ja korra",
      "rdfs:label": {
        "@value": "VANGIS_Par_146 (redaktsioon 109122010015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109122010015",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_146_v120122012016"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109122010015",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 146",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_146_v120122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglateenistuse ametniku tervisekontrolli eesmärk on tema teenistusest põhjustatud tervisehäirete avastamine, terviseriskide vähendamine ja vältimine ning vanglateenistuse ametnikule pandud kohustuste täitmist takistavate tervisehäirete puudumise tuvastamine. (2) Vanglateenistuse ametniku tervisekontroll, teenistusega seotud arstlik läbivaatus ja vaktsineerimine, samuti vanglateenistusse või vanglaametniku erialale õppima kandideeriva isiku tervisekontroll tagatakse riigieelarve vahenditest. (3) Vanglateenistuse ametniku tervisekontrolli korraldab ja tervisetõendi väljastab töötervishoiuarst, kaasates vajaduse korral eriarste. (4) Vanglateenistuse ametniku tervisenõuded ja tervisekontrolli korra ning tervisetõendi sisu ja vormi nõuded",
      "rdfs:label": {
        "@value": "VANGIS_Par_146 (redaktsioon 120122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012016",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_146_v112072014010"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122012016",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 146",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_146_v112072014010",
