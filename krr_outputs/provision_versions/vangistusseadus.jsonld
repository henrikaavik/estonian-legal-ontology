      },
      "estleg:versionValidFrom": {
        "@value": "2003-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeoleku tagamiseks eelvangistuse täideviimisel võib vangla direktor kohaldada vahistatu suhtes käesoleva seaduse §-des 66–72 sätestatud julgeolekuabinõusid.",
      "rdfs:label": {
