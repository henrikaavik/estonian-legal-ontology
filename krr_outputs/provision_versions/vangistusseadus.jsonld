    },
    {
      "@id": "estleg:VANGIS_Par_104_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_104"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vahistatu vabastatakse vahistustähtaja lõppemisel, samuti teistel seaduses sätestatud alustel. (2) Kolm päeva enne vahistustähtaja lõppemist teatab vangla direktor sellest uurijale või prokurörile, kelle menetluses on kriminaalasi. (3) Kui vahistustähtaega ei pikendata, vabastatakse vahistatu vahistustähtaja viimasel päeval hiljemalt kell 12.00.",
      "rdfs:label": {
        "@value": "VANGIS_Par_104 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_104_v13204483"
      },
      "estleg:versionValidTo": {
