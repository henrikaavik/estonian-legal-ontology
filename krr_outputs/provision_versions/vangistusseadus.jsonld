      },
      "estleg:versionValidTo": {
        "@value": "2024-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13204483",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 90",
      "estleg:partOfAct": {
