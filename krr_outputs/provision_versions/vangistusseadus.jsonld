      }
    },
    {
      "@id": "estleg:VANGIS_Par_72_v12772547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglas hädaolukorra lahendamisele kaasatud politseiametnikud, päästeametnikud ja tervishoiuteenuse osutajad peavad alluma hädaolukorra lahendamist juhtiva asutuse õiguspärastele korraldustele.",
