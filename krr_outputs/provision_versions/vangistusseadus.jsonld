    {
      "@id": "estleg:VANGIS_Par_81_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Noortevanglas või noorteosakonnas hoitakse eraldi: nooremaid kui 15-aastasi; 15- kuni 16-aastasi; 16- kuni 18-aastasi; 18- kuni 21-aastasi.",
      "rdfs:label": {
        "@value": "VANGIS_Par_81 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_81_v122032024012"
      },
      "estleg:versionValidTo": {
        "@value": "2024-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_81_v122032024012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Noortevanglas või noorteosakonnas hoitakse eraldi: nooremaid kui 15-aastasi; 15- kuni 16-aastasi; 16- kuni 18-aastasi; 18- kuni 21-aastasi. (2) Käesoleva paragrahvi lõikes 1 nimetatud eraldihoidmise printsiibist võib teha erandeid, kui kinnipeetava eraldihoidmine teise vanusegruppi kuuluvatest kinnipeetavatest on vastuolus tema normaalse arengu või muude õigustatud huvidega.",
      "rdfs:label": {
        "@value": "VANGIS_Par_81 (redaktsioon 122032024012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032024012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122032024012",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_82_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Noortevanglas või noorteosakonnas 21 aastaseks saanud kinnipeetav paigutatakse ümber täiskasvanute kinnisesse vanglasse või kinnise vangla täiskasvanute osakonda vastavalt täitmisplaanile. (2) Erandkorras võib täiskasvanute kinnisesse vanglasse või kinnise vangla täiskasvanute osakonda ümber paigutada ka 18- kuni 21-aastase kinnipeetava, kui see on vajalik tulenevalt kinnipeetava iseloomust ja individuaalsest täitmiskavast.",
      "rdfs:label": {
        "@value": "VANGIS_Par_82 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 82",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_83_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alla 18-aastase noore kinnipeetava töötamisele kohaldatakse kõiki töökaitseseadustest tulenevaid alaealise töötamise erisusi, sealhulgas erisusi tööaja kohta.",
      "rdfs:label": {
        "@value": "VANGIS_Par_83 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 83",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_84_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alla 18-aastasele noorele kinnipeetavale on põhihariduse omandamine seadusega ettenähtud ulatuses kohustuslik. Vastavalt noore kinnipeetava soovile ja sobivusele antakse talle võimalus kutsekeskhariduse omandamiseks. (2) Noore kinnipeetava vabadusekaotuse täideviimise eesmärkide saavutamise huvides võib suurendada käesoleva seaduse §-des 24 ja 25 sätestatud kokkusaamiste ja käesoleva seaduse §-s 32 sätestatud lühiajaliste väljasõitude arvu ja kestvust.",
      "rdfs:label": {
        "@value": "VANGIS_Par_84 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_84_v555428"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 84",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
