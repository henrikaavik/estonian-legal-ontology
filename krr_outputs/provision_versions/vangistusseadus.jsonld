      }
    },
    {
      "@id": "estleg:VANGIS_Par_48_v12772547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avavangla kinnipeetav võib sisseoste teha ka vangla vahenduseta. (1¹) Käesoleva paragrahvi lõikes 1 nimetatud sisseoste võib kinnipeetav ühes kuus teha Vabariigi Valitsuse kehtestatud kuupalga alammäära piires. (2) Arsti ettekirjutusel võidakse kinnipeetavale keelata teatud toiduainete ostmine täielikult või osaliselt, kui need võivad kahjustada kinnipeetava tervist.",
      "rdfs:label": {
        "@value": "VANGIS_Par_48 (redaktsioon 12772547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12772547",
      "estleg:supersededByVersion": {
