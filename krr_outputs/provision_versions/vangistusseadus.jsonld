    },
    {
      "@id": "estleg:VANGIS_Par_121_v106082022023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_121"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametniku ametisse nimetamisel kohaldatakse talle katseaega pikkusega kuni üks aasta.",
      "rdfs:label": {
        "@value": "VANGIS_Par_121 (redaktsioon 106082022023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106082022023",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106082022023",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 121",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_122_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglaametnike atesteerimisel hinnatakse vanglaametniku kutseoskuste, võimete ja isikuomaduste vastavust ametiastmele ja teenistuslikke saavutusi. Vanglaametnike atesteerimisel avaliku teenistuse seaduse § 91 lõike 1 punktides 4 ja 5 nimetatud juhtudel teenistuslikke saavutusi ei hinnata. (2) Ametiastmele vastavuse ja teenistuslike saavutuste hindamisele ei laiene avaliku teenistuse seaduse § 99 lõikes 4 sätestatud iga-aastase vestluse läbiviimise kohustus. (3) Vanglaametnike ametiastmete atesteerimisnõuded, atesteerimise läbiviimise korra ja atesteerimislehe vormi kehtestab justiitsminister. (4) Vanglaametnike atesteerimist teostavad vanglaametnike konkursi- ja atesteerimiskomisjonid, mille põhimääruse ja moodustamise korra kehtestab justiitsminister. (5) Korralisele atesteerimisele ei kuulu vanglaametnikud, kes on jõudnud oma ametiastmel kõige kõrgemale ametijärgule.",
      "rdfs:label": {
        "@value": "VANGIS_Par_122 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_122_v555428"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 122",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
