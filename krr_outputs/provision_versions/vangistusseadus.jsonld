    {
      "@id": "estleg:VANGIS_Par_111_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_111"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnik on vanglateenistuses olev ametnik.",
      "rdfs:label": {
        "@value": "VANGIS_Par_111 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_111_v12952945"
      },
      "estleg:versionValidTo": {
        "@value": "2008-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 111",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_111_v12952945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_111"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglaametnik on vanglateenistuses olev ametnik. (2) Justiitsministeeriumi ametnik võib täita vanglaametniku või muu vanglatöötaja ülesandeid ja anda vanglaametnikule või muule vanglatöötajale korraldusi. (3) Lõikes 2 sätestatud ülesannete täitmise ja korralduste andmise korra (4) Kui Justiitsministeeriumi ametnik täidab vanglas teenistusülesandeid, laienevad temale vanglaametniku või muu vanglatöötaja õigused ja kohustused, välja arvatud käesoleva seaduse 6. peatüki 2. jaos sätestatud vanglaametniku õigused ja kohustused.",
      "rdfs:label": {
        "@value": "VANGIS_Par_111 (redaktsioon 12952945)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12952945",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_111_v13204483"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-23",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12952945",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 111",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_111_v13204483",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_111"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglaametnik on vanglas teenistuses olev ametnik, kelle ülesanne on kinnipeetava, vahistatu ja karistusjärgselt kinnipeetava kinnipidamine ja järelevalve, julgeoleku tagamine vanglas ning kohtueelse menetluse toimetamine vanglas toimepandud kuritegudes, samuti sellealase tegevuse juhtimine. (1¹) Teenistuseks vanglaametnikuna loetakse ka teenistus sisekaitselise rakenduskõrgkooli või muu vanglaametnike ettevalmistusteenistust läbiviiva asutuse korrektsioonialast haridust andva struktuuriüksuse juhi ja korrektsiooni erialaõppejõu ametikohal. (2) Justiitsministeeriumi ametnik võib täita vanglaametniku või muu vanglatöötaja ülesandeid. (2¹) Justiitsministeeriumi ametnik võib anda vanglaametnikule või muule vanglatöötajale korraldusi. (3) Käesoleva paragrahvi lõigetes 2 ja 21nimetatud ülesannete täitmise ja korralduste andmise korra (4) Kui Justiitsministeeriumi ametnik täidab vanglas teenistusülesandeid, laienevad temale vanglaametniku või muu vanglatöötaja õigused ja kohustused, välja arvatud käesoleva seaduse 6. peatüki 2. jaos sätestatud vanglaametniku õigused ja kohustused.",
      "rdfs:label": {
        "@value": "VANGIS_Par_111 (redaktsioon 13204483)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13204483",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_111_v13251273"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13204483",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 111",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_111_v13251273",
