    },
    {
      "@id": "estleg:VANGIS_Par_136_1_v13009883",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_136_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglaametnike palgamäärad ning põhipalga määramise ja lisatasude maksmise kord . (2) Palgamäärade kehtestamisel võetakse arvesse piirkonda, asutust, vanglaametniku kvalifikatsiooninõudeid, tööülesandeid, töötamist õhtusel või öisel ajal ning muid asjaolusid. (3) Põhipalka võib vähendada kuni 30% võrra erialase ettevalmistusteenistuse või vastava erialase hariduse puudumise korral. (4) Lisatasu võib maksta täiendavate tööülesannete täitmise või nõutavamast tulemuslikuma töö eest ühes kuus kuni 50% vanglaametniku palgamäära madalaimast summast või palgamäära summast.",
      "rdfs:label": {
        "@value": "VANGIS_Par_136_1 (redaktsioon 13009883)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13009883",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_136_1_v13122566"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-25",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13009883",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 136_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_136_1_v13122566",
