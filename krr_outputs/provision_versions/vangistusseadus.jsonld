        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_5_1_v686312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_5_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnipeetavate, arestialuste ja vahistatute andmete töötlemiseks peetakse Vabariigi Valitsuse poolt asutatud riiklikku andmekogu. (2) Andmed on ette nähtud ainult ametialaseks kasutamiseks ning neid väljastatakse vaid andmekogu põhimääruses sätestatud isikutele.",
      "rdfs:label": {
        "@value": "VANGIS_Par_5_1 (redaktsioon 686312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "686312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_5_1_v927191"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/686312",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 5_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_5_1_v927191",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_5_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Andmed on ette nähtud ainult ametialaseks kasutamiseks ning neid väljastatakse vaid andmekogu põhimääruses sätestatud isikutele.",
      "rdfs:label": {
        "@value": "VANGIS_Par_5_1 (redaktsioon 927191)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "927191",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_5_1_v12772547"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/927191",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 5_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_5_1_v12772547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_5_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) riikliku andmekogu, millesse kantakse vangistuse täideviimisel sätestatud ülesannete täitmiseks ja sellega seotud statistiliste ülevaadete tegemiseks andmed: kinnipeetava, arestialuse või vahistatu isiku kohta; kinnipeetava, arestialuse või vahistatu vanglasse või arestimajja vastuvõtmise aluse kohta; kinnipeetava, arestialuse või vahistatu isiklike asjade ja dokumentide hoiulevõtmise ning tagastamise ja neile vangla või arestimaja poolt antud asjade kohta; vanglas või arestimajas viibivate kinnipeetavate, arestialuste või vahistatute kohta, et omada ülevaadet isiku paiknemise ja liikumise kohta kohtueelse menetluse ja kohtumenetluse käigus ning kogu karistuse kandmise ajal; vanglas või arestimajas viibivate kinnipeetavate, arestialuste või vahistatute käitumise kohta käesolevas seaduses ettenähtud otsuste tegemiseks ja vangla julgeoleku tagamiseks; vanglas või arestimajas viibivate kinnipeetavate, arestialuste või vahistatute hõivatuse kohta; kinnipeetava, arestialuse või vahistatu terviseseisundi ja neile vajalike tervishoiuteenuste osutamise kohta; kinnipeetava, arestialuse või vahistatu suhete ja kontaktide kohta vangla julgeoleku tagamiseks. (2) Andmed on ette nähtud ainult ametialaseks kasutamiseks ning neid väljastatakse vaid andmekogu põhimääruses sätestatud isikutele.",
      "rdfs:label": {
        "@value": "VANGIS_Par_5_1 (redaktsioon 12772547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12772547",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_5_1_v13204483"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-23",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12772547",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 5_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_5_1_v13204483",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_5_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) asutab riikliku andmekogu, millesse kantakse vangistuse täideviimisel sätestatud ülesannete täitmiseks ja sellega seotud statistiliste ülevaadete tegemiseks andmed: kinnipeetava, karistusjärgselt kinnipeetava, arestialuse või vahistatu isiku kohta; kinnipeetava, karistusjärgselt kinnipeetava, arestialuse või vahistatu vanglasse või arestimajja vastuvõtmise aluse kohta; kinnipeetava, karistusjärgselt kinnipeetava, arestialuse või vahistatu isiklike asjade ja dokumentide hoiulevõtmise ja tagastamise ning talle vanglateenistuse või arestimaja poolt antud asjade kohta; vanglas või arestimajas viibivate kinnipeetavate, karistusjärgselt kinnipeetavate, arestialuste või vahistatute kohta, et omada ülevaadet isiku paiknemise ja liikumise kohta kohtueelse menetluse ja kohtumenetluse käigus ning kogu karistuse kandmise ajal; vanglas või arestimajas viibivate kinnipeetavate, karistusjärgselt kinnipeetavate, arestialuste või vahistatute käitumise kohta käesolevas seaduses ettenähtud otsuste tegemiseks ja vangla julgeoleku tagamiseks; vanglas või arestimajas viibivate kinnipeetavate, karistusjärgselt kinnipeetavate, arestialuste või vahistatute hõivatuse kohta; kinnipeetava, karistusjärgselt kinnipeetava, arestialuse või vahistatu terviseseisundi ja talle vajalike tervishoiuteenuste osutamise kohta; kinnipeetava, karistusjärgselt kinnipeetava, arestialuse või vahistatu suhete ja kontaktide kohta vangla julgeoleku tagamiseks. (2) Andmed on ette nähtud ainult ametialaseks kasutamiseks ning neid väljastatakse vaid andmekogu põhimääruses sätestatud isikutele.",
      "rdfs:label": {
        "@value": "VANGIS_Par_5_1 (redaktsioon 13204483)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13204483",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_5_1_v105072013018"
      },
      "estleg:versionValidTo": {
        "@value": "2013-07-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13204483",
