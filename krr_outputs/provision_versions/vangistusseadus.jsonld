      }
    },
    {
      "@id": "estleg:VANGIS_Par_151_v12771631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_151"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenistuskohustuste, kodanikukohuse silmapaistvalt hea täitmise või kauaaegse laitmatu teenistuse eest võib vanglaametnikule või mõnele muule isikule kohaldada ergutusi. Ergutuse määrab vanglaametniku ametisse nimetamise õigust omav ametiisik või justiitsminister. Vanglaametniku teeneteristi määrab ja annab kätte justiitsminister. (2) Käesoleva paragrahvi lõikes 1 nimetatud isikule võib määrata järgmisi ergutusi: tänu avaldamine; täiendava tasulise lisapuhkuse andmine kuni 10 kalendripäeva aastas; rahalise preemia andmine; hinnalise kingituse andmine; autasustamine aukirjaga; vanglaametniku teeneteristi andmine; vanglaametniku teenistusmedali andmine. (3) Vanglaametniku teeneteristi ja teenistusmedali kirjelduse, nende andmise ja kandmise korra",
      "rdfs:label": {
        "@value": "VANGIS_Par_151 (redaktsioon 12771631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12771631",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_151_v116042014012"
      },
      "estleg:versionValidTo": {
