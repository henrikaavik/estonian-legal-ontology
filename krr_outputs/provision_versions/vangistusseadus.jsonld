    },
    {
      "@id": "estleg:VANGIS_Par_113_1_v106082022023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_113_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglaametnik peab vastama vanglaametniku teenistusülesannete täitmiseks kehtestatud hariduse, töökogemuse, tervise ja kehalise ettevalmistuse nõuetele ning isiku teadmistele, oskustele ja isiksuseomadustele kehtestatud nõuetele. (2) Vanglaametniku hariduse, töökogemuse, kehalise ettevalmistuse, teadmiste, oskuste ja isiksuseomaduste nõuded ning nendele vastavuse hindamise korra kehtestab määrusega. (3) Vangla direktori ametikohale esitatavad nõuded ning tema värbamise ja valiku, arendamise ja hindamise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "VANGIS_Par_113_1 (redaktsioon 106082022023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106082022023",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106082022023",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 113_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_114_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_114"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametniku ettevalmistusteenistusse võtta ja vanglaametniku ametikohale ametisse nimetada on keelatud isikut: kes on teovõimetu või piiratud teovõimega; keda on karistatud tahtlikult toimepandud kuriteo eest; kes on kandnud vabadusekaotuslikku karistust; kes on kriminaalasjas kahtlustatav, süüdistatav või kohtualune või kellelt on jõustunud kohtuotsusega ära võetud vanglaametniku ametikohal töötamise õigus.",
      "rdfs:label": {
        "@value": "VANGIS_Par_114 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
