    },
    {
      "@id": "estleg:VANGIS_Par_122_v120122012017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnikku hinnatakse tema teadmiste, oskuste, isiksuseomaduste, hariduse, töökogemuse ja kehalise ettevalmistuse järgi vastavalt ametiastme nõuetele, samuti tema teenistuslikke saavutusi.",
      "rdfs:label": {
        "@value": "VANGIS_Par_122 (redaktsioon 120122012017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122012017",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 122",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_122_1_v120122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_122_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglateenistuse ametnik peab vastama vanglateenistuse ametnikule esitatavatele kehalise ettevalmistuse nõuetele. (2) Kehalise ettevalmistuse nõuded, nende kontrollimise tingimused ja korra",
      "rdfs:label": {
        "@value": "VANGIS_Par_122_1 (redaktsioon 120122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012016",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_122_1_v112072014010"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122012016",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 122_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_122_1_v112072014010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_122_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglateenistuse ametnik peab vastama vanglateenistuse ametnikule esitatavatele kehalise ettevalmistuse nõuetele. (2) Kehalise ettevalmistuse nõuded, nende kontrollimise tingimused ja korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "VANGIS_Par_122_1 (redaktsioon 112072014010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014010",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112072014010",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 122_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_123_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglaametnik kuulub atesteerimisele üks kord kolme aasta jooksul. (2) Atesteerimisperiood pikeneb: käesoleva seaduse § 124 lõike 1 punktis 3 ettenähtud juhul; vanglaametniku teisele sama ametiastme ametikohale üleviimisel või edutamisel – vähemalt kuue kuu täitumiseni nimetatud ametikohal ametisseastumise päevast; avaliku teenistuse seaduse § 92 lõike 3 punktis 2 ettenähtud juhul. (3) Vanglaametnike atesteerimise aja määrab justiitsminister.",
      "rdfs:label": {
        "@value": "VANGIS_Par_123 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_123_v181726"
      },
      "estleg:versionValidTo": {
