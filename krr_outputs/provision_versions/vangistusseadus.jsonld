      }
    },
    {
      "@id": "estleg:VANGIS_Par_19_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnipeetava võib ümber paigutada ühest kinnisest vanglast teise või ühest avavanglast teise, kui see on vajalik kinnipeetava individuaalse täitmiskava elluviimiseks, vabadusekaotuse täideviimise eesmärkide saavutamiseks või julgeoleku kaalutlustel. (2) Kinnipeetava ümberpaigutamise korra kinnitab justiitsminister.",
      "rdfs:label": {
        "@value": "VANGIS_Par_19 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
