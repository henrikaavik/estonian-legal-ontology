      },
      "estleg:versionText": "Kinnipeetav käesoleva seaduse tähenduses on vanglas vangistust kandev süüdimõistetu.",
      "rdfs:label": {
        "@value": "VANGIS_Par_2 (redaktsioon 555428)",
