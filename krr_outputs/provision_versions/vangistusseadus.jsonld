      }
    },
    {
      "@id": "estleg:VANGIS_Par_47_v126062025020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnipeetava toitlustamine korraldatakse rahvatervishoiu seaduse §-s 22 sätestatud ja selle alusel kehtestatud nõuete kohaselt ning kooskõlas üldiste toitumistavadega. (2) Vangla toidukava koostamist ja toitlustamist jälgib toitlustuse eest vastutav isik. (3) Tervishoiutöötaja ettekirjutusel kindlustatakse kinnipeetavale dieettoitlustamine. Võimaluse korral lubatakse kinnipeetaval järgida oma religiooni toitumistavasid.",
      "rdfs:label": {
        "@value": "VANGIS_Par_47 (redaktsioon 126062025020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062025020",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062025020",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 47",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_48_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnipeetav võib oma isikuarvel oleva raha eest sisekorraeeskirjades sätestatud korras osta vangla vahendusel toiduaineid, isikliku hügieeni tarbeid ja muid asju, mille omamine vanglas on lubatud. (2) Arsti ettekirjutusel võidakse kinnipeetavale keelata teatud toiduainete ostmine täielikult või osaliselt, kui need võivad kahjustada kinnipeetava tervist.",
      "rdfs:label": {
        "@value": "VANGIS_Par_48 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_48_v927191"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 48",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_48_v927191",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
