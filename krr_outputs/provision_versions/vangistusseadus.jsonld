      "rdfs:label": {
        "@value": "VANGIS_Par_164 (redaktsioon 13340957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13340957",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13340957",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 164",
