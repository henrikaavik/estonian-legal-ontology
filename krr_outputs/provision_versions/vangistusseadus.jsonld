      },
      "estleg:versionText": "Vanglas töötavate riigiametnike töö tasustamisele kohaldatakse vanglaametniku töö tasustamist reguleerivaid sätteid.",
      "rdfs:label": {
        "@value": "VANGIS_Par_136_3 (redaktsioon 106072023114)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023114",
