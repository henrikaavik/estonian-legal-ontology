      "estleg:provisionRef": "VANGIS § 118",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_119_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 112 lõike 1 punktides 4 ja 5 nimetatud ametiastmele vastavale ametikohale võib ametisse nimetada isiku, kes on läbinud ettevalmistusteenistuse, millest vähemalt poole moodustab praktiline väljaõpe. (2) Käesoleva seaduse § 112 lõike 1 punktides 1–3 nimetatud ametiastmetele vastavale ametikohale võib ametisse nimetada isiku, kes on läbinud ettevalmistusteenistuse, mille käigus omandatakse rakenduslik kõrgharidus.",
      "rdfs:label": {
        "@value": "VANGIS_Par_119 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_119_v181726"
      },
      "estleg:versionValidTo": {
