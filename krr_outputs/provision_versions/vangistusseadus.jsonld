      },
      "estleg:versionText": "Vanglas töötavate riigiametnike distsiplinaarmenetlusele kohaldatakse vanglaametniku distsiplinaarmenetlust reguleerivaid sätteid.",
      "rdfs:label": {
        "@value": "VANGIS_Par_150_1 (redaktsioon 12952945)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12952945",
