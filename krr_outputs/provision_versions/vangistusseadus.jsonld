      "estleg:provisionRef": "VANGIS § 118",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_118_v114032025027",
      "@type": [
