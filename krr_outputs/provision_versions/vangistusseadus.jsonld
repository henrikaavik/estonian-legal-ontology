        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/686312",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 33",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_33_v12952945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vangla direktor võib anda loa kinnipeetava väljaviimiseks järelevalve all kuni kolmeks päevaks, kui tulenevalt vangistuse täideviimise eesmärkidest ei ole kinnipeetavale lühiajalise väljasõidu lubamine võimalik. (2) Lühiajalise väljaviimise kulud kannab kinnipeetav enne väljaviimist. Vangla direktori või tema määratud isiku loal võib erandkorras lubada kulude hüvitamist pärast väljaviimist. (3) Lühiajalise väljaviimise aeg arvatakse karistuse kandmise aja hulka.",
      "rdfs:label": {
        "@value": "VANGIS_Par_33 (redaktsioon 12952945)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12952945",
