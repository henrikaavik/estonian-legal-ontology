    {
      "@id": "estleg:VANGIS_Par_109_v1036434",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnipeetava saatmiseks on vanglas relvastatud saatemeeskond, mille isikkoosseisule antakse eriväljaõpe. (2) Saatemeeskonna ülesanded ja töökord sätestatakse (4) Vajaduse korral kaasatakse kinnipeetavate saatmiseks politseiametnikke.",
      "rdfs:label": {
        "@value": "VANGIS_Par_109 (redaktsioon 1036434)",
