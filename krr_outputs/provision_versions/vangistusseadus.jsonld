      "rdfs:label": {
        "@value": "VANGIS_Par_167 (redaktsioon 181726)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181726",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_167_v555428"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181726",
