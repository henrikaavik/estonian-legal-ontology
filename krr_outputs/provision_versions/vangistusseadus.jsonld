      }
    },
    {
      "@id": "estleg:VANGIS_Par_86_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aresti ja haldusaresti täideviimisele kohaldatakse käesoleva seaduse 1. ja 2. ning 6. ja 7. peatüki sätteid käesolevas peatükis sätestatud erisustega. (2) Arestialuseid hoitakse ööpäevaringselt lukustatud kambrites. (3) Arestialust avavanglasse ümber ei paigutata. (4) Arestialune ei ole kohustatud töötama.",
      "rdfs:label": {
        "@value": "VANGIS_Par_86 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_86_v181726"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 86",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_86_v181726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aresti ja kuni kolmekuulise vangistuse täideviimisele kohaldatakse käesoleva seaduse 1., 2., 6. ja 7. peatüki sätteid käesolevas peatükis sätestatud erisustega. (2) Arestialuseid hoitakse ööpäevaringselt lukustatud kambrites. (3) Arestialust avavanglasse ümber ei paigutata. (4) Arestialune ei ole kohustatud töötama.",
      "rdfs:label": {
        "@value": "VANGIS_Par_86 (redaktsioon 181726)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181726",
