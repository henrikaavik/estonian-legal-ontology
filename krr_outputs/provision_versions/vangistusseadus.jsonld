      }
    },
    {
      "@id": "estleg:VANGIS_Par_55_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnipeetavale tagatakse võimalus kehakultuuriga tegelemiseks. (2) Kinnipeetavale võimaldatakse jalutuskäik värskes õhus vähemalt üks tund päevas.",
      "rdfs:label": {
        "@value": "VANGIS_Par_55 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 55",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_56_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava raskest haigestumisest või surmast informeerib vangla direktor viivitamatult tema omakseid või kinnipeetava soovil mõnda teist isikut.",
      "rdfs:label": {
        "@value": "VANGIS_Par_56 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_56_v12772547"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 56",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_56_v12772547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava raskest haigestumisest või surmast informeerib vangla viivitamata tema omakseid või kinnipeetava soovil mõnda teist isikut. Välisriigi kodanikust kinnipeetava surmast informeerib vangla viivitamata kinnipeetava asukohariigi konsulaarasutust.",
      "rdfs:label": {
        "@value": "VANGIS_Par_56 (redaktsioon 12772547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12772547",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_56_v13197839"
      },
      "estleg:versionValidTo": {
