      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VANGIS_Par_150_1 (redaktsioon 120122012017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122012017",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 150_1",
      "estleg:partOfAct": {
