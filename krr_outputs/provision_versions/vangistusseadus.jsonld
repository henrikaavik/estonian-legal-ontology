      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnike ametisse nimetamise, edutamise ja ülendamise täpsemad tingimused ja korra kehtestab Vabariigi Valitsus vanglaametnike teenistuskäigu määrusega.",
      "rdfs:label": {
        "@value": "VANGIS_Par_131 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
