      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VANGIS_Par_154_2 (redaktsioon 127052022050)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127052022050",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127052022050",
      "estleg:sourceAct": "Vangistusseadus",
