      }
    },
    {
      "@id": "estleg:VANGIS_Par_131_v112072014010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_131"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnike ametisse nimetamise ja edutamise täpsemad tingimused ja korra kehtestab vanglaametnike teenistuskäigu määrusega.",
      "rdfs:label": {
        "@value": "VANGIS_Par_131 (redaktsioon 112072014010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014010",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112072014010",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 131",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_132_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_132"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnik ei tohi avaldada talle seoses teenistusülesannete täitmisega teatavaks saanud asjaolusid, sealhulgas kinnipeetavate isiklikke suhteid puudutavaid asjaolusid. Ametisaladuse hoidmise kohustus on tähtajatu.",
      "rdfs:label": {
        "@value": "VANGIS_Par_132 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 132",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_132_1_v120122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_132_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglateenistuse ametnikul on õigus anda oma pädevuse piires teenistusülesannete täitmiseks suulisi ja kirjalikke korraldusi. (2) Korraldus peab olema kooskõlas seaduste ja nende alusel kehtestatud õigusaktidega. (3) Kui korralduse saaja ei saa korraldusest aru, peab ta küsima korralduse andjalt selgitusi.",
      "rdfs:label": {
        "@value": "VANGIS_Par_132_1 (redaktsioon 120122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122012016",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 132_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_132_2_v120122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_132_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korralduse täitmise tagajärgede eest vastutab korralduse andja. (2) Kui korralduse saaja täidab korraldust, millest ei selgu korralduse andja, vastutab täitmise tagajärgede eest korralduse täitja. (3) Kui korralduse täitmise tagajärjeks on esimese astme kuriteo tunnustele vastav tegu, vastutavad korralduse täitmise tagajärgede eest nii korralduse andja kui ka korralduse saaja.",
      "rdfs:label": {
        "@value": "VANGIS_Par_132_2 (redaktsioon 120122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122012016",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 132_2",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_133_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_133"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnik on kohustatud vangla direktorile või kõrgemale kohalviibivale vanglaametnikule viivitamatult teatama kõikidest karistuse täideviimisel esile kerkivatest tähtsatest juhtudest, mis puudutavad vangla sisekorraeeskirjade täitmist ja vangla julgeolekut, samuti tähelepanekutest kinnipeetava kohta, mis aitavad kaasa karistuse täideviimise eesmärkide saavutamisele. Kinnipeetava haigestumisest on vanglaametnik kohustatud viivitamatult informeerima vangla arsti.",
      "rdfs:label": {
        "@value": "VANGIS_Par_133 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_133_v12772547"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 133",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_133_v12772547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_133"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnik on kohustatud vangla direktorile või kõrgemale kohalviibivale vanglaametnikule viivitamatult teatama kõikidest karistuse täideviimisel esile kerkivatest tähtsatest juhtudest, mis puudutavad vangla sisekorraeeskirjade täitmist ja vangla julgeolekut, samuti tähelepanekutest kinnipeetava kohta, mis aitavad kaasa karistuse täideviimise eesmärkide saavutamisele. Kinnipeetava või vahistatu haigestumisest, vigastusest või mürgistusest on vanglaametnik kohustatud viivitamata informeerima arsti või õde.",
      "rdfs:label": {
        "@value": "VANGIS_Par_133 (redaktsioon 12772547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12772547",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_133_v122032024012"
      },
      "estleg:versionValidTo": {
        "@value": "2024-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12772547",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 133",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_133_v122032024012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_133"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnik on kohustatud vangla direktorile või kõrgemale kohalviibivale vanglaametnikule viivitamatult teatama kõikidest karistuse täideviimisel esile kerkivatest tähtsatest juhtudest, mis puudutavad vangla sisekorraeeskirjade täitmist ja vangla julgeolekut, samuti tähelepanekutest kinnipeetava kohta, mis aitavad kaasa karistuse täideviimise eesmärkide saavutamisele. Kinnipeetava või vahistatu haigestumisest, vigastusest või mürgistusest on vanglaametnik kohustatud viivitamata informeerima tervishoiutöötajat.",
      "rdfs:label": {
        "@value": "VANGIS_Par_133 (redaktsioon 122032024012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032024012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122032024012",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 133",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_134_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_134"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistuskohustuste täitmisel kannab vanglaametnik vormiriietust.",
      "rdfs:label": {
        "@value": "VANGIS_Par_134 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 134",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_135_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_135"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks avaliku teenistuse seaduses sätestatud teenistuspiirangutele ei tohi vanglaametnik: osaleda streikides, pikettides ega muudes teenistusalastes surveaktsioonides või töötada teise tööandja juures, välja arvatud pedagoogilisel, teaduslikul või loomingulisel tööl.",
      "rdfs:label": {
        "@value": "VANGIS_Par_135 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_135_v12772547"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 135",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
