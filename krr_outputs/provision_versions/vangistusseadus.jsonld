      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava raskest haigestumisest või surmast informeerib vanglateenistus viivitamata tema omakseid või kinnipeetava soovil mõnda teist isikut. Välisriigi kodanikust kinnipeetava surmast informeerib vanglateenistus viivitamata kinnipeetava kodakondsusjärgse riigi välisesindust.",
      "rdfs:label": {
        "@value": "VANGIS_Par_56 (redaktsioon 13204483)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13204483",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13204483",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 56",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_57_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalhoolekande eesmärk on aidata kinnipeetaval säilitada ja luua sotsiaalselt olulisi ja positiivseid kontakte väljaspool vanglat, suurendada tema iseseisvat toimetulekuvõimet ning mõjutada teda õiguskuulekalt käituma.",
      "rdfs:label": {
        "@value": "VANGIS_Par_57 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_57_v245997"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 57",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_57_v245997",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalhoolekande eesmärk on aidata kinnipeetaval säilitada ja luua sotsiaalselt olulisi ja positiivseid kontakte väljaspool vanglat, suurendada tema iseseisvat toimetulekuvõimet ning mõjutada teda õiguskuulekalt käituma. § 58. Sotsiaaltöötaja (1) Sotsiaalhoolekannet vanglas korraldab vangla sotsiaaltöötaja, kelle nimetab ametisse vangla direktor. (2) Sotsiaaltöötajaks võib nimetada vastava erialase kõrgharidusega isiku. (3) Sotsiaaltöötajale laienevad kõik vanglaametniku sotsiaalsed tagatised.",
      "rdfs:label": {
        "@value": "VANGIS_Par_57 (redaktsioon 245997)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "245997",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_57_v262345"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/245997",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 57",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
