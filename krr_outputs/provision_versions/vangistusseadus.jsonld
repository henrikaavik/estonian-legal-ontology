      "estleg:provisionRef": "VANGIS § 105",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_105_v114032025027",
      "@type": [
