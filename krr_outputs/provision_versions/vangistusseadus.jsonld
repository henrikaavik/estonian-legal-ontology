      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglasse vastuvõtmisel nõustatakse kinnipeetavat tema lähedaste sotsiaalse turvalisuse tagamise ja vara säilitamise osas ning antakse kinnipeetavale õigusabi.",
      "rdfs:label": {
        "@value": "VANGIS_Par_59 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
