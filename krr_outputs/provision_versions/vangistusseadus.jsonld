      "estleg:provisionRef": "VANGIS § 67_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_67_1_v116042014012",
