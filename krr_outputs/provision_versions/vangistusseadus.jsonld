        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnikele kohaldatakse avaliku teenistuse seaduse 8. peatükis sätestatud distsiplinaarvastutuse regulatsiooni käesolevas seaduses sätestatud erisustega.",
      "rdfs:label": {
