    },
    {
      "@id": "estleg:VANGIS_Par_66_1_v131122024035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_66_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vangla julgeoleku tagamiseks on vanglateenistusel õigus vanglasse sisenemise loa andmisest keelduda, kui esineb põhjendatud kahtlus, et luba taotlev isik võib ohustada karistuse täideviimist või vangla julgeolekut või korda.",
      "rdfs:label": {
        "@value": "VANGIS_Par_66_1 (redaktsioon 131122024035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122024035",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122024035",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 66_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_67_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeoleku tagamiseks vanglas on kinnipeetav kohustatud: täitma vangla sisekorraeeskirju ja alluma vanglaametnike seaduslikele korraldustele; mitte takistama vanglaametnike kohustuste täitmist ega häirima teisi kinnipeetavaid ja muid isikuid; teatama viivitamatult vangla direktorile kõikidest asjaoludest, mis võivad ohustada vangla julgeolekut ja sisekorda ning teise isiku elu ja tervist; suhtuma heaperemehelikult talle usaldatud esemetesse ja pidama korras tema kasutuses olevad elu- ja olmeruumid.",
      "rdfs:label": {
        "@value": "VANGIS_Par_67 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_67_v13204483"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-23",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 67",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_67_v13204483",
