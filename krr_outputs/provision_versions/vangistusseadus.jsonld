      }
    },
    {
      "@id": "estleg:VANGIS_Par_11_1_v116042014012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_11_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnipeetavate arv vanglas ei tohi ületada selle vangla jaoks valdkonna eest vastutava ministri kehtestatud kinnipeetavate piirarvu. (2) Vanglas lubatud kinnipeetavate piirarvu määramisel tuleb arvestada vangla võimalusi korraldada kinnipeetava olmetingimusi, töötamist, õppimist ja vaba aja veetmist. (3) Vanglas lubatud kinnipeetavate piirarvu määrab valdkonna eest vastutav minister täitmisplaanis.",
      "rdfs:label": {
        "@value": "VANGIS_Par_11_1 (redaktsioon 116042014012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116042014012",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_11_1_v106052020043"
      },
      "estleg:versionValidTo": {
        "@value": "2020-05-06",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116042014012",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 11_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_11_1_v106052020043",
