      }
    },
    {
      "@id": "estleg:VANGIS_Par_12_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglas hoitakse eraldi: mehi ja naisi; alaealisi ja täiskasvanuid; süüdimõistetuid ja vahistatuid; esmakordselt karistatuid ja vabadusekaotusega korduvalt karistatuid; aresti ja vabadusekaotusega karistatuid; isikuid, kes kannavad eluaegset vabadusekaotust; isikuid, keda nende endise ametialase tegevuse tõttu ähvardab kättemaksuoht. (2) Erandkorras võib vangla direktor paigutada kinnipeetavaid eraldi ka käesoleva paragrahvi lõikes 1 nimetamata tunnuste alusel. (3) Kinnises vanglas on eraldihoidmise printsiibi täitmiseks teineteisest eraldatud osakonnad ja kambrid. (4) Avavanglas arvestatakse käesoleva paragrahvi lõikes 1 sätestatut kinnipeetavate jaotamisel kohtlemisgruppidesse.",
      "rdfs:label": {
        "@value": "VANGIS_Par_12 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_12_v181726"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
