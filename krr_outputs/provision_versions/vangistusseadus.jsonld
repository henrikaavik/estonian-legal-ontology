    {
      "@id": "estleg:VANGIS_Par_85_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aresti kandmine toimub otsuse teinud kohtu asukohajärgses või arestialuse elukohajärgses arestimajas. (2) Ajateenijale mõistetud aresti kandmine toimub garnisoni arestimajas. (3) Haldusaresti kandmine toimub otsuse teinud kohtu asukohajärgses või arestialuse elukohajärgses arestimajas.",
      "rdfs:label": {
        "@value": "VANGIS_Par_85 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_85_v181726"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 85",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_85_v181726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aresti ja kuni kolmekuulise vangistuse kandmine toimub otsuse teinud kohtu asukohajärgses või arestialuse elukohajärgses arestimajas. (2) Ajateenijale mõistetud aresti ja kuni kolmekuulise vangistuse kandmine toimub garnisoni arestimajas.",
      "rdfs:label": {
        "@value": "VANGIS_Par_85 (redaktsioon 181726)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181726",
      "estleg:supersededByVersion": {
