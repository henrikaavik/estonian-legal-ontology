    {
      "@id": "estleg:VANGIS_Par_15_v1003607",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 31. 03. 2006] (1) Vanglasse vastuvõtmisel kinnipeetavaga kaasas olevad isiklikud asjad võetakse vangla juhtkonna poolt hoiule. [Lõike 1 sõnastus alates 1. 04. 2006] (1) Vanglasse vastuvõtmisel kinnipeetavaga kaasas olevad isiklikud asjad ja tema isikut tõendavad dokumendid võtab vangla juhtkond hoiule. Kinnipeetava isikutunnistuse digitaalset kasutamist võimaldavad koodid võetakse hoiule kinnipeetava soovil.",
      "rdfs:label": {
        "@value": "VANGIS_Par_15 (redaktsioon 1003607)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003607",
