        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks avaliku teenistuse seaduses sätestatud teenistuspiirangutele ei tohi vanglaametnik osaleda streikides, pikettides ega muudes teenistusalastes surveaktsioonides.",
      "rdfs:label": {
        "@value": "VANGIS_Par_135 (redaktsioon 12772547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12772547",
      "estleg:supersededByVersion": {
