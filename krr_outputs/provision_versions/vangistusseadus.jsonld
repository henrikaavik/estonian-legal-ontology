        "@id": "estleg:VANGIS_Par_99_v120122012016"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13204483",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 99",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_99_v120122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_99"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Olulistel ja edasilükkamatutel isiklikel, õiguslikel või ärilistel asjaoludel, mis nõuavad vahistatu isiklikku kohalolekut, on vanglateenistuse ametnikul õigus lubada vahistatu välja viia järelevalve all kuni üheks päevaks, kui selleks on andnud nõusoleku uurimisasutus, prokuratuur või kohus, kui kriminaalasi on kohtu menetluses. Väljaviimise kulud kannab vahistatu. (2) Luba antakse vahistatu taotluse alusel. (3) Vahistatule ei kohaldata käesoleva seaduse §-s 32 sätestatud lühiajalist väljasõitu.",
      "rdfs:label": {
        "@value": "VANGIS_Par_99 (redaktsioon 120122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122012016",
