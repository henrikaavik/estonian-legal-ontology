      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riik tagab vanglaametnikule tasuta terviseuuringud. Terviseuuringute läbiviimise tingimused, perioodilisuse ja korra kehtestab Vabariigi Valitsus määrusega.",
      "rdfs:label": {
        "@value": "VANGIS_Par_146 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
