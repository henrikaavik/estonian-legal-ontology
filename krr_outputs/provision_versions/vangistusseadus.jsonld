        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_105"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vangla on Justiitsministeeriumi valitsemisalas olev valitsusasutus, mille ülesandeks on vangistuse, aresti ja eelvangistuse täideviimine käesolevas seaduses sätestatud korras. (3) Vangla kodukorra kinnitab vangla direktor kooskõlastatult Justiitsministeeriumiga.",
      "rdfs:label": {
        "@value": "VANGIS_Par_105 (redaktsioon 927191)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "927191",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_105_v12772547"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/927191",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 105",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_105_v12772547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_105"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vangla on Justiitsministeeriumi valitsemisalas olev valitsusasutus, mille ülesandeks on vangistuse ja eelvangistuse täideviimine käesolevas seaduses sätestatud korras. (2) Vangla moodustab ning vangla põhimääruse, koosseisud ja vangla sisekorraeeskirjad (2¹) Vangla kodukorras sätestatakse kinnipeetava või vahistatu: vastuvõtt ja vanglasisene paigutus; päevakava; töötamise ja õppimise korraldus; vaba aja veetmise võimalused; sisseostude tegemine; kokkusaamised ja telefoni kasutamine; lühiajaline väljasõit ja väljaviimine; usuliste vajaduste rahuldamine; meditsiiniline teenindamine; ametnike vastuvõtt; kirjavahetuse korraldus; distsiplinaarmenetluse läbiviimine ja distsiplinaarkaristuse täideviimine; ümberpaigutamine ja vanglast vabastamine; muud reguleerimist vajavad asjaolud. (2²) Vangla kodukord tehakse allkirja vastu teatavaks vanglasse saabuvale kinnipeetavale ja vahistatule, samuti avaldatakse vangla kodukord vangla veebilehel. (3) Vangla kodukorra kinnitab vangla direktor kooskõlastatult Justiitsministeeriumiga.",
      "rdfs:label": {
        "@value": "VANGIS_Par_105 (redaktsioon 12772547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12772547",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_105_v12952945"
      },
      "estleg:versionValidTo": {
        "@value": "2008-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12772547",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 105",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_105_v12952945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_105"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vangla on Justiitsministeeriumi valitsemisalas olev valitsusasutus, mille ülesandeks on vangistuse ja eelvangistuse täideviimine käesolevas seaduses sätestatud korras. (1¹) Justiitsminister määrab ülesannete jaotuse Justiitsministeeriumi ja vanglate vahel. Ülesannete jaotuse ja ülesannete ülemineku korra vanglate ja Justiitsministeeriumi vahel (2) Vangla moodustab ning vangla põhimääruse, koosseisud ja vangla sisekorraeeskirjad (2¹) Vangla kodukorras sätestatakse kinnipeetava või vahistatu: vastuvõtt ja vanglasisene paigutus; päevakava; töötamise ja õppimise korraldus; vaba aja veetmise võimalused; sisseostude tegemine; kokkusaamised ja telefoni kasutamine; lühiajaline väljasõit ja väljaviimine; usuliste vajaduste rahuldamine; meditsiiniline teenindamine; ametnike vastuvõtt; kirjavahetuse korraldus; distsiplinaarmenetluse läbiviimine ja distsiplinaarkaristuse täideviimine; ümberpaigutamine ja vanglast vabastamine; muud reguleerimist vajavad asjaolud. (2²) Vangla kodukord tehakse allkirja vastu teatavaks vanglasse saabuvale kinnipeetavale ja vahistatule, samuti avaldatakse vangla kodukord vangla veebilehel. (3) Vangla kodukorra kinnitab vangla direktor kooskõlastatult Justiitsministeeriumiga.",
      "rdfs:label": {
        "@value": "VANGIS_Par_105 (redaktsioon 12952945)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12952945",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_105_v13204483"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-23",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12952945",
