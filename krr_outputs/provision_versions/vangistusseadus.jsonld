      }
    },
    {
      "@id": "estleg:VANGIS_Par_28_v13204483",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Kirjavahetus ja telefoni kasutamine toimub kinnipeetava kulul. (3) Kinnipeetava käesoleva paragrahvi lõikes 1 sätestatud õigust võib vanglateenistuse ametnik piirata, kui see ohustab vangla julgeolekut või sisekorda või kahjustab vangistuse täideviimise eesmärke. Keelatud on kirjavahetuse ja telefoni kasutamise piiramine suhtlemiseks riigiasutuste, kohalike omavalitsuste ja nende ametiisikutega, samuti kaitsjaga.",
      "rdfs:label": {
        "@value": "VANGIS_Par_28 (redaktsioon 13204483)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13204483",
