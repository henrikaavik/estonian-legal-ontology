      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "vanglateenistuse ametnike ja töötajate eetikakoodeksi.",
      "rdfs:label": {
        "@value": "VANGIS_Par_135_1 (redaktsioon 120122012017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012017",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_135_1_v112072014010"
      },
      "estleg:versionValidTo": {
