      }
    },
    {
      "@id": "estleg:VANGIS_Par_90_v121062024032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eelvangistuse kandmisele kohaldatakse käesoleva seaduse 1., 2., ja 7. peatüki sätteid käesolevas peatükis sätestatud erisustega. (2) Eelvangistust kantakse kinnise vangla eelvangistusosakonnas või arestimajas. (3) Kehtetu - (4) Vahistatu kamber peab vastama käesoleva seaduse § 45 lõikes 1 sätestatud tingimustele ja tagama vahistatu pideva visuaalse või elektroonilise jälgimise. (5) Kehtetu -",
      "rdfs:label": {
        "@value": "VANGIS_Par_90 (redaktsioon 121062024032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062024032",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 90",
