    },
    {
      "@id": "estleg:VANGIS_Par_49_v121062024031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tervishoid vanglas on riigi tervishoiusüsteemi osa. Tervishoidu vanglas rahastatakse riigieelarveliste võimaluste piires tervishoiuteenuste korraldamise seaduse alusel, arvestades käesolevas seaduses sätestatud erisustega. (2) Kehtetu - (3) Tervishoiuteenuste osutamise kinnipeetavale, arestialusele või vahistatule (edaspidi vanglas kinni peetav isik) korraldab Tervisekassa. , osaliselt muudetud [RT I, 21.06.2024, 2] (4) Tervishoiuteenuste osutamise korraldamise tingimused ja korra kehtestab määrusega. (5) Vanglateenistus tagab tervishoiuteenuse osutamiseks tervishoiuteenuste korraldamise seaduses sätestatud nõuete kohaste vajalike ruumide olemasolu vangla territooriumil. (6) Vanglas kinni peetava isiku pöördumisele seoses talle tervishoiuteenuste ja käesoleva seaduse § 52 lõike 11 alusel kehtestatud teenuste osutamise korraldamisega vastab vanglateenistus, kaasates tervishoiuteenuse osutaja ja vajaduse korral Tervisekassa. , osaliselt muudetud [RT I, 21.06.2024, 2]",
      "rdfs:label": {
        "@value": "VANGIS_Par_49 (redaktsioon 121062024031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024031",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062024031",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 49",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
