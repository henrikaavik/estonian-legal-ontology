        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_111_v104032011017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_111"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglaametnik on vanglas teenistuses olev ametnik, kelle ülesanne on kinnipeetava, vahistatu ja karistusjärgselt kinnipeetava kinnipidamine ja järelevalve, julgeoleku tagamine vanglas ning kohtueelse menetluse või kohtuvälise menetluse toimetamine vanglas toimepandud süütegudes, samuti sellealase tegevuse juhtimine. (1¹) Teenistuseks vanglaametnikuna loetakse ka teenistus sisekaitselise rakenduskõrgkooli või muu vanglaametnike ettevalmistusteenistust läbiviiva asutuse korrektsioonialast haridust andva struktuuriüksuse juhi ja korrektsiooni erialaõppejõu ametikohal, samuti osalemine eksperdina rahvusvahelisel tsiviilmissioonil. (2) Justiitsministeeriumi ametnik võib täita vanglaametniku või muu vanglatöötaja ülesandeid. (2¹) Justiitsministeeriumi ametnik võib anda vanglaametnikule või muule vanglatöötajale korraldusi. (3) Käesoleva paragrahvi lõigetes 2 ja 21 nimetatud ülesannete täitmise ja korralduste andmise korra (4) Kui Justiitsministeeriumi ametnik täidab vanglas teenistusülesandeid, laienevad temale vanglaametniku või muu vanglatöötaja õigused ja kohustused, välja arvatud käesoleva seaduse 6. peatüki 2. jaos sätestatud vanglaametniku õigused ja kohustused.",
      "rdfs:label": {
        "@value": "VANGIS_Par_111 (redaktsioon 104032011017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104032011017",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_111_v120122012016"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104032011017",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 111",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
