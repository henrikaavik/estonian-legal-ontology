        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2003 aasta 1. jaanuarini võib sotsiaaltöötajana ametisse nimetada ka isiku, kellel on mõni muu kõrgharidus kui sotsiaaltööalane või sotsiaalpedagoogiline kõrgharidus.",
      "rdfs:label": {
        "@value": "VANGIS_Par_171 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 171",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik, kellele on mõistetud vabadusekaotus poolkinnises vanglas, jätkab pärast käesoleva seaduse jõustumist karistuse kandmist kinnises vanglas.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_172_v555428"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_v555428",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik, kellele on mõistetud vangistus poolkinnises vanglas, jätkab pärast käesoleva seaduse jõustumist karistuse kandmist kinnises vanglas.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172 (redaktsioon 555428)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "555428",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/555428",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_1_v12772547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetavad, kellel on käesoleva seaduse jõustumiseks hoiustatud vabanemistoetusena üle kolme Vabariigi Valitsuse kehtestatud miinimumpalga suurune summa, võivad üle määratud suuruse hoiustatud raha kasutada vanglasiseselt vastavalt ettenähtud piirmäärale, kasutada rahaliste nõuete täitmiseks, saata oma perekonnaliikmele või ülalpeetavale või kanda arvelduskontole pangas.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_1 (redaktsioon 12772547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12772547",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12772547",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_1",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_2_v12772547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevalmistusteenistuse läbimise kohustust ei või panna ka isikule, kes on vähemalt kaks aastat töötanud vanema politsei-, piirivalve-, pääste- või vanglaametnikuna ja kes on nimetatud ametisse enne 2007. aasta 1. veebruari.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_2 (redaktsioon 12772547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12772547",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12772547",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_2",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_3_v12772547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 119 lõiget 1 kohaldatakse ka isikute suhtes, kes on läbinud nooremvanglaametniku põhikoolituse aastatel 1998–2000.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_3 (redaktsioon 12772547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12772547",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12772547",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_3",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_4_v13153089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2009. aasta 1. märtsist kuni 2010. aasta 31. detsembrini võib Vabariigi Valitsus vähendada vanglaametnikule ja vanglas töötavale riigiametnikule kehtivat Vabariigi Valitsuse määrusega kinnitatud palgamäära ja diferentseeringut. Vabariigi Valitsus ei pea pärast 2010. aasta 31. detsembrit tõstma palgamäära ega diferentseeringut endisele tasemele.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_4 (redaktsioon 13153089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13153089",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13153089",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_4",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_5_v120122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 1051 lõikes 4, § 114 lõikes 2 ja § 1141 lõikes 8 nimetatud isikud, kes on vanglateenistuses, vanglas tööl või vanglaametniku ettevalmistusteenistuses ning ei ole täitnud isikuandmete ankeeti, esitavad hiljemalt 2013. aasta 1. aprilliks isikuandmete ankeedi Justiitsministeeriumi vanglate osakonnale või vanglale.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_5 (redaktsioon 120122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122012016",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_5",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_6_v117122015096",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglaametnikul, kellel on tuvastatud osaline töövõimetus riikliku pensionikindlustuse seaduse alusel, loetakse käesoleva seaduse § 118 lõike 2 punktis 2 sätestatud osalise töövõime tingimus täidetuks. Vanglaametnikul, kellel on tuvastatud täielik töövõimetus riikliku pensionikindlustuse seaduse alusel, loetakse käesoleva seaduse § 118 lõike 2 punktis 2 sätestatud puuduva töövõime tingimus täidetuks. (jõustumine muudetud - RT I, 17.12.2015, 1)",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_6 (redaktsioon 117122015096)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015096",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117122015096",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_6",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_7_v103032021002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-03-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses sätestatud võimalust paigutada arestiga karistatud, samuti kuni 48 tunniks kinni peetud või sundtoomisele allutatud või kainenema toimetatud joobeseisundis isik vanglasse, kohaldatakse vaid Tartu ja Viru Vanglas.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_7 (redaktsioon 103032021002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103032021002",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_172_7_v127112024002"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-06",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103032021002",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_7",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_7_v127112024002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatud võimalust paigutada korrakaitseseaduse alusel kainenema toimetatud joobeseisundis isik vanglasse kohaldatakse vaid Tartu Vanglas ja Viru Vanglas. (2) Kuni 2025. aasta 31. märtsini võib seaduses sätestatud võimalust paigutada arestiga karistatud isik, kuni 48 tunniks kinni peetud isik, sundtoomisele allutatud isik või kainenema toimetatud joobeseisundis isik vanglasse kohaldada vaid Tartu Vanglas ja Viru Vanglas.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_7 (redaktsioon 127112024002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127112024002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127112024002",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_7",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_8_v106082022023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2022. aasta 1. juulit ametisse nimetatud vangla direktorile makstakse teenistustähtaja möödumisel teenistusest vabastamisel hüvitist kuue kuu ametipalga ulatuses.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_8 (redaktsioon 106082022023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106082022023",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106082022023",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_8",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_172_9_v122032024012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_172_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alates 2024. aasta 1. juunist ei avata vanglasse saabuvale kinnipeetavale, vahistatule ja arestialusele isiklikku toimikut ning isiku käesoleva seaduse §-s 53 sätestatud andmed kantakse vangiregistrisse. Kui isiklik toimik on juba avatud, säilitatakse toimikut kolm aastat pärast karistusaja lõppemist või isiku surma. Isiklikud toimikud arhiveeritakse arhiiviseaduse § 13 alusel sätestatud korras.",
      "rdfs:label": {
        "@value": "VANGIS_Par_172_9 (redaktsioon 122032024012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032024012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122032024012",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 172_9",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_173_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2000. aasta 1. detsembril.",
      "rdfs:label": {
        "@value": "VANGIS_Par_173 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 173",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_18_v26427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglasse saabunud isik fotografeeritakse ja daktüloskopeeritakse. Kinnipeetava signaleetilisi fotosid ja daktüloskoopilist kaarti hoitakse kinnipeetava isiklikus toimikus. Üks komplekt signaleetilisi fotosid saadetakse isiku vahistamist taotlenud kohtueelse uurimise asutusele kriminaalasjale lisamiseks ja üks daktüloskoopiline kaart Politsei Teabebüroole.",
      "rdfs:label": {
        "@value": "VANGIS_Par_18 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_18_v1003607"
      },
      "estleg:versionValidTo": {
        "@value": "2006-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26427",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_18_v1003607",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglasse saabunud isik fotografeeritakse ja daktüloskopeeritakse. Kinnipeetava signaleetilisi fotosid ja daktüloskoopilist kaarti hoitakse kinnipeetava isiklikus toimikus. Üks komplekt signaleetilisi fotosid saadetakse isiku vahistamist taotlenud kohtueelse uurimise asutusele kriminaalasjale lisamiseks ja üks daktüloskoopiline kaart Politsei Teabebüroole. [Paragrahv 181 jõustub 1. 07. 2006]",
      "rdfs:label": {
        "@value": "VANGIS_Par_18 (redaktsioon 1003607)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003607",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_18_v1036434"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1003607",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_18_v1036434",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglasse saabunud isik fotografeeritakse ja daktüloskopeeritakse. Kinnipeetava signaleetilisi fotosid ja daktüloskoopilist kaarti hoitakse kinnipeetava isiklikus toimikus. Üks komplekt signaleetilisi fotosid saadetakse isiku vahistamist taotlenud kohtueelse uurimise asutusele kriminaalasjale lisamiseks ja üks daktüloskoopiline kaart Politsei Teabebüroole. [Paragrahv 18 1 jõustub 1. 07. 2006]",
      "rdfs:label": {
        "@value": "VANGIS_Par_18 (redaktsioon 1036434)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036434",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_18_v12771631"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036434",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_18_v12771631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglasse saabunud isik fotografeeritakse ja daktüloskopeeritakse. Kinnipeetava signaleetilisi fotosid ja daktüloskoopilist kaarti hoitakse kinnipeetava isiklikus toimikus. Üks komplekt signaleetilisi fotosid saadetakse isiku vahistamist taotlenud kohtueelse uurimise asutusele kriminaalasjale lisamiseks ja üks daktüloskoopiline kaart Politsei Teabebüroole.",
      "rdfs:label": {
        "@value": "VANGIS_Par_18 (redaktsioon 12771631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12771631",
