    },
    {
      "@id": "estleg:VANGIS_Par_88_1_v13251273",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_88_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Arestialusele ei kohaldata käesoleva seaduse § 75 lõikes 1 sätestatud vabastamist. (2) Arestialuse vabastamisel ei maksta vabanemistoetust. (3) Kui arestialune on paigutatud arestimajja käesoleva seaduse § 85 lõiget 1 järgimata, tagab see politseiasutus, kelle arestimajas arestialune oma karistust kannab, arestialuse vabanemisel arestialuse transpordi tema elukohta või hüvitab arestialusele ühistranspordi kulud tema elukohta.",
      "rdfs:label": {
        "@value": "VANGIS_Par_88_1 (redaktsioon 13251273)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13251273",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_88_1_v129122011054"
      },
      "estleg:versionValidTo": {
