      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "kehtestab vanglateenistuse ametnike ja töötajate eetikakoodeksi.",
      "rdfs:label": {
        "@value": "VANGIS_Par_135_1 (redaktsioon 112072014010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014010",
