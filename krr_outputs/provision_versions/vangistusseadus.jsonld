      },
      "estleg:versionValidTo": {
        "@value": "2012-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129122011054",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 18",
