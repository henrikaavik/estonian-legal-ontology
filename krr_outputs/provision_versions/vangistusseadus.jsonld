    {
      "@id": "estleg:VANGIS_Par_147_v112072014010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_147"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanglateenistuse ametnikule antakse tasuta vormiriietus. (2) Vanglateenistuse ametikohtade loetelu, kes kannavad vormiriietust, vormiriietuse kirjelduse ja kandmise korra, samuti eraldusmärkide kirjelduse ja kandmise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "VANGIS_Par_147 (redaktsioon 112072014010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014010",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112072014010",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 147",
      "estleg:partOfAct": {
