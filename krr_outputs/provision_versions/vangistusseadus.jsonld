    },
    {
      "@id": "estleg:VANGIS_Par_56_v13197839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VANGIS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava raskest haigestumisest või surmast informeerib vangla viivitamata tema omakseid või kinnipeetava soovil mõnda teist isikut. Välisriigi kodanikust kinnipeetava surmast informeerib vangla viivitamata kinnipeetava kodakondsusjärgse riigi välisesindust.",
      "rdfs:label": {
        "@value": "VANGIS_Par_56 (redaktsioon 13197839)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13197839",
      "estleg:supersededByVersion": {
        "@id": "estleg:VANGIS_Par_56_v13204483"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-23",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13197839",
      "estleg:sourceAct": "Vangistusseadus",
      "estleg:provisionRef": "VANGIS § 56",
      "estleg:partOfAct": {
        "@id": "estleg:VANGIS_Map_2026"
      }
    },
    {
      "@id": "estleg:VANGIS_Par_56_v13204483",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
