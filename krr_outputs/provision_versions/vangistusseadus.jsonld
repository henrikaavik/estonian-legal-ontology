      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 69 lõikes 1 sätestatud alustel võib vangla direktor kohaldada vahistatu suhtes käesoleva seaduse §-des 69 ja 70 sätestatud täiendavaid julgeolekuabinõusid.",
      "rdfs:label": {
        "@value": "VANGIS_Par_103 (redaktsioon 26427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26427",
      "estleg:supersededByVersion": {
