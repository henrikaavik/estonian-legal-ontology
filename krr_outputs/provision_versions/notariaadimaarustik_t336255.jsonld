      "estleg:provisionRef": "Reg_336255 § 43",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336255_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_336255_Par_44_v336255",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336255_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teade hooneühistu liikmeks saamise kohta peab sisaldama järgmisi andmeid: 1 1) hooneühistu nimi ja registrikood; 2 2) liikme nimi; 3 3) liikme isiku- või registrikood (isikukoodi puudumise korral sünniaeg) ning välismaa koodi puhul ka riigi nimi; 4 4) liikme elu- või asukoha andmed: riik ja linn või vald ning juhul, kui elu- või asukoht asub väljaspool Eestit, osariik, provints või muu haldusüksus, kui see on olemas; 5 5) liikme kontaktandmed (aadress, e-posti aadress, telefoninumber); 6 6) liikmesuse number; 7 7) liikmesusega seotud liikmemaksumäär (hariliku murruna); 8 8) liikme ainukasutuses oleva hooneosa pindala; 9 9) liikmeks saamise kuupäev; 10 10) liikmeks vastuvõtmise otsuse teinud organi nimetus ja otsuse kuupäev; 11 11) liikmesusega seotud kitsendused. Teade hooneühistu liikmeks saamise kohta peab sisaldama järgmisi andmeid: hooneühistu nimi ja registrikood; liikme nimi; liikme isiku- või registrikood (isikukoodi puudumise korral sünniaeg) ning välismaa koodi puhul ka riigi nimi; liikme elu- või asukoha andmed: riik ja linn või vald ning juhul, kui elu- või asukoht asub väljaspool Eestit, osariik, provints või muu haldusüksus, kui see on olemas; liikme kontaktandmed (aadress, e-posti aadress, telefoninumber); liikmesuse number; liikmesusega seotud liikmemaksumäär (hariliku murruna); liikme ainukasutuses oleva hooneosa pindala; liikmeks saamise kuupäev; liikmeks vastuvõtmise otsuse teinud organi nimetus ja otsuse kuupäev; liikmesusega seotud kitsendused.",
      "rdfs:label": {
        "@value": "Reg_336255_Par_44 (redaktsioon 336255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336255",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336255",
      "estleg:sourceAct": "Notariaadimäärustik",
      "estleg:provisionRef": "Reg_336255 § 44",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336255_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_336255_Par_44_53_v336255",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336255_Par_44_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri- või kinnistusosakonnale avalduse esitamisel lisatakse digitaalset notariaalmärget või digitaalset originaaldokumenti sisaldavasse konteinerisse kõik kande tegemiseks vajalikud dokumendid. Kui dokumente ei ole võimalik koos avaldusega esitada, selgitab notar isikule kande tegemiseks vajalike dokumentide esitamise korda. RT I 2019-09-25 1 125092019001 2020-02-01 Registri- või kinnistusosakonnale avalduse esitamisel lisatakse digitaalset notariaalmärget või digitaalset originaaldokumenti sisaldavasse konteinerisse kõik kande tegemiseks vajalikud dokumendid. Kui dokumente ei ole võimalik koos avaldusega esitada, selgitab notar isikule kande tegemiseks vajalike dokumentide esitamise korda.",
      "rdfs:label": {
        "@value": "Reg_336255_Par_44_53 (redaktsioon 336255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336255",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336255",
      "estleg:sourceAct": "Notariaadimäärustik",
      "estleg:provisionRef": "Reg_336255 § 44_53",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336255_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_336255_Par_45_v336255",
