    {
      "@id": "estleg:Reg_336255_Par_43_v336255",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336255_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hooneühistu liikmesuse pantimise teade peab sisaldama järgmisi andmeid: 1 1) tehingu kuupäev; 2 2) notari nimi; 3 3) ametitegevuse raamatu number; 4 4) selle hooneühistu nimi ja registrikood, mille liikmesus panditi; 5 5) pantija nimi; 6 6) pantija isiku- või registrikood (isikukoodi puudumise korral sünniaeg) ning välismaa koodi puhul riigi nimi; 7 7) panditava liikmesuse number; 8 8) pandi järjekoht; 9 9) pandiõiguse tekkimise aeg, kui see erineb käsutustehingu tõestamise ajast; 10 10) pandipidaja nimi; 11 11) pandipidaja isiku- või registrikood (isikukoodi puudumise korral sünniaeg) ning välismaa koodi puhul riigi nimi; 12 12) pandipidaja elu- või asukoha andmed: riik ja linn või vald ning juhul, kui elu- või asukoht asub väljaspool Eestit, osariik, provints või muu haldusüksus, kui see on olemas; 13 13) pandipidajate paljususe korral omandiliik (ühis- või kaasomand pandile); 14 14) kaasomandi korral kaasomandiosa suurus hariliku murruna. Hooneühistu liikmesuse pantimise teade peab sisaldama järgmisi andmeid: tehingu kuupäev; notari nimi; ametitegevuse raamatu number; selle hooneühistu nimi ja registrikood, mille liikmesus panditi; pantija nimi; pantija isiku- või registrikood (isikukoodi puudumise korral sünniaeg) ning välismaa koodi puhul riigi nimi; panditava liikmesuse number; pandi järjekoht; pandiõiguse tekkimise aeg, kui see erineb käsutustehingu tõestamise ajast; pandipidaja nimi; pandipidaja isiku- või registrikood (isikukoodi puudumise korral sünniaeg) ning välismaa koodi puhul riigi nimi; pandipidaja elu- või asukoha andmed: riik ja linn või vald ning juhul, kui elu- või asukoht asub väljaspool Eestit, osariik, provints või muu haldusüksus, kui see on olemas; pandipidajate paljususe korral omandiliik (ühis- või kaasomand pandile); kaasomandi korral kaasomandiosa suurus hariliku murruna.",
      "rdfs:label": {
        "@value": "Reg_336255_Par_43 (redaktsioon 336255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336255",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336255",
