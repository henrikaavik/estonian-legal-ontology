      }
    },
    {
      "@id": "estleg:Reg_336255_Par_28_v336255",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336255_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rahasummade hoiustamise jaoks avab notar krediidiasutuses eraldi notarikonto. Rahasummade hoiustamise jaoks avab notar krediidiasutuses eraldi notarikonto. 2 (2) Krediidiasutuse ja kontotüübi valib notar, kui hoiustamist taotlevad isikud ei ole hoiustamise avalduses krediidiasutust ja kontotüüpi kindlaks määranud. Krediidiasutuse ja kontotüübi valib notar, kui hoiustamist taotlevad isikud ei ole hoiustamise avalduses krediidiasutust ja kontotüüpi kindlaks määranud. 3 (3) Hoiustamiseks ei või kasutada notari muud kontot ega kolmanda isiku kontot. Notar võib kasutada ühte kontot korraga mitme hoiustamise jaoks. Hoiustamiseks ei või kasutada notari muud kontot ega kolmanda isiku kontot. Notar võib kasutada ühte kontot korraga mitme hoiustamise jaoks. 4 (4) Notarikonto käsutamine peab olema dokumenteeritud. Notarikonto käsutamine peab olema dokumenteeritud.",
      "rdfs:label": {
        "@value": "Reg_336255_Par_28 (redaktsioon 336255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336255",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336255",
      "estleg:sourceAct": "Notariaadimäärustik",
      "estleg:provisionRef": "Reg_336255 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336255_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_336255_Par_29_v336255",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336255_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väärtpaberite hoiustamise jaoks peab notar avama eraldi väärtpaberikonto. Väärtpaberite hoiustamise jaoks peab notar avama eraldi väärtpaberikonto. 2 (2) Notar ei või hoiustamiseks kasutada kolmanda isiku kontot ega enda isiklikku väärtpaberikontot. Notar võib kasutada ühte kontot korraga mitme hoiustamise jaoks. Notar ei või hoiustamiseks kasutada kolmanda isiku kontot ega enda isiklikku väärtpaberikontot. Notar võib kasutada ühte kontot korraga mitme hoiustamise jaoks. 3 (3) Notar ei pea hoiulevõetud väärtpabereid valitsema. Notar ei pea hoiulevõetud väärtpabereid valitsema. 4 (4) Notar peab võtma kontohaldurilt väärtpaberikonto väljavõtte kontol tehtud toimingute kohta igal kalendripäeval, kui kontole tehti kanne. Notar peab võtma kontohaldurilt väärtpaberikonto väljavõtte kontol tehtud toimingute kohta igal kalendripäeval, kui kontole tehti kanne.",
      "rdfs:label": {
        "@value": "Reg_336255_Par_29 (redaktsioon 336255)",
        "@language": "et"
      },
