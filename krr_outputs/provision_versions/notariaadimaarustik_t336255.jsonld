    {
      "@id": "estleg:Reg_336255_Par_78_v336255",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336255_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Korralisest kontrollist teatatakse notarile või notari asendajale ja Notarite Kojale ette vähemalt kaks nädalat enne selle algust. Korralisest kontrollist teatatakse notarile või notari asendajale ja Notarite Kojale ette vähemalt kaks nädalat enne selle algust. 2 (2) Erakorralisest kontrollist ja järelkontrollist ei pea ette teatama. Erakorralisest kontrollist ja järelkontrollist ei pea ette teatama.",
      "rdfs:label": {
        "@value": "Reg_336255_Par_78 (redaktsioon 336255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336255",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336255",
      "estleg:sourceAct": "Notariaadimäärustik",
      "estleg:provisionRef": "Reg_336255 § 78",
