        "@type": "xsd:date"
      },
      "estleg:versionText": "Notar peab ametipitsateid hoidma nii, et oleks välistatud nende hävimine, kaotsiminek ja kuritarvitamine. Notar peab ametipitsateid hoidma nii, et oleks välistatud nende hävimine, kaotsiminek ja kuritarvitamine.",
      "rdfs:label": {
