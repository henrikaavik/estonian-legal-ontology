      },
      "estleg:versionValidFrom": {
        "@value": "2022-10-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registrit peetakse ühetasandilise digitaalse andmekoguna. Registrit peetakse ühetasandilise digitaalse andmekoguna. 2 (2) Register koosneb: 1 1) digitaalregistrist; 2 2) digitaalarhiivist. Register koosneb: digitaalregistrist; digitaalarhiivist.",
      "rdfs:label": {
