      }
    },
    {
      "@id": "estleg:Reg_1056924_Par_4_v1056924",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056924_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskus on aruandekohustuslik haridus- ja teadusministri ees, kes seadusega sätestatud korras suunab ja koordineerib keskuse tegevust ning teostab selle üle teenistuslikku järelevalvet. Keskus on aruandekohustuslik haridus- ja teadusministri ees, kes seadusega sätestatud korras suunab ja koordineerib keskuse tegevust ning teostab selle üle teenistuslikku järelevalvet.",
      "rdfs:label": {
        "@value": "Reg_1056924_Par_4 (redaktsioon 1056924)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056924",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056924",
      "estleg:sourceAct": "Astangu Kutserehabilitatsiooni Keskuse põhimäärus",
      "estleg:provisionRef": "Reg_1056924 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056924_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056924_Par_5_v1056924",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056924_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskusel on väikese riigivapi kujutise ja oma nimega pitsat ning sümboolika. Keskusel on väikese riigivapi kujutise ja oma nimega pitsat ning sümboolika.",
      "rdfs:label": {
        "@value": "Reg_1056924_Par_5 (redaktsioon 1056924)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056924",
