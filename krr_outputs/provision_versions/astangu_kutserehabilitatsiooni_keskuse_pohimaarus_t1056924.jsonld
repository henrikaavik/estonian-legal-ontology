    {
      "@id": "estleg:Reg_1056924_Par_3_v1056924",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056924_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Keskust rahastatakse riigieelarvest, keskuse põhitegevusega seotud tasulistest teenustest saadavast tulust, programmide ja projektide täitmiseks eraldatud vahenditest ja muudest laekumistest. Keskust rahastatakse riigieelarvest, keskuse põhitegevusega seotud tasulistest teenustest saadavast tulust, programmide ja projektide täitmiseks eraldatud vahenditest ja muudest laekumistest. 2 (2) Keskusel on arvelduskontod Riigikassa kontsernikonto koosseisus. Keskusel on arvelduskontod Riigikassa kontsernikonto koosseisus. 3 (3) Keskuse eelarve kinnitab, muudab ja selle täitmist kontrollib haridus- ja teadusminister õigusaktides kehtestatud korras. Keskuse eelarve kinnitab, muudab ja selle täitmist kontrollib haridus- ja teadusminister õigusaktides kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1056924_Par_3 (redaktsioon 1056924)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056924",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056924",
      "estleg:sourceAct": "Astangu Kutserehabilitatsiooni Keskuse põhimäärus",
      "estleg:provisionRef": "Reg_1056924 § 3",
      "estleg:partOfAct": {
