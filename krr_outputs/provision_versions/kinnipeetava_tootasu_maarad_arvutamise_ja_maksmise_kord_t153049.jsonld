      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kinnipeetava töötasu määrad, arvutamise ja maksmise kord (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kinnipeetava töötasu määrad, arvutamise ja maksmise kord"
    },
    {
      "@id": "estleg:Reg_153049_Par_1_v153049",
      "@type": [
        "owl:NamedIndividual",
