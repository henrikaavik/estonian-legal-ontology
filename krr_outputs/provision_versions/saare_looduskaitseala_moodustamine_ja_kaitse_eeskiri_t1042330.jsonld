      "estleg:versionValidFrom": {
        "@value": "2018-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 27. juuli 2006. a määruses nr 176 „Hoiualade kaitse alla võtmine Saare maakonnas” asendatakse Kura kurgu hoiuala kaardid („Kura kurgu 1” kuni „Kura kurgu 6”) käesoleva määruse lisas 2 esitatud kaartidega 1 kuni 7 ja Vesitükimaa hoiuala kaart („Vesitükimaa”) käesoleva määruse lisas 3 esitatud kaardiga. Vabariigi Valitsuse 27. juuli 2006. a määruses nr 176 „Hoiualade kaitse alla võtmine Saare maakonnas” asendatakse Kura kurgu hoiuala kaardid („Kura kurgu 1” kuni „Kura kurgu 6”) käesoleva määruse lisas 2 esitatud kaartidega 1 kuni 7 ja Vesitükimaa hoiuala kaart („Vesitükimaa”) käesoleva määruse lisas 3 esitatud kaardiga.",
      "rdfs:label": {
        "@value": "Reg_1042330_Par_13 (redaktsioon 1042330)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042330",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042330",
      "estleg:sourceAct": "Sääre looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1042330 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042330_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042330_Par_14_v1042330",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042330_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 8. veebruari 2017. a käskkirjaga nr 1-2/17/162 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemusega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 8. veebruari 2017. a käskkirjaga nr 1-2/17/162 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemusega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1042330_Par_14 (redaktsioon 1042330)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042330",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042330",
      "estleg:sourceAct": "Sääre looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1042330 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042330_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042330_Par_15_v1042330",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042330_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1042330_Par_15 (redaktsioon 1042330)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042330",
