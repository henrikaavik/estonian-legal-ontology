    {
      "@id": "estleg:Reg_1042330_Par_4_v1042330",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042330_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas5 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndite piiride kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas5 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndite piiride kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1042330_Par_4 (redaktsioon 1042330)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042330",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042330",
      "estleg:sourceAct": "Sääre looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1042330 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042330_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042330_Par_5_v1042330",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042330_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevöönd on kaitseala maa- või veeala seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks ning kaitsealuste liikide elupaikade kaitseks. Sihtkaitsevöönd on kaitseala maa- või veeala seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks ning kaitsealuste liikide elupaikade kaitseks. 2 (2) Kaitsealal on kaks sihtkaitsevööndit: 1 1) Sääre lahe sihtkaitsevöönd; 2 2) Vesitükimaa sihtkaitsevöönd. Kaitsealal on kaks sihtkaitsevööndit: Sääre lahe sihtkaitsevöönd; Vesitükimaa sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_1042330_Par_5 (redaktsioon 1042330)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042330",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042330",
      "estleg:sourceAct": "Sääre looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1042330 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042330_Map_2026"
      }
    },
