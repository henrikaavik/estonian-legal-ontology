      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Päästetööl või demineerimistööl asja sundkasutusse võtmisega tekkinud kulude hüvitamise ulatus ja kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Päästetööl või demineerimistööl asja sundkasutusse võtmisega tekkinud kulude hüvitamise ulatus ja kord"
    },
    {
      "@id": "estleg:Reg_1000556_Par_1_v1000556",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000556_Par_1"
