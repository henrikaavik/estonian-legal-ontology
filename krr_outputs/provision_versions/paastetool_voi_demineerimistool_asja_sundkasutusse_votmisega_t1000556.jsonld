    },
    {
      "@id": "estleg:Reg_1000556_Par_2_v1000556",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000556_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riik hüvitab asja sundkasutusse võtmisega tekkinud kulud õiglases ulatuses. Riik hüvitab asja sundkasutusse võtmisega tekkinud kulud õiglases ulatuses. 2 (2) Kui sundkasutusse võetud asi on päästetööl muutunud kasutamiskõlbmatuks, siis see asendatakse samaväärse asjaga või hüvitatakse omanikule asja harilik väärtus selle asja kohaliku keskmise müügihinna (turuhinna) alusel. Kui sundkasutusse võetud asi on päästetööl muutunud kasutamiskõlbmatuks, siis see asendatakse samaväärse asjaga või hüvitatakse omanikule asja harilik väärtus selle asja kohaliku keskmise müügihinna (turuhinna) alusel.",
      "rdfs:label": {
        "@value": "Reg_1000556_Par_2 (redaktsioon 1000556)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000556",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000556",
      "estleg:sourceAct": "Päästetööl või demineerimistööl asja sundkasutusse võtmisega tekkinud kulude hüvitamise ulatus ja kord",
      "estleg:provisionRef": "Reg_1000556 § 2",
