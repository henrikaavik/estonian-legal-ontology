  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_nouded_mitte_easa_ohusoiduki_valja_arvatud_ulikergohusoiduk__t1048142_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele (14 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele"
    },
    {
      "@id": "estleg:Reg_1048142_Par_1_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õhusõiduki pardal peavad olema kättesaadavad järgmised dokumendid: 1 1) lennukäsiraamat (AFM – Aircraft Flight Manual) või samaväärne dokument; 2 2) registreerimissertifikaadi originaal; 3 3) lennukõlblikkussertifikaadi originaal; 4 4) mürasertifikaat, kui selle olemasolu on registrijärgses riigis nõutav; 5 5) raadioluba, kui õhusõiduk on raadiojaamaga varustatud; 6 6) tsiviilvastutuskindlustuse poliis; 7 7) lennupäevik või samaväärne dokument; 8 8) lennuliiklusteeninduse üksusele (ATS-üksusele) esitatud lennuplaani koopia; 9 9) asjakohane aeronavigatsiooniteave; 10 10) asjakohane meteoroloogiateave; 11 11) massi ja raskuskeskme määramise dokumentatsioon vastavalt lennukäsiraamatule; 12 12) tuvastava ja tuvastatava õhusõiduki protseduuride ja visuaalmärguannete kirjeldused; 13 13) asjakohased aeronavigatsioonilised kaardid; 14 14) käitaja lennutegevuse käsiraamat või selle osad, mis on erilennu teostamisel vajalikud; 15 15) miinimumvarustuse loetelu (MEL – Minimum Equipment List) või konfiguratsioonist kõrvalekallete nimekiri (CDL – Configuration Deviation List), kui need on olemas. Õhusõiduki pardal peavad olema kättesaadavad järgmised dokumendid: lennukäsiraamat (AFM – Aircraft Flight Manual) või samaväärne dokument; registreerimissertifikaadi originaal; lennukõlblikkussertifikaadi originaal; mürasertifikaat, kui selle olemasolu on registrijärgses riigis nõutav; raadioluba, kui õhusõiduk on raadiojaamaga varustatud; tsiviilvastutuskindlustuse poliis; lennupäevik või samaväärne dokument; lennuliiklusteeninduse üksusele (ATS-üksusele) esitatud lennuplaani koopia; asjakohane aeronavigatsiooniteave; asjakohane meteoroloogiateave; massi ja raskuskeskme määramise dokumentatsioon vastavalt lennukäsiraamatule; tuvastava ja tuvastatava õhusõiduki protseduuride ja visuaalmärguannete kirjeldused; asjakohased aeronavigatsioonilised kaardid; käitaja lennutegevuse käsiraamat või selle osad, mis on erilennu teostamisel vajalikud; miinimumvarustuse loetelu (MEL – Minimum Equipment List) või konfiguratsioonist kõrvalekallete nimekiri (CDL – Configuration Deviation List), kui need on olemas. 2 (2) Lõike 1 punktides 2–11 nimetatud dokumendid võivad jääda lennuväljale, kopteriväljakule või õhusõiduki käitamiskohta, kui õhusõiduki start ja maandumine toimub samal lennuväljal, kopteriväljakul või õhusõiduki käitamiskohas. Lõike 1 punktides 2–11 nimetatud dokumendid võivad jääda lennuväljale, kopteriväljakule või õhusõiduki käitamiskohta, kui õhusõiduki start ja maandumine toimub samal lennuväljal, kopteriväljakul või õhusõiduki käitamiskohas.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_1 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_10_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hermetiseerimata õhusõiduk peab rõhkkõrgusel üle 10 000 jala lennates olema varustatud hapnikuseadme ja küllaldase hapnikuvaruga: 1 1) kõigile meeskonnaliikmetele ja eritööde spetsialistidele kogu 30 minutit ületava lennuaja jooksul, mil rõhkkõrgus kabiinis või salongis on üle 10 000 jala, kuid ei ületa 13 000 jalga; 2 2) kõigile pardal viibivatele isikutele kogu lennuaja jooksul, mil rõhkkõrgus kabiinis või salongis on üle 13 000 jala. Hermetiseerimata õhusõiduk peab rõhkkõrgusel üle 10 000 jala lennates olema varustatud hapnikuseadme ja küllaldase hapnikuvaruga: kõigile meeskonnaliikmetele ja eritööde spetsialistidele kogu 30 minutit ületava lennuaja jooksul, mil rõhkkõrgus kabiinis või salongis on üle 10 000 jala, kuid ei ületa 13 000 jalga; kõigile pardal viibivatele isikutele kogu lennuaja jooksul, mil rõhkkõrgus kabiinis või salongis on üle 13 000 jala. 2 (2) Hermetiseeritud õhusõiduk, mis lendab rõhkkõrgusel üle 10 000 jala ning kus hoitakse rõhkkõrgus kabiinis ja salongis 10 000 jalga või madalamal, peab olema varustatud hapnikuseadme ja küllaldase hapnikuvaruga kõigile pardal viibivatele isikutele kogu lennuaja jooksul, mil rõhkkõrgus kabiinis või salongis tõuseb dehermetiseerumise tõttu üle 10 000 jala. Hermetiseeritud õhusõiduk, mis lendab rõhkkõrgusel üle 10 000 jala ning kus hoitakse rõhkkõrgus kabiinis ja salongis 10 000 jalga või madalamal, peab olema varustatud hapnikuseadme ja küllaldase hapnikuvaruga kõigile pardal viibivatele isikutele kogu lennuaja jooksul, mil rõhkkõrgus kabiinis või salongis tõuseb dehermetiseerumise tõttu üle 10 000 jala. 3 (3) Hermetiseeritud õhusõiduk, mis lennukäsiraamatu kohaselt võib lennata rõhkkõrgusel üle 25 000 jala, peab olema varustatud: 1 1) lennumeeskonnaliikmeid hoiatava dehermetiseerumise signalisatsiooniga; 2 2) kiirpaigaldatavate hapnikumaskidega lennumeeskonnaliikmetele. Hermetiseeritud õhusõiduk, mis lennukäsiraamatu kohaselt võib lennata rõhkkõrgusel üle 25 000 jala, peab olema varustatud: lennumeeskonnaliikmeid hoiatava dehermetiseerumise signalisatsiooniga; kiirpaigaldatavate hapnikumaskidega lennumeeskonnaliikmetele. 4 (4) Hermetiseeritud õhusõiduk peab olema varustatud automaatselt käivituva hapnikuseadme ja hapnikuvaruga vähemalt 10 minutiks salongis viibivate isikute jaoks, kui: 1 1) lennatakse rõhkkõrgusel üle 25 000 jala; 2 2) lennatakse rõhkkõrgusel 25 000 jalga või madalamal, kuid lennutingimused ei võimalda ohutult nelja minuti jooksul laskuda rõhkkõrgusele 13 000 jalga. Hermetiseeritud õhusõiduk peab olema varustatud automaatselt käivituva hapnikuseadme ja hapnikuvaruga vähemalt 10 minutiks salongis viibivate isikute jaoks, kui: lennatakse rõhkkõrgusel üle 25 000 jala; lennatakse rõhkkõrgusel 25 000 jalga või madalamal, kuid lennutingimused ei võimalda ohutult nelja minuti jooksul laskuda rõhkkõrgusele 13 000 jalga.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_10 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_11_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätumistingimustes või prognoositavates jäätumistingimustes lennates peab õhusõiduk olema varustatud vastavate jäätumisvastaste seadmetega. Jäätumistingimustes või prognoositavates jäätumistingimustes lennates peab õhusõiduk olema varustatud vastavate jäätumisvastaste seadmetega.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_11 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_12_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Turbiinmootoriga lennuk maksimaalse stardimassiga üle 5700 kilogrammi või maksimaalse reisijakohtade arvuga üle üheksa peab olema varustatud maaga kokkupõrke hoiatuse süsteemiga, mis täidab ka maaga kokkupõrke ohtu ennetava hoiatuse funktsiooni. Turbiinmootoriga lennuk maksimaalse stardimassiga üle 5700 kilogrammi või maksimaalse reisijakohtade arvuga üle üheksa peab olema varustatud maaga kokkupõrke hoiatuse süsteemiga, mis täidab ka maaga kokkupõrke ohtu ennetava hoiatuse funktsiooni. 2 (2) Maaga kokkupõrke hoiatuse süsteem peab automaatselt tagama lennumeeskonnaliikmete õigeaegse ja täpse hoiatuse maale lähenemise potentsiaalsest ohust. Maaga kokkupõrke hoiatuse süsteem peab automaatselt tagama lennumeeskonnaliikmete õigeaegse ja täpse hoiatuse maale lähenemise potentsiaalsest ohust. 3 (3) Maaga kokkupõrke hoiatuse süsteem peab andma hoiatuse vähemalt järgmistes olukordades: 1 1) liigne laskumiskiirus; 2 2) liigne kõrguse kaotus pärast starti või kordusringile minekut; 3 3) ohtlik maapinna lähedus. Maaga kokkupõrke hoiatuse süsteem peab andma hoiatuse vähemalt järgmistes olukordades: liigne laskumiskiirus; liigne kõrguse kaotus pärast starti või kordusringile minekut; ohtlik maapinna lähedus. 4 (4) Kui lõikes 1 nimetatud õhusõiduki esmane lennukõlblikkussertifikaat on välja antud pärast 1. jaanuari 2011, peab maaga kokkupõrke hoiatuse süsteem andma hoiatuse vähemalt järgmistes olukordades: 1 1) liigne laskumiskiirus; 2 2) liigne maapinna lähenemise kiirus; 3 3) liigne kõrguse kaotus pärast starti või kordusringile minekut; 4 4) ohtlik maapinna lähedus, kui õhusõiduk ei ole maandumiskonfiguratsioonis; 5 5) liigne laskumine allapoole instrumentaallähenemise glissaadi. Kui lõikes 1 nimetatud õhusõiduki esmane lennukõlblikkussertifikaat on välja antud pärast 1. jaanuari 2011, peab maaga kokkupõrke hoiatuse süsteem andma hoiatuse vähemalt järgmistes olukordades: liigne laskumiskiirus; liigne maapinna lähenemise kiirus; liigne kõrguse kaotus pärast starti või kordusringile minekut; ohtlik maapinna lähedus, kui õhusõiduk ei ole maandumiskonfiguratsioonis; liigne laskumine allapoole instrumentaallähenemise glissaadi.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_12 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_13_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennukil maksimaalse stardimassiga üle 5700 kilogrammi või kopteril maksimaalse stardimassiga üle 3175 kilogrammi peab olema pardaregistraator vastavalt 1944. aasta Chicago rahvusvahelise tsiviillennunduse konventsiooni 6. lisa II või III osas sätestatud nõuetele. Lennukil maksimaalse stardimassiga üle 5700 kilogrammi või kopteril maksimaalse stardimassiga üle 3175 kilogrammi peab olema pardaregistraator vastavalt 1944. aasta Chicago rahvusvahelise tsiviillennunduse konventsiooni 6. lisa II või III osas sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_13 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_14_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõiduk peab olema varustatud avariimajaka, õhus kokkupõrke vältimise süsteemi ACAS II ja transponderiga vastavalt lennundusseaduses sätestatud nõuetele. Õhusõiduk peab olema varustatud avariimajaka, õhus kokkupõrke vältimise süsteemi ACAS II ja transponderiga vastavalt lennundusseaduses sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_14 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_2_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õhusõiduk peab olema varustatud: 1 1) mõõteriistade ja indikaatoritega, mis võimaldavad lennumeeskonnaliikmetel kontrollida lennutrajektoori, teostada nõuetekohaseid manöövreid ja järgida õhusõiduki käitamispiiranguid; 2 2) kättesaadavas kohas oleva esmaabikomplektiga; 3 3) vähemalt ühe käsitulekustutiga kabiinis ning igas kabiinist eraldatud reisijatesalongis, mis ei ole lennumeeskonnaliikmetele kergesti ligipääsetav; 4 4) istmete või magamisasemetega kõigile üle 24 kuu vanustele isikutele pardal; 5 5) turvavööga igal istmel ja ohutusrihmaga igal magamisasemel; 6 6) vastava võimsusega varukaitsmetega, kui kaitsmete vahetamine lennu ajal on võimalik. Õhusõiduk peab olema varustatud: mõõteriistade ja indikaatoritega, mis võimaldavad lennumeeskonnaliikmetel kontrollida lennutrajektoori, teostada nõuetekohaseid manöövreid ja järgida õhusõiduki käitamispiiranguid; kättesaadavas kohas oleva esmaabikomplektiga; vähemalt ühe käsitulekustutiga kabiinis ning igas kabiinist eraldatud reisijatesalongis, mis ei ole lennumeeskonnaliikmetele kergesti ligipääsetav; istmete või magamisasemetega kõigile üle 24 kuu vanustele isikutele pardal; turvavööga igal istmel ja ohutusrihmaga igal magamisasemel; vastava võimsusega varukaitsmetega, kui kaitsmete vahetamine lennu ajal on võimalik. 2 (2) Õhusõiduki mõõteriistad ja indikaatorid peavad olema paigutatud selliselt, et nende näidud oleksid piloodi vaateväljas ja tema töökohalt vaadeldavad oma asendit oluliselt muutmata. Õhusõiduki mõõteriistad ja indikaatorid peavad olema paigutatud selliselt, et nende näidud oleksid piloodi vaateväljas ja tema töökohalt vaadeldavad oma asendit oluliselt muutmata.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_2 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_3_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennul visuaallennureeglite kohaselt peab õhusõiduk olema varustatud järgmiste mõõteriistadega: 1 1) magnetkompass; 2 2) kell, mis näitab tunde, minuteid ja sekundeid; 3 3) rõhkkõrgusemõõtja; 4 4) õhkkiirusemõõtja; 5 5) variomeeter; 6 6) pöörangu- ja libisemisnäitaja, kopteri puhul ainult libisemisnäitaja; 7 7) mahhmeeter, kui kiiruspiirangud on väljendatud Machi arvudes; 8 8) mootori tööd kontrolliv mõõteriist iga mootori kohta. Lennul visuaallennureeglite kohaselt peab õhusõiduk olema varustatud järgmiste mõõteriistadega: magnetkompass; kell, mis näitab tunde, minuteid ja sekundeid; rõhkkõrgusemõõtja; õhkkiirusemõõtja; variomeeter; pöörangu- ja libisemisnäitaja, kopteri puhul ainult libisemisnäitaja; mahhmeeter, kui kiiruspiirangud on väljendatud Machi arvudes; mootori tööd kontrolliv mõõteriist iga mootori kohta.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_3 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_4_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lennul instrumentaallennureeglite kohaselt peab õhusõiduk olema varustatud lisaks §-s 3 nimetatutele ka järgmiste mõõteriistadega: 1 1) aviohorisont; 2 2) gürokompass; 3 3) välisõhu termomeeter. Lennul instrumentaallennureeglite kohaselt peab õhusõiduk olema varustatud lisaks §-s 3 nimetatutele ka järgmiste mõõteriistadega: aviohorisont; gürokompass; välisõhu termomeeter. 2 (2) Õhusõiduki õhkkiirusemõõtja peab olema varustatud seadmega, mis takistab süsteemi ülesütlemist kondensatsiooni või jäätumise tagajärjel. Õhusõiduki õhkkiirusemõõtja peab olema varustatud seadmega, mis takistab süsteemi ülesütlemist kondensatsiooni või jäätumise tagajärjel. 3 (3) Õhusõiduki güroskoopilised mõõteriistad peavad olema varustatud toite kontrollseadmetega. Õhusõiduki güroskoopilised mõõteriistad peavad olema varustatud toite kontrollseadmetega. 4 (4) Kui õhusõiduki juhtimiseks on lennukäsiraamatu kohaselt vaja kahte pilooti, peavad järgmised seadmed olema dubleeritud: 1 1) rõhkkõrgusemõõtja; 2 2) õhkkiirusemõõtja; 3 3) variomeeter; 4 4) pöörangu- ja libisemisnäitaja, kopteri puhul ainult libisemisnäitaja; 5 5) mahhmeeter, kui kiiruspiirangud on väljendatud Machi arvudes; 6 6) aviohorisont; 7 7) gürokompass. Kui õhusõiduki juhtimiseks on lennukäsiraamatu kohaselt vaja kahte pilooti, peavad järgmised seadmed olema dubleeritud: rõhkkõrgusemõõtja; õhkkiirusemõõtja; variomeeter; pöörangu- ja libisemisnäitaja, kopteri puhul ainult libisemisnäitaja; mahhmeeter, kui kiiruspiirangud on väljendatud Machi arvudes; aviohorisont; gürokompass.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_4 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_5_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennul öisel ajal peab õhusõiduk olema lisaks §-s 4 nimetatule varustatud ka: 1 1) kokkupõrke-hoiatustuledega; 2 2) navigatsioonituledega; 3 3) maandumistuledega; 4 4) õhusõiduki ohutuks käitamiseks piloodile vajalike mõõteriistade ja indikaatorite taustvalgustusega; 5 5) valgustusega eritööde spetsialisti töökohal; 6 6) elektrilambiga iga meeskonnaliikme töökohal. Lennul öisel ajal peab õhusõiduk olema lisaks §-s 4 nimetatule varustatud ka: kokkupõrke-hoiatustuledega; navigatsioonituledega; maandumistuledega; õhusõiduki ohutuks käitamiseks piloodile vajalike mõõteriistade ja indikaatorite taustvalgustusega; valgustusega eritööde spetsialisti töökohal; elektrilambiga iga meeskonnaliikme töökohal.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_5 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_6_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lennul, mida käitatakse instrumentaallennureeglite kohaselt, öisel ajal või kui see on ette nähtud õhuruumi suhtes kohaldatavate nõuetega, peab õhusõiduk olema varustatud sideseadmetega, mis normaalse raadiolevi tingimustes tagavad: 1 1) kahepoolse raadioside lennuvälja lennuliikluse juhtimise eesmärgil; 2 2) kogu lennu kestel meteoroloogiateabe vastuvõtu; 3 3) kogu lennu kestel kahepoolse raadioside asjaomaste lennuliikluse sidejaamadega kindlaksmääratud sagedustel; 4 4) raadioside lennunduse avariisagedusel 121,5 MHz. Lennul, mida käitatakse instrumentaallennureeglite kohaselt, öisel ajal või kui see on ette nähtud õhuruumi suhtes kohaldatavate nõuetega, peab õhusõiduk olema varustatud sideseadmetega, mis normaalse raadiolevi tingimustes tagavad: kahepoolse raadioside lennuvälja lennuliikluse juhtimise eesmärgil; kogu lennu kestel meteoroloogiateabe vastuvõtu; kogu lennu kestel kahepoolse raadioside asjaomaste lennuliikluse sidejaamadega kindlaksmääratud sagedustel; raadioside lennunduse avariisagedusel 121,5 MHz. 2 (2) Kui nõutavaid sideseadmeid õhusõiduki pardal on mitu, peavad need olema üksteisest sõltumatud, et ühe seadme rikkega ei kaasneks mõne teise seadme riket. Kui nõutavaid sideseadmeid õhusõiduki pardal on mitu, peavad need olema üksteisest sõltumatud, et ühe seadme rikkega ei kaasneks mõne teise seadme riket.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_6 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_7_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lennul, kus pole võimalik navigeerida visuaalsete maamärkide abil, peab õhusõiduk olema varustatud navigatsiooniseadmetega, mis võimaldavad lennata vastavalt: 1 1) ATS-üksusele esitatud lennuplaanile, kui see on olemas; 2 2) õhuruumi suhtes kohaldatavatele nõuetele. Lennul, kus pole võimalik navigeerida visuaalsete maamärkide abil, peab õhusõiduk olema varustatud navigatsiooniseadmetega, mis võimaldavad lennata vastavalt: ATS-üksusele esitatud lennuplaanile, kui see on olemas; õhuruumi suhtes kohaldatavatele nõuetele. 2 (2) Õhusõidukis peab olema piisavalt navigatsiooniseadmeid, et tagada ühe seadme rikke korral lennu mistahes etapil ülejäänud seadmete abil ohutu navigeerimine vastavalt lõikele 1 või teostada ohutult erakorralisele olukorrale vastav toiming. Õhusõidukis peab olema piisavalt navigatsiooniseadmeid, et tagada ühe seadme rikke korral lennu mistahes etapil ülejäänud seadmete abil ohutu navigeerimine vastavalt lõikele 1 või teostada ohutult erakorralisele olukorrale vastav toiming. 3 (3) Lennul, kus planeeritakse maanduda instrumentaallennuilma tingimustes, peab õhusõiduk olema varustatud navigatsiooniseadmetega, mis võimaldavad õhusõidukit juhendada kuni punktini, kust on võimalik maanduda visuaalselt. Nimetatud navigatsiooniseadmed peavad võimaldama õhusõidukit juhendada kõikidel lennuväljadel, kus instrumentaallennuilma tingimustes maandumist planeeritakse, ja vajaduse korral määratud varulennuväljadel. Lennul, kus planeeritakse maanduda instrumentaallennuilma tingimustes, peab õhusõiduk olema varustatud navigatsiooniseadmetega, mis võimaldavad õhusõidukit juhendada kuni punktini, kust on võimalik maanduda visuaalselt. Nimetatud navigatsiooniseadmed peavad võimaldama õhusõidukit juhendada kõikidel lennuväljadel, kus instrumentaallennuilma tingimustes maandumist planeeritakse, ja vajaduse korral määratud varulennuväljadel. 4 (4) Lennul, kus kasutatakse suutlikkusel põhinevat navigeerimist (PBN – Performance-Based Navigation), peab õhusõiduk vastama lennukõlblikkuse sertifitseerimisnõuetele, mis kehtivad vastava navigatsioonispetsifikatsiooni suhtes. Lennul, kus kasutatakse suutlikkusel põhinevat navigeerimist (PBN – Performance-Based Navigation), peab õhusõiduk vastama lennukõlblikkuse sertifitseerimisnõuetele, mis kehtivad vastava navigatsioonispetsifikatsiooni suhtes.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_7 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_8_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vesilennuk ja vesilennukina kasutatav amfiiblennuk peab veekogu kohal lennates olema varustatud: 1 1) kergesti kättesaadavas kohas oleva päästevesti või samaväärse individuaalse ujuvvahendiga igale lennukis olevale isikule; 2 2) helisignaali andva seadmega vastavalt rahvusvahelise laevakokkupõrgete vältimise eeskirja konventsiooni nõuetele; 3 3) mereankru ja muu lennuki suurusele, kaalule ja käitamisomadustele vastava varustusega, mis on vajalik randumiseks, ankurdamiseks või vees manööverdamiseks. Vesilennuk ja vesilennukina kasutatav amfiiblennuk peab veekogu kohal lennates olema varustatud: kergesti kättesaadavas kohas oleva päästevesti või samaväärse individuaalse ujuvvahendiga igale lennukis olevale isikule; helisignaali andva seadmega vastavalt rahvusvahelise laevakokkupõrgete vältimise eeskirja konventsiooni nõuetele; mereankru ja muu lennuki suurusele, kaalule ja käitamisomadustele vastava varustusega, mis on vajalik randumiseks, ankurdamiseks või vees manööverdamiseks. 2 (2) Ühemootoriline maalennuk ja maalennukina kasutatav amfiiblennuk, peab olema varustatud kergesti kättesaadavas kohas oleva päästevesti või samaväärse individuaalse ujuvvahendiga igale lennukis olevale isikule, kui: 1 1) lend toimub veekogu kohal kaldajoonest kaugemal kui lauglemiskaugus seiskunud mootoriga; 2 2) lennukit käitatakse lennuväljal või õhusõiduki käitamiskohas, kus õhkutõusul või maandumisel ohuolukorras on võimalik hädamaandumine veekogule. Ühemootoriline maalennuk ja maalennukina kasutatav amfiiblennuk, peab olema varustatud kergesti kättesaadavas kohas oleva päästevesti või samaväärse individuaalse ujuvvahendiga igale lennukis olevale isikule, kui: lend toimub veekogu kohal kaldajoonest kaugemal kui lauglemiskaugus seiskunud mootoriga; lennukit käitatakse lennuväljal või õhusõiduki käitamiskohas, kus õhkutõusul või maandumisel ohuolukorras on võimalik hädamaandumine veekogule. 3 (3) Kui lennukaugus hädamaandumiseks sobivast maapinnast ületab 30 minutit reisikiirusel lennates või 50 meremiili, sõltuvalt sellest, kumb vahemaa on lühem, peab lennuk olema varustatud: 1 1) kergesti kättesaadavas kohas oleva päästevesti või samaväärse individuaalse ujuvvahendiga igale lennukis olevale isikule; 2 2) kergesti kättesaadavasse kohta paigutatud päästeparvedega vastavalt pardal viibivate isikute arvule, milles peavad olema antud lennutingimustele vastavad pääste- ja ellujäämise vahendid ohuolukorras kasutamiseks; 3 3) signaalrakettidega hädasignaalide edastamiseks. Kui lennukaugus hädamaandumiseks sobivast maapinnast ületab 30 minutit reisikiirusel lennates või 50 meremiili, sõltuvalt sellest, kumb vahemaa on lühem, peab lennuk olema varustatud: kergesti kättesaadavas kohas oleva päästevesti või samaväärse individuaalse ujuvvahendiga igale lennukis olevale isikule; kergesti kättesaadavasse kohta paigutatud päästeparvedega vastavalt pardal viibivate isikute arvule, milles peavad olema antud lennutingimustele vastavad pääste- ja ellujäämise vahendid ohuolukorras kasutamiseks; signaalrakettidega hädasignaalide edastamiseks. 4 (4) Päästevest ja samaväärne individuaalne ujuvvahend peab olema varustatud valgustusega, hõlbustamaks isikute leidmist. Päästevest ja samaväärne individuaalne ujuvvahend peab olema varustatud valgustusega, hõlbustamaks isikute leidmist.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_8 (redaktsioon 1048142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048142",
      "estleg:sourceAct": "Nõuded mitte-EASA õhusõiduki, välja arvatud ülikergõhusõiduk, varustusele ja pardadokumentidele",
      "estleg:provisionRef": "Reg_1048142 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048142_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048142_Par_9_v1048142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048142_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kopter peab olema varustatud kergesti kättesaadavas kohas oleva päästevesti või samaväärse individuaalse ujuvvahendiga igale kopteris olevale isikule, kui: 1 1) kriitilise mootori rikke korral ei suuda kopter jätkata horisontaallendu ning veekogu kohal lendamisel on kaugus kaldajoonest suurem kui autorotatsiooni kaugus; 2 2) kriitilise mootori rikke korral suudab kopter jätkata horisontaallendu ning lennukaugus veekogu kohal on üle kümne minuti reisikiirusel lennates kaldajoonest; 3 3) kopterit käitatakse kopteriväljakul või -käitamiskohas, kus õhkutõusul või maandumisel ohuolukorras on võimalik hädamaandumine veekogule. Kopter peab olema varustatud kergesti kättesaadavas kohas oleva päästevesti või samaväärse individuaalse ujuvvahendiga igale kopteris olevale isikule, kui: kriitilise mootori rikke korral ei suuda kopter jätkata horisontaallendu ning veekogu kohal lendamisel on kaugus kaldajoonest suurem kui autorotatsiooni kaugus; kriitilise mootori rikke korral suudab kopter jätkata horisontaallendu ning lennukaugus veekogu kohal on üle kümne minuti reisikiirusel lennates kaldajoonest; kopterit käitatakse kopteriväljakul või -käitamiskohas, kus õhkutõusul või maandumisel ohuolukorras on võimalik hädamaandumine veekogule. 2 (2) Päästevest ja samaväärne individuaalne ujuvvahend peab olema varustatud valgustusega, hõlbustamaks isikute leidmist. Päästevest ja samaväärne individuaalne ujuvvahend peab olema varustatud valgustusega, hõlbustamaks isikute leidmist. 3 (3) Kopter peab olema varustatud statsionaarse või kiiresti täituvate ujukitega ohutuks vee peale laskumiseks, kui: 1 1) kriitilise mootori rikke korral ei suuda kopter jätkata horisontaallendu ning lennukaugus veekogu kohal on suurem kui autorotatsiooni kaugus kaldajoonest; 2 2) kriitilise mootori rikke korral suudab kopter jätkata horisontaallendu ning lennukaugus veekogu kohal on üle kümne minuti reisikiirusel lennates kaldajoonest. Kopter peab olema varustatud statsionaarse või kiiresti täituvate ujukitega ohutuks vee peale laskumiseks, kui: kriitilise mootori rikke korral ei suuda kopter jätkata horisontaallendu ning lennukaugus veekogu kohal on suurem kui autorotatsiooni kaugus kaldajoonest; kriitilise mootori rikke korral suudab kopter jätkata horisontaallendu ning lennukaugus veekogu kohal on üle kümne minuti reisikiirusel lennates kaldajoonest. 4 (4) Kui lennukaugus hädamaandumiseks sobivast maapinnast ületab 30 minutit reisikiirusel lennates või 50 meremiili, sõltuvalt sellest, kumb vahemaa on lühem, peab kopter olema varustatud: 1 1) kergesti kättesaadavasse kohta paigutatud päästeparvedega vastavalt pardal viibivate isikute arvule, milles peavad olema antud lennutingimustele vastavad pääste- ja ellujäämise vahendid ohuolukorras kasutamiseks; 2 2) signaalrakettidega hädasignaalide edastamiseks. Kui lennukaugus hädamaandumiseks sobivast maapinnast ületab 30 minutit reisikiirusel lennates või 50 meremiili, sõltuvalt sellest, kumb vahemaa on lühem, peab kopter olema varustatud: kergesti kättesaadavasse kohta paigutatud päästeparvedega vastavalt pardal viibivate isikute arvule, milles peavad olema antud lennutingimustele vastavad pääste- ja ellujäämise vahendid ohuolukorras kasutamiseks; signaalrakettidega hädasignaalide edastamiseks.",
      "rdfs:label": {
        "@value": "Reg_1048142_Par_9 (redaktsioon 1048142)",
        "@language": "et"
      },
