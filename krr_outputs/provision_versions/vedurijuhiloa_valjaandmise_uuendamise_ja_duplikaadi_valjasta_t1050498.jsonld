    {
      "@id": "estleg:Reg_1050498_Par_10_v1050498",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050498_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-11-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eksamineeritaval, kes ei soorita nõutava tulemusega vedurijuhieksamit, on õigus sooritada eksam uuesti mitte enne 14 päeva möödumist eksami toimumisest. Eksamineeritaval, kes ei soorita nõutava tulemusega vedurijuhieksamit, on õigus sooritada eksam uuesti mitte enne 14 päeva möödumist eksami toimumisest. 2 (2) Eksamineeritaval, kes ei soorita nõutava tulemusega vedurijuhiloa eksamit ka teisel korral, on õigus sooritada eksam uuesti pärast täiendava koolituse läbimist vedurijuhiloaga seotud teadmiste ja oskuste omandamiseks ning mitte enne kolme kuu möödumist teistkordse vedurijuhieksami toimumisest. Eksamineeritaval, kes ei soorita nõutava tulemusega vedurijuhiloa eksamit ka teisel korral, on õigus sooritada eksam uuesti pärast täiendava koolituse läbimist vedurijuhiloaga seotud teadmiste ja oskuste omandamiseks ning mitte enne kolme kuu möödumist teistkordse vedurijuhieksami toimumisest.",
      "rdfs:label": {
        "@value": "Reg_1050498_Par_10 (redaktsioon 1050498)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050498",
