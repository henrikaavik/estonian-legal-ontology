      },
      "estleg:versionValidTo": {
        "@value": "2022-03-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MEEDIA_Par_34_v127022022009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
