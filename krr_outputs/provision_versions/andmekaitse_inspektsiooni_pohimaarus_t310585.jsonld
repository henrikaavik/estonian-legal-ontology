    {
      "@id": "estleg:Reg_310585_Par_9_v310585",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_310585_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Inspektsiooni põhiülesanded on: 1 1) oma tegevusvaldkondades järelevalve-, loa-, väärteo- ja muude ettenähtud menetluste läbiviimine, samuti teavitus- ja ennetustöö korraldamine; RT I 2016-10-14 3 114102016003 2016-10-17 2 2) osalemine oma tegevusvaldkonda puudutavate õigusaktide väljatöötamisel ning ettepanekute tegemine nende muutmiseks ja täiendamiseks; 3 3) osalemine oma tegevusvaldkonnaga seotud poliitika, strateegia ja arengukavade väljatöötamisel; 4 4) oma tegevusvaldkonnaga seotud projektide ettevalmistamine ja elluviimine, sealhulgas osalemine rahvusvaheliste projektide ettevalmistamisel ja läbiviimisel; 5 5) osalemine oma tegevusvaldkonda puudutavate rahvusvaheliste töögruppide ja organisatsioonide töös. RT I 2013-03-05 3 105032013003 2013-03-15 Inspektsiooni põhiülesanded on: oma tegevusvaldkondades järelevalve-, loa-, väärteo- ja muude ettenähtud menetluste läbiviimine, samuti teavitus- ja ennetustöö korraldamine; osalemine oma tegevusvaldkonda puudutavate õigusaktide väljatöötamisel ning ettepanekute tegemine nende muutmiseks ja täiendamiseks; osalemine oma tegevusvaldkonnaga seotud poliitika, strateegia ja arengukavade väljatöötamisel; oma tegevusvaldkonnaga seotud projektide ettevalmistamine ja elluviimine, sealhulgas osalemine rahvusvaheliste projektide ettevalmistamisel ja läbiviimisel; osalemine oma tegevusvaldkonda puudutavate rahvusvaheliste töögruppide ja organisatsioonide töös.",
      "rdfs:label": {
        "@value": "Reg_310585_Par_9 (redaktsioon 310585)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "310585",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/310585",
      "estleg:sourceAct": "Andmekaitse Inspektsiooni põhimäärus",
      "estleg:provisionRef": "Reg_310585 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_310585_Map"
      }
    },
