      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tulenevalt «Isikuandmete kaitse seadusest» ja «Avaliku teabe seadusest» esitab inspektsioon oma tegevusaruanded Riigikogu põhiseaduskomisjonile ja õiguskantslerile. Tulenevalt «Isikuandmete kaitse seadusest» ja «Avaliku teabe seadusest» esitab inspektsioon oma tegevusaruanded Riigikogu põhiseaduskomisjonile ja õiguskantslerile.",
      "rdfs:label": {
        "@value": "Reg_310585_Par_3 (redaktsioon 310585)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "310585",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/310585",
      "estleg:sourceAct": "Andmekaitse Inspektsiooni põhimäärus",
      "estleg:provisionRef": "Reg_310585 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_310585_Map"
      }
    },
    {
      "@id": "estleg:Reg_310585_Par_4_v310585",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_310585_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Inspektsiooni kulud kaetakse riigieelarvest. Inspektsiooni eelarve kinnitab, muudab ja eelarve täitmist kontrollib justiitsminister. Inspektsiooni kulud kaetakse riigieelarvest. Inspektsiooni eelarve kinnitab, muudab ja eelarve täitmist kontrollib justiitsminister. 2 (2) Inspektsioonil on arvelduskontod Riigikassa kontsernikonto koosseisus. Inspektsioonil on arvelduskontod Riigikassa kontsernikonto koosseisus.",
      "rdfs:label": {
        "@value": "Reg_310585_Par_4 (redaktsioon 310585)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "310585",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/310585",
      "estleg:sourceAct": "Andmekaitse Inspektsiooni põhimäärus",
      "estleg:provisionRef": "Reg_310585 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_310585_Map"
      }
    },
    {
      "@id": "estleg:Reg_310585_Par_5_v310585",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
