      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Inspektsioonil on väikese riigivapi kujutise ja oma nimetusega pitsat ning kehtestatud korras registreeritud sümboolika. Inspektsioonil on väikese riigivapi kujutise ja oma nimetusega pitsat ning kehtestatud korras registreeritud sümboolika.",
      "rdfs:label": {
