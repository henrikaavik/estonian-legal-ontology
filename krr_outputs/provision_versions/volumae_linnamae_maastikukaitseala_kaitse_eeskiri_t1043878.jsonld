    {
      "@id": "estleg:Reg_1043878_Par_12_v1043878",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043878_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Võlumäe-Linnamäe piiranguvöönd. Kaitsealal on Võlumäe-Linnamäe piiranguvöönd.",
      "rdfs:label": {
