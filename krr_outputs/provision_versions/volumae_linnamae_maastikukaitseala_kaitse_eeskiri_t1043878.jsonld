      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakvere Rajooni Rahvasaadikute Nõukogu Täitevkomitee 18. detsembri 1986. a otsus nr 302 „Võlumäe-Linnamäe maastikukaitseala moodustamine” tunnistatakse kehtetuks. Rakvere Rajooni Rahvasaadikute Nõukogu Täitevkomitee 18. detsembri 1986. a otsus nr 302 „Võlumäe-Linnamäe maastikukaitseala moodustamine” tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1043878_Par_17 (redaktsioon 1043878)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043878",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043878",
