    {
      "@id": "estleg:Reg_1038192_Par_3_v1038192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038192_Par_3"
