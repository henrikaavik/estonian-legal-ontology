      "estleg:provisionRef": "Reg_1049366 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049366_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049366_Par_6_v1049366",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
