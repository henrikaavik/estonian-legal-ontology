      "estleg:provisionRef": "Reg_156331 § 5_7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156331_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156331_Par_6_v156331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156331_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eriotstarbelise diislikütuse erimärgistatuse õigusaktidele vastavuse kontrollimiseks võtab erimärgistamise korraldaja või käesoleva määruse §-s 9 nimetatud labori esindaja eriotstarbelisest diislikütusest proovi, juhindudes vastavatest õigusaktidest. RT I 2019-06-14 3 114062019003 2019-06-17 Eriotstarbelise diislikütuse erimärgistatuse õigusaktidele vastavuse kontrollimiseks võtab erimärgistamise korraldaja või käesoleva määruse §-s 9 nimetatud labori esindaja eriotstarbelisest diislikütusest proovi, juhindudes vastavatest õigusaktidest.",
      "rdfs:label": {
        "@value": "Reg_156331_Par_6 (redaktsioon 156331)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156331",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156331",
      "estleg:sourceAct": "Diislikütuse erimärgistamise ja selle üle kontrolli teostamise kord",
      "estleg:provisionRef": "Reg_156331 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156331_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156331_Par_7_v156331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156331_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Erimärgistamise korraldaja nõudmisel või juhul, kui toll peab seda vajalikuks, võtab proovivõtja koos prooviga ka kaks lisaproovi, millest üks jääb tolli valdusse ja teine erimärgistamise korraldaja valdusse. Proov ja lisaproovid peavad oma omadustelt olema identsed. Erimärgistamise korraldaja nõudmisel või juhul, kui toll peab seda vajalikuks, võtab proovivõtja koos prooviga ka kaks lisaproovi, millest üks jääb tolli valdusse ja teine erimärgistamise korraldaja valdusse. Proov ja lisaproovid peavad oma omadustelt olema identsed. 2 (2) Lisaproove kasutatakse juhul, kui esmalt võetud proovi uurimistulemused vaidlustatakse või kui toll või erimärgistamise korraldaja soovib neid muul põhjusel üle kontrollida. Lisaproove kasutatakse juhul, kui esmalt võetud proovi uurimistulemused vaidlustatakse või kui toll või erimärgistamise korraldaja soovib neid muul põhjusel üle kontrollida.",
      "rdfs:label": {
        "@value": "Reg_156331_Par_7 (redaktsioon 156331)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156331",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156331",
      "estleg:sourceAct": "Diislikütuse erimärgistamise ja selle üle kontrolli teostamise kord",
      "estleg:provisionRef": "Reg_156331 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156331_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156331_Par_8_v156331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156331_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Proovi omaduste säilitamiseks ja proovi puutumatuse tagamiseks proov pakendatakse ning pitseeritakse või plommitakse. Pakendile märgitakse kulumis- ja veekindlas kirjas proovi tunnuskood, kuupäev, proovivõtja nimi ja allkiri. Proovi omaduste säilitamiseks ja proovi puutumatuse tagamiseks proov pakendatakse ning pitseeritakse või plommitakse. Pakendile märgitakse kulumis- ja veekindlas kirjas proovi tunnuskood, kuupäev, proovivõtja nimi ja allkiri.",
      "rdfs:label": {
        "@value": "Reg_156331_Par_8 (redaktsioon 156331)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156331",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156331",
      "estleg:sourceAct": "Diislikütuse erimärgistamise ja selle üle kontrolli teostamise kord",
      "estleg:provisionRef": "Reg_156331 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156331_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156331_Par_9_v156331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156331_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erimärgistamise korraldaja saadab proovi erimärgistatuse õigusaktidele vastavuse kontrollimiseks sõltumatule akrediteeritud laborile (edaspidi labor). Erimärgistamise korraldaja saadab proovi erimärgistatuse õigusaktidele vastavuse kontrollimiseks sõltumatule akrediteeritud laborile (edaspidi labor).",
      "rdfs:label": {
