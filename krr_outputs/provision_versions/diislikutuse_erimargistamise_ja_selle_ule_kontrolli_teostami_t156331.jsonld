      "estleg:provisionRef": "Reg_156331 § 5_6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156331_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156331_Par_5_7_v156331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156331_Par_5_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maksu- ja Tolliamet võib erimärgistamise loa peatada, kui isik rikub § 51 lõike 2 punktis 8 või § 52 lõikes 1, 2 või 4 sätestatud kohustusi või kui dosaatorsüsteemiga erimärgistamine ei vasta nõuetele. Maksu- ja Tolliamet võib erimärgistamise loa peatada, kui isik rikub § 51 lõike 2 punktis 8 või § 52 lõikes 1, 2 või 4 sätestatud kohustusi või kui dosaatorsüsteemiga erimärgistamine ei vasta nõuetele. 2 (2) Maksu- ja Tolliamet tunnistab erimärgistamise loa kehtetuks, kui: 1 1) isiku aktsiisilao tegevusluba on tunnistatud kehtetuks või kui mõõtetulemuste jälgitavus ei ole mõõteseaduse alusel enam tõendatud; 2 2) isik ei vasta enam § 51 lõike 2 punktides 3 ja 7 sätestatud tingimustele; 3 3) sik rikub korduvalt § 52 lõikes 1 sätestatud tolli informeerimise kohustust; 4 4) isik rikub § 52 lõikes 1 sätestatud lähetamise keeldu või § 52 lõike 2 esimeses lauses või § 52 lõikes 3 sätestatud kohustust; 5 5) isik ei täida korduvalt § 52 lõike 2 teises lauses või § 52 lõikes 4 sätestatud kohustust; 6 6) dosaatorsüsteemiga erimärgistamine ei ole korduvalt vastanud nõuetele; 7 7) isiku suhtes on algatatud pankrotimenetlus; 8 8) on vastu võetud isiku jaotumise otsus; 9 9) erimärgistamise loa omanik taotleb loa kehtetuks tunnistamist. RT I 2017-01-04 18 104012017018 2017-01-20 Maksu- ja Tolliamet tunnistab erimärgistamise loa kehtetuks, kui: isiku aktsiisilao tegevusluba on tunnistatud kehtetuks või kui mõõtetulemuste jälgitavus ei ole mõõteseaduse alusel enam tõendatud; isik ei vasta enam § 51 lõike 2 punktides 3 ja 7 sätestatud tingimustele; sik rikub korduvalt § 52 lõikes 1 sätestatud tolli informeerimise kohustust; isik rikub § 52 lõikes 1 sätestatud lähetamise keeldu või § 52 lõike 2 esimeses lauses või § 52 lõikes 3 sätestatud kohustust; isik ei täida korduvalt § 52 lõike 2 teises lauses või § 52 lõikes 4 sätestatud kohustust; dosaatorsüsteemiga erimärgistamine ei ole korduvalt vastanud nõuetele; isiku suhtes on algatatud pankrotimenetlus; on vastu võetud isiku jaotumise otsus; erimärgistamise loa omanik taotleb loa kehtetuks tunnistamist.",
      "rdfs:label": {
        "@value": "Reg_156331_Par_5_7 (redaktsioon 156331)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156331",
