    {
      "@id": "estleg:Reg_313663_Par_4_v313663",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313663_Par_4"
