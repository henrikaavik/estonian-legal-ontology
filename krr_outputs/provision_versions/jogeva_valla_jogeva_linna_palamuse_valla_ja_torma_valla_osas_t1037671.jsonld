    },
    {
      "@id": "estleg:Reg_1037671_Par_3_v1037671",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037671_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatava Jõgeva valla piiriks on §-ga 2 muudetud Jõgeva valla ning Jõgeva linna, Palamuse valla ja Torma valla piir (välja arvatud Võtikvere küla), välja arvatud nende omavahelises osas. Haldusterritoriaalse korralduse muutmise käigus moodustatava Jõgeva valla piiriks on §-ga 2 muudetud Jõgeva valla ning Jõgeva linna, Palamuse valla ja Torma valla piir (välja arvatud Võtikvere küla), välja arvatud nende omavahelises osas. 2 (2) Maa-amet kannab Jõgeva valla piiri riigi maakatastri kaardile. Maa-amet kannab Jõgeva valla piiri riigi maakatastri kaardile.",
      "rdfs:label": {
        "@value": "Reg_1037671_Par_3 (redaktsioon 1037671)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037671",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037671",
      "estleg:sourceAct": "Jõgeva valla, Jõgeva linna, Palamuse valla ja Torma valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ muutmine",
      "estleg:provisionRef": "Reg_1037671 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037671_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1037671_Par_4_v1037671",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037671_Par_4"
