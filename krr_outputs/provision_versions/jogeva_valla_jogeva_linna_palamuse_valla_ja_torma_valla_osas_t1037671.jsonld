      "estleg:versionValidFrom": {
        "@value": "2017-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jõgeva valla piiri muudetakse senise Pajusi valla Kaave küla ja Puurmani valla Jõune, Härjanurme, Pööra ja Saduküla territooriumi arvamisega Jõgeva valla koosseisu. Jõgeva valla piiri muudetakse senise Pajusi valla Kaave küla ja Puurmani valla Jõune, Härjanurme, Pööra ja Saduküla territooriumi arvamisega Jõgeva valla koosseisu.",
