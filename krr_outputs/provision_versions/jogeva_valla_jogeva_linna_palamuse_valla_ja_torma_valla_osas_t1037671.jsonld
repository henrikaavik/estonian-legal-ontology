      "estleg:versionValidFrom": {
        "@value": "2017-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 3. aprilli 1995. a määrusega nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ kinnitatud „Eesti territooriumi haldusüksuste nimistut“ muudetakse järgmiselt: 1 1) Jõgeva maakonna linnade loetelust jäetakse välja tekstiosa „linnad – Jõgeva“; 2 2) Jõgeva maakonna valdade loetelust jäetakse välja sõnad „Palamuse,“ ja „, Torma“. Vabariigi Valitsuse 3. aprilli 1995. a määrusega nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ kinnitatud „Eesti territooriumi haldusüksuste nimistut“ muudetakse järgmiselt: Jõgeva maakonna linnade loetelust jäetakse välja tekstiosa „linnad – Jõgeva“; Jõgeva maakonna valdade loetelust jäetakse välja sõnad „Palamuse,“ ja „, Torma“.",
      "rdfs:label": {
        "@value": "Reg_1037671_Par_4 (redaktsioon 1037671)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037671",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037671",
      "estleg:sourceAct": "Jõgeva valla, Jõgeva linna, Palamuse valla ja Torma valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine“ muutmine",
      "estleg:provisionRef": "Reg_1037671 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037671_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1037671_Par_5_v1037671",
      "@type": [
        "owl:NamedIndividual",
