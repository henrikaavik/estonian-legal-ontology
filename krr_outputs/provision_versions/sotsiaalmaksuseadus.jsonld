      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SMS_Par_2_1_v13114746",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SMS_Par_2_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalmaksu maksmise aluseks olev kuumäär kehtestatakse eelarveaastaks riigieelarvega. Riigieelarvega kehtestatav kuumäär ei või olla väiksem kui eelarveaastale eelnenud aasta 1. juulil kehtinud Vabariigi Valitsuse kehtestatud kuupalga alammäär.",
      "rdfs:label": {
        "@value": "SMS_Par_2_1 (redaktsioon 13114746)",
