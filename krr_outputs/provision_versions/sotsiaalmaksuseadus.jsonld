    {
      "@id": "estleg:SMS_Par_13_v22472",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SMS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi sotsiaalmaksu seaduse (RT 1990, 9, 102; 1991, 32, 391; 1992, 21, 302; 34, 444; RT I 1993, 65, 924; 79, 1181; 1994, 40, 656; 1995, 17, 235; 1996, 74, 1307; 1998, 40, 611) alusel pärast käesoleva seaduse jõustumist tasumisele kuuluv sotsiaalmaks kantakse maksumaksja elu- või asukohajärgse Maksuameti kohaliku asutuse pangakontole, nimetatud seaduse alusel tekkinud sotsiaalmaksu osade võlad nõuab sisse Maksuamet. Eelnimetatud summad suunatakse laekumisel isikustamata summadena riikliku pensionikindlustuse ja ravikindlustuse vahenditesse. (2) Sotsiaalmaksuseaduse (RT I 1998, 40, 611; 61, 982; 113/114, 1875 ja 1876; 1999, 29, 397; 71, 685; 82, 749; 87, 789; 88, 806; 97, 857; 101, 903; 2000, 57, 370; 84, 536; 86, 543) alusel pärast käesoleva seaduse jõustumist tasumisele kuuluv sotsiaalmaks deklareeritakse, tasutakse ja tagastatakse vastavalt nimetatud seaduses sätestatule. (3) Käesoleva seaduse § 3 punkt 11 kehtib 2001. aasta 31. detsembrini.",
      "rdfs:label": {
        "@value": "SMS_Par_13 (redaktsioon 22472)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22472",
      "estleg:supersededByVersion": {
        "@id": "estleg:SMS_Par_13_v751096"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SMS_Par_13_v751096",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SMS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi sotsiaalmaksu seaduse (RT 1990, 9, 102; 1991, 32, 391; 1992, 21, 302; 34, 444; RT I 1993, 65, 924; 79, 1181; 1994, 40, 656; 1995, 17, 235; 1996, 74, 1307; 1998, 40, 611) alusel pärast käesoleva seaduse jõustumist tasumisele kuuluv sotsiaalmaks kantakse Maksu- ja Tolliameti pangakontole, nimetatud seaduse alusel tekkinud sotsiaalmaksu osade võlad nõuab sisse Maksu- ja Tolliamet. Eelnimetatud summad suunatakse laekumisel isikustamata summadena riikliku pensionikindlustuse ja ravikindlustuse vahenditesse. (2) Sotsiaalmaksuseaduse (RT I 1998, 40, 611; 61, 982; 113/114, 1875 ja 1876; 1999, 29, 397; 71, 685; 82, 749; 87, 789; 88, 806; 97, 857; 101, 903; 2000, 57, 370; 84, 536; 86, 543) alusel pärast käesoleva seaduse jõustumist tasumisele kuuluv sotsiaalmaks deklareeritakse, tasutakse ja tagastatakse vastavalt nimetatud seaduses sätestatule. (3) Käesoleva seaduse § 3 punkt 11 kehtib 2001. aasta 31. detsembrini.",
      "rdfs:label": {
        "@value": "SMS_Par_13 (redaktsioon 751096)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "751096",
      "estleg:supersededByVersion": {
        "@id": "estleg:SMS_Par_13_v12769899"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
