      },
      "estleg:versionValidFrom": {
        "@value": "2005-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalmaksu maksab: residendist juriidiline isik; füüsiline isik; Eestis püsivat tegevuskohta omav või käesoleva seaduse § 2 lõikes 1 nimetatud väljamakseid tegev mitteresident; riigi-, valla- või linnaasutus; [Punkti 5 sõnastus kuni 31. 03. 2005] riik käesoleva seaduse §-s 6 sätestatud juhtudel. [Punkti 5 sõnastus alates 1. 04. 2005] riik, vald või linn käesoleva seaduse §-s 6 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "SMS_Par_4 (redaktsioon 849561)",
        "@language": "et"
      },
