  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_teenistus_too_voi_ametiulesannete_taitmisel_isikliku_soiduau_t305880_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja hüvitise maksmise kord (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja hüvitise maksmise kord"
    },
    {
      "@id": "estleg:Reg_305880_Par_1_v305880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305880_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määruses sätestatakse ametniku, töötaja või juriidilise isiku juhtimis- või kontrollorgani liikme teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja kulude maksuvaba hüvitise maksmise kord. RT I 2012-10-09 2 109102012002 2013-04-01 Määruses sätestatakse ametniku, töötaja või juriidilise isiku juhtimis- või kontrollorgani liikme teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja kulude maksuvaba hüvitise maksmise kord. 2 (2) Määruses sätestatakse puudega ametnikule, töötajale või juriidilise isiku juhtimis- või kontrollorgani liikmele maksuvaba hüvitise maksmise kord seoses isikliku mootorsõiduki kasutamisega sõiduks elukoha ja töökoha vahel, kui selleks ei ole võimalik kasutada ühistransporti või kui ühistranspordi kasutamine põhjustab isiku liikumis- ja töövõime olulist langust. RT I 2012-10-09 2 109102012002 2013-04-01 Määruses sätestatakse puudega ametnikule, töötajale või juriidilise isiku juhtimis- või kontrollorgani liikmele maksuvaba hüvitise maksmise kord seoses isikliku mootorsõiduki kasutamisega sõiduks elukoha ja töökoha vahel, kui selleks ei ole võimalik kasutada ühistransporti või kui ühistranspordi kasutamine põhjustab isiku liikumis- ja töövõime olulist langust. 3 (3) Isikliku sõiduautona või mootorsõidukina käsitatakse ametniku, töötaja ja juriidilise isiku juhtimis- või kontrollorgani liikme kasutuses olevat sõiduautot või mootorsõidukit, mis ei ole tööandja omanduses ega valduses. RT I 2012-10-09 2 109102012002 2013-04-01 Isikliku sõiduautona või mootorsõidukina käsitatakse ametniku, töötaja ja juriidilise isiku juhtimis- või kontrollorgani liikme kasutuses olevat sõiduautot või mootorsõidukit, mis ei ole tööandja omanduses ega valduses. 4 (4) Määrust ei rakendata nende teenistus-, töö- või ametilähetusega seotud sõidukulude suhtes, mis hüvitatakse «Tulumaksuseaduse» § 13 lõike 3 punkti 1 alusel kehtestatud määruse kohaselt. RT I 2009 55 373 13236054 2009-11-27 Määrust ei rakendata nende teenistus-, töö- või ametilähetusega seotud sõidukulude suhtes, mis hüvitatakse «Tulumaksuseaduse» § 13 lõike 3 punkti 1 alusel kehtestatud määruse kohaselt.",
      "rdfs:label": {
        "@value": "Reg_305880_Par_1 (redaktsioon 305880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305880",
      "estleg:sourceAct": "Teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja hüvitise maksmise kord",
      "estleg:provisionRef": "Reg_305880 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305880_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_305880_Par_2_v305880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305880_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isikliku sõiduauto kasutamise eest teenistus-, töö- või ametiülesannete täitmisel võib maksuvabalt maksta hüvitist §-s 5 sätestatud piirmäära ulatuses, kui hüvitise maksmisel on järgitud §-s 3 sätestatud nõudeid ja sõitude kohta on peetud arvestust § 4 kohaselt. RT I 2014-08-26 8 126082014008 2014-09-01 Isikliku sõiduauto kasutamise eest teenistus-, töö- või ametiülesannete täitmisel võib maksuvabalt maksta hüvitist §-s 5 sätestatud piirmäära ulatuses, kui hüvitise maksmisel on järgitud §-s 3 sätestatud nõudeid ja sõitude kohta on peetud arvestust § 4 kohaselt. 2 (2) Puudega isikule elukoha ja töökoha vaheliste sõitude eest hüvitise maksmisel kohaldatakse §-des 3–5 teenistus-, töö- või ametisõitude kulude hüvitamise kohta sätestatut. Kui § 1 lõikes 3 nimetatud mootorsõidukit kasutatakse nii sõiduks elukoha ja töökoha vahel kui ka sama paragrahvi lõikes 1 nimetatud teenistus-, töö- või ametiülesannete täitmisel, võib nimetatud mootorsõiduki kasutamise kulusid maksuvabalt hüvitada kokku §-s 5 sätestatud piirmäära ulatuses. Puudega isikule elukoha ja töökoha vaheliste sõitude eest hüvitise maksmisel kohaldatakse §-des 3–5 teenistus-, töö- või ametisõitude kulude hüvitamise kohta sätestatut. Kui § 1 lõikes 3 nimetatud mootorsõidukit kasutatakse nii sõiduks elukoha ja töökoha vahel kui ka sama paragrahvi lõikes 1 nimetatud teenistus-, töö- või ametiülesannete täitmisel, võib nimetatud mootorsõiduki kasutamise kulusid maksuvabalt hüvitada kokku §-s 5 sätestatud piirmäära ulatuses.",
      "rdfs:label": {
        "@value": "Reg_305880_Par_2 (redaktsioon 305880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305880",
      "estleg:sourceAct": "Teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja hüvitise maksmise kord",
      "estleg:provisionRef": "Reg_305880 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305880_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_305880_Par_3_v305880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305880_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hüvitise kohta vormistatakse tööandja, asutuse juhi, juriidilise isiku pädeva organi või tema volitatud isiku kirjalik otsus, käskkiri või korraldus, milles näidatakse: 1 1) hüvitist saava isiku ees- ja perekonnanimi; 2 2) hüvitise suurus; 3 3) sõidu kuupäev või periood, mille jooksul tehtud sõitude kulusid hüvitatakse. Hüvitise kohta vormistatakse tööandja, asutuse juhi, juriidilise isiku pädeva organi või tema volitatud isiku kirjalik otsus, käskkiri või korraldus, milles näidatakse: hüvitist saava isiku ees- ja perekonnanimi; hüvitise suurus; sõidu kuupäev või periood, mille jooksul tehtud sõitude kulusid hüvitatakse. 2 (2) Otsusele, käskkirjale või korraldusele lisatakse sõiduauto kasutamise õigust tõendava dokumendi koopia, välja arvatud juhul, kui selles esitatud andmed ei ole võrreldes eelmisel korral esitatuga muutunud. RT I 2014-08-26 8 126082014008 2014-09-01 Otsusele, käskkirjale või korraldusele lisatakse sõiduauto kasutamise õigust tõendava dokumendi koopia, välja arvatud juhul, kui selles esitatud andmed ei ole võrreldes eelmisel korral esitatuga muutunud.",
      "rdfs:label": {
        "@value": "Reg_305880_Par_3 (redaktsioon 305880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305880",
      "estleg:sourceAct": "Teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja hüvitise maksmise kord",
      "estleg:provisionRef": "Reg_305880 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305880_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_305880_Par_4_v305880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305880_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõiduauto kasutamise üle peetavas arvestuses näidatakse: RT I 2014-08-26 8 126082014008 2014-09-01 1 1) sõiduautot kasutava isiku ees- ja perekonnanimi; 2 2) sõiduauto riikliku registreerimismärgi andmed; 3 3) sõiduauto läbisõidumõõdiku alg- ja lõppnäit iga teenistus-, töö- või ametiülesannete täitmisel tehtud sõidu korral; RT I 2012-10-09 2 109102012002 2013-04-01 4 4) kuupäev ja sõidu eesmärk iga teenistus-, töö- või ametiülesannete täitmisel tehtud sõidu korral. Sõiduauto kasutamise üle peetavas arvestuses näidatakse: sõiduautot kasutava isiku ees- ja perekonnanimi; sõiduauto riikliku registreerimismärgi andmed; sõiduauto läbisõidumõõdiku alg- ja lõppnäit iga teenistus-, töö- või ametiülesannete täitmisel tehtud sõidu korral; kuupäev ja sõidu eesmärk iga teenistus-, töö- või ametiülesannete täitmisel tehtud sõidu korral.",
      "rdfs:label": {
        "@value": "Reg_305880_Par_4 (redaktsioon 305880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305880",
      "estleg:sourceAct": "Teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja hüvitise maksmise kord",
      "estleg:provisionRef": "Reg_305880 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305880_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_305880_Par_5_v305880",
      "@type": [
