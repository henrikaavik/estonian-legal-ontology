      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Plasti sisaldavatest kalapüügivahenditest ja nende osadest tekkinud jäätmete kogumise, tootjale tagastamise ning taaskasutamise või kõrvaldamise nõuded ja kord ning kogumise sihtarvud ja sihtarvude saavutamise tähtajad (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Plasti sisaldavatest kalapüügivahenditest ja nende osadest tekkinud jäätmete kogumise, tootjale tagastamise ning taaskasutamise või kõrvaldamise nõuded ja kord ning kogumise sihtarvud ja sihtarvude saavutamise tähtajad"
    },
    {
      "@id": "estleg:Reg_1059388_Par_1_v1059388",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059388_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse plasti sisaldavatest kalapüügivahenditest ja nende osadest tekkinud jäätmete kogumise, tootjale tagastamise ning taaskasutamise või kõrvaldamise nõuded ja kord ning kogumise sihtarvud ja sihtarvude saavutamise tähtajad. Määrusega kehtestatakse plasti sisaldavatest kalapüügivahenditest ja nende osadest tekkinud jäätmete kogumise, tootjale tagastamise ning taaskasutamise või kõrvaldamise nõuded ja kord ning kogumise sihtarvud ja sihtarvude saavutamise tähtajad.",
      "rdfs:label": {
        "@value": "Reg_1059388_Par_1 (redaktsioon 1059388)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059388",
