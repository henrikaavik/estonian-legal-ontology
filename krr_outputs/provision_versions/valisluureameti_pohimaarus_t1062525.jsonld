    {
      "@id": "estleg:Reg_1062525_Par_6_v1062525",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062525_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametil on väikese riigivapi kujutisega ja ameti nimega 35 mm läbimõõduga pitsat. Ameti struktuuriüksusel võib olla oma nimega lihtpitsat, kui see on ette nähtud struktuuriüksuse põhimääruses. Ametil on väikese riigivapi kujutisega ja ameti nimega 35 mm läbimõõduga pitsat. Ameti struktuuriüksusel võib olla oma nimega lihtpitsat, kui see on ette nähtud struktuuriüksuse põhimääruses. 2 (2) Ametil on oma embleem (lisa 1). Ametil on oma embleem (lisa 1). 3 (3) Ameti embleemi kasutatakse ameti dokumendiplankidel. Ameti embleemi võib kasutada kujunduselemendina ameti kommunikatsioonikanalites ja infokandjatel ning muudel ameti identiteeti kandvatel esemetel. Ameti embleemi kasutatakse ameti dokumendiplankidel. Ameti embleemi võib kasutada kujunduselemendina ameti kommunikatsioonikanalites ja infokandjatel ning muudel ameti identiteeti kandvatel esemetel.",
      "rdfs:label": {
        "@value": "Reg_1062525_Par_6 (redaktsioon 1062525)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062525",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062525",
      "estleg:sourceAct": "Välisluureameti põhimäärus",
      "estleg:provisionRef": "Reg_1062525 § 6",
