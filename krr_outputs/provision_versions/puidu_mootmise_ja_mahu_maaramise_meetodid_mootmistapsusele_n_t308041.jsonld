      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Puidu mõõtmise ja mahu määramise meetodid, mõõtmistäpsusele ning mõõtmistulemuste dokumenteerimisele esitatavad nõuded (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Puidu mõõtmise ja mahu määramise meetodid, mõõtmistäpsusele ning mõõtmistulemuste dokumenteerimisele esitatavad nõuded"
    },
    {
      "@id": "estleg:Reg_308041_Par_1_v308041",
      "@type": [
        "owl:NamedIndividual",
