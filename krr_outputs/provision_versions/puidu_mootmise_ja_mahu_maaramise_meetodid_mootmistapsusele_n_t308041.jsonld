      "estleg:versionValidFrom": {
        "@value": "2013-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määrusega kehtestatakse metsamaterjaliga või hakkpuiduga (edaspidi puit) tehingute tegemisel mõõtmise ja mahu määramise meetodid, mõõtmistäpsusele ning mõõtmistulemuste dokumenteerimisele esitatavad nõuded, mida kasutatakse juhul, kui pooled ei ole kirjalikult kokku leppinud mõne muu meetodi kasutamises. Käesoleva määrusega kehtestatakse metsamaterjaliga või hakkpuiduga (edaspidi puit) tehingute tegemisel mõõtmise ja mahu määramise meetodid, mõõtmistäpsusele ning mõõtmistulemuste dokumenteerimisele esitatavad nõuded, mida kasutatakse juhul, kui pooled ei ole kirjalikult kokku leppinud mõne muu meetodi kasutamises. 2 (2) Määrust rakendatakse puidu mõõtmisel ja mahu määramisel mõõtmistoimingu asukohas. Määrust rakendatakse puidu mõõtmisel ja mahu määramisel mõõtmistoimingu asukohas. 3 (3) Puiduga tehingute tegemisel lõikes 1 sätestatud muu meetodi kasutamise kokkulepe fikseeritakse kirjalikult müügilepingus. Puiduga tehingute tegemisel lõikes 1 sätestatud muu meetodi kasutamise kokkulepe fikseeritakse kirjalikult müügilepingus.",
      "rdfs:label": {
        "@value": "Reg_308041_Par_1 (redaktsioon 308041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308041",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308041",
      "estleg:sourceAct": "Puidu mõõtmise ja mahu määramise meetodid, mõõtmistäpsusele ning mõõtmistulemuste dokumenteerimisele esitatavad nõuded",
      "estleg:provisionRef": "Reg_308041 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308041_Map"
      }
    },
    {
      "@id": "estleg:Reg_308041_Par_2_v308041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308041_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Metsamaterjal selle määruse tähenduses on maharaiutud puu ja sellest valmistatud puidusortiment. Metsamaterjali mõiste ei laiene metsa kõrvalkasutuse saadusele. Metsamaterjal selle määruse tähenduses on maharaiutud puu ja sellest valmistatud puidusortiment. Metsamaterjali mõiste ei laiene metsa kõrvalkasutuse saadusele. 2 (2) Hakkpuit selle määruse tähenduses on raidmete või võsa purustamise käigus saadud toode. RT I 2013-12-28 4 128122013004 2014-01-01 Hakkpuit selle määruse tähenduses on raidmete või võsa purustamise käigus saadud toode. 3 (3) Nott on puutüve laasimisel ja järkamisel saadud puutüve üksik osa. Nott on puutüve laasimisel ja järkamisel saadud puutüve üksik osa. 4 (4) Virn on ühesuunaliselt üksteise kõrvale ja peale laotud nottide kogum. Virn on ühesuunaliselt üksteise kõrvale ja peale laotud nottide kogum.",
      "rdfs:label": {
        "@value": "Reg_308041_Par_2 (redaktsioon 308041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308041",
