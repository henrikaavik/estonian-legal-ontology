      "estleg:sourceAct": "Puidu mõõtmise ja mahu määramise meetodid, mõõtmistäpsusele ning mõõtmistulemuste dokumenteerimisele esitatavad nõuded",
      "estleg:provisionRef": "Reg_308041 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308041_Map"
      }
