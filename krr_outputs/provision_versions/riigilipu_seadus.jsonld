  },
  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_riigilipu_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigilipu seadus (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigilipu seadus"
    },
    {
      "@id": "estleg:RIIGIL_Par_1_v24419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti riigilipp on sini-must-valge lipp.",
      "rdfs:label": {
        "@value": "RIIGIL_Par_1 (redaktsioon 24419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24419"
    },
    {
      "@id": "estleg:RIIGIL_Par_2_v24419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti riigilipp koosneb kolmest võrdse laiusega horisontaalsest värvilaiust: ülemine laid on sinine, keskmine must ja alumine valge. Lipu laiuse ja pikkuse vahekord on 7:11; lipu normaalsuurus on 1050 x 1650 millimeetrit. Riigilipu etalonkujutis koos sinise värvitooni määratlusega on kinnitatud 1992. aasta 7. juuli seadusega \"Eesti Vabariigi riigilipu ja riigivapi etalonkujutiste kinnitamise kohta\" (RT 1992, nr. 43, art. 566).",
      "rdfs:label": {
        "@value": "RIIGIL_Par_2 (redaktsioon 24419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24419"
    },
    {
      "@id": "estleg:RIIGIL_Par_3_v24419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Presidendi lipp on riigilipp, mille keskel on suur riigivapp.",
      "rdfs:label": {
        "@value": "RIIGIL_Par_3 (redaktsioon 24419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24419"
    },
    {
      "@id": "estleg:RIIGIL_Par_4_v24419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigivõimu teostava asutuse lipp on riigilipp, millele asutus võib asetada erimärgi. Erimärgi kujutise ja selle koha riigilipul kinnitab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "RIIGIL_Par_4 (redaktsioon 24419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24419"
    },
    {
      "@id": "estleg:RIIGIL_Par_5_v24419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilipu kasutamise korra kehtestab Vabariigi Valitsus 1993. aasta 1. juuniks.",
      "rdfs:label": {
        "@value": "RIIGIL_Par_5 (redaktsioon 24419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24419"
    },
    {
      "@id": "estleg:RIIGIL_Par_6_v24419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi Ülemnõukogu Presiidiumi 1990. aasta 16. oktoobri seadlusega \"Eesti Vabariigi riigilipu ja riigivapi kasutamise korra kehtestamise kohta\" (RT 1990, nr. 17, art. 189) kehtestatud \"Eesti Vabariigi riigilipu kasutamise korra\" §-d 1 ja 2 tunnistatakse kehtetuks. Riigikogu aseesimees E. Savisaar Õiend Lisatud avaldamisandmed.",
      "rdfs:label": {
        "@value": "RIIGIL_Par_6 (redaktsioon 24419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24419"
    }
  ]
}
