      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ravimi kliinilise uuringu taotluse erialase hindamise tasu (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ravimi kliinilise uuringu taotluse erialase hindamise tasu"
    },
    {
      "@id": "estleg:Reg_1053308_Par_1_v1053308",
      "@type": [
        "owl:NamedIndividual",
