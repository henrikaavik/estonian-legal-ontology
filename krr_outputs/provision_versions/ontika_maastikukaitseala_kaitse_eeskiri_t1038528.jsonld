      },
      "estleg:versionValidFrom": {
        "@value": "2017-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Ida-Viru maakonnas Kohtla vallas Ontika, Saka ja Valaste külas ning Toila vallas Toila alevikus ja Altküla ja Martsa külas. Kaitseala asub Ida-Viru maakonnas Kohtla vallas Ontika, Saka ja Valaste külas ning Toila vallas Toila alevikus ja Altküla ja Martsa külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1038528_Par_2 (redaktsioon 1038528)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038528",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038528",
