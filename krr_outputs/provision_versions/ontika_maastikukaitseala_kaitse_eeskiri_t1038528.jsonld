        "@value": "2017-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1038528_Par_3 (redaktsioon 1038528)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038528",
