    {
      "@id": "estleg:Reg_1038528_Par_18_v1038528",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038528_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 29. juuni 2006. a määruse nr 152 „Ida-Viru maakonna kaitsealuste parkide piirid” § 1 punkt 14 ning määruse lisas esitatud kaart „Saka mõis” tunnistatakse kehtetuks. Vabariigi Valitsuse 29. juuni 2006. a määruse nr 152 „Ida-Viru maakonna kaitsealuste parkide piirid” § 1 punkt 14 ning määruse lisas esitatud kaart „Saka mõis” tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1038528_Par_18 (redaktsioon 1038528)",
