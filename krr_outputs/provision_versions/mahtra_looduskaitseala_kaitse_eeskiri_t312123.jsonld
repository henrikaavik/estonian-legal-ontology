    {
      "@id": "estleg:Reg_312123_Par_13_v312123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312123_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) ehitise, kaasa arvatud ajutise ehitise püstitamine; 2 2) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: ehitise, kaasa arvatud ajutise ehitise püstitamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine.",
      "rdfs:label": {
        "@value": "Reg_312123_Par_13 (redaktsioon 312123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312123",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312123",
      "estleg:sourceAct": "Mahtra looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312123 § 13",
