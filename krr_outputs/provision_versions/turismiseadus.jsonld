      }
    },
    {
      "@id": "estleg:TurS_Par_6_v108012020009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reisiettevõtja tegevusalad liigitatakse järgmiselt: Eestis osutatavaid reisiteenuseid sisaldavate pakettreiside korraldamine; väljaspool Eestit osutatavaid reisiteenuseid ja tellimuslendu sisaldavate pakettreiside korraldamine; väljaspool Eestit osutatavaid reisiteenuseid ja liinilendu sisaldavate pakettreiside korraldamine; väljaspool Eestit osutatavaid reisiteenuseid, välja arvatud tellimus- või liinilendu, sisaldavate pakettreiside korraldamine; Euroopa Majanduspiirkonna välise riigi reisiettevõtja koostatud pakettreiside vahendamine; Eestis ja väljaspool Eestit või üksnes väljaspool Eestit osutatavaid reisiteenuseid sisaldavate seotud reisikorraldusteenuste pakkumine ja lepingute sõlmimise hõlbustamine; Eestis osutatavaid reisiteenuseid sisaldavate seotud reisikorraldusteenuste pakkumine ja lepingute sõlmimise hõlbustamine.",
      "rdfs:label": {
        "@value": "TurS_Par_6 (redaktsioon 108012020009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108012020009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108012020009",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_7_v26652",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pakettreis on reisikorraldaja poolt ühtse hinna eest pakutav, eelnevalt kindlaks määratud ja vähemalt 24 tunni jooksul osutatav vähemalt kahe järgmise reisiteenuse kogum: sõitjateveoteenus; majutusteenus; muud reisiteenused, mis ei ole sõitjateveoteenuse või majutusteenuse kõrvalteenused ja mis moodustavad koguteenuse olulise osa. (2) Pakettreis on ka reisiteenuste kogum, mida osutatakse vähem kui 24 tunni jooksul, kuid mis sisaldab majutusteenust. (3) Pakettreisi kirjeldus või muud tarbijale edastatud pakettreisi tingimused ei või sisaldada eksitavat teavet. Reisikorraldaja ja reisibüroo peavad väljastama isikule pakettreisi müümisel selle pakettreisi kohta kirjaliku dokumendi, milles peavad sisalduma vähemalt järgmised andmed: reisikorraldaja või reisibüroo nimi, riikliku erinõuetega tegevusaladel tegutsevate ettevõtjate registri (edaspidi register) registreeringu number, aadress, muud kontaktandmed ja äriregistri registrikood; pakettreisi hind, selle tasumise viis ja tingimused ning pakettreisi alguse ja lõpu kuupäev, kellaaeg ja koht; reisi sihtkoht, reisiteekonna kirjeldus, võimalike vahepeatuste ja ümberistumiste kellaajad ja kohad; kasutatavate transpordivahendite liik, iseloomustus ja kategooria; majutuse liik, majutuskohtade asukoht, järk või mugavusaste ja põhitunnused, samuti nende vastavus külastatavas riigis kehtestatud nõuetele; võimalik toitlustamiskava; pakettreisi kuuluvad võimalikud külastused, väljasõidud ja muud teenused; võimalikud passi-, viisa- ja tervishoiualased nõuded; reisikorraldaja ja tarbija pakettreisilepingust taganemise tingimused ning taganemisega kaasnevad õigused ja kohustused; reisikorraldaja või reisibüroo kohaliku esindaja nimi, telefoninumber, aadress ja muud kontaktandmed, kohaliku esindaja puudumisel telefoninumber, aadress ja muud kontaktandmed, kuhu tarbija võib raskustesse sattumise korral abi saamiseks pöörduda ja reisikorraldaja või reisibürooga ühendust võtta; tähtaeg, mille jooksul tarbija võib esitada lepingu rikkumisest tulenevaid nõudeid, ja koht, kuhu sellised nõuded võib esitada.",
      "rdfs:label": {
        "@value": "TurS_Par_7 (redaktsioon 26652)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26652",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_7_v728961"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26652",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_7_v728961",
      "@type": [
        "owl:NamedIndividual",
