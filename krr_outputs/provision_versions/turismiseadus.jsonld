      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/728961",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 31_1",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_31_1_v13309183",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_31_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-05-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pakettreiside müügiks pakkumise või müügi eest ilma nõuetekohase tagatiseta – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Pakettreiside müügi nõuetekohase aruande esitamata jätmise eest – karistatakse rahatrahviga kuni 200 trahviühikut. (3) Registrile andmete esitamata jätmise eest – karistatakse rahatrahviga kuni 200 trahviühikut. (4) Käesoleva paragrahvi lõikes 1 sätestatud teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 100 000 krooni. (5) Käesoleva paragrahvi lõikes 2 või 3 sätestatud teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "TurS_Par_31_1 (redaktsioon 13309183)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13309183",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_31_1_v13309741"
