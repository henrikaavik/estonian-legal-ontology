      }
    },
    {
      "@id": "estleg:TurS_Par_19_v104122020003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majutusteenuse osutajal peavad olema teenuse osutamiseks sobivad, ohutud ja turvalised hooned, ruumid, sisustus ja maa-ala. (2) Majutusteenuse osutaja tagab majutusettevõtte liigi eripära arvestavad majutus- ja puhkevõimalused ning piisavad hügieenitingimused. (3) Majutusteenuse täpsemad nõuded majutusettevõtte liigiti majutusteenuse kasutaja mugavuse ja ohutuse eesmärgil kehtestab määrusega.",
      "rdfs:label": {
        "@value": "TurS_Par_19 (redaktsioon 104122020003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122020003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104122020003",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_2_v26652",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turismiteenust pakkuda ja osutada võib ettevõtja. (2) Turismiteenus on: reisikorraldaja või reisibüroo poolt reisiteenuse osutamine; majutus- ja toitlustusteenuse osutamine; majutusteenuse osutamine; konverentsiteenuse osutamine; majutus- ja taastusraviteenuse osutamine; giiditeenuse, giid-tõlgiteenuse ja reisisaatjateenuse osutamine.",
      "rdfs:label": {
        "@value": "TurS_Par_2 (redaktsioon 26652)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26652",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_2_v728961"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26652",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_2_v728961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turismiteenust võivad pakkuda ja osutada ettevõtja, asutus, sihtasutus ja mittetulundusühing (edaspidi ettevõtja). (2) Turismiteenus on: reisiettevõtja poolt reisiteenuse osutamine; majutus- ja toitlustusteenuse osutamine; majutusteenuse osutamine; konverentsiteenuse osutamine; majutus- ja taastusraviteenuse osutamine; giiditeenuse, giid-tõlgiteenuse ja reisisaatjateenuse osutamine.",
      "rdfs:label": {
        "@value": "TurS_Par_2 (redaktsioon 728961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "728961",
      "estleg:supersededByVersion": {
