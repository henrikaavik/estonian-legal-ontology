    {
      "@id": "estleg:TurS_Par_23_v26652",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majutusettevõtte fassaadil või juurdepääsutee ääres peab paiknema majutusettevõtte tähistus majutusettevõtte nime, liigi ja järgutähisega viimase olemasolu korral. (2) Majutusettevõtte nimes võib kasutada majutusettevõtte tunnistusele märgitud majutusettevõtte liigi nimetust ja järgu olemasolu korral järgutähist. (3) Maapiirkonnas asuva külalistemaja, hosteli, puhkeküla ja -laagri, puhkemaja ning kodumajutuse nimes võib kasutada sõna «turismitalu».",
      "rdfs:label": {
        "@value": "TurS_Par_23 (redaktsioon 26652)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26652",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_23_v898545"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26652",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_23_v898545",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majutusettevõtte hoonel või majutusettevõtte juurdepääsutee ääres peab paiknema majutusettevõtte tähistus majutusettevõtte nime ja liigi nimetusega või muu liiki iseloomustava määratlusega. Järgu olemasolu korral võib majutusettevõtte tähistuses kasutada järgule vastavat järgutähist. (2) Majutusettevõtte nimes võib kasutada vaid majutusettevõtte registreeringus märgitud majutusettevõtte liigi nimetust või muud liiki iseloomustavat määratlust. Järgu olemasolu korral võib majutusettevõtte nimes kasutada järgule vastavat järgutähist. (3) Maapiirkonnas asuva külalistemaja, hosteli, puhkeküla ja -laagri, puhkemaja ning kodumajutuse nimes võib kasutada sõna «turismitalu».",
      "rdfs:label": {
        "@value": "TurS_Par_23 (redaktsioon 898545)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898545",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_23_v129062014087"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898545",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_23_v129062014087",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majutusettevõtte hoonel või majutusettevõtte juurdepääsutee ääres peab paiknema majutusettevõtte tähistus majutusettevõtte nime ja liigiga või muu liiki iseloomustava määratlusega. (2) Järgu olemasolu korral võib majutusettevõtte nimes ja tähistuses kasutada järgule vastavat järgutähist. (3) Maapiirkonnas asuva külalistemaja, hosteli, puhkeküla ja -laagri, puhkemaja ning kodumajutuse nimes võib kasutada sõna «turismitalu».",
      "rdfs:label": {
        "@value": "TurS_Par_23 (redaktsioon 129062014087)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014087",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_23_v104122020003"
      },
      "estleg:versionValidTo": {
        "@value": "2021-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014087",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_23_v104122020003",
      "@type": [
        "owl:NamedIndividual",
