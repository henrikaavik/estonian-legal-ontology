    {
      "@id": "estleg:TurS_Par_26_v129062014087",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_26"
      },
      "estleg:versionValidFrom": {
