    {
      "@id": "estleg:TurS_Par_21_v26652",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majutusettevõtte järk (edaspidi järk) näitab majutusettevõtte ja majutusettevõttes pakutavate teenuste taset. (2) Järkude omistamise aluseks olevad nõuded ja järgu omistamise korra kehtestab majandusminister. (3) Järgu omandamine on ettevõtjale vabatahtlik.",
      "rdfs:label": {
        "@value": "TurS_Par_21 (redaktsioon 26652)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26652",
      "estleg:supersededByVersion": {
