      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/697025",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 19",
      "estleg:partOfAct": {
