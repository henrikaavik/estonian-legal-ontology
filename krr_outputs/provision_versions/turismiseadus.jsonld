        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab üldised nõuded turismiteenuse pakkumisele ja osutamisele ning turismiinfokeskusele, samuti vastutuse käesoleva seaduse rikkumise eest ja riikliku järelevalve teostamise korra.",
      "rdfs:label": {
        "@value": "TurS_Par_1 (redaktsioon 26652)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26652",
