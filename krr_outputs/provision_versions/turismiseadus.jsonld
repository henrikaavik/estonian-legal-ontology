        "@value": "2005-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26652",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_1_v898545",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab üldised nõuded turismiteenuse pakkumisele ja osutamisele ning turismiinfokeskusele, samuti vastutuse käesoleva seaduse rikkumise eest ja järelevalve teostamise korra.",
      "rdfs:label": {
        "@value": "TurS_Par_1 (redaktsioon 898545)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898545",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_1_v128122017031"
      },
      "estleg:versionValidTo": {
        "@value": "2018-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898545",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_1_v128122017031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus sätestab üldised nõuded turismiteenuse pakkumisele ja osutamisele ning turismiinfokeskusele, samuti vastutuse käesoleva seaduse rikkumise eest ja järelevalve teostamise korra. (2) Käesolevat seadust ei kohaldata, kui pakettreise pakutakse või seotud reisikorraldusteenuste lepingute sõlmimist hõlbustatakse vaid juhuti, mittekasumlikul eesmärgil ning üksnes piiratud arvule reisijatele, pakkumata neid avalikkusele. (3) Käesolevat seadust ei kohaldata pakettreisilepingute ega seotud reisikorraldusteenuste lepingute suhtes, mis on sõlmitud üldlepingu alusel, millega ettevõtja korraldab ärireise teisele majandus- või kutsetegevuses tegutsevale isikule. (4) Käesolevat seadust ei kohaldata pakettreiside ega seotud reisikorraldusteenuste suhtes, mis kestavad vähem kui 24 tundi, välja arvatud juhul, kui need sisaldavad öist majutust.",
      "rdfs:label": {
        "@value": "TurS_Par_1 (redaktsioon 128122017031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017031",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122017031",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_10_v26652",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reisikorraldaja või reisibüroo esitab registrile registreerimistaotluse. (2) Registreerimistaotluses peavad sisalduma vähemalt: reisikorraldaja või reisibüroo nimi, registrikood, aadress ja muud kontaktandmed; reisiteenuse osutamise eest vastutava isiku nimi ja kontaktandmed; reisiteenuse osutamisel kasutatava transpordivahendi liik; reisiteenuse osutamise piirkond; käesoleva seaduse §-s 15 sätestatud tagatise suurus ja kehtivuse aeg ning tagatise olemasolu tõendava dokumendi väljastanud ettevõtja nimi, registrikood, aadress ja muud kontaktandmed; registreerimistaotlusele alla kirjutanud isiku nimi, ametinimetus ja kontaktandmed.",
      "rdfs:label": {
        "@value": "TurS_Par_10 (redaktsioon 26652)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26652",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_10_v728961"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26652",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_10_v728961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_10"
      },
