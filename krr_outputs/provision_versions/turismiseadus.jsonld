        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26652",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_21_v697025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majutusettevõtte järk (edaspidi järk) näitab majutusettevõtte ja majutusettevõttes pakutavate teenuste taset. (2) Järkude omistamise aluseks olevad nõuded ja järgu omistamise korra kehtestab majandus- ja kommunikatsiooniminister. (3) Järgu omandamine on ettevõtjale vabatahtlik.",
      "rdfs:label": {
        "@value": "TurS_Par_21 (redaktsioon 697025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "697025",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_21_v898545"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/697025",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_21_v898545",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majutusettevõtte järk (edaspidi järk) näitab majutusettevõtte ja majutusettevõttes pakutavate teenuste taset. (2) Järgu võib vastavat liiki majutusettevõttele anda ja ära võtta neid majutusettevõtteid ühendav või nende kvaliteedialast tegevust arendav eraõiguslik juriidiline isik, kes koostab (3) Õiguse tegutseda järgu andja ja äravõtjana (edaspidi järgu andja) annab majandus- ja kommunikatsiooniminister. Õigus tegutseda järgu andjana antakse iga majutusettevõtte liigi osas vaid ühele isikule. (5) Järgu omandamine on ettevõtjale vabatahtlik. (6) Majutusettevõtte hindamise ja järgu andmisega seotud kulude katteks võib käesoleva paragrahvi lõikes 4 sätestatud korras järgu andjana tegutsemise õiguse saanud isik võtta tasu.",
      "rdfs:label": {
        "@value": "TurS_Par_21 (redaktsioon 898545)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898545",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_21_v1036425"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898545",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
    {
      "@id": "estleg:TurS_Par_21_v1036425",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majutusettevõtte järk (edaspidi järk ) näitab majutusettevõtte ja majutusettevõttes pakutavate teenuste taset. (2) Järgu võib vastavat liiki majutusettevõttele anda ja ära võtta neid majutusettevõtteid ühendav või nende kvaliteedialast tegevust arendav eraõiguslik juriidiline isik, kes koostab (3) Õiguse tegutseda järgu andja ja äravõtjana (edaspidi järgu andja ) annab majandus- ja kommunikatsiooniminister. Õigus tegutseda järgu andjana antakse iga majutusettevõtte liigi osas vaid ühele isikule. (5) Järgu omandamine on ettevõtjale vabatahtlik. (6) Majutusettevõtte hindamise ja järgu andmisega seotud kulude katteks võib käesoleva paragrahvi lõikes 4 sätestatud korras järgu andjana tegutsemise õiguse saanud isik võtta tasu.",
      "rdfs:label": {
        "@value": "TurS_Par_21 (redaktsioon 1036425)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036425",
