    {
      "@id": "estleg:TurS_Par_35_v26652",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivuseaduse (RT I 1997, 80, 1344; 2000, 5, 32; 10, 58; 19, 117; 26, 150; 29, 168 ja 169; 39, 237; 49, 300; 54, 346 ja 349; 55, 365; 57, 372 ja 373; 59, 379; 60, õiend; 78, 498; 84, 534; 92, 597 ja 598) § 183 täiendatakse lõigetega 316–318 järgmises sõnastuses: «(316) Majutusettevõtte tunnistuse väljastamise eest tasutakse riigilõivu 100 krooni. (3¹⁷) Järgutunnistuse väljastamise eest tasutakse riigilõivu kuni 50 numbritoaga majutusettevõtte korral: ühetärnihotelli järgu taotlemisel 300 krooni; kahetärnihotelli järgu taotlemisel 400 krooni; kolmetärnihotelli järgu taotlemisel 700 krooni; neljatärnihotelli järgu taotlemisel 900 krooni; viietärnihotelli järgu taotlemisel 1000 krooni. (3¹⁸) Järgutunnistuse väljastamise eest tasutakse riigilõivu üle 50 numbritoaga majutusettevõtte korral: ühetärnihotelli järgu taotlemisel 500 krooni; kahetärnihotelli järgu taotlemisel 600 krooni; kolmetärnihotelli järgu taotlemisel 900 krooni; neljatärnihotelli järgu taotlemisel 1100 krooni; viietärnihotelli järgu taotlemisel 1300 krooni.»",
      "rdfs:label": {
        "@value": "TurS_Par_35 (redaktsioon 26652)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26652",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurS_Par_35_v193819"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/26652",
      "estleg:sourceAct": "Turismiseadus",
      "estleg:provisionRef": "TurS § 35",
      "estleg:partOfAct": {
        "@id": "estleg:TurS_Map"
      }
    },
