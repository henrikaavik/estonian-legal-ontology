      }
    },
    {
      "@id": "estleg:TAKS_Par_10_v834781",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teadus- ja arendustegevuse korraldamisel Vabariigi Valitsus: kujundab Eesti eeldusi, tingimusi ning vajadusi arvestava teadus- ja arenduspoliitika ning valmistab ette riigi teadus- ja arendustegevuse arengukavad ja esitab need Riigikogule; vähemalt kord aastas esitab peaminister Riigikogule Vabariigi Valitsuse nimel ülevaate teadus- ja arendustegevuse olukorrast ning valitsuse poliitikast selles valdkonnas; kinnitab riiklikud teadus- ja arendusprogrammid vastavalt riigi arengukavadele, tagab ministeeriumidevahelise koostöö teadus- ja arenduspoliitika elluviimisel, arvestades Teadus- ja Arendusnõukogu ettepanekuid; ning kinnitab haridus- ja teadusministri ettepanekul kuni kolmeks aastaks selle koosseisu; ning kinnitab majandus- ja kommunikatsiooniministri ettepanekul kuni kolmeks aastaks selle koosseisu; , kuulanud ära Teadus- ja Arendusnõukogu seisukoha; otsustab Eesti osalemise rahvusvahelises teadus- ja arendustegevusalases koostöös riiklikul tasemel; moodustab riigi teaduspreemiate komisjoni ja kinnitab haridus- ja teadusministri ettepanekul selle koosseisu; määrab riigi teaduspreemiad haridus- ja teadusministri esildisel riigi teaduspreemiate komisjoni ettepanekute alusel; täidab muid talle seadusega pandud ülesandeid teadus- ja arendustegevuse valdkonnas.",
      "rdfs:label": {
        "@value": "TAKS_Par_10 (redaktsioon 834781)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "834781",
      "estleg:supersededByVersion": {
        "@id": "estleg:TAKS_Par_10_v13242062"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TAKS_Par_10_v13242062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teadus- ja arendustegevuse korraldamisel Vabariigi Valitsus: kujundab Eesti eeldusi, tingimusi ning vajadusi arvestava teadus- ja arenduspoliitika ning valmistab ette riigi teadus- ja arendustegevuse arengukavad ja esitab need Riigikogule; vähemalt kord aastas esitab peaminister Riigikogule Vabariigi Valitsuse nimel ülevaate teadus- ja arendustegevuse olukorrast ning valitsuse poliitikast selles valdkonnas; kinnitab riiklikud teadus- ja arendusprogrammid vastavalt riigi arengukavadele, tagab ministeeriumidevahelise koostöö teadus- ja arenduspoliitika elluviimisel, arvestades Teadus- ja Arendusnõukogu ettepanekuid; ning kinnitab haridus- ja teadusministri ettepanekul kuni kolmeks aastaks selle koosseisu; ning kinnitab majandus- ja kommunikatsiooniministri ettepanekul kuni kolmeks aastaks selle koosseisu; , kuulanud ära Teadus- ja Arendusnõukogu seisukoha; otsustab Eesti osalemise rahvusvahelises teadus- ja arendustegevusalases koostöös riiklikul tasemel; kehtetu – moodustab riigi teaduspreemiate komisjoni ja kinnitab haridus- ja teadusministri ettepanekul selle koosseisu; määrab riigi teaduspreemiad haridus- ja teadusministri esildisel riigi teaduspreemiate komisjoni ettepanekute alusel; täidab muid talle seadusega pandud ülesandeid teadus- ja arendustegevuse valdkonnas.",
      "rdfs:label": {
        "@value": "TAKS_Par_10 (redaktsioon 13242062)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13242062",
      "estleg:supersededByVersion": {
        "@id": "estleg:TAKS_Par_10_v13243080"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TAKS_Par_10_v13243080",
      "@type": [
        "owl:NamedIndividual",
