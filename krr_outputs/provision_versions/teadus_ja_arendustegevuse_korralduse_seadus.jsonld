      }
    },
    {
      "@id": "estleg:TAKS_Par_16_v215180",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAKS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 31. 12. 2002] (1) Riigieelarves uurimistoetusteks (sealhulgas magistrandide ja doktorantide teadustöö stipendiumideks) ettenähtud raha eraldatakse Haridusministeeriumi eelarve kaudu riigi poolt asutatud sihtasutusele Eesti Teadusfond. [Lõike 1 sõnastus alates 1. 01. 2003] (1) Riigieelarves uurimistoetusteks (sealhulgas magistrandide ja doktorantide teadustöö stipendiumideks) ettenähtud raha eraldatakse Haridus- ja Teadusministeeriumi eelarve kaudu riigi poolt asutatud sihtasutusele Eesti Teadusfond. (2) Riigieelarves arendustoetusteks ettenähtud raha eraldatakse Majandusministeeriumi eelarve kaudu riigi poolt asutatud vastavale sihtasutusele. (3) Riigi poolt asutatud sihtasutused eraldavad uurimis- ja arendustoetusteks ettenähtud raha avaliku konkursi korras esitatud projektidele.",
      "rdfs:label": {
        "@value": "TAKS_Par_16 (redaktsioon 215180)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "215180",
      "estleg:supersededByVersion": {
