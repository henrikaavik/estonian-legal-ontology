        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 4 1 , § 13 lõike 2 punktid 4 ja 6 ning § 14 lõige 3 jõustuvad 2002. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "TAKS_Par_25 (redaktsioon 22374)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22374",
