  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_teadus_ja_arendustegevuse_korralduse_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Teadus- ja arendustegevuse korralduse seadus (163 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teadus- ja arendustegevuse korralduse seadus"
    },
    {
      "@id": "estleg:TAKS_Par_1_v22374",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teadus- ja arendustegevuse korralduse seaduse ülesanne on sätestada teadus- ja arendustegevuse korralduse alused, kindlustada teadus- ja tehnoloogialoome kui eesti kultuuri ja majanduse koostisosa säilimise ning edasise arengu õiguslikud vahendid.",
      "rdfs:label": {
        "@value": "TAKS_Par_1 (redaktsioon 22374)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22374"
    },
    {
      "@id": "estleg:TAKS_Par_10_v22374",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teadus- ja arendustegevuse korraldamisel Vabariigi Valitsus: kujundab Eesti eeldusi, tingimusi ning vajadusi arvestava teadus- ja arenduspoliitika ning valmistab ette riigi teadus- ja arendustegevuse arengukavad ja esitab need Riigikogule; vähemalt kord aastas esitab peaminister Riigikogule Vabariigi Valitsuse nimel ülevaate teadus- ja arendustegevuse olukorrast ning valitsuse poliitikast selles valdkonnas; kinnitab riiklikud teadus- ja arendusprogrammid vastavalt riigi arengukavadele, tagab ministeeriumidevahelise koostöö teadus- ja arenduspoliitika elluviimisel, arvestades Teadus- ja Arendusnõukogu ettepanekuid; kehtestab Teaduskompetentsi Nõukogu moodustamise korra ja töökorra ning kinnitab selle koosseisu; moodustab, korraldab ümber ja lõpetab riigi teadus- ja arendusasutuste tegevuse neid haldava ministeeriumi ettepanekul, kuulanud ära Teadus- ja Arendusnõukogu seisukoha; otsustab Eesti osalemise rahvusvahelises teadus- ja arendustegevusalases koostöös riiklikul tasemel; kehtestab teadus- ja arendustegevuse evalveerimise tingimused ja korra; kehtestab riigi teaduspreemiate põhimääruse; moodustab riigi teaduspreemiate komisjoni ja kinnitab haridusministri ettepanekul selle koosseisu; määrab riigi teaduspreemiad haridusministri esildisel riigi teaduspreemiate komisjoni ettepanekute alusel; täidab muid talle seadusega pandud ülesandeid teadus- ja arendustegevuse valdkonnas.",
      "rdfs:label": {
        "@value": "TAKS_Par_10 (redaktsioon 22374)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22374",
      "estleg:supersededByVersion": {
        "@id": "estleg:TAKS_Par_10_v215180"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TAKS_Par_10_v215180",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teadus- ja arendustegevuse korraldamisel Vabariigi Valitsus: kujundab Eesti eeldusi, tingimusi ning vajadusi arvestava teadus- ja arenduspoliitika ning valmistab ette riigi teadus- ja arendustegevuse arengukavad ja esitab need Riigikogule; vähemalt kord aastas esitab peaminister Riigikogule Vabariigi Valitsuse nimel ülevaate teadus- ja arendustegevuse olukorrast ning valitsuse poliitikast selles valdkonnas; kinnitab riiklikud teadus- ja arendusprogrammid vastavalt riigi arengukavadele, tagab ministeeriumidevahelise koostöö teadus- ja arenduspoliitika elluviimisel, arvestades Teadus- ja Arendusnõukogu ettepanekuid; kehtestab Teaduskompetentsi Nõukogu moodustamise korra ja töökorra ning kinnitab selle koosseisu; moodustab, korraldab ümber ja lõpetab riigi teadus- ja arendusasutuste tegevuse neid haldava ministeeriumi ettepanekul, kuulanud ära Teadus- ja Arendusnõukogu seisukoha; otsustab Eesti osalemise rahvusvahelises teadus- ja arendustegevusalases koostöös riiklikul tasemel; kehtestab teadus- ja arendustegevuse evalveerimise tingimused ja korra; kehtestab riigi teaduspreemiate põhimääruse; [Punkti 7 2 sõnastus kuni 31. 12. 2002] moodustab riigi teaduspreemiate komisjoni ja kinnitab haridusministri ettepanekul selle koosseisu; [Punkti 7 2 sõnastus alates 1. 01. 2003] moodustab riigi teaduspreemiate komisjoni ja kinnitab haridus- ja teadusministri ettepanekul selle koosseisu; [Punkti 8 sõnastus kuni 31. 12. 2002] määrab riigi teaduspreemiad haridusministri esildisel riigi teaduspreemiate komisjoni ettepanekute alusel; [Punkti 8 sõnastus alates 1. 01. 2003] määrab riigi teaduspreemiad haridus- ja teadusministri esildisel riigi teaduspreemiate komisjoni ettepanekute alusel; täidab muid talle seadusega pandud ülesandeid teadus- ja arendustegevuse valdkonnas.",
      "rdfs:label": {
        "@value": "TAKS_Par_10 (redaktsioon 215180)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "215180",
      "estleg:supersededByVersion": {
        "@id": "estleg:TAKS_Par_10_v232701"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TAKS_Par_10_v232701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAKS_Par_10"
