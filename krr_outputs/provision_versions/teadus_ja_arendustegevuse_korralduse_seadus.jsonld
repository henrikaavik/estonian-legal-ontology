    },
    {
      "@id": "estleg:TAKS_Par_25_v834781",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAKS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 4 1 , § 13 lõike 2 punktid 4 ja 6 ning § 14 lõige 3 jõustuvad 2002. aasta 1. jaanuaril. (2) Haridus- ja Teadusministeeriumi teadus- ja arendusasutuste registrisse kantud teadus- ja arendusasutused, mille teadus- ja arendustegevus ei ole evalveeritud, esitavad käesoleva seaduse § 5 1 lõike 3 punktides 2 ja 3 loetletud andmed hiljemalt 2006. aasta 1. jaanuariks. (3) Haridus- ja Teadusministeeriumi teadus- ja arendusasutuste registrisse kantud teadus- ja arendusasutused, mille teadus- ja arendustegevust ei ole evalveeritud, peavad taotlema evalveerimist hiljemalt 2007. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "TAKS_Par_25 (redaktsioon 834781)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "834781",
      "estleg:supersededByVersion": {
        "@id": "estleg:TAKS_Par_25_v1011045"
      },
      "estleg:versionValidTo": {
        "@value": "2006-04-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TAKS_Par_25_v1011045",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAKS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 4 1 , § 13 lõike 2 punktid 4 ja 6 ning § 14 lõige 3 jõustuvad 2002. aasta 1. jaanuaril. (2) Haridus- ja Teadusministeeriumi teadus- ja arendusasutuste registrisse kantud teadus- ja arendusasutused, mille teadus- ja arendustegevus ei ole evalveeritud, esitavad käesoleva seaduse § 5 1 lõike 3 punktides 2 ja 3 loetletud andmed hiljemalt 2006. aasta 1. jaanuariks. (3) Haridus- ja Teadusministeeriumi teadus- ja arendusasutuste alamregistrisse kantud teadus- ja arendusasutused, mille teadus- ja arendustegevust ei ole evalveeritud, peavad taotlema evalveerimist hiljemalt 2007. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "TAKS_Par_25 (redaktsioon 1011045)",
