  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_tootervishoiu_ja_tooohutuse_nouded_tootamisel_plahvatusohtli_t156686_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas (13 versiooni)",
        "@language": "et"
      },
      "dc:source": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas"
    },
    {
      "@id": "estleg:Reg_156686_Par_1_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus sätestab töötervishoiu ja tööohutuse nõuded töötamisele töökeskkonnas, kus esineb või võib tekkida plahvatusohtlik keskkond. Määrus sätestab töötervishoiu ja tööohutuse nõuded töötamisele töökeskkonnas, kus esineb või võib tekkida plahvatusohtlik keskkond. 2 (2) Määrust ei kohaldata: 1 1) töötamisele ruumides, kus patsiendile osutatakse tervishoiuteenust, tervishoiuteenuse osutamise ajal; 2 2) töötamisele küttegaasiseadmega; 3 3) lõhkeainete või keemiliselt ebastabiilsete ainete valmistamisele, töötlemisele, kasutamisele, hoidmisele ja vedamisele; 4 4) töötamisele mäetööstuses; 5 5) rahvusvaheliste lepingutega seotud maismaa-, vee- ja õhutranspordivahendite kasutamisele, välja arvatud transpordivahendid, mida kasutatakse ohtlikes kohtades. Määrust ei kohaldata: töötamisele ruumides, kus patsiendile osutatakse tervishoiuteenust, tervishoiuteenuse osutamise ajal; töötamisele küttegaasiseadmega; lõhkeainete või keemiliselt ebastabiilsete ainete valmistamisele, töötlemisele, kasutamisele, hoidmisele ja vedamisele; töötamisele mäetööstuses; rahvusvaheliste lepingutega seotud maismaa-, vee- ja õhutranspordivahendite kasutamisele, välja arvatud transpordivahendid, mida kasutatakse ohtlikes kohtades.",
      "rdfs:label": {
        "@value": "Reg_156686_Par_1 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_10_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Töökohad, kus esineb või võib tekkida plahvatusohtlik keskkond, klassifitseeritakse plahvatusohtliku keskkonna esinemise või tekkimise sageduse ja kestuse alusel tsoonideks vastavalt lisas toodud tsoonide klassifikatsioonile. Töökohad, kus esineb või võib tekkida plahvatusohtlik keskkond, klassifitseeritakse plahvatusohtliku keskkonna esinemise või tekkimise sageduse ja kestuse alusel tsoonideks vastavalt lisas toodud tsoonide klassifikatsioonile.",
      "rdfs:label": {
        "@value": "Reg_156686_Par_10 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_11_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Plahvatusohtlikus keskkonnas tuleb kasutada seadmeid, mis on seadme tootja poolt ette nähtud kasutamiseks vastavas plahvatusohutsoonis. RT I 2015-04-08 1 108042015001 2015-07-01 Plahvatusohtlikus keskkonnas tuleb kasutada seadmeid, mis on seadme tootja poolt ette nähtud kasutamiseks vastavas plahvatusohutsoonis. 2 (2) Töökohtades, mis vastavalt §-le 10 on klassifitseeritud tsoonidesse, tuleb kasutada järgmiste kategooriate seadmeid: 1 1) 0 tsoonis või 20. tsoonis, 1. kategooria seadmeid; 2 2) 1. tsoonis või 21. tsoonis, 1. või 2. kategooria seadmeid ja 3 3) 2. tsoonis või 22. tsoonis, 1., 2. või 3. kategooria seadmeid. Töökohtades, mis vastavalt §-le 10 on klassifitseeritud tsoonidesse, tuleb kasutada järgmiste kategooriate seadmeid: 0 tsoonis või 20. tsoonis, 1. kategooria seadmeid; 1. tsoonis või 21. tsoonis, 1. või 2. kategooria seadmeid ja 2. tsoonis või 22. tsoonis, 1., 2. või 3. kategooria seadmeid. 3 (3) Tsoonideks klassifitseeritud töökohtades kasutatava kaitsesüsteemi valimisel tuleb lähtuda plahvatusriski analüüsi tulemusel määratletud suurimast võimalikust riskist ja plahvatusohtliku keskkonna esinemise või tekkimise sagedusest ja kestusest. Tsoonideks klassifitseeritud töökohtades kasutatava kaitsesüsteemi valimisel tuleb lähtuda plahvatusriski analüüsi tulemusel määratletud suurimast võimalikust riskist ja plahvatusohtliku keskkonna esinemise või tekkimise sagedusest ja kestusest.",
      "rdfs:label": {
        "@value": "Reg_156686_Par_11 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_12_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Plahvatusohtlikus keskkonnas kasutatavate seadmete suhtes, mis on kasutusel enne käesoleva määruse jõustumist, ei kohaldata §-s 11 sätestatud seadmete valimise kriteeriumeid. Plahvatusohtlikus keskkonnas kasutatavate seadmete suhtes, mis on kasutusel enne käesoleva määruse jõustumist, ei kohaldata §-s 11 sätestatud seadmete valimise kriteeriumeid.",
      "rdfs:label": {
        "@value": "Reg_156686_Par_12 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_13_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus jõustub 1. juulil 2004. a. Määrus jõustub 1. juulil 2004. a. 2 (2) Töökohad, kus esineb või võib tekkida plahvatusohtlik keskkond ning mis on kasutusel enne käesoleva määruse jõustumist, peavad olema §-s 8 sätestatud nõuetega kooskõlla viidud hiljemalt 1. juuliks 2006. a. Töökohad, kus esineb või võib tekkida plahvatusohtlik keskkond ning mis on kasutusel enne käesoleva määruse jõustumist, peavad olema §-s 8 sätestatud nõuetega kooskõlla viidud hiljemalt 1. juuliks 2006. a.",
      "rdfs:label": {
        "@value": "Reg_156686_Par_13 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_2_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolevas määruses kasutatakse termineid tuleohutuse seaduse tähenduses. RT I 2015-04-08 1 108042015001 2015-07-01 Käesolevas määruses kasutatakse termineid tuleohutuse seaduse tähenduses. 2 (2) Ohtliku kohana käsitatakse käesoleva määruse tähenduses töökohta, kus plahvatusohtlik keskkond esineb või võib tekkida sellises koguses, mis eeldab abinõude rakendamist töötajate tervisele ohutu töökeskkonna tagamiseks. Ohtliku kohana käsitatakse käesoleva määruse tähenduses töökohta, kus plahvatusohtlik keskkond esineb või võib tekkida sellises koguses, mis eeldab abinõude rakendamist töötajate tervisele ohutu töökeskkonna tagamiseks. 3 (3) Ohutu kohana käsitatakse käesoleva määruse tähenduses töökohta, kus on vähetõenäoline, et plahvatusohtlik keskkond esineb või võib tekkida sellises koguses, mis eeldab abinõude rakendamist töötajate tervisele ohutu töökeskkonna tagamiseks. Ohutu kohana käsitatakse käesoleva määruse tähenduses töökohta, kus on vähetõenäoline, et plahvatusohtlik keskkond esineb või võib tekkida sellises koguses, mis eeldab abinõude rakendamist töötajate tervisele ohutu töökeskkonna tagamiseks. 4 (4) Kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 Kehtetu - 5 (5) Ohtliku koha ohutusseadmena käsitatakse käesoleva määruse tähenduses seadet, mis paikneb ohutus kohas ja mida kasutatakse ohtlikes kohtades asuvate seadmete ohutuks toimimiseks või mis aitavad tagada ohtlikes kohtades asuvate seadmete ohutut toimimist. Ohtliku koha ohutusseadmena käsitatakse käesoleva määruse tähenduses seadet, mis paikneb ohutus kohas ja mida kasutatakse ohtlikes kohtades asuvate seadmete ohutuks toimimiseks või mis aitavad tagada ohtlikes kohtades asuvate seadmete ohutut toimimist. 6 (6) Kehtetu - RT I 2015-04-08 1 108042015001 2015-07-01 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_156686_Par_2 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_3_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja tagab ohutu töökeskkonna töökohtades, kus esineb või võib tekkida plahvatusohtlik keskkond, rakendades käesolevas määruses ja muudes õigusaktides sätestatud nõudeid. Tööandja tagab ohutu töökeskkonna töökohtades, kus esineb või võib tekkida plahvatusohtlik keskkond, rakendades käesolevas määruses ja muudes õigusaktides sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_156686_Par_3 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_4_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui töökohal töötavad samal ajal vähemalt kahe tööandja töötajad, sõlmivad tööandjad „Töötervishoiu ja tööohutuse seaduse” § 12 lõikes 3 nimetatud kirjaliku kokkuleppe töötervishoiu- ja tööohutusalase ühistegevuse ning iga tööandja vastutuse kohta. Ühistegevust korraldab peatööettevõtja. Kui töökohal töötavad samal ajal vähemalt kahe tööandja töötajad, sõlmivad tööandjad „Töötervishoiu ja tööohutuse seaduse” § 12 lõikes 3 nimetatud kirjaliku kokkuleppe töötervishoiu- ja tööohutusalase ühistegevuse ning iga tööandja vastutuse kohta. Ühistegevust korraldab peatööettevõtja.",
      "rdfs:label": {
        "@value": "Reg_156686_Par_4 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_5_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja korraldab töötaja juhendamise ja väljaõppe töötervishoiu ja tööohutuse seaduses sätestatud korras. RT I 2018-12-05 1 105122018001 2019-01-01 Tööandja korraldab töötaja juhendamise ja väljaõppe töötervishoiu ja tööohutuse seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_156686_Par_5 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_6_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja võtab töö laadi arvestades kasutusele töökorraldusabinõude ja tehnikavahendite süsteemi eesmärgiga: 1 1) ära hoida plahvatusohtliku keskkonna tekkimist või 2 2) ära hoida plahvatusohtliku keskkonna süttimist, kui tegevuse iseloom ei võimalda ära hoida plahvatusohtliku keskkonna tekkimist ja 3 3) leevendada plahvatuse kahjulikke tagajärgi. Tööandja võtab töö laadi arvestades kasutusele töökorraldusabinõude ja tehnikavahendite süsteemi eesmärgiga: ära hoida plahvatusohtliku keskkonna tekkimist või ära hoida plahvatusohtliku keskkonna süttimist, kui tegevuse iseloom ei võimalda ära hoida plahvatusohtliku keskkonna tekkimist ja leevendada plahvatuse kahjulikke tagajärgi.",
      "rdfs:label": {
        "@value": "Reg_156686_Par_6 (redaktsioon 156686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156686",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156686",
      "estleg:sourceAct": "Töötervishoiu ja tööohutuse nõuded töötamisel plahvatusohtlikus keskkonnas",
      "estleg:provisionRef": "Reg_156686 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156686_Par_7_v156686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156686_Par_7"
      },
      "estleg:versionValidFrom": {
