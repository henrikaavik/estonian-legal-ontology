        "@value": "Sätete redaktsioonid: Tee ehitamise ja korrashoiu terminid (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tee ehitamise ja korrashoiu terminid"
    },
    {
      "@id": "estleg:Reg_1030421_Par_1_v1030421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030421_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus täpsustab ehitusseadustikus kasutatud tee ehitamise ja korrashoiu termineid. Käesolev määrus täpsustab ehitusseadustikus kasutatud tee ehitamise ja korrashoiu termineid.",
      "rdfs:label": {
        "@value": "Reg_1030421_Par_1 (redaktsioon 1030421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030421",
      "estleg:sourceAct": "Tee ehitamise ja korrashoiu terminid",
      "estleg:provisionRef": "Reg_1030421 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030421_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030421_Par_2_v1030421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030421_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teehoiuna käsitletakse tee ehitamist, korrashoidu, kavandamist, teekasutuse korraldamist, tee kaitsevööndi hooldamist, tee projekteerimist ning haldamisega seotud muud tegevust. Teehoiuna käsitletakse tee ehitamist, korrashoidu, kavandamist, teekasutuse korraldamist, tee kaitsevööndi hooldamist, tee projekteerimist ning haldamisega seotud muud tegevust.",
      "rdfs:label": {
        "@value": "Reg_1030421_Par_2 (redaktsioon 1030421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030421",
      "estleg:sourceAct": "Tee ehitamise ja korrashoiu terminid",
      "estleg:provisionRef": "Reg_1030421 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030421_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030421_Par_3_v1030421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030421_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tee rajamine on tegevus, mille tulemusena tekib uus tee, sild, viadukt või tunnel. Tee rajamine on tegevus, mille tulemusena tekib uus tee, sild, viadukt või tunnel.",
      "rdfs:label": {
        "@value": "Reg_1030421_Par_3 (redaktsioon 1030421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030421",
      "estleg:sourceAct": "Tee ehitamise ja korrashoiu terminid",
      "estleg:provisionRef": "Reg_1030421 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030421_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030421_Par_4_v1030421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030421_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tee ümberehitamine ehk rekonstrueerimine on tegevus, mille tulemusel muutuvad olemasoleva tee omadused oluliselt. Tee rekonstrueerimisena käsitletakse eelkõige tee kandevõime olulist muutmist, ristmiku tüübi muutmist või silla, viadukti või tunneli kande- või jäigastavate konstruktsioonide muutmist. Tee ümberehitamine ehk rekonstrueerimine on tegevus, mille tulemusel muutuvad olemasoleva tee omadused oluliselt. Tee rekonstrueerimisena käsitletakse eelkõige tee kandevõime olulist muutmist, ristmiku tüübi muutmist või silla, viadukti või tunneli kande- või jäigastavate konstruktsioonide muutmist.",
      "rdfs:label": {
        "@value": "Reg_1030421_Par_4 (redaktsioon 1030421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030421",
      "estleg:sourceAct": "Tee ehitamise ja korrashoiu terminid",
      "estleg:provisionRef": "Reg_1030421 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030421_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030421_Par_5_v1030421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030421_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tee laiendamine on tegevus, mille käigus muudetakse olemasolevat teed sellele juurde- ehk külge ehitamisega. Tee laiendamisena käsitletakse eelkõige tee klassi muutmist ning täiendavate sõiduradade või parkimiskohtade ehitamist. Tee laiendamine on tegevus, mille käigus muudetakse olemasolevat teed sellele juurde- ehk külge ehitamisega. Tee laiendamisena käsitletakse eelkõige tee klassi muutmist ning täiendavate sõiduradade või parkimiskohtade ehitamist.",
      "rdfs:label": {
        "@value": "Reg_1030421_Par_5 (redaktsioon 1030421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030421",
      "estleg:sourceAct": "Tee ehitamise ja korrashoiu terminid",
      "estleg:provisionRef": "Reg_1030421 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030421_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030421_Par_6_v1030421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030421_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tee osa asendamine samaväärsega on tegevus, mille käigus tee kahjustused kõrvaldatakse ja kulunud või kahjustatud osa asendatakse. Tee osa samaväärsega asendamisena käsitletakse eelkõige järgmisi tegevusi: 1 1) kattega teele ühe- ja kahekihilise ülekatte tegemine, kui alumisi kihte ei asendata; 2 2) jalgratta- ja jalgtee, jalgtee, jalgrattatee ja kõnnitee remontimine; 3 3) pindamine; 4 4) pikiroobaste remontimine; 5 5) kruusateede remontimine; 6 6) teepeenarde remontimine; 7 7) veeviimarite remontimine ja vahetamine; 8 8) liikluskorraldusvahendite remont ja vahetamine; 9 9) äärekivide remontimine ja vahetamine; 10 10) tehnovõrkude kaevude asendamine ja remontimine. Tee osa asendamine samaväärsega on tegevus, mille käigus tee kahjustused kõrvaldatakse ja kulunud või kahjustatud osa asendatakse. Tee osa samaväärsega asendamisena käsitletakse eelkõige järgmisi tegevusi: kattega teele ühe- ja kahekihilise ülekatte tegemine, kui alumisi kihte ei asendata; jalgratta- ja jalgtee, jalgtee, jalgrattatee ja kõnnitee remontimine; pindamine; pikiroobaste remontimine; kruusateede remontimine; teepeenarde remontimine; veeviimarite remontimine ja vahetamine; liikluskorraldusvahendite remont ja vahetamine; äärekivide remontimine ja vahetamine; tehnovõrkude kaevude asendamine ja remontimine. 2 (2) Tee osa asendamine samaväärsega on ka need ehitustööd, mida ei käsitleta rajamise, ümberehitamise, laiendamise või lammutamisena ja mis ei avalda olulist mõju ümbritsevale keskkonnale ja oluliselt ei muuda tee omadusi. Tee osa asendamine samaväärsega on ka need ehitustööd, mida ei käsitleta rajamise, ümberehitamise, laiendamise või lammutamisena ja mis ei avalda olulist mõju ümbritsevale keskkonnale ja oluliselt ei muuda tee omadusi.",
      "rdfs:label": {
        "@value": "Reg_1030421_Par_6 (redaktsioon 1030421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030421",
      "estleg:sourceAct": "Tee ehitamise ja korrashoiu terminid",
      "estleg:provisionRef": "Reg_1030421 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030421_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030421_Par_7_v1030421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030421_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tee lammutamine on tegevus, mille tulemusena eemaldatakse teelt vähemalt kogu katend ning tee ei ole enam inimeste, sõidukite või loomade liikumiseks ja liiklemiseks ette nähtud. Tee lammutamine on tegevus, mille tulemusena eemaldatakse teelt vähemalt kogu katend ning tee ei ole enam inimeste, sõidukite või loomade liikumiseks ja liiklemiseks ette nähtud.",
      "rdfs:label": {
        "@value": "Reg_1030421_Par_7 (redaktsioon 1030421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030421",
      "estleg:sourceAct": "Tee ehitamise ja korrashoiu terminid",
      "estleg:provisionRef": "Reg_1030421 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030421_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030421_Par_8_v1030421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030421_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tee korrashoid on tee seisundi vastavuse tagamine ehitusseadustiku § 97 lõike 2 alusel kehtestatud nõuetele. 2019-09-13 14:16:17 Veaparandus - Parandatud ilmne ebatäpsus sõnas „ehitusseadustiku” Riigi Teataja seaduse § 10 lõike 3 alusel. Tee korrashoid on tee seisundi vastavuse tagamine ehitusseadustiku § 97 lõike 2 alusel kehtestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1030421_Par_8 (redaktsioon 1030421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030421",
      "estleg:sourceAct": "Tee ehitamise ja korrashoiu terminid",
      "estleg:provisionRef": "Reg_1030421 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030421_Map_2026"
      }
    },
