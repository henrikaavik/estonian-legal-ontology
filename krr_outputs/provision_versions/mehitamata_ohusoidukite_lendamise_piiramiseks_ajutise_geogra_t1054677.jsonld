  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_mehitamata_ohusoidukite_lendamise_piiramiseks_ajutise_geogra_t1054677_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Mehitamata õhusõidukite lendamise piiramiseks ajutise geograafilise ala kehtestamise, lõpetamise ning sellest teavitamise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Mehitamata õhusõidukite lendamise piiramiseks ajutise geograafilise ala kehtestamise, lõpetamise ning sellest teavitamise kord"
    },
    {
      "@id": "estleg:Reg_1054677_Par_1_v1054677",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054677_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mehitamata õhusõidukite lendamise piiramiseks ajutise geograafilise ala kehtestamisel teeb lennundusseaduse § 41 lõikes 2 nimetatud asutus viivitamatult digitaalses vormis märke mehitamata õhusõiduki liikluskorraldussüsteemi, esitades ala kehtestamise põhjuse, algus- ja lõpuaja, valdaja kontaktandmed ning rõht- ja püstpiirid. Mehitamata õhusõidukite lendamise piiramiseks ajutise geograafilise ala kehtestamisel teeb lennundusseaduse § 41 lõikes 2 nimetatud asutus viivitamatult digitaalses vormis märke mehitamata õhusõiduki liikluskorraldussüsteemi, esitades ala kehtestamise põhjuse, algus- ja lõpuaja, valdaja kontaktandmed ning rõht- ja püstpiirid. 2 (2) Lõikes 1 nimetatud kehtestatava ala algus- ja lõpuaeg ning rõht- ja püstpiirid määratakse ajutise geograafilise ala kehtestamise eesmärgi ulatuses ja viisil, mis piirab võimalikult vähe õhuruumi kasutamist. Lõikes 1 nimetatud kehtestatava ala algus- ja lõpuaeg ning rõht- ja püstpiirid määratakse ajutise geograafilise ala kehtestamise eesmärgi ulatuses ja viisil, mis piirab võimalikult vähe õhuruumi kasutamist. 3 (3) Lõikes 1 nimetatud asutus teavitab viivitamatult pärast mehitamata õhusõiduki liikluskorraldussüsteemis märke tegemist ala kehtestamisest aeronavigatsiooniteenuse osutajat, kes osutab aeronavigatsiooniteabe teenust. Lõikes 1 nimetatud asutus teavitab viivitamatult pärast mehitamata õhusõiduki liikluskorraldussüsteemis märke tegemist ala kehtestamisest aeronavigatsiooniteenuse osutajat, kes osutab aeronavigatsiooniteabe teenust.",
      "rdfs:label": {
        "@value": "Reg_1054677_Par_1 (redaktsioon 1054677)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054677",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054677",
      "estleg:sourceAct": "Mehitamata õhusõidukite lendamise piiramiseks ajutise geograafilise ala kehtestamise, lõpetamise ning sellest teavitamise kord",
      "estleg:provisionRef": "Reg_1054677 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054677_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054677_Par_2_v1054677",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054677_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mehitamata õhusõidukite lendamise piiramiseks kehtestatud ajutise geograafilise ala kehtivus lõppeb selleks märgitud lõpuaja saabumisel või enne lõpuaja saabumist tehtava lõpetamise otsuse alusel. Mehitamata õhusõidukite lendamise piiramiseks kehtestatud ajutise geograafilise ala kehtivus lõppeb selleks märgitud lõpuaja saabumisel või enne lõpuaja saabumist tehtava lõpetamise otsuse alusel. 2 (2) Kui mehitamata õhusõidukite lendamise piiramiseks kehtestatud ajutine geograafiline ala on lõppenud lõpuaja saabumise tõttu, kuid ala kehtestamise põhjus või sündmuse lahendamine ei ole lõppenud ning vajadus ajutise geograafilise ala kehtestamiseks püsib, tuleb ajutine geograafiline ala kehtestada uuesti ning seda vastavalt §-s 1 sätestatud korrale. Kui mehitamata õhusõidukite lendamise piiramiseks kehtestatud ajutine geograafiline ala on lõppenud lõpuaja saabumise tõttu, kuid ala kehtestamise põhjus või sündmuse lahendamine ei ole lõppenud ning vajadus ajutise geograafilise ala kehtestamiseks püsib, tuleb ajutine geograafiline ala kehtestada uuesti ning seda vastavalt §-s 1 sätestatud korrale. 3 (3) Kui mehitamata õhusõidukite lendamise piiramiseks kehtestatud ajutise geograafilise ala kehtestamise põhjus või sündmuse lahendamise vajadus langeb ära enne kehtestatud ala lõpuaega, teeb § 1 lõikes 1 nimetatud asutus lõpetamise otsuse viivitamatult pärast põhjuse äralangemist või sündmuse lahendamise lõppemist. Kui mehitamata õhusõidukite lendamise piiramiseks kehtestatud ajutise geograafilise ala kehtestamise põhjus või sündmuse lahendamise vajadus langeb ära enne kehtestatud ala lõpuaega, teeb § 1 lõikes 1 nimetatud asutus lõpetamise otsuse viivitamatult pärast põhjuse äralangemist või sündmuse lahendamise lõppemist. 4 (4) Lõikes 3 nimetatud juhul teeb § 1 lõikes 1 nimetatud asutus viivitamatult digitaalses vormis ala lõpetamise märke mehitamata õhusõiduki liikluskorraldussüsteemi ja teavitab viivitamatult ala lõpetamisest aeronavigatsiooniteenuse osutajat, kes osutab aeronavigatsiooniteabe teenust. Lõikes 3 nimetatud juhul teeb § 1 lõikes 1 nimetatud asutus viivitamatult digitaalses vormis ala lõpetamise märke mehitamata õhusõiduki liikluskorraldussüsteemi ja teavitab viivitamatult ala lõpetamisest aeronavigatsiooniteenuse osutajat, kes osutab aeronavigatsiooniteabe teenust.",
      "rdfs:label": {
        "@value": "Reg_1054677_Par_2 (redaktsioon 1054677)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054677",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054677",
      "estleg:sourceAct": "Mehitamata õhusõidukite lendamise piiramiseks ajutise geograafilise ala kehtestamise, lõpetamise ning sellest teavitamise kord",
      "estleg:provisionRef": "Reg_1054677 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054677_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054677_Par_3_v1054677",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054677_Par_3"
