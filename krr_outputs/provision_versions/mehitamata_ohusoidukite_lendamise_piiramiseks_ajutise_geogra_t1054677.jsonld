      "estleg:versionValidFrom": {
        "@value": "2022-09-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mehitamata õhusõiduki liikluskorraldussüsteemi valmimiseni avaldab mehitamata õhusõidukite lendamise piiramiseks ajutise geograafilise ala kehtestamist ja lõpetamist puudutava teabe oma kodulehel aeronavigatsiooniteenuse osutaja, kes osutab aeronavigatsiooniteabe teenust. Mehitamata õhusõiduki liikluskorraldussüsteemi valmimiseni avaldab mehitamata õhusõidukite lendamise piiramiseks ajutise geograafilise ala kehtestamist ja lõpetamist puudutava teabe oma kodulehel aeronavigatsiooniteenuse osutaja, kes osutab aeronavigatsiooniteabe teenust.",
      "rdfs:label": {
        "@value": "Reg_1054677_Par_3 (redaktsioon 1054677)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054677",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054677",
      "estleg:sourceAct": "Mehitamata õhusõidukite lendamise piiramiseks ajutise geograafilise ala kehtestamise, lõpetamise ning sellest teavitamise kord",
      "estleg:provisionRef": "Reg_1054677 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054677_Map_2026"
      }
    },
