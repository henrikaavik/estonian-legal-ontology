      "estleg:provisionRef": "Reg_336327 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336327_Map"
      }
    },
    {
      "@id": "estleg:Reg_336327_Par_9_v336327",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
