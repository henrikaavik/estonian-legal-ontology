      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Geodeetilise süsteemi kehtestab määrusega. Vabariigi Valitsus võib geodeetilise süsteemi kehtestamise õiguse anda",
      "rdfs:label": {
