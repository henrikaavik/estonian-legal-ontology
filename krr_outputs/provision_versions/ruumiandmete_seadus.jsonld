      }
    },
    {
      "@id": "estleg:RAS_Par_67_v128022011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti topograafia andmekogu (edaspidi ETAK) on riigi infosüsteemi kuuluv andmekogu, kuhu kantakse üldist tähtsust omavate topograafiliste nähtuste andmed ning andmed, mis kirjeldavad nende nähtuste sisu, suhteid ja konteksti. (2) Andmete uuendamine ETAK-is toimub topograafiliste andmete hõive kaudu. (3) ETAK-isse kogutavate andmete koosseis, vastutav töötleja (haldaja), andmeandjad ja andmete registreerimiseks esitamise korralduslikud küsimused sätestatakse ETAK-i põhimääruses. (4) ETAK-i asutab ja selle põhimääruse",
      "rdfs:label": {
        "@value": "RAS_Par_67 (redaktsioon 128022011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022011002",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAS_Par_67_v108072014026"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128022011002",
      "estleg:sourceAct": "Ruumiandmete seadus",
      "estleg:provisionRef": "RAS § 67",
      "estleg:partOfAct": {
        "@id": "estleg:RAS_Map_2026"
      }
    },
    {
      "@id": "estleg:RAS_Par_67_v108072014026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti topograafia andmekogu (edaspidi ETAK) on riigi infosüsteemi kuuluv andmekogu, kuhu kantakse üldist tähtsust omavate topograafiliste nähtuste andmed ning andmed, mis kirjeldavad nende nähtuste sisu, suhteid ja konteksti. (2) Andmete uuendamine ETAK-is toimub topograafiliste andmete hõive kaudu. (3) ETAK-isse kogutavate andmete koosseis, vastutav töötleja (haldaja), andmeandjad ja andmete registreerimiseks esitamise korralduslikud küsimused sätestatakse ETAK-i põhimääruses. (4) ETAK-i asutab ja selle põhimääruse kehtestab määrusega.",
      "rdfs:label": {
        "@value": "RAS_Par_67 (redaktsioon 108072014026)",
        "@language": "et"
      },
