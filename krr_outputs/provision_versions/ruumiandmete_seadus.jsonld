    {
      "@id": "estleg:RAS_Par_32_v128022011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAS_Par_32"
      },
      "estleg:versionValidFrom": {
