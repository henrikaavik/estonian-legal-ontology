      }
    },
    {
      "@id": "estleg:RAS_Par_36_v105012018004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Geodeetiliste punktide andmekogu (edaspidi GPA) on riigi infosüsteemi kuuluv andmekogu, kuhu kantakse andmed geodeetiliste tööde, geodeetiliste võrkude, geodeetiliste punktide ja märkide kohta, geodeetiliste võrkude mõõtmisandmed ning andmed nende teisenduste kohta. (2) GPA asutab ja selle põhimääruse kehtestab määrusega. (3) GPA vastutav töötleja ja volitatud töötleja määratakse GPA põhimäärusega.",
      "rdfs:label": {
        "@value": "RAS_Par_36 (redaktsioon 105012018004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105012018004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105012018004",
      "estleg:sourceAct": "Ruumiandmete seadus",
      "estleg:provisionRef": "RAS § 36",
