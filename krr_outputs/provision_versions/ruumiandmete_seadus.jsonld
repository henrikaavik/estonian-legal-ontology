    {
      "@id": "estleg:RAS_Par_65_v128022011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Topograafilised nähtused jagunevad oma omaduste ja neid kirjeldavate tunnuste alusel hierarhilistesse klassidesse. (2) Topograafiliste nähtuste klassifikaatori kehtestab klassifikaatori haldaja riigi infosüsteemi kindlustavas klassifikaatorite süsteemis ettenähtud korras. (3) Topograafiliste nähtuste klassifikaatori haldaja on Maa-amet.",
      "rdfs:label": {
        "@value": "RAS_Par_65 (redaktsioon 128022011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022011002",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAS_Par_65_v130122024017"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128022011002",
      "estleg:sourceAct": "Ruumiandmete seadus",
      "estleg:provisionRef": "RAS § 65",
