      },
      "estleg:versionValidTo": {
        "@value": "2019-03-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032014080",
      "estleg:sourceAct": "Ruumiandmete seadus",
      "estleg:provisionRef": "RAS § 1",
      "estleg:partOfAct": {
