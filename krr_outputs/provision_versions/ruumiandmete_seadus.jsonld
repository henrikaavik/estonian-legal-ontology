      }
    },
    {
      "@id": "estleg:RAS_Par_77_v128022011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalve teostamisel käesolevas seaduses sätestatud ruumiandmete töötlemise, ruumiandmekogude haldamise ja ruumiandmeteenuste osutamise seadustele, teistele õigusaktidele ja tehnilistele nõuetele vastavuse üle kohaldatakse avaliku teabe seaduses andmekogude haldamise üle järelevalve kohta sätestatut, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "RAS_Par_77 (redaktsioon 128022011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022011002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128022011002",
      "estleg:sourceAct": "Ruumiandmete seadus",
      "estleg:provisionRef": "RAS § 77",
      "estleg:partOfAct": {
        "@id": "estleg:RAS_Map_2026"
      }
    },
    {
      "@id": "estleg:RAS_Par_78_v128022011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAS_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatud ruumiandmete infrastruktuuri arendamise, ruumiandmekogumite pidamise ja ruumiandmeteenuste osutamise kohta esitavad teabevaldajad aruanded vastavalt Euroopa Komisjoni otsusele nr 2009/442/EÜ, millega rakendatakse Euroopa Parlamendi ja nõukogu direktiivi 2007/2/EÜ seoses järelevalve ja aruannete esitamisega (ELT L 148, 11.06.2009, lk 18–26). (2) Maa-amet koondab teabevaldajatelt saadud andmed ja aruanded, teeb need Eesti geoportaalis avalikkusele kättesaadavaks ning edastab Euroopa Komisjonile. (3) Aruannete esitamise tähtajad, nende koostamise ja ruumiandmete infrastruktuuri rakendamise ning kasutamise jälgimise täpsema korra võib",
      "rdfs:label": {
        "@value": "RAS_Par_78 (redaktsioon 128022011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022011002",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAS_Par_78_v108072014026"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-17",
        "@type": "xsd:date"
      },
