      "dc:source": "Ännikse looduskaitseala kaitse alla võtmine ja kaitse-eeskiri"
    },
    {
      "@id": "estleg:Reg_311342_Par_1_v311342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_311342_Par_1"
