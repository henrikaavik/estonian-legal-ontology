      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded ettevõtte kohta, kus tegeletakse puidust pakkematerjali ning puidu ja muu objekti töötlemise ja vastavusmärgiga märgistamisega ning puidust pakkematerjali parandamisega, ning ettevõtte enesekontrollisüsteemi täpsemad nõuded (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded ettevõtte kohta, kus tegeletakse puidust pakkematerjali ning puidu ja muu objekti töötlemise ja vastavusmärgiga märgistamisega ning puidust pakkematerjali parandamisega, ning ettevõtte enesekontrollisüsteemi täpsemad nõuded"
    },
    {
      "@id": "estleg:Reg_1049899_Par_1_v1049899",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
