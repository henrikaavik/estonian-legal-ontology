      }
    },
    {
      "@id": "estleg:MTRS_Par_17_v715230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registreering on eriseadustes sätestatud ulatuses õigusliku tähendusega. (2) Tegevusloa kohta registrisse kantud andmed on informatiivse tähendusega. (3) Registri kolmanda jao andmed on informatiivse tähendusega. (4) Isik võib tugineda toimingute teostamisel registreeringu õigsusele, juhul kui ta ei teadnud ega pidanudki teadma, et andmed ei ole õiged.",
      "rdfs:label": {
        "@value": "MTRS_Par_17 (redaktsioon 715230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715230",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715230",
      "estleg:sourceAct": "Majandustegevuse registri seadus",
      "estleg:provisionRef": "MTRS § 17",
      "estleg:partOfAct": {
        "@id": "estleg:MTRS_Map"
      }
    },
    {
      "@id": "estleg:MTRS_Par_18_v715230",
