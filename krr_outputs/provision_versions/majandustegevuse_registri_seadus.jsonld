    {
      "@id": "estleg:MTRS_Par_33_v715230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse jõustumisel kujundatakse riiklik erinõuetega tegevusaladel tegutsevate ettevõtjate register ümber majandustegevuse registriks ja riiklikus erinõuetega tegevusaladel tegutsevate ettevõtjate registris olevad andmed loetakse majandustegevuse registri andmeteks.",
      "rdfs:label": {
        "@value": "MTRS_Par_33 (redaktsioon 715230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715230",
