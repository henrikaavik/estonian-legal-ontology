      "estleg:provisionRef": "MTRS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:MTRS_Map"
      }
    },
    {
      "@id": "estleg:MTRS_Par_4_v715230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majandus- ja Kommunikatsiooniministeerium täidab registri vastutava ja volitatud töötlejana õigusaktides sätestatud registripidaja ülesandeid. (2) Registripidaja: tagab registri pidamise vastavalt õigusaktides sätestatud nõuetele; tagab organisatsiooniliste ja tehniliste meetmetega registriandmete terviklikkuse ja autentsuse, registriandmete kaitse, säilimise ning arhiveerimise.",
      "rdfs:label": {
        "@value": "MTRS_Par_4 (redaktsioon 715230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715230",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715230",
      "estleg:sourceAct": "Majandustegevuse registri seadus",
      "estleg:provisionRef": "MTRS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:MTRS_Map"
      }
    },
    {
      "@id": "estleg:MTRS_Par_5_v715230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registriandmed on avalikud, välja arvatud andmed, millele on seadusega kehtestatud juurdepääsupiirangud. (2) Registripidaja tagab juurdepääsu andmetele registri veebilehelt. (3) Arhiivile, registritoimikule ja registreerimismenetlusega seotud dokumentidele võimaldavad registripidaja ja andmete registrisse kandjad juurdepääsu vastavalt avaliku teabe seaduses (RT I 2000, 92, 597; 2002, 61, 375; 63, 387; 2003, 25, 153; 26, 158) sätestatule. (4) Registriandmete ametlikult kinnitatud väljavõtteid väljastavad nii registripidaja kui ka valla- ja linnavalitsus kõigi registrisse kantud andmete osas. Andmete ametlikult kinnitatud väljavõtte väljastamise eest võetakse tasu riigilõivuseaduses (RT I 1997, 80, 1344; 2001, 55, 331; 56, 332; 64, 367; 65, 377; 85, 512; 88, 531; 91, 543; 93, 565; 2002, 1, 1; 18, 97; 23, 131; 24, 135; 27, 151 ja 153; 30, 178; 35, 214; 44, 281; 47, 297; 51, 316; 57, 358; 58, 361; 61, 375; 62, 377; 90, 519; 102, 599; 105, 610; 2003, 4, 20; 13, 68; 15, 84 ja 85; 20, 118; 21, 128; 23, 146; 25, 153 ja 154; 26, 156 ja 160; 30, õiend; 51, 352; 66, 449; 68, 461; 71, 471; 78, 527; 79, 530; 81, 545; 88, 589 ja 591; 2004, 2, 7) sätestatud korras.",
      "rdfs:label": {
        "@value": "MTRS_Par_5 (redaktsioon 715230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715230",
      "estleg:supersededByVersion": {
        "@id": "estleg:MTRS_Par_5_v12766620"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715230",
      "estleg:sourceAct": "Majandustegevuse registri seadus",
      "estleg:provisionRef": "MTRS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:MTRS_Map"
      }
    },
