      }
    },
    {
      "@id": "estleg:MTRS_Par_6_v715230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri koosseisu kuuluvad: ettevõtja ja tema erinõudega tegevusalal tegutsemise andmed; registripäevik; registritoimik; arhiiv. (2) Ettevõtja ja tema erinõudega tegevusalal tegutsemise andmed kantakse registri jagudesse vastavalt käesoleva seaduse §-des 7–9 sätestatule.",
      "rdfs:label": {
        "@value": "MTRS_Par_6 (redaktsioon 715230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715230",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715230",
      "estleg:sourceAct": "Majandustegevuse registri seadus",
      "estleg:provisionRef": "MTRS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:MTRS_Map"
      }
    },
    {
      "@id": "estleg:MTRS_Par_7_v715230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri esimesse jakku kantakse järgmised ettevõtja andmed: nimi; äriregistri, mittetulundusühingute ja sihtasutuste registri, riigi- ja kohaliku omavalitsuse asutuste riikliku registri või maksukohustuslaste registri kood, või isikukood; aadress; sidevahendite andmed; muud seadusega sätestatud andmed. (2) Kui ettevõtja poolt esitatud aadress või sidevahendite andmed erinevad käesoleva paragrahvi lõike 1 punktis 2 nimetatud registrites olevatest andmetest, kajastatakse registris nii taotluses toodud andmed kui vastavas registris olevad andmed. Andmete vahetamine toimub ristkasutuse teel.",
      "rdfs:label": {
        "@value": "MTRS_Par_7 (redaktsioon 715230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715230",
      "estleg:supersededByVersion": {
