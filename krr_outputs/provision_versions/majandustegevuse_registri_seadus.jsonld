      }
    },
    {
      "@id": "estleg:MTRS_Par_34_v715230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2004. aasta 15. aprillil. (2) Käesoleva seaduse § 26 jõustub 2005. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "MTRS_Par_34 (redaktsioon 715230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715230",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715230",
