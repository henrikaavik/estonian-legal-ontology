        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri teise jakku kantakse ettevõtja tegevusala, registreeringu number ja registreerimise kuupäev ning muud andmed seadusega sätestatud ulatuses. (2) Registreeringu tähtajatu peatamise korral kantakse registri teise jakku vastav märge ja registreeringu peatamise kuupäev. Registreeringu tähtajalise peatamise korral lisatakse märkele registreeringu peatamise tähtaeg. (3) Tegevusluba omava ettevõtja kohta kantakse registri teise jakku lisaks käesoleva paragrahvi lõikes 1 sätestatule järgmised tegevusloa andmed: tegevusloa andja; tegevusloa number või tegevusloa andmise otsuse number; tegevusloa kehtivusaeg või tähtajatu tegevusloa korral kehtima hakkamise aeg; muud seadusega sätestatud andmed.",
      "rdfs:label": {
        "@value": "MTRS_Par_8 (redaktsioon 715230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715230",
      "estleg:supersededByVersion": {
        "@id": "estleg:MTRS_Par_8_v12925249"
      },
      "estleg:versionValidTo": {
        "@value": "2008-05-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715230",
      "estleg:sourceAct": "Majandustegevuse registri seadus",
      "estleg:provisionRef": "MTRS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:MTRS_Map"
      }
    },
    {
      "@id": "estleg:MTRS_Par_8_v12925249",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri teise jakku kantakse järgmised andmed: ettevõtja tegevusvaldkond ja tegevusala; registreeringu number ja registreeringu tegemise kuupäev; tähtajalise registreeringu korral tegutsemise alguse- ja lõpukuupäev; muud andmed seaduses sätestatud ulatuses. (2) Käesoleva seaduse § 1 lõikes 2 sätestatud tegevusluba omava ettevõtja kohta kantakse registri teise jakku järgmised andmed: tegevusvaldkond ja tegevusala; tegevusloa andja; tegevusloa number või tegevusloa andmise otsuse number; tegevusloa kehtivusaeg või tähtajatu tegevusloa korral kehtima hakkamise aeg; muud seaduses sätestatud andmed. (3) Registreeringu või tegevusloa peatamise korral kantakse registri teise jakku vastav märge, peatamise põhjus ja peatamise tähtaeg.",
      "rdfs:label": {
        "@value": "MTRS_Par_8 (redaktsioon 12925249)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12925249",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12925249",
      "estleg:sourceAct": "Majandustegevuse registri seadus",
      "estleg:provisionRef": "MTRS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:MTRS_Map"
      }
    },
    {
      "@id": "estleg:MTRS_Par_9_v715230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri kolmandasse jakku kantakse seadusega sätestatud juhtudel ja korras erinõudega tegevusalal tegutsemisega seonduva ettekirjutuse andmed, milleks on ettekirjutuse teinud asutuse nimi, ettekirjutuse sisu ja õiguslik alus ning ettekirjutuse tegemise aeg. (2) Teave ettekirjutuse kohta kantakse registrisse viivitamata, kuid mitte hiljem kui viie tööpäeva jooksul ettekirjutuse tegemisest arvates. Andmete registrisse kandja kustutab ettekirjutuse andmed viivitamata, kuid mitte hiljem kui viie tööpäeva jooksul, ettekirjutuse täitmisest teada saamisest või ettekirjutuse kehtetuks tunnistamisest arvates. (3) Registri kolmandasse jakku esitavad ja kannavad andmeid järelevalvet teostavad asutused vastavalt oma pädevusele.",
      "rdfs:label": {
        "@value": "MTRS_Par_9 (redaktsioon 715230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715230",
      "estleg:supersededByVersion": {
        "@id": "estleg:MTRS_Par_9_v12925249"
      },
      "estleg:versionValidTo": {
        "@value": "2008-05-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/715230",
      "estleg:sourceAct": "Majandustegevuse registri seadus",
      "estleg:provisionRef": "MTRS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:MTRS_Map"
      }
    },
    {
      "@id": "estleg:MTRS_Par_9_v12925249",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTRS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri kolmandasse jakku kantakse ettevõtja registris märgitud tegevusalal tegutsemisega seonduva ettekirjutuse andmed, milleks on ettekirjutuse teinud asutuse nimi, ettekirjutuse sisu ja õiguslik alus, ettekirjutuse tegemise aeg, ettekirjutuse täitmise tähtaeg ning andmed ettekirjutuse täitmise kohta. (2) Teave ettekirjutuse kohta kantakse registrisse viivitamata, kuid mitte hiljem kui viie tööpäeva jooksul ettekirjutuse tegemisest arvates. Andmete registrisse kandja kustutab ettekirjutuse andmed viivitamata, kuid mitte hiljem kui viie tööpäeva jooksul, ettekirjutuse täitmisest teada saamisest või ettekirjutuse kehtetuks tunnistamisest arvates. (3) Registri kolmandasse jakku kannavad andmeid järelevalvet teostavad asutused vastavalt oma pädevusele.",
      "rdfs:label": {
        "@value": "MTRS_Par_9 (redaktsioon 12925249)",
        "@language": "et"
      },
