      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kauba või teenuse harilikust väärtusest madalama hinnaga võõrandamiseks maksukohustuslasele antava sihtotstarbelise toetuse maksustatava väärtuse hulka arvamise ja maksustamise kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kauba või teenuse harilikust väärtusest madalama hinnaga võõrandamiseks maksukohustuslasele antava sihtotstarbelise toetuse maksustatava väärtuse hulka arvamise ja maksustamise kord"
    },
    {
      "@id": "estleg:Reg_157362_Par_1_v157362",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157362_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtotstarbeline toetus arvatakse kauba või teenuse maksustatava väärtuse hulka juhul, kui see antakse maksukohustuslasele kauba või teenuse müügihinna alandamiseks. Sihtotstarbeline toetus arvatakse kauba või teenuse maksustatava väärtuse hulka juhul, kui see antakse maksukohustuslasele kauba või teenuse müügihinna alandamiseks. Sihtotstarbeline toetus, mis on ette nähtud riigi-, valla- või linnaeelarves, arvatakse kauba või teenuse maksustatava väärtuse hulka üksnes juhul, kui toetuse andmine on ette nähtud konkreetsele isikule konkreetse kauba või teenuse müügihinna alandamiseks. Sihtotstarbeline toetus, mis on ette nähtud riigi-, valla- või linnaeelarves, arvatakse kauba või teenuse maksustatava väärtuse hulka üksnes juhul, kui toetuse andmine on ette nähtud konkreetsele isikule konkreetse kauba või teenuse müügihinna alandamiseks.",
      "rdfs:label": {
        "@value": "Reg_157362_Par_1 (redaktsioon 157362)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157362",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157362",
      "estleg:sourceAct": "Kauba või teenuse harilikust väärtusest madalama hinnaga võõrandamiseks maksukohustuslasele antava sihtotstarbelise toetuse maksustatava väärtuse hulka arvamise ja maksustamise kord",
      "estleg:provisionRef": "Reg_157362 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157362_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157362_Par_2_v157362",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157362_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtotstarbelise toetuse saaja poolt tasumisele kuuluva käibemaksusumma arvutamisel arvutab maksukohustuslane käibemaksu eraldi kauba või teenuse tegelikult käibemaksuta müügihinnalt ja sihtotstarbelise toetusena laekunud rahasummalt. Sihtotstarbelise toetuse saaja poolt tasumisele kuuluva käibemaksusumma arvutamisel arvutab maksukohustuslane käibemaksu eraldi kauba või teenuse tegelikult käibemaksuta müügihinnalt ja sihtotstarbelise toetusena laekunud rahasummalt. 2 (2) Sihtotstarbelise toetusena laekunud rahasummalt käibemaksu arvutamisel lähtutakse sellest, et toetusena laekunud summa sisaldab käibemaksu. RT I 2024-11-12 1 112112024001 2025-01-01 Sihtotstarbelise toetusena laekunud rahasummalt käibemaksu arvutamisel lähtutakse sellest, et toetusena laekunud summa sisaldab käibemaksu. 3 (3) Sihtotstarbelise toetusena laekunud rahasummalt kuulub käibemaks tasumisele koos kauba või teenuse tegelikult käibemaksuta müügihinnalt arvutatud käibemaksuga vastavalt «Käibemaksuseaduses» sätestatud käibemaksu tasumise ajale. Sihtotstarbelise toetusena laekunud rahasummalt kuulub käibemaks tasumisele koos kauba või teenuse tegelikult käibemaksuta müügihinnalt arvutatud käibemaksuga vastavalt «Käibemaksuseaduses» sätestatud käibemaksu tasumise ajale.",
