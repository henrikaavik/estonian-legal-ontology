        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete täitmise üle teostab Keskkonnainspektsioon.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_47 (redaktsioon 114032014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014032",
