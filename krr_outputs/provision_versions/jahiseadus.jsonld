      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahipiirkonna kasutusõiguse tasu makstakse keskkonnatasude seaduse ja selle alusel kehtestatud õigusaktide järgi.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_48 (redaktsioon 922135)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922135",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_48_v116052013002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-06-01",
