      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jahiloa andmise, tagastamise või jahiloale kantud andmete arvestuse nõuete rikkumise eest –karistatakse rahatrahviga kuni 100 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_60 (redaktsioon 116052013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013002"
    },
