      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_54_v13340861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_54 (redaktsioon 13340861)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13340861",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_54_v116052013002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_54_v116052013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahipidamise eest jahikoeraga, kellel puudub jahikoerapass või muu jahikoera tõugu tõendav dokument, –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_54 (redaktsioon 116052013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013002"
    },
    {
      "@id": "estleg:Jahiseadus_Par_55_v256160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalvet käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete täitmise üle teostavad keskkonnakaitseinspektorid ja seaduses nimetatud teised ametiisikud. (2) Jahipiirkonna kasutaja on kohustatud kontrollima jahipidamise nõuetest kinnipidamist temalt jahiloa saanud isikute poolt.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_55 (redaktsioon 256160)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256160",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_55_v116052013002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_55_v116052013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahikoera katsetamise või õpetamise eest keelatud ajal või ilma asjaomase loata –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_55 (redaktsioon 116052013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013002"
    },
    {
      "@id": "estleg:Jahiseadus_Par_56_v256160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahiuluki ebaseadusliku hukkamise või jahiuluki elupaiga hävitamise või kahjustamisega keskkonnale tekitatud kahju määrad kehtestab Vabariigi Valitsus määrusega.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_56 (redaktsioon 256160)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256160",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_56_v922135"
      },
      "estleg:versionValidTo": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_56_v922135",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahiuluki ebaseadusliku hukkamise või jahiuluki elupaiga hävitamise või kahjustamisega keskkonnale tekitatud kahju määrad s määrusega.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_56 (redaktsioon 922135)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922135",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_56_v13340861"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_56_v13340861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahiuluki ebaseadusliku hukkamise või jahiuluki elupaiga hävitamise või kahjustamisega keskkonnale tekitatud kahju määrad",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_56 (redaktsioon 13340861)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13340861",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_56_v116052013002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_56_v116052013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahitunnistuse, jahiloa, suuruluki laskekatse tunnistuse, vibujahi laskekatse tunnistuse, jahist osavõtjate nimekirja, jahikoerapassi või muu jahikoera tõugu tõendava dokumendi jahipidamisel kaasasoleku nõude rikkumise eest –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_56 (redaktsioon 116052013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013002"
    },
    {
      "@id": "estleg:Jahiseadus_Par_57_v256160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keelatud vahenditega või viisil või keelatud kohas jahipidamise või jahipidamise ohutusnõuete eiramise eest – karistatakse rahatrahviga kuni 200 trahviühikut. (2) Käesoleva paragrahvi lõikes 1 nimetatud rikkumistega jahipidamise korraldamise eest juriidilise isiku poolt – karistatakse rahatrahviga kuni 40 000 krooni.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_57 (redaktsioon 256160)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256160",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_57_v873276"
      },
      "estleg:versionValidTo": {
        "@value": "2005-04-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_57_v873276",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keelatud vahendiga või viisil või keelatud kohas jahipidamise eest – karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_57 (redaktsioon 873276)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "873276",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_57_v13340292"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_57_v13340292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
