      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jahiulukite loata tehistingimustes hoidmise või loodusesse viimise eest, kui luba oli nõutav, –karistatakse rahatrahviga kuni 200 trahviühikut. (2) Sama tegevuse eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_60 (redaktsioon 13340861)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13340861",
