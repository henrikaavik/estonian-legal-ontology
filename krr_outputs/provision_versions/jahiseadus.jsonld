      },
      "estleg:versionValidTo": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_71_v114032014032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_71"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_71 (redaktsioon 114032014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014032"
    },
    {
      "@id": "estleg:Jahiseadus_Par_72_v116052013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
