      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_47_v110072020091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete täitmise üle teostab Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_47 (redaktsioon 110072020091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020091"
    },
    {
      "@id": "estleg:Jahiseadus_Par_47_1_v114032014032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_47_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnainspektsioon võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 45, 46, 47, 49, 50, 51, 52 ja 53 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_47_1 (redaktsioon 114032014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014032",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_47_1_v110072020091"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_47_1_v110072020091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_47_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaamet võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 45, 46, 47, 49, 50, 51, 52 ja 53 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_47_1 (redaktsioon 110072020091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020091"
    },
    {
      "@id": "estleg:Jahiseadus_Par_47_2_v114032014032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_47_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnainspektsioon võib jahipidamiseks kasutatavate püüniste läbivaatust teostada ilma korrakaitseseaduse § 49 lõikes 2 nimetatud isiku juuresolekuta. (2) Tähistatud kinnisasjale võib Keskkonnainspektsioon siseneda valdaja või muu õigustatud isiku juuresolekuta, kui: see on vajalik olulise ohu väljaselgitamiseks või tõrjumiseks ja nimetatud isikute kaasamisega kaasneks viivitus, mis seaks ohtu meetme kohaldamise eesmärgi saavutamise, või valdusesse sisenemise eesmärk on läbipääsu tagamine teisele kinnisasjale või veekogule. (3) Käesoleva paragrahvi lõike 2 punktis 2 sätestatud alusel valdusesse sisenemisest ei pea Keskkonnainspektsioon hiljem valdajat teavitama, kui valduses ei viidud pärast sisenemist läbi järelevalve- või süüteomenetluse toiminguid. (4) Keskkonnainspektsioonil on korrakaitseseaduse §-s 52 sätestatud korras õigus eemaldada paiknemiskohast ja võtta vallasasjana hoiule jahipidamisvahend, mis peab olema õigusaktist tulenevalt selle omaniku kindlakstegemist võimaldaval viisil märgistatud, kuid millel märgistus puudub või see ei võimalda kuuluvust tuvastada. Jahipidamisvahendiga samas paiknemiskohas olev jahisaadus võetakse hoiule koos jahipidamisvahendiga. (5) Keskkonnainspektsiooni ametnik võib järelevalve teostamise eesmärgil viibida ja liikuda sõidukiga, sealhulgas maastikusõidukiga ja ujuvvahendiga, maa- või veealal, kus viibimine ja liikumine on keskkonnakaitse eesmärgil õigusaktiga keelatud või piiratud.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_47_2 (redaktsioon 114032014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014032",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_47_2_v110072020091"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_47_2_v110072020091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_47_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnaamet võib jahipidamiseks kasutatavate püüniste läbivaatust teostada ilma korrakaitseseaduse § 49 lõikes 2 nimetatud isiku juuresolekuta. (2) Tähistatud kinnisasjale võib Keskkonnaamet siseneda valdaja või muu õigustatud isiku juuresolekuta, kui: see on vajalik olulise ohu väljaselgitamiseks või tõrjumiseks ja nimetatud isikute kaasamisega kaasneks viivitus, mis seaks ohtu meetme kohaldamise eesmärgi saavutamise, või valdusesse sisenemise eesmärk on läbipääsu tagamine teisele kinnisasjale või veekogule. (3) Käesoleva paragrahvi lõike 2 punktis 2 sätestatud alusel valdusesse sisenemisest ei pea Keskkonnaamet hiljem valdajat teavitama, kui valduses ei viidud pärast sisenemist läbi järelevalve- või süüteomenetluse toiminguid. (4) Keskkonnaametil on korrakaitseseaduse §-s 52 sätestatud korras õigus eemaldada paiknemiskohast ja võtta vallasasjana hoiule jahipidamisvahend, mis peab olema õigusaktist tulenevalt selle omaniku kindlakstegemist võimaldaval viisil märgistatud, kuid millel märgistus puudub või see ei võimalda kuuluvust tuvastada. Jahipidamisvahendiga samas paiknemiskohas olev jahisaadus võetakse hoiule koos jahipidamisvahendiga. (5) Keskkonnaameti ametnik võib järelevalve teostamise eesmärgil viibida ja liikuda sõidukiga, sealhulgas maastikusõidukiga ja ujuvvahendiga, maa- või veealal, kus viibimine ja liikumine on keskkonnakaitse eesmärgil õigusaktiga keelatud või piiratud.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_47_2 (redaktsioon 110072020091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020091"
    },
    {
      "@id": "estleg:Jahiseadus_Par_47_3_v114032014032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_47_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnainspektsioonil on lubatud kasutada füüsilist jõudu, erivahendeid ja teenistusrelvi korrakaitseseaduses sätestatud alusel ja korras. (2) Keskkonnainspektsiooni erivahendid on käerauad. (3) Keskkonnainspektsiooni teenistusrelvad on tulirelvad.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_47_3 (redaktsioon 114032014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014032",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_47_3_v110072020091"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_47_3_v110072020091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_47_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnaametil on lubatud kasutada füüsilist jõudu, erivahendeid ja teenistusrelvi korrakaitseseaduses sätestatud alusel ja korras. (2) Keskkonnaameti erivahendid on käerauad. (3) Keskkonnaameti teenistusrelvad on tulirelvad.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_47_3 (redaktsioon 110072020091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020091"
    },
    {
      "@id": "estleg:Jahiseadus_Par_47_4_v114032014032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_47_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär 32 000 eurot.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_47_4 (redaktsioon 114032014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014032"
    },
    {
      "@id": "estleg:Jahiseadus_Par_48_v256160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jahipiirkonna kasutamise eest peab jahipiirkonna kasutaja maksma riigieelarvesse jahipiirkonna kasutusõiguse tasu. (2) Jahipiirkonna kasutusõiguse tasu suuruse jahiulukile sobiva elupaiga kvaliteediklasside kaupa kehtestab keskkonnaminister määrusega. (3) Jahipiirkonna kasutusõiguse tasu arvutamisel lähtutakse jahiulukile sobiva elupaiga pindalast ja kvaliteedist. (4) Jahipiirkonna ühe aasta kasutusõiguse tasu suurus kantakse jahipiirkonna kasutusõiguse loale. Kui keskkonnaminister on muutnud tasu arvutamise aluseid, teavitab loa andja tasu uuest suurusest loa saanud isikut kirjalikult. (5) Jahipiirkonna kasutamise eest makstava tasu maksetähtaegadest kinnipidamist kontrollib kasutusõiguse loa andja. (6) Aastaks määratud tasu jahipiirkonna kasutusõiguse eest tuleb maksta riigieelarvesse jooksva aasta 25. aprilliks. (7) Tähtajaks maksmata jahipiirkonna kasutusõiguse tasu nõutakse sisse tsiviilkohtumenetluse seadustikus (RT I 1998, 43–45, 666; 108/109, 1783; 1999, 16, 271; 31, 425; 2000, 51, 319; 55, 365; 2001, 21, 113; 34, 186; 53, 313; 93, 565; 2002, 29, 174) sätestatud korras.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_48 (redaktsioon 256160)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256160",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_48_v873276"
      },
      "estleg:versionValidTo": {
        "@value": "2005-04-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_48_v873276",
