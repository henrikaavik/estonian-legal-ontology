      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_51_v130122011007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jahisaadus käesoleva seaduse tähenduses on: surmatud jahiuluk; tehiskeskkonda viidud jahiuluk; surmatud jahiuluki liha, nahk või muu toore või sellest valmistatud tooted. (2) Jahisaadus kuulub jahiloa saanud isikule, kui jahipidamise heade tavade või jahist osavõtnud isikute ja jahipiirkonna kasutaja vahelise kokkuleppe alusel ei toimita teisiti. (3) Jahimaadel surnuna leitud või liiklusõnnetuses hukkunud või liiklusõnnetuse tõttu hukatud suurulukist või selle osadest tuleb kohe teavitada Häirekeskust. (4) Käesoleva paragrahvi lõikes 3 nimetatud suuruluk või selle osad kuuluvad jahipiirkonna kasutajale, kes tarbimisväärtust mitteomava surnud suuruluki hävitab või matab kohapeal. (5) Tehiskeskkonda viidud jahiuluki ristamine muu loomaga on keelatud.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_51 (redaktsioon 130122011007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011007",
