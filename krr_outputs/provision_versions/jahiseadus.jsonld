        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jahipidamisõigus on füüsilise isiku õigus jahti pidada, kui tal on jahipidamisõigust tõendavad dokumendid ning ta on tasunud jahipidamisõiguse tasu. (2) Jahipidamisõiguse eest makstakse tasu kord aastas keskkonnatasude seaduse ja selle alusel kehtestatud õigusaktide järgi.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_7 (redaktsioon 116052013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013002"
    },
    {
      "@id": "estleg:Jahiseadus_Par_71_v116052013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_71"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivuseaduses tehakse järgmised muudatused:",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_71 (redaktsioon 116052013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013002",
      "estleg:supersededByVersion": {
