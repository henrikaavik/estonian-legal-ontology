      },
      "estleg:versionValidTo": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_33_v110072020091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ilmsete marutauditunnustega uluki võib surmata jahiloata. (2) Surmatud marutauditunnustega ulukist tuleb viivitamata teatada piirkonda teenindavale volitatud veterinaararstile või järelevalveametnikule. Kui marutauditunnustega uluki hukkamiseks puudus jahiluba, tuleb viivitamata informeerida ka Keskkonnaametit.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_33 (redaktsioon 110072020091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020091",
