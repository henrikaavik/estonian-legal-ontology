    },
    {
      "@id": "estleg:Jahiseadus_Par_48_v116052013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uluki ebaseadusliku hukkamise ning uluki elupaiga hävitamise ja kahjustamisega keskkonnale tekitatud kahju arvestamise alused ja kahjumäärad uluki liikide kaupa määrusega, arvestades, et: uluki ebaseadusliku hukkamisega keskkonnale tekitatud kahju ülemmäär on 2000 eurot ja alammäär 3 eurot; uluki elupaiga hävitamise ja kahjustamisega keskkonnale tekitatud kahju ülemmäär on 96 eurot.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_48 (redaktsioon 116052013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013002",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_48_v123122014022"
      },
      "estleg:versionValidTo": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_48_v123122014022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uluki ebaseadusliku hukkamise ning uluki elupaiga hävitamise ja kahjustamisega keskkonnale tekitatud kahju arvestamise alused ja kahjumäärad uluki liikide kaupa kehtestab määrusega, arvestades, et: uluki ebaseadusliku hukkamisega keskkonnale tekitatud kahju ülemmäär on 2000 eurot ja alammäär 3 eurot; uluki elupaiga hävitamise ja kahjustamisega keskkonnale tekitatud kahju ülemmäär on 96 eurot.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_48 (redaktsioon 123122014022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014022"
    },
    {
      "@id": "estleg:Jahiseadus_Par_49_v256160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahipiirkonda jääval kinnistul võib selle omanik või tema abikaasa või laps jahti pidada tasuta.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_49 (redaktsioon 256160)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256160",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_49_v873276"
      },
      "estleg:versionValidTo": {
        "@value": "2005-04-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_49_v873276",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahipiirkonda jääval kinnistul võivad selle omanik, tema vanemad, abikaasa või lapsed jahti pidada tasuta.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_49 (redaktsioon 873276)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "873276",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_49_v116052013002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_49_v116052013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahitunnistuseta jahipidamise eest –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_49 (redaktsioon 116052013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013002"
    },
    {
      "@id": "estleg:Jahiseadus_Par_5_v256160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jahimaa on jahiulukite vabaks elamiseks sobiv ja jahipidamiseks kasutatav ala. (2) Jahimaa hulka ei kuulu: maakonnaplaneeringuga määratud tiheasustus- või puhkeala, kus ohutu jahipidamine ei ole võimalik; kaitseala vöönd, kus jahipidamine on seaduse või kaitse-eeskirjaga keelatud.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_5 (redaktsioon 256160)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256160",
      "estleg:supersededByVersion": {
        "@id": "estleg:Jahiseadus_Par_5_v116052013002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Jahiseadus_Par_5_v116052013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahipiirkond on suurulukijahi pidamiseks moodustatud ala, mille jahimaa pindala ühes ringpiiris on vähemalt 5000 hektarit.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_5 (redaktsioon 116052013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013002"
    },
    {
      "@id": "estleg:Jahiseadus_Par_50_v256160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jahipiirkonna kasutusõiguse tasu kasutatakse jahiulukivaru taastootmiseks ja seisundi jälgimiseks, jahindusalaseks koolituseks, infovahetuseks, jahindusalaseks uurimistööks ja jahimaade korraldamiseks. (2) Jahipiirkonna kasutusõiguse tasu kasutatakse keskkonnakasutusest laekuva raha kasutamise seaduse (RT I 1999, 54, 583; 101, 905) ja selle alusel kehtestatud õigusaktides sätestatud korras.",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_50 (redaktsioon 256160)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256160",
      "estleg:supersededByVersion": {
