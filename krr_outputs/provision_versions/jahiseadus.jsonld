      ],
      "estleg:versionOf": {
        "@id": "estleg:Jahiseadus_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Jahiseadus_Par_54 (redaktsioon 12766181)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12766181",
