    {
      "@id": "estleg:Reg_1057292_Par_22_v1057292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057292_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse saaja ja partnerid kohustuvad kompleksjuhtumite lahendamisel: 1 1) tegema koostööd § 3 lõike 3 punktides 1 ja 2 nimetatud väljundnäitajate saavutamiseks; 2 2) määrama igale määruse lisas 3 nimetatud üksikjuhtumite lahendamisega seotud ülesandele täitja ametikoha täpsusega ning tagama ülesannete lahendamise; 3 3) korraldama kompleksse abivajadusega inimese abistamise juhtumikorralduse põhimõttel, lähtudes juhtumiplaanist vastavalt sotsiaalhoolekande seaduse §-le 9; 4 4) tagama projektis osalenud kompleksse abivajadusega inimestelt tagasiside kogumise ja analüüsimise; 5 5) vältima kompleksse abivajadusega inimeste abistamisel ebavõrdset kohtlemist soo, rahvuse või rassi, puude, seksuaalse sättumuse või veendumuse tõttu ja tagama ligipääsetavuse. Toetuse saaja ja partnerid kohustuvad kompleksjuhtumite lahendamisel: tegema koostööd § 3 lõike 3 punktides 1 ja 2 nimetatud väljundnäitajate saavutamiseks; määrama igale määruse lisas 3 nimetatud üksikjuhtumite lahendamisega seotud ülesandele täitja ametikoha täpsusega ning tagama ülesannete lahendamise; korraldama kompleksse abivajadusega inimese abistamise juhtumikorralduse põhimõttel, lähtudes juhtumiplaanist vastavalt sotsiaalhoolekande seaduse §-le 9; tagama projektis osalenud kompleksse abivajadusega inimestelt tagasiside kogumise ja analüüsimise; vältima kompleksse abivajadusega inimeste abistamisel ebavõrdset kohtlemist soo, rahvuse või rassi, puude, seksuaalse sättumuse või veendumuse tõttu ja tagama ligipääsetavuse.",
      "rdfs:label": {
        "@value": "Reg_1057292_Par_22 (redaktsioon 1057292)",
        "@language": "et"
      },
