    {
      "@id": "estleg:Reg_1057292_Par_20_v1057292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057292_Par_20"
