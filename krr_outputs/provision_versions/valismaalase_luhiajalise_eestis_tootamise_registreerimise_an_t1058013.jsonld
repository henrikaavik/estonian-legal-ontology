    {
      "@id": "estleg:Reg_1058013_Par_16_v1058013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058013_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vastutav töötleja väljastab: 1 1) andmesubjektile või tema seaduslikule esindajale andmesubjekti isikuandmeid; 2 2) andmeandjale tema kirjaliku taotluse alusel andmeid, mille andmeandja on andmekogusse esitanud; 3 3) kolmandale isikule kirjaliku taotluse alusel andmeid, mille väljastamiseks on seaduses sätestatud alus. Vastutav töötleja väljastab: andmesubjektile või tema seaduslikule esindajale andmesubjekti isikuandmeid; andmeandjale tema kirjaliku taotluse alusel andmeid, mille andmeandja on andmekogusse esitanud; kolmandale isikule kirjaliku taotluse alusel andmeid, mille väljastamiseks on seaduses sätestatud alus. 2 (2) Andmekogu andmeid väljastatakse tasuta. Andmekogu andmeid väljastatakse tasuta.",
      "rdfs:label": {
        "@value": "Reg_1058013_Par_16 (redaktsioon 1058013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058013",
      "estleg:sourceAct": "Välismaalase lühiajalise Eestis töötamise registreerimise andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1058013 § 16",
      "estleg:partOfAct": {
