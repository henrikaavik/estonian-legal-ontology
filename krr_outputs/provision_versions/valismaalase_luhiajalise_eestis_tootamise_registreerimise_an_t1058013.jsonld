      }
    },
    {
      "@id": "estleg:Reg_1058013_Par_17_v1058013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058013_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu andmete töötlemine logitakse. Andmekogu andmete töötlemine logitakse. 2 (2) Vastutav töötleja säilitab andmekogu andmete töötlemise kohta vähemalt järgmised logiandmed: 1 1) toimingu tegija tuvastamist võimaldavad andmed; 2 2) toimingu tegemise kuupäev ja kellaaeg; 3 3) toimingu liik. Vastutav töötleja säilitab andmekogu andmete töötlemise kohta vähemalt järgmised logiandmed: toimingu tegija tuvastamist võimaldavad andmed; toimingu tegemise kuupäev ja kellaaeg; toimingu liik. 3 (3) Logiandmeid säilitatakse kümme aastat toimingu tegemisest arvates. Logiandmeid säilitatakse kümme aastat toimingu tegemisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1058013_Par_17 (redaktsioon 1058013)",
        "@language": "et"
      },
