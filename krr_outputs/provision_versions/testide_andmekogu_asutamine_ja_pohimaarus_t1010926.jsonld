      "estleg:provisionRef": "Reg_1010926 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1010926_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1010926_Par_8_v1010926",
      "@type": [
