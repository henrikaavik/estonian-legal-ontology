      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täiendava otsetoetuse toetusõigust pärima õigustatud isik esitab PRIA-le elektrooniliselt pärimist tõendavad dokumendid PRIA e-teenuse keskkonna kaudu hiljemalt koos asjakohase üleminekutoetuse taotlusega. Täiendava otsetoetuse toetusõigust pärima õigustatud isik esitab PRIA-le elektrooniliselt pärimist tõendavad dokumendid PRIA e-teenuse keskkonna kaudu hiljemalt koos asjakohase üleminekutoetuse taotlusega.",
      "rdfs:label": {
        "@value": "Reg_1041119_Par_2 (redaktsioon 1041119)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041119",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041119",
      "estleg:sourceAct": "Täiendava otsetoetuse toetusõiguse üleandmisest teavitamine",
      "estleg:provisionRef": "Reg_1041119 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041119_Map"
      }
    },
    {
