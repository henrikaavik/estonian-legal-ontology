      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Täiendava otsetoetuse toetusõiguse üleandmisest teavitamine (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Täiendava otsetoetuse toetusõiguse üleandmisest teavitamine"
    },
    {
      "@id": "estleg:Reg_1041119_Par_1_v1041119",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041119_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isik, kes on omandanud täiendava otsetoetuse toetusõiguse (edaspidi toetusõigus) võõrandamise teel, esitab võõrandamiskokkuleppe kohta teate Põllumajanduse Registrite ja Informatsiooni Ametile (edaspidi PRIA) elektrooniliselt PRIA e-teenuse keskkonna kaudu hiljemalt koos asjakohase üleminekutoetuse taotlusega. Isik, kes on omandanud täiendava otsetoetuse toetusõiguse (edaspidi toetusõigus) võõrandamise teel, esitab võõrandamiskokkuleppe kohta teate Põllumajanduse Registrite ja Informatsiooni Ametile (edaspidi PRIA) elektrooniliselt PRIA e-teenuse keskkonna kaudu hiljemalt koos asjakohase üleminekutoetuse taotlusega. 2 (2) Lõikes 1 nimetatud teade sisaldab järgmiseid andmeid: 1 1) toetusõiguse üleandja nimi ja registri- või isikukood; 2 2) toetusõiguse ülevõtja nimi ja registri- või isikukood; 3 3) üleantava toetusõiguse nimetus; 4 4) üleantavate toetusõiguste arv; 5 5) toetusõiguse üleandja ja ülevõtja kinnitus toetusõiguse üleandmise kohta. Lõikes 1 nimetatud teade sisaldab järgmiseid andmeid: toetusõiguse üleandja nimi ja registri- või isikukood; toetusõiguse ülevõtja nimi ja registri- või isikukood; üleantava toetusõiguse nimetus; üleantavate toetusõiguste arv; toetusõiguse üleandja ja ülevõtja kinnitus toetusõiguse üleandmise kohta.",
      "rdfs:label": {
        "@value": "Reg_1041119_Par_1 (redaktsioon 1041119)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041119",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041119",
      "estleg:sourceAct": "Täiendava otsetoetuse toetusõiguse üleandmisest teavitamine",
      "estleg:provisionRef": "Reg_1041119 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041119_Map"
      }
    },
    {
      "@id": "estleg:Reg_1041119_Par_2_v1041119",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
