      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda (COTIF, edaspidi konventsioon), mis on koostatud 1980. aasta 9. mail Bernis ja mida on muudetud 1999. aasta 3. juunil Vilniuses koostatud protokolliga.",
      "rdfs:label": {
        "@value": "RRKU_Par_1 (redaktsioon 12989243)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12989243"
    },
    {
      "@id": "estleg:RRKU_Par_2_v740577",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKU_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konventsiooni artikli 27 alusel teeb Eesti Vabariik järgmise reservatsiooni:konventsiooni lisa A «Reisijate ja pagasi rahvusvahelise raudteeveo lepingu ühtsed reeglid» (CIV) artikli 3 lõike 1 alusel kasutab Eesti Vabariik õigust kohaldada osaliselt sätteid, mis käsitlevad raudtee-ettevõtja vastutust Eesti territooriumil toimunud õnnetusjuhtumis kannatanud reisija surma või vigastuste korral, kui nimetatud reisija on Eesti Vabariigi kodanik või kui reisija alaline elukoht on Eesti Vabariigis.",
      "rdfs:label": {
        "@value": "RRKU_Par_2 (redaktsioon 740577)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740577",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKU_Par_2_v12989243"
      },
      "estleg:versionValidTo": {
        "@value": "2008-07-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKU_Par_2_v12989243",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKU_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kooskõlas konventsiooni artikliga 42 teeb Eesti Vabariik järgmised reservatsioonid: konventsiooni lisa A «Reisijate rahvusvahelise raudteeveo lepingu ühtsed eeskirjad» (CIV) artikli 2 lõike 1 alusel kasutab Eesti Vabariik õigust jätta kohaldamata lisa A artikkel 30, milles käsitletakse raudtee-ettevõtja vastutust Eesti territooriumil toimunud õnnetusjuhtumis kannatanud reisija surma või vigastuste korral, kui nimetatud reisija on Eesti Vabariigi kodanik või kui reisija alaline elukoht on Eesti Vabariigis; Eesti Vabariik ei kohalda konventsiooni lisasid E, F ja G.",
      "rdfs:label": {
        "@value": "RRKU_Par_2 (redaktsioon 12989243)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12989243",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKU_Par_2_v204042012003"
      },
      "estleg:versionValidTo": {
        "@value": "2012-04-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKU_Par_2_v204042012003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKU_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RRKU_Par_2 (redaktsioon 204042012003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "204042012003"
    },
    {
      "@id": "estleg:RRKU_Par_3_v740577",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariik teeb järgmised deklaratsioonid: konventsiooni artiklite 3 ja 10 kohaselt kohaldab Eesti Vabariik konventsiooni lisa A «Reisijate ja pagasi rahvusvahelise raudteeveo lepingu ühtsed reeglid» (CIV) Tallinna–Tapa–Valga liinil Kesk- ja Lääne-Euroopa suunal toimuva reisijate rahvusvahelise raudteeveo puhul; konventsiooni artiklite 3 ja 10 kohaselt kohaldab Eesti Vabariik konventsiooni lisa B «Kaupade rahvusvahelise raudteeveo lepingu ühtsed reeglid» (CIM) Tallinna–Tapa–Valga liinil toimuva kaupade rahvusvahelise raudteeveo puhul, mille lähte- või sihtpunkt asub niisuguse riigi territooriumil, kellega ei ole sellise veo suhtes teisiti kokku lepitud; konventsiooni lisa B «Kaupade rahvusvahelise raudteeveo lepingu ühtsed reeglid» (CIM) artikli 5 lõike 2 alusel jätab Eesti Vabariik endale õiguse kohaldada ohtlike kaupade veol teisi rahvusvahelisi kokkuleppeid; kui konventsioon jõustub redaktsioonis, mis on lisatud konventsiooni 1999. aasta 3. juunil Vilniuses koostatud muutmisprotokollile, jätab Eesti Vabariik endale õiguse teha täiendavaid reservatsioone ja deklaratsioone.",
      "rdfs:label": {
        "@value": "RRKU_Par_3 (redaktsioon 740577)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740577",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKU_Par_3_v12989243"
      },
      "estleg:versionValidTo": {
        "@value": "2008-07-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKU_Par_3_v12989243",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariik teeb järgmised deklaratsioonid: konventsiooni artikli 24 ja lisa A «Reisijate rahvusvahelise raudteeveo lepingu ühtsed eeskirjad» (CIV) artikli 1 lõike 6 alusel kohaldab Eesti Vabariik konventsiooni lisa A ainult Tallinna–Tapa–Valga liini mõlemal suunal toimuvale reisijate rahvusvahelisele raudteeveole; konventsiooni artiklite 3 ja 24 ning lisa B «Kaupade rahvusvahelise raudteeveo lepingu ühtsed eeskirjad» (CIM) artikli 1 lõike 6 alusel kohaldab Eesti Vabariik konventsiooni lisa B ainult Tallinna–Tapa–Valga liini mõlemal suunal toimuvale kaupade rahvusvahelisele raudteeveole, mille lähte- või sihtpunkt asub niisuguse riigi territooriumil, kellega ei ole sellise veo suhtes teisiti kokku lepitud; konventsiooni lisa C « » (RID) artiklite 3 ja 4 alusel jätab Eesti Vabariik endale õiguse reguleerida rahvusvahelist ohtlike kaupade vedu oma territooriumil RID-iga ühtlustatud rahvusvahelise raudteekaubaveo kokkuleppe SMGS-i lisa 2 alusel; Kehtetu –",
      "rdfs:label": {
        "@value": "RRKU_Par_3 (redaktsioon 12989243)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12989243",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRKU_Par_3_v204042012003"
      },
      "estleg:versionValidTo": {
        "@value": "2012-04-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RRKU_Par_3_v204042012003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRKU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariik teeb järgmised deklaratsioonid: konventsiooni artikli 24 ja lisa A «Reisijate rahvusvahelise raudteeveo lepingu ühtsed eeskirjad» (CIV) artikli 1 lõike 6 alusel kohaldab Eesti Vabariik konventsiooni lisa A ainult Tallinna–Tapa–Valga liini mõlemal suunal toimuvale reisijate rahvusvahelisele raudteeveole; konventsiooni artiklite 3 ja 24 ning lisa B «Kaupade rahvusvahelise raudteeveo lepingu ühtsed eeskirjad» (CIM) artikli 1 lõike 6 alusel kohaldab Eesti Vabariik konventsiooni lisa B ainult Tallinna–Tapa–Valga liini mõlemal suunal toimuvale kaupade rahvusvahelisele raudteeveole, mille lähte- või sihtpunkt asub niisuguse riigi territooriumil, kellega ei ole sellise veo suhtes teisiti kokku lepitud; Kehtetu - Kehtetu –",
      "rdfs:label": {
