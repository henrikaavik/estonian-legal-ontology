      },
      "estleg:versionText": "Ühineda juurdelisatud (COTIF, edaspidi konventsioon), mis on koostatud 1980. aasta 9. mail Bernis.",
      "rdfs:label": {
        "@value": "RRKU_Par_1 (redaktsioon 740577)",
        "@language": "et"
      },
