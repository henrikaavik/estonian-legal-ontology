    {
      "@id": "estleg:Reg_1002029_Par_2_v1002029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002029_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium on aruandekohustuslik Vabariigi Valitsuse ees, kes suunab ja koordineerib tema tegevust ja teostab tema üle teenistuslikku järelevalvet. Ministeerium on aruandekohustuslik Vabariigi Valitsuse ees, kes suunab ja koordineerib tema tegevust ja teostab tema üle teenistuslikku järelevalvet.",
      "rdfs:label": {
