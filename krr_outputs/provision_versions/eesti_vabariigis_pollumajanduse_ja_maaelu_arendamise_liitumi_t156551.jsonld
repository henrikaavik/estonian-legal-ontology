      },
      "estleg:versionValidFrom": {
        "@value": "2012-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerimise seaduse § 9 alusel ja korras on Ameti peadirektoril või tema volitatud ametnikul õigus järelevalve käigus avastatud puuduste kõrvaldamiseks teha taotlejale ettekirjutusi. Ratifitseerimise seaduse § 9 alusel ja korras on Ameti peadirektoril või tema volitatud ametnikul õigus järelevalve käigus avastatud puuduste kõrvaldamiseks teha taotlejale ettekirjutusi.",
      "rdfs:label": {
        "@value": "Reg_156551_Par_15 (redaktsioon 156551)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156551",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156551",
      "estleg:sourceAct": "Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotlemise, taotluse menetlemise ja toetuse maksmise kord",
      "estleg:provisionRef": "Reg_156551 § 15",
