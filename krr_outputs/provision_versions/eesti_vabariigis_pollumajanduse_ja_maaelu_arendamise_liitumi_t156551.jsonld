      "estleg:versionRedactionId": "156551",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156551",
      "estleg:sourceAct": "Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotlemise, taotluse menetlemise ja toetuse maksmise kord",
      "estleg:provisionRef": "Reg_156551 § 13",
