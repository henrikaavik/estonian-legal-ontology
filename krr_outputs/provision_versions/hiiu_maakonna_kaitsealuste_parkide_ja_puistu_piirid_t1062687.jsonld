    {
      "@id": "estleg:Reg_1062687_Par_8_v1062687",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062687_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 1. aprilli 2021. a käskkirjaga nr 1-2/21/176 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 1. aprilli 2021. a käskkirjaga nr 1-2/21/176 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1062687_Par_8 (redaktsioon 1062687)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062687",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062687",
      "estleg:sourceAct": "Hiiu maakonna kaitsealuste parkide ja puistu piirid",
      "estleg:provisionRef": "Reg_1062687 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062687_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1062687_Par_9_v1062687",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062687_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1062687_Par_9 (redaktsioon 1062687)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062687",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062687",
      "estleg:sourceAct": "Hiiu maakonna kaitsealuste parkide ja puistu piirid",
      "estleg:provisionRef": "Reg_1062687 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062687_Map_2026"
      }
