        "@id": "estleg:Reg_1026235_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1026235_Par_21_v1026235",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
