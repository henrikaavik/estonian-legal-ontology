      "estleg:provisionRef": "Reg_1026235 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026235_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1026235_Par_28_v1026235",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
