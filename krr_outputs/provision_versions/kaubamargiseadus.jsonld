      },
      "estleg:versionValidTo": {
        "@value": "2019-03-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAUBAM_Par_71_2_v119032019047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
