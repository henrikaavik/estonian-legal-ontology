      }
    },
    {
      "@id": "estleg:KAUBAM_Par_70_v119032019047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAUBAM_Par_70"
      },
      "estleg:versionValidFrom": {
