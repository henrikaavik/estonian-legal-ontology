      "estleg:provisionRef": "Reg_1062164 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062164_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1062164_Par_24_v1062164",
