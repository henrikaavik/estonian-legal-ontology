    {
      "@id": "estleg:Reg_1062164_Par_13_v1062164",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062164_Par_13"
