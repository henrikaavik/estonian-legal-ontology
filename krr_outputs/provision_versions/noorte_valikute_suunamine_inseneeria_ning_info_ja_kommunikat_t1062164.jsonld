      "estleg:versionValidFrom": {
        "@value": "2025-10-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantskorrektsiooni otsus tehakse ja toetus nõutakse tagasi vastavalt perioodi 2021–2027 Euroopa Liidu ühtekuuluvus- ja siseturvalisuspoliitika fondide rakendamise seaduse §-dele 28–30 ja ühendmääruse §-dele 34–38. Finantskorrektsiooni otsus tehakse ja toetus nõutakse tagasi vastavalt perioodi 2021–2027 Euroopa Liidu ühtekuuluvus- ja siseturvalisuspoliitika fondide rakendamise seaduse §-dele 28–30 ja ühendmääruse §-dele 34–38.",
      "rdfs:label": {
        "@value": "Reg_1062164_Par_26 (redaktsioon 1062164)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062164",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062164",
      "estleg:sourceAct": "Noorte valikute suunamine inseneeria ning info- ja kommunikatsioonitehnoloogia valdkondades",
