    },
    {
      "@id": "estleg:Reg_155288_Par_23_v155288",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155288_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Juhataja esitab eelarve projekti koos seletuskirjaga nõukogule läbivaatamiseks ja kinnitamiseks vähemalt 40 päeva enne majandusaasta algust. Seletuskiri peab sisaldama põhjalikku analüüsi ja hinnangut kõigi Fondi tulude ja kulude osas, sealhulgas osamaksete laekumise ja võimalike hüvitiste kohta. Juhataja esitab eelarve projekti koos seletuskirjaga nõukogule läbivaatamiseks ja kinnitamiseks vähemalt 40 päeva enne majandusaasta algust. Seletuskiri peab sisaldama põhjalikku analüüsi ja hinnangut kõigi Fondi tulude ja kulude osas, sealhulgas osamaksete laekumise ja võimalike hüvitiste kohta. 2 (2) Nõukogu kinnitab eelarve hiljemalt majandusaastale eelneva aasta 31. detsembriks. Nõukogu kinnitab eelarve hiljemalt majandusaastale eelneva aasta 31. detsembriks. 3 (3) Kui Fondi eelarvet ei ole kinnitatud eelarveaasta alguseks, võib kuni eelarve kinnitamiseni teha alanud eelarveaasta igal kuul kulutusi kuni 1/12 osa ulatuses eelmise aasta eelarvest. Käesolevat piirangut ei kohaldata seaduse alusel ettenähtud hüvitiste väljamaksmisele. Kui Fondi eelarvet ei ole kinnitatud eelarveaasta alguseks, võib kuni eelarve kinnitamiseni teha alanud eelarveaasta igal kuul kulutusi kuni 1/12 osa ulatuses eelmise aasta eelarvest. Käesolevat piirangut ei kohaldata seaduse alusel ettenähtud hüvitiste väljamaksmisele.",
      "rdfs:label": {
        "@value": "Reg_155288_Par_23 (redaktsioon 155288)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155288",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155288",
      "estleg:sourceAct": "Tagatisfondi põhikiri",
      "estleg:provisionRef": "Reg_155288 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155288_Map"
      }
    },
    {
      "@id": "estleg:Reg_155288_Par_24_v155288",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155288_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eelarve muutmiseks esitab juhataja eelarve muutmise projekti koos seletuskirjaga nõukogule kinnitamiseks. Seletuskirjas tuuakse põhjendused, mis tingisid eelarve muutmise ning antakse hinnang eelarve muutmise tagajärgedele. Kulude suurendamisel peab eelarve muutmise projekt sisaldama ka selle katteallikaid. Eelarve muutmiseks esitab juhataja eelarve muutmise projekti koos seletuskirjaga nõukogule kinnitamiseks. Seletuskirjas tuuakse põhjendused, mis tingisid eelarve muutmise ning antakse hinnang eelarve muutmise tagajärgedele. Kulude suurendamisel peab eelarve muutmise projekt sisaldama ka selle katteallikaid. 2 (2) Eelarve muutmise projekti osas teeb nõukogu otsuse hiljemalt 40 päeva jooksul alates eelarve muutmise projekti esitamisest esimehele. Eelarve muutmise projekti osas teeb nõukogu otsuse hiljemalt 40 päeva jooksul alates eelarve muutmise projekti esitamisest esimehele.",
      "rdfs:label": {
        "@value": "Reg_155288_Par_24 (redaktsioon 155288)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155288",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155288",
