    {
      "@id": "estleg:Reg_155288_Par_22_v155288",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155288_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Fondi eelarve (edaspidi eelarve) sisaldab kõiki Fondi kavandatavaid tulusid ja kulusid majandusaastal. Fondi eelarve (edaspidi eelarve) sisaldab kõiki Fondi kavandatavaid tulusid ja kulusid majandusaastal. 2 (2) Eelarve koostatakse Fondi kohta tervikuna ning eraldi iga osafondi kohta. Eraldi tuuakse välja Fondi üldkulud ja nende katmiseks osafondide varast tehtavad eraldised. Eelarve koostatakse Fondi kohta tervikuna ning eraldi iga osafondi kohta. Eraldi tuuakse välja Fondi üldkulud ja nende katmiseks osafondide varast tehtavad eraldised. 3 (3) Osafondi tulud kajastatakse eelarves, lähtudes seaduse §-s 76 sätestatust. Osafondi tulud kajastatakse eelarves, lähtudes seaduse §-s 76 sätestatust. 4 (4) Osafondi kulud kajastatakse eelarves, lähtudes seaduse § 80 lõikes 3 sätestatust. Osafondi kulud kajastatakse eelarves, lähtudes seaduse § 80 lõikes 3 sätestatust.",
      "rdfs:label": {
        "@value": "Reg_155288_Par_22 (redaktsioon 155288)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155288",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155288",
      "estleg:sourceAct": "Tagatisfondi põhikiri",
      "estleg:provisionRef": "Reg_155288 § 22",
