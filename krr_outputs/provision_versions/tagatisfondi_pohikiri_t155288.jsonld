    {
      "@id": "estleg:Reg_155288_Par_5_v155288",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155288_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Fondi kõrgeim organ on üheksaliikmeline nõukogu. RT I 2008 53 303 13091472 2008-12-19 Fondi kõrgeim organ on üheksaliikmeline nõukogu. 2 (2) Nõukogu liige osaleb nõukogu tegevuses isiklikult. Nõukogu liige osaleb nõukogu tegevuses isiklikult.",
      "rdfs:label": {
        "@value": "Reg_155288_Par_5 (redaktsioon 155288)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155288",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155288",
      "estleg:sourceAct": "Tagatisfondi põhikiri",
      "estleg:provisionRef": "Reg_155288 § 5",
