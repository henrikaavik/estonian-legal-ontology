    {
      "@id": "estleg:Reg_1008547_Par_6_v1008547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008547_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hoiule võetud asjad tagastatakse ajateenijale ajateenistusest vabastamisel, mille kohta tehakse vastav märge hoiule võetud asjade hoiustamise akti. Hoiule võetud asjad tagastatakse ajateenijale ajateenistusest vabastamisel, mille kohta tehakse vastav märge hoiule võetud asjade hoiustamise akti. 2 (2) Erandina võib ajateenistuskoha ülem lubada ajateenijal tema puhkuse või kokkusaamise ajal toimetada hoiule võetud asjad ajateenistuskoha territooriumilt välja, mille kohta tehakse vastav märge hoiule võetud asjade hoiustamise akti. Erandina võib ajateenistuskoha ülem lubada ajateenijal tema puhkuse või kokkusaamise ajal toimetada hoiule võetud asjad ajateenistuskoha territooriumilt välja, mille kohta tehakse vastav märge hoiule võetud asjade hoiustamise akti.",
      "rdfs:label": {
        "@value": "Reg_1008547_Par_6 (redaktsioon 1008547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008547",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008547",
      "estleg:sourceAct": "Ajateenistusse asumisel kaasavõetavate ja ajateenistuses nõutavate dokumentide ning esemete loetelu, ajateenistuses keelatud asjade loetelu, keelatud asjade hoidmise, tagastamise ja hävitamise kord ning hävitamisakti vorm",
      "estleg:provisionRef": "Reg_1008547 § 6",
