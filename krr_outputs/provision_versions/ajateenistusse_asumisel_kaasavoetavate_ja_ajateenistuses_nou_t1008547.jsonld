      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse ajateenistusse asumisel kaasavõetavate ja ajateenistuses nõutavate dokumentide ning esemete loetelu, ajateenistuses keelatud asjade loetelu, nende hoidmise, tagastamise ja hävitamise kord ning hävitamisakti vorm. Määrusega kehtestatakse ajateenistusse asumisel kaasavõetavate ja ajateenistuses nõutavate dokumentide ning esemete loetelu, ajateenistuses keelatud asjade loetelu, nende hoidmise, tagastamise ja hävitamise kord ning hävitamisakti vorm.",
      "rdfs:label": {
        "@value": "Reg_1008547_Par_1 (redaktsioon 1008547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008547",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008547",
      "estleg:sourceAct": "Ajateenistusse asumisel kaasavõetavate ja ajateenistuses nõutavate dokumentide ning esemete loetelu, ajateenistuses keelatud asjade loetelu, keelatud asjade hoidmise, tagastamise ja hävitamise kord ning hävitamisakti vorm",
      "estleg:provisionRef": "Reg_1008547 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008547_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008547_Par_2_v1008547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008547_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ajateenistusse asumisel on isik kohustatud kaasa võtma ja ajateenistuses peavad ajateenijal olema järgmised dokumendid: 1 1) isikut tõendav dokument; 2 2) juhiluba (olemasolul); 3 3) immuniseerimispass (olemasolul). Ajateenistusse asumisel on isik kohustatud kaasa võtma ja ajateenistuses peavad ajateenijal olema järgmised dokumendid: isikut tõendav dokument; juhiluba (olemasolul); immuniseerimispass (olemasolul).",
      "rdfs:label": {
        "@value": "Reg_1008547_Par_2 (redaktsioon 1008547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008547",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008547",
      "estleg:sourceAct": "Ajateenistusse asumisel kaasavõetavate ja ajateenistuses nõutavate dokumentide ning esemete loetelu, ajateenistuses keelatud asjade loetelu, keelatud asjade hoidmise, tagastamise ja hävitamise kord ning hävitamisakti vorm",
      "estleg:provisionRef": "Reg_1008547 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008547_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008547_Par_3_v1008547",
      "@type": [
