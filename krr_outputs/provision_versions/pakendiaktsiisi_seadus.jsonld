      },
      "estleg:versionValidFrom": {
        "@value": "2008-05-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1997. aasta 1. märtsil, välja arvatud seaduselisa punkt 2, mis jõustub 1998. aasta 1. detsembril. (2) 2005. aasta 1. jaanuaril: jõustuvad käesoleva seaduse § 6 lõiked 5 ja 6, §-d 111 ja 131; jõustuvad 2004. aasta 15. detsembri redaktsioonis käesoleva seaduse § 2 punktid 1, 3 ja 7, § 5 lõige 1, § 6 lõiked 2 ja 4, § 7 lõiked 2 ja 3, §-d 8 ja 11, § 12 lõige 4 ning käesoleva seaduse lisa; tunnistatakse kehtetuks käesoleva seaduse § 6 lõige 1, § 7 lõiked 1 ja 4, §-d 9 ja 10 ning § 12 lõige 3. (3) Käesoleva seaduse § 8 lõike 1 punktid 3 ja 4 tunnistatakse kehtetuks alates 2009. aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "PakAS_Par_14 (redaktsioon 12964624)",
        "@language": "et"
