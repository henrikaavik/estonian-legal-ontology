    {
      "@id": "estleg:PakAS_Par_14_v13074692",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakAS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1997. aasta 1. märtsil, välja arvatud seaduse lisa punkt 2, mis jõustub 1998. aasta 1. detsembril. (2) 2005. aasta 1. jaanuaril: jõustuvad käesoleva seaduse § 6 lõiked 5 ja 6, §-d 111 ja 131; jõustuvad 2004. aasta 15. detsembri redaktsioonis käesoleva seaduse § 2 punktid 1, 3 ja 7, § 5 lõige 1, § 6 lõiked 2 ja 4, § 7 lõiked 2 ja 3, §-d 8 ja 11, § 12 lõige 4 ning käesoleva seaduse lisa; tunnistatakse kehtetuks käesoleva seaduse § 6 lõige 1, § 7 lõiked 1 ja 4, §-d 9 ja 10 ning § 12 lõige 3. (3) Käesoleva seaduse § 8 lõike 1 punktid 3 ja 4 tunnistatakse kehtetuks alates 2009. aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "PakAS_Par_14 (redaktsioon 13074692)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13074692"
    },
    {
      "@id": "estleg:PakAS_Par_2_v22368",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse mõistes on: pakend – täidetud müügipakend pakendiseaduse (RT I 1995, 47, 739) mõistes; [punkti 2 sõnastus kuni 30.06.2002] import – pakendi sissevedu Eesti tolliterritooriumile tolliseaduses (RT I 1993, 62, 891; 76, 1129; 1994, 30, 466; 1995, 20, 297; 1996, 83, 1487) sätestatud tolliprotseduuriga «import vabaks ringluseks»; [punkti 2 sõnastus alates 01.07.2002] import – pakendi sissevedu Eesti tolliterritooriumile vabasse ringlusse lubamise tolliprotseduuriga tolliseadustiku mõistes. Impordina käsitatakse ka kauba sissevedu muudel juhtudel, kui sellega kaasneb tollivõla tekkimine tolliseadustiku tähenduses, välja arvatud käesoleva paragrahvi punktis 21 sätestatud taassissevedu; [punkti 21 sõnastus kuni 30.06.2002] taassissevedu – pakendi sissevedu Eesti tolliterritooriumile tolliseaduses sätestatud tolliprotseduuriga «taassissevedu»; [punkti 21 sõnastus alates 01.07.2002] taassissevedu – pakendi sissevedu Eesti tolliterritooriumile tolliseadustikus sätestatud välistöötlemise tolliprotseduuri rakendamisega; taaskasutatav pakend – pakend, mida taaskasutatakse pakendiseaduse paragrahv 11 lõikes 2 sätestatud viisil; [kehtetu]; pakendi kasutaja – ettevõtlusega tegelev füüsiline või juriidiline isik või välismaa äriühingu filiaal Eestis, kes täidab pakendi kaubaga; alkohol – alkohol alkoholiaktsiisi seaduse (RT I 1995, 87, 1539; 1996, 45, 852; 87, 1544) mõistes; karastusjook – jook Eesti kaupade nomenklatuuri (edaspidi EKN) järgi rahandusministri kehtestatud kaubapositsioonide kohaselt. - Riigikohtu põhiseaduslikkuse järelevalve kohtukolleegiumi kohtuotsus 3-4-1-18-07 tunnistab § 2 punkti 7 alates 27. juulist 2000 kuni 31. detsembrini 2004 kehtinud redaktsioonis põhiseadusega vastuolus olnuks.",
      "rdfs:label": {
        "@value": "PakAS_Par_2 (redaktsioon 22368)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22368",
      "estleg:supersededByVersion": {
        "@id": "estleg:PakAS_Par_2_v693600"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PakAS_Par_2_v693600",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse mõistes on: pakend – täidetud müügipakend pakendiseaduse (RT I 1995, 47, 739) mõistes; import – pakendi sissevedu Eesti tolliterritooriumile vabasse ringlusse lubamise tolliprotseduuriga tolliseadustiku mõistes. Impordina käsitatakse ka kauba sissevedu muudel juhtudel, kui sellega kaasneb tollivõla tekkimine tolliseadustiku tähenduses, välja arvatud käesoleva paragrahvi punktis 21 sätestatud taassissevedu; taassissevedu – pakendi sissevedu Eesti tolliterritooriumile tolliseadustikus sätestatud välistöötlemise tolliprotseduuri rakendamisega; taaskasutatav pakend – pakend, mida taaskasutatakse pakendiseaduse § 11 lõikes 2 sätestatud viisil; [kehtetu]; pakendi kasutaja – ettevõtlusega tegelev füüsiline või juriidiline isik või välismaa äriühingu filiaal Eestis, kes täidab pakendi kaubaga; alkohol – alkohol alkoholiaktsiisi seaduse (RT I 1995, 87, 1539; 1996, 45, 852; 87, 1544) mõistes; karastusjook – jook Eesti kaupade nomenklatuuri (edaspidi EKN) järgi rahandusministri kehtestatud kaubapositsioonide kohaselt. - Riigikohtu põhiseaduslikkuse järelevalve kohtukolleegiumi kohtuotsus 3-4-1-18-07 tunnistab § 2 punkti 7 alates 27. juulist 2000 kuni 31. detsembrini 2004 kehtinud redaktsioonis põhiseadusega vastuolus olnuks.",
      "rdfs:label": {
        "@value": "PakAS_Par_2 (redaktsioon 693600)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693600",
      "estleg:supersededByVersion": {
        "@id": "estleg:PakAS_Par_2_v738376"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PakAS_Par_2_v738376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse mõistes on: pakend – täidetud müügipakend pakendiseaduse (RT I 1995, 47, 739) mõistes; import – pakendi vabasse ringlusse lubamine Euroopa Ühenduste Nõukogu 1992. aasta 12. oktoobri määruse 2913/92/EMÜ mõistes, millega kehtestati ühenduse tolliseadustik (EÜT L 302, 19.10.1992, lk 1; 1, 01.01.1995, lk 1; 17, 21.01.1997, lk 1; 119, 07.05.1999, lk 1; 311, 12.12.2000, lk 17 – edaspidi ühenduse tolliseadustik). Impordina käsitatakse ka kauba sissevedu muudel juhtudel, kui sellega kaasneb tollivõla tekkimine ühenduse tolliseadustiku mõistes; kehtetu - ühendusesisene pakendi soetamine – pakendi Eestisse toimetamine teisest liikmesriigist ettevõtluse eesmärgil; taaskasutatav pakend – pakend, mida taaskasutatakse pakendiseaduse § 11 lõikes 2 sätestatud viisil; [kehtetu]; pakendi kasutaja – ettevõtlusega tegelev füüsiline või juriidiline isik või välismaa äriühingu filiaal Eestis, kes täidab pakendi kaubaga; alkohol – alkohol alkoholi-, tubaka- ja kütuseaktsiisi seaduse (RT I 2003, 2, 17; 48, 345; 90, 602; 88, 591) mõistes; karastusjook – jook Eesti kaupade nomenklatuuri (edaspidi EKN) järgi rahandusministri kehtestatud kaubapositsioonide kohaselt. - Riigikohtu põhiseaduslikkuse järelevalve kohtukolleegiumi kohtuotsus 3-4-1-18-07 tunnistab § 2 punkti 7 alates 27. juulist 2000 kuni 31. detsembrini 2004 kehtinud redaktsioonis põhiseadusega vastuolus olnuks.",
      "rdfs:label": {
        "@value": "PakAS_Par_2 (redaktsioon 738376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "738376",
      "estleg:supersededByVersion": {
        "@id": "estleg:PakAS_Par_2_v833940"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PakAS_Par_2_v833940",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse mõistes on: pakend – täidetud müügipakend pakendiseaduse (RT I 2004, 41, 278) mõistes; import – pakendi vabasse ringlusse lubamine Euroopa Ühenduste Nõukogu 1992. aasta 12. oktoobri määruse 2913/92/EMÜ mõistes, millega kehtestati ühenduse tolliseadustik (EÜT L 302, 19.10.1992, lk 1; 1, 01.01.1995, lk 1; 17, 21.01.1997, lk 1; 119, 07.05.1999, lk 1; 311, 12.12.2000, lk 17 – edaspidi ühenduse tolliseadustik). Impordina käsitatakse ka kauba sissevedu muudel juhtudel, kui sellega kaasneb tollivõla tekkimine ühenduse tolliseadustiku mõistes; kehtetu - ühendusesisene pakendi soetamine – pakendi Eestisse toimetamine teisest liikmesriigist ettevõtluse eesmärgil; pakendi taaskasutamine – pakendi jäätmete taaskasutus pakendiseaduse mõistes; kehtetu - pakendi kasutaja - ettevõtlusega tegelev füüsiline või juriidiline isik või välismaa äriühingu filiaal Eestis, kes täidab pakendi kaubaga; alkohol – alkohol alkoholi-, tubaka- ja kütuseaktsiisi seaduse (RT I 2003, 2, 17; 48, 345; 90, 602; 88, 591) mõistes; karastusjook – jook, mille nomenklatuuri on rahandusminister kehtestanud vastavalt EÜ Nõukogu määrusele 2658/87/EMÜ tariifi- ja statistikanomenklatuuri ning ühise tollitariifistiku kohta (EÜT L 256, 07.09.1987, lk 1–675).",
      "rdfs:label": {
        "@value": "PakAS_Par_2 (redaktsioon 833940)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "833940",
      "estleg:supersededByVersion": {
        "@id": "estleg:PakAS_Par_2_v918053"
      },
      "estleg:versionValidTo": {
        "@value": "2005-07-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PakAS_Par_2_v918053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse mõistes on: pakend – täidetud müügipakend pakendiseaduse (RT I 2004, 41, 278) mõistes; import – pakendi vabasse ringlusse lubamine Euroopa Ühenduste Nõukogu 1992. aasta 12. oktoobri määruse 2913/92/EMÜ mõistes, millega kehtestati ühenduse tolliseadustik (EÜT L 302, 19.10.1992, lk 1; 1, 01.01.1995, lk 1; 17, 21.01.1997, lk 1; 119, 07.05.1999, lk 1; 311, 12.12.2000, lk 17 – edaspidi ühenduse tolliseadustik). Impordina käsitatakse ka kauba sissevedu muudel juhtudel, kui sellega kaasneb tollivõla tekkimine ühenduse tolliseadustiku mõistes; kehtetu - ühendusesisene pakendi soetamine – pakendi Eestisse toimetamine teisest liikmesriigist ettevõtluse eesmärgil; pakendi taaskasutamine – pakendi korduskasutus ja pakendijäätmete taaskasutus pakendiseaduse mõistes; kehtetu - pakendi kasutaja – ettevõtlusega tegelev füüsiline või juriidiline isik või välismaa äriühingu filiaal Eestis, kes täidab pakendi kaubaga; alkohol – alkohol alkoholi-, tubaka- ja kütuseaktsiisi seaduse (RT I 2003, 2, 17; 48, 345; 90, 602; 88, 591) mõistes;",
      "rdfs:label": {
        "@value": "PakAS_Par_2 (redaktsioon 918053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "918053",
      "estleg:supersededByVersion": {
        "@id": "estleg:PakAS_Par_2_v12964624"
      },
      "estleg:versionValidTo": {
        "@value": "2008-05-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PakAS_Par_2_v12964624",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-05-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse mõistes on: pakend – pakendiseaduse mõistes; import – pakendi vabasse ringlusse lubamine nõukogu määruse 2913/92/EMÜ, millega kehtestati ühenduse tolliseadustik (EÜT L 302, 19.10.1992, lk 1–50) (edaspidi ühenduse tolliseadustik) mõistes. Impordina käsitatakse ka pakendi ühenduse tolliterritooriumile toomist muudel juhtudel, kui kauba sisseveoga kaasneb tollivõla tekkimine ühenduse tolliseadustiku mõistes või pakendi kasutamine või tolli järelevalve all hävitamine Eestis; kehtetu - ühendusesisene pakendi soetamine – pakendi Eestisse toimetamine teisest liikmesriigist ettevõtluse eesmärgil; pakendi taaskasutamine – pakendijäätmete taaskasutus pakendiseaduse mõistes; kehtetu - kehtetu - alkohol – alkohol alkoholi-, tubaka- ja kütuseaktsiisi seaduse mõistes; karastusjook – jook, mille kombineeritud nomenklatuuri (KN) rubriigid on 2009, 2201 või 2202 vastavalt nõukogu määrusele 2658/87/EMÜ tariifi- ja statistikanomenklatuuri ning ühise tollitariifistiku kohta (EÜT L 256, 07.09.1987, lk 1–675).",
      "rdfs:label": {
        "@value": "PakAS_Par_2 (redaktsioon 12964624)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12964624",
      "estleg:supersededByVersion": {
        "@id": "estleg:PakAS_Par_2_v13074692"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PakAS_Par_2_v13074692",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakAS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse mõistes on: pakend – pakendiseaduse mõistes; import – pakendi vabasse ringlusse lubamine nõukogu määruse 2913/92/EMÜ, millega kehtestati ühenduse tolliseadustik (EÜT L 302, 19.10.1992, lk 1–50) (edaspidi ühenduse tolliseadustik) mõistes. Impordina käsitatakse ka pakendi ühenduse tolliterritooriumile toomist muudel juhtudel, kui kauba sisseveoga kaasneb tollivõla tekkimine ühenduse tolliseadustiku mõistes või pakendi kasutamine või tolli järelevalve all hävitamine Eestis; kehtetu - ühendusesisene pakendi soetamine – pakendi Eestisse toimetamine teisest liikmesriigist ettevõtluse eesmärgil; pakendi taaskasutamine – pakendijäätmete taaskasutus pakendiseaduse mõistes; kehtetu - kehtetu - alkohol – alkohol alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduse mõistes; karastusjook – jook, mille kombineeritud nomenklatuuri (KN) rubriigid on 2009, 2201 või 2202 vastavalt nõukogu määrusele 2658/87/EMÜ tariifi- ja statistikanomenklatuuri ning ühise tollitariifistiku kohta (EÜT L 256, 07.09.1987, lk 1–675).",
      "rdfs:label": {
        "@value": "PakAS_Par_2 (redaktsioon 13074692)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13074692",
      "estleg:supersededByVersion": {
        "@id": "estleg:PakAS_Par_2_v116062017021"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PakAS_Par_2_v116062017021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PakAS_Par_2"
      },
      "estleg:versionValidFrom": {
