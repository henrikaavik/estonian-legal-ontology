    {
      "@id": "estleg:Reg_1029443_Par_20_v1029443",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029443_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse saajal on õigus saada rakendusüksuselt informatsiooni ja selgitusi, mis on seotud õigusaktides sätestatud nõuete ja toetuse saaja kohustustega. Toetuse saajal on õigus saada rakendusüksuselt informatsiooni ja selgitusi, mis on seotud õigusaktides sätestatud nõuete ja toetuse saaja kohustustega. 2 (2) Toetuse saajale antakse võimalus esitada oma seisukohad struktuuritoetuse seaduse § 23 lõikes 2 sätestatud juhtudel. Toetuse saajale antakse võimalus esitada oma seisukohad struktuuritoetuse seaduse § 23 lõikes 2 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "Reg_1029443_Par_20 (redaktsioon 1029443)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029443",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029443",
      "estleg:sourceAct": "Soojusmajanduse arengukava koostamise toetamise tingimused",
