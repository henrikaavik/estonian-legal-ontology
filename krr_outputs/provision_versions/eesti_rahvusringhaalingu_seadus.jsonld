    {
      "@id": "estleg:ERHS_Par_6_v12786086",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ERHS_Par_6"
      },
      "estleg:versionValidFrom": {
