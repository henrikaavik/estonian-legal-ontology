      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tuletõrje veevõtukoha ehitusprojektile esitatavad nõuded (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tuletõrje veevõtukoha ehitusprojektile esitatavad nõuded"
    },
    {
      "@id": "estleg:Reg_1051360_Par_1_v1051360",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
