      }
    },
    {
      "@id": "estleg:Reg_1001107_Par_7_v1001107",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001107_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mõõdetav kiiruste piirkond on 10 km/h kuni 250 km/h. Mõõdetav kiiruste piirkond on 10 km/h kuni 250 km/h. 2 (2) Mõõtmisel peab olema tagatud kiirusmõõturit ümbritseva keskkonna temperatuuri vastavus tootja kasutusjuhendis või tüübikinnitustunnistuses esitatud tingimustele. RT I 2019-07-02 9 102072019009 2019-07-05 Mõõtmisel peab olema tagatud kiirusmõõturit ümbritseva keskkonna temperatuuri vastavus tootja kasutusjuhendis või tüübikinnitustunnistuses esitatud tingimustele.",
      "rdfs:label": {
        "@value": "Reg_1001107_Par_7 (redaktsioon 1001107)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001107",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001107",
      "estleg:sourceAct": "Nõuded kiirusmõõturi ja kiirusmõõtesüsteemi mõõteprotseduurile ning mõõtetulemuste töötlemisele",
      "estleg:provisionRef": "Reg_1001107 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001107_Map"
      }
    },
    {
      "@id": "estleg:Reg_1001107_Par_8_v1001107",
      "@type": [
        "owl:NamedIndividual",
