    },
    {
      "@id": "estleg:Reg_1001107_Par_16_v1001107",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001107_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirusmõõtesüsteem arvutab kõikide teel liikuvate sõidukite sõidukiiruse. Kui sõiduki kiirus ületab vastavalt jälgitud sõiduki kategooriale (sõiduauto, veoauto) mõõtesüsteemi sisestatud pildikäivituse piirväärtust, fotografeerib või filmib mõõtesüsteem lubatud sõidukiirust ületanud sõiduki ja koostab salvestise. Kiirusmõõtesüsteem arvutab kõikide teel liikuvate sõidukite sõidukiiruse. Kui sõiduki kiirus ületab vastavalt jälgitud sõiduki kategooriale (sõiduauto, veoauto) mõõtesüsteemi sisestatud pildikäivituse piirväärtust, fotografeerib või filmib mõõtesüsteem lubatud sõidukiirust ületanud sõiduki ja koostab salvestise.",
      "rdfs:label": {
        "@value": "Reg_1001107_Par_16 (redaktsioon 1001107)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001107",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001107",
      "estleg:sourceAct": "Nõuded kiirusmõõturi ja kiirusmõõtesüsteemi mõõteprotseduurile ning mõõtetulemuste töötlemisele",
      "estleg:provisionRef": "Reg_1001107 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001107_Map"
      }
    },
    {
      "@id": "estleg:Reg_1001107_Par_17_v1001107",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001107_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lubatud sõidukiiruse ületamise juhtumi salvestises peavad sisalduma järgmised andmed: 1 1) kiirusmõõtesüsteemi osaks oleva dokumenteerimisseadme unikaalne nimi või tähis; 2 2) salvestise unikaalne nimi või tähis; 3 3) lubatud sõidukiiruse ületamise juhtumi salvestamise aeg (kuupäev, kuu, aasta ja kellaaeg); 4 4) vähemalt üks kõrgresolutsioonis foto või video lubatud sõidukiirust ületanud sõidukist; 5 5) kiirusmõõtesüsteemi osaks oleva dokumenteerimisseadme asukoht; RT I 2019-07-02 9 102072019009 2019-07-05 6 6) suurim lubatud sõidukiirus; 7 7) mõõtmistel saadud sõiduki kiiruse väärtus; 8 8) mõõteobjekti sõidusuund (lähenev, kaugenev). Lubatud sõidukiiruse ületamise juhtumi salvestises peavad sisalduma järgmised andmed: kiirusmõõtesüsteemi osaks oleva dokumenteerimisseadme unikaalne nimi või tähis; salvestise unikaalne nimi või tähis; lubatud sõidukiiruse ületamise juhtumi salvestamise aeg (kuupäev, kuu, aasta ja kellaaeg); vähemalt üks kõrgresolutsioonis foto või video lubatud sõidukiirust ületanud sõidukist; kiirusmõõtesüsteemi osaks oleva dokumenteerimisseadme asukoht; suurim lubatud sõidukiirus; mõõtmistel saadud sõiduki kiiruse väärtus; mõõteobjekti sõidusuund (lähenev, kaugenev).",
      "rdfs:label": {
        "@value": "Reg_1001107_Par_17 (redaktsioon 1001107)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001107",
