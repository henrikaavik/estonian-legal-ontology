    {
      "@id": "estleg:Reg_1001107_Par_3_v1001107",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001107_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kiirusmõõturiga sõidukiirust mõõtev politseiametnik või abipolitseinik peab olema läbinud mõõtevahendi kasutamiseks vajaliku väljaõppe. RT I 2024-07-20 5 120072024005 2024-07-23 Kiirusmõõturiga sõidukiirust mõõtev politseiametnik või abipolitseinik peab olema läbinud mõõtevahendi kasutamiseks vajaliku väljaõppe. 2 (2) Automaatne kiirusmõõtesüsteem peab sõidukiiruse mõõtmiseks olema nõuetekohaselt paigaldatud ja seadistatud. Automaatsele kiirusemõõtmisele, sealhulgas mõõtesüsteemi paigaldamisele ja seadistamisele kehtestatud nõuete järgimise tagab mõõtesüsteemi valdaja. Automaatne kiirusmõõtesüsteem peab sõidukiiruse mõõtmiseks olema nõuetekohaselt paigaldatud ja seadistatud. Automaatsele kiirusemõõtmisele, sealhulgas mõõtesüsteemi paigaldamisele ja seadistamisele kehtestatud nõuete järgimise tagab mõõtesüsteemi valdaja. 3 (3) Kehtetu - RT I 2019-07-02 9 102072019009 2019-07-05 Kehtetu - 4 (4) Mõõtevahendite kasutaja või valdaja peab arvestust kasutusel olevate ja kasutuselt kõrvaldatud mõõtevahendite üle ning tagab kasutuselt kõrvaldatud mõõtevahendite hoidmise kasutusel olevatest mõõtevahenditest eraldi. Mõõtevahendite kasutaja või valdaja peab arvestust kasutusel olevate ja kasutuselt kõrvaldatud mõõtevahendite üle ning tagab kasutuselt kõrvaldatud mõõtevahendite hoidmise kasutusel olevatest mõõtevahenditest eraldi.",
      "rdfs:label": {
        "@value": "Reg_1001107_Par_3 (redaktsioon 1001107)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001107",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001107",
