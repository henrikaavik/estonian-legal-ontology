      "estleg:versionValidFrom": {
        "@value": "2023-04-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 2013. aasta 1. aprillil. Määrus jõustub 2013. aasta 1. aprillil.",
      "rdfs:label": {
        "@value": "Reg_1012114_Par_13 (redaktsioon 1012114)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012114",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012114",
      "estleg:sourceAct": "Sotsiaalmaksu arvestamise ning sotsiaalmaksu andmete Sotsiaalkindlustusametile ja Tervisekassale väljastamise kord",
      "estleg:provisionRef": "Reg_1012114 § 13",
      "estleg:partOfAct": {
