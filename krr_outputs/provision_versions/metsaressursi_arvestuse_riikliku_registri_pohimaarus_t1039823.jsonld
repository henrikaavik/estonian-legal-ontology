    {
      "@id": "estleg:Reg_1039823_Par_4_v1039823",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039823_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Metsaregistri turvaklass on K2T2S1. Metsaregistri turvaklass on K2T2S1. 2 (2) Metsaregistri turbeaste on keskmine (M). Metsaregistri turbeaste on keskmine (M).",
      "rdfs:label": {
        "@value": "Reg_1039823_Par_4 (redaktsioon 1039823)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039823",
