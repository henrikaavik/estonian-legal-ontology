      "estleg:provisionRef": "Reg_1039823 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039823_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039823_Par_14_v1039823",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
