      "estleg:provisionRef": "Reg_1039823 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039823_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039823_Par_18_v1039823",
