      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metsaregistri andmetel on informatiivne tähendus, kui seadusest ei tulene teisiti. Metsaregistri andmetel on informatiivne tähendus, kui seadusest ei tulene teisiti.",
