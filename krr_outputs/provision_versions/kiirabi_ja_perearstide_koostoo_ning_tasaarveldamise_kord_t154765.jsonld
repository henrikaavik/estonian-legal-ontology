      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kiirabi ja perearstide koostöö ning tasaarveldamise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kiirabi ja perearstide koostöö ning tasaarveldamise kord"
    },
    {
      "@id": "estleg:Reg_154765_Par_1_v154765",
      "@type": [
