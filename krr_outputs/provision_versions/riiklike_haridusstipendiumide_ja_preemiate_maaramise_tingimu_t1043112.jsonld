      }
    },
    {
      "@id": "estleg:Reg_1043112_Par_9_v1043112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043112_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Igal aastal määratakse kuni kolm elutööpreemiat suurusega 65 000 eurot. RT I 2020-03-31 1 131032020001 2020-04-03 Igal aastal määratakse kuni kolm elutööpreemiat suurusega 65 000 eurot. 2 (2) Igal aastal määratakse kuni 12 aastapreemiat suurusega 10 000 eurot. RT I 2023-02-28 6 128022023006 2023-03-03 Igal aastal määratakse kuni 12 aastapreemiat suurusega 10 000 eurot. 3 (3) Preemiaga kaasneb tunnistus. Preemiaga kaasneb tunnistus.",
