    {
      "@id": "estleg:Reg_1043112_Par_7_v1043112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043112_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkurss loetakse luhtunuks, kui konkursil osalemiseks ei esitatud ühtegi taotlust või ükski taotlus ei vastanud esitatud nõuetele. Konkursi luhtumisel otsustab haridus- ja teadusminister uue konkursi korraldamise. Konkurss loetakse luhtunuks, kui konkursil osalemiseks ei esitatud ühtegi taotlust või ükski taotlus ei vastanud esitatud nõuetele. Konkursi luhtumisel otsustab haridus- ja teadusminister uue konkursi korraldamise.",
      "rdfs:label": {
        "@value": "Reg_1043112_Par_7 (redaktsioon 1043112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043112",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043112",
      "estleg:sourceAct": "Riiklike haridusstipendiumide ja -preemiate määramise tingimused ja kord",
      "estleg:provisionRef": "Reg_1043112 § 7",
