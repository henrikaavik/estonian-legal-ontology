      }
    },
    {
      "@id": "estleg:Reg_1043112_Par_8_v1043112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043112_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riiklikke hariduspreemiaid (edaspidi preemia) määratakse väljapaistvate saavutuste eest haridusvaldkonnas. Riiklikke hariduspreemiaid (edaspidi preemia) määratakse väljapaistvate saavutuste eest haridusvaldkonnas. 2 (2) Elutööpreemia määratakse füüsilisele isikule, kelle aastatepikkune panus Eesti haridusse on pälvinud avalikkuse kõrge hinnangu ja kelle kogu senine töö ja ühiskondlik aktiivsus on olnud eeskujuks kaaskodanikele. Elutööpreemia määratakse füüsilisele isikule, kelle aastatepikkune panus Eesti haridusse on pälvinud avalikkuse kõrge hinnangu ja kelle kogu senine töö ja ühiskondlik aktiivsus on olnud eeskujuks kaaskodanikele. 3 (3) Aastapreemia määratakse üldjuhul füüsilisele isikule silmapaistvate tööalaste saavutuste eest viimasel kolmel aastal. Aastapreemia võib määrata ka juriidilisele isikule või asutusele väljapaistvate saavutuste eest haridusvaldkonnas. RT I 2023-02-28 6 128022023006 2023-03-03 Aastapreemia määratakse üldjuhul füüsilisele isikule silmapaistvate tööalaste saavutuste eest viimasel kolmel aastal. Aastapreemia võib määrata ka juriidilisele isikule või asutusele väljapaistvate saavutuste eest haridusvaldkonnas.",
      "rdfs:label": {
        "@value": "Reg_1043112_Par_8 (redaktsioon 1043112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043112",
