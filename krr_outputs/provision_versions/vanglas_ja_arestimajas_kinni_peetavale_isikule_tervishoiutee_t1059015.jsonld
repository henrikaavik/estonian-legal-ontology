    {
      "@id": "estleg:Reg_1059015_Par_7_v1059015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059015_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava tervisekontroll vanglasse saabumisel sisaldab: 1 1) anamneesi võtmist, sh varasemate põetud haiguste ja operatsioonide dokumenteerimist; 2 2) naha- ja koevigastuste fikseerimist; 3 3) psüühilise seisundi hinnangut, sh suitsiidiriski hindamist; 4 4) alkoholi ja narkootikumide tarvitamise kirjeldamist; 5 5) vanglasse saabumise hetkel tervisega seonduvate kaebuste lahendamist; 6 6) röntgenuuringut; 7 7) kaalumist ja kehapikkuse mõõtmist; 8 8) vererõhu mõõtmist; 9 9) vabatahtlikku HIV, HBV ja HCV testimist. Kinnipeetava tervisekontroll vanglasse saabumisel sisaldab: anamneesi võtmist, sh varasemate põetud haiguste ja operatsioonide dokumenteerimist; naha- ja koevigastuste fikseerimist; psüühilise seisundi hinnangut, sh suitsiidiriski hindamist; alkoholi ja narkootikumide tarvitamise kirjeldamist; vanglasse saabumise hetkel tervisega seonduvate kaebuste lahendamist; röntgenuuringut; kaalumist ja kehapikkuse mõõtmist; vererõhu mõõtmist; vabatahtlikku HIV, HBV ja HCV testimist.",
      "rdfs:label": {
        "@value": "Reg_1059015_Par_7 (redaktsioon 1059015)",
        "@language": "et"
      },
