      }
    },
    {
      "@id": "estleg:Reg_1059015_Par_2_v1059015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059015_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vanglas kinni peetavale isikule osutatakse vanglas tervishoiuteenuseid ravikindlustuse seaduse § 30 lõike 1 ja § 32 alusel kehtestatud määrustes sätestatud tingimustel ja korras, arvestades käesolevas paragrahvis sätestatud erisusi. Vanglas kinni peetavale isikule osutatakse vanglas tervishoiuteenuseid ravikindlustuse seaduse § 30 lõike 1 ja § 32 alusel kehtestatud määrustes sätestatud tingimustel ja korras, arvestades käesolevas paragrahvis sätestatud erisusi. 2 (2) Vanglas kinni peetavale isikule ei osutata rakkude, kudede ja elundite hankimise, käitlemise ja siirdamisega seotud teenuseid rakkude, kudede ja elundite käitlemise ja siirdamise seaduse tähenduses. Vanglas kinni peetavale isikule ei osutata rakkude, kudede ja elundite hankimise, käitlemise ja siirdamisega seotud teenuseid rakkude, kudede ja elundite käitlemise ja siirdamise seaduse tähenduses. 3 (3) Vanglas kinni peetavale isikule osutatakse vanglas järgmisi tervishoiuteenuseid: 1 1) arsti vastuvõtt; 2 2) õe vastuvõtt; 3 3) elektrokardiograafia; 4 4) kusepõie püsikateetri paigaldamine; 5 5) hemogramm; 6 6) uriinianalüüs testribaga; 7 7) C-reaktiivse valgu määramine; 8 8) vaktsineerimine; 9 9) röntgeniülesvõtted; 10 10) ultraheliuuringud; 11 11) statsionaarne psühhiaatriline ravi Tartu vanglas; 12 12) statsionaarne tuberkuloosiravi Tallinna vanglas. Vanglas kinni peetavale isikule osutatakse vanglas järgmisi tervishoiuteenuseid: arsti vastuvõtt; õe vastuvõtt; elektrokardiograafia; kusepõie püsikateetri paigaldamine; hemogramm; uriinianalüüs testribaga; C-reaktiivse valgu määramine; vaktsineerimine; röntgeniülesvõtted; ultraheliuuringud; statsionaarne psühhiaatriline ravi Tartu vanglas; statsionaarne tuberkuloosiravi Tallinna vanglas.",
      "rdfs:label": {
        "@value": "Reg_1059015_Par_2 (redaktsioon 1059015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059015",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1059015",
      "estleg:sourceAct": "Vanglas ja arestimajas kinni peetavale isikule tervishoiuteenuste osutamine",
      "estleg:provisionRef": "Reg_1059015 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059015_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1059015_Par_3_v1059015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059015_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vanglas kinni peetavale isikule osutatakse hambaraviteenuseid ravikindlustuse seaduse § 30 lõike 1 ja § 32 alusel kehtestatud määrustes sätestatud tingimustel ja korras, arvestades käesolevas paragrahvis sätestatud erisusi. Vanglas kinni peetavale isikule osutatakse hambaraviteenuseid ravikindlustuse seaduse § 30 lõike 1 ja § 32 alusel kehtestatud määrustes sätestatud tingimustel ja korras, arvestades käesolevas paragrahvis sätestatud erisusi. 2 (2) Hambaraviteenuseid osutatakse hambaarsti otsuse alusel vältimatu haigusseisundi ennetamiseks ja tüsistuste vältimiseks ägeda suuõõne haigusseisundi ja trauma korral, millega kaasneb valu, turse ja üldseisundi halvenemine. Hambaraviteenuseid osutatakse hambaarsti otsuse alusel vältimatu haigusseisundi ennetamiseks ja tüsistuste vältimiseks ägeda suuõõne haigusseisundi ja trauma korral, millega kaasneb valu, turse ja üldseisundi halvenemine. 3 (3) Vanglas kinni peetavale isikule osutatakse vanglas järgmisi hambaraviteenuseid: 1 1) hambaarsti vastuvõtt; 2 2) pinna- või injektsioonanesteesia; 3 3) hamba eemaldamine, sealhulgas raskendatud või sügavalt murdunud hammas; 4 4) mädakolde avamine ja ravimenetlused; 5 5) kirurgilise sekkumisega järelkontroll; 6 6) haava sulgemine õmblustega; 7 7) traumajärgse haava korrastamine ja traumajärgne hamba ettevalmistamine, paigaldamine ja lahastamine kuni kolme hamba ulatuses; 8 8) hamba või implantaadi eemaldamine osteotoomiaga; 9 9) biopsia pindmistest kudedest; 10 10) intraoraalne hambaülesvõte; 11 11) ortopantomogramm; 12 12) subgingivaalne hambakivi eemaldamine; 13 13) hamba pulbi amputatsioon ja alustäidis või ravimivahetus; 14 14) ravimi asetamine pulbiruumi või hamba devitaliseerimine; 15 15) hamba juurekanali avamine ja puhastamine (sealhulgas juurdepääsu rajamine ja ravimi asetamine); 16 16) ravimivahetus hambas koos kanali(te) instrumenteerimisega; 17 17) hamba juurekanali täitmine; 18 18) pinna täidis; 19 19) hambale ajutise täidise paigaldamine; 20 20) hammaste proteesimine arsti otsuse alusel lähtuvalt mälumisfunktsiooni häirumisest. Vanglas kinni peetavale isikule osutatakse vanglas järgmisi hambaraviteenuseid: hambaarsti vastuvõtt; pinna- või injektsioonanesteesia; hamba eemaldamine, sealhulgas raskendatud või sügavalt murdunud hammas; mädakolde avamine ja ravimenetlused; kirurgilise sekkumisega järelkontroll; haava sulgemine õmblustega; traumajärgse haava korrastamine ja traumajärgne hamba ettevalmistamine, paigaldamine ja lahastamine kuni kolme hamba ulatuses; hamba või implantaadi eemaldamine osteotoomiaga; biopsia pindmistest kudedest; intraoraalne hambaülesvõte; ortopantomogramm; subgingivaalne hambakivi eemaldamine; hamba pulbi amputatsioon ja alustäidis või ravimivahetus; ravimi asetamine pulbiruumi või hamba devitaliseerimine; hamba juurekanali avamine ja puhastamine (sealhulgas juurdepääsu rajamine ja ravimi asetamine); ravimivahetus hambas koos kanali(te) instrumenteerimisega; hamba juurekanali täitmine; pinna täidis; hambale ajutise täidise paigaldamine; hammaste proteesimine arsti otsuse alusel lähtuvalt mälumisfunktsiooni häirumisest.",
      "rdfs:label": {
        "@value": "Reg_1059015_Par_3 (redaktsioon 1059015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059015",
