    {
      "@id": "estleg:Reg_300114_Par_2_v300114",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300114_Par_2"
