      "estleg:versionValidFrom": {
        "@value": "2013-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õppekorralduseeskirjas määratakse täiendusõppe kursuste kohta vähemalt järgmist: 1 1) kursuste komplekteerimise kord; 2 2) täiendusõppe õppekava osalise läbimise võimalused ja tingimused; 3 3) kursuste praktilise töö korraldus, muuhulgas tööohutusealase juhendamise kord; 4 4) kursuste praktikakorraldus; 5 5) kursustel õppijate õppetööst osavõtu arvestamise alused; 6 6) kursustel õppijate õigused ja kohustused; 7 7) kursuste eest õppetasu maksmise, sellest vabastamise ja tagastamise tingimused ja kord; 8 8) kursustel õppijate kursuselt väljaarvamise kord. Õppekorralduseeskirjas määratakse täiendusõppe kursuste kohta vähemalt järgmist: kursuste komplekteerimise kord; täiendusõppe õppekava osalise läbimise võimalused ja tingimused; kursuste praktilise töö korraldus, muuhulgas tööohutusealase juhendamise kord; kursuste praktikakorraldus; kursustel õppijate õppetööst osavõtu arvestamise alused; kursustel õppijate õigused ja kohustused; kursuste eest õppetasu maksmise, sellest vabastamise ja tagastamise tingimused ja kord; kursustel õppijate kursuselt väljaarvamise kord.",
      "rdfs:label": {
        "@value": "Reg_1016502_Par_3 (redaktsioon 1016502)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016502",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1016502",
      "estleg:sourceAct": "Kutseõppeasutuses täiendusõppe korraldamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1016502 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1016502_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1016502_Par_4_v1016502",
      "@type": [
