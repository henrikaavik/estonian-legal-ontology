      }
    },
    {
      "@id": "estleg:HLÜS_Par_34_v176884",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HLÜS_Par_34"
      },
      "estleg:versionValidFrom": {
