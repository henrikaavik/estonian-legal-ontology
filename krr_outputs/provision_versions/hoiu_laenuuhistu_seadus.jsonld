      },
      "estleg:versionText": "Käesolev seadus määrab kindlaks hoiu-laenuühistu õigusliku seisundi, tegevuse alused ning asutamise ja lõpetamise korra.",
      "rdfs:label": {
        "@value": "HLÜS_Par_1 (redaktsioon 22437)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22437",
