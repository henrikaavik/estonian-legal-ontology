    {
      "@id": "estleg:HLÜS_Par_14_v22437",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HLÜS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hoiu-laenuühistu äriregistrisse kandmiseks esitab juhatus avalduse, milles näidatakse lisaks tulundusühistuseaduse § 7 lõikes 1 sätestatule osakapitali suurus ja revisjonikomisjoni liikmete nimed, isikukoodid ja elukohad. Avaldusele lisatakse tulundusühistuseaduse § 7 lõikes 1 sätestatule lisaks krediidiasutuse teatis osakapitali sissemaksmise kohta",
      "rdfs:label": {
        "@value": "HLÜS_Par_14 (redaktsioon 22437)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22437",
      "estleg:supersededByVersion": {
