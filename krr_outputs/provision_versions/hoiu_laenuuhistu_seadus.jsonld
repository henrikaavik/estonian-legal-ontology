        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HLÜS_Par_27_v13330637",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HLÜS_Par_27"
      },
      "estleg:versionValidFrom": {
