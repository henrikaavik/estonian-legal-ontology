    {
      "@id": "estleg:Reg_1039196_Par_2_v1039196",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039196_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu pidamise eesmärk on keeldude ja piirangutega seotud õigusrikkumiste tõkestamiseks teabe kogumine ja töötlemine Eesti territooriumile sisenevate ning sealt lahkuvate füüsiliste isikute kohta. Andmekogu pidamise eesmärk on keeldude ja piirangutega seotud õigusrikkumiste tõkestamiseks teabe kogumine ja töötlemine Eesti territooriumile sisenevate ning sealt lahkuvate füüsiliste isikute kohta.",
      "rdfs:label": {
        "@value": "Reg_1039196_Par_2 (redaktsioon 1039196)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039196",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039196",
      "estleg:sourceAct": "Reisijate nimekirjade töötlussüsteemi andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039196 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039196_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039196_Par_3_v1039196",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039196_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu andmeandjad on tolliseaduse § 9 lõikes 1 nimetatud reisijate veoga tegelevad ettevõtjad ja tolliseaduse § 16 lõikes 5 nimetatud valitsusasutused. RT I 2024-12-29 50 129122024050 2025-01-01 Andmekogu andmeandjad on tolliseaduse § 9 lõikes 1 nimetatud reisijate veoga tegelevad ettevõtjad ja tolliseaduse § 16 lõikes 5 nimetatud valitsusasutused.",
      "rdfs:label": {
        "@value": "Reg_1039196_Par_3 (redaktsioon 1039196)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039196",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039196",
      "estleg:sourceAct": "Reisijate nimekirjade töötlussüsteemi andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039196 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039196_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039196_Par_4_v1039196",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039196_Par_4"
      },
