      "estleg:provisionRef": "Reg_311414 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_311414_Map"
      }
    },
    {
      "@id": "estleg:Reg_311414_Par_2_v311414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_311414_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Referentlaboratooriumina tegutsemiseks volituse (edaspidi volitus) taotleja esitab valdkonna eest vastutavale ministrile kirjaliku taotluse, mis sisaldab järgmisi andmeid: RT I 2015-08-29 1 129082015001 2015-09-01 1 1) taotleja ja taotleja esindaja nimi, isiku- või registrikood ning sidevahendite numbrid; 2 2) taotleja aadress; 3 3) taotletava volituse ulatus ja nimekiri kasutatavate analüüsimeetodite kohta, mille kasutamiseks laboratoorium on akrediteeritud; 4 4) laboratooriumi tegevuse korraldamise eest vastutava isiku nimi ja ametikoht. Referentlaboratooriumina tegutsemiseks volituse (edaspidi volitus) taotleja esitab valdkonna eest vastutavale ministrile kirjaliku taotluse, mis sisaldab järgmisi andmeid: taotleja ja taotleja esindaja nimi, isiku- või registrikood ning sidevahendite numbrid; taotleja aadress; taotletava volituse ulatus ja nimekiri kasutatavate analüüsimeetodite kohta, mille kasutamiseks laboratoorium on akrediteeritud; laboratooriumi tegevuse korraldamise eest vastutava isiku nimi ja ametikoht. 2 (2) Taotlusele lisatakse järgmised dokumendid: 1 1) akrediteerimisorgani väljastatud laboratooriumi akrediteeritust tõendava tunnistuse ja selle lisa koopia; 2 2) tegevuskava taotletava volituse ulatuses Euroopa Parlamendi ja nõukogu määruse (EL) 2017/625 artiklis 101 sätestatud nõuete täitmiseks; RT I 2019-12-11 1 111122019001 2019-12-14 3 3) referentlaboratooriumina tegutsemiseks esmakordse volituse andmise taotlemise korral esitatakse andmed riigilõivu tasumise kohta. Taotlusele lisatakse järgmised dokumendid: akrediteerimisorgani väljastatud laboratooriumi akrediteeritust tõendava tunnistuse ja selle lisa koopia; tegevuskava taotletava volituse ulatuses Euroopa Parlamendi ja nõukogu määruse (EL) 2017/625 artiklis 101 sätestatud nõuete täitmiseks; referentlaboratooriumina tegutsemiseks esmakordse volituse andmise taotlemise korral esitatakse andmed riigilõivu tasumise kohta.",
      "rdfs:label": {
        "@value": "Reg_311414_Par_2 (redaktsioon 311414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "311414",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/311414",
      "estleg:sourceAct": "Referentlaboratooriumina tegutsemiseks volituse andmise taotluse sisu nõuded, taotlusele lisatavate dokumentide loetelu ja taotluse menetlemise kord",
      "estleg:provisionRef": "Reg_311414 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_311414_Map"
      }
    },
    {
      "@id": "estleg:Reg_311414_Par_2_2_v311414",
