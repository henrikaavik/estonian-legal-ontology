      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337139_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andmise eesmärk on ohustatud liikide ja elupaigatüüpide soodsa seisundi tagamisele ning kaitstavate loodusobjektide maastikuilme säilitamisele kaasa aitamine. Toetuse andmise eesmärk on ohustatud liikide ja elupaigatüüpide soodsa seisundi tagamisele ning kaitstavate loodusobjektide maastikuilme säilitamisele kaasa aitamine.",
      "rdfs:label": {
