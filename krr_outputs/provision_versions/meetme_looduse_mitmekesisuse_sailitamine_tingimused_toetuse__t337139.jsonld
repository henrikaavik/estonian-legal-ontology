        "@id": "estleg:Reg_337139_Map"
      }
    },
    {
      "@id": "estleg:Reg_337139_Par_5_v337139",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337139_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meetme raames on toetatav järgmine tegevus: 1 1) kaitsekorralduskavade ja tegevuskavade alusel ohustatud elupaikade, ohustatud liikide elupaikade ja ohustatud liikide populatsioonide taastamine ning elupaikade säilitamiseks ja taastamiseks ning kaitstavate loodusobjektide maastikuilme säilitamiseks vajaliku infrastruktuuri rajamine või rekonstrueerimine; 2 2) elupaikade säilitamiseks vajaliku karja soetamine juhul, kui elupaigas pole seni karjatamist toimunud või kui karjatamiskoormus elupaigas on väiksem, kui on sätestatud põllumajandusministri 8. märtsi 2010. a määruse nr 19 «Poolloodusliku koosluse hooldamise toetuse saamise nõuded, toetuse taotlemise ja taotluse menetlemise täpsem kord aastateks 2007–2013» § 4 lõigetes 3 ja 5; RT I 2010 65 481 13357521 2010-09-18 3 3) tegevuskavade alusel võõrliikide arvukuse piiramine; 4 4) kaitstavate looduse üksikobjektide ja maastike soodsa seisundi taastamine; 5 5) kaitstavate parkide restaureerimine ja rekonstrueerimine; 6 6) kaitsekorralduskavade ja tegevuskavade alusel kaitstavate loodusobjektide külastamist suunava infrastruktuuri rajamine; 7 7) kaitstavate loodusobjektide külastamist suunava infrastruktuuri renoveerimine. Meetme raames on toetatav järgmine tegevus: kaitsekorralduskavade ja tegevuskavade alusel ohustatud elupaikade, ohustatud liikide elupaikade ja ohustatud liikide populatsioonide taastamine ning elupaikade säilitamiseks ja taastamiseks ning kaitstavate loodusobjektide maastikuilme säilitamiseks vajaliku infrastruktuuri rajamine või rekonstrueerimine; elupaikade säilitamiseks vajaliku karja soetamine juhul, kui elupaigas pole seni karjatamist toimunud või kui karjatamiskoormus elupaigas on väiksem, kui on sätestatud põllumajandusministri 8. märtsi 2010. a määruse nr 19 «Poolloodusliku koosluse hooldamise toetuse saamise nõuded, toetuse taotlemise ja taotluse menetlemise täpsem kord aastateks 2007–2013» § 4 lõigetes 3 ja 5; tegevuskavade alusel võõrliikide arvukuse piiramine; kaitstavate looduse üksikobjektide ja maastike soodsa seisundi taastamine; kaitstavate parkide restaureerimine ja rekonstrueerimine; kaitsekorralduskavade ja tegevuskavade alusel kaitstavate loodusobjektide külastamist suunava infrastruktuuri rajamine; kaitstavate loodusobjektide külastamist suunava infrastruktuuri renoveerimine.",
      "rdfs:label": {
        "@value": "Reg_337139_Par_5 (redaktsioon 337139)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337139",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337139",
      "estleg:sourceAct": "Meetme „Looduse mitmekesisuse säilitamine” tingimused toetuse avatud taotlemise korral",
      "estleg:provisionRef": "Reg_337139 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_337139_Map"
      }
    },
    {
      "@id": "estleg:Reg_337139_Par_6_v337139",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337139_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meetme raames antav toetus ei ole riigiabi «Konkurentsiseaduse» § 30 lõike 1 tähenduses. Meetme raames antav toetus ei ole riigiabi «Konkurentsiseaduse» § 30 lõike 1 tähenduses.",
      "rdfs:label": {
