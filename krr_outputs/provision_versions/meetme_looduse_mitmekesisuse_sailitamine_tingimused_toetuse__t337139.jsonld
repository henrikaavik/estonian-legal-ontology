    {
      "@id": "estleg:Reg_337139_Par_4_v337139",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337139_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusasutus on vastavalt Vabariigi Valitsuse 19. aprilli 2007. a määruse nr 111 «Perioodi 2007–2013 struktuuritoetuse andmist korraldavate asutuste määramine» § 5 punktile 2 Keskkonnaministeerium (edaspidi rakendusasutus). Rakendusasutus on vastavalt Vabariigi Valitsuse 19. aprilli 2007. a määruse nr 111 «Perioodi 2007–2013 struktuuritoetuse andmist korraldavate asutuste määramine» § 5 punktile 2 Keskkonnaministeerium (edaspidi rakendusasutus). 2 (2) Rakendusüksus on vastavalt Vabariigi Valitsuse 19. aprilli 2007. a määruse nr 111 «Perioodi 2007–2013 struktuuritoetuse andmist korraldavate asutuste määramine» § 6 punktile 1 Sihtasutus Keskkonnainvesteeringute Keskus (edaspidi rakendusüksus). Rakendusüksus on vastavalt Vabariigi Valitsuse 19. aprilli 2007. a määruse nr 111 «Perioodi 2007–2013 struktuuritoetuse andmist korraldavate asutuste määramine» § 6 punktile 1 Sihtasutus Keskkonnainvesteeringute Keskus (edaspidi rakendusüksus).",
      "rdfs:label": {
        "@value": "Reg_337139_Par_4 (redaktsioon 337139)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337139",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337139",
      "estleg:sourceAct": "Meetme „Looduse mitmekesisuse säilitamine” tingimused toetuse avatud taotlemise korral",
      "estleg:provisionRef": "Reg_337139 § 4",
