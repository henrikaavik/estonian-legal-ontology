    {
      "@id": "estleg:Reg_337139_Par_2_v337139",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337139_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määruses kasutatakse mõisteid struktuuritoetuse seaduse ja muude valdkondlike õigusaktide tähenduses. Määruses kasutatakse mõisteid struktuuritoetuse seaduse ja muude valdkondlike õigusaktide tähenduses. 2 (2) Käesoleva määruse tähenduses: 1 1) taotlus on rakendusüksuse kehtestatud vormi kohane dokument koos § 11 lõikes 3 nõutavate lisadega; 2 2) kinnituskiri on toetuse saaja kirjalik, rakendusüksuse nõutavas sõnastuses kinnitus, et toetuse saaja on nõus toetuse taotluse rahuldamise otsuses sätestatud nõuetega ning valmis projekti eesmärgipäraselt ellu viima. Käesoleva määruse tähenduses: taotlus on rakendusüksuse kehtestatud vormi kohane dokument koos § 11 lõikes 3 nõutavate lisadega; kinnituskiri on toetuse saaja kirjalik, rakendusüksuse nõutavas sõnastuses kinnitus, et toetuse saaja on nõus toetuse taotluse rahuldamise otsuses sätestatud nõuetega ning valmis projekti eesmärgipäraselt ellu viima.",
      "rdfs:label": {
        "@value": "Reg_337139_Par_2 (redaktsioon 337139)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337139",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337139",
      "estleg:sourceAct": "Meetme „Looduse mitmekesisuse säilitamine” tingimused toetuse avatud taotlemise korral",
      "estleg:provisionRef": "Reg_337139 § 2",
      "estleg:partOfAct": {
