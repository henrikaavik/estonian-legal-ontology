      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Vanglaametniku teeneteristi ja teenistusmedali kirjeldus ning nende andmise ja kandmise kord (13 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vanglaametniku teeneteristi ja teenistusmedali kirjeldus ning nende andmise ja kandmise kord"
    },
    {
      "@id": "estleg:Reg_309849_Par_1_v309849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309849_Par_1"
