    {
      "@id": "estleg:Reg_309849_Par_10_v309849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309849_Par_10"
