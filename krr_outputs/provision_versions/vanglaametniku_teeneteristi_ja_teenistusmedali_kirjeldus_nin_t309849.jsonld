    {
      "@id": "estleg:Reg_309849_Par_8_v309849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309849_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teeneteristi ning vangla peainspektorile ja sisekaitselise rakenduskõrgkooli korrektsiooni eriala õppejõu ametikohal olevale vanglaametnikule teenistusmedali andmise otsustab valdkonna eest vastutav minister. Teeneteristi ning vangla peainspektorile ja sisekaitselise rakenduskõrgkooli korrektsiooni eriala õppejõu ametikohal olevale vanglaametnikule teenistusmedali andmise otsustab valdkonna eest vastutav minister. 2 (2) Teenistusmedali andmise lõikes 1 nimetamata vanglaametnikule otsustab vangla direktor. Teenistusmedali andmise lõikes 1 nimetamata vanglaametnikule otsustab vangla direktor. 3 (3) Teeneteristi ja teenistusmedali andmine vormistatakse kirjalikult ja dokumenti märgitakse teeneteristi või teenistusmedali järjenumber. RT I 2014-07-31 3 131072014003 2014-08-03 Teeneteristi ja teenistusmedali andmine vormistatakse kirjalikult ja dokumenti märgitakse teeneteristi või teenistusmedali järjenumber.",
      "rdfs:label": {
        "@value": "Reg_309849_Par_8 (redaktsioon 309849)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309849",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309849",
      "estleg:sourceAct": "Vanglaametniku teeneteristi ja teenistusmedali kirjeldus ning nende andmise ja kandmise kord",
