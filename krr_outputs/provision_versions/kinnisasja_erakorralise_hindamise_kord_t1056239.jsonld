      "estleg:versionOf": {
        "@id": "estleg:Reg_1056239_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse § 12 lõige 4 jõustub 1. jaanuaril 2024. a. Käesoleva määruse § 12 lõige 4 jõustub 1. jaanuaril 2024. a.",
      "rdfs:label": {
        "@value": "Reg_1056239_Par_39 (redaktsioon 1056239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056239",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056239",
      "estleg:sourceAct": "Kinnisasja erakorralise hindamise kord",
      "estleg:provisionRef": "Reg_1056239 § 39",
      "estleg:partOfAct": {
