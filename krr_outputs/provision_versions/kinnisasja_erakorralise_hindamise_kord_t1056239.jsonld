    {
      "@id": "estleg:Reg_1056239_Par_17_v1056239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056239_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vahetatavate kinnisasjade hindamisaruanded koostab sama kutseline hindaja, sama menetleja või Maa- ja Ruumiamet, välja arvatud põhjendatud juhtudel. RT I 2024-12-29 4 129122024004 2025-01-01 Vahetatavate kinnisasjade hindamisaruanded koostab sama kutseline hindaja, sama menetleja või Maa- ja Ruumiamet, välja arvatud põhjendatud juhtudel. 2 (2) Vahetatavate kinnisasjade väärtus hinnatakse sama kuupäeva seisuga ja ühetaoliste varade puhul samadel alustel. RT I 2025-03-18 1 118032025001 2025-03-21 Vahetatavate kinnisasjade väärtus hinnatakse sama kuupäeva seisuga ja ühetaoliste varade puhul samadel alustel.",
      "rdfs:label": {
        "@value": "Reg_1056239_Par_17 (redaktsioon 1056239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056239",
