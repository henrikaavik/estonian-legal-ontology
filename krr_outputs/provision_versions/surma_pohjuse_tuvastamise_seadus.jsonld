      }
    },
    {
      "@id": "estleg:SPT_Par_27_v895466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikuandmeteta säilitatud patoanatoomilise lahangu, uuringu, kohtuarstliku lahangu või ekspertiisi käigus eemaldatud elundeid ja koelist materjali võib kasutada õppe- ja teadustöös ilma surnu omaste või tema seadusliku esindaja nõusolekuta. (2) Isikuandmetega säilitatud patoanatoomilise lahangu, uuringu, kohtuarstliku lahangu või ekspertiisi käigus eemaldatud elundeid ja koelist materjali võib kasutada õppe- ja teadustöös ainult surnu omaste või tema seadusliku esindaja nõusolekul.",
      "rdfs:label": {
        "@value": "SPT_Par_27 (redaktsioon 895466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "895466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/895466",
      "estleg:sourceAct": "Surma põhjuse tuvastamise seadus",
      "estleg:provisionRef": "SPT § 27",
      "estleg:partOfAct": {
        "@id": "estleg:SPT_Map_2026"
      }
    },
    {
      "@id": "estleg:SPT_Par_28_v895466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Patoanatoomilise lahangu kulud katab Eesti Haigekassa ravikindlustuse seaduse (RT I 2002, 62, 377; 2003, 20, 116; 88, 591; 2004, 37, 253; 49, 342; 56, 400; 75, 520; 89, 604 ja 614) alusel kehtestatud korras. (2) Patoanatoomilise lahangu kulud, mis on tehtud käesoleva seaduse § 14 lõikes 4 sätestatud juhul, katab patoanatoomilist lahangut taotlenud isik ravikindlustuse seaduse alusel kehtestatud korras nimetatud piirhinna määras. (3) Kui käesoleva seaduse § 14 lõikes 4 nimetatud isikute taotletud juhul tuvastatakse esialgsest surma põhjusest, mis on dokumenteeritud isiku tervishoiuteenuse osutamist tõendavates dokumentides, muu surma põhjus, katab patoanatoomilise lahangu kulud Eesti Haigekassa ravikindlustuse seaduse alusel kehtestatud korras. (4) Kui patoanatoomilise lahangu käigus tuvastatakse, et isiku surm on saabunud kuriteo tagajärjel ning lahang viiakse lõpuni kriminaalmenetluse seadustikus sätestatud korras, kaetakse patoanatoomilise lahangu kulud nagu kohtuarstliku ekspertiisi kulud. Kuni patoanatoomilise lahangu katkestamiseni tehtud lahangu kulud katab Eesti Haigekassa ravikindlustuse seaduse alusel kehtestatud korras.",
      "rdfs:label": {
        "@value": "SPT_Par_28 (redaktsioon 895466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "895466",
      "estleg:supersededByVersion": {
        "@id": "estleg:SPT_Par_28_v12911573"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/895466",
      "estleg:sourceAct": "Surma põhjuse tuvastamise seadus",
      "estleg:provisionRef": "SPT § 28",
      "estleg:partOfAct": {
        "@id": "estleg:SPT_Map_2026"
      }
    },
    {
      "@id": "estleg:SPT_Par_28_v12911573",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
