      },
      "estleg:versionText": "Rahvatervise seaduse (RT I 1995, 57, 978; 1996, 3, 56; 49, 953; 1997, 37/38, 569; 1999, 30, 415; 88, 804; 2001, 23, 128; 2002, 32, 187; 53, 336; 61, 375; 63, 387; 90, 521; 2003, 26, 156 ja 160; 2004, 45, 315; 75, 520; 87, 593) § 8 lõike 3 punkt 2 tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "SPT_Par_42 (redaktsioon 895466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "895466",
