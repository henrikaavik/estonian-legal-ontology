    {
      "@id": "estleg:SPT_Par_37_v895466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui ettekirjutuse saaja jätab ettekirjutuse selles esitatud tähtajaks täitmata, on järelevalvet teostaval ametiisikul õigus sunnivahendina kohaldada sunniraha asendustäitmise ja sunniraha seaduses (RT I 2001, 50, 283; 94, 580) sätestatud korras. (2) Sunniraha ülemmäär on 10 000 krooni.",
      "rdfs:label": {
        "@value": "SPT_Par_37 (redaktsioon 895466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "895466",
