    {
      "@id": "estleg:SPT_Par_34_v895466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kehtestatud nõuete järgimise üle teostab järelevalvet: maavanem, kontrollides perearstide poolt isiku surma fakti ja surma põhjuse tuvastamise nõuetest kinnipidamist ning arstliku surmateatise väljaandmise tingimustest kinnipidamise ning surnu omaste, tema seadusliku esindaja, kohaliku omavalitsuse, Välisministeeriumi, uurimisasutuse või prokuratuuri teavitamise kohustuse täitmist; Tervishoiuamet, kontrollides tervishoiuteenuse osutajate poolt arstliku surmateatise väljaandmise tingimustest kinnipidamist ning surnu omaste, tema seadusliku esindaja, kohaliku omavalitsuse, Välisministeeriumi, uurimisasutuse või prokuratuuri teavitamise suhtes kehtivate erinõuete järgimist vastavalt tervishoiuteenuste korraldamise seadusele.",
      "rdfs:label": {
