    {
      "@id": "estleg:SPT_Par_35_v895466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalve teostajal on õigus oma pädevuse piires: kontrollida käesoleva seaduse täitmist takistamatult ja ette teatamata; siseneda kontrollimiseks takistamatult tervishoiuteenuse osutaja valdusse selle esindaja juuresolekul; nõuda asjakohaseid seletusi ja dokumente, saada dokumendi väljavõtet või koopiat igast talle esitatud asjakohasest dokumendist, kontrollida saadud teavet kohapeal, kasutada asjaolude jäädvustamiseks avalikult tehnikavahendeid, koostada asjaolude fikseerimiseks akt; nõuda õigusrikkumise lõpetamist, esialgse olukorra taastamist või edasiseks õiguspäraseks käitumiseks vajalike toimingute tegemist.",
      "rdfs:label": {
        "@value": "SPT_Par_35 (redaktsioon 895466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "895466",
      "estleg:supersededByVersion": {
        "@id": "estleg:SPT_Par_35_v115032014049"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/895466",
      "estleg:sourceAct": "Surma põhjuse tuvastamise seadus",
      "estleg:provisionRef": "SPT § 35",
      "estleg:partOfAct": {
        "@id": "estleg:SPT_Map_2026"
      }
    },
    {
      "@id": "estleg:SPT_Par_35_v115032014049",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrakaitseorgan võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32 ja 50 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "SPT_Par_35 (redaktsioon 115032014049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014049",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032014049",
      "estleg:sourceAct": "Surma põhjuse tuvastamise seadus",
      "estleg:provisionRef": "SPT § 35",
      "estleg:partOfAct": {
        "@id": "estleg:SPT_Map_2026"
      }
    },
