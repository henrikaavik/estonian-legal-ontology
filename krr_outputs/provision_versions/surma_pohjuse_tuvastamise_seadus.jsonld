    {
      "@id": "estleg:SPT_Par_33_v129062012061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervishoiuteenuse osutajale käesoleva seadusega pandud kohustuste täitmise üle teostab riiklikku järelevalvet Terviseamet, kontrollides: perearstide poolt isiku surma fakti ja surma põhjuse tuvastamise nõuetest kinnipidamist ning arstliku surmateatise väljaandmise tingimustest kinnipidamise ning surnu omaste, tema seadusliku esindaja, kohaliku omavalitsuse, Välisministeeriumi, uurimisasutuse või prokuratuuri teavitamise kohustuse täitmist; tervishoiuteenuse osutajate poolt arstliku surmateatise väljaandmise tingimustest kinnipidamist ning surnu omaste, tema seadusliku esindaja, kohaliku omavalitsuse, Välisministeeriumi, uurimisasutuse või prokuratuuri teavitamise suhtes kehtivate erinõuete järgimist vastavalt tervishoiuteenuste korraldamise seadusele.",
      "rdfs:label": {
        "@value": "SPT_Par_33 (redaktsioon 129062012061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062012061",
