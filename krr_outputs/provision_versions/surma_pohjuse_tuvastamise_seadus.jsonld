        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Surma põhjuse tuvastamine on isiku surma põhjuse väljaselgitamine kas: surnu välisvaatluse, tervishoiuteenuse osutamist tõendavate dokumentide, patoanatoomilise lahangu, kohtuarstliku lahangu või kohtuarstliku ekspertiisi teel.",
      "rdfs:label": {
        "@value": "SPT_Par_4 (redaktsioon 895466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "895466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/895466",
      "estleg:sourceAct": "Surma põhjuse tuvastamise seadus",
      "estleg:provisionRef": "SPT § 4",
      "estleg:partOfAct": {
        "@id": "estleg:SPT_Map_2026"
      }
    },
    {
      "@id": "estleg:SPT_Par_40_v895466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elundite ja kudede siirdamise seaduses (RT I 2002, 21, 118; 53, 336; 63, 387; 110, 660) tehakse järgmised muudatused: paragrahvi 12 täiendatakse lõikega 1 1 järgmises sõnastuses: « (1 1 ) Isiku surma ei või tuvastada arst, kes osaleb otseselt elundite või kudede eemaldamises sellelt surnud isikult või järgnevates siirdamisprotseduurides või kellel on kohustusi elundite või kudede võimalike retsipientide eest hoolitsemisel.»; paragrahvi 12 lõige 2 muudetakse ja sõnastatakse järgmiselt: « (2) Surma tuvastamine toimub vastavalt surma põhjuse tuvastamise seadusele (RT I 2005, 24, 179)».",
      "rdfs:label": {
        "@value": "SPT_Par_40 (redaktsioon 895466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "895466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/895466",
      "estleg:sourceAct": "Surma põhjuse tuvastamise seadus",
      "estleg:provisionRef": "SPT § 40",
      "estleg:partOfAct": {
        "@id": "estleg:SPT_Map_2026"
      }
    },
    {
      "@id": "estleg:SPT_Par_42_v895466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
