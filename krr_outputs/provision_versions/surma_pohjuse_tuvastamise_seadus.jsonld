      }
    },
    {
      "@id": "estleg:SPT_Par_24_v1036422",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Surnukeha võib üle anda õppe- ja teadustööks, kui: isiku surm on tuvastatud käesolevas seaduses sätestatud korras, [Punkti 2 sõnastus kuni 31. 07. 2006] surnu oli Eesti kodanik või ta viibis Eestis pikaajalise elaniku elamisloa alusel, [Punkti 2 sõnastus alates 1. 08. 2006] surnu oli Eesti kodanik või ta viibis Eestis pikaajalise elaniku elamisloa või elamisõiguse alusel, surnud isik avaldas eluajal tahet loovutada surmajärgselt oma keha õppe- ja teadustööks või puuduvad andmed selle kohta, et ta oleks olnud selle vastu ning sellega ei takistata surnu kohtuarstlikku lahangut või kohtuarstlikku ekspertiisi. (2) Kui puuduvad andmed surnud isiku eluajal väljendatud arvamuse kohta, selgitatakse surnud isiku eluaegne tahe välja surnu omaste kaudu. (3) Teised isikud ei või keelata surnukeha üleandmist õppe- ja teadustööks, kui surnu on seda eluajal soovinud ja oma tahet väljendanud.",
      "rdfs:label": {
        "@value": "SPT_Par_24 (redaktsioon 1036422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036422",
      "estleg:supersededByVersion": {
        "@id": "estleg:SPT_Par_24_v12825113"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036422",
      "estleg:sourceAct": "Surma põhjuse tuvastamise seadus",
      "estleg:provisionRef": "SPT § 24",
      "estleg:partOfAct": {
        "@id": "estleg:SPT_Map_2026"
      }
    },
    {
      "@id": "estleg:SPT_Par_24_v12825113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SPT_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Surnukeha võib üle anda õppe- ja teadustööks, kui: isiku surm on tuvastatud käesolevas seaduses sätestatud korras, surnu oli Eesti kodanik või ta viibis Eestis pikaajalise elaniku elamisloa või elamisõiguse alusel, surnud isik avaldas eluajal tahet loovutada surmajärgselt oma keha õppe- ja teadustööks või puuduvad andmed selle kohta, et ta oleks olnud selle vastu ning sellega ei takistata surnu kohtuarstlikku lahangut või kohtuarstlikku ekspertiisi. (2) Kui puuduvad andmed surnud isiku eluajal väljendatud arvamuse kohta, selgitatakse surnud isiku eluaegne tahe välja surnu omaste kaudu. (3) Teised isikud ei või keelata surnukeha üleandmist õppe- ja teadustööks, kui surnu on seda eluajal soovinud ja oma tahet väljendanud.",
      "rdfs:label": {
        "@value": "SPT_Par_24 (redaktsioon 12825113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12825113",
