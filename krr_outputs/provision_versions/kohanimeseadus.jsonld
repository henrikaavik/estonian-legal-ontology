      }
    },
    {
      "@id": "estleg:kohanimeseadus_Par_21_v733537",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi- ja omavalitsusorganite dokumentides, maakaartidel, teabelevis, avalikel siltidel, viitadel ja kuulutustes, samuti juriidiliste isikute aadressides tuleb kasutada ametlikku kohanime. (2) kehtetu - (3) Uurimustes ning õppe- ja teatmekirjanduses kasutatakse eeskätt ametlikku ja eestikeelset kohanime, millele võib lisada mitteametliku ja võõrkeelse nimekuju. (4) Kui kohale on määratud põhi- ja rööpnimi (§ 16 lg. 2), tuleb riigi- ja omavalitsusorganite dokumentides, maakaartidel, avalikel siltidel, viitadel ja kuulutustes kasutada mõlemat nime kohanime määramise aktis antud järjekorras. Samal viisil ja juhtudel võib kasutada nimekuju, mis on kirjutatud oma kirjakeelega eesti murde õigekirjas. (5) Vabariigi Valitsus võib lisaks käesoleva paragrahvi lõigetele 1-4 määrata juhtumeid, kus ametliku kohanime kasutamine on kohustuslik.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_21 (redaktsioon 733537)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "733537",
      "estleg:supersededByVersion": {
        "@id": "estleg:kohanimeseadus_Par_21_v733937"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:kohanimeseadus_Par_21_v733937",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohanimenõukogu täidab järgmisi ülesandeid: kinnitab otsusega ametlikud kohanimed nimeobjektidele, millele kohanimemääraja ei ole kohanime määranud ja millele ametliku kohanime andmine on vajalik või seda taotleb huvitatud isik; nõustab kohanimemäärajaid ning annab nende taotlusel oma arvamuse; vajaduse korral teeb kohanimemäärajaile regionaalministri kaudu ettepanekuid kohanimede määramiseks; jälgib kohanimede kasutamist ning vajaduse korral teeb regionaalministri kaudu ettepanekuid nende vastavusse viimiseks õigusaktide nõuetega; teeb regionaalministri kaudu ettepanekuid kohanimede määramist ja kasutamist reguleerivate õigusaktide muutmiseks; osaleb kohanimeloendite koostamisel, korrastamisel ja avaldamisel; lahendab kohtueelseid nimevaidlusi; täidab teisi põhimäärusest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_21 (redaktsioon 733937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "733937",
      "estleg:supersededByVersion": {
        "@id": "estleg:kohanimeseadus_Par_21_v102052013003"
      },
      "estleg:versionValidTo": {
        "@value": "2013-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:kohanimeseadus_Par_21_v102052013003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohanimenõukogu täidab järgmisi ülesandeid: kinnitab otsusega ametlikud kohanimed nimeobjektidele, millele kohanimemääraja ei ole kohanime määranud ja millele ametliku kohanime andmine on vajalik või seda taotleb huvitatud isik; nõustab kohanimemäärajaid ning annab nende taotlusel oma arvamuse; vajaduse korral teeb kohanimemäärajaile regionaalministri kaudu ettepanekuid kohanimede määramiseks; jälgib kohanimede kasutamist ning vajaduse korral teeb regionaalministri kaudu ettepanekuid nende vastavusse viimiseks õigusaktide nõuetega; teeb regionaalministri kaudu ettepanekuid kohanimede määramist ja kasutamist reguleerivate õigusaktide muutmiseks; osaleb kohanimeloendite koostamisel, korrastamisel ja avaldamisel; vajaduse korral kinnitab liigisõnaga kohanimekujule liigisõnata kohanimekuju ja liigisõnata kohanimekujule liigisõnaga kohanimekuju; lahendab kohtueelseid nimevaidlusi; täidab teisi põhimäärusest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_21 (redaktsioon 102052013003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102052013003",
      "estleg:supersededByVersion": {
        "@id": "estleg:kohanimeseadus_Par_21_v114032014053"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:kohanimeseadus_Par_21_v114032014053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohanimenõukogu täidab järgmisi ülesandeid: kinnitab otsusega ametlikud kohanimed nimeobjektidele, millele kohanimemääraja ei ole kohanime määranud ja millele ametliku kohanime andmine on vajalik või seda taotleb huvitatud isik; nõustab kohanimemäärajaid ning annab nende taotlusel oma arvamuse; vajaduse korral teeb kohanimemäärajaile valdkonna eest vastutava ministri kaudu ettepanekuid kohanimede määramiseks; jälgib kohanimede kasutamist ning vajaduse korral teeb valdkonna eest vastutava ministri kaudu ettepanekuid nende vastavusse viimiseks õigusaktide nõuetega; teeb valdkonna eest vastutava ministri kaudu ettepanekuid kohanimede määramist ja kasutamist reguleerivate õigusaktide muutmiseks; osaleb kohanimeloendite koostamisel, korrastamisel ja avaldamisel; vajaduse korral kinnitab liigisõnaga kohanimekujule liigisõnata kohanimekuju ja liigisõnata kohanimekujule liigisõnaga kohanimekuju; lahendab kohtueelseid nimevaidlusi; täidab teisi põhimäärusest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_21 (redaktsioon 114032014053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014053",
      "estleg:supersededByVersion": {
        "@id": "estleg:kohanimeseadus_Par_21_v113112020003"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:kohanimeseadus_Par_21_v113112020003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohanimenõukogu täidab järgmisi ülesandeid: kinnitab otsusega ametlikud kohanimed nimeobjektidele, millele kohanimemääraja ei ole kohanime määranud ja millele ametliku kohanime andmine on vajalik või seda taotleb huvitatud isik; nõustab kohanimemäärajaid ning annab nende taotlusel oma arvamuse; vajaduse korral teeb kohanimemäärajaile valdkonna eest vastutava ministri kaudu ettepanekuid kohanimede määramiseks; jälgib kohanimede kasutamist ning vajaduse korral teeb valdkonna eest vastutava ministri kaudu ettepanekuid nende vastavusse viimiseks õigusaktide nõuetega; teeb valdkonna eest vastutava ministri kaudu ettepanekuid kohanimede määramist ja kasutamist reguleerivate õigusaktide muutmiseks; osaleb kohanimeloendite koostamisel, korrastamisel ja avaldamisel; vajaduse korral kinnitab liigisõnaga kohanimekujule liigisõnata kohanimekuju ja liigisõnata kohanimekujule liigisõnaga kohanimekuju; esitab nimevaidlustes seisukohti; täidab teisi põhimäärusest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_21 (redaktsioon 113112020003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113112020003"
    },
    {
      "@id": "estleg:kohanimeseadus_Par_22_v22366",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mitteametlikku kohanime võib kasutada kõigil juhtudel, kui seadus ei nõua ametliku kohanime kasutamist või kohale ei ole käesolevas seaduses sätestatud korras määratud ametlikku kohanime. (2) Mitteametliku kohanime kasutamine avalikkusele suunatud informatsioonis ei tohi olla eksitav. (3) Mitteametliku kohanime kandmiseks Eesti põhikaardile küsitakse kohanimenõukogu arvamust ning arvestatakse käesoleva seaduse paragrahvides 14, 15 ja 17 esitatud nõudeid.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_22 (redaktsioon 22366)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22366",
      "estleg:supersededByVersion": {
        "@id": "estleg:kohanimeseadus_Par_22_v215134"
      },
      "estleg:versionValidTo": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:kohanimeseadus_Par_22_v215134",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mitteametlikku kohanime võib kasutada kõigil juhtudel, kui seadus ei nõua ametliku kohanime kasutamist või kohale ei ole käesolevas seaduses sätestatud korras määratud ametlikku kohanime. (2) Mitteametliku kohanime kasutamine avalikkusele suunatud informatsioonis ei tohi olla eksitav. (3) Mitteametliku kohanime kandmiseks Eesti põhikaardile küsitakse kohanimenõukogu arvamust ning arvestatakse käesoleva seaduse §-des 14, 15 ja 17 esitatud nõudeid.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_22 (redaktsioon 215134)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "215134",
      "estleg:supersededByVersion": {
        "@id": "estleg:kohanimeseadus_Par_22_v733937"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:kohanimeseadus_Par_22_v733937",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohanimenõukogul on õigus saada riigi- ja kohaliku omavalitsuse asutustelt ja organitelt ning teistelt juriidilistelt ja füüsilistelt isikutelt oma ülesannete täitmiseks vajalikke andmeid ja dokumente. (2) Kohanimenõukogu võib kohanimemäärajalt nõuda kohanime valiku kirjalikku põhjendust.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_22 (redaktsioon 733937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "733937",
      "estleg:supersededByVersion": {
        "@id": "estleg:kohanimeseadus_Par_22_v113112020003"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:kohanimeseadus_Par_22_v113112020003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohanimenõukogul on õigus saada riigi- ja kohaliku omavalitsuse üksuse asutustelt ja organitelt ning teistelt juriidilistelt ja füüsilistelt isikutelt oma ülesannete täitmiseks vajalikke andmeid ja dokumente. (2) Kohanimenõukogu võib kohanimemäärajalt nõuda kohanime valiku kirjalikku põhjendust.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_22 (redaktsioon 113112020003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113112020003"
    },
    {
      "@id": "estleg:kohanimeseadus_Par_23_v22366",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_23 (redaktsioon 22366)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22366",
