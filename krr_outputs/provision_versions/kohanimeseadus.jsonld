    {
      "@id": "estleg:kohanimeseadus_Par_3_1_v113112020003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_3_1"
      },
      "estleg:versionValidFrom": {
