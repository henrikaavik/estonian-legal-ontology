    },
    {
      "@id": "estleg:kohanimeseadus_Par_15_v733937",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:kohanimeseadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mitteametlikku kohanime võib kasutada, kui käesoleva seaduse § 14 lõige 1 ei nõua ametliku kohanime kasutamist või kui nimeobjektile ei ole määratud ametlikku kohanime. (2) Mitteametliku kohanime kasutamine avalikkusele suunatud informatsioonis ei tohi olla eksitav.",
      "rdfs:label": {
        "@value": "kohanimeseadus_Par_15 (redaktsioon 733937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "733937",
