      "estleg:provisionRef": "Reg_1043883 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043883_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043883_Par_31_v1043883",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
