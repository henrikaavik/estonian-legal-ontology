    {
      "@id": "estleg:Reg_1043883_Par_25_v1043883",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043883_Par_25"
