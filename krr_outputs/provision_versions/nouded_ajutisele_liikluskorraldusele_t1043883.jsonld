    },
    {
      "@id": "estleg:Reg_1043883_Par_29_v1043883",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043883_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kergliiklustee kohal paikneva takistuse alumine äär tuleb tähistada, kui takistuse tõttu on kergliiklustee kõrgusgabariit alla 2,5 meetri. Kergliiklustee kohal paikneva takistuse alumine äär tuleb tähistada, kui takistuse tõttu on kergliiklustee kõrgusgabariit alla 2,5 meetri.",
      "rdfs:label": {
        "@value": "Reg_1043883_Par_29 (redaktsioon 1043883)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043883",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043883",
      "estleg:sourceAct": "Nõuded ajutisele liikluskorraldusele",
      "estleg:provisionRef": "Reg_1043883 § 29",
