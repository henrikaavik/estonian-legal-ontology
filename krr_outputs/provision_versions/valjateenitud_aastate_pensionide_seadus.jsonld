    {
      "@id": "estleg:VAP_Par_5_1_v187264",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_5_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljateenitud aastate pensionile õigust andvat staaži, välja arvatud käesoleva seaduse §-s 6 sätestatud pensionistaaži, arvestatakse tööperioodide summana.",
      "rdfs:label": {
        "@value": "VAP_Par_5_1 (redaktsioon 187264)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "187264"
    },
    {
      "@id": "estleg:VAP_Par_5_2_v187264",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_5_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljateenitud aastate pensionile õigust andva staaži kindlaksmääramisel lähtutakse ümardamata staažist.",
      "rdfs:label": {
        "@value": "VAP_Par_5_2 (redaktsioon 187264)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "187264",
      "estleg:supersededByVersion": {
        "@id": "estleg:VAP_Par_5_2_v920679"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VAP_Par_5_2_v920679",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_5_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljateenitud aastate pensionile õigust andva staaži kindlaksmääramisel lähtutakse ümardamata staažist. [Paragrahvi 6 sõnastus kuni 31. 12. 2005]",
      "rdfs:label": {
        "@value": "VAP_Par_5_2 (redaktsioon 920679)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "920679",
      "estleg:supersededByVersion": {
        "@id": "estleg:VAP_Par_5_2_v12750521"
      },
      "estleg:versionValidTo": {
        "@value": "2006-11-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VAP_Par_5_2_v12750521",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_5_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljateenitud aastate pensionile õigust andva staaži kindlaksmääramisel lähtutakse ümardamata staažist.",
      "rdfs:label": {
        "@value": "VAP_Par_5_2 (redaktsioon 12750521)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12750521"
    },
    {
      "@id": "estleg:VAP_Par_6_v187264",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mõne kutseala spetsialistidele (§ 12 viimane lõik ja § 13 punktid 2, 3, 4) väljateenitud aastate pensioni määramiseks vajalik üldine pensionistaaž tehakse kindlaks riikliku pensionikindlustuse seaduse (RT I 1998, 64/65, 1009; 1999, 10, 150; 97, 857) §-de 18 ja 20 alusel.",
      "rdfs:label": {
        "@value": "VAP_Par_6 (redaktsioon 187264)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "187264",
      "estleg:supersededByVersion": {
        "@id": "estleg:VAP_Par_6_v920679"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VAP_Par_6_v920679",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mõne kutseala spetsialistidele (§ 12 viimane lõik ja § 13 punktid 2, 3, 4) väljateenitud aastate pensioni määramiseks vajalik üldine pensionistaaž tehakse kindlaks riikliku pensionikindlustuse seaduse (RT I 1998, 64/65, 1009; 1999, 10, 150; 97, 857) §-de 18 ja 20 alusel. [Paragrahvi 6 sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "VAP_Par_6 (redaktsioon 920679)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "920679",
      "estleg:supersededByVersion": {
        "@id": "estleg:VAP_Par_6_v12750521"
      },
      "estleg:versionValidTo": {
        "@value": "2006-11-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VAP_Par_6_v12750521",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mõne kutseala spetsialistidele (§ 12 teine lõik ja § 13 punktid 2–4) väljateenitud aastate pensioni määramiseks vajalik pensionistaaž tehakse kindlaks riikliku pensionikindlustuse seaduse ja okupatsioonirežiimide poolt represseeritud isiku seaduse alusel.",
      "rdfs:label": {
        "@value": "VAP_Par_6 (redaktsioon 12750521)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12750521"
    },
    {
      "@id": "estleg:VAP_Par_6_1_v187264",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_6_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljateenitud aastate pension määratakse käesoleva seadusega sätestatud tingimuste olemasolul isikule, kellel on vähemalt 15-aastane Eestis omandatud pensionistaaž.",
      "rdfs:label": {
        "@value": "VAP_Par_6_1 (redaktsioon 187264)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "187264"
    },
    {
      "@id": "estleg:VAP_Par_6_2_v106072018023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_6_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljateenitud aastate pensionile õigust andva staaži hulka arvatakse ka enne käesoleva seaduse jõustumist käesolevas seaduses nimetatud kutsealal või ametikohal töötatud aeg.",
      "rdfs:label": {
        "@value": "VAP_Par_6_2 (redaktsioon 106072018023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072018023"
    },
    {
      "@id": "estleg:VAP_Par_7_v187264",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljateenitud aastate pension määratakse pensionitaotluse esitamise päevast. Väljateenitud aastate pension määratakse eluajaks. Väljateenitud aastate pensioni saajal, kellel on õigus pensionile riikliku pensionikindlustuse seaduse alusel, on õigus taotleda nimetatud seaduse alusel pensioni määramist mis tahes ajal pärast pensioni saamise õiguse tekkimist.",
      "rdfs:label": {
        "@value": "VAP_Par_7 (redaktsioon 187264)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "187264"
    },
    {
