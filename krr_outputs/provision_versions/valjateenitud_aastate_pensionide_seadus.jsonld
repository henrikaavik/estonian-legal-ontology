        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VAP_Par_11_1 (redaktsioon 122022023015)",
        "@language": "et"
