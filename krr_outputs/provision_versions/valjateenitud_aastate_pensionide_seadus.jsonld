    {
      "@id": "estleg:VAP_Par_17_v187264",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikule, kellele oli määratud või kellele määratakse väljateenitud aastate pension algtähtajaga enne 2000. aasta 1. aprilli, arvutatakse pension ümber ning kui ümberarvutatud pension osutub väiksemaks makstud pensionist, jätkatakse pensioni maksmist endises suuruses kuni määratud tähtajani.",
      "rdfs:label": {
        "@value": "VAP_Par_17 (redaktsioon 187264)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "187264",
      "estleg:supersededByVersion": {
        "@id": "estleg:VAP_Par_17_v920679"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VAP_Par_17_v920679",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VAP_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikule, kellele oli määratud või kellele määratakse väljateenitud aastate pension algtähtajaga enne 2000. aasta 1. aprilli, arvutatakse pension ümber ning kui ümberarvutatud pension osutub väiksemaks makstud pensionist, jätkatakse pensioni maksmist endises suuruses kuni määratud tähtajani. [Paragrahv 18 jõustub 1. 01. 2006]",
      "rdfs:label": {
        "@value": "VAP_Par_17 (redaktsioon 920679)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "920679",
      "estleg:supersededByVersion": {
