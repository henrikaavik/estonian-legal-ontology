  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_eesti_vabariigis_pollumajanduse_ja_maaelu_arendamise_liitumi_t156552_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotluse hindamise kord (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotluse hindamise kord"
    },
    {
      "@id": "estleg:Reg_156552_Par_1_v156552",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156552_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib «Euroopa Ühenduste Komisjoni, kes esindab Euroopa Ühendust, ja Eesti Vabariigi vahel sõlmitud Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi mitmeaastase rahastuslepingu ratifitseerimise seaduse» (edaspidi vastavalt leping või ratifitseerimise seadus) alusel Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames külade taastamise ja arendamise investeeringuteks antava investeeringutoetuse (edaspidi toetus) taotlemiseks esitatud taotluse ja arengukava hindamise meetodit ja korda ja kehtestab taotluse ja arengukava ratifitseerimise seaduses, lepingus ja lepingu kohaselt kinnitatud põllumajanduse ja maaelu arenguprogrammi (edaspidi programm) lisas 6 nimetatud toetuse saamiseks esitatud nõuetele vastavad hindamiskriteeriumid.",
      "rdfs:label": {
        "@value": "Reg_156552_Par_1 (redaktsioon 156552)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156552",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156552",
      "estleg:sourceAct": "Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotluse hindamise kord",
      "estleg:provisionRef": "Reg_156552 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156552_Map"
      }
    },
    {
      "@id": "estleg:Reg_156552_Par_2_v156552",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156552_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ratifitseerimise seaduse § 2 lõike 1 alusel ja korras toetuse taotlemiseks esitatud taotluse ja arengukava hindamisel arvestatavad hindamiskriteeriumid on: 1) kavandatava investeeringuobjekti (edaspidi investeeringuobjekt) sobivus programmi lisa 6 kuuenda meetme (edaspidi meede) eesmärkidega, sealhulgas investeeringuobjekti kulutõhusus; 2) investeeringuobjekti vastavus vastava küla või külade (edaspidi piirkond ) arenguvajadustele. (2) Lõikes 1 nimetatud hindamiskriteeriumitele vastavuse hindamiseks võrreldakse esitatud taotlust ja arengukava ning antakse hinnang investeeringuobjekti vajalikkuse ja sobivuse kohta.",
      "rdfs:label": {
        "@value": "Reg_156552_Par_2 (redaktsioon 156552)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156552",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156552",
      "estleg:sourceAct": "Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotluse hindamise kord",
      "estleg:provisionRef": "Reg_156552 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156552_Map"
      }
    },
    {
      "@id": "estleg:Reg_156552_Par_3_v156552",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156552_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hinnangu andmise korral investeeringuobjekti sobivusele meetme eesmärkidega on maksimaalselt võimalik anda: 1) kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt suurendab piirkonna elukvaliteeti; 2) kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt suurendab piirkonna arengut; 3) kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt suurendab piirkonna elanike omaalgatust ja võimalust teha koostööd; 4) kuni 10 hindepunkti lähtuvalt sellest, millisel määral on arengukava koostamise protsessi kaasatud piirkonna elanikke; 5) kuni 25 hindepunkti lähtuvalt sellest, millisel määral on investeeringuobjekti kavandatav majandamine tegelikkuses teostatav; 6) kuni 5 hindepunkti lähtuvalt sellest, millisel määral on investeeringuobjekti kavandatav kasutajate arv vastavuses investeeringuobjektile tehtavate kulutustega.",
      "rdfs:label": {
        "@value": "Reg_156552_Par_3 (redaktsioon 156552)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156552",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156552",
      "estleg:sourceAct": "Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotluse hindamise kord",
      "estleg:provisionRef": "Reg_156552 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156552_Map"
      }
    },
    {
      "@id": "estleg:Reg_156552_Par_4_v156552",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156552_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hinnangu andmise korral investeeringuobjekti vastavusele piirkonna arenguvajadustele on maksimaalselt võimalik anda: 1) kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt vastab arengukavas sätestatud arengueeldustele; 2) kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt vastab arengukavas sätestatud strateegilistele eesmärkidele või arengusuundadele; 3) kuni 10 hindepunkti lähtuvalt sellest, millisel määral investeeringuobjekt on kajastatud arengukavas märgitud tegevustes.",
      "rdfs:label": {
        "@value": "Reg_156552_Par_4 (redaktsioon 156552)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156552",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156552",
      "estleg:sourceAct": "Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotluse hindamise kord",
      "estleg:provisionRef": "Reg_156552 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156552_Map"
      }
    },
    {
      "@id": "estleg:Reg_156552_Par_5_v156552",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156552_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paragrahvis 2 nimetatud hindamiskriteeriumidele vastavuse hindamiseks annab ratifitseerimise seaduse § 2 lõike 2 alusel ja korras maavanemale arvamuse kujundamiseks moodustatud nõuandev komisjon hindepunkte, võrreldes selleks ka taotluses ja arengukavas märgitud andmeid omavahel. (2) Paragrahvis 2 nimetatud hindamiskriteeriumidele vastavuse hindamine toimub ratifitseerimise seaduse § 2 lõike 2 alusel kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_156552_Par_5 (redaktsioon 156552)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156552",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156552",
      "estleg:sourceAct": "Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotluse hindamise kord",
      "estleg:provisionRef": "Reg_156552 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156552_Map"
      }
    },
    {
      "@id": "estleg:Reg_156552_Par_6_v156552",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156552_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajanduse Registrite ja Informatsiooni Amet koostab taotluste paremusjärjestuse maakonna kohta arvestades maavanema koostatud paremusjärjestust. Paremusjärjestusest jäetakse välja need taotlejad, kelle taotlus on jäetud rahuldamata ratifitseerimise seaduse § 8 lõike 2 alusel. Peaminister Juhan PARTS Põllumajandusminister Tiit TAMMSAAR Riigisekretär Aino LEPIK von WIRÉN",
      "rdfs:label": {
        "@value": "Reg_156552_Par_6 (redaktsioon 156552)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156552",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156552",
      "estleg:sourceAct": "Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi raames antava külade taastamise ja arendamise investeeringutoetuse taotluse hindamise kord",
      "estleg:provisionRef": "Reg_156552 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156552_Map"
      }
    },
    {
