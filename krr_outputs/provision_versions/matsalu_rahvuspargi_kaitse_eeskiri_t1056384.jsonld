      }
    },
    {
      "@id": "estleg:Reg_1056384_Par_15_v1056384",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056384_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Poollooduslike koosluste aladel on nende ilme ja liigikoosseisu taastamiseks ja säilitamiseks vajalik niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ja harvendamine või eemaldamine ning kanalite või kraavide alaline või ajutine sulgemine. Poollooduslike koosluste aladel on nende ilme ja liigikoosseisu taastamiseks ja säilitamiseks vajalik niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ja harvendamine või eemaldamine ning kanalite või kraavide alaline või ajutine sulgemine.",
      "rdfs:label": {
        "@value": "Reg_1056384_Par_15 (redaktsioon 1056384)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056384",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056384",
      "estleg:sourceAct": "Matsalu rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056384 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056384_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056384_Par_16_v1056384",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056384_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu loodusreservaati ega sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu loodusreservaati ega sihtkaitsevööndisse. 2 (2) Kaitsealal on kaks piiranguvööndit: 1 1) Matsalu piiranguvöönd; 2 2) Parkide piiranguvöönd. Kaitsealal on kaks piiranguvööndit: Matsalu piiranguvöönd; Parkide piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1056384_Par_16 (redaktsioon 1056384)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056384",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056384",
      "estleg:sourceAct": "Matsalu rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056384 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056384_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056384_Par_17_v1056384",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056384_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Matsalu piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja kaitsealuste liikide kaitse; maa kasutamisest mõjutatud traditsioonilise maastikuilme, sealhulgas maastikus mosaiikselt paiknevate poollooduslike koosluste, puistute ja märgalade säilitamine ning taastamine; miljööväärtusliku kultuuripärandi, sealhulgas taluarhitektuuri, traditsioonilise asustusstruktuuri ja rahvakultuuri ning ajaloolis-kultuuriliste objektide kaitse ja säilitamine. Matsalu piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja kaitsealuste liikide kaitse; maa kasutamisest mõjutatud traditsioonilise maastikuilme, sealhulgas maastikus mosaiikselt paiknevate poollooduslike koosluste, puistute ja märgalade säilitamine ning taastamine; miljööväärtusliku kultuuripärandi, sealhulgas taluarhitektuuri, traditsioonilise asustusstruktuuri ja rahvakultuuri ning ajaloolis-kultuuriliste objektide kaitse ja säilitamine. 2 (2) Parkide piiranguvööndi kaitse-eesmärk on Metsküla allee, Haeska, Kiideva, Kloostri, Matsalu, Penijõe, Saastna, Suure-Rõude ja Väike-Rõude mõisa pargi ajalooliselt kujunenud planeeringu, dendroloogiliselt, kultuurilooliselt, ökoloogiliselt, esteetiliselt ja puhkemajanduslikult väärtusliku puistu säilitamine koos edasise kasutamise ja arendamise suunamisega. Parkide piiranguvööndi kaitse-eesmärk on Metsküla allee, Haeska, Kiideva, Kloostri, Matsalu, Penijõe, Saastna, Suure-Rõude ja Väike-Rõude mõisa pargi ajalooliselt kujunenud planeeringu, dendroloogiliselt, kultuurilooliselt, ökoloogiliselt, esteetiliselt ja puhkemajanduslikult väärtusliku puistu säilitamine koos edasise kasutamise ja arendamise suunamisega.",
      "rdfs:label": {
        "@value": "Reg_1056384_Par_17 (redaktsioon 1056384)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056384",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056384",
      "estleg:sourceAct": "Matsalu rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056384 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056384_Map"
      }
    },
