      "dc:source": "Hiiu maakonna kaitsealuste looduse üksikobjektide kaitse alt väljaarvamine"
    },
    {
      "@id": "estleg:Reg_1047607_Par_1_v1047607",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047607_Par_1"
