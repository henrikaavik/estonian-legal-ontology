        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014023"
    },
    {
      "@id": "estleg:KaevS_Par_19_v260798",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KaevS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindajal ja tõendajal peab olema vastutuskindlustus kindlustussumma ulatuses, mis tagab tema tegevuse tõttu kolmandale isikule tekkida võiva kogu kahju hüvitamise ja mis on vähemalt 500 000 krooni. (2) Kui kindlustusleping on sõlmitud omavastutusega, hüvitab kindlustusandja tekitatud kahju kogu ulatuses ja nõuab omavastutuse summa tagasi kindlustusvõtjalt.",
      "rdfs:label": {
        "@value": "KaevS_Par_19 (redaktsioon 260798)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "260798",
      "estleg:supersededByVersion": {
        "@id": "estleg:KaevS_Par_19_v13329176"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KaevS_Par_19_v13329176",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KaevS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindajal ja tõendajal peab olema vastutuskindlustus kindlustussumma ulatuses, mis tagab tema tegevuse tõttu kolmandale isikule tekkida võiva kogu kahju hüvitamise ja mis on vähemalt 31 950 eurot. (2) Kui kindlustusleping on sõlmitud omavastutusega, hüvitab kindlustusandja tekitatud kahju kogu ulatuses ja nõuab omavastutuse summa tagasi kindlustusvõtjalt.",
      "rdfs:label": {
        "@value": "KaevS_Par_19 (redaktsioon 13329176)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329176",
      "estleg:supersededByVersion": {
