      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KaevS_Par_19_v129062014023",
      "@type": [
        "owl:NamedIndividual",
