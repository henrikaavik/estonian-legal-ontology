      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062744_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotluse rahuldamise otsus tunnistatakse kehtetuks ja toetuse saaja maksab toetuse tagasi järgmistel juhtudel: 1 1) ilmnevad asjaolud, mille kohaselt taotlust ei oleks rahuldatud; 2 2) toetuse saaja loobub toetusest; 3 3) toetuse saaja ei ole kinni pidanud käesolevas määruses sätestatust. Taotluse rahuldamise otsus tunnistatakse kehtetuks ja toetuse saaja maksab toetuse tagasi järgmistel juhtudel: ilmnevad asjaolud, mille kohaselt taotlust ei oleks rahuldatud; toetuse saaja loobub toetusest; toetuse saaja ei ole kinni pidanud käesolevas määruses sätestatust.",
      "rdfs:label": {
        "@value": "Reg_1062744_Par_11 (redaktsioon 1062744)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062744",
