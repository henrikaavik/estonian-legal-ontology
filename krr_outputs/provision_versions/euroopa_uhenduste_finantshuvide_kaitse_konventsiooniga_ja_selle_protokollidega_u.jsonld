  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_euroopa_uhenduste_finantshuvide_kaitse_konventsiooniga_ja_selle_protokollidega_u_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Euroopa ühenduste finantshuvide kaitse konventsiooniga ja selle protokollidega ühinemise seadus (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Euroopa ühenduste finantshuvide kaitse konventsiooniga ja selle protokollidega ühinemise seadus"
    },
    {
      "@id": "estleg:EUFKKSPU_Par_1_v827807",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EUFKKSPU_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud , mis on koostatud 1995. aasta 26. juulil Brüsselis ja mis on välja töötatud Euroopa ühenduste finantshuve kahjustava kelmuse kriminaliseerimiseks kõikides Euroopa Liidu liikmesriikides.",
      "rdfs:label": {
        "@value": "EUFKKSPU_Par_1 (redaktsioon 827807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "827807"
    },
    {
      "@id": "estleg:EUFKKSPU_Par_2_v827807",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EUFKKSPU_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud , mis on koostatud 1996. aasta 27. septembril Brüsselis ja mis on suunatud riigi ja ühenduse ametnikega seotud Euroopa ühenduste finantshuve kahjustavate või kahjustada võivate korruptiivsete tegude vastu.",
      "rdfs:label": {
        "@value": "EUFKKSPU_Par_2 (redaktsioon 827807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "827807"
    },
    {
      "@id": "estleg:EUFKKSPU_Par_3_v827807",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EUFKKSPU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud , mis on koostatud 1997. aasta 19. juunil Luxembourgis ja mis on suunatud juriidiliste isikute vastutuse ning konfiskeerimise ja rahapesu küsimustele ning liikmesriikide ja komisjoni koostööle Euroopa ühenduste finantshuvide ja nendega seotud isikuandmete kaitsmiseks.",
      "rdfs:label": {
        "@value": "EUFKKSPU_Par_3 (redaktsioon 827807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "827807"
    }
  ]
}
