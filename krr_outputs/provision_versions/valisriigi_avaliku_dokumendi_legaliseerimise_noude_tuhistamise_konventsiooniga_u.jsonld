    {
      "@id": "estleg:VADLNTKU_Par_2_v13184864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VADLNTKU_Par_2"
