      "estleg:versionValidFrom": {
        "@value": "2017-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Uljaste piiranguvöönd. Kaitsealal on Uljaste piiranguvöönd.",
      "rdfs:label": {
