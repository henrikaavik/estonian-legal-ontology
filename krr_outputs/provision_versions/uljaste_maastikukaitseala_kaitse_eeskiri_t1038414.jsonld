    {
      "@id": "estleg:Reg_1038414_Par_13_v1038414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038414_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse ja maastikuilme säilitamine. Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse ja maastikuilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_1038414_Par_13 (redaktsioon 1038414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038414",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038414",
