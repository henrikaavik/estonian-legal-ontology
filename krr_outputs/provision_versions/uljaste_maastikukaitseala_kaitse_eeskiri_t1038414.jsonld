      "estleg:versionValidFrom": {
        "@value": "2017-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 19. veebruari 2015. a käskkirjaga nr 179 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 19. veebruari 2015. a käskkirjaga nr 179 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1038414_Par_18 (redaktsioon 1038414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038414",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038414",
      "estleg:sourceAct": "Uljaste maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1038414 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038414_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1038414_Par_19_v1038414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038414_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1038414_Par_19 (redaktsioon 1038414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038414",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038414",
      "estleg:sourceAct": "Uljaste maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1038414 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038414_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1038414_Par_2_v1038414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038414_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Ida-Viru maakonnas Sonda vallas Uljaste külas ning Lääne-Viru maakonnas Rägavere vallas Uljaste ja Viru-Kabala külas. Kaitseala asub Ida-Viru maakonnas Sonda vallas Uljaste külas ning Lääne-Viru maakonnas Rägavere vallas Uljaste ja Viru-Kabala külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1038414_Par_2 (redaktsioon 1038414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038414",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038414",
