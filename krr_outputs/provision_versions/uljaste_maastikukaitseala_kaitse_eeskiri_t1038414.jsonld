    {
      "@id": "estleg:Reg_1038414_Par_18_v1038414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038414_Par_18"
