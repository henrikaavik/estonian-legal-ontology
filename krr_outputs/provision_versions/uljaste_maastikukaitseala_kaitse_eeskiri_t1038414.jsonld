    {
      "@id": "estleg:Reg_1038414_Par_15_v1038414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038414_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) veekogude veetaseme ja kaldajoone muutmine; 3 3) maavara kaevandamine; 4 4) puhtpuistute kujundamine ja energiapuistute rajamine; 5 5) biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õue- ja põllumaal; 6 6) puidu kokku- ja väljavedu külmumata pinnaselt. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; veekogude veetaseme ja kaldajoone muutmine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õue- ja põllumaal; puidu kokku- ja väljavedu külmumata pinnaselt. 2 (2) Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab.",
      "rdfs:label": {
        "@value": "Reg_1038414_Par_15 (redaktsioon 1038414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038414",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038414",
      "estleg:sourceAct": "Uljaste maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1038414 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038414_Map_2026"
      }
    },
