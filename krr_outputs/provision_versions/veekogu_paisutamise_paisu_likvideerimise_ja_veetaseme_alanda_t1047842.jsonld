  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_veekogu_paisutamise_paisu_likvideerimise_ja_veetaseme_alanda_t1047842_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Veekogu paisutamise, paisu likvideerimise ja veetaseme alandamise täpsustatud nõuded ning ökoloogilise miinimumvooluhulga määramise metoodika (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Veekogu paisutamise, paisu likvideerimise ja veetaseme alandamise täpsustatud nõuded ning ökoloogilise miinimumvooluhulga määramise metoodika"
    },
    {
      "@id": "estleg:Reg_1047842_Par_1_v1047842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047842_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse täpsustatud nõuded veekogu paisutamise, paisutamisega seotud keskkonnaseire, vee-elustiku kaitse, paisu, paisutuse likvideerimise ja veetaseme alandamise kohta ning ökoloogilise miinimumvooluhulga määramise metoodika. Käesoleva määrusega kehtestatakse täpsustatud nõuded veekogu paisutamise, paisutamisega seotud keskkonnaseire, vee-elustiku kaitse, paisu, paisutuse likvideerimise ja veetaseme alandamise kohta ning ökoloogilise miinimumvooluhulga määramise metoodika.",
      "rdfs:label": {
        "@value": "Reg_1047842_Par_1 (redaktsioon 1047842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047842",
      "estleg:sourceAct": "Veekogu paisutamise, paisu likvideerimise ja veetaseme alandamise täpsustatud nõuded ning ökoloogilise miinimumvooluhulga määramise metoodika",
      "estleg:provisionRef": "Reg_1047842 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047842_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047842_Par_2_v1047842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047842_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paisutamist tuleb korraldada viisil, mis tagab veeloaga määratud paisutustasemed ja ökoloogilise miinimumvooluhulga säilitamise vesiehitisest allavoolu looduslikus voolusängis. Paisutamist tuleb korraldada viisil, mis tagab veeloaga määratud paisutustasemed ja ökoloogilise miinimumvooluhulga säilitamise vesiehitisest allavoolu looduslikus voolusängis. 2 (2) Paisutamisega seotud kõrgeima, madalaima ja normaalpaisutustaseme absoluutkõrgus määratakse veeloas. Paisutamisega seotud kõrgeima, madalaima ja normaalpaisutustaseme absoluutkõrgus määratakse veeloas. 3 (3) Kui paisu konstruktsioon ja tehniline lahendus ei võimalda reguleerida paisutustaset, võib veeloas määrata ainult normaalpaisutustaseme absoluutkõrguse. Kui paisu konstruktsioon ja tehniline lahendus ei võimalda reguleerida paisutustaset, võib veeloas määrata ainult normaalpaisutustaseme absoluutkõrguse.",
      "rdfs:label": {
        "@value": "Reg_1047842_Par_2 (redaktsioon 1047842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047842",
      "estleg:sourceAct": "Veekogu paisutamise, paisu likvideerimise ja veetaseme alandamise täpsustatud nõuded ning ökoloogilise miinimumvooluhulga määramise metoodika",
      "estleg:provisionRef": "Reg_1047842 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047842_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047842_Par_3_v1047842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047842_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veeloaga määratakse: 1 1) paisu hoolduse nõuded ning tehnilise seisukorra ülevaatamise sagedus, aeg ja tähtaeg; 2 2) paisu hoolduse ja tehnilise seisukorra andmete säilitamise aeg ja esitamise sagedus. Veeloaga määratakse: paisu hoolduse nõuded ning tehnilise seisukorra ülevaatamise sagedus, aeg ja tähtaeg; paisu hoolduse ja tehnilise seisukorra andmete säilitamise aeg ja esitamise sagedus.",
      "rdfs:label": {
        "@value": "Reg_1047842_Par_3 (redaktsioon 1047842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047842",
      "estleg:sourceAct": "Veekogu paisutamise, paisu likvideerimise ja veetaseme alandamise täpsustatud nõuded ning ökoloogilise miinimumvooluhulga määramise metoodika",
      "estleg:provisionRef": "Reg_1047842 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047842_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047842_Par_4_v1047842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047842_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Veeloa andja võib määrata vastavalt vajadusele veeloas: 1 1) veetaseme ja vooluhulga seire viisi, sageduse ja aja; 2 2) kalapääsu kaudu liikuvate kalade seire viisi, sageduse ja aja; 3 3) paisutamise tõttu paisu taha tekkiva settekihi paksuse ja pindala seire viisi, sageduse ja aja. Veeloa andja võib määrata vastavalt vajadusele veeloas: veetaseme ja vooluhulga seire viisi, sageduse ja aja; kalapääsu kaudu liikuvate kalade seire viisi, sageduse ja aja; paisutamise tõttu paisu taha tekkiva settekihi paksuse ja pindala seire viisi, sageduse ja aja. 2 (2) Keskkonnaseire andmete säilitamise aeg ja andmete esitamise sagedus ning tähtaeg määratakse veeloaga. Keskkonnaseire andmete säilitamise aeg ja andmete esitamise sagedus ning tähtaeg määratakse veeloaga.",
      "rdfs:label": {
        "@value": "Reg_1047842_Par_4 (redaktsioon 1047842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047842",
      "estleg:sourceAct": "Veekogu paisutamise, paisu likvideerimise ja veetaseme alandamise täpsustatud nõuded ning ökoloogilise miinimumvooluhulga määramise metoodika",
      "estleg:provisionRef": "Reg_1047842 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047842_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047842_Par_5_v1047842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047842_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Veekogu paisutamisel hüdroenergia kasutamiseks või muul otstarbel vee kasutamise korral tuleb vältida kalade sattumist turbiinidesse või nendesse ehitistesse, mille kaudu vett veekogust kõrvale juhitakse. Veekogu paisutamisel hüdroenergia kasutamiseks või muul otstarbel vee kasutamise korral tuleb vältida kalade sattumist turbiinidesse või nendesse ehitistesse, mille kaudu vett veekogust kõrvale juhitakse. 2 (2) Kalade turbiinidesse või muudesse ehitistesse sattumise vältimiseks tuleb paigaldada võre, mille avade laius ei ületa 25 mm, või tagada kalade möödapääs turbiinidest või muudest ehitistest muu samaväärse meetmega. Muu samaväärne meede ja meetme tingimused määratakse veeloas. Kalade turbiinidesse või muudesse ehitistesse sattumise vältimiseks tuleb paigaldada võre, mille avade laius ei ületa 25 mm, või tagada kalade möödapääs turbiinidest või muudest ehitistest muu samaväärse meetmega. Muu samaväärne meede ja meetme tingimused määratakse veeloas. 3 (3) Looduskaitseseaduse § 51 lõike 2 alusel kinnitatud nimistus märgitud lõhe, jõeforelli, meriforelli ja harjuse kudemis- ja elupaigaks olevatel veekogudel või nende lõikudel asuvatel paisudel tuleb ajavahemikul 20. aprillist kuni 10. juunini kalade turbiinidesse või vajadusel muudesse ehitistesse sattumise vältimiseks kasutada võret, mille avade laius ei ületa 12 mm, või võrkvõret, mille võrgusilma ava külje pikkus ei ületa 15 mm, või tagada kalade möödapääs turbiinidest või muudest ehitistest muu samaväärse meetmega. Muu samaväärne meede ja meetme tingimused ning võre kasutamise vajadus ning võre avalaius või võrkvõre külje pikkus muudes ehitises määratakse veeloas. Looduskaitseseaduse § 51 lõike 2 alusel kinnitatud nimistus märgitud lõhe, jõeforelli, meriforelli ja harjuse kudemis- ja elupaigaks olevatel veekogudel või nende lõikudel asuvatel paisudel tuleb ajavahemikul 20. aprillist kuni 10. juunini kalade turbiinidesse või vajadusel muudesse ehitistesse sattumise vältimiseks kasutada võret, mille avade laius ei ületa 12 mm, või võrkvõret, mille võrgusilma ava külje pikkus ei ületa 15 mm, või tagada kalade möödapääs turbiinidest või muudest ehitistest muu samaväärse meetmega. Muu samaväärne meede ja meetme tingimused ning võre kasutamise vajadus ning võre avalaius või võrkvõre külje pikkus muudes ehitises määratakse veeloas. 4 (4) Kui rakendatakse veeseaduse § 174 lõike 4 leevendust või kohustusest vabastamist, siis käesoleva paragrahvi lõikes 3 sätestatud nõude vajalikkuse üle otsustab Keskkonnaamet. Kui rakendatakse veeseaduse § 174 lõike 4 leevendust või kohustusest vabastamist, siis käesoleva paragrahvi lõikes 3 sätestatud nõude vajalikkuse üle otsustab Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1047842_Par_5 (redaktsioon 1047842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047842",
      "estleg:sourceAct": "Veekogu paisutamise, paisu likvideerimise ja veetaseme alandamise täpsustatud nõuded ning ökoloogilise miinimumvooluhulga määramise metoodika",
      "estleg:provisionRef": "Reg_1047842 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047842_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047842_Par_6_v1047842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047842_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ökoloogiline miinimumvooluhulk määratakse jäävaba perioodi kohta, mis kestab maist oktoobrini, arvutades 95% ületustõenäosusega kuu keskmise miinimumvooluhulga. Ökoloogiline miinimumvooluhulk määratakse jäävaba perioodi kohta, mis kestab maist oktoobrini, arvutades 95% ületustõenäosusega kuu keskmise miinimumvooluhulga.",
      "rdfs:label": {
        "@value": "Reg_1047842_Par_6 (redaktsioon 1047842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047842",
      "estleg:sourceAct": "Veekogu paisutamise, paisu likvideerimise ja veetaseme alandamise täpsustatud nõuded ning ökoloogilise miinimumvooluhulga määramise metoodika",
      "estleg:provisionRef": "Reg_1047842 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047842_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047842_Par_7_v1047842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047842_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ökoloogiline miinimumvooluhulk tuleb tagada vesiehitisest allpool looduslikus voolusängis. Ökoloogiline miinimumvooluhulk tuleb tagada vesiehitisest allpool looduslikus voolusängis. 2 (2) Keskkonnaamet täpsustab veeloaga või otsusega ökoloogilise miinimumvooluhulga tagamise asukoha kirjelduse vesiehitisest allpool looduslikus voolusängis. Keskkonnaamet täpsustab veeloaga või otsusega ökoloogilise miinimumvooluhulga tagamise asukoha kirjelduse vesiehitisest allpool looduslikus voolusängis. 3 (3) Looduskaitseseaduse § 51 lõike 2 alusel kinnitatud nimistus märgitud lõhe, jõeforelli, meriforelli ja harjuse kudemis- ja elupaigaks olevatel veekogudel või nende lõikudel peab ökoloogiline miinimumvooluhulk olema tagatud kogu ulatuses, välja arvatud paisu juurde rajatud kalapääsu väljavoolu ja paisu vahelisel vooluveekogu osal. Looduskaitseseaduse § 51 lõike 2 alusel kinnitatud nimistus märgitud lõhe, jõeforelli, meriforelli ja harjuse kudemis- ja elupaigaks olevatel veekogudel või nende lõikudel peab ökoloogiline miinimumvooluhulk olema tagatud kogu ulatuses, välja arvatud paisu juurde rajatud kalapääsu väljavoolu ja paisu vahelisel vooluveekogu osal.",
      "rdfs:label": {
        "@value": "Reg_1047842_Par_7 (redaktsioon 1047842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047842",
      "estleg:sourceAct": "Veekogu paisutamise, paisu likvideerimise ja veetaseme alandamise täpsustatud nõuded ning ökoloogilise miinimumvooluhulga määramise metoodika",
      "estleg:provisionRef": "Reg_1047842 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047842_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047842_Par_8_v1047842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047842_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Veetaseme alandamine peab toimuma ühtlaselt ning mitte kiiremini kui 0,3 meetrit ööpäevas, kui veeloas või Keskkonnaameti otsuses ei ole määratud teisti. Veetaseme alandamine peab toimuma ühtlaselt ning mitte kiiremini kui 0,3 meetrit ööpäevas, kui veeloas või Keskkonnaameti otsuses ei ole määratud teisti. 2 (2) Veekogu veetaseme alandamisel ei tohi vooluhulga muutmisega kahjustada paisust allapoole jäävat voolusängi ja vee-elustikku. Veekogu veetaseme alandamisel ei tohi vooluhulga muutmisega kahjustada paisust allapoole jäävat voolusängi ja vee-elustikku. 3 (3) Veetaseme alandamist tuleb korraldada viisil, millega välditakse setete ja risu juhtimist paisust allapoole jäävasse voolusängi. Veetaseme alandamist tuleb korraldada viisil, millega välditakse setete ja risu juhtimist paisust allapoole jäävasse voolusängi. 4 (4) Paisutuse likvideerimisel ja veetaseme alandamisel tuleb paisutusala korrastamiseks eemaldada endisest paisutusalast risu. Sõltuvalt olukorrast tuleb eemaldada ka sete. Paisutuse likvideerimisel ja veetaseme alandamisel tuleb paisutusala korrastamiseks eemaldada endisest paisutusalast risu. Sõltuvalt olukorrast tuleb eemaldada ka sete.",
      "rdfs:label": {
        "@value": "Reg_1047842_Par_8 (redaktsioon 1047842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047842",
