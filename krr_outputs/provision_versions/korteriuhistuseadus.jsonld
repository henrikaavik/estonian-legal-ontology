    {
      "@id": "estleg:korteriuhistuseadus_Par_11_v109052017016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:korteriuhistuseadus_Par_11"
      },
      "estleg:versionValidFrom": {
