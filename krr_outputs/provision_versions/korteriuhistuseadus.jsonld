      "estleg:provisionRef": "korteriuhistuseadus § 3",
      "estleg:partOfAct": {
        "@id": "estleg:KÜS_Map_2026"
      }
    },
    {
      "@id": "estleg:korteriuhistuseadus_Par_3_v12742152",
      "@type": [
