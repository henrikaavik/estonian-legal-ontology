      },
      "dc:source": "Lõhkematerjalile ja pürotehnilisele tootele, nende nõuetele vastavuse tõendamisele ja käibe jälgitavusele ning arvestuse pidamisele esitatavad nõuded"
    },
    {
      "@id": "estleg:Reg_1039572_Par_1_v1039572",
      "@type": [
        "owl:NamedIndividual",
