      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Lõhkematerjalile ja pürotehnilisele tootele, nende nõuetele vastavuse tõendamisele ja käibe jälgitavusele ning arvestuse pidamisele esitatavad nõuded (8 versiooni)",
