      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 16. mai 2016. a käskkirjaga nr 1-2/16/459 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 16. mai 2016. a käskkirjaga nr 1-2/16/459 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1041148_Par_20 (redaktsioon 1041148)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041148",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041148",
