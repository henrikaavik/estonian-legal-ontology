      "estleg:provisionRef": "Reg_329991 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_329991_Map"
      }
    },
    {
      "@id": "estleg:Reg_329991_Par_25_v329991",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_329991_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-03-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Testamenditäitja soovil tõestab notar testamenditäitja tunnistuse. RT I 2010 53 341 13346679 2010-08-06 Testamenditäitja soovil tõestab notar testamenditäitja tunnistuse. 2 (2) Testamenditäitja tunnistusele märgitakse: 1 1) pärandaja ees- ja perekonnanimi; 2 2) pärandaja sünniaeg ja isikukood; 3 3) pärandaja surma kuupäev ja aasta; 4 4) testamenditäitja ees- ja perekonnanimi; 5 5) testamenditäitja isikukood ja aadress; 6 6) testamenditäitja õigused pärandvara valitsemisel ja käsutamisel ning pärandvara suhtes kohustuste võtmisel. Testamenditäitja tunnistusele märgitakse: pärandaja ees- ja perekonnanimi; pärandaja sünniaeg ja isikukood; pärandaja surma kuupäev ja aasta; testamenditäitja ees- ja perekonnanimi; testamenditäitja isikukood ja aadress; testamenditäitja õigused pärandvara valitsemisel ja käsutamisel ning pärandvara suhtes kohustuste võtmisel.",
      "rdfs:label": {
        "@value": "Reg_329991_Par_25 (redaktsioon 329991)",
        "@language": "et"
      },
