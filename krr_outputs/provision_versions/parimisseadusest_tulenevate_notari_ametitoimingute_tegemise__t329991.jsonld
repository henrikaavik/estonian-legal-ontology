        "@value": "2024-03-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus jõustub 1. jaanuaril 2009. aastal. Käesolev määrus jõustub 1. jaanuaril 2009. aastal.",
      "rdfs:label": {
