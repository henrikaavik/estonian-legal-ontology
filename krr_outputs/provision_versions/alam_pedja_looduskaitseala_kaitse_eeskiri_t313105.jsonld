      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. RT I 2009 7 48 13125268 2009-02-01+02:00 Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_313105_Par_3 (redaktsioon 313105)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313105",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313105",
      "estleg:sourceAct": "Alam-Pedja looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313105 § 3",
