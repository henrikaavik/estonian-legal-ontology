        "@id": "estleg:Reg_1048301_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1048301_Par_3_v1048301",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
