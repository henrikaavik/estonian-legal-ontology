        "@value": "Sätete redaktsioonid: Saasteainete heite piirväärtused titaandioksiidi tootvate käitiste väljuvates gaasides ja heitvees (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Saasteainete heite piirväärtused titaandioksiidi tootvate käitiste väljuvates gaasides ja heitvees"
    },
    {
      "@id": "estleg:Reg_1014862_Par_1_v1014862",
      "@type": [
