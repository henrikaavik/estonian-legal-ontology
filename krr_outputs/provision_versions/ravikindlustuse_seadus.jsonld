      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib solidaarset ravikindlustust (edaspidi ravikindlustus). (2) Käesoleva seaduse ja Riigikogu ratifitseeritud välislepingu vastuolu korral kohaldatakse välislepingus sätestatut.",
      "rdfs:label": {
        "@value": "RaKS_Par_1 (redaktsioon 181723)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181723",
