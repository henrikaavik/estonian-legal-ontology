      },
      "estleg:versionValidTo": {
        "@value": "2019-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_21_v113032019135",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RaKS_Par_21 (redaktsioon 113032019135)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019135"
    },
    {
      "@id": "estleg:RaKS_Par_22_v181723",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel: käesoleva seaduse § 5 lõikes 2 või 3 või lõike 4 punktis 5 sätestatud alustel vahetult enne lepingu sõlmimist vähemalt kaksteist kuud kindlustatud olnud isik või tema ülalpidamisel olev isik; välisriigist pensioni saav isik, kui välislepingutega ei ole ette nähtud teisiti. (2) Käesoleva paragrahvi lõikes 1 nimetatud leping sõlmitakse haigekassaga lõike 1 punktis 1 või 2 nimetatud isiku või isikute poolt või kasuks. (3) Haigekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid haigekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud haigekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 181723)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181723",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_22_v782559"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_22_v782559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel: käesoleva seaduse § 5 lõikes 2 või 3 või lõike 4 punktis 5 sätestatud alustel lepingu sõlmimise kuule eelneval kahel aastal vähemalt kaksteist kuud kindlustatud olnud isik või tema ülalpidamisel olev isik; välisriigist pensioni saav isik, kui välislepingutega ei ole ette nähtud teisiti. (2) Käesoleva paragrahvi lõikes 1 nimetatud leping sõlmitakse haigekassaga lõike 1 punktis 1 või 2 nimetatud isiku või isikute poolt või kasuks. (3) Haigekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid haigekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud haigekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 782559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "782559",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_22_v102072012029"
      },
      "estleg:versionValidTo": {
        "@value": "2012-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_22_v102072012029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel: käesoleva seaduse § 5 lõikes 2, 3 või 31 või lõike 4 punktis 5 sätestatud alustel lepingu sõlmimise kuule eelneval kahel aastal vähemalt kaksteist kuud kindlustatud olnud isik või tema ülalpidamisel olev isik; välisriigist pensioni saav isik, kui välislepingutega ei ole ette nähtud teisiti. (2) Käesoleva paragrahvi lõikes 1 nimetatud leping sõlmitakse haigekassaga lõike 1 punktis 1 või 2 nimetatud isiku või isikute poolt või kasuks. (3) Haigekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid haigekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud haigekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 102072012029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072012029",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_22_v116042014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-04-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_22_v116042014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-04-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel Eesti alaline elanik ja Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik, kes: on lepingu sõlmimise kuule eelneval kahel aastal olnud vähemalt kaksteist kuud kindlustatud käesoleva seaduse § 5 lõikes 2, 3, 31 või lõike 4 punktis 5 sätestatud alustel või saab pensioni välisriigist, kui välislepinguga ei ole ette nähtud teisiti. (2) Käesoleva paragrahvi lõike 1 punktis 1 sätestatud nõuetele vastav isik saab sõlmida lõikes 1 nimetatud lepingu oma ülalpeetava kasuks, kes on Eesti alaline elanik või Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik. (3) Haigekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid haigekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud haigekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 116042014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116042014016",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_22_v111032015010"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_22_v111032015010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel Eesti alaline elanik ja Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik, kes: on lepingu sõlmimise kuule eelneval kahel aastal olnud vähemalt kaksteist kuud kindlustatud käesoleva seaduse § 5 lõikes 2, 3, 31 või lõike 4 punktis 5 sätestatud alustel või on iseenda eest maksnud või kelle eest on makstud sotsiaalmaksu lepingu sõlmimisele eelneval kalendriaastal vähemalt kaheteistkümnekordselt eelarveaastaks riigieelarvega kehtestatud kuumääralt arvutatuna käesoleva seaduse § 5 lõike 2 punktis 1, 2, 4 või 5 või lõikes 3 või 31 sätestatud alusel või saab pensioni välisriigist, kui välislepinguga ei ole ette nähtud teisiti. (2) Käesoleva paragrahvi lõike 1 punktis 1 sätestatud nõuetele vastav isik saab sõlmida lõikes 1 nimetatud lepingu oma ülalpeetava kasuks, kes on Eesti alaline elanik või Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik. (3) Haigekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid haigekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud haigekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 111032015010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032015010",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_22_v128122017056"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_22_v128122017056",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel Eesti alaline elanik ja Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik, kes: on lepingu sõlmimise kuule eelneval kahel aastal olnud vähemalt kaksteist kuud kindlustatud käesoleva seaduse § 5 lõikes 2, 3, 31 või lõike 4 punktis 5 sätestatud alustel või on iseenda eest maksnud või kelle eest on makstud sotsiaalmaksu lepingu sõlmimisele eelneval kalendriaastal vähemalt kaheteistkümnekordselt eelarveaastaks riigieelarvega kehtestatud kuumääralt arvutatuna käesoleva seaduse § 5 lõike 2 punktis 1, 2, 4, 5 või 51 või lõikes 3 või 31 sätestatud alusel või saab pensioni välisriigist, kui välislepinguga ei ole ette nähtud teisiti. (2) Käesoleva paragrahvi lõike 1 punktis 1 sätestatud nõuetele vastav isik saab sõlmida lõikes 1 nimetatud lepingu oma ülalpeetava kasuks, kes on Eesti alaline elanik või Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik. (3) Haigekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid haigekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud haigekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 128122017056)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017056",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_22_v117052020009"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_22_v117052020009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel Eesti alaline elanik ja Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik, kes: on lepingu sõlmimise kuule eelneval kahel aastal olnud vähemalt kaksteist kuud kindlustatud käesoleva seaduse § 5 lõikes 2, 3, 31 või lõike 4 punktis 5 sätestatud alustel või on iseenda eest maksnud või kelle eest on makstud sotsiaalmaksu lepingu sõlmimisele eelneval kalendriaastal vähemalt kaheteistkümnekordselt eelarveaastaks riigieelarvega kehtestatud kuumääralt arvutatuna käesoleva seaduse § 5 lõike 2 punktis 1, 2, 4, 5 või 51 või lõikes 3 või 31 sätestatud alusel või on lepingu sõlmimise kuule eelneva kaheteistkümne kuu jooksul töötanud laevapere liikmena vähemalt ühe meretöölepingu või muu lepingu alusel või , jõustumisaeg muudetud [RT I, 28.02.2020, 2] saab pensioni välisriigist, kui välislepinguga ei ole ette nähtud teisiti. (2) Käesoleva paragrahvi lõike 1 punktis 1 sätestatud nõuetele vastav isik saab sõlmida lõikes 1 nimetatud lepingu oma ülalpeetava kasuks, kes on Eesti alaline elanik või Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik. (2<sup>1</sup>) Käesoleva paragrahvi lõike 1 punktis 12 nimetatud isik esitab haigekassale lepingu sõlmimiseks koopia meretöölepingust või muust dokumendist, mis tõendab, et isik on töötanud samas punktis nimetatud ajavahemikul laevapere liikmena. Haigekassa nõudel tuleb võõrkeelsele lepingule või seda asendavale dokumendile lisada vandetõlgi seaduse § 2 lõikes 1 nimetatud isiku kinnitatud tõlge eesti keelde, mille kulud kannab isik. Meretöölepingu või muu dokumendi või selle tõlke võib haigekassaga kokkuleppel esitada haigekassa nõutavas mahus. , jõustumisaeg muudetud [RT I, 28.02.2020, 2] (2<sup>2</sup>) Kui haigekassal tekib kahtlus, et käesoleva paragrahvi lõike 1 punktis 12 nimetatud isiku esitatud muust dokumendist ei nähtu lepingu sõlmimise alust, esitab haigekassa dokumendi arvamuse andmiseks Veeteede Ametile. Veeteede Amet annab arvamuse seitsme kalendripäeva jooksul haigekassalt dokumendi saamisest arvates. , jõustumisaeg muudetud [RT I, 28.02.2020, 2] (3) Haigekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid haigekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud haigekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 117052020009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117052020009",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_22_v129122020019"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_22_v129122020019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel Eesti alaline elanik ja Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik, kes: on lepingu sõlmimise kuule eelneval kahel aastal olnud vähemalt kaksteist kuud kindlustatud käesoleva seaduse § 5 lõikes 2, 3, 31 või lõike 4 punktis 5 sätestatud alustel või on iseenda eest maksnud või kelle eest on makstud sotsiaalmaksu lepingu sõlmimisele eelneval kalendriaastal vähemalt kaheteistkümnekordselt eelarveaastaks riigieelarvega kehtestatud kuumääralt arvutatuna käesoleva seaduse § 5 lõike 2 punktis 1, 2, 4, 5 või 51 või lõikes 3 või 31 sätestatud alusel või on lepingu sõlmimise kuule eelneva kaheteistkümne kuu jooksul töötanud laevapere liikmena vähemalt ühe meretöölepingu või muu lepingu alusel või , jõustumisaeg muudetud [RT I, 28.02.2020, 2] saab pensioni välisriigist, kui välislepinguga ei ole ette nähtud teisiti. (2) Käesoleva paragrahvi lõike 1 punktis 1 sätestatud nõuetele vastav isik saab sõlmida lõikes 1 nimetatud lepingu oma ülalpeetava kasuks, kes on Eesti alaline elanik või Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik. (2<sup>1</sup>) Käesoleva paragrahvi lõike 1 punktis 12 nimetatud isik esitab haigekassale lepingu sõlmimiseks koopia meretöölepingust või muust dokumendist, mis tõendab, et isik on töötanud samas punktis nimetatud ajavahemikul laevapere liikmena. Haigekassa nõudel tuleb võõrkeelsele lepingule või seda asendavale dokumendile lisada vandetõlgi seaduse § 2 lõikes 1 nimetatud isiku kinnitatud tõlge eesti keelde, mille kulud kannab isik. Meretöölepingu või muu dokumendi või selle tõlke võib haigekassaga kokkuleppel esitada haigekassa nõutavas mahus. , jõustumisaeg muudetud [RT I, 28.02.2020, 2] (2<sup>2</sup>) Kui haigekassal tekib kahtlus, et käesoleva paragrahvi lõike 1 punktis 12 nimetatud isiku esitatud muust dokumendist ei nähtu lepingu sõlmimise alust, esitab haigekassa dokumendi arvamuse andmiseks Transpordiametile. Transpordiamet annab arvamuse seitsme kalendripäeva jooksul haigekassalt dokumendi saamisest arvates. (3) Haigekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid haigekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud haigekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 129122020019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122020019",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_22_v111032023081"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_22_v111032023081",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel Eesti alaline elanik ja Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik, kes: on lepingu sõlmimise kuule eelneval kahel aastal olnud vähemalt kaksteist kuud kindlustatud käesoleva seaduse § 5 lõikes 2, 3, 31 või lõike 4 punktis 5 sätestatud alustel või on iseenda eest maksnud või kelle eest on makstud sotsiaalmaksu lepingu sõlmimisele eelneval kalendriaastal vähemalt kaheteistkümnekordselt eelarveaastaks riigieelarvega kehtestatud kuumääralt arvutatuna käesoleva seaduse § 5 lõike 2 punktis 1, 2, 4, 5 või 51 või lõikes 3 või 31 sätestatud alusel või on lepingu sõlmimise kuule eelneva kaheteistkümne kuu jooksul töötanud laevapere liikmena vähemalt ühe meretöölepingu või muu lepingu alusel või , jõustumisaeg muudetud [RT I, 28.02.2020, 2] saab pensioni välisriigist, kui välislepinguga ei ole ette nähtud teisiti. (2) Käesoleva paragrahvi lõike 1 punktis 1 sätestatud nõuetele vastav isik saab sõlmida lõikes 1 nimetatud lepingu oma ülalpeetava kasuks, kes on Eesti alaline elanik või Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik. (2<sup>1</sup>) Käesoleva paragrahvi lõike 1 punktis 12 nimetatud isik esitab Tervisekassale lepingu sõlmimiseks koopia meretöölepingust või muust dokumendist, mis tõendab, et isik on töötanud samas punktis nimetatud ajavahemikul laevapere liikmena. Tervisekassa nõudel tuleb võõrkeelsele lepingule või seda asendavale dokumendile lisada vandetõlgi seaduse § 2 lõikes 1 nimetatud isiku kinnitatud tõlge eesti keelde, mille kulud kannab isik. Meretöölepingu või muu dokumendi või selle tõlke võib Tervisekassaga kokkuleppel esitada Tervisekassa nõutavas mahus. , jõustumisaeg muudetud [RT I, 28.02.2020, 2] (2<sup>2</sup>) Kui Tervisekassal tekib kahtlus, et käesoleva paragrahvi lõike 1 punktis 12 nimetatud isiku esitatud muust dokumendist ei nähtu lepingu sõlmimise alust, esitab Tervisekassa dokumendi arvamuse andmiseks Transpordiametile. Transpordiamet annab arvamuse seitsme kalendripäeva jooksul Tervisekassalt dokumendi saamisest arvates. (3) Tervisekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid Tervisekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud Tervisekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 111032023081)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023081",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_22_v103122025009"
      },
      "estleg:versionValidTo": {
        "@value": "2025-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_22_v103122025009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga võrdsustatakse lepingu alusel Eesti alaline elanik ja Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik. (2) Käesoleva paragrahvi lõikes 1 nimetatud lepingu saab teise isiku kasuks sõlmida Eesti alaline elanik ja Eestis tähtajalise elamisloa või elamisõiguse alusel elav isik. (2<sup>1</sup>) Kehtetu - (2<sup>2</sup>) Kehtetu - (3) Tervisekassal on motiveeritult õigus keelduda käesoleva paragrahvi lõikes 1 nimetatud lepingu sõlmimisest, kui isik ei ole nõuetekohaselt täitnud varasemaid Tervisekassaga sõlmitud lepinguid või ravikindlustust reguleerivate õigusaktide sätteid või kui ta on teadvalt esitanud Tervisekassale valeandmeid.",
      "rdfs:label": {
        "@value": "RaKS_Par_22 (redaktsioon 103122025009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103122025009"
    },
    {
      "@id": "estleg:RaKS_Par_23_v181723",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga käesoleva seaduse § 22 lõikes 1 nimetatud lepingu alusel võrdsustatud isikule laienevad kõik käesolevas seaduses sätestatud kindlustatud isiku õigused ja kohustused, kui käesolevast seadusest ei tulene teisiti. (2) Käesoleva seaduse § 22 lõikes 1 nimetatud lepingule ei kohaldata võlaõigusseaduse (RT I 2001, 81, 487; 2002, 53, 336) sätteid, mis reguleerivad kindlustuslepingut, ja kindlustustegevuse seadust (RT I 2000, 53, 343; 2001, 43, 238; 48, 268; 59, 359; 87, 529; 93, 565; 2002, 35, 215).",
      "rdfs:label": {
        "@value": "RaKS_Par_23 (redaktsioon 181723)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181723",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_23_v958202"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_23_v958202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga käesoleva seaduse § 22 lõikes 1 nimetatud lepingu alusel võrdsustatud isikule laienevad kõik käesolevas seaduses sätestatud kindlustatud isiku õigused ja kohustused, kui käesolevast seadusest ei tulene teisiti. [Lõike 2 sõnastus kuni 31. 12. 2005] (2) Käesoleva seaduse § 22 lõikes 1 nimetatud lepingule ei kohaldata võlaõigusseaduse (RT I 2001, 81, 487; 2002, 53, 336) sätteid, mis reguleerivad kindlustuslepingut, ja kindlustustegevuse seadust (RT I 2000, 53, 343; 2001, 43, 238; 48, 268; 59, 359; 87, 529; 93, 565; 2002, 35, 215). [Lõike 2 sõnastus alates 1. 01. 2006] (2) Käesoleva seaduse § 22 lõikes 1 nimetatud lepingule kohaldatakse võlaõigusseaduse sätteid, mis reguleerivad kindlustuslepingut, üksnes niivõrd, kuivõrd need ei ole vastuolus käesolevas seaduses sätestatuga. Neile lepingutele ei kohaldata kindlustustegevuse seaduses sätestatut.",
      "rdfs:label": {
        "@value": "RaKS_Par_23 (redaktsioon 958202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "958202",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_23_v968558"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_23_v968558",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustatud isikuga käesoleva seaduse § 22 lõikes 1 nimetatud lepingu alusel võrdsustatud isikule laienevad kõik käesolevas seaduses sätestatud kindlustatud isiku õigused ja kohustused, kui käesolevast seadusest ei tulene teisiti. (2) Käesoleva seaduse § 22 lõikes 1 nimetatud lepingule kohaldatakse võlaõigusseaduse sätteid, mis reguleerivad kindlustuslepingut, üksnes niivõrd, kuivõrd need ei ole vastuolus käesolevas seaduses sätestatuga. Neile lepingutele ei kohaldata kindlustustegevuse seaduses sätestatut.",
      "rdfs:label": {
        "@value": "RaKS_Par_23 (redaktsioon 968558)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "968558"
    },
    {
      "@id": "estleg:RaKS_Par_24_v181723",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haigekassa nõukogu kinnitab juhatuse ettepanekul käesoleva seaduse § 22 lõikes 1 nimetatud lepingu tüüptingimused. (2) Lepingu tähtaeg on vähemalt üks aasta. (3) Lepingu alusel kalendrikuus makstava kindlustusmakse suurus on lepingu sõlmimisele eelnenud kalendriaastal Statistikaameti avaldatud Eesti keskmise palga ja arvu 0,13 korrutis, mis on ümardatud täiskroonideni. Haigekassa muudab kindlustusmakse suurust kord aastas vastavalt Eesti keskmise palga muutumisele. (4) Kindlustuskaitse tekib ühe kuu möödumisel lepingu sõlmimisest. Kui kindlustusleping sõlmitakse sundkindlustuse kehtiva kindlustuskaitse ajal, algab isiku kindlustuskaitse kehtiva sundkindlustuskaitse lõppemisest ilma katkemiseta. (5) Kindlustusmaksete tähtpäevaks maksmata jätmise korral on haigekassal õigus leping ühepoolselt ilma etteteatamiseta lõpetada neljateistkümne kalendripäeva möödumisel maksetähtpäevast, kui kindlustusmakse täitmise kohustust ei ole selleks ajaks nõuetekohaselt täies ulatuses täidetud. (6) Lepingu lõpetamisel kindlustusmaksete tähtpäevaks maksmata jätmise korral on lepingu sõlminud isik kohustatud haigekassale hüvitama lepingu ennetähtaegse lõpetamise tõttu saamata jäänud kindlustusmaksete summa. (7) Leping lõpeb käesoleva seaduse alusel sundkindlustuse kindlustuskaitse tekkimisel.",
      "rdfs:label": {
        "@value": "RaKS_Par_24 (redaktsioon 181723)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181723",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_24_v782559"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_24_v782559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haigekassa nõukogu kinnitab juhatuse ettepanekul käesoleva seaduse § 22 lõikes 1 nimetatud lepingu tüüptingimused. (2) Lepingu tähtaeg on vähemalt üks aasta. (3) Lepingu alusel kalendrikuus makstava kindlustusmakse suurus on arvu 0,13 ja viimati Statistikaameti avaldatud eelmise kalendriaasta keskmise kuubrutopalga korrutis, mis on ümardatud täiskroonideni. Kalendrikuus makstava kindlustusmakse suurust on haigekassal õigus muuta kord aastas pärast Statistikaameti poolt eelmise kalendriaasta keskmise kuubrutopalga avaldamist. (4) Kindlustuskaitse tekib ühe kuu möödumisel lepingu sõlmimisest. Kui kindlustusleping sõlmitakse sundkindlustuse kehtiva kindlustuskaitse ajal, algab isiku kindlustuskaitse kehtiva sundkindlustuskaitse lõppemisest ilma katkemiseta. (5) Kindlustusmaksete tähtpäevaks maksmata jätmise korral on haigekassal õigus leping ühepoolselt ilma etteteatamiseta lõpetada neljateistkümne kalendripäeva möödumisel maksetähtpäevast, kui kindlustusmakse täitmise kohustust ei ole selleks ajaks nõuetekohaselt täies ulatuses täidetud. (6) Lepingu lõpetamisel kindlustusmaksete tähtpäevaks maksmata jätmise korral on lepingu sõlminud isik kohustatud haigekassale hüvitama lepingu ennetähtaegse lõpetamise tõttu saamata jäänud kindlustusmaksete summa. (7) Leping lõpeb käesoleva seaduse alusel sundkindlustuse kindlustuskaitse tekkimisel.",
      "rdfs:label": {
        "@value": "RaKS_Par_24 (redaktsioon 782559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "782559",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_24_v958202"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_24_v958202",
