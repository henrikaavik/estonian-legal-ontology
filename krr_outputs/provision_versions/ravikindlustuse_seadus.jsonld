    {
      "@id": "estleg:RaKS_Par_14_v13299845",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_14"
      },
      "estleg:versionValidFrom": {
