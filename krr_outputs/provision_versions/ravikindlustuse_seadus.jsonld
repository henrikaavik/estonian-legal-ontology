    {
      "@id": "estleg:RaKS_Par_3_v111032023081",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ravikindlustuse kindlustusandja on Tervisekassa. (2) Kehtetu - (3) Kindlustatud isikutel on võrdsed õigused ja võimalused ravikindlustushüvitiste saamiseks, kui käesolevas seaduses ei sätestata teisiti.",
      "rdfs:label": {
