      },
      "estleg:versionValidTo": {
        "@value": "2005-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_17_v958202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ravikindlustuse andmekogusse kantakse järgmised andmed: isikuandmed; kindlustuskaitse tekkimise, lõppemise ja peatumise aluseks olevad andmed; mitterahaliste ravikindlustushüvitiste eest tasumise aluseks olevad andmed; rahaliste ravikindlustushüvitiste väljamaksmise aluseks olevad andmed. (2) Ravikindlustuse andmekogusse kantavate andmete täpsem koosseis sätestatakse andmekogu pidamise põhimääruses. [Lõige 3 jõustub 1. 01. 2006] (3) Ravikindlustuse andmekogu võivad kasutada ka kohtud ja kohtutäiturid isikuandmete osas.",
      "rdfs:label": {
        "@value": "RaKS_Par_17 (redaktsioon 958202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "958202",
