        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_39_v111032023081",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
