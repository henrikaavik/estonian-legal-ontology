      "estleg:versionValidTo": {
        "@value": "2014-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_48_1_v108102014003",
      "@type": [
        "owl:NamedIndividual",
