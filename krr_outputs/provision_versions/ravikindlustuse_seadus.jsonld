    {
      "@id": "estleg:RaKS_Par_17_v181723",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ravikindlustuse andmekogusse kantakse järgmised andmed: isikuandmed; kindlustuskaitse tekkimise, lõppemise ja peatumise aluseks olevad andmed; mitterahaliste ravikindlustushüvitiste eest tasumise aluseks olevad andmed; rahaliste ravikindlustushüvitiste väljamaksmise aluseks olevad andmed. (2) Ravikindlustuse andmekogusse kantavate andmete täpsem koosseis sätestatakse andmekogu pidamise põhimääruses.",
      "rdfs:label": {
        "@value": "RaKS_Par_17 (redaktsioon 181723)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181723",
