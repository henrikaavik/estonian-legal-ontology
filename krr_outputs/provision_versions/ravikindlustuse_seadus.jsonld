        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RaKS_Par_65 (redaktsioon 128122017056)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017056"
    },
    {
      "@id": "estleg:RaKS_Par_66_v181723",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kindlustatud isikul ei tekkinud kalendriaastas õigust saada täiskasvanute hambaraviteenuse või sõidukuluhüvitist osaliselt või täies ulatuses seetõttu, et kindlustatud isik ei kandnud hüvitatavaid kulusid või kandis neid hüvitatavast määrast vähem, siis saamata jäänud hüvitise või hüvitise saamata jäänud osa võrra järgmises kalendriaastas makstavat hüvitist ei suurendata.",
      "rdfs:label": {
        "@value": "RaKS_Par_66 (redaktsioon 181723)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181723",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_66_v751112"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_66_v751112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kindlustatud isikul ei tekkinud kalendriaastas õigust saada täiskasvanute hambaraviteenuse või sõidukuluhüvitist osaliselt või täies ulatuses seetõttu, etkindlustatudisik ei kandnud hüvitatavaid kulusid või kandis neid hüvitatavast määrast vähem, siis saamata jäänud hüvitise või hüvitise saamata jäänud osa võrra järgmises kalendriaastas makstavat hüvitist ei suurendata.",
      "rdfs:label": {
        "@value": "RaKS_Par_66 (redaktsioon 751112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "751112",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_66_v833234"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_66_v833234",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kindlustatud isikul ei tekkinud kalendriaastas õigust saada täiskasvanute hambaraviteenuse hüvitist osaliselt või täies ulatuses seetõttu, et kindlustatud isik ei kandnud hüvitatavaid kulusid või kandis neid hüvitatavast määrast vähem, siis saamata jäänud hüvitise või hüvitise saamata jäänud osa võrra järgmises kalendriaastas makstavat hüvitist ei suurendata.",
      "rdfs:label": {
        "@value": "RaKS_Par_66 (redaktsioon 833234)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "833234",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_66_v127122016012"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_66_v127122016012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui kindlustatud isikul ei tekkinud kolmeaastase ajavahemiku jooksul õigust saada täiskasvanu hambaproteesihüvitist osaliselt või täies ulatuses seetõttu, et kindlustatud isik ei kandnud hüvitatavaid kulusid või kandis neid hüvitatavast määrast vähem, siis saamata jäänud hüvitise või hüvitise saamata jäänud osa võrra järgmise kolmeaastase ajavahemiku hüvitist ei suurendata. (2) Kindlustatud isikule makstakse §-s 63 nimetatud hambaproteesihüvitist, kui nimetatud hambaraviteenust on isikule osutatud samas paragrahvis viidatud kolmeaastase ajavahemiku jooksul.",
      "rdfs:label": {
        "@value": "RaKS_Par_66 (redaktsioon 127122016012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127122016012",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_66_v128122017056"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_66_v128122017056",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RaKS_Par_66 (redaktsioon 128122017056)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017056"
    },
    {
      "@id": "estleg:RaKS_Par_66_1_v129112013008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_66_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määrusega loetelu tervishoiuteenustest, välja arvatud hambaraviteenus, ja selliste tervishoiuteenuste kulu hüvitamise korra, mida kindlustatud isikule on väljaspool ravijärjekorda osutanud Eestis tegutsev tervishoiuteenuse osutaja, kellel on tervishoiuteenuse osutamise ajal kehtiv ravi rahastamise leping haigekassaga (edaspidi haigekassa lepingupartner). (2) Haigekassa nõukogu ettepaneku aluseks võib olla: vajadus tagada küllaldane juurdepääs kvaliteetsetele tervishoiuteenustele või vajadus kontrollida kulusid ja vältida rahaliste, tehniliste või inimressursside raiskamist. (3) Käesoleva paragrahvi lõikes 1 nimetatud määruses võib sätestada tervishoiuteenused, mis: mõjutavad olulisel määral patsiendi elukvaliteeti, vältides puude või püsiva tervisekahjustuse väljakujunemist; tingivad patsiendi haiglasse paigutamise vähemalt üheks ööks või nõuavad spetsialiseeritud meditsiinitaristute ja -seadmete kasutamist. (4) Haigekassa hüvitab tervishoiuteenuse osutaja poolt ravijärjekorda kantud kindlustatud isikule haigekassa lepingupartneri poolt väljaspool ravijärjekorda meditsiinilisel näidustusel ja saatekirja alusel osutatud tervishoiuteenuse osutamise kulu käesoleva seaduse § 30 lõike 1 alusel kehtestatud tervishoiuteenuste loetelus sätestatud tingimuste ja piirhindade alusel, ületamata kindlustatud isiku poolt tervishoiuteenuse eest tasutud summat. (5) Väljaspool ravijärjekorda osutatud tervishoiuteenuse hüvitise maksmisel ei hüvitata kindlustatud isikule käesolevas seaduses või selle alusel kehtestatud lisatasu ja täiendavat omaosalust. (6) Väljaspool ravijärjekorda osutatud tervishoiuteenuse hüvitis tervishoiuteenuse eest, mille osutamise ravijärjekorrale Eestis on ravikindlustuse seaduse § 38 lõike 3 alusel kehtestatud vähemalt üheaastane maksimumpikkus, makstakse välja haigekassa kehtestatud hüvitise väljamaksmise otsuses kindlaksmääratud päeval, kuid mitte hiljem kui nimetatud tervishoiuteenuse osutamise ravijärjekorra maksimumpikkuse kohase tähtaja viimasel päeval.",
      "rdfs:label": {
        "@value": "RaKS_Par_66_1 (redaktsioon 129112013008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129112013008",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_66_1_v108102014003"
      },
      "estleg:versionValidTo": {
        "@value": "2014-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_66_1_v108102014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RaKS_Par_66_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-10-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) võib haigekassa nõukogu ettepanekul kehtestada määrusega loetelu tervishoiuteenustest, välja arvatud hambaraviteenus, ja selliste tervishoiuteenuste kulu hüvitamise korra, mida kindlustatud isikule on väljaspool ravijärjekorda osutanud Eestis tegutsev tervishoiuteenuse osutaja, kellel on tervishoiuteenuse osutamise ajal kehtiv ravi rahastamise leping haigekassaga (edaspidi haigekassa lepingupartner). (2) Haigekassa nõukogu ettepaneku aluseks võib olla: vajadus tagada küllaldane juurdepääs kvaliteetsetele tervishoiuteenustele või vajadus kontrollida kulusid ja vältida rahaliste, tehniliste või inimressursside raiskamist. (3) Käesoleva paragrahvi lõikes 1 nimetatud määruses võib sätestada tervishoiuteenused, mis: mõjutavad olulisel määral patsiendi elukvaliteeti, vältides puude või püsiva tervisekahjustuse väljakujunemist; tingivad patsiendi haiglasse paigutamise vähemalt üheks ööks või nõuavad spetsialiseeritud meditsiinitaristute ja -seadmete kasutamist. (4) Haigekassa hüvitab tervishoiuteenuse osutaja poolt ravijärjekorda kantud kindlustatud isikule haigekassa lepingupartneri poolt väljaspool ravijärjekorda meditsiinilisel näidustusel ja saatekirja alusel osutatud tervishoiuteenuse osutamise kulu käesoleva seaduse § 30 lõike 1 alusel kehtestatud tervishoiuteenuste loetelus sätestatud tingimuste ja piirhindade alusel, ületamata kindlustatud isiku poolt tervishoiuteenuse eest tasutud summat. (5) Väljaspool ravijärjekorda osutatud tervishoiuteenuse hüvitise maksmisel ei hüvitata kindlustatud isikule käesolevas seaduses või selle alusel kehtestatud lisatasu ja täiendavat omaosalust. (6) Väljaspool ravijärjekorda osutatud tervishoiuteenuse hüvitis tervishoiuteenuse eest, mille osutamise ravijärjekorrale Eestis on ravikindlustuse seaduse § 38 lõike 3 alusel kehtestatud vähemalt üheaastane maksimumpikkus, makstakse välja haigekassa kehtestatud hüvitise väljamaksmise otsuses kindlaksmääratud päeval, kuid mitte hiljem kui nimetatud tervishoiuteenuse osutamise ravijärjekorra maksimumpikkuse kohase tähtaja viimasel päeval.",
      "rdfs:label": {
        "@value": "RaKS_Par_66_1 (redaktsioon 108102014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108102014003",
      "estleg:supersededByVersion": {
        "@id": "estleg:RaKS_Par_66_1_v111032023081"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RaKS_Par_66_1_v111032023081",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
