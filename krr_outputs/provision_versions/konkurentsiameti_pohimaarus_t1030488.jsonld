      }
    },
    {
      "@id": "estleg:Reg_1030488_Par_20_v1030488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030488_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti ümberkorraldamine või tema tegevuse lõpetamine toimub seaduse alusel. Ameti ümberkorraldamine või tema tegevuse lõpetamine toimub seaduse alusel.",
