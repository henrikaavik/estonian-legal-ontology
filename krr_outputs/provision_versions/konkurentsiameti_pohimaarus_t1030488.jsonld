    },
    {
      "@id": "estleg:Reg_1030488_Par_21_v1030488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030488_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. septembril 2015. aastal. Määrus jõustub 1. septembril 2015. aastal.",
