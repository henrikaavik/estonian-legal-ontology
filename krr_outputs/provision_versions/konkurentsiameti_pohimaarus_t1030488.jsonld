    {
      "@id": "estleg:Reg_1030488_Par_4_v1030488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030488_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ameti kulud kaetakse riigieelarvest. Ameti eelarve kinnitab ja muudab ning eelarve täitmist kontrollib valdkonna eest vastutav minister. RT I 2023-12-23 12 123122023012 2023-12-26 Ameti kulud kaetakse riigieelarvest. Ameti eelarve kinnitab ja muudab ning eelarve täitmist kontrollib valdkonna eest vastutav minister. 2 (2) Ametil on arvelduskontod Riigikassa kontsernikonto koosseisus. Ametil on arvelduskontod Riigikassa kontsernikonto koosseisus.",
      "rdfs:label": {
        "@value": "Reg_1030488_Par_4 (redaktsioon 1030488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030488",
      "estleg:sourceAct": "Konkurentsiameti põhimäärus",
      "estleg:provisionRef": "Reg_1030488 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030488_Par_5_v1030488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030488_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti asukohaks on Tallinn. Ameti mujal asuva struktuuriüksuse asukoht nimetatakse struktuuriüksuse põhimääruses. RT I 2023-12-23 12 123122023012 2023-12-26 Ameti asukohaks on Tallinn. Ameti mujal asuva struktuuriüksuse asukoht nimetatakse struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_1030488_Par_5 (redaktsioon 1030488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030488",
      "estleg:sourceAct": "Konkurentsiameti põhimäärus",
      "estleg:provisionRef": "Reg_1030488 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030488_Par_6_v1030488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030488_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Amet täidab talle seadusega pandud ülesandeid konkurentsivaldkonnas. Amet täidab talle seadusega pandud ülesandeid konkurentsivaldkonnas. 2 (2) Amet täidab talle seadusega pandud ülesandeid eriseadustega reguleeritud järgmiste turgude suhtes: 1 1) elektrienergia sise- ja piirkondlik turg; 2 2) maagaasi sise- ja piirkondlik turg; 3 3) kaugküte; 4 4) ühisveevärk ja -kanalisatsioon; 5 5) postside (eeskätt universaalse postiteenuse reguleerimine); 6 6) sadamad (kaebuste lahendamine); 7 7) lennujaamad (lennujaamatasudega seotud vaidluste ja lennujaama kasutajate kaebuste lahendamine); 8 8) raudtee (tegevuslubade väljastamine, konkurentsiolukorra jälgimine, ebaõiglase kohtlemise kõrvaldamine ja raudteeinfrastruktuuri kasutustingimuste kohta esitatud kaebuste lahendamine); 9 9) põllumajandustooted ja toit (tarneahela ebaausate kaubandustavade järelevalve). Amet täidab talle seadusega pandud ülesandeid eriseadustega reguleeritud järgmiste turgude suhtes: elektrienergia sise- ja piirkondlik turg; maagaasi sise- ja piirkondlik turg; kaugküte; ühisveevärk ja -kanalisatsioon; postside (eeskätt universaalse postiteenuse reguleerimine); sadamad (kaebuste lahendamine); lennujaamad (lennujaamatasudega seotud vaidluste ja lennujaama kasutajate kaebuste lahendamine); raudtee (tegevuslubade väljastamine, konkurentsiolukorra jälgimine, ebaõiglase kohtlemise kõrvaldamine ja raudteeinfrastruktuuri kasutustingimuste kohta esitatud kaebuste lahendamine); põllumajandustooted ja toit (tarneahela ebaausate kaubandustavade järelevalve). 3 (3) Amet täidab talle seadusega pandud ülesandeid maksejõuetuse valdkonnas (pankrotivõlgniku, tema lähikondsete ja pankrotihalduri järelevalve). RT I 2022-03-17 1 117032022001 2022-03-20 Amet täidab talle seadusega pandud ülesandeid maksejõuetuse valdkonnas (pankrotivõlgniku, tema lähikondsete ja pankrotihalduri järelevalve).",
      "rdfs:label": {
        "@value": "Reg_1030488_Par_6 (redaktsioon 1030488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030488",
      "estleg:sourceAct": "Konkurentsiameti põhimäärus",
      "estleg:provisionRef": "Reg_1030488 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030488_Par_7_v1030488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030488_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti põhiülesanded on: 1 1) järelevalve teostamine ameti tegevusvaldkondi reguleerivate õigusaktide nõuete täitmise üle ja seaduse alusel riikliku sunni rakendamine; RT I 2022-03-17 1 117032022001 2022-03-20 2 2) osalemine ameti tegevusvaldkondi reguleerivate õigusaktide väljatöötamisel ning ettepanekute tegemine nende muutmiseks ja täiendamiseks; 3 3) osalemine ameti tegevusvaldkondadega seotud poliitika, strateegia ja arengukava väljatöötamisel; 4 4) ameti tegevusvaldkondadega seotud projektide ettevalmistamine ja elluviimine, sealhulgas rahvusvahelistes projektides ja nende ettevalmistamisel osalemine; 5 5) osalemine oma tegevusvaldkonda puudutavate rahvusvaheliste organisatsioonide ja töögruppide töös. Ameti põhiülesanded on: järelevalve teostamine ameti tegevusvaldkondi reguleerivate õigusaktide nõuete täitmise üle ja seaduse alusel riikliku sunni rakendamine; osalemine ameti tegevusvaldkondi reguleerivate õigusaktide väljatöötamisel ning ettepanekute tegemine nende muutmiseks ja täiendamiseks; osalemine ameti tegevusvaldkondadega seotud poliitika, strateegia ja arengukava väljatöötamisel; ameti tegevusvaldkondadega seotud projektide ettevalmistamine ja elluviimine, sealhulgas rahvusvahelistes projektides ja nende ettevalmistamisel osalemine; osalemine oma tegevusvaldkonda puudutavate rahvusvaheliste organisatsioonide ja töögruppide töös.",
      "rdfs:label": {
        "@value": "Reg_1030488_Par_7 (redaktsioon 1030488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030488",
      "estleg:sourceAct": "Konkurentsiameti põhimäärus",
      "estleg:provisionRef": "Reg_1030488 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030488_Par_8_v1030488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030488_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiülesannete täitmiseks amet: 1 1) teeb koostööd teiste valitsusasutuste, kohaliku omavalitsuse üksuste, sihtasutuste, mittetulundusühingute, ettevõtjate ja tarbijaorganisatsioonidega, teiste riikide asjaomaste asutuste ja rahvusvaheliste organisatsioonidega; 2 2) esindab riiki ameti tegevusvaldkondadega seonduvates rahvusvahelistes organisatsioonides; 3 3) osaleb ameti tegevusvaldkondi puudutavatest välislepingutest tulenevate Eesti Vabariigi kohustuste täitmises; 4 4) koostab ameti eelarve projekti ning eelmise aasta eelarve täitmise aruande; 5 5) töötab välja ja viib ellu ameti strateegia ja tööplaanid; 6 6) jälgib, hindab ja analüüsib olukorda oma tegevusvaldkondades ning teavitab isikuid arengutest ja muudatustest oma tegevusvaldkondades; 7 7) lahendab oma tegevusvaldkondades kaebusi ja vaidlusi ning osaleb oma pädevuse piires kohtumenetluses; 8 8) menetleb oma pädevuse piires süütegusid; 9 9) täidab talle õigusaktidega pandud andmekogu vastutava või volitatud töötleja ülesandeid; 10 10) annab oma pädevuse piires õigusaktidega sätestatud korras välja tegevuslube ja kooskõlastusi; 11 11) nõustab ja juhendab isikuid ameti tegevusvaldkondadega seotud küsimustes; 12 12) täidab muid talle õigusaktidega pandud ülesandeid. Põhiülesannete täitmiseks amet: teeb koostööd teiste valitsusasutuste, kohaliku omavalitsuse üksuste, sihtasutuste, mittetulundusühingute, ettevõtjate ja tarbijaorganisatsioonidega, teiste riikide asjaomaste asutuste ja rahvusvaheliste organisatsioonidega; esindab riiki ameti tegevusvaldkondadega seonduvates rahvusvahelistes organisatsioonides; osaleb ameti tegevusvaldkondi puudutavatest välislepingutest tulenevate Eesti Vabariigi kohustuste täitmises; koostab ameti eelarve projekti ning eelmise aasta eelarve täitmise aruande; töötab välja ja viib ellu ameti strateegia ja tööplaanid; jälgib, hindab ja analüüsib olukorda oma tegevusvaldkondades ning teavitab isikuid arengutest ja muudatustest oma tegevusvaldkondades; lahendab oma tegevusvaldkondades kaebusi ja vaidlusi ning osaleb oma pädevuse piires kohtumenetluses; menetleb oma pädevuse piires süütegusid; täidab talle õigusaktidega pandud andmekogu vastutava või volitatud töötleja ülesandeid; annab oma pädevuse piires õigusaktidega sätestatud korras välja tegevuslube ja kooskõlastusi; nõustab ja juhendab isikuid ameti tegevusvaldkondadega seotud küsimustes; täidab muid talle õigusaktidega pandud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_1030488_Par_8 (redaktsioon 1030488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030488",
      "estleg:sourceAct": "Konkurentsiameti põhimäärus",
      "estleg:provisionRef": "Reg_1030488 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030488_Par_9_v1030488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030488_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ameti põhiline struktuuriüksus on teenistus. Teenistus võib jaguneda osakondadeks ja talitusteks. Ameti põhiline struktuuriüksus on teenistus. Teenistus võib jaguneda osakondadeks ja talitusteks. 2 (2) Kehtetu - RT I 2023-12-23 12 123122023012 2023-12-26 Kehtetu - 3 (3) Osakonna koosseisu võivad kuuluda talitused, kui need on osakonna struktuuris ette nähtud. Lisaks võivad kuuluda ameti struktuuri ametnikud ja töötajad, kes ei ole ühegi osakonna koosseisus ja alluvad vahetult peadirektorile või teenistuse juhatajale. RT I 2023-12-23 12 123122023012 2023-12-26 Osakonna koosseisu võivad kuuluda talitused, kui need on osakonna struktuuris ette nähtud. Lisaks võivad kuuluda ameti struktuuri ametnikud ja töötajad, kes ei ole ühegi osakonna koosseisus ja alluvad vahetult peadirektorile või teenistuse juhatajale. 4 (4) Ameti teenistuskohtade koosseisu kehtestab minister või tema volitatud Konkurentsiameti peadirektor. Ameti teenistuskohtade koosseisu kehtestab minister või tema volitatud Konkurentsiameti peadirektor.",
      "rdfs:label": {
        "@value": "Reg_1030488_Par_9 (redaktsioon 1030488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030488",
      "estleg:sourceAct": "Konkurentsiameti põhimäärus",
      "estleg:provisionRef": "Reg_1030488 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030488_Map_2026"
      }
    },
