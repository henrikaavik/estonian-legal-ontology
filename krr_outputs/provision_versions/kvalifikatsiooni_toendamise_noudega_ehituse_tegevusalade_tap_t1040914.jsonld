    {
      "@id": "estleg:Reg_1040914_Par_2_v1040914",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040914_Par_2"
