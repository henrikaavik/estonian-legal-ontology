      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Uuringu liigid, uuringu tegemise ja sellega seotud kulu hüvitamise kord ning uuringuteatise vorminõuded ja teatise esitamise kord (22 versiooni)",
        "@language": "et"
      },
      "dc:source": "Uuringu liigid, uuringu tegemise ja sellega seotud kulu hüvitamise kord ning uuringuteatise vorminõuded ja teatise esitamise kord"
    },
    {
      "@id": "estleg:Reg_1047017_Par_1_v1047017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047017_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus sätestab mälestise ja muinsuskaitsealal asuva ehitise 1 1) uuringu liigid ja uuringu tegemise korra; 2 2) uuringuteatise vorminõuded ja selle esitamise korra; 3 3) uuringu dokumenteerimise korra ja nõuded uuringuaruandele; 4 4) uuringu tegemisega seotud hüvitise määra, hüvitise taotlemise ja maksmise tingimused ja korra ning taotluse rahuldamata jätmise alused ja korra. Määrus sätestab mälestise ja muinsuskaitsealal asuva ehitise uuringu liigid ja uuringu tegemise korra; uuringuteatise vorminõuded ja selle esitamise korra; uuringu dokumenteerimise korra ja nõuded uuringuaruandele; uuringu tegemisega seotud hüvitise määra, hüvitise taotlemise ja maksmise tingimused ja korra ning taotluse rahuldamata jätmise alused ja korra.",
      "rdfs:label": {
        "@value": "Reg_1047017_Par_1 (redaktsioon 1047017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047017",
      "estleg:sourceAct": "Uuringu liigid, uuringu tegemise ja sellega seotud kulu hüvitamise kord ning uuringuteatise vorminõuded ja teatise esitamise kord",
      "estleg:provisionRef": "Reg_1047017 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047017_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047017_Par_10_v1047017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047017_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Allveearheoloogilise uuringuga selgitatakse välja veealuste kultuuriväärtusega asjade ja kultuurkihi olemasolu, lokaliseeritakse, dokumenteeritakse need ning hinnatakse nende seisukorda ja säilimise ulatust kasutades sukeldumist, sealhulgas allveearheoloogilist kaevamist või tehnilisi vahendeid või seadmeid, mida juhitakse maismaalt või vee pealt (sealhulgas külgvaate ja muud sonarisüsteemid, allveerobotid). Allveearheoloogilise uuringuga selgitatakse välja veealuste kultuuriväärtusega asjade ja kultuurkihi olemasolu, lokaliseeritakse, dokumenteeritakse need ning hinnatakse nende seisukorda ja säilimise ulatust kasutades sukeldumist, sealhulgas allveearheoloogilist kaevamist või tehnilisi vahendeid või seadmeid, mida juhitakse maismaalt või vee pealt (sealhulgas külgvaate ja muud sonarisüsteemid, allveerobotid). 2 (2) Allveearheoloogilise uuringu puhul eelistatakse esemete ja detailide säilitamist leidmise algses asukohas. Allveearheoloogilise uuringu puhul eelistatakse esemete ja detailide säilitamist leidmise algses asukohas.",
      "rdfs:label": {
        "@value": "Reg_1047017_Par_10 (redaktsioon 1047017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047017",
