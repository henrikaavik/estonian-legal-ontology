    {
      "@id": "estleg:Reg_1047017_Par_3_v1047017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047017_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Arhiivi- ja bibliograafiauuringuga selgitatakse välja kirjalike materjalide (dokumentide, jooniste, fotode) olemasolu ning koostatakse nende põhjal ülevaade uuritava objekti kujunemisest. Arhiivi- ja bibliograafiauuringuga selgitatakse välja kirjalike materjalide (dokumentide, jooniste, fotode) olemasolu ning koostatakse nende põhjal ülevaade uuritava objekti kujunemisest. 2 (2) Arhiivi- ja bibliograafiauuringust saadakse lähteandmed edasiste uuringute tegemiseks ja muinsuskaitse eritingimuste väljastamiseks. Arhiivi- ja bibliograafiauuringust saadakse lähteandmed edasiste uuringute tegemiseks ja muinsuskaitse eritingimuste väljastamiseks. 3 (3) Arhiivi- ja bibliograafiauuringu käigus hinnatakse uuritava objekti arhitektuurilist, ajaloolist, arheoloogilist, kunstilist ja kultuuriloolist väärtust. Arhiivi- ja bibliograafiauuringu käigus hinnatakse uuritava objekti arhitektuurilist, ajaloolist, arheoloogilist, kunstilist ja kultuuriloolist väärtust.",
      "rdfs:label": {
        "@value": "Reg_1047017_Par_3 (redaktsioon 1047017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047017",
      "estleg:sourceAct": "Uuringu liigid, uuringu tegemise ja sellega seotud kulu hüvitamise kord ning uuringuteatise vorminõuded ja teatise esitamise kord",
      "estleg:provisionRef": "Reg_1047017 § 3",
      "estleg:partOfAct": {
