    {
      "@id": "estleg:Reg_1047017_Par_22_v1047017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047017_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotlus jäetakse rahuldamata, kui: 1 1) uuring ei ole tehtud nõuetekohaselt; 2 2) uuringut ei teinud pädev isik ja uuringu tegija kvalifikatsioon peab olema tõendatud muinsuskaitseseaduse alusel; 3 3) amet ei ole uuringuaruannet heaks kiitnud; 4 4) taotleja on esitanud valeandmeid. Taotlus jäetakse rahuldamata, kui: uuring ei ole tehtud nõuetekohaselt; uuringut ei teinud pädev isik ja uuringu tegija kvalifikatsioon peab olema tõendatud muinsuskaitseseaduse alusel; amet ei ole uuringuaruannet heaks kiitnud; taotleja on esitanud valeandmeid.",
      "rdfs:label": {
