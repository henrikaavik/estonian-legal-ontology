    {
      "@id": "estleg:Reg_1047017_Par_5_v1047017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047017_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Viimistluskihtide uuringuga tehakse kindlaks viimistluskihtide järjestus, vanus, säilivus, materjal, kujundusvõte ja seisukord. Viimistluskihtide uuringuga tehakse kindlaks viimistluskihtide järjestus, vanus, säilivus, materjal, kujundusvõte ja seisukord. 2 (2) Uuringu tegemiseks kasutatakse viimistluskihtide sondaaži ning vajadusel tehakse materjaliuuring ja mittelõhkuvaid tehnilisi uuringuid (näiteks infrapunauuring, ultraviolettuuring, röntgenuuring jms). Uuringu tegemiseks kasutatakse viimistluskihtide sondaaži ning vajadusel tehakse materjaliuuring ja mittelõhkuvaid tehnilisi uuringuid (näiteks infrapunauuring, ultraviolettuuring, röntgenuuring jms).",
      "rdfs:label": {
