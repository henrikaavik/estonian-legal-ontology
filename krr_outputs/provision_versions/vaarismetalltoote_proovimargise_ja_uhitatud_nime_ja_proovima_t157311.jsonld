  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_vaarismetalltoote_proovimargise_ja_uhitatud_nime_ja_proovima_t157311_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Väärismetalltoote proovimärgise ja ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nime ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Väärismetalltoote proovimärgise ja ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nime ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord"
    },
    {
      "@id": "estleg:Reg_157311_Par_1_v157311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157311_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse kuld-, hõbe-, plaatina- ja pallaadiumtoote proovimärgise ning ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nimemärgisega ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord, eesmärgiga tagada märgiste ühtsus ja kontrollitavus ning märgiste tarbijale arusaadavus ja loetavus. Määrusega kehtestatakse kuld-, hõbe-, plaatina- ja pallaadiumtoote proovimärgise ning ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nimemärgisega ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord, eesmärgiga tagada märgiste ühtsus ja kontrollitavus ning märgiste tarbijale arusaadavus ja loetavus.",
      "rdfs:label": {
        "@value": "Reg_157311_Par_1 (redaktsioon 157311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157311",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157311",
      "estleg:sourceAct": "Väärismetalltoote proovimärgise ja ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nime ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord",
      "estleg:provisionRef": "Reg_157311 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157311_Par_2_v157311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157311_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väärismetalltoodete proovimärgise kujuks on: 1 1) kuldtoodetel ristkülik; RT I 2022-12-30 4 130122022004 2023-01-02 2 2) hõbetoodetel lõigatud otstega ovaal; RT I 2022-12-30 4 130122022004 2023-01-02 3 3) plaatinatoodetel lõigatud nurkadega ristkülik; RT I 2022-12-30 4 130122022004 2023-01-02 4 4) pallaadiumtoodetel pikemale alusele toetuv võrdhaarne trapets. RT I 2022-12-30 4 130122022004 2023-01-02 Väärismetalltoodete proovimärgise kujuks on: kuldtoodetel ristkülik; hõbetoodetel lõigatud otstega ovaal; plaatinatoodetel lõigatud nurkadega ristkülik; pallaadiumtoodetel pikemale alusele toetuv võrdhaarne trapets. 2 (2) Kehtetu - RT I 2022-12-30 4 130122022004 2023-01-02 Kehtetu - 3 (3) Proovimärgiste kuju ning proovi tähistavate numbrite laad peavad vastama määruse lisas esitatud graafilisele kujutisele. RT I 2022-12-30 4 130122022004 2023-01-02 Proovimärgiste kuju ning proovi tähistavate numbrite laad peavad vastama määruse lisas esitatud graafilisele kujutisele.",
      "rdfs:label": {
        "@value": "Reg_157311_Par_2 (redaktsioon 157311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157311",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157311",
      "estleg:sourceAct": "Väärismetalltoote proovimärgise ja ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nime ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord",
      "estleg:provisionRef": "Reg_157311 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157311_Par_3_v157311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157311_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Proovimärgise mõõtmed võib vabalt valida tingimusel, et selle kõrgus on vähemalt 0,5 millimeetrit ja täidetud on lõikes 2 esitatud nõue. RT I 2022-12-30 4 130122022004 2023-01-02 Proovimärgise mõõtmed võib vabalt valida tingimusel, et selle kõrgus on vähemalt 0,5 millimeetrit ja täidetud on lõikes 2 esitatud nõue. 2 (2) Proovimärgise kõrguse ja pikkuse suhe on märgise keskelt mõõdetuna 2:3. RT I 2022-12-30 4 130122022004 2023-01-02 Proovimärgise kõrguse ja pikkuse suhe on märgise keskelt mõõdetuna 2:3.",
      "rdfs:label": {
        "@value": "Reg_157311_Par_3 (redaktsioon 157311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157311",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157311",
      "estleg:sourceAct": "Väärismetalltoote proovimärgise ja ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nime ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord",
      "estleg:provisionRef": "Reg_157311 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157311_Par_4_v157311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157311_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ühitatud nime- ja proovimärgise korral paigutatakse nimemärgis registrisse kantud kujul ja proovi tähistavad, määruse lisas esitatud graafilisele kujutisele vastavad, numbrid väärismetalli sulamit tähistavasse, § 2 lõike 1 kohasesse kujusse. RT I 2022-12-30 4 130122022004 2023-01-02 Ühitatud nime- ja proovimärgise korral paigutatakse nimemärgis registrisse kantud kujul ja proovi tähistavad, määruse lisas esitatud graafilisele kujutisele vastavad, numbrid väärismetalli sulamit tähistavasse, § 2 lõike 1 kohasesse kujusse. 2 (2) Ühitatud nime- ja proovimärgises on esimesel kohal nimemärgis. Ühitatud nime- ja proovimärgises on esimesel kohal nimemärgis. 3 (3) Ühitatud nime- ja proovimärgise korral ei pea järgima märgise kõrguse ja pikkuse suhet tingimusel, et äratuntavalt säilib väärismetalli tähistava märgise kuju ja märgise kõrgus on vähemalt 0,5 millimeetrit. RT I 2022-12-30 4 130122022004 2023-01-02 Ühitatud nime- ja proovimärgise korral ei pea järgima märgise kõrguse ja pikkuse suhet tingimusel, et äratuntavalt säilib väärismetalli tähistava märgise kuju ja märgise kõrgus on vähemalt 0,5 millimeetrit.",
      "rdfs:label": {
        "@value": "Reg_157311_Par_4 (redaktsioon 157311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157311",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157311",
      "estleg:sourceAct": "Väärismetalltoote proovimärgise ja ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nime ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord",
      "estleg:provisionRef": "Reg_157311 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157311_Par_5_v157311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157311_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu - RT I 2022-12-30 4 130122022004 2023-01-02 Kehtetu - 2 (2) Mitmeosalise toote korral kantakse kohustuslikud märgised (nime- ja proovimärgis või ühitatud nime- ja proovimärgis) igale eraldatavale osale, kui see on objekti mõõtmeid arvestades võimalik. RT I 2022-12-30 4 130122022004 2023-01-02 Mitmeosalise toote korral kantakse kohustuslikud märgised (nime- ja proovimärgis või ühitatud nime- ja proovimärgis) igale eraldatavale osale, kui see on objekti mõõtmeid arvestades võimalik.",
      "rdfs:label": {
        "@value": "Reg_157311_Par_5 (redaktsioon 157311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157311",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157311",
      "estleg:sourceAct": "Väärismetalltoote proovimärgise ja ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nime ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord",
      "estleg:provisionRef": "Reg_157311 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157311_Par_6_v157311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157311_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ühitatud nime- ja proovimärgis ning nimemärgis ja temale järgnev proovimärgis üksikmärgistena paigutatakse kontrollmärgise olemasolul selle ette. RT I 2024-05-03 3 103052024003 2024-05-06 Ühitatud nime- ja proovimärgis ning nimemärgis ja temale järgnev proovimärgis üksikmärgistena paigutatakse kontrollmärgise olemasolul selle ette. 2 (2) Kõikide märgiste kasutamisel rivistatakse üksikmärgised järgnevalt: nimemärgis, proovimärgis, kontrollmärgis. RT I 2024-05-03 3 103052024003 2024-05-06 Kõikide märgiste kasutamisel rivistatakse üksikmärgised järgnevalt: nimemärgis, proovimärgis, kontrollmärgis. 3 (3) Ühitatud märgiste kasutamisel rivistatakse märgised sõltuvalt kasutatavast ühitatud märgisest järgmiselt: 1 1) ühitatud nime- ja proovimärgis, kontrollmärgis või RT I 2024-05-03 3 103052024003 2024-05-06 2 2) nimemärgis, ühitatud proovi- ja kontrollmärgis. RT I 2024-05-03 3 103052024003 2024-05-06 Ühitatud märgiste kasutamisel rivistatakse märgised sõltuvalt kasutatavast ühitatud märgisest järgmiselt: ühitatud nime- ja proovimärgis, kontrollmärgis või nimemärgis, ühitatud proovi- ja kontrollmärgis. 4 (4) Märgiste rivis mõne märgise puudumine ei muuda lõigetes 1, 2 ja 3 toodud järjestust. Märgiste rivis mõne märgise puudumine ei muuda lõigetes 1, 2 ja 3 toodud järjestust. 5 (5) Üksik- ja ühitatud märgised võib kanda tootele rivina ühtses ristkülikukujulises raamis. Kõik rivistatud märgised peavad sellisel juhul säilitama oma iseloomuliku kuju ja proovi tähistavate numbrite laadi. RT I 2022-12-30 4 130122022004 2023-01-02 Üksik- ja ühitatud märgised võib kanda tootele rivina ühtses ristkülikukujulises raamis. Kõik rivistatud märgised peavad sellisel juhul säilitama oma iseloomuliku kuju ja proovi tähistavate numbrite laadi.",
      "rdfs:label": {
        "@value": "Reg_157311_Par_6 (redaktsioon 157311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157311",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157311",
      "estleg:sourceAct": "Väärismetalltoote proovimärgise ja ühitatud nime- ja proovimärgise kuju ning väärismetalltoote nime ja proovimärgisega või ühitatud nime- ja proovimärgisega märgistamise kord",
      "estleg:provisionRef": "Reg_157311 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157311_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157311_Par_7_v157311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157311_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Erinevate väärismetallide sulamitest koosneva väärismetalltoote korral kantakse kõikide sulamite proovimärgised väärismetalltootele üksteise järele, kusjuures nimemärgise järgselt on esimesena selle sulami proovimärgis, mida on tootes kõige rohkem. Sulamite koguste võrdsuse korral on esikohal kõrgeima väärtusega sulami proovimärgis. Erinevate väärismetallide sulamitest koosneva väärismetalltoote korral kantakse kõikide sulamite proovimärgised väärismetalltootele üksteise järele, kusjuures nimemärgise järgselt on esimesena selle sulami proovimärgis, mida on tootes kõige rohkem. Sulamite koguste võrdsuse korral on esikohal kõrgeima väärtusega sulami proovimärgis. 2 (2) Kui kõik proovimärgised ei mahu tootele, siis märgistatakse toode selle sulami proovimärgisega, mida on tootes kõige rohkem ja teised kasutatud sulamid tõendatakse valmistaja sertifikaadiga või väärismetalli proovi tõendaja sertifikaadiga või müüja poolt proovide kandmisega müügidokumendile valmistaja või väärismetalli proovi tõendaja sertifikaadi alusel. Kui kõik proovimärgised ei mahu tootele, siis märgistatakse toode selle sulami proovimärgisega, mida on tootes kõige rohkem ja teised kasutatud sulamid tõendatakse valmistaja sertifikaadiga või väärismetalli proovi tõendaja sertifikaadiga või müüja poolt proovide kandmisega müügidokumendile valmistaja või väärismetalli proovi tõendaja sertifikaadi alusel. 3 (3) Ühe väärismetalli erinevate proovidega sulamitest koosnevad tooted märgistatakse kasutatud madalaima prooviga sulami järgi. Ühe väärismetalli erinevate proovidega sulamitest koosnevad tooted märgistatakse kasutatud madalaima prooviga sulami järgi.",
      "rdfs:label": {
        "@value": "Reg_157311_Par_7 (redaktsioon 157311)",
        "@language": "et"
      },
