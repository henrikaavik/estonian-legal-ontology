      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
      "estleg:sourceAct": "Kohtutäiturimäärustik",
      "estleg:provisionRef": "Reg_339492 § 59",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339492_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_339492_Par_5_5_v339492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339492_Par_5_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohtutäituri abil on ametitunnistus. Igal ametitunnistusel on kordumatu number, mis avaldatakse koos kohtutäituri abi nimega kohtutäituri abide nimekirjas. Kohtutäituri abil on ametitunnistus. Igal ametitunnistusel on kordumatu number, mis avaldatakse koos kohtutäituri abi nimega kohtutäituri abide nimekirjas. 2 (2) Kohtutäituri abi tunnistusele kantavad andmed ning tunnistuse vormi määrab Kohtutäiturite ja Pankrotihaldurite Koja ametikogu (edaspidi ametikogu) juhatus. Kohtutäituri abi tunnistusele kantavad andmed ning tunnistuse vormi määrab Kohtutäiturite ja Pankrotihaldurite Koja ametikogu (edaspidi ametikogu) juhatus. 3 (3) Kohtutäituri abi tunnistusi väljastab ja neid tunnistab kehtetuks ametikogu juhatus. RT I 2011-01-20 2 120012011002 2011-01-23 Kohtutäituri abi tunnistusi väljastab ja neid tunnistab kehtetuks ametikogu juhatus.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_5_5 (redaktsioon 339492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
      "estleg:sourceAct": "Kohtutäiturimäärustik",
      "estleg:provisionRef": "Reg_339492 § 5_5",
