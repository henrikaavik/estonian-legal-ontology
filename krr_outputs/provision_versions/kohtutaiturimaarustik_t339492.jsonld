      "estleg:provisionRef": "Reg_339492 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339492_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_339492_Par_21_26_v339492",
