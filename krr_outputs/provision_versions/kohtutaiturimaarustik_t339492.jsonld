    {
      "@id": "estleg:Reg_339492_Par_62_v339492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339492_Par_62"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohtutäitur peab täitekulude kohta täpset arvestust ning säilitab kuludokumendid. Kohtutäitur peab täitekulude kohta täpset arvestust ning säilitab kuludokumendid. 2 (2) Täitekulude väljamõistmisel tuleb vastav kohtutäituri otsus võlgnikule viivitamata kätte toimetada. Täitekulude otsuses tuleb esitada kulude loetelu, märkides ära iga erineva kulu summa, viidata võlgniku õigusele tutvuda kuludokumentidega ning selgitada talle kaebamise korda. Täitekulude väljamõistmisel tuleb vastav kohtutäituri otsus võlgnikule viivitamata kätte toimetada. Täitekulude otsuses tuleb esitada kulude loetelu, märkides ära iga erineva kulu summa, viidata võlgniku õigusele tutvuda kuludokumentidega ning selgitada talle kaebamise korda.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_62 (redaktsioon 339492)",
        "@language": "et"
      },
