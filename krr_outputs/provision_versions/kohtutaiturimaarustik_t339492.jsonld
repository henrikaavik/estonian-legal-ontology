    {
      "@id": "estleg:Reg_339492_Par_61_v339492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339492_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohtutäitur peab täitekulude kandmisel arvestama võimaliku väiksema kuluga, mida saab teha, et säästa võlgnikku liigselt koormavatest kohustustest. Kohtutäitur lähtub kulutuste suuruse arvestamisel heast raamatupidamistavast ja säästlikkuse põhimõttest. Kohtutäitur peab täitekulude kandmisel arvestama võimaliku väiksema kuluga, mida saab teha, et säästa võlgnikku liigselt koormavatest kohustustest. Kohtutäitur lähtub kulutuste suuruse arvestamisel heast raamatupidamistavast ja säästlikkuse põhimõttest. 2 (2) Täitekuludeks ei loeta kohtutäituri büroo majandamise kulusid, nagu näiteks bürooruumide rent, laenumaksed, liisingumaksed, kommunaalkulud, tehniliste seadmete amortisatsioon, töötajate palk ja dokumentide hoidmise kulud. Täitekuludeks ei loeta kohtutäituri büroo majandamise kulusid, nagu näiteks bürooruumide rent, laenumaksed, liisingumaksed, kommunaalkulud, tehniliste seadmete amortisatsioon, töötajate palk ja dokumentide hoidmise kulud.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_61 (redaktsioon 339492)",
        "@language": "et"
      },
