      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koja liikmemaksu suurus ametikogu liikmele on viis protsenti kohtutäituri ametitegevuse pealt laekunud kohtutäituri tasust. RT I 2020-12-29 31 129122020031 2021-01-01 Koja liikmemaksu suurus ametikogu liikmele on viis protsenti kohtutäituri ametitegevuse pealt laekunud kohtutäituri tasust.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_11_13 (redaktsioon 339492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
      "estleg:sourceAct": "Kohtutäiturimäärustik",
      "estleg:provisionRef": "Reg_339492 § 11_13",
      "estleg:partOfAct": {
