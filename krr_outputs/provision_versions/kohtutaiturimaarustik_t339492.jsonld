    {
      "@id": "estleg:Reg_339492_Par_1_v339492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339492_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtutäiturite tööpiirkonnad on järgmised: 1 1) Harju tööpiirkond, mis hõlmab Harju maakonda; 2 2) Viru tööpiirkond, mis hõlmab Lääne-Viru ja Ida-Viru maakonda; 3 3) Tartu tööpiirkond, mis hõlmab Tartu, Viljandi, Jõgeva, Põlva, Valga ja Võru maakonda; 4 4) Pärnu tööpiirkond, mis hõlmab Pärnu, Saare, Hiiu, Lääne, Järva ja Rapla maakonda. Kohtutäiturite tööpiirkonnad on järgmised: Harju tööpiirkond, mis hõlmab Harju maakonda; Viru tööpiirkond, mis hõlmab Lääne-Viru ja Ida-Viru maakonda; Tartu tööpiirkond, mis hõlmab Tartu, Viljandi, Jõgeva, Põlva, Valga ja Võru maakonda; Pärnu tööpiirkond, mis hõlmab Pärnu, Saare, Hiiu, Lääne, Järva ja Rapla maakonda.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_1 (redaktsioon 339492)",
        "@language": "et"
      },
