    {
      "@id": "estleg:Reg_339492_Par_82_117_v339492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339492_Par_82_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse § 161 lõikeid 1 ja 2, milles on sätestatud pangalingiteenuse kasutamise võimalus, rakendatakse alates 2018. aasta 1. jaanuarist. RT I 2015-08-18 3 118082015003 2015-08-21 Käesoleva määruse § 161 lõikeid 1 ja 2, milles on sätestatud pangalingiteenuse kasutamise võimalus, rakendatakse alates 2018. aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_82_117 (redaktsioon 339492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
      "estleg:sourceAct": "Kohtutäiturimäärustik",
      "estleg:provisionRef": "Reg_339492 § 82_117",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339492_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_339492_Par_82_118_v339492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339492_Par_82_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse § 53 lõikes 1 ja § 55 lõikes 1 nimetatud arestimisfaili vahetus täitemenetlusregistri, maksukohustuslaste registri ja krediidiasutuse infosüsteemi vahel lõpetatakse 31. detsembril 2019. RT I 2018-11-30 14 130112018014 2018-12-03 Käesoleva määruse § 53 lõikes 1 ja § 55 lõikes 1 nimetatud arestimisfaili vahetus täitemenetlusregistri, maksukohustuslaste registri ja krediidiasutuse infosüsteemi vahel lõpetatakse 31. detsembril 2019.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_82_118 (redaktsioon 339492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
      "estleg:sourceAct": "Kohtutäiturimäärustik",
      "estleg:provisionRef": "Reg_339492 § 82_118",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339492_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_339492_Par_83_v339492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339492_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 2010. aasta 1. jaanuaril. Määrus jõustub 2010. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_83 (redaktsioon 339492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
      "estleg:sourceAct": "Kohtutäiturimäärustik",
      "estleg:provisionRef": "Reg_339492 § 83",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339492_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_339492_Par_9_v339492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339492_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohtutäitur võib vastu võtta ja edastada ametitoimingutega seotud dokumente ja kirjavahetust ametialase elektronposti (edaspidi e-post) vahendusel. Kohtutäituri kinnitust vajavad dokumendid peavad olema esitatud digitaalallkirjastatult käesolevas määruses sätestatud korras, kui adressaat ei nõua teisiti. Kohtutäitur võib vastu võtta ja edastada ametitoimingutega seotud dokumente ja kirjavahetust ametialase elektronposti (edaspidi e-post) vahendusel. Kohtutäituri kinnitust vajavad dokumendid peavad olema esitatud digitaalallkirjastatult käesolevas määruses sätestatud korras, kui adressaat ei nõua teisiti. 2 (2) Kohtutäituri ametialane e-posti aadress avaldatakse Kohtutäiturite ja Pankrotihaldurite Koja kodulehel ja kohtutäituri poolt vormistatavates dokumentides. RT I 2021-04-21 22 121042021022 2021-04-24 Kohtutäituri ametialane e-posti aadress avaldatakse Kohtutäiturite ja Pankrotihaldurite Koja kodulehel ja kohtutäituri poolt vormistatavates dokumentides.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_9 (redaktsioon 339492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
      "estleg:sourceAct": "Kohtutäiturimäärustik",
      "estleg:provisionRef": "Reg_339492 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339492_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_339492_Par_9_10_v339492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339492_Par_9_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohtutäiturite nimed, büroode aadressi- ja kontaktandmed, ametialase elektronposti aadressid ning kohtutäiturite kasutatavate veebilehtede aadressid avaldatakse Kohtutäiturite ja Pankrotihaldurite Koja (edaspidi koda) veebilehel. Andmed avaldatakse piirkondade kaupa kohtutäiturite perekonnanimede põhjal koostatud tähestikulise nimekirjana. RT I 2018-11-30 14 130112018014 2018-12-03 Kohtutäiturite nimed, büroode aadressi- ja kontaktandmed, ametialase elektronposti aadressid ning kohtutäiturite kasutatavate veebilehtede aadressid avaldatakse Kohtutäiturite ja Pankrotihaldurite Koja (edaspidi koda) veebilehel. Andmed avaldatakse piirkondade kaupa kohtutäiturite perekonnanimede põhjal koostatud tähestikulise nimekirjana. 2 (2) Kohtutäitur võib avaldada käesoleva paragrahvi lõikes 1 nimetatud teavet enda ja oma büroo kohta ja selgitavat informatsiooni kohtutäituri ametitegevuse kohta interneti avalikul veebilehel. Kohtutäituri poolt selleks kasutatav või sellele suunav veebilehe aadress ning veebilehe sisu peab võimaldama kahtlusteta eristada kohtutäiturit teistest kohtutäituritest. RT I 2011-01-20 2 120012011002 2011-01-23 Kohtutäitur võib avaldada käesoleva paragrahvi lõikes 1 nimetatud teavet enda ja oma büroo kohta ja selgitavat informatsiooni kohtutäituri ametitegevuse kohta interneti avalikul veebilehel. Kohtutäituri poolt selleks kasutatav või sellele suunav veebilehe aadress ning veebilehe sisu peab võimaldama kahtlusteta eristada kohtutäiturit teistest kohtutäituritest.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_9_10 (redaktsioon 339492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
      "estleg:sourceAct": "Kohtutäiturimäärustik",
      "estleg:provisionRef": "Reg_339492 § 9_10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339492_Map_2026"
      }
    },
