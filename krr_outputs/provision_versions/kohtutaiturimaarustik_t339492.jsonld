      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eksam toimub kolmes osas: õigusteadmiste test, kaasuste lahendamine (õigusliku arvamuse koostamine) ja vestlus. Kaasused lahendatakse testiga samal päeval. Eksam toimub kolmes osas: õigusteadmiste test, kaasuste lahendamine (õigusliku arvamuse koostamine) ja vestlus. Kaasused lahendatakse testiga samal päeval. 2 (2) Õigusteadmiste testi ja kaasuste lahendamisega kontrollitakse kohtutäiturieksamil osaleja erialateadmisi järgmistes valdkondades: 1 1) tsiviilõiguse üldosa; 2 2) võlaõigus; 3 3) asjaõigus, sealhulgas laeva asjaõigus; 4 4) perekonnaõigus; 5 5) pärimisõigus; 6 6) ühinguõigus; 7 7) tsiviilkohtu- ja täitemenetlusõigus; 8 8) pankrotiõigus; 9 9) haldusõigus. RT I 2025-02-21 11 121022025011 2025-02-24 Õigusteadmiste testi ja kaasuste lahendamisega kontrollitakse kohtutäiturieksamil osaleja erialateadmisi järgmistes valdkondades: tsiviilõiguse üldosa; võlaõigus; asjaõigus, sealhulgas laeva asjaõigus; perekonnaõigus; pärimisõigus; ühinguõigus; tsiviilkohtu- ja täitemenetlusõigus; pankrotiõigus; haldusõigus.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_75 (redaktsioon 339492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
