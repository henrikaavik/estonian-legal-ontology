      "estleg:versionText": "Kohtutäitur ja kohtutäituri abi on kohustatud läbima perioodilise täiendusõppe. Kohtutäitur ja kohtutäituri abi on kohustatud läbima perioodilise täiendusõppe.",
      "rdfs:label": {
        "@value": "Reg_339492_Par_77 (redaktsioon 339492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339492",
