      }
    },
    {
      "@id": "estleg:Reg_1052073_Par_2_v1052073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052073_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus kohaldub kõikidele Eestis tegevusloa saanud krediidiasutustele individuaalsel, allkonsolideeritud ja konsolideeritud alusel. Määrus kohaldub kõikidele Eestis tegevusloa saanud krediidiasutustele individuaalsel, allkonsolideeritud ja konsolideeritud alusel.",
      "rdfs:label": {
        "@value": "Reg_1052073_Par_2 (redaktsioon 1052073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052073",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052073",
      "estleg:sourceAct": "Süsteemse riski puhvri nõude tunnustamise kord",
      "estleg:provisionRef": "Reg_1052073 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052073_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052073_Par_3_v1052073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052073_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti Pank kaalub lepinguriigis või kolmandas riigis süsteemse riski puhvri määra kehtestajaks määratud asutuse või organi (edaspidi määratud asutus) kehtestatud süsteemse riski puhvri nõude tunnustamist, kui määratud asutus on sellist tunnustamist soovinud. Eesti Pank kaalub lepinguriigis või kolmandas riigis süsteemse riski puhvri määra kehtestajaks määratud asutuse või organi (edaspidi määratud asutus) kehtestatud süsteemse riski puhvri nõude tunnustamist, kui määratud asutus on sellist tunnustamist soovinud. 2 (2) Teise lepinguriigi või kolmanda riigi süsteemse riski puhvri nõude tunnustamise või mittetunnustamise otsuse ette valmistamisel ja oluliste asjaolude hindamisel võtab Eesti Pank muu hulgas arvesse teavet, mille määratud asutus on esitanud kooskõlas direktiivi nr 2013/36/EL artikli 133 lõigetega 9 ja 13. Teise lepinguriigi või kolmanda riigi süsteemse riski puhvri nõude tunnustamise või mittetunnustamise otsuse ette valmistamisel ja oluliste asjaolude hindamisel võtab Eesti Pank muu hulgas arvesse teavet, mille määratud asutus on esitanud kooskõlas direktiivi nr 2013/36/EL artikli 133 lõigetega 9 ja 13. 3 (3) Eesti Panga tunnustatav teise lepinguriigi või kolmanda riigi kehtestatud süsteemse riski puhvri nõue võib kumuleeruda muude Eestis kehtivate süsteemse riski puhvri nõuetega, tingimusel et need nõuded käsitlevad erinevaid riske. Eesti Panga tunnustatav teise lepinguriigi või kolmanda riigi kehtestatud süsteemse riski puhvri nõue võib kumuleeruda muude Eestis kehtivate süsteemse riski puhvri nõuetega, tingimusel et need nõuded käsitlevad erinevaid riske. 4 (4) Teise lepinguriigi või kolmanda riigi süsteemse riski puhvri nõude tunnustamine toimub Eesti Panga presidendi määruse alusel ja tingimustel. Määruses sätestatakse vähemalt järgmised asjaolud: 1 1) krediidiasutused, kellele süsteemse riski puhvri nõuet kohaldatakse; 2 2) riskipositsioonid, mille suhtes süsteemse riski puhvri nõuet kohaldatakse; 3 3) süsteemse riski puhvri nõude määr; 4 4) kuupäev, millest alates peavad krediidiasutused süsteemse riski puhvri nõuet kohaldama. Teise lepinguriigi või kolmanda riigi süsteemse riski puhvri nõude tunnustamine toimub Eesti Panga presidendi määruse alusel ja tingimustel. Määruses sätestatakse vähemalt järgmised asjaolud: krediidiasutused, kellele süsteemse riski puhvri nõuet kohaldatakse; riskipositsioonid, mille suhtes süsteemse riski puhvri nõuet kohaldatakse; süsteemse riski puhvri nõude määr; kuupäev, millest alates peavad krediidiasutused süsteemse riski puhvri nõuet kohaldama.",
      "rdfs:label": {
        "@value": "Reg_1052073_Par_3 (redaktsioon 1052073)",
        "@language": "et"
      },
