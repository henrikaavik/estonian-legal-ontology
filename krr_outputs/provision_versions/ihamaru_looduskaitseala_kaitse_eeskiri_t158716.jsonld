    {
      "@id": "estleg:Reg_158716_Par_10_v158716",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158716_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) kaitsealuste liikide elutingimuste säilitamiseks ja poollooduslike koosluste ilme ja liigikoosseisu tagamiseks vajalik tegevus; 2 2) metsakoosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: kaitsealuste liikide elutingimuste säilitamiseks ja poollooduslike koosluste ilme ja liigikoosseisu tagamiseks vajalik tegevus; metsakoosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas.",
      "rdfs:label": {
        "@value": "Reg_158716_Par_10 (redaktsioon 158716)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158716",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158716",
      "estleg:sourceAct": "Ihamaru looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158716 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158716_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158716_Par_11_v158716",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158716_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on ökoloogilise stabiilsuse tagamine, sealse elustiku mitmekesisuse ja maa kasutamisel väljakujunenud traditsioonilise pärandkultuurmaastiku ilme säilitamine. Piiranguvööndi kaitse-eesmärk on ökoloogilise stabiilsuse tagamine, sealse elustiku mitmekesisuse ja maa kasutamisel väljakujunenud traditsioonilise pärandkultuurmaastiku ilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_158716_Par_11 (redaktsioon 158716)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158716",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158716",
      "estleg:sourceAct": "Ihamaru looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158716 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158716_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158716_Par_12_v158716",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158716_Par_12"
      },
