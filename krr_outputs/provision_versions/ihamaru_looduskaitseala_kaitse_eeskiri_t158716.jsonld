    {
      "@id": "estleg:Reg_158716_Par_5_v158716",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158716_Par_5"
