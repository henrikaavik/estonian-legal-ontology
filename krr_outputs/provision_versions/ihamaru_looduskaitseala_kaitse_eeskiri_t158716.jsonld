    {
      "@id": "estleg:Reg_158716_Par_14_v158716",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158716_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 2 2) ehitise, kaasa arvatud ajutise ehitise püstitamine; 3 3) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 4 4) puidu kokku- ja väljavedu külmumata pinnasel; 5 5) puhtpuistute kujundamine ja energiapuistute rajamine; 6 6) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 7 7) biotsiidi ja taimekaitsevahendi kasutamine; 8 8) uue maaparandussüsteemi rajamine. Piiranguvööndis on keelatud: veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; ehitise, kaasa arvatud ajutise ehitise püstitamine; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel; puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; biotsiidi ja taimekaitsevahendi kasutamine; uue maaparandussüsteemi rajamine.",
      "rdfs:label": {
        "@value": "Reg_158716_Par_14 (redaktsioon 158716)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158716",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158716",
      "estleg:sourceAct": "Ihamaru looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158716 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158716_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158716_Par_2_v158716",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158716_Par_2"
      },
