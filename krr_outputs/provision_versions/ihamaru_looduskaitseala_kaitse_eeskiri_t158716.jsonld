      "estleg:provisionRef": "Reg_158716 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158716_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158716_Par_7_v158716",
      "@type": [
        "owl:NamedIndividual",
