      }
    },
    {
      "@id": "estleg:Reg_158716_Par_13_v158716",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158716_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on lubatud majandustegevus «Looduskaitseseadusega» sätestatud piiranguid arvestades. Piiranguvööndis on lubatud majandustegevus «Looduskaitseseadusega» sätestatud piiranguid arvestades.",
      "rdfs:label": {
        "@value": "Reg_158716_Par_13 (redaktsioon 158716)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158716",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158716",
