    {
      "@id": "estleg:Reg_1047712_Par_2_v1047712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047712_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hoidlad jagunevad sõltuvalt mahust: 1 1) väikesed hoidlad, mille maht on 3 kuni 10 m³; 2 2) keskmised hoidlad, mille maht on üle 10 m³ ja kuni 5000 m³; 3 3) suured hoidlad, mille maht on üle 5000 m³. Hoidlad jagunevad sõltuvalt mahust: väikesed hoidlad, mille maht on 3 kuni 10 m³; keskmised hoidlad, mille maht on üle 10 m³ ja kuni 5000 m³; suured hoidlad, mille maht on üle 5000 m³.",
      "rdfs:label": {
        "@value": "Reg_1047712_Par_2 (redaktsioon 1047712)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047712",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047712",
      "estleg:sourceAct": "Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded",
      "estleg:provisionRef": "Reg_1047712 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047712_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047712_Par_3_v1047712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047712_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hoidlad ja selle seadmed peavad olema lekkekindlad. Hoidlad ja selle seadmed peavad olema lekkekindlad. 2 (2) Hoidla torustikud peavad olema kaitstud korrosiooni ning mehaaniliste vigastuste eest. Hoidla torustikud peavad olema kaitstud korrosiooni ning mehaaniliste vigastuste eest.",
      "rdfs:label": {
        "@value": "Reg_1047712_Par_3 (redaktsioon 1047712)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047712",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047712",
      "estleg:sourceAct": "Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded",
      "estleg:provisionRef": "Reg_1047712 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047712_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047712_Par_4_v1047712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047712_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Suure ja keskmise hoidla maapealsed mahutid peavad olema ümbritsetud piirdega, mis takistab piirde sisse jäävatest mahutitest väljavoolava naftasaaduse, põlevkiviõli, selle saaduse või biokütuse laialivalgumist. Suure ja keskmise hoidla maapealsed mahutid peavad olema ümbritsetud piirdega, mis takistab piirde sisse jäävatest mahutitest väljavoolava naftasaaduse, põlevkiviõli, selle saaduse või biokütuse laialivalgumist. 2 (2) Üksiku hoidla või ühise kaitsevalliga ümbritsetud mitme hoidla piirde sisse jääv ala peab mahutama naftasaadusi, põlevkiviõli, selle saadusi või biokütust 1,1 korda suuremas mahus kui on suurima hoidla projektijärgne maht. See ala peab olema betoneeritud või kaetud vett, naftasaadusi, põlevkiviõli, selle saadusi või biokütust mitteläbilaskva inertse materjaliga. Üksiku hoidla või ühise kaitsevalliga ümbritsetud mitme hoidla piirde sisse jääv ala peab mahutama naftasaadusi, põlevkiviõli, selle saadusi või biokütust 1,1 korda suuremas mahus kui on suurima hoidla projektijärgne maht. See ala peab olema betoneeritud või kaetud vett, naftasaadusi, põlevkiviõli, selle saadusi või biokütust mitteläbilaskva inertse materjaliga. 3 (3) Juhul kui käesoleva paragrahvi lõikes 1 nimetatud piirde rajamine ei ole võimalik, tuleb rajada reservmahuti, mis täitub isevoolu teel ja mille maht on võrdne hoidla suurima mahuti projektijärgse mahuga. Juhul kui käesoleva paragrahvi lõikes 1 nimetatud piirde rajamine ei ole võimalik, tuleb rajada reservmahuti, mis täitub isevoolu teel ja mille maht on võrdne hoidla suurima mahuti projektijärgse mahuga. 4 (4) Käesoleva paragrahvi nõudeid ei kohaldata bituumenihoidlale, kuid ehitusprojektis tuleb ette näha naftabituumeni kogumise abinõud avarii korral. Käesoleva paragrahvi nõudeid ei kohaldata bituumenihoidlale, kuid ehitusprojektis tuleb ette näha naftabituumeni kogumise abinõud avarii korral.",
      "rdfs:label": {
        "@value": "Reg_1047712_Par_4 (redaktsioon 1047712)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047712",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047712",
      "estleg:sourceAct": "Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded",
      "estleg:provisionRef": "Reg_1047712 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047712_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047712_Par_5_v1047712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047712_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Suure ja keskmise hoidla peale-, maha-, ümberlaadimis- või tankimiskoht peab olema ümbritsetud aiaga ja olema betoneeritud või kaetud vett ja naftasaadusi, põlevkiviõli, selle saadusi või biokütust mitteläbilaskva inertse materjaliga. Suure ja keskmise hoidla peale-, maha-, ümberlaadimis- või tankimiskoht peab olema ümbritsetud aiaga ja olema betoneeritud või kaetud vett ja naftasaadusi, põlevkiviõli, selle saadusi või biokütust mitteläbilaskva inertse materjaliga. 2 (2) Suure ja keskmise hoidla maa-alused mahutid ja torustikud peavad olema varustatud lekete avastamise kontrollseadmetega. Suure ja keskmise hoidla maa-alused mahutid ja torustikud peavad olema varustatud lekete avastamise kontrollseadmetega. 3 (3) Hoidla maa-alune mahuti mahuga alates 1000 m³ peab olema kahekordse seinaga. Hoidla maa-alune mahuti mahuga alates 1000 m³ peab olema kahekordse seinaga.",
      "rdfs:label": {
        "@value": "Reg_1047712_Par_5 (redaktsioon 1047712)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047712",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047712",
      "estleg:sourceAct": "Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded",
      "estleg:provisionRef": "Reg_1047712 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047712_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047712_Par_6_v1047712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047712_Par_6"
