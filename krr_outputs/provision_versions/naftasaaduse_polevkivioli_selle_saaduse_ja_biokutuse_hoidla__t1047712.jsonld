      }
    },
    {
      "@id": "estleg:Reg_1047712_Par_9_v1047712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047712_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hoidla lekke korral peab hoidla valdaja või käitaja kohe asuma saastatuse levikut tõkestama ning keskkonnaohtlikust lekkest teatama Häirekeskusele, hoidla asukohajärgsele kohalikule omavalitsusüksusele ja Keskkonnaametile. RT I 2020-12-18 2 118122020002 2021-01-01 Hoidla lekke korral peab hoidla valdaja või käitaja kohe asuma saastatuse levikut tõkestama ning keskkonnaohtlikust lekkest teatama Häirekeskusele, hoidla asukohajärgsele kohalikule omavalitsusüksusele ja Keskkonnaametile. 2 (2) Juhul kui valdaja ei ole hoidla omanik, tuleb valdajal viivitamata teatada hoidla lekkest ka selle omanikule. Juhul kui valdaja ei ole hoidla omanik, tuleb valdajal viivitamata teatada hoidla lekkest ka selle omanikule. 3 (3) Hoidla juures peab olema võimaliku saastuse piiramiseks vajalikus koguses absorbenti. Hoidla juures peab olema võimaliku saastuse piiramiseks vajalikus koguses absorbenti.",
      "rdfs:label": {
        "@value": "Reg_1047712_Par_9 (redaktsioon 1047712)",
        "@language": "et"
      },
