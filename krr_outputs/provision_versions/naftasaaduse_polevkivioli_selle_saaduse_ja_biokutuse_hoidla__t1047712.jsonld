  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_naftasaaduse_polevkivioli_selle_saaduse_ja_biokutuse_hoidla__t1047712_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded (14 versiooni)",
        "@language": "et"
      },
      "dc:source": "Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded"
    },
    {
      "@id": "estleg:Reg_1047712_Par_1_v1047712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047712_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse naftasaaduse, põlevkiviõli, selle saaduse või biokütuse hoidla (edaspidi hoidla) ehitamise ja kasutamise nõuded, et kaitsta inimese tervist, vältida vee saastumist või selle ohtu. RT I 2024-06-14 1 114062024001 2024-07-01 Määrusega kehtestatakse naftasaaduse, põlevkiviõli, selle saaduse või biokütuse hoidla (edaspidi hoidla) ehitamise ja kasutamise nõuded, et kaitsta inimese tervist, vältida vee saastumist või selle ohtu. 2 (2) Määrust ei kohaldata üldkasutatavatele autokütusetanklatele, kemikaali hoiu-, peale-, maha- ja ümberlaadimiskohtadele ning teistele kemikaali käitlemiseks vajalikele ehitistele sadamas, autoterminalis, raudteejaamas ja lennujaamas. Määrust ei kohaldata üldkasutatavatele autokütusetanklatele, kemikaali hoiu-, peale-, maha- ja ümberlaadimiskohtadele ning teistele kemikaali käitlemiseks vajalikele ehitistele sadamas, autoterminalis, raudteejaamas ja lennujaamas.",
      "rdfs:label": {
        "@value": "Reg_1047712_Par_1 (redaktsioon 1047712)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047712",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047712",
      "estleg:sourceAct": "Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded",
      "estleg:provisionRef": "Reg_1047712 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047712_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047712_Par_10_v1047712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047712_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sellise hoidla valdajal, mille mahutite maht on üle 100 m³, peab olema veekaitse eesmärkidel avarii likvideerimise kava, mis peab sisaldama: 1 1) hoidla asukohaplaani ning veekogude ja põhjavee kaitstuse kirjeldust; 2 2) saastatuse leviku võimalikke suundi; 3 3) saastatuse levikut tõkestavate abinõude kirjeldust, sealhulgas saastatuse leviku tõkestamise ja saastatuse ohutuks muutmise peamiste tehniliste võtete ülevaadet; 4 4) teavet saastatuse tõkestamise ja ohutuks muutmisega tegelevate isikute kohta. Sellise hoidla valdajal, mille mahutite maht on üle 100 m³, peab olema veekaitse eesmärkidel avarii likvideerimise kava, mis peab sisaldama: hoidla asukohaplaani ning veekogude ja põhjavee kaitstuse kirjeldust; saastatuse leviku võimalikke suundi; saastatuse levikut tõkestavate abinõude kirjeldust, sealhulgas saastatuse leviku tõkestamise ja saastatuse ohutuks muutmise peamiste tehniliste võtete ülevaadet; teavet saastatuse tõkestamise ja ohutuks muutmisega tegelevate isikute kohta. 2 (2) Avarii likvideerimise kava tuleb ajakohastada vähemalt iga kolme aasta tagant ja pärast saastatuse põhjustanud vahejuhtumit. Avarii likvideerimise kava tuleb ajakohastada vähemalt iga kolme aasta tagant ja pärast saastatuse põhjustanud vahejuhtumit. 3 (3) Avarii likvideerimise ja likvideerimisabinõude ajakohastatud kava tuleb enne selle kasutuselevõttu kooskõlastada Keskkonnaametiga. Avarii likvideerimise ja likvideerimisabinõude ajakohastatud kava tuleb enne selle kasutuselevõttu kooskõlastada Keskkonnaametiga.",
      "rdfs:label": {
        "@value": "Reg_1047712_Par_10 (redaktsioon 1047712)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047712",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047712",
      "estleg:sourceAct": "Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded",
      "estleg:provisionRef": "Reg_1047712 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047712_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047712_Par_11_v1047712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047712_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Üle 100 m³ mahuga hoidla käitaja peab pidama hoolduspäevikut, mis peab sisaldama vähemalt: 1 1) teavet hoidla kohta tehtud Keskkonnaameti ja tehnilise kontrolli ettekirjutustest ning nende täitmisest; RT I 2020-12-18 2 118122020002 2021-01-01 2 2) teavet hoidlas oleva naftasaaduse, põlevkiviõli, selle saaduse või biokütuse koguse kohta; 3 3) teavet hoidla hooldusseadmete ja igapäevaste hooldustööde kohta. Üle 100 m³ mahuga hoidla käitaja peab pidama hoolduspäevikut, mis peab sisaldama vähemalt: teavet hoidla kohta tehtud Keskkonnaameti ja tehnilise kontrolli ettekirjutustest ning nende täitmisest; teavet hoidlas oleva naftasaaduse, põlevkiviõli, selle saaduse või biokütuse koguse kohta; teavet hoidla hooldusseadmete ja igapäevaste hooldustööde kohta.",
      "rdfs:label": {
        "@value": "Reg_1047712_Par_11 (redaktsioon 1047712)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047712",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047712",
      "estleg:sourceAct": "Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded",
      "estleg:provisionRef": "Reg_1047712 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047712_Map"
      }
    },
