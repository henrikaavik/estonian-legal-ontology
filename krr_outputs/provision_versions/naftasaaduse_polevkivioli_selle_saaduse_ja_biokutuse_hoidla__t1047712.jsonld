      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse 2. ja 3. peatükki rakendatakse põlevkiviõli, selle saaduse või biokütuse hoidmisehitiste suhtes, mis on rajatud alates 1. septembrist 2013. Käesoleva määruse 2. ja 3. peatükki rakendatakse põlevkiviõli, selle saaduse või biokütuse hoidmisehitiste suhtes, mis on rajatud alates 1. septembrist 2013.",
      "rdfs:label": {
        "@value": "Reg_1047712_Par_13 (redaktsioon 1047712)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047712",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047712",
      "estleg:sourceAct": "Naftasaaduse, põlevkiviõli, selle saaduse ja biokütuse hoidla planeerimise, ehitamise ja kasutamise nõuded",
      "estleg:provisionRef": "Reg_1047712 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047712_Map"
      }
    },
