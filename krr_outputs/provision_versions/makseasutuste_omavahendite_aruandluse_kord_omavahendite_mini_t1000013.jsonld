      "dc:source": "Makseasutuste omavahendite aruandluse kord, omavahendite minimaalsuuruse arvutamise põhimõtted ning aruannete skeemid, aruannete koostamise metoodika ja esitamise kord"
    },
    {
      "@id": "estleg:Reg_1000013_Par_1_v1000013",
      "@type": [
        "owl:NamedIndividual",
