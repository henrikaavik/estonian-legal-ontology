      "estleg:versionValidFrom": {
        "@value": "2023-01-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus sätestab makseasutuste omavahendite aruandluse täpsema korra, omavahendite minimaalsuuruse arvutamise põhimõtted ja Finantsinspektsioonile esitatavate makseasutuse aruannete skeemid, aruannete koostamise metoodika ja esitamise korra. RT I 2018-01-26 2 126012018002 2018-01-31 Käesolev määrus sätestab makseasutuste omavahendite aruandluse täpsema korra, omavahendite minimaalsuuruse arvutamise põhimõtted ja Finantsinspektsioonile esitatavate makseasutuse aruannete skeemid, aruannete koostamise metoodika ja esitamise korra.",
      "rdfs:label": {
        "@value": "Reg_1000013_Par_1 (redaktsioon 1000013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000013",
