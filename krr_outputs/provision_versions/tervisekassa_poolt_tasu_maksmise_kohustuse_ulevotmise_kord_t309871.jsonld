    },
    {
      "@id": "estleg:Reg_309871_Par_23_v309871",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309871_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu – RT I 2013-02-26 1 126022013001 2013-03-01 11 Kehtetu – 2 (2) Juhul kui üks tervishoiuteenuse osutaja ostab laboriuuringu teiselt tervishoiuteenuse osutajalt, arvestab laboriuuringu teinud tervishoiuteenuse osutaja analüüsi võtmiseks vajalike tarvikute maksumuse teenuse müügihinnast maha. Juhul kui üks tervishoiuteenuse osutaja ostab laboriuuringu teiselt tervishoiuteenuse osutajalt, arvestab laboriuuringu teinud tervishoiuteenuse osutaja analüüsi võtmiseks vajalike tarvikute maksumuse teenuse müügihinnast maha.",
      "rdfs:label": {
