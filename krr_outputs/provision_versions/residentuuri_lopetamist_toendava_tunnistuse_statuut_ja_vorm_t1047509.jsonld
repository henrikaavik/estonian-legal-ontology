      },
      "estleg:versionText": "Määrus jõustub 1. septembril 2019. a. Määrus jõustub 1. septembril 2019. a.",
      "rdfs:label": {
        "@value": "Reg_1047509_Par_10 (redaktsioon 1047509)",
