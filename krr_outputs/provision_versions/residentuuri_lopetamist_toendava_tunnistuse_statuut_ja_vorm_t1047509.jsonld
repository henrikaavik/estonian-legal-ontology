      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Residentuuri lõpetamist tõendava tunnistuse statuut ja vorm (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Residentuuri lõpetamist tõendava tunnistuse statuut ja vorm"
    },
    {
      "@id": "estleg:Reg_1047509_Par_1_v1047509",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047509_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse residentuuri lõpetamist tõendava tunnistuse, sh akadeemilise õiendi, ja duplikaatide vormistamise ja väljaandmise kord (statuut) ning residentuuri lõpetamist tõendava tunnistuse vorm. Määrusega kehtestatakse residentuuri lõpetamist tõendava tunnistuse, sh akadeemilise õiendi, ja duplikaatide vormistamise ja väljaandmise kord (statuut) ning residentuuri lõpetamist tõendava tunnistuse vorm. 2 (2) Käesolevas määruses nimetatud akadeemilise õiendi ja duplikaatide vormistamisel ja väljaandmisel kohaldatakse kõrgharidusseaduse § 19 lõike 4 alusel kehtestatud haridus- ja teadusministri määrust, arvestades käesolevas määruses sätestatud erisusi. Käesolevas määruses nimetatud akadeemilise õiendi ja duplikaatide vormistamisel ja väljaandmisel kohaldatakse kõrgharidusseaduse § 19 lõike 4 alusel kehtestatud haridus- ja teadusministri määrust, arvestades käesolevas määruses sätestatud erisusi.",
      "rdfs:label": {
        "@value": "Reg_1047509_Par_1 (redaktsioon 1047509)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047509",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047509",
      "estleg:sourceAct": "Residentuuri lõpetamist tõendava tunnistuse statuut ja vorm",
      "estleg:provisionRef": "Reg_1047509 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047509_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047509_Par_10_v1047509",
      "@type": [
