      }
    },
    {
      "@id": "estleg:Reg_1000909_Par_4_6_v1000909",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000909_Par_4_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui tuuleelektrijaama valdaja on tuuleenergiast elektrienergia tootmise tasuga seotud andmed esitanud enne 2026. aasta 1. jaanuari, sisestab maismaal paikneva tuuleelektrijaama kõrguse keskkonnaotsuste infosüsteemi Keskkonnaamet, täiendades tuuleelektrijaama andmeid. Kui tuuleelektrijaama valdaja on tuuleenergiast elektrienergia tootmise tasuga seotud andmed esitanud enne 2026. aasta 1. jaanuari, sisestab maismaal paikneva tuuleelektrijaama kõrguse keskkonnaotsuste infosüsteemi Keskkonnaamet, täiendades tuuleelektrijaama andmeid. 2 (2) Juhul kui tuuleelektrijaamal puudub kasutusluba, aga see on sünkroniseeritud võrguga enne 2026. aasta 1. jaanuari, esitab tuuleelektrijaama valdaja tuuleelektrijaama võrguga sünkroniseerimise kuupäeva keskkonnaotsuste infosüsteemi hiljemalt 2026. aasta 30. juuniks. RT I 2025-10-21 6 121102025006 2026-01-01 Juhul kui tuuleelektrijaamal puudub kasutusluba, aga see on sünkroniseeritud võrguga enne 2026. aasta 1. jaanuari, esitab tuuleelektrijaama valdaja tuuleelektrijaama võrguga sünkroniseerimise kuupäeva keskkonnaotsuste infosüsteemi hiljemalt 2026. aasta 30. juuniks.",
      "rdfs:label": {
