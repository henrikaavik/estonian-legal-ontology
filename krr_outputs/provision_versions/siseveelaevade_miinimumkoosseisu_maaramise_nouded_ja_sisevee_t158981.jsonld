      "dc:source": "Siseveelaevade miinimumkoosseisu määramise nõuded ja siseveelaeva ohutu mehitatuse tunnistusele kantavate andmete loetelu"
    },
    {
      "@id": "estleg:Reg_158981_Par_1_v158981",
      "@type": [
