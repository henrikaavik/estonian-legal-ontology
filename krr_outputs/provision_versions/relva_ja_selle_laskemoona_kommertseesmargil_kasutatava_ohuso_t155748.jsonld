        "@value": "Sätete redaktsioonid: Relva ja selle laskemoona kommertseesmärgil kasutatava õhusõiduki reisijatesalongi kaasavõtmise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Relva ja selle laskemoona kommertseesmärgil kasutatava õhusõiduki reisijatesalongi kaasavõtmise kord"
    },
