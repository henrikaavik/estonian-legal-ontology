    },
    {
      "@id": "estleg:Reg_155748_Par_2_v155748",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155748_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Määrust kohaldatakse Eesti lennutegevusluba omava lennuettevõtja käitatava õhusõiduki kommertslennule, samuti muule kommertslennule, mille lähtekoht või sihtkoht või maandumiskoht on Eestis.RTL2010585132701472010-02-01+02:00 Määrust kohaldatakse Eesti lennutegevusluba omava lennuettevõtja käitatava õhusõiduki kommertslennule, samuti muule kommertslennule, mille lähtekoht või sihtkoht või maandumiskoht on Eestis. 2(2)Käesolevat määrust ei kohaldata lennundusseaduse §-s 541 nimetatud isiku suhtes.RTL2010585132701472010-02-01+02:00 Käesolevat määrust ei kohaldata lennundusseaduse §-s 541 nimetatud isiku suhtes.",
      "rdfs:label": {
        "@value": "Reg_155748_Par_2 (redaktsioon 155748)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155748",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155748",
      "estleg:sourceAct": "Relva ja selle laskemoona kommertseesmärgil kasutatava õhusõiduki reisijatesalongi kaasavõtmise kord",
      "estleg:provisionRef": "Reg_155748 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155748_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155748_Par_3_v155748",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155748_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Relva ja selle laskemoona võib kommertslennule reisijatesalongi kaasa võtta ainult erandjuhtumil Politsei- ja Piirivalveameti, Kaitsepolitseiameti või Kaitseministeeriumi algatusel, kui see on möödapääsmatult vajalik nimetatud asutuse seadusest tuleneva funktsiooni täitmiseks.RTL2010585132701472010-02-01+02:00 Relva ja selle laskemoona võib kommertslennule reisijatesalongi kaasa võtta ainult erandjuhtumil Politsei- ja Piirivalveameti, Kaitsepolitseiameti või Kaitseministeeriumi algatusel, kui see on möödapääsmatult vajalik nimetatud asutuse seadusest tuleneva funktsiooni täitmiseks.",
      "rdfs:label": {
        "@value": "Reg_155748_Par_3 (redaktsioon 155748)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155748",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155748",
      "estleg:sourceAct": "Relva ja selle laskemoona kommertseesmärgil kasutatava õhusõiduki reisijatesalongi kaasavõtmise kord",
      "estleg:provisionRef": "Reg_155748 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155748_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155748_Par_4_v155748",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155748_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Relva ja laskemoona kaasavõtmise kooskõlastab paragrahvis 3 nimetatud asutus:11)siseriikliku lennu puhul Lennuametiga, asjaomase lennuettevõtjaga ja asjaomaste lennuväljade valdajatega;22)rahvusvahelise lennu puhul lisaks punktis 1 nimetatud institutsioonidele ka asjaomase välisriigi pädeva ametkonnaga. Relva ja laskemoona kaasavõtmise kooskõlastab paragrahvis 3 nimetatud asutus: siseriikliku lennu puhul Lennuametiga, asjaomase lennuettevõtjaga ja asjaomaste lennuväljade valdajatega; rahvusvahelise lennu puhul lisaks punktis 1 nimetatud institutsioonidele ka asjaomase välisriigi pädeva ametkonnaga. 2(2)Lennuamet on kooskõlastuse andmisel kohustatud juhinduma lennuohutuse ja lennundusjulgestuse tagamise vajadusest. Lennuamet on kooskõlastuse andmisel kohustatud juhinduma lennuohutuse ja lennundusjulgestuse tagamise vajadusest. 3(3)Lennuettevõtja tagab asjaomast lendu teenindava õhusõiduki kapteni teavitamise relva kandvast isikust ja tema istekohast. Lennuettevõtja tagab asjaomast lendu teenindava õhusõiduki kapteni teavitamise relva kandvast isikust ja tema istekohast.",
      "rdfs:label": {
        "@value": "Reg_155748_Par_4 (redaktsioon 155748)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155748",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155748",
      "estleg:sourceAct": "Relva ja selle laskemoona kommertseesmärgil kasutatava õhusõiduki reisijatesalongi kaasavõtmise kord",
      "estleg:provisionRef": "Reg_155748 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155748_Map_2026"
      }
    },
