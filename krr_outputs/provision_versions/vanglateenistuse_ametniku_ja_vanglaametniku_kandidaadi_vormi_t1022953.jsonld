      "dc:source": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord"
    },
    {
      "@id": "estleg:Reg_1022953_Par_1_v1022953",
      "@type": [
