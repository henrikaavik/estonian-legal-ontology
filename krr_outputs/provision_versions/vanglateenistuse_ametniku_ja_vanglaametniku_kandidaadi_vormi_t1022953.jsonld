      "estleg:provisionRef": "Reg_1022953 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_2_v1022953",
