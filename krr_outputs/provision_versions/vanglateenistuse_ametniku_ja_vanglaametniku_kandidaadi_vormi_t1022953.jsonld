    {
      "@id": "estleg:Reg_1022953_Par_47_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vorminööbid on kollasest metallist ja vanglateenistuse vapilõvi kujutisega. Suure vorminööbi läbimõõt on 20 mm, väikese vorminööbi läbimõõt on 14 mm (lisa 6). Vorminööbid on kollasest metallist ja vanglateenistuse vapilõvi kujutisega. Suure vorminööbi läbimõõt on 20 mm, väikese vorminööbi läbimõõt on 14 mm (lisa 6).",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_47 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 47",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_48_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sõna VANGLATEENISTUS on tikitud või trükitud tasapinnaliselt kollaste suurtähtedega. Sõna kasutatakse vormiriietuse esemetel käesolevas määruses sätestatud korras. RT I 2016-01-22 1 122012016001 2016-01-25 Sõna VANGLATEENISTUS on tikitud või trükitud tasapinnaliselt kollaste suurtähtedega. Sõna kasutatakse vormiriietuse esemetel käesolevas määruses sätestatud korras. 2 (2) Tavavormi jopi, vihmamantli, eriotstarbelise jaki, vesti ja T-särgi seljaosal on sõna kõrgus 29 mm ja laius 230 mm. Tavavormi jopi, vihmamantli, eriotstarbelise jaki, vesti ja T-särgi seljaosal on sõna kõrgus 29 mm ja laius 230 mm. 3 (3) Ohutusvesti rinnaosal, eriotstarbelise T-särgi rinnaosal ning tavavormi peakatetel on sõna kõrgus 12,5 mm ja laius 100 mm. Ohutusvesti rinnaosal, eriotstarbelise T-särgi rinnaosal ning tavavormi peakatetel on sõna kõrgus 12,5 mm ja laius 100 mm. 4 (4) Relvastatud üksus kasutab sõna VANGLATEENISTUS kaitsevesti rinnaembleemil ja seljaembleemil. Rinnaembleemil on sõna kõrgus 18 mm ja laius 90 mm. Seljaembleemil on sõna kõrgus 38 mm ja laius 195 mm. Relvastatud üksus kasutab sõna VANGLATEENISTUS kaitsevesti rinnaembleemil ja seljaembleemil. Rinnaembleemil on sõna kõrgus 18 mm ja laius 90 mm. Seljaembleemil on sõna kõrgus 38 mm ja laius 195 mm. 5 (5) Sõna VANGLATEENISTUS võib kasutada ka muudel vanglateenistuse enesekaitsevahenditel, mida kantakse koos vormiriietusega. Sõna VANGLATEENISTUS võib kasutada ka muudel vanglateenistuse enesekaitsevahenditel, mida kantakse koos vormiriietusega.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_48 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 48",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_49_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Funktsiooniembleem on vormiriietusel kantav embleem, mis näitab vanglateenistuse ametniku teenistusvaldkonda. Funktsiooniembleem kinnitatakse vormiriietuse vasaku käise välisküljele, kui käesolevas määruses ei ole sätestatud teisiti. RT I 2022-10-12 1 112102022001 2022-10-15 Funktsiooniembleem on vormiriietusel kantav embleem, mis näitab vanglateenistuse ametniku teenistusvaldkonda. Funktsiooniembleem kinnitatakse vormiriietuse vasaku käise välisküljele, kui käesolevas määruses ei ole sätestatud teisiti. 2 (2) Relvastatud üksuse riietusel kantav relvastatud üksuse funktsiooniembleem on musta põhja ja kollase (Pantone 116 C) äärisega kilp, millel ristatud mõõkade taustal on kollane püstine otsa vaatav lõvi, esikäppade vahel väike riigivapp. Lõvil on punane keel ja kaks valget kihva. Kilbil lõvi taga on kaks ristatud mõõka, mõõgaotsad suunatud alla. Mõõgad on kollased, mõõkade käepidemed ja mõõgaotsad ulatuvad üle kilbi külgmiste servade. Funktsiooniembleem võib olla ka rohelist värvi (lisa 7). RT I 2022-10-12 1 112102022001 2022-10-15 Relvastatud üksuse riietusel kantav relvastatud üksuse funktsiooniembleem on musta põhja ja kollase (Pantone 116 C) äärisega kilp, millel ristatud mõõkade taustal on kollane püstine otsa vaatav lõvi, esikäppade vahel väike riigivapp. Lõvil on punane keel ja kaks valget kihva. Kilbil lõvi taga on kaks ristatud mõõka, mõõgaotsad suunatud alla. Mõõgad on kollased, mõõkade käepidemed ja mõõgaotsad ulatuvad üle kilbi külgmiste servade. Funktsiooniembleem võib olla ka rohelist värvi (lisa 7). 3 (3) Relvastatud üksuse suure funktsiooniembleemi kõrgus on 103 mm ja laius 92 mm ning väikese funktsiooniembleemi kõrgus on 50 mm ja laius 45 mm. Relvastatud üksuse suure funktsiooniembleemi kõrgus on 103 mm ja laius 92 mm ning väikese funktsiooniembleemi kõrgus on 50 mm ja laius 45 mm.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_49 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 49",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_5_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jopp on lühikese lõikega, eest tuuleliistuga lukk-kinnisega, püstise kraega ja taskutega. Jopi õlgadel on alus õlakute kinnitamiseks. Jopi vasakul käisel on käiseembleem. Parema rinnatasku kohal on alus nimesildi kinnitamiseks, vasaku rinna ülaosas on aas. Jopil on äravõetav kapuuts ja lisavooder. Jopi seljaosal on sõna VANGLATEENISTUS. Jopp on lühikese lõikega, eest tuuleliistuga lukk-kinnisega, püstise kraega ja taskutega. Jopi õlgadel on alus õlakute kinnitamiseks. Jopi vasakul käisel on käiseembleem. Parema rinnatasku kohal on alus nimesildi kinnitamiseks, vasaku rinna ülaosas on aas. Jopil on äravõetav kapuuts ja lisavooder. Jopi seljaosal on sõna VANGLATEENISTUS.",
      "rdfs:label": {
