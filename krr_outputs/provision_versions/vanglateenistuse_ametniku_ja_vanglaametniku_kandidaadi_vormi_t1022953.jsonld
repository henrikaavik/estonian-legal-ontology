    {
      "@id": "estleg:Reg_1022953_Par_39_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käiseilustus on tikitud riigivapi kujutis, üks või mitu laia kuldset värvi eralduspaela ning üks või mitu kitsast kuldset värvi eralduspaela. Käiseilustus on tikitud riigivapi kujutis, üks või mitu laia kuldset värvi eralduspaela ning üks või mitu kitsast kuldset värvi eralduspaela. 2 (2) Laia eralduspaela laius on 15 mm. Kitsa eralduspaela laius on 8 mm. Laia eralduspaela laius on 15 mm. Kitsa eralduspaela laius on 8 mm. 3 (3) Riigivapi kujutis on kuldse põhja peal kolm sinist lõvi, kujutist ümbritseb metallniidiga tikitud kuldne pärg. Riigivapi kujutis on kuldse põhja peal kolm sinist lõvi, kujutist ümbritseb metallniidiga tikitud kuldne pärg. 4 (4) Esimese eralduspaela kaugus õhtuvormi kuue käise otsast eralduspaela alumise ääreni on 70 mm. Paelte vahe on 5 mm. Esimese eralduspaela kaugus õhtuvormi kuue käise otsast eralduspaela alumise ääreni on 70 mm. Paelte vahe on 5 mm.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_39 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 39",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_4_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
