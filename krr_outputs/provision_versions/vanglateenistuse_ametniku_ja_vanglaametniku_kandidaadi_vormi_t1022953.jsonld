    {
      "@id": "estleg:Reg_1022953_Par_44_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tavavormi mütsimärk on niidiga tikitud vanglateenistuse vapp, mille kõrgus on 45 mm ja laius 35 mm. RT I 2016-01-22 1 122012016001 2016-01-25 Tavavormi mütsimärk on niidiga tikitud vanglateenistuse vapp, mille kõrgus on 45 mm ja laius 35 mm. 2 (2) Vangla peainspektori, vanglateenistuse juhi ja vanglateenistuse juhi asetäitja õhtuvormi mütsimärk on 40 mm kõrgune vanglateenistuse vapp, mida ümbritseb kollasest metallist stantsitud tammepärg. Vapi tipu all on kaks tammelehte ja külgedel kummalgi pool kolm lehepaari. Õhtuvormi mütsimärgi kõrgus on 60 mm ja laius 66 mm (lisa 5). Muu vanglateenistuse ametniku ja vanglaametniku kandidaadi õhtuvormi mütsimärk on vanglateenistuse vapp. RT I 2022-04-22 1 122042022001 2022-04-25 Vangla peainspektori, vanglateenistuse juhi ja vanglateenistuse juhi asetäitja õhtuvormi mütsimärk on 40 mm kõrgune vanglateenistuse vapp, mida ümbritseb kollasest metallist stantsitud tammepärg. Vapi tipu all on kaks tammelehte ja külgedel kummalgi pool kolm lehepaari. Õhtuvormi mütsimärgi kõrgus on 60 mm ja laius 66 mm (lisa 5). Muu vanglateenistuse ametniku ja vanglaametniku kandidaadi õhtuvormi mütsimärk on vanglateenistuse vapp.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_44 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
