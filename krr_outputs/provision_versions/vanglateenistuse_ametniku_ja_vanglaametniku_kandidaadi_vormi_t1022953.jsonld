      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Relvastatud üksuse tekstembleemil on sõnad „Relvastatud üksus”, „ESTONIAN PRISON SERVICE ARMED UNIT” ja relvastatud üksuse funktsiooniembleemi kujutis. Relvastatud üksuse tekstembleemil on sõnad „Relvastatud üksus”, „ESTONIAN PRISON SERVICE ARMED UNIT” ja relvastatud üksuse funktsiooniembleemi kujutis. 2 (2) Suure tekstembleemi kõrgus on 50 mm ja laius 283 mm. Väikese tekstembleemi kõrgus on 21 mm ja laius 120 mm (lisa 8). Suure tekstembleemi kõrgus on 50 mm ja laius 283 mm. Väikese tekstembleemi kõrgus on 21 mm ja laius 120 mm (lisa 8).",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_50 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 50",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_51_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
