      "estleg:provisionRef": "Reg_1022953 § 68_68",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_69_v1022953",
