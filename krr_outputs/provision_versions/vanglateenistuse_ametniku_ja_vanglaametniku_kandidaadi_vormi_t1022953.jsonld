    {
      "@id": "estleg:Reg_1022953_Par_13_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seelik on sirgelõikeline, voodriga, tõmblukk-kinnisega seljal ning kaetud sammulõhikuga. Seelik ulatub põlveõndlani. Seelik on sirgelõikeline, voodriga, tõmblukk-kinnisega seljal ning kaetud sammulõhikuga. Seelik ulatub põlveõndlani.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_13 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_14_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sviiter on kootud, pikkade käistega, sirgelõikeline, kolmnurkse kaelusega, ühe rinnataskuga ja õlakutega. Sviitri õlgadel ja küünarnukkidel on riidest tugevdusdetailid. Sviitri vasakul käisel on käiseembleem. Paremal rinnal on alus nimesildi kinnitamiseks. Vasakul rinnal on klapi ja pliiatsitaskuga pealeõmmeldud riidest rinnatasku ja selle kohal riidest aas. Sviiter on kootud, pikkade käistega, sirgelõikeline, kolmnurkse kaelusega, ühe rinnataskuga ja õlakutega. Sviitri õlgadel ja küünarnukkidel on riidest tugevdusdetailid. Sviitri vasakul käisel on käiseembleem. Paremal rinnal on alus nimesildi kinnitamiseks. Vasakul rinnal on klapi ja pliiatsitaskuga pealeõmmeldud riidest rinnatasku ja selle kohal riidest aas.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_14 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_15_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tavavormi jakk on üherealine, klassikalise lühikese lõikega, pikkade käistega, eest nööbitav, rinnataskutega ning õlakutega. Tavavormi jaki vasakul käisel on käiseembleem, käiste läbilõikel on hall kant. Parema rinnatasku kohal on alus nimesildi kinnitamiseks. Tavavormi jaki revääril on ametiastmele vastavad kraeilustused. Tavavormi jaki esikinnisel on neli suurt vorminööpi, käiste mansettidel kaks väikest vorminööpi ning rinnataskutel, õlakukatetel ja jaki seljaosa allääre kaunistusdetailidel üks väike vorminööp. RT I 2016-01-22 1 122012016001 2016-01-25 Tavavormi jakk on üherealine, klassikalise lühikese lõikega, pikkade käistega, eest nööbitav, rinnataskutega ning õlakutega. Tavavormi jaki vasakul käisel on käiseembleem, käiste läbilõikel on hall kant. Parema rinnatasku kohal on alus nimesildi kinnitamiseks. Tavavormi jaki revääril on ametiastmele vastavad kraeilustused. Tavavormi jaki esikinnisel on neli suurt vorminööpi, käiste mansettidel kaks väikest vorminööpi ning rinnataskutel, õlakukatetel ja jaki seljaosa allääre kaunistusdetailidel üks väike vorminööp.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_15 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_16_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhtuvormi esemed on: 1 1) vormimüts; 2 2) vormikübar; 3 3) poolmantel; 4 4) kuub; 5 5) püksid; 6 6) seelik; 7 7) särk; 8 8) vest; 9 9) kaelasidemed; 10 10) nahkkindad; 11 11) sall; 12 12) kingad. Õhtuvormi esemed on: vormimüts; vormikübar; poolmantel; kuub; püksid; seelik; särk; vest; kaelasidemed; nahkkindad; sall; kingad.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_16 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_17_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õhtuvormi vormimüts on poolvillasest riidest, ümmarguse põhjaga, eest püstja ja tagant langeva pehme äärega ning samast materjalist rummuga, lakknahast noka ja tormirihmaga. Tormirihm on kinnitatud kahe väikese vorminööbiga. Rummu ümber on 28 mm laiune tammelehtede kujutisega kaunistatud mustast läikivast riidest kant. Vormimütsi nokal kantakse ametiastmele või ametikohale vastavat mütsiilustust ja esiosal mütsimärki. Vangla peainspektori vormimütsil on lakknahast tormirihma asemel kuldsest metallniidist punutud nöör. Õhtuvormi vormimüts on poolvillasest riidest, ümmarguse põhjaga, eest püstja ja tagant langeva pehme äärega ning samast materjalist rummuga, lakknahast noka ja tormirihmaga. Tormirihm on kinnitatud kahe väikese vorminööbiga. Rummu ümber on 28 mm laiune tammelehtede kujutisega kaunistatud mustast läikivast riidest kant. Vormimütsi nokal kantakse ametiastmele või ametikohale vastavat mütsiilustust ja esiosal mütsimärki. Vangla peainspektori vormimütsil on lakknahast tormirihma asemel kuldsest metallniidist punutud nöör. 2 (2) Õhtuvormi vormikübar on vildist, eest tõstetud servaga. Rummu ümber on 28 mm laiune tammelehtede kujutisega kaunistatud mustast läikivast riidest kant. Vangla peainspektori vormikübaral on põhja ümber kuldsest metallniidist punutud nöör. Kübara esiosal kantakse mütsimärki. Õhtuvormi vormikübar on vildist, eest tõstetud servaga. Rummu ümber on 28 mm laiune tammelehtede kujutisega kaunistatud mustast läikivast riidest kant. Vangla peainspektori vormikübaral on põhja ümber kuldsest metallniidist punutud nöör. Kübara esiosal kantakse mütsimärki.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_17 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_18_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Poolmantel on villasest riidest, üherealine, eest nööbitav ja kaetud esiliistuga, avatud nurkkraega, sirgelõikeline, sissetöödeldud klapptaskutega ja õlakutega. Ülemine väljapaistev nööp on suur vorminööp, käisel on reas neli väikest vorminööpi. Poolmantli vasakul käisel on käiseembleem. Poolmantel on villasest riidest, üherealine, eest nööbitav ja kaetud esiliistuga, avatud nurkkraega, sirgelõikeline, sissetöödeldud klapptaskutega ja õlakutega. Ülemine väljapaistev nööp on suur vorminööp, käisel on reas neli väikest vorminööpi. Poolmantli vasakul käisel on käiseembleem. 2 (2) Kraerevääril kantakse ametiastmele või ametikohale vastavaid kraeilustusi. Kraerevääril kantakse ametiastmele või ametikohale vastavaid kraeilustusi.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_18 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_19_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õhtuvormi kuub on lühike, frakilõikeline, esindusõlakutega ja ühe rinnataskuga (spenser). Õhtuvormi kuue mõlemal hõlmal on diagonaalselt kolm suurt vorminööpi. Kuue hõlmasid hoiavad koos kaks suurt vorminööpi, mis on omavahel ühendatud kuldset värvi ketiga. Käiseotstel on mansett kahe väikese vorminööbiga. Õhtuvormi kuub on lühike, frakilõikeline, esindusõlakutega ja ühe rinnataskuga (spenser). Õhtuvormi kuue mõlemal hõlmal on diagonaalselt kolm suurt vorminööpi. Kuue hõlmasid hoiavad koos kaks suurt vorminööpi, mis on omavahel ühendatud kuldset värvi ketiga. Käiseotstel on mansett kahe väikese vorminööbiga. 2 (2) Õhtuvormi kuuel kantakse ametiastmele või ametikohale vastavaid esindusõlakuid, kuue käistel käiseilustusi ja kraerevääril kraeilustusi. Õhtuvormi kuuel kantakse ametiastmele või ametikohale vastavaid esindusõlakuid, kuue käistel käiseilustusi ja kraerevääril kraeilustusi.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_19 (redaktsioon 1022953)",
        "@language": "et"
      },
