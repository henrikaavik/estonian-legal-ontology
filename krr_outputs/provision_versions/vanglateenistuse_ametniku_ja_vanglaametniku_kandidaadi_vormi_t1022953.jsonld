      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Püksirihm on mustast nahast ja 35 mm lai. Rihmal on ühe keelega hõbedane metallpannal, millel on vanglateenistuse vapp kõrgusega 13 mm ja laiusega 10 mm. Püksirihm on mustast nahast ja 35 mm lai. Rihmal on ühe keelega hõbedane metallpannal, millel on vanglateenistuse vapp kõrgusega 13 mm ja laiusega 10 mm.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_11 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_12_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
