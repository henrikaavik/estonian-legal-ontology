    {
      "@id": "estleg:Reg_1022953_Par_10_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kingad on kinnised, musta värvi, madala või kuni 40 mm kõrguse kontsaga. RT I 2022-03-18 3 118032022003 2022-03-21 Kingad on kinnised, musta värvi, madala või kuni 40 mm kõrguse kontsaga. 2 (2) Sandaalid on musta värvi, tagant kinnised ja kinnise või väikeseaugulise ninaga. RT I 2022-03-18 3 118032022003 2022-03-21 Sandaalid on musta värvi, tagant kinnised ja kinnise või väikeseaugulise ninaga. 3 (3) Saapad on musta värvi, paksu tallaga, madala või kuni 40 mm kõrguse kontsaga. Saapa siseküljel on lukk-kinnis või eesosas nöörkinnis. RT I 2022-03-18 3 118032022003 2022-03-21 Saapad on musta värvi, paksu tallaga, madala või kuni 40 mm kõrguse kontsaga. Saapa siseküljel on lukk-kinnis või eesosas nöörkinnis.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_10 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 10",
