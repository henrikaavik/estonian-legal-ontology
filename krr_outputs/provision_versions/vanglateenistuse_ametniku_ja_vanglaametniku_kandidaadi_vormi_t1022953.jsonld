      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tavavormi esemed on: 1 1) jopp; 2 2) püksid; 3 3) talvemüts; 4 4) nokkmüts; 5 5) vormisärk; 6 6) polosärk; 7 7) lips; 8 8) lipsunõel; 9 9) kingad; 10 10) sandaalid; 11 11) saapad; RT I 2022-03-18 3 118032022003 2022-03-21 12 12) püksirihm; 13 13) sõrmkindad; 14 14) seelik; 15 15) sviiter; 16 16) jakk. Tavavormi esemed on: jopp; püksid; talvemüts; nokkmüts; vormisärk; polosärk; lips; lipsunõel; kingad; sandaalid; saapad; püksirihm; sõrmkindad; seelik; sviiter; jakk.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_4 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_40_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kraeilustus (lisa 2) on kuldse metallniidiga 80 × 35 mm alusele tikitud horisontaalasendis olev mõõk, mille ümber on põimunud tammelehed, 52 × 27 mm alusele tikitud kahest tammelehest koosnev ilustus või 50 × 20 mm alusele tikitud ühest tammelehest koosnev ilustus. Kraeilustus (lisa 2) on kuldse metallniidiga 80 × 35 mm alusele tikitud horisontaalasendis olev mõõk, mille ümber on põimunud tammelehed, 52 × 27 mm alusele tikitud kahest tammelehest koosnev ilustus või 50 × 20 mm alusele tikitud ühest tammelehest koosnev ilustus.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_40 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 40",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_41_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mütsiilustused on kahes reas või ühes reas asetsevad kuldsed tammelehed (lisa 3). Mütsiilustused on kahes reas või ühes reas asetsevad kuldsed tammelehed (lisa 3).",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_41 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 41",
