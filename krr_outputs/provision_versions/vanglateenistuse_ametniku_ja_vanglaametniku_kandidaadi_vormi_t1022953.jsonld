    {
      "@id": "estleg:Reg_1022953_Par_42_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vanglateenistuse vapi kilp on must ja hõbedase (Pantone 877 C) äärisega. Kilbil on kujutatud vanglateenistuse vapilõvi (lisa 4). RT I 2016-01-22 1 122012016001 2016-01-25 Vanglateenistuse vapi kilp on must ja hõbedase (Pantone 877 C) äärisega. Kilbil on kujutatud vanglateenistuse vapilõvi (lisa 4). 2 (2) Vanglateenistuse vapilõvi on kollane (Pantone 116 C) püstine otsa vaatav lõvi, kellel on punane keel, kaks valget kihva ja kelle esikäppade vahel on väike riigivapp. RT I 2016-01-22 1 122012016001 2016-01-25 Vanglateenistuse vapilõvi on kollane (Pantone 116 C) püstine otsa vaatav lõvi, kellel on punane keel, kaks valget kihva ja kelle esikäppade vahel on väike riigivapp.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_42 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 42",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_43_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käiseembleem on kootud ja sellel on kujutatud vanglateenistuse vappi. Käiseembleemi kõrgus on 100 mm ja laius 80 mm, hõbedase ääre laius on 8 mm. RT I 2016-01-22 1 122012016001 2016-01-25 Käiseembleem on kootud ja sellel on kujutatud vanglateenistuse vappi. Käiseembleemi kõrgus on 100 mm ja laius 80 mm, hõbedase ääre laius on 8 mm. 2 (2) Käiseembleem kinnitatakse vasaku käise välisküljele. Pikkade käistega esemel kinnitatakse käiseembleem 60 mm õlaõmblusest allapoole, lühikeste käistega esemel 40 mm õlaõmblusest allapoole. Käiseembleem kinnitatakse vasaku käise välisküljele. Pikkade käistega esemel kinnitatakse käiseembleem 60 mm õlaõmblusest allapoole, lühikeste käistega esemel 40 mm õlaõmblusest allapoole.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_43 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
