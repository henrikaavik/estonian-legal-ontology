    {
      "@id": "estleg:Reg_1022953_Par_62_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_62"
