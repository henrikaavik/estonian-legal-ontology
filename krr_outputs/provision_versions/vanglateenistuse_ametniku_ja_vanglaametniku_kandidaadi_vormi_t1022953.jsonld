    {
      "@id": "estleg:Reg_1022953_Par_45_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nimesilt on must, sildil on kollase niidiga tikitud ääristus. Nimesildi kõrgus on 30 mm ja laius 90 mm. Vanglateenistuse ametniku või vanglaametniku kandidaadi ees- ja perekonnanimi on nimesildile tikitud kahes reas ja suurtähtedega. Tähe kõrgus on 10 mm ja tekst on keskjoondatud. Nimesilti kantakse nimesildi alusele kinnitatuna vormielemendi paremal pool. RT I 2016-01-22 1 122012016001 2016-01-25 Nimesilt on must, sildil on kollase niidiga tikitud ääristus. Nimesildi kõrgus on 30 mm ja laius 90 mm. Vanglateenistuse ametniku või vanglaametniku kandidaadi ees- ja perekonnanimi on nimesildile tikitud kahes reas ja suurtähtedega. Tähe kõrgus on 10 mm ja tekst on keskjoondatud. Nimesilti kantakse nimesildi alusele kinnitatuna vormielemendi paremal pool. 2 (2) Relvastatud üksuse nimesilt on must või roheline. Sildil on relvastatud üksuse liikme perekonnanimi ja seda kantakse vormi jakil, fliisjakil või jopil. RT I 2022-10-12 1 112102022001 2022-10-15 Relvastatud üksuse nimesilt on must või roheline. Sildil on relvastatud üksuse liikme perekonnanimi ja seda kantakse vormi jakil, fliisjakil või jopil. 3 (3) Nimesilti kantakse ka vanglateenistuse enesekaitsevahendil, kui enesekaitsevahend varjab ära vormiriietusel oleva nimesildi. Nimesilti kantakse ka vanglateenistuse enesekaitsevahendil, kui enesekaitsevahend varjab ära vormiriietusel oleva nimesildi.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_45 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 45",
