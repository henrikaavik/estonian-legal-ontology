      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Esindusõlakud on kolmenööripunutis, kahenööripunutis, ühenööripunutis ja nöörkandiga esindusõlak (lisa 1). Esindusõlakud on kolmenööripunutis, kahenööripunutis, ühenööripunutis ja nöörkandiga esindusõlak (lisa 1).",
      "rdfs:label": {
