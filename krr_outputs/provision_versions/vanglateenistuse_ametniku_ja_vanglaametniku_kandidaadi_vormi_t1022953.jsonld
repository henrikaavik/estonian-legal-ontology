    {
      "@id": "estleg:Reg_1022953_Par_46_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Identifitseerimissilt on must või roheline, sildil on relvastatud üksuse liikme identifitseerimisnumber. Suure identifitseerimissildi kõrgus on 130 mm ja laius 150 mm, väikese identifitseerimissildi kõrgus on 67 mm ja laius 75 mm. RT I 2022-10-12 1 112102022001 2022-10-15 Identifitseerimissilt on must või roheline, sildil on relvastatud üksuse liikme identifitseerimisnumber. Suure identifitseerimissildi kõrgus on 130 mm ja laius 150 mm, väikese identifitseerimissildi kõrgus on 67 mm ja laius 75 mm. 2 (2) Identifitseerimissilti kasutab relvastatud üksus. Identifitseerimissilti kantakse relvastatud üksuse riietusel või varustusel selleks ettenähtud kohal. Identifitseerimissilti kasutab relvastatud üksus. Identifitseerimissilti kantakse relvastatud üksuse riietusel või varustusel selleks ettenähtud kohal.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_46 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 46",
