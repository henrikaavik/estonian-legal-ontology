    {
      "@id": "estleg:Reg_1022953_Par_7_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nokkmüts koosneb mütsipõhjast ja -nokast. Mütsinokk on kaetud riidega. Nokkmütsi esiosa on tugevdatud jäigast riidest voodriga. Nokkmüts on reguleeritav vastavalt pea suurusele. Nokkmütsi esiosal on tavavormi mütsimärk ja paremale küljele on tikitud sõna VANGLATEENISTUS. Nokkmüts koosneb mütsipõhjast ja -nokast. Mütsinokk on kaetud riidega. Nokkmütsi esiosa on tugevdatud jäigast riidest voodriga. Nokkmüts on reguleeritav vastavalt pea suurusele. Nokkmütsi esiosal on tavavormi mütsimärk ja paremale küljele on tikitud sõna VANGLATEENISTUS. 2 (2) Kootud talvemüts on kahekordne ja pööratud äärega. Kootud talvemütsi esiosal on tavavormi mütsimärk ja paremale küljele on tikitud sõna VANGLATEENISTUS. Kootud talvemüts on kahekordne ja pööratud äärega. Kootud talvemütsi esiosal on tavavormi mütsimärk ja paremale küljele on tikitud sõna VANGLATEENISTUS.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_7 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_8_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022953_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vormisärk on halli või valget värvi, pikkade või lühikeste käistega, sirgelõikeline või kergelt taljes, eest nööbitav, kannaga kraega, klapiga rinnataskutega ja õlakutega. Vormisärgi vasakul käisel on käiseembleem ning parema rinnatasku kohal alus nimesildi kinnitamiseks. Vormisärgi vasakul rinnataskul on sissetöödeldud pliiatsitasku. Vasaku rinna ülaosas on aas. Vormisärk on halli või valget värvi, pikkade või lühikeste käistega, sirgelõikeline või kergelt taljes, eest nööbitav, kannaga kraega, klapiga rinnataskutega ja õlakutega. Vormisärgi vasakul käisel on käiseembleem ning parema rinnatasku kohal alus nimesildi kinnitamiseks. Vormisärgi vasakul rinnataskul on sissetöödeldud pliiatsitasku. Vasaku rinna ülaosas on aas. 2 (2) Polosärk on halli värvi, lühikeste käistega, osaliselt nööbitava esikinnisega, kraega ja sissetöödeldud pliiatsitaskuga rinnataskuga. Polosärgi vasakul hõlmal on sõna VANGLATEENISTUS. Polosärgi vasaku rinnatasku kohal on aas ja paremal rinnal alus nimesildi kinnitamiseks, rinnal on alus embleemi jaoks. Polosärgi vasakul varrukal on alus riigitunnuse ja varrukaembleemi jaoks. RT I 2024-12-17 1 117122024001 2025-01-01 Polosärk on halli värvi, lühikeste käistega, osaliselt nööbitava esikinnisega, kraega ja sissetöödeldud pliiatsitaskuga rinnataskuga. Polosärgi vasakul hõlmal on sõna VANGLATEENISTUS. Polosärgi vasaku rinnatasku kohal on aas ja paremal rinnal alus nimesildi kinnitamiseks, rinnal on alus embleemi jaoks. Polosärgi vasakul varrukal on alus riigitunnuse ja varrukaembleemi jaoks.",
      "rdfs:label": {
        "@value": "Reg_1022953_Par_8 (redaktsioon 1022953)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022953",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022953",
      "estleg:sourceAct": "Vanglateenistuse ametniku ja vanglaametniku kandidaadi vormiriietuse ja eraldusmärkide kirjeldus ning nende kandmise kord",
      "estleg:provisionRef": "Reg_1022953 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022953_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022953_Par_9_v1022953",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
