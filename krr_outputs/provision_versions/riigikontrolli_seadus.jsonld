      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolli teenistujad on: avaliku teenistuse seaduse kohaselt ametisse nimetatud ametnikud; töölepingu alusel töötavad Riigikontrolli teenistujad, kes täidavad Riigikontrolli siseseid abistavaid funktsioone riigikontrolöri kindlaksmääratud ametikohtadel.",
      "rdfs:label": {
        "@value": "RKS_Par_30 (redaktsioon 27763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27763",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKS_Par_30_v129122012012"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27763",
      "estleg:sourceAct": "Riigikontrolli seadus",
      "estleg:provisionRef": "RKS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:RKS_Map"
      }
    },
    {
      "@id": "estleg:RKS_Par_30_v129122012012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
