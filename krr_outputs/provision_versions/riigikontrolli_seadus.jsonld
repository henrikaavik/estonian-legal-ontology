    },
    {
      "@id": "estleg:RKS_Par_28_v27763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikontrolli struktuuriüksused on auditiosakonnad ja teenistused. (2) Auditiosakonnad on Riigikontrolli põhitegevusega tegelevad struktuuriüksused. (3) Teenistused on auditiosakondi abistavaid ülesandeid täitvad struktuuriüksused.",
      "rdfs:label": {
        "@value": "RKS_Par_28 (redaktsioon 27763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27763",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27763",
      "estleg:sourceAct": "Riigikontrolli seadus",
      "estleg:provisionRef": "RKS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:RKS_Map"
      }
    },
    {
      "@id": "estleg:RKS_Par_29_v27763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Peakontrolör on Riigikontrolli auditiosakonna juhataja, kelle riigikontrolör nimetab ametisse tähtajatult. (2) Peakontrolör: juhib auditiosakonda; määrab Riigikontrolli tööplaanis ettenähtud kontrollimist teostavad ametnikud; väljastab kontrollimiseks vajaliku teabe kogumiseks menetlusteate; tagab kontrollimiste läbiviimise kooskõlas seaduste ja muude õigusaktidega; kirjutab alla kontrolliaruandele; esindab Riigikontrolli riigikontrolöri määratud pädevuse piires; täidab muid seadusest tulenevaid või riigikontrolöri antud ülesandeid.",
      "rdfs:label": {
        "@value": "RKS_Par_29 (redaktsioon 27763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27763",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27763",
      "estleg:sourceAct": "Riigikontrolli seadus",
      "estleg:provisionRef": "RKS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:RKS_Map"
      }
    },
    {
      "@id": "estleg:RKS_Par_3_v27763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolli tegevuse eesmärk on majanduskontrolli kaudu anda Riigikogule ja avalikkusele kindlustunne, et avaliku sektori vahendeid kasutatakse seaduslikult ning tulemuslikult.",
      "rdfs:label": {
        "@value": "RKS_Par_3 (redaktsioon 27763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27763",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27763",
      "estleg:sourceAct": "Riigikontrolli seadus",
      "estleg:provisionRef": "RKS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:RKS_Map"
      }
    },
    {
      "@id": "estleg:RKS_Par_30_v27763",
