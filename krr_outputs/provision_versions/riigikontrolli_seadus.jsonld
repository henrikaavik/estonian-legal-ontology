    {
      "@id": "estleg:RKS_Par_21_v112112010004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolöri volitused loetakse lõppenuks: käesoleva seaduse §-s 17 nimetatud viieaastase tähtaja möödumise päevast; tema ametist tagasiastumise avalduse rahuldamise päevast; tema kestva võimetuse korral üle kuue kuu järjest täita oma ametiülesandeid – Riigikohtu üldkogu otsuse jõustumise päevast; tahtlikult toimepandud kuriteo eest süüdimõistva kohtuotsuse jõustumise päevast; ettevaatamatuse tõttu toimepandud kuriteo eest süüdimõistva kohtuotsuse jõustumise päevast, kui selle kohtuotsusega on määratud vabaduskaotuslik karistus; tema surma korral.",
      "rdfs:label": {
