      }
    },
    {
      "@id": "estleg:RKS_Par_22_v27763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametist tagasiastumiseks esitab riigikontrolör kirjaliku avalduse Vabariigi Presidendile, kes teeb Riigikogule ettepaneku riigikontrolör ametist vabastada.",
      "rdfs:label": {
        "@value": "RKS_Par_22 (redaktsioon 27763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27763",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKS_Par_22_v263084"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27763",
      "estleg:sourceAct": "Riigikontrolli seadus",
      "estleg:provisionRef": "RKS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:RKS_Map"
      }
    },
    {
      "@id": "estleg:RKS_Par_22_v263084",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametist tagasiastumiseks esitab riigikontrolör kirjaliku avalduse Vabariigi Presidendile, kes teeb Riigikogule ettepaneku riigikontrolör ametist vabastada. Ametist tagasiastumisest teatab riigikontrolör Vabariigi Presidendile vähemalt neli kuud ette.",
      "rdfs:label": {
        "@value": "RKS_Par_22 (redaktsioon 263084)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "263084",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/263084",
      "estleg:sourceAct": "Riigikontrolli seadus",
      "estleg:provisionRef": "RKS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:RKS_Map"
      }
    },
    {
      "@id": "estleg:RKS_Par_23_v27763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui riigikontrolör on haiguse tõttu või muul põhjusel kuus kuud järjest kestvalt võimetu täitma oma ametiülesandeid, esitab Vabariigi President Riigikohtule põhjendatud taotluse tunnistada seda oma otsusega. (2) Riigikohtu üldkogu vaatab taotluse läbi ja teeb otsuse viivitamata. (3) Riigikohtu üldkogu otsus, millega riigikontrolör tunnistatakse kestvalt võimetuks täitma oma ametiülesandeid, jõustub väljakuulutamise päeval. (4) Jõustunud Riigikohtu üldkogu otsus vabastab riigikontrolöri ametist.",
      "rdfs:label": {
        "@value": "RKS_Par_23 (redaktsioon 27763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27763",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27763",
      "estleg:sourceAct": "Riigikontrolli seadus",
      "estleg:provisionRef": "RKS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:RKS_Map"
      }
    },
    {
      "@id": "estleg:RKS_Par_24_v27763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikontrolöri saab kriminaalvastutusele võtta ainult õiguskantsleri ettepanekul Riigikogu koosseisu enamuse nõusolekul. (2) Riigikontrolöri volitused peatuvad alates päevast, mil Riigikogu teeb otsuse anda nõusolek riigikontrolöri kriminaalvastutusele võtmiseks. (3) Riigikontrolöri volitused taastuvad: õigeksmõistva kohtuotsuse jõustumise päevast; ettevaatamatuse tõttu toimepandud kuriteo eest süüdimõistva kohtuotsuse jõustumise päevast juhul, kui määratud karistuseks ei olnud vabaduskaotus; tema kriminaalasjas kriminaalmenetluse lõpetamise päevast. (4) Riigikontrolör on ametist tagandatud: tahtlikult toimepandud kuriteo eest süüdimõistva kohtuotsuse jõustumise päevast; ettevaatamatuse tõttu toimepandud kuriteo eest süüdimõistva kohtuotsuse jõustumise päevast, kui selle kohtuotsusega on määratud vabaduskaotuslik karistus. (5) Riigikontrolöri kriminaalvastutusele võtmise kord on sätestatud Riigikogu liikme, riigikontrolöri, õiguskantsleri, Riigikohtu esimehe ja Riigikohtu liikme kriminaalvastutusele võtmise korra seaduses (RT I 1995, 83, 1440; 1998, 41/42, 625).",
      "rdfs:label": {
        "@value": "RKS_Par_24 (redaktsioon 27763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27763",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKS_Par_24_v12906946"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27763",
      "estleg:sourceAct": "Riigikontrolli seadus",
      "estleg:provisionRef": "RKS § 24",
      "estleg:partOfAct": {
        "@id": "estleg:RKS_Map"
      }
    },
