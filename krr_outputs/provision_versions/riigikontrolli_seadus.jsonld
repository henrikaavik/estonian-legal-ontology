    },
    {
      "@id": "estleg:RKS_Par_27_v128122017017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikontrolöri ametipalk määratakse kõrgemate riigiteenijate ametipalkade seadusega. (jõustumine muudetud RT I, 29.12.2011, 1) (2) Kehtetu - (3) Kehtetu - (4) Kehtetu - (4¹) Kehtetu - (4²) Kehtetu - (4³) Kehtetu - (5) Kehtetu - (6) Kehtetu - (6¹) Kehtetu - (7) Kehtetu - (7¹) Riigikontrolörile makstakse iga kuu 20 protsenti ametipalgast esinduskuludeks. (8) Riigikontrolöril, kelle volitused on lõppenud käesoleva seaduse § 21 punkti 1 ja haiguse tõttu punkti 3 alusel, on õigus hüvitisele kuue kuu ametipalga määra ulatuses.",
      "rdfs:label": {
        "@value": "RKS_Par_27 (redaktsioon 128122017017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017017",
