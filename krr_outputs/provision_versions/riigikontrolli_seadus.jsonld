      }
    },
    {
      "@id": "estleg:RKS_Par_31_v129122012012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolli ametnikele, samuti riigikontrolörile kohaldatakse avaliku teenistuse seadust käesolevas seaduses sätestatud erisustega.",
      "rdfs:label": {
        "@value": "RKS_Par_31 (redaktsioon 129122012012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122012012",
