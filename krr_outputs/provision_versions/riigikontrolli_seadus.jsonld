      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrollis töötavad ametnikud ja töötajad. Töötajad võetakse tööle töölepinguga.",
      "rdfs:label": {
        "@value": "RKS_Par_30 (redaktsioon 129122012012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122012012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129122012012",
