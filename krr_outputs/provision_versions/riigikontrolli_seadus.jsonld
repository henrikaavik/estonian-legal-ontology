      "estleg:provisionRef": "RKS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:RKS_Map"
      }
    },
    {
      "@id": "estleg:RKS_Par_30_1_v129122012012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKS_Par_30_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolli ametnik on avaliku teenistuse seaduse kohaselt ametisse nimetatud isik, kellel on akadeemiline kõrgharidus.",
      "rdfs:label": {
