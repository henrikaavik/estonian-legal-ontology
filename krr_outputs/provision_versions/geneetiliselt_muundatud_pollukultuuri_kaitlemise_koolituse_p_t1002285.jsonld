  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_geneetiliselt_muundatud_pollukultuuri_kaitlemise_koolituse_p_t1002285_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Geneetiliselt muundatud põllukultuuri käitlemise koolituse programm, tunnistuse saamiseks esitatavad nõuded, tunnistuse andmise kord ning täienduskoolituse sagedus (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Geneetiliselt muundatud põllukultuuri käitlemise koolituse programm, tunnistuse saamiseks esitatavad nõuded, tunnistuse andmise kord ning täienduskoolituse sagedus"
    },
    {
      "@id": "estleg:Reg_1002285_Par_1_v1002285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002285_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolitusasutus korraldab geneetiliselt muundatud põllukultuuri käitlemise koolitust (edaspidi koolitus) „Täiskasvanute koolituse seaduse” ja selle määruse nõuete kohaselt. Koolitusasutus korraldab geneetiliselt muundatud põllukultuuri käitlemise koolitust (edaspidi koolitus) „Täiskasvanute koolituse seaduse” ja selle määruse nõuete kohaselt. 2 (2) Koolitusasutus koostab enne koolituse korraldamist koolituse programmi alusel käsitletavate teemade täpsustatud loetelu koos teemasid ette kandvate lektorite nimekirjaga ning esitab selle Põllumajandus- ja Toiduametile seisukoha saamiseks. RT I 2020-11-04 1 104112020001 2021-01-01 Koolitusasutus koostab enne koolituse korraldamist koolituse programmi alusel käsitletavate teemade täpsustatud loetelu koos teemasid ette kandvate lektorite nimekirjaga ning esitab selle Põllumajandus- ja Toiduametile seisukoha saamiseks. 3 (3) Koolitusasutus teavitab kirjalikult Põllumajandus- ja Toiduametit enne koolituse korraldamist selle toimumise ajast. RT I 2020-11-04 1 104112020001 2021-01-01 Koolitusasutus teavitab kirjalikult Põllumajandus- ja Toiduametit enne koolituse korraldamist selle toimumise ajast. 4 (4) Põllumajandus- ja Toiduamet avaldab oma veebilehel teabe koolituse toimumise aja kohta. RT I 2020-11-04 1 104112020001 2021-01-01 Põllumajandus- ja Toiduamet avaldab oma veebilehel teabe koolituse toimumise aja kohta.",
      "rdfs:label": {
        "@value": "Reg_1002285_Par_1 (redaktsioon 1002285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002285",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002285",
      "estleg:sourceAct": "Geneetiliselt muundatud põllukultuuri käitlemise koolituse programm, tunnistuse saamiseks esitatavad nõuded, tunnistuse andmise kord ning täienduskoolituse sagedus",
      "estleg:provisionRef": "Reg_1002285 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002285_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1002285_Par_2_v1002285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002285_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolituse kestus on vähemalt kaheksa arvestuslikku õppetundi. Koolituse kestus on vähemalt kaheksa arvestuslikku õppetundi. 2 (2) Koolituse programm sisaldab järgmisi teemasid: 1 1) ülevaade geneetiliselt muundatud põllukultuuride bioloogiast; 2 2) geneetiliselt muundatud põllukultuuride levik Eestis, Euroopa Liidus ja mujal maailmas; 3 3) uue geneetiliselt muundatud põllukultuuri või geneetiliselt muundatud põllukultuuri uue liini kasvatamiseks turustamisloa menetlemine; 4 4) ülevaade kasvatamiseks ja turustamiseks lubatud geneetiliselt muundatud põllukultuuridest; 5 5) geneetiliselt muundatud põllukultuuri sisalduse kontrollimine geneetiliselt muundamata põllukultuuri saagis; 6 6) geneetiliselt muundatud põllukultuuri sisalduse piirmäär geneetiliselt muundamata põllukultuuri saagis ja selle sisalduse kontrollimine; 7 7) ülevaade geneetiliselt muundatud organismidega seotud õigusaktidest; 8 8) geneetiliselt muundatud põllukultuuri käitlemisega alustamise nõuded; 9 9) geneetiliselt muundatud põllukultuuri levikutee ja meetmed levikutee piiramiseks; 10 10) geneetiliselt muundatud põllukultuuri kasvatamise nõuded; 11 11) geneetiliselt muundatud põllukultuuri kasvatusvahemaa nõuded, sealhulgas kokkuleppe sõlmimine kasvatusvahemaa nõudest kõrvale kaldumiseks; 12 12) geneetiliselt muundatud põllukultuuri käitlemisel kasutatud seadme puhastamise nõuded; 13 13) geneetiliselt muundatud põllukultuuri veo ja ladustamise nõuded; 14 14) kasvatusvahemaa piiresse jääva põllu valdaja ja mesilaomaniku teavitamine; 15 15) geneetiliselt muundatud põllukultuuri käitleja vastutus; 16 16) geneetiliselt muundatud põllukultuuri käitlemisega seonduvad võimalikud riskid ja kasud; 17 17) turustamisotstarbelise geneetiliselt muundatud põllukultuuri märgistamise nõuded. Koolituse programm sisaldab järgmisi teemasid: ülevaade geneetiliselt muundatud põllukultuuride bioloogiast; geneetiliselt muundatud põllukultuuride levik Eestis, Euroopa Liidus ja mujal maailmas; uue geneetiliselt muundatud põllukultuuri või geneetiliselt muundatud põllukultuuri uue liini kasvatamiseks turustamisloa menetlemine; ülevaade kasvatamiseks ja turustamiseks lubatud geneetiliselt muundatud põllukultuuridest; geneetiliselt muundatud põllukultuuri sisalduse kontrollimine geneetiliselt muundamata põllukultuuri saagis; geneetiliselt muundatud põllukultuuri sisalduse piirmäär geneetiliselt muundamata põllukultuuri saagis ja selle sisalduse kontrollimine; ülevaade geneetiliselt muundatud organismidega seotud õigusaktidest; geneetiliselt muundatud põllukultuuri käitlemisega alustamise nõuded; geneetiliselt muundatud põllukultuuri levikutee ja meetmed levikutee piiramiseks; geneetiliselt muundatud põllukultuuri kasvatamise nõuded; geneetiliselt muundatud põllukultuuri kasvatusvahemaa nõuded, sealhulgas kokkuleppe sõlmimine kasvatusvahemaa nõudest kõrvale kaldumiseks; geneetiliselt muundatud põllukultuuri käitlemisel kasutatud seadme puhastamise nõuded; geneetiliselt muundatud põllukultuuri veo ja ladustamise nõuded; kasvatusvahemaa piiresse jääva põllu valdaja ja mesilaomaniku teavitamine; geneetiliselt muundatud põllukultuuri käitleja vastutus; geneetiliselt muundatud põllukultuuri käitlemisega seonduvad võimalikud riskid ja kasud; turustamisotstarbelise geneetiliselt muundatud põllukultuuri märgistamise nõuded.",
      "rdfs:label": {
        "@value": "Reg_1002285_Par_2 (redaktsioon 1002285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002285",
