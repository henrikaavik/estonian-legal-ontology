    },
    {
      "@id": "estleg:Reg_1002188_Par_27_v1002188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002188_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jaos avaldatakse järgmised teated: 1 1) täiendavast kaitsest loobumine (MA1Y); 2 2) täiendava kaitse annulleerimine (MC1Y); 3 3) täiendava kaitse kehtivuse ennetähtaegne lõppemine seoses riigilõivu tasumata jätmisega (MM1Y). Jaos avaldatakse järgmised teated: täiendavast kaitsest loobumine (MA1Y); täiendava kaitse annulleerimine (MC1Y); täiendava kaitse kehtivuse ennetähtaegne lõppemine seoses riigilõivu tasumata jätmisega (MM1Y). 2 (2) Täiendava kaitse kehtivuse lõppemise teates sisaldub: 1 1) lehe number, kus on avaldatud täiendava kaitse andmise teade; 2 2) täiendava kaitse tunnistuse number; 3 3) aluspatendi number; 4 4) täiendava kaitse kehtivuse ennetähtaegse lõppemise kuupäev; 5 5) teate liiki tähistav WIPO standardi ST. 17 kood. Täiendava kaitse kehtivuse lõppemise teates sisaldub: lehe number, kus on avaldatud täiendava kaitse andmise teade; täiendava kaitse tunnistuse number; aluspatendi number; täiendava kaitse kehtivuse ennetähtaegse lõppemise kuupäev; teate liiki tähistav WIPO standardi ST. 17 kood.",
      "rdfs:label": {
        "@value": "Reg_1002188_Par_27 (redaktsioon 1002188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002188",
      "estleg:sourceAct": "Eesti Patendilehe põhimäärus",
      "estleg:provisionRef": "Reg_1002188 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002188_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002188_Par_28_v1002188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002188_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jaos avaldatakse järgmised andmed: 1 1) lehe number, kus on avaldatud täiendava kaitse andmise teade; 2 2) täiendava kaitse tunnistuse number; 3 3) aluspatendi number; 4 4) tühistamise kuupäev; 5 5) viide täiendava kaitse määruse sättele, mille alusel täiendav kaitse tühistati. Jaos avaldatakse järgmised andmed: lehe number, kus on avaldatud täiendava kaitse andmise teade; täiendava kaitse tunnistuse number; aluspatendi number; tühistamise kuupäev; viide täiendava kaitse määruse sättele, mille alusel täiendav kaitse tühistati.",
      "rdfs:label": {
        "@value": "Reg_1002188_Par_28 (redaktsioon 1002188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002188",
      "estleg:sourceAct": "Eesti Patendilehe põhimäärus",
      "estleg:provisionRef": "Reg_1002188 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002188_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002188_Par_29_v1002188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002188_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osa koosneb järgmistest jagudest: 1 1) QZ4A/QZ1Y „Litsentside registreerimine”; 2 2) RC4A/RC1Y „Pandi registreerimine”. Osa koosneb järgmistest jagudest: QZ4A/QZ1Y „Litsentside registreerimine”; RC4A/RC1Y „Pandi registreerimine”.",
      "rdfs:label": {
        "@value": "Reg_1002188_Par_29 (redaktsioon 1002188)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002188",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002188",
      "estleg:sourceAct": "Eesti Patendilehe põhimäärus",
      "estleg:provisionRef": "Reg_1002188 § 29",
