      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Veterinaarravimi kliinilises uuringus ilmnenud kõrvalnähtudest teavitamine (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Veterinaarravimi kliinilises uuringus ilmnenud kõrvalnähtudest teavitamine"
    },
    {
      "@id": "estleg:Reg_1053368_Par_1_v1053368",
      "@type": [
        "owl:NamedIndividual",
