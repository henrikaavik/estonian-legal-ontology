      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 23. juuli 2020. a käskkirjaga nr 1-2/20/316 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 23. juuli 2020. a käskkirjaga nr 1-2/20/316 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1062255_Par_5 (redaktsioon 1062255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062255",
