      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Halinga põlispuude grupi, Kurgja kalmistu põlispuude, Kurgja kalmistu metsapargi, A. Kurmi selektsiooniaia ja Annemõisa pargi looduskaitse alt väljaarvamine Pärnu maakonnas (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Halinga põlispuude grupi, Kurgja kalmistu põlispuude, Kurgja kalmistu metsapargi, A. Kurmi selektsiooniaia ja Annemõisa pargi looduskaitse alt väljaarvamine Pärnu maakonnas"
    },
    {
      "@id": "estleg:Reg_1062255_Par_1_v1062255",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
