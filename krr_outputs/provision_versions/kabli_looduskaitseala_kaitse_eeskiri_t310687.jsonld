    },
    {
      "@id": "estleg:Reg_310687_Par_14_v310687",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_310687_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: 1 1) kaitseala või looduskeskuse tarbeks uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine; 2 2) roo varumine külmumata pinnasel. Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: kaitseala või looduskeskuse tarbeks uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine; roo varumine külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_310687_Par_14 (redaktsioon 310687)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "310687",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/310687",
      "estleg:sourceAct": "Kabli looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_310687 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_310687_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_310687_Par_15_v310687",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_310687_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) veekogude veetaseme muutmine ja uute veekogude rajamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) uuendusraie, välja arvatud turberaie kuni 0,1 ha suurusel langil ühe metsaeraldise piirides, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas; 5 5) biotsiidi ja taimekaitsevahendi kasutamine; 6 6) maavara kaevandamine. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; veekogude veetaseme muutmine ja uute veekogude rajamine; puhtpuistute kujundamine ja energiapuistute rajamine; uuendusraie, välja arvatud turberaie kuni 0,1 ha suurusel langil ühe metsaeraldise piirides, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas; biotsiidi ja taimekaitsevahendi kasutamine; maavara kaevandamine.",
      "rdfs:label": {
        "@value": "Reg_310687_Par_15 (redaktsioon 310687)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "310687",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/310687",
      "estleg:sourceAct": "Kabli looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_310687 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_310687_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_310687_Par_2_v310687",
      "@type": [
        "owl:NamedIndividual",
