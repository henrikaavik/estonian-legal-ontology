      "estleg:versionOf": {
        "@id": "estleg:Reg_310687_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on vajalik poollooduslike koosluste ilmet ja liigirikkust tagav tegevus nagu rohu niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ja harvendamine ulatuses, millega on tagatud niidukoosluste soodus seisund ja roostiku leviku takistamine niidualadel. Sihtkaitsevööndis on vajalik poollooduslike koosluste ilmet ja liigirikkust tagav tegevus nagu rohu niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ja harvendamine ulatuses, millega on tagatud niidukoosluste soodus seisund ja roostiku leviku takistamine niidualadel.",
      "rdfs:label": {
        "@value": "Reg_310687_Par_11 (redaktsioon 310687)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "310687",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/310687",
      "estleg:sourceAct": "Kabli looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_310687 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_310687_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_310687_Par_12_v310687",
