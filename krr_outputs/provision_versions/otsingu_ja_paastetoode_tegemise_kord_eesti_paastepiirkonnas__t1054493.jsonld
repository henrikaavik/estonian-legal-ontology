    {
      "@id": "estleg:Reg_1054493_Par_4_v1054493",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054493_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Otsingu- ja päästetöid juhib Politsei- ja Piirivalveamet. Otsingu- ja päästetöid juhib Politsei- ja Piirivalveamet. 2 (2) Rahvusvahelises suhtlemises on otsingu- ja päästetööde kontaktpunkt Politsei- ja Piirivalveameti lennu- ja merepääste koordinatsioonikeskus (edaspidi JRCC Tallinn). RT I 2024-03-13 2 113032024002 2024-03-16 Rahvusvahelises suhtlemises on otsingu- ja päästetööde kontaktpunkt Politsei- ja Piirivalveameti lennu- ja merepääste koordinatsioonikeskus (edaspidi JRCC Tallinn). 3 (3) JRCC Tallinnal on õigus otsingu- ja päästetööde käigus teha koostööd teiste pääste koordinatsioonikeskustega rahvusvahelise mereotsingute ja -pääste 1979. aasta konventsiooni lisa punktides 3.1.6 ja 3.1.7 sätestatud ulatuses. RT I 2024-03-13 2 113032024002 2024-03-16 JRCC Tallinnal on õigus otsingu- ja päästetööde käigus teha koostööd teiste pääste koordinatsioonikeskustega rahvusvahelise mereotsingute ja -pääste 1979. aasta konventsiooni lisa punktides 3.1.6 ja 3.1.7 sätestatud ulatuses.",
      "rdfs:label": {
        "@value": "Reg_1054493_Par_4 (redaktsioon 1054493)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054493",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054493",
      "estleg:sourceAct": "Otsingu- ja päästetööde tegemise kord Eesti päästepiirkonnas ning reostuse avastamise ja likvideerimise kord Eesti merealal ja piiriveekogudel",
      "estleg:provisionRef": "Reg_1054493 § 4",
