      }
    },
    {
      "@id": "estleg:Reg_1054493_Par_5_v1054493",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054493_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Otsingu- ja päästetööde juhtumi koordinaator on asjakohase väljaõppega JRCC Tallinna ametiisik, kes juhib otsingu- ja päästetöid Eesti päästepiirkonnas. RT I 2024-03-13 2 113032024002 2024-03-16 Otsingu- ja päästetööde juhtumi koordinaator on asjakohase väljaõppega JRCC Tallinna ametiisik, kes juhib otsingu- ja päästetöid Eesti päästepiirkonnas. 2 (2) Otsingu- ja päästetööde juhtumi koordinaator määrab vajaduse korral sündmuskoha koordinaatori või lennutegevuse koordinaatori. Otsingu- ja päästetööde juhtumi koordinaator määrab vajaduse korral sündmuskoha koordinaatori või lennutegevuse koordinaatori. 3 (3) Ohuolukorras allub otsingu- ja päästeüksus otsingu- ja päästetööde juhtumi koordinaatorile. Ohuolukorras allub otsingu- ja päästeüksus otsingu- ja päästetööde juhtumi koordinaatorile. 4 (4) Otsingu- ja päästetööde juhtumi koordinaatoril on õigus anda otsingu- ja päästetöödel korraldusi teisele riigi- või kohaliku omavalitsuse asutusele või selle üksusele ning füüsilisele või juriidilisele isikule, võttes arvesse asutuse või isiku oskusi ja volitusi. Otsingu- ja päästetööde juhtumi koordinaatoril on õigus anda otsingu- ja päästetöödel korraldusi teisele riigi- või kohaliku omavalitsuse asutusele või selle üksusele ning füüsilisele või juriidilisele isikule, võttes arvesse asutuse või isiku oskusi ja volitusi. 5 (5) Kui otsingu- ja päästetööde ning reostusjuhtum esinevad korraga, on esmatähtis päästa inimelusid ning juhtumit juhib JRCC Tallinn kuni otsingu- ja päästetööde lõppemiseni. Kui otsingu- ja päästetööde ning reostusjuhtum esinevad korraga, on esmatähtis päästa inimelusid ning juhtumit juhib JRCC Tallinn kuni otsingu- ja päästetööde lõppemiseni.",
      "rdfs:label": {
        "@value": "Reg_1054493_Par_5 (redaktsioon 1054493)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054493",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054493",
      "estleg:sourceAct": "Otsingu- ja päästetööde tegemise kord Eesti päästepiirkonnas ning reostuse avastamise ja likvideerimise kord Eesti merealal ja piiriveekogudel",
      "estleg:provisionRef": "Reg_1054493 § 5",
