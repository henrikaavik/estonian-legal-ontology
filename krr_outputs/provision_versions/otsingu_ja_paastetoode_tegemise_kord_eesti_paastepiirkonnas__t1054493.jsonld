        "@id": "estleg:Reg_1054493_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054493_Par_2_v1054493",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054493_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti päästepiirkond on välislepingutega kokkulepitud piirkond, kus Eesti on kohustatud tegema otsingu- ja päästetöid. Eesti päästepiirkond on välislepingutega kokkulepitud piirkond, kus Eesti on kohustatud tegema otsingu- ja päästetöid. 2 (2) Rahvusvahelises suhtlemises kasutatakse Eesti päästepiirkonna ingliskeelset nimetust ja lühendit: Estonian Search and Rescue Region – Estonian SRR. Rahvusvahelises suhtlemises kasutatakse Eesti päästepiirkonna ingliskeelset nimetust ja lühendit: Estonian Search and Rescue Region – Estonian SRR.",
      "rdfs:label": {
