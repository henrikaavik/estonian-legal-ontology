        "@id": "estleg:Reg_1029404_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029404_Par_27_v1029404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029404_Par_27"
      },
      "estleg:versionValidFrom": {
