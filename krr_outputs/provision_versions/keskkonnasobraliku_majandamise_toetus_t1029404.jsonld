      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA teeb toetuse maksmise otsuse või toetuse maksmisest keeldumise otsuse sellise tähtaja jooksul, et toetusraha oleks võimalik kanda toetuse saaja arvelduskontole kohustuseaastale järgneva kalendriaasta 30. juuniks. PRIA teeb toetuse maksmise otsuse või toetuse maksmisest keeldumise otsuse sellise tähtaja jooksul, et toetusraha oleks võimalik kanda toetuse saaja arvelduskontole kohustuseaastale järgneva kalendriaasta 30. juuniks.",
      "rdfs:label": {
        "@value": "Reg_1029404_Par_28 (redaktsioon 1029404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029404",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029404",
      "estleg:sourceAct": "Keskkonnasõbraliku majandamise toetus",
      "estleg:provisionRef": "Reg_1029404 § 28",
      "estleg:partOfAct": {
