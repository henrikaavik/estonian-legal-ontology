      }
    },
    {
      "@id": "estleg:KAITSE_Par_95_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_95"
      },
      "estleg:versionValidFrom": {
