    },
    {
      "@id": "estleg:KAITSE_Par_25_v834127",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_25"
      },
      "estleg:versionValidFrom": {
