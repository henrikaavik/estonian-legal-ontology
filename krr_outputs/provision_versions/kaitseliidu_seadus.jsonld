      }
    },
    {
      "@id": "estleg:KAITSE_Par_5_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidu kodukorras sätestatakse: Kaitseliidu täpsem ülesehitus, juhtimine ja sisemine korraldus; struktuuriüksuse juhtorganite moodustamine, juhtorgani ülesanded, juhtorgani liikmeks saamine ja liikme volituste kestus; liikmesuse saamise, peatamise ja lõppemise ning muude liikmesusega seotud toimingute tegemise kord; liikmemaksu tasumise ja revisjoni määramise kord. (2) Kaitseliidu kodukorra määrusega.",
      "rdfs:label": {
        "@value": "KAITSE_Par_5 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_5_v121062014051"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 5",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_5_v121062014051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidu kodukorras sätestatakse: Kaitseliidu täpsem ülesehitus, juhtimine ja sisemine korraldus; struktuuriüksuse juhtorganite moodustamine, juhtorgani ülesanded, juhtorgani liikmeks saamine ja liikme volituste kestus; liikmesuse saamise, peatamise ja lõppemise ning muude liikmesusega seotud toimingute tegemise kord; liikmemaksu tasumise ja revisjoni määramise kord. (2) Kaitseliidu kodukorra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KAITSE_Par_5 (redaktsioon 121062014051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014051",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014051",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 5",
      "estleg:partOfAct": {
