    {
      "@id": "estleg:KAITSE_Par_36_v25817",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseliitu finantseeritakse: riigieelarvest; sisseastumis- ja liikmemaksudest; kehtestatud korras sõlmitud lepingute alusel saadud vahenditest; annetustest ja sponsorlusest; eelarvevälistest sihtkapitalidest ja -fondidest ning muudest laekumistest; muudest seaduslikult saadud vahenditest.",
      "rdfs:label": {
        "@value": "KAITSE_Par_36 (redaktsioon 25817)",
        "@language": "et"
      },
