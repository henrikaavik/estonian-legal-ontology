      }
    },
    {
      "@id": "estleg:KAITSE_Par_40_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidu liikmele võib teenistuskohustuse täitmiseks anda erivahendi ja enesekaitsevahendi. (2) Erivahend käesoleva seaduse tähenduses on: käerauad; sidumisvahend; teenistuskoer; kumminui; teleskoopnui. (3) Kaitseliidu enesekaitsevahendite loetelu ja nõuded nendele määrusega. (4) Kaitseliidu erivahendit ja enesekaitsevahendit võib tegevliige hoida oma elukohas, kui see on vajalik teenistuskohustuse täitmiseks. (5) Kaitseliidu erivahendi ja enesekaitsevahendi hoiule andmise tingimused ning korra määrusega. (6) Kaitseliidu erivahendi ja enesekaitsevahendi kasutamise korra ja nende kasutamise koolituse nõuded kehtestab Kaitseliidu ülem.",
      "rdfs:label": {
        "@value": "KAITSE_Par_40 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_40_v121062014051"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
