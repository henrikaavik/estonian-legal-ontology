      }
    },
    {
      "@id": "estleg:KAITSE_Par_7_v12907082",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidul on üldlipp ja embleem. Oma lipu ja märkide õigus on ka maleval, malevkonnal ja nendega võrdsustatud üksustel. (2) Kaitseliidu üldlipu ja embleemi kirjelduse . Maleva ja malevast väiksema üksuse lipu kirjelduse ning nende märkide kirjelduse (3) Kaitseliidu vormiriietuse ja eraldusmärgid (ametikoha tunnused) , nende kandmise korra kehtestab kaitseväe juhataja või kaitseväe ülemjuhataja. (4) Kaitseliidul on oma teenetemärgid, mille kirjelduse ja statuudi . Maleva ja malevaga võrdsustatud üksuse teenetemärgi kirjelduse ja statuudi kinnitab Kaitseliidu keskjuhatus.",
      "rdfs:label": {
        "@value": "KAITSE_Par_7 (redaktsioon 12907082)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12907082",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_7_v108072011048"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12907082",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 7",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_7_v108072011048",
      "@type": [
        "owl:NamedIndividual",
