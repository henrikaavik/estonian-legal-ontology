    {
      "@id": "estleg:KAITSE_Par_12_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväe juhataja: kehtestab Kaitseliidu sõjalise võime ja valmisoleku nõuded; kehtestab Kaitseväe sõjaaja üksuste ja reservüksuste mobiliseerimise ja formeerimise tegevuskava ning sõjaaja üksuste ja reservüksuste koosseisu ja varustustabeli või annab volituse nende kehtestamiseks Kaitseliidu ülemale Kaitseliitu puudutavas osas; varustab koostöös Kaitseministeeriumiga Kaitseliitu käesoleva seaduse § 4 lõike 1 punktides 2–4 ja 7 sätestatud ülesannete täitmiseks relvade, lahingutehnika, vormiriietuse ja muu sõjalise varustusega; teeb kaitseministrile ettepaneku Kaitseliidu rahuaja ametikohtade loetelu kehtestamiseks; annab arvamuse Kaitseliidu arengukava kohta.",
      "rdfs:label": {
        "@value": "KAITSE_Par_12 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
