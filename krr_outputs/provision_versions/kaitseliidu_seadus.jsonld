    {
      "@id": "estleg:KAITSE_Par_20_v120122010002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseliitu kasutatakse kaitsejõudude koosseisus ilma sõjalise tegevuseta: hädaolukorra lahendamiseks, päästetöö tegemiseks ja turvalisuse tagamiseks – hädaolukorra seaduses sätestatud korras; erakorralise seisukorra ajal – erakorralise seisukorra seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "KAITSE_Par_20 (redaktsioon 120122010002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010002",
      "estleg:supersededByVersion": {
