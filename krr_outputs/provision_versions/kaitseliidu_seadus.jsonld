      }
    },
    {
      "@id": "estleg:KAITSE_Par_72_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valvuril on õigus tööülesande täitmisel kanda tuli-, külm- ja gaasirelva ning erivahendit ja enesekaitsevahendit. Tuli-, külm- ja gaasirelva käitlemine toimub relvaseaduses ja selle alusel antud õigusaktides sätestatud korras, kui käesolevas seaduses ei ole sätestatud teisiti. (2) Tulirelv käesoleva peatüki tähenduses on püstol, revolver, püss ja automaattulirelv. Tulirelvana võib kasutada ainult sõjaväerelva. (3) Külmrelv käesoleva peatüki tähenduses on kumminui ja teleskoopnui. (4) Gaasirelv käesoleva peatüki tähenduses on gaasipihusti. (5) Tulirelva kandmise õigus on vaid valvuril, kellel on Kaitseliidu relvaluba.",
      "rdfs:label": {
        "@value": "KAITSE_Par_72 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_72_v129062018061"
      },
      "estleg:versionValidTo": {
        "@value": "2018-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 72",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_72_v129062018061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
