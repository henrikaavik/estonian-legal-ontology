      },
      "estleg:versionValidTo": {
        "@value": "2004-12-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/25817",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 18",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_18_v834127",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeasutuse volitatud isiku taotlusel võib Kaitseliidu lähima üksuse pealik anda oma alluvatele hädaolukorras käsu osaleda päästetöödel, kandes sellest ette oma vahetule pealikule. (2) Päästetöödel osalemise ajal allub Kaitseliidu liige päästetööde juhile.",
      "rdfs:label": {
        "@value": "KAITSE_Par_18 (redaktsioon 834127)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "834127",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_18_v13299212"
      },
      "estleg:versionValidTo": {
        "@value": "2010-04-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/834127",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 18",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_18_v13299212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-04-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud –",
      "rdfs:label": {
        "@value": "KAITSE_Par_18 (redaktsioon 13299212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13299212",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_18_v120032013001"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13299212",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 18",
