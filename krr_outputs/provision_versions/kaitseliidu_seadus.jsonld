    },
    {
      "@id": "estleg:KAITSE_Par_10_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidus on sõjaväelise auastmega rahuaja ametikohad (edaspidi rahuaja ametikoht) Kaitseliidu ülema, peastaabi ülema ja malevapealiku ametikoht. (2) Kaitseliidus võib lisaks käesoleva paragrahvi lõikes 1 sätestatud ametikohtadele luua Kaitseliidu ülesannete täitmiseks muid rahuaja ametikohti. (3) Rahuaja ametikohtade arvu ülempiiri Kaitseliidus kehtestab Vabariigi Valitsus korraldusega. (4) Käesoleva paragrahvi lõike 3 alusel kehtestatud ülempiiri arvestades kehtestab kaitseminister Kaitseväe juhataja ettepanekul ja kooskõlastatult Kaitseliidu ülemaga Kaitseliidu rahuaja ametikohtade loetelu sõjaväeliste auastmete alaliikide kaupa. (5) Kaitseliidus olevale rahuaja ametikohale nimetab tegevväelase ja vabastab ametikohalt Kaitseliidu ülem.",
      "rdfs:label": {
        "@value": "KAITSE_Par_10 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_10_v121062014051"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 10",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_10_v121062014051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidus on sõjaväelise auastmega rahuaja ametikohad (edaspidi rahuaja ametikoht) Kaitseliidu ülema, peastaabi ülema ja malevapealiku ametikoht. (2) Kaitseliidus võib lisaks käesoleva paragrahvi lõikes 1 sätestatud ametikohtadele luua Kaitseliidu ülesannete täitmiseks muid rahuaja ametikohti. (3) Rahuaja ametikohtade arvu ülempiiri Kaitseliidus kehtestab Vabariigi Valitsus korraldusega. (4) Käesoleva paragrahvi lõike 3 alusel kehtestatud ülempiiri arvestades kehtestab valdkonna eest vastutav minister Kaitseväe juhataja ettepanekul ja kooskõlastatult Kaitseliidu ülemaga Kaitseliidu rahuaja ametikohtade loetelu sõjaväeliste auastmete alaliikide kaupa. (5) Kaitseliidus olevale rahuaja ametikohale nimetab tegevväelase ja vabastab ametikohalt Kaitseliidu ülem.",
      "rdfs:label": {
        "@value": "KAITSE_Par_10 (redaktsioon 121062014051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014051",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_10_v129062018062"
      },
      "estleg:versionValidTo": {
