      }
    },
    {
      "@id": "estleg:KAITSE_Par_9_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidu struktuuriüksused on peastaap, malevad, küberkaitseüksus, kool, Naiskodukaitse ning noorteorganisatsioonid Noored Kotkad ja Kodutütred. (2) Struktuuriüksuse juht allub vahetult Kaitseliidu ülemale. (3) Peastaap on Kaitseliidu ülema tegevust toetav struktuuriüksus. (4) Kaitseliidu malevad on Alutaguse, Harju, Jõgeva, Järva, Lääne, Põlva, Pärnumaa, Rapla, Saaremaa, Sakala, Tallinna, Tartu, Valgamaa, Viru ja Võrumaa malev.",
      "rdfs:label": {
        "@value": "KAITSE_Par_9 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_9_v129062018062"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 9",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_9_v129062018062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidu struktuuriüksused on peastaap, maakaitseringkonnad, malevad, küberkaitseüksus, kool, Naiskodukaitse ning noorteorganisatsioonid Noored Kotkad ja Kodutütred. (2) Struktuuriüksuste alluvus sätestatakse kodukorras. (3) Peastaap on Kaitseliidu ülema tegevust toetav struktuuriüksus. (4) Kaitseliidu malevad on Alutaguse, Harju, Jõgeva, Järva, Lääne, Põlva, Pärnumaa, Rapla, Saaremaa, Sakala, Tallinna, Tartu, Valgamaa, Viru ja Võrumaa malev.",
      "rdfs:label": {
