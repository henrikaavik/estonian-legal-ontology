      }
    },
    {
      "@id": "estleg:KAITSE_Par_9_v130042024003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidu struktuuriüksused on peastaap, maakaitseringkonnad, malevad, valveteenistus, kool, Naiskodukaitse ning noorteorganisatsioonid Noored Kotkad ja Kodutütred. (2) Struktuuriüksuste alluvus sätestatakse kodukorras. (3) Peastaap on Kaitseliidu ülema tegevust toetav struktuuriüksus. (4) Kaitseliidu malevad on küberkaitseüksus, Alutaguse, Harju, Jõgeva, Järva, Lääne, Põlva, Pärnumaa, Rapla, Saaremaa, Sakala, Tallinna, Tartu, Valgamaa, Viru ja Võrumaa malev.",
      "rdfs:label": {
        "@value": "KAITSE_Par_9 (redaktsioon 130042024003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130042024003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130042024003",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 9",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_90_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne käesoleva seaduse jõustumist Kaitseliidu või Kaitseliidu eriorganisatsiooni liikmeks olnud isik loetakse Kaitseliidu liikmeks vastavalt käesoleva seaduse §-s 23 sätestatule. (2) 17-aastane ja noorem Kaitseliidu liige peavad esitama Kaitseliidu liikmesuse jätkumiseks oma vanema või eestkostja kirjaliku nõusoleku 60 päeva jooksul käesoleva seaduse jõustumisest arvates. (3) Käesoleva paragrahvi lõikes 2 sätestatud nõusoleku esitamata jätmisel arvatakse noorliige Kaitseliidust välja. (4) Enne käesoleva seaduse jõustumist Kaitseliidu või eriorganisatsiooni liikmeks olnud 17-aastane ja noorem välisriigi kodanik ning kodakondsuseta isik arvatakse käesoleva seaduse jõustumisel Kaitseliidust välja.",
      "rdfs:label": {
        "@value": "KAITSE_Par_90 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 90",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_90_1_v106032014004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_90_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 90 lõike 4 alusel Kaitseliidust väljaarvamisele kuulunud Kaitseliidu eriorganisatsiooni liikmeks olnud isiku Kaitseliidu liikmesus loetakse noorliikmena noorteorganisatsioonis taastatuks alates 2013. aasta 1. aprillist.",
      "rdfs:label": {
        "@value": "KAITSE_Par_90_1 (redaktsioon 106032014004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106032014004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106032014004",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 90_1",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_91_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseliidu liige, kes on enne käesoleva seaduse jõustumist sooritanud relvaeksami, loetakse käesoleva seaduse jõustumisel Kaitseliidu relva käitlemise ja kasutamise koolituse läbinuks.",
      "rdfs:label": {
        "@value": "KAITSE_Par_91 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 91",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_92_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist Kaitseliidu tegevliikmele väljastatud dokument, mis tõendab tema õigust kanda selles märgitud relvi, loetakse käesoleva seaduse jõustumisel Kaitseliidu relvaloaks.",
      "rdfs:label": {
        "@value": "KAITSE_Par_92 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 92",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_93_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_93"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseliidu tegevliige, kellel on käesoleva seaduse jõustumisel Kaitseliidu relvaluba ja kellel ei ole kehtivat tervisetõendit, peab hiljemalt 2013. aasta 31. oktoobril esitama Kaitseliidule kehtiva tervisetõendi. (2) Käesoleva paragrahvi lõikes 1 sätestatud tähtpäevaks kehtiva tervisetõendi esitamata jätmisel loetakse Kaitseliidu tegevliikme Kaitseliidu relvaloa kehtivus peatunuks alates 2013. aasta 1. novembrist.",
      "rdfs:label": {
        "@value": "KAITSE_Par_93 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 93",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_94_v120032013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist Kaitseliidu tegevliikme soetatud isiklik sõjaväerelv loetakse käesoleva seaduse jõustumisel tegevliikme relvaks.",
      "rdfs:label": {
        "@value": "KAITSE_Par_94 (redaktsioon 120032013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_Par_94_v129062018061"
      },
      "estleg:versionValidTo": {
        "@value": "2018-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120032013001",
      "estleg:sourceAct": "Kaitseliidu seadus",
      "estleg:provisionRef": "KAITSE § 94",
      "estleg:partOfAct": {
        "@id": "estleg:KAITSE_Map_2026"
      }
    },
    {
      "@id": "estleg:KAITSE_Par_94_v129062018061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist Kaitseliidu tegevliikme soetatud isiklik sõjarelv loetakse käesoleva seaduse jõustumisel tegevliikme relvaks.",
      "rdfs:label": {
        "@value": "KAITSE_Par_94 (redaktsioon 129062018061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062018061",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062018061",
