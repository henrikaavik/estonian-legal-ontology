      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist loodud Kaitseliidu Peastaap, Alutaguse Malev, Harju Malev, Jõgeva Malev, Järva Malev, Lääne Malev, Viru Malev, Põlva Malev, Pärnumaa Malev, Rapla Malev, Saaremaa Malev, Sakala Malev, Tallinna Malev, Tartu Malev, Valgamaa Malev ja Võrumaa Malev on avalik-õiguslikud juriidilised isikud alates käesoleva seaduse jõustumisest.",
      "rdfs:label": {
        "@value": "KAITSE_Par_41 (redaktsioon 25817)",
        "@language": "et"
      },
