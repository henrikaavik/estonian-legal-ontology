      }
    },
    {
      "@id": "estleg:Reg_1057193_Par_9_v1057193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057193_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Infosüsteemi andmeandjad on infosüsteemiga liitunud muuseumid. Infosüsteemi andmeandjad on infosüsteemiga liitunud muuseumid. 2 (2) Andmeandja nimel esitavad käesoleva määruse §-s 10 sätestatud korras andmeid andmeandja töötajad, kellele on käesoleva määruse §-st 5 lähtudes antud vajalikus ulatuses infosüsteemi kasutajaõigused. Andmeandja nimel esitavad käesoleva määruse §-s 10 sätestatud korras andmeid andmeandja töötajad, kellele on käesoleva määruse §-st 5 lähtudes antud vajalikus ulatuses infosüsteemi kasutajaõigused.",
      "rdfs:label": {
        "@value": "Reg_1057193_Par_9 (redaktsioon 1057193)",
        "@language": "et"
      },
