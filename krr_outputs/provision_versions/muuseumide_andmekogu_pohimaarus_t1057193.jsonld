      "estleg:versionValidFrom": {
        "@value": "2023-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse andmete esitamine, päringute tegemine ning kasutajaõiguste andmine ja äravõtmine logitakse. Andmekogusse andmete esitamine, päringute tegemine ning kasutajaõiguste andmine ja äravõtmine logitakse. 2 (2) Andmete esitamise logisid säilitatakse tähtajatult. Andmete esitamise logisid säilitatakse tähtajatult. 3 (3) Päringute tegemise ning kasutajaõiguste andmise ja äravõtmise logisid säilitatakse kaks aastat nende tekkimisest alates. Päringute tegemise ning kasutajaõiguste andmise ja äravõtmise logisid säilitatakse kaks aastat nende tekkimisest alates.",
      "rdfs:label": {
        "@value": "Reg_1057193_Par_13 (redaktsioon 1057193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057193",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057193",
      "estleg:sourceAct": "Muuseumide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1057193 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057193_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057193_Par_14_v1057193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057193_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku ja haldusjärelevalvet käesoleva määruse rakendamise üle teostavad Muinsuskaitseamet, Andmekaitse Inspektsioon ning Riigi Infosüsteemi Amet õigusaktides sätestatud pädevuse kohaselt. Riiklikku ja haldusjärelevalvet käesoleva määruse rakendamise üle teostavad Muinsuskaitseamet, Andmekaitse Inspektsioon ning Riigi Infosüsteemi Amet õigusaktides sätestatud pädevuse kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1057193_Par_14 (redaktsioon 1057193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057193",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057193",
      "estleg:sourceAct": "Muuseumide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1057193 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057193_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057193_Par_15_v1057193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057193_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Infosüsteemi pidamist, sealhulgas hooldustöid, haldamist ning arendustöid rahastatakse riigieelarvest infosüsteemi vastutava töötleja eelarve kaudu. Infosüsteemi pidamist, sealhulgas hooldustöid, haldamist ning arendustöid rahastatakse riigieelarvest infosüsteemi vastutava töötleja eelarve kaudu.",
      "rdfs:label": {
        "@value": "Reg_1057193_Par_15 (redaktsioon 1057193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057193",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057193",
      "estleg:sourceAct": "Muuseumide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1057193 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057193_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057193_Par_16_v1057193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057193_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Infosüsteemi lõpetamise otsustab valdkonna eest vastutav minister. Infosüsteemi lõpetamise otsustab valdkonna eest vastutav minister. 2 (2) Infosüsteem lõpetatakse kooskõlas avaliku teabe seaduses ja arhiiviseaduses sätestatud nõuetega. Infosüsteem lõpetatakse kooskõlas avaliku teabe seaduses ja arhiiviseaduses sätestatud nõuetega.",
      "rdfs:label": {
        "@value": "Reg_1057193_Par_16 (redaktsioon 1057193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057193",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057193",
      "estleg:sourceAct": "Muuseumide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1057193 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057193_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057193_Par_17_v1057193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057193_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kultuuriministri 08.07.2013 määrus nr 32 „Muuseumide andmekogu asutamine ja põhimäärus” tunnistatakse kehtetuks. Kultuuriministri 08.07.2013 määrus nr 32 „Muuseumide andmekogu asutamine ja põhimäärus” tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1057193_Par_17 (redaktsioon 1057193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057193",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057193",
      "estleg:sourceAct": "Muuseumide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1057193 § 17",
