    {
      "@id": "estleg:Reg_1044457_Par_3_v1044457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044457_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1044457_Par_3 (redaktsioon 1044457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044457",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044457",
      "estleg:sourceAct": "Keretü looduskaitseala moodustamine ja kaitse-eeskiri",
