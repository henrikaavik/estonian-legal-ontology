      }
    },
    {
      "@id": "estleg:Reg_1044457_Par_13_v1044457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044457_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keretü piiranguvööndi kaitse-eesmärk on metsise mänguaegse elupaiga kaitse ning kaitseala kompaktsuse ja sidususe tagamine. Keretü piiranguvööndi kaitse-eesmärk on metsise mänguaegse elupaiga kaitse ning kaitseala kompaktsuse ja sidususe tagamine.",
      "rdfs:label": {
        "@value": "Reg_1044457_Par_13 (redaktsioon 1044457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044457",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044457",
      "estleg:sourceAct": "Keretü looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1044457 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044457_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044457_Par_14_v1044457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044457_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus, arvestades käesoleva määrusega sätestatud erisusi; 2 2) kuni 300 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas harjutusvälja valdaja loal; 3 3) telkimine ja lõkketegemine ettevalmistamata kohas harjutusväljal valdaja loal. Piiranguvööndis on lubatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus, arvestades käesoleva määrusega sätestatud erisusi; kuni 300 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas harjutusvälja valdaja loal; telkimine ja lõkketegemine ettevalmistamata kohas harjutusväljal valdaja loal. 2 (2) Kaitseala valitseja ja harjutusvälja valdaja nõusolekul on piiranguvööndis lubatud: 1 1) rohkem kui 300 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas; 2 2) veekogude veetaseme ja kaldajoone muutmine; 3 3) ehitise püstitamine. Kaitseala valitseja ja harjutusvälja valdaja nõusolekul on piiranguvööndis lubatud: rohkem kui 300 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas; veekogude veetaseme ja kaldajoone muutmine; ehitise püstitamine. 3 (3) Kaitseala valitseja nõusolekul on lubatud: 1 1) aegjärkne raie ja häilraie kuni 2 hektari suuruse langina; 2 2) lageraie kuni 1 hektari suuruse langina, välja arvatud männikutes. Kaitseala valitseja nõusolekul on lubatud: aegjärkne raie ja häilraie kuni 2 hektari suuruse langina; lageraie kuni 1 hektari suuruse langina, välja arvatud männikutes. 4 (4) Raie tegemisel tuleb arvestada järgmiste piirangutega: 1 1) üle 60 aasta vanuse metsa osakaal ei tohi jääda väiksemaks kui 50%; 2 2) raie ei ole lubatud 1. veebruarist 31. augustini. Raie tegemisel tuleb arvestada järgmiste piirangutega: üle 60 aasta vanuse metsa osakaal ei tohi jääda väiksemaks kui 50%; raie ei ole lubatud 1. veebruarist 31. augustini. 5 (5) Raie tegemisel metsamaal tuleb säilitada puistu liikide ja vanuse mitmekesisus. Elustiku mitmekesisuse säilitamiseks tuleb jätta raielangile hektari kohta alles vähemalt 15 tihumeetrit puid, mida ei koristata ja mis jäävad metsa alatiseks. Elustiku mitmekesisuse tagamiseks alles jäetavad puud valitakse eri puuliikide esimese rinde suurima diameetriga puude hulgast, eelistades kõvalehtpuid, mände ja haabasid, samuti eritunnustega, nagu põlemisjälgede, õõnsuste, tuuleluudade või suurte okstega puid. Raie tegemisel metsamaal tuleb säilitada puistu liikide ja vanuse mitmekesisus. Elustiku mitmekesisuse säilitamiseks tuleb jätta raielangile hektari kohta alles vähemalt 15 tihumeetrit puid, mida ei koristata ja mis jäävad metsa alatiseks. Elustiku mitmekesisuse tagamiseks alles jäetavad puud valitakse eri puuliikide esimese rinde suurima diameetriga puude hulgast, eelistades kõvalehtpuid, mände ja haabasid, samuti eritunnustega, nagu põlemisjälgede, õõnsuste, tuuleluudade või suurte okstega puid.",
      "rdfs:label": {
        "@value": "Reg_1044457_Par_14 (redaktsioon 1044457)",
        "@language": "et"
      },
