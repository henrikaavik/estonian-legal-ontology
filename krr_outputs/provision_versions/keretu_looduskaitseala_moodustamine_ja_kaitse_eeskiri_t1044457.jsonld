    {
      "@id": "estleg:Reg_1044457_Par_11_v1044457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044457_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) inimeste viibimine Tsirgupalu sihtkaitsevööndis 1. veebruarist 31. juulini ning Kanarbiku sihtkaitsevööndis 15. märtsist 31. augustini, välja arvatud järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel ning kaitseala valitseja nõusolekul teostataval teadustegevusel; 4 4) rahvaürituste korraldamine Nursipalu sihtkaitsevööndis 1. märtsist 31. augustini. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; inimeste viibimine Tsirgupalu sihtkaitsevööndis 1. veebruarist 31. juulini ning Kanarbiku sihtkaitsevööndis 15. märtsist 31. augustini, välja arvatud järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel ning kaitseala valitseja nõusolekul teostataval teadustegevusel; rahvaürituste korraldamine Nursipalu sihtkaitsevööndis 1. märtsist 31. augustini.",
      "rdfs:label": {
        "@value": "Reg_1044457_Par_11 (redaktsioon 1044457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044457",
