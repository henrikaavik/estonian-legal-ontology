      "estleg:provisionRef": "Reg_1044457 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044457_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044457_Par_2_v1044457",
