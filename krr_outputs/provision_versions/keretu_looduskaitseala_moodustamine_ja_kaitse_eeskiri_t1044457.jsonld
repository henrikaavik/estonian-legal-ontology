      }
    },
    {
      "@id": "estleg:Reg_1044457_Par_12_v1044457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044457_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Keretü piiranguvöönd. Kaitsealal on Keretü piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1044457_Par_12 (redaktsioon 1044457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044457",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044457",
      "estleg:sourceAct": "Keretü looduskaitseala moodustamine ja kaitse-eeskiri",
