    },
    {
      "@id": "estleg:Reg_1053211_Par_14_v1053211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053211_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isiku taotluse alusel temalt kohtuekspertiisiseaduse § 20 lõike 1 alusel võetud jälgede korral kantakse andmekogusse: 1 1) sõrme pööratud jäljed; 2 2) sõrme vajutusjäljed; 3 3) peopesa ja kirjutaja-peopesa vajutusjäljed. Isiku taotluse alusel temalt kohtuekspertiisiseaduse § 20 lõike 1 alusel võetud jälgede korral kantakse andmekogusse: sõrme pööratud jäljed; sõrme vajutusjäljed; peopesa ja kirjutaja-peopesa vajutusjäljed. 2 (2) Isiku taotluse alusel temalt kohtuekspertiisiseaduse § 20 lõike 1 alusel võetud näokujutise korral kantakse andmekogusse: 1 1) näo otsevaade; 2 2) näo parem ja vasak profiil; 3 3) näo parem ja vasak poolprofiil. RT I 2023-10-03 16 103102023016 2023-10-06 Isiku taotluse alusel temalt kohtuekspertiisiseaduse § 20 lõike 1 alusel võetud näokujutise korral kantakse andmekogusse: näo otsevaade; näo parem ja vasak profiil; näo parem ja vasak poolprofiil.",
      "rdfs:label": {
        "@value": "Reg_1053211_Par_14 (redaktsioon 1053211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053211",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053211",
      "estleg:sourceAct": "Automaatse biomeetrilise isikutuvastuse süsteemi andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1053211 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053211_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1053211_Par_15_v1053211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
