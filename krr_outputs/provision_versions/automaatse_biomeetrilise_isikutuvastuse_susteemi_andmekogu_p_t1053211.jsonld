      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti kodaniku passi või isikutunnistuse taotluse edastamisel ja e-residendi digitaalse isikutunnistuse väljastamisel kantakse andmekogusse taotleja sõrmejäljekujutised. Eesti kodaniku passi või isikutunnistuse taotluse edastamisel ja e-residendi digitaalse isikutunnistuse väljastamisel kantakse andmekogusse taotleja sõrmejäljekujutised.",
      "rdfs:label": {
        "@value": "Reg_1053211_Par_15 (redaktsioon 1053211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053211",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053211",
      "estleg:sourceAct": "Automaatse biomeetrilise isikutuvastuse süsteemi andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1053211 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053211_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1053211_Par_16_v1053211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053211_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elamisloa ning elamisloakaardi taotluse edastamisel kantakse andmekogusse taotleja sõrmejäljekujutised. Elamisloa ning elamisloakaardi taotluse edastamisel kantakse andmekogusse taotleja sõrmejäljekujutised.",
      "rdfs:label": {
        "@value": "Reg_1053211_Par_16 (redaktsioon 1053211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053211",
