      "estleg:provisionRef": "Reg_1053211 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053211_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1053211_Par_31_v1053211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053211_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalase kohta, kelle lühiajalise Eestis töötamise registreerimist taotletakse, kantakse andmekogusse foto või näokujutis. Välismaalase kohta, kelle lühiajalise Eestis töötamise registreerimist taotletakse, kantakse andmekogusse foto või näokujutis.",
