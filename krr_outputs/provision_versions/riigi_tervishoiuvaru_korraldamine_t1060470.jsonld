      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060470_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse riigi tervishoiuvaru (edaspidi varu) moodustamise, haldamise, uuendamise ja kasutusele võtmise, aegunud varu mahakandmise ja hävitamise ning aruandluse tingimused ja kord. Määrusega kehtestatakse riigi tervishoiuvaru (edaspidi varu) moodustamise, haldamise, uuendamise ja kasutusele võtmise, aegunud varu mahakandmise ja hävitamise ning aruandluse tingimused ja kord. 2 (2) Käesoleva määruse nõudeid ei kohaldata tervishoiuteenuse osutaja tegevusvarule. Käesoleva määruse nõudeid ei kohaldata tervishoiuteenuse osutaja tegevusvarule.",
      "rdfs:label": {
        "@value": "Reg_1060470_Par_1 (redaktsioon 1060470)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060470",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060470",
      "estleg:sourceAct": "Riigi tervishoiuvaru korraldamine",
      "estleg:provisionRef": "Reg_1060470 § 1",
