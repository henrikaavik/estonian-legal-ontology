    {
      "@id": "estleg:Reg_1036559_Par_10_v1036559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036559_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkurss loetakse luhtunuks, kui muuseumi juhi ametikohale kandideerimiseks ei esitatud ühtegi taotlust või kui ükski kandidaatidest ei osutunud valituks. Konkurss loetakse luhtunuks, kui muuseumi juhi ametikohale kandideerimiseks ei esitatud ühtegi taotlust või kui ükski kandidaatidest ei osutunud valituks.",
      "rdfs:label": {
        "@value": "Reg_1036559_Par_10 (redaktsioon 1036559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036559",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036559",
      "estleg:sourceAct": "Kliimaministeeriumi valitsemisalasse kuuluva riigimuuseumi juhi kandidaadile esitatavad nõuded ja avaliku konkursi läbiviimise kord",
      "estleg:provisionRef": "Reg_1036559 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036559_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036559_Par_2_v1036559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036559_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ministeeriumi valitsemisalasse kuuluva riigimuuseumi (edaspidi muuseum) juhi vaba ametikoha täitmiseks korraldatakse avalik konkurss (edaspidi konkurss). Ministeeriumi valitsemisalasse kuuluva riigimuuseumi (edaspidi muuseum) juhi vaba ametikoha täitmiseks korraldatakse avalik konkurss (edaspidi konkurss). 2 (2) Konkursi kuulutab välja valdkonna eest vastutav minister. Konkursi kuulutab välja valdkonna eest vastutav minister.",
      "rdfs:label": {
        "@value": "Reg_1036559_Par_2 (redaktsioon 1036559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036559",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036559",
      "estleg:sourceAct": "Kliimaministeeriumi valitsemisalasse kuuluva riigimuuseumi juhi kandidaadile esitatavad nõuded ja avaliku konkursi läbiviimise kord",
      "estleg:provisionRef": "Reg_1036559 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036559_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036559_Par_3_v1036559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036559_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Konkursil osaleja (edaspidi kandidaat) haridus, teadmised ja oskused ning kogemused peavad vastama järgmistele nõuetele: 1 1) kõrgharidus; 2 2) vähemalt 3-aastane inimeste- või protsesside juhtimiskogemus; 3 3) eesti keele ja võõrkeelte oskus ametikohal töötamiseks nõutud tasemel; 4 4) muuseumi juhtimiseks vajalike õigusaktide tundmine; 5 5) majandusalased üldteadmised ja teadmised eelarve koostamisest; 6 6) hea suhtlemisoskus, sealhulgas oskus suhelda avalikkusega ning teha koostööd avalike huvide elluviimisel. Konkursil osaleja (edaspidi kandidaat) haridus, teadmised ja oskused ning kogemused peavad vastama järgmistele nõuetele: kõrgharidus; vähemalt 3-aastane inimeste- või protsesside juhtimiskogemus; eesti keele ja võõrkeelte oskus ametikohal töötamiseks nõutud tasemel; muuseumi juhtimiseks vajalike õigusaktide tundmine; majandusalased üldteadmised ja teadmised eelarve koostamisest; hea suhtlemisoskus, sealhulgas oskus suhelda avalikkusega ning teha koostööd avalike huvide elluviimisel. 2 (2) Muuseumi eripärast tulenevalt võib konkursikuulutuses igal üksikul juhul esitada kandidaadile lisaks käesoleva paragrahvi lõikes 1 nimetatule täiendavaid nõudeid. Muuseumi eripärast tulenevalt võib konkursikuulutuses igal üksikul juhul esitada kandidaadile lisaks käesoleva paragrahvi lõikes 1 nimetatule täiendavaid nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1036559_Par_3 (redaktsioon 1036559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036559",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036559",
      "estleg:sourceAct": "Kliimaministeeriumi valitsemisalasse kuuluva riigimuuseumi juhi kandidaadile esitatavad nõuded ja avaliku konkursi läbiviimise kord",
      "estleg:provisionRef": "Reg_1036559 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036559_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036559_Par_4_v1036559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036559_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast konkursi väljakuulutamist avaldab ministeerium konkursiteate oma sise- ja välisveebis ja tööotsinguportaali(de)s arvestusega, et kandidaadile jääks dokumentide esitamiseks aega vähemalt 14 kalendripäeva konkursiteate avaldamisest arvates. Pärast konkursi väljakuulutamist avaldab ministeerium konkursiteate oma sise- ja välisveebis ja tööotsinguportaali(de)s arvestusega, et kandidaadile jääks dokumentide esitamiseks aega vähemalt 14 kalendripäeva konkursiteate avaldamisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1036559_Par_4 (redaktsioon 1036559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036559",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036559",
      "estleg:sourceAct": "Kliimaministeeriumi valitsemisalasse kuuluva riigimuuseumi juhi kandidaadile esitatavad nõuded ja avaliku konkursi läbiviimise kord",
      "estleg:provisionRef": "Reg_1036559 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036559_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036559_Par_5_v1036559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036559_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kandidaat esitab konkursil osalemiseks konkursiteates loetletud dokumendid, mis peavad vastama paragrahvis 3 toodud nõuetele. Kandidaat esitab konkursil osalemiseks konkursiteates loetletud dokumendid, mis peavad vastama paragrahvis 3 toodud nõuetele. 2 (2) Konkursist saavad osa võtta need kandidaadid, kelle taotlus koos nõutud dokumentidega on saabunud ministeeriumisse konkursiteates nimetatud tähtajaks. Konkursist saavad osa võtta need kandidaadid, kelle taotlus koos nõutud dokumentidega on saabunud ministeeriumisse konkursiteates nimetatud tähtajaks. 3 (3) Konkurssi komisjoni sekretär kontrollib kõigi nõutud dokumentide olemasolu. Nõutud dokumentide puudumisel teatab komisjoni sekretär kandidaadile puuduvatest dokumentidest elektrooniliselt ja annab kuni kolme kalendripäevase tähtaja puuduste kõrvaldamiseks. Konkurssi komisjoni sekretär kontrollib kõigi nõutud dokumentide olemasolu. Nõutud dokumentide puudumisel teatab komisjoni sekretär kandidaadile puuduvatest dokumentidest elektrooniliselt ja annab kuni kolme kalendripäevase tähtaja puuduste kõrvaldamiseks.",
      "rdfs:label": {
        "@value": "Reg_1036559_Par_5 (redaktsioon 1036559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036559",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036559",
      "estleg:sourceAct": "Kliimaministeeriumi valitsemisalasse kuuluva riigimuuseumi juhi kandidaadile esitatavad nõuded ja avaliku konkursi läbiviimise kord",
      "estleg:provisionRef": "Reg_1036559 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036559_Map"
      }
