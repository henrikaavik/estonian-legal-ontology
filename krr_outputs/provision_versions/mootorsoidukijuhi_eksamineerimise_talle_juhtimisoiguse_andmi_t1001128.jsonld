      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Mootorsõidukijuhi eksamineerimise, talle juhtimisõiguse andmise kord ja juhiloa vormid ning nõuded eksamisõidukitele (29 versiooni)",
        "@language": "et"
      },
      "dc:source": "Mootorsõidukijuhi eksamineerimise, talle juhtimisõiguse andmise kord ja juhiloa vormid ning nõuded eksamisõidukitele"
    },
    {
      "@id": "estleg:Reg_1001128_Par_1_v1001128",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001128_Par_1"
