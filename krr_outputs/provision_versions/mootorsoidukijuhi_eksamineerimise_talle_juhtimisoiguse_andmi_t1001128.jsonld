        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 2011. aasta 1. juulil. Määrus jõustub 2011. aasta 1. juulil.",
      "rdfs:label": {
        "@value": "Reg_1001128_Par_28 (redaktsioon 1001128)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001128",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001128",
      "estleg:sourceAct": "Mootorsõidukijuhi eksamineerimise, talle juhtimisõiguse andmise kord ja juhiloa vormid ning nõuded eksamisõidukitele",
