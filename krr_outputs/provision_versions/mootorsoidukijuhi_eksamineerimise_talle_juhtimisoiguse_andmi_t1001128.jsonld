    {
      "@id": "estleg:Reg_1001128_Par_2_v1001128",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001128_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhi eksamineerimise eesmärk on hinnata isiku teadmiste, oskuste, käitumise ja hoiakute vastavust juhi kvalifikatsiooninõuetele. Juhi eksamineerimise eesmärk on hinnata isiku teadmiste, oskuste, käitumise ja hoiakute vastavust juhi kvalifikatsiooninõuetele.",
      "rdfs:label": {
        "@value": "Reg_1001128_Par_2 (redaktsioon 1001128)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001128",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001128",
      "estleg:sourceAct": "Mootorsõidukijuhi eksamineerimise, talle juhtimisõiguse andmise kord ja juhiloa vormid ning nõuded eksamisõidukitele",
      "estleg:provisionRef": "Reg_1001128 § 2",
