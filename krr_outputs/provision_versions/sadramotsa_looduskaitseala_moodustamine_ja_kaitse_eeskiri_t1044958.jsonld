        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Sadramõtsa piiranguvöönd. Kaitsealal on Sadramõtsa piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1044958_Par_12 (redaktsioon 1044958)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044958",
