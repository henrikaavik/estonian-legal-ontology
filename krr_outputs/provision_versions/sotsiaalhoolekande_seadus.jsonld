        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "SOTSIA_Par_142 (redaktsioon 121122016021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122016021",
