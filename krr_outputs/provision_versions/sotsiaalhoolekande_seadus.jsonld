    {
      "@id": "estleg:SOTSIA_Par_47_v13333011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "SOTSIA_Par_47 (redaktsioon 13333011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13333011",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_47_v130122015005"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13333011",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 47",
      "estleg:partOfAct": {
