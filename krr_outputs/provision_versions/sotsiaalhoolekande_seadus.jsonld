      }
    },
    {
      "@id": "estleg:SOTSIA_Par_57_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalse rehabilitatsiooni teenuse raames osutatavate selliste teenuste loetelu ja hinna, mille eest tasu maksmise kohustuse võtab riik üle, kehtestab määrusega.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_57 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 57",
      "estleg:partOfAct": {
