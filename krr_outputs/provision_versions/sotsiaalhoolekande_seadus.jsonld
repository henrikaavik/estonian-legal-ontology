    {
      "@id": "estleg:SOTSIA_Par_146_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse üksuse eelarvest rahastatava sotsiaalteenuse, sotsiaaltoetuse, vältimatu sotsiaalabi või muu abi ning toimetulekutoetuse ja vajaduspõhise peretoetuse otsusega mittenõustumise korral on taotlejal õigus esitada haldusmenetluse seaduses sätestatud korras vaie kohaliku omavalitsuse üksuse kaudu maavanemale.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_146 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_146_v128122017066"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
