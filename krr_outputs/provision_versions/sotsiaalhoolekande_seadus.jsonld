      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13333011",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 32",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_32_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Varjupaigateenuse osutaja kehtestab sisekorraeeskirja ning on kohustatud teenuse osutamise alustamisel teavitama isikut sisekorraeeskirjast ning isiku õigustest ja piirangutest teenuse saamise ajal sellisel viisil, et isik on võimeline neid mõistma.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_32 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 32",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_32_1_v112062025024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_32_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elukeskkond, kus osutatakse varjupaigateenust, peab vastama rahvatervishoiu seaduse §-s 21 sätestatud ja selle alusel kehtestatud nõuetele.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_32_1 (redaktsioon 112062025024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112062025024",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112062025024",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 32_1",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_33_v22317",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sotsiaalteenuse, sotsiaaltoetuse, vältimatu sotsiaalabi või muu abi andmise või sellest keeldumise määrab valla- või linnavalitsuse poolt volitatud ametnik. Sotsiaalhoolekannet taotleva isiku nõudmisel otsustab küsimuse valla- või linnavalitsuse vastav komisjon. Viimase otsusega mittenõustumisel on taotlejal õigus pöörduda kohtusse käesoleva seaduse §-s 47 ettenähtud korras. (2) Otsus peab olema põhjendatud, tuginema selle tegemise aluseks olnud tehioludele ning seadustele ja muudele õigusaktidele.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_33 (redaktsioon 22317)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22317",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_33_v184521"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-19",
        "@type": "xsd:date"
      },
