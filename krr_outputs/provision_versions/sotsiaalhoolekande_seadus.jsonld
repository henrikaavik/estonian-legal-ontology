    },
    {
      "@id": "estleg:SOTSIA_Par_25_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenuse osutamisel lähtub teenust vahetult osutav isik teenuse osutamise haldusaktist või halduslepingust. (2) Teenust ei tohi vahetult osutada isik: kelle karistatus tahtlikult toimepandud kuriteo eest võib ohtu seada teenust saama õigustatud isiku elu, tervise ja vara; kes on teenuse saaja esimese või teise astme üleneja või alaneja sugulane; kes elab alaliselt või püsivalt samas eluruumis teenuse saajaga.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_25 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 25",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_26_v22317",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puuetega isikutele teiste inimestega võrdsete võimaluste tagamiseks, nende aktiivseks osalemiseks ühiskonnaelus ja iseseisvaks toimetulekuks valla- või linnavalitsus: loob võimalused puudest tingitud takistuste vähendamiseks või kõrvaldamiseks ravi, rehabilitatsiooni, õpetuse ja tõlketeenustega; loob koostöös pädevate riigiorganitega võimalused puuetega inimeste konkurentsivõimet tõstvaks kutseõpetuseks; sobitab koostöös pädevate riigiorganitega töökohti ja loob rakenduskeskusi; korraldab invatransporti; tagab puuetega inimestele juurdepääsu üldkasutatavatesse hoonetesse; määrab vajadusel tugiisiku või isikliku abistaja; korraldab eestkostet ning seab hoolduse.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_26 (redaktsioon 22317)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22317",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_26_v832961"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22317",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 26",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_26_v832961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puuetega isikutele teiste inimestega võrdsete võimaluste tagamiseks, nende aktiivseks osalemiseks ühiskonnaelus ja iseseisvaks toimetulekuks valla- või linnavalitsus: loob võimalused puudest tingitud takistuste vähendamiseks või kõrvaldamiseks ravi, õpetuse ja tõlketeenustega; loob koostöös pädevate riigiorganitega võimalused puuetega inimeste konkurentsivõimet tõstvaks kutseõpetuseks; sobitab koostöös pädevate riigiorganitega töökohti ja loob rakenduskeskusi; korraldab invatransporti; tagab puuetega inimestele juurdepääsu üldkasutatavatesse hoonetesse; määrab vajadusel tugiisiku või isikliku abistaja; korraldab eestkostet ning seab hoolduse.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_26 (redaktsioon 832961)",
        "@language": "et"
      },
