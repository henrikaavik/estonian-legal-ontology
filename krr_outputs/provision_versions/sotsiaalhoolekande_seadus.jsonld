    },
    {
      "@id": "estleg:SOTSIA_Par_160_2_v126062018018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_160_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus koostab 2020. aasta 1. jaanuariks analüüsi ja selle põhjal ettepanekud täisealise isiku hooldusvajaduse tuvastamiseks kasutatava hindamissüsteemi kohta eesmärgiga rakendada analüüsi tulemusi hoolduspuhkuse saaja kindlaksmääramiseks alates 2021. aasta 1. jaanuarist",
      "rdfs:label": {
        "@value": "SOTSIA_Par_160_2 (redaktsioon 126062018018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018018",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018018",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 160_2",
      "estleg:partOfAct": {
