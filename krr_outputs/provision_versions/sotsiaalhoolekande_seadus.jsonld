      "estleg:provisionRef": "SOTSIA § 22",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_22_v130122015005",
