      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13333011",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 4",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_4_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse termineid järgmises tähenduses: sotsiaalhoolekanne – sotsiaalteenuste, sotsiaaltoetuste, vältimatu sotsiaalabi ja muu abi andmise või määramisega seotud toimingute süsteem, mille eesmärk on toetada inimese iseseisvat toimetulekut ja töötamist ning aktiivset osalust ühiskonnaelus, ennetades sealjuures sotsiaalsete probleemide tekkimist või süvenemist üksikisiku, perekonna ja ühiskonna tasandil; hoolekandeasutus – käesolevas seaduses nimetatud sotsiaalteenust osutav asutus; sotsiaaltöötaja – sotsiaalhoolekandes töötav vastava erialase ettevalmistusega kõrgharidusega isik; laps – isik lastekaitseseaduse § 3 lõike 2 tähenduses; lapsega vahetult töötav isik – lastekaitseseaduse § 18 lõikes 2 nimetatud isik, kes vastab lastekaitseseaduse §-s 20 sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_4 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 4",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_40_v22317",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalhoolekannet finantseeritakse: kohalike omavalitsuste eelarvetest; riigieelarvest; vabatahtlikult sotsiaalhoolekandega tegelevate juriidiliste ja füüsiliste isikute vahenditest; muudest vahenditest.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_40 (redaktsioon 22317)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22317",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_40_v130122015005"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22317",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 40",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_40_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liiniveona osutatava sotsiaaltransporditeenuse eest võib tasu võtta summas, mille isik kulutaks sama vahemaa läbimiseks soodsaima olemasoleva transpordivahendiga, kui tal ei esineks puudest tulenevat takistust. (2) Juhuveo ja taksoteenusena osutatava sotsiaaltransporditeenuse eest võib tasu võtta suuremas ulatuses kui käesoleva paragrahvi lõikes 1 on nimetatud.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_40 (redaktsioon 130122015005)",
        "@language": "et"
      },
