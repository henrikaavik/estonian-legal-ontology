        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sotsiaalteenuste ja -toetuste andmeregister on riigi infosüsteemi kuuluv keskne andmekogu, mis on asutatud juhtumikorralduse põhimõttel tehtava sotsiaaltöö dokumenteerimiseks ja menetlemiseks, sotsiaalteenuste ja -toetuste ning muu abi andmise dokumenteerimiseks ja menetlemiseks, lapsendamise ja eestkoste korraldamiseks ning sotsiaalhoolekandealase teabe ja kohaliku omavalitsuse makstavate, isikute individuaalsest abivajadusest, toimetulekuvõimest või majanduslikust olukorrast mittesõltuvate sotsiaaltoetuste kohta käiva teabe ja statistika kogumiseks. (2) Sotsiaalteenuste ja -toetuste andmeregistri asutab ning selle põhimääruse ja andmete säilitamise tähtaja kehtestab määrusega. (3) Sotsiaalteenuste ja -toetuste andmeregistri vastutav töötleja on Sotsiaalministeerium. (4) Sotsiaalteenuste ja -toetuste andmeregistri asutamise ja pidamise kulud kaetakse riigieelarvest.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_141 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_141_v121122016021"
      },
      "estleg:versionValidTo": {
        "@value": "2016-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 141",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_141_v121122016021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sotsiaalteenuste ja -toetuste andmeregister on riigi infosüsteemi kuuluv keskne andmekogu, mis on asutatud järgmistel eesmärkidel: sotsiaalteenuste ja -toetuste ning muu abi osutamise menetlemine ja dokumenteerimine; juhtumikorralduse põhimõttel tehtava sotsiaaltöö toimingute läbiviimine ja dokumenteerimine; lapsendamise ja eestkoste korraldamine ja dokumenteerimine; sotsiaalhoolekandealase teabe ja statistika kogumine. (2) kehtestab määrusega sotsiaalteenuste ja -toetuste andmeregistri põhimääruse, milles sätestatakse: andmekogu volitatud töötleja; vastutava ja volitatud töötleja ülesanded; andmekogusse kogutavate andmete koosseis ja registrisse kandmise kord; andmetele juurdepääsu ja andmete väljastamise kord; andmete säilitamine; muud korraldusküsimused. (3) Sotsiaalteenuste ja -toetuste andmeregistri vastutav töötleja on Sotsiaalministeerium. (4) Kehtetu -",
      "rdfs:label": {
        "@value": "SOTSIA_Par_141 (redaktsioon 121122016021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122016021",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_141_v113032019154"
      },
