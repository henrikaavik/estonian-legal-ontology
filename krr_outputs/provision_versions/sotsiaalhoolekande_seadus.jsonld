    {
      "@id": "estleg:SOTSIA_Par_66_v112062025024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalse rehabilitatsiooni teenuse osutaja, kes osutab sotsiaalse rehabilitatsiooni teenust, mille eest võtab riik tasu maksmise kohustuse üle, peab: olema moodustanud käesoleva seaduse §-s 68 sätestatud nõuetele vastava rehabilitatsioonimeeskonna; tagama, et sotsiaalse rehabilitatsiooni teenust vahetult osutav isik vastab käesoleva seaduse §-s 68 sätestatud nõuetele; välja jäetud - tagama, et teenuse osutamise koht vastab tuleohutuse nõuetele; tagama teenuse osutamise kohale juurdepääsu ehitusseadustiku § 11 lõike 4 alusel kehtestatud nõuete kohaselt; kehtetu - olema kehtestanud asutusesisese kaebuste lahendamise korra; korraldama teenuse osutamise selliselt, et isikul on võimalik saada kõiki talle vajalikke sotsiaalse rehabilitatsiooni teenuse raames osutatavaid teenuseid ühe teenuseosutaja juures.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_66 (redaktsioon 112062025024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112062025024",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112062025024",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 66",
