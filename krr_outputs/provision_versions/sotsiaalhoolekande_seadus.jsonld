        "@value": "2018-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalministeerium analüüsib hiljemalt 2020. aastal käesoleva seaduse §-s 151 sätestatud noore abivajaduse hindamise regulatsiooni rakendamise mõju ja tulemuslikkust.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_160_1 (redaktsioon 103042018019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103042018019",
