      }
    },
    {
      "@id": "estleg:SOTSIA_Par_86_v128042022008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Erihoolekandeteenust võib vahetult osutada füüsiline isik (edaspidi tegevusjuhendaja), kellel on vähemalt keskharidus ja vajalik erialane ettevalmistus või sobiv kutse- või kõrgharidus erihoolekandeteenuse osutamiseks. (2) Kehtetu - (3) Erihoolekandeteenust ei või vahetult osutada tegevusjuhendaja, kelle karistatus tahtlikult toimepandud kuriteo eest võib ohtu seada teenust saama õigustatud isiku elu, tervise ja vara. (4) Kehtetu - (5) Kehtetu - (6) Kehtetu - (7) Tegevusjuhendaja ettevalmistusnõuded, sealhulgas nõuded haridusele ja koolitusele, ning nõuded koolituse läbimisele, koolituse mahule ja sisule kehtestab määrusega. (8) Erihoolekandeteenust võib vahetult osutada ka välisriigi kutsekvalifikatsiooni omandanud isik, kui tema kutsekvalifikatsiooni on tunnustatud välisriigi kutsekvalifikatsiooni tunnustamise seaduse kohaselt. Välisriigi kutsekvalifikatsiooni tunnustamise seaduse § 7 lõikes 2 sätestatud pädev asutus on Sotsiaalkindlustusamet.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_86 (redaktsioon 128042022008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128042022008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128042022008",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 86",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_87_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Igapäevaelu toetamise teenuse eesmärk on isiku parim võimalik iseseisev toimetulek ja areng psühhosotsiaalse toimetuleku toetamise, igapäevaelu toimetulekuoskuste ja tööoskuste kujundamise ning isiku lähedaste ja isikuga koos elavate isikute nõustamise kaudu. (2) Igapäevaelu toetamise teenuse osutamise käigus on teenuseosutaja kohustatud lähtuvalt isiku vajadustest ja suunamisotsuses nimetatud teenuse saamise eesmärgist: kujundama isiku isiklikke ja igapäevaelu oskusi, kaasates ta nimetatud oskusi arendavatesse tegevustesse, arvestades isiku terviseseisundit; juhendama isikut sotsiaalsete suhete loomisel, säilitamisel ja arendamisel; juhendama isikut aja planeerimisel ja vaba aja sisustamisel; juhendama isikut tervishoiu-, sotsiaal-, posti-, finants- ja muude teenuste kasutamisel ning hariduse omandamise võimaluste leidmisel ja elluviimisel; kujundama isiku tööoskusi ja võimaldama isikule töö tegemise harjutamist; nõustama isiku lähedasi, sealhulgas isikuga samas eluruumis elavaid isikuid, igapäevaelu toetamise teenust saama õigustatud isiku käitumise ja temaga suhtlemise eripärades; toetama teenust saavaid, sarnase diagnoosiga ja sellega seonduvate probleemidega isikuid toetavate gruppide tegutsemist isikute juhendamise ja nõustamise kaudu; kaasama isikut muudesse tegevustesse, mis on vajalikud igapäevaelu toetamise teenuse eesmärgi saavutamiseks.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_87 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 87",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_88_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigus saada igapäevaelu toetamise teenust on täisealisel isikul, välja arvatud käesoleva seaduse § 72 lõikes 2 nimetatud isikul, kes vastab järgmistele tingimustele: isikul on raske, sügava või püsiva kuluga psüühikahäire; isikule ei osutata samal ajal kogukonnas elamise teenust ega ööpäevaringset erihooldusteenust.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_88 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_88_v131122024028"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 88",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_88_v131122024028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigus saada igapäevaelu toetamise teenust on täisealisel isikul, välja arvatud käesoleva seaduse § 72 lõikes 2 nimetatud isikul, kes vastab järgmistele tingimustele: isikul on raske, sügava või püsiva kuluga psüühikahäire; isikule ei osutata samal ajal kogukonnas elamise teenust, päeva- ja nädalahoiuteenust ega ööpäevaringset erihooldusteenust.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_88 (redaktsioon 131122024028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122024028",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122024028",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 88",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_89_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse üksus on kohustatud tagama teenuseosutaja kasutuses või omandis olevate ruumidega seotud kulude katmise kohaliku omavalitsuse kehtestatud ulatuses.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_89 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
