      },
      "estleg:versionText": "Kohaliku omavalitsuse eelarvest kaetakse omavalitsusüksuse sotsiaalhoolekandekulud, mida ei finantseerita riigieelarvest vastavalt käesoleva seaduse §-s 42 sätestatule.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_41 (redaktsioon 12760827)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12760827",
