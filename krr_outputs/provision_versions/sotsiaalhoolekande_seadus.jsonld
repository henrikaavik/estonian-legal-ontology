    },
    {
      "@id": "estleg:SOTSIA_Par_144_1_v128042022009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_144_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalministeeriumi analüüsi ja statistikaga tegeleval osakonnal on õigus töödelda tervise-, töö- ja sotsiaalvaldkonna poliitika kujundamiseks sotsiaalteenuste ja -toetuste andmeregistrisse kantud isikuandmeid, ilma et isik oleks otseselt tuvastatav. Töödeldavateks andmeteks on käesoleva seaduse §-s 1421 nimetatud isikuandmed, välja arvatud isikukood, ees- ja perekonnanimi, elu- ja viibimiskoha andmed ning kontaktandmed.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_144_1 (redaktsioon 128042022009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128042022009",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_144_1_v130062023073"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128042022009",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 144_1",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_144_1_v130062023073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_144_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalministeeriumi tervise- ja sotsiaalvaldkonna eest vastutavatel ja analüüsi tegevatel ametnikel ning Majandus- ja Kommunikatsiooniministeeriumi töövaldkonna eest vastutavatel ja analüüsi tegevatel ametnikel on õigus töödelda poliitika kujundamiseks sotsiaalteenuste ja -toetuste andmeregistrisse kantud isikuandmeid, ilma et isik oleks otseselt tuvastatav. Töödeldavateks andmeteks on käesoleva seaduse §-s 1421 nimetatud isikuandmed, välja arvatud isikukood, ees- ja perekonnanimi, elu- ja viibimiskoha andmed ning kontaktandmed.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_144_1 (redaktsioon 130062023073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023073",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_144_1_v112062025022"
      },
      "estleg:versionValidTo": {
        "@value": "2025-06-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062023073",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 144_1",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_144_1_v112062025022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_144_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalministeeriumi tervise- ja sotsiaalvaldkonna eest vastutavatel ja analüüsi tegevatel ametnikel ning Majandus- ja Kommunikatsiooniministeeriumi töövaldkonna eest vastutavatel ja analüüsi tegevatel ametnikel on õigus töödelda poliitika kujundamiseks ja statistika koondamiseks sotsiaalteenuste ja -toetuste andmeregistrisse kantud isikuandmeid, ilma et isik oleks otseselt tuvastatav. Töödeldavateks andmeteks on käesoleva seaduse §-s 1421 nimetatud isikuandmed, välja arvatud isikukood, ees- ja perekonnanimi, elukohaandmed ning kontaktandmed.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_144_1 (redaktsioon 112062025022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112062025022",
