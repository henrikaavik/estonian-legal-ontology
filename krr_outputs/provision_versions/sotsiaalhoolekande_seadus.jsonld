      "estleg:provisionRef": "SOTSIA § 82",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_82_v113032019155",
