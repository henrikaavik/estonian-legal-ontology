      "estleg:provisionRef": "SOTSIA § 22_2",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_22_2_v112062025024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_22_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljaspool kodu üldhooldusteenust saava isiku elukeskkond ja toitlustamine peavad vastama rahvatervishoiu seaduse §-des 21 ja 22 sätestatud ning nende alusel kehtestatud nõuetele.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_22_2 (redaktsioon 112062025024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112062025024",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112062025024",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 22_2",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_23_v22317",
      "@type": [
