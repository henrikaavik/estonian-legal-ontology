    },
    {
      "@id": "estleg:SOTSIA_Par_118_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asenduskoduteenust võib osutada füüsilisest isikust ettevõtja või juriidiline isik, kellel on teenuseosutaja tegevuskohajärgse maavanema antud kehtiv tegevusluba vastavalt käesoleva seaduse § 151 punktile 2, ja kohaliku omavalitsuse üksuse ametiasutus või valitsusasutuse hallatav asutus, kelle jaoks asenduskoduteenuse osutamine on põhimäärusejärgne ülesanne ning kes on asenduskoduteenuse osutajana kantud majandustegevuse registrisse.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_118 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_118_v128122017066"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 118",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_118_v128122017066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "SOTSIA_Par_118 (redaktsioon 128122017066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122017066",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 118",
