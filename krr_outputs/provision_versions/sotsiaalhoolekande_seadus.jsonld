      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "SOTSIA_Par_20 (redaktsioon 121032014005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121032014005",
      "estleg:supersededByVersion": {
