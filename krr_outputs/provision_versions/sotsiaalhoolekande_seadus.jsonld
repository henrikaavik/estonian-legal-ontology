      }
    },
    {
      "@id": "estleg:SOTSIA_Par_38_v13333011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maavanem kontrollib tema halduspiirkonnas osutatavate sotsiaalteenuste, vältimatu sotsiaalabi ja muu abi kvaliteeti. (2) Puuduste ilmnemisel võib maavanem teha ettepaneku tegevuslitsentsi omava teenuste osutaja tegevuslitsentsi peatamiseks või kehtetuks tunnistamiseks ning vastava lepingu täitmise peatamiseks või lõpetamiseks või teha ettekirjutuse puuduste kõrvaldamiseks. (3) Käesoleva paragrahvi lõikes 2 nimetatud ettekirjutuse täitmata jätmise korral võib maavanem rakendada sunniraha asendustäitmise ja sunniraha seaduses sätestatud korras. (4) Käesoleva paragrahvi lõikes 3 sätestatud sunniraha ülemmäär on 640 eurot.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_38 (redaktsioon 13333011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13333011",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_38_v130122015005"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13333011",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 38",
