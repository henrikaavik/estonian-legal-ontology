    {
      "@id": "estleg:SOTSIA_Par_153_v112062025024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_153"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalteenuse osutamiseks antakse tegevusluba, kui: tegevusloa taotleja ja teenus, mida kavatsetakse osutama hakata, ning hooldustöötaja, turvakodus teenust vahetult osutav isik, lapsehoidja, kasvataja, perevanem ja tegevusjuhendaja (edaspidi teenust vahetult osutav isik) vastavad käesolevas seaduses ja selle alusel teenusele, teenuseosutajale ja teenust vahetult osutavale isikule kehtestatud nõuetele; teenust vahetult osutaval isikul puudub karistatus tahtlikult toimepandud kuriteo eest, mis võib ohtu seada teenust saama õigustatud isiku elu, tervise ja vara; teenuse osutamise koht vastab käesolevas seaduses ja rahvatervishoiu seaduses sätestatud ning nende alusel kehtestatud nõuetele; teenuse osutamise koht vastab tuleohutusnõuetele; käesoleva seaduse § 151 punktides 1–3 nimetatud teenuse puhul on täidetud lastekaitseseaduse §-s 20 sätestatud nõuded.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_153 (redaktsioon 112062025024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112062025024",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112062025024",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 153",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_154_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_154"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalteenuse osutaja tegevusloale lisatakse järgmised kõrvaltingimused: maksimaalne isikute arv, kellele on lubatud samal ajal teenust osutada; ööpäevaringse erihooldusteenuse korral täpsustus, kas ettevõtjal on õigus osutada seda teenust lisaks käesoleva seaduse § 101 lõikes 1 nimetatud isikule ka sügava liitpuudega isikule, ebastabiilse remissiooniga raske, sügava või püsiva kuluga psüühikahäirega isikule või kohtumäärusega hoolekandeasutusse paigutatud isikule; tegutsemiseks lubatud tegevuskoht.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_154 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_154_v128042022009"
      },
      "estleg:versionValidTo": {
        "@value": "2022-05-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
