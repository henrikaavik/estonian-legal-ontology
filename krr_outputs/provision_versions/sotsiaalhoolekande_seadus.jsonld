      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalse rehabilitatsiooni teenuse ülevõetava tasu maksimaalse suuruse ühes aastas ja tasu arvestamise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_58 (redaktsioon 130122015005)",
