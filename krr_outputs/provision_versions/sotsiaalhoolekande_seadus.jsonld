    },
    {
      "@id": "estleg:SOTSIA_Par_147_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_147"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rehabilitatsiooniteenuse osutamiseks peab olema tegevusluba. (2) Loakohustust ei ole Sotsiaalkindlustusametil.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_147 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 147",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_148_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_148"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rehabilitatsiooniteenuse osutaja tegevusloa taotluse lahendab Sotsiaalkindlustusamet. (2) Lisaks majandustegevuse seadustiku üldosa seaduses sätestatud andmetele esitatakse rehabilitatsiooniteenuse osutaja tegevusloa taotluses need käesoleva seaduse § 57 alusel valdkonna eest vastutava ministri määrusega kehtestatud loetelus nimetatud tegevused, mida rehabilitatsiooniteenuse osutaja rehabilitatsiooniteenuse raames osutab.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_148 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 148",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_149_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_149"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rehabilitatsiooniteenuse osutamiseks antakse tegevusluba, kui rehabilitatsiooniteenuse osutaja ja rehabilitatsioonimeeskond vastavad käesoleva seaduse § 66 punktides 1, 2 ja 4–7 ning §-s 68 sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_149 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_149_v126062018018"
      },
      "estleg:versionValidTo": {
        "@value": "2018-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 149",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_149_v126062018018",
