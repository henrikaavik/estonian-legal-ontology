      }
    },
    {
      "@id": "estleg:SOTSIA_Par_26_v875603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Puuetega isikutele teiste inimestega võrdsete võimaluste tagamiseks, nende aktiivseks osalemiseks ühiskonnaelus ja iseseisvaks toimetulekuks valla- või linnavalitsus: loob võimalused puudest tingitud takistuste vähendamiseks või kõrvaldamiseks ravi, õpetuse ja tõlketeenustega; loob koostöös pädevate riigiorganitega võimalused puuetega inimeste konkurentsivõimet tõstvaks kutseõpetuseks; sobitab koostöös pädevate riigiorganitega töökohti ja loob rakenduskeskusi; korraldab invatransporti; tagab puuetega inimestele juurdepääsu üldkasutatavatesse hoonetesse; määrab vajadusel tugiisiku või isikliku abistaja; korraldab eestkostet ning seab hoolduse. (2) Valla- või linnavalitsus korraldab abi vajava puudega isiku toimetuleku sotsiaalteenuste osutamise, sotsiaaltoetuste maksmise, vältimatu sotsiaalabi ja muu abi osutamise teel.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_26 (redaktsioon 875603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "875603",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_26_v13309750"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/875603",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 26",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_26_v13309750",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Puuetega isikutele teiste inimestega võrdsete võimaluste tagamiseks, nende aktiivseks osalemiseks ühiskonnaelus ja iseseisvaks toimetulekuks valla- või linnavalitsus: loob võimalused puudest tingitud takistuste vähendamiseks või kõrvaldamiseks ravi, õpetuse ja tõlketeenustega; loob koostöös pädevate riigiorganitega võimalused puuetega inimeste konkurentsivõimet tõstvaks kutseõpetuseks; sobitab koostöös pädevate riigiorganitega töökohti ja loob rakenduskeskusi; korraldab invatransporti; tagab puuetega inimestele juurdepääsu üldkasutatavatesse hoonetesse; määrab vajadusel tugiisiku või isikliku abistaja; selgitab välja eestkostjateks sobivad isikud, teostab nende tegevuse üle järelevalvet ning teavitab kohut nendepoolsest kohustuste rikkumisest ja eestkostetava olukorrast. (2) Valla- või linnavalitsus korraldab abi vajava puudega isiku toimetuleku sotsiaalteenuste osutamise, sotsiaaltoetuste maksmise, vältimatu sotsiaalabi ja muu abi osutamise teel.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_26 (redaktsioon 13309750)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13309750",
