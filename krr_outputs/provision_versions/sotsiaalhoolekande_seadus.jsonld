    },
    {
      "@id": "estleg:SOTSIA_Par_38_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sotsiaaltransporditeenus on kohaliku omavalitsuse üksuse korraldatav sotsiaalteenus, mille eesmärk on võimaldada puuetega inimeste sotsiaaltoetuste seaduse § 2 lõike 1 tähenduses puudega isikul, kellel puue takistab isikliku või ühissõiduki kasutamist, kasutada tema vajadustele vastavat transpordivahendit tööle või õppeasutusse sõitmiseks või avalike teenuste kasutamiseks. (2) võib kehtestada määrusega täpsustatud nõuded sotsiaaltransporditeenuse eesmärgile ja selle sisule, sealhulgas tegevustele, mis on vajalikud teenuse eesmärgi saavutamiseks.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_38 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 38",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_39_v22317",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei on kohustatud osutama vajaduse korral hoolekandetöötajale abi isiku eluruumi või muusse asupaika sisenemiseks isiku enda või teiste inimeste tervise kaitseks.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_39 (redaktsioon 22317)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22317",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_39_v130122015005"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22317",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 39",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_39_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenuseosutaja kehtestab ohutu töötamise korra ning tagab selle kättesaadavuse teenust kasutavale isikule ja teenust vahetult osutavale isikule.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_39 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 39",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_4_v22317",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sotsiaalteenuseid, sotsiaaltoetusi ja muud abi on õigus saada: Eesti alalisel elanikul; Eestis seaduslikul alusel elaval välismaalasel; Eestis viibival pagulasel. (2) Käesoleva seaduse §-s 231 sätestatud toetusele on õigus Eestis seaduslikul alusel viibival isikul, kes vastab nimetatud paragrahvis sätestatud tingimustele. (3) Vältimatut sotsiaalabi on õigus saada igal Eestis viibival isikul.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_4 (redaktsioon 22317)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22317",
      "estleg:supersededByVersion": {
