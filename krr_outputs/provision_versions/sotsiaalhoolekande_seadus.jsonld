    {
      "@id": "estleg:SOTSIA_Par_49_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abivahendi kandmisel abivahendite loetellu või abivahendite loetelust kustutamisel arvestatakse järgmisi kriteeriume: meditsiiniliselt põhjendatud näidustus abivahendi kasutamiseks ja alternatiivsete abivahendite olemasolu; vastavus riigieelarvest abivahendite ostmise ja üürimise kuludeks määratud rahalistele vahenditele; abivahendi kulutõhusus.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_49 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
      "estleg:sourceAct": "Sotsiaalhoolekande seadus",
      "estleg:provisionRef": "SOTSIA § 49",
      "estleg:partOfAct": {
        "@id": "estleg:SOTSIA_Map_2026"
      }
    },
    {
      "@id": "estleg:SOTSIA_Par_5_v22317",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
