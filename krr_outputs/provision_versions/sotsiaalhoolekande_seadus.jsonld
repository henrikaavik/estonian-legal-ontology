        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alaealise mõjutusvahendite seaduse § 3 lõike 1 punktis 8 ja lõike 2 punktis 1 asendatakse arv „111” arvuga „56”.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_161 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122015005",
