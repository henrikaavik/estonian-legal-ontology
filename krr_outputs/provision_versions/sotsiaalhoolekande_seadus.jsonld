    },
    {
      "@id": "estleg:SOTSIA_Par_145_v130122015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOTSIA_Par_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 142 lõigetes 2 ja 3 nimetatud sotsiaalteenuse osutajal on juurdepääs tema poolt registrisse sisestatud andmetele ja vastava sotsiaalteenuse osutaja juurde teenust saama suunatud või haldusorgani otsuse alusel läinud isiku järgmistele andmetele: isiku ees- ja perekonnanimi, isikukood, sünnikuupäev, surmakuupäev, sugu; isiku staatus rahvastikuregistris ja isiku rahvastikuregistrijärgne elukoht; haldusorgani sisestatavad andmed isikule määratud sotsiaalteenuse osutamise kohta.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_145 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOTSIA_Par_145_v121122016021"
      },
