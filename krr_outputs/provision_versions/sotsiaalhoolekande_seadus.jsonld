        "@type": "xsd:date"
      },
      "estleg:versionText": "Asenduskoduteenus on käesoleva seaduse §-s 15 3 nimetatud teenuse osutaja poolt lapsele tema põhivajaduste rahuldamiseks peresarnaste elutingimuste võimaldamine, talle turvalise ja arenguks soodsa elukeskkonna loomine ning lapse ettevalmistamine võimetekohaseks toimetulekuks täiskasvanuna.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_15_1 (redaktsioon 12760827)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12760827",
