      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laste hoolekandeasutuses elava lapse ajutiselt perekonda andmise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "SOTSIA_Par_126 (redaktsioon 130122015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015005",
      "estleg:supersededByVersion": {
