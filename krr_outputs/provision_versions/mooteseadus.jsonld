      }
    },
    {
      "@id": "estleg:MooteS_Par_38_v724846",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MooteS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse või selle alusel kehtestatud õigusaktidest tulenevate nõuete rikkumise lõpetamiseks või peatamiseks teeb riiklikku järelevalvet teostav ametiisik ettekirjutuse, milles: esitab nõude õigusrikkumise lõpetamiseks; vajaduse korral esitab nõude õigusrikkumisega seotud tegevuse osaliseks või täielikuks peatamiseks. (2) Käesoleva paragrahvi lõikes 1 sätestatud ettekirjutuse täitmata jätmise korral võib riiklikku järelevalvet teostav ametiisik rakendada sunniraha asendustäitmise ja sunniraha seaduses (RT I 2001, 50, 283; 94, 580) sätestatud korras. Sunniraha ülemmäär on 30 000 krooni.",
      "rdfs:label": {
        "@value": "MooteS_Par_38 (redaktsioon 724846)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "724846",
      "estleg:supersededByVersion": {
        "@id": "estleg:MooteS_Par_38_v12894945"
      },
      "estleg:versionValidTo": {
