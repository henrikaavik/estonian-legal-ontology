      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Liiklusohutusele avalduva mõju hindamise nõuded (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Liiklusohutusele avalduva mõju hindamise nõuded"
    },
    {
      "@id": "estleg:Reg_1029560_Par_1_v1029560",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029560_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Liiklusohutusele avalduva mõju hindamine on strateegiline võrdlev analüüs selle kohta, kuidas uus tee või olemasoleva teedevõrgu olulised muudatused avaldavad mõju liiklusohutusele. Liiklusohutusele avalduva mõju hindamine on strateegiline võrdlev analüüs selle kohta, kuidas uus tee või olemasoleva teedevõrgu olulised muudatused avaldavad mõju liiklusohutusele. 2 (2) Liiklusohutusele avalduva mõju hindamine on kohustuslik ehitusseadustiku § 102 lõikes 11 nimetatud teel, kui kavandatakse uue tee ehitamist või olemasoleva teedevõrgu muutmist, millega kaasneb oluline mõju liiklusvoole. Teedevõrgu muutmine ei ole lisaradade juurdeehitamine või ristmike ümberehitamine. RT I 2021-12-09 2 109122021002 2021-12-17 Liiklusohutusele avalduva mõju hindamine on kohustuslik ehitusseadustiku § 102 lõikes 11 nimetatud teel, kui kavandatakse uue tee ehitamist või olemasoleva teedevõrgu muutmist, millega kaasneb oluline mõju liiklusvoole. Teedevõrgu muutmine ei ole lisaradade juurdeehitamine või ristmike ümberehitamine.",
      "rdfs:label": {
        "@value": "Reg_1029560_Par_1 (redaktsioon 1029560)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029560",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029560",
