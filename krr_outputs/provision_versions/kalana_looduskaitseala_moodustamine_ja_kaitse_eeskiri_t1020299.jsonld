    {
      "@id": "estleg:Reg_1020299_Par_9_v1020299",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1020299_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kalana looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 3. märtsi 2010. a käskkirjaga nr 279 (seal on ala nimeks Kõpu6) algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Kalana looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 3. märtsi 2010. a käskkirjaga nr 279 (seal on ala nimeks Kõpu6) algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
