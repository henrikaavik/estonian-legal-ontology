      },
      "dc:source": "Suurte üleujutusaladega siseveekogude nimistu ja nendel siseveekogudel kõrgveepiiri määramise kord"
    },
    {
      "@id": "estleg:Reg_157788_Par_1_v157788",
      "@type": [
