    },
    {
      "@id": "estleg:Reg_157788_Par_2_v157788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157788_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Suurte üleujutusaladega siseveekogud on: 1) Ahja jõgi Lääniste sillast suudmeni (Tartumaa); 2) Elva jõgi Meeri peakraavist suudmeni (Tartumaa); 3) Halliste jõgi Tipu külast suudmeni (Viljandimaa, Pärnumaa); 4) Kargoja jõgi Lagimuse jõest Koosalaane külani (Tartumaa); 5) Kasari jõgi Teenuse jõe suubumiskohast suudmeni (Läänemaa); 6) Mullutu-Suurlaht kogu kalda ulatuses (Saaremaa); 7) Narva jõgi koos vanajõgedega Vasknarvast Karoli vanajõe suudmeni (Ida-Virumaa); 8) Nasva jõgi kogu ulatuses (Saaremaa); 9) Navesti jõgi Loopere sillast Tallinna–Viljandi maanteeni (Viljandimaa); 10) Pedja jõgi Utsali külast suudmeni (Jõgevamaa); 11) Raudna jõgi (Viljandimaa) järvest suudmeni (Viljandimaa, Pärnumaa); 12) Riksu laht kogu kalda ulatuses (Saaremaa); 13) Suur-Emajõgi koos vanajõgedega kogu ulatuses (Tartumaa, Viljandimaa); 14) Tänassilma jõgi Jõekülast suudmeni (Viljandimaa); 15) Võhandu jõgi Vagula järvest Kääpa külani ja Võõpsu sillast suudmeni (Võrumaa, Põlvamaa); 16) Väike-Emajõgi Alamõisa külast suudmeni (Valgamaa). Minister Villu REILJAN Kantsler Sulev VARE",
      "rdfs:label": {
        "@value": "Reg_157788_Par_2 (redaktsioon 157788)",
        "@language": "et"
      },
