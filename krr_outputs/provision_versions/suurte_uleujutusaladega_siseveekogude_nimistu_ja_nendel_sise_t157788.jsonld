      },
      "estleg:versionText": "Suurte üleujutusaladega siseveekogudel on kõrgveepiiriks alaliselt liigniiskete alluviaalsete soomuldade leviala piir veekogu veepiirist arvates.",
      "rdfs:label": {
        "@value": "Reg_157788_Par_1 (redaktsioon 157788)",
        "@language": "et"
      },
