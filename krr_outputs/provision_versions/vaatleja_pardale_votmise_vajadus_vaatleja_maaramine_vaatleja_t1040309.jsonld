      "estleg:provisionRef": "Reg_1040309 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040309_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040309_Par_12_v1040309",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040309_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõukogu määruse (EL) nr 2019/833 artikli 27 lõikest 3 lähtuvalt vähendatakse vaatlejatega kaetust NAFO reguleeritavas piirkonnas püüdvatel laevadel kuni 75% ajast, mil laev või laevad on kalendriaasta jooksul püügil NAFO reguleeritavas piirkonnas. Püügil viibimise aega mõõdetakse püügipäevades. RT I 2019-12-12 8 112122019008 2019-12-15 Nõukogu määruse (EL) nr 2019/833 artikli 27 lõikest 3 lähtuvalt vähendatakse vaatlejatega kaetust NAFO reguleeritavas piirkonnas püüdvatel laevadel kuni 75% ajast, mil laev või laevad on kalendriaasta jooksul püügil NAFO reguleeritavas piirkonnas. Püügil viibimise aega mõõdetakse püügipäevades.",
      "rdfs:label": {
        "@value": "Reg_1040309_Par_12 (redaktsioon 1040309)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040309",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040309",
      "estleg:sourceAct": "Vaatleja pardale võtmise vajadus, vaatleja määramine, vaatlejale esitatavad nõuded, vaatleja ülesanded ning kogutud andmete esitamise kord ja vorm",
      "estleg:provisionRef": "Reg_1040309 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040309_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040309_Par_13_v1040309",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040309_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vaatleja tegevuse ajavahemiku järgneval kalendriaastal määrab Keskkonnaamet koostöös Regionaal- ja Põllumajandusministeeriumiga ja ettevõtjaga, kes soovib taotleda järgnevaks kalendriaastaks kalapüügiluba NAFO reguleeritavas piirkonnas, prognoositava püügiplaani alusel, arvestades seejuures riikliku töökava vajadusi ja NAFO kaitse- ja rakendusmeetmete nõudeid. Vaatlejate määramisel tagatakse tasakaal eri liike ja eri piirkondades püüdvate kalalaevade vahel. RT I 2023-07-15 1 115072023001 2023-07-18 Vaatleja tegevuse ajavahemiku järgneval kalendriaastal määrab Keskkonnaamet koostöös Regionaal- ja Põllumajandusministeeriumiga ja ettevõtjaga, kes soovib taotleda järgnevaks kalendriaastaks kalapüügiluba NAFO reguleeritavas piirkonnas, prognoositava püügiplaani alusel, arvestades seejuures riikliku töökava vajadusi ja NAFO kaitse- ja rakendusmeetmete nõudeid. Vaatlejate määramisel tagatakse tasakaal eri liike ja eri piirkondades püüdvate kalalaevade vahel. 2 (2) Kehtetu - RT I 2019-12-12 8 112122019008 2019-12-15 Kehtetu - 3 (3) Vaatlejatega tegevuse vähendamisest teavitab Regionaal- ja Põllumajandusministeerium Euroopa Komisjoni enne püügireisi algust nii varakult kui võimalik Euroopa Parlamendi ja nõukogu määruse (EL) nr 2019/833 artikli 27 lõikes 3 sätestatu kohaselt. RT I 2023-07-15 1 115072023001 2023-07-18 Vaatlejatega tegevuse vähendamisest teavitab Regionaal- ja Põllumajandusministeerium Euroopa Komisjoni enne püügireisi algust nii varakult kui võimalik Euroopa Parlamendi ja nõukogu määruse (EL) nr 2019/833 artikli 27 lõikes 3 sätestatu kohaselt. 4 (4) Regionaal- ja Põllumajandusministeerium esitab Euroopa Komisjonile igal aasta enne seda, kui laevad alustavad kalapüüki NAFO reguleeritavas kalapüügipiirkonnas, ning seejärel viivitamata pärast iga uue vaatleja määramist nimekirja vaatlejatest, kes võivad NAFO reguleeritavas piirkonnas Eesti lipu all sõitvatel laevadel vaatleja ülesandeid täita. RT I 2023-07-15 1 115072023001 2023-07-18 Regionaal- ja Põllumajandusministeerium esitab Euroopa Komisjonile igal aasta enne seda, kui laevad alustavad kalapüüki NAFO reguleeritavas kalapüügipiirkonnas, ning seejärel viivitamata pärast iga uue vaatleja määramist nimekirja vaatlejatest, kes võivad NAFO reguleeritavas piirkonnas Eesti lipu all sõitvatel laevadel vaatleja ülesandeid täita.",
      "rdfs:label": {
        "@value": "Reg_1040309_Par_13 (redaktsioon 1040309)",
        "@language": "et"
      },
