      }
    },
    {
      "@id": "estleg:JAS_Par_34_v22476",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeolekuasutus võib edastada kogutud teavet välisriigi asutusele või rahvusvahelisele organisatsioonile, kui see on vajalik riigi julgeoleku tagamiseks või suurendamiseks rahvusvahelise lepingu alusel. Edastamine toimub kirjalikult, kui rahvusvahelises lepingus ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "JAS_Par_34 (redaktsioon 22476)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22476",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_34_v264880"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22476",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_34_v264880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeolekuasutus võib vahetada kogutud teavet välisriigi asutuse või rahvusvahelise organisatsiooniga, kui see on vajalik riigi julgeoleku tagamiseks või suurendamiseks rahvusvahelise lepingu alusel. Teabevahetus toimub kirjalikult, kui rahvusvahelises lepingus ei ole ette nähtud teisiti.",
      "rdfs:label": {
        "@value": "JAS_Par_34 (redaktsioon 264880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264880",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_34_v12793797"
      },
