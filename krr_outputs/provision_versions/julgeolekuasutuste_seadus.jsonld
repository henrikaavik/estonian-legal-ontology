      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/185043",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 27",
