    },
    {
      "@id": "estleg:JAS_Par_8_v127052022030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Julgeolekuasutuse teenistuskohtade piirarvu kehtestab (2) Käesoleva paragrahvi lõike 1 alusel kehtestatud piirarvu arvestades kehtestab valdkonna eest vastutav minister või tema volitatud julgeolekuasutuse juht julgeolekuasutuse teenistuskohtade koosseisu.",
      "rdfs:label": {
        "@value": "JAS_Par_8 (redaktsioon 127052022030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127052022030",
