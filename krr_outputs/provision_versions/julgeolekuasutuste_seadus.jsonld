      },
      "estleg:versionValidTo": {
        "@value": "2008-01-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/831373",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 27",
