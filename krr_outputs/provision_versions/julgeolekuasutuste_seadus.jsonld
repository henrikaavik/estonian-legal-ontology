    {
      "@id": "estleg:JAS_Par_14_v22476",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeolekuasutuse ametnikule ei kohaldata avaliku konkursi korras teenistusse võtmist.",
      "rdfs:label": {
        "@value": "JAS_Par_14 (redaktsioon 22476)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22476",
