        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22476",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_14_v126032013015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Julgeolekuasutuse ametniku ja töötajana võib teenistusse või tööle võtta vähemalt keskharidusega täieliku teovõimega Eesti Vabariigi kodaniku, kes valdab eesti keelt seaduses või seaduse alusel sätestatud ulatuses. (2) Teenistusse ja tööle julgeolekuasutusse on keelatud võtta isikut: kes saab pensioni, töötasu või muud regulaarset tasu riigilt, mis ei ole Euroopa Majanduspiirkonna liikmesriik või Šveits või mis ei kuulu Põhja-Atlandi Lepingu Organisatsiooni; kellel puudub vajaliku taseme riigisaladusele juurdepääsu luba või vajaliku taseme salastatud välisteabele juurdepääsu sertifikaat, kui see on ameti- või töökohal töötamise eelduseks. (3) Julgeolekuasutuse ametniku võib ametisse nimetada konkursita.",
      "rdfs:label": {
        "@value": "JAS_Par_14 (redaktsioon 126032013015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013015",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_14_v119032015009"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126032013015",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
