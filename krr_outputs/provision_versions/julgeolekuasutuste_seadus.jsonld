      }
    },
    {
      "@id": "estleg:JAS_Par_20_v126032013015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeolekuasutuse ametnik ja töötaja ei või: töötada teise tööandja juures, välja arvatud asutuse juhi kirjalikul nõusolekul; osaleda streigis; kuuluda erakonda.",
      "rdfs:label": {
        "@value": "JAS_Par_20 (redaktsioon 126032013015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013015",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126032013015",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 20",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_20_1_v126032013015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeolekuasutuse ametnikule võib anda põhjendatud juhul tasulist lisapuhkust kuni kümme kalendripäeva aastas.",
      "rdfs:label": {
        "@value": "JAS_Par_20_1 (redaktsioon 126032013015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013015",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_20_1_v119032015009"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126032013015",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 20_1",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_20_1_v119032015009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeolekuasutuse ametnikule võib anda põhjendatud juhul tasulist lisapuhkust kuni kümme kalendripäeva aastas. Sellise lisapuhkuse nõue aegub ühe aasta jooksul arvates selle teenistusaasta lõppemisest, mille eest lisapuhkust arvestatakse. Kasutamata ja aegumata lisapuhkusepäevi teenistusest vabastamisel rahas ei hüvitata.",
      "rdfs:label": {
        "@value": "JAS_Par_20_1 (redaktsioon 119032015009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015009",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_20_1_v127052022030"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032015009",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 20_1",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_20_1_v127052022030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Julgeolekuasutuse ametnikule võib anda põhjendatud juhul tasulist lisapuhkust kuni kümme kalendripäeva aastas. Sellise lisapuhkuse nõue aegub ühe aasta jooksul arvates selle teenistusaasta lõppemisest, mille eest lisapuhkust arvestatakse. Kasutamata ja aegumata lisapuhkusepäevi teenistusest vabastamisel rahas ei hüvitata. (2) Käesoleva paragrahvi lõikes 1 sätestatud lisapuhkuse andmise tingimused ja korra kehtestab julgeolekuasutuse juht või tema volitatud isik.",
      "rdfs:label": {
        "@value": "JAS_Par_20_1 (redaktsioon 127052022030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127052022030",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127052022030",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 20_1",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_20_2_v126032013015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_20_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeolekuasutus ei pea esitama andmeid avaliku teenistuse seaduse §-s 106 nimetatud andmekogusse. Julgeolekuasutus tagab oma ametnike ja töötajate kohta avaliku teenistuse seaduse § 106 lõikes 3 sätestatud andmete hoidmise.",
      "rdfs:label": {
        "@value": "JAS_Par_20_2 (redaktsioon 126032013015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013015",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126032013015",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 20_2",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_20_3_v126032013015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_20_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Julgeolekuasutuse ametnikule ja töötajale kauaaegse laitmatu töö või teenistus- või töökohustuste silmapaistvalt hea täitmise eest kohaldatavad ergutused on: tänu avaldamine; teenetemedali andmine; rahalise preemia andmine; hinnalise kingituse andmine; nimelise külm- või tulirelva andmine. (2) Korraga võib kohaldada mitut ergutust. (3) Ergutuse kohaldamise õigus on julgeolekuasutuse juhil ja asjaomasel ministril. Käesoleva paragrahvi lõike 1 punktides 2 ja 5 nimetatud ergutuse kohaldamise õigus on ainult asjaomasel ministril või Teabeameti peadirektoril. (4) Teenetemedali kirjelduse ning selle andmise ja kandmise korra (5) Silmapaistvate teenete eest võib käesoleva paragrahvi lõike 1 punktides 1, 2, 4 ja 5 sätestatud ergutusi kohaldada ka nendele isikutele, kes ei ole julgeolekuasutuse ametnikud või töötajad.",
      "rdfs:label": {
        "@value": "JAS_Par_20_3 (redaktsioon 126032013015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013015",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_20_3_v119032015009"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126032013015",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 20_3",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_20_3_v119032015009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_20_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Julgeolekuasutuse ametnikule ja töötajale kauaaegse laitmatu töö või teenistus- või töökohustuste silmapaistvalt hea täitmise eest kohaldatavad ergutused on: tänu avaldamine; teenetemedali andmine; rahalise preemia andmine; hinnalise kingituse andmine; nimelise külm- või tulirelva andmine. (2) Korraga võib kohaldada mitut ergutust. (3) Ergutuse kohaldamise õigus on julgeolekuasutuse juhil ja asjaomasel ministril. Käesoleva paragrahvi lõike 1 punktides 2 ja 5 nimetatud ergutuse kohaldamise õigus on ainult asjaomasel ministril või Teabeameti peadirektoril. (4) Teenetemedali kirjelduse ning selle andmise ja kandmise korra kehtestab määrusega. (5) Silmapaistvate teenete eest võib käesoleva paragrahvi lõike 1 punktides 1, 2, 4 ja 5 sätestatud ergutusi kohaldada ka nendele isikutele, kes ei ole julgeolekuasutuse ametnikud või töötajad.",
      "rdfs:label": {
        "@value": "JAS_Par_20_3 (redaktsioon 119032015009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015009",
