      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13247579",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_21_v129062012037",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitsepolitseiameti tegevusele kohaldatakse politsei ja piirivalve seaduse 22. peatükki käesolevast seadusest tulenevate erisustega. (2) Kaitsepolitseiameti politseiametnikul on oma ülesannete täitmisel õigus kohaldada politsei ja piirivalve seaduses sätestatud alustel ja korras järelevalve meedet ning vahetut sundi. (3) Politsei ja piirivalve seadusest tulenevat rakendades täidab Kaitsepolitseiameti peadirektor meetme üle otsustamisel ning sellega seotud toimingute tegemisel ning politsei ja piirivalve seaduse 22. peatüki kohaldamisel Politsei- ja Piirivalveameti peadirektori ülesandeid.",
      "rdfs:label": {
        "@value": "JAS_Par_21 (redaktsioon 129062012037)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062012037",
      "estleg:supersededByVersion": {
