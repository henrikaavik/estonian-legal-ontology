      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeolekuasutuste poolt teabe varjatud kogumisel kasutatavad meetodid ja vahendid määrab kindlaks asjaomane minister määrusega. Määrus esitatakse teadmiseks Riigikogu julgeolekuasutuste järelevalve komisjonile.",
      "rdfs:label": {
        "@value": "JAS_Par_28 (redaktsioon 22476)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22476",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_28_v910997"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22476",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_28_v910997",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": ". Määrus esitatakse teadmiseks Riigikogu julgeolekuasutuste järelevalve komisjonile.",
      "rdfs:label": {
        "@value": "JAS_Par_28 (redaktsioon 910997)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "910997",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_28_v13247579"
