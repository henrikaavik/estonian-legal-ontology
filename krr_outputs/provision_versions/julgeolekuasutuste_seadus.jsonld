      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/910997",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 33",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_33_v12793797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eriside korraldamiseks ja kontrollimiseks kasutatavad meetodid ja vahendid määrab kindlaks kaitseminister määrusega. Määrus esitatakse teadmiseks Riigikogu julgeolekuasutuste järelevalve komisjonile. Määruse ärakiri esitatakse õiguskantslerile õiguskantsleri seaduse §-s 16 ettenähtud korras.",
      "rdfs:label": {
        "@value": "JAS_Par_33 (redaktsioon 12793797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12793797",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_33_v114032014033"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12793797",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 33",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_33_v114032014033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eriside korraldamiseks ja kontrollimiseks kasutatavad meetodid ja vahendid määrab kindlaks valdkonna eest vastutav minister määrusega. Määrus esitatakse teadmiseks Riigikogu julgeolekuasutuste järelevalve komisjonile. Määruse ärakiri esitatakse õiguskantslerile õiguskantsleri seaduse §-s 16 ettenähtud korras.",
      "rdfs:label": {
        "@value": "JAS_Par_33 (redaktsioon 114032014033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014033",
      "estleg:supersededByVersion": {
        "@id": "estleg:JAS_Par_33_v119032015009"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032014033",
      "estleg:sourceAct": "Julgeolekuasutuste seadus",
      "estleg:provisionRef": "JAS § 33",
      "estleg:partOfAct": {
        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_33_v119032015009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eriside nõuded kehtestab määrusega. Määrus esitatakse teadmiseks Riigikogu julgeolekuasutuste järelevalve komisjonile.",
      "rdfs:label": {
