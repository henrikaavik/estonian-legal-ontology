        "@id": "estleg:JAS_Map"
      }
    },
    {
      "@id": "estleg:JAS_Par_30_v119032015009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JAS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-des 25 või 26 sätestatud viisil kogutud teavet säilitatakse teabetoimikutes. Teabetoimik avatakse iga juhtumi kohta eraldi. Toimiku pidamise ja säilitamise korra kehtestab Siseministeeriumi või Kaitseministeeriumi määrusega.",
      "rdfs:label": {
        "@value": "JAS_Par_30 (redaktsioon 119032015009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032015009",
