        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Julgeolekuasutused teevad üksteisega koostööd vastastikuse abistamise ja teabevahetuse kaudu. (2) Julgeolekuasutuste teabevahetus toimub riigi teabehanke eelistuskava alusel.",
      "rdfs:label": {
        "@value": "JAS_Par_11 (redaktsioon 22476)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22476",
