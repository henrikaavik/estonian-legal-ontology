      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Metsküla matmispaiga lähikonnas paikneva elamu tarbeks puurkaevu rajamise toetus (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Metsküla matmispaiga lähikonnas paikneva elamu tarbeks puurkaevu rajamise toetus"
    },
    {
      "@id": "estleg:Reg_1063033_Par_1_v1063033",
      "@type": [
        "owl:NamedIndividual",
