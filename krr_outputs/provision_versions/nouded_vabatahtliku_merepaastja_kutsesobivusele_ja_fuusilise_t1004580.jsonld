      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded vabatahtliku merepäästja kutsesobivusele ja füüsilisele ettevalmistusele, tervisenõuetele vastavuse kontrollimise korrale, välja- ja täiendusõppele, tunnistusele ning eritunnusele ja selle kandmise korrale (19 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded vabatahtliku merepäästja kutsesobivusele ja füüsilisele ettevalmistusele, tervisenõuetele vastavuse kontrollimise korrale, välja- ja täiendusõppele, tunnistusele ning eritunnusele ja selle kandmise korrale"
    },
    {
      "@id": "estleg:Reg_1004580_Par_1_v1004580",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
