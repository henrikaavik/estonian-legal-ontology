      }
    },
    {
      "@id": "estleg:Reg_1004580_Par_8_9_v1004580",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1004580_Par_8_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabatahtliku merepäästja väljaõppel arvestatakse vabatahtliku merepäästja ja vabatahtlikuks merepäästjaks saada soovija varasema õpi- ja töökogemusega. Varasema õpi- ja töökogemuse hindamise tulemuste põhjal võib Politsei- ja Piirivalveamet mittetulundusühingu ettepanekul suunata selle isiku otse arvestuse tegemisele või lugeda tema väljaõppe läbituks. RT I 2020-08-28 7 128082020007 2020-08-31 Vabatahtliku merepäästja väljaõppel arvestatakse vabatahtliku merepäästja ja vabatahtlikuks merepäästjaks saada soovija varasema õpi- ja töökogemusega. Varasema õpi- ja töökogemuse hindamise tulemuste põhjal võib Politsei- ja Piirivalveamet mittetulundusühingu ettepanekul suunata selle isiku otse arvestuse tegemisele või lugeda tema väljaõppe läbituks.",
      "rdfs:label": {
        "@value": "Reg_1004580_Par_8_9 (redaktsioon 1004580)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1004580",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1004580",
      "estleg:sourceAct": "Nõuded vabatahtliku merepäästja kutsesobivusele ja füüsilisele ettevalmistusele, tervisenõuetele vastavuse kontrollimise korrale, välja- ja täiendusõppele, tunnistusele ning eritunnusele ja selle kandmise korrale",
      "estleg:provisionRef": "Reg_1004580 § 8_9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1004580_Map"
      }
    },
    {
      "@id": "estleg:Reg_1004580_Par_9_v1004580",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1004580_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolituse korraldaja on kohustatud andma vabatahtliku merepäästja esimese ja teise astme õppe ning täiendusõppe läbinule tõendi vastava õppe läbimise kohta. Koolituse korraldaja on kohustatud andma vabatahtliku merepäästja esimese ja teise astme õppe ning täiendusõppe läbinule tõendi vastava õppe läbimise kohta. 2 (2) Esimese ja teise astme õpe ning täiendusõpe loetakse läbinuks pärast arvestuse sooritamist. Esimese ja teise astme õpe ning täiendusõpe loetakse läbinuks pärast arvestuse sooritamist. 3 (3) Arvestuse sooritamisel on positiivne tulemus „arvestatud” ja negatiivne tulemus „mittearvestatud”. Arvestuse sooritamisel on positiivne tulemus „arvestatud” ja negatiivne tulemus „mittearvestatud”. 4 (4) Esimese ja teise astme ning täiendusõppe arvestuse negatiivsele tulemusele sooritamise korral on vastava õppe läbinud isikul õigus kahele kordusarvestusele. Esimese ja teise astme ning täiendusõppe arvestuse negatiivsele tulemusele sooritamise korral on vastava õppe läbinud isikul õigus kahele kordusarvestusele. 5 (5) Arvestuse sooritamise juures viibib Politsei- ja Piirivalveameti esindaja. RT I 2020-08-28 7 128082020007 2020-08-31 Arvestuse sooritamise juures viibib Politsei- ja Piirivalveameti esindaja.",
      "rdfs:label": {
        "@value": "Reg_1004580_Par_9 (redaktsioon 1004580)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1004580",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1004580",
      "estleg:sourceAct": "Nõuded vabatahtliku merepäästja kutsesobivusele ja füüsilisele ettevalmistusele, tervisenõuetele vastavuse kontrollimise korrale, välja- ja täiendusõppele, tunnistusele ning eritunnusele ja selle kandmise korrale",
      "estleg:provisionRef": "Reg_1004580 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1004580_Map"
      }
    },
