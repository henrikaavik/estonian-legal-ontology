      "estleg:provisionRef": "Reg_1004580 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1004580_Map"
      }
    },
    {
      "@id": "estleg:Reg_1004580_Par_10_12_v1004580",
