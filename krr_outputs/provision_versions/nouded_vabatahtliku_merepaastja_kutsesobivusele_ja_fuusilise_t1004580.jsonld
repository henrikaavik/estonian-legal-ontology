      }
    },
    {
      "@id": "estleg:Reg_1004580_Par_2_v1004580",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1004580_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabatahtlik merepäästja peab isikuomaduste poolest olema võimeline täitma vabatahtlikule merepäästjale pandud ülesandeid ning vastama järgmistele nõuetele: 1 1) olema lojaalne Eesti Vabariigile, aus ja seaduskuulekas; 2 2) võimeline töötama stabiilselt ja tulemuslikult pingeolukorras ning oskama teha meeskonnatööd; 3 3) kohusetundlik, otsustus- ja vastutusvõimeline, suudab iseseisvalt langetada otsuseid oma pädevuse piires ning on võimeline ette nägema oma otsuse tagajärgi ning vastutama nende eest; 4 4) hea analüüsi- ja sünteesivõimega, oskab eristada olulist ebaolulisest ning suudab lahendada probleeme; 5 5) hea suhtlemisoskusega. Vabatahtlik merepäästja peab isikuomaduste poolest olema võimeline täitma vabatahtlikule merepäästjale pandud ülesandeid ning vastama järgmistele nõuetele: olema lojaalne Eesti Vabariigile, aus ja seaduskuulekas; võimeline töötama stabiilselt ja tulemuslikult pingeolukorras ning oskama teha meeskonnatööd; kohusetundlik, otsustus- ja vastutusvõimeline, suudab iseseisvalt langetada otsuseid oma pädevuse piires ning on võimeline ette nägema oma otsuse tagajärgi ning vastutama nende eest; hea analüüsi- ja sünteesivõimega, oskab eristada olulist ebaolulisest ning suudab lahendada probleeme; hea suhtlemisoskusega.",
      "rdfs:label": {
        "@value": "Reg_1004580_Par_2 (redaktsioon 1004580)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1004580",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1004580",
      "estleg:sourceAct": "Nõuded vabatahtliku merepäästja kutsesobivusele ja füüsilisele ettevalmistusele, tervisenõuetele vastavuse kontrollimise korrale, välja- ja täiendusõppele, tunnistusele ning eritunnusele ja selle kandmise korrale",
      "estleg:provisionRef": "Reg_1004580 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1004580_Map"
      }
    },
    {
      "@id": "estleg:Reg_1004580_Par_3_v1004580",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1004580_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vabatahtlik merepäästja peab kehalise ettevalmistuse poolest olema võimeline täitma vabatahtlikule merepäästjale pandud ülesandeid ning täitma füüsiliste katsete normatiivi. Vabatahtlik merepäästja peab kehalise ettevalmistuse poolest olema võimeline täitma vabatahtlikule merepäästjale pandud ülesandeid ning täitma füüsiliste katsete normatiivi. 2 (2) Vabatahtliku merepäästja füüsiliste katsete normatiiv on ujumine 500 m vabalt valitud stiilis. Vabatahtliku merepäästja füüsiliste katsete normatiiv on ujumine 500 m vabalt valitud stiilis.",
      "rdfs:label": {
        "@value": "Reg_1004580_Par_3 (redaktsioon 1004580)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1004580",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1004580",
      "estleg:sourceAct": "Nõuded vabatahtliku merepäästja kutsesobivusele ja füüsilisele ettevalmistusele, tervisenõuetele vastavuse kontrollimise korrale, välja- ja täiendusõppele, tunnistusele ning eritunnusele ja selle kandmise korrale",
      "estleg:provisionRef": "Reg_1004580 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1004580_Map"
      }
    },
