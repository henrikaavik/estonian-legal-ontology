      "estleg:versionValidFrom": {
        "@value": "2022-05-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega sätestatakse vabatahtliku merepäästja kutsesobivuse ja füüsilise ettevalmistuse nõuded, vabatahtliku merepäästja väljaõppe ja täiendusõppe nõuded, õppe korraldamise ning arvestuse sooritamise kord, vabatahtliku merepäästja tunnistuse väljastamiseks esitatavate vajalike andmete loetelu, andmete säilitamise tähtaeg ja tunnistuse kirjeldus ning eritunnuse kirjeldus ja kandmise kord. RT I 2020-08-28 7 128082020007 2020-08-31 Käesoleva määrusega sätestatakse vabatahtliku merepäästja kutsesobivuse ja füüsilise ettevalmistuse nõuded, vabatahtliku merepäästja väljaõppe ja täiendusõppe nõuded, õppe korraldamise ning arvestuse sooritamise kord, vabatahtliku merepäästja tunnistuse väljastamiseks esitatavate vajalike andmete loetelu, andmete säilitamise tähtaeg ja tunnistuse kirjeldus ning eritunnuse kirjeldus ja kandmise kord.",
      "rdfs:label": {
        "@value": "Reg_1004580_Par_1 (redaktsioon 1004580)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1004580",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1004580",
      "estleg:sourceAct": "Nõuded vabatahtliku merepäästja kutsesobivusele ja füüsilisele ettevalmistusele, tervisenõuetele vastavuse kontrollimise korrale, välja- ja täiendusõppele, tunnistusele ning eritunnusele ja selle kandmise korrale",
      "estleg:provisionRef": "Reg_1004580 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1004580_Map"
      }
    },
    {
      "@id": "estleg:Reg_1004580_Par_10_v1004580",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1004580_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mittetulundusühing või vabatahtlikuks merepäästjaks saada soovija esitab Politsei- ja Piirivalveametile vabatahtliku merepäästja tunnistuse (edaspidi tunnistus) väljastamiseks järgmised andmed: RT I 2020-08-28 7 128082020007 2020-08-31 1 1) ees- ja perekonnanimi; 2 2) isikukood; 3 3) foto mõõtmetega 4 × 5 cm või vabatahtlikuks merepäästjaks saada soovija nõusolek kasutada tema fotot, mis on isikut tõendavate dokumentide andmekogus; RT I 2020-08-28 7 128082020007 2020-08-31 4 4) tervisetõend; 5 5) kinnitus väljaõppe läbimise kohta. Mittetulundusühing või vabatahtlikuks merepäästjaks saada soovija esitab Politsei- ja Piirivalveametile vabatahtliku merepäästja tunnistuse (edaspidi tunnistus) väljastamiseks järgmised andmed: ees- ja perekonnanimi; isikukood; foto mõõtmetega 4 × 5 cm või vabatahtlikuks merepäästjaks saada soovija nõusolek kasutada tema fotot, mis on isikut tõendavate dokumentide andmekogus; tervisetõend; kinnitus väljaõppe läbimise kohta.",
      "rdfs:label": {
