      },
      "estleg:versionValidTo": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELURUU_Par_15_2_v1027885",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
