      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded elektroonilise isikutuvastamise ja digitaalse allkirjastamise tagamisel (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded elektroonilise isikutuvastamise ja digitaalse allkirjastamise tagamisel"
    },
    {
      "@id": "estleg:Reg_1045851_Par_1_v1045851",
      "@type": [
