  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_nende_taimeliikide_loetelu_mille_kaitsealuse_sordi_seemet_ja_t302935_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nende taimeliikide loetelu, mille kaitsealuse sordi seemet ja paljundusmaterjali võib väikeses mahus kasvatada (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nende taimeliikide loetelu, mille kaitsealuse sordi seemet ja paljundusmaterjali võib väikeses mahus kasvatada"
    },
    {
      "@id": "estleg:Reg_302935_Par_1_v302935",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302935_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse nende taimeliikide loetelu, mille kaitsealuse sordi seemet ja paljundusmaterjali, välja arvatud hübriidsordi ja sünteetilise sordi seemet ja paljundusmaterjali võib ettevõtja väikeses mahus kasvatada põllumajandussaaduse saamiseks ja seda sel eesmärgil toota kasutamiseks oma ettevõttes ilma litsentsilepingut sõlmimata ja litsentsitasu maksmata.",
      "rdfs:label": {
        "@value": "Reg_302935_Par_1 (redaktsioon 302935)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302935",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302935",
      "estleg:sourceAct": "Nende taimeliikide loetelu, mille kaitsealuse sordi seemet ja paljundusmaterjali võib väikeses mahus kasvatada",
      "estleg:provisionRef": "Reg_302935 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302935_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_302935_Par_2_v302935",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302935_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väikeses mahus võib toota järgmiste söödakultuuride liikide kaitsealuse sordi seemet: 1) Cicer arietinum L. – kikerhernes; 2) Lupinus luteus L. – kollane lupiin; 3) Medicago sativa L. – harilik lutsern; 4) Pisum sativum L. (partim) – põldhernes; 5) Vicia faba L. (partim) – põlduba; 6) Vicia sativa L. – suvivikk. (2) Väikeses mahus võib toota järgmiste õli- ja kiukultuuride liikide kaitsealuse sordi seemet: 1) Brassica napus L. (partim) – raps; 2) Brassica rapa L. var. silvestris (Lam.) Briggs – rüps; 3) Linum usitatissimum L. – harilik lina. (3) Väikeses mahus võib toota järgmiste teraviljaliikide kaitsealuse sordi seemet: 1) Avena sativa L. – harilik kaer; 2) Hordeum vulgare L. – harilik oder; 3) Secale cereale L. – harilik rukis; 4) xTriticosecale Wittm. – tritikale; 5) Triticum aestivum L. emend. Fiori et Paol. – harilik nisu. (4) Väikeses mahus võib toota kartuli (Solanum tuberosum L.) kaitsealuse sordi paljundusmaterjali.",
      "rdfs:label": {
        "@value": "Reg_302935_Par_2 (redaktsioon 302935)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302935",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302935",
      "estleg:sourceAct": "Nende taimeliikide loetelu, mille kaitsealuse sordi seemet ja paljundusmaterjali võib väikeses mahus kasvatada",
      "estleg:provisionRef": "Reg_302935 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302935_Map_2026"
      }
    },
    {
