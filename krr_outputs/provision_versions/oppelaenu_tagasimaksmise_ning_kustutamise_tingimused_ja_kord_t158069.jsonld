      "estleg:sourceAct": "Õppelaenu tagasimaksmise ning kustutamise tingimused ja kord",
      "estleg:provisionRef": "Reg_158069 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158069_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158069_Par_5_v158069",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158069_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-09-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi- ja kohaliku omavalitsuse asutused ning avalik-õiguslikud juriidilised isikud peavad arvestust oma teenistujate või töötajate kohta, kellel on seadusest tulenevalt õigus õppelaenu kustutamisele riigieelarve vahenditest. Riigi- ja kohaliku omavalitsuse asutused ning avalik-õiguslikud juriidilised isikud peavad arvestust oma teenistujate või töötajate kohta, kellel on seadusest tulenevalt õigus õppelaenu kustutamisele riigieelarve vahenditest.",
      "rdfs:label": {
        "@value": "Reg_158069_Par_5 (redaktsioon 158069)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158069",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158069",
      "estleg:sourceAct": "Õppelaenu tagasimaksmise ning kustutamise tingimused ja kord",
      "estleg:provisionRef": "Reg_158069 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158069_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158069_Par_6_v158069",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158069_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-09-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigieelarve koostamiseks esitavad riigiasutused, avalik-õiguslikud juriidilised isikud ning valla- ja linnavalitsused taotlused oma teenistujate või töötajate õppelaenude kustutamiseks Rahandusministeeriumile kooskõlas «Riigieelarve seaduse» § 10 lõike 7 alusel kehtestatava rahandusministri määrusega. Riigieelarve koostamiseks esitavad riigiasutused, avalik-õiguslikud juriidilised isikud ning valla- ja linnavalitsused taotlused oma teenistujate või töötajate õppelaenude kustutamiseks Rahandusministeeriumile kooskõlas «Riigieelarve seaduse» § 10 lõike 7 alusel kehtestatava rahandusministri määrusega. 2 (2) Õppelaenude kustutamiseks ettenähtud vahendid kantakse üle vastavalt «Riigieelarve seaduse» § 32 lõike 1 alusel kehtestatud rahandusministri määrusele. Õppelaenude kustutamiseks ettenähtud vahendid kantakse üle vastavalt «Riigieelarve seaduse» § 32 lõike 1 alusel kehtestatud rahandusministri määrusele.",
      "rdfs:label": {
        "@value": "Reg_158069_Par_6 (redaktsioon 158069)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158069",
