      }
    },
    {
      "@id": "estleg:Reg_156089_Par_3_v156089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156089_Par_3"
