      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "§ 48.",
      "rdfs:label": {
        "@value": "Reg_156089_Par_48 (redaktsioon 156089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156089",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156089",
      "estleg:sourceAct": "Noteerimisnõuded",
