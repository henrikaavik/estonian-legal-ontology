    {
      "@id": "estleg:Reg_156089_Par_6_v156089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156089_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlus väärtpaberite noteerimiseks peab hõlmama kõiki emiteeritud sama liiki väärtpabereid. Taotlus väärtpaberite noteerimiseks peab hõlmama kõiki emiteeritud sama liiki väärtpabereid. 2 (2) Lõikes 1 nimetatud nõuet võib mitte kohaldada üksnes juhul, kui taotlusega mittehõlmatud aktsiaid hoitakse säilitamaks emitendis kontrollosalust või kui need ei ole teatud ajal vabalt võõrandatavad, ja tingimusel, et avalikkust on sellest piisavalt teavitatud ja selline noteerimine ei kahjusta tulevaste investorite huve. Lõikes 1 nimetatud nõuet võib mitte kohaldada üksnes juhul, kui taotlusega mittehõlmatud aktsiaid hoitakse säilitamaks emitendis kontrollosalust või kui need ei ole teatud ajal vabalt võõrandatavad, ja tingimusel, et avalikkust on sellest piisavalt teavitatud ja selline noteerimine ei kahjusta tulevaste investorite huve.",
      "rdfs:label": {
        "@value": "Reg_156089_Par_6 (redaktsioon 156089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156089",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156089",
      "estleg:sourceAct": "Noteerimisnõuded",
      "estleg:provisionRef": "Reg_156089 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156089_Map"
      }
    },
    {
      "@id": "estleg:Reg_156089_Par_7_v156089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156089_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui väärtpaberite noteerimisele eelneb nende avalik pakkumine seaduse tähenduses, võib väärtpabereid noteerida üksnes pärast pakkumise tähtaja möödumist. Kui väärtpaberite noteerimisele eelneb nende avalik pakkumine seaduse tähenduses, võib väärtpabereid noteerida üksnes pärast pakkumise tähtaja möödumist. 2 (2) Lõikes 1 nimetatud nõuet ei kohaldata kestvalt emiteeritavate väärtpaberite pakkumistele, mille pakkumise lõppkuupäev ei ole teada (edaspidi kestvuspakkumine). Lõikes 1 nimetatud nõuet ei kohaldata kestvalt emiteeritavate väärtpaberite pakkumistele, mille pakkumise lõppkuupäev ei ole teada (edaspidi kestvuspakkumine).",
      "rdfs:label": {
        "@value": "Reg_156089_Par_7 (redaktsioon 156089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156089",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156089",
      "estleg:sourceAct": "Noteerimisnõuded",
      "estleg:provisionRef": "Reg_156089 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156089_Map"
      }
    },
    {
      "@id": "estleg:Reg_156089_Par_70_v156089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
