    {
      "@id": "estleg:Reg_1047573_Par_3_v1047573",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047573_Par_3"
