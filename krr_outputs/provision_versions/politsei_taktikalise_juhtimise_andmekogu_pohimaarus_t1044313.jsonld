    },
    {
      "@id": "estleg:Reg_1044313_Par_18_v1044313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044313_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu kasutamise õiguspärasust kontrollitakse tarkvaraga ja organisatsiooniliste meetmetega. Iga andmekogusse tehtud päringu või kande kohta säilitatakse vähemalt järgmised logiandmed: 1 1) kasutaja ees- ja perekonnanimi ning isikukood; 2 2) kuupäev ja kellaaeg; 3 3) toimingu liik. Andmekogu kasutamise õiguspärasust kontrollitakse tarkvaraga ja organisatsiooniliste meetmetega. Iga andmekogusse tehtud päringu või kande kohta säilitatakse vähemalt järgmised logiandmed: kasutaja ees- ja perekonnanimi ning isikukood; kuupäev ja kellaaeg; toimingu liik. 2 (2) Logiandmeid säilitatakse 10 aastat päringu või kande tegemisest arvates. Logiandmeid säilitatakse 10 aastat päringu või kande tegemisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1044313_Par_18 (redaktsioon 1044313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044313",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044313",
      "estleg:sourceAct": "Politsei taktikalise juhtimise andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1044313 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044313_Map"
      }
    },
    {
      "@id": "estleg:Reg_1044313_Par_19_v1044313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044313_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu pidamise kulud kaetakse vastutavale töötlejale ja andmekogu majutajale riigieelarvest selleks eraldatud rahast. Andmekogu pidamise kulud kaetakse vastutavale töötlejale ja andmekogu majutajale riigieelarvest selleks eraldatud rahast.",
      "rdfs:label": {
        "@value": "Reg_1044313_Par_19 (redaktsioon 1044313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044313",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044313",
      "estleg:sourceAct": "Politsei taktikalise juhtimise andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1044313 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044313_Map"
