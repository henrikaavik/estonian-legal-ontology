        "@value": "2025-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet andmekogu pidamise üle tehakse avaliku teabe seaduse ja isikuandmete kaitset reguleerivate õigusaktide kohaselt. Järelevalvet andmekogu pidamise üle tehakse avaliku teabe seaduse ja isikuandmete kaitset reguleerivate õigusaktide kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1044313_Par_17 (redaktsioon 1044313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044313",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044313",
      "estleg:sourceAct": "Politsei taktikalise juhtimise andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1044313 § 17",
