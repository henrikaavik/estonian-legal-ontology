      }
    },
    {
      "@id": "estleg:Reg_1044313_Par_15_v1044313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044313_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastutav töötleja: 1 1) tagab andmekogu pidamise õigusaktides sätestatud nõuete kohaselt; 2 2) rakendab koos volitatud töötlejaga andmekogus sisalduvate andmete käideldavuse, tervikluse ja konfidentsiaalsuse tagamiseks organisatsioonilisi, füüsilisi ja infotehnoloogilisi turvameetmeid; 3 3) vastutab isikuandmete nõuetekohase töötlemise eest; 4 4) tagab õigustatud isikutele juurdepääsu andmekogule; 5 5) vastutab andmekogu andmete nõuetekohase väljastamise eest; 6 6) korraldab andmekogu arendamist. Vastutav töötleja: tagab andmekogu pidamise õigusaktides sätestatud nõuete kohaselt; rakendab koos volitatud töötlejaga andmekogus sisalduvate andmete käideldavuse, tervikluse ja konfidentsiaalsuse tagamiseks organisatsioonilisi, füüsilisi ja infotehnoloogilisi turvameetmeid; vastutab isikuandmete nõuetekohase töötlemise eest; tagab õigustatud isikutele juurdepääsu andmekogule; vastutab andmekogu andmete nõuetekohase väljastamise eest; korraldab andmekogu arendamist.",
      "rdfs:label": {
        "@value": "Reg_1044313_Par_15 (redaktsioon 1044313)",
        "@language": "et"
      },
