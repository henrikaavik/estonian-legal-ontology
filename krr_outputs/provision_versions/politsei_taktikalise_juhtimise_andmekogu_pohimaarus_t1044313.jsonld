    },
    {
      "@id": "estleg:Reg_1044313_Par_2_v1044313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044313_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu vastutav töötleja on Politsei- ja Piirivalveamet (edaspidi vastutav töötleja). Andmekogu vastutav töötleja on Politsei- ja Piirivalveamet (edaspidi vastutav töötleja). 2 (2) Andmekogu volitatud töötlejad (edaspidi volitatud töötleja) on: 1 1) Maksu- ja Tolliamet; 2 2) julgeolekuasutus; 3 3) Kaitsevägi; Andmekogu volitatud töötlejad (edaspidi volitatud töötleja) on: Maksu- ja Tolliamet; julgeolekuasutus; Kaitsevägi; 3 (3) Andmekogu volitatud töötleja andmekogu arendamisel ja majutamisel on Siseministeeriumi infotehnoloogia- ja arenduskeskus. Andmekogu volitatud töötleja andmekogu arendamisel ja majutamisel on Siseministeeriumi infotehnoloogia- ja arenduskeskus.",
      "rdfs:label": {
        "@value": "Reg_1044313_Par_2 (redaktsioon 1044313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044313",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044313",
      "estleg:sourceAct": "Politsei taktikalise juhtimise andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1044313 § 2",
      "estleg:partOfAct": {
