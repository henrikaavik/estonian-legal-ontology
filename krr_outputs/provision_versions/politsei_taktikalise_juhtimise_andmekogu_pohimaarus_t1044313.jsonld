      }
    },
    {
      "@id": "estleg:Reg_1044313_Par_14_v1044313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044313_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vastutav töötleja võib õigusaktis ette nähtud juhtudel väljastada andmekogu andmeid kasutamiseks statistilistel eesmärkidel. Vastutav töötleja võib õigusaktis ette nähtud juhtudel väljastada andmekogu andmeid kasutamiseks statistilistel eesmärkidel. 2 (2) Andmed esitatakse kujul, mis ei võimalda isikuid tuvastada. Andmed esitatakse kujul, mis ei võimalda isikuid tuvastada.",
      "rdfs:label": {
        "@value": "Reg_1044313_Par_14 (redaktsioon 1044313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044313",
