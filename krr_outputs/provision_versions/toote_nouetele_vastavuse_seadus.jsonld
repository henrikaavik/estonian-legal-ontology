    {
      "@id": "estleg:TNV_Par_50_v120112024008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TNV_Par_50"
