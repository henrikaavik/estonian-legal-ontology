      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud , mis on ÜRO Peaassamblee poolt vastu võetud 1999. aasta 9. detsembril ning millele Eesti Vabariik on alla kirjutanud 2000. aasta 6. septembril.",
      "rdfs:label": {
        "@value": "TRTRKR_Par_1 (redaktsioon 94699)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "94699",
