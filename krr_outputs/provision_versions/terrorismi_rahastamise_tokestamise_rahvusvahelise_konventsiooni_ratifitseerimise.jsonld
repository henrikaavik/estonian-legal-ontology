        "@value": "Sätete redaktsioonid: Terrorismi rahastamise tõkestamise rahvusvahelise konventsiooni ratifitseerimise seadus (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Terrorismi rahastamise tõkestamise rahvusvahelise konventsiooni ratifitseerimise seadus"
    },
    {
      "@id": "estleg:TRTRKR_Par_1_v94699",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
