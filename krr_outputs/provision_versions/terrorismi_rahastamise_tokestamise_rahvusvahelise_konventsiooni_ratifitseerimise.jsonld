        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/94699",
      "estleg:sourceAct": "Terrorismi rahastamise tõkestamise rahvusvahelise konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "TRTRKR § 2",
