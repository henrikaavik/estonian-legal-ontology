      }
    },
    {
      "@id": "estleg:Reg_163512_Par_42_62_v163512",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163512_Par_42_62"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastuvõtuandmete alamregistrisse kantakse järgmised andmed: 1 1) õppeasutuses vastuvõtuks avatud õppekava andmed; 2 2) õppeasutuses vabade vastuvõetavate kohtade arv, vajaduse korral info, kui õppekoht on tasuline; 3 3) õppeasutuse vastuvõtutingimused; 4 4) kandidaadi üldandmed: isikukood või sünniaeg, ees- ja perekonnanimi ning kontaktandmed; 5 5) alaealise kandidaadi eestkostja või esindaja andmed: isikukood või sünniaeg, kodakondsus, ees- ja perekonnanimi ning kontaktandmed; 6 6) vastuvõttu korraldava õppeasutuse vastuvõtutingimuste täitmiseks esitatav info kandidaadi kohta; 7 7) kandidaadi või esindaja tahteavaldus(ed), sealhulgas andmed õppeasutuse ning õppekava kohta, kuhu vastuvõttu taotletakse, ja õppekoha vastuvõtu kinnitus; 8 8) vastuvõtutingimuste täitmise tulemused, millest moodustub pingerida; 9 9) õppeasutuse vastus kandidaadi avaldusele; 10 10) muud vastuvõtu protsessis vajalikud andmed. RT I 2025-09-09 3 109092025003 2025-09-12 Vastuvõtuandmete alamregistrisse kantakse järgmised andmed: õppeasutuses vastuvõtuks avatud õppekava andmed; õppeasutuses vabade vastuvõetavate kohtade arv, vajaduse korral info, kui õppekoht on tasuline; õppeasutuse vastuvõtutingimused; kandidaadi üldandmed: isikukood või sünniaeg, ees- ja perekonnanimi ning kontaktandmed; alaealise kandidaadi eestkostja või esindaja andmed: isikukood või sünniaeg, kodakondsus, ees- ja perekonnanimi ning kontaktandmed; vastuvõttu korraldava õppeasutuse vastuvõtutingimuste täitmiseks esitatav info kandidaadi kohta; kandidaadi või esindaja tahteavaldus(ed), sealhulgas andmed õppeasutuse ning õppekava kohta, kuhu vastuvõttu taotletakse, ja õppekoha vastuvõtu kinnitus; vastuvõtutingimuste täitmise tulemused, millest moodustub pingerida; õppeasutuse vastus kandidaadi avaldusele; muud vastuvõtu protsessis vajalikud andmed.",
      "rdfs:label": {
        "@value": "Reg_163512_Par_42_62 (redaktsioon 163512)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163512",
