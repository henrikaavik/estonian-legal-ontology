      "estleg:provisionRef": "Reg_163512 § 37",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163512_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_163512_Par_38_v163512",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163512_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õppekavade ja koolituslubade alamregistrisse kantakse andmed alus-, põhi-, üldkesk-, kutsekesk-, kõrg- või huvihariduse omandamist ning kutseõppe või residentuuri läbimist võimaldavate õppeasutuste õppekavade, ühisõppekavade, residentuuri programmide, koolituslubade, tegevuslubade, registreeringute, õppekavagrupis ja õppekavarühmas õppe läbiviimise õiguse ja akrediteerimise tulemuse kohta. Alamregistrisse kantakse ka andmed täienduskoolitusasutuse majandustegevusteadete ning loakohustusega täienduskoolituse, sealhulgas mikrokvalifikatsiooniõppe tegevuslubade, täienduskoolituse õppekavarühma kvaliteedihindamise ja õppekavade ning noorte- ja projektlaagrite tegevuslubade kohta. RT I 2025-05-16 1 116052025001 2025-05-19 Õppekavade ja koolituslubade alamregistrisse kantakse andmed alus-, põhi-, üldkesk-, kutsekesk-, kõrg- või huvihariduse omandamist ning kutseõppe või residentuuri läbimist võimaldavate õppeasutuste õppekavade, ühisõppekavade, residentuuri programmide, koolituslubade, tegevuslubade, registreeringute, õppekavagrupis ja õppekavarühmas õppe läbiviimise õiguse ja akrediteerimise tulemuse kohta. Alamregistrisse kantakse ka andmed täienduskoolitusasutuse majandustegevusteadete ning loakohustusega täienduskoolituse, sealhulgas mikrokvalifikatsiooniõppe tegevuslubade, täienduskoolituse õppekavarühma kvaliteedihindamise ja õppekavade ning noorte- ja projektlaagrite tegevuslubade kohta.",
      "rdfs:label": {
        "@value": "Reg_163512_Par_38 (redaktsioon 163512)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163512",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163512",
      "estleg:sourceAct": "Eesti hariduse infosüsteemi asutamine ning põhimäärus",
      "estleg:provisionRef": "Reg_163512 § 38",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163512_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_163512_Par_39_v163512",
      "@type": [
