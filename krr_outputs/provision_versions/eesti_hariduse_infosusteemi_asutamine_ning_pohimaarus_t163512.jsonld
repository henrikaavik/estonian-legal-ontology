    {
      "@id": "estleg:Reg_163512_Par_32_v163512",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163512_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õppeasutuste alamregistri asutamise ning kasutusele võtmise eesmärk on pidada arvestust alus-, põhi-, üldkesk-, kutsekesk-, kõrg- ja huvihariduse omandamist ning kutseõppe, täienduskoolituse või residentuuri läbimist võimaldavate õppeasutuste üldandmete ning õppe- ja kasvatustööks vajaliku inventari üle ning koolitusloa, majandustegevusteate ja tegevusloa või õppe läbiviimise õiguse ja täienduskoolituse õppekavarühma kvaliteedihindamise positiivse otsuse olemasolu kontrollimiseks. RT I 2025-05-16 1 116052025001 2025-05-19 Õppeasutuste alamregistri asutamise ning kasutusele võtmise eesmärk on pidada arvestust alus-, põhi-, üldkesk-, kutsekesk-, kõrg- ja huvihariduse omandamist ning kutseõppe, täienduskoolituse või residentuuri läbimist võimaldavate õppeasutuste üldandmete ning õppe- ja kasvatustööks vajaliku inventari üle ning koolitusloa, majandustegevusteate ja tegevusloa või õppe läbiviimise õiguse ja täienduskoolituse õppekavarühma kvaliteedihindamise positiivse otsuse olemasolu kontrollimiseks. 2 (2) Õppeasutuste alamregistri andmetel on informatiivne tähendus. Õppeasutuste alamregistri andmetel on informatiivne tähendus.",
      "rdfs:label": {
        "@value": "Reg_163512_Par_32 (redaktsioon 163512)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163512",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163512",
      "estleg:sourceAct": "Eesti hariduse infosüsteemi asutamine ning põhimäärus",
      "estleg:provisionRef": "Reg_163512 § 32",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163512_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_163512_Par_33_v163512",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163512_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õppeasutuste alamregistri koosseisu kuuluvad: 1) digitaalne andmebaas alushariduse omandamist võimaldavate õppeasutuste andmete üle arvestuse pidamiseks; 2) digitaalne andmebaas põhihariduse omandamist võimaldavate õppeasutuste andmete üle arvestuse pidamiseks; 3) digitaalne andmebaas üldkeskhariduse omandamist võimaldavate õppeasutuste andmete üle arvestuse pidamiseks; 4) digitaalne andmebaas kutsekeskhariduse omandamist või kutseõppe läbimist võimaldavate õppeasutuste andmete üle arvestuse pidamiseks; [ - jõust. 16.09.2007] 5) digitaalne andmebaas kõrghariduse omandamist võimaldavate õppeasutuste andmete üle arvestuse pidamiseks; 6) digitaalne andmebaas huvihariduse omandamist võimaldavate õppeasutuste andmete üle arvestuse pidamiseks; [ - jõust. 16.09.2007] 7) [kehtetu - - jõust. 16.09.2007] 8) digitaalne andmebaas täienduskoolituse läbimist võimaldavate õppeasutuste andmete üle arvestuse pidamiseks; [ - jõust. 19.12.2016] 9) digitaalne andmebaas noorte- ja projektlaagri pidajate andmete üle arvestuse pidamiseks. [ - jõust. 19.12.2016]",
      "rdfs:label": {
        "@value": "Reg_163512_Par_33 (redaktsioon 163512)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163512",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163512",
      "estleg:sourceAct": "Eesti hariduse infosüsteemi asutamine ning põhimäärus",
      "estleg:provisionRef": "Reg_163512 § 33",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163512_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_163512_Par_34_v163512",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163512_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õppeasutuste alamregistrisse kantakse alus-, põhi-, üldkesk-, kutsekesk-, kõrg- ja huvihariduse omandamist ning täienduskoolituse, kutseõppe või residentuuri läbimist võimaldavate õppeasutuste ning noorte- ja projektlaagri pidajate andmed. RT I 2016-12-16 1 116122016001 2016-12-19 Õppeasutuste alamregistrisse kantakse alus-, põhi-, üldkesk-, kutsekesk-, kõrg- ja huvihariduse omandamist ning täienduskoolituse, kutseõppe või residentuuri läbimist võimaldavate õppeasutuste ning noorte- ja projektlaagri pidajate andmed.",
      "rdfs:label": {
        "@value": "Reg_163512_Par_34 (redaktsioon 163512)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163512",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163512",
      "estleg:sourceAct": "Eesti hariduse infosüsteemi asutamine ning põhimäärus",
      "estleg:provisionRef": "Reg_163512 § 34",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163512_Map_2026"
      }
