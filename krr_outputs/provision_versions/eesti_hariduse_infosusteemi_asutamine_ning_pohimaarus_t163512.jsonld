      "estleg:versionText": "Asutatakse riiklik register „Eesti hariduse infosüsteem” (edaspidi register). RT I 2019-07-31 1 131072019001 2019-09-01 Asutatakse riiklik register „Eesti hariduse infosüsteem” (edaspidi register).",
      "rdfs:label": {
        "@value": "Reg_163512_Par_1 (redaktsioon 163512)",
        "@language": "et"
      },
