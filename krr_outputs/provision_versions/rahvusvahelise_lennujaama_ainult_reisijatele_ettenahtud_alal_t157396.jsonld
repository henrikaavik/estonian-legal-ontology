      "dc:source": "Rahvusvahelise lennujaama ainult reisijatele ettenähtud alal asuvas müügipunktis võõrandatava kauba ekspordina käsitamise kord"
    },
    {
      "@id": "estleg:Reg_157396_Par_1_v157396",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
