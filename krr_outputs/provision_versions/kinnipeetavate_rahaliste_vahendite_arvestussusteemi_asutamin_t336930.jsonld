      }
    },
    {
      "@id": "estleg:Reg_336930_Par_11_v336930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336930_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse kantud andmetel on informatiivne tähendus. Andmekogusse kantud andmetel on informatiivne tähendus. 2 (2) Seadusega ettenähtud juhtudel on andmekogusse kantud andmetel õiguslik tähendus. Seadusega ettenähtud juhtudel on andmekogusse kantud andmetel õiguslik tähendus.",
      "rdfs:label": {
        "@value": "Reg_336930_Par_11 (redaktsioon 336930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336930",
      "estleg:sourceAct": "Kinnipeetavate rahaliste vahendite arvestussüsteemi asutamine ja selle pidamise põhimäärus",
      "estleg:provisionRef": "Reg_336930 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336930_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_336930_Par_12_v336930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336930_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu andmetele võimaldatakse juurdepääs kooskõlas «Avaliku teabe seaduse» ja «Isikuandmete kaitse seadusega». Andmekogu andmetele võimaldatakse juurdepääs kooskõlas «Avaliku teabe seaduse» ja «Isikuandmete kaitse seadusega». 2 (2) Andmekogus olevatele andmetele on juurdepääs vastutava ja volitatud töötleja ametnikel nende teenistusülesannetega määratud ulatuses ja viisil. Andmekogus olevatele andmetele on juurdepääs vastutava ja volitatud töötleja ametnikel nende teenistusülesannetega määratud ulatuses ja viisil. 3 (3) Andmesubjektil on õigus saada volitatud töötlejalt kõiki tema kohta andmekogusse kantud andmeid õigusaktides sätestatud korras, kui seaduses ei ole sätestatud teisiti. Andmesubjektil on õigus saada volitatud töötlejalt kõiki tema kohta andmekogusse kantud andmeid õigusaktides sätestatud korras, kui seaduses ei ole sätestatud teisiti. 4 (4) Andmekogule juurdepääs on isikul, kes teostab infotehnoloogilisi arendus- ja hooldustöid vastutava töötlejaga sõlmitud lepingus sätestatud tingimustel, ulatuses ja korras. Andmekogule juurdepääs on isikul, kes teostab infotehnoloogilisi arendus- ja hooldustöid vastutava töötlejaga sõlmitud lepingus sätestatud tingimustel, ulatuses ja korras. 5 (5) Andmekogu on piiratud juurdepääsuga ning selle andmed on ainult ametialaseks kasutamiseks. Andmekogu on piiratud juurdepääsuga ning selle andmed on ainult ametialaseks kasutamiseks.",
      "rdfs:label": {
        "@value": "Reg_336930_Par_12 (redaktsioon 336930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336930",
      "estleg:sourceAct": "Kinnipeetavate rahaliste vahendite arvestussüsteemi asutamine ja selle pidamise põhimäärus",
      "estleg:provisionRef": "Reg_336930 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336930_Map_2026"
      }
