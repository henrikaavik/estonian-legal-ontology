      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogusse kantakse kõigi nende kinnipeetavate rahaliste vahendite andmed, kes on andmekogu asutamise ajal vangistuses, karistusjärgsel kinnipidamisel või eelvangistuses. Andmekogusse kantakse kõigi nende kinnipeetavate rahaliste vahendite andmed, kes on andmekogu asutamise ajal vangistuses, karistusjärgsel kinnipidamisel või eelvangistuses.",
      "rdfs:label": {
        "@value": "Reg_336930_Par_19 (redaktsioon 336930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336930",
      "estleg:sourceAct": "Kinnipeetavate rahaliste vahendite arvestussüsteemi asutamine ja selle pidamise põhimäärus",
      "estleg:provisionRef": "Reg_336930 § 19",
      "estleg:partOfAct": {
