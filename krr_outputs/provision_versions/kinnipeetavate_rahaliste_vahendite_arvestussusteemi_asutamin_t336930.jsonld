    {
      "@id": "estleg:Reg_336930_Par_7_v336930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336930_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu andmeandjateks on: 1 1) Rahandusministeeriumi riigikassa osakond; 2 2) vanglad. Andmekogu andmeandjateks on: Rahandusministeeriumi riigikassa osakond; vanglad.",
      "rdfs:label": {
        "@value": "Reg_336930_Par_7 (redaktsioon 336930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336930",
      "estleg:sourceAct": "Kinnipeetavate rahaliste vahendite arvestussüsteemi asutamine ja selle pidamise põhimäärus",
      "estleg:provisionRef": "Reg_336930 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336930_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_336930_Par_8_v336930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336930_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse kande tegemisena käsitatakse andmekogusse andmete sisestamist ja lisamist, seal täiendamist, parandamist ja tühistamist ning sealt kustutamist. Andmekogusse kande tegemisena käsitatakse andmekogusse andmete sisestamist ja lisamist, seal täiendamist, parandamist ja tühistamist ning sealt kustutamist. 2 (2) Kande tegemiseks õigustatud ametnikud määrab volitatud töötleja, lähtudes §-s 6 kirjeldatud korrast. Kande tegemiseks õigustatud ametnikud määrab volitatud töötleja, lähtudes §-s 6 kirjeldatud korrast. 3 (3) Kanne tehakse andmekogusse viie tööpäeva jooksul arvates kande tegemise aluseks oleva sündmuse toimumisest või sellest teadasaamisest. Kanne tehakse andmekogusse viie tööpäeva jooksul arvates kande tegemise aluseks oleva sündmuse toimumisest või sellest teadasaamisest. 4 (4) Kande tegija vastutab tema poolt andmekogusse kantud andmete õigsuse eest nende andmekogusse kandmise ajal. Kande tegija vastutab tema poolt andmekogusse kantud andmete õigsuse eest nende andmekogusse kandmise ajal. 5 (5) Kui vastutav töötleja tuvastab andmekogus ebaõiged andmed või teda teavitatakse nendest, on ta kohustatud andmed parandama ise või nõudma kande tegijalt nende parandamist viie tööpäeva jooksul teate saamisest. Kui vastutav töötleja tuvastab andmekogus ebaõiged andmed või teda teavitatakse nendest, on ta kohustatud andmed parandama ise või nõudma kande tegijalt nende parandamist viie tööpäeva jooksul teate saamisest.",
      "rdfs:label": {
        "@value": "Reg_336930_Par_8 (redaktsioon 336930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336930",
      "estleg:sourceAct": "Kinnipeetavate rahaliste vahendite arvestussüsteemi asutamine ja selle pidamise põhimäärus",
      "estleg:provisionRef": "Reg_336930 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336930_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_336930_Par_9_v336930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336930_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu sisaldab andmeid: 1 1) rahaliste vahendite kasutamisega seotud isikute kohta; 2 2) rahaliste vahendite kasutamisega seotud kontode kohta; 3 3) rahaliste vahendite kasutamisega seotud tehingute kohta. Andmekogu sisaldab andmeid: rahaliste vahendite kasutamisega seotud isikute kohta; rahaliste vahendite kasutamisega seotud kontode kohta; rahaliste vahendite kasutamisega seotud tehingute kohta. 2 (2) Rahaliste vahendite kasutamisega seotud konto omaniku kohta sisaldab andmekogu järgmisi andmeid: 1 1) isikukood; 2 2) kood kinnipeeturegistris; 3 3) eesnimi; 4 4) perekonnanimi; 5 5) isanimi; 6 6) sünniaeg; 7 7) riigikassa viitenumber; 8 8) vangla; 9 9) kamber või sektsioon. Rahaliste vahendite kasutamisega seotud konto omaniku kohta sisaldab andmekogu järgmisi andmeid: isikukood; kood kinnipeeturegistris; eesnimi; perekonnanimi; isanimi; sünniaeg; riigikassa viitenumber; vangla; kamber või sektsioon. 3 (3) Ülekande osaliste ja sularahatehingu poolte kohta sisaldab andmekogu järgmisi andmeid: 1 1) isiku nimi; 2 2) kontonumber; 3 3) viitenumber; 4 4) selgitus. Ülekande osaliste ja sularahatehingu poolte kohta sisaldab andmekogu järgmisi andmeid: isiku nimi; kontonumber; viitenumber; selgitus. 4 (4) Rahaliste vahendite kasutamisega seotud kontode kohta sisaldab andmekogu järgmisi andmeid: 1 1) konto, kuhu kantakse vanglasiseseks kasutamiseks jäetav raha (edaspidi vabakasutuskonto); 2 2) vabakasutuskonto jääk; 3 3) vabakasutuskonto broneering; 4 4) konto, kuhu kantakse vabanemistoetus (edaspidi vabanemiskonto); 5 5) vabanemiskonto jääk; 6 6) vabanemiskonto broneering; 7 7) nõudekonto; 8 8) nõudekonto jääk; 9 9) nõudekonto broneering; 10 10) maksja kontojääk; 11 11) makse saaja kontojääk; Rahaliste vahendite kasutamisega seotud kontode kohta sisaldab andmekogu järgmisi andmeid: konto, kuhu kantakse vanglasiseseks kasutamiseks jäetav raha (edaspidi vabakasutuskonto); vabakasutuskonto jääk; vabakasutuskonto broneering; konto, kuhu kantakse vabanemistoetus (edaspidi vabanemiskonto); vabanemiskonto jääk; vabanemiskonto broneering; nõudekonto; nõudekonto jääk; nõudekonto broneering; maksja kontojääk; makse saaja kontojääk; 5 (5) Rahaliste vahendite kasutamisega seotud tehingute kohta sisaldab andmekogu järgmisi andmeid: 1 1) makse; 2 2) makse summa; 3 3) sularahatehingu summa; 4 4) sularahatehingu kassa; 5 5) kontonumber; 6 6) makse selgitus; 7 7) makse viitenumber; 8 8) vangla kaupluse ostusumma; 9 9) tellimusleht; 10 10) tellimuslehe broneeringu summa. Rahaliste vahendite kasutamisega seotud tehingute kohta sisaldab andmekogu järgmisi andmeid: makse; makse summa; sularahatehingu summa; sularahatehingu kassa; kontonumber; makse selgitus; makse viitenumber; vangla kaupluse ostusumma; tellimusleht; tellimuslehe broneeringu summa.",
      "rdfs:label": {
        "@value": "Reg_336930_Par_9 (redaktsioon 336930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336930",
      "estleg:sourceAct": "Kinnipeetavate rahaliste vahendite arvestussüsteemi asutamine ja selle pidamise põhimäärus",
      "estleg:provisionRef": "Reg_336930 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336930_Map_2026"
      }
    },
