    {
      "@id": "estleg:Reg_336930_Par_13_v336930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336930_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vastutav töötleja võib õigusaktides ettenähtud juhtudel väljastada andmekogu andmeid statistilistel eesmärkidel kasutamiseks. Vastutav töötleja võib õigusaktides ettenähtud juhtudel väljastada andmekogu andmeid statistilistel eesmärkidel kasutamiseks. 2 (2) Andmed väljastatakse kujul, mis ei võimalda isikuid identifitseerida. Andmed väljastatakse kujul, mis ei võimalda isikuid identifitseerida.",
      "rdfs:label": {
        "@value": "Reg_336930_Par_13 (redaktsioon 336930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336930",
