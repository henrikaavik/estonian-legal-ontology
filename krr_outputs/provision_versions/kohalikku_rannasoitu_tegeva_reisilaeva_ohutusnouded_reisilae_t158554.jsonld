      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kohalikku rannasõitu tegeva reisilaeva ohutusnõuded, reisilaevade klassid, sõidupiirkonnad ja ohutuse tunnistusele kantavate andmete loetelu (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kohalikku rannasõitu tegeva reisilaeva ohutusnõuded, reisilaevade klassid, sõidupiirkonnad ja ohutuse tunnistusele kantavate andmete loetelu"
    },
    {
      "@id": "estleg:Reg_158554_Par_1_v158554",
      "@type": [
