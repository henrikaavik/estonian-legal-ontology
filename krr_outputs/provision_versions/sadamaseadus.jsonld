      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist kehtib kuni selle käesoleva seaduse alusel muutmise või kehtetuks tunnistamiseni.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_60 (redaktsioon 112072014128)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014128",
