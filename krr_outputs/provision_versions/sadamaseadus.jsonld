      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadam kustutatakse sadamaregistrist: sadama pidaja vastavasisulise taotluse alusel; juriidilisest isikust sadama pidaja lõpetamisel ilma õigusjärgluseta; akvatooriumi määramise kehtetuks tunnistamise korral või kui sadamas ei ole viie aasta jooksul sadamateenuseid osutatud.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_41 (redaktsioon 13196603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196603",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_41_v131052021005"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13196603",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 41",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_41_v131052021005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadam kustutatakse sadamaregistrist järgmistel juhtudel: kehtetu - juriidilisest isikust sadama pidaja lõpetamisel ilma õigusjärgluseta; kehtetu - kui sadamas lõpetatakse sadamateenuste osutamine.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_41 (redaktsioon 131052021005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052021005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131052021005",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 41",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_42_v13196603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet laevadelt ja muudelt veesõidukitelt laevaheitmete ja lastijäätmete vastuvõtmise üle sadamas, sadama laevaheitmete ja lastijäätmete vastuvõtmise ja käitlemise kava ning reostustõrje plaani väljatöötamise ja rakendamise üle, kaasa arvatud järelevalvet nõukogu määruse (EÜ) nr 41/2007/EÜ, millega määratakse 2007. aastaks kindlaks teatavate kalavarude ja kalavarurühmade püügivõimalused ning tingimused, mida kohaldatakse ühenduse vetes ning ühenduse kalalaevade suhtes püügipiirangutega vetes (ELT L 15, 20.01.2007, lk 1–213), kohaste laevade, mille puhul on kinnitust leidnud tegelemine ebaseadusliku kalapüügiga, sadamas toidu, kütuse ja muude teenustega varustamise nõuete täitmise üle teostab Keskkonnainspektsioon. (2) Riiklikku järelevalvet laevadelt ja muudelt veesõidukitelt laevaheitmete ja lastijäätmete üleandmise üle teostavad Keskkonnainspektsioon ja Veeteede Amet. (3) Riiklikku järelevalvet teiste käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete täitmise üle teostab Veeteede Amet.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_42 (redaktsioon 13196603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196603",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_42_v130052013012"
      },
      "estleg:versionValidTo": {
        "@value": "2013-06-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13196603",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 42",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
