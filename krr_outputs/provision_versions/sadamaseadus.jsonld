      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_9_v22384",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadama eeskiri sätestab sadama kasutamise tehnoloogilised, ekspluatatsioonilised, navigatsioonilised ja sadamateenuste osutamisel esitatavad tingimused, keskkonnakaitsealased eeskirjad ja nõuded ning sadamatasude süsteemi, kehtestades selles saastetasu määrad üldtasu koostisosana. (2) Sadama eeskirja kinnitab sadama valdaja. (3) Nõuded sadama eeskirjale kinnitab teede- ja sideminister. (4) Sadama eeskirjas märgitud nõuded on kohustuslikud kõigile sadamas tegutsevatele või viibivatele isikutele. (5) Sadama valdaja on kohustatud informeerima käesoleva paragrahvi lõikes 4 nimetatud isikuid sadamas kehtivast sadama eeskirjast ja muudest kohustuslikest eeskirjadest.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_9 (redaktsioon 22384)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22384",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_9_v194214"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22384",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_9_v194214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadama eeskiri sätestab sadamateenuste osutamisel esitatavad tehnoloogilised, ekspluatatsioonilised, navigatsioonilised ja keskkonnaalased nõuded ning sadamatasude ja pilsivee, fekaalvee, prügi ja muude saasteainete vastuvõtmise tasude määrad. (2) Sadama eeskirja ja selle muudatused kinnitab sadama valdaja, kooskõlastades eeskirja Veeteede Ametiga. (3) Nõuded sadama eeskirjale kinnitab teede- ja sideminister. (4) Sadama eeskirjas märgitud nõuded on kohustuslikud kõigile sadamas tegutsevatele või viibivatele isikutele. (5) Sadama valdaja on kohustatud informeerima käesoleva paragrahvi lõikes 4 nimetatud isikuid sadamas kehtivast sadama eeskirjast ja muudest kohustuslikest eeskirjadest.",
      "rdfs:label": {
