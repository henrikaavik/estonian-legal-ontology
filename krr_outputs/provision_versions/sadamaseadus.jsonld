    {
      "@id": "estleg:Sadamaseadus_Par_5_v22384",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama valdaja on isik, kes valdab sadamat ning korraldab sadama tegevust tervikuna.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_5 (redaktsioon 22384)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22384",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_5_v13196603"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22384",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_5_v13196603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Akvatooriumi määrab Vabariigi Valitsus. Akvatooriumi määramisel kehtestab Vabariigi Valitsus korraldusega akvatooriumi piirid. (2) Kohalikule omavalitsusüksusele kuuluval laevatataval siseveekogul asuva sadama akvatooriumi määrab kohaliku omavalitsusüksuse volikogu. Akvatooriumi määramisel kehtestab volikogu otsusega akvatooriumi piirid. (3) Sadama akvatooriumi määramisel kehtestab akvatooriumi määraja vajaduse korral täiendavad tingimused sadamasse sissesõidu korraldamiseks ja sissesõidutee märgistamiseks looduses. (4) Akvatooriumi määraja võib akvatooriumi kasutamisele kehtestada muid täiendavaid tingimusi.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_5 (redaktsioon 13196603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196603",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_5_v131052021005"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13196603",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_5_v131052021005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Akvatooriumi määrab valdkonna eest vastutav minister. Akvatooriumi määramisel kehtestab valdkonna eest vastutav minister käskkirjaga akvatooriumi piirid. (2) Kohalikule omavalitsusüksusele kuuluval laevatataval siseveekogul asuva sadama akvatooriumi määrab kohaliku omavalitsusüksuse volikogu. Akvatooriumi määramisel kehtestab volikogu otsusega akvatooriumi piirid. (3) Sadama akvatooriumi määramisel kehtestab akvatooriumi määraja vajaduse korral täiendavad tingimused sadamasse sissesõidu korraldamiseks ja sissesõidutee märgistamiseks looduses. (4) Akvatooriumi määraja võib akvatooriumi kasutamisele kehtestada muid täiendavaid tingimusi.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_5 (redaktsioon 131052021005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052021005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131052021005",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
