    {
      "@id": "estleg:Sadamaseadus_Par_58_v13196603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse jõustumisel tuleb sadama reostustõrje plaan esitada Keskkonnaministeeriumile kooskõlastamiseks hiljemalt 2010. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_58 (redaktsioon 13196603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13196603",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 58",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_59_v13196603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse 7. peatüki rakendamine (1) Enne käesoleva seaduse jõustumist sadamaregistrisse kantud sadama kannab registri volitatud töötleja üle käesoleva seaduse alusel asutatud sadamaregistrisse. (2) Käesoleva paragrahvi lõikes 1 sadamaregistrisse kantud sadama sadama pidaja peab registriandmed üle vaatama ja ajakohastama hiljemalt 2010. aasta 1. jaanuariks. (3) Sadam, mis ei ole enne käesoleva seaduse jõustumist kantud sadamaregistrisse, tuleb kanda sadamaregistrisse hiljemalt 2010. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_59 (redaktsioon 13196603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196603",
