      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_21_v120062022051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadama ja sadamarajatise turvaülemaks võib olla vähemalt 21-aastane keskharidust omav Eesti kodanik või Euroopa Liidu liikmesriigi või Euroopa Majanduspiirkonna lepingu osalisriigi kodanik, kes on läbinud turvaülema väljaõppe tegevusloa saanud ettevõtja juures. (2) Sadama ja sadamarajatise turvaülem peab valdama eesti keelt vähemalt B2-tasemel ja inglise keelt tööülesannete täitmiseks vajalikul tasemel. (3) Sadama ja sadamarajatise turvaülemana on keelatud töötada isikul, kes kannab karistust kuriteo eest või kelle karistusandmed kuriteo kohta ei ole karistusregistrist kustutatud.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_21 (redaktsioon 120062022051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022051",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022051",
      "estleg:sourceAct": "Sadamaseadus",
