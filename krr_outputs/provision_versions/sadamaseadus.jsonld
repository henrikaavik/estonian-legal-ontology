      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_15_v696406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadamaregister on riiklik register, kus registreeritakse sadamapassi omavad sadamad. (2) Sadamaregister asutatakse Vabariigi Valitsuse määrusega. (3) Sadamaregistri vastutav töötleja on Majandus- ja Kommunikatsiooniministeerium ning volitatud töötleja on Veeteede Amet.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_15 (redaktsioon 696406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "696406",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_15_v908785"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-02",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/696406",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_15_v908785",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadamaregister on riiklik register, kus registreeritakse sadamapassi omavad sadamad. (2) Sadamaregister asutatakse määrusega. (3) Sadamaregistri vastutav töötleja on Majandus- ja Kommunikatsiooniministeerium ning volitatud töötleja on Veeteede Amet.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_15 (redaktsioon 908785)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908785",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_15_v13196603"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/908785",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_15_v13196603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadama ja sadamarajatise turvalisuse riskianalüüsi viib läbi Veeteede Amet. Riskianalüüsi läbiviimise kohta koostatakse riskianalüüsi aruanne. (2) Sadamarajatiste arvu ja piirid sadamas määrab Veeteede Amet turvalisuse riskianalüüsi tulemuste põhjal, arvestades vajaduse korral sadama pidaja ettepanekut. (3) Veeteede Amet kaasab turvalisuse riskianalüüsi läbiviimisesse riigi päästeasutuse ja julgeolekuasutuse ning arvestab sadama ja sadamarajatise riskianalüüsi koostamisel nende ettepanekutega. (4) Sadama ja sadamarajatise turvalisuse riskianalüüsi aruanne tuleb üle vaadata ja vajaduse korral riskianalüüs uuesti läbi viia vähemalt iga viie aasta järel, võttes arvesse muutuvaid ohte ning muudatusi sadamas ja sadamarajatisel. Riskianalüüs tuleb läbi viia kohe, kui sadamas ja sadamarajatisel või selle ümbruses toimuvad olulised ehituslikud, töökorralduslikud või muud muudatused. Sadama pidaja ja sadamarajatise valdaja peavad teavitama Veeteede Ametit sadamas ja sadamarajatises aset leidnud olulistest ehituslikest, töökorralduslikest või muudest muudatustest. (5) Sadama ja sadamarajatise turvalisuse riskianalüüs peab kirjeldama sadama turvalisusega seonduvaid varasid, sadama infrastruktuuri, sadama piirkondi, sadamale lähtuvaid ohte ja nende võimalikke tagajärgi, ohu vältimise meetmeid ning sadama pidaja ja sadamarajatise valdaja kohustusi ja tegevusi turvalisuse tagamisel. (6) Sadama ja sadamarajatise turvalisuse riskianalüüsis kajastatavate teemade täpsustatud loetelu ja riskianalüüsi läbiviimise korra (7) Sadama ja sadamarajatise turvalisuse riskianalüüsi läbiviimise eest tasub vastavalt sadama pidaja või sadamarajatise valdaja riigilõivu. Riigilõiv tuleb tasuda kümne tööpäeva jooksul pärast kirjalikult riskianalüüsi läbiviimisest teatamist. Enne riigilõivu tasumist ei väljasta Veeteede Amet turvalisuse riskianalüüsi aruannet.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_15 (redaktsioon 13196603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196603",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_15_v130122011029"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13196603",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
