      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikaitse ülesannetega sadama turvaülema määrab ametikohale ja vabastab ametikohalt mereväe ülem. (2) Riigikaitse ülesannetega sadama turvaülemat atesteeritakse vastavalt kaitseväeteenistuse seadusele.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_36 (redaktsioon 13196603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196603",
