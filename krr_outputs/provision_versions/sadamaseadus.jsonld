    {
      "@id": "estleg:Sadamaseadus_Par_16_v22384",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avalikud tollilaod, tolliterminaalid ja vabatsoonid luuakse sadamates kaubanduse edendamiseks tolliseadusega kehtestatud korras. (2) Taotluse sadamaalal vabatsooni loomiseks esitab sadama valdaja teede- ja sideministrile. (3) Avalike tolliladude, tolliterminaalide ja vabatsoonide loomisega ei tohi kaasneda sadamateenuste osutamise vabaduse piiramine ning ebaausat konkurentsi põhjustavate tingimuste loomine. [Paragrahvi 16 sõnastus alates 1.07.2002]",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_16 (redaktsioon 22384)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22384",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_16_v182606"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22384",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_16_v182606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
