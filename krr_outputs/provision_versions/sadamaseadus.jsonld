    },
    {
      "@id": "estleg:Sadamaseadus_Par_60_1_v131052021005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_60_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne 2021. aasta 1. juunit väljastatud sadama turvaettevõtja tähtajaline tegevusluba muutub alates 2021. aasta 1. juunist tähtajatuks. (2) Isikul, kellel on enne 2021. aasta 1. juunit väljastatud kehtiv reederi ning laeva, sadama ja sadamarajatise turvaülema väljaõppe korraldamise tegevusluba, on sama tegevusloa alusel õigus alates 2021. aasta 1. juunist tegutseda sadama ja sadamarajatise turvaülema väljaõppe korraldamise tegevusalal.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_60_1 (redaktsioon 131052021005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052021005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131052021005",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 60_1",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_60_2_v103012022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_60_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 26 lõike 3 punktis 3 sätestatud viieaastast tähtaega kohaldatakse ka enne käesoleva paragrahvi jõustumist Keskkonnaameti heaks kiidetud laevaheitmete ja lastijäätmete vastuvõtmise ning käitlemise kavadele, mille heakskiitmisest on käesoleva paragrahvi jõustumise ajaks möödunud vähem kui kolm aastat.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_60_2 (redaktsioon 103012022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103012022021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103012022021",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 60_2",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_60_3_v117042025037",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_60_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kliimaministeerium on kohustatud alates 2026. aastast igal kalendriaastal hindama käesoleva seaduse § 3 lõikes 4 nimetatud sadama lisateenuste loetelu ajakohasust ning vajaduse korral seda täiendama.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_60_3 (redaktsioon 117042025037)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117042025037",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117042025037",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 60_3",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_61_v13196603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asjaõigusseaduses (RT I 1993, 39, 590; 2008, 59, 330) tehakse järgmised muudatused: paragrahvi 133 pealkiri muudetakse ja sõnastatakse järgmiselt: « § 133. Avaliku veekogu kaldajoon »; paragrahvi 133 lõige 1 muudetakse ja sõnastatakse järgmiselt: «(1) Kinnisomand ulatub avaliku veekogu kaldajooneni. Kaldajoon on veekogu tavaline veepiir.»; paragrahvi 133 lõige 2 tunnistatakse kehtetuks; paragrahvi 133 lõige 3 muudetakse ja sõnastatakse järgmiselt: «(3) Avaliku veekogu põhjaga püsivalt ühendatud ehitis, mis on püsivalt ühendatud kaldaga, on kaldakinnisasja oluline osa.»",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_61 (redaktsioon 13196603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13196603",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 61",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
