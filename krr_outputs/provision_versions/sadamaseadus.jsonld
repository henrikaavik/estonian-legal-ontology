      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_15_v22384",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadamaregister on riiklik register, kus registreeritakse sadamapassi omavad sadamad. (2) Sadamaregister asutatakse Vabariigi Valitsuse määrusega. (3) Sadamaregistri vastutav töötleja on Teede- ja Sideministeerium ning volitatud töötleja on Veeteede Amet. [Kuuenda peatüki pealkirja sõnastus kuni 30.06.2002]",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_15 (redaktsioon 22384)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22384",
