      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_39_v13196603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadamaregistrile esitavad andmeid sadama pidaja ning käesoleva seaduse § 38 lõike 1 punktis 17 nimetatud andmete puhul sadamas riiklikku järelevalvet teostav järelevalveasutus. (2) Sadamaregistrisse kantavate andmete muutumisel peab andmeandja esitama viivitamata Veeteede Ametile muutunud andmed või tegema võimaluse korral kande sadamaregistrisse ise. (3) Sadamaregistrisse andmeandja vastutab esitatud andmete õigsuse eest.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_39 (redaktsioon 13196603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196603",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sadamaseadus_Par_39_v110122020033"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13196603",
      "estleg:sourceAct": "Sadamaseadus",
      "estleg:provisionRef": "Sadamaseadus § 39",
      "estleg:partOfAct": {
        "@id": "estleg:Sadamaseadus_Map_2026"
      }
    },
    {
      "@id": "estleg:Sadamaseadus_Par_39_v110122020033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sadamaseadus_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadamaregistrile esitavad andmeid sadama pidaja ning käesoleva seaduse § 38 lõike 1 punktis 17 nimetatud andmete puhul sadamas riiklikku järelevalvet teostav järelevalveasutus. (2) Sadamaregistrisse kantavate andmete muutumisel peab andmeandja esitama viivitamata Transpordiametile muutunud andmed või tegema võimaluse korral kande sadamaregistrisse ise. (3) Sadamaregistrisse andmeandja vastutab esitatud andmete õigsuse eest.",
      "rdfs:label": {
        "@value": "Sadamaseadus_Par_39 (redaktsioon 110122020033)",
        "@language": "et"
