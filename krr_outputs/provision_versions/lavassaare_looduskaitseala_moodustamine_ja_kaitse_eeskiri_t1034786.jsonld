      "estleg:versionValidFrom": {
        "@value": "2016-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti NSV Ministrite Nõukogu 11. juuli 1957. a määrus nr 242 „Abinõudest looduskaitse organiseerimiseks Eesti NSV-s”, millega võeti kaitse alla Virussaare rabasaar, tunnistatakse kehtetuks Virussaare rabasaare osas. Eesti NSV Ministrite Nõukogu 11. juuli 1957. a määrus nr 242 „Abinõudest looduskaitse organiseerimiseks Eesti NSV-s”, millega võeti kaitse alla Virussaare rabasaar, tunnistatakse kehtetuks Virussaare rabasaare osas.",
      "rdfs:label": {
        "@value": "Reg_1034786_Par_12 (redaktsioon 1034786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034786",
