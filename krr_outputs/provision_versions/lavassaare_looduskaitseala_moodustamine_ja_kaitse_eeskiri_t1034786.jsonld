    {
      "@id": "estleg:Reg_1034786_Par_14_v1034786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034786_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lavassaare looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 27. mai 2011. a käskkirjaga nr 761 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Lavassaare looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 27. mai 2011. a käskkirjaga nr 761 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1034786_Par_14 (redaktsioon 1034786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034786",
      "estleg:sourceAct": "Lavassaare looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1034786 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1034786_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1034786_Par_15_v1034786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034786_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1034786_Par_15 (redaktsioon 1034786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034786",
      "estleg:sourceAct": "Lavassaare looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1034786 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1034786_Map_2026"
      }
    },
