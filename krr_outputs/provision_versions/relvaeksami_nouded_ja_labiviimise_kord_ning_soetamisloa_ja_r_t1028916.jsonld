    {
      "@id": "estleg:Reg_1028916_Par_5_v1028916",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028916_Par_5"
