      "dc:source": "Kindlustusmaakleri ja välisriigi kindlustusmaakleri Eesti filiaali aruannete sisu, vorm ja esitamise kord"
    },
    {
      "@id": "estleg:Reg_1031232_Par_1_v1031232",
      "@type": [
