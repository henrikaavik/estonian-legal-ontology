      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksumenetluses kohaldatakse haldusmenetluse seaduses (RT I 2001, 58, 354) sätestatut, kui käesolevas seaduses, maksuseaduses või tollieeskirjades ei ole ette nähtud teisiti.",
      "rdfs:label": {
        "@value": "MKS_Par_45 (redaktsioon 748775)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "748775",
