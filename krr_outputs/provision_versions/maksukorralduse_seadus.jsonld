        "@id": "estleg:MKS_Par_29_v13165740"
      },
      "estleg:versionValidTo": {
        "@value": "2009-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_29_v13165740",
      "@type": [
