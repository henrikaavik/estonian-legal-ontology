        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_45_v12911446",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
