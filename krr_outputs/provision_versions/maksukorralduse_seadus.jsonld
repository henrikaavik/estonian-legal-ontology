        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist esitatud vastulaused ja kaebused lahendatakse enne käesoleva seaduse jõustumist kehtinud maksukorralduse seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "MKS_Par_166 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810"
    },
