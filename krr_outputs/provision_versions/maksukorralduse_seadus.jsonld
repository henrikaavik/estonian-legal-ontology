      }
    },
    {
      "@id": "estleg:MKS_Par_30_v110122010013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuhaldur võib maksukohustuslase nõusolekuta avaldada maksusaladust sisaldavat teavet: välisriigi pädevatele organitele selle riigi residendist maksumaksja maksumenetluses tähendust omavat teavet vastavalt välislepingus sätestatud tingimustele; Euroopa Liidu ja selle liikmesriikide organitele, kes on pädevad maksukohustuslasega seotud teabe vahetamiseks Euroopa Liidu õigusaktides ettenähtud korras. kehtetu -",
      "rdfs:label": {
        "@value": "MKS_Par_30 (redaktsioon 110122010013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122010013",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_30_v122122011038"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_30_v122122011038",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliamet võib maksukohustuslase ja kolmanda isiku nõusoleku ning teadmiseta avaldada maksusaladust sisaldavat teavet: välisriigi pädevale asutusele välislepingus ettenähtud korras; Euroopa Liidu ja selle liikmesriikide asutustele, kes on pädevad maksukohustuslasega seotud teabe vahetamiseks Euroopa Liidu õigusaktides ettenähtud korras.",
      "rdfs:label": {
        "@value": "MKS_Par_30 (redaktsioon 122122011038)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122011038",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_30_v106112019008"
      },
      "estleg:versionValidTo": {
        "@value": "2019-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_30_v106112019008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliamet võib maksukohustuslase ja kolmanda isiku nõusoleku ning teadmiseta avaldada maksusaladust sisaldavat teavet: välisriigi pädevale asutusele välislepingus ettenähtud korras; Euroopa Liidu ja selle liikmesriikide asutustele, kes on pädevad maksukohustuslasega seotud teabe vahetamiseks Euroopa Liidu õigusaktides ettenähtud korras; nõuandekomisjoni või alternatiivse vaidluste lahendamise komisjoni liikmetele käesoleva seaduse 141. peatükis nimetatud kaebuse läbivaatamiseks vajalikus mahus.",
      "rdfs:label": {
        "@value": "MKS_Par_30 (redaktsioon 106112019008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106112019008"
    },
    {
      "@id": "estleg:MKS_Par_31_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksuseadusest või käesolevast seadusest võivad tuleneda järgmised rahalised nõuded ja kohustused: maksumaksja kohustus tasuda maksusumma (maksukohustus); maksu kinnipidaja kohustus pidada kinni ja tasuda kinnipeetud maksusumma (kinnipidamiskohustus); isiku õigus saada tagasi seaduses ettenähtust rohkem makstud maksusumma või muu enammakse vastavalt käesoleva seaduse §-le 33 (tagastusnõue); kolmanda isiku kohustus tasuda maksumaksja või maksu kinnipidaja maksuvõlg (vastutuskohustus); maksukohustuslase kohustus tasuda intress, sunniraha või asendustäitmise kulud (kõrvalkohustus). (2) Käesoleva paragrahvi lõikes 1 nimetatud nõuded ja kohustused tekivad seadusega sätestatud tingimuste saabumisel, kui seadusega ei ole sätestatud, et kohustuse tekkimiseks on vaja maksuhalduri haldusakti. (3) Käesoleva paragrahvi lõikes 1 nimetatud nõuded ja kohustused lõpevad: tasumisega (§ 105); tagastusnõude täitmisega (§ 106); tasaarvestamisega (§-d 108-109); aegumisega (§ 33 lõige 1, § 132); maksuvõla kustutamisega (§ 114); muudel seadusega sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "MKS_Par_31 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_31_v192294"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_31_v192294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksuseadusest või käesolevast seadusest võivad tuleneda järgmised rahalised nõuded ja kohustused: maksumaksja kohustus tasuda maksusumma (maksukohustus); maksu kinnipidaja kohustus pidada kinni ja tasuda kinnipeetud maksusumma (kinnipidamiskohustus); isiku õigus saada tagasi seaduses ettenähtust rohkem makstud maksusumma või muu enammakse vastavalt käesoleva seaduse §-le 33 (tagastusnõue); kolmanda isiku kohustus tasuda maksumaksja või maksu kinnipidaja maksuvõlg (vastutuskohustus); maksukohustuslase kohustus tasuda intress, sunniraha või asendustäitmise kulud (kõrvalkohustus). (2) Käesoleva paragrahvi lõikes 1 nimetatud nõuded ja kohustused tekivad seadusega sätestatud tingimuste saabumisel, kui seadusega ei ole sätestatud, etkohustusetekkimiseks on vaja maksuhalduri haldusakti. (3) Käesoleva paragrahvi lõikes 1 nimetatud nõuded ja kohustused lõpevad: tasumisega (§ 105); tagastusnõude täitmisega (§ 106); tasaarvestamisega (§-d 108-109); aegumisega (§ 33 lõige 1, § 132); maksuvõla kustutamisega (§ 114); muudel seadusega sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "MKS_Par_31 (redaktsioon 192294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "192294",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_31_v236347"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
