      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MKS_Par_152 (redaktsioon 110122010013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122010013"
    },
    {
      "@id": "estleg:MKS_Par_153_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_153"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksumaksjale tehtavatelt väljamaksetelt maksuseaduses ettenähtud maksu kinni pidamata jätmise või kinnipeetud maksusumma mittetäieliku või mitteõigeaegse tasumise eest maksuhalduri pangakontole - karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "MKS_Par_153 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
