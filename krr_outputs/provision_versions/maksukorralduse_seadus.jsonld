      }
    },
    {
      "@id": "estleg:MKS_Par_108_v110122010013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MKS_Par_108 (redaktsioon 110122010013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122010013"
    },
    {
      "@id": "estleg:MKS_Par_109_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklike maksude maksuhalduril on õigus jätta tagastusnõue (§ 33) rahuldamata ja tasaarvestada see sama maksuhalduri poolt hallatavate maksukohustuslase rahaliste kohustustega, mille tasumise tähtpäev on saabunud või saabub enne tagastamise tähtpäeva saabumist. Tasaarvestamine toimub järgmises järjekorras: maksusumma; intress; sunniraha; rahatrahv; asendustäitmise kulud. (2) Tagastusnõude võib tasaarvestada rahatrahviga, kui rahatrahv on muutunud sissenõutavaks. (3) Tagastusnõude intressiga tasaarvestamise korral ei pea maksuhaldur andma intressi tasumiseks maksetähtaega ning esitab tasaarvestamise otsuses intressinõude, kui tasaarvestatava intressi kohta ei ole intressinõuet varem esitatud. (4) Tasaarvestamise kohta tehakse motiveeritud otsus, millele kohaldatakse käesoleva seaduse § 108 lõikes 2 sätestatut. Kui pärast tasaarvestamist selgub, et selleks puudus seaduslik alus, tunnistatakse tasaarvestamise otsus tagasiulatuvalt kehtetuks.",
      "rdfs:label": {
        "@value": "MKS_Par_109 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_109_v192294"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_109_v192294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklike maksude maksuhalduril on õigus jätta tagastusnõue (§ 33) rahuldamata ja tasaarvestada see sama maksuhalduri poolt hallatavate maksukohustuslase rahaliste kohustustega, mille tasumise tähtpäev on saabunud või saabub enne tagastamise tähtpäeva saabumist. Tasaarvestamine toimub järgmises järjekorras: maksusumma; intress; sunniraha; rahatrahv; asendustäitmise kulud. (2) Tagastusnõude võib tasaarvestada rahatrahviga, kui rahatrahv on muutunud sissenõutavaks. (3) Tagastusnõude intressiga tasaarvestamise korral ei pea maksuhaldur andma intressi tasumiseks maksetähtaega ning esitab tasaarvestamise otsuses intressinõude, kui tasaarvestatava intressi kohta ei ole intressinõuet varem esitatud. (4) Tasaarvestamise kohta tehakse motiveeritud otsus, millele kohaldatakse käesoleva seaduse § 108 lõikes 2 sätestatut. Kui pärast tasaarvestamist selgub, etsellekspuudus seaduslik alus, tunnistatakse tasaarvestamise otsus tagasiulatuvalt kehtetuks.",
      "rdfs:label": {
        "@value": "MKS_Par_109 (redaktsioon 192294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "192294",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_109_v782811"
      },
      "estleg:versionValidTo": {
        "@value": "2005-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_109_v782811",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklike maksude maksuhalduril on õigus jätta tagastusnõue (§ 33) rahuldamata ja tasaarvestada see sama maksuhalduri poolt hallatavate maksukohustuslase rahaliste kohustustega, mille tasumise tähtpäev on saabunud või saabub enne tagastamise tähtpäeva saabumist. Tasaarvestamine toimub järgmises järjekorras: maksusumma; intress; sunniraha; rahatrahv; asendustäitmise kulud. (2) Tagastusnõude võib tasaarvestada rahatrahviga, kui rahatrahv on muutunud sissenõutavaks. (3) Tagastusnõude intressiga tasaarvestamise korral ei pea maksuhaldur andma intressi tasumiseks maksetähtaega ning esitab tasaarvestamise otsuses intressinõude, kui tasaarvestatava intressi kohta ei ole intressinõuet varem esitatud. (4) Tasaarvestamise kohta tehakse motiveeritud otsus, millele kohaldatakse käesoleva seaduse § 108 lõikes 2 sätestatut. Kui pärast tasaarvestamist selgub, et selleks puudus seaduslik alus, tunnistatakse tasaarvestamise otsus tagasiulatuvalt kehtetuks.",
      "rdfs:label": {
        "@value": "MKS_Par_109 (redaktsioon 782811)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "782811",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_109_v901885"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_109_v901885",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklike maksude maksuhalduril on õigus jätta tagastusnõue (§ 33) rahuldamata ja tasaarvestada see sama maksuhalduri poolt hallatavate maksukohustuslase rahaliste kohustustega, mille tasumise tähtpäev on saabunud või saabub enne tagastamise tähtpäeva saabumist. Tasaarvestamine toimub järgmises järjekorras: maksusumma; intress; sunniraha; rahatrahv; asendustäitmise kulud. (2) Tagastusnõude võib tasaarvestada rahatrahviga, kui rahatrahv on muutunud sissenõutavaks. (3) Tagastusnõude intressiga tasaarvestamise korral ei pea maksuhaldur andma intressi tasumiseks maksetähtaega ning esitab tasaarvestamise otsuses intressinõude, kui tasaarvestatava intressi kohta ei ole intressinõuet varem esitatud. [Lõike 4 sõnastus kuni 30. 06. 2005] (4) Tasaarvestamise kohta tehakse motiveeritud otsus, millele kohaldatakse käesoleva seaduse § 108 lõikes 2 sätestatut. Kui pärast tasaarvestamist selgub, et selleks puudus seaduslik alus, tunnistatakse tasaarvestamise otsus tagasiulatuvalt kehtetuks. [Lõike 4 sõnastus alates 1. 07. 2005] (4) Tasaarvestamise kohta tehakse motiveeritud otsus, millele kohaldatakse käesoleva seaduse § 108 lõikes 2 sätestatut. Kui pärast tasaarvestamist selgub, et selleks puudus seaduslik alus, tunnistatakse tasaarvestamise otsus tagasiulatuvalt kehtetuks. Kui tasaarvestatav summa ei ületa 50 krooni, siis maksukohustuslasele tasaarvestamise otsust ei väljastata, välja arvatud juhul, kui maksukohustuslane esitab vastava taotluse.",
      "rdfs:label": {
        "@value": "MKS_Par_109 (redaktsioon 901885)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "901885",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_109_v958198"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_109_v958198",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklike maksude maksuhalduril on õigus jätta tagastusnõue (§ 33) rahuldamata ja tasaarvestada see sama maksuhalduri poolt hallatavate maksukohustuslase rahaliste kohustustega, mille tasumise tähtpäev on saabunud või saabub enne tagastamise tähtpäeva saabumist. Tasaarvestamine toimub järgmises järjekorras: maksusumma; intress; sunniraha; rahatrahv; asendustäitmise kulud. (2) Tagastusnõude võib tasaarvestada rahatrahviga, kui rahatrahv on muutunud sissenõutavaks. (3) Tagastusnõude intressiga tasaarvestamise korral ei pea maksuhaldur andma intressi tasumiseks maksetähtaega ning esitab tasaarvestamise otsuses intressinõude, kui tasaarvestatava intressi kohta ei ole intressinõuet varem esitatud. (4) Tasaarvestamise kohta tehakse motiveeritud otsus, millele kohaldatakse käesoleva seaduse § 108 lõikes 2 sätestatut. Kui pärast tasaarvestamist selgub, et selleks puudus seaduslik alus, tunnistatakse tasaarvestamise otsus tagasiulatuvalt kehtetuks. Kui tasaarvestatav summa ei ületa 50 krooni, siis maksukohustuslasele tasaarvestamise otsust ei väljastata, välja arvatud juhul, kui maksukohustuslane esitab vastava taotluse.",
      "rdfs:label": {
        "@value": "MKS_Par_109 (redaktsioon 958198)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "958198",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_109_v110122010013"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_109_v110122010013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MKS_Par_109 (redaktsioon 110122010013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122010013"
    },
    {
      "@id": "estleg:MKS_Par_10_1_v113032019057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_10_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklike maksude maksuhaldur võib käesoleva seaduse, maksuseaduse või selle alusel antud õigusakti kohaselt kogutud isikuandmeid, sealhulgas põhjendatud juhul terviseandmeid ja biomeetrilisi andmeid, töödelda käesoleva seaduse §-s 10 nimetatud ülesannete täitmisel.",
      "rdfs:label": {
        "@value": "MKS_Par_10_1 (redaktsioon 113032019057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019057"
    },
    {
      "@id": "estleg:MKS_Par_11_v22271",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksuhalduri ametnikud ja teenistujad on kohustatud hoidma saladuses maksumaksjat või maksu kinnipidajat puudutavat informatsiooni, sealhulgas äri- ja pangasaladust, mida nad on teada saanud maksude tasumise õigsuse kontrollimise, tasumisele kuuluva maksusumma määramise, maksuvõlgade sissenõudmise, maksuseaduste rikkumise asja menetlemise või muude teenistuskohustuste täitmise käigus. (2) Käesoleva paragrahvi 1. lõikes nimetatud informatsiooni on lubatud avaldada ainult maksumaksja või maksu kinnipidaja kirjalikul nõusolekul või käesoleva paragrahvi 3.-5. lõikes nimetatud juhtudel. (3) Maksumaksja või maksu kinnipidaja nõusolekuta, kuid teda informeerides, võib maksuhaldur anda tema kohta informatsiooni: Riigikontrollile tema ülesannete täitmiseks; välisriigi pädevatele organitele selle riigi residendist maksumaksja kohta vastavalt välislepingus sätestatud tingimustele; Euroopa Ühenduste ja selle liikmesriikide organitele, kes on pädevad maksumaksjaga või maksu kinnipidajaga seotud informatsiooni vahetamiseks välislepingus või Euroopa Ühenduste õigusaktides ettenähtud korras. (4) Maksumaksja või maksu kinnipidaja nõusolekuta ja teda informeerimata võib maksuhaldur avaldada: maksumaksja või maksu kinnipidaja maksuvõla suurust; kohtulahendit või käesoleva seaduse § 35 kohaselt esitatud kaebuse või vastulause lahendamisel tehtud otsuse resolutiivosa, mille peale kohtusse kaebuse esitamise tähtaeg on kaebust esitamata mööda lastud; käesoleva seaduse § 114 kohaselt Maksuameti kohalikus asutuses registreeritud juriidilise isiku või asutuse või füüsilisest isikust ettevõtja või välismaa juriidilise isiku püsiva tegevuskoha registrisse kandmise ja registrist kustutamise kuupäeva, samuti nimetatud isiku või asutuse registreerimisel väljastatud tõendi numbrit ning nimetatud tõendile kantud andmeid; maksumaksja käibemaksukohustuslasena registrisse kandmise ja registrist kustutamise kuupäeva ning tema käibemaksukohustuslasena registreerimise numbrit; valla- või linnavalitsusele selle füüsilise isiku nime, isikukoodi, maksustatava tulu suuruse enne ja pärast seadusega lubatud mahaarvamisi, samuti maksustatavalt tulult arvestatud tulumaksusumma suuruse, kelle tulumaksust kantakse seadusega sätestatud osa vastava omavalitsusüksuse eelarvesse; valla- või linnavalitsusele tema haldusterritooriumil asuva maksu kinnipidaja poolt valla või linna kasuks maksuhaldurile ülekantud maksusumma; sotsiaalkindlustusega tegelevatele riigiasutustele seadusega ettenähtud andmeid; informatsiooni äriregistri pidajale registrikartoteegi andmete osas; Statistikaametile ja Riigihangete Ametile talle seadusega pandud ülesannete täitmiseks vajalikku informatsiooni; rahandusministrile andmeid, mis on seotud maksumaksjale või maksu kinnipidajale antud riigiabiga konkurentsiseaduse (RT I 1998, 30, 410; 1999, 89, 813) § 19 tähenduses; teisele riiklike maksude maksuhaldurile kõiki maksumaksja või maksu kinnipidaja kohta käivaid andmeid; kohtutäiturile täitetoimingute sooritamiseks vajalikke andmeid; rahapesu andmebüroole rahapesu või sellega seotud kuritegude vältimiseks, avastamiseks ja uurimiseks vajalikke andmeid; õiguste valdajale andmeid intellektuaalset omandit rikkuva kauba sisse- ja väljaveo tõkestamise seaduses ettenähtud juhtudel. (5) Maksuhaldur võib maksumaksja nõusoleku ja teadmiseta anda kohtule või muule pädevale riigiasutusele teavet kriminaal-, tsiviil- või haldusõiguserikkumise asja uurimiseks, menetlemiseks, arutamiseks ning karistuse määramiseks vajalike andmete kohta. (6) Kui seaduses ei ole sätestatud teisiti, on käesoleva paragrahvi 3.-5. lõike alusel informatsiooni saanud asutuste ametnikud ja teenistujad kohustatud hoidma saladuses nimetatud lõigete alusel neile edastatud informatsiooni maksumaksja ja maksu kinnipidaja kohta. Paragrahvid 111–113. [Kehtetud]",
      "rdfs:label": {
        "@value": "MKS_Par_11 (redaktsioon 22271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22271",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_11_v27810"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_11_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksuhaldur on maksude tasumise õigsuse kontrollimisel ja maksusumma määramisel kohustatud arvestama kõiki asjas tähendust omavaid, sealhulgas nii maksukohustust suurendavaid kui ka vähendavaid asjaolusid. (2) Maksuhaldur otsustab maksude tasumise õigsuse kontrollimisega seotud toimingute sooritamise vajaduse, toimingute liigi ja ulatuse ning kogub asja otsustamiseks vajalikke tõendeid. Maksuhaldur ei ole maksustamise seisukohast tähendust omavate asjaolude väljaselgitamisel seotud ainult menetlusosalise esitatud taotluste ja tõenditega.",
      "rdfs:label": {
        "@value": "MKS_Par_11 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_11_v693740"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_11_v693740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksuhaldur on maksude tasumise õigsuse kontrollimisel ja maksusumma määramisel kohustatud arvestama kõiki asjas tähendust omavaid, sealhulgas nii maksukohustust suurendavaid kui ka vähendavaid asjaolusid. (2) Maksuhaldur otsustab maksude tasumise õigsuse kontrollimisega seotud toimingute sooritamise vajaduse, toimingute liigi ja ulatuse ning kogub asja otsustamiseks vajalikke tõendeid. Maksuhaldur ei ole maksustamise seisukohast tähendust omavate asjaolude väljaselgitamisel seotud ainult menetlusosalise esitatud taotluste ja tõenditega.",
      "rdfs:label": {
        "@value": "MKS_Par_11 (redaktsioon 693740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693740",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_11_v697557"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-04",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_11_v697557",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-02-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksuhaldur on maksude tasumise õigsuse kontrollimisel ja maksusumma määramisel kohustatud arvestama kõiki asjas tähendust omavaid, sealhulgas nii maksukohustust suurendavaid kui ka vähendavaid asjaolusid. (2) Maksuhaldur otsustab maksude tasumise õigsuse kontrollimisega seotud toimingute sooritamise vajaduse, toimingute liigi ja ulatuse ning kogub asja otsustamiseks vajalikke tõendeid. Maksuhaldur ei ole maksustamise seisukohast tähendust omavate asjaolude väljaselgitamisel seotud ainult menetlusosalise esitatud taotluste ja tõenditega.",
      "rdfs:label": {
        "@value": "MKS_Par_11 (redaktsioon 697557)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "697557"
    },
    {
      "@id": "estleg:MKS_Par_110_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_110"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 108 ja 109 sätestatud tasaarvestamine on lubatud, kui: kohustuste täitmise tähtpäev on saabunud, välja arvatud juhul, kui maksukohustuslane taotleb tagastusnõude tasaarvestamist tulevaste kohustustega, samuti käesoleva seaduse § 109 lõigetes 1 ja 3 sätestatud juhul; tasaarvestatavad nõuded ei ole aegunud, kustutatud või muul alusel lõppenud; tasaarvestatava maksuvõla tasumine ei ole ajatatud. (2) Seadusega võib ette näha täiendavaid juhtumeid, mil tasaarvestamine on lubatud või keelatud.",
      "rdfs:label": {
        "@value": "MKS_Par_110 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
