      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "MKS_Par_45 (redaktsioon 22271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22271",
      "estleg:supersededByVersion": {
