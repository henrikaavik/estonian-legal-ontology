      "estleg:versionRedactionId": "122122011038"
    },
    {
      "@id": "estleg:MKS_Par_32_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuvõlg käesoleva seaduse tähenduses on maksukohustuslase poolt tähtpäevaks tasumata jäetud maksusumma, tähtpäevaks tasumata jäetud maksusummalt arvestatud intress ning tollivõlast tulenev tähtpäevaks tasumata maksusumma ja sellelt arvestatud intress.",
      "rdfs:label": {
        "@value": "MKS_Par_32 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_32_v229118"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_32_v229118",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuvõlg käesoleva seaduse tähenduses on maksukohustuslase poolt tähtpäevaks tasumata jäetud maksusumma, tähtpäevaks tasumata jäetud maksusummalt arvestatud intress ning tollivõlast tulenev tähtpäevaks tasumata maksusumma ja sellelt arvestatud intress.",
      "rdfs:label": {
        "@value": "MKS_Par_32 (redaktsioon 229118)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "229118",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_32_v235074"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_32_v235074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuvõlg käesoleva seaduse tähenduses on maksukohustuslase poolt tähtpäevaks tasumata jäetud maksusumma, tähtpäevaks tasumata jäetud maksusummalt arvestatud intress ning tollivõlast tulenev tähtpäevaks tasumata maksusumma ja sellelt arvestatud intress.",
      "rdfs:label": {
        "@value": "MKS_Par_32 (redaktsioon 235074)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "235074",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_32_v107122018005"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_32_v107122018005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuvõlg käesoleva seaduse tähenduses on: tähtpäevaks tasumata maksusumma; tollivõlast tulenev tähtpäevaks tasumata maksusumma; maksukohustuslase taotluse alusel alusetult tagastatud või tasaarvestatud summa; käesoleva paragrahvi punktides 1–3 nimetatud summalt arvestatud tasumata intress.",
      "rdfs:label": {
        "@value": "MKS_Par_32 (redaktsioon 107122018005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107122018005"
    },
    {
      "@id": "estleg:MKS_Par_33_v22271",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seadusega kehtestatud intressid laekuvad vastava maksu laekumise kohta. (2) Käesoleva seaduse alusel määratud trahvid laekuvad riigieelarvesse.",
      "rdfs:label": {
        "@value": "MKS_Par_33 (redaktsioon 22271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22271",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_33_v27810"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_33_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksumaksjal, kes on tasunud maksuseaduses ettenähtust suurema maksusumma, on õigus kolme aasta jooksul enammakse tekkimise päevast arvates taotleda maksuhaldurilt enammakstud summa tagastamist või tasaarvestamist. (2) Käesoleva paragrahvi lõikes 1 nimetatud õigus laieneb ka: maksukohustuslasele, kes on tasunud vastutusotsuse alusel seadusega ettenähtust suurema maksusumma; maksukohustuslasele, kes on maksuhaldurile tasunud seadusega ettenähtust rohkem intresse, sunniraha, asendustäitmise või muid menetluskulusid; isikule, kellel on seadusest tulenev õigus maksusumma või kulude hüvitamisele või tagastamisele maksuhalduri poolt. (3) Tagastusnõue täidetakse vastavalt käesoleva seaduse §-dele 106-109. (4) Maksukohustuse või käesoleva paragrahvi lõikes 2 nimetatud kohustuse vähenemise korral haldusakti muutmise või kehtetuks tunnistamise tagajärjel või maksu tasumise õigusliku aluse muul viisil äralangemise korral võib sellest tuleneva tagastusnõude täitmist nõuda kolme aasta jooksul, arvates kohustava haldusakti muutmise või kehtetuks tunnistamise või maksu tasumise õigusliku aluse äralangemise päevast.",
      "rdfs:label": {
        "@value": "MKS_Par_33 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_33_v13114422"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_33_v13114422",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksumaksjal on õigus saada tagasi maksuhaldurile seaduses või haldusaktis ettenähtust suuremas summas tehtud makse ja rahalise kohustuse tasumisel või tasaarvestamisel (§ 105 lõige 1) tekkinud enammakse, sealhulgas enne kohustuse tasumise tähtpäeva tehtud makse (§ 105 lõige 2). (1¹) Kui tagastusnõude tekkimist kontrollitakse ilma tagastusnõude täitmise taotluseta (§ 106 lõige 1), kohaldatakse käesoleva seaduse § 106 lõigetes 2, 2 1 , 3 ja 7 ning §-s 107 sätestatut. (2) Käesoleva paragrahvi lõikes 1 nimetatud õigus laieneb ka: maksukohustuslasele, kes on tasunud vastutusotsuse alusel seadusega ettenähtust suurema maksusumma; maksukohustuslasele, kes on maksuhaldurile tasunud seadusega ettenähtust rohkem intresse, sunniraha, asendustäitmise või muid menetluskulusid; isikule, kellel on seadusest tulenev õigus maksusumma või kulude hüvitamisele või tagastamisele maksuhalduri poolt. (3) Tagastusnõue täidetakse vastavalt käesoleva seaduse §-dele 106 ja 107. (4) Kui haldusakti muutmise või kehtetuks tunnistamise tõttu väheneb maksukohustus või käesoleva paragrahvi lõikes 2 nimetatud kohustus või langeb muul viisil ära maksu tasumise õiguslik alus, on maksukohustuslasel õigus sellest tulenev tagastusnõue esitada kolme aasta jooksul. (5) Tagastusnõudest tuleb maksuhaldurit teavitada maksudeklaratsioonis või muus kirjalikus või kirjalikku taasesitamist võimaldavas vormis esitatud dokumendis.",
      "rdfs:label": {
        "@value": "MKS_Par_33 (redaktsioon 13114422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13114422",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_33_v110122010013"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_33_v110122010013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksumaksjal on õigus saada tagasi maksuhaldurile seaduses või haldusaktis ettenähtust suuremas summas tehtud makse ja rahalise kohustuse tasumisel või tasaarvestamisel (§ 105 lõige 1) tekkinud enammakse, sealhulgas enne kohustuse tasumise tähtpäeva tehtud makse (§ 105 lõige 2). (1¹) Kui tagastusnõude tekkimist kontrollitakse ilma tagastusnõude täitmise taotluseta (§ 106 lõige 1), kohaldatakse käesoleva seaduse § 106 lõigetes 2, 21, 3 ja 7 ning §-s 107 sätestatut. (2) Käesoleva paragrahvi lõikes 1 nimetatud õigus laieneb ka: maksukohustuslasele, kes on tasunud vastutusotsuse alusel seadusega ettenähtust suurema maksusumma; maksukohustuslasele, kes on maksuhaldurile tasunud seadusega ettenähtust rohkem intresse, sunniraha, asendustäitmise või muid menetluskulusid; isikule, kellel on seadusest tulenev õigus maksusumma või kulude hüvitamisele või tagastamisele maksuhalduri poolt. (3) Tagastusnõue täidetakse vastavalt käesoleva seaduse §-dele 106 ja 107. (4) Kui haldusakti muutmise või kehtetuks tunnistamise tõttu väheneb maksukohustus või käesoleva paragrahvi lõikes 2 nimetatud kohustus või langeb muul viisil ära maksu tasumise õiguslik alus, on maksukohustuslasel õigus sellest tulenev tagastusnõue esitada kolme aasta jooksul. (5) Tagastusnõudest tuleb maksuhaldurit teavitada maksudeklaratsioonis või muus kirjalikus või kirjalikku taasesitamist võimaldavas vormis esitatud dokumendis.",
      "rdfs:label": {
        "@value": "MKS_Par_33 (redaktsioon 110122010013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122010013"
    },
    {
      "@id": "estleg:MKS_Par_34_v22271",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksumaksjale tagastatavad enammakstud maksusummad ja intressid makstakse tagasi nende laekumise kohtadest.",
      "rdfs:label": {
        "@value": "MKS_Par_34 (redaktsioon 22271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22271",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_34_v27810"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_34_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tagastusnõuet saab arestida ja sellele võib täitemenetluse käigus pöörata sissenõuet nagu rahalisele nõudele. (2) Tagastusnõudele võib seada seadusega sätestatud korras pandi. Tagastusnõude pantimise kohta esitab maksukohustuslane maksuhaldurile kirjaliku teate, milles näidatakse pantija ja pandipidaja nimi ja aadress, panditava tagastusnõude liik ja suurus. Teatele kirjutavad alla pantija ja pandipidaja. Tagastusnõude pantimisele kohaldatakse varaliste õiguste pantimise sätteid. (3) Pantida võib ka tulevikus tekkivaid tagastusnõudeid. Tagastusnõude pantimine hakkab kehtima maksuhaldurile teate esitamise hetkest. (4) Tagastusnõude pantimine, arestimine või sissenõude pööramine tagastusnõudele ei takista enammakse tagastamise pikendamist või peatamist vastavalt käesoleva seaduse §-le 107, samuti tasaarvestamist tähtpäevaks täitmata jäänud kohustusega vastavalt §-le 109.",
      "rdfs:label": {
        "@value": "MKS_Par_34 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_34_v765449"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_34_v765449",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tagastusnõuet saab arestida ja sellele võib täitemenetluse käigus pöörata sissenõuet nagu rahalisele nõudele. (2) Tagastusnõudele võib seada seadusega sätestatud korras pandi. Tagastusnõude pantimise kohta esitab maksukohustuslane maksuhaldurile kirjaliku teate, milles näidatakse pantija ja pandipidaja nimi ja aadress, panditava tagastusnõude liik ja suurus. Teatele kirjutavad alla pantija ja pandipidaja. Tagastusnõude pantimisele kohaldatakse varaliste õiguste pantimise sätteid. (3) Pantida võib ka tulevikus tekkivaid tagastusnõudeid. Tagastusnõude pantimine hakkab kehtima maksuhaldurile teate esitamise hetkest. (4) Tagastusnõude pantimine, arestimine või sissenõude pööramine tagastusnõudele ei takista enammakse tagastamise pikendamist või peatamist vastavalt käesoleva seaduse §-le 107, samuti tasaarvestamist tähtpäevaks täitmata jäänud kohustusega vastavalt §-le 109.",
      "rdfs:label": {
        "@value": "MKS_Par_34 (redaktsioon 765449)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "765449",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_34_v828323"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_34_v828323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tagastusnõuet saab arestida ja sellele võib täitemenetluse käigus pöörata sissenõuet nagu rahalisele nõudele. (2) Tagastusnõudele võib seada seadusega sätestatud korras pandi. Tagastusnõude pantimise kohta esitab maksukohustuslane maksuhaldurile kirjaliku teate, milles näidatakse pantija ja pandipidaja nimi ja aadress, panditava tagastusnõude liik ja suurus. Teatele kirjutavad alla pantija ja pandipidaja. Tagastusnõude pantimisele kohaldatakse varaliste õiguste pantimise sätteid. (3) Pantida võib ka tulevikus tekkivaid tagastusnõudeid. Tagastusnõude pantimine hakkab kehtima maksuhaldurile teate esitamise hetkest. (4) Tagastusnõude pantimine, arestimine või sissenõude pööramine tagastusnõudele ei takista enammakse tagastamise pikendamist või peatamist vastavalt käesoleva seaduse §-le 107, samuti tasaarvestamist tähtpäevaks täitmata jäänud kohustusega vastavalt §-le 109.",
      "rdfs:label": {
        "@value": "MKS_Par_34 (redaktsioon 828323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "828323",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_34_v13114422"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_34_v13114422",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tagastusnõuet saab arestida ja sellele võib täitemenetluse käigus pöörata sissenõuet nagu rahalisele nõudele. (2) Tagastusnõudele võib seada seadusega sätestatud korras pandi. Tagastusnõude pantimise kohta esitab maksukohustuslane maksuhaldurile kirjaliku teate, milles näidatakse pantija ja pandipidaja nimi ja aadress, panditava tagastusnõude liik ja suurus. Teatele kirjutavad alla pantija ja pandipidaja. Tagastusnõude pantimisele kohaldatakse varaliste õiguste pantimise sätteid. (3) Pantida võib ka tulevikus tekkivaid tagastusnõudeid. Tagastusnõude pantimine hakkab kehtima maksuhaldurile teate esitamise hetkest. (4) Tagastusnõude pantimine või arestimine või sissenõude pööramine tagastusnõudele ei takista tagastusnõude tasaarvestamist tasumisele kuuluvate rahaliste kohustustega ega enammakse tagastamise pikendamist või peatamist vastavalt käesoleva seaduse §-le 107.",
      "rdfs:label": {
        "@value": "MKS_Par_34 (redaktsioon 13114422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13114422",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_34_v131012014013"
      },
      "estleg:versionValidTo": {
        "@value": "2014-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_34_v131012014013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tagastusnõuet saab arestida ja sellele võib täitemenetluse käigus pöörata sissenõuet nagu rahalisele nõudele. (2) Tagastusnõudele võib seada seadusega sätestatud korras pandi. Tagastusnõude pantimise kohta esitab maksukohustuslane maksuhaldurile kirjaliku teate, milles näidatakse pantija ja pandipidaja nimi ja aadress, panditava tagastusnõude liik ja suurus. Teatele kirjutavad alla pantija ja pandipidaja. Tagastusnõude pantimisele kohaldatakse varaliste õiguste pantimise sätteid. (3) Pantida võib ka tulevikus tekkivaid tagastusnõudeid. Tagastusnõude pantimine hakkab kehtima maksuhaldurile teate esitamise hetkest. (4) Tagastusnõude pantimine või arestimine või sissenõude pööramine tagastusnõudele ei takista tagastusnõude tasaarvestamist tasumisele kuuluvate rahaliste kohustustega ega enammakse tagastamise pikendamist või peatamist vastavalt käesoleva seaduse §-le 107. (5) Käesoleva paragrahvi lõikes 4 sätestatut ei kohaldata, kui kohtutäitur on tagastusnõude arestinud lapse elatisnõude täitmiseks. Lapse elatisnõude alusel tekkinud arestipandiõigusele kohaldatakse täitemenetluse seadustiku § 65 lõikes 4 sätestatut.",
      "rdfs:label": {
        "@value": "MKS_Par_34 (redaktsioon 131012014013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131012014013"
    },
    {
      "@id": "estleg:MKS_Par_35_v22271",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksuameti kohaliku asutuse ettekirjutuse, otsuse või maksuteatega (edaspidi haldusakt) mittenõustumisel on maksumaksjal, maksu kinnipidajal või kolmandal isikul, kelle huve Maksuameti kohaliku asutuse haldusakt puudutab (edaspidi huvitatud isik), õigus 30 päeva jooksul haldusakti saamise päevale järgnevast päevast arvates esitada Maksuametile kaebus. Kaebus peab sisaldama käesoleva seaduse §-s 351 nimetatud andmeid. Kaebus esitatakse Maksuametile haldusakti väljastanud Maksuameti kohaliku asutuse kaudu. (2) Huvitatud isikul on õigus esitada Maksuameti või Tolliameti haldusakti kohta vastulause 30 päeva jooksul vastava haldusakti saamise päevast arvates. Vastulause peab sisaldama käesoleva seaduse §-s 351 nimetatud andmeid. Maksuamet ja Tolliamet juhinduvad vastulause lahendamisel käesoleva seaduse §-s 38 sätestatust. (3) Kaebuse või vastulause esitamine ei peata vaidlustatud ettekirjutuse täitmist, välja arvatud käesoleva seaduse § 20 alusel tehtud ettekirjutus, kuid maksuhalduril ei ole õigust teha krediidiasutusele ettekirjutust käesoleva seaduse § 24 1. lõike alusel maksumaksja või maksu kinnipidaja pangakontodelt raha vastuvaidlematus korras ülekandmiseks maksuhalduri pangakontole. Maksuametil ja tema kohalikul asutusel on vastulause või kaebuse esitaja taotlusel õigus peatada vaidlustatud haldusakti täitmine, kui ettekirjutuse adressaat esitab käesoleva seaduse § 342 4.-6. lõikes sätestatud tingimustele vastava ning maksuhalduri poolt aktsepteeritava tagatise.",
      "rdfs:label": {
        "@value": "MKS_Par_35 (redaktsioon 22271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22271",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_35_v27810"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_35_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui seadusega on ette nähtud õigusjärgluse korras õiguste ja kohustuste üleminek ühelt isikult teisele, siis lähevad õigusjärglasele üle ka kõik käesoleva seaduse § 31 lõikes 1 nimetatud nõuded ja kohustused, välja arvatud sunniraha maksmise kohustus.",
      "rdfs:label": {
        "@value": "MKS_Par_35 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_35_v131032017003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_35_v131032017003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui seadusega on ette nähtud õigusjärgluse korras õiguste ja kohustuste üleminek ühelt isikult teisele, siis lähevad õigusjärglasele üle kõik käesolevast seadusest, maksuseadusest ja käesoleva seaduse § 3 lõikes 4 nimetatud seadustest tulenevad rahalised ja mitterahalised õigused ning kohustused, mis ei ole oma olemuselt isikuga lahutamatult seotud. Sunniraha maksmise kohustus ei lähe õigusjärgluse korras üle ühelt isikult teisele.",
      "rdfs:label": {
        "@value": "MKS_Par_35 (redaktsioon 131032017003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131032017003"
    },
    {
      "@id": "estleg:MKS_Par_36_v22271",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksuameti kohalik asutus vaatab kaebuse läbi, kontrollib selle vastavust käesoleva seaduse §-s 351 sätestatud nõuetele ning edastab selle koos asjassepuutuvate materjalidega ning omapoolse kirjaliku seletusega viie tööpäeva jooksul Maksuametile, välja arvatud käesoleva paragrahvi 2. ja 3. lõikes sätestatud juhul. (2) Kaebusega nõustumise korral jätab Maksuameti kohalik asutus kaebuse Maksuametile saatmata ning teeb vastavalt kaebuse esitaja taotlusele otsuse vaidlustatud ettekirjutus või otsus kas muuta või tühistada. Maksuteate peale esitatud kaebusega nõustumise korral Maksuameti kohalik asutus tühistab selle või väljastab uue, parandatud maksuteate. Eespool nimetatud uue haldusaktiga mittenõustumisel on huvitatud isikul õigus esitada käesoleva seaduse §-s 35 sätestatud korras uus kaebus. (3) Kui kaebus ei vasta käesoleva seaduse §-s 351 sätestatud nõuetele, on Maksuameti kohalikul asutusel õigus teatada sellest kirjalikult kaebuse esitajale, anda kahenädalane tähtaeg puuduste kõrvaldamiseks ning teha hoiatus, et puuduste tähtajaks kõrvaldamata jätmise korral loetakse kaebus esitamata jäetuks.",
      "rdfs:label": {
        "@value": "MKS_Par_36 (redaktsioon 22271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22271",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_36_v27810"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_36_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 31 lõikes 1 nimetatud nõuded ja kohustused, välja arvatud sunniraha maksmise kohustus, lähevad pärandajalt üle pärijale pärimisseaduses (RT I 1996, 38, 752; 1999, 10, 155; 88, 807; 2001, 56, 336; 93, 565) sätestatud korras. (2) Kuni pärandvara vastuvõtmiseni või sellest keeldumiseni täidab pärandaja nimel käesolevast seadusest või maksuseadusest tulenevaid kohustusi pärandvara hooldaja või testamenditäitja, nende puudumise korral pärandvara inventuuritegija. Eelnimetatud isik täidab pärandaja rahalisi maksukohustusi pärandvara arvel.",
      "rdfs:label": {
        "@value": "MKS_Par_36 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_36_v603732"
      },
      "estleg:versionValidTo": {
        "@value": "2003-07-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_36_v603732",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 31 lõikes 1 nimetatud nõuded ja kohustused, välja arvatud sunniraha maksmise kohustus, lähevad pärandajalt üle pärijale pärimisseaduses (RT I 1996, 38, 752; 1999, 10, 155; 88, 807; 2001, 56, 336; 93, 565) sätestatud korras. (2) Kuni pärandvara vastuvõtmiseni või sellest keeldumiseni täidab pärandaja nimel käesolevast seadusest või maksuseadusest tulenevaid kohustusi pärandvara hooldaja või testamenditäitja, nende puudumise korral pärandvara inventuuritegija. Eelnimetatud isik täidab pärandaja rahalisi maksukohustusi pärandvara arvel.",
      "rdfs:label": {
        "@value": "MKS_Par_36 (redaktsioon 603732)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "603732",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_36_v693740"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_36_v693740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 31 lõikes 1 nimetatud nõuded ja kohustused, välja arvatud sunniraha maksmise kohustus, lähevad pärandajalt üle pärijale pärimisseaduses (RT I 1996, 38, 752; 1999, 10, 155; 88, 807; 2001, 56, 336; 93, 565) sätestatud korras. (2) Kuni pärandvara vastuvõtmiseni või sellest keeldumiseni täidab pärandaja nimel käesolevast seadusest või maksuseadusest tulenevaid kohustusi pärandvara hooldaja või testamenditäitja, nende puudumise korral pärandvara inventuuritegija. Eelnimetatud isik täidab pärandaja rahalisi maksukohustusi pärandvara arvel.",
      "rdfs:label": {
        "@value": "MKS_Par_36 (redaktsioon 693740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693740",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_36_v12911446"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-27",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_36_v12911446",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 31 lõikes 1 nimetatud nõuded ja kohustused, välja arvatud sunniraha maksmise kohustus, lähevad pärandajalt üle pärijale pärimisseaduses sätestatud korras. (2) Kuni pärandvara vastuvõtmiseni või sellest keeldumiseni täidab pärandaja nimel käesolevast seadusest või maksuseadusest tulenevaid kohustusi pärandvara hooldaja või testamenditäitja, nende puudumise korral pärandvara inventuuritegija. Eelnimetatud isik täidab pärandaja rahalisi maksukohustusi pärandvara arvel.",
      "rdfs:label": {
        "@value": "MKS_Par_36 (redaktsioon 12911446)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12911446",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_36_v13334383"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_36_v13334383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 31 lõikes 1 nimetatud nõuded ja kohustused, välja arvatud sunniraha maksmise kohustus, lähevad pärandajalt üle pärijale pärimisseaduses sätestatud korras. (2) Pärandvara hulka kuuluvaid käesolevast seadusest või maksuseadusest tulenevaid kohustusi on pärandvara arvel kohustatud täitma ka testamenditäitja ja pärandvara hooldaja. (3) Vajaduse korral esitab maksuhaldur notarile avalduse pärimismenetluse algatamiseks. Kui kuue kuu jooksul pärandi avanemisest arvates ei ole pärija selgunud ja puudub muu pärandvara valitsema õigustatud isik, esitab maksuhaldur kohtule avalduse pärandvara hoiumeetmete rakendamiseks. Maksuhaldur võib avalduse esitada ka enne kuue kuu möödumist, kui selleks esinevad mõjuvad põhjused.",
      "rdfs:label": {
        "@value": "MKS_Par_36 (redaktsioon 13334383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334383",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_36_v131032017003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_36_v131032017003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevast seadusest, maksuseadusest ja käesoleva seaduse § 3 lõikes 4 nimetatud seadustest tulenevad rahalised ja mitterahalised õigused ning kohustused, välja arvatud sunniraha maksmise kohustus, lähevad pärandajalt üle pärijale pärimisseaduses sätestatud korras. (2) Pärandvara hulka kuuluvaid käesolevast seadusest, maksuseadusest ja käesoleva seaduse § 3 lõikes 4 nimetatud seadustest tulenevaid kohustusi on pärandvara arvel kohustatud täitma ka testamenditäitja, pärandi hooldaja või muu isik, kellel on seadusest tulenevalt pärandvara valitsemise kohustus. (3) Vajaduse korral esitab maksuhaldur notarile avalduse pärimismenetluse algatamiseks. Kui kuue kuu jooksul pärandi avanemisest arvates ei ole pärija selgunud ja puudub muu pärandvara valitsema õigustatud isik, esitab maksuhaldur kohtule avalduse pärandvara hoiumeetmete rakendamiseks. Maksuhaldur võib avalduse esitada ka enne kuue kuu möödumist, kui selleks esinevad mõjuvad põhjused.",
      "rdfs:label": {
        "@value": "MKS_Par_36 (redaktsioon 131032017003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131032017003"
    },
    {
      "@id": "estleg:MKS_Par_37_v22271",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Kehtetu]",
      "rdfs:label": {
        "@value": "MKS_Par_37 (redaktsioon 22271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22271",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_37_v27810"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_37_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtte või selle osa omandi või valduse ülemineku korral lähevad ettevõtte või selle organisatsiooniliselt iseseisva osaga olemuslikult seotud käesoleva seaduse § 31 lõikes 1 nimetatud nõuded ja kohustused, välja arvatud sunniraha maksmise kohustus, üle omandajale või valduse saajale vastavalt lepingute ja lepinguväliste kohustuste seaduses (RT I 2001, 81, 487) sätestatule.",
      "rdfs:label": {
        "@value": "MKS_Par_37 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_37_v693740"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_37_v693740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtte või selle osa omandi või valduse ülemineku korral lähevad ettevõtte või selle organisatsiooniliselt iseseisva osaga olemuslikult seotud käesoleva seaduse § 31 lõikes 1 nimetatud nõuded ja kohustused, välja arvatud sunniraha maksmise kohustus, üle omandajale või valduse saajale vastavalt võlaõigusseaduses (RT I 2001, 81, 487; 2002, 60, 374) sätestatule.",
      "rdfs:label": {
        "@value": "MKS_Par_37 (redaktsioon 693740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693740",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_37_v12911446"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-27",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_37_v12911446",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtte või selle osa omandi või valduse ülemineku korral lähevad ettevõtte või selle organisatsiooniliselt iseseisva osaga olemuslikult seotud käesoleva seaduse § 31 lõikes 1 nimetatud nõuded ja kohustused, välja arvatud sunniraha maksmise kohustus, üle omandajale või valduse saajale vastavalt võlaõigusseaduses sätestatule.",
      "rdfs:label": {
        "@value": "MKS_Par_37 (redaktsioon 12911446)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12911446"
    },
    {
      "@id": "estleg:MKS_Par_38_v22271",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksuamet või Tolliamet vaatab tema ettekirjutuse või otsuse peale esitatud vastulause ning Maksuamet talle kohaliku asutuse poolt saadetud kaebuse läbi, teeb selle kohta kirjaliku motiveeritud otsuse ning saadab otsuse kaebuse või vastulause esitajale 30 kalendripäeva jooksul kaebuse või vastulause saamise päevale järgnevast päevast arvates. Rahandusministril on õigus seda tähtaega pikendada. Pikendamine toimub iga juhtumi korral eraldi. (2) Maksuamet või Tolliamet teeb kaebuse või vastulause lahendamisel otsuse jätta vaidlustatud haldusakt jõusse, see muuta või tühistada. Kaebuse või vastulause lahendamisel haldusakti tühistades on Maksuametil või Tolliametil õigus teha uus haldusakt. Maksuametil on õigus saata asi uue haldusakti tegemise otsustamiseks Maksuameti kohalikule asutusele. (3) Riiklike maksude maksuhalduril on õigus nõuda kaebuse või vastulause esitajalt täiendavate tõendite esitamist või suuliste seletuste andmiseks maksuhalduri juurde ilmumist. Ilmumata jätmine ei takista kaebuse või vastulause läbivaatamist. (4) Riiklike maksude maksuhaldur ei ole kohustatud otsuse või ettekirjutuse peale saabunud vastulauset või kaebust lahendama, kui sama ettekirjutuse või otsuse peale on esitatud kaebus kohtusse.",
      "rdfs:label": {
        "@value": "MKS_Par_38 (redaktsioon 22271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22271",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_38_v27810"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_38_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtte või selle osa üleandnud isik vastutab maksuvõla tasumise eest solidaarselt ettevõtte omandajaga vastavalt lepingute ja lepinguväliste kohustuste seaduses sätestatule.",
      "rdfs:label": {
        "@value": "MKS_Par_38 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_38_v693740"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_38_v693740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtte või selle osa üleandnud isik vastutab maksuvõla tasumise eest solidaarselt ettevõtte omandajaga vastavalt võlaõigusseaduses (RT I 2001, 81, 487; 2002, 60, 374) sätestatule.",
      "rdfs:label": {
        "@value": "MKS_Par_38 (redaktsioon 693740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693740",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_38_v12911446"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-27",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_38_v12911446",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_38"
