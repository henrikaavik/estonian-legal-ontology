      }
    },
    {
      "@id": "estleg:MKS_Par_44_v603732",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_44"
      },
      "estleg:versionValidFrom": {
