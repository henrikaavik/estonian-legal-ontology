      }
    },
    {
      "@id": "estleg:MKS_Par_45_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksumenetluses kohaldatakse haldusmenetluse seaduses (RT I 2001, 58, 354) sätestatut, kui käesolevas seaduses, maksuseaduses või tolliseadustikus ei ole ette nähtud teisiti.",
      "rdfs:label": {
        "@value": "MKS_Par_45 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
