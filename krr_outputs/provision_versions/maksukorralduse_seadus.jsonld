      }
    },
    {
      "@id": "estleg:MKS_Par_30_v901885",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuhaldur võib maksukohustuslase nõusolekuta avaldada maksusaladust sisaldavat teavet: [Punkti 1 sõnastus kuni 30. 06. 2005] välisriigi pädevatele organitele selle riigi residendist maksumaksja kohta vastavalt välislepingus sätestatud tingimustele; [Punkti 1 sõnastus alates 1. 07. 2005] välisriigi pädevatele organitele selle riigi residendist maksumaksja maksumenetluses tähendust omavat teavet vastavalt välislepingus sätestatud tingimustele; Euroopa Liidu ja selle liikmesriikide organitele, kes on pädevad maksukohustuslasega seotud teabe vahetamiseks Euroopa Liidu õigusaktides ettenähtud korras; kehtetu -",
      "rdfs:label": {
        "@value": "MKS_Par_30 (redaktsioon 901885)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "901885",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_30_v958198"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_30_v958198",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuhaldur võib maksukohustuslase nõusolekuta avaldada maksusaladust sisaldavat teavet: välisriigi pädevatele organitele selle riigi residendist maksumaksja maksumenetluses tähendust omavat teavet vastavalt välislepingus sätestatud tingimustele; Euroopa Liidu ja selle liikmesriikide organitele, kes on pädevad maksukohustuslasega seotud teabe vahetamiseks Euroopa Liidu õigusaktides ettenähtud korras; kehtetu -",
