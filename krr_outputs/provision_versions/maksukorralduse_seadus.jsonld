      }
    },
    {
      "@id": "estleg:MKS_Par_39_v27810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Täisühingu osanik või usaldusühingu täisosanik vastutab täis- või usaldusühingu maksuvõla tasumise eest vastavalt äriseadustiku §-dele 101 ja 102. (2) Usaldusühingu usaldusosanik vastutab ühingu maksuvõla tasumise eest vastavalt äriseadustiku §-le 132. (3) Täis- või lisavastutusega ühistu liige vastutab ühistu maksuvõla tasumise eest vastavalt tulundusühistuseaduses (RT I 2002, 3, 6) sätestatule.",
      "rdfs:label": {
        "@value": "MKS_Par_39 (redaktsioon 27810)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27810",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_39_v693740"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_39_v693740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Täisühingu osanik või usaldusühingu täisosanik vastutab täis- või usaldusühingu maksuvõla tasumise eest vastavalt äriseadustiku §-dele 101 ja 102. (2) Usaldusühingu usaldusosanik vastutab ühingu maksuvõla tasumise eest vastavalt äriseadustiku §-le 132. (3) Täis- või lisavastutusega ühistu liige vastutab ühistu maksuvõla tasumise eest vastavalt tulundusühistuseaduses (RT I 2002, 3, 6) sätestatule. [Paragrahvi 40 sõnastus kuni Eesti Vabariigi liitumiseni Euroopa Liiduga]",
      "rdfs:label": {
