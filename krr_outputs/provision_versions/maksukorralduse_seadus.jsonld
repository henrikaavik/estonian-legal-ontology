      "estleg:versionValidFrom": {
        "@value": "2008-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtte või selle osa üleandnud isik vastutab maksuvõla tasumise eest solidaarselt ettevõtte omandajaga vastavalt võlaõigusseaduses sätestatule.",
      "rdfs:label": {
        "@value": "MKS_Par_38 (redaktsioon 12911446)",
        "@language": "et"
