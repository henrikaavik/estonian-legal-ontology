      "rdfs:label": {
        "@value": "MKS_Par_14 (redaktsioon 236347)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "236347",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_14_v244789"
