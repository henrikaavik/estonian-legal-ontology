    {
      "@id": "estleg:MKS_Par_39_v22271",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Kehtetu]",
      "rdfs:label": {
        "@value": "MKS_Par_39 (redaktsioon 22271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22271",
      "estleg:supersededByVersion": {
        "@id": "estleg:MKS_Par_39_v27810"
      },
      "estleg:versionValidTo": {
