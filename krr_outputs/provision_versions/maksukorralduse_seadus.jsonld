      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MKS_Par_83_v236347",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
