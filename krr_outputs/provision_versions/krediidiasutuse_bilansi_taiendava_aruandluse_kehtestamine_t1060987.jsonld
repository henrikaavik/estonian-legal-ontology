        "@language": "et"
      },
      "estleg:versionRedactionId": "1060987",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060987",
      "estleg:sourceAct": "Krediidiasutuse bilansi täiendava aruandluse kehtestamine",
