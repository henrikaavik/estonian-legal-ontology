      }
    },
    {
      "@id": "estleg:KOKS_Par_29_v118032011005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus saab oma volitused volikogu poolt valitsuse ametisse kinnitamise päevast. (2) Valitsus esitab lahkumispalve volikogu uue koosseisu esimesel istungil. (3) Pärast lahkumispalve esitamist täidab valla- või linnavalitsus oma ülesandeid ja tema volitused kehtivad kuni uue valitsuse ametisse kinnitamiseni. (4) Kehtetu -",
      "rdfs:label": {
        "@value": "KOKS_Par_29 (redaktsioon 118032011005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032011005"
    },
    {
      "@id": "estleg:KOKS_Par_3_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohalik omavalitsus rajaneb järgmistel põhimõtetel: kohaliku elu küsimuste iseseisev ja lõplik otsustamine ja korraldamine; igaühe seaduslike õiguste ja vabaduste kohustuslik tagamine vallas ja linnas; seaduste järgimine oma ülesannete ja kohustuste täitmisel; valla- ja linnaelanike õigus osaleda kohaliku omavalitsuse teostamisel; vastutus oma ülesannete täitmise eest; tegevuse avalikkus; avalike teenuste osutamine soodsaimatel tingimustel.",
      "rdfs:label": {
        "@value": "KOKS_Par_3 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250"
    },
    {
      "@id": "estleg:KOKS_Par_30_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus: valmistab ette volikogus arutamisele tulevaid küsimusi, lähtudes valitsuse seisukohtadest või volikogu otsustest; lahendab ja korraldab kohaliku elu küsimusi, mis volikogu määruste või otsustega või valla või linna põhimäärusega on pandud täitmiseks valitsusele; lahendab ja korraldab kohaliku elu küsimusi, mis ei kuulu volikogu pädevusse; lahendab küsimusi, mis on käesoleva seaduse § 22 2. lõike alusel delegeeritud valitsusele. (2) Valitsus võib taotleda volikogu ees volikogu poolt vastuvõetud määruse või otsuse uuesti läbivaatamist.",
      "rdfs:label": {
        "@value": "KOKS_Par_30 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_30_v178159"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_30_v178159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus: valmistab ette volikogus arutamisele tulevaid küsimusi, lähtudes valitsuse seisukohtadest või volikogu otsustest; lahendab ja korraldab kohaliku elu küsimusi, mis volikogu määruste või otsustega või valla või linna põhimäärusega on pandud täitmiseks valitsusele; lahendab ja korraldab kohaliku elu küsimusi, mis ei kuulu volikogu pädevusse; lahendab küsimusi, mis on käesoleva seaduse § 22 2. lõike alusel delegeeritud valitsusele. (2) Valitsus võib taotleda volikogu ees volikogu poolt vastuvõetud määruse või otsuse uuesti läbivaatamist. (3) Valla- või linnavalitsus kehtestab oma korraldusega valla või linna asutuse poolt osutatavate teenuste hinnad, arvestades seejuures haldusmenetluse seaduse (RT I 2001, 58, 354) § 5 lõikes 3 sätestatut. (4) Käesoleva paragrahvi lõikes 3 nimetatud juhul võib linnavalitsus volitada linna ametiasutust, mis teostab avalikku võimu, kehtestama nende teenuste hinnad, mida osutab linna ametiasutuse hallatav asutus, mis ei teosta avalikku võimu. Volituse andmisel linna ametiasutusele, mis teostab avalikku võimu, on korralduse andmise õigus selle ametiasutuse juhil.",
      "rdfs:label": {
        "@value": "KOKS_Par_30 (redaktsioon 178159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178159",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_30_v822624"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_30_v822624",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus: valmistab ette volikogus arutamisele tulevaid küsimusi, lähtudes valitsuse seisukohtadest või volikogu otsustest; lahendab ja korraldab kohaliku elu küsimusi, mis volikogu määruste või otsustega või valla või linna põhimäärusega on pandud täitmiseks valitsusele; lahendab ja korraldab kohaliku elu küsimusi, mis ei kuulu volikogu pädevusse; lahendab küsimusi, mis on käesoleva seaduse § 22 2. lõike alusel delegeeritud valitsusele; korraldab kohaliku omavalitsuse ametiasutuste poolt isikute vastuvõttu märgukirjale ja selgitustaotlusele vastamise seadusega ettenähtud korras. (2) Valitsus võib taotleda volikogu ees volikogu poolt vastuvõetud määruse või otsuse uuesti läbivaatamist. (3) Valla- või linnavalitsus kehtestab oma korraldusega valla või linna asutuse poolt osutatavate teenuste hinnad, arvestades seejuures haldusmenetluse seaduse (RT I 2001, 58, 354) § 5 lõikes 3 sätestatut. (4) Käesoleva paragrahvi lõikes 3 nimetatud juhul võib linnavalitsus volitada linna ametiasutust, mis teostab avalikku võimu, kehtestama nende teenuste hinnad, mida osutab linna ametiasutuse hallatav asutus, mis ei teosta avalikku võimu. Volituse andmisel linna ametiasutusele, mis teostab avalikku võimu, on korralduse andmise õigus selle ametiasutuse juhil.",
      "rdfs:label": {
        "@value": "KOKS_Par_30 (redaktsioon 822624)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "822624",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_30_v908876"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_30_v908876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_30"
      },
      "estleg:versionValidFrom": {
