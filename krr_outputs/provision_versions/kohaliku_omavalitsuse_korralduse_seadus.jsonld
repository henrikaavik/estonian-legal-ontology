        "@language": "et"
      },
      "estleg:versionRedactionId": "118032011005"
    },
    {
      "@id": "estleg:KOKS_Par_4_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omavalitsusorganid on: volikogu - kohaliku omavalitsusüksuse esinduskogu, mis valitakse valla või linna hääleõiguslike elanike poolt kohaliku omavalitsuse volikogu valimise seaduse alusel; valitsus - volikogu poolt moodustatav täitevorgan.",
      "rdfs:label": {
        "@value": "KOKS_Par_4 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_4_v118032011005"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_4_v118032011005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omavalitsusorganid on: volikogu – kohaliku omavalitsusüksuse esinduskogu, mis valitakse valla või linna hääleõiguslike elanike poolt kohaliku omavalitsuse volikogu valimise seaduse alusel; valitsus – volikogu poolt moodustatav täitevorgan.",
      "rdfs:label": {
        "@value": "KOKS_Par_4 (redaktsioon 118032011005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032011005"
    },
    {
      "@id": "estleg:KOKS_Par_40_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volikogu ja valitsuse töö vorm on istung. Volikogu ja valitsuse komisjoni töö vorm on koosolek. [Paragrahvi 41 sõnastus kuni 20.10.2002]",
      "rdfs:label": {
        "@value": "KOKS_Par_40 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_40_v207026"
      },
      "estleg:versionValidTo": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_40_v207026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volikogu ja valitsuse töö vorm on istung. Volikogu ja valitsuse komisjoni töö vorm on koosolek.",
      "rdfs:label": {
        "@value": "KOKS_Par_40 (redaktsioon 207026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "207026"
    },
    {
      "@id": "estleg:KOKS_Par_41_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Omavalitsusorganite asjaajamiskeel on eesti keel. Igaühel on õigus pöörduda kohalike omavalitsuste ja nende ametiisikute poole eesti keeles ja saada eestikeelseid vastuseid. (2) Võõrkeelte, sealhulgas vähemusrahvuste keelte kasutamise kohalikes omavalitsustes sätestab keeleseadus (RT I 1995, 23, 334; 1996, 37, 739; 40, 773; 1997, 69, 1110; 1998, 98/99, 1618; 1999, 1, 1; 16, 275). [Paragrahvi 41 sõnastus alates 21.10.2002]",
      "rdfs:label": {
        "@value": "KOKS_Par_41 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_41_v207026"
      },
      "estleg:versionValidTo": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_41_v207026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asjaajamiskeel kohalikes omavalitsustes on eesti keel. Igaühel on õigus pöörduda kohalike omavalitsuste ja nende ametiisikute poole eesti keeles ja saada eestikeelseid vastuseid. (2) Volikogu ja valitsuse istungid toimuvad eesti keeles. (3) Võõrkeelte, sealhulgas vähemusrahvuste keelte kasutamise kohalikes omavalitsustes sätestab keeleseadus (RT I 1995, 23, 334; 1996, 37, 739; 40, 773; 1997, 69, 1110; 1998, 98/99, 1618; 1999, 1, 1; 16, 275; 2000, 51, 326; 2001, 58, 354; 65, 375; 93, 565). Keeleseaduse § 11 alusel kohaliku omavalitsuse volikogu ettepanekul antud luba kasutada vastava kohaliku omavalitsuse sisemise asjaajamise keelena omavalitsusüksuse püsielanike enamiku moodustava vähemusrahvuse keelt kehtib kuni vastava volikogu volituste lõppemiseni. (4) Kui omavalitsusüksus on vastavalt käesoleva paragrahvi 3. lõikele saanud nõusoleku kasutada sisemise asjaajamise keelena eesti keele kõrval omavalitsusüksuse püsielanike enamiku moodustava vähemusrahvuse keelt, võivad volikogu ja valitsus otsustada vastavalt volikogu ja valitsuse istungi töö osalise või täieliku tõlkimise vähemusrahvuse keelde.",
      "rdfs:label": {
        "@value": "KOKS_Par_41 (redaktsioon 207026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "207026",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_41_v908876"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_41_v908876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asjaajamiskeel kohalikes omavalitsustes on eesti keel. Igaühel on õigus pöörduda kohalike omavalitsuste ja nende ametiisikute poole eesti keeles ja saada eestikeelseid vastuseid. (2) Volikogu ja valitsuse istungid toimuvad eesti keeles. (3) Võõrkeelte, sealhulgas vähemusrahvuste keelte kasutamise kohalikes omavalitsustes sätestab keeleseadus (RT I 1995, 23, 334; 1996, 37, 739; 40, 773; 1997, 69, 1110; 1998, 98/99, 1618; 1999, 1, 1; 16, 275; 2000, 51, 326; 2001, 58, 354; 65, 375; 93, 565). Keeleseaduse § 11 alusel kohaliku omavalitsuse volikogu ettepanekul antud luba kasutada vastava kohaliku omavalitsuse sisemise asjaajamise keelena omavalitsusüksuse püsielanike enamiku moodustava vähemusrahvuse keelt kehtib kuni vastava volikogu volituste lõppemiseni. (4) Kui omavalitsusüksus on vastavalt käesoleva paragrahvi 3. lõikele saanud nõusoleku kasutada sisemise asjaajamise keelena eesti keele kõrval omavalitsusüksuse püsielanike enamiku moodustava vähemusrahvuse keelt, võivad volikogu ja valitsus otsustada vastavalt volikogu ja valitsuse istungi töö osalise või täieliku tõlkimise vähemusrahvuse keelde. [Paragrahvi 42 sõnastus kuni 16. 10. 2005]",
      "rdfs:label": {
        "@value": "KOKS_Par_41 (redaktsioon 908876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908876",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_41_v1042862"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_41_v1042862",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asjaajamiskeel kohalikes omavalitsustes on eesti keel. Igaühel on õigus pöörduda kohalike omavalitsuste ja nende ametiisikute poole eesti keeles ja saada eestikeelseid vastuseid. (2) Volikogu ja valitsuse istungid toimuvad eesti keeles. (3) Võõrkeelte, sealhulgas vähemusrahvuste keelte kasutamise kohalikes omavalitsustes sätestab keeleseadus (RT I 1995, 23, 334; 1996, 37, 739; 40, 773; 1997, 69, 1110; 1998, 98/99, 1618; 1999, 1, 1; 16, 275; 2000, 51, 326; 2001, 58, 354; 65, 375; 93, 565). Keeleseaduse § 11 alusel kohaliku omavalitsuse volikogu ettepanekul antud luba kasutada vastava kohaliku omavalitsuse sisemise asjaajamise keelena omavalitsusüksuse püsielanike enamiku moodustava vähemusrahvuse keelt kehtib kuni vastava volikogu volituste lõppemiseni. (4) Kui omavalitsusüksus on vastavalt käesoleva paragrahvi 3. lõikele saanud nõusoleku kasutada sisemise asjaajamise keelena eesti keele kõrval omavalitsusüksuse püsielanike enamiku moodustava vähemusrahvuse keelt, võivad volikogu ja valitsus otsustada vastavalt volikogu ja valitsuse istungi töö osalise või täieliku tõlkimise vähemusrahvuse keelde.",
      "rdfs:label": {
        "@value": "KOKS_Par_41 (redaktsioon 1042862)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042862",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_41_v13092924"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_41_v13092924",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asjaajamiskeel kohalikes omavalitsustes on eesti keel. Igaühel on õigus pöörduda kohalike omavalitsuste ja nende ametiisikute poole eesti keeles ja saada eestikeelseid vastuseid. (2) Volikogu ja valitsuse istungid toimuvad eesti keeles. (3) Võõrkeelte, sealhulgas vähemusrahvuste keelte kasutamise kohalikes omavalitsustes sätestab keeleseadus. Keeleseaduse § 11 alusel kohaliku omavalitsuse volikogu ettepanekul antud luba kasutada vastava kohaliku omavalitsuse sisemise asjaajamise keelena omavalitsusüksuse püsielanike enamiku moodustava vähemusrahvuse keelt kehtib kuni vastava volikogu volituste lõppemiseni. (4) Kui omavalitsusüksus on vastavalt käesoleva paragrahvi 3. lõikele saanud nõusoleku kasutada sisemise asjaajamise keelena eesti keele kõrval omavalitsusüksuse püsielanike enamiku moodustava vähemusrahvuse keelt, võivad volikogu ja valitsus otsustada vastavalt volikogu ja valitsuse istungi töö osalise või täieliku tõlkimise vähemusrahvuse keelde.",
      "rdfs:label": {
        "@value": "KOKS_Par_41 (redaktsioon 13092924)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13092924",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_41_v118032011005"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_41_v118032011005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asjaajamiskeel kohalikes omavalitsustes on eesti keel. Igaühel on õigus pöörduda kohalike omavalitsuste ja nende ametiisikute poole eesti keeles ja saada eestikeelseid vastuseid. (2) Volikogu ja valitsuse istungid toimuvad eesti keeles. (3) Võõrkeelte, sealhulgas vähemusrahvuste keelte kasutamise kohalikes omavalitsustes sätestab keeleseadus. Kohaliku omavalitsuse volikogu ettepanekul keeleseaduse § 11 alusel antud luba kasutada selle kohaliku omavalitsuse sisemise asjaajamise keelena omavalitsusüksuse püsielanike enamiku keelt kehtib kuni kõnealuse volikogu volituste lõppemiseni. (4) Kui omavalitsusüksus on vastavalt käesoleva paragrahvi 3. lõikele saanud nõusoleku kasutada sisemise asjaajamise keelena eesti keele kõrval omavalitsusüksuse püsielanike enamiku moodustava vähemusrahvuse keelt, võivad volikogu ja valitsus otsustada vastavalt volikogu ja valitsuse istungi töö osalise või täieliku tõlkimise vähemusrahvuse keelde.",
      "rdfs:label": {
        "@value": "KOKS_Par_41 (redaktsioon 118032011005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032011005"
    },
    {
      "@id": "estleg:KOKS_Par_42_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volikogu esimees: korraldab volikogu tööd, kutsub kokku ja juhatab volikogu istungeid ning korraldab nende ettevalmistamist; esindab omavalitsusüksust ja selle volikogu vastavalt seadusega, valla või linna põhimäärusega ning volikogu poolt antud pädevusele; kirjutab alla volikogu poolt vastuvõetud määrustele ja teistele volikogu dokumentidele; täidab muid talle seaduse alusel ja valla või linna põhimäärusega pandud ülesandeid.",
      "rdfs:label": {
        "@value": "KOKS_Par_42 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_42_v908876"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_42_v908876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volikogu esimees: korraldab volikogu tööd, kutsub kokku ja juhatab volikogu istungeid ning korraldab nende ettevalmistamist; esindab omavalitsusüksust ja selle volikogu vastavalt seadusega, valla või linna põhimäärusega ning volikogu poolt antud pädevusele; kirjutab alla volikogu poolt vastuvõetud määrustele ja teistele volikogu dokumentidele; täidab muid talle seaduse alusel ja valla või linna põhimäärusega pandud ülesandeid. [Paragrahvi 42 sõnastus alates 17. 10. 2005]",
      "rdfs:label": {
        "@value": "KOKS_Par_42 (redaktsioon 908876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908876",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_42_v1042862"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_42_v1042862",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu esimees: korraldab volikogu tööd, kutsub kokku ja juhatab volikogu istungeid ning korraldab nende ettevalmistamist; esindab omavalitsusüksust ja selle volikogu vastavalt seadusega, valla või linna põhimäärusega ning volikogu poolt antud pädevusele; kirjutab alla volikogu poolt vastuvõetud määrustele ja teistele volikogu dokumentidele; täidab muid talle seaduse alusel ja valla või linna põhimäärusega pandud ülesandeid. (2) Volikogu esimehe ja aseesimehe ning komisjoni esimehe ja aseesimehe volitused lõpevad samaaegselt tema volikogu liikme volituste peatumisega või ennetähtaegse lõppemisega.",
      "rdfs:label": {
        "@value": "KOKS_Par_42 (redaktsioon 1042862)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042862",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_42_v126032013006"
      },
      "estleg:versionValidTo": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_42_v126032013006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu esimees: korraldab volikogu tööd, kutsub kokku ja juhatab volikogu istungeid ning korraldab nende ettevalmistamist; esindab omavalitsusüksust ja selle volikogu vastavalt seadusega, valla või linna põhimäärusega ning volikogu poolt antud pädevusele; kirjutab alla volikogu poolt vastuvõetud määrustele ja teistele volikogu dokumentidele; annab volikogu sisemise töö korraldamiseks käskkirju; täidab muid talle seaduse alusel ja valla või linna põhimäärusega pandud ülesandeid. (2) Volikogu esimehe ja aseesimehe ning komisjoni esimehe ja aseesimehe volitused lõpevad samaaegselt tema volikogu liikme volituste peatumisega või ennetähtaegse lõppemisega.",
      "rdfs:label": {
        "@value": "KOKS_Par_42 (redaktsioon 126032013006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013006"
    },
    {
      "@id": "estleg:KOKS_Par_43_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu istungi kutsub kokku selle esimees või tema asendaja, nende puudumisel volikogu vanim liige volikogu poolt kehtestatud korras. Volikogu esimese istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast valimistulemuste väljakuulutamist. Volikogu esimese istungi ning käesoleva seaduse § 52 2. lõike alusel kokkukutsutava istungi kutse saatmisel ei ole vaja järgida käesoleva paragrahvi 3. lõikes ettenähtud nõudeid. (2) [kehtetu] (2<sup>1</sup>) Käesoleva seaduse § 52 2. lõike alusel kokkukutsutava volikogu istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast asendusliikmete määramist. (3) Volikogu kokkukutsumisel tuleb kutses ära näidata arutusele tulevad küsimused ja kutse peab olema volikogu liikmetele teatavaks tehtud vähemalt neli päeva enne volikogu istungit. (4) Volikogu esimees või tema asendaja kutsub volikogu kokku valla- või linnavalitsuse või vähemalt neljandiku volikogu koosseisu ettepanekul nende poolt tõstatatud küsimuste arutamiseks.",
      "rdfs:label": {
        "@value": "KOKS_Par_43 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_43_v782508"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_43_v782508",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu istungi kutsub kokku selle esimees või tema asendaja, nende puudumisel volikogu vanim liige volikogu poolt kehtestatud korras. Volikogu esimese istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast valimistulemuste väljakuulutamist. Volikogu esimese istungi ning käesoleva seaduse § 52 2. lõike alusel kokkukutsutava istungi kutse saatmisel ei ole vaja järgida käesoleva paragrahvi 3. lõikes ettenähtud nõudeid. (2) Kehtetu - (2<sup>1</sup>) Käesoleva seaduse § 52 2. lõike alusel kokkukutsutava volikogu istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast asendusliikmete määramist. (3) Volikogu kokkukutsumisel tuleb kutses ära näidata arutusele tulevad küsimused ja kutse peab olema volikogu liikmetele teatavaks tehtud vähemalt neli päeva enne volikogu istungit. (4) Volikogu esimees või tema asendaja kutsub volikogu kokku valla- või linnavalitsuse või vähemalt neljandiku volikogu koosseisu ettepanekul nende poolt tõstatatud küsimuste arutamiseks.",
      "rdfs:label": {
        "@value": "KOKS_Par_43 (redaktsioon 782508)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "782508",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_43_v908876"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_43_v908876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu istungi kutsub kokku selle esimees või tema asendaja, nende puudumisel volikogu vanim liige volikogu poolt kehtestatud korras. Volikogu esimese istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast valimistulemuste väljakuulutamist. Volikogu esimese istungi ning käesoleva seaduse § 52 2. lõike alusel kokkukutsutava istungi kutse saatmisel ei ole vaja järgida käesoleva paragrahvi 3. lõikes ettenähtud nõudeid. (2) Kehtetu - (2<sup>1</sup>) Käesoleva seaduse § 52 2. lõike alusel kokkukutsutava volikogu istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast asendusliikmete määramist. (3) Volikogu kokkukutsumisel tuleb kutses ära näidata arutusele tulevad küsimused ja kutse peab olema volikogu liikmetele teatavaks tehtud vähemalt neli päeva enne volikogu istungit. (4) Volikogu esimees või tema asendaja kutsub volikogu kokku valla- või linnavalitsuse või vähemalt neljandiku volikogu koosseisu ettepanekul nende poolt tõstatatud küsimuste arutamiseks. [Paragrahvi 43 sõnastus alates 17. 10. 2005]",
      "rdfs:label": {
        "@value": "KOKS_Par_43 (redaktsioon 908876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908876",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_43_v1042862"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_43_v1042862",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu istungi kutsub kokku selle esimees või tema asendaja, kelleks on aseesimees või aseesimehe puudumisel volikogu vanim liige, volikogu poolt kehtestatud korras. Volikogu esimese istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast valimistulemuste väljakuulutamist. Volikogu esimese istungi ning käesoleva seaduse § 52 2. lõike alusel kokkukutsutava istungi kutse saatmisel ei ole vaja järgida käesoleva paragrahvi 3. lõikes ettenähtud nõudeid. Sama kord kehtib ka volikogu järgmiste istungite kokkukutsumisel, kui esimesel istungil ei osutunud volikogu esimees valituks. (2) Kehtetu – (2<sup>1</sup>) Käesoleva seaduse § 52 2. lõike alusel kokkukutsutava volikogu istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast asendusliikmete määramist. (3) Volikogu kokkukutsumisel tuleb kutses ära näidata arutusele tulevad küsimused ja kutse peab olema volikogu liikmetele teatavaks tehtud vähemalt neli päeva enne volikogu istungit. Kutsega koos tehakse volikogu liikmetele kättesaadavaks istungi materjalid. (4) Volikogu esimees või tema asendaja kutsub volikogu kokku valla- või linnavalitsuse või vähemalt neljandiku volikogu koosseisu ettepanekul nende poolt tõstatatud küsimuste arutamiseks. Istungi toimumise aja määrab volikogu esimees või tema asendaja, arvestades valla või linna põhimääruses sätestatut, kuid mitte hilisemaks kui üks kuu.",
      "rdfs:label": {
        "@value": "KOKS_Par_43 (redaktsioon 1042862)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042862",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_43_v118032011005"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_43_v118032011005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu istungi kutsub kokku selle esimees või tema asendaja, kelleks on aseesimees või aseesimehe puudumisel volikogu vanim liige, volikogu poolt kehtestatud korras. Volikogu esimese istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast valimistulemuste väljakuulutamist. Volikogu esimese istungi ning käesoleva seaduse § 52 2. lõike alusel kokkukutsutava istungi kutse saatmisel ei ole vaja järgida käesoleva paragrahvi 3. lõikes ettenähtud nõudeid. Sama kord kehtib ka volikogu järgmiste istungite kokkukutsumisel, kui esimesel istungil ei osutunud volikogu esimees valituks. (2) Kehtetu - (2<sup>1</sup>) Käesoleva seaduse § 52 2. lõike alusel kokkukutsutava volikogu istungi kutsub kokku valla või linna valimiskomisjoni esimees hiljemalt seitsmendal päeval pärast asendusliikmete määramist. (3) Volikogu kokkukutsumisel tuleb kutses ära näidata arutusele tulevad küsimused ja kutse peab olema volikogu liikmetele teatavaks tehtud vähemalt neli päeva enne volikogu istungit. Kutsega koos tehakse volikogu liikmetele kättesaadavaks istungi materjalid. (4) Volikogu esimees või tema asendaja kutsub volikogu kokku valla- või linnavalitsuse või vähemalt neljandiku volikogu koosseisu ettepanekul nende poolt tõstatatud küsimuste arutamiseks. Istungi toimumise aja määrab volikogu esimees või tema asendaja, arvestades valla või linna põhimääruses sätestatut, kuid mitte hilisemaks kui üks kuu.",
      "rdfs:label": {
        "@value": "KOKS_Par_43 (redaktsioon 118032011005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032011005"
    },
    {
      "@id": "estleg:KOKS_Par_44_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu tööd korraldab ja istungeid juhatab volikogu esimees või tema asendaja. (2) Volikogu esimees korraldab vajadusel arutusele tulevate küsimuste ettevalmistamist volikogu poolt. Volikogu võib valitsusele anda ettevalmistamiseks volikogus arutusele tulevaid küsimusi. (3) Volikogu esimest istungit juhatab kuni volikogu esimehe valimiseni valla või linna valimiskomisjoni esimees. Esimese istungi päevakorras on volikogu esimehe ja aseesimehe või aseesimeeste valimine ning valitsuse lahkumispalve ärakuulamine. Sama kord kehtib ka käesoleva seaduse § 52 2. lõike alusel kokkukutsutud uue volikogu esimese istungi päevakorra suhtes, välja arvatud valitsuse lahkumispalve ärakuulamine. Volikogu esimehe ja aseesimehe valimised korraldab valla või linna valimiskomisjon ning valimistulemused tehakse kindlaks valimiskomisjoni otsusega. (4) Volikogu istungid on avalikud. Volikogu võib kuulutada istungi küsimuse arutelu osas kinniseks, kui selle poolt hääletab vähemalt kaks korda enam volikogu liikmeid kui vastu või kui küsimust puudutavate andmete avalikustamine on seadusega keelatud või piiratud. (5) Volikogu arutab istungi kutses märgitud ja volikogu poolt nõutavas korras ettevalmistatud küsimusi. (6) Volikogu istungist võivad sõnaõigusega osa võtta valla- või linnavalitsuse liikmed, valla- või linnasekretär, samuti volikogu poolt istungile kutsutud isikud. Sõna andmise otsustab istungi juhataja.",
      "rdfs:label": {
        "@value": "KOKS_Par_44 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_44_v908876"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_44_v908876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 16. 10. 2005] (1) Volikogu tööd korraldab ja istungeid juhatab volikogu esimees või tema asendaja. [Lõike 1 sõnastus alates 17. 10. 2005] (1) Volikogu tööd korraldab ja istungeid juhatab volikogu esimees või tema asendaja. Esimehe või tema asendaja puudumisel juhatab istungit kohalolevatest volikogu liikmetest vanim liige. Volikogu töökorra kehtestab volikogu. (2) Volikogu esimees korraldab vajadusel arutusele tulevate küsimuste ettevalmistamist volikogu poolt. Volikogu võib valitsusele anda ettevalmistamiseks volikogus arutusele tulevaid küsimusi. [Lõike 3 sõnastus kuni 16. 10. 2005] (3) Volikogu esimest istungit juhatab kuni volikogu esimehe valimiseni valla või linna valimiskomisjoni esimees. Esimese istungi päevakorras on volikogu esimehe ja aseesimehe või aseesimeeste valimine ning valitsuse lahkumispalve ärakuulamine. Sama kord kehtib ka käesoleva seaduse § 52 2. lõike alusel kokkukutsutud uue volikogu esimese istungi päevakorra suhtes, välja arvatud valitsuse lahkumispalve ärakuulamine. Volikogu esimehe ja aseesimehe valimised korraldab valla või linna valimiskomisjon ning valimistulemused tehakse kindlaks valimiskomisjoni otsusega. [Lõike 3 sõnastus alates 17. 10. 2005] (3) Volikogu esimest istungit juhatab kuni volikogu esimehe valimiseni valla või linna valimiskomisjoni esimees või aseesimees. Esimese istungi päevakorras on volikogu esimehe ja aseesimehe või aseesimeeste valimine ning valitsuse lahkumispalve ärakuulamine. Sama kord kehtib ka käesoleva seaduse § 52 2. lõike alusel kokkukutsutud uue volikogu esimese istungi päevakorra suhtes, välja arvatud valitsuse lahkumispalve ärakuulamine. Volikogu esimehe valimised korraldab valla või linna valimiskomisjon ning valimistulemused tehakse kindlaks valimiskomisjoni otsusega. Sama kord kehtib ka volikogu järgmistel istungitel, kui esimesel istungil ei osutunud volikogu esimees valituks. (4) Volikogu istungid on avalikud. Volikogu võib kuulutada istungi küsimuse arutelu osas kinniseks, kui selle poolt hääletab vähemalt kaks korda enam volikogu liikmeid kui vastu või kui küsimust puudutavate andmete avalikustamine on seadusega keelatud või piiratud. (5) Volikogu arutab istungi kutses märgitud ja volikogu poolt nõutavas korras ettevalmistatud küsimusi. (6) Volikogu istungist võivad sõnaõigusega osa võtta valla- või linnavalitsuse liikmed, valla- või linnasekretär, samuti volikogu poolt istungile kutsutud isikud. Sõna andmise otsustab istungi juhataja.",
      "rdfs:label": {
        "@value": "KOKS_Par_44 (redaktsioon 908876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908876",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_44_v1042862"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_44_v1042862",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu tööd korraldab ja istungeid juhatab volikogu esimees või tema asendaja. Esimehe või tema asendaja puudumisel juhatab istungit kohalolevatest volikogu liikmetest vanim liige. Volikogu töökorra kehtestab volikogu. (2) Volikogu esimees korraldab vajadusel arutusele tulevate küsimuste ettevalmistamist volikogu poolt. Volikogu võib valitsusele anda ettevalmistamiseks volikogus arutusele tulevaid küsimusi. (3) Volikogu esimest istungit juhatab kuni volikogu esimehe valimiseni valla või linna valimiskomisjoni esimees või aseesimees. Esimese istungi päevakorras on volikogu esimehe ja aseesimehe või aseesimeeste valimine ning valitsuse lahkumispalve ärakuulamine. Sama kord kehtib ka käesoleva seaduse § 52 2. lõike alusel kokkukutsutud uue volikogu esimese istungi päevakorra suhtes, välja arvatud valitsuse lahkumispalve ärakuulamine. Volikogu esimehe valimised korraldab valla või linna valimiskomisjon ning valimistulemused tehakse kindlaks valimiskomisjoni otsusega. Sama kord kehtib ka volikogu järgmistel istungitel, kui esimesel istungil ei osutunud volikogu esimees valituks. (4) Volikogu istungid on avalikud. Volikogu võib kuulutada istungi küsimuse arutelu osas kinniseks, kui selle poolt hääletab vähemalt kaks korda enam volikogu liikmeid kui vastu või kui küsimust puudutavate andmete avalikustamine on seadusega keelatud või piiratud. (5) Volikogu arutab istungi kutses märgitud ja volikogu poolt nõutavas korras ettevalmistatud küsimusi. (6) Volikogu istungist võivad sõnaõigusega osa võtta valla- või linnavalitsuse liikmed, valla- või linnasekretär, samuti volikogu poolt istungile kutsutud isikud. Sõna andmise otsustab istungi juhataja.",
      "rdfs:label": {
        "@value": "KOKS_Par_44 (redaktsioon 1042862)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042862"
    },
    {
      "@id": "estleg:KOKS_Par_45_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volikogu ainupädevusse kuuluvaid küsimusi otsustatakse hääletamise teel. Muudes küsimustes hääletatakse juhul, kui vähemalt üks volikogu liige seda nõuab. (2) Hääletamine volikogus on avalik. (3) Isikuvalimised otsustatakse salajasel hääletamisel. (4) Volikogu otsustused fikseerib istungi juhataja. [Lõike 5 sõnastus kuni 30.06.2002] (5) Volikogu otsustused tehakse poolthäälte enamusega. Käesoleva seaduse § 22 1. lõike punktides 2, 4, 6-10, 14, 15, 18 ja 24 ettenähtud küsimustes otsustuste vastuvõtmiseks on vajalik volikogu koosseisu häälteenamus. [Lõike 5 sõnastus alates 1.07.2002] (5) Volikogu otsustused tehakse poolthäälte enamusega. Käesoleva seaduse § 22 1. lõike punktides 2, 4, 6-10, 14, 15, 18 ja 24 ning põhiseaduslikkuse järelevalve kohtumenetluse seaduse §-s 7 ettenähtud küsimustes otsustuste vastuvõtmiseks on vajalik volikogu koosseisu häälteenamus.",
      "rdfs:label": {
        "@value": "KOKS_Par_45 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_45_v178159"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_45_v178159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_45"
      },
      "estleg:versionValidFrom": {
