      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Eelarve täitmise aruande kinnitab volikogu hiljemalt 1. maiks, olles eelnevalt ära kuulanud revisjonikomisjoni vastava arvamuse. Eelarve täitmise aruanne avalikustatakse valla või linna põhimääruses sätestatud korras.",
      "rdfs:label": {
        "@value": "KOKS_Par_39_1 (redaktsioon 184479)",
