        "@value": "2017-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volikogu komisjonide esimeeste ja aseesimeeste valimisel ning komisjonide koosseisude kujundamisel kohaldatakse käesoleva seaduse § 47 lõigetes 11–13 sätestatud nõudeid alates 2017. aasta kohaliku omavalitsuse volikogu korraliste valimiste valimistulemuste väljakuulutamise päevast.",
      "rdfs:label": {
        "@value": "KOKS_Par_72_2 (redaktsioon 104072017020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072017020"
    },
