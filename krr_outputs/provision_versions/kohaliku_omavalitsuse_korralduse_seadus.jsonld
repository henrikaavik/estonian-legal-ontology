        "@value": "2017-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liige võib täita valla- või linnavolikogu liikme ülesandeid alates 2017. aasta kohaliku omavalitsuse volikogu korraliste valimiste valimistulemuste väljakuulutamise päevast.",
      "rdfs:label": {
        "@value": "KOKS_Par_72_3 (redaktsioon 104072017020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072017020"
    },
