      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse korralduse seadus määrab kindlaks kohaliku omavalitsuse ülesanded, vastutuse ja korralduse ning omavalitsusüksuste suhted omavahel ja riigiorganitega.",
      "rdfs:label": {
        "@value": "KOKS_Par_1 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_1_v184479"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_1_v184479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohaliku omavalitsuse korralduse seadus määrab kindlaks kohaliku omavalitsuse ülesanded, vastutuse ja korralduse ning omavalitsusüksuste suhted omavahel ja riigiorganitega. (2) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "KOKS_Par_1 (redaktsioon 184479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184479",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_1_v693372"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_1_v693372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohaliku omavalitsuse korralduse seadus määrab kindlaks kohaliku omavalitsuse ülesanded, vastutuse ja korralduse ning omavalitsusüksuste suhted omavahel ja riigiorganitega. (1<sup>1</sup>) Kohaliku omavalitsuse korralduse erisused püsiasustusega väikesaartel on sätestatud püsiasustusega väikesaarte seaduses. (2) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "KOKS_Par_1 (redaktsioon 693372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693372",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_1_v13092924"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_1_v13092924",
      "@type": [
        "owl:NamedIndividual",
