    {
      "@id": "estleg:KOKS_Par_8_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valla või linna põhimäärus on õigusakt, milles sätestatakse antud valla või linna omavalitsusorganite, nende komisjonide ning valla või linna ametiasutuste moodustamise kord, õigused, kohustused ja töökord.",
      "rdfs:label": {
        "@value": "KOKS_Par_8 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_8_v908876"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_8_v908876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valla või linna põhimäärus on õigusakt, milles sätestatakse antud valla või linna omavalitsusorganite, nende komisjonide ning valla või linna ametiasutuste moodustamise kord, õigused, kohustused ja töökord. [Paragrahvi 8 sõnastus alates 17. 10. 2005]",
      "rdfs:label": {
        "@value": "KOKS_Par_8 (redaktsioon 908876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908876",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_8_v1042862"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_8_v1042862",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla või linna põhimääruses sätestatakse: volikogu esimehe ja aseesimehe või aseesimeeste valimise kord, volikogu komisjonide moodustamise kord, õigused ja kohustused ning volikogu komisjonide esimeeste ja aseesimeeste valimise kord; valitsuse moodustamise kord, vallavanema või linnapea valimise kord, valitsuse pädevus; valla või linna sümbolid ja nende kasutamise kord; valla või linna ametiasutuste moodustamise kord; valla või linna eelarve koostamise, vastuvõtmise, muutmise ja selle täitmise aruande läbivaatamise ja kinnitamise ning avalikustamise kord; valla või linna õigusaktide vastuvõtmise, avalikustamise ja jõustumise täpsem kord. (2) Valla või linna põhimäärus kehtestatakse volikogu määrusega ning see võib sisaldada lisaks käesoleva paragrahvi 1. lõikes sätestatule ka muid valla või linna tegevust reguleerivaid sätteid.",
      "rdfs:label": {
        "@value": "KOKS_Par_8 (redaktsioon 1042862)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042862",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_8_v117122010033"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_8_v117122010033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla või linna põhimääruses sätestatakse: volikogu esimehe ja aseesimehe või aseesimeeste valimise kord, volikogu komisjonide moodustamise kord, õigused ja kohustused ning volikogu komisjonide esimeeste ja aseesimeeste valimise kord; valitsuse moodustamise kord, vallavanema või linnapea valimise kord, valitsuse pädevus; valla või linna sümbolid ja nende kasutamise kord; valla või linna ametiasutuste moodustamise kord; valla või linna arengukava, eelarvestrateegia ja eelarve koostamise ja muutmise ning finantsjuhtimise üldised põhimõtted; valla või linna õigusaktide vastuvõtmise, avalikustamise ja jõustumise täpsem kord. (1<sup>1</sup>) Kui kohaliku omavalitsuse üksus kavandab moodustada siseaudiitori kutsetegevuse alaste ülesannete täitmiseks vastava ametikoha või vastava struktuuriüksuse, nähakse põhimääruses ette siseauditeerimise üldine töökorraldus. (2) Valla või linna põhimäärus kehtestatakse volikogu määrusega ning see võib sisaldada lisaks käesoleva paragrahvi 1. lõikes sätestatule ka muid valla või linna tegevust reguleerivaid sätteid.",
      "rdfs:label": {
        "@value": "KOKS_Par_8 (redaktsioon 117122010033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122010033",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_8_v104072017020"
      },
      "estleg:versionValidTo": {
        "@value": "2017-10-16",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_8_v104072017020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla või linna põhimääruses sätestatakse: volikogu esimehe ja aseesimehe või aseesimeeste valimise kord, volikogu komisjonide moodustamise kord, õigused ja kohustused; valitsuse moodustamise kord, vallavanema või linnapea valimise kord, valitsuse pädevus; valla või linna sümbolid ja nende kasutamise kord; valla või linna ametiasutuste moodustamise kord; valla või linna arengukava, eelarvestrateegia ja eelarve koostamise ja muutmise ning finantsjuhtimise üldised põhimõtted; valla või linna õigusaktide vastuvõtmise, avalikustamise ja jõustumise täpsem kord. (1<sup>1</sup>) Kui kohaliku omavalitsuse üksus kavandab moodustada siseaudiitori kutsetegevuse alaste ülesannete täitmiseks vastava ametikoha või vastava struktuuriüksuse, nähakse põhimääruses ette siseauditeerimise üldine töökorraldus. (2) Valla või linna põhimäärus kehtestatakse volikogu määrusega ning see võib sisaldada lisaks käesoleva paragrahvi 1. lõikes sätestatule ka muid valla või linna tegevust reguleerivaid sätteid.",
      "rdfs:label": {
        "@value": "KOKS_Par_8 (redaktsioon 104072017020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072017020",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_8_v104072017022"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_8_v104072017022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla või linna põhimääruses sätestatakse: volikogu esimehe ja aseesimehe või aseesimeeste valimise kord, volikogu komisjonide moodustamise kord, õigused ja kohustused; valitsuse moodustamise kord, vallavanema või linnapea valimise kord, valitsuse pädevus; valla või linna sümbolid ja nende kasutamise kord; valla või linna ametiasutuste ja ühisametite või -asutuste moodustamise kord; valla või linna arengukava, eelarvestrateegia ja eelarve koostamise ja muutmise ning finantsjuhtimise üldised põhimõtted; valla või linna õigusaktide vastuvõtmise, avalikustamise ja jõustumise täpsem kord. (1<sup>1</sup>) Kui kohaliku omavalitsuse üksus kavandab moodustada siseaudiitori kutsetegevuse alaste ülesannete täitmiseks vastava ametikoha või vastava struktuuriüksuse, nähakse põhimääruses ette siseauditeerimise üldine töökorraldus. (2) Valla või linna põhimäärus kehtestatakse volikogu määrusega ning see võib sisaldada lisaks käesoleva paragrahvi 1. lõikes sätestatule ka muid valla või linna tegevust reguleerivaid sätteid.",
      "rdfs:label": {
        "@value": "KOKS_Par_8 (redaktsioon 104072017022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072017022"
    },
    {
      "@id": "estleg:KOKS_Par_9_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valla või linna arengukava on dokument, mis sisaldab antud omavalitsusüksuse majandusliku ja sotsiaalse olukorra ning keskkonnaseisundi analüüsi, pikemaajalise tegevuse kavandamise ning edasise arengu suundi ja eelistusi.",
      "rdfs:label": {
        "@value": "KOKS_Par_9 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_9_v908876"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOKS_Par_9_v908876",
      "@type": [
        "owl:NamedIndividual",
