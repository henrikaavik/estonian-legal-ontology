    {
      "@id": "estleg:KOKS_Par_10_v22250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nii vald kui ka linn on avalik-õiguslik isik, keda esindavad seaduste ja omavalitsusüksuse põhimääruse alusel ning kehtestatud korras oma pädevuse piires volikogu, volikogu esimees, valla- või linnavalitsus ning vallavanem või linnapea. (2) Vallal ja linnal on avalik-õigusliku isikuna iseseisev eelarve, arveldusarve pangas ja oma sümboolika.",
      "rdfs:label": {
        "@value": "KOKS_Par_10 (redaktsioon 22250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22250",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOKS_Par_10_v178159"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      }
    },
    {
