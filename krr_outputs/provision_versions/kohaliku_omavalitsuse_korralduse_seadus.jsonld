      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 22 lõike 1 punkti 362 alusel kehtestatud koerte ja kasside pidamise eeskirjade rikkumise eest, kui see ettevaatamatusest põhjustas varalise kahju või inimesele tervisekahjustuse, –karistatakse rahatrahviga kuni 200 trahviühikut.",
      "rdfs:label": {
        "@value": "KOKS_Par_66_3 (redaktsioon 112072014079)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014079"
    },
    {
