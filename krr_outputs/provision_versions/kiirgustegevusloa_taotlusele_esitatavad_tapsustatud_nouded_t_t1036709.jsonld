        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse § 4 punkt 15 jõustub 2018. aasta 1. jaanuaril. Käesoleva määruse § 4 punkt 15 jõustub 2018. aasta 1. jaanuaril.",
      "rdfs:label": {
