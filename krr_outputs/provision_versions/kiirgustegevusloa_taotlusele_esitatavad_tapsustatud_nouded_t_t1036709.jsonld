    {
      "@id": "estleg:Reg_1036709_Par_9_v1036709",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036709_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Radioaktiivsete jäätmete ja heidete käitlemise kohta radioaktiivsete jäätmete tekitaja juures esitatakse järgmine teave: 1 1) jäätmete ja heidete tekkeviis; 2 2) jäätmete ja heidete iseloomustus; 3 3) jäätmete ja heidete käitlemisviisid; 4 4) heidete keskkonda juhtimise viisid; 5 5) radioaktiivsete jäätmete pakendite vastavusnäitajad; RT I 2019-02-06 11 106022019011 2019-02-09 6 6) jäätmete registreerimise, arvestuse ja inventuuri protseduurid; 7 7) jäätmete füüsilise kaitse meetmed; 8 8) protseduurid jäätmete üleandmiseks radioaktiivsete jäätmete vahe- või lõppladustuskohta. Radioaktiivsete jäätmete ja heidete käitlemise kohta radioaktiivsete jäätmete tekitaja juures esitatakse järgmine teave: jäätmete ja heidete tekkeviis; jäätmete ja heidete iseloomustus; jäätmete ja heidete käitlemisviisid; heidete keskkonda juhtimise viisid; radioaktiivsete jäätmete pakendite vastavusnäitajad; jäätmete registreerimise, arvestuse ja inventuuri protseduurid; jäätmete füüsilise kaitse meetmed; protseduurid jäätmete üleandmiseks radioaktiivsete jäätmete vahe- või lõppladustuskohta.",
      "rdfs:label": {
        "@value": "Reg_1036709_Par_9 (redaktsioon 1036709)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036709",
