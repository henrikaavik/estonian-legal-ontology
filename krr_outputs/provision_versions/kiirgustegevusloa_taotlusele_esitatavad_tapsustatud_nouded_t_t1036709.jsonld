    {
      "@id": "estleg:Reg_1036709_Par_24_v1036709",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036709_Par_24"
      },
