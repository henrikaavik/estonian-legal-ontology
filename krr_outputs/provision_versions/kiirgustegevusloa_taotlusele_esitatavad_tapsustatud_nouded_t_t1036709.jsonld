    {
      "@id": "estleg:Reg_1036709_Par_22_v1036709",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036709_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kiirgustegevusluba koosneb: 1 1) käesoleva määruse lisas 5 esitatud andmetest; RT I 2019-02-06 11 106022019011 2019-02-09 2 2) kiirgusseaduse § 75 lõike 1 punktides 1−6 ja 8 ning kõrgaktiivse kiirgusallikaga seotud kiirgustegevuse korral lisaks § 75 lõikes 2 loetletud andmetest. Kiirgustegevusluba koosneb: käesoleva määruse lisas 5 esitatud andmetest; kiirgusseaduse § 75 lõike 1 punktides 1−6 ja 8 ning kõrgaktiivse kiirgusallikaga seotud kiirgustegevuse korral lisaks § 75 lõikes 2 loetletud andmetest. 2 (2) Radioaktiivse aine sisse-, välja- ja läbiveo loa andmete loetelu on esitatud käesoleva määruse lisas 6. RT I 2020-06-19 1 119062020001 2020-06-22 Radioaktiivse aine sisse-, välja- ja läbiveo loa andmete loetelu on esitatud käesoleva määruse lisas 6.",
      "rdfs:label": {
        "@value": "Reg_1036709_Par_22 (redaktsioon 1036709)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036709",
