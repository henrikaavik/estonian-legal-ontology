      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndi kaitse-eesmärk on kaitsealuste liikide elupaikade, looduse mitmekesisuse ja maastikuilme säilitamine. Sihtkaitsevööndi kaitse-eesmärk on kaitsealuste liikide elupaikade, looduse mitmekesisuse ja maastikuilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_302261_Par_8 (redaktsioon 302261)",
