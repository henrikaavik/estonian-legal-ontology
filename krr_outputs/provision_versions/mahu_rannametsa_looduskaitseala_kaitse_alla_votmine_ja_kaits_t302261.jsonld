      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302261_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. 2 (2) Kaitsealal on kaks sihtkaitsevööndit: 1 1) Veskilauri sihtkaitsevöönd; 2 2) Adriku sihtkaitsevöönd. Kaitsealal on kaks sihtkaitsevööndit: Veskilauri sihtkaitsevöönd; Adriku sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_302261_Par_7 (redaktsioon 302261)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302261",
