      "estleg:sourceAct": "Mahu-Rannametsa looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_302261 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302261_Map"
      }
    },
    {
      "@id": "estleg:Reg_302261_Par_8_v302261",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302261_Par_8"
