        "@id": "estleg:Reg_1061866_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061866_Par_4_v1061866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061866_Par_4"
