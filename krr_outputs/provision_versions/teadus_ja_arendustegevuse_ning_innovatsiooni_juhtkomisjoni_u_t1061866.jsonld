      "estleg:provisionRef": "Reg_1061866 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061866_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061866_Par_3_v1061866",
      "@type": [
