      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Pangandusmääruse alusel kehtestatud järelevalveliste aruannete edastamise vorm (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Pangandusmääruse alusel kehtestatud järelevalveliste aruannete edastamise vorm"
    },
    {
      "@id": "estleg:Reg_1025150_Par_1_v1025150",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025150_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse tehnilised nõuded, mida tuleb järgida Euroopa Komisjoni rakendusmäärusega (EL) nr 2021/451, milles sätestatakse rakenduslikud tehnilised standardid Euroopa Parlamendi ja nõukogu määruse (EL) nr 575/2013 kohaldamiseks seoses krediidiasutuste ja investeerimisühingute järelevalvelise aruandlusega ning tunnistatakse kehtetuks rakendusmäärus (EL) nr 680/2014 (ELT L 97, 19.3.2021, lk 1–1955) ja Euroopa Komisjoni rakendusmäärusega (EL) nr 2021/453, millega kehtestatakse rakenduslikud tehnilised standardid Euroopa Parlamendi ja nõukogu määruse (EL) nr 575/2013 kohaldamiseks seoses tururiskidega seotud aruandluse erinõuetega (ELT L 89, 16.3.2021, lk 3–14) (edaspidi koos järelevalvelise aruandluse standard) kehtestatud järelevalveliste aruannete esitamisel Finantsinspektsioonile. RT I 2021-05-28 1 128052021001 2021-06-28 Käesoleva määrusega kehtestatakse tehnilised nõuded, mida tuleb järgida Euroopa Komisjoni rakendusmäärusega (EL) nr 2021/451, milles sätestatakse rakenduslikud tehnilised standardid Euroopa Parlamendi ja nõukogu määruse (EL) nr 575/2013 kohaldamiseks seoses krediidiasutuste ja investeerimisühingute järelevalvelise aruandlusega ning tunnistatakse kehtetuks rakendusmäärus (EL) nr 680/2014 (ELT L 97, 19.3.2021, lk 1–1955) ja Euroopa Komisjoni rakendusmäärusega (EL) nr 2021/453, millega kehtestatakse rakenduslikud tehnilised standardid Euroopa Parlamendi ja nõukogu määruse (EL) nr 575/2013 kohaldamiseks seoses tururiskidega seotud aruandluse erinõuetega (ELT L 89, 16.3.2021, lk 3–14) (edaspidi koos järelevalvelise aruandluse standard) kehtestatud järelevalveliste aruannete esitamisel Finantsinspektsioonile.",
      "rdfs:label": {
        "@value": "Reg_1025150_Par_1 (redaktsioon 1025150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025150",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025150",
      "estleg:sourceAct": "Pangandusmääruse alusel kehtestatud järelevalveliste aruannete edastamise vorm",
      "estleg:provisionRef": "Reg_1025150 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025150_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1025150_Par_2_v1025150",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025150_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse nõudeid on kohustatud järgima kõik Eestis tegutsevad krediidiasutused ja välisriikide krediidiasutuste filiaalid, kellele on järelevalvelise aruandluse standardiga kehtestatud aruandluskohustus. Määruse nõudeid on kohustatud järgima kõik Eestis tegutsevad krediidiasutused ja välisriikide krediidiasutuste filiaalid, kellele on järelevalvelise aruandluse standardiga kehtestatud aruandluskohustus.",
      "rdfs:label": {
        "@value": "Reg_1025150_Par_2 (redaktsioon 1025150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025150",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025150",
      "estleg:sourceAct": "Pangandusmääruse alusel kehtestatud järelevalveliste aruannete edastamise vorm",
      "estleg:provisionRef": "Reg_1025150 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025150_Map_2026"
      }
    },
    {
