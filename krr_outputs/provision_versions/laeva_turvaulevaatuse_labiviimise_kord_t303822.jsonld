    },
    {
      "@id": "estleg:Reg_303822_Par_8_v303822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303822_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reeder on kohustatud: 1 1) teavitama ülevaatusega seotud laevapereliikmeid ülevaatuse eesmärkidest ja ulatusest; 2 2) nimetama enda esindaja ülevaatuse ajaks; 3 3) tagama ülevaatuse läbiviimiseks vajalikud vahendid; 4 4) tagama Transpordiameti poolt nõutud tõendusmaterjalide kättesaadavuse; RT I 2023-05-09 6 109052023006 2023-05-12 5 5) tegema koostööd Transpordiametiga, et tagada ülevaatuse eesmärkide saavutamine. RT I 2023-05-09 6 109052023006 2023-05-12 Reeder on kohustatud: teavitama ülevaatusega seotud laevapereliikmeid ülevaatuse eesmärkidest ja ulatusest; nimetama enda esindaja ülevaatuse ajaks; tagama ülevaatuse läbiviimiseks vajalikud vahendid; tagama Transpordiameti poolt nõutud tõendusmaterjalide kättesaadavuse; tegema koostööd Transpordiametiga, et tagada ülevaatuse eesmärkide saavutamine.",
      "rdfs:label": {
        "@value": "Reg_303822_Par_8 (redaktsioon 303822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303822",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303822",
      "estleg:sourceAct": "Laeva turvaülevaatuse läbiviimise kord",
      "estleg:provisionRef": "Reg_303822 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_303822_Map"
      }
    },
    {
      "@id": "estleg:Reg_303822_Par_9_v303822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303822_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Transpordiamet väljastab laevale Euroopa Parlamendi ja nõukogu määruses (EÜ) nr 725/2004 toodud turvalisuse tunnistuse või ajutise turvalisuse tunnistuse pärast ISPS koodeksis sätestatud nõuetele tehtud esmast või täisülevaatust. RT I 2023-05-09 6 109052023006 2023-05-12 Transpordiamet väljastab laevale Euroopa Parlamendi ja nõukogu määruses (EÜ) nr 725/2004 toodud turvalisuse tunnistuse või ajutise turvalisuse tunnistuse pärast ISPS koodeksis sätestatud nõuetele tehtud esmast või täisülevaatust. 2 (2) Turvalisuse tunnistuse ja ajutise turvalisuse tunnistuse kinnitamise ja kehtivuse nõuded on sätestatud ISPS koodeksis. Turvalisuse tunnistuse ja ajutise turvalisuse tunnistuse kinnitamise ja kehtivuse nõuded on sätestatud ISPS koodeksis.",
      "rdfs:label": {
        "@value": "Reg_303822_Par_9 (redaktsioon 303822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303822",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303822",
      "estleg:sourceAct": "Laeva turvaülevaatuse läbiviimise kord",
      "estleg:provisionRef": "Reg_303822 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_303822_Map"
      }
    },
