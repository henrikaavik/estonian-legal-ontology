    {
      "@id": "estleg:Reg_303822_Par_3_v303822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303822_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpordiameti läbiviidava ülevaatuse eelduseks on Transpordiameti kooskõlastatud laeva turvalisuse plaani olemasolu. Kui laeva turvalisuse plaan ei vasta nõuetele, võib ülevaatuse edasi lükata seni, kuni reeder on kasutusele võtnud meetmed nõuete täitmiseks. RT I 2023-05-09 6 109052023006 2023-05-12 Transpordiameti läbiviidava ülevaatuse eelduseks on Transpordiameti kooskõlastatud laeva turvalisuse plaani olemasolu. Kui laeva turvalisuse plaan ei vasta nõuetele, võib ülevaatuse edasi lükata seni, kuni reeder on kasutusele võtnud meetmed nõuete täitmiseks.",
      "rdfs:label": {
        "@value": "Reg_303822_Par_3 (redaktsioon 303822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303822",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303822",
      "estleg:sourceAct": "Laeva turvaülevaatuse läbiviimise kord",
      "estleg:provisionRef": "Reg_303822 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_303822_Map"
      }
    },
    {
      "@id": "estleg:Reg_303822_Par_4_v303822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303822_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Turvaülevaatuse läbiviimiseks Eesti sadamas esitab reeder Transpordiametile taotluse vähemalt viis tööpäeva ning välisriigi sadamas vähemalt kümme tööpäeva enne soovitud ülevaatust. RT I 2023-05-09 6 109052023006 2023-05-12 Turvaülevaatuse läbiviimiseks Eesti sadamas esitab reeder Transpordiametile taotluse vähemalt viis tööpäeva ning välisriigi sadamas vähemalt kümme tööpäeva enne soovitud ülevaatust.",
      "rdfs:label": {
        "@value": "Reg_303822_Par_4 (redaktsioon 303822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303822",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303822",
      "estleg:sourceAct": "Laeva turvaülevaatuse läbiviimise kord",
      "estleg:provisionRef": "Reg_303822 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_303822_Map"
      }
    },
    {
      "@id": "estleg:Reg_303822_Par_5_v303822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303822_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Transpordiamet töötab kooskõlastatult reederiga välja ülevaatuse plaani. RT I 2023-05-09 6 109052023006 2023-05-12 Transpordiamet töötab kooskõlastatult reederiga välja ülevaatuse plaani. 2 (2) Transpordiamet valmistab ette vajalikud dokumendid ülevaatuse edukaks ja efektiivseks läbiviimiseks. RT I 2023-05-09 6 109052023006 2023-05-12 Transpordiamet valmistab ette vajalikud dokumendid ülevaatuse edukaks ja efektiivseks läbiviimiseks.",
      "rdfs:label": {
        "@value": "Reg_303822_Par_5 (redaktsioon 303822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303822",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303822",
      "estleg:sourceAct": "Laeva turvaülevaatuse läbiviimise kord",
      "estleg:provisionRef": "Reg_303822 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_303822_Map"
      }
    },
    {
      "@id": "estleg:Reg_303822_Par_6_v303822",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303822_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ülevaatuse kohta koostab Transpordiamet ülevaatuse aruande. RT I 2023-05-09 6 109052023006 2023-05-12 Ülevaatuse kohta koostab Transpordiamet ülevaatuse aruande. 2 (2) Ülevaatuse aruanne sisaldab ülevaatuse plaani, ülevaatuse teostajate nimesid, ülevaatuse läbiviimise aega, andmeid reederi kohta, informatsiooni märkuste, mittevastavuste ja oluliste mittevastavuste kohta. Märkus on ülevaatuse käigus tuvastatud asjaolu, mida toetab objektiivne tõend. Mittevastavus on olukord, kus objektiivsed tõendid osutavad nõuete mittetäitmisele ja mis nõuab parandusmeetmete kasutuselevõtmist. Oluline mittevastavus on tuvastatav nõuete mittetäitmine, mis kujutab tõsist ohtu laeva turvalisusele ja nõuab viivitamatut parandusmeetmete kasutuselevõtmist. Ülevaatuse aruanne sisaldab ülevaatuse plaani, ülevaatuse teostajate nimesid, ülevaatuse läbiviimise aega, andmeid reederi kohta, informatsiooni märkuste, mittevastavuste ja oluliste mittevastavuste kohta. Märkus on ülevaatuse käigus tuvastatud asjaolu, mida toetab objektiivne tõend. Mittevastavus on olukord, kus objektiivsed tõendid osutavad nõuete mittetäitmisele ja mis nõuab parandusmeetmete kasutuselevõtmist. Oluline mittevastavus on tuvastatav nõuete mittetäitmine, mis kujutab tõsist ohtu laeva turvalisusele ja nõuab viivitamatut parandusmeetmete kasutuselevõtmist. 3 (3) Ülevaatuse aruanne koostatakse kahes eksemplaris. Laeva jääb üks ülevaatuse aruande originaal ning Transpordiametile jääb teine originaal. RT I 2023-05-09 6 109052023006 2023-05-12 Ülevaatuse aruanne koostatakse kahes eksemplaris. Laeva jääb üks ülevaatuse aruande originaal ning Transpordiametile jääb teine originaal.",
      "rdfs:label": {
        "@value": "Reg_303822_Par_6 (redaktsioon 303822)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303822",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303822",
      "estleg:sourceAct": "Laeva turvaülevaatuse läbiviimise kord",
      "estleg:provisionRef": "Reg_303822 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_303822_Map"
      }
    },
    {
      "@id": "estleg:Reg_303822_Par_7_v303822",
