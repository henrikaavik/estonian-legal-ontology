      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Hüdrograafiliste mõõdistustööde loetelu, loa taotlemise, andmise ja mõõdistustöö aruande heakskiitmise kord ning nõuded mõõdistustöö tegemisele (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Hüdrograafiliste mõõdistustööde loetelu, loa taotlemise, andmise ja mõõdistustöö aruande heakskiitmise kord ning nõuded mõõdistustöö tegemisele"
    },
    {
      "@id": "estleg:Reg_1055470_Par_1_v1055470",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055470_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Transpordiameti luba on vaja järgmise veeliikluse ohutust mõjutava hüdrograafilise mõõdistustöö (edaspidi mõõdistustöö) tegemiseks: 1 1) sadama akvatooriumi ja sadama sissesõidutee ning laevatee mõõdistustöö; 2 2) süvendus-, ehitus-, lõhke- ja veekogu sügavust muutva töö järgne mõõdistustöö; 3 3) ehitusprojekti koostamiseks või navigatsioonimärgistuse rajamiseks oluliste andmete väljaselgitamiseks tehtav mõõdistustöö; 4 4) kaadamisala ja veeliiklust ohustava koha mõõdistustöö. Transpordiameti luba on vaja järgmise veeliikluse ohutust mõjutava hüdrograafilise mõõdistustöö (edaspidi mõõdistustöö) tegemiseks: sadama akvatooriumi ja sadama sissesõidutee ning laevatee mõõdistustöö; süvendus-, ehitus-, lõhke- ja veekogu sügavust muutva töö järgne mõõdistustöö; ehitusprojekti koostamiseks või navigatsioonimärgistuse rajamiseks oluliste andmete väljaselgitamiseks tehtav mõõdistustöö; kaadamisala ja veeliiklust ohustava koha mõõdistustöö. 2 (2) Transpordiameti luba ei ole vaja süvendustöö vaheetappide kontrollmõõdistuste tegemiseks, mis tehakse enne süvendustöö lõpetamist. Transpordiameti luba ei ole vaja süvendustöö vaheetappide kontrollmõõdistuste tegemiseks, mis tehakse enne süvendustöö lõpetamist.",
      "rdfs:label": {
        "@value": "Reg_1055470_Par_1 (redaktsioon 1055470)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055470",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055470",
      "estleg:sourceAct": "Hüdrograafiliste mõõdistustööde loetelu, loa taotlemise, andmise ja mõõdistustöö aruande heakskiitmise kord ning nõuded mõõdistustöö tegemisele",
      "estleg:provisionRef": "Reg_1055470 § 1",
