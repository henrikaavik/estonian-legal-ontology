    {
      "@id": "estleg:Reg_1057187_Par_11_v1057187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057187_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium esitab Euroopa Komisjonile ülevaate §-s 10 nimetatud hindamistest ja hindamisaruannetest koos seirekomisjoni arvamusega hiljemalt üks kuu enne Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2115 artiklis 136 nimetatud strateegiakava tulemuslikkuse iga-aastast läbivaatamiskoosolekut Euroopa Komisjoniga. Ministeerium esitab Euroopa Komisjonile ülevaate §-s 10 nimetatud hindamistest ja hindamisaruannetest koos seirekomisjoni arvamusega hiljemalt üks kuu enne Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2115 artiklis 136 nimetatud strateegiakava tulemuslikkuse iga-aastast läbivaatamiskoosolekut Euroopa Komisjoniga.",
      "rdfs:label": {
        "@value": "Reg_1057187_Par_11 (redaktsioon 1057187)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057187",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057187",
      "estleg:sourceAct": "„Euroopa Liidu ühise põllumajanduspoliitika Eesti strateegiakava aastateks 2023–2027” seire ja hindamine",
      "estleg:provisionRef": "Reg_1057187 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057187_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057187_Par_12_v1057187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057187_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ministeerium tagab, et hindaja teeb strateegiakava põhjaliku järelhindamise hiljemalt Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2115 artikli 140 lõikes 6 sätestatud kuupäevaks. Hindaja koostab järelhindamise tulemuste põhjal järelhindamise aruande ja esitab selle ministeeriumile. Ministeerium tagab, et hindaja teeb strateegiakava põhjaliku järelhindamise hiljemalt Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2115 artikli 140 lõikes 6 sätestatud kuupäevaks. Hindaja koostab järelhindamise tulemuste põhjal järelhindamise aruande ja esitab selle ministeeriumile. 2 (2) Ministeerium esitab järelhindamise aruande Euroopa Komisjonile. Ministeerium esitab järelhindamise aruande Euroopa Komisjonile.",
      "rdfs:label": {
        "@value": "Reg_1057187_Par_12 (redaktsioon 1057187)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057187",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057187",
      "estleg:sourceAct": "„Euroopa Liidu ühise põllumajanduspoliitika Eesti strateegiakava aastateks 2023–2027” seire ja hindamine",
      "estleg:provisionRef": "Reg_1057187 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057187_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057187_Par_13_v1057187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057187_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ministeerium või hindaja avalikustab ning säilitab §-des 10 ja 12 nimetatud strateegiakava hindamise aruanded oma veebilehel. Ministeerium või hindaja avalikustab ning säilitab §-des 10 ja 12 nimetatud strateegiakava hindamise aruanded oma veebilehel. 2 (2) Hindajad levitavad üldsusele §-des 10 ja 12 nimetatud strateegiakava hindamise tulemusi. Hindajad levitavad üldsusele §-des 10 ja 12 nimetatud strateegiakava hindamise tulemusi.",
      "rdfs:label": {
        "@value": "Reg_1057187_Par_13 (redaktsioon 1057187)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057187",
