      "estleg:versionValidFrom": {
        "@value": "2019-09-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 8. juuni 2018. a käskkirjaga nr 1-2/18/466 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 8. juuni 2018. a käskkirjaga nr 1-2/18/466 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1047663_Par_20 (redaktsioon 1047663)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047663",
