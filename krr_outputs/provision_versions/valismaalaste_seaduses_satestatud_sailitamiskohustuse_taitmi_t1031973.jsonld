      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Välismaalaste seaduses sätestatud säilitamiskohustuse täitmiseks vajalike andmete ja dokumentide loetelu (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Välismaalaste seaduses sätestatud säilitamiskohustuse täitmiseks vajalike andmete ja dokumentide loetelu"
    },
    {
      "@id": "estleg:Reg_1031973_Par_1_v1031973",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031973_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalaste seaduse § 286 lõikes 4 sätestatud säilitamiskohustuse täitmiseks vajalikud andmed ja dokumendid on: 1 1) koopia välismaalasele lühiajaliseks töötamiseks antavast viisakleebisest, tööandjale väljastatavast välismaalase lühiajalise töötamise registreerimise kinnitusest ja välismaalase reisidokumendi kõigist kannetega lehekülgedest; 2 2) koopia välismaalase elamisloakaardi või isikutunnistuse mõlemast küljest; 3 3) koopia riigikaitseseaduse § 36 lõikes 1 nimetatud loast Eesti Vabariigi territooriumil viibiva välisriigi relvajõudude liikmele; 4 4) koopia varjupaigataotleja tunnistusele kantud loast Eestis töötada; 5 5) koopia kohtumäärusest, mis tõendab välismaalase viibimist kinnipidamisasutuses kinnipeetava, vahistatu või arestialusena või 6 6) koopia välismaalase Schengeni konventsiooni liikmesriigi pädeva asutuse antud viisakleebisest või elamisloakaardist, kui välismaalane töötab Eestis välismaalaste seaduse § 105 lõike 4 alusel. Välismaalaste seaduse § 286 lõikes 4 sätestatud säilitamiskohustuse täitmiseks vajalikud andmed ja dokumendid on: koopia välismaalasele lühiajaliseks töötamiseks antavast viisakleebisest, tööandjale väljastatavast välismaalase lühiajalise töötamise registreerimise kinnitusest ja välismaalase reisidokumendi kõigist kannetega lehekülgedest; koopia välismaalase elamisloakaardi või isikutunnistuse mõlemast küljest; koopia riigikaitseseaduse § 36 lõikes 1 nimetatud loast Eesti Vabariigi territooriumil viibiva välisriigi relvajõudude liikmele; koopia varjupaigataotleja tunnistusele kantud loast Eestis töötada; koopia kohtumäärusest, mis tõendab välismaalase viibimist kinnipidamisasutuses kinnipeetava, vahistatu või arestialusena või koopia välismaalase Schengeni konventsiooni liikmesriigi pädeva asutuse antud viisakleebisest või elamisloakaardist, kui välismaalane töötab Eestis välismaalaste seaduse § 105 lõike 4 alusel.",
      "rdfs:label": {
        "@value": "Reg_1031973_Par_1 (redaktsioon 1031973)",
        "@language": "et"
