      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Liiklusregistri elektroonsetele andmetele juurdepääsu kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Liiklusregistri elektroonsetele andmetele juurdepääsu kord"
    },
    {
      "@id": "estleg:Reg_1001126_Par_1_v1001126",
      "@type": [
        "owl:NamedIndividual",
