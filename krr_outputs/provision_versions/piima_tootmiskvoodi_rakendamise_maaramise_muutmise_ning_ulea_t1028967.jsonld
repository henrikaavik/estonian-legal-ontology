      }
    },
    {
      "@id": "estleg:Reg_1028967_Par_13_v1028967",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028967_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Põllumajandustootja kannab individuaalse kvoodi ületamise eest arvestatud tasu komisjoni määruse (EÜ) nr 595/2004 artikli 15 lõikes 1 sätestatud tähtajaks üle PRIA määratud arvelduskontole. Põllumajandustootja kannab individuaalse kvoodi ületamise eest arvestatud tasu komisjoni määruse (EÜ) nr 595/2004 artikli 15 lõikes 1 sätestatud tähtajaks üle PRIA määratud arvelduskontole. 2 (2) Põllumajandustootjalt ei nõuta individuaalse kvoodi ületamise eest arvestatud tasu maksmist, kui tasu suurus ei ületa 100 eurot. Põllumajandustootjalt ei nõuta individuaalse kvoodi ületamise eest arvestatud tasu maksmist, kui tasu suurus ei ületa 100 eurot. 3 (3) Paragrahvi 12 alusel ajatatud tasu kannab põllumajandustootja komisjoni määruse (EÜ) nr 595/2004 artikli 15 lõikes 1 sätestatud tingimustel ja tähtaegadeks üle kolmes osas. RT I 2015-06-26 28 126062015028 2015-06-29 Paragrahvi 12 alusel ajatatud tasu kannab põllumajandustootja komisjoni määruse (EÜ) nr 595/2004 artikli 15 lõikes 1 sätestatud tingimustel ja tähtaegadeks üle kolmes osas.",
      "rdfs:label": {
        "@value": "Reg_1028967_Par_13 (redaktsioon 1028967)",
        "@language": "et"
      },
