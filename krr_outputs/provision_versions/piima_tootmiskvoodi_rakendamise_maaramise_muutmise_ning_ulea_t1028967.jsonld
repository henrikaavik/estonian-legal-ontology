    {
      "@id": "estleg:Reg_1028967_Par_8_v1028967",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028967_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) KN-kaubakoodidega 0401 1090, 0401 2019, 0401 2099, 0401 3019, 0401 3039 või 0401 3099 kauba Eestist teise Euroopa Liidu liikmesriiki toimetamise korral peab saadetisega olema kaasas lähetava kokkuostja kinnitus selle kauba kvoodiarvestusse kaasamise kohta. KN-kaubakoodidega 0401 1090, 0401 2019, 0401 2099, 0401 3019, 0401 3039 või 0401 3099 kauba Eestist teise Euroopa Liidu liikmesriiki toimetamise korral peab saadetisega olema kaasas lähetava kokkuostja kinnitus selle kauba kvoodiarvestusse kaasamise kohta. 2 (2) Lõikes 1 nimetatud kaubakoodiga kauba teisest liikmesriigist Eestisse toimetamise korral peab saadetisega olema kaasas lähetajariigi kokkuostja kinnitus selle kauba kvoodiarvestusse kaasamise kohta. Lõikes 1 nimetatud kaubakoodiga kauba teisest liikmesriigist Eestisse toimetamise korral peab saadetisega olema kaasas lähetajariigi kokkuostja kinnitus selle kauba kvoodiarvestusse kaasamise kohta.",
      "rdfs:label": {
        "@value": "Reg_1028967_Par_8 (redaktsioon 1028967)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028967",
