    {
      "@id": "estleg:Reg_1040317_Par_4_v1040317",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040317_Par_4"
      },
