    {
      "@id": "estleg:AVRS_Par_17_v119122012008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Registrikaardile kantakse järgmised andmed: registrikaardi number; abikaasade ees- ja perekonnanimed; mõlema abikaasa isikukood, selle puudumisel sünniaeg; kande jooksev number; seaduses sätestatud juhtudel varasuhte liik, varasuhte muutmine või lõppemine, samuti esemed või teatavasse liiki kuuluvad esemed, mis on abieluvaralepinguga tunnistatud ühisvaraks või lahusvaraks; abikaasade varaliste õiguste suhtes välisriigi seaduse kohaldamine ja viide abieluvaralepingule, millega vastav kokkulepe sõlmiti; kande alus, kande tegemise kuupäev, kande teinud isiku nimi ja ametinimetus ning märked; muud seaduses sätestatud andmed. (3) Kehtetu - (4) Kehtetu -",
      "rdfs:label": {
        "@value": "AVRS_Par_17 (redaktsioon 119122012008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119122012008",
