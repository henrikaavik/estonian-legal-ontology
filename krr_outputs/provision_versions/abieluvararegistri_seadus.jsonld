      }
    },
    {
      "@id": "estleg:AVRS_Par_42_v119122012008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) võib abieluvararegistrit pidada arvutis. (2) Kui abieluvararegistrit peetakse arvutis, tuleb kehtivad kanded säilitada väljatrükkidena. (3) Arvutis peetava abieluvararegistri kanne on tehtud, kui see on salvestatud abieluvararegistri kannetele määratud andmebaasis.",
      "rdfs:label": {
        "@value": "AVRS_Par_42 (redaktsioon 119122012008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119122012008",
