      },
      "estleg:versionValidFrom": {
        "@value": "2006-02-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu – – jõst 4.02.2006",
      "rdfs:label": {
        "@value": "AVRS_Par_25 (redaktsioon 992331)",
        "@language": "et"
      },
