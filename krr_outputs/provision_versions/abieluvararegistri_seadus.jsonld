    {
      "@id": "estleg:AVRS_Par_31_v22344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kanneteks ei piisa registrikaardi esi- ja tagaküljest, avatakse uus registrikaart. Esimese registrikaardi tagakülje kolmandasse veergu tehakse märge \"Jätkub abiregistrikaardil\" ning abikaardi numbri juurde märge \"Abiregistrikaart\" ning kolmandasse veergu märge \"Esimese registrikaardi järg\". Abiregistrikaart saab jätkatava registrikaardi numbri.",
      "rdfs:label": {
        "@value": "AVRS_Par_31 (redaktsioon 22344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22344",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVRS_Par_31_v13334176"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_31_v13334176",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kanneteks ei piisa registrikaardi esi- ja tagaküljest, avatakse uus registrikaart. Esimese registrikaardi tagakülje kolmandasse veergu tehakse märge «Jätkub abiregistrikaardil» ning abikaardi numbri juurde märge «Abiregistrikaart» ning kolmandasse veergu märge «Esimese registrikaardi järg». Abiregistrikaart saab jätkatava registrikaardi numbri.",
      "rdfs:label": {
        "@value": "AVRS_Par_31 (redaktsioon 13334176)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334176",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVRS_Par_31_v119122012008"
      },
      "estleg:versionValidTo": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_31_v119122012008",
      "@type": [
        "owl:NamedIndividual",
