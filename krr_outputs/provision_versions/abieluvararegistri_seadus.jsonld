        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_25_v12895570",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_25"
      },
      "estleg:versionValidFrom": {
