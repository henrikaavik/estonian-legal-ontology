    },
    {
      "@id": "estleg:AVRS_Par_41_v22344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1996. aasta 1. septembril.",
      "rdfs:label": {
        "@value": "AVRS_Par_41 (redaktsioon 22344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22344"
    },
    {
      "@id": "estleg:AVRS_Par_41_1_v22344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_41_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni kohtunikuabi kohad on osaliselt või täielikult täitmata, võivad kandeotsuseid ette valmistada justiitsministri poolt kinnistusraamatuseaduse alusel ametisse nimetatud kandeotsuse tegemise õiguseta kinnistussekretärid. Kandeotsuse teevad sel juhul kohtu esimehe poolt määratud kohtunikud.",
      "rdfs:label": {
        "@value": "AVRS_Par_41_1 (redaktsioon 22344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22344",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVRS_Par_41_1_v928185"
      },
      "estleg:versionValidTo": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      }
    },
    {
