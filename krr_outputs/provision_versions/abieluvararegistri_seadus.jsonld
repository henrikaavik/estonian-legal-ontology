      }
    },
    {
      "@id": "estleg:AVRS_Par_33_v13335177",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui avaldus jäetakse rahuldamata, tagastatakse avaldajale avaldus ning koos sellega esitatud dokumendid. (2) Avalduse täielikul või osalisel rahuldamata jätmisel tagastatakse tasutud lõiv ja avaldamise kulud registripidaja määruse alusel. Tagastatavast lõivust arvatakse maha menetluse tegelikud kulud, mis on 1/4 tasutud lõivust, kuid mitte üle 5 euro.",
      "rdfs:label": {
        "@value": "AVRS_Par_33 (redaktsioon 13335177)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335177",
      "estleg:supersededByVersion": {
