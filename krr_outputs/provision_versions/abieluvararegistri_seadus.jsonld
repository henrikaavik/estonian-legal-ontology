      }
    },
    {
      "@id": "estleg:AVRS_Par_33_v119122012008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AVRS_Par_33 (redaktsioon 119122012008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119122012008"
    },
    {
      "@id": "estleg:AVRS_Par_34_v22344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui registrikaardil ei ole kehtivaid kandeid, kriipsutatakse kaart diagonaalse punase joonega läbi ning kolmandasse veergu tehakse märge sulgemise kohta. Sulgemise märkes näidatakse sulgemise alus ja kuupäev ning märkele kirjutab alla sekretär. (2) Suletud registrikaart tuleb registrikartoteegist eraldada ning säilitada arhiivkartoteegis.",
      "rdfs:label": {
        "@value": "AVRS_Par_34 (redaktsioon 22344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22344",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVRS_Par_34_v119122012008"
      },
      "estleg:versionValidTo": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_34_v119122012008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Kui registrikaardil ei ole kehtivaid kandeid, tehakse sellele märge sulgemise kohta. Sulgemise märkes näidatakse sulgemise alus ja kuupäev ning märke teinud isiku nimi ja ametinimetus. (4) Suletud registrikaarti peab olema võimalik taasesitada.",
      "rdfs:label": {
        "@value": "AVRS_Par_34 (redaktsioon 119122012008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119122012008",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVRS_Par_34_v105122014039"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_34_v105122014039",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Kui registrikaardil ei ole kehtivaid kandeid, tehakse sellele märge sulgemise kohta. Sulgemise märkes näidatakse sulgemise alus ja kuupäev ning märke teinud isiku nimi ja ametinimetus. (3<sup>1</sup>) Registrikaart suletakse alati, kui registripidaja saab teada abielu lõppemise faktist. (3<sup>2</sup>) Tehniliste võimaluste korral suletakse registrikaart automaatselt. (4) Suletud registrikaarti peab olema võimalik taasesitada.",
      "rdfs:label": {
        "@value": "AVRS_Par_34 (redaktsioon 105122014039)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014039",
