    {
      "@id": "estleg:AVRS_Par_42_v22344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Justiitsministri määramisel võib registrit pidada arvutis. (2) Kui registrit peetakse arvutis, tuleb kehtivad kanded säilitada väljatrükkidena. (3) Arvutis peetava registri kanne on tehtud, kui see on salvestatud registri kannetele määratud andmebaasis.",
      "rdfs:label": {
        "@value": "AVRS_Par_42 (redaktsioon 22344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22344",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVRS_Par_42_v928185"
      },
      "estleg:versionValidTo": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      }
    },
    {
