    },
    {
      "@id": "estleg:AVRS_Par_1_v22344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_1"
