      },
      "estleg:versionValidTo": {
        "@value": "2015-02-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_42_v105122014039",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
