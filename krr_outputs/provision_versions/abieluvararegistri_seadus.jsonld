        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_17_v928185",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
