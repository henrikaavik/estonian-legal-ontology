      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AVRS_Par_24 (redaktsioon 104072017076)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072017076"
    },
    {
      "@id": "estleg:AVRS_Par_25_v22344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kandeotsuses märgitakse: kohus ja otsuse teinud isiku nimi; otsuse tegemise aeg ja koht; kande tekst; viide registrikaardile ja veerule, kuhu kanne tehakse; kellele tehakse otsus teatavaks ning kus avaldatakse kanne; kui avaldus jäetakse rahuldamata - otsuse põhistus ja õiguslik alus; otsuse peale edasikaebamise kord ja tähtaeg.",
      "rdfs:label": {
        "@value": "AVRS_Par_25 (redaktsioon 22344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22344",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVRS_Par_25_v928185"
      },
      "estleg:versionValidTo": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_25_v928185",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVRS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kandemääruses märgitakse: kohus ja otsuse teinud isiku nimi; otsuse tegemise aeg ja koht; kande tekst; viide registrikaardile ja veerule, kuhu kanne tehakse; kellele tehakse otsus teatavaks ning kus avaldatakse kanne; kui avaldus jäetakse rahuldamata - otsuse põhistus ja õiguslik alus; otsuse peale edasikaebamise kord ja tähtaeg.",
      "rdfs:label": {
        "@value": "AVRS_Par_25 (redaktsioon 928185)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928185",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVRS_Par_25_v992331"
      },
      "estleg:versionValidTo": {
        "@value": "2006-02-04",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_25_v992331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
