      },
      "estleg:versionValidTo": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_34_v109052017006",
      "@type": [
        "owl:NamedIndividual",
