        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVRS_Par_17_v109052017006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
