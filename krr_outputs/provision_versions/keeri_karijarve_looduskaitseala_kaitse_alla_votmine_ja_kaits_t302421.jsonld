      }
    },
    {
      "@id": "estleg:Reg_302421_Par_8_v302421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302421_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kõia sihtkaitsevööndi kaitse-eesmärk on metsa ökosüsteemi arengu tagamine üksnes loodusliku protsessina. Kõia sihtkaitsevööndi kaitse-eesmärk on metsa ökosüsteemi arengu tagamine üksnes loodusliku protsessina. 2 (2) Võsivere ja Meeri sihtkaitsevööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine. Võsivere ja Meeri sihtkaitsevööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine. 3 (3) Sihtkaitsevööndite metsakoosluste kaitse-eesmärk on kasvukohatüübile iseloomuliku liikide koosseisu säilitamine. Sihtkaitsevööndite metsakoosluste kaitse-eesmärk on kasvukohatüübile iseloomuliku liikide koosseisu säilitamine.",
      "rdfs:label": {
        "@value": "Reg_302421_Par_8 (redaktsioon 302421)",
        "@language": "et"
      },
