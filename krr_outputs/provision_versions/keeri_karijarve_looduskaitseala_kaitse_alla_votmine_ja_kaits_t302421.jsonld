    },
    {
      "@id": "estleg:Reg_302421_Par_15_v302421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302421_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 2 2) uuendusraie, välja arvatud turberaie perioodiga vähemalt 40 aastat, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 3 3) puidu kokku- ja väljavedu külmumata pinnasel; 4 4) puhtpuistute kujundamine ja energiapuistute rajamine; 5 5) maavara kaevandamine, välja arvatud kinnisasja omanikul oma kinnisasja piires isikliku majapidamise tarbeks kaitseala valitsejaga kooskõlastatud kohas; 6 6) biotsiidi ja taimekaitsevahendi kasutamine väljaspool õuemaad; 7 7) uue maaparandussüsteemi rajamine. Piiranguvööndis on keelatud: veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; uuendusraie, välja arvatud turberaie perioodiga vähemalt 40 aastat, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel; puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine, välja arvatud kinnisasja omanikul oma kinnisasja piires isikliku majapidamise tarbeks kaitseala valitsejaga kooskõlastatud kohas; biotsiidi ja taimekaitsevahendi kasutamine väljaspool õuemaad; uue maaparandussüsteemi rajamine.",
      "rdfs:label": {
        "@value": "Reg_302421_Par_15 (redaktsioon 302421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302421",
      "estleg:sourceAct": "Keeri-Karijärve looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_302421 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302421_Map_2026"
      }
    },
    {
