      }
    },
    {
      "@id": "estleg:Reg_302421_Par_7_v302421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302421_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. Sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. 2 (2) Kaitsealal on kolm sihtkaitsevööndit: 1 1) Kõia sihtkaitsevöönd; 2 2) Võsivere sihtkaitsevöönd; 3 3) Meeri sihtkaitsevöönd. Kaitsealal on kolm sihtkaitsevööndit: Kõia sihtkaitsevöönd; Võsivere sihtkaitsevöönd; Meeri sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_302421_Par_7 (redaktsioon 302421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302421",
