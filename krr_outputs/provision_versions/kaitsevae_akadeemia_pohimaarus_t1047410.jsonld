    {
      "@id": "estleg:Reg_1047410_Par_11_v1047410",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047410_Par_11"
