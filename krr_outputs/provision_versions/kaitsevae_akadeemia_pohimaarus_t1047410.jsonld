    {
      "@id": "estleg:Reg_1047410_Par_5_v1047410",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047410_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Akadeemia põhiülesanne on valmistada ette Kaitseväe ülemaid ja arendada sõjateadust, et tagada Kaitseväe juhtimisalane jätkusuutlikkus. Akadeemia põhiülesanne on valmistada ette Kaitseväe ülemaid ja arendada sõjateadust, et tagada Kaitseväe juhtimisalane jätkusuutlikkus. 2 (2) Akadeemia tegevusvaldkonnad põhiülesande täitmiseks on: 1 1) kõrgharidustaseme õppe ja kutseõppe läbiviimine; 2 2) täienduskoolituse läbiviimine; 3 3) riigikaitsega seotud teadus- ja arendustegevus. Akadeemia tegevusvaldkonnad põhiülesande täitmiseks on: kõrgharidustaseme õppe ja kutseõppe läbiviimine; täienduskoolituse läbiviimine; riigikaitsega seotud teadus- ja arendustegevus.",
      "rdfs:label": {
        "@value": "Reg_1047410_Par_5 (redaktsioon 1047410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047410",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047410",
      "estleg:sourceAct": "Kaitseväe Akadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1047410 § 5",
