        "@value": "2023-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõunike kogu on akadeemiat ja ühiskonda ühendav nõuandev kogu. Nõunike kogu moodustamisele, töökorrale ja liikmetele kohaldatakse kõrgharidusseaduse §-s 26 sätestatut. Nõunike kogu on akadeemiat ja ühiskonda ühendav nõuandev kogu. Nõunike kogu moodustamisele, töökorrale ja liikmetele kohaldatakse kõrgharidusseaduse §-s 26 sätestatut.",
      "rdfs:label": {
        "@value": "Reg_1047410_Par_10 (redaktsioon 1047410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047410",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047410",
      "estleg:sourceAct": "Kaitseväe Akadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1047410 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047410_Map"
