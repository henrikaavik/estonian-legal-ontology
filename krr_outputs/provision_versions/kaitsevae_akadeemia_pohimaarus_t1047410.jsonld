      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Akadeemia koosseisus olevate ameti- ja töökohtade arvu ning liigituse kehtestab Kaitseväe juhataja. Akadeemia koosseisus olevate ameti- ja töökohtade arvu ning liigituse kehtestab Kaitseväe juhataja. 2 (2) Akadeemia koosseisus oleva ametikoha ametijuhendi kehtestab akadeemia ülem. Akadeemia koosseisus oleva ametikoha ametijuhendi kehtestab akadeemia ülem. 3 (3) Akadeemia ülema ametijuhendi kehtestab Kaitseväe juhataja. RT I 2022-02-05 3 105022022003 2022-02-08 Akadeemia ülema ametijuhendi kehtestab Kaitseväe juhataja.",
      "rdfs:label": {
        "@value": "Reg_1047410_Par_14 (redaktsioon 1047410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047410",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047410",
