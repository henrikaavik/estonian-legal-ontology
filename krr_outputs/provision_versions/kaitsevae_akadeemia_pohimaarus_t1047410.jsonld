    {
      "@id": "estleg:Reg_1047410_Par_15_v1047410",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047410_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakenduskõrgharidus- ja magistriõppe läbiviimise aluseks on õppekavad, mis vastavad Vabariigi Valitsuse määrusega kehtestatud kõrgharidusstandardile, on kinnitatud akadeemia nõukogus ning kantud Eesti Vabariigi haridusseaduse alusel asutatud Eesti Hariduse Infosüsteemi. Rakenduskõrgharidus- ja magistriõppe läbiviimise aluseks on õppekavad, mis vastavad Vabariigi Valitsuse määrusega kehtestatud kõrgharidusstandardile, on kinnitatud akadeemia nõukogus ning kantud Eesti Vabariigi haridusseaduse alusel asutatud Eesti Hariduse Infosüsteemi. 2 (2) Kutseõppe läbiviimise aluseks on akadeemia kutseõppe õppekava, mis on koostatud Vabariigi Valitsuse määrusega kehtestatud kutseharidusstandardi ja asjakohaste kutsestandardite alusel, kinnitatud akadeemia ülema poolt ning kantud Eesti Vabariigi haridusseaduse alusel asutatud Eesti Hariduse Infosüsteemi. Kutseõppe läbiviimise aluseks on akadeemia kutseõppe õppekava, mis on koostatud Vabariigi Valitsuse määrusega kehtestatud kutseharidusstandardi ja asjakohaste kutsestandardite alusel, kinnitatud akadeemia ülema poolt ning kantud Eesti Vabariigi haridusseaduse alusel asutatud Eesti Hariduse Infosüsteemi. 3 (3) Akadeemia õppetöö üksikasjalik korraldus sätestatakse akadeemia õppekorralduseeskirjas ning teistes tasemeõpet ja täienduskoolitust reguleerivates õigusaktides. Akadeemia õppetöö üksikasjalik korraldus sätestatakse akadeemia õppekorralduseeskirjas ning teistes tasemeõpet ja täienduskoolitust reguleerivates õigusaktides.",
      "rdfs:label": {
        "@value": "Reg_1047410_Par_15 (redaktsioon 1047410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047410",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047410",
      "estleg:sourceAct": "Kaitseväe Akadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1047410 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047410_Map"
      }
