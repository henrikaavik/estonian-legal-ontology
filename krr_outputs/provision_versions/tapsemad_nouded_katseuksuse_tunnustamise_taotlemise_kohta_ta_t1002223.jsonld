      "estleg:provisionRef": "Reg_1002223 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002223_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002223_Par_2_v1002223",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002223_Par_2"
