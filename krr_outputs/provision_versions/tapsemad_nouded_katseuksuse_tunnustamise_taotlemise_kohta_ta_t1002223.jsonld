      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandus- ja Toiduamet peab arvestust taotluste, esitatud andmete ja dokumentide ning katseüksuse tunnustamise ja tunnustamisest keeldumise otsuste üle ning säilitab neid kümme aastat. RT I 2020-11-04 1 104112020001 2021-01-01 Põllumajandus- ja Toiduamet peab arvestust taotluste, esitatud andmete ja dokumentide ning katseüksuse tunnustamise ja tunnustamisest keeldumise otsuste üle ning säilitab neid kümme aastat.",
      "rdfs:label": {
        "@value": "Reg_1002223_Par_5 (redaktsioon 1002223)",
        "@language": "et"
      },
