      "estleg:versionValidFrom": {
        "@value": "2020-10-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tunnustatud katseüksus esitab „Taimekaitseseaduse” § 641 lõikes 6 sätestatud teavitamiskohustuse täitmiseks Põllumajandus- ja Toiduametile järgmised andmed: RT I 2020-11-04 1 104112020001 2021-01-01 1 1) katse tähis; 2 2) katse valdkond; 3 3) katse tegemise koht; 4 4) katsetatav taimekaitsevahend; 5 5) katse eesmärk; 6 6) tellija nimi ja aadress; 7 7) katselapi pindala ning katse kogupindala; 8 8) katse variantide ja korduste arv; 9 9) katses kasutatud taimekultuurid; 10 10) katse eest vastutav isik. Tunnustatud katseüksus esitab „Taimekaitseseaduse” § 641 lõikes 6 sätestatud teavitamiskohustuse täitmiseks Põllumajandus- ja Toiduametile järgmised andmed: katse tähis; katse valdkond; katse tegemise koht; katsetatav taimekaitsevahend; katse eesmärk; tellija nimi ja aadress; katselapi pindala ning katse kogupindala; katse variantide ja korduste arv; katses kasutatud taimekultuurid; katse eest vastutav isik.",
      "rdfs:label": {
        "@value": "Reg_1002223_Par_4 (redaktsioon 1002223)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002223",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002223",
      "estleg:sourceAct": "Täpsemad nõuded katseüksuse tunnustamise taotlemise kohta, taotluse sisu- ja vorminõuded ning taotluse menetlemise kord",
      "estleg:provisionRef": "Reg_1002223 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002223_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002223_Par_5_v1002223",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
