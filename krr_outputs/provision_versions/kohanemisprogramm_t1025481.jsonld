        "@value": "2026-03-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 2015. aasta 1. augustil. Määrus jõustub 2015. aasta 1. augustil.",
      "rdfs:label": {
        "@value": "Reg_1025481_Par_10 (redaktsioon 1025481)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025481",
