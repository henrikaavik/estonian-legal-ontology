    {
      "@id": "estleg:Reg_1002218_Par_1_1_v1002218",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002218_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööstusomandi apellatsioonikomisjon (edaspidi apellatsioonikomisjon) on Patendiameti juures moodustatud sõltumatu kohtueelne vaidluste lahendamise organ, mis lahendab tööstusomandi esemete õiguskaitset ja Patendiameti tegevuse õiguspärasust puudutavaid vaidlusi seaduses sätestatud alustel ja korras. RT I 2019-06-28 2 128062019002 2019-07-01 Tööstusomandi apellatsioonikomisjon (edaspidi apellatsioonikomisjon) on Patendiameti juures moodustatud sõltumatu kohtueelne vaidluste lahendamise organ, mis lahendab tööstusomandi esemete õiguskaitset ja Patendiameti tegevuse õiguspärasust puudutavaid vaidlusi seaduses sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "Reg_1002218_Par_1_1 (redaktsioon 1002218)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002218",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002218",
      "estleg:sourceAct": "Tööstusomandi apellatsioonikomisjoni põhimäärus",
      "estleg:provisionRef": "Reg_1002218 § 1_1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002218_Map"
      }
