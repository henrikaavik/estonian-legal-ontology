      "estleg:provisionRef": "Reg_1002218 § 28_39",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002218_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002218_Par_29_v1002218",
