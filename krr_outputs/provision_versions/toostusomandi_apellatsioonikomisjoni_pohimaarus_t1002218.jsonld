    {
      "@id": "estleg:Reg_1002218_Par_15_v1002218",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002218_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Menetlusosalise kirjalikud seisukohad adresseeritakse apellatsioonikomisjonile ja esitatakse kirjalikult. Menetlusosalise kirjalikud seisukohad adresseeritakse apellatsioonikomisjonile ja esitatakse kirjalikult. 2 (2) Paberkandjal esitatud kirjalikud seisukohad esitatakse apellatsioonikomisjonile kahes eksemplaris ning lisaks esitatakse nendest koopiad vastavalt menetlusosaliste arvule. RT I 2019-04-12 1 112042019001 2019-04-15 Paberkandjal esitatud kirjalikud seisukohad esitatakse apellatsioonikomisjonile kahes eksemplaris ning lisaks esitatakse nendest koopiad vastavalt menetlusosaliste arvule.",
      "rdfs:label": {
        "@value": "Reg_1002218_Par_15 (redaktsioon 1002218)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002218",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002218",
      "estleg:sourceAct": "Tööstusomandi apellatsioonikomisjoni põhimäärus",
      "estleg:provisionRef": "Reg_1002218 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002218_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002218_Par_16_v1002218",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002218_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paberkandjal esitatud lisadokumendid esitatakse apellatsioonikomisjonile kahes eksemplaris ning lisaks esitatakse nendest koopiad vastavalt menetlusosaliste arvule. RT I 2019-04-12 1 112042019001 2019-04-15 Paberkandjal esitatud lisadokumendid esitatakse apellatsioonikomisjonile kahes eksemplaris ning lisaks esitatakse nendest koopiad vastavalt menetlusosaliste arvule.",
      "rdfs:label": {
        "@value": "Reg_1002218_Par_16 (redaktsioon 1002218)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002218",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002218",
