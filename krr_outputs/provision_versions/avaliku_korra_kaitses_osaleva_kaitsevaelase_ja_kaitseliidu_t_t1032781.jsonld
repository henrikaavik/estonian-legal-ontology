    {
      "@id": "estleg:Reg_1032781_Par_2_v1032781",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032781_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseväe ja Kaitseliidu sõiduk tähistatakse valget värvi kleebisega, millele on suurtähtedega kirjutatud musta värvi sõna „KORRAKAITSE”, mille: 1 1) vähim laius on 55 sentimeetrit; 2 2) vähim kõrgus on 13 sentimeetrit; 3 3) kirjastiil on Arial. Kaitseväe ja Kaitseliidu sõiduk tähistatakse valget värvi kleebisega, millele on suurtähtedega kirjutatud musta värvi sõna „KORRAKAITSE”, mille: vähim laius on 55 sentimeetrit; vähim kõrgus on 13 sentimeetrit; kirjastiil on Arial. 2 (2) Kleebisega tähistatakse sõiduki juhi ja kõrvalistuja poolne külg. Kleebis peab olema paigutatud nii, et on võimalik eristada sellel olev sõna. Kleebisega tähistatakse sõiduki juhi ja kõrvalistuja poolne külg. Kleebis peab olema paigutatud nii, et on võimalik eristada sellel olev sõna. 3 (3) Käesoleva paragrahvi lõikes 1 sätestatud mõõtmete suurendamisel suurendatakse kõiki mõõtmeid proportsionaalselt. Käesoleva paragrahvi lõikes 1 sätestatud mõõtmete suurendamisel suurendatakse kõiki mõõtmeid proportsionaalselt.",
