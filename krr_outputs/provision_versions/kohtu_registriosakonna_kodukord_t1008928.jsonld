    },
    {
      "@id": "estleg:Reg_1008928_Par_168_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Infosüsteem annab füüsilisest isikust ettevõtja ettevõttele, äriühingule, filiaalile, mittetulundusühingule, sihtasutusele, korteriühistule ja maaparandusühistule esimese määruse tegemisel registriasja numbri. RT I 2019-01-11 3 111012019003 2019-01-14 Infosüsteem annab füüsilisest isikust ettevõtja ettevõttele, äriühingule, filiaalile, mittetulundusühingule, sihtasutusele, korteriühistule ja maaparandusühistule esimese määruse tegemisel registriasja numbri. 2 (2) Kehtetu - RT I 2015-12-10 6 110122015010 2016-01-01 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_168 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 168",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_169_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_169"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järgnevate kandemääruste tegemisel lisatakse registriasja numbrile kaldkriipsuga eraldatult hilisemate kandemääruste järjekorranumber. Järgnevate kandemääruste tegemisel lisatakse registriasja numbrile kaldkriipsuga eraldatult hilisemate kandemääruste järjekorranumber.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_169 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 169",
