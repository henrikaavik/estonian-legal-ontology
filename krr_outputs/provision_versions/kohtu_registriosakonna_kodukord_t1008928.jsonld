      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_198_169_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_198_169"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiriülesel ümberkujundamisel tehakse ümberkujundatava ühingu registrikaardile deklaratiivne ümberkujundamiskanne. Piiriülesel ümberkujundamisel tehakse ümberkujundatava ühingu registrikaardile deklaratiivne ümberkujundamiskanne. 2 (2) Lõikes 1 nimetatud kandes märgitakse: 1 1) uue ühingu õiguslik vorm, nimi ja kavandatav registrijärgne asukoht sihtliikmesriigis; 2 2) asjaolu, et ümberkujundamine loetakse toimunuks, kui piiriülene ümberkujundamine on sihtliikmesriigis jõustunud; 3 3) millise liikmesriigi õiguse kohaselt ümberkujundamine toimunuks loetakse; 4 4) viide võlausaldajate, töötajate ja osanike või aktsionäride õiguste teostamise korrale; 5 5) viide veebilehele, kus on võimalik tutvuda piiriüleseks ümberkujundamiseks koostatud dokumentidega, kui need ei ole kättesaadavad äriregistri kaudu. RT I 2023-03-16 1 116032023001 2023-03-19 Lõikes 1 nimetatud kandes märgitakse: uue ühingu õiguslik vorm, nimi ja kavandatav registrijärgne asukoht sihtliikmesriigis; asjaolu, et ümberkujundamine loetakse toimunuks, kui piiriülene ümberkujundamine on sihtliikmesriigis jõustunud; millise liikmesriigi õiguse kohaselt ümberkujundamine toimunuks loetakse; viide võlausaldajate, töötajate ja osanike või aktsionäride õiguste teostamise korrale; viide veebilehele, kus on võimalik tutvuda piiriüleseks ümberkujundamiseks koostatud dokumentidega, kui need ei ole kättesaadavad äriregistri kaudu.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_198_169 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 198_169",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_198_170_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_198_170"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pärast deklaratiivse ümberkujundamiskande tegemist väljastatakse piiriüleselt ümberkujundatavale ühingule äriseadustiku § 4919 lõikes 1 nimetatud tõend (lisa 7). Pärast deklaratiivse ümberkujundamiskande tegemist väljastatakse piiriüleselt ümberkujundatavale ühingule äriseadustiku § 4919 lõikes 1 nimetatud tõend (lisa 7). 2 (2) Tõend vormistatakse elektrooniliselt ja tehakse pädevatele asutustele kättesaadavaks Euroopa Liidu äriregistrite sidestamise süsteemi kaudu. RT I 2023-03-16 1 116032023001 2023-03-19 Tõend vormistatakse elektrooniliselt ja tehakse pädevatele asutustele kättesaadavaks Euroopa Liidu äriregistrite sidestamise süsteemi kaudu.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_198_170 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 198_170",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_198_171_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_198_171"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast sihtliikmesriigi registrilt piiriülese ümberkujundamise jõustumise kohta teate saamist märgitakse ümberkujundamise käigus kustutatava ühingu registrikaardile viivitamata piiriülese ümberkujundamise jõustumise kuupäev ja tehakse kustutamiskanne. RT I 2023-03-16 1 116032023001 2023-03-19 Pärast sihtliikmesriigi registrilt piiriülese ümberkujundamise jõustumise kohta teate saamist märgitakse ümberkujundamise käigus kustutatava ühingu registrikaardile viivitamata piiriülese ümberkujundamise jõustumise kuupäev ja tehakse kustutamiskanne.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_198_171 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 198_171",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_198_172_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_198_172"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiriülese ümberkujundamise tulemusena loodava ühingu registreerimisel edastatakse Euroopa Liidu äriregistrite sidestamise süsteemi kaudu teave registreerimiskande tegemise kohta piiriüleselt ümberkujundatud ühingu lähteliikmesriigi pädevatele asutustele. RT I 2023-03-16 1 116032023001 2023-03-19 Piiriülese ümberkujundamise tulemusena loodava ühingu registreerimisel edastatakse Euroopa Liidu äriregistrite sidestamise süsteemi kaudu teave registreerimiskande tegemise kohta piiriüleselt ümberkujundatud ühingu lähteliikmesriigi pädevatele asutustele.",
      "rdfs:label": {
