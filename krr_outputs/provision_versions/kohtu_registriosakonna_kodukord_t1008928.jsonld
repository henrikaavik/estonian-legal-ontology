        "@type": "xsd:date"
      },
      "estleg:versionText": "§ 17.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_17 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
