      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_170_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_170"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kanne tehakse ilma kandemääruseta, tekib ja täieneb registriasja number nii, nagu oleks tehtud määrus. Kui kanne tehakse ilma kandemääruseta, tekib ja täieneb registriasja number nii, nagu oleks tehtud määrus.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_170 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 170",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_171_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_171"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtumääruse tegemisel ja kirja väljasaatmisel lisatakse registriasja numbri lõppu vastavalt tähis „M1” või „K1”, järgmiste määruste ja kirjade puhul „M2” või „K2”, „M3” ja „K3” kasvavas järjestuses. Kohtumääruse tegemisel ja kirja väljasaatmisel lisatakse registriasja numbri lõppu vastavalt tähis „M1” või „K1”, järgmiste määruste ja kirjade puhul „M2” või „K2”, „M3” ja „K3” kasvavas järjestuses.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_171 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 171",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_172_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_172"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja ja filiaali registriasja numbri ette lisatakse täht „Ä”, mittetulundusühingu puhul täht „M”, sihtasutuse puhul täht „S”, kommertspandi puhul täht „K”, korteriühistu puhul täht „Ü” ning maaparandusühistu puhul täht „P”. RT I 2019-01-11 3 111012019003 2019-01-14 Ettevõtja ja filiaali registriasja numbri ette lisatakse täht „Ä”, mittetulundusühingu puhul täht „M”, sihtasutuse puhul täht „S”, kommertspandi puhul täht „K”, korteriühistu puhul täht „Ü” ning maaparandusühistu puhul täht „P”.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_172 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 172",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_173_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Enne ärinime või mittetulundusühingu, sihtasutuse või maaparandusühistu nime registrisse kandmise otsustamist kontrollib menetleja nimekorraldaja kaudu ärinime või nime piisavat eristatavust teistest ärinimedest või nimedest ning ärinime vastavust äriseadustiku § 12 lõikele 3. RT I 2019-01-11 3 111012019003 2019-01-14 Enne ärinime või mittetulundusühingu, sihtasutuse või maaparandusühistu nime registrisse kandmise otsustamist kontrollib menetleja nimekorraldaja kaudu ärinime või nime piisavat eristatavust teistest ärinimedest või nimedest ning ärinime vastavust äriseadustiku § 12 lõikele 3. 2 (2) Enne talunime sisaldava füüsilisest isikust ettevõtja ärinime registrisse kandmise otsustamist kontrollib menetleja nimekorraldaja kaudu kinnistusraamatu infosüsteemist, kas seda nime kandev kinnistu või katastriüksus on olemas ja kas avaldaja võib seda nime talu pidamiseks kasutada. Päringu tegemisel tuleb märkida avalduses esitatud ettevõtte aadress. Enne talunime sisaldava füüsilisest isikust ettevõtja ärinime registrisse kandmise otsustamist kontrollib menetleja nimekorraldaja kaudu kinnistusraamatu infosüsteemist, kas seda nime kandev kinnistu või katastriüksus on olemas ja kas avaldaja võib seda nime talu pidamiseks kasutada. Päringu tegemisel tuleb märkida avalduses esitatud ettevõtte aadress. 3 (3) Enne ärinime registrisse kandmise otsustamist kontrollib menetleja nimekorraldaja kaudu ärinime piisavat eristatust Patendiameti andmebaasi kantud kaubamärkidest ja Euroopa kaubamärkidest. RT I 2015-12-10 6 110122015010 2016-01-01 Enne ärinime registrisse kandmise otsustamist kontrollib menetleja nimekorraldaja kaudu ärinime piisavat eristatust Patendiameti andmebaasi kantud kaubamärkidest ja Euroopa kaubamärkidest. 4 (4) Nimepäringust peab lisaks järelepäritavale ärinimele või nimele ilmnema: 1 1) nimepäringu teinud teenistuja nimi; RT I 2014-12-11 1 111122014001 2015-01-01 2 2) nimepäringu objekti õiguslik vorm; 3 3) asjaolu, kas nimepäringu objekt on või ei ole registrisse kantud; 4 4) nimepäringu esitamise aeg. Nimepäringust peab lisaks järelepäritavale ärinimele või nimele ilmnema: nimepäringu teinud teenistuja nimi; nimepäringu objekti õiguslik vorm; asjaolu, kas nimepäringu objekt on või ei ole registrisse kantud; nimepäringu esitamise aeg.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_173 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 173",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_174_v1008928",
      "@type": [
