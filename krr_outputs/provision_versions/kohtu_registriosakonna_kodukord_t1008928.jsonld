      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastuvõetud dokumendid registreeritakse infosüsteemis või võetakse arvele kirjavahetuse registreerimiseks ettenähtud korras. Vastuvõetud dokumendid registreeritakse infosüsteemis või võetakse arvele kirjavahetuse registreerimiseks ettenähtud korras.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_29 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
