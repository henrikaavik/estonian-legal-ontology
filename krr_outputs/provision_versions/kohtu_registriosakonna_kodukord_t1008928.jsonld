      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_175_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_175"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kande või märke muutmine või kustutamine kahjustaks kommertspandiregistrisse kantud isiku õigust, peab registriasja menetleja enne kande või kandemääruse tegemist kontrollima, et oleks esitatud puudutatud isiku vormikohane nõusolek kande või märke muutmiseks või kustutamiseks. RT I 2015-12-10 6 110122015010 2016-01-01 Kui kande või märke muutmine või kustutamine kahjustaks kommertspandiregistrisse kantud isiku õigust, peab registriasja menetleja enne kande või kandemääruse tegemist kontrollima, et oleks esitatud puudutatud isiku vormikohane nõusolek kande või märke muutmiseks või kustutamiseks.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_175 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 175",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_176_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_176"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Äriühingute ühinemise ja jagunemise otsustamisel peab menetleja juhul, kui enam kui ühe ühinemises või jagunemises osaleva ühingu varale on seatud kommertspant, kontrollima pandipidajate notariaalselt tõestatud kokkuleppe olemasolu pandikannete järjestamise kohta. Äriühingute ühinemise ja jagunemise otsustamisel peab menetleja juhul, kui enam kui ühe ühinemises või jagunemises osaleva ühingu varale on seatud kommertspant, kontrollima pandipidajate notariaalselt tõestatud kokkuleppe olemasolu pandikannete järjestamise kohta. 2 (2) Ettevõtja äriregistrist kustutamise otsustamisel peab menetleja kontrollima, et ettevõtja kohta seatud kommertspandid oleksid kustutatud. Ettevõtja äriregistrist kustutamise otsustamisel peab menetleja kontrollima, et ettevõtja kohta seatud kommertspandid oleksid kustutatud.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_176 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 176",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_177_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_177"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Infosüsteem kontrollib automatiseeritult, kas ärikeelu all olev või ettevõtluskeelu saanud isik on registrisse kantud juriidilise isiku juhtorgani liikme, täisosaniku, prokuristi, likvideerija või pankrotihaldurina. RT I 2014-12-11 1 111122014001 2014-12-14 Infosüsteem kontrollib automatiseeritult, kas ärikeelu all olev või ettevõtluskeelu saanud isik on registrisse kantud juriidilise isiku juhtorgani liikme, täisosaniku, prokuristi, likvideerija või pankrotihaldurina.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_177 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 177",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_178_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_178"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
