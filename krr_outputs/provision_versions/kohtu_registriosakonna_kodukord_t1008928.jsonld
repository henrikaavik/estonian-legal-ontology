    {
      "@id": "estleg:Reg_1008928_Par_224_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_224"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui üks ja sama registriosakonnas säilitatav dokument puudutab mitut ettevõtjat, filiaali, mittetulundusühingut, maaparandusühistut või sihtasutust, seostatakse elektrooniline või digiteeritud dokument kõiki ühinguid, ühistuid või sihtasutusi puudutavate menetlustega. RT I 2019-01-11 3 111012019003 2019-01-14 Kui üks ja sama registriosakonnas säilitatav dokument puudutab mitut ettevõtjat, filiaali, mittetulundusühingut, maaparandusühistut või sihtasutust, seostatakse elektrooniline või digiteeritud dokument kõiki ühinguid, ühistuid või sihtasutusi puudutavate menetlustega.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_224 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 224",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_225_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Elektrooniliselt esitatud dokumendid salvestatakse elektroonilisse toimikusse. Elektroonilise dokumendi juurde märgitakse dokumendi liik ja selle kehtetuse korral vastavasisuline märge. Elektrooniliselt esitatud dokumendid salvestatakse elektroonilisse toimikusse. Elektroonilise dokumendi juurde märgitakse dokumendi liik ja selle kehtetuse korral vastavasisuline märge. 2 (2) Kehtetu - RT I 2017-06-05 1 105062017001 2017-07-01 Kehtetu - 3 (3) Kehtetu - RT I 2015-12-10 6 110122015010 2016-01-01 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_225 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 225",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_226_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_226"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui esmakandeavaldus jäetakse rahuldamata või võetakse enne kande või kandemääruse tegemist tagasi, säilitatakse kõiki selle ettevõtja, filiaali, mittetulundusühingu, sihtasutuse, korteriühistu või maaparandusühistu dokumente tema kohta avatud registritoimikus. RT I 2019-01-11 3 111012019003 2019-01-14 Kui esmakandeavaldus jäetakse rahuldamata või võetakse enne kande või kandemääruse tegemist tagasi, säilitatakse kõiki selle ettevõtja, filiaali, mittetulundusühingu, sihtasutuse, korteriühistu või maaparandusühistu dokumente tema kohta avatud registritoimikus.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_226 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 226",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_227_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_227"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "§ 227.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_227 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 227",
      "estleg:partOfAct": {
