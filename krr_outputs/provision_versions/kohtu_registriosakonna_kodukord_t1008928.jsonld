      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_23_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teave registriosakonnas peetavate registrite, registriosakonna ametliku e-posti aadressi ja telefoninumbri ning riigilõivu tasumise korra kohta on leitav Justiits- ja Digiministeeriumi ja kohtute veebilehelt. RT I 2017-06-05 1 105062017001 2017-07-01 Teave registriosakonnas peetavate registrite, registriosakonna ametliku e-posti aadressi ja telefoninumbri ning riigilõivu tasumise korra kohta on leitav Justiits- ja Digiministeeriumi ja kohtute veebilehelt. 2 (2) Kehtetu - RT I 2017-06-05 1 105062017001 2017-07-01 Kehtetu - 3 (3) Registriosakonna teenistuja annab isikutele telefoni ja e-posti teel teavet järgmistes küsimustes: RT I 2017-06-05 1 105062017001 2017-07-01 1 1) kehtetu - RT I 2014-12-11 1 111122014001 2015-01-01 2 2) registriosakonnas peetavate registrite loetelu; 3 3) dokumentide vastuvõtmise ja tagastamise kord; RT I 2017-06-05 1 105062017001 2017-07-01 4 4) kehtetu - RT I 2017-06-05 1 105062017001 2017-07-01 5 5) registriosakonna ning Registrite ja Infosüsteemide Keskuse ametlik e-posti aadress; 6 6) määrustest ja kannetest asjaosalistele teatamise kord; 7 7) tasumisele kuuluvate riigilõivude määrad ning tasumise kord; 8 8) notari ametitoimingud registriasjade ajamisel. Registriosakonna teenistuja annab isikutele telefoni ja e-posti teel teavet järgmistes küsimustes: kehtetu - registriosakonnas peetavate registrite loetelu; dokumentide vastuvõtmise ja tagastamise kord; kehtetu - registriosakonna ning Registrite ja Infosüsteemide Keskuse ametlik e-posti aadress; määrustest ja kannetest asjaosalistele teatamise kord; tasumisele kuuluvate riigilõivude määrad ning tasumise kord; notari ametitoimingud registriasjade ajamisel. 4 (4) Registriosakonna teenistuja ei anna isikutele muud õiguslikku teavet kui lõikes 3 on nimetatud. Registriosakonna teenistuja ei anna isikutele muud õiguslikku teavet kui lõikes 3 on nimetatud.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_23 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_234_v1008928",
      "@type": [
        "owl:NamedIndividual",
