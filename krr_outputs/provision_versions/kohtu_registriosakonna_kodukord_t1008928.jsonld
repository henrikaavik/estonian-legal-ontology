      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registriasjade numeratsioon hõlmab kõiki registriosakonnas koostatud määruseid ja kirju. Registriasjade numeratsioon hõlmab kõiki registriosakonnas koostatud määruseid ja kirju. 2 (2) Kehtetu - RT I 2014-12-11 1 111122014001 2015-02-03 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_167 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 167",
      "estleg:partOfAct": {
