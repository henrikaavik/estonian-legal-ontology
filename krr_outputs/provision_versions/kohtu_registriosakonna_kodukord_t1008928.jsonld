      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 188",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_189_v1008928",
      "@type": [
        "owl:NamedIndividual",
