      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_118_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kommertspandiregistri registrikaardi alajaotusesse „Märkused” kantakse märge selle kohta, et registripidaja on avastanud pärast kandele allakirjutamist kande avaldusele mittevastavuse ning on sellest puudutatud isikutele teatanud ja muud märkused. RT I 2015-12-10 6 110122015010 2016-01-01 Kommertspandiregistri registrikaardi alajaotusesse „Märkused” kantakse märge selle kohta, et registripidaja on avastanud pärast kandele allakirjutamist kande avaldusele mittevastavuse ning on sellest puudutatud isikutele teatanud ja muud märkused.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_118 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 118",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_119_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kommertspandi registrikaardi alajaotusesse „Kannete loetelu” märgitakse kande järjekorranumber, kandeliik, kande kinnitamise kuupäev ja kandeavalduseta tehtud kande korral viide kande tegemise õiguslikule alusele. Kommertspandi registrikaardi alajaotusesse „Kannete loetelu” märgitakse kande järjekorranumber, kandeliik, kande kinnitamise kuupäev ja kandeavalduseta tehtud kande korral viide kande tegemise õiguslikule alusele.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_119 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 119",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_119_117_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_119_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korteriühistu registrikaardi alajaotusesse „Nimi ja aadress” kantakse: 1 1) korteriühistu nimi; 2 2) korteriühistu täiendav nimi; 3 3) korteriühistu asukoha aadress; RT I 2023-01-28 2 128012023002 2023-02-01 4 4) korteriühistu kontaktisiku andmed, aadress ja e-posti aadress; 5 5) käesoleva paragrahvi punktides 1–4 sätestatud andmete muutmine. RT I 2017-12-23 1 123122017001 2018-01-01 Korteriühistu registrikaardi alajaotusesse „Nimi ja aadress” kantakse: korteriühistu nimi; korteriühistu täiendav nimi; korteriühistu asukoha aadress; korteriühistu kontaktisiku andmed, aadress ja e-posti aadress; käesoleva paragrahvi punktides 1–4 sätestatud andmete muutmine.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_119_117 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 119_117",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_119_118_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_119_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Korteriühistu registrikaardi alajaotusesse „Esindusõigus” kantakse: 1 1) juhatuse liikme nimi ja isikukood; 2 2) valitseja nimi ja registrikood; 3 3) pankrotihalduri nimi ja isikukood; 4 4) likvideerija nimi ja isikukood; 5 5) käesoleva lõike punktides 1–4 sätestatud andmete muutmine. Korteriühistu registrikaardi alajaotusesse „Esindusõigus” kantakse: juhatuse liikme nimi ja isikukood; valitseja nimi ja registrikood; pankrotihalduri nimi ja isikukood; likvideerija nimi ja isikukood; käesoleva lõike punktides 1–4 sätestatud andmete muutmine. 2 (2) Korteriühistu registrikaardi kehtival väljatrükil peab esindusõiguse reeglite puudumise korral olema lisatud alajaotusesse „Esindusõigus” kantud isikute seadusest tulenev esindusõiguse üldkord. RT I 2017-12-23 1 123122017001 2018-01-01 Korteriühistu registrikaardi kehtival väljatrükil peab esindusõiguse reeglite puudumise korral olema lisatud alajaotusesse „Esindusõigus” kantud isikute seadusest tulenev esindusõiguse üldkord.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_119_118 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 119_118",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_119_119_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_119_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korteriühistu registrikaardi alajaotusesse „Õiguslik seisund” kantakse: 1 1) õiguslik vorm; 2 2) põhikirja jõustumise aeg; RT I 2023-01-28 2 128012023002 2023-02-01 3 3) kehtetu - RT I 2019-01-11 3 111012019003 2019-01-14 4 4) lõpetamise kuupäev ning lõpetamise alus ja muud võimalikud asjaolud; 5 5) lõpetamist tühistav tegevuse jätkamine ning selle alus ja muud võimalikud asjaolud; 6 6) pankrotiandmed, mis ei ole kantud alajaotusesse „Esindusõigus”, sealhulgas viide aluseks olevale kohtulahendile; 7 7) registrist kustutamine ja selle alus; 8 8) käesoleva paragrahvi punktides 1–6 sätestatud andmete muutmine. RT I 2017-12-23 1 123122017001 2018-01-01 Korteriühistu registrikaardi alajaotusesse „Õiguslik seisund” kantakse: õiguslik vorm; põhikirja jõustumise aeg; kehtetu - lõpetamise kuupäev ning lõpetamise alus ja muud võimalikud asjaolud; lõpetamist tühistav tegevuse jätkamine ning selle alus ja muud võimalikud asjaolud; pankrotiandmed, mis ei ole kantud alajaotusesse „Esindusõigus”, sealhulgas viide aluseks olevale kohtulahendile; registrist kustutamine ja selle alus; käesoleva paragrahvi punktides 1–6 sätestatud andmete muutmine.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_119_119 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 119_119",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_119_120_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_119_120"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korteriühistu registrikaardi alajaotusesse „Märkused” kantakse: 1 1) likvideeritud ühistu dokumentide hoidja isikuandmed või märkus dokumentide arhiivi hoiuleandmise kohta; 2 2) märkus korteriomandi- ja korteriühistuseaduse §-s 36 sätestatud laenu kohta; 3 3) märkus juhatuse liikme ametiseisundi peatamise kohta; 4 4) muud märkused. RT I 2017-12-23 1 123122017001 2018-01-01 Korteriühistu registrikaardi alajaotusesse „Märkused” kantakse: likvideeritud ühistu dokumentide hoidja isikuandmed või märkus dokumentide arhiivi hoiuleandmise kohta; märkus korteriomandi- ja korteriühistuseaduse §-s 36 sätestatud laenu kohta; märkus juhatuse liikme ametiseisundi peatamise kohta; muud märkused.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_119_120 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 119_120",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
