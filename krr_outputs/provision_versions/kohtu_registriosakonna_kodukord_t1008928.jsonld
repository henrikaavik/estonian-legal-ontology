      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mittetulundusühingute ja sihtasutuste register koosneb mittetulundusühingute, sihtasutuste, korteriühistute ja maaparandusühistute kohta avatud registrikaartidest, avalikest toimikutest ning registritoimikutest. RT I 2019-01-11 3 111012019003 2019-01-14 Mittetulundusühingute ja sihtasutuste register koosneb mittetulundusühingute, sihtasutuste, korteriühistute ja maaparandusühistute kohta avatud registrikaartidest, avalikest toimikutest ning registritoimikutest.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_85 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
