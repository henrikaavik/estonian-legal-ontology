    },
    {
      "@id": "estleg:Reg_1008928_Par_60_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nimepäringule vastamisel teatab nimekorraldaja lisaks §-s 58 ettenähtule, millal ja milliste nimepäringu objektiga samasuguste või sarnaste ärinimede või nimede kohta on esitanud nimepäringuid teised registriosakonna teenistujad. RT I 2014-12-11 1 111122014001 2015-01-01 Nimepäringule vastamisel teatab nimekorraldaja lisaks §-s 58 ettenähtule, millal ja milliste nimepäringu objektiga samasuguste või sarnaste ärinimede või nimede kohta on esitanud nimepäringuid teised registriosakonna teenistujad. 2 (2) Uue nimepäringu varasemate nimepäringutega võrdlemisel lähtub nimekorraldaja § 58 lõigetest 2−5. Uue nimepäringu varasemate nimepäringutega võrdlemisel lähtub nimekorraldaja § 58 lõigetest 2−5. 3 (3) Kehtetu - RT I 2015-12-10 6 110122015010 2016-01-01 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_60 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
