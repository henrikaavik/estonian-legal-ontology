      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_119_123_v1008928",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008928_Par_119_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maaparandusühistu registrikaardi alajaotusesse „Esindusõigus” kantakse: 1 1) juhatuse liikme nimi ja isikukood; 2 2) pankrotihalduri ja ajutise pankrotihalduri nimi ja isikukood; 3 3) likvideerija nimi ja isikukood; 4 4) juhatuse liikmete ja likvideerijate esindusõiguse kord, kui see erineb seaduses ettenähtud üldreeglist. Maaparandusühistu registrikaardi alajaotusesse „Esindusõigus” kantakse: juhatuse liikme nimi ja isikukood; pankrotihalduri ja ajutise pankrotihalduri nimi ja isikukood; likvideerija nimi ja isikukood; juhatuse liikmete ja likvideerijate esindusõiguse kord, kui see erineb seaduses ettenähtud üldreeglist. 2 (2) Maaparandusühistu kehtiva registrikaardi väljatrükil peab esindusõiguse reeglite puudumisel olema lisatud alajaotusesse „Esindusõigus” kantud isikute seadusest tulenev esindusõiguse üldkord. RT I 2019-01-11 3 111012019003 2019-01-14 Maaparandusühistu kehtiva registrikaardi väljatrükil peab esindusõiguse reeglite puudumisel olema lisatud alajaotusesse „Esindusõigus” kantud isikute seadusest tulenev esindusõiguse üldkord.",
      "rdfs:label": {
        "@value": "Reg_1008928_Par_119_123 (redaktsioon 1008928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008928",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1008928",
      "estleg:sourceAct": "Kohtu registriosakonna kodukord",
      "estleg:provisionRef": "Reg_1008928 § 119_123",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1008928_Map"
      }
    },
    {
      "@id": "estleg:Reg_1008928_Par_119_124_v1008928",
      "@type": [
        "owl:NamedIndividual",
