        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühinemisel määrata:1) konventsiooni artikli 2 alusel keskasutuseks Justiitsministeerium;2) konventsiooni artikli 6 alusel teatisi koostavateks asutusteks kohtud.",
      "rdfs:label": {
        "@value": "TKKKDVKKU_Par_2 (redaktsioon 25036)",
        "@language": "et"
      },
