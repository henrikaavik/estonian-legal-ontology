      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühinemisel deklareerida: 1) Eesti Vabariik on vastu artikli 10 punktis c nimetatud edastusviisile; 2) artikli 15 alusel, et kohus võib nimetatud tingimustel otsuse teha; 3) artikli 16 3. lõike alusel ajavahemikuks kolm aastat.",
      "rdfs:label": {
        "@value": "TKKKDVKKU_Par_3 (redaktsioon 25036)",
        "@language": "et"
      },
