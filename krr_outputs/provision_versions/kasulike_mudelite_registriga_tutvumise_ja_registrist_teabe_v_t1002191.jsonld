    {
      "@id": "estleg:Reg_1002191_Par_13_v1002191",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002191_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registrist teabe väljastamise all käesoleva korra tähenduses mõistetakse Patendiameti poolt teabe väljastamist ametlikult kinnitatud kirjaliku teabena paberkandjal või elektrooniliselt. RT I 2023-09-08 1 108092023001 2023-09-11 Registrist teabe väljastamise all käesoleva korra tähenduses mõistetakse Patendiameti poolt teabe väljastamist ametlikult kinnitatud kirjaliku teabena paberkandjal või elektrooniliselt. 2 (2) Ametlikult kinnitamata teavet avalikustatud registriandmete kohta saab § 6 alusel avaldatud Patendiameti veebiväljaannetest. Ametlikult kinnitamata teavet väljastab ka juriidiline isik, kellega riik on sõlminud vastava lepingu. RT I 2013-05-31 2 131052013002 2013-06-03 Ametlikult kinnitamata teavet avalikustatud registriandmete kohta saab § 6 alusel avaldatud Patendiameti veebiväljaannetest. Ametlikult kinnitamata teavet väljastab ka juriidiline isik, kellega riik on sõlminud vastava lepingu.",
      "rdfs:label": {
        "@value": "Reg_1002191_Par_13 (redaktsioon 1002191)",
        "@language": "et"
      },
