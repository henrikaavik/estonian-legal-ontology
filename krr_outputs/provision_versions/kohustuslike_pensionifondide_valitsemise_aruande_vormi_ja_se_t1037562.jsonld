      "estleg:sourceAct": "Kohustuslike pensionifondide valitsemise aruande vormi ja selle täitmise juhendi kehtestamine",
      "estleg:provisionRef": "Reg_1037562 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037562_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037562_Par_3_v1037562",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037562_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määruse kohased aruanded koostatakse aruandeperioodide kohta, mis algavad 2017. aasta 1. jaanuaril ja hiljem. Käesoleva määruse kohased aruanded koostatakse aruandeperioodide kohta, mis algavad 2017. aasta 1. jaanuaril ja hiljem. 2 (2) 2016. aasta 31. detsembril lõppenud aruandeperioodi aruanded koostatakse ja esitatakse enne 2017. aasta 1. jaanuari kehtinud korra kohaselt. 2016. aasta 31. detsembril lõppenud aruandeperioodi aruanded koostatakse ja esitatakse enne 2017. aasta 1. jaanuari kehtinud korra kohaselt.",
