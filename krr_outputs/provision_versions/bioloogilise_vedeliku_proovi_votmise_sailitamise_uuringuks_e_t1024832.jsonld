      }
    },
    {
      "@id": "estleg:Reg_1024832_Par_14_v1024832",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024832_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Uriiniproov toimetatakse riikliku ekspertiisiasutuse laborisse esimesel võimalusel. RT I 2017-09-30 1 130092017001 2017-10-05 Uriiniproov toimetatakse riikliku ekspertiisiasutuse laborisse esimesel võimalusel. 2 (2) Uriiniproovi säilitatakse kuni ekspertiisiasutusse saabumiseni külmkapis, välja arvatud uriiniproovi edasitoimetamise aeg. RT I 2017-09-30 1 130092017001 2017-10-05 Uriiniproovi säilitatakse kuni ekspertiisiasutusse saabumiseni külmkapis, välja arvatud uriiniproovi edasitoimetamise aeg.",
      "rdfs:label": {
        "@value": "Reg_1024832_Par_14 (redaktsioon 1024832)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024832",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024832",
      "estleg:sourceAct": "Bioloogilise vedeliku proovi võtmise, säilitamise, uuringuks edastamise, uuringu tegemise ja nende toimingute tasustamise kord",
      "estleg:provisionRef": "Reg_1024832 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024832_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024832_Par_15_v1024832",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024832_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui proovimaterjal võetakse tervishoiuteenuse osutaja juures, korraldab asutus või ametiisik proovimaterjali toimetamise riiklikku ekspertiisiasutusse. RT I 2017-09-30 1 130092017001 2017-10-05 Kui proovimaterjal võetakse tervishoiuteenuse osutaja juures, korraldab asutus või ametiisik proovimaterjali toimetamise riiklikku ekspertiisiasutusse. 2 (2) Kui proovimaterjal võetakse riiklikus ekspertiisiasutuses, vormistab ametiisik saatekirja, kuid jätab proovimaterjali ekspertiisiasutusse, kust see toimetatakse edasi laborisse. RT I 2017-09-30 1 130092017001 2017-10-05 Kui proovimaterjal võetakse riiklikus ekspertiisiasutuses, vormistab ametiisik saatekirja, kuid jätab proovimaterjali ekspertiisiasutusse, kust see toimetatakse edasi laborisse. 3 (3) Kui proovimaterjal võetakse liiklusõnnetuses osalenud isikult tema toimetamisel vältimatu arstiabi saamiseks tervishoiuteenuse osutaja juurde, vormistab ametiisik saatekirja sündmuskohal või esitab nõude proovimaterjali võtmiseks tervishoiuteenuse osutajale telefoni teel. Telefoni teel esitatud nõue vormistatakse kirjalikult hiljemalt järgmisel tööpäeval nõude esitamisest arvates. RT I 2017-09-30 1 130092017001 2017-10-05 Kui proovimaterjal võetakse liiklusõnnetuses osalenud isikult tema toimetamisel vältimatu arstiabi saamiseks tervishoiuteenuse osutaja juurde, vormistab ametiisik saatekirja sündmuskohal või esitab nõude proovimaterjali võtmiseks tervishoiuteenuse osutajale telefoni teel. Telefoni teel esitatud nõue vormistatakse kirjalikult hiljemalt järgmisel tööpäeval nõude esitamisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1024832_Par_15 (redaktsioon 1024832)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024832",
