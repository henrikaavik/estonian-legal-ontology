    {
      "@id": "estleg:Reg_1024832_Par_4_v1024832",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024832_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vereproovi võib võtta tervishoiuteenuse osutaja või riikliku ekspertiisiasutuse ruumides. Vereproovi võib võtta tervishoiuteenuse osutaja või riikliku ekspertiisiasutuse ruumides. 2 (2) Uriiniproovi võib võtta tervishoiuteenuse osutaja, riikliku ekspertiisiasutuse või ametiisiku ruumides, kus on välistatud proovi võltsimise võimalus. Uriiniproovi võib võtta tervishoiuteenuse osutaja, riikliku ekspertiisiasutuse või ametiisiku ruumides, kus on välistatud proovi võltsimise võimalus. 3 (3) Kui prooviandja on üritanud võltsida või on võltsinud proovimaterjali, võetakse proov kas volitatud isiku või ametiisiku või mõlema otsese jälgimise all. Jälgiv ametiisik või indikaatorvahendiga kontrolli teostav volitatud isik peab olema prooviandjaga samast soost. RT I 2017-09-30 1 130092017001 2017-10-05 Kui prooviandja on üritanud võltsida või on võltsinud proovimaterjali, võetakse proov kas volitatud isiku või ametiisiku või mõlema otsese jälgimise all. Jälgiv ametiisik või indikaatorvahendiga kontrolli teostav volitatud isik peab olema prooviandjaga samast soost.",
      "rdfs:label": {
        "@value": "Reg_1024832_Par_4 (redaktsioon 1024832)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024832",
