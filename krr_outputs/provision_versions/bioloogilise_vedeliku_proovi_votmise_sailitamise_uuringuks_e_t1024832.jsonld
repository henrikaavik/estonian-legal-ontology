      }
    },
    {
      "@id": "estleg:Reg_1024832_Par_13_v1024832",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024832_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vereproov toimetatakse riikliku ekspertiisiasutuse laborisse esimesel võimalusel. Vereproov toimetatakse riikliku ekspertiisiasutuse laborisse esimesel võimalusel. 2 (2) Vereproovi säilitatakse kuni ekspertiisiasutusse saabumiseni külmkapis, välja arvatud vereproovi edasitoimetamise aeg. RT I 2017-09-30 1 130092017001 2017-10-05 Vereproovi säilitatakse kuni ekspertiisiasutusse saabumiseni külmkapis, välja arvatud vereproovi edasitoimetamise aeg. 3 (3) Kehtetu - RT I 2017-09-30 1 130092017001 2017-10-05 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1024832_Par_13 (redaktsioon 1024832)",
        "@language": "et"
      },
