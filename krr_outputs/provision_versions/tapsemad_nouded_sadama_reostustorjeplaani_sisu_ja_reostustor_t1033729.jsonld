      },
      "estleg:versionText": "Määrusega sätestatakse täpsemad nõuded sadama reostustõrjeplaani sisu ja reostustõrjetehnika kohta. Määrusega sätestatakse täpsemad nõuded sadama reostustõrjeplaani sisu ja reostustõrjetehnika kohta.",
      "rdfs:label": {
        "@value": "Reg_1033729_Par_1 (redaktsioon 1033729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033729",
      "estleg:sourceAct": "Täpsemad nõuded sadama reostustõrjeplaani sisu ja reostustõrjetehnika kohta",
      "estleg:provisionRef": "Reg_1033729 § 1",
