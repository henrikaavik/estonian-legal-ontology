    },
    {
      "@id": "estleg:Reg_1044458_Par_7_v1044458",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044458_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist. Määrus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist.",
      "rdfs:label": {
        "@value": "Reg_1044458_Par_7 (redaktsioon 1044458)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044458",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044458",
      "estleg:sourceAct": "Saare maakonna kaitsealuste parkide, arboreetumi ja puistute piirid",
      "estleg:provisionRef": "Reg_1044458 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044458_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044458_Par_8_v1044458",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044458_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi ametlikus väljaandes Ametlikud Teadaanded 5. novembril 2007. a teate avaldamisega algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi ametlikus väljaandes Ametlikud Teadaanded 5. novembril 2007. a teate avaldamisega algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1044458_Par_8 (redaktsioon 1044458)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044458",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044458",
      "estleg:sourceAct": "Saare maakonna kaitsealuste parkide, arboreetumi ja puistute piirid",
      "estleg:provisionRef": "Reg_1044458 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044458_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044458_Par_9_v1044458",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044458_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1044458_Par_9 (redaktsioon 1044458)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044458",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044458",
      "estleg:sourceAct": "Saare maakonna kaitsealuste parkide, arboreetumi ja puistute piirid",
      "estleg:provisionRef": "Reg_1044458 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044458_Map_2026"
      }
