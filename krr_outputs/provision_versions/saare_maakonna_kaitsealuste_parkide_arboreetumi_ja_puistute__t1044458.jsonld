    {
      "@id": "estleg:Reg_1044458_Par_4_v1044458",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044458_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvides 1, 2 ja 3 nimetatud parkide, arboreetumi ja puistute kaitsekord ning kaitse-eesmärk on sätestatud Vabariigi Valitsuse 3. märtsi 2006. a määrusega nr 64 „Kaitsealuste parkide, arboreetumite ja puistute kaitse-eeskiri”. Kudjape tammik7 kuulub Natura 2000 Kudjape loodusala koosseisu ning seal on kaitse-eesmärgiks kaitsta ka nõukogu direktiivi 92/43/EMÜ looduslike elupaikade ning loodusliku loomastiku ja taimestiku kaitse kohta (EÜT L 206, 22.07.1992, lk 7–50) I lisas nimetatud elupaigatüüpe puisniidud (6530*)8 ja vanad laialehised metsad (9020*). Paragrahvides 1, 2 ja 3 nimetatud parkide, arboreetumi ja puistute kaitsekord ning kaitse-eesmärk on sätestatud Vabariigi Valitsuse 3. märtsi 2006. a määrusega nr 64 „Kaitsealuste parkide, arboreetumite ja puistute kaitse-eeskiri”. Kudjape tammik7 kuulub Natura 2000 Kudjape loodusala koosseisu ning seal on kaitse-eesmärgiks kaitsta ka nõukogu direktiivi 92/43/EMÜ looduslike elupaikade ning loodusliku loomastiku ja taimestiku kaitse kohta (EÜT L 206, 22.07.1992, lk 7–50) I lisas nimetatud elupaigatüüpe puisniidud (6530*)8 ja vanad laialehised metsad (9020*).",
      "rdfs:label": {
        "@value": "Reg_1044458_Par_4 (redaktsioon 1044458)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044458",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044458",
      "estleg:sourceAct": "Saare maakonna kaitsealuste parkide, arboreetumi ja puistute piirid",
      "estleg:provisionRef": "Reg_1044458 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044458_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044458_Par_5_v1044458",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044458_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas9 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti piiri kulgemise kohta. Määruse seletuskirjas9 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti piiri kulgemise kohta.",
      "rdfs:label": {
        "@value": "Reg_1044458_Par_5 (redaktsioon 1044458)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044458",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044458",
      "estleg:sourceAct": "Saare maakonna kaitsealuste parkide, arboreetumi ja puistute piirid",
      "estleg:provisionRef": "Reg_1044458 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044458_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044458_Par_6_v1044458",
      "@type": [
        "owl:NamedIndividual",
