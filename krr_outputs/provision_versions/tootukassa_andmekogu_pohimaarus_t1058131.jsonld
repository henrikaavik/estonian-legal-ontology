    {
      "@id": "estleg:Reg_1058131_Par_1_v1058131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058131_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Töötukassa andmekogu (edaspidi andmekogu) on töötuskindlustuse seaduse alusel asutatud andmekogu, mis kuulub riigi infosüsteemi. Töötukassa andmekogu (edaspidi andmekogu) on töötuskindlustuse seaduse alusel asutatud andmekogu, mis kuulub riigi infosüsteemi. 2 (2) Andmekogu ingliskeelne nimetus on Unemployment Insurance Fund Database. Andmekogu ingliskeelne nimetus on Unemployment Insurance Fund Database. 3 (3) Andmekogu peetakse töötuskindlustuse seaduse § 35 lõikes 1 sätestatud eesmärgil. Andmekogu peetakse töötuskindlustuse seaduse § 35 lõikes 1 sätestatud eesmärgil.",
      "rdfs:label": {
        "@value": "Reg_1058131_Par_1 (redaktsioon 1058131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058131",
      "estleg:sourceAct": "Töötukassa andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1058131 § 1",
