      "estleg:provisionRef": "Reg_1058131 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058131_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058131_Par_16_v1058131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058131_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtluse toetamise kohta kantakse andmekogusse järgmised tööturuteenuste andmed: 1 1) ettevõtluse alustamise toetuse saamise korral asutatud ettevõtte nimi, registrikood, asutamise kuupäev ja tegevusala, ettevõtluse alustamise toetusega loodavate töökohtade arv, toetuse kasutamise aruande esitamise kuupäev ning aruande kontrolli kuupäev ja toetuse kasutamise sihtotstarbelisuse ja kulu tõendavate dokumentide andmed; 2 2) ettevõtluse järelteenustel osalemise korral koolitusasutuse nimi ja registrikood, koolituse nimi, mentori nimi ja isiku- või registrikood ning kulu tõendavate dokumentide andmed. RT I 2025-12-17 1 117122025001 2026-01-01 Ettevõtluse toetamise kohta kantakse andmekogusse järgmised tööturuteenuste andmed: ettevõtluse alustamise toetuse saamise korral asutatud ettevõtte nimi, registrikood, asutamise kuupäev ja tegevusala, ettevõtluse alustamise toetusega loodavate töökohtade arv, toetuse kasutamise aruande esitamise kuupäev ning aruande kontrolli kuupäev ja toetuse kasutamise sihtotstarbelisuse ja kulu tõendavate dokumentide andmed; ettevõtluse järelteenustel osalemise korral koolitusasutuse nimi ja registrikood, koolituse nimi, mentori nimi ja isiku- või registrikood ning kulu tõendavate dokumentide andmed.",
      "rdfs:label": {
        "@value": "Reg_1058131_Par_16 (redaktsioon 1058131)",
        "@language": "et"
      },
