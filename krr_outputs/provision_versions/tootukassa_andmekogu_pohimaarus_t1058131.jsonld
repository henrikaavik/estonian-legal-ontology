    {
      "@id": "estleg:Reg_1058131_Par_39_v1058131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058131_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahvi 31 lõike 1 punktis 8 nimetatud andmetele on juurdepääs tervishoiuteenuse osutajal, arstiõppe läbinud isikul ja õigusaktides sätestatud juhul muul isikul. Paragrahvi 31 lõike 1 punktis 8 nimetatud andmetele on juurdepääs tervishoiuteenuse osutajal, arstiõppe läbinud isikul ja õigusaktides sätestatud juhul muul isikul. 2 (2) Isikule kuvatakse töövõime hindamise taotluse andmed, töövõime hindamisel antud eksperdiarvamus ja selle andja andmed, töövõime hindamise otsuse andmed ja eksperdiarvamuse andmete töötlemise logid tervise infosüsteemi kaudu. Isikule kuvatakse töövõime hindamise taotluse andmed, töövõime hindamisel antud eksperdiarvamus ja selle andja andmed, töövõime hindamise otsuse andmed ja eksperdiarvamuse andmete töötlemise logid tervise infosüsteemi kaudu.",
      "rdfs:label": {
        "@value": "Reg_1058131_Par_39 (redaktsioon 1058131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058131",
      "estleg:sourceAct": "Töötukassa andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1058131 § 39",
