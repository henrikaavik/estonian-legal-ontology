      "estleg:provisionRef": "Reg_1058131 § 37",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058131_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1058131_Par_38_v1058131",
