    {
      "@id": "estleg:Reg_1058131_Par_18_v1058131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058131_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Töövõime toetamise kohta kantakse andmekogusse järgmised tööturuteenuste andmed: 1 1) tööruumide ja -vahendite kohandamise korral kohandatava ehitise, ruumi või töövahendi nimetus ning kulu tõendavad andmed; 2 2) tööalase abivahendi kasutada andmise korral töökoha eksperthinnang, töötamiseks vajaliku abivahendi liik ja nimetus ning abivahendi võõrandamise kuupäev ja põhjus; 3 3) tööalase rehabilitatsiooni tegevuskava ja lõpphinnangu kuupäev ja sisu. 4 4) kehtetu - RT I 2025-12-17 1 117122025001 2026-01-01 Töövõime toetamise kohta kantakse andmekogusse järgmised tööturuteenuste andmed: tööruumide ja -vahendite kohandamise korral kohandatava ehitise, ruumi või töövahendi nimetus ning kulu tõendavad andmed; tööalase abivahendi kasutada andmise korral töökoha eksperthinnang, töötamiseks vajaliku abivahendi liik ja nimetus ning abivahendi võõrandamise kuupäev ja põhjus; tööalase rehabilitatsiooni tegevuskava ja lõpphinnangu kuupäev ja sisu. kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1058131_Par_18 (redaktsioon 1058131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058131",
