    {
      "@id": "estleg:SoVS_Par_22_v738642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SoVS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalministeerium: nõustab võrdse kohtlemise põhimõtte rakendamisega seotud küsimustes ning annab juhiseid käesoleva seaduse rakendamiseks; analüüsib seaduste ja õigusaktide mõju naiste ja meeste seisundile ühiskonnas; avaldab aruandeid naiste ja meeste võrdse kohtlemise põhimõtte rakendamise kohta.",
      "rdfs:label": {
        "@value": "SoVS_Par_22 (redaktsioon 738642)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "738642",
      "estleg:supersededByVersion": {
        "@id": "estleg:SoVS_Par_22_v130062023071"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/738642",
      "estleg:sourceAct": "Soolise võrdõiguslikkuse seadus",
      "estleg:provisionRef": "SoVS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:SoVS_Map_2026"
      }
    },
    {
      "@id": "estleg:SoVS_Par_22_v130062023071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SoVS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandus- ja Kommunikatsiooniministeerium: nõustab võrdse kohtlemise põhimõtte rakendamisega seotud küsimustes ning annab juhiseid käesoleva seaduse rakendamiseks; analüüsib seaduste ja õigusaktide mõju naiste ja meeste seisundile ühiskonnas; avaldab aruandeid naiste ja meeste võrdse kohtlemise põhimõtte rakendamise kohta; koordineerib soolise võrdõiguslikkuse ning võrdse kohtlemise edendamist ja sellealast tegevust.",
      "rdfs:label": {
        "@value": "SoVS_Par_22 (redaktsioon 130062023071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062023071",
      "estleg:sourceAct": "Soolise võrdõiguslikkuse seadus",
      "estleg:provisionRef": "SoVS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:SoVS_Map_2026"
      }
    },
    {
      "@id": "estleg:SoVS_Par_23_v738642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SoVS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sotsiaalministeeriumi võrdõiguslikkuse struktuuriüksuse ametnik (edaspidi nõustaja ) nõustab igaüht naiste ja meeste võrdse kohtlemise põhimõtte rakendamisega seonduvates küsimustes. Nõustamine võib toimuda suuliselt või kirjalikult. Nõustaja vastuvõtuajad tehakse teatavaks Sotsiaalministeeriumi veebilehel. (2) Vajadusel nõustaja selgitab isikule, millise institutsiooni pädevusse võimaliku diskrimineerimisjuhtumi lahendamine kuulub. Isiku soovil osutatakse abi avalduse kirjalikul vormistamisel ja edastatakse see pädevale organile. Avaldust ei edastata kohtule ja töövaidluskomisjonile.",
      "rdfs:label": {
        "@value": "SoVS_Par_23 (redaktsioon 738642)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "738642",
      "estleg:supersededByVersion": {
        "@id": "estleg:SoVS_Par_23_v13223681"
      },
      "estleg:versionValidTo": {
        "@value": "2009-10-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/738642",
      "estleg:sourceAct": "Soolise võrdõiguslikkuse seadus",
      "estleg:provisionRef": "SoVS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:SoVS_Map_2026"
      }
    },
