      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadus jõustub 2004. aasta 1. mail.",
      "rdfs:label": {
        "@value": "SoVS_Par_25 (redaktsioon 13100256)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13100256",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13100256",
      "estleg:sourceAct": "Soolise võrdõiguslikkuse seadus",
      "estleg:provisionRef": "SoVS § 25",
