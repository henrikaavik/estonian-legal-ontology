      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tolliasutuste vastastikuse abi ja koostöö konventsiooniga ühinemise seadus (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tolliasutuste vastastikuse abi ja koostöö konventsiooniga ühinemise seadus"
    },
    {
      "@id": "estleg:TVAKKU_Par_1_v828999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TVAKKU_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud (edaspidikonventsioon), mis on koostatud Brüsselis 1997. aasta 18. detsembril.",
      "rdfs:label": {
        "@value": "TVAKKU_Par_1 (redaktsioon 828999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "828999"
    },
    {
      "@id": "estleg:TVAKKU_Par_2_v828999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TVAKKU_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kooskõlas konventsiooni artikli 20 lõikega 6 tehakse ühinemisel järgmised deklaratsioonid: vastavalt konventsiooni artikli 20 lõike 2 punktile a deklareerib Eesti Vabariik, et teise liikmesriigi jälitavatel ametnikel ei ole õigus Eesti Vabariigi territooriumil isikut kinni pidada; vastavalt konventsiooni artikli 20 lõikele 3 deklareerib Eesti Vabariik, et jälitus, mida jätkatakse pärast piiriületamist, ei ole ruumiliselt ega ajaliselt piiratud; vastavalt konventsiooni artikli 20 lõike 4 punktile e deklareerib Eesti Vabariik, et jälitavad ametnikud võivad kanda oma teenistusrelva vastastikkuse põhimõttel; vastavalt konventsiooni artikli 26 lõikele 4 deklareerib Eesti Vabariik, et Eesti kohus võib taotleda pooleliolevas asjas Euroopa Ühenduste Kohtu eelotsust konventsiooni tõlgendamise kohta, kui Eesti kohtu arvates on tõlgendamise küsimus vaja lahendada otsuse tegemiseks; vastavalt konventsiooni artikli 32 lõikele 4 deklareerib Eesti Vabariik, et konventsiooni, välja arvatud artiklit 23, kohaldatakse Eesti Vabariigi ja samasuguse deklaratsiooni teinud liikmesriigi vahelistes suhetes.",
      "rdfs:label": {
        "@value": "TVAKKU_Par_2 (redaktsioon 828999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "828999"
    },
    {
      "@id": "estleg:TVAKKU_Par_3_v828999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TVAKKU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliameti peadirektoril määrata konventsiooni artikli 5 lõikes 1 nimetatud keskne juhtimisüksus.",
      "rdfs:label": {
        "@value": "TVAKKU_Par_3 (redaktsioon 828999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "828999"
    },
    {
      "@id": "estleg:TVAKKU_Par_4_v828999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TVAKKU_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrata tolliasutuste vastastikuse abi ja koostöö konventsiooni: artikli 20 lõikes 1 ja artikli 21 lõikes 1 nimetatud teabe edastajaks Maksu- ja Tolliamet; artikli 21 lõikes 1 nimetatud asutuseks, kellele saadetakse piiriülese jälgimise taotlus, Maksu- ja Tolliamet.",
      "rdfs:label": {
        "@value": "TVAKKU_Par_4 (redaktsioon 828999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "828999"
    }
  ]
}
