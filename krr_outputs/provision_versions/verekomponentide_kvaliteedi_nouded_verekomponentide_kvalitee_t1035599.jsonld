    {
      "@id": "estleg:Reg_1035599_Par_8_v1035599",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035599_Par_8"
