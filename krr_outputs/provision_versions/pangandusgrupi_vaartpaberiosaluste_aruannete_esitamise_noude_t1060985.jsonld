    },
    {
      "@id": "estleg:Reg_1060985_Par_1_v1060985",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060985_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse: 1 1) määruse § 3 lõikes 1 nimetatud aruannete (edaspidi aruanded) sisu- ja struktuurinõuded, mida tuleb järgida Euroopa Keskpanga määruse (EL) nr 1011/2012 väärtpaberiosaluste statistika kohta (ELT L 305, 1.11.2012, lk 6–24) artikkel 3a kohaste väärtpaberiosaluste andmete esitamisel; 2 2) määruse § 3 lõikes 1 nimetatud aruannete Eesti Pangale esitamise tähtajad ja kord. Määrusega kehtestatakse: määruse § 3 lõikes 1 nimetatud aruannete (edaspidi aruanded) sisu- ja struktuurinõuded, mida tuleb järgida Euroopa Keskpanga määruse (EL) nr 1011/2012 väärtpaberiosaluste statistika kohta (ELT L 305, 1.11.2012, lk 6–24) artikkel 3a kohaste väärtpaberiosaluste andmete esitamisel; määruse § 3 lõikes 1 nimetatud aruannete Eesti Pangale esitamise tähtajad ja kord.",
      "rdfs:label": {
        "@value": "Reg_1060985_Par_1 (redaktsioon 1060985)",
        "@language": "et"
      },
