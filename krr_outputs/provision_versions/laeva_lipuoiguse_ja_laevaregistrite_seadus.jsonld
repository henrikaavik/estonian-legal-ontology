      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "kinnitab laevapereta prahitud laevade registri vormi ja pidamise korra. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „Majandus- ja kommunikatsiooniminister” sõnadega „Valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_97 (redaktsioon 123122013047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122013047",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_97_v112072014090"
      },
      "estleg:versionValidTo": {
