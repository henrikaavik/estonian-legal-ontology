      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva omanik või laevapereta prahtija on kohustatud tõendama asjaolusid, mis on nende laeval Eesti riigilipu kandmise lubamise alus.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_8 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399"
    },
    {
      "@id": "estleg:LaevaRS_Par_88_v22399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teede- ja sideminister kinnitab väikelaevaregistri vormi. (2) Teede- ja sideminister võib jagada väikelaevaregistri pidamise Veeteede Ameti kohalike allasutuste vahel, määrates ära allasutuste tööpiirkonnad. (3) Teede- ja sideminister kinnitab väikelaevaregistri pidamise korra.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_88 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399",
