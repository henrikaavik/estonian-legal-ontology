      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva kutsungi annab laevale raadiotehniliste seadmete registreerimisel Tarbijakaitse ja Tehnilise Järelevalve Amet.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_29 (redaktsioon 112122018047)",
        "@language": "et"
      },
