        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_97_v112072014090",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "kinnitab laevapereta prahitud laevade registri vormi ja pidamise korra.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_97 (redaktsioon 112072014090)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014090",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_97_v128022020013"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_97_v128022020013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Esimese ja teise laevapereta prahitud laevade registri eesmärk on koguda, säilitada ja avalikustada teavet ning pidada arvestust ja teostada järelevalvet nende laevade üle, mis käesoleva seaduse § 24 lõike 2 järgi on saanud õiguse kanda Eesti riigilippu. (2) Esimese ja teise laevapereta prahitud laevade registri vastutav töötleja on Veeteede Amet. (3) Esimese laevapereta prahitud laevade registri ja teise laevapereta prahitud laevade registri asutab ja nende põhimäärused kehtestab määrusega. , jõustumisaeg muudetud [RT I, 28.02.2020, 2]",
      "rdfs:label": {
        "@value": "LaevaRS_Par_97 (redaktsioon 128022020013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022020013",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_97_v110122020013"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_97_v110122020013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
