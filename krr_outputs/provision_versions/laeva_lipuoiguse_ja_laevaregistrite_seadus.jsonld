      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väikelaevaregistrit peab Veeteede Amet. (2) Väikelaevaregistrisse kantakse merelaev ja siseveelaev, mida eikantalaevaregistrisse ning mille omanik on füüsiline isik elukohaga Eestis või Eesti juriidiline isik.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_33 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_33_v185502"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_33_v185502",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
