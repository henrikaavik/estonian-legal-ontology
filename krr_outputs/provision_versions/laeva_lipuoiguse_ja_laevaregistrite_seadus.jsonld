      }
    },
    {
      "@id": "estleg:LaevaRS_Par_45_v105122014034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teisaldatava ujuvvahendi kinnistamiseks tuleb esitada järgmised dokumendid või dokumendid, mis sisaldavad järgmisi andmeid: teisaldatava ujuvvahendi nimi, number või muu tähis (tuleb märkida, et tegemist on teisaldatava ujuvvahendiga); asukoht; ehituskoht; omaniku andmed (omanikuks olemine tuleb tõendada), riigi puhul ka andmed riigivara valitseja ja volitatud asutuse kohta, kui viimane on määratud; omandi tekkimise alus, mis tuleb tõendada; dokumendid, mis tõendavad teisaldatava ujuvvahendi vastavust Eesti Vabariigis kehtestatud ohutusnõuetele; andmed riigilõivu tasumise kohta.",
      "rdfs:label": {
