      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapileti andmed ja selle väljastamise korra",
      "rdfs:label": {
        "@value": "LaevaRS_Par_16 (redaktsioon 123122010040)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122010040",
      "estleg:supersededByVersion": {
