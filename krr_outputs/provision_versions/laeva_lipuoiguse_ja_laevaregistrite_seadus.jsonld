      }
    },
    {
      "@id": "estleg:LaevaRS_Par_23_v128022020013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_23"
      },
