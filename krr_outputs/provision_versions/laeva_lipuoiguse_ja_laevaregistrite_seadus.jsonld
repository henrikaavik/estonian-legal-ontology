      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva kutsungi annab laevale raadiotehniliste seadmete registreerimisel Tehnilise Järelevalve Amet.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_29 (redaktsioon 12894902)",
