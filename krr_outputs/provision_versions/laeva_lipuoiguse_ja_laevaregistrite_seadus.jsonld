      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_68_v923335",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaregistri laevakinnistusregistriosa kolmandasse jakku \"Laeva koormatised\" kantakse: laeva koormavad piiratud asjaõigused ja märked nende kohta; [Punkti 2 sõnastus kuni 31. 12. 2005] hüpoteegi puhul hüpoteegipidaja, hüpoteegi rahaline suurus (hüpoteegi summa), intressimäärad ja muude kõrvalnõuete rahaline suurus; [Punkti 2 sõnastus alates 1. 01. 2006] hüpoteegi puhul hüpoteegipidaja, hüpoteegi rahaline suurus (hüpoteegi summa); muudatused kannetes ja kustutamine.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_68 (redaktsioon 923335)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "923335",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_68_v12894902"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_68_v12894902",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaregistri laevakinnistusregistriosa kolmandasse jakku \"Laeva koormatised\" kantakse: laeva koormavad piiratud asjaõigused ja märked nende kohta; hüpoteegi puhul hüpoteegipidaja, hüpoteegi rahaline suurus (hüpoteegi summa); muudatused kannetes ja kustutamine.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_68 (redaktsioon 12894902)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894902",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_68_v123122010040"
