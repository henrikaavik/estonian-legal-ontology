      }
    },
    {
      "@id": "estleg:LaevaRS_Par_70_v13238154",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitatavate laevade registri laevakinnistusregistriosa teise jakku «Ehitatava laeva omanik» kantakse: ehitatava laeva omaniku andmed, riigi puhul ka andmed riigivara valitseja ja volitatud asutuse kohta, kui need on määratud. Kui laeva omanikuks ei ole laeva ehitaja, siis viide dokumendile, millest tuleneb, et ehitatava laeva omanikuks on keegi teine; kui ehitatav laev on ühises omandis - omanike nimed, see, kas laev on ühis- või kaasomandis, kaasomandi korral kaasomanike osade suurus; laevaühing ja disponent, kui ehitatav laev on laevaühingu esemeks; märked omandi kohta; muudatused kannetes; kande õiguslik alus.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_70 (redaktsioon 13238154)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13238154",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_70_v105122014034"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_70_v105122014034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitatavate laevade registri laevakinnistusregistriosa teise jakku „Ehitatava laeva omanik” kantakse: ehitatava laeva omaniku andmed, välismaise laevaomaniku puhul ka esindaja andmed; viide dokumendile, millest tuleneb, et ehitatava laeva omanikuks ei ole laeva ehitaja, vaid keegi teine; kui ehitatav laev on ühises omandis - omanike nimed, see, kas laev on ühis- või kaasomandis, kaasomandi korral kaasomanike osade suurus; laevaühing ja disponent, kui ehitatav laev on laevaühingu esemeks; kehtetu - muudatused kannetes; kande õiguslik alus.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_70 (redaktsioon 105122014034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014034"
    },
    {
      "@id": "estleg:LaevaRS_Par_71_v22399",
      "@type": [
        "owl:NamedIndividual",
