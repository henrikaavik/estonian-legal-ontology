        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitatavate laevade registri laevakinnistusregistriosa teise jakku \"Ehitatava laeva omanik\" kantakse: ehitatava laeva omaniku nimi; kui ehitatava laeva omanikuks ei ole laeva ehitaja, siis viide dokumendile, millest tuleneb, etehitatavalaeva omanikuks on keegi teine; kui ehitatav laev on ühises omandis - omanike nimed, see, kas laev on ühis- või kaasomandis, kaasomandi korral kaasomanike osade suurus; laevaühing ja disponent, kui ehitatav laev on laevaühingu esemeks; märked omandi kohta; muudatused kannetes; kande õiguslik alus.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_70 (redaktsioon 22399)",
        "@language": "et"
      },
