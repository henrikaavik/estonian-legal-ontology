      }
    },
    {
      "@id": "estleg:LaevaRS_Par_64_v123122010040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_64"
      },
