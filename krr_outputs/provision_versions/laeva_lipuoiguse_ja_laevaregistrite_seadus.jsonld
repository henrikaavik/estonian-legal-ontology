      }
    },
    {
      "@id": "estleg:LaevaRS_Par_64_v123122013047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kanded ja andmed laeva kohta kantakse selle laeva laevakinnistusregistriossa. (2) Laevakinnistusregistriosal on pealkiri ja kolm jagu, mis jagunevad lahtriteks. (3) Laevakinnistusregistreid peetakse väljavõetavate vahelehtedega vihikutena või elektroonilisel kujul. Laevakinnistusregistriosa vormi kehtestab , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „justiitsminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_64 (redaktsioon 123122013047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122013047",
