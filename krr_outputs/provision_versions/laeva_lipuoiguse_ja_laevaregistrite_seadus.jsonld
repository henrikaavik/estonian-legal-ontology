    {
      "@id": "estleg:LaevaRS_Par_34_v22399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapereta prahitud laevade registrit peab Veeteede Amet. (2) Laevapereta prahitud laevade registrisse kantakse merelaev, mis käesoleva seaduse paragrahv 24 lõike 2 järgi võib kanda Eesti riigilippu.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_34 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399",
