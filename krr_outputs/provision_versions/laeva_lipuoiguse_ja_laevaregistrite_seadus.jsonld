        "@value": "2010-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_68_v123122010040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaregistri laevakinnistusregistriosa kolmandasse jakku «Laeva koormatised» kantakse: laeva koormavad piiratud asjaõigused ja märked nende kohta; hüpoteegi puhul hüpoteegipidaja, hüpoteegi rahaline suurus (hüpoteegi summa); muudatused kannetes ja kustutamine.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_68 (redaktsioon 123122010040)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122010040",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_68_v105122014034"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_68_v105122014034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevaregistri laevakinnistusregistriosa kolmandasse jakku „Laeva koormatised ja kitsendused” kantakse: laeva koormavad piiratud asjaõigused, laevaomandi kitsendused ja märked nende kohta, sealhulgas puudutatud isikute kitsendused oma õiguste käsutamisel; laeva omaniku käsutusõiguse kitsendused, samuti märked omandi kohta; andmed riigilipu kandmise õiguse kohta; hüpoteegi puhul hüpoteegipidaja, hüpoteegi rahaline suurus (hüpoteegi summa) ja märked hüpoteegi kohta. (2) Käesoleva paragrahvi lõike 1 punktis 3 nimetatud andmed ei ole kanded käesoleva seaduse ja laeva asjaõigusseaduse tähenduses. (3) Riigi omandis oleva laeva või riigile kuuluva piiratud asjaõiguse korral kantakse käesoleva paragrahvi lõikes 1 nimetatud jakku märkus riigivara valitseja kohta. Riigivara valitseja kohta märkuse sissekandmine ja selle muutmine toimub riigivara valitseja avalduse alusel.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_68 (redaktsioon 105122014034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014034"
    },
    {
      "@id": "estleg:LaevaRS_Par_69_v22399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ehitatavate laevade registri laevakinnistusregistriosa esimesse jakku \"Ehitatav laev\" kantakse: ehitatavat laeva identifitseerivad andmed; ehituskoht ja ehitaja; viide dokumendile, mis tõendab ehitatava laeva kõlblikkust kinnistamiseks; ehitatava laeva kinnistamine ja registrist kustutamine (kustutamise korral tuleb ära näidata põhjus); muudatused talletatud andmetes. (2) Käesoleva paragrahvi lõikes 1 loetletud andmed ei ole kanneteks käesoleva seaduse ja laeva asjaõigusseaduse tähenduses.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_69 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_69_v123122010040"
      },
      "estleg:versionValidTo": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_69_v123122010040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ehitatavate laevade registri laevakinnistusregistriosa esimesse jakku «Ehitatav laev» kantakse: ehitatavat laeva identifitseerivad andmed; ehituskoht ja ehitaja; viide dokumendile, mis tõendab ehitatava laeva kõlblikkust kinnistamiseks; ehitatava laeva kinnistamine ja registrist kustutamine (kustutamise korral tuleb ära näidata põhjus); muudatused talletatud andmetes. (2) Käesoleva paragrahvi lõikes 1 loetletud andmed ei ole kanneteks käesoleva seaduse ja laeva asjaõigusseaduse tähenduses.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_69 (redaktsioon 123122010040)",
        "@language": "et"
