        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_74_v923335",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevakinnistuspäevikus registreeritakse kinnistamisavaldused, milles on väljendatud soov kande tegemiseks. [Lõike 2 sõnastus kuni 31. 12. 2005] (2) Laevakinnistuspäevikusse kantakse ka avalduse vastuvõtmise kuupäev, puudutatud laeva registreerimise number, määruse tegemise aeg, määrusega puuduste kõrvaldamiseks antud tähtaeg, täiendavate dokumentide saabumise aeg, kinnistamisotsuse tegemise, sissekandmise ja teatavakstegemise aeg, kinnistamist läbiviivate isikute allkirjad, tehinguväärtus ja riigilõiv. [Lõike 2 sõnastus alates 1. 01. 2006] (2) Laevakinnistuspäevikusse kantakse ka avalduse vastuvõtmise kuupäev, puudutatud laeva registreerimise number, määruse tegemise aeg, määrusega puuduste kõrvaldamiseks antud tähtaeg, täiendavate dokumentide saabumise aeg, kandemääruse tegemise, sissekandmise ja teatavakstegemise aeg, kinnistamist läbiviivate isikute allkirjad, tehinguväärtus ja riigilõiv.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_74 (redaktsioon 923335)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "923335",
      "estleg:supersededByVersion": {
