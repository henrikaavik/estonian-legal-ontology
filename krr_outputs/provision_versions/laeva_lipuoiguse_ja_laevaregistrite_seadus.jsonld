      "estleg:versionRedactionId": "112072014090"
    },
    {
      "@id": "estleg:LaevaRS_Par_27_v22399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laeva kodusadam on sadam, mille kaudu laeva meresõiduks peamiselt kasutatakse. Eesti riigilippu kandva laeva kodusadam võib olla ainult Eesti sadam. (2) Kui Eesti riigilippu kandval laeval ei ole kodusadamat Eestis, siis loetakse selle laeva kodusadamaks Tallinna sadam. (3) Kodusadama nimi kantakse laevale teede- ja sideministri kinnitatud korras.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_27 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_27_v694797"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
