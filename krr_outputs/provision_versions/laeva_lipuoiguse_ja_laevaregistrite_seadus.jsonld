      }
    },
    {
      "@id": "estleg:LaevaRS_Par_16_v123122013047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapileti andmed ja selle väljastamise korra kehtestab , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „majandus- ja kommunikatsiooniminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_16 (redaktsioon 123122013047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122013047",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_16_v112072014090"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_16_v112072014090",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapileti andmed ja selle väljastamise korra kehtestab",
      "rdfs:label": {
        "@value": "LaevaRS_Par_16 (redaktsioon 112072014090)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014090",
