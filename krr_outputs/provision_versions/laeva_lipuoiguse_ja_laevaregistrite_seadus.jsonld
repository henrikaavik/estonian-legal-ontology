    {
      "@id": "estleg:LaevaRS_Par_16_v22399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapileti andmed ja selle väljastamise korra kehtestab teede- ja sideminister.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_16 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399",
