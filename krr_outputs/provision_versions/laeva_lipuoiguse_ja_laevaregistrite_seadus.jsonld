    {
      "@id": "estleg:LaevaRS_Par_77_2_v104082022005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_77_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe ja Kaitseliidu veesõidukite registri eesmärk on Kaitseväe ja Kaitseliidu ülesannete täitmiseks kasutatavate veesõidukite ning nende meresõidukõlblikkuse või sõidukõlblikkuse üle arvestuse pidamine. (2) Kaitseväe ja Kaitseliidu veesõidukite registri vastutav töötleja on Kaitsevägi. (3) Kaitseväe ja Kaitseliidu veesõidukite registri asutab ning selle põhimääruse kehtestab määrusega. (4) Kaitseväe ja Kaitseliidu veesõiduki käitamiseks kannab volitatud töötleja selle andmed registrisse.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_77_2 (redaktsioon 104082022005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104082022005"
    },
