      }
    },
    {
      "@id": "estleg:LaevaRS_Par_66_v105122014034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevaregistri laevakinnistusregistriosa esimesse jakku „Laeva andmed” kantakse: laeva identifitseerivad tunnused; tehnilised andmed laeva kohta; laeva kinnistamine ja kustutamine, kustutamise korral ka kustutamise põhjus; kehtetu - muudatused talletatud andmetes. (2) Käesoleva paragrahvi lõikes 1 loetletud andmed ei ole kanded käesoleva seaduse ja laeva asjaõigusseaduse tähenduses.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_66 (redaktsioon 105122014034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014034",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_66_v128022020013"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_66_v128022020013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevaregistri laevakinnistusregistriosa esimesse jakku „Laeva andmed” kantakse: laeva identifitseerivad tunnused; tehnilised andmed laeva kohta; vastutava isiku andmed ja kontaktandmed; , jõustumisaeg muudetud [RT I, 28.02.2020, 2] laeva kinnistamine ja kustutamine, kustutamise korral ka kustutamise põhjus; kehtetu - muudatused talletatud andmetes. (2) Käesoleva paragrahvi lõikes 1 loetletud andmed ei ole kanded käesoleva seaduse ja laeva asjaõigusseaduse tähenduses.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_66 (redaktsioon 128022020013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022020013"
    },
    {
      "@id": "estleg:LaevaRS_Par_67_v22399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaregistri laevakinnistusregistriosa teisse jakku \"Laeva omanik\" kantakse: laeva omaniku nimi; kui laev on ühises omandis - omanike nimed, see, kas laev on ühis- või kaasomandis, kaasomandi korral kaasomanike osade suurus; laevaühing ja disponent, kui laev on laevaühingu esemeks; märked omandi kohta; muudatused kannetes; kande õiguslik alus.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_67 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_67_v13238154"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_67_v13238154",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaregistri laevakinnistusregistriosa teisse jakku «Laeva omanik» kantakse: laeva omaniku andmed, riigi puhul ka andmed riigivara valitseja ja volitatud asutuse kohta, kui viimane on määratud; kui laev on ühises omandis – omanike nimed, see, kas laev on ühis- või kaasomandis, kaasomandi korral kaasomanike osade suurus; laevaühing ja disponent, kui laev on laevaühingu esemeks; märked omandi kohta; muudatused kannetes; kande õiguslik alus.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_67 (redaktsioon 13238154)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13238154",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_67_v105122014034"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_67_v105122014034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaregistri laevakinnistusregistriosa teisse jakku „Laeva omanik” kantakse: laeva omaniku andmed, välismaise laevaomaniku puhul ka esindaja andmed; kui laev on ühises omandis – omanike nimed, see, kas laev on ühis- või kaasomandis, kaasomandi korral kaasomanike osade suurus; laevaühing ja disponent, kui laev on laevaühingu esemeks; kehtetu - muudatused kannetes; kande õiguslik alus.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_67 (redaktsioon 105122014034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014034",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_67_v128022020013"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_67_v128022020013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaregistri laevakinnistusregistriosa teisse jakku „Laeva omanik” kantakse: laeva omaniku andmed; , jõustumisaeg muudetud [RT I, 28.02.2020, 2] kui laev on ühises omandis – omanike nimed, see, kas laev on ühis- või kaasomandis, kaasomandi korral kaasomanike osade suurus; laevaühing ja disponent, kui laev on laevaühingu esemeks; kehtetu - muudatused kannetes; kande õiguslik alus.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_67 (redaktsioon 128022020013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022020013"
    },
    {
      "@id": "estleg:LaevaRS_Par_68_v22399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaregistri laevakinnistusregistriosa kolmandasse jakku \"Laeva koormatised\" kantakse: laeva koormavad piiratud asjaõigused ja märked nende kohta; hüpoteegi puhul hüpoteegipidaja, hüpoteegi rahaline suurus (hüpoteegi summa), intressimäärad ja muude kõrvalnõuete rahaline suurus; muudatused kannetes ja kustutamine.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_68 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399",
