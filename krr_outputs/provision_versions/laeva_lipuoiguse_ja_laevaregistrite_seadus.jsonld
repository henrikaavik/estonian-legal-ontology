        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "LaevaRS_Par_106 (redaktsioon 13238154)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13238154"
    },
    {
      "@id": "estleg:LaevaRS_Par_107_v22399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1998. aasta 1. juulil. (2) Käesoleva seaduse paragrahv 100 ja paragrahv 101 punkt 3 jõustuvad 10. päeval pärast seaduse Riigi Teatajas avaldamist.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_107 (redaktsioon 22399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22399",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_107_v185502"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_107_v185502",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1998. aasta 1. juulil. (2) Käesolevaseaduse § 100 ja § 101 punkt 3 jõustuvad 10. päevalpärastseaduseRiigiTeatajasavaldamist.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_107 (redaktsioon 185502)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "185502",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_107_v194419"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_107_v194419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1998. aasta 1. juulil. (2) Käesoleva seaduse § 100 ja § 101 punkt 3 jõustuvad 10. päeval pärast seaduse Riigi Teatajas avaldamist.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_107 (redaktsioon 194419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194419",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_107_v254676"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_107_v254676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-02-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1998. aasta 1. juulil. (2) Käesoleva seaduse § 100 ja § 101 punkt 3 jõustuvad 10. päeval pärast seaduse Riigi Teatajas avaldamist. (3) Käesoleva seaduse § 4 lõige 2 ja § 41 jõustuvad Eesti ühinemisel Euroopa Liiduga eraldi seadusega.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_107 (redaktsioon 254676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "254676",
      "estleg:supersededByVersion": {
        "@id": "estleg:LaevaRS_Par_107_v694797"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LaevaRS_Par_107_v694797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1998. aasta 1. juulil. (2) Käesoleva seaduse § 100 ja § 101 punkt 3 jõustuvad 10. päeval pärast seaduse Riigi Teatajas avaldamist. (3) Käesoleva seaduse § 4 lõige 2 ja § 4 1 jõustuvad Eesti ühinemisel Euroopa Liiduga eraldi seadusega.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_107 (redaktsioon 694797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "694797",
      "estleg:supersededByVersion": {
