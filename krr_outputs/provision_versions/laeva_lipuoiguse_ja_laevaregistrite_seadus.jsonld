      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapileti andmed ja selle väljastamise korra kehtestab majandus- ja kommunikatsiooniminister.",
      "rdfs:label": {
        "@value": "LaevaRS_Par_16 (redaktsioon 694797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "694797",
