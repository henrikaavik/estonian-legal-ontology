      }
    },
    {
      "@id": "estleg:LaevaRS_Par_91_v128022020013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LaevaRS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõik esimese ja teise laevapereta prahitud laevade registri pidamisega seotud toimingud tehakse Veeteede Ameti otsuse alusel. , jõustumisaeg muudetud [RT I, 28.02.2020, 2]",
      "rdfs:label": {
        "@value": "LaevaRS_Par_91 (redaktsioon 128022020013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022020013",
      "estleg:supersededByVersion": {
