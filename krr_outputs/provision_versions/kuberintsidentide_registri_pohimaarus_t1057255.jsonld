    {
      "@id": "estleg:Reg_1057255_Par_2_v1057255",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057255_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri eesmärk on pidada arvestust küberintsidentide, küberohtude ja turvahaavatavuste üle ning analüüsida registrisse esitatud teavet küberintsidentide, küberohtude ja turvahaavatavuse ennetamiseks või lahendamiseks, ohuteadete edastamiseks ning järelevalvetoimingute tegemiseks. RT I 2026-03-11 4 111032026004 2026-04-01 Registri eesmärk on pidada arvestust küberintsidentide, küberohtude ja turvahaavatavuste üle ning analüüsida registrisse esitatud teavet küberintsidentide, küberohtude ja turvahaavatavuse ennetamiseks või lahendamiseks, ohuteadete edastamiseks ning järelevalvetoimingute tegemiseks.",
      "rdfs:label": {
        "@value": "Reg_1057255_Par_2 (redaktsioon 1057255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057255",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057255",
      "estleg:sourceAct": "Küberintsidentide registri põhimäärus",
      "estleg:provisionRef": "Reg_1057255 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057255_Map"
      }
    },
    {
