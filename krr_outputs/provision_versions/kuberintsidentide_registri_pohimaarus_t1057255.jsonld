        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri turvaklass on K1T1S2 ja turbeaste on M. Registri turvaklass on K1T1S2 ja turbeaste on M.",
      "rdfs:label": {
        "@value": "Reg_1057255_Par_4 (redaktsioon 1057255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057255",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057255",
