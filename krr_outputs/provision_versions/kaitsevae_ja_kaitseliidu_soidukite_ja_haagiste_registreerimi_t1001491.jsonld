      "estleg:versionValidFrom": {
        "@value": "2011-11-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse Kaitseväe ja Kaitseliidu sõidukite registrisse kantud mootorsõidukitele ja nende haagistele, maastikusõidukitele ja nende haagistele ning traktoritele, liikurmasinatele ning nende haagistele (edaspidi sõiduk) väljastatava registreerimistunnistuse vorm ning riiklike registreerimismärkide tüübid ja nende valmistamisele esitatavad nõuded. Käesoleva määrusega kehtestatakse Kaitseväe ja Kaitseliidu sõidukite registrisse kantud mootorsõidukitele ja nende haagistele, maastikusõidukitele ja nende haagistele ning traktoritele, liikurmasinatele ning nende haagistele (edaspidi sõiduk) väljastatava registreerimistunnistuse vorm ning riiklike registreerimismärkide tüübid ja nende valmistamisele esitatavad nõuded.",
      "rdfs:label": {
        "@value": "Reg_1001491_Par_1 (redaktsioon 1001491)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001491",
