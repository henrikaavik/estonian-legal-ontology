      "estleg:provisionRef": "Reg_1001491 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001491_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001491_Par_5_v1001491",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001491_Par_5"
