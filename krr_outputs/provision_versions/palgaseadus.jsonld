      ],
      "estleg:versionOf": {
        "@id": "estleg:PalS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-10-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) (tehtud töö eest tasu arvutamise viisid), arvestades sõlmitud kollektiivlepinguid. (2) Kehtetu –",
      "rdfs:label": {
        "@value": "PalS_Par_11 (redaktsioon 12869872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12869872",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12869872",
