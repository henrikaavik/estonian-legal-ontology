  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_palgaseadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Palgaseadus (87 versiooni)",
        "@language": "et"
      },
      "dc:source": "Palgaseadus"
    },
    {
      "@id": "estleg:PalS_Par_1_v22272",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PalS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Palgaseadus määrab kindlaks töölepingu alusel töötavate isikute töötasustamise ning neile töötasuga seotud tagatiste andmise ja hüvituste maksmise õigusliku korralduse. (2) Palgaseaduse rakendamise erisused majandusharudes (tegevusaladel) määratakse kindlaks seadustega või Vabariigi Valitsuse määrustega. (3) Avalikele teenistujatele laieneb käesolev seadus niivõrd, kuivõrd avalikku teenistust reguleeriva või muu seadusega ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "PalS_Par_1 (redaktsioon 22272)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22272",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22272",
      "estleg:sourceAct": "Palgaseadus",
      "estleg:provisionRef": "PalS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:PalS_Map_2026"
      }
    },
    {
      "@id": "estleg:PalS_Par_10_v22272",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PalS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Töötaja palgamäär määratakse kindlaks töölepingu sõlmimisel poolte kokkuleppel. (2) Palgamäära muudetakse poolte kokkuleppel, samuti palga alammäära muutmise korral, kui kehtestatud palga alammäär osutub madalamaks Vabariigi Valitsuse poolt või kollektiivlepinguga kehtestatust.",
      "rdfs:label": {
        "@value": "PalS_Par_10 (redaktsioon 22272)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22272",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22272",
      "estleg:sourceAct": "Palgaseadus",
      "estleg:provisionRef": "PalS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:PalS_Map_2026"
      }
    },
    {
      "@id": "estleg:PalS_Par_11_v22272",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PalS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tööandja kehtestab palgasüsteemid (tehtud töö eest tasu arvutamise viisid), arvestades sõlmitud kollektiivlepinguid. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "PalS_Par_11 (redaktsioon 22272)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22272",
