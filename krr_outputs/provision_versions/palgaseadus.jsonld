    {
      "@id": "estleg:PalS_Par_29_v22272",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PalS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööraamatu andmisega ja lõpparve maksmisega viivitamise aja eest on tööandja kohustatud maksma töötajale hüvitist keskmise palga ulatuses Eesti Vabariigi töölepingu seaduses (RT 1992, 15/16, 241; 1993, 10, 150; RT I 1993, 26, 441; 1995, 14, 170; 16, 228; 1996, 3, 57; 40, 773; 45, 850; 49, 953; 1997, 5/6, 32; 1998, 111, 1829; 1999, 16, 276; 60, 616; 2000, 25, 144; 51, 327; 57, 370; 102, 669; 2001, 17, 78; 42, 233) sätestatud korras.",
      "rdfs:label": {
        "@value": "PalS_Par_29 (redaktsioon 22272)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22272",
      "estleg:supersededByVersion": {
        "@id": "estleg:PalS_Par_29_v13100033"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22272",
      "estleg:sourceAct": "Palgaseadus",
      "estleg:provisionRef": "PalS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:PalS_Map_2026"
      }
    },
    {
      "@id": "estleg:PalS_Par_29_v13100033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PalS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööraamatu andmisega ja lõpparve maksmisega viivitamise aja eest on tööandja kohustatud maksma töötajale hüvitist keskmise palga ulatuses Eesti Vabariigi töölepingu seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "PalS_Par_29 (redaktsioon 13100033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13100033",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13100033",
      "estleg:sourceAct": "Palgaseadus",
      "estleg:provisionRef": "PalS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:PalS_Map_2026"
      }
    },
    {
      "@id": "estleg:PalS_Par_3_v22272",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PalS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Palgatingimustena käsitatakse käesolevas seaduses palgamäärasid, töötajale makstavaid lisatasusid ja juurdemakseid, palga arvutamise viise ja maksmise korda. (2) Töötaja palgatingimused ja nende muudatused määratakse kindlaks töölepingus.",
      "rdfs:label": {
        "@value": "PalS_Par_3 (redaktsioon 22272)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22272",
      "estleg:supersededByVersion": {
        "@id": "estleg:PalS_Par_3_v905365"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-04",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22272",
      "estleg:sourceAct": "Palgaseadus",
      "estleg:provisionRef": "PalS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:PalS_Map_2026"
      }
    },
    {
      "@id": "estleg:PalS_Par_3_v905365",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PalS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Palgatingimustena käsitatakse käesolevas seaduses palgamäära, lisatasu ja juurdemakset summana, mille hulka on arvutatud seaduse alusel kinnipidamisele kuuluvad maksud. Palgatingimustena käsitatakse ka palga arvutamise viisi ning maksmise korda. (2) Töötaja palgatingimused ja nende muudatused määratakse kindlaks töölepingus.",
      "rdfs:label": {
        "@value": "PalS_Par_3 (redaktsioon 905365)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "905365",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/905365",
      "estleg:sourceAct": "Palgaseadus",
      "estleg:provisionRef": "PalS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:PalS_Map_2026"
      }
    },
