    {
      "@id": "estleg:Reg_1055635_Par_2_v1055635",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055635_Par_2"
