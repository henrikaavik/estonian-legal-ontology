    {
      "@id": "estleg:Reg_1047652_Par_28_v1047652",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047652_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse saajal on õigus: 1 1) muuta projekti eelarvet ja tegevusi juhul, kui muudetakse projekti eelarves konkreetsetele tegevustele ette nähtud eelarveridade mahtu teiste eelarveridade mahu arvelt, kuid mitte rohkem kui 10% võrreldes algse eelarvereaga, tingimusel, et projekti eesmärk ei muutu ja toetussumma ei suurene, kooskõlastades muudatused KIKiga; 2 2) pikendada projekti abikõlblikkuse perioodi kuni kahe kuu võrra, teavitades muudatusest enne KIKi; 3 3) esitada käesoleva määruse § 23 lõike 1 kohane avaldus projekti muutmiseks; 4 4) saada KIKilt teavet ja nõuandeid, mis on seotud käesolevas määruses nimetatud toetuse saaja kohustuste täitmisega. Toetuse saajal on õigus: muuta projekti eelarvet ja tegevusi juhul, kui muudetakse projekti eelarves konkreetsetele tegevustele ette nähtud eelarveridade mahtu teiste eelarveridade mahu arvelt, kuid mitte rohkem kui 10% võrreldes algse eelarvereaga, tingimusel, et projekti eesmärk ei muutu ja toetussumma ei suurene, kooskõlastades muudatused KIKiga; pikendada projekti abikõlblikkuse perioodi kuni kahe kuu võrra, teavitades muudatusest enne KIKi; esitada käesoleva määruse § 23 lõike 1 kohane avaldus projekti muutmiseks; saada KIKilt teavet ja nõuandeid, mis on seotud käesolevas määruses nimetatud toetuse saaja kohustuste täitmisega.",
      "rdfs:label": {
        "@value": "Reg_1047652_Par_28 (redaktsioon 1047652)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047652",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047652",
      "estleg:sourceAct": "Arenguriikides kliimapoliitika eesmärkide saavutamiseks toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1047652 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047652_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047652_Par_29_v1047652",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047652_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "KIKil on õigus: 1 1) teha või korraldada projekti kohta ekspertiise ja järelevalvetoiminguid; 2 2) kontrollida toetuse kasutamist; 3 3) nõuda projekti kestuse, tegevuste, eesmärgi ja kulude kohta lisaandmeid ja -dokumente, mis tõendavad projekti nõuetekohast elluviimist ja toetuse saaja kohustuste nõuetekohast täitmist; 4 4) peatada toetuse väljamaksmine rikkumise kõrvaldamiseni, kui toetuse saaja rikub käesolevas määruses või taotluse rahuldamise otsuses sätestatud tingimusi; 5 5) vähendada väljamakstava toetuse suurust proportsionaalselt toetuse saaja omafinantseeringu vähenemisega. KIKil on õigus: teha või korraldada projekti kohta ekspertiise ja järelevalvetoiminguid; kontrollida toetuse kasutamist; nõuda projekti kestuse, tegevuste, eesmärgi ja kulude kohta lisaandmeid ja -dokumente, mis tõendavad projekti nõuetekohast elluviimist ja toetuse saaja kohustuste nõuetekohast täitmist; peatada toetuse väljamaksmine rikkumise kõrvaldamiseni, kui toetuse saaja rikub käesolevas määruses või taotluse rahuldamise otsuses sätestatud tingimusi; vähendada väljamakstava toetuse suurust proportsionaalselt toetuse saaja omafinantseeringu vähenemisega.",
      "rdfs:label": {
        "@value": "Reg_1047652_Par_29 (redaktsioon 1047652)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047652",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047652",
      "estleg:sourceAct": "Arenguriikides kliimapoliitika eesmärkide saavutamiseks toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1047652 § 29",
