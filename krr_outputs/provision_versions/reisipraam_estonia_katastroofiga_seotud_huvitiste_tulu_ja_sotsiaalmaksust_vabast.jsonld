  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_reisipraam_estonia_katastroofiga_seotud_huvitiste_tulu_ja_sotsiaalmaksust_vabast_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Reisipraam \"Estonia\" katastroofiga seotud hüvitiste tulu- ja sotsiaalmaksust vabastamise seadus (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Reisipraam \"Estonia\" katastroofiga seotud hüvitiste tulu- ja sotsiaalmaksust vabastamise seadus"
    },
    {
      "@id": "estleg:REKSHTSV_Par_1_v25095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REKSHTSV_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reisipraam «Estonia» katastroofist tekkinud kahju hüvitisi, mida maksavad kahju tekitamise eest vastutavad isikud reisipraam «Estonia» katastroofis hukkunute perekonnaliikmetele ja reisipraamilt eluga pääsenutele, ei maksustata tulu- ega sotsiaalmaksuga.",
      "rdfs:label": {
        "@value": "REKSHTSV_Par_1 (redaktsioon 25095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25095"
    },
    {
      "@id": "estleg:REKSHTSV_Par_2_v25095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:REKSHTSV_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hüvitis käesoleva seaduse mõistes hõlmab ka hüvitisele, kuni selle väljamaksmiseni kahju tekitamise eest vastutava isiku poolt, arvestatavaid intresse.",
      "rdfs:label": {
        "@value": "REKSHTSV_Par_2 (redaktsioon 25095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25095"
    },
    {
      "@id": "estleg:Reisipraam_Estonia_katastroo_Par_3_v25095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reisipraam_Estonia_katastroo_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-s 1 sätestatud maksuvabastus laieneb ka hukkunu perekonnaliikmete hulka mittekuuluvatele füüsilistele isikutele juhtudel, mil sellise hüvitise maksmine tuleneb seadusest või kahju tekitamise eest vastutava isiku poolt kannatanutele tehtud hüvitispakkumisest.",
      "rdfs:label": {
        "@value": "Reisipraam_Estonia_katastroo_Par_3 (redaktsioon 25095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25095"
    },
    {
      "@id": "estleg:Reisipraam_Estonia_katastroo_Par_4_v25095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reisipraam_Estonia_katastroo_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevat seadust kohaldatakse tagasiulatuvalt alates 1994. aasta 28. septembrist.",
      "rdfs:label": {
        "@value": "Reisipraam_Estonia_katastroo_Par_4 (redaktsioon 25095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25095"
    }
  ]
}
