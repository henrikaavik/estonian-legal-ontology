      }
    },
    {
      "@id": "estleg:Reg_1013960_Par_8_v1013960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013960_Par_8"
