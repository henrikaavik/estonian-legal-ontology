      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Jahikoerapassi taotlemise ja andmise kord ning passi vorm (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Jahikoerapassi taotlemise ja andmise kord ning passi vorm"
    },
    {
      "@id": "estleg:Reg_1013960_Par_1_v1013960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013960_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jahikoerapass on jahikoera omanikule antav dokument, mis tõendab temale kuuluva koera jahikõlblikkust. Jahikoerapass antakse tähtajatult. Jahikoerapass on jahikoera omanikule antav dokument, mis tõendab temale kuuluva koera jahikõlblikkust. Jahikoerapass antakse tähtajatult. 2 (2) Esmane jahikoerapass on jahikoera omanikule antav dokument, mis antakse kuni üheaastase jahikoera õpetamiseks ja katsetamiseks kehtivusega kuni üks aasta. Esmane jahikoerapass on jahikoera omanikule antav dokument, mis antakse kuni üheaastase jahikoera õpetamiseks ja katsetamiseks kehtivusega kuni üks aasta.",
      "rdfs:label": {
