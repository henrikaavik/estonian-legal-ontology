    {
      "@id": "estleg:Reg_1013960_Par_5_v1013960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013960_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahikoerapassi kaotamise või kasutamiskõlbmatuks muutumise korral tuleb uue jahikoerapassi saamiseks esitada passi andjale lisaks käesoleva määruse § 3 lõikes 1 punktides 1, 2, 3 ja 5 loetletule järgmised materjalid: 1 1) foto koerast külgvaates suurusega 40×50 mm; 2 2) jahikoerapassi kasutamiskõlbmatuks muutumise korral kasutamiskõlbmatu pass. Jahikoerapassi kaotamise või kasutamiskõlbmatuks muutumise korral tuleb uue jahikoerapassi saamiseks esitada passi andjale lisaks käesoleva määruse § 3 lõikes 1 punktides 1, 2, 3 ja 5 loetletule järgmised materjalid: foto koerast külgvaates suurusega 40×50 mm; jahikoerapassi kasutamiskõlbmatuks muutumise korral kasutamiskõlbmatu pass.",
      "rdfs:label": {
        "@value": "Reg_1013960_Par_5 (redaktsioon 1013960)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013960",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013960",
      "estleg:sourceAct": "Jahikoerapassi taotlemise ja andmise kord ning passi vorm",
      "estleg:provisionRef": "Reg_1013960 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013960_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1013960_Par_6_v1013960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013960_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jahikoerapassi andja registreerib jahikoerapassi taotluse kohe pärast selle saamist. Jahikoerapassi andja registreerib jahikoerapassi taotluse kohe pärast selle saamist. 2 (2) Jahikoerapassi andja kontrollib jahikoerapassi taotluse vastavust käesoleva määruse nõuetele ja taotluses esitatud andmete õigsust viie tööpäeva jooksul selle saamisest arvates. Jahikoerapassi andja kontrollib jahikoerapassi taotluse vastavust käesoleva määruse nõuetele ja taotluses esitatud andmete õigsust viie tööpäeva jooksul selle saamisest arvates. 3 (3) Kui jahikoerapassi taotlemiseks vajalikud materjalid ei vasta käesoleva määruse nõuetele, määrab passi andja tähtaja puuduste kõrvaldamiseks. Kui puudusi ei ole tähtaja jooksul kõrvaldatud, võib passi andja jätta taotlemiseks esitatud materjalid uuesti läbi vaatamata ning saadab otsuse koopia materjalide läbivaatamata jätmise kohta 15 tööpäeva jooksul puuduste kõrvaldamiseks määratud tähtaja möödumisest. Kui jahikoerapassi taotlemiseks vajalikud materjalid ei vasta käesoleva määruse nõuetele, määrab passi andja tähtaja puuduste kõrvaldamiseks. Kui puudusi ei ole tähtaja jooksul kõrvaldatud, võib passi andja jätta taotlemiseks esitatud materjalid uuesti läbi vaatamata ning saadab otsuse koopia materjalide läbivaatamata jätmise kohta 15 tööpäeva jooksul puuduste kõrvaldamiseks määratud tähtaja möödumisest.",
      "rdfs:label": {
        "@value": "Reg_1013960_Par_6 (redaktsioon 1013960)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013960",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013960",
      "estleg:sourceAct": "Jahikoerapassi taotlemise ja andmise kord ning passi vorm",
      "estleg:provisionRef": "Reg_1013960 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013960_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1013960_Par_7_v1013960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013960_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jahikoerapass antakse vähemalt üheaastasele jahikoerale. Jahikoerapass antakse vähemalt üheaastasele jahikoerale. 2 (2) Jahikoerapassi kaotamise või kasutamiskõlbmatuks muutumise korral antakse või vahetatakse pass kümne tööpäeva jooksul nõuetekohase taotluse saamise päevast arvates. Jahikoerapassi kaotamise või kasutamiskõlbmatuks muutumise korral antakse või vahetatakse pass kümne tööpäeva jooksul nõuetekohase taotluse saamise päevast arvates. 3 (3) Jahikoerapass väljastatakse jahikoera omanikule allkirja vastu või posti teel väljastusteatega ühe kuu jooksul nõuetekohase taotluse saamisest arvates. Jahikoerapass väljastatakse jahikoera omanikule allkirja vastu või posti teel väljastusteatega ühe kuu jooksul nõuetekohase taotluse saamisest arvates. 4 (4) Pärast jahikoera surma tagastab koera omanik jahikoerapassi ühe kuu jooksul passi andjale posti teel väljastusteatega või muul viisil. Pärast jahikoera surma tagastab koera omanik jahikoerapassi ühe kuu jooksul passi andjale posti teel väljastusteatega või muul viisil.",
      "rdfs:label": {
        "@value": "Reg_1013960_Par_7 (redaktsioon 1013960)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013960",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013960",
      "estleg:sourceAct": "Jahikoerapassi taotlemise ja andmise kord ning passi vorm",
      "estleg:provisionRef": "Reg_1013960 § 7",
      "estleg:partOfAct": {
