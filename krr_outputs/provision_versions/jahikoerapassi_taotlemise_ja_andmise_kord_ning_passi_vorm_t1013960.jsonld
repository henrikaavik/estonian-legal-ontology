    {
      "@id": "estleg:Reg_1013960_Par_2_v1013960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013960_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahikoerapassi annab ja antud jahikoerapasside arvestust peab Keskkonnaamet või jahiseaduse § 10 lõike 1 alusel Kliimaministeeriumiga halduslepingu sõlminud isik (edaspidi passi andja). RT I 2023-07-13 1 113072023001 2023-07-16 Jahikoerapassi annab ja antud jahikoerapasside arvestust peab Keskkonnaamet või jahiseaduse § 10 lõike 1 alusel Kliimaministeeriumiga halduslepingu sõlminud isik (edaspidi passi andja).",
      "rdfs:label": {
        "@value": "Reg_1013960_Par_2 (redaktsioon 1013960)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013960",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013960",
      "estleg:sourceAct": "Jahikoerapassi taotlemise ja andmise kord ning passi vorm",
      "estleg:provisionRef": "Reg_1013960 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013960_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1013960_Par_3_v1013960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013960_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jahikoerapassi, välja arvatud esmase jahikoerapassi saamiseks tuleb passi andjale esitada järgmised materjalid: 1 1) kirjalik taotlus; 2 2) koopia jahikoera tõugu tõendavast dokumendist ja dokumendist, mis tõendab, et koer on osalenud passistamisülevaatusel või koertenäitusel; 3 3) koopia dokumentidest, mis tõendavad andmeid koera kasvataja ja omaniku kohta; 4 4) kaks fotot jahikoerast külgvaates suurusega 40×50 mm; 5 5) esmane jahikoerapass selle olemasolu korral. Jahikoerapassi, välja arvatud esmase jahikoerapassi saamiseks tuleb passi andjale esitada järgmised materjalid: kirjalik taotlus; koopia jahikoera tõugu tõendavast dokumendist ja dokumendist, mis tõendab, et koer on osalenud passistamisülevaatusel või koertenäitusel; koopia dokumentidest, mis tõendavad andmeid koera kasvataja ja omaniku kohta; kaks fotot jahikoerast külgvaates suurusega 40×50 mm; esmane jahikoerapass selle olemasolu korral. 2 (2) Taotlus peab sisaldama: 1 1) taotleja ärinime, registrikoodi selle olemasolu korral, asukohta ja kontaktandmeid või nime, isikukoodi, aadressi ning kontaktandmeid; 2 2) jahikoerapassi kättetoimetamise soovitavat viisi ning selleks vajalikke kontaktandmeid; 3 3) taotluse esitamise kuupäeva ja taotleja allkirja. Taotlus peab sisaldama: taotleja ärinime, registrikoodi selle olemasolu korral, asukohta ja kontaktandmeid või nime, isikukoodi, aadressi ning kontaktandmeid; jahikoerapassi kättetoimetamise soovitavat viisi ning selleks vajalikke kontaktandmeid; taotluse esitamise kuupäeva ja taotleja allkirja.",
      "rdfs:label": {
        "@value": "Reg_1013960_Par_3 (redaktsioon 1013960)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013960",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013960",
      "estleg:sourceAct": "Jahikoerapassi taotlemise ja andmise kord ning passi vorm",
      "estleg:provisionRef": "Reg_1013960 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013960_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1013960_Par_4_v1013960",
      "@type": [
