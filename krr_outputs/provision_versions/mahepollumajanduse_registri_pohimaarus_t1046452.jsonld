    {
      "@id": "estleg:Reg_1046452_Par_18_v1046452",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046452_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri volitatud töötleja koostab ja avalikustab kooskõlastatult vastutava töötlejaga isiku otsest või kaudset identifitseerimist välistaval viisil ülevaated Eestis riikliku järelevalve tulemuste ning mahepõllumajanduse olukorra kohta. Registri volitatud töötleja koostab ja avalikustab kooskõlastatult vastutava töötlejaga isiku otsest või kaudset identifitseerimist välistaval viisil ülevaated Eestis riikliku järelevalve tulemuste ning mahepõllumajanduse olukorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1046452_Par_18 (redaktsioon 1046452)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046452",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046452",
      "estleg:sourceAct": "Mahepõllumajanduse registri põhimäärus",
      "estleg:provisionRef": "Reg_1046452 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046452_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046452_Par_19_v1046452",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046452_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Järelevalvet registri pidamise üle teostavad registri vastutav töötleja ning avaliku teabe seaduse § 531 lõikes 1 nimetatud asutus. Andmekaitsealast järelevalvet registri pidamise seaduslikkuse üle teostab Andmekaitse Inspektsioon vastavalt oma pädevusele. Järelevalvet registri pidamise üle teostavad registri vastutav töötleja ning avaliku teabe seaduse § 531 lõikes 1 nimetatud asutus. Andmekaitsealast järelevalvet registri pidamise seaduslikkuse üle teostab Andmekaitse Inspektsioon vastavalt oma pädevusele. 2 (2) Järelevalvet teostama õigustatud isikul on õigus vastavalt oma pädevusele igal ajal kontrollida registri pidamise vastavust seadustele ja muudele õigusaktidele ning saada teavet registriandmete väljastamise ja nende kasutamise kohta. Järelevalvet teostama õigustatud isikul on õigus vastavalt oma pädevusele igal ajal kontrollida registri pidamise vastavust seadustele ja muudele õigusaktidele ning saada teavet registriandmete väljastamise ja nende kasutamise kohta. 3 (3) Registri pidamisel tekkinud puuduste ilmnemise korral on registri volitatud töötleja kohustatud kõrvaldama järelevalvet teostanud isiku ettekirjutuses kajastatud puudused määratud tähtpäevaks. Registri pidamisel tekkinud puuduste ilmnemise korral on registri volitatud töötleja kohustatud kõrvaldama järelevalvet teostanud isiku ettekirjutuses kajastatud puudused määratud tähtpäevaks.",
      "rdfs:label": {
        "@value": "Reg_1046452_Par_19 (redaktsioon 1046452)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046452",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046452",
      "estleg:sourceAct": "Mahepõllumajanduse registri põhimäärus",
      "estleg:provisionRef": "Reg_1046452 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046452_Map"
      }
    },
