    {
      "@id": "estleg:TNSS_Par_3_v22445",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TNSS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tehniline kirjeldus hõlmab muuhulgas: kvaliteeti, toimivust ja ohutust; nõuetele vastavuse hindamise ja tõendamise protseduure; katseid ja katsemeetodeid; pakendamist, märgistamist ja etikettimist; sümboleid ja terminoloogiat; nime, mille all toodet müüakse või teenust osutatakse; klassifitseerimist; projekteerimist, kavandamist, valmistamist, tootmist, osutamist, kasutamist, tehnilist ümberseadistamist, hooldamist, hoidmist ja säilitamist; vedu; koostist, mõõtmeid ja muid tehnilisi näitajaid. (2) Tehnilise kirjelduse võib esitada tehnilises normis, standardis või muus dokumendis.",
      "rdfs:label": {
        "@value": "TNSS_Par_3 (redaktsioon 22445)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22445",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22445",
      "estleg:sourceAct": "Tehnilise normi ja standardi seadus",
      "estleg:provisionRef": "TNSS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:TNSS_Map_2026"
      }
    },
    {
      "@id": "estleg:TNSS_Par_4_v22445",
      "@type": [
