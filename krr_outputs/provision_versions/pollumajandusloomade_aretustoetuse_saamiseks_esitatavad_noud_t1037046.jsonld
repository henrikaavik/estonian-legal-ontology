    {
      "@id": "estleg:Reg_1037046_Par_2_v1037046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037046_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetus on riigiabi komisjoni määruse (EL) 2022/2472, millega tunnistatakse teatavat liiki abi põllumajandus- ja metsandussektoris ja maapiirkondades Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamisel siseturuga kokkusobivaks (ELT L 327, 21.12.2022, lk 1–81), artikli 27 tähenduses. RT I 2023-01-28 9 128012023009 2023-02-01 Toetus on riigiabi komisjoni määruse (EL) 2022/2472, millega tunnistatakse teatavat liiki abi põllumajandus- ja metsandussektoris ja maapiirkondades Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamisel siseturuga kokkusobivaks (ELT L 327, 21.12.2022, lk 1–81), artikli 27 tähenduses. 2 (2) Riigiabi saaja on põllumajandustootja, kellele osutatakse tõuraamatu või aretusregistri pidamise, jõudluskontrolli läbiviimise või geneetilise väärtuse hindamise teenust. Riigiabi saaja on põllumajandustootja, kellele osutatakse tõuraamatu või aretusregistri pidamise, jõudluskontrolli läbiviimise või geneetilise väärtuse hindamise teenust.",
      "rdfs:label": {
        "@value": "Reg_1037046_Par_2 (redaktsioon 1037046)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037046",
