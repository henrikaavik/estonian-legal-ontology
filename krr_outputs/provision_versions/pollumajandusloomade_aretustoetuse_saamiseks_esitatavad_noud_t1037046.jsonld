      "estleg:provisionRef": "Reg_1037046 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037046_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037046_Par_12_v1037046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037046_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus nõutakse tagasi riigieelarve tuludesse maaelu ja põllumajandusturu korraldamise seaduse §-s 42 sätestatud juhtudel. Toetus nõutakse tagasi riigieelarve tuludesse maaelu ja põllumajandusturu korraldamise seaduse §-s 42 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "Reg_1037046_Par_12 (redaktsioon 1037046)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037046",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037046",
      "estleg:sourceAct": "Põllumajandusloomade aretustoetuse saamiseks esitatavad nõuded ning toetuse taotlemise ja taotluse menetlemise kord",
      "estleg:provisionRef": "Reg_1037046 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037046_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037046_Par_12_13_v1037046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037046_Par_12_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jõudluskontrolli läbiviimise või geneetilise väärtuse hindamise kulude hüvitamiseks võib aretusühing 2019. aastal taotleda toetust nende riigiabi saajate kohta, kes on esitanud § 3 lõike 3 kohaselt abitaotluse aretusühingule või 31. detsembrini 2018. aastal tegevusluba omanud jõudluskontrolli läbiviijale. RT I 2019-01-29 1 129012019001 2019-02-01 Jõudluskontrolli läbiviimise või geneetilise väärtuse hindamise kulude hüvitamiseks võib aretusühing 2019. aastal taotleda toetust nende riigiabi saajate kohta, kes on esitanud § 3 lõike 3 kohaselt abitaotluse aretusühingule või 31. detsembrini 2018. aastal tegevusluba omanud jõudluskontrolli läbiviijale. 2 (2) 2021. aastal kohaldatakse toetuse andmisel komisjoni määruse (EL) nr 702/2014 artikli 1 lõike 6 punktis c sätestatud erandit raskustes olevate ettevõtjate suhtes. RT I 2021-01-22 13 122012021013 2021-01-25 2021. aastal kohaldatakse toetuse andmisel komisjoni määruse (EL) nr 702/2014 artikli 1 lõike 6 punktis c sätestatud erandit raskustes olevate ettevõtjate suhtes. 3 (3) Enne 1. jaanuari 2025. aastal antud tegevusluba ja heaks kiidetud aretusprogrammi omavale taotlejale võib toetust anda, kui see tegevusluba on antud ja aretusprogramm heaks kiidetud vähemalt üks aasta enne toetuste taotluste esitamise tähtaja algust. RT I 2024-12-29 7 129122024007 2025-01-01 Enne 1. jaanuari 2025. aastal antud tegevusluba ja heaks kiidetud aretusprogrammi omavale taotlejale võib toetust anda, kui see tegevusluba on antud ja aretusprogramm heaks kiidetud vähemalt üks aasta enne toetuste taotluste esitamise tähtaja algust. 4 (4) 2026. aastal võetakse eesti vuti jõudluskontrolli läbiviimise või geneetilise väärtuse hindamise kulude hüvitamiseks ühele taotlejale antava toetuse maksimaalse suuruse arvutamisel arvesse jõudluskontrolli all olevate eesti vuttide arv 20. detsembri 2025. aasta seisuga. RT I 2025-12-17 11 117122025011 2025-12-20 2026. aastal võetakse eesti vuti jõudluskontrolli läbiviimise või geneetilise väärtuse hindamise kulude hüvitamiseks ühele taotlejale antava toetuse maksimaalse suuruse arvutamisel arvesse jõudluskontrolli all olevate eesti vuttide arv 20. detsembri 2025. aasta seisuga.",
      "rdfs:label": {
        "@value": "Reg_1037046_Par_12_13 (redaktsioon 1037046)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037046",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037046",
