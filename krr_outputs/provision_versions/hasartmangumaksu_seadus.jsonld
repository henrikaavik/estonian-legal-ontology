      },
      "estleg:versionValidTo": {
        "@value": "2025-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HasMMS_Par_8_v130122025010",
      "@type": [
        "owl:NamedIndividual",
