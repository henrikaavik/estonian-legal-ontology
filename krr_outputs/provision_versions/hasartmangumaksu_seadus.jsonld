        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HasMMS_Par_13_v13315648",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HasMMS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "HasMMS_Par_13 (redaktsioon 13315648)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315648"
    },
    {
      "@id": "estleg:HasMMS_Par_14_v13177851",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HasMMS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2009. aasta 1. juunil. (2) Käesoleva seaduse § 1 lõike 1 punkt 5 ning § 6 punkt 7 jõustuvad 2010. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "HasMMS_Par_14 (redaktsioon 13177851)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13177851"
    },
    {
      "@id": "estleg:HasMMS_Par_2_v27818",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HasMMS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hasartmängumaksu maksab hasartmängukorraldaja.",
      "rdfs:label": {
        "@value": "HasMMS_Par_2 (redaktsioon 27818)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27818"
    },
    {
      "@id": "estleg:HasMMS_Par_3_v27818",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HasMMS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õnnemängu, loterii ja osavusmängu korraldamisel on maksustamisperiood üks kalendrikuu. (2) Kihlveo ja totalisaatori korraldamisel ning sellise õnnemängu korraldamisel, mida ei korraldata mängulaual ega mänguautomaadil, on maksustamisperiood ühe kihlveo või totalisaatori või õnnemängu korraldamise periood, mis algab mängureeglites märgitud panuste tegemise esimesest päevast ja lõpeb mängureeglites märgitud võitude väljaandmise viimase päevaga.",
      "rdfs:label": {
        "@value": "HasMMS_Par_3 (redaktsioon 27818)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27818",
      "estleg:supersededByVersion": {
        "@id": "estleg:HasMMS_Par_3_v1040649"
      },
      "estleg:versionValidTo": {
        "@value": "2006-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HasMMS_Par_3_v1040649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HasMMS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õnnemängu, loterii ja osavusmängu korraldamisel on maksustamisperiood üks kalendrikuu. [Lõike 2 sõnastus kuni 31. 12. 2006] (2) Kihlveo ja totalisaatori korraldamisel ning sellise õnnemängu korraldamisel, mida ei korraldata mängulaual ega mänguautomaadil, on maksustamisperiood ühe kihlveo või totalisaatori või õnnemängu korraldamise periood, mis algab mängureeglites märgitud panuste tegemise esimesest päevast ja lõpeb mängureeglites märgitud võitude väljaandmise viimase päevaga. [Lõike 2 sõnastus alates 1. 01. 2007 (2) Kihlveo ja totalisaatori korraldamisel on maksustamisperiood ühe kihlveo või totalisaatori korraldamise periood, mis algab mängureeglites märgitud panuste tegemise esimesel päeval ja lõpeb mängureeglites märgitud võitude väljaandmise viimase päevaga.",
      "rdfs:label": {
        "@value": "HasMMS_Par_3 (redaktsioon 1040649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040649",
      "estleg:supersededByVersion": {
        "@id": "estleg:HasMMS_Par_3_v13177851"
      },
      "estleg:versionValidTo": {
        "@value": "2009-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HasMMS_Par_3_v13177851",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HasMMS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hasartmängumaksuga maksustamise periood on kalendrikuu. (2) Kaubandusliku loterii korraldamisel on maksustamisperiood kaubandusliku loterii korraldamise periood, mis algab mängureeglites märgitud panuste tegemise esimesel päeval ja lõpeb mängureeglites märgitud võitude väljaandmise viimasel päeval. (3) Õnnemänguturniiri korraldamisel on maksustamisperiood ühe õnnemänguturniiri korraldamise periood, mis algab õnnemänguturniiri reeglites märgitud osavõtutasude vastuvõtmise esimesel päeval ja lõpeb õnnemänguturniiri reeglites märgitud osavõtutasude vastuvõtmise lõpetamise päeval.",
      "rdfs:label": {
        "@value": "HasMMS_Par_3 (redaktsioon 13177851)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13177851"
    },
    {
      "@id": "estleg:HasMMS_Par_4_v27818",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HasMMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hasartmängukorraldaja, välja arvatud käesoleva paragrahvi lõikes 2 nimetatud isik, esitab Maksuametile hasartmängumaksu deklaratsiooni ja tasub hasartmängumaksu Maksuametile maksustamisperioodi lõppemisele järgneva kalendrikuu 15. kuupäevaks. (2) Õnnemängu korraldamiseks kasutatava mängulaua ja mänguautomaadi maksustamine toimub maksumärgi ostmisega õnnemängu korraldaja poolt. (3) Hasartmängumaksu deklaratsioon tuleb esitada ka käesoleva seaduse § 1 punktides 1, 3 ja 4 sätestatud summa puudumisel. (4) Hasartmängumaksu deklaratsiooni vormi ja täitmise juhendi kehtestab rahandusminister määrusega.",
      "rdfs:label": {
        "@value": "HasMMS_Par_4 (redaktsioon 27818)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27818",
      "estleg:supersededByVersion": {
        "@id": "estleg:HasMMS_Par_4_v693744"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HasMMS_Par_4_v693744",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HasMMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hasartmängukorraldaja, välja arvatud käesoleva paragrahvi lõikes 2 nimetatud isik, esitab Maksu- ja Tolliametile hasartmängumaksu deklaratsiooni ja tasub hasartmängumaksu Maksu- ja Tolliametile maksustamisperioodi lõppemisele järgneva kalendrikuu 15. kuupäevaks. (2) Õnnemängu korraldamiseks kasutatava mängulaua ja mänguautomaadi maksustamine toimub maksumärgi ostmisega õnnemängu korraldaja poolt. (3) Hasartmängumaksu deklaratsioon tuleb esitada ka käesoleva seaduse § 1 punktides 1, 3 ja 4 sätestatud summa puudumisel. (4) Hasartmängumaksu deklaratsiooni vormi ja täitmise juhendi kehtestab rahandusminister määrusega.",
      "rdfs:label": {
        "@value": "HasMMS_Par_4 (redaktsioon 693744)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693744",
      "estleg:supersededByVersion": {
        "@id": "estleg:HasMMS_Par_4_v1040649"
      },
      "estleg:versionValidTo": {
        "@value": "2006-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HasMMS_Par_4_v1040649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HasMMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hasartmängukorraldaja, välja arvatud käesoleva paragrahvi lõikes 2 nimetatud isik, esitab Maksu- ja Tolliametile hasartmängumaksu deklaratsiooni ja tasub hasartmängumaksu Maksu- ja Tolliametile maksustamisperioodi lõppemisele järgneva kalendrikuu 15. kuupäevaks. (2) Õnnemängu korraldamiseks kasutatava mängulaua ja mänguautomaadi maksustamine toimub maksumärgi ostmisega õnnemängu korraldaja poolt. (3) Hasartmängumaksu deklaratsioon tuleb esitada ka käesoleva seaduse § 1 punktides 1, 3 ja 4 sätestatud summa puudumisel. (4) Hasartmängumaksu deklaratsiooni vormi ja täitmise juhendi",
      "rdfs:label": {
        "@value": "HasMMS_Par_4 (redaktsioon 1040649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040649",
