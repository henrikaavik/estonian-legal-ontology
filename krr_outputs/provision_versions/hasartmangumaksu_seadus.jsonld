      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hasartmängumaksu määr on: 1406 eurot ühe mängulaua kohta; 300 eurot õnnemängu korraldamiseks kasutatava ühe mänguautomaadi kohta ja 10 protsenti hasartmängukorraldaja õnnemängu korraldamiseks kasutatavatel mänguautomaatidel tehtud panustest laekunud summast, millest on maha arvatud võidud; 32 eurot ühe osavusmängu mänguautomaadi kohta; 22 protsenti käesoleva seaduse § 1 lõike 1 punktis 2 sätestatud summast; 22 protsenti käesoleva seaduse § 1 lõike 1 punktis 3 sätestatud summast; 5,5 protsenti käesoleva seaduse § 1 lõike 1 punktis 4 sätestatud summast; 5,5 protsenti käesoleva seaduse § 1 lõike 1 punktis 5 sätestatud summast; 5,5 protsenti käesoleva seaduse § 1 lõike 1 punktide 6–9 alusel arvestatud summast.",
      "rdfs:label": {
        "@value": "HasMMS_Par_6 (redaktsioon 118022026002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118022026002"
