      },
      "estleg:versionValidTo": {
        "@value": "2009-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HasMMS_Par_9_v13177851",
      "@type": [
        "owl:NamedIndividual",
