      }
    },
    {
      "@id": "estleg:Reg_1000841_Par_20_v1000841",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000841_Par_20"
