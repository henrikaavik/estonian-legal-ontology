      }
    },
    {
      "@id": "estleg:Reg_1000841_Par_31_v1000841",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000841_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-08-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Raamatukogu tegevuse käigus loodud dokumente säilitatakse raamatukogu arhiivis alaliselt või määratud aja vältel. Raamatukogu tegevuse käigus loodud dokumente säilitatakse raamatukogu arhiivis alaliselt või määratud aja vältel. 2 (2) Raamatukogu arhiiv korraldatakse «Arhiiviseaduse» ja «Arhiiviseaduse» § 13 alusel kehtestatud arhiivieeskirja nõuete ja korra kohaselt. RT I 2011-12-20 8 120122011008 2012-01-01 68 Raamatukogu arhiiv korraldatakse «Arhiiviseaduse» ja «Arhiiviseaduse» § 13 alusel kehtestatud arhiivieeskirja nõuete ja korra kohaselt.",
      "rdfs:label": {
