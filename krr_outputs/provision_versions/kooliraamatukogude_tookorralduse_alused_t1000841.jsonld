      }
    },
    {
      "@id": "estleg:Reg_1000841_Par_33_v1000841",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000841_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-08-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Raamatukoguhoidja peab omama erialast haridust või kutsestandardi „Raamatukoguhoidja III, IV ja V“ kutsekvalifikatsiooni vähemalt III taset. Raamatukoguhoidja peab omama erialast haridust või kutsestandardi „Raamatukoguhoidja III, IV ja V“ kutsekvalifikatsiooni vähemalt III taset. 2 (2) Raamatukoguhoidjaga sõlmib, muudab ja lõpetab töölepingu kooli direktor. Raamatukoguhoidjaga sõlmib, muudab ja lõpetab töölepingu kooli direktor. 3 (3) Mitme töötajaga raamatukogus võib kooli direktor nimetada ühe töötaja raamatukogu juhatajaks. Mitme töötajaga raamatukogus võib kooli direktor nimetada ühe töötaja raamatukogu juhatajaks. 4 (4) Raamatukoguhoidja vastutab oma kogude hoidmise, säilimise ja kasutamisvõimaluste tagamise ning teavikute nõuetekohase arvestuse eest, samuti mittevajalike teavikute eemaldamise ja kasutamata teavikute üleandmise eest. Raamatukoguhoidja vastutab oma kogude hoidmise, säilimise ja kasutamisvõimaluste tagamise ning teavikute nõuetekohase arvestuse eest, samuti mittevajalike teavikute eemaldamise ja kasutamata teavikute üleandmise eest.",
      "rdfs:label": {
