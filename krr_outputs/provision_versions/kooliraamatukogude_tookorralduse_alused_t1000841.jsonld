    {
      "@id": "estleg:Reg_1000841_Par_32_v1000841",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000841_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-08-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Alaliselt säilitatavad dokumendid on: 1 1) aruanded; 2 2) põhikogu inventariraamatud; 3 3) põhikogu hulgiarvestusraamatud; 4 4) inventuuriaktid. Alaliselt säilitatavad dokumendid on: aruanded; põhikogu inventariraamatud; põhikogu hulgiarvestusraamatud; inventuuriaktid. 2 (2) Kümme aastat säilitatavad dokumendid on: 1 1) õppekirjanduse kogu summaararvestuse raamatud; 2 2) õppekirjanduse kogu saatedokumendid ja kustutusaktid; 3 3) põhikogu saatedokumendid ja kustutusaktid. Kümme aastat säilitatavad dokumendid on: õppekirjanduse kogu summaararvestuse raamatud; õppekirjanduse kogu saatedokumendid ja kustutusaktid; põhikogu saatedokumendid ja kustutusaktid.",
      "rdfs:label": {
        "@value": "Reg_1000841_Par_32 (redaktsioon 1000841)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000841",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000841",
      "estleg:sourceAct": "Kooliraamatukogude töökorralduse alused",
      "estleg:provisionRef": "Reg_1000841 § 32",
      "estleg:partOfAct": {
