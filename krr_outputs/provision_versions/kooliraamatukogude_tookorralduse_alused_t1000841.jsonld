      "estleg:provisionRef": "Reg_1000841 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000841_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1000841_Par_28_v1000841",
      "@type": [
        "owl:NamedIndividual",
