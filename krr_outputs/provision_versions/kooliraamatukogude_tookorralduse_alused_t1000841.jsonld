      "estleg:versionValidFrom": {
        "@value": "2013-08-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse põhikoolide ja gümnaasiumide raamatukogude (edaspidi raamatukogu) töökorralduse alused. Käesoleva määrusega kehtestatakse põhikoolide ja gümnaasiumide raamatukogude (edaspidi raamatukogu) töökorralduse alused.",
      "rdfs:label": {
        "@value": "Reg_1000841_Par_1 (redaktsioon 1000841)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000841",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000841",
