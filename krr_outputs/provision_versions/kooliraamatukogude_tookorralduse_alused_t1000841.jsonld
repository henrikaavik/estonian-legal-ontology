      "estleg:versionValidFrom": {
        "@value": "2013-08-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igas koolis on raamatukogu. Kooli teenindavaid raamatukogusid on kahte liiki: kooliraamatukogud-õpikeskused, õpperaamatukogud. Igas koolis on raamatukogu. Kooli teenindavaid raamatukogusid on kahte liiki: kooliraamatukogud-õpikeskused, õpperaamatukogud.",
      "rdfs:label": {
