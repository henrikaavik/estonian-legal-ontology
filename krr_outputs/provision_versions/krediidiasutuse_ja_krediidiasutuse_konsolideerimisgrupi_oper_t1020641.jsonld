        "@id": "estleg:Reg_1020641_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1020641_Par_5_v1020641",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1020641_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määruse §-s 3 nimetatud aruannete aruandeperiood on kvartal. Käesoleva määruse §-s 3 nimetatud aruannete aruandeperiood on kvartal. 2 (2) Käesoleva määruse §-s 3 nimetatud aruanded esitatakse aruandeperioodile järgneva kuu jooksul. Käesoleva määruse §-s 3 nimetatud aruanded esitatakse aruandeperioodile järgneva kuu jooksul.",
      "rdfs:label": {
        "@value": "Reg_1020641_Par_5 (redaktsioon 1020641)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1020641",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1020641",
      "estleg:sourceAct": "Krediidiasutuse ja krediidiasutuse konsolideerimisgrupi operatsiooniriski aruannete kehtestamine",
      "estleg:provisionRef": "Reg_1020641 § 5",
