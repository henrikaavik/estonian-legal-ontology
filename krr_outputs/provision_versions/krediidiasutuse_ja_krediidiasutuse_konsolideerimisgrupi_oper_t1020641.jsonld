      }
    },
    {
      "@id": "estleg:Reg_1020641_Par_6_v1020641",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1020641_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aruanded esitatakse Finantsinspektsioonile elektrooniliselt XML-is (eXtensible Markup Language) vormindatud dokumentidena Eesti Panga presidendi 29. mai 2018. aasta määruse nr 4 „Aruannete elektroonilise esitamise nõuded” (RT I, 05.06.2018, 1) kohaselt. RT I 2018-06-19 1 119062018001 2019-01-01 Aruanded esitatakse Finantsinspektsioonile elektrooniliselt XML-is (eXtensible Markup Language) vormindatud dokumentidena Eesti Panga presidendi 29. mai 2018. aasta määruse nr 4 „Aruannete elektroonilise esitamise nõuded” (RT I, 05.06.2018, 1) kohaselt. 2 (2) Kui Finantsinspektsioonile esitatud aruandes esineb vigu, on aruande esitanud krediidiasutusel kohustus esitada aruanne korrigeeritud kujul uuesti. Kui Finantsinspektsioonile esitatud aruandes esineb vigu, on aruande esitanud krediidiasutusel kohustus esitada aruanne korrigeeritud kujul uuesti. 3 (3) Aruannetes esitada tulevate andmete puudumisel esitatakse tühi aruanne. Aruannetes esitada tulevate andmete puudumisel esitatakse tühi aruanne. 4 (4) Aruannete koodid on järgmised: 1 1) „Operatsiooniriski intsidentide ja kahjujuhtumite aruanne”: 672; 2 2) „Operatsiooniriski võtmeindikaatorite aruanne”: 673; 3 3) „Hagide aruanne”: 674. Aruannete koodid on järgmised: „Operatsiooniriski intsidentide ja kahjujuhtumite aruanne”: 672; „Operatsiooniriski võtmeindikaatorite aruanne”: 673; „Hagide aruanne”: 674.",
      "rdfs:label": {
        "@value": "Reg_1020641_Par_6 (redaktsioon 1020641)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1020641",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1020641",
      "estleg:sourceAct": "Krediidiasutuse ja krediidiasutuse konsolideerimisgrupi operatsiooniriski aruannete kehtestamine",
      "estleg:provisionRef": "Reg_1020641 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1020641_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1020641_Par_7_v1020641",
      "@type": [
        "owl:NamedIndividual",
