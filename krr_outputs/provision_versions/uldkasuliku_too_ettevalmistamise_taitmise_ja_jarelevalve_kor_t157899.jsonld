      }
    },
    {
      "@id": "estleg:Reg_157899_Par_22_v157899",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157899_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Üldkasuliku töö lõppemisel edastab kriminaalhooldusosakond vajaduse korral kohtule või prokuratuurile kriminaalhooldusseaduse §-s 301 sätestatud nõuetest lähtudes ettekande kriminaalhoolduse lõppemise kohta. RT I 2021-07-23 2 123072021002 2021-07-26 Üldkasuliku töö lõppemisel edastab kriminaalhooldusosakond vajaduse korral kohtule või prokuratuurile kriminaalhooldusseaduse §-s 301 sätestatud nõuetest lähtudes ettekande kriminaalhoolduse lõppemise kohta. 2 (2) Üldkasuliku töö lõppemisel esitab kriminaalhooldusametnik andmed karistusregistrile karistusregistri seaduses ettenähtud korras. RT I 2021-07-23 2 123072021002 2021-07-26 Üldkasuliku töö lõppemisel esitab kriminaalhooldusametnik andmed karistusregistrile karistusregistri seaduses ettenähtud korras.",
      "rdfs:label": {
        "@value": "Reg_157899_Par_22 (redaktsioon 157899)",
        "@language": "et"
      },
