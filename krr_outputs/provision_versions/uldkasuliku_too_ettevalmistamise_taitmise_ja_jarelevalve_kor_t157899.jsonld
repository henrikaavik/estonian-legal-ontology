    {
      "@id": "estleg:Reg_157899_Par_23_v157899",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157899_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-08",
