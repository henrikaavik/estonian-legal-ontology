      }
    },
    {
      "@id": "estleg:Reg_1028959_Par_6_v1028959",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028959_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vigurlende ei tohi sooritada maareformi seaduse tähenduses tiheasustusega alade ja rahvakogunemiste kohal. RT I 2019-10-29 3 129102019003 2019-11-01 Vigurlende ei tohi sooritada maareformi seaduse tähenduses tiheasustusega alade ja rahvakogunemiste kohal. 2 (2) Vigurlennud, mis toimuvad lennundusürituse raames, tuleb kooskõlastada Lennuametiga nimetatud üritusele lennundusseaduse § 51 kohase ühekordse loa taotlemisel. Vigurlennud, mis toimuvad lennundusürituse raames, tuleb kooskõlastada Lennuametiga nimetatud üritusele lennundusseaduse § 51 kohase ühekordse loa taotlemisel.",
      "rdfs:label": {
        "@value": "Reg_1028959_Par_6 (redaktsioon 1028959)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028959",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028959",
      "estleg:sourceAct": "Riigisisesed lennureeglid ja erandid ning erisused komisjoni rakendusmääruses (EL) nr 923/2012 sätestatud lennureeglitest",
      "estleg:provisionRef": "Reg_1028959 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028959_Map"
      }
    },
    {
      "@id": "estleg:Reg_1028959_Par_7_v1028959",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028959_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mehitamata õhusõidukit tohib käitada mittekontrollitavas õhuruumis madalamal kui 500 jalga maa- või veepinnast nii, et see ei ohustaks inimesi, vara ja teisi õhusõidukeid. Mehitamata õhusõidukit tohib käitada mittekontrollitavas õhuruumis madalamal kui 500 jalga maa- või veepinnast nii, et see ei ohustaks inimesi, vara ja teisi õhusõidukeid. 2 (2) Mehitamata õhusõiduki käitamiseks mittekontrollitavas õhuruumis ülalpool käesoleva paragrahvi lõikes 1 sätestatud kõrgust, kontrollitavas õhuruumis ja lennuinfotsoonis peab olema lennundusseaduse § 51 kohane Lennuameti ühekordne luba. Mehitamata õhusõiduki käitamiseks mittekontrollitavas õhuruumis ülalpool käesoleva paragrahvi lõikes 1 sätestatud kõrgust, kontrollitavas õhuruumis ja lennuinfotsoonis peab olema lennundusseaduse § 51 kohane Lennuameti ühekordne luba. 3 (3) Mehitamata õhusõiduki käitamisel tuleb arvestada lennuliiklusteenindusüksuse antud juhiseid ja sõltuvalt õhuruumi klassist saada selleks eelnevalt lennujuhtimisüksuse luba. Mehitamata õhusõiduki käitamisel tuleb arvestada lennuliiklusteenindusüksuse antud juhiseid ja sõltuvalt õhuruumi klassist saada selleks eelnevalt lennujuhtimisüksuse luba.",
      "rdfs:label": {
        "@value": "Reg_1028959_Par_7 (redaktsioon 1028959)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028959",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028959",
      "estleg:sourceAct": "Riigisisesed lennureeglid ja erandid ning erisused komisjoni rakendusmääruses (EL) nr 923/2012 sätestatud lennureeglitest",
      "estleg:provisionRef": "Reg_1028959 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028959_Map"
      }
    },
    {
      "@id": "estleg:Reg_1028959_Par_8_v1028959",
