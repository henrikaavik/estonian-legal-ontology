      }
    },
    {
      "@id": "estleg:Reg_1028959_Par_2_v1028959",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028959_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas määruses kasutatakse mõisteid ja lühendeid järgmises tähenduses: 1 1) lennuvälja lennuinfoteenus (aerodrome flight information service – AFIS) on teenus, mis on ette nähtud mittekontrollitaval lennuväljal ja selle läheduses käitatavale õhusõidukile lennuohutuse ja efektiivsuse seisukohast vajalike nõuannete ja info andmiseks; 2 2) lennuinfotsoon (flight information zone – FIZ) on mittekontrollitav piiritletud õhuruum, milles osutatakse lennuvälja lennuinfoteenust. Käesolevas määruses kasutatakse mõisteid ja lühendeid järgmises tähenduses: lennuvälja lennuinfoteenus (aerodrome flight information service – AFIS) on teenus, mis on ette nähtud mittekontrollitaval lennuväljal ja selle läheduses käitatavale õhusõidukile lennuohutuse ja efektiivsuse seisukohast vajalike nõuannete ja info andmiseks; lennuinfotsoon (flight information zone – FIZ) on mittekontrollitav piiritletud õhuruum, milles osutatakse lennuvälja lennuinfoteenust.",
      "rdfs:label": {
        "@value": "Reg_1028959_Par_2 (redaktsioon 1028959)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028959",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028959",
      "estleg:sourceAct": "Riigisisesed lennureeglid ja erandid ning erisused komisjoni rakendusmääruses (EL) nr 923/2012 sätestatud lennureeglitest",
      "estleg:provisionRef": "Reg_1028959 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028959_Map"
      }
    },
    {
      "@id": "estleg:Reg_1028959_Par_3_v1028959",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028959_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õhuruumi klassis G peab mittekontrollitava lennuvälja ümber, kus osutatakse lennuvälja lennuinfoteenust vastava lennuliiklusteenindusüksuse tööajal, olema kehtestatud lennuinfotsoon ja kohustusliku raadioside ala (Radio Mandatory Zone – RMZ). Õhuruumi klassis G peab mittekontrollitava lennuvälja ümber, kus osutatakse lennuvälja lennuinfoteenust vastava lennuliiklusteenindusüksuse tööajal, olema kehtestatud lennuinfotsoon ja kohustusliku raadioside ala (Radio Mandatory Zone – RMZ). 2 (2) Enne igat lendu, mis toimub käesoleva paragrahvi lõikes 1 nimetatud alas, tuleb esitada lennuliiklusteenindusüksusele lennuplaan. Enne igat lendu, mis toimub käesoleva paragrahvi lõikes 1 nimetatud alas, tuleb esitada lennuliiklusteenindusüksusele lennuplaan.",
      "rdfs:label": {
        "@value": "Reg_1028959_Par_3 (redaktsioon 1028959)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028959",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028959",
      "estleg:sourceAct": "Riigisisesed lennureeglid ja erandid ning erisused komisjoni rakendusmääruses (EL) nr 923/2012 sätestatud lennureeglitest",
      "estleg:provisionRef": "Reg_1028959 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028959_Map"
      }
    },
