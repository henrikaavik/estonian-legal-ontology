    {
      "@id": "estleg:Reg_1007883_Par_2_v1007883",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1007883_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Keskusel on oma eelarve, mille kinnitab, muudab ja mille täitmist kontrollib energeetika- ja keskkonnaminister. RT I 2025-06-13 1 113062025001 2025-06-16 Keskusel on oma eelarve, mille kinnitab, muudab ja mille täitmist kontrollib energeetika- ja keskkonnaminister. 2 (2) Keskusel on väikese riigivapi kujutisega ja oma nimega pitsat ning kehtestatud korras registreeritud sümboolika, mille kasutamise kord määratakse keskuse asjaajamiskorras. RT I 2018-03-09 22 109032018022 2018-03-12 Keskusel on väikese riigivapi kujutisega ja oma nimega pitsat ning kehtestatud korras registreeritud sümboolika, mille kasutamise kord määratakse keskuse asjaajamiskorras. 3 (3) Keskuse dokumendiplankide ja pitsati kasutamise kord määratakse keskuse asjaajamiskorras. Keskuse struktuuriüksusel võivad olla oma nimega pitsat ja dokumendiplangid, kui see on ettenähtud struktuuriüksuse põhimääruses. Keskuse dokumendiplankide ja pitsati kasutamise kord määratakse keskuse asjaajamiskorras. Keskuse struktuuriüksusel võivad olla oma nimega pitsat ja dokumendiplangid, kui see on ettenähtud struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_1007883_Par_2 (redaktsioon 1007883)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1007883",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1007883",
      "estleg:sourceAct": "Keskkonnaministeeriumi Infotehnoloogiakeskuse põhimäärus",
      "estleg:provisionRef": "Reg_1007883 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1007883_Map_2026"
      }
    },
