      }
    },
    {
      "@id": "estleg:Reg_1000085_Par_9_v1000085",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000085_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Olemasolevale vabatahtliku päästja üleriietusele peab eritunnuse kandma hiljemalt 31. detsembriks 2011. a. RT I 2022-12-17 4 117122022004 2023-01-01 Olemasolevale vabatahtliku päästja üleriietusele peab eritunnuse kandma hiljemalt 31. detsembriks 2011. a. 2 (2) Kuni 15. juulini 2020. aastal kehtinud üleriietuse eritunnust, mis erineb käesolevas määruses kirjeldatust, võib kanda üleriietuse kandmiskõlbmatuks muutumiseni. RT I 2022-12-17 4 117122022004 2023-01-01 Kuni 15. juulini 2020. aastal kehtinud üleriietuse eritunnust, mis erineb käesolevas määruses kirjeldatust, võib kanda üleriietuse kandmiskõlbmatuks muutumiseni. 3 (3) Kuni 15. juulini 2020. aastal väljastatud tunnistused vahetab Päästeamet välja hiljemalt 15. juuliks 2030. RT I 2020-07-07 1 107072020001 2020-07-15 Kuni 15. juulini 2020. aastal väljastatud tunnistused vahetab Päästeamet välja hiljemalt 15. juuliks 2030.",
      "rdfs:label": {
        "@value": "Reg_1000085_Par_9 (redaktsioon 1000085)",
        "@language": "et"
      },
