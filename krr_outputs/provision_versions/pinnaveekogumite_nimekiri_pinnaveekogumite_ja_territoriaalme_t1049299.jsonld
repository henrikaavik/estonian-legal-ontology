    {
      "@id": "estleg:Reg_1049299_Par_6_v1049299",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049299_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pinnaveekogumi ökoloogilist seisundiklassi tähistatakse aruannetes ja ülevaadetes järgmiste tunnusvärvidega: 1 1) väga hea – eresinine; 2 2) hea – roheline; 3 3) kesine – kollane; 4 4) halb – oranž; 5 5) väga halb – punane. Pinnaveekogumi ökoloogilist seisundiklassi tähistatakse aruannetes ja ülevaadetes järgmiste tunnusvärvidega: väga hea – eresinine; hea – roheline; kesine – kollane; halb – oranž; väga halb – punane.",
      "rdfs:label": {
        "@value": "Reg_1049299_Par_6 (redaktsioon 1049299)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049299",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049299",
      "estleg:sourceAct": "Pinnaveekogumite nimekiri, pinnaveekogumite ja territoriaalmere seisundiklasside määramise kord, pinnaveekogumite ökoloogiliste seisundiklasside kvaliteedinäitajate väärtused ja pinnaveekogumiga hõlmamata veekogude kvaliteedinäitajate väärtused",
      "estleg:provisionRef": "Reg_1049299 § 6",
