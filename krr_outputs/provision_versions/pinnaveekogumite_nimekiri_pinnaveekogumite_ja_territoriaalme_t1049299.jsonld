      }
    },
    {
      "@id": "estleg:Reg_1049299_Par_41_v1049299",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049299_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rannikuveekogumi ökoloogilise seisundiklassi määramisel suurselgrootute põhjaloomade järgi võetakse aluseks ajavahemikus maist kuni septembrini tehtud suurselgrootute põhjaloomade analüüside ja vaatluste tulemused. Rannikuveekogumi ökoloogilise seisundiklassi määramisel suurselgrootute põhjaloomade järgi võetakse aluseks ajavahemikus maist kuni septembrini tehtud suurselgrootute põhjaloomade analüüside ja vaatluste tulemused. 2 (2) Rannikuveekogumi suurselgrootute määrang antakse käesoleva määruse lisa 6 järgi zoobentose koosluse indeksi ZKI2 alusel. Rannikuveekogumi suurselgrootute määrang antakse käesoleva määruse lisa 6 järgi zoobentose koosluse indeksi ZKI2 alusel.",
      "rdfs:label": {
        "@value": "Reg_1049299_Par_41 (redaktsioon 1049299)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049299",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049299",
      "estleg:sourceAct": "Pinnaveekogumite nimekiri, pinnaveekogumite ja territoriaalmere seisundiklasside määramise kord, pinnaveekogumite ökoloogiliste seisundiklasside kvaliteedinäitajate väärtused ja pinnaveekogumiga hõlmamata veekogude kvaliteedinäitajate väärtused",
      "estleg:provisionRef": "Reg_1049299 § 41",
