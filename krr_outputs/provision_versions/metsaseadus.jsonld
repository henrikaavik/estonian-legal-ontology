      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Metsamaterjali ja hakkpuidu mõõtmise ja nende mahu määramise meetodid ning mõõtmistäpsusele ja mõõtmistulemuste dokumenteerimisele esitatavad nõuded (2) Metsamaterjali ja hakkpuiduga sooritatavate tehingute tegemisel mõõdetakse metsamaterjali ja hakkpuitu ning määratakse nende mahtu käesoleva paragrahvi lõike 1 alusel kehtestatud mõõtmismeetodite kohaselt, kui pooled ei ole kirjalikult kokku leppinud mõne muu meetodi kasutamises.",
      "rdfs:label": {
        "@value": "METS_Par_39 (redaktsioon 1044018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044018",
