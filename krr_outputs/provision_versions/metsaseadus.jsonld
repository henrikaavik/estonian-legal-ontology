        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse §-des 28–31 sätestatule kehtestab keskkonnaminister metsa majandamise eeskirjaga:",
      "rdfs:label": {
        "@value": "METS_Par_33 (redaktsioon 1044018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044018",
      "estleg:supersededByVersion": {
        "@id": "estleg:METS_Par_33_v13099666"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:METS_Par_33_v13099666",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:METS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse §-des 28–31 sätestatule kehtestab keskkonnaminister metsa majandamise eeskirjaga täpsustatud nõuded: kasvama jäävate puude, loodusliku uuenduse, raielangi mulla ning ümbritseva metsa kaitseks; elustiku mitmekesisuse ja pärandkultuuriobjektide kaitseks; metsamaterjali kokkuveoteedele.",
      "rdfs:label": {
        "@value": "METS_Par_33 (redaktsioon 13099666)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13099666",
      "estleg:supersededByVersion": {
        "@id": "estleg:METS_Par_33_v13119089"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:METS_Par_33_v13119089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:METS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse §-des 28–31 sätestatule metsa majandamise eeskirjaga täpsustatud nõuded: kasvama jäävate puude, loodusliku uuenduse, raielangi mulla ning ümbritseva metsa kaitseks; elustiku mitmekesisuse ja pärandkultuuriobjektide kaitseks; metsamaterjali kokkuveoteedele.",
      "rdfs:label": {
        "@value": "METS_Par_33 (redaktsioon 13119089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13119089",
      "estleg:supersededByVersion": {
        "@id": "estleg:METS_Par_33_v111122013004"
      },
      "estleg:versionValidTo": {
        "@value": "2013-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:METS_Par_33_v111122013004",
      "@type": [
