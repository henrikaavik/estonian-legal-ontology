      }
    },
    {
      "@id": "estleg:METS_Par_47_v1044018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:METS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigimetsa Majandamise Keskus (edaspidi RMK) on riigitulundusasutus, kes riigimetsa majandajana tegutseb Keskkonnaministeeriumi valitsemisalas käesoleva seaduse, teiste õigusaktide ja oma põhimääruse alusel. (2) RMK põhimääruse (3) RMK juhtimisorganid on nõukogu ja juhatus. (4) RMK korraldatakse ümber ja tema tegevus lõpetatakse seadusega. (5) RMK registreeritakse riigi ja kohaliku omavalitsuse asutuste riiklikus registris. Nimetatud registris võib registreerida ka RMK piirkondlikke struktuuriüksusi, kui see on sätestatud RMK põhimääruses.",
      "rdfs:label": {
        "@value": "METS_Par_47 (redaktsioon 1044018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044018",
      "estleg:supersededByVersion": {
        "@id": "estleg:METS_Par_47_v108072014022"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-31",
        "@type": "xsd:date"
      }
    },
    {
