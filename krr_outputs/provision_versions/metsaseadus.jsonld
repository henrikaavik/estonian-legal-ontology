      }
    },
    {
      "@id": "estleg:METS_Par_28_v111122013004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:METS_Par_28"
      },
      "estleg:versionValidFrom": {
