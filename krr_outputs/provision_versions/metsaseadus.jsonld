      },
      "estleg:versionValidTo": {
        "@value": "2011-01-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:METS_Par_32_v105012011016",
      "@type": [
        "owl:NamedIndividual",
