      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metsaseadus (RT I 1998, 113/114, 1872; 2005, 70, 540) tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "METS_Par_73 (redaktsioon 1044018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044018"
    },
    {
      "@id": "estleg:METS_Par_79_v1044018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:METS_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tulumaksuseaduse (RT I 1999, 101, 903; 2006, 7, 41) § 37 lõike 8 punkt 1 muudetakse ja sõnastatakse järgmiselt: « 1) tegemist on metsa uuendamisega metsaseaduse tähenduses;».",
      "rdfs:label": {
        "@value": "METS_Par_79 (redaktsioon 1044018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044018",
      "estleg:supersededByVersion": {
