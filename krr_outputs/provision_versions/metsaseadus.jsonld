      ],
      "estleg:versionOf": {
        "@id": "estleg:METS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) RMK omandab vara riigihangete seaduses sätestatud korda järgides. (2) Kehtetu - (3) Vara omandamiseks peab läbirääkimisi vara omandamise otsustaja või tema volitatud isik. (4) Vara omandamise läbirääkimiste pidamise kord sätestatakse RMK põhimääruses. (5) Teade vara omandamise kohta avaldatakse RMK veebilehel.",
      "rdfs:label": {
        "@value": "METS_Par_65 (redaktsioon 105012011016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105012011016",
