    {
      "@id": "estleg:METS_Par_31_v13119089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:METS_Par_31"
      },
      "estleg:versionValidFrom": {
