      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 68–70 sätestatud väärtegudele kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. (2) Käesoleva seaduse §-des 68–70 sätestatud väärtegude kohtuväline menetleja on: Keskkonnaamet; politseiasutus.",
      "rdfs:label": {
        "@value": "METS_Par_72 (redaktsioon 110072020075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020075"
    },
    {
      "@id": "estleg:METS_Par_73_v1044018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
