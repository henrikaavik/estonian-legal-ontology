    {
      "@id": "estleg:Reg_1056228_Par_22_v1056228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056228_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotluse rahuldamise otsus tunnistatakse lisaks ühendmääruse § 14 lõigetes 1 ja 2 ning § 37 lõikes 7 sätestatule osaliselt või täielikult kehtetuks, kui: 1 1) toetuse saaja ei täida taotluse rahuldamise otsuses või õigusaktides sätestatut või ei kasuta toetust ettenähtud tingimustel; 2 2) projekti tegevusi ei ole võimalik lõpetada 2029. aasta 31. augustiks. Taotluse rahuldamise otsus tunnistatakse lisaks ühendmääruse § 14 lõigetes 1 ja 2 ning § 37 lõikes 7 sätestatule osaliselt või täielikult kehtetuks, kui: toetuse saaja ei täida taotluse rahuldamise otsuses või õigusaktides sätestatut või ei kasuta toetust ettenähtud tingimustel; projekti tegevusi ei ole võimalik lõpetada 2029. aasta 31. augustiks.",
      "rdfs:label": {
        "@value": "Reg_1056228_Par_22 (redaktsioon 1056228)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056228",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056228",
      "estleg:sourceAct": "Ettevõtja tootearenduse toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1056228 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056228_Map"
