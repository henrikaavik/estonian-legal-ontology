      }
    },
    {
      "@id": "estleg:VPVS_Par_17_v116112010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPVS_Par_17"
      },
      "estleg:versionValidFrom": {
