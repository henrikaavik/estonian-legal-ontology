    },
    {
      "@id": "estleg:VPVS_Par_23_v116112010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPVS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kandidaadi ülesseadmise õigus on vähemalt 21 valimiskogu liikmel. (2) Valimiskogu liige võib olla ainult ühe kandidaadi ülesseadjaks. (3) Kandidaatide registreerimiseks esitamine ja registreerimine toimub vastavalt käesoleva seaduse paragrahvi 15 lõigetele 3–10. Riigikogu esimeseks või teiseks vooruks registreeritud kandidaadi registreerimiseks esitamise korral ei ole vaja esildisele lisada käesoleva seaduse paragrahvi 15 lõike 5 punktides 2 ja 3 nimetatud dokumente.",
      "rdfs:label": {
        "@value": "VPVS_Par_23 (redaktsioon 116112010009)",
        "@language": "et"
      },
