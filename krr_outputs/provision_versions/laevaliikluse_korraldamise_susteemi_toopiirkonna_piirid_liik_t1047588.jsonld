      "dc:source": "Laevaliikluse korraldamise süsteemi tööpiirkonna piirid, liiklemise ning teadete ja informatsiooni edastamise kord"
    },
    {
      "@id": "estleg:Reg_1047588_Par_1_v1047588",
      "@type": [
        "owl:NamedIndividual",
