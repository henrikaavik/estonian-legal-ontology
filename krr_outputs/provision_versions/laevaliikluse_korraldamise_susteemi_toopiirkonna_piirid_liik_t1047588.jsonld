      "estleg:provisionRef": "Reg_1047588 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047588_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047588_Par_9_v1047588",
