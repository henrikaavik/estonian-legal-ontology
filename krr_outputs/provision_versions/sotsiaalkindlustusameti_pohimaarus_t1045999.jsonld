  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_sotsiaalkindlustusameti_pohimaarus_t1045999_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Sotsiaalkindlustusameti põhimäärus (13 versiooni)",
        "@language": "et"
      },
      "dc:source": "Sotsiaalkindlustusameti põhimäärus"
    },
    {
      "@id": "estleg:Reg_1045999_Par_1_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sotsiaalkindlustusamet (edaspidi amet) on Sotsiaalministeeriumi valitsemisalas tegutsev valitsusasutus, mis täidab õigusaktidest tulenevaid ülesandeid oma tegevusvaldkonnas ning teeb riiklikku järelevalvet ja kohaldab riiklikku sundi seaduses ettenähtud alustel ja ulatuses. Sotsiaalkindlustusamet (edaspidi amet) on Sotsiaalministeeriumi valitsemisalas tegutsev valitsusasutus, mis täidab õigusaktidest tulenevaid ülesandeid oma tegevusvaldkonnas ning teeb riiklikku järelevalvet ja kohaldab riiklikku sundi seaduses ettenähtud alustel ja ulatuses. 2 (2) Oma ülesannete täitmisel esindab amet riiki. Oma ülesannete täitmisel esindab amet riiki.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_1 (redaktsioon 1045999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045999",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045999",
      "estleg:sourceAct": "Sotsiaalkindlustusameti põhimäärus",
      "estleg:provisionRef": "Reg_1045999 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045999_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045999_Par_10_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Peadirektor: 1 1) juhib ameti tegevust struktuuriüksuste juhtide kaudu ning korraldab ameti pädevusse kuuluvate ülesannete täitmise; 2 2) esindab ametit selle tegevusvaldkonnas ning annab volitusi ameti esindamiseks; 3 3) vastutab ameti tegevust reguleerivate õigusaktide täpse ja otstarbeka täitmise eest ning annab ameti tegevusest aru valdkonna eest vastutavale ministrile; 4 4) esitab vajaduse korral valdkonna eest vastutavale ministrile ettepanekuid ameti tegevusvaldkonna korraldamiseks; 5 5) esitab valdkonna eest vastutavale ministrile ettepanekuid ameti eelarve kohta ning teeb järelevalvet eelarve täpse ja otstarbeka kasutamise üle; 5 5¹) kinnitab ameti tööplaanid ning tulude ja kulude alaeelarved; RT I 2024-10-18 11 118102024011 2025-01-01 6 6) korraldab ameti sisekontrollisüsteemi rakendamist; 7 7) nimetab ametisse ja vabastab ametist ameti koosseisu kuuluvad ametnikud või annab selleks volituse osakonnajuhatajale; RT I 2022-02-04 2 104022022002 2022-03-01 8 8) sõlmib, muudab ja lõpetab töölepinguid või annab selleks volituse osakonnajuhatajale; RT I 2022-02-04 2 104022022002 2022-03-01 9 9) kinnitab sisemist töökorraldust reguleerivad juhendid ja korrad, kinnitab ametijuhendid või annab volitusi ametijuhendite kinnitamiseks, ning kinnitab ametnike palgad vastavuses kehtivate õigusaktidega; 10 10) teeb teenistuslikku järelevalvet valdkonna eest vastutava ministri määratud ulatuses ja korras; 11 11) moodustab ameti tegevusvaldkonnas nõuandva õigusega alalisi või ajutisi komisjone, nõukogusid ja töörühmi; 12 12) käsutab riigivara riigivaraseaduses sätestatud korras; 13 13) sõlmib ameti nimel lepinguid või volitab selleks teisi isikuid; 14 14) määrab distsiplinaarkaristusi seaduses sätestatud juhtudel ja korras; 15 15) annab ametnikele volitusi, et teha ameti nimel toiminguid ja anda haldusakte seadustest ja muudest õigusaktidest tulenevate ülesannete täitmiseks; 16 16) annab teenistujatele volitusi, et teha ameti nimel toiminguid õigusaktidest ja käesolevast põhimäärusest tulenevate ülesannete täitmiseks; 17 17) täidab muid ülesandeid, mis on talle pandud seadusega, Vabariigi Valitsuse määruse või korraldusega, valdkonna eest vastutava ministri määruse või käskkirjaga. Peadirektor: juhib ameti tegevust struktuuriüksuste juhtide kaudu ning korraldab ameti pädevusse kuuluvate ülesannete täitmise; esindab ametit selle tegevusvaldkonnas ning annab volitusi ameti esindamiseks; vastutab ameti tegevust reguleerivate õigusaktide täpse ja otstarbeka täitmise eest ning annab ameti tegevusest aru valdkonna eest vastutavale ministrile; esitab vajaduse korral valdkonna eest vastutavale ministrile ettepanekuid ameti tegevusvaldkonna korraldamiseks; esitab valdkonna eest vastutavale ministrile ettepanekuid ameti eelarve kohta ning teeb järelevalvet eelarve täpse ja otstarbeka kasutamise üle; kinnitab ameti tööplaanid ning tulude ja kulude alaeelarved; korraldab ameti sisekontrollisüsteemi rakendamist; nimetab ametisse ja vabastab ametist ameti koosseisu kuuluvad ametnikud või annab selleks volituse osakonnajuhatajale; sõlmib, muudab ja lõpetab töölepinguid või annab selleks volituse osakonnajuhatajale; kinnitab sisemist töökorraldust reguleerivad juhendid ja korrad, kinnitab ametijuhendid või annab volitusi ametijuhendite kinnitamiseks, ning kinnitab ametnike palgad vastavuses kehtivate õigusaktidega; teeb teenistuslikku järelevalvet valdkonna eest vastutava ministri määratud ulatuses ja korras; moodustab ameti tegevusvaldkonnas nõuandva õigusega alalisi või ajutisi komisjone, nõukogusid ja töörühmi; käsutab riigivara riigivaraseaduses sätestatud korras; sõlmib ameti nimel lepinguid või volitab selleks teisi isikuid; määrab distsiplinaarkaristusi seaduses sätestatud juhtudel ja korras; annab ametnikele volitusi, et teha ameti nimel toiminguid ja anda haldusakte seadustest ja muudest õigusaktidest tulenevate ülesannete täitmiseks; annab teenistujatele volitusi, et teha ameti nimel toiminguid õigusaktidest ja käesolevast põhimäärusest tulenevate ülesannete täitmiseks; täidab muid ülesandeid, mis on talle pandud seadusega, Vabariigi Valitsuse määruse või korraldusega, valdkonna eest vastutava ministri määruse või käskkirjaga. 2 (2) Peadirektoril on õigus anda vastavalt õigusaktidele teenistusalastes küsimustes käskkirju. Peadirektoril on õigus anda vastavalt õigusaktidele teenistusalastes küsimustes käskkirju.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_10 (redaktsioon 1045999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045999",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045999",
      "estleg:sourceAct": "Sotsiaalkindlustusameti põhimäärus",
      "estleg:provisionRef": "Reg_1045999 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045999_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045999_Par_11_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Osakonnajuhataja: 1 1) juhib vahetult või talituse juhataja kaudu osakonna tööd ning vastutab osakonnale pandud ülesannete õiguspärase, täpse ja õigeaegse täitmise eest; 2 2) annab ameti peadirektorile aru osakonna tegevusest; 3 3) esindab osakonda ning esitab osakonna nimel arvamusi ja kooskõlastusi; 4 4) teeb ameti peadirektorile ettepanekuid osakonna struktuuri, koosseisu ja töökorralduse kohta ning osakonna töötajate töötasu määramiseks; 5 5) allkirjastab või viseerib osakonnas koostatud dokumente vastavalt ameti asjaajamiskorrale; 6 6) täidab teisi ameti peadirektori antud ülesandeid. Osakonnajuhataja: juhib vahetult või talituse juhataja kaudu osakonna tööd ning vastutab osakonnale pandud ülesannete õiguspärase, täpse ja õigeaegse täitmise eest; annab ameti peadirektorile aru osakonna tegevusest; esindab osakonda ning esitab osakonna nimel arvamusi ja kooskõlastusi; teeb ameti peadirektorile ettepanekuid osakonna struktuuri, koosseisu ja töökorralduse kohta ning osakonna töötajate töötasu määramiseks; allkirjastab või viseerib osakonnas koostatud dokumente vastavalt ameti asjaajamiskorrale; täidab teisi ameti peadirektori antud ülesandeid. 2 (2) Talituse juhataja: 1 1) juhib vahetult talituse tööd, tagab talituse ülesannete täitmise ning vastutab talitusele pandud ülesannete õiguspärase, täpse ja õigeaegse täitmise eest; 2 2) annab osakonnajuhatajale aru talituse tegevusest; 3 3) esindab talitust ning esitab talituse nimel arvamusi ja kooskõlastusi; 4 4) teeb osakonnajuhatajale ettepanekuid talituse struktuuri, koosseisu ja töökorralduse kohta ning talituse töötajate töötasu määramiseks; 5 5) allkirjastab või viseerib talituses koostatud dokumente vastavalt ameti asjaajamiskorrale; 6 6) täidab teisi osakonnajuhataja antud ülesandeid. Talituse juhataja: juhib vahetult talituse tööd, tagab talituse ülesannete täitmise ning vastutab talitusele pandud ülesannete õiguspärase, täpse ja õigeaegse täitmise eest; annab osakonnajuhatajale aru talituse tegevusest; esindab talitust ning esitab talituse nimel arvamusi ja kooskõlastusi; teeb osakonnajuhatajale ettepanekuid talituse struktuuri, koosseisu ja töökorralduse kohta ning talituse töötajate töötasu määramiseks; allkirjastab või viseerib talituses koostatud dokumente vastavalt ameti asjaajamiskorrale; täidab teisi osakonnajuhataja antud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_11 (redaktsioon 1045999)",
        "@language": "et"
      },
