    {
      "@id": "estleg:Reg_1045999_Par_13_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus jõustub 11. veebruaril 2019. a. Määrus jõustub 11. veebruaril 2019. a. 2 (2) Määruse § 6 rakendatakse tagasiulatuvalt 1. jaanuarist 2019. a. Määruse § 6 rakendatakse tagasiulatuvalt 1. jaanuarist 2019. a.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_13 (redaktsioon 1045999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045999",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045999",
      "estleg:sourceAct": "Sotsiaalkindlustusameti põhimäärus",
      "estleg:provisionRef": "Reg_1045999 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045999_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045999_Par_2_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet on aruandekohustuslik valdkonna eest vastutava ministri ees, kes suunab ja koordineerib ameti tegevust ning teeb ameti üle teenistuslikku järelevalvet õigusaktidega sätestatud korras. Amet on aruandekohustuslik valdkonna eest vastutava ministri ees, kes suunab ja koordineerib ameti tegevust ning teeb ameti üle teenistuslikku järelevalvet õigusaktidega sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_2 (redaktsioon 1045999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045999",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045999",
      "estleg:sourceAct": "Sotsiaalkindlustusameti põhimäärus",
      "estleg:provisionRef": "Reg_1045999 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045999_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045999_Par_3_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti kulud kaetakse riigieelarvest. Ametil on oma eelarve, mille kinnitab, mida muudab ja mille täitmist kontrollib valdkonna eest vastutav minister. Ameti kulud kaetakse riigieelarvest. Ametil on oma eelarve, mille kinnitab, mida muudab ja mille täitmist kontrollib valdkonna eest vastutav minister.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_3 (redaktsioon 1045999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045999",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045999",
      "estleg:sourceAct": "Sotsiaalkindlustusameti põhimäärus",
      "estleg:provisionRef": "Reg_1045999 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045999_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045999_Par_4_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet asub Tallinnas. Ameti mujal asuvate üksuste ja esinduste asukohad ning postiaadressid määrab ameti peadirektor. Amet asub Tallinnas. Ameti mujal asuvate üksuste ja esinduste asukohad ning postiaadressid määrab ameti peadirektor.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_4 (redaktsioon 1045999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045999",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045999",
      "estleg:sourceAct": "Sotsiaalkindlustusameti põhimäärus",
      "estleg:provisionRef": "Reg_1045999 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045999_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045999_Par_5_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti tegevusvaldkond on sotsiaalkaitse ja lastekaitse korraldamine. Ameti tegevusvaldkond on sotsiaalkaitse ja lastekaitse korraldamine.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_5 (redaktsioon 1045999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045999",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045999",
      "estleg:sourceAct": "Sotsiaalkindlustusameti põhimäärus",
      "estleg:provisionRef": "Reg_1045999 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045999_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045999_Par_6_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti ülesanded on: 1 1) riiklike pensionide, toetuste ja hüvitiste määramine ja maksmine; 2 2) alusetult tehtud sotsiaalkaitsekulutuste tagasinõudmine; 3 3) riigile üle läinud kuriteoga tekitatud kahju nõuete sissenõudmine; 4 4) puude tuvastamine ja raskusastme määramine; 5 5) riiklike sotsiaalteenuste korraldamine; 6 6) ohvriabiteenuste korraldamine; RT I 2024-10-18 11 118102024011 2025-01-01 7 7) rändega seotud teenuste korraldamine; 8 8) riikidevaheliste sotsiaalkindlustuslepingute ja muude rahvusvaheliste õigusaktide täitmine oma pädevuse piires; 9 9) sotsiaalmaksu maksmine erijuhtudel; 10 10) riiklike lastekaitseteenuste korraldamine; 11 11) riigisisese ja rahvusvahelise lapsendamise korraldamine; 12 12) riikliku järelevalve ja haldusjärelevalve tegemine; 13 13) sotsiaalteenuste tegevuslubade väljaandmine; 14 14) osalemine tegevusvaldkonnaga seotud poliitika ning strateegiate, arengukavade ja õigusaktide väljatöötamisel ja rahvusvahelistes projektides; 15 15) vaiete menetlemine; 16 16) oma pädevuse piires riigi ja ameti esindamine kohtus; 17 17) koostöö teiste ametiasutuste, välisriikide asjaomaste ametiasutuste ja rahvusvaheliste organisatsioonidega; 17 17¹) tagada läbi ameti esinduste tehniline teenindamine isikutele COVID-19 viiruse levikuga seotud vastavustõendite avalduste täitmiseks, vastuvõtmiseks ja väljastamiseks; RT I 2021-08-13 4 113082021004 2021-08-16 17 17²) sotsiaalvaldkonna koolituste korraldamine; RT I 2022-02-04 2 104022022002 2022-03-01 17 17³) sotsiaalhoolekande ja hüvitiste toimepidevuse edendamine; RT I 2024-10-18 11 118102024011 2025-01-01 18 18) muude õigusaktidega pandud ülesannete täitmine. Ameti ülesanded on: riiklike pensionide, toetuste ja hüvitiste määramine ja maksmine; alusetult tehtud sotsiaalkaitsekulutuste tagasinõudmine; riigile üle läinud kuriteoga tekitatud kahju nõuete sissenõudmine; puude tuvastamine ja raskusastme määramine; riiklike sotsiaalteenuste korraldamine; ohvriabiteenuste korraldamine; rändega seotud teenuste korraldamine; riikidevaheliste sotsiaalkindlustuslepingute ja muude rahvusvaheliste õigusaktide täitmine oma pädevuse piires; sotsiaalmaksu maksmine erijuhtudel; riiklike lastekaitseteenuste korraldamine; riigisisese ja rahvusvahelise lapsendamise korraldamine; riikliku järelevalve ja haldusjärelevalve tegemine; sotsiaalteenuste tegevuslubade väljaandmine; osalemine tegevusvaldkonnaga seotud poliitika ning strateegiate, arengukavade ja õigusaktide väljatöötamisel ja rahvusvahelistes projektides; vaiete menetlemine; oma pädevuse piires riigi ja ameti esindamine kohtus; koostöö teiste ametiasutuste, välisriikide asjaomaste ametiasutuste ja rahvusvaheliste organisatsioonidega; tagada läbi ameti esinduste tehniline teenindamine isikutele COVID-19 viiruse levikuga seotud vastavustõendite avalduste täitmiseks, vastuvõtmiseks ja väljastamiseks; sotsiaalvaldkonna koolituste korraldamine; sotsiaalhoolekande ja hüvitiste toimepidevuse edendamine; muude õigusaktidega pandud ülesannete täitmine.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_6 (redaktsioon 1045999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045999",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045999",
      "estleg:sourceAct": "Sotsiaalkindlustusameti põhimäärus",
      "estleg:provisionRef": "Reg_1045999 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045999_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045999_Par_7_v1045999",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045999_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ameti teenistuskohtade koosseisu kehtestab ameti peadirektor (edaspidi peadirektor) valdkonna eest vastutava ministri käskkirjaga kinnitatud teenistuskohtade arvu piires. Ameti teenistuskohtade koosseisu kehtestab ameti peadirektor (edaspidi peadirektor) valdkonna eest vastutava ministri käskkirjaga kinnitatud teenistuskohtade arvu piires. 2 (2) Ameti struktuuriüksused on ameti osakonnad. Osakondade koosseisu võivad kuuluda talitused. Ameti struktuuriüksused on ameti osakonnad. Osakondade koosseisu võivad kuuluda talitused. 3 (3) Ameti osakondade ja talituste ülesanded ning pädevus sätestatakse osakonna põhimääruses, mille kehtestab peadirektor. Ameti osakondade ja talituste ülesanded ning pädevus sätestatakse osakonna põhimääruses, mille kehtestab peadirektor. 4 (4) Ameti koosseisu võivad kuuluda väljaspool struktuuriüksusi asuvad teenistuskohad. RT I 2024-10-18 11 118102024011 2025-01-01 Ameti koosseisu võivad kuuluda väljaspool struktuuriüksusi asuvad teenistuskohad. 5 (5) Teenistujate ülesanded, pädevus, alluvus ja asendamine sätestatakse ametijuhendites. Teenistujate ülesanded, pädevus, alluvus ja asendamine sätestatakse ametijuhendites.",
      "rdfs:label": {
        "@value": "Reg_1045999_Par_7 (redaktsioon 1045999)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045999",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045999",
      "estleg:sourceAct": "Sotsiaalkindlustusameti põhimäärus",
      "estleg:provisionRef": "Reg_1045999 § 7",
