    {
      "@id": "estleg:Reg_1001687_Par_5_v1001687",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001687_Par_5"
