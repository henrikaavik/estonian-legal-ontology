    {
      "@id": "estleg:Reg_1055578_Par_11_v1055578",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055578_Par_11"
