    {
      "@id": "estleg:Reg_155671_Par_4_v155671",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155671_Par_4"
