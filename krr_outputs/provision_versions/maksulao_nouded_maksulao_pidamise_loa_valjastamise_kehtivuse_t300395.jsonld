  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_maksulao_nouded_maksulao_pidamise_loa_valjastamise_kehtivuse_t300395_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Maksulao nõuded, maksulao pidamise loa väljastamise, kehtivuse peatamise ja kehtetuks tunnistamise ning maksuladustamisel oleva kauba hoidmise ja vedamise kord (20 versiooni)",
        "@language": "et"
      },
      "dc:source": "Maksulao nõuded, maksulao pidamise loa väljastamise, kehtivuse peatamise ja kehtetuks tunnistamise ning maksuladustamisel oleva kauba hoidmise ja vedamise kord"
    },
    {
      "@id": "estleg:Reg_300395_Par_1_v300395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300395_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maksuladu on maksulaopidaja kasutuses olev hoone, ruum või territoorium, kus on lubatud Maksu- ja Tolliameti (edaspidi maksuhaldur) loa alusel teostada maksuladustamist. RT I 2012-11-28 3 128112012003 2012-12-01 Maksuladu on maksulaopidaja kasutuses olev hoone, ruum või territoorium, kus on lubatud Maksu- ja Tolliameti (edaspidi maksuhaldur) loa alusel teostada maksuladustamist. 2 (2) Kauba jaemüük maksulaos on keelatud. Kauba jaemüük maksulaos on keelatud. 3 (3) Maksulaona kasutatavad ruumid peavad olema eraldatud teiste isikute ja muudest mitteärilisel eesmärgil kasutatavatest ruumidest. Maksulaona kasutatavad ruumid peavad olema eraldatud teiste isikute ja muudest mitteärilisel eesmärgil kasutatavatest ruumidest. 4 (4) Maksulao sisse- ja väljapääsudele ning mahutitele, mis asuvad maksulaos, peab olema võimalik paigaldada tõkendit. Maksulao sisse- ja väljapääsudele ning mahutitele, mis asuvad maksulaos, peab olema võimalik paigaldada tõkendit.",
      "rdfs:label": {
        "@value": "Reg_300395_Par_1 (redaktsioon 300395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300395",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300395",
      "estleg:sourceAct": "Maksulao nõuded, maksulao pidamise loa väljastamise, kehtivuse peatamise ja kehtetuks tunnistamise ning maksuladustamisel oleva kauba hoidmise ja vedamise kord",
      "estleg:provisionRef": "Reg_300395 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_300395_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_300395_Par_10_v300395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300395_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maksuhaldur peatab loa kehtivuse otsusega. RT I 2018-01-04 17 104012018017 2018-01-07 Maksuhaldur peatab loa kehtivuse otsusega. 2 (2) Ajal, mil loa kehtivus on peatatud, ei ole lubatud kaupa paigutada maksuladustamisele, kuid võib kauba maksuladustamist lõpetada. Ajal, mil loa kehtivus on peatatud, ei ole lubatud kaupa paigutada maksuladustamisele, kuid võib kauba maksuladustamist lõpetada. 3 (3) Maksulaopidaja saab õiguse jätkata tegevust maksuhalduri otsuse alusel. RT I 2018-01-04 17 104012018017 2018-01-07 Maksulaopidaja saab õiguse jätkata tegevust maksuhalduri otsuse alusel.",
      "rdfs:label": {
        "@value": "Reg_300395_Par_10 (redaktsioon 300395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300395",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300395",
      "estleg:sourceAct": "Maksulao nõuded, maksulao pidamise loa väljastamise, kehtivuse peatamise ja kehtetuks tunnistamise ning maksuladustamisel oleva kauba hoidmise ja vedamise kord",
      "estleg:provisionRef": "Reg_300395 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_300395_Map_2026"
