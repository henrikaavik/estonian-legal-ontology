    {
      "@id": "estleg:Reg_345948_Par_11_v345948",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345948_Par_11"
