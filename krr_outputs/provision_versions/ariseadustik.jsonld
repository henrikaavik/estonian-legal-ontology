        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_62_v120122018002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
