      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrisse kantud ettevõtja kohta avatakse eraldi registrikaart. (2) Kehtetu - (3) Kehtetu - (4) Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_37 (redaktsioon 118122012007)",
        "@language": "et"
      },
