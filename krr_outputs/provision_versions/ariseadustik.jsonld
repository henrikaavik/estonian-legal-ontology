      }
    },
    {
      "@id": "estleg:ariseadustik_Par_109_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui osaniku võlausaldaja nõude rahuldamiseks on edutult toimunud täitmine osaniku varast, võib osaniku võlausaldaja kuue kuu jooksul, alates täitmise ebaõnnestumisest nõuda, et kohus arvaks osaniku täisühingust välja ning et tema nõue rahuldataks väljamakstava hüvituse arvel.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_109 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_109_v123122022033"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_109_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui osaniku võlausaldaja nõude rahuldamiseks on edutult toimunud täitmine osaniku varast, võib osaniku võlausaldaja kuue kuu jooksul, alates täitmise ebaõnnestumisest nõuda, et kohus arvaks osaniku täisühingust välja ning et tema nõue rahuldataks väljamakstava hüvitise arvel.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_109 (redaktsioon 123122022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022033"
    },
    {
      "@id": "estleg:ariseadustik_Par_11_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisest isikust ettevõtja ärinimi peab olema selgesti eristatav teistest sama registripidaja tööpiirkonnas äriregistrisse kantud või vähem kui kolm aastat tagasi äriregistrist kustutatud ärinimedest. (2) Äriühingu ärinimi peab olema selgesti eristatav teistest Eestis äriregistrisse kantud või vähem kui kolm aastat tagasi äriregistrist kustutatud ärinimedest. (2¹) Ärinimi ei pea olema eristatav vähem kui kolm aastat tagasi äriregistrist kustutatud ärinimest, kui õigus ärinimele omandati ettevõtja likvideerimisel või pankrotimenetluses või käesoleva seadustiku § 8 lõike 3 või 4 alusel või kui tegemist on välismaa äriühingu filiaali ärinimega. (3) Kui äriregistrisse on ärinimena või selle osana kantud sama füüsilise isiku ees- ja perekonnanimi, mille registrisse kandmist taotletakse, peab kande taotleja oma ärinime täiendite lisamise või ärajätmisega selgelt eristatavaks muutma.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_11 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_11_v973797"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_11_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisest isikust ettevõtja ärinimi peab olema selgesti eristatav teistest sama registripidaja tööpiirkonnas äriregistrisse kantud ärinimedest. (2) Äriühingu ärinimi peab olema selgesti eristatav teistest Eestis äriregistrisse kantud ärinimedest. (2¹) Kehtetu – (3) Kui äriregistrisse on ärinimena või selle osana kantud sama füüsilise isiku ees- ja perekonnanimi, mille registrisse kandmist taotletakse, peab kande taotleja oma ärinime täiendite lisamise või ärajätmisega selgelt eristatavaks muutma.",
