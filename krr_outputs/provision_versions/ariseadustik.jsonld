    },
    {
      "@id": "estleg:ariseadustik_Par_51_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui taotletakse äriregistrisse kande tegemist tegevusala kohta, millel tegutsemiseks on nõutav tegevusluba, tuleb see registripidajale eelnevalt esitada.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_51 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_51_v12767277"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_51_v12767277",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu–",
      "rdfs:label": {
        "@value": "ariseadustik_Par_51 (redaktsioon 12767277)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12767277",
