        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_143_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
