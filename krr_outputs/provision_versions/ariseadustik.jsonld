      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsionäri või tema esindaja poolt üldkoosolekul koostatavasse aktsionäride nimekirja kandmiseks andmete esitamata jätmise või ebaõigete andmete esitamise eest – karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_504_1 (redaktsioon 192290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "192290",
