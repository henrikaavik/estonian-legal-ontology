      "estleg:versionValidFrom": {
        "@value": "2011-11-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seaduses sätestatud juhtudel kontrollib ühinemislepingut audiitor. (2) Audiitor ei pea ühinemislepingut kontrollima, kui ühendatava ühingu kõik osad või aktsiad kuuluvad ühendavale ühingule või ühineva ühingu kõik osanikud või ühinevate aktsiaseltside kõik aktsionärid on nõus, et audiitor ühinemislepingut ei kontrolli.",
      "rdfs:label": {
