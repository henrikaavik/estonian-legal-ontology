        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaa äriühingu filiaali ärinimi koosneb äriühingu ärinimest ja sõnadest «Eesti filiaal».",
      "rdfs:label": {
        "@value": "ariseadustik_Par_14 (redaktsioon 13259183)",
        "@language": "et"
