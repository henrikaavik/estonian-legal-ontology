      },
      "estleg:versionValidTo": {
        "@value": "2017-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_64_v126062017049",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrikaardile kantakse: ettevõtja või ühingu ärinimi ja registrikood; ettevõtja või ühingu asukoht ja aadress; füüsilisest isikust ettevõtja andmed; andmed füüsilisest isikust ettevõtja ettevõtte tegevuse peatamise, hooajalise või ajutise tegutsemise kohta; äriühingu täisosanike, likvideerijate ja käesoleva seadustiku § 98 lõikes 3 ja §-s 131 nimetatud esindusõiguslike isikute andmed või ühingu juhatuse liikmete ning likvideerijate andmed; prokuristi andmed; ettevõtja õiguslik vorm või ühingu liik; ühingu põhikirja kinnitamise aeg; kokkulepped osanike esindusõiguste kohta või ühingu juhatuse liikmete ja likvideerijate volitused ühingu esindamisel; ettevõtja usaldusosanike andmed ning nende sissemaksete suurused; ühingu osa- või aktsiakapitali rahaline suurus; märge osaühingu sissemakseta asutamise kohta; märge osade registreerimise kohta Eesti väärtpaberite registris või märge aktsiaraamatu pidaja kohta; majandusaasta algus ja lõpp; pankrotiandmed vastavalt käesoleva seadustiku §-le 58; märge ühingu ühinemise, jagunemise ja ümberkujundamise ning lõpetamise ja kustutamise kohta; viide kannetele, mille registripidaja on teinud seadusest tulenevalt ettevõtja avalduseta; likvideeritud ühingu dokumentide hoidja andmed; kande kuupäev; viited hilisematele kannetele ja muud märkused.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_64 (redaktsioon 126062017049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062017049",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_64_v117112017022"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_64_v117112017022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrikaardile kantakse: ettevõtja või ühingu ärinimi ja registrikood; ettevõtja või ühingu asukoht ja aadress ning elektronposti aadress; juhatuse või seda asendava organi asukoha aadress, kui see asub välisriigis; füüsilisest isikust ettevõtja andmed; andmed füüsilisest isikust ettevõtja ettevõtte tegevuse peatamise, hooajalise või ajutise tegutsemise kohta; äriühingu täisosanike, likvideerijate ja käesoleva seadustiku § 98 lõikes 3 ja §-s 131 nimetatud esindusõiguslike isikute andmed või ühingu juhatuse liikmete ning likvideerijate andmed; prokuristi andmed; ettevõtja õiguslik vorm või ühingu liik; ühingu põhikirja kinnitamise aeg; kokkulepped osanike esindusõiguste kohta või ühingu juhatuse liikmete ja likvideerijate volitused ühingu esindamisel; kontaktisiku nimi või ärinimi, isiku- või registrikood ning ettevõtjale suunatud tahteavalduste ja ettevõtja menetlusdokumentide kättetoimetamise Eesti aadress, samuti kontaktisiku elektronposti aadress; ettevõtja usaldusosanike andmed ning nende sissemaksete suurused; ühingu osa- või aktsiakapitali rahaline suurus; märge osaühingu sissemakseta asutamise kohta; märge osade registreerimise kohta Eesti väärtpaberite registris või märge aktsiaraamatu pidaja kohta; majandusaasta algus ja lõpp; pankrotiandmed vastavalt käesoleva seadustiku §-le 58; märge ühingu ühinemise, jagunemise ja ümberkujundamise ning lõpetamise ja kustutamise kohta; viide kannetele, mille registripidaja on teinud seadusest tulenevalt ettevõtja avalduseta; likvideeritud ühingu dokumentide hoidja andmed; kande kuupäev; viited hilisematele kannetele ja muud märkused.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_64 (redaktsioon 117112017022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112017022",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_64_v128022019010"
      },
      "estleg:versionValidTo": {
        "@value": "2019-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_64_v128022019010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrikaardile kantakse: ettevõtja või ühingu ärinimi ja registrikood; ettevõtja või ühingu asukoht ja aadress ning elektronposti aadress; juhatuse või seda asendava organi asukoha aadress, kui see asub välisriigis; füüsilisest isikust ettevõtja andmed; andmed füüsilisest isikust ettevõtja ettevõtte tegevuse peatamise, hooajalise või ajutise tegutsemise kohta; äriühingu täisosanike, likvideerijate ja käesoleva seadustiku § 98 lõikes 3 ja §-s 131 nimetatud esindusõiguslike isikute andmed või ühingu juhatuse liikmete ning likvideerijate andmed; prokuristi andmed; ettevõtja õiguslik vorm või ühingu liik; ühingu põhikirja kinnitamise aeg; kokkulepped osanike esindusõiguste kohta või ühingu juhatuse liikmete ja likvideerijate volitused ühingu esindamisel; kontaktisiku nimi või ärinimi, isiku- või registrikood ning ettevõtjale suunatud tahteavalduste ja ettevõtja menetlusdokumentide kättetoimetamise Eesti aadress, samuti kontaktisiku elektronposti aadress; ettevõtja usaldusosanike andmed ning nende sissemaksete suurused; ühingu osa- või aktsiakapitali rahaline suurus; märge osaühingu sissemakseta asutamise kohta; märge osade registreerimise kohta Eesti väärtpaberite registris või märge aktsiaraamatu pidaja kohta; majandusaasta algus ja lõpp; pankrotiandmed ja andmed tagatisvara halduri määramise kohta vastavalt käesoleva seadustiku §-le 58; märge ühingu ühinemise, jagunemise ja ümberkujundamise ning lõpetamise ja kustutamise kohta; viide kannetele, mille registripidaja on teinud seadusest tulenevalt ettevõtja avalduseta; likvideeritud ühingu dokumentide hoidja andmed; kande kuupäev; viited hilisematele kannetele ja muud märkused.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_64 (redaktsioon 128022019010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022019010",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_64_v110072020035"
      },
      "estleg:versionValidTo": {
        "@value": "2020-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_64_v110072020035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrikaardile kantakse: ettevõtja või ühingu ärinimi ja registrikood; ettevõtja või ühingu asukoht ja aadress ning elektronposti aadress; juhatuse või seda asendava organi asukoha aadress, kui see asub välisriigis; füüsilisest isikust ettevõtja andmed; andmed füüsilisest isikust ettevõtja ettevõtte tegevuse peatamise, hooajalise või ajutise tegutsemise kohta; äriühingu täisosanike, likvideerijate ja käesoleva seadustiku § 98 lõikes 3 ja §-s 131 nimetatud esindusõiguslike isikute andmed või ühingu juhatuse liikmete ning likvideerijate andmed; prokuristi andmed; ettevõtja õiguslik vorm või ühingu liik; ühingu põhikirja kinnitamise aeg; kokkulepped osanike esindusõiguste kohta või ühingu juhatuse liikmete ja likvideerijate volitused ühingu esindamisel; kontaktisiku nimi või ärinimi, isiku- või registrikood ning ettevõtjale suunatud tahteavalduste ja ettevõtja menetlusdokumentide kättetoimetamise Eesti aadress, samuti kontaktisiku elektronposti aadress; ettevõtja usaldusosanike andmed ning nende sissemaksete suurused; ühingu osa- või aktsiakapitali rahaline suurus; märge osaühingu sissemakseta asutamise kohta; märge osade registreerimise kohta Eesti väärtpaberite registris või märge aktsiaraamatu pidaja kohta; märge osa võõrandamise ja pantimise käsutustehingu vorminõudest loobumise kohta; majandusaasta algus ja lõpp; pankrotiandmed ja andmed tagatisvara halduri määramise kohta vastavalt käesoleva seadustiku §-le 58; märge ühingu ühinemise, jagunemise ja ümberkujundamise ning lõpetamise ja kustutamise kohta; viide kannetele, mille registripidaja on teinud seadusest tulenevalt ettevõtja avalduseta; likvideeritud ühingu dokumentide hoidja andmed; kande kuupäev; viited hilisematele kannetele ja muud märkused.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_64 (redaktsioon 110072020035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020035",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_64_v123122022033"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_64_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
