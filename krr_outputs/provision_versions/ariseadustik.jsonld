    },
    {
      "@id": "estleg:ariseadustik_Par_1_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja on füüsiline isik, kes pakub oma nimel tasu eest kaupu või teenuseid ning kaupade ja teenuste müük on talle püsivaks tegevuseks, ning seaduses sätestatud äriühing.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_1 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
