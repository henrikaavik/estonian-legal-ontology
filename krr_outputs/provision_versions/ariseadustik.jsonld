    {
      "@id": "estleg:ariseadustik_Par_511_1_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_511_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui käesoleva seaduse paragrahv 62 lõigetes 3-5 sätestatud isiku elu- või asukoha või aadressiandmeid muudetakse, teeb registripidaja muutmise kanded iga ettevõtja kohta eraldi koos ettevõtja teiste registriandmete muutmisega. Muutmise kande aluseks on muutmise otsustaja kinnitatud või seaduses ettenähtud korras avaldatud andmed.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_511_1 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_511_1_v624304"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_511_1_v624304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_511_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui käesoleva seaduse § 62 lõigetes 3-5 sätestatud isiku elu- või asukoha või aadressiandmeid muudetakse, teeb registripidaja muutmise kanded iga ettevõtja kohta eraldi koos ettevõtja teiste registriandmete muutmisega. Muutmise kande aluseks on muutmise otsustaja kinnitatud või seaduses ettenähtud korras avaldatud andmed.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_511_1 (redaktsioon 624304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "624304",
      "estleg:supersededByVersion": {
