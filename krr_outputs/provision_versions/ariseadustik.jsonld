    },
    {
      "@id": "estleg:ariseadustik_Par_65_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrikartoteegi B-osa registrikaardile kantakse: ühingu ärinimi ja registrikood; ühingu asukoht ja aadress; ühingu tegevusala; ühingu osa- või aktsiakapitali rahaline suurus; juhatuse liikmete ning likvideerijate andmed; prokuristi andmed; ühingu liik; ühingu põhikirja kinnitamise aeg; juhatuse liikmete ja likvideerijate volitused ühingu esindamisel; põhikirja muudatuse tegemise aeg ja mille kohta muudatus käib; majandusaasta algus ja lõpp; märge ühingu osade või aktsiate registreerimise kohta Eesti väärtpaberite keskregistris; pankrotiandmed vastavalt käesoleva seadustiku §-le 58; ühingu ühinemine, jagunemine ja ümberkujundamine ning lõpetamine ja kustutamine; viide kannetele, mille registripidaja on teinud seadusest tulenevalt ettevõtja avalduseta; likvideeritud ühingu dokumentide hoidja andmed; kande kuupäev ning kandeotsuse täitnud isiku ja kande otsustamiseks pädeva isiku allkiri ja amet; viited hilisematele kannetele ja muud märkused.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_65 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
