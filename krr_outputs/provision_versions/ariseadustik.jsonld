        "@id": "estleg:ariseadustik_Par_487_v12767277"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_487_v12767277",
      "@type": [
        "owl:NamedIndividual",
