      "estleg:versionText": "Aktsiakapitali vähendamise otsuses märgitakse: aktsiakapitali vähendamise põhjus; aktsiakapitali vähendamise ulatus ja viis; tühistatavate aktsiate arv ja liik või aktsiate nimiväärtuse vähendamise ulatus; aktsiate tagastamise või ümbervahetamise aeg.",
      "rdfs:label": {
