        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_150_v13231531",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
