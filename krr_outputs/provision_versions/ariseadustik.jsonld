      }
    },
    {
      "@id": "estleg:ariseadustik_Par_44_v958165",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-18",
