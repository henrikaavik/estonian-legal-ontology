      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja on füüsiline isik, kes pakub oma nimel tasu eest kaupu või teenuseid ning kaupade müük või teenuste osutamine on talle püsivaks tegevuseks, ning seaduses sätestatud äriühing.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_1 (redaktsioon 180018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "180018",
