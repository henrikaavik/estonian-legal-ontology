      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ärinimi ehk firma on äriregistrisse kantud nimi, mille all ettevõtja tegutseb.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_7 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318"
    },
    {
      "@id": "estleg:ariseadustik_Par_70_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
