      },
      "estleg:versionValidFrom": {
        "@value": "2008-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Äriregistrisse kantakse: filiaali ja äriühingu ärinimed; filiaali ja äriühingu asukohad ja aadressid; Kehtetu – register, kus äriühing on registrisse kantud ning registrinumber, kui äriühingu asukohamaa seadusega on ette nähtud registrisse kandmine; äriühingu õiguslik vorm; millise maa seaduse alusel äriühing asukohamaal tegutseb; äriühingu osa- või aktsiakapitali suurus, kui see kantakse äriühingu asukohamaa registrisse; äriühingu põhikirja vastuvõtmise aeg ja põhikirja muudatuste tegemine, kui see kantakse äriühingu asukohamaa registrisse; [välja jäetud – – jõust. 8.06.1996] filiaali juhatajate nimed ja isikukoodid; kes juhatajatest võib esindada filiaali erinevalt käesoleva seadustiku § 385 3. lõikes sätestatust; välismaa äriühingu seadusjärgsete esindajate nimed ja isikukoodid ning esindusõiguse tekkimise ja lõppemise aeg; äriühingu majandusaasta algus ja lõpp ning kas ühing peab majandusaasta aruande avaldama; muud seaduses sätestatud andmed.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_387 (redaktsioon 12952012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12952012",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_387_v131122010019"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
