        "@type": "xsd:date"
      },
      "estleg:versionText": "Usaldusosanikule kohaldatakse käesoleva seadustiku paragrahvides 95 ja 96 sätestatut ainult siis, kui talle on ühingulepinguga antud õigus usaldusühingut juhtida.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_129 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
