        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) korraldab äriregistri rakendamisest tulenevalt ümber ettevõtteregistri töö. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_522 (redaktsioon 121032014022)",
