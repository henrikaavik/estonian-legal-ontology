    },
    {
      "@id": "estleg:ariseadustik_Par_47_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui registrikaardil ei ole enam kehtivaid kandeid, kriipsutatakse see kaart diagonaalse punase joonega läbi.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_47 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
