        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Usaldusosanikele kuuluvad käesoleva seadustiku paragrahvis 94 nimetatud õigused.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_130 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
