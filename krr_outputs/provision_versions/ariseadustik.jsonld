      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui juhatus esitas äriregistrile ebaõiged andmed, vastutavad avaldusele alla kirjutanud juhatuse liikmed sellega tekitatud kahju eest solidaarselt.",
      "rdfs:label": {
