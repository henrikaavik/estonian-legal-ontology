        "@language": "et"
      },
      "estleg:versionRedactionId": "121032014020",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_22_v112072014162"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_22_v112072014162",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriregistrit peab Tartu Maakohtu registriosakond (edaspidi registripidaja) Eestis asuvate füüsilisest isikust ettevõtjate ettevõtete ja äriühingute kohta. (2) Kehtetu - (3) Kehtetu - (4) Registripidajale esitatud dokumentide menetlemine ja määruste tegemine toimub tsiviilkohtumenetluse seadustikus registrimenetlusele sätestatud korras, kui käesolevast seadustikust ei tulene teisiti. (5) Kehtetu - (6) Äriregistrile ja selle pidamisele kohaldatakse avaliku teabe seaduses andmekogude kohta sätestatut käesolevas seaduses sätestatud erisustega.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_22 (redaktsioon 112072014162)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014162",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_22_v120122018002"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_22_v120122018002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriregister on riigi infosüsteemi kuuluv andmekogu, mille pidamise eesmärk on koguda, säilitada ja avalikustada teavet Eestis asuvate füüsilisest isikust ettevõtjate ettevõtete, äriühingute ja välismaa äriühingu filiaalide kohta. Äriregistrit peab Tartu Maakohtu registriosakond (edaspidi registripidaja). (2) Kehtetu - (3) Kehtetu - (4) Registripidajale esitatud dokumentide menetlemine ja määruste tegemine toimub tsiviilkohtumenetluse seadustikus registrimenetlusele sätestatud korras, kui käesolevast seadustikust ei tulene teisiti. (5) Kehtetu - (6) Äriregistrile ja selle pidamisele kohaldatakse avaliku teabe seaduses andmekogude kohta sätestatut käesolevas seaduses sätestatud erisustega.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_22 (redaktsioon 120122018002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122018002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_22_v123122022033"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_22_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_22 (redaktsioon 123122022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022033"
    },
    {
      "@id": "estleg:ariseadustik_Par_220_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_220"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Likvideerijad vastutavad tekitatud kahju eest samamoodi nagu juhatuse liikmed.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_220 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318"
    },
    {
      "@id": "estleg:ariseadustik_Par_221_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_221"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsiaselts on äriühing, millel on aktsiateks jaotatud aktsiakapital. (2) Aktsionär ei vastuta isiklikult aktsiaseltsi kohustuste eest. (3) Aktsiaselts vastutab oma kohustuste täitmise eest oma varaga.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_221 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318"
    },
    {
      "@id": "estleg:ariseadustik_Par_222_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_222"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiakapital peab olema vähemalt 400 000 krooni.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_222 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_222_v13334866"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_222_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_222"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiakapitali väljendatakse eurodes. Aktsiakapital peab olema vähemalt 25 000 eurot.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_222 (redaktsioon 13334866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334866"
    },
    {
      "@id": "estleg:ariseadustik_Par_222_1_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_222_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsia võib välja lasta nimiväärtusega aktsiana või nimiväärtuseta aktsiana. Nimiväärtusega ja nimiväärtuseta aktsiate samaaegne väljalaskmine ja kasutamine ei ole lubatud. Eelmises lauses sätestatud nõudega vastuolus välja lastud aktsiad on tühised. Käesoleva seadustiku § 223 3. lõike teist lauset kohaldatakse vastavalt. (2) Kõikidele nimiväärtuseta aktsiatele vastab võrdne osa aktsiakapitalist. Ühele nimiväärtuseta aktsiale osaks langev aktsiakapitali osa (aktsia arvestuslik väärtus) määratakse aktsiakapitali jagamisel aktsiate arvuga. (3) Aktsiaselts, kes on välja lasknud erineva nimiväärtusega aktsiad, võib võtta nimiväärtuseta aktsiad kasutusele juhul, kui enne nimiväärtuseta aktsia kasutuselevõtmist otsustatakse aktsiate nimiväärtuste võrdsustamine.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_222_1 (redaktsioon 13334866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334866",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_222_1_v102112011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-11",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_222_1_v102112011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_222_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsia võib välja lasta nimiväärtusega aktsiana või nimiväärtuseta aktsiana. Nimiväärtusega ja nimiväärtuseta aktsiate samaaegne väljalaskmine ja kasutamine ei ole lubatud. Eelmises lauses sätestatud nõudega vastuolus välja lastud aktsiad on tühised. Käesoleva seadustiku § 223 3. lõike teist lauset kohaldatakse vastavalt. (2) Kõikidele nimiväärtuseta aktsiatele vastab võrdne osa aktsiakapitalist. Ühele nimiväärtuseta aktsiale osaks langev aktsiakapitali osa (aktsia arvestuslik väärtus) määratakse aktsiakapitali jagamisel aktsiate arvuga. (3) Aktsiaselts, kes on välja lasknud erineva nimiväärtusega aktsiad, võib võtta nimiväärtuseta aktsiad kasutusele juhul, kui enne nimiväärtuseta aktsia kasutuselevõtmist otsustatakse aktsiate nimiväärtuste võrdsustamine. (4) Nimiväärtuseta aktsiate arv loetakse jõustunuks kande tegemisega äriregistrisse.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_222_1 (redaktsioon 102112011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102112011002"
    },
    {
      "@id": "estleg:ariseadustik_Par_223_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_223"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsia väikseim nimiväärtus on 10 krooni. (2) Kui aktsia nimiväärtus on suurem kui 10 krooni, peab see olema 10 krooni täiskordne. (3) Väiksema kui 10-kroonise nimiväärtusega aktsia on tühine. Sellise aktsia väljalaskmisest tekkinud kahju eest vastutavad selle väljalaskjad solidaarselt.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_223 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_223_v13334866"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_223_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_223"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsia väikseim nimiväärtus või arvestuslik väärtus on 10 senti. (2) Kui aktsia nimiväärtus on suurem kui 10 senti, peab see olema 10 sendi täiskordne. (3) Väiksema kui 10-sendise nimiväärtuse või arvestusliku väärtusega aktsia on tühine. Sellise aktsia väljalaskmisest tekkinud kahju eest vastutavad selle väljalaskjad solidaarselt.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_223 (redaktsioon 13334866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334866"
    },
    {
      "@id": "estleg:ariseadustik_Par_224_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_224"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsia on jagamatu.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_224 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318"
    },
    {
      "@id": "estleg:ariseadustik_Par_225_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsia väljalaskehind ei või olla väiksem aktsia nimiväärtusest. (2) Aktsia väljalaskehind võib olla suurem selle nimiväärtusest (ülekurss). Ülekurssi võib kasutada aktsiaseltsi kahjumi katmiseks, kui seda ei ole võimalik katta eelmiste perioodide jaotamata kasumi ja põhikirjas ettenähtud reservkapitali arvelt, ja aktsiakapitali suurendamiseks fondiemissiooni teel. (3) Aktsia väljalaskmisel peab märkija tasuma selle väljalaskehinna täielikult.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_225 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_225_v962325"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_225_v962325",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsia väljalaskehind ei või olla väiksem aktsia nimiväärtusest. (2) Aktsia väljalaskehind võib olla suurem selle nimiväärtusest (ülekurss). Ülekurssi korrigeeritakse rakendatava raamatupidamistavaga ettenähtud juhtudel. Ülekurssi võib kasutada: aktsiaseltsi kahjumi katmiseks, kui seda ei ole võimalik katta eelmiste perioodide jaotamata kasumi ja põhikirjas ettenähtud reservkapitali arvel; aktsiakapitali suurendamiseks fondiemissiooni teel. (3) Aktsia väljalaskmisel peab märkija tasuma selle väljalaskehinna täielikult.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_225 (redaktsioon 962325)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "962325",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_225_v13334866"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_225_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsia väljalaskehind ei või olla väiksem aktsia nimiväärtusest või arvestuslikust väärtusest. (2) Aktsia väljalaskehind võib olla suurem aktsia nimiväärtusest või arvestuslikust väärtusest (ülekurss). Ülekurssi korrigeeritakse rakendatava raamatupidamistavaga ettenähtud juhtudel. Ülekurssi võib kasutada: aktsiaseltsi kahjumi katmiseks, kui seda ei ole võimalik katta eelmiste perioodide jaotamata kasumi ja põhikirjas ettenähtud reservkapitali arvel; aktsiakapitali suurendamiseks fondiemissiooni teel. (3) Aktsia väljalaskmisel peab märkija tasuma selle väljalaskehinna täielikult.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_225 (redaktsioon 13334866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334866"
    },
    {
      "@id": "estleg:ariseadustik_Par_226_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_226"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsia annab aktsionärile õiguse osaleda aktsionäride üldkoosolekul ning kasumi ja aktsiaseltsi lõpetamisel allesjäänud vara jaotamisel, samuti muud seaduses sätestatud ja põhikirjaga ettenähtud õigused.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_226 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318"
    },
    {
      "@id": "estleg:ariseadustik_Par_226_1_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_226_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsia märkimisega saab märkija õiguse saada aktsia ja võtab endale kohustuse selle eest tasuda. (2) Aktsia märkijale võib märgitud aktsiate kohta anda märkimistõendi. (3) Märkija võib märkimisest tulenevad õigused ja kohustused üle anda. Kui aktsia eest ei ole täielikult tasutud, vastutab märkija tasumise eest omandajaga solidaarselt. Märkimistõendi üleandmisele kohaldatakse nimelise aktsia võõrandamise sätteid.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_226_1 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797"
    },
    {
      "@id": "estleg:ariseadustik_Par_227_v22318",
      "@type": [
        "owl:NamedIndividual",
