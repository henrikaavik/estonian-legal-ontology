        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_70_v131122010019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arvutiregistri kasutamise tasu määrad",
      "rdfs:label": {
        "@value": "ariseadustik_Par_70 (redaktsioon 131122010019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010019",
