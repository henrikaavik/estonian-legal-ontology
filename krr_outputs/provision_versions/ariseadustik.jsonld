    },
    {
      "@id": "estleg:ariseadustik_Par_523_1_v12985040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_523_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadustiku § 97 1 1 . lõike teises lauses, § 179 4. lõike neljandas lauses ja § 334 2. lõike neljandas lauses sätestatut kohaldatakse majandusaasta aruandele, mis on koostatud aruandeperioodi kohta, mis algab 2009. aasta 1. jaanuaril või hiljem.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_523_1 (redaktsioon 12985040)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12985040",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_523_1_v13188675"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_523_1_v13188675",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_523_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadustiku § 97 1 1 . lõikes, § 179 4 1. lõikes ja § 334 2. lõikes sätestatud majandusaasta aruande elektroonilise esitamise kohustust kohaldatakse majandusaasta aruande suhtes, mis on koostatud aruandeperioodi kohta, mis algab 2009. aasta 1. jaanuaril või hiljem.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_523_1 (redaktsioon 13188675)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13188675",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_523_1_v13259183"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_523_1_v13259183",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_523_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadustiku § 32 lõikes 3 sätestatut kohaldatakse majandusaasta aruannetele, mis koostatakse 2009. aasta 1. jaanuaril või hiljem algava aruandeperioodi kohta.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_523_1 (redaktsioon 13259183)",
