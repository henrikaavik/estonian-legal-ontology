    },
    {
      "@id": "estleg:ariseadustik_Par_426_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_426"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühendavas aktsiaseltsis säilivad ühendatava aktsiaseltsi eelisaktsiate ja vahetusvõlakirjade omanike õigused, mis neil olid ühendatavas aktsiaseltsis. (2) Kui ühendavaks ühinguks ei ole aktsiaselts, omandavad eelisaktsiate ja vahetusvõlakirjade omanikud ühendava ühingu osad samadel alustel ühendatava aktsiaseltsi aktsionäridega. Ühinemislepinguga mittenõustumisel võivad nad nõuda hüvitust vastavalt käesoleva seadustiku paragrahvile 404.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_426 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
