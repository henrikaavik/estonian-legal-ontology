        "@value": "ariseadustik_Par_200 (redaktsioon 126062017049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062017049"
    },
    {
      "@id": "estleg:ariseadustik_Par_200_1_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_200_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osakapitali vähendamisel võib teha väljamakseid osanikele, kui see on ette nähtud osakapitali vähendamise otsuses. (2) Käesoleva paragrahvi 1. lõikes nimetatud väljamakseid võib teha mitte varem kui kolme kuu möödumisel osakapitali vähendamise äriregistrisse kandmisest ning tingimusel, et võlausaldajate tähtaegselt esitatud nõuded on tagatud või rahuldatud.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_200_1 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797"
    },
