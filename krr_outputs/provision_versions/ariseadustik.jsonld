        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_254 (redaktsioon 131122010019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010019"
    },
    {
      "@id": "estleg:ariseadustik_Par_255_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_255"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kahe aasta jooksul aktsiaseltsi äriregistrisse kandmisest võib aktsiaselts aktsionärilt või temaga samaväärset majanduslikku huvi omavalt isikult lepingu alusel omandada vara, mille väärtus ületab 1/10 aktsiakapitalist, ainult üldkoosoleku otsusel. (2) Vara tuleb hinnata käesoleva seadustiku paragrahvis 249 sätestatud korras.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_255 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_255_v624304"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_255_v624304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_255"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kahe aasta jooksul aktsiaseltsi äriregistrisse kandmisest võib aktsiaselts aktsionärilt või temaga samaväärset majanduslikku huvi omavalt isikult lepingu alusel omandada vara, mille väärtus ületab 1/10 aktsiakapitalist, ainult üldkoosoleku otsusel. (2) Vara tuleb hinnata käesoleva seadustiku §-s 249 sätestatud korras.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_255 (redaktsioon 624304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "624304",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_255_v973797"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_255_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_255"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kahe aasta jooksul aktsiaseltsi äriregistrisse kandmisest võib aktsiaselts aktsionärilt või temaga samaväärset majanduslikku huvi omavalt isikult lepingu alusel omandada vara, mille väärtus ületab 1/10 aktsiakapitalist, ainult üldkoosoleku otsusel. See ei kehti vara omandamisel börsil või igapäevase majandustegevuse raames. (2) Vara tuleb hinnata käesoleva seadustiku §-s 249 sätestatud korras.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_255 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_255_v12952012"
      },
      "estleg:versionValidTo": {
        "@value": "2008-04-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_255_v12952012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_255"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kahe aasta jooksul aktsiaseltsi äriregistrisse kandmisest võib aktsiaselts aktsionärilt või temaga samaväärset majanduslikku huvi omavalt isikult lepingu alusel omandada vara, mille väärtus ületab 1/10 aktsiakapitalist, ainult üldkoosoleku otsusel. See ei kehti vara omandamisel börsil või igapäevase majandustegevuse raames. (2) Vara tuleb hinnata käesoleva seadustiku §-s 249 sätestatud korras. (3) Juhatus peab viivitamata pärast käesoleva paragrahvi 1. lõikes nimetatud vara hindamise kontrollimist audiitori poolt esitama äriregistrile vara aktsiaseltsile üleandmise lepingu ja vara väärtust tõendavad dokumendid ning audiitori poolt allakirjutatud arvamuse vara hindamise kohta.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_255 (redaktsioon 12952012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12952012"
    },
    {
      "@id": "estleg:ariseadustik_Par_256_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_256"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiaseltsi asutamisele aktsiate märkimisega kohaldatakse käesoleva seadustiku paragrahvides 242 - 255 sätestatut, kui järgnevatest sätetest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_256 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_256_v624304"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_256_v624304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_256"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiaseltsi asutamisele aktsiate märkimisega kohaldatakse käesoleva seadustiku §-des 242 - 255 sätestatut, kui järgnevatest sätetest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_256 (redaktsioon 624304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "624304"
    },
    {
      "@id": "estleg:ariseadustik_Par_26_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registriosakonnal on pitsat. Pitsati jäljend (pitser) koos registrikannetele allakirjutamiseks pädevate isikute allkirja näidistega saadetakse teistele registriosakondadele.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_26 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_26_v973797"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_26_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtu registriosakonnal on riigivapiga pitsat. (2) Kohtuteenistujal, kes teeb registriosakonnas tõestamistoiminguid, võib olla oma nimega riigivapiga pitsat.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_26 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_26_v123122022033"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_26_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_26 (redaktsioon 123122022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022033"
    },
    {
      "@id": "estleg:ariseadustik_Par_27_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriregistrit peetakse eesti keeles. (2) Võõrkeelsed dokumendid esitatakse registripidajale koos notariaalselt kinnitatud tõlkega.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_27 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_27_v973797"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_27_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriregistrit peetakse eesti keeles. (2) Võõrkeelsed dokumendid esitatakse registripidajale koos notariaalselt kinnitatud tõlkega. (3) Ettevõtja ei või tugineda tõlkele, kui see erineb originaaldokumendist. Kolmas isik võib registripidajale esitatud dokumendi tõlkele tugineda, välja arvatud juhul, kui ettevõtja tõendab, et kolmas isik teadis tõlke ebaõigsusest.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_27 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_27_v118122012007"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_27_v118122012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriregistrit peetakse eesti keeles. (2) Võõrkeelsed dokumendid esitatakse registripidajale vandetõlgi või notari poolt kinnitatud eestikeelse tõlkega või eestikeelse tõlkega, millel notar on kinnitanud tõlkija allkirja. (3) Ettevõtja ei või tugineda tõlkele, kui see erineb originaaldokumendist. Kolmas isik võib registripidajale esitatud dokumendi tõlkele tugineda, välja arvatud juhul, kui ettevõtja tõendab, et kolmas isik teadis tõlke ebaõigsusest.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_27 (redaktsioon 118122012007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012007",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_27_v119032015046"
      },
      "estleg:versionValidTo": {
        "@value": "2015-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_27_v119032015046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriregistrit peetakse eesti keeles. (2) Võõrkeelsed dokumendid esitatakse registripidajale vandetõlgi või notari poolt kinnitatud eestikeelse tõlkega või eestikeelse tõlkega, millel notar on kinnitanud tõlkija allkirja. (3) Ettevõtja ei või tugineda tõlkele, kui see erineb originaaldokumendist. Kolmas isik võib registripidajale esitatud dokumendi tõlkele tugineda, välja arvatud juhul, kui ettevõtja tõendab, et kolmas isik teadis tõlke ebaõigsusest. (4) Käesoleva paragrahvi 2. lõike nõuetele mittevastavate osaliselt või täielikult võõrkeelsete dokumentide esitamisel juhindub registripidaja üksnes talle esitatud eestikeelsetest dokumentidest või tekstiosadest. Ettevõtja ja kolmandad isikud ei saa võõrkeelsetele dokumentidele või tekstiosadele tugineda.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_27 (redaktsioon 119032015046)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015046",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_27_v128022019011"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_27_v128022019011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriregistrit peetakse eesti keeles. (2) Võõrkeelsed dokumendid esitatakse registripidajale vandetõlgi tehtud eestikeelse tõlkega. (3) Ettevõtja ei või tugineda tõlkele, kui see erineb originaaldokumendist. Kolmas isik võib registripidajale esitatud dokumendi tõlkele tugineda, välja arvatud juhul, kui ettevõtja tõendab, et kolmas isik teadis tõlke ebaõigsusest. (4) Käesoleva paragrahvi 2. lõike nõuetele mittevastavate osaliselt või täielikult võõrkeelsete dokumentide esitamisel juhindub registripidaja üksnes talle esitatud eestikeelsetest dokumentidest või tekstiosadest. Ettevõtja ja kolmandad isikud ei saa võõrkeelsetele dokumentidele või tekstiosadele tugineda.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_27 (redaktsioon 128022019011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128022019011",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_27_v122122020050"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_27_v122122020050",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriregistrit peetakse eesti keeles. (2) Võõrkeelsed dokumendid esitatakse registripidajale vandetõlgi tehtud eestikeelse tõlkega. Samuti võib dokumendid esitada registripidajale notari tehtud eestikeelse tõlkega, kui notar on koostanud notariaalakti või -märke võõrkeeles tõestamisseaduse § 5 lõike 2 alusel. (3) Ettevõtja ei või tugineda tõlkele, kui see erineb originaaldokumendist. Kolmas isik võib registripidajale esitatud dokumendi tõlkele tugineda, välja arvatud juhul, kui ettevõtja tõendab, et kolmas isik teadis tõlke ebaõigsusest. (4) Käesoleva paragrahvi 2. lõike nõuetele mittevastavate osaliselt või täielikult võõrkeelsete dokumentide esitamisel juhindub registripidaja üksnes talle esitatud eestikeelsetest dokumentidest või tekstiosadest. Ettevõtja ja kolmandad isikud ei saa võõrkeelsetele dokumentidele või tekstiosadele tugineda.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_27 (redaktsioon 122122020050)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122020050",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_27_v123122022033"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_27_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_27 (redaktsioon 123122022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022033"
    },
    {
      "@id": "estleg:ariseadustik_Par_271_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_271"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaks käesoleva seadustiku paragrahv 250 1. lõikes nimetatud dokumentidele tuleb aktsiaseltsi äriregistrisse kandmise avaldusele lisada asutamiskoosoleku protokoll. (2) Juhatus peab esitama avalduse aktsiaseltsi kandmiseks äriregistrisse kahe kuu jooksul põhikirja vastuvõtmisest.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_271 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_271_v624304"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_271_v624304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_271"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaks käesoleva seadustiku § 250 1. lõikes nimetatud dokumentidele tuleb aktsiaseltsi äriregistrisse kandmise avaldusele lisada asutamiskoosoleku protokoll. (2) Juhatus peab esitama avalduse aktsiaseltsi kandmiseks äriregistrisse kahe kuu jooksul põhikirja vastuvõtmisest.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_271 (redaktsioon 624304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "624304",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_271_v104012021046"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_271_v104012021046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_271"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_271 (redaktsioon 104012021046)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104012021046"
    },
    {
      "@id": "estleg:ariseadustik_Par_272_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_272"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsionäre tuleb võrdsetel asjaoludel kohelda võrdselt.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_272 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318"
    },
    {
      "@id": "estleg:ariseadustik_Par_273_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_273"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsionäri ei või kohustada tegema sissemakseid, mis ületavad aktsia nimiväärtust ja ülekurssi.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_273 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_273_v973797"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_273_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_273"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsionäri ei või ilma tema nõusolekuta kohustada tegema sissemakseid, mis ületavad aktsia nimiväärtust ja ülekurssi.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_273 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_273_v13334866"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_273_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_273"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsionäri ei või ilma tema nõusolekuta kohustada tegema sissemakseid, mis ületavad aktsia nimiväärtust või arvestuslikku väärtust ja ülekurssi.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_273 (redaktsioon 13334866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334866"
    },
    {
      "@id": "estleg:ariseadustik_Par_274_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_274"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsionärile ei või tagastada tema poolt tehtud sissemakset ega maksta sissemakselt intressi. (2) Sissemakse tagastamiseks ei loeta ostuhinna tasumist aktsiaseltsi poolt oma aktsiate tagasiostmisel.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_274 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318"
    },
    {
      "@id": "estleg:ariseadustik_Par_275_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_275"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põhikirjaga võib ette näha, et aktsionär, kes ei tasu oma aktsia eest õigeaegselt, on kohustatud maksma viivist põhikirjas ette nähtud määral. (2) Juhatus saadab maksega viivitavale aktsionärile teate nõudega tasuda makse kirjas näidatud tähtaja jooksul, märkides, et makse tasumata jätmisel kaotab aktsionär oma aktsia. Tasumise tähtaeg peab olema vähemalt viisteist päeva teate saatmisest. (3) Kui aktsionär ei tasu puudu olevat summat teates nimetatud tähtaja jooksul, kaotab ta oma aktsia. Aktsionäri poolt tasutud summa, mis ei ületa 1/5 aktsia nimiväärtusest, kantakse reservkapitali, ülejäänud summa tagastatakse aktsionärile.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_275 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_275_v973797"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_275_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_275"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsionär, kes ei tasu aktsia eest õigeaegselt, on kohustatud maksma aktsiaseltsile viivist seaduses sätestatud ulatuses, kui põhikirjaga ei ole ette nähtud teisiti. See ei välista ega piira viivist ületava kahju hüvitamise nõude esitamist. (2) Juhatus saadab maksega viivitavale aktsionärile teate nõudega tasuda makse kirjas näidatud tähtaja jooksul, märkides, et makse tasumata jätmisel kaotab aktsionär oma aktsia. Tasumise tähtaeg peab olema vähemalt viisteist päeva teate saatmisest. (3) Kui aktsionär ei tasu puudu olevat summat teates nimetatud tähtaja jooksul, kaotab ta oma aktsia ja aktsiaseltsil on õigus võõrandada see teistele aktsionäridele või kolmandatele isikutele. Aktsionäri poolt tasutud summa, mis ei ületa 1/5 aktsia nimiväärtusest, kantakse reservkapitali, ülejäänud summa tagastatakse aktsionärile.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_275 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_275_v13334866"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_275_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_275"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsionär, kes ei tasu aktsia eest õigeaegselt, on kohustatud maksma aktsiaseltsile viivist seaduses sätestatud ulatuses, kui põhikirjaga ei ole ette nähtud teisiti. See ei välista ega piira viivist ületava kahju hüvitamise nõude esitamist. (2) Juhatus saadab maksega viivitavale aktsionärile teate nõudega tasuda makse kirjas näidatud tähtaja jooksul, märkides, et makse tasumata jätmisel kaotab aktsionär oma aktsia. Tasumise tähtaeg peab olema vähemalt viisteist päeva teate saatmisest. (3) Kui aktsionär ei tasu puudu olevat summat teates nimetatud tähtaja jooksul, kaotab ta oma aktsia ja aktsiaseltsil on õigus võõrandada see teistele aktsionäridele või kolmandatele isikutele. Aktsionäri poolt tasutud summa, mis ei ületa 1/5 aktsia nimiväärtusest või arvestuslikust väärtusest, kantakse reservkapitali, ülejäänud summa tagastatakse aktsionärile.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_275 (redaktsioon 13334866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334866"
    },
    {
      "@id": "estleg:ariseadustik_Par_276_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_276"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsiaselts võib teha aktsionäridele väljamakseid ainult puhaskasumist või eelmiste majandusaastate jaotamata kasumist, millest on maha arvatud eelmiste aastate katmata kahjum, vastavalt seadusele. (2) Aktsionärile makstakse osa kasumist (dividend) vastavalt tema aktsiate nimiväärtusele. Põhikirjaga võib ette näha, et eri liiki aktsiatest tulenevad erinevad õigused kasumi jaotamisel.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_276 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_276_v13334866"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_276_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_276"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsiaselts võib teha aktsionäridele väljamakseid ainult puhaskasumist või eelmiste majandusaastate jaotamata kasumist, millest on maha arvatud eelmiste aastate katmata kahjum, vastavalt seadusele. (2) Aktsionärile makstakse osa kasumist (dividend) vastavalt tema aktsiate nimiväärtusele või arvestuslikule väärtusele. Põhikirjaga võib ette näha, et eri liiki aktsiatest tulenevad erinevad õigused kasumi jaotamisel.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_276 (redaktsioon 13334866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334866"
    },
    {
      "@id": "estleg:ariseadustik_Par_277_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_277"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Dividendi võib maksta üks kord aastas kinnitatud majandusaasta aruande alusel. (2) Dividendi maksmise kord nähakse ette põhikirjas või üldkoosoleku otsusega.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_277 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_277_v973797"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_277_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_277"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Dividendi võib maksta kinnitatud majandusaasta aruande alusel. (2) Dividendi maksmise kord nähakse ette põhikirjas või üldkoosoleku otsusega. (3) Põhikirjaga võib aktsiaseltsi juhatusele anda õiguse teha nõukogu nõusolekul pärast majandusaasta möödumist ja enne majandusaasta aruande kinnitamist aktsionäridele ettemakseid eeldatava kasumi arvel kuni poole ulatuses summast, mida võib aktsionäride vahel jaotada.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_277 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797"
    },
    {
      "@id": "estleg:ariseadustik_Par_278_v22318",
      "@type": [
