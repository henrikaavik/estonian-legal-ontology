    },
    {
      "@id": "estleg:ariseadustik_Par_340_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_340"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui aktsiakapitali suurendamise otsustab erakorraline üldkoosolek, esitab juhatus üldkoosolekule üldkoosoleku kinnitatud eelmise majandusaasta aruande ja ülevaate aktsiaseltsi käesoleva aasta majandustegevusest.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_340 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_340_v13231531"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_340_v13231531",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_340"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui aktsiakapitali suurendamise otsustab erakorraline üldkoosolek, esitab juhatus üldkoosolekule üldkoosoleku kinnitatud eelmise majandusaasta aruande ja ülevaate aktsiaseltsi käesoleva aasta majandustegevusest. Eelmises lauses nimetatud dokumentide kättesaadavaks tegemisele kohaldatakse vastavalt käesoleva seaduse § 294 4. lõike punkti 8 ja 4 2 . lõiget.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_340 (redaktsioon 13231531)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231531",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_340_v13334866"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_340_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_340"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui aktsiakapitali suurendamise otsustab erakorraline üldkoosolek, esitab juhatus üldkoosolekule üldkoosoleku kinnitatud eelmise majandusaasta aruande ja ülevaate aktsiaseltsi käesoleva aasta majandustegevusest. Eelmises lauses nimetatud dokumentide kättesaadavaks tegemisele kohaldatakse vastavalt käesoleva seaduse § 294 4. lõike punkti 8 ja 42. lõiget.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_340 (redaktsioon 13334866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334866",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_340_v123122022033"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_340_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_340"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui aktsiakapitali suurendamise otsustab erakorraline üldkoosolek, esitab juhatus üldkoosolekule üldkoosoleku kinnitatud eelmise majandusaasta aruande ja ülevaate aktsiaseltsi käesoleva aasta majandustegevusest. Eelmises lauses nimetatud dokumentide kättesaadavaks tegemisele kohaldatakse vastavalt käesoleva seadustiku § 294 4. lõike punkti 8 ja 42. lõiget.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_340 (redaktsioon 123122022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022033"
    },
    {
      "@id": "estleg:ariseadustik_Par_341_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_341"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsiakapitali suurendamise otsus on vastu võetud, kui selle poolt on antud vähemalt 2/3 üldkoosolekul esindatud häältest. Põhikirjaga võib ette näha suurema häälteenamuse nõude. (2) Kui aktsiaseltsil on mitut liiki aktsiaid, on aktsiakapitali suurendamise otsus vastu võetud, kui selle poolt on lisaks käesoleva paragrahvi 1. lõikes sätestatule antud vähemalt 2/3 igat liiki aktsiatega üldkoosolekul esindatud häältest. Põhikirjas võib ette näha suurema häälteenamuse nõude. (3) Kui aktsiakapitali suurendamise tõttu tuleb muuta põhikirja, tuleb põhikirja muutmine otsustada enne aktsiakapitali suurendamist. (4) Aktsiakapitali suurendamise otsust ei või vastu võtta enne aktsiaseltsi äriregistrisse kandmist.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_341 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318"
    },
    {
      "@id": "estleg:ariseadustik_Par_342_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_342"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiakapitali suurendamise otsuses märgitakse: uute aktsiate arv ja nimiväärtus, samuti aktsiakapitali suurendamise ulatus; väljalastavate aktsiate liik, kui aktsiaseltsil on või lastakse välja mitut liiki aktsiaid; uute aktsiate märkimise eesõigus ja selle kasutamise tähtaeg, samuti aeg, mille seisuga aktsionäridele kuulub märkimise eesõigus; aktsiate märkimise aeg; aktsiate eest tasumise aeg ja koht, samuti kas ja millises ulatuses tasutakse aktsiate eest rahalise või mitterahalise sissemaksega, mitterahalise sissemakse korral ka selle ese; kui suurendatakse aktsiate nimiväärtust - olemasolevate aktsiate uus nimiväärtus; kui aktsiaid lastakse välja ülekursiga - ülekursi suurus, mis võib olla määratud kas kindla summana või ülekursi alampiirina, millest kõrgema ülekursi võib nõukogu määrata kuni märkimise alguseni; aktsiatähtede ümbervahetamise aeg, kui aktsiatähed on välja antud. fondiemissiooni korral lisaks viide fondiemissiooni aluseks olevale bilansile ja omakapitali kirjetele, mille arvel ja millises ulatuses fondiemissioon läbi viiakse; samuti aeg, mille seisuga fondiemissioon läbi viiakse.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_342 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_342_v958165"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_342_v958165",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_342"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiakapitali suurendamise otsuses märgitakse: uute aktsiate arv ja nimiväärtus, samuti aktsiakapitali suurendamise ulatus; väljalastavate aktsiate liik, kui aktsiaseltsil on või lastakse välja mitut liiki aktsiaid; uute aktsiate märkimise eesõigus ja selle kasutamise tähtaeg, samuti aeg, mille seisuga aktsionäridele kuulub märkimise eesõigus; aktsiate märkimise aeg; aktsiate eest tasumise aeg ja koht, samuti kas ja millises ulatuses tasutakse aktsiate eest rahalise või mitterahalise sissemaksega, mitterahalise sissemakse korral ka selle ese; kui suurendatakse aktsiate nimiväärtust - olemasolevate aktsiate uus nimiväärtus; kui aktsiaid lastakse välja ülekursiga - ülekursi suurus, mis võib olla määratud kas kindla summana või ülekursi alampiirina, millest kõrgema ülekursi võib nõukogu määrata kuni märkimise alguseni; aktsiatähtede ümbervahetamise aeg, kui aktsiatähed on välja antud; fondiemissiooni korral lisaks viide fondiemissiooni aluseks olevale bilansile ja omakapitali kirjetele, mille arvel ja millises ulatuses fondiemissioon läbi viiakse; samuti aeg, mille seisuga fondiemissioon läbi viiakse.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_342 (redaktsioon 958165)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "958165",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_342_v973797"
      },
      "estleg:versionValidTo": {
