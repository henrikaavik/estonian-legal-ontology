    {
      "@id": "estleg:ariseadustik_Par_392_v830230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_392"
      },
