      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arvutiregistri kasutamise tasu määrad kehtestab justiitsminister.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_70 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
