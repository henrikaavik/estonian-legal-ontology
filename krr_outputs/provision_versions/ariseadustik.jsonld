      }
    },
    {
      "@id": "estleg:ariseadustik_Par_459_v624304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_459"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui jagunemisotsusega mittenõustunud osanik ei nõua käesoleva seadustiku § 448 1. lõikes nimetatud hüvitust, võib ta osa võõrandada kahe kuu jooksul, sõltumata käesoleva seadustiku § 149 1. - 3. lõikes sätestatud käsutuspiirangutest.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_459 (redaktsioon 624304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "624304",
      "estleg:supersededByVersion": {
