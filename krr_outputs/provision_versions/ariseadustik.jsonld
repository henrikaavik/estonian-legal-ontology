      },
      "estleg:versionText": "Registripidaja õigusvastase tegevuse tagajärjel tekkinud kahju hüvitab riik.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_72 (redaktsioon 22318)",
        "@language": "et"
      },
