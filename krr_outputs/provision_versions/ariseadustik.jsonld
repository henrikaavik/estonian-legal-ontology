    {
      "@id": "estleg:ariseadustik_Par_64_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrikartoteegi A-osa registrikaardile kantakse: ettevõtja ärinimi ja registrikood; ettevõtja elu- või asukoht ja aadress; ettevõtja tegevusala; füüsilisest isikust ettevõtja andmed; äriühingu täisosanike, likvideerijate ning § 98 lõikes 3 ja §-s 131 nimetatud esindusõiguslike isikute andmed; prokuristi andmed; ettevõtja õiguslik vorm; kokkulepped osanike esindusõiguste kohta; usaldusosanike andmed ning nende sissemaksete suurused; majandusaasta algus ja lõpp; ühingu lõpetamine ja kustutamine; pankrotiandmed vastavalt käesoleva seadustiku §-le 58; ühingu ühinemine, jagunemine ja ümberkujundamine; viide kannetele, mille registripidaja on teinud seadusest tulenevalt ettevõtja avalduseta; likvideeritud ühingu dokumentide hoidja andmed; kande kuupäev ning kandeotsuse täitnud isiku ja kande otsustamiseks pädeva isiku allkiri ja amet; viited hilisematele kannetele ja muud märkused.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_64 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_64_v973797"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_64_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrikartoteegi A-osa registrikaardile kantakse: ettevõtja ärinimi ja registrikood; ettevõtja elu- või asukoht ja aadress; ettevõtja tegevusala; füüsilisest isikust ettevõtja andmed; äriühingu täisosanike, likvideerijate ning § 98 lõikes 3 ja §-s 131 nimetatud esindusõiguslike isikute andmed; prokuristi andmed; ettevõtja õiguslik vorm; kokkulepped osanike esindusõiguste kohta; usaldusosanike andmed ning nende sissemaksete suurused; majandusaasta algus ja lõpp; ühingu lõpetamine ja kustutamine; pankrotiandmed vastavalt käesoleva seadustiku §-le 58; ühingu ühinemine, jagunemine ja ümberkujundamine; viide kannetele, mille registripidaja on teinud seadusest tulenevalt ettevõtja avalduseta; likvideeritud ühingu dokumentide hoidja andmed; kande kuupäev ning kandemääruse täitnud isiku ja kande otsustamiseks pädeva isiku allkiri ja amet; viited hilisematele kannetele ja muud märkused.",
      "rdfs:label": {
