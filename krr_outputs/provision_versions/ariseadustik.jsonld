        "@type": "xsd:date"
      },
      "estleg:versionText": "[Kehtetu]",
      "rdfs:label": {
        "@value": "ariseadustik_Par_425 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_425_v624350"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_425_v624350",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_425"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "§ 426. Eelisaktsiate ja vahetusvõlakirjade omanike kaitse (1) Ühendavas aktsiaseltsis säilivad ühendatava aktsiaseltsi eelisaktsiate ja vahetusvõlakirjade omanike õigused, mis neil olid ühendatavas aktsiaseltsis. (2) Kui ühendavaks ühinguks ei ole aktsiaselts, omandavad eelisaktsiate ja vahetusvõlakirjade omanikud ühendava ühingu osad samadel alustel ühendatava aktsiaseltsi aktsionäridega. Ühinemislepinguga mittenõustumisel võivad nad nõuda hüvitust vastavalt käesoleva seadustiku §-le 404.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_425 (redaktsioon 624350)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "624350",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_425_v687277"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
