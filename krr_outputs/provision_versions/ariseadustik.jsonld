      }
    },
    {
      "@id": "estleg:ariseadustik_Par_168_v119032015046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osanike pädevusse kuulub: põhikirja muutmine; osakapitali suurendamine ja vähendamine; nõukogu liikmete valimine ja tagasikutsumine; kui ühingul ei ole nõukogu – juhatuse liikmete valimine ja tagasikutsumine; majandusaasta aruande kinnitamine ja kasumi jaotamine; osa jagamine, kui põhikirjast ei tulene teisiti; audiitori valimine; erikontrolli määramine; kui ühingul ei ole nõukogu – prokuristi nimetamine ja tagasikutsumine; nõukogu liikmega või juhul, kui ühingul ei ole nõukogu, siis juhatuse liikmega tehingu tegemise otsustamine, tehingu tingimuste määramine, õigusvaidluse pidamise otsustamine ning selles tehingus või vaidluses osaühingu esindaja määramine; osaühingu lõpetamise, ühinemise, jagunemise ja ümberkujundamise otsustamine; muude seaduse või põhikirjaga osanike pädevusse antud küsimuste otsustamine. (2) Osanikud võivad võtta vastu otsuseid ka juhatuse ja nõukogu pädevusse kuuluvates küsimustes. Sellisel juhul vastutavad osanikud nagu juhatuse või nõukogu liikmed.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_168 (redaktsioon 119032015046)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015046"
    },
    {
      "@id": "estleg:ariseadustik_Par_169_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_169"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osaniku häälte arv peab olema võrdeline tema osa suurusega. (2) Osa iga 100 krooni annab ühe hääle, kui põhikirjaga ei ole ette nähtud teisiti.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_169 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_169_v13334866"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_169_v13334866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_169"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osaniku häälte arv peab olema võrdeline tema osa suurusega. (2) Osa iga üks euro annab ühe hääle, kui põhikirjaga ei ole ette nähtud teisiti.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_169 (redaktsioon 13334866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334866",
