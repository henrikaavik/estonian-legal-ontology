        "@id": "estleg:ariseadustik_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrooniliselt peetava äriregistri kanne on tehtud, kui see on salvestatud äriregistri kannetele määratud andmebaasi. (2) Kandel on käesoleva seadustiku § 34 2. ja 3. lõikes sätestatud õiguslik tähendus hetkest, mil üldkasutatavas arvutivõrgus on avaldatud viide kande tegemise kohta.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_68 (redaktsioon 118122012007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012007",
