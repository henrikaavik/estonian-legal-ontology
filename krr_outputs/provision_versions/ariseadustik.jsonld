        "@type": "xsd:date"
      },
      "estleg:versionText": "Usaldusosanikule kohaldatakse käesoleva seadustiku §-des 95 ja 96 sätestatut ainult siis, kui talle on ühingulepinguga antud õigus usaldusühingut juhtida.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_129 (redaktsioon 624304)",
        "@language": "et"
