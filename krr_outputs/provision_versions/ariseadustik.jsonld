        "@id": "estleg:ariseadustik_Par_459_v123122022033"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_459_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_459"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui jagunemisotsusega mittenõustunud osanik ei nõua käesoleva seadustiku § 448 1. lõikes nimetatud hüvitist, võib ta osa võõrandada kahe kuu jooksul, sõltumata käesoleva seadustiku § 149 1.–3. lõikes sätestatud käsutuspiirangutest.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_459 (redaktsioon 123122022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022033"
    },
    {
      "@id": "estleg:ariseadustik_Par_45_1_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_45_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui registrikaart on hävinud, kadunud või rikutud, avab registripidaja asenduskaardi. (2) Asenduskaardi avamine algatatakse registriosakonna juhataja või puudutatud ettevõtja avalduse alusel. Vähemalt üks kuu enne avalduse sisulist läbivaatamist avaldab kohus ametlikus väljaandes Ametlikud Teadaanded teate, milles näidatakse ära avalduse sisu. (3) Asenduskaardi avamise otsustab maa- või linnakohtu esimehe nimetatud kohtunik.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_45_1 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_45_1_v13113704"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_45_1_v13113704",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_45_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui registrikaart on hävinud, kadunud või rikutud, avab registripidaja asenduskaardi. (2) Asenduskaardi avamine algatatakse registriosakonna juhataja või puudutatud ettevõtja avalduse alusel. Vähemalt üks kuu enne avalduse sisulist läbivaatamist avaldab kohus ametlikus väljaandes Ametlikud Teadaanded teate, milles näidatakse ära avalduse sisu. (3) Asenduskaardi avamise otsustab maakohtu esimehe nimetatud kohtunik.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_45_1 (redaktsioon 13113704)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13113704",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_45_1_v118122012007"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_45_1_v118122012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_45_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_45_1 (redaktsioon 118122012007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012007"
    },
    {
      "@id": "estleg:ariseadustik_Par_46_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kanne on tehtud kohtuotsuse alusel, tehakse selle kohta kandesse märge. Kohtuotsuse muutmise või tühistamise märge tehakse samasse veergu.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_46 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_46_v958165"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_46_v958165",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kanne on tehtud kohtuotsuse alusel, tehakse selle kohta kandesse märge. Kohtuotsuse muutmise või tähistamise märge tehakse samasse veergu.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_46 (redaktsioon 958165)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "958165",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_46_v973797"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_46_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kanne on tehtud kohtulahendi alusel, tehakse selle kohta kandesse märge. Kohtulahendi muutmise või tühistamise märge tehakse samasse veergu.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_46 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_46_v118122012007"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_46_v118122012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kanne on tehtud kohtulahendi alusel, tehakse selle kohta kandesse märge. Kohtulahendi muutmise või tühistamise märge tehakse samasse märkesse.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_46 (redaktsioon 118122012007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012007",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_46_v123122022033"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_46_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_46 (redaktsioon 123122022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022033"
    },
    {
      "@id": "estleg:ariseadustik_Par_460_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_460"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui omandav ühing on osaühing, mille osakapitali seoses jagunemisega suurendatakse või kui jagunemisel asutatakse uus osaühing, tuleb osaühingu mitterahalise sissemakse hindamiseks ettenähtud korras (paragrahv 143) hinnata, kas jaguneva ühingu poolt üleantud varast piisab osakapitali suurendamiseks või asutatava osaühingu osakapitaliks. Vara hindamist tõendavad dokumendid esitatakse koos jagunemise avaldusega äriregistrile.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_460 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_460_v624304"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_460_v624304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_460"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui omandav ühing on osaühing, mille osakapitali seoses jagunemisega suurendatakse või kui jagunemisel asutatakse uus osaühing, tuleb osaühingu mitterahalise sissemakse hindamiseks ettenähtud korras (§ 143) hinnata, kas jaguneva ühingu poolt üleantud varast piisab osakapitali suurendamiseks või asutatava osaühingu osakapitaliks. Vara hindamist tõendavad dokumendid esitatakse koos jagunemise avaldusega äriregistrile.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_460 (redaktsioon 624304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "624304"
    },
    {
      "@id": "estleg:ariseadustik_Par_460_1_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_460_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui jagunemise korraldamiseks tuleb vähendada jaguneva osaühingu osakapitali, võib seda teha lihtsustatud korras. (2) Jaguneva osaühingu osakapitali vähendamise korral ei või jagunemist kanda jaguneva ühingu asukoha äriregistrisse enne osakapitali vähendamise äriregistrisse kandmist.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_460_1 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_460_1_v117112017022"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_460_1_v117112017022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_460_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui jagunemise korraldamiseks tuleb vähendada jaguneva osaühingu osakapitali, võib seda teha lihtsustatud korras. (2) Jaguneva osaühingu osakapitali vähendamise korral ei või jagunemist kanda jaguneva ühingu registrikaardile enne osakapitali vähendamise äriregistrisse kandmist.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_460_1 (redaktsioon 117112017022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112017022"
    },
    {
      "@id": "estleg:ariseadustik_Par_460_2_v119032015046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_460_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jaguneva osaühingu vahetusvõlakirjade omajatele kohaldatakse käesoleva seadustiku §-s 470 sätestatut.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_460_2 (redaktsioon 119032015046)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015046"
    },
    {
      "@id": "estleg:ariseadustik_Par_461_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_461"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühingu jagunemisele uue osaühingu asutamisega ei kohaldata käesoleva seadustiku paragrahvis 138 sätestatut. (2) Jagunemisel uue osaühingu asutamisega tuleb jagunemiskavas lisaks käesoleva seadustiku paragrahv 435 1. lõikes ja paragrahv 449 4. lõikes sätestatule märkida asutatava osaühingu osakapitali suurus, samuti juhatuse liikmed. Kui moodustatakse nõukogu, märgitakse ka nõukogu liikmed.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_461 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_461_v624304"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_461_v624304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_461"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühingu jagunemisele uue osaühingu asutamisega ei kohaldata käesoleva seadustiku §-s 138 sätestatut. (2) Jagunemisel uue osaühingu asutamisega tuleb jagunemiskavas lisaks käesoleva seadustiku § 435 1. lõikes ja § 449 4. lõikes sätestatule märkida asutatava osaühingu osakapitali suurus, samuti juhatuse liikmed. Kui moodustatakse nõukogu, märgitakse ka nõukogu liikmed.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_461 (redaktsioon 624304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "624304",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_461_v102112011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-11",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_461_v102112011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_461"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühingu jagunemisele uue osaühingu asutamisega ei kohaldata käesoleva seadustiku §-s 138 sätestatut. (2) Jagunemisel uue osaühingu asutamisega tuleb jagunemiskavas lisaks käesoleva seadustiku § 435 1. lõikes ja § 449 4. lõikes sätestatule märkida asutatava osaühingu osakapitali suurus, samuti juhatuse liikmed. Kui moodustatakse nõukogu, märgitakse ka nõukogu liikmed. (3) Osaühingu või aktsiaseltsi jagunemisel uue osaühingu asutamisega ei tule koostada jagunemisaruannet ning audiitor ei pea kontrollima jagunemislepingut, kui igas jagunemisel osalevas osaühingus või aktsiaseltsis määratakse osad või aktsiad jaguneva osaühingu osanike või aktsiaseltsi aktsionäride vahel samasuguse suhtega kui jagunevas osaühingus või aktsiaseltsis. Eelmises lauses sätestatud juhul ei kohaldata ka käesoleva seadustiku § 440 5. lõiget.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_461 (redaktsioon 102112011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102112011002"
    },
    {
      "@id": "estleg:ariseadustik_Par_462_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_462"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui aktsiaselts osaleb jagunemises, peab audiitor kontrollima jagunemislepingut.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_462 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318"
    },
    {
      "@id": "estleg:ariseadustik_Par_463_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_463"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vähemalt üks kuu enne jagunemist otsustavat üldkoosolekut esitab juhatus aktsiaseltsi asukohas aktsionäridele tutvumiseks: jagunemislepingu; jagunemises osalevate ühingute viimase kolme majandusaasta aruanded ja tegevusaruanded; jagunemisaruande; audiitori aruande. (2) Aktsionäri nõudel antakse talle käesoleva paragrahvi 1. lõikes nimetatud dokumentidest viivitamatult ärakiri. (3) Kui jagunemisel osaleva aktsiaseltsi viimane majandusaasta aruanne on koostatud varem kui kuus kuud enne jagunemislepingu sõlmimist, koostatakse aastaaruande nõuetele vastavalt bilanss (vahebilanss) viimase veerandaasta seisuga, mis esitatakse aktsionäridele tutvumiseks.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_463 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
