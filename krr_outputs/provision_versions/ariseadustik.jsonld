    },
    {
      "@id": "estleg:ariseadustik_Par_11_v112072014162",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisest isikust ettevõtja ärinimi peab olema selgesti eristatav teistest äriregistrisse kantud ärinimedest. (2) Äriühingu ärinimi peab olema selgesti eristatav teistest Eestis äriregistrisse kantud ärinimedest. (2¹) Kehtetu - (3) Kui äriregistrisse on ärinimena või selle osana kantud sama füüsilise isiku ees- ja perekonnanimi, mille registrisse kandmist taotletakse, peab kande taotleja oma ärinime täiendite lisamise või ärajätmisega selgelt eristatavaks muutma.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_11 (redaktsioon 112072014162)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014162",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_11_v123122022033"
      },
      "estleg:versionValidTo": {
