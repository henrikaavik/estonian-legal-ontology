        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_511_1 (redaktsioon 123122022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022033"
    },
    {
      "@id": "estleg:ariseadustik_Par_511_2_v973797",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_511_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Registripidaja tööpiirkonna muutmise korral ei pea füüsilisest isikust ettevõtja muutma oma ärinime, kui see on eksitavalt sarnane teiste uue registripidaja tööpiirkonnas äriregistrisse kantud või vähem kui kolm aastat tagasi äriregistrist kustutatud nimedega, tingimusel, et tema ettevõtte asukoht jääb pärast tööpiirkonna muutmist senisesse maakonda.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_511_2 (redaktsioon 973797)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973797",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_511_2_v131122010019"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_511_2_v131122010019",
