        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_525_v118122012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
