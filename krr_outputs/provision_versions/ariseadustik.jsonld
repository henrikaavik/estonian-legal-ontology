      },
      "estleg:versionValidTo": {
        "@value": "2012-12-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_65_v118122012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_65 (redaktsioon 118122012007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012007"
    },
    {
      "@id": "estleg:ariseadustik_Par_66_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohus on tunnistanud kehtetuks ühingu organi otsuse, mille alusel on äriregistrisse tehtud kanne, tehakse kanne kohtuotsuse kohta registrikaardi veergu, kus on kehtetuks tunnistatud otsuse alusel tehtud kanne.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_66 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_66_v118122012007"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_66_v118122012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohus on tunnistanud kehtetuks ühingu organi otsuse, mille alusel on äriregistrisse tehtud kanne, tehakse kanne kohtuotsuse kohta registrikaardil samasse kohta, kus on kehtetuks tunnistatud otsuse alusel tehtud kanne.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_66 (redaktsioon 118122012007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012007",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_66_v123122022033"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_66_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_66 (redaktsioon 123122022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022033"
    },
    {
      "@id": "estleg:ariseadustik_Par_67_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Justiitsministri määramisel võib äriregistrit pidada arvutis. (2) Kui äriregistrit peetakse arvutis, tuleb kehtivad kanded säilitada väljatrükkidena. (3) Arvutis peetava äriregistri ärakirja asendab väljatrükk, mille õigsuse kinnitab registripidaja isiku soovil. Isikule antav väljatrükk sisaldab kehtetuid andmeid vaid siis, kui seda on taotletud. (4) Justiitsminister võib oma määrusega kehtestada: arvutiandmetöötluseks vajalikud vorminõuded registripidajale esitatavate dokumentide kohta; nõude, mille kohaselt registripidajale esitatava avalduse projekti peab koostama notar; korra, mille alusel registripidaja ja iga huvitatud isik saab kontrollida taotletava ärinime senistest ärinimedest eristatavust; äriregistri elektroonilise keskandmebaasi pidamise korra.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_67 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_67_v962325"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_67_v962325",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Kui äriregistrit peetakse arvutis, tuleb kehtivad kanded säilitada väljatrükkidena. (3) Arvutis peetava äriregistri ärakirja asendab väljatrükk, mille õigsuse kinnitab registripidaja isiku soovil. Isikule antav väljatrükk sisaldab kehtetuid andmeid vaid siis, kui seda on taotletud. (4) arvutiandmetöötluseks vajalikud vorminõuded registripidajale esitatavate dokumentide kohta; nõude, mille kohaselt registripidajale esitatava avalduse projekti peab koostama notar;",
      "rdfs:label": {
        "@value": "ariseadustik_Par_67 (redaktsioon 962325)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "962325",
