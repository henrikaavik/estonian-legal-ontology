      "estleg:versionText": "Käesolevas peatükis sätestatud väärtegude kohtuväline menetleja on Politsei- ja Piirivalveamet.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_504_6 (redaktsioon 112072014162)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014162"
    },
    {
      "@id": "estleg:ariseadustik_Par_505_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_505"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadustik jõustub 1995. aasta 1. septembril. (2) Käesoleva seadustiku paragrahvid 524 ja 530 jõustuvad seadustiku Riigi Teatajas avaldamisele järgneval päeval.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_505 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_505_v192290"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_505_v192290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_505"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "ariseadustik_Par_505 (redaktsioon 192290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "192290",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_505_v131122010019"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_505_v131122010019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_505"
