        "@id": "estleg:ariseadustik_Par_1_v180018"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_1_v180018",
      "@type": [
        "owl:NamedIndividual",
