      }
    },
    {
      "@id": "estleg:ariseadustik_Par_41_v118122012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ariseadustik_Par_41 (redaktsioon 118122012007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012007"
    },
    {
      "@id": "estleg:ariseadustik_Par_410_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_410"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui täis- või usaldusühing ühineb usaldusühingu, osaühingu või aktsiaseltsiga, vastutab täisosanik ühendatava ühingu kohustuste eest, mille täitmise tähtpäev on saabunud või saabub viie aasta jooksul ühinemise kandmisest ühendava ühingu asukoha äriregistrisse. (2) Kui täis- või usaldusühing ühineb usaldusühinguga, mille täisosanikuks saab ühendatava ühingu täisosanik, ei kehti täisosaniku suhtes käesoleva paragrahvi 1. lõikes sätestatud vastutuse piirang.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_410 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
