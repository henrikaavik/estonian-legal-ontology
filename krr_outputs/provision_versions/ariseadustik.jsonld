      }
    },
    {
      "@id": "estleg:ariseadustik_Par_335_v12767277",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_335"
      },
      "estleg:versionValidFrom": {
