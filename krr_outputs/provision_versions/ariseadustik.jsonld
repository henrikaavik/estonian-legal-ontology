    {
      "@id": "estleg:ariseadustik_Par_54_v22318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui avalduses esineb kande tegemist takistav puudus või puudub vajalik dokument, võib otsuse tegemiseks pädev isik määrata tähtaja puuduse kõrvaldamiseks. Kui puudust tähtaja möödumise ajaks kõrvaldatud ei ole, jätab otsuse tegemiseks pädev isik avalduse rahuldamata. Pärast kõigi puuduste kõrvaldamist ja nõutavate dokumentide esitamist peab registripidaja avalduse läbi vaatama 15 päeva jooksul.",
      "rdfs:label": {
        "@value": "ariseadustik_Par_54 (redaktsioon 22318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22318",
      "estleg:supersededByVersion": {
        "@id": "estleg:ariseadustik_Par_54_v992482"
      },
      "estleg:versionValidTo": {
        "@value": "2006-02-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_54_v992482",
