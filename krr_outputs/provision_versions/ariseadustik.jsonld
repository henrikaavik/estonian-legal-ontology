      },
      "estleg:versionValidTo": {
        "@value": "2012-12-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_57_v118122012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui ettevõtja asukoht muutub ja uus asukoht on teise registripidaja tööpiirkonnas, ei avata ettevõtjale uut registrikaarti. (2) Kehtetu -",
      "rdfs:label": {
