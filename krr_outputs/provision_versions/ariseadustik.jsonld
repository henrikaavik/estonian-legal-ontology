        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ariseadustik_Par_28_v123122022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
