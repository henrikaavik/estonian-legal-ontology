    },
    {
      "@id": "estleg:ariseadustik_Par_231_v624350",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ariseadustik_Par_231"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsionäri surma korral läheb aktsia üle tema pärijale. [Paragrahvi 232 sõnastus kuni 30. 06. 2003]",
      "rdfs:label": {
        "@value": "ariseadustik_Par_231 (redaktsioon 624350)",
        "@language": "et"
      },
