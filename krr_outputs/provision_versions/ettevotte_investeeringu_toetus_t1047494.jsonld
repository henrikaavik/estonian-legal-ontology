    {
      "@id": "estleg:Reg_1047494_Par_16_v1047494",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047494_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) EIS tunnistab taotleja nõuetele vastavaks juhul, kui on täidetud §-s 11 taotlejale esitatud nõuded. EIS tunnistab taotleja nõuetele vastavaks juhul, kui on täidetud §-s 11 taotlejale esitatud nõuded. 2 (2) Taotlus tunnistatakse nõuetele vastavaks, kui on täidetud kõik §-s 12 taotlusele esitatud nõuded. Taotlus tunnistatakse nõuetele vastavaks, kui on täidetud kõik §-s 12 taotlusele esitatud nõuded. 3 (3) Taotlust ei tunnistata nõuetele vastavaks, kui esineb vähemalt üks järgmistest asjaoludest: 1 1) taotlus ei vasta §-s 12 sätestatud nõuetele ja puudust ei ole võimalik § 15 lõikes 2 sätestatud tähtaja jooksul kõrvaldada; 2 2) taotluses on esitatud ebaõigeid või mittetäielikke andmeid või kui taotleja mõjutab õigusvastaselt otsuse tegemist; 3 3) taotleja ei võimalda kontrollida taotluse vastavust nõuetele või teha paikvaatlust. Taotlust ei tunnistata nõuetele vastavaks, kui esineb vähemalt üks järgmistest asjaoludest: taotlus ei vasta §-s 12 sätestatud nõuetele ja puudust ei ole võimalik § 15 lõikes 2 sätestatud tähtaja jooksul kõrvaldada; taotluses on esitatud ebaõigeid või mittetäielikke andmeid või kui taotleja mõjutab õigusvastaselt otsuse tegemist; taotleja ei võimalda kontrollida taotluse vastavust nõuetele või teha paikvaatlust.",
      "rdfs:label": {
        "@value": "Reg_1047494_Par_16 (redaktsioon 1047494)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047494",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047494",
      "estleg:sourceAct": "Ettevõtte investeeringu toetus",
      "estleg:provisionRef": "Reg_1047494 § 16",
