      "estleg:provisionRef": "Reg_157912 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157912_Map"
      }
    },
    {
      "@id": "estleg:Reg_157912_Par_3_v157912",
      "@type": [
        "owl:NamedIndividual",
