      }
    },
    {
      "@id": "estleg:Reg_156665_Par_3_v156665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156665_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vanglateenistust ja osakonna tööd juhib vanglate valdkonda juhtiv asekantsler. RTL 2009 89 1297 13238339 2009-12-11 Vanglateenistust ja osakonna tööd juhib vanglate valdkonda juhtiv asekantsler. 2 (2) Asekantsler allub vahetult kantslerile. Asekantsler allub vahetult kantslerile. 3 (3) Asekantsleri äraolekul asendab teda kantsleri poolt määratud ametnik. RT I 2025-07-18 1 118072025001 2025-08-01 Asekantsleri äraolekul asendab teda kantsleri poolt määratud ametnik. 4 (4) Asekantsler: 1 1) vastutab osakonnale pandud ülesannete õigeaegse ja kvaliteetse täitmise eest ning annab sellest aru kantslerile; 2 2) määrab osakonna tööjaotuse ning töötab koos üldosakonna arendus- ja personalitalitusega välja talle alluvate osakonna ametnike ja töötajate ametijuhendid; RT I 2013-03-28 13 128032013013 2013-04-01 3 3) teostab järelevalvet osakonna ülesannete täitmise üle; RT I 2013-03-28 13 128032013013 2013-04-01 4 4) teeb ettepanekud palgafondi jaotamise kohta osakonna ametnike ja töötajate osas. RT I 2013-03-28 13 128032013013 2013-04-01 Asekantsler: vastutab osakonnale pandud ülesannete õigeaegse ja kvaliteetse täitmise eest ning annab sellest aru kantslerile; määrab osakonna tööjaotuse ning töötab koos üldosakonna arendus- ja personalitalitusega välja talle alluvate osakonna ametnike ja töötajate ametijuhendid; teostab järelevalvet osakonna ülesannete täitmise üle; teeb ettepanekud palgafondi jaotamise kohta osakonna ametnike ja töötajate osas.",
      "rdfs:label": {
        "@value": "Reg_156665_Par_3 (redaktsioon 156665)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156665",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156665",
      "estleg:sourceAct": "Vanglate osakonna põhimäärus",
      "estleg:provisionRef": "Reg_156665 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156665_Map"
      }
    },
    {
      "@id": "estleg:Reg_156665_Par_4_v156665",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156665_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Talituse juhataja juhib talituse pädevusse kuuluvate ülesannete täitmist. Talituse juhataja on ametikoha järgi vanglateenistuse juhi asetäitja. RTL 2009 89 1297 13238339 2009-12-11 Talituse juhataja juhib talituse pädevusse kuuluvate ülesannete täitmist. Talituse juhataja on ametikoha järgi vanglateenistuse juhi asetäitja. 2 (2) Talituse juhataja allub vahetult asekantslerile. Talituse juhataja allub vahetult asekantslerile. 3 (3) Talituse juhataja äraolekul asendab teda asekantsleri poolt määratud ametnik. RT I 2025-07-18 1 118072025001 2025-08-01 Talituse juhataja äraolekul asendab teda asekantsleri poolt määratud ametnik. 4 (4) Talituse juhataja: 1 1) vastutab talitusele pandud ülesannete õigeaegse ja kvaliteetse täitmise eest ning annab sellest aru asekantslerile; 2 2) määrab talituse tööjaotuse ning töötab koos üldosakonna arendus- ja personalitalitusega välja talituse ametnike ja töötajate ametijuhendid; RT I 2013-03-28 13 128032013013 2013-04-01 3 3) teostab järelevalvet talituse ametnike ja töötajate ülesannete täitmise üle; RT I 2013-03-28 13 128032013013 2013-04-01 4 4) teeb ettepanekud palgafondi jaotamise kohta talituse ametnike ja töötajate osas. RT I 2013-03-28 13 128032013013 2013-04-01 Talituse juhataja: vastutab talitusele pandud ülesannete õigeaegse ja kvaliteetse täitmise eest ning annab sellest aru asekantslerile; määrab talituse tööjaotuse ning töötab koos üldosakonna arendus- ja personalitalitusega välja talituse ametnike ja töötajate ametijuhendid; teostab järelevalvet talituse ametnike ja töötajate ülesannete täitmise üle; teeb ettepanekud palgafondi jaotamise kohta talituse ametnike ja töötajate osas.",
      "rdfs:label": {
        "@value": "Reg_156665_Par_4 (redaktsioon 156665)",
        "@language": "et"
      },
