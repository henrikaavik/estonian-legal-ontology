      }
    },
    {
      "@id": "estleg:Reg_313094_Par_11_v313094",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313094_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kassari sääre, Käina, Piibunina, Taguküla, Telliskivirahu, Uidu ja Vaemla sihtkaitsevööndites poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu tagamiseks vajalik heina ja roo niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ning harvendamine ja lisaks vaadete avamiseks puu- ja põõsarinde kujundamine ning harvendamine. Kassari sääre, Käina, Piibunina, Taguküla, Telliskivirahu, Uidu ja Vaemla sihtkaitsevööndites poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu tagamiseks vajalik heina ja roo niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ning harvendamine ja lisaks vaadete avamiseks puu- ja põõsarinde kujundamine ning harvendamine.",
      "rdfs:label": {
        "@value": "Reg_313094_Par_11 (redaktsioon 313094)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313094",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313094",
      "estleg:sourceAct": "Käina lahe–Kassari maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313094 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313094_Map"
      }
    },
    {
      "@id": "estleg:Reg_313094_Par_12_v313094",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313094_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on neli piiranguvööndit: 1 1) Esiküla piiranguvöönd; 2 2) Kassari piiranguvöönd; 3 3) Kiigeplatsi piiranguvöönd; 4 4) Orjaku piiranguvöönd. Kaitsealal on neli piiranguvööndit: Esiküla piiranguvöönd; Kassari piiranguvöönd; Kiigeplatsi piiranguvöönd; Orjaku piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_313094_Par_12 (redaktsioon 313094)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313094",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313094",
      "estleg:sourceAct": "Käina lahe–Kassari maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313094 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313094_Map"
      }
    },
    {
      "@id": "estleg:Reg_313094_Par_13_v313094",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313094_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on poollooduslike koosluste ja maastikuilme säilitamine. Piiranguvööndi kaitse-eesmärk on poollooduslike koosluste ja maastikuilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_313094_Par_13 (redaktsioon 313094)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313094",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313094",
      "estleg:sourceAct": "Käina lahe–Kassari maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313094 § 13",
