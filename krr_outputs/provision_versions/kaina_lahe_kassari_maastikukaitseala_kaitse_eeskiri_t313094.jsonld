        "@id": "estleg:Reg_313094_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist Kassari, Esiküla ja Orjaku piiranguvööndites kehtestatud üldplaneeringus või detailplaneeringus määratud kohtades on ehitiste püstitamine lubatud, arvestades käesoleva määruse § 5 punktides 5–7 sätestatut. Enne käesoleva määruse jõustumist Kassari, Esiküla ja Orjaku piiranguvööndites kehtestatud üldplaneeringus või detailplaneeringus määratud kohtades on ehitiste püstitamine lubatud, arvestades käesoleva määruse § 5 punktides 5–7 sätestatut.",
      "rdfs:label": {
        "@value": "Reg_313094_Par_17 (redaktsioon 313094)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313094",
