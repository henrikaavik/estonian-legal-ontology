      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. RT I 2009 7 48 13125268 2009-02-01+02:00 Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_313094_Par_3 (redaktsioon 313094)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313094",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313094",
      "estleg:sourceAct": "Käina lahe–Kassari maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313094 § 3",
