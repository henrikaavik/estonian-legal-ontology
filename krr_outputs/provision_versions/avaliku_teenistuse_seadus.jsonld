      }
    },
    {
      "@id": "estleg:AVALIK_Par_70_v13276914",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AVALIK_Par_70 (redaktsioon 13276914)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13276914",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVALIK_Par_70_v106072012001"
      },
      "estleg:versionValidTo": {
