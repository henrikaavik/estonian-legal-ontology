        "@value": "2013-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "AVALIK_Par_176 (redaktsioon 126032013004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013004"
    },
    {
