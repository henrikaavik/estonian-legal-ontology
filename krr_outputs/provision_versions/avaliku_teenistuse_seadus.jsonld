      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsleri seaduses tehakse järgmised muudatused:",
      "rdfs:label": {
        "@value": "AVALIK_Par_176 (redaktsioon 106072012001)",
        "@language": "et"
