      }
    },
    {
      "@id": "estleg:AVALIK_Par_108_v255060",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistussuhe peatub: ametniku kirjaliku avalduse alusel, kui teenistusse võtmise õigust omav isik või ametiasutus nõustub teenistussuhte peatumisega; puhkuse ajaks; ajutise töövõimetuse ajaks; ajaks, mil ametnik seaduses sätestatud juhtudel täidab muid talle pandud riiklikke või kohaliku omavalitsuse ülesandeid; ajateenistuskohustuse täitmise ajaks; [Kehtetu]; õppekogunemise ajaks, samuti ajaks, mil reservväelane mobilisatsiooni tõttu ei saa täita oma ametiülesandeid; ajaks, mil ametnikult ebaseaduslikult nõutakse ülesannete täitmist teisel teenistuskohal ning ta keeldub niisuguste ülesannete täitmisest; ajaks, mil ametnik on ametist kõrvaldatud käesoleva seaduse § 109 1. lõike või § 110 1. lõike alusel, samuti ajaks, mil ta on ametist kõrvaldatud mõnel muul seaduses sätestatud alusel; ajaks, mil ametnik on arestis või vahi all; muudel juhtudel, mil ametnik on seaduse või Vabariigi Valitsuse määruse alusel ajutiselt vabastatud teenistusülesannete täitmisest.",
      "rdfs:label": {
        "@value": "AVALIK_Par_108 (redaktsioon 255060)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "255060",
