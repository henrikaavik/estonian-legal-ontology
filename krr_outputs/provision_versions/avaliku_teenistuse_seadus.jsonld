      }
    },
    {
      "@id": "estleg:AVALIK_Par_108_v742925",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistussuhe peatub: ametniku kirjaliku avalduse alusel, kui teenistusse võtmise õigust omav isik või ametiasutus nõustub teenistussuhte peatumisega; puhkuse ajaks; ajutise töövõimetuse ajaks; ajaks, mil ametnik seaduses sätestatud juhtudel täidab muid talle pandud riiklikke või kohaliku omavalitsuse ülesandeid; ajateenistuskohustuse täitmise või asendusteenistuses teenimise ajaks; ajaks, mil ametnik täidab riikliku eksperdi ülesandeid Euroopa Liidu institutsioonide juures. Käesoleva punkti alusel teenistussuhte peatumise ajaks säilitatakse ametnikule ametipalk ning õigus asuda pärast peatumise lõppemist teenistusse endisele või sama laadi ametikohale; Kehtetu - õppekogunemise ajaks, samuti ajaks, mil reservväelane mobilisatsiooni tõttu ei saa täita oma ametiülesandeid; ajaks, mil ametnikult ebaseaduslikult nõutakse ülesannete täitmist teisel teenistuskohal ning ta keeldub niisuguste ülesannete täitmisest; ajaks, mil ametnik on ametist kõrvaldatud käesoleva seaduse § 109 1. lõike või § 110 1. lõike alusel, samuti ajaks, mil ta on ametist kõrvaldatud mõnel muul seaduses sätestatud alusel; ajaks, mil ametnik on arestis või vahi all; muudel juhtudel, mil ametnik on seaduse või Vabariigi Valitsuse määruse alusel ajutiselt vabastatud teenistusülesannete täitmisest.",
      "rdfs:label": {
        "@value": "AVALIK_Par_108 (redaktsioon 742925)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742925",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVALIK_Par_108_v1011738"
      },
      "estleg:versionValidTo": {
        "@value": "2006-04-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVALIK_Par_108_v1011738",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistussuhe peatub: ametniku kirjaliku avalduse alusel, kui teenistusse võtmise õigust omav isik või ametiasutus nõustub teenistussuhte peatumisega; puhkuse ajaks; ajutise töövõimetuse ajaks; ajaks, mil ametnik seaduses sätestatud juhtudel täidab muid talle pandud riiklikke või kohaliku omavalitsuse ülesandeid; ajateenistuskohustuse täitmise või asendusteenistuses teenimise ajaks; ajaks, mil ametnik täidab riikliku eksperdi ülesandeid Euroopa Liidu institutsioonide juures. Käesoleva punkti alusel teenistussuhte peatumise ajaks säilitatakse ametnikule ametipalk ning õigus asuda pärast peatumise lõppemist teenistusse endisele või sama laadi ametikohale; kehtetu – õppekogunemise ajaks, samuti ajaks, mil reservväelane mobilisatsiooni tõttu ei saa täita oma ametiülesandeid; ajaks, mil ametnikult ebaseaduslikult nõutakse ülesannete täitmist teisel teenistuskohal ning ta keeldub niisuguste ülesannete täitmisest; ajaks, mil ametnik on ametist kõrvaldatud käesoleva seaduse § 109 1. lõike või § 110 1. lõike alusel, samuti ajaks, mil ta on ametist kõrvaldatud mõnel muul seaduses sätestatud alusel; ajaks, mil ametnik on arestis või vahi all; muudel juhtudel, mil ametnik on seaduse või Vabariigi Valitsuse määruse alusel ajutiselt vabastatud teenistusülesannete täitmisest.",
      "rdfs:label": {
        "@value": "AVALIK_Par_108 (redaktsioon 1011738)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011738",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVALIK_Par_108_v1036249"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVALIK_Par_108_v1036249",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistussuhe peatub: ametniku kirjaliku avalduse alusel, kui teenistusse võtmise õigust omav isik või ametiasutus nõustub teenistussuhte peatumisega; puhkuse ajaks; ajutise töövõimetuse ajaks; ajaks, mil ametnik seaduses sätestatud juhtudel täidab muid talle pandud riiklikke või kohaliku omavalitsuse ülesandeid; ajateenistuskohustuse täitmise või asendusteenistuses teenimise ajaks; ajaks, mil ametnik täidab riikliku eksperdi ülesandeid Euroopa Liidu institutsioonide juures. Käesoleva punkti alusel teenistussuhte peatumise ajaks säilitatakse ametnikule ametipalk ning õigus asuda pärast peatumise lõppemist teenistusse endisele või sama laadi ametikohale; kehtetu – õppekogunemise ajaks, samuti ajaks, mil reservväelane mobilisatsiooni tõttu ei saa täita oma ametiülesandeid; ajaks, mil ametnikult ebaseaduslikult nõutakse ülesannete täitmist teisel teenistuskohal ning ta keeldub niisuguste ülesannete täitmisest; ajaks, mil ametnik on ametist kõrvaldatud käesoleva seaduse § 109 1. lõike või § 110 1. lõike alusel, samuti ajaks, mil ta on ametist kõrvaldatud mõnel muul seaduses sätestatud alusel; ajaks, mil ametnik on arestis või vahi all; muudel juhtudel, mil ametnik on seaduse või Vabariigi Valitsuse määruse alusel ajutiselt vabastatud teenistusülesannete täitmisest. [Paragrahv 1081jõustub 1. 01. 2007]",
      "rdfs:label": {
        "@value": "AVALIK_Par_108 (redaktsioon 1036249)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036249",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVALIK_Par_108_v12807925"
      },
      "estleg:versionValidTo": {
        "@value": "2007-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVALIK_Par_108_v12807925",
      "@type": [
        "owl:NamedIndividual",
