      "rdfs:label": {
        "@value": "AVALIK_Par_99 (redaktsioon 197195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "197195",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVALIK_Par_99_v951814"
