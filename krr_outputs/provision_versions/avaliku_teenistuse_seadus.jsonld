      }
    },
    {
      "@id": "estleg:AVALIK_Par_43_v13276914",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_43"
      },
      "estleg:versionValidFrom": {
