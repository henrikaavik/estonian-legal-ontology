      }
    },
    {
      "@id": "estleg:AVALIK_Par_43_v106072012001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ametnikule kohaldatakse töölepingu seaduse §-des 54–71 sätestatud puhkuseregulatsiooni, arvestades käesolevas seaduses sätestatud erisusi. (2) Ametniku põhipuhkuse kestus on 35 kalendripäeva. (3) Puhkuse andmise otsustab ametisse nimetamise õigust omav isik või tema volitatud isik. (4) Puhkusetasu maksmisega viivitamise korral maksab ametiasutus viivist iga viivitatud päeva eest vastavalt võlaõigusseaduse §-le 113.",
      "rdfs:label": {
        "@value": "AVALIK_Par_43 (redaktsioon 106072012001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072012001"
    },
    {
      "@id": "estleg:AVALIK_Par_44_v22312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenistujal on kahe puhkepäevaga viiepäevane töönädal. (2) Teenistuja tööaeg ei või ületada 40 tundi nädalas. (3) Teenistuja töö- ja puhkeaeg määratakse töö- ja puhkeaja seaduse (RT I 1994, 2, 12; 1995, 12, 120) alusel, arvestades käesoleva seaduse ja avalikku teenistust reguleerivate eriseadustega sätestatud erisusi.",
      "rdfs:label": {
        "@value": "AVALIK_Par_44 (redaktsioon 22312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22312",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVALIK_Par_44_v12924849"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVALIK_Par_44_v12924849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenistujal on kahe puhkepäevaga viiepäevane töönädal. (2) Teenistuja tööaeg ei või ületada 40 tundi nädalas. (3) Teenistuja töö- ja puhkeaeg määratakse töö- ja puhkeaja seaduse alusel, arvestades käesoleva seaduse ja avalikku teenistust reguleerivate eriseadustega sätestatud erisusi.",
      "rdfs:label": {
        "@value": "AVALIK_Par_44 (redaktsioon 12924849)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12924849",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVALIK_Par_44_v13198350"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVALIK_Par_44_v13198350",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenistujal on kahe puhkepäevaga viiepäevane töönädal. (2) Teenistuja tööaeg ei või ületada 40 tundi nädalas. (3) Teenistuja töö- ja puhkeaeg määratakse töölepingu seaduse 3. peatüki 3. jao alusel, arvestades käesoleva seaduse ja avalikku teenistust reguleerivate eriseadustega sätestatud erisusi. (4) Töölepingu seaduse §-s 50 nimetatud öötöö piirangut ei kohaldata tingimusel, et töötamine ei kahjusta ametniku tervist ja ohutust ning tööaeg ei ületa töölepingu seaduse § 46 lõikes 1 nimetatud piirangut: avalikus teenistuses tegevuste puhul, mis nõuavad riikliku järelevalve pidevat jätkumist; politseiasutuste avalikele teenistujatele. (5) Politseiasutuse avalikule teenistujale ei kohaldata valveaja rakendamisel töölepingu seaduse §-s 48 sätestatut. Valveaeg on aeg, millal politseiasutuse avalik teenistuja peab olema kokkulepitud kohas kättesaadav edasilükkamatute teenistusülesannete täitmiseks oma puhkeajal. Valveaja kestus ei tohi ületada 150 tundi kuus. Valveaja rakendamise ja arvestamise alused lepitakse kokku kollektiivlepingus.",
      "rdfs:label": {
        "@value": "AVALIK_Par_44 (redaktsioon 13198350)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13198350",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVALIK_Par_44_v129122011166"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
