      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uusaastale, Eesti Vabariigi aastapäevale, võidupühale ja jõululaupäevale vahetult eelnevat tööpäeva lühendatakse kolme tunni võrra.",
      "rdfs:label": {
        "@value": "AVALIK_Par_42 (redaktsioon 106072012001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072012001"
    },
    {
      "@id": "estleg:AVALIK_Par_43_v22312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(l) Välislähetuseks loetakse teenistuja lähetamist välisriiki. (2) Loa ministeeriumi valitsemisala asutuse juhi välislähetuseks annab kantsler ministri teadmisel. (3) Teenistuja välislähetusse saatmise korra, välislähetustasu ning hüvitiste suuruse ja nende maksmise korra, samuti muud sotsiaalsed tagatised kehtestab Vabariigi Valitsus oma määrusega.",
      "rdfs:label": {
        "@value": "AVALIK_Par_43 (redaktsioon 22312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22312",
