      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Atesteerimistulemused vormistatakse konkursi- ja atesteerimiskomisjoni otsusena koosoleku protokollis.",
      "rdfs:label": {
        "@value": "AVALIK_Par_98 (redaktsioon 951814)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "951814",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVALIK_Par_98_v129122011166"
      },
      "estleg:versionValidTo": {
