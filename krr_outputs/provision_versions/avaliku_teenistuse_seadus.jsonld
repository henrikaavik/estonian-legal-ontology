      ],
      "estleg:versionOf": {
        "@id": "estleg:AVALIK_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Atesteerimistulemused vormistatakse konkursi- ja atesteerimiskomisjoni otsusena koosoleku protokollis. (2) Ametniku edutamisel toimuva atesteerimise ja perioodilise atesteerimise tulemused kantakse ametniku atesteerimisperioodi alguses avatud atesteerimislehele.",
      "rdfs:label": {
        "@value": "AVALIK_Par_98 (redaktsioon 22312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22312",
      "estleg:supersededByVersion": {
