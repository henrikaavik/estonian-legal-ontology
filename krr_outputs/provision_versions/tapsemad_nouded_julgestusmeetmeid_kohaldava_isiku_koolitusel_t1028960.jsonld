      "estleg:sourceAct": "Täpsemad nõuded julgestusmeetmeid kohaldava isiku koolitusele, koolituse läbiviimise sagedusele ja dokumenteerimisele",
      "estleg:provisionRef": "Reg_1028960 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028960_Map_2026"
      }
    },
    {
