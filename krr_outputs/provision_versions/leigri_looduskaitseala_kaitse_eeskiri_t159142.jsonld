    {
      "@id": "estleg:Reg_159142_Par_14_v159142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159142_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavara kaevandamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 5 5) biotsiidi ja taimekaitsevahendi kasutamine; 6 6) üle 50 osalejaga rahvaürituste korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohtades. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; biotsiidi ja taimekaitsevahendi kasutamine; üle 50 osalejaga rahvaürituste korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohtades. 2 (2) Kaitseala valitseja loata on piiranguvööndis keelatud uute ehitiste püstitamine. Kaitseala valitseja loata on piiranguvööndis keelatud uute ehitiste püstitamine.",
      "rdfs:label": {
