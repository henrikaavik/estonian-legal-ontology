    {
      "@id": "estleg:Reg_1053342_Par_22_v1053342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053342_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 15. märtsi 2020. a käskkirjaga nr 1-2/20/116 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 15. märtsi 2020. a käskkirjaga nr 1-2/20/116 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1053342_Par_22 (redaktsioon 1053342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053342",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053342",
      "estleg:sourceAct": "Porkuni maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053342 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053342_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053342_Par_23_v1053342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053342_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1053342_Par_23 (redaktsioon 1053342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053342",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053342",
      "estleg:sourceAct": "Porkuni maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053342 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053342_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053342_Par_3_v1053342",
