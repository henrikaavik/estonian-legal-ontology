      },
      "estleg:versionText": "Piiranguvööndis on poollooduslike koosluste aladel nende ilme ja liigikoosseisu tagamiseks vajalik niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Piiranguvööndis on poollooduslike koosluste aladel nende ilme ja liigikoosseisu tagamiseks vajalik niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_1053342_Par_17 (redaktsioon 1053342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053342",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053342",
      "estleg:sourceAct": "Porkuni maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053342 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053342_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053342_Par_18_v1053342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053342_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavara kaevandamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õue- ja põllumaal ning pargi ilu- ja tarbeaias; 5 5) roo varumine külmumata pinnasel. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õue- ja põllumaal ning pargi ilu- ja tarbeaias; roo varumine külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_1053342_Par_18 (redaktsioon 1053342)",
        "@language": "et"
      },
