      }
    },
    {
      "@id": "estleg:Reg_1053342_Par_12_v1053342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053342_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul tehnovõrgu rajatise püstitamine kaitsealal paikneva kinnistu tarbeks ning rajatise püstitamine kaitseala tarbeks. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul tehnovõrgu rajatise püstitamine kaitsealal paikneva kinnistu tarbeks ning rajatise püstitamine kaitseala tarbeks.",
      "rdfs:label": {
        "@value": "Reg_1053342_Par_12 (redaktsioon 1053342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053342",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053342",
      "estleg:sourceAct": "Porkuni maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053342 § 12",
      "estleg:partOfAct": {
