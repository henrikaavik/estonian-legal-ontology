        "@value": "2022-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1053342_Par_3 (redaktsioon 1053342)",
        "@language": "et"
      },
