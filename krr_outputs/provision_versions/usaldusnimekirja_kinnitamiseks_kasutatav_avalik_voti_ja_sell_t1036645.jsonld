    {
      "@id": "estleg:Reg_1036645_Par_2_v1036645",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036645_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-02-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse §-s 1 sätestatud avalikule võtmele vastavat privaatvõtit kasutatakse ainult Euroopa Parlamendi ja nõukogu määruse (EL) nr 910/2014 e-identimise ja e-tehingute jaoks vajalike usaldusteenuste kohta siseturul ja millega tunnistatakse kehtetuks direktiiv 1999/93EÜ (ELT L 257, 28.08.2014, lk 73–114) artikli 22 kohase usaldusnimekirja ja selles sisalduvate andmete õigsuse kinnitamiseks. Käesoleva määruse §-s 1 sätestatud avalikule võtmele vastavat privaatvõtit kasutatakse ainult Euroopa Parlamendi ja nõukogu määruse (EL) nr 910/2014 e-identimise ja e-tehingute jaoks vajalike usaldusteenuste kohta siseturul ja millega tunnistatakse kehtetuks direktiiv 1999/93EÜ (ELT L 257, 28.08.2014, lk 73–114) artikli 22 kohase usaldusnimekirja ja selles sisalduvate andmete õigsuse kinnitamiseks.",
      "rdfs:label": {
        "@value": "Reg_1036645_Par_2 (redaktsioon 1036645)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036645",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036645",
      "estleg:sourceAct": "Usaldusnimekirja kinnitamiseks kasutatav avalik võti ja sellele vastava privaatvõtme kasutusala",
      "estleg:provisionRef": "Reg_1036645 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036645_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036645_Par_3_v1036645",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
