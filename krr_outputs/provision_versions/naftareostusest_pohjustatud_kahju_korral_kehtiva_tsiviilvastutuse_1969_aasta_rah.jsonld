  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_naftareostusest_pohjustatud_kahju_korral_kehtiva_tsiviilvastutuse_1969_aasta_rah_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Naftareostusest põhjustatud kahju korral kehtiva tsiviilvastutuse 1969. aasta rahvusvahelise konventsiooni ja naftareostusest põhjustatud kahju kompenseerimise rahvusvahelise fondi asutamise 1971. aasta rahvusvahelise konventsiooni muutmise 1992. aasta protokollidega ühinemise seadus (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Naftareostusest põhjustatud kahju korral kehtiva tsiviilvastutuse 1969. aasta rahvusvahelise konventsiooni ja naftareostusest põhjustatud kahju kompenseerimise rahvusvahelise fondi asutamise 1971. aasta rahvusvahelise konventsiooni muutmise 1992. aasta protokollidega ühinemise seadus"
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_1_v776200",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud 1992. aasta 27. novembril Londonis koostatud protokolliga naftareostusest põhjustatud kahju korral kehtiva tsiviilvastutuse 1969. aasta rahvusvahelise konventsiooni muutmise kohta ning lugeda seega Eesti Vabariik ühinenuks (edaspidi1992. aasta vastutuse konventsioon) vastavalt protokolli artikli 11 punktile 2.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_1 (redaktsioon 776200)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "776200"
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_2_v776200",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud 1992. aasta 27. novembril Londonis koostatud protokolliga naftareostusest põhjustatud kahju kompenseerimise rahvusvahelise fondi asutamise 1971. aasta rahvusvahelise konventsiooni muutmise kohta ning lugeda seega Eesti Vabariik ühinenuks (edaspidi1992. aasta fondi konventsioon) vastavalt protokolli artikli 27 punktile 2.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_2 (redaktsioon 776200)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "776200"
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_3_v776200",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veeteede Amet väljastab laevale 1992. aasta vastutuse konventsiooni nõuetele vastava kindlustuslepingu või muu rahalise tagatise, nagu pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi olemasolu tõendava tunnistuse (edaspidi tunnistus ), kui laevaomanik esitab kindlustuslepingu, pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi, mis vastab 1992. aasta vastutuse konventsiooni nõuetele ning võimaldab hüvitada naftareostusest põhjustatud kahju 1992. aasta vastutuse konventsiooni artikli V lõikega 1 sätestatud piirmäära ulatuses.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_3 (redaktsioon 776200)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "776200",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPKKKTRKNPKK_Par_3_v210122020002"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_3_v210122020002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpordiamet väljastab laevale 1992. aasta vastutuse konventsiooni nõuetele vastava kindlustuslepingu või muu rahalise tagatise, nagu pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi olemasolu tõendava tunnistuse (edaspidi tunnistus), kui laevaomanik esitab kindlustuslepingu, pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi, mis vastab 1992. aasta vastutuse konventsiooni nõuetele ning võimaldab hüvitada naftareostusest põhjustatud kahju 1992. aasta vastutuse konventsiooni artikli V lõikega 1 sätestatud piirmäära ulatuses.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_3 (redaktsioon 210122020002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "210122020002"
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_3_1_v231052021001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_3_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui Transpordiamet väljastab tunnistuse elektrooniliselt, peab see vastama meresõiduohutuse seaduse § 1 lõikes 71 sätestatud tingimustele.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_3_1 (redaktsioon 231052021001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "231052021001"
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_4_v776200",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaministeerium esitab 1992. aasta fondi konventsiooni artiklis 15 nimetatud andmed rahvusvahelisele naftareostusest põhjustatud kahju kompenseerimise fondile.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_4 (redaktsioon 776200)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "776200",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPKKKTRKNPKK_Par_4_v216012024012"
      },
      "estleg:versionValidTo": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_4_v216012024012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kliimaministeerium esitab 1992. aasta fondi konventsiooni artiklis 15 nimetatud andmed rahvusvahelisele naftareostusest põhjustatud kahju kompenseerimise fondile. ; Vabariigi Valitsuse seaduse § 105.19 lõike 6 alusel asendatud sõna „Keskkonnaministeerium” sõnaga „Kliimaministeerium”.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_4 (redaktsioon 216012024012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "216012024012"
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_5_v776200",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnainspektsioon teostab järelevalvet naftareostusest põhjustatud kahju kompenseerimise fondi kontributsiooni maksvate isikute üle.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_5 (redaktsioon 776200)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "776200",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPKKKTRKNPKK_Par_5_v231052021001"
      },
      "estleg:versionValidTo": {
        "@value": "2021-06-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_5_v231052021001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaamet teostab järelevalvet naftareostusest põhjustatud kahju kompenseerimise fondi kontributsiooni maksvate isikute üle.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_5 (redaktsioon 231052021001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "231052021001"
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_6_v776200",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPKKKTRKNPKK_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veeteede Amet kontrollib nõuetekohase tunnistuse olemasolu sadamasse saabuvatel ja sadamast lahkuvatel laevadel ning territoriaalmeres asuvatesse terminalidesse saabuvatel ja nendest lahkuvatel laevadel. “Naftareostusest põhjustatud kahju korral kehtiva tsiviilvastutuse 1969. aasta rahvusvahelise konventsiooni ja naftareostusest põhjustatud kahju kompenseerimise rahvusvahelise fondi asutamise 1971. aasta rahvusvahelise konventsiooni muutmise 1992. aasta protokollidega ühinemise seaduse” metaandmetes olevas pealkirjas oli sõna “protokollidega” asemel sõna “protokolliga”.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_6 (redaktsioon 776200)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "776200",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPKKKTRKNPKK_Par_6_v210122020002"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NPKKKTRKNPKK_Par_6_v210122020002",
      "@type": [
