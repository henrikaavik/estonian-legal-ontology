        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpordiamet kontrollib nõuetekohase tunnistuse olemasolu sadamasse saabuvatel ja sadamast lahkuvatel laevadel ning territoriaalmeres asuvatesse terminalidesse saabuvatel ja nendest lahkuvatel laevadel.",
      "rdfs:label": {
        "@value": "NPKKKTRKNPKK_Par_6 (redaktsioon 210122020002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "210122020002"
    }
