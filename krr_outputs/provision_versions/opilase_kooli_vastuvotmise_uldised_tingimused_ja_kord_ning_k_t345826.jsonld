      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse paragrahvi 2 lõikes 3 sätestatud piirangut kooli vastuvõtu tingimuste ja korra muutmiseks ei kohaldata 2021/2022. õppeaastal. RT I 2022-05-27 69 127052022069 2022-05-30 Käesoleva määruse paragrahvi 2 lõikes 3 sätestatud piirangut kooli vastuvõtu tingimuste ja korra muutmiseks ei kohaldata 2021/2022. õppeaastal.",
      "rdfs:label": {
        "@value": "Reg_345826_Par_7_10 (redaktsioon 345826)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345826",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345826",
      "estleg:sourceAct": "Õpilase kooli vastuvõtmise üldised tingimused ja kord ning koolist väljaarvamise kord",
      "estleg:provisionRef": "Reg_345826 § 7_10",
