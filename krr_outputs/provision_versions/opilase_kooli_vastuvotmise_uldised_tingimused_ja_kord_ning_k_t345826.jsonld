      "estleg:sourceAct": "Õpilase kooli vastuvõtmise üldised tingimused ja kord ning koolist väljaarvamise kord",
      "estleg:provisionRef": "Reg_345826 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345826_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_345826_Par_7_10_v345826",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
