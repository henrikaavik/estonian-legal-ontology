    {
      "@id": "estleg:Reg_1017693_Par_11_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Barett on ühevärviline voodrile töödeldud vanutatud silmuskudum. Barett on ääristatud naturaalsest nahast musta värvi kandiga, mille sees on pingutusnöör. Barett on ühevärviline voodrile töödeldud vanutatud silmuskudum. Barett on ääristatud naturaalsest nahast musta värvi kandiga, mille sees on pingutusnöör. 2 (2) Baretil kantakse mütsimärki vastavalt Kaitseväe juhataja kehtestatud korrale. Baretil kantakse mütsimärki vastavalt Kaitseväe juhataja kehtestatud korrale.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_11 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017693",
      "estleg:sourceAct": "Kaitseväelase vormiriietuse kirjeldus ja vormiriietuse väljastamise kord",
