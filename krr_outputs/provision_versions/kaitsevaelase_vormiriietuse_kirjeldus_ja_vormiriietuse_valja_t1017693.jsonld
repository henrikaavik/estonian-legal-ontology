        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhtuvormi kikilips on klassikaline musta värvi. Õhtuvormi kikilips on klassikaline musta värvi.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_44 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
