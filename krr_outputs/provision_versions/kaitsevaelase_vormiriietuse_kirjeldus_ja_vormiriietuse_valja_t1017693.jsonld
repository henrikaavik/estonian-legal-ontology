        "@id": "estleg:Reg_1017693_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017693_Par_8_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_8 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017693",
      "estleg:sourceAct": "Kaitseväelase vormiriietuse kirjeldus ja vormiriietuse väljastamise kord",
      "estleg:provisionRef": "Reg_1017693 § 8",
