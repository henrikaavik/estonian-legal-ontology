    {
      "@id": "estleg:Reg_1017693_Par_50_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_50"
