    {
      "@id": "estleg:Reg_1017693_Par_23_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Suvevormi särk on valge, sirge siluetiga ja kaheõmbluseliste, otsaõmmeldud varrukatega. Madruse suvevormi särgil on sisselõikeline esikinnis. Särgi krae nurgad on täisnurksed. Krae pealmine detail on sinist värvi. Krae välisserva on õmmeldud kolm valget paela. Varrukasuus on sinist värvi mansett, millele on õmmeldud kolm valget paela. Suvevormi särk on valge, sirge siluetiga ja kaheõmbluseliste, otsaõmmeldud varrukatega. Madruse suvevormi särgil on sisselõikeline esikinnis. Särgi krae nurgad on täisnurksed. Krae pealmine detail on sinist värvi. Krae välisserva on õmmeldud kolm valget paela. Varrukasuus on sinist värvi mansett, millele on õmmeldud kolm valget paela.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_23 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
