    {
      "@id": "estleg:Reg_1017693_Par_25_26_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_25_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mereväe pandlaga vöörihm on naturaalsest monoliitsest nahast musta värvi rihm. Rihma paksus on 3 mm ja laius 40 mm. Vöörihmal on liikuv aas, mis on kinnitatud metallaasaga, ning figuurne teping. Vöörihmal on eraldi metallist ümmargune mereväe sümboolikaga kulla värvi pannal. Pannal on pealtvaates ümmargune ja profiilis veidi kumer. Pandla keskel on ankru kujutis ja serval on köit meenutav kõrgem serv. RT I 2023-06-14 1 114062023001 2023-06-17 Mereväe pandlaga vöörihm on naturaalsest monoliitsest nahast musta värvi rihm. Rihma paksus on 3 mm ja laius 40 mm. Vöörihmal on liikuv aas, mis on kinnitatud metallaasaga, ning figuurne teping. Vöörihmal on eraldi metallist ümmargune mereväe sümboolikaga kulla värvi pannal. Pannal on pealtvaates ümmargune ja profiilis veidi kumer. Pandla keskel on ankru kujutis ja serval on köit meenutav kõrgem serv.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_25_26 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017693",
      "estleg:sourceAct": "Kaitseväelase vormiriietuse kirjeldus ja vormiriietuse väljastamise kord",
      "estleg:provisionRef": "Reg_1017693 § 25_26",
