      "estleg:provisionRef": "Reg_1017693 § 55",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017693_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017693_Par_56_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
