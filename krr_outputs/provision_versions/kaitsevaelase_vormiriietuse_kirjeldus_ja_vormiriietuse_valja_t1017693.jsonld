      }
    },
    {
      "@id": "estleg:Reg_1017693_Par_7_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõiduki meeskonna vormi elementideks on: 1 1) lendurijope; 2 2) lenduri talvejope; 3 3) lennukombinesoon; 4 4) suvemüts. RT I 2023-06-14 1 114062023001 2023-06-17 Õhusõiduki meeskonna vormi elementideks on: lendurijope; lenduri talvejope; lennukombinesoon; suvemüts.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_7 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
