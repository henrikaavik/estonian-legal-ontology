      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kasutuskõlbmatuks muutunud või hävinenud vormiriietuse elemendi või riikliku tunnuse asemel väljastatakse uus. Uue vormiriietuse elemendi või riikliku tunnuse väljastamisel tuleb tagastada kasutuskõlbmatuks muutunud vormiriietuse element või riiklik tunnus. Kasutuskõlbmatuks muutunud või hävinenud vormiriietuse elemendi või riikliku tunnuse asemel väljastatakse uus. Uue vormiriietuse elemendi või riikliku tunnuse väljastamisel tuleb tagastada kasutuskõlbmatuks muutunud vormiriietuse element või riiklik tunnus. 2 (2) Kaitseväelane, kellele väljastatud vormiriietus või selle element on hävinud või kadunud, on kohustatud hüvitama hävinud või kaotatud vormiriietuse või selle elemendi väärtuse, kui hävimine või kaotamine on asetleidnud kaitseväelase tegevuse või tegevusetuse tagajärjel. Kaitseväelane, kellele väljastatud vormiriietus või selle element on hävinud või kadunud, on kohustatud hüvitama hävinud või kaotatud vormiriietuse või selle elemendi väärtuse, kui hävimine või kaotamine on asetleidnud kaitseväelase tegevuse või tegevusetuse tagajärjel.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_56 (redaktsioon 1017693)",
        "@language": "et"
      },
