      }
    },
    {
      "@id": "estleg:Reg_1017693_Par_9_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vormiriietusel kantakse käesolevas määruses sätestatud juhtudel järgmisi riiklike tunnuseid: 1 1) mütsimärk (lisa 1); 2 2) ohvitseri ja allohvitseri auastme alaliigi tunnus (lisa 2); 3 3) ohvitseritunnus (lisa 3); 4 4) riigitunnus (lisa 4). Vormiriietusel kantakse käesolevas määruses sätestatud juhtudel järgmisi riiklike tunnuseid: mütsimärk (lisa 1); ohvitseri ja allohvitseri auastme alaliigi tunnus (lisa 2); ohvitseritunnus (lisa 3); riigitunnus (lisa 4). 2 (2) Vormiriietusega kantakse kaitseväelasele antud kõrgeima sõjaväelise auastme eraldusmärke või sõjaväelisele auastmele viitavat muud tunnust. Vormiriietusega kantakse kaitseväelasele antud kõrgeima sõjaväelise auastme eraldusmärke või sõjaväelisele auastmele viitavat muud tunnust. 3 (3) Vormiriietusel võib kanda käesoleva paragrahvi lõigetes 1 ja 2 nimetamata tunnuseid või eraldusmärke, kui kandmine on ettenähtud või lubatud Kaitseväe juhataja kehtestatud individuaalvarustuse kandmise korras. Vormiriietusel võib kanda käesoleva paragrahvi lõigetes 1 ja 2 nimetamata tunnuseid või eraldusmärke, kui kandmine on ettenähtud või lubatud Kaitseväe juhataja kehtestatud individuaalvarustuse kandmise korras.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_9 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017693",
      "estleg:sourceAct": "Kaitseväelase vormiriietuse kirjeldus ja vormiriietuse väljastamise kord",
      "estleg:provisionRef": "Reg_1017693 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017693_Map_2026"
      }
    },
