    {
      "@id": "estleg:Reg_1017693_Par_54_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lenduri talvejope on naturaalsest lambanahast 15 mm kõrguse musta värvi aluskarvaga sirge siluetiga. Jopel on kaks varjatud tõmblukuga küljetaskut ja rinnataskut. Vasakul varrukal tõmblukuga tasku. Jope allääre külgedel on reguleeritavad põõnad. Jopel on lai mahapööratav krae, mis on suletav nahast rihmaga. Jope varrukatel on takjapael embleemi kinnitamiseks. Jope esiosa vasaku rinna kõrgusel on takjapael nimesildi kinnitamiseks. Lenduri talvejope on naturaalsest lambanahast 15 mm kõrguse musta värvi aluskarvaga sirge siluetiga. Jopel on kaks varjatud tõmblukuga küljetaskut ja rinnataskut. Vasakul varrukal tõmblukuga tasku. Jope allääre külgedel on reguleeritavad põõnad. Jopel on lai mahapööratav krae, mis on suletav nahast rihmaga. Jope varrukatel on takjapael embleemi kinnitamiseks. Jope esiosa vasaku rinna kõrgusel on takjapael nimesildi kinnitamiseks. 2 (2) Lenduri talvejope varrukale on kinnitatud riigitunnus. Lenduri talvejope varrukale on kinnitatud riigitunnus.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_54 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017693",
      "estleg:sourceAct": "Kaitseväelase vormiriietuse kirjeldus ja vormiriietuse väljastamise kord",
      "estleg:provisionRef": "Reg_1017693 § 54",
