    },
    {
      "@id": "estleg:Reg_1017693_Par_51_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhtuvormi musta värvi vöö on töödeldud voodrile. Vöö esiosas on nelja allapoole suunatud voldiga drapeering. Seljaosas on vöö ilma voltideta. Vöö on selja tagant suletav kahe nööbiga. Õhtuvormi musta värvi vöö on töödeldud voodrile. Vöö esiosas on nelja allapoole suunatud voldiga drapeering. Seljaosas on vöö ilma voltideta. Vöö on selja tagant suletav kahe nööbiga.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_51 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017693",
      "estleg:sourceAct": "Kaitseväelase vormiriietuse kirjeldus ja vormiriietuse väljastamise kord",
      "estleg:provisionRef": "Reg_1017693 § 51",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017693_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017693_Par_52_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lennukombinesooni esikinnis on suletav tõmblukuga (kahe kelguga lukk). Kombinesooni seljaosa on volditud. Kombinesoonil on reguleeritav vöökoht. Vöörihm on suletav takjakinnitusega. Kombinesoonil on kaks kaldsuunalist lukuga suletavat rinnataskut ja kaks lukuga suletavad reietaskut ning kaks tõmblukuga sääretaskut. Vasakul reiel on klapiga suletav noatasku. Vasakul varrukas on suletav pliiatsi tasku. Lennukombinesooni varrukatel on takjapael embleemi kinnitamiseks. Kombinesooni rinnataskute kohal on takjapael embleemi ja nimesildi kinnitamiseks. Lennukombinesooni esikinnis on suletav tõmblukuga (kahe kelguga lukk). Kombinesooni seljaosa on volditud. Kombinesoonil on reguleeritav vöökoht. Vöörihm on suletav takjakinnitusega. Kombinesoonil on kaks kaldsuunalist lukuga suletavat rinnataskut ja kaks lukuga suletavad reietaskut ning kaks tõmblukuga sääretaskut. Vasakul reiel on klapiga suletav noatasku. Vasakul varrukas on suletav pliiatsi tasku. Lennukombinesooni varrukatel on takjapael embleemi kinnitamiseks. Kombinesooni rinnataskute kohal on takjapael embleemi ja nimesildi kinnitamiseks. 2 (2) Lennukombinesooni varrukale on kinnitatud riigitunnus. Lennukombinesooni varrukale on kinnitatud riigitunnus.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_52 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017693",
      "estleg:sourceAct": "Kaitseväelase vormiriietuse kirjeldus ja vormiriietuse väljastamise kord",
      "estleg:provisionRef": "Reg_1017693 § 52",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017693_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017693_Par_53_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017693_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lendurijope esikinnis on suletav tõmblukuga. Jopel on kaks klapiga taskut. Varrukate otstes ja jope allääres on tekstiilmansett. Vasakul varrukal on lukuga suletav tasku. Jope varrukatel on takjapael embleemi kinnitamiseks. Jope esiosa vasaku rinna kõrgusel on takjapael nimesildi kinnitamiseks. Lendurijope esikinnis on suletav tõmblukuga. Jopel on kaks klapiga taskut. Varrukate otstes ja jope allääres on tekstiilmansett. Vasakul varrukal on lukuga suletav tasku. Jope varrukatel on takjapael embleemi kinnitamiseks. Jope esiosa vasaku rinna kõrgusel on takjapael nimesildi kinnitamiseks. 2 (2) Lendurijope varrukale on kinnitatud riigitunnus. Lendurijope varrukale on kinnitatud riigitunnus.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_53 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017693",
      "estleg:sourceAct": "Kaitseväelase vormiriietuse kirjeldus ja vormiriietuse väljastamise kord",
      "estleg:provisionRef": "Reg_1017693 § 53",
