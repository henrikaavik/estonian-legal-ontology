      "estleg:versionValidFrom": {
        "@value": "2023-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhtuvorm on kaitseväelase pidulik vormiriietus, mida ei loeta Kaitseväe väljastatavaks ametniku tööriietuseks ning ei kanta teenistusülesannete täitmisel. RT I 2023-06-14 1 114062023001 2023-06-17 Õhtuvorm on kaitseväelase pidulik vormiriietus, mida ei loeta Kaitseväe väljastatavaks ametniku tööriietuseks ning ei kanta teenistusülesannete täitmisel.",
      "rdfs:label": {
        "@value": "Reg_1017693_Par_1_1 (redaktsioon 1017693)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017693",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017693",
      "estleg:sourceAct": "Kaitseväelase vormiriietuse kirjeldus ja vormiriietuse väljastamise kord",
      "estleg:provisionRef": "Reg_1017693 § 1_1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017693_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017693_Par_2_v1017693",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
