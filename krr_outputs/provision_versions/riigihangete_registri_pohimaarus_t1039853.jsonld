      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrit peetakse ühetasandilise infotehnoloogilise andmekoguna, mis koosneb digitaalsetest registriandmetest. Registrit peetakse ühetasandilise infotehnoloogilise andmekoguna, mis koosneb digitaalsetest registriandmetest.",
      "rdfs:label": {
        "@value": "Reg_1039853_Par_5 (redaktsioon 1039853)",
