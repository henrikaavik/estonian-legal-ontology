      }
    },
    {
      "@id": "estleg:Reg_1039853_Par_17_v1039853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039853_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigihanke ja toetuse saaja ostu alustamisel antakse riigihankele registris kordumatu kuuekohaline viitenumber. RT I 2021-11-02 1 102112021001 2021-11-05 Riigihanke ja toetuse saaja ostu alustamisel antakse riigihankele registris kordumatu kuuekohaline viitenumber. 2 (2) Riigihanke viitenumbriga viidatakse kõigile sama riigihankega või toetuse saaja ostuga seonduvatele registris koostatavatele dokumentidele ja riigihanke vaidlustusmenetluse tulemustele. RT I 2021-11-02 1 102112021001 2021-11-05 Riigihanke viitenumbriga viidatakse kõigile sama riigihankega või toetuse saaja ostuga seonduvatele registris koostatavatele dokumentidele ja riigihanke vaidlustusmenetluse tulemustele.",
      "rdfs:label": {
        "@value": "Reg_1039853_Par_17 (redaktsioon 1039853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039853",
      "estleg:sourceAct": "Riigihangete registri põhimäärus",
      "estleg:provisionRef": "Reg_1039853 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039853_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039853_Par_18_v1039853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039853_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hankija ja toetuse saaja saavad registrisse esitatud andmeid muuta või tagasi võtta enne nende avaldamist või § 16 lõikes 5 nimetatud juhtudel enne nende edastamist väljaannete talitusele. RT I 2021-11-02 1 102112021001 2021-11-05 Hankija ja toetuse saaja saavad registrisse esitatud andmeid muuta või tagasi võtta enne nende avaldamist või § 16 lõikes 5 nimetatud juhtudel enne nende edastamist väljaannete talitusele. 2 (2) Väljaannete talitusele edastatud andmeid saab muuta ainult pärast muudetava teate avaldamist. Väljaannete talitusele edastatud andmeid saab muuta ainult pärast muudetava teate avaldamist. 3 (3) Väljaannete talitusele edastatavat teadet ei saa muuta hiljem kui 48 tundi enne taotluste, pakkumuste või ideekavandite esitamise tähtpäeva. Väljaannete talitusele edastatavat teadet ei saa muuta hiljem kui 48 tundi enne taotluste, pakkumuste või ideekavandite esitamise tähtpäeva. 4 (4) Registris avaldatud hankelepingu sõlmimise teadet ja ideekonkursi tulemusi võib hankija muuta selliselt, et muudatused avaldatakse registris hiljemalt andmete registri arhiivi kandmise päevale eelneval tööpäeval. Registris avaldatud hankelepingu sõlmimise teadet ja ideekonkursi tulemusi võib hankija muuta selliselt, et muudatused avaldatakse registris hiljemalt andmete registri arhiivi kandmise päevale eelneval tööpäeval.",
      "rdfs:label": {
        "@value": "Reg_1039853_Par_18 (redaktsioon 1039853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039853",
      "estleg:sourceAct": "Riigihangete registri põhimäärus",
      "estleg:provisionRef": "Reg_1039853 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039853_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039853_Par_19_v1039853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039853_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Esitatud andmete õigsuse ja õiguspärasuse eest vastutab andmete esitaja. Esitatud andmete õigsuse ja õiguspärasuse eest vastutab andmete esitaja. 2 (2) Kui hankija esitatud andmed on ilmselt vastuolus riigihangete seaduses sätestatud nõuetega või väljaannete talitusele saadetavas teates § 16 lõikes 5 viidatud vormi ja korraga, võib registri vastutav töötleja saata andmed esitanud hankijale vastavasisulise teate enne nende andmete avaldamist või § 16 lõikes 5 nimetatud juhul enne andmete edastamist väljaannete talitusele. Kui hankija esitatud andmed on ilmselt vastuolus riigihangete seaduses sätestatud nõuetega või väljaannete talitusele saadetavas teates § 16 lõikes 5 viidatud vormi ja korraga, võib registri vastutav töötleja saata andmed esitanud hankijale vastavasisulise teate enne nende andmete avaldamist või § 16 lõikes 5 nimetatud juhul enne andmete edastamist väljaannete talitusele.",
      "rdfs:label": {
        "@value": "Reg_1039853_Par_19 (redaktsioon 1039853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039853",
      "estleg:sourceAct": "Riigihangete registri põhimäärus",
      "estleg:provisionRef": "Reg_1039853 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039853_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039853_Par_2_v1039853",
      "@type": [
        "owl:NamedIndividual",
