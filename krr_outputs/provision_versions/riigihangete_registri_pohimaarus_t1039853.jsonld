      },
      "estleg:versionText": "Registrisse esitatakse vaidlustusmenetluse kohta vaidlustuse, vaidlustuse esitaja, tema esindaja ja vaidlustuse läbivaatamisega seotud andmed ning otsus. Registrisse esitatakse vaidlustusmenetluse kohta vaidlustuse, vaidlustuse esitaja, tema esindaja ja vaidlustuse läbivaatamisega seotud andmed ning otsus.",
      "rdfs:label": {
        "@value": "Reg_1039853_Par_15 (redaktsioon 1039853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039853",
