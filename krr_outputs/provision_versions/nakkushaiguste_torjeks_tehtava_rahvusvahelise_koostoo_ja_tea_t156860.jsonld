      "estleg:provisionRef": "Reg_156860 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156860_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156860_Par_4_v156860",
      "@type": [
