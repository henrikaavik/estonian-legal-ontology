      "estleg:provisionRef": "Reg_1030422 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030422_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030422_Par_5_v1030422",
