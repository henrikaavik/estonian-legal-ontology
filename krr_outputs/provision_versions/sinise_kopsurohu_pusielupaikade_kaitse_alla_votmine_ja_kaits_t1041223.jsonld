      "dc:source": "Sinise kopsurohu püsielupaikade kaitse alla võtmine ja kaitse-eeskiri"
    },
    {
      "@id": "estleg:Reg_1041223_Par_1_v1041223",
      "@type": [
        "owl:NamedIndividual",
