      "estleg:versionValidFrom": {
        "@value": "2019-08-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 13.10.2010. a käskkirjaga nr 1491 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas2. Määruse menetlus viidi läbi keskkonnaministri 13.10.2010. a käskkirjaga nr 1491 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas2.",
      "rdfs:label": {
        "@value": "Reg_1041223_Par_7 (redaktsioon 1041223)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041223",
