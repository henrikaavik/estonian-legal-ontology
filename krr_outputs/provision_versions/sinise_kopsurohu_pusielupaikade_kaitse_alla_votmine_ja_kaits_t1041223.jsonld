    {
      "@id": "estleg:Reg_1041223_Par_7_v1041223",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041223_Par_7"
