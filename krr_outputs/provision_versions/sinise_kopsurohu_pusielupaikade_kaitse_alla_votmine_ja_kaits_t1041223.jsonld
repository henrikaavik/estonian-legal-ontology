    {
      "@id": "estleg:Reg_1041223_Par_4_v1041223",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041223_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndi piiride kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndi piiride kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1041223_Par_4 (redaktsioon 1041223)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041223",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041223",
      "estleg:sourceAct": "Sinise kopsurohu püsielupaikade kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1041223 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041223_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1041223_Par_5_v1041223",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041223_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sinise kopsurohu püsielupaikade maa-ala kuulub sihtkaitsevööndisse. Sinise kopsurohu püsielupaikade maa-ala kuulub sihtkaitsevööndisse. 2 (2) Püsielupaigas kehtib looduskaitseseaduses sätestatud kaitsekord käesoleva määruse erisustega. Püsielupaigas kehtib looduskaitseseaduses sätestatud kaitsekord käesoleva määruse erisustega. 3 (3) Püsielupaigas on lubatud: 1 1) inimeste viibimine; 2 2) marjade, seente ja muude metsa kõrvalsaaduste korjamine; 3 3) jahipidamine; 4 4) sõiduki ja maastikusõidukiga sõitmine järelevalve- ja päästetöödel, püsielupaiga kaitse korraldamise ja valitsemisega seotud tegevusel, püsielupaiga valitseja nõusolekul teostataval teadustegevusel ning kaitse-eeskirjaga lubatud töödel. Püsielupaigas on lubatud: inimeste viibimine; marjade, seente ja muude metsa kõrvalsaaduste korjamine; jahipidamine; sõiduki ja maastikusõidukiga sõitmine järelevalve- ja päästetöödel, püsielupaiga kaitse korraldamise ja valitsemisega seotud tegevusel, püsielupaiga valitseja nõusolekul teostataval teadustegevusel ning kaitse-eeskirjaga lubatud töödel. 4 (4) Püsielupaiga valitseja nõusolekul on lubatud: 1 1) koosluste kujundamine vastavalt sinise kopsurohu kaitse eesmärgile arvestusega, et puurinnet on lubatud harvendada kuni täiuseni 0,6, põõsarinnet on lubatud harvendada kuni liituvuseni 0,5, keelatud on puidu kokku- ja väljavedu külmumata pinnaselt ning raiutud puud ja põõsad tuleb eemaldada hiljemalt 10 päeva jooksul pärast raiumist; 2 2) tootmisotstarbeta rajatise püstitamine püsielupaiga tarbeks ja olemasolevate rajatiste hooldustööd; 3 3) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus. Püsielupaiga valitseja nõusolekul on lubatud: koosluste kujundamine vastavalt sinise kopsurohu kaitse eesmärgile arvestusega, et puurinnet on lubatud harvendada kuni täiuseni 0,6, põõsarinnet on lubatud harvendada kuni liituvuseni 0,5, keelatud on puidu kokku- ja väljavedu külmumata pinnaselt ning raiutud puud ja põõsad tuleb eemaldada hiljemalt 10 päeva jooksul pärast raiumist; tootmisotstarbeta rajatise püstitamine püsielupaiga tarbeks ja olemasolevate rajatiste hooldustööd; kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus.",
      "rdfs:label": {
        "@value": "Reg_1041223_Par_5 (redaktsioon 1041223)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041223",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041223",
      "estleg:sourceAct": "Sinise kopsurohu püsielupaikade kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1041223 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041223_Map_2026"
      }
    },
