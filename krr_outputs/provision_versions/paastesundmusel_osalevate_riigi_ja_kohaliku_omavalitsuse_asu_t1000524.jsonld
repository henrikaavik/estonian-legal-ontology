    {
      "@id": "estleg:Reg_1000524_Par_3_v1000524",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000524_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Asutuste ning isikute päästesündmuse lahendamisele kaasamise vajaduse otsustab päästetöö juht. Asutuste ning isikute päästesündmuse lahendamisele kaasamise vajaduse otsustab päästetöö juht. 2 (2) Asutuste ning isikute kaasamisel päästesündmuse lahendamisele lähtutakse „Halduskoostöö seadusest” „Päästeseadusest” tulenevate erisustega. Asutuste ning isikute kaasamisel päästesündmuse lahendamisele lähtutakse „Halduskoostöö seadusest” „Päästeseadusest” tulenevate erisustega. 3 (3) Ametiabi taotluse asutuse ning isiku kaasamiseks päästesündmuse lahendamisele edastab kaasatud asutusele ning isikule päästetöö juht, Häirekeskus või Siseministeeriumi teabe- ja analüüsiosakond. Ametiabi taotluse asutuse ning isiku kaasamiseks päästesündmuse lahendamisele edastab kaasatud asutusele ning isikule päästetöö juht, Häirekeskus või Siseministeeriumi teabe- ja analüüsiosakond.",
      "rdfs:label": {
        "@value": "Reg_1000524_Par_3 (redaktsioon 1000524)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000524",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000524",
      "estleg:sourceAct": "Päästesündmusel osalevate riigi- ja kohaliku omavalitsuse asutuste ning isikute koostöö kord",
      "estleg:provisionRef": "Reg_1000524 § 3",
