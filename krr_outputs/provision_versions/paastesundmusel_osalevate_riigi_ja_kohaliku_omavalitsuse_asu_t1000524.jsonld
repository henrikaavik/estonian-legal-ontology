      }
    },
    {
      "@id": "estleg:Reg_1000524_Par_8_v1000524",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000524_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Avalikkust teavitab päästesündmusest Päästeamet. Avalikkust teavitab päästesündmusest Päästeamet. 2 (2) Päästeamet kooskõlastab päästesündmuse lahendamisele kaasatud asutustega avalikkusele suunatud teabe selle osa, mis vastavaid asutusi puudutab. Päästeamet kooskõlastab päästesündmuse lahendamisele kaasatud asutustega avalikkusele suunatud teabe selle osa, mis vastavaid asutusi puudutab. 3 (3) Päästesündmuse lahendamisele kaasatud asutuste avalikkusele suunatud teave tuleb kooskõlastada Päästeametiga. RT I 2011-12-29 138 129122011138 2012-01-01 Päästesündmuse lahendamisele kaasatud asutuste avalikkusele suunatud teave tuleb kooskõlastada Päästeametiga.",
      "rdfs:label": {
