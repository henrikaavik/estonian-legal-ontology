      "estleg:provisionRef": "Reg_1036066 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036066_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036066_Par_12_v1036066",
      "@type": [
