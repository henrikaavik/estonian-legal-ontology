      "estleg:provisionRef": "Reg_1036066 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036066_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036066_Par_5_v1036066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036066_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Radioaktiivsete jäätmete töötlemisel ja konditsioneerimisel jäätmete tekkekohas eelistab kiirgustegevusloa omaja piisavalt testitud tehnoloogiaid, arvestab kiirgusohutushinnangute alusel kiirguskaitse optimeerimise nõudeid ning radioaktiivsete jäätmete käitleja määratud jäätmepakendi vastavusnäitajate suurusi. Radioaktiivsete jäätmete töötlemisel ja konditsioneerimisel jäätmete tekkekohas eelistab kiirgustegevusloa omaja piisavalt testitud tehnoloogiaid, arvestab kiirgusohutushinnangute alusel kiirguskaitse optimeerimise nõudeid ning radioaktiivsete jäätmete käitleja määratud jäätmepakendi vastavusnäitajate suurusi.",
      "rdfs:label": {
        "@value": "Reg_1036066_Par_5 (redaktsioon 1036066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036066",
      "estleg:sourceAct": "Radioaktiivsete jäätmete klassifikatsioon, registreerimise, käitlemise ja üleandmise nõuded ning radioaktiivsete jäätmete pakendi vastavusnäitajad",
      "estleg:provisionRef": "Reg_1036066 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036066_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036066_Par_6_v1036066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036066_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Radioaktiivsed jäätmed ladustatakse jäätmete tekitaja juures lühiealiste radionukliidide radioaktiivse lagunemise tagamiseks või käitlejale üleandmiseks sobivate jäätmekoguste kogumiseks. Radioaktiivsed jäätmed ladustatakse jäätmete tekitaja juures lühiealiste radionukliidide radioaktiivse lagunemise tagamiseks või käitlejale üleandmiseks sobivate jäätmekoguste kogumiseks. 2 (2) Radioaktiivsete jäätmete hoiuruumis peab olema valgustus, valve- ja tuletõrjesignalisatsioon ning ventilatsioon. Ventilatsiooni projekteerimisel arvestatakse hoiuruumis ladustatavates jäätmetes sisalduvate radionukliidide füüsikalis-keemilisi omadusi ning töötervishoiu ja tööohutuse seaduses sätestatud nõudeid töökeskkonnale. Radioaktiivsete jäätmete hoiuruumis peab olema valgustus, valve- ja tuletõrjesignalisatsioon ning ventilatsioon. Ventilatsiooni projekteerimisel arvestatakse hoiuruumis ladustatavates jäätmetes sisalduvate radionukliidide füüsikalis-keemilisi omadusi ning töötervishoiu ja tööohutuse seaduses sätestatud nõudeid töökeskkonnale.",
      "rdfs:label": {
        "@value": "Reg_1036066_Par_6 (redaktsioon 1036066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036066",
      "estleg:sourceAct": "Radioaktiivsete jäätmete klassifikatsioon, registreerimise, käitlemise ja üleandmise nõuded ning radioaktiivsete jäätmete pakendi vastavusnäitajad",
      "estleg:provisionRef": "Reg_1036066 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036066_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036066_Par_7_v1036066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036066_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Radioaktiivsete jäätmete vaheladustamise eesmärk on radioaktiivsete jäätmete ettevalmistamine lõppladustamiseks. Vaheladustamine käitleja juures ei ole ajaliselt piiratud. Radioaktiivsete jäätmete vaheladustamise eesmärk on radioaktiivsete jäätmete ettevalmistamine lõppladustamiseks. Vaheladustamine käitleja juures ei ole ajaliselt piiratud. 2 (2) Radioaktiivsete jäätmete vaheladustuskohas peavad lisaks käesoleva määruse § 4 lõigetes 2 ja 3 loetletud radioaktiivsete jäätmete ladustamise tingimustele olema tagatud ka järgmised tingimused: 1 1) vaheladustuskoht on kaitstud asjaomase loata isikute sissepääsu ja radioaktiivsete jäätmete lubamatu kasutamise eest; 2 2) vaheladustuskoht on kiirgusohutuse tagamiseks varustatud kiirguskaitse ja -seire vahenditega; 3 3) kõik pinnad on valmistatud kergesti puhastatavatest materjalidest; 4 4) kui ladustamise kestel vabanevad jäätmetest radioaktiivsed gaasid või aerosoolid, on vaheladustuskoht varustatud õhupuhastussüsteemi ja õhuseire vahenditega; 5 5) ekspluatatsioon on ohutu ja jäätmekonteinerid või -pakendid on käitlemisele või lõppladustamisele transportimiseks kergesti kättesaadavad. Radioaktiivsete jäätmete vaheladustuskohas peavad lisaks käesoleva määruse § 4 lõigetes 2 ja 3 loetletud radioaktiivsete jäätmete ladustamise tingimustele olema tagatud ka järgmised tingimused: vaheladustuskoht on kaitstud asjaomase loata isikute sissepääsu ja radioaktiivsete jäätmete lubamatu kasutamise eest; vaheladustuskoht on kiirgusohutuse tagamiseks varustatud kiirguskaitse ja -seire vahenditega; kõik pinnad on valmistatud kergesti puhastatavatest materjalidest; kui ladustamise kestel vabanevad jäätmetest radioaktiivsed gaasid või aerosoolid, on vaheladustuskoht varustatud õhupuhastussüsteemi ja õhuseire vahenditega; ekspluatatsioon on ohutu ja jäätmekonteinerid või -pakendid on käitlemisele või lõppladustamisele transportimiseks kergesti kättesaadavad.",
      "rdfs:label": {
        "@value": "Reg_1036066_Par_7 (redaktsioon 1036066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036066",
      "estleg:sourceAct": "Radioaktiivsete jäätmete klassifikatsioon, registreerimise, käitlemise ja üleandmise nõuded ning radioaktiivsete jäätmete pakendi vastavusnäitajad",
      "estleg:provisionRef": "Reg_1036066 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036066_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036066_Par_8_v1036066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036066_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jäätmepakendi mehaanilised omadused peavad tagama pakendi kuju ja gabariitide säilimise käitlemise igas faasis, sealhulgas näiteks veol, ladustamisel ja väljavõtmisel. Jäätmepakendi mehaanilised omadused peavad tagama pakendi kuju ja gabariitide säilimise käitlemise igas faasis, sealhulgas näiteks veol, ladustamisel ja väljavõtmisel. 2 (2) Jäätmepakendi füüsikalised omadused peavad tagama selle komponentide sealhulgas konteineri, jäätmevormi ja barjääri vastastikuse sobivuse ja kogu terviku sobivuse keskkonnaga jäätmepakendi järgneva käitlemise igas faasis. Jäätmepakendi füüsikalised omadused peavad tagama selle komponentide sealhulgas konteineri, jäätmevormi ja barjääri vastastikuse sobivuse ja kogu terviku sobivuse keskkonnaga jäätmepakendi järgneva käitlemise igas faasis. 3 (3) Jäätmepakendi iga komponendi keemilised omadused peavad välistama komponentide vahel igasuguse keemilise reaktsiooni, mis võiks halvendada ohutust järgneva käitlemise igas faasis. Jäätmepakendi iga komponendi keemilised omadused peavad välistama komponentide vahel igasuguse keemilise reaktsiooni, mis võiks halvendada ohutust järgneva käitlemise igas faasis. 4 (4) Jäätmepakendi bioloogilised omadused peavad järgneva käitlemise kestel tagama jäätmepakendi vastupidavuse radioaktiivsetes jäätmetes olevate mikroorganismide kahjustustele. Jäätmepakendi bioloogilised omadused peavad järgneva käitlemise kestel tagama jäätmepakendi vastupidavuse radioaktiivsetes jäätmetes olevate mikroorganismide kahjustustele. 5 (5) Kui jäätmepakend sisaldab lõhustuvaid aineid, rakendatakse vajalikke meetmeid ahelreaktsiooni tekkimise vältimiseks. Kui jäätmepakend sisaldab lõhustuvaid aineid, rakendatakse vajalikke meetmeid ahelreaktsiooni tekkimise vältimiseks. 6 (6) Igale jäätmepakendile omistatakse identifitseerimiskood, mis on ühetähenduslikult seostatav kiirgustegevusloa omaja radioaktiivsete jäätmete arvestusega. Igale jäätmepakendile omistatakse identifitseerimiskood, mis on ühetähenduslikult seostatav kiirgustegevusloa omaja radioaktiivsete jäätmete arvestusega. 7 (7) Kiirgustegevusloa omaja kontrollib jäätmepakendi vastavust käesoleva paragrahvi lõigetes 1–6 esitatud nõuetele: 1 1) kolm aastat pärast jäätmepakendi valmistamist; 2 2) edaspidi kogu vaheladustamise kestel iga kümne aasta möödumisel. Kiirgustegevusloa omaja kontrollib jäätmepakendi vastavust käesoleva paragrahvi lõigetes 1–6 esitatud nõuetele: kolm aastat pärast jäätmepakendi valmistamist; edaspidi kogu vaheladustamise kestel iga kümne aasta möödumisel.",
      "rdfs:label": {
        "@value": "Reg_1036066_Par_8 (redaktsioon 1036066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036066",
      "estleg:sourceAct": "Radioaktiivsete jäätmete klassifikatsioon, registreerimise, käitlemise ja üleandmise nõuded ning radioaktiivsete jäätmete pakendi vastavusnäitajad",
      "estleg:provisionRef": "Reg_1036066 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036066_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036066_Par_9_v1036066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036066_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jäätmepakendi vastavusnäitajad on: 1 1) mass; 2 2) niiskus ja vaba vedeliku sisaldus; 3 3) alfa- ja beeta- või gammakiirgust kiirgavate radionukliidide summaarne aktiivsus; 4 4) jäätmepakendi radionukliidide maksimaalne eriaktiivsus; 5 5) pakendi välispinna maksimaalne radioaktiivne saastumine; 6 6) maksimaalne doosikiirus pakendi pinnal ja 1 m kaugusel pakendist. Jäätmepakendi vastavusnäitajad on: mass; niiskus ja vaba vedeliku sisaldus; alfa- ja beeta- või gammakiirgust kiirgavate radionukliidide summaarne aktiivsus; jäätmepakendi radionukliidide maksimaalne eriaktiivsus; pakendi välispinna maksimaalne radioaktiivne saastumine; maksimaalne doosikiirus pakendi pinnal ja 1 m kaugusel pakendist. 2 (2) Radioaktiivsete jäätmete käitleja määrab kindlaks käesoleva paragrahvi lõikes 1 nimetatud näitajate suurused, võttes arvesse jäätmete omadusi, konditsioneerimise viisi ning ohte, mis on seotud jäätmepakendi käitlemisel juhtuda võivate avariidega. Radioaktiivsete jäätmete käitleja määrab kindlaks käesoleva paragrahvi lõikes 1 nimetatud näitajate suurused, võttes arvesse jäätmete omadusi, konditsioneerimise viisi ning ohte, mis on seotud jäätmepakendi käitlemisel juhtuda võivate avariidega.",
      "rdfs:label": {
        "@value": "Reg_1036066_Par_9 (redaktsioon 1036066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036066",
      "estleg:sourceAct": "Radioaktiivsete jäätmete klassifikatsioon, registreerimise, käitlemise ja üleandmise nõuded ning radioaktiivsete jäätmete pakendi vastavusnäitajad",
      "estleg:provisionRef": "Reg_1036066 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036066_Map_2026"
      }
    },
