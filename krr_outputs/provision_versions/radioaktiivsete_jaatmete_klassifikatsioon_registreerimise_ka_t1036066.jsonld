  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_radioaktiivsete_jaatmete_klassifikatsioon_registreerimise_ka_t1036066_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Radioaktiivsete jäätmete klassifikatsioon, registreerimise, käitlemise ja üleandmise nõuded ning radioaktiivsete jäätmete pakendi vastavusnäitajad (12 versiooni)",
        "@language": "et"
      },
      "dc:source": "Radioaktiivsete jäätmete klassifikatsioon, registreerimise, käitlemise ja üleandmise nõuded ning radioaktiivsete jäätmete pakendi vastavusnäitajad"
    },
    {
      "@id": "estleg:Reg_1036066_Par_1_v1036066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036066_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse radioaktiivsete jäätmete klassifikatsioon, radioaktiivsete jäätmete registreerimise, käitlemise ja üleandmise nõuded ning nõuded radioaktiivsete jäätmete pakendile (edaspidi jäätmepakend) ja pakendi vastavusnäitajad. Määrusega kehtestatakse radioaktiivsete jäätmete klassifikatsioon, radioaktiivsete jäätmete registreerimise, käitlemise ja üleandmise nõuded ning nõuded radioaktiivsete jäätmete pakendile (edaspidi jäätmepakend) ja pakendi vastavusnäitajad.",
      "rdfs:label": {
        "@value": "Reg_1036066_Par_1 (redaktsioon 1036066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036066",
      "estleg:sourceAct": "Radioaktiivsete jäätmete klassifikatsioon, registreerimise, käitlemise ja üleandmise nõuded ning radioaktiivsete jäätmete pakendi vastavusnäitajad",
      "estleg:provisionRef": "Reg_1036066 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036066_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036066_Par_10_v1036066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036066_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Radioaktiivsete jäätmete tekitaja koostab radioaktiivsete jäätmete käitluskohta üle antavate radioaktiivsete jäätmete üleandmis-vastuvõtmisakti (edaspidi akt) kolmes eksemplaris, millest ühe jätab endale, teise annab kaasa üleandmisele kuuluvate radioaktiivsete jäätmetega ja kolmanda saadab Keskkonnaametile, kes registreerib aktis sisalduvate radioaktiivsete jäätmete üleandmise radioaktiivsete jäätmete käitluskohta kiirgusallikate ja tuumamaterjali registris. Radioaktiivsete jäätmete tekitaja koostab radioaktiivsete jäätmete käitluskohta üle antavate radioaktiivsete jäätmete üleandmis-vastuvõtmisakti (edaspidi akt) kolmes eksemplaris, millest ühe jätab endale, teise annab kaasa üleandmisele kuuluvate radioaktiivsete jäätmetega ja kolmanda saadab Keskkonnaametile, kes registreerib aktis sisalduvate radioaktiivsete jäätmete üleandmise radioaktiivsete jäätmete käitluskohta kiirgusallikate ja tuumamaterjali registris. 2 (2) Akt sisaldab radioaktiivsete jäätmete kohta järgmisi andmeid: 1 1) nimetus ja kirjeldus; 2 2) jäätmepakendi liik; 3 3) jäätmepakendi tunnusnumber; 4 4) radionukliidide nimetused; 5 5) mass; 6 6) aktiivsus jäätmepakendis; 7 7) radionukliidide summaarne alfa-, beeta- ja gammaaktiivsus. Akt sisaldab radioaktiivsete jäätmete kohta järgmisi andmeid: nimetus ja kirjeldus; jäätmepakendi liik; jäätmepakendi tunnusnumber; radionukliidide nimetused; mass; aktiivsus jäätmepakendis; radionukliidide summaarne alfa-, beeta- ja gammaaktiivsus. 3 (3) Põhjendatud kahtluse korral, et üle antavad radioaktiivsed jäätmed ei vasta aktis kirjeldatule, on radioaktiivsete jäätmete käitluskoha operaatoril õigus jätta need jäätmed vastu võtmata. Põhjendatud kahtluse korral, et üle antavad radioaktiivsed jäätmed ei vasta aktis kirjeldatule, on radioaktiivsete jäätmete käitluskoha operaatoril õigus jätta need jäätmed vastu võtmata.",
      "rdfs:label": {
        "@value": "Reg_1036066_Par_10 (redaktsioon 1036066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036066",
      "estleg:sourceAct": "Radioaktiivsete jäätmete klassifikatsioon, registreerimise, käitlemise ja üleandmise nõuded ning radioaktiivsete jäätmete pakendi vastavusnäitajad",
      "estleg:provisionRef": "Reg_1036066 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036066_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036066_Par_11_v1036066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036066_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Radioaktiivsete jäätmete inventuuriaruanded registreeritakse keskkonnaotsuste infosüsteemis. RT I 2022-06-27 1 127062022001 2022-06-30 Radioaktiivsete jäätmete inventuuriaruanded registreeritakse keskkonnaotsuste infosüsteemis. 2 (2) Kiirgustegevusloa omaja korraldab üks kord aastas radioaktiivsete jäätmete inventuuri ja esitab keskkonnaotsuste infosüsteemi kaudu inventuuriaruande, mis sisaldab käesoleva määruse § 10 lõikes 2 loetletud andmeid, hiljemalt aruandeaastale järgneva aasta 1. märtsiks. RT I 2022-06-27 1 127062022001 2022-06-30 Kiirgustegevusloa omaja korraldab üks kord aastas radioaktiivsete jäätmete inventuuri ja esitab keskkonnaotsuste infosüsteemi kaudu inventuuriaruande, mis sisaldab käesoleva määruse § 10 lõikes 2 loetletud andmeid, hiljemalt aruandeaastale järgneva aasta 1. märtsiks. 3 (3) Kiirgustegevusloa omaja säilitab kõiki radioaktiivsete jäätmete tekkimise ja käitlemise andmeid vähemalt viis aastat pärast radioaktiivsete jäätmete vabastamist või üleandmist radioaktiivsete jäätmete käitluskohta. Kiirgustegevusloa omaja säilitab kõiki radioaktiivsete jäätmete tekkimise ja käitlemise andmeid vähemalt viis aastat pärast radioaktiivsete jäätmete vabastamist või üleandmist radioaktiivsete jäätmete käitluskohta. 4 (4) Radioaktiivsete jäätmete käitluskohas säilitatakse andmeid seal olevate radioaktiivsete jäätmete kohta tähtajatult. Radioaktiivsete jäätmete käitluskohas säilitatakse andmeid seal olevate radioaktiivsete jäätmete kohta tähtajatult.",
      "rdfs:label": {
        "@value": "Reg_1036066_Par_11 (redaktsioon 1036066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036066",
