    },
    {
      "@id": "estleg:Reg_309645_Par_18_v309645",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309645_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) maavara kaevandamine; 3 3) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 4 4) uue maaparandussüsteemi rajamine; 5 5) biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal; 6 6) puidu kokku- ja väljavedu külmumata pinnasel; 7 7) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus. Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; uue maaparandussüsteemi rajamine; biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal; puidu kokku- ja väljavedu külmumata pinnasel; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus.",
      "rdfs:label": {
        "@value": "Reg_309645_Par_18 (redaktsioon 309645)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309645",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309645",
      "estleg:sourceAct": "Rahuste looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_309645 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_309645_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_309645_Par_2_v309645",
