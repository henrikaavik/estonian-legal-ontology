      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309645",
      "estleg:sourceAct": "Rahuste looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_309645 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_309645_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_309645_Par_16_v309645",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309645_Par_16"
      },
