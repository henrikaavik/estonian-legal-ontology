    {
      "@id": "estleg:Reg_1014554_Par_10_v1014554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014554_Par_10"
