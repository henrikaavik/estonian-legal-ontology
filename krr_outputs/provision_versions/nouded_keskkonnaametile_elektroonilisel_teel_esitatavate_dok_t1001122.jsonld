      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded Keskkonnaametile elektroonilisel teel esitatavate dokumentide vormingu ja allkirjastamise kohta, elektroonilise teabevahetuse kohta ning automaatsete haldusaktide ja dokumentide loetelu (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded Keskkonnaametile elektroonilisel teel esitatavate dokumentide vormingu ja allkirjastamise kohta, elektroonilise teabevahetuse kohta ning automaatsete haldusaktide ja dokumentide loetelu"
    },
    {
      "@id": "estleg:Reg_1001122_Par_1_v1001122",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001122_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Keskkonnatasu deklaratsioonide, aruannete ja muude keskkonnakasutusega seotud dokumentide Keskkonnaametile elektrooniliseks esitamiseks peab isik või asutus sõlmima käesoleva määruse §-le 2 vastava e-keskkonnaameti kasutamise lepingu, järgima käesolevas määruses ja e-keskkonnaameti kasutamise lepingus seatud tingimusi ja nõudeid ning Keskkonnaameti peadirektori kinnitatud ja Keskkonnaameti veebilehel avaldatud e-keskkonnaameti kasutajajuhendit (edaspidi kasutajajuhend). Keskkonnatasu deklaratsioonide, aruannete ja muude keskkonnakasutusega seotud dokumentide Keskkonnaametile elektrooniliseks esitamiseks peab isik või asutus sõlmima käesoleva määruse §-le 2 vastava e-keskkonnaameti kasutamise lepingu, järgima käesolevas määruses ja e-keskkonnaameti kasutamise lepingus seatud tingimusi ja nõudeid ning Keskkonnaameti peadirektori kinnitatud ja Keskkonnaameti veebilehel avaldatud e-keskkonnaameti kasutajajuhendit (edaspidi kasutajajuhend). 2 (2) E-keskkonnaamet on interneti kaudu kasutatav digitaalne keskkond elektrooniliste teenuste pakkumiseks avalikkusele. E-keskkonnaamet on interneti kaudu kasutatav digitaalne keskkond elektrooniliste teenuste pakkumiseks avalikkusele.",
      "rdfs:label": {
        "@value": "Reg_1001122_Par_1 (redaktsioon 1001122)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001122",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001122",
