    {
      "@id": "estleg:Reg_327730_Par_10_v327730",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_327730_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-11-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva menetluse jõustumist eraldatud piiratud liiklusõigused kehtivad kolm aastat pärast käesoleva menetluse jõustumist.<table summary=\"allkiri\" width=\"100%\"> <tbody><tr valign=\"top\"> <td width=\"60%\"> </td> <td width=\"39%\"> <b><font size=\"-1\" style=\"font-size:-1px\">Minister Juhan PARTS</font></b> </td> </tr> </tbody></table><table summary=\"allkiri\" width=\"100%\"> <tbody><tr valign=\"top\"> <td width=\"60%\"> </td> <td width=\"39%\"> <b><font size=\"-1\" style=\"font-size:-1px\">Kantsler Marika PRISKE</font></b> </td> </tr> </tbody></table> Enne käesoleva menetluse jõustumist eraldatud piiratud liiklusõigused kehtivad kolm aastat pärast käesoleva menetluse jõustumist.",
      "rdfs:label": {
        "@value": "Reg_327730_Par_10 (redaktsioon 327730)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "327730",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/327730",
      "estleg:sourceAct": "Liiklusõiguste jaotamise menetlus",
      "estleg:provisionRef": "Reg_327730 § 10",
      "estleg:partOfAct": {
