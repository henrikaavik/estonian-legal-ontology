  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_asendustaitmise_kulude_arvutamise_kord_ja_asendustaitmise_la_t153649_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord"
    },
    {
      "@id": "estleg:Reg_153649_Par_1_v153649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153649_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib: 1) asendustäitmise kulude arvutamise korda; 2) asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärasid; 3) hüvitise maksmist isikule, kellele on tekitatud asendustäitmist rakendades õiguspäraselt kahju; 4) asendustäitmise eeldatavate kulude ettemaksuna sissenõudmise ja tasaarvelduse korda.",
      "rdfs:label": {
        "@value": "Reg_153649_Par_1 (redaktsioon 153649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153649",
      "estleg:sourceAct": "Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord",
      "estleg:provisionRef": "Reg_153649 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153649_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153649_Par_2_v153649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153649_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui asendustäitmise teostab haldusorgan, loetakse asendustäitmise kulude hulka tegelikult läbi viidud toimingute kulu vastavalt asendustäitmise protokollis fikseeritud asendustäitetoimingute sisule. Arvestusliku kulu suurus peab olema põhjendatud ning vastama tegelikule olukorrale.",
      "rdfs:label": {
        "@value": "Reg_153649_Par_2 (redaktsioon 153649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153649",
      "estleg:sourceAct": "Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord",
      "estleg:provisionRef": "Reg_153649 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153649_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153649_Par_3_v153649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153649_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui asendustäitmise teostab kolmas isik, loetakse asendustäitmise kulude hulka tegelikult läbi viidud toimingute kulu vastavalt asendustäitmise protokollis fikseeritud asendustäitetoimingute sisule. (2) Asendustäitmise läbi viinud kolmas isik peab haldusorgani nõudel lõikes 1 nimetatud kulusid dokumentaalselt tõendama. (3) Asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmääraks on asendustäitmise toimingute sooritamise eest makstav kohalik keskmine turuhind.",
      "rdfs:label": {
        "@value": "Reg_153649_Par_3 (redaktsioon 153649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153649",
      "estleg:sourceAct": "Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord",
      "estleg:provisionRef": "Reg_153649 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153649_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153649_Par_4_v153649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153649_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asendustäitmise käigus isikule õiguspäraselt tekitatud kahju hüvitatakse sõltumata sellest, kas asendustäitmist viib läbi haldusorgan või selleks volitatud kolmas isik. (2) Hüvitise suuruse määramine ja maksmine toimub «Riigivastutuse seaduse» (RT I 2001, 47, 260) §-des 16-18 sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_153649_Par_4 (redaktsioon 153649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153649",
      "estleg:sourceAct": "Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord",
      "estleg:provisionRef": "Reg_153649 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153649_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153649_Par_5_v153649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153649_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asendustäitmise kogukulu on §-des 2 või 3 (sõltuvalt asendustäitmise läbiviijast) sätestatud kulu ja §-s 4 sätestatud hüvitise summa. (2) Asendustäitmise kogukulu nõuab asendustäitmist rakendanud haldusorgan adressaadilt sisse üldjuhul pärast asendustäitmist.",
      "rdfs:label": {
        "@value": "Reg_153649_Par_5 (redaktsioon 153649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153649",
      "estleg:sourceAct": "Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord",
      "estleg:provisionRef": "Reg_153649 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153649_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153649_Par_6_v153649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153649_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mõjuval põhjusel (sealhulgas, kui asendustäitmise eeldatavad kulud ületavad haldusorgani eelarves selleks ettenähtud vahendeid) võib haldusorgan asendustäitmise eeldatava kulu adressaadilt ettemaksuna sisse nõuda. (2) Ettemaksuna nõutakse sisse asendustäitmist rakendava haldusorgani poolt võimalikult täpselt hinnatud arvestuslik asendustäitmise kogukulu. (3) Kui asendustäitmise kogukulu osutub suuremaks sissenõutud ettemaksust, nõutakse pärast asendustäitmise lõppu puudujääv osa sunnivahendi adressaadilt sisse. (4) Kui asendustäitmise kogukulu osutub väiksemaks sissenõutud ettemaksust, tagastatakse pärast asendustäitmise lõppu ettemaksust ülejäänud osa viivitamata sunnivahendi adressaadile.",
      "rdfs:label": {
        "@value": "Reg_153649_Par_6 (redaktsioon 153649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153649",
      "estleg:sourceAct": "Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord",
      "estleg:provisionRef": "Reg_153649 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153649_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153649_Par_7_v153649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153649_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asendustäitmise kulud nõutakse «Asendustäitmise ja sunniraha seaduse» § 15 lõike 1 alusel sisse nagu kohtuotsusest tulenev rahaline nõue «Täitemenetluse seadustikus» (RT I 1993, 49, 693; 2001, 29, 156; 43, 238) sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_153649_Par_7 (redaktsioon 153649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153649",
      "estleg:sourceAct": "Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord",
      "estleg:provisionRef": "Reg_153649 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153649_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153649_Par_8_v153649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153649_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. jaanuaril 2002. a. Peaminister Mart LAAR Justiitsminister Märt RASK Riigisekretär Aino LEPIK von WIRÉN",
      "rdfs:label": {
        "@value": "Reg_153649_Par_8 (redaktsioon 153649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153649",
      "estleg:sourceAct": "Asendustäitmise kulude arvutamise kord ja asendustäitmise läbi viinud kolmandale isikule makstava tasu piirmäärad ning tasu maksmise ja tasaarvelduse kord",
      "estleg:provisionRef": "Reg_153649 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153649_Map_2026"
      }
    },
