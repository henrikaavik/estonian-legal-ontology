      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub Riigi Teatajas avaldamisele järgneval päeval. Riigikogu aseesimees Tunne Kelam",
