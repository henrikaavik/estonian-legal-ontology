  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_eestist_labisoidu_abimeetmete_rakendamise_kulude_loetelu_ja__t308998_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eestist läbisõidu abimeetmete rakendamise kulude loetelu ja taotluse esitaja poolt kantavate kulude määrad, väljasaadetava tagasisaatmisega seotud kulude loetelu, kulude määrad ning kulude sissenõudmise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eestist läbisõidu abimeetmete rakendamise kulude loetelu ja taotluse esitaja poolt kantavate kulude määrad, väljasaadetava tagasisaatmisega seotud kulude loetelu, kulude määrad ning kulude sissenõudmise kord"
    },
    {
      "@id": "estleg:Reg_308998_Par_1_v308998",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308998_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljasaatmisel Eestist õhuteed pidi kannab läbisõidu taotleja järgmised läbisõidul osutatud abimeetmete kulud: 1 1) väljasaadetava läbisõidu korraldamisega seotud asjaajamiskulud; 2 2) väljasaadetava ja tema saatja sõidukulud ning majutuse ja toitlustamisega seotud ülalpidamiskulud; 3 3) väljasaadetava konvoeerimiskulud; 4 4) tervishoiuteenuste osutamisega seotud kulud. Väljasaatmisel Eestist õhuteed pidi kannab läbisõidu taotleja järgmised läbisõidul osutatud abimeetmete kulud: väljasaadetava läbisõidu korraldamisega seotud asjaajamiskulud; väljasaadetava ja tema saatja sõidukulud ning majutuse ja toitlustamisega seotud ülalpidamiskulud; väljasaadetava konvoeerimiskulud; tervishoiuteenuste osutamisega seotud kulud.",
      "rdfs:label": {
        "@value": "Reg_308998_Par_1 (redaktsioon 308998)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308998",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308998",
      "estleg:sourceAct": "Eestist läbisõidu abimeetmete rakendamise kulude loetelu ja taotluse esitaja poolt kantavate kulude määrad, väljasaadetava tagasisaatmisega seotud kulude loetelu, kulude määrad ning kulude sissenõudmise kord",
      "estleg:provisionRef": "Reg_308998 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308998_Map"
      }
    },
    {
      "@id": "estleg:Reg_308998_Par_2_v308998",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308998_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljasaadetava Eestist läbisõiduks taotluse esitanud riiki tagasi saatmisel kannab läbisõidu taotleja järgmised väljasaadetava tagasisaatmisega seotud kulud: 1 1) tagasisaatmise korraldamisega seotud asjaajamiskulud; 2 2) väljasaadetava konvoeerimiskulud; 3 3) väljasaadetava ja tema saatja sõidukulud; 4 4) tervishoiuteenuste osutamisega seotud kulud. Väljasaadetava Eestist läbisõiduks taotluse esitanud riiki tagasi saatmisel kannab läbisõidu taotleja järgmised väljasaadetava tagasisaatmisega seotud kulud: tagasisaatmise korraldamisega seotud asjaajamiskulud; väljasaadetava konvoeerimiskulud; väljasaadetava ja tema saatja sõidukulud; tervishoiuteenuste osutamisega seotud kulud.",
      "rdfs:label": {
        "@value": "Reg_308998_Par_2 (redaktsioon 308998)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308998",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308998",
      "estleg:sourceAct": "Eestist läbisõidu abimeetmete rakendamise kulude loetelu ja taotluse esitaja poolt kantavate kulude määrad, väljasaadetava tagasisaatmisega seotud kulude loetelu, kulude määrad ning kulude sissenõudmise kord",
      "estleg:provisionRef": "Reg_308998 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308998_Map"
      }
    },
    {
      "@id": "estleg:Reg_308998_Par_3_v308998",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
