      "estleg:versionValidFrom": {
        "@value": "2018-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 17. mai 2017. a käskkirjaga nr 1-2/17/539 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 17. mai 2017. a käskkirjaga nr 1-2/17/539 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1042684_Par_5 (redaktsioon 1042684)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042684",
