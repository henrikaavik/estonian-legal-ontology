      "estleg:sourceAct": "Tonja-Karisilla-Värska looduspargi kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1042684 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042684_Map"
      }
    },
