    {
      "@id": "estleg:Reg_1042684_Par_5_v1042684",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042684_Par_5"
