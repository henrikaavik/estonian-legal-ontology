      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse Tervisekassa ja Ravimiameti töötaja juurdepääs tervise infosüsteemis olevatele isikuandmetele vaktsiinikahju hüvitamise taotluse menetlemiseks. RT I 2023-05-23 1 123052023001 2023-05-26 Määrusega kehtestatakse Tervisekassa ja Ravimiameti töötaja juurdepääs tervise infosüsteemis olevatele isikuandmetele vaktsiinikahju hüvitamise taotluse menetlemiseks.",
      "rdfs:label": {
        "@value": "Reg_1054080_Par_1 (redaktsioon 1054080)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054080",
