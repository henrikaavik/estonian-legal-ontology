      "dc:source": "Tervisekassa ja Ravimiameti juurdepääs tervise infosüsteemi andmetele vaktsiinikahju hüvitamise taotluse menetlemiseks"
    },
    {
      "@id": "estleg:Reg_1054080_Par_1_v1054080",
