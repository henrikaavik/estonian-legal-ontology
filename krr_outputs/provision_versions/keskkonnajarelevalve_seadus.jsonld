      }
    },
    {
      "@id": "estleg:KeJS_Par_10_v110072020098",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi keskkonnakaitseinspektor on Keskkonnaameti ametnik, kellele järelevalvekohustus on pandud ametijuhendiga.",
      "rdfs:label": {
        "@value": "KeJS_Par_10 (redaktsioon 110072020098)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020098"
    },
    {
      "@id": "estleg:KeJS_Par_11_v27116",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse keskkonnakaitseinspektor on linna- või vallavalitsuse või muu omavalitsusasutuse ametnik, kellele järelevalvekohustus on pandud tööülesannete asutusesisese jaotuse või volikogu otsusega.",
      "rdfs:label": {
        "@value": "KeJS_Par_11 (redaktsioon 27116)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27116"
    },
    {
      "@id": "estleg:KeJS_Par_12_v27116",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi keskkonnakaitseinspektoril on tegutsemisõigus kogu Eesti Vabariigi jurisdiktsiooni all oleval alal ning Eesti Vabariigis registreeritud laevadel, sõltumata nende asukohast. (2) Kohaliku omavalitsuse keskkonnakaitseinspektoril on tegutsemisõigus töökohajärgse omavalitsusüksuse territooriumil.",
      "rdfs:label": {
        "@value": "KeJS_Par_12 (redaktsioon 27116)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27116"
    },
    {
      "@id": "estleg:KeJS_Par_13_v27116",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnakaitseinspektori tegutsemisõigust keskkonna kaitsel tõendab inspektori tõend ja tunnusmärk. (2) Riigi keskkonnakaitseinspektori tõendi vormi ning valmistamise, väljaandmise ja äravõtmise korra kehtestab keskkonnaminister, omavalitsuse keskkonnakaitseinspektori tõendi vormi ning valmistamise, väljaandmise ja äravõtmise korra kehtestab valla- või linnavalitsus. (3) Keskkonnakaitseinspektori tunnusmärk on kõigil inspektoritel ühesugune. Selle kujunduse ning valmistamise, väljaandmise ja äravõtmise korra kehtestab keskkonnaminister.",
      "rdfs:label": {
        "@value": "KeJS_Par_13 (redaktsioon 27116)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27116",
      "estleg:supersededByVersion": {
        "@id": "estleg:KeJS_Par_13_v898524"
      },
      "estleg:versionValidTo": {
        "@value": "2005-05-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KeJS_Par_13_v898524",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi keskkonnakaitseinspektori tegutsemisõigust keskkonna kaitsel tõendavad inspektori tõend ja tunnusmärk. Kohaliku omavalitsuse keskkonnakaitseinspektori tegutsemisõigust keskkonna kaitsel tõendab kohaliku omavalitsuse inspektori tõend. (2) Riigi keskkonnakaitseinspektori tõendi vormi ning valmistamise, väljaandmise ja äravõtmise korra kehtestab keskkonnaminister, omavalitsuse keskkonnakaitseinspektori tõendi vormi ning valmistamise, väljaandmise ja äravõtmise korra kehtestab valla- või linnavalitsus. (3) Riigi keskkonnakaitseinspektori tunnusmärgi kujunduse ning valmistamise, väljaandmise ja äravõtmise korra kehtestab keskkonnaminister.",
      "rdfs:label": {
