    {
      "@id": "estleg:KeJS_Par_14_v27116",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi keskkonnakaitseinspektorile väljastatakse tasuta vormi- ja eririietus. Riigi keskkonnakaitseinspektori vormiriietuse ja ametitunnuste kirjelduse kehtestab Vabariigi Valitsus, vormi- ja eririietuse väljaandmise ja kandmise korra kehtestab keskkonnaminister. Vormi- ja eririietuse valmistamise kulud kaetakse riigieelarvest. (2) Kohaliku omavalitsuse keskkonnakaitseinspektorile väljastatakse vormi- ja eririietus kohaliku omavalitsuse kehtestatud korras ja kujunduses.",
      "rdfs:label": {
        "@value": "KeJS_Par_14 (redaktsioon 27116)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27116",
