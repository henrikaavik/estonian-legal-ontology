      },
      "dc:source": "Keskkonnajärelevalve seadus"
    },
    {
      "@id": "estleg:KeJS_Par_1_v27116",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus määratleb keskkonnajärelevalve olemuse ja kehtestab keskkonnajärelevalvet teostavate, samuti keskkonnajärelevalvele allutatud isikute ning asutuste õigused ja kohustused ning järelevalvetoimingute korra.",
      "rdfs:label": {
        "@value": "KeJS_Par_1 (redaktsioon 27116)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27116",
      "estleg:supersededByVersion": {
        "@id": "estleg:KeJS_Par_1_v185056"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KeJS_Par_1_v185056",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus määratleb keskkonnajärelevalve olemuse ja kehtestab keskkonnajärelevalvet teostavate, samuti keskkonnajärelevalvele allutatud isikute ning asutuste õigused ja kohustused ning järelevalvetoimingute korra. (2) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "KeJS_Par_1 (redaktsioon 185056)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "185056",
      "estleg:supersededByVersion": {
        "@id": "estleg:KeJS_Par_1_v114032014049"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KeJS_Par_1_v114032014049",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus määratleb keskkonnajärelevalve olemuse ja kehtestab keskkonnajärelevalvet teostavate asutuste ülesanded. (2) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "KeJS_Par_1 (redaktsioon 114032014049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014049"
    },
    {
      "@id": "estleg:KeJS_Par_10_v27116",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi keskkonnakaitseinspektor on Keskkonnainspektsiooni, Maa-ameti või muu seaduse alusel keskkonnajärelevalve kohustust omava valitsusasutuse ametnik, kellele järelevalvekohustus on pandud ametijuhendiga.",
      "rdfs:label": {
        "@value": "KeJS_Par_10 (redaktsioon 27116)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27116",
      "estleg:supersededByVersion": {
        "@id": "estleg:KeJS_Par_10_v114032014049"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KeJS_Par_10_v114032014049",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeJS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi keskkonnakaitseinspektor on Keskkonnainspektsiooni või muu seaduse alusel keskkonnajärelevalve kohustust omava valitsusasutuse ametnik, kellele järelevalvekohustus on pandud ametijuhendiga.",
      "rdfs:label": {
        "@value": "KeJS_Par_10 (redaktsioon 114032014049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014049",
