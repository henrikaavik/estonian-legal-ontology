        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kinnipeetu isikliku toimikuga on õigus tutvuda: 1 1) kinnipeetul; 2 2) arestimaja ametnikul; 3 3) kinnipeetu kaitsjal; 4 4) prokuröril; 5 5) teenistusliku järelevalve teostajal; 6 6) uurimisasutuse ametnikul; 7 7) kohtuvälise menetleja ametnikul; 8 8) kohtunikul; 9 9) muul isikul arestimaja juhi või tema määratud ametniku loal. RT I 2011-12-29 72 129122011072 2012-01-01 Kinnipeetu isikliku toimikuga on õigus tutvuda: kinnipeetul; arestimaja ametnikul; kinnipeetu kaitsjal; prokuröril; teenistusliku järelevalve teostajal; uurimisasutuse ametnikul; kohtuvälise menetleja ametnikul; kohtunikul; muul isikul arestimaja juhi või tema määratud ametniku loal. 2 (2) Isikliku toimikuga tutvumise juures viibib arestimaja juhi määratud või isiklike toimikute hoidmise eest vastutav arestimaja ametnik, kes registreerib toimikuga tutvumise kuupäeva, oma nime ja allkirja ning võtab toimikuga tutvunud isikult toimikuga tutvumise kohta allkirja. RT I 2011-12-29 72 129122011072 2012-01-01 Isikliku toimikuga tutvumise juures viibib arestimaja juhi määratud või isiklike toimikute hoidmise eest vastutav arestimaja ametnik, kes registreerib toimikuga tutvumise kuupäeva, oma nime ja allkirja ning võtab toimikuga tutvunud isikult toimikuga tutvumise kohta allkirja. 3 (3) Distsiplinaararesti kandva kaitseväelase isikliku toimikuga on õigus tutvuda kaitseväelasel, arestimaja ametnikul ja kaitseväelase Kaitseväe struktuuriüksuse ülemal või tema volitatud isikul. RT I 2017-05-20 8 120052017008 2017-05-23 Distsiplinaararesti kandva kaitseväelase isikliku toimikuga on õigus tutvuda kaitseväelasel, arestimaja ametnikul ja kaitseväelase Kaitseväe struktuuriüksuse ülemal või tema volitatud isikul.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_21 (redaktsioon 1001404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001404",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001404",
      "estleg:sourceAct": "Arestimaja sisekorraeeskiri",
      "estleg:provisionRef": "Reg_1001404 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001404_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001404_Par_22_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kinnipeetu ümberpaigutamisel teise arestimajja, kinnipidamiskeskusesse või vanglasse, saadetakse sinna ka tema isiklik toimik. RT I 2013-09-28 1 128092013001 2013-10-01 Kinnipeetu ümberpaigutamisel teise arestimajja, kinnipidamiskeskusesse või vanglasse, saadetakse sinna ka tema isiklik toimik. 2 (2) Arestimajast vabastatud või surnud kinnipeetu isiklik toimik paigutatakse Politsei- ja Piirivalveameti arhiivi, kus seda säilitatakse viis aastat. RT I 2011-12-29 72 129122011072 2012-01-01 Arestimajast vabastatud või surnud kinnipeetu isiklik toimik paigutatakse Politsei- ja Piirivalveameti arhiivi, kus seda säilitatakse viis aastat. 3 (3) Isiklik toimik antakse arhiivi üleandmisloetelu alusel. Isiklik toimik antakse arhiivi üleandmisloetelu alusel. 4 (4) Kinnipeetu isiklik toimik arhiveeritakse, hävitatakse või antakse avalikku arhiivi „Arhiiviseaduses” või selle alusel kehtestatud korras. RT I 2011-12-29 72 129122011072 2012-01-01 Kinnipeetu isiklik toimik arhiveeritakse, hävitatakse või antakse avalikku arhiivi „Arhiiviseaduses” või selle alusel kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_22 (redaktsioon 1001404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001404",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001404",
      "estleg:sourceAct": "Arestimaja sisekorraeeskiri",
      "estleg:provisionRef": "Reg_1001404 § 22",
