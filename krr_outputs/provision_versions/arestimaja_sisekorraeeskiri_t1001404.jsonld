    {
      "@id": "estleg:Reg_1001404_Par_67_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Prefekt või arestimaja juht võib keelduda lühiajalise väljaviimise või lühiajalise vabastamise loa andmisest, kui: RT I 2011-12-29 72 129122011072 2012-01-01 28 1 1) taotluses või sellele lisatud dokumentides on teadlikult esitanud valeandmeid; 2 2) kinnipeetule kehtib distsiplinaarkaristus; 3 3) väljaviimise või vabastamise eesmärk on vastuolus arestimajas viibimise asjaoludega; 4 4) distsiplinaararesti kandva kaitseväelase Kaitseväe struktuuriüksuse ülema nõusolek puudub. RT I 2017-05-20 8 120052017008 2017-05-23 Prefekt või arestimaja juht võib keelduda lühiajalise väljaviimise või lühiajalise vabastamise loa andmisest, kui: taotluses või sellele lisatud dokumentides on teadlikult esitanud valeandmeid; kinnipeetule kehtib distsiplinaarkaristus; väljaviimise või vabastamise eesmärk on vastuolus arestimajas viibimise asjaoludega; distsiplinaararesti kandva kaitseväelase Kaitseväe struktuuriüksuse ülema nõusolek puudub.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_67 (redaktsioon 1001404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001404",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001404",
      "estleg:sourceAct": "Arestimaja sisekorraeeskiri",
      "estleg:provisionRef": "Reg_1001404 § 67",
      "estleg:partOfAct": {
