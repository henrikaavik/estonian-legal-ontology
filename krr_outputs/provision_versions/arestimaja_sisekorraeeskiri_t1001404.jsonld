    {
      "@id": "estleg:Reg_1001404_Par_75_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_75"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Distsiplinaarkaristuse määrab prefekt arestimaja juhi või distsiplinaarmenetluse läbi viinud ametniku ettepanekul. Distsiplinaarkaristuse määramine vormistatakse prefekti käskkirjaga, mis antakse kinnipeetule allkirja vastu. Distsiplinaarkaristuse määrab prefekt arestimaja juhi või distsiplinaarmenetluse läbi viinud ametniku ettepanekul. Distsiplinaarkaristuse määramine vormistatakse prefekti käskkirjaga, mis antakse kinnipeetule allkirja vastu. 2 (2) Ühe ja sama distsiplinaarrikkumise eest võib kohaldada ainult üht distsiplinaarkaristust. Kollektiivsed karistused on keelatud. Ühe ja sama distsiplinaarrikkumise eest võib kohaldada ainult üht distsiplinaarkaristust. Kollektiivsed karistused on keelatud. 3 (3) Distsiplinaarkaristuse võib määrata kuue kuu jooksul arvates rikkumise toimepanemise päevast, kuid mitte hiljem kui ühe kuu jooksul rikkumise teadasaamise päevast arvates. Distsiplinaarkaristus määratakse enne kinnipeetu arestimajast vabanemist. Distsiplinaarkaristuse võib määrata kuue kuu jooksul arvates rikkumise toimepanemise päevast, kuid mitte hiljem kui ühe kuu jooksul rikkumise teadasaamise päevast arvates. Distsiplinaarkaristus määratakse enne kinnipeetu arestimajast vabanemist.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_75 (redaktsioon 1001404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001404",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001404",
      "estleg:sourceAct": "Arestimaja sisekorraeeskiri",
      "estleg:provisionRef": "Reg_1001404 § 75",
