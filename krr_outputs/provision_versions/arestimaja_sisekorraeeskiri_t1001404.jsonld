    {
      "@id": "estleg:Reg_1001404_Par_27_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Prefekt kinnitab käskkirjaga arestimaja päevakava, milles sätestatakse kinnipeetu toitlustamise, öörahu jm ajad ning kestus. RT I 2011-12-29 72 129122011072 2012-01-01 Prefekt kinnitab käskkirjaga arestimaja päevakava, milles sätestatakse kinnipeetu toitlustamise, öörahu jm ajad ning kestus. 2 (2) Arestimaja päevakava koostatakse selliselt, et kinnipeetule oleks tagatud vähemalt 8-tunnine pidev uneaeg. Julgeoleku tagamise eesmärgil võib katkestada kinnipeetava uneaega või vabalt kasutatavat aega. Arestimaja päevakava koostatakse selliselt, et kinnipeetule oleks tagatud vähemalt 8-tunnine pidev uneaeg. Julgeoleku tagamise eesmärgil võib katkestada kinnipeetava uneaega või vabalt kasutatavat aega.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_27 (redaktsioon 1001404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001404",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001404",
      "estleg:sourceAct": "Arestimaja sisekorraeeskiri",
      "estleg:provisionRef": "Reg_1001404 § 27",
