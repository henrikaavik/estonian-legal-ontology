      "estleg:sourceAct": "Arestimaja sisekorraeeskiri",
      "estleg:provisionRef": "Reg_1001404 § 68",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001404_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001404_Par_69_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkoha prefektuurile tehakse arestialuse saabumise päev teatavaks vähemalt üks tööpäev enne arestialuse lühiajalise vabastuse algust. Sihtkoha prefektuurile tehakse arestialuse saabumise päev teatavaks vähemalt üks tööpäev enne arestialuse lühiajalise vabastuse algust. 2 (2) Sihtkohta saabumise ja sealt lahkumise päeval on arestialune kohustatud end registreerima kohalikus prefektuuris, mille aadress on tunnistusel. Sihtkohta saabumise ja sealt lahkumise päeval on arestialune kohustatud end registreerima kohalikus prefektuuris, mille aadress on tunnistusel. 3 (3) Registreerimise kohta tehakse tunnistusele märge, mis kinnitatakse pitseriga. 2011-12-22 RT I 2011-12-29 72 129122011072 2012-01-01 28 Registreerimise kohta tehakse tunnistusele märge, mis kinnitatakse pitseriga.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_69 (redaktsioon 1001404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001404",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001404",
      "estleg:sourceAct": "Arestimaja sisekorraeeskiri",
      "estleg:provisionRef": "Reg_1001404 § 69",
