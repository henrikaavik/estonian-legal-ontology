    },
    {
      "@id": "estleg:Reg_1001404_Par_18_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ümberpaigutamise otsus lisatakse kinnipeetu isiklikku toimikusse, välja arvatud ümberpaigutamisel vanglasse. Ümberpaigutamise otsus lisatakse kinnipeetu isiklikku toimikusse, välja arvatud ümberpaigutamisel vanglasse. 2 (2) Arestimaja, kust kinnipeetu ümber paigutatakse, paneb ümberpaigutamise ajaks valmis ümberpaigutatava kinnipeetu isikliku toimiku ja hoiule võetud asjad. Arestimaja, kust kinnipeetu ümber paigutatakse, paneb ümberpaigutamise ajaks valmis ümberpaigutatava kinnipeetu isikliku toimiku ja hoiule võetud asjad. 3 (3) Kinnipeetu paigutatakse ümber esimesel võimalusel. Kinnipeetu paigutatakse ümber esimesel võimalusel. 4 (4) Julgeolekukaalutlustel võib ümberpaigutatavat kinnipeetut hoida kuni ümberpaigutamiseni teistest kinnipeetutest eraldi. Julgeolekukaalutlustel võib ümberpaigutatavat kinnipeetut hoida kuni ümberpaigutamiseni teistest kinnipeetutest eraldi. 5 (5) Põhjendatud juhul võib otsustada kinnipeetu ümberpaigutamise käesolevas peatükis ettenähtud menetlust järgimata. Põhjendatud juhul võib otsustada kinnipeetu ümberpaigutamise käesolevas peatükis ettenähtud menetlust järgimata.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_18 (redaktsioon 1001404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001404",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001404",
