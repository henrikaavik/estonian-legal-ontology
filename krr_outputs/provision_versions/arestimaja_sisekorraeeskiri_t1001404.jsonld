      }
    },
    {
      "@id": "estleg:Reg_1001404_Par_29_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kinnipeetute järelevalve korraldatakse viisil, mis tagab „Vangistusseaduse”, arestimaja sisekorraeeskirja ja arestimaja päevakava täitmise, kinnipeetute julgeoleku ja üldise julgeoleku arestimajas. Kinnipeetute järelevalve korraldatakse viisil, mis tagab „Vangistusseaduse”, arestimaja sisekorraeeskirja ja arestimaja päevakava täitmise, kinnipeetute julgeoleku ja üldise julgeoleku arestimajas. 2 (2) Arestimaja ametnikul on õigus igal ajal kinnipeetu, tema isiklikud asjad ja kamber läbi otsida, et leida keelatud eset või ainet, hoida ära võimalik põgenemiskatse ettevalmistamine ning arestimaja ruumi või inventari rikkumine ja lõhkumine. Kinnipeetu otsib läbi temaga samast soost ametnik, vajadusel kaasatakse toimingusse teenistusloom ja tehniline vahend. Arestimaja ametnikul on õigus igal ajal kinnipeetu, tema isiklikud asjad ja kamber läbi otsida, et leida keelatud eset või ainet, hoida ära võimalik põgenemiskatse ettevalmistamine ning arestimaja ruumi või inventari rikkumine ja lõhkumine. Kinnipeetu otsib läbi temaga samast soost ametnik, vajadusel kaasatakse toimingusse teenistusloom ja tehniline vahend. 3 (3) Arestimaja ametnik teeb läbiotsimise ja selle tulemuse kohta kellaajalise sissekande arestimaja töö arvestuse raamatusse. Arestimaja ametnik teeb läbiotsimise ja selle tulemuse kohta kellaajalise sissekande arestimaja töö arvestuse raamatusse. 4 (4) Kinnipeetute järelevalve täpsema korralduse kehtestab Politsei- ja Piirivalveameti peadirektor. Kinnipeetute järelevalve täpsema korralduse kehtestab Politsei- ja Piirivalveameti peadirektor.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_29 (redaktsioon 1001404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001404",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001404",
      "estleg:sourceAct": "Arestimaja sisekorraeeskiri",
      "estleg:provisionRef": "Reg_1001404 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001404_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001404_Par_3_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arestimajas peetakse kinni järgmisi isikuid: 1 1) arestialused; 2 2) vahistatud; 3 3) kainenema toimetatud isikud; 4 4) sundtoodavad; 5 5) väljasõidukohustuse ja sissesõidukeelu seaduse alusel kinnipeetud välismaalased (edaspidi väljasaadetav) või välismaalasele rahvusvahelise kaitse andmise seaduse alusel kinnipeetud välismaalased (edaspidi rahvusvahelise kaitse taotleja); RT I 2020-07-29 2 129072020002 2020-08-01 6 6) „Kriminaalmenetluse seadustiku” § 217 alusel kahtlustatavana kinnipeetud isikud; 7 7) „Väärteomenetluse seadustiku” § 44 alusel kinnipeetud isikud; 8 8) „Korrakaitseseaduse” § 46 alusel kinnipeetud isikuid; RT I 2017-05-20 8 120052017008 2017-05-23 9 9) muud isikud, kellelt politsei on seaduse alusel võtnud vabaduse; 10 10) distsiplinaararesti kandvad kaitseväelased. RT I 2017-05-20 8 120052017008 2017-05-23 Arestimajas peetakse kinni järgmisi isikuid: arestialused; vahistatud; kainenema toimetatud isikud; sundtoodavad; väljasõidukohustuse ja sissesõidukeelu seaduse alusel kinnipeetud välismaalased (edaspidi väljasaadetav) või välismaalasele rahvusvahelise kaitse andmise seaduse alusel kinnipeetud välismaalased (edaspidi rahvusvahelise kaitse taotleja); „Kriminaalmenetluse seadustiku” § 217 alusel kahtlustatavana kinnipeetud isikud; „Väärteomenetluse seadustiku” § 44 alusel kinnipeetud isikud; „Korrakaitseseaduse” § 46 alusel kinnipeetud isikuid; muud isikud, kellelt politsei on seaduse alusel võtnud vabaduse; distsiplinaararesti kandvad kaitseväelased.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_3 (redaktsioon 1001404)",
        "@language": "et"
      },
