        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 24. oktoobril 2011. a. Määrus jõustub 24. oktoobril 2011. a.",
      "rdfs:label": {
        "@value": "Reg_1001404_Par_81 (redaktsioon 1001404)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001404",
