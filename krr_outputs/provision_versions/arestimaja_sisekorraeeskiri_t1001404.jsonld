      }
    },
    {
      "@id": "estleg:Reg_1001404_Par_66_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluses märgitakse: 1 1) taotleja nimi; 2 2) põhjus; 3 3) soovitav aeg ja kestus; 4 4) sihtkoha täpne aadress; 5 5) isikute nimed, kelle juurde tahetakse minna; 6 6) kinnitus selle kohta, et kinnipeetule on tutvustatud lühiajalise väljaviimise või lühiajalise vabastamise tingimusi ning et teda on hoiatatud tagasipöördumistähtaja rikkumise ja muu õigusrikkumise toimepanemise tagajärgede eest. Taotluses märgitakse: taotleja nimi; põhjus; soovitav aeg ja kestus; sihtkoha täpne aadress; isikute nimed, kelle juurde tahetakse minna; kinnitus selle kohta, et kinnipeetule on tutvustatud lühiajalise väljaviimise või lühiajalise vabastamise tingimusi ning et teda on hoiatatud tagasipöördumistähtaja rikkumise ja muu õigusrikkumise toimepanemise tagajärgede eest. 2 (2) Taotlusele lisatakse erakorralist perekondlikku sündmust kinnitav dokument. Taotlusele lisatakse erakorralist perekondlikku sündmust kinnitav dokument.",
      "rdfs:label": {
