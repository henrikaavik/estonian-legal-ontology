    {
      "@id": "estleg:Reg_1001404_Par_79_v1001404",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001404_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Arestimajast vabastamisel antakse kinnipeetule tema soovil arestimajast vabastamise õiend. 2011-12-22 RT I 2011-12-29 72 129122011072 2012-01-01 28 Arestimajast vabastamisel antakse kinnipeetule tema soovil arestimajast vabastamise õiend. 2 (2) Arestimajast vabastamise õiendi vormi ja sellele kantavate andmete loetelu kehtestab Politsei- ja Piirivalveameti peadirektor käskkirjaga. Arestimajast vabastamise õiendi vormi ja sellele kantavate andmete loetelu kehtestab Politsei- ja Piirivalveameti peadirektor käskkirjaga.",
      "rdfs:label": {
