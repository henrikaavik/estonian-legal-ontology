      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud , mis on vastu võetud 1998. aasta 17. juulil Roomas ja millele Eesti Vabariik kirjutas alla 1999. aasta 27. detsembril New Yorgis.",
      "rdfs:label": {
        "@value": "RKRSR_Par_1 (redaktsioon 27547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27547"
    },
    {
      "@id": "estleg:RKRSR_Par_2_v27547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKRSR_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsusel määrata Rahvusvahelise Kriminaalkohtu Rooma statuudi jõustumisel esindaja Rahvusvahelise Kriminaalkohtu osalisriikide assambleesse vastavalt Rahvusvahelise Kriminaalkohtu Rooma statuudi artiklile 112.",
      "rdfs:label": {
        "@value": "RKRSR_Par_2 (redaktsioon 27547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27547"
    },
    {
      "@id": "estleg:RKRSR_Par_3_v27547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKRSR_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusvahelise Kriminaalkohtu poolt Rahvusvahelise Kriminaalkohtu Rooma statuudi artikli 89 alusel väljastatud loovutamisnõudeid täidetakse kriminaalmenetluse koodeksi (ENSV ÜT 1961, 1, 4 ja lisa; ... RT I 2001, 65, 378) isiku välisriigile väljaandmist reguleerivate sätete alusel.",
      "rdfs:label": {
        "@value": "RKRSR_Par_3 (redaktsioon 27547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27547"
    }
  ]
