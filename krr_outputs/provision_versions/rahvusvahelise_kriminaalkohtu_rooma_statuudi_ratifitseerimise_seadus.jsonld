      "dc:source": "Rahvusvahelise Kriminaalkohtu Rooma statuudi ratifitseerimise seadus"
    },
    {
      "@id": "estleg:RKRSR_Par_1_v27547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
