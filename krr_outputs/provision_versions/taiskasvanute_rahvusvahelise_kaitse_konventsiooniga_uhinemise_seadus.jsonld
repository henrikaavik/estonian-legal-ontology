        "@value": "2010-11-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konventsiooni artikli 28 lõike 1 alusel määratakse keskasutuseks Justiitsministeerium.",
      "rdfs:label": {
        "@value": "TRKKU_Par_2 (redaktsioon 215112010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "215112010001"
    },
    {
      "@id": "estleg:TRKKU_Par_3_v215112010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TRKKU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühinemisel teha artikli 56 alusel artikli 51 lõike 2 suhtes reservatsioon, et Eesti Vabariigi keskasutusele või muule ametiasutusele originaalkeeles saadetud materjalidele peab olema lisatud tõlge inglise keelde, kui tõlge eesti keelde ei ole võimalik.",
      "rdfs:label": {
        "@value": "TRKKU_Par_3 (redaktsioon 215112010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "215112010001"
    },
    {
      "@id": "estleg:TRKKU_Par_4_v215112010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TRKKU_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Deklareerida konventsiooni artikli 32 lõike 2 alusel, et sama artikli lõike 1 alusel esitatud teabetaotlused tuleb edastada keskasutuse kaudu.",
      "rdfs:label": {
        "@value": "TRKKU_Par_4 (redaktsioon 215112010001)",
        "@language": "et"
