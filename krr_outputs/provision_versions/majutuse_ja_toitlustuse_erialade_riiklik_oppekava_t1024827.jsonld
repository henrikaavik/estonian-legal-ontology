      "estleg:provisionRef": "Reg_1024827 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024827_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024827_Par_13_v1024827",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024827_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õppima võib asuda põhiharidusega isik või vähemalt 22-aastane põhihariduseta isik, kellel on põhihariduse tasemele vastavad kompetentsid. Õppima võib asuda põhiharidusega isik või vähemalt 22-aastane põhihariduseta isik, kellel on põhihariduse tasemele vastavad kompetentsid. 2 (2) Õpingud loetakse lõpetatuks, kui õpilane on saavutanud turismiteeninduse erila õppekava õpiväljundid vähemalt lävendi tasemel. RT I 2023-03-09 4 109032023004 2023-03-12 Õpingud loetakse lõpetatuks, kui õpilane on saavutanud turismiteeninduse erila õppekava õpiväljundid vähemalt lävendi tasemel.",
      "rdfs:label": {
        "@value": "Reg_1024827_Par_13 (redaktsioon 1024827)",
        "@language": "et"
      },
