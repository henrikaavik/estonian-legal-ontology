    {
      "@id": "estleg:Reg_1022895_Par_11_v1022895",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022895_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis nimetatud teisaldatav registreerimismärk kantakse painduvale plastikalusele ja peab vastama majandus- ja kommunikatsiooniministri 21. juuni 2011. a määruse nr 49 „Riiklikele registreerimismärkidele ja nende valmistamisele esitatavad nõuded” § 2 lõike 1 punkti 6, lõigete 2 ja 3, § 3, § 4 lõigete 3–5 ja § 5 lõike 4 nõuetele. Käesolevas peatükis nimetatud teisaldatav registreerimismärk kantakse painduvale plastikalusele ja peab vastama majandus- ja kommunikatsiooniministri 21. juuni 2011. a määruse nr 49 „Riiklikele registreerimismärkidele ja nende valmistamisele esitatavad nõuded” § 2 lõike 1 punkti 6, lõigete 2 ja 3, § 3, § 4 lõigete 3–5 ja § 5 lõike 4 nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1022895_Par_11 (redaktsioon 1022895)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022895",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022895",
      "estleg:sourceAct": "Väikelaeva, alla 12-meetrise kogupikkusega laeva ja jeti registreerimise eeskiri",
      "estleg:provisionRef": "Reg_1022895 § 11",
      "estleg:partOfAct": {
