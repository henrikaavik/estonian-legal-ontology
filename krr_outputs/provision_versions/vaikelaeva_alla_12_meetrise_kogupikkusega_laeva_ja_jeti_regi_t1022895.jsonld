      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registriandmete muutmisel ja veesõiduki registrist kustutamisel tuleb registreerimistunnistus Transpordiametile tagastada, kui käesoleva määrusega ei sätestata teisiti. Registriandmete muutmisel ja veesõiduki registrist kustutamisel tuleb registreerimistunnistus Transpordiametile tagastada, kui käesoleva määrusega ei sätestata teisiti.",
      "rdfs:label": {
