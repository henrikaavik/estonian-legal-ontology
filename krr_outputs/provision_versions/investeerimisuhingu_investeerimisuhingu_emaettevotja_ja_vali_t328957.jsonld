      }
    },
    {
      "@id": "estleg:Reg_328957_Par_17_v328957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_328957_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Finantsinspektsioon kontrollib esitatud aruannete vastavust käesolevas määruses esitatud nõuetele kohe pärast aruande laekumist. Finantsinspektsioon kontrollib esitatud aruannete vastavust käesolevas määruses esitatud nõuetele kohe pärast aruande laekumist. 2 (2) Kui Finantsinspektsioon tuvastab aruandes puudusi, teavitab ta sellest viivitamatult aruande esitajat. Kui Finantsinspektsioon tuvastab aruandes puudusi, teavitab ta sellest viivitamatult aruande esitajat. 3 (3) Aruande esitaja on kohustatud käesoleva paragrahvi lõikes 2 sätestatud juhul puudused kõrvaldama ning esitama Finantsinspektsioonile korrigeeritud aruande. Korrigeeritud aruanne tuleb esitada ka juhul kui aruande esitaja on varasemalt esitatud andmetes tuvastanud vea. RT I 2014-12-29 1 129122014001 2015-01-01 Aruande esitaja on kohustatud käesoleva paragrahvi lõikes 2 sätestatud juhul puudused kõrvaldama ning esitama Finantsinspektsioonile korrigeeritud aruande. Korrigeeritud aruanne tuleb esitada ka juhul kui aruande esitaja on varasemalt esitatud andmetes tuvastanud vea.",
      "rdfs:label": {
        "@value": "Reg_328957_Par_17 (redaktsioon 328957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "328957",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/328957",
      "estleg:sourceAct": "Investeerimisühingu, investeerimisühingu emaettevõtja ja välisriigi investeerimisühingu filiaali aruannete sisu, koostamise metoodika ja esitamise kord",
      "estleg:provisionRef": "Reg_328957 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_328957_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_328957_Par_18_v328957",
      "@type": [
        "owl:NamedIndividual",
