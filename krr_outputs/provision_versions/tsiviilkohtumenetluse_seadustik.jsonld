      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_622"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisriigi kohtulahendi täidetavaks tunnistamise avaldus esitatakse kirjalikult ja sellele lisatakse: kohtulahendi ärakiri, mis on tõestatud lahendi teinud kohtu asukohariigi õiguse kohaselt; dokument, mis kinnitab, et kostjale või muule lahendist tulenevale võlgnikule, kes kohtumenetluses ei osalenud, oli õigel ajal kas või kordki vastavalt selle riigi õigusele hagi, kohtukutse või muu menetlust algatav dokument kätte antud; dokument, mis tõendab, et lahendi tegemise riigi õiguse järgi on lahend jõustunud ja täidetav ning kostjale või muule lahendist tulenevale võlgnikule teatavaks tehtud; dokumendid lahendi täitmise kohta, kui seda on juba üritatud täita; dokumendid lahendi täitmise kohta, kui lahendit on juba täidetud; käesoleva lõike punktides 1-5 nimetatud dokumentide notariaalselt või vandetõlgi kinnitatud tõlked eesti keelde. (2) Kohus võib avaldajale anda tähtaja käesoleva paragrahvi lõikes 1 nimetatud dokumendi esitamiseks. Kui asjaolud seda võimaldavad, võib kohus lahendada asja dokumente nõudmata. (3) Kohus võib rakendada avalduse tagamiseks esialgse õiguskaitse korras hagi tagamise abinõusid.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa11_Par_622 (redaktsioon 128122011044)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011044",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_622_v121122012018"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_622_v121122012018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_622"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisriigi kohtulahendi täidetavaks tunnistamise avaldus esitatakse kirjalikult ja sellele lisatakse: kohtulahendi ärakiri, mis on tõestatud lahendi teinud kohtu asukohariigi õiguse kohaselt; dokument, mis kinnitab, et kostjale või muule lahendist tulenevale võlgnikule, kes kohtumenetluses ei osalenud, oli õigel ajal kas või kordki vastavalt selle riigi õigusele hagi, kohtukutse või muu menetlust algatav dokument kätte antud; dokument, mis tõendab, et lahendi tegemise riigi õiguse järgi on lahend jõustunud ja täidetav ning kostjale või muule lahendist tulenevale võlgnikule teatavaks tehtud; dokumendid lahendi täitmise kohta, kui seda on juba üritatud täita; dokumendid lahendi täitmise kohta, kui lahendit on juba täidetud; käesoleva lõike punktides 1–5 nimetatud dokumentide notariaalselt või vandetõlgi kinnitatud tõlked eesti keelde. (2) Kohus võib avaldajale anda tähtaja käesoleva paragrahvi lõikes 1 nimetatud dokumendi esitamiseks. Kui asjaolud seda võimaldavad, võib kohus lahendada asja dokumente nõudmata. (3) Kohus võib rakendada avalduse tagamiseks esialgse õiguskaitse korras hagi tagamise abinõusid.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa11_Par_622 (redaktsioon 121122012018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122012018",
