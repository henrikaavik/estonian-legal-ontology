        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtus lahendab kohtunik tsiviilasja ainuisikuliselt. (2) Seaduses sätestatud juhul võib kohtuniku asemel tsiviilasja lahendada kohtunikuabi. Kohtunikuabi pädevusele ja tema taandamisele kohaldatakse vastavalt käesoleva seadustiku § 595 lõigetes 2–4 sätestatut.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_16 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_16_v13107075"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_16_v13107075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtus lahendab kohtunik tsiviilasja ainuisikuliselt. (2) Kehtetu –",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_16 (redaktsioon 13107075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13107075",
