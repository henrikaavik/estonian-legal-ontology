      },
      "estleg:versionValidTo": {
        "@value": "2006-02-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_144_v993176",
      "@type": [
        "owl:NamedIndividual",
