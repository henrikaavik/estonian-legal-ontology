    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_493_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_493"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lapse elatisnõude kiirmenetluses tehtavas makseettepanekus peavad sisalduma vähemalt järgmised andmed: käesoleva seadustiku §-s 492 nimetatud avalduse andmed; selgitus, et kohus ei ole kontrollinud, kas avaldaja võib nõude esitada; aeg, millest alates ja millises suuruses võib elatist välja mõista; selgitus, et kui võlgnik ei esita makseettepanekule põhistatud vastuväidet makseettepaneku kättetoimetamisest alates 30 päeva jooksul, välisriigis kättetoimetamise puhul aga 60 päeva jooksul, võib kohus teha täitedokumendina maksekäsu; vastuväited, mida võlgnik võib vastavalt seadusele makseettepanekule esitada; selgitus selle kohta, et võlgnik võib esitada elatise maksmise võimatusele või piiratud võimalusele tugineva vastuväite üksnes juhul, kui vastuväitele on ettenähtud vormis lisatud kinnitus võlgniku vara, sissetuleku ja majandusliku seisundi kohta ning sellele on lisatud vastavad tõendid.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa11_Par_493 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_493_v12994590"
      },
      "estleg:versionValidTo": {
        "@value": "2008-07-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_493_v12994590",
      "@type": [
