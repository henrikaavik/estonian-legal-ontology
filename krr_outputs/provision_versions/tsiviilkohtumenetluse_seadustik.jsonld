      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadustik jõustub 1998. aasta 1. septembril.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa10_Par_385 (redaktsioon 22407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22407",
      "estleg:supersededByVersion": {
