      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_334_v111032023030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_334"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avaldused, taotlused, vastuväited ja kaebused esitatakse kohtule selgesti loetavas masina- või arvutikirjas A4 formaadis. Kohtuistungil esitatud avaldused, taotlused, seisukohad ja vastuväited protokollitakse. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa7_Par_334 (redaktsioon 111032023030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023030"
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335_v22407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikohtu pädevuses on: ringkonnakohtu lahendite peale esitatud kaebuste kassatsiooni korras läbivaatamine; jõustunud kohtulahendite peale esitatud teistmisavalduste läbivaatamine; kohtuvigade parandamine. asja lahendamiseks pädeva kohtu määramine käesoleva seadustiku peatükis 48.1 sätestatud korras;",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa7_Par_335 (redaktsioon 22407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22407",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335_v749355"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335_v749355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikohtu pädevuses on: ringkonnakohtu lahendite peale esitatud kaebuste kassatsiooni korras läbivaatamine; jõustunud kohtulahendite peale esitatud teistmisavalduste läbivaatamine; kohtuvigade parandamine. asja lahendamiseks pädeva kohtu määramine käesoleva seadustiku peatükis 481 sätestatud korras;",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa7_Par_335 (redaktsioon 749355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749355",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335_v977622"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kirjaliku avalduse või kaebuse esitamiseks antud tähtajast kinnipidamiseks piisab avalduse või kaebuse edastamisest kohtule faksi teel või elektronpostiga selleks ettenähtud aadressil või muus kirjalikku taasesitamist võimaldavas vormis, tingimusel et kirjaliku dokumendi originaal antakse kohtule üle viivitamata pärast seda, kuid hiljemalt asja arutamisel kohtuistungil või kirjalikus menetluses dokumentide esitamise tähtaja jooksul.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa7_Par_335 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335_v13107075"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335_v13107075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_335"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kirjaliku avalduse või kaebuse esitamiseks antud tähtajast kinnipidamiseks piisab avalduse või kaebuse edastamisest kohtule faksi teel või elektronpostiga selleks ettenähtud aadressil või muus kirjalikku taasesitamist võimaldavas vormis, tingimusel et kirjaliku dokumendi originaal antakse kohtule üle viivitamata pärast seda, kuid hiljemalt asja arutamisel kohtuistungil või kirjalikus menetluses dokumentide esitamise tähtaja jooksul. (2) Kohtulahendi peale kaebuse esitamise korral tuleb kaebuse originaal esitada kümne päeva jooksul. (3) Käesoleva paragrahvi lõikes 1 sätestatut ei kohaldata dokumendi edastamise korral elektrooniliselt, kui dokument on esitatud käesoleva seadustiku § 336 nõuete kohaselt.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa7_Par_335 (redaktsioon 13107075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13107075"
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_336_v22407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa7_Par_336"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tsiviilasju vaatab läbi Riigikohtu tsiviilkolleegium. (2) Seaduses sätestatud juhtudel vaatab tsiviilasju läbi Riigikohtu erikogu või Riigikohtu üldkogu.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa7_Par_336 (redaktsioon 22407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22407",
      "estleg:supersededByVersion": {
