    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_39_v22407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Apellatsioonikohtus protokollitakse istung ulatuses, mida kohus peab vajalikuks. (2) Kassatsioonikohtus protokollitakse istung juhul, kui kohus peab seda vajalikuks.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_39 (redaktsioon 22407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22407",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_39_v977622"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_39_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus võib kinnisele istungile lubada isiku, kellel on istungil viibimiseks õigustatud huvi või kelle istungil viibimine on ilmselt õigusemõistmise huvides. Menetlusosaliste nõusolekut ei ole selleks vaja.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_39 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622"
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa10_Par_390_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa10_Par_390"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtu või ringkonnakohtu määruse peale, millega kohus hagi tagamise taotluse rahuldas, ühe tagamisabinõu teisega asendas või hagi tagamise tühistas, võib pool esitada määruskaebuse. Maakohtu määruse peale esitatud määruskaebuse kohta tehtud ringkonnakohtu määruse peale ei saa Riigikohtule edasi kaevata. (2) Määruskaebuse esitamine ei peata hagi tagamise määruse täitmist. Määruskaebuse esitamine hagi tagamise tühistamise või ühe tagamisabinõu teisega asendamise määruse peale peatab määruse täitmise.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa10_Par_390 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa10_Par_390_v12954647"
      },
      "estleg:versionValidTo": {
        "@value": "2008-04-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa10_Par_390_v12954647",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa10_Par_390"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-04-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtu või ringkonnakohtu määruse peale, millega kohus hagi tagamise taotluse rahuldas, ühe tagamisabinõu teisega asendas või hagi tagamise tühistas, võib pool esitada määruskaebuse. Maakohtu määruse peale esitatud määruskaebuse kohta tehtud ringkonnakohtu määruse peale ei saa Riigikohtule edasi kaevata. – Riigikohtu 9.04.2008. a põhiseaduslikkuse järelevalve kolleegiumi kohtuotsus nr 3-4-1-20-07 tunnistab § 390 lõike 1 esimese lause põhiseadusega vastuolus olevaks ja kehtetuks osas, milles see ei võimalda edasi kaevata hagi tagamise taotluse rahuldamata jätmise määruse peale, millega arvati tasutud kautsjon riigituludesse. (2) Määruskaebuse esitamine ei peata hagi tagamise määruse täitmist. Määruskaebuse esitamine hagi tagamise tühistamise või ühe tagamisabinõu teisega asendamise määruse peale peatab määruse täitmise.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa10_Par_390 (redaktsioon 12954647)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12954647",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa10_Par_390_v13107075"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa10_Par_390_v13107075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa10_Par_390"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohtu või ringkonnakohtu määruse peale, millega kohus hagi tagas, ühe tagamisabinõu teisega asendas või hagi tagamise tühistas, võib pool esitada määruskaebuse. Maakohtu määruse peale esitatud määruskaebuse kohta tehtud ringkonnakohtu määruse peale saab Riigikohtule edasi kaevata üksnes juhul, kui tagatava hagi hind ületab 1 000 000 krooni või kui tagamisabinõuna kohaldati isiku aresti või elukohast lahkumise keeldu. (2) Määruskaebuse esitamine ei peata hagi tagamise määruse täitmist. Määruskaebuse esitamine hagi tagamise tühistamise või ühe tagamisabinõu teisega asendamise määruse peale peatab määruse täitmise.",
      "rdfs:label": {
