    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_49_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuistung ja väljaspool kohtuistungit toimuv menetlustoiming protokollitakse. Sama kehtib kohtu poolt korralduse või erinõude alusel tehtava menetlustoimingu kohta. (2) Protokolli koostab kohtuistungi sekretär või kohtunik kohtuistungi või muu menetlustoimingu tegemise ajal. (3) Riigikohtu istung protokollitakse ulatuses, mida kohus peab vajalikuks.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_49 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622",
