      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnakohus võib määratud tähtpäevaks nõuda vastustajalt täiendavat kirjalikku vastust apellatsioon- või erikaebusele. (2) Vastustajal on õigus eelnevalt kätte saada kaebus ning sellele lisatud dokumentide ärakirjad.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa6_Par_312 (redaktsioon 22407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22407",
