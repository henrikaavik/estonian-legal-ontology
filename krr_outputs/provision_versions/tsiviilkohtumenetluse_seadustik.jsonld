      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_597_v13107075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_597"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kandemäärus täidetakse ja kanne tehakse viivitamata, kui seaduses ei ole ette nähtud teisiti. (2) Kandemäärus, millega avaldus jäetakse rahuldamata, toimetatakse avaldajale kätte. (3) Kandemäärus, millega avaldus rahuldatakse, edastatakse avaldajale ettenähtud viisil. (4) Kui avalduseta kandemääruse alusel tehakse kanne, toimetatakse määrus kätte isikutele, kelle või kelle vara kohta kanne tehakse.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa11_Par_597 (redaktsioon 13107075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13107075",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_597_v130122014014"
      },
      "estleg:versionValidTo": {
