        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_597_v130122014014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_597"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kandemäärus täidetakse ja kanne tehakse viivitamata, kui seaduses ei ole ette nähtud teisiti. (2) Kandemäärus, millega avaldus jäetakse rahuldamata, toimetatakse avaldajale kätte. (3) Kandemäärus, millega avaldus rahuldatakse, edastatakse avaldajale määruses ettenähtud viisil. (4) Kui avalduseta kandemääruse alusel tehakse kanne, toimetatakse määrus kätte isikutele, kelle või kelle vara kohta kanne tehakse.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa11_Par_597 (redaktsioon 130122014014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014014"
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_598_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_598"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kandeavalduse lahendamiseks tuleks äriregistri- või mittetulundusühingute ja sihtasutuste registriasja menetleval kohtul anda hinnang vaidlusalusele õigussuhtele, võib kohus peatada avalduse menetlemise kuni vaidluse lahendamiseni hagimenetluses. Kui sel juhul ei ole hagi veel esitatud, võib kohus määrata asjaosalisele hagi esitamiseks tähtaja. Menetluse võib peatada ka käesoleva seadustiku §-s 356 sätestatud juhul.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa11_Par_598 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_598_v13107075"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_598_v13107075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_598"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kandeavalduse lahendamiseks tuleks äriregistri- või mittetulundusühingute ja sihtasutuste registriasja menetleval kohtul anda hinnang vaidlusalusele õigussuhtele, võib kohus peatada avalduse menetlemise kuni vaidluse lahendamiseni hagimenetluses. Kui sel juhul ei ole hagi veel esitatud, võib kohus määrata asjaosalisele hagi esitamiseks tähtaja. Äriregistri või mittetulundusühingute ja sihtasutuste registri asja menetluse võib peatada ka käesoleva seadustiku §-s 356 sätestatud juhul.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa11_Par_598 (redaktsioon 13107075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13107075"
    },
