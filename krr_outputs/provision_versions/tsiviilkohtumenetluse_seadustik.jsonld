      },
      "estleg:versionValidTo": {
        "@value": "2021-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa6_Par_311_1_v122122021023",
      "@type": [
