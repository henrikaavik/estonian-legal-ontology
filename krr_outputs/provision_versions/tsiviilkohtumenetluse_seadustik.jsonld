      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_22_v217304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Taandatud kohtunik või rahvakohtunik asendatakse esimesel võimalusel. (2) Kohtuniku, rahvakohtunik või kogu kohtu koosseisu taandamise korral vaatab asja läbi sama kohtu teine koosseis. Kui kohtus, kus asi oli läbivaatamisel, ei ole võimalik kohtunikku asendada, saadetakse asi vahetult kõrgema astme kohtu kaudu teisele sama astme kohtule. (3) Kohtunikul ja rahvakohtunikel on enesetaandamiskohustus ja -õigus üksnes käesoleva seadustiku §-des 18 ja 19 sätestatud kohtuniku taandamise alustel. Õigusemõistmisest põhjendamatu keeldumine ei ole lubatud.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_22 (redaktsioon 217304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "217304",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_22_v977622"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_22_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kollegiaalne kohtukoosseis lahendab tsiviilasja puutuvad lahkarvamused hääletamisega. (2) Kohtukoosseisu liikmel ei ole õigust keelduda hääletamisest ega jääda erapooletuks. Küsimuste järjestikulisel hääletamisel ei ole varem vähemusse jäänud kohtukoosseisu liikmel õigust hääletamast keelduda. (3) Häälte võrdse jagunemise korral on otsustav eesistuja hääl. (4) Hääletamisel vähemusse jäänud kohtunik võib esitada eriarvamuse. Riigikohtu otsusele lisatud eriarvamus avaldatakse Riigi Teatajas koos kohtuotsusega.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_22 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_22_v13107075"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_22_v13107075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kollegiaalne kohtukoosseis lahendab tsiviilasja puutuvad lahkarvamused hääletamisega. (2) Kohtukoosseisu liikmel ei ole õigust keelduda hääletamisest ega jääda erapooletuks. Küsimuste järjestikulisel hääletamisel ei ole varem vähemusse jäänud kohtukoosseisu liikmel õigust hääletamast keelduda. (3) Häälte võrdse jagunemise korral on otsustav eesistuja hääl. (4) Hääletamisel vähemusse jäänud kohtunik võib esitada eriarvamuse. Kohtulahendile lisatud eriarvamus avalikustatakse koos kohtulahendiga.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_22 (redaktsioon 13107075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13107075"
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa4_Par_220_v22407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa4_Par_220"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Määruse peale, millega asja menetlus on lõpetatud, võib esitada erikaebuse. (2) Määruse peale, millega kohus ei lõpeta asja menetlust seetõttu, et ei võta vastu hagist loobumist või ei kinnita poolte kokkulepet, võib esitada erikaebuse. Ringkonnakohtu määruse peale erikaebuse kohta ei saa edasi kaevata.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa4_Par_220 (redaktsioon 22407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22407",
      "estleg:supersededByVersion": {
