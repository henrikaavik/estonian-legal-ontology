        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_144_v13107075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_144"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuvälised kulud on: menetlusosaliste esindajate ja nõustajate kulud; menetlusosaliste sõidu-, posti-, side-, majutus- ja muud sellesarnased kulud, mis on kantud seoses menetlusega; menetlusosaliste saamata jäänud töötasu või muu püsiv sissetulek; seaduses sätestatud kohtueelse menetluse kulud, välja arvatud juhul, kui hagi on esitatud hiljem kui kuus kuud pärast kohtueelse menetluse lõppu; kohtutäituri tasu hagi tagamise eest ja hagi tagamise määruse täitmise kulud; menetluskulude kandmisel menetlusabi taotlemise avalduse menetlemise kulud; maksekäsu kiirmenetluse kulud juhul, kui maksekäsu kiirmenetluse avaldus jäeti määrusega rahuldamata käesoleva seadustiku § 483 lõike 2 punkti 3 alusel, välja arvatud, kui hagi on samas nõudes esitatud hiljem kui üks kuu pärast maksekäsu kiirmenetluse lõppu.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa3_Par_144 (redaktsioon 13107075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13107075",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_144_v13260025"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_144_v13260025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_144"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuvälised kulud on: menetlusosaliste esindajate ja nõustajate kulud; menetlusosaliste sõidu-, posti-, side-, majutus- ja muud sellesarnased kulud, mis on kantud seoses menetlusega; menetlusosaliste saamata jäänud töötasu või muu püsiv sissetulek; seaduses sätestatud kohtueelse menetluse kulud, välja arvatud juhul, kui hagi on esitatud hiljem kui kuus kuud pärast kohtueelse menetluse lõppu; kohtutäituri tasu hagi tagamise eest ja hagi tagamise määruse täitmise kulud; menetluskulude kandmisel menetlusabi taotlemise avalduse menetlemise kulud; maksekäsu kiirmenetluse kulud juhul, kui maksekäsu kiirmenetluse avaldus jäeti määrusega rahuldamata käesoleva seadustiku § 483 lõike 2 punkti 3 alusel, välja arvatud, kui hagi on samas nõudes esitatud hiljem kui üks kuu pärast maksekäsu kiirmenetluse lõppu; lepitusmenetluses osalemise kulud juhul, kui kohus on kohustanud pooli osalema selles vastavalt käesoleva seaduse § 4 lõikele 4 või kui on tegu kohustusliku kohtueelse lepitusmenetlusega vastavalt lepitusseaduse § 1 lõikele 4.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa3_Par_144 (redaktsioon 13260025)",
        "@language": "et"
      },
