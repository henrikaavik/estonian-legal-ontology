      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_160_v122122021023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
