      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ebamõistlikult kahjustava tüüptingimuse kasutamise lõpetamise või tingimuse soovitajalt soovitamise lõpetamise ja soovituse tagasivõtmise vaidluse puhul eeldatakse, et hagihind on 1595 eurot. Sellise vaidluse puhul ei loeta hagihinda kõrgemaks kui 63 900 eurot.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa3_Par_130 (redaktsioon 130122010016)",
        "@language": "et"
      },
