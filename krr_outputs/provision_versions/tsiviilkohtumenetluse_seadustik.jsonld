      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asja läbivaatamise kulud on: tunnistaja-, eksperdi- ja tõlgikulud; dokumentaalse tõendi ja asitõendi saamise kulud; vaatluse kulud, muu hulgas sellega seotud vajalikud kohtu sõidukulud; menetlusdokumentide kättetoimetamise, edastamise ja väljastamise kulud; väljaandes Ametlikud Teadaanded või ajalehes kutse või teate avaldamise kulud; tsiviilasja hinna määramise kulud.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa3_Par_143 (redaktsioon 977622)",
