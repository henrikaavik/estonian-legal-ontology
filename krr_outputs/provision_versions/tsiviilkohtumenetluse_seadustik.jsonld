      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa12_Par_640_v130122010016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
