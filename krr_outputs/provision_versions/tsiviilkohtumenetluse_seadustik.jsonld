      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_140_v122122021023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa3_Par_140 (redaktsioon 122122021023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122021023"
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_141_v22407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hagi seoses kinnisasjaga esitatakse kinnisasja asukoha järgi. (2) Vara arestist vabastamise hagi ja muu arestitud varaga seotud hagi esitatakse vara asukoha järgi. (3) Pärandaja võlausaldaja hagi ja pärandi jagamise hagi, mis esitatakse enne pärandvara jagamist, esitatakse pärandi avanemise koha järgi. (4) Veolepingust tulenev hagi esitatakse vedaja elu- või asukoha järgi. (5) Eluruumi üürilepingust tulenev hagi esitatakse eluruumi asukoha järgi. (6) Mõnda liiki hagide erandlik kohtualluvus võidakse määrata ka seadusega.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa3_Par_141 (redaktsioon 22407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22407",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_141_v977622"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_141_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahalise nõudega hagi tagamise avalduselt tasutakse hagi tagamise kautsjonina 5% hagi tagamisega taotletu harilikust väärtusest, kuid mitte vähem kui 500 krooni ja mitte rohkem kui 100 000 krooni. (2) Kui hagi tagamise korras taotletakse kostja kinnipidamist, aresti või elukohast lahkumise keelamist, tasutakse kautsjon kohtu määratud ulatuses, kuid mitte vähem kui 50 000 krooni ja mitte rohkem kui 500 000 krooni.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa3_Par_141 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622",
      "estleg:supersededByVersion": {
