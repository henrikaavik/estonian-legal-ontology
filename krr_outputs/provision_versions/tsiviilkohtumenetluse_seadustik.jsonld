      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa2_Par_88 (redaktsioon 217304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "217304",
      "estleg:supersededByVersion": {
