      "estleg:versionText": "Tunnistaja kuulatakse kohtuistungil üle käesoleva seadustiku §-des 107--112 sätestatud korras.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa3_Par_186 (redaktsioon 749355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749355",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa3_Par_186_v977622"
      },
