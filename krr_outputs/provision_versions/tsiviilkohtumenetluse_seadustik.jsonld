    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa13_Par_672_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa13_Par_672"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koos kassatsioonkaebusega esitatakse Riigikohtule vaidlustatava otsuse ärakiri. Kaebusele lisatakse kassatsioonikautsjoni tasumist tõendav dokument, kui kautsjoni tasumise andmed ei ole kaebuses märgitud.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa13_Par_672 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622",
