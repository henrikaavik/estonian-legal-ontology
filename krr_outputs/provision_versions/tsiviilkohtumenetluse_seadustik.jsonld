      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa2_Par_84_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa2_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kostja majandus- või kutsetegevusest tuleneva hagi võib esitada ka tema tegevuskoha järgi.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa2_Par_84 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622"
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa2_Par_85_v22407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa2_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Esindaja kohtus võib olla: advokaat; prokurist, kui prokuuras antud volituste mahust ei tulene teisiti; isik, kes on protsessiosalisega töö- või teenistussuhtes; üks hageja kaashagejate või üks kostja kaaskostjate volitusel; protsessiosalise üleneja või alaneja sugulane või abikaasa; muu isik, kelle õigus olla lepinguline esindaja tuleneb seadusest; muu õigusteadmistega isik. (2) Esindaja Riigikohtus võib olla ja lepingulise esindajana kassatsioonkaebust esitada üksnes vandeadvokaat.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa2_Par_85 (redaktsioon 22407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22407",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa2_Par_85_v782718"
      },
      "estleg:versionValidTo": {
        "@value": "2005-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa2_Par_85_v782718",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa2_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Esindaja kohtus võib olla: advokaat; prokurist, kui prokuuras antud volituste mahust ei tulene teisiti; isik, kes on protsessiosalisega töö- või teenistussuhtes; üks hageja kaashagejate või üks kostja kaaskostjate volitusel; protsessiosalise üleneja või alaneja sugulane või abikaasa; muu isik, kelle õigus olla lepinguline esindaja tuleneb seadusest; [Punkti 7 sõnastus kuni 28. 02. 2005] muu õigusteadmistega isik. [Punkti 7 sõnastus alates 1. 03. 2005] muu isik, kes on täitnud õigusteaduse akadeemilise õppe riiklikult tunnustatud õppekava. (2) Esindaja Riigikohtus võib olla ja lepingulise esindajana kassatsioonkaebust esitada üksnes vandeadvokaat.",
      "rdfs:label": {
