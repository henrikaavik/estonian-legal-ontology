      },
      "estleg:versionValidTo": {
        "@value": "2004-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa4_Par_220_v769593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa4_Par_220"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Määruse peale, millega asja menetlus on lõpetatud, võib esitada erikaebuse. (2) Määruse peale, millega kohus ei lõpeta asja menetlust seetõttu, eteivõta vastu hagist loobumist või ei kinnita poolte kokkulepet, võib esitada erikaebuse. Ringkonnakohtu määruse peale erikaebuse kohta ei saa edasi kaevata.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa4_Par_220 (redaktsioon 769593)",
