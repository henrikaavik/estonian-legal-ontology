      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_35_v977622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui menetlusosaline on kurt, tumm või kurttumm, vahendatakse talle menetlust kirjalikult või kaasatakse menetlusse tõlk.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_35 (redaktsioon 977622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977622"
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_36_v22407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Protsessitoimingu protokoll peab kajastama asja arutamise käiku, samuti protsessitoimingu või asja lahendamise seisukohalt olulist. (2) Istungi protokollis märgitakse: istungi toimumise kuupäev ja koht ning tsiviilasja number; istungi alguse ja lõpu kellaaeg; asja läbivaatava kohtu nimi, kohtunike, kohtukaasistujate, istungi protokollija ja tõlgi nimed; asja liik ja poolte nimed või avaldaja nimi; andmed protsessiosaliste, tunnistajate ja ekspertide ilmumise kohta; istungil tehtud korraldused ja määrused; protsessiosaliste avaldused ja taotlused; käesoleva seadustiku paragrahvis 10 sätestatud juhul andmed pooltele ja teistele protsessiosalistele nende protsessiõiguste ja -kohustuste selgitamise kohta; poolte nõuete ja vastuväidete ning teiste protsessiosaliste seletuste ja tunnistajate ütluste põhisisu, eksperdi suulised vastused, andmed asitõendite ja dokumentaalsete tõendite vaatluse, samuti paikvaatluse kohta; asjast osavõtva riigiasutuse ja kohaliku omavalitsuse asutuse suulise arvamuse lühike sisu; kohtuvaidluse lühike sisu; millal kohtulahend avalikult teatavaks tehakse; protokollile allakirjutamise kuupäev.",
      "rdfs:label": {
        "@value": "tsiviilkohtumenetluse_seadustik_Osa1_Par_36 (redaktsioon 22407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22407",
      "estleg:supersededByVersion": {
        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa1_Par_36_v184400"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      }
    },
    {
