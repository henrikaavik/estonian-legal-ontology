      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa11_Par_491_v12769814",
      "@type": [
