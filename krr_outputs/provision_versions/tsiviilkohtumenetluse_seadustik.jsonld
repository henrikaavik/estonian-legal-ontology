        "@id": "estleg:tsiviilkohtumenetluse_seadustik_Osa10_Par_378_v113032014100"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-31",
        "@type": "xsd:date"
      }
    },
    {
