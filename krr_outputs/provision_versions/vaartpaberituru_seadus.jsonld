      },
      "estleg:versionValidTo": {
        "@value": "2017-04-16",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_188_19_v107042017004",
      "@type": [
        "owl:NamedIndividual",
