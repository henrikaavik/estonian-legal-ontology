      },
      "estleg:versionValidTo": {
        "@value": "2018-01-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_88_12_v130122017042",
      "@type": [
        "owl:NamedIndividual",
