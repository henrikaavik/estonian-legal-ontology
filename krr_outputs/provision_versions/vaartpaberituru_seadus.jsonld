        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_14_v129032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kliendi korralduse parima täitmise, selleks vajalike meetmete kehtestamise või rakendamise või määratud hinnaga korralduse avalikustamise kohustuse rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_14 (redaktsioon 129032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129032022013",
