      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VPTS_Par_88_11 (redaktsioon 130122017042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122017042"
    },
    {
      "@id": "estleg:VPTS_Par_88_12_v12881089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_88_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Inspektsioon teostab järelevalvet: investeerimisühingu poolt korrapäraselt käesoleva seaduse §-s 88 7 sätestatud hinnanoteeringu avaldamise üle ja nimetatud hinnanoteeringu viivitamatu muutmise vastavuse üle valitsevatele turutingimustele; investeerimisühingu poolt § 88 11 lõike 3 nõuete täitmise üle.",
      "rdfs:label": {
        "@value": "VPTS_Par_88_12 (redaktsioon 12881089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12881089",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_88_12_v122122010026"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_88_12_v122122010026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_88_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Inspektsioon teostab järelevalvet: investeerimisühingu poolt korrapäraselt käesoleva seaduse §-s 887 sätestatud hinnanoteeringu avaldamise üle ja nimetatud hinnanoteeringu viivitamatu muutmise vastavuse üle valitsevatele turutingimustele; investeerimisühingu poolt § 8811 lõike 3 nõuete täitmise üle.",
      "rdfs:label": {
        "@value": "VPTS_Par_88_12 (redaktsioon 122122010026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122010026",
      "estleg:supersededByVersion": {
