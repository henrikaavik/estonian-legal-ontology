      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sihtemitendi üle valitseva mõju otse või kooskõlastatult tegutsevate isikutega koos saanud isik on kohustatud 20 päeva jooksul valitseva mõju saamisest arvates tegema vähemalt 28 päeva kestva ülevõtmispakkumise sihtemitendi kõigi aktsiate suhtes. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "VPTS_Par_166 (redaktsioon 750796)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750796",
      "estleg:supersededByVersion": {
