      }
    },
    {
      "@id": "estleg:VPTS_Par_237_1_v129032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2017/1129 artiklites 3, 5 ja 6, artikli 7 lõigetes 1–11, artiklites 8–10, artikli 11 lõigetes 1 ja 3, artikli 14 lõigetes 1 ja 2, artikli 15 lõikes 1, artikli 16 lõigetes 1–3, artiklites 17 ja 18, artikli 19 lõigetes 1–3, artikli 20 lõikes 1, artikli 21 lõigetes 1–4 ja 7–11, artikli 22 lõigetes 2–5, artikli 23 lõigetes 1–3 ja 5 või artiklis 27, samuti käesoleva seaduse § 15 lõikes 7 sätestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_1 (redaktsioon 129032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129032022013",
