      }
    },
    {
      "@id": "estleg:VPTS_Par_237_31_v117032023030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-s 185 sätestatud häälte arvust teavitamise kohustuse rikkumise eest –karistatakse rahatrahviga kuni 2 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 10 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni viis protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_31 (redaktsioon 117032023030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023030"
    },
    {
      "@id": "estleg:VPTS_Par_237_32_v864477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Insaiderite nimekirja puudumise, ennetähtaegse hävitamise, samuti insaiderite nimekirjas ebaõige või ebatäpse teabe esitamise või käesolevas seaduses või selle alusel antud õigusaktis nõutud teabe puudumise eest – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_32 (redaktsioon 864477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "864477",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_32_v12881089"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-18",
        "@type": "xsd:date"
      }
    },
