        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. jaanuaril. (2) Käesoleva seaduse §-d 38, 64, 65, 69 ja § 70 lõiked 2–4 jõustuvad Eesti ühinemisel Euroopa Liiduga.",
      "rdfs:label": {
        "@value": "VPTS_Par_277 (redaktsioon 192382)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "192382",
      "estleg:supersededByVersion": {
