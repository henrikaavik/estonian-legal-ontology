      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turukuritarvituse määruse artikli 19 lõigetes 1–3, 5–7 ja 11 sätestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud seotud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_30 (redaktsioon 107042017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107042017004",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_30_v104122019003"
      },
      "estleg:versionValidTo": {
