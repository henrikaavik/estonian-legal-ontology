    {
      "@id": "estleg:VPTS_Par_147_1_v130122017042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_147_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korraldaja ja turul osalejad sünkroniseerivad mis tahes teavitamisele kuuluva sündmuse kuupäeva ja kellaaja registreerimiseks kasutatavad kellad vastavalt komisjoni delegeeritud määrusele (EL) nr 2017/574, millega täiendatakse Euroopa Parlamendi ja nõukogu direktiivi 2014/65/EL seoses äritegevuses kasutatavate kellade täpsust käsitlevate regulatiivsete tehniliste standarditega (ELT L 87, 31.03.2017, lk 148–151).",
      "rdfs:label": {
        "@value": "VPTS_Par_147_1 (redaktsioon 130122017042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122017042",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_147_1_v130122025005"
      },
      "estleg:versionValidTo": {
        "@value": "2026-01-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_147_1_v130122025005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_147_1"
      },
      "estleg:versionValidFrom": {
