        "@id": "estleg:VPTS_Par_79_v129032022013"
      },
      "estleg:versionValidTo": {
        "@value": "2022-04-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_79_v129032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_79"
