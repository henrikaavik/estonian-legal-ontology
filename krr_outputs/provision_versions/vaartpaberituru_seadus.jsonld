      }
    },
    {
      "@id": "estleg:VPTS_Par_237_14_v117032023030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kliendi korralduse parima täitmise, selleks vajalike meetmete kehtestamise või rakendamise või määratud hinnaga korralduse avalikustamise kohustuse rikkumise eest –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni 10 protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_14 (redaktsioon 117032023030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023030"
    },
    {
