    },
    {
      "@id": "estleg:VPTS_Par_106_v114112015002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_106"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-11-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühing peab viivitamata teavitama inspektsiooni ning esitama omapoolse selgituse, kui investeerimisühingu omavahendite suurus väheneb rohkem kui viie protsendi võrra.",
      "rdfs:label": {
        "@value": "VPTS_Par_106 (redaktsioon 114112015002)",
