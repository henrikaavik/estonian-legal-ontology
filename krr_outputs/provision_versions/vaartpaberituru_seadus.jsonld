      },
      "estleg:versionValidTo": {
        "@value": "2007-11-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_24_v12881089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Emitendi poolt käesoleva seaduse §-s 187 4 või 187 5 sätestatud teabe esitamata jätmise või ebaõige esitamise eest – karistatakse rahatrahviga kuni 500 000 krooni.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_24 (redaktsioon 12881089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12881089",
