        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_166_v750796",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
