      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VPTS_Par_20 (redaktsioon 104122019003)",
        "@language": "et"
