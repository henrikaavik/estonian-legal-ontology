      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühingu või krediidiasutuse poolt käesoleva seaduse §-s 876 sätestatud määratud hinnaga korralduse avalikustamata jätmise, viivitusega avalikustamise või ebaõige avalikustamise eest, kui inspektsioon ei olnud seda investeerimisühingut või krediidiasutust vabastanud avalikustamise kohustuse täitmisest, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_14 (redaktsioon 122122010026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122010026",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_14_v130122017042"
      },
