      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VPTS_Par_188_16 (redaktsioon 107042017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107042017004"
    },
    {
      "@id": "estleg:VPTS_Par_188_17_v864477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_188_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ajakirjaniku poolt oma töö- või ametiülesannete täitmisel käesoleva seaduse § 188 15 lõike 1 punktis 4 sätestatud teabe levitamise korral hinnatakse ajakirjaniku käitumist, lähtudes ajakirjaniku kutset reguleerivatest õigusaktidest, kui ajakirjanik ei saanud nimetatud teabe levitamisest otseselt või kaudselt kasu, eelist või õigust.",
      "rdfs:label": {
        "@value": "VPTS_Par_188_17 (redaktsioon 864477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "864477",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_188_17_v122122010026"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_188_17_v122122010026",
