      "estleg:versionRedactionId": "101032023059"
    },
    {
      "@id": "estleg:VPTS_Par_213_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_213"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väärtpaberiarveldussüsteem (edaspidi käesolevas osas süsteem ) on kolme või enama süsteemi liikme ning süsteemi korraldaja vahel sõlmitud lepingu alusel väärtpaberitehingutest tekkinud kohustuste täitmiseks ja süsteemis osalemisest tekkinud kohustuste täitmise tagamiseks moodustatud organisatsiooniliste, tehniliste ja õiguslike lahenduste kogum. (2) Käesoleva seaduse tähenduses mõistetakse ülekandekorraldusena väärtpaberitehingutest tekkinud kohustuste täitmiseks antud maksekäsundeid või väärtpaberite üleandmiseks antud korraldusi.",
      "rdfs:label": {
        "@value": "VPTS_Par_213 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_213_v122122010026"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_213_v122122010026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_213"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väärtpaberiarveldussüsteem (edaspidi käesolevas osas süsteem) on kolme või enama süsteemi liikme ning süsteemi korraldaja vahel sõlmitud lepingu alusel väärtpaberitehingutest tekkinud kohustuste täitmiseks ja süsteemis osalemisest tekkinud kohustuste täitmise tagamiseks moodustatud organisatsiooniliste, tehniliste ja õiguslike lahenduste kogum. (2) Käesoleva seaduse tähenduses mõistetakse ülekandekorraldusena väärtpaberitehingutest tekkinud kohustuste täitmiseks antud maksekäsundeid või väärtpaberite üleandmiseks antud korraldusi.",
      "rdfs:label": {
        "@value": "VPTS_Par_213 (redaktsioon 122122010026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122010026",
