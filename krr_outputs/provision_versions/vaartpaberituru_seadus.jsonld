      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_277"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. jaanuaril. (2) Käesoleva seaduse §-d 38, 64, 65, 69 ja § 70 lõiked 2–4 jõustuvad Eesti ühinemisel Euroopa Liiduga. (3) Käesoleva seaduse § 230 lõike 1 punkt 6 jõustub 2018. aasta 3. jaanuaril.",
      "rdfs:label": {
