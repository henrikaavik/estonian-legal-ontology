      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_24_v122122010026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
