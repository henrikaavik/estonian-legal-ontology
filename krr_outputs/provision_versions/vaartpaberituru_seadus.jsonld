      "estleg:versionRedactionId": "104122019003"
    },
    {
      "@id": "estleg:VPTS_Par_201_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_201"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turuga manipuleerimine on keelatud. (2) Investeerimisühingul, kes on teadlik või kellel on kahtlus turuga manipuleerimisest või selle katsest, on keelatud vastavat tehingut vahendada ja kohustus sellest viivitamata teavitada inspektsiooni.",
      "rdfs:label": {
        "@value": "VPTS_Par_201 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_201_v13313249"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_201_v13313249",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
