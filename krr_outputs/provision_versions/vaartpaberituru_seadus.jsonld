      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud –",
      "rdfs:label": {
        "@value": "VPTS_Par_201 (redaktsioon 13313249)",
        "@language": "et"
      },
