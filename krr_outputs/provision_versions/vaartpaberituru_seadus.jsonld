      },
      "estleg:versionValidTo": {
        "@value": "2005-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_212_v864477",
      "@type": [
        "owl:NamedIndividual",
