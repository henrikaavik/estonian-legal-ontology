      }
    },
    {
      "@id": "estleg:VPTS_Par_173_v13148804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtemitendi üle valitseva mõju saanud isiku vastava kirjaliku avalduse alusel on inspektsioonil õigus teha erand kohustusliku ülevõtmispakkumise nõudest järgneva asjaolu esinemisel: äriühing sai sihtemitendi üle valitseva mõju temaga samasse kontserni kuuluvalt ühingult ning pärast valitseva mõju saamist kuulub äriühing jätkuvalt samasse kontserni; valitsev mõju saadi sihtemitendi aktsiakapitali vähendamise tulemusena; valitsev mõju saadi ühinemise või jagunemise läbiviimiseks enne ühinemis- või jagunemislepingu heakskiitmist ühinevate ühingute poolt või jaguneva sihtemitendi aktsionäride üldkoosoleku poolt tingimusel, et sihtemitendi ühinemise või jagunemise tõttu isiku või kooskõlastatult tegutsevate isikute valitsev mõju lõpeb; aktsiad omandati lühikeseks tähtajaks edasise võõrandamise eesmärgil, kuid sellega kaasnes valitseva mõju omandamine, sealhulgas väärtpaberite omandamisel kauplemisportfelli, aktsiate emiteerimise tagamisel ja aktsiate omandamisel emitendi poolt; valitsev mõju saadi eelneva kavatsuseta saada valitsev mõju sihtemitendi üle ning valitseva mõju saaja loobub sellest kolmanda isiku kasuks, kes ei ole temaga kooskõlastatult tegutsev isik, 10 tööpäeva jooksul, arvates valitseva mõju saamisest, tingimusel, et nimetatud tähtaja jooksul ei toimu sihtemitendi aktsionäride üldkoosolekut; aktsionär sai valitseva mõju temale seaduse kohaselt kuulunud ning mitte teistelt isikutelt omandatud aktsiate märkimiseesõiguste teostamise tõttu. valitsev mõju saadi pärimise, kinkimise või abieluvara jaotamise tulemusel ning valitseva mõju saaja loobub sellest kolmanda isiku kasuks, kes ei ole temaga kooskõlastatult tegutsev isik, 10 tööpäeva jooksul, arvates valitseva mõju saamisest, tingimusel, et nimetatud tähtaja jooksul ei toimu sihtemitendi aktsionäride üldkoosolekut; valitsev mõju saadi sihtemitendi ümberkujundamise, saneerimise või tervendamise tulemusel ning valitseva mõju saaja loobub sellest kolmanda isiku kasuks, kes ei ole temaga kooskõlastatult tegutsev isik, 10 tööpäeva jooksul, arvates valitseva mõju saamisest, tingimusel, et nimetatud tähtaja jooksul ei toimu sihtemitendi aktsionäride üldkoosolekut; valitsev mõju saadi pantimise või finantstagatise seadmise tulemusel ning valitseva mõju saaja loobub sellest kolmanda isiku kasuks, kes ei ole temaga kooskõlastatult tegutsev isik, 10 tööpäeva jooksul, arvates valitseva mõju saamisest, tingimusel, et nimetatud tähtaja jooksul ei toimu sihtemitendi aktsionäride üldkoosolekut.",
      "rdfs:label": {
        "@value": "VPTS_Par_173 (redaktsioon 13148804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13148804",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_173_v130062017021"
      },
      "estleg:versionValidTo": {
        "@value": "2017-07-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_173_v130062017021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtemitendi üle valitseva mõju saanud isiku vastava kirjaliku avalduse alusel on inspektsioonil õigus teha erand kohustusliku ülevõtmispakkumise nõudest järgneva asjaolu esinemisel: äriühing sai sihtemitendi üle valitseva mõju temaga samasse kontserni kuuluvalt ühingult ning pärast valitseva mõju saamist kuulub äriühing jätkuvalt samasse kontserni; valitsev mõju saadi sihtemitendi aktsiakapitali vähendamise tulemusena; valitsev mõju saadi ühinemise või jagunemise läbiviimiseks enne ühinemis- või jagunemislepingu heakskiitmist ühinevate ühingute poolt või jaguneva sihtemitendi aktsionäride üldkoosoleku poolt tingimusel, et sihtemitendi ühinemise või jagunemise tõttu isiku või kooskõlastatult tegutsevate isikute valitsev mõju lõpeb; aktsiad omandati lühikeseks tähtajaks edasise võõrandamise eesmärgil, kuid sellega kaasnes valitseva mõju omandamine, sealhulgas väärtpaberite omandamisel kauplemisportfelli, aktsiate emiteerimise tagamisel ja aktsiate omandamisel emitendi poolt; valitsev mõju saadi eelneva kavatsuseta saada valitsev mõju sihtemitendi üle ning valitseva mõju saaja loobub sellest kolmanda isiku kasuks, kes ei ole temaga kooskõlastatult tegutsev isik, 10 tööpäeva jooksul, arvates valitseva mõju saamisest, tingimusel, et nimetatud tähtaja jooksul ei toimu sihtemitendi aktsionäride üldkoosolekut; aktsionär sai valitseva mõju temale seaduse kohaselt kuulunud ning mitte teistelt isikutelt omandatud aktsiate märkimiseesõiguste teostamise tõttu. valitsev mõju saadi pärimise, kinkimise või abieluvara jaotamise tulemusel ning valitseva mõju saaja loobub sellest kolmanda isiku kasuks, kes ei ole temaga kooskõlastatult tegutsev isik, 10 tööpäeva jooksul, arvates valitseva mõju saamisest, tingimusel, et nimetatud tähtaja jooksul ei toimu sihtemitendi aktsionäride üldkoosolekut; valitsev mõju saadi sihtemitendi ümberkujundamise, saneerimise või tervendamise tulemusel; valitsev mõju saadi pantimise või finantstagatise seadmise tulemusel.",
      "rdfs:label": {
        "@value": "VPTS_Par_173 (redaktsioon 130062017021)",
        "@language": "et"
      },
