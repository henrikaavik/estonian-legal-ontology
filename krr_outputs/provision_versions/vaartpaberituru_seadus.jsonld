    {
      "@id": "estleg:VPTS_Par_184_11_v13278847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_184_11"
