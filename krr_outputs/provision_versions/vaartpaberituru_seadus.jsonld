        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_1_v130122025005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2017/1129 artiklites 3, 5 ja 6, artikli 7 lõigetes 1–11 ja 12a, artiklites 8, 9 ja 10, artikli 11 lõigetes 1 ja 3, artikli 14a lõikes 1, artikli 15a lõikes 1, artikli 16 lõigetes 1, 2 ja 3, artiklites 17 ja 18, artikli 19 lõigetes 1, 2 ja 3, artikli 20 lõikes 1, artikli 21 lõigetes 1–4 ja 7–11, artikli 22 lõigetes 2–5, artikli 23 lõigetes 1, 2, 3, 4a ja 5 ning artiklis 27 sätestatud nõuete rikkumise ning käesoleva seaduse § 15 lõikes 6 sätestatud teabe avaldamata jätmise eest –karistatakse rahatrahviga kuni 700 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni kolm protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_1 (redaktsioon 130122025005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122025005"
    },
    {
      "@id": "estleg:VPTS_Par_237_10_v192382",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühingu poolt investeerimisteenuse osutamisel andmete registreerimata ja säilitamata jätmise eest – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_10 (redaktsioon 192382)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "192382",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_10_v864477"
      },
      "estleg:versionValidTo": {
        "@value": "2005-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_10_v864477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühingu, krediidiasutuse või muu investeerimisteenuse osutaja poolt investeerimisteenuse osutamisel andmete registreerimise ja säilitamise või reguleeritud turu korraldaja poolt reguleeritud turul tehtud tehingute registreerimise kohustuse rikkumise eest – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_10 (redaktsioon 864477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "864477",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_10_v12881089"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_10_v12881089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühingu, krediidiasutuse, fondivalitseja, kes osutab investeerimisteenuseid, või reguleeritud turu korraldaja poolt käesolevas seaduses sätestatud sise-eeskirjade kehtestamata või rakendamata jätmise eest – karistatakse rahatrahviga kuni 500 000 krooni.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_10 (redaktsioon 12881089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12881089",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_10_v122122010026"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_10_v122122010026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühingu, krediidiasutuse, fondivalitseja, kes osutab investeerimisteenuseid, või reguleeritud turu korraldaja poolt käesolevas seaduses sätestatud sise-eeskirjade kehtestamata või rakendamata jätmise eest –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_10 (redaktsioon 122122010026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122010026",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_10_v130122017042"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_10_v130122017042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatud sise-eeskirja kehtestamise või rakendamise kohustuse rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_10 (redaktsioon 130122017042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122017042",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_10_v129032022013"
      },
      "estleg:versionValidTo": {
        "@value": "2022-04-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_10_v129032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Investeerimisühingu tegevuse laadi, ulatust ja keerukust arvestades ebapiisava või käesolevas seaduses või komisjoni delegeeritud määruses (EL) 2017/565 sätestatud nõuetele mittevastava organisatsioonilise ülesehituse, sisekontrollisüsteemi, tasustamise, riskide tuvastamise, mõõtmise või juhtimise või sise-eeskirjade või aruannete esitamise korra kehtestamise või rakendamise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_10 (redaktsioon 129032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129032022013",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_10_v117032023030"
      },
      "estleg:versionValidTo": {
        "@value": "2023-10-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_10_v117032023030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Investeerimisühingu tegevuse laadi, ulatust ja keerukust arvestades ebapiisava või käesolevas seaduses või komisjoni delegeeritud määruses (EL) 2017/565 sätestatud nõuetele mittevastava organisatsioonilise ülesehituse, sisekontrollisüsteemi, tasustamise, riskide tuvastamise, mõõtmise või juhtimise või sise-eeskirjade või aruannete esitamise korra kehtestamise või rakendamise eest –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni 10 protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_10 (redaktsioon 117032023030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023030"
    },
    {
      "@id": "estleg:VPTS_Par_237_11_v192382",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühingu poolt reguleeritud turule kauplemisele lubatud väärtpaberitega seoses investeerimisteenuste osutamisega tehtud tehingutest teavitamata jätmise eest – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_11 (redaktsioon 192382)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "192382",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_11_v864477"
      },
      "estleg:versionValidTo": {
        "@value": "2005-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_11_v864477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühingu, krediidiasutuse või muu investeerimisteenuse osutaja poolt käesolevas seaduses sätestatud väärtpaberitehingutest teavitamise kohustuse täitmata jätmise või ebakohase täitmise eest – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_11 (redaktsioon 864477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "864477",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_11_v12881089"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_11_v12881089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühingu, krediidiasutuse ja fondivalitseja, kes osutab investeerimisteenuseid, poolt käesoleva seaduse § 85 2 tähenduses investeerimisteenuse mitteõiguspäraselt osutamise eest – karistatakse rahatrahviga kuni 500 000 krooni.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_11 (redaktsioon 12881089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12881089",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_11_v122122010026"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_11_v122122010026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisühingu, krediidiasutuse ja fondivalitseja, kes osutab investeerimisteenuseid, poolt käesoleva seaduse § 852 tähenduses investeerimisteenuse mitteõiguspäraselt osutamise eest –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_11 (redaktsioon 122122010026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122010026",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_11_v130122017042"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_11_v130122017042",
      "@type": [
