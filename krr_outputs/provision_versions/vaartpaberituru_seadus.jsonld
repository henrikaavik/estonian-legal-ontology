      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Emitendi poolt käesoleva seaduse §-s 1874 või 1875 sätestatud teabe esitamata jätmise või ebaõige esitamise eest –karistatakse rahatrahviga kuni 32 000 eurot.",
