      }
    },
    {
      "@id": "estleg:VPTS_Par_202_v130122017042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_202"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turu vahekohus (edaspidi vahekohus) on Eesti turu korraldaja poolt moodustatav alaliselt tegutsev vahekohus, mis lahendab turu ja selle korraldajaga seotud lepingu- ja teistest tsiviilõiguslikest suhetest tulenevaid vaidlusi. (2) Turu korraldaja teatab inspektsioonile, kas tema juures tegutseb alaliselt vahekohus. Vahekohtu tegutsemisel esitab turu korraldaja inspektsioonile vahekohtu koosseisu ja tegutsemise seadusele vastavust kinnitava kirjaliku teabe. (3) Inspektsioon teatab seaduslikult alaliselt tegutsevast vahekohtust kohtutele või muudele kohtuotsuste täitmist korraldavatele riigiasutustele.",
      "rdfs:label": {
        "@value": "VPTS_Par_202 (redaktsioon 130122017042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122017042",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_202_v119032019076"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_202_v119032019076",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_202"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turu vahekohus (edaspidi vahekohus) on Eesti turu korraldaja poolt moodustatav vahekohus, mis lahendab turu ja selle korraldajaga seotud lepingu- ja teistest tsiviilõiguslikest suhetest tulenevaid vaidlusi. (2) Turu korraldaja teatab inspektsioonile, kas tema juures tegutseb alaliselt vahekohus. Vahekohtu tegutsemisel esitab turu korraldaja inspektsioonile vahekohtu koosseisu ja tegutsemise seadusele vastavust kinnitava kirjaliku teabe. (3) Inspektsioon teatab seaduslikult tegutsevast vahekohtust kohtutele või muudele kohtuotsuste täitmist korraldavatele riigiasutustele.",
      "rdfs:label": {
        "@value": "VPTS_Par_202 (redaktsioon 119032019076)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019076"
    },
    {
      "@id": "estleg:VPTS_Par_203_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_203"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahekohus lahendab vaidlusi hagiavalduste alusel, kui: poolte vahel on kirjalik kokkulepe juba tekkinud või tekkida võiva vaidluse üleandmise kohta vahekohtu lahendada; nõusolek vaidluse lahendamiseks vahekohtus on väljendatud hageja poolt hagi esitamisega, kostja poolt aga tegevusega, mis annab tunnistust tema vabatahtlikust allumisest vahekohtu jurisdiktsioonile.",
      "rdfs:label": {
        "@value": "VPTS_Par_203 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312"
    },
    {
      "@id": "estleg:VPTS_Par_204_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_204"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vahekohtu nõukogus on kuni kuus liiget. Vahekohtu nõukogu määratakse kuni kaheks aastaks vastavalt vahekohtu reglemendile. (2) Vahekohtu nõukogu põhiliseks ülesandeks on arvata isikuid vahekohtu nimekirja ning sellest välja, samuti pidada vahekohtunike nimekirja. Vahekohtu nõukogu muud õigused ja kohustused sätestatakse vahekohtu reglemendis. (3) Vahekohtu nõukogu liikmel peab olema juriidiline akadeemiline kõrgharidus. Vahekohtunikul peab olema akadeemiline kõrgharidus või sellega võrdsustatud haridus. (4) Vahekohtunikud on oma kohustuste täitmisel sõltumatud.",
      "rdfs:label": {
        "@value": "VPTS_Par_204 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312"
    },
    {
      "@id": "estleg:VPTS_Par_205_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_205"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahekohtu nõukogu töökorda, samuti vahekohtu moodustamise ja vaidluste lahendamise korda reguleeritakse vahekohtu reglemendiga, mille kinnitab vastav korraldaja.",
      "rdfs:label": {
        "@value": "VPTS_Par_205 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_205_v130122017042"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_205_v130122017042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_205"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahekohtu nõukogu töökorda, samuti vahekohtu moodustamise ja vaidluste lahendamise korda reguleeritakse vahekohtu reglemendiga, mille kinnitab vastav turu korraldaja.",
      "rdfs:label": {
        "@value": "VPTS_Par_205 (redaktsioon 130122017042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122017042"
    },
    {
      "@id": "estleg:VPTS_Par_206_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_206"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vaidlusi vaatab vahekohtus läbi vastavalt vahekohtu reglemendile poolte valitud või vahekohtu nõukogu määratud üks või mitu vahekohtunikku. (2) Vaidluste läbivaatamine vahekohtus on tasuta või tasuline vastavalt vahekohtu reglemendile. Vahekohtu tasu määr ning tasumise kord sätestatakse vahekohtu reglemendis. (3) Vahekohus arvestab vaidluse lahendamisel õigusaktides ja turu reglemendis sätestatut, samuti turul ausa ja õiglase kauplemise suhtes kehtivaid ja muid häid äritavasid.",
      "rdfs:label": {
        "@value": "VPTS_Par_206 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_206_v960857"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_206_v960857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_206"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vaidlusi vaatab vahekohtus läbi vastavalt vahekohtu reglemendile poolte valitud või vahekohtu nõukogu määratud üks või mitu vahekohtunikku. (2) Vaidluste läbivaatamine vahekohtus on tasuta või tasuline vastavalt vahekohtu reglemendile. Vahekohtu tasu määr ning tasumise kord sätestatakse vahekohtu reglemendis. (3) Vahekohus arvestab vaidluse lahendamisel õigusaktides ja turu reglemendis sätestatut, samuti turul ausa ja õiglase kauplemise suhtes kehtivaid ja muid häid äritavasid. [Paragrahvi 207 sõnastus kuni 31. 12. 2005]",
      "rdfs:label": {
        "@value": "VPTS_Par_206 (redaktsioon 960857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "960857",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_206_v12881089"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_206_v12881089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_206"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vaidlusi vaatab vahekohtus läbi vastavalt vahekohtu reglemendile poolte valitud või vahekohtu nõukogu määratud üks või mitu vahekohtunikku. (2) Vaidluste läbivaatamine vahekohtus on tasuta või tasuline vastavalt vahekohtu reglemendile. Vahekohtu tasu määr ning tasumise kord sätestatakse vahekohtu reglemendis. (3) Vahekohus arvestab vaidluse lahendamisel õigusaktides ja turu reglemendis sätestatut, samuti turul ausa ja õiglase kauplemise suhtes kehtivaid ja muid häid äritavasid.",
      "rdfs:label": {
        "@value": "VPTS_Par_206 (redaktsioon 12881089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12881089"
    },
    {
      "@id": "estleg:VPTS_Par_207_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_207"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vahekohus võib poole avalduse alusel rakendada järgmisi hagi tagamise abinõusid: kostjale kuuluva kinnisvara võõrandamise keelumärge või kohtuliku hüpoteegi seadmine kinnistusraamatus ja tema või teiste isikute juures oleva vallasvara või rahasummade arestimine hagihinda arvestades; kostjal teatud tehingute ja toimingute keelamine. (2) Vahekohtu otsust, millega on määratud hagi tagamise abinõu, täidetakse samal viisil nagu vahekohtu lõppotsust vaidluse lahendamise kohta. (3) Hagi tagamisega põhjustatava võimaliku kahju hüvitamiseks võib vahekohus nõuda avaldajalt raha ettemaksmist vahekohtu deposiiti. (4) Kui vahekohus jätab hagi rahuldamata ja kui hageja taotlusel hagi tagamisega on kostjale tekitatud kahju, on kostjal õigus nõuda kahju hüvitamist hagejalt.",
      "rdfs:label": {
        "@value": "VPTS_Par_207 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_207_v960857"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_207_v960857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_207"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vahekohus võib poole avalduse alusel rakendada järgmisi hagi tagamise abinõusid: kostjale kuuluva kinnisvara võõrandamise keelumärge või kohtuliku hüpoteegi seadmine kinnistusraamatus ja tema või teiste isikute juures oleva vallasvara või rahasummade arestimine hagihinda arvestades; kostjal teatud tehingute ja toimingute keelamine. (2) Vahekohtu otsust, millega on määratud hagi tagamise abinõu, täidetakse samal viisil nagu vahekohtu lõppotsust vaidluse lahendamise kohta. (3) Hagi tagamisega põhjustatava võimaliku kahju hüvitamiseks võib vahekohus nõuda avaldajalt raha ettemaksmist vahekohtu deposiiti. (4) Kui vahekohus jätab hagi rahuldamata ja kui hageja taotlusel hagi tagamisega on kostjale tekitatud kahju, on kostjal õigus nõuda kahju hüvitamist hagejalt. [Paragrahvi 207 sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "VPTS_Par_207 (redaktsioon 960857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "960857",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_207_v12881089"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_207_v12881089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_207"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vahekohus võib poole avalduse alusel hagi tagada, kui pooled ei ole kokku leppinud teisiti. Hagi tagamiseks võib vahekohus määrata tsiviilkohtumenetluse seadustikus ettenähtud hagi tagamise abinõu, välja arvatud isikuvabadust piirava hagi tagamise abinõu. Vahekohus võib seoses hagi tagamisega nõuda mõlemalt poolelt mõistliku tagatise andmist. (2) Käesoleva paragrahvi lõike 1 alusel määratud hagi tagamise otsus täidetakse maakohtu määruse alusel. Maakohus teeb määruse poole avalduse alusel hagita menetluses ja lubab hagi tagamise otsuse täitmist üksnes juhul, kui sama hagi tagamise abinõu ei ole juba kohtult taotletud. Maakohus võib hagi tagamise määruse teisiti sõnastada, kui see on vajalik hagi tagamise abinõu rakendamiseks. (3) Maakohus võib hagi tagamise määruse avalduse alusel tühistada või seda muuta. (4) Kui selgub, et hagi tagamine vahekohtumenetluses ei olnud õigustatud, peab hagi tagamist taotlenud pool hüvitama vastaspoolele kahju, mis on sellel poolel tekkinud hagi tagamisest või hagi tagamise abinõu rakendamise vältimiseks antud tagatisest.",
      "rdfs:label": {
        "@value": "VPTS_Par_207 (redaktsioon 12881089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12881089"
    },
    {
      "@id": "estleg:VPTS_Par_208_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_208"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahekohus võib taotleda maa- või linnakohtult abi tõendamismenetluseks või muudeks kohtutoiminguteks, mis ei ole vahekohtu pädevuses. Kohus lahendab taotluse vastavalt tõendamismenetluse või muude kohtutoimingute kohta kehtivatele menetlussätetele.",
      "rdfs:label": {
        "@value": "VPTS_Par_208 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_208_v960857"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_208_v960857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_208"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahekohus võib taotleda maa- või linnakohtult abi tõendamismenetluseks või muudeks kohtutoiminguteks, mis ei ole vahekohtu pädevuses. Kohus lahendab taotluse vastavalt tõendamismenetluse või muude kohtutoimingute kohta kehtivatele menetlussätetele. [Paragrahvi 208 sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "VPTS_Par_208 (redaktsioon 960857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "960857",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_208_v12881089"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_208_v12881089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_208"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahekohus võib taotleda maakohtult abi tõendamismenetluseks või muudeks kohtutoiminguteks, mis ei ole vahekohtu pädevuses. Kohus lahendab taotluse vastavalt tõendamismenetluse või muude kohtutoimingute kohta kehtivatele menetlussätetele.",
      "rdfs:label": {
        "@value": "VPTS_Par_208 (redaktsioon 12881089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12881089"
    },
    {
      "@id": "estleg:VPTS_Par_209_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_209"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi seaduse «Eesti Kaubandus-Tööstuskoja Arbitraaþikohtu kohta» (RT 1991, 25, 308; RT I 1999, 18, 302) §-des 7 ja 7 1 sätestatut kohaldatakse seoses menetlusega vahekohtus.",
      "rdfs:label": {
