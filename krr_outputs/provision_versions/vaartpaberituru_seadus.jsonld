      }
    },
    {
      "@id": "estleg:VPTS_Par_237_1_v117032023030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2017/1129 artiklites 3, 5 ja 6, artikli 7 lõigetes 1–11, artiklites 8–10, artikli 11 lõigetes 1 ja 3, artikli 14 lõigetes 1 ja 2, artikli 15 lõikes 1, artikli 16 lõigetes 1–3, artiklites 17 ja 18, artikli 19 lõigetes 1–3, artikli 20 lõikes 1, artikli 21 lõigetes 1–4 ja 7–11, artikli 22 lõigetes 2–5, artikli 23 lõigetes 1–3 ja 5 või artiklis 27, samuti käesoleva seaduse § 15 lõikes 7 sätestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 700 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni kolm protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_1 (redaktsioon 117032023030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023030",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_237_1_v111112025007"
      },
      "estleg:versionValidTo": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_237_1_v111112025007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2017/1129 artiklites 3, 5 ja 6, artikli 7 lõigetes 1–11, artiklites 8–10, artikli 11 lõigetes 1 ja 3, artikli 14 lõigetes 1 ja 2, artikli 15 lõikes 1, artikli 16 lõigetes 1–3, artiklites 17 ja 18, artikli 19 lõigetes 1–3, artikli 20 lõikes 1, artikli 21 lõigetes 1–4 ja 7–11, artikli 22 lõigetes 2–5, artikli 23 lõigetes 1–3 ja 5 või artiklis 27 sätestatud nõuete rikkumise ning käesoleva seaduse § 15 lõikes 6 sätestatud teabe avaldamata jätmise eest –karistatakse rahatrahviga kuni 700 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni kolm protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_1 (redaktsioon 111112025007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111112025007",
