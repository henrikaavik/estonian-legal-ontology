        "@language": "et"
      },
      "estleg:versionRedactionId": "107042017004"
    },
    {
      "@id": "estleg:VPTS_Par_28_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
