    {
      "@id": "estleg:VPTS_Par_40_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_40"
      },
      "estleg:versionValidFrom": {
