    {
      "@id": "estleg:VPTS_Par_94_1_v109052014020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_94_1"
