    },
    {
      "@id": "estleg:VPTS_Par_145_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korraldaja on kohustatud avalikustama käesoleva seaduse §-s 143 nimetatud teabe oma veebilehel, ringhäälingus või üleriigilise levikuga ajalehes. (2) Käesoleva seaduse §-s 144 nimetatud kauplemisteabe on korraldaja kohustatud avalikustama oma veebilehel. (3) Käesoleva paragrahvi lõikes 1 ja 2 nimetatud teave avalikustatakse eesti keeles. Lisaks eesti keelele võib vastava teabe avalikustada ka mõnes muus keeles.",
      "rdfs:label": {
        "@value": "VPTS_Par_145 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_145_v960857"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_145_v960857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korraldaja on kohustatud avalikustama käesoleva seaduse §-s 143 nimetatud teabe oma veebilehel, ringhäälingus või üleriigilise levikuga ajalehes. (2) Käesoleva seaduse §-s 144 nimetatud kauplemisteabe on korraldaja kohustatud avalikustama oma veebilehel. (3) Käesoleva paragrahvi lõikes 1 ja 2 nimetatud teave avalikustatakse eesti või inglise keeles. Lisaks eesti või inglise keelele võib teabe avalikustada ka mõnes muus keeles.",
      "rdfs:label": {
        "@value": "VPTS_Par_145 (redaktsioon 960857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "960857",
