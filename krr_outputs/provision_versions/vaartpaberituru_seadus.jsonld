    {
      "@id": "estleg:VPTS_Par_209_v12881089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_209"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Huvitatud pool võib nõuda vahekohtu otsuse tühistamist tsiviilkohtumenetluse seadustikus sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "VPTS_Par_209 (redaktsioon 12881089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12881089"
    },
    {
      "@id": "estleg:VPTS_Par_21_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Inspektsioonil on õigus keelduda prospekti registreerimisest, kui: pakkumise tingimused on vastuolus kehtivate õigusaktidega, emitendi põhikirjaga või reguleeritud turu reglemendiga; prospekt ei vasta õigusaktidega kehtestatud nõuetele ning tegemist on oluliste puudustega; pakkuja ei ole taotlemisel esitanud kõiki õigusaktidega ettenähtud dokumente või nimetatud dokumendid on omavahel vastuolus või ei ole täidetud käesoleva seaduse § 18 lõikes 3 sätestatud nõuet.",
      "rdfs:label": {
        "@value": "VPTS_Par_21 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_21_v750796"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_21_v750796",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
