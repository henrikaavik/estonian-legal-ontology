        "@value": "2013-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Inspektsioonile turukuritarvitusest või selle kahtlusest enne turukuritarvituse toimumist või viivitamata pärast seda esimesena kirjalikult teatanud isiku suhtes võib lõpetada käesolevas seaduses sätestatud turukuritarvituse kohta algatatud väärteomenetluse otstarbekuse kaalutlusel.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_49 (redaktsioon 126042013010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126042013010"
    },
    {
      "@id": "estleg:VPTS_Par_237_5_v192382",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
