        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse jõustumise päevast tunnistatakse seni kehtinud väärtpaberituru seadus (RT I 1993, 35, 543; 1995, 22, 328; 1996, 26, 528; 1997, 34, 535; 1998, 61, 979; 2000, 10, 55) kehtetuks.",
      "rdfs:label": {
        "@value": "VPTS_Par_263 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
