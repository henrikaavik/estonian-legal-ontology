      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) nr 596/2014 artikli 19 lõigetes 1–3, 5–7 ja 11 sätestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud seotud juriidiline isik, –karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_30 (redaktsioon 129032022013)",
