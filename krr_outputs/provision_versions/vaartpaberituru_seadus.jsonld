      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Investeerimisühingu juhatuse liikmete ja töötajate tasustamise põhimõtetele, sealhulgas nende kujundamisele ja järgimise kontrollimisele, kohaldatakse krediidiasutuste seaduse § 52 lõike 4 punktis 21 ja lõikes 41, §-des 571–574, § 59 lõigetes 3 ja 43, § 63 lõike 2 punktis 51 ja §-s 922 sätestatut, kui see on asjakohane ja proportsionaalne, arvestades investeerimisühingu tegevuse laadi, ulatust ja keerukuse astet.",
      "rdfs:label": {
        "@value": "VPTS_Par_79_1 (redaktsioon 124032011005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "124032011005",
      "estleg:supersededByVersion": {
