      }
    },
    {
      "@id": "estleg:VPTS_Par_237_14_v130122017042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_237_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kliendi korralduse parima täitmise, selleks vajalike meetmete kehtestamise või rakendamise või määratud hinnaga korralduse avalikustamise kohustuse rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_14 (redaktsioon 130122017042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122017042",
