      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) nr 596/2014 artikli 19 lõigetes 1, 2, 3, 5, 6, 7 ja 11 sätestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 500 000 eurot või kuni kolmekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud seotud juriidiline isik, –karistatakse rahatrahviga kuni 1 000 000 eurot või kuni kolmekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas.",
      "rdfs:label": {
        "@value": "VPTS_Par_237_30 (redaktsioon 130122025005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122025005"
