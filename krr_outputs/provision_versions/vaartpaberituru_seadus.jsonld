        "@value": "2018-01-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTS_Par_132_5_v130122017042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_132_5"
