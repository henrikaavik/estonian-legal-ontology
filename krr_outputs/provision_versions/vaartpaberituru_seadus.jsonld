      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Noteerimisprospekti, selle lisade ning noteerimisprospekti avalikustamise ja registreerimise suhtes kohaldatakse käesoleva seaduse §-des 141–16, 18–21, 24, 31, 32, 37, 39 ja 391 prospekti, selle lisade ning prospekti avalikustamise ja registreerimise kohta sätestatut koos käesoleva seaduse §-des 1322–1324 kauplemisprospekti ja selle lisade suhtes sätestatud erisustega.",
      "rdfs:label": {
