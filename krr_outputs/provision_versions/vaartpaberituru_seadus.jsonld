      "estleg:versionValidFrom": {
        "@value": "2005-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastuvõtjalepinguriik käesoleva seaduse tähenduses on Eesti või muu lepinguriik, kus väärtpabereid avalikult pakutakse või kus taotletakse nende reguleeritud turul kauplemisele võtmist, kui see riik ei ole päritolulepinguriik.",
      "rdfs:label": {
        "@value": "VPTS_Par_13_2 (redaktsioon 960857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "960857",
