    {
      "@id": "estleg:VPTS_Par_92_v27312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTS_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-des 85, 87, 88 ja 89 sätestatud investeerimisühingu tegevusele esitatavate nõuete täitmise üle otsustamiseks tavapäraste juhtumite puhul võib rahandusminister oma määrusega kehtestada täpsemad kriteeriumid.",
      "rdfs:label": {
        "@value": "VPTS_Par_92 (redaktsioon 27312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27312",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTS_Par_92_v12881089"
      },
      "estleg:versionValidTo": {
