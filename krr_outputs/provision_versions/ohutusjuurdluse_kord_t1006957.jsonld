    {
      "@id": "estleg:Reg_1006957_Par_2_v1006957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1006957_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Arvestades lennundusseaduse § 48 lõikes 23, meresõiduohutuse seaduse § 692 lõikes 2, § 71 lõikes 1 ja raudteeseaduse § 50 lõikes 3 sätestatud erandeid, korraldab Ohutusjuurdluse Keskus järgmisi ohutusjuurdlusi: RT I 2020-12-22 8 122122020008 2020-12-25 1 1) väga raske laevaõnnetuse, esialgse hindamise otsuse alusel raske laevaõnnetuse ning põhjendatud huvi korral mis tahes muu laevaõnnetuse või ohtliku juhtumi ohutusjuurdlus; RT I 2016-04-19 5 119042016005 2016-04-22 2 2) lennuõnnetuse, tõsise lennuintsidendi ja lennuintsidendi ohutusjuurdlus; 3 3) õnnetusjuhtumi, tõsise õnnetusjuhtumi ja vahejuhtumi ohutusjuurdlus. RT I 2014-04-03 1 103042014001 2014-04-06 Arvestades lennundusseaduse § 48 lõikes 23, meresõiduohutuse seaduse § 692 lõikes 2, § 71 lõikes 1 ja raudteeseaduse § 50 lõikes 3 sätestatud erandeid, korraldab Ohutusjuurdluse Keskus järgmisi ohutusjuurdlusi: väga raske laevaõnnetuse, esialgse hindamise otsuse alusel raske laevaõnnetuse ning põhjendatud huvi korral mis tahes muu laevaõnnetuse või ohtliku juhtumi ohutusjuurdlus; lennuõnnetuse, tõsise lennuintsidendi ja lennuintsidendi ohutusjuurdlus; õnnetusjuhtumi, tõsise õnnetusjuhtumi ja vahejuhtumi ohutusjuurdlus. 2 (2) Transpordiamet korraldab järgmisi juurdlusi, järgides ohutusjuurdluse korraldamise ja aruandluse nõudeid, mis on sätestatud meresõiduohutuse seaduse § 711 lõikes 2 ning käesoleva määruse §-s 1, § 3 lõikes 3, § 7 lõigetes 2 ja 5, §-s 8 ja §-des 10 ja 11: RT I 2022-02-03 1 103022022001 2022-02-06 1 1) väikelaevaga, riigihaldusülesandeid täitva laevaga, siseveelaevaga ja alla 15 meetri pikkuse kalalaevaga toimunud laevaõnnetuse juurdlus; 2 2) kerge või raske laevaõnnetuse ja ohtliku juhtumi juurdlus, mille kohta ei ole Ohutusjuurdluse Keskus algatanud laevaõnnetuse ohutusjuurdlust. RT I 2016-04-19 5 119042016005 2016-04-22 Transpordiamet korraldab järgmisi juurdlusi, järgides ohutusjuurdluse korraldamise ja aruandluse nõudeid, mis on sätestatud meresõiduohutuse seaduse § 711 lõikes 2 ning käesoleva määruse §-s 1, § 3 lõikes 3, § 7 lõigetes 2 ja 5, §-s 8 ja §-des 10 ja 11: väikelaevaga, riigihaldusülesandeid täitva laevaga, siseveelaevaga ja alla 15 meetri pikkuse kalalaevaga toimunud laevaõnnetuse juurdlus; kerge või raske laevaõnnetuse ja ohtliku juhtumi juurdlus, mille kohta ei ole Ohutusjuurdluse Keskus algatanud laevaõnnetuse ohutusjuurdlust.",
      "rdfs:label": {
        "@value": "Reg_1006957_Par_2 (redaktsioon 1006957)",
        "@language": "et"
      },
