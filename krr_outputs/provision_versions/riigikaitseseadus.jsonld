        "@id": "estleg:RIIGIK_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RIIGIK_Par_82 (redaktsioon 114032023031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032023031",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032023031",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 82",
