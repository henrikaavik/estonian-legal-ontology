      }
    },
    {
      "@id": "estleg:RIIGIK_Par_32_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusvahelises sõjalises koostöös tekitatud kahju nõude menetlemise, kahju hüvitamise ning kahjuhüvitisest loobumise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_32 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_32_v110032022025"
      },
      "estleg:versionValidTo": {
