      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RIIGIK_Par_76 (redaktsioon 114032023031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032023031",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032023031",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 76",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
    {
      "@id": "estleg:RIIGIK_Par_77_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjaaja ametikoha ülesandeid täitma asunud tegevväelase palgaastmestiku ja Kaitseväe juhataja sõjaaja ametikoha palga kehtestab määrusega. (2) Palga maksmise tingimused ja korra kehtestab Kaitseväe juhataja.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_77 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_77_v114032023031"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      },
