    {
      "@id": "estleg:RIIGIK_Par_54_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sundtöökohustuse kestus on kuni 48 tundi. Sundtöökohustuse kestus ei või ületada töö tegemiseks või ülesande täitmiseks vajalikku aega. Sundtöökohustuse panemine ei või olla tingimuslik. (2) Isikuid võib kohustada ilmuma sundtöökohustust täitma koos vajalike töövahendite ja sõidukitega, kui need olemas on. (3) Sundtöökohustuse täitmisega isikule tekkiva otsese kulu kannab sundtöökohustuse panija.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_54 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_54_v110032022025"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 54",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
