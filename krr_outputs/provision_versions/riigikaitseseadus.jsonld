      }
    },
    {
      "@id": "estleg:RIIGIK_Par_76_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjaaja ametikoha ülesandeid täitma asunud tegevväelane: ei tohi tegeleda poliitiliste vaadete levitamisega; ei tohi võtta osa erakonna tegevusest; ei tohi töötada väljaspool teenistusülesannete täitmist muul ameti- või töökohal; peab järgima toimingu, otsuse või tehingu tegemisel korruptsioonivastases seaduses sätestatut; ei tohi streikida ega osaleda muus surveaktsioonis, mis häirib sõjalise riigikaitse korraldamist. (2) Sõjaaja ametikoha ülesandeid täitma asunud isikul on õigus keelduda kaitseväeteenistusvälise töö tegemisest. Avalikus teenistuses oleva isiku avaliku võimu teostamise õigus peatub sõjaaja ametikoha ülesannete täitmise ajaks.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_76 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_76_v114032023031"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 76",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
    {
      "@id": "estleg:RIIGIK_Par_76_v114032023031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
