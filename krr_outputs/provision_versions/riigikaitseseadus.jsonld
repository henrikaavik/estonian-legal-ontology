        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 32",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
    {
      "@id": "estleg:RIIGIK_Par_32_v110032022025",
      "@type": [
        "owl:NamedIndividual",
