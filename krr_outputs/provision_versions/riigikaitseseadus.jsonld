    },
    {
      "@id": "estleg:RIIGIK_Par_73_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjaseisukorra ja mobilisatsiooni ajal võetakse sõjaaja ametikoha ülesandeid täitma kaitseväekohustuslane, kes: on täieliku teovõimega; valdab eesti keelt emakeelena või vähemalt B1 tasemel; on lõpetanud põhikooli 2. kooliastme; vastab tegevväelase teenistusülesannete täitmise tervisenõuetele; omab nõutavaid oskusi ja väljaõpet; on vähemalt 18-aastane. (2) Käesoleva paragrahvi lõike 1 alusel sõjaaja ametikoha ülesandeid täitma võetud kaitseväekohustuslane loetakse ametikohale asumisel tegevteenistusse võetuks määramata ajaks. (3) Kaitseväekohustuslase sõjaaja ametikoha ülesannete täitmiseks võtmise korra kehtestab Kaitseväe juhataja.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_73 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_73_v114032023031"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 73",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
    {
      "@id": "estleg:RIIGIK_Par_73_v114032023031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
