      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaõppekogunemisel osalemise kohustusest on vabastatud reservis olev isik, kes: töötab riigikaitselise töökohustusega ameti- või töökohal; on vahi all; kannab vangistust; ei ole Kaitseväe juhataja volitatud struktuuriüksuse ülema määratud arsti otsuse kohaselt oma terviseseisundi tõttu võimeline lisaõppekogunemisel osalema. (2) Kaitseväe juhataja või tema volitatud ülem võib vabastada ajavahemikul 1. aprillist kuni 1. juunini toimuvast lisaõppekogunemisest füüsilise isiku, kes tegeleb Euroopa Liidu toimimise lepingu I lisas loetletud põllumajandustoodete, välja arvatud kalandustoodete tootmisega, kui: isikul on lisaõppekogunemise toimumise ajal ilmne vajadus osaleda Eestis põllumajandustöödel ja lisaõppekogunemisel osalemine võib isiku põllumajandustootmise jätkamise ohtu asetada. (3) Kui lisaõppekogunemisele kutsutud reservis olev isik on kinni peetud või viibib aresti all, on ta kohustatud ilmuma Kaitseväkke kohe pärast kinnipidamiselt või aresti alt vabastamist.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_70 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_70_v114032023031"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 70",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
