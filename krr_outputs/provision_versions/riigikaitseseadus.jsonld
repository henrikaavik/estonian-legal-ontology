    {
      "@id": "estleg:RIIGIK_Par_97_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametiühingute seaduse § 4 lõike 1 teine lause muudetakse ja sõnastatakse järgmiselt: „Tegevväelasel on keelatud asutada ametiühingut või sellega ühineda.”.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_97 (redaktsioon 112032015001)",
        "@language": "et"
