      }
    },
    {
      "@id": "estleg:RIIGIK_Par_74_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjaseisukorra ja mobilisatsiooni ajal võib määramata ajaks tegevteenistusse võtta kaitseväekohustuseta Kaitseliidu tegevliikme, kes on varem nimetatud Kaitseliidu seaduses sätestatud korras sõjaaja ametikohale, vastab käesoleva seaduse § 73 lõikes 1 sätestatud tingimustele ega ole jõudnud riikliku pensionikindlustuse seaduses sätestatud vanaduspensioniikka. (2) Sõjaseisukorra ja mobilisatsiooni ajal võib kirjaliku avalduse alusel määramata ajaks tegevteenistusse võtta isiku, kes vastab käesoleva seaduse § 73 lõike 1 punktides 1 ja 3–6 sätestatud tingimustele ega ole jõudnud riikliku pensionikindlustuse seaduses sätestatud vanaduspensioniikka. (3) Käesoleva paragrahvi lõigete 1 ja 2 alusel tegevteenistusse võetud kaitseväekohustuseta isikule laienevad tegevteenistuses olemise ajal samasugused õigused ja kohustused nagu kaitseväekohustusega tegevväelasele. Kaitseväekohustusteta isiku tegevteenistusse võtmisest teavitab Kaitsevägi Kaitseressursside Ametit. (4) Käesoleva paragrahvi lõigete 1 ja 2 alusel tegevteenistusse võetuks loetud isiku andmed kantakse kaitseväekohustuslaste registrisse kaitseväekohustust võtta sooviva isiku andmetena. (5) Tegevteenistusse võtmata jätmisel või tegevteenistusest vabastamisel kustutatakse käesoleva paragrahvi lõigetes 1 ja 2 nimetatud isiku andmed kaitseväekohustuslaste registrist.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_74 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_74_v114032023031"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 74",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
    {
      "@id": "estleg:RIIGIK_Par_74_v114032023031",
