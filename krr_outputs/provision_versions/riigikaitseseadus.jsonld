        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadus jõustub 2016. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_137 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 137",
