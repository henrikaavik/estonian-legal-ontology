      }
    },
    {
      "@id": "estleg:RIIGIK_Par_58_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjaseisukorra ajal ei kehti sõjaväelise auastme andmisel kaitseväeteenistuse seaduse § 17, § 22 lõiked 4–6 ja 8 ning § 25. (2) Sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ajal võib lisaks kaitseväeteenistuse seaduses sätestatule alandada sõjaväelist auastet süüdimõistva kohtuotsuse jõustumisel.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_58 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_58_v114032023031"
      },
