      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välissuhtlemisseaduse § 6 lõike 2 punkt 4 muudetakse ja sõnastatakse järgmiselt: „4) arutab Vabariigi Valitsuse esitatud arengukoostöö ja humanitaarabi põhimõtteid ning koos riigikaitsekomisjoniga julgeolekupoliitika aluseid;”.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_136 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
