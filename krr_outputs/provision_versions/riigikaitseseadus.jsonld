    {
      "@id": "estleg:RIIGIK_Par_55_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sundtöökohustuse täitmise eest maksab sundtöökohustuse panija isikule toetust. (2) Sundtöökohustuse toetuse maksmise ulatuse ja korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_55 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_55_v110032022025"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 55",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
    {
      "@id": "estleg:RIIGIK_Par_55_v110032022025",
