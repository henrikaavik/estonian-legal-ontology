      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "RIIGIK_Par_136 (redaktsioon 101042016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101042016003",
