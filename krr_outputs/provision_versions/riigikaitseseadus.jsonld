      }
    },
    {
      "@id": "estleg:RIIGIK_Par_69_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaõppekogunemisele kutsumisest teatatakse reservis olevale isikule ühel järgmisel viisil: teade antakse kätte allkirja vastu, toimetatakse kätte posti teel või elektrooniliselt; teade avalikustatakse vähemalt ühes üleriigilises ajalehes; teade avaldatakse tele- ja raadioprogrammides kella 7–22 vähemalt kolmel korral, kusjuures iga avaldamise vahele peab jääma vähemalt üks tund; teade avalikustatakse internetipõhiselt. (2) Teate avaldamisel ajalehes, tele- ja raadioprogrammides ning internetis võidakse selles märkida ainult üksuse nimetus, mille koosseisu kuuluvatele sõjaväelise auastmega ametikohtadele nimetatud reservis olevate isikute kohta lisaõppekogunemise kutse kehtib. (3) Lisaõppekogunemisele kutsumise teate edastamisega käesoleva paragrahvi lõikes 1 nimetatud viisil loetakse teade reservis olevale isikule kättetoimetatuks.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_69 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_69_v114032023031"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 69",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
    {
      "@id": "estleg:RIIGIK_Par_69_v114032023031",
