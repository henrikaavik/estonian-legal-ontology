      "estleg:provisionRef": "RIIGIK § 136",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
    {
      "@id": "estleg:RIIGIK_Par_136_v101042016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
