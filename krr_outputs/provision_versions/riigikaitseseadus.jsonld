      }
    },
    {
      "@id": "estleg:RIIGIK_Par_75_v112032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIK_Par_75"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kõrgendatud kaitsevalmiduse, sõjaseisukorra ja mobilisatsiooni ajal on Kaitseväe juhatajal või tema volitatud ülemal õigus otsustada kaitseväeteenistuse seaduse §-de 114–117 alusel lähetatud ning § 119 lõike 2 alusel suunatud tegevväelase lähetuse ja suunamise lõpetamine ja § 131 lõike 1 punktide 3, 4 ja 6–8 alusel peatatud tegevteenistussuhte peatamise lõpetamine. (2) Kaitseväe juhataja kehtestab sõjaaja ametikoha ülesandeid täitva tegevväelase lähetamise ja lähetusega seotud kulude hüvitamise korra, kui tegevväelane lähetatakse: välisriiki lühiajaliselt; välisriiki riiklike ülesannete täitmiseks kauemaks kui kuueks kuuks. (3) Sõjaaja ametikoha ülesandeid täitva tegevväelase lähetamisel päevaraha ei maksta.",
      "rdfs:label": {
        "@value": "RIIGIK_Par_75 (redaktsioon 112032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_Par_75_v114032023031"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015001",
      "estleg:sourceAct": "Riigikaitseseadus",
      "estleg:provisionRef": "RIIGIK § 75",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIK_Map"
      }
    },
    {
      "@id": "estleg:RIIGIK_Par_75_v114032023031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
