    {
      "@id": "estleg:Reg_314388_Par_3_v314388",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_314388_Par_3"
