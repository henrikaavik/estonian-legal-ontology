      "estleg:versionValidFrom": {
        "@value": "2017-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse kutselise kalapüügi registri kalalaevade alajaotused (edaspidi kalalaevastiku segmendid), nende tunnused, kalalaevastiku segmenti kantavale kalalaevale esitatavad nõuded ning kalalaevastiku segmenti lisamise võimalus. Määrusega kehtestatakse kutselise kalapüügi registri kalalaevade alajaotused (edaspidi kalalaevastiku segmendid), nende tunnused, kalalaevastiku segmenti kantavale kalalaevale esitatavad nõuded ning kalalaevastiku segmenti lisamise võimalus.",
      "rdfs:label": {
        "@value": "Reg_1040900_Par_1 (redaktsioon 1040900)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040900",
