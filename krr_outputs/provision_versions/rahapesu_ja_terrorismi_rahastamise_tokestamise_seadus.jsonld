      }
    },
    {
      "@id": "estleg:RTRT_Par_52_v13264873",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_52"
