      }
    },
    {
      "@id": "estleg:RTRT_Par_66_v12909786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pandimajapidaja, usaldusfondide ja äriühingute teenuse pakkuja ning finantseerimisasutuse suhtes, kelle üle Finantsinspektsioon ei teosta järelevalvet Finantsinspektsiooni seaduse § 2 alusel, jõustub käesoleva seaduse 6. peatükk 2008. aasta 15. juunil.",
      "rdfs:label": {
        "@value": "RTRT_Par_66 (redaktsioon 12909786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12909786",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTRT_Par_66_v117112017002"
      },
      "estleg:versionValidTo": {
        "@value": "2017-11-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12909786",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 66",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
    {
      "@id": "estleg:RTRT_Par_66_v117112017002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haldusjärelevalve tegijal on õigus kontrollida kohustatud isikute asu- või tegevuskohta. Järelevalve tegijal on õigus kontrollitava isiku esindaja juuresolekul siseneda kohustatud isiku valduses olevasse hoonesse ja ruumi. (2) Kohapealse kontrolli käigus on haldusjärelevalve tegijal õigus: piiranguteta uurida vajalikke dokumente ja andmekandjaid, teha nendest väljavõtteid, ärakirju ja koopiaid, saada kohustatud isikult nende kohta selgitusi ning jälgida tööprotsesse; saada suulisi ja kirjalikke selgitusi kontrollitavalt kohustatud isikult ning tema juhtorgani liikmetelt ja töötajatelt. (3) Haldusjärelevalve tegijal on õigus nõuda kohustatud isikult kontrollimiseks vajalikku teavet ka kohapealset kontrolli tegemata.",
      "rdfs:label": {
        "@value": "RTRT_Par_66 (redaktsioon 117112017002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112017002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117112017002",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 66",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
