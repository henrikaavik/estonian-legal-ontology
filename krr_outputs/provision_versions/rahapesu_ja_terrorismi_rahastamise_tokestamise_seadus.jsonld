        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Paragrahvides 57–641 nimetatud väärtegude kohtuvälised menetlejad on Politsei- ja Piirivalveamet ja Finantsinspektsioon.",
      "rdfs:label": {
        "@value": "RTRT_Par_65 (redaktsioon 112072014111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014111",
      "estleg:supersededByVersion": {
