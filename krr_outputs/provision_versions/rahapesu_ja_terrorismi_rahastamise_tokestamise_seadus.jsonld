    },
    {
      "@id": "estleg:RTRT_Par_50_v121112020012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teade esitatakse selle Euroopa Majanduspiirkonna lepinguriigi rahapesu andmebüroole, kelle territooriumil kohustatud isik on asutatud. (2) Teade esitatakse Rahapesu Andmebüroo veebivormi või X-tee teenuse kaudu. (3) Teatele lisatakse isiku isikusamasuse tuvastamiseks ja esitatud teabe kontrollimiseks kasutatud andmed ning olemasolu korral dokumentide koopiad. (4) Nõuded Rahapesu Andmebüroole esitatava teate sisule, vormile ja teate esitamise juhendi kehtestab määrusega.",
      "rdfs:label": {
        "@value": "RTRT_Par_50 (redaktsioon 121112020012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121112020012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121112020012",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 50",
