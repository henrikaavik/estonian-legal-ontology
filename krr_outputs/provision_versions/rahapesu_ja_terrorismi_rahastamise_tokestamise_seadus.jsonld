        "@id": "estleg:RTRT_Map"
      }
    },
    {
      "@id": "estleg:RTRT_Par_51_v12909786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kontrolli rahapesu andmebüroos registreeritud andmete töötlemise seaduslikkuse üle teostab Andmekaitse Inspektsioon.",
      "rdfs:label": {
        "@value": "RTRT_Par_51 (redaktsioon 12909786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12909786",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTRT_Par_51_v108052012005"
      },
      "estleg:versionValidTo": {
        "@value": "2012-05-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12909786",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 51",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
    {
      "@id": "estleg:RTRT_Par_51_v108052012005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-05-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kontrolli rahapesu andmebüroos registreeritud andmete töötlemise seaduslikkuse üle teostab Andmekaitse Inspektsioon. (2) Teenistuslikku järelevalvet rahapesu andmebüroo tegevuse seaduslikkuse üle teostab Politsei- ja Piirivalveamet. (3) Politsei- ja Piirivalveameti peadirektoril ja tema volitatud ametnikul on õigus rahapesu andmebüroos registreeritud andmetega tutvuda teenistusliku järelevalve teostamiseks vajalikus ulatuses. (4) Teenistuslikku järelevalvet teostava ametniku suhtes kohaldatakse käesoleva seaduse § 43 lõikes 5 sätestatud piirangut ja § 44 lõikes 2 sätestatud kohustust.",
      "rdfs:label": {
        "@value": "RTRT_Par_51 (redaktsioon 108052012005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108052012005",
      "estleg:supersededByVersion": {
