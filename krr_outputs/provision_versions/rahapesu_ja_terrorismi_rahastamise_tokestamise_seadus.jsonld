      }
    },
    {
      "@id": "estleg:RTRT_Par_78_v117112017002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegeliku kasusaaja andmed avalikustatakse äriregistri infosüsteemis. (2) Tasu määrad tegeliku kasusaaja andmete väljastamise eest kehtestab määrusega. (3) Tegeliku kasusaaja andmeid väljastatakse tasuta kohustatud isikule, valitsusasutusele, Finantsinspektsioonile ja kohtule.",
      "rdfs:label": {
        "@value": "RTRT_Par_78 (redaktsioon 117112017002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112017002",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTRT_Par_78_v114042021008"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117112017002",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 78",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
    {
      "@id": "estleg:RTRT_Par_78_v114042021008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegeliku kasusaaja andmed ja nende kohta tehtud märked avalikustatakse äriregistri infosüsteemis. (2) Tasu määrad tegeliku kasusaaja andmete väljastamise eest kehtestab määrusega. (3) Tegeliku kasusaaja andmeid väljastatakse tasuta kohustatud isikule, valitsusasutusele, Finantsinspektsioonile ja kohtule.",
      "rdfs:label": {
        "@value": "RTRT_Par_78 (redaktsioon 114042021008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114042021008",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTRT_Par_78_v102062021008"
      },
      "estleg:versionValidTo": {
