      "estleg:provisionRef": "RTRT § 94",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
    {
      "@id": "estleg:RTRT_Par_94_1_v110072020008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_94_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 70 lõikes 1 nimetatud tegevusloa kontrolliesemega seotud asjaolude või kõrvaltingimustega seotud asjaolude muutumisest teatamise, eelnimetatud asjaolude muutmise kavatsusest etteteatamise või teenuse pakkuja tegevuse lõpetamisest teatamise kohustuse rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "RTRT_Par_94_1 (redaktsioon 110072020008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110072020008",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 94_1",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
    {
