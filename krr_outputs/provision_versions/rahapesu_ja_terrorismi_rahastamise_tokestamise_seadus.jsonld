        "@value": "2021-05-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117112017002",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 80",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
    {
      "@id": "estleg:RTRT_Par_80_v114042021008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegeliku kasusaaja andmed kustutatakse automaatselt viis aastat pärast juriidilise isiku registrist kustutamist. (2) Registripidaja kustutab usaldushalduse tegeliku kasusaaja andmed, kui selleks õigustatud huvi omav isik tõendab, et andmete esitamise aluseks olnud asjaolu äralangemisest on möödunud vähemalt viis aastat.",
      "rdfs:label": {
        "@value": "RTRT_Par_80 (redaktsioon 114042021008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114042021008",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTRT_Par_80_v102062021008"
      },
      "estleg:versionValidTo": {
        "@value": "2021-06-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114042021008",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 80",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
    {
      "@id": "estleg:RTRT_Par_80_v102062021008",
