    {
      "@id": "estleg:RTRT_Par_1_v12909786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse eesmärk on tõkestada Eesti Vabariigi rahandussüsteemi ning majandusruumi kasutamist rahapesuks ja terrorismi rahastamiseks.",
      "rdfs:label": {
        "@value": "RTRT_Par_1 (redaktsioon 12909786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12909786",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTRT_Par_1_v117112017002"
      },
      "estleg:versionValidTo": {
        "@value": "2017-11-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12909786",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 1",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
    {
      "@id": "estleg:RTRT_Par_1_v117112017002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse eesmärk on ettevõtluskeskkonna usaldusväärsust ja läbipaistvust suurendades tõkestada Eesti Vabariigi rahandussüsteemi ning majandusruumi kasutamist rahapesuks ja terrorismi rahastamiseks. (2) Käesoleva seadusega reguleeritakse: rahapesu ja terrorismi rahastamisega seotud riskide hindamise, juhtimise ja maandamise põhimõtteid; rahapesu andmebüroo tegevuse aluseid; järelevalvet kohustatud isikute üle seaduse täitmisel; juriidilistele isikutele nende tegelike kasusaajate andmete kogumise ja avaldamisega kaasnevaid kohustusi; maksekontode omanike andmete kogumise ja avaldamisega kaasnevaid kohustusi; kohustatud isikute vastutust seadusest tulenevate nõuete rikkumise korral. (3) Käesolevas seaduses ette nähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "RTRT_Par_1 (redaktsioon 117112017002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112017002",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTRT_Par_1_v110072020008"
      },
      "estleg:versionValidTo": {
        "@value": "2020-07-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117112017002",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 1",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
