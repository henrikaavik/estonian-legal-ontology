      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Krediidiasutus ja finantseerimisasutus arvestab väiksemat riski iseloomustavate asjaolude tuvastamisel ja lihtsustatud hoolsusmeetmete valikul Euroopa järelevalveasutuste suuniseid riskitegurite kohta. (2) Käesoleva seaduse § 34 lõike 1 kohaselt väiksemale riskile viitavate asjaolude hindamisel võib toote, teenuse, tehingu või edastamiskanaliga seotud riske vähendavateks asjaoludeks lugeda vähemalt järgmisi asjaolusid: väikese kindlustusmaksega elukindlustuslepingut; pensioniskeemi kindlustuslepingut, kui see ei sisalda ennetähtaegse tagasiostmise valikuõigust ning seda ei saa kasutada tagatisena; töötajatele väljateenitud aastate pensioni või muid sarnaseid pensionihüvitisi võimaldavat skeemi, mille puhul kindlustusmaksed arvatakse palgast maha ja pensioniskeemi tingimused ei võimalda skeemis osaleja huvide üleandmist; finantstooteid või -teenuseid, mis pakuvad asjakohaselt kindlaksmääratud ja piiratud teenuseid teatavatele kliendirühmadele, et suurendada finantsteenuste kättesaadavust; tooteid, mille puhul juhitakse rahapesu ja terrorismi rahastamise riski muude teguritega, nagu rahalised piirmäärad lisaks käesoleva seaduse § 33 lõike 3 punktis 3 sätestatule või läbipaistvust tõstvad meetmed; maksekontoga seotud põhimakseteenuseid.",
      "rdfs:label": {
        "@value": "RTRT_Par_35 (redaktsioon 117112017002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112017002",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTRT_Par_35_v110072020008"
      },
      "estleg:versionValidTo": {
        "@value": "2020-07-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117112017002",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 35",
      "estleg:partOfAct": {
