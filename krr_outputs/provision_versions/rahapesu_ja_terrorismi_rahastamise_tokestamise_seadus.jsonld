        "@value": "2017-11-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13264873",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 6",
