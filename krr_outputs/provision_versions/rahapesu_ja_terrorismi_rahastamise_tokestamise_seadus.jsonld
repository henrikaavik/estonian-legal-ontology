      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_75"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks majandustegevuse seadustiku üldosa seaduse § 37 lõikes 1 sätestatule tunnistab rahapesu andmebüroo käesoleva seaduse § 70 lõikes 1 nimetatud tegevusloa kehtetuks, kui: ettevõtjale on andnud tegevusloa Finantsinspektsioon; ettevõtja korduvalt ei täida järelevalveasutuse ettekirjutusi; ettevõtja ei ole taotletud tegevusalal tegutsema asunud kuue kuu jooksul loa väljastamisest arvates.",
      "rdfs:label": {
        "@value": "RTRT_Par_75 (redaktsioon 117112017002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112017002",
