      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahapesu on kuriteo tulemusena või sellises teos osalemise eest saadud vara omandamine, valdamine, kasutamine, muundamine, üleandmine või varaga tehingute või toimingute sooritamine, mille eesmärk või tagajärg on selle vara tegeliku omaniku ning ebaseadusliku päritolu varjamine. - jõust. 1. 01. 2004]",
      "rdfs:label": {
        "@value": "RTRT_Par_2 (redaktsioon 689311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "689311",
