    {
      "@id": "estleg:RTRT_Par_7_v121062024051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrespondentsuhe käesoleva seaduse tähenduses on: püsivalt ja kestvalt finantsteenuste osutamine ühe krediidiasutuse (korrespondentasutus) poolt teisele krediidiasutusele (respondentasutus), sealhulgas arvelduskonto, maksekonto või muu kontoteenuse ning sellega seonduvate rahahalduse, rahvusvahelise rahaülekande, tšekkide lunastamise, laiendatud kasutusõigusega konto teenuse ja valuutavahetusteenuse osutamine; krediidiasutuste ja finantseerimisasutuste omavahelised suhted, sealhulgas sellised suhted, mille puhul korrespondentasutus osutab respondentasutusele sarnaseid teenuseid tema klientide teenindamiseks, ning sellised suhted, mis on loodud väärtpaberitehingute või rahaülekannete tegemiseks, või suhted, mis on loodud krüptovaratehingute või krüptovaraülekannete tegemiseks.",
      "rdfs:label": {
        "@value": "RTRT_Par_7 (redaktsioon 121062024051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024051",
