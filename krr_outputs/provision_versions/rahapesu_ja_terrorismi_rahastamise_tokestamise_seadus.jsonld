        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegeliku kasusaaja andmed kustutatakse automaatselt viis aastat pärast juriidilise isiku registrist kustutamist. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "RTRT_Par_80 (redaktsioon 102062021008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102062021008",
