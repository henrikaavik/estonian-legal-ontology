      },
      "estleg:versionValidTo": {
        "@value": "2009-12-25",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12985329",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise seadus",
      "estleg:provisionRef": "RTRT § 67",
