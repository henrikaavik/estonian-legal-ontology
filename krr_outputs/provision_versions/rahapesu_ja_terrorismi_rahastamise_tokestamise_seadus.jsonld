      "estleg:provisionRef": "RTRT § 12",
      "estleg:partOfAct": {
        "@id": "estleg:RTRT_Map"
      }
    },
    {
      "@id": "estleg:RTRT_Par_12_v728941",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
