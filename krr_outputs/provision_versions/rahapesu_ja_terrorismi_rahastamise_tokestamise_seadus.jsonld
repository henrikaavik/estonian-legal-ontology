        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahapesu ja terrorismi rahastamise tõkestamise seadus tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "RTRT_Par_67 (redaktsioon 12985329)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12985329",
