    {
      "@id": "estleg:RTRT_Par_58_v121112020012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTRT_Par_58"
