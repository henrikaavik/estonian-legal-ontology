      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Džemmi, želee, marmelaadi ja magustatud kastanipüree koostis- ja kvaliteedinõuded ning toidualase teabe esitamise nõuded (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Džemmi, želee, marmelaadi ja magustatud kastanipüree koostis- ja kvaliteedinõuded ning toidualase teabe esitamise nõuded"
    },
    {
      "@id": "estleg:Reg_1026580_Par_1_v1026580",
      "@type": [
