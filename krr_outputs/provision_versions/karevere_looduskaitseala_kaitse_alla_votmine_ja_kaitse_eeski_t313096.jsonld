      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313096",
      "estleg:sourceAct": "Kärevere looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313096 § 9",
