  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_pohjaveekogumite_nimekiri_ja_nende_eristamise_kord_seisundik_t1047788_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Põhjaveekogumite nimekiri ja nende eristamise kord, seisundiklassid ja nende määramise kord, seisundiklassidele vastavad keemilise seisundi määramiseks kasutatavate kvaliteedinäitajate väärtused ja koguselise seisundi määramiseks kasutatavate näitajate tingimused, põhjavett ohustavate saasteainete nimekiri, nende sisalduse läviväärtused põhjaveekogumite kaupa ja kvaliteedi piirväärtused põhjavees ning taustataseme määramise põhimõtted (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Põhjaveekogumite nimekiri ja nende eristamise kord, seisundiklassid ja nende määramise kord, seisundiklassidele vastavad keemilise seisundi määramiseks kasutatavate kvaliteedinäitajate väärtused ja koguselise seisundi määramiseks kasutatavate näitajate tingimused, põhjavett ohustavate saasteainete nimekiri, nende sisalduse läviväärtused põhjaveekogumite kaupa ja kvaliteedi piirväärtused põhjavees ning taustataseme määramise põhimõtted"
    },
    {
      "@id": "estleg:Reg_1047788_Par_1_v1047788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047788_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse: 1 1) põhjaveekogumite nimekiri ja nende eristamise kord; 2 2) põhjaveekogumite seisundiklassid ja nende määramise kord; 3 3) seisundiklassidele vastavad keemilise seisundi määramiseks kasutatavate kvaliteedinäitajate väärtused; 4 4) koguselise seisundi määramiseks kasutatavate näitajate tingimused; 5 5) põhjavett ohustavate saasteainete nimekiri; 6 6) saasteainete sisalduse läviväärtused kogumite kaupa; 7 7) kvaliteedi piirväärtused põhjavees; 8 8) saasteainete sisalduse taustataseme määramise põhimõtted. Määrusega kehtestatakse: põhjaveekogumite nimekiri ja nende eristamise kord; põhjaveekogumite seisundiklassid ja nende määramise kord; seisundiklassidele vastavad keemilise seisundi määramiseks kasutatavate kvaliteedinäitajate väärtused; koguselise seisundi määramiseks kasutatavate näitajate tingimused; põhjavett ohustavate saasteainete nimekiri; saasteainete sisalduse läviväärtused kogumite kaupa; kvaliteedi piirväärtused põhjavees; saasteainete sisalduse taustataseme määramise põhimõtted. 2 (2) Määrust kohaldatakse põhjaveele käesoleva määruse § 2 lõikes 1 sätestatud põhjaveekogumite kaupa. Määrust kohaldatakse põhjaveele käesoleva määruse § 2 lõikes 1 sätestatud põhjaveekogumite kaupa. 3 (3) Määruse eesmärk on tagada põhjavee kaitse põhjavee seisundi hindamise kaudu ning põhjaveekogumite seisundiklasside määramine viisil, mis võimaldab veekaitsemeetmete tõhusat planeerimist ja rakendamist. Määruse eesmärk on tagada põhjavee kaitse põhjavee seisundi hindamise kaudu ning põhjaveekogumite seisundiklasside määramine viisil, mis võimaldab veekaitsemeetmete tõhusat planeerimist ja rakendamist.",
      "rdfs:label": {
        "@value": "Reg_1047788_Par_1 (redaktsioon 1047788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047788",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047788",
      "estleg:sourceAct": "Põhjaveekogumite nimekiri ja nende eristamise kord, seisundiklassid ja nende määramise kord, seisundiklassidele vastavad keemilise seisundi määramiseks kasutatavate kvaliteedinäitajate väärtused ja koguselise seisundi määramiseks kasutatavate näitajate tingimused, põhjavett ohustavate saasteainete nimekiri, nende sisalduse läviväärtused põhjaveekogumite kaupa ja kvaliteedi piirväärtused põhjavees ning taustataseme määramise põhimõtted",
      "estleg:provisionRef": "Reg_1047788 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047788_Map"
      }
    },
