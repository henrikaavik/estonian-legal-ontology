  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_kiiresti_riknevate_kulmutatud_toiduainete_veoks_kasutatava_s_t1002536_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1002536_Par_1_v1002536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002536_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus kehtestab kiiresti riknevate külmutatud toiduainete veoks kasutatavas sõiduki (edaspidi sõiduk) õhutemperatuuri registreerimise mõõtevahendi (edaspidi mõõtevahend) kontrollimise tingimused ja korra. Käesolev määrus kehtestab kiiresti riknevate külmutatud toiduainete veoks kasutatavas sõiduki (edaspidi sõiduk) õhutemperatuuri registreerimise mõõtevahendi (edaspidi mõõtevahend) kontrollimise tingimused ja korra.",
      "rdfs:label": {
        "@value": "Reg_1002536_Par_1 (redaktsioon 1002536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002536",
      "estleg:sourceAct": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1002536 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002536_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002536_Par_2_v1002536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002536_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõidukis on lubatud Euroopa Komisjoni määruse (EÜ) nr 37/2005 temperatuuri järelevalve kohta inimtoiduks ettenähtud kiirkülmutatud toiduainete transpordivahendites, lao- ja säilitusruumides (EÜT L 10/18, 13.01.2005, lk 18–19) artikli 2 lõike 2 kohaselt kasutada Euroopa standardite EN 12830, EN 13485 ja EN 13486 nõuetele vastavat mõõtevahendit. Sõidukis on lubatud Euroopa Komisjoni määruse (EÜ) nr 37/2005 temperatuuri järelevalve kohta inimtoiduks ettenähtud kiirkülmutatud toiduainete transpordivahendites, lao- ja säilitusruumides (EÜT L 10/18, 13.01.2005, lk 18–19) artikli 2 lõike 2 kohaselt kasutada Euroopa standardite EN 12830, EN 13485 ja EN 13486 nõuetele vastavat mõõtevahendit.",
      "rdfs:label": {
        "@value": "Reg_1002536_Par_2 (redaktsioon 1002536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002536",
      "estleg:sourceAct": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1002536 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002536_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002536_Par_3_v1002536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002536_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mõõtevahendi nõuetele vastavuse ning mõõtevahendi sõidukile paigaldamise ja kasutamise kohustusliku kontrollimise liigid on: 1 1) mõõtevahendi kontrollimine enne paigaldamist; 2 2) mõõtevahendi kontrollimine pärast paigaldamist; 3 3) mõõtevahendi perioodiline kontrollimine; 4 4) mõõtevahendi kontrollimine sõiduki tehnonõuetele vastavuse kontrollimise käigus. Mõõtevahendi nõuetele vastavuse ning mõõtevahendi sõidukile paigaldamise ja kasutamise kohustusliku kontrollimise liigid on: mõõtevahendi kontrollimine enne paigaldamist; mõõtevahendi kontrollimine pärast paigaldamist; mõõtevahendi perioodiline kontrollimine; mõõtevahendi kontrollimine sõiduki tehnonõuetele vastavuse kontrollimise käigus. 2 (2) Mõõtevahendi kontrollimist enne ja pärast paigaldamist võib teha mõõtevahendi tootja või muu „Kiiresti riknevate toiduainete rahvusvahelise veo ning selleks kasutatavate eriveokite alane kokkulepe” (edaspidi ATP kokkulepe) ettenähtud korras tunnustatud ametlik katsejaam. Mõõtevahendi kontrollimist enne ja pärast paigaldamist võib teha mõõtevahendi tootja või muu „Kiiresti riknevate toiduainete rahvusvahelise veo ning selleks kasutatavate eriveokite alane kokkulepe” (edaspidi ATP kokkulepe) ettenähtud korras tunnustatud ametlik katsejaam. 3 (3) Mõõtevahendi perioodilist kontrollimist võib teha isik, kelle on mõõteseaduse § 5 lõikes 5 nimetatud akrediteerimisasutus tunnistanud pädevaks ATP kokkuleppe lisade 1 ja 2 ning Euroopa standardi EN 13486 nõuetele vastavuse hindamiseks eelnimetatud dokumentides toodud ulatuses ja keda Maanteeamet on tunnustanud ametliku katsejaamana. Mõõtevahendi perioodilist kontrollimist võib teha isik, kelle on mõõteseaduse § 5 lõikes 5 nimetatud akrediteerimisasutus tunnistanud pädevaks ATP kokkuleppe lisade 1 ja 2 ning Euroopa standardi EN 13486 nõuetele vastavuse hindamiseks eelnimetatud dokumentides toodud ulatuses ja keda Maanteeamet on tunnustanud ametliku katsejaamana. 4 (4) Mõõtevahendi kontrollimist sõiduki tehnonõuetele vastavuse kontrollimise käigus võib teha liiklusseaduse mõistes mootorsõiduki ja selle haagise tehnonõuetele vastavuse kontrollimise õigust omav äriühing. Mõõtevahendi kontrollimist sõiduki tehnonõuetele vastavuse kontrollimise käigus võib teha liiklusseaduse mõistes mootorsõiduki ja selle haagise tehnonõuetele vastavuse kontrollimise õigust omav äriühing.",
      "rdfs:label": {
        "@value": "Reg_1002536_Par_3 (redaktsioon 1002536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002536",
      "estleg:sourceAct": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1002536 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002536_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002536_Par_4_v1002536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002536_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mõõtevahendi kontrollimise käigus enne selle paigaldamist sõidukile tuleb: 1 1) välise vaatlusega hinnata mõõtevahendi välist seisukorda ja markeeringu vastavust nõuetele; 2 2) kontrollida mõõtevahendi vastavust käesoleva määruse §-s 2 toodud nõuetele. Mõõtevahendi kontrollimise käigus enne selle paigaldamist sõidukile tuleb: välise vaatlusega hinnata mõõtevahendi välist seisukorda ja markeeringu vastavust nõuetele; kontrollida mõõtevahendi vastavust käesoleva määruse §-s 2 toodud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1002536_Par_4 (redaktsioon 1002536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002536",
      "estleg:sourceAct": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1002536 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002536_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002536_Par_5_v1002536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002536_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mõõtevahendi paigaldamine hõlmab mõõtevahendi sõidukile monteerimist ja mõõtevahendi nõuetekohasuse kontrollimist. Mõõtevahendi paigaldamine hõlmab mõõtevahendi sõidukile monteerimist ja mõõtevahendi nõuetekohasuse kontrollimist. 2 (2) Mõõtevahendi võib sõidukile paigaldada sõiduki tootja, mõõtevahendi tootja või muu pädev äriühing. Mõõtevahendi võib sõidukile paigaldada sõiduki tootja, mõõtevahendi tootja või muu pädev äriühing. 3 (3) Mõõtevahendi kontrollimise käigus pärast selle paigaldamist sõidukile tuleb veenduda järgmiste nõuete täitmises: 1 1) mõõtevahendile peab olema tehtud käesoleva määruse § 4 kohaselt ettenähtud kontrollimine; 2 2) mõõtevahend peab sobima sõidukile; 3 3) mõõtevahendi montaaž peab vastama mõõtevahendi tootja juhistele. Mõõtevahendi kontrollimise käigus pärast selle paigaldamist sõidukile tuleb veenduda järgmiste nõuete täitmises: mõõtevahendile peab olema tehtud käesoleva määruse § 4 kohaselt ettenähtud kontrollimine; mõõtevahend peab sobima sõidukile; mõõtevahendi montaaž peab vastama mõõtevahendi tootja juhistele.",
      "rdfs:label": {
        "@value": "Reg_1002536_Par_5 (redaktsioon 1002536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002536",
      "estleg:sourceAct": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1002536 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002536_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002536_Par_6_v1002536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002536_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mõõtevahendit peab perioodiliselt kontrollima samaaegselt sõiduki kontrollimisega iga kolme aasta järel, välja arvatud juhul, kui ATP kokkuleppest tulenevalt toimub kontrollimine iga kuue aasta järel. Mõõtevahendit peab perioodiliselt kontrollima samaaegselt sõiduki kontrollimisega iga kolme aasta järel, välja arvatud juhul, kui ATP kokkuleppest tulenevalt toimub kontrollimine iga kuue aasta järel.",
      "rdfs:label": {
        "@value": "Reg_1002536_Par_6 (redaktsioon 1002536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002536",
      "estleg:sourceAct": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1002536 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002536_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002536_Par_7_v1002536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002536_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lisaks käesoleva määruse §-des 4–6 sätestatud mõõtevahendi kontrollimise liikidele peab mõõtevahendit kontrollima ka majandus- ja kommunikatsiooniministri 18. juuli 2011. a määruse nr 77 „Mootorsõiduki ja selle haagise tehnonõuetele vastavuse kontrollimise tingimused ja kord” kohase sõiduki tehnonõuetele vastavuse kontrollimise käigus. Kontrollimist teostab sellisel juhul ülevaataja nimetatud määruse mõistes. Lisaks käesoleva määruse §-des 4–6 sätestatud mõõtevahendi kontrollimise liikidele peab mõõtevahendit kontrollima ka majandus- ja kommunikatsiooniministri 18. juuli 2011. a määruse nr 77 „Mootorsõiduki ja selle haagise tehnonõuetele vastavuse kontrollimise tingimused ja kord” kohase sõiduki tehnonõuetele vastavuse kontrollimise käigus. Kontrollimist teostab sellisel juhul ülevaataja nimetatud määruse mõistes. 2 (2) Kontrollimise käigus tuleb veenduda järgmiste nõuete täitmises: 1 1) mõõtevahend peab olema töökorras; 2 2) veose ruum peab olema sobiv külmutatud toiduainete veoks; 3 3) sõidukile kantud tähistused peavad olema kehtivad. Kontrollimise käigus tuleb veenduda järgmiste nõuete täitmises: mõõtevahend peab olema töökorras; veose ruum peab olema sobiv külmutatud toiduainete veoks; sõidukile kantud tähistused peavad olema kehtivad.",
      "rdfs:label": {
        "@value": "Reg_1002536_Par_7 (redaktsioon 1002536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002536",
      "estleg:sourceAct": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1002536 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002536_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002536_Par_8_v1002536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002536_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pädevaks asutuseks, kes kontrollib mõõtevahendite paigaldajate ja tunnustatud ametlike katsejaamade tegevust ning väljastab ATP kokkuleppe lisa 1 lisandus 3 kohase tunnistuse, on Maanteeamet. Pädevaks asutuseks, kes kontrollib mõõtevahendite paigaldajate ja tunnustatud ametlike katsejaamade tegevust ning väljastab ATP kokkuleppe lisa 1 lisandus 3 kohase tunnistuse, on Maanteeamet. 2 (2) Käesoleva määruse paragrahvi 3 lõikes 3 nimetatud isikud peavad alles hoidma kontrollimise tulemusi tõendavaid dokumente vähemalt kolm aastat kuni järgmise kontrollimise kuupäevani (kaasa arvatud). Käesoleva määruse paragrahvi 3 lõikes 3 nimetatud isikud peavad alles hoidma kontrollimise tulemusi tõendavaid dokumente vähemalt kolm aastat kuni järgmise kontrollimise kuupäevani (kaasa arvatud). 3 (3) Maanteeamet peab tunnustatud ametlike katsejaamade nimelist andmebaasi ja annab kontrolli õigust omavatele isikutele nende nõudmisel vajalikku informatsiooni. Maanteeamet peab tunnustatud ametlike katsejaamade nimelist andmebaasi ja annab kontrolli õigust omavatele isikutele nende nõudmisel vajalikku informatsiooni.",
      "rdfs:label": {
        "@value": "Reg_1002536_Par_8 (redaktsioon 1002536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002536",
      "estleg:sourceAct": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1002536 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002536_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002536_Par_9_v1002536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002536_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandus- ja kommunikatsiooniministri 25. oktoobri 2005. a määrus nr 129 „Nõuded kiiresti riknevate külmutatud toiduainete veoks kasutatavas sõidukis õhutemperatuuri registreerimise mõõtevahendile ja kontrollimisele” tunnistatakse kehtetuks. Majandus- ja kommunikatsiooniministri 25. oktoobri 2005. a määrus nr 129 „Nõuded kiiresti riknevate külmutatud toiduainete veoks kasutatavas sõidukis õhutemperatuuri registreerimise mõõtevahendile ja kontrollimisele” tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1002536_Par_9 (redaktsioon 1002536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002536",
      "estleg:sourceAct": "Kiiresti riknevate külmutatud toiduainete veoks kasutatava sõiduki õhutemperatuuri registreerimise mõõtevahendi kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1002536 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002536_Map"
      }
    },
