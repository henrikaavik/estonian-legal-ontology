    {
      "@id": "estleg:Reg_1052938_Par_4_v1052938",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052938_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas3 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndi piiri kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas3 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndi piiri kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1052938_Par_4 (redaktsioon 1052938)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052938",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052938",
      "estleg:sourceAct": "Alliku looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1052938 § 4",
      "estleg:partOfAct": {
