      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Jahiuluki ebaseadusliku hukkamise või jahiuluki elupaiga hävitamise või kahjustamisega keskkonnale tekitatud kahju arvestamise alused ja kahjumäärad (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Jahiuluki ebaseadusliku hukkamise või jahiuluki elupaiga hävitamise või kahjustamisega keskkonnale tekitatud kahju arvestamise alused ja kahjumäärad"
    },
    {
      "@id": "estleg:Reg_1014078_Par_1_v1014078",
      "@type": [
        "owl:NamedIndividual",
