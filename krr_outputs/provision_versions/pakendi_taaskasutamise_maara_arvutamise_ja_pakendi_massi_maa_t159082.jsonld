      "estleg:provisionRef": "Reg_159082 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159082_Map"
      }
    },
    {
      "@id": "estleg:Reg_159082_Par_3_v159082",
      "@type": [
        "owl:NamedIndividual",
