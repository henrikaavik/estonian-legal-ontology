    {
      "@id": "estleg:VMTS_Par_32_v12853872",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VMTS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väärismetalltoodete jaemüügi õigust omavate ettevõtjate üle peetakse arvestust: kauplemislubade väljastaja poolt peetavate andmekogude kaudu; riikliku erinõuetega tegevusaladel tegutsevate ettevõtjate registri kaudu.",
      "rdfs:label": {
        "@value": "VMTS_Par_32 (redaktsioon 12853872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12853872",
      "estleg:supersededByVersion": {
        "@id": "estleg:VMTS_Par_32_v13329589"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12853872",
      "estleg:sourceAct": "Väärismetalltoodete seadus",
      "estleg:provisionRef": "VMTS § 32",
      "estleg:partOfAct": {
