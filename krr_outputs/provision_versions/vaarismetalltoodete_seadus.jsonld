    {
      "@id": "estleg:VMTS_Par_50_v12853872",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VMTS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikusse erinõuetega tegevusaladel tegutsevate ettevõtjate registrisse kandmata tegevuskohas väärismetalltoodete käitlemise eest – karistatakse rahatrahviga kuni 100 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 15 000 krooni.",
      "rdfs:label": {
        "@value": "VMTS_Par_50 (redaktsioon 12853872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12853872",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12853872",
      "estleg:sourceAct": "Väärismetalltoodete seadus",
      "estleg:provisionRef": "VMTS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:VMTS_Map_2026"
      }
    },
    {
      "@id": "estleg:VMTS_Par_53_v12853872",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
