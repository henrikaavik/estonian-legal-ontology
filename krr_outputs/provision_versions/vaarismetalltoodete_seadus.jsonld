      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12911751",
      "estleg:sourceAct": "Väärismetalltoodete seadus",
      "estleg:provisionRef": "VMTS § 21",
