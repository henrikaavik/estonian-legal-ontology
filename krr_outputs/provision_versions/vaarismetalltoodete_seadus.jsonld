      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2004. aasta 15. aprillil.",
      "rdfs:label": {
        "@value": "VMTS_Par_58 (redaktsioon 729324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "729324",
