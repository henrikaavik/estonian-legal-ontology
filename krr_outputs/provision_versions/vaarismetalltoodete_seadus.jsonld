      }
    },
    {
      "@id": "estleg:VMTS_Par_33_v12853872",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VMTS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väärismetalltoodete jaemüük ei ole lubatud: turul; tänavakaubanduses; pandimajas; koduukselepingute kaudu võlaõigusseaduse (RT I 2001, 81, 487; 2002, 60, 374) § 46 tähenduses; avalikul üritusel, välja arvatud üritused, kus väärismetalltoodete jaemüük on ürituse eesmärgist tulenevalt asjakohane.",
      "rdfs:label": {
        "@value": "VMTS_Par_33 (redaktsioon 12853872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12853872",
