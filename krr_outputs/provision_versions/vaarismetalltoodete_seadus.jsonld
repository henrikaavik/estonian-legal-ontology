        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VMTS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väärismetalltoote jaemüügil peab jaemüüja andma ostjale väärismetalltoote eest maksmist tõendava dokumendi, mis vastab õigusaktis kehtestatud nõuetele ja võimaldab müüdud väärismetalltoodet identifitseerida.",
      "rdfs:label": {
        "@value": "VMTS_Par_34 (redaktsioon 12853872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12853872",
      "estleg:supersededByVersion": {
        "@id": "estleg:VMTS_Par_34_v12911751"
      },
      "estleg:versionValidTo": {
        "@value": "2008-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12853872",
      "estleg:sourceAct": "Väärismetalltoodete seadus",
      "estleg:provisionRef": "VMTS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:VMTS_Map_2026"
      }
    },
    {
      "@id": "estleg:VMTS_Par_34_v12911751",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VMTS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väärismetalltoodete jaemüügil peab müüja andma ostjale väärismetalltoote eest maksmist tõendava dokumendi ja hulgimüügil saatedokumendi, mis sisaldab vähemalt järgmist teavet väärismetalltoote kohta: väärismetalltoote nimetus; väärismetalltoote valmistamiseks kasutatud väärismetalli nimetus ja proov; väärismetalltoote mass. (2) Majandus- ja kommunikatsiooniminister võib kehtestada täpsustatud nõuded väärismetalltoote müügil väärismetalltoote kohta esitatavale teabele. (3) Käesoleva paragrahvi lõike 2 alusel kehtestatud nõuded võivad sisaldada nõudeid ka väärismetalltootele lisatud kristallilise või orgaanilise aine kohta esitatavale teabele.",
      "rdfs:label": {
        "@value": "VMTS_Par_34 (redaktsioon 12911751)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12911751",
      "estleg:supersededByVersion": {
        "@id": "estleg:VMTS_Par_34_v129062014095"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12911751",
      "estleg:sourceAct": "Väärismetalltoodete seadus",
      "estleg:provisionRef": "VMTS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:VMTS_Map_2026"
      }
    },
    {
      "@id": "estleg:VMTS_Par_34_v129062014095",
