        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VMTS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väärismetalltoodete sisseveo ja hulgimüügi korral, kui tehinguväärtus on suurem kui 15 000 krooni, arveldatakse väärismetalltoodete eest sularahata arvelduse korras.",
      "rdfs:label": {
        "@value": "VMTS_Par_36 (redaktsioon 12911751)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12911751",
