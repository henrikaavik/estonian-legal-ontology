      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "VMTS_Par_32 (redaktsioon 13329589)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329589",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13329589",
