      "estleg:versionText": "Käesolev seadus jõustub 2004. aasta 1. jaanuaril. Õiend Aktile lisatud redaktsiooni kehtimisaja lõpu kuupäev 14.04.2004",
      "rdfs:label": {
        "@value": "VMTS_Par_58 (redaktsioon 12853872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12853872",
