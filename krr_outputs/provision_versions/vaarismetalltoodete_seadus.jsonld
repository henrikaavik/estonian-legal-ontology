        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väärismetalltoodete sisseveo ja hulgimüügi korral arveldatakse väärismetalltoodete eest sularahata arvelduse korras.",
      "rdfs:label": {
        "@value": "VMTS_Par_36 (redaktsioon 12853872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12853872",
      "estleg:supersededByVersion": {
        "@id": "estleg:VMTS_Par_36_v12911751"
      },
      "estleg:versionValidTo": {
        "@value": "2008-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12853872",
      "estleg:sourceAct": "Väärismetalltoodete seadus",
      "estleg:provisionRef": "VMTS § 36",
      "estleg:partOfAct": {
