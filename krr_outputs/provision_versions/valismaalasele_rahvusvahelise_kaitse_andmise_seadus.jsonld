      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveamet annab ajutise kaitse saajale, kes viiakse Eestist teise Euroopa Liidu liikmesriiki, reisiloa. (2) Reisiloa vormi ja sellele kantavate andmete loetelu",
      "rdfs:label": {
        "@value": "VRKS_Par_67 (redaktsioon 13251905)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13251905",
