      },
      "estleg:versionText": "Andmekogu ABIS vastutav töötleja on Politsei- ja Piirivalveamet.",
      "rdfs:label": {
        "@value": "VRKS_Par_32 (redaktsioon 103062026001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103062026001",
