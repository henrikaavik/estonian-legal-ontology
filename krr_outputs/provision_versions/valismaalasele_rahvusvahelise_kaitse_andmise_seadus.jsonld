      }
    },
    {
      "@id": "estleg:VRKS_Par_67_v119032015071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveamet annab ajutise kaitse saajale, kes viiakse Eestist teise Euroopa Liidu liikmesriiki, reisiloa. (2) Reisiloa vormi ja sellele kantavate andmete loetelu kehtestab määrusega.",
      "rdfs:label": {
        "@value": "VRKS_Par_67 (redaktsioon 119032015071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015071"
    },
    {
      "@id": "estleg:VRKS_Par_68_v1027980",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKS_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui välislepingus ei ole sätestatud teisiti, on Eesti kohustatud tagasi võtma ajutise kaitse saaja, kellel on kehtiv Eesti poolt väljaantud elamisluba ja kes viibib ebaseaduslikult teises Euroopa Liidu liikmesriigis või kes on ebaseaduslikult sisenenud teise Euroopa Liidu liikmesriiki.",
      "rdfs:label": {
        "@value": "VRKS_Par_68 (redaktsioon 1027980)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027980"
    },
    {
      "@id": "estleg:VRKS_Par_69_v1027980",
      "@type": [
