        "@id": "estleg:VRKS_Map"
      },
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKS_Par_17_v117062020004"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VRKS_Par_17_v117062020004",
