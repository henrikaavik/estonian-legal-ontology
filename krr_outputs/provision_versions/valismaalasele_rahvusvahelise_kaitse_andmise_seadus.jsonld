        "@value": "2006-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kodakondsus- ja Migratsiooniamet peatab varjupaigamenetluse ajutise kaitse kehtivusajaks.",
      "rdfs:label": {
        "@value": "VRKS_Par_28 (redaktsioon 1027980)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027980",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKS_Par_28_v13251905"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VRKS_Par_28_v13251905",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet peatab varjupaigamenetluse ajutise kaitse kehtivusajaks.",
      "rdfs:label": {
        "@value": "VRKS_Par_28 (redaktsioon 13251905)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13251905",
