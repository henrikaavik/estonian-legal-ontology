        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VRKS_Par_28_v106042016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet peatab rahvusvahelise kaitse menetluse ajutise kaitse kehtivusajaks.",
      "rdfs:label": {
        "@value": "VRKS_Par_28 (redaktsioon 106042016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106042016002"
    },
    {
      "@id": "estleg:VRKS_Par_29_v1027980",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kodakondsus- ja Migratsiooniamet võib varjupaigamenetluse eesmärgipäraseks, efektiivseks, lihtsaks ja kiireks läbiviimiseks kohaldada taotleja suhtes järgmisi järelevalvemeetmeid: elamine kindlaksmääratud kohas; ilmumine määratud ajavahemike järel Kodakondsus- ja Migratsiooniametisse registreerimisele; Kodakondsus- ja Migratsiooniameti teavitamine elukohast eemal viibimisest kauem kui kolm päeva. (2) Kodakondsus- ja migratsiooniametnikul ning politseiametnikul on õigus igal ajal kontrollida järelevalvemeetmete järgimist taotleja poolt. (3) Järelevalvemeetmete kohaldamine tehakse taotlejale teatavaks kirjalikult.",
      "rdfs:label": {
        "@value": "VRKS_Par_29 (redaktsioon 1027980)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027980",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKS_Par_29_v13251905"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VRKS_Par_29_v13251905",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveamet võib varjupaigamenetluse eesmärgipäraseks, efektiivseks, lihtsaks ja kiireks läbiviimiseks kohaldada taotleja suhtes järgmisi järelevalvemeetmeid: elamine kindlaksmääratud kohas; ilmumine määratud ajavahemike järel Politsei- ja Piirivalveametisse registreerimisele; Politsei- ja Piirivalveameti teavitamine elukohast eemal viibimisest kauem kui kolm päeva. (2) Politsei- ja Piirivalveametil ning Kaitsepolitseiametil on õigus igal ajal kontrollida järelevalvemeetmete järgimist taotleja poolt. (3) Järelevalvemeetmete kohaldamine tehakse taotlejale teatavaks kirjalikult.",
