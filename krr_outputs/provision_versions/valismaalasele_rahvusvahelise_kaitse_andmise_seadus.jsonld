      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VRKS_Par_6_2 (redaktsioon 106042016002)",
        "@language": "et"
