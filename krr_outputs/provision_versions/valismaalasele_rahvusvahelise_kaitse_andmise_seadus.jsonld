      },
      "estleg:versionText": "Töövõimetoetuse seaduse § 2 lõike 1 punktist 3 jäetakse välja tekstiosa „rahvusvahelise kaitse, sealhulgas ajutise kaitse saaja või”.",
      "rdfs:label": {
        "@value": "VRKS_Par_124 (redaktsioon 103062026001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103062026001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103062026001",
      "estleg:sourceAct": "Välismaalasele rahvusvahelise kaitse andmise seadus",
      "estleg:provisionRef": "VRKS § 124",
      "estleg:partOfAct": {
        "@id": "estleg:VRKS_Map"
      },
