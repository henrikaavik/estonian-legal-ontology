    {
      "@id": "estleg:Reg_1010944_Par_2_v1010944",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1010944_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandusplasti kasutaja on füüsiline või juriidiline isik, kes kasutab põllumajandusplasti. Põllumajandusplasti kasutaja on füüsiline või juriidiline isik, kes kasutab põllumajandusplasti.",
      "rdfs:label": {
        "@value": "Reg_1010944_Par_2 (redaktsioon 1010944)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1010944",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1010944",
      "estleg:sourceAct": "Põllumajandusplastist tekkinud jäätmete kogumise, tootjale tagastamise ning taaskasutamise või kõrvaldamise nõuded ja kord ning sihtarvud ja sihtarvude saavutamise tähtajad",
      "estleg:provisionRef": "Reg_1010944 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1010944_Map_2026"
