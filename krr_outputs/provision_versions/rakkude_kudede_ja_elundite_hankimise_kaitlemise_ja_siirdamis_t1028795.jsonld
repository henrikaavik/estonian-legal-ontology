      "dc:source": "Rakkude, kudede ja elundite hankimise, käitlemise ja siirdamise aruannete koostamise nõuded, andmete koosseis ning esitamise kord"
    },
    {
      "@id": "estleg:Reg_1028795_Par_1_v1028795",
