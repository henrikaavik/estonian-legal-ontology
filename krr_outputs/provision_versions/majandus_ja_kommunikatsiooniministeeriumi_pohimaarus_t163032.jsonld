      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandus- ja Kommunikatsiooniministeerium (edaspidi ministeerium) on valitsusasutus, kes täidab seadustest tulenevaid ja Vabariigi Valitsuse poolt seaduse alusel antud ülesandeid Vabariigi Valitsuse seaduse § 63 lõikes 1 sätestatud valitsemisala valdkondades. RT I 2020-12-30 1 130122020001 2021-02-15 Majandus- ja Kommunikatsiooniministeerium (edaspidi ministeerium) on valitsusasutus, kes täidab seadustest tulenevaid ja Vabariigi Valitsuse poolt seaduse alusel antud ülesandeid Vabariigi Valitsuse seaduse § 63 lõikes 1 sätestatud valitsemisala valdkondades.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_1 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_10_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumi tegevuse eesmärk on luua eeldused Eesti majanduse konkurentsivõime ja tootlikkuse kasvuks, töötades välja ja viies ellu riigi majandus-, ettevõtlus-, tööhõive-, tööturu- ja maakasutuspoliitikat. RT I 2024-12-29 3 129122024003 2025-01-01 Ministeeriumi tegevuse eesmärk on luua eeldused Eesti majanduse konkurentsivõime ja tootlikkuse kasvuks, töötades välja ja viies ellu riigi majandus-, ettevõtlus-, tööhõive-, tööturu- ja maakasutuspoliitikat.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_10 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_11_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandus- ja Kommunikatsiooniministeeriumi valitsemisalas on riigi majandus-, ettevõtlus-, tööhõive- ja tööturupoliitika kavandamine ja elluviimine; ettevõtjate teadus- ja arendustegevuse ning innovatsiooni toetamine ja korraldamine, ettevõtjatele teenuste arendamine; reaalajamajanduse, tööstuse, kosmose ja turismi valdkonna arendamine; ekspordi arendamine ja investeeringute kaasamise toetamine, sealhulgas välisinvesteeringute usaldusväärsuse tagamine; metroloogia, standardiseerimise, sertifitseerimise, akrediteerimise, tegevuslubade, registrite, tarbijakaitse, toote- ja tööstusohutuse, kaubanduse ja kaubanduse kaitsemeetmete korraldamine, riigi tegevusvaru haldamine, ohutusjuurdluse korraldamine, meediateenuste riiklik järelevalve; töösuhete ja töökeskkonna korraldamine ning võrdse kohtlemise ja soolise võrdõiguslikkuse, sealhulgas ligipääsetavuse edendamine ja koordineerimine; maakasutuspoliitika kavandamine ja elluviimine, ruumilise planeerimise korraldamine, maa- ja ruumivaldkonna ülesannete täitmine ning vastavate õigusaktide eelnõude koostamine. RT I 2024-12-29 3 129122024003 2025-01-01 Majandus- ja Kommunikatsiooniministeeriumi valitsemisalas on riigi majandus-, ettevõtlus-, tööhõive- ja tööturupoliitika kavandamine ja elluviimine; ettevõtjate teadus- ja arendustegevuse ning innovatsiooni toetamine ja korraldamine, ettevõtjatele teenuste arendamine; reaalajamajanduse, tööstuse, kosmose ja turismi valdkonna arendamine; ekspordi arendamine ja investeeringute kaasamise toetamine, sealhulgas välisinvesteeringute usaldusväärsuse tagamine; metroloogia, standardiseerimise, sertifitseerimise, akrediteerimise, tegevuslubade, registrite, tarbijakaitse, toote- ja tööstusohutuse, kaubanduse ja kaubanduse kaitsemeetmete korraldamine, riigi tegevusvaru haldamine, ohutusjuurdluse korraldamine, meediateenuste riiklik järelevalve; töösuhete ja töökeskkonna korraldamine ning võrdse kohtlemise ja soolise võrdõiguslikkuse, sealhulgas ligipääsetavuse edendamine ja koordineerimine; maakasutuspoliitika kavandamine ja elluviimine, ruumilise planeerimise korraldamine, maa- ja ruumivaldkonna ülesannete täitmine ning vastavate õigusaktide eelnõude koostamine.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_11 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_12_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumi põhiülesanded on: 1 1) valitsemisala valdkondades riigi arengukavade väljatöötamine ja nende kooskõla tagamine üleriigiliste arengukavadega, nende finantseerimise, elluviimise ja tulemuste hindamise korraldamine; 2 2) osalemine üleriigiliste majanduse arengut puudutavate arengukavade väljatöötamisel koostöös teiste asjaomaste ministeeriumidega; 3 3) valitsemisala valdkondade korraldamiseks õigusaktide eelnõude koostamise, nende põhiseadusele ja seadustele vastavuse tagamine ning õigusaktidega määratud ülesannete täitmine; 4 4) valitsemisalas rahvusvahelise koostöö korraldamine, sealhulgas Euroopa Liidu ja rahvusvaheliste organisatsioonide alane tegevus; RT I 2008 12 81 12933550 2008-03-08 5 5) kehtetu - RT I 2021-03-02 1 102032021001 2021-05-01 6 6) kriisireguleerimise, riigikaitseliste ülesannete täitmise ja elutähtsate teenuste toimepidevuse korraldamine valitsemisalas. RT I 2017-04-07 9 107042017009 2017-04-10 Ministeeriumi põhiülesanded on: valitsemisala valdkondades riigi arengukavade väljatöötamine ja nende kooskõla tagamine üleriigiliste arengukavadega, nende finantseerimise, elluviimise ja tulemuste hindamise korraldamine; osalemine üleriigiliste majanduse arengut puudutavate arengukavade väljatöötamisel koostöös teiste asjaomaste ministeeriumidega; valitsemisala valdkondade korraldamiseks õigusaktide eelnõude koostamise, nende põhiseadusele ja seadustele vastavuse tagamine ning õigusaktidega määratud ülesannete täitmine; valitsemisalas rahvusvahelise koostöö korraldamine, sealhulgas Euroopa Liidu ja rahvusvaheliste organisatsioonide alane tegevus; kehtetu - kriisireguleerimise, riigikaitseliste ülesannete täitmise ja elutähtsate teenuste toimepidevuse korraldamine valitsemisalas.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_12 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_13_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium teostab aktsionäri või osaniku õigusi äriühingutes, mille aktsiaid või osa ta valitseb, ning asutaja- või liikmeõigusi sihtasutustes ja mittetulundusühingutes. RT I 2008 12 81 12933550 2008-03-08 Ministeerium teostab aktsionäri või osaniku õigusi äriühingutes, mille aktsiaid või osa ta valitseb, ning asutaja- või liikmeõigusi sihtasutustes ja mittetulundusühingutes.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_13 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_14_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium täidab muid talle õigusaktidega ja Vabariigi Valitsuse poolt pandud ülesandeid. Ministeerium täidab muid talle õigusaktidega ja Vabariigi Valitsuse poolt pandud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_14 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_15_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ministeeriumi tegevuse eesmärgi saavutamiseks ja põhiülesannete täitmiseks teostab ministeerium valitsemisala terviklikku strateegilist juhtimist, mille aluseks on ministeeriumi ja ministeeriumi valitsemisalasse kuuluvate riigiasutuste strateegia ja sellest tulenevad tööplaanid. Ministeeriumi tegevuse eesmärgi saavutamiseks ja põhiülesannete täitmiseks teostab ministeerium valitsemisala terviklikku strateegilist juhtimist, mille aluseks on ministeeriumi ja ministeeriumi valitsemisalasse kuuluvate riigiasutuste strateegia ja sellest tulenevad tööplaanid. 2 (2) Ministeerium realiseerib oma ülesandeid ministeeriumi struktuuriüksuste, ministeeriumis moodustatavate komisjonide, ministeeriumi valitsemisalasse kuuluvate ametite, inspektsioonide, hallatavate riigiasutuste, sihtasutuste ja mittetulundusühingute kaudu ning koostöös teiste valitsusasutuste ja juriidiliste isikutega. Ministeerium realiseerib oma ülesandeid ministeeriumi struktuuriüksuste, ministeeriumis moodustatavate komisjonide, ministeeriumi valitsemisalasse kuuluvate ametite, inspektsioonide, hallatavate riigiasutuste, sihtasutuste ja mittetulundusühingute kaudu ning koostöös teiste valitsusasutuste ja juriidiliste isikutega.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_15 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_16_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ministeeriumi osakond on ministeeriumi põhiline struktuuriüksus, kellel puuduvad täitevvõimu volitused ministeeriumiväliste isikute suhtes, kui seaduses ei ole sätestatud teisiti. Ministeeriumi osakond on ministeeriumi põhiline struktuuriüksus, kellel puuduvad täitevvõimu volitused ministeeriumiväliste isikute suhtes, kui seaduses ei ole sätestatud teisiti. 2 (2) Osakonna koosseisu võivad kuuluda talitused. Osakonna struktuur, pädevus ja juhtimise korraldus määratakse ministri poolt kinnitatud osakonna põhimääruses. RT I 2008 12 81 12933550 2008-03-08 Osakonna koosseisu võivad kuuluda talitused. Osakonna struktuur, pädevus ja juhtimise korraldus määratakse ministri poolt kinnitatud osakonna põhimääruses. 3 (3) Osakonna koosseisu võivad kuuluda ametnikud ja töötajad, kes ei ole ühegi talituse koosseisus, vaid alluvad vahetult osakonnajuhatajale, ja kelle ülesanded määratakse osakonna põhimääruse ja ametijuhendiga. RT I 2012-12-18 14 118122012014 2013-04-01 Osakonna koosseisu võivad kuuluda ametnikud ja töötajad, kes ei ole ühegi talituse koosseisus, vaid alluvad vahetult osakonnajuhatajale, ja kelle ülesanded määratakse osakonna põhimääruse ja ametijuhendiga. 4 (4) Ohutusjuurdluse Keskus on ministeeriumi struktuuriüksus, kelle ülesanne on lennuõnnetuse, tõsise lennuintsidendi, lennuintsidendi, laevaõnnetuse, raudteeliiklusõnnetuse ja raudteeintsidendi põhjuste ohutusjuurdluse korraldamine. Ohutusjuurdluse Keskuse struktuur, pädevus, juhtimise korraldus ja täpsemad ülesanded määratakse ministri kinnitatud Ohutusjuurdluse Keskuse põhimääruses. RT I 2020-12-30 1 130122020001 2021-02-15 Ohutusjuurdluse Keskus on ministeeriumi struktuuriüksus, kelle ülesanne on lennuõnnetuse, tõsise lennuintsidendi, lennuintsidendi, laevaõnnetuse, raudteeliiklusõnnetuse ja raudteeintsidendi põhjuste ohutusjuurdluse korraldamine. Ohutusjuurdluse Keskuse struktuur, pädevus, juhtimise korraldus ja täpsemad ülesanded määratakse ministri kinnitatud Ohutusjuurdluse Keskuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_16 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_17_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumi osakonnad ja nende põhiülesanded on: 1 1) avalike suhete osakond, kelle põhiülesanne on avalikkuse informeerimine ministeeriumi tegevusest ning ministeeriumi ja avalikkuse vaheliste suhete korraldamine, ministeeriumi osakondade avaliku suhtluse kavade koostamine ning sisuhaldus sise- ja välisveebis; 1 1¹) digimajanduse osakond, kelle põhiülesanne on majanduse ja ettevõtluse arengu, sealhulgas reaalajamajanduse toetamisele ja arendustegevustele, ettevõtetele osutatavate avalike teenuste arendamise ja nendest teavitamise koordineerimisele suunatud poliitika kujundamine ja selle elluviimise kavandamine, valdkonna arengukavade väljatöötamine, elluviimine ja tulemuslikkuse seire ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; RT I 2024-02-09 2 109022024002 2024-03-01 1 1²) kehtetu - RT I 2024-12-29 3 129122024003 2025-01-01 2 2) eelarveosakond, kelle põhiülesanne on ministeeriumi valitsemisala valitsusasutuste ning hallatavate riigiasutuste finantsjuhtimise korraldamine, sealhulgas informatsiooni ja dokumentatsiooni edastamine Riigi Tugiteenuste Keskusele, Euroopa Liidu ja välisvahendite alusel saadud vahendite planeerimine riigieelarvesse, osalemine välisabist ja välislepingutest rahastatavate programmide väljatöötamises, rakendamise korraldamises ja seires ning välisabi kasutamise üle järelevalve teostamine; RT I 2021-03-02 1 102032021001 2021-05-01 3 3) kehtetu - RT I 2023-06-28 2 128062023002 2023-07-01 4 4) kehtetu - RT I 2023-06-28 2 128062023002 2023-07-01 5 5) ettevõtluskeskkonna ja tööstuse osakond, kelle põhiülesanne on ettevõtluskeskkonna arendustegevus, sealhulgas kaubanduse, teenuste, turismi, väliskaubanduse, ekspordi arengu, investeeringute kaasamise, välisinvesteeringute usaldusväärsuse, kvaliteediinfrastruktuuri, tarbijakaitse arengule ning Euroopa Liidu siseturu tõketeta toimimisele ja rahvusvahelisele koostööle suunatud poliitika ja arengukavade kujundamine, elluviimise ja tulemuslikkuse seire, algatuste eestvedamine ja valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; RT I 2024-12-29 3 129122024003 2025-01-01 6 6) Euroopa Liidu ja rahvusvahelise koostöö osakond, kelle põhiülesanne on ministeeriumi valitsemisala Euroopa Liidu ja rahvusvaheliste organisatsioonide liikmesusest ja tegevusest tulenevate kohustuste täitmise korraldamine, sealhulgas Euroopa Liidu Nõukogu töörühmade töös osalemine, Euroopa Komisjoni komiteede ja ekspertgruppide töös osalemise ning Eesti seisukohtade ettevalmistamise koordineerimine ja ministeeriumi valitsemisala Euroopa Liidu alane nõustamine ning rahvusvaheliste koostöösuhete arendamine; RT I 2024-02-09 2 109022024002 2024-03-01 7 7) kehtetu - RT I 2023-06-28 2 128062023002 2023-07-01 8 8) kehtetu - RT I 2021-03-02 1 102032021001 2021-05-01 9 9) kehtetu - RT I 2023-06-28 2 128062023002 2023-07-01 10 10) kehtetu - RT I 2023-06-28 2 128062023002 2023-07-01 11 11) kehtetu - RT I 2023-06-28 2 128062023002 2023-07-01 12 12) innovatsiooni ja tehnoloogia osakond, kelle põhiülesanne on ettevõtete teadus- ja arendustegevuse, sealhulgas tehnoloogilise arendustegevuse, kosmosevaldkonna ning innovatsioonialase poliitika kujundamine, selle elluviimise kavandamine ja tulemuslikkuse seire, valdkonna arengukavade väljatöötamine, elluviimine ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; RT I 2024-02-09 2 109022024002 2024-03-01 12 12¹) maa- ja ruumipoliitika osakond, kelle põhiülesanne on ruumilise planeerimise ja maakasutuspoliitika kavandamine ja elluviimine, üleriigilise planeerimisalase tegevuse suunamine ja korraldamine, üleriigilise planeeringu, riigi eriplaneeringu ja maakonnaplaneeringu koostamise korraldamine, sealhulgas mereala ruumilise planeerimise ning planeerimisalase koostöö korraldamine, ruumilise planeerimise ühtsete infosüsteemide arendamise suunamine ja koordineerimine, ministeeriumi valitsemisel oleva riigimaaga ning maa- ja ruumiandmekogudega seotud ülesannete täitmise koordineerimine ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; RT I 2025-04-02 3 102042025003 2025-04-05 13 13) kehtetu - RT I 2023-06-28 2 128062023002 2023-07-01 14 14) personaliosakond, kelle põhiülesanne on personali- ja koolitustöö korraldamine ministeeriumis ning koordineerimine valitsemisala valitsusasutustes ja hallatavates riigiasutustes ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; RT I 2021-10-23 2 123102021002 2022-01-01 14 14¹) kehtetu - RT I 2024-12-29 3 129122024003 2025-01-01 14 14²) kehtetu - RT I 2025-04-02 3 102042025003 2025-04-05 15 15) kehtetu - RT I 2024-12-29 3 129122024003 2025-01-01 16 16) siseauditi osakond, kelle põhiülesanne on siseaudiitori kutsetegevuse alaste ülesannete täitmine ministeeriumis, ministeeriumi valitsemisala asutustes, samuti teistes asutustes ja juriidilistes isikutes, kui selline kohustus tuleneb õigusaktidest või lepingutest, ning sisekontrollisüsteemide rakendamise ja tulemuslikkuse kohta arvamuse avaldamine; 16 16¹) strateegiaosakond, kelle põhiülesanne on ministeeriumi valitsemisala strateegilise juhtimise korraldamine, teadus- ja arendustegevuse koordineerimine ja teadmuse levitamine, ministeeriumi poliitikakujundamise ja analüüsivõimekuse toetamine, kriisireguleerimise, riigikaitseliste ülesannete täitmise ja elutähtsate teenuste toimepidevuse korraldamine valitsemisalas, riigi tegevusvaru haldamine, välisvahendite kavandamise, rakendamise, seire ja hindamise koordineerimine ning sellega seonduv väliskoostöö ja järelevalve; RT I 2023-06-28 2 128062023002 2023-07-01 17 17) kehtetu - RT I 2023-06-28 2 128062023002 2023-07-01 18 18) kehtetu - RT I 2023-06-28 2 128062023002 2023-07-01 18 18¹) tööhõive osakond, kelle põhiülesanne on tööturupoliitika kavandamine ja selle elluviimise korraldamine, et tagada tööealise elanikkonna suur tööga hõivatus ning tarviliku tööjõu olemasolu tööandjatele, ja valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine. Osakonnal on juhtiv roll tööjõu mobiilsuse, töövõime ja tööhõivevõime arendamisel ning nende poliitikavaldkondadega seotud tööturuteenuste, kulutuste, hüvitiste ja toetuste kujundamisel; RT I 2024-12-29 3 129122024003 2025-01-01 18 18²) töösuhete ja töökeskkonna osakond, kelle põhiülesanne on tööpoliitika kavandamine ja koordineerimine ning selle elluviimise korraldamine ja valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine. Osakonnal on juhtiv roll töösuhete, sealhulgas individuaalsete ja kollektiivsete töötingimuste ning ohutu ja tervisliku töökeskkonna arendamisel, samuti nende poliitikavaldkondadega seotud kulutuste ja hüvitiste kujundamisel; RT I 2024-12-29 3 129122024003 2025-01-01 18 18³) võrdsuspoliitika osakond, kelle põhiülesanne on soolise võrdõiguslikkuse ja võrdse kohtlemise, sealhulgas ligipääsetavuse poliitika kavandamine ja koordineerimine ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine. Osakonnal on juhtiv roll soolise võrdõiguslikkuse ja võrdse kohtlemise edendamisel ning lõime kavandamisel ja koordineerimisel, samuti diskrimineerimise ennetamiseks ja leevendamiseks vajalike meetmete kujundamisel; RT I 2024-12-29 3 129122024003 2025-01-01 19 19) kehtetu - RT I 2021-03-02 1 102032021001 2021-05-01 20 20) õigusosakond, kelle põhiülesanne on ministeeriumi õigusloome koordineerimine, õigusloomes ühtsete põhimõtete, terminoloogia ja metoodika kasutamise ning väljatöötatavate õigusaktide eelnõude omavahelise seostatuse, põhiseadusele ja seadustele vastavuse tagamine, ministeeriumi juhtkonna ja teiste struktuuriüksuste õigusalane nõustamine ning ministeeriumi õigushuvide esindamise korraldamine. RT I 2020-12-30 1 130122020001 2021-02-15 Ministeeriumi osakonnad ja nende põhiülesanded on: avalike suhete osakond, kelle põhiülesanne on avalikkuse informeerimine ministeeriumi tegevusest ning ministeeriumi ja avalikkuse vaheliste suhete korraldamine, ministeeriumi osakondade avaliku suhtluse kavade koostamine ning sisuhaldus sise- ja välisveebis; digimajanduse osakond, kelle põhiülesanne on majanduse ja ettevõtluse arengu, sealhulgas reaalajamajanduse toetamisele ja arendustegevustele, ettevõtetele osutatavate avalike teenuste arendamise ja nendest teavitamise koordineerimisele suunatud poliitika kujundamine ja selle elluviimise kavandamine, valdkonna arengukavade väljatöötamine, elluviimine ja tulemuslikkuse seire ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; kehtetu - eelarveosakond, kelle põhiülesanne on ministeeriumi valitsemisala valitsusasutuste ning hallatavate riigiasutuste finantsjuhtimise korraldamine, sealhulgas informatsiooni ja dokumentatsiooni edastamine Riigi Tugiteenuste Keskusele, Euroopa Liidu ja välisvahendite alusel saadud vahendite planeerimine riigieelarvesse, osalemine välisabist ja välislepingutest rahastatavate programmide väljatöötamises, rakendamise korraldamises ja seires ning välisabi kasutamise üle järelevalve teostamine; kehtetu - kehtetu - ettevõtluskeskkonna ja tööstuse osakond, kelle põhiülesanne on ettevõtluskeskkonna arendustegevus, sealhulgas kaubanduse, teenuste, turismi, väliskaubanduse, ekspordi arengu, investeeringute kaasamise, välisinvesteeringute usaldusväärsuse, kvaliteediinfrastruktuuri, tarbijakaitse arengule ning Euroopa Liidu siseturu tõketeta toimimisele ja rahvusvahelisele koostööle suunatud poliitika ja arengukavade kujundamine, elluviimise ja tulemuslikkuse seire, algatuste eestvedamine ja valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; Euroopa Liidu ja rahvusvahelise koostöö osakond, kelle põhiülesanne on ministeeriumi valitsemisala Euroopa Liidu ja rahvusvaheliste organisatsioonide liikmesusest ja tegevusest tulenevate kohustuste täitmise korraldamine, sealhulgas Euroopa Liidu Nõukogu töörühmade töös osalemine, Euroopa Komisjoni komiteede ja ekspertgruppide töös osalemise ning Eesti seisukohtade ettevalmistamise koordineerimine ja ministeeriumi valitsemisala Euroopa Liidu alane nõustamine ning rahvusvaheliste koostöösuhete arendamine; kehtetu - kehtetu - kehtetu - kehtetu - kehtetu - innovatsiooni ja tehnoloogia osakond, kelle põhiülesanne on ettevõtete teadus- ja arendustegevuse, sealhulgas tehnoloogilise arendustegevuse, kosmosevaldkonna ning innovatsioonialase poliitika kujundamine, selle elluviimise kavandamine ja tulemuslikkuse seire, valdkonna arengukavade väljatöötamine, elluviimine ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; maa- ja ruumipoliitika osakond, kelle põhiülesanne on ruumilise planeerimise ja maakasutuspoliitika kavandamine ja elluviimine, üleriigilise planeerimisalase tegevuse suunamine ja korraldamine, üleriigilise planeeringu, riigi eriplaneeringu ja maakonnaplaneeringu koostamise korraldamine, sealhulgas mereala ruumilise planeerimise ning planeerimisalase koostöö korraldamine, ruumilise planeerimise ühtsete infosüsteemide arendamise suunamine ja koordineerimine, ministeeriumi valitsemisel oleva riigimaaga ning maa- ja ruumiandmekogudega seotud ülesannete täitmise koordineerimine ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; kehtetu - personaliosakond, kelle põhiülesanne on personali- ja koolitustöö korraldamine ministeeriumis ning koordineerimine valitsemisala valitsusasutustes ja hallatavates riigiasutustes ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine; kehtetu - kehtetu - kehtetu - siseauditi osakond, kelle põhiülesanne on siseaudiitori kutsetegevuse alaste ülesannete täitmine ministeeriumis, ministeeriumi valitsemisala asutustes, samuti teistes asutustes ja juriidilistes isikutes, kui selline kohustus tuleneb õigusaktidest või lepingutest, ning sisekontrollisüsteemide rakendamise ja tulemuslikkuse kohta arvamuse avaldamine; strateegiaosakond, kelle põhiülesanne on ministeeriumi valitsemisala strateegilise juhtimise korraldamine, teadus- ja arendustegevuse koordineerimine ja teadmuse levitamine, ministeeriumi poliitikakujundamise ja analüüsivõimekuse toetamine, kriisireguleerimise, riigikaitseliste ülesannete täitmise ja elutähtsate teenuste toimepidevuse korraldamine valitsemisalas, riigi tegevusvaru haldamine, välisvahendite kavandamise, rakendamise, seire ja hindamise koordineerimine ning sellega seonduv väliskoostöö ja järelevalve; kehtetu - kehtetu - tööhõive osakond, kelle põhiülesanne on tööturupoliitika kavandamine ja selle elluviimise korraldamine, et tagada tööealise elanikkonna suur tööga hõivatus ning tarviliku tööjõu olemasolu tööandjatele, ja valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine. Osakonnal on juhtiv roll tööjõu mobiilsuse, töövõime ja tööhõivevõime arendamisel ning nende poliitikavaldkondadega seotud tööturuteenuste, kulutuste, hüvitiste ja toetuste kujundamisel; töösuhete ja töökeskkonna osakond, kelle põhiülesanne on tööpoliitika kavandamine ja koordineerimine ning selle elluviimise korraldamine ja valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine. Osakonnal on juhtiv roll töösuhete, sealhulgas individuaalsete ja kollektiivsete töötingimuste ning ohutu ja tervisliku töökeskkonna arendamisel, samuti nende poliitikavaldkondadega seotud kulutuste ja hüvitiste kujundamisel; võrdsuspoliitika osakond, kelle põhiülesanne on soolise võrdõiguslikkuse ja võrdse kohtlemise, sealhulgas ligipääsetavuse poliitika kavandamine ja koordineerimine ning valdkonda reguleerivate õigusaktide eelnõude ettevalmistamine. Osakonnal on juhtiv roll soolise võrdõiguslikkuse ja võrdse kohtlemise edendamisel ning lõime kavandamisel ja koordineerimisel, samuti diskrimineerimise ennetamiseks ja leevendamiseks vajalike meetmete kujundamisel; kehtetu - õigusosakond, kelle põhiülesanne on ministeeriumi õigusloome koordineerimine, õigusloomes ühtsete põhimõtete, terminoloogia ja metoodika kasutamise ning väljatöötatavate õigusaktide eelnõude omavahelise seostatuse, põhiseadusele ja seadustele vastavuse tagamine, ministeeriumi juhtkonna ja teiste struktuuriüksuste õigusalane nõustamine ning ministeeriumi õigushuvide esindamise korraldamine.",
