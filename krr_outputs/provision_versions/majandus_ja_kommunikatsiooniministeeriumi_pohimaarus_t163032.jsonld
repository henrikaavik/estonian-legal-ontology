    {
      "@id": "estleg:Reg_163032_Par_5_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium on aruandekohustuslik Vabariigi Valitsuse ees, kes suunab ja koordineerib tema tegevust ja teostab tema üle teenistuslikku järelevalvet õigusaktidega sätestatud korras. Ministeerium on aruandekohustuslik Vabariigi Valitsuse ees, kes suunab ja koordineerib tema tegevust ja teostab tema üle teenistuslikku järelevalvet õigusaktidega sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_5 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_6_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumil on sõõrikujuline 50 mm läbimõõduga pitsat, mille keskel on väikese riigivapi kujutis. Sõõri ülemisel äärel on sõnaühend „Majandus- ja Kommunikatsiooniministeerium“. RT I 2020-12-30 1 130122020001 2021-02-15 Ministeeriumil on sõõrikujuline 50 mm läbimõõduga pitsat, mille keskel on väikese riigivapi kujutis. Sõõri ülemisel äärel on sõnaühend „Majandus- ja Kommunikatsiooniministeerium“.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_6 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_7_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumil on oma eelarve ja arvelduskontod riigikassa kontsernikonto koosseisus. Ministeeriumi kulud kaetakse riigieelarvest. RT I 2014-11-28 21 128112014021 2014-12-01 Ministeeriumil on oma eelarve ja arvelduskontod riigikassa kontsernikonto koosseisus. Ministeeriumi kulud kaetakse riigieelarvest.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_7 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_8_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumi dokumendiplankidel kasutatakse väikest riigivappi. RT I 2020-12-30 1 130122020001 2021-02-15 Ministeeriumi dokumendiplankidel kasutatakse väikest riigivappi.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_8 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
      "estleg:sourceAct": "Majandus- ja Kommunikatsiooniministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_163032 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163032_Map"
      }
    },
    {
      "@id": "estleg:Reg_163032_Par_9_v163032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163032_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium asub Tallinnas. Nende ministeeriumi struktuuriüksuste postiaadressid, mis ei paikne ministeeriumi asukohas, tuuakse ära nende põhimäärustes. RT I 2017-07-05 19 105072017019 2017-08-01 Ministeerium asub Tallinnas. Nende ministeeriumi struktuuriüksuste postiaadressid, mis ei paikne ministeeriumi asukohas, tuuakse ära nende põhimäärustes.",
      "rdfs:label": {
        "@value": "Reg_163032_Par_9 (redaktsioon 163032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163032",
