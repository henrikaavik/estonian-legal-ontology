      }
    },
    {
      "@id": "estleg:MTKS_Par_28_v128122011012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTKS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
