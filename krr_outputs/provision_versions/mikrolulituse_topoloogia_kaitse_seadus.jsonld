      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MTKS_Par_7_v730998",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reprodutseerimine (ingl reproduction ) käesoleva seaduse tähenduses on mikrolülituse topoloogia mis tahes viisil kopeerimine, sealhulgas kopeerimine mikrolülituse valmistamiseks.",
      "rdfs:label": {
        "@value": "MTKS_Par_7 (redaktsioon 730998)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "730998",
      "estleg:supersededByVersion": {
