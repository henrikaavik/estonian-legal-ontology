    {
      "@id": "estleg:MTKS_Par_49_v106012023047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTKS_Par_49"
      },
      "estleg:versionValidFrom": {
