    {
      "@id": "estleg:MTKS_Par_51_v12791449",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTKS_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) –(2) Kehtetud – (3) Kui mikrolülituse topoloogia omaniku õigused lähevad üle teisele isikule käesoleva seaduse §-s 49 sätestatud juhtudel, lähevad üle ka litsentsist tulenevad õigused ja kohustused.",
      "rdfs:label": {
