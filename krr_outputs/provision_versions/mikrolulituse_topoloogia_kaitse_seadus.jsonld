        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui registreerimistaotlus on tagasi võetud või tagasivõetuks loetud, lõpetatakse registreerimistaotluse menetlus ja teatatakse sellest taotlejale. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "MTKS_Par_32 (redaktsioon 106012023047)",
        "@language": "et"
