    {
      "@id": "estleg:MTKS_Par_32_v106012023047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTKS_Par_32"
      },
      "estleg:versionValidFrom": {
