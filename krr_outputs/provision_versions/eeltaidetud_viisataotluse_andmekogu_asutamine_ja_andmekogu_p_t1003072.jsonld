      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1003072_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmeandja kannab andmed andmekogusse vastutava töötleja veebilehe kaudu. Andmeandja kannab andmed andmekogusse vastutava töötleja veebilehe kaudu. 2 (2) Andmekogusse esitatud andmete õigsuse eest vastutab andmeandja. Andmekogusse esitatud andmete õigsuse eest vastutab andmeandja.",
