    {
      "@id": "estleg:Reg_1003072_Par_5_v1003072",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1003072_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse andmeandjaks on viisataotleja. Andmekogusse andmeandjaks on viisataotleja. 2 (2) Andmekogusse kogutakse viisa taotlemisel nõutavad andmed. RT I 2017-04-18 2017 1 118042017001 2017-04-21 4 Andmekogusse kogutakse viisa taotlemisel nõutavad andmed.",
      "rdfs:label": {
        "@value": "Reg_1003072_Par_5 (redaktsioon 1003072)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003072",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1003072",
      "estleg:sourceAct": "Eeltäidetud viisataotluse andmekogu asutamine ja andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1003072 § 5",
