      "estleg:versionValidFrom": {
        "@value": "2019-07-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvi 1 lõike 1 punktides 11–13 nimetatud andmeid kogutakse statistilisel eesmärgil ning nende esitamine on kohustuslik, kui neid rahvastikuregistris ei ole, või kui kõrgeim omandatud haridustase on muutunud ja haridustaseme muudatust ei ole rahvastikuregistrisse kantud. RT I 2019-07-31 2 131072019002 2019-08-03 Paragrahvi 1 lõike 1 punktides 11–13 nimetatud andmeid kogutakse statistilisel eesmärgil ning nende esitamine on kohustuslik, kui neid rahvastikuregistris ei ole, või kui kõrgeim omandatud haridustase on muutunud ja haridustaseme muudatust ei ole rahvastikuregistrisse kantud.",
      "rdfs:label": {
        "@value": "Reg_344622_Par_2 (redaktsioon 344622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "344622",
