      "estleg:sourceAct": "Isikule uue eesnime, perekonnanime või isikunime andmise avalduses esitatavate andmete loetelu",
      "estleg:provisionRef": "Reg_344622 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_344622_Map"
      }
    },
    {
      "@id": "estleg:Reg_344622_Par_3_v344622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
