      "estleg:versionValidFrom": {
        "@value": "2019-07-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikule antud uuest eesnimest, perekonnanimest või isikunimest loobumisel ning endise eesnime, perekonnanime või isikunime taastamise taotlemisel esitatakse käesolevas määruses sätestatud andmed. Isikule antud uuest eesnimest, perekonnanimest või isikunimest loobumisel ning endise eesnime, perekonnanime või isikunime taastamise taotlemisel esitatakse käesolevas määruses sätestatud andmed.",
      "rdfs:label": {
        "@value": "Reg_344622_Par_3 (redaktsioon 344622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "344622",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/344622",
      "estleg:sourceAct": "Isikule uue eesnime, perekonnanime või isikunime andmise avalduses esitatavate andmete loetelu",
