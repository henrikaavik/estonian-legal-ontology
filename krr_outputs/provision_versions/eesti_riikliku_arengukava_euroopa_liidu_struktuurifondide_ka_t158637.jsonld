    },
    {
      "@id": "estleg:Reg_158637_Par_15_v158637",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158637_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja on kohustatud:11)vastama taotleja ja täistaotluse kohta esitatud küsimustele;22)võimaldama teostada taotleja ja täistaotluse nõuetele vastavuse kontrolli ning esitatud andmete tegelikkusele vastavuse kontrolli;33)esitama ettenähtud vormil, viisil ja tähtajaks nõutud informatsiooni;44)teavitama viivitamatult kirjalikult kõigis esitatud andmetes toimunud muudatustest või asjaoludest, mis mõjutavad või võivad mõjutada Sihtasutuse või taotleja poolt oma kohustuste täitmist;55)täitma teisi õigusaktides sätestatud kohustusi ja esitama Sihtasutusele informatsiooni, mis võib mõjutada täistaotluse kohta otsuse tegemist. Taotleja on kohustatud: vastama taotleja ja täistaotluse kohta esitatud küsimustele; võimaldama teostada taotleja ja täistaotluse nõuetele vastavuse kontrolli ning esitatud andmete tegelikkusele vastavuse kontrolli; esitama ettenähtud vormil, viisil ja tähtajaks nõutud informatsiooni; teavitama viivitamatult kirjalikult kõigis esitatud andmetes toimunud muudatustest või asjaoludest, mis mõjutavad või võivad mõjutada Sihtasutuse või taotleja poolt oma kohustuste täitmist; täitma teisi õigusaktides sätestatud kohustusi ja esitama Sihtasutusele informatsiooni, mis võib mõjutada täistaotluse kohta otsuse tegemist.",
      "rdfs:label": {
        "@value": "Reg_158637_Par_15 (redaktsioon 158637)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158637",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158637",
      "estleg:sourceAct": "«Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks - ühtse programmdokumendi aastateks 2004-2006» meetme 2.4 «Turismi arendamine\" osa \"Keskvalitsuse turismiinvesteeringu projektid\" tingimused ning toetuse kasutamise kava koostamise kord",
      "estleg:provisionRef": "Reg_158637 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158637_Map_2026"
