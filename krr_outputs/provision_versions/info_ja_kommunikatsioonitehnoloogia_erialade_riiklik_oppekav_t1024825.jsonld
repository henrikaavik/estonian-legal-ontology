      "estleg:provisionRef": "Reg_1024825 § 15_21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024825_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024825_Par_15_22_v1024825",
