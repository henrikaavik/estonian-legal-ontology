      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Elektroonilisel kujul säilitatavate dokumentide loetava kujuga elektrooniliseks andmestikuks teisendamise nõuded (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Elektroonilisel kujul säilitatavate dokumentide loetava kujuga elektrooniliseks andmestikuks teisendamise nõuded"
    },
    {
      "@id": "estleg:Reg_1000146_Par_1_v1000146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000146_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus sätestab nõuded elektroonilisel kujul säilitatavate dokumentide loetava kujuga elektrooniliseks andmestikuks (edaspidi andmestik) teisendamisele. Käesolev määrus sätestab nõuded elektroonilisel kujul säilitatavate dokumentide loetava kujuga elektrooniliseks andmestikuks (edaspidi andmestik) teisendamisele.",
      "rdfs:label": {
        "@value": "Reg_1000146_Par_1 (redaktsioon 1000146)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000146",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000146",
      "estleg:sourceAct": "Elektroonilisel kujul säilitatavate dokumentide loetava kujuga elektrooniliseks andmestikuks teisendamise nõuded",
      "estleg:provisionRef": "Reg_1000146 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000146_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1000146_Par_2_v1000146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000146_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmestik loetakse nõuetele vastavaks ka juhul, kui maksukohustuslane esitab andmestiku kujul, mis põhilises osas vastab käesolevas määruses sätestatud nõuetele, ning maksuhaldur seda aktsepteerib. Andmestik loetakse nõuetele vastavaks ka juhul, kui maksukohustuslane esitab andmestiku kujul, mis põhilises osas vastab käesolevas määruses sätestatud nõuetele, ning maksuhaldur seda aktsepteerib.",
      "rdfs:label": {
        "@value": "Reg_1000146_Par_2 (redaktsioon 1000146)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000146",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000146",
      "estleg:sourceAct": "Elektroonilisel kujul säilitatavate dokumentide loetava kujuga elektrooniliseks andmestikuks teisendamise nõuded",
      "estleg:provisionRef": "Reg_1000146 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000146_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1000146_Par_3_v1000146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000146_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksukohustuslane edastab andmestiku kas: 1 1) eraldajaga tekstifailis (.del, .csv, .txt); 2 2) raportfailis (.prn, .txt); 3 3) või mõnes muus maksuhalduriga kooskõlastatud failiformaadis. Maksukohustuslane edastab andmestiku kas: eraldajaga tekstifailis (.del, .csv, .txt); raportfailis (.prn, .txt); või mõnes muus maksuhalduriga kooskõlastatud failiformaadis.",
      "rdfs:label": {
        "@value": "Reg_1000146_Par_3 (redaktsioon 1000146)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000146",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000146",
      "estleg:sourceAct": "Elektroonilisel kujul säilitatavate dokumentide loetava kujuga elektrooniliseks andmestikuks teisendamise nõuded",
      "estleg:provisionRef": "Reg_1000146 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000146_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1000146_Par_4_v1000146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000146_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmestiku metainfo peab sisaldama järgmist teavet: 1 1) faili sisu (faili nime või selgitusena); 2 2) tehinguridade arv failis; 3 3) tehingu kohta käivate väljade pealkirjad ja sisu selgitused; 4 4) raportfaili puhul iga välja alguspositsioon ja pikkus. Andmestiku metainfo peab sisaldama järgmist teavet: faili sisu (faili nime või selgitusena); tehinguridade arv failis; tehingu kohta käivate väljade pealkirjad ja sisu selgitused; raportfaili puhul iga välja alguspositsioon ja pikkus.",
      "rdfs:label": {
        "@value": "Reg_1000146_Par_4 (redaktsioon 1000146)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000146",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000146",
      "estleg:sourceAct": "Elektroonilisel kujul säilitatavate dokumentide loetava kujuga elektrooniliseks andmestikuks teisendamise nõuded",
      "estleg:provisionRef": "Reg_1000146 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000146_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1000146_Par_5_v1000146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000146_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maksuhaldurile edastatava andmefaili iga tehingu kohta käiv kanne peab kajastuma eraldi real. Kirje või välja väärtuse puudumine tehingut kirjeldavas reas ei tohi põhjustada nihkeid faili või tabeli struktuuris. Maksuhaldurile edastatava andmefaili iga tehingu kohta käiv kanne peab kajastuma eraldi real. Kirje või välja väärtuse puudumine tehingut kirjeldavas reas ei tohi põhjustada nihkeid faili või tabeli struktuuris. 2 (2) Nõuded maksualaste kirjete andmestiku väljade paigutusele on sätestatud käesoleva määruse lisas 1. Nõuded maksualaste kirjete andmestiku väljade paigutusele on sätestatud käesoleva määruse lisas 1. 3 (3) Nõuded tollialaste kirjete andmestiku väljade paigutusele on sätestatud käesoleva määruse lisas 2. Nõuded tollialaste kirjete andmestiku väljade paigutusele on sätestatud käesoleva määruse lisas 2.",
      "rdfs:label": {
        "@value": "Reg_1000146_Par_5 (redaktsioon 1000146)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000146",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000146",
      "estleg:sourceAct": "Elektroonilisel kujul säilitatavate dokumentide loetava kujuga elektrooniliseks andmestikuks teisendamise nõuded",
      "estleg:provisionRef": "Reg_1000146 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000146_Map_2026"
      }
    },
