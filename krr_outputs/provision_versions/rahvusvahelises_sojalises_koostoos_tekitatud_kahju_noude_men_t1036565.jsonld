      "dc:source": "Rahvusvahelises sõjalises koostöös tekitatud kahju nõude menetlemise, kahju hüvitamise ning hüvitisest loobumise kord"
    },
    {
      "@id": "estleg:Reg_1036565_Par_1_v1036565",
      "@type": [
        "owl:NamedIndividual",
