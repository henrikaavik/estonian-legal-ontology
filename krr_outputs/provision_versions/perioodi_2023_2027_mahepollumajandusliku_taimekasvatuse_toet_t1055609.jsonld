      "estleg:versionValidFrom": {
        "@value": "2026-01-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) 2023. aastal algab § 13 lõikes 1 sätestatud ajavahemik hiljemalt 22. mail. RT I 2023-04-18 1 118042023001 2023-04-21 2023. aastal algab § 13 lõikes 1 sätestatud ajavahemik hiljemalt 22. mail. 2 (2) 2024. aastal algab § 13 lõikes 1 sätestatud ajavahemik hiljemalt 20. mail. RT I 2024-04-24 1 124042024001 2024-04-27 2024. aastal algab § 13 lõikes 1 sätestatud ajavahemik hiljemalt 20. mail.",
      "rdfs:label": {
        "@value": "Reg_1055609_Par_18_19 (redaktsioon 1055609)",
        "@language": "et"
      },
