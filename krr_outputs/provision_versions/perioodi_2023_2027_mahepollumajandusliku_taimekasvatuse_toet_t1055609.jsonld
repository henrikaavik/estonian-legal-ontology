      "estleg:versionText": "[Käesolevast tekstist välja jäetud].",
      "rdfs:label": {
        "@value": "Reg_1055609_Par_19 (redaktsioon 1055609)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055609",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055609",
      "estleg:sourceAct": "Perioodi 2023–2027 mahepõllumajandusliku taimekasvatuse toetus ja mahepõllumajandusliku loomakasvatuse toetus",
