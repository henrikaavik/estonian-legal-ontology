        "@type": "xsd:date"
      },
      "estleg:versionText": "Suublasse juhitava heite piirväärtustele vastavuse hindamise kriteeriumid kehtestab määrusega.",
      "rdfs:label": {
        "@value": "THS_Par_103 (redaktsioon 123032015140)",
