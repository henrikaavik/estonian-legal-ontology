      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Rapla maakonnas Kehtna vallas Saunakülas ning Rapla vallas Kaigepere, Lipa, Lipametsa ja Raela külas ja Raikkülas. Kaitseala asub Rapla maakonnas Kehtna vallas Saunakülas ning Rapla vallas Kaigepere, Lipa, Lipametsa ja Raela külas ja Raikkülas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1053711_Par_2 (redaktsioon 1053711)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053711",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053711",
      "estleg:sourceAct": "Raikküla-Paka maastikukaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053711 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053711_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053711_Par_20_v1053711",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053711_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1053711_Par_20 (redaktsioon 1053711)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053711",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053711",
      "estleg:sourceAct": "Raikküla-Paka maastikukaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053711 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053711_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053711_Par_3_v1053711",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053711_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1053711_Par_3 (redaktsioon 1053711)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053711",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053711",
      "estleg:sourceAct": "Raikküla-Paka maastikukaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053711 § 3",
