      }
    },
    {
      "@id": "estleg:Reg_1053711_Par_19_19_v1053711",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053711_Par_19_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 16. juuni 2020. a käskkirjaga nr 1-2/20/269 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 16. juuni 2020. a käskkirjaga nr 1-2/20/269 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1053711_Par_19_19 (redaktsioon 1053711)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053711",
