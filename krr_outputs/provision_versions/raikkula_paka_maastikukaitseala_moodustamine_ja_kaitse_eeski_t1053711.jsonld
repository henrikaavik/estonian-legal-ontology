      "estleg:sourceAct": "Raikküla-Paka maastikukaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1053711 § 19_19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053711_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053711_Par_2_v1053711",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
