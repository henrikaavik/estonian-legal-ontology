      "estleg:versionValidFrom": {
        "@value": "2023-11-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andmise eesmärk on parandada tunnustatud tootjaorganisatsiooni ja tunnustatud tootjaorganisatsioonide liidu juhtimisvõimekust ning seeläbi tagada nende jätkusuutlik areng. Toetuse andmise eesmärk on parandada tunnustatud tootjaorganisatsiooni ja tunnustatud tootjaorganisatsioonide liidu juhtimisvõimekust ning seeläbi tagada nende jätkusuutlik areng.",
      "rdfs:label": {
        "@value": "Reg_1057702_Par_2 (redaktsioon 1057702)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057702",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057702",
      "estleg:sourceAct": "Perioodi 2023–2027 tunnustatud tootjaorganisatsiooni ja tunnustatud tootjaorganisatsioonide liidu arendamise toetus",
      "estleg:provisionRef": "Reg_1057702 § 2",
