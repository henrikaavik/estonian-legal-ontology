      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032014030",
      "estleg:sourceAct": "Perioodi 2007–2013 struktuuritoetuse seadus",
      "estleg:provisionRef": "STS2007_2013 § 24",
