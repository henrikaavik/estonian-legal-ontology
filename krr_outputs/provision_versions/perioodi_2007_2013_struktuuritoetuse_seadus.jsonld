      "estleg:provisionRef": "STS2007_2013 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:STS2007_2013_Map_2026"
      }
    },
    {
      "@id": "estleg:STS2007_2013_Par_24_v115032014030",
