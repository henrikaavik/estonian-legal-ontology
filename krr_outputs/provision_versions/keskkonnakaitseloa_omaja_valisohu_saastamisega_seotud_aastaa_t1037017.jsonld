      "estleg:provisionRef": "Reg_1037017 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037017_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037017_Par_3_v1037017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037017_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aruannete koostamiseks vajalike andmete kogumisel kasutab heiteallika käitaja kogu olemasolevat teavet, mis sisaldab arvutusi, eksperthinnanguid, mõõtmistulemusi, andmeid eriheidete, materiaalse bilansi ja kaudse seire kohta ning arvutusi, mis on kooskõlas riigisiseste või rahvusvaheliselt heaks kiidetud meetoditega. Aruannete koostamiseks vajalike andmete kogumisel kasutab heiteallika käitaja kogu olemasolevat teavet, mis sisaldab arvutusi, eksperthinnanguid, mõõtmistulemusi, andmeid eriheidete, materiaalse bilansi ja kaudse seire kohta ning arvutusi, mis on kooskõlas riigisiseste või rahvusvaheliselt heaks kiidetud meetoditega. 2 (2) Kehtetu - RT I 2020-01-31 1 131012020001 2020-02-03 Kehtetu - 3 (3) Heiteallika käitaja säilitab dokumentatsiooni andmetega, millest lähtudes aruanded koostati, kättesaadavana viis aastat asjaomase aruandeaasta lõpust arvates. Heiteallika käitaja säilitab dokumentatsiooni andmetega, millest lähtudes aruanded koostati, kättesaadavana viis aastat asjaomase aruandeaasta lõpust arvates.",
      "rdfs:label": {
        "@value": "Reg_1037017_Par_3 (redaktsioon 1037017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037017",
