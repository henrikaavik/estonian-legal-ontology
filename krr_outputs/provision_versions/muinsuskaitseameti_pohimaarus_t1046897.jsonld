      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046897",
      "estleg:sourceAct": "Muinsuskaitseameti põhimäärus",
      "estleg:provisionRef": "Reg_1046897 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046897_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046897_Par_9_v1046897",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046897_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ameti struktuuriüksuste juhid on ameti osakondade juhid (edaspidi üksuse juht). Ameti struktuuriüksuste juhid on ameti osakondade juhid (edaspidi üksuse juht). 2 (2) Üksuse juhi nimetab ametisse ja vabastab ametist peadirektor. Üksuse juhi nimetab ametisse ja vabastab ametist peadirektor. 3 (3) Üksuse juht allub vahetult peadirektorile. Üksuse juht allub vahetult peadirektorile. 4 (4) Üksuse juht juhib ja esindab üksust oma vastutusalas ametis, tagab üksuse eesmärkide saavutamise ja ülesannete täitmise ning annab peadirektorile üksuse tegevusest aru. Üksuse juht juhib ja esindab üksust oma vastutusalas ametis, tagab üksuse eesmärkide saavutamise ja ülesannete täitmise ning annab peadirektorile üksuse tegevusest aru.",
      "rdfs:label": {
        "@value": "Reg_1046897_Par_9 (redaktsioon 1046897)",
        "@language": "et"
      },
