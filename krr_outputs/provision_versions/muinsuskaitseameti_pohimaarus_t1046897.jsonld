      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametit juhib peadirektor, kelle nimetab ja vabastab ametist minister Kultuuriministeeriumi kantsleri ettepanekul. Ametit juhib peadirektor, kelle nimetab ja vabastab ametist minister Kultuuriministeeriumi kantsleri ettepanekul.",
      "rdfs:label": {
        "@value": "Reg_1046897_Par_7 (redaktsioon 1046897)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046897",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046897",
      "estleg:sourceAct": "Muinsuskaitseameti põhimäärus",
