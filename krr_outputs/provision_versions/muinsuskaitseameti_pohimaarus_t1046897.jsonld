        "@value": "2022-01-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti nimetus inglise keeles on Estonian National Heritage Board. Ameti nimetus inglise keeles on Estonian National Heritage Board.",
      "rdfs:label": {
        "@value": "Reg_1046897_Par_4 (redaktsioon 1046897)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046897",
