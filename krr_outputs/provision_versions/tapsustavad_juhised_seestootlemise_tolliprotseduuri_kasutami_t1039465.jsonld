      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seestöötlemise korral tekkinud teisesed töödeldud tooted, millel on kaubanduslik väärtus, suunatakse järgmisele tolliprotseduurile või reeksporditakse. Seestöötlemise korral tekkinud teisesed töödeldud tooted, millel on kaubanduslik väärtus, suunatakse järgmisele tolliprotseduurile või reeksporditakse.",
      "rdfs:label": {
