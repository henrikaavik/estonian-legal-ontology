        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust rakendatakse tagasiulatuvalt alates 2017. aasta 1. juulist. Määrust rakendatakse tagasiulatuvalt alates 2017. aasta 1. juulist.",
      "rdfs:label": {
        "@value": "Reg_1039465_Par_10 (redaktsioon 1039465)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039465",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039465",
      "estleg:sourceAct": "Täpsustavad juhised seestöötlemise tolliprotseduuri kasutamiseks",
