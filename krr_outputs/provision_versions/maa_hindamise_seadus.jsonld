      ],
      "estleg:versionOf": {
        "@id": "estleg:MHS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa korralise hindamise tulemuste vaidlustamisel halduskorras tuleb avalduse esitajal tasuda kautsjon. Põhjendatud taotluse korral kautsjon tagastatakse. (2) Maa korralise hindamisega seotud vaidluste halduskorras lahendamise korra ja kautsjoni suuruse . Kautsjoni suurus ei tohi ületada kahte protsenti vaidlusaluse maatüki maksustamishinnast.",
      "rdfs:label": {
        "@value": "MHS_Par_7 (redaktsioon 114012014004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114012014004",
      "estleg:supersededByVersion": {
        "@id": "estleg:MHS_Par_7_v129062018024"
      },
      "estleg:versionValidTo": {
        "@value": "2018-06-30",
        "@type": "xsd:date"
      }
    },
    {
