      }
    },
    {
      "@id": "estleg:MHS_Par_8_v108122021009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MHS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Erakorraline hindamine on hindamise objekti maksumuse kindlaksmääramine tehingu teostamiseks või muul eesmärgil. (2) Erakorralise hindamise korra, sealhulgas kasvava metsa hindamise metoodika, kehtestab määrusega. (3) [Kehtetu] (4) Erakorraline hindamine toimub tellija kulul. (5) Maakorralduse läbiviimisel kasutatakse alusena harilikku väärtust või suhtelist väärtust, kusjuures viimasel juhul kasutatakse võrdluse elementidena maa kvaliteeti ja asukohta. Muude maa väärtust oluliselt mõjutavate tegurite olemasolul võetakse need arvesse. Maakorralduse läbiviimisel maareformi käigus kasutatakse alusena maa maksustamishinda.",
      "rdfs:label": {
        "@value": "MHS_Par_8 (redaktsioon 108122021009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108122021009",
      "estleg:supersededByVersion": {
        "@id": "estleg:MHS_Par_8_v110032022029"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-14",
