        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse kohaselt läbi viidud maa korralise hindamise tulemuste alusel arvutab Maa-amet asjaõigusseaduse rakendamise seaduses sätestatud talumistasu määramiseks tehnovõrkudealuse maa maksustamishinna.",
      "rdfs:label": {
        "@value": "MHS_Par_6_2 (redaktsioon 129062018025)",
        "@language": "et"
      },
