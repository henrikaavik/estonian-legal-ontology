    {
      "@id": "estleg:Reg_158757_Par_5_v158757",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158757_Par_5"
