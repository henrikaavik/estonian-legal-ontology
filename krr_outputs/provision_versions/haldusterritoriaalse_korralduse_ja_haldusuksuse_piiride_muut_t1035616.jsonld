      }
    },
    {
      "@id": "estleg:Reg_1035616_Par_12_v1035616",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035616_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-03-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Küsitluskast avatakse pärast küsitluse lõppemist vähemalt kahe kolmandiku komisjoni liikmete juuresolekul. Küsitluskast avatakse pärast küsitluse lõppemist vähemalt kahe kolmandiku komisjoni liikmete juuresolekul. 2 (2) Paragrahvi 7 lõike 6 kohaselt kodus täidetud küsitluslehe esimesele leheküljele pannakse komisjoni pitsati jäljend ning küsitlusleht pannakse küsitluskohas täidetud küsitluslehtede hulka. Paragrahvi 7 lõike 6 kohaselt kodus täidetud küsitluslehe esimesele leheküljele pannakse komisjoni pitsati jäljend ning küsitlusleht pannakse küsitluskohas täidetud küsitluslehtede hulka.",
      "rdfs:label": {
        "@value": "Reg_1035616_Par_12 (redaktsioon 1035616)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035616",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035616",
      "estleg:sourceAct": "Haldusterritoriaalse korralduse ja haldusüksuse piiride muutmisega kaasneva elanike arvamuse väljaselgitamise ulatus ja kord",
      "estleg:provisionRef": "Reg_1035616 § 12",
