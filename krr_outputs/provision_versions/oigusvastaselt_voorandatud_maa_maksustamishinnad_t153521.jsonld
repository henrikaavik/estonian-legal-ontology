      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Õigusvastaselt võõrandatud maa maksustamishinnad (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Õigusvastaselt võõrandatud maa maksustamishinnad"
    },
    {
      "@id": "estleg:Reg_153521_Par_1_v153521",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153521_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigusvastaselt võõrandatud maa maksumus määratakse kindlaks juhul, kui «Maareformi seaduse» § 6 lõike 2 alusel maad kas osaliselt või tervikuna ei tagastata või kui maa tagastatakse «Maareformi seaduse» § 12 lõike 11 või § 14 lõike 5 alusel nõudeõigusest suuremas osas. Õigusvastaselt võõrandatud maa maksumuse määramisel kasutatakse lisades 1, 2 ja 3 toodud maksustamishindu, arvestamata maa maksustamishinda vähendavaid soodustusi. Õigusvastaselt võõrandatud maa maksumus määratakse kindlaks juhul, kui «Maareformi seaduse» § 6 lõike 2 alusel maad kas osaliselt või tervikuna ei tagastata või kui maa tagastatakse «Maareformi seaduse» § 12 lõike 11 või § 14 lõike 5 alusel nõudeõigusest suuremas osas. Õigusvastaselt võõrandatud maa maksumuse määramisel kasutatakse lisades 1, 2 ja 3 toodud maksustamishindu, arvestamata maa maksustamishinda vähendavaid soodustusi.",
      "rdfs:label": {
        "@value": "Reg_153521_Par_1 (redaktsioon 153521)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153521",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153521",
      "estleg:sourceAct": "Õigusvastaselt võõrandatud maa maksustamishinnad",
      "estleg:provisionRef": "Reg_153521 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153521_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153521_Par_2_v153521",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153521_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tiheasustusega alal paikneva õigusvastaselt võõrandatud maa maksumuse määramisel kasutatakse lisas 1 toodud tiheasustusega alade maa maksustamishindu. Tiheasustusega aladel, kus puuduvad hinnatsoonid, rakendatakse õigusvastaselt võõrandatud maa maksumuse määramisel baashinda. Tiheasustusega alal paikneva õigusvastaselt võõrandatud maa maksumuse määramisel kasutatakse lisas 1 toodud tiheasustusega alade maa maksustamishindu. Tiheasustusega aladel, kus puuduvad hinnatsoonid, rakendatakse õigusvastaselt võõrandatud maa maksumuse määramisel baashinda.",
      "rdfs:label": {
        "@value": "Reg_153521_Par_2 (redaktsioon 153521)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153521",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153521",
      "estleg:sourceAct": "Õigusvastaselt võõrandatud maa maksustamishinnad",
      "estleg:provisionRef": "Reg_153521 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153521_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153521_Par_3_v153521",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153521_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "«Maa hindamise seaduse» § 9 lõikes 6 sätestatud alustel maavanema poolt kuni 1. maini 2001. a kohaliku omavalitsuse volikogu ettepanekul kinnitatud kompaktse hoonestusega alal või määratud tiheasustusega alal paikneva õigusvastaselt võõrandatud maa maksumuse määramisel kasutatakse lisas 2 toodud valdade territooriumil asuvate tiheasustusega alade maksustamishindu. «Maa hindamise seaduse» § 9 lõikes 6 sätestatud alustel maavanema poolt kuni 1. maini 2001. a kohaliku omavalitsuse volikogu ettepanekul kinnitatud kompaktse hoonestusega alal või määratud tiheasustusega alal paikneva õigusvastaselt võõrandatud maa maksumuse määramisel kasutatakse lisas 2 toodud valdade territooriumil asuvate tiheasustusega alade maksustamishindu.",
      "rdfs:label": {
        "@value": "Reg_153521_Par_3 (redaktsioon 153521)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153521",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153521",
      "estleg:sourceAct": "Õigusvastaselt võõrandatud maa maksustamishinnad",
      "estleg:provisionRef": "Reg_153521 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153521_Map_2026"
      }
    },
    {
