      }
    },
    {
      "@id": "estleg:Reg_1034762_Par_2_v1034762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034762_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vestlus viiakse läbi kolmandate isikute, sealhulgas perekonnaliikmete juuresolekuta, välja arvatud juhul, kui taotlust menetlev ametiasutus peab nende viibimist vestlusel taotluse läbivaatamiseks vajalikuks. Vestlus viiakse läbi kolmandate isikute, sealhulgas perekonnaliikmete juuresolekuta, välja arvatud juhul, kui taotlust menetlev ametiasutus peab nende viibimist vestlusel taotluse läbivaatamiseks vajalikuks. 2 (2) Taotleja võib vestlusele kaasa võtta nõustaja ja esindaja, kuid nõustaja ja esindaja ei tohi vestlusesse sekkuda enne selle lõppu. Taotleja võib vestlusele kaasa võtta nõustaja ja esindaja, kuid nõustaja ja esindaja ei tohi vestlusesse sekkuda enne selle lõppu. 3 (3) Saatjata alaealise ja alaealise puhul viibib vestlusel alati tema esindaja ja nõustaja ning esindaja ja nõustaja võivad esitada küsimusi ja teha märkusi vestlust läbiviiva isiku nõusolekul. Saatjata alaealise ja alaealise puhul viibib vestlusel alati tema esindaja ja nõustaja ning esindaja ja nõustaja võivad esitada küsimusi ja teha märkusi vestlust läbiviiva isiku nõusolekul.",
      "rdfs:label": {
        "@value": "Reg_1034762_Par_2 (redaktsioon 1034762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034762",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034762",
      "estleg:sourceAct": "Rahvusvahelise kaitse taotlejaga vestluse läbiviimise kord",
      "estleg:provisionRef": "Reg_1034762 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1034762_Map"
      }
    },
    {
      "@id": "estleg:Reg_1034762_Par_3_v1034762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034762_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vestlusel on taotlejal võimalik oma taotlust igakülgselt põhjendada. Vestlusel on taotlejal võimalik oma taotlust igakülgselt põhjendada. 2 (2) Vestlust läbiviiv isik võtab arvesse taotlusega seotud isiklikke ja üldisi asjaolusid, sealhulgas taotleja kultuurilist tausta, sugu, seksuaalset ja soolist identiteeti ning välismaalasele rahvusvahelise kaitse andmise seaduse §-s 17 sätestatut. Vestlust läbiviiv isik võtab arvesse taotlusega seotud isiklikke ja üldisi asjaolusid, sealhulgas taotleja kultuurilist tausta, sugu, seksuaalset ja soolist identiteeti ning välismaalasele rahvusvahelise kaitse andmise seaduse §-s 17 sätestatut. 3 (3) Taotleja vastavasisulise taotluse korral viib vajaduse ja võimaluse korral taotlejaga vestluse läbi temaga samast soost isik. Vajadust hindab taotlust menetlev ametiasutus iga kord eraldi. Taotleja vastavasisulise taotluse korral viib vajaduse ja võimaluse korral taotlejaga vestluse läbi temaga samast soost isik. Vajadust hindab taotlust menetlev ametiasutus iga kord eraldi. 4 (4) Vestlust läbiviiv isik kaasab vestlusesse tõlgi, kes on võimeline tagama suhtlemise taotleja ja vestlust läbiviiva isiku vahel. Vajaduse ja võimaluse korral ning taotleja vastavasisulise taotluse korral valitakse tõlgiks taotlejaga samast soost isik. Vajadust hindab taotlust menetlev ametiasutus iga kord eraldi. Vestlust läbiviiv isik kaasab vestlusesse tõlgi, kes on võimeline tagama suhtlemise taotleja ja vestlust läbiviiva isiku vahel. Vajaduse ja võimaluse korral ning taotleja vastavasisulise taotluse korral valitakse tõlgiks taotlejaga samast soost isik. Vajadust hindab taotlust menetlev ametiasutus iga kord eraldi. 5 (5) Vestlust läbiviiv isik ei kanna vestlusel sõjaväe ega õiguskaitseorgani vormiriietust. Vestlust läbiviiv isik ei kanna vestlusel sõjaväe ega õiguskaitseorgani vormiriietust.",
      "rdfs:label": {
        "@value": "Reg_1034762_Par_3 (redaktsioon 1034762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034762",
