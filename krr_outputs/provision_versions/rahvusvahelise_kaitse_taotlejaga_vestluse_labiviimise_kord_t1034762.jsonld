      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Rahvusvahelise kaitse taotlejaga vestluse läbiviimise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Rahvusvahelise kaitse taotlejaga vestluse läbiviimise kord"
    },
    {
      "@id": "estleg:Reg_1034762_Par_1_v1034762",
      "@type": [
