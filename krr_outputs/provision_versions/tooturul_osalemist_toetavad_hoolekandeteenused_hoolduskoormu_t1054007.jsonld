      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054007_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotleja esitab toetuse saamiseks rakendusüksusele taotluse hiljemalt taotlemise väljakuulutamise teates nimetatud tähtpäeval e-toetuse keskkonna kaudu. Taotleja esitab toetuse saamiseks rakendusüksusele taotluse hiljemalt taotlemise väljakuulutamise teates nimetatud tähtpäeval e-toetuse keskkonna kaudu. 2 (2) Kui e-toetuse keskkonna töös esineb tehniline viga, mis takistab taotluse tähtaegset esitamist, loetakse taotluse esitamise tähtpäevaks järgmine tööpäev pärast vea likvideerimist. Kui e-toetuse keskkonna töös esineb tehniline viga, mis takistab taotluse tähtaegset esitamist, loetakse taotluse esitamise tähtpäevaks järgmine tööpäev pärast vea likvideerimist.",
      "rdfs:label": {
        "@value": "Reg_1054007_Par_14 (redaktsioon 1054007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054007",
