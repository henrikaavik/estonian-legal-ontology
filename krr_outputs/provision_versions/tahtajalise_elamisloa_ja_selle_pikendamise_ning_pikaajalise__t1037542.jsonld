      },
      "estleg:versionText": "Määrus jõustub 17. jaanuaril 2017. aastal. Määrus jõustub 17. jaanuaril 2017. aastal.",
      "rdfs:label": {
        "@value": "Reg_1037542_Par_56 (redaktsioon 1037542)",
        "@language": "et"
