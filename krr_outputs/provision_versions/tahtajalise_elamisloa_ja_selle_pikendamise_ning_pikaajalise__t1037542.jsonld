    {
      "@id": "estleg:Reg_1037542_Par_50_v1037542",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037542_Par_50"
