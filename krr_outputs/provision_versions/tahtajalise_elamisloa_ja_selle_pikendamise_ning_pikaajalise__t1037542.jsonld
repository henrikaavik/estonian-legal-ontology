    {
      "@id": "estleg:Reg_1037542_Par_39_v1037542",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037542_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalaste seaduse § 118 punkti 7 alusel antud tähtajalise elamisloa välislepingu alusel pikendamise taotlemisel esitatakse: 1 1) taotlus; 2 2) foto; 3 3) dokument taotleja legaalse sissetuleku kohta taotluse esitamisele vahetult eelnenud kuue kuu jooksul, millest nähtuvad vähemalt sissetuleku suurus, regulaarsus ja allikad. RT I 2025-04-25 5 125042025005 2026-01-01 Välismaalaste seaduse § 118 punkti 7 alusel antud tähtajalise elamisloa välislepingu alusel pikendamise taotlemisel esitatakse: taotlus; foto; dokument taotleja legaalse sissetuleku kohta taotluse esitamisele vahetult eelnenud kuue kuu jooksul, millest nähtuvad vähemalt sissetuleku suurus, regulaarsus ja allikad.",
      "rdfs:label": {
        "@value": "Reg_1037542_Par_39 (redaktsioon 1037542)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037542",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037542",
      "estleg:sourceAct": "Tähtajalise elamisloa ja selle pikendamise ning pikaajalise elaniku elamisloa ja selle taastamise taotlemise kord ning legaalse sissetuleku määrad",
      "estleg:provisionRef": "Reg_1037542 § 39",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037542_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1037542_Par_4_v1037542",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037542_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui taotlejalt ei ole terviseseisundi tõttu ajutiselt võimalik üheltki sõrmelt sõrmejälge võtta või taotleja püsiv terviseseisund ei võimalda sõrmejälgesid võtta, peab ta taotlusele lisama oma raviarsti väljastatud isikut tõendavate dokumentide seaduse alusel valdkonna eest vastutava ministri määrusega kehtestatud tõendi taotleja terviseseisundist tingitud sõrmejälgede võtmise võimatuse kohta. Eesti välisesinduses esitatud taotluse puhul võib taotleja lisada tõendi asemel välisriigi arsti tõendi. Ajutist sõrmejälgede võtmise võimatust tõendav tõend kehtib kuni kuus kuud ja püsivat sõrmejälgede võtmise võimatust tõendav tõend kuni viis aastat. Kui taotlejalt ei ole terviseseisundi tõttu ajutiselt võimalik üheltki sõrmelt sõrmejälge võtta või taotleja püsiv terviseseisund ei võimalda sõrmejälgesid võtta, peab ta taotlusele lisama oma raviarsti väljastatud isikut tõendavate dokumentide seaduse alusel valdkonna eest vastutava ministri määrusega kehtestatud tõendi taotleja terviseseisundist tingitud sõrmejälgede võtmise võimatuse kohta. Eesti välisesinduses esitatud taotluse puhul võib taotleja lisada tõendi asemel välisriigi arsti tõendi. Ajutist sõrmejälgede võtmise võimatust tõendav tõend kehtib kuni kuus kuud ja püsivat sõrmejälgede võtmise võimatust tõendav tõend kuni viis aastat. 2 (2) Kui taotlejalt ei saa ühelt või mõlemalt käelt sõrmejälge võtta sõrme esimese lüli puudumise tõttu, ei ole käesoleva paragrahvi lõikes 1 nimetatud tõendi lisamine vajalik. Sõrme esimese lüli puudumise tuvastab ametnik. Kui taotlejalt ei saa ühelt või mõlemalt käelt sõrmejälge võtta sõrme esimese lüli puudumise tõttu, ei ole käesoleva paragrahvi lõikes 1 nimetatud tõendi lisamine vajalik. Sõrme esimese lüli puudumise tuvastab ametnik.",
      "rdfs:label": {
        "@value": "Reg_1037542_Par_4 (redaktsioon 1037542)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037542",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037542",
      "estleg:sourceAct": "Tähtajalise elamisloa ja selle pikendamise ning pikaajalise elaniku elamisloa ja selle taastamise taotlemise kord ning legaalse sissetuleku määrad",
      "estleg:provisionRef": "Reg_1037542 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037542_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1037542_Par_40_v1037542",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037542_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Välismaalaste seaduse § 118 punkti 9 alusel püsivalt Eestis elamiseks antud tähtajalise elamisloa taotlemisel esitatakse: 1 1) taotlus; 2 2) foto; 3 3) dokument taotleja legaalse sissetuleku kohta taotluse esitamisele vahetult eelnenud kuue kuu jooksul, millest nähtuvad vähemalt sissetuleku suurus, regulaarsus ja allikad. RT I 2025-04-25 5 125042025005 2026-01-01 Välismaalaste seaduse § 118 punkti 9 alusel püsivalt Eestis elamiseks antud tähtajalise elamisloa taotlemisel esitatakse: taotlus; foto; dokument taotleja legaalse sissetuleku kohta taotluse esitamisele vahetult eelnenud kuue kuu jooksul, millest nähtuvad vähemalt sissetuleku suurus, regulaarsus ja allikad. 2 (2) Kui isikul, kes asus Eestisse elama enne 1990. aasta 1. juulit ja kes ei ole pärast nimetatud kuupäeva asunud elama teise riiki, puudub legaalne sissetulek, peab ta tõendama muid elatusvahendeid või esitama kirjaliku kinnituse elatusvahendite puudumise kohta. RT I 2025-04-25 5 125042025005 2026-01-01 Kui isikul, kes asus Eestisse elama enne 1990. aasta 1. juulit ja kes ei ole pärast nimetatud kuupäeva asunud elama teise riiki, puudub legaalne sissetulek, peab ta tõendama muid elatusvahendeid või esitama kirjaliku kinnituse elatusvahendite puudumise kohta.",
      "rdfs:label": {
        "@value": "Reg_1037542_Par_40 (redaktsioon 1037542)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037542",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037542",
      "estleg:sourceAct": "Tähtajalise elamisloa ja selle pikendamise ning pikaajalise elaniku elamisloa ja selle taastamise taotlemise kord ning legaalse sissetuleku määrad",
      "estleg:provisionRef": "Reg_1037542 § 40",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037542_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1037542_Par_41_v1037542",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037542_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1037542_Par_41 (redaktsioon 1037542)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037542",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037542",
      "estleg:sourceAct": "Tähtajalise elamisloa ja selle pikendamise ning pikaajalise elaniku elamisloa ja selle taastamise taotlemise kord ning legaalse sissetuleku määrad",
      "estleg:provisionRef": "Reg_1037542 § 41",
      "estleg:partOfAct": {
