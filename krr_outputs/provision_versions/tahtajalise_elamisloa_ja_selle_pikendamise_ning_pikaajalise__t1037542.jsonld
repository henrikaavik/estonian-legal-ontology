      "estleg:provisionRef": "Reg_1037542 § 43",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037542_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1037542_Par_44_v1037542",
      "@type": [
