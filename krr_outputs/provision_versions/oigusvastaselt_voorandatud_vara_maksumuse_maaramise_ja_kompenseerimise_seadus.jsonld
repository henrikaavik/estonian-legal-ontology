      }
    },
    {
      "@id": "estleg:OVVS_Par_6_v13337989",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OVVS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandusinventari võõrandamisaegset maksumust tõendavate dokumentide puudumisel määratakse maksumus põllumajandusinventari koosseisu, lehma arvestusliku hinna ja rahandusministri määratud koefitsientide alusel. Lehma arvestuslikuks hinnaks on viiskümmend 1940. aastal kehtinud Eesti krooni (Ekr). (2) Kui põllumajandusinventari koosseisu ei ole võimalik tõendada, loetakse põllumajandusinventari võõrandamisaegne maksumus võrdseks ühe lehma arvestusliku hinnaga talumaa iga nelja hektari kohta.",
      "rdfs:label": {
        "@value": "OVVS_Par_6 (redaktsioon 13337989)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13337989",
      "estleg:supersededByVersion": {
        "@id": "estleg:OVVS_Par_6_v127122013032"
