      "estleg:provisionRef": "Reg_1042913 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042913_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042913_Par_7_v1042913",
