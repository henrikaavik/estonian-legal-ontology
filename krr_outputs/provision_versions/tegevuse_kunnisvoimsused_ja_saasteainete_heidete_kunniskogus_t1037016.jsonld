      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tegevuse künnisvõimsused ja saasteainete heidete künniskogused, millest alates on käitise tegevuse jaoks nõutav õhusaasteluba (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tegevuse künnisvõimsused ja saasteainete heidete künniskogused, millest alates on käitise tegevuse jaoks nõutav õhusaasteluba"
    },
    {
      "@id": "estleg:Reg_1037016_Par_1_v1037016",
