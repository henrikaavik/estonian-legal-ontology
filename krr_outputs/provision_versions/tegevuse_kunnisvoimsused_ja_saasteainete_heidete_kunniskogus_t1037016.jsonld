      },
      "estleg:versionText": "Määrus sätestab saasteainete heidete künniskogused ja käitise tegevuse künnisvõimsused, millest alates on nõutav õhusaasteluba. Määrus sätestab saasteainete heidete künniskogused ja käitise tegevuse künnisvõimsused, millest alates on nõutav õhusaasteluba.",
      "rdfs:label": {
        "@value": "Reg_1037016_Par_1 (redaktsioon 1037016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037016",
