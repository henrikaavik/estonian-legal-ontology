      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050304_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetus makstakse ühes osas §-s 6 sätestatud ulatuses. Toetus makstakse ühes osas §-s 6 sätestatud ulatuses. 2 (2) PRIA teeb toetuse maksmise otsuse ja kannab toetusraha toetuse saaja arvelduskontole 35 tööpäeva jooksul arvates taotluse rahuldamise otsuse tegemisest. PRIA teeb toetuse maksmise otsuse ja kannab toetusraha toetuse saaja arvelduskontole 35 tööpäeva jooksul arvates taotluse rahuldamise otsuse tegemisest.",
      "rdfs:label": {
