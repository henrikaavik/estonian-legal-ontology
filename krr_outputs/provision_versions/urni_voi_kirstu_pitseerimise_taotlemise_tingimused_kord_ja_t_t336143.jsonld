      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336143_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Urni pitseerimiseks kleebitakse urni ja urni kaane ühenduskohale vähemalt 5 cm laiune paberlint, millele on lisatud vapipitsati jäljend. Urni pitseerimiseks kleebitakse urni ja urni kaane ühenduskohale vähemalt 5 cm laiune paberlint, millele on lisatud vapipitsati jäljend.",
      "rdfs:label": {
        "@value": "Reg_336143_Par_4 (redaktsioon 336143)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336143",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336143",
      "estleg:sourceAct": "Urni või kirstu pitseerimise taotlemise tingimused, kord ja tõendi vorm",
      "estleg:provisionRef": "Reg_336143 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336143_Map"
      }
    },
    {
      "@id": "estleg:Reg_336143_Par_5_v336143",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336143_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Tekstiilkattega kirstu pitseerimiseks ümbritsetakse kirstu peatsi- ja jalutsiosa vähemalt 5 cm laiuse paberlindiga, mis paigaldatakse läbi kandesangade. Paberlindi vabad otsad ühendatakse klammerdajaga või kokkukleepimise teel ning paberlindi ühenduskohale lisatakse vapipitsati jäljend. Tekstiilkattega kirstu pitseerimiseks ümbritsetakse kirstu peatsi- ja jalutsiosa vähemalt 5 cm laiuse paberlindiga, mis paigaldatakse läbi kandesangade. Paberlindi vabad otsad ühendatakse klammerdajaga või kokkukleepimise teel ning paberlindi ühenduskohale lisatakse vapipitsati jäljend. 2(2)Puitkattega või metallist kirstu pitseerimiseks kleebitakse kirstu ja kirstu kaane ühenduskohale kirstu peatsi- ja jalutsiosas vähemalt 5 cm laiune paberlint, millele on lisatud vapipitsati jäljend. Puitkattega või metallist kirstu pitseerimiseks kleebitakse kirstu ja kirstu kaane ühenduskohale kirstu peatsi- ja jalutsiosas vähemalt 5 cm laiune paberlint, millele on lisatud vapipitsati jäljend.",
      "rdfs:label": {
        "@value": "Reg_336143_Par_5 (redaktsioon 336143)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336143",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336143",
      "estleg:sourceAct": "Urni või kirstu pitseerimise taotlemise tingimused, kord ja tõendi vorm",
      "estleg:provisionRef": "Reg_336143 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336143_Map"
      }
    },
    {
      "@id": "estleg:Reg_336143_Par_6_v336143",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336143_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Määrusega kehtestatakse urni või kirstu pitseerimise tõendi vorm eesti ja inglise keeles (lisa). Tõendi võib väljastada ka eesti ja vene keeles, kui see on otstarbekas ning konsulaarametnik või aukonsul valdab piisavalt vene keelt. Määrusega kehtestatakse urni või kirstu pitseerimise tõendi vorm eesti ja inglise keeles (lisa). Tõendi võib väljastada ka eesti ja vene keeles, kui see on otstarbekas ning konsulaarametnik või aukonsul valdab piisavalt vene keelt. 2(2)Konsulaarametnik või aukonsul annab urni või kirstu pitseerimise tõendi kooskõlas «Konsulaarseaduse» §-ga 39. Konsulaarametnik või aukonsul annab urni või kirstu pitseerimise tõendi kooskõlas «Konsulaarseaduse» §-ga 39.",
      "rdfs:label": {
        "@value": "Reg_336143_Par_6 (redaktsioon 336143)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336143",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336143",
      "estleg:sourceAct": "Urni või kirstu pitseerimise taotlemise tingimused, kord ja tõendi vorm",
      "estleg:provisionRef": "Reg_336143 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336143_Map"
      }
    },
    {
      "@id": "estleg:Reg_336143_Par_7_v336143",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336143_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konsulaarametnik registreerib urni või kirstu pitseerimise tõendi andmise andmed konsulaarametniku ametitoimingute raamatus välisministri 8. juuni 2009. a määruse nr 5 «Konsulaarametniku ametitoimingute andmekogu asutamise ja pidamise korra» §-de 6 ja 8 kohaselt. Konsulaarametnik registreerib urni või kirstu pitseerimise tõendi andmise andmed konsulaarametniku ametitoimingute raamatus välisministri 8. juuni 2009. a määruse nr 5 «Konsulaarametniku ametitoimingute andmekogu asutamise ja pidamise korra» §-de 6 ja 8 kohaselt.",
      "rdfs:label": {
        "@value": "Reg_336143_Par_7 (redaktsioon 336143)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336143",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336143",
      "estleg:sourceAct": "Urni või kirstu pitseerimise taotlemise tingimused, kord ja tõendi vorm",
      "estleg:provisionRef": "Reg_336143 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336143_Map"
      }
    },
