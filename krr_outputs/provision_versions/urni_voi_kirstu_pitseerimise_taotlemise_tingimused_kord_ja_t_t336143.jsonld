      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336143_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konsulaarametnik või aukonsul pitseerib urni või kirstu (sh kirstu transpordikasti) ning väljastab tõendi, millega kinnitab urni või kirstu pitseerimist ja seal kõrvaliste esemete puudumist. Konsulaarametnik või aukonsul pitseerib urni või kirstu (sh kirstu transpordikasti) ning väljastab tõendi, millega kinnitab urni või kirstu pitseerimist ja seal kõrvaliste esemete puudumist.",
      "rdfs:label": {
        "@value": "Reg_336143_Par_1 (redaktsioon 336143)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336143",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336143",
      "estleg:sourceAct": "Urni või kirstu pitseerimise taotlemise tingimused, kord ja tõendi vorm",
      "estleg:provisionRef": "Reg_336143 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336143_Map"
      }
    },
    {
      "@id": "estleg:Reg_336143_Par_2_v336143",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336143_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Urni või kirstu pitseerimise taotleja (edaspidi taotleja) esitab konsulaarametnikule või aukonsulile urni või kirstu pitseerimise taotluse (edaspidi taotlus). Urni või kirstu pitseerimise taotleja (edaspidi taotleja) esitab konsulaarametnikule või aukonsulile urni või kirstu pitseerimise taotluse (edaspidi taotlus). 2(2)Taotlus tuleb esitada isiklikult. Taotlus tuleb esitada isiklikult. 3(3)Taotluses esitab taotleja järgmised andmed:11)ees- ja perekonnanimi;22)isikukood või sünniaeg;33)surnud isiku, kelle põrmuga urni või kirstu pitseerimist taotletakse, ees- ja perekonnanimi ning surmakuupäev;44)taotluse kuupäev. Taotluses esitab taotleja järgmised andmed: ees- ja perekonnanimi; isikukood või sünniaeg; surnud isiku, kelle põrmuga urni või kirstu pitseerimist taotletakse, ees- ja perekonnanimi ning surmakuupäev; taotluse kuupäev. 4(4)Taotlusele kirjutab taotleja oma käega alla, kinnitades taotluses esitatud andmete õigsust. Taotlusele kirjutab taotleja oma käega alla, kinnitades taotluses esitatud andmete õigsust. 5(5)Taotlusele lisatakse:11)taotleja isikut tõendava dokumendi isikuandmete lehekülje koopia;22)riigilõivu tasumist tõendav dokument;33)surmatunnistus;44)kremeerimist tõendav dokument, mille on andnud asukohariigi pädev asutus (urni pitseerimise taotlemisel). Taotlusele lisatakse: taotleja isikut tõendava dokumendi isikuandmete lehekülje koopia; riigilõivu tasumist tõendav dokument; surmatunnistus; kremeerimist tõendav dokument, mille on andnud asukohariigi pädev asutus (urni pitseerimise taotlemisel).",
      "rdfs:label": {
        "@value": "Reg_336143_Par_2 (redaktsioon 336143)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336143",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336143",
      "estleg:sourceAct": "Urni või kirstu pitseerimise taotlemise tingimused, kord ja tõendi vorm",
      "estleg:provisionRef": "Reg_336143 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336143_Map"
      }
    },
    {
      "@id": "estleg:Reg_336143_Par_3_v336143",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336143_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konsulaarametnik või aukonsul tuvastab enne urni või kirstu pitseerimist selles kõrvaliste esemete puudumise. Kõrvalisteks esemeteks ei loeta tavalisi matusemanuseid. Konsulaarametnik või aukonsul tuvastab enne urni või kirstu pitseerimist selles kõrvaliste esemete puudumise. Kõrvalisteks esemeteks ei loeta tavalisi matusemanuseid.",
      "rdfs:label": {
        "@value": "Reg_336143_Par_3 (redaktsioon 336143)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336143",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336143",
      "estleg:sourceAct": "Urni või kirstu pitseerimise taotlemise tingimused, kord ja tõendi vorm",
      "estleg:provisionRef": "Reg_336143 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336143_Map"
      }
    },
    {
      "@id": "estleg:Reg_336143_Par_4_v336143",
      "@type": [
        "owl:NamedIndividual",
