        "@value": "2024-03-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväekohustuslast teavitatakse identifitseerimiskoodi moodustamisest kaitseväekohustuslaste registri kaudu. Kaitseväekohustuslast teavitatakse identifitseerimiskoodi moodustamisest kaitseväekohustuslaste registri kaudu.",
      "rdfs:label": {
        "@value": "Reg_1058606_Par_4 (redaktsioon 1058606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058606",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058606",
      "estleg:sourceAct": "Kaitseväekohustuslasele antava identifitseerimiskoodi moodustamise ning kaitseväekohustuslase teavitamise alused ja kord",
      "estleg:provisionRef": "Reg_1058606 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058606_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058606_Par_5_v1058606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058606_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-03-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isikuplaadi väljastab Kaitseressursside Amet: 1 1) kutsealuse või kaitseväekohustuse võtta sooviva isiku ajateenistusse asumisel; 2 2) kaitseväekohustuslasele reservteenistusse kutsumisel või tegevteenistusse võtmisel, kui isikuplaati ei ole varem väljastatud; 3 3) kaitseväekohustust võtta soovivale isikule sõjaaja ametikohale nimetamisel või sõjaaja ametikohale tegevteenistusse võtmisel, kui isikuplaati ei ole varem väljastatud. Isikuplaadi väljastab Kaitseressursside Amet: kutsealuse või kaitseväekohustuse võtta sooviva isiku ajateenistusse asumisel; kaitseväekohustuslasele reservteenistusse kutsumisel või tegevteenistusse võtmisel, kui isikuplaati ei ole varem väljastatud; kaitseväekohustust võtta soovivale isikule sõjaaja ametikohale nimetamisel või sõjaaja ametikohale tegevteenistusse võtmisel, kui isikuplaati ei ole varem väljastatud. 2 (2) Isikuplaatidega varustamist, jaotamist ja arvestust korraldab Kaitseressursside Amet. Isikuplaatidega varustamist, jaotamist ja arvestust korraldab Kaitseressursside Amet. 3 (3) Isikuplaadi esmakordne väljastamine toimub tasuta. Isikuplaadi esmakordne väljastamine toimub tasuta.",
      "rdfs:label": {
        "@value": "Reg_1058606_Par_5 (redaktsioon 1058606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058606",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058606",
      "estleg:sourceAct": "Kaitseväekohustuslasele antava identifitseerimiskoodi moodustamise ning kaitseväekohustuslase teavitamise alused ja kord",
      "estleg:provisionRef": "Reg_1058606 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058606_Map"
      }
    },
