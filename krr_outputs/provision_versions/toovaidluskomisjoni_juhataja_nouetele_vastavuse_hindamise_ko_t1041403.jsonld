    {
      "@id": "estleg:Reg_1041403_Par_5_v1041403",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041403_Par_5"
