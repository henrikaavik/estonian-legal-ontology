      }
    },
    {
      "@id": "estleg:JäätS_Par_92_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne prügila tegevuse alustamist kontrollib loa andja prügila vastavust prügilaloa taotluses esitatud andmetele. Nimetatud kontroll ei vähenda käitaja vastutust.",
      "rdfs:label": {
        "@value": "JäätS_Par_92 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
