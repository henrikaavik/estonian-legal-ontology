    },
    {
      "@id": "estleg:JäätS_Par_136_26_v107012026016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_136_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 661 lõikes 1 nimetatud korraldatud jäätmeveo esmakordse rakendamise aastal on § 69 lõigete 21, 4 ja 41 alusel korraldatud jäätmeveoga liitumise kohustusest vabastatud jäätmevaldaja jäätmeveo teenustasu kuni üks euro ühes kalendrikuus. (2) Käesoleva seaduse § 668 lõikes 1 nimetatud jäätmeveo teenustasu esmakordse rakendamise aastal on jäätmevaldajale määratav tasu suurus kuni üks euro ühes kalendrikuus.",
      "rdfs:label": {
        "@value": "JäätS_Par_136_26 (redaktsioon 107012026016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107012026016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107012026016",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 136_26",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_136_27_v107012026016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_136_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 1199 lõikes 2 nimetatud sunniraha rakendatakse alates 2031. aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "JäätS_Par_136_27 (redaktsioon 107012026016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107012026016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107012026016",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 136_27",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_136_28_v118032026027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_136_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2026. aasta 31. detsembrini kohaldatakse ohtlike jäätmete saatekirjale käesoleva seaduse § 64 kuni 2026. aasta 16. jaanuarini kehtinud redaktsiooni.",
      "rdfs:label": {
        "@value": "JäätS_Par_136_28 (redaktsioon 118032026027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032026027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118032026027",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 136_28",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_136_29_v118032026034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_136_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse kuni 2030. aasta 31. detsembrini kehtiva redaktsiooni § 1 lõike 51 kohaselt korraldatud jäätmeveoga hõlmatud jäätmete taaskasutamise ja kõrvaldamise ning kohaliku omavalitsuse üksuse korraldusel kokku kogutud jäätmete taaskasutamise ja kõrvaldamise tellimise lepingute sõlmimisel tuleb arvestada, et need alates 2031. aasta 1. jaanuarist vastaksid käesoleva seaduse samal kuupäeval jõustunud nõuetele.",
      "rdfs:label": {
        "@value": "JäätS_Par_136_29 (redaktsioon 118032026034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032026034",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118032026034",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 136_29",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_136_3_v109112011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_136_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alates 2020. aasta 1. jaanuarist tuleb taaskasutada: kodumajapidamisest pärinevaid paberi-, metalli-, plasti- ja klaasijäätmeid ja muid liigiti kogutud kodumajapidamisest pärinevaid jäätmeid ning muudest allikatest pärinevaid samalaadseid jäätmeid, välja arvatud tootmisjäätmed ja põllumajanduslikust tootmisest või metsandusest pärinevad jäätmed, korduskasutuseks ettevalmistamisena ja ringlussevõtuna - vähemalt 50 protsendi ulatuses nende jäätmete kogumassist kalendriaastas; ehitus- ja lammutusjäätmeid korduskasutuseks ettevalmistamisena, ringlussevõtuna ja muu taaskasutamisena, sealhulgas jäätmete kasutamisena kaeveõõnte täitmiseks muude ainete asemel - vähemalt 70 protsendi ulatuses nende jäätmete kogumassist kalendriaastas.",
      "rdfs:label": {
        "@value": "JäätS_Par_136_3 (redaktsioon 109112011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011004",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_136_3_v130122011051"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011004",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 136_3",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_136_3_v130122011051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_136_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alates 2020. aasta 1. jaanuarist tuleb taaskasutada: kodumajapidamisest pärinevaid paberi-, metalli-, plasti- ja klaasijäätmeid ja muid liigiti kogutud kodumajapidamisest pärinevaid jäätmeid ning muudest allikatest pärinevaid samalaadseid jäätmeid, välja arvatud tootmisjäätmed ja põllumajanduslikust tootmisest või metsandusest pärinevad jäätmed, korduskasutuseks ettevalmistamisena ja ringlussevõtuna – vähemalt 50 protsendi ulatuses nende jäätmete kogumassist kalendriaastas; ehitus- ja lammutusjäätmeid korduskasutuseks ettevalmistamisena, ringlussevõtuna ja muu taaskasutamisena, sealhulgas jäätmete kasutamisena kaeveõõnte täitmiseks muude ainete asemel – vähemalt 70 protsendi ulatuses nende jäätmete kogumassist kalendriaastas.",
      "rdfs:label": {
        "@value": "JäätS_Par_136_3 (redaktsioon 130122011051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011051",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_136_3_v108072014015"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122011051",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 136_3",
      "estleg:partOfAct": {
