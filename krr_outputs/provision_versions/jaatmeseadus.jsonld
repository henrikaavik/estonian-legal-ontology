      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohtlike jäätmete käitluslitsentsi andmise, muutmise, peatamise ja tühistamise kord ning litsentsi taotlemiseks vajalike materjalide loetelu kehtestatakse Vabariigi Valitsuse määrusega.",
      "rdfs:label": {
