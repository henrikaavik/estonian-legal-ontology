      }
    },
    {
      "@id": "estleg:JäätS_Par_18_v22415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmevaldaja korraldab oma jäätmete taaskasutamise või lõpliku kõrvaldamise. (2) Kohalik omavalitsus korraldab oma haldusterritooriumil korraldatud olmejäätmeveoga hõlmatud jäätmete taaskasutamise või kõrvaldamise. Kohalik omavalitsus võib korraldada ka muude jäätmete taaskasutamist või kõrvaldamist.",
      "rdfs:label": {
        "@value": "JäätS_Par_18 (redaktsioon 22415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22415",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_18_v749804"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22415",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_18_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnahäiring käesoleva seaduse tähenduses on arvulise normiga reguleerimata negatiivne keskkonnamõju või negatiivne keskkonnamõju, mis ei ületa arvulist normi, nagu jäätmetest põhjustatud hais, tolm või müra; lindude, näriliste või putukate kogunemine; aerosoolide sisaldus õhus või jäätmete tuulega laialikandumine.",
      "rdfs:label": {
        "@value": "JäätS_Par_18 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_19_v22415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmevaldaja annab jäätmed käitlemiseks üle jäätmeluba omavale või jäätmeregistris registreeritud isikule. (2) Jäätmete üleandmisel käitlemiseks, mille puhul jäätmeluba ei vajata, peab jäätmeid üleandev isik veenduma, et vastuvõtjal on selleks tegevuseks piisavad tehnilised ja keskkonnakaitselised vahendid.",
      "rdfs:label": {
        "@value": "JäätS_Par_19 (redaktsioon 22415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22415",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_19_v749804"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22415",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_19_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmekäitluskoht on tehniliselt varustatud ehitis jäätmete kogumiseks, taaskasutamiseks või kõrvaldamiseks. (2) Jäätmekäitluskoht on ka maa-ala, kus jäätmete taaskasutamine võimaldab parendada mullaviljakust, maa-ala keskkonnaseisundit või selle kasutusvõimalusi. (3) Jäätmekäitluskohaks ei loeta jäätmekogumisnõu, -konteinerit või muud -mahutit, mis on ette nähtud olme- ja tavajäätmete esmakogumiseks jäätmetekitajatelt, samuti ehitisi, kuhu eelnimetatud mahutid on paigutatud, või ehitisi, mida kasutatakse olmes tekkinud pakendijäätmete esmakogumiseks. (4) Kui jäätmekäitluseks on vajalik jäätmeluba või registreerimine, võib jäätmeid taaskasutada või kõrvaldada ainult jäätmeloa või registreerimisega määratud kohas.",
      "rdfs:label": {
        "@value": "JäätS_Par_19 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_19_v918045"
      },
      "estleg:versionValidTo": {
        "@value": "2005-07-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_19_v918045",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
