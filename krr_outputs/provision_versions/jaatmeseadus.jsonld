      }
    },
    {
      "@id": "estleg:JäätS_Par_107_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metallijäätmete kokkuostul ja kokkuostetud metallijäätmete kaubandusvahendamisel tasutakse metallijäätmete eest ostja pangakontolt müüja pangakontole sularahata arveldamise korras. Sularahas arveldamine metallijäätmete kokkuostul ja edasisel vahendamisel on keelatud.",
      "rdfs:label": {
        "@value": "JäätS_Par_107 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 107",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_108_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmeid veetakse üle riigipiiri kooskõlas Eesti Vabariigi suhtes jõustunud välislepingutega ning EÜ Nõukogu määruses 259/93/EMÜ jäätmesaadetiste järelevalve ja kontrolli kohta Euroopa Ühenduses, ühendusse sisseveo ning ühendusest väljaveo korral (EÜT L 030, 06.02.1993, lk 1–28) sätestatud korras. (2) Ohtlikke jäätmeid ja välislepinguga reguleeritavaid jäätmeid võib Eesti Vabariiki sisse vedada, Eesti Vabariigist välja vedada või Eesti Vabariigi territooriumilt läbi vedada EÜ Nõukogu määruses 259/93/EMÜ sätestatud korras väljaantud jäätmete riikidevahelise veo loa (edaspidi veoluba) alusel.",
      "rdfs:label": {
        "@value": "JäätS_Par_108 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_108_v12801655"
      },
      "estleg:versionValidTo": {
        "@value": "2007-07-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 108",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_108_v12801655",
      "@type": [
        "owl:NamedIndividual",
