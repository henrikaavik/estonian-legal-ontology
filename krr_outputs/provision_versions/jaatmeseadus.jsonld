      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse § 81 lõikes 2 sätestatule määratakse korraldatud jäätmeveoloaga: piirkond, kust kohaliku omavalitsuse üksuse korraldatud jäätmeveoga hõlmatud jäätmed kokku kogutakse; jäätmekäitluskohad ja isikud, kuhu ja kellele jäätmed üle antakse, sealhulgas prügilad ja nende käitajad.",
      "rdfs:label": {
        "@value": "JäätS_Par_98 (redaktsioon 12799159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12799159",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_98_v121122019006"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
