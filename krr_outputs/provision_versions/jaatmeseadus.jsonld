      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnainspektsioon või kohus võib käesoleva seaduse §-des 120, 1201, 1203–1205, 122, 1245, 1262 ja 1265 sätestatud väärtegude toimepanemise vahendi või väärteo vahetuks objektiks olnud jäätmete või toodete suhtes kohaldada konfiskeerimist vastavalt karistusseadustiku §-le 83.",
