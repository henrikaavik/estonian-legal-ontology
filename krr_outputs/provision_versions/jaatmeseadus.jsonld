    {
      "@id": "estleg:JäätS_Par_94_v12801655",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse §-s 83 sätestatud alustele keeldub loa andja prügilaloa andmisest, kui: taotlejal puudub käesoleva seaduse § 91 punktis 5 nimetatud kindlustusleping või rahaline tagatis; taotlejal puudub maakasutusõigus; taotleja ei suuda täita käesoleva seaduse § 33 alusel kehtestatud nõudeid; käesoleva seaduse § 91 punktis 7 nimetatud andmed personali tehnilise ja kutsealase väljaõppe kohta ei kinnita prügila personali vajalikke oskusi tegutsemiseks taotluses märgitud tegevusalal.",
      "rdfs:label": {
