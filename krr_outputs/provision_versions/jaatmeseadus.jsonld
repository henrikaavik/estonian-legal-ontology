    },
    {
      "@id": "estleg:JäätS_Par_73_v1040598",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_73"
      },
      "estleg:versionValidFrom": {
