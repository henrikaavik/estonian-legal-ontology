    {
      "@id": "estleg:JäätS_Par_104_v113032014029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_104"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metallijäätmed on oma põhikoostiselt ehedatest mustmetallidest või värvilistest metallidest või nende sulamitest koosnevad jäätmed. Metallijäätmete täpsustatud nimistu kehtestatakse määrusega vastavuses käesoleva seaduse § 2 lõike 4 alusel koostatud jäätmenimistuga.",
      "rdfs:label": {
        "@value": "JäätS_Par_104 (redaktsioon 113032014029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014029",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 104",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
