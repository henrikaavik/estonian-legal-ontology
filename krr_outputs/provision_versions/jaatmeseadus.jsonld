      }
    },
    {
      "@id": "estleg:JäätS_Par_60_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ohtlike jäätmete segunemist või segamist omavahel või tavajäätmetega või mis tahes ainega tuleb vältida, välja arvatud käesoleva seaduse §-s 61 sätestatud juhul. (2) Segunenud jäätmed lahutatakse, kui see on tehniliselt teostatav ja sellega ei kaasne ülemääraseid kulutusi või kui see on vajalik tervisele või keskkonnale tekkida võiva ohu vältimiseks.",
      "rdfs:label": {
        "@value": "JäätS_Par_60 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
