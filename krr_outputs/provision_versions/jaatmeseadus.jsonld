      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaamet või kohus võib käesoleva seaduse §-des 120, 1201, 1203–1205, 122, 1245, 1262 ja 1265 sätestatud väärtegude toimepanemise vahendi või väärteo vahetuks objektiks olnud jäätmete või toodete suhtes kohaldada konfiskeerimist vastavalt karistusseadustiku §-le 83.",
      "rdfs:label": {
        "@value": "JäätS_Par_129_1 (redaktsioon 110122020007)",
        "@language": "et"
      },
