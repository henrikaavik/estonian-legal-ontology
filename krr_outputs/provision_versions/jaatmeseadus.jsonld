      }
    },
    {
      "@id": "estleg:JäätS_Par_81_v121122019006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Lisaks keskkonnaseadustiku üldosa seaduse § 53 lõikes 1 sätestatule märgitakse jäätmeloas: käideldavate jäätmete liigid ja kogused tonnides kalendriaasta jooksul; lubatud jäätmekäitlustoimingud ja nende kirjeldus; tegevuse kohta esitatavad tehnilised ja keskkonnanõuded; tegevuse alustamise ja lõpetamise aeg; käitlusvõimsused jäätmekäitluskohas või -kohtades jäätmekäitlustoimingute ja -tehnoloogiate kaupa tonnides kalendriaasta jooksul; jäätmekäitluskohas jäätmete ladustamise maksimaalne kogus tonnides ja kuupmeetrites, lähtudes käitluskoha tehnilistest ja ruumilistest võimalustest ning jäätmete ladustusviisist; jäätmete ladustamise korral jäätmete taaskasutamisele või kõrvaldamisele suunamise eeldatav aeg.",
      "rdfs:label": {
        "@value": "JäätS_Par_81 (redaktsioon 121122019006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122019006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122019006",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_82_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmeluba antakse kuni viieks aastaks. Jäätmeluba hakkab kehtima loa väljastamisele järgnevast päevast. (2) Jäätmekäitluskoha või jäätmetekkekoha, mida ei loeta jäätmekäitluskohaks, valduse üleandmisel on valdajal õigus jäätmeloaga seotud õigused ja kohustused uuele valdajale üle anda. Uus valdaja on kohustatud loale kantud käesoleva seaduse § 81 lõikes 1 nimetatud andmete muutmist taotlema kuue kuu jooksul jäätmekäitluskoha või jäätmetekkekoha, mida ei loeta jäätmekäitluskohaks, valduse üleandmisest arvates.",
      "rdfs:label": {
        "@value": "JäätS_Par_82 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_82_v12799159"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 82",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_82_v12799159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
