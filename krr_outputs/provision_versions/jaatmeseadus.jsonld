    {
      "@id": "estleg:JäätS_Par_10_1_v109112011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_10_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Edasimüüja käesoleva seaduse tähenduses on ettevõtja, kes tegutseb oma nimel jäätmeid ostes ja müües, sõltumata sellest, kas ta jäätmeid valdab või mitte.",
      "rdfs:label": {
        "@value": "JäätS_Par_10_1 (redaktsioon 109112011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011004",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 10_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_10_2_v109112011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_10_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahendaja käesoleva seaduse tähenduses on ettevõtja, kes korraldab teiste nimel jäätmete taaskasutamist või kõrvaldamist, sõltumata sellest, kas ta jäätmeid valdab või mitte.",
      "rdfs:label": {
        "@value": "JäätS_Par_10_2 (redaktsioon 109112011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011004",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 10_2",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_11_v22415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmevaldaja on kohustatud korraldama jäätmete üleandmise jäätmeluba omavale või jäätmeregistris registreeritud jäätmekäitlejale või taaskasutama või kõrvaldama jäätmed vastavalt käesoleva seaduse nõuetele. (2) Jäätmekäitlusega ei tohi kaasneda normatiive ületavat mõju tervisele ega keskkonnale. (3) Keskkonnaminister annab määrusi täiendavate nõuete kehtestamiseks teatud jäätmeliikide käitlemise kohta, kui: käitlemisest on tekkinud või võib tekkida oht tervisele ja keskkonnale; täiendavad nõuded on vajalikud Eesti Vabariigi suhtes jõustunud välislepingute täitmiseks.",
      "rdfs:label": {
        "@value": "JäätS_Par_11 (redaktsioon 22415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22415",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_11_v749804"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22415",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_11_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmehooldus on jäätmekäitlus, järelevalve jäätmekäitluse üle ja jäätmekäitluskohtade järelhooldus. (2) Jäätmehoolduse, välja arvatud jäätmekäitluse üle teostatava järelevalve kulud kannab jäätmevaldaja ning seadusega ettenähtud juhtudel isik, kelle valduses on käideldavad jäätmed olnud.",
      "rdfs:label": {
        "@value": "JäätS_Par_11 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_11_v12799159"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_11_v12799159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
