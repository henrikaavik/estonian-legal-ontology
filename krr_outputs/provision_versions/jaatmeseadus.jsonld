    {
      "@id": "estleg:JäätS_Par_37_v22415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ohtlike jäätmete käitluslitsents on tegevusluba, mis annab õiguse teiste isikute poolt tekitatud ja üleantud ohtlike jäätmete käitlemiseks teenustööna ning määrab selle õiguse realiseerimise tingimused. (2) Ohtlike jäätmete käitluslitsentsi annab keskkonnaminister.",
      "rdfs:label": {
        "@value": "JäätS_Par_37 (redaktsioon 22415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22415",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_37_v184825"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22415",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 37",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_37_v184825",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ohtlike jäätmete käitluslitsents on tegevusluba, mis annab õiguse teiste isikute poolt tekitatud ja üleantud ohtlike jäätmete käitlemiseks teenustööna ning määrab selle õiguse realiseerimise tingimused. (2) Ohtlike jäätmete käitluslitsentsi annab keskkonnaminister. (3) Ohtlike jäätmete käitluslitsentsi andmise menetlusele kohaldatakse avatud menetluse sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
