      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_5_1_v109112011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_5_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Biojäätmed on järgmised biolagunevad jäätmed: aia- ja haljastujäätmed; kodumajapidamises, jaemüügikohas ja toitlustusasutuses tekkinud toidu- ja köögijäätmed; toiduainetööstuses tekkinud jäätmed, mis on oma koostise ja olemuse poolest samalaadsed käesoleva paragrahvi punktis 2 nimetatud jäätmetega.",
      "rdfs:label": {
        "@value": "JäätS_Par_5_1 (redaktsioon 109112011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011004",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_5_1_v105052021003"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011004",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 5_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_5_1_v105052021003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_5_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Biojäätmed on järgmised biolagunevad jäätmed: aia- ja haljastujäätmed; kodumajapidamises, büroos, jaemüügikohas, hulgimüügiettevõttes ja toitlustusasutuses tekkinud toidu- ja köögijäätmed; toiduainetööstuses tekkinud jäätmed, mis on oma koostise ja olemuse poolest samalaadsed käesoleva paragrahvi punktis 2 nimetatud jäätmetega.",
      "rdfs:label": {
        "@value": "JäätS_Par_5_1 (redaktsioon 105052021003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105052021003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105052021003",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 5_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_5_2_v105052021003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_5_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toidujäätmed on Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 178/2002, millega sätestatakse toidualaste õigusnormide üldised põhimõtted ja nõuded, asutatakse Euroopa Toiduohutusamet ja kehtestatakse toidu ohutusega seotud menetlused (EÜT L 31, 01.02.2002, lk 1–24), artiklis 2 määratletud toit, mis on muutunud jäätmeteks.",
      "rdfs:label": {
        "@value": "JäätS_Par_5_2 (redaktsioon 105052021003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105052021003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105052021003",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 5_2",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_6_v22415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keelatud on toodete valmistamine, sisse- ja väljavedu, müük ning kasutamine, kui sealjuures tekkinud jäätmete käitlemisel pole võimalik täita käesoleva seaduse paragrahv 11 lõikes 2 kehtestatud nõudeid ja sellest on tekkinud või võib tekkida tervise- ja keskkonnaoht. Vabariigi Valitsus kehtestab määrusega ülalnimetatud toodete loetelu, samuti piirangud ja eritingimused toodete valmistamisel, sisse- ja väljaveol, müügil ning kasutamisel, kui see on vajalik Eesti Vabariigi suhtes jõustunud välislepingute täitmiseks. (2) Keskkonnaminister annab määrusi toodete märgistamise kohta nende keskkonnaohtlikkuse seisukohalt ja kehtestab kasutuselt kõrvaldatud toodete tagastamise korra, kui need jäätmetena võivad põhjustada tervise- või keskkonnaohtu. (3) Majandusminister määrab käesoleva paragrahvi lõikes 2 nimetatud toodetele pandi või tagatisraha, mis lisatakse toote hinnale ja kompenseeritakse tarbijale toote tagastamisel.",
      "rdfs:label": {
        "@value": "JäätS_Par_6 (redaktsioon 22415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22415",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_6_v184825"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22415",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_6_v184825",
