      }
    },
    {
      "@id": "estleg:JäätS_Par_41_v184825",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohtlike jäätmete käitluslitsentsi andmise, muutmise, peatamise ja kehtetuks tunnistamise kord ning litsentsi taotlemiseks vajalike materjalide loetelu kehtestatakse Vabariigi Valitsuse määrusega.",
