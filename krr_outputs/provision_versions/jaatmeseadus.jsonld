        "@id": "estleg:JäätS_Par_29_v109112011004"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13343117",
