      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 114_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_115_v749804",
