    {
      "@id": "estleg:JäätS_Par_98_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse § 81 lõikes 2 sätestatule määratakse korraldatud jäätmeveoloaga: piirkond, kust kohaliku omavalitsuse organi korraldatud jäätmeveoga hõlmatud jäätmed kokku kogutakse; jäätmekäitluskohad ja isikud, kuhu ja kellele jäätmed üle antakse, sealhulgas prügilad ja nende käitajad.",
      "rdfs:label": {
        "@value": "JäätS_Par_98 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
