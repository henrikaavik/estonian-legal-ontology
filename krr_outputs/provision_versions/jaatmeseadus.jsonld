      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_28_1_v105052021003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_28_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laeval on jäätmete põletamine keelatud. (2) Käesoleva seaduse § 31 lõigete 3 ja 4 kohaselt korduskasutuseks ettevalmistamiseks ja ringlussevõtuks liigiti kogutud jäätmeid on keelatud põletada, välja arvatud jäätmed, mis tekivad liigiti kogutud jäätmete töötlemisel ning mille puhul on põletamine § 221 lõike 1 kohaselt keskkonna jaoks parim lahendus.",
      "rdfs:label": {
        "@value": "JäätS_Par_28_1 (redaktsioon 105052021003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105052021003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105052021003",
      "estleg:sourceAct": "Jäätmeseadus",
