      },
      "estleg:versionValidTo": {
        "@value": "2021-05-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011004",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 13",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_13_v105052021003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmekäitlus on jäätmete kogumine, vedamine, taaskasutamine, sealhulgas sortimine, ja kõrvaldamine, sealhulgas vahendamine või edasimüümine.",
