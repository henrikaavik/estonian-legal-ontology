    {
      "@id": "estleg:JäätS_Par_101_1_v12799159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_101_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ohtlike jäätmete käitluslitsentsi muudetakse, kui: loa taotleja ärinimi, registrikood ja asukoht või nimi ja aadress on muutunud; jäätmekäitluse eest vastutav isik on muutunud; tegevuskoht on muutunud; litsentsis määratud nõuete aluseks olnud õigusnormid on muutunud ja avalik huvi litsentsi muutmiseks kaalub üles isiku usalduse; tegevus võib põhjustada olulise negatiivse keskkonnamõju. (2) Käesoleva paragrahvi lõike 1 punktide 1 ja 2 alusel algatatud litsentsi muutmise menetlusele ei kohaldata avatud menetluse sätteid.",
      "rdfs:label": {
        "@value": "JäätS_Par_101_1 (redaktsioon 12799159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12799159",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_101_1_v13341117"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12799159",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 101_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_101_1_v13341117",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_101_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ohtlike jäätmete käitluslitsentsi muudetakse, kui: loa taotleja ärinimi, registrikood ja asukoht või nimi ja aadress on muutunud; jäätmekäitluse eest vastutav isik on muutunud; tegevuskoht on muutunud; litsentsis määratud nõuete aluseks olnud õigusnormid on muutunud ja avalik huvi litsentsi muutmiseks kaalub üles isiku usalduse; tegevus võib põhjustada olulise negatiivse keskkonnamõju. (2) Käesoleva paragrahvi lõike 1 punktide 1 ja 2 alusel algatatud litsentsi muutmise menetlusele ei kohaldata avatud menetluse sätteid. (3) Ohtlike jäätmete käitluslitsentsi ei muudeta käesoleva paragrahvi lõike 1 punkti 3 alusel, kui käitlustegevuseks on saastunud maa-aladelt eemaldatud pinnase puhastamine tekkekohas ning see tegevus hõlmab jäätmekäitlustoiminguid ja jäätmekoguseid, mis on kantud käitluslitsentsile. Kui kõnealuse tegevuse juures rakendatakse samu käitlustehnoloogiaid ja -seadmeid, mis on juba kehtiva litsentsi andmisel heaks kiidetud, siis määratakse konkreetsed keskkonnanõuded muutunud või lisandunud tegevuskohas jäätmeloaga.",
      "rdfs:label": {
        "@value": "JäätS_Par_101_1 (redaktsioon 13341117)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13341117",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_101_1_v121122019006"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13341117",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 101_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
