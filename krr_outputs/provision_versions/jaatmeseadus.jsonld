      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmete sisse-, välja- ja läbiveo dokumentide vormid sisalduvad Euroopa Parlamendi ja Nõukogu määruse 1013/2006/EÜ lisades IA ja IB. (2) Kehtetu - (3) Pakendile, millele on Eestis kehtestatud tagatisraha, rakendatakse sisseveol Eesti Vabariiki Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1013/2006 artiklis 18 sätestatud üldnõudeid, kui jäätmesaadetise kogus ületab neli kilogrammi.",
      "rdfs:label": {
        "@value": "JäätS_Par_115 (redaktsioon 104042012005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104042012005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104042012005",
