    {
      "@id": "estleg:JäätS_Par_96_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_96"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse § 81 lõikes 2 sätestatule määratakse jäätmepõletusloaga: jäätmepõletustehase või koospõletustehase jäätmete põletamise aastane kogujõudlus; välisõhu ning reo- ja heitvee saasteainete sisalduse perioodilisel määramisel proovivõtu ja mõõtmise täpsustatud protseduurinõuded; põletatavate ohtlike jäätmete minimaalsed ja maksimaalsed massivood ajaühikus; ohtlike jäätmete minimaalne ja maksimaalne kütteväärtus; saasteainete, nagu polüklooritud bifenüülide (PCB), pentaklorofenooli (PCP), kloori, fluori, väävli, raskmetallide lubatud sisaldus jäätmetes.",
      "rdfs:label": {
        "@value": "JäätS_Par_96 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_96_v12799159"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 96",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_96_v12799159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_96"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse § 81 lõikes 2, välisõhu saasteloas ja vee erikasutusloas sätestatule määratakse jäätmepõletusloaga: jäätmepõletustehase või koospõletustehase jäätmete põletamise aastane kogujõudlus; välisõhu ning reo- ja heitvee saasteainete sisalduse perioodilisel määramisel proovivõtu ja mõõtmise täpsustatud protseduurinõuded; põletatavate ohtlike jäätmete minimaalsed ja maksimaalsed massivood ajaühikus; ohtlike jäätmete minimaalne ja maksimaalne kütteväärtus; saasteainete, nagu polüklooritud bifenüülide (PCB), pentaklorofenooli (PCP), kloori, fluori, väävli, raskmetallide lubatud sisaldus jäätmetes.",
      "rdfs:label": {
        "@value": "JäätS_Par_96 (redaktsioon 12799159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12799159",
      "estleg:supersededByVersion": {
