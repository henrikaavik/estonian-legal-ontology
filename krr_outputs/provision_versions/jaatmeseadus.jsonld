      }
    },
    {
      "@id": "estleg:JäätS_Par_26_1_v918045",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_26_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Probleemtooteregister on riiklik register andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155; 2000, 50, 317; 57, 373; 92, 597; 2001, 7, 17; 17, 77; 2002, 61, 375; 63, 387; 2003, 18, 107; 26, 158; 2004, 30, 204) tähenduses, kuhu koondatakse ning kus hoitakse ja töödeldakse Eestis toodetud, Eestisse sisseveetud ja Eestist väljaveetud probleemtoodete ja probleemtoodetest tekkinud jäätmete taaskasutamise andmeid. (3) Probleemtooteregistrisse kantavad andmed, nende esitamise kord, registrikaardi vormid ja rahvusvahelistest kohustustest tulenev andmete edastamise kord kehtestatakse probleemtooteregistri põhimääruses.",
      "rdfs:label": {
        "@value": "JäätS_Par_26_1 (redaktsioon 918045)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "918045",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_26_1_v12799159"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/918045",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 26_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_26_1_v12799159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_26_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Probleemtooteregister on riiklik register andmekogude seaduse tähenduses, kuhu koondatakse andmed probleemtoodete tootjate kohta ning kus hoitakse ja töödeldakse Eestis toodetud, Eestisse sisseveetud ja Eestist väljaveetud probleemtoodete ja probleemtoodetest tekkinud jäätmete taaskasutamise andmeid. (1¹) Tootjad on kohustatud end registreerima probleemtooteregistris ja esitama registrisse andmeid. (3) Probleemtooteregistrisse kantavad andmed, nende esitamise kord, registrikaardi vormid ja rahvusvahelistest kohustustest tulenev andmete edastamise kord kehtestatakse probleemtooteregistri põhimääruses. (4) probleemtoodetest tekkinud jäätmete täpsustatud nimistu vastavuses käesoleva seaduse § 2 lõike 4 alusel koostatud jäätmenimistuga, kui see on vajalik jäätmete täpsemaks määratlemiseks ja taaskasutamise andmete kandmiseks probleemtooteregistrisse.",
      "rdfs:label": {
        "@value": "JäätS_Par_26_1 (redaktsioon 12799159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12799159",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_26_1_v12894710"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12799159",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 26_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_26_1_v12894710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_26_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Probleemtooteregister on riiklik register avaliku teabe seaduse tähenduses, kuhu koondatakse andmed probleemtoodete tootjate kohta ning kus hoitakse ja töödeldakse Eestis toodetud, Eestisse sisseveetud ja Eestist väljaveetud probleemtoodete ja probleemtoodetest tekkinud jäätmete taaskasutamise andmeid. (1¹) Tootjad on kohustatud end registreerima probleemtooteregistris ja esitama registrisse andmeid. (3) Probleemtooteregistrisse kantavad andmed, nende esitamise kord, registrikaardi vormid ja rahvusvahelistest kohustustest tulenev andmete edastamise kord kehtestatakse probleemtooteregistri põhimääruses. (4) Keskkonnaministril on õigus oma määrusega kehtestada probleemtoodetest tekkinud jäätmete täpsustatud nimistu vastavuses käesoleva seaduse § 2 lõike 4 alusel koostatud jäätmenimistuga, kui see on vajalik jäätmete täpsemaks määratlemiseks ja taaskasutamise andmete kandmiseks probleemtooteregistrisse.",
      "rdfs:label": {
        "@value": "JäätS_Par_26_1 (redaktsioon 12894710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894710",
