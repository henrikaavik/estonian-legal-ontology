      "estleg:provisionRef": "JäätS § 35_3",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_35_3_v104012013034",
      "@type": [
