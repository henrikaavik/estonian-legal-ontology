      },
      "estleg:versionText": "Kohaliku omavalitsuse üksuse jäätmekava avaldatakse kohaliku omavalitsuse üksuse veebilehel.",
      "rdfs:label": {
        "@value": "JäätS_Par_59_1 (redaktsioon 108072014015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072014015",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072014015",
      "estleg:sourceAct": "Jäätmeseadus",
