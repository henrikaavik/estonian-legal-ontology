    {
      "@id": "estleg:JäätS_Par_87_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmeloa taotlemisel või muutmisel tasub taotleja riigilõivu riigilõivuseaduses (RT I 1997, 80, 1344; 2001, 55, 331; 53, 310; 56, 332; 64, 367; 65, 377; 85, 512; 88, 531; 91, 543; 93, 565; 2002, 1, 1; 18, 97; 23, 131; 24, 135; 27, 151 ja 153; 30, 178; 35, 214; 44, 281; 47, 297; 51, 316; 57, 358; 58, 361; 61, 375; 62, 377; 90, 519; 102, 599; 105, 610; 2003, 4, 20; 13, 68; 15, 84 ja 85; 20, 118; 21, 128; 23, 146; 25, 153 ja 154; 26, 156 ja 160; 30, õiend; 51, 352; 66, 449; 68, 461; 71, 471; 78, 527; 79, 530; 81, 545; 88, 589 ja 591; 2004, 2, 7) sätestatud korras.",
      "rdfs:label": {
        "@value": "JäätS_Par_87 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_87_v12766184"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 87",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_87_v12766184",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmeloa andmise või muutmise taotluse läbivaatamise eest tasutakse riigilõiv riigilõivuseaduses sätestatud määra järgi.",
      "rdfs:label": {
        "@value": "JäätS_Par_87 (redaktsioon 12766184)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12766184",
      "estleg:supersededByVersion": {
