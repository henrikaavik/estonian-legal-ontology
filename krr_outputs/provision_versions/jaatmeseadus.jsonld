      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse §-s 83 sätestatud alustele keeldub loa andja prügilaloa andmisest, kui: taotlejal puudub käesoleva seaduse § 91 punktis 5 nimetatud kindlustusleping või rahaline tagatis; taotlejal puudub maakasutusõigus; taotleja ei suuda täita käesoleva seaduse § 33 alusel kehtestatud nõudeid.",
      "rdfs:label": {
        "@value": "JäätS_Par_94 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
