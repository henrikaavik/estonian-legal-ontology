        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122024007",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 26_9",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_26_9_v107012026016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_26_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Probleemtoodete või probleemtoodetest eraldatud osade vastuvõtmine ja kokkuostmine jäätmetena on lubatud üksnes probleemtooteregistris registreeritud tootjal või tootjate ühendusel või keskkonnakaitseluba omaval isikul, kes täidab tootja laiendatud tootjavastutusega seotud kohustusi, sealhulgas käesoleva seaduse § 261 lõikes 18 sätestatud kohustust. (2) Probleemtoodetest eraldatud osade kokkuostmine jäätmetena on lubatud probleemtooteregistris registreeritud tootjalt või tootjate ühenduselt või ettevõtjalt, kelle õiguspärase tegevuse tulemusena on jäätmed tekkinud. (3) Käesoleva paragrahvi lõigetes 1 ja 2 sätestatud piirang ei kehti järelevalveasutuse või kohaliku omavalitsuse poolt järelevalve käigus omandatud probleemtoodetest tekkinud jäätmete müügi kohta.",
      "rdfs:label": {
        "@value": "JäätS_Par_26_9 (redaktsioon 107012026016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107012026016",
