    {
      "@id": "estleg:JäätS_Par_17_v109112011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmete kõrvaldamine on nende ladestamine prügilasse, põletamine ilma energiakasutuseta või muu samaväärne toiming, mis ei ole taaskasutamine, kaasa arvatud jäätmete ettevalmistamine kõrvaldamiseks, isegi kui toimingul on osaliselt teisene tagajärg ainete või energia taasväärtustamise näol. (2) Jäätmete kõrvaldamistoimingute nimistu",
      "rdfs:label": {
        "@value": "JäätS_Par_17 (redaktsioon 109112011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011004",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_17_v113032014029"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011004",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 17",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_17_v113032014029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmete kõrvaldamine on nende ladestamine prügilasse, põletamine ilma energiakasutuseta või muu samaväärne toiming, mis ei ole taaskasutamine, kaasa arvatud jäätmete ettevalmistamine kõrvaldamiseks, isegi kui toimingul on osaliselt teisene tagajärg ainete või energia taasväärtustamise näol. (2) Jäätmete kõrvaldamistoimingute nimistu kehtestatakse määrusega.",
      "rdfs:label": {
        "@value": "JäätS_Par_17 (redaktsioon 113032014029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014029",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 17",
      "estleg:partOfAct": {
