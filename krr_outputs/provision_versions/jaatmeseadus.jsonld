      "estleg:provisionRef": "JäätS § 67",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_67_v101072017008",
      "@type": [
        "owl:NamedIndividual",
