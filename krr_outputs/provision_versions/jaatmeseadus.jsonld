    {
      "@id": "estleg:JäätS_Par_134_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_134"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Prügilasse ladestatavate olmejäätmete hulgas ei tohi biolagunevaid jäätmeid olla: üle 45 massiprotsendi alates 2010. aasta 16. juulist; üle 30 massiprotsendi alates 2013. aasta 16. juulist; üle 20 massiprotsendi alates 2020. aasta 16. juulist.",
      "rdfs:label": {
        "@value": "JäätS_Par_134 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_134_v105052021003"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 134",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_134_v105052021003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_134"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Prügilasse ladestatavate olmejäätmete hulgas ei tohi biolagunevaid jäätmeid olla: üle 45 massiprotsendi alates 2010. aasta 16. juulist; üle 30 massiprotsendi alates 2013. aasta 16. juulist; üle 20 massiprotsendi alates 2020. aasta 16. juulist. (2) Alates 2030. aasta 1. jaanuarist on prügilasse keelatud ladestada ringlussevõtuks või muuks taaskasutamiseks sobivaid jäätmeid, eelkõige olmejäätmeid, välja arvatud jäätmed, mille ladestamine prügilas annab käesoleva seaduse § 221 lõike 1 kohaselt parima keskkonnaalase tulemuse. (3) Alates 2035. aasta 1. jaanuarist ei tohi prügilasse ladestatavate olmejäätmete kogus ületada 10 massiprotsenti samal aastal tekitatud olmejäätmete üldkogusest. (4) Käesoleva paragrahvi lõikes 3 sätestatud sihtarvu arvutamise korra kehtestab määrusega, arvestades nõukogu direktiivi 1999/31/EÜ prügilate kohta (EÜT L 182, 16.07.1999, lk 1–19) artiklis 5a sätestatut.",
      "rdfs:label": {
        "@value": "JäätS_Par_134 (redaktsioon 105052021003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105052021003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105052021003",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 134",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_135_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_135"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korraldatud jäätmevedu tuleb korraldada alates 2005. aasta 1. jaanuarist. (2) Kohaliku omavalitsuse üksusele, mille haldusterritooriumil elab vähem kui 1500 inimest, korraldatud jäätmeveo korraldamise kohustus käesoleva seaduse §-de 66–69 tähenduses ei laiene. (3) Jäätmevaldajaks käesoleva seaduse §-de 66–69 tähenduses loetakse ka suvila, elu- või äriruumina kasutatava ehitise või korteri kui vallasasja omanik.",
      "rdfs:label": {
        "@value": "JäätS_Par_135 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_135_v1040598"
      },
      "estleg:versionValidTo": {
        "@value": "2006-06-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 135",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
