      }
    },
    {
      "@id": "estleg:JäätS_Par_85_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmeloa andja tunnistab jäätmeloa kehtetuks sellest loa omajat eelnevalt informeerides, kui: loa omaja tegevuses tõendatakse käesoleva seaduse §-s 83 nimetatud asjaolud; loa omaja ei ole alustanud loas nimetatud tegevust 12 kuu jooksul loas märgitud tähtajast arvates ega ole esitanud taotlust tegevuse algusaja muutmiseks; loa omaja ei ole alustanud kohaliku omavalitsuse organi korraldatud jäätmevedu ühe nädala jooksul loas märgitud tähtajast arvates ega ole esitanud taotlust tegevuse algusaja muutmiseks; juriidilisest isikust loa omaja on lõppenud või füüsilisest isikust loa omaja on surnud; jäätmekäitluskoha või jäätmetekkekoha, mida ei loeta jäätmekäitluskohaks, valdaja ei ole täitnud käesoleva seaduse § 82 lõikes 2 sätestatud kohustust.",
      "rdfs:label": {
        "@value": "JäätS_Par_85 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_85_v1040598"
      },
      "estleg:versionValidTo": {
        "@value": "2006-06-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 85",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_85_v1040598",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmeloa andja tunnistab jäätmeloa kehtetuks sellest loa omajat eelnevalt informeerides, kui: loa omaja tegevuses tõendatakse käesoleva seaduse § -s 83 nimetatud asjaolud; loa omaja ei ole alustanud loas nimetatud tegevust 12 kuu jooksul loas märgitud tähtajast arvates ega ole esitanud taotlust tegevuse algusaja muutmiseks; loa omaja ei ole alustanud kohaliku omavalitsuse organi korraldatud jäätmevedu ühe nädala jooksul loas märgitud tähtajast arvates ega ole esitanud taotlust tegevuse algusaja muutmiseks; juriidilisest isikust loa omaja on lõppenud või füüsilisest isikust loa omaja on surnud; jäätmekäitluskoha või jäätmetekkekoha, mida ei loeta jäätmekäitluskohaks, valdaja ei ole täitnud käesoleva seaduse § 82 lõikes 2 sätestatud kohustust.",
      "rdfs:label": {
        "@value": "JäätS_Par_85 (redaktsioon 1040598)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040598",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_85_v12799159"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040598",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 85",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_85_v12799159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmeloa andja tunnistab jäätmeloa kehtetuks või peatab jäätmeloa kehtivuse sellest loa omajat eelnevalt informeerides, kui: loa omaja tegevuses tõendatakse käesoleva seaduse §-s 83 nimetatud asjaolud; loa omaja ei ole alustanud loas nimetatud tegevust 12 kuu jooksul loas märgitud tähtajast arvates ega ole esitanud taotlust tegevuse algusaja muutmiseks; loa omaja ei ole alustanud kohaliku omavalitsuse üksuse korraldatud jäätmevedu ühe nädala jooksul loas märgitud tähtajast arvates ega ole esitanud taotlust tegevuse algusaja muutmiseks; juriidilisest isikust loa omaja on lõpetatud; jäätmekäitluskoha või jäätmetekkekoha, mida ei loeta jäätmekäitluskohaks, valdaja ei ole täitnud käesoleva seaduse § 82 lõikes 2 sätestatud kohustust. (2) Füüsilisest isikust loa omaja surma korral tunnistab jäätmeloa andja jäätmeloa kehtetuks. Kui juriidilisest isikust loa omaja on lõpetatud, välja arvatud juriidilise isiku ümberkujundamisel või ühinemisel, tunnistab jäätmeloa andja jäätmeloa kehtetuks.",
      "rdfs:label": {
        "@value": "JäätS_Par_85 (redaktsioon 12799159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12799159",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_85_v13341117"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12799159",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 85",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_85_v13341117",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmeloa andja tunnistab jäätmeloa kehtetuks või peatab jäätmeloa kehtivuse sellest loa omajat eelnevalt informeerides, kui: loa omaja tegevuses tõendatakse käesoleva seaduse §-s 83 nimetatud asjaolud; loa omaja ei ole alustanud loas nimetatud tegevust 12 kuu jooksul loas märgitud tähtajast arvates ega ole esitanud taotlust tegevuse algusaja muutmiseks; loa omaja ei ole alustanud kohaliku omavalitsuse üksuse korraldatud jäätmevedu ühe nädala jooksul loas märgitud tähtajast arvates ega ole esitanud taotlust tegevuse algusaja muutmiseks; Kehtetu - jäätmekäitluskoha või jäätmetekkekoha, mida ei loeta jäätmekäitluskohaks, valdaja ei ole täitnud käesoleva seaduse § 82 lõikes 2 sätestatud kohustust. (2) Füüsilisest isikust loa omaja surma korral tunnistab jäätmeloa andja jäätmeloa kehtetuks. Kui juriidilisest isikust loa omaja on lõpetatud, välja arvatud juriidilise isiku ümberkujundamisel või ühinemisel, tunnistab jäätmeloa andja jäätmeloa kehtetuks.",
      "rdfs:label": {
        "@value": "JäätS_Par_85 (redaktsioon 13341117)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13341117",
