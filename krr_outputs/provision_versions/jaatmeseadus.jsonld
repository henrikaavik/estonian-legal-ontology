    {
      "@id": "estleg:JäätS_Par_95_v116052013003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_95"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaks käesoleva seaduse §-s 78 loetletud andmetele peab jäätmete põletamiseks jäätmeluba (edaspidi jäätmepõletusluba) taotlev isik esitama loa andjale: andmed jäätmete põletamisel või koospõletamisel tekkiva soojuse kasutamise kohta; andmed põletamisel tekkivate, taaskasutatavate, sealhulgas ringlusse võetavate, ja kõrvaldatavate jäätmete koguse ning jäätmete tekke vältimise ja vähendamise meetmete kohta. (2) Jäätmepõletusloa taotlusele lisatakse jäätmepõletus- või koospõletustehase tööd juhtiva füüsilise isiku pädevust tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "JäätS_Par_95 (redaktsioon 116052013003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116052013003",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_95_v121122019006"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116052013003",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 95",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
