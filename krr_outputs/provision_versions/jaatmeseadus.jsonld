      }
    },
    {
      "@id": "estleg:JäätS_Par_31_v22415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmeloaga määratakse: tekkivate ja käideldavate jäätmete liigid ja kogused, sealhulgas lubatud piirkogused, mida võib viia keskkonda; jäätmekäitluskohad; jäätmekäitlustoimingud; tehnilised ja keskkonnakaitsenõuded jäätmeloaga lubatud tegevuse korral; keskkonnaseirenõuded; tegevuse juures rakendatavad ohutusmeetmed. (2) Jäätmeloaga määratav ei tohi olla vastuolus jäätmeloaga antava õiguse olemusega.",
      "rdfs:label": {
        "@value": "JäätS_Par_31 (redaktsioon 22415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22415",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_31_v749804"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22415",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_31_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse organ korraldab jäätmete sortimist, sealhulgas liigiti kogumist, et võimaldada nende taaskasutamist võimalikult suures ulatuses.",
      "rdfs:label": {
        "@value": "JäätS_Par_31 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_31_v12799159"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_31_v12799159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohaliku omavalitsuse üksus korraldab jäätmete sortimist, sealhulgas liigiti kogumist, et võimaldada nende taaskasutamist võimalikult suures ulatuses. (2) Sortimisel eraldatakse taaskasutatavad jäätmed ning ohtlikud jäätmed ülejäänud jäätmetest, kui see on tehniliselt teostatav ja sellega ei kaasne ülemääraseid kulutusi.",
      "rdfs:label": {
        "@value": "JäätS_Par_31 (redaktsioon 12799159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12799159",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_31_v109112011004"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12799159",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_31_v109112011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohaliku omavalitsuse üksus korraldab jäätmete sortimist, sealhulgas liigiti kogumist, et võimaldada nende taaskasutamist võimalikult suures ulatuses. (2) Sortimisel eraldatakse taaskasutatavad jäätmed ning ohtlikud jäätmed ülejäänud jäätmetest, kui see on tehniliselt teostatav ja sellega ei kaasne ülemääraseid kulutusi. (3) Kui see on tehniliselt, keskkonna seisukohast ja majanduslikult teostatav, peab kohaliku omavalitsuse üksus korraldama vähemalt paberi-, papi-, metalli-, plasti- ning klaasijäätmete liigiti kogumise.",
      "rdfs:label": {
        "@value": "JäätS_Par_31 (redaktsioon 109112011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011004",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_31_v105052021003"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011004",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_31_v105052021003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohaliku omavalitsuse üksus korraldab jäätmete liigiti kogumist, et võimaldada nende korduskasutuseks ettevalmistamist, ringlussevõttu või muud taaskasutamist võimalikult suures ulatuses. (1¹) Käesoleva paragrahvi lõike 1 kohaselt korraldatud jäätmete liigiti kogumise eesmärk on muu hulgas käesoleva seaduse § 1363 lõigetes 1 ja 2 nimetatud olmejäätmete ringlussevõtu sihtarvude täitmine. (2) Kehtetu - (3) Kohaliku omavalitsuse üksus peab korraldama vähemalt paberi-, papi-, metalli-, plasti-, tekstiili- ja klaasijäätmete ning kodumajapidamises tekkivate ohtlike jäätmete liigiti kogumise. (4) Kohaliku omavalitsuse üksus peab korraldama biojäätmete liigiti kogumise tekkekohalt, kui neid ei ole võimalik tekkekohal ringlusse võtta. Biojäätmetega koos võib lubada tekkekohalt koguda samasuguste biolagunemis- ja kompostimisomadustega jäätmeid, mis vastavad kompostimise ja biolagunemise teel taaskasutatavate pakendite suhtes kohaldatavatele Euroopa või samaväärsetele riiklikele standarditele. (5) Kohaliku omavalitsuse üksus võib korraldada pakendijäätmete liigiti kogumise tekkekohalt kokkuleppel pakendiseaduse § 101 lõikes 1 nimetatud taaskasutusorganisatsiooniga, kellele tagatakse sellisel juhul osalemine pakendijäätmete taaskasutamise korraldamisel proportsionaalselt tema turuosaga. Pakendijäätmete tekkekohalt kogumine võib toimuda eri liiki pakendimaterjali koos kogumisena. (6) Kohaliku omavalitsuse üksus võib jäätmekavas ja jäätmehoolduseeskirjas ette näha erandi käesoleva paragrahvi lõigetes 3 ja 4 nimetatud liigiti kogumisest, kui on täidetud vähemalt üks järgmistest tingimustest: teatavat liiki jäätmete koos kogumine ei vähenda võimalusi neid korduskasutuseks ette valmistada, ringlusse võtta või teha muid taaskasutamistoiminguid, kusjuures nende toimingute tulemus on sellise kvaliteediga, mis on võrreldav liigiti kogumisel saavutatavaga; liigiti kogumine ei ole keskkonna jaoks parim lahendus, võttes arvesse vastavate jäätmevoogude juhtimise üldist keskkonnamõju; liigiti kogumine ei ole jäätmekogumise häid tavasid arvestades tehniliselt võimalik; liigiti kogumine tekitaks ebaproportsionaalselt suuri majanduslikke kulusid, kui võtta arvesse segaolmejäätmete kogumise ja töötlemisega kaasnevaid keskkonna- ja tervisekahju kulusid, võimalusi jäätmekogumist ja -töötlust tõhustada, teisese toorme müügist saadavat tulu ning saastaja maksab põhimõtte ja tootja laiendatud vastutuse rakendamist. (7) Olmejäätmete liigiti kogumine toimub käesoleva seaduse § 36 lõike 5 alusel kehtestatud nõuete ja korra kohaselt.",
      "rdfs:label": {
        "@value": "JäätS_Par_31 (redaktsioon 105052021003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105052021003",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_31_v108072025057"
      },
      "estleg:versionValidTo": {
        "@value": "2025-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105052021003",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_31_v108072025057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohaliku omavalitsuse üksus korraldab jäätmete liigiti kogumist, et võimaldada nende korduskasutuseks ettevalmistamist, ringlussevõttu või muud taaskasutamist võimalikult suures ulatuses. (1¹) Käesoleva paragrahvi lõike 1 kohaselt korraldatud jäätmete liigiti kogumise eesmärk on muu hulgas käesoleva seaduse § 1363 lõigetes 1 ja 2 nimetatud olmejäätmete ringlussevõtu sihtarvude täitmine. (2) Kehtetu - (3) Kohaliku omavalitsuse üksus peab korraldama vähemalt paberi-, papi-, metalli-, plasti-, tekstiili- ja klaasijäätmete ning kodumajapidamises tekkivate ohtlike jäätmete liigiti kogumise. (4) Kohaliku omavalitsuse üksus peab korraldama biojäätmete liigiti kogumise tekkekohalt, kui neid ei ole võimalik tekkekohal ringlusse võtta. Biojäätmetega koos võib lubada tekkekohalt koguda samasuguste biolagunemis- ja kompostimisomadustega jäätmeid, mis vastavad kompostimise ja biolagunemise teel taaskasutatavate pakendite suhtes kohaldatavatele Euroopa või samaväärsetele riiklikele standarditele. (4¹) Käesoleva paragrahvi lõike 4 kohaseks biojäätmete tekkekohal ringlusse võtmiseks ja biojäätmete tekkekohalt liigiti kogumise vabastuse saamiseks tuleb jäätmevaldajal esitada kohaliku omavalitsuse üksusele taotlus. (4²) Kohaliku omavalitsuse üksus peab olema veendunud, et biojäätmeid on võimalik tekkekohal ringlusse võtta. (4³) Kui kohaliku omavalitsuse üksus nõustub biojäätmete tekkekohal ringlusse võtmisega ja vabastab taotleja biojäätmete tekkekohalt liigiti kogumisest, registreerib kohaliku omavalitsuse üksus käesoleva paragrahvi lõike 41 kohase taotluse alusel biojäätmete tekkekohal ringlusse võtmise käesoleva seaduse § 711 nimetatud kohaliku omavalitsuse üksuse jäätmevaldajate registris. Juriidiliste isikute puhul tuleb jäätmevaldajate registrisse märkida ka tekkekohal ringlusse võetavate biojäätmete aastakogus. (4⁴) Biojäätmete tekkekohal ringlusse võtmise lõpetamise korral teavitab jäätmevaldaja sellest kohaliku omavalitsuse üksust ning seejärel kogutakse biojäätmeid tekkekohalt liigiti käesoleva paragrahvi lõike 4 kohaselt. (5) Kohaliku omavalitsuse üksus võib korraldada pakendijäätmete liigiti kogumise tekkekohalt kokkuleppel pakendiseaduse § 101 lõikes 1 nimetatud taaskasutusorganisatsiooniga, kellele tagatakse sellisel juhul osalemine pakendijäätmete taaskasutamise korraldamisel proportsionaalselt tema turuosaga. Pakendijäätmete tekkekohalt kogumine võib toimuda eri liiki pakendimaterjali koos kogumisena. (6) Kohaliku omavalitsuse üksus võib jäätmekavas ja jäätmehoolduseeskirjas ette näha erandi käesoleva paragrahvi lõigetes 3 ja 4 nimetatud liigiti kogumisest, kui on täidetud vähemalt üks järgmistest tingimustest: teatavat liiki jäätmete koos kogumine ei vähenda võimalusi neid korduskasutuseks ette valmistada, ringlusse võtta või teha muid taaskasutamistoiminguid, kusjuures nende toimingute tulemus on sellise kvaliteediga, mis on võrreldav liigiti kogumisel saavutatavaga; liigiti kogumine ei ole keskkonna jaoks parim lahendus, võttes arvesse vastavate jäätmevoogude juhtimise üldist keskkonnamõju; liigiti kogumine ei ole jäätmekogumise häid tavasid arvestades tehniliselt võimalik; liigiti kogumine tekitaks ebaproportsionaalselt suuri majanduslikke kulusid, kui võtta arvesse segaolmejäätmete kogumise ja töötlemisega kaasnevaid keskkonna- ja tervisekahju kulusid, võimalusi jäätmekogumist ja -töötlust tõhustada, teisese toorme müügist saadavat tulu ning saastaja maksab põhimõtte ja tootja laiendatud vastutuse rakendamist. (7) Olmejäätmete liigiti kogumine toimub käesoleva seaduse § 36 lõike 5 alusel kehtestatud nõuete ja korra kohaselt.",
      "rdfs:label": {
        "@value": "JäätS_Par_31 (redaktsioon 108072025057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025057",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_31_v107012026016"
      },
      "estleg:versionValidTo": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072025057",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_31_v107012026016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohaliku omavalitsuse üksus korraldab jäätmete liigiti kogumist, et võimaldada nende korduskasutuseks ettevalmistamist, ringlussevõttu või muud taaskasutamist võimalikult suures ulatuses. (1¹) Käesoleva paragrahvi lõike 1 kohaselt korraldatud jäätmete liigiti kogumise eesmärk on muu hulgas käesoleva seaduse § 1363 lõigetes 1 ja 2 nimetatud olmejäätmete ringlussevõtu ja sama paragrahvi lõikes 5 nimetatud olmejäätmete liigiti kogumise sihtarvude täitmine. (2) Kehtetu - (3) Kohaliku omavalitsuse üksus peab korraldama vähemalt paberi-, papi-, metalli-, plasti-, tekstiili- ja klaasijäätmete ning kodumajapidamises tekkivate ohtlike jäätmete liigiti kogumise. (3¹) Paber- ja kartongpakendijäätmed kogutakse koos paberi- ja kartongijäätmetega. (4) Kohaliku omavalitsuse üksus peab korraldama biojäätmete liigiti kogumise tekkekohalt, kui neid ei ole võimalik tekkekohal ringlusse võtta. Biojäätmetega koos võib lubada tekkekohalt koguda samasuguste biolagunemis- ja kompostimisomadustega jäätmeid, mis vastavad kompostimise ja biolagunemise teel taaskasutatavate pakendite suhtes kohaldatavatele Euroopa või samaväärsetele riiklikele standarditele. (4¹) Käesoleva paragrahvi lõike 4 kohaseks biojäätmete tekkekohal ringlusse võtmiseks ja biojäätmete tekkekohalt liigiti kogumise vabastuse saamiseks tuleb jäätmevaldajal esitada kohaliku omavalitsuse üksusele taotlus. (4²) Kohaliku omavalitsuse üksus peab olema veendunud, et biojäätmeid on võimalik tekkekohal ringlusse võtta. (4³) Kui kohaliku omavalitsuse üksus nõustub biojäätmete tekkekohal ringlusse võtmisega ja vabastab taotleja biojäätmete tekkekohalt liigiti kogumisest, registreerib kohaliku omavalitsuse üksus käesoleva paragrahvi lõike 41 kohase taotluse alusel biojäätmete tekkekohal ringlusse võtmise käesoleva seaduse § 711 nimetatud kohaliku omavalitsuse üksuse jäätmevaldajate registris. Juriidiliste isikute puhul tuleb jäätmevaldajate registrisse märkida ka tekkekohal ringlusse võetavate biojäätmete aastakogus. (4⁴) Biojäätmete tekkekohal ringlusse võtmise lõpetamise korral teavitab jäätmevaldaja sellest kohaliku omavalitsuse üksust ning seejärel kogutakse biojäätmeid tekkekohalt liigiti käesoleva paragrahvi lõike 4 kohaselt. (5) Kehtetu - (6) Kohaliku omavalitsuse üksus võib jäätmekavas ja jäätmehoolduseeskirjas ette näha erandi käesoleva paragrahvi lõigetes 3 ja 4 ning pakendiseaduse §-s 15 nimetatud liigiti kogumisest, kui on täidetud vähemalt üks järgmistest tingimustest: teatavat liiki jäätmete koos kogumine ei vähenda võimalusi neid korduskasutuseks ette valmistada, ringlusse võtta või teha muid taaskasutamistoiminguid, kusjuures nende toimingute tulemus on sellise kvaliteediga, mis on võrreldav liigiti kogumisel saavutatavaga; liigiti kogumine ei ole keskkonna jaoks parim lahendus, võttes arvesse vastavate jäätmevoogude juhtimise üldist keskkonnamõju; liigiti kogumine ei ole jäätmekogumise häid tavasid arvestades tehniliselt võimalik; liigiti kogumine tekitaks ebaproportsionaalselt suuri majanduslikke kulusid, kui võtta arvesse segaolmejäätmete kogumise ja töötlemisega kaasnevaid keskkonna- ja tervisekahju kulusid, võimalusi jäätmekogumist ja -töötlust tõhustada, teisese toorme müügist saadavat tulu ning saastaja maksab põhimõtte ja tootja laiendatud vastutuse rakendamist. (7) Olmejäätmete liigiti kogumine toimub käesoleva seaduse § 36 lõike 5 alusel kehtestatud nõuete ja korra kohaselt, lähtudes piirkondlikest iseärasustest, nagu eeldatavatest jäätmekogustest, hoonestusest, asustustihedusest ning teede- ja tänavatevõrgu eripärast. (8) Olmejäätmete liigiti kogumist korraldades tuleb tagada, et see on jäätmevaldajale segaolmejäätmete või valesti liigitatud jäätmete üleandmisega võrreldes võimalikult mugav, motiveeriv ja kulutõhus.",
      "rdfs:label": {
        "@value": "JäätS_Par_31 (redaktsioon 107012026016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107012026016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107012026016",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_32_v22415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmeloa annab loa taotleja tegevuskohajärgne keskkonnateenistus. Kui püsivat tegevuskohta ei ole, annab loa taotleja asukohajärgne keskkonnateenistus. Loa andmiseks vajaliku taotlusmaterjali koostab taotleja oma kulul. (1¹) Jäätmeluba teiste isikute poolt tekitatud ning üleantud käesoleva seaduse § 431 lõigetes 2 ja 3 nimetatud metallijäätmete kogumiseks või veoks edasise kaubandusvahendamise või taaskasutamise eesmärgil antakse üheks aastaks. (2) Jäätmeloa taotlused esitab loa taotleja eelnevalt oma tegevus- või asukohajärgsele linna- või vallavalitsusele, kes annab oma seisukoha taotluse suhtes kolme nädala jooksul ning edastab need keskkonnateenistus.",
      "rdfs:label": {
        "@value": "JäätS_Par_32 (redaktsioon 22415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22415",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_32_v749804"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22415",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 32",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_32_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmed taaskasutatakse või kõrvaldatakse nende tekkekohale võimalikult lähedal asuvas tehnoloogiliselt sobivas ning tervisekaitse- ja keskkonnanõuetele vastavas jäätmekäitluskohas.",
      "rdfs:label": {
        "@value": "JäätS_Par_32 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_32_v12799159"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 32",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_32_v12799159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmed kõrvaldatakse nende tekkekohale võimalikult lähedal asuvas tehnoloogiliselt sobivas jäätmekäitluskohas, kus on tagatud inimese tervise ja keskkonna ohutus.",
      "rdfs:label": {
        "@value": "JäätS_Par_32 (redaktsioon 12799159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12799159",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_32_v109112011004"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12799159",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 32",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_32_v109112011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmed kõrvaldatakse ja segaolmejäätmed taaskasutatakse nende tekkekohale võimalikult lähedal asuvas tehnoloogiliselt sobivas jäätmekäitluskohas, kus on tagatud inimese tervise ja keskkonna ohutus.",
      "rdfs:label": {
        "@value": "JäätS_Par_32 (redaktsioon 109112011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011004",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 32",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_33_v22415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmeloa taotlemisel ohtlike jäätmete käitlemiseks teenustööna peab taotlejal olema ohtlike jäätmete käitluslitsents. (2) Tekkivate ja keskkonda viidavate jäätmete lubatud kogused määrab loa andja taotleja esitatud tehnoloogiliselt ja keskkonnakaitseliselt põhjendatud arvutuste alusel, võttes muuhulgas arvesse parima keskkonnapraktika ja parima võimaliku tehnoloogia kriteeriume ning käesoleva seaduse paragrahvide 5 ja 11 sätteid. (3) Et kindlaks määrata taotluse vastavust käesoleva paragrahvi lõikes 2 sätestatule, võib loa andja nõuda enne loa andmist kavandatava tegevuse keskkonnamõju hindamist loa taotleja kulul. (4) Käesoleva seaduse § 32 lõikes 11 nimetatud jäätmeloa taotleja peab olema äriregistrisse kantud aktsiaselts või osaühing aktsia- või osakapitaliga vähemalt 1 miljon krooni.",
      "rdfs:label": {
        "@value": "JäätS_Par_33 (redaktsioon 22415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22415",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_33_v184825"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22415",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 33",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_33_v184825",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmeloa taotlemisel ohtlike jäätmete käitlemiseks teenustööna peab taotlejal olema ohtlike jäätmete käitluslitsents. (2) Tekkivate ja keskkonda viidavate jäätmete lubatud kogused määrab loa andja taotleja esitatud tehnoloogiliselt ja keskkonnakaitseliselt põhjendatud arvutuste alusel, võttes muuhulgas arvesse parima keskkonnapraktika ja parima võimaliku tehnoloogia kriteeriume ning käesoleva seaduse §-de 5 ja 11 sätteid. (3) Et kindlaks määrata taotluse vastavust käesoleva paragrahvi lõikes 2 sätestatule, võib loa andja nõuda enne loa andmist kavandatava tegevuse keskkonnamõju hindamist loa taotleja kulul. (3¹) Tagamaks isikute kaitse, kellele jäätmeloaga reguleeritud tegevus võib põhjustada varalist kahju või muul viisil kahjustada nende huve, võib loa andja oma initsiatiivil või menetlusosalise taotlusel asja arutada avalikul istungil. (4) Käesoleva seaduse § 32 lõikes 11 nimetatud jäätmeloa taotleja peab olema äriregistrisse kantud aktsiaselts või osaühing aktsia- või osakapitaliga vähemalt 1 miljon krooni.",
      "rdfs:label": {
        "@value": "JäätS_Par_33 (redaktsioon 184825)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184825",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_33_v749804"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/184825",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 33",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_33_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäätmekäitluskoha tervise- ja keskkonnaohutuse tagamiseks nii jäätmete käitlemise ajal kui ka pärast käitlemise lõpetamist kehtestatakse keskkonnaministri määrusega: prügila rajamise, kasutamise ja sulgemise nõuded; jäätmepõletustehase rajamise, kasutamise ja sulgemise nõuded; koospõletustehase rajamise, kasutamise ja sulgemise nõuded. (2) Käesoleva paragrahvi lõikes 1 nimetatud määrusega on keskkonnaministril õigus jäätmekäitluskoha ohutuse tagamiseks kehtestada: tehnilisi norme, tehniliste parameetrite väärtusi ja muid käitamisnõudeid; käitamisel tekkivate heitmete piirväärtusi; nõudeid heitmete ja neis sisalduvate saasteainete tehniliste parameetrite mõõtmiseks, mõõtmissagedust ja muid mõõtmistingimusi; keskkonnaseirenõudeid jäätmekäitluskohas ja selle ümbruses enne käitluse alustamist, käitlemise ajal ning pärast käitluse lõpetamist; keskkonnaseire kestust jäätmekäitluskoha järelhoolduse ajal.",
      "rdfs:label": {
        "@value": "JäätS_Par_33 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_33_v918045"
      },
      "estleg:versionValidTo": {
        "@value": "2005-07-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
