        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22415",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 13",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_13_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmekäitlus on jäätmete kogumine, vedamine, taaskasutamine ja kõrvaldamine.",
      "rdfs:label": {
        "@value": "JäätS_Par_13 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_13_v109112011004"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 13",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_13_v109112011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmekäitlus on jäätmete kogumine, vedamine, taaskasutamine ja kõrvaldamine, sealhulgas vahendaja või edasimüüja tegevus.",
      "rdfs:label": {
        "@value": "JäätS_Par_13 (redaktsioon 109112011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011004",
