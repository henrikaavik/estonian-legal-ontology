      }
    },
    {
      "@id": "estleg:JäätS_Par_91_v12799159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse § -s 78 nimetatud andmetele esitab prügila käitamiseks jäätmeloa (edaspidi prügilaloa) taotleja loa andjale: andmed ladestatavate jäätmete koguse kohta jäätmekoodide ja jäätmeliikide kaupa; andmed prügila kavandatud mahutavuse kohta; prügila asukoha kirjelduse, selle hüdrogeoloogilise ja geoloogilise iseloomustuse; taotleja kirjaliku tõenduse, et tal on tegutsemiseks vajaliku oskusega personal taotluses märgitud tegevusalal ning tema tegevus vastab keskkonnakaitse- ja tööohutusalastes õigusaktides kehtestatud nõuetele; taotleja kirjaliku selgituse kindlustuslepingu või rahalise tagatise olemasolu kohta, mis tagavad käitaja suutlikkust täita oma ülesandeid nii prügila kasutamise, sulgemise kui järelhoolduse ajal; taotleja maakasutuse õiguslikku alust tõendavad dokumendid; personali vastavat väljaõpet tõendavad dokumendid või nende kinnitatud koopiad; prügila töö korraldamisel rakendatavad meetmed õnnetuste vältimiseks ja nende kahjulike tagajärgede piiramiseks.",
      "rdfs:label": {
        "@value": "JäätS_Par_91 (redaktsioon 12799159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12799159",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_91_v12801655"
      },
      "estleg:versionValidTo": {
        "@value": "2007-07-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12799159",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 91",
