      }
    },
    {
      "@id": "estleg:JäätS_Par_93_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_93"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse § 81 lõikes 2 sätestatule määratakse prügilaloaga: prügila liik käesoleva seaduse § 34 lõike 4 alusel; prügilasse ladestatavate jäätmete kogus jäätmekategooriate ja liikide kaupa; prügila kasutamist, keskkonnaseiret ning järelevalvet käsitlevad nõuded; loa taotleja kohustus vähemalt kord aastas loa andjale aru anda prügilasse vastuvõetud jäätmeliikide, nende koguste, keskkonnaseire tulemuste kohta ning loa andja teavitamise kord.",
      "rdfs:label": {
        "@value": "JäätS_Par_93 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_93_v13341117"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 93",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_93_v13341117",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_93"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks käesoleva seaduse § 81 lõikes 2 sätestatule määratakse prügilaloaga: prügila liik käesoleva seaduse § 34 lõike 4 alusel; prügilasse ladestatavate jäätmete liigid vastavalt jäätmenimistule ning jäätmete kogus kas üldkogusena või vajaduse korral jäätmeliikide kaupa või jäätmeliikide lõikes jäätmekoguste summana; prügila kasutamist, keskkonnaseiret ning järelevalvet käsitlevad nõuded; loa taotleja kohustus vähemalt kord aastas loa andjale aru anda prügilasse vastuvõetud jäätmeliikide, nende koguste, keskkonnaseire tulemuste kohta ning loa andja teavitamise kord.",
      "rdfs:label": {
