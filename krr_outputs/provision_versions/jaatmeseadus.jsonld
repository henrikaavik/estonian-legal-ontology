        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veoloa taotluse menetlemise eest tasub taotleja riigilõivu riigilõivuseaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "JäätS_Par_111 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 111",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_112_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veoloa andja tunnistab EÜ Nõukogu määruse 259/93/EMÜ artikli 3 lõigetes 4–6, artikli 6 lõigetes 4–6, artikli 11 lõikes 1 ja artikli 15 lõigetes 1–4 nimetatud dokumendid asutusesiseseks kasutamiseks avaliku teabe seaduses (RT I 2000, 92, 597; 2002, 61, 375; 63, 387; 2003, 25, 153; 26, 158; 32, õiend) sätestatud korras.",
      "rdfs:label": {
        "@value": "JäätS_Par_112 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
