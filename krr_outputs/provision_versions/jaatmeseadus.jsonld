        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_40_v109112011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi jäätmekava on jäätmehoolduse arengukava, mis hõlmab kogu riigi territooriumi ning käsitleb lisaks käesoleva seaduse § 39 lõikes 3 sätestatule ka riigi territooriumile toodavaid ja sealt välja veetavaid jäätmeid, jäätmekäitluse riikidevahelist optimeerimist ja jäätmealast koostööd, ning milles antakse hinnang majanduslike ja muude hoobade kasutamise kasulikkusele ja sobivusele jäätmeprobleemide lahendamiseks. (2) Riigi jäätmekava sisaldab ohtlike jäätmete ja pakendijäätmete käitlemist käsitlevaid alljaotisi, maakondade jäätmehooldust käsitlevaid alljaotisi ja jäätmetekke vältimise programmi. (3) Käesoleva paragrahvi lõikes 2 nimetatud alljaotisi ja jäätmetekke vältimise programmi võib kinnitada eraldi arengukavana. Eraldi kinnitatud arengukavale kohaldatakse riigi jäätmekava menetluse kohta sätestatut ulatuses, mis ei lähe vastuollu kava põhimõtetega.",
      "rdfs:label": {
        "@value": "JäätS_Par_40 (redaktsioon 109112011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011004",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_40_v113032014028"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011004",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 40",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
