    },
    {
      "@id": "estleg:JäätS_Par_63_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_63"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohtlikke jäätmeid tohib vedada ohtlikke veoseid käsitlevate õigusaktidega ning rahvusvaheliste lepingutega sätestatud korras.",
      "rdfs:label": {
        "@value": "JäätS_Par_63 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 63",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_64_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ohtlike jäätmete saatekiri (edaspidi saatekiri) on dokument, mis sisaldab andmeid jäätmekäitlejale üleantavate jäätmete tekitaja, jäätmed vedamiseks üleandnud isiku, jäätmevedaja ja jäätmete vastuvõtja ning ohtlike jäätmete liigi, koostise, koguse ja põhiomaduste kohta. (2) Jäätmete üleandja esitab vedajale ja vastuvõtjale saatekirja koos ohtlike jäätmete saadetisega. (3) Käesoleva paragrahvi lõigetes 1 ja 2 sätestatut ei kohaldata füüsilise isiku suhtes kodumajapidamises tekkivate ja päästeasutuse poolt tuletõrje- ja päästetöödel kokkukogutud ohtlike jäätmete üleandmisel jäätmekäitlejale. (4) Jäätmekäitleja koostab saatekirja paber- ja digitaaldokumendina, allkirjastades digitaaldokumendi digitaalallkirja seaduses (RT I 2000, 26, 150; 92, 597; 2001, 56, 338; 2002, 53, 336; 61, 375; 2003, 88, 591 ja 594) sätestatud korras. Digitaaldokumenti nõutakse isikult, kes on sertifikaadi omanik digitaalallkirja seaduse § 6 tähenduses. (5) Ohtlike jäätmete saatekirja vorm ning saatekirja registreerimise kord kehtestatakse keskkonnaministri määrusega.",
      "rdfs:label": {
        "@value": "JäätS_Par_64 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_64_v918045"
      },
      "estleg:versionValidTo": {
        "@value": "2005-07-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 64",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
