    {
      "@id": "estleg:JäätS_Par_119_1_v113032014029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_119_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrakaitseorgan võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 45, 46, 49, 50, 51, 52 ja 53 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "JäätS_Par_119_1 (redaktsioon 113032014029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014029",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_119_1_v105052021003"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014029",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 119_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_119_1_v105052021003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_119_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrakaitseorgan võib käesolevas seaduses sätestatud riiklikule järelevalve teostamisel kohaldada korrakaitseseaduse §-des 30, 31, 32, 34, 45, 46, 49, 50, 51, 52 ja 53 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "JäätS_Par_119_1 (redaktsioon 105052021003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105052021003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105052021003",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 119_1",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_119_2_v113032014029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_119_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korrakaitseorgani ametiisik võib järelevalve teostamise eesmärgil viibida ja liikuda sõidukiga, sealhulgas maastikusõidukiga ja ujuvvahendiga, maa- või veealal, kus viibimine ja liikumine on keskkonnakaitse eesmärgil õigusaktiga keelatud või piiratud. (2) Keskkonnainspektsioon on kohustatud kontrollima vähemalt üks kord aastas prügila käitaja, A-kategooria jäätmehoidla käitaja ning jäätmeloa alusel alates 100 tonni ohtlike jäätmete käitleja jäätmeloaga määratud jäätmekäitlustingimuste täitmist. (3) Keskkonnainspektsioon on kohustatud kontrollima vähemalt üks kord aastas tootjate ühenduse tegevuse vastavust jäätmeseadusega kehtestatud nõuetele.",
      "rdfs:label": {
        "@value": "JäätS_Par_119_2 (redaktsioon 113032014029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014029",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_119_2_v106032015028"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-15",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014029",
