      "estleg:provisionRef": "JäätS § 119_2",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
    {
      "@id": "estleg:JäätS_Par_119_2_v106032015028",
      "@type": [
        "owl:NamedIndividual",
