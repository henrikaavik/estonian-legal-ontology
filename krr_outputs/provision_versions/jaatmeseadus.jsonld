    {
      "@id": "estleg:JäätS_Par_102_v749804",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JäätS_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohtlike jäätmete käitluslitsentsi kehtivuse peatab või tunnistab litsentsi kehtetuks selle andja sellest litsentsi omajat eelnevalt informeerides, kui: ilmneb, et litsentsi taotlemisel on esitatud valeandmeid; litsentsi omaja tegevuses ilmnevad käesoleva seaduse §-s 101 nimetatud asjaolud; litsentsi omaja ei täida litsentsi väljaandmisel esitatud nõudeid; ilmnevad muud vastuolud õigusaktidega; ohtlike jäätmete käitlemine ei ole taotleja tegevusvaldkonnana kantud äriregistrisse viie kuu jooksul litsentsi andmise päevast.",
      "rdfs:label": {
        "@value": "JäätS_Par_102 (redaktsioon 749804)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749804",
      "estleg:supersededByVersion": {
        "@id": "estleg:JäätS_Par_102_v1040598"
      },
      "estleg:versionValidTo": {
        "@value": "2006-06-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749804",
      "estleg:sourceAct": "Jäätmeseadus",
      "estleg:provisionRef": "JäätS § 102",
      "estleg:partOfAct": {
        "@id": "estleg:JäätS_Map_2026"
      }
    },
