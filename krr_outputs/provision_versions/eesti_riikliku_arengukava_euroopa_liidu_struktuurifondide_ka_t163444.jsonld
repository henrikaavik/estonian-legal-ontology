      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163444_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse alusel esitatud dokumente taotlejale ei tagastata. Nimetatud dokumente säilitatakse PRIAs kuni 2015. a 31. detsembrini ning vastavalt «Arhiiviseadusele». Määruse alusel esitatud dokumente taotlejale ei tagastata. Nimetatud dokumente säilitatakse PRIAs kuni 2015. a 31. detsembrini ning vastavalt «Arhiiviseadusele». Märkus. Lisad on avaldatud elektroonilises Riigi Teatajas. (Alus: «Riigi Teataja seaduse» § 4 lg 2; riigisekretäri 21. aprilli 2004. a resolutsioon nr nr 17-1/0403607.) Märkus. Lisad on avaldatud elektroonilises Riigi Teatajas. (Alus: «Riigi Teataja seaduse» § 4 lg 2; riigisekretäri 21. aprilli 2004. a resolutsioon nr nr 17-1/0403607.)",
      "rdfs:label": {
        "@value": "Reg_163444_Par_20 (redaktsioon 163444)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163444",
