      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Äriseadustikus tehakse järgmised muudatused: paragrahvi 433 täiendatakse lausega järgmises sõnastuses: «Kui moodustatakse nõukogu, siis märgitakse ka nõukogu liikmed.»; paragrahvi 472 esimene lause tunnistatakse kehtetuks; paragrahvi 477 täiendatakse lausega järgmises sõnastuses: «Kui moodustatakse nõukogu, siis märgitakse ka nõukogu liikmed.»",
      "rdfs:label": {
        "@value": "TÜS_Par_98 (redaktsioon 162839)",
        "@language": "et"
      },
