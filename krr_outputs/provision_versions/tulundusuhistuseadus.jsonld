      },
      "estleg:versionValidTo": {
        "@value": "2005-12-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_96_1_v962357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_96_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühistus riigi liikmeõiguste teostajaks olev valitsusasutus või põhiseaduslik institutsioon peab 2005. aasta 1. maiks ühistust välja astuma.",
      "rdfs:label": {
        "@value": "TÜS_Par_96_1 (redaktsioon 962357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "962357"
    },
    {
      "@id": "estleg:TÜS_Par_96_2_v962357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_96_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2005. aasta 1. jaanuari alanud aruandeperioodide majandusaasta aruannetele kohaldatakse käesoleva seaduse § 29 lõiget 2 enne 2005. aasta 1. detsembrit kehtinud redaktsioonis.",
      "rdfs:label": {
        "@value": "TÜS_Par_96_2 (redaktsioon 962357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "962357"
    },
    {
      "@id": "estleg:TÜS_Par_96_3_v12985337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_96_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 72 lõike 3 teises lauses sätestatut kohaldatakse majandusaasta aruandele, mis on koostatud aruandeperioodi kohta, mis algab 2009. aasta 1. jaanuaril või hiljem.",
      "rdfs:label": {
        "@value": "TÜS_Par_96_3 (redaktsioon 12985337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12985337"
    },
    {
      "@id": "estleg:TÜS_Par_96_4_v123052020008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_96_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tulundusühistu, kellel on kohustus esitada majandusaasta aruanne registripidajale ajavahemikul 2020. aasta 12. märtsist 31. augustini, peab esitama aruande hiljemalt 2020. aasta 31. oktoobril.",
      "rdfs:label": {
        "@value": "TÜS_Par_96_4 (redaktsioon 123052020008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123052020008"
    },
    {
      "@id": "estleg:TÜS_Par_97_v162839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist asutatud mittetulundusühistud võivad oma nimes sõna «ühistu» edasi kasutada. Pärast käesoleva seaduse jõustumist asutatud mittetulundusühingud võivad kasutada oma nimes sõna «ühistu» seadusega sätestatud juhul.",
      "rdfs:label": {
        "@value": "TÜS_Par_97 (redaktsioon 162839)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162839",
      "estleg:supersededByVersion": {
