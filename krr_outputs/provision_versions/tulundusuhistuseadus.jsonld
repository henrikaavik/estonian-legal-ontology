    {
      "@id": "estleg:TÜS_Par_96_1_v737955",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_96_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühistus riigi liikmeõiguste teostajaks olev valitsusasutus või põhiseaduslik institutsioon peab 2005.aasta 1. maiks ühistust välja astuma.",
      "rdfs:label": {
        "@value": "TÜS_Par_96_1 (redaktsioon 737955)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "737955",
      "estleg:supersededByVersion": {
