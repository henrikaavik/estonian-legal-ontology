      }
    },
    {
      "@id": "estleg:TÜS_Par_55_v120062022034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_55"
      },
