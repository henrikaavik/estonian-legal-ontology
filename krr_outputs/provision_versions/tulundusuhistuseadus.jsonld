        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_79_v13149633",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistu likvideerijateks on juhatuse liikmed, kui põhikirjas, üldkoosoleku otsusega ega kohtumäärusega ei ole ette nähtud teisiti. Likvideerijaks ei või olla füüsiline isik, kes ei või olla juhatuse liikmeks. (2) Vähemalt pooled likvideerijad peavad olema isikud, kelle elukoht on Eestis. (3) Kohus määrab likvideerijad sundlõpetamise korral, samuti juhul, kui seda nõuab vähemalt 1/10 liikmetest või vähemalt kolm liiget, kui ühistus on alla 30 liikme. Kohus määrab ka likvideerijate tasustamise korra ja tasu suuruse.",
      "rdfs:label": {
        "@value": "TÜS_Par_79 (redaktsioon 13149633)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13149633",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜS_Par_79_v13231570"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_79_v13231570",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistu likvideerijateks on juhatuse liikmed, kui põhikirjas, üldkoosoleku otsusega ega kohtumäärusega ei ole ette nähtud teisiti. Likvideerijaks ei või olla füüsiline isik, kes ei või olla juhatuse liikmeks. (2) Vähemalt pooled likvideerijad peavad olema isikud, kelle elukoht on Eestis. (3) Kohus määrab likvideerijad sundlõpetamise korral, samuti juhul, kui seda nõuab vähemalt 1/10 liikmetest või vähemalt kaks liiget, kui ühistus on alla 20 liikme. Kohus määrab ka likvideerijate tasustamise korra ja tasu suuruse.",
      "rdfs:label": {
        "@value": "TÜS_Par_79 (redaktsioon 13231570)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231570"
    },
    {
      "@id": "estleg:TÜS_Par_8_v162839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Äriregistrisse kantakse: ühistu ärinimi; ühistu tegevusala, eesmärk, asukoht ja aadress; põhikirja kinnitamise aeg; juhatuse liikmete nimed, isikukoodid ja elukohad; kes juhatuse liikmetest võib esindada ühistut erinevalt käesoleva seaduse § 58 lõikes 1 sätestatust; ühistu majandusaasta algus ja lõpp; ühistu liikmete andmed, kui põhikirjaga on ette nähtud ühistu liikmete täielik isiklik vastutus või lisavastutus; muud seadusega sätestatud andmed.",
      "rdfs:label": {
        "@value": "TÜS_Par_8 (redaktsioon 162839)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162839",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜS_Par_8_v12769872"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_8_v12769872",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Äriregistrisse kantakse: ühistu ärinimi; ühistu eesmärk, asukoht ja aadress; põhikirja kinnitamise aeg; juhatuse liikmete nimed ja isikukoodid; kes juhatuse liikmetest võib esindada ühistut erinevalt käesoleva seaduse § 58 lõikes 1 sätestatust; ühistu majandusaasta algus ja lõpp; ühistu liikmete andmed, kui põhikirjaga on ette nähtud ühistu liikmete täielik isiklik vastutus või lisavastutus; muud seadusega sätestatud andmed.",
      "rdfs:label": {
        "@value": "TÜS_Par_8 (redaktsioon 12769872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12769872",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜS_Par_8_v120042017022"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_8_v120042017022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Äriregistrisse kantakse: ühistu ärinimi; ühistu eesmärk, asukoht ja aadress; juhatuse asukoha aadress, kui see asub välisriigis; põhikirja kinnitamise aeg; juhatuse liikmete nimed ja isikukoodid; kes juhatuse liikmetest võib esindada ühistut erinevalt käesoleva seaduse § 58 lõikes 1 sätestatust; äriseadustiku §-s 631 nimetatud kontaktisiku nimi või ärinimi, isiku- või registrikood ning tulundusühistule suunatud tahteavalduste ja tulundusühistu menetlusdokumentide kättetoimetamise Eesti aadress, samuti kontaktisiku elektronposti aadress; ühistu majandusaasta algus ja lõpp; ühistu liikmete andmed, kui põhikirjaga on ette nähtud ühistu liikmete täielik isiklik vastutus või lisavastutus; muud seadusega sätestatud andmed.",
      "rdfs:label": {
        "@value": "TÜS_Par_8 (redaktsioon 120042017022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120042017022",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜS_Par_8_v123122022032"
      },
      "estleg:versionValidTo": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_8_v123122022032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Äriregistrisse kantakse: ühistu ärinimi; ühistu asukoht, aadress ja elektronposti aadress; kehtetu - põhikirja jõustumise aeg; juhatuse liikmete nimed ja isikukoodid; kehtetu - kehtetu - ühistu majandusaasta algus ja lõpp; kehtetu - muud seadusega sätestatud andmed.",
      "rdfs:label": {
        "@value": "TÜS_Par_8 (redaktsioon 123122022032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022032"
    },
    {
      "@id": "estleg:TÜS_Par_80_v162839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üldkoosoleku otsusega määratud likvideerija võib üldkoosoleku otsusega igal ajal tagasi kutsuda. (2) Liikme või muu huvitatud isiku nõudel võib kohus likvideerija mõjuval põhjusel tagasi kutsuda. Sel juhul nimetab kohus uue likvideerija.",
      "rdfs:label": {
        "@value": "TÜS_Par_80 (redaktsioon 162839)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162839",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜS_Par_80_v13149633"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_80_v13149633",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juhatuse liikmest või üldkoosoleku otsusega määratud või põhikirjast tuleneva likvideerija võib üldkoosolek igal ajal otsusega tagasi kutsuda. Otsuse tegemiseks on vajalik sama häälteenamus nagu likvideerija määramiseks. (2) Kohus võib enda nimetatud likvideerija tagasi kutsuda ja määrata uue likvideerija. Vähemalt 1/10 ühistu liikmete, või kui ühistus on alla 30 liikme, siis vähemalt kolme liikme nõudel võib kohus mõjuval põhjusel tagasi kutsuda ka juhatuse liikmest või üldkoosoleku nimetatud või põhikirjast tuleneva likvideerija ja nimetada uue likvideerija. (3) Likvideerija võib tagasi astuda samal põhjusel ja samas korras nagu juhatuse liige.",
      "rdfs:label": {
        "@value": "TÜS_Par_80 (redaktsioon 13149633)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13149633",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜS_Par_80_v13231570"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_80_v13231570",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juhatuse liikmest või üldkoosoleku otsusega määratud või põhikirjast tuleneva likvideerija võib üldkoosolek igal ajal otsusega tagasi kutsuda. Otsuse tegemiseks on vajalik sama häälteenamus nagu likvideerija määramiseks. (2) Kohus võib enda nimetatud likvideerija tagasi kutsuda ja määrata uue likvideerija. Vähemalt 1/10 ühistu liikmete või vähemalt kahe liikme nõudel, kui ühistus on alla 20 liikme, võib kohus mõjuval põhjusel tagasi kutsuda ka juhatuse liikmest või üldkoosoleku nimetatud või põhikirjast tuleneva likvideerija ja nimetada uue likvideerija. (3) Likvideerija võib tagasi astuda samal põhjusel ja samas korras nagu juhatuse liige.",
      "rdfs:label": {
        "@value": "TÜS_Par_80 (redaktsioon 13231570)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231570"
    },
    {
      "@id": "estleg:TÜS_Par_81_v162839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Likvideerijate kandmiseks äriregistrisse esitab juhatus avalduse. Avaldusele lisatakse likvideerijate avalikult tõestatud allkirjanäidised. (2) Kui likvideerija nimetatakse kohtuotsusega, saadab kohus otsuse äriregistrile kande tegemiseks. (3) Äriregistrisse kantakse likvideerijate nimed, elukohad ja isikukoodid.",
      "rdfs:label": {
        "@value": "TÜS_Par_81 (redaktsioon 162839)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162839",
