      }
    },
    {
      "@id": "estleg:TÜS_Par_77_v13149633",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistu lõpetamise kandmiseks äriregistrisse esitab juhatus avalduse. Avaldusele lisatakse lõpetamisotsus ja üldkoosoleku protokoll. (2) Kui ühistu lõpetatakse kohtulahendi alusel, saadab kohus lahendi äriregistrile kande tegemiseks. (3) Ühistu loetakse lõpetatuks alates lõpetamise kande tegemisest äriregistrisse. Sundlõpetamine jõustub kohtumääruse jõustumisega.",
      "rdfs:label": {
        "@value": "TÜS_Par_77 (redaktsioon 13149633)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13149633",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜS_Par_77_v123122022032"
      },
      "estleg:versionValidTo": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_77_v123122022032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistu lõpetamise kandmiseks äriregistrisse esitab juhatus avalduse. Avaldusele lisatakse lõpetamisotsus ja üldkoosoleku protokoll. (2) Kui ühistu lõpetatakse kohtulahendi alusel, saadab kohus lahendi äriregistrile kande tegemiseks. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "TÜS_Par_77 (redaktsioon 123122022032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022032"
    },
    {
      "@id": "estleg:TÜS_Par_78_v162839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lõpetamisel ühistu likvideeritakse, kui seadusega ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "TÜS_Par_78 (redaktsioon 162839)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162839"
    },
    {
      "@id": "estleg:TÜS_Par_79_v162839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistu likvideerijateks on juhatuse liikmed, kui põhikirjas, üldkoosoleku otsusega ega kohtuotsusega ei ole ette nähtud teisiti. Likvideerija peab olema teovõimeline füüsiline isik. (2) Vähemalt pooled likvideerijad peavad olema isikud, kelle elukoht on Eestis. (3) Kohus määrab likvideerijad sundlõpetamise korral, samuti juhul, kui seda nõuab vähemalt 1/10 liikmetest või vähemalt kolm liiget, kui ühistus on alla 30 liikme. Kohus määrab ka likvideerijate tasustamise korra ja tasu suuruse.",
      "rdfs:label": {
        "@value": "TÜS_Par_79 (redaktsioon 162839)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162839",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜS_Par_79_v13111429"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÜS_Par_79_v13111429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÜS_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistu likvideerijateks on juhatuse liikmed, kui põhikirjas, üldkoosoleku otsusega ega kohtumäärusega ei ole ette nähtud teisiti. Likvideerija peab olema teovõimeline füüsiline isik. (2) Vähemalt pooled likvideerijad peavad olema isikud, kelle elukoht on Eestis. (3) Kohus määrab likvideerijad sundlõpetamise korral, samuti juhul, kui seda nõuab vähemalt 1/10 liikmetest või vähemalt kolm liiget, kui ühistus on alla 30 liikme. Kohus määrab ka likvideerijate tasustamise korra ja tasu suuruse.",
      "rdfs:label": {
        "@value": "TÜS_Par_79 (redaktsioon 13111429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13111429",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÜS_Par_79_v13149633"
