      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär 32 000 eurot.",
      "rdfs:label": {
        "@value": "VKS_Par_25 (redaktsioon 108072025048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072025048",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 25",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_26_v261461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalveasutuse pädeva ametiisiku ettekirjutuse või muu toiminguga mittenõustumise korral on isikul, kellele ettekirjutus või toiming on suunatud, õigus esitada kirjalik vaie ettekirjutuse teinud asutuse juhile kümne päeva jooksul ettekirjutusest või toimingust teadasaamise päevast arvates. Vaide esitamine ei vabasta kohustusest ettekirjutus täita. (2) Vaiet ei saa esitada järelevalveasutuse peadirektori haldusakti või toimingu peale. (3) Käesoleva paragrahvi lõikes 1 nimetatud vaie vaadatakse läbi ühe kuu jooksul arvates vaide saamise päevast ning vaideotsus toimetatakse viivitamata vaide esitajale kätte allkirja vastu või saadetakse posti teel väljastusteatega.",
      "rdfs:label": {
        "@value": "VKS_Par_26 (redaktsioon 261461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261461",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_26_v129062014089"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/261461",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
