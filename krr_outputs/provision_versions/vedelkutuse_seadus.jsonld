      }
    },
    {
      "@id": "estleg:VKS_Par_7_1_v130062023095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_7_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kliimaministeerium teavitab Euroopa Komisjoni perioodiliselt kütuse hindadest. (2) Kütusemüüja on kohustatud andma Kliimaministeeriumi nõudel andmeid käesoleva paragrahvi lõikes 1 nimetatud teavitamiseks.",
      "rdfs:label": {
        "@value": "VKS_Par_7_1 (redaktsioon 130062023095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023095",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062023095",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 7_1",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_8_v261461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõuded autobensiinile, diislikütusele, kergele kütteõlile ja raskele kütteõlile kehtestab majandus- ja kommunikatsiooniminister määrusega. Nõuded kehtestatakse, lähtudes kütuse kasutamise otstarbest ja keskkonnanõuetest. (2) Nõuetele mittevastava, käesoleva paragrahvi lõikes 1 nimetatud kütuse käitlemine on keelatud, kui käesolev seadus ei sätesta teisiti. Kütuse vastavuse eest nõuetele vastutab kütuse käitleja. (3) Autobensiinidest on lubatud importida ja müüa ainult pliivaba bensiini. Pliivabaks bensiiniks käesoleva seaduse mõistes loetakse bensiini, mille pliisisaldus ei ületa 0,013 grammi liitri kohta. (4) Majandus- ja kommunikatsiooniministril on õigus lubada sportsõidukites kasutamiseks ettenähtud nõuetele mittevastava spetsiifiliste omadustega kütuse piiratud koguses importi vastava spordiliidu taotlusel. (5) Käesoleva paragrahvi lõikes 4 nimetatud loa taotluses peavad olema järgmised andmed: spordiliidu nimetus, registrikood, asukoha aadress ja kontaktandmed; imporditava kütuse nimetus, EKN-i kaubakood, kütuse kogus; importija ärinimi; taotluse vajaduse selgitus või põhjendus.",
      "rdfs:label": {
        "@value": "VKS_Par_8 (redaktsioon 261461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261461",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_8_v780241"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/261461",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_8_v780241",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõuded autobensiinile, diislikütusele, kergele kütteõlile ja raskele kütteõlile, välja arvatud põlevkivikütteõli, kehtestab majandus- ja kommunikatsiooniminister määrusega . Nõuded kehtestatakse, lähtudes kütuse kasutamise otstarbest ja keskkonnanõuetest. (2) Nõuetele mittevastava, käesoleva paragrahvi lõikes 1 nimetatud kütuse käitlemine on keelatud, kui käesolev seadus ei sätesta teisiti. Kütuse vastavuse eest nõuetele vastutab kütuse käitleja. (3) Autobensiinidest võib tarbimisse lubada ja müüa ainult pliivaba bensiini . Pliivabaks bensiiniks käesoleva seaduse mõistes loetakse bensiini, mille pliisisaldus ei ületa 0,013 grammi liitri kohta. (4) Majandus- ja kommunikatsiooniministril on õigus lubada sportsõidukites kasutamiseks ettenähtud nõuetele mittevastava spetsiifiliste omadustega kütuse piiratud koguses tarbimisse lubamist vastava spordiliidu taotlusel. (5) Käesoleva paragrahvi lõikes 4 nimetatud loa taotluses peavad olema järgmised andmed: spordiliidu nimetus, registrikood, asukoha aadress ja kontaktandmed; kütuse nimetus, KN-i kaubakood, kütuse kogus; selle äriühingu nimi, kes kütuse tarbimisse lubab ; taotluse vajaduse selgitus või põhjendus.",
      "rdfs:label": {
        "@value": "VKS_Par_8 (redaktsioon 780241)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "780241",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_8_v865043"
      },
      "estleg:versionValidTo": {
        "@value": "2005-03-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/780241",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_8_v865043",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõuded autobensiinile, diislikütusele, kergele kütteõlile ja raskele kütteõlile, välja arvatud põlevkivikütteõli, kehtestab majandus- ja kommunikatsiooniminister määrusega. Nõuded kehtestatakse, lähtudes kütuse kasutamise otstarbest ja keskkonnanõuetest. (2) Nõuetele mittevastava, käesoleva paragrahvi lõikes 1 nimetatud kütuse käitlemine on keelatud, kui käesolev seadus ei sätesta teisiti. Kütuse vastavuse eest nõuetele vastutab kütuse käitleja. (3) Autobensiinidest võib tarbimisse lubada ja müüa ainult pliivaba bensiini. Pliivabaks bensiiniks käesoleva seaduse mõistes loetakse bensiini, mille pliisisaldus ei ületa 0,013 grammi liitri kohta. (4) Majandus- ja kommunikatsiooniministril on õigus lubada sportsõidukites kasutamiseks ettenähtud nõuetele mittevastava spetsiifiliste omadustega kütuse piiratud koguses tarbimisse lubamist vastava spordiliidu taotlusel. (5) Käesoleva paragrahvi lõikes 4 nimetatud loa taotluses peavad olema järgmised andmed: spordiliidu nimetus, registrikood, asukoha aadress ja kontaktandmed; kütuse nimetus, KN-i kaubakood, kütuse kogus; selle äriühingu nimi, kes kütuse tarbimisse lubab; taotluse vajaduse selgitus või põhjendus.",
      "rdfs:label": {
        "@value": "VKS_Par_8 (redaktsioon 865043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "865043",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_8_v965588"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/865043",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
