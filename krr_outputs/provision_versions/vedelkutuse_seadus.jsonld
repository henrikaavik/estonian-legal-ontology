    {
      "@id": "estleg:VKS_Par_20_v129062014089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatud nõuete täitmise üle teostavad riiklikku järelevalvet vastavalt oma pädevusele: Konkurentsiamet; Maksu- ja Tolliamet; Tarbijakaitseamet. (2) Konkurentsiameti pädevusse kuulub: registriandmete kontroll; kütuse ja kütuse käitlemise nõuetele vastavuse kontrollimine; nõuetele mittevastava kütusega tehtavate toimingute heakskiitmine. (3) Maksu- ja Tolliameti pädevusse kuulub: tegevusloa olemasolu kontrollimine kütuse käitlemisel; kütuse nõuetele vastavuse ja nõuetele vastavust tõendavate dokumentide kontrollimine kütuse käitlemisel; kütuse käitlemise aruannete töötlemine; nõuetele mittevastava kütusega tehtavate toimingute heakskiitmine. (4) Tarbijakaitseameti pädevusse kütuse müügil kuulub: registreeringu olemasolu kontrollimine; kütuse ja kütuse käitlemise nõuetele vastavuse kontrollimine; nõuetele mittevastava kütusega tehtavate toimingute heakskiitmine.",
      "rdfs:label": {
        "@value": "VKS_Par_20 (redaktsioon 129062014089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014089",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_20_v120022015007"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-01",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014089",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 20",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_20_v120022015007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_20"
