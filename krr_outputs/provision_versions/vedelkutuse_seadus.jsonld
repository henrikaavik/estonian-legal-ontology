    {
      "@id": "estleg:VKS_Par_19_v261461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriühingul on lubatud tegeleda kütuse impordi, ekspordi ja müügiga ning hoiuteenuse osutamisega vaid registreeritud tegevuskoha kaudu. (2) Tegevuskoht käesoleva paragrahvi lõikes 1 nimetatud tegevusteks on: aktsiisi-, tolli- või muu ladu; tankla (kütuse müügil); äriühingu poolt määratletud muu tegevuskoht.",
      "rdfs:label": {
        "@value": "VKS_Par_19 (redaktsioon 261461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261461",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_19_v780241"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/261461",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_19_v780241",
      "@type": [
        "owl:NamedIndividual",
