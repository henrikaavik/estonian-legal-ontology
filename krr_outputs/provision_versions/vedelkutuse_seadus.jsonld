      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2003. aasta 1. juulil. (2) Käesoleva seaduse § 8 lõiked 4 ja 5, § 9 lõige 7 ning § 36 lõige 3 jõustuvad seaduse Riigi Teatajas avaldamise päeval.",
      "rdfs:label": {
        "@value": "VKS_Par_37 (redaktsioon 261461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261461",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/261461",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 37",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_4_v261461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tanklas peab olema nähtavale kohale välja pandud teave, millest nähtub: kütuse nimetus; kütuse hind; müüja ärinimi, registrikood, registreeringu number, asukoha aadress ja kontakttelefoni number; kütuse kasutamise otstarbest tulenev muu oluline teave. (2) Müüja on kohustatud ostja nõudmisel tagama selgituste andmise müügil oleva kütuse ja selle omaduste kohta. Müügikohas, kus kohapeal puudub teenindav personal (automaattanklas), peab väljas olema teave selgituste saamise koha kohta ning infotelefoni number. (3) Müüja peab järelevalveasutuse nõudmisel esitama dokumendid, mis tõendavad müügil oleva kütuse vastavust kehtestatud nõuetele ja kütuselisandite olemasolu kütuses, ning andma asjasse puutuvaid selgitusi. (4) Kütuse müügil, välja arvatud tanklast müügi korral, tuleb kütuse eest tasuda sularahata arvelduse korras. (5) Müüja peab tagama käesoleva paragrahvi lõigetes 1–3 nimetatud teabe kättesaadavuse tarbijale ka siis, kui kütuse müük toimub väljaspool tanklat.",
      "rdfs:label": {
        "@value": "VKS_Par_4 (redaktsioon 261461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261461",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_4_v780241"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/261461",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_4_v780241",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tanklas peab olema nähtavale kohale välja pandud teave, millest nähtub: kütuse nimetus; kütuse hind; müüja ärinimi, registrikood, registreeringu number, asukoha aadress ja kontakttelefoni number; kütuse kasutamise otstarbest tulenev muu oluline teave. (2) Müüja on kohustatud ostja nõudmisel tagama selgituste andmise müügil oleva kütuse ja selle omaduste kohta. Müügikohas, kus kohapeal puudub teenindav personal (automaattanklas), peab väljas olema teave selgituste saamise koha kohta ning infotelefoni number. (3) Müüja peab järelevalveasutuse nõudmisel esitama dokumendid või andma asjasse puutuvaid selgitusi kütuselisandi ja sellele vastava tähistusega müüdava kütuse kohta . (4) Kütuse müügil, välja arvatud tanklast müügi korral, tuleb kütuse eest tasuda sularahata arvelduse korras. (5) Müüja peab tagama käesoleva paragrahvi lõigetes 1–3 nimetatud teabe kättesaadavuse tarbijale ka siis, kui kütuse müük toimub väljaspool tanklat. (6) Ühes tanklas võib kütust müüa ja müügitegevuseks vajalikku kütust ladustada ainult üks juriidiline isik.",
      "rdfs:label": {
        "@value": "VKS_Par_4 (redaktsioon 780241)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "780241",
