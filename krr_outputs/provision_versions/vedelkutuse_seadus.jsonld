      }
    },
    {
      "@id": "estleg:VKS_Par_7_1_v865043",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_7_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Majandus- ja Kommunikatsiooniministeerium teavitab Euroopa Komisjoni perioodiliselt kütuse hindadest. (2) Kütusemüüja on kohustatud andma Majandus- ja Kommunikatsiooniministeeriumi nõudel andmeid käesoleva paragrahvi lõikes 1 nimetatud teavitamiseks.",
      "rdfs:label": {
        "@value": "VKS_Par_7_1 (redaktsioon 865043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "865043",
