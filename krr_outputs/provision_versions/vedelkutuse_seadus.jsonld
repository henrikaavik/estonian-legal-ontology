        "@id": "estleg:VKS_Par_36_v103042018011"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116062017036",
