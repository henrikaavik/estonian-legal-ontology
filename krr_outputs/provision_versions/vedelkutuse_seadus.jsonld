      }
    },
    {
      "@id": "estleg:VKS_Par_27_v129062014089",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VKS_Par_27 (redaktsioon 129062014089)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014089",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014089",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_28_v261461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toimingud nõuetele mittevastava kütusega korraldatakse vastavalt kütuse valdaja või omaniku ettepanekutele, järgides käesolevas paragrahvis sätestatut. (2) Nõuetele mittevastava kütusega võib teha järgmisi toiminguid, kui see ei kahjusta inimese tervist, keskkonda ega vara: eksporti; ümbertöötlemist aktsiisilaos; hävitamist vastavalt jäätmeseaduse (RT I 1998, 57, 861; 88, õiend; 1999, 10, 155; 23, 353; 95, 843; 2001, 16, 72; 43, 1239; 50, 283; 56, 340; 93, 565; 2002, 61, 375; 63, 387) nõuetele; müüki keemiatööstusele tooraineks; järelevalveasutuse poolt aktsepteeritud muud toimingut. (3) Käesoleva paragrahvi lõike 2 punktides 1–2 nimetatud toimingute tegemiseks tuleb taotleda Tolliameti heakskiitu. Nõuetele mittevastava kütuse edasine käitleja peab Tolliametit mõistliku aja jooksul kirjalikult teavitama tehtud toimingu tulemustest. (4) Käesoleva paragrahvi lõike 2 punktides 3–5 nimetatud toimingute tegemiseks tuleb taotleda Energiaturu Inspektsiooni heakskiitu. Nõuetele mittevastava kütusega vastava toimingu tegija peab Energiaturu Inspektsiooni mõistliku aja jooksul kirjalikult teavitama tehtud toimingu tulemustest. (5) Nõuetele mittevastav kütus ladustatakse kuni sellega tehtava toimingu heakskiitmiseni käesoleva paragrahvi lõikes 3 või 4 nimetatud asutusega kooskõlastatud kohas. (6) Tolliamet ja Energiaturu Inspektsioon annavad nõuetele mittevastava kütusega toimingute tegemisele heakskiidu viie tööpäeva jooksul taotluse esitamise päevast arvates.",
      "rdfs:label": {
        "@value": "VKS_Par_28 (redaktsioon 261461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261461",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_28_v693774"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/261461",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_28_v693774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toimingud nõuetele mittevastava kütusega korraldatakse vastavalt kütuse valdaja või omaniku ettepanekutele, järgides käesolevas paragrahvis sätestatut. (2) Nõuetele mittevastava kütusega võib teha järgmisi toiminguid, kui see ei kahjusta inimese tervist, keskkonda ega vara: eksporti; ümbertöötlemist aktsiisilaos; hävitamist vastavalt jäätmeseaduse (RT I 1998, 57, 861; 88, õiend; 1999, 10, 155; 23, 353; 95, 843; 2001, 16, 72; 43, 1239; 50, 283; 56, 340; 93, 565; 2002, 61, 375; 63, 387) nõuetele; müüki keemiatööstusele tooraineks; järelevalveasutuse poolt aktsepteeritud muud toimingut. (3) Käesoleva paragrahvi lõike 2 punktides 1–2 nimetatud toimingute tegemiseks tuleb taotleda Maksu- ja Tolliameti heakskiitu. Nõuetele mittevastava kütuse edasine käitleja peab Maksu- ja Tolliametit mõistliku aja jooksul kirjalikult teavitama tehtud toimingu tulemustest. (4) Käesoleva paragrahvi lõike 2 punktides 3–5 nimetatud toimingute tegemiseks tuleb taotleda Energiaturu Inspektsiooni heakskiitu. Nõuetele mittevastava kütusega vastava toimingu tegija peab Energiaturu Inspektsiooni mõistliku aja jooksul kirjalikult teavitama tehtud toimingu tulemustest. (5) Nõuetele mittevastav kütus ladustatakse kuni sellega tehtava toimingu heakskiitmiseni käesoleva paragrahvi lõikes 3 või 4 nimetatud asutusega kooskõlastatud kohas. (6) Maksu- ja Tolliamet ja Energiaturu Inspektsioon annavad nõuetele mittevastava kütusega toimingute tegemisele heakskiidu viie tööpäeva jooksul taotluse esitamise päevast arvates.",
      "rdfs:label": {
        "@value": "VKS_Par_28 (redaktsioon 693774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693774",
      "estleg:supersededByVersion": {
