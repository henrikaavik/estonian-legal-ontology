      },
      "estleg:versionValidTo": {
        "@value": "2004-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/693774",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_28_v780241",
      "@type": [
        "owl:NamedIndividual",
