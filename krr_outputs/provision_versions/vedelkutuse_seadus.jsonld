  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_vedelkutuse_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Vedelkütuse seadus (323 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vedelkütuse seadus"
    },
    {
      "@id": "estleg:VKS_Par_1_v261461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus sätestab kütuseaktsiisi laekumise ja enamkasutatavate mootorikütuste kvaliteedi tagamise eesmärgil vedelkütuse käitlemise alused ja korra, vastutuse käesoleva seaduse rikkumise eest ning riikliku järelevalve teostamise korralduse. (2) Vedelkütuse tootmisele kohaldatakse käesolevat seadust kütuseaktsiisi sätestavas seaduses ettenähtud erisustega. (3) Käesolev seadus ei reguleeri vedelkütuse käitlemisel kasutatavatele seadmetele, ehitistele ning mõõtevahenditele esitatavaid tehnilisi ja ohutusnõudeid. (4) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354; 2002, 53, 336; 61, 375) sätteid käesolevast seadusest tulenevate erisustega.",
      "rdfs:label": {
        "@value": "VKS_Par_1 (redaktsioon 261461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261461",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_1_v12895249"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/261461",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
