      "estleg:provisionRef": "VKS § 4_5",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
    {
      "@id": "estleg:VKS_Par_5_v261461",
      "@type": [
        "owl:NamedIndividual",
