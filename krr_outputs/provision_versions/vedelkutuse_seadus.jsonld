    },
    {
      "@id": "estleg:VKS_Par_27_v261461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riikliku järelevalve käigus on järelevalveasutuse pädeval ametiisikul õigus võtta kütuse valdaja või omaniku valduses olevast kütusest vajalikus koguses tasuta kütuseproove kütuse nõuetele vastavuse kontrollimiseks. (2) Kütuse nõuetele vastavuse kontrollimise kulud tasub järelevalveasutus. (3) Kui tuvastatakse, et kütus ei vasta kehtestatud nõuetele, peab isik, kelle valduses olevast kütusest proov võeti, järelevalveasutusele hüvitama käesoleva paragrahvi lõikes 2 nimetatud dokumentaalselt tõestatud kulud.",
      "rdfs:label": {
        "@value": "VKS_Par_27 (redaktsioon 261461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261461",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKS_Par_27_v729375"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/261461",
      "estleg:sourceAct": "Vedelkütuse seadus",
      "estleg:provisionRef": "VKS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:VKS_Map"
      }
    },
