      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Reg_1049859_Par_12 (redaktsioon 1049859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049859",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049859",
      "estleg:sourceAct": "Merel, Narva jõel ja Peipsi järvel ohtlike ning kahjulike ainete käitlemise kord ja nimistu ohtlikest ainetest, mida ei ole lubatud sisemerel transiidina vedada",
      "estleg:provisionRef": "Reg_1049859 § 12",
