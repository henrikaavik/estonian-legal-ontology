    {
      "@id": "estleg:Reg_1049859_Par_10_v1049859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049859_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käitlemine tuleb peatada ja vajaduse korral lõpetada, kui: 1 1) ilmastikuolud käitlemiskohas märgatavalt halvenevad; 2 2) käitlemise käigus ei ole signaalnuppu vajutatud 15-minutilise intervalliga või vette on sattunud ohtlikke või kahjulikke ained. Käitlemine tuleb peatada ja vajaduse korral lõpetada, kui: ilmastikuolud käitlemiskohas märgatavalt halvenevad; käitlemise käigus ei ole signaalnuppu vajutatud 15-minutilise intervalliga või vette on sattunud ohtlikke või kahjulikke ained. 2 (2) Laeva juhtkonna pädev liige peab olema instrueeritud ohuolukorra tekkimise korral käitlemise peatamiseks. Laeva juhtkonna pädev liige peab olema instrueeritud ohuolukorra tekkimise korral käitlemise peatamiseks. 3 (3) Käitlemise peatamisest ja lõpetamisest teavitatakse § 6 lõikes 1 nimetatud ametiasutusi vahetult peale käitlemise peatamist või lõpetamist. RT I 2021-08-25 1 125082021001 2021-08-28 Käitlemise peatamisest ja lõpetamisest teavitatakse § 6 lõikes 1 nimetatud ametiasutusi vahetult peale käitlemise peatamist või lõpetamist.",
      "rdfs:label": {
        "@value": "Reg_1049859_Par_10 (redaktsioon 1049859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049859",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049859",
      "estleg:sourceAct": "Merel, Narva jõel ja Peipsi järvel ohtlike ning kahjulike ainete käitlemise kord ja nimistu ohtlikest ainetest, mida ei ole lubatud sisemerel transiidina vedada",
      "estleg:provisionRef": "Reg_1049859 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049859_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049859_Par_11_v1049859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049859_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aset leidnud reostusjuhtumist on käitlemisel osaleva laeva kapten kohustatud kohe teavitama Politsei- ja Piirivalveametit, kes viivitamata edastab teabe Keskkonnaametile ning merel aset leidnud reostusjuhtumi korral ka Kaitseväele. RT I 2022-07-21 1 121072022001 2023-01-01 Aset leidnud reostusjuhtumist on käitlemisel osaleva laeva kapten kohustatud kohe teavitama Politsei- ja Piirivalveametit, kes viivitamata edastab teabe Keskkonnaametile ning merel aset leidnud reostusjuhtumi korral ka Kaitseväele.",
      "rdfs:label": {
        "@value": "Reg_1049859_Par_11 (redaktsioon 1049859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049859",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049859",
      "estleg:sourceAct": "Merel, Narva jõel ja Peipsi järvel ohtlike ning kahjulike ainete käitlemise kord ja nimistu ohtlikest ainetest, mida ei ole lubatud sisemerel transiidina vedada",
      "estleg:provisionRef": "Reg_1049859 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049859_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049859_Par_12_v1049859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
