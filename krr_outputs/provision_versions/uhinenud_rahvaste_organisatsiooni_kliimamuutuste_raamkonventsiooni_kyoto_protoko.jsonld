      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ühinenud Rahvaste Organisatsiooni kliimamuutuste raamkonventsiooni Kyoto protokolli ratifitseerimise seadus (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ühinenud Rahvaste Organisatsiooni kliimamuutuste raamkonventsiooni Kyoto protokolli ratifitseerimise seadus"
    },
    {
      "@id": "estleg:uhinenud_rahvaste_organisatsiooni_kliima_Par_1_v199096",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:uhinenud_rahvaste_organisatsiooni_kliima_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud , mis on vastu võetud 1997. aasta 11. detsembril Kyotos ja millele Eesti Vabariik on alla kirjutanud 1998. aasta 3. detsembril.",
      "rdfs:label": {
        "@value": "uhinenud_rahvaste_organisatsiooni_kliima_Par_1 (redaktsioon 199096)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "199096"
    },
    {
      "@id": "estleg:uhinenud_rahvaste_organisatsiooni_kliima_Par_2_v199096",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:uhinenud_rahvaste_organisatsiooni_kliima_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kyoto protokolli artiklites 6, 12 ja 17 sätestatu rakendamiseks on Vabariigi Valitsusel õigus sõlmida heitkoguste vähendamise ühikute üleandmise rahvusvahelisi lepinguid.",
      "rdfs:label": {
        "@value": "uhinenud_rahvaste_organisatsiooni_kliima_Par_2 (redaktsioon 199096)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "199096",
      "estleg:supersededByVersion": {
        "@id": "estleg:uhinenud_rahvaste_organisatsiooni_kliima_Par_2_v760682"
      },
      "estleg:versionValidTo": {
        "@value": "2004-09-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:uhinenud_rahvaste_organisatsiooni_kliima_Par_2_v760682",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:uhinenud_rahvaste_organisatsiooni_kliima_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kyoto protokolli artiklites 6, 12 ja 17 sätestatu rakendamiseks volitab Vabariigi Valitsus korraldusega valdkonna eest vastutavat ministrit sõlmima heitkoguste vähendamise ühikute üleandmise rahvusvahelisi lepinguid. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"keskkonnaministrit\" sõnadega \"valdkonna eest vastutavat ministrit\".",
      "rdfs:label": {
        "@value": "uhinenud_rahvaste_organisatsiooni_kliima_Par_2 (redaktsioon 760682)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "760682"
    }
  ]
}
