      "estleg:provisionRef": "Reg_1056496 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056496_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056496_Par_13_v1056496",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
