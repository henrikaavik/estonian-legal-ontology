      }
    },
    {
      "@id": "estleg:Reg_1051772_Par_11_v1051772",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051772_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Turismiteenuste pakkuja toetust võib taotleda juriidilisest isikust turismiteenuste pakkuja, kes on perioodil 1. jaanuar 2020. a kuni 28. veebruar 2021. a tasunud tööjõumakse vähemalt summas 3000 eurot. Turismiteenuste pakkuja toetust võib taotleda juriidilisest isikust turismiteenuste pakkuja, kes on perioodil 1. jaanuar 2020. a kuni 28. veebruar 2021. a tasunud tööjõumakse vähemalt summas 3000 eurot. 2 (2) Füüsilisest isikust ettevõtja võib turismiteenuste pakkuja toetust taotleda, kui ta on teinud 2021. aasta I kvartalis avansilise sotsiaalmaksu makse. Füüsilisest isikust ettevõtja võib turismiteenuste pakkuja toetust taotleda, kui ta on teinud 2021. aasta I kvartalis avansilise sotsiaalmaksu makse. 3 (3) Lõikes 1 nimetatud turismiteenuste pakkuja toetuse suurus on 7500 eurot. RT I 2021-05-08 1 108052021001 2021-05-11 Lõikes 1 nimetatud turismiteenuste pakkuja toetuse suurus on 7500 eurot. 4 (4) Lõikes 2 nimetatud turismiteenuste pakkuja toetuse suurus on 2000 eurot. RT I 2021-05-08 1 108052021001 2021-05-11 Lõikes 2 nimetatud turismiteenuste pakkuja toetuse suurus on 2000 eurot.",
      "rdfs:label": {
        "@value": "Reg_1051772_Par_11 (redaktsioon 1051772)",
        "@language": "et"
      },
