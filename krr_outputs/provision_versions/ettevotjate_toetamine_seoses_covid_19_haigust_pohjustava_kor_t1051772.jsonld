      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051772_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse taotlusi menetleb, väljamakseid teeb ja järelevalvet teostab Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi EIS). RT I 2021-12-29 2 129122021002 2022-01-01 Toetuse taotlusi menetleb, väljamakseid teeb ja järelevalvet teostab Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi EIS).",
      "rdfs:label": {
        "@value": "Reg_1051772_Par_3 (redaktsioon 1051772)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051772",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051772",
      "estleg:sourceAct": "Ettevõtjate toetamine seoses COVID-19 haigust põhjustava koroonaviiruse levikust tulenevate piirangutega",
      "estleg:provisionRef": "Reg_1051772 § 3",
