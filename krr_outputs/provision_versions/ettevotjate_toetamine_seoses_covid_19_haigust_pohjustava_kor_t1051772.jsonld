        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andmise eesmärk on §-s 4 määratletud ettevõtjate toetamine seoses COVID-19 haigust põhjustava koroonaviiruse levikust tulenevate piirangutega. Toetuse andmise eesmärk on §-s 4 määratletud ettevõtjate toetamine seoses COVID-19 haigust põhjustava koroonaviiruse levikust tulenevate piirangutega.",
      "rdfs:label": {
        "@value": "Reg_1051772_Par_2 (redaktsioon 1051772)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051772",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051772",
      "estleg:sourceAct": "Ettevõtjate toetamine seoses COVID-19 haigust põhjustava koroonaviiruse levikust tulenevate piirangutega",
