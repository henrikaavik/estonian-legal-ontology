      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Loomkatse raskusastmete määratlused ja loomkatse liigitamise täpsemad nõuded raskusastmete järgi ning katselooma hukkamise nõuded ja hukkamise meetodid (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Loomkatse raskusastmete määratlused ja loomkatse liigitamise täpsemad nõuded raskusastmete järgi ning katselooma hukkamise nõuded ja hukkamise meetodid"
    },
    {
      "@id": "estleg:Reg_1009063_Par_1_v1009063",
      "@type": [
