      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Meetme „Linnaliste piirkondade arendamine“ tingimused ja investeeringute kava koostamise kord (27 versiooni)",
        "@language": "et"
      },
      "dc:source": "Meetme „Linnaliste piirkondade arendamine“ tingimused ja investeeringute kava koostamise kord"
    },
    {
      "@id": "estleg:Reg_321395_Par_1_v321395",
      "@type": [
