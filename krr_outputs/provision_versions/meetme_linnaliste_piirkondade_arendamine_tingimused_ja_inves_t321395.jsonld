    {
      "@id": "estleg:Reg_321395_Par_4_v321395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_321395_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meetme eesmärkideks on: 1 1) avaliku linnalise ruumi arendamine; 2 2) linnaspetsiifiliste probleemide lahendamine; 3 3) keskuste ja tagamaa parem funktsionaalne sidustamine. Meetme eesmärkideks on: avaliku linnalise ruumi arendamine; linnaspetsiifiliste probleemide lahendamine; keskuste ja tagamaa parem funktsionaalne sidustamine.",
      "rdfs:label": {
        "@value": "Reg_321395_Par_4 (redaktsioon 321395)",
        "@language": "et"
      },
