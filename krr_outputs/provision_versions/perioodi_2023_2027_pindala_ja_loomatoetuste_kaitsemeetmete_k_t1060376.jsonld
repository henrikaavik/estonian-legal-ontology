    {
      "@id": "estleg:Reg_1060376_Par_2_v1060376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060376_Par_2"
