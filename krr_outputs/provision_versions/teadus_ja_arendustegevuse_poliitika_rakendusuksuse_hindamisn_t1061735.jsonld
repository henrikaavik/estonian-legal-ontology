      "dc:source": "Teadus- ja arendustegevuse poliitika rakendusüksuse hindamisnõukogu moodustamise kord ja töökord"
    },
    {
      "@id": "estleg:Reg_1061735_Par_1_v1061735",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
