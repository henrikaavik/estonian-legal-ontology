      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ostjariigi võla konsolideerimisel peavad põhiline eksporditagatise andja ja teised eksporditagatise andjad läbirääkimisi eesmärgiga leida võimalused ja vahendid konsolideerimislepingust tulenevate eriprobleemide lahendamiseks. Ostjariigi võla konsolideerimisel peavad põhiline eksporditagatise andja ja teised eksporditagatise andjad läbirääkimisi eesmärgiga leida võimalused ja vahendid konsolideerimislepingust tulenevate eriprobleemide lahendamiseks.",
      "rdfs:label": {
        "@value": "Reg_1024578_Par_5 (redaktsioon 1024578)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024578",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024578",
