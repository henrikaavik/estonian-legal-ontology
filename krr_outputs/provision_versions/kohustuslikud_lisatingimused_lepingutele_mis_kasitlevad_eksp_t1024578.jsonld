      "estleg:provisionRef": "Reg_1024578 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024578_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024578_Par_5_v1024578",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
