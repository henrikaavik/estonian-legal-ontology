      "estleg:provisionRef": "Reg_1024578 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024578_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024578_Par_6_v1024578",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024578_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Liidu eksporditagatise andjad, kes on ühisel arvamusel, et nende ostjakrediidi tingimused on piisavalt sarnased, võivad kokku leppida, et kogu eksporditehingu jaoks antakse ühine ostjakrediit. Euroopa Liidu eksporditagatise andjad, kes on ühisel arvamusel, et nende ostjakrediidi tingimused on piisavalt sarnased, võivad kokku leppida, et kogu eksporditehingu jaoks antakse ühine ostjakrediit.",
