    {
      "@id": "estleg:Reg_1050754_Par_2_v1050754",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050754_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti asukoht on Tallinn. Ameti mujal asuvate struktuuriüksuste ja esinduste asukohad ning postiaadressid määrab ameti peadirektor. RT I 2021-06-17 1 117062021001 2021-07-01 Ameti asukoht on Tallinn. Ameti mujal asuvate struktuuriüksuste ja esinduste asukohad ning postiaadressid määrab ameti peadirektor.",
      "rdfs:label": {
        "@value": "Reg_1050754_Par_2 (redaktsioon 1050754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050754",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050754",
      "estleg:sourceAct": "Transpordiameti põhimäärus",
      "estleg:provisionRef": "Reg_1050754 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050754_Map"
      }
    },
    {
      "@id": "estleg:Reg_1050754_Par_3_v1050754",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050754_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti tegevusvaldkond on inimeste ning vee-, õhu- ja maismaasõidukite liikuvuse kavandamine ning ohutu ja keskkonda säästva taristu tagamine. Ameti tegevusvaldkond on inimeste ning vee-, õhu- ja maismaasõidukite liikuvuse kavandamine ning ohutu ja keskkonda säästva taristu tagamine.",
      "rdfs:label": {
        "@value": "Reg_1050754_Par_3 (redaktsioon 1050754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050754",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050754",
      "estleg:sourceAct": "Transpordiameti põhimäärus",
      "estleg:provisionRef": "Reg_1050754 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050754_Map"
      }
    },
    {
      "@id": "estleg:Reg_1050754_Par_4_v1050754",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050754_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti ülesanded on: 1 1) tingimuste loomine ohutuks, ligipääsetavaks ja säästlikuks liiklemiseks ning inimeste ja sõidukite liikuvuse kavandamine; RT I 2021-06-17 1 117062021001 2021-07-01 2 2) tingimuste loomine ohutu ja jätkusuutliku lennundustegevuse tagamiseks Eesti õhuruumis liiklejatele; 3 3) liikluskasvatuse korraldamine; 4 4) liikluse korraldamine; RT I 2023-07-05 7 105072023007 2023-07-08 5 5) õigusaktidest tulenevate andmekogude pidamine; 6 6) osalemine oma tegevusvaldkonnaga seotud poliitika väljatöötamisel ning rahvusvaheliste projektide ettevalmistamisel ja läbiviimisel; 7 7) riigi esindamine rahvusvahelises suhtluses ameti tegevusvaldkonna piires; 8 8) Eesti teede ajaloo, tehnika ja tehnoloogia ning liikluse arengut kajastava materjali kogumine, uurimine, säilitamine, korrastamine ja avalikkusele tutvustamine teaduslikel, hariduslikel ja kultuurilistel eesmärkidel; 8 8¹) riikliku ja haldusjärelevalve teostamine õigusaktides sätestatud juhtudel ja korras; RT I 2023-03-21 1 121032023001 2023-05-01 8 8²) seaduses sätestatud alustel ja ulatuses riikliku sunni rakendamine ning väärtegude menetlemine; RT I 2023-03-21 1 121032023001 2023-05-01 8 8³) ameti pädevusse kuuluvate rahvusvaheliste sanktsioonide rakendamine; RT I 2023-03-21 1 121032023001 2023-05-01 9 9) muud õigusakti alusel ametile antud ülesanded. Ameti ülesanded on: tingimuste loomine ohutuks, ligipääsetavaks ja säästlikuks liiklemiseks ning inimeste ja sõidukite liikuvuse kavandamine; tingimuste loomine ohutu ja jätkusuutliku lennundustegevuse tagamiseks Eesti õhuruumis liiklejatele; liikluskasvatuse korraldamine; liikluse korraldamine; õigusaktidest tulenevate andmekogude pidamine; osalemine oma tegevusvaldkonnaga seotud poliitika väljatöötamisel ning rahvusvaheliste projektide ettevalmistamisel ja läbiviimisel; riigi esindamine rahvusvahelises suhtluses ameti tegevusvaldkonna piires; Eesti teede ajaloo, tehnika ja tehnoloogia ning liikluse arengut kajastava materjali kogumine, uurimine, säilitamine, korrastamine ja avalikkusele tutvustamine teaduslikel, hariduslikel ja kultuurilistel eesmärkidel; riikliku ja haldusjärelevalve teostamine õigusaktides sätestatud juhtudel ja korras; seaduses sätestatud alustel ja ulatuses riikliku sunni rakendamine ning väärtegude menetlemine; ameti pädevusse kuuluvate rahvusvaheliste sanktsioonide rakendamine; muud õigusakti alusel ametile antud ülesanded.",
      "rdfs:label": {
        "@value": "Reg_1050754_Par_4 (redaktsioon 1050754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050754",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050754",
      "estleg:sourceAct": "Transpordiameti põhimäärus",
      "estleg:provisionRef": "Reg_1050754 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050754_Map"
      }
    },
    {
      "@id": "estleg:Reg_1050754_Par_5_v1050754",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050754_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametit juhib peadirektor. Ametit juhib peadirektor. 2 (2) Peadirektorile alluvad kuus direktorit, riskijuhtimise osakonna juhataja ja Eesti Maanteemuuseumi juhataja. RT I 2023-03-21 1 121032023001 2023-05-01 Peadirektorile alluvad kuus direktorit, riskijuhtimise osakonna juhataja ja Eesti Maanteemuuseumi juhataja.",
      "rdfs:label": {
