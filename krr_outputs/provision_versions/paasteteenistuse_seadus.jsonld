      }
    },
    {
      "@id": "estleg:PaasteTS_Par_20_1_v126032013014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeasutus võib päästeteenistujalt nõuda teenistusülesannete täitmist väljaspool tööaega, kui teenistusülesanded tulenevad erakorralistest asjaoludest ja need tuleb täita viivitamata (edaspidi erakorraline ületunnitöö). Summeeritud tööaja arvestuse korral on erakorraline ületunnitöö tööaega ületav teenistusülesannete täitmine arvestusperioodi lõpul. (2) Ületunnitöö tegemist ei tohi nõuda päästeteenistujalt, kes on rase või kellel on õigus saada rasedus- ja sünnituspuhkust. (3) Ametiasutus hüvitab ületunnitöö, makstes ametnikule 1,5-kordset palka või võimaldades ametniku taotlusel talle täiendavat vaba aega ületunnitööga võrdses ulatuses.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_20_1 (redaktsioon 126032013014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013014",
      "estleg:supersededByVersion": {
        "@id": "estleg:PaasteTS_Par_20_1_v119032015007"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126032013014",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 20_1",
      "estleg:partOfAct": {
        "@id": "estleg:PaasteTS_Map"
      }
    },
    {
      "@id": "estleg:PaasteTS_Par_20_1_v119032015007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeasutus võib päästeteenistujalt nõuda ilma tema nõusolekuta teenistusülesande täitmist väljaspool tööaega, sealhulgas puhkepäeval ja riigipühal, kui teenistusülesanne tuleneb erakorralisest asjaolust ja see tuleb täita viivitamata (edaspidi erakorraline ületunnitöö). Summeeritud tööaja arvestuse korral on erakorraline ületunnitöö tööaega ületav teenistusülesannete täitmine arvestusperioodi lõpul. (2) Ületunnitöö tegemist ei tohi nõuda päästeteenistujalt, kes on rase või kellel on õigus saada rasedus- ja sünnituspuhkust. (3) Päästeasutus hüvitab ületunnitöö, makstes päästeteenistujale 1,5-kordset põhipalka või võimaldades päästeteenistuja taotlusel talle täiendavat vaba aega ületunnitööga võrdses ulatuses.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_20_1 (redaktsioon 119032015007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015007",
      "estleg:supersededByVersion": {
        "@id": "estleg:PaasteTS_Par_20_1_v106072017007"
      },
      "estleg:versionValidTo": {
