      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13321153",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 4",
      "estleg:partOfAct": {
