      "estleg:provisionRef": "PäästeTS § 7_2",
      "estleg:partOfAct": {
        "@id": "estleg:PaasteTS_Map"
      }
    },
    {
      "@id": "estleg:PaasteTS_Par_7_2_v106072023069",
