    {
      "@id": "estleg:PaasteTS_Par_20_1_v13124871",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Päästeasutus võib päästeteenistujalt nõuda teenistusülesannete täitmist väljaspool tööaega, kui teenistusülesanded tulenevad erakorralistest asjaoludest ja need tuleb täita viivitamata (edaspidi erakorraline ületunnitöö ). Summeeritud tööaja arvestuse korral on erakorraline ületunnitöö tööaega ületav teenistusülesannete täitmine arvestusperioodi lõpul.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_20_1 (redaktsioon 13124871)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13124871",
      "estleg:supersededByVersion": {
        "@id": "estleg:PaasteTS_Par_20_1_v13325132"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13124871",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 20_1",
      "estleg:partOfAct": {
        "@id": "estleg:PaasteTS_Map"
      }
    },
    {
      "@id": "estleg:PaasteTS_Par_20_1_v13325132",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_20_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Päästeasutus võib päästeteenistujalt nõuda teenistusülesannete täitmist väljaspool tööaega, kui teenistusülesanded tulenevad erakorralistest asjaoludest ja need tuleb täita viivitamata (edaspidi erakorraline ületunnitöö). Summeeritud tööaja arvestuse korral on erakorraline ületunnitöö tööaega ületav teenistusülesannete täitmine arvestusperioodi lõpul.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_20_1 (redaktsioon 13325132)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13325132",
