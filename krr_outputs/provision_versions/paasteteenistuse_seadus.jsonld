    {
      "@id": "estleg:PaasteTS_Par_17_1_v106072017007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_17_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeteenistuja ametitõendi ja päästeametniku ametimärgi kirjelduse ja vormi kehtestab määrusega. (2) Loetelu ametikohtadest, millele nimetatud päästeteenistujale ametitõend või päästeametnikule ametimärk väljastatakse, kehtestab päästeasutuse juht käskkirjaga.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_17_1 (redaktsioon 106072017007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072017007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106072017007",
