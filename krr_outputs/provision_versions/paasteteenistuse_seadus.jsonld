      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13325132",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 2",
      "estleg:partOfAct": {
