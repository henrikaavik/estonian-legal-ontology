    },
    {
      "@id": "estleg:PaasteTS_Par_1_v12922387",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus sätestab päästeteenistuse korralduse ja päästeteenistujate õigusliku seisundi. (2) Päästeametnikele laieneb avaliku teenistuse seadus käesolevast seadusest tulenevate erisustega. (3) Päästetöötajatele laienevad töölepingu seadus ja muud tööseadused käesolevast seadusest tulenevate erisustega.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_1 (redaktsioon 12922387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12922387",
      "estleg:supersededByVersion": {
        "@id": "estleg:PaasteTS_Par_1_v13124871"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12922387",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:PaasteTS_Map"
      }
    },
    {
      "@id": "estleg:PaasteTS_Par_1_v13124871",
      "@type": [
