      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2008. aasta 1. märtsil.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_34 (redaktsioon 12922387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12922387",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12922387",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:PaasteTS_Map"
      }
    },
    {
      "@id": "estleg:PaasteTS_Par_4_v12922387",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeteenistujad on: päästeametnikud; päästetöötajad. (2) Päästeametnik on päästeasutuse või Päästekolledži koosseisus päästeseaduse §-s 3 sätestatud päästeala tööde juhtimiseks, korraldamiseks ja tegemiseks ettenähtud ametikohale nimetatud isik. (3) Päästetöötaja on päästeasutuse või Päästekolledži koosseisus päästeseaduse §-s 3 sätestatud päästetööde tegemiseks ettenähtud teenistuskohale töölepingu alusel võetud töötaja. (4) Päästeteenistusse võib võtta koosseisuväliseid päästeteenistujaid.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_4 (redaktsioon 12922387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12922387",
      "estleg:supersededByVersion": {
        "@id": "estleg:PaasteTS_Par_4_v13321153"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12922387",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:PaasteTS_Map"
      }
    },
    {
      "@id": "estleg:PaasteTS_Par_4_v13321153",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeteenistujad on: päästeametnikud; päästetöötajad. (2) Päästeametnik on: päästeasutuse koosseisus päästeseaduses sätestatud ülesannete juhtimiseks, korraldamiseks ja tegemiseks ettenähtud ametikohale nimetatud isik; Päästekolledži päästeeriala õppetööd korraldava struktuuriüksuse juht, struktuuriüksuse juhi asetäitja ning päästeeriala õppejõud ja pedagoogid. (3) Päästetöötaja on päästeasutuse või Päästekolledži koosseisus päästeseaduses sätestatud ülesannete tegemiseks ettenähtud teenistuskohale töölepingu alusel võetud töötaja. (4) Päästeteenistusse võib võtta koosseisuväliseid päästeteenistujaid.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_4 (redaktsioon 13321153)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13321153",
