      }
    },
    {
      "@id": "estleg:PaasteTS_Par_33_3_v119032015007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_33_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2013. aasta 1. aprilli täitunud päästeteenistuse staaži aasta eest saadaolevad kasutamata lisapuhkusepäevad aeguvad nelja aasta jooksul arvates 2013. aasta 1. aprillist. Aegumine peatub ajaks, kui päästeteenistuja kasutab rasedus- ja sünnituspuhkust, lapsendaja puhkust või lapsehoolduspuhkust, samuti kui päästeteenistuja on ajateenistuses või asendusteenistuses. Kasutamata ja aegumata lisapuhkusepäevad hüvitatakse teenistusest lahkumisel rahas.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_33_3 (redaktsioon 119032015007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032015007",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 33_3",
      "estleg:partOfAct": {
        "@id": "estleg:PaasteTS_Map"
      }
    },
    {
      "@id": "estleg:PaasteTS_Par_33_4_v127052022041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PaasteTS_Par_33_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2022. aasta 1. juulil teenistuses olev päästeasutuse juhi asetäitja, Päästeameti päästekeskuse juht ja Häirekeskuse keskuse juht loetakse ametisse nimetatuks kuni 2027. aasta 30. juunini.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_33_4 (redaktsioon 127052022041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127052022041",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127052022041",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 33_4",
      "estleg:partOfAct": {
        "@id": "estleg:PaasteTS_Map"
      }
    },
    {
      "@id": "estleg:PaasteTS_Par_34_v12922387",
