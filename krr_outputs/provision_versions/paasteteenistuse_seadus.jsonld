      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeteenistus käesoleva seaduse mõistes on töötamine päästeteenistujana päästeasutuses. (2) Päästeteenistus on ka teenistus päästeteenistuja ametikohal sisekaitselise rakenduskõrgkooli päästeeriala õppe struktuuriüksuses (edaspidi Päästekolledž). (3) Päästeteenistus on avaliku teenistuse eriliik.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_2 (redaktsioon 119032015007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032015007",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 2",
