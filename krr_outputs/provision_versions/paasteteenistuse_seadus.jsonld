        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13325132",
      "estleg:sourceAct": "Päästeteenistuse seadus",
      "estleg:provisionRef": "PäästeTS § 20_2",
      "estleg:partOfAct": {
