      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2010. aasta 1. maid ametisse nimetatud päästepeadirektor ja päästedirektor peavad vastama käesoleva seaduse § 7 lõikes 3 sätestatud nõudele 2015. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_33_1 (redaktsioon 13325132)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13325132",
