      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks avaliku teenistuse seaduses sätestatule on päästeametniku, sealhulgas päästeasutuse ametniku suhtes distsiplinaarmenetluse alustamise õigus ja distsiplinaarkaristuse määramise õigus siseministril.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_25_1 (redaktsioon 129122011207)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011207",
      "estleg:supersededByVersion": {
