        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 202 jõustub 2011. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "PäästeTS_Par_33_2 (redaktsioon 13325132)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13325132",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13325132",
