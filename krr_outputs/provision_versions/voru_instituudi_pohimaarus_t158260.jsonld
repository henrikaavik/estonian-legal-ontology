    {
      "@id": "estleg:Reg_158260_Par_13_v158260",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158260_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Instituudi korraldab ümber või lõpetab tegevuse Vabariigi Valitsus valdkonna eest vastutava ministri ettepanekul, kuulanud ära Teadus- ja Arendusnõukogu seisukoha. RT I 2014-12-09 17 109122014017 2015-01-01 Instituudi korraldab ümber või lõpetab tegevuse Vabariigi Valitsus valdkonna eest vastutava ministri ettepanekul, kuulanud ära Teadus- ja Arendusnõukogu seisukoha.",
      "rdfs:label": {
        "@value": "Reg_158260_Par_13 (redaktsioon 158260)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158260",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158260",
      "estleg:sourceAct": "Võru Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_158260 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158260_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158260_Par_2_v158260",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158260_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Instituut asub Võrus. Instituudi aadress on Tartu 48, 65609 Võru. Oma tegevuse otstarbekamaks korraldamiseks võib ta moodustada ka eraldi asuvaid struktuuriüksusi. Instituut asub Võrus. Instituudi aadress on Tartu 48, 65609 Võru. Oma tegevuse otstarbekamaks korraldamiseks võib ta moodustada ka eraldi asuvaid struktuuriüksusi. 2 (2) Instituudi tegevuspiirkonnaks on eelkõige ajalooline Võrumaa ja sellega seotud alad. Instituudi tegevuspiirkonnaks on eelkõige ajalooline Võrumaa ja sellega seotud alad.",
      "rdfs:label": {
        "@value": "Reg_158260_Par_2 (redaktsioon 158260)",
        "@language": "et"
      },
