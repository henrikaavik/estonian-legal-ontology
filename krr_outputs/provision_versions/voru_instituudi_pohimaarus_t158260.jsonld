        "@id": "estleg:Reg_158260_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158260_Par_3_v158260",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158260_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Instituudi tegevuse põhieesmärk on edendada teadus- ja arendustegevust Võrumaale eriomastes küsimustes. Instituudi tegevuse põhieesmärk on edendada teadus- ja arendustegevust Võrumaale eriomastes küsimustes.",
      "rdfs:label": {
        "@value": "Reg_158260_Par_3 (redaktsioon 158260)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158260",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158260",
      "estleg:sourceAct": "Võru Instituudi põhimäärus",
