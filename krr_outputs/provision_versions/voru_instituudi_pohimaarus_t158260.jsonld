    {
      "@id": "estleg:Reg_158260_Par_12_v158260",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158260_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Instituut peab finants- ja statistilist arvestust õigusaktidega kehtestatud korras. Instituut peab finants- ja statistilist arvestust õigusaktidega kehtestatud korras. 2 (2) Instituudile riigieelarvest eraldatud vahendite sihtotstarbelist kasutamist ning instituudi tegevuse vastavust põhimäärusest tulenevatele eesmärkidele kontrollitakse õigusaktidega sätestatud korras. Instituudile riigieelarvest eraldatud vahendite sihtotstarbelist kasutamist ning instituudi tegevuse vastavust põhimäärusest tulenevatele eesmärkidele kontrollitakse õigusaktidega sätestatud korras. 3 (3) Instituudi teadus- ja arendustegevust evalveeritakse vastavalt teadus- ja arendustegevuse korralduse seadusele. Instituudi teadus- ja arendustegevust evalveeritakse vastavalt teadus- ja arendustegevuse korralduse seadusele.",
      "rdfs:label": {
        "@value": "Reg_158260_Par_12 (redaktsioon 158260)",
        "@language": "et"
      },
