      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033377_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib riigieelarvest ühistranspordile eraldatavate toetuste vajaduse arvestust, omavalitsusüksuste ja maavalitsuste asjakohaste taotluste esitamist ja koondamist, riigieelarve eelnõusse asjakohaste sätete kavandamist ning riigieelarves ettenähtud toetuste kasutamise kontrollimist, samuti toetusraha tagasimaksmist. Määrus reguleerib riigieelarvest ühistranspordile eraldatavate toetuste vajaduse arvestust, omavalitsusüksuste ja maavalitsuste asjakohaste taotluste esitamist ja koondamist, riigieelarve eelnõusse asjakohaste sätete kavandamist ning riigieelarves ettenähtud toetuste kasutamise kontrollimist, samuti toetusraha tagasimaksmist.",
      "rdfs:label": {
        "@value": "Reg_1033377_Par_1 (redaktsioon 1033377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033377",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033377",
      "estleg:sourceAct": "Riigieelarvest ühistranspordi toetamise, toetusraha kasutamise aruandluse ja toetusraha tagasimaksmise kord",
      "estleg:provisionRef": "Reg_1033377 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033377_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033377_Par_10_v1033377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033377_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse saaja maksab toetusraha täielikult või osaliselt tagasi või toetusraha tasaarveldatakse järgmistel perioodidel avaliku teenindamise lepingu alusel tasumisele kuuluva toetusrahaga toetuse eraldanud asutuse või seaduses nimetatud muu pädeva asutuse haldusakti alusel. Toetuse saaja maksab toetusraha täielikult või osaliselt tagasi või toetusraha tasaarveldatakse järgmistel perioodidel avaliku teenindamise lepingu alusel tasumisele kuuluva toetusrahaga toetuse eraldanud asutuse või seaduses nimetatud muu pädeva asutuse haldusakti alusel. 2 (2) Käesoleva paragrahvi lõikes 1 nimetatud haldusaktis sätestatakse ühistranspordiseaduse § 29 lõikes 1 nimetatud toetusraha tagasimaksmise või tasaarveldamise alus, tagasimakstava või tasaarveldatava toetusraha summa, tagasimaksmise tähtaeg ja muud olulised asjassepuutuvad tingimused. Käesoleva paragrahvi lõikes 1 nimetatud haldusaktis sätestatakse ühistranspordiseaduse § 29 lõikes 1 nimetatud toetusraha tagasimaksmise või tasaarveldamise alus, tagasimakstava või tasaarveldatava toetusraha summa, tagasimaksmise tähtaeg ja muud olulised asjassepuutuvad tingimused.",
      "rdfs:label": {
        "@value": "Reg_1033377_Par_10 (redaktsioon 1033377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033377",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033377",
      "estleg:sourceAct": "Riigieelarvest ühistranspordi toetamise, toetusraha kasutamise aruandluse ja toetusraha tagasimaksmise kord",
      "estleg:provisionRef": "Reg_1033377 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033377_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033377_Par_2_v1033377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033377_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Bussiliikluses sõlmitava maakonnaliini avaliku teenindamise lepingu eelnõu kooskõlastatakse Maanteeametiga enne riigihanke väljakuulutamist või konkursi korraldamist. Bussiliikluses sõlmitava maakonnaliini avaliku teenindamise lepingu eelnõu kooskõlastatakse Maanteeametiga enne riigihanke väljakuulutamist või konkursi korraldamist. 2 (2) Laeva-, väikelaeva- ja parvlaevaliikluses ning raudtee- ja lennuliikluses sõlmitava avaliku teenindamise lepingu eelnõu kooskõlastatakse enne riigihanke väljakuulutamist või konkursi korraldamist asjaomaste maavalitsustega. Laeva-, väikelaeva- ja parvlaevaliikluses ning raudtee- ja lennuliikluses sõlmitava avaliku teenindamise lepingu eelnõu kooskõlastatakse enne riigihanke väljakuulutamist või konkursi korraldamist asjaomaste maavalitsustega. 3 (3) Avaliku teenindamise leping ja selle alusel koostatav aruanne peavad olema elektrooniliselt kättesaadavad avaliku teenindamise lepingu sõlminud asutuse või valdkonnaga tegeleva asutuse kodulehel. Avaliku teenindamise leping ja selle alusel koostatav aruanne peavad olema elektrooniliselt kättesaadavad avaliku teenindamise lepingu sõlminud asutuse või valdkonnaga tegeleva asutuse kodulehel.",
      "rdfs:label": {
        "@value": "Reg_1033377_Par_2 (redaktsioon 1033377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033377",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033377",
      "estleg:sourceAct": "Riigieelarvest ühistranspordi toetamise, toetusraha kasutamise aruandluse ja toetusraha tagasimaksmise kord",
      "estleg:provisionRef": "Reg_1033377 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033377_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033377_Par_3_v1033377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033377_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vedaja esitab toetuse saamiseks avaliku teenindamise lepingu teisele poolele avaliku teenindamise lepingu tingimuste kohase põhjendatud taotluse või käesoleva määruse § 4 lõike 1 kohase taotluse, kui avaliku teenindamise lepingus taotluse nõudeid piisava täpsusega ei sätestata. Vedaja esitab toetuse saamiseks avaliku teenindamise lepingu teisele poolele avaliku teenindamise lepingu tingimuste kohase põhjendatud taotluse või käesoleva määruse § 4 lõike 1 kohase taotluse, kui avaliku teenindamise lepingus taotluse nõudeid piisava täpsusega ei sätestata. 2 (2) Omavalitsusüksus esitab toetuse taotluse maavalitsusele bussi-, trammi- või trollibussiliikluses, samuti laeva-, väikelaeva- ja parvlaevaliikluses valla- või linnasisese veo toetamiseks hiljemalt toetuse kasutamisele eelneva aasta 1. novembriks. Omavalitsusüksus esitab toetuse taotluse maavalitsusele bussi-, trammi- või trollibussiliikluses, samuti laeva-, väikelaeva- ja parvlaevaliikluses valla- või linnasisese veo toetamiseks hiljemalt toetuse kasutamisele eelneva aasta 1. novembriks. 3 (3) Maavalitsus hindab taotluste põhjendatust, koondab taotlused ja esitab need koos oma arvamusega: 1 1) Maanteeametile bussi-, trammi- ja trollibussiliikluses veo toetamiseks hiljemalt toetuse kasutamisele eelneva aasta 10. novembriks ja teise poolaasta toetuse kasutamise täpsustamise vajaduse korral hiljemalt 10. maiks; 2 2) Majandus- ja Kommunikatsiooniministeeriumile laeva-, väikelaeva- ja parvlaevaliikluses ning lennuliikluses veo toetamiseks hiljemalt toetuse kasutamisele eelneva aasta 10. novembriks. Maavalitsus hindab taotluste põhjendatust, koondab taotlused ja esitab need koos oma arvamusega: Maanteeametile bussi-, trammi- ja trollibussiliikluses veo toetamiseks hiljemalt toetuse kasutamisele eelneva aasta 10. novembriks ja teise poolaasta toetuse kasutamise täpsustamise vajaduse korral hiljemalt 10. maiks; Majandus- ja Kommunikatsiooniministeeriumile laeva-, väikelaeva- ja parvlaevaliikluses ning lennuliikluses veo toetamiseks hiljemalt toetuse kasutamisele eelneva aasta 10. novembriks. 4 (4) Maanteeamet hindab taotluste põhjendatust, koondab taotlused ning esitab need koos oma arvamusega Majandus- ja Kommunikatsiooniministeeriumile hiljemalt toetuse kasutamisele eelneva aasta 15. detsembriks ja teise poolaasta toetuse kasutamise täpsustamise vajaduse korral hiljemalt 15. juuniks. Maanteeamet hindab taotluste põhjendatust, koondab taotlused ning esitab need koos oma arvamusega Majandus- ja Kommunikatsiooniministeeriumile hiljemalt toetuse kasutamisele eelneva aasta 15. detsembriks ja teise poolaasta toetuse kasutamise täpsustamise vajaduse korral hiljemalt 15. juuniks. 5 (5) Käesoleva paragrahvi lõigetes 1–4 nimetamata ajal esitatakse taotlus sõidunõudluse olulise muutumise või veo katkemise ohu korral. Käesoleva paragrahvi lõigetes 1–4 nimetamata ajal esitatakse taotlus sõidunõudluse olulise muutumise või veo katkemise ohu korral.",
      "rdfs:label": {
        "@value": "Reg_1033377_Par_3 (redaktsioon 1033377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033377",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033377",
      "estleg:sourceAct": "Riigieelarvest ühistranspordi toetamise, toetusraha kasutamise aruandluse ja toetusraha tagasimaksmise kord",
      "estleg:provisionRef": "Reg_1033377 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033377_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033377_Par_4_v1033377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033377_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vedaja esitab toetuse saamiseks käesoleva määruse lisade 1, 4, 5 ja 9 kohased taotlused, lisades nendele seletuskirja kulude ja tulude kavandatavate muudatuste kohta ning ülevaate piletitulust ja omavalitsusüksuste toetustest asjaomasel perioodil liinide kaupa. Vedaja esitab toetuse saamiseks käesoleva määruse lisade 1, 4, 5 ja 9 kohased taotlused, lisades nendele seletuskirja kulude ja tulude kavandatavate muudatuste kohta ning ülevaate piletitulust ja omavalitsusüksuste toetustest asjaomasel perioodil liinide kaupa. 2 (2) Omavalitsusüksuse, maavalitsuse või Maanteeameti esitatav toetuse taotlus koosneb tabelist, mis peab avaliku teenindamise lepingute lõikes ja koondina sisaldama andmeid taotluse esitamise ajal kehtivate ja kavandatavate lepingute kohta vähemalt järgmiste näitajate osas: 1 1) liinitöömaht; 2 2) avaliku teenindamise lepingu alusel teostatava liiniveo (edaspidi avalik liinivedu) kulude arvestus; 3 3) piletitulu; 4 4) kohaliku omavalitsusüksuse eelarvest makstav toetus; 5 5) riigieelarve sihtotstarbelise toetuse vajaduse arvestus; 6 6) avaliku liiniveo kulude ja vajaliku kasumi katmise muud allikad lisaks käesoleva lõike punktides 3–5 nimetatutele. Omavalitsusüksuse, maavalitsuse või Maanteeameti esitatav toetuse taotlus koosneb tabelist, mis peab avaliku teenindamise lepingute lõikes ja koondina sisaldama andmeid taotluse esitamise ajal kehtivate ja kavandatavate lepingute kohta vähemalt järgmiste näitajate osas: liinitöömaht; avaliku teenindamise lepingu alusel teostatava liiniveo (edaspidi avalik liinivedu) kulude arvestus; piletitulu; kohaliku omavalitsusüksuse eelarvest makstav toetus; riigieelarve sihtotstarbelise toetuse vajaduse arvestus; avaliku liiniveo kulude ja vajaliku kasumi katmise muud allikad lisaks käesoleva lõike punktides 3–5 nimetatutele. 3 (3) Omavalitsusüksuse, maavalitsuse või Maanteeameti esitatav seletuskiri peab sisaldama toetuse taotluse põhjendusi, toetuse taotlejate nimesid ja kontaktandmeid ja vajaduse korral ka loetelu vedajatest, kellega on sõlmitud avaliku teenindamise lepingud. Omavalitsusüksuse, maavalitsuse või Maanteeameti esitatav seletuskiri peab sisaldama toetuse taotluse põhjendusi, toetuse taotlejate nimesid ja kontaktandmeid ja vajaduse korral ka loetelu vedajatest, kellega on sõlmitud avaliku teenindamise lepingud.",
      "rdfs:label": {
        "@value": "Reg_1033377_Par_4 (redaktsioon 1033377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033377",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033377",
      "estleg:sourceAct": "Riigieelarvest ühistranspordi toetamise, toetusraha kasutamise aruandluse ja toetusraha tagasimaksmise kord",
      "estleg:provisionRef": "Reg_1033377 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033377_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033377_Par_5_v1033377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033377_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetust saanud vedaja esitab avaliku teenindamise lepingu teisele poolele aruande avaliku teenindamise lepingus või, kui lepingus ei ole vormi kindlaks määratud, käesoleva määruse lisades 2, 3 ja 6–8 sätestatud vormis. Kui see ei sisaldu aruandes, tuleb lisada juurde selgitused kulude ja tulude oluliste muudatuste kohta, ülevaade sõitjate arvust, piletitulust ja kohalike omavalitsusüksuste toetustest asjaomasel perioodil. Aruanne koos seletuskirjaga esitatakse avaliku teenindamise lepingus sätestatud tingimustel. Toetust saanud vedaja esitab avaliku teenindamise lepingu teisele poolele aruande avaliku teenindamise lepingus või, kui lepingus ei ole vormi kindlaks määratud, käesoleva määruse lisades 2, 3 ja 6–8 sätestatud vormis. Kui see ei sisaldu aruandes, tuleb lisada juurde selgitused kulude ja tulude oluliste muudatuste kohta, ülevaade sõitjate arvust, piletitulust ja kohalike omavalitsusüksuste toetustest asjaomasel perioodil. Aruanne koos seletuskirjaga esitatakse avaliku teenindamise lepingus sätestatud tingimustel. 2 (2) Omavalitsusüksus esitab aruande maavalitsusele bussi-, trammi- ja trollibussiliikluse ning laeva-, väikelaeva- ja parvlaevaliikluses valla- või linnasisese veo toetamise kohta hiljemalt igale kvartalile järgneva kuu 25. kuupäevaks. Omavalitsusüksus esitab aruande maavalitsusele bussi-, trammi- ja trollibussiliikluse ning laeva-, väikelaeva- ja parvlaevaliikluses valla- või linnasisese veo toetamise kohta hiljemalt igale kvartalile järgneva kuu 25. kuupäevaks. 3 (3) Maavalitsus koondab aruanded, hindab neid ja esitab hiljemalt igale kvartalile järgneva kuu 30. kuupäevaks koondaruande ja aruanded lepingute lõikes: 1 1) Maanteeametile bussiliikluse kohta, lisades seletuskirja liinivõrgus tehtud muudatuste ning riigieelarvest eraldatud vahendite kasutamise kohta, avaliku liiniveo kulude ja tulude muudatused ning kulutused piletikontrolliks, projektideks ja muuks; 2 2) Majandus- ja Kommunikatsiooniministeeriumile trammi- ja trollibussiliikluse, laeva-, väikelaeva- ja parvlaevaliikluse ning lennuliikluse kohta. Maavalitsus koondab aruanded, hindab neid ja esitab hiljemalt igale kvartalile järgneva kuu 30. kuupäevaks koondaruande ja aruanded lepingute lõikes: Maanteeametile bussiliikluse kohta, lisades seletuskirja liinivõrgus tehtud muudatuste ning riigieelarvest eraldatud vahendite kasutamise kohta, avaliku liiniveo kulude ja tulude muudatused ning kulutused piletikontrolliks, projektideks ja muuks; Majandus- ja Kommunikatsiooniministeeriumile trammi- ja trollibussiliikluse, laeva-, väikelaeva- ja parvlaevaliikluse ning lennuliikluse kohta. 4 (4) Maanteeamet koondab aruanded, hindab neid ja esitab eelmise aasta kohta koondaruande Majandus- ja Kommunikatsiooniministeeriumile hiljemalt 15. märtsiks. Maanteeamet koondab aruanded, hindab neid ja esitab eelmise aasta kohta koondaruande Majandus- ja Kommunikatsiooniministeeriumile hiljemalt 15. märtsiks. 5 (5) Avaliku teenindamise lepingu sõlminud asutustel on õigus nõuda esitatud aruannete andmete täpsustamist ning vajaduse korral lisaandmete esitamist. Samuti esitatakse avaliku teenindamise lepingu sõlminud asutuse nõudmisel andmed sõitjate arvu, piletitulu, kohaliku omavalitsuse üksuse toetuse ja muu tulu laekumise kohta teenindatavate liinide optimaalsuse hindamiseks ja muudatuste tegemise vajalikkuse analüüsimiseks. Avaliku teenindamise lepingu sõlminud asutustel on õigus nõuda esitatud aruannete andmete täpsustamist ning vajaduse korral lisaandmete esitamist. Samuti esitatakse avaliku teenindamise lepingu sõlminud asutuse nõudmisel andmed sõitjate arvu, piletitulu, kohaliku omavalitsuse üksuse toetuse ja muu tulu laekumise kohta teenindatavate liinide optimaalsuse hindamiseks ja muudatuste tegemise vajalikkuse analüüsimiseks.",
      "rdfs:label": {
        "@value": "Reg_1033377_Par_5 (redaktsioon 1033377)",
        "@language": "et"
      },
