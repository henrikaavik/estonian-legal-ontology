      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigieelarvest ühistranspordi toetamise, toetusraha kasutamise aruandluse ja toetusraha tagasimaksmise kord (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigieelarvest ühistranspordi toetamise, toetusraha kasutamise aruandluse ja toetusraha tagasimaksmise kord"
    },
    {
      "@id": "estleg:Reg_1033377_Par_1_v1033377",
      "@type": [
        "owl:NamedIndividual",
