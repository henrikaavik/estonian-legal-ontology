      }
    },
    {
      "@id": "estleg:Reg_1056295_Par_2_v1056295",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056295_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Harjumaal võetakse kaitse alla järgmised üksikobjektid koos neid ümbritseva piiranguvööndiga, mille ulatus on siin nimetatud ja mille piir on märgitud kaardil määruse lisas1: 1 1) Raasiku remmelgas Raasiku alevikus – 30 m; 2 2) Saku paekivipaljand Saku alevikus Pähklimäel – 10 m; 3 3) Keibu jugapuu Padise vallas Keibu külas – 30 m; 4 4) Kataveski kadakas Kose vallas Kata külas – 30 m; 5 5) kehtetu - RT I 2016-05-10 6 110052016006 2016-05-20 6 6) Loomisvälja mänd Viimsi vallas Muuga külas – 30 m; 7 7) Lehtmetsa rändrahn Viimsi vallas Naissaarel – 0 m; 8 8) Kunila mäe mänd Viimsi vallas Naissaarel – 0 m; 9 9) Järvesaare kuusk Viimsi vallas Naissaarel – 0 m; 10 10) Neli Neosti rändrahnu Paldiski linnas – 10 m; 11 11) Kolm hariliku tamme kultivari Fastigiata Tallinnas Kentmanni tn 20a – 25 m. Harjumaal võetakse kaitse alla järgmised üksikobjektid koos neid ümbritseva piiranguvööndiga, mille ulatus on siin nimetatud ja mille piir on märgitud kaardil määruse lisas1: Raasiku remmelgas Raasiku alevikus – 30 m; Saku paekivipaljand Saku alevikus Pähklimäel – 10 m; Keibu jugapuu Padise vallas Keibu külas – 30 m; Kataveski kadakas Kose vallas Kata külas – 30 m; kehtetu - Loomisvälja mänd Viimsi vallas Muuga külas – 30 m; Lehtmetsa rändrahn Viimsi vallas Naissaarel – 0 m; Kunila mäe mänd Viimsi vallas Naissaarel – 0 m; Järvesaare kuusk Viimsi vallas Naissaarel – 0 m; Neli Neosti rändrahnu Paldiski linnas – 10 m; Kolm hariliku tamme kultivari Fastigiata Tallinnas Kentmanni tn 20a – 25 m.",
      "rdfs:label": {
        "@value": "Reg_1056295_Par_2 (redaktsioon 1056295)",
        "@language": "et"
      },
