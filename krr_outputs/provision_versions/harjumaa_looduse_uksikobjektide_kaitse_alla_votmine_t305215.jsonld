      },
      "estleg:versionText": "Kaitse alla võtmise eesmärk on tagada Harju maakonna esinduslikumate põlispuude ja rändrahnude ning geoloogiliselt huvipakkuvama paljandi säilimine. Kaitse alla võtmise eesmärk on tagada Harju maakonna esinduslikumate põlispuude ja rändrahnude ning geoloogiliselt huvipakkuvama paljandi säilimine.",
      "rdfs:label": {
        "@value": "Reg_1056295_Par_1 (redaktsioon 1056295)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056295",
