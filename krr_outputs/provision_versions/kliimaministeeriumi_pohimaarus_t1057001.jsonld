    {
      "@id": "estleg:Reg_1057001_Par_2_v1057001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057001_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium on aruandekohustuslik Vabariigi Valitsuse ees, kes suunab ja koordineerib tema tegevust ning teostab tema üle teenistuslikku järelevalvet. Ministeerium on aruandekohustuslik Vabariigi Valitsuse ees, kes suunab ja koordineerib tema tegevust ning teostab tema üle teenistuslikku järelevalvet.",
      "rdfs:label": {
        "@value": "Reg_1057001_Par_2 (redaktsioon 1057001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057001",
      "estleg:sourceAct": "Kliimaministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_1057001 § 2",
      "estleg:partOfAct": {
