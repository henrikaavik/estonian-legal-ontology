      }
    },
    {
      "@id": "estleg:Reg_1057001_Par_25_v1057001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057001_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahvis 24 sisalduvad sätted laienevad teistele seaduse alusel moodustatud komisjonidele ja nõukogudele, kui seadusest ja selle alusel kehtestatud õigusaktidest ei tulene teisiti. Paragrahvis 24 sisalduvad sätted laienevad teistele seaduse alusel moodustatud komisjonidele ja nõukogudele, kui seadusest ja selle alusel kehtestatud õigusaktidest ei tulene teisiti. 2 (2) Ministeeriumi teenindamisel olevate valitsuskomisjonide asjaajamise korraldamiseks määrab vastutava struktuuriüksuse minister. Ministeeriumi teenindamisel olevate valitsuskomisjonide asjaajamise korraldamiseks määrab vastutava struktuuriüksuse minister.",
