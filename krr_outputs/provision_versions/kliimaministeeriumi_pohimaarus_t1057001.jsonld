        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. septembril 2023. a. Määrus jõustub 1. septembril 2023. a.",
      "rdfs:label": {
        "@value": "Reg_1057001_Par_28 (redaktsioon 1057001)",
