    {
      "@id": "estleg:Reg_1050412_Par_4_v1050412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050412_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mahepõllumajanduslikke tooteid võib märgistada enne 1. jaanuarit 2021 kehtinud kontrolliasutuste koodnumbritega kuni sellise märgistusega pakkematerjali lõppemiseni. Mahepõllumajanduslikke tooteid võib märgistada enne 1. jaanuarit 2021 kehtinud kontrolliasutuste koodnumbritega kuni sellise märgistusega pakkematerjali lõppemiseni. 2 (2) Enne 1. jaanuarit 2021 kehtinud kontrolliasutuste koodnumbritega märgistatud mahepõllumajanduslikke tooteid võib turustada kuni sellise märgistusega toodete lõppemiseni. Enne 1. jaanuarit 2021 kehtinud kontrolliasutuste koodnumbritega märgistatud mahepõllumajanduslikke tooteid võib turustada kuni sellise märgistusega toodete lõppemiseni.",
      "rdfs:label": {
        "@value": "Reg_1050412_Par_4 (redaktsioon 1050412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050412",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050412",
      "estleg:sourceAct": "Mahepõllumajanduse valdkonna kontrolliasutuse koodnumber",
      "estleg:provisionRef": "Reg_1050412 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050412_Map"
      }
