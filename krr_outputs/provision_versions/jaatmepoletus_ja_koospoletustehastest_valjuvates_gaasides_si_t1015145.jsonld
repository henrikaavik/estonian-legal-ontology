      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Jäätmepõletus- ja koospõletustehastest väljuvates gaasides sisalduvate saasteainete heite piirväärtused ning välisõhku väljutatava heite piirväärtustele vastavuse hindamise kriteeriumid (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Jäätmepõletus- ja koospõletustehastest väljuvates gaasides sisalduvate saasteainete heite piirväärtused ning välisõhku väljutatava heite piirväärtustele vastavuse hindamise kriteeriumid"
    },
    {
      "@id": "estleg:Reg_1015145_Par_1_v1015145",
      "@type": [
        "owl:NamedIndividual",
