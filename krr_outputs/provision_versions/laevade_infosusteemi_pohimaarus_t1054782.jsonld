    {
      "@id": "estleg:Reg_1054782_Par_13_v1054782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054782_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Iga laeva kohta avatakse registris eraldi kahest jaost koosnev registriosa. Iga laeva kohta avatakse registris eraldi kahest jaost koosnev registriosa. 2 (2) Registriosa andmed koosnevad registriosa 1. jao ja 2. jao andmetest. Registriosa andmed koosnevad registriosa 1. jao ja 2. jao andmetest. 3 (3) Registriosa 1. jao pealkiri on „Laev“ ja registriosa 2. jao pealkiri on „Laeva prahtija“. Registriosa 1. jao pealkiri on „Laev“ ja registriosa 2. jao pealkiri on „Laeva prahtija“.",
