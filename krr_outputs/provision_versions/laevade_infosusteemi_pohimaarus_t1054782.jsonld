      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Menetluse kohta kantakse registrisse järgmised andmed: 1 1) laeva registrisse kandmise avalduse vastuvõtmise kuupäev; 2 2) laeva registrinumber selle olemasolul; 3 3) täiendavate dokumentide või kirjavahetuse saabumise aeg; 4 4) riigilõivu tasumise andmed; 5 5) avalduse esitaja nimi ja isiku- või registrikood; 6 6) avalduse sisu kirjeldus; 7 7) tehtud otsuste aeg. Menetluse kohta kantakse registrisse järgmised andmed: laeva registrisse kandmise avalduse vastuvõtmise kuupäev; laeva registrinumber selle olemasolul; täiendavate dokumentide või kirjavahetuse saabumise aeg; riigilõivu tasumise andmed; avalduse esitaja nimi ja isiku- või registrikood; avalduse sisu kirjeldus; tehtud otsuste aeg.",
      "rdfs:label": {
        "@value": "Reg_1054782_Par_12 (redaktsioon 1054782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054782",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054782",
      "estleg:sourceAct": "Laevade infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_1054782 § 12",
      "estleg:partOfAct": {
