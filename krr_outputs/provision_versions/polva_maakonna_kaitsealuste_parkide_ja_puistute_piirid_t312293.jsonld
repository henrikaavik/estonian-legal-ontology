      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvides 1 ja 2 nimetatud parkide ja puistute kaitsekord on sätestatud Vabariigi Valitsuse 3. märtsi 2006. a määrusega nr 64 «Kaitsealuste parkide, arboreetumite ja puistute kaitse-eeskiri». Paragrahvides 1 ja 2 nimetatud parkide ja puistute kaitsekord on sätestatud Vabariigi Valitsuse 3. märtsi 2006. a määrusega nr 64 «Kaitsealuste parkide, arboreetumite ja puistute kaitse-eeskiri».",
      "rdfs:label": {
        "@value": "Reg_312293_Par_3 (redaktsioon 312293)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312293",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312293",
      "estleg:sourceAct": "Põlva maakonna kaitsealuste parkide ja puistute piirid",
      "estleg:provisionRef": "Reg_312293 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312293_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_312293_Par_4_v312293",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
