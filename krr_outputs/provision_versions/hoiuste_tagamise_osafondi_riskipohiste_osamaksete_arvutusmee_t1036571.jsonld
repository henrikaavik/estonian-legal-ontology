      "estleg:provisionRef": "Reg_1036571 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036571_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1036571_Par_10_v1036571",
      "@type": [
