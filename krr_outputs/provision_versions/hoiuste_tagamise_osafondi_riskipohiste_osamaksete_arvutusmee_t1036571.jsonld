      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvis 7 nimetatud summaarse riski punktiarvu leidmiseks kasutatakse järgmisi riskinäitajate osakaale (IW): 1 1) paragrahvi 11 punktides 1, 2, 4 ja 7 nimetatud riskinäitajate osakaal on 10,0 protsenti; 2 2) paragrahvi 11 punktides 5 ja 8 nimetatud riskinäitajate osakaal on 12,5 protsenti; 3 3) paragrahvi 11 punktides 3, 6 ja 9 nimetatud riskinäitajate osakaal on 5,0 protsenti; 4 4) paragrahvi 11 punktis 10 nimetatud riskinäitaja osakaal on 20,0 protsenti. RT I 2026-01-09 6 109012026006 2026-02-01 Paragrahvis 7 nimetatud summaarse riski punktiarvu leidmiseks kasutatakse järgmisi riskinäitajate osakaale (IW): paragrahvi 11 punktides 1, 2, 4 ja 7 nimetatud riskinäitajate osakaal on 10,0 protsenti; paragrahvi 11 punktides 5 ja 8 nimetatud riskinäitajate osakaal on 12,5 protsenti; paragrahvi 11 punktides 3, 6 ja 9 nimetatud riskinäitajate osakaal on 5,0 protsenti; paragrahvi 11 punktis 10 nimetatud riskinäitaja osakaal on 20,0 protsenti.",
      "rdfs:label": {
        "@value": "Reg_1036571_Par_8 (redaktsioon 1036571)",
        "@language": "et"
      },
