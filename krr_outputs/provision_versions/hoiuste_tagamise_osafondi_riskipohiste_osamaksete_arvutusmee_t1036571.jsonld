    {
      "@id": "estleg:Reg_1036571_Par_2_v1036571",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036571_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust kohaldatakse Finantsinspektsioonile, Tagatisfondile ja Eestis tegutsevatele krediidiasutustele ning nende kolmanda riigi krediidiasutuste filiaalidele, mille asukohariigi hoiuste tagamisskeemi haldava üksuse kohaselt tagatakse hoiused tagatisfondi seadusega (edaspidi seadus) sätestatud määradest väiksemas ulatuses. Määrust kohaldatakse Finantsinspektsioonile, Tagatisfondile ja Eestis tegutsevatele krediidiasutustele ning nende kolmanda riigi krediidiasutuste filiaalidele, mille asukohariigi hoiuste tagamisskeemi haldava üksuse kohaselt tagatakse hoiused tagatisfondi seadusega (edaspidi seadus) sätestatud määradest väiksemas ulatuses.",
      "rdfs:label": {
        "@value": "Reg_1036571_Par_2 (redaktsioon 1036571)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036571",
