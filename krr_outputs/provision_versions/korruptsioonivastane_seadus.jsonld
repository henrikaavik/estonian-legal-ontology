        "@value": "2004-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KORRUP_Par_14_v768445",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KORRUP_Par_14"
