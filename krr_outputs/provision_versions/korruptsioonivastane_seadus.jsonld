        "@value": "2007-01-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "KORRUP_Par_17 (redaktsioon 12788430)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12788430",
