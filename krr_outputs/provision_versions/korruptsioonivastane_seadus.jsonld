        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Deklarandi poolt deklaratsioonis teadvalt valeandmete esitamise eest – karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "KORRUP_Par_20 (redaktsioon 129062012001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062012001",
