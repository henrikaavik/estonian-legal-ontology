      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Väikepõllumajandustootja toetus (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Väikepõllumajandustootja toetus"
    },
    {
      "@id": "estleg:Reg_1029282_Par_1_v1029282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029282_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse väikepõllumajandustootjate kava raames ühtse pindalatoetuse, kliimat ja keskkonda säästvate põllumajandustavade toetuse, noore põllumajandustootja toetuse ning tootmiskohustusega seotud toetuste (edaspidi väikepõllumajandustootja toetus) saamise täpsemad nõuded ning toetuse taotlemise ja taotluse menetlemise kord. Määrusega kehtestatakse väikepõllumajandustootjate kava raames ühtse pindalatoetuse, kliimat ja keskkonda säästvate põllumajandustavade toetuse, noore põllumajandustootja toetuse ning tootmiskohustusega seotud toetuste (edaspidi väikepõllumajandustootja toetus) saamise täpsemad nõuded ning toetuse taotlemise ja taotluse menetlemise kord.",
      "rdfs:label": {
        "@value": "Reg_1029282_Par_1 (redaktsioon 1029282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029282",
      "estleg:sourceAct": "Väikepõllumajandustootja toetus",
      "estleg:provisionRef": "Reg_1029282 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029282_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029282_Par_2_v1029282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029282_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väikepõllumajandustootja toetust võib taotleda füüsiline või juriidiline isik või juriidilise isiku staatuseta isikute ühendus, kes on ajavahemikul 1. augustist kuni 15. augustini 2015. aastal esitanud väikepõllumajandustootjate kavaga liitumiseks Põllumajanduse Registrite ja Informatsiooni Ametile (edaspidi PRIA) lisas toodud vormi kohase taotluse või PRIA e-teenuse keskkonna kaudu elektroonilise taotluse, mis sisaldab kõiki lisas ettenähtud andmeid. Väikepõllumajandustootja toetust võib taotleda füüsiline või juriidiline isik või juriidilise isiku staatuseta isikute ühendus, kes on ajavahemikul 1. augustist kuni 15. augustini 2015. aastal esitanud väikepõllumajandustootjate kavaga liitumiseks Põllumajanduse Registrite ja Informatsiooni Ametile (edaspidi PRIA) lisas toodud vormi kohase taotluse või PRIA e-teenuse keskkonna kaudu elektroonilise taotluse, mis sisaldab kõiki lisas ettenähtud andmeid. 2 (2) Väikepõllumajandustootja toetuse taotleja peab taotlema vähemalt ühte otsetoetust järgmiste õigusaktide alusel: 1 1) maaeluministri 17. aprilli 2015. a määrus nr 32 „Otsetoetuste saamise üldised nõuded, ühtne pindalatoetus, kliima- ja keskkonnatoetus ning noore põllumajandustootja toetus”; 2 2) maaeluministri 20. aprilli 2015. a määrus nr 33 „Puu- ja köögivilja kasvatamise otsetoetus”; RT I 2021-05-20 1 120052021001 2021-05-23 3 3) maaeluministri 5. jaanuari 2017. a määrus nr 3 „Piimalehma kasvatamise otsetoetus” või RT I 2021-05-20 1 120052021001 2021-05-23 4 4) maaeluministri 14. veebruari 2020. a määrus nr 9 „Piimalehma kasvatamise otsetoetus Saaremaal, Hiiumaal, Muhus, Kihnus ja Ruhnus”. RT I 2021-05-20 1 120052021001 2021-05-23 Väikepõllumajandustootja toetuse taotleja peab taotlema vähemalt ühte otsetoetust järgmiste õigusaktide alusel: maaeluministri 17. aprilli 2015. a määrus nr 32 „Otsetoetuste saamise üldised nõuded, ühtne pindalatoetus, kliima- ja keskkonnatoetus ning noore põllumajandustootja toetus”; maaeluministri 20. aprilli 2015. a määrus nr 33 „Puu- ja köögivilja kasvatamise otsetoetus”; maaeluministri 5. jaanuari 2017. a määrus nr 3 „Piimalehma kasvatamise otsetoetus” või maaeluministri 14. veebruari 2020. a määrus nr 9 „Piimalehma kasvatamise otsetoetus Saaremaal, Hiiumaal, Muhus, Kihnus ja Ruhnus”. 3 (3) Väikepõllumajandustootja toetuse taotleja peab täitma lõike 2 punktides 1–3 nimetatud otsetoetuse saamise nõudeid, mille saamiseks on ta taotluse esitanud. Väikepõllumajandustootja toetuse taotleja peab täitma lõike 2 punktides 1–3 nimetatud otsetoetuse saamise nõudeid, mille saamiseks on ta taotluse esitanud. 4 (4) Väikepõllumajandustootja toetuse taotleja ei pea: 1 1) täitma põllumajandusministri 14. jaanuari 2015. a määruses nr 4 „Maa heas põllumajandus- ja keskkonnaseisundis hoidmise nõuded” sätestatud nõudeid ning Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse § 32 lõike 2 kohaselt avaldatud kohustuslikke majandamisnõudeid; 2 2) järgima Euroopa Parlamendi ja nõukogu määruse (EL) nr 1307/2013 artiklites 43–46 ning maaeluministri 17. aprilli 2015. a määruse nr 32 „Otsetoetuste saamise üldised nõuded, ühtne pindalatoetus, kliima- ja keskkonnatoetus ning noore põllumajandustootja toetus” §-des 11–13 sätestatud kliimat ja keskkonda säästvaid põllumajandustavasid. Väikepõllumajandustootja toetuse taotleja ei pea: täitma põllumajandusministri 14. jaanuari 2015. a määruses nr 4 „Maa heas põllumajandus- ja keskkonnaseisundis hoidmise nõuded” sätestatud nõudeid ning Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse § 32 lõike 2 kohaselt avaldatud kohustuslikke majandamisnõudeid; järgima Euroopa Parlamendi ja nõukogu määruse (EL) nr 1307/2013 artiklites 43–46 ning maaeluministri 17. aprilli 2015. a määruse nr 32 „Otsetoetuste saamise üldised nõuded, ühtne pindalatoetus, kliima- ja keskkonnatoetus ning noore põllumajandustootja toetus” §-des 11–13 sätestatud kliimat ja keskkonda säästvaid põllumajandustavasid. 5 (5) Väikepõllumajandustootja toetust ei või taotleda taotleja, kes loobub 2016. aastal või sellele järgnevatel aastatel väikepõllumajandustootjate kavas osalemisest. Väikepõllumajandustootja toetust ei või taotleda taotleja, kes loobub 2016. aastal või sellele järgnevatel aastatel väikepõllumajandustootjate kavas osalemisest.",
      "rdfs:label": {
        "@value": "Reg_1029282_Par_2 (redaktsioon 1029282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029282",
      "estleg:sourceAct": "Väikepõllumajandustootja toetus",
      "estleg:provisionRef": "Reg_1029282 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029282_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029282_Par_3_v1029282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029282_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väikepõllumajandustootja toetuse taotleja esitab igal aastal, mil ta soovib väikepõllumajandustootja toetust saada, PRIA-le taotluse § 2 lõike 2 punktides 1–3 nimetatud õigusaktide alusel nendes õigusaktides sätestatud tähtpäevaks. Väikepõllumajandustootja toetuse taotleja esitab igal aastal, mil ta soovib väikepõllumajandustootja toetust saada, PRIA-le taotluse § 2 lõike 2 punktides 1–3 nimetatud õigusaktide alusel nendes õigusaktides sätestatud tähtpäevaks.",
      "rdfs:label": {
        "@value": "Reg_1029282_Par_3 (redaktsioon 1029282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029282",
      "estleg:sourceAct": "Väikepõllumajandustootja toetus",
      "estleg:provisionRef": "Reg_1029282 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029282_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029282_Par_4_v1029282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029282_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA kontrollib taotluses esitatud andmete õigsust ja vastavust toetuse saamise nõuetele, lähtudes komisjoni rakendusmääruses (EL) nr 809/2014, millega kehtestatakse Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 rakenduseeskirjad seoses ühtse haldus- ja kontrollisüsteemi, maaelu arengu meetmete ja nõuetele vastavusega (ELT L 227, 31.07.2014, lk 69–124), artiklites 24–43 ning § 2 lõike 2 punktides 1–3 nimetatud õigusaktides sätestatust. PRIA kontrollib taotluses esitatud andmete õigsust ja vastavust toetuse saamise nõuetele, lähtudes komisjoni rakendusmääruses (EL) nr 809/2014, millega kehtestatakse Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 rakenduseeskirjad seoses ühtse haldus- ja kontrollisüsteemi, maaelu arengu meetmete ja nõuetele vastavusega (ELT L 227, 31.07.2014, lk 69–124), artiklites 24–43 ning § 2 lõike 2 punktides 1–3 nimetatud õigusaktides sätestatust.",
      "rdfs:label": {
        "@value": "Reg_1029282_Par_4 (redaktsioon 1029282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029282",
      "estleg:sourceAct": "Väikepõllumajandustootja toetus",
      "estleg:provisionRef": "Reg_1029282 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029282_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029282_Par_5_v1029282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029282_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) PRIA arvutab taotleja väikepõllumajandustootja toetuse summa § 2 lõike 2 punktides 1–3 nimetatud õigusaktides sätestatud toetuste ühikumäära alusel. PRIA arvutab taotleja väikepõllumajandustootja toetuse summa § 2 lõike 2 punktides 1–3 nimetatud õigusaktides sätestatud toetuste ühikumäära alusel. 2 (2) Väikepõllumajandustootja toetuse maksimaalne suurus taotleja kohta on 1250 eurot. Väikepõllumajandustootja toetuse maksimaalne suurus taotleja kohta on 1250 eurot. 3 (3) Kui taotleja kohta arvutatud väikepõllumajandustootja toetuse summa ületab 1250 eurot, vähendab PRIA seda, lähtudes Euroopa Parlamendi ja nõukogu määruse (EL) nr 1307/2013 artikli 65 lõikes 1 sätestatust. Kui taotleja kohta arvutatud väikepõllumajandustootja toetuse summa ületab 1250 eurot, vähendab PRIA seda, lähtudes Euroopa Parlamendi ja nõukogu määruse (EL) nr 1307/2013 artikli 65 lõikes 1 sätestatust.",
      "rdfs:label": {
        "@value": "Reg_1029282_Par_5 (redaktsioon 1029282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029282",
      "estleg:sourceAct": "Väikepõllumajandustootja toetus",
      "estleg:provisionRef": "Reg_1029282 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029282_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029282_Par_6_v1029282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029282_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) PRIA teeb väikepõllumajandustootja toetuse taotluse rahuldamise või rahuldamata jätmise otsuse taotluse esitamise aasta 10. detsembriks. PRIA teeb väikepõllumajandustootja toetuse taotluse rahuldamise või rahuldamata jätmise otsuse taotluse esitamise aasta 10. detsembriks. 2 (2) PRIA teeb väikepõllumajandustootja toetuse taotluse rahuldamata jätmise otsuse Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse §-s 22 sätestatud alustel. PRIA teeb väikepõllumajandustootja toetuse taotluse rahuldamata jätmise otsuse Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse §-s 22 sätestatud alustel.",
      "rdfs:label": {
        "@value": "Reg_1029282_Par_6 (redaktsioon 1029282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029282",
      "estleg:sourceAct": "Väikepõllumajandustootja toetus",
      "estleg:provisionRef": "Reg_1029282 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029282_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029282_Par_7_v1029282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029282_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väikepõllumajandustootja toetus makstakse välja §-s 3 nimetatud taotluse esitamise aastale järgneva aasta 30. juuniks. Väikepõllumajandustootja toetus makstakse välja §-s 3 nimetatud taotluse esitamise aastale järgneva aasta 30. juuniks.",
      "rdfs:label": {
        "@value": "Reg_1029282_Par_7 (redaktsioon 1029282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029282",
      "estleg:sourceAct": "Väikepõllumajandustootja toetus",
      "estleg:provisionRef": "Reg_1029282 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029282_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029282_Par_8_v1029282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029282_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väikepõllumajandustootjate kavas osalemisest loobumiseks märgib taotleja § 2 lõike 2 punktides 1–3 nimetatud õigusakti alusel esitataval taotlusel, et loobub väikepõllumajandustootjate kavas osalemisest. Väikepõllumajandustootjate kavas osalemisest loobumiseks märgib taotleja § 2 lõike 2 punktides 1–3 nimetatud õigusakti alusel esitataval taotlusel, et loobub väikepõllumajandustootjate kavas osalemisest. 2 (2) Kui lõikes 1 nimetatud taotlusele ei ole tehtud väikepõllumajandustootjate kavas osalemises loobumise märget, loetakse, et taotleja soovib jätkata väikepõllumajandustootjate kavas osalemist. Kui lõikes 1 nimetatud taotlusele ei ole tehtud väikepõllumajandustootjate kavas osalemises loobumise märget, loetakse, et taotleja soovib jätkata väikepõllumajandustootjate kavas osalemist.",
      "rdfs:label": {
        "@value": "Reg_1029282_Par_8 (redaktsioon 1029282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029282",
      "estleg:sourceAct": "Väikepõllumajandustootja toetus",
      "estleg:provisionRef": "Reg_1029282 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029282_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029282_Par_9_v1029282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029282_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) 2015. aastal arvutab PRIA § 2 lõike 2 punktides 1–3 nimetatud õigusaktides sätestatud toetuse esialgse ühikumäära alusel väikepõllumajandustootja toetuse hinnangulise summa iga taotleja kohta, kes nimetatud otsetoetust taotleb ja kelle otsetoetuste kogusumma ei ületa 1500 eurot. 2015. aastal arvutab PRIA § 2 lõike 2 punktides 1–3 nimetatud õigusaktides sätestatud toetuse esialgse ühikumäära alusel väikepõllumajandustootja toetuse hinnangulise summa iga taotleja kohta, kes nimetatud otsetoetust taotleb ja kelle otsetoetuste kogusumma ei ületa 1500 eurot. 2 (2) PRIA teeb väikepõllumajandustootja toetuse hinnangulise summa taotlejale teatavaks hiljemalt 1. augustil 2015. aastal. PRIA teeb väikepõllumajandustootja toetuse hinnangulise summa taotlejale teatavaks hiljemalt 1. augustil 2015. aastal.",
      "rdfs:label": {
        "@value": "Reg_1029282_Par_9 (redaktsioon 1029282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029282",
      "estleg:sourceAct": "Väikepõllumajandustootja toetus",
      "estleg:provisionRef": "Reg_1029282 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029282_Map"
      }
    },
