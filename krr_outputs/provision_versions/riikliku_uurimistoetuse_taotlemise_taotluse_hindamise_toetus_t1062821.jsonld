    {
      "@id": "estleg:Reg_1062821_Par_12_v1062821",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062821_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Uurimistoetuse taotlusvooru kuulutab välja rakendusüksus oma kodulehel. Uurimistoetuse taotlusvooru kuulutab välja rakendusüksus oma kodulehel. 2 (2) Uurimistoetuse taotlemine ja taotluse menetlemine toimub Eesti Teadusinfosüsteemis (edaspidi ETIS). Uurimistoetuse taotlemine ja taotluse menetlemine toimub Eesti Teadusinfosüsteemis (edaspidi ETIS).",
      "rdfs:label": {
        "@value": "Reg_1062821_Par_12 (redaktsioon 1062821)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062821",
