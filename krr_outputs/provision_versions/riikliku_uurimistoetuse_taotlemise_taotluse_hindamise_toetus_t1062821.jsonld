    {
      "@id": "estleg:Reg_1062821_Par_19_v1062821",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062821_Par_19"
