      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ravimite ja Ravimiameti eriloaga kauba liikumise ning turustamise tingimused ja kord (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ravimite ja Ravimiameti eriloaga kauba liikumise ning turustamise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1058418_Par_1_v1058418",
      "@type": [
        "owl:NamedIndividual",
