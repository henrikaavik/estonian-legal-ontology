    {
      "@id": "estleg:Reg_1058418_Par_3_v1058418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058418_Par_3"
