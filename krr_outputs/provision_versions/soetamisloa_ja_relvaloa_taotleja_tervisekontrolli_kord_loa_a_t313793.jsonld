      "estleg:provisionRef": "Reg_313793 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313793_Map"
      }
    },
    {
      "@id": "estleg:Reg_313793_Par_3_v313793",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313793_Par_3"
