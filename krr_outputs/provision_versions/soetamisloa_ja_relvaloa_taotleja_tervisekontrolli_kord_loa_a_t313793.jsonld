      }
    },
    {
      "@id": "estleg:Reg_313793_Par_7_v313793",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313793_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervishoiuteenuse osutaja säilitab tervisekontrolli kaarte ja terviseuuringute tulemusi paberkandjal või elektroonilisel kujul 15 aastat taotlejale tervisekontrolli tegemisest arvates. Tervishoiuteenuse osutaja säilitab tervisekontrolli kaarte ja terviseuuringute tulemusi paberkandjal või elektroonilisel kujul 15 aastat taotlejale tervisekontrolli tegemisest arvates.",
      "rdfs:label": {
        "@value": "Reg_313793_Par_7 (redaktsioon 313793)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313793",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313793",
      "estleg:sourceAct": "Soetamisloa ja relvaloa taotleja tervisekontrolli kord, loa andmist välistavate tervisehäirete loetelu ning tervisetõendi sisu ja vormi nõuded",
      "estleg:provisionRef": "Reg_313793 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313793_Map"
      }
    },
    {
      "@id": "estleg:Reg_313793_Par_8_v313793",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313793_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisetõend, mis on väljastatud enne käesoleva määruse jõustumist, kehtib tervisetõendil märgitud kuupäevani või kuupäeva puudumisel soetamisloa või relvaloa kehtivusaja lõpuni. Tervisetõend, mis on väljastatud enne käesoleva määruse jõustumist, kehtib tervisetõendil märgitud kuupäevani või kuupäeva puudumisel soetamisloa või relvaloa kehtivusaja lõpuni.",
      "rdfs:label": {
        "@value": "Reg_313793_Par_8 (redaktsioon 313793)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313793",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313793",
      "estleg:sourceAct": "Soetamisloa ja relvaloa taotleja tervisekontrolli kord, loa andmist välistavate tervisehäirete loetelu ning tervisetõendi sisu ja vormi nõuded",
      "estleg:provisionRef": "Reg_313793 § 8",
