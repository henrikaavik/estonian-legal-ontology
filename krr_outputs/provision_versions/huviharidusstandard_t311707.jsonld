      }
    },
    {
      "@id": "estleg:Reg_311707_Par_5_v311707",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_311707_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Huviala õppekava on õpingute alusdokument, mis määrab kindlaks pakutava huvihariduse eesmärgid ja sisu. Huviala õppekava on õpingute alusdokument, mis määrab kindlaks pakutava huvihariduse eesmärgid ja sisu. 2(2)Huvikool koostab iga õpetatava huviala jaoks huviala õppekava. Huvikool koostab iga õpetatava huviala jaoks huviala õppekava. 3(3)Huviala õppekava sisaldab:11)õppe eesmärke ja kestust;22)õppeainete loendit;33)ainekavasid. Huviala õppekava sisaldab: õppe eesmärke ja kestust; õppeainete loendit; ainekavasid. 4(4)Huviala õppekava kinnitab huvikooli direktor. Huviala õppekava kinnitab huvikooli direktor.",
      "rdfs:label": {
        "@value": "Reg_311707_Par_5 (redaktsioon 311707)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "311707",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/311707",
