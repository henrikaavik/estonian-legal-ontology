    {
      "@id": "estleg:Reg_311707_Par_2_v311707",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_311707_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Huvihariduse eesmärk on luua võimalusi isiksuse mitmekülgseks arenguks ja toetada noore kujunemist hästi toimetulevaks ühiskonnaliikmeks. Huvihariduse eesmärk on luua võimalusi isiksuse mitmekülgseks arenguks ja toetada noore kujunemist hästi toimetulevaks ühiskonnaliikmeks. 2(2)Huviharidus:11)põhineb noorte osalusel ja vabal tahtel;22)põhineb huvialade ja noorte võrdsel kohtlemisel;33)toetab noorte arengut, iseseisvust, omaalgatust, initsiatiivi, aktiivsust;44)pakub noortele eduelamusi ja tunnustust;55)pakub noortele huvialaga tegelemise ja selle tunnetamise rõõmu;66)arendab loovust ja sotsiaalseid oskusi;77)on avatud, positiivne ja noori julgustav. Huviharidus: põhineb noorte osalusel ja vabal tahtel; põhineb huvialade ja noorte võrdsel kohtlemisel; toetab noorte arengut, iseseisvust, omaalgatust, initsiatiivi, aktiivsust; pakub noortele eduelamusi ja tunnustust; pakub noortele huvialaga tegelemise ja selle tunnetamise rõõmu; arendab loovust ja sotsiaalseid oskusi; on avatud, positiivne ja noori julgustav.",
      "rdfs:label": {
        "@value": "Reg_311707_Par_2 (redaktsioon 311707)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "311707",
