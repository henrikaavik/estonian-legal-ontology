      "estleg:provisionRef": "Reg_1051218 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1051218_Map"
      }
    },
    {
      "@id": "estleg:Reg_1051218_Par_8_v1051218",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051218_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Abikõlblikud on nõustamisteenuste kulud vastavalt § 7 toetatavatele tegevustele. Abikõlblikud on nõustamisteenuste kulud vastavalt § 7 toetatavatele tegevustele. 2 (2) Kui toetus on käsitletav grupierandiga hõlmatud riigiabina grupierandi määruse mõistes, on abiliigiti abikõlblikud järgmised kulud: 1 1) artikli 18 alusel antava abi korral väliskonsultantide osutatud nõustamisteenuste kulu; 2 2) artikli 28 alusel antava abi korral innovatsiooni nõuandeteenuste ja tugiteenuste kulud. Kui toetus on käsitletav grupierandiga hõlmatud riigiabina grupierandi määruse mõistes, on abiliigiti abikõlblikud järgmised kulud: artikli 18 alusel antava abi korral väliskonsultantide osutatud nõustamisteenuste kulu; artikli 28 alusel antava abi korral innovatsiooni nõuandeteenuste ja tugiteenuste kulud. 3 (3) Kulud peavad olema tasutud pangaülekandega. Kulud peavad olema tasutud pangaülekandega. 4 (4) Abikõlblike kulude hulka ei arvata tehinguid isikute vahel, kes on tulumaksuseaduse § 8 tähenduses seotud isikud. Abikõlblike kulude hulka ei arvata tehinguid isikute vahel, kes on tulumaksuseaduse § 8 tähenduses seotud isikud. 5 (5) Käibemaks ei ole abikõlblik kulu. Käibemaks ei ole abikõlblik kulu. 6 (6) Abikõlblikud ei ole kulud, mis on tehtud enne taotluse esitamist rakendusüksusele. Abikõlblikud ei ole kulud, mis on tehtud enne taotluse esitamist rakendusüksusele.",
      "rdfs:label": {
        "@value": "Reg_1051218_Par_8 (redaktsioon 1051218)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051218",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051218",
