    {
      "@id": "estleg:Reg_1051218_Par_15_v1051218",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051218_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-07",
