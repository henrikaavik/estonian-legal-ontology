    {
      "@id": "estleg:Reg_1001161_Par_20_v1001161",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001161_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kooli kasutuses oleva vara moodustavad maa, hooned, rajatised, seadmed, inventar, muu vara ja eelarvevahendid, mille Haridus- ja Teadusministeerium on koolile andnud sihtotstarbeliseks kasutamiseks ja valdamiseks. Kooli kasutuses oleva vara moodustavad maa, hooned, rajatised, seadmed, inventar, muu vara ja eelarvevahendid, mille Haridus- ja Teadusministeerium on koolile andnud sihtotstarbeliseks kasutamiseks ja valdamiseks. 2 (2) Kool kasutab ja valdab tema kasutuses ning valduses olevat vara „Riigieelarve seaduse”, „Riigivaraseaduse” ja teiste õigusaktide kohaselt. Kool kasutab ja valdab tema kasutuses ning valduses olevat vara „Riigieelarve seaduse”, „Riigivaraseaduse” ja teiste õigusaktide kohaselt. 3 (3) Koolil on oma eelarve, mille kinnitab haridus- ja teadusminister. Koolil on oma eelarve, mille kinnitab haridus- ja teadusminister. 4 (4) Kooli rahastatakse riigieelarvest, laekumistest sihttoetusteks, annetustest ning käesoleva määruse § 10 lõikes 5 nimetatud kooli osutatavatest teenustest saadud tuludest. Kooli rahastatakse riigieelarvest, laekumistest sihttoetusteks, annetustest ning käesoleva määruse § 10 lõikes 5 nimetatud kooli osutatavatest teenustest saadud tuludest.",
      "rdfs:label": {
        "@value": "Reg_1001161_Par_20 (redaktsioon 1001161)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001161",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001161",
      "estleg:sourceAct": "Ahtme Kooli põhimäärus",
      "estleg:provisionRef": "Reg_1001161 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001161_Map"
      }
