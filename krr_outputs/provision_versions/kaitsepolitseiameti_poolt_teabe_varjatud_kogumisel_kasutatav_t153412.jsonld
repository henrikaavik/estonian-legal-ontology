    {
      "@id": "estleg:Reg_153412_Par_8_v153412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153412_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teabetoimikus säilitatakse julgeolekuasutuste seaduse paragrahvis 25 või 26 sätestatud viisil kogutud teavet ning Kaitsepolitseiameti ülesannete täitmiseks Kaitsepolitseiameti või selleks volitatud asutuse või kaastööle kaasatud isiku poolt kogutud teavet.",
      "rdfs:label": {
        "@value": "Reg_153412_Par_8 (redaktsioon 153412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153412",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153412",
      "estleg:sourceAct": "Kaitsepolitseiameti poolt teabe varjatud kogumisel kasutatavad meetodid ja vahendid ning teabetoimiku pidamise ja säilitamise kord",
      "estleg:provisionRef": "Reg_153412 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153412_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153412_Par_9_v153412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153412_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teabetoimik lõpetatakse Kaitsepolitseiameti juhi või tema poolt volitatud ametniku otsusega, kui on ära langenud vajadus koguda teavet juhtumi kohta.",
      "rdfs:label": {
        "@value": "Reg_153412_Par_9 (redaktsioon 153412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153412",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153412",
      "estleg:sourceAct": "Kaitsepolitseiameti poolt teabe varjatud kogumisel kasutatavad meetodid ja vahendid ning teabetoimiku pidamise ja säilitamise kord",
      "estleg:provisionRef": "Reg_153412 § 9",
      "estleg:partOfAct": {
