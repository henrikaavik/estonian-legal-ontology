  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_kaitsepolitseiameti_poolt_teabe_varjatud_kogumisel_kasutatav_t153412_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kaitsepolitseiameti poolt teabe varjatud kogumisel kasutatavad meetodid ja vahendid ning teabetoimiku pidamise ja säilitamise kord (12 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kaitsepolitseiameti poolt teabe varjatud kogumisel kasutatavad meetodid ja vahendid ning teabetoimiku pidamise ja säilitamise kord"
    },
    {
      "@id": "estleg:Reg_153412_Par_1_v153412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153412_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitsepolitseiamet teostab isiku õiguse piiramisel sõnumi saladusele täiesti salajaste meetodite ja vahendite kasutamisega: 1 1) postisaadetiste vahetut läbivaatust avamise, läbivalgustamise ja sulgemise teel ning saadud informatsiooni talletamist, kasutades vastavaid tehnilisi vahendeid või vastavalt kohaldatud tehnoloogiaid; 2 2) telegraafi, telefoni või muu tehnilise sidekanali kaudu edastatava sõnumi või muu teabe pealtkuulamist, -vaatamist või salvestamist, kasutades vastavaid tehnilisi vahendeid või vastavalt kohaldatud tehnoloogiaid; 3 3) muul viisil edastatava teabe pealtkuulamist, -vaatamist või salvestamist, paigaldades selleks vajalikke tehnilisi vahendeid. Kaitsepolitseiamet teostab isiku õiguse piiramisel sõnumi saladusele täiesti salajaste meetodite ja vahendite kasutamisega: postisaadetiste vahetut läbivaatust avamise, läbivalgustamise ja sulgemise teel ning saadud informatsiooni talletamist, kasutades vastavaid tehnilisi vahendeid või vastavalt kohaldatud tehnoloogiaid; telegraafi, telefoni või muu tehnilise sidekanali kaudu edastatava sõnumi või muu teabe pealtkuulamist, -vaatamist või salvestamist, kasutades vastavaid tehnilisi vahendeid või vastavalt kohaldatud tehnoloogiaid; muul viisil edastatava teabe pealtkuulamist, -vaatamist või salvestamist, paigaldades selleks vajalikke tehnilisi vahendeid. 2 (2) Telegraafi, telefoni või muu tehnilise sidekanali kaudu edastatava sõnumi või muu teabe pealtkuulamine, -vaatamine või salvestamine hõlmab kõiki audio-video, elektroonilise side, infoühiskonna teenuse või kosmoseside edastamise liike ja seadmeid. RT I 2017-08-02 2 102082017002 2017-08-05 Telegraafi, telefoni või muu tehnilise sidekanali kaudu edastatava sõnumi või muu teabe pealtkuulamine, -vaatamine või salvestamine hõlmab kõiki audio-video, elektroonilise side, infoühiskonna teenuse või kosmoseside edastamise liike ja seadmeid. 3 (3) Muul viisil edastatava teabe pealtkuulamine, -vaatamine või salvestamine hõlmab isikute poolt ja vahendusel edastatavat teavet, signaale ja andmeid. Muul viisil edastatava teabe pealtkuulamine, -vaatamine või salvestamine hõlmab isikute poolt ja vahendusel edastatavat teavet, signaale ja andmeid.",
      "rdfs:label": {
        "@value": "Reg_153412_Par_1 (redaktsioon 153412)",
        "@language": "et"
      },
