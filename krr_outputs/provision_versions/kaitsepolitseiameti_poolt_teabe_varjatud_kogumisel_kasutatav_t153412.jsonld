      },
      "estleg:versionText": "Julgeolekuasutuste seaduses sätestatud ülesannete täitmiseks avatakse teabetoimik.",
      "rdfs:label": {
        "@value": "Reg_153412_Par_4 (redaktsioon 153412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153412",
