      },
      "estleg:versionText": "Teabetoimikuid säilitatakse vastavalt «Riigisaladuse ja salastatud välisteabe seaduses» sätestatud tähtaegadele.",
      "rdfs:label": {
        "@value": "Reg_153412_Par_11 (redaktsioon 153412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153412",
