      }
    },
    {
      "@id": "estleg:Reg_1058629_Par_13_v1058629",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058629_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlusvooru eelarve ja ajakava kinnitab rakendusasutus käskkirjaga, ning edastab asjakohase teabe rakendusüksusele. Kinnitatud eelarve peab vastama käesoleva paragrahvi lõikele 2. Taotlusvooru eelarve ja ajakava kinnitab rakendusasutus käskkirjaga, ning edastab asjakohase teabe rakendusüksusele. Kinnitatud eelarve peab vastama käesoleva paragrahvi lõikele 2. 2 (2) Vähemalt 40% taotlusvooru eelarvest tuleb suunata toetusteks tootmisüksustesse väljaspoole Tallinna ja Tartu regioone. Vähemalt 40% taotlusvooru eelarvest tuleb suunata toetusteks tootmisüksustesse väljaspoole Tallinna ja Tartu regioone. 3 (3) Rakendusüksus kuulutab taotlusvooru välja oma kodulehel ja sihtrühmale suunatud avalikus kanalis. Taotlusvooru peatamisest ja lõpetamisest teavitab rakendusüksus oma kodulehel. Rakendusüksus kuulutab taotlusvooru välja oma kodulehel ja sihtrühmale suunatud avalikus kanalis. Taotlusvooru peatamisest ja lõpetamisest teavitab rakendusüksus oma kodulehel.",
      "rdfs:label": {
        "@value": "Reg_1058629_Par_13 (redaktsioon 1058629)",
        "@language": "et"
      },
