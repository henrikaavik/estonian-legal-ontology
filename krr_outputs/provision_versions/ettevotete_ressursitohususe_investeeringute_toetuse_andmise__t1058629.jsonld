    {
      "@id": "estleg:Reg_1058629_Par_14_v1058629",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058629_Par_14"
      },
      "estleg:versionValidFrom": {
