    {
      "@id": "estleg:Reg_1046427_Par_17_v1046427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046427_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 15. septembri 2005. a määruse nr 237 „Hoiualade kaitse alla võtmine Lääne-Viru maakonnas” § 1 lõike 1 punkt 11 ja määruse lisas esitatud kaart „Suurekivi hoiuala” tunnistatakse kehtetuks. Vabariigi Valitsuse 15. septembri 2005. a määruse nr 237 „Hoiualade kaitse alla võtmine Lääne-Viru maakonnas” § 1 lõike 1 punkt 11 ja määruse lisas esitatud kaart „Suurekivi hoiuala” tunnistatakse kehtetuks.",
