    },
    {
      "@id": "estleg:Reg_1046427_Par_18_v1046427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046427_Par_18"
