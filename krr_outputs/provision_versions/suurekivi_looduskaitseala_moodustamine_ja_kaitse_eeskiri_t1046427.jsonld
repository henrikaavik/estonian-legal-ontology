    },
    {
      "@id": "estleg:Reg_1046427_Par_11_v1046427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046427_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatise püstitamine kaitseala tarbeks. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatise püstitamine kaitseala tarbeks.",
      "rdfs:label": {
        "@value": "Reg_1046427_Par_11 (redaktsioon 1046427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046427",
      "estleg:sourceAct": "Suurekivi looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1046427 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046427_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046427_Par_12_v1046427",
