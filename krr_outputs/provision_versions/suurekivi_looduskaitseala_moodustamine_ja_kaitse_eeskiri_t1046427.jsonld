    {
      "@id": "estleg:Reg_1046427_Par_15_v1046427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046427_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavara kaevandamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) uuendusraie; 5 5) biotsiidi, taimekaitsevahendi ja väetise kasutamine. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; uuendusraie; biotsiidi, taimekaitsevahendi ja väetise kasutamine. 2 (2) Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab. Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab.",
      "rdfs:label": {
        "@value": "Reg_1046427_Par_15 (redaktsioon 1046427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046427",
