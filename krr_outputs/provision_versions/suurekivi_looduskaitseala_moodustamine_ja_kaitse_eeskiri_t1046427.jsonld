      "estleg:versionValidFrom": {
        "@value": "2019-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 5. oktoobri 2010. a käskkirjaga nr 1390 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 5. oktoobri 2010. a käskkirjaga nr 1390 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1046427_Par_18 (redaktsioon 1046427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046427",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046427",
      "estleg:sourceAct": "Suurekivi looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1046427 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046427_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046427_Par_19_v1046427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
