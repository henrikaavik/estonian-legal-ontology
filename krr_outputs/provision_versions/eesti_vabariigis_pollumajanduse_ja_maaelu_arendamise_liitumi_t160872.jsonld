      }
    },
    {
      "@id": "estleg:Reg_160872_Par_14_v160872",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160872_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja, tema eelnenud majandustegevuse, kavandatava investeeringu ja sellele järgneva majandustegevuse vastavus maapiirkonnas alternatiivse majandustegevuse arendamise ja mitmekesistamise investeeringutoetuse saamiseks esitatud nõuetele tehakse kindlaks ja hindamisleht koostatakse vastavalt §-le 6. Taotleja, tema eelnenud majandustegevuse, kavandatava investeeringu ja sellele järgneva majandustegevuse vastavus maapiirkonnas alternatiivse majandustegevuse arendamise ja mitmekesistamise investeeringutoetuse saamiseks esitatud nõuetele tehakse kindlaks ja hindamisleht koostatakse vastavalt §-le 6.",
