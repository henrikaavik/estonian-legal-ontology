      }
    },
    {
      "@id": "estleg:Reg_160872_Par_15_v160872",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160872_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-05-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maapiirkonna infrastruktuuri investeeringutoetuse taotlemiseks esitatud taotluse ja äriprojekti toetuse saamiseks esitatud nõuetele vastavuse hindamiseks võrreldakse taotluses, äriprojektis ja neis esitatud andmeid tõendavates dokumentides märgitud andmeid vastavalt lisale 5. Maapiirkonna infrastruktuuri investeeringutoetuse taotlemiseks esitatud taotluse ja äriprojekti toetuse saamiseks esitatud nõuetele vastavuse hindamiseks võrreldakse taotluses, äriprojektis ja neis esitatud andmeid tõendavates dokumentides märgitud andmeid vastavalt lisale 5.",
      "rdfs:label": {
