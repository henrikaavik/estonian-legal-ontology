    {
      "@id": "estleg:Reg_1037853_Par_4_4_v1037853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037853_Par_4_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Surumaagaasi ühenduspesad ja paagid peavad vastama ÜRO Euroopa Majanduskomisjoni eeskirjale nr 110 „Surumaagaasi või veeldatud maagaasi kasutavad sõidukid” (milles viidatakse standardi ISO 14469 I ja II osale). RT I2017-12-01131011220170132017-12-04 Surumaagaasi ühenduspesad ja paagid peavad vastama ÜRO Euroopa Majanduskomisjoni eeskirjale nr 110 „Surumaagaasi või veeldatud maagaasi kasutavad sõidukid” (milles viidatakse standardi ISO 14469 I ja II osale).",
      "rdfs:label": {
        "@value": "Reg_1037853_Par_4_4 (redaktsioon 1037853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037853",
      "estleg:sourceAct": "Alternatiivkütuste taristu kasutuselevõtule esitatavad ohutusnõuded",
      "estleg:provisionRef": "Reg_1037853 § 4_4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037853_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037853_Par_5_v1037853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037853_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teave alternatiivkütuse liigi kohta tehakse kättesaadavaks mootorsõiduki kasutusjuhendis, tanklas ja laadimispunktis, mootorsõidukis ja mootorsõiduki müügiettevõttes vastavalt direktiivi 2014/94/EL artikli 7 lõikele 1. Teave alternatiivkütuse liigi kohta tehakse kättesaadavaks mootorsõiduki kasutusjuhendis, tanklas ja laadimispunktis, mootorsõidukis ja mootorsõiduki müügiettevõttes vastavalt direktiivi 2014/94/EL artikli 7 lõikele 1. 2 (2) Kui käesoleva paragrahvi lõikes 1 nimetatud direktiiv osutab graafilisele tähisele ja värvikoodide skeemile, peab graafiline tähis olema arusaadav ning paigutatud nähtavalt: 1 1) tankla vastavatele pumpadele ja nende püstolitele; 2 2) sellise mootorsõiduki kütusepaagi korgile või selle vahetusse lähedusse, mille jaoks see sobib; 3 3) mootorsõiduki kasutusjuhendisse. Kui käesoleva paragrahvi lõikes 1 nimetatud direktiiv osutab graafilisele tähisele ja värvikoodide skeemile, peab graafiline tähis olema arusaadav ning paigutatud nähtavalt: tankla vastavatele pumpadele ja nende püstolitele; sellise mootorsõiduki kütusepaagi korgile või selle vahetusse lähedusse, mille jaoks see sobib; mootorsõiduki kasutusjuhendisse. 3 (3) Vesiniku puhul tuleb tanklas kütusehindade kuvamisel tuua välja võrdlus asjakohaste ühikuhindadega. Selle teabe kuvamine ei tohi tarbijat eksitada. Vesiniku puhul tuleb tanklas kütusehindade kuvamisel tuua välja võrdlus asjakohaste ühikuhindadega. Selle teabe kuvamine ei tohi tarbijat eksitada. 4 (4) Kui Euroopa Standardiorganisatsiooni asjakohaste standardite märgistamissätteid ajakohastatakse, võetakse vastu märgistamist käsitlevad rakendusaktid või kehtestatakse uued Euroopa Standardiorganisatsiooni standardid alternatiivkütuste jaoks, kohaldatakse vastavaid märgistamisnõudeid kõikide tanklate ja laadimispunktide ning registreeritud mootorsõidukite suhtes alates ajast 24 kuud pärast asjakohaste standardite ajakohastamist või vastuvõtmist. Kui Euroopa Standardiorganisatsiooni asjakohaste standardite märgistamissätteid ajakohastatakse, võetakse vastu märgistamist käsitlevad rakendusaktid või kehtestatakse uued Euroopa Standardiorganisatsiooni standardid alternatiivkütuste jaoks, kohaldatakse vastavaid märgistamisnõudeid kõikide tanklate ja laadimispunktide ning registreeritud mootorsõidukite suhtes alates ajast 24 kuud pärast asjakohaste standardite ajakohastamist või vastuvõtmist.",
      "rdfs:label": {
        "@value": "Reg_1037853_Par_5 (redaktsioon 1037853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037853",
      "estleg:sourceAct": "Alternatiivkütuste taristu kasutuselevõtule esitatavad ohutusnõuded",
      "estleg:provisionRef": "Reg_1037853 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037853_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037853_Par_6_v1037853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037853_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse § 3 lõigetes 1–3, §-s 4 ja § 5 lõigetes 1–2 sätestatud transpordi elektri ja vesinikuga varustamise ohutusnõudeid ning nõudeid kasutajate teavitamisele rakendatakse alates 2017. aasta 18. novembrist kasutusele võetud või ajakohastatud tanklale ja laadimispunktile. Käesoleva määruse § 3 lõigetes 1–3, §-s 4 ja § 5 lõigetes 1–2 sätestatud transpordi elektri ja vesinikuga varustamise ohutusnõudeid ning nõudeid kasutajate teavitamisele rakendatakse alates 2017. aasta 18. novembrist kasutusele võetud või ajakohastatud tanklale ja laadimispunktile.",
      "rdfs:label": {
        "@value": "Reg_1037853_Par_6 (redaktsioon 1037853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037853",
      "estleg:sourceAct": "Alternatiivkütuste taristu kasutuselevõtule esitatavad ohutusnõuded",
      "estleg:provisionRef": "Reg_1037853 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037853_Map"
      }
    },
