      "estleg:versionOf": {
        "@id": "estleg:Reg_1000533_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumi kantsler annab ametisse astuvale ministrile ülevaate ministeeriumi ja tema valitsemisala strateegilistest eesmärkidest ja nende saavutamisest, ministeeriumile antud ülesannetest ja nende täitmisest, ministeeriumi ja tema valitsemisala probleemidest, ministeeriumi eelarvevahendite kasutamisest ja seisust ning ministeeriumi töökorraldusest. Ministeeriumi kantsler annab ametisse astuvale ministrile ülevaate ministeeriumi ja tema valitsemisala strateegilistest eesmärkidest ja nende saavutamisest, ministeeriumile antud ülesannetest ja nende täitmisest, ministeeriumi ja tema valitsemisala probleemidest, ministeeriumi eelarvevahendite kasutamisest ja seisust ning ministeeriumi töökorraldusest.",
      "rdfs:label": {
        "@value": "Reg_1000533_Par_27 (redaktsioon 1000533)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000533",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000533",
      "estleg:sourceAct": "Vabariigi Valitsuse reglement",
      "estleg:provisionRef": "Reg_1000533 § 27",
      "estleg:partOfAct": {
