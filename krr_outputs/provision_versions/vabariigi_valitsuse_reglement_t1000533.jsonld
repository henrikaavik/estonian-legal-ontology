    },
    {
      "@id": "estleg:Reg_1000533_Par_9_v1000533",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000533_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsusele arvamuse andmiseks saadetud Riigikogu liikme, fraktsiooni või komisjoni algatatud eelnõu edastab Riigikantselei seisukoha esitamiseks asjaomastele ministeeriumidele, määrates ühtlasi vastutava ministeeriumi ja seisukoha esitamise tähtpäeva. Vabariigi Valitsusele arvamuse andmiseks saadetud Riigikogu liikme, fraktsiooni või komisjoni algatatud eelnõu edastab Riigikantselei seisukoha esitamiseks asjaomastele ministeeriumidele, määrates ühtlasi vastutava ministeeriumi ja seisukoha esitamise tähtpäeva.",
      "rdfs:label": {
