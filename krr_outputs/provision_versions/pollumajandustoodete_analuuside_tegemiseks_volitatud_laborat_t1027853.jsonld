      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Põllumajandustoodete analüüside tegemiseks volitatud laboratooriumile esitatavad nõuded ja volituse taotlemise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Põllumajandustoodete analüüside tegemiseks volitatud laboratooriumile esitatavad nõuded ja volituse taotlemise kord"
    },
    {
      "@id": "estleg:Reg_1027853_Par_1_v1027853",
      "@type": [
        "owl:NamedIndividual",
