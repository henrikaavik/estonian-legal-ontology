      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui tehing või bilansist bilanssi üleandmine on vastavalt käesoleva seaduse paragrahvile 1 kehtetu, on maa-alade, hoonete või rajatiste praegused valdajad või kasutajad kohustatud selle üle andma Vabariigi Valitsuse poolt määratud riigiasutusele, sõltumata sellest, kellelt ja millise tehinguga ta valduse üle võttis.",
      "rdfs:label": {
        "@value": "EVTENLRVVKOO_Par_2 (redaktsioon 22247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22247",
