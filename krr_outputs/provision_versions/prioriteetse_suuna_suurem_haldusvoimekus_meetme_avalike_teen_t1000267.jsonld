      "estleg:versionValidFrom": {
        "@value": "2012-01-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Projekti eelarve muutmise või projekti teostamisest loobumise tõttu vabanenud summad lisatakse järgmistes taotlusvoorudes jagatavale toetusele. Projekti eelarve muutmise või projekti teostamisest loobumise tõttu vabanenud summad lisatakse järgmistes taotlusvoorudes jagatavale toetusele.",
      "rdfs:label": {
        "@value": "Reg_1000267_Par_25 (redaktsioon 1000267)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000267",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000267",
      "estleg:sourceAct": "Prioriteetse suuna „Suurem haldusvõimekus” meetme „Avalike teenistujate, kohalike omavalitsuste ja mittetulundusühingute töötajate koolitus ja arendamine” rakendamiseks toetuse andmise ja kasutamise tingimused ning kord",
      "estleg:provisionRef": "Reg_1000267 § 25",
