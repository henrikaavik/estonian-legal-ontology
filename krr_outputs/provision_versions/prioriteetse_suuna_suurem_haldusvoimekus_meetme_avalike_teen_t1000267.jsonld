      }
    },
    {
      "@id": "estleg:Reg_1000267_Par_23_v1000267",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000267_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotluse rahuldamata jätmise otsuses märgitakse vähemalt: 1 1) otsuse tegija; 2 2) otsuse tegemise kuupäev ja otsuse number; 3 3) otsuse tegemise alused; 4 4) toetuse taotleja nimi; 5 5) selle projekti nimetus, millele toetust taotleti. Taotluse rahuldamata jätmise otsuses märgitakse vähemalt: otsuse tegija; otsuse tegemise kuupäev ja otsuse number; otsuse tegemise alused; toetuse taotleja nimi; selle projekti nimetus, millele toetust taotleti.",
      "rdfs:label": {
        "@value": "Reg_1000267_Par_23 (redaktsioon 1000267)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000267",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000267",
      "estleg:sourceAct": "Prioriteetse suuna „Suurem haldusvõimekus” meetme „Avalike teenistujate, kohalike omavalitsuste ja mittetulundusühingute töötajate koolitus ja arendamine” rakendamiseks toetuse andmise ja kasutamise tingimused ning kord",
      "estleg:provisionRef": "Reg_1000267 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000267_Map"
      }
    },
    {
      "@id": "estleg:Reg_1000267_Par_24_v1000267",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000267_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse saaja on kohustatud taotlema Rahandusministeeriumilt taotluse rahuldamise otsuse muutmist, juhul kui: 1 1) ta soovib muuta projekti abikõlblikkuse algus- või lõppkuupäeva; 2 2) esineb „Perioodi 2007–2013 struktuuritoetuse seaduse” § 18 lõikes 3 nimetatud asjaolu. Toetuse saaja on kohustatud taotlema Rahandusministeeriumilt taotluse rahuldamise otsuse muutmist, juhul kui: ta soovib muuta projekti abikõlblikkuse algus- või lõppkuupäeva; esineb „Perioodi 2007–2013 struktuuritoetuse seaduse” § 18 lõikes 3 nimetatud asjaolu. 2 (2) Toetuse saaja on kohustatud Rahandusministeeriumit viivitamata teavitama ning saama kooskõlastuse, kui muudetakse projekti tegevusi ja tegevuste aegu või projekti eelarves konkreetsele kulureale ette nähtud mahtu teise kulurea arvelt rohkem kui 20% projekti mahust kumulatiivselt või muutuvad kontaktandmed. RT I 2012-01-31 2 131012012002 2012-02-03 Toetuse saaja on kohustatud Rahandusministeeriumit viivitamata teavitama ning saama kooskõlastuse, kui muudetakse projekti tegevusi ja tegevuste aegu või projekti eelarves konkreetsele kulureale ette nähtud mahtu teise kulurea arvelt rohkem kui 20% projekti mahust kumulatiivselt või muutuvad kontaktandmed. 3 (3) Toetuse saaja esitatud taotluse rahuldamise otsuse muutmise avalduse rahuldamisest võib keelduda, kui muudatused ei ole kooskõlas projekti sisu ja eesmärkidega, otsuse muutmise korral ei oleks projekti elluviimist võimalik lõpetada § 13 lõikes 2 sätestatud tähtajaks või otsuse muutmist ei võimalda meetme eelarve. RT I 2012-01-31 2 131012012002 2012-02-03 Toetuse saaja esitatud taotluse rahuldamise otsuse muutmise avalduse rahuldamisest võib keelduda, kui muudatused ei ole kooskõlas projekti sisu ja eesmärkidega, otsuse muutmise korral ei oleks projekti elluviimist võimalik lõpetada § 13 lõikes 2 sätestatud tähtajaks või otsuse muutmist ei võimalda meetme eelarve. 4 (4) Rahandusministeerium otsustab taotluse rahuldamise otsuse muutmise 21 kalendripäeva jooksul pärast vastavasisulise taotluse saamist. Rahandusministeerium otsustab taotluse rahuldamise otsuse muutmise 21 kalendripäeva jooksul pärast vastavasisulise taotluse saamist. 5 (5) Taotluse rahuldamise otsuse võib tunnistata kehtetuks „Perioodi 2007–2013 struktuuritoetuse seaduse” § 18 lõikes 6 sätestatud alustel. Taotluse rahuldamise otsuse võib tunnistata kehtetuks „Perioodi 2007–2013 struktuuritoetuse seaduse” § 18 lõikes 6 sätestatud alustel. 6 (6) Taotluse rahuldamise otsuse kehtetuks tunnistamise otsuse teeb Rahandusministeerium 30 kalendripäeva jooksul taotluse rahuldamise otsuse kehtetuks tunnistamise aluseks olevate asjaolude ilmnemise päevast arvates. Taotluse rahuldamise otsuse kehtetuks tunnistamise otsuse teeb Rahandusministeerium 30 kalendripäeva jooksul taotluse rahuldamise otsuse kehtetuks tunnistamise aluseks olevate asjaolude ilmnemise päevast arvates.",
      "rdfs:label": {
        "@value": "Reg_1000267_Par_24 (redaktsioon 1000267)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000267",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000267",
      "estleg:sourceAct": "Prioriteetse suuna „Suurem haldusvõimekus” meetme „Avalike teenistujate, kohalike omavalitsuste ja mittetulundusühingute töötajate koolitus ja arendamine” rakendamiseks toetuse andmise ja kasutamise tingimused ning kord",
      "estleg:provisionRef": "Reg_1000267 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000267_Map"
      }
    },
    {
      "@id": "estleg:Reg_1000267_Par_25_v1000267",
      "@type": [
