      }
    },
    {
      "@id": "estleg:Reg_1000267_Par_5_v1000267",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000267_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahandusministeerium moodustab ekspertidest meetme juhtkomisjoni ja kehtestab selle töökorra. Meetme juhtkomisjoni põhiülesandeks on taotluste hindamine ja meetme eesmärkide saavutamise jälgimine. RT I 2012-01-31 2 131012012002 2012-02-03 Rahandusministeerium moodustab ekspertidest meetme juhtkomisjoni ja kehtestab selle töökorra. Meetme juhtkomisjoni põhiülesandeks on taotluste hindamine ja meetme eesmärkide saavutamise jälgimine.",
      "rdfs:label": {
        "@value": "Reg_1000267_Par_5 (redaktsioon 1000267)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000267",
