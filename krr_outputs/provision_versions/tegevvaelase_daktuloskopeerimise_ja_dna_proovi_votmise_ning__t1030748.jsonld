      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Daktüloskopeerimisel saadud andmed edastab Politsei- ja Piirivalveamet 30 päeva jooksul tegevväelase daktüloskopeerimisest arvates riikliku sõrmejälgede registri volitatud töötlejale andmete riiklikusse sõrmejälgede registrisse ja automaatse biomeetrilise isikutuvastuse süsteemi andmekogusse kandmiseks. RT I 2021-12-31 26 131122021026 2022-01-03 Daktüloskopeerimisel saadud andmed edastab Politsei- ja Piirivalveamet 30 päeva jooksul tegevväelase daktüloskopeerimisest arvates riikliku sõrmejälgede registri volitatud töötlejale andmete riiklikusse sõrmejälgede registrisse ja automaatse biomeetrilise isikutuvastuse süsteemi andmekogusse kandmiseks.",
      "rdfs:label": {
        "@value": "Reg_1030748_Par_4 (redaktsioon 1030748)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030748",
