    {
      "@id": "estleg:Reg_1030748_Par_6_v1030748",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030748_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) DNA-prooviga karpi säilitatakse ja edastatakse kaitstuna otsese päikesevalguse ning soojus- ja niiskusallika eest, samuti pakendit kahjustava mehaanilise mõjutuse eest. DNA-prooviga karpi ei tohi paigutada kilekotti. DNA-prooviga karpi säilitatakse ja edastatakse kaitstuna otsese päikesevalguse ning soojus- ja niiskusallika eest, samuti pakendit kahjustava mehaanilise mõjutuse eest. DNA-prooviga karpi ei tohi paigutada kilekotti. 2 (2) Vahendite soetamisel peab järgima riikliku DNA-registri volitatud töötleja kirjalikke soovitusi ja nõudeid. Vahendite soetamisel peab järgima riikliku DNA-registri volitatud töötleja kirjalikke soovitusi ja nõudeid. 3 (3) DNA-proove säilitatakse ja edastatakse viisil, mis välistab nende hoidmise või edastamisega mitteseotud isikute juurdepääsu. DNA-proove säilitatakse ja edastatakse viisil, mis välistab nende hoidmise või edastamisega mitteseotud isikute juurdepääsu. 4 (4) Politsei- ja Piirivalveamet edastab pakendatud DNA-proovi koos proovi võtmise vormi ja sellele lisatud kaaskirjaga 30 päeva jooksul proovi võtmisest arvates riikliku DNA-registri volitatud töötlejale andmete riiklikusse DNA-registrisse kandmiseks. Politsei- ja Piirivalveamet edastab pakendatud DNA-proovi koos proovi võtmise vormi ja sellele lisatud kaaskirjaga 30 päeva jooksul proovi võtmisest arvates riikliku DNA-registri volitatud töötlejale andmete riiklikusse DNA-registrisse kandmiseks.",
      "rdfs:label": {
        "@value": "Reg_1030748_Par_6 (redaktsioon 1030748)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030748",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030748",
      "estleg:sourceAct": "Tegevväelase daktüloskopeerimise ja DNA-proovi võtmise ning daktüloskopeerimisel saadud andmete ja DNA-proovide edastamise kord",
      "estleg:provisionRef": "Reg_1030748 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030748_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030748_Par_7_v1030748",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030748_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tegevväelase daktüloskopeerimisel ja DNA-proovi analüüsimisel saadud andmed kustutatakse riiklikest registritest kolme aasta möödumisel tegevväelase kaitseväeteenistusest vabastamisest arvates. Tegevväelase daktüloskopeerimisel ja DNA-proovi analüüsimisel saadud andmed kustutatakse riiklikest registritest kolme aasta möödumisel tegevväelase kaitseväeteenistusest vabastamisest arvates. 2 (2) Kaitsevägi teavitab Eesti Kohtuekspertiisi Instituuti vajadusest kustutada tegevväelase andmed riiklikest registritest 30 päeva jooksul tegevväelase kaitseväeteenistusest vabastamisest arvates. Kaitsevägi teavitab Eesti Kohtuekspertiisi Instituuti vajadusest kustutada tegevväelase andmed riiklikest registritest 30 päeva jooksul tegevväelase kaitseväeteenistusest vabastamisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1030748_Par_7 (redaktsioon 1030748)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030748",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030748",
      "estleg:sourceAct": "Tegevväelase daktüloskopeerimise ja DNA-proovi võtmise ning daktüloskopeerimisel saadud andmete ja DNA-proovide edastamise kord",
      "estleg:provisionRef": "Reg_1030748 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030748_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030748_Par_8_v1030748",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
