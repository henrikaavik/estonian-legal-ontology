      "estleg:provisionRef": "Reg_1030748 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030748_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030748_Par_4_v1030748",
      "@type": [
        "owl:NamedIndividual",
