      }
    },
    {
      "@id": "estleg:Reg_342003_Par_3_6_v342003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_342003_Par_3_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Massibilansi süsteemi loetakse toimivaks, kui: 1 1) see võimaldab korraldada saadetiste, mis sisaldavad erinevate säästlikkuse kriteeriumidega toorainet või biokütust (edaspidi segu), omavahelisest segamist ja segamisest arvestuse pidamist; 2 2) segu puhul on tagatud teave iga segu koosseisu kuuluva saadetise säästlikkuse kriteeriumitele vastavuse ja saadetise koguse kohta; 3 3) segust saadetiste väljastamisel on tagatud, et segust eemaldatud kõigi saadetiste summat kirjeldatakse nii, nagu sellel oleks samad säästlikkuse näitajad ja samad kogused kui segule lisatud kõigi saadetiste summal.. RT I 2013-07-30 1 130072013001 2013-08-02 Massibilansi süsteemi loetakse toimivaks, kui: see võimaldab korraldada saadetiste, mis sisaldavad erinevate säästlikkuse kriteeriumidega toorainet või biokütust (edaspidi segu), omavahelisest segamist ja segamisest arvestuse pidamist; segu puhul on tagatud teave iga segu koosseisu kuuluva saadetise säästlikkuse kriteeriumitele vastavuse ja saadetise koguse kohta; segust saadetiste väljastamisel on tagatud, et segust eemaldatud kõigi saadetiste summat kirjeldatakse nii, nagu sellel oleks samad säästlikkuse näitajad ja samad kogused kui segule lisatud kõigi saadetiste summal..",
      "rdfs:label": {
        "@value": "Reg_342003_Par_3_6 (redaktsioon 342003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "342003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/342003",
      "estleg:sourceAct": "Nõuded vedelkütusele",
      "estleg:provisionRef": "Reg_342003 § 3_6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_342003_Map"
      }
    },
    {
      "@id": "estleg:Reg_342003_Par_3_7_v342003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_342003_Par_3_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhul kui järelevalveasutus nõuab biokütuse käitlejalt või tarneahelas osalevalt isikult andmeid käesoleva määruse § 31 lõike 1 punkti 3 alusel ning saadetise vastavust biokütuse säästlikkuse kriteeriumidele on tõendatud käesoleva määruse § 32 lõike 3 punktis 1 või 2 nimetatud skeemi abil, ei või järelevalveasutus nõuda täiendavaid tõendeid § 32 lõike 1 punktis 3 nimetatud kriteeriumide osas ja § 32 lõike 2 punktides 1–3 nimetatud teavet tarneahela osades, mida see konkreetne skeem hõlmab. RT I 2013-07-30 1 130072013001 2013-08-02 Juhul kui järelevalveasutus nõuab biokütuse käitlejalt või tarneahelas osalevalt isikult andmeid käesoleva määruse § 31 lõike 1 punkti 3 alusel ning saadetise vastavust biokütuse säästlikkuse kriteeriumidele on tõendatud käesoleva määruse § 32 lõike 3 punktis 1 või 2 nimetatud skeemi abil, ei või järelevalveasutus nõuda täiendavaid tõendeid § 32 lõike 1 punktis 3 nimetatud kriteeriumide osas ja § 32 lõike 2 punktides 1–3 nimetatud teavet tarneahela osades, mida see konkreetne skeem hõlmab.",
