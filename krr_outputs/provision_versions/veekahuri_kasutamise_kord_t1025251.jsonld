        "@value": "2014-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võimaluse korral veekahuri kasutamine videosalvestatakse. Võimaluse korral veekahuri kasutamine videosalvestatakse.",
      "rdfs:label": {
