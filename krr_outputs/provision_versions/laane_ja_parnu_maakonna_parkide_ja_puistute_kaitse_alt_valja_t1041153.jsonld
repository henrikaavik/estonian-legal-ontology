    {
      "@id": "estleg:Reg_1041153_Par_5_v1041153",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041153_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 28. mai 2010. a käskkirjaga nr 779 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 28. mai 2010. a käskkirjaga nr 779 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1041153_Par_5 (redaktsioon 1041153)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041153",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041153",
      "estleg:sourceAct": "Lääne ja Pärnu maakonna parkide ja puistute kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1041153 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041153_Map"
      }
    },
    {
      "@id": "estleg:Reg_1041153_Par_6_v1041153",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041153_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1041153_Par_6 (redaktsioon 1041153)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041153",
