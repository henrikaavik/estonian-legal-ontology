      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Volitatud laborina tegutsemise õiguse andmise, muutmise, peatamise ja kehtetuks tunnistamise kord (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Volitatud laborina tegutsemise õiguse andmise, muutmise, peatamise ja kehtetuks tunnistamise kord"
    },
    {
      "@id": "estleg:Reg_155432_Par_1_v155432",
      "@type": [
