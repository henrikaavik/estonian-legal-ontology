      },
      "estleg:versionText": "Jaotusvõrgu pingekvaliteedi tagamisel on soovitatav lähtuda standardist EVS-EN 50160. RT I 2014-06-13 12 113062014012 2014-06-16 Jaotusvõrgu pingekvaliteedi tagamisel on soovitatav lähtuda standardist EVS-EN 50160.",
      "rdfs:label": {
        "@value": "Reg_158617_Par_6 (redaktsioon 158617)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158617",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158617",
      "estleg:sourceAct": "Võrguteenuste kvaliteedinõuded ja võrgutasude vähendamise tingimused kvaliteedinõuete rikkumise korral",
      "estleg:provisionRef": "Reg_158617 § 6",
