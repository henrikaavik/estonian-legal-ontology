      "estleg:versionValidFrom": {
        "@value": "2017-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse põllumajanduskultuuri üleminekutoetuse ja heinaseemne üleminekutoetuse (edaspidi koos ka toetus) saamise täpsemad nõuded ning toetuse taotlemise ja taotluse menetlemise kord. Määrusega kehtestatakse põllumajanduskultuuri üleminekutoetuse ja heinaseemne üleminekutoetuse (edaspidi koos ka toetus) saamise täpsemad nõuded ning toetuse taotlemise ja taotluse menetlemise kord.",
      "rdfs:label": {
        "@value": "Reg_1038521_Par_1 (redaktsioon 1038521)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038521",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038521",
      "estleg:sourceAct": "Põllumajanduskultuuri ja heinaseemne üleminekutoetus",
      "estleg:provisionRef": "Reg_1038521 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038521_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1038521_Par_10_v1038521",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038521_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) PRIA teeb toetuse taotluse rahuldamise või rahuldamata jätmise otsused taotluse esitamise aasta 10. detsembriks. PRIA teeb toetuse taotluse rahuldamise või rahuldamata jätmise otsused taotluse esitamise aasta 10. detsembriks. 2 (2) PRIA teeb toetuse taotluse rahuldamata jätmise otsused Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse §-s 30 sätestatud alustel. PRIA teeb toetuse taotluse rahuldamata jätmise otsused Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse §-s 30 sätestatud alustel.",
      "rdfs:label": {
        "@value": "Reg_1038521_Par_10 (redaktsioon 1038521)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038521",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038521",
      "estleg:sourceAct": "Põllumajanduskultuuri ja heinaseemne üleminekutoetus",
      "estleg:provisionRef": "Reg_1038521 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038521_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1038521_Par_11_v1038521",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038521_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus makstakse välja taotluse esitamise aastale järgneva aasta 30. juuniks. Toetus makstakse välja taotluse esitamise aastale järgneva aasta 30. juuniks.",
      "rdfs:label": {
        "@value": "Reg_1038521_Par_11 (redaktsioon 1038521)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038521",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038521",
      "estleg:sourceAct": "Põllumajanduskultuuri ja heinaseemne üleminekutoetus",
      "estleg:provisionRef": "Reg_1038521 § 11",
