    },
    {
      "@id": "estleg:Reg_1038521_Par_1_v1038521",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038521_Par_1"
