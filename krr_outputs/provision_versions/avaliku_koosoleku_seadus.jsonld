    },
    {
      "@id": "estleg:AvKS_Par_1_v22373",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AvKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seaduse ülesanne Eesti Vabariigi põhiseaduse § 47 alusel on: tagada inimeste õigus rahumeelselt koguneda ja koosolekuid pidada kooskõlas inimeste põhiõiguste, vabaduste ja kohustustega ning demokraatliku õigusriigi põhimõtetega; kehtestada avalike koosolekute korraldamisele ja läbiviimisele piirangud, mis on vajalikud riigi julgeoleku, avaliku korra, kõlbluse, liiklusohutuse ja koosolekust osavõtjate ohutuse tagamiseks ning nakkushaiguse leviku tõkestamiseks.",
      "rdfs:label": {
        "@value": "AvKS_Par_1 (redaktsioon 22373)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22373",
      "estleg:supersededByVersion": {
        "@id": "estleg:AvKS_Par_1_v190297"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AvKS_Par_1_v190297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AvKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "SeaduseülesanneEestiVabariigipõhiseaduse § 47 alusel on: tagadainimesteõigusrahumeelseltkogunedajakoosolekuidpidadakooskõlasinimestepõhiõiguste, vabadustejakohustusteganingdemokraatlikuõigusriigipõhimõtetega; kehtestadaavalikekoosolekutekorraldamiselejaläbiviimiselepiirangud, mis on vajalikudriigijulgeoleku, avalikukorra, kõlbluse, liiklusohutusejakoosolekustosavõtjateohutusetagamiseksningnakkushaiguselevikutõkestamiseks.",
      "rdfs:label": {
        "@value": "AvKS_Par_1 (redaktsioon 190297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "190297",
      "estleg:supersededByVersion": {
        "@id": "estleg:AvKS_Par_1_v1027868"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AvKS_Par_1_v1027868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
