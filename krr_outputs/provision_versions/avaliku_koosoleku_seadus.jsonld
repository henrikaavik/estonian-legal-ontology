        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AvKS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrapidaja on kohustatudtäitmajärgmisiavalikukoosolekuläbiviimisenõudeid: viibimaavalikukoosolekuläbiviimisekohas; tegemakohalviibivalepolitseiametnikuleettepanekutemakorraldusieiravateisikutekoosolekultkõrvaldamiseks; täitmapolitseiningmeditsiini- ja päästeteenistuseametnikekorraldusi; kandmahästinähtavateraldusmärkitähistusega \"KORRAPIDAJA\".",
      "rdfs:label": {
