        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AvKS_Par_7_v1027868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AvKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korraldaja peab vähemalt seitse päeva enne avaliku koosoleku läbiviimise päeva esitama käesoleva seaduse §-s 8 tähendatud teate: valla- või linnavalitsusele, mille haldusterritooriumil kavatsetakse avalik koosolek korraldada; maavalitsusele, kui avalik koosolek kavatsetakse korraldada selle maakonna mitme valla või linna haldusterritooriumil; Vabariigi Valitsusele, kui avalik koosolek kavatsetakse korraldada mitme maakonna haldusterritooriumil. (2) Kui avaliku koosoleku läbiviimine eeldab liikluse ümberkorraldamist, peab korraldaja esitama käesoleva seaduse §-s 8 tähendatud teate 10 päeva enne avaliku koosoleku läbiviimise päeva.",
      "rdfs:label": {
        "@value": "AvKS_Par_7 (redaktsioon 1027868)",
        "@language": "et"
