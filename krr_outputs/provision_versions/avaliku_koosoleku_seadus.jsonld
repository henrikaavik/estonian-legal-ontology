      }
    },
    {
      "@id": "estleg:AvKS_Par_10_v190297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AvKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valitsusasutus ja kohalikuomavalitsuse asutus registreerivadavalikukoosolekuteated. Teadetearvestussisaldabjärgmisiandmeid: teatesaamisekuupäev ja teateregistreerimisenumber; koosolekukorraldajaees- ja perekonnanimi, sünniaasta, kodakondsus, elukohtEestis; koosolekutkorraldavajuriidiliseisikuvõijuriidiliseksisikuksmitteolevaühenduse nimi ja aadress; koosolekuvorm; koosolekueesmärk; osavõtjateeeldatavarv; kogunemiskoht; läbiviimisekoht; liikumismarsruut; alguse ja lõpukuupäevningkellaaeg; kooskõlastusedkoosolekustosavõtjateohutusetagamiseks. (2) Andmedavalikukoosolekuteadetearvestuse kohta on avalikud.",
      "rdfs:label": {
        "@value": "AvKS_Par_10 (redaktsioon 190297)",
        "@language": "et"
      },
