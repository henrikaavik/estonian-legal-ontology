    {
      "@id": "estleg:AvKS_Par_12_v22373",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AvKS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrapidaja on kohustatud täitma järgmisi avaliku koosoleku läbiviimise nõudeid: viibima avaliku koosoleku läbiviimise kohas; tegema kohalviibivale politseiametnikule ettepaneku tema korraldusi eiravate isikute koosolekult kõrvaldamiseks; täitma politsei ning meditsiini- ja päästeteenistuse ametnike korraldusi; kandma hästi nähtavat eraldusmärki tähistusega \"KORRAPIDAJA\".",
      "rdfs:label": {
        "@value": "AvKS_Par_12 (redaktsioon 22373)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22373",
      "estleg:supersededByVersion": {
        "@id": "estleg:AvKS_Par_12_v190297"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
