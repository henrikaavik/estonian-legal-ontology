    },
    {
      "@id": "estleg:AvKS_Par_3_v22373",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AvKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keelatud on korraldada avalikku koosolekut, mis: on suunatud Eesti Vabariigi iseseisvuse ja sõltumatuse vastu või kehtiva riigikorra vägivaldsele muutmisele; õhutab vägivaldselt rikkuma Eesti Vabariigi territoriaalset terviklikkust; õhutab rahvuslikku, rassilist, usulist või poliitilist vihkamist, vägivalda või diskrimineerimist ühiskonnakihtide vahel; õhutab rikkuma avalikku korda või riivab kõlblust.",
      "rdfs:label": {
        "@value": "AvKS_Par_3 (redaktsioon 22373)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22373",
      "estleg:supersededByVersion": {
        "@id": "estleg:AvKS_Par_3_v190297"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AvKS_Par_3_v190297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AvKS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keelatud on korraldadaavalikkukoosolekut, mis: on suunatudEestiVabariigiiseseisvusejasõltumatusevastuvõikehtivariigikorravägivaldselemuutmisele; õhutabvägivaldseltrikkumaEestiVabariigiterritoriaalsetterviklikkust; õhutabrahvuslikku, rassilist, usulistvõipoliitilistvihkamist, vägivaldavõidiskrimineerimistühiskonnakihtidevahel; õhutabrikkumaavalikkukordavõiriivabkõlblust.",
