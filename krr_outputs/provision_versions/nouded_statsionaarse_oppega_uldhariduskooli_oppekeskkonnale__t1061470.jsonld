    {
      "@id": "estleg:Reg_1061470_Par_8_v1061470",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061470_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hügieeniruumid on riietusruumid, duširuumid ja tualettruumid. Hügieeniruumid on riietusruumid, duširuumid ja tualettruumid. 2 (2) Koolis peab olema õpilaste ja koolipersonali hulka arvestavalt piisaval arvul hästi ligipääsetavaid puhtaid hügieeniruume, mis on varustatud isikliku hügieeni tagamiseks vajalike vahenditega. Koolis peab olema õpilaste ja koolipersonali hulka arvestavalt piisaval arvul hästi ligipääsetavaid puhtaid hügieeniruume, mis on varustatud isikliku hügieeni tagamiseks vajalike vahenditega. 3 (3) Hügieeniruumid peavad võimaldama privaatsust neid kasutavatele inimestele. Hügieeniruumid peavad võimaldama privaatsust neid kasutavatele inimestele.",
      "rdfs:label": {
        "@value": "Reg_1061470_Par_8 (redaktsioon 1061470)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061470",
