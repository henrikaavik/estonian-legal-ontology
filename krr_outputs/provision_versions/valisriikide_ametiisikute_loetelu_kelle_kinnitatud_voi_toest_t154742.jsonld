      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Välisriikide ametiisikute loetelu, kelle kinnitatud või tõestatud volikiri on võrdne Eesti notari tõestatud volikirjaga (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Välisriikide ametiisikute loetelu, kelle kinnitatud või tõestatud volikiri on võrdne Eesti notari tõestatud volikirjaga"
    },
    {
      "@id": "estleg:Reg_154742_Par_1_v154742",
      "@type": [
        "owl:NamedIndividual",
