    },
    {
      "@id": "estleg:Reg_1055413_Par_4_v1055413",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055413_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Regionaalne tervisespordikeskus (edaspidi tervisepordikeskus) käesoleva määruse tähenduses on maakonnas või piirkonnas keskselt kasutatav liikumise harrastamiseks loodud taristu, kus on võimalik vabas õhus aasta läbi peamiselt tasuta harrastada erinevaid liikumisviise. Muu hulgas on seal kunstlume tootmisvõimekus ja valgustatud liikumisrajad. Regionaalne tervisespordikeskus (edaspidi tervisepordikeskus) käesoleva määruse tähenduses on maakonnas või piirkonnas keskselt kasutatav liikumise harrastamiseks loodud taristu, kus on võimalik vabas õhus aasta läbi peamiselt tasuta harrastada erinevaid liikumisviise. Muu hulgas on seal kunstlume tootmisvõimekus ja valgustatud liikumisrajad. 2 (2) Tervisespordikeskus ei hõlma spetsiifilisi spordirajatisi, nagu võimlad, ujulad, lasketiirud ja muu sarnane. Tervisespordikeskus ei hõlma spetsiifilisi spordirajatisi, nagu võimlad, ujulad, lasketiirud ja muu sarnane.",
      "rdfs:label": {
        "@value": "Reg_1055413_Par_4 (redaktsioon 1055413)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055413",
