    {
      "@id": "estleg:Reg_1055413_Par_19_v1055413",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055413_Par_19"
