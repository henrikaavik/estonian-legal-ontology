      },
      "estleg:versionValidFrom": {
        "@value": "2007-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvis 1 nimetatud konventsiooni muudatuste heakskiitmise kooskõlas konventsiooni artiklitega 31 ja 32 otsustab Vabariigi Valitsus, kui muudatused käsitlevad ainete ja materjalide nimekirju või kui muudatused ei ole sisulist laadi ning nende rakendamiseks ei ole tarvis muuta Eesti seadusi.",
      "rdfs:label": {
        "@value": "laanemere_piirkonna_merekeskkonna_kaitse_konventsi_Par_3 (redaktsioon 12815904)",
