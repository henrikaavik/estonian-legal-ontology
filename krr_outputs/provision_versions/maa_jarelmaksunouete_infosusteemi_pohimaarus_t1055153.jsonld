    {
      "@id": "estleg:Reg_1055153_Par_17_v1055153",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055153_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu täielik varukoopia tehakse üks kord nädalas ning ülejäänud päevadel kopeeritakse lisandunud ja muutunud failid. Kõiki varukoopiaid säilitatakse vähemalt kuu aega. Andmekogu täielik varukoopia tehakse üks kord nädalas ning ülejäänud päevadel kopeeritakse lisandunud ja muutunud failid. Kõiki varukoopiaid säilitatakse vähemalt kuu aega. 2 (2) Iga kalendrikuu lõpus tehakse varukoopia andmekogu välisele andmekandjale, mida säilitakse üks aasta. Iga kalendrikuu lõpus tehakse varukoopia andmekogu välisele andmekandjale, mida säilitakse üks aasta. 3 (3) Üks kord aastas tehakse varukoopia, mida säilitatakse seitse aastat. Üks kord aastas tehakse varukoopia, mida säilitatakse seitse aastat.",
      "rdfs:label": {
        "@value": "Reg_1055153_Par_17 (redaktsioon 1055153)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055153",
