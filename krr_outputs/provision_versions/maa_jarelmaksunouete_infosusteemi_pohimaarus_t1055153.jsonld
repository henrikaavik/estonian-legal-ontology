      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu hooldus- ja arendustöid ning pidamist finantseeritakse riigieelarvest ja muudest allikatest, mis on seotud andmekogu pidamise eelduseks olevate tegevustega vastutavale töötlejale selleks otstarbeks eraldatud vahenditest. Andmekogu hooldus- ja arendustöid ning pidamist finantseeritakse riigieelarvest ja muudest allikatest, mis on seotud andmekogu pidamise eelduseks olevate tegevustega vastutavale töötlejale selleks otstarbeks eraldatud vahenditest.",
      "rdfs:label": {
        "@value": "Reg_1055153_Par_18 (redaktsioon 1055153)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055153",
