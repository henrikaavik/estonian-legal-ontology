    },
    {
      "@id": "estleg:Reg_1055153_Par_1_v1055153",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055153_Par_1"
