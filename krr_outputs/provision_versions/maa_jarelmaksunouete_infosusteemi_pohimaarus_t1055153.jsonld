      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu likvideerimisel otsustatakse andmete teise andmekogusse või riiklikku registrisse või riiklikku arhiivi üleandmine või andmete hävitamisele kuulumine ja nende üleandmise või hävitamise tähtaeg. Andmekogu likvideerimisel otsustatakse andmete teise andmekogusse või riiklikku registrisse või riiklikku arhiivi üleandmine või andmete hävitamisele kuulumine ja nende üleandmise või hävitamise tähtaeg.",
      "rdfs:label": {
        "@value": "Reg_1055153_Par_19 (redaktsioon 1055153)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055153",
