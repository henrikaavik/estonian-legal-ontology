      }
    },
    {
      "@id": "estleg:ProkS_Par_39_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaarsüütegu arutab distsiplinaarkomisjon kinnisel istungil. (2) Distsiplinaarkomisjon on otsustusvõimeline, kui istungist võtab osa vähemalt kolm distsiplinaarkomisjoni liiget, sealhulgas esimees. (3) Distsiplinaarkomisjoni istungit juhatab distsiplinaarkomisjoni esimees. (4) Distsiplinaarkomisjoni liikmena ei saa isik osaleda temale esitatud distsiplinaarsüüdistuse arutamisel.",
      "rdfs:label": {
        "@value": "ProkS_Par_39 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_39_v116032011007"
      },
      "estleg:versionValidTo": {
        "@value": "2011-03-25",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_39_v116032011007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaarsüütegu arutab distsiplinaarkomisjon kinnisel istungil. (2) Distsiplinaarkomisjon on otsusevõimeline, kui istungist võtab osa vähemalt kolm distsiplinaarkomisjoni liiget, sealhulgas esimees. (3) Distsiplinaarkomisjoni istungit juhatab distsiplinaarkomisjoni esimees. (4) Distsiplinaarkomisjoni liikmena ei saa isik osaleda temale esitatud distsiplinaarsüüdistuse arutamisel.",
      "rdfs:label": {
        "@value": "ProkS_Par_39 (redaktsioon 116032011007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116032011007",
