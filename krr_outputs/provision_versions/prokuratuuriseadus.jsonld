      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Prokuröri abile säilitatakse 42-kalendripäevane ja muule prokurörile 49-kalendripäevane põhipuhkus kaheks aastaks alates 2013. aasta 1. aprillist juhul, kui nad on 2013. aasta 1. aprilli seisuga kas prokuröri abina või muu prokurörina teenistuses.",
      "rdfs:label": {
        "@value": "ProkS_Par_58_1 (redaktsioon 121122012016)",
        "@language": "et"
      },
