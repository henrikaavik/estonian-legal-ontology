      }
    },
    {
      "@id": "estleg:ProkS_Par_28_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Prokurör ei tohi avaldada temale seoses teenistusülesannete täitmisega teatavaks saanud asjaolusid, kui see võib kahjustada õigusemõistmist. Ametisaladuse hoidmise kohustus on tähtajatu.",
      "rdfs:label": {
        "@value": "ProkS_Par_28 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_29_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa- ja linnaprokurör on kohustatud maakonna või linna vanemprokuröri korraldusel juhendama õppeteenistuses või katseajal olevat abiprokuröri või praktikanti. (2) Maa- ja linnaprokurör ei ole kohustatud juhendama üheaegselt rohkem kui ühte abiprokuröri või praktikanti.",
      "rdfs:label": {
        "@value": "ProkS_Par_29 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_29_v709342"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_29_v709342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnaprokuratuuri prokurör on kohustatud juhtivprokuröri korraldusel juhendama õppeteenistuses või katseajal olevat abiprokuröri või praktikanti. (2) Ringkonnaprokuratuuri prokurör ei ole kohustatud juhendama üheaegselt rohkem kui ühte abiprokuröri või praktikanti.",
      "rdfs:label": {
        "@value": "ProkS_Par_29 (redaktsioon 709342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "709342",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_29_v769408"
      },
      "estleg:versionValidTo": {
        "@value": "2004-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/709342",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_29_v769408",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Prokurör on kohustatud riigi peaprokuröri või juhtivprokuröri korraldusel juhendama praktikanti. (2) Prokurör ei ole kohustatud juhendama üheaegselt rohkem kui ühte praktikanti.",
      "rdfs:label": {
        "@value": "ProkS_Par_29 (redaktsioon 769408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "769408",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/769408",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_3_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi peaprokurör juhib prokuratuuri ja täidab teisi temale seadusega pandud ülesandeid. (2) Kui riigi peaprokurör ei saa haiguse või muu takistuse tõttu ajutiselt oma ülesandeid täita, määrab justiitsminister talle riigiprokuröride hulgast asendaja.",
      "rdfs:label": {
        "@value": "ProkS_Par_3 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_3_v709342"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_3_v709342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi peaprokurör juhib prokuratuuri ja täidab teisi temale seadusega pandud ülesandeid. (2) Kui riigi peaprokurör ei saa haiguse või muu takistuse tõttu ajutiselt oma ülesandeid täita, määrab justiitsminister talle Riigiprokuratuuri prokuröride hulgast asendaja.",
      "rdfs:label": {
        "@value": "ProkS_Par_3 (redaktsioon 709342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "709342",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_3_v121122012016"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/709342",
