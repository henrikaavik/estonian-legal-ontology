      }
    },
    {
      "@id": "estleg:ProkS_Par_16_1_v700679",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_16_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi peaprokuröril on õigus viia riigiprokurör ning maakonna või linna vanemprokurör tema kirjaliku avalduse alusel avaliku konkursita üle maa- või linnaprokuröri ametikohale. - 21. 03. 2003",
      "rdfs:label": {
        "@value": "ProkS_Par_16_1 (redaktsioon 700679)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "700679",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_16_1_v709342"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/700679",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 16_1",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_16_1_v709342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_16_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Justiitsministril on õigus viia juhtiv riigiprokurör, juhtivprokurör või riigiprokurör tema kirjaliku avalduse alusel avaliku konkursita madalamalseisvale avaliku konkursi korras täidetavale prokuröri ametikohale. (2) Riigi peaprokuröril on õigus viia vanemprokurör, eriasjade prokurör või ringkonnaprokurör tema kirjaliku avalduse alusel avaliku konkursita madalamalseisvale avaliku konkursi korras täidetavale prokuröri ametikohale. (3) Riigi peaprokuröril on õigus viia eriasjade prokurör, ringkonnaprokurör või abiprokurör tema nõusolekul ilma avaliku konkursita samale ametikohale teises ringkonnaprokuratuuris.",
      "rdfs:label": {
        "@value": "ProkS_Par_16_1 (redaktsioon 709342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "709342",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_16_1_v769408"
      },
      "estleg:versionValidTo": {
        "@value": "2004-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/709342",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 16_1",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_16_1_v769408",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_16_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Justiitsministril on õigus viia juhtiv riigiprokurör, juhtivprokurör või riigiprokurör tema kirjaliku avalduse alusel avaliku konkursita madalamalseisvale avaliku konkursi korras täidetavale prokuröri ametikohale. (2) Riigi peaprokuröril on õigus viia vanemprokurör, eriasjade prokurör või ringkonnaprokurör tema kirjaliku avalduse alusel avaliku konkursita madalamalseisvale avaliku konkursi korras täidetavale prokuröri ametikohale. (3) Riigi peaprokuröril on õigus viia eriasjade prokurör, ringkonnaprokurör või prokuröri abi tema nõusolekul ilma avaliku konkursita samale ametikohale teises prokuratuuris. (4) Prokuröri üleviimisel ühest teenistuspiirkonnast teise võib talle alates uude teenistuspiirkonda asumisest kahe kuu jooksul hüvitada seoses elukohavahetusega tekkinud kulutused. (5) Käesoleva paragrahvi lõikes 4 nimetatud kulutuste hüvitamise korra kehtestab justiitsminister määrusega.",
      "rdfs:label": {
        "@value": "ProkS_Par_16_1 (redaktsioon 769408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "769408",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_16_1_v905098"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-04",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/769408",
