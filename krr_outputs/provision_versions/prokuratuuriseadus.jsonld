      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "ProkS_Par_56 (redaktsioon 1027986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027986",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_56_v13153853"
      },
      "estleg:versionValidTo": {
        "@value": "2009-03-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027986",
