      }
    },
    {
      "@id": "estleg:ProkS_Par_4_v121122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigiprokuratuuri prokurörid tagavad kohtueelse menetluse seaduslikkuse ja tulemuslikkuse ning esindavad riiklikku süüdistust kohtus ja täidavad teisi seadusega neile pandud ülesandeid. (2) Riigiprokuratuuri prokurörid on riigi peaprokurör, juhtivad riigiprokurörid, riigiprokurörid ja prokuröri abid. (3) Riigiprokuratuur võib jaguneda osakondadeks, mille kinnitab . Osakonda kuuluvad riigiprokurörid ja prokuröri abid määrab riigi peaprokurör. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „justiitsminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "ProkS_Par_4 (redaktsioon 121122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122012016",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_4_v110032015017"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122012016",
