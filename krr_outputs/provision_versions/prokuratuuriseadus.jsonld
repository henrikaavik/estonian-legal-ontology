      }
    },
    {
      "@id": "estleg:ProkS_Par_49_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Distsiplinaarsüüteo eest vabastatakse prokurör teenistusest käesoleva seaduse 5. jaos sätestatud korras.",
      "rdfs:label": {
        "@value": "ProkS_Par_49 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 49",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_4_1_v709342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_4_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juhtiv riigiprokurör juhib Riigiprokuratuuri osakonda ja täidab teisi seadusega temale pandud ülesandeid. (2) Oma vastutusvaldkonnas on juhtival riigiprokuröril õigus anda korraldusi ringkonnaprokuratuuridele. (3) Riigi peaprokurör määrab juhtivale riigiprokurörile Riigiprokuratuuri prokuröride hulgast asendaja juhuks, kui juhtiv riigiprokurör ei saa haiguse või muu takistuse tõttu ajutiselt oma ülesandeid täita.",
      "rdfs:label": {
        "@value": "ProkS_Par_4_1 (redaktsioon 709342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "709342",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/709342",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 4_1",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_5_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa- ja linnaprokuratuuri prokurörid valvavad kriminaalasjade kohtueelse menetluse seaduslikkuse järele, esindavad riiklikku süüdistust maa- ja linnakohtutes ning täidavad teisi seadusega neile pandud ülesandeid. (2) Maa- ja linnaprokuratuuri prokurörid on maakonna või linna vanemprokurör, maa- või linnaprokurörid ja abiprokurörid. (3) Maa- ja linnaprokuratuurid moodustab ja nende tööpiirkonnad kinnitab justiitsminister, lähtudes tõhusa ja säästliku justiitshalduse nõuetest. (4) Maa- ja linnaprokuratuur võib jaguneda osakondadeks, mille kinnitab justiitsminister. Osakonda juhtiva prokuröri ning osakonda kuuluvad maa- ja linnaprokurörid ja abiprokurörid määrab maakonna või linna vanemprokurör. (5) [Kehtetu]",
      "rdfs:label": {
        "@value": "ProkS_Par_5 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_5_v709342"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_5_v709342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnaprokuratuuri prokurörid tagavad kohtueelse menetluse seaduslikkuse ja tulemuslikkuse ning esindavad riiklikku süüdistust kohtus ja täidavad teisi seadusega neile pandud ülesandeid. (2) Ringkonnaprokuratuuri prokurörid on juhtivprokurör, vanemprokurörid, eriasjade prokurörid, ringkonnaprokurörid ja abiprokurörid. (3) Ringkonnaprokuratuuri asukoha ja tööpiirkonna kehtestab Vabariigi Valitsus määrusega. (4) Ringkonnaprokuratuur võib jaguneda osakondadeks, mille kinnitab justiitsminister. Osakonda kuuluvad eriasjade prokurörid, ringkonnaprokurörid ja abiprokurörid määrab juhtivprokurör. Juhtivprokuröril on õigus ilma konkursita viia sama ringkonnaprokuratuuri tööpiirkonnas ringkonnaprokuratuuri prokurör tema nõusolekul ühest piirkondlikust osakonnast teise.",
      "rdfs:label": {
        "@value": "ProkS_Par_5 (redaktsioon 709342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "709342",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_5_v769408"
      },
      "estleg:versionValidTo": {
        "@value": "2004-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/709342",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
