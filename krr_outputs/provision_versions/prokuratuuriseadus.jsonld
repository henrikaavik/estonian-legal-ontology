      }
    },
    {
      "@id": "estleg:ProkS_Par_34_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaarkaristuse määramise õigus on justiitsministril distsiplinaarkomisjoni ettepanekul. (2) Riigi peaprokuröri teenistusest vabastamise distsiplinaarkaristusena otsustab Vabariigi Valitsus justiitsministri ettepanekul ühe kuu jooksul.",
      "rdfs:label": {
        "@value": "ProkS_Par_34 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_34_v700679"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_34_v700679",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Prokurörile distsiplinaarkaristuse määramise õigus on: justiitsministril kõigi prokuröride suhtes prokuröride distsiplinaarkomisjoni ettepanekul; riigi peaprokuröril maa- ja linnaprokuröride ning abiprokuröride suhtes prokuröride distsiplinaarkomisjoni ettepanekul. (2) Riigi peaprokuröri teenistusest vabastamise distsiplinaarkaristusena otsustab Vabariigi Valitsus justiitsministri ettepanekul ühe kuu jooksul. - 21. 03. 2003",
      "rdfs:label": {
        "@value": "ProkS_Par_34 (redaktsioon 700679)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "700679",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_34_v709342"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/700679",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_34_v709342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
