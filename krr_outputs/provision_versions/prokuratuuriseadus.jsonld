      }
    },
    {
      "@id": "estleg:ProkS_Par_38_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Prokurörile, kelle vastu distsiplinaarmenetlus on algatatud, antakse distsiplinaarsüüdistus kätte vähemalt kolm päeva enne distsiplinaarkomisjoni istungit. (2) Prokuröril, kellele esitati distsiplinaarsüüdistus, on õigus tutvuda distsiplinaarsüüdistuse materjalidega. Abiprokuröri distsiplinaarsüüdistuse materjalidega võib tutvuda ka teda juhendav prokurör.",
      "rdfs:label": {
        "@value": "ProkS_Par_38 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_38_v769408"
      },
      "estleg:versionValidTo": {
        "@value": "2004-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_38_v769408",
      "@type": [
