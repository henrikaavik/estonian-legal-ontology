      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi peaprokurör nimetatakse ametisse viieks aastaks. (2) Maakonna ja linna vanemprokurör nimetatakse ametisse viieks aastaks. (3) Riigiprokurör, maa- ja linnaprokurör ning abiprokurör nimetatakse ametisse määramata ajaks.",
      "rdfs:label": {
        "@value": "ProkS_Par_17 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
