    {
      "@id": "estleg:ProkS_Par_36_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaarsüüdistus on kirjalik dokument, milles märgitakse: süüdistatava ees- ja perekonnanimi ning ametikoht; süüteo kirjeldus ja toimepanemise aeg; süüteo toimepanemist kinnitavad tõendid; süüdistuse esitaja, süüdistuse koostamise aeg ja koht. (2) Distsiplinaarsüüdistust ei või esitada ja distsiplinaarmenetlus tuleb lõpetada, kui distsiplinaarsüüteo toimepanemisest on möödunud enam kui üks aasta.",
      "rdfs:label": {
        "@value": "ProkS_Par_36 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_36_v116032011007"
      },
      "estleg:versionValidTo": {
        "@value": "2011-03-25",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 36",
      "estleg:partOfAct": {
