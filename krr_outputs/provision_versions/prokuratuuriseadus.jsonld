      }
    },
    {
      "@id": "estleg:ProkS_Par_47_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Prokuröri võib vabastada teenistusest, kui ta on saanud 65-aastaseks.",
      "rdfs:label": {
        "@value": "ProkS_Par_47 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
