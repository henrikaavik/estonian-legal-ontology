    {
      "@id": "estleg:ProkS_Par_13_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Prokuröride üldkogu on kõigi prokuröride koosolek, mis kutsutakse kokku vähemalt kord aastas. Abiprokurörid osalevad üldkogul sõnaõigusega. (2) Prokuröride üldkogu: valib kaks maa- või linnaprokuratuuri prokuröri ja ühe riigiprokuröri prokuröride konkursi- ja atesteerimiskomisjoni liikmeks; valib kolm maa- või linnaprokuratuuri prokuröri ja ühe riigiprokuröri distsiplinaarkomisjoni liikmeks; kinnitab prokuröride üldkogu töökorra; kuulab ära justiitsministri ja riigi peaprokuröri ettekanded prokuratuuride tegevuse kohta; arutab prokuratuuride tegevuse ja prokuröriteenistuse küsimusi ning teeb ettepanekuid nende lahendamiseks. (3) Prokuröride üldkogu kutsub kokku ja selle tööd juhib riigi peaprokurör.",
      "rdfs:label": {
        "@value": "ProkS_Par_13 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_13_v709342"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 13",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
