      }
    },
    {
      "@id": "estleg:ProkS_Par_4_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigiprokuratuuri prokurörid esindavad riiklikku süüdistust Riigikohtus ja ringkonnakohtutes ning täidavad teisi seadusega neile pandud ülesandeid. (2) Riigiprokuratuuri prokurörid on riigi peaprokurör ja riigiprokurörid. (3) Riigiprokuratuur võib jaguneda osakondadeks, mille kinnitab justiitsminister. Osakonda juhtiva prokuröri ning osakonda kuuluvad riigiprokurörid määrab riigi peaprokurör. (4) [Kehtetu]",
      "rdfs:label": {
        "@value": "ProkS_Par_4 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_4_v709342"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_4_v709342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigiprokuratuuri prokurörid tagavad kohtueelse menetluse seaduslikkuse ja tulemuslikkuse ning esindavad riiklikku süüdistust kohtus ja täidavad teisi seadusega neile pandud ülesandeid. (2) Riigiprokuratuuri prokurörid on riigi peaprokurör, juhtivad riigiprokurörid ja riigiprokurörid. (3) Riigiprokuratuur võib jaguneda osakondadeks, mille kinnitab justiitsminister. Osakonda kuuluvad riigiprokurörid määrab riigi peaprokurör.",
      "rdfs:label": {
        "@value": "ProkS_Par_4 (redaktsioon 709342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "709342",
      "estleg:supersededByVersion": {
