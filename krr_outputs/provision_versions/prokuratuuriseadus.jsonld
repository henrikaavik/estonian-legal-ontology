    },
    {
      "@id": "estleg:ProkS_Par_41_v13153853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Justiitsminister või riigi peaprokurör otsustab distsiplinaarkaristuse määramise või käesoleva seaduse § 34 lõikes 2 nimetatud ettepaneku tegemise ühe kuu jooksul, arvates distsiplinaarkomisjoni ettepaneku saamisest. – 21.03.2003",
      "rdfs:label": {
        "@value": "ProkS_Par_41 (redaktsioon 13153853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13153853",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_41_v116032011007"
      },
      "estleg:versionValidTo": {
        "@value": "2011-03-25",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13153853",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 41",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_41_v116032011007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 32 lõikes 3 nimetatud juhul määrab justiitsminister distsiplinaarkaristuse, otsustab jätta distsiplinaarkaristuse määramata või lõpetab distsiplinaarmenetluse, kui puudub distsiplinaarsüütegu. Riigi peaprokuröri teenistusest vabastamise otsuse korral teeb justiitsminister sellekohase ettepaneku Vabariigi Valitsusele ega määra ise distsiplinaarkaristust. (2) Justiitsminister teeb otsuse ainuisikuliselt.",
      "rdfs:label": {
        "@value": "ProkS_Par_41 (redaktsioon 116032011007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116032011007",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_41_v121122012016"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116032011007",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 41",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_41_v121122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
