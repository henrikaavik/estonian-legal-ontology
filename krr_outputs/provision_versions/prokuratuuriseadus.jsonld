      }
    },
    {
      "@id": "estleg:ProkS_Par_56_v13153853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ProkS_Par_56 (redaktsioon 13153853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13153853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13153853",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 56",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_57_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isiku, kes on saanud akadeemilise kõrghariduse õigusteaduses eraõiguslikus ülikoolis, võib nimetada prokuröriks, kui ta on omandanud kõrghariduse akrediteeritud õppekava alusel.",
      "rdfs:label": {
        "@value": "ProkS_Par_57 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 57",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_57_1_v709342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_57_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kahe aasta jooksul pärast 2004. aasta 1. märtsi nimetatakse vanemprokurörid ametisse kolmeks aastaks. (2) Riigi peaprokurör nimetab käesoleva paragrahvi lõikes 1 sätestatud korras ametisse nimetatud vanemprokuröri tema ametiaja lõppemisel vanemprokuröriks, ringkonnaprokuröriks või eriasjade prokuröriks.",
      "rdfs:label": {
        "@value": "ProkS_Par_57_1 (redaktsioon 709342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "709342",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/709342",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 57_1",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_58_v22409",
      "@type": [
