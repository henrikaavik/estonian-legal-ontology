      }
    },
    {
      "@id": "estleg:ProkS_Par_48_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Prokurör vabastatakse teenistusest, kui on välja kuulutatud tema pankrot.",
      "rdfs:label": {
        "@value": "ProkS_Par_48 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
