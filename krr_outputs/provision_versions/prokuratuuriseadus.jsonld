      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abiprokurör vabastatakse teenistusest, kui ta ei soorita prokurörieksamit või korduseksamit.",
