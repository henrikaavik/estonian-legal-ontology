      }
    },
    {
      "@id": "estleg:ProkS_Par_44_v121122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkursi korraldamise nõuded kehtestab , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „justiitsminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "ProkS_Par_44 (redaktsioon 121122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122012016",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_44_v117122015062"
      },
      "estleg:versionValidTo": {
        "@value": "2016-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122012016",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 44",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_44_v117122015062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkursi korraldamise nõuded kehtestab",
      "rdfs:label": {
        "@value": "ProkS_Par_44 (redaktsioon 117122015062)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015062",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117122015062",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 44",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_44_1_v121122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_44_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arengu- ja hindamisvestluse peab prokuröri vahetu juht temale alluva prokuröriga avaliku teenistuse seaduses sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "ProkS_Par_44_1 (redaktsioon 121122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122012016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122012016",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 44_1",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_45_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
