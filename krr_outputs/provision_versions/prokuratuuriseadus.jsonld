      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Prokurörile kohaldab ergutusi riigi peaprokurör.",
      "rdfs:label": {
        "@value": "ProkS_Par_23_1 (redaktsioon 769408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "769408",
