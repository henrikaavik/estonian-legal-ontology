      }
    },
    {
      "@id": "estleg:ProkS_Par_3_v121122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi peaprokurör juhib prokuratuuri ja täidab teisi temale seadusega pandud ülesandeid. (2) Kui riigi peaprokurör ei saa haiguse või muu takistuse tõttu ajutiselt oma ülesandeid täita, määrab valdkonna eest vastutav minister talle Riigiprokuratuuri prokuröride hulgast asendaja. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „justiitsminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "ProkS_Par_3 (redaktsioon 121122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122012016",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_3_v117122015062"
      },
      "estleg:versionValidTo": {
        "@value": "2016-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122012016",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_3_v117122015062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi peaprokurör juhib prokuratuuri ja täidab teisi temale seadusega pandud ülesandeid. (2) Kui riigi peaprokurör ei saa haiguse või muu takistuse tõttu ajutiselt oma ülesandeid täita, määrab valdkonna eest vastutav minister talle Riigiprokuratuuri prokuröride hulgast asendaja.",
      "rdfs:label": {
        "@value": "ProkS_Par_3 (redaktsioon 117122015062)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015062",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117122015062",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_30_v22409",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Prokurör ei või väljaspool teenistuskohustusi töötada mujal kui õppe- või teadustööl. (2) Prokurör ei või olla äriühingu asutaja, juhtimisõiguslik osanik, juhatuse või nõukogu liige ega välismaa äriühingu filiaali juhataja, samuti erakonna liige.",
      "rdfs:label": {
        "@value": "ProkS_Par_30 (redaktsioon 22409)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22409",
      "estleg:supersededByVersion": {
        "@id": "estleg:ProkS_Par_30_v769408"
      },
      "estleg:versionValidTo": {
        "@value": "2004-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22409",
      "estleg:sourceAct": "Prokuratuuriseadus",
      "estleg:provisionRef": "ProkS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:ProkS_Map"
      }
    },
    {
      "@id": "estleg:ProkS_Par_30_v769408",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ProkS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Prokurör ei või väljaspool teenistuskohustusi töötada mujal kui õppe- või teadustööl. [Lõike 2 sõnastus kuni 31. 12. 2007 ] (2) Prokurör ei või olla äriühingu asutaja, juhtimisõiguslik osanik, juhatuse või nõukogu liige ega välismaa äriühingu filiaali juhataja, samuti erakonna liige. [Lõike 2 sõnastus alates 1. 01. 2008] (2) Prokurör ei või olla äriühingu asutaja, juhtimisõiguslik osanik, juhatuse või nõukogu liige, välismaa äriühingu filiaali juhataja ega erakonna juht-, kontroll- või revisjoniorgani liige.",
      "rdfs:label": {
        "@value": "ProkS_Par_30 (redaktsioon 769408)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "769408",
