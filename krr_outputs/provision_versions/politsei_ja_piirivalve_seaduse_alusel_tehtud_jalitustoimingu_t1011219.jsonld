      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1011219_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse Politsei- ja Piirivalveameti (edaspidi asutus) poolt politsei ja piirivalve seaduse alusel tehtud jälitustoiminguga (edaspidi jälitustoiming) kogutud teabe vormistamise ja säilitamise ning tehtud jälitustoimingust teavitamise ja jälitustoiminguga kogutud andmete tutvustamise kord. Määrusega kehtestatakse Politsei- ja Piirivalveameti (edaspidi asutus) poolt politsei ja piirivalve seaduse alusel tehtud jälitustoiminguga (edaspidi jälitustoiming) kogutud teabe vormistamise ja säilitamise ning tehtud jälitustoimingust teavitamise ja jälitustoiminguga kogutud andmete tutvustamise kord.",
      "rdfs:label": {
        "@value": "Reg_1011219_Par_1 (redaktsioon 1011219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1011219",
      "estleg:sourceAct": "Politsei ja piirivalve seaduse alusel tehtud jälitustoiminguga kogutud teabe vormistamise ja säilitamise ning jälitustoimingust teavitamise ja jälitustoiminguga kogutud andmete tutvustamise kord",
      "estleg:provisionRef": "Reg_1011219 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1011219_Map"
      }
    },
    {
      "@id": "estleg:Reg_1011219_Par_2_v1011219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1011219_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jälitustoiminguga kogutud teave vormistatakse kirjalikku taasesitamist võimaldavas vormis ning sellele lisatakse jälitustoimingu käigus tehtud foto, film, heli- või videosalvestis või muu teabetalletus. Jälitustoiminguga kogutud teave vormistatakse kirjalikku taasesitamist võimaldavas vormis ning sellele lisatakse jälitustoimingu käigus tehtud foto, film, heli- või videosalvestis või muu teabetalletus.",
      "rdfs:label": {
        "@value": "Reg_1011219_Par_2 (redaktsioon 1011219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1011219",
      "estleg:sourceAct": "Politsei ja piirivalve seaduse alusel tehtud jälitustoiminguga kogutud teabe vormistamise ja säilitamise ning jälitustoimingust teavitamise ja jälitustoiminguga kogutud andmete tutvustamise kord",
      "estleg:provisionRef": "Reg_1011219 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1011219_Map"
      }
    },
    {
      "@id": "estleg:Reg_1011219_Par_3_v1011219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1011219_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jälitustoimingust teavitatakse isikut pärast tema kohta jälitusteabele juurdepääsu või tema politseiteenistusse sobivuse otsustamist. Jälitustoimingust teavitatakse isikut pärast tema kohta jälitusteabele juurdepääsu või tema politseiteenistusse sobivuse otsustamist. 2 (2) Isikule edastatavas jälitustoimingust teavitamise teates tuleb märkida: 1 1) jälitustoimingu tegemise aeg; 2 2) jälitustoimingu liik; 3 3) jälitustoiminguga kogutud andmeid tutvustava asutuse aadress ja kontaktandmed; 4 4) jälitustoiminguga kogutud andmetega tutvumise tähtaeg, mis ei või olla lühem kui üks kuu teate kättesaamisest arvates; 5 5) jälitustoiminguga kogutud andmete tutvustamata jätmise korral andmete tutvustamisest keeldumise loa kuupäev ja number; 6 6) isiku õigus esitada asutuse tegevuse peale kaebus haldusmenetluse seaduses sätestatud korras. Isikule edastatavas jälitustoimingust teavitamise teates tuleb märkida: jälitustoimingu tegemise aeg; jälitustoimingu liik; jälitustoiminguga kogutud andmeid tutvustava asutuse aadress ja kontaktandmed; jälitustoiminguga kogutud andmetega tutvumise tähtaeg, mis ei või olla lühem kui üks kuu teate kättesaamisest arvates; jälitustoiminguga kogutud andmete tutvustamata jätmise korral andmete tutvustamisest keeldumise loa kuupäev ja number; isiku õigus esitada asutuse tegevuse peale kaebus haldusmenetluse seaduses sätestatud korras. 3 (3) Isikule toimetatakse teade kätte kooskõlas haldusmenetluse seaduses dokumendi kättetoimetamisele kehtestatud nõuetega ning loetakse kättetoimetatuks samas seaduses sätestatud tingimustel. Isikule toimetatakse teade kätte kooskõlas haldusmenetluse seaduses dokumendi kättetoimetamisele kehtestatud nõuetega ning loetakse kättetoimetatuks samas seaduses sätestatud tingimustel.",
      "rdfs:label": {
        "@value": "Reg_1011219_Par_3 (redaktsioon 1011219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1011219",
      "estleg:sourceAct": "Politsei ja piirivalve seaduse alusel tehtud jälitustoiminguga kogutud teabe vormistamise ja säilitamise ning jälitustoimingust teavitamise ja jälitustoiminguga kogutud andmete tutvustamise kord",
      "estleg:provisionRef": "Reg_1011219 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1011219_Map"
      }
    },
    {
      "@id": "estleg:Reg_1011219_Par_4_v1011219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1011219_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isikul võimaldatakse isiklikult tutvuda jälitustoiminguga kogutud andmetega ja jälitustoimingu käigus tehtud foto, filmi, heli- või videosalvestisega või muu teabetalletusega üksnes asutuse ametiruumides asutusega kokkulepitud ajal. Isikul võimaldatakse isiklikult tutvuda jälitustoiminguga kogutud andmetega ja jälitustoimingu käigus tehtud foto, filmi, heli- või videosalvestisega või muu teabetalletusega üksnes asutuse ametiruumides asutusega kokkulepitud ajal. 2 (2) Jälitustoiminguga kogutud andmete tutvustamise kohta koostatakse jälitustoiminguga kogutud andmete tutvustamise protokoll, mille allkirjastab selle koostanud isik ning mis peab sisaldama järgmisi andmeid: 1 1) jälitustoiminguga kogutud andmetega tutvumise aeg ja koht; 2 2) tutvustatud andmete loetelu; 3 3) jälitustoiminguga kogutud andmete tutvustamist läbiviiva asutuse nimi ning kohalviibivate isikute nimed. Jälitustoiminguga kogutud andmete tutvustamise kohta koostatakse jälitustoiminguga kogutud andmete tutvustamise protokoll, mille allkirjastab selle koostanud isik ning mis peab sisaldama järgmisi andmeid: jälitustoiminguga kogutud andmetega tutvumise aeg ja koht; tutvustatud andmete loetelu; jälitustoiminguga kogutud andmete tutvustamist läbiviiva asutuse nimi ning kohalviibivate isikute nimed. 3 (3) Tutvumiseks esitatud andmetest ei tehta koopiat. Tutvumiseks esitatud andmetest ei tehta koopiat. 4 (4) Jälitustoiminguga kogutud andmetega tutvutakse mõistliku aja jooksul. Kui tutvuja pahatahtlikult venitab tutvumise aega, siis tutvustamine lõpetatakse ning selle kohta tehakse vastav märge jälitustoiminguga kogutud andmete tutvustamise protokolli. Jälitustoiminguga kogutud andmetega tutvutakse mõistliku aja jooksul. Kui tutvuja pahatahtlikult venitab tutvumise aega, siis tutvustamine lõpetatakse ning selle kohta tehakse vastav märge jälitustoiminguga kogutud andmete tutvustamise protokolli. 5 (5) Kui tutvuja üritab rikkuda või hävitada tutvustatavat materjali ja jälitustoiminguga saadud teabetalletust, siis tutvustamine lõpetatakse ning selle kohta tehakse vastav märge jälitustoiminguga kogutud andmete tutvustamise protokolli. Kui tutvuja üritab rikkuda või hävitada tutvustatavat materjali ja jälitustoiminguga saadud teabetalletust, siis tutvustamine lõpetatakse ning selle kohta tehakse vastav märge jälitustoiminguga kogutud andmete tutvustamise protokolli. 6 (6) Lõigetes 4 ja 5 nimetatud pahatahtliku käitumise korral võib tutvustaja keelduda jälitustoiminguga kogutud andmete edasisest tutvustamisest. Keeldumise kohta koostab tutvustaja otsuse, mis säilitatakse jälitustoimikus. Lõigetes 4 ja 5 nimetatud pahatahtliku käitumise korral võib tutvustaja keelduda jälitustoiminguga kogutud andmete edasisest tutvustamisest. Keeldumise kohta koostab tutvustaja otsuse, mis säilitatakse jälitustoimikus.",
      "rdfs:label": {
        "@value": "Reg_1011219_Par_4 (redaktsioon 1011219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1011219",
      "estleg:sourceAct": "Politsei ja piirivalve seaduse alusel tehtud jälitustoiminguga kogutud teabe vormistamise ja säilitamise ning jälitustoimingust teavitamise ja jälitustoiminguga kogutud andmete tutvustamise kord",
      "estleg:provisionRef": "Reg_1011219 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1011219_Map"
      }
    },
    {
      "@id": "estleg:Reg_1011219_Par_5_v1011219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1011219_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jälitustoiminguga kogutud teavet ning muid jälitustoimingu käigus koostatud ja kogutud dokumente ning andmekandjaid säilitatakse ning need hävitatakse asutuse juhi kehtestatud korras. Jälitustoiminguga kogutud teavet ning muid jälitustoimingu käigus koostatud ja kogutud dokumente ning andmekandjaid säilitatakse ning need hävitatakse asutuse juhi kehtestatud korras. 2 (2) Riigisaladust või salastatud välisteavet sisaldavat jälitustoiminguga kogutud teavet käideldakse ja see märgistatakse vastavalt riigisaladuse ja salastatud välisteabe seadusele. Riigisaladust või salastatud välisteavet sisaldavat jälitustoiminguga kogutud teavet käideldakse ja see märgistatakse vastavalt riigisaladuse ja salastatud välisteabe seadusele.",
      "rdfs:label": {
        "@value": "Reg_1011219_Par_5 (redaktsioon 1011219)",
        "@language": "et"
      },
