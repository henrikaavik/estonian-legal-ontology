      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiisikauba veo katkestamisel katkestab maksuhaldur SADHES-s selle aktsiisikauba saatelehe menetluse ja täidab veo katkestamise teatise. SADHES omistab saatelehe olekuks „vedu katkestatud”. Aktsiisikauba veo katkestamisel katkestab maksuhaldur SADHES-s selle aktsiisikauba saatelehe menetluse ja täidab veo katkestamise teatise. SADHES omistab saatelehe olekuks „vedu katkestatud”.",
      "rdfs:label": {
        "@value": "Reg_1024912_Par_6 (redaktsioon 1024912)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024912",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024912",
      "estleg:sourceAct": "Siseriiklike aktsiisikauba saatedokumentide menetlemise kord",
      "estleg:provisionRef": "Reg_1024912 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024912_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024912_Par_7_v1024912",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
