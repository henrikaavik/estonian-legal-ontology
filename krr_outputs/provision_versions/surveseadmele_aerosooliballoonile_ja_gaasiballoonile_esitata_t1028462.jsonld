        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse nõuete täitmise üle teeb järelevalvet Tarbijakaitse ja Tehnilise Järelevalve Amet. RT I 2019-02-19 1 119022019001 2019-02-22 Käesoleva määruse nõuete täitmise üle teeb järelevalvet Tarbijakaitse ja Tehnilise Järelevalve Amet.",
      "rdfs:label": {
        "@value": "Reg_1028462_Par_3 (redaktsioon 1028462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028462",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028462",
      "estleg:sourceAct": "Surveseadmele, aerosooliballoonile ja gaasiballoonile esitatavad nõuded ja nende nõuetele vastavuse tõendamise kord",
      "estleg:provisionRef": "Reg_1028462 § 3",
