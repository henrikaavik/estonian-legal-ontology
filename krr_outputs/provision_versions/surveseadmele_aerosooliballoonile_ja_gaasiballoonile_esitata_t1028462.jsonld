      "estleg:provisionRef": "Reg_1028462 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028462_Map"
      }
    },
    {
      "@id": "estleg:Reg_1028462_Par_2_v1028462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028462_Par_2"
