    {
      "@id": "estleg:TKindlS_Par_19_v104052018006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TKindlS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-05-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse tähenduses on tööandja maksejõuetu, kui: kohus on tööandja pankroti välja kuulutanud; kohus on lõpetanud tööandja pankrotimenetluse raugemise tõttu pankrotiseaduse § 29 lõike 1 tähenduses; kohus on teinud pankrotiseaduse § 15 lõikes 41 nimetatud ajutise halduri nimetamata jätmise määruse või pankrotiseaduse § 27 lõikes 41 nimetatud pankrotiavalduse läbi vaatamata jätmise määruse; kohus või muu pädev organ on teises Euroopa Majanduspiirkonna lepinguriigis tunnistanud tööandja maksejõuetuks nõukogu määruse (EÜ) nr 1346/2000 maksejõuetusmenetluse kohta (EÜT L 160, 30.06.2000, lk 1–18) või Euroopa Parlamendi ja nõukogu määruse (EL) 2015/848 maksejõuetusmenetluse kohta (ELT L 141, 05.06.2015, lk 19–72) tähenduses.",
      "rdfs:label": {
        "@value": "TKindlS_Par_19 (redaktsioon 104052018006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104052018006",
      "estleg:supersededByVersion": {
        "@id": "estleg:TKindlS_Par_19_v120062022036"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104052018006",
      "estleg:sourceAct": "Töötuskindlustuse seadus",
      "estleg:provisionRef": "TKindlS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:TKindlS_Map"
      }
    },
    {
      "@id": "estleg:TKindlS_Par_19_v120062022036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TKindlS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse tähenduses on tööandja maksejõuetu, kui: kohus on tööandja pankroti välja kuulutanud; kohus on lõpetanud tööandja pankrotimenetluse raugemise tõttu pankrotiseaduse § 29 lõike 1 tähenduses; kohus on teinud pankrotiseaduse § 15 lõikes 41 nimetatud ajutise halduri nimetamata jätmise määruse või pankrotiseaduse § 27 lõikes 41 nimetatud pankrotiavalduse läbi vaatamata jätmise määruse; kohus on teinud füüsilise isiku maksejõuetuse seaduse § 15 lõike 1 ja pankrotiseaduse § 15 lõike 41 alusel usaldusisiku nimetamata jätmise määruse või füüsilise isiku maksejõuetuse seaduse § 18 lõike 1 ja pankrotiseaduse § 27 lõike 41 alusel maksejõuetusavalduse läbi vaatamata jätmise määruse; kohus või muu pädev organ on teises Euroopa Majanduspiirkonna lepinguriigis tunnistanud tööandja maksejõuetuks nõukogu määruse (EÜ) nr 1346/2000 maksejõuetusmenetluse kohta (EÜT L 160, 30.06.2000, lk 1–18) või Euroopa Parlamendi ja nõukogu määruse (EL) 2015/848 maksejõuetusmenetluse kohta (ELT L 141, 05.06.2015, lk 19–72) tähenduses.",
      "rdfs:label": {
        "@value": "TKindlS_Par_19 (redaktsioon 120062022036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022036",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022036",
      "estleg:sourceAct": "Töötuskindlustuse seadus",
      "estleg:provisionRef": "TKindlS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:TKindlS_Map"
      }
    },
    {
