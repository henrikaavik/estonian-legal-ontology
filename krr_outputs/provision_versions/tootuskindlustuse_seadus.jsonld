      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "TKindlS_Par_51 (redaktsioon 121122010018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010018",
