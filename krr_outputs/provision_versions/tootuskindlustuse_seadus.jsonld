    {
      "@id": "estleg:TKindlS_Par_4_v27135",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TKindlS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Töötuskindlustusmakse on sundkindlustuse makse liik, mida maksavad: kindlustatu; tööandja ja riik või kohalik omavalitsus tööandjana (edaspidi tööandja) sihtotstarbeliselt töötuskindlustuse rahastamiseks.",
      "rdfs:label": {
        "@value": "TKindlS_Par_4 (redaktsioon 27135)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27135",
      "estleg:supersededByVersion": {
        "@id": "estleg:TKindlS_Par_4_v182907"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27135",
      "estleg:sourceAct": "Töötuskindlustuse seadus",
      "estleg:provisionRef": "TKindlS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:TKindlS_Map"
      }
    },
    {
      "@id": "estleg:TKindlS_Par_4_v182907",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TKindlS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Töötuskindlustusmakse on sundkindlustuse makse liik töötuskindlustuse sihtotstarbeliseks rahastamiseks, mida maksavad: kindlustatu; tööandja. (2) Tööandja käesoleva seaduse tähenduses on: residendist juriidiline isik tulumaksuseaduse (RT I 1999, 101, 903; 2001, 11, 49; 16, 69; 50, 283; 59, 359; 79, 480; 91, 544; 2002, 23, 131; 41, 253) § 6 lõike 2 tähenduses; riigi- ja kohaliku omavalitsusüksuse asutus; füüsilisest isikust tööandja, kes teeb kindlustatule käesoleva seaduse § 40 lõikes 1 nimetatud väljamakseid; tulumaksuseaduse tähenduses Eestis püsivat tegevuskohta omav või Eestis tööandjana tegutsev mitteresident, kes teeb kindlustatule käesoleva seaduse § 40 lõikes 1 nimetatud väljamakseid",
      "rdfs:label": {
        "@value": "TKindlS_Par_4 (redaktsioon 182907)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182907",
      "estleg:supersededByVersion": {
        "@id": "estleg:TKindlS_Par_4_v12883493"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-25",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/182907",
      "estleg:sourceAct": "Töötuskindlustuse seadus",
      "estleg:provisionRef": "TKindlS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:TKindlS_Map"
      }
    },
