        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse mõttes on kindlustatu käesoleva seaduse § 40 lõike 1 punktides 1-3 nimetatud isik, kes on maksnud töötuskindlustusmakseid käesolevas seaduses sätestatud korras. (2) Käesoleva seaduse kohaselt ei ole kindlustatu: füüsilisest isikust ettevõtja; juriidilise isiku juhtimis- või kontrollorgani liige tulumaksuseaduse (RT I 1999, 101, 903; 2001, 11, 49; 16, 69; 50, 283) § 9 tähenduses; avaliku teenistuse seaduse (RT I 1995, 16, 228; 1999, 7, 112; 10, 155; 16, 271 ja 276; 2000, 25, 144 ja 145; 28, 167; 102, 672; 2001, 7, 17 ja 18; 17, 78; 42, 233; 47, 260) § 12 lõikes 2 ja lõike 3 punktides 1-3 nimetatud isikud; riikliku pensionikindlustuse seaduse (RT I 2001, 100, 648; 2002, 53, 336, 338; 61, 375) § 7 lõikes 1 või 2 sätestatud vanaduspensioniikka (edaspidi vanaduspensioniiga) jõudnud isik. (3) Töötuskindlustuse kindlustusandja on töötukassa.",
      "rdfs:label": {
        "@value": "TKindlS_Par_3 (redaktsioon 212196)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "212196",
      "estleg:supersededByVersion": {
        "@id": "estleg:TKindlS_Par_3_v236482"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/212196",
      "estleg:sourceAct": "Töötuskindlustuse seadus",
      "estleg:provisionRef": "TKindlS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:TKindlS_Map"
      }
    },
