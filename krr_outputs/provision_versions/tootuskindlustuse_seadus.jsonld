    {
      "@id": "estleg:TKindlS_Par_11_v103032011019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TKindlS_Par_11"
