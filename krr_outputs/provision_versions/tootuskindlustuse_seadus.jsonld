    {
      "@id": "estleg:TKindlS_Par_38_1_v121122010018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TKindlS_Par_38_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sihtkapitali moodustavad kuni 30 protsenti töötuskindlustushüvitiste sihtfondi laekuvatest kindlustatu töötuskindlustusmaksetest, kuni 30 protsenti koondamise ja tööandja maksejõuetuse puhul makstavate hüvitiste sihtfondi laekuvatest tööandja töötuskindlustusmaksetest, riigieelarvest Sotsiaalministeeriumi eelarve kaudu sihtotstarbeliselt eraldatud vahendid ning nende paigutamisest saadav investeeringutulu. (2) Töötukassa nõukogu esitab sotsiaalministri kaudu Vabariigi Valitsusele ettepaneku töötuskindlustushüvitiste sihtfondi ning koondamise ja tööandja maksejõuetuse puhul makstavate hüvitiste sihtfondi laekuvatest maksetest sihtkapitali ülekantavate vahendite määra kehtestamiseks vähemalt kord kalendriaastas, hiljemalt käesoleva seaduse § 41 lõikes 3 sätestatud tähtajaks ja korras. (3) Tööturuteenuste ja -toetuste sihtkapitali ülekantavate vahendite määra järgmiseks kalendriaastaks hiljemalt käesoleva seaduse § 41 lõikes 4 sätestatud tähtajaks. Sihtkapitali vahendite ebapiisavuse korral võib Vabariigi Valitsus sihtkapitali ülekantavate vahendite määra töötukassa nõukogu ettepanekul muuta. (4) Tööturuteenuste ja -toetuste sihtkapitali vahendeid kasutatakse: tööturuteenuste osutamiseks; tööturutoetuste, välja arvatud töötutoetuse maksmiseks; sihtfondi vahendite paigutamisega otseselt seotud tehingukulude ja -tasude katmiseks.",
      "rdfs:label": {
        "@value": "TKindlS_Par_38_1 (redaktsioon 121122010018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010018",
      "estleg:supersededByVersion": {
        "@id": "estleg:TKindlS_Par_38_1_v123122011010"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-23",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122010018",
      "estleg:sourceAct": "Töötuskindlustuse seadus",
      "estleg:provisionRef": "TKindlS § 38_1",
      "estleg:partOfAct": {
        "@id": "estleg:TKindlS_Map"
      }
    },
