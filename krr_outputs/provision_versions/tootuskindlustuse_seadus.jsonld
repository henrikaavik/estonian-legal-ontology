      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hüvitiste määramise ja maksmisega seotud vaidlused lahendab halduskohus. (2) Töötuskindlustusmakse maksmisega seotud vaidlused lahendatakse maksukorralduse seaduse §-des 35-41 sätestatud korras.",
      "rdfs:label": {
        "@value": "TKindlS_Par_45 (redaktsioon 27135)",
