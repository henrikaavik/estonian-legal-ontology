      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/182907",
      "estleg:sourceAct": "Töötuskindlustuse seadus",
      "estleg:provisionRef": "TKindlS § 45",
      "estleg:partOfAct": {
