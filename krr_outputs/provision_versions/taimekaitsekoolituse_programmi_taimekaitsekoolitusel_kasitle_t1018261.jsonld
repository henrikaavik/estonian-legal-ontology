      }
    },
    {
      "@id": "estleg:Reg_1018261_Par_2_v1018261",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1018261_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taimekaitsekoolituse programmis sisaldub: 1 1) koolitusasutuse nimi; 2 2) taimekaitsekoolituse sihtgrupp; 3 3) taimekaitsekoolituse liik; 4 4) taimekaitsekoolitusel käsitletavate teemade kirjeldus koos iga teema käsitluse kestusega taimekaitsekoolituse valdkondade kaupa; 5 5) praktiliste tööde loetelu koos nende kestusega; 6 6) taimekaitsekoolitusel kasutatavate õppevahendite loetelu. Taimekaitsekoolituse programmis sisaldub: koolitusasutuse nimi; taimekaitsekoolituse sihtgrupp; taimekaitsekoolituse liik; taimekaitsekoolitusel käsitletavate teemade kirjeldus koos iga teema käsitluse kestusega taimekaitsekoolituse valdkondade kaupa; praktiliste tööde loetelu koos nende kestusega; taimekaitsekoolitusel kasutatavate õppevahendite loetelu.",
      "rdfs:label": {
        "@value": "Reg_1018261_Par_2 (redaktsioon 1018261)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1018261",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1018261",
      "estleg:sourceAct": "Taimekaitsekoolituse programmi, taimekaitsekoolitusel käsitletavate teemade ja koolituse kestuse nõuded",
      "estleg:provisionRef": "Reg_1018261 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1018261_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1018261_Par_3_v1018261",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1018261_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taimekaitsevahendi valdkonna taimekaitsekoolitusel käsitletakse vähemalt järgmiseid teemasid: 1 1) kehtivad taimekaitsealased riigisisesed, Euroopa Liidu ja rahvusvahelised õigusaktid; taimekaitsevahendite turustamisele, hoidmisele ja kasutamisele esitatavad nõuded; 2 2) ülevaade turule lastud taimekaitsevahenditest, nende liigitamine kasutusotstarbe, toimemehhanismi, toimespektri ja ohuklasside järgi ning sobiva taimekaitsevahendi valiku põhimõtted ja rakendatud taimekaitseabinõu üle arvestuse pidamine; 3 3) taimekultuuride taimekahjustajad ja nende tõrjevõimalused; 4 4) taimekaitsevahendi pakend ja märgistus; 5 5) taimekaitsevahendi tühja pakendi, pesuvee, pritsimislahuse ning taimekaitsevahendi jääkide käitlemine; 6 6) ebaseaduslik taimekaitsevahend, sellest tulenevad riskid ning meetodid sellise toote tuvastamiseks; 7 7) integreeritud taimekaitse põhimõtted; 8 8) ohutusnõuded taimekaitsevahendi kasutamisel, keskkonnaohutus, sealhulgas riskid sihtrühmavälistele taimedele, kasulikele putukatele, elusloodusele, bioloogilisele mitmekesisusele, joogiveele, valgaladele, kaitsealadele ning asjakohased meetmed nende riskide vähendamiseks. Taimekaitsevahendi valdkonna taimekaitsekoolitusel käsitletakse vähemalt järgmiseid teemasid: kehtivad taimekaitsealased riigisisesed, Euroopa Liidu ja rahvusvahelised õigusaktid; taimekaitsevahendite turustamisele, hoidmisele ja kasutamisele esitatavad nõuded; ülevaade turule lastud taimekaitsevahenditest, nende liigitamine kasutusotstarbe, toimemehhanismi, toimespektri ja ohuklasside järgi ning sobiva taimekaitsevahendi valiku põhimõtted ja rakendatud taimekaitseabinõu üle arvestuse pidamine; taimekultuuride taimekahjustajad ja nende tõrjevõimalused; taimekaitsevahendi pakend ja märgistus; taimekaitsevahendi tühja pakendi, pesuvee, pritsimislahuse ning taimekaitsevahendi jääkide käitlemine; ebaseaduslik taimekaitsevahend, sellest tulenevad riskid ning meetodid sellise toote tuvastamiseks; integreeritud taimekaitse põhimõtted; ohutusnõuded taimekaitsevahendi kasutamisel, keskkonnaohutus, sealhulgas riskid sihtrühmavälistele taimedele, kasulikele putukatele, elusloodusele, bioloogilisele mitmekesisusele, joogiveele, valgaladele, kaitsealadele ning asjakohased meetmed nende riskide vähendamiseks. 2 (2) Taimekaitseseadme valdkonna taimekaitsekoolitusel käsitletakse vähemalt järgmiseid teemasid: 1 1) taimekaitseseadmete tüübid ja taimekaitseseadmete kasutamise võtted; 2 2) taimekaitseseadmete ettevalmistamine tööks ning taimekaitseseadmete toimimise kontroll, sealhulgas nende reguleerimine; 3 3) taimekaitsevahendi töölahuse valmistamine ja kulunormi arvestamine; 4 4) taimekaitseseadme tehniline kontroll; 5 5) ohutusnõuded taimekaitseseadme kasutamisel, puhastamisel, hooldamisel ning hoidmisel. Taimekaitseseadme valdkonna taimekaitsekoolitusel käsitletakse vähemalt järgmiseid teemasid: taimekaitseseadmete tüübid ja taimekaitseseadmete kasutamise võtted; taimekaitseseadmete ettevalmistamine tööks ning taimekaitseseadmete toimimise kontroll, sealhulgas nende reguleerimine; taimekaitsevahendi töölahuse valmistamine ja kulunormi arvestamine; taimekaitseseadme tehniline kontroll; ohutusnõuded taimekaitseseadme kasutamisel, puhastamisel, hooldamisel ning hoidmisel. 3 (3) Tööohutuse valdkonna taimekaitsekoolitusel käsitletakse vähemalt järgmiseid teemasid: 1 1) taimekaitsevahendi mürgistuse sümptomid ja esmaabivõtted; 2 2) isikukaitsevahendid ja nende praktiline kasutamine; 3 3) töötervishoiu ja tööohutuse nõuded. Tööohutuse valdkonna taimekaitsekoolitusel käsitletakse vähemalt järgmiseid teemasid: taimekaitsevahendi mürgistuse sümptomid ja esmaabivõtted; isikukaitsevahendid ja nende praktiline kasutamine; töötervishoiu ja tööohutuse nõuded.",
      "rdfs:label": {
        "@value": "Reg_1018261_Par_3 (redaktsioon 1018261)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1018261",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1018261",
      "estleg:sourceAct": "Taimekaitsekoolituse programmi, taimekaitsekoolitusel käsitletavate teemade ja koolituse kestuse nõuded",
      "estleg:provisionRef": "Reg_1018261 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1018261_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1018261_Par_4_v1018261",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1018261_Par_4"
