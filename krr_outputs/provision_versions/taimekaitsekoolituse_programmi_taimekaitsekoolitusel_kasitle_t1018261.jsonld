      "estleg:versionValidFrom": {
        "@value": "2013-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse taimekaitsevahendi professionaalsele kasutajale, turustajale või nõustajale korraldatava taimekaitsekoolituse aluskoolituse ja täienduskoolituse programmi, taimekaitsekoolitusel käsitletavate teemade ja koolituse kestuse nõuded. Määrusega kehtestatakse taimekaitsevahendi professionaalsele kasutajale, turustajale või nõustajale korraldatava taimekaitsekoolituse aluskoolituse ja täienduskoolituse programmi, taimekaitsekoolitusel käsitletavate teemade ja koolituse kestuse nõuded.",
      "rdfs:label": {
        "@value": "Reg_1018261_Par_1 (redaktsioon 1018261)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1018261",
