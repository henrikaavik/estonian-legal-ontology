      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida , mis on koostatud 1975. aasta 15. oktoobril Strasbourg'is ja alla kirjutatud Eesti Vabariigi poolt 1996. aasta 3. mail Strasbourg'is.",
      "rdfs:label": {
        "@value": "valjaandmise_euroopa_konventsiooni_selle_Par_2 (redaktsioon 78647)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "78647"
    },
