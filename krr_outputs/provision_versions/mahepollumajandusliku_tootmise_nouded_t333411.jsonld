    {
      "@id": "estleg:Reg_333411_Par_2_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mahepõllumajandusliku tootmisega tegelev isik (edaspidi isik) peab Euroopa Parlamendi ja nõukogu määruses (EL) 2018/848, mis käsitleb mahepõllumajanduslikku tootmist ja mahepõllumajanduslike toodete märgistamist ning millega tunnistatakse kehtetuks nõukogu määrus (EÜ) nr 834/2007 (ELT L 150, 14.06.2018, lk 1–92), ja selle alusel kehtestatud asjakohastes Euroopa Liidu õigusaktides ettenähtud arvestust paberil või elektrooniliselt. RT I 2021-12-23 12 123122021012 2022-01-01 Mahepõllumajandusliku tootmisega tegelev isik (edaspidi isik) peab Euroopa Parlamendi ja nõukogu määruses (EL) 2018/848, mis käsitleb mahepõllumajanduslikku tootmist ja mahepõllumajanduslike toodete märgistamist ning millega tunnistatakse kehtetuks nõukogu määrus (EÜ) nr 834/2007 (ELT L 150, 14.06.2018, lk 1–92), ja selle alusel kehtestatud asjakohastes Euroopa Liidu õigusaktides ettenähtud arvestust paberil või elektrooniliselt. 2 (2) Isik teeb andmete kohta kirje kolme päeva jooksul arvates toimingu tegemise päevast, välja arvatud veeseaduse alusel peetavasse põlluraamatusse andmete kandmise korral, mille puhul kehtib nimetatud seaduses sätestatud tähtaeg. RT I 2018-10-12 3 112102018003 2018-10-15 Isik teeb andmete kohta kirje kolme päeva jooksul arvates toimingu tegemise päevast, välja arvatud veeseaduse alusel peetavasse põlluraamatusse andmete kandmise korral, mille puhul kehtib nimetatud seaduses sätestatud tähtaeg. 3 (3) Isik säilitab arvestuse pidamiseks vajalikke andmeid ja dokumente vähemalt kolm aastat arvates nende kogumisest. Isik säilitab arvestuse pidamiseks vajalikke andmeid ja dokumente vähemalt kolm aastat arvates nende kogumisest.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_2 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
