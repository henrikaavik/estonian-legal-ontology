    {
      "@id": "estleg:Reg_333411_Par_3_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu - RT I 2021-12-23 12 123122021012 2022-01-01 Kehtetu - 2 (2) Kehtetu - RT I 2021-12-23 12 123122021012 2022-01-01 Kehtetu - 3 (3) Mahepõllumajandusliku taimekasvatusega tegelev isik peab koostama ja säilitama külvikorraplaani. Mahepõllumajandusliku taimekasvatusega tegelev isik peab koostama ja säilitama külvikorraplaani. 4 (4) Lõikes 3 nimetatud külvikorra plaani ei pea koostama: 1 1) vähemalt viie aasta vanuse rohumaa või vähemalt viie aasta vanuseks kavandatud rohumaa kohta; 2 2) loodusliku rohumaa kohta; 3 3) puuvilja- ja marjakultuuride ning ravim- ja maitsetaimede kasvatamiseks kasutatava maa kohta; 4 4) heinaseemne tootmiseks kasutatava maa kohta; 5 5) põllu kohta, mis on väiksem kui 0,30 hektarit. Lõikes 3 nimetatud külvikorra plaani ei pea koostama: vähemalt viie aasta vanuse rohumaa või vähemalt viie aasta vanuseks kavandatud rohumaa kohta; loodusliku rohumaa kohta; puuvilja- ja marjakultuuride ning ravim- ja maitsetaimede kasvatamiseks kasutatava maa kohta; heinaseemne tootmiseks kasutatava maa kohta; põllu kohta, mis on väiksem kui 0,30 hektarit.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_3 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333411_Par_4_v333411",
      "@type": [
        "owl:NamedIndividual",
