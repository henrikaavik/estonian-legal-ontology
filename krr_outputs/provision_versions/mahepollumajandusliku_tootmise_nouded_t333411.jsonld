    },
    {
      "@id": "estleg:Reg_333411_Par_14_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajandusliku loomakasvatusega tegelev isik, kes peab vutti mahepõllumajanduslikult, täidab lisaks §-s 121 sätestatud nõuetele järgmisi nõudeid: 1 1) loomakasvatushoones võib pidada ühes karjas kuni 6800 vutti, kelle kasvatamiseks ettenähtud pindala on vähemalt 400 ruutmeetrit; 2 2) mahepõllumajanduslikult peetud vuti võib tappa alates tema 35 päeva vanuseks saamisest. RT I 2016-04-29 1 129042016001 2016-05-02 Mahepõllumajandusliku loomakasvatusega tegelev isik, kes peab vutti mahepõllumajanduslikult, täidab lisaks §-s 121 sätestatud nõuetele järgmisi nõudeid: loomakasvatushoones võib pidada ühes karjas kuni 6800 vutti, kelle kasvatamiseks ettenähtud pindala on vähemalt 400 ruutmeetrit; mahepõllumajanduslikult peetud vuti võib tappa alates tema 35 päeva vanuseks saamisest.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_14 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
    {
