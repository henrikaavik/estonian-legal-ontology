    {
      "@id": "estleg:Reg_333411_Par_23_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik, kes jätkab mahepõllumajandusliku toote üksnes turuleviimise või importimisega tegelemist, esitab Põllumajandus- ja Toiduametile tegevuse jätkamise aasta 1. veebruariks andmed ettevõttes eelmisel aastal turule viidud või imporditud tootegruppide kohta. RT I 2020-11-04 1 104112020001 2021-01-01 Isik, kes jätkab mahepõllumajandusliku toote üksnes turuleviimise või importimisega tegelemist, esitab Põllumajandus- ja Toiduametile tegevuse jätkamise aasta 1. veebruariks andmed ettevõttes eelmisel aastal turule viidud või imporditud tootegruppide kohta.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_23 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333411_Par_24_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mahepõllumajandusliku toote ettevalmistamisega, toote üksnes turuleviimisega või importimisega tegelev isik esitab 2009. aastal tegevuse jätkamiseks määruses nõutud andmed 10. aprilliks. Mahepõllumajandusliku toote ettevalmistamisega, toote üksnes turuleviimisega või importimisega tegelev isik esitab 2009. aastal tegevuse jätkamiseks määruses nõutud andmed 10. aprilliks. 2 (2) Mahesööda tootmisega tegelev isik esitab 2009. aastal tegevuse jätkamiseks määruses nõutud andmed 27. maiks. Mahesööda tootmisega tegelev isik esitab 2009. aastal tegevuse jätkamiseks määruses nõutud andmed 27. maiks. 3 (3) Mahepõllumajanduslikule tootmisele viitavalt märgistatud toodet, millel on kasutatud enne 1. jaanuari 2010 kehtinud järelevalveasutuse koodi, võib turustada kuni 1. juulini 2012. RT I 2010 25 121 13315092 2010-06-04+03:00 Mahepõllumajanduslikule tootmisele viitavalt märgistatud toodet, millel on kasutatud enne 1. jaanuari 2010 kehtinud järelevalveasutuse koodi, võib turustada kuni 1. juulini 2012. 4 (4) Mahepõllumajandusliku taimekasvatuse, loomakasvatuse või mesindusega tegelev isik esitab 2016. aastal tegevuse jätkamiseks § 4 lõigetes 2 ja 5, §-s 10 ja § 16 lõikes 2 nimetatud andmed 15. juuniks. RT I 2018-10-12 3 112102018003 2018-10-15 Mahepõllumajandusliku taimekasvatuse, loomakasvatuse või mesindusega tegelev isik esitab 2016. aastal tegevuse jätkamiseks § 4 lõigetes 2 ja 5, §-s 10 ja § 16 lõikes 2 nimetatud andmed 15. juuniks.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_24 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
