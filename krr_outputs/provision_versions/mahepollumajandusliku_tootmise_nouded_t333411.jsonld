    {
      "@id": "estleg:Reg_333411_Par_8_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ettevõttest, kus tegeletakse mahepõllumajandusliku loomakasvatusega, pärit looma on lubatud rändkarjatada poollooduslikul alal looduskaitseseaduse tähenduses, laiul, väikesaarel ja muul sellesarnasel alal, kus viimase kolme aasta jooksul ei ole kasutatud Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 artikli 24 lõike 1 punktide a ja b kohases loetelus nimetamata toodet või ainet. Nimetatud aladel karjatamise ajal kasutatud sööta käsitatakse mahesöödana. RT I 2021-12-23 12 123122021012 2022-01-01 Ettevõttest, kus tegeletakse mahepõllumajandusliku loomakasvatusega, pärit looma on lubatud rändkarjatada poollooduslikul alal looduskaitseseaduse tähenduses, laiul, väikesaarel ja muul sellesarnasel alal, kus viimase kolme aasta jooksul ei ole kasutatud Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 artikli 24 lõike 1 punktide a ja b kohases loetelus nimetamata toodet või ainet. Nimetatud aladel karjatamise ajal kasutatud sööta käsitatakse mahesöödana. 2 (2) Kehtetu - RT I 2021-12-23 12 123122021012 2022-01-01 Kehtetu -",
      "rdfs:label": {
