    {
      "@id": "estleg:Reg_333411_Par_26_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus jõustub 1. märtsil 2009. aastal. RT I 2010 25 121 13315092 2010-06-04 Määrus jõustub 1. märtsil 2009. aastal. 2 (2) Määruse peatükk 51 jõustub 1. juulil 2010. aastal. RT I 2010 25 121 13315092 2010-06-04+03:00 Määruse peatükk 51 jõustub 1. juulil 2010. aastal.",
      "rdfs:label": {
