  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_mahepollumajandusliku_tootmise_nouded_t333411_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Mahepõllumajandusliku tootmise nõuded (31 versiooni)",
        "@language": "et"
      },
      "dc:source": "Mahepõllumajandusliku tootmise nõuded"
    },
    {
      "@id": "estleg:Reg_333411_Par_1_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse mahepõllumajandusliku tootmise nõuded, sealhulgas nõuded mahepõllumajandusliku tegevuse jätkamiseks esitatava teabe kohta ning teabe esitamise tähtpäev. Määrusega kehtestatakse mahepõllumajandusliku tootmise nõuded, sealhulgas nõuded mahepõllumajandusliku tegevuse jätkamiseks esitatava teabe kohta ning teabe esitamise tähtpäev.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_1 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333411_Par_10_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik, kes jätkab mahepõllumajandusliku loomakasvatusega tegelemist, esitab Põllumajandus- ja Toiduametile tegevuse jätkamise aasta 1. veebruariks andmed ettevõttes peetud üleminekuaja läbinud loomade arvu kohta, liikide ja vanusegruppide kaupa mahepõllumajandusliku loomakasvatusega tegelemise jätkamise aastale vahetult eelnenud aasta 31. detsembri seisuga ning andmed mahepõllumajandusliku loomakasvatusega tegelemise jätkamise aastale vahetult eelnenud aastal üleminekuaja läbinud loomadelt saadud loomakasvatussaaduste koguse kohta. RT I 2020-11-04 1 104112020001 2021-01-01 Isik, kes jätkab mahepõllumajandusliku loomakasvatusega tegelemist, esitab Põllumajandus- ja Toiduametile tegevuse jätkamise aasta 1. veebruariks andmed ettevõttes peetud üleminekuaja läbinud loomade arvu kohta, liikide ja vanusegruppide kaupa mahepõllumajandusliku loomakasvatusega tegelemise jätkamise aastale vahetult eelnenud aasta 31. detsembri seisuga ning andmed mahepõllumajandusliku loomakasvatusega tegelemise jätkamise aastale vahetult eelnenud aastal üleminekuaja läbinud loomadelt saadud loomakasvatussaaduste koguse kohta.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_10 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333411_Par_11_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 artiklis 11 ja II lisa II osa punkti 1.4.1 alapunktis f nimetatud loomasöödas keelatud aine, organismi või toote tahtmatu kasutamise korral võib Põllumajandus- ja Toiduamet nõuda uue üleminekuaja alustamist selle loomaliigi või -rühma puhul, kelle söödas nimetatud ainet, organismi või toodet kasutati. RT I 2021-12-23 12 123122021012 2022-01-01 Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 artiklis 11 ja II lisa II osa punkti 1.4.1 alapunktis f nimetatud loomasöödas keelatud aine, organismi või toote tahtmatu kasutamise korral võib Põllumajandus- ja Toiduamet nõuda uue üleminekuaja alustamist selle loomaliigi või -rühma puhul, kelle söödas nimetatud ainet, organismi või toodet kasutati.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_11 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333411_Par_12_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jalutusala ja karjamaa peavad olema tarastatud või piiritletud nii, et loom ei pääseks mittemahepõllumajanduslikule maale. Jalutusala ja karjamaa peavad olema tarastatud või piiritletud nii, et loom ei pääseks mittemahepõllumajanduslikule maale.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_12 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333411_Par_12_12_v333411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_333411_Par_12_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajandusliku loomakasvatusega tegelev isik, kes peab Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 II lisa II osas nimetamata loomaliiki kuuluvat looma, täidab üksnes Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 artiklites 9–11 ja 14 ning II lisa II osas sätestatud nõudeid. RT I 2021-12-23 12 123122021012 2022-01-01 Mahepõllumajandusliku loomakasvatusega tegelev isik, kes peab Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 II lisa II osas nimetamata loomaliiki kuuluvat looma, täidab üksnes Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 artiklites 9–11 ja 14 ning II lisa II osas sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_333411_Par_12_12 (redaktsioon 333411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "333411",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/333411",
      "estleg:sourceAct": "Mahepõllumajandusliku tootmise nõuded",
      "estleg:provisionRef": "Reg_333411 § 12_12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_333411_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_333411_Par_13_v333411",
      "@type": [
