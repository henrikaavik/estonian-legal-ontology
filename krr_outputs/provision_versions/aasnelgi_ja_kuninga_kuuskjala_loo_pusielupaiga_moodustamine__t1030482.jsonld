    {
      "@id": "estleg:Reg_1030482_Par_7_v1030482",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030482_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 19. veebruari 2014. a käskkirjaga nr 152 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 19. veebruari 2014. a käskkirjaga nr 152 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1030482_Par_7 (redaktsioon 1030482)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030482",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030482",
      "estleg:sourceAct": "Aasnelgi ja kuninga-kuuskjala Loo püsielupaiga moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1030482 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030482_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030482_Par_8_v1030482",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030482_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
