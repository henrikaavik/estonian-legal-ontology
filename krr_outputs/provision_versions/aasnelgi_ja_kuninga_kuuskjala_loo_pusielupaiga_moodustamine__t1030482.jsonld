    {
      "@id": "estleg:Reg_1030482_Par_2_v1030482",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030482_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Loo püsielupaigana võetakse kaitse alla aasnelgi ja kuninga-kuuskjala kasvukoht Harju maakonnas Jõelähtme vallas Liivamäe külas ja Loo alevikus. Loo püsielupaigana võetakse kaitse alla aasnelgi ja kuninga-kuuskjala kasvukoht Harju maakonnas Jõelähtme vallas Liivamäe külas ja Loo alevikus. 2 (2) Püsielupaiga välis- ja vööndi piir on kantud määruse lisas esitatud kaardile1. Püsielupaiga välis- ja vööndi piir on kantud määruse lisas esitatud kaardile1.",
      "rdfs:label": {
        "@value": "Reg_1030482_Par_2 (redaktsioon 1030482)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030482",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030482",
      "estleg:sourceAct": "Aasnelgi ja kuninga-kuuskjala Loo püsielupaiga moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1030482 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030482_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030482_Par_3_v1030482",
