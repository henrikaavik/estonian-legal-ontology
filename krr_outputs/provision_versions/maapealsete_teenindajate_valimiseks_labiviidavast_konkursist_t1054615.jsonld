  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_maapealsete_teenindajate_valimiseks_labiviidavast_konkursist_t1054615_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Maapealsete teenindajate valimiseks läbiviidavast konkursist huvitatud isikute teavitamine, nõuded konkursi kohta avaldatavale teatele ning Euroopa Komisjoni teavitamise ja heakskiidu küsimise kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Maapealsete teenindajate valimiseks läbiviidavast konkursist huvitatud isikute teavitamine, nõuded konkursi kohta avaldatavale teatele ning Euroopa Komisjoni teavitamise ja heakskiidu küsimise kord"
    },
    {
      "@id": "estleg:Reg_1054615_Par_1_v1054615",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054615_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Konkursi korraldaja määrab vähemalt ühe kontaktisiku, kelle poole on konkursil osalemisest huvitatud isikutel võimalik pöörduda täiendava informatsiooni saamiseks. Konkursi korraldaja määrab vähemalt ühe kontaktisiku, kelle poole on konkursil osalemisest huvitatud isikutel võimalik pöörduda täiendava informatsiooni saamiseks. 2 (2) Konkursi korraldaja teeb laekunud küsimused ja neile antud vastused avalikult kättesaadavaks riigihangete registris või oma veebilehel kolme tööpäeva jooksul küsimuste laekumisest. Konkursi korraldaja teeb laekunud küsimused ja neile antud vastused avalikult kättesaadavaks riigihangete registris või oma veebilehel kolme tööpäeva jooksul küsimuste laekumisest.",
      "rdfs:label": {
        "@value": "Reg_1054615_Par_1 (redaktsioon 1054615)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054615",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054615",
      "estleg:sourceAct": "Maapealsete teenindajate valimiseks läbiviidavast konkursist huvitatud isikute teavitamine, nõuded konkursi kohta avaldatavale teatele ning Euroopa Komisjoni teavitamise ja heakskiidu küsimise kord",
      "estleg:provisionRef": "Reg_1054615 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054615_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054615_Par_2_v1054615",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054615_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkursi korraldaja poolt Euroopa Liidu Teatajas avaldatav teade peab sisaldama järgmist informatsiooni: 1 1) konkursi korraldaja nimi ja kontaktandmed; 2 2) konkursi korraldaja kontaktisiku nimi ja kontaktandmed; 3 3) lennujaama haldaja nimi ja kontaktandmed; 4 4) konkursi objektiks olevate maapealse teeninduse teenuste lühikirjeldus; 5 5) teenuste osutamise alguskuupäev; 6 6) konkursi tulemusena sõlmitava lepingu tähtaeg; 7 7) viide maapealse teenindaja suhtes kehtivatele nõuetele; 8 8) maapealse teeninduse teenuste osutamisega kaasnevate avalikes huvides täidetavate kohustuste loetelu, kui sellised kohustused on kehtestatud; 9 9) konkursil pakkumuse esitamise tähtaeg ja kord; 10 10) konkursi võitja väljaselgitamise tähtaeg ja kord. Konkursi korraldaja poolt Euroopa Liidu Teatajas avaldatav teade peab sisaldama järgmist informatsiooni: konkursi korraldaja nimi ja kontaktandmed; konkursi korraldaja kontaktisiku nimi ja kontaktandmed; lennujaama haldaja nimi ja kontaktandmed; konkursi objektiks olevate maapealse teeninduse teenuste lühikirjeldus; teenuste osutamise alguskuupäev; konkursi tulemusena sõlmitava lepingu tähtaeg; viide maapealse teenindaja suhtes kehtivatele nõuetele; maapealse teeninduse teenuste osutamisega kaasnevate avalikes huvides täidetavate kohustuste loetelu, kui sellised kohustused on kehtestatud; konkursil pakkumuse esitamise tähtaeg ja kord; konkursi võitja väljaselgitamise tähtaeg ja kord.",
      "rdfs:label": {
        "@value": "Reg_1054615_Par_2 (redaktsioon 1054615)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054615",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054615",
      "estleg:sourceAct": "Maapealsete teenindajate valimiseks läbiviidavast konkursist huvitatud isikute teavitamine, nõuded konkursi kohta avaldatavale teatele ning Euroopa Komisjoni teavitamise ja heakskiidu küsimise kord",
      "estleg:provisionRef": "Reg_1054615 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054615_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054615_Par_3_v1054615",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054615_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Konkursi korraldaja esitab Euroopa Komisjonile teabe konkursitingimustesse lennundusseaduse § 5035 lõike 6 punktis 1 kirjeldatud kohustuse lisamise kohta vähemalt üks kuu enne konkursi kohta Euroopa Liidu Teatajas teate avaldamist. Konkursi korraldaja esitab Euroopa Komisjonile teabe konkursitingimustesse lennundusseaduse § 5035 lõike 6 punktis 1 kirjeldatud kohustuse lisamise kohta vähemalt üks kuu enne konkursi kohta Euroopa Liidu Teatajas teate avaldamist. 2 (2) Konkursi korraldaja esitab Euroopa Komisjonile taotluse konkursitingimustesse lennundusseaduse § 5035 lõike 6 punktis 2 kirjeldatud kohustuse lisamiseks heakskiidu saamiseks vähemalt kolm kuud enne konkursi kohta Euroopa Liidu Teatajas teate avaldamist. Konkursi korraldaja esitab Euroopa Komisjonile taotluse konkursitingimustesse lennundusseaduse § 5035 lõike 6 punktis 2 kirjeldatud kohustuse lisamiseks heakskiidu saamiseks vähemalt kolm kuud enne konkursi kohta Euroopa Liidu Teatajas teate avaldamist.",
      "rdfs:label": {
        "@value": "Reg_1054615_Par_3 (redaktsioon 1054615)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054615",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054615",
      "estleg:sourceAct": "Maapealsete teenindajate valimiseks läbiviidavast konkursist huvitatud isikute teavitamine, nõuded konkursi kohta avaldatavale teatele ning Euroopa Komisjoni teavitamise ja heakskiidu küsimise kord",
      "estleg:provisionRef": "Reg_1054615 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054615_Map_2026"
      }
    },
