      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Õppekirjandusele esitatavad nõuded, õppekirjanduseretsenseerimisele ja retsensentidele esitatavad miinimumnõuded ning riigi poolt tagatava minimaalse õppekirjanduse liigid klassiti ja õppeaineti (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Õppekirjandusele esitatavad nõuded, õppekirjanduseretsenseerimisele ja retsensentidele esitatavad miinimumnõuded ning riigi poolt tagatava minimaalse õppekirjanduse liigid klassiti ja õppeaineti"
    },
    {
      "@id": "estleg:Reg_1033895_Par_1_v1033895",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033895_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määrusega reguleeritakse õpikule ja ülesannete kogule (edaspidi õppekirjandus) ning selle retsenseerimisele ja väljaandmisele esitatavaid nõudeid ning riigi poolt tagatava minimaalse õppekirjanduse liike. Käesoleva määrusega reguleeritakse õpikule ja ülesannete kogule (edaspidi õppekirjandus) ning selle retsenseerimisele ja väljaandmisele esitatavaid nõudeid ning riigi poolt tagatava minimaalse õppekirjanduse liike. 2 (2) Määrust kohaldatakse ka digitaalse õppekirjanduse ning õppekirjanduse täienduste ja parandustega kordustrükkide väljaandmisel käesolevas määruses sätestatud erisusi arvesse võttes. Määrust kohaldatakse ka digitaalse õppekirjanduse ning õppekirjanduse täienduste ja parandustega kordustrükkide väljaandmisel käesolevas määruses sätestatud erisusi arvesse võttes.",
      "rdfs:label": {
        "@value": "Reg_1033895_Par_1 (redaktsioon 1033895)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033895",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033895",
      "estleg:sourceAct": "Õppekirjandusele esitatavad nõuded, õppekirjanduseretsenseerimisele ja retsensentidele esitatavad miinimumnõuded ning riigi poolt tagatava minimaalse õppekirjanduse liigid klassiti ja õppeaineti",
      "estleg:provisionRef": "Reg_1033895 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033895_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033895_Par_2_v1033895",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033895_Par_2"
