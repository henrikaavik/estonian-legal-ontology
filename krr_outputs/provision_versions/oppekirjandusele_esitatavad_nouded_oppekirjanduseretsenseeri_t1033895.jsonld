    {
      "@id": "estleg:Reg_1033895_Par_5_v1033895",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033895_Par_5"
