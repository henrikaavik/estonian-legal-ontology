      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded lõhkematerjali ja pürotehnilise toote käitleja personalile pädevustunnistuse andmisel (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded lõhkematerjali ja pürotehnilise toote käitleja personalile pädevustunnistuse andmisel"
    },
    {
      "@id": "estleg:Reg_1040661_Par_1_v1040661",
      "@type": [
        "owl:NamedIndividual",
