      "estleg:provisionRef": "Reg_1060847 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060847_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060847_Par_10_v1060847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060847_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ühendmääruse § 2 lõikes 1 nimetatud e-toetuse keskkonnas esitatav taotlus ja projekti kirjeldus peavad sisaldama lisaks ühendmääruse § 4 lõigetes 1–3 sätestatule järgmisi andmeid ja dokumente: 1 1) kirjeldus, kuidas projektiga rajatakse või rekonstrueeritakse toetuse objektiks olevad teenuseüksused ning kuidas projekt panustab meetmete nimekirja väljundnäitaja „Arendatud taristute arv” saavutamisse; 2 2) kinnitus, et projektiga järgitakse asjakohaseid keskkonnaalaseid õigusakte ja „ei kahjusta oluliselt” põhimõtet; 3 3) projekti tulude ja kulude analüüs; 4 4) projekti riskianalüüs; 5 5) abikõlblike kulude suurus, mille aluseks on tõenduspõhiselt koostatud, säästlik, parima hinna ja kvaliteedi suhtega kulude eelarve; 6 6) teave taotluses nimetatud projekti kulude katmiseks mujalt toetuse taotlemise ja saamise kohta; 7 7) kinnitus, et projekti elluviimisel ei riivata Euroopa Liidu põhiõiguste hartas sätestatud põhiõigusi ega puuetega inimeste õiguste konventsioonis sätestatud õigusi ning projekti elluviimisel kaasatakse võimaluse korral lapsi nende arengule ja vanusele sobiliku lahenduse leidmisel; 8 8) partneri kaasamise korral partneri rolli kirjeldus projekti elluviimisel ja sellekohane partneri kinnitus; 9 9) notariaalselt tõestatud leping, mis tõendab toetuse taotleja, kes ei ole kinnisvara omanik, kasuks seatud hoonestusõiguse olemasolu vähemalt toetusega seotud kohustuste täitmise aja jooksul. Ühendmääruse § 2 lõikes 1 nimetatud e-toetuse keskkonnas esitatav taotlus ja projekti kirjeldus peavad sisaldama lisaks ühendmääruse § 4 lõigetes 1–3 sätestatule järgmisi andmeid ja dokumente: kirjeldus, kuidas projektiga rajatakse või rekonstrueeritakse toetuse objektiks olevad teenuseüksused ning kuidas projekt panustab meetmete nimekirja väljundnäitaja „Arendatud taristute arv” saavutamisse; kinnitus, et projektiga järgitakse asjakohaseid keskkonnaalaseid õigusakte ja „ei kahjusta oluliselt” põhimõtet; projekti tulude ja kulude analüüs; projekti riskianalüüs; abikõlblike kulude suurus, mille aluseks on tõenduspõhiselt koostatud, säästlik, parima hinna ja kvaliteedi suhtega kulude eelarve; teave taotluses nimetatud projekti kulude katmiseks mujalt toetuse taotlemise ja saamise kohta; kinnitus, et projekti elluviimisel ei riivata Euroopa Liidu põhiõiguste hartas sätestatud põhiõigusi ega puuetega inimeste õiguste konventsioonis sätestatud õigusi ning projekti elluviimisel kaasatakse võimaluse korral lapsi nende arengule ja vanusele sobiliku lahenduse leidmisel; partneri kaasamise korral partneri rolli kirjeldus projekti elluviimisel ja sellekohane partneri kinnitus; notariaalselt tõestatud leping, mis tõendab toetuse taotleja, kes ei ole kinnisvara omanik, kasuks seatud hoonestusõiguse olemasolu vähemalt toetusega seotud kohustuste täitmise aja jooksul. 2 (2) Toetuse taotleja võib ühes taotlusvoorus esitada ühe toetuse taotluse, üks taotlus võib sisaldada mitme objekti ehitust või rekonstrueerimist. Toetuse taotleja võib ühes taotlusvoorus esitada ühe toetuse taotluse, üks taotlus võib sisaldada mitme objekti ehitust või rekonstrueerimist.",
      "rdfs:label": {
        "@value": "Reg_1060847_Par_10 (redaktsioon 1060847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060847",
