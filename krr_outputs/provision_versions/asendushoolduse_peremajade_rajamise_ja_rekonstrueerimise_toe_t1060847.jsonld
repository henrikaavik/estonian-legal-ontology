      }
    },
    {
      "@id": "estleg:Reg_1060847_Par_7_v1060847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060847_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse osakaal on maksimaalselt 73,2% abikõlblike kulude maksumusest, mis jaguneb Euroopa Regionaalarengu Fondi ja riikliku kaasfinantseeringu vahel vastavalt 70% ja 3,2%. Maksimaalne toetus taotluse kohta on 522 857,20 eurot. Toetuse saaja kohustuslik omafinantseering on minimaalselt 26,8% abikõlblikest kuludest. Toetuse osakaal on maksimaalselt 73,2% abikõlblike kulude maksumusest, mis jaguneb Euroopa Regionaalarengu Fondi ja riikliku kaasfinantseeringu vahel vastavalt 70% ja 3,2%. Maksimaalne toetus taotluse kohta on 522 857,20 eurot. Toetuse saaja kohustuslik omafinantseering on minimaalselt 26,8% abikõlblikest kuludest.",
      "rdfs:label": {
        "@value": "Reg_1060847_Par_7 (redaktsioon 1060847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060847",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060847",
      "estleg:sourceAct": "Asendushoolduse peremajade rajamise ja rekonstrueerimise toetamine",
      "estleg:provisionRef": "Reg_1060847 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060847_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060847_Par_8_v1060847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060847_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlejaks ja partneriks võib olla: 1 1) kohalik omavalitsus või asendushooldusteenust pakkuv sihtasutus või mittetulundusühing, mille asutajaks on kohalik omavalitsus; 2 2) osaühing või aktsiaselts, mille osanikuks või aktsionäriks on kohalik omavalitsus; 3 3) kohaliku omavalitsuse üksuse otsese või kaudse valitseva mõju all olev üksus kohaliku omavalitsuse üksuse finantsjuhtimise seaduse § 2 punkti 9 tähenduses. Taotlejaks ja partneriks võib olla: kohalik omavalitsus või asendushooldusteenust pakkuv sihtasutus või mittetulundusühing, mille asutajaks on kohalik omavalitsus; osaühing või aktsiaselts, mille osanikuks või aktsionäriks on kohalik omavalitsus; kohaliku omavalitsuse üksuse otsese või kaudse valitseva mõju all olev üksus kohaliku omavalitsuse üksuse finantsjuhtimise seaduse § 2 punkti 9 tähenduses. 2 (2) Taotleja ja partner peavad vastama ühendmääruse § 3 lõigetes 2 ja 4 sätestatule. Taotleja ja partner peavad vastama ühendmääruse § 3 lõigetes 2 ja 4 sätestatule.",
      "rdfs:label": {
        "@value": "Reg_1060847_Par_8 (redaktsioon 1060847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060847",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060847",
      "estleg:sourceAct": "Asendushoolduse peremajade rajamise ja rekonstrueerimise toetamine",
      "estleg:provisionRef": "Reg_1060847 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060847_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060847_Par_9_v1060847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060847_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja ja partner on kohustatud täitma ühendmääruse § 2 lõikes 3 sätestatud nõudeid. Taotleja ja partner on kohustatud täitma ühendmääruse § 2 lõikes 3 sätestatud nõudeid.",
