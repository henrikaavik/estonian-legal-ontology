    },
    {
      "@id": "estleg:Reg_1060847_Par_13_v1060847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060847_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluse nõuetele vastavuse tuvastamine toimub vastavalt ühendmääruse §-s 6 ja käesolevas määruses sätestatule. Taotluse nõuetele vastavuse tuvastamine toimub vastavalt ühendmääruse §-s 6 ja käesolevas määruses sätestatule. 2 (2) Rakendusüksus tunnistab taotleja ja partneri nõuetele vastavaks juhul, kui nad vastavad §-s 8 sätestatud nõuetele. Rakendusüksus tunnistab taotleja ja partneri nõuetele vastavaks juhul, kui nad vastavad §-s 8 sätestatud nõuetele. 3 (3) Rakendusüksus tunnistab taotluse nõuetele vastavaks juhul, kui on täidetud §-s 10 sätestatud nõuded. Rakendusüksus tunnistab taotluse nõuetele vastavaks juhul, kui on täidetud §-s 10 sätestatud nõuded.",
      "rdfs:label": {
        "@value": "Reg_1060847_Par_13 (redaktsioon 1060847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060847",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060847",
      "estleg:sourceAct": "Asendushoolduse peremajade rajamise ja rekonstrueerimise toetamine",
      "estleg:provisionRef": "Reg_1060847 § 13",
      "estleg:partOfAct": {
