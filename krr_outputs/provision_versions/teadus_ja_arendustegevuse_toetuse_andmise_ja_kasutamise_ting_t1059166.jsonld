      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Teadus- ja arendustegevuse toetuse andmise ja kasutamise tingimused ja kord (27 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teadus- ja arendustegevuse toetuse andmise ja kasutamise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1059166_Par_1_v1059166",
      "@type": [
