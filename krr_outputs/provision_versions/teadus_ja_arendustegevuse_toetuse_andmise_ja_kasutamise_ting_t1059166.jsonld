      "estleg:provisionRef": "Reg_1059166 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059166_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1059166_Par_5_v1059166",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
