      "estleg:versionValidFrom": {
        "@value": "2017-09-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lenduri eririietuseks on roheline või hall kombinesoon. Kombinesooni paremal hõlmal on nime- või identifitseerimissilt ning vasakul varrukal riigitunnus ja varrukaembleem. Lenduri eririietuseks on roheline või hall kombinesoon. Kombinesooni paremal hõlmal on nime- või identifitseerimissilt ning vasakul varrukal riigitunnus ja varrukaembleem.",
      "rdfs:label": {
        "@value": "Reg_1039858_Par_29 (redaktsioon 1039858)",
        "@language": "et"
      },
