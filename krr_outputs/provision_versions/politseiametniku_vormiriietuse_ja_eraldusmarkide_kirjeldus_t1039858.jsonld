    {
      "@id": "estleg:Reg_1039858_Par_3_v1039858",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039858_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-09-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tavavorm on tumesinine. Vormisärk on helesinine või valge. Tavavorm on tumesinine. Vormisärk on helesinine või valge. 2 (2) Välivorm on tumesinine käesoleva määruse 2. peatüki 2. jaost tulenevate erisustega. Riigipiiri valvamise ülesannet täitva politseiametniku välivorm võib olla roheline. Rahvusvahelisel tsiviilmissioonil osaleva politseiametniku välivorm võib olla beež. Välivorm on tumesinine käesoleva määruse 2. peatüki 2. jaost tulenevate erisustega. Riigipiiri valvamise ülesannet täitva politseiametniku välivorm võib olla roheline. Rahvusvahelisel tsiviilmissioonil osaleva politseiametniku välivorm võib olla beež. 3 (3) Õhtuvorm on must. Õhtuvormi vest ja kaelaside on valge või must, särk ja pluus on valged. Õhtuvorm on must. Õhtuvormi vest ja kaelaside on valge või must, särk ja pluus on valged. 4 (4) Eririietuse värvus on sätestatud käesoleva määruse 2. peatüki 4. jaos. Eririietuse värvus on sätestatud käesoleva määruse 2. peatüki 4. jaos.",
      "rdfs:label": {
        "@value": "Reg_1039858_Par_3 (redaktsioon 1039858)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039858",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039858",
      "estleg:sourceAct": "Politseiametniku vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039858 § 3",
