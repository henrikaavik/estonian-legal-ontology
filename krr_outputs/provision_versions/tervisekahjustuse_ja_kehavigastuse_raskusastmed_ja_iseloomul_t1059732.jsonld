      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tervisekahjustuse ja kehavigastuse raskusastmed ja iseloomulikud tunnused (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tervisekahjustuse ja kehavigastuse raskusastmed ja iseloomulikud tunnused"
    },
    {
      "@id": "estleg:Reg_1059732_Par_1_v1059732",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059732_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse kindlustusjuhtumi toimumise korral mittevaralise kahju hüvitamisel arvesse võetavad tervishoiuteenuse osutamise tulemusena tekkinud tervisekahjustuse ja kehavigastuse raskusastmed ja iseloomulikud tunnused, mis on esitatud käesoleva määruse lisas. Käesoleva määrusega kehtestatakse kindlustusjuhtumi toimumise korral mittevaralise kahju hüvitamisel arvesse võetavad tervishoiuteenuse osutamise tulemusena tekkinud tervisekahjustuse ja kehavigastuse raskusastmed ja iseloomulikud tunnused, mis on esitatud käesoleva määruse lisas.",
      "rdfs:label": {
        "@value": "Reg_1059732_Par_1 (redaktsioon 1059732)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059732",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1059732",
      "estleg:sourceAct": "Tervisekahjustuse ja kehavigastuse raskusastmed ja iseloomulikud tunnused",
      "estleg:provisionRef": "Reg_1059732 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059732_Map"
      }
    },
    {
      "@id": "estleg:Reg_1059732_Par_2_v1059732",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059732_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekahjustused ja kehavigastused jagunevad kuude raskusastmesse: 1 1) väike tervisekahjustus või kehavigastus; 2 2) keskmise raskusega kergem tervisekahjustus või kehavigastus; 3 3) keskmise raskusega raskem tervisekahjustus või kehavigastus; 4 4) raske tervisekahjustus või kehavigastus; 5 5) väga raske tervisekahjustus või kehavigastus; 6 6) eriti raske tervisekahjustus või kehavigastus või surm. Tervisekahjustused ja kehavigastused jagunevad kuude raskusastmesse: väike tervisekahjustus või kehavigastus; keskmise raskusega kergem tervisekahjustus või kehavigastus; keskmise raskusega raskem tervisekahjustus või kehavigastus; raske tervisekahjustus või kehavigastus; väga raske tervisekahjustus või kehavigastus; eriti raske tervisekahjustus või kehavigastus või surm.",
      "rdfs:label": {
        "@value": "Reg_1059732_Par_2 (redaktsioon 1059732)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059732",
