      }
    },
    {
      "@id": "estleg:TeenMS_Par_8_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maarjamaa Risti teenetemärk on asutatud 1995. aastal Eesti riigi iseseisvuse auks. Maarjamaa Risti teenetemärk antakse Vabariigi Presidendile, samuti kõrgeima astme teenetemärgina välismaalasele, kellel on erilisi teeneid Eesti Vabariigi ees. Maarjamaa Risti teenetemärk jääb ametist lahkunud Vabariigi Presidendile.",
      "rdfs:label": {
        "@value": "TeenMS_Par_8 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_8_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_8_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Punase Risti teenetemärk on asutatud 1920. aastal Eesti Punase Risti Seltsi poolt. Eesti Punase Risti teenetemärk antakse Eesti rahva huvides tervishoiu ja sotsiaalalal osutatud teenete tunnustamiseks ning elu päästmise eest.",
      "rdfs:label": {
        "@value": "TeenMS_Par_8 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_9_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenetemärke annab Vabariigi President Eesti riigile ja rahvale osutatud teenete eest kooskõlas seadusega nii Eesti kodanikele kui ka välismaalastele. Lahinguliste teenete eest võib teenetemärgi anda ka väeosale. (2) Teenetemärke antakse ka postuumselt. (3) Teenetemärkide korraline andmine toimub üks kord aastas - 24. veebruariks, Iseseisvuspäevaks. (4) Erandjuhtudel, seoses Vabariigi Presidendi riigivisiidiga või riigivisiidiga Eestisse või Eestisse akrediteeritud diplomaadi lahkumisel riigist tema ametiaja lõppemise korral, samuti postuumselt või seoses eriolukorraga võib teenetemärke anda ja kätte anda ka muul ajal käesolevas seaduses ettenähtud korras. (5) Erakorralise seisukorra või sõjaseisukorra ajal ei kohaldata teenetemärkide andmisel käesolevas seaduses teenetemärkide taotlemiseks, esildise tegemiseks ja teenetemärkide andmise otsustamiseks ettenähtud korda. Erakorralise seisukorra või sõjaseisukorra ajal võib Vabariigi President anda teenetemärke oma algatusel, samuti isiku ettepanekul, mis on tehtud Vabariigi Valitsuse kinnitatud korras (paragrahv 11 lg. 6).",
      "rdfs:label": {
        "@value": "TeenMS_Par_9 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_9_v12906954"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_9_v12906954",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenetemärke annab Vabariigi President Eesti riigile ja rahvale osutatud teenete eest kooskõlas seadusega nii Eesti kodanikele kui ka välismaalastele. Lahinguliste teenete eest võib teenetemärgi anda ka väeosale. (2) Teenetemärke antakse ka postuumselt. (3) Teenetemärkide korraline andmine toimub üks kord aastas - 24. veebruariks, Iseseisvuspäevaks. (4) Erandjuhtudel, seoses Vabariigi Presidendi riigivisiidiga või riigivisiidiga Eestisse või Eestisse akrediteeritud diplomaadi lahkumisel riigist tema ametiaja lõppemise korral, samuti postuumselt või seoses eriolukorraga võib teenetemärke anda ja kätte anda ka muul ajal käesolevas seaduses ettenähtud korras. (5) Erakorralise seisukorra või sõjaseisukorra ajal ei kohaldata teenetemärkide andmisel käesolevas seaduses teenetemärkide taotlemiseks, esildise tegemiseks ja teenetemärkide andmise otsustamiseks ettenähtud korda. Erakorralise seisukorra või sõjaseisukorra ajal võib Vabariigi President anda teenetemärke oma algatusel, samuti isiku ettepanekul, mis on tehtud Vabariigi Valitsuse kinnitatud korras (§ 11 lg. 6).",
      "rdfs:label": {
        "@value": "TeenMS_Par_9 (redaktsioon 12906954)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906954",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_9_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906954",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_9_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenetemärgi võib anda Eesti kodanikule ja välismaalasele. (2) Teenetemärgi võib anda ka postuumselt. (3) Teenetemärgi võib anda lahinguliste teenete eest ka väeosale. (4) Isikut, kellelt on teenetemärk ära võetud, ei loeta teenetemärgi kavaleriks.",
      "rdfs:label": {
        "@value": "TeenMS_Par_9 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_9_v13009838"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_9_v13009838",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenetemärgi võib anda Eesti kodanikule ja välismaalasele. (2) Teenetemärgi võib anda ka postuumselt. (3) Teenetemärgi võib anda lahinguliste teenete eest ka väeüksusele või allüksusele. (4) Isikut, kellelt on teenetemärk ära võetud, ei loeta teenetemärgi kavaleriks.",
      "rdfs:label": {
        "@value": "TeenMS_Par_9 (redaktsioon 13009838)",
        "@language": "et"
