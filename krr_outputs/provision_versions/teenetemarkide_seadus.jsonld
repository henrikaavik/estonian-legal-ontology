      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kotkaristi III klassi teenetemärk on samasugune nagu II klassi teenetemärk, kuid puudub täht (lisa 5).",
      "rdfs:label": {
        "@value": "TeenMS_Par_49 (redaktsioon 12906303)",
        "@language": "et"
