      }
    },
    {
      "@id": "estleg:TeenMS_Par_3_v13009838",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabadusristi aumärk on asutatud 1919. aastal Vabadussõja-aegsete teenete tunnustamiseks. Vabadusristi aumärk on sõjaline teenetemärk Eesti iseseisvuse kaitsmiseks peetava sõja puhul. (2) Vabadusristi aumärgil on kolm liiki: I liik – antakse sõjaväeliste teenete tunnustamiseks Eesti riigi kaitseks peetavas sõjas; II liik – antakse isikliku vapruse tunnustamiseks Eesti riigi kaitseks peetavas sõjas; III liik – antakse administratiiv- ja tsiviilteenete tunnustamiseks Eesti riigi kaitseks peetavas sõjas. (3) Vabadusristi andmine lõpetati 1925. aasta 19. juuni seadusega. Vabadusristi võib uuesti anda Eesti iseseisvuse kaitsmiseks peetava sõja puhul alates sõjaseisukorra väljakuulutamisest kuni Vabadusristi andmise lõpetamiseks vastu võetava seaduse jõustumiseni.",
      "rdfs:label": {
        "@value": "TeenMS_Par_3 (redaktsioon 13009838)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13009838",
