        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigivapi ketiklassi teenetemärgi kavalerid on president Lennart Georg Meri ja president Arnold Rüütel.",
      "rdfs:label": {
        "@value": "TeenMS_Par_71 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
