    },
    {
      "@id": "estleg:TeenMS_Par_5_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valgetähe teenetemärk on asutatud 1936. aastal Eesti rahva vabadusvõitluse mälestamiseks. Valgetähe teenetemärk antakse Eesti kodanikule riigiteenistuse või kohaliku omavalitsuse alal osutatud teenete tunnustamiseks ja välismaalasele Eesti riigile osutatud teenete eest.",
      "rdfs:label": {
        "@value": "TeenMS_Par_5 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_5_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_5_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maarjamaa Risti teenetemärk on asutatud 1995. aastal Eesti riigi iseseisvuse auks. Maarjamaa Risti teenetemärk antakse välismaalastele kõrgeima teenetemärgina Eesti riigile osutatud teenete tunnustamiseks.",
      "rdfs:label": {
        "@value": "TeenMS_Par_5 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_50_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Punase Risti V klassi teenetemärk on samasugune nagu IV klassi teenetemärk, kuid lindil puudub rullmärk.",
      "rdfs:label": {
        "@value": "TeenMS_Par_50 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_50_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_50_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kotkaristi IV klassi teenetemärk koosneb samasugusest ristist nagu III klassi teenetemärgil, kuid risti läbimõõt on 50 mm ja iga ristiharu välisotsas asetseva täisnurkse sisselõike kaateti pikkus on 12,5 mm (lisa 5). (2) Teenetemärgi lint on 35 mm laiune ja 50 mm pikkune oranž muareelint, mille äärtel on 3 mm laiune sinine triip ja 1,5 mm laiune oranž kant. Lindile on paigutatud siniste triipudega 22 mm läbimõõduga oranž rullmärk.",
      "rdfs:label": {
        "@value": "TeenMS_Par_50 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_50_v13009838"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 50",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_50_v13009838",
