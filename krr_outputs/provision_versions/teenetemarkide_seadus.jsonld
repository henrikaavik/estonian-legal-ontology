      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Iga Vabadusristi aumärgi liik jaguneb kolme järku.",
      "rdfs:label": {
        "@value": "TeenMS_Par_14 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_15_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenetemärgi juurde kuuluva tunnistuse vormi kinnitab Vabariigi Valitsus. (2) Tunnistusele kirjutavad alla Vabariigi President ja Teenetemärkide Komitee esimees. (3) Teenetemärk ja tunnistus antakse autasustatavale tasuta.",
      "rdfs:label": {
        "@value": "TeenMS_Par_15 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_15_v191282"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_15_v191282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenetemärgi juurde kuuluva tunnistuse vormi (2) Tunnistusele kirjutavad alla Vabariigi President ja Teenetemärkide Komitee esimees. (3) Teenetemärk ja tunnistus antakse autasustatavale tasuta.",
      "rdfs:label": {
        "@value": "TeenMS_Par_15 (redaktsioon 191282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "191282",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_15_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/191282",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_15_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabadusristi I liigi 1. järk (1) Vabadusristi I liigi 1. järgu aumärgi rist on 45 mm kõrgune ja 39 mm laiune reljeefne valge emailiga kaetud kuldse äärisega ladina rist. Risti harud on 9 mm laiused, nende otsad laienevad T-kujuliseks. Harude keskjoonel on 1 mm laiune kuldne triip. Risti südamikus paikneb kuldse äärisega must sõõr, millel on kuldsed täht «E» ja käsivars mõõgaga, ning risti tagaküljel sama suur kuldse äärisega must sõõr kuldses kirjas kuupäevaga «24. II 1919» (lisa 1). (2) Aumärgi lint on 30 mm laiune must muareelint, mille mõlemal äärel on 7 mm laiune sinine (PANTONE 285 C) ja 8 mm laiune valge triip.",
      "rdfs:label": {
        "@value": "TeenMS_Par_15 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_15_v13319165"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_15_v13319165",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabadusristi I liigi 1. järgu aumärgi rist on 45 mm kõrgune ja 39 mm laiune reljeefne valge emailiga kaetud kuldse äärisega ladina rist. Risti harud on 9 mm laiused, nende otsad laienevad T-kujuliseks. Harude keskjoonel on 1 mm laiune kuldne triip. Risti südamikus paikneb kuldse äärisega must sõõr, millel on kuldsed täht «E» ja käsivars mõõgaga, ning risti tagaküljel sama suur kuldse äärisega must sõõr kuldses kirjas kuupäevaga «24. II 1919» (lisa 1). (2) Aumärgi lint on 30 mm laiune must muareelint, mille mõlemal äärel on 7 mm laiune sinine (PANTONE 285 C) ja 8 mm laiune valge triip.",
      "rdfs:label": {
        "@value": "TeenMS_Par_15 (redaktsioon 13319165)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13319165",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13319165",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_16_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenetemärgi koos tunnistusega annab autasustatavale pidulikult kätte Vabariigi President või tema nimel Vabariigi Presidendi määratud isik. (2) Iseseisvuspäevaks antud teenetemärgid antakse üldjuhul kätte 23. veebruaril. (3) Postuumselt antud teenetemärk antakse Vabariigi Presidendi otsustusel kätte mõnele autasustatud isiku perekonnaliikmele või mõnele teisele lähedasele.",
      "rdfs:label": {
        "@value": "TeenMS_Par_16 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_16_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 16",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_16_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabadusristi I liigi 2. järk (1) Vabadusristi I liigi 2. järgu aumärgi rist on 39 mm kõrgune ja 34 mm laiune reljeefne valge emailiga kaetud hõbedase äärisega ladina rist. Risti harud on 8 mm laiused, nende otsad laienevad T-kujuliseks. Harude keskjoonel on 1 mm laiune hõbedane triip. Risti südamikus paikneb hõbedase äärisega must sõõr, millel on hõbedased täht «E» ja käsivars mõõgaga, ning risti tagaküljel sama suur hõbedase äärisega must sõõr hõbedases kirjas kuupäevaga «24. II 1919» (lisa 1). (2) Aumärgi lint on 30 mm laiune must muareelint, mille mõlemal äärel on 7 mm laiune sinine (PANTONE 285 C) ja 8 mm laiune valge triip.",
      "rdfs:label": {
        "@value": "TeenMS_Par_16 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_16_v13319165"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 16",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_16_v13319165",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_16"
      },
      "estleg:versionValidFrom": {
