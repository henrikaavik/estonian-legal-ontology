      }
    },
    {
      "@id": "estleg:TeenMS_Par_35_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maarjamaa Risti III klassi teenetemärk on samasugune nagu II klassi teenetemärk, kuid puudub täht (lisa 3). (2) Maarjamaa Risti III klassi teenetemärgi rosettmärk on sinine rosett hõbedasel alusel (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_35 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 35",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_36_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valgetähe teenetemärgi medal on ringikujuline, eesti ornamentkaunistusega väljatöötatud kannaga hõbemedal läbimõõduga 31 mm. Medali esiküljel on reljeefne emailitud valgetähe kujutis. Medali tagaküljel on reljeefsete numbritega kuupäev \"7. X 1936\". (2) Medali lint on 30 mm laiune punane muareelint.",
      "rdfs:label": {
        "@value": "TeenMS_Par_36 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_36_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 36",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_36_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maarjamaa Risti IV klassi teenetemärk on 35 mm laiuse sinise muareelindi külge kinnitatud kolme sinise lõviga kuldne gooti kilp, millele kinnitub Maarjamaa Rist. Teenetemärgi lindile on paigutatud 22 mm läbimõõduga sinine rullmärk (lisa 3). (2) Maarjamaa Risti IV klassi teenetemärgi rosettmärk on sinine rosett (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_36 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 36",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_37_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kotkaristi teenetemärgil on kaheksa klassi: viis põhiklassi - I, II, III, IV ja V klass; kolm medaliklassi - kuld-, hõbe- ja raudrist. (2) Kotkaristi kõigi klasside teenetemärkide ristid on ühesuguse kujundusega. (3) Kotkaristi kõigi klasside teenetemärkide juurde kuuluvate oranžide muareelintide värvitoon on rahvusvahelise PANTONEi värvitabeli alusel 137 MC.",
      "rdfs:label": {
        "@value": "TeenMS_Par_37 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_37_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 37",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_37_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maarjamaa Risti V klassi teenetemärk on samasugune nagu IV klassi teenetemärk, kuid lindil puudub rullmärk (lisa 3). (2) Maarjamaa Risti V klassi teenetemärgi rosettmärk on teenetemärgi lindi 3 mm laiune riba (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_37 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 37",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_38_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kotkaristi I klassi teenetemärk koosneb suurpaelast ja selle juurde kuuluvast hõbetähest. Suurpael on 105 mm laiune oranž muareelint 4 mm laiuse sinise triibuga ja 4 mm laiuse oranži kandiga. (2) Suurpael lõpeb põiksõlmega, mille küljes ripub neljaharuline mõlemalt küljelt emailitud ja 0,5 mm laiuse kuldraamiga ümbritsetud must malta rist läbimõõduga 58 mm. Risti iga haru välimises otsas asetseva täisnurkse sisselõike kaateti pikkus on 15 mm. Risti esiküljele on asetatud oksüdeeritud hõbedast lennuvalmis põhjakotkas, kelle vasaku jala küünte vahel on väike riigivapp kuldsel põhjal ja parema jala küünte vahel kaheteraline mõõk. Kotka tiibadevaheline laius on 23 mm, kotka pikkus pealaest sabasulgede otsteni on 19 mm, mõõga pikkus on 14,5 mm. Risti tagumisel küljel on must emailitud kuldäärega sõõr läbimõõduga 10 mm, mille keskel on ülalt alla asetatud kuupäev \"24. II 1928\"; risti harude tagumisel küljel on deviis PRO PATRIA. (3) Hõbetäht on 85 mm läbimõõduga reljeefne kaheksaharuline täht, mis koosneb 96 teemandikujulisest tsentrist väljapoole suurenevate kühmude reast ja mille keskel on V klassi rist.",
      "rdfs:label": {
        "@value": "TeenMS_Par_38 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_38_v191282"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_38_v191282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kotkaristi I klassi teenetemärk koosneb suurpaelast ja selle juurde kuuluvast hõbetähest. Suurpael on 105 mm laiune oranž muareelint 4 mm laiuse sinise triibuga ja 4 mm laiuse oranži kandiga. (2) Suurpael lõpeb põiksõlmega, mille küljes ripub neljaharuline mõlemalt küljelt emailitud ja 0,5 mm laiuse kuldraamiga ümbritsetud must malta rist läbimõõduga 58 mm. Risti iga haru välimises otsas asetseva täisnurkse sisselõike kaateti pikkus on 15 mm. Risti esiküljele on asetatud oksüdeeritud hõbedast lennuvalmis põhjakotkas, kelle vasaku jala küünte vahel on väike riigivapp kuldsel põhjal ja parema jala küünte vahel kaheteraline mõõk.Kotka tiibadevaheline laius on 23 mm, kotka pikkus pealaest sabasulgede otsteni on 19 mm, mõõga pikkus on 14,5 mm. Risti tagumisel küljel on must emailitud kuldäärega sõõr läbimõõduga 10 mm, mille keskel on ülalt alla asetatud kuupäev \"24. II 1928\"; risti harude tagumisel küljel on deviis PRO PATRIA. (3) Hõbetäht on 85 mm läbimõõduga reljeefne kaheksaharuline täht, mis koosneb 96 teemandikujulisest tsentrist väljapoole suurenevate kühmude reast ja mille keskel on V klassi rist.",
      "rdfs:label": {
        "@value": "TeenMS_Par_38 (redaktsioon 191282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "191282",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_38_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/191282",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_38_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valgetähe kõikide klasside teenetemärkide tähed on ühesuguse kujunduse, kuid eri mõõtmetega. (2) Valgetähe kõikide klasside teenetemärkide muareelint on punane (PANTONE 206 MC).",
      "rdfs:label": {
        "@value": "TeenMS_Par_38 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_39_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kotkaristi II klassi teenetemärk koosneb samasugusest ristist ja selle juurde kuuluvast samasugusest tähest, nagu on I klassi teenetemärgil, kuid rist ripub 40 mm laiuse oranži muareelindi küljes, mille keskel on 1 mm laiune sinine triip, äärtel 3 mm laiune sinine triip ja 1,5 mm laiune oranž kant.",
      "rdfs:label": {
        "@value": "TeenMS_Par_39 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_39_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_39_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valgetähe ketiklassi teenetemärgi kett on Eesti ornamentkaunistusega 30 mm laiune kullatud hõbekett, mille lukuks on 38 mm läbimõõduga kullatud suure riigivapi kujuline märk. Keti külge on kinnitatud kuueharuline mõlemalt poolt valge emailiga kaetud kullatud täht, mille läbimõõt on 65 mm. Tähe esikülje südamikus on kuueharuline väike kuldtäht, tagakülje südamikus on kuupäev «7. X 1936». Tähe südamikust väljuvad harudevahelised kuldkaunistused (lisa 4). (2) Valgetähe ketiklassi teenetemärgi juurde kuulub kuuekandiline 83 mm läbimõõduga kuldtäht, millele on kinnitatud kuueharuline valge emailiga kaetud täht. Tähe südamikku on paigutatud 38 mm läbimõõduga kullatud suure riigivapi kujuline märk. (3) Valgetähe ketiklassi teenetemärgi juurde kuulub I klassi suurpael. (4) Valgetähe ketiklassi teenetemärgi rosettmärgiks on I klassi rosettmärk (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_39 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_4_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigivapi teenetemärk on asutatud 1936. aastal Eesti iseseisvuse väljakuulutamise päeva, 1918. aasta 24. veebruari mälestamiseks. Riigivapi teenetemärk antakse ainult Eesti kodanikule kõrgeima astme teenetemärgina riigile osutatud teenete eest.",
      "rdfs:label": {
        "@value": "TeenMS_Par_4 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_4_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_4_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigivapi teenetemärk on asutatud 1936. aastal Eesti iseseisvuse väljakuulutamise päeva – 1918. aasta 24. veebruari mälestamiseks. Riigivapi teenetemärk antakse ainult Eesti kodanikule kõrgeima teenetemärgina riigile osutatud teenete tunnustamiseks. (2) Vabariigi President on Riigivapi ketiklassi teenetemärgi kavaler. Teenetemärgi kett antakse edasi koos Vabariigi Presidendi ametiga.",
      "rdfs:label": {
        "@value": "TeenMS_Par_4 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_40_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kotkaristi III klassi teenetemärk on samasugune nagu II klassi teenetemärk, kuid puudub täht.",
      "rdfs:label": {
        "@value": "TeenMS_Par_40 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_40_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 40",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_40_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valgetähe I klassi teenetemärk koosneb suurpaelast ja selle juurde kuuluvast hõbetähest. Suurpael on meestel 105 mm ja naistel 64 mm laiune punane muareelint, mille põiksõlme küljes ripub 65 mm läbimõõduga kuueharuline valgetäht (lisa 4). (2) Hõbetäht on 83 mm läbimõõduga kuuekandiline täht, millele on kinnitatud kuueharuline valge emailiga kaetud täht. Tähe südamikku on paigutatud 38 mm läbimõõduga kullatud suure riigivapi kujuline märk. (3) Valgetähe I klassi teenetemärgi rosettmärk on punane rosett kuldsel alusel (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_40 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 40",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_41_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kotkaristi IV klassi teenetemärk koosneb samasugusest ristist nagu III klassi teenetemärgil, kuid risti läbimõõt on 50 mm ja iga ristiharu välisotsas asetseva täisnurkse sisselõike kaateti pikkus on 12,5 mm. (2) Teenetemärgi lint on 35 mm laiune ja 50 mm pikkune oranž muareelint, mille äärtel on 3 mm laiune sinine triip ja 1,5 mm laiune oranž kant. Lindi alumine osa on 18 mm ulatuses täisnurgakujuline. (3) Teenetemärgi lindile on paigutatud siniste triipudega oranž rullmärk läbimõõduga 22 mm.",
      "rdfs:label": {
        "@value": "TeenMS_Par_41 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_41_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 41",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_41_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valgetähe II klassi teenetemärk koosneb 41 mm laiuse punase muareelindi küljes rippuvast 65 mm läbimõõduga valgetähest ning selle juurde kuuluvast samasugusest tähest nagu I klassi teenetemärgil (lisa 4). (2) Valgetähe II klassi teenetemärgi rosettmärk on punane rosett alusel, mille vasak pool on hõbedane ja parem pool kuldne (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_41 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 41",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_42_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kotkaristi V klassi teenetemärk on samasugune nagu IV klassi teenetemärk, kuid lindil puudub rullmärk.",
      "rdfs:label": {
        "@value": "TeenMS_Par_42 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_42_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 42",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_42_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valgetähe III klassi teenetemärk on samasugune nagu II klassi teenetemärk, kuid puudub täht (lisa 4). (2) Valgetähe III klassi teenetemärgi rosettmärk on punane rosett hõbedasel alusel (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_42 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 42",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_43_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kotkaristi kuld-, hõbe- ja raudrist on kujult ja suuruselt samasugused nagu V klassi teenetemärgil, kuid need on metallist, ilma emailita. (2) Kotkaristi kuld-, hõbe- ja raudristi lint on 35 mm laiune oranž muareelint, mille keskel on 1 mm laiused sinised triibud: kuldristil on kolm triipu vahedega 2,5 mm; hõberistil on kaks triipu vahega 6 mm; raudristil on üks triip.",
      "rdfs:label": {
        "@value": "TeenMS_Par_43 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_43_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 43",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_43_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valgetähe IV klassi teenetemärk on 35 mm laiuse punase muareelindi küljes rippuv 47 mm läbimõõduga valgetäht. Teenetemärgi lindile on paigutatud 22 mm läbimõõduga punane rullmärk (lisa 4). (2) Valgetähe IV klassi teenetemärgi rosettmärk on punane rosett (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_43 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 43",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_44_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kotkaristi teenetemärk on sõjaline, kui talle on lisatud kaks ristuvat mõõka: ristil on ristuvad mõõgad kinnitatud mõõkade käepidemete kohalt liikuvalt ülemiste ristiharude tippude külge. Mõõkade pikkus koos käepidemega on I, II ja III klassi teenetemärgil 35 mm; IV ja V klassi teenetemärgil ning kuld-, hõbe- ja raudristil 33 mm; tähel on ristuvad mõõgad kinnitatud tähe põikharude peale, vertikaal- ja horisontaalharud jäävad katmata. Mõõkade käepidemed asetsevad allpool. Mõõkade pikkus on 85 mm. (2) Kotkaristi põhiklasside teenetemärkidel ja kuldristil on kuldmõõgad, Kotkaristi hõbe- ja raudristil aga ristiga samast metallist mõõgad.",
      "rdfs:label": {
        "@value": "TeenMS_Par_44 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_44_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 44",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_44_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valgetähe V klassi teenetemärk on samasugune nagu IV klassi teenetemärk, kuid lindil puudub rullmärk (lisa 4). (2) Valgetähe V klassi teenetemärgi rosettmärk on teenetemärgi lindi 3 mm laiune riba (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_44 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 44",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_45_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Punase Risti teenetemärgil on kuus klassi: viis põhiklassi - I, II, III, IV ja V klass; üks medaliklass. (2) Eesti Punase Risti kõigi põhiklasside teenetemärkide ristid on ühesuguse kujundusega. (3) Eesti Punase Risti kõigi klasside teenetemärkide juurde kuuluvate muareelintide sinine värvitoon on rahvusvahelise PANTONEi värvitabeli alusel 297 MC.",
      "rdfs:label": {
        "@value": "TeenMS_Par_45 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_45_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 45",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_45_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valgetähe medaliklassi teenetemärgi medal on sõõrikujuline, Eesti ornamentkaunistusega, väljatöötatud kannaga hõbemedal, mille läbimõõt on 31 mm. Medali esiküljel on reljeefne emailitud valgetähe kujutis. Medali tagaküljel on reljeefsete numbritega kuupäev «7. X 1936» (lisa 4). (2) Valgetähe medaliklassi teenetemärgi lint on 30 mm laiune punane muareelint. (3) Valgetähe medaliklassi teenetemärgi rosettmärgiks on V klassi rosettmärk (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_45 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 45",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_46_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Punase Risti I klassi teenetemärk koosneb suurpaelast ja selle juurde kuuluvast hõbetähest. Suurpael on 110 mm laiune muareelint, mille keskel on 59 mm laiune sinine triip. Mõlemal pool seda triipu järgnevad 6 mm laiune must triip, 7 mm laiune valge triip, 2 mm laiune must triip ja 10,5 mm laiune sinine triip äärtel. Suurpael lõpeb põiksõlmega, mille küljes ripub II klassi rist. (2) Hõbetäht on 86 mm läbimõõduga kaheksaharuline täht läikivate kolmeharuliselt lõppevate kiirtega, mille peal asetsevad tsentrist väljapoole suurenevad ümmargused kühmukesed. Iga kiirtepaari vahel on kuus tuhmist hõbedast püramiiditaolistest tsentrist väljapoole suurenevatest kühmudest koosnevat rida, mis lõpevad ümmarguse munakesega. Tähe peal asetseb 41 mm pikkuste ja 9,5 mm laiuste harudega punane emailitud rist, mis on ümbritsetud 1,5 mm laiusesse kullatud raami paigutatud 2 mm laiuse valge emailitud triibuga. Ristil on Eesti riigivärvidesse paigutatud stiliseeritud 24,5 mm suuruses kaheksanurgas kolm sinist lõvi kuldsel põhjal.",
      "rdfs:label": {
        "@value": "TeenMS_Par_46 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_46_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 46",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_46_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kotkaristi kõikide klasside teenetemärkide ristid on ühesuguse kujundusega. (2) Kotkaristi kõikide klasside teenetemärkide muareelint on oranž (PANTONE 137 MC). (3) Kotkaristi kõikide klasside teenetemärkide juurde kuulub 10 mm kõrgune ja 35 mm laiune lindilõige, millele on kinnitatud teenetemärgi klassi tähistav rosettmärk (lisa 7). Kotkaristi sõjaliste teenetemärkide lindilõikeile on lisatud ristuvad mõõgad.",
      "rdfs:label": {
        "@value": "TeenMS_Par_46 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
