    },
    {
      "@id": "estleg:TeenMS_Par_76_v13250842",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2008. aasta 1. märtsil. (2) Käesoleva seaduse § 4 lõige 2 ja § 71 jõustuvad 2008. aasta 23. veebruaril. (3) Käesoleva seaduse § 74 jõustub üldises korras.",
      "rdfs:label": {
        "@value": "TeenMS_Par_76 (redaktsioon 13250842)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13250842",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13250842",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 76",
