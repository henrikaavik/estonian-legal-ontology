      }
    },
    {
      "@id": "estleg:TeenMS_Par_72_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikantselei annab teenetemärkide andmisega seonduva asjaajamise Vabariigi Presidendi Kantseleile üle kuu aja jooksul käesoleva seaduse jõustumisest arvates. Esitatud taotlused loetakse teenetemärgi andmise ettepanekuteks.",
      "rdfs:label": {
        "@value": "TeenMS_Par_72 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 72",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
