      }
    },
    {
      "@id": "estleg:TeenMS_Par_19_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik, kes paneb teenetemärgi suhtes toime ebaseadusliku teo, võetakse haldus- või kriminaalvastutusele seaduses ettenähtud alustel ja korras.",
      "rdfs:label": {
        "@value": "TeenMS_Par_19 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_19_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_19_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabadusristi II liigi 2. järk (1) Vabadusristi II liigi 2. järgu aumärgi rist on 39 mm kõrgune ja 34 mm laiune reljeefne musta emailiga kaetud hõbedase äärisega ladina rist. Risti harud on 8 mm laiused, nende otsad laienevad T-kujuliseks. Harude keskjoonel on 1 mm laiune hõbedane triip. Risti südamikus paikneb hõbedase äärisega punane sõõr, millel on hõbedased täht «E» ja käsivars mõõgaga, ning risti tagaküljel sama suur hõbedase äärisega punane sõõr hõbedases kirjas kuupäevaga «24. II 1919» (lisa 1). (2) Aumärgi lint on 30 mm laiune sinine (PANTONE 285 C) muareelint, mille mõlemal äärel on 7 mm laiune must ja 8 mm laiune valge triip.",
      "rdfs:label": {
        "@value": "TeenMS_Par_19 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_19_v13319165"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
