    {
      "@id": "estleg:TeenMS_Par_2_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenetemärgid on: Vabadusrist; Riigivapi teenetemärk; Valgetähe teenetemärk; Kotkaristi teenetemärk; Eesti Punase Risti teenetemärk; Maarjamaa Risti teenetemärk.",
      "rdfs:label": {
        "@value": "TeenMS_Par_2 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_2_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 2",
      "estleg:partOfAct": {
