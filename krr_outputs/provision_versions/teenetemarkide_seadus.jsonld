      }
    },
    {
      "@id": "estleg:TeenMS_Par_32_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valgetähe II klassi teenetemärk koosneb 41 mm laiuse punase muareelindi küljes rippuvast samasugusest valgest ristist ning selle juurde kuuluvast samasugusest tähest nagu I klassi teenetemärgil.",
      "rdfs:label": {
        "@value": "TeenMS_Par_32 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_32_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 32",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_32_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maarjamaa Risti ketiklassi teenetemärgi kett on 22 mm laiune hõbekett, mis koosneb kaheteistkümnest Maarja monogrammist, kuuest kullatud põhjaga gooti kilbist, millel on kolm emailitud sinist lõvi ja kuuest 22 mm läbimõõduga Maarjamaa Ristist. Keti lukuks on gooti kilp, mille külge on kinnitatud Maarjamaa Rist (lisa 3). (2) Maarjamaa Rist on hõbedast, mõlemalt poolt valge emailiga kaetud 48 mm läbimõõduga käpprist, mille harud on mõlemalt poolt ääristatud 2 mm laiuse sinise ja musta emailitud triibuga. Risti tagaküljel on kiri «PRO TERRA MARIANA». Risti harude vahel paiknevad Maarja monogrammid. (3) Maarjamaa Risti ketiklassi teenetemärgi juurde kuulub kaheksaharuline 80 mm läbimõõduga hõbetäht. Sellele on kinnitatud 48 mm läbimõõduga Maarjamaa Rist, mille keskele on paigutatud kolme sinise lõviga kuldne gooti kilp, mille läbimõõt on 16 mm. (4) Maarjamaa Risti ketiklassi teenetemärgi juurde kuulub I klassi teenetemärgi suurpael, mis on meestel 105 mm ja naistel 64 mm laiune sinine muareelint. Põiksõlme küljes ripub kolme sinise lõviga kuldne gooti kilp, millele kinnitub Maarjamaa Rist. (5) Maarjamaa Risti ketiklassi teenetemärgi juurde kuulub I klassi rosettmärk (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_32 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 32",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_33_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valgetähe III klassi teenetemärk on samasugune nagu II klassi teenetemärk, kuid puudub täht.",
      "rdfs:label": {
        "@value": "TeenMS_Par_33 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_33_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 33",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_33_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maarjamaa Risti I klassi teenetemärk koosneb suurpaelast ja selle juurde kuuluvast hõbetähest. Suurpael on meestel 105 mm ja naistel 64 mm laiune sinine muareelint. Selle põiksõlme küljes ripub kolme sinise lõviga kuldne gooti kilp, millele kinnitub Maarjamaa Rist (lisa 3). (2) Hõbetäht on samasugune nagu Maarjamaa Risti ketiklassi teenetemärgi juurde kuuluv hõbetäht. (3) Maarjamaa Risti I klassi teenetemärgi rosettmärk on sinine rosett kuldsel alusel (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_33 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 33",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_34_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valgetähe IV klassi teenetemärk on 35 mm laiuse punase muareelindi küljes rippuv valge rist läbimõõduga 47 mm. Teenetemärgi lindile on paigutatud punane rullmärk läbimõõduga 22 mm.",
      "rdfs:label": {
        "@value": "TeenMS_Par_34 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeenMS_Par_34_v12906303"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22364",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_34_v12906303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maarjamaa Risti II klassi teenetemärk koosneb 40 mm laiuse sinise muareelindi külge kinnitatud kolme sinise lõviga kuldsest gooti kilbist, millele kinnitub Maarjamaa Rist, ning selle juurde kuuluvast samasugusest hõbetähest nagu ketiklassi teenetemärgil (lisa 3). (2) Maarjamaa Risti II klassi teenetemärgi rosettmärk on sinine rosett alusel, mille vasak pool on hõbedane ja parem pool kuldne (lisa 7).",
      "rdfs:label": {
        "@value": "TeenMS_Par_34 (redaktsioon 12906303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12906303",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12906303",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TeenMS_Par_35_v22364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valgetähe V klassi teenetemärk on samasugune nagu IV klassi teenetemärk, kuid lindil puudub rullmärk.",
      "rdfs:label": {
        "@value": "TeenMS_Par_35 (redaktsioon 22364)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22364",
