      }
    },
    {
      "@id": "estleg:TeenMS_Par_67_v112072014137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeenMS_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riikliku teenetemärgi ostmise, müümise, vahetamise või muu tasulise üleandmise, samuti teenetemärgi kandmise eest isiku poolt, kellel ei ole selleks õigust, – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 2000 eurot.",
      "rdfs:label": {
        "@value": "TeenMS_Par_67 (redaktsioon 112072014137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014137",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112072014137",
      "estleg:sourceAct": "Teenetemärkide seadus",
      "estleg:provisionRef": "TeenMS § 67",
      "estleg:partOfAct": {
        "@id": "estleg:TeenMS_Map_2026"
      }
    },
    {
