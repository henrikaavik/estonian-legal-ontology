    {
      "@id": "estleg:Reg_1045406_Par_13_v1045406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045406_Par_13"
