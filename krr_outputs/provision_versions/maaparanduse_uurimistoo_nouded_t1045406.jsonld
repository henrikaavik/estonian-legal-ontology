      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maaparanduse uurimistöö liigid on: 1 1) topogeodeetiline uurimistöö; 2 2) pinnase uurimistöö; 3 3) kultuurtehniline uurimistöö; 4 4) hüdrotehniline uurimistöö; 5 5) maaparandussüsteemi teenindava tee (edaspidi tee) uurimistöö; 6 6) maaparandussüsteemi tehnilise seisukorra uurimistöö; 7 7) muu projekteerimistingimustes ettenähtud uurimistöö. Maaparanduse uurimistöö liigid on: topogeodeetiline uurimistöö; pinnase uurimistöö; kultuurtehniline uurimistöö; hüdrotehniline uurimistöö; maaparandussüsteemi teenindava tee (edaspidi tee) uurimistöö; maaparandussüsteemi tehnilise seisukorra uurimistöö; muu projekteerimistingimustes ettenähtud uurimistöö.",
      "rdfs:label": {
        "@value": "Reg_1045406_Par_2 (redaktsioon 1045406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045406",
