    {
      "@id": "estleg:Reg_1045437_Par_10_v1045437",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045437_Par_10"
