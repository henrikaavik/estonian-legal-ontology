      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kiirabi, haiglate, pääste- ja politseiasutuste, Kaitseväe ning Terviseameti kiirabialase koostöö kord (13 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kiirabi, haiglate, pääste- ja politseiasutuste, Kaitseväe ning Terviseameti kiirabialase koostöö kord"
    },
    {
      "@id": "estleg:Reg_1045437_Par_1_v1045437",
      "@type": [
