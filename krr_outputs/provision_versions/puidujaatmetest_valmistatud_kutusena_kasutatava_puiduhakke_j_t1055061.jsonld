      "estleg:sourceAct": "Puidujäätmetest valmistatud kütusena kasutatava puiduhakke jäätmeks oleku lakkamise kriteeriumid",
      "estleg:provisionRef": "Reg_1055061 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055061_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055061_Par_12_v1055061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055061_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pädev mõõtja koostab kohe pärast proovi võtmist proovivõtuprotokolli. Pädev mõõtja koostab kohe pärast proovi võtmist proovivõtuprotokolli. 2 (2) Proovivõtuprotokoll peab sisaldama vähemalt järgmist: 1 1) proovivõtu kuupäev ja kellaaeg; 2 2) ilmastikutingimused (temperatuur, pilvisus, sademed jms); 3 3) partii number; 4 4) proovivõtu kirjeldus (proovivõtumeetod ja -vahendid jms); 5 5) pädeva mõõtja ees- ja perekonnanimi ning allkiri; 6 6) proovi katselaborisse andmise kuupäev ja kellaaeg; 7 7) proovi vastuvõtja ees- ja perekonnanimi ning allkiri. Proovivõtuprotokoll peab sisaldama vähemalt järgmist: proovivõtu kuupäev ja kellaaeg; ilmastikutingimused (temperatuur, pilvisus, sademed jms); partii number; proovivõtu kirjeldus (proovivõtumeetod ja -vahendid jms); pädeva mõõtja ees- ja perekonnanimi ning allkiri; proovi katselaborisse andmise kuupäev ja kellaaeg; proovi vastuvõtja ees- ja perekonnanimi ning allkiri.",
      "rdfs:label": {
        "@value": "Reg_1055061_Par_12 (redaktsioon 1055061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055061",
