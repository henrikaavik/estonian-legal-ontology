    {
      "@id": "estleg:Reg_1055061_Par_3_v1055061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055061_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puidujäätmed jagatakse puidu omaduste järgi järgmistesse kategooriatesse: 1 1) A-kategooria puidujäätmed – looduslikus olekus puit, mida ei ole värvitud, lakitud, kaetud ega kemikaalidega töödeldud; 2 2) B-kategooria puidujäätmed – värvitud, lakitud, kaetud või kemikaalidega töödeldud puit, mis ei sisalda keemilisi ebapuhtusi üle käesoleva määruse lisades 2 ja 3 sätestatud piirväärtuste. Puidujäätmed jagatakse puidu omaduste järgi järgmistesse kategooriatesse: A-kategooria puidujäätmed – looduslikus olekus puit, mida ei ole värvitud, lakitud, kaetud ega kemikaalidega töödeldud; B-kategooria puidujäätmed – värvitud, lakitud, kaetud või kemikaalidega töödeldud puit, mis ei sisalda keemilisi ebapuhtusi üle käesoleva määruse lisades 2 ja 3 sätestatud piirväärtuste.",
      "rdfs:label": {
        "@value": "Reg_1055061_Par_3 (redaktsioon 1055061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055061",
