    {
      "@id": "estleg:Reg_154102_Par_2_v154102",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154102_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Töökeskkonna õhu pliisisaldust tuleb määrata vähemalt üks kord kolme kuu jooksul. Pliisisaldust võib määrata üks kord aastas, kui kahel viimasel mõõtmisel: 1 1) õhu pliisisaldus ei ületanud 100 µg/m3; 2 2) töökeskkonna olud ei ole muutunud; 3 3) ühegi töötaja vere pliisisaldus ei ületa 60 µg Pb / 100 ml. Töökeskkonna õhu pliisisaldust tuleb määrata vähemalt üks kord kolme kuu jooksul. Pliisisaldust võib määrata üks kord aastas, kui kahel viimasel mõõtmisel: õhu pliisisaldus ei ületanud 100 µg/m3; töökeskkonna olud ei ole muutunud; ühegi töötaja vere pliisisaldus ei ületa 60 µg Pb / 100 ml. 2 (2) Töökeskkonna õhu pliisisaldust mõõdab tööandja tellimusel akrediteerimisasutuse akrediteeritud või erialase pädevuse kinnitust omav labor aatomabsorbtsioon-spektromeetril või mõne teise ekvivalentset tulemust andva meetodiga. Õhuproovid kogutakse hingamistsoonist filtrile, mis kogub vähemalt 95% osakesi aerodünaamilise diameetriga 0,3 µm, kasutades pumpa, mille tootlikkus on vähemalt 1 l/min. RT I 2020-11-12 1 112112020001 2020-11-24 Töökeskkonna õhu pliisisaldust mõõdab tööandja tellimusel akrediteerimisasutuse akrediteeritud või erialase pädevuse kinnitust omav labor aatomabsorbtsioon-spektromeetril või mõne teise ekvivalentset tulemust andva meetodiga. Õhuproovid kogutakse hingamistsoonist filtrile, mis kogub vähemalt 95% osakesi aerodünaamilise diameetriga 0,3 µm, kasutades pumpa, mille tootlikkus on vähemalt 1 l/min.",
      "rdfs:label": {
        "@value": "Reg_154102_Par_2 (redaktsioon 154102)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154102",
