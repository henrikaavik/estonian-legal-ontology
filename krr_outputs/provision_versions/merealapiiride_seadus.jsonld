      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Merealapiiride seadus (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Merealapiiride seadus"
    },
    {
      "@id": "estleg:merealapiiride_seadus_Par_1_v24407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:merealapiiride_seadus_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Merealad on käesoleva seaduse mõistes maismaaga piirnev osa merest, millele laieneb Eesti jurisdiktsioon.",
      "rdfs:label": {
        "@value": "merealapiiride_seadus_Par_1 (redaktsioon 24407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24407"
    },
    {
      "@id": "estleg:merealapiiride_seadus_Par_2_v24407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:merealapiiride_seadus_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Merealade jaotuse aluseks on Genfi 1958.aasta territoriaalmere ja selle külgvööndi konventsiooni ning ÜRO 1982. aasta mereõiguse konventsiooni sätted.",
      "rdfs:label": {
        "@value": "merealapiiride_seadus_Par_2 (redaktsioon 24407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24407"
    },
    {
      "@id": "estleg:merealapiiride_seadus_Par_3_v24407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:merealapiiride_seadus_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Territoriaalmere lähtejoon on mõtteline joon, mis madalvee puhul ühendab omavahel maismaa, saarte, laidude, kaljude ja veest väljaulatuvate üksikute kivide rannikust kõige kaugemal asuvaid punkte.Territoriaalmere lähtejoone koordinaadid on esitatud lisas 1.",
      "rdfs:label": {
        "@value": "merealapiiride_seadus_Par_3 (redaktsioon 24407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24407"
    },
    {
      "@id": "estleg:merealapiiride_seadus_Par_4_v24407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:merealapiiride_seadus_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sisemeri on mereala, mis asub territoriaalmere lähtejoone ja ranniku vahel.",
      "rdfs:label": {
        "@value": "merealapiiride_seadus_Par_4 (redaktsioon 24407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24407"
    },
    {
      "@id": "estleg:merealapiiride_seadus_Par_5_v24407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:merealapiiride_seadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Territoriaalmeri on sisemerega külgnev mereala, mille välispiir on määratud käesoleva seadusega.Territoriaalmere piiri koordinaadid on esitatud lisas 2.",
      "rdfs:label": {
        "@value": "merealapiiride_seadus_Par_5 (redaktsioon 24407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24407"
    },
    {
      "@id": "estleg:merealapiiride_seadus_Par_6_v24407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:merealapiiride_seadus_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Territoriaalmere laius on 12 meremiili. Territoriaalmere laiuse osas võib teha erandeid, lähtudes rahvusvahelistest konventsioonidest ja lepingutest naaberriikidega.",
      "rdfs:label": {
        "@value": "merealapiiride_seadus_Par_6 (redaktsioon 24407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24407"
    },
    {
      "@id": "estleg:merealapiiride_seadus_Par_7_v24407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:merealapiiride_seadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandusvöönd on väljaspool territoriaalmerd asuv ja viimasega külgnev mereala, mille välispiir on määratud naaberriikidega kooskõlastatult.Majandusvööndi piiri koordinaadid on esitatud lisas 3.",
      "rdfs:label": {
        "@value": "merealapiiride_seadus_Par_7 (redaktsioon 24407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24407"
    }
  ]
}
