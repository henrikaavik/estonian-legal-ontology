        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitsekorra põhjendused on esitatud määruse seletuskirjas3. Kaitsekorra põhjendused on esitatud määruse seletuskirjas3.",
      "rdfs:label": {
