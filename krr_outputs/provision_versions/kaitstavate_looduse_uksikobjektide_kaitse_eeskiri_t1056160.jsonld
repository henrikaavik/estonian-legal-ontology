    {
      "@id": "estleg:Reg_1056160_Par_1_v1056160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056160_Par_1"
