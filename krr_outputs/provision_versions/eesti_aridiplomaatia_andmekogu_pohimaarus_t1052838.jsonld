      "estleg:sourceAct": "Eesti äridiplomaatia andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1052838 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052838_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1052838_Par_9_v1052838",
      "@type": [
        "owl:NamedIndividual",
