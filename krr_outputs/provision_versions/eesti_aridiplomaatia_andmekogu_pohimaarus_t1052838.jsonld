    {
      "@id": "estleg:Reg_1052838_Par_5_v1052838",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052838_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogusse kannete tegemise aluseks on ütluspõhised andmed, mida vajaduse korral täpsustatakse äriregistrist saadud andmetega. Andmekogusse kannete tegemise aluseks on ütluspõhised andmed, mida vajaduse korral täpsustatakse äriregistrist saadud andmetega.",
      "rdfs:label": {
        "@value": "Reg_1052838_Par_5 (redaktsioon 1052838)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052838",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052838",
      "estleg:sourceAct": "Eesti äridiplomaatia andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1052838 § 5",
      "estleg:partOfAct": {
