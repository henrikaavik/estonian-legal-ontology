      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu eesmärk on pidada arvestust Eesti välisesinduste tegevuste kohta Eesti ärihuvide esindamisel ja edendamisel välisturgudel ning talletada elektrooniliselt asjaomaste ettevõtete kontaktandmed ja informatsioon, et anda edasi teadmus teenistujate vahel ja teha järeldusi inimvara ja tulevaste investeeringute tõhusamaks planeerimiseks. Andmekogu eesmärk on pidada arvestust Eesti välisesinduste tegevuste kohta Eesti ärihuvide esindamisel ja edendamisel välisturgudel ning talletada elektrooniliselt asjaomaste ettevõtete kontaktandmed ja informatsioon, et anda edasi teadmus teenistujate vahel ja teha järeldusi inimvara ja tulevaste investeeringute tõhusamaks planeerimiseks.",
      "rdfs:label": {
        "@value": "Reg_1052838_Par_2 (redaktsioon 1052838)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052838",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052838",
      "estleg:sourceAct": "Eesti äridiplomaatia andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1052838 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052838_Map_2026"
      }
    },
