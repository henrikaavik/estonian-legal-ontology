      "estleg:provisionRef": "Reg_1056045 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056045_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056045_Par_12_v1056045",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
