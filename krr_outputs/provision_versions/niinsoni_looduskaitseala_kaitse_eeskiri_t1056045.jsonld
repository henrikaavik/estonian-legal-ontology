      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitsealal on vajalik kraavide sulgemine metsa- ja sookoosluste taastamiseks. Kaitsealal on vajalik kraavide sulgemine metsa- ja sookoosluste taastamiseks.",
      "rdfs:label": {
        "@value": "Reg_1056045_Par_6 (redaktsioon 1056045)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056045",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056045",
