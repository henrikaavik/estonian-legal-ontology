      },
      "estleg:versionText": "Käesoleva määrusega sätestatakse maa-, haldus- ja ringkonnakohtu kohtuniku ja kohtukordniku ametiriietuse kirjeldus ning kohtukordniku ametiriietuse kandmise kord. Käesoleva määrusega sätestatakse maa-, haldus- ja ringkonnakohtu kohtuniku ja kohtukordniku ametiriietuse kirjeldus ning kohtukordniku ametiriietuse kandmise kord.",
      "rdfs:label": {
        "@value": "Reg_337179_Par_1 (redaktsioon 337179)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337179",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337179",
