    {
      "@id": "estleg:Reg_337179_Par_16_v337179",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337179_Par_16"
