      }
    },
    {
      "@id": "estleg:Reg_337179_Par_9_v337179",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337179_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vest on tumesinisest poolvillasest kangast, lahtise nurkkaelusega, üherealine, kergelt taljesse töödeldud. Vest on voodriga ja suletav eest nelja väikese nööbiga. Esihõlmadel on kaks sissetöödeldud, liistkinnisega taskut, mis on suletavad väikese nööbiga. Vesti vasakul hõlmal rinnatasku liistu all on eraldusmärk. RT I 2020-01-22 1 122012020001 2020-02-01 Vest on tumesinisest poolvillasest kangast, lahtise nurkkaelusega, üherealine, kergelt taljesse töödeldud. Vest on voodriga ja suletav eest nelja väikese nööbiga. Esihõlmadel on kaks sissetöödeldud, liistkinnisega taskut, mis on suletavad väikese nööbiga. Vesti vasakul hõlmal rinnatasku liistu all on eraldusmärk.",
      "rdfs:label": {
        "@value": "Reg_337179_Par_9 (redaktsioon 337179)",
        "@language": "et"
      },
