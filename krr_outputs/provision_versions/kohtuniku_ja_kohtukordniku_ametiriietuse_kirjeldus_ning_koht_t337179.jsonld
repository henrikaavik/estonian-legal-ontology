      }
    },
    {
      "@id": "estleg:Reg_337179_Par_6_v337179",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337179_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtukordniku ametiriietusse kuuluvad: 1 1) pintsak; 2 2) püksid; 3 3) naiste vest; 4 4) seelik; 5 5) särk; 6 6) lips; 7 7) kingad; 8 8) vöörihm; 9 9) ametitunnused; 10 10) eraldusmärk. RT I 2020-01-22 1 122012020001 2020-02-01 Kohtukordniku ametiriietusse kuuluvad: pintsak; püksid; naiste vest; seelik; särk; lips; kingad; vöörihm; ametitunnused; eraldusmärk.",
      "rdfs:label": {
        "@value": "Reg_337179_Par_6 (redaktsioon 337179)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337179",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337179",
      "estleg:sourceAct": "Kohtuniku ja kohtukordniku ametiriietuse kirjeldus ning kohtukordniku ametiriietuse kandmise kord",
      "estleg:provisionRef": "Reg_337179 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_337179_Map"
      }
    },
    {
      "@id": "estleg:Reg_337179_Par_7_v337179",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337179_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pintsak on tumesinisest poolvillasest kangast, kergelt taljesse töödeldud, klassikalise lõikega. Pintsak on tumesinisest poolvillasest kangast, kergelt taljesse töödeldud, klassikalise lõikega. 2 (2) Pintsak on üherealine, suletav eest kahe nööbiga. Pintsak on üherealine, suletav eest kahe nööbiga. 3 (3) Pintsaku esihõlmadel on kaks horisontaalset klapiga küljetaskut ja üks kaldsuunaline liistuga rinnatasku. Pintsaku esihõlmadel on kaks horisontaalset klapiga küljetaskut ja üks kaldsuunaline liistuga rinnatasku. 4 (4) Varrukate allääres on lõhikud ja kolm nööpi. Varrukate allääres on lõhikud ja kolm nööpi. 5 (5) Pintsak on töödeldud voodrile. Pintsak on töödeldud voodrile. 6 (6) Pintsaku vasakul hõlmal rinnatasku liistu all on eraldusmärk. RT I 2020-01-22 1 122012020001 2020-02-01 Pintsaku vasakul hõlmal rinnatasku liistu all on eraldusmärk.",
      "rdfs:label": {
        "@value": "Reg_337179_Par_7 (redaktsioon 337179)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337179",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337179",
      "estleg:sourceAct": "Kohtuniku ja kohtukordniku ametiriietuse kirjeldus ning kohtukordniku ametiriietuse kandmise kord",
      "estleg:provisionRef": "Reg_337179 § 7",
