      }
    },
    {
      "@id": "estleg:Reg_337179_Par_8_v337179",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337179_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Püksid on tumesinisest poolvillasest kangast klassikalised sirgelõikelised pikad viigipüksid. Püksid on tumesinisest poolvillasest kangast klassikalised sirgelõikelised pikad viigipüksid. 2 (2) Meeste viigipükstel on kaks sissetöödeldud küljetaskut ja nööbitav tagatasku ning rihma-aasadega värvel. Meeste viigipükstel on kaks sissetöödeldud küljetaskut ja nööbitav tagatasku ning rihma-aasadega värvel. 3 (3) Naiste viigipükstel on kaks sissetöödeldud küljetaskut ja rihma-aasadega värvel. Tasku kohal on värvli vahel lahtine avarusvolt. Naiste viigipükstel on kaks sissetöödeldud küljetaskut ja rihma-aasadega värvel. Tasku kohal on värvli vahel lahtine avarusvolt.",
      "rdfs:label": {
        "@value": "Reg_337179_Par_8 (redaktsioon 337179)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337179",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337179",
      "estleg:sourceAct": "Kohtuniku ja kohtukordniku ametiriietuse kirjeldus ning kohtukordniku ametiriietuse kandmise kord",
      "estleg:provisionRef": "Reg_337179 § 8",
      "estleg:partOfAct": {
