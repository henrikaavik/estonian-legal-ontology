    },
    {
      "@id": "estleg:Reg_337179_Par_4_v337179",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337179_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Žaboo on valge plisseeritud siidrinnaesine, mis on 25 cm pikk ja 17 voldiga. Žaboo laius on üleval 6 cm ja all 20 cm. Žaboo kinnitatakse talaari krae alla kahe nööbiga. Žaboo on valge plisseeritud siidrinnaesine, mis on 25 cm pikk ja 17 voldiga. Žaboo laius on üleval 6 cm ja all 20 cm. Žaboo kinnitatakse talaari krae alla kahe nööbiga.",
      "rdfs:label": {
        "@value": "Reg_337179_Par_4 (redaktsioon 337179)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337179",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337179",
      "estleg:sourceAct": "Kohtuniku ja kohtukordniku ametiriietuse kirjeldus ning kohtukordniku ametiriietuse kandmise kord",
      "estleg:provisionRef": "Reg_337179 § 4",
