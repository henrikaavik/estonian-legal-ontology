    {
      "@id": "estleg:InfoTS_Par_15_3_v121062024004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_15_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2022/2065 artiklites 9–14, 16–18, 20–23, 25–28, 30–32 ja 34–41 sätestatud nõuete täitmata jätmise eest – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni kuus protsenti tema eelmise majandusaasta ülemaailmsest käibest.",
      "rdfs:label": {
        "@value": "InfoTS_Par_15_3 (redaktsioon 121062024004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062024004",
