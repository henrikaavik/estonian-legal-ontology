    {
      "@id": "estleg:InfoTS_Par_18_v740446",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2004. aasta 1. mail. 1 Käesolevas seaduses on arvestatud nõudeid, mis tulenevad Euroopa Parlamendi ja EL Nõukogu direktiivist 2000/31/EÜ infoühiskonna teenuste teatavate õiguslike aspektide, eriti elektroonilise kaubanduse kohta siseturul (ELT L, 178, 17.7.2000 lk 1).",
      "rdfs:label": {
        "@value": "InfoTS_Par_18 (redaktsioon 740446)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740446",
      "estleg:supersededByVersion": {
        "@id": "estleg:InfoTS_Par_18_v1047201"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-15",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/740446",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_18_v1047201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2004. aasta 1. mail.",
      "rdfs:label": {
        "@value": "InfoTS_Par_18 (redaktsioon 1047201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047201",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047201",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_2_v740446",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse mõisteid järgmises tähenduses: infoühiskonna teenus – teenus, mida osutatakse majandus- või kutsetegevuse raames teenuse kasutaja otsesel taotlusel ja mille puhul andmeid töödeldakse, säilitatakse ja edastatakse digitaalkujul andmete töötlemiseks ja säilitamiseks mõeldud elektrooniliste vahendite abil, kusjuures osapooled ei viibi üheaegselt samas kohas. Infoühiskonna teenus peab olema täielikult üle kantud, edastatud ja vastu võetud elektrooniliste sidevahendite abil. Infoühiskonna teenus ei ole faksi ja telefonikõne abil edastatud teenus ning ringhääling ringhäälinguseaduse (RT I 1994, 42, 680; 66, 1145; 1995, 83, 1437; 97, 1664; 1996, 49, 953; 1997, 29, 448; 52, 834; 93, 1564; 1998, 2, 42 ja 44; 1999, 16, 268; 25, 364; 59, 613; 2000, 25, 143; 35, 220; 102, 666; 2001, 53, 310; 2002, 3, 5; 21, 117; 53, 336; 57, 357; 61, 375; 63, 387; 2003, 4, 22; 83, 560; 88, 594) tähenduses; reguleeritud kutseala – iga kutseala, millel tegutsemiseks on seadusega sätestatud kutsekvalifikatsiooni omamise nõue.",
      "rdfs:label": {
        "@value": "InfoTS_Par_2 (redaktsioon 740446)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740446",
      "estleg:supersededByVersion": {
        "@id": "estleg:InfoTS_Par_2_v961247"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/740446",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_2_v961247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse mõisteid järgmises tähenduses: infoühiskonna teenus – teenus, mida osutatakse majandus- või kutsetegevuse raames teenuse kasutaja otsesel taotlusel ja mille puhul andmeid töödeldakse, säilitatakse ja edastatakse digitaalkujul andmete töötlemiseks ja säilitamiseks mõeldud elektrooniliste vahendite abil, kusjuures osapooled ei viibi üheaegselt samas kohas. Infoühiskonna teenus peab olema täielikult üle kantud, edastatud ja vastu võetud elektrooniliste sidevahendite abil. Infoühiskonna teenus ei ole faksi ja telefonikõne abil edastatud teenus ning ringhääling ringhäälinguseaduse tähenduses; reguleeritud kutseala – iga kutseala, millel tegutsemiseks on seadusega sätestatud kutsekvalifikatsiooni omamise nõue.",
      "rdfs:label": {
        "@value": "InfoTS_Par_2 (redaktsioon 961247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "961247",
      "estleg:supersededByVersion": {
        "@id": "estleg:InfoTS_Par_2_v106012011012"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-15",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/961247",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_2_v106012011012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses kasutatakse mõisteid järgmises tähenduses: infoühiskonna teenus – teenus, mida osutatakse majandus- või kutsetegevuse raames teenuse kasutaja otsesel taotlusel ja mille puhul andmeid töödeldakse, säilitatakse ja edastatakse digitaalkujul andmete töötlemiseks ja säilitamiseks mõeldud elektrooniliste vahendite abil, kusjuures osapooled ei viibi üheaegselt samas kohas. Infoühiskonna teenus peab olema täielikult üle kantud, edastatud ja vastu võetud elektrooniliste sidevahendite abil. Infoühiskonna teenus ei ole faksi ega telefonikõne abil edastatud teenus ega televisiooni- või raadioteenus; reguleeritud kutseala – iga kutseala, millel tegutsemiseks on seadusega sätestatud kutsekvalifikatsiooni omamise nõue.",
      "rdfs:label": {
        "@value": "InfoTS_Par_2 (redaktsioon 106012011012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106012011012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106012011012",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_3_v740446",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestis asuva tegevuskoha kaudu osutatav infoühiskonna teenus (edaspidi teenus) peab vastama Eesti õigusest tulenevatele nõuetele sellest olenemata, millises Euroopa Liidu või Euroopa Majanduspiirkonna liikmesriigis teenust osutatakse. (2) Euroopa Liidu või Euroopa Majanduspiirkonna liikmesriigis asuva tegevuskoha kaudu osutatava teenuse osutamist Eestis ei piirata kooskõlastatud valdkonna osas, välja arvatud juhul ja ulatuses, mis on õigustatud kõlbluse, avaliku korra, riigi julgeoleku, rahva tervise ja tarbija kaitseks. (3) Käesoleva paragrahvi lõikes 2 nimetatud piirang peab vastama järgmistele tingimustele: piirang kehtestatakse konkreetsele teenusele, mis takistab käesoleva paragrahvi lõikes 2 nimetatud kaitse saavutamist või kujutab endast tõsist ohtu selle saavutamisele; piirang on proportsionaalne oma eesmärgiga; enne piirangu kehtestamist on Eesti pädev asutus taotlenud, et tegevuskoha riik kehtestaks piirangu ja viimane pole seda kehtestanud või see on olnud ebapiisav; kavatsusest kehtestada piirang on Eesti pädev asutus teatanud Euroopa Komisjonile ja vastavale liikmesriigile; edasilükkamatu vajaduse korral võib käesoleva lõike punktis 4 ettenähtud tingimustest teha erandeid. Edasilükkamatu vajaduse korral tehtud piirangust peab Eesti pädev asutus võimalikult kiiresti teatama Euroopa Komisjonile ja liikmesriigile, tuues välja põhjused, miks juhtumit edasilükkamatuks loetakse; käesoleva lõike punkte 3–5 ei kohaldata kohtumenetlusele. (4) Käesoleva paragrahvi lõikes 2 sätestatut ei kohaldata: osapoolte vabadusele valida nende lepingu suhtes kohaldatav õigus; tarbijalepingutes sisalduvatele lepingulistele kohustustele; autoriõigusele ja sellega kaasnevatele õigustele; pooljuhtide kaitsele; andmebaaside kaitsele; tööstusomandi kaitsele; seadusest tulenevatele vorminõuetele, mis kehtivad kinnisasjaõigustega tehtavate tehingute suhtes; kommertsteadaande lubatavusele elektronposti teel; investeerimisfondide reklaamile; kindlustusandja kohustusele edastada kohustusliku kindlustuse üld- ja eritingimused pädevale asutusele; kindlustusandja asutamisõigusele ja teenuste osutamise vabadusele; kahju- ja elukindlustuslepingutele, mis katavad Euroopa Liidu liikmesriigis eksisteerivaid riske; notarite, kohtutäiturite ja teiste avalik-õiguslikku ametit vaba elukutsena pidavate isikute tegevusele avaliku võimu kandjana; protsessiosalise esindamisele ja tema huvide kaitsele kohtus; loteriidele ja hasartmängudele, sealhulgas rahalise panusega õnnemängudele ja kihlveotehingutele.",
      "rdfs:label": {
        "@value": "InfoTS_Par_3 (redaktsioon 740446)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740446",
      "estleg:supersededByVersion": {
        "@id": "estleg:InfoTS_Par_3_v961247"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/740446",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_3_v961247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestis asuva tegevuskoha kaudu osutatav infoühiskonna teenus (edaspidi teenus) peab vastama Eesti õigusest tulenevatele nõuetele sellest olenemata, millises Euroopa Liidu või Euroopa Majanduspiirkonna liikmesriigis teenust osutatakse. (2) Euroopa Liidu või Euroopa Majanduspiirkonna liikmesriigis asuva tegevuskoha kaudu osutatava teenuse osutamist Eestis ei piirata kooskõlastatud valdkonna osas, välja arvatud juhul ja ulatuses, mis on õigustatud kõlbluse, avaliku korra, riigi julgeoleku, rahva tervise ja tarbija kaitseks. (3) Käesoleva paragrahvi lõikes 2 nimetatud piirang peab vastama järgmistele tingimustele: piirang kehtestatakse konkreetsele teenusele, mis takistab käesoleva paragrahvi lõikes 2 nimetatud kaitse saavutamist või kujutab endast tõsist ohtu selle saavutamisele; piirang on proportsionaalne oma eesmärgiga; enne piirangu kehtestamist on Eesti pädev asutus taotlenud, et tegevuskoha riik kehtestaks piirangu ja viimane pole seda kehtestanud või see on olnud ebapiisav; kavatsusest kehtestada piirang on Eesti pädev asutus teatanud Euroopa Komisjonile ja vastavale liikmesriigile; edasilükkamatu vajaduse korral võib käesoleva lõike punktis 4 ettenähtud tingimustest teha erandeid. Edasilükkamatu vajaduse korral tehtud piirangust peab Eesti pädev asutus võimalikult kiiresti teatama Euroopa Komisjonile ja liikmesriigile, tuues välja põhjused, miks juhtumit edasilükkamatuks loetakse; käesoleva lõike punkte 3–5 ei kohaldata kohtumenetlusele. (4) Käesoleva paragrahvi lõikes 2 sätestatut ei kohaldata: osapoolte vabadusele valida nende lepingu suhtes kohaldatav õigus; tarbijalepingutes sisalduvatele lepingulistele kohustustele; autoriõigusele ja sellega kaasnevatele õigustele; pooljuhtide kaitsele; andmebaaside kaitsele; tööstusomandi kaitsele; seadusest tulenevatele vorminõuetele, mis kehtivad kinnisasjaõigustega tehtavate tehingute suhtes; kommertsteadaande lubatavusele elektronposti teel; investeerimisfondide reklaamile; kindlustusandja kohustusele edastada kohustusliku kindlustuse üld- ja eritingimused pädevale asutusele; kindlustusandja asutamisõigusele ja teenuste osutamise vabadusele; kahju- ja elukindlustuslepingutele, mis katavad Euroopa Liidu liikmesriigis eksisteerivaid riske; notarite, kohtutäiturite ja teiste avalik-õiguslikku ametit vaba elukutsena pidavate isikute tegevusele avaliku võimu kandjana; protsessiosalise esindamisele ja tema huvide kaitsele kohtus; loteriidele ja hasartmängudele, sealhulgas rahalise panusega õnnemängudele ja kihlveotehingutele; [Punkt 16 jõustub 1. 01. 2006] e-raha väljastamisele e-raha asutuse poolt, kes kasutab e-raha asutuste seaduse §-s 11 sätestatud õigust.",
      "rdfs:label": {
        "@value": "InfoTS_Par_3 (redaktsioon 961247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "961247",
      "estleg:supersededByVersion": {
        "@id": "estleg:InfoTS_Par_3_v1028014"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/961247",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
