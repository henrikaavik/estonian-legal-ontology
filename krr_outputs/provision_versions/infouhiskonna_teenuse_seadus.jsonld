      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tehnilise normi ja standardi seaduses (RT I 1999, 29, 398; 2000, 29, 169; 78, 495; 2002, 32, 186; 99, 580; 2003, 88, 594; 2004, 2, 8) tehakse järgmised muudatused: paragrahvi 2 lõige 6 muudetakse ja sõnastatakse järgmiselt: « (6) Infoühiskonna teenus on infoühiskonna teenuse seaduse § 2 punktis 1 sätestatud teenus.»; paragrahvi 2 lõige 7 tunnistatakse kehtetuks.",
      "rdfs:label": {
