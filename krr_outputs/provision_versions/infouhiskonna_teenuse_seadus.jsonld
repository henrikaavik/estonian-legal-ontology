    },
    {
      "@id": "estleg:InfoTS_Par_14_v122062021014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär füüsilisele isikule 640 eurot ja juriidilisele isikule 100 000 eurot.",
      "rdfs:label": {
        "@value": "InfoTS_Par_14 (redaktsioon 122062021014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122062021014",
