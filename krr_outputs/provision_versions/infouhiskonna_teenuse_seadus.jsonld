      "estleg:provisionRef": "InfoTS § 15_3",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_15_4_v121062024004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_15_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2022/2065 artiklites 15, 24 ja 42 sätestatud aruandluskohustuse täitmata jätmise või aruandes ebaõige, mittetäieliku või eksitava teabe esitamise eest –karistatakse rahatrahviga kuni üks protsent selle füüsilise isiku eelmise kalendriaasta sissetulekust. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni üks protsent tema eelmise majandusaasta ülemaailmsest käibest.",
      "rdfs:label": {
        "@value": "InfoTS_Par_15_4 (redaktsioon 121062024004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062024004",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 15_4",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_15_5_v121062024004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_15_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruses (EL) 2022/2065 sätestatud nõuete täitmise üle riikliku järelevalve teostamise takistamise eest, kui sellega ei võimaldata Tarbijakaitse ja Tehnilise Järelevalve Ametile juurdepääsu ruumidele või teabele, või ebaõige, mittetäieliku või eksitava teabe esitamise eest või ebaõigele, mittetäielikule või eksitavale teabele reageerimata jätmise või selle parandamata jätmise eest –karistatakse rahatrahviga kuni üks protsent selle füüsilise isiku eelmise kalendriaasta sissetulekust. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni üks protsent tema eelmise majandusaasta ülemaailmsest käibest.",
      "rdfs:label": {
        "@value": "InfoTS_Par_15_5 (redaktsioon 121062024004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062024004",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 15_5",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_15_6_v104072024024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_15_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2021/784 artikli 3 lõigetes 3 ja 6 ning artikli 4 lõigetes 2 ja 7 sätestatud nõuete täitmata jätmise eest – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 400 000 eurot. (3) Käesoleva paragrahvi lõikes 2 sätestatud teo eest, kui see on pandud toime korduvalt või süstemaatiliselt, –karistatakse rahatrahviga kuni neli protsenti veebimajutusteenuse pakkuja eelmise majandusaasta kogukäibest.",
      "rdfs:label": {
        "@value": "InfoTS_Par_15_6 (redaktsioon 104072024024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072024024",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104072024024",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 15_6",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
