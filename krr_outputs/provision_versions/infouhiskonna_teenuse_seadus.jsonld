    {
      "@id": "estleg:InfoTS_Par_12_v121062024004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses teenuse osutaja kohta antavale teabele sätestatud nõuete järgimise üle teostab riiklikku järelevalvet Tarbijakaitse ja Tehnilise Järelevalve Amet. (2) Euroopa Parlamendi ja nõukogu määruses (EL) nr 2019/1150, mis käsitleb õigluse ja läbipaistvuse edendamist veebipõhiste vahendusteenuste ärikasutajate jaoks (ELT L 186, 11.07.2019, lk 57–79), sätestatud nõuete täitmise üle teostab riiklikku järelevalvet Tarbijakaitse ja Tehnilise Järelevalve Amet. (3) Tarbijakaitse ja Tehnilise Järelevalve Amet on sõltumatu digiteenuste koordinaator Euroopa Parlamendi ja nõukogu määruse (EL) 2022/2065, mis käsitleb digiteenuste ühtset turgu ja millega muudetakse direktiivi 2000/31/EÜ (digiteenuste määrus) (ELT L 277, 27.10.2022, lk 1–102), artikli 49 lõike 2 tähenduses. (4) Tarbijakaitse ja Tehnilise Järelevalve Amet teostab riiklikku järelevalvet Euroopa Parlamendi ja nõukogu määruses (EL) 2022/2065 sätestatud nõuete täitmise üle.",
      "rdfs:label": {
        "@value": "InfoTS_Par_12 (redaktsioon 121062024004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024004",
      "estleg:supersededByVersion": {
        "@id": "estleg:InfoTS_Par_12_v104072024024"
      },
      "estleg:versionValidTo": {
        "@value": "2024-07-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062024004",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_12_v104072024024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses teenuse osutaja kohta antavale teabele sätestatud nõuete järgimise üle teostab riiklikku järelevalvet Tarbijakaitse ja Tehnilise Järelevalve Amet. (2) Euroopa Parlamendi ja nõukogu määruses (EL) nr 2019/1150, mis käsitleb õigluse ja läbipaistvuse edendamist veebipõhiste vahendusteenuste ärikasutajate jaoks (ELT L 186, 11.07.2019, lk 57–79), sätestatud nõuete täitmise üle teostab riiklikku järelevalvet Tarbijakaitse ja Tehnilise Järelevalve Amet. (3) Tarbijakaitse ja Tehnilise Järelevalve Amet on sõltumatu digiteenuste koordinaator Euroopa Parlamendi ja nõukogu määruse (EL) 2022/2065, mis käsitleb digiteenuste ühtset turgu ja millega muudetakse direktiivi 2000/31/EÜ (digiteenuste määrus) (ELT L 277, 27.10.2022, lk 1–102), artikli 49 lõike 2 tähenduses. (4) Tarbijakaitse ja Tehnilise Järelevalve Amet teostab riiklikku järelevalvet Euroopa Parlamendi ja nõukogu määruses (EL) 2022/2065 sätestatud nõuete täitmise üle. (5) Euroopa Parlamendi ja nõukogu määruse (EL) 2021/784, mis käsitleb võitlemist terroristliku veebisisu levitamise vastu (ELT L 172, 17.05.2021, lk 79–109), artikli 3 lõigetes 3 ja 6, artikli 4 lõigetes 2 ja 7, artikli 6 lõigetes 1 ja 2 ning artikli 14 lõikes 5 sätestatud terroristliku veebisisu eemaldamise ja eemaldamiskorralduse täitmisega seotud meetmete rakendamise üle teostab riiklikku järelevalvet Kaitsepolitseiamet. (6) Euroopa Parlamendi ja nõukogu määruse (EL) 2021/784 artiklis 5, artikli 6 lõikes 3, artiklites 7, 10 ja 11, artikli 15 lõikes 1 ning artiklis 17 sätestatud terroristliku veebisisu levitamist tõkestavate tehniliste nõuete, sisu säilitamise ja aruandlusega seotud meetmete rakendamise üle teostab riiklikku järelevalvet Tarbijakaitse ja Tehnilise Järelevalve Amet.",
      "rdfs:label": {
        "@value": "InfoTS_Par_12 (redaktsioon 104072024024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072024024",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104072024024",
      "estleg:sourceAct": "Infoühiskonna teenuse seadus",
      "estleg:provisionRef": "InfoTS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:InfoTS_Map"
      }
    },
    {
      "@id": "estleg:InfoTS_Par_12_1_v121062024004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:InfoTS_Par_12_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tarbijakaitse ja Tehnilise Järelevalve Amet osaleb Euroopa Liidu liikmesriikide digiteenuste koordinaatorite ja Euroopa Komisjoni piiriüleses koostöös Euroopa Parlamendi ja nõukogu määruse (EL) 2022/2065 IV peatükis sätestatu kohaselt.",
      "rdfs:label": {
        "@value": "InfoTS_Par_12_1 (redaktsioon 121062024004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062024004",
