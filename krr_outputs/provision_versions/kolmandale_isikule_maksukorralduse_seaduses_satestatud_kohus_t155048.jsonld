    {
      "@id": "estleg:Reg_155048_Par_2_v155048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155048_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuhaldur hüvitab eksperdi taotlusel väljaspool taotleja elukohta kohustuste täitmisega kaasnenud dokumentaalselt tõendatud sõidu- ja majutuskulud ning tasu tehtud ekspertiisi eest 30 päeva jooksul vastava taotluse saamise päevast arvates. Maksuhaldur hüvitab eksperdi taotlusel väljaspool taotleja elukohta kohustuste täitmisega kaasnenud dokumentaalselt tõendatud sõidu- ja majutuskulud ning tasu tehtud ekspertiisi eest 30 päeva jooksul vastava taotluse saamise päevast arvates.",
      "rdfs:label": {
        "@value": "Reg_155048_Par_2 (redaktsioon 155048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155048",
      "estleg:sourceAct": "Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord",
      "estleg:provisionRef": "Reg_155048 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155048_Par_2_2_v155048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155048_Par_2_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliamet hüvitab sõltumatu tunnustatud isiku taotlusel kohustuste täitmisega kaasnenud põhjendatud ja dokumentaalselt tõendatud sõidu- ja majutuskulud 30 päeva jooksul vastava taotluse saamise päevast arvates. RT I 2019-12-20 11 120122019011 2019-12-23 Maksu- ja Tolliamet hüvitab sõltumatu tunnustatud isiku taotlusel kohustuste täitmisega kaasnenud põhjendatud ja dokumentaalselt tõendatud sõidu- ja majutuskulud 30 päeva jooksul vastava taotluse saamise päevast arvates.",
      "rdfs:label": {
        "@value": "Reg_155048_Par_2_2 (redaktsioon 155048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155048",
      "estleg:sourceAct": "Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord",
      "estleg:provisionRef": "Reg_155048 § 2_2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155048_Par_3_v155048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155048_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kolmanda isiku taotluses peavad olema märgitud: 1 1) ees- ja perekonnanimi; 2 2) isikukood; 3 3) elukoht; 4 4) pangakonto rekvisiidid; 5 5) hüvitamisele kuuluva summa suurus. Kolmanda isiku taotluses peavad olema märgitud: ees- ja perekonnanimi; isikukood; elukoht; pangakonto rekvisiidid; hüvitamisele kuuluva summa suurus. 2 (2) Taotlus tuleb esitada Maksu- ja Tolliametile 30 päeva jooksul pärast „Maksukorralduse seaduse” § 66 lõikes 1 nimetatud kohustuste täitmist. RT I 2012-11-13 13 113112012013 2012-12-01 Taotlus tuleb esitada Maksu- ja Tolliametile 30 päeva jooksul pärast „Maksukorralduse seaduse” § 66 lõikes 1 nimetatud kohustuste täitmist. 3 (3) Taotlusele tuleb lisada kulu tõendavad dokumendid. Taotlusele tuleb lisada kulu tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_155048_Par_3 (redaktsioon 155048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155048",
      "estleg:sourceAct": "Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord",
      "estleg:provisionRef": "Reg_155048 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155048_Par_4_v155048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155048_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eksperdi taotluses peavad olema märgitud: 1 1) ees- ja perekonnanimi; 2 2) isikukood; 3 3) kontaktaadress ja sidevahendite numbrid; 4 4) pangakonto rekvisiidid; 5 5) hüvitamisele kuuluva summa suurus. Eksperdi taotluses peavad olema märgitud: ees- ja perekonnanimi; isikukood; kontaktaadress ja sidevahendite numbrid; pangakonto rekvisiidid; hüvitamisele kuuluva summa suurus. 2 (2) Taotlus tuleb esitada Maksu- ja Tolliametile 30 päeva jooksul pärast „Maksukorralduse seaduse” § 69 lõikes 1 nimetatud kohustuste täitmist. RT I 2012-11-13 13 113112012013 2012-12-01 Taotlus tuleb esitada Maksu- ja Tolliametile 30 päeva jooksul pärast „Maksukorralduse seaduse” § 69 lõikes 1 nimetatud kohustuste täitmist. 3 (3) Taotlusele tuleb lisada kulu tõendavad dokumendid. Taotlusele tuleb lisada kulu tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_155048_Par_4 (redaktsioon 155048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155048",
      "estleg:sourceAct": "Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord",
      "estleg:provisionRef": "Reg_155048 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155048_Par_4_5_v155048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155048_Par_4_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sõltumatu tunnustatud isiku taotluses peavad olema märgitud: 1 1) ees- ja perekonnanimi; 2 2) isikukood või sünniaeg; 3 3) kontaktaadress ja sidevahendite numbrid; 4 4) pangakonto rekvisiidid; 5 5) hüvitamisele kuuluva summa suurus. Sõltumatu tunnustatud isiku taotluses peavad olema märgitud: ees- ja perekonnanimi; isikukood või sünniaeg; kontaktaadress ja sidevahendite numbrid; pangakonto rekvisiidid; hüvitamisele kuuluva summa suurus. 2 (2) Taotluse võib esitada ajavahemikul kulu tekkimisest kuni 30 päeva möödumiseni nõuandekomisjoni või alternatiivse vaidluste lahendamise komisjoni otsuse tegemisest või arvamuse andmisest. Taotluse võib esitada ajavahemikul kulu tekkimisest kuni 30 päeva möödumiseni nõuandekomisjoni või alternatiivse vaidluste lahendamise komisjoni otsuse tegemisest või arvamuse andmisest. 3 (3) Taotlusele tuleb lisada kulu tõendavad dokumendid. RT I 2019-12-20 11 120122019011 2019-12-23 Taotlusele tuleb lisada kulu tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_155048_Par_4_5 (redaktsioon 155048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155048",
      "estleg:sourceAct": "Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord",
      "estleg:provisionRef": "Reg_155048 § 4_5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155048_Par_5_v155048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155048_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maksuhalduri juurde sõidu ja tagasisõidu kulud hüvitatakse sõidupileti või muu sõidukulu tõendava dokumendi alusel. Maksuhalduri juurde sõidu ja tagasisõidu kulud hüvitatakse sõidupileti või muu sõidukulu tõendava dokumendi alusel. 2 (2) Mootorsõidukiga maksuhalduri juurde ja sealt tagasi sõidu kulud hüvitatakse Vabariigi Valitsuse 14. juuli 2006. a määruse nr 164 „Teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja hüvitise maksmise kord” §-s 5 sätestatud maksimaalses määras ühe kilomeetri kohta, mis korrutatakse asustusüksuste vahelise kaugusega kilomeetrites. RT I 2013-08-13 6 113082013006 2013-08-16 Mootorsõidukiga maksuhalduri juurde ja sealt tagasi sõidu kulud hüvitatakse Vabariigi Valitsuse 14. juuli 2006. a määruse nr 164 „Teenistus-, töö- või ametiülesannete täitmisel isikliku sõiduauto kasutamise kohta arvestuse pidamise ja hüvitise maksmise kord” §-s 5 sätestatud maksimaalses määras ühe kilomeetri kohta, mis korrutatakse asustusüksuste vahelise kaugusega kilomeetrites.",
      "rdfs:label": {
        "@value": "Reg_155048_Par_5 (redaktsioon 155048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155048",
      "estleg:sourceAct": "Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord",
      "estleg:provisionRef": "Reg_155048 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155048_Par_6_v155048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155048_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kolmandale isikule, eksperdile ja sõltumatule tunnustatud isikule hüvitab majutuskulud kulu tõendava dokumendi alusel Maksu- ja Tolliamet valdkonna eest vastutava juhi või tema volitatud isiku otsuse alusel. RT I 2019-12-20 11 120122019011 2019-12-23 Kolmandale isikule, eksperdile ja sõltumatule tunnustatud isikule hüvitab majutuskulud kulu tõendava dokumendi alusel Maksu- ja Tolliamet valdkonna eest vastutava juhi või tema volitatud isiku otsuse alusel.",
      "rdfs:label": {
        "@value": "Reg_155048_Par_6 (redaktsioon 155048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155048",
      "estleg:sourceAct": "Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord",
      "estleg:provisionRef": "Reg_155048 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155048_Map_2026"
      }
    },
    {
