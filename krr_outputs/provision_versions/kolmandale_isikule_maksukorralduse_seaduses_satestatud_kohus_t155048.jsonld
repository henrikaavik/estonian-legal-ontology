      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord (12 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord"
    },
    {
      "@id": "estleg:Reg_155048_Par_1_v155048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155048_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuhaldur hüvitab kolmanda isiku taotlusel väljaspool taotleja elukohta kohustuste täitmisega kaasnenud dokumentaalselt tõendatud sõidu- ja majutuskulud ning saamata jäänud keskmise töötasu 30 päeva jooksul vastava taotluse saamise päevast arvates. RT I 2013-08-13 6 113082013006 2013-08-16 Maksuhaldur hüvitab kolmanda isiku taotlusel väljaspool taotleja elukohta kohustuste täitmisega kaasnenud dokumentaalselt tõendatud sõidu- ja majutuskulud ning saamata jäänud keskmise töötasu 30 päeva jooksul vastava taotluse saamise päevast arvates.",
      "rdfs:label": {
        "@value": "Reg_155048_Par_1 (redaktsioon 155048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155048",
      "estleg:sourceAct": "Kolmandale isikule „Maksukorralduse seaduses” sätestatud kohustuste täitmisega kaasnenud kulude, eksperdile ekspertiisiga seotud kulude ja sõltumatule tunnustatud isikule hüvitatavate kulude suurus ja kord",
      "estleg:provisionRef": "Reg_155048 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155048_Map_2026"
      }
    },
