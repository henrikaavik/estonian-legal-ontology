    {
      "@id": "estleg:Reg_1056385_Par_17_v1056385",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056385_Par_17"
