    },
    {
      "@id": "estleg:Reg_1008645_Par_1_v1008645",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008645_Par_1"
