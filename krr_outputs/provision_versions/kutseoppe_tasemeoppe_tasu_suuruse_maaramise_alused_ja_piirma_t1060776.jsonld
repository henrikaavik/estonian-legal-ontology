      "estleg:provisionRef": "Reg_1060776 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060776_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1060776_Par_3_v1060776",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060776_Par_3"
