      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Toidupartii tähistamise nõuded (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Toidupartii tähistamise nõuded"
    },
    {
      "@id": "estleg:Reg_1026932_Par_1_v1026932",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026932_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toidupartii tähistus võimaldab määrata, millisest partiist toit pärineb. Toidupartii tähistus võimaldab määrata, millisest partiist toit pärineb. 2 (2) Toidupartii määrab ja tähistab pakendil tootja, töötleja, valmistaja, pakendaja või Euroopa Liidu liikmesriigis asutatud müüja, kes seda toitu esimesena müüb. Toidupartii määrab ja tähistab pakendil tootja, töötleja, valmistaja, pakendaja või Euroopa Liidu liikmesriigis asutatud müüja, kes seda toitu esimesena müüb. 3 (3) Toidupartii tähistus esitatakse selgesti loetavalt, hästi nähtavalt ja kulumiskindlalt toidu müügipakendil. Toidupartii tähistus esitatakse selgesti loetavalt, hästi nähtavalt ja kulumiskindlalt toidu müügipakendil. 4 (4) Toidupartii tähistusele eelneb täht „L”, välja arvatud muust teabest selgelt eristatava tähistuse puhul. Toidupartii tähistusele eelneb täht „L”, välja arvatud muust teabest selgelt eristatava tähistuse puhul.",
      "rdfs:label": {
        "@value": "Reg_1026932_Par_1 (redaktsioon 1026932)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026932",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026932",
      "estleg:sourceAct": "Toidupartii tähistamise nõuded",
      "estleg:provisionRef": "Reg_1026932 § 1",
