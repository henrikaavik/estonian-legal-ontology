      }
    },
    {
      "@id": "estleg:Reg_158654_Par_10_v158654",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158654_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevöönd on rahvuspargi maa- või veeala seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. Sihtkaitsevöönd on rahvuspargi maa- või veeala seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. 2 (2) Rahvuspargis on 29 sihtkaitsevööndit: 1 1) Paelamaa sihtkaitsevöönd; 2 2) Miiliaugu sihtkaitsevöönd; 3 3) Ruunaraipe-Sauga sihtkaitsevöönd; 4 4) Valgeraba sihtkaitsevöönd; 5 5) Kuresoo sihtkaitsevöönd; 6 6) Sandra sihtkaitsevöönd; 7 7) Mulgi sihtkaitsevöönd; 8 8) Lemmjõe keele sihtkaitsevöönd; 9 9) Karuskose sihtkaitsevöönd; 10 10) Tõramaa sihtkaitsevöönd; 11 11) Öördi sihtkaitsevöönd; 12 12) Mardu sihtkaitsevöönd; 13 13) Halliselja sihtkaitsevöönd; 14 14) Venesauna sihtkaitsevöönd; 15 15) Möldri sihtkaitsevöönd; 16 16) Tipu sihtkaitsevöönd; 17 17) Räksi sihtkaitsevöönd; 18 18) Pääsma laane sihtkaitsevöönd; 19 19) Halliste luha sihtkaitsevöönd; 20 20) Raudna sihtkaitsevöönd; 21 21) Vireksaare sihtkaitsevöönd; 22 22) Kikepera sihtkaitsevöönd; 23 23) Pöörikaasiku sihtkaitsevöönd; 24 24) Tõrvaaugu sihtkaitsevöönd; 25 25) Piilu sihtkaitsevöönd; 26 26) Tuhkja sihtkaitsevöönd; 27 27) Osju sihtkaitsevöönd; 28 28) Härma sihtkaitsevöönd; 29 29) Riisa sihtkaitsevöönd. Rahvuspargis on 29 sihtkaitsevööndit: Paelamaa sihtkaitsevöönd; Miiliaugu sihtkaitsevöönd; Ruunaraipe-Sauga sihtkaitsevöönd; Valgeraba sihtkaitsevöönd; Kuresoo sihtkaitsevöönd; Sandra sihtkaitsevöönd; Mulgi sihtkaitsevöönd; Lemmjõe keele sihtkaitsevöönd; Karuskose sihtkaitsevöönd; Tõramaa sihtkaitsevöönd; Öördi sihtkaitsevöönd; Mardu sihtkaitsevöönd; Halliselja sihtkaitsevöönd; Venesauna sihtkaitsevöönd; Möldri sihtkaitsevöönd; Tipu sihtkaitsevöönd; Räksi sihtkaitsevöönd; Pääsma laane sihtkaitsevöönd; Halliste luha sihtkaitsevöönd; Raudna sihtkaitsevöönd; Vireksaare sihtkaitsevöönd; Kikepera sihtkaitsevöönd; Pöörikaasiku sihtkaitsevöönd; Tõrvaaugu sihtkaitsevöönd; Piilu sihtkaitsevöönd; Tuhkja sihtkaitsevöönd; Osju sihtkaitsevöönd; Härma sihtkaitsevöönd; Riisa sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_158654_Par_10 (redaktsioon 158654)",
        "@language": "et"
      },
