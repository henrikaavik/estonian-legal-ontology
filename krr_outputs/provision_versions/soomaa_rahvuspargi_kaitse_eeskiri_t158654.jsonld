    {
      "@id": "estleg:Reg_158654_Par_1_v158654",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158654_Par_1"
