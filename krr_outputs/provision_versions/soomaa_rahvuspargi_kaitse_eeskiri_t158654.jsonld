      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158654_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Loodusreservaat on rahvuspargi otsesest inimtegevusest puutumata loodusega maa- või veeala, kus tagatakse looduslike koosluste säilimine ja kujunemine üksnes looduslike protsesside tulemusena. Loodusreservaat on rahvuspargi otsesest inimtegevusest puutumata loodusega maa- või veeala, kus tagatakse looduslike koosluste säilimine ja kujunemine üksnes looduslike protsesside tulemusena. 2 (2) Rahvuspargis on Tuhametsa reservaat. Rahvuspargis on Tuhametsa reservaat.",
      "rdfs:label": {
        "@value": "Reg_158654_Par_7 (redaktsioon 158654)",
        "@language": "et"
      },
