      ],
      "estleg:versionOf": {
        "@id": "estleg:SES_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusvahelises pimedate kirjas trükiste (paragrahv 6 lõike 1 punkt 3) sundeksemplarid saadetakse: Eesti Rahvusraamatukogule; Tartu Ülikooli Raamatukogule.",
      "rdfs:label": {
        "@value": "SES_Par_11 (redaktsioon 22370)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22370",
