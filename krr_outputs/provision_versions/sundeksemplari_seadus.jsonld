    },
    {
      "@id": "estleg:SES_Par_18_v22370",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SES_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub elektrooniliste teavikute sundeksemplaride loovutamise osas 1998. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "SES_Par_18 (redaktsioon 22370)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22370"
    },
    {
      "@id": "estleg:SES_Par_19_v22370",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
