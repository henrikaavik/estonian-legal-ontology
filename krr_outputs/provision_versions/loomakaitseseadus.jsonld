    {
      "@id": "estleg:LoKS_Par_17_v22473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Looma võib religioossel eesmärgil tappa väljaspool tapamaja. Looma religioossel eesmärgil tapmise juures peab viibima järelevalveametnik. (2) Looma religioossel eesmärgil tapmise korraldamise ja läbiviimise korra kehtestab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "LoKS_Par_17 (redaktsioon 22473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22473",
      "estleg:supersededByVersion": {
        "@id": "estleg:LoKS_Par_17_v961640"
      },
