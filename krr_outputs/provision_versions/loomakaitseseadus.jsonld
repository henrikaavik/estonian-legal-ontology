    {
      "@id": "estleg:LoKS_Par_53_v129062014033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_53"
      },
      "estleg:versionValidFrom": {
