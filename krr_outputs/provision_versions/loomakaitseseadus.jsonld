    },
    {
      "@id": "estleg:LoKS_Par_20_4_v116062016013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_20_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtjale antakse pikki vedusid teostava loomade vedaja tegevusluba, kui ta vastab nõukogu määruse (EÜ) nr 1/2005 artiklis 11 sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "LoKS_Par_20_4 (redaktsioon 116062016013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062016013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116062016013",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:provisionRef": "LoKS § 20_4",
      "estleg:partOfAct": {
        "@id": "estleg:LoKS_Map"
      }
    },
    {
      "@id": "estleg:LoKS_Par_20_5_v116062016013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_20_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloale lisatakse järgmised kõrvaltingimused: loomade vedamise viis; vedada kavatsetavate loomade liik; tegevusloa tähtaeg.",
