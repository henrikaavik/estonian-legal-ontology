      }
    },
    {
      "@id": "estleg:LoKS_Par_65_v12813187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loomapidamise õiguse äravõtmine on kohtu mõistetud lisakaristus looma suhtes lubamatu teo toimepanemise eest, mille sisuks on keeld pidada kindlaksmääratud aja jooksul mis tahes looma või teatud loomaliiki kuuluvat looma. (2) –(3) Kehtetud – (4) Registreerimisele kuuluva põllumajanduslooma pidamise õiguse äravõtmise kohtuotsuse ärakirja saadab kohus põllumajandusloomade registrisse kohtuotsuse jõustumisest arvates viie tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "LoKS_Par_65 (redaktsioon 12813187)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12813187",
