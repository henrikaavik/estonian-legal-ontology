      },
      "estleg:versionText": "(1) Loomaaia pidamiseks peab olema tegevusluba.",
      "rdfs:label": {
        "@value": "LoKS_Par_29 (redaktsioon 129062014033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014033",
