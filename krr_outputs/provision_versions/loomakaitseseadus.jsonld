        "@type": "xsd:date"
      },
      "estleg:versionText": "Õnnetusjuhtumi või hädaolukorra tõttu abitusse seisukorda sattunud looma võib hukata, kui ellujäämine tekitaks talle kestvaid kannatusi või kui tema liigiomane eluviis või loodusesse tagasiviimine osutub võimatuks.",
      "rdfs:label": {
        "@value": "LoKS_Par_16 (redaktsioon 961640)",
        "@language": "et"
