      }
    },
    {
      "@id": "estleg:LoKS_Par_30_v22473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loomaaia tegevusloa väljastaja võib keelduda tegevusloa väljastamisest, kui: ei ole täidetud käesoleva seaduse § 29 lõikes 4 sätestatud nõuded; taotleja on tegevusloa taotlemisel esitanud tegelikkusele mittevastavaid andmeid.",
      "rdfs:label": {
        "@value": "LoKS_Par_30 (redaktsioon 22473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22473",
      "estleg:supersededByVersion": {
        "@id": "estleg:LoKS_Par_30_v129062014033"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22473",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:provisionRef": "LoKS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:LoKS_Map"
      }
    },
    {
      "@id": "estleg:LoKS_Par_30_v129062014033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "LoKS_Par_30 (redaktsioon 129062014033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014033",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014033",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:provisionRef": "LoKS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:LoKS_Map"
      }
    },
    {
      "@id": "estleg:LoKS_Par_31_v22473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loomaaia tegevusloa väljastaja võib väljastatud tegevusloa peatada, kui loomaaia pidaja ei ole teinud talle järelevalve käigus tehtud ettekirjutuses nimetatud vajalikke toiminguid õiguserikkumise lõpetamiseks ja edasiste õiguserikkumiste ärahoidmiseks täitmiseks määratud tähtaja jooksul. Tegevusluba on õigus peatada kuni tegevusloa peatamise tinginud puuduste kõrvaldamiseni. (2) Ajal, mil tegevusluba on peatatud, on loomade avalik näitamine keelatud.",
      "rdfs:label": {
        "@value": "LoKS_Par_31 (redaktsioon 22473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22473",
      "estleg:supersededByVersion": {
        "@id": "estleg:LoKS_Par_31_v129062014033"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22473",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:provisionRef": "LoKS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:LoKS_Map"
      }
    },
    {
      "@id": "estleg:LoKS_Par_31_v129062014033",
      "@type": [
        "owl:NamedIndividual",
