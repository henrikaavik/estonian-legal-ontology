      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik võib vaidlustada järelevalveametniku ettekirjutuse kohtus seadusega ettenähtud alustel ja korras. (2) Ettekirjutuse vaidlustamine ei vabasta isikut selle täitmisest.",
      "rdfs:label": {
