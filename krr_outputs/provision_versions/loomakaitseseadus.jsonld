        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22473",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:provisionRef": "LoKS § 17",
      "estleg:partOfAct": {
        "@id": "estleg:LoKS_Map"
      }
    },
    {
      "@id": "estleg:LoKS_Par_17_v961640",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Looma võib religioossel eesmärgil tappa väljaspool tapamaja. Looma religioossel eesmärgil tapmise juures peab viibima järelevalveametnik.",
      "rdfs:label": {
        "@value": "LoKS_Par_17 (redaktsioon 961640)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "961640",
      "estleg:supersededByVersion": {
        "@id": "estleg:LoKS_Par_17_v13331263"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/961640",
      "estleg:sourceAct": "Loomakaitseseadus",
