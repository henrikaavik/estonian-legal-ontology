      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Looduses vabalt elavate loomade kaitset ja kasutamist reguleerivad lisaks käesolevale seadusele ka looduskaitseseadus, jahiseadus ja kalapüügiseadus.",
      "rdfs:label": {
        "@value": "LoKS_Par_6 (redaktsioon 961640)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "961640",
