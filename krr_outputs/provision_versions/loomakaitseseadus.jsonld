    },
    {
      "@id": "estleg:LoKS_Par_21_v22473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loomade veoks peab kasutama selleks ettenähtud, veterinaarnõuetele vastavaid veovahendeid. Riigisisesel loomade veol võib kasutada selleks kohandatud, veterinaarnõuetele vastavaid veovahendeid, välja arvatud kallurid. (2) Loomade veoruumis peab olema sobiv mikrokliima ja piisavalt ruumi, mis võimaldab loomal olla puhkeasendis vastavalt tema liigi eripärale. (3) Enne loomade pealelaadimist peab järelevalveametnik kontrollima veoki nõuetekohasust ja tegema sellekohase märke käesoleva seaduse § 20 lõikes 2 sätestatud dokumendile. (4) Loomade laadimisel tuleb kasutada selleks sobivaid vahendeid. Loomade laadimis- ja veovahend peab vajaduse korral olema varustatud külgkaitsetega ja olema sellise ehitusega, mis väldib loomade vigastumist, ning laadimis- ja veovahendi põrandapind peab olema kaetud libisemist takistava materjaliga.",
      "rdfs:label": {
        "@value": "LoKS_Par_21 (redaktsioon 22473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22473",
      "estleg:supersededByVersion": {
        "@id": "estleg:LoKS_Par_21_v752070"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22473",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:provisionRef": "LoKS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:LoKS_Map"
      }
    },
    {
      "@id": "estleg:LoKS_Par_21_v752070",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
