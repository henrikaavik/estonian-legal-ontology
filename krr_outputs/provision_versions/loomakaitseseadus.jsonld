      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paragrahvis 60 sätestatud järelevalveasutuste järelevalveametnikud teostavad oma pädevuse piires riiklikku järelevalvet isikute tegevuse üle, kes on kohustatud täitma loomakaitsenõudeid. (2) Oma ülesandeid täites teevad järelevalveametnikud koostööd teiste täidesaatva riigivõimu asutustega.",
      "rdfs:label": {
        "@value": "LoKS_Par_61 (redaktsioon 22473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22473",
