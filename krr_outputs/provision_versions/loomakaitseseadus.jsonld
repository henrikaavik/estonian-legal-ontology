      }
    },
    {
      "@id": "estleg:LoKS_Par_51_1_v118122012018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_51_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loaandja teeb loomkatseprojekti järelhindamise raske ja mõõduka loomkatse puhul ja juhul kui loomkatseprojekti raames tehtud loomkatses on kasutatud ahvilisi. (2) Loomkatseprojekti järelhindamisel hinnatakse loomkatse protokolli alusel loomkatseprojekti eesmärgi saavutamist ja loomadele põhjustatud kahju, võttes arvesse kasutatud katseloomade arvu ja loomkatse raskusastmeid ning muid asjaolusid, mis aitavad kaasa loomkatse asendamise, vähendamise ja täiustamise nõude kohaldamisele.",
      "rdfs:label": {
        "@value": "LoKS_Par_51_1 (redaktsioon 118122012018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012018",
      "estleg:supersededByVersion": {
        "@id": "estleg:LoKS_Par_51_1_v104012019019"
      },
      "estleg:versionValidTo": {
        "@value": "2019-01-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118122012018",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:provisionRef": "LoKS § 51_1",
      "estleg:partOfAct": {
        "@id": "estleg:LoKS_Map"
      }
    },
    {
      "@id": "estleg:LoKS_Par_51_1_v104012019019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_51_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loaandja teeb loomkatseprojekti järelhindamise raske loomkatse puhul ja juhul kui loomkatseprojekti raames tehtud loomkatses on kasutatud ahvilisi. (2) Loomkatseprojekti järelhindamisel hinnatakse loomkatse protokolli alusel loomkatseprojekti eesmärgi saavutamist ja loomadele põhjustatud kahju, võttes arvesse kasutatud katseloomade arvu, liiki ja loomkatse raskusastmeid ning muid asjaolusid, mis aitavad kaasa loomkatse asendamise, vähendamise ja täiustamise nõude kohaldamisele.",
      "rdfs:label": {
        "@value": "LoKS_Par_51_1 (redaktsioon 104012019019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104012019019",
