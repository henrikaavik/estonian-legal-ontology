        "@value": "2005-11-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22473",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:provisionRef": "LoKS § 66",
      "estleg:partOfAct": {
        "@id": "estleg:LoKS_Map"
      }
    },
