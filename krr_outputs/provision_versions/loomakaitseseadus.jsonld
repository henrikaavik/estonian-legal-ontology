      },
      "estleg:versionValidFrom": {
        "@value": "2016-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtjale antakse loomade vedaja tegevusluba, kui ta vastab nõukogu määruse (EÜ) nr 1/2005 artiklis 10 sätestatud nõuetele.",
      "rdfs:label": {
