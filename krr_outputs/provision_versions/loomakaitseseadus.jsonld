      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Võistlustel peab olema kohal tegevusluba omav veterinaararst. (2) Võistluste veterinaararst peab: jälgima loomakaitsenõuete täitmist võistluse kestel; kontrollima looma võistluskõlblikkust ja dopingut; kontrollima võistlustel kasutatava varustuse ja abivahendite sobivust; andma loomale esmaabi ja määrama vajaduse korral edasise ravi; otsustama hädaseisundis looma hukkamise; ebasoodsate ilmastikutingimuste korral tegema võistluse korraldajale ettepaneku võistluste ärajätmiseks. (3) Nõuded võistlustel osalevate loomade vanuse, kasutatava varustuse ja abivahendite, samuti loomade võistlustel kasutamise sageduse, võistlusradade ja takistuste ehituse kohta loomaliikide ja -kategooriate kaupa kehtestab Vabariigi Valitsus või tema volitatud minister.",
      "rdfs:label": {
        "@value": "LoKS_Par_26 (redaktsioon 22473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22473",
      "estleg:supersededByVersion": {
        "@id": "estleg:LoKS_Par_26_v752070"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22473",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:provisionRef": "LoKS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:LoKS_Map"
      }
    },
