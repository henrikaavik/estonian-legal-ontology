    {
      "@id": "estleg:LoKS_Par_41_v13085469",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LoKS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loomkatse võib läbi viia Veterinaar- ja Toiduameti poolt tunnustatud ettevõttes (edaspidi katseloomade kasutusettevõte ). (3) Teaduslikult põhjendatud eesmärgil võib loomkatse läbi viia loomakasvatushoones, -rajatises, looma pidamiseks piiritletud alal või loomaaias, mis ei ole tunnustatud katseloomade kasutusettevõttena.",
      "rdfs:label": {
        "@value": "LoKS_Par_41 (redaktsioon 13085469)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13085469",
