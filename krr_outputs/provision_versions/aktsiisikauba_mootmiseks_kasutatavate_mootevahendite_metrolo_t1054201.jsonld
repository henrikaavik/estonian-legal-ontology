    {
      "@id": "estleg:Reg_1054201_Par_2_v1054201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054201_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aktsiisikauba mõõtmiseks kasutatakse taadeldud või taatluskohustuse puudumisel jälgitavalt kalibreeritud mõõtevahendit. Aktsiisikauba mõõtmiseks kasutatakse taadeldud või taatluskohustuse puudumisel jälgitavalt kalibreeritud mõõtevahendit. 2 (2) Aktsiisikauba mõõtmisel kasutatakse mõõtevahendit vastavalt õigusaktis, tüübihindamistunnistuses, tüübikinnitustunnistuses, tootja koostatud kasutusjuhendis, asjakohases standardis või tehnilises spetsifikatsioonis ette nähtud nõuetele. Aktsiisikauba mõõtmisel kasutatakse mõõtevahendit vastavalt õigusaktis, tüübihindamistunnistuses, tüübikinnitustunnistuses, tootja koostatud kasutusjuhendis, asjakohases standardis või tehnilises spetsifikatsioonis ette nähtud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1054201_Par_2 (redaktsioon 1054201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054201",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054201",
      "estleg:sourceAct": "Aktsiisikauba mõõtmiseks kasutatavate mõõtevahendite metroloogilistele omadustele ja mõõteprotseduuridele esitatavad nõuded",
      "estleg:provisionRef": "Reg_1054201 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054201_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054201_Par_3_v1054201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054201_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aktsiisikauba valmistamiseks kasutatud toorme, pooltoote, aktsiisikauba koguse ja alkoholi puhul ka etanoolisisalduse mõõtmiseks kasutatava mõõtevahendi lubatud veapiirid peavad vastama määruse lisas esitatud väärtustele. Aktsiisikauba mõõtmistel lisas nimetamata mõõtevahendiga peavad kasutatava mõõtevahendi metroloogilised omadused tagama mõõteprotsessi tulemuse lõikes 2 nimetatud täpsustasemel. Aktsiisikauba valmistamiseks kasutatud toorme, pooltoote, aktsiisikauba koguse ja alkoholi puhul ka etanoolisisalduse mõõtmiseks kasutatava mõõtevahendi lubatud veapiirid peavad vastama määruse lisas esitatud väärtustele. Aktsiisikauba mõõtmistel lisas nimetamata mõõtevahendiga peavad kasutatava mõõtevahendi metroloogilised omadused tagama mõõteprotsessi tulemuse lõikes 2 nimetatud täpsustasemel. 2 (2) Aktsiisikauba mõõtmisel kasutatava mõõtevahendi metroloogilised omadused ja mõõtemetoodika peavad tagama mõõteprotsessi tulemuse laiendmääramatuse järgmised väärtused: 1 1) vedeliku koguse mõõtmisel ±0,7 protsenti mõõtetulemusest; 2 2) kaalukauba koguse mõõtmisel ±0,3 protsenti mõõtetulemusest; 3 3) tükikauba koguse mõõtmisel ±0,001 protsenti mõõtetulemusest; 4 4) vedelgaasi ja mootorivedelgaasi koguse mõõtmisel ±1,2 protsenti mõõtetulemusest; 5 5) maagaasi, mootorimaagaasi ja elektrienergia koguse mõõtmisel mõõtevahendi määruse lisas määratletud väikseima piirvea kahekordne väärtus. Aktsiisikauba mõõtmisel kasutatava mõõtevahendi metroloogilised omadused ja mõõtemetoodika peavad tagama mõõteprotsessi tulemuse laiendmääramatuse järgmised väärtused: vedeliku koguse mõõtmisel ±0,7 protsenti mõõtetulemusest; kaalukauba koguse mõõtmisel ±0,3 protsenti mõõtetulemusest; tükikauba koguse mõõtmisel ±0,001 protsenti mõõtetulemusest; vedelgaasi ja mootorivedelgaasi koguse mõõtmisel ±1,2 protsenti mõõtetulemusest; maagaasi, mootorimaagaasi ja elektrienergia koguse mõõtmisel mõõtevahendi määruse lisas määratletud väikseima piirvea kahekordne väärtus. 3 (3) Aktsiisikauba mahuühikus mõõdetud kogus teisendatakse: 1 1) sajaprotsendilise etanooli mahule temperatuuril 20 ºC; 2 2) vedelkütuse mahule temperatuuril 15 ºC; 3 3) maagaasi ja mootorimaagaasi mahule temperatuuril 20 ºC ja rõhul 101,325 kPa (1,01325 baari). Aktsiisikauba mahuühikus mõõdetud kogus teisendatakse: sajaprotsendilise etanooli mahule temperatuuril 20 ºC; vedelkütuse mahule temperatuuril 15 ºC; maagaasi ja mootorimaagaasi mahule temperatuuril 20 ºC ja rõhul 101,325 kPa (1,01325 baari). 4 (4) Mõõtemahuti ja püsitorustiku ümberkalibreerimine tehakse: 1 1) statsionaarsel mõõtemahutil ning selle juurde kuuluval ja laadimissõlmi ühendaval püsitorustikul iga viieteist aasta järel; 2 2) laeva-mõõtemahutil iga kaheteist aasta järel; 3 3) liikuval mõõtemahutil, mis on püsivalt paigaldatud sõidukile, iga viie aasta järel; 4 4) kui muutuvad mõõtemahuti geomeetrilised omadused. Mõõtemahuti ja püsitorustiku ümberkalibreerimine tehakse: statsionaarsel mõõtemahutil ning selle juurde kuuluval ja laadimissõlmi ühendaval püsitorustikul iga viieteist aasta järel; laeva-mõõtemahutil iga kaheteist aasta järel; liikuval mõõtemahutil, mis on püsivalt paigaldatud sõidukile, iga viie aasta järel; kui muutuvad mõõtemahuti geomeetrilised omadused. 5 (5) Aktsiisikauba mõõtmiseks kohustatud isik tagab mõõtmisel kasutatud mõõtevahendite, mõõtemeetodite ning mõõtmiste ja arvutuste õigsuse ning usaldusväärsuse kontrollimist kajastava dokumentatsiooni kättesaadavuse. Aktsiisikauba mõõtmiseks kohustatud isik tagab mõõtmisel kasutatud mõõtevahendite, mõõtemeetodite ning mõõtmiste ja arvutuste õigsuse ning usaldusväärsuse kontrollimist kajastava dokumentatsiooni kättesaadavuse.",
      "rdfs:label": {
        "@value": "Reg_1054201_Par_3 (redaktsioon 1054201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054201",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054201",
      "estleg:sourceAct": "Aktsiisikauba mõõtmiseks kasutatavate mõõtevahendite metroloogilistele omadustele ja mõõteprotseduuridele esitatavad nõuded",
      "estleg:provisionRef": "Reg_1054201 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054201_Map_2026"
      }
    },
    {
