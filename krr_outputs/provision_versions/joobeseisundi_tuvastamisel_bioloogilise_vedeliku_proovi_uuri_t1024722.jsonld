        "@value": "Sätete redaktsioonid: Joobeseisundi tuvastamisel bioloogilise vedeliku proovi uuringu tulemuse ekspertiisiakti vormi kehtestamine (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Joobeseisundi tuvastamisel bioloogilise vedeliku proovi uuringu tulemuse ekspertiisiakti vormi kehtestamine"
    },
    {
      "@id": "estleg:Reg_1024722_Par_1_v1024722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
