  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_prokuratuuri_taotlusel_kaaluka_avaliku_huvi_korral_tahtajali_t345856_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Prokuratuuri taotlusel kaaluka avaliku huvi korral tähtajalise elamisloa andmise menetluse algatamiseks esitatavate andmete ja taotlusele lisatavate dokumentide loetelu (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Prokuratuuri taotlusel kaaluka avaliku huvi korral tähtajalise elamisloa andmise menetluse algatamiseks esitatavate andmete ja taotlusele lisatavate dokumentide loetelu"
    },
    {
      "@id": "estleg:Reg_345856_Par_1_v345856",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345856_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tähtajalise elamisloa või tähtajalise elamisloa pikendamise taotluse kaaluka avaliku huvi korral (edaspidi taotlus) esitab prokuratuuri nimel prokurör Politsei- ja Piirivalveametile posti teel. Tähtajalise elamisloa või tähtajalise elamisloa pikendamise taotluse kaaluka avaliku huvi korral (edaspidi taotlus) esitab prokuratuuri nimel prokurör Politsei- ja Piirivalveametile posti teel. 2 (2) Taotlus peab olema täidetud trükitähtedega eesti keeles ning selles ei tohi olla parandusi. Taotluses peavad olema esitatud kõik määruses ettenähtud andmed. Taotluse väljad tuleb täita tumedas kirjas, mis tagaks esitatud andmete säilimise. Prokurör kinnitab taotlusele lisatud dokumentide koopiate vastavust originaalile oma allkirjaga. Taotlus peab olema täidetud trükitähtedega eesti keeles ning selles ei tohi olla parandusi. Taotluses peavad olema esitatud kõik määruses ettenähtud andmed. Taotluse väljad tuleb täita tumedas kirjas, mis tagaks esitatud andmete säilimise. Prokurör kinnitab taotlusele lisatud dokumentide koopiate vastavust originaalile oma allkirjaga. 3 (3) Taotlusele lisatud välismaalase foto peab vastama «Isikut tõendavate dokumentide seaduse» alusel Vabariigi Valitsuse poolt kehtestatud isikut tõendava dokumendi väljaandmise taotlemisel fotole esitatavatele nõuetele. Taotlusele lisatud välismaalase foto peab vastama «Isikut tõendavate dokumentide seaduse» alusel Vabariigi Valitsuse poolt kehtestatud isikut tõendava dokumendi väljaandmise taotlemisel fotole esitatavatele nõuetele.",
      "rdfs:label": {
        "@value": "Reg_345856_Par_1 (redaktsioon 345856)",
        "@language": "et"
      },
