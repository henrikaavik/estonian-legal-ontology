      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Automaatse liikluskindlustuse kindlustusmakse määra kehtestamine (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Automaatse liikluskindlustuse kindlustusmakse määra kehtestamine"
    },
    {
      "@id": "estleg:Reg_1025642_Par_1_v1025642",
      "@type": [
