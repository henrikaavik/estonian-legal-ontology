    {
      "@id": "estleg:Reg_1057542_Par_27_v1057542",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057542_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) 2024. a juulis jõustunud § 2 lõigete 1 ja 6 muudatusi kohaldatakse tagasiulatuvalt alates 1. jaanuarist 2024. a. RT I 2024-07-25 1 125072024001 2024-07-28 2024. a juulis jõustunud § 2 lõigete 1 ja 6 muudatusi kohaldatakse tagasiulatuvalt alates 1. jaanuarist 2024. a. 2 (2) Käesoleva määruse 2025. a mais jõustunud § 1 lõike 5 muudatusi ei kohaldata enne nimetatud muudatuste jõustumist esitatud taotlustele. RT I 2025-05-30 4 130052025004 2025-06-02 Käesoleva määruse 2025. a mais jõustunud § 1 lõike 5 muudatusi ei kohaldata enne nimetatud muudatuste jõustumist esitatud taotlustele.",
      "rdfs:label": {
        "@value": "Reg_1057542_Par_27 (redaktsioon 1057542)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057542",
