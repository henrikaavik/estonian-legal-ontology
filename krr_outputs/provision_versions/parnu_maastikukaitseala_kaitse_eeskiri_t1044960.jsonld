      "estleg:provisionRef": "Reg_1044960 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044960_Map"
      }
    },
    {
      "@id": "estleg:Reg_1044960_Par_2_v1044960",
