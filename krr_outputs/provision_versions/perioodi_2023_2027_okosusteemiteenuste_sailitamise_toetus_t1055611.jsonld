        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus makstakse toetuse saajale hiljemalt kohustuseaastale järgneva kalendriaasta 30. juuniks. Toetus makstakse toetuse saajale hiljemalt kohustuseaastale järgneva kalendriaasta 30. juuniks.",
      "rdfs:label": {
        "@value": "Reg_1055611_Par_14 (redaktsioon 1055611)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055611",
