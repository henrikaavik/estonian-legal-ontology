    {
      "@id": "estleg:Reg_1055611_Par_15_v1055611",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055611_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA teavitab toetuse saajat tema andmete avalikustamisest ja töötlemisest Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2116 artiklites 98 ja 99 sätestatud alustel ja korras. PRIA teavitab toetuse saajat tema andmete avalikustamisest ja töötlemisest Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2116 artiklites 98 ja 99 sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "Reg_1055611_Par_15 (redaktsioon 1055611)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055611",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055611",
      "estleg:sourceAct": "Perioodi 2023–2027 ökosüsteemiteenuste säilitamise toetus",
      "estleg:provisionRef": "Reg_1055611 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055611_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055611_Par_15_16_v1055611",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
