      "estleg:versionValidFrom": {
        "@value": "2022-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 11. juuni 2020. a käskkirjaga nr 1-2/20/264 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 11. juuni 2020. a käskkirjaga nr 1-2/20/264 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1052009_Par_5 (redaktsioon 1052009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052009",
      "estleg:sourceAct": "Jõgeva, Tartu ja Viljandi maakonna uuendamata kaitsekorraga alade kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1052009 § 5",
      "estleg:partOfAct": {
