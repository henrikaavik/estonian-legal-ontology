    {
      "@id": "estleg:Reg_1052009_Par_5_v1052009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052009_Par_5"
