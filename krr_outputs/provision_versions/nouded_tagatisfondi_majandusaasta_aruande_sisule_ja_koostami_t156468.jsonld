    },
    {
      "@id": "estleg:Reg_156468_Par_2_v156468",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156468_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-06-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Fondi raamatupidamist ja aruandlust korraldatakse, lähtudes «Raamatupidamise seadusest», «Tagatisfondi seadusest» (edaspidi seadus), käesolevast määrusest ning muudest õigusaktidest, kui käesolevas määruses ei ole sätestatud teisiti. Fondi raamatupidamisele ja -aruandlusele ei kohaldata \"Raamatupidamise seaduse\" §-des 15, 18 ja 20 kasumiaruande ja omakapitali muutuste aruande kohta sätestatut. Fondi raamatupidamist ja aruandlust korraldatakse, lähtudes «Raamatupidamise seadusest», «Tagatisfondi seadusest» (edaspidi seadus), käesolevast määrusest ning muudest õigusaktidest, kui käesolevas määruses ei ole sätestatud teisiti. Fondi raamatupidamisele ja -aruandlusele ei kohaldata \"Raamatupidamise seaduse\" §-des 15, 18 ja 20 kasumiaruande ja omakapitali muutuste aruande kohta sätestatut. 2 (2) Majandusaasta aruandele lisatakse audiitori aruanne. RT I 2016-07-01 2 101072016002 2016-07-04 Majandusaasta aruandele lisatakse audiitori aruanne.",
      "rdfs:label": {
        "@value": "Reg_156468_Par_2 (redaktsioon 156468)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156468",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156468",
      "estleg:sourceAct": "Nõuded Tagatisfondi majandusaasta aruande sisule ja koostamisele",
      "estleg:provisionRef": "Reg_156468 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156468_Map"
      }
    },
    {
      "@id": "estleg:Reg_156468_Par_3_v156468",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156468_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-06-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Raamatupidamise aastaaruanne koosneb bilansist, Fondi ja osafondide liikumise aruandest (edaspidi liikumisaruanne), rahavoogude aruandest ja lisadest. RT I 2016-07-01 2 101072016002 2016-07-04 Raamatupidamise aastaaruanne koosneb bilansist, Fondi ja osafondide liikumise aruandest (edaspidi liikumisaruanne), rahavoogude aruandest ja lisadest. 2 (2) Raamatupidamise aastaaruanne koostatakse euro täpsusega. RT I 2010-11-09 1 109112010001 2011-01-01 Raamatupidamise aastaaruanne koostatakse euro täpsusega. 3 (3) Kehtetu - RT I 2016-07-01 2 101072016002 2016-07-04 Kehtetu - 4 (4) Kehtetu - RT I 2016-07-01 2 101072016002 2016-07-04 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_156468_Par_3 (redaktsioon 156468)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156468",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156468",
      "estleg:sourceAct": "Nõuded Tagatisfondi majandusaasta aruande sisule ja koostamisele",
      "estleg:provisionRef": "Reg_156468 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156468_Map"
      }
    },
