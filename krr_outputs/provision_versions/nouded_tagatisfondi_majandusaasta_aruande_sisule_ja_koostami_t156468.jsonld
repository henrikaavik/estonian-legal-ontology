      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse nõuded Tagatisfondi (edaspidi Fond) majandusaasta aruande koostamisele ja selle sisule. Käesoleva määrusega kehtestatakse nõuded Tagatisfondi (edaspidi Fond) majandusaasta aruande koostamisele ja selle sisule.",
      "rdfs:label": {
        "@value": "Reg_156468_Par_1 (redaktsioon 156468)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156468",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156468",
