      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kodakondsuse taotleja eesti keele eksami ja eesti keele tasemeeksami ühitamise tingimused ning eksami läbiviimise kord (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kodakondsuse taotleja eesti keele eksami ja eesti keele tasemeeksami ühitamise tingimused ning eksami läbiviimise kord"
    },
    {
      "@id": "estleg:Reg_320066_Par_1_v320066",
