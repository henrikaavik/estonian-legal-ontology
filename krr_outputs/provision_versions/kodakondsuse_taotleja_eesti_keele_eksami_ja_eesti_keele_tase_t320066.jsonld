    {
      "@id": "estleg:Reg_320066_Par_8_v320066",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_320066_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui eksaminand ei ole rahul eksami tulemusega, on tal õigus 30 päeva jooksul pärast tulemuse talle teatavaks tegemist esitada Haridus- ja Teadusministeeriumile vaie oma eksamitulemuse läbivaatamiseks. RT I 2011-06-27 3 127062011003 2011-07-01 Kui eksaminand ei ole rahul eksami tulemusega, on tal õigus 30 päeva jooksul pärast tulemuse talle teatavaks tegemist esitada Haridus- ja Teadusministeeriumile vaie oma eksamitulemuse läbivaatamiseks. 2 (2) Vaide läbivaatamine toimub „Keeleseaduse” §-s 25 sätestatud korras. RT I 2011-06-27 3 127062011003 2011-07-01 Vaide läbivaatamine toimub „Keeleseaduse” §-s 25 sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_320066_Par_8 (redaktsioon 320066)",
        "@language": "et"
      },
