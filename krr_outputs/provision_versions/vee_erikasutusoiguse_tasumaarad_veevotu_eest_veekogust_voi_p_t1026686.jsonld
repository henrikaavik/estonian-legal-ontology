      "estleg:sourceAct": "Vee erikasutusõiguse tasumäärad veevõtu eest veekogust või põhjaveekihist",
      "estleg:provisionRef": "Reg_1026686 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026686_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1026686_Par_2_v1026686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
