      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tähtis isiklik dokument käesoleva jao tähenduses on isikutunnistus, Eesti kodaniku pass, diplomaatiline pass, meremehe teenistusraamat, välismaalase pass, ajutine reisidokument, pagulase reisidokument, meresõidutunnistus, tagasipöördumistunnistus, mootorsõidukijuhi juhiluba ja kaitseteenistuse tunnistus.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_350 (redaktsioon 184411)",
        "@language": "et"
      },
