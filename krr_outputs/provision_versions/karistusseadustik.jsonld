    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_100_v13326359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_100"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõjategevuse piirkonnas oleva haige, haavatud või merehätta sattunud inimese abita jätmise eest, kui sellega on põhjustatud inimese surm või tekitatud talle tervisekahjustus, –karistatakse kolme- kuni kaheteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_100 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_100_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_100_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_100"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjategevuse piirkonnas oleva haige, haavatud või merehätta sattunud inimese abita jätmise eest, kui sellega on põhjustatud inimese surm või tekitatud talle tervisekahjustus, –karistatakse kolme- kuni kaheteistaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_100 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_101_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vaenlase haige, haavatud või muul põhjusel võitlusvõimetuks jäänud võitleja tapmise, talle tervisekahjustuse tekitamise või tema piinamise eest, kui võitleja on relvad maha pannud, - karistatakse kuue- kuni viieteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_101 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_101_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_101_v13231473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vaenlase haige, haavatud või muul põhjusel võitlusvõimetuks jäänud võitleja tapmise, talle tervisekahjustuse tekitamise või tema piinamise eest, kui võitleja on relvad maha pannud, – karistatakse kuue- kuni viieteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_101 (redaktsioon 13231473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231473",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_101_v13326359"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_101_v13326359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vaenlase haige, haavatud või muul põhjusel võitlusvõimetuks jäänud võitleja tapmise, talle tervisekahjustuse tekitamise või tema piinamise eest, kui võitleja on relvad maha pannud, –karistatakse kuue- kuni viieteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_101 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_101_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_101_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vaenlase haige, haavatud või muul põhjusel võitlusvõimetuks jäänud võitleja suhtes vägivallateo või sellega ähvardamise või tema suhtes seksuaalse enesemääramise vastase süüteo toimepanemise eest –karistatakse kuue- kuni viieteistaastase vangistusega. (2) Vaenlase haige, haavatud või muul põhjusel võitlusvõimetuks jäänud võitleja tapmise või tema suhtes käesoleva paragrahvi lõikes 1 sätestatud teo toimepanemise eest, kui sellega on: põhjustatud kannatanu surm või viidud kannatanu enesetapuni või selle katseni, –karistatakse kaheksa- kuni kahekümneaastase või eluaegse vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_101 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_102_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõuetekohaseid eraldusmärke kandva meditsiiniüksuse liikme või muu haigete või haavatute eest hoolitseva isiku, vaimuliku, sõjategevuse piirkonnas oma kohustusi täitva humanitaarorganisatsiooni esindaja, tsiviilkaitsetöötaja, parlamentääri või teda saatva isiku tapmise, piinamise, talle tervisekahjustuse tekitamise või tema pantvangi võtmise eest - karistatakse kuue- kuni viieteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_102 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_102_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_102_v13231473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõuetekohaseid eraldusmärke kandva meditsiiniüksuse liikme või muu haigete või haavatute eest hoolitseva isiku, vaimuliku, sõjategevuse piirkonnas oma kohustusi täitva humanitaarorganisatsiooni esindaja, tsiviilkaitsetöötaja, parlamentääri või teda saatva isiku tapmise, piinamise, talle tervisekahjustuse tekitamise või tema pantvangi võtmise eest –karistatakse kuue- kuni viieteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_102 (redaktsioon 13231473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231473",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_102_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_102_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõuetekohaseid eraldusmärke kandva meditsiiniüksuse liikme või muu haigete või haavatute eest hoolitseva isiku, vaimuliku, sõjategevuse piirkonnas oma kohustusi täitva humanitaarorganisatsiooni või rahuvalvemissiooni esindaja, tsiviilkaitsetöötaja, parlamentääri või teda saatva isiku suhtes vägivallateo või seksuaalse enesemääramise vastase süüteo toimepanemise või sellega ähvardamise, tema ohtu asetamise või abita jätmise, ebainimliku kohtlemise, sundimise eest osalema inimuuringutes või andma siirdematerjali, vabaduse ebaseadusliku võtmise või tema üle seaduslikus korras toimuva kohtupidamise õiguse võtmise eest –karistatakse kuue- kuni viieteistaastase vangistusega. (2) Nõuetekohaseid eraldusmärke kandva meditsiiniüksuse liikme või muu haigete või haavatute eest hoolitseva isiku, vaimuliku, sõjategevuse piirkonnas oma kohustusi täitva humanitaarorganisatsiooni või rahuvalvemissiooni esindaja, tsiviilkaitsetöötaja, parlamentääri või teda saatva isiku tapmise või tema suhtes käesoleva paragrahvi lõikes 1 sätestatud teo toimepanemise eest, kui sellega on: põhjustatud kannatanu surm või viidud kannatanu enesetapuni või selle katseni, –karistatakse kaheksa- kuni kahekümneaastase või eluaegse vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_102 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_103_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Bioloogilise või bakterioloogilise relva, keemiarelva või muu massihävitusrelva, mürkrelva, mürgiste või lämmatavate gaaside, püünismiinide ehk ohututeks väikeesemeteks maskeeritud lõhkekehade, lõhkekuulide, röntgenkiirtele nähtamatuid kilde tekitavate või muude rahvusvaheliselt keelustatud relvade kasutamise või süüterelva ulatusliku kasutamise eest tingimustes, kus sõjalist sihtmärki ei ole olnud võimalik selgelt eristada tsiviilelanikkonnast või -objektidest või ümbruskonnast, - karistatakse kolme- kuni kaheteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_103 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_103_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_103_v13231473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Bioloogilise või bakterioloogilise relva, keemiarelva või muu massihävitusrelva, mürkrelva, mürgiste või lämmatavate gaaside, püünismiinide ehk ohututeks väikeesemeteks maskeeritud lõhkekehade, lõhkekuulide, röntgenkiirtele nähtamatuid kilde tekitavate või muude rahvusvaheliselt keelustatud relvade kasutamise või süüterelva ulatusliku kasutamise eest tingimustes, kus sõjalist sihtmärki ei ole olnud võimalik selgelt eristada tsiviilelanikkonnast või -objektidest või ümbruskonnast, – karistatakse kolme- kuni kaheteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_103 (redaktsioon 13231473)",
        "@language": "et"
      },
