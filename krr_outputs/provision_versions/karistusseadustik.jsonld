        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_107_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kultuurimälestise, kiriku või muu religioosse tähendusega ehitise või objekti, kunsti- või teadusteose, kultuuriväärtusega arhiivi, raamatukogu, muuseumi või teadusliku kollektsiooni, mida ei kasutata sõjalisel otstarbel, hävitamise, kahjustamise või ebaseadusliku omastamise eest –karistatakse rahalise karistuse või kahe- kuni kümneaastase vangistusega. (2) Sama teo eest, kui on tekitatud suur kahju, –karistatakse kolme- kuni viieteistaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_107 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_108_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõjategevuse piirkonnas või okupeeritud territooriumil vara ulatusliku hävitamise või omastamise eest relvajõududesse kuuluva või sõjategevusest osavõtva isiku poolt, kui see ei olnud tingitud sõjalistest vajadustest ja kui puudub käesoleva seadustiku §-s 95, 106 või 107 sätestatud süüteokoosseis, - karistatakse rahalise karistuse või kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_108 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_108_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_108_v13231473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõjategevuse piirkonnas või okupeeritud territooriumil vara ulatusliku hävitamise või omastamise eest relvajõududesse kuuluva või sõjategevusest osavõtva isiku poolt, kui see ei olnud tingitud sõjalistest vajadustest ja kui puudub käesoleva seadustiku §-s 95, 106 või 107 sätestatud süüteokoosseis, – karistatakse rahalise karistuse või kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_108 (redaktsioon 13231473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231473",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_108_v13326359"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_108_v13326359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõjategevuse piirkonnas või okupeeritud territooriumil vara ulatusliku hävitamise või omastamise eest relvajõududesse kuuluva või sõjategevusest osavõtva isiku poolt, kui see ei olnud tingitud sõjalistest vajadustest ja kui puudub käesoleva seadustiku §-s 95, 106 või 107 sätestatud süüteokoosseis, –karistatakse rahalise karistuse või kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_108 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_108_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_108_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjategevuse piirkonnas või okupeeritud territooriumil võõra asja ebaseadusliku hõivamise, asja rikkumise või hävitamise eest relvajõududesse kuuluva või sõjategevusest osavõtva isiku poolt, kui see ei olnud tingitud sõjalistest vajadustest ja kui puudub käesoleva seadustiku §-s 95, 106 või 107 sätestatud süüteokoosseis, –karistatakse kahe- kuni kümneaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: suures ulatuses; süstemaatiliselt; sissetungimisega, –karistatakse kolme- kuni viieteistaastase vangistusega. (3) Sama teo eest väheväärtusliku asja vastu, kui teo toimepanemisel ei kasutatud vägivalda ja puuduvad käesoleva paragrahvi lõikes 2 sätestatud kvalifitseerivad asjaolud, –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (4) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega. (5) Käesoleva paragrahvi lõikes 3 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 10 000 eurot.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_108 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_109_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lahinguväljal langenu või haavatu juures oleva eseme äravõtmise eest selle ebaseadusliku omastamise eesmärgil - karistatakse ühe- kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_109 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
