    {
      "@id": "estleg:KARIST_2_Osa1_Par_71_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa1_Par_71"
