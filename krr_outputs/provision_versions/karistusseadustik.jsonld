      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kontrollnõude või käitumiskontrolli raames pandud kohustuse kuritahtliku rikkumise eest karistusjärgsele käitumiskontrollile allutatud isiku poolt –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_331_4 (redaktsioon 13203915)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13203915"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_332_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_332"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas jaos sätestatut kohaldatakse ka välisriigis käibel oleva raha, pangakaartide ning muude maksevahendite, väärtpaberite, maksumärkide, postimaksevahendite ja riikliku proovijärelevalve märgiste võltsimise kohta.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_332 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_332_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_332_v123122014016",
