        "@id": "estleg:KARIST_2_Osa2_Par_329"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipidamisasutusest lahkuda lubatud kinnipeetava poolt karistuse kandmise jätkamisest kõrvalehoidumise eest või täitmisele pööratud kohtuotsusega süüteo eest mõistetud muust karistuse täitmisest kõrvalehoidumise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_329 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_329_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_329_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_329"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täitmisele pööratud vangistusest või kinnipidamiskohast lahkuda lubatud kinnipeetava poolt karistuse kandmise jätkamisest, samuti kuriteo eest mõistetud ja täitmisele pööratud käesoleva seadustiku §-des 49, 491, 50, 51, 52 või 522 sätestatud lisakaristuse täitmisest teadliku kõrvalehoidmise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_329 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa1_Par_33_v184411",
      "@type": [
        "owl:NamedIndividual",
