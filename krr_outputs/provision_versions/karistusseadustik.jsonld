      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_183_v13326359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_183"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine väikeses koguses ebaseadusliku edasiandmise või vahendamise eest, samuti selle väikeses koguses ebaseadusliku valmistamise, omandamise või valdamise eest edasiandmise eesmärgil –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: grupi poolt; isiku poolt, kes on varem toime pannud käesolevas jaos sätestatud kuriteo või narkootilise või psühhotroopse aine varguse, röövimise, ebaseadusliku sisse- või väljaveo, üleandmise või käitlemise kinnipidamiskohas, –karistatakse rahalise karistuse või kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_183 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_183_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_183_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_183"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine väikeses koguses ebaseadusliku edasiandmise või vahendamise, selle ebaseadusliku valmistamise, omandamise või valdamise eest edasiandmise eesmärgil, samuti selle väikeses koguses üle riigipiiri toimetamise eest süstemaatiliselt –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: grupi poolt; isiku poolt, kes on varem toime pannud käesolevas jaos sätestatud kuriteo või narkootilise või psühhotroopse aine varguse, röövimise, ebaseadusliku sisse- või väljaveo, üleandmise või käitlemise kinnipidamiskohas, –karistatakse rahalise karistuse või kuni viieaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_183 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_183_v131122016014"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_183_v131122016014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_183"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine väikeses koguses ebaseadusliku edasiandmise või vahendamise, selle ebaseadusliku valmistamise, omandamise või valdamise eest edasiandmise eesmärgil, samuti selle väikeses koguses üle riigipiiri toimetamise eest süstemaatiliselt –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: grupi poolt; isiku poolt, kes on varem toime pannud käesolevas jaos sätestatud kuriteo või narkootilise või psühhotroopse aine varguse, röövimise, ebaseadusliku sisse- või väljaveo, üleandmise või käitlemise kinnipidamiskohas, –karistatakse rahalise karistuse või kuni viieaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega. (4) Kohus võib kohaldada käesoleva paragrahvi lõikes 2 sätestatud kuriteo eest kuriteoga saadud vara laiendatud konfiskeerimist vastavalt käesoleva seadustiku §-s 832 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_183 (redaktsioon 131122016014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016014",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_183_v119032019030"
      },
      "estleg:versionValidTo": {
        "@value": "2019-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_183_v119032019030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_183"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine väikeses koguses ebaseadusliku edasiandmise või vahendamise, selle ebaseadusliku valmistamise, omandamise või valdamise eest edasiandmise eesmärgil, samuti ebaseaduslikult selle väikeses koguses üle riigipiiri toimetamise eest süstemaatiliselt –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: grupi poolt; isiku poolt, kes on varem toime pannud käesolevas jaos sätestatud kuriteo või narkootilise või psühhotroopse aine varguse, röövimise, ebaseadusliku sisse- või väljaveo, üleandmise või käitlemise kinnipidamiskohas, –karistatakse rahalise karistuse või kuni viieaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega. (4) Kohus võib kohaldada käesoleva paragrahvi lõikes 2 sätestatud kuriteo eest kuriteoga saadud vara laiendatud konfiskeerimist vastavalt käesoleva seadustiku §-s 832 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_183 (redaktsioon 119032019030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019030"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_184_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_184"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine suures koguses ebaseadusliku valmistamise, omandamise, valdamise, edasiandmise, vahendamise, veo või muu ebaseadusliku käitlemise eest - karistatakse ühe- kuni viieaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: grupi või kuritegeliku ühenduse poolt või vähemalt teist korda, -karistatakse kahe- kuni kümneaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 sätestatud teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega. (4) Käesoleva paragrahvi lõike 2 punktis 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistuse või sundlõpetamisega. (5) Kohus võib kohaldada käesolevas paragrahvis sätestatud süüteo eest lisakaristusena varalist karistust vastavalt käesoleva seadustiku §-s 53 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_184 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_184_v953192"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_184_v953192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_184"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine suures koguses ebaseadusliku valmistamise, omandamise, valdamise, edasiandmise, vahendamise, veo või muu ebaseadusliku käitlemise eest – karistatakse ühe- kuni kümneaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: grupi poolt; isiku poolt, kes on varem toime pannud käesolevas jaos sätestatud kuriteo või narkootilise või psühhotroopse aine varguse, röövimise, salakaubaveo, üleandmise või käitlemise kinnipidamiskohas, – karistatakse kolme- kuni viieteistaastase vangistusega. (2¹) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui see on toime pandud: suure varalise kasu saamise eesmärgil või kuritegeliku ühenduse poolt, – karistatakse kuue- kuni kahekümneaastase või eluaegse vangistusega. (3) Käesoleva paragrahvi lõikes 1 sätestatud teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahalise karistusega. (4) Käesoleva paragrahvi lõike 2 punktis 2 või lõike 2 1 punktis 1 sätestatud teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahalise karistusega või sundlõpetamisega. (5) Kohus võib kohaldada käesolevas paragrahvis sätestatud süüteo eest lisakaristusena varalist karistust vastavalt käesoleva seadustiku §-s 53 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_184 (redaktsioon 953192)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "953192",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_184_v12775031"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_184_v12775031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_184"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine suures koguses ebaseadusliku valmistamise, omandamise, valdamise, edasiandmise, vahendamise, veo või muu ebaseadusliku käitlemise eest – karistatakse ühe- kuni kümneaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: grupi poolt; isiku poolt, kes on varem toime pannud käesolevas jaos sätestatud kuriteo või narkootilise või psühhotroopse aine varguse, röövimise, salakaubaveo, üleandmise või käitlemise kinnipidamiskohas, – karistatakse kolme- kuni viieteistaastase vangistusega. (2¹) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui see on toime pandud: suure varalise kasu saamise eesmärgil või kuritegeliku ühenduse poolt, – karistatakse kuue- kuni kahekümneaastase või eluaegse vangistusega. (3) Käesoleva paragrahvi lõikes 1 sätestatud teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahalise karistusega. (4) Käesoleva paragrahvi lõike 2 punktis 2 või lõike 21 punktis 1 sätestatud teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahalise karistusega või sundlõpetamisega. (5) Käesolevas paragrahvis sätestatud kuriteo eest: võib kohus kohaldada lisakaristusena varalist karistust vastavalt käesoleva seadustiku §-s 53 sätestatule või kohaldab kohus kuriteoga saadud vara laiendatud konfiskeerimist vastavalt käesoleva seadustiku §-s 832 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_184 (redaktsioon 12775031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12775031",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_184_v12792390"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
