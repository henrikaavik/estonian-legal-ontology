      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtu või kohtuniku laimamise või solvamise eest seoses tema osalemisega õigusemõistmisel –karistatakse rahalise karistuse või kuni kaheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_305 (redaktsioon 13326359)",
        "@language": "et"
      },
