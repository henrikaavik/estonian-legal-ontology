    {
      "@id": "estleg:KARIST_2_Osa2_Par_268_v131122016014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_268"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootiliste või psühhotroopsete ainete ebaseaduslikuks tarvitamiseks või ebaseaduslike hasartmängude korraldamiseks ruumi kasutada andmise eest –karistatakse rahalise karistuse või kuni viieaastase vangistusega. (2) Käesolevas paragrahvis sätestatud kuriteo eest: võib kohus kohaldada lisakaristusena varalist karistust vastavalt käesoleva seadustiku §-s 53 sätestatule või võib kohus kohaldada kuriteoga saadud vara laiendatud konfiskeerimist vastavalt käesoleva seadustiku §-s 832 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_268 (redaktsioon 131122016014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016014",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_268_v119032019030"
