    {
      "@id": "estleg:KARIST_2_Osa2_Par_331_1_v953229",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_331_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tsiviilasjas tehtud kohtulahendi, millega kohustatakse isikut välja andma lapse või asja või tegema asendamatut toimingut või hoiduma toimingu tegemisest, täitmata jätmise eest, kui isikut on selle eest täitemenetluses trahvitud või kui tema suhtes on selle eest täitemenetluses kohaldatud aresti, – karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_331_1 (redaktsioon 953229)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "953229",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_331_1_v13326359"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_331_1_v13326359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_331_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tsiviilasjas tehtud kohtulahendi, millega kohustatakse isikut välja andma lapse või asja või tegema asendamatut toimingut või hoiduma toimingu tegemisest, täitmata jätmise eest, kui isikut on selle eest täitemenetluses trahvitud või kui tema suhtes on selle eest täitemenetluses kohaldatud aresti, –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_331_1 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_331_1_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_331_1_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_331_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tsiviilasjas tehtud kohtulahendi, millega kohustatakse isikut välja andma laps või asi või tegema asendamatut toimingut või hoiduma toimingu tegemisest, täitmata jätmise eest, kui isikut on selle eest täitemenetluses trahvitud või kui tema suhtes on selle eest täitemenetluses kohaldatud sunniraha või aresti, –karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_331_1 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_331_2_v1046806",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_331_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtulahendiga kohaldatud lähenemiskeelu või muu isikuõiguse kaitse abinõu, välja arvatud ajutise lähenemiskeelu rikkumise eest, kui sellega on põhjustatud oht isiku elule, tervisele või varale, või lähenemiskeelu või muu isikuõiguse kaitse abinõu korduva rikkumise eest – karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_331_2 (redaktsioon 1046806)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046806",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_331_2_v13241911"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_331_2_v13241911",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_331_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtulahendiga kohaldatud lähenemiskeelu või muu isikuõiguse kaitse abinõu rikkumise eest, kui sellega on põhjustatud oht isiku elule, tervisele või varale, või lähenemiskeelu või muu isikuõiguse kaitse abinõu korduva rikkumise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_331_2 (redaktsioon 13241911)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13241911"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_331_3_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_331_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtutäituri poolt vara teadvalt ebaseadusliku arestimise või müügi eest –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui sellega on tekitatud suur varaline kahju, –karistatakse rahalise karistuse või kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_331_3 (redaktsioon 12792390)",
        "@language": "et"
      },
