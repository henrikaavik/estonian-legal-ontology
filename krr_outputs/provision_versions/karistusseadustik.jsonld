        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_291_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_291"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametiisiku poolt relva, erivahendi või füüsilise jõu ebaseadusliku kasutamise eest –karistatakse rahalise karistuse või ühe- kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_291 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_291_v119032019030"
      },
      "estleg:versionValidTo": {
        "@value": "2019-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_291_v119032019030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_291"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ametiisiku poolt relva, erivahendi või füüsilise jõu ebaseadusliku kasutamise eest –karistatakse rahalise karistuse või ühe- kuni viieaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_291 (redaktsioon 119032019030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019030"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_291_1_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_291_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet teostava või kohalikule omavalitsusele seadusega pandud järelevalvekohustust täitva ametiisiku poolt teadvalt ebaseadusliku otsuse või toimingu tegemise eest või otsuse või toimingu ebaseaduslikult tegemata jätmise eest, kui sellega on tekitatud oluline varaline kahju või kui sellega on teisele isikule, välja arvatud riik ja kohalik omavalitsusüksus, põhjustatud muu raske tagajärg, –karistatakse rahalise karistusega või kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_291_1 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_291_1_v119032019030"
      },
      "estleg:versionValidTo": {
        "@value": "2019-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_291_1_v119032019030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_291_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet teostava või kohalikule omavalitsusele seadusega pandud järelevalvekohustust täitva ametiisiku poolt teadvalt ebaseadusliku otsuse või toimingu tegemise eest või otsuse või toimingu ebaseaduslikult tegemata jätmise eest, kui sellega on tekitatud oluline varaline kahju või kui sellega on teisele isikule, välja arvatud riik ja kohalik omavalitsusüksus, põhjustatud muu raske tagajärg, –karistatakse rahalise karistusega või kuni viieaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_291_1 (redaktsioon 119032019030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019030"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_292_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_292"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi või kohaliku omavalitsuse andmekogu pidamise nõuete rikkumise eest, kui sellega on tekitatud oluline kahju teise isiku seadusega kaitstud õigustele või huvidele või avalikele huvidele, - karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui sellega on ettevaatamatusest tekitatud oluline kahju teise isiku seadusega kaitstud õigustele või huvidele või avalikele huvidele, - karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_292 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_292_v12792390"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_292_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_292"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi või kohaliku omavalitsuse andmekogu pidaja ametniku või töötaja poolt ebaseaduslikult registrisse andmete kandmise või andmete kandmata jätmise eest, samuti andmete avalikustamise, andmetele juurdepääsu võimaldamise või andmete edastamise või muude andmekogu pidamise nõuete rikkumise eest, kui sellega on tekitatud oluline kahju teise isiku seadusega kaitstud õigustele või huvidele, –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_292 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_292_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_292_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_292"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_292 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_293_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_293"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ametiisiku poolt talle vara või muu soodustuse lubamisega nõustumise või vara või muu soodustuse vastuvõtmise eest vastutasuna selle eest, et ametiisik on oma ametiseisundit kasutades toime pannud või on alust arvata, et ta edaspidi paneb toime seadusega lubatud teo, või on seaduslikult jätnud teo toime panemata või on alust arvata, et ta jätab selle toime panemata edaspidi, – karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: vähemalt teist korda; pistise nõudmisega; grupi poolt või suures ulatuses, - karistatakse kuni viieaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_293 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_293_v12999083"
      },
      "estleg:versionValidTo": {
        "@value": "2008-07-27",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_293_v12999083",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_293"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ametiisiku poolt talle või kolmandale isikule vara või muu soodustuse lubamisega nõustumise või vara või muu soodustuse vastuvõtmise eest vastutasuna selle eest, et ametiisik on oma ametiseisundit kasutades toime pannud või on alust arvata, et ta edaspidi paneb toime seadusega lubatud teo, või on seaduslikult jätnud teo toime panemata või on alust arvata, et ta jätab selle toime panemata edaspidi, –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: vähemalt teist korda; pistise nõudmisega; grupi poolt või suures ulatuses, - karistatakse kuni viieaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_293 (redaktsioon 12999083)",
        "@language": "et"
