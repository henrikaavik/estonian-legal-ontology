      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uurija või prokuröri poolt vägivallaga ütluste andmisele sundimise eest, kui puudub käesoleva seadustiku §-s 2901 sätestatud süüteokoosseis, –karistatakse rahalise karistuse või ühe- kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_312 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_313_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
