      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Karistusseadustik kehtestatakse eraldi seadusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_451 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_451_v953192"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_451_v953192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_451"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Karistusseadustik kehtestatakse eraldi seadusega. Õiend \"Karistusseadustiku\" § 56 lõike 1 teise lausesse on vigaselt sisse viidud \"Kriminaalmenetluse koodeksi, karistusseadustiku ja väärteomenetluse seadustiku muutmise seaduse\" § 20 alusel tehtud muudatus. Lugeda alates tervikteksti versioonist ID 953192 kuni vesrioonini ID 12800576 \"Karistusseadustiku\" § 56 lõike 1 teine lause õigeks järgmises sõnastuses: \"Karistuse mõistmisel kohtu poolt või määramisel kohtuvälise menetleja poolt arvestatakse kergendavaid ja raskendavaid asjaolusid, võimalust mõjutada süüdlast edaspidi hoiduma süütegude toimepanemisest ja õiguskorra kaitsmise huvisid.\" Alus: \"Riigi Teataja seaduse\" § 17 lõige 32.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_451 (redaktsioon 953192)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "953192",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_451_v953236"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_451_v953236",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_451"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-09-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Karistusseadustik kehtestatakse eraldi seadusega. Õiend Lisatud 1.10.2005 jõustuvad sätted paralleeltekstina. \"Karistusseadustiku\" § 56 lõike 1 teise lausesse on vigaselt sisse viidud \"Kriminaalmenetluse koodeksi, karistusseadustiku ja väärteomenetluse seadustiku muutmise seaduse\" § 20 alusel tehtud muudatus. Lugeda alates tervikteksti versioonist ID 953192 kuni vesrioonini ID 12800576 \"Karistusseadustiku\" § 56 lõike 1 teine lause õigeks järgmises sõnastuses: \"Karistuse mõistmisel kohtu poolt või määramisel kohtuvälise menetleja poolt arvestatakse kergendavaid ja raskendavaid asjaolusid, võimalust mõjutada süüdlast edaspidi hoiduma süütegude toimepanemisest ja õiguskorra kaitsmise huvisid.\" Alus: \"Riigi Teataja seaduse\" § 17 lõige 32.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_451 (redaktsioon 953236)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "953236",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_451_v974237"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_451_v974237",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_451"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Karistusseadustik kehtestatakse eraldi seadusega. Õiend Karistusseadustiku § 55 lõikesse 1 viidud sisse 1.10.2005 jõustunud \"Väärteomenetluse seadustiku, karistusseadustiku ja liiklusseaduse muutmise seadusega\" tehtud muudatused. \"Karistusseadustiku\" § 56 lõike 1 teise lausesse on vigaselt sisse viidud \"Kriminaalmenetluse koodeksi, karistusseadustiku ja väärteomenetluse seadustiku muutmise seaduse\" § 20 alusel tehtud muudatus. Lugeda alates tervikteksti versioonist ID 953192 kuni vesrioonini ID 12800576 \"Karistusseadustiku\" § 56 lõike 1 teine lause õigeks järgmises sõnastuses: \"Karistuse mõistmisel kohtu poolt või määramisel kohtuvälise menetleja poolt arvestatakse kergendavaid ja raskendavaid asjaolusid, võimalust mõjutada süüdlast edaspidi hoiduma süütegude toimepanemisest ja õiguskorra kaitsmise huvisid.\" Alus: \"Riigi Teataja seaduse\" § 17 lõige 32.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_451 (redaktsioon 974237)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "974237",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_451_v12792390"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_451_v12792390",
      "@type": [
        "owl:NamedIndividual",
