      "estleg:versionText": "Karistusseadustik kehtestatakse eraldi seadusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_451 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390"
    },
    {
      "@id": "estleg:KARIST_2_Osa1_Par_46_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa1_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus võib kuriteo eest mõista juriidilise isiku sundlõpetamisele, kui juriidilise isiku tegevuse osaks on saanud kuritegude toimepanemine.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa1_Par_46 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa1_Par_46_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
