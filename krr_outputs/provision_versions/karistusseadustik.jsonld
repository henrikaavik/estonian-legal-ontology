        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_275_v13326359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_275"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võimuesindaja või avalikku korda kaitsva muu isiku laimamise või solvamise eest seoses tema ametikohustuste täitmisega –karistatakse rahalise karistuse või kuni kaheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_275 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_275_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_275_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_275"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avalikku korda kaitsva võimuesindaja solvamise eest seoses tema ametikohustuste täitmisega –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_275 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
