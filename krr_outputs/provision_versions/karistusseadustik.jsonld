      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seaduslikult korraldatud avaliku koosoleku takistamise või selle vägivaldse laialiajamise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_158 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_159_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_159"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mittetulundusühingu loomise, sellesse astumise või selle liikmeks olemise takistamise eest, kui ühingu loomine ja tegevus ei rikkunud riigi ja ühiskonna julgeoleku, avaliku korra, kõlbluse või teiste inimeste õiguste kaitse huvides seaduses sätestatud tingimusi ja piiranguid ning ühingusse astumine või selle liikmeks olemine ei rikkunud avalikus teenistuses olevatele isikutele seaduses sätestatud tingimusi ja piiranguid, - karistatakse rahatrahviga kuni kolmsada trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_159 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_159_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_159_v13231473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_159"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mittetulundusühingu loomise, sellesse astumise või selle liikmeks olemise takistamise eest, kui ühingu loomine ja tegevus ei rikkunud riigi ja ühiskonna julgeoleku, avaliku korra, kõlbluse või teiste inimeste õiguste kaitse huvides seaduses sätestatud tingimusi ja piiranguid ning ühingusse astumine või selle liikmeks olemine ei rikkunud avalikus teenistuses olevatele isikutele seaduses sätestatud tingimusi ja piiranguid, – karistatakse rahatrahviga kuni kolmsada trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_159 (redaktsioon 13231473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231473",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_159_v13326359"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_159_v13326359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_159"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mittetulundusühingu loomise, sellesse astumise või selle liikmeks olemise takistamise eest, kui ühingu loomine ja tegevus ei rikkunud riigi ja ühiskonna julgeoleku, avaliku korra, kõlbluse või teiste inimeste õiguste kaitse huvides seaduses sätestatud tingimusi ja piiranguid ning ühingusse astumine või selle liikmeks olemine ei rikkunud avalikus teenistuses olevatele isikutele seaduses sätestatud tingimusi ja piiranguid, –karistatakse rahatrahviga kuni kolmsada trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_159 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
