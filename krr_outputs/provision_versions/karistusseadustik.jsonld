    {
      "@id": "estleg:KARIST_2_Osa2_Par_244_v120122012013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_244"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Presidendi, Riigikogu esimehe, peaministri, Riigikohtu esimehe, õiguskantsleri, riigikontrolöri, Kaitseväe juhataja tapmise, pantvangi võtmise või temale tervisekahjustuse tekitamise eest –karistatakse kuue- kuni kahekümneaastase või eluaegse vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_244 (redaktsioon 120122012013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122012013",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_244_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_244_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_244"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vägivallateo eest Vabariigi Presidendi, Riigikogu esimehe, peaministri, Riigikohtu esimehe, õiguskantsleri, riigikontrolöri või Kaitseväe juhataja, samuti nimetatud isiku perekonnaliikme vastu –karistatakse kuni viieaastase vangistusega. (2) Käesoleva paragrahvi lõikes 1 nimetatud isiku tapmise, pantvangi võtmise või temale raske tervisekahjustuse tekitamise eest –karistatakse kuue- kuni kahekümneaastase või eluaegse vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_244 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_245_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_245"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi riigilipu, riigivapi või muu ametliku sümboli maharebimise, purustamise, rüvetamise või muul viisil teotamise, samuti riigihümni teotamise eest - karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_245 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_245_v953236"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_245_v953236",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_245"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-09-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi riigilipu, riigivapi või muu ametliku sümboli maharebimise, purustamise, rüvetamise või muul viisil teotamise, samuti riigihümni teotamise eest - karistatakse rahalise karistuse või kuni üheaastase vangistusega. [Paragrahvi 245 sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_245 (redaktsioon 953236)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "953236",
