        "@id": "estleg:KARIST_2_Osa1_Par_43_v992351"
      },
      "estleg:versionValidTo": {
        "@value": "2006-02-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa1_Par_43_v992351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
