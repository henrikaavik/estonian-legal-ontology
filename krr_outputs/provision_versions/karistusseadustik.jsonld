        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_238_v953229",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_238"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paljusid inimesi hõlmava korratuse organiseerimise eest, kui sellega on kaasnenud rüüstamine, purustamine, süütamine või muu selline tegevus, - karistatakse ühe- kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_238 (redaktsioon 953229)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "953229",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_238_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_238_v13231473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_238"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Palju inimesi hõlmava korratuse organiseerimise või ettevalmistamise või sellises korratuses osalemisele üleskutsumise eest, kui sellega on kaasnenud rüüstamine, purustamine, süütamine või muu selline tegevus, –karistatakse kolme- kuni kaheksa-aastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_238 (redaktsioon 13231473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231473",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_238_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_238_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_238"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Palju inimesi hõlmava korratuse organiseerimise või ettevalmistamise või sellises korratuses osalemisele üleskutsumise eest, kui sellega on kaasnenud rüüstamine, purustamine, süütamine või muu selline tegevus, –karistatakse kolme- kuni kaheksa-aastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_238 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_239_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rüüstamise, purustamise, süütamise või muu sellise tegevuse eest massilises korratuses osaleja poolt või vastuhakkamise eest politseiametnikule, abipolitseinikule või muule isikule, kes on seaduslikult tõkestanud sellist tegevust, - karistatakse rahalise karistuse või ühe- kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_239 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_239_v12988867"
      },
      "estleg:versionValidTo": {
        "@value": "2008-07-12",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_239_v12988867",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rüüstamise, purustamise, süütamise või muu sellise tegevuse eest massilises korratuses osaleja poolt või vastuhakkamise eest politseiametnikule, abipolitseinikule või muule isikule, kes on seaduslikult tõkestanud sellist tegevust, –karistatakse rahalise karistuse või ühe- kuni viieaastase vangistusega. (2) Sama teo eest, kui see on toime pandud näo varjamisega näokatte või maskiga või muul viisil, mis takistas isiku tuvastamist, –karistatakse kahe- kuni kaheksa-aastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_239 (redaktsioon 12988867)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12988867",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_239_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_239_v13231473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rüüstamise, purustamise, süütamise või muu sellise tegevuse eest massilises korratuses osaleja poolt või seadusliku korralduse eiramise või vastuhakkamise eest politseiametnikule, abipolitseinikule või muule isikule, kes on seaduslikult tõkestanud sellist tegevust, või sellise isiku üleskutsumise eest teenistuskohustuse täitmata jätmisele, –karistatakse rahalise karistuse või kuni viieaastase vangistusega. (2) Sama teo eest, kui see on toime pandud näo varjamisega näokatte või maskiga või muul viisil, mis takistas isiku tuvastamist, –karistatakse kahe- kuni kaheksa-aastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_239 (redaktsioon 13231473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231473",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_239_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_239_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rüüstamise, purustamise, süütamise või muu sellise tegevuse eest massilises korratuses osaleja poolt või seadusliku korralduse eiramise või vastuhakkamise eest politseiametnikule, abipolitseinikule või muule isikule, kes on seaduslikult tõkestanud sellist tegevust, või sellise isiku üleskutsumise eest teenistuskohustuse täitmata jätmisele, –karistatakse rahalise karistuse või kuni viieaastase vangistusega. (2) Sama teo eest, kui see on toime pandud näo varjamisega näokatte või maskiga või muul viisil, mis takistas isiku tuvastamist, –karistatakse kahe- kuni kaheksa-aastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_239 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa1_Par_24_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa1_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eriline isikutunnus on käesoleva seadustiku eriosas või muus seaduses ettenähtud süüteokoosseisu tunnus, mis kirjeldab toimepanija isikuomadusi, eesmärke või motiive. (2) Kui osavõtjal puudub eriline isikutunnus, mis vastavalt seadusele on täideviija vastutuse eeldus, kohaldatakse osavõtjale käesoleva seadustiku §-s 60 sätestatut. (3) Seaduses sätestatud vastutust raskendav, kergendav või välistav eriline isikutunnus kehtib üksnes erilise isikutunnusega toimepanija suhtes.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa1_Par_24 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_240_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_240"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi- või kohaliku omavalitsuse asutuse ametiruumi tungimise eest selle korrapärase tegevuse takistamise või ametiruumi hõivamise eesmärgil - karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: vägivallaga või relva või relvana kasutatava muu eseme või lõhkeseadeldise või lõhkematerjaliga ähvardades, -karistatakse ühe- kuni viieaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 või 2 sätestatud teo eest, kui sellega on tekitatud raske tagajärg või põhjustatud suur kahju, - karistatakse nelja- kuni kaheteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_240 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_240_v953236"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_240_v953236",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
