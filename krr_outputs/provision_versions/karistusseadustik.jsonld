    {
      "@id": "estleg:KARIST_2_Osa2_Par_232_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_232"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi kodaniku poolt välisriigi, välisriigi organisatsiooni, välismaalase või välisriigi ülesandel tegutseva isiku abistamise eest Eesti Vabariigi iseseisvuse ja sõltumatuse vastu suunatud vägivallata tegevuses või riigisaladuseks tunnistatud teabe kogumise eest selle edastamise eesmärgil või selle edastamise eest välisriigile, välisriigi organisatsioonile, välismaalasele või välisriigi ülesandel tegutsevale isikule - karistatakse kolme- kuni viieteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_232 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
