        "@id": "estleg:KARIST_2_Osa2_Par_376_v112032015021"
      },
      "estleg:versionValidTo": {
        "@value": "2015-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_376_v112032015021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
