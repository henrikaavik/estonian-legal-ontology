    {
      "@id": "estleg:KARIST_2_Osa2_Par_385_v12999083",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_385"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisest isikust võlgniku või juriidilisest isikust võlgniku juhatuse või seda asendava organi, samuti nõukogu liikme poolt pankroti- või täitemenetluses võlgniku vara varjamise või selle või muude võlausaldajale tähtsate asjaolude kohta ebaõigete andmete esitamise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui sellega on kaasnenud valevande andmine, –karistatakse rahalise karistuse või kuni kaheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_385 (redaktsioon 12999083)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12999083",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_385_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_385_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_385"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Füüsilisest isikust võlgniku, juriidilisest isikust võlgniku juhtorgani või seda asendava organi liikme poolt pankroti- või täitemenetluses või ajutise halduri ees võlgniku vara olulises ulatuses varjamise või selle või muude võlausaldajale tähtsate asjaolude kohta ebaõigete andmete esitamise eest, kui andmetes kajastatakse vara olulises ulatuses, –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_385 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_385_1_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_385_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seaduses sätestatud pankrotiavalduse esitamise kohustuse täitmata jätmise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_385_1 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_385_1_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
