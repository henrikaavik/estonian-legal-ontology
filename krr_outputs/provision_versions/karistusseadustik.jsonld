    {
      "@id": "estleg:KARIST_2_Osa2_Par_425_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_425"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raudtee-, vee-, õhu- või teeliikluse korraldamise eest vastutava isiku poolt liiklusohutusnõuete või sõiduki käitusnõuete eiramise eest, kui sellega on põhjustatud oht inimese elule, tervisele, varale või keskkonnale, - karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui sellega on: põhjustatud inimese surm; tekitatud inimesele tervisekahjustus või tekitatud suur kahju, -karistatakse kolme- kuni kaheteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_425 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
