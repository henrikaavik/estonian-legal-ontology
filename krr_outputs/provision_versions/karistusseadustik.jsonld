    {
      "@id": "estleg:KARIST_2_Osa2_Par_257_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_257"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Oma tõelise või oletatava õiguse teostamise eest ebaseaduslikus korras, kui see on olnud seotud vägivalla, vara hävitamise või rikkumise või sellega ähvardamisega, isikult vabaduse võtmise, isiku vabaduse piiramise või sellega ähvardamisega või kui sellega on põhjustatud muu oluline kahju, - karistatakse rahalise karistuse või kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_257 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_257_v12792390"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_257_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
