        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_234_v131122016014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_234"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välismaalase poolt riigisaladuse või salastatud välisteabe kogumise eest selle edastamise eesmärgil või selle edastamise eest välisriigile, välisriigi organisatsioonile, välismaalasele või välisriigi ülesandel tegutsevale isikule –karistatakse kolme- kuni viieteistaastase vangistusega. (2) Kohus võib kohaldada käesolevas paragrahvis sätestatud kuriteo eest kuriteoga saadud vara laiendatud konfiskeerimist vastavalt käesoleva seadustiku §-s 832 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_234 (redaktsioon 131122016014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016014",
