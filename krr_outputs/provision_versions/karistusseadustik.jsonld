      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valimine käesoleva jao tähenduses on Riigikogu või kohaliku omavalitsuse volikogu valimine.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_160 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_160_v242116"
