        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010017",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_379_v109122010007"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_379_v109122010007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_379"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vandeaudiitori või erikontrolli läbiviija poolt audiitor- või erikontrolli läbiviimisel teatavaks saanud oluliste asjaolude aruandes esitamata jätmise või ebaõige esitamise eest, –karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistuse või sundlõpetamisega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_379 (redaktsioon 109122010007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109122010007",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_379_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_379_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_379"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vandeaudiitori või erikontrolli läbiviija poolt audiitor- või erikontrolli läbiviimisel teatavaks saanud oluliste asjaolude aruandes esitamata jätmise või ebaõige esitamise eest, –karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_379 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa1_Par_38_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa1_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevaatamatusest teo toimepannud isikul puudub süü, kui ta oma vaimsete või füüsiliste võimete tõttu ei ole suuteline aru saama, mida temalt eeldatakse, või oma käitumist vastavalt sellele arusaamisele juhtima.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa1_Par_38 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_380_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_380"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osanike või aktsionäride üldkoosoleku ettenähtud korras kokku kutsumata jätmise eest, kui bilansist on selgunud, et netovara on vähem kui pool osa- või aktsiakapitalist või vara on olnud alla seadusega kehtestatud osa- või aktsiakapitali alammäära, või seaduses sätestatud pankrotiavalduse esitamise kohustuse täitmata jätmise eest - karistatakse rahalise karistuse või kuni kolmeaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_380 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_380_v12792390"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_380_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_380"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osanike, aktsionäride või tulundusühistu liikmete üldkoosoleku ettenähtud korras kokku kutsumata jätmise eest, kui bilansist on selgunud, et netovara on vähem kui pool osa- või aktsiakapitalist või netovara on olnud alla seadusega kehtestatud osa- või aktsiakapitali alammäära, –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_380 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_380_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_380_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_380"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_380 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_381_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_381"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osanikele, aktsionäridele, audiitorile, erikontrolli läbiviijale või avalikkusele äriühingu varalise seisundi kohta andmete esitamata jätmise või ebaõigete andmete esitamise eest - karistatakse rahalise karistuse või kuni kolmeaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_381 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_381_v12792390"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_381_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_381"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Äriühingu asutaja, juhatuse või seda asendava organi või nõukogu liikme või likvideerija poolt äriühingu asutajatele, osanikele, aktsionäridele, liikmetele, audiitorile või erikontrolli läbiviijale äriühingu varalise seisundi või muude kontrollitavate asjaolude kohta oluliste andmete esitamata jätmise või ebaõigete andmete esitamise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_381 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_381_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_381_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_381"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Äriühingu asutaja, juhatuse või seda asendava organi või nõukogu liikme või likvideerija poolt äriühingu asutajatele, osanikele, aktsionäridele, liikmetele, audiitorile või erikontrolli läbiviijale äriühingu varalise seisundi või muude kontrollitavate asjaolude kohta teadvalt ebaõigete oluliste andmete esitamise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_381 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_381_1_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_381_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raamatupidamise korraldamise nõuete teadva rikkumise eest või teadvalt raamatupidamisdokumentide ebaseadusliku hävitamise, varjamise või kahjustamise või raamatupidamisdokumendis andmete esitamata jätmise või ebaõigete andmete esitamise eest, kui sellega on oluliselt raskendatud ülevaate saamine raamatupidamiskohustuslase varalisest seisundist, –karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui kohus on välja kuulutanud raamatupidamiskohustuslase pankroti või lõpetanud pankrotimenetluse raugemise tõttu, –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 nimetatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_381_1 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_382_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_382"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Äriühingu asutaja, aktsionäri või osaniku poolt audiitorile või erikontrolli läbiviijale andmete esitamata jätmise või ebaõigete andmete esitamise eest, kui need ei ole seotud äriühingu varalise seisundiga, - karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_382 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_382_v112112010017"
      },
      "estleg:versionValidTo": {
        "@value": "2010-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_382_v112112010017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_382"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_382 (redaktsioon 112112010017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010017",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_382_v109122010007"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_382_v109122010007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_382"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_382 (redaktsioon 109122010007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109122010007"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_383_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_383"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Üldkoosolekul teisele isikule kuuluvate aktsiate või märkimistõendite esindusõiguseta kasutamise või aktsiatest tulenevate muude õiguste ebaseadusliku kasutamise eest - karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_383 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_383_v112112010017"
      },
      "estleg:versionValidTo": {
        "@value": "2010-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_383_v112112010017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_383"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_383 (redaktsioon 112112010017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010017",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_383_v109122010007"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_383_v109122010007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_383"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_383 (redaktsioon 109122010007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109122010007"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_384_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_384"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Oma maksevõime olulise vähendamise või enda maksejõuetuks muutmise eest vara hävitamise, rikkumise, raiskamise või põhjendamatu kinkimise, loovutamise, välismaale paigutamise, põhjendamatute kohustuste võtmise või põhjendamatute soodustuste andmise või ühe võlausaldaja teisele eelistamise teel võlgniku poolt, kes oli teadlik, et olemasolevate või oodatavate majandusraskuste tõttu võivad tema teod kahjustada võlausaldaja huve, - karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Käesoleva paragrahvi lõikes 1 sätestatud teo eest karistatakse üksnes siis, kui kohus on välja kuulutanud teo toimepanija pankroti või lõpetanud pankrotimenetluse raugemise tõttu, sest võlgniku varast ei jätku pankrotimenetluse kulude katteks ja puudub vara tagasivõitmise ja tagasinõudmise võimalus.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_384 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_384_v12792390"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_384_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_384"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisest isikust võlgniku või juriidilisest isikust võlgniku juhatuse või seda asendava organi, samuti nõukogu liikme poolt võlgniku vara teadva hävitamise, kahjustamise, raiskamise, põhjendamatu kinkimise, loovutamise või välismaale paigutamise eest või põhjendamatute kohustuste võtmise või põhjendamatute soodustuste andmise või ühe võlausaldaja teisele eelistamise eest, kui sellega on põhjustatud võlgniku maksevõime oluline vähenemine või tema maksejõuetus, –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Käesoleva paragrahvi lõikes 1 sätestatud teo eest karistatakse üksnes siis, kui kohus on välja kuulutanud teo toimepanija või juriidilisest isikust võlgniku pankroti või lõpetanud pankrotimenetluse raugemise tõttu.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_384 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_384_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_384_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_384"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisest isikust võlgniku, tema seadusliku esindaja või juriidilisest isikust võlgniku juhtorgani või seda asendava organi liikme poolt võlgniku varalise seisundi teadva kohustustevastase kahjustamise eest, kui sellega on põhjustatud võlgniku maksevõime oluline vähenemine või maksejõuetus, –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Käesoleva paragrahvi lõikes 1 sätestatud teo eest karistatakse üksnes siis, kui kohus on välja kuulutanud teo toimepanija või juriidilisest isikust võlgniku pankroti või lõpetanud pankrotimenetluse raugemise tõttu.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_384 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_385_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_385"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pankroti- või täitemenetluses võlgniku poolt oma vara või võlgade varjamise või nende või muude võlausaldajale tähtsate asjaolude kohta ebaõigete andmete esitamise eest - karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui sellega on kaasnenud valevande andmine, - karistatakse rahalise karistuse või kuni kaheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_385 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_385_v12792390"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_385_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_385"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisest isikust võlgniku või juriidilisest isikust võlgniku juhatuse või seda asendava organi, samuti nõukogu liikme poolt pankroti- või täitemenetluses võlgniku vara varjamise või selle või muude võlausaldajale tähtsate asjaolude kohta ebaõigete andmete esitamise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui sellega on kaasnenud valevande andmine, –karistatakse rahalise karistuse või kuni kaheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_385 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390",
