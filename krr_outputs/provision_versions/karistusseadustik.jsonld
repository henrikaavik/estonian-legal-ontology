    {
      "@id": "estleg:KARIST_2_Osa2_Par_208_v974237",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_208"
      },
      "estleg:versionValidFrom": {
