      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus võib kohaldada käesolevas jaos sätestatud süüteo toimepanemise vahetuks objektiks olnud aine või eseme konfiskeerimist vastavalt käesoleva seadustiku §-s 83 sätestatule.",
