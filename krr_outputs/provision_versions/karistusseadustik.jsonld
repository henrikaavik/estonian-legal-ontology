    {
      "@id": "estleg:KARIST_2_Osa2_Par_106_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_106"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõjalisel otstarbel mittekasutatava objekti, demilitariseeritud tsooni, hospitaaltsooni, meditsiiniasutuse või -üksuse, sõjavangide või interneerimislaagri, sõjalise kaitseta asula või ehitise, neutraalse kaubalaeva, õhusõiduki, hospitaallaeva või -õhusõiduki või muu transpordivahendi, kui seda kasutatakse mittevõitlejate veoks, ründamise eest - karistatakse rahalise karistuse või kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_106 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_106_v992351"
      },
      "estleg:versionValidTo": {
        "@value": "2006-02-03",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_106_v992351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_106"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-02-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõjalisel otstarbel mittekasutatava objekti, demilitariseeritud tsooni, hospitaaltsooni, meditsiiniasutuse või -üksuse, sõjavangide või interneerimislaagri, sõjalise kaitseta asula või ehitise, neutraalse kaubalaeva, õhusõiduki, hospitaallaeva või -õhusõiduki või muu transpordivahendi, kui seda kasutatakse mittevõitlejate veoks, ründamise eest - karistatakse rahalise karistuse või kuni viieaastase vangistusega. Ā§ 107. Kultuuriväärtuste vastu suunatud rünne Kultuurimälestise, kiriku või muu religioosse tähendusega ehitise või objekti, kunsti- või teadusteose, kultuuriväärtusega arhiivi, raamatukogu, muuseumi või teaduslike kollektsioonide, mida ei kasutata sõjalisel otstarbel, hävitamise, kahjustamise või ebaseadusliku omastamise eest - karistatakse rahalise karistuse või ühe- kuni viieaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_106 (redaktsioon 992351)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "992351",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_106_v1027989"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-24",
        "@type": "xsd:date"
      }
    },
