        "@language": "et"
      },
      "estleg:versionRedactionId": "104042012003"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_178_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_178"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nooremat kui neljateistaastast isikut pornograafilises või erootilises situatsioonis kujutava pildi, kirjutise või muu teose või selle reproduktsiooni valmistamise või hoidmise, teisele isikule üleandmise, näitamise või muul viisil kättesaadavaks tegemise eest - karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_178 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_178_v1046806"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_178_v1046806",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_178"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nooremat kui kaheksateistaastast isikut pornograafilises või nooremat kui neljateistaastast isikut pornograafilises või erootilises situatsioonis kujutava pildi, kirjutise või muu teose või selle reproduktsiooni valmistamise või hoidmise, teisele isikule üleandmise, näitamise või muul viisil kättesaadavaks tegemise eest – karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_178 (redaktsioon 1046806)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046806",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_178_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_178_v13231473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_178"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nooremat kui kaheksateistaastast isikut pornograafilises või nooremat kui neljateistaastast isikut pornograafilises või erootilises situatsioonis kujutava pildi, kirjutise või muu teose või selle reproduktsiooni valmistamise või hoidmise, teisele isikule üleandmise, näitamise või muul viisil kättesaadavaks tegemise eest – karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_178 (redaktsioon 13231473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231473",
