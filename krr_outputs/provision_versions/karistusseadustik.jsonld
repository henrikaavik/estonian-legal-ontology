    {
      "@id": "estleg:KARIST_2_Osa2_Par_268_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_268"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootiliste või psühhotroopsete ainete ebaseaduslikuks tarvitamiseks või ebaseaduslike hasartmängude korraldamiseks või prostitutsiooniks ruumi kasutada andmise eest, samuti prostitutsiooni vahendamise eest - karistatakse rahalise karistuse või kuni viieaastase vangistusega. (2) Kohus võib kohaldada käesolevas paragrahvis sätestatud süüteo eest lisakaristusena varalist karistust vastavalt käesoleva seadustiku §-s 53 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_268 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_268_v1046806"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_268_v1046806",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_268"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootiliste või psühhotroopsete ainete ebaseaduslikuks tarvitamiseks või ebaseaduslike hasartmängude korraldamiseks ruumi kasutada andmise eest – karistatakse rahalise karistuse või kuni viieaastase vangistusega. (2) Kohus võib kohaldada käesolevas paragrahvis sätestatud süüteo eest lisakaristusena varalist karistust vastavalt käesoleva seadustiku §-s 53 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_268 (redaktsioon 1046806)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046806",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_268_v12775031"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_268_v12775031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_268"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootiliste või psühhotroopsete ainete ebaseaduslikuks tarvitamiseks või ebaseaduslike hasartmängude korraldamiseks ruumi kasutada andmise eest – karistatakse rahalise karistuse või kuni viieaastase vangistusega. (2) Käesolevas paragrahvis sätestatud kuriteo eest: võib kohus kohaldada lisakaristusena varalist karistust vastavalt käesoleva seadustiku §-s 53 sätestatule või kohaldab kohus kuriteoga saadud vara laiendatud konfiskeerimist vastavalt käesoleva seadustiku §-s 832 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_268 (redaktsioon 12775031)",
