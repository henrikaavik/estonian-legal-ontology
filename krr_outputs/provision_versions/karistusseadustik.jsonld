    {
      "@id": "estleg:KARIST_2_Osa1_Par_47_v109122010007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa1_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus või kohtuväline menetleja võib väärteo eest kohaldada rahatrahvi kolm kuni kolmsada trahviühikut. Trahviühik on rahatrahvi baassumma, mille suurus on neli eurot. (2) Juriidilisele isikule võib kohus või kohtuväline menetleja väärteo eest kohaldada rahatrahvi 32–32 000 eurot. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "KARIST_2_Osa1_Par_47 (redaktsioon 109122010007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109122010007",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa1_Par_47_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa1_Par_47_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa1_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus või kohtuväline menetleja võib väärteo eest kohaldada rahatrahvi kolm kuni kolmsada trahviühikut. Trahviühik on rahatrahvi baassumma, mille suurus on 4 eurot. (2) Juriidilisele isikule võib kohus või kohtuväline menetleja väärteo eest kohaldada rahatrahvi 100–400 000 eurot. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "KARIST_2_Osa1_Par_47 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa1_Par_47_v111032023010"
      },
      "estleg:versionValidTo": {
