        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Dokumendi või arhivaali ebaseadusliku hävitamise eest, kui sellega on tekitatud oluline kahju, – karistatakse rahalise karistuse või kuni kolmeaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_285 (redaktsioon 104042012003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104042012003"
