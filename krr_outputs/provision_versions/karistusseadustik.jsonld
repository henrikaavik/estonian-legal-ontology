    {
      "@id": "estleg:KARIST_2_Osa2_Par_93_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_93"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keemiarelva, bioloogilise või bakterioloogilise relva või muu rahvusvaheliselt keelustatud massihävitus- või muu relva või nende oluliste komponentide väljatöötamise, valmistamise, säilitamise, omandamise, edasiandmise, müümise või muul viisil kasutamiseks andmise või pakkumise eest - karistatakse kolme- kuni kaheteistaastase vangistusega. (2) Sama teo eest, kui see on toime pandud juriidilise isiku poolt, karistatakse rahalise karistuse või sundlõpetamisega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_93 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
