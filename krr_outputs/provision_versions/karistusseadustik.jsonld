      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võõrast hoonest, ruumist, sõidukist või piirdega alalt selle valdaja poolt esitatud lahkumise nõude ebaseadusliku täitmata jätmise eest – karistatakse rahatrahviga kuni sada trahviühikut või arestiga.",
