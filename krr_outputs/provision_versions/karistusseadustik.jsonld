        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_266_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_266"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valdaja tahte vastaselt hoonesse, ruumi, sõidukisse või piirdega alale ebaseadusliku tungimise või valdaja poolt esitatud sealt lahkumise nõude ebaseadusliku täitmata jätmise eest –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui: see on pandud toime elamiseks kasutatavasse ruumi tungimisega; see on pandud toime vägivallaga; on tungitud diplomaatilise puutumatusega maa-alale, hoonesse, ruumi või see on pandud toime maa-ala, hoone või ruumi hõivamise või korrapärase tegevuse takistamise eesmärgil, –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (3) Käesoleva paragrahvi lõikes 1 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot. (4) Käesoleva paragrahvi lõikes 2 sätestatud teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_266 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_267_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_267"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võõrast hoonest, ruumist, sõidukist või piirdega alalt selle valdaja poolt esitatud lahkumise nõude ebaseadusliku täitmata jätmise eest - karistatakse rahatrahviga kuni sada trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_267 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_267_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
