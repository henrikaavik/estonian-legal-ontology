        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_390_v12792390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_390"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_390 (redaktsioon 12792390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12792390",
