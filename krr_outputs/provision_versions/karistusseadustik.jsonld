    {
      "@id": "estleg:KARIST_2_Osa2_Par_424_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_424"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootorsõiduki juhtimise eest joobeseisundis isiku poolt, keda on varem karistatud sellise teo eest, - karistatakse rahalise karistuse või kuni kolmeaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_424 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_424_v13191170"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_424_v13191170",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_424"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootorsõiduki või trammi juhtimise eest joobeseisundis –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega., muudatust ei kohaldata tagasiulatuvalt isikutele, kelle suhtes jõustus kohtuotsus enne 1. juulit 2009. a",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_424 (redaktsioon 13191170)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13191170",
