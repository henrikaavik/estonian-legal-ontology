      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tõendi kõrvaldamise või kunstliku loomise eest eesmärgiga takistada kuriteona karistatava teo olemasolu või selle puudumise või muude tõendamiseseme asjaolude tuvastamist – karistatakse rahalise karistuse või ühe- kuni viieaastase vangistusega .",
