      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_255_v131122016014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
