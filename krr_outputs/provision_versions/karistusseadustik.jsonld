      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seaduses või kohtulahendis ettenähtud ettevõtluskeelu või teataval erialal või ametikohal töötamise keelu rikkumise eest, kui puudub käesoleva seadustiku §-s 329 sätestatud süüteokoosseis, - karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_373 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_373_v13087423"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-21",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_373_v13087423",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_373"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seaduses või kohtulahendis ettenähtud ärikeelu või teataval erialal või ametikohal töötamise keelu rikkumise eest, kui puudub käesoleva seadustiku §-s 329 sätestatud süüteokoosseis, –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_373 (redaktsioon 13087423)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13087423",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_373_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_373_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_373"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtulahendis ettenähtud ärikeelu või teataval erialal või ametikohal töötamise keelu rikkumise eest, kui puudub käesoleva seadustiku §-s 329 sätestatud süüteokoosseis, –karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_373 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_374_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_374"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käitlemiseks mittelubatud alkoholi valmistamise, villimise või töötlemise eest - karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega. (3) Kohus konfiskeerib käesolevas paragrahvis sätestatud süüteo toimepanemise vahetuks objektiks olnud aine või eseme.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_374 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
