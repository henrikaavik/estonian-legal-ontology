        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_245_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_245"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti lipu, riigivapi või muu ametliku sümboli maharebimise, purustamise, rüvetamise või muul viisil teotamise, samuti riigihümni teotamise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_245 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_246_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_246"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riikidevahelise organisatsiooni või üldtunnustatud valitsusvälise rahvusvahelise organisatsiooni esindaja või välisriigi kõrge riigitegelase või nimetatud isiku perekonnaliikme tapmise, pantvangi võtmise või temale tervisekahjustuse tekitamise eest - karistatakse kuue- kuni kahekümneaastase või eluaegse vangistusega. (2) Käesoleva paragrahvi lõiget 1 ei kohaldata, kui on aset leidnud Ühinenud Rahvaste Organisatsiooni Julgeolekunõukogu poolt ÜRO põhikirja VII peatüki alusel sanktsioneeritud relvajõudude kasutamist hõlmav operatsioon ning selles osalevad isikud on olnud võitlejad relvakonfliktis.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_246 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_246_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_246_v13231473",
