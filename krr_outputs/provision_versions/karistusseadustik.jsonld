    {
      "@id": "estleg:KARIST_2_Osa1_Par_43_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa1_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui süüteokatses osaleb mitu toimepanijat, loobub süüteokatsest isik, kes hoiab ära süüteo tagajärje. Kui tagajärg saabub või jääb ära sõltumatult toimepanija tegutsemisest, loobub toimepanija, kui ta tõsimeeli püüab takistada tagajärje saabumist.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa1_Par_43 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
