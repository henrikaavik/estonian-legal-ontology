        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_392_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_392"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_392 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_393_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_393"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tolliterritooriumil tollisoodustusega sisseveetud või tolli järelevalve all oleva kaubaga tehtavate ebaseaduslike toimingute või tehingute eest, kui toimingute või tehingute esemeks oli kaup suures koguses, - karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega. (3) Kohus võib kohaldada käesolevas paragrahvis sätestatud süüteo toimepanemise vahetuks objektiks olnud aine või eseme konfiskeerimist vastavalt käesoleva seadustiku §-s 83 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_393 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_393_v953207"
      },
      "estleg:versionValidTo": {
        "@value": "2004-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_393_v953207",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_393"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Ühenduse välisest riigist Eestisse tollisoodustusega toimetatud või tollijärelevalve all oleva kaubaga ebaseaduslike toimingute või tehingute tegemise eest, kui toimingute või tehingute esemeks oli kaup suures koguses või süüdlasele on sama teo eest kohaldatud väärteokaristust, – karistatakse rahalise karistuse või kuni kolmeaastase vangistusega . (2) Sama teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega. (3) Kohus võib kohaldada käesolevas paragrahvis sätestatud süüteo toimepanemise vahetuks objektiks olnud aine või eseme konfiskeerimist vastavalt käesoleva seadustiku §-s 83 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_393 (redaktsioon 953207)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "953207",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_393_v953222"
      },
      "estleg:versionValidTo": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      }
    },
