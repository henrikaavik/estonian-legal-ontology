    {
      "@id": "estleg:KARIST_2_Osa2_Par_405_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_405"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Plahvatuse tekitamise eest, kui sellega on põhjustatud oht inimese elule, tervisele või varale, - karistatakse rahalise karistuse või kuni viieaastase vangistusega. (2) Sama teo eest, kui on kasutatud lõhkeseadeldist või lõhkematerjali, - karistatakse viie- kuni kümneaastase vangistusega. (3) Sama teo eest tuumaenergia abil, ohtlikus ettevõttes või suurõnnetuse ohuga ettevõttes - karistatakse kaheksa- kuni kahekümneaastase või eluaegse vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_405 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_405_v12792390"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_405_v12792390",
