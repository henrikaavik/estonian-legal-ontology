      },
      "estleg:versionText": "Ebaseadusliku läbiotsimise või eluruumist väljatõstmise eest –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_314 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
