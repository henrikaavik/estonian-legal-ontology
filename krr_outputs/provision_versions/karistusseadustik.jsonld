      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_401 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_402_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_402"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juriidilise isiku juhatuse, seda asendava organi või nõukogu liikme poolt teisele ettevõtjale mõistlikel ja mittediskrimineerivatel tingimustel võrgustikule, infrastruktuurile või muule olulisele vahendile juurdepääsu mittelubamise eest, samuti muu tegevuse eest, millega on kaasnenud eri- või ainuõigust või olulist vahendit omava juriidilise isiku seaduses sätestatud kohustuse rikkumine, kui süüdlasele on sama teo eest kohaldatud väärteokaristust - karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_402 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_402_v207051"
      },
      "estleg:versionValidTo": {
        "@value": "2002-10-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_402_v207051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_402"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juriidilise isiku juhatuse, seda asendava organi või nõukogu liikme poolt teisele ettevõtjale mõistlikel ja mittediskrimineerivatel tingimustel võrgustikule, infrastruktuurile või muule olulisele vahendile juurdepääsu mittelubamise eest, samuti muu tegevuse eest, millega on kaasnenud eri- või ainuõigust või olulist vahendit omava juriidilise isiku seaduses sätestatud kohustuse rikkumine – karistatakse rahalise karistuse või kuni kolmeaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, - karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_402 (redaktsioon 207051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "207051",
