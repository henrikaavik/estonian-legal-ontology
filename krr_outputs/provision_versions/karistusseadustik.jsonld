      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_258_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_258"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi riigipiiri või ajutise kontrolljoone ebaseadusliku ületamise eest, kui see on toime pandud: piirivalveametniku peatumismärguande või käsu eiramisega; grupi poolt; transpordivahendiga selleks mitteettenähtud kohas või kui süüdlasele on sama teo eest kohaldatud väärteokaristust, -karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui see on toime pandud: vägivallaga või raske tervisekahjustuse tekitamisega, -karistatakse nelja- kuni kaheteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_258 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_258_v953236"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-17",
        "@type": "xsd:date"
      }
    },
