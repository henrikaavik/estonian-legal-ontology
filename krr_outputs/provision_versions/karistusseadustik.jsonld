      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahi alla võtmise, vahi all pidamise, kinnipidamise või sundtoomise eest kohtumenetluse tagamise eesmärgil, kui selleks puudusid seaduses ettenähtud alused, –karistatakse rahalise karistuse või kuni kolmeaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_313 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_313_v123122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
