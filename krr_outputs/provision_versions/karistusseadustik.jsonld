    {
      "@id": "estleg:KARIST_2_Osa2_Par_317_v123122014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_317"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Menetlusosalise, tunnistaja, eksperdi või tõlgi kohtueelsele või kohtumenetlusele ilmumise teadvalt takistamise eest, samuti samal eesmärgil nimetatud isiku teadvalt mõjutamise eest –karistatakse rahalise karistuse või kuni üheaastase vangistusega. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahalise karistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_317 (redaktsioon 123122014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014016"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_318_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_318"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kannatanu või tunnistaja poolt kohtueelsel või kohtumenetlusel ütluse andmisest aluseta keeldumise eest, kui teda oli eelnevalt hoiatatud, et sellise tegevuse eest on ette nähtud karistus, samuti tõlgi poolt oma ülesannete täitmisest alusetu keeldumise eest - karistatakse rahalise karistuse või kuni üheaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_318 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
