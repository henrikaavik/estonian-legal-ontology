    {
      "@id": "estleg:KARIST_2_Osa2_Par_421_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_421"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus võib kohaldada käesolevas jaos sätestatud süüteo toimepanemise vahetuks objektiks olnud eseme konfiskeerimist vastavalt käesoleva seadustiku §-s 83 sätestatule.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_421 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_422_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_422"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mootor-, õhu- või veesõiduki või trammi või raudteeveeremi juhi poolt liiklus- või käitusnõuete rikkumise eest, kui sellega on ettevaatamatusest tekitatud inimesele raske tervisekahjustus või põhjustatud inimese surm, - karistatakse kuni viieaastase vangistusega. (2) Sama teo eest, kui sellega on põhjustatud kahe või enama inimese surm, - karistatakse kolme- kuni kaheteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_422 (redaktsioon 184411)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184411",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_422_v13231473"
      },
      "estleg:versionValidTo": {
        "@value": "2009-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_422_v13231473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_422"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mootor-, õhu- või veesõiduki või trammi või raudteeveeremi juhi poolt liiklus- või käitusnõuete rikkumise eest, kui sellega on ettevaatamatusest tekitatud inimesele raske tervisekahjustus või põhjustatud inimese surm, – karistatakse kuni viieaastase vangistusega. (2) Sama teo eest, kui sellega on põhjustatud kahe või enama inimese surm, – karistatakse kolme- kuni kaheteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_422 (redaktsioon 13231473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13231473",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_422_v13326359"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_422_v13326359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_422"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mootor-, õhu- või veesõiduki või trammi või raudteeveeremi juhi poolt liiklus- või käitusnõuete rikkumise eest, kui sellega on ettevaatamatusest tekitatud inimesele raske tervisekahjustus või põhjustatud inimese surm, –karistatakse kuni viieaastase vangistusega. (2) Sama teo eest, kui sellega on põhjustatud kahe või enama inimese surm, –karistatakse kolme- kuni kaheteistaastase vangistusega.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_422 (redaktsioon 13326359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13326359",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_2_Osa2_Par_422_v107072017005"
      },
      "estleg:versionValidTo": {
        "@value": "2017-10-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_422_v107072017005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_2_Osa2_Par_422"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mootor-, õhu- või veesõiduki, maastikusõiduki või trammi või raudteeveeremi juhi poolt liiklus- või käitusnõuete rikkumise eest, kui sellega on ettevaatamatusest tekitatud inimesele raske tervisekahjustus või põhjustatud inimese surm, –karistatakse kuni viieaastase vangistusega. (2) Sama teo eest, kui: see on toime pandud joobeseisundis või sellega on põhjustatud kahe või enama inimese surm, −karistatakse kolme- kuni kaheteistaastase vangistusega. (3) Käesoleva paragrahvi lõike 2 punktis 1 sätestatud kuriteo korral: ei jäeta mõistetud karistust täielikult tingimisi kohaldamata; kohaldatakse lisakaristusena juhtimisõiguse äravõtmist.",
      "rdfs:label": {
        "@value": "KARIST_2_Osa2_Par_422 (redaktsioon 107072017005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072017005"
    },
    {
      "@id": "estleg:KARIST_2_Osa2_Par_423_v184411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
