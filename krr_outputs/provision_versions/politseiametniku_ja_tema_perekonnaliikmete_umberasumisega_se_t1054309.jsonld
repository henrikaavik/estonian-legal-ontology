        "@value": "Sätete redaktsioonid: Politseiametniku ja tema perekonnaliikmete ümberasumisega seotud kulude kompenseerimise ulatus ja kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Politseiametniku ja tema perekonnaliikmete ümberasumisega seotud kulude kompenseerimise ulatus ja kord"
    },
    {
      "@id": "estleg:Reg_1054309_Par_1_v1054309",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
