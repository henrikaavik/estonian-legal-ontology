      "@id": "estleg:Reg_1015353_Par_3_v1015353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015353_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1015353_Par_3 (redaktsioon 1015353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015353",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015353",
