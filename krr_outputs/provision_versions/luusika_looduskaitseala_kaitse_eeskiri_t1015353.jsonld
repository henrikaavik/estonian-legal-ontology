      "estleg:provisionRef": "Reg_1015353 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015353_Map"
      }
    },
    {
      "@id": "estleg:Reg_1015353_Par_2_v1015353",
