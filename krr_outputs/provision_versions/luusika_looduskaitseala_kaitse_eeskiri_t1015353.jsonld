      "estleg:provisionRef": "Reg_1015353 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015353_Map"
      }
    },
    {
      "@id": "estleg:Reg_1015353_Par_13_v1015353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015353_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine. Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_1015353_Par_13 (redaktsioon 1015353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015353",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015353",
