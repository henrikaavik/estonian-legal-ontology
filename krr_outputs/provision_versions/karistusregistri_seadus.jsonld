      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Karistusregistri andmeid töötlev või registriteateid väljastav isik on kohustatud hoidma saladuses talle tööülesannete täitmisel teatavaks saanud andmeid ka pärast nende töötlemisega seotud tööülesannete täitmist või teenistussuhte lõppemist ning täitma isikuandmete kaitse seaduses sätestatud isikuandmete töötlemise nõudeid.",
      "rdfs:label": {
