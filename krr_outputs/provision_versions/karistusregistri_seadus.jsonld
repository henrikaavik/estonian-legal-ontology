        "@type": "xsd:date"
      },
      "estleg:versionText": "Karistusregistri ametlik nimi on «Karistusregister».",
      "rdfs:label": {
        "@value": "KARIST_Par_3 (redaktsioon 13117975)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13117975",
