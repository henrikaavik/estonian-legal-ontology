      "estleg:versionRedactionId": "118032026030"
    },
    {
      "@id": "estleg:KARIST_Par_6_v22390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Karistusregistrit peetakse eesti keeles. (2) Dokumendid, mis ei ole eesti keeles, esitatakse registri volitatud töötlejale koos eestikeelse tõlkega.",
      "rdfs:label": {
        "@value": "KARIST_Par_6 (redaktsioon 22390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_Par_6_v129122011226"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_Par_6_v129122011226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantakse isiku karistusandmed järgmiste kohtulahendite ja ametnike otsuste alusel: jõustunud süüdimõistev kohtuotsus kriminaalasjas; kohtuvälise menetleja ja kohtu jõustunud otsus karistuse määramise või mõistmise kohta väärteoasjas, välja arvatud kohtuvälise menetleja otsus hoiatamismenetluses; kohtumäärus isikule psühhiaatrilise sundravi kohaldamise kohta; kohtumäärus nooremale kui kaheksateistaastasele isikule mõjutusvahendi kohaldamise kohta; kohtu või kohtuvälise menetleja otsus või määrus, mis põhineb käesoleva paragrahvi punktides 1–4 nimetatud otsusel või määrusel ning sisaldab käesoleva seaduse §-s 12 sätestatud andmeid; Vabariigi Presidendi otsus süüdimõistetu armuandmispalve läbivaatamise kohta; jõustunud süüdimõistev välisriigi kohtuotsus kriminaalasjas Eesti kodaniku või Eestis elamisluba või elamisõigust omava välismaalase suhtes, kelle karistusandmed on välisriik edastanud või kelle süüdimõistvat kohtuotsust on Eesti kohus tunnustanud.",
      "rdfs:label": {
        "@value": "KARIST_Par_6 (redaktsioon 129122011226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011226",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_Par_6_v105122017004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_Par_6_v105122017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantakse isiku karistusandmed järgmiste kohtulahendite ja ametnike otsuste alusel: jõustunud süüdimõistev kohtuotsus kriminaalasjas; kohtuvälise menetleja ja kohtu jõustunud otsus karistuse määramise või mõistmise kohta väärteoasjas, välja arvatud kohtuvälise menetleja otsus hoiatamismenetluses; kohtumäärus isikule psühhiaatrilise sundravi kohaldamise kohta; kehtetu - kohtu või kohtuvälise menetleja otsus või määrus, mis põhineb käesoleva paragrahvi punktides 1–4 nimetatud otsusel või määrusel ning sisaldab käesoleva seaduse §-s 12 sätestatud andmeid; Vabariigi Presidendi otsus süüdimõistetu armuandmispalve läbivaatamise kohta; jõustunud süüdimõistev välisriigi kohtuotsus kriminaalasjas Eesti kodaniku või Eestis elamisluba või elamisõigust omava välismaalase suhtes, kelle karistusandmed on välisriik edastanud või kelle süüdimõistvat kohtuotsust on Eesti kohus tunnustanud.",
      "rdfs:label": {
        "@value": "KARIST_Par_6 (redaktsioon 105122017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122017004"
    },
    {
      "@id": "estleg:KARIST_Par_7_v22390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi kohtus süüdi mõistetud Eesti kodaniku, alalise elaniku või Eestis registreeritud juriidilise isiku andmed kantakse karistusregistrisse Euroopa kriminaalkonventsioonide, välislepingu või riigiasutuste koostöölepinguga ettenähtud juhtudel ja korras.",
      "rdfs:label": {
        "@value": "KARIST_Par_7 (redaktsioon 22390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_Par_7_v1042871"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_Par_7_v1042871",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi kohtus süüdi mõistetud Eesti kodaniku, Eestis elamisluba või elamisõigust omava välismaalase või Eestis registreeritud juriidilise isiku andmed kantakse karistusregistrisse Euroopa kriminaalkonventsioonide, välislepingu või riigiasutuste koostöölepinguga ettenähtud juhtudel ja korras.",
      "rdfs:label": {
        "@value": "KARIST_Par_7 (redaktsioon 1042871)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042871",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_Par_7_v129122011226"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_Par_7_v129122011226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrisse kantud andmed on avalikud, välja arvatud seaduses sätestatud juhtudel. (2) Registri andmeid töödeldakse üksnes seaduses sätestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "KARIST_Par_7 (redaktsioon 129122011226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011226"
    },
    {
      "@id": "estleg:KARIST_Par_8_v22390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Karistusregister koosneb elektroonilistest registrikaartidest. (2) Registrikaardid on registrisse kantud tähestikujärjestuses füüsilise isiku perekonnanime ja juriidilise isiku ärinime esitähe järgi või elektroonilise registri unikaalse koodi alusel. (3) Karistusregistrist tehakse varukoopia, mida hoitakse kahjustumise eest kaitstud kohas. Varukoopiat kasutatakse ennetähtaegselt kustutatud või kahjustunud registriandmete taastamiseks.",
      "rdfs:label": {
        "@value": "KARIST_Par_8 (redaktsioon 22390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_Par_8_v129122011226"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KARIST_Par_8_v129122011226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrit peetakse eesti keeles. (2) Dokumendid, mis ei ole eesti keeles, esitatakse registri volitatud töötlejale koos eestikeelse tõlkega. (3) Euroopa Liidu õigusaktides sätestatud juhtudel võidakse registrile esitada andmeid ka muus keeles.",
      "rdfs:label": {
        "@value": "KARIST_Par_8 (redaktsioon 129122011226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011226"
    },
    {
      "@id": "estleg:KARIST_Par_9_v22390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Karistusregistri päevik sisaldab andmeid elektroonilisse registrisse tehtud kannete ja päringute kohta. (2) Karistusregistri päevikus registreeritakse järgmised andmed: kande või päringu esitanud asutuse kood; kande või päringu esitanud asutuse nimi; kande või päringu järjenumber; kande- või päringutegija nimi; kui kanne või päring tehti arvutilt, siis arvuti nimi; kande või päringu tegemise kuupäev; kande või päringu kohta käivad selgitused või märkused; kui kanne või päring on annulleeritud, siis vastav märge; kande või päringu kontrollimise kuupäev; kannet või päringut kontrollinud registri volitatud töötleja esindaja nimi.",
      "rdfs:label": {
        "@value": "KARIST_Par_9 (redaktsioon 22390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22390",
      "estleg:supersededByVersion": {
