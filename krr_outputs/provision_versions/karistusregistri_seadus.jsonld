      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Karistusregistri seadus (227 versiooni)",
        "@language": "et"
      },
      "dc:source": "Karistusregistri seadus"
    },
    {
      "@id": "estleg:KARIST_Par_1_v22390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KARIST_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Karistusregistri seadus sätestab füüsilise ja juriidilise isiku (edaspidi isik) käesolevas seaduses nimetatud andmete karistusregistrisse kandmise ja nende töötlemise ning karistusregistri pidamise üldalused. (2) Karistusregistri vastutav töötleja on Siseministeerium ning karistusregistri volitatud töötleja Politseiamet. (3) Karistusregistri pidamise täpsema korra ja registrikaardi vormi kehtestab siseminister.",
      "rdfs:label": {
        "@value": "KARIST_Par_1 (redaktsioon 22390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22390",
      "estleg:supersededByVersion": {
        "@id": "estleg:KARIST_Par_1_v728937"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      }
    },
