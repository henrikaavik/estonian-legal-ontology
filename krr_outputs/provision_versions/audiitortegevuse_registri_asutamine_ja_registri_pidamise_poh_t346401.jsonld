      }
    },
    {
      "@id": "estleg:Reg_346401_Par_15_v346401",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_346401_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri vastutaval ja volitatud töötlejal on lubatud seadusega või seaduse alusel antud õigusaktiga talle pandud ülesannete täitmiseks esitada päringuid teistesse riigi või kohaliku omavalitsuse andmekogudesse ja saada sealt andmeid. Registri vastutaval ja volitatud töötlejal on lubatud seadusega või seaduse alusel antud õigusaktiga talle pandud ülesannete täitmiseks esitada päringuid teistesse riigi või kohaliku omavalitsuse andmekogudesse ja saada sealt andmeid.",
      "rdfs:label": {
        "@value": "Reg_346401_Par_15 (redaktsioon 346401)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "346401",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/346401",
      "estleg:sourceAct": "Audiitortegevuse registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_346401 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_346401_Map"
      }
    },
    {
      "@id": "estleg:Reg_346401_Par_16_v346401",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
