      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registriandmetel on informatiivne tähendus, õiguslik tähendus on neil ainult seaduses sätestatud ulatuses. Registriandmetel on informatiivne tähendus, õiguslik tähendus on neil ainult seaduses sätestatud ulatuses.",
      "rdfs:label": {
        "@value": "Reg_346401_Par_4 (redaktsioon 346401)",
        "@language": "et"
      },
