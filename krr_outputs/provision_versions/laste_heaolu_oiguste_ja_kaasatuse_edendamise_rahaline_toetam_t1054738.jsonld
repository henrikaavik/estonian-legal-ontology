    {
      "@id": "estleg:Reg_1054738_Par_26_v1054738",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054738_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalministeerium on kohustatud: 1 1) säilitama vähese tähtsusega abi kava käsitlevaid andmeid kümne majandusaasta jooksul alates päevast, kui kava alusel viimati toetust anti; 2 2) kandma riigiabi ja vähese tähtsusega abi registrisse andmed antud vähese tähtsusega abi kohta; 3 3) teavitama toetuse saajat taotluse rahuldamise otsuses vähese tähtsusega abi andmisest. Sotsiaalministeerium on kohustatud: säilitama vähese tähtsusega abi kava käsitlevaid andmeid kümne majandusaasta jooksul alates päevast, kui kava alusel viimati toetust anti; kandma riigiabi ja vähese tähtsusega abi registrisse andmed antud vähese tähtsusega abi kohta; teavitama toetuse saajat taotluse rahuldamise otsuses vähese tähtsusega abi andmisest.",
      "rdfs:label": {
        "@value": "Reg_1054738_Par_26 (redaktsioon 1054738)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054738",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054738",
      "estleg:sourceAct": "Laste heaolu, õiguste ja kaasatuse edendamise rahaline toetamine",
      "estleg:provisionRef": "Reg_1054738 § 26",
