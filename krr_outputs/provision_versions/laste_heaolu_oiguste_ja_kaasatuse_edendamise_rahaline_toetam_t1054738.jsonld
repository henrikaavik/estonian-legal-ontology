      }
    },
    {
      "@id": "estleg:Reg_1054738_Par_27_v1054738",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054738_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sotsiaalministeeriumil on õigus kontrollida aruannetes esitatud teabe vastavust tegelikkusele ja toetuse kasutamise sihipärasust projekti elluviimise, toetuse saaja või partneri asukohas, teavitades toetuse saajat sellest ette. Sotsiaalministeeriumil on õigus kontrollida aruannetes esitatud teabe vastavust tegelikkusele ja toetuse kasutamise sihipärasust projekti elluviimise, toetuse saaja või partneri asukohas, teavitades toetuse saajat sellest ette. 2 (2) Sotsiaalministeeriumil on õigus nõuda toetus osaliselt või tervikuna tagasi, kui: 1 1) toetuse saaja on esitanud ebaõigeid või puudulikke andmeid ning õigete ja piisavate andmete korral oleks toetuse andmise kohta tehtud teistsugune otsus; 2 2) taotluses kirjeldatud tegevus on tähtajaks ellu viimata või on viidud ellu osaliselt; 3 3) taotluses kirjeldatud tulemusi ei ole tähtajaks saavutatud või on saavutatud osaliselt; 4 4) ilmneb asjaolu, mille tõttu tegevuste elluviimine ei ole otstarbekas või see on võimatu; 5 5) toetuse saaja ei ole täitnud omafinantseeringuga seotud nõudeid; 6 6) toetuse saaja või partner ei ole toetust kasutanud sihipäraselt; 7 7) toetuse saaja või partner ei võimalda või raskendab oluliselt toetuse kasutamise üle kontrolli tegemist; 8 8) toetuse saaja või partner rikub lepingust tulenevat kohustust; 9 9) toetuse saaja esitab avalduse toetuse kasutamisest loobumise kohta. Sotsiaalministeeriumil on õigus nõuda toetus osaliselt või tervikuna tagasi, kui: toetuse saaja on esitanud ebaõigeid või puudulikke andmeid ning õigete ja piisavate andmete korral oleks toetuse andmise kohta tehtud teistsugune otsus; taotluses kirjeldatud tegevus on tähtajaks ellu viimata või on viidud ellu osaliselt; taotluses kirjeldatud tulemusi ei ole tähtajaks saavutatud või on saavutatud osaliselt; ilmneb asjaolu, mille tõttu tegevuste elluviimine ei ole otstarbekas või see on võimatu; toetuse saaja ei ole täitnud omafinantseeringuga seotud nõudeid; toetuse saaja või partner ei ole toetust kasutanud sihipäraselt; toetuse saaja või partner ei võimalda või raskendab oluliselt toetuse kasutamise üle kontrolli tegemist; toetuse saaja või partner rikub lepingust tulenevat kohustust; toetuse saaja esitab avalduse toetuse kasutamisest loobumise kohta.",
      "rdfs:label": {
        "@value": "Reg_1054738_Par_27 (redaktsioon 1054738)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054738",
