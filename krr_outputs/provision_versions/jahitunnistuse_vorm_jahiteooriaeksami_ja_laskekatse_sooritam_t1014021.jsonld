      }
    },
    {
      "@id": "estleg:Reg_1014021_Par_16_v1014021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014021_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui eksamineeritav ei sooritanud jahiteooriaeksamit, võib ta esitada kirjaliku taotluse eksami kordamiseks komisjoni esimehe määratud ajal, kuid mitte varem kui seitse tööpäeva pärast eksami mittesooritamise päevast arvates. RT I 2023-03-14 19 114032023019 2023-03-17 Kui eksamineeritav ei sooritanud jahiteooriaeksamit, võib ta esitada kirjaliku taotluse eksami kordamiseks komisjoni esimehe määratud ajal, kuid mitte varem kui seitse tööpäeva pärast eksami mittesooritamise päevast arvates. 2 (2) Kui eksamineeritav ei sooritanud laskekatset, võib ta esitada kirjaliku taotluse katse kordamiseks komisjoni esimehe määratud ajal, kuid mitte varem kui seitse tööpäeva pärast katse mittesooritamise päevast arvates. RT I 2023-03-14 19 114032023019 2023-03-17 Kui eksamineeritav ei sooritanud laskekatset, võib ta esitada kirjaliku taotluse katse kordamiseks komisjoni esimehe määratud ajal, kuid mitte varem kui seitse tööpäeva pärast katse mittesooritamise päevast arvates.",
      "rdfs:label": {
        "@value": "Reg_1014021_Par_16 (redaktsioon 1014021)",
        "@language": "et"
      },
