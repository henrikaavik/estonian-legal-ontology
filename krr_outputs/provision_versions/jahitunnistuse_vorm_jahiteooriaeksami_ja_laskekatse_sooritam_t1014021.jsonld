    {
      "@id": "estleg:Reg_1014021_Par_19_v1014021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014021_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jahitunnistuse saamiseks välisriigis kehtiva jahitunnistuse alusel peab taotleja esitama tunnistuse andjale järgmised materjalid: 1 1) vabas vormis taotluse; 2 2) koopia temale välisriigis antud kehtivast jahitunnistusest. Jahitunnistuse saamiseks välisriigis kehtiva jahitunnistuse alusel peab taotleja esitama tunnistuse andjale järgmised materjalid: vabas vormis taotluse; koopia temale välisriigis antud kehtivast jahitunnistusest. 2 (2) Taotlus peab sisaldama: 1 1) taotleja ees- ja perekonnanime, isikukoodi või selle puudumisel sünniaega, elukohariiki ning kontaktandmeid; RT I 2023-03-14 19 114032023019 2023-03-17 2 2) taotluse esitamise kuupäeva ja taotleja allkirja. Taotlus peab sisaldama: taotleja ees- ja perekonnanime, isikukoodi või selle puudumisel sünniaega, elukohariiki ning kontaktandmeid; taotluse esitamise kuupäeva ja taotleja allkirja.",
      "rdfs:label": {
        "@value": "Reg_1014021_Par_19 (redaktsioon 1014021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014021",
      "estleg:sourceAct": "Jahitunnistuse vorm, jahiteooriaeksami ja laskekatse sooritamise ning jahitunnistuse taotlemise ja andmise kord, jahindusalasele koolitusele ja koolitajale esitatavad nõuded ning koolitamise kord",
      "estleg:provisionRef": "Reg_1014021 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014021_Map"
      }
    },
    {
      "@id": "estleg:Reg_1014021_Par_2_v1014021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
