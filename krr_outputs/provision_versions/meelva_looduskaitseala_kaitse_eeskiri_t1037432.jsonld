      "estleg:versionValidFrom": {
        "@value": "2017-01-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loodusliku sookoosluse taastamiseks on vajalik kraavide sulgemine. Loodusliku sookoosluse taastamiseks on vajalik kraavide sulgemine.",
      "rdfs:label": {
        "@value": "Reg_1037432_Par_8 (redaktsioon 1037432)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037432",
