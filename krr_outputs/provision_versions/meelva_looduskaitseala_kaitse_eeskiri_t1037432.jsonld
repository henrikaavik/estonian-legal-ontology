      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 7. märtsi 2016. a käskkirjaga nr 1-2/16/218 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 7. märtsi 2016. a käskkirjaga nr 1-2/16/218 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1037432_Par_13 (redaktsioon 1037432)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037432",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037432",
      "estleg:sourceAct": "Meelva looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1037432 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037432_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1037432_Par_14_v1037432",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
