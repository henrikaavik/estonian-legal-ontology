  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_menetlusabi_taotluse_ning_sellele_lisatava_teatise_naidisvor_t1017782_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Menetlusabi taotluse ning sellele lisatava teatise näidisvorm ja näidisvormis sisalduvate andmete loetelu (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Menetlusabi taotluse ning sellele lisatava teatise näidisvorm ja näidisvormis sisalduvate andmete loetelu"
    },
    {
      "@id": "estleg:Reg_1017782_Par_1_v1017782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017782_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Võimaluse korral kasutatakse menetlusabi taotlemiseks ning majandusliku seisundi kohta andmete esitamiseks taotluse ja teatise näidisvormi. Võimaluse korral kasutatakse menetlusabi taotlemiseks ning majandusliku seisundi kohta andmete esitamiseks taotluse ja teatise näidisvormi. 2 (2) Käesoleva määruse lisadena kehtestatakse järgmised näidisvormid: 1 1) füüsilise isiku menetlusabi taotluse ja sellele lisatava teatise näidisvorm (lisa 1); 2 2) juriidilise isiku menetlusabi taotluse ja sellele lisatava teatise näidisvorm (lisa 2). Käesoleva määruse lisadena kehtestatakse järgmised näidisvormid: füüsilise isiku menetlusabi taotluse ja sellele lisatava teatise näidisvorm (lisa 1); juriidilise isiku menetlusabi taotluse ja sellele lisatava teatise näidisvorm (lisa 2). 3 (3) Taotleja esitab taotluses ja teatises andmed võimalikult lühidalt ja täpselt, et anda ülevaade menetlusabi taotlemise asjaoludest ning varadest. Taotleja esitab taotluses ja teatises andmed võimalikult lühidalt ja täpselt, et anda ülevaade menetlusabi taotlemise asjaoludest ning varadest.",
      "rdfs:label": {
        "@value": "Reg_1017782_Par_1 (redaktsioon 1017782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017782",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017782",
      "estleg:sourceAct": "Menetlusabi taotluse ning sellele lisatava teatise näidisvorm ja näidisvormis sisalduvate andmete loetelu",
      "estleg:provisionRef": "Reg_1017782 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017782_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017782_Par_2_v1017782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017782_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Füüsilisest isikust taotleja esitab enda kohta järgmised andmed: 1 1) ees- ja perekonnanimi; 2 2) isikukood, selle puudumisel sünniaeg; 3 3) perekonnaseis; 4 4) õigusabikulude kindlustuse olemasolu; 5 5) elukoha aadressiandmed; 6 6) sidevahendite andmed; 7 7) haridus, tegevusala ja elukutse; 8 8) esindaja nimi, e-posti aadress ja telefoninumber juhul kui taotleja on alaealine või eestkostetav; 9 9) tööandjad ja muud isikud, kellelt taotleja on tulu saanud. Füüsilisest isikust taotleja esitab enda kohta järgmised andmed: ees- ja perekonnanimi; isikukood, selle puudumisel sünniaeg; perekonnaseis; õigusabikulude kindlustuse olemasolu; elukoha aadressiandmed; sidevahendite andmed; haridus, tegevusala ja elukutse; esindaja nimi, e-posti aadress ja telefoninumber juhul kui taotleja on alaealine või eestkostetav; tööandjad ja muud isikud, kellelt taotleja on tulu saanud. 2 (2) Juriidilisest isikust taotleja esitab enda kohta järgmised andmed: 1 1) ärinimi; 2 2) registrikood; 3 3) õigusabi kulude kindlustuse olemasolu; 4 4) aadressiandmed; 5 5) sidevahendite andmed; 6 6) tegevusala; 7 7) juriidilise isikuga seotud isikute nimed ja seosed; 8 8) selgitused, miks ei ole menetluskulude kandmine juriidilise isikuga seotud isikute poolt põhjendatud. Juriidilisest isikust taotleja esitab enda kohta järgmised andmed: ärinimi; registrikood; õigusabi kulude kindlustuse olemasolu; aadressiandmed; sidevahendite andmed; tegevusala; juriidilise isikuga seotud isikute nimed ja seosed; selgitused, miks ei ole menetluskulude kandmine juriidilise isikuga seotud isikute poolt põhjendatud. 3 (3) Juhul kui taotleja on sõlminud õigusabikulude kindlustuse, lisab ta teatisele kindlustuspoliisi ärakirja. Juhul kui taotleja on sõlminud õigusabikulude kindlustuse, lisab ta teatisele kindlustuspoliisi ärakirja.",
      "rdfs:label": {
        "@value": "Reg_1017782_Par_2 (redaktsioon 1017782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017782",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017782",
      "estleg:sourceAct": "Menetlusabi taotluse ning sellele lisatava teatise näidisvorm ja näidisvormis sisalduvate andmete loetelu",
      "estleg:provisionRef": "Reg_1017782 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017782_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017782_Par_3_v1017782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017782_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Füüsilisest isikust menetlusabi taotleja esitab temaga koos elavate perekonnaliikmete kohta järgmised andmed: 1 1) isiku ees- ja perekonnanimi; 2 2) isikukood, selle puudumisel sünniaeg; 3 3) suhe taotlejaga; 4 4) abikaasa või elukaaslase tegevusala. Füüsilisest isikust menetlusabi taotleja esitab temaga koos elavate perekonnaliikmete kohta järgmised andmed: isiku ees- ja perekonnanimi; isikukood, selle puudumisel sünniaeg; suhe taotlejaga; abikaasa või elukaaslase tegevusala.",
      "rdfs:label": {
        "@value": "Reg_1017782_Par_3 (redaktsioon 1017782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017782",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017782",
      "estleg:sourceAct": "Menetlusabi taotluse ning sellele lisatava teatise näidisvorm ja näidisvormis sisalduvate andmete loetelu",
      "estleg:provisionRef": "Reg_1017782 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017782_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017782_Par_4_v1017782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017782_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Füüsilisest isikust menetlusabi taotleja esitab enda ja temaga koos elavate perekonnaliikmete sissetulekute ning kulude kohta järgmised andmed: 1 1) saadud sissetulekud; 2 2) muud tööandjate ja teiste sissetuleku andjate antud hüved; 3 3) saadud ülalpidamismaksed; 4 4) vältimatud püsikulutused; 5 5) ülalpidamiskohustuste täitmiseks ettenähtud summad; 6 6) igakuised mõistlikud kulud eluasemele ja transpordile; 7 7) muud kulud; 8 8) kulude kandmise jaotus ja põhjendus. Füüsilisest isikust menetlusabi taotleja esitab enda ja temaga koos elavate perekonnaliikmete sissetulekute ning kulude kohta järgmised andmed: saadud sissetulekud; muud tööandjate ja teiste sissetuleku andjate antud hüved; saadud ülalpidamismaksed; vältimatud püsikulutused; ülalpidamiskohustuste täitmiseks ettenähtud summad; igakuised mõistlikud kulud eluasemele ja transpordile; muud kulud; kulude kandmise jaotus ja põhjendus.",
      "rdfs:label": {
        "@value": "Reg_1017782_Par_4 (redaktsioon 1017782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017782",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017782",
      "estleg:sourceAct": "Menetlusabi taotluse ning sellele lisatava teatise näidisvorm ja näidisvormis sisalduvate andmete loetelu",
      "estleg:provisionRef": "Reg_1017782 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017782_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017782_Par_5_v1017782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017782_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidilisest isikust menetlusabi taotleja esitab enda tulude ning kulude kohta järgmised andmed: 1 1) saadud tulud; 2 2) vältimatud püsikulutused; 3 3) taotlusele eelnenud kuue kuu jooksul tehtud väljamaksed ühingu liikmetele, osanikele või juhtorgani liikmetele; 4 4) ühingu liikmetele, osanikele ja juhtorgani liikmetele antud muud hüved. Juriidilisest isikust menetlusabi taotleja esitab enda tulude ning kulude kohta järgmised andmed: saadud tulud; vältimatud püsikulutused; taotlusele eelnenud kuue kuu jooksul tehtud väljamaksed ühingu liikmetele, osanikele või juhtorgani liikmetele; ühingu liikmetele, osanikele ja juhtorgani liikmetele antud muud hüved.",
      "rdfs:label": {
        "@value": "Reg_1017782_Par_5 (redaktsioon 1017782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017782",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017782",
      "estleg:sourceAct": "Menetlusabi taotluse ning sellele lisatava teatise näidisvorm ja näidisvormis sisalduvate andmete loetelu",
      "estleg:provisionRef": "Reg_1017782 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017782_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017782_Par_6_v1017782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017782_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja esitab enda ning füüsilisest isikust taotleja esitab ka temaga koos elavatele perekonnaliikmetele kuuluva vara kohta järgmised andmed: 1 1) andmed igapäevakasutuses oleva eluaseme kohta, sealhulgas asukoht, suurus, seisukord, liik, ja selle hetke turuväärtus eurodes; 2 2) andmed taotleja omandis oleva muu kinnisvara kohta, sealhulgas asukoht, suurus, seisukord, kasutusviis, liik, ja selle hetke turuväärtus eurodes ning põhjendused, miks ei ole võimalik seda kinnisvara võõrandada; 3 3) krediidiasutus, kus pangakonto on avatud, pangakontode numbrid, pangakonto omaniku nimi ja sellel olevate rahaliste vahendite väärtus eurodes; 4 4) väärtpaberite liigid, väljaandjad, kogused ja turuväärtused eurodes; 5 5) andmed taotlejate omandis olevate mootorsõidukite kohta, sealhulgas liik, registreerimisnumber, esmase registreerimise aasta, turuväärtus eurodes, ja põhjendused, miks ei ole võimalik neid mootorsõidukeid võõrandada, ning liisitud või muude kasutuses olevate mootorsõidukite kohta, sealhulgas liik, registreerimisnumber, esmase registreerimise aasta, turuväärtus eurodes; andmed taotleja omandis olevate, liisitud või muude kasutuses olevate mere- ja õhusõidukite kohta; 6 6) seosed äriühingute, ühistute ja mittetulundusühingutega; 7 7) muu oluline vara, sealhulgas sularaha, e-raha või muud maksevahendid, kollektsioonid, kunstiesemed, väärtasjad, ning selle harilik väärtus või turuväärtus eurodes. Taotleja esitab enda ning füüsilisest isikust taotleja esitab ka temaga koos elavatele perekonnaliikmetele kuuluva vara kohta järgmised andmed: andmed igapäevakasutuses oleva eluaseme kohta, sealhulgas asukoht, suurus, seisukord, liik, ja selle hetke turuväärtus eurodes; andmed taotleja omandis oleva muu kinnisvara kohta, sealhulgas asukoht, suurus, seisukord, kasutusviis, liik, ja selle hetke turuväärtus eurodes ning põhjendused, miks ei ole võimalik seda kinnisvara võõrandada; krediidiasutus, kus pangakonto on avatud, pangakontode numbrid, pangakonto omaniku nimi ja sellel olevate rahaliste vahendite väärtus eurodes; väärtpaberite liigid, väljaandjad, kogused ja turuväärtused eurodes; andmed taotlejate omandis olevate mootorsõidukite kohta, sealhulgas liik, registreerimisnumber, esmase registreerimise aasta, turuväärtus eurodes, ja põhjendused, miks ei ole võimalik neid mootorsõidukeid võõrandada, ning liisitud või muude kasutuses olevate mootorsõidukite kohta, sealhulgas liik, registreerimisnumber, esmase registreerimise aasta, turuväärtus eurodes; andmed taotleja omandis olevate, liisitud või muude kasutuses olevate mere- ja õhusõidukite kohta; seosed äriühingute, ühistute ja mittetulundusühingutega; muu oluline vara, sealhulgas sularaha, e-raha või muud maksevahendid, kollektsioonid, kunstiesemed, väärtasjad, ning selle harilik väärtus või turuväärtus eurodes.",
      "rdfs:label": {
        "@value": "Reg_1017782_Par_6 (redaktsioon 1017782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017782",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017782",
      "estleg:sourceAct": "Menetlusabi taotluse ning sellele lisatava teatise näidisvorm ja näidisvormis sisalduvate andmete loetelu",
      "estleg:provisionRef": "Reg_1017782 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017782_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017782_Par_7_v1017782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017782_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja esitab enda ning füüsilisest isikust taotleja esitab ka temaga koos elavate perekonnaliikmete varaliselt hinnatavate kohustuste kohta järgmised andmed: 1 1) kohustused krediidiasutuste ees, sealhulgas krediidiasutuse nimi, kohustuse liik, kohustatud isik, kohustuse lõpptähtaeg, kohustuse jääk eurodes, igakuise makse suurus; 2 2) kohustused muude võlausaldajate ees, sealhulgas võlausaldaja nimi, kohustatud isik, kohustuse suurus, kohustuse lõpptähtaeg, kohustuse jääk eurodes, igakuise makse suurus; 3 3) kindlustuslepingutest tulenevad kohustused, sealhulgas kindlustusandja nimi, kohustatud isik, igakuise makse suurus. Taotleja esitab enda ning füüsilisest isikust taotleja esitab ka temaga koos elavate perekonnaliikmete varaliselt hinnatavate kohustuste kohta järgmised andmed: kohustused krediidiasutuste ees, sealhulgas krediidiasutuse nimi, kohustuse liik, kohustatud isik, kohustuse lõpptähtaeg, kohustuse jääk eurodes, igakuise makse suurus; kohustused muude võlausaldajate ees, sealhulgas võlausaldaja nimi, kohustatud isik, kohustuse suurus, kohustuse lõpptähtaeg, kohustuse jääk eurodes, igakuise makse suurus; kindlustuslepingutest tulenevad kohustused, sealhulgas kindlustusandja nimi, kohustatud isik, igakuise makse suurus.",
      "rdfs:label": {
        "@value": "Reg_1017782_Par_7 (redaktsioon 1017782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017782",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017782",
      "estleg:sourceAct": "Menetlusabi taotluse ning sellele lisatava teatise näidisvorm ja näidisvormis sisalduvate andmete loetelu",
      "estleg:provisionRef": "Reg_1017782 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017782_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017782_Par_8_v1017782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
