      "estleg:provisionRef": "Reg_339593 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339593_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_339593_Par_12_v339593",
      "@type": [
        "owl:NamedIndividual",
