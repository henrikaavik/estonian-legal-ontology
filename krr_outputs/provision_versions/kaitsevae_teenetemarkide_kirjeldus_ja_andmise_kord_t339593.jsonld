      }
    },
    {
      "@id": "estleg:Reg_339593_Par_16_v339593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339593_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenetemärki võib kanda üksnes teenetemärgi kavaler. Teenetemärki võib kanda üksnes teenetemärgi kavaler. 2 (2) Teenetemärki kantakse kooskõlas teenetemärkide kandmise hea tavaga. Kaitseväelased peavad teenetemärgi kandmisel järgima vormikandmise korda. Teenetemärki kantakse kooskõlas teenetemärkide kandmise hea tavaga. Kaitseväelased peavad teenetemärgi kandmisel järgima vormikandmise korda. 3 (3) Pidulikul õhtuvormil ja erariietuse juures on lubatud kanda teenetemärgi miniatuuri. Pidulikul õhtuvormil ja erariietuse juures on lubatud kanda teenetemärgi miniatuuri. 4 (4) Välismaalased võivad kanda teenetemärki vastavalt päritoluriigis kehtivale korrale. Välismaalased võivad kanda teenetemärki vastavalt päritoluriigis kehtivale korrale. 5 (5) Käesolevas paragrahvis sätestatut kohaldatakse ka teenetemärgi miniatuuri kandmisele. Teenetemärki ja selle miniatuuri ei kanta samaaegselt. Käesolevas paragrahvis sätestatut kohaldatakse ka teenetemärgi miniatuuri kandmisele. Teenetemärki ja selle miniatuuri ei kanta samaaegselt.",
      "rdfs:label": {
        "@value": "Reg_339593_Par_16 (redaktsioon 339593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339593",
      "estleg:sourceAct": "Kaitseväe teenetemärkide kirjeldus ja andmise kord",
      "estleg:provisionRef": "Reg_339593 § 16",
      "estleg:partOfAct": {
