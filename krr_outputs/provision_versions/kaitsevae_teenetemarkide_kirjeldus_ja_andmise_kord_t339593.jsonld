      }
    },
    {
      "@id": "estleg:Reg_339593_Par_17_v339593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339593_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenetemärgi andnud isik võib teenetemärgi ära võtta, kui: 1 1) on jõustunud kohtuotsus, millega teenetemärgi kavaler mõistetakse süüdi tahtliku kuriteo toime panemises; 2 2) teenetemärgi kavaler on toime pannud teenistus- või töökohustuse jämeda rikkumise, vääritu teo või on kaotanud usalduse; 3 3) saavad teatavaks enne teenetemärgi andmist esinenud asjaolud, millest teadmise korral ei oleks teenetemärki antud või; 4 4) teenetemärgi kavaleri hilisem käitumine on olnud niivõrd vääritu, et see välistaks talle teenetemärgi andmise. Teenetemärgi andnud isik võib teenetemärgi ära võtta, kui: on jõustunud kohtuotsus, millega teenetemärgi kavaler mõistetakse süüdi tahtliku kuriteo toime panemises; teenetemärgi kavaler on toime pannud teenistus- või töökohustuse jämeda rikkumise, vääritu teo või on kaotanud usalduse; saavad teatavaks enne teenetemärgi andmist esinenud asjaolud, millest teadmise korral ei oleks teenetemärki antud või; teenetemärgi kavaleri hilisem käitumine on olnud niivõrd vääritu, et see välistaks talle teenetemärgi andmise. 2 (2) Isik, kellelt on teenetemärk ära võetud, peab teenetemärgi, lindilõike ja tunnistuse tagastama selle andmiseks pädevale isikule, arvestades § 10 lõigetes 2–5 sätestatut. Isik, kellelt on teenetemärk ära võetud, peab teenetemärgi, lindilõike ja tunnistuse tagastama selle andmiseks pädevale isikule, arvestades § 10 lõigetes 2–5 sätestatut.",
      "rdfs:label": {
        "@value": "Reg_339593_Par_17 (redaktsioon 339593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339593",
