    {
      "@id": "estleg:Reg_304117_Par_25_v304117",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_304117_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Põllumajandus- ja Toiduamet teostab põldtunnustamise tegevusloaga põldtunnustaja tehtud põldtunnustamise üle riiklikku järelevalvet vähemalt üks kord aastas 5% ulatuses. Põllumajandus- ja Toiduamet teostab põldtunnustamise tegevusloaga põldtunnustaja tehtud põldtunnustamise üle riiklikku järelevalvet vähemalt üks kord aastas 5% ulatuses. 2 (2) Põllumajandus- ja Toiduamet teostab tegevusloaga seemneproovi võtja sertifitseerimiseks esitatud seemnepartiide üle riiklikku järelevalvet vähemalt üks kord aastas 5% ulatuses. Põllumajandus- ja Toiduamet teostab tegevusloaga seemneproovi võtja sertifitseerimiseks esitatud seemnepartiide üle riiklikku järelevalvet vähemalt üks kord aastas 5% ulatuses. 3 (3) Põllumajandus- ja Toiduamet teostab automaatse proovivõtmisseadme kasutamise üle riiklikku järelevalvet vähemalt üks kord aastas. Põllumajandus- ja Toiduamet teostab automaatse proovivõtmisseadme kasutamise üle riiklikku järelevalvet vähemalt üks kord aastas. 4 (4) Põllumajandus- ja Toiduamet teostab seemnekontrolli laboratooriumis proovide analüüsimise üle riiklikku järelevalvet vähemalt üks kord aastas 5% ulatuses. RT I 2019-03-26 1 126032019001 2019-04-01 Põllumajandus- ja Toiduamet teostab seemnekontrolli laboratooriumis proovide analüüsimise üle riiklikku järelevalvet vähemalt üks kord aastas 5% ulatuses.",
      "rdfs:label": {
        "@value": "Reg_304117_Par_25 (redaktsioon 304117)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "304117",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/304117",
      "estleg:sourceAct": "Köögiviljakultuuride seemne kategooriad ning köögiviljakultuuride seemne tootmise ja turustamise nõuded",
      "estleg:provisionRef": "Reg_304117 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_304117_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_304117_Par_26_v304117",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_304117_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Enne 1. maid 2006. aastal kehtinud nõuete kohaselt märgistatud köögiviljakultuuride seemne pakendatud seemet võib turustada kuni kauba lõppemiseni. Enne 1. maid 2006. aastal kehtinud nõuete kohaselt märgistatud köögiviljakultuuride seemne pakendatud seemet võib turustada kuni kauba lõppemiseni. 2 (2) Määrust rakendatakse tagasiulatuvalt alates 1. maist 2006. aastal. Määrust rakendatakse tagasiulatuvalt alates 1. maist 2006. aastal. 3 (3) Enne 25. märtsi 2007. aastal kehtinud nõuete kohaselt märgistatud köögiviljakultuuride seemne pakendatud seemet võib turustada kuni etiketi kehtivusaja lõpuni. RTL 2007 24 429 12804828 2007-03-25 Enne 25. märtsi 2007. aastal kehtinud nõuete kohaselt märgistatud köögiviljakultuuride seemne pakendatud seemet võib turustada kuni etiketi kehtivusaja lõpuni. 4 (4) Hariliku tomati seemet, mille etiketil või pakendil on märgitud ladinakeelne liiginimi Lycopersicon esculentum Mill., võib turustada kuni etiketi kehtivusaja lõpuni või kuni sellele märgitud turustamise lõpptähtpäevani või kuni pakendite või pakendatud seemne lõppemiseni. RT I 2014-02-28 4 128022014004 2014-03-31 Hariliku tomati seemet, mille etiketil või pakendil on märgitud ladinakeelne liiginimi Lycopersicon esculentum Mill., võib turustada kuni etiketi kehtivusaja lõpuni või kuni sellele märgitud turustamise lõpptähtpäevani või kuni pakendite või pakendatud seemne lõppemiseni.",
      "rdfs:label": {
        "@value": "Reg_304117_Par_26 (redaktsioon 304117)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "304117",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/304117",
      "estleg:sourceAct": "Köögiviljakultuuride seemne kategooriad ning köögiviljakultuuride seemne tootmise ja turustamise nõuded",
      "estleg:provisionRef": "Reg_304117 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_304117_Map_2026"
      }
