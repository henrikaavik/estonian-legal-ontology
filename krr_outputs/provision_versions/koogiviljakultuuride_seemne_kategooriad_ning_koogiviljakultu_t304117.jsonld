      "estleg:provisionRef": "Reg_304117 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_304117_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_304117_Par_2_v304117",
      "@type": [
        "owl:NamedIndividual",
