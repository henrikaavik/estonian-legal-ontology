      "estleg:provisionRef": "Reg_304117 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_304117_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_304117_Par_12_v304117",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_304117_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seemne kvaliteeti vähendavaid taimekahjustajaid, sh laokahjureid, võib seemneproovis esineda võimalikult vähe. Seemne kvaliteeti vähendavaid taimekahjustajaid, sh laokahjureid, võib seemneproovis esineda võimalikult vähe.",
      "rdfs:label": {
        "@value": "Reg_304117_Par_12 (redaktsioon 304117)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "304117",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/304117",
      "estleg:sourceAct": "Köögiviljakultuuride seemne kategooriad ning köögiviljakultuuride seemne tootmise ja turustamise nõuded",
      "estleg:provisionRef": "Reg_304117 § 12",
