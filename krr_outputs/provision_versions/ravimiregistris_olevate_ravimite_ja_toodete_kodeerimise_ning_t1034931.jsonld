      "estleg:versionValidFrom": {
        "@value": "2026-03-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pakendikoodi kasutamine on kohustuslik kõikidele ravimi müügiloa hoidjatele, ravimi käitlemise tegevusluba omavatele isikutele ning ravimi, eritoidu ja toidulisandi hüvitamise otsuseid tegevatele isikutele vastavalt õigusaktides sätestatud korrale. Pakendikoodi kasutamine on kohustuslik kõikidele ravimi müügiloa hoidjatele, ravimi käitlemise tegevusluba omavatele isikutele ning ravimi, eritoidu ja toidulisandi hüvitamise otsuseid tegevatele isikutele vastavalt õigusaktides sätestatud korrale.",
      "rdfs:label": {
        "@value": "Reg_1034931_Par_7 (redaktsioon 1034931)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034931",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034931",
      "estleg:sourceAct": "Ravimiregistris olevate ravimite ja toodete kodeerimise ning pakendikoodi kasutamise kord",
      "estleg:provisionRef": "Reg_1034931 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1034931_Map"
      }
    },
    {
      "@id": "estleg:Reg_1034931_Par_8_v1034931",
      "@type": [
