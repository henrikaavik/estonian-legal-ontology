    {
      "@id": "estleg:Reg_1034931_Par_2_v1034931",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034931_Par_2"
