      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavara kaevandamine; 3 3) puidu kokku- ja väljavedu pinnast kahjustades; 4 4) biotsiidi ja taimekaitsevahendi kasutamine. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavara kaevandamine; puidu kokku- ja väljavedu pinnast kahjustades; biotsiidi ja taimekaitsevahendi kasutamine.",
      "rdfs:label": {
        "@value": "Reg_159009_Par_13 (redaktsioon 159009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159009",
      "estleg:sourceAct": "Rabivere maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159009 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159009_Map_2026"
      }
    },
    {
