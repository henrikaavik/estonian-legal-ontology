    },
    {
      "@id": "estleg:Reg_159009_Par_15_v159009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159009_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on poollooduslike koosluste ja looduslike rohumaade esinemisaladel nende ilme ja liigikoosseisu tagamiseks kohustuslik niitmine, karjatamine ja puu- ning põõsarinde harvendamine. Piiranguvööndis on poollooduslike koosluste ja looduslike rohumaade esinemisaladel nende ilme ja liigikoosseisu tagamiseks kohustuslik niitmine, karjatamine ja puu- ning põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_159009_Par_15 (redaktsioon 159009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159009",
      "estleg:sourceAct": "Rabivere maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159009 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159009_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_159009_Par_2_v159009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159009_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Rapla maakonnas Kohila vallas Adila, Hageri, Kadaka, Mälivere, Põikma, Rabivere ja Rootsi külas ning Rapla vallas Koigi, Kuku ja Röa külas. Kaitseala asub Rapla maakonnas Kohila vallas Adila, Hageri, Kadaka, Mälivere, Põikma, Rabivere ja Rootsi külas ning Rapla vallas Koigi, Kuku ja Röa külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_159009_Par_2 (redaktsioon 159009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159009",
