    },
    {
      "@id": "estleg:Reg_159009_Par_8_v159009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159009_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) tee, tehnovõrgu rajatise ja ehitise püstitamine, välja arvatud rajatiste püstitamine kaitseala tarbeks ja rajatiste hooldustööd; 4 4) olemasolevate maaparandussüsteemide hoiutööd ja veerežiimi taastamine. Sihtkaitsevööndis on keelatud: majandustegevus; loodusvarade kasutamine; tee, tehnovõrgu rajatise ja ehitise püstitamine, välja arvatud rajatiste püstitamine kaitseala tarbeks ja rajatiste hooldustööd; olemasolevate maaparandussüsteemide hoiutööd ja veerežiimi taastamine.",
      "rdfs:label": {
        "@value": "Reg_159009_Par_8 (redaktsioon 159009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159009",
