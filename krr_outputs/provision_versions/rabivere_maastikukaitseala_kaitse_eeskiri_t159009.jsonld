    {
      "@id": "estleg:Reg_159009_Par_12_v159009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159009_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) rajatiste rajamine kaitseala tarbeks; 2 2) uute hoonete ehitamine; 3 3) uuendusraie; 4 4) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: rajatiste rajamine kaitseala tarbeks; uute hoonete ehitamine; uuendusraie; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine.",
      "rdfs:label": {
        "@value": "Reg_159009_Par_12 (redaktsioon 159009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159009",
      "estleg:sourceAct": "Rabivere maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159009 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159009_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_159009_Par_13_v159009",
      "@type": [
        "owl:NamedIndividual",
