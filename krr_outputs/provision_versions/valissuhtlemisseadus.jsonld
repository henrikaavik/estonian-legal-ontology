      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisministeerium tagab jõustunud välislepingu teksti registreerimise Ühinenud Rahvaste Organisatsiooni Sekretariaadis.",
      "rdfs:label": {
        "@value": "VALISS_Par_31 (redaktsioon 22264)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22264",
