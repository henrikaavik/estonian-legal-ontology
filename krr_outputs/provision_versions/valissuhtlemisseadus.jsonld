        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISS_Par_27_v107052025002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ratifitseeritud välislepingu denonsseerimise otsustab Riigikogu Vabariigi Valitsuse ettepanekul. (2) Käesoleva paragrahvi lõikes 1 nimetamata välislepingu lõpetamise või sellest taganemise otsustab Vabariigi Valitsus. (3) Välislepingu denonsseerimisest, lõpetamisest või sellest taganemisest teatab teisele lepingupoolele või hoiulevõtjale Välisministeerium.",
      "rdfs:label": {
        "@value": "VALISS_Par_27 (redaktsioon 107052025002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107052025002"
    },
    {
      "@id": "estleg:VALISS_Par_28_v22264",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välislepingu kehtivus lõpeb lepingus ettenähtud või rahvusvahelise õiguse normidega sätestatud viisil.",
      "rdfs:label": {
        "@value": "VALISS_Par_28 (redaktsioon 22264)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22264",
      "estleg:supersededByVersion": {
