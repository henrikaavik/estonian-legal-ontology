        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2007. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "VALISS_Par_36 (redaktsioon 1044462)",
        "@language": "et"
