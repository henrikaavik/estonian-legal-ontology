    },
    {
      "@id": "estleg:VALISS_Par_31_v1044462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valitsusasutus teatab sõlmitud ametkondlikust välislepingust Välisministeeriumile. (2) valitsusasutuse ametkondlikust välislepingust teatamise korra.",
      "rdfs:label": {
        "@value": "VALISS_Par_31 (redaktsioon 1044462)",
        "@language": "et"
      },
