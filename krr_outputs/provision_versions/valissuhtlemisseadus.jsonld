      },
      "estleg:versionRedactionId": "107052025002"
    },
    {
      "@id": "estleg:VALISS_Par_32_v1044462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametkondliku välislepingu muutmise, peatamise või lõpetamise otsustab asjaomane riigiasutus või omavalitsusüksus rahvusvahelise õiguse ja ametkondliku välislepingu kohaselt.",
      "rdfs:label": {
        "@value": "VALISS_Par_32 (redaktsioon 1044462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044462",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISS_Par_32_v107052025002"
      },
      "estleg:versionValidTo": {
        "@value": "2025-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISS_Par_32_v107052025002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametkondliku välislepingu muutmise, peatamise või lõpetamise otsustab asjaomane riigiasutus, omavalitsusüksus või avalik-õiguslik juriidiline isik rahvusvahelise õiguse ja ametkondliku välislepingu kohaselt.",
      "rdfs:label": {
        "@value": "VALISS_Par_32 (redaktsioon 107052025002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107052025002"
    },
    {
      "@id": "estleg:VALISS_Par_33_v1044462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisteenistuse seaduse (RT I 2006, 26, 193) § 28 muudetakse ja sõnastatakse järgmiselt: « § 28. Erakorralise ja täievolilise suursaadiku kohta teenistusalaste käskkirjade andmine Vabariigi Presidendi nimetatud erakorralise ja täievolilise suursaadiku kohta annab teenistusalased käskkirjad välisminister.»",
      "rdfs:label": {
        "@value": "VALISS_Par_33 (redaktsioon 1044462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044462"
    },
