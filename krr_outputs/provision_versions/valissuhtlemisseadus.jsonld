      }
    },
    {
      "@id": "estleg:VALISS_Par_30_v1044462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametkondlik välisleping avaldatakse asjaomase riigiasutuse või omavalitsusüksuse veebilehel või ametlikus väljaandes, kui ametkondlikus välislepingus ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "VALISS_Par_30 (redaktsioon 1044462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044462",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISS_Par_30_v107052025002"
      },
      "estleg:versionValidTo": {
        "@value": "2025-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISS_Par_30_v107052025002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametkondlik välisleping avaldatakse asjaomase riigiasutuse, omavalitsusüksuse või avalik-õigusliku juriidilise isiku veebilehel, kui ametkondlikus välislepingus ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "VALISS_Par_30 (redaktsioon 107052025002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107052025002"
    },
    {
      "@id": "estleg:VALISS_Par_31_v22264",
      "@type": [
        "owl:NamedIndividual",
