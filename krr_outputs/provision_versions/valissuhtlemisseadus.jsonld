      }
    },
    {
      "@id": "estleg:VALISS_Par_5_v121062014010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi välisesindus (edaspidi välisesindus) on välisriigis asuv Välisministeeriumi struktuuriüksus, kes teostab välissuhtlemist asukohariigis või rahvusvahelises organisatsioonis käesoleva seaduse, oma põhimääruse ja teiste Eesti Vabariigi õigusaktide alusel ning lähtub oma tegevuses rahvusvahelisest õigusest. (2) Välisesindus on: diplomaatiline esindus; konsulaarasutus; erimissioon, mille moodustab Vabariigi Valitsus eriülesande täitmiseks. (3) Diplomaatiline esindus on: suursaatkond; alaline esindus. (4) Välisesinduse juurde kuulub esinduse juhi residents. Residentsi kasutamise, sisustamise ja kulude hüvitamise alused ning korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "VALISS_Par_5 (redaktsioon 121062014010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014010",
