      }
    },
    {
      "@id": "estleg:Reg_1062486_Par_9_v1062486",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062486_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Projekti abikõlblikkuse periood on kuus kuud, abikõlblikkuse perioodi alguskuupäev avaldatakse taotlusvooru avamise teates. Projekti abikõlblikkuse periood on kuus kuud, abikõlblikkuse perioodi alguskuupäev avaldatakse taotlusvooru avamise teates. 2 (2) Projekti abikõlblikkuse periood on toetuse taotluse rahuldamise otsuses sätestatud ajavahemik, millal algavad ja lõpevad projekti tegevused ning tekivad projekti elluviimiseks vajalikud kulud. Projekti abikõlblikkuse periood on toetuse taotluse rahuldamise otsuses sätestatud ajavahemik, millal algavad ja lõpevad projekti tegevused ning tekivad projekti elluviimiseks vajalikud kulud.",
