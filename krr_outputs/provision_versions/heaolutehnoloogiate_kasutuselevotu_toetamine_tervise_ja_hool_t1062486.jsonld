      "estleg:versionText": "Taotlejale ja partnerile kohaldatakse §-s 10 sätestatut. Taotlejale ja partnerile kohaldatakse §-s 10 sätestatut.",
      "rdfs:label": {
        "@value": "Reg_1062486_Par_16 (redaktsioon 1062486)",
        "@language": "et"
      },
