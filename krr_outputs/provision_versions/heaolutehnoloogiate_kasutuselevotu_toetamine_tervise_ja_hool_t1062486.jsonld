      "estleg:provisionRef": "Reg_1062486 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062486_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1062486_Par_15_v1062486",
