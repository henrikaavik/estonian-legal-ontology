      "estleg:provisionRef": "Reg_1062486 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062486_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1062486_Par_31_v1062486",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
