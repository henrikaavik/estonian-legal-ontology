        "@value": "2025-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse maksimaalne osakaal on 100% abikõlblike kulude maksumusest, millest 70% moodustavad Euroopa Regionaalarengu Fondi vahendid ja 30% riiklik kaasfinantseering. Toetuse maksimaalne osakaal on 100% abikõlblike kulude maksumusest, millest 70% moodustavad Euroopa Regionaalarengu Fondi vahendid ja 30% riiklik kaasfinantseering.",
      "rdfs:label": {
        "@value": "Reg_1062486_Par_8 (redaktsioon 1062486)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062486",
