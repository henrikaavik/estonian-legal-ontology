      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arestialuse vabastamise tähtpäeva arvutab ametnik isiku vanglasse saabumise päeval. , rakendatakse tagasiulatuvalt alates 04.03.2021",
      "rdfs:label": {
        "@value": "Reg_162145_Par_24_30 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 24_30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_24_31_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_24_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arestialusele ei väljastata vabastamisõiendit. , rakendatakse tagasiulatuvalt alates 04.03.2021",
      "rdfs:label": {
        "@value": "Reg_162145_Par_24_31 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 24_31",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_24_32_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_24_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arestialune kinnitab isiklike dokumentide kättesaamist oma allkirjaga kinnipidamise dokumendil.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_24_32 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 24_32",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_24_33_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_24_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vangistusseaduse § 881 lõikes 31 sätestatud ühistranspordikulude hüvitamise määra arvutamisel lähtutakse §-des 231 ja 232 sätestatust. , rakendatakse tagasiulatuvalt alates 04.03.2021",
      "rdfs:label": {
        "@value": "Reg_162145_Par_24_33 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 24_33",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_25_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnipeetava kinnipidamisaeg lõpeb lühiajalise väljasõidu või lühiajalise väljaviimise ajal, edastatakse vabastamisõiend ja kinnipeetava isiklikud dokumendid väljasõidukoha politseiasutusele, kes annab need isikule kätte.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_25 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_26_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Psüühilist haigust põdeva ja pärast vabastamist psühhiaatriahaiglasse saadetava või eestkoste või hoole alla antava kinnipeetava isiklikud dokumendid ning vabastamisõiend antakse allkirja vastu üle haigla administratsioonile, eestkostjale või hooldajale.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_26 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_27_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtusaalis vabastatud kinnipeetavale annab tema soovil tagantjärele vabastamisõiendi vanglateenistuse ametnik, kui isikul puudub rahvastikuregistri andmetel kehtiv isikut tõendav dokument.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_27 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_28_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabastamisõiendi kaotamise korral annab ametnik vabastatule tema kirjaliku taotluse alusel tõendi vanglas viibimise kohta.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_28 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_29_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_162145_Par_29 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_3_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava vanglast vabastamise korda kohaldatakse ka vahistatule, kui seadusega või selle korraga ei ole ette nähtud teisiti.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_3 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_30_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Reg_162145_Par_30 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_4_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava vabastamise tähtpäeva, välja arvatud vangistuse ositi kandmise puhul, arvutab ametnik kinnipeetava vanglasse saabumise päeval. Tähtpäev märgitakse kinnipeetavate, vahistatute, arestialuste ja kriminaalhooldusaluste andmekogusse. Kui kohtuotsus või -määrus saabub vanglasse pärast tööpäeva lõppu, arvutatakse vabastamistähtpäev järgmise tööpäeva hommikul.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_4 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_4_4_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_4_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui vanglasse vastu võetud kinnipeetaval puuduvad isikut tõendavad dokumendid, esitab ametnik kuu aja jooksul Politsei- ja Piirivalveametile päringu, et välja selgitada kinnipeetavale Politsei- ja Piirivalveameti välja antud isikut tõendavate dokumentide olemasolu.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_4_4 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 4_4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_4_5_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_4_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vangla sotsiaaltöötaja esitab vähemalt kuus kuud enne elamisloata või tähtaegse elamisloaga välismaalasest kinnipeetava vanglast vabanemist või võimalikku tingimisi ennetähtaegset vabastamist Politsei- ja Piirivalveameti viisa- ja illegaalse immigratsiooni osakonnale päringu, et välja selgitada välismaalasest kinnipeetavale elamisloa andmine või tema väljasaatmine. Päring peab sisaldama järgmisi andmeid kinnipeetava kohta: 1) ees- ja perekonnanimi; 2) isanimi; 3) sugu; 4) sünniaeg või isikukood; 5) sünnikoht; 6) kodakondsus ja andmed isikut tõendava dokumendi kohta; 7) vabanemise või tingimisi enne tähtaega vabastamise kuupäev; 8) teadaolevad lähedaste kontaktandmed Eestis ja välisriigis; 9) teadaolevad elukohad.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_4_5 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 4_5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_4_6_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_4_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametnik esitab viis tööpäeva enne elamisloata välismaalasest kinnipeetava vabanemist või tingimisi ennetähtaegset vabastamist Politsei- ja Piirivalveametile vabastamise kuupäeva ja koha andmed.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_4_6 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 4_6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_5_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabastamisdokumendi või vangistuse lühendamise dokumendi (edaspidi vabastamisdokument) vanglasse saabumise korral kontrollib ametnik vabastamisdokumendi sisu ja dokumendi vorminõuete täitmist ning võrdleb vabastamisdokumendis sisalduvaid andmeid kinnipeetavate, vahistatute, arestialuste ja kriminaalhooldusaluste andmekogus (edaspidi vangiregister) esitatud andmetega.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_5 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_6_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teise vanglasse ümberpaigutatud kinnipeetava vabastamisdokument saadetakse viivitamata kinnipeetavale järele.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_6 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_7_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabastamisdokumendi õigsuse kontrollimiseks teeb ametnik järelepärimise vabastamisdokumendi saatnud asutusele, kui: 1) vabastamisdokument ei ole vahetult saabunud otsuse teinud asutuselt; 2) vabastamisdokument ei ole digitaalselt allkirjastatud, selle digitaalallkiri ei ole kehtiv või selle on digitaalselt allkirjastatuna saatnud asutus, kes ei ole otsust teinud; 4) kinnipeetava kohta vabastamisdokumendis esitatud andmed ei ole kooskõlas kinnipeetava andmetega vangiregistris; 5) ametnik kahtleb vabastamisdokumendi ehtsuses.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_7 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_8_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabastamisdokument tehakse vabastatavale isikule viivitamata teatavaks elektroonselt selleks ettenähtud tehnikavahendi kaudu või suuliselt vanglateenistuse ametniku poolt.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_8 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
