      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva korraga reguleeritakse kinnipeetava ja arestialuse vanglast vabastamist ja vabastamisega seotud dokumentide vormistamist. , rakendatakse tagasiulatuvalt alates 04.03.2021",
      "rdfs:label": {
        "@value": "Reg_162145_Par_1 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_10_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vahistatu surmast või vabastamisest kautsjoni vastu teavitatakse menetlejat, kelle menetluses kriminaalasi on.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_10 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_11_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava vanglast vabastamisel karistusaja lõppedes antakse talle vanglast vabastamise õiend (edaspidi vabastamisõiend), kui tal puudub rahvastikuregistri andmetel kehtiv isikut tõendav dokument. Vangla ei anna isikule vabastamisõiendit, kui:1) isik vabaneb arestikandmisest; 2) isik suunatakse vanglast ajutiselt teise asutusse ja tema karistusaeg jätkub; 3) isik suunatakse välisriiki ajutise loovutusega ja tema karistusaeg jätkub.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_11 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_11_14_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_11_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vabastamisõiendile (lisa 1) kantakse järgmised andmed: 1 1) õiendi väljaandnud vangla nimetus; 2 2) õiendi number; 3 3) kinnipeetava ees- ja perekonnanimi; 4 4) kinnipeetava sünniaeg või isikukood; 5 5) kinnipeetava foto; 6 6) kinnipeetava allkiri; 7 7) õiendi väljaandmise kuupäev; 8 8) õiendi kehtivusaeg; 9 9) kinnipidamise algus- ja lõppkuupäev; 10 10) õiendi väljaandja ees- ja perekonnanimi; 11 11) õiendi väljaandja ametinimetus; 12 12) õiendi väljaandja allkiri. Vabastamisõiendile (lisa 1) kantakse järgmised andmed: õiendi väljaandnud vangla nimetus; õiendi number; kinnipeetava ees- ja perekonnanimi; kinnipeetava sünniaeg või isikukood; kinnipeetava foto; kinnipeetava allkiri; õiendi väljaandmise kuupäev; õiendi kehtivusaeg; kinnipidamise algus- ja lõppkuupäev; õiendi väljaandja ees- ja perekonnanimi; õiendi väljaandja ametinimetus; õiendi väljaandja allkiri. 2 (2) Vabastamisõiendi vorm on ühepoolne taustamustriga helesinisest paberist blankett mõõtmetega 147 × 210 mm, millele on kujunduselemendina trükitud sõna „VABASTAMISÕIEND” ja vanglateenistuse vapi kujutis. Vabastamisõiendi vasaku serva ülaosas on turvaelemendina hõbedane väikese riigivapi kujutis. Vabastamisõiendi vorm on ühepoolne taustamustriga helesinisest paberist blankett mõõtmetega 147 × 210 mm, millele on kujunduselemendina trükitud sõna „VABASTAMISÕIEND” ja vanglateenistuse vapi kujutis. Vabastamisõiendi vasaku serva ülaosas on turvaelemendina hõbedane väikese riigivapi kujutis. 3 (3) Vabastamisõiend kinnitatakse Viru Vangla haldusosakonna juhataja või tema määratud vanglateenistuja ja kinnipeetava allkirjaga. Foto kinnitatakse vangla pitseriga. RT I 2025-12-20 4 120122025004 2025-12-23 Vabastamisõiend kinnitatakse Viru Vangla haldusosakonna juhataja või tema määratud vanglateenistuja ja kinnipeetava allkirjaga. Foto kinnitatakse vangla pitseriga.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_11_14 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 11_14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
