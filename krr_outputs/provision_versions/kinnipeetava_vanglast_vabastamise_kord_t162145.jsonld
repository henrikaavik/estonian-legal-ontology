      }
    },
    {
      "@id": "estleg:Reg_162145_Par_18_20_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_18_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabastamisõiend kehtib kuni kuus kuud.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_18_20 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 18_20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_19_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava vanglast vabastamisel küsib ametnik temalt suuliselt isikuandmeid ja võrdleb neid vangiregistri andmetega. Fotot ja eritunnuste kirjeldust võrreldakse kinnipeetavaga.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_19 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_2_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava ja arestialuse vabastamise arvestust peab kinnipeetavate arvestusega tegelev ametnik või töötaja (edaspidi ametnik). , rakendatakse tagasiulatuvalt alates 04.03.2021",
      "rdfs:label": {
        "@value": "Reg_162145_Par_2 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_20_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetava vanglast vabastamisel antakse talle tema isikut tõendavad dokumendid, mille kätteandmise kohta teeb ametnik märke vangiregistrisse. Kui kinnipeetaval on vanglast vabastamise hetkel olemas paberkandjal isiklik toimik, kinnitab ta isiklike dokumentide kättesaamist oma allkirjaga toimiku tagumise kaane siseküljel.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_20 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_21_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnipeetaval puudub vanglast vabastamise hetkel isikut tõendav dokument, antakse talle vabastamisõiend, mille ta kinnitab allkirjaga.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_21 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_22_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_162145_Par_22 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_23_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametnik teeb kinnipeetava vabastamise järel viivitamata vastava sissekande vangiregistrisse.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_23 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_23_26_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_23_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "«Vangistusseaduse» § 75 lõike 4 alusel kehtestatud toetuse määrad on järgmised:1) 15 eurot, kui kinnipeetava tegelik elukoht on samas linnas või vallas, kus asub vangla, kust kinnipeetav vabastatakse;2) 25 eurot, kui kinnipeetava tegelik elukoht on vallas või linnas, mille keskus on kuni 250 kilomeetri kaugusel vanglast, kust kinnipeetav vabastatakse;3) 35 eurot, kui kinnipeetava tegelik elukoht on vallas või linnas, mille keskus on üle 250 kilomeetri kaugusel vanglast, kust kinnipeetav vabastatakse.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_23_26 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
      "estleg:sourceAct": "Kinnipeetava vanglast vabastamise kord",
      "estleg:provisionRef": "Reg_162145 § 23_26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_162145_Map"
      }
    },
    {
      "@id": "estleg:Reg_162145_Par_23_27_v162145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_162145_Par_23_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvis 231 nimetatud tegeliku elukoha all mõistetakse kinnipeetava poolt vabastamise ettevalmistuse ajal määratud elukohta. Juhul kui vanglateenistusel tekib kahtlus, et tegemist ei ole kinnipeetava tegeliku elukohaga, siis on kinnipeetaval tõendamiskohustus ning vanglateenistusel on õigus kinnipeetava väidete õigsust kontrollida.",
      "rdfs:label": {
        "@value": "Reg_162145_Par_23_27 (redaktsioon 162145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "162145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/162145",
