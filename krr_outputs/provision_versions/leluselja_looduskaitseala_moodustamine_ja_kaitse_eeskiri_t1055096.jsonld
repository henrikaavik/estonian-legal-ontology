      }
    },
    {
      "@id": "estleg:Reg_1055096_Par_9_v1055096",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055096_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hiiumaa Rajooni TSN Täitevkomitee 28. mai 1958. a otsuse nr 34 „Looduskaitse korraldamisest Hiiumaa rajoonis” lisa 1 alajaotise I „Looduskaitselise tähtsusega alad” punkt 6 „Jugapuu alusmets – Putkaste Metskonna Leluselja vahtkonnas kv. nr 155 lit. 14 ja 16 – 2,5 ha territooriumil” tunnistatakse kehtetuks. Hiiumaa Rajooni TSN Täitevkomitee 28. mai 1958. a otsuse nr 34 „Looduskaitse korraldamisest Hiiumaa rajoonis” lisa 1 alajaotise I „Looduskaitselise tähtsusega alad” punkt 6 „Jugapuu alusmets – Putkaste Metskonna Leluselja vahtkonnas kv. nr 155 lit. 14 ja 16 – 2,5 ha territooriumil” tunnistatakse kehtetuks.",
      "rdfs:label": {
