        "@id": "estleg:Reg_1055096_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055096_Par_10_v1055096",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055096_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 7. aprilli 2021. a käskkirjaga nr 1-2/21/183 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 7. aprilli 2021. a käskkirjaga nr 1-2/21/183 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1055096_Par_10 (redaktsioon 1055096)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055096",
