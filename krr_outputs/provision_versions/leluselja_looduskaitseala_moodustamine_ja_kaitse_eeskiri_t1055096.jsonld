      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Leluselja looduskaitseala moodustamine ja kaitse-eeskiri (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Leluselja looduskaitseala moodustamine ja kaitse-eeskiri"
