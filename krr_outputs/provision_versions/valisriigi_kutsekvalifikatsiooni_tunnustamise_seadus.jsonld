      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "VKT_Par_40 (redaktsioon 121122013003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122013003"
    },
    {
      "@id": "estleg:VKT_Par_41_v12988434",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKT_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2008. aasta 1. juulil. (2) Käesoleva seaduse § 35 jõustub 2008. aasta 1. septembril.",
      "rdfs:label": {
