      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Suurema rahapesuohuga või terrorismi rahastamise ohuga riikide ja Eestiga justiits-, julgeoleku- või õiguskaitsealase koostöösuhteta riikide loetelu ning nende riikide kodanikele e-residendi digitaalse isikutunnistuse väljaandmise erisused (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Suurema rahapesuohuga või terrorismi rahastamise ohuga riikide ja Eestiga justiits-, julgeoleku- või õiguskaitsealase koostöösuhteta riikide loetelu ning nende riikide kodanikele e-residendi digitaalse isikutunnistuse väljaandmise erisused"
    },
    {
      "@id": "estleg:Reg_1061858_Par_1_v1061858",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
