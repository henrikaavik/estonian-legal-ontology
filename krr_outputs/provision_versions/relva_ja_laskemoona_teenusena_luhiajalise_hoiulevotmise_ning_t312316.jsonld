        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse relva ja laskemoona teenusena lühiajalise hoiulevõtmise, samuti teenusena hoiulevõetud relva ja laskemoona lühiajalise väljastamise ja tagastamise kord. Määrusega kehtestatakse relva ja laskemoona teenusena lühiajalise hoiulevõtmise, samuti teenusena hoiulevõetud relva ja laskemoona lühiajalise väljastamise ja tagastamise kord.",
      "rdfs:label": {
        "@value": "Reg_312316_Par_1 (redaktsioon 312316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312316",
