      "rdfs:label": {
        "@value": "LTTS_Par_41 (redaktsioon 728911)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "728911",
      "estleg:supersededByVersion": {
        "@id": "estleg:LTTS_Par_41_v963559"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-01",
