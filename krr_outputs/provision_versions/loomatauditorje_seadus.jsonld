      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "LTTS_Par_45 (redaktsioon 13255168)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13255168",
      "estleg:supersededByVersion": {
