      }
    },
    {
      "@id": "estleg:LTTS_Par_55_v750604",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LTTS_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loomataudi ennetamise ja tõrje kuludeks loetakse: proovide võtmisega seotud kulud; diagnostilise uurimise kulud; vaktsineerimise ja passiivse immuniseerimise kulud; taudikahju hüvitus kohustuslikus korras hukatud, sealhulgas kontrolltapetud loomade eest; loomade hukkamise, korjuste ja loomsete saaduste kahjutustamise või ümbertöötamise kulud; desinfektsiooni-, desinsektsiooni- ja deratisatsioonikulud taudipunktis, piiripunktis ning avalikult kasutataval teel; haigete ja taudikahtlaste loomade tapamajas tapmisega ning haigusetekitajaid sisaldavate või nendega saastunud ja selles osas kahtlaste loomsete saaduste käitlemisest ja ringlusest kõrvaldamisega seotud kulud; taudikahju hüvitus hävitamisele kuuluva haigusetekitajatega saastunud inventari, sööda ja toodangu eest; loomataudi ennetamise ja tõrje toimingutele kaasatud isikute tehtud kulutused ja töötasu.",
      "rdfs:label": {
        "@value": "LTTS_Par_55 (redaktsioon 750604)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750604",
