    {
      "@id": "estleg:LTTS_Par_18_v22452",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LTTS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõige 1 jõustub 1.01.2003] (1) Loomi võib loomsete saaduste saamise eesmärgil tappa ainult tunnustatud tapamajades. (2) [kehtetu] (3) Tapamajja tapmiseks lähetatav loom peab olema kliiniliselt terve ning pärinema karjast ja piirkonnast, millele ei ole loomataudi esinemise või kahtluse tõttu kehtestatud loomade liikumise piirangut. (4) Järelevalveametniku või volitatud veterinaararsti poolt tapmisele saadetud või tapamajas avastatud kliiniliselt haigeid ja taudikahtlasi loomi tapetakse eraldi tervetest loomadest järelevalveametniku või volitatud veterinaararsti järelevalve all. (5) kehtetu -- (6) Loomsete saaduste ja nende käitlemise veterinaarnõuded kehtestab põllumajandusminister. (7) Haigetelt ja taudikahtlastelt loomadelt pärinevate saaduste käitlemise ja kasutamise veterinaarnõuded sätestatakse käesoleva seaduse § 43 lõike 2 alusel kehtestatud loomatauditõrje eeskirjades. (8) Tapaloomade ja loomsete saaduste vastavust käesolevas seaduses ja selle alusel kehtestatud veterinaarnõuetele tõendab käesoleva seaduse §-s 28 sätestatud korras väljastatud veterinaartõend.",
      "rdfs:label": {
        "@value": "LTTS_Par_18 (redaktsioon 22452)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22452",
      "estleg:supersededByVersion": {
        "@id": "estleg:LTTS_Par_18_v728911"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-01",
        "@type": "xsd:date"
      }
    },
