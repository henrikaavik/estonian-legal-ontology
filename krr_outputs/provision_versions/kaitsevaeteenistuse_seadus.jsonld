        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaadrikaitseväelasele makstakse puhkusetasu Eesti Vabariigi puhkuseseaduses ettenähtud alustel ja korras. (2) Kaadrikaitseväelasele võib maksta puhkusetoetust avaliku teenistuse seaduses sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_161 (redaktsioon 12894055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894055",
