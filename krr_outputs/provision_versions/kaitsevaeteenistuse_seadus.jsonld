      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_158_v12769904",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_158"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ajateenijale ja õppekogunemisest osavõtvale reservväelasele tagatakse tegevteenistuse ajal tasuta majutus ning tasuta toitlustamine. (2) Kaadrikaitseväelasele tagatakse väliõppusel, rahvusvahelisel sõjalisel operatsioonil, õhuväe õhusõiduki pardal ja teenistusel mereväe laevadel tasuta toitlustamine",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_158 (redaktsioon 12769904)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12769904",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_158_v13336838"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_158_v13336838",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_158"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ajateenijale ja õppekogunemisest osavõtvale reservväelasele tagatakse tegevteenistuse ajal tasuta majutus ning ulatuses tasuta toitlustamine. (2) Kaadrikaitseväelasele tagatakse väliõppusel, rahvusvahelisel sõjalisel operatsioonil, õhuväe õhusõiduki pardal ja teenistusel mereväe laevadel tasuta toitlustamine korras ja ulatuses.",
      "rdfs:label": {
