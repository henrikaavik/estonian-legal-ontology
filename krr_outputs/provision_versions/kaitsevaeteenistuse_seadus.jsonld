      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asendusteenistuse kestus ei või olla pikem kui 12 kuud ega lühem kui kaheksa kuud. (2) Asendusteenistuse kestuse määrusega.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_60 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
