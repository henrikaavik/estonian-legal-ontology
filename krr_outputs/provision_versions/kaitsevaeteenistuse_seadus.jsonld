      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaadrikaitseväelase määramisel ametikohale teise teenistuskohta saadetakse tema teenistusleht sinna. (2) Kaadrikaitseväelasele antakse lepingulisest teenistusest vabastamisel tema soovil väljavõte teenistuslehest ja teenistusleht saadetakse Kaitsejõudude Peastaapi.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_193 (redaktsioon 244127)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "244127",
