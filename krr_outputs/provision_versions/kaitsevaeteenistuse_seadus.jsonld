      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe juhataja põhipalga suuruse kehtestab igaks järgnevaks kalendriaastaks Vabariigi Valitsus korraldusega. (2) Kaitseväe juhatajale ei maksta muutuvpalka. (3) Kaitseväe juhataja asetäitja, Kaitseväe peastaabi ülema, väeliigi ülema, väejuhatuse ülema ja luurekeskuse ülema põhipalga määrab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_129 (redaktsioon 129062014100)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014100",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_129_v109032016004"
      },
      "estleg:versionValidTo": {
        "@value": "2016-03-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_129_v109032016004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_129"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe juhataja põhipalga suuruse kehtestab Vabariigi Valitsus korraldusega. (2) Kaitseväe juhatajale ei maksta muutuvpalka. (3) Kaitseväe juhataja asetäitja, Kaitseväe peastaabi ülema, väeliigi ülema, väejuhatuse ülema ja luurekeskuse ülema põhipalga määrab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_129 (redaktsioon 109032016004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109032016004",
