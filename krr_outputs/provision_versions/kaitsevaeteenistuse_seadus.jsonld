      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_155_v12769904",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_155"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Auastmetasu makstakse kaadrikaitseväelasele ka välisteenistusse lähetamise ajal välisteenistuse seaduse mõistes.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_155 (redaktsioon 12769904)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12769904",
