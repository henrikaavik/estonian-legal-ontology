        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe määrustikud kehtivad kõigi kaitseväelaste suhtes, sõltumata tegevteenistuse liigist või teenistuskohast, kui seadus või Eesti Vabariigi välisleping ei sätesta teisiti. (2) Kaitseväe määrustikud kinnitab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_19 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_19_v949612"
      },
      "estleg:versionValidTo": {
        "@value": "2005-10-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_19_v949612",
      "@type": [
        "owl:NamedIndividual",
