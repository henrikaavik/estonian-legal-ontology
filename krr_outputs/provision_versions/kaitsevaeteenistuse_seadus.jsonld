    {
      "@id": "estleg:KAITSE_3_Par_47_v12757488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_47 (redaktsioon 12757488)",
        "@language": "et"
      },
