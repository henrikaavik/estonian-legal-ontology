      },
      "estleg:versionValidTo": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_207_v129062014100",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
