      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_215"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_215 (redaktsioon 111032023059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023059"
    },
    {
      "@id": "estleg:KAITSE_3_Par_216_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse jõustumisel kutseõppeasutuses, riiklikult akrediteeritud õppekava alusel rakenduskõrgkooli või ülikooli statsionaarses õppevormis kõrgharidust omandama asunud, samuti kõrghariduse omandanud kutsealune, kes pole täitnud ajateenistuskohustust, vabastatakse ajateenistuskohustuse täitmisest ning arvatakse 28-aastaseks saamisel reservi. (2) Käesoleva paragrahvi lõike 1 alusel reservi arvatud isiku võib reservis olemise kahe esimese aasta jooksul kutsuda õppekogunemisele kuni 90 päevaks aastas.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_216 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_216_v244127"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_216_v244127",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse jõustumisel kutseõppeasutuses, riiklikult akrediteeritud õppekava alusel rakenduskõrgkooli või ülikooli statsionaarses õppevormis kõrgharidust omandama asunud, samuti kõrghariduse omandanud kutsealune, kes pole täitnud ajateenistuskohustust, vabastatakse ajateenistuskohustuse täitmisest ning arvatakse reservi. (2) Käesoleva paragrahvi lõike 1 alusel reservi arvatud isiku võib reservis olemise kahe esimese aasta jooksul kutsuda õppekogunemisele kuni 90 päevaks aastas.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_216 (redaktsioon 244127)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "244127",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_216_v13001006"
      },
      "estleg:versionValidTo": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_216_v13001006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse jõustumisel kutseõppeasutuses, riiklikult tunnustatud õppekava alusel rakenduskõrgkooli või ülikooli statsionaarses õppevormis kõrgharidust omandama asunud, samuti kõrghariduse omandanud kutsealune, kes pole täitnud ajateenistuskohustust, vabastatakse ajateenistuskohustuse täitmisest ning arvatakse reservi. (2) Käesoleva paragrahvi lõike 1 alusel reservi arvatud isiku võib reservis olemise kahe esimese aasta jooksul kutsuda õppekogunemisele kuni 90 päevaks aastas.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_216 (redaktsioon 13001006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13001006",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_216_v102072013007"
      },
      "estleg:versionValidTo": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_216_v102072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseressursside Ameti arstliku komisjoni või Kaitseväe arstliku komisjoni otsusega mittenõustumisel on isikul õigus esitada vaidekomisjonile vaie 30 päeva jooksul. (2) Vaidekomisjon vaatab vaide haldusmenetluse seaduses sätestatud korras läbi 60 päeva jooksul vaide saamisest arvates. (3) Vajaduse korral võib vaidekomisjon kaasata vaide läbivaatamisse eksperte või ette näha lisaterviseuuringu tegemise. Nimetatud juhul pikeneb käesoleva paragrahvi lõikes 2 toodud vaide läbivaatamise tähtaeg eksperdilt arvamuse saamiseks vajaliku aja või terviseuuringu tulemuse selgumise aja võrra. (4) Vaidekomisjoni otsusega mittenõustumisel on isikul õigus esitada kaebus halduskohtule.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_216 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_216_v111032023059"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_216_v111032023059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_216 (redaktsioon 111032023059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023059"
    },
    {
      "@id": "estleg:KAITSE_3_Par_216_1_v12769904",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_216_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutsealusel, kes 2007. aasta 1.jaanuari seisuga omandab välisriigi kõrgkoolis esimese astme kõrgharidust ning on käesoleva seaduse § 55 lõike 11 alusel teatanud ajateenistusse asumise kalendriaasta, on õigus ajapikendusele kuni kõrghariduse esimese astme kvalifikatsiooni saamiseni.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_216_1 (redaktsioon 12769904)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12769904",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_216_1_v111032023059"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_216_1_v111032023059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_216_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes leiab, et tema terviseseisundi hindamisega seotud otsusega on rikutud tema õigusi või piiratud tema vabadusi, võib esitada kirjalikult 30 päeva jooksul otsuse teatavakstegemisest arvates otsuse teinud asutuse kaudu vaide Kaitseministeeriumile. (2) Isiku terviseseseisundi hindamisega seotud otsuse peale vaide esitamise korral peatub Kaitseressursside Ameti käesoleva seaduse § 37 lõike 4 alusel tehtud otsuse täitmine kuni vaide lahendamiseni Kaitseministeeriumi poolt või kuni uue otsuse tegemiseni. (3) Kaitseministeerium, kaasates tervishoiutöötajate riiklikus registris registreeritud eriarste ja vajaduse korral teisi tervishoiuteenuse osutajaid, lahendab käesoleva seaduse § 261 lõikes 1 nimetatud isiku terviseseisundi hindamisega seotud Kaitseressursside Ameti või Kaitseväe otsuse peale esitatud vaide. (4) Kaitseministeerium vaatab vaide haldusmenetluse seaduses sätestatud korras läbi 60 päeva jooksul vaide saamisest arvates. (5) Kui vaide läbivaatamisse on vaja kaasata täiendavaid eksperte või teha täiendavaid terviseuuringuid, pikeneb vaide läbivaatamise tähtaeg eksperdilt arvamuse saamiseks vajaliku aja või terviseuuringu tulemuse selgumise aja võrra. (6) Kaitseministeerium ja vaide lahendamisse kaasatud tervishoiutöötajate riiklikus registris registreeritud eriarst ning tervishoiuteenuse osutaja võivad vaide lahendamise eesmärgil töödelda isikuandmeid, sealhulgas eriliiki isikuandmeid.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_216_1 (redaktsioon 111032023059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023059",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_216_1_v120022024003"
      },
      "estleg:versionValidTo": {
        "@value": "2024-03-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_216_1_v120022024003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_216_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_216_1 (redaktsioon 120022024003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120022024003"
    },
    {
      "@id": "estleg:KAITSE_3_Par_217_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_217"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2000. aasta 1. augustiks kehtestab Vabariigi Valitsus käesoleva seaduse § 61 lõigete 3 ja 4 alusel ajateenistuse kestuse.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_217 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_217_v102072013007"
      },
      "estleg:versionValidTo": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_217_v102072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_217"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigusvastaselt tegevteenistusest vabastamise korral on tegevväelasel nõudeõigus avaliku teenistuse seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_217 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007"
    },
    {
      "@id": "estleg:KAITSE_3_Par_218_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_218"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuue kuu jooksul, arvates käesoleva seaduse jõustumisest, viib lepingut sõlmiv ülem lepingulises tegevteenistuses oleva kaitseväelase tegevteenistuse lepingu vastavusse käesoleva seaduse nõuetega. Tegevteenistuse leping sõlmitakse tagasiulatuvalt käesoleva seaduse jõustumise päevast, katkestamata kaitseväeteenistuse staaži ja teenistussuhet.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_218 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_218_v559414"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_218_v559414",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_218"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuue kuu jooksul, arvates käesoleva seaduse jõustumisest, viib lepingut sõlmiv ülem lepingulises tegevteenistuses oleva kaitseväelase tegevteenistuse lepingu vastavusse käesoleva seaduse n��uetega. Tegevteenistuse leping sõlmitakse tagasiulatuvalt käesoleva seaduse jõustumise päevast, katkestamata kaitseväeteenistuse staa¾i ja teenistussuhet.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_218 (redaktsioon 559414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "559414",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_218_v697379"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_218_v697379",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_218"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuue kuu jooksul, arvates käesoleva seaduse jõustumisest, viib lepingut sõlmiv ülem lepingulises tegevteenistuses oleva kaitseväelase tegevteenistuse lepingu vastavusse käesoleva seaduse nõuetega. Tegevteenistuse leping sõlmitakse tagasiulatuvalt käesoleva seaduse jõustumise päevast, katkestamata kaitseväeteenistuse staaži ja teenistussuhet.",
      "rdfs:label": {
