      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_200_v13101680",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_200"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Töövõimetuspensioni suuruse arvestamise aluseks on isikule tema teenistuskohustuste täitmisest põhjustatud töövõime kaotuse astmele vastavalt määratud püsiva töövõimetuse aste, endisele kaadrikaitseväelasele tema pensioni arvestamise summa ning endisele ajateenijale ja reservväelasele viimane Statistikaameti poolt avaldatud kuukeskmine brutopalk kalendriaastas.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_200 (redaktsioon 13101680)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13101680",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_200_v102072013007"
      },
      "estleg:versionValidTo": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_200_v102072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_200"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikule, kes on teenistusülesannete täitmise tõttu saanud tervisekahjustuse ja seetõttu tegevteenistusest vabastatud ning kes asub kahe aasta jooksul pärast tegevteenistusest vabastamist õppima Eestis asuvasse tsiviilõppeasutusse, hüvitatakse Kaitseministeeriumi valitsemisala eelarvest piirmäära ulatuses õppekulu. (2) Õppekulu hüvitamise tingimused, ulatuse ja korra määrusega.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_200 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_200_v129062014099"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_200_v129062014099",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_200"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikule, kes on teenistusülesannete täitmise tõttu saanud tervisekahjustuse ja seetõttu tegevteenistusest vabastatud ning kes asub kahe aasta jooksul pärast tegevteenistusest vabastamist õppima Eestis asuvasse tsiviilõppeasutusse, hüvitatakse Kaitseministeeriumi valitsemisala eelarvest piirmäära ulatuses õppekulu. (2) Õppekulu hüvitamise tingimused, ulatuse ja korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_200 (redaktsioon 129062014099)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014099",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_200_v122122014003"
      },
      "estleg:versionValidTo": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_200_v122122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_200"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikule, kes on teenistusülesannete täitmise tõttu saanud püsiva tervisekahjustuse ja seetõttu tegevteenistusest vabastatud ning kes asub pärast tegevteenistusest vabastamist õppima Eestis asuvasse õppeasutusse, hüvitatakse õppekulu Kaitseministeeriumi valitsemisala eelarvest piirmäära ulatuses. (1<sup>1</sup>) Teenistusülesannete täitmise tõttu püsiva tervisekahjustuse saanud tegevväelasele, kes asub tegevteenistuse ajal õppima Eestis asuvasse õppeasutusse, hüvitatakse vajaduse korral täiendus- või ümberõppekulu Kaitseministeeriumi valitsemisala eelarvest piirmäära ulatuses. (1<sup>2</sup>) Tegevteenistusest lahkuda soovivale rahvusvahelises sõjalises operatsioonis osalenud tegevväelasele, kellel on tegevteenistusstaaži vähemalt kaks aastat ja kes asub tegevteenistuse ajal õppima Eestis asuvasse õppeasutusse, hüvitatakse vajaduse korral uue kutse- või eriala täiendus- või ümberõppekulu Kaitseministeeriumi valitsemisala eelarvest piirmäära ulatuses. (2) Õppekulu hüvitamise tingimused, ulatuse ja korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_200 (redaktsioon 122122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122014003"
    },
    {
      "@id": "estleg:KAITSE_3_Par_201_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_201"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Töövõimetuspension arvutatakse pensioni arvestamise teenistustasust või jooksva aasta Eesti keskmisest palgast järgmises ulatuses: täielik püsiv töövõimetus - 80%; osaline püsiv töövõimetus - 40%. (2) Kui kaitseväelasel on tema töövõimetuks tunnistamise päevaks väljateenitud aastate pensioni määramiseks nõutav väljateenitud aastate pensioni staaž, määratakse tema soovil talle töövõimetuspension väljateenitud aastate pensioni suuruses.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_201 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_201_v244127"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_201_v244127",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_201"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Töövõimetuspension arvutatakse pensioni arvestamise teenistustasust või viimasest Statistikaameti poolt avaldatud kuukeskmisest brutopalgast kalendriaastas järgmises ulatuses: täielik püsiv töövõimetus - 80%; osaline püsiv töövõimetus - 40%. (2) Kui kaitseväelasel on tema töövõimetuks tunnistamise päevaks väljateenitud aastate pensioni määramiseks nõutav väljateenitud aastate pensioni staaž, määratakse tema soovil talle töövõimetuspension väljateenitud aastate pensioni suuruses.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_201 (redaktsioon 244127)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "244127",
