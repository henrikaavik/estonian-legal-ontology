      "estleg:versionValidTo": {
        "@value": "2005-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_191_v968538",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
