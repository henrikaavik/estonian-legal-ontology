        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_194 (redaktsioon 13197916)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13197916",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_194_v13336838"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
