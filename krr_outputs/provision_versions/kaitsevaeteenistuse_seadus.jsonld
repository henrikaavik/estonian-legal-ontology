      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_86_v102072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevteenistusse ei võeta isikut: kes on kriminaalasjas kahtlustatav või süüdistatav; kellel on karistatus tahtlikult toimepandud kuriteo eest; kes on süüdi mõistetud ja kellelt on kohtuotsusega ära võetud õigus töötada kaitseväeteenistusega või muu avaliku teenistusega seotud ametikohal; kes on distsiplinaarsüüteo eest vabastatud kaitseväeteenistusest või muult avaliku teenistuse ametikohalt, kui vabastamisest on möödunud vähem kui aasta; kes on erakonna liige; kelle valimiskomisjon on registreerinud Riigikogu, Euroopa Parlamendi või kohaliku omavalitsuse volikogu valimistel kandidaadina.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_86 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_86_v129062014100"
      },
      "estleg:versionValidTo": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_86_v129062014100",
