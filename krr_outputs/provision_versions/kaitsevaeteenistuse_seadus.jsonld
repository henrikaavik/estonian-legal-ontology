    {
      "@id": "estleg:KAITSE_3_Par_117_v102072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pikaajalisele välislähetusele, lähetuskulude hüvitamisele ja abikaasatasu maksmisele kohaldatakse avaliku teenistuse seadust käesolevas seaduses sätestatud erisustega. (2) Tegevväelase pikaajalisse välislähetusse lähetamise otsustab Kaitseväe juhataja. (3) Käesolevat paragrahvi ei kohaldata tegevväelase lähetamisel sõjaväelist haridust andvasse välisriigi õppeasutusse või ressursimahukale koolitusele või kui lähetuse eesmärk on koolitus täiskasvanute koolituse seaduse tähenduses.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_117 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
