      },
      "estleg:versionValidTo": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_117_v122122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pikaajalisele välislähetusele, lähetuskulude hüvitamisele ja abikaasatasu maksmisele kohaldatakse avaliku teenistuse seadust käesolevas seaduses sätestatud erisustega. (2) Tegevväelase pikaajalisse välislähetusse lähetamise otsustab Kaitseväe juhataja. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_117 (redaktsioon 122122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122014003",
      "estleg:supersededByVersion": {
