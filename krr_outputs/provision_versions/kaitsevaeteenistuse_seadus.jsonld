      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_128_v102072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_128"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevväelase palgale, palga komponentidele, palga vähendamise alustele, palga maksmise ajale ja viisile, palga maksmisele teenistusülesannete täitmise takistuse korral ning palga avalikustamisele kohaldatakse avaliku teenistuse seadust, kui käesolevas seaduses ei ole sätestatud teisiti. (2) Tegevväelase rahuaja ametikoha palgaastmestiku määrusega. (3) Kadetile makstakse ainult põhipalka ja talle ei maksta avaliku teenistuse seaduses sätestatud muutuvpalka. (4) Palgajuhendi kehtestab Kaitseväe juhataja. (5) Tegevväelasele ei maksta lisatasu ega toetust, mille maksmise õigus ei tulene seadusest. (6) Suunatud tegevväelasele maksab palka või töötasu suunamiskoha asutus asutuses kehtiva korra järgi.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_128 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_128_v129062014099"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_128_v129062014099",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_128"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevväelase palgale, palga komponentidele, palga vähendamise alustele, palga maksmise ajale ja viisile, palga maksmisele teenistusülesannete täitmise takistuse korral ning palga avalikustamisele kohaldatakse avaliku teenistuse seadust, kui käesolevas seaduses ei ole sätestatud teisiti. (2) Tegevväelase rahuaja ametikoha palgaastmestiku kehtestab määrusega. (3) Kadetile makstakse ainult põhipalka ja talle ei maksta avaliku teenistuse seaduses sätestatud muutuvpalka. (4) Palgajuhendi kehtestab Kaitseväe juhataja. (5) Tegevväelasele ei maksta lisatasu ega toetust, mille maksmise õigus ei tulene seadusest. (6) Suunatud tegevväelasele maksab palka või töötasu suunamiskoha asutus asutuses kehtiva korra järgi.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_128 (redaktsioon 129062014099)",
