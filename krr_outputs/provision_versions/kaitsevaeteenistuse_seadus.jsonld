      },
      "estleg:versionValidTo": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_60_v129062014099",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asendusteenistuse kestus ei või olla pikem kui 12 kuud ega lühem kui kaheksa kuud. (2) Asendusteenistuse kestuse kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_60 (redaktsioon 129062014099)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014099",
      "estleg:supersededByVersion": {
