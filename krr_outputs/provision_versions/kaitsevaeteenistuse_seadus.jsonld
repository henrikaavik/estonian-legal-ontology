      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_194_v13336838",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_194"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_194 (redaktsioon 13336838)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13336838",
      "estleg:supersededByVersion": {
