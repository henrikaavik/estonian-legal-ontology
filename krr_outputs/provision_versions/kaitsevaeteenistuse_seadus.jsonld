        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõjaväelise auastmega ülema asetäitja ametikoht on ühe auastme võrra madalam ülema ametikohast.",
      "rdfs:label": {
