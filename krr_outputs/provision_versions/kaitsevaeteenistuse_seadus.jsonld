        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaadrikaitseväelasele antakse kaitseväe arstliku komisjoni otsuse alusel ravijärgset puhkust teenistustasu säilitamisega kuni kolmeks kuuks.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_172 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
