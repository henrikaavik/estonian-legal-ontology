      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_212_v262337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_212"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväelane võib enda nimel esitada vaide kirjalikult käeolevas seaduses ja kaitseväe määrustikes sätestatud alustel ja korras pädevale ülemale või kohtule. (2) Vaide esitamine ei vabasta vaide esitajat seadusest tulenevate kohustuste või käsu täitmisest. (3) Käesolevas seaduses sätestamata juhtudel võib isik, kes leiab, ettemaseaduslikke huve või õigusi on rikutud, esitada vaide: ajateenistusse kutsumise asjades - kaitseväeteenistuse komisjonile; lepingulisse teenistusse võtmise asjades - lepingut sõlmivale ülemale; tegevteenistusest tulenevates asjades - vahetu ülema kaudu väeosa ülemale või lepingut sõlmivale ülemale; tegevteenistusest vabastamise asjades - väeosa ülemale või lepingut sõlmivale ülemale. (4) Väeosa ülema või väeosaga võrdsustatud üksuse ülema ebaseadusliku tegevuse peale võib esitada vaide kaitseväe juhatajale (kaitseväe ülemjuhatajale) või kaebuse halduskohtule.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_212 (redaktsioon 262337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262337",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_212_v832165"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-24",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_212_v832165",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_212"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväelane võib enda nimel esitada vaide kirjalikult käeolevas seaduses ja kaitseväe määrustikes sätestatud alustel ja korras pädevale ülemale või kohtule. (2) Vaide esitamine ei vabasta vaide esitajat seadusest tulenevate kohustuste või käsu täitmisest. (3) Käesolevas seaduses sätestamata juhtudel võib isik, kes leiab, et tema seaduslikke huve või õigusi on rikutud, esitada vaide: ajateenistusse kutsumise asjades - kaitseväeteenistuse komisjonile; lepingulisse teenistusse võtmise asjades - lepingut sõlmivale ülemale; tegevteenistusest tulenevates asjades - vahetu ülema kaudu väeosa ülemale või lepingut sõlmivale ülemale; tegevteenistusest vabastamise asjades - väeosa ülemale või lepingut sõlmivale ülemale. (4) Väeosa ülema või väeosaga võrdsustatud üksuse ülema ebaseadusliku tegevuse peale võib esitada vaide kaitseväe juhatajale (kaitseväe ülemjuhatajale) või kaebuse halduskohtule.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_212 (redaktsioon 832165)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "832165",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_212_v13101680"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_212_v13101680",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_212"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväelane võib enda nimel esitada vaide kirjalikult käeolevas seaduses ja kaitseväe määrustikes sätestatud alustel ja korras pädevale ülemale või kohtule. (2) Vaide esitamine ei vabasta vaide esitajat seadusest tulenevate kohustuste täitmisest. (3) Käesolevas seaduses sätestamata juhtudel võib isik, kes leiab, et tema seaduslikke huve või õigusi on rikutud, esitada vaide: ajateenistusse kutsumise asjades - kaitseväeteenistuse komisjonile; lepingulisse teenistusse võtmise asjades - lepingut sõlmivale ülemale; tegevteenistusest tulenevates asjades - vahetu ülema kaudu väeosa ülemale või lepingut sõlmivale ülemale; tegevteenistusest vabastamise asjades - väeosa ülemale või lepingut sõlmivale ülemale. (4) Struktuuriüksuse ülema või väeliigi ülema ebaseadusliku haldusakti või toimingu peale võib esitada vaide kaitseväe juhatajale (kaitseväe ülemjuhatajale) või kaebuse halduskohtule. Kaitseväe juhataja ebaseadusliku haldusakti või toimingu peale võib esitada vaide kaitseministrile või kaebuse halduskohtule.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_212 (redaktsioon 13101680)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13101680",
