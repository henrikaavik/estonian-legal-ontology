        "@language": "et"
      },
      "estleg:versionRedactionId": "103022026017"
    },
    {
      "@id": "estleg:KAITSE_3_Par_20_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
