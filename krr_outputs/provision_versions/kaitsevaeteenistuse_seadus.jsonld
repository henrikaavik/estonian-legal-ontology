      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Distsiplinaarkaristus kustub, kui kaitseväelasele ei ole määratud uut distsiplinaarkaristust ühe aasta jooksul distsiplinaarkaristuse määramise päevast arvates.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_189 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007"
    },
    {
      "@id": "estleg:KAITSE_3_Par_19_v22461",
      "@type": [
