        "@type": "xsd:date"
      },
      "estleg:versionText": "Asendusteenistuse kestus ei tohi olla pikem kui 18 kuud ja lühem kui 12 kuud.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_74 (redaktsioon 968538)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "968538",
