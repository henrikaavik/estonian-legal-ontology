      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväeteenistuse staa˛i tõendatakse kandega teenistuslehel. (2) Kaitseväeteenistuse hulka arvatavat staa˛i tõendatakse tööraamatuga, samuti riigi- või kohaliku omavalitsuse või arhiiviasutuse poolt väljaantavate dokumentidega või kohtu korras.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_191 (redaktsioon 968538)",
