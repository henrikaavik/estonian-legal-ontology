      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_172_v102072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_172"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaararesti kandval kaitseväelasel on samasugused õigused ja tema suhtes kohaldatakse samasuguseid piiranguid, kui on sätestatud käesoleva seaduse §-s 164 distsiplinaarkinnipidamisel oleva isiku suhtes. (2) Distsiplinaararesti määramisel tehakse kaitseväelasele turvakontroll ja asjade läbivaatus käesoleva seaduse §-s 163 sätestatud korras.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_172 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_172_v101032017003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_172_v101032017003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_172"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaararesti kandval kaitseväelasel on samasugused õigused ja tema suhtes kohaldatakse samasuguseid piiranguid, kui on sätestatud käesoleva seaduse §-s 164 distsiplinaarkinnipidamisel oleva isiku suhtes. (2) Distsiplinaararesti määramise korral tehakse kaitseväelasele Kaitseväe arestimajja või selleks ettenähtud ruumi paigutamisel või enne Kaitseväe struktuuriüksusest politsei arestimajja toimetamist turvakontroll ja asjade läbivaatus käesoleva seaduse §-s 163 sätestatud tingimustel ja korras. Enne politsei arestimajja toimetamist tehakse kaitseväelasele Kaitseväe struktuuriüksuses vangistusseaduses ettenähtud tervisekontroll. (3) Politsei arestimajja paigutatud kaitseväelase suhtes kohaldatakse aresti täideviimist ja arestimajas kinnipidamist reguleerivaid vangistusseaduse sätteid.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_172 (redaktsioon 101032017003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101032017003",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_172_v111032023059"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_172_v111032023059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_172"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaararesti kandval kaitseväelasel on samasugused õigused ja tema suhtes kohaldatakse samasuguseid piiranguid, kui on sätestatud käesoleva seaduse §-s 164 distsiplinaarkinnipidamisel oleva isiku suhtes. (2) Distsiplinaararesti määramise korral tehakse kaitseväelasele Kaitseväe arestimajja või selleks ettenähtud ruumi paigutamisel või enne Kaitseväe struktuuriüksusest politsei arestimajja või vanglasse toimetamist turvakontroll ja asjade läbivaatus käesoleva seaduse §-s 163 sätestatud tingimustel ja korras. Enne politsei arestimajja või vanglasse toimetamist tehakse kaitseväelasele Kaitseväe struktuuriüksuses vangistusseaduses ettenähtud tervisekontroll. (3) Politsei arestimajja või vanglasse paigutatud kaitseväelase suhtes kohaldatakse aresti täideviimist ja arestimajas kinnipidamist reguleerivaid vangistusseaduse sätteid.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_172 (redaktsioon 111032023059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023059"
    },
    {
      "@id": "estleg:KAITSE_3_Par_173_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikaitse huvides võib kaitseväe juhataja (kaitseväe ülemjuhataja) katkestada kaitseväelase puhkuse ja kutsuda ta teenistuskohustuste täitmisele. Kaitseväe juhataja puhkuse võib riigikaitse huvides katkestada ja kutsuda ta teenistuskohustuste täitmisele Vabariigi President. (2) Käesoleva paragrahvi lõikes 1 sätestatud korras ei katkestata käesoleva seaduse §-des 171 ja 172 sätestatud puhkust. (3) Puhkuse katkestamise tõttu kasutamata jäänud puhkuse osa antakse puhkusele lubava ülemaga kokkuleppel samal teenistusaastal või liidetakse järgmise teenistusaasta puhkusega või antakse järgmise teenistusaasta kestel mõnel muul ajal. (4) Mobilisatsiooni, erakorralise seisukorra või sõjaseisukorra väljakuulutamine katkestab kõik puhkused ja kaitseväelased on kohustatud viivitamatult ilmuma oma teenistuskohta.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_173 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_173_v1024351"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_173_v1024351",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_173"
      },
      "estleg:versionValidFrom": {
