      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_225_v102072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 222–224 sätestatud väärtegude menetlemisele kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. (2) Käesoleva seaduse §-des 222 ja 223 sätestatud väärtegude kohtuväline menetleja on Kaitseressursside Amet. (3) Käesoleva seaduse §-s 224 sätestatud väärteo kohtuväline menetleja on Kaitsevägi.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_225 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_225_v122122014003"
      },
      "estleg:versionValidTo": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_225_v122122014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Käesoleva seaduse §-des 222 ja 223 sätestatud väärtegude kohtuväline menetleja on Kaitseressursside Amet. (3) Käesoleva seaduse §-s 224 sätestatud väärteo kohtuväline menetleja on Kaitsevägi.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_225 (redaktsioon 122122014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122014003",
      "estleg:supersededByVersion": {
