    {
      "@id": "estleg:KAITSE_3_Par_203_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_203"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toitjakaotuspensioni arvestamise aluseks on, kui toitja oli: kaadrikaitseväelane - tema pensioni arvestamise teenistustasu; ajateenija, kadett, õppekogunemisel viibiv reservväelane - jooksva aasta Eesti keskmine palk; pensionär - käesoleva seaduse alusel temale määratud pension.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_203 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_203_v244127"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_203_v244127",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_203"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toitjakaotuspensioni arvestamise aluseks on, kui toitja oli: kaadrikaitseväelane – tema pensioni arvestamise teenistustasu; ajateenija ja õppekogunemisel viibiv reservväelane – viimane Statistikaameti poolt avaldatud kuukeskmine brutopalk kalendriaastas.",
      "rdfs:label": {
