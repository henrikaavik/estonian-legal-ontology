    },
    {
      "@id": "estleg:KAITSE_3_Par_120_v102072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_120"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevväelase tegevuse seaduslikkusele, üldistele kohustustele, teenistusalaste korralduste täitmise kohustusele, korralduse täitmisest keeldumise alustele, avaldamisele mittekuuluva teabe hoidmisele ning asjaajamise ja vara üleandmise kohustusele kohaldatakse avaliku teenistuse seadust.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_120 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007"
    },
    {
      "@id": "estleg:KAITSE_3_Par_121_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_121"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lepingulisest teenistusest vabastamise käskkirjas märgitakse kaadrikaitseväelase: isikuandmed; viimane teenistuskoht ja ametikoht; ametikohalt ja lepingulisest teenistusest vabastamise kuupäev ja alus viitega seadusesättele; viimase ametikoha järgi väljamaksmisele kuuluv teenistustasu, hüvitis, kompensatsioon ja nende summast kinnipidamisele kuuluv summa; väljateenitud kaitseväeteenistuse staaž; riigikaitseosakond, kus ta reservi arvele võetakse. (2) Lepingulisest teenistusest vabastamise käskkirja üks ärakiri antakse kaadrikaitseväelasele ja teine ärakiri saadetakse riigikaitseosakonda, kus isik reservi arvele võetakse.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_121 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_121_v184953"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      }
    },
