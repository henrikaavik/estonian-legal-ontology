      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_73_v111032023059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reservväelane võib osaleda õppekogunemisel tema auastme põhiliiki arvestades järjest järgmiselt: ohvitser – kuni 30 päeva; allohvitser – kuni 21 päeva; sõdur – kuni 14 päeva. (2) Reservväelane võib osaleda lisaõppekogunemisel järjest kuni 60 päeva. (3) Õppekogunemise aja ja selles osalevate reservväelaste piirarvu kehtestab Kaitseväe juhataja. (4) Kaitsevägi avaldab õppekogunemise aja ja selles osalevate reservväelaste piirarvu oma veebilehel vähemalt 150 päeva enne õppekogunemise toimumist. (5) Lisaõppekogunemise algusaja ja maksimaalse kestuse ning selles osalevate reservväelaste piirarvu kehtestab Vabariigi Valitsus korraldusega.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_73 (redaktsioon 111032023059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023059"
    },
    {
      "@id": "estleg:KAITSE_3_Par_74_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asendusteenistuse kestus ei tohi olla pikem kui 24 kuud ja lühem kui 16 kuud. Asendusteenistuse kestuse määrab kaitseministri ettepanekul Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_74 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_74_v832165"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-24",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_74_v832165",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asendusteenistuse kestus ei tohi olla pikem kui 18 kuud ja lühem kui 12 kuud. Asendusteenistuse kestuse määrab kaitseministri ettepanekul Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_74 (redaktsioon 832165)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "832165",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_74_v968538"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_74_v968538",
