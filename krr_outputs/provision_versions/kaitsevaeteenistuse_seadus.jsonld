      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_161_v13197916",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_161"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaadrikaitseväelasele makstakse puhkusetasu töölepingu seaduses ettenähtud alustel ja korras. (2) Kaadrikaitseväelasele võib maksta puhkusetoetust avaliku teenistuse seaduses sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_161 (redaktsioon 13197916)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13197916",
      "estleg:supersededByVersion": {
