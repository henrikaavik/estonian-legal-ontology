      },
      "estleg:versionValidTo": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_129_v129062014099",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_129"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe juhataja põhipalga suuruse kehtestab Vabariigi Valitsus igaks järgnevaks kalendriaastaks korraldusega. (2) Kaitseväe juhatajale ei maksta muutuvpalka. (3) Kaitseväe peastaabi ülema ja väeliigi ülema põhipalga määrab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_129 (redaktsioon 129062014099)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014099",
