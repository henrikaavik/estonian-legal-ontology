      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_189 (redaktsioon 104032011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104032011002",
      "estleg:supersededByVersion": {
