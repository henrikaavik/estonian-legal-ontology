      },
      "estleg:versionValidTo": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_225_v113032019073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
