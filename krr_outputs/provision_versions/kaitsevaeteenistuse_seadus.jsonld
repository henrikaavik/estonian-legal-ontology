      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Noomitus on ülema poolt alluva distsiplinaarsüüteole hukkamõistva hinnangu andmine ning alluva eneseväärikuse, au ja kohusetunde mõjutamine. (2) Noomituse määramise õigus on tegevväelasest otsesel ülemal.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_169 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007"
    },
