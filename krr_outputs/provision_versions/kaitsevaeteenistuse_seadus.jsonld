      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjaväelise auastme annab, seda alandab ja selle võtab ära: ohvitseri auastme – Vabariigi President Kaitseväe juhataja ettepanekul; vanemallohvitseri auastme – Kaitseväe juhataja; nooremallohvitseri auastme – Kaitseväe juhataja või väeliigi ülem; sõduri auastme – väeliigi ülem või Kaitseväe struktuuriüksuse ülem. (2) Sõjaväelise auastme andmine, alandamine ja äravõtmine tehakse kaitseväelasele ja reservis olevale isikule teatavaks esimesel võimalusel pärast sellekohase otsuse tegemist.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_21 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_21_v117122015100"
      },
      "estleg:versionValidTo": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_3_Par_21_v117122015100",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjaväelise auastme annab, seda alandab ja selle võtab ära: ohvitseri auastme – Vabariigi President Kaitseväe juhataja ettepanekul; vanemallohvitseri auastme – Kaitseväe juhataja; nooremallohvitseri auastme – Kaitseväe juhataja või väeliigi ülem; sõduri auastme – väeliigi ülem või Kaitseväe struktuuriüksuse ülem. (2) Sõjaväelise auastme andmine, alandamine ja äravõtmine tehakse isikule teatavaks esimesel võimalusel pärast sellekohase otsuse tegemist. (3) Sõjaväeline auaste antakse isikule, kui ametikoha ülesannete täitmine eeldab kaitseväeteenistuses olemist.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_21 (redaktsioon 117122015100)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015100",
      "estleg:supersededByVersion": {
