    {
      "@id": "estleg:KAITSE_3_Par_223_v22461",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_3_Par_223"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne Eesti Vabariigi põhiseaduse jõustumist antud sõjaväelist auastet võib käesoleva seadusega vastavusse viimiseks ülendada, kui isikul on vajalik haridus ja väljaõpe. (2) Enne käesoleva seaduse jõustumist antud auastet tagasiulatuvalt ei alandata. (3) Enne käesoleva seaduse jõustumist toimunud sõjaväelise auastme alandamine viiakse asjast huvitatud isiku taotlusel kooskõlla käesoleva seaduse nõuetega, kui sellega kaasneb allohvitseri või ohvitseri auastme andmine või auastme ülendamine.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_223 (redaktsioon 22461)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22461",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_3_Par_223_v102072013007"
      },
      "estleg:versionValidTo": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      }
    },
