      },
      "estleg:versionText": "Auastmeid annavad ja muudavad: sõdurite auastmeid – kaitseväe struktuuriüksuse ja väeliigi ülem; allohvitseride auastmeid – kaitseväe juhataja, sõjaajal käesoleva paragrahvi punktis 1 nimetatud ülem; ohvitseride auastmeid – Vabariigi President.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_32 (redaktsioon 13101680)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13101680",
      "estleg:supersededByVersion": {
