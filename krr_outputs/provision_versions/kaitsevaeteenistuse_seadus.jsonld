      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Käesoleva seaduse §-des 222 ja 223 sätestatud väärtegude kohtuväline menetleja on Kaitseressursside Amet. (3) Käesoleva seaduse §-s 224 sätestatud väärteo kohtuväline menetleja on Kaitsevägi. (4) Kohtuvälisel menetlejal on õigus töödelda menetlusaluse isiku isikuandmeid, sealhulgas eriliiki isikuandmeid.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_225 (redaktsioon 113032019073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019073",
      "estleg:supersededByVersion": {
