        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaadrikaitseväelasele antakse kaitseväe arstliku komisjoni otsuse alusel ravijärgset puhkust teenistustasu säilitamisega kuni kuueks kuuks.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_172 (redaktsioon 13092928)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13092928",
      "estleg:supersededByVersion": {
