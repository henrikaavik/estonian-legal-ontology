      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toimingu, otsuse või tehingu tegemisel peab tegevväelane järgima korruptsioonivastases seaduses sätestatut. (2) Tegevväelase streigikeelule kohaldatakse avaliku teenistuse seadust.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_127 (redaktsioon 102072013007)",
        "@language": "et"
      },
