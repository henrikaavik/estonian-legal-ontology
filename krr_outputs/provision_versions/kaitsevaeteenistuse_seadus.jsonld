      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe juhataja põhipalga suuruse kehtestab Vabariigi Valitsus igaks järgnevaks kalendriaastaks korraldusega. (2) Kaitseväe juhatajale ei maksta muutuvpalka. (3) Kaitseväe peastaabi ülema ja väeliigi ülema põhipalga määrab kaitseminister käskkirjaga.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_129 (redaktsioon 102072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013007",
      "estleg:supersededByVersion": {
