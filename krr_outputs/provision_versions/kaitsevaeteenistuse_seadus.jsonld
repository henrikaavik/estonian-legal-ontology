      },
      "estleg:versionText": "Asendusteenistuslase töö- ja puhkeajale kohaldatakse töö- ja puhkeaja seaduses sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "KAITSE_3_Par_76_1 (redaktsioon 13114754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13114754",
