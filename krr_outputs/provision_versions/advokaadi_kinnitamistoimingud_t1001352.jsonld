    {
      "@id": "estleg:Reg_1001352_Par_5_v1001352",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001352_Par_5"
