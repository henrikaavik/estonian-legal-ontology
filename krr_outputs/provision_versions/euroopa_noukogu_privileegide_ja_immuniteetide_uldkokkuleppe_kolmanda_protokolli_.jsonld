    {
      "@id": "estleg:ENPIUKPR_Par_3_v921880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ENPIUKPR_Par_3"
