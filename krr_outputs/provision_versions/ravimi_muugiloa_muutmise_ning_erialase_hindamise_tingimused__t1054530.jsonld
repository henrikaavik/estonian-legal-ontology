    },
    {
      "@id": "estleg:Reg_1054530_Par_1_v1054530",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054530_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse inimtervishoius kasutatava ja teisese müügiloaga ravimi müügiloa muudatuse taotlemise, homöopaatilise preparaadi ja traditsioonilise taimse ravimi müügiloa muudatusest teatamise ja muudatuse taotlemise ning pakendi infolehe ja märgistuse muutmise ning müügiloa üleandmise tingimused ja kord, inimtervishoius kasutatava ravimi ja veterinaarravimi müügiloa tingimuste muudatuse taotluse erialase hindamise tasu suurus taotluse liikide kaupa ning selle arvestamise tingimused ja kord ning veterinaarravimi müügiloa haldamise aastatasu suurus ja selle arvestamise tingimused ja kord. RT I 2024-02-14 2 114022024002 2024-02-17 Määrusega kehtestatakse inimtervishoius kasutatava ja teisese müügiloaga ravimi müügiloa muudatuse taotlemise, homöopaatilise preparaadi ja traditsioonilise taimse ravimi müügiloa muudatusest teatamise ja muudatuse taotlemise ning pakendi infolehe ja märgistuse muutmise ning müügiloa üleandmise tingimused ja kord, inimtervishoius kasutatava ravimi ja veterinaarravimi müügiloa tingimuste muudatuse taotluse erialase hindamise tasu suurus taotluse liikide kaupa ning selle arvestamise tingimused ja kord ning veterinaarravimi müügiloa haldamise aastatasu suurus ja selle arvestamise tingimused ja kord.",
      "rdfs:label": {
        "@value": "Reg_1054530_Par_1 (redaktsioon 1054530)",
        "@language": "et"
      },
