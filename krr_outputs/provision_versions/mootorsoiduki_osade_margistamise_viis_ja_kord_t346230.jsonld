      "dc:source": "Mootorsõiduki osade märgistamise viis ja kord"
    },
    {
      "@id": "estleg:Reg_346230_Par_1_v346230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_346230_Par_1"
