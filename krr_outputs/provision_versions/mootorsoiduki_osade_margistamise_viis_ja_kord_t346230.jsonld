      "estleg:versionValidFrom": {
        "@value": "2012-10-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse «Jäätmeseaduse» § 25 lõike 3 punktis 3 nimetatud mootorsõiduki, mis kuulub teede- ja sideministri 18. mai 2001. a määruse nr 50 «Mootorsõiduki ja selle haagise tehnoseisundile ja varustusele esitatavad nõuded» lisa 1 lisanduse B «Sõidukite jaotus kategooriatesse ja klassidesse» kohaselt määratud mootorsõidukite kategooriatesse M1, N1 ja L2e, osade märgistamise nõuded. Määrusega kehtestatakse «Jäätmeseaduse» § 25 lõike 3 punktis 3 nimetatud mootorsõiduki, mis kuulub teede- ja sideministri 18. mai 2001. a määruse nr 50 «Mootorsõiduki ja selle haagise tehnoseisundile ja varustusele esitatavad nõuded» lisa 1 lisanduse B «Sõidukite jaotus kategooriatesse ja klassidesse» kohaselt määratud mootorsõidukite kategooriatesse M1, N1 ja L2e, osade märgistamise nõuded.",
      "rdfs:label": {
        "@value": "Reg_346230_Par_1 (redaktsioon 346230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "346230",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/346230",
      "estleg:sourceAct": "Mootorsõiduki osade märgistamise viis ja kord",
      "estleg:provisionRef": "Reg_346230 § 1",
      "estleg:partOfAct": {
