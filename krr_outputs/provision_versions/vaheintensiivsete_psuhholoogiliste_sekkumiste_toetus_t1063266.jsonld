    },
    {
      "@id": "estleg:Reg_1063266_Par_16_v1063266",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1063266_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust rakendatakse tagasiulatuvalt 1. aprillist 2026. a. Määrust rakendatakse tagasiulatuvalt 1. aprillist 2026. a.",
      "rdfs:label": {
        "@value": "Reg_1063266_Par_16 (redaktsioon 1063266)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1063266",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1063266",
      "estleg:sourceAct": "Väheintensiivsete psühholoogiliste sekkumiste toetus",
      "estleg:provisionRef": "Reg_1063266 § 16",
