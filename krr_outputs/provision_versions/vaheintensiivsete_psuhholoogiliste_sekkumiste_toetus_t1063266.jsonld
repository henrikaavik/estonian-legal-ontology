    {
      "@id": "estleg:Reg_1063266_Par_3_v1063266",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1063266_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetust antakse perioodiks 1. jaanuar – 31. detsember (edaspidi toetusperiood) järgmisteks tegevusteks: 1 1) VIPS-spetsialistide ja superviisorite koolitamine, juhul kui taotletakse toetust ka punktis 2 sätestatud tegevuseks; 2 2) sihtrühmale VIPS-i tasuta rakendamine, tagades teenuse kättesaadavuse eesti keeles. Toetust antakse perioodiks 1. jaanuar – 31. detsember (edaspidi toetusperiood) järgmisteks tegevusteks: VIPS-spetsialistide ja superviisorite koolitamine, juhul kui taotletakse toetust ka punktis 2 sätestatud tegevuseks; sihtrühmale VIPS-i tasuta rakendamine, tagades teenuse kättesaadavuse eesti keeles.",
      "rdfs:label": {
        "@value": "Reg_1063266_Par_3 (redaktsioon 1063266)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1063266",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1063266",
      "estleg:sourceAct": "Väheintensiivsete psühholoogiliste sekkumiste toetus",
      "estleg:provisionRef": "Reg_1063266 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063266_Map_2026"
      }
