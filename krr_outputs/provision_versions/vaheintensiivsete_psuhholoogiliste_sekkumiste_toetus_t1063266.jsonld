    },
    {
      "@id": "estleg:Reg_1063266_Par_7_v1063266",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1063266_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetust võib taotleda juriidiline isik või füüsilisest isikust ettevõtja: 1 1) kes tagab vähemalt viiest VIPS-spetsialistist koosneva meeskonna VIPS-i järjepidevaks rakendamiseks; 2 2) kes omab õigust rakendada taotluses kirjeldatud VIPS-i ja vastutab selle metoodika kasutamise eest; 3 3) kelle taotluses kirjeldatud VIPS-i on enne taotluse esitamist Eestis rakendatud; 4 4) kellel ei ole taotluse esitamise ajal riiklike maksude maksuvõlga või see on ajatatud; 5 5) kes on täitnud maksudeklaratsioonide esitamise kohustuse; 6 6) kellel ei ole taotluse esitamise ajal täitmata kohustusi toetuse andja ees. Toetust võib taotleda juriidiline isik või füüsilisest isikust ettevõtja: kes tagab vähemalt viiest VIPS-spetsialistist koosneva meeskonna VIPS-i järjepidevaks rakendamiseks; kes omab õigust rakendada taotluses kirjeldatud VIPS-i ja vastutab selle metoodika kasutamise eest; kelle taotluses kirjeldatud VIPS-i on enne taotluse esitamist Eestis rakendatud; kellel ei ole taotluse esitamise ajal riiklike maksude maksuvõlga või see on ajatatud; kes on täitnud maksudeklaratsioonide esitamise kohustuse; kellel ei ole taotluse esitamise ajal täitmata kohustusi toetuse andja ees.",
      "rdfs:label": {
        "@value": "Reg_1063266_Par_7 (redaktsioon 1063266)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1063266",
