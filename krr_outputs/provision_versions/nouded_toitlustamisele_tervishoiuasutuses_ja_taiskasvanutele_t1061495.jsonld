        "@type": "xsd:date"
      },
      "estleg:versionText": "Täiskasvanute menüü peab vastama lisades 1 ja 2 sätestatud nõuetele. Täiskasvanute menüü peab vastama lisades 1 ja 2 sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1061495_Par_4 (redaktsioon 1061495)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061495",
