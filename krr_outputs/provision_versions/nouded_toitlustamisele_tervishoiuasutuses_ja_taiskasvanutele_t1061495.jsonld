      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded toitlustamisele tervishoiuasutuses ja täiskasvanutele sotsiaalteenuse osutamisel (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded toitlustamisele tervishoiuasutuses ja täiskasvanutele sotsiaalteenuse osutamisel"
    },
    {
      "@id": "estleg:Reg_1061495_Par_1_v1061495",
      "@type": [
