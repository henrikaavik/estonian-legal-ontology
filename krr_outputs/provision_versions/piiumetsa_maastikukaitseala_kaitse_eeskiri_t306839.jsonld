    {
      "@id": "estleg:Reg_306839_Par_14_v306839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306839_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 3 3) maavara kaevandamine; 4 4) energiapuistute rajamine; 5 5) uuendusraie, välja arvatud 1. septembrist 31. jaanuarini lageraie langi suurusega kuni 1 ha ja laiusega kuni 30 m ning turberaie langi suurusega kuni 2 ha, kusjuures üle 60-aastase metsa osakaal piiranguvööndis ei tohi jääda väiksemaks kui 50% ning raielankide vahele tuleb jätta vähemalt 100 m laiune riba üle 40 aasta vanust puistut; 6 6) biotsiidi ja taimekaitsevahendi kasutamine; 7 7) ehitise püstitamine, välja arvatud kaitseala valitseja nõusolekul ehitise püstitamine kaitseala tarbeks; 8 8) telkimine ja lõkke tegemine kohtades, mida kaitseala valitseja ei ole selleks ette valmistanud ja tähistanud. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; maavara kaevandamine; energiapuistute rajamine; uuendusraie, välja arvatud 1. septembrist 31. jaanuarini lageraie langi suurusega kuni 1 ha ja laiusega kuni 30 m ning turberaie langi suurusega kuni 2 ha, kusjuures üle 60-aastase metsa osakaal piiranguvööndis ei tohi jääda väiksemaks kui 50% ning raielankide vahele tuleb jätta vähemalt 100 m laiune riba üle 40 aasta vanust puistut; biotsiidi ja taimekaitsevahendi kasutamine; ehitise püstitamine, välja arvatud kaitseala valitseja nõusolekul ehitise püstitamine kaitseala tarbeks; telkimine ja lõkke tegemine kohtades, mida kaitseala valitseja ei ole selleks ette valmistanud ja tähistanud.",
      "rdfs:label": {
        "@value": "Reg_306839_Par_14 (redaktsioon 306839)",
        "@language": "et"
      },
