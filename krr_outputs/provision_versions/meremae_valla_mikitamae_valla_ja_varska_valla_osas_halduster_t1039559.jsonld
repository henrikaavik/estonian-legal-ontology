      "estleg:sourceAct": "Meremäe valla, Mikitamäe valla ja Värska valla osas haldusterritoriaalse korralduse muutmine ja Misso valla territooriumiosa üleandmine",
      "estleg:provisionRef": "Reg_1039559 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039559_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039559_Par_3_v1039559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039559_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatava Setomaa valla piiriks on §-ga 2 muudetud senise Värska valla ning Meremäe valla ja Mikitamäe valla piir, välja arvatud nende omavahelises osas. Haldusterritoriaalse korralduse muutmise käigus moodustatava Setomaa valla piiriks on §-ga 2 muudetud senise Värska valla ning Meremäe valla ja Mikitamäe valla piir, välja arvatud nende omavahelises osas. 2 (2) Maa-amet kannab Setomaa valla piiri riigi maakatastri kaardile. Maa-amet kannab Setomaa valla piiri riigi maakatastri kaardile.",
      "rdfs:label": {
        "@value": "Reg_1039559_Par_3 (redaktsioon 1039559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039559",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039559",
      "estleg:sourceAct": "Meremäe valla, Mikitamäe valla ja Värska valla osas haldusterritoriaalse korralduse muutmine ja Misso valla territooriumiosa üleandmine",
      "estleg:provisionRef": "Reg_1039559 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039559_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039559_Par_4_v1039559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039559_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega haldusterritoriaalse korralduse muutmise tulemusena moodustatavale Setomaa vallale hüvitatakse riigieelarvest Vabariigi Valitsuse algatatud ühinemisega seotud tegelikud tehtud kulud kuludokumentide alusel haldusreformi seaduse § 24 lõike 2 alusel kehtestatud korras. Käesoleva määrusega haldusterritoriaalse korralduse muutmise tulemusena moodustatavale Setomaa vallale hüvitatakse riigieelarvest Vabariigi Valitsuse algatatud ühinemisega seotud tegelikud tehtud kulud kuludokumentide alusel haldusreformi seaduse § 24 lõike 2 alusel kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1039559_Par_4 (redaktsioon 1039559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039559",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039559",
      "estleg:sourceAct": "Meremäe valla, Mikitamäe valla ja Värska valla osas haldusterritoriaalse korralduse muutmine ja Misso valla territooriumiosa üleandmine",
      "estleg:provisionRef": "Reg_1039559 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039559_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039559_Par_5_v1039559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
