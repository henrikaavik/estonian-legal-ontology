    {
      "@id": "estleg:Reg_1039559_Par_2_v1039559",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039559_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Värska valla piiri muudetakse senise Misso valla Hindsa, Koorla, Kossa, Kriiva, Leimani, Lütä, Mokra, Määsi, Napi, Pruntova, Põrstõ, Saagri, Tiastõ, Tiilige, Toodsi ja Tserebi küla territooriumi arvamisega Värska valla koosseisu. Värska valla piiri muudetakse senise Misso valla Hindsa, Koorla, Kossa, Kriiva, Leimani, Lütä, Mokra, Määsi, Napi, Pruntova, Põrstõ, Saagri, Tiastõ, Tiilige, Toodsi ja Tserebi küla territooriumi arvamisega Värska valla koosseisu.",
      "rdfs:label": {
        "@value": "Reg_1039559_Par_2 (redaktsioon 1039559)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039559",
