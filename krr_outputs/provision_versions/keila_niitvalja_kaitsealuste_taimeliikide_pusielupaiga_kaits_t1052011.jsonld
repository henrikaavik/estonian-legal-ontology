    {
      "@id": "estleg:Reg_1052011_Par_4_v1052011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052011_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas2 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndi piiride kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas2 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndi piiride kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1052011_Par_4 (redaktsioon 1052011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052011",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052011",
      "estleg:sourceAct": "Keila-Niitvälja kaitsealuste taimeliikide püsielupaiga kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1052011 § 4",
