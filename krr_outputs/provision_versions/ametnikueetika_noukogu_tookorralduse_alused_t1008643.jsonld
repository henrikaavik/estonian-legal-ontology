    {
      "@id": "estleg:Reg_1008643_Par_5_v1008643",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1008643_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eetikanõukogu on otsustusvõimeline, kui koosolekust võtavad osa eetikanõukogu esimees ja vähemalt pool eetikanõukogu liikmetest. Eetikanõukogu on otsustusvõimeline, kui koosolekust võtavad osa eetikanõukogu esimees ja vähemalt pool eetikanõukogu liikmetest. 2 (2) Nõutud kvoorumi puudumise korral kutsub eetikanõukogu esimees esimesel võimalusel kokku uue koosoleku. Nõutud kvoorumi puudumise korral kutsub eetikanõukogu esimees esimesel võimalusel kokku uue koosoleku. 3 (3) Eetikanõukogu hääletamisest ei võta osa eetikanõukogu liige, kellel seoses otsusega võib tekkida isiklik või ametialane huvi. Eetikanõukogu hääletamisest ei võta osa eetikanõukogu liige, kellel seoses otsusega võib tekkida isiklik või ametialane huvi.",
      "rdfs:label": {
        "@value": "Reg_1008643_Par_5 (redaktsioon 1008643)",
        "@language": "et"
      },
