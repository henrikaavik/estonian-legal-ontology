      "estleg:versionValidFrom": {
        "@value": "2015-05-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eetikanõukogu liikmesusega seotud ülesandeid ei saa delegeerida ega määrata eetikanõukogu liikme eemalviibimise korral ajutist asendusliiget. Eetikanõukogu liikmesusega seotud ülesandeid ei saa delegeerida ega määrata eetikanõukogu liikme eemalviibimise korral ajutist asendusliiget.",
      "rdfs:label": {
        "@value": "Reg_1008643_Par_2 (redaktsioon 1008643)",
        "@language": "et"
      },
