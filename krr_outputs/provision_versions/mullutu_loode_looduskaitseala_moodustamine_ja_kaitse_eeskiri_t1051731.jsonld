      },
      "estleg:versionValidFrom": {
        "@value": "2021-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas 14. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas 14.",
      "rdfs:label": {
        "@value": "Reg_1051731_Par_2 (redaktsioon 1051731)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051731",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051731",
      "estleg:sourceAct": "Mullutu-Loode looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1051731 § 2",
