    },
    {
      "@id": "estleg:KASVS_Par_8_v22322",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KASVS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eeltööde loa alusel võidakse teha loas ettenähtud mõõtmisi, uuringuid, puurimisi, kaevamisi ja raiumisi. (2) Kinnisasja omanik peab lubama teha kinnisasjal loas näidatud eeltöid. Ehitistes, kinnistes õuedes ja aedades tohib eeltöid teha ainult omaniku loal.",
      "rdfs:label": {
