      }
    },
    {
      "@id": "estleg:KASVS_Par_15_v22322",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KASVS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sundvõõrandisaaja peab kinnisasja sundvõõrandamise korral maksma sundvõõrandiandjale sundvõõranditasu. (2) Sundvõõranditasu makstakse rahas, kui pooled ei lepi kokku teisiti. (3) Sundvõõrandisaaja peab maksma hüvitist isikutele, kelle õigusi sundvõõrandamine kahjustab.",
      "rdfs:label": {
        "@value": "KASVS_Par_15 (redaktsioon 22322)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22322",
      "estleg:supersededByVersion": {
