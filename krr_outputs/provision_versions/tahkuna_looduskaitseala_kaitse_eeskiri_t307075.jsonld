      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loodusreservaadi kaitse-eesmärk on ökosüsteemi arengu tagamine üksnes loodusliku protsessina. Loodusreservaadi kaitse-eesmärk on ökosüsteemi arengu tagamine üksnes loodusliku protsessina.",
      "rdfs:label": {
        "@value": "Reg_307075_Par_7 (redaktsioon 307075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "307075",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/307075",
      "estleg:sourceAct": "Tahkuna looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_307075 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_307075_Map"
      }
    },
    {
      "@id": "estleg:Reg_307075_Par_8_v307075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_307075_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loodusreservaadis on keelatud: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) inimeste viibimine, välja arvatud järelevalvetöödel, päästetöödel ja kaitseala valitsemisega seotud töödel ning kaitseala valitseja nõusolekul teadustegevuse ja kaitseala seisundi jälgimise ja hindamise eesmärgil. Loodusreservaadis on keelatud: majandustegevus; loodusvarade kasutamine; inimeste viibimine, välja arvatud järelevalvetöödel, päästetöödel ja kaitseala valitsemisega seotud töödel ning kaitseala valitseja nõusolekul teadustegevuse ja kaitseala seisundi jälgimise ja hindamise eesmärgil.",
      "rdfs:label": {
        "@value": "Reg_307075_Par_8 (redaktsioon 307075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "307075",
