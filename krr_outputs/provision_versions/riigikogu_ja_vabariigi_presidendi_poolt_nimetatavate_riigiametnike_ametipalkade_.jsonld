  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_riigikogu_ja_vabariigi_presidendi_poolt_nimetatavate_riigiametnike_ametipalkade__Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigikogu ja Vabariigi Presidendi poolt nimetatavate riigiametnike ametipalkade seadus (38 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigikogu ja Vabariigi Presidendi poolt nimetatavate riigiametnike ametipalkade seadus"
    },
    {
      "@id": "estleg:NRAPS_Par_1_v22362",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NRAPS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Peaministri, ministri, riigikontrolöri ja õiguskantsleriametipalk on Eesti keskmisepalga ja käesolevaseadusegakehtestatudvastavakoefitsiendikorrutis. (2) Riigikogu ja VabariigiPresidendipooltnimetatavateteisteriigiametnikeametipalk on riigiteenistujatepalgaastmestikukõrgeimaastmepalgamäära ja käesolevaseadusegakehtestatudvastavakoefitsiendikorrutis.",
      "rdfs:label": {
        "@value": "NRAPS_Par_1 (redaktsioon 22362)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22362",
      "estleg:supersededByVersion": {
        "@id": "estleg:NRAPS_Par_1_v184387"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NRAPS_Par_1_v184387",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NRAPS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Peaministri, ministrite, riigikontrolöri, õiguskantsleri, Riigikohtuesimehejaliikmeteningringkonna-, maa-, linna- jahalduskohtukohtunikeametipalk on Eestikeskmisepalgajakäesolevaseadusegakehtestatudvastavakoefitsiendikorrutis. Riigikohtuesimehe ja Riigikohtuliikmeteningringkonna-, maa-, linna- ja halduskohtukohtunikeametipalkakorrigeeritakseigaaastaalguses Eesti eelmiseaastakeskmisepalgaalusel. (2) Riigikogu ja VabariigiPresidendipooltnimetatavateteisteriigiametnikeametipalk on riigiteenistujatepalgaastmestikukõrgeimaastmepalgamäära ja käesolevaseadusegakehtestatudvastavakoefitsiendikorrutis.",
      "rdfs:label": {
        "@value": "NRAPS_Par_1 (redaktsioon 184387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184387",
      "estleg:supersededByVersion": {
        "@id": "estleg:NRAPS_Par_1_v968400"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NRAPS_Par_1_v968400",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NRAPS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Peaministri, ministrite, kaitseväe juhataja, riigikontrolöri, õiguskantsleri, Riigikohtu esimehe ja liikmete ning ringkonna-, maa-, linna- ja halduskohtu kohtunike ametipalk on Eesti keskmise palga ja käesoleva seadusega kehtestatud vastava koefitsiendi korrutis. Riigikohtu esimehe ja Riigikohtu liikmete ning ringkonna-, maa-, linna- ja halduskohtu kohtunike ja kaitseväe juhataja ametipalka korrigeeritakse iga aasta alguses Eesti eelmise aasta keskmise palga alusel. (2) Riigikogu ja Vabariigi Presidendi poolt nimetatavate teiste riigiametnike ametipalk on riigiteenistujate palgaastmestiku kõrgeima astme palgamäära ja käesoleva seadusega kehtestatud vastava koefitsiendi korrutis.",
      "rdfs:label": {
        "@value": "NRAPS_Par_1 (redaktsioon 968400)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "968400",
      "estleg:supersededByVersion": {
        "@id": "estleg:NRAPS_Par_1_v108072011059"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-21",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NRAPS_Par_1_v108072011059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NRAPS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Peaministri, ministrite, riigikontrolöri, õiguskantsleri, Riigikohtu esimehe ja liikmete ning ringkonna-, maa-, linna- ja halduskohtu kohtunike ametipalk on Eesti keskmise palga ja käesoleva seadusega kehtestatud vastava koefitsiendi korrutis. Riigikohtu esimehe ja Riigikohtu liikmete ning ringkonna-, maa-, linna- ja halduskohtu kohtunike ametipalka korrigeeritakse iga aasta alguses Eesti eelmise aasta keskmise palga alusel. (2) Riigikogu ja Vabariigi Presidendi poolt nimetatavate teiste riigiametnike ametipalk on riigiteenistujate palgaastmestiku kõrgeima astme palgamäära ja käesoleva seadusega kehtestatud vastava koefitsiendi korrutis.",
      "rdfs:label": {
        "@value": "NRAPS_Par_1 (redaktsioon 108072011059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072011059"
    },
