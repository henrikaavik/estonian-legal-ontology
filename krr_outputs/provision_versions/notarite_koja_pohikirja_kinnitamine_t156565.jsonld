    {
      "@id": "estleg:Reg_156565_Par_12_v156565",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156565_Par_12"
