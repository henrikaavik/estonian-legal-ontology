        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Notarite Koja koosolek ja eestseisus võivad oma pädevuse piires koja ülesannete täitmiseks moodustada notaritest ja notarikandidaatidest nõuandvaid komisjone ja töögruppe ning kaasata nende tegevusse eksperte. Notarite Koja koosolek ja eestseisus võivad oma pädevuse piires koja ülesannete täitmiseks moodustada notaritest ja notarikandidaatidest nõuandvaid komisjone ja töögruppe ning kaasata nende tegevusse eksperte.",
      "rdfs:label": {
        "@value": "Reg_156565_Par_25 (redaktsioon 156565)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156565",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156565",
      "estleg:sourceAct": "Notarite Koja põhikirja kinnitamine",
      "estleg:provisionRef": "Reg_156565 § 25",
      "estleg:partOfAct": {
