      "estleg:versionValidFrom": {
        "@value": "2025-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Organisatsioon ja partner ei tohi olla omavahel seotud isikud tulumaksuseaduse § 8 lõike 1 tähenduses. Organisatsioon ja partner ei tohi olla omavahel seotud isikud tulumaksuseaduse § 8 lõike 1 tähenduses.",
      "rdfs:label": {
        "@value": "Reg_1060598_Par_6 (redaktsioon 1060598)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060598",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060598",
      "estleg:sourceAct": "Euroopa Liidu põllumajandustoodete teavitus- ja müügiedendusmeetmete lihtprogrammi rakendamisel osaleva partneri valimise kord",
      "estleg:provisionRef": "Reg_1060598 § 6",
