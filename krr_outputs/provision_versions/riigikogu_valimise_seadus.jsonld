      "rdfs:label": {
        "@value": "RIIGIK_2_Par_32 (redaktsioon 706045)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "706045",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIK_2_Par_32_v733592"
