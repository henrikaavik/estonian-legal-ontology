      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RIIGIK_2_Par_37_v103012020013",
      "@type": [
        "owl:NamedIndividual",
