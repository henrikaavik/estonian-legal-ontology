        "@language": "et"
      },
      "dc:source": "Hädaabiteadete menetlemise kord ja hädaabiteadete menetlemise toimimisele esitatavad nõuded"
    },
    {
      "@id": "estleg:Reg_1039014_Par_1_v1039014",
      "@type": [
