    {
      "@id": "estleg:Reg_158669_Par_8_v158669",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158669_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Doonori vere ABO-veregrupp määratakse igal vere loovutamisel, neist esimesel korral koos pöördreaktsiooniga. RT I 2011-03-07 1 107032011001 2011-03-10 Doonori vere ABO-veregrupp määratakse igal vere loovutamisel, neist esimesel korral koos pöördreaktsiooniga. 2 (2) Esimest korda verd loovutanud doonori vere ABO-veregrupp määratakse kahe erineva testiga. RT I 2023-11-22 3 122112023003 2023-11-25 Esimest korda verd loovutanud doonori vere ABO-veregrupp määratakse kahe erineva testiga. 3 (3) Kehtetu - RT I 2023-11-22 3 122112023003 2023-11-25 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_158669_Par_8 (redaktsioon 158669)",
        "@language": "et"
      },
