    {
      "@id": "estleg:Reg_1057583_Par_6_v1057583",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057583_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Omavalitsusüksus peab kasutama hüvitist sihtotstarbeliselt §-s 2 sätestatud eesmärgil. Omavalitsusüksus peab kasutama hüvitist sihtotstarbeliselt §-s 2 sätestatud eesmärgil. 2 (2) Omavalitsusüksus peab hüvitist kasutama kaasavalt, eesmärgipäraselt ja läbipaistvalt. Omavalitsusüksus peab hüvitist kasutama kaasavalt, eesmärgipäraselt ja läbipaistvalt.",
      "rdfs:label": {
        "@value": "Reg_1057583_Par_6 (redaktsioon 1057583)",
