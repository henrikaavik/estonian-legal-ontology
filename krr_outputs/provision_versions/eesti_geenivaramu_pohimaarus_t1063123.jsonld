        "@value": "2026-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Geenivaramu vastutav töötleja on Tartu Ülikool. Geenivaramu vastutav töötleja on Tartu Ülikool.",
      "rdfs:label": {
        "@value": "Reg_1063123_Par_3 (redaktsioon 1063123)",
        "@language": "et"
      },
