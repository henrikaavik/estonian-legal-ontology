      "estleg:sourceAct": "Kutseõppeasutuse nõunike kogu moodustamise ja tegutsemise kord",
      "estleg:provisionRef": "Reg_1019677 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1019677_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1019677_Par_13_v1019677",
      "@type": [
        "owl:NamedIndividual",
