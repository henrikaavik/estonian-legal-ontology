      }
    },
    {
      "@id": "estleg:Reg_1019677_Par_18_v1019677",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1019677_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 1. jaanuari 2014. a moodustatud kooli nõukogud, mille koosseis vastab kutseõppeasutuse seaduse § 18 lõikes 2 ja käesoleva määruse §-s 3 sätestatud nõuetele, täidavad 1. jaanuarist 2014. a nõunike kogu ülesandeid kuni nõunike kogu moodustamiseni, kuid mitte kauem kui oma volituste lõpuni. Enne 1. jaanuari 2014. a moodustatud kooli nõukogud, mille koosseis vastab kutseõppeasutuse seaduse § 18 lõikes 2 ja käesoleva määruse §-s 3 sätestatud nõuetele, täidavad 1. jaanuarist 2014. a nõunike kogu ülesandeid kuni nõunike kogu moodustamiseni, kuid mitte kauem kui oma volituste lõpuni.",
      "rdfs:label": {
