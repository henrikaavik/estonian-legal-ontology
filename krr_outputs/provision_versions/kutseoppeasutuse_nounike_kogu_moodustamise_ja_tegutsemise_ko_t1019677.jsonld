      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Üksikute küsimuste läbitöötamiseks võib nõunike kogu kaasata oma töösse asjatundjaid ja eksperte, kelle ettepanekud on soovitusliku iseloomuga. Üksikute küsimuste läbitöötamiseks võib nõunike kogu kaasata oma töösse asjatundjaid ja eksperte, kelle ettepanekud on soovitusliku iseloomuga.",
      "rdfs:label": {
        "@value": "Reg_1019677_Par_16 (redaktsioon 1019677)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1019677",
