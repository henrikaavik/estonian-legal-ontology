      }
    },
    {
      "@id": "estleg:Reg_1019677_Par_9_v1019677",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1019677_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nõunike kogu tehnilise teenindamise korraldab kool vastavalt nõunike kogu vajadusele, lähtudes kooli asjaajamiskorrast. Nõunike kogu tehnilise teenindamise korraldab kool vastavalt nõunike kogu vajadusele, lähtudes kooli asjaajamiskorrast. 2 (2) Nõunike kogu kirjad väljastatakse kooli kirjablanketil, millele kirjutab alla nõunike kogu esimees. Nõunike kogu kirjad väljastatakse kooli kirjablanketil, millele kirjutab alla nõunike kogu esimees.",
      "rdfs:label": {
        "@value": "Reg_1019677_Par_9 (redaktsioon 1019677)",
