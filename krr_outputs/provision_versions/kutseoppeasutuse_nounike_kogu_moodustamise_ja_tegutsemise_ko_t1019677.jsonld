    },
    {
      "@id": "estleg:Reg_1019677_Par_17_v1019677",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1019677_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nõunike kogu koosolekud protokollitakse. Nõunike kogu koosolekud protokollitakse. 2 (2) Protokollile kirjutavad alla koosoleku juhataja ja protokollija. Protokollile kirjutavad alla koosoleku juhataja ja protokollija. 3 (3) Koosoleku allkirjastatud protokoll edastatakse hiljemalt viiendal tööpäeval pärast nõunike kogu koosolekut nõunike kogu liikmetele ning kooli pidajale. Koosoleku allkirjastatud protokoll edastatakse hiljemalt viiendal tööpäeval pärast nõunike kogu koosolekut nõunike kogu liikmetele ning kooli pidajale. 4 (4) Nõunike kogu koosoleku protokolli originaaleksemplar säilitatakse vastavalt kooli asjaajamiskorrale. Nõunike kogu koosoleku protokolli originaaleksemplar säilitatakse vastavalt kooli asjaajamiskorrale.",
      "rdfs:label": {
        "@value": "Reg_1019677_Par_17 (redaktsioon 1019677)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1019677",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1019677",
      "estleg:sourceAct": "Kutseõppeasutuse nõunike kogu moodustamise ja tegutsemise kord",
      "estleg:provisionRef": "Reg_1019677 § 17",
      "estleg:partOfAct": {
