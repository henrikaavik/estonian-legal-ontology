      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõunike kogu valib oma esindaja või esindajad, kellel on õigus osa võtta kooli nõukogu istungitest. Nõunike kogu valib oma esindaja või esindajad, kellel on õigus osa võtta kooli nõukogu istungitest.",
