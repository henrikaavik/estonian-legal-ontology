      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kahekütusemootor käesoleva määruse tähenduses on survesüütega sisepõlemismootor, mis töötab vedelkütuse põlemisel diiselmootori põhimõttel ja gaaskütuse põletamisel ottomootori põhimõttel. Kahekütusemootor käesoleva määruse tähenduses on survesüütega sisepõlemismootor, mis töötab vedelkütuse põlemisel diiselmootori põhimõttel ja gaaskütuse põletamisel ottomootori põhimõttel.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_13 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
