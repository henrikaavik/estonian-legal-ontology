      "estleg:provisionRef": "Reg_1040729 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_14_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Gaasiturbiin käesoleva määruse tähenduses on pöörlev masin, mille abil muudetakse soojusenergia mehaaniliseks tööks. Gaasiturbiin koosneb peamiselt kompressorist, termilisest seadmest, milles oksüdeeritakse kütust töövedeliku soojendamiseks, ning turbiinist, mis hõlmab nii avatud kui ka kombineeritud tsükliga gaasiturbiine ja koostootmisrežiimil gaasiturbiine, koos lisasüütega või ilma. Gaasiturbiin käesoleva määruse tähenduses on pöörlev masin, mille abil muudetakse soojusenergia mehaaniliseks tööks. Gaasiturbiin koosneb peamiselt kompressorist, termilisest seadmest, milles oksüdeeritakse kütust töövedeliku soojendamiseks, ning turbiinist, mis hõlmab nii avatud kui ka kombineeritud tsükliga gaasiturbiine ja koostootmisrežiimil gaasiturbiine, koos lisasüütega või ilma.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_14 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_15_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väike eraldatud võrk käesoleva määruse tähenduses on võrk, kus elektri tarbimine oli 1996. aastal väiksem kui 3000 GWh ja milles vähem kui 5% iga-aastasest tarbimisest kaetakse ühenduste kaudu teistest võrkudest. Väike eraldatud võrk käesoleva määruse tähenduses on võrk, kus elektri tarbimine oli 1996. aastal väiksem kui 3000 GWh ja milles vähem kui 5% iga-aastasest tarbimisest kaetakse ühenduste kaudu teistest võrkudest.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_15 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
