      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rafineerimistehase kütus käesoleva määruse tähenduses on toornafta rafineerimise destilleerimis- ja töötlemisetapis tekkivad tahked, vedelad või gaasilised põlevmaterjalid, sealhulgas rafineerimistehase küttegaas, sünteesgaas, rafineerimistehase õlid ja naftakoks. Rafineerimistehase kütus käesoleva määruse tähenduses on toornafta rafineerimise destilleerimis- ja töötlemisetapis tekkivad tahked, vedelad või gaasilised põlevmaterjalid, sealhulgas rafineerimistehase küttegaas, sünteesgaas, rafineerimistehase õlid ja naftakoks.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_18 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_19_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jäätmed käesoleva määruse tähenduses on mis tahes ained või esemed, mille valdaja ära viskab, kavatseb ära visata või on kohustatud ära viskama. Jäätmed käesoleva määruse tähenduses on mis tahes ained või esemed, mille valdaja ära viskab, kavatseb ära visata või on kohustatud ära viskama.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_19 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_2_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kahest või enamast uuest keskmise võimsusega põletusseadmest koosnevat kombinatsiooni käsitletakse käesoleva määruse mõistes ühe keskmise võimsusega põletusseadmena ning selle summaarne nimisoojusvõimsus saadakse nende seadmete nimisoojusvõimsuste liitmisel, kui: 1 1) selliste keskmise võimsusega põletusseadmete heitgaasid väljutatakse ühise korstna kaudu, või 2 2) tehnilisi ja majanduslikke tegureid arvesse võttes on õhusaasteloa või keskkonnakompleksloa andja (edaspidi loa andja) andnud hinnangu, et selliste keskmise võimsusega põletusseadmete heitgaase on võimalik väljutada ühise korstna kaudu. Kahest või enamast uuest keskmise võimsusega põletusseadmest koosnevat kombinatsiooni käsitletakse käesoleva määruse mõistes ühe keskmise võimsusega põletusseadmena ning selle summaarne nimisoojusvõimsus saadakse nende seadmete nimisoojusvõimsuste liitmisel, kui: selliste keskmise võimsusega põletusseadmete heitgaasid väljutatakse ühise korstna kaudu, või tehnilisi ja majanduslikke tegureid arvesse võttes on õhusaasteloa või keskkonnakompleksloa andja (edaspidi loa andja) andnud hinnangu, et selliste keskmise võimsusega põletusseadmete heitgaase on võimalik väljutada ühise korstna kaudu.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_2 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_20_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Biomass käesoleva määruse tähenduses on tooted, mis koosnevad põllumajandusest või metsandusest pärit taimsest materjalist, mida saab kasutada kütusena neis sisalduva energia kasutamiseks, ning järgmised jäätmed: 1 1) põllumajanduse ja metsanduse taimsed jäätmed; 2 2) toiduainetööstuse taimsed jäägid, kui tekkiv soojus kasutatakse ära; 3 3) värske paberimassi tootmise ja pabermassist paberi tootmise kiulised taimsed jäägid, kui need põletatakse nende tekitamise kohas ja tekkiv soojus taaskasutatakse; 4 4) korgijäätmed; 5 5) puidujäätmed, välja arvatud need, mis võivad puidukaitsevahenditega töötlemise või puidupinna katmise tulemusena sisaldada halogeenitud orgaanilisi ühendeid või raskmetalle, sealhulgas eelkõige ehitamisel ja lammutamisel tekkivad puidujäätmed. Biomass käesoleva määruse tähenduses on tooted, mis koosnevad põllumajandusest või metsandusest pärit taimsest materjalist, mida saab kasutada kütusena neis sisalduva energia kasutamiseks, ning järgmised jäätmed: põllumajanduse ja metsanduse taimsed jäätmed; toiduainetööstuse taimsed jäägid, kui tekkiv soojus kasutatakse ära; värske paberimassi tootmise ja pabermassist paberi tootmise kiulised taimsed jäägid, kui need põletatakse nende tekitamise kohas ja tekkiv soojus taaskasutatakse; korgijäätmed; puidujäätmed, välja arvatud need, mis võivad puidukaitsevahenditega töötlemise või puidupinna katmise tulemusena sisaldada halogeenitud orgaanilisi ühendeid või raskmetalle, sealhulgas eelkõige ehitamisel ja lammutamisel tekkivad puidujäätmed.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_20 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_21_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Gaasiõli käesoleva määruse tähenduses on: 1 1) igasugune vedelkütus, mis kuulub KN-koodide 2710 19 25, 2710 19 29, 2710 19 47, 2710 19 48, 2710 20 17 või 2710 20 19 alla; 2 2) igasugune vedelkütus, mille mahust destilleerub ASTM D86 meetodi järgi temperatuuril 250 ºC vähem kui 65% (sealhulgas destillatsioonikaod) ja temperatuuril 350 ºC vähemalt 85% (sealhulgas destillatsioonikaod). Gaasiõli käesoleva määruse tähenduses on: igasugune vedelkütus, mis kuulub KN-koodide 2710 19 25, 2710 19 29, 2710 19 47, 2710 19 48, 2710 20 17 või 2710 20 19 alla; igasugune vedelkütus, mille mahust destilleerub ASTM D86 meetodi järgi temperatuuril 250 ºC vähem kui 65% (sealhulgas destillatsioonikaod) ja temperatuuril 350 ºC vähemalt 85% (sealhulgas destillatsioonikaod).",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_21 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_22_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maagaas käesoleva määruse tähenduses on looduslik metaan inertsete gaaside ja muude ainete sisaldusega kuni 20 mahuprotsenti. Maagaas käesoleva määruse tähenduses on looduslik metaan inertsete gaaside ja muude ainete sisaldusega kuni 20 mahuprotsenti.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_22 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_23_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raske kütteõli käesoleva määruse tähenduses on: 1 1) igasugune vedelkütus, mis kuulub KN-koodi 2710 19 51 kuni 2710 19 68, 2710 20 31, 2710 20 35 või 2710 20 39 alla; 2 2) igasugune vedelkütus, välja arvatud käesoleva määruse §-s 21 määratletud gaasiõli, mis oma destillatsiooniulatuse tõttu kuulub kütusena kasutatavate raskeõlide kategooriasse ja mille mahust vähem kui 65% (sealhulgas destillatsioonikaod) destilleerub temperatuuril 250 ºC ASTM D86 meetodi järgi. Kui destillatsiooni ei saa ASTM D86 meetodi järgi teha, klassifitseeritakse naftasaadus samuti raske kütteõlina. Raske kütteõli käesoleva määruse tähenduses on: igasugune vedelkütus, mis kuulub KN-koodi 2710 19 51 kuni 2710 19 68, 2710 20 31, 2710 20 35 või 2710 20 39 alla; igasugune vedelkütus, välja arvatud käesoleva määruse §-s 21 määratletud gaasiõli, mis oma destillatsiooniulatuse tõttu kuulub kütusena kasutatavate raskeõlide kategooriasse ja mille mahust vähem kui 65% (sealhulgas destillatsioonikaod) destilleerub temperatuuril 250 ºC ASTM D86 meetodi järgi. Kui destillatsiooni ei saa ASTM D86 meetodi järgi teha, klassifitseeritakse naftasaadus samuti raske kütteõlina.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_23 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_24_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Töötunnid käesoleva määruse tähenduses on tundides väljendatud aeg, mille jooksul põletusseade töötab ja väljutab heidet õhku, välja arvatud käivitus- ja seiskamisperioodid. Töötunnid käesoleva määruse tähenduses on tundides väljendatud aeg, mille jooksul põletusseade töötab ja väljutab heidet õhku, välja arvatud käivitus- ja seiskamisperioodid.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_24 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_25_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käitaja käesoleva määruse tähenduses on isik, kes käitab või valdab põletusseadet või kellele on antud majanduslik otsustusõigus seadme tehnilise toimimise üle. Käitaja käesoleva määruse tähenduses on isik, kes käitab või valdab põletusseadet või kellele on antud majanduslik otsustusõigus seadme tehnilise toimimise üle.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_25 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_26_v1040729",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040729_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Saasteainete heite piirväärtused olemasolevatele keskmise võimsusega põletusseadmetele on esitatud käesoleva määruse lisas 1. Saasteainete heite piirväärtused olemasolevatele keskmise võimsusega põletusseadmetele on esitatud käesoleva määruse lisas 1. 2 (2) Käesoleva määruse lisas 1 sätestatud heite piirväärtusi ei kohaldata põletusseadmetele, mida käitatakse kuni 500 töötundi aastas, arvutatuna viie aasta libiseva keskmisena, kui käitaja esitab allkirjastatud kinnituse loa andjale, et põletusseadet käitatakse maksimaalselt nimetatud tundide arvu piires. Käesoleva määruse lisas 1 sätestatud heite piirväärtusi ei kohaldata põletusseadmetele, mida käitatakse kuni 500 töötundi aastas, arvutatuna viie aasta libiseva keskmisena, kui käitaja esitab allkirjastatud kinnituse loa andjale, et põletusseadet käitatakse maksimaalselt nimetatud tundide arvu piires. 3 (3) Loa andja võib käesoleva paragrahvi lõikes 2 nimetatud erandit pikendada kuni 1000 töötunnini aastas juhul, kui käitaja esitab loa andjale kinnituse, et põletusseadet käitatakse maksimaalselt nimetatud tundide arvu piires, järgmistel juhtudel: 1 1) põletusseadet kasutatakse saare peamise elektrienergia varuallikana ning ilmneb võrku ühendatud saare elektrivarustuse rike; 2 2) põletusseadet kasutatakse erakordselt külmades ilmastikuoludes soojuse tootmiseks. Loa andja võib käesoleva paragrahvi lõikes 2 nimetatud erandit pikendada kuni 1000 töötunnini aastas juhul, kui käitaja esitab loa andjale kinnituse, et põletusseadet käitatakse maksimaalselt nimetatud tundide arvu piires, järgmistel juhtudel: põletusseadet kasutatakse saare peamise elektrienergia varuallikana ning ilmneb võrku ühendatud saare elektrivarustuse rike; põletusseadet kasutatakse erakordselt külmades ilmastikuoludes soojuse tootmiseks. 4 (4) Käesoleva paragrahvi lõigete 2 ja 3 kohaldamisel ei rakendu käesoleva määruse lisas 1 sätestatud heite piirväärtused, kuid osakeste heite piirväärtus tahket kütust kasutava põletusseadme puhul on 200 mg/Nm³. Käesoleva paragrahvi lõigete 2 ja 3 kohaldamisel ei rakendu käesoleva määruse lisas 1 sätestatud heite piirväärtused, kuid osakeste heite piirväärtus tahket kütust kasutava põletusseadme puhul on 200 mg/Nm³.",
      "rdfs:label": {
        "@value": "Reg_1040729_Par_26 (redaktsioon 1040729)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040729",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040729",
      "estleg:sourceAct": "Väljaspool tööstusheite seaduse reguleerimisala olevatest põletusseadmetest väljutatavate saasteainete heite piirväärtused, saasteainete heite seirenõuded ja heite piirväärtuste järgimise kriteeriumid",
      "estleg:provisionRef": "Reg_1040729 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
