      "estleg:provisionRef": "Reg_1040729 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040729_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040729_Par_16_v1040729",
      "@type": [
