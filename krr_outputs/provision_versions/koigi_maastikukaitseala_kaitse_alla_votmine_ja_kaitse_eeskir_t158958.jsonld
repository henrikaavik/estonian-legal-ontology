      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158958",
      "estleg:sourceAct": "Koigi maastikukaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158958 § 13",
