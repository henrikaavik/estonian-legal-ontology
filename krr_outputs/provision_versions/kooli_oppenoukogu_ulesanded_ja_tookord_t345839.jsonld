      "estleg:sourceAct": "Kooli õppenõukogu ülesanded ja töökord",
      "estleg:provisionRef": "Reg_345839 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345839_Map"
      }
    },
    {
      "@id": "estleg:Reg_345839_Par_8_8_v345839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
