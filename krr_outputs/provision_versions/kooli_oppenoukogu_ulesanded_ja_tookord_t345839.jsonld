    {
      "@id": "estleg:Reg_345839_Par_6_v345839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345839_Par_6"
