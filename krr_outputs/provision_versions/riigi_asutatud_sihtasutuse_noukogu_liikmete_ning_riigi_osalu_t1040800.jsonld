  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_riigi_asutatud_sihtasutuse_noukogu_liikmete_ning_riigi_osalu_t1040800_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigi asutatud sihtasutuse nõukogu liikmete ning riigi osalusega äriühingu nõukogu organi töös osalevate nõukogu liikmete tasustamise kord ja tasude piirmäärad (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigi asutatud sihtasutuse nõukogu liikmete ning riigi osalusega äriühingu nõukogu organi töös osalevate nõukogu liikmete tasustamise kord ja tasude piirmäärad"
    },
    {
      "@id": "estleg:Reg_1040800_Par_1_v1040800",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040800_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus sätestab riigi asutatud sihtasutuse nõukogu (edaspidi sihtasutuse nõukogu) liikmetele makstavate tasude piirmäärad ja tasustamise korra ning riigi äriühingu ja sellise äriühingu, kus riigil on vähemalt otsustusõigus, nõukogu (edaspidi äriühingu nõukogu) liikmetele nõukogu organi töös osalemise eest makstavate tasude piirmäärad ja tasustamise korra. Määrus sätestab riigi asutatud sihtasutuse nõukogu (edaspidi sihtasutuse nõukogu) liikmetele makstavate tasude piirmäärad ja tasustamise korra ning riigi äriühingu ja sellise äriühingu, kus riigil on vähemalt otsustusõigus, nõukogu (edaspidi äriühingu nõukogu) liikmetele nõukogu organi töös osalemise eest makstavate tasude piirmäärad ja tasustamise korra.",
      "rdfs:label": {
        "@value": "Reg_1040800_Par_1 (redaktsioon 1040800)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040800",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040800",
      "estleg:sourceAct": "Riigi asutatud sihtasutuse nõukogu liikmete ning riigi osalusega äriühingu nõukogu organi töös osalevate nõukogu liikmete tasustamise kord ja tasude piirmäärad",
      "estleg:provisionRef": "Reg_1040800 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040800_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040800_Par_2_v1040800",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040800_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtasutuse nõukogu esimehele makstav tasu ei või ületada 2000 eurot kuus. Sihtasutuse nõukogu liikmele võib maksta kuni 75% nõukogu esimehele makstavat tasust, kuid mitte rohkem kui 1000 eurot kuus. RT I 2025-02-19 6 119022025006 2025-02-22 Sihtasutuse nõukogu esimehele makstav tasu ei või ületada 2000 eurot kuus. Sihtasutuse nõukogu liikmele võib maksta kuni 75% nõukogu esimehele makstavat tasust, kuid mitte rohkem kui 1000 eurot kuus.",
      "rdfs:label": {
        "@value": "Reg_1040800_Par_2 (redaktsioon 1040800)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040800",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040800",
      "estleg:sourceAct": "Riigi asutatud sihtasutuse nõukogu liikmete ning riigi osalusega äriühingu nõukogu organi töös osalevate nõukogu liikmete tasustamise kord ja tasude piirmäärad",
      "estleg:provisionRef": "Reg_1040800 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040800_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040800_Par_3_v1040800",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040800_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigi sihtasutuse nõukogu liikmetele määrab tasu asutajaõiguste teostaja. Riigi osalusel asutatud sihtasutuse nõukogu liikmetele määravad tasu asutajad ühiselt, juhindudes §-s 2 nimetatud piirmääradest. Riigi sihtasutuse nõukogu liikmetele määrab tasu asutajaõiguste teostaja. Riigi osalusel asutatud sihtasutuse nõukogu liikmetele määravad tasu asutajad ühiselt, juhindudes §-s 2 nimetatud piirmääradest. 2 (2) Ühe ja sama sihtasutuse nõukogu liikmetele määratakse võrdne tasu. Nõukogu esimehele võib määrata suurema tasu, lähtudes §-s 2 toodud piirmääradest. Ühe ja sama sihtasutuse nõukogu liikmetele määratakse võrdne tasu. Nõukogu esimehele võib määrata suurema tasu, lähtudes §-s 2 toodud piirmääradest.",
      "rdfs:label": {
        "@value": "Reg_1040800_Par_3 (redaktsioon 1040800)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040800",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040800",
      "estleg:sourceAct": "Riigi asutatud sihtasutuse nõukogu liikmete ning riigi osalusega äriühingu nõukogu organi töös osalevate nõukogu liikmete tasustamise kord ja tasude piirmäärad",
      "estleg:provisionRef": "Reg_1040800 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040800_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040800_Par_4_v1040800",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040800_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtasutuse või äriühingu nõukogu liikmele võib määrata täiendava tasu seoses tema osalemisega audiitortegevuse seaduses nimetatud auditikomitee (edaspidi auditikomitee) või nõukogu muu organi tegevuses. Sihtasutuse või äriühingu nõukogu liikmele võib määrata täiendava tasu seoses tema osalemisega audiitortegevuse seaduses nimetatud auditikomitee (edaspidi auditikomitee) või nõukogu muu organi tegevuses. 2 (2) Lõikes 1 nimetatud tasu määratakse sihtasutuse nõukogu liikmele § 3 lõikes 1 sätestatud korras. Äriühingu nõukogu liikme lõikes 1 nimetatud tasu suuruse otsustab osaluse valitseja ainuaktsionäri või ainuosaniku otsusega või äriühingu üldkoosolek. Lõikes 1 nimetatud tasu määratakse sihtasutuse nõukogu liikmele § 3 lõikes 1 sätestatud korras. Äriühingu nõukogu liikme lõikes 1 nimetatud tasu suuruse otsustab osaluse valitseja ainuaktsionäri või ainuosaniku otsusega või äriühingu üldkoosolek. 3 (3) Täiendavat tasu makstakse auditikomitee või nõukogu muu organi koosolekul osalemise kuu eest. Tasu suurus kuus ei või ületada 25% sihtasutuse nõukogu liikmele § 3 lõikes 1 sätestatud korras määratud tasu suurusest või 25% äriühingu nõukogu liikmele ainuaktsionäri või ainuosaniku otsusega või äriühingu üldkoosoleku otsusega määratud nõukogu liikme tasust. Täiendavat tasu makstakse auditikomitee või nõukogu muu organi koosolekul osalemise kuu eest. Tasu suurus kuus ei või ületada 25% sihtasutuse nõukogu liikmele § 3 lõikes 1 sätestatud korras määratud tasu suurusest või 25% äriühingu nõukogu liikmele ainuaktsionäri või ainuosaniku otsusega või äriühingu üldkoosoleku otsusega määratud nõukogu liikme tasust. 4 (4) Sihtasutuse või äriühingu nõukogu liikmele auditikomitee ja muude nõukogu organite tegevuses osalemise eest määratud summaarne tasu kuus ei või ületada 50% sihtasutuse nõukogu liikmele § 3 lõikes 1 sätestatud korras määratud tasu suurusest või 50% äriühingu nõukogu liikmele ainuaktsionäri või ainuosaniku otsusega või äriühingu üldkoosoleku otsusega määratud nõukogu liikme tasust. Sihtasutuse või äriühingu nõukogu liikmele auditikomitee ja muude nõukogu organite tegevuses osalemise eest määratud summaarne tasu kuus ei või ületada 50% sihtasutuse nõukogu liikmele § 3 lõikes 1 sätestatud korras määratud tasu suurusest või 50% äriühingu nõukogu liikmele ainuaktsionäri või ainuosaniku otsusega või äriühingu üldkoosoleku otsusega määratud nõukogu liikme tasust. 5 (5) Auditikomitee ja nõukogu muu organi esimehele võib kohaldada lõigetes 3 ja 4 sätestatust 50% suuremat tasu. Auditikomitee ja nõukogu muu organi esimehele võib kohaldada lõigetes 3 ja 4 sätestatust 50% suuremat tasu.",
      "rdfs:label": {
        "@value": "Reg_1040800_Par_4 (redaktsioon 1040800)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040800",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040800",
      "estleg:sourceAct": "Riigi asutatud sihtasutuse nõukogu liikmete ning riigi osalusega äriühingu nõukogu organi töös osalevate nõukogu liikmete tasustamise kord ja tasude piirmäärad",
      "estleg:provisionRef": "Reg_1040800 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040800_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040800_Par_5_v1040800",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040800_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tasu makstakse üks kord kuus. Tasu makstakse üks kord kuus. 2 (2) Isikule, kes nõukogu või nõukogu organi otsuste vastuvõtmisel ei osalenud, nõukogu või nõukogu organi koosoleku toimumise kuu eest tasu ei maksta. Kui samal kuul toimub mitu koosolekut, makstakse tasu proportsionaalselt osaletud koosolekute arvuga. Korralduse isikule tasu maksmata jätmiseks teeb nõukogu esimees või tema puudumisel koosoleku juhataja pärast nõukogu või nõukogu organi koosoleku toimumist. RT I 2025-02-19 6 119022025006 2025-02-22 Isikule, kes nõukogu või nõukogu organi otsuste vastuvõtmisel ei osalenud, nõukogu või nõukogu organi koosoleku toimumise kuu eest tasu ei maksta. Kui samal kuul toimub mitu koosolekut, makstakse tasu proportsionaalselt osaletud koosolekute arvuga. Korralduse isikule tasu maksmata jätmiseks teeb nõukogu esimees või tema puudumisel koosoleku juhataja pärast nõukogu või nõukogu organi koosoleku toimumist. 3 (3) Kui nõukogu liige ei täida riigivaraseaduse § 89 lõike 1 punktis 7 sätestatud kohustust ühe kuu jooksul pärast nõukogu koosoleku toimumist, võib nõukogu esimees teha korralduse peatada tasu maksmine või vähendada tasu proportsionaalselt perioodiga, mille jooksul nimetatud kohustust ei ole täidetud. RT I 2025-02-19 6 119022025006 2025-02-22 Kui nõukogu liige ei täida riigivaraseaduse § 89 lõike 1 punktis 7 sätestatud kohustust ühe kuu jooksul pärast nõukogu koosoleku toimumist, võib nõukogu esimees teha korralduse peatada tasu maksmine või vähendada tasu proportsionaalselt perioodiga, mille jooksul nimetatud kohustust ei ole täidetud.",
      "rdfs:label": {
        "@value": "Reg_1040800_Par_5 (redaktsioon 1040800)",
        "@language": "et"
      },
