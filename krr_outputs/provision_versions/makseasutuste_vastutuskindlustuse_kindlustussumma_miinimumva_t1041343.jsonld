      "dc:source": "Makseasutuste vastutuskindlustuse kindlustussumma miinimumväärtuse arvutamise kord ja metoodika ning tagatise rakendamise tingimused"
    },
    {
      "@id": "estleg:Reg_1041343_Par_1_v1041343",
