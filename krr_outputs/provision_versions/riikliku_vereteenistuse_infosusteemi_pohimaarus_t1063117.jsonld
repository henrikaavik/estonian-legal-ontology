      },
      "estleg:versionText": "Määrus jõustub 1. aprillil 2026. a. Määrus jõustub 1. aprillil 2026. a.",
      "rdfs:label": {
        "@value": "Reg_1063117_Par_20 (redaktsioon 1063117)",
