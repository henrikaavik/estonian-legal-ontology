      }
    },
    {
      "@id": "estleg:Reg_1063117_Par_8_v1063117",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1063117_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rahvastikuregister edastab infosüsteemi: 1 1) doonori ja retsipiendi isikut identifitseerivad andmed; 2 2) doonori isiku esindusõiguse ja teovõime andmed; 3 3) doonori surma registreerimise kande numbri. Rahvastikuregister edastab infosüsteemi: doonori ja retsipiendi isikut identifitseerivad andmed; doonori isiku esindusõiguse ja teovõime andmed; doonori surma registreerimise kande numbri. 2 (2) Retseptikeskus edastab infosüsteemi: 1 1) doonorile apteegist väljastatud ravimi ja selle väljastamise aluseks oleva retsepti andmed; 2 2) doonorile apteegist väljastatud või meditsiiniseadme väljastanud muu isiku väljastatud meditsiiniseadme ja selle väljastamise aluseks oleva meditsiiniseadme kaardi andmed. Retseptikeskus edastab infosüsteemi: doonorile apteegist väljastatud ravimi ja selle väljastamise aluseks oleva retsepti andmed; doonorile apteegist väljastatud või meditsiiniseadme väljastanud muu isiku väljastatud meditsiiniseadme ja selle väljastamise aluseks oleva meditsiiniseadme kaardi andmed. 3 (3) Andmevahetus andmeandjatega toimub riigi infosüsteemide andmevahetuskihi kaudu. Andmevahetus andmeandjatega toimub riigi infosüsteemide andmevahetuskihi kaudu.",
      "rdfs:label": {
        "@value": "Reg_1063117_Par_8 (redaktsioon 1063117)",
        "@language": "et"
      },
