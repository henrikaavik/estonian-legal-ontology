      },
      "estleg:versionText": "Õpilase või piiratud teovõimega õpilase vanema taotlusel väljastatakse õpilasele tasuta kooli õpilaspilet. Õpilaspileti väljaandmise korra ja õpilaspileti vormi",
      "rdfs:label": {
        "@value": "PGS_Par_59 (redaktsioon 13332410)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13332410",
