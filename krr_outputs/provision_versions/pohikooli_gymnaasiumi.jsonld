    {
      "@id": "estleg:PGS_Par_6_v12851808",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PGS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Koolis toimub õppetegevus päevases, õhtuses ja kaugõppe vormis. (2) Põhihariduse omandamine õhtuses ja kaugõppe vormis ning kooli lõpetamine eksternina on lubatud koolikohustusliku vanuse ületanud isikutel, kes pole omandanud põhiharidust. Üldkeskhariduse omandamine õhtuses ja kaugõppevormis ning kooli lõpetamine eksternina on lubatud põhihariduse omandanud isikutel. Põhikooli ja gümnaasiumi õhtuses ja kaugõppe vormis õppimise, samuti kooli eksternina lõpetamise tingimused ja korra",
      "rdfs:label": {
        "@value": "PGS_Par_6 (redaktsioon 12851808)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12851808",
