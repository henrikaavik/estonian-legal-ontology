        "@value": "2009-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljasaatmist korraldav valitsusasutus esitab lennujaama asukohajärgse riigi pädevale asutusele käesoleva määruse lisale vastava vormi kohase kirjaliku taotluse väljasaadetava saatjaga või saatjata läbisõiduks õhuteed pidi. Väljasaatmist korraldav valitsusasutus esitab lennujaama asukohajärgse riigi pädevale asutusele käesoleva määruse lisale vastava vormi kohase kirjaliku taotluse väljasaadetava saatjaga või saatjata läbisõiduks õhuteed pidi.",
      "rdfs:label": {
        "@value": "Reg_308997_Par_4 (redaktsioon 308997)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308997",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308997",
      "estleg:sourceAct": "Eestist läbisõiduks õhuteed pidi loa andmiseks volitatud asutus, loa andmise kooskõlastamise kord, Eestist läbisõiduks loa andmist kooskõlastavad Siseministeeriumi valitsemisala asutused ja taotluse vorm õhuteed pidi läbisõiduks",
      "estleg:provisionRef": "Reg_308997 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308997_Map"
      }
    },
