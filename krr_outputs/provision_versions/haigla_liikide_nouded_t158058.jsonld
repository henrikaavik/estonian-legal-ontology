      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sisehaiguste tervishoiuteenuste osutamine piirkondlikus haiglas peab vastama käesoleva määruse §-s 4 kehtestatud nõuetele. Sisehaiguste tervishoiuteenuste osutamine piirkondlikus haiglas peab vastama käesoleva määruse §-s 4 kehtestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_33 (redaktsioon 158058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158058",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158058",
