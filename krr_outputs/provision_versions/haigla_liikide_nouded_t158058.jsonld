      "estleg:sourceAct": "Haigla liikide nõuded",
      "estleg:provisionRef": "Reg_158058 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158058_Map"
      }
    },
    {
      "@id": "estleg:Reg_158058_Par_3_v158058",
