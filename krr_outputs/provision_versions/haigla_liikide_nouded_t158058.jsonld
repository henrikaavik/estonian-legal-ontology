    {
      "@id": "estleg:Reg_158058_Par_47_v158058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158058_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piirkondlikus haiglas osutatakse kõiki üldkirurgia tervishoiuteenuseid. Piirkondlikus haiglas osutatakse kõiki üldkirurgia tervishoiuteenuseid. 2 (2) Üldkirurgia tervishoiuteenuste osutamine peab vastama käesoleva määruse §-s 5 kehtestatud nõuetele, välja arvatud lõigetes 1–3, 5 ja 6 kehtestatud nõuded. Üldkirurgia tervishoiuteenuste osutamine peab vastama käesoleva määruse §-s 5 kehtestatud nõuetele, välja arvatud lõigetes 1–3, 5 ja 6 kehtestatud nõuded. 3 (3) Üldkirurgia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama üldkirurgid, üldõed ja operatsiooniõed. Üldkirurgia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama üldkirurgid, üldõed ja operatsiooniõed.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_47 (redaktsioon 158058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158058",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158058",
      "estleg:sourceAct": "Haigla liikide nõuded",
      "estleg:provisionRef": "Reg_158058 § 47",
      "estleg:partOfAct": {
