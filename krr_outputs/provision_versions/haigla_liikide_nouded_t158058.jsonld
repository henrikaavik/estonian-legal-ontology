    {
      "@id": "estleg:Reg_158058_Par_77_v158058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158058_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohalikus haiglas osutatakse kõiki sisehaiguste tervishoiuteenuseid. Kohalikus haiglas osutatakse kõiki sisehaiguste tervishoiuteenuseid. 2 (2) Sisehaiguste tervishoiuteenuste osutamiseks peab kohalikus haiglas olema käesoleva määruse § 4 lõikes 2 kehtestatud nõuetele vastav aparatuur ja sisustus. Sisehaiguste tervishoiuteenuste osutamiseks peab kohalikus haiglas olema käesoleva määruse § 4 lõikes 2 kehtestatud nõuetele vastav aparatuur ja sisustus. 3 (3) Sisehaiguste tervishoiuteenuste osutamiseks peavad kohalikus haiglas töötama sisehaiguste arstid ja üldõed. Sisehaiguste tervishoiuteenuste osutamiseks peavad kohalikus haiglas töötama sisehaiguste arstid ja üldõed. 4 (4) Sisehaiguste tervishoiuteenuste osutamiseks peavad kohalikus haiglas olema käesoleva määruse § 4 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid. Sisehaiguste tervishoiuteenuste osutamiseks peavad kohalikus haiglas olema käesoleva määruse § 4 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_77 (redaktsioon 158058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158058",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158058",
      "estleg:sourceAct": "Haigla liikide nõuded",
