      },
      "estleg:versionText": "Pediaatria tervishoiuteenuste osutamine keskhaiglas peab vastama käesoleva määruse §-s 6 kehtestatud nõuetele. Pediaatria tervishoiuteenuste osutamine keskhaiglas peab vastama käesoleva määruse §-s 6 kehtestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_18 (redaktsioon 158058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158058",
