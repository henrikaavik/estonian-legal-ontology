    {
      "@id": "estleg:Reg_158058_Par_16_v158058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158058_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Keskhaiglas osutatakse järgmisi kardioloogia tervishoiuteenuseid: 1 1) südamehaiguste ravimine; 2 2) südamehaiguste diagnoosimine. Keskhaiglas osutatakse järgmisi kardioloogia tervishoiuteenuseid: südamehaiguste ravimine; südamehaiguste diagnoosimine. 2 (2) Kardioloogia tervishoiuteenuste osutamiseks peab keskhaiglas olema järgmine aparatuur ja sisustus: 1 1) koormus-EKG aparaat; 2 2) Holteri monitor südame rütmihäirete registreerimiseks; 3 3) Holteri monitor vererõhu näitude registreerimiseks; 4 4) ehhokardiograaf; 5 5) funktsionaalsed ja tavalised voodid palatites. Kardioloogia tervishoiuteenuste osutamiseks peab keskhaiglas olema järgmine aparatuur ja sisustus: koormus-EKG aparaat; Holteri monitor südame rütmihäirete registreerimiseks; Holteri monitor vererõhu näitude registreerimiseks; ehhokardiograaf; funktsionaalsed ja tavalised voodid palatites. 3 (3) Kardioloogia tervishoiuteenuste osutamiseks peavad keskhaiglas töötama kardioloogid ja üldõed. Kardioloogia tervishoiuteenuste osutamiseks peavad keskhaiglas töötama kardioloogid ja üldõed. 4 (4) Kardioloogia tervishoiuteenuste osutamiseks peavad keskhaiglas olema käesoleva määruse § 4 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid. Kardioloogia tervishoiuteenuste osutamiseks peavad keskhaiglas olema käesoleva määruse § 4 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_16 (redaktsioon 158058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158058",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158058",
      "estleg:sourceAct": "Haigla liikide nõuded",
      "estleg:provisionRef": "Reg_158058 § 16",
