      }
    },
    {
      "@id": "estleg:Reg_158058_Par_44_v158058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158058_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piirkondlikus haiglas osutatakse kõiki psühhiaatria tervishoiuteenuseid. Piirkondlikus haiglas osutatakse kõiki psühhiaatria tervishoiuteenuseid. 2 (2) Psühhiaatria tervishoiuteenuste osutamiseks piirkondlikus haiglas peab olema käesoleva määruse § 19 lõigetes 2 ja 3 kehtestatud aparatuur ja sisustus ning elekterkrampravi aparatuur. Psühhiaatria tervishoiuteenuste osutamiseks piirkondlikus haiglas peab olema käesoleva määruse § 19 lõigetes 2 ja 3 kehtestatud aparatuur ja sisustus ning elekterkrampravi aparatuur. 3 (3) Psühhiaatria tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama psühhiaatrid, kliinilised psühholoogid ja psühhiaatriaõed või üldõed. Psühhiaatria tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama psühhiaatrid, kliinilised psühholoogid ja psühhiaatriaõed või üldõed. 4 (4) Psühhiaatria tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema käesoleva määruse § 19 lõikes 6 kehtestatud nõuetele vastavad tingimused ning lõikes 5 kehtestatud nõuetele vastavad ruumid ja lisaks ruumid elekterkrampravi läbiviimiseks. Psühhiaatria tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema käesoleva määruse § 19 lõikes 6 kehtestatud nõuetele vastavad tingimused ning lõikes 5 kehtestatud nõuetele vastavad ruumid ja lisaks ruumid elekterkrampravi läbiviimiseks.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_44 (redaktsioon 158058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158058",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158058",
      "estleg:sourceAct": "Haigla liikide nõuded",
      "estleg:provisionRef": "Reg_158058 § 44",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158058_Map"
      }
    },
    {
      "@id": "estleg:Reg_158058_Par_45_v158058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158058_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piirkondlikus haiglas osutatakse kõiki pulmonoloogia tervishoiuteenuseid. Piirkondlikus haiglas osutatakse kõiki pulmonoloogia tervishoiuteenuseid. 2 (2) Pulmonoloogia tervishoiuteenuste osutamiseks peab piirkondlikus haiglas olema järgmine aparatuur ja sisustus: 1 1) pulmonoloogilise funktsionaalse diagnostika aparatuur; 2 2) bronhoskoop; 3 3) hingamisteede stentimise vahendid; 4 4) allergoloogilise diagnostika vahendid; 5 5) füüsilise koormuse doseerimise seadmestik ja hingamistreeningus kasutatavad abivahendid; 6 6) pleuraõõne punktsiooni, drenaaži ja biopsia vahendid; 7 7) haigete koolituse läbiviimiseks vajalikud näidis- ja õppevahendid; 8 8) õhu steriliseerimise seade; 9 9) funktsionaalsed ja tavalised voodid palatites. Pulmonoloogia tervishoiuteenuste osutamiseks peab piirkondlikus haiglas olema järgmine aparatuur ja sisustus: pulmonoloogilise funktsionaalse diagnostika aparatuur; bronhoskoop; hingamisteede stentimise vahendid; allergoloogilise diagnostika vahendid; füüsilise koormuse doseerimise seadmestik ja hingamistreeningus kasutatavad abivahendid; pleuraõõne punktsiooni, drenaaži ja biopsia vahendid; haigete koolituse läbiviimiseks vajalikud näidis- ja õppevahendid; õhu steriliseerimise seade; funktsionaalsed ja tavalised voodid palatites. 3 (3) Pulmonoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama pulmonoloogid ja pulmonoloogia õed või üldõed. Pulmonoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama pulmonoloogid ja pulmonoloogia õed või üldõed. 4 (4) Pulmonoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema käesoleva määruse § 4 lõikes 4 ja § 5 lõike 7 punktides 1 ja 2 kehtestatud nõuetele ja funktsioonidele vastavad ruumid. Pulmonoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema käesoleva määruse § 4 lõikes 4 ja § 5 lõike 7 punktides 1 ja 2 kehtestatud nõuetele ja funktsioonidele vastavad ruumid.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_45 (redaktsioon 158058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158058",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158058",
      "estleg:sourceAct": "Haigla liikide nõuded",
      "estleg:provisionRef": "Reg_158058 § 45",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158058_Map"
      }
    },
    {
      "@id": "estleg:Reg_158058_Par_46_v158058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158058_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piirkondlikus haiglas osutatakse kõiki reumatoloogia tervishoiuteenuseid. Piirkondlikus haiglas osutatakse kõiki reumatoloogia tervishoiuteenuseid. 2 (2) Reumatoloogia tervishoiuteenuste osutamiseks peab piirkondlikus haiglas olema järgmine aparatuur ja sisustus: 1 1) vahendid kehapikkuse ja kaalu mõõtmiseks; 2 2) vahendid liigespunktsiooniks; 3 3) vahendid naha, nahaaluskoe ja liigesbiopsia tegemiseks; 4 4) vahendid intravenoossete raviprotseduuride tegemiseks: perfuusorid, plasmafereesi aparatuur; 5 5) seade luutiheduse mõõtmiseks; 6 6) vahendid mikroskoopia-kapillaaroskoopiaks ja kristalloskoopiaks; 7 7) kardiomonitor ja pulssoksümeeter; 8 8) defibrillaator; 9 9) haige uurimise funktsionaalne voodi; 10 10) funktsionaalsed voodid palatites. Reumatoloogia tervishoiuteenuste osutamiseks peab piirkondlikus haiglas olema järgmine aparatuur ja sisustus: vahendid kehapikkuse ja kaalu mõõtmiseks; vahendid liigespunktsiooniks; vahendid naha, nahaaluskoe ja liigesbiopsia tegemiseks; vahendid intravenoossete raviprotseduuride tegemiseks: perfuusorid, plasmafereesi aparatuur; seade luutiheduse mõõtmiseks; vahendid mikroskoopia-kapillaaroskoopiaks ja kristalloskoopiaks; kardiomonitor ja pulssoksümeeter; defibrillaator; haige uurimise funktsionaalne voodi; funktsionaalsed voodid palatites. 3 (3) Reumatoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama reumatoloogid ja üldõed. Reumatoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama reumatoloogid ja üldõed. 4 (4) Reumatoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema käesoleva määruse § 4 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid. Reumatoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema käesoleva määruse § 4 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_46 (redaktsioon 158058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158058",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158058",
