      }
    },
    {
      "@id": "estleg:Reg_158058_Par_32_v158058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158058_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piirkondlikus haiglas osutatakse kõiki erakorralise meditsiini tervishoiuteenuseid. Piirkondlikus haiglas osutatakse kõiki erakorralise meditsiini tervishoiuteenuseid. 2 (2) Erakorralise meditsiini tervishoiuteenuste osutamiseks peab piirkondlikus haiglas olema käesoleva määruse § 3 lõikes 2 kehtestatud nõuetele vastav aparatuur ja sisustus järgmise erisusega: erakorralise meditsiini tervishoiuteenuste osutamiseks peab olema vähemalt viisteist haigeraami- või voodikohta. Erakorralise meditsiini tervishoiuteenuste osutamiseks peab piirkondlikus haiglas olema käesoleva määruse § 3 lõikes 2 kehtestatud nõuetele vastav aparatuur ja sisustus järgmise erisusega: erakorralise meditsiini tervishoiuteenuste osutamiseks peab olema vähemalt viisteist haigeraami- või voodikohta. 3 (3) Erakorralise meditsiini tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama erakorralise meditsiini arstid ja erakorralise meditsiini õed või erakorralise meditsiini täiendusõppe läbinud üldõed. Erakorralise meditsiini tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama erakorralise meditsiini arstid ja erakorralise meditsiini õed või erakorralise meditsiini täiendusõppe läbinud üldõed. 4 (4) Erakorralise meditsiini tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema käesoleva määruse § 14 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid järgmise erisusega: peab olema kolm isolaatorit, mis koosnevad ühekohalistest palatitest pindalaga vähemalt 10 m2, tualettruumidest ja kontaktivaba segistiga ning kraanikausiga lüüsidest. Erakorralise meditsiini tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema käesoleva määruse § 14 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid järgmise erisusega: peab olema kolm isolaatorit, mis koosnevad ühekohalistest palatitest pindalaga vähemalt 10 m2, tualettruumidest ja kontaktivaba segistiga ning kraanikausiga lüüsidest.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_32 (redaktsioon 158058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158058",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158058",
