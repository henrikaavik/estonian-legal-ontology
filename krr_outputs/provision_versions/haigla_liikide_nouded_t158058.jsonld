    {
      "@id": "estleg:Reg_158058_Par_63_v158058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158058_Par_63"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piirkondlikus haiglas osutatakse kõiki patoloogia tervishoiuteenuseid. Piirkondlikus haiglas osutatakse kõiki patoloogia tervishoiuteenuseid. 2 (2) Patoloogia tervishoiuteenuste osutamine piirkondlikus haiglas peab vastama käesoleva määruse §-s 11 kehtestatud nõuetele järgmise erisusega: patoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama patoloogid ja bioanalüütikud (laborandid). Patoloogia tervishoiuteenuste osutamine piirkondlikus haiglas peab vastama käesoleva määruse §-s 11 kehtestatud nõuetele järgmise erisusega: patoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas töötama patoloogid ja bioanalüütikud (laborandid). 3 (3) Patoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema ruumid elektronmikroskoopia ja molekulaarpatoloogia uuringuteks ning käesoleva määruse § 11 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid. Patoloogia tervishoiuteenuste osutamiseks peavad piirkondlikus haiglas olema ruumid elektronmikroskoopia ja molekulaarpatoloogia uuringuteks ning käesoleva määruse § 11 lõikes 4 kehtestatud nõuetele ja funktsioonidele vastavad ruumid.",
      "rdfs:label": {
        "@value": "Reg_158058_Par_63 (redaktsioon 158058)",
        "@language": "et"
      },
