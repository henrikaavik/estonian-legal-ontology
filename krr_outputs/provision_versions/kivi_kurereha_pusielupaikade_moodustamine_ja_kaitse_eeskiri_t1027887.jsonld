    {
      "@id": "estleg:Reg_1027887_Par_2_v1027887",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027887_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Saare maakonnas võetakse kaitse alla järgmised kivi-kurereha kasvukohad: 1 1) Pälli püsielupaik Lümanda vallas Varpe ja Kipi külas; 2 2) Männiku püsielupaik Lümanda vallas Leedri külas. Saare maakonnas võetakse kaitse alla järgmised kivi-kurereha kasvukohad: Pälli püsielupaik Lümanda vallas Varpe ja Kipi külas; Männiku püsielupaik Lümanda vallas Leedri külas. 2 (2) Püsielupaikade piirid on kantud määruse lisas esitatud kaartidele1. Püsielupaikade piirid on kantud määruse lisas esitatud kaartidele1.",
      "rdfs:label": {
        "@value": "Reg_1027887_Par_2 (redaktsioon 1027887)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027887",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027887",
      "estleg:sourceAct": "Kivi-kurereha püsielupaikade moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1027887 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027887_Map_2026"
      }
    },
