    },
    {
      "@id": "estleg:Reg_1027887_Par_1_v1027887",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027887_Par_1"
