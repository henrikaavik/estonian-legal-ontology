    {
      "@id": "estleg:Reg_1027887_Par_7_v1027887",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027887_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kivi-kurereha püsielupaikade kaitse alla võtmise menetlus viidi läbi keskkonnaministri 29. märtsi 2011. a käskkirjaga nr 449 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas2. Kivi-kurereha püsielupaikade kaitse alla võtmise menetlus viidi läbi keskkonnaministri 29. märtsi 2011. a käskkirjaga nr 449 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas2.",
      "rdfs:label": {
        "@value": "Reg_1027887_Par_7 (redaktsioon 1027887)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027887",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027887",
      "estleg:sourceAct": "Kivi-kurereha püsielupaikade moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1027887 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027887_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1027887_Par_8_v1027887",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027887_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
