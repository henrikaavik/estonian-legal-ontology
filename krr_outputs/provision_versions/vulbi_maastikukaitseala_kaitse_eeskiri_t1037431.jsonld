      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 18. jaanuari 2016. a käskkirjaga nr 1-2/16/27 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 18. jaanuari 2016. a käskkirjaga nr 1-2/16/27 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1037431_Par_10 (redaktsioon 1037431)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037431",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037431",
