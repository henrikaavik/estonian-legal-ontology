        "@id": "estleg:Reg_1037431_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1037431_Par_10_v1037431",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
