    {
      "@id": "estleg:Reg_1060789_Par_2_v1060789",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060789_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega sätestatud nõudeid kohaldatakse alates 2025. aastast Eesti hariduse infosüsteemi registreerimiseks esitatavatele § 1 lõikes 2 nimetatud kutsekeskhariduse õppekavadele. Määrusega sätestatud nõudeid kohaldatakse alates 2025. aastast Eesti hariduse infosüsteemi registreerimiseks esitatavatele § 1 lõikes 2 nimetatud kutsekeskhariduse õppekavadele.",
      "rdfs:label": {
        "@value": "Reg_1060789_Par_2 (redaktsioon 1060789)",
        "@language": "et"
      },
