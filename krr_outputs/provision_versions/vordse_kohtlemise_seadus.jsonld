    {
      "@id": "estleg:VõrdKS_Par_34_v13096445",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadus jõustub 2009. aasta 1. jaanuaril. 1 Nõukogu direktiiv 2000/43/EÜ, millega rakendatakse võrdse kohtlemise põhimõte sõltumata isikute rassilisest või etnilisest päritolust (EÜT L 180, 19.07.2000, lk 22–26); nõukogu direktiiv 2000/78/EÜ, millega kehtestatakse üldine raamistik võrdseks kohtlemiseks töö saamisel ja kutsealale pääsemisel (EÜT L 303, 02.12.2000, lk 16–22).",
      "rdfs:label": {
        "@value": "VõrdKS_Par_34 (redaktsioon 13096445)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13096445",
      "estleg:supersededByVersion": {
        "@id": "estleg:VõrdKS_Par_34_v13223690"
      },
      "estleg:versionValidTo": {
        "@value": "2009-10-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13096445",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    },
    {
      "@id": "estleg:VõrdKS_Par_34_v13223690",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadus jõustub 2009. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "VõrdKS_Par_34 (redaktsioon 13223690)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13223690",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13223690",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    },
    {
      "@id": "estleg:VõrdKS_Par_4_v13096445",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse tähenduses: töötaja on töölepingu või teenuste osutamise lepingu alusel töötav isik ja avalik teenistuja avaliku teenistuse seaduse tähenduses. Töötajana käsitatakse ka tööle või teenistusse soovijat; tööandja on füüsiline või juriidiline isik, kes võimaldab tööd töölepingu või teenuste osutamise lepingu alusel, samuti riigi- või kohaliku omavalitsuse asutus.",
      "rdfs:label": {
        "@value": "VõrdKS_Par_4 (redaktsioon 13096445)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13096445",
      "estleg:supersededByVersion": {
        "@id": "estleg:VõrdKS_Par_4_v106072012022"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13096445",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    },
    {
      "@id": "estleg:VõrdKS_Par_4_v106072012022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse tähenduses: töötaja on töölepingu või teenuste osutamise lepingu alusel töötav isik, ametnik ja muu avaliku teenistuse seaduse §-s 2 nimetatud isik. Töötajana käsitatakse ka tööle või teenistusse soovijat; tööandja on füüsiline või juriidiline isik, kes võimaldab tööd töölepingu või teenuste osutamise lepingu alusel, samuti riigi- või kohaliku omavalitsuse asutus.",
      "rdfs:label": {
        "@value": "VõrdKS_Par_4 (redaktsioon 106072012022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072012022",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106072012022",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    },
    {
      "@id": "estleg:VõrdKS_Par_5_v13096445",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse tähenduses on puue inimese anatoomilise, füsioloogilise või psüühilise struktuuri või funktsiooni kaotus või kõrvalekalle, millel on oluline ja pikaajaline ebasoodus mõju igapäevatoimingute sooritamisele.",
      "rdfs:label": {
        "@value": "VõrdKS_Par_5 (redaktsioon 13096445)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13096445",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13096445",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    },
    {
      "@id": "estleg:VõrdKS_Par_6_v13096445",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus ei piira selliste meetmete rakendamist, mille eesmärk on vähendada või vältida käesoleva seaduse § 1 lõikes 1 nimetatud tunnusest tulenevat ebavõrdsust. Selliselt rakendatavad meetmed peavad olema proportsionaalsed taotletava eesmärgiga.",
      "rdfs:label": {
        "@value": "VõrdKS_Par_6 (redaktsioon 13096445)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13096445",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13096445",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    },
    {
      "@id": "estleg:VõrdKS_Par_7_v13096445",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Diskrimineerimises kahtlustatav isik on kohustatud 15 tööpäeva jooksul kirjaliku taotluse saamisest arvates andma kirjaliku seletuse oma tegevuse kohta isikule, kes leiab, et teda on käesoleva seaduse § 1 lõikes 1 nimetatud tunnuse alusel diskrimineeritud.",
      "rdfs:label": {
        "@value": "VõrdKS_Par_7 (redaktsioon 13096445)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13096445",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13096445",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    },
    {
      "@id": "estleg:VõrdKS_Par_8_v13096445",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtusse või töövaidluskomisjoni pöörduv isik peab avalduses esitama faktilised asjaolud, mille alusel võib eeldada, et toimunud on diskrimineerimine. (2) Isik, kelle vastu on avaldus esitatud, peab menetluses tõendama, et ta ei ole rikkunud võrdse kohtlemise põhimõtet. Kui isik keeldub tõendamisest, võrdsustatakse keeldumine diskrimineerimise omaksvõtuga. (3) Jagatud tõendamiskohustust ei kohaldata halduskohtu- ja kriminaalmenetluses.",
      "rdfs:label": {
        "@value": "VõrdKS_Par_8 (redaktsioon 13096445)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13096445",
      "estleg:supersededByVersion": {
        "@id": "estleg:VõrdKS_Par_8_v13223690"
      },
      "estleg:versionValidTo": {
        "@value": "2009-10-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13096445",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    },
    {
      "@id": "estleg:VõrdKS_Par_8_v13223690",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtu, töövaidluskomisjoni või soolise võrdõiguslikkuse ja võrdse kohtlemise voliniku poole pöörduv isik peab avalduses esitama faktilised asjaolud, mille alusel võib eeldada, et toimunud on diskrimineerimine. (2) Isik, kelle vastu on avaldus esitatud, peab menetluses tõendama, et ta ei ole rikkunud võrdse kohtlemise põhimõtet. Kui isik keeldub tõendamisest, võrdsustatakse keeldumine diskrimineerimise omaksvõtuga. (3) Jagatud tõendamiskohustust ei kohaldata halduskohtu- ja kriminaalmenetluses.",
      "rdfs:label": {
        "@value": "VõrdKS_Par_8 (redaktsioon 13223690)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13223690",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13223690",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    },
    {
      "@id": "estleg:VõrdKS_Par_9_v13096445",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VõrdKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus ei piira selliste seadusega kooskõlas olevate meetmete rakendamist, mis on vajalikud avaliku korra ja julgeoleku tagamiseks, kuritegude ennetamiseks, tervise, teiste inimeste õiguste või vabaduste kaitseks. Selliselt rakendatavad meetmed peavad olema proportsionaalsed taotletava eesmärgiga. (2) Diskrimineerimiseks ei peeta vanuse alusel seadusega sätestatud erinevat kohtlemist, kui sellel on objektiivne ja mõistlik tööhõivepoliitikat, tööturgu, kutseõpet või sotsiaalkindlustusteenuseid hõlmav õiguspärane eesmärk ning selle eesmärgi saavutamise vahendid on asjakohased ja vajalikud. (3) Diskrimineerimiseks töösuhetes ei peeta: eeliste andmist töötajate esindamise või töötajate ühingusse kuulumise tõttu, kui sellel on objektiivne ja mõistlik õiguspärane eesmärk ning selle eesmärgi saavutamise vahendid on asjakohased ja vajalikud; eeliste andmist raseduse, sünnituse ja alaealiste või töövõimetute täisealiste laste ning töövõimetute vanemate eest hoolitsemise tõttu.",
      "rdfs:label": {
        "@value": "VõrdKS_Par_9 (redaktsioon 13096445)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13096445",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13096445",
      "estleg:sourceAct": "Võrdse kohtlemise seadus",
      "estleg:provisionRef": "VõrdKS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:VõrdKS_Map_2026"
      }
    }
  ]
}
