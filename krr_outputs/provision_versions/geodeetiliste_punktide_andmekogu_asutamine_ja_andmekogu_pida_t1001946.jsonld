    {
      "@id": "estleg:Reg_1001946_Par_18_v1001946",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001946_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu likvideerimise otsustab Vabariigi Valitsus valdkonna eest vastutava ministri ettepanekul. RT I 2023-07-05 1 105072023001 2023-07-08 Andmekogu likvideerimise otsustab Vabariigi Valitsus valdkonna eest vastutava ministri ettepanekul. 2 (2) Andmekogu likvideeritakse kooskõlas „Arhiiviseadusega” ning „Avaliku teabe seaduse” § 439 lõike 1 punkti 6 alusel kehtestatud õigusaktiga. Andmekogu likvideeritakse kooskõlas „Arhiiviseadusega” ning „Avaliku teabe seaduse” § 439 lõike 1 punkti 6 alusel kehtestatud õigusaktiga.",
      "rdfs:label": {
        "@value": "Reg_1001946_Par_18 (redaktsioon 1001946)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001946",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001946",
      "estleg:sourceAct": "Geodeetiliste punktide andmekogu asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1001946 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001946_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001946_Par_19_v1001946",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001946_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist kogutud geodeetiliste punktide ja tööde andmed, mis vastavad käesolevas määruses toodud nõuetele, loetakse andmekogu koosseisu kuuluvaks. Enne käesoleva määruse jõustumist kogutud geodeetiliste punktide ja tööde andmed, mis vastavad käesolevas määruses toodud nõuetele, loetakse andmekogu koosseisu kuuluvaks.",
      "rdfs:label": {
        "@value": "Reg_1001946_Par_19 (redaktsioon 1001946)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001946",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001946",
      "estleg:sourceAct": "Geodeetiliste punktide andmekogu asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1001946 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001946_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001946_Par_2_v1001946",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001946_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu pidamise eesmärk on koguda, säilitada ja töödelda andmeid geodeetiliste tööde, geodeetiliste võrkude, punktide ja märkide, geodeetiliste võrkude mõõtmisandmete ning nende teisenduste kohta. Andmekogu pidamise eesmärk on koguda, säilitada ja töödelda andmeid geodeetiliste tööde, geodeetiliste võrkude, punktide ja märkide, geodeetiliste võrkude mõõtmisandmete ning nende teisenduste kohta.",
      "rdfs:label": {
        "@value": "Reg_1001946_Par_2 (redaktsioon 1001946)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001946",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001946",
