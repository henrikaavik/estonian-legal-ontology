      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Läänemerest püütud tursa, kilu ja räime lossimiseks määratud sadamad Eesti Vabariigi territooriumil (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Läänemerest püütud tursa, kilu ja räime lossimiseks määratud sadamad Eesti Vabariigi territooriumil"
    },
    {
      "@id": "estleg:Reg_1059016_Par_1_v1059016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059016_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kalalaevalt, mille pardal on püütud turska Läänemerest eluskaalus üle 250 kilogrammi, võib seda Eesti Vabariigi territooriumil lossida üksnes järgmiste sadamate kai ääres ööpäev läbi, kui sadama eeskirjas ei ole ette nähtud teisiti: 1 1) Japsi Kalasadam; 2 2) Kalana Sadam; 3 3) Lehtma Sadam; 4 4) Loksa Sadam; 5 5) Meeruse Sadam; 6 6) Miiduranna Sadam; 7 7) Mõntu Sadam; 8 8) Nasva Sadam; 9 9) Paldiski Lõunasadam; 10 10) Pärnu Sadam; 11 11) Roomassaare Sadam; 12 12) Suursadam; 13 13) Veere Sadam; 14 14) Virtsu Sadam. Kalalaevalt, mille pardal on püütud turska Läänemerest eluskaalus üle 250 kilogrammi, võib seda Eesti Vabariigi territooriumil lossida üksnes järgmiste sadamate kai ääres ööpäev läbi, kui sadama eeskirjas ei ole ette nähtud teisiti: Japsi Kalasadam; Kalana Sadam; Lehtma Sadam; Loksa Sadam; Meeruse Sadam; Miiduranna Sadam; Mõntu Sadam; Nasva Sadam; Paldiski Lõunasadam; Pärnu Sadam; Roomassaare Sadam; Suursadam; Veere Sadam; Virtsu Sadam.",
      "rdfs:label": {
        "@value": "Reg_1059016_Par_1 (redaktsioon 1059016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1059016",
      "estleg:sourceAct": "Läänemerest püütud tursa, kilu ja räime lossimiseks määratud sadamad Eesti Vabariigi territooriumil",
      "estleg:provisionRef": "Reg_1059016 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059016_Map"
      }
    },
    {
      "@id": "estleg:Reg_1059016_Par_2_v1059016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059016_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kalalaevalt, mille pardal on püütud kilu ja räime Läänemerest eluskaalus üle viie tonni, võib neid Eesti Vabariigi territooriumil lossida üksnes järgmiste sadamate kai ääres ööpäev läbi, kui sadama eeskirjas ei ole ette nähtud teisiti: 1 1) Bekkeri Sadam; 2 2) Dirhami Sadam; 3 3) Heltermaa Sadam; 4 4) Japsi Kalasadam; 5 5) Kaavi Paadisadam; 6 6) Kallaste Sadam (Saare maakond); 7 7) Kaunispe Sadam; 8 8) Kihnu Sadam; 9 9) Kunda Sadam; 10 10) Lahesuu Sadam; 11 11) Lao Sadam; 12 12) Lehtma Sadam; 13 13) Leppneeme Kalasadam; 14 14) Lindi Sadam; 15 15) Liu Väikesadam; 16 16) Loksa Sadam; 17 17) Läätsa Paadisadam; 18 18) Manilaiu Sadam; 19 19) Meeruse Sadam; 20 20) Miiduranna Sadam; 21 21) Munalaiu Sadam; 22 22) Mõntu Sadam; 23 23) Narva-Jõesuu Sadam; 24 24) Nasva Jõesadam; 25 25) Nõva Sadam; 26 26) Paldiski Lõunasadam; 27 27) Peerni Sadam; 28 28) Puise Kalasadam; 29 29) Purtse Kalasadam; 30 30) Pärnu Sadam; 31 31) Rannametsa Sadam; 32 32) Ristna Sadam; 33 33) Rohuküla Sadam; 34 34) Roomassaare Sadam; 35 35) Saaremaa Sadam; 36 36) Salme Jõesadam; 37 37) Suaru Sadam; 38 38) Sõru Sadam; 39 39) Sõru Väikelaevasadam; 40 40) Tapurla Sadam; 41 41) Toila Sadam; 42 42) Topu Sadam; 43 43) Treimani Sadam; 44 44) Turja Sadam; 45 45) Vana-Sauga Sadam; 46 46) Varese Sadam; 47 47) Veere Sadam; 48 48) Virtsu Kalasadam; 49 49) Virtsu Sadam; 50 50) Virtsu Vanasadam; 51 51) Võiste Sadam; 52 52) Westmeri Sadam. Kalalaevalt, mille pardal on püütud kilu ja räime Läänemerest eluskaalus üle viie tonni, võib neid Eesti Vabariigi territooriumil lossida üksnes järgmiste sadamate kai ääres ööpäev läbi, kui sadama eeskirjas ei ole ette nähtud teisiti: Bekkeri Sadam; Dirhami Sadam; Heltermaa Sadam; Japsi Kalasadam; Kaavi Paadisadam; Kallaste Sadam (Saare maakond); Kaunispe Sadam; Kihnu Sadam; Kunda Sadam; Lahesuu Sadam; Lao Sadam; Lehtma Sadam; Leppneeme Kalasadam; Lindi Sadam; Liu Väikesadam; Loksa Sadam; Läätsa Paadisadam; Manilaiu Sadam; Meeruse Sadam; Miiduranna Sadam; Munalaiu Sadam; Mõntu Sadam; Narva-Jõesuu Sadam; Nasva Jõesadam; Nõva Sadam; Paldiski Lõunasadam; Peerni Sadam; Puise Kalasadam; Purtse Kalasadam; Pärnu Sadam; Rannametsa Sadam; Ristna Sadam; Rohuküla Sadam; Roomassaare Sadam; Saaremaa Sadam; Salme Jõesadam; Suaru Sadam; Sõru Sadam; Sõru Väikelaevasadam; Tapurla Sadam; Toila Sadam; Topu Sadam; Treimani Sadam; Turja Sadam; Vana-Sauga Sadam; Varese Sadam; Veere Sadam; Virtsu Kalasadam; Virtsu Sadam; Virtsu Vanasadam; Võiste Sadam; Westmeri Sadam.",
      "rdfs:label": {
        "@value": "Reg_1059016_Par_2 (redaktsioon 1059016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059016",
