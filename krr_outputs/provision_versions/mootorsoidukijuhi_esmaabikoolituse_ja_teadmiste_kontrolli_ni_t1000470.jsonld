    {
      "@id": "estleg:Reg_1000470_Par_2_v1000470",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000470_Par_2"
