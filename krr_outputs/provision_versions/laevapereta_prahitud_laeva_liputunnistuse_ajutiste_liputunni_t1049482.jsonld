      "dc:source": "Laevapereta prahitud laeva liputunnistuse, ajutiste liputunnistuste ja registrist kustutamise tunnistuse vormid"
    },
    {
      "@id": "estleg:Reg_1049482_Par_1_v1049482",
      "@type": [
        "owl:NamedIndividual",
