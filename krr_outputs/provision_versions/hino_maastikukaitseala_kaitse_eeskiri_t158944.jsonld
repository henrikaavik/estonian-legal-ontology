    {
      "@id": "estleg:Reg_158944_Par_12_v158944",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158944_Par_12"
