      "estleg:versionOf": {
        "@id": "estleg:Reg_158944_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik heina niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik heina niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_158944_Par_14 (redaktsioon 158944)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158944",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158944",
      "estleg:sourceAct": "Hino maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158944 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158944_Map"
      }
    },
    {
      "@id": "estleg:Reg_158944_Par_15_v158944",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158944_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse säilitamine. Piiranguvööndi metsa kaitse-eesmärk on metsakoosluste loodusliku ilme säilitamine. Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse säilitamine. Piiranguvööndi metsa kaitse-eesmärk on metsakoosluste loodusliku ilme säilitamine.",
      "rdfs:label": {
