    {
      "@id": "estleg:Reg_158944_Par_13_v158944",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158944_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 3 3) veekogude veetaseme ja kaldajoone muutmine, välja arvatud veerežiimi taastamine, ning uute veekogude rajamine; 4 4) uue maaparandussüsteemi rajamine; 5 5) biotsiidi ja taimekaitsevahendi kasutamine; 6 6) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 7 7) puidu kokku- ja väljavedu külmumata pinnasel. Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; veekogude veetaseme ja kaldajoone muutmine, välja arvatud veerežiimi taastamine, ning uute veekogude rajamine; uue maaparandussüsteemi rajamine; biotsiidi ja taimekaitsevahendi kasutamine; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_158944_Par_13 (redaktsioon 158944)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158944",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158944",
      "estleg:sourceAct": "Hino maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158944 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158944_Map"
      }
    },
    {
      "@id": "estleg:Reg_158944_Par_14_v158944",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
