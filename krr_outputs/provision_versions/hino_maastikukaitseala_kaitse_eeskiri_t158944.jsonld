      "estleg:provisionRef": "Reg_158944 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158944_Map"
      }
    },
    {
      "@id": "estleg:Reg_158944_Par_2_v158944",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
