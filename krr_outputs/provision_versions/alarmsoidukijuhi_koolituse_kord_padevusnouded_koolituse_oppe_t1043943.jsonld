      },
      "estleg:versionValidFrom": {
        "@value": "2018-08-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse § 8 jõustub 2020. aasta 1. märtsil. Määruse § 8 jõustub 2020. aasta 1. märtsil.",
      "rdfs:label": {
        "@value": "Reg_1043943_Par_14 (redaktsioon 1043943)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043943",
