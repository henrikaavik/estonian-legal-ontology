      }
    },
    {
      "@id": "estleg:Reg_1043943_Par_2_v1043943",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043943_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-08-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alarmsõidukijuhi koolituse (edaspidi koolitus) eesmärgiks on: 1 1) anda õpilasele teadmised, oskused ja hoiakud liikluses käitumiseks vastavalt taotletava kategooria alarmsõidukijuhi pädevusnõuetele; 2 2) luua eeldused alarmsõiduki säästlikule, ohutule ja inimesi, vara ning keskkonda säästvale juhtimisele. Alarmsõidukijuhi koolituse (edaspidi koolitus) eesmärgiks on: anda õpilasele teadmised, oskused ja hoiakud liikluses käitumiseks vastavalt taotletava kategooria alarmsõidukijuhi pädevusnõuetele; luua eeldused alarmsõiduki säästlikule, ohutule ja inimesi, vara ning keskkonda säästvale juhtimisele.",
      "rdfs:label": {
        "@value": "Reg_1043943_Par_2 (redaktsioon 1043943)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043943",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043943",
      "estleg:sourceAct": "Alarmsõidukijuhi koolituse kord, pädevusnõuded, koolituse õppekava, koolitustunnistuse vorm ja liiklusregistrisse kantavad andmed",
      "estleg:provisionRef": "Reg_1043943 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043943_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043943_Par_3_v1043943",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043943_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-08-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolitus jaguneb vastavalt alarmsõiduki mootorsõiduki kategooriatele, mis hõlmab ka vastavast mootorsõidukist moodustatud autorongi. Koolitus jaguneb vastavalt alarmsõiduki mootorsõiduki kategooriatele, mis hõlmab ka vastavast mootorsõidukist moodustatud autorongi. 2 (2) Koolitus toimub alg- või täienduskoolituse korras. Algkoolitus viiakse läbi isikule, kellele ei ole eelnevalt alarmsõidukijuhi koolitustunnistust väljastatud. Täienduskoolitus viiakse läbi isikule, kellele on alarmsõidukijuhi koolitustunnistus varem väljastatud. Koolitus toimub alg- või täienduskoolituse korras. Algkoolitus viiakse läbi isikule, kellele ei ole eelnevalt alarmsõidukijuhi koolitustunnistust väljastatud. Täienduskoolitus viiakse läbi isikule, kellele on alarmsõidukijuhi koolitustunnistus varem väljastatud. 3 (3) Alg- ja täienduskoolituse teoreetilise osa põhiülesanne on kaitsliku sõidustiili õpetamine. Alg- ja täienduskoolituse teoreetilise osa põhiülesanne on kaitsliku sõidustiili õpetamine. 4 (4) Algkoolituse praktilise osa ja sõiduõppe põhiülesanne on liiklusohtude ettenägemise ja ennetamise õpetamine. Algkoolituse praktilise osa ja sõiduõppe põhiülesanne on liiklusohtude ettenägemise ja ennetamise õpetamine. 5 (5) Täienduskoolituse praktilise osa ja sõiduõppe põhiülesanne on alarmsõidukijuhi õpetamine äärmuslikes olukordades tegutsemiseks. Täienduskoolituse praktilise osa ja sõiduõppe põhiülesanne on alarmsõidukijuhi õpetamine äärmuslikes olukordades tegutsemiseks.",
      "rdfs:label": {
        "@value": "Reg_1043943_Par_3 (redaktsioon 1043943)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043943",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043943",
      "estleg:sourceAct": "Alarmsõidukijuhi koolituse kord, pädevusnõuded, koolituse õppekava, koolitustunnistuse vorm ja liiklusregistrisse kantavad andmed",
      "estleg:provisionRef": "Reg_1043943 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043943_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043943_Par_4_v1043943",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043943_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-08-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolitusel osalemiseks esitab isik koolitajale: 1 1) juhiloa; 2 2) täienduskoolituse puhul eelnevalt läbitud koolitustunnistuse, kui koolituse läbimise kohta ei ole andmeid liiklusregistris. Koolitusel osalemiseks esitab isik koolitajale: juhiloa; täienduskoolituse puhul eelnevalt läbitud koolitustunnistuse, kui koolituse läbimise kohta ei ole andmeid liiklusregistris.",
      "rdfs:label": {
        "@value": "Reg_1043943_Par_4 (redaktsioon 1043943)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043943",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043943",
      "estleg:sourceAct": "Alarmsõidukijuhi koolituse kord, pädevusnõuded, koolituse õppekava, koolitustunnistuse vorm ja liiklusregistrisse kantavad andmed",
      "estleg:provisionRef": "Reg_1043943 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043943_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043943_Par_5_v1043943",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043943_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-08-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Algkoolituse maht on vähemalt 31 õppetundi, millest õppeteema „alarmsõiduk liikluses” maht on vähemalt 17 õppetundi ja õppeteema „praktilised harjutused ja näited ning sõiduõpe” maht on vähemalt 14 õppetundi. Algkoolituse maht on vähemalt 31 õppetundi, millest õppeteema „alarmsõiduk liikluses” maht on vähemalt 17 õppetundi ja õppeteema „praktilised harjutused ja näited ning sõiduõpe” maht on vähemalt 14 õppetundi. 2 (2) Täienduskoolituse maht on vähemalt 16 õppetundi. Täienduskoolituse maht on vähemalt 16 õppetundi. 3 (3) Õppetunni kestus on 45 minutit. Õppetunni kestus on 45 minutit. 4 (4) Teooria ja praktilise õppe rühmas võib olla kuni 16 õpilast. Teooria ja praktilise õppe rühmas võib olla kuni 16 õpilast. 5 (5) Teooria ja praktiliste õppetundide ülesehitus ja vahelduvus peavad tagama õpilase piisava ettevalmistuse eksamite edukaks sooritamiseks ning edasiseks töötamiseks alarmsõidukijuhina. Teooria ja praktiliste õppetundide ülesehitus ja vahelduvus peavad tagama õpilase piisava ettevalmistuse eksamite edukaks sooritamiseks ning edasiseks töötamiseks alarmsõidukijuhina. 6 (6) Iseseisvat õpet ei arvestata lõigetes 1 ja 2 nimetatud minimaalse koolituse mahu hulka. Iseseisvat õpet ei arvestata lõigetes 1 ja 2 nimetatud minimaalse koolituse mahu hulka. 7 (7) Elektroonilist õpet võib algkoolituse mahust kuni 11 õppetunni ja täienduskoolituse mahust kuni 6 õppetunni ulatuses läbi viia üksnes alg- ja täienduskoolituse teoreetilises osas. Elektroonilist õpet võib algkoolituse mahust kuni 11 õppetunni ja täienduskoolituse mahust kuni 6 õppetunni ulatuses läbi viia üksnes alg- ja täienduskoolituse teoreetilises osas.",
      "rdfs:label": {
        "@value": "Reg_1043943_Par_5 (redaktsioon 1043943)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043943",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043943",
      "estleg:sourceAct": "Alarmsõidukijuhi koolituse kord, pädevusnõuded, koolituse õppekava, koolitustunnistuse vorm ja liiklusregistrisse kantavad andmed",
      "estleg:provisionRef": "Reg_1043943 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043943_Map_2026"
      }
    },
