      },
      "estleg:versionValidTo": {
        "@value": "2014-05-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KREDII_2_Par_8_v109052014005",
      "@type": [
        "owl:NamedIndividual",
