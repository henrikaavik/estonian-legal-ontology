      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KREDII_2_Par_72_v177626",
      "@type": [
        "owl:NamedIndividual",
