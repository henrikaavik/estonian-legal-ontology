    {
      "@id": "estleg:KREDII_2_Par_88_v177531",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_88"
      },
      "estleg:versionValidFrom": {
