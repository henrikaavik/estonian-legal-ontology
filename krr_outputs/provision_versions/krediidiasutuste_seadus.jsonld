    {
      "@id": "estleg:KREDII_2_Par_41_v177531",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistupanga võib asutada hoiu-laenuühistute ühinemisel hoiu-laenuühistu seaduses ettenähtud korras. (2) Ühistupanga asutajateks on ühinevad hoiu-laenuühistud. (3) Ühistupanga asutamisel hoiu-laenuühistute ühinemise teel peab kõiki ühinevaid hoiu-laenuühistuid kontrollima vähemalt üks ühine audiitor, kes vastab käesoleva seaduse § 94 lõikes 1 toodud tingimustele. (4) Audiitor koostab ühinemislepingu ja -aruande kontrollimise kohta aruande ja annab oma arvamuse selle kohta, kas asutatava ühistupanga osakapital ja usaldatavusnormatiivide tase vastab käesoleva seaduse ja selle alusel välja antud õigusaktide nõuetele.",
      "rdfs:label": {
        "@value": "KREDII_2_Par_41 (redaktsioon 177531)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "177531",
      "estleg:supersededByVersion": {
        "@id": "estleg:KREDII_2_Par_41_v13330780"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KREDII_2_Par_41_v13330780",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistupanga võib asutada hoiu-laenuühistute ühinemisel hoiu-laenuühistu seaduses ettenähtud korras. (2) Ühistupanga asutajateks on ühinevad hoiu-laenuühistud. (3) Ühistupanga asutamisel hoiu-laenuühistute ühinemise teel peab kõiki ühinevaid hoiu-laenuühistuid kontrollima vähemalt üks ühine audiitor, kes vastab käesoleva seaduse § 94 lõikes 1 toodud tingimustele. (4) Audiitor koostab ühinemislepingu ja -aruande kontrollimise kohta aruande ja annab oma arvamuse selle kohta, kas asutatava ühistupanga osakapital ja neto-omavahendite suurus vastab käesoleva seaduse ja selle alusel välja antud õigusaktide nõuetele.",
      "rdfs:label": {
        "@value": "KREDII_2_Par_41 (redaktsioon 13330780)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330780",
      "estleg:supersededByVersion": {
        "@id": "estleg:KREDII_2_Par_41_v109052014005"
      },
      "estleg:versionValidTo": {
        "@value": "2014-05-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KREDII_2_Par_41_v109052014005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistupanga võib asutada hoiu-laenuühistute ühinemisel hoiu-laenuühistu seaduses ettenähtud korras. (2) Ühistupanga asutajateks on ühinevad hoiu-laenuühistud. (3) Ühistupanga asutamisel hoiu-laenuühistute ühinemise teel peab kõiki ühinevaid hoiu-laenuühistuid kontrollima vähemalt üks ühine audiitor, kes vastab käesoleva seaduse § 94 lõikes 1 toodud tingimustele. (4) Audiitor koostab ühinemislepingu ja -aruande kontrollimise kohta aruande ja annab oma arvamuse selle kohta, kas asutatava ühistupanga osakapital ja omavahendite suurus vastab käesoleva seaduse ja selle alusel välja antud õigusaktide nõuetele.",
      "rdfs:label": {
        "@value": "KREDII_2_Par_41 (redaktsioon 109052014005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052014005"
    },
    {
      "@id": "estleg:KREDII_2_Par_42_v177531",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühistupanga põhikirjas peab lisaks hoiu-laenuühistu seaduses sätestatule olema märgitud: ühistupanga organisatsioonilise struktuuri kirjeldus ja struktuuriüksuste moodustamise kord; juhtimisorganite pädevus; organ, mis kehtestab ühistupanga liikmetele laenu andmise korra; aruandluse põhimõtted; revisjonikomisjoni töökord. (2) -(3) [kehtetud] (4) Ühistupangale kohaldatakse käesoleva seaduse §-s 27 sätestatut.",
      "rdfs:label": {
        "@value": "KREDII_2_Par_42 (redaktsioon 177531)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "177531",
