    {
      "@id": "estleg:KREDII_2_Par_134_8_v109052014005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_134_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses, Euroopa Parlamendi ja nõukogu määruses (EL) nr 575/2013 või nende alusel antud õigusaktis sätestatud aruande, dokumendi, selgituse või muu teabe tähtpäevaks avalikustamata või Finantsinspektsioonile esitamata jätmise või mitteõigeaegse, puuduliku või ebaõige teabe esitamise või avalikustamise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "KREDII_2_Par_134_8 (redaktsioon 109052014005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052014005",
