      }
    },
    {
      "@id": "estleg:KREDII_2_Par_125_v830203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_125"
