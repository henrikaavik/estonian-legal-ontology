      },
      "estleg:versionValidTo": {
        "@value": "2005-03-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KREDII_2_Par_143_v865017",
      "@type": [
        "owl:NamedIndividual",
