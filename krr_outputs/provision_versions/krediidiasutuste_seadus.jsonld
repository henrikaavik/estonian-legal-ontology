    {
      "@id": "estleg:KREDII_2_Par_16_v177531",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusluba lõpeb: krediidiasutuse ühinemise korral käesoleva seaduse § 65 lõike 2 alusel - uue krediidiasutuse äriregistrisse kandmisega; krediidiasutuse ühinemise korral käesoleva seaduse § 65 lõike 3 alusel - ühinemise kande äriregistrisse kandmisega; krediidiasutuse vabatahtliku lõpetamise korral - Finantsinspektsioonilt vabatahtlikuks lõpetamiseks loa saamisega; tegevusloa kehtetuks tunnistamise korral - tegevusloa kehtetuks tunnistamisega; krediidiasutuse pankroti korral - pankrotimenetluse algatamisega Finantsinspektsiooni avalduse alusel.",
      "rdfs:label": {
        "@value": "KREDII_2_Par_16 (redaktsioon 177531)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "177531",
      "estleg:supersededByVersion": {
        "@id": "estleg:KREDII_2_Par_16_v830203"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KREDII_2_Par_16_v830203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
