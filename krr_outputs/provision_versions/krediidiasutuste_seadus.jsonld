    {
      "@id": "estleg:KREDII_2_Par_20_2_v122122010027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_20_2"
