        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KREDII_2_Par_97_2_v12771116",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
