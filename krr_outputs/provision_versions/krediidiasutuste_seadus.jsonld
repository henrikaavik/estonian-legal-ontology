    {
      "@id": "estleg:KREDII_2_Par_63_v12894029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_63"
      },
      "estleg:versionValidFrom": {
