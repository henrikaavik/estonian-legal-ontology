        "@id": "estleg:KREDII_2_Par_113_v122122010027"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KREDII_2_Par_113_v122122010027",
