    },
    {
      "@id": "estleg:KREDII_2_Par_134_7_v117032023016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_134_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Krediidiasutuse usaldatavusnormatiivide, sealhulgas likviidsete varade hoidmise, suure riskide kontsentreerumise piirmäära või väärtpaberistamise positsiooni krediidiriski nõuete rikkumise eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni 10 protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "KREDII_2_Par_134_7 (redaktsioon 117032023016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023016"
    },
