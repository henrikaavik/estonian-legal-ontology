    {
      "@id": "estleg:KREDII_2_Par_89_v110072020020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KREDII_2_Par_89"
