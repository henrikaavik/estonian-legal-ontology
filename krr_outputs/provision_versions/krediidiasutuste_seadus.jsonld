        "@id": "estleg:KREDII_2_Par_55_v121122010038"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KREDII_2_Par_55_v121122010038",
      "@type": [
