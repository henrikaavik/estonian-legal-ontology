        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Krediidiasutuse omavahendid on: esmased omavahendid; täiendavad omavahendid; kauplemisportfelli tururiski katmiseks kasutatavad omavahendid.",
      "rdfs:label": {
        "@value": "KREDII_2_Par_72 (redaktsioon 177531)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "177531",
