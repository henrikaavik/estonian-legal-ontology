      }
    },
    {
      "@id": "estleg:Reg_1054557_Par_9_v1054557",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054557_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kutsetunnistuse kehtivuse peatab või tunnistab kehtetuks Transpordiamet komisjoni ettepanekul. Kutsetunnistuse kehtivuse peatab või tunnistab kehtetuks Transpordiamet komisjoni ettepanekul. 2 (2) Transpordiamet teavitab viivitamatult kutsetunnistuse peatamisest või kehtetuks tunnistamisest kutsetunnistuse omanikku, lootsiteenust osutavat äriühingut, asjaomaseid sadama pidajaid või sadamakapteneid. Transpordiamet teavitab viivitamatult kutsetunnistuse peatamisest või kehtetuks tunnistamisest kutsetunnistuse omanikku, lootsiteenust osutavat äriühingut, asjaomaseid sadama pidajaid või sadamakapteneid.",
