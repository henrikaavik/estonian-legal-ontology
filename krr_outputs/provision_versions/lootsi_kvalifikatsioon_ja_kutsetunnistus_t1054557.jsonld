      "estleg:provisionRef": "Reg_1054557 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054557_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054557_Par_10_v1054557",
      "@type": [
        "owl:NamedIndividual",
