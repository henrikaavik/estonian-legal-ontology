      "estleg:provisionRef": "Reg_1054557 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054557_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054557_Par_3_v1054557",
