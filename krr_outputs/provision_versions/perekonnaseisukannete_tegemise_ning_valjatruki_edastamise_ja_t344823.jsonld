      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_344823_Par_3 (redaktsioon 344823)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "344823",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/344823",
      "estleg:sourceAct": "Perekonnaseisukannete tegemise ning väljatrüki edastamise ja säilitamise kord",
