    {
      "@id": "estleg:Reg_344823_Par_22_v344823",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_344823_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu - 2013-12-23 RT I 2014-01-07 1 107012014001 2014-01-10 Kehtetu - 2 (2) Lapse sünni registreerimisel juhul, kui vanemad ei ole omavahel abielus ja laps on sündinud kunstliku viljastamise ja embrüokaitse seaduse §-des 18 ja 21 sätestatud kunstliku viljastamise tulemusena, märgivad vanemad lapse sünni registreerimise avalduse esitamisel, kas nad soovivad hooldusõigust teostada ühiselt või jätta hooldusõiguse ühele vanemale. 2013-12-23 RT I 2014-01-07 1 107012014001 2014-01-10 Lapse sünni registreerimisel juhul, kui vanemad ei ole omavahel abielus ja laps on sündinud kunstliku viljastamise ja embrüokaitse seaduse §-des 18 ja 21 sätestatud kunstliku viljastamise tulemusena, märgivad vanemad lapse sünni registreerimise avalduse esitamisel, kas nad soovivad hooldusõigust teostada ühiselt või jätta hooldusõiguse ühele vanemale.",
      "rdfs:label": {
        "@value": "Reg_344823_Par_22 (redaktsioon 344823)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "344823",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/344823",
      "estleg:sourceAct": "Perekonnaseisukannete tegemise ning väljatrüki edastamise ja säilitamise kord",
      "estleg:provisionRef": "Reg_344823 § 22",
      "estleg:partOfAct": {
