      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Raseduse katkestamisega seotud uuringud ja toimingud (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Raseduse katkestamisega seotud uuringud ja toimingud"
    },
    {
      "@id": "estleg:Reg_154466_Par_1_v154466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154466_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raseduse olemasolu ja kestuse tuvastanud arst (edaspidi raseduse tuvastanud arst) teeb enne naise raseduse katkestamisele suunamist talle kõik asjakohased ravistandardile vastavad uuringud ja toimingud.",
      "rdfs:label": {
        "@value": "Reg_154466_Par_1 (redaktsioon 154466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154466",
      "estleg:sourceAct": "Raseduse katkestamisega seotud uuringud ja toimingud",
      "estleg:provisionRef": "Reg_154466 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154466_Map"
      }
    },
    {
      "@id": "estleg:Reg_154466_Par_2_v154466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154466_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raseduse tuvastanud arst teeb naisele enne raseduse katkestamisele suunamist veregrupi ja reesusfaktori uuringu.",
      "rdfs:label": {
        "@value": "Reg_154466_Par_2 (redaktsioon 154466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154466",
      "estleg:sourceAct": "Raseduse katkestamisega seotud uuringud ja toimingud",
      "estleg:provisionRef": "Reg_154466 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154466_Map"
      }
    },
    {
      "@id": "estleg:Reg_154466_Par_3_v154466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154466_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raseduse tuvastanud arst teavitab naist enne raseduse katkestamisele suunamist tehtud uuringute tulemustest, tema terviseseisundist, nõustab teda ja annab talle selgitusi.",
      "rdfs:label": {
        "@value": "Reg_154466_Par_3 (redaktsioon 154466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154466",
      "estleg:sourceAct": "Raseduse katkestamisega seotud uuringud ja toimingud",
      "estleg:provisionRef": "Reg_154466 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154466_Map"
      }
    },
    {
      "@id": "estleg:Reg_154466_Par_4_v154466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154466_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raseduse tuvastanud arst annab naisele vormikohase saatekirja raseduse katkestamiseks.",
      "rdfs:label": {
        "@value": "Reg_154466_Par_4 (redaktsioon 154466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154466",
      "estleg:sourceAct": "Raseduse katkestamisega seotud uuringud ja toimingud",
      "estleg:provisionRef": "Reg_154466 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154466_Map"
      }
    },
    {
      "@id": "estleg:Reg_154466_Par_5_v154466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154466_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raseduse katkestanud arst korraldab naise jälgimise tervishoiuasutuses, kus rasedus katkestati, vähemalt kahe tunni jooksul pärast raseduse katkestamise lõpetamist.",
      "rdfs:label": {
        "@value": "Reg_154466_Par_5 (redaktsioon 154466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154466",
      "estleg:sourceAct": "Raseduse katkestamisega seotud uuringud ja toimingud",
      "estleg:provisionRef": "Reg_154466 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154466_Map"
      }
    },
    {
      "@id": "estleg:Reg_154466_Par_6_v154466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154466_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui naise veri on reesus- (D-) negatiivne, korraldab raseduse katkestanud arst vahetult pärast raseduse katkestamist naisele antireesus (anti-D) globuliini manustamise.",
      "rdfs:label": {
        "@value": "Reg_154466_Par_6 (redaktsioon 154466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154466",
      "estleg:sourceAct": "Raseduse katkestamisega seotud uuringud ja toimingud",
      "estleg:provisionRef": "Reg_154466 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154466_Map"
      }
    },
    {
      "@id": "estleg:Reg_154466_Par_7_v154466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154466_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raseduse tuvastanud arst konsulteerib naist väljaspool järjekorda vältimatu arstiabi korras raseduse katkestamisele järgneva kahe nädala jooksul. Minister Eiki NESTOR Kantsler Hannes DANILOV",
      "rdfs:label": {
        "@value": "Reg_154466_Par_7 (redaktsioon 154466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154466",
      "estleg:sourceAct": "Raseduse katkestamisega seotud uuringud ja toimingud",
      "estleg:provisionRef": "Reg_154466 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154466_Map"
      }
    },
