      "estleg:provisionRef": "Reg_1039315 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039315_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039315_Par_2_v1039315",
      "@type": [
        "owl:NamedIndividual",
