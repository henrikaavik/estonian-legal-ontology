      "estleg:versionValidFrom": {
        "@value": "2017-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 16. novembri 2015. a. käskkirjaga nr 1023 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 16. novembri 2015. a. käskkirjaga nr 1023 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1039315_Par_18 (redaktsioon 1039315)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039315",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039315",
      "estleg:sourceAct": "Luhasoo looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1039315 § 18",
      "estleg:partOfAct": {
