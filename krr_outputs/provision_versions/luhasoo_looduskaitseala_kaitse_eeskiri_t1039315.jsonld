    {
      "@id": "estleg:Reg_1039315_Par_18_v1039315",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039315_Par_18"
