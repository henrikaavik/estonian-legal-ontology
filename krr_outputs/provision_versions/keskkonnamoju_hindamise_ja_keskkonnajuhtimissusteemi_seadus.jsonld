      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Otsustaja on tegevusloa andja. (2) Kui otsustaja on ka arendaja, ei tohi otsustaja ülesandeid täitev ametnik samal ajal täita arendaja ülesandeid.",
