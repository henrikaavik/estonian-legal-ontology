      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 15 lõige 14 jõustub 2005. aasta 1. juunil. (2) Käesoleva seaduse § 6 lõige 4 ja § 22 lõige 4 jõustuvad 2005. aasta 1. juulil. (3) Käesoleva seaduse § 12 lõige 2 jõustub 2005. aasta 1. septembril.",
      "rdfs:label": {
        "@value": "KeHJS_Par_71 (redaktsioon 12766212)",
        "@language": "et"
