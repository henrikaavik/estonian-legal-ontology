      }
    },
    {
      "@id": "estleg:KeHJS_Par_2_4_v121122019007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeHJS_Par_2_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 151 lõigetes 2, 4, 5 ja 7, § 17 lõikes 3, § 18 lõigetes 2, 4, 7 ja 8, § 201 lõikes 2, § 22 lõigetes 1, 3, 5 ja 7, § 261 lõikes 4, § 361 lõigetes 2, 4 ja 5, § 37 lõikes 6, § 39 lõigetes 2 ja 4 ning § 42 lõigetes 3, 5 ja 7 nimetatud tähtaegu võib põhjendatud juhul, nagu dokumentide maht, kavandatava tegevuse või strateegilise planeerimisdokumendi keerukus, pikendada, määrates menetlustoiminguks uue tähtaja.",
      "rdfs:label": {
        "@value": "KeHJS_Par_2_4 (redaktsioon 121122019007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122019007",
