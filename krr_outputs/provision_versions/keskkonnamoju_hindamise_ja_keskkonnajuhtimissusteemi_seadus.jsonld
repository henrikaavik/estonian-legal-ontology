    },
    {
      "@id": "estleg:KeHJS_Par_2_4_v111062024007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeHJS_Par_2_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 17 lõigetes 11 ja 3, § 18 lõigetes 2, 7 ja 8, § 21 lõigetes 4 ja 5, § 22 lõigetes 1 ja 5, § 261 lõikes 4, § 281 lõikes 6, § 361 lõigetes 2, 4 ja 5, § 37 lõikes 6, § 39 lõigetes 2 ja 4 ning § 42 lõigetes 3, 5 ja 7 nimetatud tähtaegu võib pikendada põhjendatud juhul, nagu dokumentide suur maht või kavandatava tegevuse või strateegilise planeerimisdokumendi keerukus, määrates menetlustoiminguks uue tähtaja.",
      "rdfs:label": {
        "@value": "KeHJS_Par_2_4 (redaktsioon 111062024007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111062024007",
      "estleg:supersededByVersion": {
