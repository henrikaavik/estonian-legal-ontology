      },
      "estleg:versionText": "Toetuse taotlusi menetleb, taotluse rahuldamise ja rahuldamata jätmise otsustab, makseid ja järelevalvet projekti üle teeb KIK. Toetuse taotlusi menetleb, taotluse rahuldamise ja rahuldamata jätmise otsustab, makseid ja järelevalvet projekti üle teeb KIK.",
      "rdfs:label": {
        "@value": "Reg_1061561_Par_3 (redaktsioon 1061561)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061561",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061561",
      "estleg:sourceAct": "Elektriauto laadimispunktide rajamise toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1061561 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061561_Map"
      }
