    {
      "@id": "estleg:ATMOSF_Par_123_2_v118052022011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_123_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 1231 lõikes 1 nimetatud minimaalse kütuse elutsükli jooksul tekkivate kasvuhoonegaaside heitkoguste vähendamise kohustuse võivad tarnijad täita ühiselt ja sel juhul käsitletakse neid ühe tarnijana. Kohustuse täitmata jätmisel vastutab tarnija, kes on käesoleva seaduse § 1231 lõikes 1 nimetatud kohustuse täitja. (2) Kui tarnijad otsustavad täita käesoleva seaduse § 1231 lõikes 1 nimetatud kohustuse ühiselt, tuleb selle kohta sõlmida kokkulepe vedelkütuse seaduse § 26 lõikes 2 nimetatud digitaalse keskkonna kaudu. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "ATMOSF_Par_123_2 (redaktsioon 118052022011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118052022011",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_123_2_v118032026004"
      },
      "estleg:versionValidTo": {
        "@value": "2026-03-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118052022011",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 123_2",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_123_2_v118032026004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_123_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu - , rakendatakse tagasiulatuvalt 2026. aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_123_2 (redaktsioon 118032026004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032026004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118032026004",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 123_2",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
