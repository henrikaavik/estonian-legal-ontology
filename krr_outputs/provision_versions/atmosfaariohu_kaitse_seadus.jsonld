        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide kohta esitatavate nõuete täitmise üle teostavad: Keskkonnaamet – lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide kasutamise kohta esitatavate nõuete täitmise üle; kehtetu - Maksu- ja Tolliamet – lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide sisseveo kohta esitatavate nõuete täitmise üle; Terviseamet – lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide märgistuse vastavuse kohta esitatavate nõuete täitmise üle.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_219 (redaktsioon 117032023033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023033",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032023033",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 219",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_22_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maapinnalähedane õhukiht ulatub õhukvaliteedi hindamisel kuni nelja meetri kõrguseni maapinnast või kõrguseni, kuhu avalikkusel on korrapärane juurdepääs või kus on püsiv asustus.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_22 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 22",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
