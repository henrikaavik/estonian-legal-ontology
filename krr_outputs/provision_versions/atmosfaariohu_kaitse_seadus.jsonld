    {
      "@id": "estleg:ATMOSF_Par_108_2_v126062018026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_108_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohaldatakse käesoleva seaduse § 1081 lõiget 1, 3, 5, 6 või 7, teavitab Keskkonnaministeerium sellest Euroopa Komisjoni asjaomasele aruandeaastale järgneva aasta 15. veebruariks. Teavitus peab kajastama asjaomaseid saasteaineid ja sektoreid ning riiklikele heiteinventuuridele avalduva mõju suurust, kui see on teada.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_108_2 (redaktsioon 126062018026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018026",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_108_2_v122092023001"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018026",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 108_2",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_108_2_v122092023001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_108_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohaldatakse käesoleva seaduse § 1081 lõiget 1, 3, 5, 6 või 7, teavitab Kliimaministeerium sellest Euroopa Komisjoni asjaomasele aruandeaastale järgneva aasta 15. veebruariks. Teavitus peab kajastama asjaomaseid saasteaineid ja sektoreid ning riiklikele heiteinventuuridele avalduva mõju suurust, kui see on teada.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_108_2 (redaktsioon 122092023001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122092023001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122092023001",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 108_2",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_109_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaohu vältimiseks võib kohaliku omavalitsuse üksus saasteainete hajumiseks ebasoodsate ilmastikutingimuste korral, kui teatud õhukvaliteedi piirkonnas või linnastus võib esineda mingi saasteaine kohta käesoleva seaduse § 47 lõigete 1 ja 2 alusel kehtestatud õhukvaliteedi piir- või sihtväärtuse või häiretaseme ületamine, piirata liikluskorraldusega mootorsõidukite, välja arvatud eritalituse sõidukite liikumist.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_109 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 109",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_11_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhukvaliteedi piirväärtuse lubatud ületamise määr on protsentides väljendatud osa õhukvaliteedi piirväärtusest, mille võrra käesolevas seaduses sätestatud tingimustel võib kehtestatud piirväärtust ajutiselt ületada.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_11 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 11",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_110_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_110"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liikuva heiteallika heitgaasi saasteainete sisalduse ja suitsususe normid, sealhulgas välisõhku väljutatavate saasteainete heite piirväärtused mootorsõiduki läbisõidu või energiaühiku kohta, ning mürataseme piirväärtused kehtestab määrusega. (2) Kui liikuva heiteallika heitgaasi saasteainete sisaldus ja suitsusus või müratase ei vasta käesoleva paragrahvi lõike 1 alusel kehtestatud nõuetele, on nende masinate tootmine, Eestisse sissevedu, töötava mootoriga masinate Eestist läbivedu ja kasutamine keelatud.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_110 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_110_v103072017015"
      },
      "estleg:versionValidTo": {
        "@value": "2017-07-12",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 110",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_110_v103072017015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_110"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ATMOSF_Par_110 (redaktsioon 103072017015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103072017015",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103072017015",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 110",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_111_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_111"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Uue mootorsõiduki tootja, importija või müüja teavitab kasutajat mootorsõiduki kütusekulust ja väljutatava süsinikdioksiidi heitest. (2) Uue mootorsõiduki kasutajale antavate andmete loetelu ja kasutaja teavitamise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_111 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 111",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_112_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maanteetranspordis kasutatavad rehvid märgistatakse madala mürataseme, kütusesäästlikkuse ja ohutuse eesmärgil rehvide parameetrite kohta ühtlustatud teabe andmiseks vastavalt Euroopa Parlamendi ja nõukogu määrusele (EÜ) nr 1222/2009 rehvide kütusesäästlikkuse ja muude oluliste parameetrite märgistamise kohta (ELT L 342, 22.12.2009, lk 46–58).",
      "rdfs:label": {
        "@value": "ATMOSF_Par_112 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_112_v125102022007"
      },
      "estleg:versionValidTo": {
        "@value": "2022-11-03",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 112",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_112_v125102022007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maanteetranspordis kasutatavad rehvid märgistatakse madala mürataseme, kütusesäästlikkuse ja ohutuse eesmärgil rehvide parameetrite kohta ühtlustatud teabe andmiseks vastavalt Euroopa Parlamendi ja nõukogu määrusele (EL) 2020/740, mis käsitleb rehvide kütusesäästlikkuse ja muude näitajate märgistamist ning millega muudetakse määrust (EL) 2017/1369 ja tunnistatakse kehtetuks määrus (EÜ) nr 1222/2009 (ELT L 177, 05.06.2020, lk 1–31).",
      "rdfs:label": {
        "@value": "ATMOSF_Par_112 (redaktsioon 125102022007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "125102022007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/125102022007",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 112",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_112_1_v129112018004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_112_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2016/1628, mis käsitleb väljaspool teid kasutatavate liikurmasinate sisepõlemismootorite gaasiliste saasteainete ja tahkete osakeste heite piirnorme ja tüübikinnitusega seotud nõudeid, millega muudetakse määruseid (EL) nr 1024/2012 ja (EL) nr 167/2013 ning muudetakse direktiivi 97/68/EÜ ja tunnistatakse see kehtetuks (ELT L 252, 16.09.2016, lk 53–117), kohane tüübikinnitusasutus Eestis on Tehnilise Järelevalve Amet. (2) Tüübikinnitustunnistuse taotluse läbivaatamise ja tüübikinnitustunnistuse muutmise taotluse läbivaatamise eest tasutakse riigilõivu. (3) Tüübikinnituseks vajalik katse tehakse tüübikinnituse taotleja kulul.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_112_1 (redaktsioon 129112018004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129112018004",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_112_1_v122122018007"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129112018004",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 112_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_112_1_v122122018007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_112_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2016/1628, mis käsitleb väljaspool teid kasutatavate liikurmasinate sisepõlemismootorite gaasiliste saasteainete ja tahkete osakeste heite piirnorme ja tüübikinnitusega seotud nõudeid, millega muudetakse määruseid (EL) nr 1024/2012 ja (EL) nr 167/2013 ning muudetakse direktiivi 97/68/EÜ ja tunnistatakse see kehtetuks (ELT L 252, 16.09.2016, lk 53–117), kohane tüübikinnitusasutus Eestis on Tarbijakaitse ja Tehnilise Järelevalve Amet. (2) Tüübikinnitustunnistuse taotluse läbivaatamise ja tüübikinnitustunnistuse muutmise taotluse läbivaatamise eest tasutakse riigilõivu. (3) Tüübikinnituseks vajalik katse tehakse tüübikinnituse taotleja kulul.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_112_1 (redaktsioon 122122018007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018007",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 112_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_113_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_113"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite, välja arvatud aerosoolide, ning sõidukite väljaspool tootmisseadeldisi kasutatavate viimistlusmaterjalide alaliigid, lenduvate orgaaniliste ühendite sisalduse piirväärtused ning piirväärtustele vastavuse määramiseks kasutatavad meetodid kehtestab määrusega. (2) Käesoleva paragrahvi lõikes 1 nimetatud toodetele ning nende käitlemisele kohaldatakse kemikaaliseaduse sätteid, arvestades käesolevas seaduses sätestatud erisusi.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_113 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 113",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_114_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_114"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 113 lõikes 1 nimetatud toodete märgistusele lisatakse järgmine teave: toote alaliik ja alaliigile vastav lenduvate orgaaniliste ühendite sisalduse piirväärtus grammides liitri kohta; kasutamisvalmis tootes, mis sisaldab lahusteid või lahusteid sisaldavaid muid komponente, lenduvate orgaaniliste ühendite maksimaalne sisaldus grammides liitri kohta.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_114 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 114",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_115_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_115"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide erandkorras kasutamise luba (edaspidi viimistlusmaterjalide kasutamisluba) annab õiguse kasutada erandkorras lenduvate orgaaniliste ühendite sisalduse piirväärtusele mittevastavat, käesoleva seaduse § 113 lõikes 1 nimetatud toodet ajaloolist ja kultuuriväärtust omava hoone või vanasõiduki restaureerimiseks ja hooldamiseks eesmärgil see turustada, sealhulgas see Euroopa Liidu territooriumile viia ning seal kasutada.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_115 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 115",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_116_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_116"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Viimistlusmaterjalide kasutamisloa annab Keskkonnaamet.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_116 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 116",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_117_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Viimistlusmaterjalide kasutamisloa taotlemise ja andmise korra ning taotluse ja loa vormid kehtestab määrusega.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_117 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 117",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_118_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Viimistlusmaterjalide kasutamisloa andja keeldub viimistlusmaterjalide kasutamisloa andmisest, kui: loa taotleja on esitanud tegelikkusele mittevastavaid andmeid; arvestades planeeritavat restaureerimist või hooldamist on taotletava toote kogus põhjendamatult suur; toote kasutamisega kaasneb märkimisväärne oht inimese tervisele või keskkonnale.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_118 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 118",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_119_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaamet toimetab loa taotlejale kätte viimistlusmaterjalide kasutamisloa või loa andmisest keeldumise otsuse ning avalikustab selle oma veebilehel.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_119 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_119_v113032019034"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 119",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_119_v113032019034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ATMOSF_Par_119 (redaktsioon 113032019034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019034",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019034",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 119",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_12_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhukvaliteedi sihtväärtus on saasteaine kogus välisõhu ruumalaühikus või pinnaühikule sadestunud saasteaine kogus, mis tuleb nimetatud koguse ületamise korral saavutada asjakohaste meetmetega, mis ei too kaasa ebaproportsionaalselt suuri kulutusi, kas kindlaksmääratud aja jooksul või võimalikult kiiresti ja mille eesmärk on parandada õhukvaliteeti ja vältida või vähendada ebasoodsat mõju inimese tervisele ja keskkonnale. (2) Kui saasteaine kohta on käesoleva seaduse § 47 lõike 1 alusel lisaks õhukvaliteedi sihtväärtusele kehtestatud sihtväärtuse ületamise lubatud kordade arv kalendriaastas, loetakse, et sellest kinnipidamise korral sihtväärtust ületatud ei ole.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_12 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 12",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_120_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_120"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vedelkütuste kohta esitatavad keskkonnanõuded, biokütuste ja vedelate biokütuste säästlikkuse kriteeriumid, vedelkütuste keskkonnanõuetele vastavuse seire ja aruandmise korra ning biokütuste ja vedelate biokütuste kasutamisest tuleneva kasvuhoonegaaside heitkoguste vähenemise määramise metoodika kehtestab saasteainete heitkoguste piiramise eesmärgil määrusega. (2) Käesoleva paragrahvi lõikes 1 nimetatud määrusega sätestatakse: maanteesõidukites ja väljaspool teid kasutatavates liikurmasinates, siseveelaevades, põllu- ja metsamajandustraktorites ning väikelaevades, kui need ei ole merel, otto- ja diiselmootorites kasutatava bensiini, diislikütuse, gaasiõli, kerge kütteõli ja mootorikütustena kasutatavate biokütuste kohta esitatavad keskkonnanõuded; gaasiõli, kerge kütteõli, raske kütteõli ja laevakütuste kohta esitatavad keskkonnanõuded; biokütuste ja vedelate biokütuste säästlikkuse kriteeriumid; väikese väävlisisaldusega laevakütuse kasutamise alternatiivina heitevähendusmeetodite kasutamise lubamise korra; biokütuse või vedelate biokütuste kasutamisest tuleneva kasvuhoonegaaside heitkoguste vähenemise määramise metoodika; vedelkütuste keskkonnanõuetele vastavuse seire ja aruandmise korra; laevakütuste keskkonnanõuetele vastavuse üle järelevalve teostamise täpsustatud korra. (3) Biokütus käesoleva seaduse tähenduses on transpordis kasutatav biomassist toodetud vedel- või gaaskütus. (4) Vedel biokütus käesoleva seaduse tähenduses on energia saamiseks, sealhulgas elektri-, soojus- ja jahutusenergia, välja arvatud transpordi jaoks kasutatava energia saamiseks kasutatav vedelkütus, mis on toodetud biomassist. (5) Biomass käesoleva seaduse tähenduses on põllumajandusest (nii taimsetest kui ka loomsetest ainetest), metsatööstusest ja sellega seotud tootmisest, kalandusest ja vesiviljelusest saadav bioloogilise päritoluga toodete, jäätmete ja jääkide bioloogiliselt lagunev fraktsioon ning tööstus- ja olmejäätmete bioloogiliselt lagunev fraktsioon.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_120 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_120_v103062020002"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-12",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
