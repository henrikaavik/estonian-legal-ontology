      }
    },
    {
      "@id": "estleg:ATMOSF_Par_225_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korrakaitseorgan võib käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete täitmise tagamiseks teha mõõtmisi ning võtta tasuta proove. (2) Kütuseproove on õigustatud võtma ka Keskkonnaministeeriumi volitatud akrediteeritud labor. (3) Välisõhus leviva müra normtaseme ületamise vältimiseks võib kohaliku omavalitsuse üksus liikluskorraldusega piirata mootorsõidukite liikumist oma territooriumil.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_225 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_225_v122092023001"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 225",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
