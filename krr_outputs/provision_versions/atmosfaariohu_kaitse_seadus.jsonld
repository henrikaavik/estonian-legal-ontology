    },
    {
      "@id": "estleg:ATMOSF_Par_219_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_219"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide kohta esitatavate nõuete täitmise üle teostavad: Keskkonnainspektsioon – lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide kasutamise kohta esitatavate nõuete täitmise üle; Tarbijakaitseamet – lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide märgistuse vastavuse kohta esitatavate nõuete täitmise üle jaemüügis; Maksu- ja Tolliamet – lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide sisseveo kohta esitatavate nõuete täitmise üle; Terviseamet – lenduvaid orgaanilisi ühendeid sisaldavate värvide ja muude pinnakattevahendite ning sõidukite viimistlusmaterjalide märgistuse vastavuse kohta esitatavate nõuete täitmise üle hulgimüügis.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_219 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_219_v122122018007"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 219",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
