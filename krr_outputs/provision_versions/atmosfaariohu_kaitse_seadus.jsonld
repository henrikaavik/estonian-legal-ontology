      "estleg:provisionRef": "ATMOSF § 165_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_165_1_v125062021004",
      "@type": [
