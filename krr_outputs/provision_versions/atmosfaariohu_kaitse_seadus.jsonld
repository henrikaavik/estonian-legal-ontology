      }
    },
    {
      "@id": "estleg:ATMOSF_Par_147_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_147"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaministeerium keeldub heitkoguse loa andmisest, kui: heitkoguse loa taotleja ei tegutse käesoleva seaduse § 155 lõike 1 alusel kehtestatud määruses nimetatud tegevusalal või tema käitis ei ületa selle tegevusala jaoks kehtestatud heitkoguse loa omamise läviväärtust; heitkoguse loa taotlejal ei ole õhusaasteluba või keskkonnakompleksluba; ilmneb olulisi vasturääkivusi heitkoguse loa taotluses esitatud andmete ja käitisele antud õhusaasteloa või keskkonnakompleksloa vahel; loa taotleja ei ole esitanud käesoleva seaduse alusel nõutavaid andmeid või on esitanud eksitavaid või tegelikkusele mittevastavaid andmeid või võltsitud dokumente; heitkoguse loa taotleja on mõistetud mis tahes süüteo eest tegevuse sundlõpetamisele ning sellekohane kohtuotsus on jõustunud; esineb keskkonnaseadustiku üldosa seaduse § 52 lõikes 1 sätestatud alus.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_147 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_147_v105112019005"
      },
      "estleg:versionValidTo": {
        "@value": "2019-11-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 147",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_147_v105112019005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_147"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaamet keeldub heitkoguse loa andmisest, kui: heitkoguse loa taotleja ei tegutse käesoleva seaduse § 155 lõike 1 alusel kehtestatud määruses nimetatud tegevusalal või tema käitis ei ületa selle tegevusala jaoks kehtestatud heitkoguse loa omamise läviväärtust; heitkoguse loa taotlejal ei ole õhusaasteluba või keskkonnakompleksluba; ilmneb olulisi vasturääkivusi heitkoguse loa taotluses esitatud andmete ja käitisele antud õhusaasteloa või keskkonnakompleksloa vahel; loa taotleja ei ole esitanud käesoleva seaduse alusel nõutavaid andmeid või on esitanud eksitavaid või tegelikkusele mittevastavaid andmeid või võltsitud dokumente; heitkoguse loa taotleja on mõistetud mis tahes süüteo eest tegevuse sundlõpetamisele ning sellekohane kohtuotsus on jõustunud; esineb keskkonnaseadustiku üldosa seaduse § 52 lõikes 1 sätestatud alus.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_147 (redaktsioon 105112019005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105112019005",
