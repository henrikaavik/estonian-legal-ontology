      }
    },
    {
      "@id": "estleg:ATMOSF_Par_221_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_221"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet osoonikihti kahandavate ainete käitlemisnõuete täitmise üle teostavad: Keskkonnainspektsioon – osoonikihti kahandavate ainete käitlemise üle; Maksu- ja Tolliamet – osoonikihti kahandavate ainete, neid aineid sisaldavate või nendel ainetel põhinevate toodete ja seadmete sisse- ja väljaveo üle; Ravimiamet – osoonikihti kahandavate ainete baasil toimivate dosaatorinhalaatorite üle.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_221 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_221_v130102020003"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 221",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_221_v130102020003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_221"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet osoonikihti kahandavate ainete käitlemisnõuete täitmise üle teostavad: Keskkonnaamet – osoonikihti kahandavate ainete käitlemise üle; Maksu- ja Tolliamet – osoonikihti kahandavate ainete, neid aineid sisaldavate või nendel ainetel põhinevate toodete ja seadmete sisse- ja väljaveo üle; Ravimiamet – osoonikihti kahandavate ainete baasil toimivate dosaatorinhalaatorite üle.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_221 (redaktsioon 130102020003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130102020003",
