      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Müraallika valdaja tagab, et tema müraallika territooriumilt ei levi normtaset ületavat müra.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_59 (redaktsioon 123122016002)",
        "@language": "et"
      },
