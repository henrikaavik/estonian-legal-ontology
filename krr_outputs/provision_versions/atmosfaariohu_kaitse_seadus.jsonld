      }
    },
    {
      "@id": "estleg:ATMOSF_Par_222_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_222"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet fluoritud kasvuhoonegaaside käitlemisnõuete täitmise üle teostavad: Keskkonnainspektsioon – ettevõtja ja tema tegevuse käesolevas seaduses, selle alusel kehtestatud õigusaktides ning Euroopa Parlamendi ja nõukogu määruses (EL) nr 517/2014 ja selle rakendusmäärustes sätestatud fluoritud kasvuhoonegaaside käitlemisnõuetele vastavuse üle; Maksu- ja Tolliamet – fluoritud kasvuhoonegaase sisaldavate toodete, seadmete ja süsteemide impordi, sealhulgas fluoritud kasvuhoonegaase sisaldavate toodete, seadmete ja süsteemide märgistamisnõuete täitmise üle; kutseseaduse §-s 6 nimetatud kutseasutus – Euroopa Parlamendi ja nõukogu määruses (EL) nr 517/2014 ning käesoleva seaduse § 194 lõikes 2 nimetatud Euroopa Komisjoni määrustes sätestatud töötajatele kutse andmise nõuete täitmise üle kutseseaduse kohaselt.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_222 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_222_v130102020003"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 222",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
