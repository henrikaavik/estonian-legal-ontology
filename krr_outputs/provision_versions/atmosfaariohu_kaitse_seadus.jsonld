      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhukvaliteedi piirkond on õhusaastega kokku puutuva elanikkonna ja ökosüsteemide ruumilist ulatust arvestades moodustatud piirkond, kus korraldatakse õhukvaliteedi juhtimist ja hindamist.",
