      }
    },
    {
      "@id": "estleg:ATMOSF_Par_214_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_214"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sellise suure põletusseadme käitaja, mille elektriline nimivõimsus on planeeritud 300 megavatti või enam, esitab enne suurele põletusseadmele ehitusloa saamist Keskkonnaministeeriumile hinnangu selle kohta, kas: süsinikdioksiidi maapõues säilitamiseks sobivad kohad on kättesaadavad; süsinikdioksiidi transport on tehniliselt ja majanduslikult võimalik; süsinikdioksiidi kogumissüsteemi moderniseerimine on tehniliselt ja majanduslikult võimalik. (2) Keskkonnaministeerium teeb otsuse suurest põletusseadmest lähtuva süsinikdioksiidi kogumise ja transportimise võimalikkuse kohta, võttes aluseks käesoleva paragrahvi lõikes 1 nimetatud hinnangu ja muu kättesaadava teabe, sealhulgas teabe, mis käsitleb inimese tervist ja keskkonnakaitset. (3) Kui Keskkonnaministeeriumi otsuse järgi on suurest põletusseadmest lähtuva süsinikdioksiidi kogumine ja transportimine võimalik, tagab suure põletusseadme käitaja, et suure põletusseadme asukohas on piisavalt ruumi süsinikdioksiidi kogumiseks ja kompressiooniks vajalike seadmete jaoks.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_214 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_214_v122092023001"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 214",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_214_v122092023001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
