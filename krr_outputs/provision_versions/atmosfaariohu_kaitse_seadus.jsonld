    {
      "@id": "estleg:ATMOSF_Par_102_v122092023001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_102"
      },
      "estleg:versionValidFrom": {
