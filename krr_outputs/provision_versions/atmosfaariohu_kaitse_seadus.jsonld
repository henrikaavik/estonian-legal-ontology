    {
      "@id": "estleg:ATMOSF_Par_152_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_152"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui heitkoguse luba tunnistatakse kehtetuks käitaja taotlusel, on käitaja kohustatud esitama kauplemissüsteemist väljaarvamise taotluse Keskkonnaministeeriumile vähemalt neli kuud enne kavandatavat tegevuse lõpetamist või kauplemissüsteemist väljaarvamist põhjustavat tegevuse muudatust.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_152 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_152_v105112019005"
      },
      "estleg:versionValidTo": {
        "@value": "2019-11-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 152",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_152_v105112019005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_152"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui heitkoguse luba tunnistatakse kehtetuks käitaja taotlusel, on käitaja kohustatud esitama kauplemissüsteemist väljaarvamise taotluse Keskkonnaametile vähemalt neli kuud enne kavandatavat tegevuse lõpetamist või kauplemissüsteemist väljaarvamist põhjustavat tegevuse muudatust.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_152 (redaktsioon 105112019005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105112019005",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_152_v121122019003"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105112019005",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 152",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_152_v121122019003",
