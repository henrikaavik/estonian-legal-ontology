        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet välisõhus leviva müra üle teostab Terviseamet.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_218 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
