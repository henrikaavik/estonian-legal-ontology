      "estleg:provisionRef": "ATMOSF § 161",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_161_v130102020003",
      "@type": [
