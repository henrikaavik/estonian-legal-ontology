      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Süsinikdioksiidi ekvivalent on üks tonn süsinikdioksiidi või muud kasvuhoonegaasi, mis on ümber arvutatud süsinikdioksiidi koguseks, kasutades globaalse soojendamise potentsiaali vastavalt Euroopa Komisjoni määruse (EL) nr 601/2012, millega kehtestatakse suunised Euroopa Parlamendi ja nõukogu direktiivi 2003/87/EÜ kohase kasvuhoonegaaside heite seire ja aruandluse kohta (ELT 181, 12.07.2012, lk 30–104), VI lisa punkti 3 tabelile 6.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_133 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
