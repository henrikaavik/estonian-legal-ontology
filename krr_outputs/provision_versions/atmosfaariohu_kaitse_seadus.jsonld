      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisõhu füüsikaline mõjutamine on välisõhu mõjutamine müraga ning infra- ja ultraheliga.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_6 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
