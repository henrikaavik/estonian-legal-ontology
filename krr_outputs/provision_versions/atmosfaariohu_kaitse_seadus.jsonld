    {
      "@id": "estleg:ATMOSF_Par_123_2_v103072017015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_123_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 1231 lõikes 1 nimetatud minimaalse kütuse elutsükli jooksul tekkivate kasvuhoonegaaside heitkoguste vähendamise kohustuse võivad tarnijad täita ühiselt, kuid sel juhul käsitletakse neid ühe tarnijana. (2) Kui tarnijad otsustavad täita § 1231 lõikes 1 nimetatud kohustuse ühiselt, tuleb selle kohta sõlmida kirjalik kokkulepe, mis peab sisaldama ajavahemikku, mille jooksul tarnijad kohustust ühiselt täidavad. (3) Kokkulepe esitatakse Keskkonnaametile üks kuu enne ühise kohustuse täitmise algust.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_123_2 (redaktsioon 103072017015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103072017015",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_123_2_v103062020002"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-12",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103072017015",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 123_2",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_123_2_v103062020002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_123_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 1231 lõikes 1 nimetatud minimaalse kütuse elutsükli jooksul tekkivate kasvuhoonegaaside heitkoguste vähendamise kohustuse võivad tarnijad täita ühiselt ja sel juhul käsitletakse neid ühe tarnijana. Kohustuse täitmata jätmisel vastutab tarnija, kes on käesoleva seaduse § 1231 lõikes 1 nimetatud kohustuse täitja. (2) Kui tarnijad otsustavad täita käesoleva seaduse § 1231 lõikes 1 nimetatud kohustuse ühiselt, tuleb selle kohta sõlmida kirjalik kokkulepe, mis peab sisaldama ajavahemikku, mille jooksul tarnijad kohustust ühiselt täidavad, ja ühelt tarnijalt teisele ülekantava kasvuhoonegaaside heitkoguste vähendamise kogust väljendatuna gCO2ekv/MJ. (3) Kokkulepe esitatakse Keskkonnaametile hiljemalt kohustuse täitmise perioodi lõpuks.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_123_2 (redaktsioon 103062020002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103062020002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_123_2_v118052022011"
      },
      "estleg:versionValidTo": {
        "@value": "2022-05-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103062020002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 123_2",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
