      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär 32 000 eurot.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_226 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 226",
      "estleg:partOfAct": {
