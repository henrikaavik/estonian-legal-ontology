      }
    },
    {
      "@id": "estleg:ATMOSF_Par_129_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_129"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikud, kes peavad liikuvate heiteallikate arvestust, esitavad Keskkonnaministeeriumile riigi territooriumil liikuvatest heiteallikatest välisõhku väljutatavate saasteainete heitkoguste arvutamiseks järgmised koondandmed maakondade kaupa: mootorsõidukite tüübid ja arv ning iga sõidukitüübi läbisõit; lennuoperatsioonide arv õhusõidukite tüüpide kaupa ja nende jagunemine lennutüüpideks riikidevaheliseks või riigisiseseks lennuks iga lennujaama kohta eraldi; liikurmasinate tüübid ja arv; mootorvedurite tüübid ja arv. (2) Andmeid esitama kohustatud isikute loetelu, andmete esitamise tähtaja ja vormi kehtestab määrusega.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_129 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_129_v122092023001"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 129",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_129_v122092023001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_129"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikud, kes peavad liikuvate heiteallikate arvestust, esitavad Kliimaministeeriumile riigi territooriumil liikuvatest heiteallikatest välisõhku väljutatavate saasteainete heitkoguste arvutamiseks järgmised koondandmed maakondade kaupa: mootorsõidukite tüübid ja arv ning iga sõidukitüübi läbisõit; lennuoperatsioonide arv õhusõidukite tüüpide kaupa ja nende jagunemine lennutüüpideks riikidevaheliseks või riigisiseseks lennuks iga lennujaama kohta eraldi; liikurmasinate tüübid ja arv; mootorvedurite tüübid ja arv. (2) Andmeid esitama kohustatud isikute loetelu, andmete esitamise tähtaja ja vormi kehtestab määrusega.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_129 (redaktsioon 122092023001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122092023001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122092023001",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 129",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_13_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhukvaliteedi kriitiline tase on saasteaine kogus välisõhu ruumalaühikus või pinnaühikule sadestunud saasteaine kogus, mis on kehtestatud teaduslike andmete alusel ja mille ületamisel võib tõenäoliselt ilmneda vahetu oluline ebasoodne mõju ökosüsteemile või selle osale, välja arvatud inimesele.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_13 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 13",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_130_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_130"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kasvuhoonegaasid käesoleva seaduse tähenduses on süsinikdioksiid (CO2), metaan (CH4), dilämmastikoksiid (N2O), fluorosüsivesinikud (HFCd), perfluorosüsivesinikud (PFCd) ja väävelheksafluoriid (SF6) ning muud looduslikud ja inimtekkelised atmosfääri gaasilised koostisosad, mis neelavad ja kiirgavad infrapunakiirgust.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_130 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 130",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_131_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_131"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kasvuhoonegaaside heitkogus käesoleva seaduse tähenduses on kasvuhoonegaaside lubatud heitkoguse ühikutega kauplemise süsteemi kuuluvate paikse heiteallika käitajate ja õhusõiduki käitajate tegevusest pärinev kasvuhoonegaaside heide atmosfääri.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_131 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_131_v102102025017"
      },
      "estleg:versionValidTo": {
        "@value": "2025-10-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 131",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_131_v102102025017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_131"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kasvuhoonegaaside heitkogus käesoleva peatüki tähenduses on käesoleva seaduse § 155 lõike 1 alusel kehtestatud määruses nimetatud tegevusaladelt pärinev kasvuhoonegaaside heide.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_131 (redaktsioon 102102025017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102102025017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102102025017",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 131",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_132_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_132"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seireaasta käesoleva seaduse tähenduses on kalendriaasta, mis lõpeb 24 kuud enne selle kauplemissüsteemi perioodi algust, mis on hõlmatud tasuta eraldatavate lubatud heitkoguse ühikute saamiseks esitatava taotlusega.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_132 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_132_v102102025018"
      },
      "estleg:versionValidTo": {
        "@value": "2025-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 132",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
