      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaministeerium korraldab fluoritud kasvuhoonegaase käsitlevate õigusaktide rakendamist ja riigi aruandlust lähtuvalt kliimamuutuste raamkonventsiooni, Kyoto protokolli ja Euroopa Liidu fluoritud kasvuhoonegaaside alaste õigusaktide nõuetest.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_190 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
