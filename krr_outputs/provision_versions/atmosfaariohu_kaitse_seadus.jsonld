      "estleg:provisionRef": "ATMOSF § 127",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_128_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_128"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registreerimiskohustusega käitaja esitab registreeringu andjale välisõhu saastamisega seotud aastaaruande, mis peab sisaldama: põletusseadme korral andmeid kütuse kulu kohta, loomakasvatuse korral loomade arvu kohta, tankla korral naftasaadustuste laadimiskoguste kohta; andmeid igast heiteallikast välisõhku väljutatavate saasteainete tegelike heitkoguste kohta. (2) Registreerimiskohustusega käitaja aastaaruande vormi ja esitamise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_128 (redaktsioon 123122016002)",
        "@language": "et"
      },
