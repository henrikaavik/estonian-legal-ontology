    {
      "@id": "estleg:ATMOSF_Par_239_v118032026004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruses (EL) 2024/573, komisjoni määruses (EÜ) nr 1497/2007, millega kehtestatakse vastavalt Euroopa Parlamendi ja nõukogu määrusele (EÜ) nr 842/2006 standarditud lekkekontrolli nõuded teatavaid fluoritud kasvuhoonegaase sisaldavatele statsionaarsetele tuletõrjesüsteemidele (ELT L 333, 19.12.2007, lk 4–5), ja komisjoni määruses (EÜ) nr 1516/2007, millega kehtestatakse vastavalt Euroopa Parlamendi ja nõukogu määrusele (EÜ) nr 842/2006 standarditud lekkekontrolli nõuded teatavaid fluoritud kasvuhoonegaase sisaldavatele statsionaarsetele jahutus- ja kliimaseadmetele ning soojuspumpadele (ELT L 335, 20.12.2007, lk 10–12), kehtestatud fluoritud kasvuhoonegaase sisaldavate toodete, seadmete ja süsteemide lekke vältimise, lekke tuvastamise süsteemi olemasolu, lekkekontrolli tegemise või lekke piiramise nõuete rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 200 000 eurot.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_239 (redaktsioon 118032026004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032026004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118032026004",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 239",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_24_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhukvaliteedi piirkondades, kus õhukvaliteedi tase on madalam saasteaine kohta käesoleva seaduse § 47 lõigete 1 ja 2 alusel kehtestatud õhukvaliteedi piir- või sihtväärtusest, tuleb säilitada parim võimalik välisõhu kvaliteet, mis on kooskõlas säästva arenguga.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_24 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 24",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_240_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_240"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruses (EL) nr 517/2014 kehtestatud fluoritud kasvuhoonegaasi sisaldavate toodete, seadmete ja süsteemide käitlemisel neis sisalduva aine viivitamata kogumise asemel selle atmosfääri paiskamise eest ning korduvtäidetava või ühekordselt täidetava mahuti kasutusea lõppedes selles sisalduva jääkgaasi nõuetekohase kogumise nõude rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_240 (redaktsioon 123122016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:ATMOSF_Par_240_v125102022007"
      },
      "estleg:versionValidTo": {
        "@value": "2022-11-03",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122016002",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 240",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
