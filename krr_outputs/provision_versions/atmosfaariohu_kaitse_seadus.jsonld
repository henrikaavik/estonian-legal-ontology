      }
    },
    {
      "@id": "estleg:ATMOSF_Par_240_1_v118032026004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ATMOSF_Par_240_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2024/573 kohaste fluoritud kasvuhoonegaaside tootmise nõuete rikkumise või tootmisõiguseta tootmise, ebaseadusliku impordi või ekspordi eest –karistatakse rahatrahviga kuni viiekordses asjaomaste gaaside turuväärtusele vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni viiekordses asjaomaste gaaside turuväärtusele vastavas summas. (3) Käesoleva paragrahvi lõigetes 1 ja 2 sätestatud teo eest, kui see on toime pandud isiku poolt, kes kordab rikkumist viie aasta jooksul, –karistatakse rahatrahviga kuni kaheksakordses asjaomaste gaaside turuväärtusele vastavas summas.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_240_1 (redaktsioon 118032026004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032026004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118032026004",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 240_1",
      "estleg:partOfAct": {
        "@id": "estleg:ATMOSF_Map"
      }
    },
    {
      "@id": "estleg:ATMOSF_Par_241_v123122016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
