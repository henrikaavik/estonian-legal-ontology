        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaametil on lubatud kasutada füüsilist jõudu korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "ATMOSF_Par_224 (redaktsioon 130102020003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130102020003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130102020003",
      "estleg:sourceAct": "Atmosfääriõhu kaitse seadus",
      "estleg:provisionRef": "ATMOSF § 224",
      "estleg:partOfAct": {
