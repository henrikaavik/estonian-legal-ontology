      "estleg:versionOf": {
        "@id": "estleg:EVH_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haridusasutusele peab olema tagatud õppe ja kasvatuse korraldamiseks vara, mille moodustavad talle omaniku poolt sihtotstarbelisse kasutusse ja valdusse antud maa, hooned, rajatised, seadmed, inventar ja muud ainelised väärtused. Vajaliku vara loetelu ja normid kehtestab Haridusministeerium. Ülikooli varade õigusliku seisundi sätestavad ülikooliseadus ja Tartu Ülikooli seadus.",
      "rdfs:label": {
        "@value": "EVH_Par_35 (redaktsioon 22218)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22218",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVH_Par_35_v217319"
      },
      "estleg:versionValidTo": {
        "@value": "2002-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EVH_Par_35_v217319",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVH_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haridusasutusele peab olema tagatud õppe ja kasvatuse korraldamiseks vara, mille moodustavad talle omaniku poolt sihtotstarbelisse kasutusse ja valdusse antud maa, hooned, rajatised, seadmed, inventar ja muud ainelised väärtused. Vajaliku vara loetelu ja normid kehtestab Haridusministeerium. Ülikooli varade õigusliku seisundi sätestavad ülikooliseadus ja Tartu Ülikooli seadus. [Paragrahvi 35 sõnastus alates 1. 01. 2003]",
      "rdfs:label": {
        "@value": "EVH_Par_35 (redaktsioon 217319)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "217319",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVH_Par_35_v562516"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EVH_Par_35_v562516",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVH_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haridusasutusele peab olema tagatud õppe ja kasvatuse korraldamiseks vara, mille moodustavad tema omandis olevad või talle omaniku poolt sihtotstarbelisse kasutusse ja valdusse antud maa, hooned, rajatised, seadmed, inventar ja muud ainelised väärtused. Ülikooli varade õigusliku seisundi sätestavad ülikooliseadus ja Tartu Ülikooli seadus. (2) Nõuded kõrghariduse omandamist võimaldava õppeasutuse õppe- ja teadustegevuseks vajalikule materiaalsele baasile kehtestab haridus- ja teadusminister määrusega.",
      "rdfs:label": {
        "@value": "EVH_Par_35 (redaktsioon 562516)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "562516",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVH_Par_35_v12778176"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EVH_Par_35_v12778176",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVH_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haridusasutusele peab olema tagatud õppe ja kasvatuse korraldamiseks vara, mille moodustavad tema omandis olevad või talle omaniku poolt sihtotstarbelisse kasutusse ja valdusse antud maa, hooned, rajatised, seadmed, inventar ja muud ainelised väärtused. Ülikooli varade õigusliku seisundi sätestavad ülikooliseadus ja Tartu Ülikooli seadus. (2) Nõuded kõrghariduse omandamist võimaldava õppeasutuse õppe- ja teadustegevuseks vajalikule materiaalsele baasile kehtestab haridus- ja teadusminister määrusega. (3) Haridusasutus loob vastavalt oma võimalustele õpilastele ja üliõpilastele koha õpilaskodus või ühiselamus, kui see on vajalik hariduse kättesaadavuse tagamiseks.",
      "rdfs:label": {
        "@value": "EVH_Par_35 (redaktsioon 12778176)",
        "@language": "et"
      },
