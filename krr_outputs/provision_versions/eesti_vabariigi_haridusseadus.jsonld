        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EVH_Par_37_v686442",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
