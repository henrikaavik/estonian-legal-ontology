        "@value": "2019-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rakenduskõrgkoolides omandatakse kõrgharidus. (2) Rakenduskõrgkoolide õigusliku seisundi kehtestavad kõrgharidusseadus ja rakenduskõrgkoolide põhimäärused.",
      "rdfs:label": {
        "@value": "EVH_Par_22 (redaktsioon 119032019084)",
        "@language": "et"
