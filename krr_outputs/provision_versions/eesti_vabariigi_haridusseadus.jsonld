    {
      "@id": "estleg:EVH_Par_27_1_v102072012010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVH_Par_27_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haridust tõendava dokumendi plankide ja medalite tellimise, väljastamise, tagastamise ning aruandluse korraldab Haridus- ja Teadusministeerium. (2) Haridust tõendava dokumendi plankide ja medalite tellimise, väljastamise, tagastamise ja aruandluse korra (3) Haridus- ja teadusminister võib haridust tõendava dokumendi plankide ja medalite tellimise, väljastamise, tagastamise ning aruandluse korraldamiseks sõlmida riigi sihtasutusega halduslepingu. Halduslepingu täitmise üle teostab järelevalvet Haridus- ja Teadusministeerium.",
      "rdfs:label": {
        "@value": "EVH_Par_27_1 (redaktsioon 102072012010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072012010",
