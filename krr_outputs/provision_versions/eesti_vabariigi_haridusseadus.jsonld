      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rakenduskõrgkoolides omandatakse kõrgharidus. (2) Rakenduskõrgkoolide õigusliku seisundi kehtestavad rakenduskõrgkooli seadus ja nende põhikirjad (põhimäärused).",
      "rdfs:label": {
