    {
      "@id": "estleg:EVH_Par_30_v22218",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVH_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigiharidusasutused alluvad Haridusministeeriumile või mõnele teisele täidesaatvale riigivõimuorganile, munitsipaalharidusasutused alluvad kohalikule omavalitsusele. (2) Erakoolid alluvad neid asutanud juriidilisele või füüsilisele isikule.",
      "rdfs:label": {
        "@value": "EVH_Par_30 (redaktsioon 22218)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22218",
