      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täienduskoolitust võimaldavad ülikoolid, rakenduskõrgkoolid, kutseõppeasutused, õhtukoolid, samuti kultuurimajad, raamatukogud ja muud kultuuriasutused, mille baasil korraldatakse täienduskoolitust; keeltekoolid, rahvakõrgkoolid, arendus- ja õppekeskused; koolitusega tegelevad ettevõtted, seltsid, liidud ja ühingud, kelle põhikirjas on nimetatud koolituse andmine.",
      "rdfs:label": {
        "@value": "EVH_Par_26 (redaktsioon 22218)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22218",
