        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ülikoolis omandatakse kõrgharidus. (2) Ülikoolide õigusliku seisundi kehtestavad ülikooliseadus ja nende põhikirjad.",
      "rdfs:label": {
        "@value": "EVH_Par_23 (redaktsioon 22218)",
        "@language": "et"
      },
