    },
    {
      "@id": "estleg:AVVKHS_Par_7_v22381",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVVKHS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui käesoleva seaduse paragrahv 1 lõikes 1 näidatud isik sureb pärast seda, kui ta oli esitanud hüvitise taotlemise avalduse Rahandusministeeriumile, läheb hüvitise nõude õigus üle tema pärijatele. (2) Kui käesoleva seaduse paragrahv 1 lõikes 1 näidatud isik sureb ning ta ei olnud esitanud hüvitise taotlemise avaldust, ei ole tema pärijatel hüvitise saamise õigust.",
      "rdfs:label": {
        "@value": "AVVKHS_Par_7 (redaktsioon 22381)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22381",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVVKHS_Par_7_v186610"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVVKHS_Par_7_v186610",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVVKHS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui käesoleva seaduse § 1 lõikes 1 näidatud isik sureb pärast seda, kui ta oli esitanud hüvitise taotlemise avalduse Rahandusministeeriumile, läheb hüvitise nõude õigus üle tema pärijatele. (2) Kui käesoleva seaduse § 1 lõikes 1 näidatud isik sureb ning ta ei olnud esitanud hüvitise taotlemise avaldust, ei ole tema pärijatel hüvitise saamise õigust.",
      "rdfs:label": {
        "@value": "AVVKHS_Par_7 (redaktsioon 186610)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186610"
    },
    {
      "@id": "estleg:AVVKHS_Par_8_v22381",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVVKHS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikult vabaduse alusetult võtmises süüdi oleva ametiisiku vastutuse ulatus ja kord reguleeritakse eraldi.",
      "rdfs:label": {
        "@value": "AVVKHS_Par_8 (redaktsioon 22381)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22381"
    },
    {
      "@id": "estleg:AVVKHS_Par_9_v22381",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVVKHS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui pärast hüvitise väljamaksmist langeb hüvitamise alus ära, on Rahandusministeeriumil õigus nõuda hüvitise tagastamist seaduses sätestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "AVVKHS_Par_9 (redaktsioon 22381)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22381"
    }
  ]
