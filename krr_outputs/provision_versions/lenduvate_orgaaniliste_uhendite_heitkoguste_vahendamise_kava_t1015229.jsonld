  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_lenduvate_orgaaniliste_uhendite_heitkoguste_vahendamise_kava_t1015229_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Lenduvate orgaaniliste ühendite heitkoguste vähendamise kava ja lahustite kasutuskava koostamise nõuded ja rakendamise juhised (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Lenduvate orgaaniliste ühendite heitkoguste vähendamise kava ja lahustite kasutuskava koostamise nõuded ja rakendamise juhised"
    },
    {
      "@id": "estleg:Reg_1015229_Par_1_v1015229",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015229_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse üldnõuded lenduvate orgaaniliste ühendite heitkoguste vähendamise kava (edaspidi vähendamiskava) ja lahustite kasutuskava koostamisele püsiva kuivainesisaldusega pinnakattevahendi, laki, liimi või trükivärviga katmise tegevusalaga tegutseva käitaja jaoks ja juhised selle rakendamiseks. Määrusega kehtestatakse üldnõuded lenduvate orgaaniliste ühendite heitkoguste vähendamise kava (edaspidi vähendamiskava) ja lahustite kasutuskava koostamisele püsiva kuivainesisaldusega pinnakattevahendi, laki, liimi või trükivärviga katmise tegevusalaga tegutseva käitaja jaoks ja juhised selle rakendamiseks.",
      "rdfs:label": {
        "@value": "Reg_1015229_Par_1 (redaktsioon 1015229)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015229",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015229",
      "estleg:sourceAct": "Lenduvate orgaaniliste ühendite heitkoguste vähendamise kava ja lahustite kasutuskava koostamise nõuded ja rakendamise juhised",
      "estleg:provisionRef": "Reg_1015229 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015229_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015229_Par_2_v1015229",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015229_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vähendamiskava koostamisel võetakse heitkoguse vähendamise lähtepunktiks selline võimalik heitkogus, mis tekiks juhul, kui ühtegi vähendamismeetodit kasutusele ei võetaks. Vähendamiskava koostamisel võetakse heitkoguse vähendamise lähtepunktiks selline võimalik heitkogus, mis tekiks juhul, kui ühtegi vähendamismeetodit kasutusele ei võetaks. 2 (2) Käesolevas määruses sätestatud vähendamiskava koostamise nõudeid kasutatakse juhul, kui võib eeldada, et käitise saaduste tahke aine püsisisaldust saab kasutada heitkoguse vähendamise lähtepunkti määramiseks. Käesolevas määruses sätestatud vähendamiskava koostamise nõudeid kasutatakse juhul, kui võib eeldada, et käitise saaduste tahke aine püsisisaldust saab kasutada heitkoguse vähendamise lähtepunkti määramiseks. 3 (3) Kui loa andja leiab, et määrusega kehtestatud vähendamiskava meetod ei ole käitisele kohane, võib ta lubada rakendada muud sobilikku kava. Kui loa andja leiab, et määrusega kehtestatud vähendamiskava meetod ei ole käitisele kohane, võib ta lubada rakendada muud sobilikku kava.",
      "rdfs:label": {
        "@value": "Reg_1015229_Par_2 (redaktsioon 1015229)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015229",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015229",
      "estleg:sourceAct": "Lenduvate orgaaniliste ühendite heitkoguste vähendamise kava ja lahustite kasutuskava koostamise nõuded ja rakendamise juhised",
      "estleg:provisionRef": "Reg_1015229 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015229_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015229_Par_3_v1015229",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015229_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vähendamiskavas nähakse ette kogu sisendmaterjali keskmise lahustisisalduse vähendamine ja tahkete komponentide kasutuse tõhususe kasv, et saavutada käitises tekkiva summaarse heitkoguse kavandatud vähendamine lähteheitkogusest aastas ehk sihtheitkogus. Vähendamiskavas nähakse ette kogu sisendmaterjali keskmise lahustisisalduse vähendamine ja tahkete komponentide kasutuse tõhususe kasv, et saavutada käitises tekkiva summaarse heitkoguse kavandatud vähendamine lähteheitkogusest aastas ehk sihtheitkogus. 2 (2) Sihtheitkogus aastas arvutatakse alljärgnevalt: 1 1) määratakse kindlaks aastas tarbitava pinnakattevahendi, trükivärvi-, laki- või liimikoguses sisalduv tahkete komponentide kogumass (Tlähte). Tahkeks komponendiks loetakse kõik pinnakattevahendis, trükivärvis, lakis ja liimis lenduvad ained, mis muutuvad tahkeks pärast vee või orgaaniliste ainete aurustumist; 2 2) arvutatakse lähteheitkogus (Mlähte) aastas, kasutades järgmist valemit: Mlähte = Tlähte × K, kus Tlähte – punkti 1 järgi määratud tahkete komponentide kogumass; K – korrutistegur, mis on esitatud alljärgnevas tabelis: <table class=\"data\" style=\"width: 65%\"> <tbody><tr> <td width=\"10%\"><div align=\"center\"><b>Jrk nr</b></div></td> <td><div><b>Tegevusala</b></div></td> <td width=\"25%\"><div align=\"center\"><b>Korrutistegur K</b></div></td></tr> <tr> <td><div align=\"center\">1.</div></td> <td><div>Rotatsioonsügavtrükk, fleksograafia</div></td> <td rowspan=\"6\"><div align=\"center\"><br/><br/><br/><br/><br/><br/><br/><br/>4</div> </td></tr> <tr> <td><div align=\"center\">2.</div></td> <td><div>Lamineerimine kui trükkimise üks osa</div></td> </tr> <tr> <td><div align=\"center\">3.</div></td> <td><div>Lakkimine kui trükkimise üks osa</div></td> </tr> <tr> <td><div align=\"center\">4.</div></td> <td><div>Puitmaterjali katmine</div></td> </tr> <tr> <td><div align=\"center\">5.</div></td> <td><div>Tekstiili, kile või paberi katmine</div></td> </tr> <tr> <td><div align=\"center\">6.</div></td> <td><div>Liimiga katmine</div></td> </tr> <tr> <td><div align=\"center\">7.</div></td> <td><div>Rullis oleva materjali katmine</div></td> <td rowspan=\"2\"><div align=\"center\"><br/><br/>3</div></td></tr> <tr> <td><div align=\"center\">8.</div></td> <td><div>Sõidukite taasviimistlemine</div></td> </tr> <tr> <td><div align=\"center\">9.</div></td> <td><div>Toiduainetega kokkupuutuvate pindade katmine</div></td> <td rowspan=\"2\"><div align=\"center\"><br/><br/>2,33</div></td></tr> <tr> <td><div align=\"center\">10.</div></td> <td><div>Õhu- või kosmosesõidukite pindade katmine</div></td> </tr> <tr> <td><div align=\"center\">11.</div></td> <td><div>Muude pindade katmine ja rotatsioonsiidtrükk</div></td> <td><div align=\"center\">1,5</div></td></tr> </tbody></table> 3 3) arvutatakse sihtheitkogus (Msiht) järgmist valemit kasutades: Msiht = Mlähte × n, kus Mlähte – punkti 2 järgi määratud lähteheitkogus aastas; n – tegur, mida arvutatakse käitise korral, mis kuulub keskkonnaministri 21. juuni 2013. a määruse nr 44 „Lahustite kasutamisel välisõhku eralduvate lenduvate orgaaniliste ühendite heite piirväärtused ja heite piirväärtustele vastavuse hindamise kriteeriumid” lisa 1 punktides 3–5 märgitud madalama lahusti aastatarbimisega käitiste hulka, järgmiselt: n = L + 15/100, kus L – kontrollimatu heite piirväärtus, %; ja kõigi teiste käitiste puhul järgmiselt: n = L + 5/100. Sihtheitkogus aastas arvutatakse alljärgnevalt: määratakse kindlaks aastas tarbitava pinnakattevahendi, trükivärvi-, laki- või liimikoguses sisalduv tahkete komponentide kogumass (Tlähte). Tahkeks komponendiks loetakse kõik pinnakattevahendis, trükivärvis, lakis ja liimis lenduvad ained, mis muutuvad tahkeks pärast vee või orgaaniliste ainete aurustumist; arvutatakse lähteheitkogus (Mlähte) aastas, kasutades järgmist valemit: Mlähte = Tlähte × K, kus Tlähte – punkti 1 järgi määratud tahkete komponentide kogumass; K – korrutistegur, mis on esitatud alljärgnevas tabelis: arvutatakse sihtheitkogus (Msiht) järgmist valemit kasutades: Msiht = Mlähte × n, kus Mlähte – punkti 2 järgi määratud lähteheitkogus aastas; n – tegur, mida arvutatakse käitise korral, mis kuulub keskkonnaministri 21. juuni 2013. a määruse nr 44 „Lahustite kasutamisel välisõhku eralduvate lenduvate orgaaniliste ühendite heite piirväärtused ja heite piirväärtustele vastavuse hindamise kriteeriumid” lisa 1 punktides 3–5 märgitud madalama lahusti aastatarbimisega käitiste hulka, järgmiselt: n = L + 15/100, kus L – kontrollimatu heite piirväärtus, %; ja kõigi teiste käitiste puhul järgmiselt: n = L + 5/100. 3 (3) Käesoleva paragrahvi lõike 2 punktis 2 esitatud tegureid võib loa andja kohandada konkreetsele käitisele nii, et võetaks arvesse tahkete komponentide kasutamise tõhususe dokumenteeritud kasvu. Käesoleva paragrahvi lõike 2 punktis 2 esitatud tegureid võib loa andja kohandada konkreetsele käitisele nii, et võetaks arvesse tahkete komponentide kasutamise tõhususe dokumenteeritud kasvu. 4 (4) Juhul kui vähese lahustisisaldusega või lahustivabad asendajad on alles välja töötamisel, sätestab loa andja nõuete täitmise tähtaja vähendamiskavas arvestusega, et käitaja vajab nõuete rakendamiseks pikemat perioodi. Juhul kui vähese lahustisisaldusega või lahustivabad asendajad on alles välja töötamisel, sätestab loa andja nõuete täitmise tähtaja vähendamiskavas arvestusega, et käitaja vajab nõuete rakendamiseks pikemat perioodi.",
      "rdfs:label": {
        "@value": "Reg_1015229_Par_3 (redaktsioon 1015229)",
        "@language": "et"
      },
