    {
      "@id": "estleg:INVEST_Par_39_v13277294",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_39"
      },
      "estleg:versionValidFrom": {
