      "estleg:provisionRef": "INVEST § 129",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_129_v127102020006",
      "@type": [
