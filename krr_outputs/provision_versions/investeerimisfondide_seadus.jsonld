        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_238_v960625",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
