      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/960625",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 175",
