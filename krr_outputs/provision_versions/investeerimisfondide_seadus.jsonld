      }
    },
    {
      "@id": "estleg:INVEST_Par_494_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_494"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondivalitseja vara lahususe või fondi vara hoidmise või kaitsega seotud muu kohustuse teadvalt täitmata jätmise või mitteõigeaegse või ebapiisava täitmise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, −karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "INVEST_Par_494 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_494_v117032023009"
      },
      "estleg:versionValidTo": {
        "@value": "2023-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 494",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_494_v117032023009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_494"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondivalitseja vara lahususe või fondi vara hoidmise või muu fondi vara kaitsega seotud kohustuse teadvalt rikkumise, samuti teadva mitteõigeaegse või ebapiisava fondi vara kaitsega seotud kohustuse täitmise eest –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, −karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni kümme protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "INVEST_Par_494 (redaktsioon 117032023009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032023009",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 494",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_495_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_495"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatud huvide konflikti avalikustamise nõuete teadvalt rikkumise eest või tekkinud või tekkida võivate huvide konfliktide kohta registri pidamata jätmise, registrisse andmete kandmata jätmise või registrisse ebaõigete andmete kandmise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, −karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "INVEST_Par_495 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_495_v117032023009"
      },
      "estleg:versionValidTo": {
        "@value": "2023-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 495",
