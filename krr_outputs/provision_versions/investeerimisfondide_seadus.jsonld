      }
    },
    {
      "@id": "estleg:INVEST_Par_228_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_228"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisriigi fondi osakute avalik pakkumine käesoleva seaduse tähenduses on igasuguses vormis teabe edastamine pakkumise tingimuste ja pakutavate osakute kohta eesmärgiga, et omandataks osakuid. (2) Käesoleva paragrahvi lõikes 1 nimetatud pakkumist ei loeta avalikuks, kui fondi osakuid pakutakse üksnes: väärtpaberituru seaduse § 12 lõikes 2 nimetatud tingimustel või konkreetsele kliendile fondivalitseja, investeerimisühingu või krediidiasutuse poolt väärtpaberituru seaduse § 43 punktis 5 või § 44 punktis 3 nimetatud teenuse osutamisel. (3) Välisriigi fondi osakud loetakse muu hulgas Eestis avalikult pakutuiks, kui fondi reklaamitakse Eestis või kui pakkumise viisist või sisust, sealhulgas pakkumise keelest võib järeldada, et see on suunatud isikutele, kelle elu- või asukoht on Eestis.",
      "rdfs:label": {
        "@value": "INVEST_Par_228 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_228_v12880905"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 228",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_228_v12880905",
