      "estleg:provisionRef": "INVEST § 368_1",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_369_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_369"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fondivalitseja raamatupidamist ja aruandlust korraldatakse raamatupidamise seadusest, käesolevast seadusest, muudest õigusaktidest ja fondivalitseja sise-eeskirjast lähtudes.",
      "rdfs:label": {
        "@value": "INVEST_Par_369 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 369",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_37_v22375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osakuid võib välja lasta ainult avalikult. (2) Osakute väljalase ei ole ajaliselt piiratud ning nende emissioonimahtu ega väljalastavate osakute arvu kindlaks ei määrata. (3) Osakute emitendiks on fondivalitseja. (4) Osaku võib välja lasta üksnes käesoleva seaduse paragrahv 44 lõikes 1 nimetatud osaku puhasväärtuse ulatuses raha laekumisel lepingulise fondi varasse. Käesolevat lõiget ei kohaldata fondi tulu väljamaksmisel uute osakutega.",
      "rdfs:label": {
        "@value": "INVEST_Par_37 (redaktsioon 22375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22375",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_37_v193686"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22375",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 37",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
