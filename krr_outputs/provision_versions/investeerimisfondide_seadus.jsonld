      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsioon võib keelduda fondi valitsemise üleandmise loa andmisest, kui ilmnevad: käesoleva seaduse § 18 lõike 1 punktis 3, 5 või 7 nimetatud asjaolud; käesoleva seaduse § -s 116 nimetatud asjaolud; muud osakuomanike õigustatud huve kahjustavad asjaolud.",
      "rdfs:label": {
        "@value": "INVEST_Par_159 (redaktsioon 835174)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "835174",
      "estleg:supersededByVersion": {
