      }
    },
    {
      "@id": "estleg:INVEST_Par_512_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_512"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne depositooriumi ülesannete edasiandmist kontrollimata jätmise eest, kas selle isiku, kellele vara hoidmiseks, arvelduste tegemiseks või muude depositooriumi ülesannete täitmiseks depositooriumi ülesanded edasi antakse, organisatsioonilise ja tehnilise korralduse tase ning finantsseisund on küllaldased tema lepingujärgsete kohustuste täitmiseks, või nimetatud nõuete täitmise vajaliku hoolsusega kontrollimata jätmise eest sel ajal, kui isik depositooriumi kohustusi täidab, −karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "INVEST_Par_512 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_512_v117032023009"
      },
      "estleg:versionValidTo": {
        "@value": "2023-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 512",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_512_v117032023009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_512"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne depositooriumi ülesannete edasiandmist kontrollimata jätmise eest, kas selle isiku, kellele vara hoidmiseks, arvelduste tegemiseks või muude depositooriumi ülesannete täitmiseks depositooriumi ülesanded edasi antakse, organisatsioonilise ja tehnilise korralduse tase ning finantsseisund on küllaldased tema lepingujärgsete kohustuste täitmiseks, või nimetatud nõuete täitmise vajaliku hoolsusega kontrollimata jätmise eest sel ajal, kui isik depositooriumi kohustusi täidab, −karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni kümme protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "INVEST_Par_512 (redaktsioon 117032023009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032023009",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 512",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_513_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
