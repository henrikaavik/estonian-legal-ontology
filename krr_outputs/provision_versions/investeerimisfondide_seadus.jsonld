      }
    },
    {
      "@id": "estleg:INVEST_Par_149_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_149"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsioon võib keelduda loa andmisest, kui: ei ole tõendatud käesoleva seaduse § 146 lõikes 1 nimetatud asjaolude olemasolu; osakuomanike huvid ei oleks osakute tagasivõtmise peatamise korral küllaldaselt kaitstud.",
      "rdfs:label": {
        "@value": "INVEST_Par_149 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
