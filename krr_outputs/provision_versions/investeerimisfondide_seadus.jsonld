      "estleg:provisionRef": "INVEST § 65",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_65_v131122016003",
      "@type": [
        "owl:NamedIndividual",
