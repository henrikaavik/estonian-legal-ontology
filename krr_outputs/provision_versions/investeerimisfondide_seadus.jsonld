      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "INVEST_Par_52 (redaktsioon 121122010023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010023",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_52_v131122016003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122010023",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 52",
      "estleg:partOfAct": {
