  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_investeerimisfondide_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Investeerimisfondide seadus (2188 versiooni)",
        "@language": "et"
      },
      "dc:source": "Investeerimisfondide seadus"
    },
    {
      "@id": "estleg:INVEST_Par_1_v22375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisfond (edaspidi fond) on käesoleva seaduse alusel ühisteks investeeringuteks moodustatud vara kogum (edaspidi lepinguline fond) või asutatud aktsiaselts, vastavalt mida või mille vara valitseb riski hajutamise põhimõttest lähtudes käesolevas seaduses sätestatud fondivalitseja.",
      "rdfs:label": {
        "@value": "INVEST_Par_1 (redaktsioon 22375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22375",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_1_v742788"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22375",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 1",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_1_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisfond (edaspidi fond) on käesoleva seaduse alusel ühisteks investeeringuteks moodustatud vara kogum (edaspidi lepinguline fond) või asutatud aktsiaselts, mida või mille vara valitseb riski hajutamise põhimõttest lähtudes fondivalitseja.",
      "rdfs:label": {
        "@value": "INVEST_Par_1 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_1_v131122016003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 1",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_1_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib investeerimisfondide moodustamist, asutamist ja valitsemist ning nende osakute, osade, aktsiate ja teiste sarnaste osalust väljendavate õiguste pakkumist. (2) Käesolevas seaduses ette nähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduses sätestatut, arvestades käesolevast seadusest ja Finantsinspektsiooni seadusest tulenevaid erisusi.",
      "rdfs:label": {
        "@value": "INVEST_Par_1 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 1",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_10_v22375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondivalitseja aktsiakapital peab olema vähemalt 2 000 000 krooni. (2) Fondivalitseja likviidsete varade väärtus peab olema suurem tema kolme kuu tegevuskuludest. (3) Rahandusminister võib kehtestada täiendavaid nõudeid fondivalitseja oma- ja reservkapitali suurusele sõltuvalt fondivalitseja poolt valitsetavate fondide vara väärtusest. (4) Kui fondivalitseja osutab käesoleva seaduse § 3 lõikes 4 nimetatud investeerimisteenuseid, peab ta vastama väärtpaberituru seaduses neid teenuseid osutavale investeerimisühingule sätestatud usaldatavusnõuetele. (5) Fondivalitseja netovara ei või olla väiksem, kui käesoleva paragrahvi lõikes 1 sätestatud aktsiakapitali minimaalne suurus. Selle nõude rikkumisel kohaldatakse äriseadustiku ( RT I 1995, 26-28, 355; 1998, 91-93, 1500; 1999, 10, 155; 23, 355; 24, 360; 57, 596; 102, 907; 2000, 29, 172; 49, 303; 55, 365; 57, 373; 2001, 34, 185; 56, 332 ja 336; 89, 532; 93, 565; 2002, 3, 6) §-s 301 sätestatut.",
      "rdfs:label": {
        "@value": "INVEST_Par_10 (redaktsioon 22375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22375",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_10_v176926"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22375",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 10",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_10_v176926",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondivalitseja aktsiakapital peab olema vähemalt 2 000 000 krooni. (2) Fondivalitseja likviidsete varade väärtus peab olema suurem tema kolme kuu tegevuskuludest. (3) Rahandusminister võib kehtestada täiendavaid nõudeid fondivalitseja oma- ja reservkapitali suurusele sõltuvalt fondivalitseja poolt valitsetavate fondide vara väärtusest. (4) Kui fondivalitseja osutab käesoleva seaduse § 3 lõikes 4 nimetatud investeerimisteenuseid, peab ta vastama väärtpaberituru seaduses neid teenuseid osutavale investeerimisühingule sätestatud usaldatavusnõuetele. (5) Fondivalitseja netovara ei või olla väiksem, kui käesoleva paragrahvi lõikes 1 sätestatud aktsiakapitali minimaalne suurus. Selle nõude rikkumisel kohaldatakse äriseadustiku (RT I 1995, 26-28, 355; 1998, 91-93; 1500; 1999, 10, 155; 23, 355; 254, 360; 57, 596; 102, 907; 2000, 29, 172; 49, 303; 55, 365; 57, 373; 2001, 34, 185; 56, 332 ja 336; 89, 532; 93, 565; 2002, 3, 6) §-s 301 sätestatut.",
      "rdfs:label": {
        "@value": "INVEST_Par_10 (redaktsioon 176926)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "176926",
