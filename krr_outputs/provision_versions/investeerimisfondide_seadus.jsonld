    {
      "@id": "estleg:INVEST_Par_81_v960625",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_81"
      },
      "estleg:versionValidFrom": {
