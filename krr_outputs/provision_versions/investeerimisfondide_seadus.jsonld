        "@type": "xsd:date"
      },
      "estleg:versionText": "[Kehtetu]",
      "rdfs:label": {
        "@value": "INVEST_Par_141 (redaktsioon 176926)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "176926",
      "estleg:supersededByVersion": {
