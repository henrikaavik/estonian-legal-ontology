        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/835174",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 172",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_172_v12763851",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_172"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsioon võib keelduda ühinemisloa andmisest, kui: ühinemise tagajärjel rikutaks käesolevas seaduses, selle alusel antud õigusaktides või fondi tingimustes sätestatud investeerimispiiranguid; ilmnevad käesoleva seaduse §-s 116 nimetatud asjaolud; fondide ühinemine võib muul põhjusel kahjustada osakuomanike huve.",
      "rdfs:label": {
        "@value": "INVEST_Par_172 (redaktsioon 12763851)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12763851",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_172_v131122016003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12763851",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 172",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_172_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_172"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lepingulise fondi valitseja või aktsiaseltsifond avaldab viivitamata pärast likvideerimisloa andmise otsusest teadasaamist teate fondi likvideerimise kohta (edaspidi likvideerimisteade) fondivalitseja, selle konsolideerimisgrupi, millesse fondivalitseja kuulub, või aktsiaseltsifondi veebilehel. (2) Likvideerimisteates peavad sisalduma järgmised andmed: likvideeritava fondi nimetus; fondivalitseja ärinimi, registrikood ja asukoht; depositooriumi ärinimi, registrikood ja asukoht; tähtaeg, mille jooksul likvideeritava fondi võlausaldajad peavad esitama oma nõuded fondi vastu; nõuete ja avalduste vastuvõtmise kohad ning vastuvõtuajad; muud vajalikud andmed. (3) Käesoleva paragrahvi lõike 2 punktis 4 nimetatud tähtaeg ei või lepingulise fondi allfondi puhul olla lühem kui kaks kuud fondi likvideerimise teate avaldamisest arvates. (4) Käesoleva paragrahvi lõike 2 punktis 4 nimetatud nõudest õigeaegselt teatamata jätmine ei mõjuta nõuete kehtivust ega piira võlausaldaja õigust likvideerimisel olevat fondi kohtus hageda. (5) Lepingulise fondi valitseja või aktsiaseltsifond teavitab Finantsinspektsiooni likvideerimisteate avaldamisest hiljemalt likvideerimisteate ilmumisele eelneval päeval.",
      "rdfs:label": {
        "@value": "INVEST_Par_172 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 172",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_173_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fondivalitseja avalikustab fondide ühinemise ning vajaduse korral fondi valitsemise üleandmise ja fondi tingimuste muudatuste registreerimise käesoleva seaduse §-s 119 sätestatud korras.",
      "rdfs:label": {
        "@value": "INVEST_Par_173 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_173_v835174"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 173",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_173_v835174",
