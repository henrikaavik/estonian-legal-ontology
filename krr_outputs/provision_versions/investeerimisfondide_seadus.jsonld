    {
      "@id": "estleg:INVEST_Par_63_v113032019065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_63"
      },
      "estleg:versionValidFrom": {
