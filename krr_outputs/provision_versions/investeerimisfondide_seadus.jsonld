      }
    },
    {
      "@id": "estleg:INVEST_Par_84_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lepingulise fondi raamatupidamist korraldab fondivalitseja juhatus. (2) Lepingulise fondi raamatupidamist tuleb pidada lahus fondivalitseja ja fondivalitseja teiste fondide raamatupidamisest. (3) Lepingulise fondi raamatupidamisele ja aruandlusele ei kohaldata raamatupidamise seaduse §-s 14, § 15 lõikes 2, § 18 lõikes 3 ning §-des 25 ja 26 sätestatut. (4) Lepingulise fondi majandusaastaks on kalendriaasta.",
      "rdfs:label": {
        "@value": "INVEST_Par_84 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 84",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_85_v22375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Oma kohustuste rikkumise korral vastutab depoopank sellega fondile, osakuomanikele või fondivalitsejale tekitatud kahju eest.",
      "rdfs:label": {
        "@value": "INVEST_Par_85 (redaktsioon 22375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22375",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_85_v742788"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22375",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 85",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_85_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondivalitseja aktsiakapital peab olema vähemalt 125 000 eurot. (2) Fondivalitseja aktsiakapital peab olema vähemalt: 730 000 eurot – juhul, kui ta valitseb vabatahtlikku pensionifondi; 3 000 000 eurot – juhul, kui ta valitseb kohustuslikku pensionifondi. (3) Kohustusliku pensionifondi valitsemise õigust omava fondivalitseja aktsiakapitali suurendamisele ja vähendamisele kohaldatakse kindlustustegevuse seaduse (RT I 2000, 53, 343; 2001, 43, 238; 48, 268; 59, 359; 87, 529; 93, 565; 2002, 35, 215; 63, 387; 102, 600; 105, 612; 2003, 17, 95; 2004, 14, 90) §-s 30 ja § 31 lõigetes 1 ja 2 kindlustusandja aktsiakapitali kohta sätestatut.",
      "rdfs:label": {
        "@value": "INVEST_Par_85 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_85_v835174"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
