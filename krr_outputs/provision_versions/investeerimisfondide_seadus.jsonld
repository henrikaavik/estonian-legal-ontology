    {
      "@id": "estleg:INVEST_Par_242_v108072011035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_242"
