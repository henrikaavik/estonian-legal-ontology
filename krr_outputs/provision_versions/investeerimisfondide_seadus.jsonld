        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses eurodes väljendatud summad arvestatakse ümber Eesti kroonidesse Eesti Panga vahetuskursi alusel.",
      "rdfs:label": {
        "@value": "INVEST_Par_335 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
