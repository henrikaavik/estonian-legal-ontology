        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses sätestatud väärtegude kohtuväline menetleja on Finantsinspektsioon.",
      "rdfs:label": {
        "@value": "INVEST_Par_514 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
