      }
    },
    {
      "@id": "estleg:INVEST_Par_25_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestis asutatud ning Finantsinspektsiooni väljastatud tegevusluba omav fondivalitseja võib osutada välisriigis teenuseid, asutades selleks filiaali või osutades piiriüleseid teenuseid. (2) Teenuste osutamisel välisriigis peab fondivalitseja järgima käesolevas seaduses ning selle alusel antud õigusaktides ning välisriigi õigusaktides sätestatud nõudeid. (3) Piiriülene teenus on fondivalitseja teenus, mida ta osutab riigis, kus fondivalitseja ega tema filiaal ei ole registreeritud. (4) Teises lepinguriigis Eesti fondivalitseja poolt teenuste osutamisele kohaldatakse käesoleva seaduse §-des 30–33 sätestatut. (5) Käesoleva paragrahvi lõikes 4 nimetamata välisriigis (edaspidi kolmandas riigis) teenuste osutamisele kohaldatakse käesoleva seaduse §-des 26–29 ning § 33 lõigetes 1 ja 4 sätestatut.",
      "rdfs:label": {
        "@value": "INVEST_Par_25 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_25_v835174"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 25",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_25_v835174",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestis asutatud ning Finantsinspektsiooni väljastatud tegevusluba omav fondivalitseja võib osutada välisriigis teenuseid, asutades selleks filiaali või osutades piiriüleseid teenuseid. (2) Teenuste osutamisel välisriigis peab fondivalitseja järgima käesolevas seaduses ning selle alusel antud õigusaktides ning välisriigi õigusaktides sätestatud nõudeid. (3) Piiriülene teenus on fondivalitseja teenus, mida ta osutab riigis, kus fondivalitseja ega tema filiaal ei ole registreeritud. (4) Teises lepinguriigis teenuse osutamisele kohaldatakse eurofondi valitseva Eesti fondivalitseja puhul käesoleva seaduse § -des 30–33 sätestatut ning eurofondi mitte valitseva Eesti fondivalitseja puhul vastavalt käesoleva seaduse § 30 lõigetes 1, 7 ja 8; § -s 32 ning § 33 lõigetes 1 ja 7–9 sätestatut. (5) Käesoleva paragrahvi lõikes 4 nimetamata välisriigis (edaspidi kolmandas riigis) teenuste osutamisele kohaldatakse käesoleva seaduse § -des 26–29 ning § 33 lõigetes 1 ja 7–9 sätestatut.",
      "rdfs:label": {
        "@value": "INVEST_Par_25 (redaktsioon 835174)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "835174",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_25_v12763851"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/835174",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 25",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_25_v12763851",
      "@type": [
        "owl:NamedIndividual",
