      }
    },
    {
      "@id": "estleg:INVEST_Par_331_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_331"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui fondivalitseja valitseb ja pakub käesoleva seaduse väliselt asutatud mitteavalikku alternatiivfondi, peab fondi valitsemine ja pakkumine vastama käesoleva seaduse §-des 267–271 sätestatule. Kui fondivalitseja pakub alternatiivfondi avalikult ja avalikuks pakkumiseks on koostatud prospekt vastavalt väärtpaberituru seadusele, tuleb alternatiivfondi kohta avalikustada käesoleva seaduse §-des 74, 75 ja 80–82 nimetatud nõuetele vastav teave, mida ei ole alternatiivfondi kohta väärtpaberituru seaduse kohaselt avalikustatud, ning koostada ja esitada aruanded vastavalt käesoleva seaduse §-dele 86–92. Alternatiivfondi valitseja valitsetaval igal alternatiivfondil peab kooskõlas käesoleva seaduse §-s 285 sätestatuga olema depositoorium.",
      "rdfs:label": {
        "@value": "INVEST_Par_331 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 331",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_332_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_332"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse jõustumisel välisriigis teenuseid osutav fondivalitseja peab käesolevas seaduses sätestatud korras teatama tema poolt välisriigis teenuste osutamisest või taotlema loa välisriigis filiaali asutamiseks käesoleva seaduse §-des 25–33 sätestatud korras ning viima oma tegevuse käesolevas seaduses sätestatud nõuetega vastavusse kuue kuu jooksul, arvates selle seaduse jõustumisest. (2) Fondivalitseja, kes käesoleva seaduse jõustumisel osutab teenuseid välisriigis, võib kuni käesoleva paragrahvi lõikes 1 sätestatud kohustuste täitmiseni jätkata teenuste osutamist välisriigis, kuid mitte kauem kui kuus kuud, arvates käesoleva seaduse jõustumisest.",
      "rdfs:label": {
        "@value": "INVEST_Par_332 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_332_v835174"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 332",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_332_v835174",
