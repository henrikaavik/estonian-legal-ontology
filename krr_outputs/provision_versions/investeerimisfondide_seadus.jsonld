      }
    },
    {
      "@id": "estleg:INVEST_Par_173_v12763851",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fondivalitseja avalikustab fondide ühinemise ning vajaduse korral fondi valitsemise üleandmise ja fondi tingimuste muudatuste registreerimise käesoleva seaduse §-s 119 sätestatud korras.",
      "rdfs:label": {
        "@value": "INVEST_Par_173 (redaktsioon 12763851)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12763851",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_173_v131122016003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12763851",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 173",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_173_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Likvideerimisteate avaldamisele järgnevast päevast alates peatatakse likvideeritava fondi osakute või aktsiate väljalaskmine ja tagasivõtmine ning samast päevast alates võib osakuomanikele või aktsionäridele väljamakseid teha vaid käesolevas peatükis või aktsiaseltsifondi korral äriseadustikus vara jaotamise kohta sätestatud korras.",
      "rdfs:label": {
        "@value": "INVEST_Par_173 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 173",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_174_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_174"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondi likvideerimise otsustab fondivalitseja nõukogu või käesoleva seaduse § 183 lõikes 1 sätestatud juhul depositoorium. (2) Kinnise fondi, mille osakuid võetakse tagasi mitte varem kui ühe aasta möödumisel osakuomanike vastava nõude esitamisest, likvideerimise võib otsustada ainult osakuomanike üldkoosolek. (3) Pensionifondi likvideerimise võib otsustada üksnes juhul, kui pensionifondi valitsemise üleandmine käesoleva seaduse §-des 155–160 sätestatud korras ei ole olnud võimalik. (4) Fondi likvideerib fondivalitseja või käesoleva seaduse §-s 183 sätestatud juhul depositoorium või §-s 184 sätestatud juhul Finantsinspektsiooni määratud likvideerijad.",
      "rdfs:label": {
        "@value": "INVEST_Par_174 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_174_v835174"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 174",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_174_v835174",
