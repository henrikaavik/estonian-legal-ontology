    {
      "@id": "estleg:INVEST_Par_312_v121122010023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_312"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fondivalitseja poolt käesolevas seaduses sätestatud kohustuste täitmata jätmise, sealhulgas investeerimisteenuste osutamisel fondivalitseja kohustuste täitmata jätmise eest, fondi vara ja fondivalitseja vara lahus hoidmise kohustuse täitmata jätmise eest, fondivalitseja ülesannete aluseta edasiandmise eest kolmandale isikule, fondi vara või fondi aktsia või osaku puhasväärtuse valesti arvutamise või vale puhasväärtuse avalikustamise eest ning muu käesolevast seadusest, kogumispensionide seadusest või nende alusel antud õigusaktist tuleneva kohustuse täitmata jätmise eest –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "INVEST_Par_312 (redaktsioon 121122010023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010023",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_312_v131122016003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122010023",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 312",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_312_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_312"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsioon võib ettekirjutusega nõuda fondivalitsejalt juhi tagasikutsumist, kui: juht ei vasta käesolevas seaduses sätestatud nõuetele; juht on rikkunud käesoleva seaduse või muude tema ametialase tegevusega seotud õigusaktide nõudeid; isiku valimise või määramisega seoses on esitatud eksitavaid või tegelikkusele mittevastavaid andmeid, jäetud oluline informatsioon esitamata või on võltsitud dokumente või juhi tegevus fondivalitseja juhtimisel on näidanud, et ta ei ole suuteline korraldama fondivalitseja juhtimist selliselt, et fondi, fondi investorite, investeerimisteenuse või investeerimiskõrvalteenuse klientide või võlausaldajate huvid oleksid piisavalt kaitstud.",
      "rdfs:label": {
        "@value": "INVEST_Par_312 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_312_v130122017028"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-02",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 312",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_312_v130122017028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_312"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsioon võib ettekirjutusega nõuda fondivalitsejalt juhi tagasikutsumist, kui: juht ei vasta käesolevas seaduses sätestatud nõuetele; juht on rikkunud käesoleva seaduse või muude tema ametialase tegevusega seotud õigusaktide nõudeid; isiku valimise või määramisega seoses on esitatud eksitavaid või tegelikkusele mittevastavaid andmeid, jäetud oluline informatsioon esitamata või on võltsitud dokumente või juhi tegevus fondivalitseja juhtimisel on näidanud, et ta ei ole suuteline korraldama fondivalitseja juhtimist selliselt, et fondi, fondi investorite, investeerimisteenuse või kõrvalteenuse klientide või võlausaldajate huvid oleksid piisavalt kaitstud.",
      "rdfs:label": {
        "@value": "INVEST_Par_312 (redaktsioon 130122017028)",
        "@language": "et"
      },
