      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22375",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 11",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_11_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondivalitseja asukoht ja tegevuskoht peab olema Eestis. (2) Aktsiaseltsina asutatud fondi fondivalitseja asukoht võib olla ka välisriigis tingimusel, et tema filiaal on kantud Eesti äriregistrisse.",
      "rdfs:label": {
        "@value": "INVEST_Par_11 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_11_v12763851"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
