      }
    },
    {
      "@id": "estleg:INVEST_Par_20_v233073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiaseltsile väljastatakse fondivalitseja tegevusluba, kui see vastab kõigile järgmistele tingimustele: aktsiaselts vastab käesolevas seaduses ja sellest tulenevates õigusaktides fondivalitsejale kehtestatud nõuetele; aktsiaseltsi esitatud dokumendid vastavad seaduses ja sellest tulenevates õigusaktides sätestatud nõuetele; asutamisel oleva aktsiaseltsi aktsiakapital on täielikult sisse makstud; aktsiaseltsi juhtimisorganite liikmed, fondijuht, audiitor, prokurist ja aktsionärid vastavad seaduses ja sellest tulenevates õigusaktides sätestatud nõuetele; aktsiaseltsil on fondivalitsejana tegutsemiseks vajalikud tööruumid ja -tingimused, mis vastavad rahandusministri kehtestatud nõuetele; aktsiaselts on kehtestanud sise-eeskirjad, kus on kindlaks määratud sisemised protseduurireeglid rahvusvahelise sanktsiooni seaduse alusel kehtestatud rahvusvaheliste sanktsioonide rakendamiseks; aktsiaseltsile antud fondivalitseja tegevusluba ei ole varem tühistatud või seda ei ole jäetud pikendamata käesoleva seaduse § 25 lõikes 1 nimetatud põhjustel.",
      "rdfs:label": {
        "@value": "INVEST_Par_20 (redaktsioon 233073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "233073",
