      }
    },
    {
      "@id": "estleg:INVEST_Par_210_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_210"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondi ei või ümber kujundada teist liiki äriühinguks. (2) Fondi jagunemine ei ole lubatud. 211. Fondide ühinemine (1) Fondide ühinemine toimub vastavalt äriseadustiku 31. peatükis sätestatule, kui käesolevast jaost ei tulene teisiti. (2) Fond võib ühineda teise fondiga. (3) Fondide ühinemisest teavitavad ühinevad fondid Finantsinspektsiooni viivitamata pärast äriseadustiku § 399 lõikes 2 nimetatud teate teistkordset avaldamist.",
      "rdfs:label": {
        "@value": "INVEST_Par_210 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_210_v12894039"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 210",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_210_v12894039",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_210"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondi ei või ümber kujundada teist liiki äriühinguks. (2) Fondi jagunemine ei ole lubatud. 211. Fondide ühinemine (1) Fondide ühinemine toimub vastavalt äriseadustiku 31. peatükis sätestatule, kui käesolevast jaost ei tulene teisiti. (2) Eesti äriregistrisse kantud fond võib ühineda üksnes lepinguriigi õiguse alusel asutatud fondiga. (3) Kehtetu –",
      "rdfs:label": {
        "@value": "INVEST_Par_210 (redaktsioon 12894039)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894039",
      "estleg:supersededByVersion": {
