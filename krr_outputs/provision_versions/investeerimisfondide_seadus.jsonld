    {
      "@id": "estleg:INVEST_Par_303_v121122010023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_303"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisriigi fondi osakute avaliku pakkumise eest ilma pakkumist registreerimata, pakkumisest teavitamata või prospekte avalikustamata –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "INVEST_Par_303 (redaktsioon 121122010023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010023",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_303_v131122016003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122010023",
