      }
    },
    {
      "@id": "estleg:INVEST_Par_31_v193686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_31"
      },
      "estleg:versionValidFrom": {
