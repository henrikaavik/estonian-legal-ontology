    {
      "@id": "estleg:INVEST_Par_27_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktsiaseltsifondi asutamislepingu sõlmimisega kiidavad asutajad heaks ka valitsemislepingu ja depoolepingu. (2) Enne aktsiaseltsifondi registreerimist äriregistris kooskõlastatakse aktsiaseltsifondi põhikiri Finantsinspektsiooniga.",
      "rdfs:label": {
        "@value": "INVEST_Par_27 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 27",
      "estleg:partOfAct": {
