        "@value": "2019-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võtmefunktsioonide täitmisega seotud ülesannete edasiandmisest kolmandale isikule peab tööandja pensionifondi valitseja enne ülesannete edasiandmise lepingu jõustumist teavitama Finantsinspektsiooni.",
      "rdfs:label": {
        "@value": "INVEST_Par_368_1 (redaktsioon 128122018005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122018005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122018005",
