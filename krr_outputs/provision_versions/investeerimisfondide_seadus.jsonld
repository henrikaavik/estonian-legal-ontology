      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alates 2002. aasta 1. septembrist peavad käesoleva seaduse § 3 lõikes 4 nimetatud investeerimisteenuseid osutavad fondivalitsejad vastama käesoleva seaduse § 10 lõikes 4 sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "INVEST_Par_148 (redaktsioon 22375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22375",
