      }
    },
    {
      "@id": "estleg:INVEST_Par_270_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_270"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Krediidiasutuste hoiustesse investeeritud kohustusliku pensionifondi vara ei või moodustada kokku rohkem kui 35% pensionifondi aktivate turuväärtusest. (2) Pensionifondi vara ei või hoiustada ühes krediidiasutuses või samasse kontserni kuuluvates krediidiasutustes kokku rohkem kui 5% ulatuses pensionifondi aktivate turuväärtusest.",
      "rdfs:label": {
        "@value": "INVEST_Par_270 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_270_v835174"
      },
      "estleg:versionValidTo": {
