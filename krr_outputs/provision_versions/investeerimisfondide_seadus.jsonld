      }
    },
    {
      "@id": "estleg:INVEST_Par_2_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Investeerimisfond (edaspidi fond) on juriidiline isik või varakogum, millesse kaasatakse mitme investori kapital eesmärgiga seda vastavalt kindlaksmääratud investeerimispoliitikale kõnealuste investorite kasuks ja ühistes huvides investeerida. (2) Käesoleva seaduse alusel saab fondi moodustada lepingulisena (edaspidi lepinguline fond) või asutada aktsiaseltsina (edaspidi aktsiaseltsifond), usaldusühinguna (edaspidi usaldusfond) või määratud väljamaksetega tööandja pensionifondina. (3) Fondil peab olema fondivalitseja, kui käesolevast seadusest ei tulene teisiti. Fondil võib korraga olla ainult üks fondivalitseja.",
      "rdfs:label": {
        "@value": "INVEST_Par_2 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 2",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_20_v22375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiaseltsile väljastatakse fondivalitseja tegevusluba, kui see vastab kõigile järgmistele tingimustele: aktsiaselts vastab käesolevas seaduses ja sellest tulenevates õigusaktides fondivalitsejale kehtestatud nõuetele; aktsiaseltsi esitatud dokumendid vastavad seaduses ja sellest tulenevates õigusaktides sätestatud nõuetele; asutamisel oleva aktsiaseltsi aktsiakapital on täielikult sisse makstud; aktsiaseltsi juhtimisorganite liikmed, fondijuht, audiitor, prokurist ja aktsionärid vastavad seaduses ja sellest tulenevates õigusaktides sätestatud nõuetele; aktsiaseltsil on fondivalitsejana tegutsemiseks vajalikud tööruumid ja -tingimused, mis vastavad rahandusministri kehtestatud nõuetele; aktsiaseltsile antud fondivalitseja tegevusluba ei ole varem tühistatud või seda ei ole jäetud pikendamata käesoleva seaduse paragrahv 25 lõikes 1 nimetatud põhjustel.",
      "rdfs:label": {
        "@value": "INVEST_Par_20 (redaktsioon 22375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22375",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_20_v193686"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22375",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 20",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_20_v193686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiaseltsile väljastatakse fondivalitseja tegevusluba, kui see vastab kõigile järgmistele tingimustele: aktsiaselts vastab käesolevas seaduses ja sellest tulenevates õigusaktides fondivalitsejale kehtestatud nõuetele; aktsiaseltsi esitatud dokumendid vastavad seaduses ja sellest tulenevates õigusaktides sätestatud nõuetele; asutamisel oleva aktsiaseltsi aktsiakapital on täielikult sisse makstud; aktsiaseltsi juhtimisorganite liikmed, fondijuht, audiitor, prokurist ja aktsionärid vastavad seaduses ja sellest tulenevates õigusaktides sätestatud nõuetele; aktsiaseltsil on fondivalitsejana tegutsemiseks vajalikud tööruumid ja -tingimused, mis vastavad rahandusministri kehtestatud nõuetele; aktsiaseltsile antud fondivalitseja tegevusluba ei ole varem tühistatud või seda ei ole jäetud pikendamata käesoleva seaduse § 25 lõikes 1 nimetatud põhjustel.",
      "rdfs:label": {
        "@value": "INVEST_Par_20 (redaktsioon 193686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193686",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_20_v233073"
      },
      "estleg:versionValidTo": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/193686",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 20",
