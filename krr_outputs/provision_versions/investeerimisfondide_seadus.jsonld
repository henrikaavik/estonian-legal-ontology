      },
      "estleg:versionText": "Fondivalitseja avalikustab fondi ja aktsiaseltsi ühinemise loa andmise otsuse käesoleva seaduse §-s 208 sätestatud korras.",
      "rdfs:label": {
        "@value": "INVEST_Par_215 (redaktsioon 12763851)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12763851",
