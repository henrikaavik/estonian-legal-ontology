      }
    },
    {
      "@id": "estleg:INVEST_Par_4_v22375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Depoopangaks võib olla krediidiasutuste seaduse alusel tegutsev krediidiasutus, kellel on Eesti Panga või Finantsinspektsiooni poolt väljastatud tegevuslitsentsi kohaselt õigus teha depootehinguid. (2) Depoopank säilitab fondi vara, teostab sellega arveldusi, peab selle kohta arvestust ja täidab muid ülesandeid vastavalt käesolevale seadusele ja depoolepingule.",
      "rdfs:label": {
        "@value": "INVEST_Par_4 (redaktsioon 22375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22375",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_4_v742788"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22375",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 4",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_4_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eurofond on Euroopa Majanduspiirkonna lepinguriigis (edaspidi lepingu riik) tunnustatud fond, mis vastab Euroopa Liidu Nõukogu direktiivis 85/611/EMÜ siirdväärtpaberitesse ühiseks investeeringuks loodud ettevõtjaid käsitlevate seaduste, määruste ja haldusnormide kooskõlastamise kohta (EÜT L 375, 31.12.1985, lk 3–18) (edaspidi investeerimisfondide direktiiv) sätestatud nõuetele ja mille osakuid või aktsiaid võidakse avalikkusele pakkuda kõikides lepinguriikides. (2) Eestis asutatud eurofond on avalik avatud lepinguline fond, mis vastab investeerimisfondide direktiivis ja käesolevas seaduses eurofondi kohta sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "INVEST_Par_4 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_4_v835174"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 4",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_4_v835174",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eurofond on Euroopa Majanduspiirkonna lepinguriigis (edaspidi lepinguriik) tunnustatud fond, mis vastab Euroopa Liidu Nõukogu direktiivis 85/611/EMÜ siirdväärtpaberitesse ühiseks investeeringuks loodud ettevõtjaid käsitlevate seaduste, määruste ja haldusnormide kooskõlastamise kohta (EÜT L 375, 31.12.1985, lk 3–18) (edaspidi investeerimisfondide direktiiv) sätestatud nõuetele ja mille osakuid või aktsiaid võidakse avalikkusele pakkuda kõikides lepinguriikides. (2) Eestis asutatud eurofond on avalik avatud lepinguline fond, mis vastab investeerimisfondide direktiivis ja käesolevas seaduses eurofondi kohta sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "INVEST_Par_4 (redaktsioon 835174)",
        "@language": "et"
      },
