      "estleg:provisionRef": "INVEST § 295",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_295_v960625",
      "@type": [
        "owl:NamedIndividual",
