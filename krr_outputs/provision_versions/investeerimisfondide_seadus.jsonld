      }
    },
    {
      "@id": "estleg:INVEST_Par_127_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_127"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tuletisinstrumentide kogu avatud neto riskipositsioon ei või ületada kümmet protsenti pensionifondi vara väärtusest, välja arvatud valuuta-, intressi-, turu- või muude pensionifondi varaga seotud riskide maandamiseks tehtud tehingud. (2) Kogu välisvaluuta avatud netopositsioon ei või moodustada rohkem kui 25 protsenti konservatiivse pensionifondi varast ja rohkem kui 50 protsenti teist liiki kohustusliku pensionifondi varast. Välisvaluuta avatud netopositsiooni arvutamisel ei pea teise fondi aktsiatesse või osakutesse tehtud investeeringu puhul võtma arvesse selle fondi tehtud investeeringutest tulenevaid välisvaluutapositsioone.",
      "rdfs:label": {
        "@value": "INVEST_Par_127 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_127_v128122018004"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 127",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_127_v128122018004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_127"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tuletisinstrumentide kogu avatud riskipositsioon ei või ületada 50 protsenti pensionifondi vara väärtusest, välja arvatud valuuta-, intressi-, turu- või muude pensionifondi varaga seotud riskide maandamiseks tehtud tehingud. (2) Kogu välisvaluuta avatud netopositsioon ei või moodustada rohkem kui 25 protsenti konservatiivse pensionifondi varast. Välisvaluuta avatud netopositsiooni arvutamisel ei pea teise fondi aktsiatesse või osakutesse tehtud investeeringu puhul võtma arvesse selle fondi tehtud investeeringutest tulenevaid välisvaluutapositsioone.",
      "rdfs:label": {
        "@value": "INVEST_Par_127 (redaktsioon 128122018004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122018004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122018004",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 127",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_128_v22375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_128"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaise fondi aktsiate või osakute avalik müük registreeritakse, kui on täidetud kõik käesolevas peatükis sätestatud ja kõik järgnevalt loetletud tingimused: fondi asukoht on Euroopa Liidu liikmesriigis ja fond vastab Euroopa Liidus kehtestatud nõuetele või fondi asukoht on mõnes teises rahandusministri kinnitatud nimekirja arvatud riigis ja fondile kohaldatav regulatsioon vastab rahandusministri kehtestatud nõuetele; fondi ja, kui seda valitseb fondivalitseja, siis ka fondivalitsejat, on tunnustanud fondi asukohamaa pädev järelevalveorgan; on sõlmitud käesoleva seaduse paragrahv 127 lõike 1 punktis 6 nimetatud leping; fondi osakute või aktsiate väljaandmisel on tagatud osakute või aktsiate laekumine nende ostja arvele viivitamata vastavas koguses pärast ostuhinna tasumist; fondi aktsiate tagasiostmise või osakute tagasivõtmise ja fondi arvelt väljamaksete teostamise korral on tagatud summade viivitamatu laekumine fondi aktsionäridele või osakuomanikele; on tagatud fondi kohta käiva käesolevas seaduses nõutud informatsiooni kättesaadavus.",
      "rdfs:label": {
        "@value": "INVEST_Par_128 (redaktsioon 22375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22375",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_128_v193686"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22375",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 128",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_128_v193686",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_128"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaise fondi aktsiate või osakute avalik müük registreeritakse, kui on täidetud kõik käesolevas peatükis sätestatud ja kõik järgnevalt loetletud tingimused: fondi asukoht on Euroopa Liidu liikmesriigis ja fond vastab Euroopa Liidus kehtestatud nõuetele või fondi asukoht on mõnes teises rahandusministri kinnitatud nimekirja arvatud riigis ja fondile kohaldatav regulatsioon vastab rahandusministri kehtestatud nõuetele; fondi ja, kui seda valitseb fondivalitseja, siis ka fondivalitsejat, on tunnustanud fondi asukohamaa pädev järelevalveorgan; on sõlmitud käesoleva seaduse § 127 lõike 1 punktis 6 nimetatud leping; fondi osakute või aktsiate väljaandmisel on tagatud osakute või aktsiate laekumine nende ostja arvele viivitamata vastavas koguses pärast ostuhinna tasumist; fondi aktsiate tagasiostmise või osakute tagasivõtmise ja fondi arvelt väljamaksete teostamise korral on tagatud summade viivitamatu laekumine fondi aktsionäridele või osakuomanikele; on tagatud fondi kohta käiva käesolevas seaduses nõutud informatsiooni kättesaadavus.",
      "rdfs:label": {
        "@value": "INVEST_Par_128 (redaktsioon 193686)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193686",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_128_v742788"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/193686",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 128",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_128_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_128"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osakuomanike üldkoosoleku kutsub kokku fondivalitseja. (2) Osakuomanike üldkoosoleku kokkukutsumist ja küsimuste üldkoosoleku päevakorda võtmist võivad nõuda ka Finantsinspektsioon või osakuomanikud, kelle osakutega on esindatud vähemalt 1/10 häältest. Kui fondivalitseja ei kutsu üldkoosolekut kokku ühe kuu jooksul, arvates Finantsinspektsiooni või osakuomanike nõude saamisest, on Finantsinspektsioonil või osakuomanikel õigus üldkoosolek ise kokku kutsuda.",
      "rdfs:label": {
        "@value": "INVEST_Par_128 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_128_v960625"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 128",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_128_v960625",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
