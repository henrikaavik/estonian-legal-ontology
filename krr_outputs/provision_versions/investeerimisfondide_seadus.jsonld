      }
    },
    {
      "@id": "estleg:INVEST_Par_122_v131122016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pensionifondi vara võib ühe krediidiasutuse või samasse konsolideerimisgruppi kuuluvate krediidiasutuste hoiustesse paigutada kokku kuni kümme protsenti pensionifondi vara väärtusest.",
      "rdfs:label": {
        "@value": "INVEST_Par_122 (redaktsioon 131122016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016003",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_122_v128122018004"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122016003",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 122",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_122_v128122018004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "INVEST_Par_122 (redaktsioon 128122018004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122018004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122018004",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 122",
      "estleg:partOfAct": {
