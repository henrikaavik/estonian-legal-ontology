        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/193686",
      "estleg:sourceAct": "Investeerimisfondide seadus",
      "estleg:provisionRef": "INVEST § 65",
      "estleg:partOfAct": {
        "@id": "estleg:INVEST_Map_2026"
      }
    },
    {
      "@id": "estleg:INVEST_Par_65_v742788",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:INVEST_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsioon võib keelduda ühinemisloa andmisest, kui: ühendava fondivalitseja juhid ei vasta seaduses ja selle alusel antud õigusaktides sätestatud nõuetele; ühinemise tagajärjel rikutaks käesolevas seaduses või muudes õigusaktides sätestatud investeerimispiiranguid; ühendava fondivalitseja finantsseisund ei vasta käesolevas seaduses sätestatud nõuetele; ühinemisleping ei vasta käesolevas seaduses või muudes õigusaktides sätestatud nõuetele; ühendava fondivalitseja ja teise isiku vaheline märkimisväärne seos takistab fondivalitseja üle vajalikul tasemel järelevalve teostamist: ühinemine võib muul põhjusel kahjustada fondi, fondi aktsionäride või osakuomanike huve.",
      "rdfs:label": {
        "@value": "INVEST_Par_65 (redaktsioon 742788)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742788",
      "estleg:supersededByVersion": {
        "@id": "estleg:INVEST_Par_65_v131122016003"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/742788",
