      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis fondi kohta sätestatu kohaldub ka lepingulise fondi allfondile.",
      "rdfs:label": {
        "@value": "INVEST_Par_53 (redaktsioon 131122016003)",
        "@language": "et"
      },
