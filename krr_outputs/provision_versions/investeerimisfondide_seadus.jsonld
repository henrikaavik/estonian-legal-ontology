      },
      "estleg:versionText": "(1) Fondivalitseja aktsiad on vabalt võõrandatavad. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "INVEST_Par_43 (redaktsioon 121122010023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010023",
