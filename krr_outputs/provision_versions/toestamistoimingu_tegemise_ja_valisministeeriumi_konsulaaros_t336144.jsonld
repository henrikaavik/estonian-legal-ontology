      "estleg:sourceAct": "Tõestamistoimingu tegemise ja Välisministeeriumi konsulaarosakonnaga kooskõlastamise kord",
      "estleg:provisionRef": "Reg_336144 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336144_Map"
      }
    },
    {
      "@id": "estleg:Reg_336144_Par_5_v336144",
