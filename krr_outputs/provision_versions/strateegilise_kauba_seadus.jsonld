    {
      "@id": "estleg:STRATE_Par_32_v13250811",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:STRATE_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Komisjon teeb otsuse lõppkasutuse järelevalve dokumendi väljastamise või selle väljastamisest keeldumise kohta. (2) Lõppkasutuse järelevalve dokumentide vormid, tehnilise kirjelduse ja dokumentidele kantavate andmete loetelu",
      "rdfs:label": {
        "@value": "STRATE_Par_32 (redaktsioon 13250811)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13250811",
