      }
    },
    {
      "@id": "estleg:STRATE_Par_53_v122122011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:STRATE_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjalise kauba vahendaja registreerimisel teavitatakse sellest taotlejat kirjalikult. Registreeritava isiku andmed kantakse andmekogusse viie tööpäeva jooksul komisjoni vastava otsuse tegemisest arvates. (2) Sõjalise kauba vahendaja registreerimise otsusega võib komisjon määrata piirangu vahendatavate kaupade nimekirja ja sihtriikide kohta.",
      "rdfs:label": {
        "@value": "STRATE_Par_53 (redaktsioon 122122011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122011002"
    },
