    {
      "@id": "estleg:STRATE_Par_51_v13324132",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:STRATE_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 21, 28 ja 36 sätestatud dokumentide säilitamise tähtaja eiramise eest –karistatakse rahatrahviga kuni 100 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 640 eurot.",
      "rdfs:label": {
        "@value": "STRATE_Par_51 (redaktsioon 13324132)",
        "@language": "et"
