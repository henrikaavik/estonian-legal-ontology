      },
      "estleg:versionText": "(1) Komisjon teeb otsuse lõppkasutuse järelevalve dokumendi väljastamise või selle väljastamisest keeldumise kohta.",
      "rdfs:label": {
        "@value": "STRATE_Par_32 (redaktsioon 780253)",
        "@language": "et"
      },
