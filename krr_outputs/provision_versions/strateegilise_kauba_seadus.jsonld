      }
    },
    {
      "@id": "estleg:STRATE_Par_12_v122122011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:STRATE_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Komisjon võib otsustada kaitseotstarbelise toote Euroopa Liidu siseseks veoks väljastada koondlitsentsi asemel lihtlitsentsi, kui: taotlus piirdub üheainsa veoga, kuigi vedu võib toimuda ühe või mitme saadetisena; vedu on vajalik liikmesriigi oluliste julgeolekuhuvide kaitse või avaliku korra seisukohalt; vedu on vajalik liikmesriikide rahvusvaheliste ülesannete ja kohustuste täitmiseks või komisjonil on alust arvata, et tarnija ei ole võimeline täitma kõiki koondlitsentsi saamise tingimusi.",
      "rdfs:label": {
        "@value": "STRATE_Par_12 (redaktsioon 122122011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122011002"
    },
    {
      "@id": "estleg:STRATE_Par_13_v692155",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:STRATE_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-02-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sisseveolitsentsi, väljaveolitsentsi ja transiidiloa (edaspidi litsents ) saamiseks esitatakse komisjonile vormikohane taotlus ja nõuetekohased dokumendid. Taotlusele kirjutab alla füüsilisest isikust taotleja isiklikult või juriidilisest isikust taotleja seaduslik esindaja. (2) Litsentsi taotluse vormi kehtestab välisminister määrusega. (3) Litsentsi taotlemise, väljastamise, pikendamise, muutmise, kehtivuse peatamise ja kehtetuks tunnistamise tähtajad ja korra ning litsentsi taotlemisel esitatavate dokumentide ja andmete loetelu kehtestab Vabariigi Valitsus määrusega.",
      "rdfs:label": {
        "@value": "STRATE_Par_13 (redaktsioon 692155)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "692155",
