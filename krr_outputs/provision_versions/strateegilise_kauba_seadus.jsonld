      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seni kehtinud õigusaktide alusel väljastatud litsentsid ning lõppkasutuse järelevalve dokumendid kehtivad kuni nende kehtivusaja lõpuni või kehtetuks tunnistamiseni. Nende kehtetuks tunnistamisele ja tagastamisele kohaldatakse dokumentide väljastamise ajal kehtinud sätteid.",
      "rdfs:label": {
        "@value": "STRATE_Par_53 (redaktsioon 1028645)",
        "@language": "et"
      },
