      "estleg:provisionRef": "Reg_305939 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305939_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_305939_Par_12_v305939",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305939_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Kaitseala piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Alatskivi piiranguvöönd. Kaitsealal on Alatskivi piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_305939_Par_12 (redaktsioon 305939)",
        "@language": "et"
      },
