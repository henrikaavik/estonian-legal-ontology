    {
      "@id": "estleg:Reg_305939_Par_10_v305939",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305939_Par_10"
