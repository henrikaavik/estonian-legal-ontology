      }
    },
    {
      "@id": "estleg:Reg_305939_Par_13_v305939",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305939_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on Alatskivi pargi ja ürgoru, Kuningvere järve, Mustjärve ja neid ümbritseva traditsioonilise pärandkultuurmaastiku ilme säilitamine ning kaitsealuste liikide elupaikade kaitse. Piiranguvööndi kaitse-eesmärk on Alatskivi pargi ja ürgoru, Kuningvere järve, Mustjärve ja neid ümbritseva traditsioonilise pärandkultuurmaastiku ilme säilitamine ning kaitsealuste liikide elupaikade kaitse.",
      "rdfs:label": {
        "@value": "Reg_305939_Par_13 (redaktsioon 305939)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305939",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305939",
      "estleg:sourceAct": "Alatskivi maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305939 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305939_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_305939_Par_14_v305939",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305939_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas. Piiranguvööndis on lubatud: majandustegevus; kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas. 2 (2) Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: 1 1) rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas; 2 2) veekogude veetaseme ja kaldajoone muutmine ning uue veekogu rajamine; 3 3) puhtpuistute kujundamine; 4 4) parkides ja arboreetumites puuvõrade või põõsaste kujundamine ning pargi ilme ja liigilise koosseisu tagamiseks vajalik puittaimestiku raie; 5 5) kaitseala tarbeks vajalike ehitiste püstitamine; 6 6) tee, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu tarbeks veekogust kaugemal kui 100 m ehitistele. Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas; veekogude veetaseme ja kaldajoone muutmine ning uue veekogu rajamine; puhtpuistute kujundamine; parkides ja arboreetumites puuvõrade või põõsaste kujundamine ning pargi ilme ja liigilise koosseisu tagamiseks vajalik puittaimestiku raie; kaitseala tarbeks vajalike ehitiste püstitamine; tee, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu tarbeks veekogust kaugemal kui 100 m ehitistele.",
      "rdfs:label": {
        "@value": "Reg_305939_Par_14 (redaktsioon 305939)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305939",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305939",
      "estleg:sourceAct": "Alatskivi maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305939 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305939_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_305939_Par_15_v305939",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305939_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 2 2) puidu kokku- ja väljavedu külmumata pinnasel; 3 3) energiapuistute rajamine; 4 4) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 5 5) biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal ja metsamaal ning veekogule lähemal kui 50 m; 6 6) uue maaparandussüsteemi rajamine; 7 7) uue ehitise, kaasa arvatud ajutise ehitise püstitamine, välja arvatud § 14 lõike 2 punktides 5 ja 6 sätestatud juhtudel. Piiranguvööndis on keelatud: uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel; energiapuistute rajamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal ja metsamaal ning veekogule lähemal kui 50 m; uue maaparandussüsteemi rajamine; uue ehitise, kaasa arvatud ajutise ehitise püstitamine, välja arvatud § 14 lõike 2 punktides 5 ja 6 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "Reg_305939_Par_15 (redaktsioon 305939)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305939",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305939",
      "estleg:sourceAct": "Alatskivi maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305939 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305939_Map_2026"
      }
    },
