      },
      "estleg:versionValidTo": {
        "@value": "2015-03-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ETS_Par_16_v104032015007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-14",
