      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtluse riikliku toetamise liigid käesoleva seaduse tähenduses on: toetused; tagatised; laenud; investeeringud äriühingu omakapitali investeerimisfondi kaudu (edaspidi omakapitali investeeringud).",
      "rdfs:label": {
        "@value": "ETS_Par_3 (redaktsioon 104032015007)",
        "@language": "et"
      },
