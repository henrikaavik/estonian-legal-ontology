        "@value": "2024-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majutuskeskuse tegevuse ja majutuskeskuses osutatud teenuse peale võib taotleja ja kaitse saaja esitada kaebuse või teha ettepaneku majutuskeskuse teenuse osutajale. RT I 2024-04-23 1 123042024001 2024-04-26 Majutuskeskuse tegevuse ja majutuskeskuses osutatud teenuse peale võib taotleja ja kaitse saaja esitada kaebuse või teha ettepaneku majutuskeskuse teenuse osutajale.",
      "rdfs:label": {
        "@value": "Reg_1018329_Par_8 (redaktsioon 1018329)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1018329",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1018329",
      "estleg:sourceAct": "Rahvusvahelise kaitse taotlejate majutuskeskuse sisekorraeeskiri",
      "estleg:provisionRef": "Reg_1018329 § 8",
      "estleg:partOfAct": {
