    {
      "@id": "estleg:Reg_1051774_Par_9_v1051774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051774_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majutusettevõttes peab olema tagatud: 1 1) majutusruumi või majutushoone võtme identifitseeritult väljastamine; 2 2) majutusteenuse kasutajate ööpäevaringne sisse- ja väljapääs; 3 3) selgelt nähtav ja eristatav sissepääs majutusettevõttesse või majutusettevõtte territooriumile; 4 4) majutusteenuse kasutajate teavitamine majutusettevõttes pakutavatest teenustest, hinnakirjast ja majutusettevõtte vastuvõtuaegadest, kui vastuvõtt ei toimu ööpäevaringselt ning info selle kohta, kas teenus on ligipääsetav erivajadusega isikutele; 5 5) kohad prügi kogumiseks majutusettevõtte ruumides või territooriumil. Majutusettevõttes peab olema tagatud: majutusruumi või majutushoone võtme identifitseeritult väljastamine; majutusteenuse kasutajate ööpäevaringne sisse- ja väljapääs; selgelt nähtav ja eristatav sissepääs majutusettevõttesse või majutusettevõtte territooriumile; majutusteenuse kasutajate teavitamine majutusettevõttes pakutavatest teenustest, hinnakirjast ja majutusettevõtte vastuvõtuaegadest, kui vastuvõtt ei toimu ööpäevaringselt ning info selle kohta, kas teenus on ligipääsetav erivajadusega isikutele; kohad prügi kogumiseks majutusettevõtte ruumides või territooriumil.",
      "rdfs:label": {
        "@value": "Reg_1051774_Par_9 (redaktsioon 1051774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051774",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051774",
