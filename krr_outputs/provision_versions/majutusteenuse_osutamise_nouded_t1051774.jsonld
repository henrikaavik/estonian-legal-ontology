    {
      "@id": "estleg:Reg_1051774_Par_5_v1051774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051774_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Majutusettevõtte majutusruumide või asjakohasel juhul majutushoone või korteri uksed peavad olema lukustatavad ja võtmed majutusteenuse kasutaja kasutuses. Majutusettevõtte majutusruumide või asjakohasel juhul majutushoone või korteri uksed peavad olema lukustatavad ja võtmed majutusteenuse kasutaja kasutuses. 2 (2) Majutusruum peab olema otstarbekohaselt sisustatud, tagatud peab olema riiete ja tarbeesemete paigutamise võimalus. Majutusruum peab olema otstarbekohaselt sisustatud, tagatud peab olema riiete ja tarbeesemete paigutamise võimalus.",
      "rdfs:label": {
        "@value": "Reg_1051774_Par_5 (redaktsioon 1051774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051774",
