    {
      "@id": "estleg:Reg_1051774_Par_7_v1051774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051774_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toidu käitlemisel peab majutusteenuse osutaja tagama toidu käitlemise vastavalt toiduseaduse nõuetele. Toidu käitlemisel peab majutusteenuse osutaja tagama toidu käitlemise vastavalt toiduseaduse nõuetele. 2 (2) Toidu valmistamise võimaluse pakkumisel peab majutusettevõttes olema vastavalt sisustatud köök, kööginurk või muud majutusettevõtte liigi eripära arvestavad toidu valmistamise ja toidu serveerimise võimalused. Toidu valmistamise võimaluse pakkumisel peab majutusettevõttes olema vastavalt sisustatud köök, kööginurk või muud majutusettevõtte liigi eripära arvestavad toidu valmistamise ja toidu serveerimise võimalused.",
      "rdfs:label": {
        "@value": "Reg_1051774_Par_7 (redaktsioon 1051774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051774",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051774",
      "estleg:sourceAct": "Majutusteenuse osutamise nõuded",
      "estleg:provisionRef": "Reg_1051774 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1051774_Map"
      }
    },
    {
      "@id": "estleg:Reg_1051774_Par_8_v1051774",
