      "estleg:provisionRef": "Reg_1049915 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049915_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049915_Par_9_v1049915",
