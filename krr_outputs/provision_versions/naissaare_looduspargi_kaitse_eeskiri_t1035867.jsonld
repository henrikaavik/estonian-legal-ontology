      "estleg:versionValidFrom": {
        "@value": "2016-09-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 8. juuli 2009. a käskkirjaga nr 1097 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Määruse menetlus viidi läbi keskkonnaministri 8. juuli 2009. a käskkirjaga nr 1097 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1035867_Par_21 (redaktsioon 1035867)",
        "@language": "et"
      },
