      }
    },
    {
      "@id": "estleg:Reg_1001925_Par_5_v1001925",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001925_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Justiits- ja Digiministeerium võib anda advokatuurile käesoleva määruse alusel esitatava aruande koostamiseks juhiseid. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Justiits- ja Digiministeerium võib anda advokatuurile käesoleva määruse alusel esitatava aruande koostamiseks juhiseid. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 2 (2) Justiits- ja Digiministeeriumil on õigus nõuda advokatuurilt käesoleva määruse alusel esitatud aruande täiendamist ja täpsustamist ning tutvuda aruandes esitatud teabe aluseks olevate dokumentidega. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Justiits- ja Digiministeeriumil on õigus nõuda advokatuurilt käesoleva määruse alusel esitatud aruande täiendamist ja täpsustamist ning tutvuda aruandes esitatud teabe aluseks olevate dokumentidega. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_1001925_Par_5 (redaktsioon 1001925)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001925",
