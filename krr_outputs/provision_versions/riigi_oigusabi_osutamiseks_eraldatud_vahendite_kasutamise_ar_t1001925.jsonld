      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse Eesti Advokatuuri (edaspidi advokatuur) poolt Justiits- ja Digiministeeriumile esitatava riigi õigusabi osutamiseks ja advokatuuri poolt avalik-õiguslike ülesannete täitmiseks eraldatud vahendite kasutamise aruandluse täpsem kord. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Käesoleva määrusega kehtestatakse Eesti Advokatuuri (edaspidi advokatuur) poolt Justiits- ja Digiministeeriumile esitatava riigi õigusabi osutamiseks ja advokatuuri poolt avalik-õiguslike ülesannete täitmiseks eraldatud vahendite kasutamise aruandluse täpsem kord. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_1001925_Par_1 (redaktsioon 1001925)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001925",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001925",
      "estleg:sourceAct": "Riigi õigusabi osutamiseks eraldatud vahendite kasutamise aruandluse kord",
      "estleg:provisionRef": "Reg_1001925 § 1",
      "estleg:partOfAct": {
