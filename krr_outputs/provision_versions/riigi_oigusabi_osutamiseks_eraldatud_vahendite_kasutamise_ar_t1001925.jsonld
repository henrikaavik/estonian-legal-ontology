      }
    },
    {
      "@id": "estleg:Reg_1001925_Par_2_v1001925",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001925_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Advokatuur esitab Justiits- ja Digiministeeriumile hiljemalt aruandekuule järgneva kuu 25. kuupäevaks koondandmed aruandekuul riigi õigusabi osutamiseks ja advokatuuri poolt avalik-õiguslike ülesannete täitmiseks eraldatud vahendite kasutamise ja nende jäägi kohta määruse lisas sätestatud vormil. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Advokatuur esitab Justiits- ja Digiministeeriumile hiljemalt aruandekuule järgneva kuu 25. kuupäevaks koondandmed aruandekuul riigi õigusabi osutamiseks ja advokatuuri poolt avalik-õiguslike ülesannete täitmiseks eraldatud vahendite kasutamise ja nende jäägi kohta määruse lisas sätestatud vormil. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 2 (2) Advokatuur esitab Justiits- ja Digiministeeriumile hiljemalt iga aasta 1. aprilliks määruse §-s 3 sätestatud andmetega aruande. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Advokatuur esitab Justiits- ja Digiministeeriumile hiljemalt iga aasta 1. aprilliks määruse §-s 3 sätestatud andmetega aruande. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_1001925_Par_2 (redaktsioon 1001925)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001925",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001925",
      "estleg:sourceAct": "Riigi õigusabi osutamiseks eraldatud vahendite kasutamise aruandluse kord",
      "estleg:provisionRef": "Reg_1001925 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001925_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001925_Par_3_v1001925",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001925_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määruse § 2 lõikes 2 nimetatud iga-aastases aruandes esitab advokatuur Justiits- ja Digiministeeriumile eelmise kalendriaasta kohta järgmised andmed: RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 1 1) riigi õigusabi tellimused riigi õigusabi liigiti ja riigi õigusabi tellimuste protsentuaalsed muutused võrreldes eelnevate aastatega; 2 2) riigi õigusabi osutamise eest väljamakstud tasud riigi õigusabi liigiti ja riigi õigusabi tasude protsentuaalsed muutused võrreldes eelnevate aastatega; 3 3) riigi õigusabi osutamise väljamakstud kulud riigi õigusabi liigiti ja riigi õigusabi kulude protsentuaalsed muutused võrreldes eelnevate aastatega; 4 4) rahaliste vahendite jääk aruandeaasta alguse seisuga, riigieelarvest saadud eraldise suurus, aruandeaastal kasutatud rahalised vahendid ja rahaliste vahendite jääk aruandeaasta lõpu seisuga; 5 5) riigieelarvest eraldatud vahendite suuruse muutused; 6 6) avalik-õiguslike ülesannete täitmise kulud ja nende kulude protsentuaalsed muutused võrreldes eelnevate aastatega; 7 7) kümne advokaadi nimed, kelle osutatud riigi õigusabi eest on määratud enim riigi õigusabi tasu ning advokaatide lõikes määratud tasude koondsummad riigi õigusabi liigiti; 8 8) riigi õigusabi tasu ja kulude põhjendatuse kontrollimiseks rakendatud kontroll- ja järelevalvemeetmed ning lõpetatud kontrollide tulemused. Käesoleva määruse § 2 lõikes 2 nimetatud iga-aastases aruandes esitab advokatuur Justiits- ja Digiministeeriumile eelmise kalendriaasta kohta järgmised andmed: , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes riigi õigusabi tellimused riigi õigusabi liigiti ja riigi õigusabi tellimuste protsentuaalsed muutused võrreldes eelnevate aastatega; riigi õigusabi osutamise eest väljamakstud tasud riigi õigusabi liigiti ja riigi õigusabi tasude protsentuaalsed muutused võrreldes eelnevate aastatega; riigi õigusabi osutamise väljamakstud kulud riigi õigusabi liigiti ja riigi õigusabi kulude protsentuaalsed muutused võrreldes eelnevate aastatega; rahaliste vahendite jääk aruandeaasta alguse seisuga, riigieelarvest saadud eraldise suurus, aruandeaastal kasutatud rahalised vahendid ja rahaliste vahendite jääk aruandeaasta lõpu seisuga; riigieelarvest eraldatud vahendite suuruse muutused; avalik-õiguslike ülesannete täitmise kulud ja nende kulude protsentuaalsed muutused võrreldes eelnevate aastatega; kümne advokaadi nimed, kelle osutatud riigi õigusabi eest on määratud enim riigi õigusabi tasu ning advokaatide lõikes määratud tasude koondsummad riigi õigusabi liigiti; riigi õigusabi tasu ja kulude põhjendatuse kontrollimiseks rakendatud kontroll- ja järelevalvemeetmed ning lõpetatud kontrollide tulemused. 2 (2) Käesoleva paragrahvi lõike 1 punktis 8 nimetatud andmete kohta esitatakse Justiits- ja Digiministeeriumile andmed advokatuuri poolt rakendatud kontroll- ja järelevalvemeetmetest, mida advokatuur on eelmisel kalendriaastal väljamakstud tasude ja kulude osas rakendanud eesmärgil, et võimalikud kahtlused riigi õigusabi tasu ja kulude põhjendatuse osas ei jääks advokatuuril tuvastamata. Koos eelmises lauses nimetatud andmetega esitatakse ka andmed eelmisel kalendriaastal riigi õigusabi seaduse § 24 lõike 1 teise lause alusel algatatud tasude ja kulude põhjendatuse kontrollidest koos lõpetatud kontrollide tulemustega. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Käesoleva paragrahvi lõike 1 punktis 8 nimetatud andmete kohta esitatakse Justiits- ja Digiministeeriumile andmed advokatuuri poolt rakendatud kontroll- ja järelevalvemeetmetest, mida advokatuur on eelmisel kalendriaastal väljamakstud tasude ja kulude osas rakendanud eesmärgil, et võimalikud kahtlused riigi õigusabi tasu ja kulude põhjendatuse osas ei jääks advokatuuril tuvastamata. Koos eelmises lauses nimetatud andmetega esitatakse ka andmed eelmisel kalendriaastal riigi õigusabi seaduse § 24 lõike 1 teise lause alusel algatatud tasude ja kulude põhjendatuse kontrollidest koos lõpetatud kontrollide tulemustega. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 3 (3) Advokatuur esitab iga-aastases aruandes lisaks käesoleva määrusega ettenähtud eelmist kalendriaastat iseloomustavatele andmetele ka sisulise analüüsi eelmisel kalendriaastal ja sellele eelnenud kolmel kalendriaastal toimunud muutuste ning nende alusel järgnevaks kalendriaastaks koostatud prognooside kohta, välja arvatud käesoleva paragrahvi lõike 1 punktides 7 ja 8 nimetatud andmete kohta. Advokatuur esitab iga-aastases aruandes lisaks käesoleva määrusega ettenähtud eelmist kalendriaastat iseloomustavatele andmetele ka sisulise analüüsi eelmisel kalendriaastal ja sellele eelnenud kolmel kalendriaastal toimunud muutuste ning nende alusel järgnevaks kalendriaastaks koostatud prognooside kohta, välja arvatud käesoleva paragrahvi lõike 1 punktides 7 ja 8 nimetatud andmete kohta. 4 (4) Käesoleva paragrahvi lõikes 3 nimetatud sisulise analüüsi tulemuste põhjal esitab advokatuur Justiits- ja Digiministeeriumile põhistatud taotluse järgmiseks eelarveaastaks riigieelarvest riigi õigusabi osutamiseks ja advokatuuri poolt avalik-õiguslike ülesannete täitmiseks vajaminevate vahendite suuruse kohta. Advokatuur võib esitatud taotlust täiendada ja muuta selliste asjaolude ilmnemise korral, mida advokatuur ei võinud taotluse esitamise ajal ette näha. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Käesoleva paragrahvi lõikes 3 nimetatud sisulise analüüsi tulemuste põhjal esitab advokatuur Justiits- ja Digiministeeriumile põhistatud taotluse järgmiseks eelarveaastaks riigieelarvest riigi õigusabi osutamiseks ja advokatuuri poolt avalik-õiguslike ülesannete täitmiseks vajaminevate vahendite suuruse kohta. Advokatuur võib esitatud taotlust täiendada ja muuta selliste asjaolude ilmnemise korral, mida advokatuur ei võinud taotluse esitamise ajal ette näha. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud läbivalt sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_1001925_Par_3 (redaktsioon 1001925)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001925",
