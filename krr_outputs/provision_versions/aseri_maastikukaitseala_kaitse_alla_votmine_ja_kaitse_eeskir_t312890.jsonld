    {
      "@id": "estleg:Reg_312890_Par_13_v312890",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312890_Par_13"
