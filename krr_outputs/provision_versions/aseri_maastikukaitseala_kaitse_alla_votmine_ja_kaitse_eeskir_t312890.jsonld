    {
      "@id": "estleg:Reg_312890_Par_15_v312890",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312890_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavarade kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 3 3) uuendusraie, välja arvatud turberaie perioodiga vähemalt 40 aastat, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 4 4) biotsiidi ja taimekaitsevahendi kasutamine metsamaal ja looduslikul rohumaal; 5 5) puhtpuistute kujundamine ja energiapuistute rajamine; 6 6) puidu kokku- ja väljavedu külmumata pinnasel. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavarade kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; uuendusraie, välja arvatud turberaie perioodiga vähemalt 40 aastat, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; biotsiidi ja taimekaitsevahendi kasutamine metsamaal ja looduslikul rohumaal; puhtpuistute kujundamine ja energiapuistute rajamine; puidu kokku- ja väljavedu külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_312890_Par_15 (redaktsioon 312890)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312890",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312890",
      "estleg:sourceAct": "Aseri maastikukaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312890 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312890_Map"
      }
