    {
      "@id": "estleg:Reg_1059863_Par_2_v1059863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059863_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lõhkematerjali käitlemist korraldab Politsei- ja Piirivalveameti peadirektori määratud struktuuriüksus. Lõhkematerjali käitlemist korraldab Politsei- ja Piirivalveameti peadirektori määratud struktuuriüksus. 2 (2) Lõhkematerjali võib käidelda vastava väljaõppega politseiametnik. Lõhkematerjali võib käidelda vastava väljaõppega politseiametnik. 3 (3) Politsei- ja Piirivalveameti peadirektor kehtestab lõhkematerjali käitlemise ohutusjuhendi, millega määratakse kindlaks: 1 1) lõhkematerjali käitlemise ohutusnõuded; 2 2) lõhkematerjali käitlemise väljaõppe nõuded politseiametnikule. Politsei- ja Piirivalveameti peadirektor kehtestab lõhkematerjali käitlemise ohutusjuhendi, millega määratakse kindlaks: lõhkematerjali käitlemise ohutusnõuded; lõhkematerjali käitlemise väljaõppe nõuded politseiametnikule.",
      "rdfs:label": {
        "@value": "Reg_1059863_Par_2 (redaktsioon 1059863)",
        "@language": "et"
      },
