    {
      "@id": "estleg:Reg_1062681_Par_3_v1062681",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062681_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevalmistava õppe rühmal on juhendaja (edaspidi rühmajuhendaja), kes korraldab individuaalsete õppekavade koostamist ja rakendamist ning kelle ülesanne on märgata õpilase toe vajadust, korraldada koostöös kooli tugispetsialisti või tugiteenuste koordineerijaga toe rakendamist, koordineerida õppe läbiviimist toetavat võrgustikutööd koolis ja kaasata kooliväliseid partnereid õppe läbiviimisse. Ettevalmistava õppe rühmal on juhendaja (edaspidi rühmajuhendaja), kes korraldab individuaalsete õppekavade koostamist ja rakendamist ning kelle ülesanne on märgata õpilase toe vajadust, korraldada koostöös kooli tugispetsialisti või tugiteenuste koordineerijaga toe rakendamist, koordineerida õppe läbiviimist toetavat võrgustikutööd koolis ja kaasata kooliväliseid partnereid õppe läbiviimisse.",
      "rdfs:label": {
        "@value": "Reg_1062681_Par_3 (redaktsioon 1062681)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062681",
