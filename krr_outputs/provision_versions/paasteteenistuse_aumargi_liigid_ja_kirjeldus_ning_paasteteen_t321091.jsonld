    {
      "@id": "estleg:Reg_321091_Par_15_v321091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_321091_Par_15"
