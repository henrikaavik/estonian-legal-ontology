      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Päästeteenistuse aumärgi liigid ja kirjeldus ning päästeteenistuse aumärgi andmise ja kandmise ning äravõtmise kord (19 versiooni)",
        "@language": "et"
      },
      "dc:source": "Päästeteenistuse aumärgi liigid ja kirjeldus ning päästeteenistuse aumärgi andmise ja kandmise ning äravõtmise kord"
    },
    {
      "@id": "estleg:Reg_321091_Par_1_v321091",
      "@type": [
