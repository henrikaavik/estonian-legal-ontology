      "estleg:provisionRef": "Reg_1055905 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055905_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055905_Par_9_v1055905",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055905_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu andmeid säilitatakse alaliselt, välja arvatud autenditavate kasutajate andmed, mida säilitatakse seni, kuni kasutajal on vastavad õigused. Andmekogu andmeid säilitatakse alaliselt, välja arvatud autenditavate kasutajate andmed, mida säilitatakse seni, kuni kasutajal on vastavad õigused.",
      "rdfs:label": {
        "@value": "Reg_1055905_Par_9 (redaktsioon 1055905)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055905",
