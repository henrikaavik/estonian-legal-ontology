      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055905",
      "estleg:sourceAct": "Hüdrograafia infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_1055905 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055905_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055905_Par_8_v1055905",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055905_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui vastutav töötleja avastab andmekogus ebaõigeid andmeid või kui talle on nendest teada antud, parandab ta pärast andmete kontrollimist ebaõiged andmed viivitamata. Kui vastutav töötleja avastab andmekogus ebaõigeid andmeid või kui talle on nendest teada antud, parandab ta pärast andmete kontrollimist ebaõiged andmed viivitamata.",
      "rdfs:label": {
        "@value": "Reg_1055905_Par_8 (redaktsioon 1055905)",
        "@language": "et"
      },
