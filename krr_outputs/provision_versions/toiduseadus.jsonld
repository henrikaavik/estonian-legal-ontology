    {
      "@id": "estleg:ToiduS_Par_18_v109102014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ToiduS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abiaine käesoleva seaduse tähenduses on Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1333/2008 artikli 3 lõike 2 punktis b sätestatud aine. (2) Abiainete suhtes esitatavad nõuded, nende ainete kasutamise tingimused ja viisid ning toidus lubatud jääksisalduse piirnormid kehtestab määrusega.",
      "rdfs:label": {
        "@value": "ToiduS_Par_18 (redaktsioon 109102014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109102014003"
