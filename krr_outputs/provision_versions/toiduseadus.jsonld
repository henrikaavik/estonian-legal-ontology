    {
      "@id": "estleg:ToiduS_Par_65_2_v12803793",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ToiduS_Par_65_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2007. aasta 1. juulit põllumajandusministri käskkirjaga laboratooriumile järelevalve käigus võetud proovide analüüsimiseks antud volitus kehtib kuni Veterinaar- ja Toiduameti poolt uue volituse andmiseni või selle andmisest keeldumiseni, kuid mitte kauem kui 2008. aasta 1. jaanuarini.",
      "rdfs:label": {
        "@value": "ToiduS_Par_65_2 (redaktsioon 12803793)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12803793",
      "estleg:supersededByVersion": {
        "@id": "estleg:ToiduS_Par_65_2_v129062014081"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ToiduS_Par_65_2_v129062014081",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ToiduS_Par_65_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2007. aasta 1. juulit valdkonna eest vastutava ministri käskkirjaga laboratooriumile järelevalve käigus võetud proovide analüüsimiseks antud volitus kehtib kuni Veterinaar- ja Toiduameti poolt uue volituse andmiseni või selle andmisest keeldumiseni, kuid mitte kauem kui 2008. aasta 1. jaanuarini.",
      "rdfs:label": {
        "@value": "ToiduS_Par_65_2 (redaktsioon 129062014081)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014081"
    },
    {
