    },
    {
      "@id": "estleg:ToiduS_Par_17_v119012011022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ToiduS_Par_17"
      },
      "estleg:versionValidFrom": {
