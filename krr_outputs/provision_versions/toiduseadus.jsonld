        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ToiduS_Par_65_3_v115062016003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ToiduS_Par_65_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 38 lõike 5 kuni 2014. aasta 13. detsembrini kehtinud redaktsiooni alusel kehtestatud eritoitude, sealhulgas meditsiinilisel näidustusel kasutamiseks ettenähtud toidu märgistamise ja muul viisil teabe edastamise erinõuded ja kord kehtivad kuni 2016. aasta 20. juulini.",
      "rdfs:label": {
        "@value": "ToiduS_Par_65_3 (redaktsioon 115062016003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115062016003"
