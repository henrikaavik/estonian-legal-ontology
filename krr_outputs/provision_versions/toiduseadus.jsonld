    {
      "@id": "estleg:ToiduS_Par_19_v22449",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ToiduS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saasteaine on toidutoormes või toidus leiduv aine, mis on sinna sattunud toidutoorme tootmisel või esmasel töötlemisel kasutatud ainete tõttu, käitlemise ajal või keskkonna saastumise tagajärjel ning mis võib olla inimese tervisele ohtlik või mis võib halvendada toidu omadusi. (2) Keelatud või lubatust suuremas koguses saasteaineid sisaldavat toidutooret ja toitu ei ole lubatud käidelda. (3) Lubatud saasteainete loetelu ja piirnormid toidugruppide kaupa kehtestab Vabariigi Valitsus. Loomse toidu ohutuse tagamiseks kehtestab põllumajandusminister korra saasteainete järelevalve reguleerimiseks.",
      "rdfs:label": {
        "@value": "ToiduS_Par_19 (redaktsioon 22449)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22449",
      "estleg:supersededByVersion": {
        "@id": "estleg:ToiduS_Par_19_v750600"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
