    },
    {
      "@id": "estleg:ToiduS_Par_15_v22449",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ToiduS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Külmutatud on toidutoore ja toit, mis on läbinud külmutamisprotsessi ja mida seejärel säilitatakse antud toidutoormele või toidule ettenähtud temperatuuril. Toidu nõuetekohasuse tagamiseks peab külmutamisaeg olema võimalikult lühike. (2) Külmutatud toidutooret ja toitu käideldes tuleb järgida toiduhügieeni üldeeskirjas ja teistes õigusaktides sätestatud nõudeid ning Vabariigi Valitsuse kehtestatud külmutatud toidu käitlemise erinõudeid.",
      "rdfs:label": {
        "@value": "ToiduS_Par_15 (redaktsioon 22449)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22449",
      "estleg:supersededByVersion": {
        "@id": "estleg:ToiduS_Par_15_v750600"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ToiduS_Par_15_v750600",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ToiduS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Külmutatud on toidutoore ja toit, mis on läbinud külmutamisprotsessi ja mida seejärel säilitatakse antud toidutoormele või toidule ettenähtud temperatuuril. Toidu nõuetekohasuse tagamiseks peab külmutamisaeg olema võimalikult lühike.",
      "rdfs:label": {
        "@value": "ToiduS_Par_15 (redaktsioon 750600)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750600",
      "estleg:supersededByVersion": {
