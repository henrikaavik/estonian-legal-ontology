      "estleg:sourceAct": "Eesti Kohtuekspertiisi Instituudis tehtavate ekspertiiside loetelu",
      "estleg:provisionRef": "Reg_1057337 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057337_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057337_Par_2_v1057337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057337_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Kohtuekspertiisi Instituudis tehakse järgmisi kohtuarstlikke ekspertiise: 1 1) arstlik kohtutoksikoloogiaekspertiis joobe määramiseks; 2 2) isiku kohtuarstlik ekspertiis seksuaalse enesemääramise vastases süüteoasjas; 3 3) isiku kohtuarstlik ekspertiis tervisekahjustuse kindlakstegemiseks; 4 4) isiku kohtuarstlik ekspertiis terviseseisundi kindlakstegemiseks; 5 5) kohtuantropoloogiaekspertiis; 6 6) komisjoni tehtav kohtuarstlik ekspertiis; 7 7) narkootiliste ja psühhotroopsete ainete koguse hindamise ekspertiis; 8 8) surnu kohtuarstlik ekspertiis; 9 9) toksiliste ainete mõju hindamise ekspertiis. Eesti Kohtuekspertiisi Instituudis tehakse järgmisi kohtuarstlikke ekspertiise: arstlik kohtutoksikoloogiaekspertiis joobe määramiseks; isiku kohtuarstlik ekspertiis seksuaalse enesemääramise vastases süüteoasjas; isiku kohtuarstlik ekspertiis tervisekahjustuse kindlakstegemiseks; isiku kohtuarstlik ekspertiis terviseseisundi kindlakstegemiseks; kohtuantropoloogiaekspertiis; komisjoni tehtav kohtuarstlik ekspertiis; narkootiliste ja psühhotroopsete ainete koguse hindamise ekspertiis; surnu kohtuarstlik ekspertiis; toksiliste ainete mõju hindamise ekspertiis.",
      "rdfs:label": {
        "@value": "Reg_1057337_Par_2 (redaktsioon 1057337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057337",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057337",
      "estleg:sourceAct": "Eesti Kohtuekspertiisi Instituudis tehtavate ekspertiiside loetelu",
      "estleg:provisionRef": "Reg_1057337 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057337_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057337_Par_3_v1057337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057337_Par_3"
