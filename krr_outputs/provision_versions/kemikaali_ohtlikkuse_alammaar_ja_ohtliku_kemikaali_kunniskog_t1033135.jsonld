    {
      "@id": "estleg:Reg_1033135_Par_3_v1033135",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033135_Par_3"
