      "estleg:sourceAct": "Traktori, liikurmasina ja nende haagiste tehnonõuded, nõuded varustusele ning tehnonõuetele vastavuse kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1001071 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001071_Map_2026"
      }
