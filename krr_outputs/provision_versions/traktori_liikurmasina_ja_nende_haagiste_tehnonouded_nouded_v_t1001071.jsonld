    {
      "@id": "estleg:Reg_1001071_Par_13_v1001071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001071_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vanasõidukina tunnustamisel väljastatakse nõuetele vastava vanasõiduki kohta käesoleva määruse lisas 3 toodud vanasõidukina tunnustamise akt, mille teine eksemplar edastatakse akti koostajate poolt Transpordiametile. Vanasõidukina tunnustamisel väljastatakse nõuetele vastava vanasõiduki kohta käesoleva määruse lisas 3 toodud vanasõidukina tunnustamise akt, mille teine eksemplar edastatakse akti koostajate poolt Transpordiametile. 2 (2) Masina registreerimistunnistuse vahetamisel vanasõidukina tunnustamise akti väljastamise korral peab Transpordiamet kandma uuele registreerimistunnistusele märkuse masina ülevaatuse kohta ja kinnitama selle allkirjaga. RT I 2025-10-24 1 124102025001 2025-10-27 Masina registreerimistunnistuse vahetamisel vanasõidukina tunnustamise akti väljastamise korral peab Transpordiamet kandma uuele registreerimistunnistusele märkuse masina ülevaatuse kohta ja kinnitama selle allkirjaga.",
      "rdfs:label": {
