    },
    {
      "@id": "estleg:Reg_1001071_Par_9_v1001071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001071_Par_9"
      },
      "estleg:versionValidFrom": {
