      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Jäätmepõletus- ja koospõletustehastest väljuvate gaaside puhastamisel tekkiva reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtused ning suublasse juhitava heite piirväärtustele vastavuse hindamise kriteeriumid (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Jäätmepõletus- ja koospõletustehastest väljuvate gaaside puhastamisel tekkiva reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtused ning suublasse juhitava heite piirväärtustele vastavuse hindamise kriteeriumid"
    },
    {
      "@id": "estleg:Reg_1014864_Par_1_v1014864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014864_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse jäätmepõletus- ja koospõletustehastest väljuvate gaaside veega puhastamisel tekkiva reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtused ning heite piirväärtustele vastavuse hindamise kriteeriumid. Määrusega kehtestatakse jäätmepõletus- ja koospõletustehastest väljuvate gaaside veega puhastamisel tekkiva reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtused ning heite piirväärtustele vastavuse hindamise kriteeriumid.",
      "rdfs:label": {
        "@value": "Reg_1014864_Par_1 (redaktsioon 1014864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014864",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014864",
      "estleg:sourceAct": "Jäätmepõletus- ja koospõletustehastest väljuvate gaaside puhastamisel tekkiva reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtused ning suublasse juhitava heite piirväärtustele vastavuse hindamise kriteeriumid",
      "estleg:provisionRef": "Reg_1014864 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014864_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1014864_Par_2_v1014864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014864_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väljuvate gaaside veega puhastamisel tekkiva reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtused on esitatud käesoleva määruse lisas. Väljuvate gaaside veega puhastamisel tekkiva reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtused on esitatud käesoleva määruse lisas. 2 (2) Reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtuste määramisel peab loa andja lisaks käesoleva määruse lisas sätestatud heite piirväärtustele lähtuma ka veeseaduse § 24 lõigetes 2, 5 ja 6 ning veeseaduse § 265 lõigetes 7, 10 ja 11 sätestatust. Reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtuste määramisel peab loa andja lisaks käesoleva määruse lisas sätestatud heite piirväärtustele lähtuma ka veeseaduse § 24 lõigetes 2, 5 ja 6 ning veeseaduse § 265 lõigetes 7, 10 ja 11 sätestatust.",
      "rdfs:label": {
        "@value": "Reg_1014864_Par_2 (redaktsioon 1014864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014864",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014864",
      "estleg:sourceAct": "Jäätmepõletus- ja koospõletustehastest väljuvate gaaside puhastamisel tekkiva reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtused ning suublasse juhitava heite piirväärtustele vastavuse hindamise kriteeriumid",
      "estleg:provisionRef": "Reg_1014864 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014864_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1014864_Par_3_v1014864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014864_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Suublasse juhitava heite piirväärtustest on kinni peetud, kui: 1 1) heljuvaine sisalduse mõõdetud väärtused ei ületa lisas nimetatud heite piirväärtusi; 2 2) aasta jooksul mõõdetud raskmetallide sisaldus ei ületa lisas nimetatud piirväärtusi rohkem kui ühel korral või kui aastas on võetud 20 proovi, ei ületa lisas nimetatud piirväärtusi rohkem kui 5%-s võetud proovidest; 3 3) dioksiinide ja furaanide üldsisaldus ei ületa lisas nimetatud piirväärtust. Suublasse juhitava heite piirväärtustest on kinni peetud, kui: heljuvaine sisalduse mõõdetud väärtused ei ületa lisas nimetatud heite piirväärtusi; aasta jooksul mõõdetud raskmetallide sisaldus ei ületa lisas nimetatud piirväärtusi rohkem kui ühel korral või kui aastas on võetud 20 proovi, ei ületa lisas nimetatud piirväärtusi rohkem kui 5%-s võetud proovidest; dioksiinide ja furaanide üldsisaldus ei ületa lisas nimetatud piirväärtust.",
      "rdfs:label": {
        "@value": "Reg_1014864_Par_3 (redaktsioon 1014864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014864",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014864",
      "estleg:sourceAct": "Jäätmepõletus- ja koospõletustehastest väljuvate gaaside puhastamisel tekkiva reovee käitlemise tulemusena tekkiva heitvee saasteainete heite piirväärtused ning suublasse juhitava heite piirväärtustele vastavuse hindamise kriteeriumid",
      "estleg:provisionRef": "Reg_1014864 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014864_Map_2026"
      }
    },
