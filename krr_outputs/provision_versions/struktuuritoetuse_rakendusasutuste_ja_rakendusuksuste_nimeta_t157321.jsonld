      "estleg:versionValidFrom": {
        "@value": "2019-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega nimetatakse struktuuritoetuse rakendusasutuste ja rakendusüksuste ülesandeid täitvad riigiasutused ja eraõiguslikud juriidilised isikud ning kinnitatakse riigi ja kohaliku omavalitsuse investeeringute meetmete loetelu. Määrusega nimetatakse struktuuritoetuse rakendusasutuste ja rakendusüksuste ülesandeid täitvad riigiasutused ja eraõiguslikud juriidilised isikud ning kinnitatakse riigi ja kohaliku omavalitsuse investeeringute meetmete loetelu.",
      "rdfs:label": {
        "@value": "Reg_157321_Par_1 (redaktsioon 157321)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157321",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157321",
      "estleg:sourceAct": "Struktuuritoetuse rakendusasutuste ja rakendusüksuste nimetamine ning riigi ja kohaliku omavalitsuse investeeringute meetmete loetelu kinnitamine",
      "estleg:provisionRef": "Reg_157321 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157321_Map"
      }
    },
