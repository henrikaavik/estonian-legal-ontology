      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Struktuuritoetuse rakendusasutuste ja rakendusüksuste nimetamine ning riigi ja kohaliku omavalitsuse investeeringute meetmete loetelu kinnitamine (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Struktuuritoetuse rakendusasutuste ja rakendusüksuste nimetamine ning riigi ja kohaliku omavalitsuse investeeringute meetmete loetelu kinnitamine"
    },
    {
      "@id": "estleg:Reg_157321_Par_1_v157321",
      "@type": [
