    {
      "@id": "estleg:Reg_157321_Par_7_v157321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157321_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi ja kohaliku omavalitsuse investeeringute meetmed «Perioodi 2004–2006 struktuuritoetuse seaduse» § 17 lõike 1 tähenduses on: 1 1) meetme 2.4 «Turismi arendamine» osa «Keskvalitsuse turismiinvesteeringu projektid»; 2 2) meede 4.1 «Transpordi-infrastruktuuri arendamine»; 3 3) meede 4.3 «Kutse- ja kõrghariduse ning seda toetava infrastruktuuri moderniseerimine»; 4 4) meede 4.4 «Haiglavõrgu reorganiseerimine»; 5 5) meede 4.5 «Infoühiskonna arendamine»; 6 6) meetme 4.6 «Kohalik sotsiaal-majanduslik areng» osa, mille raames toetatakse alljärgnevaid valdkondi: üldharidus ja tööturule orienteeritud sotsiaalne infrastruktuur, kohalik transpordi infrastruktuur, kohaliku omavalitsuse tehniline infrastruktuur; 7 7) meetme 1.3 «Võrdsed võimalused tööturul» osad «Tööturuasutuste projektid» ja «Sotsiaalministeeriumi ja tööharjutuskeskuste investeeringute kava». RT I 2008 15 110 12945215 2008-04-07 Riigi ja kohaliku omavalitsuse investeeringute meetmed «Perioodi 2004–2006 struktuuritoetuse seaduse» § 17 lõike 1 tähenduses on: meetme 2.4 «Turismi arendamine» osa «Keskvalitsuse turismiinvesteeringu projektid»; meede 4.1 «Transpordi-infrastruktuuri arendamine»; meede 4.3 «Kutse- ja kõrghariduse ning seda toetava infrastruktuuri moderniseerimine»; meede 4.4 «Haiglavõrgu reorganiseerimine»; meede 4.5 «Infoühiskonna arendamine»; meetme 4.6 «Kohalik sotsiaal-majanduslik areng» osa, mille raames toetatakse alljärgnevaid valdkondi: üldharidus ja tööturule orienteeritud sotsiaalne infrastruktuur, kohalik transpordi infrastruktuur, kohaliku omavalitsuse tehniline infrastruktuur; meetme 1.3 «Võrdsed võimalused tööturul» osad «Tööturuasutuste projektid» ja «Sotsiaalministeeriumi ja tööharjutuskeskuste investeeringute kava».",
      "rdfs:label": {
        "@value": "Reg_157321_Par_7 (redaktsioon 157321)",
        "@language": "et"
      },
