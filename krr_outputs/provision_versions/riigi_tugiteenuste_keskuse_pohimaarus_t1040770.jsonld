    {
      "@id": "estleg:Reg_1040770_Par_7_v1040770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040770_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskuse põhiülesanded on: 1 1) riigi raamatupidamise ning personali- ja palgaarvestuse korraldamine ja selleks standardite väljatöötamine; 2 2) finants- ning personali- ja palgaarvestuse teenuste osutamine teenindatavatele asutustele; 3 3) Keskuse tegevusvaldkonda kuuluvate Keskuse ja riigi infosüsteemide arendamine ja hooldamine; RT I 2023-07-15 47 115072023047 2023-07-18 4 4) kehtetu - RT I 2022-01-19 2 119012022002 2022-01-22 , rakendatakse 2022. aasta 1. jaanuarist. 5 5) riigihangete korraldamine teenindatavatele asutustele; 6 6) kesksete riigihangete korraldamine; 7 7) kehtetu - RT I 2024-01-10 4 110012024004 2024-02-01 8 8) kehtetu - RT I 2019-12-12 1 112122019001 2020-01-01 8 8¹) toetuste otstarbeka ja sihipärase kasutamise korraldamine, andmine, järelevalve ning sertifitseerimine; RT I 2018-08-23 4 123082018004 2018-09-01 8 8²) dokumendihaldus- ja arhiiviteenuse osutamine teenindatavatele asutustele; RT I 2022-12-03 2 103122022002 2023-01-01 9 9) oma tegevusvaldkonda puudutavate õigusaktide väljatöötamises osalemine ja Rahandusministeeriumile ettepanekute tegemine õigusaktide muutmiseks; 10 10) muude õigusaktidest tulenevate ja Rahandusministeeriumi antud ülesannete täitmine. Keskuse põhiülesanded on: riigi raamatupidamise ning personali- ja palgaarvestuse korraldamine ja selleks standardite väljatöötamine; finants- ning personali- ja palgaarvestuse teenuste osutamine teenindatavatele asutustele; Keskuse tegevusvaldkonda kuuluvate Keskuse ja riigi infosüsteemide arendamine ja hooldamine; kehtetu - , rakendatakse 2022. aasta 1. jaanuarist. riigihangete korraldamine teenindatavatele asutustele; kesksete riigihangete korraldamine; kehtetu - kehtetu - toetuste otstarbeka ja sihipärase kasutamise korraldamine, andmine, järelevalve ning sertifitseerimine; dokumendihaldus- ja arhiiviteenuse osutamine teenindatavatele asutustele; oma tegevusvaldkonda puudutavate õigusaktide väljatöötamises osalemine ja Rahandusministeeriumile ettepanekute tegemine õigusaktide muutmiseks; muude õigusaktidest tulenevate ja Rahandusministeeriumi antud ülesannete täitmine.",
      "rdfs:label": {
        "@value": "Reg_1040770_Par_7 (redaktsioon 1040770)",
        "@language": "et"
      },
