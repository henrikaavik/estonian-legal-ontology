      },
      "estleg:versionText": "Määrusega kehtestatakse sorditunnistuse ja kaitsealuse sordi tunnistuse sisu nõuded. Määrusega kehtestatakse sorditunnistuse ja kaitsealuse sordi tunnistuse sisu nõuded.",
      "rdfs:label": {
        "@value": "Reg_303549_Par_1 (redaktsioon 303549)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303549",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303549",
      "estleg:sourceAct": "Sorditunnistuse ja kaitsealuse sordi tunnistuse sisu nõuded",
