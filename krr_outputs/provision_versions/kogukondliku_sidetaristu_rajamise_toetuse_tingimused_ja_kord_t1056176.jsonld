    {
      "@id": "estleg:Reg_1056176_Par_2_v1056176",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056176_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse eesmärk on aidata kogukondadel rajada üldkasutatavaid elektroonilise side juurdepääsuvõrke. Toetuse eesmärk on aidata kogukondadel rajada üldkasutatavaid elektroonilise side juurdepääsuvõrke. 2 (2) Toetuse andmise tulemusena rajatakse üldkasutatav elektroonilise side juurdepääsuvõrk ja luuakse sellega liitumise võimalus. Toetuse andmise tulemusena rajatakse üldkasutatav elektroonilise side juurdepääsuvõrk ja luuakse sellega liitumise võimalus.",
      "rdfs:label": {
        "@value": "Reg_1056176_Par_2 (redaktsioon 1056176)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056176",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056176",
      "estleg:sourceAct": "Kogukondliku sidetaristu rajamise toetuse tingimused ja kord",
      "estleg:provisionRef": "Reg_1056176 § 2",
      "estleg:partOfAct": {
