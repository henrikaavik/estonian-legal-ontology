    },
    {
      "@id": "estleg:Reg_1056176_Par_1_v1056176",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056176_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määruse alusel antav toetus on vähese tähtsusega abi vastavalt Euroopa Komisjoni määruse (EL) nr 1407/2013, milles käsitletakse Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamist vähese tähtsusega abi suhtes (ELT L 352, 24.12.2013, lk 1–8) (edaspidi vähese tähtsusega abi määrus), artikli 3 mõistes ja sellele kohaldatakse nimetatud määruses ja konkurentsiseaduse §-s 33 sätestatut. Määruse alusel antav toetus on vähese tähtsusega abi vastavalt Euroopa Komisjoni määruse (EL) nr 1407/2013, milles käsitletakse Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamist vähese tähtsusega abi suhtes (ELT L 352, 24.12.2013, lk 1–8) (edaspidi vähese tähtsusega abi määrus), artikli 3 mõistes ja sellele kohaldatakse nimetatud määruses ja konkurentsiseaduse §-s 33 sätestatut. 2 (2) Määruse alusel ei anta toetust vähese tähtsusega abi määruse artikli 1 lõikes 1 sätestatud juhtudel. Määruse alusel ei anta toetust vähese tähtsusega abi määruse artikli 1 lõikes 1 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "Reg_1056176_Par_1 (redaktsioon 1056176)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056176",
