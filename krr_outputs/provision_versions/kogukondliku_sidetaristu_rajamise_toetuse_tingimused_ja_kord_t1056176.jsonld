    {
      "@id": "estleg:Reg_1056176_Par_27_v1056176",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056176_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) TTJA teeb taotluse rahuldamise otsuse osaliselt või täielikult kehtetuks tunnistamisel toetuse osalise või täies ulatuses tagasinõudmise otsuse. TTJA teeb taotluse rahuldamise otsuse osaliselt või täielikult kehtetuks tunnistamisel toetuse osalise või täies ulatuses tagasinõudmise otsuse. 2 (2) Toetuse tagasinõudmise otsuse võib teha ühe aasta jooksul toetuse saaja viimase kohustuse täitmise lõppemisest arvates. Toetuse tagasinõudmise otsuse võib teha ühe aasta jooksul toetuse saaja viimase kohustuse täitmise lõppemisest arvates. 3 (3) Toetuse saaja peab tagasinõutud toetuse tagasi maksma 60 kalendripäeva jooksul otsuse kehtima hakkamise päevast alates. Toetuse saaja peab tagasinõutud toetuse tagasi maksma 60 kalendripäeva jooksul otsuse kehtima hakkamise päevast alates.",
      "rdfs:label": {
        "@value": "Reg_1056176_Par_27 (redaktsioon 1056176)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056176",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056176",
      "estleg:sourceAct": "Kogukondliku sidetaristu rajamise toetuse tingimused ja kord",
      "estleg:provisionRef": "Reg_1056176 § 27",
