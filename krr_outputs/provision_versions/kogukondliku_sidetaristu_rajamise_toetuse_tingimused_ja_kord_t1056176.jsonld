    {
      "@id": "estleg:Reg_1056176_Par_23_v1056176",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056176_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "TTJA avaldab oma veebilehel vähemalt järgmise informatsiooni: 1 1) käesoleva määruse seletuskiri; 2 2) toetuse taotlemiseks vajalikud taotlusvormid ja juhendid; 3 3) toetuse saajate nimed; 4 4) projektide kogumaksumused ja toetuste summad; 5 5) juurdepääsuvõrkudes kasutatavate tehnoloogiate kirjeldused. TTJA avaldab oma veebilehel vähemalt järgmise informatsiooni: käesoleva määruse seletuskiri; toetuse taotlemiseks vajalikud taotlusvormid ja juhendid; toetuse saajate nimed; projektide kogumaksumused ja toetuste summad; juurdepääsuvõrkudes kasutatavate tehnoloogiate kirjeldused.",
      "rdfs:label": {
        "@value": "Reg_1056176_Par_23 (redaktsioon 1056176)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056176",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056176",
      "estleg:sourceAct": "Kogukondliku sidetaristu rajamise toetuse tingimused ja kord",
      "estleg:provisionRef": "Reg_1056176 § 23",
      "estleg:partOfAct": {
