      }
    },
    {
      "@id": "estleg:RKT_Par_48_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu töö ajagraafikut võib Riigikogu muuta kahekolmandikulise häälteenamusega vastuvõetud otsusega, välja arvatud käesoleva seaduse § 47 lõike 1 punktis 1 ettenähtud juhul.",
      "rdfs:label": {
        "@value": "RKT_Par_48 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 48",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_49_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu täiendav istung võib toimuda väljaspool käesoleva seaduse §-s 47 sätestatud töö ajagraafikut. (2) Täiendava istungi toimumise otsustab ning selle päevakorra valmistab ette Riigikogu juhatus. (3) Täiendava istungi kutsub kokku Riigikogu esimees. Kokkukutsumisest teatab Riigikogu esimees Riigikogu liikmetele massiteabevahendite kaudu vähemalt kolm päeva enne täiendava istungi toimumist. Kaalukate põhjuste olemasolu korral võib etteteatamise aeg olla lühem.",
      "rdfs:label": {
        "@value": "RKT_Par_49 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 49",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_5_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast Riigikogu esimehe ja aseesimeeste valimist esineb peaminister avaldusega Vabariigi Valitsuse tagasiastumisest.",
      "rdfs:label": {
        "@value": "RKT_Par_5 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 5",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_50_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu erakorraline istungjärk võib toimuda väljaspool Riigikogu korraliste istungjärkude aega.",
      "rdfs:label": {
        "@value": "RKT_Par_50 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 50",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_51_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu erakorralise istungjärgu kutsub kokku Riigikogu esimees Vabariigi Presidendi, Vabariigi Valitsuse või vähemalt viiendiku Riigikogu koosseisu ettepanekul nende poolt taotletud ajal ja päevakorraga. (2) Erakorralise istungjärgu kokkukutsumisest teatab Riigikogu esimees Riigikogu liikmetele massiteabevahendite kaudu.",
      "rdfs:label": {
        "@value": "RKT_Par_51 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 51",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_52_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu erakorralise istungjärgu töö ajagraafiku kehtestab Riigikogu juhatuse ettepanekul poolthäälteenamusega.",
      "rdfs:label": {
        "@value": "RKT_Par_52 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 52",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_53_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päevakord sisaldab Riigikogu täiskogus arutamisele tulevate küsimuste loetelu ning nende arutamise kuupäeva ja järjekorda. (2) Riigikogu täiskogu töönädala päevakorra valmistab ette Riigikogu juhatus Riigikogu komisjonide ettepanekute ning arupärimistele vastamiseks arupärimiste adressaatidega saavutatud kokkulepete alusel. Kui küsimuse päevakorda võtmine tuleneb käesolevast seadusest, võtab küsimuse päevakorda Riigikogu juhatus oma algatusel. Riigikogu komisjonid esitavad ettepanekud järgmise töönädala päevakorra kohta töönädala neljapäeva kella 15.00-ks. (3) Täiskogu eelmisel töönädalal arutamata jäänud küsimused võetakse uue töönädala päevakorda esimestena. (4) Riigikogu täiendava istungi päevakorra valmistab ette Riigikogu juhatus. (5) Riigikogu erakorralise istungjärgu päevakorra valmistab ette istungjärgu kokkukutsumise ettepaneku tegija.",
      "rdfs:label": {
        "@value": "RKT_Par_53 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 53",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_54_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu täiskogu järgmise töönädala päevakord tehakse Riigikogu liikmetele teatavaks töönädala lõpuks. (2) Riigikogu täiendava istungi ja erakorralise istungjärgu päevakord tehakse Riigikogu liikmetele teatavaks koos täiendava istungi või erakorralise istungjärgu kokkukutsumisega. (3) Pärast päevakorra teatavakstegemist võib seda täiendada üksnes juhul, kui ükski fraktsioon ei ole selle vastu, välja arvatud käesoleva seaduse §-s 56 ettenähtud juhtudel.",
      "rdfs:label": {
        "@value": "RKT_Par_54 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKT_Par_54_v107032019002"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 54",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_54_v107032019002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu täiskogu järgmise töönädala päevakord tehakse Riigikogu liikmetele teatavaks töönädala lõpuks. (2) Riigikogu täiendava istungi ja erakorralise istungjärgu päevakord tehakse Riigikogu liikmetele teatavaks koos täiendava istungi või erakorralise istungjärgu kokkukutsumisega. (3) Pärast päevakorra teatavakstegemist võib seda täiendada üksnes juhul, kui ükski fraktsioon ei ole selle vastu, välja arvatud käesoleva seaduse §-s 56 ettenähtud juhtudel. (4) Pärast päevakorra teatavakstegemist arvatakse eelnõu päevakorrast välja eelnõu algataja, eelnõu esitaja või juhtivkomisjoni taotlusel. Kui algatajaid või esitajaid on kaks, peavad eelnõu päevakorrast väljaarvamise taotlusele olema alla kirjutanud mõlemad algatajad või esitajad. Kui algatajaid või esitajaid on enam kui kaks, peab väljaarvamise taotlusele olema alla kirjutanud üle poole algatajatest või esitajatest.",
      "rdfs:label": {
        "@value": "RKT_Par_54 (redaktsioon 107032019002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032019002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107032019002",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 54",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_55_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päevakorra kinnitab Riigikogu täiskogu töönädala esimesel istungil või täiendava istungi alguses. Riigikogu erakorralise istungjärgu päevakord kinnitamisele ei kuulu. (2) Enne päevakorra kinnitamist võib Riigikogu teha päevakorras muudatusi, arvestades käesoleva seaduse § 54 lõikes 3 ettenähtut. (3) Riigikogu ei või päevakorrast välja arvata küsimusi, mida Riigikogu peab arutama vastavalt Eesti Vabariigi põhiseadusele või käesolevale seadusele.",
      "rdfs:label": {
        "@value": "RKT_Par_55 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKT_Par_55_v107032019002"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 55",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_55_v107032019002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päevakorra kinnitab Riigikogu täiskogu töönädala esimesel istungil või täiendava istungi alguses. Riigikogu erakorralise istungjärgu päevakord kinnitamisele ei kuulu. (2) Enne päevakorra kinnitamist võib Riigikogu teha päevakorras muudatusi, arvestades käesoleva seaduse § 54 lõigetes 3 ja 4 ettenähtut. (3) Riigikogu ei või päevakorrast välja arvata küsimusi, mida Riigikogu peab arutama vastavalt Eesti Vabariigi põhiseadusele või käesolevale seadusele.",
      "rdfs:label": {
        "@value": "RKT_Par_55 (redaktsioon 107032019002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032019002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107032019002",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 55",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_56_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu täiskogu töönädala või täiendava istungi päevakorda võib täiendada pärast selle kinnitamist üksnes järgmiste küsimustega: peaministrikandidaadile volituste andmine Vabariigi Valitsuse moodustamiseks, mis võetakse arutamisele 14 päeva jooksul, arvates peaministrikandidaadi määramisest Vabariigi Presidendi poolt, või pärast peaministrikandidaatide ülesseadmise tähtaja möödumist; Vabariigi Valitsusele, peaministrile või ministrile umbusalduse avaldamine, mis võetakse arutamisele kõige varem ülejärgmisel päeval pärast selle algatamist, kui Vabariigi Valitsus ei nõua kiiremat otsustamist; Vabariigi Presidendi poolt välja kuulutamata jäetud ning Riigikogule uueks arutamiseks ja otsustamiseks saadetud seadus, mis võetakse arutamisele esimesel võimalusel; Vabariigi Presidendi seadluse kinnitamise või tühistamise seaduse eelnõu, mis võetakse arutamisele esimesel võimalusel; erakorralise seisukorra väljakuulutamine, mis võetakse arutamisele esimesel võimalusel; sõjaseisukorra, mobilisatsiooni või demobilisatsiooni väljakuulutamine, mis võetakse arutamisele esimesel võimalusel; õiguskantsleri ettepanek seaduse või Riigikogu otsuse vastavusse viimiseks Eesti Vabariigi põhiseaduse või seadusega, mis võetakse arutamisele esimesel võimalusel; ametiisiku kriminaalvastutusele võtmiseks nõusoleku andmine, mis võetakse arutamisele esimesel võimalusel; Vabariigi Presidendi, peaministri ja ministrite poliitilised avaldused, mis esitatakse Riigikogu esimehe ja avalduse esitaja poolt kokkulepitud ajal; Riigikogu külaliste poliitilised avaldused, mis esitatakse Riigikogu juhatuse määratud ajal; ametivanne, mis antakse Riigikogu esimehe määratud ajal. (2) Päevakorda täiendatakse Riigikogu esimehe ettepanekul.",
      "rdfs:label": {
        "@value": "RKT_Par_56 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKT_Par_56_v13164520"
      },
      "estleg:versionValidTo": {
        "@value": "2009-04-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 56",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_56_v13164520",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu täiskogu töönädala või täiendava istungi päevakorda võib täiendada pärast selle kinnitamist üksnes järgmiste küsimustega: peaministrikandidaadile volituste andmine Vabariigi Valitsuse moodustamiseks, mis võetakse arutamisele 14 päeva jooksul, arvates peaministrikandidaadi määramisest Vabariigi Presidendi poolt, või pärast peaministrikandidaatide ülesseadmise tähtaja möödumist; Vabariigi Valitsusele, peaministrile või ministrile umbusalduse avaldamine, mis võetakse arutamisele kõige varem ülejärgmisel päeval pärast selle algatamist, kui Vabariigi Valitsus ei nõua kiiremat otsustamist; Vabariigi Presidendi poolt välja kuulutamata jäetud ning Riigikogule uueks arutamiseks ja otsustamiseks saadetud seadus, mis võetakse arutamisele esimesel võimalusel; Vabariigi Presidendi seadluse kinnitamise või tühistamise seaduse eelnõu, mis võetakse arutamisele esimesel võimalusel; erakorralise seisukorra väljakuulutamine, mis võetakse arutamisele esimesel võimalusel; sõjaseisukorra, mobilisatsiooni või demobilisatsiooni väljakuulutamine, mis võetakse arutamisele esimesel võimalusel; õiguskantsleri ettepanek seaduse või Riigikogu otsuse vastavusse viimiseks Eesti Vabariigi põhiseaduse või seadusega, mis võetakse arutamisele esimesel võimalusel; ametiisiku kriminaalvastutusele võtmiseks nõusoleku andmine, mis võetakse arutamisele esimesel võimalusel; Vabariigi Presidendi, peaministri ja ministrite poliitilised avaldused, mis esitatakse Riigikogu esimehe ja avalduse esitaja poolt kokkulepitud ajal; Riigikogu külaliste poliitilised avaldused, mis esitatakse Riigikogu juhatuse määratud ajal; ametivanne, mis antakse Riigikogu esimehe määratud ajal; riigieelarve seaduse § 37 lõike 3 punktis 3 nimetatud finantskriisi ennetamise või lahendamisega seotud otsuste eelnõud, mis võetakse arutamisele esimesel võimalusel. (2) Päevakorda täiendatakse Riigikogu esimehe ettepanekul.",
      "rdfs:label": {
        "@value": "RKT_Par_56 (redaktsioon 13164520)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13164520",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKT_Par_56_v114092012002"
      },
      "estleg:versionValidTo": {
        "@value": "2012-09-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13164520",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 56",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_56_v114092012002",
