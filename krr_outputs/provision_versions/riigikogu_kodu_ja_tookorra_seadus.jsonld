        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 21",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_21_v107032019002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu võib moodustada probleemkomisjoni olulise tähtsusega probleemi läbitöötamiseks. (2) Probleemkomisjon moodustatakse Riigikogu otsusega, milles määratakse tema ülesanded, volituste kestus ja koosseisu moodustamise printsiip. (3) Probleemkomisjon esitab tegevuse lõpetamisel Riigikogule aruande oma tegevusest.",
      "rdfs:label": {
        "@value": "RKT_Par_21 (redaktsioon 107032019002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032019002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107032019002",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 21",
      "estleg:partOfAct": {
