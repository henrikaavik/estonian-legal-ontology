    {
      "@id": "estleg:RKT_Par_12_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu juhatus koosneb Riigikogu esimehest ja aseesimeestest.",
      "rdfs:label": {
        "@value": "RKT_Par_12 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
