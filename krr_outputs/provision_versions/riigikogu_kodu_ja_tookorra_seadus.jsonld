        "@id": "estleg:RKT_Par_158_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu arhiiv moodustub Riigikogu täiskogu, komisjonide, fraktsioonide, juhatuse, Riigikogu Kantselei ja Vabariigi Valimiskomisjoni dokumentidest. (2) Riigikogu arhiivi pidamise korra kinnitab Riigikogu juhatus.",
      "rdfs:label": {
        "@value": "RKT_Par_158_2 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:supersededByVersion": {
