    {
      "@id": "estleg:RKT_Par_25_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu alatise komisjoni liikmete arvu määrab Riigikogu juhatus. (2) Euroopa Liidu asjade komisjonil on vähemalt 15 liiget, kusjuures komisjoni koosseisu peab kuuluma vähemalt üks liige või asendusliige igast käesoleva seaduse § 18 lõike 1 punktides 2–11 loetletud alatisest komisjonist.",
      "rdfs:label": {
        "@value": "RKT_Par_25 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
