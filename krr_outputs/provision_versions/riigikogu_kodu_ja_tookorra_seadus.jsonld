      }
    },
    {
      "@id": "estleg:RKT_Par_2_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu uue koosseisu esimese istungi avab Vabariigi President. (2) Esimest istungit juhatab kuni Riigikogu esimehe valimiseni Vabariigi Valimiskomisjoni esimees või tema asetäitja. (3) Riigikogu liikmete kohad Riigikogu istungisaalis paiknevad tähestikulises järjekorras.",
      "rdfs:label": {
        "@value": "RKT_Par_2 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 2",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
    {
      "@id": "estleg:RKT_Par_20_v12849986",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu võib moodustada uurimiskomisjoni avalikku huvi pakkuva sündmuse asjaolude uurimiseks. (2) Uurimiskomisjon moodustatakse Riigikogu otsusega, milles määratakse tema koosseis, sealhulgas ka asendusliige igale komisjoni liikmele, ülesanded ja volituste kestus. (3) Uurimiskomisjon esitab Riigikogule vähemalt kord aastas vahearuande oma tegevusest ning tegevuse lõpetamisel lõpparuande.",
      "rdfs:label": {
        "@value": "RKT_Par_20 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKT_Par_20_v107032019002"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
      "estleg:sourceAct": "Riigikogu kodu- ja töökorra seadus",
      "estleg:provisionRef": "RKT § 20",
      "estleg:partOfAct": {
        "@id": "estleg:RKT_Map_2026"
      }
    },
