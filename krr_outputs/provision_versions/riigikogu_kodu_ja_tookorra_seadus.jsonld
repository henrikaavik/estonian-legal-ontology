    {
      "@id": "estleg:RKT_Par_157_2_v128062016022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKT_Par_157_2"
      },
      "estleg:versionValidFrom": {
