      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu komisjonid on alatised, eri-, uurimis- ja probleemkomisjonid.",
      "rdfs:label": {
        "@value": "RKT_Par_17 (redaktsioon 12849986)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849986",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12849986",
