        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023025"
    },
    {
      "@id": "estleg:KESKKO_3_Par_43_1_v114032011038",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
