    {
      "@id": "estleg:KESKKO_3_Par_12_1_v116052013013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KESKKO_3_Par_12_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jahipidamisõiguse tasu makstakse õiguse eest jahti pidada. (2) Jahipidamisõiguse tasu suuruse ning maksmise ja selle kontrollimise korra arvestades käesolevas paragrahvis sätestatud piirmäärasid. (3) Jahipidamisõiguse tasu alammäär on 10 eurot ja ülemmäär 25 eurot aastas.",
      "rdfs:label": {
        "@value": "KESKKO_3_Par_12_1 (redaktsioon 116052013013)",
