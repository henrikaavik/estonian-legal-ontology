      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KESKKO_3_Par_23_v122122018005",
      "@type": [
        "owl:NamedIndividual",
