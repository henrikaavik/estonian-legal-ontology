      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saastetasu rakendatakse, kui välisõhku heidetakse paiksest saasteallikast: vääveldioksiidi (SO2) või muid anorgaanilisi väävliühendeid; süsinikoksiidi (CO); süsinikdioksiidi (CO2); tahkeid osakesi; lämmastikoksiide või muid anorgaanilisi lämmastikuühendeid; lenduvaid orgaanilisi ühendeid; merkaptaane; raskmetalle või nende ühendeid.",
      "rdfs:label": {
        "@value": "KESKKO_3_Par_16 (redaktsioon 969301)",
        "@language": "et"
      },
