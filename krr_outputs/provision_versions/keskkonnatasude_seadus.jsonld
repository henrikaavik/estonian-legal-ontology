      ],
      "estleg:versionOf": {
        "@id": "estleg:KESKKO_3_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saasteainete väljutamisel paiksest heiteallikast välisõhku lubatust suuremas koguses kõrgendatakse käesoleva seaduse § 19 lõikes 1 sätestatud saastetasumäärasid: viis korda käesoleva seaduse § 19 lõike 1 punktides 2 ja 3 nimetatud saasteainete puhul; 10 korda käesoleva seaduse § 19 lõike 1 punktides 1 ja 4–6 nimetatud saasteainete puhul; 100 korda käesoleva seaduse § 19 lõike 1 punktis 7 nimetatud saasteainete puhul. (2) Kehtetu - (3) Kehtetu -",
      "rdfs:label": {
        "@value": "KESKKO_3_Par_23 (redaktsioon 122122018005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018005",
