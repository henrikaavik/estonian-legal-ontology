      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui keskkonnatasu maksja ei täida keskkonnatasu võla tasumise ajakava või ei tasu ajakava kehtimise perioodil tähtajaks oma keskkonnatasusid, on Keskkonnaametil õigus rakendada valikuliselt või koos järgmisi meetmeid: tunnistada keskkonnatasu võla tasumise ajatamise otsus kehtetuks; tunnistada käesoleva seaduse § 43 lõike 2 kohane intressimäära vähendamine kehtetuks; arvestada ajatatud keskkonnatasu summalt tagasiulatuvalt intressi käesoleva seaduse § 43 lõikes 1 kehtestatud määras.",
      "rdfs:label": {
        "@value": "KESKKO_3_Par_42 (redaktsioon 13118452)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13118452",
      "estleg:supersededByVersion": {
