      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saastetasu rakendatakse, kui välisõhku heidetakse paiksest saasteallikast: vääveldioksiidi (SO2) või muid anorgaanilisi väävliühendeid; süsinikoksiidi (CO); süsinikdioksiidi (CO2); tahkeid osakesi; lämmastikoksiide või muid anorgaanilisi lämmastikuühendeid; lenduvaid orgaanilisi ühendeid, välja arvatud metaani; merkaptaane; raskmetalle või nende ühendeid.",
      "rdfs:label": {
        "@value": "KESKKO_3_Par_16 (redaktsioon 12992533)",
