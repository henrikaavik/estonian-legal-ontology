      },
      "estleg:versionValidTo": {
        "@value": "2011-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KESKKO_3_Par_45_v114032011038",
      "@type": [
        "owl:NamedIndividual",
