      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KESKKO_3_Par_43_v110072020050",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
