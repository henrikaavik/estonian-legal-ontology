        "@value": "KESKKO_3_Par_57_1 (redaktsioon 110112016006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110112016006"
    },
    {
      "@id": "estleg:KESKKO_3_Par_57_2_v111062024009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KESKKO_3_Par_57_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maakasutussektoris talletatud süsinikuvaru säilitamiseks ja süsinikusidumise suurendamiseks ning metsaseaduse alusel metsa kaitseks ja säästvaks majandamiseks vajalikku tegevust rahastatakse Kliimaministeeriumi eelarvest vähemalt ulatuses, mis vastab riigieelarve koostamisele eelnenud aastal raadamisõiguse tasudest riigieelarvesse laekunud rahalisele mahule.",
      "rdfs:label": {
        "@value": "KESKKO_3_Par_57_2 (redaktsioon 111062024009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111062024009"
    },
    {
      "@id": "estleg:KESKKO_3_Par_58_v969301",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KESKKO_3_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnakasutusest riigieelarvesse laekuva raha sihtotstarbelist kasutamist korraldatakse projektipõhiselt keskkonnakaitse valdkondade rahastamise kaudu. (2) Kooskõlas Eesti keskkonnastrateegia ja keskkonnategevuskavaga kinnitab sihtasutuse nõukogu keskkonnaministri ettepanekul sihtotstarbeliselt rahastatavate keskkonnakaitse valdkondade nimekirja ja keskkonnakasutusest laekuva raha jagunemise proportsioonid valdkondade vahel.",
      "rdfs:label": {
        "@value": "KESKKO_3_Par_58 (redaktsioon 969301)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969301",
      "estleg:supersededByVersion": {
        "@id": "estleg:KESKKO_3_Par_58_v113032014038"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KESKKO_3_Par_58_v113032014038",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KESKKO_3_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnakasutusest riigieelarvesse laekuva raha sihtotstarbelist kasutamist korraldatakse projektipõhiselt keskkonnakaitse valdkondade rahastamise kaudu. (2) Kooskõlas Eesti keskkonnastrateegia ja keskkonnategevuskavaga kinnitab sihtasutuse nõukogu valdkonna eest vastutava ministri ettepanekul sihtotstarbeliselt rahastatavate keskkonnakaitse valdkondade nimekirja ja keskkonnakasutusest laekuva raha jagunemise proportsioonid valdkondade vahel.",
      "rdfs:label": {
        "@value": "KESKKO_3_Par_58 (redaktsioon 113032014038)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014038",
      "estleg:supersededByVersion": {
