    {
      "@id": "estleg:Reg_1033074_Par_20_v1033074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033074_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lasila looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 20. mai 2015. a käskkirjaga nr 469 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Lasila looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 20. mai 2015. a käskkirjaga nr 469 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1033074_Par_20 (redaktsioon 1033074)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033074",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033074",
      "estleg:sourceAct": "Lasila looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1033074 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033074_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033074_Par_21_v1033074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033074_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1033074_Par_21 (redaktsioon 1033074)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033074",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033074",
      "estleg:sourceAct": "Lasila looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1033074 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033074_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033074_Par_3_v1033074",
      "@type": [
        "owl:NamedIndividual",
