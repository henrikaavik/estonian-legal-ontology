    {
      "@id": "estleg:Reg_1033074_Par_12_v1033074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033074_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatiste püstitamine kaitseala tarbeks ning tehnovõrgu rajatiste püstitamine kaitsealal paikneva kinnistu tarbeks. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatiste püstitamine kaitseala tarbeks ning tehnovõrgu rajatiste püstitamine kaitsealal paikneva kinnistu tarbeks.",
      "rdfs:label": {
