    {
      "@id": "estleg:Reg_1033074_Par_10_v1033074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033074_Par_10"
