      },
      "estleg:versionValidFrom": {
        "@value": "2016-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1033074_Par_3 (redaktsioon 1033074)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033074",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1033074",
