  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_valisriigi_maksukohustuslasele_kaibemaksu_tagastamise_kord_j_t339681_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Välisriigi maksukohustuslasele käibemaksu tagastamise kord ja käibemaksu tagastamiseks esitatava taotluse vorm ja humanitaarabi korras kaupa eksportivale isikule käibemaksu tagastamise kord (17 versiooni)",
        "@language": "et"
      },
      "dc:source": "Välisriigi maksukohustuslasele käibemaksu tagastamise kord ja käibemaksu tagastamiseks esitatava taotluse vorm ja humanitaarabi korras kaupa eksportivale isikule käibemaksu tagastamise kord"
    },
    {
      "@id": "estleg:Reg_339681_Par_1_v339681",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339681_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teise liikmesriigi maksukohustuslasele tagastatakse tema asukohariigis toimuva ettevõtluse tarbeks kasutatava kauba importimisel või soetamisel või teenuse saamisel Eestis tasutud käibemaks käibemaksuseaduse § 35 lõikes 1 sätestatud juhul. RT I 2010-11-09 1 109112010001 2011-01-01 Teise liikmesriigi maksukohustuslasele tagastatakse tema asukohariigis toimuva ettevõtluse tarbeks kasutatava kauba importimisel või soetamisel või teenuse saamisel Eestis tasutud käibemaks käibemaksuseaduse § 35 lõikes 1 sätestatud juhul. 2 (2) Teise liikmesriigi maksukohustuslane esitab käibemaksu tagastamiseks taotluse ja muu teabe maksuhaldurile elektrooniliselt eesti või inglise keeles. Teise liikmesriigi maksukohustuslane esitab käibemaksu tagastamiseks taotluse ja muu teabe maksuhaldurile elektrooniliselt eesti või inglise keeles. 3 (3) Maksuhaldur saadab teated ja nõuded teise liikmesriigi maksukohustuslasele elektrooniliselt. Maksuhaldur saadab teated ja nõuded teise liikmesriigi maksukohustuslasele elektrooniliselt.",
      "rdfs:label": {
        "@value": "Reg_339681_Par_1 (redaktsioon 339681)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339681",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339681",
      "estleg:sourceAct": "Välisriigi maksukohustuslasele käibemaksu tagastamise kord ja käibemaksu tagastamiseks esitatava taotluse vorm ja humanitaarabi korras kaupa eksportivale isikule käibemaksu tagastamise kord",
      "estleg:provisionRef": "Reg_339681 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339681_Map"
      }
    },
    {
      "@id": "estleg:Reg_339681_Par_10_v339681",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339681_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliamet märgistab kõik talle esitatud arved ning imporditud kauba eest käibemaksu tasumist tõendavad dokumendid ja tagastab need ühendusevälise riigi maksukohustuslasele koos taotlusest tehtud koopiaga ühe kuu jooksul taotluse saamisest arvates. RT I 2012-11-28 3 128112012003 2012-12-01 Maksu- ja Tolliamet märgistab kõik talle esitatud arved ning imporditud kauba eest käibemaksu tasumist tõendavad dokumendid ja tagastab need ühendusevälise riigi maksukohustuslasele koos taotlusest tehtud koopiaga ühe kuu jooksul taotluse saamisest arvates.",
      "rdfs:label": {
        "@value": "Reg_339681_Par_10 (redaktsioon 339681)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339681",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339681",
      "estleg:sourceAct": "Välisriigi maksukohustuslasele käibemaksu tagastamise kord ja käibemaksu tagastamiseks esitatava taotluse vorm ja humanitaarabi korras kaupa eksportivale isikule käibemaksu tagastamise kord",
      "estleg:provisionRef": "Reg_339681 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339681_Map"
      }
    },
    {
      "@id": "estleg:Reg_339681_Par_11_v339681",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339681_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikule, kes ekspordib kauba humanitaarabi korras rahvusvahelisele organisatsioonile, välisriigi valitsusele, välisriigi kohalikule omavalitsusele või välisriigi valitsusvälisele organisatsioonile, tagastatakse Eestis kauba soetamisel või importimisel tasutud käibemaks. Isikule, kes ekspordib kauba humanitaarabi korras rahvusvahelisele organisatsioonile, välisriigi valitsusele, välisriigi kohalikule omavalitsusele või välisriigi valitsusvälisele organisatsioonile, tagastatakse Eestis kauba soetamisel või importimisel tasutud käibemaks.",
      "rdfs:label": {
        "@value": "Reg_339681_Par_11 (redaktsioon 339681)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339681",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339681",
      "estleg:sourceAct": "Välisriigi maksukohustuslasele käibemaksu tagastamise kord ja käibemaksu tagastamiseks esitatava taotluse vorm ja humanitaarabi korras kaupa eksportivale isikule käibemaksu tagastamise kord",
      "estleg:provisionRef": "Reg_339681 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339681_Map"
      }
    },
    {
      "@id": "estleg:Reg_339681_Par_12_v339681",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339681_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Humanitaarabi korras kauba eksportija esitab maksuhaldurile vabas vormis oma allkirjaga kinnitatud taotluse käibemaksu tagastamiseks kuue kuu jooksul kauba soetusest või importimisest arvates. Taotluses märgitakse, kellele ja kuhu käibemaks tagastatakse. Humanitaarabi korras kauba eksportija esitab maksuhaldurile vabas vormis oma allkirjaga kinnitatud taotluse käibemaksu tagastamiseks kuue kuu jooksul kauba soetusest või importimisest arvates. Taotluses märgitakse, kellele ja kuhu käibemaks tagastatakse.",
      "rdfs:label": {
        "@value": "Reg_339681_Par_12 (redaktsioon 339681)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339681",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339681",
      "estleg:sourceAct": "Välisriigi maksukohustuslasele käibemaksu tagastamise kord ja käibemaksu tagastamiseks esitatava taotluse vorm ja humanitaarabi korras kaupa eksportivale isikule käibemaksu tagastamise kord",
      "estleg:provisionRef": "Reg_339681 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339681_Map"
      }
    },
    {
      "@id": "estleg:Reg_339681_Par_13_v339681",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339681_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotlusele tuleb lisada: 1 1) «Käibemaksuseaduse» § 5 lõikes 5 nimetatud kauba eksporti tõendavad dokumendid; 2 2) «Käibemaksuseaduse» §-s 37 sätestatud nõuetele vastavad loetavad arved ja imporditud kauba eest käibemaksu tasumist tõendavad dokumendid. Taotlusele tuleb lisada: «Käibemaksuseaduse» § 5 lõikes 5 nimetatud kauba eksporti tõendavad dokumendid; «Käibemaksuseaduse» §-s 37 sätestatud nõuetele vastavad loetavad arved ja imporditud kauba eest käibemaksu tasumist tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_339681_Par_13 (redaktsioon 339681)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339681",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339681",
      "estleg:sourceAct": "Välisriigi maksukohustuslasele käibemaksu tagastamise kord ja käibemaksu tagastamiseks esitatava taotluse vorm ja humanitaarabi korras kaupa eksportivale isikule käibemaksu tagastamise kord",
      "estleg:provisionRef": "Reg_339681 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339681_Map"
      }
    },
    {
      "@id": "estleg:Reg_339681_Par_14_v339681",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339681_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuhaldur kontrollib taotluse ja sellele lisatud dokumentide vastavust käesoleva määruse §-s 11 nimetatud käibemaksu tagastamise tingimustele ning nende vastavuse korral tagastab tagasimaksmisele kuuluva summa kolme kuu jooksul taotluse ja käesoleva määruse §-s 13 nimetatud dokumentide saamisest arvates. Maksuhaldur kontrollib taotluse ja sellele lisatud dokumentide vastavust käesoleva määruse §-s 11 nimetatud käibemaksu tagastamise tingimustele ning nende vastavuse korral tagastab tagasimaksmisele kuuluva summa kolme kuu jooksul taotluse ja käesoleva määruse §-s 13 nimetatud dokumentide saamisest arvates.",
      "rdfs:label": {
        "@value": "Reg_339681_Par_14 (redaktsioon 339681)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339681",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339681",
      "estleg:sourceAct": "Välisriigi maksukohustuslasele käibemaksu tagastamise kord ja käibemaksu tagastamiseks esitatava taotluse vorm ja humanitaarabi korras kaupa eksportivale isikule käibemaksu tagastamise kord",
      "estleg:provisionRef": "Reg_339681 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339681_Map"
      }
    },
    {
      "@id": "estleg:Reg_339681_Par_15_v339681",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339681_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksuhaldur märgistab kõik talle esitatud arved, imporditud kauba eest käibemaksu tasumist tõendavad dokumendid ja kauba eksporti tõendavad dokumendid ning tagastab need kauba eksportijale koos taotlusest tehtud koopiaga ühe kuu jooksul taotluse saamisest arvates. Maksuhaldur märgistab kõik talle esitatud arved, imporditud kauba eest käibemaksu tasumist tõendavad dokumendid ja kauba eksporti tõendavad dokumendid ning tagastab need kauba eksportijale koos taotlusest tehtud koopiaga ühe kuu jooksul taotluse saamisest arvates.",
      "rdfs:label": {
        "@value": "Reg_339681_Par_15 (redaktsioon 339681)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339681",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339681",
      "estleg:sourceAct": "Välisriigi maksukohustuslasele käibemaksu tagastamise kord ja käibemaksu tagastamiseks esitatava taotluse vorm ja humanitaarabi korras kaupa eksportivale isikule käibemaksu tagastamise kord",
      "estleg:provisionRef": "Reg_339681 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339681_Map"
      }
    },
