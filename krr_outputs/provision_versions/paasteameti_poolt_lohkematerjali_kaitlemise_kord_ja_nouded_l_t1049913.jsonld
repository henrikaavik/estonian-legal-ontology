    {
      "@id": "estleg:Reg_1049913_Par_7_v1049913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049913_Par_7"
