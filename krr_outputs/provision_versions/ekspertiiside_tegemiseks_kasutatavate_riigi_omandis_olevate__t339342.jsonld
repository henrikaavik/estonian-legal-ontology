    },
    {
      "@id": "estleg:Reg_339342_Par_16_v339342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339342_Par_16"
