        "@type": "xsd:date"
      },
      "estleg:versionText": "Munakanade paiknemistihedus alternatiivmeetodil pidamisel on kuni üheksa munakana 1 m2 kasutatava pinna kohta. Munakanade paiknemistihedus alternatiivmeetodil pidamisel on kuni üheksa munakana 1 m2 kasutatava pinna kohta.",
      "rdfs:label": {
        "@value": "Reg_156615_Par_14 (redaktsioon 156615)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156615",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156615",
      "estleg:sourceAct": "Nõuded kanade pidamisele ja selleks ettenähtud ruumile või ehitisele",
      "estleg:provisionRef": "Reg_156615 § 14",
