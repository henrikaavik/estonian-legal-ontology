      }
    },
    {
      "@id": "estleg:Reg_156615_Par_15_v156615",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156615_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui munakanasid peetakse meetodil, mille puhul nad saavad vabalt liikuda eri tasapindade vahel, tuleb lisaks §-des 12–14 sätestatule järgida järgmisi nõudeid: 1 1) ülestikuseid tasapindu võib olla kuni neli; 2 2) tasapindade vaheline kõrgus peab olema vähemalt 45 cm; 3 3) jooturid ja sööturid tuleb paigutada nii, et kõikidel kanadel oleks võimalik nende juurde pääseda; 4 4) tasapinnad peavad olema paigutatud nii, et oleks välditud väljaheidete kukkumine madalamatele tasapindadele. Kui munakanasid peetakse meetodil, mille puhul nad saavad vabalt liikuda eri tasapindade vahel, tuleb lisaks §-des 12–14 sätestatule järgida järgmisi nõudeid: ülestikuseid tasapindu võib olla kuni neli; tasapindade vaheline kõrgus peab olema vähemalt 45 cm; jooturid ja sööturid tuleb paigutada nii, et kõikidel kanadel oleks võimalik nende juurde pääseda; tasapinnad peavad olema paigutatud nii, et oleks välditud väljaheidete kukkumine madalamatele tasapindadele.",
      "rdfs:label": {
        "@value": "Reg_156615_Par_15 (redaktsioon 156615)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156615",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156615",
      "estleg:sourceAct": "Nõuded kanade pidamisele ja selleks ettenähtud ruumile või ehitisele",
      "estleg:provisionRef": "Reg_156615 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156615_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156615_Par_16_v156615",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156615_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui munakanasid peetakse meetodil, mille puhul neil on vaba pääs jooksuaeda, tuleb lisaks §-des 12–14 sätestatule järgida järgmisi nõudeid: 1 1) peab olema mitu vähemalt 35 cm kõrgust ja 40 cm laiust käiguava, mis paiknevad ruumi või ehitise kogu pikkuses ja võimaldavad pääseda otse jooksuaeda; 1000 kanast koosneva rühma käiguavade laius kokku peab olema vähemalt 2 m; 2 2) jooksuaedade põhi peab olema sobiva pinnasega, et vältida saastumist; 3 3) jooksuaedades peavad munakanad olema kaitstud ebasoodsate ilmastikuolude ja kiskjate eest; 4 4) vajaduse korral peavad jooksuaiad olema varustatud sobivate jooturitega. Kui munakanasid peetakse meetodil, mille puhul neil on vaba pääs jooksuaeda, tuleb lisaks §-des 12–14 sätestatule järgida järgmisi nõudeid: peab olema mitu vähemalt 35 cm kõrgust ja 40 cm laiust käiguava, mis paiknevad ruumi või ehitise kogu pikkuses ja võimaldavad pääseda otse jooksuaeda; 1000 kanast koosneva rühma käiguavade laius kokku peab olema vähemalt 2 m; jooksuaedade põhi peab olema sobiva pinnasega, et vältida saastumist; jooksuaedades peavad munakanad olema kaitstud ebasoodsate ilmastikuolude ja kiskjate eest; vajaduse korral peavad jooksuaiad olema varustatud sobivate jooturitega.",
      "rdfs:label": {
        "@value": "Reg_156615_Par_16 (redaktsioon 156615)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156615",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156615",
      "estleg:sourceAct": "Nõuded kanade pidamisele ja selleks ettenähtud ruumile või ehitisele",
      "estleg:provisionRef": "Reg_156615 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156615_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156615_Par_17_v156615",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
