      "estleg:versionValidFrom": {
        "@value": "2021-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kanatibude ja noorkanade jootmiseks kasutatakse nippeljootureid, siis peab jooturil olema piisavalt nipleid, et rahuldada kanatibude ja noorkanade veevajadust. Kui kanatibude ja noorkanade jootmiseks kasutatakse nippeljootureid, siis peab jooturil olema piisavalt nipleid, et rahuldada kanatibude ja noorkanade veevajadust.",
      "rdfs:label": {
        "@value": "Reg_156615_Par_20 (redaktsioon 156615)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156615",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156615",
      "estleg:sourceAct": "Nõuded kanade pidamisele ja selleks ettenähtud ruumile või ehitisele",
      "estleg:provisionRef": "Reg_156615 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156615_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156615_Par_21_v156615",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156615_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Broilerite pidamise ruumis või ehitises peab olema sobiv allapanu. Broilerite pidamise ruumis või ehitises peab olema sobiv allapanu. 2 (2) Broilerite jaoks peab olema saadaval piisavalt sööta ja joogivett. Broilerite jaoks peab olema saadaval piisavalt sööta ja joogivett. 3 (3) Broilerite sööda puhul tuleb erilist tähelepanu pöörata mineraalainete sisaldusele, et vältida broileritel liigese- ja luuhäirete väljakujunemist. Broilerite sööda puhul tuleb erilist tähelepanu pöörata mineraalainete sisaldusele, et vältida broileritel liigese- ja luuhäirete väljakujunemist. 4 (4) Jootmis- ja söötmisseadmete kõrgust tuleb reguleerida vastavalt broilerite kasvamisele nii, et kõik linnud saaksid neid kasutada. Jootmis- ja söötmisseadmete kõrgust tuleb reguleerida vastavalt broilerite kasvamisele nii, et kõik linnud saaksid neid kasutada.",
      "rdfs:label": {
        "@value": "Reg_156615_Par_21 (redaktsioon 156615)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156615",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156615",
      "estleg:sourceAct": "Nõuded kanade pidamisele ja selleks ettenähtud ruumile või ehitisele",
      "estleg:provisionRef": "Reg_156615 § 21",
