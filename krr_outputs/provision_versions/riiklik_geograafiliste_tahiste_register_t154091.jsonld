    {
      "@id": "estleg:Reg_154091_Par_18_v154091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154091_Par_18"
