    },
    {
      "@id": "estleg:Reg_305859_Par_2_v305859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305859_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Kaitse alla võetakse järgmised nahkhiirte püsielupaigad:11)Vääna-Viti Harku vallas Viti külas;22)Vääna-Posti Saue vallas Kiia külas;33)Laagri Saue vallas Laagri alevikus ja Saku vallas Tänassilma külas. Kaitse alla võetakse järgmised nahkhiirte püsielupaigad: Vääna-Viti Harku vallas Viti külas; Vääna-Posti Saue vallas Kiia külas; Laagri Saue vallas Laagri alevikus ja Saku vallas Tänassilma külas. 2(2)Nahkhiirte püsielupaikade ja nende vööndite piirid on märgitud määruse lisas olevatele kaartidele2. Nahkhiirte püsielupaikade ja nende vööndite piirid on märgitud määruse lisas olevatele kaartidele2.",
      "rdfs:label": {
        "@value": "Reg_305859_Par_2 (redaktsioon 305859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305859",
