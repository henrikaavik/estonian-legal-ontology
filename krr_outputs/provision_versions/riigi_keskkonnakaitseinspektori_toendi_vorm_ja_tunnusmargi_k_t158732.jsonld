        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus sätestab riigi keskkonnakaitseinspektori tõendi vormi ja tunnusmärgi kujunduse ning tõendi ja tunnusmärgi valmistamise, väljaandmise ja tagastamise korra. Määrus sätestab riigi keskkonnakaitseinspektori tõendi vormi ja tunnusmärgi kujunduse ning tõendi ja tunnusmärgi valmistamise, väljaandmise ja tagastamise korra.",
      "rdfs:label": {
        "@value": "Reg_158732_Par_1 (redaktsioon 158732)",
        "@language": "et"
      },
