      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigi keskkonnakaitseinspektori tõendi vorm ja tunnusmärgi kujundus ning tõendi ja tunnusmärgi valmistamise, väljaandmise ja tagastamise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigi keskkonnakaitseinspektori tõendi vorm ja tunnusmärgi kujundus ning tõendi ja tunnusmärgi valmistamise, väljaandmise ja tagastamise kord"
    },
    {
      "@id": "estleg:Reg_158732_Par_1_v158732",
