    {
      "@id": "estleg:Reg_303518_Par_13_v303518",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303518_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse 2025. aasta 1. märtsil jõustunud muudatus ei mõjuta varem kehtestatud alkoholi maksumärgi kehtivust. RT I 2024-12-21 6 121122024006 2025-03-01 Määruse 2025. aasta 1. märtsil jõustunud muudatus ei mõjuta varem kehtestatud alkoholi maksumärgi kehtivust.",
