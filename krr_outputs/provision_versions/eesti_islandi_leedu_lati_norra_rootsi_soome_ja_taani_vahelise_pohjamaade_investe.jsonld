      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti, Islandi, Leedu, Läti, Norra, Rootsi, Soome ja Taani vahelise Põhjamaade Investeerimispanka käsitleva lepingu ning Eesti Vabariigi ja Põhjamaade Investeerimispanga makselepingu ratifitseerimise seadus (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti, Islandi, Leedu, Läti, Norra, Rootsi, Soome ja Taani vahelise Põhjamaade Investeerimispanka käsitleva lepingu ning Eesti Vabariigi ja Põhjamaade Investeerimispanga makselepingu ratifitseerimise seadus"
    },
    {
      "@id": "estleg:EILLNRSTPIKL_Par_2_v822085",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EILLNRSTPIKL_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-11-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põhjamaade Investeerimispanga juhatajate nõukogus on Eesti esindaja valdkonna eest vastutav minister. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"rahandusminister\" sõnadega \"valdkonna eest vastutav minister\". (2) Põhjamaade Investeerimispanga direktorite nõukogusse nimetatakse Eesti esindaja ja tema asetäitja valdkonna eest vastutava ministri käskkirjaga. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"rahandusministri\" sõnadega \"valdkonna eest vastutava ministri\". (3) Põhjamaade Investeerimispanga kontrollkomiteesse nimetatakse Eesti esindaja Riigikogu otsusega.",
      "rdfs:label": {
        "@value": "EILLNRSTPIKL_Par_2 (redaktsioon 822085)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "822085",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/822085",
      "estleg:sourceAct": "Eesti, Islandi, Leedu, Läti, Norra, Rootsi, Soome ja Taani vahelise Põhjamaade Investeerimispanka käsitleva lepingu ning Eesti Vabariigi ja Põhjamaade Investeerimispanga makselepingu ratifitseerimise seadus",
      "estleg:provisionRef": "EILLNRSTPIKL § 2",
      "estleg:partOfAct": {
        "@id": "estleg:EILLNRSTPIKL_Map"
      }
    },
    {
      "@id": "estleg:EILLNRSTPIKL_Par_3_v822085",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EILLNRSTPIKL_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-11-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub Riigi Teatajas avaldamisele järgneval päeval.",
