      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Hasartmängumaksu deklaratsioonide vormid ja nende täitmise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Hasartmängumaksu deklaratsioonide vormid ja nende täitmise kord"
    },
    {
      "@id": "estleg:Reg_1026796_Par_1_v1026796",
