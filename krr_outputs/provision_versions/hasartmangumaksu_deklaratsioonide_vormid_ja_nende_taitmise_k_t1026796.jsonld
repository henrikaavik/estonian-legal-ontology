      "estleg:provisionRef": "Reg_1026796 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026796_Map"
      }
    },
    {
      "@id": "estleg:Reg_1026796_Par_2_v1026796",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026796_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui hasartmängukorraldaja korraldab õnnemängu, osavusmängu või totot mitmes mängukohas, täidetakse deklaratsioonil iga mängukoha kohta üks rida. Kui hasartmängukorraldaja korraldab õnnemängu, osavusmängu või totot mitmes mängukohas, täidetakse deklaratsioonil iga mängukoha kohta üks rida. 2 (2) Tasumisele kuuluv maksusumma esitatakse eurodes sendi täpsusega. Tasumisele kuuluv maksusumma esitatakse eurodes sendi täpsusega.",
      "rdfs:label": {
        "@value": "Reg_1026796_Par_2 (redaktsioon 1026796)",
        "@language": "et"
      },
