        "@value": "2004-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KMSK_Par_8 (redaktsioon 738268)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "738268"
    },
    {
      "@id": "estleg:KMSK_Par_8_1_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_8_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meretransporditeenust ja laevade agenteerimise teenust võib osutada selleks Veeteede Ametilt tegevusloa saanud ettevõtja. Tegevusloa võib anda: Eesti kodanikule või isikule, kellel on Eestis alaline elamisluba; Eestis registreeritud äriühingule; Eestis registreeritud välisriigi äriühingu filiaalile. Ettevõtjale antakse tegevusluba, kui: tema tegevusala on seotud meretransporditeenuse või laevade agenteerimise teenuse osutamisega; tal on tehnilised võimalused ja vajaliku oskusega personal ning tema tegevus ei tekita kahju keskkonnale ega ohusta inimeste tervist. Tegevusloa saamiseks esitab ettevõtja Veeteede Ametile taotluse, milles sisalduvad järgmised andmed: ärinimi; aadress ja asukoht; sidevahendite numbrid; äriregistri kood. Tegevusloa saamiseks esitatavale taotlusele lisatakse: kehtiva äriregistrikaardi koopia või äriregistrisse kandmata füüsilisest isikust ettevõtja puhul Maksuameti tõend; Maksuameti kohaliku asutuse õiend maksuvõlgnevuse puudumise kohta; riigilõivu tasumist tõendav dokument; ettevõtja töötajate kvalifikatsiooni tõendavate dokumentide (diplomid, tunnistused ja muu selline) koopiad. Veeteede Amet annab taotlejale tegevusloa või teeb otsuse tegevusloa andmisest keeldumise kohta 14 tööpäeva jooksul käesoleva paragrahvi neljandas ja viiendas lõigus nimetatud dokumentide esitamisest arvates. Tegevusluba antakse viieks aastaks. Tegevusloa vormi kehtestab teede- ja sideminister.",
      "rdfs:label": {
        "@value": "KMSK_Par_8_1 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_8_1_v694769"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_8_1_v694769",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_8_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meretransporditeenust ja laevade agenteerimise teenust võib osutada selleks Veeteede Ametilt tegevusloa saanud ettevõtja. Tegevusloa võib anda: Eesti kodanikule või isikule, kellel on Eestis alaline elamisluba; Eestis registreeritud äriühingule; Eestis registreeritud välisriigi äriühingu filiaalile. Ettevõtjale antakse tegevusluba, kui: tema tegevusala on seotud meretransporditeenuse või laevade agenteerimise teenuse osutamisega; tal on tehnilised võimalused ja vajaliku oskusega personal ning tema tegevus ei tekita kahju keskkonnale ega ohusta inimeste tervist. Tegevusloa saamiseks esitab ettevõtja Veeteede Ametile taotluse, milles sisalduvad järgmised andmed: ärinimi; aadress ja asukoht; sidevahendite numbrid; äriregistri kood. Tegevusloa saamiseks esitatavale taotlusele lisatakse: kehtiva äriregistrikaardi koopia või äriregistrisse kandmata füüsilisest isikust ettevõtja puhul Maksuameti tõend; Maksuameti kohaliku asutuse õiend maksuvõlgnevuse puudumise kohta; riigilõivu tasumist tõendav dokument; ettevõtja töötajate kvalifikatsiooni tõendavate dokumentide (diplomid, tunnistused ja muu selline) koopiad. Veeteede Amet annab taotlejale tegevusloa või teeb otsuse tegevusloa andmisest keeldumise kohta 14 tööpäeva jooksul käesoleva paragrahvi neljandas ja viiendas lõigus nimetatud dokumentide esitamisest arvates. Tegevusluba antakse viieks aastaks. Tegevusloa vormi kehtestab majandus- ja kommunikatsiooniminister.",
      "rdfs:label": {
        "@value": "KMSK_Par_8_1 (redaktsioon 694769)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "694769",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_8_1_v908738"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_8_1_v908738",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_8_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meretransporditeenust ja laevade agenteerimise teenust võib osutada selleks Veeteede Ametilt tegevusloa saanud ettevõtja. Tegevusloa võib anda: Eesti kodanikule või isikule, kellel on Eestis alaline elamisluba; Eestis registreeritud äriühingule; Eestis registreeritud välisriigi äriühingu filiaalile. Ettevõtjale antakse tegevusluba, kui: tema tegevusalaks on meretranspordi korraldamine või laevade agenteerimine; tal on tehnilised võimalused ja vajaliku oskusega personal ning tema tegevus ei tekita kahju keskkonnale ega ohusta inimeste tervist; tal ei ole maksu-, tuletornitasu- ega navigatsioonitasuvõlga; ta on tasunud riigilõivu. Tegevusloa saamiseks esitab ettevõtja Veeteede Ametile taotluse, milles sisalduvad järgmised andmed: ärinimi; aadress ja asukoht; sidevahendite numbrid; äriregistri kood. Tegevusloa saamiseks esitatavale taotlusele lisatakse: kehtiva äriregistrikaardi koopia või äriregistrisse kandmata füüsilisest isikust ettevõtja puhul Maksu- ja Tolliameti tõend; Maksu- ja Tolliameti piirkondliku maksukeskuse õiend maksuvõlgnevuse puudumise kohta; riigilõivu tasumist tõendav dokument; ettevõtja töötajate kvalifikatsiooni tõendavate dokumentide (diplomid, tunnistused ja muu selline) koopiad. Veeteede Amet annab taotlejale tegevusloa või teeb otsuse tegevusloa andmisest keeldumise kohta 14 tööpäeva jooksul käesoleva paragrahvi neljandas ja viiendas lõigus nimetatud dokumentide esitamisest arvates. Tegevusluba antakse viieks aastaks. Tegevusloa vormi",
      "rdfs:label": {
        "@value": "KMSK_Par_8_1 (redaktsioon 908738)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908738",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_8_1_v1027899"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_8_1_v1027899",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
