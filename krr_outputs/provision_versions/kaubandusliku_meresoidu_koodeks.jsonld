    {
      "@id": "estleg:KMSK_Par_57_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapere liikme ja laevaomaniku vahelisi töösuhteid reguleerivad mereteenistuse seadus ja tööseadused.",
      "rdfs:label": {
        "@value": "KMSK_Par_57 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_57_v129062014111"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_57_v129062014111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapere liikme ja laevaomaniku vahelisi töösuhteid reguleerivad meretöö seadus ja teised töösuhet reguleerivad õigusaktid.",
      "rdfs:label": {
        "@value": "KMSK_Par_57 (redaktsioon 129062014111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014111"
    },
    {
      "@id": "estleg:KMSK_Par_58_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühtki laevapere liiget ei saa kapteni nõusolekuta laevale määrata.",
      "rdfs:label": {
        "@value": "KMSK_Par_58 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_59_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaptenil on õigus laevapere liikmete suhtes kasutada ergutusvahendeid ja määrata distsiplinaarkaristusi. Vajaduse korral on kaptenil õigus kõrvaldada tööülesannete täitmisest laevapere iga liige.",
      "rdfs:label": {
        "@value": "KMSK_Par_59 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_59_v129062014111"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_59_v129062014111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vajaduse korral on kaptenil õigus kõrvaldada tööülesannete täitmisest laevapere iga liige.",
      "rdfs:label": {
        "@value": "KMSK_Par_59 (redaktsioon 129062014111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014111"
    },
    {
      "@id": "estleg:KMSK_Par_6_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teede- ja Sideministeerium kavandab ja viib ellu merenduse arengu ja meresõidu ohutuse poliitikat. 1. Vabariigi Valitsus või tema volitusel teede- ja sideminister kehtestab oma määrusega: [kehtetud] [punkt 13 jõustub alates 01.01.2003] tuletorni- ja jäämurdetasude määrad ning soodustuste kohaldamise alused ja korra; - Riigikohtu 20.10.2009. a põhiseaduslikkuse järelevalve kolleegiumi kohtuotsus nr 3-4-1-14-09 tunnistab § 6 punkti 1 alapunkti 13 24. aprillini 2004 kehtinud redaktsioonis põhiseadusega vastuolus olnuks, muutmismärge lisatud 29.10.2009. [kehtetu] 2. Veeteede Ameti pädevusse kuulub: tegevuslubade väljastamine meretranspordi korraldamiseks ja laevade agenteerimiseks; [kehtetud] merre uppunud vara ülestõstmise korraldamine juhul, kui see segab laevaliiklust; järelevalve kaubanduslikku meresõitu reguleerivate õigusaktide, sealhulgas Rahvusvahelise Mereorganisatsiooni (IMO) konventsioonide, millega Eesti Vabariik on ühinenud, koodeksite, resolutsioonide ja ringkirjade täitmise üle; [kehtetud] merepäästeoperatsioonides, mereotsingutes, inimelude päästmises, merereostuse likvideerimises osalemine; [kehtetu]",
      "rdfs:label": {
        "@value": "KMSK_Par_6 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_6_v694769"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_6_v694769",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandus- ja Kommunikatsiooniministeerium kavandab ja viib ellu merenduse arengu ja meresõidu ohutuse poliitikat. 1. Vabariigi Valitsus või tema volitusel majandus- ja kommunikatsiooniminister kehtestab oma määrusega: [kehtetud] tuletorni- ja jäämurdetasude määrad ning soodustuste kohaldamise alused ja korra; - Riigikohtu 20.10.2009. a põhiseaduslikkuse järelevalve kolleegiumi kohtuotsus nr 3-4-1-14-09 tunnistab § 6 punkti 1 alapunkti 13 24. aprillini 2004 kehtinud redaktsioonis põhiseadusega vastuolus olnuks, muutmismärge lisatud 29.10.2009. [kehtetu] 2. Veeteede Ameti pädevusse kuulub: tegevuslubade väljastamine meretranspordi korraldamiseks ja laevade agenteerimiseks; [kehtetud] merre uppunud vara ülestõstmise korraldamine juhul, kui see segab laevaliiklust; järelevalve kaubanduslikku meresõitu reguleerivate õigusaktide, sealhulgas Rahvusvahelise Mereorganisatsiooni (IMO) konventsioonide, millega Eesti Vabariik on ühinenud, koodeksite, resolutsioonide ja ringkirjade täitmise üle; [kehtetud] merepäästeoperatsioonides, mereotsingutes, inimelude päästmises, merereostuse likvideerimises osalemine; [kehtetu]",
      "rdfs:label": {
        "@value": "KMSK_Par_6 (redaktsioon 694769)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "694769",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_6_v738268"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-24",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_6_v738268",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_6"
      },
      "estleg:versionValidFrom": {
