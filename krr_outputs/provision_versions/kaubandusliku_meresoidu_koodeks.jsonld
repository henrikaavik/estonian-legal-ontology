      }
    },
    {
      "@id": "estleg:KMSK_Par_15_v738268",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KMSK_Par_15 (redaktsioon 738268)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "738268"
    },
    {
      "@id": "estleg:KMSK_Par_16_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapere õiguslik seisund, sealhulgas ka suhted laevapere liikmete vahel, mis seonduvad laeva ekspluatatsiooniga, määratakse kindlaks laeva lipuriigi seadustikuga. Laevapere liikmete ja laevaomaniku vahelisi suhteid reguleerib laeva lipuriigi seadustik, kui nendevahelise lepinguga ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KMSK_Par_16 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_16_v129062014111"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_16_v129062014111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapere liikmete ja laevaomaniku vahelisi suhteid reguleerib laeva lipuriigi seadustik, kui nendevahelise lepinguga ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KMSK_Par_16 (redaktsioon 129062014111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014111"
    },
    {
      "@id": "estleg:KMSK_Par_17_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguse sisemerre või territoriaalmerre uppunud varale (laevad, laevade riismed, seadmed, last jne.), samuti seoses selle varaga tekkivad suhted määratakse selle riigi seadustikuga, kus see vara asub. Avamerre uppunud laeva, temal oleva lasti ja teiste esemete kohta kohaldatakse laeva lipuriigi seadustikku.",
      "rdfs:label": {
        "@value": "KMSK_Par_17 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_17_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_17_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguse sisemerre või territoriaalmerre uppunud varale (laevad, laevade riismed, seadmed, last jne.), samuti seoses selle varaga tekkivad suhted määratakse selle riigi seadustikuga, kus see vara asub. Avamerre uppunud laeva, temal oleva lasti ja teiste esemete kohta kohaldatakse laeva lipuriigi seadustikku. Paragrahv 17 kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_17 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_178_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_178"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metsamaterjali pukseerimisel parvedes käesoleva koodeksi paragrahvide 135, 145, 146-153, 174 ja 177 sätteid ei kohaldata.",
      "rdfs:label": {
        "@value": "KMSK_Par_178 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_178_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_178_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_178"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metsamaterjali pukseerimisel parvedes käesoleva koodeksi paragrahvide 135, 145, 146–153, 174 ja 177 sätteid ei kohaldata. [Peatükk IX kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_178 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_179_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_179"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mere-reisijateveolepingu järgi kohustub vedaja reisija viima sihtsadamasse, juhul aga, kui reisija annab vedajale üle pagasi, siis viima ka pagasi sihtsadamasse ja selle välja andma pagasi saamiseks õigustatud isikule; reisija kohustub maksma ettenähtud sõiduraha, pagasi äraandmise korral aga ka pagasiraha. Mere-reisijatevedu hõlmab reisija laeval viibimise, laevale pealemineku ja laevalt mahatuleku aja, samuti reisija kaldalt laevale ja tagasi toimetamise aja, kui kohaletoimetamise tasu oli piletihinna sisse arvatud või kui kohaletoimetamiseks kasutatava laeva andis vedaja.",
      "rdfs:label": {
        "@value": "KMSK_Par_179 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_189_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_189"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vedaja vastutab: avaldatud väärtusega vastuvõetud pagasi puudujäägi, vigastuse või riknemise eest avaldatud väärtuse ulatuses, juhul aga kui vedaja tõendab, et avaldatud väärtus ületab tegeliku maksumuse, siis tegeliku maksumuse ulatuses; avaldamata väärtusega vastuvõetud pagasi puudujäägi, vigastuse või riknemise eest tegeliku maksumuse ulatuses, kuid mitte üle Eesti Vabariigi Valitsuse poolt kehtestatud piirmaksumuse; pagasi hilinenud kohaletoimetamise eest tariifis ettenähtud ulatuses. Vedaja hüvitab pagasi puudujäägi ja tagastab puudujäänud pagasi eest võetud pagasiraha. Käesoleva paragrahvi punktis 2 sätestatud vastutuse piiri ei kasutata, kui tõestatakse, et kahju tekkis vedaja tahtlusest või raskest ettevaatamatusest.",
      "rdfs:label": {
        "@value": "KMSK_Par_189 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_189_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_189_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_189"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vedaja vastutab: avaldatud väärtusega vastuvõetud pagasi puudujäägi, vigastuse või riknemise eest avaldatud väärtuse ulatuses, juhul aga kui vedaja tõendab, et avaldatud väärtus ületab tegeliku maksumuse, siis tegeliku maksumuse ulatuses; avaldamata väärtusega vastuvõetud pagasi puudujäägi, vigastuse või riknemise eest tegeliku maksumuse ulatuses, kuid mitte üle Eesti Vabariigi Valitsuse poolt kehtestatud piirmaksumuse; pagasi hilinenud kohaletoimetamise eest tariifis ettenähtud ulatuses. Vedaja hüvitab pagasi puudujäägi ja tagastab puudujäänud pagasi eest võetud pagasiraha. Käesoleva paragrahvi punktis 2 sätestatud vastutuse piiri ei kasutata, kui tõestatakse, et kahju tekkis vedaja tahtlusest või raskest ettevaatamatusest. [Peatükk X kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_189 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_190_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_190"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Merematke lepingu järgi kohustub üks pool – merematke organiseerija – korraldama kindla programmiga kollektiivse huvireisi laeval (merematke) ja osutama merematkes osalejale kõiki asjakohaseid (merevedu, toitlustamine, olme- ja ekskursiooniteenindamine jne.) teenuseid; teine pool – merematkes osaleja – kohustub maksma kindlaksmääratud tasu. Merematke organiseerija kohustub järgima merematke korraldamisel ja teostamisel käesoleva koodeksi paragrahvi 182 nõudeid.",
      "rdfs:label": {
        "@value": "KMSK_Par_190 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_196_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_196"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Merematke organiseerija vastutab kahju eest, mis tekitatakse merematkes osalejale seoses surma või tervisekahjustusega, aga samuti tema pagasi ja käsipakkide puudujäägi, vigastuse või riknemise läbi, vastavuses käesoleva koodeksi paragrahvidega 186 (esimene lõik), 188 ja 189.",
      "rdfs:label": {
        "@value": "KMSK_Par_196 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_196_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_196_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_196"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Merematke organiseerija vastutab kahju eest, mis tekitatakse merematkes osalejale seoses surma või tervisekahjustusega, aga samuti tema pagasi ja käsipakkide puudujäägi, vigastuse või riknemise läbi, vastavuses käesoleva koodeksi paragrahvidega 186 (esimene lõik), 188 ja 189. [Peatükk XI kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_196 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_197_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_197"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva tähtajalisel prahtimisel on laevaomanik kohustatud andma laeva kokkulepitud tasu (prahiraha) eest prahtijale kindlaks ajavahemikuks lasti- või reisijateveoks või muudeks kaubandusliku meresõidu eesmärkideks. Prahtija käsutusse antud laev võib olla komplekteeritud laevaperega või olla varustuseta ja laevaperega komplekteerimata (laeva prahtimine ilma laevapereta).",
      "rdfs:label": {
        "@value": "KMSK_Par_197 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_2_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaubandusliku meresõidu all mõistetakse käesolevas koodeksis tegevust, mis on seotud laevade kasutamisega lasti-, reisijate-, pagasi- ja postiveoks, kalapüügiks ja muuks meretöönduseks, maapõuevarade uurimiseks ja kaevandamiseks, pukseerimis-, jäämurde- ja päästeoperatsioonideks, samuti teistel majandus-, teadus- ja kultuurialastel eesmärkidel.",
      "rdfs:label": {
        "@value": "KMSK_Par_2 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_2_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_2_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaubandusliku meresõidu all mõistetakse käesolevas koodeksis tegevust, mis on seotud laevade kasutamisega lasti-, reisijate-, pagasi- ja postiveoks, kalapüügiks ja muuks meretöönduseks, maapõuevarade uurimiseks ja kaevandamiseks, pukseerimis-, jäämurde- ja päästeoperatsioonideks, samuti teistel majandus-, teadus- ja kultuurialastel eesmärkidel. Paragrahv 2 kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_2 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_2_v13187940"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_2_v13187940",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "KMSK_Par_2 (redaktsioon 13187940)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13187940"
    },
    {
      "@id": "estleg:KMSK_Par_208_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_208"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taim-tšarteri alusel prahitud laevale kuuluv päästetasu abi eest, mis osutati enne taim-tšarteri lõppu, jaotatakse võrdsetes osades laevaomaniku ja prahtija vahel, arvates maha summad, mis lähevad laeva kahjude hüvitamiseks, ja see osa, mis kuulub laevaperele. Ilma laevapereta prahitud laevale kuuluv päästetasu abi eest, mis osutati enne laeva tähtajalise prahtimise lõppu, kuulub prahtijale.",
      "rdfs:label": {
        "@value": "KMSK_Par_208 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_208_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_208_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_208"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taim-tšarteri alusel prahitud laevale kuuluv päästetasu abi eest, mis osutati enne taim-tšarteri lõppu, jaotatakse võrdsetes osades laevaomaniku ja prahtija vahel, arvates maha summad, mis lähevad laeva kahjude hüvitamiseks, ja see osa, mis kuulub laevaperele. Ilma laevapereta prahitud laevale kuuluv päästetasu abi eest, mis osutati enne laeva tähtajalise prahtimise lõppu, kuulub prahtijale. [Peatükk XII kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_208 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_209_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_209"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva liisingulepingu järgi kohustub liisinguandja andma laeva liisinguvõtjale ilma laevapereta kasutamiseks kaubanduslikuks meresõiduks kindlaks ajavahemikuks, mille lõppedes läheb laeva omandiõigus üle liisinguvõtjale. Liisinguvõtja kohustub maksma liisingutasu, mis koosneb tasust laeva kasutamise eest ja ostu-müügi hinnast. Liisingulepingu võib sõlmida vaid kooskõlas käesoleva koodeksi paragrahviga 34.",
      "rdfs:label": {
        "@value": "KMSK_Par_209 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_216_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva tagastamisel on liisinguandjal õigus osale liisingutasust laeva kasutamisaja eest. Sissemaksed, mida liisinguvõtja oli teinud laeva ostuhinna arvel, tagastatakse liisinguvõtjale. Liisinguvõtja kohustub tagastama laeva sellises seisukorras, nagu see oli ülevõtmisel, võttes arvesse normaalse kulumi. Laeva seisukorra halvenemisel hüvitab liisinguvõtja liisinguandjale tekitatud kahju. Liisinguvõtja poolt laevale pandud lisandid, mida on võimalik eraldada, võib liisinguvõtja laevalt maha võtta, kui liisinguandja ei nõustu nende eest tasuma.",
      "rdfs:label": {
        "@value": "KMSK_Par_216 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_216_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_216_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva tagastamisel on liisinguandjal õigus osale liisingutasust laeva kasutamisaja eest. Sissemaksed, mida liisinguvõtja oli teinud laeva ostuhinna arvel, tagastatakse liisinguvõtjale. Liisinguvõtja kohustub tagastama laeva sellises seisukorras, nagu see oli ülevõtmisel, võttes arvesse normaalse kulumi. Laeva seisukorra halvenemisel hüvitab liisinguvõtja liisinguandjale tekitatud kahju. Liisinguvõtja poolt laevale pandud lisandid, mida on võimalik eraldada, võib liisinguvõtja laevalt maha võtta, kui liisinguandja ei nõustu nende eest tasuma. [Peatükk XIII kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_216 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_217_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_217"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Merepukseerimislepingu järgi on ühe laeva omanik kohustatud tasu eest pukseerima teist laeva või mõnda muud ujuvobjekti teatud kaugusele või teatud aja jooksul või manööverdamiseks.",
      "rdfs:label": {
        "@value": "KMSK_Par_217 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_223_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_223"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastutus kahju eest, mis tekitati pukseerimisel pukseerivale laevale või sellel olevale varale, juhul kui pukseeritava laeva või muu objekti kapten on pukseeriva laeva juhtijaks, lasub poolte vahel teistsuguse kokkuleppe puudumisel pukseeritava laeva või muu objekti omanikul, kui ta ei tõesta oma süü puudumist.",
      "rdfs:label": {
        "@value": "KMSK_Par_223 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_223_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_223_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_223"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastutus kahju eest, mis tekitati pukseerimisel pukseerivale laevale või sellel olevale varale, juhul kui pukseeritava laeva või muu objekti kapten on pukseeriva laeva juhtijaks, lasub poolte vahel teistsuguse kokkuleppe puudumisel pukseeritava laeva või muu objekti omanikul, kui ta ei tõesta oma süü puudumist. [Peatükk XIV kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_223 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_224_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_224"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Merekindlustuslepingu järgi kohustub kindlustusandja kokkulepitud tasu (kindlustuspreemia) eest kindlustusobjekti suhtes lepingus ette nähtud ohtude või juhtumite tekkimisel (kindlustusjuhtum) hüvitama tekitatud kahju kindlustusvõtjale või muule isikule, kelle kasuks leping on sõlmitud.",
      "rdfs:label": {
        "@value": "KMSK_Par_224 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_263_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_263"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kindlustusandja maksab kindlustusvõtjale ainult merekindlustuslepingu tingimuste järgi maksmisele kuuluva summa ja kolmandalt isikult saadud summa vahe juhul, kui kindlustusvõtja sai kahju eest kindlustushüvise sellelt kolmandalt isikult.",
      "rdfs:label": {
        "@value": "KMSK_Par_263 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_263_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_263_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_263"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kindlustusandja maksab kindlustusvõtjale ainult merekindlustuslepingu tingimuste järgi maksmisele kuuluva summa ja kolmandalt isikult saadud summa vahe juhul, kui kindlustusvõtja sai kahju eest kindlustushüvise sellelt kolmandalt isikult. [Peatükk XV kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_263 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_264_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_264"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Üldavariiks loetakse kahju, mis tekkis tahtlikult ja põhjendatud piires tehtud erakorralistest kulutustest või loovutustest, et päästa laev, prahiraha ja laeval veetav last neid ähvardavast ühisest ohust. Üldavarii jaguneb laeva, prahiraha ja lasti vahel vastavalt nende maksumusele. Prahiraha all mõistetakse käesolevas peatükis ka sõidu- ja pagasiraha.",
      "rdfs:label": {
        "@value": "KMSK_Par_264 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_282_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_282"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avarii liigi kindlaksmääramisel, üldavarii ulatuse arvutamisel ja dispaši koostamisel juhindub dispašöör, kui seaduses selle kohta sätted puuduvad, rahvusvahelistest kaubandusliku meresõidu tavadest.",
      "rdfs:label": {
        "@value": "KMSK_Par_282 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_282_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_282_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_282"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avarii liigi kindlaksmääramisel, üldavarii ulatuse arvutamisel ja dispaši koostamisel juhindub dispašöör, kui seaduses selle kohta sätted puuduvad, rahvusvahelistest kaubandusliku meresõidu tavadest. [Peatükk XVI kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_282 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_283_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_283"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva peatüki sätteid kohaldatakse merel või teistes vetes merelaevade, samuti merelaevade ja siseveelaevade kokkupõrke korral. Käesolevas peatükis võrdsustatakse laevakokkupõrkega juhud, kui ühe laeva poolt teisele laevale või laevadel olevatele isikutele, lastile või muule varale tekitati kahju manöövri teostamise või mitteteostamisega või laevasõidueeskirjade rikkumisega, isegi kui seejuures kokkupõrget ei toimunud.",
      "rdfs:label": {
        "@value": "KMSK_Par_283 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_290_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_290"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast laevakokkupõrget on iga kokkupõrganud laeva kapten kohustatud, kuivõrd ta suudab seda teha ilma suurema ohuta oma reisijatele, laevaperele ja laevale, abistama teist laeva, tema reisijaid ja laevaperet. Laevakaptenid on kohustatud, kuivõrd see on võimalik, teatama üksteisele oma laeva nime, registreerimissadama, samuti lähtesadama ja sihtsadama või lähima sadama, kuhu laev siseneb. Käesolevas paragrahvis märgitud kohustuste rikkumisel kannab kapten seaduses ettenähtud vastutust. Laevaomanik ei vastuta selle eest, kui kapten jätab käesoleva paragrahviga kindlaksmääratud kohustused täitmata.",
      "rdfs:label": {
        "@value": "KMSK_Par_290 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_290_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_290_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_290"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast laevakokkupõrget on iga kokkupõrganud laeva kapten kohustatud, kuivõrd ta suudab seda teha ilma suurema ohuta oma reisijatele, laevaperele ja laevale, abistama teist laeva, tema reisijaid ja laevaperet. Laevakaptenid on kohustatud, kuivõrd see on võimalik, teatama üksteisele oma laeva nime, registreerimissadama, samuti lähtesadama ja sihtsadama või lähima sadama, kuhu laev siseneb. Käesolevas paragrahvis märgitud kohustuste rikkumisel kannab kapten seaduses ettenähtud vastutust. Laevaomanik ei vastuta selle eest, kui kapten jätab käesoleva paragrahviga kindlaksmääratud kohustused täitmata. [Peatükk XVII kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_290 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_291_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_291"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaomanik vastutab mere reostuskahjustuse eest, mis on tekkinud tema laevalt nafta, naftasaaduste ja teiste, inimese tervisele või merekeskkonnale kahjulike ainete (edaspidi reostusained) merre voolamise või heitmise tagajärjel, vastavalt Eesti seadustikule. Mere reostuskahjustuse all mõistetakse reostusainete poolt väljaspool laeva esilekutsutud kahju nii merekeskkonnale, rannale kui ka teistele objektidele (laevad, kalapüügivahendid jne.), aga samuti kahjustuse vähendamise või ärahoidmise eesmärgil toimepandud meetmete maksumust, kui neid meetmeid rakendati pärast sündmust, mis kutsus või võis kutsuda esile reostuse.",
      "rdfs:label": {
        "@value": "KMSK_Par_291 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_3_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vedu ja pukseerimine Eesti Vabariigi (edaspidi Eesti) sadamate vahel toimub Eesti Vabariigi riigilipu all sõitvate laevadega. Erandeid sellest sättest võib teha Eesti Vabariigi Valitsus. Vedu ja pukseerimine Eesti sadamate vahel võib toimuda ka Euroopa Liidu liikmesriigi riigilipu all sõitvate laevadega, kui see riik annab Eesti Vabariigi riigilipu all sõitvatele laevadele riikidevahelise lepinguga samasuguse õiguse.",
      "rdfs:label": {
        "@value": "KMSK_Par_3 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_3_v749330"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_3_v749330",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vedu ja pukseerimine Eesti Vabariigi (edaspidi Eesti) sadamate vahel toimub Eesti Vabariigi ja Euroopa Liidu liikmesriigi riigilipu all sõitvate laevadega. Vedu ja pukseerimine Eesti sadamate vahel võib toimuda ka esimeses lauses nimetamata riigilipu all sõitvate laevadega, kui see riik annab Eesti Vabariigi riigilipu all sõitvatele laevadele riikidevahelise lepinguga samasuguse õiguse.",
      "rdfs:label": {
        "@value": "KMSK_Par_3 (redaktsioon 749330)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749330",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_3_v128122010011"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_3_v128122010011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vedu ja pukseerimine ning muude teenuste osutamine ainult Eesti Vabariigi (edaspidi Eesti) sadamate vahel või sadama akvatooriumil või väljumisega Eesti sadamast ja sisenemisega samasse sadamasse toimub Eesti ja Euroopa Liidu liikmesriigi ning Euroopa Majanduspiirkonna lepingu osalisriigi riigilipu all sõitvate laevadega.",
      "rdfs:label": {
        "@value": "KMSK_Par_3 (redaktsioon 128122010011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122010011"
    },
    {
      "@id": "estleg:KMSK_Par_300_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_300"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva koodeksi paragrahvides 297 ja 298 mõistetakse nafta all püsikindlat naftat (toornafta, masuut, raske diislikütus, määrdeained), aga samuti vaala- ja kalarasva.",
      "rdfs:label": {
        "@value": "KMSK_Par_300 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_300_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_300_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_300"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva koodeksi paragrahvides 297 ja 298 mõistetakse nafta all püsikindlat naftat (toornafta, masuut, raske diislikütus, määrdeained), aga samuti vaala- ja kalarasva. [Peatükk XVIII kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_300 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_301_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_301"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tuumalaeva operaator vastutab tuumakahjustuse eest, mis tekitatakse tuumaintsidendi läbi tuumalaevaga, välja arvatud juhud, mis on sätestatud käesoleva koodeksi paragrahvis 303. Tuumakahjustuse all mõeldakse kahjustust , mis tekitatakse üksikisikule või varale tuumakütuse radioaktiivsete omadustega või radioaktiivseta omaduste ja toksiliste, plahvatuslike ning teiste tuumakütuse ohtlike omaduste koosmõjuga, tuumalaeva radioaktiivsete saaduste või jäätmetega, samuti tehtud kulutused, mis on suunatud kahjustuse vältimisele või vähendamisele. Kui koos tuumakahjustusega on tekitatud kahjustus, mida ei saa eristada tuumakahjustusest, loetakse kogu kahjustus tuumakahjustuseks. Tuumakahjustuseks ei loeta kahjustust, mis on tekitatud tuumalaevale endale, tema seadmetele, kütusele ja proviandile. Tuumaintsidendiks loetakse sündmus või sündmuste jada, mis on ühest ja samast põhjusest tingitud ja millel on käesoleva paragrahvi teises ja kolmandas lõigus sätestatud tunnused.",
      "rdfs:label": {
        "@value": "KMSK_Par_301 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_303_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_303"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tuumalaeva operaator peab hüvitama tuumakahjustuse, kui ta ei tõesta, et tuumakahjustus oli põhjustatud sõjategevusest, vaenutegevusest või rahvarahutustest. Kui operaator tõestab, et tuumakahjustus oli põhjustatud täielikult või osaliselt kannatanu tahtlusest, vabastatakse operaator vastutusest täielikult või osaliselt kannatanu ees.",
      "rdfs:label": {
        "@value": "KMSK_Par_303 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_31_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tsiviil-, administratiiv- ja teiste õiguslike suhete puhul, mis tulenevad kaubanduslikust meresõidust ja ei ole käesoleva koodeksiga reguleeritud, kohaldatakse Eesti tsiviil-, administratiiv- ja teiste vastavate seadustike sätteid.",
      "rdfs:label": {
        "@value": "KMSK_Par_31 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_31_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_31_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tsiviil-, administratiiv- ja teiste õiguslike suhete puhul, mis tulenevad kaubanduslikust meresõidust ja ei ole käesoleva koodeksiga reguleeritud, kohaldatakse Eesti tsiviil-, administratiiv- ja teiste vastavate seadustike sätteid. Paragrahv 31 kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_31 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_31_v13187940"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_31_v13187940",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "KMSK_Par_31 (redaktsioon 13187940)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13187940"
    },
    {
      "@id": "estleg:KMSK_Par_314_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_314"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva peatüki sätteid kohaldatakse ohtusattunud merelaevade päästmisel, samuti siseveelaevade või mis tahes ujuv- või pukseeritavate objektide merelaevade poolt päästmisel, sõltumata sellest, mis vetes päästmine aset leidis. Käesoleva peatüki sätteid kohaldatakse ka sõjalaevastiku lipu all sõitvate laevade suhtes.",
      "rdfs:label": {
        "@value": "KMSK_Par_314 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_326_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_326"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühele päästjale kuuluva päästetasu jaotamine laevaomaniku, laevapere liikmete ja teiste isikute vahel toimub Vabariigi Valitsuse poolt kehtestatud korras.",
      "rdfs:label": {
        "@value": "KMSK_Par_326 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_326_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_326_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_326"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühele päästjale kuuluva päästetasu jaotamine laevaomaniku, laevapere liikmete ja teiste isikute vahel toimub Vabariigi Valitsuse poolt kehtestatud korras. [Peatükk XX kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_326 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_327_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_327"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevaomanik vastutab oma kohustuste järgi temale kuuluva varaga, millele võidakse Eesti seadustiku järgi sissenõue pöörata.",
      "rdfs:label": {
        "@value": "KMSK_Par_327 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_340_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_340"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Poolte kokkulepe laevaomaniku käesoleva peatüki sätetega kindlaksmääratud vastutuse vähendamise kohta on kehtetu.",
      "rdfs:label": {
        "@value": "KMSK_Par_340 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_347_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_347"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui laeva sõidusoleku või peatuskohas viibimise ajal leidis aset sündmus, mis võib põhjustada laevaomanikule varaliste nõudmiste esitamise, teeb kapten laevaomaniku seaduspäraste huvide kaitsmiseks vajalike asitõendite saamiseks kindlaksmääratud korras mereprotesti avalduse. Mereprotesti avaldus peab sisaldama sündmuse asjaolude ja kapteni poolt tema hoolde antud vara säilitamiseks tarvituselevõetud abinõude kirjelduse.",
      "rdfs:label": {
        "@value": "KMSK_Par_347 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_353_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_353"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mereprotesti avaldusi välisriigi laeva kaptenilt vastu võtta ja neil juhtudel mereprotestiakte koostada võib vastava välisriigi konsulaaresindus Eestis vastastikuse kokkuleppe alusel.",
      "rdfs:label": {
        "@value": "KMSK_Par_353 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_353_v182059"
      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_353_v182059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_353"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mereprotesti avaldusi välisriigi laeva kaptenilt vastu võtta ja neil juhtudel mereprotestiakte koostada võib vastava välisriigi konsulaaresindus Eestis vastastikuse kokkuleppe alusel. [Peatükk XXIII kehtib kuni 30.09.2002 -",
      "rdfs:label": {
        "@value": "KMSK_Par_353 (redaktsioon 182059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182059"
    },
    {
      "@id": "estleg:KMSK_Par_354_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_354"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asjaolud, mis võivad lastivedaja, lastisaatja, lastisaaja ja reisijate varalise vastutuse aluseks olla, tõendatakse kommertsaktidega või üldise vormi järgi koostatud aktidega. Välisriigi sadamas tõendatakse neid asjaolusid vastavalt nendele eeskirjadele, mis kehtivad antud sadamas. Kommertsakt koostatakse, et tõendada: lasti või pagasi nimetuse, massi või kohtade tegeliku arvu mittevastavust veodokumendis märgitud andmetele; lasti või pagasi vigastust või riknemist; dokumentideta lasti või pagasi, samuti lasti või pagasita dokumentide ilmsikstulekut; riisutud lasti või pagasi lastivedajale tagastamist. Aktide vormid, nende koostamise kord ja aktide koostamist mittevajavate asjaolude tõendamise kord määratakse kindlaks teede- ja sideministri poolt kehtestatud määrustega.",
      "rdfs:label": {
        "@value": "KMSK_Par_354 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_372_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_372"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva koodeksiga ettenähtud suhetest tulenevate nõuete rahuldamisel arvatakse väljamakstavale summale juurde 3 kuni 12 protsenti aastas. Aastaprotsendi suuruse määrab kohus või arbitraaž. Protsendid arvutatakse päevast, mil esitati kirjalik nõue vastava summa maksmiseks, kuni selle summa maksmise päevani. Käesoleva paragrahvi sätteid ei kohaldata rahatrahvide ja preemiate, samuti üldavarii jaotamise korras hüvitatavate kahjude kohta käivate nõuete suhtes.",
      "rdfs:label": {
        "@value": "KMSK_Par_372 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215"
    },
    {
      "@id": "estleg:KMSK_Par_373_v128122010011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_373"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veo ja pukseerimise ning muude teenuste osutamise eest ainult Eesti sadamate vahel või sadama akvatooriumil või väljumisega Eesti sadamast ja sisenemisega samasse sadamasse laevaga, millel puudub vastav õigus, –karistatakse rahatrahviga kuni 300 trahviühikut. Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "KMSK_Par_373 (redaktsioon 128122010011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122010011",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_373_v129062014111"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_373_v129062014111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_373"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "KMSK_Par_373 (redaktsioon 129062014111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014111"
    },
    {
      "@id": "estleg:KMSK_Par_374_v128122010011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_374"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uppunud varast teatamata jätmise eest –karistatakse rahatrahviga kuni 300 trahviühikut. Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "KMSK_Par_374 (redaktsioon 128122010011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122010011",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_374_v129062014111"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_374_v129062014111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_374"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "KMSK_Par_374 (redaktsioon 129062014111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014111"
    },
    {
      "@id": "estleg:KMSK_Par_375_v128122010011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_375"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva koodeksi §-des 373 ja 374 sätestatud väärtegudele kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. Paragrahvides 373 ja 374 sätestatud väärtegude kohtuväline menetleja on politseiasutus.",
      "rdfs:label": {
        "@value": "KMSK_Par_375 (redaktsioon 128122010011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122010011",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_375_v129062014111"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_375_v129062014111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_375"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvides 373 ja 374 sätestatud väärtegude kohtuväline menetleja on politseiasutus.",
      "rdfs:label": {
        "@value": "KMSK_Par_375 (redaktsioon 129062014111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014111"
    },
