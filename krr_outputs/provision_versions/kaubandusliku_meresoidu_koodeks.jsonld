      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tunnistus laeva omandiõiguse kohta ja laevapilet võivad laevas olla ametlikult kinnitatud ärakirjana. [Paragrahv 50 kehtetu alates 01.01.2003]",
      "rdfs:label": {
        "@value": "KMSK_Par_49 (redaktsioon 22215)",
        "@language": "et"
      },
