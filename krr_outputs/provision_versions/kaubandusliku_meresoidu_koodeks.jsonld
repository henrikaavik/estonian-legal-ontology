    },
    {
      "@id": "estleg:KMSK_Par_9_1_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_9_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veeteede Amet peatab tegevusloa ja teeb ettevõtjale ettekirjutuse puuduste kõrvaldamiseks, kui: ettevõtja tegevus on keskkonnakahjulik või ohustab inimeste tervist; ettevõtja ei vasta käesoleva koodeksi nõuetele. Tegevusloa võib peatada kuni kuueks kuuks. Veeteede Amet tunnistab tegevusloa kehtetuks: kui ettevõtja ei kõrvalda tegevusloa peatamise ajal puudusi, mis on tinginud tegevusloa peatamise; kui ettevõtja on tegevusloa taotlemisel esitanud valeandmeid; muudel seadusega sätestatud juhtudel. Tegevusloa kehtetuks tunnistamise korral saadab Veeteede Amet tegevusloa kehtetuks tunnistamise otsuse ärakirja ettevõtjale kolme tööpäeva jooksul otsuse tegemisest arvates. Tegevusluba kaotab kehtivuse, kui ettevõtja tegevuse lõpetab või kui tegevus lõpeb.",
      "rdfs:label": {
        "@value": "KMSK_Par_9_1 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
