      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teede- ja sideminister kehtestab logiraamatu, masinapäevaraamatu ja raadiopäevaraamatu pidamise korra.",
