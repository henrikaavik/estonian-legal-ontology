        "@value": "KMSK_Par_14 (redaktsioon 13187940)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13187940"
    },
    {
      "@id": "estleg:KMSK_Par_15_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Kehtetu]",
      "rdfs:label": {
        "@value": "KMSK_Par_15 (redaktsioon 22215)",
