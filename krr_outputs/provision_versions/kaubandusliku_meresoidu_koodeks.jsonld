    {
      "@id": "estleg:KMSK_Par_52_v22215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapere koosneb kaptenist, teistest laeva juhtkonda kuuluvatest isikutest ja laeva meeskonnast. Laeva juhtkonda kuuluvad peale kapteni tüürimehed, kapteniabid, laevamehaanikud, elektromehaanikud, raadiospetsialistid ja arstid. Laevaomanik võib juhtkonna koosseisu arvata ka teisi laevaspetsialiste. Laevameeskond koosneb tekimeeskonnast, masinameeskonnast ja teistest laevapere liikmetest, kes ei kuulu laeva juhtkonda.",
      "rdfs:label": {
        "@value": "KMSK_Par_52 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
      "estleg:supersededByVersion": {
        "@id": "estleg:KMSK_Par_52_v129062014111"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KMSK_Par_52_v129062014111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva juhtkonda kuuluvad peale kapteni tüürimehed, kapteniabid, laevamehaanikud, elektromehaanikud, raadiospetsialistid ja arstid. Laevaomanik võib juhtkonna koosseisu arvata ka teisi laevaspetsialiste. Laevameeskond koosneb tekimeeskonnast, masinameeskonnast ja teistest laevapere liikmetest, kes ei kuulu laeva juhtkonda.",
      "rdfs:label": {
        "@value": "KMSK_Par_52 (redaktsioon 129062014111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014111"
