    {
      "@id": "estleg:KMSK_Par_9_1_v908738",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KMSK_Par_9_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veeteede Amet peatab tegevusloa ja teeb ettevõtjale ettekirjutuse puuduste kõrvaldamiseks, kui: ettevõtja tegevus on keskkonnakahjulik või ohustab inimeste tervist; ettevõtja ei vasta käesoleva koodeksi nõuetele; ettevõtja tuletornitasu või navigatsioonitasu võlg ületab kolme kuu tasumäära. Tegevusloa võib peatada kuni kuueks kuuks. Veeteede Amet tunnistab tegevusloa kehtetuks: kui ettevõtja ei kõrvalda tegevusloa peatamise ajal puudusi, mis on tinginud tegevusloa peatamise; kui ettevõtja on tegevusloa taotlemisel esitanud valeandmeid; muudel seadusega sätestatud juhtudel. Tegevusloa kehtetuks tunnistamise korral saadab Veeteede Amet tegevusloa kehtetuks tunnistamise otsuse ärakirja ettevõtjale kolme tööpäeva jooksul otsuse tegemisest arvates. Tegevusluba kaotab kehtivuse, kui ettevõtja tegevuse lõpetab või kui tegevus lõpeb.",
      "rdfs:label": {
        "@value": "KMSK_Par_9_1 (redaktsioon 908738)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908738",
