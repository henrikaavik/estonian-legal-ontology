      },
      "estleg:versionText": "Kaubandusliku meresõidu koodeks reguleerib kaubanduslikust meresõidust tulenevaid suhteid.",
      "rdfs:label": {
        "@value": "KMSK_Par_1 (redaktsioon 22215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22215",
