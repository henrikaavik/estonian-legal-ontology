      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_17_v12850103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liikmele, kelle töövõime kaotuse protsent on väiksem kui 40, töövõimetuse pensioni ei määrata. Parlamendiliikme töövõimetuspensioni ei maksta Riigikogu liikmena töötamise ajal ja ajal, millal Riigikogu liikmele tema volituste lõppemisel säilitatakse Riigikogu liikme ametipalk. - X Riigikogu volituste alguspäeval",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_17 (redaktsioon 12850103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850103",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVUXKRVVIKLP_Par_17_v13207850"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12850103",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 17",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_17_v13207850",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Parlamendiliikme töövõimetuspensioni suurus on: 1) täieliku töövõimetuse korral – 70% Riigikogu liikme ametipalgast; 2) osalise töövõimetuse korral – töövõime kaotuse protsendile vastav protsent käesoleva paragrahvi punktis 1 sätestatud pensionist. Riigikogu liikmele, kelle töövõime kaotuse protsent on väiksem kui 40, töövõimetuse pensioni ei määrata. Parlamendiliikme töövõimetuspensioni ei maksta Riigikogu liikmena töötamise ajal ja ajal, millal Riigikogu liikmele tema volituste lõppemisel säilitatakse Riigikogu liikme ametipalk.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_17 (redaktsioon 13207850)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13207850",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVUXKRVVIKLP_Par_17_v117122015035"
      },
      "estleg:versionValidTo": {
        "@value": "2016-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13207850",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 17",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
