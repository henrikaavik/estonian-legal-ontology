    {
      "@id": "estleg:EVUXKRVVIKLP_Par_14_v12850103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigus parlamendiliikme vanaduspensionile on Riigikogu liikmel, kes on jõudnud käesoleva seaduse §-s 27 sätestatud parlamendiliikme vanaduspensioni ikka, tingimusel, et tal on vähemalt 25-aastane pensionistaaž ja ta on olnud Riigikogu liige ühes või enamas Riigikogu koosseisus kokku vähemalt kolm aastat. Riigikogu liikme volituste peatumisel tema nimetamise tõttu Vabariigi Valitsuse liikmeks võrdsustatakse tema töötamise aeg peaministri või ministrina Riigikogu liikmena töötamise ajaga. Pensionistaaži arvestatakse teistes riiklikke pensione käsitlevates seadustes sätestatud korras. - X Riigikogu volituste alguspäeval",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_14 (redaktsioon 12850103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850103",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVUXKRVVIKLP_Par_14_v13207850"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12850103",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 14",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_14_v13207850",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_14"
      },
