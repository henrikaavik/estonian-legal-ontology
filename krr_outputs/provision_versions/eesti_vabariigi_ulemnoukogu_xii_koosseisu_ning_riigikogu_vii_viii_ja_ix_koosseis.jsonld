    {
      "@id": "estleg:EVUXKRVVIKLP_Par_14_v108072016006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigus parlamendiliikme vanaduspensionile on Riigikogu liikmel, kes on jõudnud käesoleva seaduse §-s 27 sätestatud parlamendiliikme vanaduspensioni ikka, tingimusel, et tal on vähemalt 25-aastane pensionistaaž ja ta on olnud Riigikogu liige ühes või enamas Riigikogu koosseisus kokku vähemalt kolm aastat. Riigikogu liikme volituste peatumisel tema nimetamise tõttu Vabariigi Valitsuse liikmeks võrdsustatakse tema töötamise aeg peaministri või ministrina Riigikogu liikmena töötamise ajaga. Pensionistaaži arvestatakse riikliku pensionikindlustuse seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_14 (redaktsioon 108072016006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072016006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072016006",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 14",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_14_1_v12850103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_14_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Parlamendiliikme vanaduspensioni suuruseks on Riigikogu liikmel, kes on töötanud Riigikogu liikmena: 1) vähemalt 3 aastat – 40% Riigikogu liikme ametipalgast; 2) vähemalt 6 aastat – 60% Riigikogu liikme ametipalgast; 3) vähemalt 9 aastat – 75% Riigikogu liikme ametipalgast.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_14_1 (redaktsioon 12850103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12850103",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 14_1",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_15_v12850103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Parlamendiliikme vanaduspensioni ei maksta: 1) töötamise ajal Riigikogu liikmena, Vabariigi Presidendina, Vabariigi Valitsuse liikmena, Riigikohtu esimehena või liikmena, kohtunikuna, kaitseväe juhatajana, õiguskantslerina, riigikontrolörina või Eesti Panga presidendina; 2) ajal, millal Riigikogu liikmele tema volituste lõppemisel säilitatakse Riigikogu liikme ametipalk. - X Riigikogu volituste alguspäeval",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_15 (redaktsioon 12850103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850103",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVUXKRVVIKLP_Par_15_v13207850"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12850103",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 15",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_15_v13207850",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Parlamendiliikme vanaduspensioni ei maksta: 1) töötamise ajal Riigikogu liikmena, Vabariigi Presidendina, Vabariigi Valitsuse liikmena, Riigikohtu esimehena või liikmena, kohtunikuna, kaitseväe juhatajana, õiguskantslerina, riigikontrolörina, Eesti Panga presidendina või Euroopa Parlamendi liikmena; [ - jõust. 14.07.2009] 20.07.2009 16:50 2) ajal, millal Riigikogu liikmele tema volituste lõppemisel säilitatakse Riigikogu liikme ametipalk.",
