      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 16",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_16_v13207850",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul, kes Riigikogu liikmena töötamise ajal kaotas püsiva töövõime täielikult või osaliselt, on õigus parlamendiliikme töövõimetuspensionile, sõltumata tema vanusest, pensionistaažist. Püsiva töövõime kaotamise aeg, põhjus, kestus ja töövõime kaotuse protsent määratakse kindlaks riikliku pensionikindlustuse seadusega sätestatud korras. Kui püsiva töövõime kaotanud Riigikogu liikmel on samal ajal õigus parlamendiliikme vanaduspensionile, määratakse talle tema soovil kas parlamendiliikme töövõimetuspension või vanaduspension.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_16 (redaktsioon 13207850)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13207850",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVUXKRVVIKLP_Par_16_v117122015035"
      },
      "estleg:versionValidTo": {
        "@value": "2016-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13207850",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 16",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
