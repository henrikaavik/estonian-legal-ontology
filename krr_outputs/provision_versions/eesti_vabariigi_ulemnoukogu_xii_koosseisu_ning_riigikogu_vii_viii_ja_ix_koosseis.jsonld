      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_28_2_v108072016006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_28_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus on kohustatud 10 tööpäeva jooksul kohtuotsuse jõustumisest arvates kirjalikult teatama Sotsiaalkindlustusametile asjaolust, millega seoses kaob isikul õigus käesolevas seaduses sätestatud parlamendiliikme vanaduspensionile.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_28_2 (redaktsioon 108072016006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072016006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072016006",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 28_2",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_29_v12850103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus laieneb neile Eesti Vabariigi Ülemnõukogu XII koosseisu liikmetele, kelle volitused kestavad kuni Riigikogu valimistulemuste väljakuulutamiseni ja kes on osa võtnud vähemalt pooltest nimetatud koosseisu täiskogu istungitest. Istungitest osavõtu nõuet ei kohaldata Ülemnõukogu esimehe, peaministri ega ministri suhtes nende volituste ajal.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_29 (redaktsioon 12850103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12850103",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 29",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_29_1_v12850103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_29_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning VII ja VIII Riigikogu liikmel, sõltumata tema valimisest IX või järgnevate Riigikogude liikmeks, säilib õigus parlamendiliikme vanaduspensionile enne IX Riigikogu volituste algust kehtinud tingimustel ja suuruses (§-d 14, 26 ja 27). Eesti Vabariigi Ülemnõukogu XII koosseisu ning VII ja VIII Riigikogu liikmele laienevad ka käesoleva seaduse § 14 lõigetes 2 ja 3 sätestatud ja IX Riigikogu volituste alguspäeval jõustunud tingimused. Isikule, kes IX Riigikogu volituste alguspäeval töötas käesoleva seaduse §-s 15 tähendatud ametikohal ja kellele maksti samal ajal parlamendiliikme vanaduspensioni, jätkatakse samal ametikohal edasitöötamisel parlamendiliikme vanaduspensioni maksmist.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_29_1 (redaktsioon 12850103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12850103",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 29_1",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_29_2_v12850103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_29_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi Ülemnõukogu XII koosseisu ja VII, VIII ning IX Riigikogu liikmel, sõltumata tema valimisest järgnevate Riigikogude liikmeks, ei liideta tema töötamise aega järgnevate Riigikogude liikmena parlamendiliikme vanaduspensioniõigust andva töötamise aja hulka. - X Riigikogu volituste alguspäeval",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_29_2 (redaktsioon 12850103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850103",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVUXKRVVIKLP_Par_29_2_v13207850"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12850103",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 29_2",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
