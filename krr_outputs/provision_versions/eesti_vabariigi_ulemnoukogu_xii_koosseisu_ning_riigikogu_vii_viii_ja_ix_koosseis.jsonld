      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_15_v108072016006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Parlamendiliikme vanaduspensioni ei maksta: 1) töötamise ajal Riigikogu liikmena, Vabariigi Presidendina, Vabariigi Valitsuse liikmena, Riigikohtu esimehena või liikmena, kohtunikuna, kaitseväe juhatajana, õiguskantslerina, riigikontrolörina, Eesti Panga presidendina või Euroopa Parlamendi liikmena; [ - jõust. 14.07.2009] 2) aja eest, mille ulatuses Riigikogu liikmele tema volituste lõppemisel makstakse ühekordset hüvitist.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_15 (redaktsioon 108072016006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072016006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072016006",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 15",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_16_v12850103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul, kes Riigikogu liikmena töötamise ajal kaotas püsiva töövõime täielikult või osaliselt, on õigus parlamendiliikme töövõimetuspensionile, sõltumata tema vanusest, pensionistaažist. Püsiva töövõime kaotamise aeg, põhjus, kestus ja töövõime kaotuse protsent määratakse kindlaks riikliku pensionikindlustuse seadusega (RT I 1998, 64/65, 1009; 2001, 9, 42) sätestatud korras. Kui püsiva töövõime kaotanud Riigikogu liikmel on samal ajal õigus parlamendiliikme vanaduspensionile, määratakse talle tema soovil kas parlamendiliikme töövõimetuspension või vanaduspension. - X Riigikogu volituste alguspäeval",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_16 (redaktsioon 12850103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850103",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVUXKRVVIKLP_Par_16_v13153905"
      },
      "estleg:versionValidTo": {
        "@value": "2009-03-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12850103",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 16",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_16_v13153905",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_16"
      },
      "estleg:versionValidFrom": {
