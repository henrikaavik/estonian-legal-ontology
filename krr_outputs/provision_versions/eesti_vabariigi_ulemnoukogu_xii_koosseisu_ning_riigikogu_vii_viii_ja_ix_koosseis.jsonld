    {
      "@id": "estleg:EVUXKRVVIKLP_Par_18_v12850103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toitjakaotuspension määratakse Riigikogu liikme surma korral tema ülalpidamisel olnud perekonnaliikmetele. Ülalpeetavateks perekonnaliikmeteks loetakse isikuid, kellel on õigus saada toitjakaotuspensioni teiste riiklikke pensione sätestavate seaduste alusel.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_18 (redaktsioon 12850103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850103",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVUXKRVVIKLP_Par_18_v108072016006"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12850103",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 18",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
    {
      "@id": "estleg:EVUXKRVVIKLP_Par_18_v108072016006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVUXKRVVIKLP_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toitjakaotuspension määratakse Riigikogu liikme, kes sai parlamendiliikme vanaduspensioni või kellel oli selle saamiseks olemas vajalik Riigikogu liikme staaž, surma korral tema ülalpidamisel olnud perekonnaliikmetele. Toitjakaotuspensionile õigust omavateks perekonnaliikmeteks loetakse isikuid, kellel on õigus saada toitjakaotuspensioni riikliku pensionikindlustuse seaduse alusel.",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_18 (redaktsioon 108072016006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072016006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072016006",
      "estleg:sourceAct": "Eesti Vabariigi Ülemnõukogu XII koosseisu ning Riigikogu VII, VIII ja IX koosseisu liikmete pensioni seadus",
      "estleg:provisionRef": "EVUXKRVVIKLP § 18",
      "estleg:partOfAct": {
        "@id": "estleg:EVUXKRVVIKLP_Map_2026"
      }
    },
