      },
      "estleg:versionText": "Kehtetu - (jõustumine muudetud - RT I, 17.12.2015, 1)",
      "rdfs:label": {
        "@value": "EVUXKRVVIKLP_Par_16 (redaktsioon 117122015035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015035",
