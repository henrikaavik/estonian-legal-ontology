        "@type": "xsd:date"
      },
      "estleg:versionText": "Perehüvitiste seaduses tehakse järgmised muudatused:",
      "rdfs:label": {
        "@value": "PEREHU_Par_73 (redaktsioon 124122016004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "124122016004",
