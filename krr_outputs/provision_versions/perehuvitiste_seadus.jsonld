    },
    {
      "@id": "estleg:PEREHU_Par_9_v124122016004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja on kohustatud Sotsiaalkindlustusametile viivitamata teatama järgmistest asjaoludest, mis mõjutavad perehüvitise saamist või selle suurust: taotleja või lapse elama või õppima asumine teise riiki või teises riigis õpingute katkestamine või lõpetamine; pereliikme – vanema, eestkostja, hooldaja, vanema abikaasa või muu hüvitist saama õigustatud isiku – tööle asumine Euroopa Majanduspiirkonna lepinguriiki või Šveitsi Konföderatsiooni; perehüvitiste saamine välisriigilt.",
      "rdfs:label": {
        "@value": "PEREHU_Par_9 (redaktsioon 124122016004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "124122016004",
      "estleg:supersededByVersion": {
        "@id": "estleg:PEREHU_Par_9_v128112017023"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/124122016004",
      "estleg:sourceAct": "Perehüvitiste seadus",
      "estleg:provisionRef": "PEREHU § 9",
      "estleg:partOfAct": {
        "@id": "estleg:PEREHU_Map"
      }
    },
    {
      "@id": "estleg:PEREHU_Par_9_v128112017023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja on kohustatud Sotsiaalkindlustusametile viivitamata teatama järgmistest asjaoludest, mis mõjutavad perehüvitise saamist või selle suurust: taotleja või lapse elama või õppima asumine teise riiki või teises riigis õpingute katkestamine või lõpetamine; pereliikme – vanema, eestkostja, hoolduspere vanema, vanema abikaasa või muu hüvitist saama õigustatud isiku – tööle asumine Euroopa Majanduspiirkonna lepinguriiki või Šveitsi Konföderatsiooni; perehüvitiste saamine välisriigilt.",
      "rdfs:label": {
        "@value": "PEREHU_Par_9 (redaktsioon 128112017023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128112017023",
