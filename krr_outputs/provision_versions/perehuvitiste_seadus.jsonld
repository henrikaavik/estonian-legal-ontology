      }
    },
    {
      "@id": "estleg:PEREHU_Par_21_1_v128122017062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_21_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kolmikute või enamaarvuliste mitmike toetuse saamise õigus on ühel vanemal, hoolduspere vanemal või eestkostjal, kes kasvatab kolmikuid või enamaarvulisi mitmikke. Toetuse saamise õigus on kuni laste 18 kuu vanuseks saamise päevani. (2) Kolmikute või enamaarvuliste mitmike toetuse suurus on 1000 eurot.",
      "rdfs:label": {
        "@value": "PEREHU_Par_21_1 (redaktsioon 128122017062)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017062",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122017062",
      "estleg:sourceAct": "Perehüvitiste seadus",
      "estleg:provisionRef": "PEREHU § 21_1",
      "estleg:partOfAct": {
        "@id": "estleg:PEREHU_Map"
      }
    },
    {
      "@id": "estleg:PEREHU_Par_22_v124122016004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sünnitoetuse saamise õigus on ühel vanematest lapse sünni korral. (2) Õigus sünnitoetusele tekib lapse sündimise päeval. (3) Sünnitoetuse saamise õigus on lapsendajal, eestkostjal või hooldajal, kui varem ei ole sama lapse kohta sünnitoetust makstud. (4) Sünnitoetuse suurus on 320 eurot iga sündinud lapse kohta. (5) Kolmikute või suurema arvu mitmike sünni korral on sünnitoetuse suurus 1000 eurot iga sündinud lapse kohta. (6) Sünnitoetust ei maksta surnult sündinud lapse kohta.",
      "rdfs:label": {
        "@value": "PEREHU_Par_22 (redaktsioon 124122016004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "124122016004",
      "estleg:supersededByVersion": {
        "@id": "estleg:PEREHU_Par_22_v128112017023"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/124122016004",
      "estleg:sourceAct": "Perehüvitiste seadus",
      "estleg:provisionRef": "PEREHU § 22",
      "estleg:partOfAct": {
        "@id": "estleg:PEREHU_Map"
      }
    },
