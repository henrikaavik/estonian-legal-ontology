      }
    },
    {
      "@id": "estleg:PEREHU_Par_9_v106072023062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja on kohustatud Sotsiaalkindlustusametile viivitamata teatama järgmistest asjaoludest, mis mõjutavad perehüvitise saamist või selle suurust: taotleja või lapse elama või õppima asumine teise riiki või teises riigis õpingute katkestamine või lõpetamine; pereliikme – vanema, eestkostja, hoolduspere vanema, vanema abikaasa või registreeritud elukaaslase või muu hüvitist saama õigustatud isiku – tööle asumine Euroopa Majanduspiirkonna lepinguriiki või Šveitsi Konföderatsiooni; perehüvitiste saamine välisriigilt.",
      "rdfs:label": {
        "@value": "PEREHU_Par_9 (redaktsioon 106072023062)",
        "@language": "et"
