      },
      "estleg:versionText": "2024. aasta 1. jaanuaril jõustunud elatisabi suurust rakendatakse alates 2024. aasta jaanuari eest makstavast elatisabist.",
      "rdfs:label": {
        "@value": "PEREHU_Par_63_8 (redaktsioon 106072023062)",
        "@language": "et"
