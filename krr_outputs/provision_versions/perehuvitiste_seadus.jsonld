    },
    {
      "@id": "estleg:PEREHU_Par_63_6_v131032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_63_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 39 lõigetes 61–63 sätestatut rakendatakse tagasiulatuvalt ajavahemikus 2021. aasta 1. jaanuarist kuni 2023. aasta 31. detsembrini sündinud laste puhul. , kehtib kuni 31.12.2026",
      "rdfs:label": {
        "@value": "PEREHU_Par_63_6 (redaktsioon 131032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131032022013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131032022013",
      "estleg:sourceAct": "Perehüvitiste seadus",
      "estleg:provisionRef": "PEREHU § 63_6",
      "estleg:partOfAct": {
        "@id": "estleg:PEREHU_Map"
      }
    },
    {
      "@id": "estleg:PEREHU_Par_63_7_v111012023009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_63_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õigus lasterikka pere toetuse maksmise jätkamisele käesoleva seaduse § 21 lõike 4 või 5 alusel on neil, kellel on õigus lasterikka pere toetusele 2023. aasta 1. jaanuari seisuga või pärast seda. (2) Käesoleva seaduse § 21 lõike 4 või 5 alusel makstakse lasterikka pere toetus ajavahemiku eest 2023. aasta 1. jaanuarist kuni 2023. aasta 31. märtsini välja hiljemalt 2023. aasta 31. märtsiks. (3) Kui lapsetoetuse maksmine on enne 2023. aasta 1. jaanuari lõpetatud ja toetus määratakse 2023. aasta 1. jaanuarist uuesti, makstakse peretoetused ajavahemiku eest 2023. aasta 1. jaanuarist kuni 2023. aasta 31. märtsini välja hiljemalt 2023. aasta 31. märtsiks. (4) Käesoleva seaduse § 17 lõikes 3, § 19 lõikes 3 ning § 21 lõigetes 2 ja 3 sätestatud peretoetuse 2023. aasta jaanuaris väljamakstud toetuse suuruse ja 2023. aasta 1. veebruarist jõustunud toetuse suuruse vahe makstakse välja hiljemalt 2023. aasta 31. maiks.",
      "rdfs:label": {
        "@value": "PEREHU_Par_63_7 (redaktsioon 111012023009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111012023009",
      "estleg:supersededByVersion": {
        "@id": "estleg:PEREHU_Par_63_7_v106072023062"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/111012023009",
      "estleg:sourceAct": "Perehüvitiste seadus",
      "estleg:provisionRef": "PEREHU § 63_7",
      "estleg:partOfAct": {
        "@id": "estleg:PEREHU_Map"
      }
