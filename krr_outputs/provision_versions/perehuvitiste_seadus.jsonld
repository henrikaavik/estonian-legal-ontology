      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "PEREHU_Par_24 (redaktsioon 128112017023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128112017023",
