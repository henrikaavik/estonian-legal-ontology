      }
    },
    {
      "@id": "estleg:PEREHU_Par_21_v124122016004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seitsme- ja enamalapselise pere vanema toetuse saamise õigus on ühel vanematest, hooldajal või eestkostjal, kes kasvatab peres seitset või enamat last, kes vastavad käesoleva seaduse § 17 lõikes 1 või 2 sätestatud tingimustele. (2) Seitsme- ja enamalapselise pere vanema toetuse suurus on 168,74 eurot.",
      "rdfs:label": {
        "@value": "PEREHU_Par_21 (redaktsioon 124122016004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "124122016004",
      "estleg:supersededByVersion": {
        "@id": "estleg:PEREHU_Par_21_v124122016005"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/124122016004",
      "estleg:sourceAct": "Perehüvitiste seadus",
      "estleg:provisionRef": "PEREHU § 21",
      "estleg:partOfAct": {
        "@id": "estleg:PEREHU_Map"
      }
    },
    {
      "@id": "estleg:PEREHU_Par_21_v124122016005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lasterikka pere toetuse saamise õigus on ühel vanemal, hooldajal või eestkostjal või käesoleva seaduse § 25 lõike 1 punktis 2 või 3 nimetatud isikul, kes kasvatab peres kolme või enamat last, kes vastavad käesoleva seaduse § 17 lõikes 1 või 2 sätestatud tingimustele. (2) Lasterikka pere toetuse suurus kolme kuni kuut last kasvatavale perele on 300 eurot. (3) Lasterikka pere toetuse suurus seitset või enamat last kasvatavale perele on 400 eurot.",
      "rdfs:label": {
        "@value": "PEREHU_Par_21 (redaktsioon 124122016005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "124122016005",
      "estleg:supersededByVersion": {
        "@id": "estleg:PEREHU_Par_21_v128112017023"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/124122016005",
      "estleg:sourceAct": "Perehüvitiste seadus",
      "estleg:provisionRef": "PEREHU § 21",
      "estleg:partOfAct": {
        "@id": "estleg:PEREHU_Map"
      }
    },
    {
      "@id": "estleg:PEREHU_Par_21_v128112017023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PEREHU_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lasterikka pere toetuse saamise õigus on ühel vanemal, hoolduspere vanemal või eestkostjal või käesoleva seaduse § 25 lõike 1 punktis 2 või 3 nimetatud isikul, kes kasvatab peres kolme või enamat last, kes vastavad käesoleva seaduse § 17 lõikes 1 või 2 sätestatud tingimustele. (2) Lasterikka pere toetuse suurus kolme kuni kuut last kasvatavale perele on 300 eurot. (3) Lasterikka pere toetuse suurus seitset või enamat last kasvatavale perele on 400 eurot.",
      "rdfs:label": {
        "@value": "PEREHU_Par_21 (redaktsioon 128112017023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128112017023",
      "estleg:supersededByVersion": {
