      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega sätestatakse joobeseisundile viitavate tunnuste loetelu ja nende tunnuste esinemise või mitteesinemise tuvastamise viisid. Käesoleva määrusega sätestatakse joobeseisundile viitavate tunnuste loetelu ja nende tunnuste esinemise või mitteesinemise tuvastamise viisid.",
      "rdfs:label": {
        "@value": "Reg_1024899_Par_1 (redaktsioon 1024899)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024899",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024899",
      "estleg:sourceAct": "Joobeseisundile viitavate tunnuste loetelu ja nende tunnuste esinemise või mitteesinemise tuvastamise viisid",
      "estleg:provisionRef": "Reg_1024899 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024899_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024899_Par_2_v1024899",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024899_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isiku võimalikule joobeseisundile viitavad tunnused on: 1 1) isiku välimus; 2 2) aeglustunud reaktsioon; 3 3) häirunud kõne; 4 4) aja, isiku ja koha tajumise häired; 5 5) teadvuse seisund; 6 6) mäluhäired; 7 7) koordinatsioonihäired; 8 8) käitumishäired. Isiku võimalikule joobeseisundile viitavad tunnused on: isiku välimus; aeglustunud reaktsioon; häirunud kõne; aja, isiku ja koha tajumise häired; teadvuse seisund; mäluhäired; koordinatsioonihäired; käitumishäired. 2 (2) Lisaks käesoleva paragrahvi lõikes 1 nimetatud tunnustele võib isikul esineda joobeseisundile viitavate tunnustena: 1 1) alkoholi tarvitamisest põhjustatud alkoholijoobe korral alkoholilõhn väljahingatavas õhus; 2 2) narkootilise või psühhotroopse aine või muu sarnase joovastava aine tarvitamisest põhjustatud joobeseisundi korral hälbed silmade välimuses ja silmavaates. Lisaks käesoleva paragrahvi lõikes 1 nimetatud tunnustele võib isikul esineda joobeseisundile viitavate tunnustena: alkoholi tarvitamisest põhjustatud alkoholijoobe korral alkoholilõhn väljahingatavas õhus; narkootilise või psühhotroopse aine või muu sarnase joovastava aine tarvitamisest põhjustatud joobeseisundi korral hälbed silmade välimuses ja silmavaates.",
      "rdfs:label": {
        "@value": "Reg_1024899_Par_2 (redaktsioon 1024899)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024899",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024899",
      "estleg:sourceAct": "Joobeseisundile viitavate tunnuste loetelu ja nende tunnuste esinemise või mitteesinemise tuvastamise viisid",
      "estleg:provisionRef": "Reg_1024899 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024899_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024899_Par_3_v1024899",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024899_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Joobeseisundile viitavate tunnuste esinemist või mitteesinemist kontrollib politsei või seaduses sätestatud juhul muu korrakaitseorgan: 1 1) käesoleva määruse § 2 lõike 1 punktides 1, 2, 5, 7 ja 8 loetletud tunnuseid isiku välise vaatluse abil; 2 2) käesoleva määruse § 2 lõike 1 punktides 3, 4 ja 6 loetletud tunnuseid isiku küsitlemise abil. Joobeseisundile viitavate tunnuste esinemist või mitteesinemist kontrollib politsei või seaduses sätestatud juhul muu korrakaitseorgan: käesoleva määruse § 2 lõike 1 punktides 1, 2, 5, 7 ja 8 loetletud tunnuseid isiku välise vaatluse abil; käesoleva määruse § 2 lõike 1 punktides 3, 4 ja 6 loetletud tunnuseid isiku küsitlemise abil.",
      "rdfs:label": {
        "@value": "Reg_1024899_Par_3 (redaktsioon 1024899)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024899",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024899",
      "estleg:sourceAct": "Joobeseisundile viitavate tunnuste loetelu ja nende tunnuste esinemise või mitteesinemise tuvastamise viisid",
      "estleg:provisionRef": "Reg_1024899 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024899_Map_2026"
      }
    },
