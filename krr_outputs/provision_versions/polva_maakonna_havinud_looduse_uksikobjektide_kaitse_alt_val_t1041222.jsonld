        "@type": "xsd:date"
      },
      "estleg:versionText": "Põlva maakonna looduse üksikobjektide kaitse alla võtmise otsuste kehtetuks tunnistamise menetlus viidi läbi keskkonnaministri 2. septembri 2010. a käskkirjaga nr 1246 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Põlva maakonna looduse üksikobjektide kaitse alla võtmise otsuste kehtetuks tunnistamise menetlus viidi läbi keskkonnaministri 2. septembri 2010. a käskkirjaga nr 1246 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1041222_Par_4 (redaktsioon 1041222)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041222",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041222",
      "estleg:sourceAct": "Põlva maakonna hävinud looduse üksikobjektide kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1041222 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041222_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1041222_Par_5_v1041222",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
