      }
    },
    {
      "@id": "estleg:ESMKSPR_Par_2_v735324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ESMKSPR_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud Euroopa sotsiaal- ja meditsiiniabi konventsiooni protokoll, mis on sõlmitud 1953. aasta 11. detsembril Pariisis ja millele Eesti Vabariik on alla kirjutanud 1999. aasta 1. detsembril Strasbourg’is.",
      "rdfs:label": {
        "@value": "ESMKSPR_Par_2 (redaktsioon 735324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735324",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735324",
      "estleg:sourceAct": "Euroopa sotsiaal- ja meditsiiniabi konventsiooni ning selle protokolli ratifitseerimise seadus",
      "estleg:provisionRef": "ESMKSPR § 2",
      "estleg:partOfAct": {
        "@id": "estleg:ESMKSPR_Map_2026"
      }
    },
    {
      "@id": "estleg:ESMKSPR_Par_3_v735324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ESMKSPR_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konventsiooni artikli 2 b alusel teeb Eesti Vabariik järgmised reservatsioonid: Eesti Vabariik kohaldab artiklites 6 a ja 11 a sätestatud riigis seadusliku elamise suhtes välismaalaste seadust (RT I 1993, 44, 637; 1999, 50, 548; 54, 582; 71, 686; 88, 808; 101, 900; 2000, 25, 148; 33, 197; 40, 254; 2001, 16, 68; RT III 2001, 7, 75; RT I 2001, 58, 352; 2002, 56, 351; 63, 387; 90, 521; 102, 599; 2003, 4, 20; 88, 594; 2004, 2, 2), pagulaste seadust (RT I 1997, 19, 306; 1999, 18, 301; 25, 365; 2001, 16, 68; 2002, 42, 266; 61, 375; 2003, 13, 65) ja Euroopa Liidu kodaniku seadust (RT I 2002, 102, 599), mille kohaselt võib Eestis seaduslik elamine sõltuda püsiva legaalse sissetuleku olemasolust ning seaduslikku elamist tõendava dokumendi õigeaegselt pikendamiseks esitamisest; Eesti Vabariik kannab artiklis 8 a nimetatud kulutusi, lähtudes välismaalaste seadusest.",
      "rdfs:label": {
        "@value": "ESMKSPR_Par_3 (redaktsioon 735324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735324",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735324",
      "estleg:sourceAct": "Euroopa sotsiaal- ja meditsiiniabi konventsiooni ning selle protokolli ratifitseerimise seadus",
      "estleg:provisionRef": "ESMKSPR § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ESMKSPR_Map_2026"
      }
    },
    {
      "@id": "estleg:ESMKSPR_Par_4_v735324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ESMKSPR_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konventsiooni artikli 2 a ii alusel deklareerib Eesti Vabariik, et mõiste «kodanik» käesoleva konventsiooni tähenduses hõlmab Eesti kodanikke ja mõiste «territoorium» hõlmab Eesti Vabariigi jurisdiktsiooni all olevat territooriumi.",
      "rdfs:label": {
        "@value": "ESMKSPR_Par_4 (redaktsioon 735324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735324",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735324",
      "estleg:sourceAct": "Euroopa sotsiaal- ja meditsiiniabi konventsiooni ning selle protokolli ratifitseerimise seadus",
      "estleg:provisionRef": "ESMKSPR § 4",
      "estleg:partOfAct": {
        "@id": "estleg:ESMKSPR_Map_2026"
      }
    }
  ]
}
