        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001120_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nõukogu koosolekud protokollib nõukogu sekretär. Protokollile kirjutavad alla koosoleku juhataja ja sekretär. Nõukogu koosolekud protokollib nõukogu sekretär. Protokollile kirjutavad alla koosoleku juhataja ja sekretär. 2 (2) Nõukogu sekretär edastab protokollid nõukogu liikmetele seitsme tööpäeva jooksul pärast koosoleku toimumist ning avaldab protokolli otsuste osa nõukogu kodulehel. Nõukogu sekretär edastab protokollid nõukogu liikmetele seitsme tööpäeva jooksul pärast koosoleku toimumist ning avaldab protokolli otsuste osa nõukogu kodulehel.",
      "rdfs:label": {
