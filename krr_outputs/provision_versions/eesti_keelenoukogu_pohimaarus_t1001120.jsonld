    {
      "@id": "estleg:Reg_1001120_Par_1_v1001120",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001120_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti keelenõukogu on Vabariigi Valitsuse moodustatav Vabariigi Valitsust keelepoliitika arendamisel ja elluviimisel nõustav kogu. Eesti keelenõukogu on Vabariigi Valitsuse moodustatav Vabariigi Valitsust keelepoliitika arendamisel ja elluviimisel nõustav kogu. 2 (2) Keelenõukogu nõustab järgmistes valdkondades: 1 1) keeleõpe ja haridus; 2 2) eesti keele ja teiste keelte uurimine; 3 3) eesti keele korraldus; 4 4) eesti keele tehnoloogia; 5 5) eesti keele erikujud; 6 6) keelealane mainekujundus ja keelejärelevalve; 7 7) mitmekeelsus ühiskonna ja indiviidi tasandil; 8 8) muud keelevaldkonna küsimused. RT I 2026-03-19 2 119032026002 2026-03-22 Keelenõukogu nõustab järgmistes valdkondades: keeleõpe ja haridus; eesti keele ja teiste keelte uurimine; eesti keele korraldus; eesti keele tehnoloogia; eesti keele erikujud; keelealane mainekujundus ja keelejärelevalve; mitmekeelsus ühiskonna ja indiviidi tasandil; muud keelevaldkonna küsimused.",
      "rdfs:label": {
        "@value": "Reg_1001120_Par_1 (redaktsioon 1001120)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001120",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001120",
      "estleg:sourceAct": "Eesti keelenõukogu põhimäärus",
      "estleg:provisionRef": "Reg_1001120 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001120_Map"
      }
