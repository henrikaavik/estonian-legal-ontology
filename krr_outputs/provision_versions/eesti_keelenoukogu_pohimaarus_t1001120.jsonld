    {
      "@id": "estleg:Reg_1001120_Par_10_v1001120",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001120_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nõukogul on oma ülesannete täitmiseks õigus saada asjaomastelt riigi- ja kohaliku omavalitsuse asutustelt ning teistelt isikutelt ja asutustelt tööks vajalikke dokumente ja asjakohast informatsiooni. Nõukogul on oma ülesannete täitmiseks õigus saada asjaomastelt riigi- ja kohaliku omavalitsuse asutustelt ning teistelt isikutelt ja asutustelt tööks vajalikke dokumente ja asjakohast informatsiooni. 2 (2) Nõukogu võib kaasata oma töösse eksperte ja moodustada eksperdirühmi. Nõukogu võib kaasata oma töösse eksperte ja moodustada eksperdirühmi.",
      "rdfs:label": {
        "@value": "Reg_1001120_Par_10 (redaktsioon 1001120)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001120",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001120",
      "estleg:sourceAct": "Eesti keelenõukogu põhimäärus",
      "estleg:provisionRef": "Reg_1001120 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001120_Map"
      }
    },
    {
      "@id": "estleg:Reg_1001120_Par_11_v1001120",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001120_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nõukogu tegevust rahastatakse riigieelarvest Haridus- ja Teadusministeeriumi eelarve kaudu. Nõukogu tegevust rahastatakse riigieelarvest Haridus- ja Teadusministeeriumi eelarve kaudu. 2 (2) Nõukogu liikmele, välja arvatud teenistuses olevale ametnikust nõukogu liikmele, võib maksta tasu §-s 3 nimetatud ülesannete täitmise eest. RT I 2026-03-19 2 119032026002 2026-03-22 Nõukogu liikmele, välja arvatud teenistuses olevale ametnikust nõukogu liikmele, võib maksta tasu §-s 3 nimetatud ülesannete täitmise eest. 3 (3) Tasu võib maksta ka teistele nõukogu tööga seotud isikutele. RT I 2026-03-19 2 119032026002 2026-03-22 Tasu võib maksta ka teistele nõukogu tööga seotud isikutele. 4 (4) Tasu määrab nõukogu esimees, kooskõlastades ettepaneku eelnevalt Haridus- ja Teadusministeeriumiga. RT I 2026-03-19 2 119032026002 2026-03-22 Tasu määrab nõukogu esimees, kooskõlastades ettepaneku eelnevalt Haridus- ja Teadusministeeriumiga. 5 (5) Tasu määramisel arvestatakse järgmiste kriteeriumidega: 1 1) liikme või muu tasu saava isiku osalemine nõukogu koosolekutel ja töögruppides; 2 2) täidetud ülesannete maht, keerukus ja vastutuse tase; 3 3) erialase kompetentsi või eksperditeadmiste rakendamine nõukogu töös; 4 4) nõukogu töökorra alusel täidetud lisaülesanded, sealhulgas analüüsi-, aruande-, hindamis- ja esindusülesanded; 5 5) kokkulepitud ajakulu või tegelik tööpanus. RT I 2026-03-19 2 119032026002 2026-03-22 Tasu määramisel arvestatakse järgmiste kriteeriumidega: liikme või muu tasu saava isiku osalemine nõukogu koosolekutel ja töögruppides; täidetud ülesannete maht, keerukus ja vastutuse tase; erialase kompetentsi või eksperditeadmiste rakendamine nõukogu töös; nõukogu töökorra alusel täidetud lisaülesanded, sealhulgas analüüsi-, aruande-, hindamis- ja esindusülesanded; kokkulepitud ajakulu või tegelik tööpanus.",
      "rdfs:label": {
