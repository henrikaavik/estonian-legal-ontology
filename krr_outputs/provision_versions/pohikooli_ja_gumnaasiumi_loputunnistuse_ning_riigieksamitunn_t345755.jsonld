      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hinneteleht vormistatakse A4-formaadis turvaelementidega plangile, kuhu on trükitud sõna „HINNETELEHT” ja hinnetelehe number. Hinnetelehe vorm esitatakse lisas 3. Hinneteleht vormistatakse A4-formaadis turvaelementidega plangile, kuhu on trükitud sõna „HINNETELEHT” ja hinnetelehe number. Hinnetelehe vorm esitatakse lisas 3. 2 (2) Hinnetelehe plangi põhivärv on hallikassinine. Hinnetelehe plangi põhivärv on hallikassinine.",
      "rdfs:label": {
        "@value": "Reg_345755_Par_10 (redaktsioon 345755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345755",
