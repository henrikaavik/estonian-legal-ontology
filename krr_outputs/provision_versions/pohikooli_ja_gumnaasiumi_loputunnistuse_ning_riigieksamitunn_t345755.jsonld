      "estleg:provisionRef": "Reg_345755 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345755_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_345755_Par_18_v345755",
      "@type": [
