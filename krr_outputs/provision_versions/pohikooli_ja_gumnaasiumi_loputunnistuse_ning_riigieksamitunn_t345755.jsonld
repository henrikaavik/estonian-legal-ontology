    {
      "@id": "estleg:Reg_345755_Par_12_v345755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345755_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hinneteleht kinnitatakse kooli direktori ja õppenõukogu sekretäri allkirjade ning kooli pitseriga. Hinneteleht kinnitatakse kooli direktori ja õppenõukogu sekretäri allkirjade ning kooli pitseriga. 2 (2) Hinneteleht antakse koos lõputunnistusega lõputunnistuse saajale või volitatud isikule kirjaliku volituse alusel. Hinneteleht antakse koos lõputunnistusega lõputunnistuse saajale või volitatud isikule kirjaliku volituse alusel.",
      "rdfs:label": {
