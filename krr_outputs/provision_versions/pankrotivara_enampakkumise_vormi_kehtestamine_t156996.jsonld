    {
      "@id": "estleg:Reg_156996_Par_2_v156996",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156996_Par_2"
