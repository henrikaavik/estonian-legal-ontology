  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_rahvastikuregistrisse_kantud_isiku_enda_tema_alaealiste_last_t1055631_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Rahvastikuregistrisse kantud isiku enda, tema alaealiste laste ja eestkostetavate ning surnud abikaasa või surnud registreeritud elukaaslase andmete loetelu nendele juurdepääsu tagaja kaupa (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Rahvastikuregistrisse kantud isiku enda, tema alaealiste laste ja eestkostetavate ning surnud abikaasa või surnud registreeritud elukaaslase andmete loetelu nendele juurdepääsu tagaja kaupa"
    },
    {
      "@id": "estleg:Reg_1055631_Par_1_v1055631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055631_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Volitatud töötleja tagab turvalise veebikeskkonna kaudu juurdepääsu rahvastikuregistri seaduse § 45 lõikes 1 nimetatud isiku enda ning tema alaealise lapse ja eestkostetava kohta rahvastikuregistrisse kantud järgmistele andmetele: 1 1) rahvastikuregistri seaduse § 21 lõikes 1 nimetatud andmed; 2 2) rahvastikuregistri seaduse § 22 lõike 1 punktides 1, 2, 4, 6, 9 ja 10 nimetatud andmed; 3 3) rahvastikuregistri seaduse §-s 23 nimetatud andmed isiku enda kohta hiljemalt 10. päeval enne valimispäeva; 4 4) rahvastikuregistri seaduse § 25 punktides 1–4 nimetatud andmed; 5 5) rahvastikuregistri seaduse § 26 lõike 1 punktis 1 nimetatud isikuandmed. Volitatud töötleja tagab turvalise veebikeskkonna kaudu juurdepääsu rahvastikuregistri seaduse § 45 lõikes 1 nimetatud isiku enda ning tema alaealise lapse ja eestkostetava kohta rahvastikuregistrisse kantud järgmistele andmetele: rahvastikuregistri seaduse § 21 lõikes 1 nimetatud andmed; rahvastikuregistri seaduse § 22 lõike 1 punktides 1, 2, 4, 6, 9 ja 10 nimetatud andmed; rahvastikuregistri seaduse §-s 23 nimetatud andmed isiku enda kohta hiljemalt 10. päeval enne valimispäeva; rahvastikuregistri seaduse § 25 punktides 1–4 nimetatud andmed; rahvastikuregistri seaduse § 26 lõike 1 punktis 1 nimetatud isikuandmed. 2 (2) Volitatud töötleja tagab rahvastikuregistri seaduse § 25 punktis 3 nimetatud andmetele juurdepääsu lisaks turvalisele veebikeskkonnale sama seaduse § 48 lõike 1 punktis 5 nimetatud viisidel. Volitatud töötleja tagab rahvastikuregistri seaduse § 25 punktis 3 nimetatud andmetele juurdepääsu lisaks turvalisele veebikeskkonnale sama seaduse § 48 lõike 1 punktis 5 nimetatud viisidel.",
      "rdfs:label": {
        "@value": "Reg_1055631_Par_1 (redaktsioon 1055631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055631",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055631",
      "estleg:sourceAct": "Rahvastikuregistrisse kantud isiku enda, tema alaealiste laste ja eestkostetavate ning surnud abikaasa või surnud registreeritud elukaaslase andmete loetelu nendele juurdepääsu tagaja kaupa",
      "estleg:provisionRef": "Reg_1055631 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055631_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055631_Par_2_v1055631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055631_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maakonnakeskuse kohaliku omavalitsuse üksus tagab juurdepääsu rahvastikuregistri seaduse § 45 lõikes 1 nimetatud isiku enda, tema alaealise lapse ja eestkostetava ning surnud abikaasa või registreeritud elukaaslase kohta rahvastikuregistrisse kantud andmetele, mis on nimetatud sama seaduse § 21 lõikes 1, §-des 22–24, § 25 punktides 1, 2 ja 4 ning § 26 lõigetes 1 ja 2. RT I 2023-12-19 15 119122023015 2024-01-01 Maakonnakeskuse kohaliku omavalitsuse üksus tagab juurdepääsu rahvastikuregistri seaduse § 45 lõikes 1 nimetatud isiku enda, tema alaealise lapse ja eestkostetava ning surnud abikaasa või registreeritud elukaaslase kohta rahvastikuregistrisse kantud andmetele, mis on nimetatud sama seaduse § 21 lõikes 1, §-des 22–24, § 25 punktides 1, 2 ja 4 ning § 26 lõigetes 1 ja 2.",
      "rdfs:label": {
        "@value": "Reg_1055631_Par_2 (redaktsioon 1055631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055631",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055631",
      "estleg:sourceAct": "Rahvastikuregistrisse kantud isiku enda, tema alaealiste laste ja eestkostetavate ning surnud abikaasa või surnud registreeritud elukaaslase andmete loetelu nendele juurdepääsu tagaja kaupa",
      "estleg:provisionRef": "Reg_1055631 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055631_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055631_Par_3_v1055631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055631_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvastikuregistri seaduse § 52 lõikes 2 sätestatud muu asutus või isik tagab sama seaduse § 50 lõikes 1 nimetatud haldusaktis sätestatud ulatuses juurdepääsu sama seaduse § 45 lõikes 1 nimetatud isiku enda, tema alaealise lapse ja eestkostetava ning surnud abikaasa või registreeritud elukaaslase kohta rahvastikuregistrisse kantud andmetele, mis on nimetatud sama seaduse § 21 lõikes 1, §-des 22 ja 23, § 25 punktides 1, 2 ja 4 ning § 26 lõike 1 punktides 1–5 ja lõikes 2. RT I 2023-12-19 15 119122023015 2024-01-01 Rahvastikuregistri seaduse § 52 lõikes 2 sätestatud muu asutus või isik tagab sama seaduse § 50 lõikes 1 nimetatud haldusaktis sätestatud ulatuses juurdepääsu sama seaduse § 45 lõikes 1 nimetatud isiku enda, tema alaealise lapse ja eestkostetava ning surnud abikaasa või registreeritud elukaaslase kohta rahvastikuregistrisse kantud andmetele, mis on nimetatud sama seaduse § 21 lõikes 1, §-des 22 ja 23, § 25 punktides 1, 2 ja 4 ning § 26 lõike 1 punktides 1–5 ja lõikes 2.",
      "rdfs:label": {
        "@value": "Reg_1055631_Par_3 (redaktsioon 1055631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055631",
