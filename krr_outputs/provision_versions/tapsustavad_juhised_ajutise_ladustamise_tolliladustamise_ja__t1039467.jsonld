    {
      "@id": "estleg:Reg_1039467_Par_7_v1039467",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039467_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabatsoonis tegutsemise loale märgitakse vähemalt järgmised andmed: 1 1) loa nimetus; 2 2) vabatsooni nimetus; 3 3) loa omaniku nimi, EORI-number või isiku- või registrikood ja aadress; 4 4) loa registreerimisnumber; 5 5) järelevalve tolliasutuse nimetus; 6 6) vabatsoonis tegevuskoha aadress; 7 7) loa omaniku tööaeg; 8 8) loa omaniku ja tolli kontaktandmed; 9 9) arvestuse andmekoosseis; 10 10) lubatud käitlemistoimingud; 11 11) tollijärelevalve teostamiseks vajalikud nõuded; 12 12) loa väljastamise kuupäev; 13 13) loa kehtima hakkamise kuupäev; 14 14) loa väljastanud tolliasutuse nimetus. Vabatsoonis tegutsemise loale märgitakse vähemalt järgmised andmed: loa nimetus; vabatsooni nimetus; loa omaniku nimi, EORI-number või isiku- või registrikood ja aadress; loa registreerimisnumber; järelevalve tolliasutuse nimetus; vabatsoonis tegevuskoha aadress; loa omaniku tööaeg; loa omaniku ja tolli kontaktandmed; arvestuse andmekoosseis; lubatud käitlemistoimingud; tollijärelevalve teostamiseks vajalikud nõuded; loa väljastamise kuupäev; loa kehtima hakkamise kuupäev; loa väljastanud tolliasutuse nimetus.",
      "rdfs:label": {
        "@value": "Reg_1039467_Par_7 (redaktsioon 1039467)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039467",
