    },
    {
      "@id": "estleg:Reg_1039467_Par_19_v1039467",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039467_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kauba omaniku vahetumisel lisatakse arvestusse järgmised andmed: 1 1) paragrahvi 14 lõike 1 punktis 2 nimetatud andmed kauba uue omaniku kohta; 2 2) omaniku vahetust tõendava dokumendi number ja kuupäev; 3 3) kauba kogus; 4 4) tollilao puhul kauba väärtus. Kauba omaniku vahetumisel lisatakse arvestusse järgmised andmed: paragrahvi 14 lõike 1 punktis 2 nimetatud andmed kauba uue omaniku kohta; omaniku vahetust tõendava dokumendi number ja kuupäev; kauba kogus; tollilao puhul kauba väärtus.",
      "rdfs:label": {
        "@value": "Reg_1039467_Par_19 (redaktsioon 1039467)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039467",
