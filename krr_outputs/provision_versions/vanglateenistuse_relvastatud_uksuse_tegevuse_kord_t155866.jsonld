      },
      "estleg:versionText": "Üksuse koosseisu kuuluvat liiget tasustatakse justiitsministri käskkirja alusel selle vangla eelarvest, kelle koosseisu liige kuulub. Üksuse koosseisu kuuluvat liiget tasustatakse justiitsministri käskkirja alusel selle vangla eelarvest, kelle koosseisu liige kuulub.",
      "rdfs:label": {
        "@value": "Reg_155866_Par_12 (redaktsioon 155866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155866",
      "estleg:sourceAct": "Vanglateenistuse relvastatud üksuse tegevuse kord",
      "estleg:provisionRef": "Reg_155866 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155866_Map"
      }
    },
    {
      "@id": "estleg:Reg_155866_Par_12_17_v155866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155866_Par_12_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rühma liige on üksuse koosseisu nimetatud isik, kes on kohustatud: 1 1) osalema üksuse ülesannete täitmisel ja väljaõppel; 2 2) teavitama viivitamatult rühma juhti tööalasel koolitusel osalemisest; 3 3) täitma rühma juhilt üksuse tegevusega seoses saadud ülesandeid. RTL 2009 57 826 13204418 2009-07-20+03:00 Rühma liige on üksuse koosseisu nimetatud isik, kes on kohustatud: osalema üksuse ülesannete täitmisel ja väljaõppel; teavitama viivitamatult rühma juhti tööalasel koolitusel osalemisest; täitma rühma juhilt üksuse tegevusega seoses saadud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_155866_Par_12_17 (redaktsioon 155866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155866",
      "estleg:sourceAct": "Vanglateenistuse relvastatud üksuse tegevuse kord",
      "estleg:provisionRef": "Reg_155866 § 12_17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155866_Map"
      }
    },
