    },
    {
      "@id": "estleg:Reg_1054499_Par_8_v1054499",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054499_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervisekontrolli tegija vormistab tervisekontrolli kaardi alusel lisas 2 esitatud vormi kohase tervisetõendi ja väljastab selle abipolitseinikule või abipolitseinikuks astuda soovijale. Tervisekontrolli tegija vormistab tervisekontrolli kaardi alusel lisas 2 esitatud vormi kohase tervisetõendi ja väljastab selle abipolitseinikule või abipolitseinikuks astuda soovijale. 2 (2) Tervisekontrolli tegija märgib tervisetõendile abipolitseiniku või abipolitseinikuks astuda soovija suhtes terviseseisundi tõttu rakendatava erinõude või piirangu. Tervisekontrolli tegija märgib tervisetõendile abipolitseiniku või abipolitseinikuks astuda soovija suhtes terviseseisundi tõttu rakendatava erinõude või piirangu.",
      "rdfs:label": {
        "@value": "Reg_1054499_Par_8 (redaktsioon 1054499)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054499",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054499",
      "estleg:sourceAct": "Abipolitseiniku ja abipolitseinikuks astuda soovija tervisekontrolli tingimused ja kord, abipolitseinikuks saamist välistavate tervisehäirete ja abipolitseiniku ülesande täitmisel tulirelva ja elektrišokirelva kandmist välistavate füüsiliste puuete loetelu ning tervisetõendi sisu ja vormi nõuded",
      "estleg:provisionRef": "Reg_1054499 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054499_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054499_Par_9_v1054499",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054499_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abipolitseinik või abipolitseinikuks astuda soovijal, kes on läbinud tervisekontrolli ja kellele on väljastatud tervisetõend enne käesoleva määruse jõustumist, tuleb läbida käesoleva määruse alusel tervisekontroll siis, kui tema tervisetõendi kehtivus hakkab lõppema. Abipolitseinik või abipolitseinikuks astuda soovijal, kes on läbinud tervisekontrolli ja kellele on väljastatud tervisetõend enne käesoleva määruse jõustumist, tuleb läbida käesoleva määruse alusel tervisekontroll siis, kui tema tervisetõendi kehtivus hakkab lõppema.",
