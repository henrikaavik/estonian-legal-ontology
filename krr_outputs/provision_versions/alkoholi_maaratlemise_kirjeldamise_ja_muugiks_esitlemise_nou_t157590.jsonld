    {
      "@id": "estleg:Reg_157590_Par_9_v157590",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157590_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu - RT I 2017-09-20 8 120092017008 2017-09-23 Kehtetu - 2 (2) Puuviljaveini kirjeldavas liitsõnalises nimetuses peab sõnale „vein” eelnema veini peamise tooraine nimetus. Peamise tooraine nimetuse asemel võib veini nimetuse eesosa sisaldada sõnu „puuvilja-”, „marja-” või „puuvilja-marja-”, kui on kasutatud erinevaid tooraineid, millest ükski ei ole domineeriv. RT I 2017-09-20 8 120092017008 2017-09-23 Puuviljaveini kirjeldavas liitsõnalises nimetuses peab sõnale „vein” eelnema veini peamise tooraine nimetus. Peamise tooraine nimetuse asemel võib veini nimetuse eesosa sisaldada sõnu „puuvilja-”, „marja-” või „puuvilja-marja-”, kui on kasutatud erinevaid tooraineid, millest ükski ei ole domineeriv. 3 (3) Kehtetu - RT I 2017-09-20 8 120092017008 2017-09-23 Kehtetu - 4 (4) Kehtetu - RT I 2017-09-20 8 120092017008 2017-09-23 Kehtetu -",
      "rdfs:label": {
