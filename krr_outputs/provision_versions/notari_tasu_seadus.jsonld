    },
    {
      "@id": "estleg:NOTARI_Par_48_v22353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOTARI_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse tähenduses ei ole notari tasuks välisesinduste ametiisikute ja valla- ning linnasekretäride poolt tehtavate notariaaltoimingute eest makstav riigilõiv.",
      "rdfs:label": {
        "@value": "NOTARI_Par_48 (redaktsioon 22353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22353"
    },
    {
      "@id": "estleg:NOTARI_Par_49_v22353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOTARI_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "NOTARI_Par_49 (redaktsioon 22353)",
        "@language": "et"
      },
