        "@id": "estleg:NOTARI_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohus on tunnistanud notari tegevuse notari tasu sissenõudmisel või selle suuruse määramisel seadusevastaseks, tagastab notar kohustatud isikule alusetult nõutud ja tasutud summa 10 päeva jooksul, arvates kohtuotsuse jõustumisest.",
      "rdfs:label": {
