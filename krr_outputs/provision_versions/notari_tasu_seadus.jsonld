    {
      "@id": "estleg:NOTARI_Par_25_v22353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOTARI_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistamisavalduse, sealhulgas laevakinnistamisavalduse aluseks olev võlaõiguslik tehing on eelnevalt juba notariaalselt tõestatud, on notari tasu kinnistamisavalduse või kinnistatud laeva omandiõiguse ülemineku kokkuleppe tõestamise eest 50 krooni. Kui kinnistamisavaldus on ühes dokumendis vastava võlaõigusliku tehinguga, siis kinnistamisavalduse tõestamise eest tasu ei võeta.",
      "rdfs:label": {
        "@value": "NOTARI_Par_25 (redaktsioon 22353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22353",
      "estleg:supersededByVersion": {
        "@id": "estleg:NOTARI_Par_25_v13185136"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NOTARI_Par_25_v13185136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOTARI_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-06-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui asjaõiguslepingu, sealhulgas laeva omandiõiguse ülemineku kokkuleppe aluseks olev võlaõiguslik tehing on eelnevalt juba notariaalselt tõestatud, on notari tasu asjaõiguslepingu või laeva omandiõiguse ülemineku kokkuleppe tõestamise eest 300 krooni. Kui asjaõigusleping ja kinnistamisavaldus on ühes dokumendis vastava võlaõigusliku tehinguga, siis asjaõiguslepingu ja kinnistamisavalduse tõestamise eest tasu ei võeta.",
      "rdfs:label": {
        "@value": "NOTARI_Par_25 (redaktsioon 13185136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13185136",
      "estleg:supersededByVersion": {
        "@id": "estleg:NOTARI_Par_25_v131122010058"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NOTARI_Par_25_v131122010058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
