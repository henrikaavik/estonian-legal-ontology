    {
      "@id": "estleg:NOTARI_Par_22_v22353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOTARI_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tehinguväärtuse alusel arvutatakse notari tasu käesolevas paragrahvis toodud tehinguväärtuste ja täistasude tabeli järgi. Kuni 20 000 000 krooni - 15 000 krooni + 0,14% tehinguväärtuse summast, mis ületab 10 000 000 krooni; kuni 30 000 000 krooni - 29 000 krooni + 0,12% tehinguväärtuse summast, mis ületab 20 000 000 krooni; kuni 40 000 000 krooni - 41 000 krooni + 0,1% tehinguväärtuse summast, mis ületab 30 000 000 krooni; kuni 50 000 000 krooni - 51 000 krooni + 0,08% tehinguväärtuse summast, mis ületab 40 000 000 krooni; kuni 100 000 000 krooni - 59 000 krooni + 0,05% tehinguväärtuse summast, mis ületab 50 000 000 krooni; üle 100 000 000 krooni - 84 000 krooni + 0,02% tehinguväärtuse summast, mis ületab 100 000 000 krooni.",
      "rdfs:label": {
        "@value": "NOTARI_Par_22 (redaktsioon 22353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22353",
      "estleg:supersededByVersion": {
        "@id": "estleg:NOTARI_Par_22_v131122010058"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NOTARI_Par_22_v131122010058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOTARI_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tehinguväärtuse alusel arvutatakse notari tasu käesolevas paragrahvis toodud tehinguväärtuste ja täistasude tabeli järgi eurodes. (2) Kuni 1 278 235 eurot – 958,65 eurot + 0,14% tehinguväärtuse summast, mis ületab 639 120 eurot;kuni 1 917 350 eurot – 1853,40 eurot + 0,12% tehinguväärtuse summast, mis ületab 1 278 235 eurot;kuni 2 556 470 eurot – 2620,35 eurot + 0,1% tehinguväärtuse summast, mis ületab 1 917 350 eurot;kuni 3 195 585 eurot – 3259,45 eurot + 0,08% tehinguväärtuse summast, mis ületab 2 556 470 eurot;kuni 6 391 165 eurot – 3770,75 eurot + 0,05% tehinguväärtuse summast, mis ületab 3 195 585 eurot;üle 6 391 165 euro – 5368,55 eurot + 0,02% tehinguväärtuse summast, mis ületab 6 391 165 eurot.",
      "rdfs:label": {
        "@value": "NOTARI_Par_22 (redaktsioon 131122010058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010058",
      "estleg:supersededByVersion": {
        "@id": "estleg:NOTARI_Par_22_v114032011047"
      },
      "estleg:versionValidTo": {
        "@value": "2011-03-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NOTARI_Par_22_v114032011047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOTARI_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tehinguväärtuse alusel arvutatakse notari tasu käesolevas paragrahvis toodud tehinguväärtuste ja täistasude tabeli järgi eurodes. (2) Kuni 1 278 235 eurot – 958,65 eurot + 0,14% tehinguväärtuse summast, mis ületab 639 120 eurot; kuni 1 917 350 eurot – 1853,40 eurot + 0,12% tehinguväärtuse summast, mis ületab 1 278 235 eurot; kuni 2 556 470 eurot – 2620,35 eurot + 0,1% tehinguväärtuse summast, mis ületab 1 917 350 eurot; kuni 3 195 585 eurot – 3259,45 eurot + 0,08% tehinguväärtuse summast, mis ületab 2 556 470 eurot; kuni 6 391 165 eurot – 3770,75 eurot + 0,05% tehinguväärtuse summast, mis ületab 3 195 585 eurot; üle 6 391 165 euro – 5368,55 eurot + 0,02% tehinguväärtuse summast, mis ületab 6 391 165 eurot.",
      "rdfs:label": {
        "@value": "NOTARI_Par_22 (redaktsioon 114032011047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032011047"
    },
    {
      "@id": "estleg:NOTARI_Par_23_v22353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOTARI_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui käesoleva seaduse muudest sätetest ei tulene teisiti, on notari tasu tehingu tõestamise eest: ühepoolse tehingu puhul ühekordne täistasu; kahe- või mitmepoolse tehingu puhul kahekordne täistasu.",
      "rdfs:label": {
        "@value": "NOTARI_Par_23 (redaktsioon 22353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22353"
    },
    {
      "@id": "estleg:NOTARI_Par_24_v22353",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NOTARI_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Notari tasu kaasomandis oleva vara jagamise ja kasutuskorra kindlaksmääramise lepingu ning ühisvara jagamise lepingu tõestamise eest on ühekordne täistasu.",
      "rdfs:label": {
        "@value": "NOTARI_Par_24 (redaktsioon 22353)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22353",
      "estleg:supersededByVersion": {
        "@id": "estleg:NOTARI_Par_24_v13185136"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-07",
        "@type": "xsd:date"
      }
    },
