    {
      "@id": "estleg:Reg_308740_Par_22_27_v308740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308740_Par_22_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 31. detsembrini 2024. a kehtinud Vabariigi Valitsuse 19. detsembri 2012. a määruse nr 115 „Ametniku pikaajalisse välislähetusse saatmise kord, lähetustasu lähtesummad ning lähetustasu arvutamise ja maksmise kord, lähetuskulude hüvitamise tingimused ja kord, hüvitatavate ravikulude loetelu, kaasasoleva perekonnaliikme eest välislähetustasu suurendamise ja maksmise kord ning abikaasatasu maksmise tingimused ja kord” alusel välislähetusse saadetud ametniku välislähetusele kohaldatakse kuni lähetuse lõppemiseni selles määruses sätestatut. RT I 2024-12-21 1 121122024001 2025-01-01 Kuni 31. detsembrini 2024. a kehtinud Vabariigi Valitsuse 19. detsembri 2012. a määruse nr 115 „Ametniku pikaajalisse välislähetusse saatmise kord, lähetustasu lähtesummad ning lähetustasu arvutamise ja maksmise kord, lähetuskulude hüvitamise tingimused ja kord, hüvitatavate ravikulude loetelu, kaasasoleva perekonnaliikme eest välislähetustasu suurendamise ja maksmise kord ning abikaasatasu maksmise tingimused ja kord” alusel välislähetusse saadetud ametniku välislähetusele kohaldatakse kuni lähetuse lõppemiseni selles määruses sätestatut.",
      "rdfs:label": {
        "@value": "Reg_308740_Par_22_27 (redaktsioon 308740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308740",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308740",
      "estleg:sourceAct": "Välislähetustasu ning abikaasa- ja registreeritud elukaaslase tasu maksmise ning teenistuja kulude katmise kord",
      "estleg:provisionRef": "Reg_308740 § 22_27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308740_Map"
      }
    },
    {
      "@id": "estleg:Reg_308740_Par_23_v308740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
