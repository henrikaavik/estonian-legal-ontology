      }
    },
    {
      "@id": "estleg:Reg_1029724_Par_3_v1029724",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029724_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse seletuskirjas13 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide täiendamise kohta; 2 2) kaitstava loodusobjekti piiri kulgemise kohta. Käesoleva määruse seletuskirjas13 on esitatud põhjendused: kaitse alla võtmise eesmärkide täiendamise kohta; kaitstava loodusobjekti piiri kulgemise kohta.",
      "rdfs:label": {
        "@value": "Reg_1029724_Par_3 (redaktsioon 1029724)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029724",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029724",
      "estleg:sourceAct": "Tartu maakonna kaitsealuste parkide piirid",
      "estleg:provisionRef": "Reg_1029724 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029724_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029724_Par_4_v1029724",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029724_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist. Määrus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist.",
      "rdfs:label": {
        "@value": "Reg_1029724_Par_4 (redaktsioon 1029724)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029724",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029724",
      "estleg:sourceAct": "Tartu maakonna kaitsealuste parkide piirid",
      "estleg:provisionRef": "Reg_1029724 § 4",
