      "estleg:versionValidFrom": {
        "@value": "2015-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 14. mai 2002. a määrus nr 159 „Tartumaa kaitsealuste parkide välispiiride kirjeldused” tunnistatakse kehtetuks. Vabariigi Valitsuse 14. mai 2002. a määrus nr 159 „Tartumaa kaitsealuste parkide välispiiride kirjeldused” tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1029724_Par_6 (redaktsioon 1029724)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029724",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029724",
      "estleg:sourceAct": "Tartu maakonna kaitsealuste parkide piirid",
      "estleg:provisionRef": "Reg_1029724 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029724_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029724_Par_7_v1029724",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029724_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi ametlikus väljaandes Ametlikud Teadaanded 29. jaanuaril 2010. a teate avaldamisega algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi ametlikus väljaandes Ametlikud Teadaanded 29. jaanuaril 2010. a teate avaldamisega algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1029724_Par_7 (redaktsioon 1029724)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029724",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029724",
      "estleg:sourceAct": "Tartu maakonna kaitsealuste parkide piirid",
      "estleg:provisionRef": "Reg_1029724 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029724_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029724_Par_8_v1029724",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029724_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1029724_Par_8 (redaktsioon 1029724)",
        "@language": "et"
      },
