      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Toiduga kokku puutuda lubatud materjalide ja esemete kohta esitatavad nõuded, nende gruppide kohta esitatavad erinõuded ning nimetatud materjalide ja esemete ohutuse katsetamise meetodid (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Toiduga kokku puutuda lubatud materjalide ja esemete kohta esitatavad nõuded, nende gruppide kohta esitatavad erinõuded ning nimetatud materjalide ja esemete ohutuse katsetamise meetodid"
