    {
      "@id": "estleg:Reg_1053272_Par_4_v1053272",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053272_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isikukaart on ümarate nurkadega plastikust kaart mõõtmetega 85,5 × 54 millimeetrit. Isikukaart on ümarate nurkadega plastikust kaart mõõtmetega 85,5 × 54 millimeetrit. 2 (2) Isikukaardil on valge taust, millel jooksevad paremalt vasakule diagonaalsed helesinised triibud. Isikukaardil on valge taust, millel jooksevad paremalt vasakule diagonaalsed helesinised triibud. 3 (3) Isikukaart ja selle kanded trükitakse printeriga. Kirjed trükitakse musta värviga, kui käesolevas määruses ei sätestata teisiti. Isikukaart ja selle kanded trükitakse printeriga. Kirjed trükitakse musta värviga, kui käesolevas määruses ei sätestata teisiti. 4 (4) Isikukaardi kujutise näidis on esitatud määruse lisas „Meditsiinipersonali ja vaimuliku isikukaardi kujutise näidis”. Isikukaardi kujutise näidis on esitatud määruse lisas „Meditsiinipersonali ja vaimuliku isikukaardi kujutise näidis”.",
      "rdfs:label": {
        "@value": "Reg_1053272_Par_4 (redaktsioon 1053272)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053272",
