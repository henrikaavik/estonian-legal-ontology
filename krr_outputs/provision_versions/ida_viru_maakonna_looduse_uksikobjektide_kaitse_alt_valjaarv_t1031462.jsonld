    {
      "@id": "estleg:Reg_1031462_Par_5_v1031462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031462_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 11. novembri 2014. a käskkirjaga nr 872 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 11. novembri 2014. a käskkirjaga nr 872 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1031462_Par_5 (redaktsioon 1031462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031462",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031462",
