    {
      "@id": "estleg:Reg_1051456_Par_21_v1051456",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051456_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-03-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist rajatud ja selleks kohaliku omavalitsuse kirjaliku nõusoleku saanud lasketiirud ja laskepaigad peavad vastama määruse nõuetele hiljemalt 1. juulil 2022. aastal. Enne käesoleva määruse jõustumist rajatud ja selleks kohaliku omavalitsuse kirjaliku nõusoleku saanud lasketiirud ja laskepaigad peavad vastama määruse nõuetele hiljemalt 1. juulil 2022. aastal.",
      "rdfs:label": {
        "@value": "Reg_1051456_Par_21 (redaktsioon 1051456)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051456",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051456",
      "estleg:sourceAct": "Lasketiiru ja laskepaiga ning laskevõistluse ja treeninglaskmise ohutusnõuded",
      "estleg:provisionRef": "Reg_1051456 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1051456_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1051456_Par_22_v1051456",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051456_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-03-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Siseministri 25. märtsi 2002. aasta määrus nr 56 „Lasketiiru ja laskepaiga ning laskevõistluse ja treeninglaskmise ohutusnõuded” tunnistatakse kehtetuks. Siseministri 25. märtsi 2002. aasta määrus nr 56 „Lasketiiru ja laskepaiga ning laskevõistluse ja treeninglaskmise ohutusnõuded” tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1051456_Par_22 (redaktsioon 1051456)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051456",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051456",
      "estleg:sourceAct": "Lasketiiru ja laskepaiga ning laskevõistluse ja treeninglaskmise ohutusnõuded",
      "estleg:provisionRef": "Reg_1051456 § 22",
      "estleg:partOfAct": {
