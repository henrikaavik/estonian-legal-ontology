      "estleg:provisionRef": "Reg_1057415 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057415_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057415_Par_6_v1057415",
