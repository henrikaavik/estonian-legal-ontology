    {
      "@id": "estleg:Reg_1057415_Par_2_v1057415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057415_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajanduse Registrite ja Informatsiooni Amet (edaspidi PRIA) täidab komisjoni rakendusmääruse (EL) 2016/1240 artiklites 9, 31, 42, 65 ja 66 sätestatud liikmesriigile kehtestatud teavitamiskohustusi. Põllumajanduse Registrite ja Informatsiooni Amet (edaspidi PRIA) täidab komisjoni rakendusmääruse (EL) 2016/1240 artiklites 9, 31, 42, 65 ja 66 sätestatud liikmesriigile kehtestatud teavitamiskohustusi.",
      "rdfs:label": {
        "@value": "Reg_1057415_Par_2 (redaktsioon 1057415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057415",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057415",
      "estleg:sourceAct": "Põllumajandustoote sekkumiskokkuostu ja eraladustamise täpsem kord",
      "estleg:provisionRef": "Reg_1057415 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057415_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057415_Par_3_v1057415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057415_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teravilja sekkumiskokkuostu korral kasutatava ladustamiskoha väikseim laomaht on 10 000 tonni. Teravilja sekkumiskokkuostu korral kasutatava ladustamiskoha väikseim laomaht on 10 000 tonni.",
      "rdfs:label": {
        "@value": "Reg_1057415_Par_3 (redaktsioon 1057415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057415",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057415",
      "estleg:sourceAct": "Põllumajandustoote sekkumiskokkuostu ja eraladustamise täpsem kord",
      "estleg:provisionRef": "Reg_1057415 § 3",
