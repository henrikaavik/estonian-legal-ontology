      "estleg:provisionRef": "Reg_344417 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_344417_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_344417_Par_8_v344417",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_344417_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse kantud andmetele tagatakse juurdepääs avaliku teabe seaduses sätestatud korras, viisil, tingimustel ja tähtaegadel ning nimetatud andmed on kättesaadavad üldkasutatava andmesidevõrgu kaudu Riigi Teataja veebilehel. Andmekogusse kantud andmetele tagatakse juurdepääs avaliku teabe seaduses sätestatud korras, viisil, tingimustel ja tähtaegadel ning nimetatud andmed on kättesaadavad üldkasutatava andmesidevõrgu kaudu Riigi Teataja veebilehel. 2 (2) Üldkasutatava andmesidevõrgu kaudu ei avalikustata andmeid, millele on kehtestatud juurdepääsupiirang avaliku teabe seaduses sätestatud alusel ja korras. RT I 2014-06-10 2 110062014002 2014-06-13 Üldkasutatava andmesidevõrgu kaudu ei avalikustata andmeid, millele on kehtestatud juurdepääsupiirang avaliku teabe seaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "Reg_344417_Par_8 (redaktsioon 344417)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "344417",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/344417",
