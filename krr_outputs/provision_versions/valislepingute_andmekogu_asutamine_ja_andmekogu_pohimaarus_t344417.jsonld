    {
      "@id": "estleg:Reg_344417_Par_5_v344417",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_344417_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu peetakse ühetasandilise infotehnoloogilise andmekoguna ja andmekogu kannete paberkandjal alusdokumentide toimikutena. Andmekogu kannete paberkandjal alusdokumendid on lepingud ja nende menetlemist käsitlevad dokumendid. Andmekogu peetakse ühetasandilise infotehnoloogilise andmekoguna ja andmekogu kannete paberkandjal alusdokumentide toimikutena. Andmekogu kannete paberkandjal alusdokumendid on lepingud ja nende menetlemist käsitlevad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_344417_Par_5 (redaktsioon 344417)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "344417",
