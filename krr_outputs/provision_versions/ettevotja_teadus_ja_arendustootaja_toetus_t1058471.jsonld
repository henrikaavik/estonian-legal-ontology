    {
      "@id": "estleg:Reg_1058471_Par_13_v1058471",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058471_Par_13"
