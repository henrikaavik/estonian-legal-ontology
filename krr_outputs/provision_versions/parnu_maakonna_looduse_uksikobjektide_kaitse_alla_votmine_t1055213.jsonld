    },
    {
      "@id": "estleg:Reg_1055213_Par_7_v1055213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055213_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 30. oktoobri 2019. a käskkirjaga nr 1-2/19/697 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 30. oktoobri 2019. a käskkirjaga nr 1-2/19/697 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1055213_Par_7 (redaktsioon 1055213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055213",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055213",
      "estleg:sourceAct": "Pärnu maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1055213 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055213_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055213_Par_8_v1055213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055213_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1055213_Par_8 (redaktsioon 1055213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055213",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055213",
      "estleg:sourceAct": "Pärnu maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1055213 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055213_Map_2026"
      }
