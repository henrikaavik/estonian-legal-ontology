    {
      "@id": "estleg:Reg_1055213_Par_5_v1055213",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055213_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas2 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti piiranguvööndi ulatuse ja piiri kulgemise kohta. Määruse seletuskirjas2 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti piiranguvööndi ulatuse ja piiri kulgemise kohta.",
      "rdfs:label": {
        "@value": "Reg_1055213_Par_5 (redaktsioon 1055213)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055213",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055213",
      "estleg:sourceAct": "Pärnu maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1055213 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055213_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055213_Par_6_v1055213",
      "@type": [
        "owl:NamedIndividual",
