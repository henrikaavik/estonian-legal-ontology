    {
      "@id": "estleg:Reg_1039193_Par_1_v1039193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039193_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määruses sätestatakse vee- ja õhusõiduki varude arvestuse pidamine ja pardale toimetamise tõendamine. RT I 2023-09-28 16 128092023016 2023-10-01 Määruses sätestatakse vee- ja õhusõiduki varude arvestuse pidamine ja pardale toimetamise tõendamine. 2 (2) Kehtetu - RT I 2023-09-28 16 128092023016 2023-10-01 Kehtetu - 3 (3) Kehtetu - RT I 2023-09-28 16 128092023016 2023-10-01 Kehtetu - 4 (4) Kehtetu - RT I 2023-09-28 16 128092023016 2023-10-01 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1039193_Par_1 (redaktsioon 1039193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039193",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039193",
      "estleg:sourceAct": "Varude tolliformaalsused",
      "estleg:provisionRef": "Reg_1039193 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039193_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039193_Par_10_v1039193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039193_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vee- või õhusõidukile toimetatud varude kohta vee- või õhusõiduki käitaja poolt peetavas arvestuses peavad kajastuma andmed, mis võimaldavad tollil kontrollida pardale toimetatud varude eesmärgipärast kasutamist. Vee- või õhusõidukile toimetatud varude kohta vee- või õhusõiduki käitaja poolt peetavas arvestuses peavad kajastuma andmed, mis võimaldavad tollil kontrollida pardale toimetatud varude eesmärgipärast kasutamist. 2 (2) Varude arvestus peab olema tollile kättesaadav. Tolli nõudmisel tuleb esitada varude kasutamise aruanne. Varude arvestus peab olema tollile kättesaadav. Tolli nõudmisel tuleb esitada varude kasutamise aruanne. 3 (3) Kui varude arvestuse kontrollimisel avastatakse varude vähenemine koguses, mis ei vasta reisi kestusele, reisijate ja meeskonnaliikmete arvule ning vee- ja õhusõiduki kulunormidele, ja vee- või õhusõiduki käitaja ei suuda varude vähenemist tolli rahuldavalt tõendada, peab ta tasuma tollivõlast tuleneva maksusumma ja muud maksuseaduste alusel tasumisele kuuluvad maksud. Kui varude arvestuse kontrollimisel avastatakse varude vähenemine koguses, mis ei vasta reisi kestusele, reisijate ja meeskonnaliikmete arvule ning vee- ja õhusõiduki kulunormidele, ja vee- või õhusõiduki käitaja ei suuda varude vähenemist tolli rahuldavalt tõendada, peab ta tasuma tollivõlast tuleneva maksusumma ja muud maksuseaduste alusel tasumisele kuuluvad maksud.",
      "rdfs:label": {
        "@value": "Reg_1039193_Par_10 (redaktsioon 1039193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039193",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039193",
      "estleg:sourceAct": "Varude tolliformaalsused",
      "estleg:provisionRef": "Reg_1039193 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039193_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039193_Par_11_v1039193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039193_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Varude toimetamine rahvusvahelisi reise teostava vee- või õhusõiduki pardale peab olema tolli rahuldaval viisil tõendatud kapteni või tema poolt volitatud isiku poolt. RT I 2023-09-28 16 128092023016 2023-10-01 Varude toimetamine rahvusvahelisi reise teostava vee- või õhusõiduki pardale peab olema tolli rahuldaval viisil tõendatud kapteni või tema poolt volitatud isiku poolt. 2 (2) Kui vee- või õhusõiduki pardale varusid toimetanud isik ei suuda tolli rahuldavalt tõendada varude vee- või õhusõiduki pardale toimetamist, peab ta tasuma tollivõlast tuleneva maksusumma ja muud maksuseaduste alusel tasumisele kuuluvad maksud. Kui vee- või õhusõiduki pardale varusid toimetanud isik ei suuda tolli rahuldavalt tõendada varude vee- või õhusõiduki pardale toimetamist, peab ta tasuma tollivõlast tuleneva maksusumma ja muud maksuseaduste alusel tasumisele kuuluvad maksud.",
      "rdfs:label": {
        "@value": "Reg_1039193_Par_11 (redaktsioon 1039193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039193",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039193",
      "estleg:sourceAct": "Varude tolliformaalsused",
      "estleg:provisionRef": "Reg_1039193 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039193_Map_2026"
      }
    },
