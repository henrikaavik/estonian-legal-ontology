        "@value": "Sätete redaktsioonid: Eesti Vabariigi seadus vara võõrandamise õigusvastasuse tõendamise lihtsustatud korra kehtestamise kohta (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti Vabariigi seadus vara võõrandamise õigusvastasuse tõendamise lihtsustatud korra kehtestamise kohta"
    },
    {
      "@id": "estleg:VVOTS_Par_1_v24219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VVOTS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui vara omanikuks olnud füüsiline isik oli ajavahemikus 1940. aasta 16. juunist kuni 1954. aasta 1.jaanuarini sunnitud oma vara maha jätma oma elukohast või vara asukohast pagemise tõttu või seoses sellega, et välismaal viibides ta keeldus Eestisse tagasi tulemast, lugeda vara mahajätmine toimunuks reaalse repressiooniohu tõttu.",
      "rdfs:label": {
        "@value": "VVOTS_Par_1 (redaktsioon 24219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24219",
      "estleg:sourceAct": "Eesti Vabariigi seadus vara võõrandamise õigusvastasuse tõendamise lihtsustatud korra kehtestamise kohta",
      "estleg:provisionRef": "VVOTS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:VVOTS_Map"
      }
    },
    {
      "@id": "estleg:VVOTS_Par_2_v24219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VVOTS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui vara võõrandamine on toimunud tsiviilasjas tehtud kohtulahendi alusel, on vaja taotleda kõrgemalseisvalt kohtult kohtulahendi tühistamist järelevalve korras.",
      "rdfs:label": {
        "@value": "VVOTS_Par_2 (redaktsioon 24219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24219",
      "estleg:sourceAct": "Eesti Vabariigi seadus vara võõrandamise õigusvastasuse tõendamise lihtsustatud korra kehtestamise kohta",
      "estleg:provisionRef": "VVOTS § 2",
      "estleg:partOfAct": {
