    {
      "@id": "estleg:Reg_1052339_Par_10_v1052339",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052339_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenuseosutaja kirjeldab riskianalüüsis selle koostamise hetkeks rakendatud ennetavaid meetmeid ja vähemalt järgneva kolme aasta jooksul rakendada plaanitud meetmeid, et vältida elutähtsa teenuse katkestust ja häiret ning saavutada muu hulgas hädaolukorra seaduse § 37 lõike 2 alusel kehtestatud määrusega nõutud teenuse tase. Teenuseosutaja kirjeldab riskianalüüsis selle koostamise hetkeks rakendatud ennetavaid meetmeid ja vähemalt järgneva kolme aasta jooksul rakendada plaanitud meetmeid, et vältida elutähtsa teenuse katkestust ja häiret ning saavutada muu hulgas hädaolukorra seaduse § 37 lõike 2 alusel kehtestatud määrusega nõutud teenuse tase. 2 (2) Ennetava meetmena kirjeldatakse ka kriitiliste tegevuste tagamiseks vajalikku vahendite varu või nende tagamise korraldust. Ennetava meetmena kirjeldatakse ka kriitiliste tegevuste tagamiseks vajalikku vahendite varu või nende tagamise korraldust.",
      "rdfs:label": {
        "@value": "Reg_1052339_Par_10 (redaktsioon 1052339)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052339",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052339",
      "estleg:sourceAct": "Elutähtsa teenuse toimepidevuse riskianalüüsi ja plaani nõuded, nende koostamise ning plaani kasutuselevõtmise nõuded ja kord",
      "estleg:provisionRef": "Reg_1052339 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052339_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1052339_Par_11_v1052339",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052339_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenuseosutaja esitab riskianalüüsi kokkuvõttes: 1 1) kriitiliste tegevuste loetelu nende tähtsuse järjekorras; 2 2) riskianalüüsis olulise, kõrge ja väga kõrge riskiklassiga hinnatud stsenaariumide loetelu ning ülevaate nendega kaasnevatest võimalikest tagajärgedest; 3 3) võimalikud käitumisjuhised elanikele. Teenuseosutaja esitab riskianalüüsi kokkuvõttes: kriitiliste tegevuste loetelu nende tähtsuse järjekorras; riskianalüüsis olulise, kõrge ja väga kõrge riskiklassiga hinnatud stsenaariumide loetelu ning ülevaate nendega kaasnevatest võimalikest tagajärgedest; võimalikud käitumisjuhised elanikele.",
      "rdfs:label": {
        "@value": "Reg_1052339_Par_11 (redaktsioon 1052339)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052339",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052339",
      "estleg:sourceAct": "Elutähtsa teenuse toimepidevuse riskianalüüsi ja plaani nõuded, nende koostamise ning plaani kasutuselevõtmise nõuded ja kord",
      "estleg:provisionRef": "Reg_1052339 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052339_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1052339_Par_12_v1052339",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052339_Par_12"
