      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022001",
      "estleg:sourceAct": "Füüsilise isiku maksejõuetuse seadus",
      "estleg:provisionRef": "FIMS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:FIMS_Map_2026"
      }
    },
    {
      "@id": "estleg:FIMS_Par_9_v106072023029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:FIMS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksejõuetusavalduse, abikaasade ja registreeritud elukaaslaste maksejõuetusavalduse, võlausaldaja maksejõuetusavalduse, varanimekirja, võlanimekirja ja võlgade ümberkujundamise kava vormid kehtestab määrusega. (2) Käesoleva paragrahvi lõikes 1 nimetatud määrusega kehtestatud vormide kasutamine on kohustuslik. (3) Käesoleva paragrahvi lõikes 1 nimetatud vormid on igaühele vabalt ja tasuta kättesaadavad Justiitsministeeriumi veebilehel ning kohtus.",
      "rdfs:label": {
        "@value": "FIMS_Par_9 (redaktsioon 106072023029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023029",
