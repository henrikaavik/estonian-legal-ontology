        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2022. aasta 1. juulil.",
      "rdfs:label": {
        "@value": "FIMS_Par_87 (redaktsioon 120062022001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022001",
