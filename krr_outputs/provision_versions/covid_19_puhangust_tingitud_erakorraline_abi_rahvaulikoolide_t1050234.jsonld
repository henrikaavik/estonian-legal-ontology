      "rdfs:label": {
        "@value": "Sätete redaktsioonid: COVID-19 puhangust tingitud erakorraline abi rahvaülikoolidele, rahvamajadele ja käsitööühendustele (16 versiooni)",
        "@language": "et"
      },
      "dc:source": "COVID-19 puhangust tingitud erakorraline abi rahvaülikoolidele, rahvamajadele ja käsitööühendustele"
    },
    {
      "@id": "estleg:Reg_1050234_Par_1_v1050234",
      "@type": [
        "owl:NamedIndividual",
