      "estleg:provisionRef": "Reg_1050234 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050234_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050234_Par_16_v1050234",
      "@type": [
