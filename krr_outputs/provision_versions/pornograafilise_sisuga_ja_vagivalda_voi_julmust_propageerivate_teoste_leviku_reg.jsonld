      }
    },
    {
      "@id": "estleg:PSVVJPTLR_Par_14_v115032014033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PSVVJPTLR_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär 640 eurot.",
      "rdfs:label": {
        "@value": "PSVVJPTLR_Par_14 (redaktsioon 115032014033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014033"
    },
    {
      "@id": "estleg:PSVVJPTLR_Par_15_v25470",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PSVVJPTLR_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse rikkumine toob kaasa seadustes ettenähtud haldus- või kriminaalvastutuse. (2) Valla- või linnavalitsus peatab käesoleva seaduse korduva rikkumise korral kuni üheks aastaks ettevõtja tegutsemisloa või tühistab selle. Tegutsemisloa tühistamisel ei anta ettevõtjale uut tegutsemisluba enne ühe aasta möödumist loa tühistamise päevast.",
      "rdfs:label": {
        "@value": "PSVVJPTLR_Par_15 (redaktsioon 25470)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25470",
