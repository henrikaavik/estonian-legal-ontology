      },
      "estleg:versionValidTo": {
        "@value": "2008-10-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PSVVJPTLR_Par_6_v12947084",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PSVVJPTLR_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "PSVVJPTLR_Par_6 (redaktsioon 12947084)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12947084",
