      }
    },
    {
      "@id": "estleg:PSVVJPTLR_Par_13_v115032014033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PSVVJPTLR_Par_13"
