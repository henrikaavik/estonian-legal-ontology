      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja esitab taotluse teose sisu määratlemiseks Kultuuriministeeriumi nimele. Koos taotlusega esitatakse teos, mille sisu määratlemist taotletakse.",
