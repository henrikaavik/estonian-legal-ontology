        "@type": "xsd:date"
      },
      "estleg:versionText": "Ringhäälinguseaduse (RT I 1994, 42, 680; 66, 1145; 1995, 83, 1437; 97, 1664; 1996, 49, 953; 1997, 29, 448; 52, 834) paragrahv 19 lõiget 1 täiendatakse pärast sõnu \"tulirelvade ja lõhkeainete\" sõnadega \", pornograafilise sisuga või vägivalda või julmust propageerivate teoste\".",
      "rdfs:label": {
        "@value": "PSVVJPTLR_Par_18 (redaktsioon 25470)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25470",
