      ],
      "estleg:versionOf": {
        "@id": "estleg:PSVVJPTLR_Par_15_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "PSVVJPTLR_Par_15_1 (redaktsioon 112072014106)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014106"
    },
    {
      "@id": "estleg:PSVVJPTLR_Par_16_v25470",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PSVVJPTLR_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haldusõiguserikkumiste seadustikus (RT 1992, 29, 396; RT I 1997, 66-68, 1109; 73, 1201; 81, 1361 ja 1362; 86, 1459 ja 1461; 87, 1466 ja 1467) tehakse järgmised täiendused: seadustikku täiendatakse paragrahviga 154.1 järgmises sõnastuses:\"Paragrahv 154.1. Pornograafilise sisuga ja vägivalda või julmust propageerivate teoste leviku reguleerimise seaduse nõuete rikkumine (1) Alaealise lubamise eest spetsialiseeritud tegevuskoha ruumidesse, samuti teate \"alaealistele keelatud\" puudumise eest spetsialiseeritud tegevuskohas - määratakse rahatrahv kuni viiekümne päevapalga ulatuses. (2) Väljaspool spetsialiseeritud tegevuskohta pornograafilise sisuga või vägivalda või julmust propageeriva teose väljapanemise eest nähtavale kohale või niisuguse teose või selle koopiate pakkumise eest viisil, mis võimaldab alaealisel teosega tutvuda - määratakse rahatrahv kuni saja viiekümne päevapalga ulatuses. (3) Pornograafilise sisuga või vägivalda või julmust propageeriva teose reklaami eest väljaspool spetsialiseeritud tegevuskoha siseruume - määratakse rahatrahv kuni saja viiekümne päevapalga ulatuses.\"; seadustikku täiendatakse paragrahviga 216.5 järgmises sõnastuses:\"Paragrahv 216.5. Leviametnikud (1) Kultuuriministeeriumi leviosakonna ametiisikud arutavad käesoleva seadustiku paragrahvis 154.1 loetletud haldusõiguserikkumise asju. (2) Halduskaristuse määramise õigus on Kultuuriministeeriumi leviosakonna juhatajal ja inspektoril.\"; paragrahvi 189 lõiget 1 täiendatakse pärast sõnu \"154 lg. 2-5\" arvuga \"154.1\"; paragrahvi 238 lõiget 2 täiendatakse pärast arvu \"148\" sõnadega \"154.1 lg. 1\".",
      "rdfs:label": {
        "@value": "PSVVJPTLR_Par_16 (redaktsioon 25470)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25470"
    },
    {
      "@id": "estleg:PSVVJPTLR_Par_18_v25470",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
