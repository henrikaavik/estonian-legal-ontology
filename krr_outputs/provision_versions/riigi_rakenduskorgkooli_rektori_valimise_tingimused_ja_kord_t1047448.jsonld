    {
      "@id": "estleg:Reg_1047448_Par_14_v1047448",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047448_Par_14"
