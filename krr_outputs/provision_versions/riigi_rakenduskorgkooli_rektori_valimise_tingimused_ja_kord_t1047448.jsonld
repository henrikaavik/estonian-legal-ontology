    {
      "@id": "estleg:Reg_1047448_Par_10_v1047448",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047448_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rektorikandidaadi valimiseks moodustab valdkonna eest vastutav minister või tema volitatud isik valimiskogu ning nimetab valimiskogu esimehe. RT I 2024-10-17 1 117102024001 2024-10-20 , kohaldatakse konkurssidele, mis kuulutakse välja alates 11.10.2024. Rektorikandidaadi valimiseks moodustab valdkonna eest vastutav minister või tema volitatud isik valimiskogu ning nimetab valimiskogu esimehe. , kohaldatakse konkurssidele, mis kuulutakse välja alates 11.10.2024. 2 (2) Valimiskogu on seitsmeliikmeline ja selle koosseisu kuuluvad: 1 1) kaks rakenduskõrgkooli nõunike kogu nimetatud esindajat; 2 2) kaks rakenduskõrgkooli nõukogu esindajat, kellest üks on üliõpilaskonna esindaja; 3 3) üks rakenduskõrgkooli valdkonna asutuse, ettevõtte või organisatsiooni esindaja; 4 4) kaks Haridus- ja Teadusministeeriumi esindajat. Valimiskogu on seitsmeliikmeline ja selle koosseisu kuuluvad: kaks rakenduskõrgkooli nõunike kogu nimetatud esindajat; kaks rakenduskõrgkooli nõukogu esindajat, kellest üks on üliõpilaskonna esindaja; üks rakenduskõrgkooli valdkonna asutuse, ettevõtte või organisatsiooni esindaja; kaks Haridus- ja Teadusministeeriumi esindajat.",
      "rdfs:label": {
        "@value": "Reg_1047448_Par_10 (redaktsioon 1047448)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047448",
