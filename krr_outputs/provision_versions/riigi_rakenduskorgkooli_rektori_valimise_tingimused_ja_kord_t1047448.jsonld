      "estleg:sourceAct": "Riigi rakenduskõrgkooli rektori valimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1047448 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047448_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047448_Par_5_v1047448",
