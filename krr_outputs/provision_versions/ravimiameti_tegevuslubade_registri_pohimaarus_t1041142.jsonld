      }
    },
    {
      "@id": "estleg:Reg_1041142_Par_13_v1041142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041142_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmevahetus teiste andmekogudega toimub riigi infosüsteemide andmevahetuskihi kaudu avaliku teabe seaduse § 439 lõike 1 punkti 5 alusel kehtestatud õigusakti kohaselt. Andmevahetus teiste andmekogudega toimub riigi infosüsteemide andmevahetuskihi kaudu avaliku teabe seaduse § 439 lõike 1 punkti 5 alusel kehtestatud õigusakti kohaselt.",
      "rdfs:label": {
