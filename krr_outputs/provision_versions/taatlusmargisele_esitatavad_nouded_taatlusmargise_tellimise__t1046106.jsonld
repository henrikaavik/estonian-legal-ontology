      "estleg:versionValidFrom": {
        "@value": "2019-02-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib mõõtevahendite riigisisese esmataatluse ja kordustaatluse tulemuste vormistamist, taatlusmärgiste tellimist ja kasutamist. Määrus reguleerib mõõtevahendite riigisisese esmataatluse ja kordustaatluse tulemuste vormistamist, taatlusmärgiste tellimist ja kasutamist.",
      "rdfs:label": {
        "@value": "Reg_1046106_Par_1 (redaktsioon 1046106)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046106",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046106",
      "estleg:sourceAct": "Taatlusmärgisele esitatavad nõuded, taatlusmärgise tellimise, kasutamise ja hoidmise kord ning taatlustunnistuse ja nõuetele mittevastavuse tõendi kohustuslikud andmed",
