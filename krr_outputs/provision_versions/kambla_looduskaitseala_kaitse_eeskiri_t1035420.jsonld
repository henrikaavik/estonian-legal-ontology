    {
      "@id": "estleg:Reg_1035420_Par_15_v1035420",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035420_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus, arvestades käesoleva määrusega sätestatud erisusi. Piiranguvööndis on lubatud majandustegevus, arvestades käesoleva määrusega sätestatud erisusi. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) tootmisotstarbeta rajatise püstitamine; 2 2) lageraie kuusikutes ja hall-lepikutes langi pindalaga kuni kaks hektarit ja turberaie langi pindalaga kuni neli hektarit, kusjuures kaitseala valitseja võib seada tingimusi, et säilitada koosluse liikide ja vanuse mitmekesisus. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: tootmisotstarbeta rajatise püstitamine; lageraie kuusikutes ja hall-lepikutes langi pindalaga kuni kaks hektarit ja turberaie langi pindalaga kuni neli hektarit, kusjuures kaitseala valitseja võib seada tingimusi, et säilitada koosluse liikide ja vanuse mitmekesisus.",
      "rdfs:label": {
        "@value": "Reg_1035420_Par_15 (redaktsioon 1035420)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035420",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035420",
