    },
    {
      "@id": "estleg:Reg_1035420_Par_10_v1035420",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035420_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Oravasoone sihtkaitsevööndi kaitse-eesmärk on soo- ja metsakoosluste loodusliku seisundi taastamine ja säilitamine, neile omase liigi- ja vanusestruktuuri hoidmine, poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamine ning kaitsealuste liikide elupaikade kaitse. Oravasoone sihtkaitsevööndi kaitse-eesmärk on soo- ja metsakoosluste loodusliku seisundi taastamine ja säilitamine, neile omase liigi- ja vanusestruktuuri hoidmine, poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamine ning kaitsealuste liikide elupaikade kaitse.",
      "rdfs:label": {
        "@value": "Reg_1035420_Par_10 (redaktsioon 1035420)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035420",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035420",
      "estleg:sourceAct": "Kämbla looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035420 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035420_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035420_Par_11_v1035420",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035420_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 2 2) koosluste kujundamine vastavalt kaitse-eesmärgile; 3 3) tööd veerežiimi looduslikkuse taastamiseks; 4 4) maaparandussüsteemi eesvoolu hoiutööd; 5 5) poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik tegevus. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; koosluste kujundamine vastavalt kaitse-eesmärgile; tööd veerežiimi looduslikkuse taastamiseks; maaparandussüsteemi eesvoolu hoiutööd; poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik tegevus.",
      "rdfs:label": {
        "@value": "Reg_1035420_Par_11 (redaktsioon 1035420)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035420",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035420",
      "estleg:sourceAct": "Kämbla looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035420 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035420_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035420_Par_12_v1035420",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035420_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) ehitise püstitamine, välja arvatud kaitseala valitseja nõusolekul tootmisotstarbeta rajatise püstitamine kaitseala tarbeks ning olemasolevate rajatiste hooldustööd. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; ehitise püstitamine, välja arvatud kaitseala valitseja nõusolekul tootmisotstarbeta rajatise püstitamine kaitseala tarbeks ning olemasolevate rajatiste hooldustööd.",
      "rdfs:label": {
        "@value": "Reg_1035420_Par_12 (redaktsioon 1035420)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035420",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035420",
      "estleg:sourceAct": "Kämbla looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035420 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035420_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035420_Par_13_v1035420",
