    {
      "@id": "estleg:Reg_1035420_Par_19_v1035420",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035420_Par_19"
      },
