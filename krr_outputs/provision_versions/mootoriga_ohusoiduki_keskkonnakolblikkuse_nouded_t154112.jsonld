      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuamet väljastab «Eesti Vabariigi tsiviilõhusõidukite riiklikus registris» olevale mootoriga õhusõidukile keskkonnakõlblikkuse sertifikaadi viieks aastaks, mida uuendatakse käitaja taotlusel, kui õhusõiduk vastab keskkonnakõlblikkuse nõuetele. Lennuamet väljastab «Eesti Vabariigi tsiviilõhusõidukite riiklikus registris» olevale mootoriga õhusõidukile keskkonnakõlblikkuse sertifikaadi viieks aastaks, mida uuendatakse käitaja taotlusel, kui õhusõiduk vastab keskkonnakõlblikkuse nõuetele.",
      "rdfs:label": {
        "@value": "Reg_154112_Par_3 (redaktsioon 154112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154112",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154112",
      "estleg:sourceAct": "Mootoriga õhusõiduki keskkonnakõlblikkuse nõuded",
      "estleg:provisionRef": "Reg_154112 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154112_Map"
      }
    },
    {
      "@id": "estleg:Reg_154112_Par_4_v154112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154112_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootoriga õhusõiduki keskkonnakõlblikkuse sertifikaadi väljaandmise või muutmise aluseks on valmistajatehase või pädeva lennundusasutuse poolt väljaantud tõend, mis kinnitab õhusõiduki vastavust Rahvusvahelise Tsiviillennunduse Organisatsiooni (RTO) keskkonnakõlblikkuse standarditele ja nõuetele. Vastavuse aluseks olevad mõõtmised tehakse EN 45001 või ISO 10000 soovituslike standardite alusel akrediteeritud laborites RTO poolt tunnustatud metoodika kohaselt. Mootoriga õhusõiduki keskkonnakõlblikkuse sertifikaadi väljaandmise või muutmise aluseks on valmistajatehase või pädeva lennundusasutuse poolt väljaantud tõend, mis kinnitab õhusõiduki vastavust Rahvusvahelise Tsiviillennunduse Organisatsiooni (RTO) keskkonnakõlblikkuse standarditele ja nõuetele. Vastavuse aluseks olevad mõõtmised tehakse EN 45001 või ISO 10000 soovituslike standardite alusel akrediteeritud laborites RTO poolt tunnustatud metoodika kohaselt.",
      "rdfs:label": {
        "@value": "Reg_154112_Par_4 (redaktsioon 154112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154112",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154112",
      "estleg:sourceAct": "Mootoriga õhusõiduki keskkonnakõlblikkuse nõuded",
      "estleg:provisionRef": "Reg_154112 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154112_Map"
      }
    },
