    {
      "@id": "estleg:RIIGIL_2_Par_181_v13103493",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_181"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõiduki registreerimise eest tasutakse riigilõivu 1900 krooni. (2) Väikelaeva või alla 12-meetrise kogupikkusega laeva registreerimise eest tasutakse riigilõivu 1000 krooni. (3) Maastikusõiduki või jeti registreerimise eest tasutakse riigilõivu 500 krooni. (4) Ajutiselt Eestisse imporditud sõiduki registreerimise eest tasutakse riigilõivu 5000 krooni. (5) Üksiksõiduki kinnituse omistamise eest tasutakse riigilõivu 3000 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_181 (redaktsioon 13103493)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13103493",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_181_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13103493",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 181",
