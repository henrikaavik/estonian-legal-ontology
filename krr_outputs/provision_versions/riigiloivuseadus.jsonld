      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_123_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa eest tasutakse riigilõivu lähtuvalt tegevusloa liigist: suurema kui 1 MW netovõimsusega tootmisseadme käitamise lõpetamiseks – 639,11 eurot; elektrienergia tootmiseks – 159,77 eurot iga kehtivusaasta eest; jaotusvõrgu kaudu võrguteenuse osutamiseks aastase teenustemahuga kuni 5 GWh – 958,67 eurot iga kehtivusaasta eest; jaotusvõrgu kaudu võrguteenuse osutamiseks aastase teenustemahuga üle 5 GWh kuni 20 GWh – 1917,34 eurot iga kehtivusaasta eest; jaotusvõrgu kaudu võrguteenuse osutamiseks aastase teenustemahuga üle 20 GWh kuni 50 GWh – 4473,81 eurot iga kehtivusaasta eest; jaotusvõrgu kaudu võrguteenuse osutamiseks aastase teenustemahuga üle 50 GWh kuni 100 GWh – 6391,16 eurot iga kehtivusaasta eest; jaotusvõrgu kaudu võrguteenuse osutamiseks aastase teenustemahuga üle 100 GWh kuni 500 GWh – 12 782,32 eurot iga kehtivusaasta eest; jaotusvõrgu kaudu võrguteenuse osutamiseks aastase teenustemahuga üle 500 GWh – 19 173,49 eurot iga kehtivusaasta eest; põhivõrgu kaudu võrguteenuse osutamiseks – 2556,46 eurot iga kehtivusaasta eest; riigipiiri ületava alalisvooluliini kaudu elektrienergia edastamiseks – 2556,46 eurot iga kehtivusaasta eest; otseliini kaudu elektrienergia edastamiseks – 1278,23 eurot iga kehtivusaasta eest; tootjaliini kaudu elektrienergia edastamiseks – 1278,23 eurot iga kehtivusaasta eest; elektrienergia müügiks – 639,11 eurot iga kehtivusaasta eest; elektrienergia impordiks – 3195,58 eurot. (2) Käesoleva paragrahvi lõike 1 punktides 3–8 nimetatud teenustemahuks loetakse eelmisel kalendriaastal tarbijatele edastatud elektrienergia koguse ja võrgukadude summa. Tegevust alustav võrguettevõtja tasub riigilõivu järgmiseks kalendriaastaks kavandatava teenustemahu alusel. (3) Tegevusloa tingimuste muutmise taotluse läbivaatamise eest tasutakse riigilõivu 50 protsenti käesoleva paragrahvi lõikes 1 sätestatud riigilõivumäärast.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_123 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_123_v129062012007"
      },
      "estleg:versionValidTo": {
        "@value": "2012-07-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 123",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_123_v129062012007",
      "@type": [
        "owl:NamedIndividual",
