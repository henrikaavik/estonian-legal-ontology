      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravimi kliinilise uuringu loa taotluse läbivaatamise eest tasutakse riigilõivu 383,46 eurot ning iga täiendava uuringukeskuse eest 15,97 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_265 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
