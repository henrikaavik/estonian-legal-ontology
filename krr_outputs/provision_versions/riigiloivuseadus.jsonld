      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uue eesnime, perekonnanime või isikunime andmise või eesnime, perekonnanime või isikunime taastamise taotluse läbivaatamise eest tasutakse riigilõivu 38,34 eurot.",
