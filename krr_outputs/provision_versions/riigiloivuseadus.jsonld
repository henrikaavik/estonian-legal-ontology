      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühenduse tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu 195 eurot. (2) Taksoveoloa taotluse läbivaatamise eest tasutakse riigilõivu 64 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_332 (redaktsioon 130122014001)",
