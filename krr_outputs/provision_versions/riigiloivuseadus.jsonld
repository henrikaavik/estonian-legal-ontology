        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_352 (redaktsioon 122032013015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032013015",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_352_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122032013015",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 352",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_352_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_352"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korteriomandi kinnistamisel on tehinguväärtuseks 50 protsenti kaasomandi osa suurusele vastavast korteriomandite esemeks oleva kinnisasja maksustamishinnast.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_352 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 352",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_353_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_353"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi õigusabi seaduse (RT I 2004, 56, 403; 2005, 39, 308) § 9 lõige 2 muudetakse ja sõnastatakse järgmiselt: « (2) Riigi õigusabi taotluse esitamise eest tasutakse riigilõiv riigilõivuseaduses sätestatud määra järgi, kui riigi õigusabi taotletakse väljaspool kohtumenetlust ning isik ei taotle riigi õigusabi kriminaalmenetluses kahtlustatavana.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_353 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_353_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 353",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_353_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_353"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu ei võeta järgmiste toimingute eest: enne ühe aasta möödumist päevast, mis määratakse Euroopa Liidu Nõukogu poolt Eesti Vabariigi suhtes kehtestatud erandi kehtetuks tunnistamise kohta vastavalt Euroopa Liidu toimimise lepingu artikli 140 lõikes 2 sätestatud alusel (edaspidi erandi kehtetuks tunnistamise päev), osaühingu või aktsiaseltsi põhikirja muutmise äriregistrisse kandmine, kui osaühingu või aktsiaseltsi põhikirja muudetakse ainult seoses osa- või aktsiakapitali ja osade või aktsiate nimiväärtuste eurodesse ümberarvestamisega ja osa- või aktsiakapitali suurendamisega või vähendamisega äriseadustiku §-s 136, § 148 lõigetes 1 ja 2, §-s 222 ning § 223 lõigetes 1 ja 2 sätestatud nõuete täitmiseks; enne ühe aasta möödumist erandi kehtetuks tunnistamise päevast osaühingu või aktsiaseltsi osa- või aktsiakapitali muutmise äriregistrisse kandmine, kui osa- või aktsiakapitali muudetakse ainult seoses osa- või aktsiakapitali ja osade või aktsiate nimiväärtuste eurodesse ümberarvestamisega äriseadustiku §-s 136, § 148 lõigetes 1 ja 2, §-s 222 ning § 223 lõigetes 1 ja 2 sätestatud nõuete täitmiseks, välja arvatud juhul, kui osa- või aktsiakapitali suurendatakse või vähendatakse rohkem kui osa- või aktsiakapitali senise suurusega võrreldes lähima võimaliku suuruseni äriseadustiku §-s 136, § 148 lõigetes 1 ja 2, §-s 222 ning § 223 lõigetes 1 ja 2 sätestatud nõuete täitmiseks; aktsiaseltsi põhikirja muutmise äriregistrisse kandmine nimiväärtuseta aktsia kasutusele võtmiseks, kui seda tehakse enne ühe aasta möödumist erandi kehtetuks tunnistamise päevast arvates.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_353 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_353_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 353",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_353_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_353"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hoonestamata kinnisasja koormamisel hoonestusõigusega on tehinguväärtuseks 80 protsenti koormatava kinnisasja maksustamishinnast. (2) Hoonestatud kinnisasja koormamisel hoonestusõigusega on tehinguväärtuseks 80 protsenti maa maksustamishinna ja hoone hinna summast. (3) Kui hoonestusõiguse eest makstakse tasu, on hoonestusõigusega koormamisel tehinguväärtuseks hoonestusõiguse tasu kogusumma, kuid mitte rohkem kui 25 aasta eest. (4) Korterihoonestusõiguse kinnistamisel on tehinguväärtuseks 50 protsenti kaasomandi osa suurusele vastavast hoonestusõiguse tehinguväärtusest, määratuna käesoleva paragrahvi lõike 1 alusel.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_353 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 353",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_354_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_354"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ringhäälinguseaduse (RT I 1994, 42, 680; 2004, 87, 593) § 39 täiendatakse lõikega 6 järgmises sõnastuses: « (6) Ringhäälinguloa taotluse läbivaatamise eest tasutakse riigilõiv riigilõivuseaduses sätestatud määra järgi.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_354 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_354_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 354",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_354_v131122010025",
