    {
      "@id": "estleg:RIIGIL_2_Par_6_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigilõiv laekub riigieelarvesse. (2) Riigilõiv valla- või linnasekretäri tõestamistoimingu eest laekub valla või linna eelarvesse. (3) Kauplemisloa väljastamise eest võetav riigilõiv laekub valla- või linnaeelarvesse.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_6 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_6_v188253"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_6_v188253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigilõiv laekub riigieelarvesse. (2) Riigilõiv valla- või linnasekretäri tõestamistoimingu eest laekub valla või linna eelarvesse. (3) Kauplemisloa väljastamise eest võetav riigilõiv laekub valla- või linnaeelarvesse. [Lõige 4 jõustub 1. 01. 2003] (4) Ehituslubade, kasutuslubade ja riikliku ehitisregistri andmete kinnitatud väljavõtete väljastamise eest võetav riigilõiv laekub valla- või linnaeelarvesse.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_6 (redaktsioon 188253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188253",
