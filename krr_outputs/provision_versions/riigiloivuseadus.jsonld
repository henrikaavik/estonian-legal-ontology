        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laskemoona sisse-, välja- või transiitveo loa väljastamise eest: kuni 1000 padruni kohta tasutakse riigilõivu 500 krooni; 1001 ja enama padruni kohta tasutakse riigilõivu 500 krooni iga 1000 padruni ja tuhandega kordset arvu ületava arvu padrunite kohta.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_104 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
