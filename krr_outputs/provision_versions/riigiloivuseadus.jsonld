      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik, kes impordib mitteloomset päritolu toitu, tasub riigilõivu järelevalvetoimingute eest ühe tariifse klassifikatsiooni kohta ühel tollideklaratsioonil lähtuvalt imporditavast kogusest: kuni 30 tonni puhul 0,05 krooni iga kilogrammi kohta; üle 30 tonni puhul 1500 krooni ja lisaks 0,03 krooni iga kilogrammi kohta, mis ületab 30 tonni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_212 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_212_v131122010025"
      },
