      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_354_v102032012010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_354"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_354 (redaktsioon 102032012010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102032012010",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_354_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102032012010",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 354",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_354_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_354"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalservituudi seadmisel on tehinguväärtuseks väärtus, mida reaalservituut valitseva kinnisasja suhtes omab, kuid mitte vähem kui 130 eurot. (2) Kui kohtule ei esitata andmeid reaalservituudi väärtuse suuruse kohta, loetakse tehinguväärtuseks 130 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_354 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 354",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_355_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_355"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Söödaseaduse (RT I 2002, 18, 97; 2006, 21, 162) § 19 lõige 8 muudetakse ja sõnastatakse järgmiselt: « (8) Tootja või vahendaja, kelle ettevõte peab käesoleva seaduse kohaselt olema tunnustatud või registreeritud, tasub järelevalvetoimingute eest riigilõivu riigilõivuseaduse alusel.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_355 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_355_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 355",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_355_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_355"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadustes toodud viited riigilõivuseadusele (RT I 2006, 58, 439; 2010, 9, 41) loetakse viideteks käesolevale seadusele.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_355 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_355_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 355",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_355_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_355"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kasutusvalduse aastaväärtuseks on 4 protsenti koormatava kinnisasja maksustamishinnast. (2) Tähtajalise kasutusvalduse seadmisel on tehinguväärtuseks üksikute aastaväärtuste summa, kuid mitte rohkem kui 25 aasta eest. (3) Tähtajatu kasutusvalduse seadmisel on tehinguväärtuseks kasutusvalduse aastaväärtuse kordne sõltuvalt kasutusvaldaja vanusest: alla 36-aastase isiku puhul 20-kordne aastaväärtus; 36–50-aastase isiku puhul 15-kordne aastaväärtus; 51–65-aastase isiku puhul 10-kordne aastaväärtus; 66–75-aastase isiku puhul 5-kordne aastaväärtus; 76-aastase ja vanema isiku puhul 3-kordne aastaväärtus. (4) Tähtajatu kasutusvalduse seadmisel ühiselt mitme isiku kasuks võetakse tehinguväärtuse arvutamisel aluseks noorima kasutusvaldust teostava isiku vanus. (5) Juriidilise isiku kasuks tähtajatu kasutusvalduse seadmisel on tehinguväärtuseks 25-kordne kasutusõiguse aastaväärtus.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_355 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 355",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_356_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_356"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervishoiuteenuste korraldamise seaduses (RT I 2001, 50, 248; 2005, 64, 482) tehakse järgmised muudatused: paragrahvi 3 täiendatakse lõikega 3 järgmises sõnastuses: « (3) Tervishoiutöötaja on kohustatud tasuma registreerimistõendi kinnitatud ärakirja väljastamise eest riigilõivu riigilõivuseaduses sätestatud määras.»; paragrahvi 28 täiendatakse lõikega 1 1 järgmise sõnastuses: « (1 1 ) Registreerimist taotlev isik on kohustatud enne registreerimistaotluse esitamist tasuma taotluse läbivaatamise eest riigilõivu riigilõivuseaduses sätestatud määras.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_356 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_356_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 356",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
