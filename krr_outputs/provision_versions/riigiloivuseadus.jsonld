      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvusvahelise patenditaotluse siseriiklikku menetlusse võtmise eest tasutakse riigilõivu 3500 krooni. (2) Kasuliku mudeli rahvusvahelise registreerimise taotluse siseriiklikku menetlusse võtmise eest tasutakse riigilõivu 1600 krooni.",
      "rdfs:label": {
