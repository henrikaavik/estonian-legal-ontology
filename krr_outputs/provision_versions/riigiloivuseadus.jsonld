      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigimuuseum või -etendusasutus, munitsipaalmuuseum või -etendusasutus, avalik-õigusliku juriidilise isiku muuseum või rahvusooper, samuti riigi asutatud või riigi osalusel asutatud sihtasutusena tegutsev muuseum või etendusasutus on vabastatud käesoleva seaduse §-s 144 sätestatud riigilõivu tasumisest. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_50 (redaktsioon 131122015035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015035",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015035",
