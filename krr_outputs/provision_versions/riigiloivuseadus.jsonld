      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_331_3_v123032015032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_331_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elamu ja seda teenindava rajatise kasutusloa taotluse läbivaatamise eest tasutakse riigilõivu 30 eurot. (2) Mitteelamu ja seda teenindava rajatise kasutusloa taotluse läbivaatamise eest tasutakse riigilõivu 60 eurot. (3) Kui kasutusloa taotlus sisaldab mitut hoonet ja seda teenindavat rajatist, siis tasutakse riigilõivu iga taotluses sisalduva kasutusloakohustusliku hoone eest eraldi.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_331_3 (redaktsioon 123032015032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032015032",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 331_3",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_331_4_v123032015032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
