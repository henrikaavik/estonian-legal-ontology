    {
      "@id": "estleg:RIIGIL_2_Par_248_1_v13103493",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_248_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakkude, kudede ja elundite käitlemise tegevusloa: väljaandmise taotluse läbivaatamise eest tasutakse riigilõivu 25 000 krooni; uuendamise taotluse läbivaatamise eest tasutakse riigilõivu 10 000 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_248_1 (redaktsioon 13103493)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13103493",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_248_1_v130062020015"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13103493",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 248_1",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_248_1_v130062020015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_248_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ekspordi fütosanitaarsertifikaadi, reekspordi fütosanitaarsertifikaadi ja ekspordieelse fütosanitaarsertifikaadi taotluse läbivaatamise eest tasutakse riigilõivu 13 eurot ning lisaks: kuni 50 elustaime kohta 4 eurot ja iga järgmise 100 taime kohta 2 eurot; kuni 1000 lõikelille ja lõikerohelise kohta 20 eurot ning iga järgmise 1000 ühiku kohta 10 eurot; iga 1000 kilogrammi teravilja ja kaunvilja kohta 0,1 eurot; kuni 100 kuupmeetri ümarpuidu, saematerjali, laastude, tükkide, saepuru, puidujäätmete ja puidust pakkematerjali kohta 20 eurot ning iga järgmise 100 kuupmeetri kohta 10 eurot; kuni 25 000 kilogrammi kakao- ja kohviubade kohta 25 eurot ning iga järgmise 1000 kilogrammi kohta 1 euro; kuni 100 kuupmeetri turba kohta 20 eurot ja iga järgmise 100 kuupmeetri kohta 10 eurot; muude taimede, taimsete saaduste ja muude objektide kohta 40 eurot iga kaubasaadetise kohta.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_248_1 (redaktsioon 130062020015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062020015",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_248_1_v117112021017"
      },
      "estleg:versionValidTo": {
        "@value": "2021-11-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062020015",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 248_1",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_248_1_v117112021017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_248_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ekspordi fütosanitaarsertifikaadi, reekspordi fütosanitaarsertifikaadi ja ekspordieelse fütosanitaarsertifikaadi taotluse läbivaatamise eest tasutakse riigilõivu 13 eurot ning lisaks: kuni 50 elustaime kohta 4 eurot ja iga järgmise 100 taime kohta 2 eurot; kuni 1000 lõikelille ja lõikerohelise kohta 20 eurot ning iga järgmise 1000 ühiku kohta 10 eurot; iga 1000 kilogrammi teravilja ja kaunvilja kohta 0,1 eurot; kuni 100 kuupmeetri ümarpuidu, saematerjali, laastude, tükkide, saepuru, puidujäätmete ja puidust pakkematerjali kohta 20 eurot ning iga järgmise 100 kuupmeetri kohta 10 eurot; kuni 25 000 kilogrammi kakao- ja kohviubade kohta 25 eurot ning iga järgmise 1000 kilogrammi kohta 1 euro; kuni 100 kuupmeetri turba kohta 10 eurot ja üle 100 kuupmeetri turba kohta 17 eurot; muude taimede, taimsete saaduste ja muude objektide kohta 40 eurot iga kaubasaadetise kohta.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_248_1 (redaktsioon 117112021017)",
        "@language": "et"
