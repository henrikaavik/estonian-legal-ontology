      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõidukikaardi väljastamise eest tasutakse riigilõivu 20 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_334 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:supersededByVersion": {
