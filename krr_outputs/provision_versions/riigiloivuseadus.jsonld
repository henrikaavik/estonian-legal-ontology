      "estleg:provisionRef": "RIIGIL_2 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_15_v130122023006",
      "@type": [
        "owl:NamedIndividual",
