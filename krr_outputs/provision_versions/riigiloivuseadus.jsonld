      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõiv on käesoleva seadusega kehtestatud määras tasumisele kuuluv summa juriidiliste toimingute tegemise, avalduste läbivaatamise ja dokumentide väljastamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_2 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
