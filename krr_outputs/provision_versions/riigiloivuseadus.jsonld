      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riikliku ehitisregistri andmete kinnitatud väljavõtte väljastamise eest tasutakse riigilõivu 2 eurot iga lehekülje eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_331 (redaktsioon 130122014001)",
