      "estleg:versionValidFrom": {
        "@value": "2018-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõiduplaani muutmise taotluse esitaja on vabastatud riigilõivu tasumisest, kui sõiduplaani muudatus kinnitatakse ühistranspordiseaduse § 42 lõike 3 punktides 2 ja 3 nimetatud liiniloa andja ettepanekul.",
