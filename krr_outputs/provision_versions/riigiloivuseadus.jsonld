      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Siduva eelotsuse taotluse läbivaatamise eest tasutakse riigilõivu 766,93 eurot. (2) Füüsilise isiku siduva eelotsuse taotluse läbivaatamise eest tasutakse riigilõivu 191,73 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_243 (redaktsioon 131122010025)",
