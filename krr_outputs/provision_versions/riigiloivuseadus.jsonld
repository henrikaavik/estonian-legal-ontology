      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_212_v232675",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_212"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusraamatus kande muutmisel on tehinguväärtuseks sissekantud asjaõiguse muudetud sisuga kinnistamise tehinguväärtus. (2) Kinnistusraamatus kande kustutamisel on tehinguväärtuseks märke või vastava asjaõiguse kinnistamise tehinguväärtus.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_212 (redaktsioon 232675)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "232675",
