        "@id": "estleg:RIIGIL_2_Par_18_v1027956"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1023854",
