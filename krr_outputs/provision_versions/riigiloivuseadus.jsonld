      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kande muutmise või kustutamise eest tasutakse 25% käesoleva seaduse lisas 1 toodud riigilõivu täismäärast olenevalt tehinguväärtusest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_120 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
