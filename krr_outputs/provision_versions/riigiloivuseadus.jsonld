      },
      "estleg:versionText": "Loterii korraldusloa taotluse läbivaatamise eest tasutakse riigilõivu 800 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_221 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
