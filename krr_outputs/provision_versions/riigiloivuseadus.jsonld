    {
      "@id": "estleg:RIIGIL_2_Par_329_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_329"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Biotsiidiseaduse (RT I 2004, 45, 315; 2006, 28, 211) § 9 lõige 3 muudetakse ja sõnastatakse järgmiselt: « (3) Enne taotluse esitamist tasutakse riigilõiv riigilõivuseaduses sätestatud määra järgi.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_329 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_329_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 329",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_329_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_329"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korduva sünnitõendi, surmatõendi, abielutõendi ja abielulahutuse tõendi väljastamise eest tasutakse riigilõivu 3,19 eurot. (2) Abieluvõimetõendi, perekonnaseisuakti, perekonnakirja või lisatoimetuses oleva dokumendi kinnitatud ärakirja väljastamise eest tasutakse riigilõivu 1,59 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_329 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
