      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_347_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_347"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandustegevuse registri seaduses (RT I 2004, 12, 79) tehakse järgmised muudatused: paragrahvi 5 lõike 4 teine lause tunnistatakse kehtetuks; paragrahvi 20 lõike 3 teine lause tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_347 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_347_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 347",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_347_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_347"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiratud asjaõiguse järjekoha muutmisel on tehinguväärtuseks etteastuva piiratud asjaõiguse seadmise tehinguväärtus.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_347 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_347_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 347",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_347_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_347"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tehinguväärtus määratakse kinnistamise alusdokumendi järgi. (2) Tehingu objektil lasuvaid kohustusi ega objekti võõrandamishinnale lisanduvat käibemaksu summat tehinguväärtuse määramisel maha ei arvata. (3) Kui kinnistamise alusdokument ei sisalda tehinguväärtust, määratakse tehinguväärtus käesoleva seaduse §-de 348–362 kohaselt.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_347 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 347",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_348_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_348"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mikrolülituse topoloogia kaitse seaduse (RT I 1998, 108/109, 1783; 2005, 39, 308) § 63 lõige 1 muudetakse ja sõnastatakse järgmiselt: « (1) Käesolevas seaduses ettenähtud toimingute sooritamise eest tasutakse riigilõiv riigilõivuseaduses sätestatud määra järgi.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_348 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_348_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 348",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_348_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_348"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Märke kinnistamisel on tehinguväärtuseks selle asjaõiguse kinnistamise tehinguväärtus, mille tagamiseks märge kinnistusraamatusse kantakse.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_348 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_348_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 348",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_348_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_348"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hoonestamata kinnisasja kinnistamisel on tehinguväärtuseks maa maksustamishind. (2) Hoonestatud kinnisasja kinnistamisel on tehinguväärtuseks maa maksustamishind ja hoone hind. (3) Kui kohtule ei esitata dokumenti hoone hinna kohta, loetakse hoone hinnaks 3200 eurot. (4) Kinnisasjal asuva hoone omaniku ostueesõigusega erastatud maa kinnistamisel on tehinguväärtuseks maa maksustamishind. (5) Kui maa maksustamishind ja hoonete hind on kokku väiksem kui kinnisasja koormav hüpoteek, on omandiõiguse kinnistamisel tehinguväärtuseks kinnistusraamatusse kantud hüpoteegi summa.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_348 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 348",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_349_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_349"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Patendiseaduse (RT I 1994, 25, 406; 2005, 70, 540) § 40 tekst muudetakse ja sõnastatakse järgmiselt: «Käesoleva seadusega ettenähtud juhtudel tasutakse toimingute sooritamise, dokumentide väljastamise ning patenditaotluse ja patendi jõushoidmise eest riigilõiv riigilõivuseaduses sätestatud määra järgi.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_349 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_349_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 349",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_349_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_349"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusraamatu kande muutmisel on tehinguväärtuseks sissekantud asjaõiguse muudetud sisuga kinnistamise tehinguväärtus. (2) Kinnistusraamatu kande kustutamisel on tehinguväärtuseks märke või vastava asjaõiguse kinnistamise tehinguväärtus.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_349 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_349_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 349",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_349_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_349"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistu jagamisel mitmeks kinnistuks määratakse tehinguväärtus lähtuvalt jagamise tulemusel moodustatavast uuest kinnistust käesoleva seaduse § 348 kohaselt.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_349 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 349",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_35_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui riigilõivu maksja ei ole tasunud riigilõivu Maksuameti või Tolliameti ettekirjutuses määratud tähtaja jooksul, on Maksuametil või Tolliametil õigus pöörduda kohtutäituri poole riigilõivu maksja poolt tasumata riigilõivu sissenõudmiseks täitemenetluse seadustikus (RT I 1993, 49, 693; 2001, 29, 156; 43, 238) ettenähtud korras . (2) Riigilõivu maksja varale võib pöörata sissenõuet kahe aasta jooksul, arvates päevast, mil riigilõiv oleks tulnud tasuda, rakendades selleks täitemenetluse seadustikus sätestatud korda.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_35 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_35_v188253"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 35",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_35_v188253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui riigilõivu maksja ei ole tasunud riigilõivu Maksuameti või Tolliameti ettekirjutuses määratud tähtaja jooksul, on Maksuametil või Tolliametil õigus pöörduda kohtutäituri poole riigilõivu maksja poolt tasumata riigilõivu sissenõudmiseks täitemenetluse seadustikus (RT I 1993, 49, 693; 2001, 29, 156; 43, 238) ettenähtud korras. (2) Riigilõivu maksja varale võib pöörata sissenõuet kahe aasta jooksul, arvates päevast, mil riigilõiv oleks tulnud tasuda, rakendades selleks täitemenetluse seadustikus sätestatud korda.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_35 (redaktsioon 188253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188253",
