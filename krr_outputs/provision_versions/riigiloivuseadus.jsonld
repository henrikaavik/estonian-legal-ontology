      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 123 lõike 1 punktides 2–12, § 124 lõike 1 punktides 1–4 ja § 125 lõike 1 punktides 1–3 nimetatud tegevusloa esimese kehtivusaasta eest tasutakse riigilõiv enne tegevusloa taotluse esitamist ning iga järgneva kehtivusaasta eest vähemalt 10 päeva enne vastava kehtivusaasta algust.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_127 (redaktsioon 131122010025)",
        "@language": "et"
      },
