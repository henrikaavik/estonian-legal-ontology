        "@type": "xsd:date"
      },
      "estleg:versionText": "Kirjaliku nõusoleku taotluse läbivaatamise eest tasutakse riigilõivu 31,95 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_318 (redaktsioon 131122010025)",
