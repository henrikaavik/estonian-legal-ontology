    {
      "@id": "estleg:RIIGIL_2_Par_18_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui riigilõivu tasuja ei ole tasunud riigilõivu ettekirjutuses määratud tähtpäevaks, on riigilõivu võtjal õigus pöörduda kohtutäituri poole tasumata riigilõivu sissenõudmiseks. (2) Riigilõivu sissenõue aegub kahe aasta möödumisel selle aasta lõpust, millal toiming tehti.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_18 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
