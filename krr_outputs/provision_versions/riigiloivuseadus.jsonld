      },
      "estleg:versionValidTo": {
        "@value": "2012-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 58",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_58_v129062012006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuotsuse või -määruse kordusärakirja väljastamise eest, samuti kohtumenetluse muu dokumendi või elektroonilise dokumendi väljatrüki väljastamise eest tasutakse riigilõivu 0,3 eurot iga lehekülje eest. (2) Riigilõivu ei tasuta elektroonilise dokumendi elektroonilise väljastamise eest, samuti menetluse läbiviimiseks menetlusosalisele elektroonilise dokumendi väljatrüki esmakordse väljastamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_58 (redaktsioon 129062012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062012006",
