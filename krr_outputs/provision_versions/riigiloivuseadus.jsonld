      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 48",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_48_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valdkonna eest vastutava ministri või tema volitatud isiku poolt haldusaktiga uue eesnime, perekonnanime või isikunime andmisel või eesnime, perekonnanime või isikunime taastamisel ei võeta riigilõivu nimeseaduse § 171 lõike 1 punktides 5–8 ja § 19 lõike 1 punktides 6–8 sätestatud juhul.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_48 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_48_v131122015035"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 48",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
