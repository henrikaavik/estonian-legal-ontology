        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konsulaarametnikule teada olevate asjaolude kohta tõendi andmise eest tasutakse riigilõivu 200 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_148 (redaktsioon 693620)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693620",
      "estleg:supersededByVersion": {
