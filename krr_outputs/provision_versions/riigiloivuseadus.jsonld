        "@type": "xsd:date"
      },
      "estleg:versionText": "Taimepassi väljastamise eest ei võeta riigilõivu, kui kaubasaadetise kontrollimise eest on tasutud taimetervise järelevalve tasu.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_34 (redaktsioon 12765603)",
