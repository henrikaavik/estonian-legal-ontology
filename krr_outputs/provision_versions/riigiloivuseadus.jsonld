      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/232675",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 212",
      "estleg:partOfAct": {
