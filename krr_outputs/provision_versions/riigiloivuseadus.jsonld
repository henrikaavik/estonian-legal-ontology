      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaubamärgi registreerimise taotluse esitamisel tasutakse riigilõivu: kaupade või teenuste ühe klassi kohta rahvusvahelise kaupade ja teenuste klassifikatsiooni järgi 2800 krooni; kaupade või teenuste iga täiendava klassi kohta rahvusvahelise kaupade ja teenuste klassifikatsiooni järgi 1000 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_121 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
