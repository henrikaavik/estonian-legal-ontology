      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maareformi seaduse alusel kasutusvaldusesse antud maa omandamise taotluse läbivaatamise eest tasutakse riigilõivu 32 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_346_1 (redaktsioon 128112017005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128112017005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128112017005",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 346_1",
      "estleg:partOfAct": {
