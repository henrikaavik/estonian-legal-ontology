      },
      "estleg:versionText": "Kutsekvalifikatsiooni omistamise tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu 50 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_51 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
