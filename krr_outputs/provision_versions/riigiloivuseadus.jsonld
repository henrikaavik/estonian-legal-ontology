      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_158_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_158"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 154 lõike 1 punktides 2–12, § 155 lõike 1 punktides 1–4 ja § 156 lõikes 1 nimetatud tegevusloa esimese kehtivusaasta eest tasutakse riigilõiv enne tegevusloa taotluse esitamist ning iga järgmise kehtivusaasta eest vähemalt 10 päeva enne vastava kehtivusaasta algust.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_158 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_158_v130062023063"
