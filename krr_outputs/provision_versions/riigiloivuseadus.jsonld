    {
      "@id": "estleg:RIIGIL_2_Par_276_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_276"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervishoiutöötaja kutsekvalifikatsiooni tunnustamise taotluse läbivaatamise eest tasutakse riigilõivu 191,73 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_276 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
