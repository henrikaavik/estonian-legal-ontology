      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_29_v125102022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paikse heiteallika käitaja ja õhusõiduki käitaja on vabastatud riigilõivu tasumisest arvelduskonto avamise taotluse läbivaatamise ning arvelduskonto iga-aastase hooldamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_29 (redaktsioon 125102022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "125102022002",
