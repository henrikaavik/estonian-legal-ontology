      },
      "estleg:versionText": "Avalduse esitamisel pärandvara hoiuabinõude rakendamiseks tasutakse riigilõivu 350 krooni. [Paragrahvi 153 sõnastus alates 01.01.2004]",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_153 (redaktsioon 689371)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "689371",
