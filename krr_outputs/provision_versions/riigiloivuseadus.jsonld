    {
      "@id": "estleg:RIIGIL_2_Par_142_13_v130062023063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_142_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõiduki meeskonnaliikme sertifikaadi taotluse läbivaatamise eest tasutakse riigilõivu 25 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_142_13 (redaktsioon 130062023063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023063",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062023063",
      "estleg:sourceAct": "Riigilõivuseadus",
