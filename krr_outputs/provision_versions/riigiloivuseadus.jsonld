      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jahiseaduse (RT I 2002, 41, 252; 2005, 67, 512) § 10 lõige 6 muudetakse ja sõnastatakse järgmiselt: « (6) Jahipiirkonna kasutusõiguse loa taotluse läbivaatamise eest tasutakse riigilõiv riigilõivuseaduses sätestatud määra järgi.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_336 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
