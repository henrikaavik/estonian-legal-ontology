      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühekordse loa taotluse läbivaatamise eest tasutakse riigilõivu 31,95 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_137 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_137_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
