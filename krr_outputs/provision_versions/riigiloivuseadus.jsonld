      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Viisataotluse läbivaatamise eest tasutakse riigilõivu käesoleva seaduse § 276 lõigetes 1–3 ja 5–8 sätestatud määras.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_318 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 318",
