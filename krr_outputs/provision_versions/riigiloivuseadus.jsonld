      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_49_v131122015036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi advokaat on vabastatud riigilõivu tasumisest välisriigis omandatud kutsekvalifikatsiooni tunnustamise taotluse, sealhulgas Euroopa kutsekaardi taotluse läbivaatamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_49 (redaktsioon 131122015036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015036",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015036",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 49",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_5_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu võtja käesoleva seaduse tähenduses on valitsus- ja kohaliku omavalitsuse asutus, valitsusasutuse hallatav riigiasutus ja kohaliku omavalitsuse hallatav asutus, muu avalik-õiguslikke ülesandeid täitev asutus, kohus, valla- või linnasekretär, kes teostab riigilõivuga maksustatud toimingu.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_5 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_5_v12765603"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_5_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu tasuja on isik, asutus, välismaa äriühingu filiaal või isikute ühendus, kelle huvides või kelle suhtes toiming tehakse ning kes seaduse kohaselt on kohustatud selle eest tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_5 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_50_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusregistriosa avamise eest tasutakse riigilõivu täismäär.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_50 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_50_v12765603"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 50",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_50_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolitusloa taotluse läbivaatamise eest tasutakse riigilõivu: kõrghariduse puhul 1000 krooni; üldkeskhariduse, kutseõppe ning täiskasvanute tööalase ja vabaharidusliku koolituse puhul 500 krooni; alus- ja põhihariduse puhul 250 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_50 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_50_v13005052"
      },
      "estleg:versionValidTo": {
        "@value": "2008-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 50",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_50_v13005052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Koolitusloa taotluse läbivaatamise eest tasutakse riigilõivu: Kehtetu – üldkeskhariduse, kutseõppe ning täiskasvanute tööalase ja vabaharidusliku koolituse puhul 500 krooni; alus- ja põhihariduse puhul 250 krooni. (2) Erakooliseaduse alusel kõrgharidustaseme õppe läbiviimise õiguse saamiseks taotluse läbivaatamise eest tasutakse lõivu 1000 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_50 (redaktsioon 13005052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13005052",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_50_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13005052",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 50",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_50_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 35 lõikes 2, §-s 36, § 37 lõikes 1, § 38 lõigetes 5 ja 6, § 42 lõikes 1 ning § 49 lõikes 2 sätestatud riigilõivu tasumisest vabastamise või riigilõivumäära vähendamise taotlus esitatakse kirjalikult. Taotluses, välja arvatud diplomaatilises noodis, märgitakse: taotleja nimi või nimetus ja aadress; isiku, kelle riigilõivu tasumisest vabastamist või riigilõivu määra vähendamist taotletakse, isikunimi ning isikukood või selle puudumise korral sünniaeg ja -koht, kodakondsus, elukoht, töö- või teenistuskoht, kuusissetuleku suurus ja allikad ning ülalpeetavate arv; toiming, mille tegemise eest riigilõivu määra vähendamist või riigilõivu tasumisest vabastamist taotletakse; taotluse põhjendus. (2) Taotlusele lisatakse taotluse põhjendatust kinnitavad dokumendid.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_50 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_50_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 50",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_50_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigimuuseum või -etendusasutus, munitsipaalmuuseum või -etendusasutus, avalik-õigusliku juriidilise isiku muuseum või rahvusooper, samuti riigi asutatud või riigi osalusel asutatud sihtasutusena tegutsev muuseum või etendusasutus on vabastatud käesoleva seaduse §-s 144 sätestatud riigilõivu tasumisest. (2) Muinsuskaitseametil on isiku majanduslikust olukorrast lähtuvalt või käesoleva paragrahvi lõikes 1 nimetamata riigiasutuse või kohaliku omavalitsuse üksuse organi põhjendatud taotluse alusel õigus vabastada isik käesoleva seaduse §-s 144 sätestatud riigilõivu tasumisest või vähendada tasutava riigilõivu määra.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_50 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
