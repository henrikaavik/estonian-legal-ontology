      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaubamärgi rahvusvahelise registreeringu kehtivusaja pikendamise eest tasutakse riigilõivu 2800 krooni. (2) Kollektiivkaubamärgi rahvusvahelise registreeringu kehtivusaja pikendamise eest tasutakse riigilõivu 3500 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_145 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
