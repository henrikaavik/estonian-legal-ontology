      },
      "estleg:versionText": "Rahvusvahelise patenditaotluse patendinõudluse eestikeelse tõlke avalikustamise eest tasutakse riigilõivu 32 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_110 (redaktsioon 130122014001)",
        "@language": "et"
      },
