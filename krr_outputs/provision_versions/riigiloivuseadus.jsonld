      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui tehniliseks teenistuseks määramine toimub Transpordiameti algatusel, on tehniline teenistus riigilõivu tasumisest vabastatud.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_51_1 (redaktsioon 110122020030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020030",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110122020030",
