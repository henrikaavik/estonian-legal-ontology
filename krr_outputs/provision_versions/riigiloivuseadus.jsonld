      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Perekonnaseisuakti kantud andmete kohta tõendi, perekonnaseisu tõendi, abiellumist takistavate asjaolude puudumise tõendi või perekonnaseisuakti kinnitatud ärakirja väljastamise eest tasutakse riigilõivu 25 krooni.",
      "rdfs:label": {
