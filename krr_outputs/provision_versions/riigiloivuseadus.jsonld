        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi advokaat on vabastatud riigilõivu tasumisest välisriigis omandatud kutsekvalifikatsiooni tunnustamise taotluse läbivaatamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_48 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
