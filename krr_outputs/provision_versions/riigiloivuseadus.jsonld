      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tehinguväärtus määratakse kande alusdokumendi järgi. Kui kande alusdokumendis ei ole tehinguväärtust sätestatud, loetakse tehinguväärtuseks 319,55 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_352 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
