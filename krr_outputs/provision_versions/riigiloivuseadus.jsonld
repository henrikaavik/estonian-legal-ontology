      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_142_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaubamärgi registreeringu tegemise eest tasutakse riigilõivu 700 krooni. (2) Leiutise registreerimise eest patendiregistris tasutakse riigilõivu 1500 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_142 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
