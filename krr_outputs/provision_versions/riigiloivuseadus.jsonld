      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaubamärgi registreeringu jagamise eest tasutakse riigilõivu 44,73 eurot. (2) Tööstusdisainilahenduse registreeringu jagamise eest tasutakse riigilõivu 44,73 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_166 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
