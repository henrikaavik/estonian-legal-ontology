        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Perekonnaseisuandmete väljatrüki õigsuse kinnitamise eest tasutakse riigilõivu 1 euro.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_337 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
