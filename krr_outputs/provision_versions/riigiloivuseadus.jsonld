    {
      "@id": "estleg:RIIGIL_2_Par_46_v13098017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu ei võeta riikliku toetuse ja pensioni saamiseks ning eestkoste, hoolduse ja lapsendamise asjas vajaliku dokumendi ärakirja või väljavõtte õigsuse kinnitamise eest ning pensioni saamiseks vajaliku volikirja ning pensioni ja toetuste teise isiku arveldusarvele kandmise avalduse tõestamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_46 (redaktsioon 13098017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13098017",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_46_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13098017",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 46",
      "estleg:partOfAct": {
