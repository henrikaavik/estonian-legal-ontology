        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisesinduse kaudu hagiavalduse, nõude või dokumendi teatavakstegemise eest tasutakse riigilõivu 15 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_317 (redaktsioon 130122014001)",
