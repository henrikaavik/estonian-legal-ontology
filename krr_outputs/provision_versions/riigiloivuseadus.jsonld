      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hüpoteegi seadmisel on tehinguväärtuseks 2/3 hüpoteegisummast. (2) Kui riiklikus ehitisregistris registreeritud pandi ümberregistreerimisel hüpoteegiks pandisumma suureneb, on tehinguväärtuseks 2/3 pandisumma ja hüpoteegisumma vahest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_359 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
