      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raudtee registrisse kandmisel raudteele registreerimistunnistuse väljastamise eest tasutakse riigilõivu 150 krooni. (2) Raudteeveeremi registrisse kandmisel raudteeveeremile registreerimismärgi väljastamise eest tasutakse riigilõivu 400 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_178 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
