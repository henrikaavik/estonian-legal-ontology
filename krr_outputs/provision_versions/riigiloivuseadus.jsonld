      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 173",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_173_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhusõiduki hooldusorganisatsiooni sertifikaadi esmase taotluse või muutmise taotluse läbivaatamise eest tasutakse riigilõivu, lähtudes taotletavast pädevusest: õhusõiduki hoolduse A1 või A3 pädevuse taotluse puhul 1280 eurot; õhusõiduki hoolduse A2 või A4 pädevuse taotluse puhul 640 eurot; õhusõiduki mootori või abijõuseadme hoolduse B1 kuni B3 pädevuse taotluse puhul 640 eurot iga pädevuse kohta; õhusõiduki komponendi hoolduse C1 kuni C20 iga pädevuse taotluse puhul 130 eurot iga pädevuse kohta; eritööde D1 pädevuse taotluse puhul 260 eurot. (2) Õhusõiduki hooldusorganisatsiooni sertifikaadi hoidmise eest tasutakse iga aasta kohta riigilõivu 25 protsenti käesoleva paragrahvi lõikes 1 sätestatud pädevuste eest tasutavast riigilõivumäärast.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_173 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_173_v126022015018"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 173",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_173_v126022015018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_173"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhusõiduki hooldusorganisatsiooni sertifikaadi esmase taotluse või muutmise taotluse läbivaatamise eest tasutakse riigilõivu, lähtudes taotletavast pädevusest: õhusõiduki hoolduse A1 või A3 pädevuse taotluse puhul 1280 eurot; õhusõiduki hoolduse A2 või A4 pädevuse taotluse puhul 640 eurot; õhusõiduki mootori või abijõuseadme hoolduse B1 kuni B3 pädevuse taotluse puhul 640 eurot iga pädevuse kohta; õhusõiduki komponendi hoolduse C1 kuni C20 iga pädevuse taotluse puhul 130 eurot iga pädevuse kohta; eritööde D1 pädevuse taotluse puhul 260 eurot. (2) Õhusõiduki hooldusorganisatsiooni sertifikaadi hoidmise eest tasutakse iga aasta kohta riigilõivu 25 protsenti käesoleva paragrahvi lõikes 1 sätestatud pädevuste eest tasutavast riigilõivumäärast. (3) Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 216/2008 II lisas nimetatud õhusõiduki hooldusorganisatsiooni sertifikaadi väljaandmise eest tasutakse riigilõivu 100 eurot. (4) Käesoleva paragrahvi lõikes 3 nimetatud organisatsiooni sertifikaadi hoidmise eest tasutakse iga aasta kohta riigilõivu 100 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_173 (redaktsioon 126022015018)",
        "@language": "et"
      },
