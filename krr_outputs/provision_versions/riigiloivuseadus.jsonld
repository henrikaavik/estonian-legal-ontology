      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu võtjal ei ole lubatud võtta toimingu eest täiendavat tasu.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_8 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
