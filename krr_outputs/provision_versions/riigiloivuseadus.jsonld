      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 35 lõikes 2, §-s 36, § 38 lõikes 1, § 39 lõigetes 4 ja 5 ning § 43 lõikes 1 sätestatud riigilõivu tasumisest vabastamise või riigilõivumäära vähendamise taotlus esitatakse kirjalikult. Taotluses, välja arvatud diplomaatilises noodis, märgitakse: taotleja nimi või nimetus ja aadress; selle isiku, kelle riigilõivu tasumisest vabastamist või riigilõivumäära vähendamist taotletakse, isikunimi ning isikukood või selle puudumise korral sünniaeg ja -koht, kodakondsus, elukoht, töö- või teenistuskoht, kuusissetuleku suurus ja allikad ning ülalpeetavate arv; toiming, mille tegemise eest riigilõivumäära vähendamist või riigilõivu tasumisest vabastamist taotletakse; taotluse põhjendus. (2) Taotlusele lisatakse taotluse põhjendatust kinnitavad dokumendid.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_52 (redaktsioon 131122015035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015035",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015035",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 52",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_53_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Märke kandmise eest kinnistusraamatusse tasutakse riigilõivu 25% täismäärast. (2) Märke kustutamise eest, kui sellega ei kaasne märkega tagatud õiguse kandmist kinnistusraamatusse, tasutakse riigilõivu 25% täismäärast.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_53 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
