      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu lähtuvalt tegevusloa liigist: raudteeinfrastruktuuri majandamiseks 1917,34 eurot; raudtee reisijateveoteenuse osutamiseks 1917,34 eurot; raudtee kaubaveoteenuse osutamiseks 3834,69 eurot; raudteeveeremi remondiks 319,55 eurot; raudteeveeremi tehnohooldeks 319,55 eurot; raudteeveeremi ehituseks 639,11 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_126 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_126_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
