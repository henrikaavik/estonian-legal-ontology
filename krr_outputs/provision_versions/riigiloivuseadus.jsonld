      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kultuuriväärtuse väljaveoloa taotluse läbivaatamise eest, samuti väljaveoloa andmise või sellest keeldumise eest kultuuriväärtuste väljaveo, ekspordi ja sisseveo seaduse § 16 lõikes 4 ja § 17 lõikes 3 sätestatud alustel tasutakse riigilõivu 20 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_144 (redaktsioon 131122015035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015035",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_144_v119032019042"
      },
      "estleg:versionValidTo": {
        "@value": "2019-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015035",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 144",
      "estleg:partOfAct": {
