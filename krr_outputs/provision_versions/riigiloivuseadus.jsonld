      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 269",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_269_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_269"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahapesu ja terrorismi rahastamise tõkestamise seaduse alusel väljastatava tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu 345 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_269 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_269_v112022020003"
      },
      "estleg:versionValidTo": {
        "@value": "2020-03-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 269",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_269_v112022020003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_269"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahapesu ja terrorismi rahastamise tõkestamise seaduse alusel väljastatava tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu järgmiselt: usaldusfondide ja äriühingute teenuse osutamiseks, pandimajateenuse osutamiseks ning väärismetalli ja väärismetalltoodete, välja arvatud tootmise, teaduse ning meditsiini vajaduseks kasutatavad väärismetallid ja väärismetalltooted, või vääriskivide kokkuostuks või hulgimüügiks 345 eurot; finantseerimisasutusena tegutsemiseks või virtuaalvääringu teenuse pakkumiseks 3300 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_269 (redaktsioon 112022020003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112022020003",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_269_v112032022006"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112022020003",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 269",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_269_v112032022006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_269"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahapesu ja terrorismi rahastamise tõkestamise seaduse alusel väljastatava tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu järgmiselt: usaldusfondide ja äriühingute teenuse osutamiseks, pandimajateenuse osutamiseks ning väärismetalli ja väärismetalltoodete, välja arvatud tootmise, teaduse ning meditsiini vajaduseks kasutatavad väärismetallid ja väärismetalltooted, või vääriskivide kokkuostuks või hulgimüügiks 345 eurot; finantseerimisasutusena tegutsemiseks 3300 eurot; virtuaalvääringu teenuse pakkumiseks 10 000 eurot. (2) Virtuaalvääringu alase tegevusloa muutmise taotluse läbivaatamise eest tasutakse riigilõivu 4000 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_269 (redaktsioon 112032022006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032022006",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_269_v121062024023"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032022006",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 269",
      "estleg:partOfAct": {
