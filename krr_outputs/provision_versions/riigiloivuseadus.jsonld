      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Litsentsitaotluse läbivaatamise eest tasutakse riigilõivu 13 eurot. (2) Litsentsi kehtivusaja muutmise taotluse läbivaatamise eest tasutakse riigilõivu 7 eurot.",
      "rdfs:label": {
