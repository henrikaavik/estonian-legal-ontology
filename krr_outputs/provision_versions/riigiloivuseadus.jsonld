      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõiduki, maastikusõiduki, väikelaeva, alla 12-meetrise kogupikkusega laeva või jeti kontrollimiseks autoregistrikeskuse spetsialisti kohalekutsumise korral Eesti piires tasutakse riigilõivu 250 krooni iga sõiduki, maastikusõiduki, väikelaeva, alla 12-meetrise kogupikkusega laeva või jeti kontrollimise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_191 (redaktsioon 12765603)",
