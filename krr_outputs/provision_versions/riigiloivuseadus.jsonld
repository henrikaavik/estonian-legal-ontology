      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_142_71_v130062023063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
