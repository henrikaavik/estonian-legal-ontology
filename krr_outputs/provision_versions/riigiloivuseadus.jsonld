      },
      "estleg:versionText": "Kinnistusregistriosa avamise eest tasutakse riigilõivu täismäär.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_71 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
