    {
      "@id": "estleg:RIIGIL_2_Par_146_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusvahelise patenditaotluse või kasuliku mudeli rahvusvahelise registreerimistaotluse eestikeelse tõlke esitamise tähtaja pikendamise eest tasutakse riigilõivu 700 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_146 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_146_v749990"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 146",
      "estleg:partOfAct": {
