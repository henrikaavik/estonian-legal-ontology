      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_51_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Koolitusloa taotluse läbivaatamise eest tasutakse riigilõivu: üldkeskhariduse, kutseõppe ning täiskasvanute tööalase ja vabaharidusliku koolituse puhul 31,95 eurot; alus- ja põhihariduse puhul 15,97 eurot. (2) Erakooliseaduse alusel kõrgharidustaseme õppe läbiviimise õiguse saamiseks taotluse läbivaatamise eest tasutakse riigilõivu 63,91 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_51 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_51_v112072013015"
      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 51",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_51_v112072013015",
