      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_144_v119032019042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_144"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kultuuriväärtuse väljaveo loa taotluse läbivaatamise eest, samuti väljaveoloa andmise või sellest keeldumise eest kultuuriväärtuste väljaveo, ekspordi ja sisseveo seaduse § 16 lõikes 4 ja § 17 lõikes 3 sätestatud alustel tasutakse riigilõivu 20 eurot kultuuriväärtuse kohta, kuid kokku mitte rohkem kui 200 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_144 (redaktsioon 119032019042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019042",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019042",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 144",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_145_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
