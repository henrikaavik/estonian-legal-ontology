      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avaliku teabe seaduse (RT I 2000, 92, 597; 2005, 39, 308) § 27 lõige 2 muudetakse ja sõnastatakse järgmiselt: « (2) Teabe või dokumendi väljastamise eest ette nähtud riigilõiv tasutakse enne teabe väljastamist riigilõivuseaduses sätestatud määra järgi.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_328 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
