        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigilõivu ei võeta käesoleva seaduse §-s 22 nimetatud kohtuasjade toimingutega seonduvalt seaduses nõutava teadaande avaldamise eest. (2) Kui seadus ei sätesta selle isiku kohustust, kelle huvides või kelle kohustustega seonduvalt teadaanne avaldatakse, hüvitada teadaande avaldamiskulusid, on riigilõivu tasumisest vabastatud: riigiasutus, samuti avalik-õiguslikke ülesandeid täitev isik seaduse, halduslepingu või haldusakti alusel avalikke ülesandeid täites; kohaliku omavalitsuse üksus rahvastikuregistri seaduse §-s 46 nimetatud rahvastikuregistrisse kantud elukoha aadressi muutmise taotluse avaldamisel.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_44 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_44_v129062012006"
      },
      "estleg:versionValidTo": {
        "@value": "2012-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 44",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
