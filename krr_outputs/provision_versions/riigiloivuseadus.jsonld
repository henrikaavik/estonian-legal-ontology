      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pandilepingu registreerimisel on tehinguväärtuseks pandisumma.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_350 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
