        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paikse saasteallika käitaja ja õhusõiduki käitaja on vabastatud riigilõivu tasumisest arveldus- ja kauplemiskonto avamise taotluse läbivaatamise ning arveldus- ja kauplemiskonto iga-aastase hooldamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_29 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
