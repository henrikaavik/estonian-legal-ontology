      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravimi kliinilise uuringu loa taotluse läbivaatamise eest tasutakse riigilõivu 6000 krooni ning iga täiendava uuringukeskuse eest 250 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_244 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_244_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
