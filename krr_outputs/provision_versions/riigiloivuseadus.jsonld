      "estleg:provisionRef": "RIIGIL_2 § 51",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_51_v107032018003",
      "@type": [
        "owl:NamedIndividual",
