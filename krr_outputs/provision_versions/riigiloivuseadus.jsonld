    {
      "@id": "estleg:RIIGIL_2_Par_80_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lepingulise investeerimisfondi tingimuste ja nende muudatuste registreerimise taotlemisel tasutakse riigilõivu 5000 krooni. (2) Kohustusliku pensionifondi tingimuste ja nende muudatuste registreerimise taotlemisel tasutakse riigilõivu 10 000 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_80 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_80_v907808"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-02",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 80",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_80_v907808",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
