      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notariaalse tõestamise eest tasutakse riigilõivu 600 krooni. (2) Notariaalse kinnitamise eest tasutakse riigilõivu 300 krooni. (3) Välisministeeriumi nõusolekul tehtava tõestamistoimingu eest tasutakse riigilõivu 1200 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_149 (redaktsioon 693620)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693620",
