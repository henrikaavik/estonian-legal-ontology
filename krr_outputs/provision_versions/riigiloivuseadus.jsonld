      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutsekvalifikatsiooni omistamise tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu 3,19 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_52 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
