    {
      "@id": "estleg:RIIGIL_2_Par_91_v106012023032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaubamärgi, kollektiivkaubamärgi ja sertifitseerimismärgi rahvusvahelise registreerimise taotluse Patendiametile esitamise eest tasutakse riigilõivu rahvusvahelises kaupade ja teenuste klassifikatsioonis toodud kaupade või teenuste klassi järgi: ühe klassi kohta 45 eurot; iga täiendava klassi kohta 20 eurot. (2) Rahvusvahelise patenditaotluse Patendiametile esitamise eest tasutakse riigilõivu 120 eurot. (3) Kasuliku mudeli rahvusvahelise registreerimise taotluse Patendiametile esitamise eest tasutakse riigilõivu 120 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_91 (redaktsioon 106012023032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106012023032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106012023032",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 91",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_92_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravimite tootmise, hulgi- või jaemüügi tegevusloal fikseeritud tegevuskoha, vastutava isiku või ettevõtja õigusliku vormi muutmisest tuleneva muudatuse tegemise eest tasutakse riigilõivu 100 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_92 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_92_v837134"
      },
      "estleg:versionValidTo": {
        "@value": "2005-02-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 92",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_92_v837134",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravimite tootmise, ravimite hulgimüügi, üldapteegi, haiglaapteegi või veterinaarapteegi tegevusloal muudatuse tegemise taotlemise eest tuleb tasuda riigilõivu järgmistes summades: ravimite tootmise või hulgimüügi tegevusloal märgitud tegutsemiskoha muutmine – 3000 krooni; ravimtaimede pakendamiseks antud ravimite tootmise tegevusloal märgitud tegutsemiskoha muutmine – 300 krooni; ravimite tootmise või hulgimüügi tegevusloa omajast ettevõtja õigusliku vormi muutmisest või sellisel tegevusloal märgitud pädeva isiku vahetumisest või sellise tegevusloa eritingimuse muutmisest tuleneva muudatuse tegemine – 1000 krooni; ravimtaimede pakendamiseks antud ravimite tootmise tegevusloa omajast ettevõtja õigusliku vormi muutmisest või sellisel tegevusloal märgitud pädeva isiku vahetumisest või sellise tegevusloa eritingimuse muutmisest tuleneva muudatuse tegemine – 100 krooni; üldapteegi, haiglaapteegi või veterinaarapteegi tegevusloal märgitud tegutsemiskoha muutmine või struktuuriüksuse lisamine sellisele tegevusloale – 300 krooni; apteegiteenuse tegevusloa omajast ettevõtja õigusliku vormi muutmisest või sellisel tegevusloal märgitud apteegi juhataja vahetumisest või sellise tegevusloa eritingimuse muutmisest tuleneva muudatuse tegemine – 100 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_92 (redaktsioon 837134)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "837134",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_92_v12765603"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/837134",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 92",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
