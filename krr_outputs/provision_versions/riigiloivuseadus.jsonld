      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_249_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_249"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Relvasoetamisloa, relvaloa, paralleelrelvaloa, relvakandmisloa või kollektsioneerimisloa taotluse läbivaatamise eest tasutakse riigilõivu 12,78 eurot. (2) Relvasoetamisloa või kollektsioneerimisloa pikendamise või kollektsioneerimisloale täiendavate andmete kandmise eest tasutakse riigilõivu 3,19 eurot. (3) Relvaloa, paralleelrelvaloa või relvakandmisloa vahetamise eest tasutakse riigilõivu 3,19 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_249 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_249_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 249",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_249_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_249"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väetise registrisse kandmise eest tasutakse riigilõivu 130 eurot. (2) Registrikande muutmise eest tasutakse riigilõivu 32 eurot. (3) Väetiseregistri kinnitatud väljavõtte väljastamise eest tasutakse riigilõivu 1 euro iga formaadis A4 lehekülje eest. (4) Väetise Eestisse toimetaja ja tootja, kelle nimele väetis on registreeritud, tasuvad iga aasta 10. jaanuariks ning 10. juuliks riigilõivu järelevalvetoimingute eest sõltuvalt eelmisel poolaastal nende turustatud väetisekogusest järgmiselt: ammooniumnitraadi puhul – 0,0002 eurot kilogrammi kohta; bakterväetise puhul – 0,0004 eurot kilogrammi kohta; lubiväetise puhul – 0,00001 eurot kilogrammi kohta; käesoleva lõike punktides 1–3 nimetamata väetiseliikide puhul – 0,0001 eurot kilogrammi kohta. (5) Väetise Eestisse toimetaja ja tootja, kelle nimele väetis on registreeritud ning kes ei ole kuue kuu jooksul väetist turustanud, tasuvad selles ajavahemikus väetise registris hoidmise ja järelevalve eest riigilõivu 7 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_249 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_249_v104122019024"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 249",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_249_v104122019024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_249"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandustegevusteate alusel väetiseregistrisse kantud väetise nõuetekohasuse järelevalvetoimingute eest tasutakse riigilõivu 10 eurot kuni 25-kilogrammisesse või 25-liitrisesse pakendisse pakendatud ning 160 eurot üle 25-kilogrammisesse või 25-liitrisesse pakendisse pakendatud ja pakendamata väetise käitlemisega alustamise aastal majandustegevusteate esitamisel ning igal sellele järgneval kalendriaastal kuni sama väetise käitlemise lõpetamiseni. Kui väetist turustatakse erineva suurusega pakendites, tasutakse riigilõiv suurimast pakendist lähtudes.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_249 (redaktsioon 104122019024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122019024",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_249_v130062023063"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104122019024",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 249",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
