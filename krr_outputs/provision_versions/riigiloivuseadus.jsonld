    {
      "@id": "estleg:RIIGIL_2_Par_331_5_v123032015032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_331_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Projekteerimistingimuste taotluse läbivaatamise eest tasutakse riigilõivu 25 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_331_5 (redaktsioon 123032015032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032015032",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 331_5",
      "estleg:partOfAct": {
