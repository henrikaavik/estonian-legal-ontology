      },
      "estleg:versionText": "Langevarjundustegevuse käsiraamatu läbivaatamise eest tasutakse riigilõivu 230 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_142_27 (redaktsioon 130062023063)",
