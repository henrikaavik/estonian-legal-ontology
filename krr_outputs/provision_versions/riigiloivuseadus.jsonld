    {
      "@id": "estleg:RIIGIL_2_Par_43_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Konsulaarametnikul on õigus isiku, Eesti riigiasutuse või kohaliku omavalitsuse üksuse organi, samuti välisriigi riigiasutuse põhjendatud taotlusel, diplomaatilise noodi alusel või välislepingus ettenähtud juhul vabastada isik käesoleva seaduse §-s 264, 270, 271, 275 või 276 nimetatud toimingu eest riigilõivu tasumisest või vähendada tasutava riigilõivu määra, lähtudes isiku majanduslikust olukorrast või kultuuri-, välis-, arengupoliitilisest või muust olulisest avalikust huvist. (2) Riigiasutus on vabastatud riigilõivu tasumisest konsulaarseaduse § 40 alusel dokumendi edastamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_43 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_43_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 43",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_43_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus, maksuhaldur, prokuratuur, uurimisasutus, notar ja kohtutäitur on vabastatud riigilõivu tasumisest avaliku arhiivi arhiiviteatise, arhivaali väljavõtte ja ärakirja väljastamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_43 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_43_v130122011052"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 43",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_43_v130122011052",
