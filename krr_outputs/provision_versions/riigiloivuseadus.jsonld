    {
      "@id": "estleg:RIIGIL_2_Par_189_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_189"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sadama sadamaregistrisse kandmise eest tasutakse riigilõivu 127,82 eurot. (2) Sadamaregistri kande muutmise eest tasutakse riigilõivu 12,78 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_189 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_189_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 189",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_189_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_189"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevale meresõiduohutust või keskkonnaohutust tõendava tunnistuse, sõidukõlblikkuse tunnistuse, mõõtekirja, laadungimärgi tunnistuse, meretöötunnistuse, meretöönõuetele vastavuse deklaratsiooni, ajutise meretöötunnistuse, kalandustöötunnistuse, tunnistuse „Laevaandmete alaline register” või ühekordse ülesõiduloa väljastamise eest tasutakse riigilõivu 6 eurot iga lehekülje eest. (2) Lootsi (mereloots, vanemmereloots, sadamaloots, avamereloots) kutsetunnistuse või lootsitasõidu loa väljastamise või pikendamise eest tasutakse riigilõivu 5 eurot. (3) Laevaliikluse korraldamise süsteemi operaatori või vanemoperaatori kutsetunnistuse, teenistusraamatu või teenistusraamatu kinnituslehe väljastamise eest tasutakse riigilõivu 5 eurot. (4) Käesolevas paragrahvis nimetatud tunnistuse või dokumendi duplikaadi väljastamise eest tasutakse sama suurusega riigilõivu kui originaaltunnistuse või -dokumendi väljastamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_189 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_189_v131122015035"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 189",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
