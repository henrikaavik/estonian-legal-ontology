        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_80 (redaktsioon 907808)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "907808",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_80_v12765603"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/907808",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 80",
      "estleg:partOfAct": {
