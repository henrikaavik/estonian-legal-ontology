        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tõestamistoimingu eest väljaspool välisesinduse ruume tasutakse riigilõivu kahekordses määras.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_307 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
