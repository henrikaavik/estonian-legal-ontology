      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Muu sissekande tegemise eest kinnistusraamatusse tasutakse riigilõivu 25 protsenti täismäärast.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_77 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
