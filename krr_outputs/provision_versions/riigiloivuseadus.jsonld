        "@type": "xsd:date"
      },
      "estleg:versionText": "Metsakorraldustööde tegevusloa andmise või kehtivusaja pikendamise taotluse läbivaatamise eest tasutakse riigilõivu 319,55 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_101 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
