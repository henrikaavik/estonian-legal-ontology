        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_164_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
