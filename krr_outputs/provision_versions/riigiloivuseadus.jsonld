      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eralasteaia tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu 500 eurot ning eralastehoiu tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu 100 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_53_1 (redaktsioon 108072025064)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025064",
