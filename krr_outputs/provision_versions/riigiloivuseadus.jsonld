      },
      "estleg:versionText": "Aeronavigatsiooniseadme sertifikaadi taotluse läbivaatamise eest tasutakse riigilõivu 990 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_142_6 (redaktsioon 130062023063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023063",
