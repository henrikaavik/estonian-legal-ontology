      },
      "estleg:versionText": "Riigilõivu ei võeta riikliku toetuse ja pensioni saamiseks ning eestkoste, hoolduse ja lapsendamise asjas vajaliku dokumendi ärakirja või väljavõtte õigsuse kinnitamise eest ning pensioni saamiseks vajaliku volikirja tõestamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_46 (redaktsioon 12804723)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12804723",
