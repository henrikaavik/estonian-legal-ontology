      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnistusraamatusse märke kandmise eest tasutakse riigilõivu 25 protsenti täismäärast. (2) Märke kustutamise eest, kui sellega ei kaasne märkega tagatud õiguse kandmist kinnistusraamatusse, tasutakse riigilõivu 25 protsenti täismäärast.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_74 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_74_v130122014001"
      },
