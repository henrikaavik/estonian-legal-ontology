      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_32_v129062012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kutseõppeasutuse põllumajanduse ning veoauto- ja bussijuhi kutseala õpilane on vabastatud riigilõivu tasumisest mootorsõiduki esmase juhiloa, juhiloa ja vastava duplikaadi ning ametikoolituse tunnistuse väljastamise eest, samuti riigilõivu tasumisest mootorsõidukijuhi teooriaeksami ja sõidueksami eest. (2) Riigiasutus ja avalik-õiguslikke ülesandeid täitev isik on vabastatud riigilõivu tasumisest seaduse, halduslepingu või haldusakti alusel avaliku ülesande täitmiseks vajalike liiklusregistri andmete kinnitatud väljavõtte eest. (3) Kui pankrotihaldur või ajutine pankrotihaldur taotleb ametiülesande korras liiklusregistrist andmete väljastamist, ei tasu ta selle eest riigilõivu.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_32 (redaktsioon 129062012007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062012007",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_32_v112072013015"
      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062012007",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 32",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_32_v112072013015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kutseõppeasutuse põllumajanduse, veoauto- ja bussijuhi ning autotehniku kutseala õpilane on vabastatud riigilõivu tasumisest õppekavajärgse mootorsõiduki esmase juhiloa, juhiloa ja vastava duplikaadi ning ametikoolituse tunnistuse väljastamise eest, samuti riigilõivu tasumisest mootorsõidukijuhi teooriaeksami ja sõidueksami eest. (2) Riigiasutus ja avalik-õiguslikke ülesandeid täitev isik on vabastatud riigilõivu tasumisest seaduse, halduslepingu või haldusakti alusel avaliku ülesande täitmiseks vajalike liiklusregistri andmete kinnitatud väljavõtte eest. (3) Kui pankrotihaldur või ajutine pankrotihaldur taotleb ametiülesande korras liiklusregistrist andmete väljastamist, ei tasu ta selle eest riigilõivu.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_32 (redaktsioon 112072013015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072013015",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_32_v127122013026"
      },
      "estleg:versionValidTo": {
        "@value": "2013-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112072013015",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 32",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_32_v127122013026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kutseõppeasutuse põllumajanduse, veoauto- ja bussijuhi ning autotehniku kutseala õpilane või isik, kellel ei ole vastava kutseala lõpetamisest möödunud rohkem kui üks aasta, on vabastatud riigilõivu tasumisest vastava kutsealaga seotud kategooria mootorsõiduki esmase juhiloa, juhiloa ja ametikoolituse tunnistuse väljastamise ning asendamise eest, samuti riigilõivu tasumisest vastava kategooria mootorsõidukijuhi liiklusteooria- ja sõidueksami sooritamise eest esimesel katsel. (2) Riigiasutus ja avalik-õiguslikke ülesandeid täitev isik on vabastatud riigilõivu tasumisest seaduse, halduslepingu või haldusakti alusel avaliku ülesande täitmiseks vajalike liiklusregistri andmete kinnitatud väljavõtte eest. (3) Kui pankrotihaldur või ajutine pankrotihaldur taotleb ametiülesande korras liiklusregistrist andmete väljastamist, ei tasu ta selle eest riigilõivu.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_32 (redaktsioon 127122013026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127122013026",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_32_v128112017005"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127122013026",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 32",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_32_v128112017005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kutseõppeasutuse põllumajanduse, veoauto- ja bussijuhi ning autotehniku kutseala õpilane või isik, kellel ei ole vastava kutseala lõpetamisest möödunud rohkem kui üks aasta, on vabastatud riigilõivu tasumisest vastava kutsealaga seotud kategooria mootorsõiduki esmase juhiloa, juhiloa ja ametikoolituse tunnistuse väljastamise ning asendamise eest, samuti riigilõivu tasumisest vastava kategooria mootorsõidukijuhi liiklusteooria- ja sõidueksami sooritamise eest esimesel katsel. (2) Riigiasutus ja avalik-õiguslikke ülesandeid täitev isik on vabastatud riigilõivu tasumisest seaduse, halduslepingu või haldusakti alusel avaliku ülesande täitmiseks vajalike liiklusregistri andmete kinnitatud väljavõtte eest. (3) Kui pankrotihaldur või ajutine pankrotihaldur taotleb ametiülesande korras liiklusregistrist andmete väljastamist, ei tasu ta selle eest riigilõivu. (4) Sõidukite andmebaasi kande tegemisel ja muutmisel liiklusseaduse § 174 lõikes 22 sätestatud alusel sõiduauto kasutamise kohta üksnes töö-, ameti- või teenistusülesannete täitmiseks ei tasuta riigilõivu.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_32 (redaktsioon 128112017005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128112017005",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_32_v107032018004"
      },
      "estleg:versionValidTo": {
        "@value": "2018-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128112017005",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 32",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_32_v107032018004",
      "@type": [
        "owl:NamedIndividual",
