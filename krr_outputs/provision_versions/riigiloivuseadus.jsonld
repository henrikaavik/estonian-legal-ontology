      },
      "estleg:versionText": "Mikrokvalifikatsiooniõppe õppekava Eesti hariduse infosüsteemi esitamise eest tasutakse riigilõivu 100 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_58_2 (redaktsioon 130012025005)",
