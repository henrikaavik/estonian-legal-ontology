    {
      "@id": "estleg:RIIGIL_2_Par_54_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kande tegemisel kinnistusraamatusse kinnistu jagamise või kinnistute ühendamise või kinnistu osa teise kinnistuga liitmise kohta tasutakse riigilõivu 25% täismäärast, kui nimetatud toimingutega ei kaasne omandi üleminekut. (2) Eri omanikele kuuluvate kinnistute ühendamisel või kinnistu osa liitmisel teisele omanikule kuuluva kinnistuga tasutakse riigilõivu 50% täismäärast. (3) Kinnistu jagamisel tasutakse lisaks käesoleva paragrahvi lõikes 1 nimetatud lõivule jagamisega kaasneva uute registriosade avamise eest alates kolmandast uuest registriosast iga uue registriosa eest 100 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_54 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_54_v232675"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 54",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
