      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kontrolli teostanud asutus esitab riigilõivu ebaõige võtmise või riigieelarvesse laekumata jäämise korral Maksuametile vastava ettekande.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_32 (redaktsioon 188211)",
        "@language": "et"
