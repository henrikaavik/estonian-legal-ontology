      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Allsüsteemi kasutuselevõtmise loa, raudteeveeremi turule laskmise loa või raudteeveeremi tüübiloa taotluse läbivaatamise eest tasutakse riigilõivu 4160 eurot.",
