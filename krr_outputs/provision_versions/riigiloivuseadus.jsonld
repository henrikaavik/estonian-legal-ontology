      },
      "estleg:versionValidTo": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13103493",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 248_2",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_248_2_v130062020015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_248_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puidust pakkematerjali, puidu ja muu objekti vastavusmärgiga märgistamise tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu 320 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_248_2 (redaktsioon 130062020015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062020015",
