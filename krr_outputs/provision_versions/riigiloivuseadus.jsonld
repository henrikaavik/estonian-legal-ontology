      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arhiiviteatise väljastamise eest tasutakse riigilõivu 15 eurot ja välisesinduses 30 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_346 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
