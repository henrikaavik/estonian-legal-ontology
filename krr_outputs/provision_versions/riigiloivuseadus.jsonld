      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutsekvalifikatsiooni tunnustamise taotluse läbivaatamise eest tasutakse riigilõivu 31,95 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_331 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
