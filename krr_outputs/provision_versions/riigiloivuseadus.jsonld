      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_51_2_v112032022006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_51_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Virtuaalvääringu teenuse pakkumise tegevusloa muutmise taotluse läbivaatamise eest ei võeta riigilõivu, kui tegevusloa muutmine piirdub ainult ettevõtja asukoha aadressiandmete muutmisega Eesti piires.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_51_2 (redaktsioon 112032022006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032022006",
