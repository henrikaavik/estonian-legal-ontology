      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu ei võeta nimeseaduse § 171 lõike 1 punktides 5–8 sätestatud juhul uue perekonnanime andmise avalduse läbivaatamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_48 (redaktsioon 118122025012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122025012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118122025012",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 48",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_49_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusraamatu toimingute eest võetava riigilõivu suurus määratakse lähtudes tehinguväärtusest käesoleva seaduse lisa 1 järgi või kindla summana.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_49 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_49_v12765603"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 49",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_49_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 36 lõikes 2, §-s 37, § 38 lõikes 1, § 39 lõigetes 4, 5 ja 6 ning § 43 lõikes 1 sätestatud riigilõivu tasumisest vabastamise või riigilõivumäära vähendamise taotlus esitatakse kirjalikult. Taotluses, välja arvatud diplomaatilises noodis, märgitakse: taotleja nimi või nimetus ja aadress; isiku, kelle riigilõivu tasumisest vabastamist või riigilõivu määra vähendamist taotletakse, isikunimi ning isikukood või selle puudumise korral sünniaeg ja -koht, kodakondsus, elukoht, töö- või teenistuskoht, kuusissetuleku suurus ja allikad ning ülalpeetavate arv; toiming, mille tegemise eest riigilõivu määra vähendamist või riigilõivu tasumisest vabastamist taotletakse; taotluse põhjendus. (2) Taotlusele lisatakse taotluse põhjendatust kinnitavad dokumendid.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_49 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_49_v12912297"
      },
      "estleg:versionValidTo": {
        "@value": "2008-02-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 49",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_49_v12912297",
      "@type": [
