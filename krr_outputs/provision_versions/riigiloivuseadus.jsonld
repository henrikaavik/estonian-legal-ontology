      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kultuuriväärtuse väljaveoloa taotluse läbivaatamise eest, samuti väljaveoloa andmise või sellest keeldumise eest kultuuriväärtuste väljaveo, ekspordi ja sisseveo seaduse § 16 lõikes 4 ja § 17 lõikes 3 sätestatud alustel tasutakse riigilõivu 6,39 eurot kultuuriväärtuse kohta, kuid kokku mitte rohkem kui 63,91 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_112 (redaktsioon 131122010025)",
