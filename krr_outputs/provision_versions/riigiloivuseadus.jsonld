      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_277"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisesinduse kaudu hagiavalduse, nõude või dokumendi teatavakstegemise eest tasutakse riigilõivu 230 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_277 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_277_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 277",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_277_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_277"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Terviseameti tervishoiutöötajana registreerimise tõendi kinnitatud ärakirja või tervishoiutöötaja kutsekvalifikatsiooni tunnustamise tõendi kinnitatud ärakirja väljastamise eest tasutakse riigilõivu 6,39 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_277 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_277_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 277",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_277_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_277"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravimi müügiloa andmise, uuendamise või muutmise taotluse läbivaatamise eest tasutakse riigilõivu: ravimi müügiloa andmise või uuendamise taotluse puhul – 32 eurot; ravimi müügiloa muutmise taotluse puhul – 16 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_277 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 277",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_278_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_278"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärimisõiguse tunnistuse väljastamise eest tasutakse riigilõivu lähtuvalt pärandisumma suurusest: kuni 10 000 krooni suuruse pärandisumma puhul 6 protsenti pärandisummast; üle 10 000 kuni 100 000 krooni suuruse pärandisumma puhul 1,5 protsenti pärandisummast; üle 100 000 kuni 1 000 000 krooni suuruse pärandisumma puhul 0,4 protsenti pärandisummast; üle 1 000 000 krooni suuruse pärandisumma puhul 0,2 protsenti pärandisummast.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_278 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_278_v13334735"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 278",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
