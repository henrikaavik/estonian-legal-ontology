    {
      "@id": "estleg:RIIGIL_2_Par_22_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilised isikud ei tasu riigilõivu: sünni- ja surmaakti koostamise eest, samuti nimetatud aktide alusel esmaste tunnistuste väljastamise eest; tunnistuste väljastamise eest sünniakti muutmisel seoses lapsendamisega või põlvnemisandmete muutumisega; perekonnaseisuametniku poolt perekonnaseisuakti koostamisel tehtud vigade parandamise eest; õigusvastaselt represseeritud sugulase surma ja selle põhjuste kohta kordustunnistuse väljastamise eest. (2) Kohus, valitsusasutus, valla- ja linnavalitsus ning notarid on vabastatud riigilõivu tasumisest nende pädevuses olevate ülesannete täitmiseks vajalike dokumentide ärakirjade väljastamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_22 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_22_v728933"
      },
      "estleg:versionValidTo": {
