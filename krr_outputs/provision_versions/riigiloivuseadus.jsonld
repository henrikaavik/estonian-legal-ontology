      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_248_v130062020015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_248"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2016/2031, mis käsitleb taimekahjustajatevastaseid kaitsemeetmeid, millega muudetakse Euroopa Parlamendi ja nõukogu määruseid (EL) nr 228/2013, (EL) nr 652/2014 ja (EL) nr 1143/2014 ning millega tunnistatakse kehtetuks nõukogu direktiivid 69/464/EMÜ, 74/647/EMÜ, 93/85/EMÜ, 98/57/EÜ, 2000/29/EÜ, 2006/91/EÜ ja 2007/33/EÜ (ELT L 317, 23.11.2016, lk 4–104), artikli 79 lõike 1 punktis c ja artikli 94 lõikes 1 nimetatud taime, taimse saaduse ja muu objekti, välja arvatud sertifitseeritud seemne ja seemnekartuli kohta taimepassi väljaandmise eest tasutakse riigilõivu 5 eurot iga 100 taimepassi kohta. (2) Taimepassi väljaandmise tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu 270 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_248 (redaktsioon 130062020015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062020015",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_248_v130062023063"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062020015",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 248",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
