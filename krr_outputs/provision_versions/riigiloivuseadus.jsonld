      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kultuuriväärtuse väljaveoloa taotluse läbivaatamise eest, samuti väljaveoloa andmise või sellest keeldumise eest kultuuriväärtuste väljaveo, ekspordi ja sisseveo seaduse § 16 lõikes 4 ja § 17 lõikes 3 sätestatud alustel tasutakse riigilõivu 7 eurot kultuuriväärtuse kohta, kuid kokku mitte rohkem kui 64 eurot.",
      "rdfs:label": {
