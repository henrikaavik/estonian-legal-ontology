      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaubamärgi või kollektiivkaubamärgi üleandmise, litsentsilepingu või õiguste ülemineku muude juhtude kohta tehtava kande eest riiklikusse kauba- ja teenindusmärkide registrisse tasutakse riigilõivu 700 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_128 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
