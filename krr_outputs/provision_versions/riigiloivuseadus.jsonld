      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutsekvalifikatsiooni tunnustamise taotluse, sealhulgas Euroopa kutsekaardi taotluse läbivaatamise eest tasutakse riigilõivu 32 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_342 (redaktsioon 131122015036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015036",
