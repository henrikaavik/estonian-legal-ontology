      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arhiiviteatise väljastamise eest tasutakse riigilõivu 25 eurot ja välisesinduses 40 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_346 (redaktsioon 108072025064)",
