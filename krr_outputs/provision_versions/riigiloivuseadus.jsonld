    {
      "@id": "estleg:RIIGIL_2_Par_14_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu võtnud asutus ei vaata riigilõivu tagastamise taotlust läbi, kui: riigilõivu tagastamise taotluse kohta on riigilõivu võtnud asutuse otsus; riigilõivu tagastamise osas on olemas jõustunud kohtuotsus või -määrus; puudub riigilõivu tasumist tõendav dokument juhul, kui see on nõutav.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_14 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_14_v12765603"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_14_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
