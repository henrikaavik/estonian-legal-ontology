      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Regionaalministri või tema volitatud isiku poolt haldusaktiga uue eesnime, perekonnanime või isikunime andmisel või eesnime, perekonnanime või isikunime taastamisel ei võeta riigilõivu nimeseaduse § 171 lõike 1 punktides 5–8 ja § 19 lõike 1 punktides 6–8 sätestatud juhul.",
      "rdfs:label": {
