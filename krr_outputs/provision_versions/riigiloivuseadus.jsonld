      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_52_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 35 lõikes 2, §-s 36, § 38 lõikes 1, § 39 lõigetes 4 ja 5, § 43 lõikes 1 ning § 50 lõikes 2 sätestatud riigilõivu tasumisest vabastamise või riigilõivumäära vähendamise taotlus esitatakse kirjalikult. Taotluses, välja arvatud diplomaatilises noodis, märgitakse: taotleja nimi või nimetus ja aadress; selle isiku, kelle riigilõivu tasumisest vabastamist või riigilõivumäära vähendamist taotletakse, isikunimi ning isikukood või selle puudumise korral sünniaeg ja -koht, kodakondsus, elukoht, töö- või teenistuskoht, kuusissetuleku suurus ja allikad ning ülalpeetavate arv; toiming, mille tegemise eest riigilõivumäära vähendamist või riigilõivu tasumisest vabastamist taotletakse; taotluse põhjendus. (2) Taotlusele lisatakse taotluse põhjendatust kinnitavad dokumendid.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_52 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_52_v131122015035"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 52",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_52_v131122015035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
