      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kokkuleppelise esindaja tunnustamise taotluse ja tunnustuse kehtivuse pikendamise taotluse läbivaatamise eest tasutakse riigilõivu 245 eurot.",
