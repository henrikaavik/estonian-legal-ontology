    {
      "@id": "estleg:RIIGIL_2_Par_30_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu ei võeta sertifikaadi muutmise taotluse läbivaatamise eest, mille eesmärk on sertifikaadiga antud õiguste vähendamine.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_30 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
