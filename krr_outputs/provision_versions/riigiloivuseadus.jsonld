      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_61_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriühingu täis- või usaldusühinguks ümberkujundamise äriregistrisse kandmise eest tasutakse riigilõivu 12,78 eurot. (2) Äriühingu osaühinguks või aktsiaseltsiks ümberkujundamise äriregistrisse kandmise eest tasutakse riigilõivu 127,82 eurot. (3) Euroopa äriühingu aktsiaseltsiks või aktsiaseltsi Euroopa äriühinguks ümberkujundamise äriregistrisse kandmise eest tasutakse riigilõivu 25,56 eurot. (4) Euroopa ühistu tulundusühistuks või tulundusühistu Euroopa ühistuks ümberkujundamise äriregistrisse kandmise eest tasutakse riigilõivu 25,56 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_61 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_61_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 61",
