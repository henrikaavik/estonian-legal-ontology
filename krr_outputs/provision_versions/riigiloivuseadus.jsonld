      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sisseveolitsentsi, väljaveolitsentsi või transiidiloa taotluse läbivaatamise eest tasutakse riigilõivu 200 krooni. (2) Sisseveolitsentsi, väljaveolitsentsi või transiidiloa kehtivusaja pikendamise taotluse läbivaatamise eest tasutakse riigilõivu 100 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_260 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
