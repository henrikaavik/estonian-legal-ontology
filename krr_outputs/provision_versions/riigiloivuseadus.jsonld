      },
      "estleg:versionText": "Sõidukikaardi taotluse läbivaatamise eest tasutakse riigilõivu 20 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_333 (redaktsioon 130062015057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062015057",
