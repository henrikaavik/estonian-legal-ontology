      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistute ühendamisel määratakse tehinguväärtus lähtuvalt ühendatavatest kinnisasjadest käesoleva seaduse § 335 kohaselt.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_337 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
