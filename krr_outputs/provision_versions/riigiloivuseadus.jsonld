      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sordi registreerimise taotluse läbivaatamise eest tasutakse riigilõivu 20 eurot. (2) Sordi ja geneetiliste ressursside säilitamiseks ette nähtud sordi sordilehte võtmise taotluse läbivaatamise eest tasutakse riigilõivu 25 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_261_14 (redaktsioon 130062023063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023063",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062023063",
