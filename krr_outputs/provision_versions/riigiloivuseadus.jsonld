      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Taimetervise registri kande eest tasutakse riigilõivu 500 krooni. (2) Registrikande muutmise eest tasutakse riigilõivu 100 krooni. (3) Taimetervise registri väljavõtte väljastamise eest tasutakse riigilõivu 25 krooni iga formaadis A4 lehekülje eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_206 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
