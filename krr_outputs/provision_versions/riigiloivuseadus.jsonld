        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõiv on seaduses sätestatud juhul ja käesolevas seaduses sätestatud määras tasutav summa lõivustatud toimingu tegemise eest.",
      "rdfs:label": {
