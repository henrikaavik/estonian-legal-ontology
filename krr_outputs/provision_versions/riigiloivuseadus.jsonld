      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ajutise liputunnistuse väljastamise eest laeva lipuõiguse ja laevaregistrite seaduse § 23 alusel tasutakse riigilõivu 1300 krooni. (2) Laevapereta prahitud laevade registri dokumendi ärakirja väljastamise eest tasutakse riigilõivu 150 krooni. (3) Kaubandusliku meresõidu koodeksi alusel asutatud laevaregistri dokumendi kinnitatud ärakirja väljastamise eest tasutakse riigilõivu 50 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_164 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
