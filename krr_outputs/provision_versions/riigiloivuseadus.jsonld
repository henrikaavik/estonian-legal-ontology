      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Perekonnaseisutõendi, abiellumist takistavate asjaolude puudumise tõendi, perekonnaseisuakti või perekonnakirja või lisatoimetuses oleva dokumendi kinnitatud ärakirja väljastamise eest tasutakse riigilõivu 25 krooni. (2) Perekonnaseisuakti kantud andmete kohta tõendi väljastamise eest tasutakse riigilõivu 50 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_301 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_301_v13334735"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 301",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_301_v13334735",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_301"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Korduva sünnitõendi, surmatõendi, abielutõendi ja abielulahutuse tõendi väljastamise eest makstakse riigilõivu 50 krooni. (2) Abieluvõimetõendi, perekonnaseisuakti, perekonnakirja või lisatoimetuses oleva dokumendi kinnitatud ärakirja väljastamise eest tasutakse riigilõivu 25 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_301 (redaktsioon 13334735)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334735",
