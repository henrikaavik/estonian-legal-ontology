      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 328",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_328_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_328"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ehitise püstitamise, rekonstrueerimise või laiendamise ehitusloa taotluse läbivaatamise eest tasutakse riigilõivu 130 eurot ja lisaks 0,35 eurot iga ehitatava ruutmeetri kohta ehitusprojektis fikseeritud ehitise suletud netopinnast arvutatuna. (2) Ehitusloa taotluse läbivaatamise eest tasutakse riigilõivu 64 eurot, kui ehitusluba taotletakse üksikelamu, suvila, aiamaja või taluhoone püstitamiseks. (3) Ehitusloa taotluse läbivaatamise eest tasutakse riigilõivu 32 eurot, kui ehitusluba taotletakse: üksikelamu, korteri, suvila, aiamaja või taluhoone rekonstrueerimiseks või laiendamiseks; ehitise lammutamiseks.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_328 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_328_v104122019024"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122014001",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 328",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
