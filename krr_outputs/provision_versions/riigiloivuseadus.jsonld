        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutsekvalifikatsiooni tunnustamise taotluse, sealhulgas Euroopa kutsekaardi taotluse läbivaatamise eest tasutakse riigilõivu 130 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_342 (redaktsioon 130122023006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122023006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122023006",
      "estleg:sourceAct": "Riigilõivuseadus",
