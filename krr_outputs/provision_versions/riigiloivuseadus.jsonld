      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu: õnnemängu korraldamiseks 47 940 eurot; osavusmängu korraldamiseks 3200 eurot; toto korraldamiseks 31 960 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_260 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
