      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_35_v898839",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui riigilõivu maksja ei ole tasunud riigilõivu Maksu- ja Tolliameti ettekirjutuses määratud tähtaja jooksul, on Maksu- ja Tolliametil õigus pöörduda kohtutäituri poole riigilõivu maksja poolt tasumata riigilõivu sissenõudmiseks täitemenetluse seadustikus (RT I 1993, 49, 693; 2001, 29, 156; 43, 238) ettenähtud korras. (2) Riigilõivu maksja varale võib pöörata sissenõuet kahe aasta jooksul, arvates päevast, mil riigilõiv oleks tulnud tasuda, rakendades selleks täitemenetluse seadustikus sätestatud korda. [Paragrahvi 35 sõnastus alates 01.06.2005]",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_35 (redaktsioon 898839)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898839",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_35_v907808"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-02",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898839",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 35",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_35_v907808",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui riigilõivu maksja ei ole riigilõivu tasunud ettekirjutuses määratud tähtaja jooksul, on riigilõivu võtjal õigus pöörduda kohtutäituri poole riigilõivu maksja poolt tasumata riigilõivu sissenõudmiseks. (2) Riigilõivu sissenõudmise aegumistähtaeg on kaks aastat. Aegumistähtaeg algab aastale, kui riigilõiv oleks tulnud tasuda, järgneva aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_35 (redaktsioon 907808)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "907808",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_35_v12765603"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/907808",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 35",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_35_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
