        "@id": "estleg:RIIGIL_2_Par_16_v752854"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/749990",
      "estleg:sourceAct": "Riigilõivuseadus",
