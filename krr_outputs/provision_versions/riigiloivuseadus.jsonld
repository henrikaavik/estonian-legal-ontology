      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abielulahutuse kande tegemise eest tasutakse riigilõivu 25,56 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_328 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
