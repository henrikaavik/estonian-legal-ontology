      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu tagastamise taotlust ei vaadata läbi, kui: puudub teave riigilõivu tasumise kohta; taotluse kohta on tehtud riigilõivu võtja otsus või kohtumäärus; riigilõivu tagastamise nõue on aegunud.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_14 (redaktsioon 12765603)",
        "@language": "et"
      },
