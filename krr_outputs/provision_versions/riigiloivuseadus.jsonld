      "estleg:provisionRef": "RIIGIL_2 § 317",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_317_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_317"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ehitise püstitamise, rekonstrueerimise või laiendamise ehitusloa taotluse läbivaatamise eest tasutakse riigilõivu 127,82 eurot ja lisaks 0,31 eurot iga ehitatava ruutmeetri kohta ehitusprojektis fikseeritud ehitise suletud netopinnast arvutatuna. (2) Ehitusloa taotluse läbivaatamise eest tasutakse riigilõivu 63,91 eurot, kui ehitusluba taotletakse üksikelamu, suvila, aiamaja või taluhoone püstitamiseks. (3) Ehitusloa taotluse läbivaatamise eest tasutakse riigilõivu 31,95 eurot, kui ehitusluba taotletakse: üksikelamu, korteri, suvila, aiamaja või taluhoone rekonstrueerimiseks või laiendamiseks; ehitise lammutamiseks.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_317 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_317_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 317",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
