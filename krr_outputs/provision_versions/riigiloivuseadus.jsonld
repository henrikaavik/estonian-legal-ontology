        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tasemeeksamiks ettevalmistamisele suunatud eesti keele täienduskoolituse läbiviimise tegevusloa taotluse läbivaatamise eest tasutakse riigilõivu 100 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_56_1 (redaktsioon 123032015032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032015032",
