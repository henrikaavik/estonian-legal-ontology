      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_28_1_v907808",
      "@type": [
        "owl:NamedIndividual",
