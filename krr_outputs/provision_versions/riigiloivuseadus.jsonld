      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vastavushindamisasutuse määramistaotluse läbivaatamise eest tasutakse riigilõivu 2590 eurot. (2) Teavitatud asutuse määramisest teavitamise ja tegevusloa väljastamise eest tasutakse riigilõivu 777 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_285_5 (redaktsioon 131122024019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122024019",
