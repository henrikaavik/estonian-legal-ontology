    {
      "@id": "estleg:RIIGIL_2_Par_26_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigilõivu ei võeta alusetu ega ebaõige kande parandamise eest. (2) Riigiasutus, valla- ja linnavalitsus, notar ning kohtutäitur on vabastatud riigilõivu tasumisest tema pädevuses oleva ülesande täitmiseks vajaliku registridokumendi ärakirja väljastamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_26 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
