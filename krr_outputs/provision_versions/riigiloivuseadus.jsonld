      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 170 lõike 1 punktides 2–12, § 171 lõike 1 punktides 1–4 ja § 172 lõike 1 punktides 1–3 nimetatud tegevusloa esimese kehtivusaasta eest tasutakse riigilõiv enne tegevusloa taotluse esitamist ning iga järgneva kehtivusaasta eest vähemalt 10 päeva enne vastava kehtivusaasta algust.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_173 (redaktsioon 12765603)",
        "@language": "et"
      },
