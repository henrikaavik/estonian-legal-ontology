      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_118_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riikidevaheliste lepingute alusel nõutava veoloa taotluse läbivaatamise eest tasutakse riigilõivu 6,39 eurot. (2) Aastase kehtivusajaga Euroopa Transpordiministrite Konverentsi (CEMT) veoloa taotluse läbivaatamise eest tasutakse riigilõivu 375,80 eurot. (3) Ühenduse veoloa taotluse läbivaatamise eest tasutakse riigilõivu 97,78 eurot. (4) Ühenduse veoloa kinnitatud ärakirja väljastamise eest tasutakse riigilõivu 15,33 eurot. (5) Ühenduse tegevusloa alusel töötavale mitteliikmesriigi kodanikust autojuhile nõukogu määruse (EMÜ) nr 881/92 turulepääsu kohta sellise ühenduses toimuva kaupade autoveo puhul, mille algus- või lõpp-punkt asub liikmesriigi territooriumil või mis läbib ühe või mitme liikmesriigi territooriumi (EÜT L 95, 9.4.1992, lk 1–7), artiklist 3 tuleneva autojuhi tunnistuse väljastamise eest tasutakse riigilõivu 12,78 eurot. (6) Juhuveo kontrolldokumendi väljastamise eest tasutakse riigilõivu 38,34 eurot. (7) Nõukogu määruse (EMÜ) nr 684/92 bussidega toimuva rahvusvahelise reisijateveo ühiseeskirjade kohta (EÜT L 74, 20.3.1992, lk 1–9) artiklist 13 tuleneva ühenduse oma kulul korraldatava rahvusvahelise sõitjateveo veoloa väljastamise eest tasutakse riigilõivu 15,33 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_118 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_118_v130122011052"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 118",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
