      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kvalifitseeritud kiirguseksperdi litsentsi taotluse läbivaatamise eest tasutakse riigilõivu 31,95 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_99 (redaktsioon 131122010025)",
