      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_265_v129062018039",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_265"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eriloa väljastamise eest tulirelva või gaasirelva Eestisse sisseveoks või Eestist väljaveoks tasutakse riigilõivu 30 eurot iga relva kohta. Eriloa muutmisel või pikendamisel tasutakse riigilõivu 30 eurot. Kui eriloa muutmisel sisse- või väljaveetavate relvade arv suureneb, tasutakse lisaks riigilõivu 30 eurot iga lisandunud relva kohta. (2) Eriloa väljastamise, muutmise ja pikendamise eest tulirelva oluliste osade ja laskemoona Eestisse sisseveoks tasutakse riigilõivu 30 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_265 (redaktsioon 129062018039)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062018039",
