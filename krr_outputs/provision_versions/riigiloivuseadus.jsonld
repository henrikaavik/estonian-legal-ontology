      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigisaladuse ja salastatud välisteabe seaduse alusel väljastatava töötlemisloa taotluse läbivaatamise eest tasutakse riigilõivu järgmiselt: töötlemisloa esmakordsel taotlemisel 6000 eurot; töötlemisloa kehtivuse pikendamisel 3000 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_269_1 (redaktsioon 108072025064)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025064",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072025064",
