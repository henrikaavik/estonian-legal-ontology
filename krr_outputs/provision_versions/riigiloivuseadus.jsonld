        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Karistusregistri arhiivi kinnitatud teate väljastamise eest tasutakse riigilõivu 50 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_234 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
