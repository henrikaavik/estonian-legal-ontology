      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui tehniliseks teenistuseks määramine toimub Maanteeameti algatusel, on tehniline teenistus riigilõivu tasumisest vabastatud.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_51_1 (redaktsioon 128032017009)",
