      },
      "estleg:versionValidTo": {
        "@value": "2008-12-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_30_v13088361",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigilõivu ei võeta sertifikaadi muutmise taotluse läbivaatamise eest, mille eesmärk on sertifikaadiga antud õiguste vähendamine. (2) Riigilõivu ei võeta sertifikaadi hoidmise eest, kui sertifikaadi hoidmiseks vajalikku nõuetele vastavuse kontrolli ei teosta Lennuamet. (3) Riigilõivu ei võeta Lennuameti tehtavate toimingute eest, mille tegemise aluseks on lennundusseaduse § 7 1 lõikes 2 nimetatud Lennuameti tunnustatud isiku teostatud siseriiklikele ja rahvusvahelistele nõuetele vastavuse kontrolli kontrollakt.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_30 (redaktsioon 13088361)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13088361",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_30_v123122010031"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13088361",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
