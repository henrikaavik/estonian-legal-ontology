    },
    {
      "@id": "estleg:RIIGIL_2_Par_20_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus, valitsusasutus, valla- ja linnavalitsus, notar ning kohtutäitur on vabastatud riigilõivu tasumisest nende pädevuses olevate ülesannete täitmiseks vajalike registridokumentide ärakirjade väljastamisel. (2) Riigilõivuga ei maksustata alusetu või ebaõige kande parandamist registris.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_20 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
