      },
      "estleg:versionText": "Korteriomandi kinnistamisel on tehinguväärtuseks 50% korteriomandi reaalosale vastava maa kaasomandiosa maksustamishinnast.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_203 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
