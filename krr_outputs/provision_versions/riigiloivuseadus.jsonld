      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi- või kohaliku omavalitsuse üksuse eelarvest rahastatav haridusasutus, sotsiaalasutus ja tervishoiuteenuse osutaja on vabastatud riigilõivu tasumisest asutusesisese toitlustamise järelevalvetoimingute eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_35 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
