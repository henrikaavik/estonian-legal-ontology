      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ruumi omanikule isiku kohta, kelle elukoha aadress rahvastikuregistris on temale kuuluva ruumi aadress, rahvastikuregistrist andmete väljastamise taotluse läbivaatamise eest perekonnaseisutoimingute seaduse § 3 lõikes 32 sätestatud maakonnakeskuse kohaliku omavalitsuse üksuse poolt, mis ei ole ruumi asukohajärgne kohaliku omavalitsuse üksus, tasutakse riigilõivu 10 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_341_4 (redaktsioon 122122022006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122022006",
