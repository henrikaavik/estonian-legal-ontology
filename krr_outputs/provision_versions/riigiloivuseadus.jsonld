    {
      "@id": "estleg:RIIGIL_2_Par_357_v117032011026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_357"
