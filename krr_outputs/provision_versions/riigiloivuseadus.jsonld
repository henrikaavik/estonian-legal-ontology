      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljaveo üldloa kasutaja õiendi taotluse läbivaatamise eest tasutakse riigilõivu 200 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_261 (redaktsioon 12765603)",
