      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_142_6 (redaktsioon 109042026003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109042026003",
