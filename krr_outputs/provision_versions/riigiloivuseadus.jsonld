      "estleg:versionText": "Tervishoiuameti tõendi tervishoiutöötajana registreerimise kohta kinnitatud ärakirja väljastamise eest tasutakse riigilõivu 100 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_252 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
