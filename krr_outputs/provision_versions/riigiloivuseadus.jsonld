      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakkude, kudede ja elundite käitlemise tegevusloa muutmise taotluse läbivaatamise eest tasutakse riigilõivu 5000 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_248_2 (redaktsioon 13103493)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13103493",
      "estleg:supersededByVersion": {
