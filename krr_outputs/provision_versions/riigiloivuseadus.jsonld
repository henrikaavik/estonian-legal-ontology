      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa patenditaotluse patendinõudluse tõlke avalikustamise eest tasutakse riigilõivu 500 krooni. (2) Euroopa patendikirjelduse tõlke või muudetud Euroopa patendikirjelduse tõlke avalikustamise eest tasutakse riigilõivu 700 krooni. (3) Euroopa patendikirjelduse tõlke või muudetud Euroopa patendikirjelduse tõlke esitamise tähtaja pikendamise eest tasutakse riigilõivu 500 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_149 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_149_v131122010025"
      },
