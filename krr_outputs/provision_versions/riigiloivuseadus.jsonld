      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Autojuhi, sõidumeeriku paigaldamise töökoja, kontrollija või tööandja kaardi väljastamise eest tasutakse riigilõivu 750 krooni. (2) Sõidumeerikukaardi taotlemisel käesoleva seaduse § 20 lõikes 2 sätestatud juhul tasutakse riigilõivu 550 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_190 (redaktsioon 12765603)",
        "@language": "et"
      },
