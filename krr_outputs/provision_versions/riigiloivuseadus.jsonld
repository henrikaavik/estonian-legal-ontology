      },
      "estleg:versionText": "Maakorraldustööde tegevuslitsentsi taotluse läbivaatamise eest tasutakse riigilõivu 255,64 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_106 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
