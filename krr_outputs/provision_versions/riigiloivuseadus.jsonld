        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/672831",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 191",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
