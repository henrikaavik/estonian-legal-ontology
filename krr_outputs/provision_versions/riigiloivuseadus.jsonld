    {
      "@id": "estleg:RIIGIL_2_Par_269_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_269"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete sisseveo- või väljaveoloa taotluse läbivaatamise eest tasutakse riigilõivu: narkootiliste ja psühhotroopsete ainete sisse- või väljaveo puhul – 6,39 eurot; narkootiliste ja psühhotroopsete ainete lähteainete ekspordi puhul – 6,39 eurot; narkootiliste ja psühhotroopsete ainete lähteainete impordi puhul – 6,39 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_269 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
