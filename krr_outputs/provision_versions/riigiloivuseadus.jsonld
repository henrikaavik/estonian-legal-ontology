    {
      "@id": "estleg:RIIGIL_2_Par_3_v188211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigilõivuga maksustatav toiming (edaspidi toiming) käesoleva seaduse tähenduses on juriidiline toiming, avalduse läbivaatamine või dokumendi väljastamine, mille eest käesolev seadus näeb ette riigilõivu tasumise. (2) Riigilõivuga maksustatakse: kohtuasjade toimingud; äriregistri toimingud; mittetulundusühingute ja sihtasutuste registri toimingud; [Punkt 31 jõustub 01.07.2002] usuliste ühenduste registri toimingud; kommertspandiregistri toimingud; kinnistusraamatu ja laevakinnistusraamatu toimingud; abieluvararegistri toimingud; pärimisregistri toimingud; liiklusregistri toimingud; karistusregistri toimingud; hooneregistri toimingud; perekonnaseisuasutuse toimingud; krediidiasutuste, kindlustusandjate, kindlustusvahendajate, väärtpaberituru kutseliste osaliste, fondivalitsejate ja investeerimisfondidega seotud toimingud; hasartmängu- ja loteriiseaduse alusel teostatavad toimingud; toiduseaduse, veterinaarkorralduse seaduse, loomatauditõrje seaduse ja loomakaitseseaduse alusel teostatavad toimingud; [Punkti 121 sõnastus kuni 30.06.2002] söödaregistri toimingud; [Punkti 121 sõnastus alates 01.07.2002] söödaseaduse alusel teostatavad toimingud; ravimiseaduse alusel teostatavad toimingud; kehtetu – tervishoiuteenuste korraldamise seaduse alusel teostatavad toimingud;14) sordikaitseseaduse alusel teostatavad toimingud; [Punkti 15 sõnastus kuni 30.06.2002] tolliseaduse alusel teostatavad toimingud; [Punkti 15 sõnastus alates 01.07.2002] tolliseadustiku alusel teostatavad toimingud ; relvaseaduse alusel teostatavad toimingud; lõhkematerjaliseaduse alusel teostatavad toimingud; maakatastriseaduse ja maapõueseaduse alusel teostatavad toimingud; Lennuameti toimingud; Veeteede Ameti toimingud; Patendiameti toimingud; Konkurentsiameti toimingud; välisesinduste tõestamis- ja muud toimingud ; isikut tõendavate dokumentide seaduse ja kodakondsuse seaduse alusel teostatavad toimingud; välismaalaste seaduse ja selle täitmiseks antud õigustloovate aktide alusel teostatavad toimingud; riiklike tegevuslitsentside ja tegevuslubade väljastamine; valla- või linnasekretäri ning vangladirektori tõestamistoimingud ; arhiiviseaduse alusel teostatavad toimingud; energiaseaduse alusel teostatavad toimingud; raudteeseaduse alusel teostatavad toimingud; Sideameti toimingud; digitaalallkirja seaduse alusel teostatavad toimingud; mahepõllumajanduse seaduse alusel teostatavad toimingud; väetiste registri toimingud; taimekaitseseaduse alusel teostatavad toimingud; muud käesoleva seadusega ettenähtud toimingud.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_3 (redaktsioon 188211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188211",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_3_v188253"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/188211",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_3_v188253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
