      },
      "estleg:versionText": "Kutsekvalifikatsiooni tunnustamise taotluse läbivaatamise eest tasutakse riigilõivu 32 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_342 (redaktsioon 130122014001)",
