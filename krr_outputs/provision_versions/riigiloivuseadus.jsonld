        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_359 (redaktsioon 12778246)",
        "@language": "et"
      },
