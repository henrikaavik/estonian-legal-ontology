        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakkude, kudede ja elundite käitlemise tegevusloa muutmise taotluse läbivaatamise eest tasutakse riigilõivu 320 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_285 (redaktsioon 130122014001)",
