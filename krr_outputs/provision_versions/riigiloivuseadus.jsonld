alitsusüksuse piires.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_17 (redaktsioon 188253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "188253",
      "estleg:supersededByVersion": {
