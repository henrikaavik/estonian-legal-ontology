    {
      "@id": "estleg:RIIGIL_2_Par_261_27_v130062023063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_261_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi toidu ja sööda käitlejate registri andmete kinnitatud väljavõtte eest tasutakse riigilõivu 1 euro iga formaadis A4 lehekülje eest.",
