      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhusõidukite registrisse kantud registerpandi kohta kinnitatud väljatrüki väljastamise eest tasutakse riigilõivu 1,91 eurot. (2) Sellise tõendi väljastamise eest, millega tõendatakse, et kannet ei ole muudetud või et teatud kannet või kandeid registris ei ole, tasutakse riigilõivu 1,59 eurot. (3) Õhusõidukite registrisse kantud registerpandi kohta muu dokumendi kinnitatud ärakirja või väljatrüki väljastamise eest tasutakse riigilõivu 0,31 eurot iga lehekülje eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_146 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_146_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 146",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
