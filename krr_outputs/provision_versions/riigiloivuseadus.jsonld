      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivu ei võeta riikliku toetuse ja pensioni saamiseks ning eestkoste, hoolduse ja lapsendamise asjas vajaliku dokumendi ärakirja või väljavõtte õigsuse kinnitamise eest ning pensioni saamiseks vajaliku volikirja ning pensioni ja toetuste teise isiku arvelduskontole kandmise avalduse tõestamise eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_45 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
