      },
      "estleg:versionText": "Kvalifitseeritud kiirguseksperdi litsentsi taotluse läbivaatamise eest tasutakse riigilõivu 500 krooni.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_89 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
