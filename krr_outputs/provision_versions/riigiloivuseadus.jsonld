    {
      "@id": "estleg:RIIGIL_2_Par_119_v911041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
