      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaregistri arhiivi andmetest elektroonilise koopia tegemise eest tasutakse riigilõivu: iga formaadis A4 lehekülje eest 1,27 eurot; suurema kui formaadis A4 väljavõtte puhul 0,31 eurot iga ruutdetsimeetri eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_109 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_109_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
