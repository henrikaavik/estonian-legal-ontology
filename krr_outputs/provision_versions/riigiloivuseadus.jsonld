    {
      "@id": "estleg:RIIGIL_2_Par_37_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_37"
