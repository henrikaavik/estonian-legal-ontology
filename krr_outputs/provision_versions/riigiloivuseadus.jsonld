      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_331_6_v123032015032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_331_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne ehitusseadustiku jõustumist ebaseaduslikult ehitatud ehitise ehitisregistrisse kandmise eest tasutakse riigilõivu 500 eurot. Ehitisregistrisse kandmisel ei ole vajalik täiendavalt tasuda riigilõivu ehitus- või kasutusloa eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_331_6 (redaktsioon 123032015032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032015032",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 331_6",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_331_7_v123032015032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_331_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitisregistri andmete kinnitatud väljavõtte väljastamise eest tasutakse riigilõivu 2 eurot iga lehekülje eest.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_331_7 (redaktsioon 123032015032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032015032",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 331_7",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_332_v12765603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_332"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elektroonilise side seaduse (RT I 2004, 87, 593; 2006, 31, 234) § 190 2 lõige 1 muudetakse ja sõnastatakse järgmiselt: « (1) Kolmanda põlvkonna mobiiltelefonivõrgu sagedusloa omanik on kohustatud igal aastal, välja arvatud need aastad, kui antakse sagedusluba või pikendatakse selle kehtivust, tasuma loa andmise kuupäevaks tasu vastava sagedusala kasutamise eest riigilõivuseaduse lisa 3 punktis 2 sätestatud määras, arvestades riigilõivuseaduse § 159 lõike 2 punkti 4 ja lõike 4 punkti 4.»",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_332 (redaktsioon 12765603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12765603",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_332_v131122010025"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12765603",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 332",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_332_v131122010025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_332"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pandilepingu registreerimise eest tasutakse käesoleva seaduse lisas 2 sätestatud riigilõivu täismäär olenevalt tehinguväärtusest. (2) Registerpandi järjekoha muutmise eest tasutakse 75 protsenti käesoleva seaduse lisas 2 sätestatud riigilõivu täismäärast olenevalt tehinguväärtusest. (3) Pandilepingu lisa registreerimise eest tasutakse riigilõivu 6,39 eurot. (4) Pandisummat suurendava pandilepingu lisa registreerimise eest tasutakse riigilõivu käesoleva seaduse lisas 2 sätestatud riigilõivu täismääras, kusjuures tehinguväärtuseks on pandisumma, mille registrisse kandmist taotletakse, ning registrisse kantud pandisumma vahe.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_332 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_332_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
      "estleg:sourceAct": "Riigilõivuseadus",
      "estleg:provisionRef": "RIIGIL_2 § 332",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIL_2_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_332_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
