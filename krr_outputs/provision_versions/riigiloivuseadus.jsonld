      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Perekonnaseisuandmete kinnitatud väljavõtte andmise eest tasutakse riigilõivu 15 eurot. (3) Abieluvõimetõendi väljastamise eest tasutakse riigilõivu 15 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_307 (redaktsioon 131122010025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010025",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIL_2_Par_307_v130122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122010025",
