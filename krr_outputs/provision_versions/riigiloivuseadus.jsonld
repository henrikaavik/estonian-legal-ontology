      }
    },
    {
      "@id": "estleg:RIIGIL_2_Par_99_v130122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIL_2_Par_99"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa patenditaotluse siseriiklikku menetlusse võtmise eest tasutakse riigilõivu: patenditaotlusena 225 eurot; kasuliku mudeli registreerimise taotlusena 105 eurot.",
      "rdfs:label": {
        "@value": "RIIGIL_2_Par_99 (redaktsioon 130122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014001",
