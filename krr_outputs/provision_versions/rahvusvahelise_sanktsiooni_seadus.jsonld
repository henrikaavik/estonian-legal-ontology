        "@value": "2022-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RAHVUS_Par_44_v108032022003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
