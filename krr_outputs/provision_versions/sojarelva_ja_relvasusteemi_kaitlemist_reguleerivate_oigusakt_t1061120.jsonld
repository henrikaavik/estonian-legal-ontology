      "dc:source": "Sõjarelva ja relvasüsteemi käitlemist reguleerivate õigusaktide tundmise eksami korraldaja, ulatus, tingimused ja läbiviimise kord"
    },
    {
      "@id": "estleg:Reg_1061120_Par_1_v1061120",
