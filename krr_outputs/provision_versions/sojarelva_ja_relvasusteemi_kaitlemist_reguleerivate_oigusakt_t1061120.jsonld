    {
      "@id": "estleg:Reg_1061120_Par_3_v1061120",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061120_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eksamikomisjon moodustatakse Politsei- ja Piirivalveameti peadirektori käskkirjaga või tema volitatud ametniku kirjaliku otsusega. Eksamikomisjonis on vähemalt kaks liiget, kellest üks on eksamikomisjoni esimees. Komisjoni liikmeks võib nimetada ka teise ametiasutuse esindaja. Eksamikomisjon moodustatakse Politsei- ja Piirivalveameti peadirektori käskkirjaga või tema volitatud ametniku kirjaliku otsusega. Eksamikomisjonis on vähemalt kaks liiget, kellest üks on eksamikomisjoni esimees. Komisjoni liikmeks võib nimetada ka teise ametiasutuse esindaja. 2 (2) Eksamikomisjoni liige peab tundma sõjarelva ja relvasüsteemi käitlemist reguleerivaid õigusakte ning eksami vastuvõtmise metoodikat. Eksamikomisjoni liige peab tundma sõjarelva ja relvasüsteemi käitlemist reguleerivaid õigusakte ning eksami vastuvõtmise metoodikat.",
      "rdfs:label": {
        "@value": "Reg_1061120_Par_3 (redaktsioon 1061120)",
        "@language": "et"
      },
