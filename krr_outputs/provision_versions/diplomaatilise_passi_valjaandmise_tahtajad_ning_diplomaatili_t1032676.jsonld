      }
    },
    {
      "@id": "estleg:Reg_1032676_Par_8_v1032676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032676_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui diplomaatilise passi taotlejalt ei ole terviseseisundi tõttu ajutiselt või püsivalt võimalik üheltki sõrmelt sõrmejälge võtta, peab dokumendi taotleja lisama taotlusele raviarsti väljastatud käesoleva määruse lisas toodud vormi kohase tõendi (edaspidi tõend). Eesti välisesinduses esitatava taotluse puhul võib taotleja lisada vormikohase tõendi asemel välisriigi arsti tõendi. Kui diplomaatilise passi taotlejalt ei ole terviseseisundi tõttu ajutiselt või püsivalt võimalik üheltki sõrmelt sõrmejälge võtta, peab dokumendi taotleja lisama taotlusele raviarsti väljastatud käesoleva määruse lisas toodud vormi kohase tõendi (edaspidi tõend). Eesti välisesinduses esitatava taotluse puhul võib taotleja lisada vormikohase tõendi asemel välisriigi arsti tõendi. Ajutist sõrmejälgede võtmise võimatust kinnitav tõend kehtib kuni kuus kuud. RT I 2020-01-10 8 110012020008 2020-01-13 Ajutist sõrmejälgede võtmise võimatust kinnitav tõend kehtib kuni kuus kuud. 2 (2) Kui taotleja ühelt või kummaltki käelt ei saa sõrmejälge võtta sõrme esimese lüli puudumise tõttu, siis ei ole lõikes 1 nimetatud tõendit lisada vaja. Sõrme esimese lüli puudumise tuvastab ametnik. Kui taotleja ühelt või kummaltki käelt ei saa sõrmejälge võtta sõrme esimese lüli puudumise tõttu, siis ei ole lõikes 1 nimetatud tõendit lisada vaja. Sõrme esimese lüli puudumise tuvastab ametnik.",
      "rdfs:label": {
        "@value": "Reg_1032676_Par_8 (redaktsioon 1032676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032676",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032676",
      "estleg:sourceAct": "Diplomaatilise passi väljaandmise tähtajad ning diplomaatilise passi väljaandmise taotlemisel esitatavate tõendite ja andmete loetelu",
      "estleg:provisionRef": "Reg_1032676 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032676_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032676_Par_9_v1032676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032676_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui taotleja on alaealine, kellele ei ole väljastatud Eesti isikut tõendavat dokumenti, lisatakse taotlusele sünnitunnistus. Sünnitunnistust ei ole vaja esitada, kui andmed sisalduvad rahvastikuregistris. RT I 2020-01-10 8 110012020008 2020-01-13 Kui taotleja on alaealine, kellele ei ole väljastatud Eesti isikut tõendavat dokumenti, lisatakse taotlusele sünnitunnistus. Sünnitunnistust ei ole vaja esitada, kui andmed sisalduvad rahvastikuregistris.",
      "rdfs:label": {
        "@value": "Reg_1032676_Par_9 (redaktsioon 1032676)",
        "@language": "et"
      },
