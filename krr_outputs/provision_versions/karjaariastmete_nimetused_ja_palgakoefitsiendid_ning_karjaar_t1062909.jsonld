    {
      "@id": "estleg:Reg_1062909_Par_15_v1062909",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062909_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määruse jõustumise ajal põhikoolis või gümnaasiumis õpetajana töötavale inimesele, kellel on omandatud vanemõpetaja, tase 7 kutse, omistatakse määruse jõustumisest arvates 30 kalendripäeva jooksul vanemõpetaja aste. Määruse jõustumise ajal põhikoolis või gümnaasiumis õpetajana töötavale inimesele, kellel on omandatud vanemõpetaja, tase 7 kutse, omistatakse määruse jõustumisest arvates 30 kalendripäeva jooksul vanemõpetaja aste. 2 (2) 1. juunil 2026. a kutseõppeasutuses üldharidusaine õpetajana töötavale inimesele, kellel on omandatud vanemõpetaja, tase 7 kutse, omistatakse hiljemalt 1. juuliks 2026. a vanemõpetaja aste. 1. juunil 2026. a kutseõppeasutuses üldharidusaine õpetajana töötavale inimesele, kellel on omandatud vanemõpetaja, tase 7 kutse, omistatakse hiljemalt 1. juuliks 2026. a vanemõpetaja aste. 3 (3) Vanemõpetaja astme omistamiseks õpetajale, kellel puudub vanemõpetaja, tase 7 kutse, peab kooli pidaja või pidaja volitusel kooli direktor moodustama §-s 7 nimetatud komisjoni hiljemalt 1. septembriks 2026. a. Vanemõpetaja astme omistamiseks õpetajale, kellel puudub vanemõpetaja, tase 7 kutse, peab kooli pidaja või pidaja volitusel kooli direktor moodustama §-s 7 nimetatud komisjoni hiljemalt 1. septembriks 2026. a.",
      "rdfs:label": {
        "@value": "Reg_1062909_Par_15 (redaktsioon 1062909)",
        "@language": "et"
      },
