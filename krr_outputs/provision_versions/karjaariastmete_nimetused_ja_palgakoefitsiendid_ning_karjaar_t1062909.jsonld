      "estleg:versionValidFrom": {
        "@value": "2026-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust kohaldatakse ka kutseõppeasutuse seaduse § 38 lõikes 6 nimetatud kutseõppeasutuste üldharidusainete õpetajate kutseoskuste arendamisele ja ametialase karjääri kujundamisele. Määrust kohaldatakse ka kutseõppeasutuse seaduse § 38 lõikes 6 nimetatud kutseõppeasutuste üldharidusainete õpetajate kutseoskuste arendamisele ja ametialase karjääri kujundamisele.",
      "rdfs:label": {
        "@value": "Reg_1062909_Par_2 (redaktsioon 1062909)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062909",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062909",
      "estleg:sourceAct": "Karjääriastmete nimetused ja palgakoefitsiendid ning karjääriastmete omistamise tingimused",
      "estleg:provisionRef": "Reg_1062909 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062909_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1062909_Par_3_v1062909",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
