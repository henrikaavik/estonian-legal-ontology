        "@type": "xsd:date"
      },
      "estleg:versionText": "Õpetajale omistatud aste säilib õpetaja tööle asumisel ühest koolist teise. Õpetajale omistatud aste säilib õpetaja tööle asumisel ühest koolist teise.",
      "rdfs:label": {
        "@value": "Reg_1062909_Par_11 (redaktsioon 1062909)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062909",
