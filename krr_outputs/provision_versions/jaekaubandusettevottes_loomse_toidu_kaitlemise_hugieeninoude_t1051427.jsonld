      "estleg:sourceAct": "Jaekaubandusettevõttes loomse toidu käitlemise hügieeninõuded",
      "estleg:provisionRef": "Reg_1051427 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1051427_Map"
      }
    },
    {
      "@id": "estleg:Reg_1051427_Par_3_v1051427",
      "@type": [
        "owl:NamedIndividual",
