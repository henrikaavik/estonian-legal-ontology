    {
      "@id": "estleg:Reg_1001113_Par_4_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kriminaalhooldusosakonna juhataja nimetatud kriminaalhooldusametnik koostab uurimisasutuse või prokuratuuri taotlusel ettekande, milles antakse arvamus sõltuvusravi kohaldamise võimalikkuse kohta, lähtudes kahtlustatava või süüdistatava isikust, tema elutingimustest ja majanduslikust seisukorrast. Kriminaalhooldusosakonna juhataja nimetatud kriminaalhooldusametnik koostab uurimisasutuse või prokuratuuri taotlusel ettekande, milles antakse arvamus sõltuvusravi kohaldamise võimalikkuse kohta, lähtudes kahtlustatava või süüdistatava isikust, tema elutingimustest ja majanduslikust seisukorrast. 2 (2) Sõltuvusravi võimalikkust hindav arvamus koostatakse „Kriminaalhooldusseaduse” §-s 24 sätestatud kohtueelse ettekande nõuetest lähtudes. Sõltuvusravi võimalikkust hindav arvamus koostatakse „Kriminaalhooldusseaduse” §-s 24 sätestatud kohtueelse ettekande nõuetest lähtudes. 3 (3) Kriminaalhooldusametnikul on arvamuse koostamiseks õigus vajaduse korral kohtuda sõltuvusravi kohaldamise kohta ekspertiisiakti koostanud kohtupsühhiaatriaeksperdiga. Kriminaalhooldusametnikul on arvamuse koostamiseks õigus vajaduse korral kohtuda sõltuvusravi kohaldamise kohta ekspertiisiakti koostanud kohtupsühhiaatriaeksperdiga.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_4 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_5_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kriminaalhooldusametnik peab arvamuse koostamise käigus selgitama kahtlustatavale või süüdistatavale sõltuvusravi eesmärki ning sellele allumise võimalusi ja tingimusi. Samuti peab kahtlustatavale või süüdistatavale selgitama, mida loetakse sõltuvusravile allumise kohustuse rikkumiseks ja millised on rikkumise tagajärjed. Kriminaalhooldusametnik peab arvamuse koostamise käigus selgitama kahtlustatavale või süüdistatavale sõltuvusravi eesmärki ning sellele allumise võimalusi ja tingimusi. Samuti peab kahtlustatavale või süüdistatavale selgitama, mida loetakse sõltuvusravile allumise kohustuse rikkumiseks ja millised on rikkumise tagajärjed. 2 (2) Kriminaalhooldusametnik võtab kahtlustatavalt või süüdistatavalt allkirja nõusoleku kohta alluda sõltuvusravile. Kriminaalhooldusametnik võtab kahtlustatavalt või süüdistatavalt allkirja nõusoleku kohta alluda sõltuvusravile.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_5 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_6_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kriminaalhooldusosakonna juhataja nimetab jõustunud kohtulahendi või prokuröri määruse saamisel kriminaalhooldusalusele kriminaalhooldusametniku. Kriminaalhooldusosakonna juhataja nimetab jõustunud kohtulahendi või prokuröri määruse saamisel kriminaalhooldusalusele kriminaalhooldusametniku. 2 (2) Võimaluse korral on selleks kriminaalhooldusametnik, kes andis arvamuse sõltuvusravi kohaldamise võimalikkuse kohta. Võimaluse korral on selleks kriminaalhooldusametnik, kes andis arvamuse sõltuvusravi kohaldamise võimalikkuse kohta.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_6 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 6",
