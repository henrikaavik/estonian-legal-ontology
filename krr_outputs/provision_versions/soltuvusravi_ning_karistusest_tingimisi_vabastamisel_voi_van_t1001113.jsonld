    {
      "@id": "estleg:Reg_1001113_Par_7_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõltuvusravi kohaldamise koha valikul peab kriminaalhooldusametnik võimalusel arvestama ekspertiisaktis väljendatud arvamust ja sõltuvusravi kohaldaja seisukohta sõltuvusravi kohaldamise koha osas. Sõltuvusravi kohaldamise koht valitakse võimalusel kriminaalhooldusaluse elukoha lähedal, et vältida ülemääraseid kulutusi sõltuvusravi kohale saabumise ja sealt lahkumisega. Sõltuvusravi kohaldamise koha valikul peab kriminaalhooldusametnik võimalusel arvestama ekspertiisaktis väljendatud arvamust ja sõltuvusravi kohaldaja seisukohta sõltuvusravi kohaldamise koha osas. Sõltuvusravi kohaldamise koht valitakse võimalusel kriminaalhooldusaluse elukoha lähedal, et vältida ülemääraseid kulutusi sõltuvusravi kohale saabumise ja sealt lahkumisega.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_7 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
