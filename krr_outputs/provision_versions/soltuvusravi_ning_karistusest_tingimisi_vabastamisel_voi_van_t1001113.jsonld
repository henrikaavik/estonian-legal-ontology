  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_soltuvusravi_ning_karistusest_tingimisi_vabastamisel_voi_van_t1001113_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord (27 versiooni)",
        "@language": "et"
      },
      "dc:source": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord"
    },
    {
      "@id": "estleg:Reg_1001113_Par_1_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määrusega sätestatakse: 1 1) sõltuvusravi kohaldamise ettevalmistamise kord; 2 2) sõltuvusravile allumise kohustuse täitmise ja järelevalve kord; 3 3) karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise kord ja 4 4) karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi täitmise ja järelevalve kord. Käesoleva määrusega sätestatakse: sõltuvusravi kohaldamise ettevalmistamise kord; sõltuvusravile allumise kohustuse täitmise ja järelevalve kord; karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise kord ja karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi täitmise ja järelevalve kord. 2 (2) Karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamisele, täitmisele ja järelevalvele kohaldatakse käesolevas määruses sõltuvusravi kohaldamisele ettenähtud korda 3. peatükis sätestatud erisustega. Karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamisele, täitmisele ja järelevalvele kohaldatakse käesolevas määruses sõltuvusravi kohaldamisele ettenähtud korda 3. peatükis sätestatud erisustega.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_1 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_10_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Esimesel kohtumisel peab kriminaalhooldusametnik: 1 1) veenduma, et kriminaalhooldusalune on jätkuvalt nõus sõltuvusravile alluma; 2 2) selgitama kriminaalhooldusalusele sõltuvusravi eesmärki ja tingimusi; 3 3) vajadusel tutvustama kriminaalhooldusalusele võimalikke sõltuvusravi kohaldamise kohti; RT I 2024-05-10 3 110052024003 2024-05-13 4 4) kuulama ära kriminaalhooldusaluse arvamuse sõltuvusravi koha valiku osas; 5 5) selgitama kriminaalhooldusalusele tema õigusi ja kohustusi sõltuvusravile allumisel; RT I 2024-05-10 3 110052024003 2024-05-13 6 6) selgitama sõltuvusravile allumist takistavatest asjaoludest teavitamise korda; 7 7) tegema kriminaalhooldusalusele teatavaks sõltuvusravist kõrvalehoidmise tagajärjed; 8 8) selgitama kriminaalhooldusalusele, mida temalt oodatakse kontrollnõuete ja talle pandud kohustuste täitmisel; 9 9) tegema kriminaalhooldusalusele teatavaks kohustuste ja kontrollnõuete täitmata jätmise tagajärjed. Esimesel kohtumisel peab kriminaalhooldusametnik: veenduma, et kriminaalhooldusalune on jätkuvalt nõus sõltuvusravile alluma; selgitama kriminaalhooldusalusele sõltuvusravi eesmärki ja tingimusi; vajadusel tutvustama kriminaalhooldusalusele võimalikke sõltuvusravi kohaldamise kohti; kuulama ära kriminaalhooldusaluse arvamuse sõltuvusravi koha valiku osas; selgitama kriminaalhooldusalusele tema õigusi ja kohustusi sõltuvusravile allumisel; selgitama sõltuvusravile allumist takistavatest asjaoludest teavitamise korda; tegema kriminaalhooldusalusele teatavaks sõltuvusravist kõrvalehoidmise tagajärjed; selgitama kriminaalhooldusalusele, mida temalt oodatakse kontrollnõuete ja talle pandud kohustuste täitmisel; tegema kriminaalhooldusalusele teatavaks kohustuste ja kontrollnõuete täitmata jätmise tagajärjed.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_10 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
