    {
      "@id": "estleg:Reg_1001113_Par_12_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kriminaalhooldusalune teeb pärast sõltuvusravi kohaldajaga sõltuvusravi esmase vastuvõtu koha ja aja kokkuleppimist need viivitamata teatavaks kriminaalhooldusametnikule. Kriminaalhooldusalune teeb pärast sõltuvusravi kohaldajaga sõltuvusravi esmase vastuvõtu koha ja aja kokkuleppimist need viivitamata teatavaks kriminaalhooldusametnikule. 2 (2) Hoolduskava muudetakse ja kinnitatakse vajaduse järgi, arvestades sõltuvusravi üldist tähtaega ja liiki. RT I 2024-05-10 3 110052024003 2024-05-13 Hoolduskava muudetakse ja kinnitatakse vajaduse järgi, arvestades sõltuvusravi üldist tähtaega ja liiki.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_12 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
