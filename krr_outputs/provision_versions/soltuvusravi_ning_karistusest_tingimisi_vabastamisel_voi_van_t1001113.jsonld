    },
    {
      "@id": "estleg:Reg_1001113_Par_14_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõltuvusravile allutud kuude arvestust peab kriminaalhooldaja. Raviaja arvestust peetakse kriminaalhooldusosakonna esitatud vormi kohaselt. RT I 2024-05-10 3 110052024003 2024-05-13 Sõltuvusravile allutud kuude arvestust peab kriminaalhooldaja. Raviaja arvestust peetakse kriminaalhooldusosakonna esitatud vormi kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_14 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_15_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui sõltuvusravi kohaldamiseks on vajalik kriminaalhooldusaluse paigutamine statsionaarset raviteenust pakkuva sõltuvusravi kohaldaja juurde, selgitab kriminaalhooldusametnik kriminaalhooldusalusele, et statsionaarsel ravil viibimise ajal ei pea kriminaalhooldusalune käima kriminaalhooldusosakonnas registreerimisel. Kui sõltuvusravi kohaldamiseks on vajalik kriminaalhooldusaluse paigutamine statsionaarset raviteenust pakkuva sõltuvusravi kohaldaja juurde, selgitab kriminaalhooldusametnik kriminaalhooldusalusele, et statsionaarsel ravil viibimise ajal ei pea kriminaalhooldusalune käima kriminaalhooldusosakonnas registreerimisel. 2 (2) Välistamaks võimalust sõltuvusravist kõrvale hoiduda, käib kriminaalhooldusametnik sõltuvusravi kohaldamise kohas kriminaalhooldusalusega kohtumas või suhtleb tervishoiutöötajaga, kui ravi iseloomu tõttu on kriminaalhooldusalusega vahetu kohtumine välistatud. Välistamaks võimalust sõltuvusravist kõrvale hoiduda, käib kriminaalhooldusametnik sõltuvusravi kohaldamise kohas kriminaalhooldusalusega kohtumas või suhtleb tervishoiutöötajaga, kui ravi iseloomu tõttu on kriminaalhooldusalusega vahetu kohtumine välistatud. 3 (3) Statsionaarse ravi asendamisel ambulatoorse raviga tuleb kohe muuta registreerimise kohustus kriminaalhooldusosakonna põhiseks. Statsionaarse ravi asendamisel ambulatoorse raviga tuleb kohe muuta registreerimise kohustus kriminaalhooldusosakonna põhiseks.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_15 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_16_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõltuvusravile allutatu omavoliline lahkumine statsionaarset sõltuvusravi teenust pakkuva sõltuvusravi kohaldaja juurest on keelatud. Kõikidest raviteenuse osutamisega seotud liikumistest, mis eeldavad sõltuvusravile allutatu ajutist lahkumist sõltuvusravi osutamise kohast, tuleb viivitamata teavitada kriminaalhooldajat. Sõltuvusravile allutatu omavoliline lahkumine statsionaarset sõltuvusravi teenust pakkuva sõltuvusravi kohaldaja juurest on keelatud. Kõikidest raviteenuse osutamisega seotud liikumistest, mis eeldavad sõltuvusravile allutatu ajutist lahkumist sõltuvusravi osutamise kohast, tuleb viivitamata teavitada kriminaalhooldajat.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_16 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_17_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kriminaalhooldusaluse sõltuvusravile allumist kontrollib vahetult sõltuvusravi kohaldaja, kes peab kriminaalhooldusametniku nõudmisel andma igakülgset teavet kriminaalhooldusaluse käitumise kohta sõltuvusravile allumisel. Kriminaalhooldusaluse sõltuvusravile allumist kontrollib vahetult sõltuvusravi kohaldaja, kes peab kriminaalhooldusametniku nõudmisel andma igakülgset teavet kriminaalhooldusaluse käitumise kohta sõltuvusravile allumisel. 2 (2) Kui kriminaalhooldusalune ei ilmu õigel ajal sõltuvusravi kohta, ei allu sõltuvusravi kohaldaja töötaja korraldustele või rikub muid tingimusi, teatab sõltuvusravi kohaldaja sellest viivitamata kriminaalhooldusametnikule. Kriminaalhooldusametniku taotlusel vormistab sõltuvusravi kohaldaja teavituse kirjalikult. RT I 2024-05-10 3 110052024003 2024-05-13 Kui kriminaalhooldusalune ei ilmu õigel ajal sõltuvusravi kohta, ei allu sõltuvusravi kohaldaja töötaja korraldustele või rikub muid tingimusi, teatab sõltuvusravi kohaldaja sellest viivitamata kriminaalhooldusametnikule. Kriminaalhooldusametniku taotlusel vormistab sõltuvusravi kohaldaja teavituse kirjalikult. 3 (3) Kehtetu - RT I 2024-05-10 3 110052024003 2024-05-13 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_17 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_18_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kriminaalhooldusametnik, kelle järelevalve alla on määratud sõltuvusravile allumise kohustusega kriminaalhooldusalune, võib kontrollida sõltuvusravile allumise kohustuse täitmist igal ajal, kooskõlastades oma kontrollkäigu sõltuvusravi kohaldajaga. Kriminaalhooldusametnik, kelle järelevalve alla on määratud sõltuvusravile allumise kohustusega kriminaalhooldusalune, võib kontrollida sõltuvusravile allumise kohustuse täitmist igal ajal, kooskõlastades oma kontrollkäigu sõltuvusravi kohaldajaga. 2 (2) Kriminaalhooldusametnikul on õigus sõltuvusravile allumise kohustuse täitmise kontrollimiseks igal ajal külastada statsionaarsel sõltuvusravil viibivat kriminaalhooldusalust või sõltuvusravi kohaldajale helistada. Kontrollkülastusest ei teatata kriminaalhooldusalusele ette. Kriminaalhooldusametnikul on õigus sõltuvusravile allumise kohustuse täitmise kontrollimiseks igal ajal külastada statsionaarsel sõltuvusravil viibivat kriminaalhooldusalust või sõltuvusravi kohaldajale helistada. Kontrollkülastusest ei teatata kriminaalhooldusalusele ette.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_18 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_19_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sõltuvusravi kohaldaja võib nõuda kriminaalhooldusaluse lahkumist sõltuvusravi kohaldamise kohast ajutiselt, kui: 1 1) kriminaalhooldusalune ilmub sõltuvusravi kohaldamise kohta alkoholi- või narkojoobes; 2 2) kriminaalhooldusaluse käitumine ohustab või võib ohustada sõltuvusravi kohaldaja töötajaid või tema vara, kõrvalisi isikuid või kriminaalhooldusalust ennast. RT I 2024-05-10 3 110052024003 2024-05-13 Sõltuvusravi kohaldaja võib nõuda kriminaalhooldusaluse lahkumist sõltuvusravi kohaldamise kohast ajutiselt, kui: kriminaalhooldusalune ilmub sõltuvusravi kohaldamise kohta alkoholi- või narkojoobes; kriminaalhooldusaluse käitumine ohustab või võib ohustada sõltuvusravi kohaldaja töötajaid või tema vara, kõrvalisi isikuid või kriminaalhooldusalust ennast. 2 (2) Kui ilmnevad asjaolud, mis tingivad vajaduse sõltuvusravi kohaldajal nõuda kriminaalhooldusaluse lahkumist sõltuvusravi kohaldamise kohast ajutiselt, teavitab sõltuvusravi kohaldaja sellest viivitamatult kriminaalhooldusametnikku. RT I 2024-05-10 3 110052024003 2024-05-13 Kui ilmnevad asjaolud, mis tingivad vajaduse sõltuvusravi kohaldajal nõuda kriminaalhooldusaluse lahkumist sõltuvusravi kohaldamise kohast ajutiselt, teavitab sõltuvusravi kohaldaja sellest viivitamatult kriminaalhooldusametnikku.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_19 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_2_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusosakonna pädevuses on: 1 1) sõltuvusravi kohaldamise võimalikkuse kohta arvamuse koostamine; 2 2) sõltuvusravile allumise kohustuse täitmise üle järelevalve teostamine. Kriminaalhooldusosakonna pädevuses on: sõltuvusravi kohaldamise võimalikkuse kohta arvamuse koostamine; sõltuvusravile allumise kohustuse täitmise üle järelevalve teostamine.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_2 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_20_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sõltuvusravile allumise kohustuse jäme rikkumine on: 1 1) omavoliline lahkumine sõltuvusravi kohaldamise kohast; 2 2) alkoholi- või narkootikumi tarvitamine; 3 3) ilmumine sõltuvusravi kohaldamise kohta alkoholi- või narkojoobes; 4 4) sõltuvusravi kohaldaja töötajate või tema vara, kõrvaliste isikute või kriminaalhooldusaluse enda ohustamine. Sõltuvusravile allumise kohustuse jäme rikkumine on: omavoliline lahkumine sõltuvusravi kohaldamise kohast; alkoholi- või narkootikumi tarvitamine; ilmumine sõltuvusravi kohaldamise kohta alkoholi- või narkojoobes; sõltuvusravi kohaldaja töötajate või tema vara, kõrvaliste isikute või kriminaalhooldusaluse enda ohustamine. 2 (2) Sõltuvusravile allumise kohustuse rikkumiseks loetakse sõltuvusravi kohaldamise kohale mitteõigeaegne ilmumine, samuti ajakavast kõrvalekaldumine. Sõltuvusravile allumise kohustuse rikkumiseks loetakse sõltuvusravi kohaldamise kohale mitteõigeaegne ilmumine, samuti ajakavast kõrvalekaldumine. 3 (3) Sõltuvusravile allumise kohustuse rikkumiseks ei loeta juhtumeid, kus kriminaalhooldusalune teavitab hilinemisest kriminaalhooldusametnikku ja kriminaalhooldusametnik nõustub hilinemise põhjusega. Sõltuvusravile allumise kohustuse rikkumiseks ei loeta juhtumeid, kus kriminaalhooldusalune teavitab hilinemisest kriminaalhooldusametnikku ja kriminaalhooldusametnik nõustub hilinemise põhjusega.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_20 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_21_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui kriminaalhooldusalune hoiab sõltuvusravist kõrvale või esinevad §-s 20 nimetatud asjaolud, fikseerib kriminaalhooldusametnik rikkumised, võtab kriminaalhooldusaluselt rikkumise kohta allkirjastatud seletuse ning reageerib rikkumisele. Kriminaalhooldusametnik reageerib rikkumisele hoiatusega või erakorralise ettekandega. RT I 2024-05-10 3 110052024003 2024-05-13 Kui kriminaalhooldusalune hoiab sõltuvusravist kõrvale või esinevad §-s 20 nimetatud asjaolud, fikseerib kriminaalhooldusametnik rikkumised, võtab kriminaalhooldusaluselt rikkumise kohta allkirjastatud seletuse ning reageerib rikkumisele. Kriminaalhooldusametnik reageerib rikkumisele hoiatusega või erakorralise ettekandega. 1 (1¹) Rikkumise fikseerimisel märgitakse järgmised andmed: 1 1) sõltuvusravile allutatud isiku nimi; 2 2) rikkumise fikseerinud kriminaalhooldusametniku nimi; 3 3) rikkumise aeg ja kirjeldus; 4 4) kriminaalhooldusametniku otsus; 5 5) rikkumise fikseerimise kuupäev. RT I 2024-05-10 3 110052024003 2024-05-13 Rikkumise fikseerimisel märgitakse järgmised andmed: sõltuvusravile allutatud isiku nimi; rikkumise fikseerinud kriminaalhooldusametniku nimi; rikkumise aeg ja kirjeldus; kriminaalhooldusametniku otsus; rikkumise fikseerimise kuupäev. 1 (1²) Kirjalikus hoiatuses märgitakse: 1 1) sõltuvusravile allutatud isiku nimi; 2 2) hoiatuse teinud kriminaalhooldusametniku nimi; 3 3) rikkumise aeg ja kirjeldus; 4 4) kriminaalhooldusametniku otsus; 5 5) hoiatuse koostamise kuupäev. RT I 2024-05-10 3 110052024003 2024-05-13 Kirjalikus hoiatuses märgitakse: sõltuvusravile allutatud isiku nimi; hoiatuse teinud kriminaalhooldusametniku nimi; rikkumise aeg ja kirjeldus; kriminaalhooldusametniku otsus; hoiatuse koostamise kuupäev. 1 (1³) Kriminaalhooldusametnik tutvustab hoiatust sõltuvusravile allutatud isikule. RT I 2024-05-10 3 110052024003 2024-05-13 Kriminaalhooldusametnik tutvustab hoiatust sõltuvusravile allutatud isikule. 2 (2) Enne erakorralise ettekande tegemist võib kriminaalhooldusametnik teha kuni kaks kehtivat kirjalikku hoiatust. Käesoleva määruse § 20 lõikes 1 loetletud jämeda rikkumise korral on kriminaalhooldusametnik kohustatud koostama erakorralise ettekande, olenemata varasematest rikkumistest või eelnevate hoiatuste tegemise arvust. RT I 2024-05-10 3 110052024003 2024-05-13 Enne erakorralise ettekande tegemist võib kriminaalhooldusametnik teha kuni kaks kehtivat kirjalikku hoiatust. Käesoleva määruse § 20 lõikes 1 loetletud jämeda rikkumise korral on kriminaalhooldusametnik kohustatud koostama erakorralise ettekande, olenemata varasematest rikkumistest või eelnevate hoiatuste tegemise arvust. 3 (3) Erakorraline ettekanne koostatakse ja esitatakse kohtule või prokuratuurile „Kriminaalhooldusseaduse” § 31 lõikes 22 sätestatud erakorralise ettekande nõuetest lähtudes. Erakorraline ettekanne koostatakse ja esitatakse kohtule või prokuratuurile „Kriminaalhooldusseaduse” § 31 lõikes 22 sätestatud erakorralise ettekande nõuetest lähtudes.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_21 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_22_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui sõltuvusravile allumine ei ole kohtu või prokuratuuri määratud tähtaja jooksul võimalik kriminaalhooldusaluse haiguse või perekondliku olukorra tõttu, taotleb kriminaalhooldusametnik sõltuvusravi tähtaja kulgemise peatamist. Kui sõltuvusravile allumine ei ole kohtu või prokuratuuri määratud tähtaja jooksul võimalik kriminaalhooldusaluse haiguse või perekondliku olukorra tõttu, taotleb kriminaalhooldusametnik sõltuvusravi tähtaja kulgemise peatamist. 2 (2) Kriminaalhooldusametnik koostab käesoleva paragrahvi lõikes 1 nimetatud juhul kohtule või prokuratuurile erakorralise ettekande „Kriminaalhooldusseaduse” § 31 lõikes 5 sätestatud erakorralise ettekande nõuetest lähtudes. Kriminaalhooldusametnik koostab käesoleva paragrahvi lõikes 1 nimetatud juhul kohtule või prokuratuurile erakorralise ettekande „Kriminaalhooldusseaduse” § 31 lõikes 5 sätestatud erakorralise ettekande nõuetest lähtudes.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_22 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_23_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusosakond peab sõltuvusravile allumise kohta käitumiskontrolli toimikut digitaalselt ja paberil (dokumenditoimik) justiitsministri poolt kehtestatud kinnipeetavate, vahistatute, arestialuste ja kriminaalhooldusaluste registri põhimääruse kohaselt. RT I 2024-05-10 3 110052024003 2024-05-13 Kriminaalhooldusosakond peab sõltuvusravile allumise kohta käitumiskontrolli toimikut digitaalselt ja paberil (dokumenditoimik) justiitsministri poolt kehtestatud kinnipeetavate, vahistatute, arestialuste ja kriminaalhooldusaluste registri põhimääruse kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_23 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_24_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohus või prokuratuur nõuab kriminaalhoolduse lõppemise kohta ettekannet, edastab selle kriminaalhooldusosakond ja see koostatakse „Kriminaalhooldusseaduse” §-s 301 sätestatud nõuetest lähtudes. RT I 2024-05-10 3 110052024003 2024-05-13 Kui kohus või prokuratuur nõuab kriminaalhoolduse lõppemise kohta ettekannet, edastab selle kriminaalhooldusosakond ja see koostatakse „Kriminaalhooldusseaduse” §-s 301 sätestatud nõuetest lähtudes.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_24 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_25_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamisele, täitmisele ja järelevalvele kohaldatakse käesolevas määruses sõltuvusravi kohaldamisele ettenähtud korda käesolevast peatükist tulenevate erisustega. Karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamisele, täitmisele ja järelevalvele kohaldatakse käesolevas määruses sõltuvusravi kohaldamisele ettenähtud korda käesolevast peatükist tulenevate erisustega.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_25 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_26_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohus peab vajalikuks süüdimõistetule määrata karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohustus alluda narkomaania ravile ja peab vajalikuks kriminaalhooldaja arvamust, lähtub kriminaalhooldaja arvamuse esitamisel käesoleva määruse §-st 4. Kui kohus peab vajalikuks süüdimõistetule määrata karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohustus alluda narkomaania ravile ja peab vajalikuks kriminaalhooldaja arvamust, lähtub kriminaalhooldaja arvamuse esitamisel käesoleva määruse §-st 4.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_26 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_27_v1001113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001113_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi puhul ei pea teavitama Sotsiaalministeeriumi. Karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi puhul ei pea teavitama Sotsiaalministeeriumi.",
      "rdfs:label": {
        "@value": "Reg_1001113_Par_27 (redaktsioon 1001113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001113",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001113",
      "estleg:sourceAct": "Sõltuvusravi ning karistusest tingimisi vabastamisel või vangistusest tingimisi ennetähtaegsel vabastamisel kohaldatava narkomaania ravi ettevalmistamise ning täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1001113 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001113_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001113_Par_3_v1001113",
