      "estleg:provisionRef": "Reg_311074 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_311074_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_311074_Par_24_v311074",
      "@type": [
        "owl:NamedIndividual",
