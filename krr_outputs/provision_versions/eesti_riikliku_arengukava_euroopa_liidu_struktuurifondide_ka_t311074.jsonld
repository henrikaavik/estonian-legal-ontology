    {
      "@id": "estleg:Reg_311074_Par_11_v311074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_311074_Par_11"
