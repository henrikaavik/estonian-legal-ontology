      "estleg:versionOf": {
        "@id": "estleg:Reg_311074_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtasutus on kohustatud säilitama taotluste ja projektide teostamisega seotud dokumentatsiooni vähemalt 2018. aasta 30. juunini. Sihtasutus on kohustatud säilitama taotluste ja projektide teostamisega seotud dokumentatsiooni vähemalt 2018. aasta 30. juunini. Määruse lisa on avaldatud elektroonilises Riigi Teatajas. Alus: «Riigi Teataja seaduse» § 4 lõige 2 ja riigisekretäri 29.06.2005. a resolutsioon nr 17-1/0505738. Määruse lisa on avaldatud elektroonilises Riigi Teatajas. Alus: «Riigi Teataja seaduse» § 4 lõige 2 ja riigisekretäri 29.06.2005. a resolutsioon nr 17-1/0505738.",
      "rdfs:label": {
        "@value": "Reg_311074_Par_24 (redaktsioon 311074)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "311074",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/311074",
      "estleg:sourceAct": "“Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument aastateks 2004–2006” meetme number 2.3 “Teadus- ja arendustegevuse ning innovatsiooni edendamine” osa “Teadus- ja tehnoloogiaparkide investeeringute toetamise programm” tingimused",
      "estleg:provisionRef": "Reg_311074 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_311074_Map_2026"
      }
