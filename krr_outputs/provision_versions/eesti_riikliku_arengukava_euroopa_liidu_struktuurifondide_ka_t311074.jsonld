      "estleg:provisionRef": "Reg_311074 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_311074_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_311074_Par_12_v311074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
