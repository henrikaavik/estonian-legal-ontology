    {
      "@id": "estleg:Reg_1027830_Par_10_v1027830",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027830_Par_10"
