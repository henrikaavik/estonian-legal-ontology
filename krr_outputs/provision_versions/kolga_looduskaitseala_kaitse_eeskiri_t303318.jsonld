    {
      "@id": "estleg:Reg_303318_Par_4_v303318",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303318_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. Sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. 2 (2) Kaitsealal on kaks sihtkaitsevööndit: 1 1) Kolga sihtkaitsevöönd; 2 2) Saulepi sihtkaitsevöönd. Kaitsealal on kaks sihtkaitsevööndit: Kolga sihtkaitsevöönd; Saulepi sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_303318_Par_4 (redaktsioon 303318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303318",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303318",
      "estleg:sourceAct": "Kolga looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_303318 § 4",
