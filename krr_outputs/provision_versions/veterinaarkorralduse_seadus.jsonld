        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitus lõpeb: volitusest loobumise korral; volituse tähtaja möödumisega; volitatu surma korral; volituse kehtetuks tunnistamise korral; veterinaararsti tegevusloast loobumise korral; veterinaararsti tegevusloa tähtaja lõppemise korral; veterinaararsti tegevusloa kehtetuks tunnistamise korral.",
      "rdfs:label": {
        "@value": "VetKS_Par_14 (redaktsioon 22453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22453",
      "estleg:supersededByVersion": {
