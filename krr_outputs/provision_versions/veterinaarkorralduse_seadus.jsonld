      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haldusjärelevalvet volitatud veterinaararsti tegevuse üle teostab Põllumajandus- ja Toiduamet. (2) Volitatud veterinaararst esitab aruanded Põllumajandus- ja Toiduametile. (3) Nõuded volitatud veterinaararsti poolt esitatavale aruandlusele ja aruannete esitamise kord kehtestatakse Põllumajandus- ja Toiduameti peadirektori käskkirjaga.",
      "rdfs:label": {
        "@value": "VetKS_Par_17 (redaktsioon 101072020037)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101072020037",
