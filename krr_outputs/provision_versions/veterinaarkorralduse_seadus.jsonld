      }
    },
    {
      "@id": "estleg:VetKS_Par_31_v1040619",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa taotleja esitab tegevusloa andjale: avalduse tegevusloa saamiseks; kasutatavate analüüsimetoodikate loetelu ja kirjelduse. kehtetu – (2) Enne taotluse esitamist peab tegevusloa taotleja tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "VetKS_Par_31 (redaktsioon 1040619)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040619",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040619",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 31",
      "estleg:partOfAct": {
