      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veterinaararst (loomaarst) on isik, kellel on veterinaarmeditsiinialane akadeemiline kõrgharidus. (2) Veterinaartehnik (veterinaarvelsker) on isik, kellel on veterinaaria õppekava alusel omandatud kutsekeskharidus.",
      "rdfs:label": {
        "@value": "VetKS_Par_3 (redaktsioon 22453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22453",
