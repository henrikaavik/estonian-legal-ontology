        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014107",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
      "@id": "estleg:VetKS_Par_11_v104122019031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitatud veterinaararsti õiguste taotlejal peab olema kehtiv kutsetegevuse luba ning ta peab vastama Euroopa Parlamendi ja nõukogu määruse (EL) 2017/625 artikli 30 punktis b sätestatud tingimustele.",
      "rdfs:label": {
        "@value": "VetKS_Par_11 (redaktsioon 104122019031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122019031",
