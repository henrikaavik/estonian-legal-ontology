      }
    },
    {
      "@id": "estleg:VetKS_Par_7_v102032011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalveametnikul on õigus: kontrollida järelevalveobjekte ja võtta järelevalve teostamiseks tasuta proove; omada juurdepääsu järelevalveks vajalikule informatsioonile ja dokumentatsioonile ning nõuda viimastest koopiaid; väljastada veterinaartõendeid ja koostada akte; kasutada järelevalve teostamisel tehnilisi vahendeid ning käesoleva seaduse § 5 lõikes 5 nimetatud laboratooriumide teenuseid; keelata veterinaarnõuetele mittevastavate loomadega kauplemine ning selliste loomade karjatamine, ühest karjast teise või loomsete saaduste käitlemise ettevõttesse viimine; keelata veterinaarnõuetele mittevastavate loomsete saaduste käitlemine; peatada osaliselt või täielikult tegevus ettevõttes, kus on rikutud veterinaarnõudeid, teha ettekirjutus järelevalve teostamise käigus avastatud õigusrikkumise lõpetamiseks ja selleks vajalike toimingute tegemiseks, määrates õigusrikkumise lõpetamise tähtaja; veterinaarnõuete jätkuva või korduva eiramise korral teha kohaliku omavalitsuse üksusele ettepanek tunnistada kehtetuks veterinaarnõuetele mittevastava loomakasvatushoone või -rajatise või loomseid saadusi käitleva ettevõtte ehitise kasutusluba. kehtetu - kehtetu - (2) Isiku taotlusel annab järelevalveametnik nõusoleku jätkata käesoleva paragrahvi lõike 1 punktides 5–7 nimetatud tegevusi, kui nende peatamise tinginud asjaolud on kõrvaldatud.",
      "rdfs:label": {
        "@value": "VetKS_Par_7 (redaktsioon 102032011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102032011002",
      "estleg:supersededByVersion": {
        "@id": "estleg:VetKS_Par_7_v129062014107"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102032011002",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
      "@id": "estleg:VetKS_Par_7_v129062014107",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veterinaar- ja Toiduamet võib käesolevas seaduses sätestatud veterinaarjärelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 49, 50 ja 51 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "VetKS_Par_7 (redaktsioon 129062014107)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014107",
      "estleg:supersededByVersion": {
        "@id": "estleg:VetKS_Par_7_v104122019031"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014107",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
      "@id": "estleg:VetKS_Par_7_v104122019031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veterinaar- ja Toiduamet võib käesolevas seaduses sätestatud veterinaarjärelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 49, 50 ja 51 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras. (2) Veterinaarnõuetele mittevastavate loomade või loomsete saaduste avastamise korral kohaldab korrakaitseorgan Euroopa Parlamendi ja nõukogu määruse (EL) 2017/625 artiklis 138 sätestatud meetmeid. (3) Veterinaarnõuetele mittevastavate loomade või loomsete saaduste Euroopa Liidu välisest riigist Eestisse Euroopa Parlamendi ja nõukogu määruse (EL) 2017/625 artikli 3 punktis 40 sätestatud tähenduses toimetamise korral (edaspidi Eestisse toimetamine) kohaldab korrakaitseorgan nimetatud määruse artiklites 66–69 sätestatud meetmeid.",
      "rdfs:label": {
        "@value": "VetKS_Par_7 (redaktsioon 104122019031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122019031",
      "estleg:supersededByVersion": {
        "@id": "estleg:VetKS_Par_7_v101072020037"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104122019031",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
      "@id": "estleg:VetKS_Par_7_v101072020037",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
