        "@value": "2009-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12902301",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
      "@id": "estleg:VetKS_Par_5_v13196690",
