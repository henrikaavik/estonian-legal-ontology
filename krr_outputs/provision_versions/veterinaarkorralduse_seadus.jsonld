        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104122019031",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 16",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
