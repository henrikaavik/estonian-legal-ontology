      },
      "estleg:versionText": "Volitatud veterinaararsti õiguse saamiseks esitab taotleja konkursi kuulutuses nimetatud tähtajaks: avalduse volituse saamiseks; andmed kehtiva kutsetegevuse loa kohta ja kutsealase töökäigu kirjelduse. kehtetu -",
      "rdfs:label": {
        "@value": "VetKS_Par_12 (redaktsioon 113032019191)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019191",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019191",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
