      "estleg:provisionRef": "VetKS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
      "@id": "estleg:VetKS_Par_11_v22453",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitatud veterinaararsti õiguste taotleja peab: omama kehtivat veterinaararsti tegevusluba; omama volitusega seotud ülesannete täitmiseks vajalikku ettevalmistust ja tehnilist varustust; olema võimeline tegutsema erapooletult ja andma tegelikule olukorrale vastavaid hinnanguid.",
      "rdfs:label": {
        "@value": "VetKS_Par_11 (redaktsioon 22453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22453",
      "estleg:supersededByVersion": {
        "@id": "estleg:VetKS_Par_11_v129062014107"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22453",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
      "@id": "estleg:VetKS_Par_11_v129062014107",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitatud veterinaararsti õiguste taotleja peab: omama kehtivat kutsetegevuse luba; omama volitusega seotud ülesannete täitmiseks vajalikku ettevalmistust ja tehnilist varustust; olema võimeline tegutsema erapooletult ja andma tegelikule olukorrale vastavaid hinnanguid.",
      "rdfs:label": {
