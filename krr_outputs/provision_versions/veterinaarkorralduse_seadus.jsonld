    {
      "@id": "estleg:VetKS_Par_4_v129062014107",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veterinaarjärelevalvet ja veterinaarkontrolli teostatakse järgmiste järelevalveobjektide üle: loomataudi, sealhulgas zoonoosse haigusetekitaja diagnoosimine ja tõrje ning selle leviku ennetamine; looma tervis ja heaolu; looma pidamine, identifitseerimine, riigisisene liikumine ja avalik näitamine; loomne saadus ja selle käitlemine; loomset päritolu sööt ja selle käitlemine; ravimsööt ja selle käitlemine; looma, loomse saaduse, loomset päritolu sööda, heina, põhu ning ravimsööda import ja eksport; veterinaarravimi ning ravimsööda kasutamine ja selle üle arvestuse pidamine; veterinaarpraksis.",
      "rdfs:label": {
        "@value": "VetKS_Par_4 (redaktsioon 129062014107)",
        "@language": "et"
      },
