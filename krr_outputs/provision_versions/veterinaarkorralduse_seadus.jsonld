    {
      "@id": "estleg:VetKS_Par_7_v22453",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalveametnikul on õigus: kontrollida järelevalveobjekte ja võtta järelevalve teostamiseks tasuta proove; omada juurdepääsu järelevalveks vajalikule informatsioonile ja dokumentatsioonile ning nõuda viimastest koopiaid; väljastada veterinaartõendeid ja koostada akte; kasutada järelevalve teostamisel tehnilisi vahendeid ning käesoleva seaduse § 5 lõikes 5 nimetatud laboratooriumide teenuseid; keelata veterinaarnõuetele mittevastavate loomadega kauplemine ning selliste loomade karjatamine, ühest karjast teise või loomseid saadusi käitlevasse ettevõttesse viimine; keelata loomsete saaduste hügieeninõuetele mittevastavate loomsete saaduste käitlemine; peatada loomatervishoiu-, loomsete saaduste hügieeni- ja loomakaitsenõudeid rikkunud ettevõtte tegevus osaliselt või täielikult, teha ettekirjutusi järelevalve teostamise käigus avastatud puuduste kõrvaldamiseks, määrates puuduste kõrvaldamise tähtaja ning nimetatud tähtajaks puuduste kõrvaldamata jätmisel ning loomatervishoiu-, loomsete saaduste hügieeni- ja loomakaitsenõuete pideva eiramise korral teha kohtule ettevõtte sundlõpetamise ettepanek; teha kohalikule omavalitsusele ettepanek loomatervishoiu-, loomsete saaduste hügieeni- ja loomakaitsenõuetele mittevastava loomakasvatushoone ja -rajatise või loomseid saadusi töötleva objekti ehitusloa peatamiseks või tühistamiseks; suunata loom nakkushaiguse kahtluse korral diagnostilisele tapmisele seadusega ettenähtud korras; määrata halduskaristusi seadusega ettenähtud juhtudel ja korras.",
      "rdfs:label": {
        "@value": "VetKS_Par_7 (redaktsioon 22453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22453",
      "estleg:supersededByVersion": {
        "@id": "estleg:VetKS_Par_7_v225200"
      },
