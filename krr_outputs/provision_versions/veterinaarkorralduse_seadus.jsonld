    {
      "@id": "estleg:VetKS_Par_23_v129062014107",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veterinaararstil on õigus: tegeleda iseseisvalt veterinaarpraksisega füüsilisest isikust ettevõtjana või ettevõtja kaudu, kellega tal on lepinguline suhe; välja kirjutada ja väljastada ravimeid loomade raviks; anda oma pädevuse piires välja tõendeid loomade tervise ja loomsete saaduste seisundi kohta; kasutada oma kutsetegevuse loa numbriga pitsatit. (2) Veterinaararst on kohustatud: pidama kinni veterinaararsti kutse-eetikast ja järgima head veterinaarset tava; täiendama ennast erialaselt vähemalt üks kord viie kalendriaasta jooksul; esitama Veterinaar- ja Toiduameti kohalikule asutusele, mille järelevalvealasel territooriumil ta tegutseb, veterinaariaalastes õigusaktides kehtestatud korras nõutavaid veterinaariaalaseid aruandeid ja täitma nimetatud asutuse veterinaartegevusealaseid ettekirjutusi; pidama arvestust teostatud ravi- ja muude menetluste ning surmajuhtumite kohta ja säilitama nimetatud andmeid kolm aastat; lisama oma allkirjale enda ametinimetuse ja käesoleva paragrahvi lõike 1 punktis 4 nimetatud pitsati jäljendi; teatama registrile ajakohased andmed. (3) Ajakohased andmed esitatakse 30 päeva jooksul andmete muutumisest arvates. Andmed erialase täiendamise kohta esitatakse veterinaararsti kvalifikatsiooni omandamise aastale järgnenud viie kalendriaasta möödumisest alates iga viieaastase ajavahemiku kohta sellele järgneva aasta 31. jaanuariks.",
      "rdfs:label": {
        "@value": "VetKS_Par_23 (redaktsioon 129062014107)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014107",
      "estleg:supersededByVersion": {
        "@id": "estleg:VetKS_Par_23_v104072017075"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014107",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
