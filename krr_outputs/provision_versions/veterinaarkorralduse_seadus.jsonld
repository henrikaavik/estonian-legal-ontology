    {
      "@id": "estleg:VetKS_Par_4_v22453",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riikliku veterinaarjärelevalve põhiülesanneteks on: järelevalve käesoleva seaduse ja teiste veterinaariaalaste õigusaktide nõuete täitmise üle; loomataudide diagnostika, ennetamise ja tõrje korraldamine ning järelevalve loomade tervise ja loomakaitsenõuete täitmise üle; inimeste tervise kaitsmine inimestele ja loomadele ühiste haiguste eest ja nende haiguste tõrje loomadel; [Punkti 4 sõnastus kuni 30.06.2002] laboratoorse uurimise korraldamine loomahaiguste diagnoosimiseks ja loomsete saaduste, loomasööda ning joogivee ohutuse hindamiseks; [Punkti 4 sõnastus alates 01.07.2002] laboratoorse uurimise korraldamine loomahaiguste diagnoosimiseks ning loomsete saaduste ja loomset päritolu sööda, heina, põhu ja ravimsööda ning joogivee omaduste hindamiseks; loomade nakkushaiguste või loomadelt inimesele üle kanduvate nakkushaiguste teistest riikidest sissetoomise vältimiseks abinõude tarvituselevõtmine, samuti sisseveetavate loomade, loomsete saaduste, loomasööda ja võimalike nakkusekandjate veterinaarkontroll; põllumajandusloomade ja lemmikloomade identifitseerimise ja registreerimise järelevalve, loomade ja loomsete saaduste siseriikliku liikumise veterinaarkontroll; loomsete saaduste veterinaarkontroll ja nende nõuetekohasuse hindamine; kehtetu - söötade veterinaarkontroll; loomakasvatushoonete ja -rajatiste, põllumajandusloomi kasvatavate ja loomseid saadusi käitlevate ettevõtete järelevalve; loomakasvatushoonete ja -rajatiste, põllumajandusloomi kasvatavate ja loomseid saadusi käitlevate ettevõtete ehitusprojektide kooskõlastamine; keskkonna kaitsmine loomapidamise, loomsete saaduste käitlemise ja loomahaigustega kaasnevate kahjulike tegurite eest; veterinaararstide ja loomseid saadusi tootvate loomapidajate poolse ravimite ja ravimsöötade kasutamise kontroll; Eestist väljaveetavate loomade, loomsete saaduste, toidutoorme ja toidu sihtriigis kehtestatud nõuetele vastavuse kontroll.",
      "rdfs:label": {
        "@value": "VetKS_Par_4 (redaktsioon 22453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22453",
      "estleg:supersededByVersion": {
        "@id": "estleg:VetKS_Par_4_v187035"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22453",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
