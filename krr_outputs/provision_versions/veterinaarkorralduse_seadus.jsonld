    {
      "@id": "estleg:VetKS_Par_17_v22453",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalvet volitatud veterinaararsti tegevuse üle teostab Veterinaar- ja Toiduameti kohalik asutus, mille järelevalvealasel territooriumil ta tegutseb. (2) Volitatud veterinaararst esitab aruandeid Veterinaar- ja Toiduameti kohalikule asutusele, mille järelevalvealasel territooriumil ta tegutseb. (3) Nõuded volitatud veterinaararsti poolt esitatavale aruandlusele ja aruannete esitamise kord kehtestatakse Veterinaar- ja Toiduameti peadirektori käskkirjaga.",
      "rdfs:label": {
        "@value": "VetKS_Par_17 (redaktsioon 22453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22453",
      "estleg:supersededByVersion": {
        "@id": "estleg:VetKS_Par_17_v129062014107"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22453",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 17",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
