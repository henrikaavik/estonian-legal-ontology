      }
    },
    {
      "@id": "estleg:VetKS_Par_18_v22453",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volitatud veterinaararsti tegevusloa peatamisel peatub ka talle antud volitus. (2) Kui volitatud veterinaararsti volitusega seotud tegevus ei ole nõuetekohane, peatab Veterinaar- ja Toiduameti kohaliku asutuse juht volituse ja annab tähtaja puuduste kõrvaldamiseks. Kui tähtajaks puudusi ei kõrvaldata, tühistab Veterinaar- ja Toiduameti kohaliku asutuse juht volituse.",
      "rdfs:label": {
        "@value": "VetKS_Par_18 (redaktsioon 22453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22453",
      "estleg:supersededByVersion": {
