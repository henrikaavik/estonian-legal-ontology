    {
      "@id": "estleg:VetKS_Par_29_v22453",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VetKS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veterinaarlaboratooriumi tegevusluba on laboratooriumile tema taotlusel väljastatav luba tegelda loomahaiguste laboratoorse diagnoosimisega. (2) Tegevusluba antakse käesolevas seaduses sätestatud korras tunnustatud analüüsimetoodikaid kasutavale laboratooriumile. (3) Tegevusloas märgitakse: tegevusloa omanik; äriregistri kood; tegevusvaldkond; väljaandmise kuupäev; kehtivusaeg; registreerimisnumber. (4) Tegevusluba kehtib ainult tunnustatud analüüsimetoodikate ulatuses ja koos tunnustamist tõendava dokumendiga.",
      "rdfs:label": {
        "@value": "VetKS_Par_29 (redaktsioon 22453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22453",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22453",
      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
      "@id": "estleg:VetKS_Par_3_v22453",
      "@type": [
