      "estleg:sourceAct": "Veterinaarkorralduse seadus",
      "estleg:provisionRef": "VetKS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:VetKS_Map"
      }
    },
    {
      "@id": "estleg:VetKS_Par_18_v187035",
      "@type": [
        "owl:NamedIndividual",
