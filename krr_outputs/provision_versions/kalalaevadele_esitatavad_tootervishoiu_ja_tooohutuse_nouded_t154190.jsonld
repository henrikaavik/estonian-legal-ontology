      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154190_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kalapüügi- ja tõsteseadmed peavad olema töökorras. Neid seadmeid peab spetsialist kontrollima vähemalt üks kord aastas ja hooldama valmistajatehase juhendi kohaselt. Kalapüügi- ja tõsteseadmed peavad olema töökorras. Neid seadmeid peab spetsialist kontrollima vähemalt üks kord aastas ja hooldama valmistajatehase juhendi kohaselt. 2 (2) Traallaev peab olema varustatud traallaudade kinnitusvahendiga ja traalkoti pendeldamist piirava vahendiga. Traallaev peab olema varustatud traallaudade kinnitusvahendiga ja traalkoti pendeldamist piirava vahendiga. 3 (3) Külmutus- ja suruõhuseadmeid peab spetsialist kontrollima vähemalt üks kord aastas ning neid valmistajatehase juhendi kohaselt hooldama. Külmutus- ja suruõhuseadmeid peab spetsialist kontrollima vähemalt üks kord aastas ning neid valmistajatehase juhendi kohaselt hooldama.",
      "rdfs:label": {
        "@value": "Reg_154190_Par_4 (redaktsioon 154190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154190",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154190",
      "estleg:sourceAct": "Kalalaevadele esitatavad töötervishoiu ja tööohutuse nõuded",
      "estleg:provisionRef": "Reg_154190 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154190_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154190_Par_5_v154190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154190_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Gaasil töötavaid seadmeid tohib kasutada ainult hästi ventileeritavates ruumides kohtäratõmmet kasutades. Gaasil töötavaid seadmeid tohib kasutada ainult hästi ventileeritavates ruumides kohtäratõmmet kasutades. 2 (2) Tule- ja plahvatusohtlikke gaase sisaldavad balloonid ja neid sisaldav nähtav torustik peab olema märgistatud vastavalt «Kemikaaliseaduse» alusel kehtestatud õigusaktidele. Tule- ja plahvatusohtlikke gaase sisaldavad balloonid ja neid sisaldav nähtav torustik peab olema märgistatud vastavalt «Kemikaaliseaduse» alusel kehtestatud õigusaktidele. 3 (3) Balloonid peavad olema ladustatud avatekil. Kõik balloonidest lähtuvad ventiilid, surveregulaatorid ja torud peavad olema kaitstud väliskahjustuste eest. Balloonid peavad olema ladustatud avatekil. Kõik balloonidest lähtuvad ventiilid, surveregulaatorid ja torud peavad olema kaitstud väliskahjustuste eest.",
      "rdfs:label": {
        "@value": "Reg_154190_Par_5 (redaktsioon 154190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154190",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154190",
      "estleg:sourceAct": "Kalalaevadele esitatavad töötervishoiu ja tööohutuse nõuded",
      "estleg:provisionRef": "Reg_154190 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154190_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154190_Par_6_v154190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154190_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Raadioseadmed peavad tagama pideva ühenduse vähemalt ühe kalalaeva sõidupiirkonnas asuva kaldaraadiojaamaga. Raadioseadmed peavad tagama pideva ühenduse vähemalt ühe kalalaeva sõidupiirkonnas asuva kaldaraadiojaamaga.",
      "rdfs:label": {
        "@value": "Reg_154190_Par_6 (redaktsioon 154190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154190",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154190",
      "estleg:sourceAct": "Kalalaevadele esitatavad töötervishoiu ja tööohutuse nõuded",
      "estleg:provisionRef": "Reg_154190 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154190_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154190_Par_7_v154190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154190_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kalalaevad peavad olema varustatud tulekustutusvahenditega, vajadusel tulekahjusignalisatsioonisüsteemiga sõltuvalt laeva suurusest, varustusest, lastist ja maksimaalsest eeldatavast inimeste arvust laeval, vastavalt «Meresõiduohutuse seaduse» alusel kehtestatud nõuetele. Kalalaevad peavad olema varustatud tulekustutusvahenditega, vajadusel tulekahjusignalisatsioonisüsteemiga sõltuvalt laeva suurusest, varustusest, lastist ja maksimaalsest eeldatavast inimeste arvust laeval, vastavalt «Meresõiduohutuse seaduse» alusel kehtestatud nõuetele. 2 (2) Tulekustutusvahendeid tuleb hoida kindlaksmääratud kohas, nad peavad olema nõuetekohaselt märgistatud, töökorras ja kohe kättesaadavad. Tulekustutusvahendeid tuleb hoida kindlaksmääratud kohas, nad peavad olema nõuetekohaselt märgistatud, töökorras ja kohe kättesaadavad. 3 (3) Laevapere liikmed peavad oskama tulekustutusvahendeid kasutada ja teadma nende asukohta. Laevapere liikmed peavad oskama tulekustutusvahendeid kasutada ja teadma nende asukohta. 4 (4) Tulekahjusignalisatsioonisüsteemi tuleb regulaarselt hooldada ja nende korrasolekut kontrollida vastavalt «Päästeseaduse» alusel kehtestatud õigusaktidele. Tulekahjusignalisatsioonisüsteemi tuleb regulaarselt hooldada ja nende korrasolekut kontrollida vastavalt «Päästeseaduse» alusel kehtestatud õigusaktidele. 5 (5) Kõik laevapere liikmed peavad läbima tulekustutusalase väljaõppe kooskõlas Vabariigi Valitsuse 20. juuni 2013. a määrusega nr 96 „Laevapere liikmete koolitus- ja kvalifikatsiooninõuded ning diplomeerimise kord”. RT I 2020-03-17 6 117032020006 2020-03-20 Kõik laevapere liikmed peavad läbima tulekustutusalase väljaõppe kooskõlas Vabariigi Valitsuse 20. juuni 2013. a määrusega nr 96 „Laevapere liikmete koolitus- ja kvalifikatsiooninõuded ning diplomeerimise kord”.",
      "rdfs:label": {
        "@value": "Reg_154190_Par_7 (redaktsioon 154190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154190",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154190",
      "estleg:sourceAct": "Kalalaevadele esitatavad töötervishoiu ja tööohutuse nõuded",
      "estleg:provisionRef": "Reg_154190 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154190_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154190_Par_8_v154190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154190_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ruumisisesed töötamiskohad tuleb varustada ventilatsioonisüsteemiga, mis tagab töötsoonist liigsoojuse, liigniiskuse ja ohtlike ainete eemaldamise ning värske õhu sissepuhke. Ruumisisesed töötamiskohad tuleb varustada ventilatsioonisüsteemiga, mis tagab töötsoonist liigsoojuse, liigniiskuse ja ohtlike ainete eemaldamise ning värske õhu sissepuhke. 2 (2) Kambüüsi pliit ja ohtlike ainete tekkega seotud töötamiskohad peavad olema varustatud kohtäratõmbega. Kambüüsi pliit ja ohtlike ainete tekkega seotud töötamiskohad peavad olema varustatud kohtäratõmbega. 3 (3) Mehaaniline ventilatsioonisüsteem tuleb hoida heas töökorras. Mehaaniline ventilatsioonisüsteem tuleb hoida heas töökorras.",
      "rdfs:label": {
        "@value": "Reg_154190_Par_8 (redaktsioon 154190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154190",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154190",
      "estleg:sourceAct": "Kalalaevadele esitatavad töötervishoiu ja tööohutuse nõuded",
      "estleg:provisionRef": "Reg_154190 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154190_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154190_Par_9_v154190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154190_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ruumisiseste töötamiskohtade temperatuur tuleb hoida sobiv tööülesande täitmiseks, arvestades tööaja pikkust, töö laadi, füüsilise töö raskust ja ilmastikuolusid. Ruumisiseste töötamiskohtade temperatuur tuleb hoida sobiv tööülesande täitmiseks, arvestades tööaja pikkust, töö laadi, füüsilise töö raskust ja ilmastikuolusid.",
      "rdfs:label": {
        "@value": "Reg_154190_Par_9 (redaktsioon 154190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154190",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154190",
      "estleg:sourceAct": "Kalalaevadele esitatavad töötervishoiu ja tööohutuse nõuded",
      "estleg:provisionRef": "Reg_154190 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154190_Map_2026"
      }
    },
