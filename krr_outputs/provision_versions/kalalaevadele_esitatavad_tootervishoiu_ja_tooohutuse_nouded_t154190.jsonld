    {
      "@id": "estleg:Reg_154190_Par_17_v154190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154190_Par_17"
