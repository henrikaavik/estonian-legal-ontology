        "@id": "estleg:Reg_309023_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu säilimise tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu säilimise tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_309023_Par_8 (redaktsioon 309023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309023",
