    },
    {
      "@id": "estleg:Reg_1039192_Par_3_v1039192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039192_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ekspordi, välistöötlemise ja liidu kauba tolliladustamise tolliprotseduuril, reekspordil ning kauba lähetamisel erikorraga maksustamisterritooriumile täidetakse tollideklaratsioon määruse § 1 lõikes 1 nimetatud liidu õigusaktide alusel, arvestades määruse lisas 1 toodud riiklikke erisusi. RT I 2026-02-20 2 120022026002 2026-02-23 Ekspordi, välistöötlemise ja liidu kauba tolliladustamise tolliprotseduuril, reekspordil ning kauba lähetamisel erikorraga maksustamisterritooriumile täidetakse tollideklaratsioon määruse § 1 lõikes 1 nimetatud liidu õigusaktide alusel, arvestades määruse lisas 1 toodud riiklikke erisusi.",
      "rdfs:label": {
        "@value": "Reg_1039192_Par_3 (redaktsioon 1039192)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039192",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039192",
      "estleg:sourceAct": "Täpsustavad juhised tollideklaratsiooni esitamiseks ning muutmise ja kehtetuks tunnistamise taotluse esitamiseks",
      "estleg:provisionRef": "Reg_1039192 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039192_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039192_Par_4_v1039192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039192_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabasse ringlusse lubamise, seestöötlemise, ajutise impordi, lõppkasutuse ja tolliladustamise tolliprotseduuril täidetakse tollideklaratsioon määruse § 1 lõikes 1 nimetatud liidu õigusaktide alusel, arvestades määruse lisas 5 toodud riiklikke erisusi. Seejuures lähtutakse tolliprotseduuri riikliku lisakoodi märkimisel määruse lisast 4, teatud erisätete alusel imporditava kauba erikoodi märkimisel määruse lisast 6 ja riikliku maksuliigi koodi märkimisel määruse lisast 7. RT I 2026-02-20 2 120022026002 2026-02-23 Vabasse ringlusse lubamise, seestöötlemise, ajutise impordi, lõppkasutuse ja tolliladustamise tolliprotseduuril täidetakse tollideklaratsioon määruse § 1 lõikes 1 nimetatud liidu õigusaktide alusel, arvestades määruse lisas 5 toodud riiklikke erisusi. Seejuures lähtutakse tolliprotseduuri riikliku lisakoodi märkimisel määruse lisast 4, teatud erisätete alusel imporditava kauba erikoodi märkimisel määruse lisast 6 ja riikliku maksuliigi koodi märkimisel määruse lisast 7.",
      "rdfs:label": {
        "@value": "Reg_1039192_Par_4 (redaktsioon 1039192)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039192",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039192",
      "estleg:sourceAct": "Täpsustavad juhised tollideklaratsiooni esitamiseks ning muutmise ja kehtetuks tunnistamise taotluse esitamiseks",
