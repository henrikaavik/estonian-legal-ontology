      "estleg:provisionRef": "Reg_1039192 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039192_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039192_Par_10_v1039192",
      "@type": [
