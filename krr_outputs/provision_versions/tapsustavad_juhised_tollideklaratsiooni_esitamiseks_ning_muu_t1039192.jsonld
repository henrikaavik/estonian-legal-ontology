      "estleg:versionValidFrom": {
        "@value": "2026-02-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elektriülekandeliine ja torujuhtmeid mööda toimetatava elektrienergia ja maagaasi deklareerib importija ja eksportija iga kuu 15. kuupäevaks sellele eelneva kuu impordi ja ekspordi kohta peetud arvestuse alusel. RT I 2023-09-01 4 101092023004 2023-10-01 Elektriülekandeliine ja torujuhtmeid mööda toimetatava elektrienergia ja maagaasi deklareerib importija ja eksportija iga kuu 15. kuupäevaks sellele eelneva kuu impordi ja ekspordi kohta peetud arvestuse alusel.",
      "rdfs:label": {
        "@value": "Reg_1039192_Par_10 (redaktsioon 1039192)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039192",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039192",
      "estleg:sourceAct": "Täpsustavad juhised tollideklaratsiooni esitamiseks ning muutmise ja kehtetuks tunnistamise taotluse esitamiseks",
      "estleg:provisionRef": "Reg_1039192 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039192_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039192_Par_11_v1039192",
