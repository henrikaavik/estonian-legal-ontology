    {
      "@id": "estleg:Reg_1039192_Par_12_v1039192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039192_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Loa taotlemisel tolliseadustiku artiklis 166 sätestatud lihtsustatud deklaratsiooni kasutamiseks ja artiklis 182 sätestatud tollideklaratsiooni esitamiseks deklarandi arvestuskande vormis märgitakse tolliotsuste süsteemis andmeväljale „Üldised märkused” soovitav lisadeklaratsiooni liik. RT I 2023-09-01 4 101092023004 2023-10-01 Loa taotlemisel tolliseadustiku artiklis 166 sätestatud lihtsustatud deklaratsiooni kasutamiseks ja artiklis 182 sätestatud tollideklaratsiooni esitamiseks deklarandi arvestuskande vormis märgitakse tolliotsuste süsteemis andmeväljale „Üldised märkused” soovitav lisadeklaratsiooni liik. 2 (2) Perioodilise ja kokkuvõtliku lisadeklaratsiooni kasutamise korral märgitakse andmeväljale „Üldised märkused” lisaks lõikes 1 sätestatule ka ajavahemik, mille jooksul lihtsustatud deklaratsiooniga või deklarandi arvestuskande vormis deklareeritud kauba kohta lisadeklaratsioon esitatakse. RT I 2023-09-01 4 101092023004 2023-10-01 Perioodilise ja kokkuvõtliku lisadeklaratsiooni kasutamise korral märgitakse andmeväljale „Üldised märkused” lisaks lõikes 1 sätestatule ka ajavahemik, mille jooksul lihtsustatud deklaratsiooniga või deklarandi arvestuskande vormis deklareeritud kauba kohta lisadeklaratsioon esitatakse.",
      "rdfs:label": {
        "@value": "Reg_1039192_Par_12 (redaktsioon 1039192)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039192",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039192",
      "estleg:sourceAct": "Täpsustavad juhised tollideklaratsiooni esitamiseks ning muutmise ja kehtetuks tunnistamise taotluse esitamiseks",
      "estleg:provisionRef": "Reg_1039192 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039192_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039192_Par_13_v1039192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039192_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Olenemata lisadeklaratsiooni esitamise tähtpäevast võib toll nõuda deklarandilt lisadeklaratsiooni esitamist kalendrikuu viimasel tööpäeval enne maksumäära või impordimaksude määramisel rakendatava euro vahetuskursi muutumist. Olenemata lisadeklaratsiooni esitamise tähtpäevast võib toll nõuda deklarandilt lisadeklaratsiooni esitamist kalendrikuu viimasel tööpäeval enne maksumäära või impordimaksude määramisel rakendatava euro vahetuskursi muutumist.",
      "rdfs:label": {
        "@value": "Reg_1039192_Par_13 (redaktsioon 1039192)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039192",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039192",
      "estleg:sourceAct": "Täpsustavad juhised tollideklaratsiooni esitamiseks ning muutmise ja kehtetuks tunnistamise taotluse esitamiseks",
      "estleg:provisionRef": "Reg_1039192 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039192_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039192_Par_13_14_v1039192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039192_Par_13_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pärast kauba vabastamist märgitakse tollideklaratsiooni muutmise ja kehtetuks tunnistamise taotluses: 1 1) taotleja nimi, isikukood või EORI number ja kontaktandmed; 2 2) tollideklaratsiooni tolli viitenumber; 3 3) üksikasjalikud põhjendused tollideklaratsiooni muutmiseks või selle kehtetuks tunnistamiseks; 4 4) tollideklaratsiooni andmeväljade numbrid, milles sisalduvates andmetes muudatuste tegemist taotletakse koos taotletavate parandustega nendes; 5 5) selgitus rahaliste toimingute teostamiseks koos pangarekvisiitidega. Pärast kauba vabastamist märgitakse tollideklaratsiooni muutmise ja kehtetuks tunnistamise taotluses: taotleja nimi, isikukood või EORI number ja kontaktandmed; tollideklaratsiooni tolli viitenumber; üksikasjalikud põhjendused tollideklaratsiooni muutmiseks või selle kehtetuks tunnistamiseks; tollideklaratsiooni andmeväljade numbrid, milles sisalduvates andmetes muudatuste tegemist taotletakse koos taotletavate parandustega nendes; selgitus rahaliste toimingute teostamiseks koos pangarekvisiitidega. 2 (2) Taotlusele lisatakse taotlust põhjendavad dokumendid. RT I 2021-11-02 5 102112021005 2021-11-05 Taotlusele lisatakse taotlust põhjendavad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_1039192_Par_13_14 (redaktsioon 1039192)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039192",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039192",
      "estleg:sourceAct": "Täpsustavad juhised tollideklaratsiooni esitamiseks ning muutmise ja kehtetuks tunnistamise taotluse esitamiseks",
      "estleg:provisionRef": "Reg_1039192 § 13_14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039192_Map"
      }
    },
