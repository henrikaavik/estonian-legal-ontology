    },
    {
      "@id": "estleg:Reg_1062415_Par_10_v1062415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062415_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sireeniseade peab vastama järgmistele nõuetele: 1 1) võimaldama viivitamatu ohuteate edastamist helisignaalina või audiotekstina sireeniseadme kaudu; 2 2) välistama valehäirete tekkimise; 3 3) olema keskselt juhitav ja võimaldama alternatiivseid käivitusviise. Sireeniseade peab vastama järgmistele nõuetele: võimaldama viivitamatu ohuteate edastamist helisignaalina või audiotekstina sireeniseadme kaudu; välistama valehäirete tekkimise; olema keskselt juhitav ja võimaldama alternatiivseid käivitusviise.",
      "rdfs:label": {
        "@value": "Reg_1062415_Par_10 (redaktsioon 1062415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062415",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062415",
      "estleg:sourceAct": "Viivitamatu ohuteate edastamise ning selleks valmistumise, EE-ALARM-iga liitumise ning sellega seotud kulude hüvitamise ja sireeniseadme kasutuselevõtu, haldamise ning testimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1062415 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062415_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062415_Par_11_v1062415",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062415_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sireeniseadme helisignaal peab olema arusaadav ja selgesti eristuma taustamürast. Sireeniseadme helisignaal peab olema arusaadav ja selgesti eristuma taustamürast. 2 (2) Sireeniseadme viivitamatu ohuteate helisignaal on minutipikkune tõusev ja langev heli, mida esitatakse kolm korda vahepausiga 30 sekundit. Sellise helisignaali eesmärk on suunata seda kuulvaid inimesi koheselt varjuma. Sireeniseadme viivitamatu ohuteate helisignaal on minutipikkune tõusev ja langev heli, mida esitatakse kolm korda vahepausiga 30 sekundit. Sellise helisignaali eesmärk on suunata seda kuulvaid inimesi koheselt varjuma.",
      "rdfs:label": {
        "@value": "Reg_1062415_Par_11 (redaktsioon 1062415)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062415",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062415",
