      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riikliku järelevalve tulemused avalikustatakse PMA veebilehel.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_71 (redaktsioon 129062014038)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014038",
