      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_83_v130062023038",
      "@type": [
        "owl:NamedIndividual",
