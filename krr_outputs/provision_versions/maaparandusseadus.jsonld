    {
      "@id": "estleg:MAAPAR_Par_4_v24638",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus määrab kindlaks riikliku maaparandusteenistuse struktuuri ja juhtimise korralduse.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_4 (redaktsioon 24638)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24638",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAPAR_Par_4_v256062"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_4_v256062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reguleeriv võrk peab tagama maaviljeluseks sobiva mullaveerežiimi ja minimeerima reostuse leviku ohu. (2) Eesvool peab tagama liigvee äravoolu kuivendusvõrgust või vee juurdevoolu niisutusvõrku ning olema võimalikult suure isepuhastusvõimega. (3) Maaparandussüsteemi hoonetele kohaldatakse ehitusseaduse (RT I 2002, 47, 297; 99, 579) § 3 lõigetes 1–8 ja 11 sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_4 (redaktsioon 256062)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256062",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAPAR_Par_4_v12951119"
      },
      "estleg:versionValidTo": {
        "@value": "2008-04-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_4_v12951119",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reguleeriv võrk peab tagama maaviljeluseks sobiva mullaveerežiimi ja minimeerima hajureostuse leviku ohu. (2) Eesvool peab tagama liigvee äravoolu kuivendusvõrgust või vee juurdevoolu niisutusvõrku ning olema võimalikult suure isepuhastusvõimega. (3) Maaparandussüsteemi hoonetele kohaldatakse ehitusseaduse § 3 lõigetes 1–8 ja 11 sätestatud nõudeid. (4) Maaparandussüsteemi osa projekteerimise, ehitamise ja maaparandushoiu suhtes kohaldatakse käesoleva seadusega maaparandussüsteemile kehtestatud nõudeid.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_4 (redaktsioon 12951119)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12951119",
      "estleg:supersededByVersion": {
