        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud - (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "MAAPAR_Par_39 (redaktsioon 129062014038)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014038",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAPAR_Par_39_v131052018003"
      },
      "estleg:versionValidTo": {
