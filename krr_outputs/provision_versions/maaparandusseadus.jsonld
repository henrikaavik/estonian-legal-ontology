      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_8_v256062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_8"
      },
      "estleg:versionValidFrom": {
