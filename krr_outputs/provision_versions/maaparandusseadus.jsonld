    {
      "@id": "estleg:MAAPAR_Par_18_v24638",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maaparandussüsteeme ületavaid raudtee- ja maanteesildu hoiab korras raudtee või maantee omanik või valdaja vastavalt teistele õigusaktidele. Maaparandustööd, mis põhjustavad veerežiimi muutusi raudtee- või maanteemaal, kooskõlastatakse raudtee või maantee omanikuga.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_18 (redaktsioon 24638)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24638",
