      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maaparandusühistu esitab majandusaasta aruande mittetulundusühingute seaduse § 36 lõike 5 ja § 78 lõike 3 kohaselt ilma põhitegevusala andmeteta.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_74 (redaktsioon 131052018003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052018003",
      "estleg:supersededByVersion": {
