      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maaparandusseire on kuivendatud maatulundusmaa kuivendusseisundi, põllumajandusmaa lubjatarbe ning maaparanduse ja maakasutuse keskkonnamõju järjepidev jälgimine, mis hõlmab vaatlusi ja analüüsi ning vaatlusandmete töötlemist. (2) Maaparandusseiret korraldavad: Põllumajandus- ja Toiduamet – maa kuivendusseisundi ja maaparanduse keskkonnamõju puhul; Põllumajandusuuringute Keskus – maa lubjatarbe ja maakasutuse keskkonnamõju puhul. (3) Seiret tegev isik võib seireks vajalikke tegevusi teha üksnes kinnisasja omaniku nõusolekul. (4) Maaparandusseire käigus võetud proove võib analüüsida selleks akrediteeritud isik või asutus. (5) Proovide võtmise ja analüüsimisega seotud kulud kaetakse riigieelarves Maaeluministeeriumile selleks ettenähtud vahendite arvelt. (6) Seire tulemused avalikustatakse käesoleva paragrahvi lõikes 2 nimetatud asutuste veebilehtedel ning lisaks võib need avaldada paberkandjal.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_83 (redaktsioon 101072020008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101072020008",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAPAR_Par_83_v123112022007"
      },
      "estleg:versionValidTo": {
        "@value": "2022-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_83_v123112022007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maaparandusseire on kuivendatud maatulundusmaa kuivendusseisundi, põllumajandusmaa lubjatarbe ning maaparanduse ja maakasutuse keskkonnamõju järjepidev jälgimine, mis hõlmab vaatlusi ja analüüsi ning vaatlusandmete töötlemist. (2) Maaparandusseiret korraldavad: Põllumajandus- ja Toiduamet – maa kuivendusseisundi ja maaparanduse keskkonnamõju puhul; Maaeluministeeriumi hallatav asutus, kelle ülesanne on koordineerida ja arendada põllu- ja maamajanduse valdkonna teadmussiiret, nõuandeteenust ja innovatsiooni toetavat tegevust – maa lubjatarbe ja maakasutuse keskkonnamõju puhul. (3) Seiret tegev isik võib seireks vajalikke tegevusi teha üksnes kinnisasja omaniku nõusolekul. (4) Maaparandusseire käigus võetud proove võib analüüsida selleks akrediteeritud isik või asutus. (5) Proovide võtmise ja analüüsimisega seotud kulud kaetakse riigieelarves Maaeluministeeriumile selleks ettenähtud vahendite arvelt. (6) Seire tulemused avalikustatakse käesoleva paragrahvi lõikes 2 nimetatud asutuste veebilehtedel ning lisaks võib need avaldada paberkandjal.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_83 (redaktsioon 123112022007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022007",
