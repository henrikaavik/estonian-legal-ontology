      }
    },
    {
      "@id": "estleg:MAAPAR_Par_40_v131052018003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maaparandussüsteemide registri andmed on: maaparandussüsteemi andmed; käesoleva seaduse § 3 lõikes 7 sätestatud maaparandusehitise andmed; maaparandussüsteemi või selle ehitamisega seotud isiku ees- ja perekonnanimi, isikukood või sünniaeg või juriidilise isiku ärinimi ja registrikood ning kontaktandmed; maaparandussüsteemi või selle ehitamisega seonduvate taotluste, projekteerimistingimuste, teatiste, lubade, kasutusotstarbe lõppenuks lugemise, ettekirjutuste ja kooskõlastuste andmed. (2) Maaparandussüsteemi andmed on: maaparandussüsteemi kood; üldandmed; asukoha andmed; ehitusprojekti andmed; ehitusprojekti koostamiseks tehtud maaparanduse uurimistöö andmed; ehitusprojekti ekspertiisiakti andmed. (3) Maaparandusehitise andmed on: maaparandusehitise nimetus; maaparandusehitise kood; tehnilised andmed; esmase kasutuselevõtu aasta. (4) Maaparandussüsteemide registri põhimääruses võib täpsustada käesoleva paragrahvi lõikes 1 sätestatud andmete koosseisu. (5) Maaparandussüsteemide registri andmetel on informatiivne ja statistiline tähendus. (6) Ehitamise alustamise teatisel on õiguslik tähendus.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_40 (redaktsioon 131052018003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052018003"
    },
    {
      "@id": "estleg:MAAPAR_Par_41_v256062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maaparandussüsteemide registrisse kantakse maaparandussüsteemi kohta: projekteerimistingimuste andmise otsuses projekteerimistingimuste kohta märgitud andmed; ehitusprojekti koostamiseks tehtud maaparanduse uurimistöö koondandmed; ehitusprojekti koondandmed; ehitusprojekti või maaparandussüsteemi ekspertiisiakt; ehitusloa andmed; andmed kasutuselevõtu akti kinnitamise või kinnitamisest keeldumise kohta; kinnitatud kasutuselevõtu akti andmed; andmed maaparandussüsteemi kasutusotstarbe lõppemise kohta; ehitamise algus- ja lõpptähtpäev; andmed käesoleva seaduse alusel tehtud ja jõustunud ettekirjutuste kohta.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_41 (redaktsioon 256062)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256062",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAPAR_Par_41_v12951119"
      },
      "estleg:versionValidTo": {
        "@value": "2008-04-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_41_v12951119",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maaparandussüsteemide registrisse kantakse maaparandussüsteemi osa kohta: ehitise nimetus; maaparandussüsteemi kood; tehnilised üld- ja detailandmed; asukoha andmed; projekteerimistingimuste andmed; ehitusprojekti koondandmed; ehitusprojekti koostamiseks tehtud maaparanduse uurimistöö andmed; ehitusprojekti või ehitise ekspertiisiakti andmed; ehitusloa andmed; ehitaja ja omanikujärelevalve tegija nimi, registri- või isikukood (isikukoodi puudumise korral sünniaeg) ning maaparandusalal tegutsevate ettevõtjate registri kood; ehitamise alustamise tähtpäev; kasutuselevõtu akti andmed; kinnisasjale, millel paikneb maaparandussüsteem, muu ehitise ehitamiseks vajaliku ehitusprojekti kooskõlastamise andmed või eesvoolu või selle kaitselõigu veetaseme reguleerimise kavatsuse kooskõlastamise andmed; riikliku järelevalvetöötaja ettekirjutuse andmed; kasutusotstarbe lõppemise andmed.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_41 (redaktsioon 12951119)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12951119",
      "estleg:supersededByVersion": {
