      },
      "estleg:versionValidTo": {
        "@value": "2015-03-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_4_v104032015023",
      "@type": [
        "owl:NamedIndividual",
