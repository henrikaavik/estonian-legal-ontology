    },
    {
      "@id": "estleg:MAAPAR_Par_7_v131052018003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui ehitusseadustiku §-s 5 nimetatud ehitusprojektiga kavandatava ehitise ehitamine tingib maaparandussüsteemi ehitamise, siis kohaldatakse maaparandussüsteemi ehitamisele käesolevas seaduses sätestatut.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_7 (redaktsioon 131052018003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052018003"
    },
    {
      "@id": "estleg:MAAPAR_Par_70_v256062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui ettekirjutuse saaja ei nõustu järelevalvetöötaja ettekirjutusega, võib ta järelevalveasutuse juhile esitada vaide ettekirjutusest teadasaamisest arvates kümne tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_70 (redaktsioon 256062)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256062",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAPAR_Par_70_v13238320"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_70_v13238320",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui ettekirjutuse saaja ei nõustu järelevalveametniku ettekirjutusega, võib ta järelevalveasutuse juhile esitada vaide ettekirjutusest teadasaamisest arvates kümne tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_70 (redaktsioon 13238320)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13238320",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAPAR_Par_70_v129062014038"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_70_v129062014038",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "MAAPAR_Par_70 (redaktsioon 129062014038)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014038",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAPAR_Par_70_v131052018003"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAPAR_Par_70_v131052018003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAPAR_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hääled jagunevad üldkoosolekutel ühel järgmistest põhimõtetest: igal maaparandusühistu liikmel on üks hääl; maaparandusühistu liikme häälte arv sõltub õiendis märgitud ühiseesvoolu hoiukohustuse osa suurusest; maaparandusühistu liikmel on hääli võrdeliselt tema kinnisasjal paikneva maaparandussüsteemi maa-ala pindalaga. (2) Maaparandusühistu liikmete üldkoosolekul on igal maaparandusühistu liikmel vähemalt üks hääl. (3) Kui üldkoosolekul osaleb rohkem kui kaks liiget, võib ühel maaparandusühistu liikmel olla kuni kaks viiendikku häälte üldarvust. (4) Kui kinnisasi kuulub mitmele isikule, siis on neil ühine hääl.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_70 (redaktsioon 131052018003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052018003"
    },
    {
      "@id": "estleg:MAAPAR_Par_71_v256062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
