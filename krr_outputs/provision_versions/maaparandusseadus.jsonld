      },
      "estleg:versionText": "Käesolev seadus jõustub 2019. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "MAAPAR_Par_111 (redaktsioon 131052018003)",
        "@language": "et"
      },
