        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. RT I 2009 7 48 13125268 2009-02-01 Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_159025_Par_3 (redaktsioon 159025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159025",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159025",
      "estleg:sourceAct": "Koiva-Mustjõe maastikukaitseala kaitse-eeskiri",
