        "@value": "2016-02-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koiva piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Koiva piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse.",
      "rdfs:label": {
        "@value": "Reg_159025_Par_12 (redaktsioon 159025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159025",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159025",
