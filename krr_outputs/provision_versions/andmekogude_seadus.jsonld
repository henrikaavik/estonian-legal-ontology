      }
    },
    {
      "@id": "estleg:ANDMEK_Par_40_v745339",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ANDMEK_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) andmekogu asutamise ja kasutuselevõtmise eesmärgi; andmekogu nime; andmekogu ülesehituse; andmekogu vastutava ja volitatud töötleja; andmekogusse kantavad andmed; [kehtetu] vastavalt riigisaladuse seadusele ja isikuandmete kaitse seadusele avalikuks kasutamiseks mitteettenähtud andmete loetelu; andmekogu pidamise üle järelevalve teostamise korra. (2) Andmekogu asutamisest informeeritakse kirjalikult andmekaitse järelevalveasutust. (3) Käesoleva paragrahvi lõikes 1 nimetatud andmekogu asutamise õigusakti kohta annavad arvamuse andmekogude riikliku registri vastutav töötleja ja Statistikaamet.",
      "rdfs:label": {
        "@value": "ANDMEK_Par_40 (redaktsioon 745339)",
