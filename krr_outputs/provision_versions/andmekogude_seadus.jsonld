      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikud, kes andmekogu pidamisel või andmekogu andmete kasutamisel rikuvad käesolevat seadust, kannavad vastutust distsiplinaar-, haldus- ja kriminaalkorras. Paragrahvid 55-57. [Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "ANDMEK_Par_54 (redaktsioon 22372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22372",
