      }
    },
    {
      "@id": "estleg:Reg_1029320_Par_3_v1029320",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029320_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lisaks ehitisregistrile tuleb uuringu aruanne esitada ka Eesti Geoloogiateenistusele. RT I 2024-12-27 3 127122024003 2025-01-01 Lisaks ehitisregistrile tuleb uuringu aruanne esitada ka Eesti Geoloogiateenistusele. 2 (2) Uuringu tegija on kohustatud uuringu aruande esitama ehitisregistrile ja Eesti Geoloogiateenistusele 10 päeva jooksul uuringu aruande valmimise päevast arvates. RT I 2024-12-27 3 127122024003 2025-01-01 Uuringu tegija on kohustatud uuringu aruande esitama ehitisregistrile ja Eesti Geoloogiateenistusele 10 päeva jooksul uuringu aruande valmimise päevast arvates. 3 (3) Uuringu aruanne esitatakse elektrooniliselt. Uuringu aruanne esitatakse elektrooniliselt.",
      "rdfs:label": {
        "@value": "Reg_1029320_Par_3 (redaktsioon 1029320)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029320",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029320",
      "estleg:sourceAct": "Ehitusgeoloogilisele uuringule esitatavad nõuded",
      "estleg:provisionRef": "Reg_1029320 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029320_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029320_Par_4_v1029320",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029320_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Uuringut tegev isik peab säilitama täies ulatuses kõik uuringu tegemisega seotud andmed vähemalt seitse aastat või arhiiviseaduses sätestatud korras arhiivi üleandmiseni. Uuringut tegev isik peab säilitama täies ulatuses kõik uuringu tegemisega seotud andmed vähemalt seitse aastat või arhiiviseaduses sätestatud korras arhiivi üleandmiseni.",
      "rdfs:label": {
        "@value": "Reg_1029320_Par_4 (redaktsioon 1029320)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029320",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029320",
      "estleg:sourceAct": "Ehitusgeoloogilisele uuringule esitatavad nõuded",
      "estleg:provisionRef": "Reg_1029320 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029320_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029320_Par_5_v1029320",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029320_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist alustatud ehitusgeoloogilise uuringule kohaldatakse enne käesoleva määruse jõustumist kehtinud nõudeid, kuid uuringu aruanne tuleb esitada Eesti Geoloogiateenistusele käesoleva määruse §-s 3 sätestatust lähtudes. RT I 2024-12-27 3 127122024003 2025-01-01 Enne käesoleva määruse jõustumist alustatud ehitusgeoloogilise uuringule kohaldatakse enne käesoleva määruse jõustumist kehtinud nõudeid, kuid uuringu aruanne tuleb esitada Eesti Geoloogiateenistusele käesoleva määruse §-s 3 sätestatust lähtudes.",
      "rdfs:label": {
        "@value": "Reg_1029320_Par_5 (redaktsioon 1029320)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029320",
