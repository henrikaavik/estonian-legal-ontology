    {
      "@id": "estleg:Reg_311341_Par_13_v311341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_311341_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) tootmisotstarbeta ehitise, kaasa arvatud ajutise ehitise püstitamine, arvestades käesoleva määruse § 5 punktides 4–7 sätestatut. Piiranguvööndis on lubatud: majandustegevus; tootmisotstarbeta ehitise, kaasa arvatud ajutise ehitise püstitamine, arvestades käesoleva määruse § 5 punktides 4–7 sätestatut. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud uuendusraie, kusjuures lageraie korral ei tohi langi suurus ületada 1,0 ha ja turberaie korral ei tohi langi suurus ületada 2,0 ha. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud uuendusraie, kusjuures lageraie korral ei tohi langi suurus ületada 1,0 ha ja turberaie korral ei tohi langi suurus ületada 2,0 ha.",
      "rdfs:label": {
        "@value": "Reg_311341_Par_13 (redaktsioon 311341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "311341",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/311341",
      "estleg:sourceAct": "Aela maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_311341 § 13",
