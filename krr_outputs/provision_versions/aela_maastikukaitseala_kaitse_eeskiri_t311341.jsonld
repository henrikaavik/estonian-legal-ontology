    {
      "@id": "estleg:Reg_311341_Par_14_v311341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_311341_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 3 3) uue veekogu rajamine; 4 4) uue maaparandussüsteemi rajamine; 5 5) biotsiidi ja taimekaitsevahendi kasutamine; 6 6) puidu kokku- ja väljavedu külmumata pinnasel. Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; uue veekogu rajamine; uue maaparandussüsteemi rajamine; biotsiidi ja taimekaitsevahendi kasutamine; puidu kokku- ja väljavedu külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_311341_Par_14 (redaktsioon 311341)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "311341",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/311341",
      "estleg:sourceAct": "Aela maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_311341 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_311341_Map"
      }
    },
    {
      "@id": "estleg:Reg_311341_Par_2_v311341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_311341_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Rapla maakonnas Kaiu vallas Vaopere, Kuimetsa, Toomja, Tolla, Vana-Kaiu, Suurekivi ja Põlliku külas ning Harju maakonnas Kõue vallas Nutu ja Kadja külas. Kaitseala asub Rapla maakonnas Kaiu vallas Vaopere, Kuimetsa, Toomja, Tolla, Vana-Kaiu, Suurekivi ja Põlliku külas ning Harju maakonnas Kõue vallas Nutu ja Kadja külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
