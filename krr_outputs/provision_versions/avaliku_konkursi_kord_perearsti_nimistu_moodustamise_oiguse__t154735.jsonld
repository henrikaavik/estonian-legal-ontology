    },
    {
      "@id": "estleg:Reg_154735_Par_1_v154735",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154735_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Perearsti nimistu (edaspidi nimistu) moodustamise õiguse andmiseks viib Tervisekassa tervishoiuteenuste korraldamise seaduse § 8 lõike 46 alusel kehtestatud nimistute piirarvust lähtuvalt läbi avaliku konkursi (edaspidi konkurss): RT I 2023-05-23 1 123052023001 2023-05-26 1 1) uue nimistu moodustamise õiguse andmiseks või 2 2) vabanenud nimistule perearstiabi osutamise korraldamiseks. RT I 2024-10-04 1 104102024001 2024-10-07 , rakendatakse tagasiulatuvalt alates 1. juulist 2024. a. Perearsti nimistu (edaspidi nimistu) moodustamise õiguse andmiseks viib Tervisekassa tervishoiuteenuste korraldamise seaduse § 8 lõike 46 alusel kehtestatud nimistute piirarvust lähtuvalt läbi avaliku konkursi (edaspidi konkurss): uue nimistu moodustamise õiguse andmiseks või vabanenud nimistule perearstiabi osutamise korraldamiseks. , rakendatakse tagasiulatuvalt alates 1. juulist 2024. a. 2 (2) Konkursi kuulutab välja Tervisekassa. RT I 2023-05-23 1 123052023001 2023-05-26 Konkursi kuulutab välja Tervisekassa.",
      "rdfs:label": {
        "@value": "Reg_154735_Par_1 (redaktsioon 154735)",
        "@language": "et"
      },
