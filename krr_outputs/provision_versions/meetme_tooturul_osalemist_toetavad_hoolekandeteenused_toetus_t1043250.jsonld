    {
      "@id": "estleg:Reg_1043250_Par_22_v1043250",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043250_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluse rahuldamise otsus tunnistatakse osaliselt või täielikult kehtetuks vastavalt struktuuritoetuse seaduse § 22 lõikele 3 või § 47 lõikele 3. Taotluse rahuldamise otsus tunnistatakse osaliselt või täielikult kehtetuks vastavalt struktuuritoetuse seaduse § 22 lõikele 3 või § 47 lõikele 3. 2 (2) Toetuse saajal tuleb saadud toetus tagastada käesoleva paragrahvi lõikes 1 sätestatud otsuse kohaselt. Toetuse saajal tuleb saadud toetus tagastada käesoleva paragrahvi lõikes 1 sätestatud otsuse kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1043250_Par_22 (redaktsioon 1043250)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043250",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043250",
      "estleg:sourceAct": "Meetme „Tööturul osalemist toetavad hoolekandeteenused” toetuse andmise tingimused uudsete lahenduste väljatöötamiseks ja elluviimiseks sotsiaalvaldkonnas",
      "estleg:provisionRef": "Reg_1043250 § 22",
