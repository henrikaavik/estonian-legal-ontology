        "@language": "et"
      },
      "dc:source": "Meetme „Tööturul osalemist toetavad hoolekandeteenused” toetuse andmise tingimused uudsete lahenduste väljatöötamiseks ja elluviimiseks sotsiaalvaldkonnas"
    },
    {
      "@id": "estleg:Reg_1043250_Par_1_v1043250",
      "@type": [
