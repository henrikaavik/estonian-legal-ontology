        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolev määrus jõustub üldises korras. Käesolev määrus jõustub üldises korras. 2 (2) [Käesolevast tekstist välja jäetud.] [Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Reg_331768_Par_26 (redaktsioon 331768)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "331768",
