      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181666",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_18_v235086",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pensioniameti direktori otsus hüvitise määramise või sellest keeldumise kohta tehakse hüvitise taotlejale teatavaks viie tööpäeva jooksul otsuse tegemise päevast arvates posti teel või elektrooniliselt.",
      "rdfs:label": {
        "@value": "KRHMS_Par_18 (redaktsioon 235086)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "235086",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/235086",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_19_v22429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui hüvitise taotleja ei nõustu pensioniameti direktori otsusega, on tal õigus pöörduda elukohajärgsesse halduskohtusse otsuse ärakirja kättesaamise päevale järgnevast päevast arvates ühe kuu jooksul.",
      "rdfs:label": {
        "@value": "KRHMS_Par_19 (redaktsioon 22429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22429",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRHMS_Par_19_v185463"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22429",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_19_v185463",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui hüvitise taotleja ei nõustu pensioniameti direktori otsusega, on tal õigus pöörduda elukohajärgsesse halduskohtusse 30 päeva jooksul otsuse teatavakstegemisest arvates.",
      "rdfs:label": {
        "@value": "KRHMS_Par_19 (redaktsioon 185463)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "185463",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRHMS_Par_19_v181666"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/185463",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_19_v181666",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui hüvitise taotleja ei nõustu pensioniameti direktori otsusega, on tal õigus pöörduda elukohajärgsesse halduskohtusse otsuse ärakirja kättesaamise päevale järgnevast päevast arvates ühe kuu jooksul.",
      "rdfs:label": {
        "@value": "KRHMS_Par_19 (redaktsioon 181666)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181666",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRHMS_Par_19_v235086"
      },
