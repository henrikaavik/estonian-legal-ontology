    {
      "@id": "estleg:KRHMS_Par_15_v235086",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_15"
