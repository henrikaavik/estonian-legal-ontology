      }
    },
    {
      "@id": "estleg:KRHMS_Par_21_v22429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enammakstud hüvitis nõutakse hüvitise saajalt tagasi tsiviilseadustes ettenähtud korras.",
      "rdfs:label": {
        "@value": "KRHMS_Par_21 (redaktsioon 22429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22429",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22429",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_22_v22429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses käsitletud hüvitisele ja hüvitisnõudele ei või pöörata sissenõuet, nõuet ei või ka loovutada ega tasaarvestada.",
      "rdfs:label": {
        "@value": "KRHMS_Par_22 (redaktsioon 22429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22429",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22429",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_23_v22429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse alusel makstavat hüvitist ei tulumaksustata.",
      "rdfs:label": {
        "@value": "KRHMS_Par_23 (redaktsioon 22429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22429",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22429",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_24_v22429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel hüvitise taotlemine ja hüvitise määramine ei piira hüvitise saaja õigust nõuda vägivallakuriteoga tekitatud kahju hüvitamist üldistel alustel. (2) Kui hüvitise saaja esitab vägivallakuriteoga tekitatud kahju hüvitamiseks hagi maa- või linnakohtusse, on ta kohustatud sellest viivitamata pensioniametile kirjalikult teatama.",
      "rdfs:label": {
        "@value": "KRHMS_Par_24 (redaktsioon 22429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22429",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22429",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_25_v22429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärast käesoleva seaduse alusel hüvitise maksmist läheb hüvitise saaja õigus nõuda kahju hüvitamist kuriteoga tekitatud kahju eest vastutavalt isikult hüvitisena makstud summa ulatuses üle riigile. Tagasinõutav summa ei või olla suurem tsiviilhagiga rahuldatud summast. (2) Regressinõudeasjades esindab riiki sotsiaalminister. Sotsiaalministril on edasivolitamisõigus. (3) Kui hüvitise saaja saab sama kahju eest hüvitist pärast käesoleva seaduse alusel hüvitise määramist kuriteoga tekitatud kahju eest vastutavalt isikult või mõnest muust allikast, mida ei arvestatud hüvitise suuruse määramise aluseks olevast kahjust maha vastavalt käesoleva seaduse § 5 lõikele 3, peab ta sellest viivitamata teatama pensioniametile ja maksma hüvitise tagasi hüvitise suuruse määramisel arvestatud ulatuses.",
      "rdfs:label": {
        "@value": "KRHMS_Par_25 (redaktsioon 22429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22429",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22429",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 25",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_26_v22429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eeluurimisasutus on kohustatud teavitama käesoleva seaduse sisust ohvreid ja ülalpeetavaid, kes võiksid saada käesoleva seaduse alusel hüvitist.",
      "rdfs:label": {
        "@value": "KRHMS_Par_26 (redaktsioon 22429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22429",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22429",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_27_v22429",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel makstavaid hüvitisi finantseeritakse riigieelarve eraldistest Sotsiaalministeeriumi eelarvesse ja need määratakse kindlaks vastava eelarveaasta riigieelarve seadusega. (2) Käesoleva seaduse alusel makstavate hüvitiste ja nende maksmise kulu katteallikad on: kriminaalkoodeksi alusel süüdimõistva kohtuotsusega kaasnev sundraha; regressi korras tagasinõutud summad; eraldised eelmise aasta vabadest vahenditest; riigieelarves ettenähtud muud vahendid.",
      "rdfs:label": {
        "@value": "KRHMS_Par_27 (redaktsioon 22429)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22429",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRHMS_Par_27_v185463"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22429",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_27_v185463",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel makstavaid hüvitisi finantseeritakse riigieelarve eraldistest Sotsiaalministeeriumi eelarvesse ja need määratakse kindlaks vastava eelarveaasta riigieelarve seadusega. (2) Käesoleva seaduse alusel makstavate hüvitiste ja nende maksmise kulu katteallikad on: [Punkti 1 sõnastus kuni 31. 08. 2002] kriminaalkoodeksi alusel süüdimõistva kohtuotsusega kaasnev sundraha; [Punkti 1 sõnastus alates 1. 09. 2002] süüdimõistva kohtuotsusega kaasnev sundraha; regressi korras tagasinõutud summad; eraldised eelmise aasta vabadest vahenditest; riigieelarves ettenähtud muud vahendid.",
      "rdfs:label": {
        "@value": "KRHMS_Par_27 (redaktsioon 185463)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "185463",
      "estleg:supersededByVersion": {
