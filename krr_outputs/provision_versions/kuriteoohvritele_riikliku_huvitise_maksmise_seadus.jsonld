        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/181666",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 19",
      "estleg:partOfAct": {
        "@id": "estleg:KRHMS_Map"
      }
    },
    {
      "@id": "estleg:KRHMS_Par_19_v235086",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRHMS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui hüvitise taotleja ei nõustu pensioniameti direktori otsusega, on tal õigus pöörduda elukohajärgsesse halduskohtusse 30 päeva jooksul otsuse teatavakstegemisest arvates.",
      "rdfs:label": {
        "@value": "KRHMS_Par_19 (redaktsioon 235086)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "235086",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/235086",
      "estleg:sourceAct": "Kuriteoohvritele riikliku hüvitise maksmise seadus",
      "estleg:provisionRef": "KRHMS § 19",
