    {
      "@id": "estleg:Reg_1056799_Par_16_v1056799",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056799_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusüksus tunnistab taotleja ja taotluse nõuetele vastavaks, kui taotleja ja taotlus vastavad määruse nõuetele. Rakendusüksus tunnistab taotleja ja taotluse nõuetele vastavaks, kui taotleja ja taotlus vastavad määruse nõuetele. 2 (2) Kui rakendusüksus ei tunnista taotlejat või taotlust nõuetele vastavaks, siis teeb rakendusüksus taotluse rahuldamata jätmise otsuse taotlust sisuliselt hindamata. Kui rakendusüksus ei tunnista taotlejat või taotlust nõuetele vastavaks, siis teeb rakendusüksus taotluse rahuldamata jätmise otsuse taotlust sisuliselt hindamata.",
      "rdfs:label": {
        "@value": "Reg_1056799_Par_16 (redaktsioon 1056799)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056799",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056799",
      "estleg:sourceAct": "Ida-Virumaa väike- ja keskmise suurusega ettevõtjate investeeringute toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1056799 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056799_Map"
