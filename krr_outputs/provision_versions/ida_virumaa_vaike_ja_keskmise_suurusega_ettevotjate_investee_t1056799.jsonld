      }
    },
    {
      "@id": "estleg:Reg_1056799_Par_21_v1056799",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056799_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotluse rahuldamise otsus tunnistatakse osaliselt või täielikult kehtetuks, kui: 1 1) toetuse saaja ei täida määruses või taotluse rahuldamise otsuses sätestatut või ei kasuta toetust ettenähtud tingimustel; 2 2) projekti tegevusi ei ole võimalik lõpetada hiljemalt 31. augustil 2029. RT I 2025-10-17 10 117102025010 2025-10-20 Taotluse rahuldamise otsus tunnistatakse osaliselt või täielikult kehtetuks, kui: toetuse saaja ei täida määruses või taotluse rahuldamise otsuses sätestatut või ei kasuta toetust ettenähtud tingimustel; projekti tegevusi ei ole võimalik lõpetada hiljemalt 31. augustil 2029.",
      "rdfs:label": {
        "@value": "Reg_1056799_Par_21 (redaktsioon 1056799)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056799",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056799",
      "estleg:sourceAct": "Ida-Virumaa väike- ja keskmise suurusega ettevõtjate investeeringute toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1056799 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056799_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056799_Par_22_v1056799",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056799_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse saaja peab täitma ühendmääruse §-des 10 ja 11 sätestatud kohustusi ning tagama, et toetuse abil soetatud materiaalse vara asendamisel sama funktsiooni täitva materiaalse varaga säilib toetuse saaja majandustegevus selle vara abil vähemalt kolme aasta jooksul lõppmakse tegemisest arvates. Toetuse saaja peab täitma ühendmääruse §-des 10 ja 11 sätestatud kohustusi ning tagama, et toetuse abil soetatud materiaalse vara asendamisel sama funktsiooni täitva materiaalse varaga säilib toetuse saaja majandustegevus selle vara abil vähemalt kolme aasta jooksul lõppmakse tegemisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1056799_Par_22 (redaktsioon 1056799)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056799",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056799",
      "estleg:sourceAct": "Ida-Virumaa väike- ja keskmise suurusega ettevõtjate investeeringute toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1056799 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056799_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056799_Par_23_v1056799",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056799_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusüksusel on õigus: 1 1) teha kuludokumentide auditit ja järelevalvetoiminguid; 2 2) kontrollida toetuse ning omafinantseeringu kasutamist; 3 3) nõuda taotluses sisaldunud projekti kestuse, tegevuste, eesmärkide ja kulude kohta täiendavate andmete ja dokumentide esitamist; 4 4) peatada toetuse maksed kuni tagasinõutava summa lõpliku tagasimaksmiseni; 5 5) peatada või lõpetada toetuse maksmine ning nõuda toetuse osalist või täielikku tagastamist, kui toetuse saaja rikub määruses sätestatud tingimusi või kaldub muul viisil kõrvale taotluses või taotluse rahuldamise otsuses sätestatust; 6 6) keelduda toetuse maksmisest, kui toetuse saaja majanduslik olukord on selliselt halvenenud, et toetuse kasutamine või projekti elluviimine on ohustatud. Rakendusüksusel on õigus: teha kuludokumentide auditit ja järelevalvetoiminguid; kontrollida toetuse ning omafinantseeringu kasutamist; nõuda taotluses sisaldunud projekti kestuse, tegevuste, eesmärkide ja kulude kohta täiendavate andmete ja dokumentide esitamist; peatada toetuse maksed kuni tagasinõutava summa lõpliku tagasimaksmiseni; peatada või lõpetada toetuse maksmine ning nõuda toetuse osalist või täielikku tagastamist, kui toetuse saaja rikub määruses sätestatud tingimusi või kaldub muul viisil kõrvale taotluses või taotluse rahuldamise otsuses sätestatust; keelduda toetuse maksmisest, kui toetuse saaja majanduslik olukord on selliselt halvenenud, et toetuse kasutamine või projekti elluviimine on ohustatud. 2 (2) Rakendusüksus kohustub: 1 1) tegema taotlus- ja aruandevormid ning juhendmaterjalid taotlejale ja toetuse saajale oma veebilehel kättesaadavaks; 2 2) teavitama toetuse saajat viivitamata toetuse kasutamist reguleerivates dokumentides tehtud olulistest muudatustest; 3 3) edastama taotluse kohta tehtud otsused taotlejale viivitamata pärast otsuse tegemist; 4 4) pärast toetuse rahuldamise otsuse tegemist avaldama Riigi Tugiteenuste Keskuse veebilehel toetuse saaja nime, toetust saava projekti nime, toetuse summa, projekti kogumahu, projekti eesmärgi ja kestuse; 5 5) mitte avaldama taotluse menetlemise käigus saadud teavet ega dokumente, välja arvatud punkti 4 kohaselt avaldamisele kuuluv teave; 6 6) säilitama toetuse andmisega seotud dokumente kümme aastat alates viimasest taotluse rahuldamise otsuse tegemisest. Rakendusüksus kohustub: tegema taotlus- ja aruandevormid ning juhendmaterjalid taotlejale ja toetuse saajale oma veebilehel kättesaadavaks; teavitama toetuse saajat viivitamata toetuse kasutamist reguleerivates dokumentides tehtud olulistest muudatustest; edastama taotluse kohta tehtud otsused taotlejale viivitamata pärast otsuse tegemist; pärast toetuse rahuldamise otsuse tegemist avaldama Riigi Tugiteenuste Keskuse veebilehel toetuse saaja nime, toetust saava projekti nime, toetuse summa, projekti kogumahu, projekti eesmärgi ja kestuse; mitte avaldama taotluse menetlemise käigus saadud teavet ega dokumente, välja arvatud punkti 4 kohaselt avaldamisele kuuluv teave; säilitama toetuse andmisega seotud dokumente kümme aastat alates viimasest taotluse rahuldamise otsuse tegemisest.",
      "rdfs:label": {
        "@value": "Reg_1056799_Par_23 (redaktsioon 1056799)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056799",
