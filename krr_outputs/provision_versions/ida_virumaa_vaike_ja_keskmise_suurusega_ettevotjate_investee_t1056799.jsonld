    {
      "@id": "estleg:Reg_1056799_Par_5_v1056799",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056799_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusasutus on Majandus- ja Kommunikatsiooniministeerium. Rakendusasutus on Majandus- ja Kommunikatsiooniministeerium. 2 (2) Rakendusüksus on Ettevõtluse ja Innovatsiooni Sihtasutus. Rakendusüksus on Ettevõtluse ja Innovatsiooni Sihtasutus.",
      "rdfs:label": {
        "@value": "Reg_1056799_Par_5 (redaktsioon 1056799)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056799",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056799",
      "estleg:sourceAct": "Ida-Virumaa väike- ja keskmise suurusega ettevõtjate investeeringute toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1056799 § 5",
