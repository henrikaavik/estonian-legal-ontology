      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056799_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlemine toimub jooksvalt. Taotlemine toimub jooksvalt. 2 (2) Hetkest, mil menetluses olevate taotlustega, mille suhtes ei ole veel rahuldamise või rahuldamata jätmise otsust tehtud, taotletav toetuste summa võrdsustub rahastamise eelarve vaba jäägiga, peatab rakendusüksus taotluste vastuvõtmise ja menetluses olevaid taotlusi menetletakse nende esitamise järjekorras. Hetkest, mil menetluses olevate taotlustega, mille suhtes ei ole veel rahuldamise või rahuldamata jätmise otsust tehtud, taotletav toetuste summa võrdsustub rahastamise eelarve vaba jäägiga, peatab rakendusüksus taotluste vastuvõtmise ja menetluses olevaid taotlusi menetletakse nende esitamise järjekorras.",
      "rdfs:label": {
