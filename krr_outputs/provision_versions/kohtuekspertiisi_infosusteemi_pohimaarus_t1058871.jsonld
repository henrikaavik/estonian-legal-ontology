      }
    },
    {
      "@id": "estleg:Reg_1058871_Par_20_v1058871",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058871_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui § 11 lõikes 3 nimetatud dokument digiteeritakse, võib paberdokumendi hävitada, kui õigusaktides ei ole sätestatud teisiti. Kui paberdokumenti ei hävitata, säilitatakse seda sama kaua kui digiteeritud ja infosüsteemi kantud dokumenti. Kui § 11 lõikes 3 nimetatud dokument digiteeritakse, võib paberdokumendi hävitada, kui õigusaktides ei ole sätestatud teisiti. Kui paberdokumenti ei hävitata, säilitatakse seda sama kaua kui digiteeritud ja infosüsteemi kantud dokumenti.",
      "rdfs:label": {
        "@value": "Reg_1058871_Par_20 (redaktsioon 1058871)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058871",
