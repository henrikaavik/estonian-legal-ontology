      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Perekonnaseisuasutusele esitatavate avalduste, paberil tehtavate perekonnaseisukannete ja perekonnasündmuse kohta väljastatavate tõendite vormid, abieluvõimetõendile kantavad andmed ning võõrkeelses tõendis kasutatavate keelte loetelu (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Perekonnaseisuasutusele esitatavate avalduste, paberil tehtavate perekonnaseisukannete ja perekonnasündmuse kohta väljastatavate tõendite vormid, abieluvõimetõendile kantavad andmed ning võõrkeelses tõendis kasutatavate keelte loetelu"
    },
    {
      "@id": "estleg:Reg_343393_Par_1_v343393",
      "@type": [
