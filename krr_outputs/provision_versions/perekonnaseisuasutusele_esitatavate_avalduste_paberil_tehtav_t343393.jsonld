      "estleg:sourceAct": "Perekonnaseisuasutusele esitatavate avalduste, paberil tehtavate perekonnaseisukannete ja perekonnasündmuse kohta väljastatavate tõendite vormid, abieluvõimetõendile kantavad andmed ning võõrkeelses tõendis kasutatavate keelte loetelu",
      "estleg:provisionRef": "Reg_343393 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_343393_Map"
      }
    },
