    {
      "@id": "estleg:Reg_1029636_Par_14_v1029636",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029636_Par_14"
