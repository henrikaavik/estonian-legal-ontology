      "estleg:provisionRef": "Reg_1029636 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029636_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029636_Par_20_v1029636",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029636_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 27. oktoobri 1998. a määrus nr 243 „Hiiumaa laidude maastikukaitseala kaitse-eeskirja ja välispiiri kirjelduse kinnitamine” tunnistatakse kehtetuks. Vabariigi Valitsuse 27. oktoobri 1998. a määrus nr 243 „Hiiumaa laidude maastikukaitseala kaitse-eeskirja ja välispiiri kirjelduse kinnitamine” tunnistatakse kehtetuks.",
      "rdfs:label": {
