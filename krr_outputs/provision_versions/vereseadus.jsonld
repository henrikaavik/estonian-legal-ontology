    {
      "@id": "estleg:VereS_Par_26_v860567",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VereS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 24 ja 25 nimetatud väärtegude puhul kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 82, 480; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40; 46, 329; 54, 387; 56, 401; 88, 600) üldosa ja väärteomenetluse seadustikku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590; 2004, 46, 329; 54, 387 ja 390; 56, 403; RT III 2004, 9, 96). (2) Käesoleva seaduse §-s 24 nimetatud väärteo kohtuväline menetleja on Sotsiaalministeerium. (3) Käesoleva seaduse §-s 25 nimetatud väärteo kohtuvälised menetlejad on Ravimiamet ja Tervishoiuamet.",
      "rdfs:label": {
        "@value": "VereS_Par_26 (redaktsioon 860567)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860567",
