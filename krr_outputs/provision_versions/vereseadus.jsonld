      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2005. aasta 1. mail. (2) Käesoleva seaduse § -d 15 ja 24 jõustuvad 2008. aasta 1. jaanuaril.",
      "rdfs:label": {
