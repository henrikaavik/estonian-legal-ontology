      "estleg:versionRedactionId": "112072014154"
    },
    {
      "@id": "estleg:VereS_Par_27_v860567",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VereS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalministeerium peab Euroopa Komisjoni teavitama: vabatahtlikku tasuta doonorlust edendavatest meetmetest iga kolme aasta järel käesoleva seaduse jõustumisest arvates; vere käitlemisega seotud meetmetest, sealhulgas järelevalvemeetmetest 2006. aasta 31. detsembriks ja edaspidi iga kolme aasta järel.",
      "rdfs:label": {
        "@value": "VereS_Par_27 (redaktsioon 860567)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860567"
    },
    {
      "@id": "estleg:VereS_Par_28_v860567",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VereS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Verekeskused ja verekabinetid peavad viima vere käitlemise vastavusse käesoleva seaduse § 8 lõike 4 alusel sätestatud nõuetega hiljemalt 2006. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "VereS_Par_28 (redaktsioon 860567)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860567"
    },
    {
      "@id": "estleg:VereS_Par_29_v860567",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VereS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meditsiiniseadme seaduses (RT I 2004, 75, 520) tehakse järgmised muudatused: paragrahvi 2 täiendatakse lõikega 1 1 järgmises sõnastuses: «(1 1 ) Meditsiiniseadmes kasutatavatele inimese verest valmistatud preparaatidele kohaldatakse ravimiseadust (RT I 2005, 2, 4) vereseadusest (RT I 2005, 13, 63) tulenevate erisustega.»; paragrahvi 21 lõige 4 muudetakse ja sõnastatakse järgmiselt: «(4) Sotsiaalminister kehtestab määrusega nõuded meditsiiniseadme kliinilise uuringu tegemisele.»; paragrahvi 34 lõike 6 preambulis asendatakse sõnad «meditsiiniseadme ja tellimusmeditsiiniseadme» sõnadega «meditsiiniseadme, tellimusmeditsiiniseadme ja toimivuse hindamise meditsiiniseadme».",
      "rdfs:label": {
        "@value": "VereS_Par_29 (redaktsioon 860567)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860567"
    },
    {
      "@id": "estleg:VereS_Par_3_v860567",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VereS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vere käitlemine on vere kogumine ning verekomponentide valmistamine, uurimine, säilitamine, väljastamine, kasutamine ja müük.",
      "rdfs:label": {
        "@value": "VereS_Par_3 (redaktsioon 860567)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860567"
    },
    {
      "@id": "estleg:VereS_Par_32_v860567",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VereS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravimiseaduses (RT I 2005, 2, 4) tehakse järgmised muudatused: paragrahvi 9 lõike 3 esimene lause muudetakse ja sõnastatakse järgmiselt: «Verepreparaat on verest valmistatud või toodetud ning nõuetekohaselt pakendatud ja märgistatud ravim, mis sisaldab üht või mitut vere koostisosa.»; paragrahvi 14 täiendatakse lõikega 4 järgmises sõnastuses: «(4) Verepreparaatidele kohaldatakse käesolevat seadust niivõrd, kuivõrd vereseaduses (RT I 2005, 13, 63) või selle alusel kehtestatud õigusaktides ei ole reguleeritud teisiti.»",
      "rdfs:label": {
        "@value": "VereS_Par_32 (redaktsioon 860567)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860567",
      "estleg:supersededByVersion": {
        "@id": "estleg:VereS_Par_32_v13319847"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VereS_Par_32_v13319847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VereS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "VereS_Par_32 (redaktsioon 13319847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13319847"
    },
    {
      "@id": "estleg:VereS_Par_33_v860567",
      "@type": [
        "owl:NamedIndividual",
