      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Patsiendi raviks sobivad doonoriverepreparaadid määratakse kindlaks patsiendi vere ja doonori vere immunohematoloogiliste uuringutega.",
