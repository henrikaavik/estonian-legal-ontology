      ],
      "estleg:versionOf": {
        "@id": "estleg:VereS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2005. aasta 1. mail. (2) Käesoleva seaduse §-d 15 ja 24 jõustuvad 2008. aasta 1. jaanuaril. 1 Euroopa Parlamendi ja EL Nõukogu direktiiv 2002/98/EÜ, millega kehtestatakse inimvere ja verekomponentide kogumise, uurimise, töötlemise, säilitamise ja jaotamise kvaliteedi- ja ohutusnõuded ning muudetakse direktiivi 2001/83/EÜ (EÜT L 033, 08.02.2003, lk 30–40); Euroopa Komisjoni direktiiv 2003/94/EÜ, millega kehtestatakse inimestele mõeldud ravimite ning inimestele mõeldud uuritavate ravimite hea tootmistava põhimõtted ja suunised (EÜT L 262, 14.10.2003, lk 22–26); Euroopa Komisjoni direktiiv 2004/33/EÜ, millega rakendatakse Euroopa Parlamendi ja EL Nõukogu direktiivi 2002/98/EÜ seoses teatavate tehniliste nõuetega vere ja verekomponentide osas (EÜT L 091, 30.03.2004, lk 25–39).",
      "rdfs:label": {
        "@value": "VereS_Par_33 (redaktsioon 860567)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860567",
