      "estleg:versionValidFrom": {
        "@value": "2018-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) inimeste viibimine Torgu soo sihtkaitsevööndis 15. veebruarist 31. juulini, välja arvatud kaitseala valitseja nõusolekul, järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel ning kaitseala valitseja nõusolekul teostataval teadustegevusel. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; inimeste viibimine Torgu soo sihtkaitsevööndis 15. veebruarist 31. juulini, välja arvatud kaitseala valitseja nõusolekul, järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel ning kaitseala valitseja nõusolekul teostataval teadustegevusel.",
      "rdfs:label": {
        "@value": "Reg_1042653_Par_12 (redaktsioon 1042653)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042653",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042653",
      "estleg:sourceAct": "Tuhu looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1042653 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042653_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042653_Par_13_v1042653",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
