      "estleg:provisionRef": "Reg_1042653 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042653_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042653_Par_12_v1042653",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042653_Par_12"
