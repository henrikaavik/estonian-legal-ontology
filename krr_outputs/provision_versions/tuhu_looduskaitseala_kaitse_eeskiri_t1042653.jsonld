    {
      "@id": "estleg:Reg_1042653_Par_16_v1042653",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042653_Par_16"
