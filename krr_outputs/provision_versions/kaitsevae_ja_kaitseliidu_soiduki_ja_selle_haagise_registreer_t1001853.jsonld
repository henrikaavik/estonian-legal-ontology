      },
      "estleg:versionText": "Sõiduki andmed registreerib, registriandmeid muudab ja andmed kustutab registrist (edaspidi koos registritoiming) Kaitsevägi. Sõiduki andmed registreerib, registriandmeid muudab ja andmed kustutab registrist (edaspidi koos registritoiming) Kaitsevägi.",
      "rdfs:label": {
        "@value": "Reg_1001853_Par_2 (redaktsioon 1001853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001853",
      "estleg:sourceAct": "Kaitseväe ja Kaitseliidu sõiduki ja selle haagise registreerimise kord",
