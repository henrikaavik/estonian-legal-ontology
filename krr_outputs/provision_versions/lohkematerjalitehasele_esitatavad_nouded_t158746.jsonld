    {
      "@id": "estleg:Reg_158746_Par_10_v158746",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158746_Par_10"
