      }
    },
    {
      "@id": "estleg:Reg_158746_Par_15_v158746",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158746_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Töökoht ja sisseseade peavad ohtlikus ruumis paiknema selliselt, et töötaja võiks töökohalt ja ruumist takistamatult lahkuda. Töökoht ja sisseseade peavad ohtlikus ruumis paiknema selliselt, et töötaja võiks töökohalt ja ruumist takistamatult lahkuda. 2 (2) Töökoht, kus töötaja on eriti ohustatud tulekahjust või plahvatusest, peab paiknema kaitseruumis. Eriti ohtlike töökohtade loetelu määratakse ohutusjuhendiga. Töökoht, kus töötaja on eriti ohustatud tulekahjust või plahvatusest, peab paiknema kaitseruumis. Eriti ohtlike töökohtade loetelu määratakse ohutusjuhendiga. 3 (3) Kui ohtlikus ruumis on projekteeritust rohkem töökohti ja see on ette nähtud ohutusjuhendis, peab ettevõtja tagama kaitseabinõud kõikidele töökohtadele. Kui ohtlikus ruumis on projekteeritust rohkem töökohti ja see on ette nähtud ohutusjuhendis, peab ettevõtja tagama kaitseabinõud kõikidele töökohtadele.",
      "rdfs:label": {
        "@value": "Reg_158746_Par_15 (redaktsioon 158746)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158746",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158746",
      "estleg:sourceAct": "Lõhkematerjalitehasele esitatavad nõuded",
      "estleg:provisionRef": "Reg_158746 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158746_Map"
      }
    },
    {
      "@id": "estleg:Reg_158746_Par_16_v158746",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158746_Par_16"
