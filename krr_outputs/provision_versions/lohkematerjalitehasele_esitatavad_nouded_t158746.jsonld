    {
      "@id": "estleg:Reg_158746_Par_17_v158746",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158746_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ohtlikus tootmisüksuses peab ohutute ehitiste arv, kus pidevalt viibib töötajaid, olema vajalikul määral piiratud. Ohtlikus tootmisüksuses peab ohutute ehitiste arv, kus pidevalt viibib töötajaid, olema vajalikul määral piiratud. 2 (2) Ohutud ehitised peavad olema sellised, et nende põleng ohtlikele ehitistele üle ei kanduks. Ohutud ehitised peavad olema sellised, et nende põleng ohtlikele ehitistele üle ei kanduks. 3 (3) Ohutute ehitiste aknad ei või paikneda võimaliku lööklaine levikusuunas ning nende aknad ei tohi purunemisel anda ohtlikke kilde. Ohutute ehitiste aknad ei või paikneda võimaliku lööklaine levikusuunas ning nende aknad ei tohi purunemisel anda ohtlikke kilde.",
      "rdfs:label": {
