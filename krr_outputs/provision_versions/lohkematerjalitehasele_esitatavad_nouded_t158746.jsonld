        "@language": "et"
      },
      "estleg:versionRedactionId": "158746",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158746",
      "estleg:sourceAct": "Lõhkematerjalitehasele esitatavad nõuded",
      "estleg:provisionRef": "Reg_158746 § 17",
