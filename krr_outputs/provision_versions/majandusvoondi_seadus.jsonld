      }
    },
    {
      "@id": "estleg:MVS_Par_18_v24387",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MVS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandusvööndi sisepiiri arvestamise aluse, territoriaalmere lähtejoone koordinaadid, kehtestab Vabariigi Valitsuse ettepanekul Riigikogu. Riigikogu aseesimees E. Savisaar Õiend Lisatud avaldamisandmed.",
      "rdfs:label": {
        "@value": "MVS_Par_18 (redaktsioon 24387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24387",
      "estleg:supersededByVersion": {
        "@id": "estleg:MVS_Par_18_v185992"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24387",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:MVS_Map_2026"
      }
    },
    {
      "@id": "estleg:MVS_Par_18_v185992",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MVS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandusvööndi sisepiiri arvestamise aluse, territoriaalmere lähtejoone koordinaadid, kehtestab Vabariigi Valitsuse ettepanekul Riigikogu.",
      "rdfs:label": {
        "@value": "MVS_Par_18 (redaktsioon 185992)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "185992",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/185992",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:MVS_Map_2026"
      }
    },
    {
      "@id": "estleg:MVS_Par_2_v24387",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MVS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi suveräänseteks õigusteks majandusvööndis on merepõhja katvas vees, merepõhjas ja selle all maapõues asuvate elus ja eluta loodusvarade uurimine, hõlvamine, säilitamine ja haldamine ning muu tegevus majandusvööndi uurimisel ja kasutamisel. (2) Eesti Vabariigi jurisdiktsioonile majandusvööndis on allutatud: teaduslikud mereuuringud; merekeskkonna kaitse; tehissaarte rajamine ja seadmestiku paigaldamine; muu majandustegevus. (3) Merepõhja ja selle all oleva maapõue loodusvarade kasutamist ja kaitset reguleerib mandrilava seadus.",
      "rdfs:label": {
        "@value": "MVS_Par_2 (redaktsioon 24387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24387",
      "estleg:supersededByVersion": {
        "@id": "estleg:MVS_Par_2_v185992"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24387",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:MVS_Map_2026"
      }
    },
    {
      "@id": "estleg:MVS_Par_2_v185992",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MVS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi suveräänseteks õigusteks majandusvööndis on merepõhja katvas vees, merepõhjas ja selle all maapõues asuvate elus ja eluta loodusvarade uurimine, hõlvamine, säilitamine ja haldamine ning muu tegevus majandusvööndi uurimisel ja kasutamisel. (2) Eesti Vabariigi jurisdiktsioonile majandusvööndis on allutatud: teaduslikud mereuuringud; merekeskkonna kaitse; tehissaarte rajamine ja seadmestiku paigaldamine; muu majandustegevus. (3) Merepõhja ja selle all oleva maapõue loodusvarade kasutamist ja kaitset reguleerib mandrilava seadus. (4) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "MVS_Par_2 (redaktsioon 185992)",
        "@language": "et"
      },
