  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_majandusvoondi_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Majandusvööndi seadus (44 versiooni)",
        "@language": "et"
      },
      "dc:source": "Majandusvööndi seadus"
    },
    {
      "@id": "estleg:MVS_Par_1_v24387",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MVS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandusvöönd on väljaspool territoriaalmerd asuv ja viimasega külgnev mereala, kus riik teostab oma suveräänseid õigusi ja jurisdiktsiooni vastavuses rahvusvahelise mereõiguse üldtunnustatud normidega, Eesti Vabariigi poolt sõlmitud riikidevaheliste lepingutega ning käesoleva seadusega.",
      "rdfs:label": {
        "@value": "MVS_Par_1 (redaktsioon 24387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24387",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24387",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:MVS_Map_2026"
      }
    },
    {
      "@id": "estleg:MVS_Par_10_v24387",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MVS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui majandusvööndis tehtav uuring satub vastuollu käesoleva seadusega või Eesti Vabariigi poolt sõlmitud ratifitseeritud lepinguga, võidakse uuring pädeva riigiasutuse poolt peatada. Seda lubatakse jätkata alles pärast vastuolu kõrvaldamist. (2) Mereuuringud, mida majandusvööndis tehakse ilma pädeva riigiasutuse nõusolekuta või erinevalt käesoleva seaduse paragrahvis 8 lõike 2 punktis 1 käsitletud küsimuste kohta antud teabest või uuringute avaldatud kavast oluliselt kõrvale kaldudes, keelatakse ja tuleb viivitamatult lõpetada.",
      "rdfs:label": {
        "@value": "MVS_Par_10 (redaktsioon 24387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24387",
      "estleg:supersededByVersion": {
        "@id": "estleg:MVS_Par_10_v185992"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24387",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:MVS_Map_2026"
      }
    },
    {
      "@id": "estleg:MVS_Par_10_v185992",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MVS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui majandusvööndis tehtav uuring satub vastuollu käesoleva seadusega või Eesti Vabariigi poolt sõlmitud ratifitseeritud lepinguga, võidakse uuring pädeva riigiasutuse poolt peatada. Seda lubatakse jätkata alles pärast vastuolu kõrvaldamist. (2) Kui mereuuringud tehakse majandusvööndis ilma pädeva riigiasutuse nõusolekuta või erinevalt käesoleva seaduse § 8 lõike 2 punktis 1 käsitletud küsimuste kohta antud teabest või uuringute avaldatud kavast oluliselt kõrvale kaldudes, peab uurimisloa viivitamatult kehtetuks tunnistama.",
      "rdfs:label": {
        "@value": "MVS_Par_10 (redaktsioon 185992)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "185992",
      "estleg:supersededByVersion": {
        "@id": "estleg:MVS_Par_10_v119032019101"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/185992",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:MVS_Map_2026"
      }
    },
    {
      "@id": "estleg:MVS_Par_10_v119032019101",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MVS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MVS_Par_10 (redaktsioon 119032019101)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019101",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019101",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 10",
