      }
    },
    {
      "@id": "estleg:MVS_Par_9_v24387",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MVS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Majandusvööndis on mereuuringu tegija kohustatud: võimaldama Eesti esindajatel viibida uurimislaevadel ja tehisrajatiste pardal ning soovi korral uurimistöödest osa võtta; esitama pädevate riigiasutuste taotlusel nende esindajatele uuringutega saadud andmed, näidised, tulemused ja hinnangud ning võimaldama neile soovi korral vaba ligipääsu kõikidele uurimismaterjalidele ning seadmetele; informeerima pädevaid riigiasutusi viivitamatult igast olulisest muudatusest uurimisprogrammis; eemaldama pärast uurimistööde lõpetamist pädeva riigiasutuse poolt antud tähtaja jooksul merest kõik oma rajatised ja seadmed, kui ei lepita kokku teisiti.",
      "rdfs:label": {
        "@value": "MVS_Par_9 (redaktsioon 24387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24387",
      "estleg:supersededByVersion": {
        "@id": "estleg:MVS_Par_9_v119032019101"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24387",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:MVS_Map_2026"
      }
    },
