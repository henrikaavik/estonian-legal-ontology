      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MVS_Par_8 (redaktsioon 119032019101)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019101",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019101",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 8",
      "estleg:partOfAct": {
