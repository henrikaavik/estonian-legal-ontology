      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse sätetes nimetatud pädevad riigiasutused ja majandusvööndi kaitsmise korra määrab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "MVS_Par_17 (redaktsioon 24387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24387",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24387",
      "estleg:sourceAct": "Majandusvööndi seadus",
      "estleg:provisionRef": "MVS § 17",
