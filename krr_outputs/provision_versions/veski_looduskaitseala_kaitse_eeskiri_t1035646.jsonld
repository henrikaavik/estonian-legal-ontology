      }
    },
    {
      "@id": "estleg:Reg_1035646_Par_11_v1035646",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035646_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-08-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1035646_Par_11 (redaktsioon 1035646)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035646",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035646",
      "estleg:sourceAct": "Veski looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1035646 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035646_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035646_Par_2_v1035646",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035646_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-08-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Põlva maakonnas Kõlleste vallas Prangli ja Veski külas. Kaitseala asub Põlva maakonnas Kõlleste vallas Prangli ja Veski külas. 2 (2) Kaitseala välispiir ja vööndi piir on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndi piir on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1035646_Par_2 (redaktsioon 1035646)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035646",
