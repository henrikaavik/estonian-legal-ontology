        "@id": "estleg:Reg_1035646_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035646_Par_10_v1035646",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035646_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-08-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse kehtestamise menetlus viidi läbi keskkonnaministri 12. novembri 2015. a käskkirjaga nr 1009 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Määruse kehtestamise menetlus viidi läbi keskkonnaministri 12. novembri 2015. a käskkirjaga nr 1009 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1035646_Par_10 (redaktsioon 1035646)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035646",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035646",
