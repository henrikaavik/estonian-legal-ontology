      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tsiviil- ja kaubandusasjades välisriigis tõendite kogumise konventsiooniga ühinemise seadus (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tsiviil- ja kaubandusasjades välisriigis tõendite kogumise konventsiooniga ühinemise seadus"
    },
    {
      "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_1_v25035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud , mis on alla kirjutatud 1970. aasta 18. märtsil Haagis.",
      "rdfs:label": {
        "@value": "tsiviil_ja_kaubandusasjades_valisriigis__Par_1 (redaktsioon 25035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25035"
    },
    {
      "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_2_v25035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühinemisel määrata artikli 2 alusel keskasutuseks Justiitsministeerium.",
      "rdfs:label": {
        "@value": "tsiviil_ja_kaubandusasjades_valisriigis__Par_2 (redaktsioon 25035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25035"
    },
    {
      "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_3_v25035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühinemisel deklareerida:1) artikli 8 alusel, et taotleva riigi kohtunikel on õigus osaleda protsessitoimingul Justiitsministeeriumi eelneval nõusolekul;2) artikli 11 alusel, et isik võib keelduda tõendi võtmises või protsessitoimingus osalemast, kui tal on selleks õigus või kohustus tema koduriigi seaduste kohaselt.",
      "rdfs:label": {
        "@value": "tsiviil_ja_kaubandusasjades_valisriigis__Par_3 (redaktsioon 25035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25035"
    },
    {
      "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_4_v25035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühinemisel deklareerida artikli 23 alusel, et Eesti Vabariik täidab nõudekirja, milles soovitakse dokumendi või selle koopia esitamist, kui see vastab järgmistele nõuetele:1) menetlus on algatatud;2) dokumendid on arukalt identifitseeritud kuupäevade, sisu või muu informatsiooni järgi;3) nõudekirjas on näidatud asjaolud, mis annavad alust arvata, et dokumendid on isiku omanduses, valduses või isikule teada.",
      "rdfs:label": {
        "@value": "tsiviil_ja_kaubandusasjades_valisriigis__Par_4 (redaktsioon 25035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25035"
    },
    {
      "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_5_v25035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:tsiviil_ja_kaubandusasjades_valisriigis_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühinemisel teatada Hollandi Kuningriigi Välisministeeriumile, et artiklite 16 ja 17 alusel on luba andma määratud Justiitsministeerium.",
      "rdfs:label": {
        "@value": "tsiviil_ja_kaubandusasjades_valisriigis__Par_5 (redaktsioon 25035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25035"
    }
  ]
}
