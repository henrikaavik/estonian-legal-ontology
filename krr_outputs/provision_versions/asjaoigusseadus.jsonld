      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa6_Par_249_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
