    },
    {
      "@id": "estleg:AOS_Osa3_Par_94_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omandi üleandmisel võib asi võõrandaja ja omandaja kokkuleppel jääda võõrandaja valdusse. Sel juhul loetakse omandajat kaudseks ja võõrandajat otseseks valdajaks.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_94 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_94_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_94_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omandi üleandmisel võib asi võõrandaja ja omandaja kokkuleppel jääda võõrandaja valdusse. Sel juhul loetakse omandajat kaudseks ja võõrandajat otseseks valdajaks. [Paragrahvi 94 sõnastus alates 1. 07. 2003]",
