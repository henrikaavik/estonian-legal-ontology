    {
      "@id": "estleg:AOS_Osa8_Par_313_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa8_Par_313"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registerpandi võib seada registreeritud patendile, kaubamärgile, tööstusnäidisele, kasulikule mudelile ja muudele registreeritud intellektuaalse omandi vormidele. (2) Patendi ja kaubamärgi pantimise registreerib vastava registri pidaja.",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_313 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
