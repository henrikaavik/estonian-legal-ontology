        "@type": "xsd:date"
      },
      "estleg:versionText": "Valdus on tegelik võim asja üle, samuti reaalservituudi teostamine.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_32 (redaktsioon 22252)",
