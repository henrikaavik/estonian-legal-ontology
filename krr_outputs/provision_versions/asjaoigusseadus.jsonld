        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_142_v108072014007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_142 (redaktsioon 108072014007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072014007"
    },
    {
      "@id": "estleg:AOS_Osa3_Par_143_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_143"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnisasja omanikul ei ole õigust keelata gaasi, suitsu, auru, lõhna, tahma, soojuse, müra, põrutuste ja muude seesuguste teiselt kinnisasjalt tulevate mõjutuste levimist oma kinnisasjale, kui see ei kahjusta oluliselt tema kinnisasja kasutamist ega ole vastuolus keskkonnakaitse nõuetega. Mõjutuste tahtlik suunamine naaberkinnisasjale on keelatud. (2) Kui käesoleva paragrahvi 1. lõikes nimetatud mõjutused kahjustavad oluliselt kinnisasja kasutamist, kuid mõjutuste kõrvaldamise kulud on suuremad tekkivast kahjust, on mõjutatava kinnisasja omanikul õigus nõuda mõjutuse põhjustanud kinnisasja omanikult hüvitust.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_143 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_143_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_143_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_143"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnisasja omanikul ei ole õigust keelata gaasi, suitsu, auru, lõhna, tahma, soojuse, müra, põrutuste ja muude seesuguste teiselt kinnisasjalt tulevate mõjutuste levimist oma kinnisasjale, kui see ei kahjusta oluliselt tema kinnisasja kasutamist ega ole vastuolus keskkonnakaitse nõuetega. Mõjutuste tahtlik suunamine naaberkinnisasjale on keelatud. [Lõike 2 sõnastus kuni 30. 06. 2003] (2) Kui käesoleva paragrahvi 1. lõikes nimetatud mõjutused kahjustavad oluliselt kinnisasja kasutamist, kuid mõjutuste kõrvaldamise kulud on suuremad tekkivast kahjust, on mõjutatava kinnisasja omanikul õigus nõuda mõjutuse põhjustanud kinnisasja omanikult hüvitust. [Lõike 2 sõnastus alates 1. 07. 2003] (2) Kui käesoleva paragrahvi 1. lõikes nimetatud mõjutused kahjustavad oluliselt kinnisasja kasutamist, kuid niisuguste mõjutuste kõrvaldamist ei saa mõjutajalt majanduslikult eeldada, on mõjutatava kinnisasja omanikul õigus nõuda mõjutuse põhjustanud kinnisasja omanikult mõistlikku hüvitist.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_143 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_143_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_143_v687259",
      "@type": [
        "owl:NamedIndividual",
