      }
    },
    {
      "@id": "estleg:AOS_Osa8_Par_325_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa8_Par_325"
      },
      "estleg:versionValidFrom": {
