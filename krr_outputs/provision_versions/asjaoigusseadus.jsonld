        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maakorralduse otstarbel, ehituslikel, tuleohutuse ja tervishoiu kaalutlusel, kultuurimälestiste ja keskkonnakaitseks ning muudeks ühiskondlikeks vajadusteks võib seadusega kehtestada täiendavaid kinnisomandi kitsendusi.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_169 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
