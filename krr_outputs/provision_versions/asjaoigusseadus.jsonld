    {
      "@id": "estleg:AOS_Osa2_Par_64_v13335197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_64"
      },
      "estleg:versionValidFrom": {
