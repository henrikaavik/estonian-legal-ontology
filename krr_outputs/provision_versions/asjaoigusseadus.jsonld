    {
      "@id": "estleg:AOS_Osa8_Par_363_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa8_Par_363"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hagi tagamiseks võib kohus seada haginõude ulatuses hüpoteegi, mis peab olema kinnistusraamatusse kantud kohtuliku hüpoteegina. (2) Kohtuliku hüpoteegiga on tagatud kohtuotsuse alusel rahuldatud nõue.",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_363 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa8_Par_363_v13107316"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa8_Par_363_v13107316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa8_Par_363"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hagi tagamiseks võib kohus seada haginõude ulatuses hüpoteegi, mis peab olema kinnistusraamatusse kantud kohtuliku hüpoteegina. (2) Kohtuliku hüpoteegiga on tagatud kohtulahendi alusel rahuldatud nõue. (3) Käesoleva paragrahvi lõigetes 1 ja 2 sätestatut kohaldatakse vastavalt muu seadusega selleks õigustatud ametiisiku määruse alusel kinnisasjale hüpoteegi seadmise korral.",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_363 (redaktsioon 13107316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13107316"
    },
