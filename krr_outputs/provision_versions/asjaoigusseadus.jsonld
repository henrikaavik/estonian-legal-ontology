        "@type": "xsd:date"
      },
      "estleg:versionText": "Vallasasjade pantimine pandimajas toimub käsipandi sätete kohaselt, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_296 (redaktsioon 22252)",
