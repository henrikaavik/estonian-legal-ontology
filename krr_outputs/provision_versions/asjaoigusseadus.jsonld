    },
    {
      "@id": "estleg:AOS_Osa3_Par_142_v751823",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilise isiku või eraõigusliku juriidilise isiku omandis oleval kinnisasjal, mis on omaniku poolt piiratud või tähistatud, ei või teised isikud omaniku loata viibida, kui seaduses ei ole sätestatud teisiti. (2) Füüsilise isiku või eraõigusliku juriidilise isiku omandis oleval piiramata ja tähistamata kinnisasjal ei või teised isikud omaniku loata viibida päikeseloojangust päikesetõusuni, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_142 (redaktsioon 751823)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "751823",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_142_v108072014007"
      },
      "estleg:versionValidTo": {
