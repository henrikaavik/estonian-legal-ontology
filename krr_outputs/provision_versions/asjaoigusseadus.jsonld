        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_231_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_231"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eraõiguslik reaalkoormatis tekib kinnistusraamatusse kandmisega. Kandes tuleb võimaluse korral määrata reaalkoormatise rahaline väärtus. (2) Reaalkoormatise omandamisele kohaldatakse kinnisasja omandamise kohta käivaid sätteid, kui seaduses ei ole sätestatud teisiti. (3) Avalik-õiguslik reaalkoormatis ei vaja tekkimiseks kinnistusraamatusse kandmist, kui seaduses ei ole sätestatud teisiti. (4) Kui seaduse kohaselt on avalik-õiguslikul juriidilisel isikul õigus nõuda reaalkoormatist, tekib see koormatis kinnistusraamatusse kandmisega. [Paragrahvi 231 sõnastus alates 1. 07. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_231 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_231_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_231_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_231"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatise seadmiseks sõlmitav asjaõigusleping peab olema notariaalselt tõestatud. (2) Reaalkoormatise seadmisel tuleb võimaluse korral määrata reaalkoormatise rahaline väärtus ja see kinnistusraamatusse kanda.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_231 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa5_Par_232_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_232"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reaalkoormatis lõpeb kande kustutamisega kinnistusraamatust.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_232 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_232_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_232_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_232"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_232 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_232_v12807782"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_232_v12807782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_232"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_232 (redaktsioon 12807782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12807782",
