      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maatüki piiril või sellest kahe meetri kaugusel asuvasse seina võib teha aknaid, kui seda õigust ei ole kitsendatud seadusega või kinnistusraamatu kandega.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_153 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_153_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_153_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_153"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maatüki piiril või sellest kahe meetri kaugusel asuvasse seina võib teha aknaid, kui seda õigust ei ole kitsendatud seadusega või kinnistusraamatu kandega. [Paragrahv 154 kehtetu alates 1. 07. 2003 -",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_153 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
