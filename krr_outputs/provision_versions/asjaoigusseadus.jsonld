      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_301 (redaktsioon 12807782)",
