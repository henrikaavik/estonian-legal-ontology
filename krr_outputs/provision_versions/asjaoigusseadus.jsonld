    },
    {
      "@id": "estleg:AOS_Osa1_Par_5_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa1_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asjaõigused on omand (omandiõigus) ja piiratud asjaõigused: servituudid, reaalkoormatised, hoonestusõigus, ostueesõigus ja pandiõigus. (2) Seaduses võib lisaks käesoleva paragrahvi 1. lõikes nimetatule sätestada ka muid asjaõigusi.",
      "rdfs:label": {
        "@value": "AOS_Osa1_Par_5 (redaktsioon 22252)",
        "@language": "et"
