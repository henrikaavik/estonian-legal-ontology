        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusraamatusse kantakse asjaõigused ja märked.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_62 (redaktsioon 22252)",
        "@language": "et"
