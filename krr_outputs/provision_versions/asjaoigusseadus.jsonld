    },
    {
      "@id": "estleg:AOS_Osa4_Par_210_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_210"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kasutusvaldus lõpeb kasutusvaldaja surmaga, kui seaduses ei ole sätestatud teisiti. (2) Kui seaduse või tehinguga on määratud kasutusvaldus ka kasutusvaldaja pärijale, tekib see pärija suhtes uuesti.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_210 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_210_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_210_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_210"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kasutusvaldus lõpeb kasutusvaldaja surmaga, kui seaduses ei ole sätestatud teisiti. [Lõige 11jõustub alates 1. 07. 2003 - (1<sup>1</sup>) Kui kasutusvaldus on seatud mitme isiku kasuks, suurenevad ühe kasutusvaldaja surma või lõppemise korral teiste kasutusvaldajate kasutusvalduse osad vastavalt nende osade suurusele, kui ei ole kokku lepitud teisiti. [Lõike 2 sõnastus kuni 30. 06. 2003] (2) Kui seaduse või tehinguga on määratud kasutusvaldus ka kasutusvaldaja pärijale, tekib see pärija suhtes uuesti. [Lõike 2 sõnastus alates 1. 07. 2003] (2) Kui seaduse või tehinguga on määratud, et kasutusvaldus läheb üle kasutusvaldaja pärijale, kehtib kasutusvaldus pärija suhtes edasi.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_210 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_210_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_210_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_210"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kasutusvaldus lõpeb kasutusvaldaja surmaga, kui seaduses ei ole sätestatud teisiti. (1<sup>1</sup>) Kui kasutusvaldus on seatud mitme isiku kasuks, suurenevad ühe kasutusvaldaja surma või lõppemise korral teiste kasutusvaldajate kasutusvalduse osad vastavalt nende osade suurusele, kui ei ole kokku lepitud teisiti. (2) Kui seaduse või tehinguga on määratud, et kasutusvaldus läheb üle kasutusvaldaja pärijale, kehtib kasutusvaldus pärija suhtes edasi.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_210 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
