    {
      "@id": "estleg:AOS_Osa3_Par_68_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Omand on isiku täielik õiguslik võim asja üle. Omanikul on õigus asja vallata, kasutada ja käsutada ning nõuda kõigilt teistelt isikutelt nende õiguste rikkumise vältimist ja rikkumise tagajärgede kõrvaldamist. (2) Omaniku õigused võivad olla kitsendatud ainult seaduse või teiste isikute õigustega. (3) Omand tekib ainult seaduses sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_68 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_68_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_68_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Omand on isiku täielik õiguslik võim asja üle. Omanikul on õigus asja vallata, kasutada ja käsutada ning nõuda kõigilt teistelt isikutelt nende õiguste rikkumise vältimist ja rikkumise tagajärgede kõrvaldamist. (2) Omaniku õigused võivad olla kitsendatud ainult seaduse või teiste isikute õigustega. (3) Omand tekib ainult seaduses sätestatud juhtudel. [Paragrahv 69 kehtetu alates 1. 07. 2003 -",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_68 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
