        "@type": "xsd:date"
      },
      "estleg:versionText": "Omandiõiguse tunnustamiseks piisab, kui omanik tõendab, et tema omand on tekkinud õiguslikul alusel. [Paragrahvi 82 sõnastus kuni 30. 06. 2003]",
      "rdfs:label": {
