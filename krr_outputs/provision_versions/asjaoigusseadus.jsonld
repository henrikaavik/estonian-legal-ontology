        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vallasasja võib pandiga koormata selliselt, et panditud asi jääb pantija valdusse ning pant registreeritakse seaduses sätestatud korras (registerpant).",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_297 (redaktsioon 22252)",
        "@language": "et"
      },
