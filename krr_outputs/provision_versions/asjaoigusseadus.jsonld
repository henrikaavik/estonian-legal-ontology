      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik, kes valdab asja reaalosa, võib selle osa valdust kaitsta §-des 40-48 sätestatud korras.",
