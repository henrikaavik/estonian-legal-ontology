      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_57_1_v117032023058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_57_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asjaõiguse kinnistusraamatusse kandmisel võib õiguse sisu täpsustamiseks viidata kinnistusraamatu kande tegemise aluseks olevatele dokumentidele ja andmetele, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_57_1 (redaktsioon 117032023058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023058"
    },
    {
      "@id": "estleg:AOS_Osa2_Par_58_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui asjaõiguse tekkimiseks on vajalik kinnistusraamatusse kandmine, kehtib õigus asjaõigusena, kui see on kinnistusraamatusse kantud. (2) Kande piirides võib asjaõiguse sisu täpsemalt tõendada dokumentide või muude tõenditega. (3) Kinnistusraamatusse kantud asjaõigusest tulenev nõue ei aegu, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_58 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa2_Par_58_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
