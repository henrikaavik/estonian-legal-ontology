    },
    {
      "@id": "estleg:AOS_Osa1_Par_6_v12807782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa1_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu – (2) Kõigil omanikel on võrdsed õigused, kui seaduses ei ole sätestatud teisiti. Juriidilise isiku vara ega juriidiline isik ei saa kuuluda teistele isikutele. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa1_Par_6 (redaktsioon 12807782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12807782",
