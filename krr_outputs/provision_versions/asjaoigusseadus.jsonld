      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa8_Par_350"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_350 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa8_Par_350_v12807782"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa8_Par_350_v12807782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
