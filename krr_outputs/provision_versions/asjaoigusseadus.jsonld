      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valdus läheb üle pärijale.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_38 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa2_Par_39_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
