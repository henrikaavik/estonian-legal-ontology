      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_222_v13335197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_222"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_222 (redaktsioon 13335197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335197"
    },
    {
      "@id": "estleg:AOS_Osa4_Par_223_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_223"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kasutusvalduse esemel lasuvad maksud ja võlaintressid tasub ning koormatised, majandamis- ja muud kulud kannab kasutusvaldaja vastavalt oma õiguste kestusele. (2) Kui maksud, koormatised või kulutused on sisse nõutud omanikult, on kasutusvaldaja kohustatud talle need samas ulatuses hüvitama.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_223 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa4_Par_224_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_224"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asja omanikul on õigus nõuda kasutusvaldajalt tagatist, kui kasutusvaldaja tegevusest ilmneb omaniku õiguste olulise rikkumise oht.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_224 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_224_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_224_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_224"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asja omanikul on õigus nõuda kasutusvaldajalt tagatist, kui kasutusvaldaja tegevusest ilmneb omaniku õiguste olulise rikkumise oht. ISIKLIK KASUTUSÕIGUS [Paragrahvi 225 sõnastus kuni 30. 06. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_224 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_224_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_224_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_224"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asja omanikul on õigus nõuda kasutusvaldajalt tagatist, kui kasutusvaldaja tegevusest ilmneb omaniku õiguste olulise rikkumise oht.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_224 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa4_Par_225_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isiklik kasutusõigus koormab kinnisasja selliselt, et isik, kelle kasuks see on seatud, on õigustatud kinnisasja teatud viisil kasutama või teostama kinnisasja suhtes teatud õigust, mis oma sisult vastab mõnele reaalservituudile.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_225 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_225_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_225_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isiklik kasutusõigus koormab kinnisasja selliselt, et isik, kelle kasuks see on seatud, on õigustatud kinnisasja teatud viisil kasutama või teostama kinnisasja suhtes teatud õigust, mis oma sisult vastab mõnele reaalservituudile. [Paragrahvi 225 sõnastus alates 1. 07. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_225 (redaktsioon 253333)",
        "@language": "et"
      },
