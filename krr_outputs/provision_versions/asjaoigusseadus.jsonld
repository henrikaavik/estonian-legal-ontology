        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_153_v122022019011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_153"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_153 (redaktsioon 122022019011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019011"
    },
    {
      "@id": "estleg:AOS_Osa3_Par_154_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_154"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omanik peab tagama, et tema ehitise katuselt ei voolaks vesi teise isiku kinnisasjale, kui ei ole kokku lepitud teisiti. Vee juhtimine katuselt avalikult kasutatavale teele on lubatud.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_154 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_154_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_154_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_154"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omanik peab tagama, et tema ehitise katuselt ei voolaks vesi teise isiku kinnisasjale, kui ei ole kokku lepitud teisiti. Vee juhtimine katuselt avalikult kasutatavale teele on lubatud. Teed ning tehnovõrgud ja -rajatised",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_154 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_154_v13335197"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_154_v13335197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_154"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_154 (redaktsioon 13335197)",
