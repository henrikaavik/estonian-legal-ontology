      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_32_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valdus on tegelik võim asja üle, samuti reaalservituudi teostamine. [Paragrahvi 32 sõnastus alates 1. 07. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_32 (redaktsioon 253333)",
