        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_170_v122022019011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
