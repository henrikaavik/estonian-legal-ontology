    {
      "@id": "estleg:AOS_Osa7_Par_256_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa7_Par_256"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnisasja võib koormata selliselt, et isikul, kelle kasuks ostueesõigus on seatud, on õigus kinnisasja võõrandamisel asuda omandaja asemele. (2) Ostueesõiguse võib seada teatud isiku või teise kinnisasja igakordse omaniku kasuks. (3) Kinnisasja mõttelist osa võib ostueesõigusega koormata ainult siis, kui see on kaasomaniku osa.",
      "rdfs:label": {
        "@value": "AOS_Osa7_Par_256 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa7_Par_256_v175981"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa7_Par_256_v175981",
