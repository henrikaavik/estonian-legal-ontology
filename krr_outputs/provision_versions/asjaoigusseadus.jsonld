      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa8_Par_363_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohtulik hüpoteek seatakse omaniku mitmele kinnisasjale, jagatakse tagatav nõue kinnisasjade vahel võlausaldaja poolt määratud osades.",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_363_1 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa8_Par_364_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa8_Par_364"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Muus osas kohaldatakse kohtulikule hüpoteegile hüpoteegi kohta käivaid sätteid.",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_364 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
