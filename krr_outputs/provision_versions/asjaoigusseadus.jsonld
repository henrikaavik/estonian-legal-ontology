        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_45_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valduse äravõtmisel on valdajal õigus nõuda valduse taastamist isikult, kes on nõudja suhtes omavoliline valdaja. (2) Nõuet ei rahuldata, kui nõudja valdus on äravõtja või tema eelkäija suhtes omavoliline ja on omandatud ühe aasta jooksul enne valduse äravõtmist.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_45 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa2_Par_46_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kostja võib vaidlustada §-des 44 ja 45 nimetatud nõudeid üksnes siis, kui ta tõendab, et valduse rikkumine või äravõtmine ei olnud omavoliline ja et tal oli õigus valdust rikkuda või asja vallata.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_46 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa2_Par_46_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_46_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kostja võib vaidlustada §-des 44 ja 45 nimetatud nõudeid üksnes siis, kui ta tõendab, et valduse rikkumine või äravõtmine ei olnud omavoliline ja et tal oli õigus valdust rikkuda või asja vallata. [Paragrahvi 46 sõnastus alates 1. 07. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_46 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa2_Par_46_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_46_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valdaja võib käesoleva seaduse §-des 44 ja 45 nimetatud nõuete rahuldamisest keelduda, kui ta tõendab, et valduse rikkumine või äravõtmine ei olnud omavoliline ja et tal oli õigus valdust rikkuda või asja vallata.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_46 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa2_Par_47_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paragrahvides 44 ja 45 nimetatud nõude võib esitada ka kaudne valdaja. (2) Valduse äravõtmisel võib kaudne valdaja nõuda otsese valdaja valduse taastamist. Kui otsene valdaja ei saa või ei taha valdust taastada, võib kaudne valdaja nõuda valduse üleandmist endale. (3) Kaudsel valdajal on käesoleva paragrahvi 2. lõikes nimetatud tingimustel otsimisõigus (§ 42).",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_47 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa2_Par_47_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_47_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paragrahvides 44 ja 45 nimetatud nõude võib esitada ka kaudne valdaja. (2) Valduse äravõtmisel võib kaudne valdaja nõuda otsese valdaja valduse taastamist. Kui otsene valdaja ei saa või ei taha valdust taastada, võib kaudne valdaja nõuda valduse üleandmist endale. (3) Kaudsel valdajal on käesoleva paragrahvi 2. lõikes nimetatud tingimustel otsimisõigus (§ 42). [Paragrahvi 48 sõnastus kuni 30. 06. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_47 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa2_Par_47_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_47_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paragrahvides 44 ja 45 nimetatud nõude võib esitada ka kaudne valdaja. (2) Valduse äravõtmisel võib kaudne valdaja nõuda otsese valdaja valduse taastamist. Kui otsene valdaja ei saa või ei taha valdust taastada, võib kaudne valdaja nõuda valduse üleandmist endale. (3) Kaudsel valdajal on käesoleva paragrahvi 2. lõikes nimetatud tingimustel otsimisõigus (§ 42).",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_47 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa2_Par_48_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valduse kaitse (§-d 44 ja 45) hagi aegumise tähtaeg on üks aasta, arvates valduse rikkumisest või äravõtmisest.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_48 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa2_Par_48_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_48_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valduse kaitse (§-d 44 ja 45) hagi aegumise tähtaeg on üks aasta, arvates valduse rikkumisest või äravõtmisest. [Paragrahvi 48 sõnastus alates 1. 07. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_48 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa2_Par_48_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_48_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 44 ja 45 nimetatud nõue lõpeb ühe aasta möödumisel valduse rikkumisest või äravõtmisest, kui nõuet ei panda maksma vastava hagi esitamisega kohtule. (2) Käesoleva seaduse §-des 44 ja 45 nimetatud nõue lõpeb ka siis, kui pärast omavoli toimepanemist tuvastatakse jõustunud kohtuotsusega, et omavoli toimepanijal on asja suhtes selline õigus, mille alusel ta võib nõuda valdust asjale.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_48 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa2_Par_48_v13107316"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa2_Par_48_v13107316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 44 ja 45 nimetatud nõue lõpeb ühe aasta möödumisel valduse rikkumisest või äravõtmisest, kui nõuet ei panda maksma vastava hagi esitamisega kohtule. (2) Käesoleva seaduse §-des 44 ja 45 nimetatud nõue lõpeb ka siis, kui pärast omavoli toimepanemist tuvastatakse jõustunud kohtulahendiga, et omavoli toimepanijal on asja suhtes selline õigus, mille alusel ta võib nõuda valdust asjale.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_48 (redaktsioon 13107316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13107316"
    },
    {
      "@id": "estleg:AOS_Osa2_Par_49_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
