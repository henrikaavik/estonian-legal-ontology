      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaudne valdus omandatakse asja väljanõudeõiguse loovutamisega omandajale, kui asja võõrandaja ise või kolmas isik jääb asja valdama.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_37 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
