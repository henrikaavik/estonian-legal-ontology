      "estleg:versionValidTo": {
        "@value": "2007-03-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_222_v12807782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_222"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_222 (redaktsioon 12807782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12807782",
