      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_121 (redaktsioon 122022019011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019011"
    },
    {
      "@id": "estleg:AOS_Osa3_Par_122_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hõivamisega võib kinnisasja omandada ainult riik. (2) Hõivamisega võtab riik omandisse kinnisasja, millel kinnistusraamatu andmetel puudub omanik ja mis ei ole kellegi valduses. Kinnisomand tekib kinnisasja valdusse võtmisega.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_122 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_122_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_122_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hõivamisega võib kinnisasja omandada ainult riik. (2) Hõivamisega võtab riik omandisse kinnisasja, millel kinnistusraamatu andmetel puudub omanik ja mis ei ole kellegi valduses. Kinnisomand tekib kinnisasja valdusse võtmisega. [Paragrahvi 123 sõnastus kuni 30. 06. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_122 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_122_v13335197"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_122_v13335197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
