      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_89_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omanikul on õigus nõuda omandiõiguse igasuguse rikkumise kõrvaldamist, isegi kui rikkumine ei ole seotud valduse kaotusega. Kui on alust eeldada niisuguse rikkumise kordumist, võib omanik nõuda rikkumisest hoidumist. Nõue on välistatud, kui omanik on kohustatud rikkumist taluma.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_89 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa3_Par_90_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vallasasja valdaja, samuti iga varasem valdaja loetakse oma valduse ajal asja omanikuks, kuni ei ole tõendatud vastupidist. (2) Kaudse valduse korral kehtib käesoleva paragrahvi 1. lõikes nimetatud eeldus ainult kaudse valdaja suhtes.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_90 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
