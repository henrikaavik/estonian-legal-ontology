        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_357 (redaktsioon 13335197)",
        "@language": "et"
      },
