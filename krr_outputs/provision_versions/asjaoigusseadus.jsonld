        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_347 (redaktsioon 122022019011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019011"
    },
    {
      "@id": "estleg:AOS_Osa8_Par_348_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa8_Par_348"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kinnistusraamatu kandest ei tulene teisiti, tuleb võlg, intressid ja muud kõrvalnõuded täita koormatud kinnisasja kinnistusameti asukohas.",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_348 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
