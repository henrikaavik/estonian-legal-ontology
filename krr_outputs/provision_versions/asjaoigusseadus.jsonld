        "@id": "estleg:AOS_Osa5_Par_232_v13335197"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_232_v13335197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_232"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_232 (redaktsioon 13335197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335197"
    },
    {
      "@id": "estleg:AOS_Osa5_Par_233_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_233"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigustatud isik võib nõuda reaalkoormatise lõpetamist ja selle väljaostmist kohustatud isiku poolt, kui: koormatud kinnisasi jagatakse ning sellega kahjustatakse tunduvalt õigustatud isiku õigusi või kohustatud isik vähendab tunduvalt koormatud kinnisasja väärtust ega anna tagatist reaalkoormatisest tulenevate kohustuste täitmiseks või kohustatud isik on jätnud reaalkoormatisest tulenevad kohustused järjest kolme aasta jooksul täitmata.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_233 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa5_Par_234_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_234"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohustatud isik võib nõuda reaalkoormatise lõpetamist selle väljaostmisega õigustatud isikult, kui: õigustatud isik ei täida reaalkoormatise tekkimise aluseks olevat lepingut või reaalkoormatis on kestnud 30 aastat, olenemata kinnistusraamatu kandes märgitud pikemast tähtajast või väljaostu lubamatusest. (2) Kui reaalkoormatise väljaostu nõutakse käesoleva paragrahvi 1. lõike punktis 2 sätestatud alusel, peab sellest üks aasta ette teatama. (3) Väljaostu ei või nõuda, kui reaalkoormatis on seatud teatud füüsilise isiku kasuks või on seatud seaduse alusel või on seotud reaalservituudiga.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_234 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa5_Par_235_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_235"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatise väljaostuhinna määramisel võetakse aluseks kinnistusraamatu kandes märgitud reaalkoormatise väärtus. (2) Kui reaalkoormatise väärtus ei ole kinnistusraamatusse kantud või kanne on puudulik või reaalkoormatisest tulenevate tegude rahaline väärtus on oluliselt muutunud, määrab väljaostuhinna kohus, arvestades tegelikke olusid ning võttes reaalkoormatise kestuseks 30 aastat.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_235 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa5_Par_236_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_236"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatis ei teki igamisega ega lõpe aegumisega. (2) Reaalkoormatisest tulenev iga üksik kohustus aegub hagi aegumise üldise tähtaja jooksul, arvates ajast, mil see muutus kohustatud isiku isiklikuks võlaks (§ 239 lg 1).",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_236 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_236_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_236_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_236"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatis ei teki igamisega ega lõpe aegumisega. [Lõike 2 sõnastus kuni 30. 06. 2003] (2) Reaalkoormatisest tulenev iga üksik kohustus aegub hagi aegumise üldise tähtaja jooksul, arvates ajast, mil see muutus kohustatud isiku isiklikuks võlaks (§ 239 lg 1). [Lõike 2 sõnastus alates 1. 07. 2003] (2) Reaalkoormatisest tulenev iga üksik kohustus aegub nõude aegumise üldise tähtaja jooksul, arvates ajast, mil see muutus kohustatud isiku isiklikuks võlaks (§ 239 lg 1).",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_236 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_236_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_236_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_236"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatis ei teki igamisega ega lõpe aegumisega. (2) Reaalkoormatisest tulenev iga üksik kohustus aegub nõude aegumise üldise tähtaja jooksul, arvates ajast, mil see muutus kohustatud isiku isiklikuks võlaks (§ 239 lg 1).",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_236 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa5_Par_237_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_237"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatis läheb koos koormatud kinnisasjaga üle igale kinnisasja omandajale tema nõusolekust sõltumata. (2) Kinnisasja igakordse omaniku kasuks seatud reaalkoormatist ei või lahutada sellest kinnisasjast. (3) Teatud isiku kasuks seatud reaalkoormatist ei või siduda kinnisasjaga.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_237 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa5_Par_238_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_238"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teatud isiku kasuks seatud reaalkoormatist võib teisele isikule üle anda, kui reaalkoormatis oma olemuselt on üleantav ega suurene sellega. (2) Reaalkoormatis ei ole üleantav, kui üleantav ei ole reaalkoormatisest tulenev üksikkohustus.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_238 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa5_Par_239_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatisest tulenevate üksikkohustuste täitmise eest vastutab omanik koormatud kinnisasjaga. Kolme aasta möödumisel nõudeõiguse tekkimisest muutub iga üksikkohustus omaniku isiklikuks võlaks. (2) Eelmise omaniku täitmata kohustused, mis ei ole muutunud tema isiklikuks võlaks, peab täitma kinnisasja järgmine omanik. (3) Kui koormatud kinnisasi jagatakse, kehtib reaalkoormatis üksikosade suhtes edasi ja kohustuste täitmise eest vastutavad üksikosade omanikud solidaarselt, kui ei ole kokku lepitud teisiti.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_239 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_239_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_239_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 30. 06. 2003] (1) Reaalkoormatisest tulenevate üksikkohustuste täitmise eest vastutab omanik koormatud kinnisasjaga. Kolme aasta möödumisel nõudeõiguse tekkimisest muutub iga üksikkohustus omaniku isiklikuks võlaks. [Lõike 1 sõnastus alates 1. 07. 2003] (1) Reaalkoormatisest tulenevate üksikkohustuste täitmise eest vastutab omanik koormatud kinnisasjaga. Kinnisasja omanik vastutab tema omandi kestuse jooksul sissenõutavaks muutunud üksikkohustuste täitmise eest ka isiklikult, kui ei ole kokku lepitud teisiti. [Lõige 2 kehtetu alates 1. 07. 2003 - (2) Eelmise omaniku täitmata kohustused, mis ei ole muutunud tema isiklikuks võlaks, peab täitma kinnisasja järgmine omanik. [Lõike 3 sõnastus kuni 30. 06. 2003] (3) Kui koormatud kinnisasi jagatakse, kehtib reaalkoormatis üksikosade suhtes edasi ja kohustuste täitmise eest vastutavad üksikosade omanikud solidaarselt, kui ei ole kokku lepitud teisiti. [Lõike 3 sõnastus alates 1. 07. 2003] (3) Kui koormatud kinnisasi jagatakse, kehtib reaalkoormatis üksikosade suhtes edasi ja kohustuste täitmise eest vastutavad üksikosade omanikud solidaarselt.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_239 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_239_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_239_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatisest tulenevate üksikkohustuste täitmise eest vastutab omanik koormatud kinnisasjaga. Kinnisasja omanik vastutab tema omandi kestuse jooksul sissenõutavaks muutunud üksikkohustuste täitmise eest ka isiklikult, kui ei ole kokku lepitud teisiti. (2) Kehtetu - (3) Kui koormatud kinnisasi jagatakse, kehtib reaalkoormatis üksikosade suhtes edasi ja kohustuste täitmise eest vastutavad üksikosade omanikud solidaarselt.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_239 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_239_v12807782"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_239_v12807782",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatisest tulenevate üksikkohustuste täitmise eest vastutab omanik koormatud kinnisasjaga. Kinnisasja omanik vastutab tema omandi kestuse jooksul sissenõutavaks muutunud üksikkohustuste täitmise eest ka isiklikult, kui ei ole kokku lepitud teisiti. (2) Kehtetu – (3) Kui koormatud kinnisasi jagatakse, kehtib reaalkoormatis üksikosade suhtes edasi ja kohustuste täitmise eest vastutavad üksikosade omanikud solidaarselt.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_239 (redaktsioon 12807782)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12807782",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_239_v13260239"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_239_v13260239",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatisest tulenevate üksikkohustuste täitmise eest vastutab omanik koormatud kinnisasjaga. Kinnisasja omanik vastutab tema omandi kestuse jooksul sissenõutavaks muutunud üksikkohustuste täitmise eest ka isiklikult, kui ei ole kokku lepitud teisiti. (1<sup>1</sup>) Kui reaalkoormatisega tagatud rahalist nõuet ei täideta, on õigustatud isikul õigus nõuda sundtäitmist täitemenetluse seadustikus sätestatud korras. (2) Kehtetu – (3) Kui koormatud kinnisasi jagatakse, kehtib reaalkoormatis üksikosade suhtes edasi ja kohustuste täitmise eest vastutavad üksikosade omanikud solidaarselt.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_239 (redaktsioon 13260239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260239",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa5_Par_239_v13335197"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa5_Par_239_v13335197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_239"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalkoormatisest tulenevate üksikkohustuste täitmise eest vastutab omanik koormatud kinnisasjaga. Kinnisasja omanik vastutab tema omandi kestuse jooksul sissenõutavaks muutunud üksikkohustuste täitmise eest ka isiklikult, kui ei ole kokku lepitud teisiti. (1<sup>1</sup>) Kui reaalkoormatisega tagatud rahalist nõuet ei täideta, on õigustatud isikul õigus nõuda sundtäitmist täitemenetluse seadustikus sätestatud korras. (2) Kehtetu - (3) Kui koormatud kinnisasi jagatakse, kehtib reaalkoormatis üksikosade suhtes edasi ja kohustuste täitmise eest vastutavad üksikosade omanikud solidaarselt.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_239 (redaktsioon 13335197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335197"
    },
    {
      "@id": "estleg:AOS_Osa5_Par_240_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa5_Par_240"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui jagatakse kinnisasi, mille igakordse omaniku kasuks reaalkoormatis on seatud (valitsev kinnisasi), kehtib reaalkoormatis osade kasuks edasi. (2) Kui reaalkoormatisest tekkivad kohustused on jagatavad, siis jagatakse reaalkoormatis käesoleva paragrahvi 1. lõikes nimetatud osade vahel vastavalt nende suurusele. Kui kohustused ei ole jagatavad, siis on nende osade omanikud õigustatud nõudma täitmist solidaarselt. (3) Kinnisasja omanik võib valitseva kinnisasja jagamisel määrata reaalkoormatise kehtivaks ainult ühe või mitme osa suhtes. Määramine tuleb kanda kinnistusraamatusse. (4) Kui valitseva kinnisasja omanik võõrandab ühe osa kinnisasjast, tegemata reaalkoormatise jagamise korraldust, jääb reaalkoormatis kehtima selle kinnisasja osa suhtes, mille omanik endale jätab. (5) Kui reaalkoormatis on oma olemuse tõttu seotud kinnisasja jagamisel tekkinud ühe osaga, võib kohustatud isik nõuda reaalkoormatise lõpetamist teiste osade suhtes.",
      "rdfs:label": {
        "@value": "AOS_Osa5_Par_240 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa6_Par_241_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa6_Par_241"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnisasja võib koormata selliselt, et isikul, kelle kasuks hoonestusõigus on seatud, on võõrandatav ja pärandatav tähtajaline õigus omada kinnisasjal sellega püsivalt ühendatud ehitist. (2) Hoonestusõigus ulatub lisaks ehitisealusele maale ka kinnisasja osale, mis on vajalik ehitise kasutamiseks. (3) Hoonestusõiguse ulatus ei või piirduda ehitise ühe osaga nagu korrus. (4) Hoonestusõigusele kohaldatakse kinnisasja sätteid, kui seaduses ei ole sätestatud teisiti. (5) Ehitis, mis on hoonestusõiguse alusel ehitatud või oli selle seadmisel olemas, on hoonestusõiguse oluline osa.",
      "rdfs:label": {
        "@value": "AOS_Osa6_Par_241 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa6_Par_241_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa6_Par_241_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa6_Par_241"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 30. 06. 2003] (1) Kinnisasja võib koormata selliselt, et isikul, kelle kasuks hoonestusõigus on seatud, on võõrandatav ja pärandatav tähtajaline õigus omada kinnisasjal sellega püsivalt ühendatud ehitist. [Lõike 1 sõnastus alates 1. 07. 2003] (1) Kinnisasja võib koormata selliselt, et isikul, kelle kasuks hoonestusõigus on seatud, on võõrandatav ja pärandatav tähtajaline õigus omada kinnisasjal sellega püsivalt ühendatud ehitist. Ühele kinnisasjale võib seada ainult ühe hoonestusõiguse. (2) Hoonestusõigus ulatub lisaks ehitisealusele maale ka kinnisasja osale, mis on vajalik ehitise kasutamiseks. (3) Hoonestusõiguse ulatus ei või piirduda ehitise ühe osaga nagu korrus. (4) Hoonestusõigusele kohaldatakse kinnisasja sätteid, kui seaduses ei ole sätestatud teisiti. [Lõike 5 sõnastus kuni 30. 06. 2003] (5) Ehitis, mis on hoonestusõiguse alusel ehitatud või oli selle seadmisel olemas, on hoonestusõiguse oluline osa. [Lõike 5 sõnastus alates 1. 07. 2003] (5) Ehitis, mis on hoonestusõiguse alusel ehitatud või oli selle seadmisel olemas ja millele hoonestusõigus laieneb, on hoonestusõiguse oluline osa. [Paragrahvi 242 sõnastus kuni 30. 06. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa6_Par_241 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa6_Par_241_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa6_Par_241_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa6_Par_241"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnisasja võib koormata selliselt, et isikul, kelle kasuks hoonestusõigus on seatud, on võõrandatav ja pärandatav tähtajaline õigus omada kinnisasjal sellega püsivalt ühendatud ehitist. Ühele kinnisasjale võib seada ainult ühe hoonestusõiguse. (2) Hoonestusõigus ulatub lisaks ehitisealusele maale ka kinnisasja osale, mis on vajalik ehitise kasutamiseks. (3) Hoonestusõiguse ulatus ei või piirduda ehitise ühe osaga nagu korrus. (4) Hoonestusõigusele kohaldatakse kinnisasja sätteid, kui seaduses ei ole sätestatud teisiti. (5) Ehitis, mis on hoonestusõiguse alusel ehitatud või oli selle seadmisel olemas ja millele hoonestusõigus laieneb, on hoonestusõiguse oluline osa.",
      "rdfs:label": {
        "@value": "AOS_Osa6_Par_241 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa6_Par_242_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa6_Par_242"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hoonestusõigus tekib kinnistusraamatusse kandmisega ja lõpeb kande kustutamisega kinnistusraamatust.",
      "rdfs:label": {
        "@value": "AOS_Osa6_Par_242 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa6_Par_242_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa6_Par_242_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa6_Par_242"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hoonestusõigus tekib kinnistusraamatusse kandmisega ja lõpeb kande kustutamisega kinnistusraamatust. [Paragrahvi 242 sõnastus alates 1. 07. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa6_Par_242 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa6_Par_242_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa6_Par_242_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa6_Par_242"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hoonestusõiguse seadmiseks või üleandmiseks kohustav tehing peab olema notariaalselt tõestatud. (2) Hoonestusõiguse seadmiseks või üleandmiseks sõlmitav asjaõigusleping peab olema notariaalselt tõestatud.",
      "rdfs:label": {
        "@value": "AOS_Osa6_Par_242 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa6_Par_243_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa6_Par_243"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui hoonestusõiguse omanik (hoonestaja) ei ole hoonestusõiguse omandamise alusega ettenähtud tähtaja jooksul nõutavat ehitist püstitanud või on rikkunud § 247 2. lõikest tulenevat kohustust, on koormatud kinnisasja omanikul õigus nõuda hoonestusõiguse lõpetamist.",
      "rdfs:label": {
        "@value": "AOS_Osa6_Par_243 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa6_Par_243_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa6_Par_243_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa6_Par_243"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui hoonestusõiguse omanik (hoonestaja) ei ole hoonestusõiguse omandamise alusega ettenähtud tähtaja jooksul nõutavat ehitist püstitanud või on rikkunud § 247 2. lõikest tulenevat kohustust, on koormatud kinnisasja omanikul õigus nõuda hoonestusõiguse lõpetamist. [Paragrahvi 244 sõnastus kuni 30. 06. 2003]",
      "rdfs:label": {
