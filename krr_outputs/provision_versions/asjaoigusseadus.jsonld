        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa8_Par_289_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa8_Par_289"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõude üleminekul uuele võlausaldajale läheb temale üle ka käsipant ning tal on õigus panditud asi pandipidajalt välja nõuda. (2) Panditud asja valduse saamisega lähevad uuele pandipidajale üle senise pandipidaja õigused ja kohustused. (3) Kui nõude üleminekul on kokku lepitud, et käsipant üle ei lähe, käsipant lõpeb. (4) Käsipant ei või üle minna ilma nõudeta. (5) Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa8_Par_289 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa8_Par_289_v12807782"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-25",
        "@type": "xsd:date"
      }
    },
    {
