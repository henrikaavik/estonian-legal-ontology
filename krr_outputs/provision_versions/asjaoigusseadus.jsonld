        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaasomanikul on õigus nõuda oma osa eraldamist ühisest asjast reaalosana, kui see ei ole vastuolus kaasomandi tekkimise aluse või asja olemusega.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_78 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
