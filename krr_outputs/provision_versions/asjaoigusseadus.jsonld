        "@id": "estleg:AOS_Osa3_Par_132_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_132_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
