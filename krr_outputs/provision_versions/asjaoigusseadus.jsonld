      },
      "estleg:versionText": "Kinnisomandi kitsendused on seadusjärgsed või need seatakse haldusakti, kohtulahendi või tehinguga.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_140 (redaktsioon 129062018006)",
