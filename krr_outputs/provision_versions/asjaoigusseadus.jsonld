    {
      "@id": "estleg:AOS_Osa2_Par_45_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa2_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valduse äravõtmisel on valdajal õigus nõuda valduse taastamist ja kahju hüvitamist isikult, kes on nõudja suhtes omavoliline valdaja. (2) Nõuet ei rahuldata, kui nõudja valdus on äravõtja või tema eelkäija suhtes omavoliline ja on omandatud ühe aasta jooksul enne valduse äravõtmist.",
      "rdfs:label": {
        "@value": "AOS_Osa2_Par_45 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
