        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019011"
    },
    {
      "@id": "estleg:AOS_Osa3_Par_170_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_170"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seaduses võib sätestada, et: kaitstava loodusobjekti piires on riigil kinnisasja ostu eesõigus; omavalitsusüksuse piires on kohalikul omavalitsusel kinnisasja ostu eesõigus.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_170 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
