        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_174 (redaktsioon 122022019011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019011"
    },
    {
      "@id": "estleg:AOS_Osa4_Par_175_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_175"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Servituudi võib kinnistusraamatust kustutada valitseva kinnisasja ja teeniva kinnisasja omanike kokkuleppel servituudi väljaostmisega.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_175 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_175_v13335197"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_175_v13335197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_175"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_175 (redaktsioon 13335197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335197",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_175_v122022019011"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_175_v122022019011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_175"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_175 (redaktsioon 122022019011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019011"
    },
    {
      "@id": "estleg:AOS_Osa4_Par_176_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_176"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui reaalservituudi lõpetamise kokkulepet ei saavutata, on valitseva kinnisasja omanikul õigus nõuda reaalservituudi kustutamist kinnistusraamatust, hüvitades teeniva kinnisasja omanikule servituudi lõpetamise tõttu tekkiva kahju. (2) Valitseva kinnisasja omanik peab teeniva kinnisasja omanikule teatama tähtajatu reaalservituudi lõpetamisest või tähtajalise reaalservituudi ennetähtaegsest lõpetamisest kuus kuud ette.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_176 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_176_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_176_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_176"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 30. 06. 2003] (1) Kui reaalservituudi lõpetamise kokkulepet ei saavutata, on valitseva kinnisasja omanikul õigus nõuda reaalservituudi kustutamist kinnistusraamatust, hüvitades teeniva kinnisasja omanikule servituudi lõpetamise tõttu tekkiva kahju. [Lõike 1 sõnastus alates 1. 07. 2003] (1) Kui reaalservituudi lõpetamise kokkulepet ei saavutata, on valitseva kinnisasja omanikul olulisel põhjusel õigus nõuda teeniva kinnisasja omanikult nõusolekut reaalservituudi lõpetamiseks tingimusel, et ta hüvitab teeniva kinnisasja omanikule servituudi lõpetamise tõttu tekkiva kahju. (2) Valitseva kinnisasja omanik peab teeniva kinnisasja omanikule teatama tähtajatu reaalservituudi lõpetamisest või tähtajalise reaalservituudi ennetähtaegsest lõpetamisest kuus kuud ette. [Paragrahvi 177 sõnastus kuni 30. 06. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_176 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_176_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_176_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_176"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui reaalservituudi lõpetamise kokkulepet ei saavutata, on valitseva kinnisasja omanikul olulisel põhjusel õigus nõuda teeniva kinnisasja omanikult nõusolekut reaalservituudi lõpetamiseks tingimusel, et ta hüvitab teeniva kinnisasja omanikule servituudi lõpetamise tõttu tekkiva kahju. (2) Valitseva kinnisasja omanik peab teeniva kinnisasja omanikule teatama tähtajatu reaalservituudi lõpetamisest või tähtajalise reaalservituudi ennetähtaegsest lõpetamisest kuus kuud ette.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_176 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa4_Par_177_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_177"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui reaalservituudist saadav kasu on teeniva kinnisasja koormatisega võrreldes väike, on teeniva kinnisasja omanikul õigus nõuda reaalservituudi kustutamist kinnistusraamatust, hüvitades valitseva kinnisasja omanikule servituudi lõpetamise tõttu tekkiva kahju. (2) Kui valitseva kinnisasja omanik on reaalservituudi vastu kaotanud huvi, on teeniva kinnisasja omanikul õigus nõuda reaalservituudi kustutamist kinnistusraamatust. Huvi kaotamist eeldatakse, kui valitseva kinnisasja omanik ei ole 10 aasta jooksul reaalservituuti kasutanud või kui ta on sama aja jooksul lubanud teeniva kinnisasja sellist kasutamist, mis on vastuolus reaalservituudiga.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_177 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_177_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_177_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_177"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui reaalservituudist saadav kasu on teeniva kinnisasja koormatisega võrreldes väike, on teeniva kinnisasja omanikul õigus nõuda reaalservituudi kustutamist kinnistusraamatust, hüvitades valitseva kinnisasja omanikule servituudi lõpetamise tõttu tekkiva kahju. (2) Kui valitseva kinnisasja omanik on reaalservituudi vastu kaotanud huvi, on teeniva kinnisasja omanikul õigus nõuda reaalservituudi kustutamist kinnistusraamatust. Huvi kaotamist eeldatakse, kui valitseva kinnisasja omanik ei ole 10 aasta jooksul reaalservituuti kasutanud või kui ta on sama aja jooksul lubanud teeniva kinnisasja sellist kasutamist, mis on vastuolus reaalservituudiga. [Paragrahvi 177 sõnastus alates 1. 07. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_177 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_177_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_177_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_177"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui reaalservituudist saadav kasu on teeniva kinnisasja koormatisega võrreldes ebamõistlikult väike, on teeniva kinnisasja omanikul õigus nõuda valitseva kinnisasja omanikult nõusolekut reaalservituudi lõpetamiseks tingimusel, et ta hüvitab valitseva kinnisasja omanikule servituudi lõpetamise tõttu tekkiva kahju. (2) Kui valitseva kinnisasja omanik on kaotanud huvi reaalservituudist tulenevate õiguste teostamise vastu, on teeniva kinnisasja omanikul õigus nõuda valitseva kinnisasja omanikult nõusolekut reaalservituudi lõpetamiseks. Huvi kaotamist eeldatakse, kui valitseva kinnisasja omanik ei ole 10 aasta jooksul reaalservituuti kasutanud või kui ta on sama aja jooksul lubanud teeniva kinnisasja kasutamist viisil, mis on vastuolus reaalservituudiga.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_177 (redaktsioon 687259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687259"
    },
    {
      "@id": "estleg:AOS_Osa4_Par_178_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_178"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reaalservituut annab õiguse teha üksnes neid tegusid, mis servituudi sisust tulenevalt on valitseva kinnisasja huvides vajalikud. (2) Reaalservituuti tuleb teostada viisil, mis on teenivale kinnisasjale kõige vähem koormav. (3) Valitseva kinnisasja vajaduste suurenemine ei suurenda iseenesest teenival kinnisasjal lasuvat koormatist.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_178 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_178_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_178_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa4_Par_178"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 30. 06. 2003] (1) Reaalservituut annab õiguse teha üksnes neid tegusid, mis servituudi sisust tulenevalt on valitseva kinnisasja huvides vajalikud. [Lõike 1 sõnastus alates 1. 07. 2003] (1) Reaalservituut annab õiguse teha üksnes neid tegusid, mis servituudi sisust tulenevalt on valitseva kinnisasja huvides vajalikud. Reaalservituudi sisu määratakse poolte kokkuleppega, kui seaduses ei ole sätestatud teisiti. (2) Reaalservituuti tuleb teostada viisil, mis on teenivale kinnisasjale kõige vähem koormav. (3) Valitseva kinnisasja vajaduste suurenemine ei suurenda iseenesest teenival kinnisasjal lasuvat koormatist.",
      "rdfs:label": {
        "@value": "AOS_Osa4_Par_178 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa4_Par_178_v687259"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa4_Par_178_v687259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
