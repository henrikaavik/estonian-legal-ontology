    {
      "@id": "estleg:AOS_Osa3_Par_92_1_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_92_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omandi tekkimiseks Eesti kohtu juures asuvasse laevakinnistusraamatusse kandmata merelaevale ei ole merelaeva üleandmist vaja, kui võõrandaja ja omandaja on kokku leppinud omandi koheses üleminekus.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_92_1 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252"
    },
    {
      "@id": "estleg:AOS_Osa3_Par_93_v22252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_93"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui asi on kolmanda isiku valduses, võib võõrandaja kokkuleppel omandajaga asja valduse üleandmise asendada väljanõudeõiguse loovutamisega omandajale.",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_93 (redaktsioon 22252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22252",
      "estleg:supersededByVersion": {
        "@id": "estleg:AOS_Osa3_Par_93_v253333"
      },
      "estleg:versionValidTo": {
        "@value": "2003-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AOS_Osa3_Par_93_v253333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AOS_Osa3_Par_93"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui asi on kolmanda isiku valduses, võib võõrandaja kokkuleppel omandajaga asja valduse üleandmise asendada väljanõudeõiguse loovutamisega omandajale. [Paragrahvi 94 sõnastus kuni 30. 06. 2003]",
      "rdfs:label": {
        "@value": "AOS_Osa3_Par_93 (redaktsioon 253333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "253333",
