    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_46_v106052016008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikohus võib asja lahendamisel: tühistada valimiskomisjoni otsuse, tunnistada valimiste korraldaja või valimiskomisjoni toimingu õigusvastaseks ning kohustada valimiskomisjoni tegema uue otsuse või toimingu või valimiste korraldajat tegema uue toimingu; jätta kaebuse või protesti rahuldamata. (2) Riigikohus võib tunnistada hääletamistulemuse valimisjaoskonnas, valimisringkonnas, vallas, linnas, maakonnas või riigis või Vabariigi Presidendi või Riigikogu juhatuse valimistel kehtetuks või tunnistada elektroonilise hääletamise tulemused kehtetuks täies ulatuses või osaliselt, kui õigusrikkumine mõjutas või võis mõjutada hääletamistulemust oluliselt. (3) Riigikogu või Euroopa Parlamendi liikmete ja asendusliikmete registreerimise ning lisamandaatide jaotamise otsuse, samuti kohaliku omavalitsuse volikogu liikmete ja asendusliikmete registreerimise ning lisamandaatide jaotamise otsuse peale esitatud kaebuse või protesti rahuldamise korral tühistab Riigikohus mandaadi. (4) Kui Riigikohus kontrollib asja lahendamisel ka õigustloova akti, selle andmata jätmise või välislepingu vastavust põhiseadusele, võib kohus selle küsimuse lahendamisel teha ühe § 15 lõikes 1 nimetatud otsuse.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_46 (redaktsioon 106052016008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106052016008"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtumenetluse keel on eesti keel. (2) Võõrkeelsed dokumendid esitatakse kohtule vannutatud tõlgi poolt eesti keelde tõlgituna.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828",
      "estleg:supersededByVersion": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47_v123122013057"
      },
      "estleg:versionValidTo": {
        "@value": "2013-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47_v123122013057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtumenetluse keel on eesti keel. (2) Võõrkeelsed dokumendid esitatakse kohtule vandetõlgi poolt eesti keelde tõlgituna või notari kinnitatud eestikeelse tõlkega.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47 (redaktsioon 123122013057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122013057",
      "estleg:supersededByVersion": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47_v126062017061"
      },
      "estleg:versionValidTo": {
        "@value": "2017-07-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47_v126062017061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtumenetluse keel on eesti keel. (2) Võõrkeelsed dokumendid esitatakse kohtule vandetõlgi poolt eesti keelde tõlgituna või notari kinnitatud eestikeelse tõlkega. (3) Käesoleva seaduse § 31 alusel esitatava taotluse tõlkimise inglise või prantsuse keelde ja esitatud taotluse kohta saadud Euroopa Inimõiguste Kohtu lahendi tõlkimise eesti keelde korraldab Riigikohus riigi arvel. , lõiget 3 rakendatakse alates inimõiguste ja põhivabaduste kaitse konventsiooni protokolli nr 16 Eesti suhtes kehtima hakkamise päevast.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47 (redaktsioon 126062017061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062017061",
      "estleg:supersededByVersion": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47_v107032019004"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47_v107032019004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtumenetluse keel on eesti keel. (2) Võõrkeelsed dokumendid esitatakse kohtule vandetõlgi poolt eesti keelde tõlgituna. (3) Käesoleva seaduse § 31 alusel esitatava taotluse tõlkimise inglise või prantsuse keelde ja esitatud taotluse kohta saadud Euroopa Inimõiguste Kohtu lahendi tõlkimise eesti keelde korraldab Riigikohus riigi arvel. , lõiget 3 rakendatakse alates inimõiguste ja põhivabaduste kaitse konventsiooni protokolli nr 16 Eesti suhtes kehtima hakkamise päevast.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_47 (redaktsioon 107032019004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032019004"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_48_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tähtaegu arvutatakse tsiviilkohtumenetluses sätestatud korras. (2) Esindusele kohaldatakse tsiviilkohtumenetluse sätteid. (3) Taotluse, kaebuse või protesti esitamisel esindaja kaudu kirjutab sellele alla esindaja, lisades taotlusele, kaebusele või protestile oma volitusi tõendava dokumendi.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_48 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_49_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Menetlusosalisel on õigus teada asja arutava kohtu koosseisu, saada kohtule esitatud dokumentide ärakirju, esitada kohtule taotlusi, anda kohtule seletusi, esitada tõendeid, vaielda vastu teiste menetlusosaliste taotlustele ning saada eraldi dokumendina vormistatud kohtulahendi tõestatud ärakirju. Menetlusosalisel on ka muud käesolevas seaduses ettenähtud menetlusõigused. (2) Menetlusosaline on kohustatud kasutama oma menetlusõigust heauskselt. (3) Menetlusosaline on kohustatud põhjendama oma väiteid või vastuväiteid vastavate tõenditega. Kui tõendite esitamine ei ole võimalik, tuleb näidata põhjused, miks neid tõendeid esitada ei saa, ja teatada, kus need asuvad. Kohtu nõudmisel on menetlusosaline kohustatud esitama kohtule täiendavaid andmeid ja dokumente kohtu poolt määratud tähtaja jooksul.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_49 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_5_v24452",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui kohus jõuab kohtuasja arutamisel järeldusele, et kohaldamisele kuuluv seadus või muu õigusakt on vastuolus põhiseadusega, tunnistab ta õigusakti põhiseadusevastaseks ja jätab selle kohaldamata. (2) Kui kohus on tunnistanud otsuses seaduse või muu õigusakti põhiseadusevastaseks ja jätnud selle kohaldamata, teeb ta otsuse teatavaks Riigikohtule ja õiguskantslerile, millega käivitub põhiseaduslikkuse järelevalve menetlus Riigikohtus.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_5 (redaktsioon 24452)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24452",
      "estleg:supersededByVersion": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_5_v27828"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_5_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi President võib esitada Riigikohtule taotluse tunnistada Riigikogus vastuvõetud, kuid tema poolt väljakuulutamata seadus põhiseadusega vastuolus olevaks, kui Riigikogu on selle pärast uueks arutamiseks ja otsustamiseks saatmist muutmata kujul uuesti vastu võtnud.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_5 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_50_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põhiseaduslikkuse järelevalve kohtumenetluses on tõenditeks kõik tsiviilkohtumenetluses lubatud tõendid. (2) Tõendeid esitavad menetlusosalised. Kohus võib teha menetlusosalistele ettepaneku esitada kohtu poolt määratud tähtaja jooksul täiendavaid tõendeid või koguda tõendeid, kutsuda uusi tunnistajaid või määrata ekspertiisi taotluses, kaebuses või protestis esitatud andmete kontrollimiseks ka oma algatusel. (3) Tõendite tagamine, tunnistajate istungile kutsumine ja nende ärakuulamine toimub tsiviilkohtumenetluse sätete kohaselt.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_50 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_51_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üldjuhul vaadatakse asi läbi kirjalikus menetluses. (2) Asi vaadatakse läbi suulises menetluses, kui seda peab vajalikuks asja läbivaatav kohtukoosseis. Suulise menetluse määrab kohus menetlusosalise soovil või oma algatusel. (3) Suulises menetluses vaadatakse läbi taotlus tunnistada Riigikogu liige, Vabariigi President, õiguskantsler või riigikontrolör kestvalt võimetuks oma ülesandeid täitma.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_51 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828",
      "estleg:supersededByVersion": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_51_v973817"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_51_v973817",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üldjuhul vaadatakse asi läbi kirjalikus menetluses. (2) Asi vaadatakse läbi suulises menetluses, kui seda peab vajalikuks asja läbivaatav kohtukoosseis. Suulise menetluse määrab kohus menetlusosalise soovil või oma algatusel. (3) Suulises menetluses vaadatakse läbi taotlus tunnistada Riigikogu liige, Vabariigi President, õiguskantsler või riigikontrolör kestvalt võimetuks oma ülesandeid täitma. (4) Kirjalikus menetluses vaadatakse läbi taotlus anda seisukoht, kuidas tõlgendada põhiseadust koostoimes Euroopa Liidu õigusega.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_51 (redaktsioon 973817)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "973817"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_52_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikohus võib liita üheaegselt kohtu menetluses olevad sarnased käesoleva seaduse alusel lahendatavad asjad, kui ta peab seda asja lahendamise huvides vajalikuks.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_52 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asja läbivaatamine suulises menetluses on avalik. (2) Kohus võib kuulutada menetluse või selle osa kinniseks, kui see on vajalik riigi- või ärisaladuse hoidmiseks, kõlbluse või inimeste perekonna- ja eraelu kaitseks või kui seda nõuavad alaealise, kannatanu või õigusemõistmise huvid. (3) Kohus võib pärast hoiatamist eemaldada istungisaalist isikud, kes rikuvad korda ja takistavad sellega asja arutamist. (4) Istungisaalis viibivad isikud võivad kohapealt istungit häirimata seda helisalvestada ja teha kirjalikke märkmeid. (5) Filmimiseks, pildistamiseks, videosalvestuseks, raadio- ja teleülekandeks on nõutav kohtu luba.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828",
      "estleg:supersededByVersion": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53_v242204"
      },
      "estleg:versionValidTo": {
        "@value": "2003-01-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53_v242204",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asja läbivaatamine suulises menetluses on avalik. (2) Kohus võib kuulutada menetluse või selle osa kinniseks, kui see on vajalik riigi- või ärisaladuse hoidmiseks, kõlbluse või inimeste perekonna- ja eraelu kaitseks või kui seda nõuavad alaealise, kannatanu või õigusemõistmise huvid. (3) Kohus võib pärast hoiatamist eemaldada istungisaalist isikud, kes rikuvad korda ja takistavad sellega asja arutamist. (4) Istungisaalis viibivad isikud võivad kohapealt istungit häirimata seda helisalvestada ja teha kirjalikke märkmeid. (5) Filmimiseks, pildistamiseks, videosalvestuseks, raadio- ja teleülekandeks on nõutav kohtu luba.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53 (redaktsioon 242204)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "242204",
      "estleg:supersededByVersion": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53_v264891"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-16",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53_v264891",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asja läbivaatamine suulises menetluses on avalik. (2) Kohus võib kuulutada menetluse või selle osa kinniseks, kui see on vajalik riigi- või ärisaladuse hoidmiseks, kõlbluse või inimeste perekonna- ja eraelu kaitseks või kui seda nõuavad alaealise, kannatanu või õigusemõistmise huvid. (3) Kohus võib pärast hoiatamist eemaldada istungisaalist isikud, kes rikuvad korda ja takistavad sellega asja arutamist. (4) Istungisaalis viibivad isikud võivad kohapealt istungit häirimata seda helisalvestada ja teha kirjalikke märkmeid. (5) Filmimiseks, pildistamiseks, videosalvestuseks, raadio- ja teleülekandeks on nõutav kohtu luba.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_53 (redaktsioon 264891)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264891"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_54_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Taotluse, kaebuse või protesti läbivaatamine suulises menetluses toimub vahetult. Kohus kuulab ära menetlusosaliste seisukohad, tunnistajate ütlused või erialaasjatundja arvamuse ning tutvub kohtule esitatud dokumentidega. (2) Menetlusosalised, kes ei valda eesti keelt, võivad esineda vannutatud tõlgi vahendusel oma emakeeles või muus keeles, mida nad valdavad. (3) Suulises menetluses asja läbivaatamisel on menetlusosalisel lisaks § 49 lõikes 1 sätestatule õigus osa võtta kohtuistungitest, tõendite vaatlusest ja uurimisest ning esitada küsimusi teistele menetlusosalistele, tunnistajatele ning ekspertidele.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_54 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_55_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Istungi käik ning väljendatud seisukohad protokollitakse ulatuses, mida kohus peab vajalikuks. (2) Kuni istungi lõppemiseni võivad menetlusosalised oma seisukohad esitada kohtuistungi sekretärile ka kirjalikult lisamiseks istungi protokolli juurde. Teistel menetlusosalistel on õigus nendega tutvuda.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_55 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_56_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Menetlus lõpetatakse, kui enne asja läbivaatamise lõppemist langeb ära taotluse, kaebuse või protesti alus, samuti taotlusest, kaebusest või protestist loobumise korral. (2) Kohtu, Vabariigi Presidendi või Vabariigi Presidendi ülesannetes Riigikogu esimehe algatatud menetlust asja aluse äralangemisel ei lõpetata ning Vabariigi President ega Vabariigi Presidendi ülesannetes Riigikogu esimees ei saa Riigikohtule esitatud taotlusest loobuda.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_56 (redaktsioon 27828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27828",
      "estleg:supersededByVersion": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_56_v264891"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-16",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_56_v264891",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Menetlus lõpetatakse, kui enne asja läbivaatamise lõppemist langeb ära taotluse, kaebuse või protesti alus, samuti taotlusest, kaebusest või protestist loobumise korral. (2) Kohtu, Vabariigi Presidendi või Vabariigi Presidendi ülesannetes Riigikogu esimehe algatatud menetlust asja aluse äralangemisel eilõpetataning Vabariigi President ega Vabariigi Presidendi ülesannetes Riigikogu esimees ei saa Riigikohtule esitatud taotlusest loobuda.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_56 (redaktsioon 264891)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264891",
