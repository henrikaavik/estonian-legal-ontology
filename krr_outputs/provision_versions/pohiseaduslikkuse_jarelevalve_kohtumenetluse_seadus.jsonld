    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_17_v27828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
