        "@language": "et"
      },
      "dc:source": "Põhiseaduslikkuse järelevalve kohtumenetluse seadus"
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_1_v24452",
