      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liige, asendusliige või fraktsioon, kes leiab, et Riigikogu kodukorra seaduse (RT I 1994, 90, 1517; 2001, 1, 1; 94, 581) § 13 lõike 2 punktis 2, 3 või 4 või Riigikogu töökorra seaduse (RT 1992, 46, 582; RT I 1999, 2, 44; 16, 271; 2000, 25, 145) § 4 lõikes 1, §-s 5 või §-s 6 1 nimetatud Riigikogu juhatuse otsusega on rikutud tema õigusi, võib esitada Riigikohtule taotluse tühistada Riigikogu juhatuse otsus.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_17 (redaktsioon 264891)",
        "@language": "et"
      },
