    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_17_v12849846",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liige, asendusliige või fraktsioon, kes leiab, et Riigikogu kodu- ja töökorra seaduse § 13 lõike 2 punktis 2, 3 või 4 või Riigikogu liikme staatuse seaduse §-s 13 või 14 nimetatud Riigikogu juhatuse otsusega on rikutud tema õigusi, võib esitada Riigikohtule taotluse tühistada Riigikogu juhatuse otsus.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_17 (redaktsioon 12849846)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12849846",
      "estleg:supersededByVersion": {
