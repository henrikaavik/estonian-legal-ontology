      },
      "estleg:versionValidTo": {
        "@value": "2007-07-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pohiseaduslikkuse_jarelevalve_kohtumenet_Par_36_v12849846",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
