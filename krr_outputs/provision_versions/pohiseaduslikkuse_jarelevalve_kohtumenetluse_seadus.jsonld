      },
      "estleg:versionText": "Menetlusküsimusi otsustab Riigikohus määrusega.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_60 (redaktsioon 27828)",
        "@language": "et"
      },
