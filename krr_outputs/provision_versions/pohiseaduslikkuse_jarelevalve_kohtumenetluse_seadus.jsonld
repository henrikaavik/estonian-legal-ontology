        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab põhiseaduslikkuse järelevalve kohtumenetluse korra ja kohtute pädevuse.",
      "rdfs:label": {
        "@value": "pohiseaduslikkuse_jarelevalve_kohtumenet_Par_1 (redaktsioon 24452)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24452",
