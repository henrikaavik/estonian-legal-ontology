    {
      "@id": "estleg:Reg_1001132_Par_5_v1001132",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001132_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õppesõiduk ja juhi varustus peavad vastama „Liiklusseaduse” § 100 lõike 7 alusel kehtestatud määruses sätestatud eksamisõiduki ja juhi varustuse nõuetele. Õppesõiduk ja juhi varustus peavad vastama „Liiklusseaduse” § 100 lõike 7 alusel kehtestatud määruses sätestatud eksamisõiduki ja juhi varustuse nõuetele. 2 (2) Õppesõiduk peab olema tähtaegselt läbinud tehnonõuetele vastavuse kontrolli. Õppesõiduk peab olema tähtaegselt läbinud tehnonõuetele vastavuse kontrolli. 3 (3) Õppesõiduk peab olema puhas ja seal ei tohi olla ohtlikke või halvasti lõhnavaid aineid. Õppesõiduk peab olema puhas ja seal ei tohi olla ohtlikke või halvasti lõhnavaid aineid. 4 (4) Õppesõidukil ei pea olema salvestusseadet ega piduri lisapedaal olema varustatud helisignaaliga. RT I 2021-04-23 1 123042021001 2021-04-26 Õppesõidukil ei pea olema salvestusseadet ega piduri lisapedaal olema varustatud helisignaaliga.",
      "rdfs:label": {
        "@value": "Reg_1001132_Par_5 (redaktsioon 1001132)",
        "@language": "et"
      },
