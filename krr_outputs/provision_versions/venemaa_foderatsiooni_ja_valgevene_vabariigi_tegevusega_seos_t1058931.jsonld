      "estleg:provisionRef": "Reg_1058931 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058931_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058931_Par_3_v1058931",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058931_Par_3"
