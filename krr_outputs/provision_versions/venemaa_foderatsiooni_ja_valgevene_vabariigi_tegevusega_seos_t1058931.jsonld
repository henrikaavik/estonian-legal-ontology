      "estleg:versionValidFrom": {
        "@value": "2026-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõukogu määruse (EL) nr 833/2014 artikli 5r lõike 3 rakendamiseks on Rahapesu Andmebürool ja Finantsinspektsioonil õigus edastada asjakohast teavet teistele pädevatele ja järelevalveasutustele, kes hindavad saadud teavet kooskõlas artikli 5r lõikega 3 ning edastavad oma järeldused Välisministeeriumile. Välisministeerium teavitab järeldustest korrapäraselt teisi liikmesriike ja Euroopa Komisjoni. Nõukogu määruse (EL) nr 833/2014 artikli 5r lõike 3 rakendamiseks on Rahapesu Andmebürool ja Finantsinspektsioonil õigus edastada asjakohast teavet teistele pädevatele ja järelevalveasutustele, kes hindavad saadud teavet kooskõlas artikli 5r lõikega 3 ning edastavad oma järeldused Välisministeeriumile. Välisministeerium teavitab järeldustest korrapäraselt teisi liikmesriike ja Euroopa Komisjoni.",
      "rdfs:label": {
        "@value": "Reg_1058931_Par_3 (redaktsioon 1058931)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058931",
