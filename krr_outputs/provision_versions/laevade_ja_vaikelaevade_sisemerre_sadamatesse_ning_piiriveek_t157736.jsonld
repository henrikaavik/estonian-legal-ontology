      "estleg:provisionRef": "Reg_157736 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157736_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157736_Par_7_v157736",
      "@type": [
        "owl:NamedIndividual",
