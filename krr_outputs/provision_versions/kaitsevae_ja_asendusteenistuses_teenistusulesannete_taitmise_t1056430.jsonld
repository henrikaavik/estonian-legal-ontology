    {
      "@id": "estleg:Reg_1056430_Par_7_v1056430",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056430_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-03-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Püsiva töövõimetuse põhjus on kaitseväe- või asendusteenistuses teenistusülesannete täitmise tõttu saadud tervisekahjustus, kui tehakse kindlaks meditsiinilise seose olemasolu kaitseväe- või asendusteenistuses teenistusülesannete täitmise tõttu saadud vigastuse või selle tagajärjel tekkinud tüsistuste, järelnähtude, haigestumise või haiguse ägenemise või süvenemise ja püsiva töövõimetuse vahel. Püsiva töövõimetuse põhjus on kaitseväe- või asendusteenistuses teenistusülesannete täitmise tõttu saadud tervisekahjustus, kui tehakse kindlaks meditsiinilise seose olemasolu kaitseväe- või asendusteenistuses teenistusülesannete täitmise tõttu saadud vigastuse või selle tagajärjel tekkinud tüsistuste, järelnähtude, haigestumise või haiguse ägenemise või süvenemise ja püsiva töövõimetuse vahel.",
      "rdfs:label": {
        "@value": "Reg_1056430_Par_7 (redaktsioon 1056430)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056430",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056430",
      "estleg:sourceAct": "Kaitseväe- ja asendusteenistuses teenistusülesannete täitmise tõttu saadud tervisekahjustusest põhjustatud püsiva töövõimetuse, selle ulatuse, põhjuse ja kestuse tuvastamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1056430 § 7",
