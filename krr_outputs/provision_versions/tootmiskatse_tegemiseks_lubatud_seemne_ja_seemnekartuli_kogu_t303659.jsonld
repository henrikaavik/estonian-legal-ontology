    {
      "@id": "estleg:Reg_303659_Par_2_v303659",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303659_Par_2"
