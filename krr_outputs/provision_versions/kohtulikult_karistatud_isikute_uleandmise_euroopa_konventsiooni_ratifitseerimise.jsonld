      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastavalt konventsiooni artikli 17 lõikele 3 deklareerib Eesti Vabariik, et Eestile esitatakse taotlused ja nende lisad koos eesti- või ingliskeelse tõlkega.",
