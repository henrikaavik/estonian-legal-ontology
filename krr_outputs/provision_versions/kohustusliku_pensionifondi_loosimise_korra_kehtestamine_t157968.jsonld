      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kohustusliku pensionifondi loosimise korra kehtestamine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kohustusliku pensionifondi loosimise korra kehtestamine"
    },
    {
      "@id": "estleg:Reg_157968_Par_1_v157968",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157968_Par_1"
