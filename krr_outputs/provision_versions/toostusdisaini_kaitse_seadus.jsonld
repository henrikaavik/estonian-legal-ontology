      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TDKS_Par_82_v12791433",
      "@type": [
        "owl:NamedIndividual",
