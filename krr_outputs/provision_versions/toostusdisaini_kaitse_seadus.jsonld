    {
      "@id": "estleg:TDKS_Par_2_v12766745",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDKS_Par_2"
