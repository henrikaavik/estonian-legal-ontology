      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TDKS_Par_78_v12791433",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDKS_Par_78"
      },
      "estleg:versionValidFrom": {
