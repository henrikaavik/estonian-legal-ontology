    {
      "@id": "estleg:TDKS_Par_87_7_v730982",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDKS_Par_87_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ühenduse disainilahenduste õiguskaitse ja kehtivusega seotud asju vaatab esimese astme Ühenduse disainikohtuna läbi Tallinna Linnakohus. (2) Esimese astme Ühenduse disainikohtu peale esitatud kaebuseid vaatab teise astme Ühenduse disainikohtuna läbi Tallinna Ringkonnakohus.",
      "rdfs:label": {
        "@value": "TDKS_Par_87_7 (redaktsioon 730982)",
        "@language": "et"
