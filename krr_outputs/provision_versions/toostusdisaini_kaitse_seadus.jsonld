        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus reguleerib tööstusdisaini valdkonnas loodud tööstusdisainilahenduste õiguskaitset Eesti Vabariigis.",
      "rdfs:label": {
        "@value": "TDKS_Par_1 (redaktsioon 22389)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22389",
      "estleg:supersededByVersion": {
