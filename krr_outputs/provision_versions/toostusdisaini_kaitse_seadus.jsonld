      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ettenähtud juhtudel võetakse toimingute sooritamise ja dokumentide väljastamise eest riigilõivu riigilõivuseaduses (RT I 1997, 80, 1344; 2001, 53, 310; 55, 331; 56, 332; 64, 367; 65, 377; 85, 512; 88, 531; 91, 543; 93, 565; 2002, 1, 1) sätestatud määrade järgi.",
      "rdfs:label": {
        "@value": "TDKS_Par_88 (redaktsioon 22389)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22389",
      "estleg:supersededByVersion": {
