    {
      "@id": "estleg:TDKS_Par_87_7_v926772",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDKS_Par_87_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 31. 12. 2005] (1) Ühenduse disainilahenduste õiguskaitse ja kehtivusega seotud asju vaatab esimese astme Ühenduse disainikohtuna läbi Tallinna Linnakohus. [Lõike 1 sõnastus alates 1. 01. 2006] (1) Ühenduse disainilahenduste õiguskaitse ja kehtivusega seotud asju vaatab esimese astme Ühenduse disainikohtuna läbi Harju Maakohus. (2) Esimese astme Ühenduse disainikohtu peale esitatud kaebuseid vaatab teise astme Ühenduse disainikohtuna läbi Tallinna Ringkonnakohus.",
      "rdfs:label": {
        "@value": "TDKS_Par_87_7 (redaktsioon 926772)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "926772",
