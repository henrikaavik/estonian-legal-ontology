    {
      "@id": "estleg:TDKS_Par_62_v22389",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDKS_Par_62"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri koosseisu kuuluvad: kanderaamat; registreerimistaotluse menetluse toimik; registritoimik; registripäevik.",
      "rdfs:label": {
        "@value": "TDKS_Par_62 (redaktsioon 22389)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22389"
    },
    {
      "@id": "estleg:TDKS_Par_66_v22389",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registripäevikus registreeritakse tööstusdisainilahenduste registreerimise otsused, kande tegemise avaldused ja registri volitatud töötlejale esitatud dokumendid. (2) Registripäevikusse tehakse märge kande tegemise avalduse rahuldamise kohta.",
      "rdfs:label": {
        "@value": "TDKS_Par_66 (redaktsioon 22389)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22389",
      "estleg:supersededByVersion": {
