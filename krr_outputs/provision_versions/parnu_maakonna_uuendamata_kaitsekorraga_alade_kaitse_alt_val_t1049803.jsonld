    {
      "@id": "estleg:Reg_1049803_Par_5_v1049803",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049803_Par_5"
