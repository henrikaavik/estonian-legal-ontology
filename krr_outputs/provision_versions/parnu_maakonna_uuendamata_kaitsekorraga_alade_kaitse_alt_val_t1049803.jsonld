      "estleg:versionValidFrom": {
        "@value": "2022-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 24. juuli 2019. a käskkirjaga nr 1-2/19/524 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 24. juuli 2019. a käskkirjaga nr 1-2/19/524 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1049803_Par_5 (redaktsioon 1049803)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049803",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049803",
      "estleg:sourceAct": "Pärnu maakonna uuendamata kaitsekorraga alade kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1049803 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049803_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1049803_Par_6_v1049803",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049803_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1049803_Par_6 (redaktsioon 1049803)",
        "@language": "et"
      },
