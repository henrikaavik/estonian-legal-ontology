      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Pärnu maakonna uuendamata kaitsekorraga alade kaitse alt väljaarvamine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Pärnu maakonna uuendamata kaitsekorraga alade kaitse alt väljaarvamine"
    },
    {
      "@id": "estleg:Reg_1049803_Par_1_v1049803",
      "@type": [
        "owl:NamedIndividual",
