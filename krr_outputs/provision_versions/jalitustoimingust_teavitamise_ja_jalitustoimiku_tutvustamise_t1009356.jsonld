        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse isiku, kelle suhtes jälitustoiming tehti, jälitustoimingust teavitamise ning teavitatud isikule jälitustoiminguga kogutud andmete tutvustamise kord. Määrusega kehtestatakse isiku, kelle suhtes jälitustoiming tehti, jälitustoimingust teavitamise ning teavitatud isikule jälitustoiminguga kogutud andmete tutvustamise kord.",
      "rdfs:label": {
        "@value": "Reg_1009356_Par_1 (redaktsioon 1009356)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009356",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009356",
      "estleg:sourceAct": "Jälitustoimingust teavitamise ja jälitustoimiku tutvustamise kord",
      "estleg:provisionRef": "Reg_1009356 § 1",
