      "estleg:versionValidTo": {
        "@value": "2010-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTKS_Par_30_v13312048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "VPTKS_Par_30 (redaktsioon 13312048)",
        "@language": "et"
      },
