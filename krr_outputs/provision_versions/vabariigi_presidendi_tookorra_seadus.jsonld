      "estleg:versionRedactionId": "108072011073"
    },
    {
      "@id": "estleg:VPTKS_Par_2_v27017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi President on Eesti riigipea. (2) Vabariigi President on isik, kes on valitud Vabariigi Presidendiks Vabariigi Presidendi valimise seaduses (RT I 1996, 30, 595) ettenähtud korras. (3) Käesolevat seadust kohaldatakse asjakohaste erisustega ka Riigikogu esimehele Vabariigi Presidendi ülesannetes.",
      "rdfs:label": {
        "@value": "VPTKS_Par_2 (redaktsioon 27017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27017",
      "estleg:supersededByVersion": {
