      }
    },
    {
      "@id": "estleg:VPTKS_Par_30_v106072012027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2001. aasta 1. septembril.",
      "rdfs:label": {
        "@value": "VPTKS_Par_30 (redaktsioon 106072012027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072012027"
    },
    {
      "@id": "estleg:VPTKS_Par_4_v27017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Presidendi volitused peatuvad, kui: ta on ajutiselt võimetu täitma oma ülesandeid; ta on võetud kriminaalvastutusele vastavalt Vabariigi Presidendi ja Vabariigi Valitsuse liikme kohtulikule vastutusele võtmise korra seadusele (RT I 1995, 83, 1441; 2000, 35, 222); [Punkt 3 jõustub 1.07.2002] ta on tunnistatud kestvalt võimetuks täitma oma ülesandeid. (2) Vabariigi Presidendi volituste peatumise korral lähevad need ajutiselt üle Riigikogu esimehele, kes hakkab täitma Vabariigi Presidendi ülesandeid.",
      "rdfs:label": {
        "@value": "VPTKS_Par_4 (redaktsioon 27017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27017",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTKS_Par_4_v182903"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTKS_Par_4_v182903",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Presidendi volitused peatuvad, kui: ta on ajutiselt võimetu täitma oma ülesandeid; ta on võetud kriminaalvastutusele vastavalt Vabariigi Presidendi ja Vabariigi Valitsuse liikme kohtulikule vastutusele võtmise korra seadusele (RT I 1995, 83, 1441; 2000, 35, 222); ta on tunnistatud kestvalt võimetuks täitma oma ülesandeid. (2) Vabariigi Presidendi volituste peatumise korral lähevad need ajutiselt üle Riigikogu esimehele, kes hakkab täitma Vabariigi Presidendi ülesandeid.",
      "rdfs:label": {
        "@value": "VPTKS_Par_4 (redaktsioon 182903)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182903",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTKS_Par_4_v13009843"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTKS_Par_4_v13009843",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Presidendi volitused peatuvad, kui: ta on ajutiselt võimetu täitma oma ülesandeid; ta on võetud kriminaalvastutusele vastavalt Vabariigi Presidendi ja Vabariigi Valitsuse liikme kohtulikule vastutusele võtmise korra seadusele; ta on tunnistatud kestvalt võimetuks täitma oma ülesandeid. (2) Vabariigi Presidendi volituste peatumise korral lähevad need ajutiselt üle Riigikogu esimehele, kes hakkab täitma Vabariigi Presidendi ülesandeid.",
      "rdfs:label": {
        "@value": "VPTKS_Par_4 (redaktsioon 13009843)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13009843"
    },
    {
      "@id": "estleg:VPTKS_Par_5_v27017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui Vabariigi President on puhkuse, haiguse või muu takistuse tõttu ajutiselt võimetu täitma oma ülesandeid, teeb ta Riigikogu esimehele selle kohta kirjaliku avalduse, milles nimetab põhjuse. (2) Kui Vabariigi President on võimetu käesoleva paragrahvi lõikes 1 nimetatud avaldust esitama, teeb seda õiguskantsler. (3) Vabariigi Presidendi volitused lähevad käesoleva paragrahvi lõigetes 1 ja 2 nimetatud juhtudel Riigikogu esimehele üle avalduse saamisest.",
      "rdfs:label": {
        "@value": "VPTKS_Par_5 (redaktsioon 27017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27017",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTKS_Par_5_v112032015055"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTKS_Par_5_v112032015055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui Vabariigi President on puhkuse, haiguse või muu takistuse tõttu ajutiselt võimetu täitma oma ülesandeid, teeb ta Riigikogu esimehele selle kohta kirjaliku avalduse, milles nimetab põhjuse. (2) Kui Vabariigi President on võimetu käesoleva paragrahvi lõikes 1 nimetatud avaldust esitama või tema asukoht on üle 48 tunni teadmata, teeb seda õiguskantsler. (3) Vabariigi Presidendi volitused lähevad käesoleva paragrahvi lõigetes 1 ja 2 nimetatud juhtudel Riigikogu esimehele üle avalduse saamisest.",
      "rdfs:label": {
        "@value": "VPTKS_Par_5 (redaktsioon 112032015055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015055",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTKS_Par_5_v127062017011"
      },
      "estleg:versionValidTo": {
        "@value": "2017-07-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTKS_Par_5_v127062017011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui Vabariigi President on haiguse või muu takistuse tõttu ajutiselt võimetu täitma oma ülesandeid, teeb ta Riigikogu esimehele selle kohta kirjaliku avalduse, milles nimetab põhjuse. (2) Kui Vabariigi President on võimetu käesoleva paragrahvi lõikes 1 nimetatud avaldust esitama või tema asukoht on üle 48 tunni teadmata, teeb seda õiguskantsler. (3) Vabariigi Presidendi volitused lähevad käesoleva paragrahvi lõigetes 1 ja 2 nimetatud juhtudel Riigikogu esimehele üle avalduse saamisest.",
      "rdfs:label": {
        "@value": "VPTKS_Par_5 (redaktsioon 127062017011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127062017011"
    },
    {
      "@id": "estleg:VPTKS_Par_6_v27017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Presidendi volitused peatuvad Riigikogu otsusest anda nõusolek Vabariigi Presidendi kriminaalvastutusele võtmiseks. (2) Vabariigi Presidendi volituste taastumise aluseks on tema suhtes õigeksmõistev kohtuotsus või tema kriminaalasja lõpetamine.",
      "rdfs:label": {
        "@value": "VPTKS_Par_6 (redaktsioon 27017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27017"
    },
    {
      "@id": "estleg:VPTKS_Par_7_v27017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui Vabariigi Presidendi volituste peatumise aluseks olnud asjaolu on ära langenud, taastuvad volitused alates Vabariigi Presidendi otsusest asuda täitma oma ülesandeid.",
      "rdfs:label": {
        "@value": "VPTKS_Par_7 (redaktsioon 27017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27017"
    },
    {
      "@id": "estleg:VPTKS_Par_8_v27017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Presidendi volitused lõpevad korraliselt, kui ametisse astub järgmine Vabariigi President. (2) Vastavalt põhiseaduse §-le 131 ei valita Vabariigi Presidenti ega lõpe tema volitused erakorralise ega sõjaseisukorra ajal, välja arvatud kestva võimetuse korral oma ülesandeid täita.",
      "rdfs:label": {
        "@value": "VPTKS_Par_8 (redaktsioon 27017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27017"
    },
    {
      "@id": "estleg:VPTKS_Par_9_v27017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Presidendi volitused lõpevad enne tähtaega, kui: ta astub ametist tagasi; ta sureb; jõustub teda süüdi mõistev kohtuotsus; [Punkt 4 kehtetu alates 1.07.2002] ta on tunnistatud kestvalt võimetuks oma ülesandeid täitma.",
      "rdfs:label": {
        "@value": "VPTKS_Par_9 (redaktsioon 27017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27017",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTKS_Par_9_v182903"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTKS_Par_9_v182903",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Presidendi volitused lõpevad enne tähtaega, kui: ta astub ametist tagasi; ta sureb; jõustub teda süüdi mõistev kohtuotsus; kehtetu.",
      "rdfs:label": {
        "@value": "VPTKS_Par_9 (redaktsioon 182903)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182903",
      "estleg:supersededByVersion": {
        "@id": "estleg:VPTKS_Par_9_v13312048"
      },
      "estleg:versionValidTo": {
        "@value": "2010-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VPTKS_Par_9_v13312048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPTKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Presidendi volitused lõpevad enne tähtaega, kui: ta astub ametist tagasi; ta sureb; jõustub teda süüdi mõistev kohtuotsus. kehtetu -",
      "rdfs:label": {
