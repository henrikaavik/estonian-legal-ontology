        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2001. aasta 1. septembril.",
      "rdfs:label": {
        "@value": "VPTKS_Par_30 (redaktsioon 27017)",
        "@language": "et"
      },
