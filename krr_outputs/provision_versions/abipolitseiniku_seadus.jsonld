    },
    {
      "@id": "estleg:ABIPOL_Par_16_v22280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abipolitseinike tegevusega seotud kulutused kaetakse politseiasutuse selleks ettenähtud vahendite arvelt.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_16 (redaktsioon 22280)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22280",
      "estleg:supersededByVersion": {
