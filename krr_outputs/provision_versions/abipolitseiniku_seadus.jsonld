    {
      "@id": "estleg:ABIPOL_Par_15_v22280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinikule politsei tulirelvade ja erivahendite väljastamise juhtumid ja korra ning väljastamiseks lubatud relvade ja erivahendite liigi kehtestab siseminister. (2) Politseile kuuluvaid tulirelvi ja erivahendeid võidakse abipolitseinikule väljastada ainult talle pandud ülesannete täitmise ajaks.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_15 (redaktsioon 22280)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22280",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_15_v120122010001"
      },
      "estleg:versionValidTo": {
